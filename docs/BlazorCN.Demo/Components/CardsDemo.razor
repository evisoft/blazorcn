<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    @* Card 1: Form *@
    <CardCn Class="col-span-full md:col-span-1">
        <CardHeaderCn>
            <CardTitleCn>Create project</CardTitleCn>
            <CardDescriptionCn>Deploy your new project in one-click.</CardDescriptionCn>
        </CardHeaderCn>
        <CardContentCn>
            <div class="space-y-4">
                <div class="space-y-2">
                    <LabelCn For="name">Name</LabelCn>
                    <InputCn id="name" Placeholder="Name of your project" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="description">Description</LabelCn>
                    <TextareaCn id="description" Placeholder="Describe your project" />
                </div>
            </div>
        </CardContentCn>
        <CardFooterCn>
            <div class="flex justify-between w-full">
                <ButtonCn Variant="ButtonVariant.Outline">Cancel</ButtonCn>
                <ButtonCn>Deploy</ButtonCn>
            </div>
        </CardFooterCn>
    </CardCn>

    @* Card 2: Button variants *@
    <CardCn Class="col-span-full md:col-span-1">
        <CardHeaderCn>
            <CardTitleCn>Button Variants</CardTitleCn>
            <CardDescriptionCn>All available button styles.</CardDescriptionCn>
        </CardHeaderCn>
        <CardContentCn>
            <div class="flex flex-wrap gap-3">
                <ButtonCn Variant="ButtonVariant.Default">Default</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Secondary">Secondary</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Destructive">Destructive</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline">Outline</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost">Ghost</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Link">Link</ButtonCn>
            </div>
        </CardContentCn>
    </CardCn>

    @* Card 3: Mixed components *@
    <CardCn Class="col-span-full md:col-span-1">
        <CardHeaderCn>
            <CardTitleCn>Components</CardTitleCn>
            <CardDescriptionCn>Badges, avatar, switch, and progress.</CardDescriptionCn>
        </CardHeaderCn>
        <CardContentCn>
            <div class="space-y-4">
                <div class="flex flex-wrap gap-2">
                    <BadgeCn>Default</BadgeCn>
                    <BadgeCn Variant="BadgeVariant.Secondary">Secondary</BadgeCn>
                    <BadgeCn Variant="BadgeVariant.Outline">Outline</BadgeCn>
                    <BadgeCn Variant="BadgeVariant.Destructive">Destructive</BadgeCn>
                </div>

                <SeparatorCn />

                <div class="flex items-center gap-3">
                    <AvatarCn>
                        <AvatarFallbackCn>CN</AvatarFallbackCn>
                    </AvatarCn>
                    <div class="text-sm">
                        <p class="font-medium leading-none">BlazorCN</p>
                        <p class="text-muted-foreground">blazor@example.com</p>
                    </div>
                </div>

                <SeparatorCn />

                <div class="flex items-center justify-between">
                    <LabelCn For="notifications">Notifications</LabelCn>
                    <SwitchCn id="notifications" Checked="_switchChecked" CheckedChanged="v => _switchChecked = v" />
                </div>

                <div class="space-y-2">
                    <div class="flex justify-between text-sm">
                        <span>Progress</span>
                        <span class="text-muted-foreground">68%</span>
                    </div>
                    <ProgressCn Value="68" aria-label="Progress" />
                </div>
            </div>
        </CardContentCn>
    </CardCn>
</div>

@code {
    private bool _switchChecked = true;
}
