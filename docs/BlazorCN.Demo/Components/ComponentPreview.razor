<div class="mb-8">
    @if (Title is not null)
    {
        @* h2, not h3: the page heading is the h1, so h3 here skips a level on every
           demo section (axe heading-order, 377 nodes across 116 routes). Size and
           weight come from the classes, so the rendering is unchanged. *@
        <h2 class="mb-3 text-lg font-semibold">@Title</h2>
    }
    @if (Description is not null)
    {
        <p class="mb-3 text-sm text-muted-foreground">@Description</p>
    }

    <TabsCn DefaultValue="preview">
        <TabsListCn>
            <TabsTriggerCn Value="preview">Preview</TabsTriggerCn>
            <TabsTriggerCn Value="code">Code</TabsTriggerCn>
        </TabsListCn>
        <TabsContentCn Value="preview">
            @* tabindex=0: wide previews scroll horizontally, so keyboard users must be
               able to focus the scroll region (WCAG 2.1.1 / axe scrollable-region-focusable). *@
            <div class="overflow-x-auto rounded-lg border" tabindex="0" role="group"
                 aria-label="@(Title is not null ? $"{Title} preview" : "Component preview")">
                <div class="flex min-h-[200px] w-max min-w-full items-center justify-center p-4 sm:p-8">
                    @ChildContent
                </div>
            </div>
        </TabsContentCn>
        <TabsContentCn Value="code">
            <CodeBlock Code="@Code" />
        </TabsContentCn>
    </TabsCn>
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter, EditorRequired] public string Code { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
