@inject NavigationManager Nav
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing

<aside class="hidden md:block w-64 shrink-0">
    <div class="sticky top-14 h-[calc(100vh-3.5rem)]">
        <ScrollAreaCn Class="h-full py-6 pr-4">
            <nav aria-label="Documentation">
                @foreach (var navSection in CurrentSections)
                {
                    <div class="mb-4">
                        <h4 class="mb-1 rounded-md px-2 py-1 text-sm font-semibold">@navSection.Title</h4>
                        @foreach (var item in navSection.Items)
                        {
                            <a href="@item.Href"
                               class="@ItemClass(item.Href)"
                               aria-current="@(IsCurrent(item.Href) ? "page" : null)">
                                @item.Label
                            </a>
                        }
                    </div>
                }
            </nav>
        </ScrollAreaCn>
    </div>
</aside>

@code {
    // Getting Started is always shown; the second section is contextual:
    // Blocks groups when browsing /docs/blocks/*, otherwise the component list.
    private bool InBlocks =>
        ("/" + Nav.ToBaseRelativePath(Nav.Uri))
            .StartsWith("/docs/blocks", StringComparison.OrdinalIgnoreCase);

    private Data.NavSection[] CurrentSections =>
        [.. Data.NavData.GettingStarted, .. (InBlocks ? Data.NavData.Blocks : Data.NavData.Components)];

    protected override void OnInitialized()
        => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Nav.LocationChanged -= OnLocationChanged;

    private bool IsCurrent(string href)
        => ("/" + Nav.ToBaseRelativePath(Nav.Uri)).Equals(href, StringComparison.OrdinalIgnoreCase);

    private string ItemClass(string href)
    {
        var baseClass = "block rounded-md px-2 py-1.5 text-sm transition-colors";
        return IsCurrent(href)
            ? $"{baseClass} bg-accent text-accent-foreground font-medium"
            : $"{baseClass} text-muted-foreground hover:text-foreground hover:bg-accent/50";
    }
}
