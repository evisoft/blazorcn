@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="relative flex min-h-screen flex-col">
    @* WCAG 2.4.1 Bypass Blocks: every route puts a large nav ahead of the content,
       so keyboard/screen-reader users need one stop to jump past it. Visible only
       while focused. tabindex="-1" on <main> lets the fragment move real focus. *@
    <a href="#main-content"
       class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-background focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:ring-2 focus:ring-ring focus:outline-none">
        Skip to content
    </a>
    <SiteHeader OnSearchRequested="OpenSearch" OnMobileMenuRequested="OpenMobileMenu" />
    <main id="main-content" tabindex="-1" class="flex-1 outline-none">
        @Body
    </main>
    <SiteFooter />
</div>

@* Mobile nav sheet *@
<SheetCn @bind-Open="_mobileMenuOpen">
    <SheetContentCn Side="SheetSide.Left" Class="w-72 p-0">
        <SheetHeaderCn Class="border-b p-4">
            <SheetTitleCn>BlazorCN</SheetTitleCn>
        </SheetHeaderCn>
        <ScrollAreaCn Class="h-[calc(100vh-5rem)]">
            <nav class="flex flex-col gap-1 p-4" aria-label="Main">
                <a href="/docs/getting-started" class="@MobileItemClass("/docs/getting-started")" aria-current="@(IsCurrent("/docs/getting-started") ? "page" : null)">Getting Started</a>
                <a href="/docs/components/button" class="@MobileItemClass("/docs/components/button")" aria-current="@(IsCurrent("/docs/components/button") ? "page" : null)">Components</a>
                <a href="/docs/blocks/about" class="@MobileItemClass("/docs/blocks/about")" aria-current="@(IsCurrent("/docs/blocks/about") ? "page" : null)">Blocks</a>
                <a href="/examples/dashboard" class="@MobileItemClass("/examples/dashboard")" aria-current="@(IsCurrent("/examples/dashboard") ? "page" : null)">Examples</a>
                <a href="/themes" class="@MobileItemClass("/themes")" aria-current="@(IsCurrent("/themes") ? "page" : null)">Themes</a>
                <a href="/colors" class="@MobileItemClass("/colors")" aria-current="@(IsCurrent("/colors") ? "page" : null)">Colors</a>

                @* Contextual docs navigation — same sections DocsSidebar shows *@
                @foreach (var navSection in MobileSections)
                {
                    <div class="mt-4">
                        <h4 class="mb-1 rounded-md px-3 py-1 text-sm font-semibold">@navSection.Title</h4>
                        @foreach (var item in navSection.Items)
                        {
                            <a href="@item.Href"
                               class="@MobileItemClass(item.Href)"
                               aria-current="@(IsCurrent(item.Href) ? "page" : null)">
                                @item.Label
                            </a>
                        }
                    </div>
                }
            </nav>
        </ScrollAreaCn>
    </SheetContentCn>
</SheetCn>

@* Command menu (Ctrl+K search) *@
<CommandMenu @bind-Open="_searchOpen" />

@* Toast host — mounted once for the whole app *@
<ToasterCn />

@code {
    private bool _mobileMenuOpen;
    private bool _searchOpen;
    private IJSObjectReference? _module;
    private IJSObjectReference? _shortcutHandler;

    private void OpenMobileMenu() => _mobileMenuOpen = true;
    private void OpenSearch() => _searchOpen = true;

    protected override void OnInitialized()
        => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_mobileMenuOpen)
        {
            _mobileMenuOpen = false;
            InvokeAsync(StateHasChanged);
        }
    }

    // Blocks groups when browsing /docs/blocks/*, otherwise the component list
    // (mirrors DocsSidebar so phones can reach every docs page).
    private bool InBlocks =>
        ("/" + Nav.ToBaseRelativePath(Nav.Uri))
            .StartsWith("/docs/blocks", StringComparison.OrdinalIgnoreCase);

    private Data.NavSection[] MobileSections =>
        [.. Data.NavData.GettingStarted, .. (InBlocks ? Data.NavData.Blocks : Data.NavData.Components)];

    private bool IsCurrent(string href)
        => ("/" + Nav.ToBaseRelativePath(Nav.Uri)).Equals(href, StringComparison.OrdinalIgnoreCase);

    private string MobileItemClass(string href)
    {
        var baseClass = "block rounded-md px-3 py-2 text-sm";
        return IsCurrent(href)
            ? $"{baseClass} bg-accent text-accent-foreground font-medium"
            : $"{baseClass} hover:bg-accent";
    }

    [JSInvokable]
    public void OnCtrlK()
    {
        _searchOpen = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./demo.js");
            _shortcutHandler = await _module.InvokeAsync<IJSObjectReference>(
                "registerKeyboardShortcut", DotNetObjectReference.Create(this), "OnCtrlK");
        }
    }

    public async ValueTask DisposeAsync()
    {
        Nav.LocationChanged -= OnLocationChanged;
        if (_module is not null && _shortcutHandler is not null)
        {
            try { await _module.InvokeVoidAsync("unregisterKeyboardShortcut", _shortcutHandler); } catch { }
        }
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch { }
        }
    }
}
