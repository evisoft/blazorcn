<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Features>experimental-data-section-string-literals</Features>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlazorCN\BlazorCN.csproj" />
  </ItemGroup>

  <!-- Tailwind CSS v4 build -->
  <Target Name="BuildTailwind" BeforeTargets="Build" Condition="!Exists('wwwroot\app.css') Or '$(BuildingInsideVisualStudio)' != 'true'">
    <Exec Command="npm run build:css" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="PublishTailwind" BeforeTargets="Publish">
    <Exec Command="npm run build:css" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
