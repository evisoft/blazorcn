<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Features>experimental-data-section-string-literals</Features>
    <!-- IL trimming: keep partial (Blazor WASM default). TrimMode=full breaks rendering
         (CtorNotLocated on reflectively-activated components/layouts). The demo's bulk is
         embedded per-block source-code string constants in assembly metadata, which the
         trimmer never removes, so partial==default here; the real artifact win is a clean
         publish dir (no stale duplicate .wasm). -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlazorCN\BlazorCN.csproj" />
  </ItemGroup>

  <!-- Tailwind CSS v4 build -->
  <Target Name="BuildTailwind" BeforeTargets="Build" Condition="!Exists('wwwroot\app.css') Or '$(BuildingInsideVisualStudio)' != 'true'">
    <Exec Command="npm run build:css" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="PublishTailwind" BeforeTargets="Publish">
    <Exec Command="npm run build:css" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
