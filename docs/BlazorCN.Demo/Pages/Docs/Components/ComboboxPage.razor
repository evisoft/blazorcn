@page "/docs/components/combobox"
@layout DocsLayout

<PageTitle>Combobox — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Combobox</h1>
        <p class="mt-2 text-lg text-muted-foreground">Autocomplete input and command palette with a list of suggestions.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <ComboboxCn @bind-Value="_selectedFramework" Class="w-[200px]">
            <ComboboxTriggerCn>
                <span class="truncate">@(_selectedFramework ?? "Select framework...")</span>
            </ComboboxTriggerCn>
            <ComboboxContentCn>
                <ComboboxInputCn Placeholder="Search framework..." />
                <ComboboxEmptyCn>No framework found.</ComboboxEmptyCn>
                <ComboboxGroupCn>
                    <ComboboxItemCn Value="next.js">Next.js</ComboboxItemCn>
                    <ComboboxItemCn Value="sveltekit">SvelteKit</ComboboxItemCn>
                    <ComboboxItemCn Value="nuxt.js">Nuxt.js</ComboboxItemCn>
                    <ComboboxItemCn Value="remix">Remix</ComboboxItemCn>
                    <ComboboxItemCn Value="astro">Astro</ComboboxItemCn>
                </ComboboxGroupCn>
            </ComboboxContentCn>
        </ComboboxCn>
    </ComponentPreview>

    <ComponentPreview Title="Groups" Code="@GroupsCode">
        <ComboboxCn @bind-Value="_selectedTimezone" Class="w-[240px]">
            <ComboboxTriggerCn>
                <span class="truncate">@(_selectedTimezone ?? "Select a timezone")</span>
            </ComboboxTriggerCn>
            <ComboboxContentCn>
                <ComboboxInputCn Placeholder="Search timezone..." />
                <ComboboxEmptyCn>No timezones found.</ComboboxEmptyCn>
                <ComboboxGroupCn>
                    <ComboboxItemCn Value="(GMT-5) New York">(GMT-5) New York</ComboboxItemCn>
                    <ComboboxItemCn Value="(GMT-8) Los Angeles">(GMT-8) Los Angeles</ComboboxItemCn>
                    <ComboboxItemCn Value="(GMT-6) Chicago">(GMT-6) Chicago</ComboboxItemCn>
                    <ComboboxItemCn Value="(GMT-5) Toronto">(GMT-5) Toronto</ComboboxItemCn>
                    <ComboboxItemCn Value="(GMT-8) Vancouver">(GMT-8) Vancouver</ComboboxItemCn>
                </ComboboxGroupCn>
                <ComboboxSeparatorCn />
                <ComboboxGroupCn>
                    <ComboboxItemCn Value="(GMT+0) London">(GMT+0) London</ComboboxItemCn>
                    <ComboboxItemCn Value="(GMT+1) Paris">(GMT+1) Paris</ComboboxItemCn>
                    <ComboboxItemCn Value="(GMT+1) Berlin">(GMT+1) Berlin</ComboboxItemCn>
                    <ComboboxItemCn Value="(GMT+1) Rome">(GMT+1) Rome</ComboboxItemCn>
                    <ComboboxItemCn Value="(GMT+1) Madrid">(GMT+1) Madrid</ComboboxItemCn>
                </ComboboxGroupCn>
                <ComboboxSeparatorCn />
                <ComboboxGroupCn>
                    <ComboboxItemCn Value="(GMT+9) Tokyo">(GMT+9) Tokyo</ComboboxItemCn>
                    <ComboboxItemCn Value="(GMT+8) Shanghai">(GMT+8) Shanghai</ComboboxItemCn>
                    <ComboboxItemCn Value="(GMT+8) Singapore">(GMT+8) Singapore</ComboboxItemCn>
                    <ComboboxItemCn Value="(GMT+4) Dubai">(GMT+4) Dubai</ComboboxItemCn>
                    <ComboboxItemCn Value="(GMT+11) Sydney">(GMT+11) Sydney</ComboboxItemCn>
                </ComboboxGroupCn>
            </ComboboxContentCn>
        </ComboboxCn>
    </ComponentPreview>

    <ComponentPreview Title="Popup" Code="@PopupCode">
