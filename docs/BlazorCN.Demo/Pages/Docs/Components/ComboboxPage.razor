            </ComboboxTriggerCn>
            <ComboboxContentCn>
                <ComboboxInputCn Placeholder="Search countries..." />
                <ComboboxEmptyCn>No countries found.</ComboboxEmptyCn>
                <ComboboxGroupCn>
                    <ComboboxItemCn Value="argentina">
                        <div class="flex flex-col">
                            <span class="whitespace-nowrap">Argentina</span>
                            <span class="text-xs text-muted-foreground">South America (ar)</span>
                        </div>
                    </ComboboxItemCn>
                    <ComboboxItemCn Value="australia">
