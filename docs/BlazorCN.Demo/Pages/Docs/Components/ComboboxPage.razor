                <ComboboxGroupCn>
                    <ComboboxItemCn Value="argentina">Argentina</ComboboxItemCn>
                    <ComboboxItemCn Value="australia">Australia</ComboboxItemCn>
                    <ComboboxItemCn Value="brazil">Brazil</ComboboxItemCn>
                    <ComboboxItemCn Value="canada">Canada</ComboboxItemCn>
