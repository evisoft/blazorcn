@page "/docs/components/empty"
@layout DocsLayout

<PageTitle>Empty — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Empty</h1>
        <p class="mt-2 text-lg text-muted-foreground">Displays a placeholder when there is no content to show.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <EmptyCn>
            <div class="flex max-w-sm flex-col items-center gap-2">
                <div class="mb-2 flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted text-foreground [&>svg:not([class*='size-'])]:size-4">
                    <LucideFolderCodeCn Size="16" />
                </div>
                <div class="text-sm font-medium tracking-tight">No Projects Yet</div>
                <div class="text-sm/relaxed text-muted-foreground">
                    You haven't created any projects yet. Get started by creating your first project.
                </div>
            </div>
            <div class="flex w-full max-w-sm min-w-0 flex-col items-center gap-2.5 text-sm">
                <div class="flex flex-row justify-center gap-2">
                    <ButtonCn>Create Project</ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline">Import Project</ButtonCn>
                </div>
            </div>
            <a href="#" class="inline-flex items-center gap-1 text-sm text-muted-foreground underline-offset-4 hover:underline">
                Learn More <LucideArrowUpRightCn Size="14" />
            </a>
        </EmptyCn>
    </ComponentPreview>

    <ComponentPreview Title="Avatar" Code="@AvatarCode">
        <EmptyCn>
            <div class="flex max-w-sm flex-col items-center gap-2">
                <div class="mb-2 flex shrink-0 items-center justify-center">
                    <AvatarCn Class="size-12">
                        <AvatarImageCn Src="https://github.com/shadcn.png" Class="grayscale" />
                        <AvatarFallbackCn>LR</AvatarFallbackCn>
                    </AvatarCn>
                </div>
                <div class="text-sm font-medium tracking-tight">User Offline</div>
                <div class="text-sm/relaxed text-muted-foreground">
                    This user is currently offline. You can leave a message to notify them or try again later.
                </div>
            </div>
            <div class="flex w-full max-w-sm min-w-0 flex-col items-center gap-2.5 text-sm">
                <ButtonCn Size="ButtonSize.Sm">Leave Message</ButtonCn>
            </div>
        </EmptyCn>
    </ComponentPreview>

    <ComponentPreview Title="Avatar Group" Code="@AvatarGroupCode">
        <EmptyCn>
            <div class="flex max-w-sm flex-col items-center gap-2">
                <div class="mb-2 flex shrink-0 items-center justify-center">
                    <div class="flex -space-x-2 [&>[data-slot=avatar]]:size-12 [&>[data-slot=avatar]]:ring-2 [&>[data-slot=avatar]]:ring-background [&>[data-slot=avatar]]:grayscale">
                        <AvatarCn>
                            <AvatarImageCn Src="https://github.com/shadcn.png" Alt="@("@shadcn")" />
                            <AvatarFallbackCn>CN</AvatarFallbackCn>
                        </AvatarCn>
                        <AvatarCn>
                            <AvatarImageCn Src="https://github.com/maxleiter.png" Alt="@("@maxleiter")" />
                            <AvatarFallbackCn>LR</AvatarFallbackCn>
                        </AvatarCn>
                        <AvatarCn>
                            <AvatarImageCn Src="https://github.com/evilrabbit.png" Alt="@("@evilrabbit")" />
                            <AvatarFallbackCn>ER</AvatarFallbackCn>
                        </AvatarCn>
                    </div>
                </div>
                <div class="text-sm font-medium tracking-tight">No Team Members</div>
                <div class="text-sm/relaxed text-muted-foreground">
                    Invite your team to collaborate on this project.
                </div>
            </div>
            <div class="flex w-full max-w-sm min-w-0 flex-col items-center gap-2.5 text-sm">
                <ButtonCn Size="ButtonSize.Sm">
                    <LucidePlusCn Size="16" />
                    Invite Members
                </ButtonCn>
            </div>
        </EmptyCn>
    </ComponentPreview>

    <ComponentPreview Title="Card" Code="@CardCode">
        <EmptyCn>
            <div class="flex max-w-sm flex-col items-center gap-2">
                <div class="mb-2 flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted text-foreground [&>svg:not([class*='size-'])]:size-4">
                    <LucideFolderCn Size="16" />
                </div>
                <div class="text-sm font-medium tracking-tight">No projects yet</div>
                <div class="text-sm/relaxed text-muted-foreground">
                    You haven't created any projects yet. Get started by creating your first project.
                </div>
            </div>
            <div class="flex w-full max-w-sm min-w-0 flex-col items-center gap-2.5 text-sm">
                <div class="flex gap-2">
                    <a href="#" class="inline-flex items-center justify-center">
                        <ButtonCn>Create project</ButtonCn>
                    </a>
                    <ButtonCn Variant="ButtonVariant.Outline">Import project</ButtonCn>
                </div>
                <a href="#" class="inline-flex items-center gap-1 text-sm text-muted-foreground underline-offset-4 hover:underline">
                    Learn more <LucideArrowUpRightCn Size="14" />
                </a>
            </div>
        </EmptyCn>
    </ComponentPreview>

    <ComponentPreview Title="Input Group" Code="@InputGroupCode">
        <EmptyCn>
            <div class="flex max-w-sm flex-col items-center gap-2">
                <div class="text-sm font-medium tracking-tight">404 - Not Found</div>
                <div class="text-sm/relaxed text-muted-foreground">
                    The page you're looking for doesn't exist. Try searching for what you need below.
                </div>
            </div>
            <div class="flex w-full max-w-sm min-w-0 flex-col items-center gap-2.5 text-sm">
                <div class="group relative flex w-3/4 items-center rounded-md border border-input shadow-xs">
                    <InputCn Class="border-0 shadow-none focus-visible:ring-0" placeholder="Try searching for pages..." />
                    <div class="flex items-center gap-1 px-3 text-muted-foreground">
                        <LucideSearchCn Size="16" />
                    </div>
                    <div class="flex items-center gap-1 px-3">
                        <KbdCn>/</KbdCn>
                    </div>
                </div>
                <div class="text-sm/relaxed text-muted-foreground">
                    Need help? <a href="#" class="underline underline-offset-4 hover:text-primary">Contact support</a>
                </div>
            </div>
        </EmptyCn>
    </ComponentPreview>

    <ComponentPreview Title="Outline" Code="@OutlineCode">
        <EmptyCn Class="border border-dashed">
            <div class="flex max-w-sm flex-col items-center gap-2">
                <div class="mb-2 flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted text-foreground [&>svg:not([class*='size-'])]:size-4">
                    <LucideCloudCn Size="16" />
                </div>
                <div class="text-sm font-medium tracking-tight">Cloud Storage Empty</div>
                <div class="text-sm/relaxed text-muted-foreground">
                    Upload files to your cloud storage to access them anywhere.
                </div>
            </div>
            <div class="flex w-full max-w-sm min-w-0 flex-col items-center gap-2.5 text-sm">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">
                    Upload Files
                </ButtonCn>
            </div>
        </EmptyCn>
    </ComponentPreview>

    <ComponentPreview Title="Background" Code="@BackgroundCode">
        <EmptyCn Class="h-full bg-muted/30">
            <div class="flex max-w-sm flex-col items-center gap-2">
                <div class="mb-2 flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted text-foreground [&>svg:not([class*='size-'])]:size-4">
                    <LucideBellCn Size="16" />
                </div>
                <div class="text-sm font-medium tracking-tight">No Notifications</div>
                <div class="max-w-xs text-pretty text-sm/relaxed text-muted-foreground">
                    You're all caught up. New notifications will appear here.
                </div>
            </div>
            <div class="flex w-full max-w-sm min-w-0 flex-col items-center gap-2.5 text-sm">
                <ButtonCn Variant="ButtonVariant.Outline">
                    <LucideRefreshCcwCn Size="16" />
                    Refresh
                </ButtonCn>
            </div>
        </EmptyCn>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <EmptyCn dir="rtl">
            <div class="flex max-w-sm flex-col items-center gap-2">
                <div class="mb-2 flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted text-foreground [&>svg:not([class*='size-'])]:size-4">
                    <LucideFolderCodeCn Size="16" />
                </div>
                <div class="text-sm font-medium tracking-tight">لا توجد مشاريع بعد</div>
                <div class="text-sm/relaxed text-muted-foreground">لم تقم بإنشاء أي مشاريع بعد. ابدأ بإنشاء مشروعك الأول.</div>
            </div>
            <div class="flex w-full max-w-sm min-w-0 flex-col items-center gap-2.5 text-sm">
                <div class="flex flex-row justify-center gap-2">
                    <ButtonCn>إنشاء مشروع</ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline">استيراد مشروع</ButtonCn>
                </div>
            </div>
            <a href="#" class="inline-flex items-center gap-1 text-sm text-muted-foreground underline-offset-4 hover:underline">
                تعرف على المزيد <LucideArrowUpRightCn Size="14" Class="rtl:rotate-[270deg]" />
            </a>
        </EmptyCn>
    </ComponentPreview>
</div>

