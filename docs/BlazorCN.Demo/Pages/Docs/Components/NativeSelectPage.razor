@page "/docs/components/native-select"
@layout DocsLayout

<PageTitle>Native Select — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Native Select</h1>
        <p class="mt-2 text-lg text-muted-foreground">A styled native HTML select element.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <NativeSelectCn>
            <NativeSelectOptionCn value="">Select status</NativeSelectOptionCn>
            <NativeSelectOptionCn value="todo">Todo</NativeSelectOptionCn>
            <NativeSelectOptionCn value="in-progress">In Progress</NativeSelectOptionCn>
            <NativeSelectOptionCn value="done">Done</NativeSelectOptionCn>
            <NativeSelectOptionCn value="cancelled">Cancelled</NativeSelectOptionCn>
        </NativeSelectCn>
    </ComponentPreview>

    <ComponentPreview Title="Disabled" Code="@DisabledCode">
        <NativeSelectCn Disabled="true">
            <NativeSelectOptionCn value="">Disabled</NativeSelectOptionCn>
            <NativeSelectOptionCn value="apple">Apple</NativeSelectOptionCn>
            <NativeSelectOptionCn value="banana">Banana</NativeSelectOptionCn>
            <NativeSelectOptionCn value="blueberry">Blueberry</NativeSelectOptionCn>
        </NativeSelectCn>
    </ComponentPreview>

    <ComponentPreview Title="Groups" Code="@GroupsCode">
        <NativeSelectCn>
            <NativeSelectOptionCn value="">Select department</NativeSelectOptionCn>
            <NativeSelectOptGroupCn Label="Engineering">
                <NativeSelectOptionCn value="frontend">Frontend</NativeSelectOptionCn>
                <NativeSelectOptionCn value="backend">Backend</NativeSelectOptionCn>
                <NativeSelectOptionCn value="devops">DevOps</NativeSelectOptionCn>
            </NativeSelectOptGroupCn>
            <NativeSelectOptGroupCn Label="Sales">
                <NativeSelectOptionCn value="sales-rep">Sales Rep</NativeSelectOptionCn>
                <NativeSelectOptionCn value="account-manager">Account Manager</NativeSelectOptionCn>
                <NativeSelectOptionCn value="sales-director">Sales Director</NativeSelectOptionCn>
            </NativeSelectOptGroupCn>
            <NativeSelectOptGroupCn Label="Operations">
                <NativeSelectOptionCn value="support">Customer Support</NativeSelectOptionCn>
                <NativeSelectOptionCn value="product-manager">Product Manager</NativeSelectOptionCn>
                <NativeSelectOptionCn value="ops-manager">Operations Manager</NativeSelectOptionCn>
            </NativeSelectOptGroupCn>
        </NativeSelectCn>
    </ComponentPreview>

    <ComponentPreview Title="Invalid" Code="@InvalidCode">
        <NativeSelectCn aria-invalid="true">
            <NativeSelectOptionCn value="">Error state</NativeSelectOptionCn>
            <NativeSelectOptionCn value="apple">Apple</NativeSelectOptionCn>
            <NativeSelectOptionCn value="banana">Banana</NativeSelectOptionCn>
            <NativeSelectOptionCn value="blueberry">Blueberry</NativeSelectOptionCn>
        </NativeSelectCn>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div dir="rtl">
            <NativeSelectCn dir="rtl">
                <NativeSelectOptionCn value="">Select status</NativeSelectOptionCn>
                <NativeSelectOptionCn value="todo">Todo</NativeSelectOptionCn>
                <NativeSelectOptionCn value="in-progress">In Progress</NativeSelectOptionCn>
                <NativeSelectOptionCn value="done">Done</NativeSelectOptionCn>
                <NativeSelectOptionCn value="cancelled">Cancelled</NativeSelectOptionCn>
            </NativeSelectCn>
        </div>
    </ComponentPreview>
</div>

@code {
    private const string DemoCode = @"<NativeSelectCn>
    <NativeSelectOptionCn value="""">Select status</NativeSelectOptionCn>
    <NativeSelectOptionCn value=""todo"">Todo</NativeSelectOptionCn>
    <NativeSelectOptionCn value=""in-progress"">In Progress</NativeSelectOptionCn>
    <NativeSelectOptionCn value=""done"">Done</NativeSelectOptionCn>
    <NativeSelectOptionCn value=""cancelled"">Cancelled</NativeSelectOptionCn>
</NativeSelectCn>";

    private const string DisabledCode = @"<NativeSelectCn Disabled=""true"">
    <NativeSelectOptionCn value="""">Disabled</NativeSelectOptionCn>
    <NativeSelectOptionCn value=""apple"">Apple</NativeSelectOptionCn>
    <NativeSelectOptionCn value=""banana"">Banana</NativeSelectOptionCn>
    <NativeSelectOptionCn value=""blueberry"">Blueberry</NativeSelectOptionCn>
</NativeSelectCn>";

    private const string GroupsCode = @"<NativeSelectCn>
    <NativeSelectOptionCn value="""">Select department</NativeSelectOptionCn>
    <NativeSelectOptGroupCn Label=""Engineering"">
        <NativeSelectOptionCn value=""frontend"">Frontend</NativeSelectOptionCn>
        <NativeSelectOptionCn value=""backend"">Backend</NativeSelectOptionCn>
        <NativeSelectOptionCn value=""devops"">DevOps</NativeSelectOptionCn>
    </NativeSelectOptGroupCn>
    <NativeSelectOptGroupCn Label=""Sales"">
        <NativeSelectOptionCn value=""sales-rep"">Sales Rep</NativeSelectOptionCn>
        <NativeSelectOptionCn value=""account-manager"">Account Manager</NativeSelectOptionCn>
        <NativeSelectOptionCn value=""sales-director"">Sales Director</NativeSelectOptionCn>
    </NativeSelectOptGroupCn>
    <NativeSelectOptGroupCn Label=""Operations"">
        <NativeSelectOptionCn value=""support"">Customer Support</NativeSelectOptionCn>
        <NativeSelectOptionCn value=""product-manager"">Product Manager</NativeSelectOptionCn>
        <NativeSelectOptionCn value=""ops-manager"">Operations Manager</NativeSelectOptionCn>
    </NativeSelectOptGroupCn>
</NativeSelectCn>";

    private const string InvalidCode = @"<NativeSelectCn aria-invalid=""true"">
    <NativeSelectOptionCn value="""">Error state</NativeSelectOptionCn>
    <NativeSelectOptionCn value=""apple"">Apple</NativeSelectOptionCn>
    <NativeSelectOptionCn value=""banana"">Banana</NativeSelectOptionCn>
    <NativeSelectOptionCn value=""blueberry"">Blueberry</NativeSelectOptionCn>
</NativeSelectCn>";

    private const string RtlCode = @"<div dir=""rtl"">
    <NativeSelectCn dir=""rtl"">
        <NativeSelectOptionCn value="""">Select status</NativeSelectOptionCn>
        <NativeSelectOptionCn value=""todo"">Todo</NativeSelectOptionCn>
        <NativeSelectOptionCn value=""in-progress"">In Progress</NativeSelectOptionCn>
        <NativeSelectOptionCn value=""done"">Done</NativeSelectOptionCn>
        <NativeSelectOptionCn value=""cancelled"">Cancelled</NativeSelectOptionCn>
    </NativeSelectCn>
</div>";
}
