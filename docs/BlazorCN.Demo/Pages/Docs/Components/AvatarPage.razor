    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div class="flex flex-row flex-wrap items-center gap-6 md:gap-12" dir="rtl">
            <AvatarCn>
                <AvatarImageCn Src="https://github.com/shadcn.png" Alt="@("@shadcn")" Class="grayscale" />
                <AvatarFallbackCn>CN</AvatarFallbackCn>
            </AvatarCn>
            <AvatarCn>
                <AvatarImageCn Src="https://github.com/evilrabbit.png" Alt="@("@evilrabbit")" />
                <AvatarFallbackCn>ER</AvatarFallbackCn>
                <AvatarBadgeCn Class="bg-green-600 dark:bg-green-800" />
            </AvatarCn>
            <AvatarGroupCn Class="grayscale">
                <AvatarCn>
                    <AvatarImageCn Src="https://github.com/shadcn.png" Alt="@("@shadcn")" />
                    <AvatarFallbackCn>CN</AvatarFallbackCn>
                </AvatarCn>
                <AvatarCn>
                    <AvatarImageCn Src="https://github.com/maxleiter.png" Alt="@("@maxleiter")" />
                    <AvatarFallbackCn>LR</AvatarFallbackCn>
                </AvatarCn>
                <AvatarCn>
                    <AvatarImageCn Src="https://github.com/evilrabbit.png" Alt="@("@evilrabbit")" />
                    <AvatarFallbackCn>ER</AvatarFallbackCn>
                </AvatarCn>
                <AvatarGroupCountCn>+٣</AvatarGroupCountCn>
            </AvatarGroupCn>
        </div>
    </ComponentPreview>
</div>

