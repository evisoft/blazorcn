@page "/docs/components/avatar"
@layout DocsLayout

<PageTitle>Avatar — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Avatar</h1>
        <p class="mt-2 text-lg text-muted-foreground">An image element with a fallback for representing the user.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <div class="flex flex-row flex-wrap items-center gap-6 md:gap-12">
            <AvatarCn>
                <AvatarImageCn Src="https://github.com/shadcn.png" Alt="@("@shadcn")" Class="grayscale" />
                <AvatarFallbackCn>CN</AvatarFallbackCn>
            </AvatarCn>
            <AvatarCn>
                <AvatarImageCn Src="https://github.com/evilrabbit.png" Alt="@("@evilrabbit")" />
                <AvatarFallbackCn>ER</AvatarFallbackCn>
                <AvatarBadgeCn Class="bg-green-600 dark:bg-green-800" />
            </AvatarCn>
            <AvatarGroupCn Class="grayscale">
                <AvatarCn>
                    <AvatarImageCn Src="https://github.com/shadcn.png" Alt="@("@shadcn")" />
                    <AvatarFallbackCn>CN</AvatarFallbackCn>
                </AvatarCn>
                <AvatarCn>
                    <AvatarImageCn Src="https://github.com/maxleiter.png" Alt="@("@maxleiter")" />
                    <AvatarFallbackCn>LR</AvatarFallbackCn>
                </AvatarCn>
                <AvatarCn>
                    <AvatarImageCn Src="https://github.com/evilrabbit.png" Alt="@("@evilrabbit")" />
                    <AvatarFallbackCn>ER</AvatarFallbackCn>
                </AvatarCn>
                <AvatarGroupCountCn>+3</AvatarGroupCountCn>
            </AvatarGroupCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Basic" Code="@BasicCode">
        <AvatarCn>
            <AvatarImageCn Src="https://github.com/shadcn.png" Alt="@("@shadcn")" Class="grayscale" />
            <AvatarFallbackCn>CN</AvatarFallbackCn>
        </AvatarCn>
    </ComponentPreview>

    <ComponentPreview Title="Size" Code="@SizeCode">
        <div class="flex flex-wrap items-center gap-2 grayscale">
            <AvatarCn Size="AvatarSize.Sm">
                <AvatarImageCn Src="https://github.com/shadcn.png" Alt="@("@shadcn")" />
                <AvatarFallbackCn>CN</AvatarFallbackCn>
            </AvatarCn>
            <AvatarCn>
                <AvatarImageCn Src="https://github.com/shadcn.png" Alt="@("@shadcn")" />
                <AvatarFallbackCn>CN</AvatarFallbackCn>
            </AvatarCn>
            <AvatarCn Size="AvatarSize.Lg">
                <AvatarImageCn Src="https://github.com/shadcn.png" Alt="@("@shadcn")" />
                <AvatarFallbackCn>CN</AvatarFallbackCn>
            </AvatarCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Badge" Code="@BadgeCode">
        <AvatarCn>
            <AvatarImageCn Src="https://github.com/shadcn.png" Alt="@("@shadcn")" />
            <AvatarFallbackCn>CN</AvatarFallbackCn>
            <AvatarBadgeCn Class="bg-green-600 dark:bg-green-800" />
        </AvatarCn>
    </ComponentPreview>

    <ComponentPreview Title="Badge with Icon" Code="@BadgeIconCode">
        <AvatarCn Class="grayscale">
            <AvatarImageCn Src="https://github.com/pranathip.png" Alt="@("@pranathip")" />
            <AvatarFallbackCn>PP</AvatarFallbackCn>
            <AvatarBadgeCn>
                <LucidePlusCn />
            </AvatarBadgeCn>
        </AvatarCn>
    </ComponentPreview>

    <ComponentPreview Title="Dropdown" Code="@DropdownCode">
        <DropdownMenuCn>
            <DropdownMenuTriggerCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="rounded-full">
                    <AvatarCn>
                        <AvatarImageCn Src="https://github.com/shadcn.png" Alt="shadcn" />
                        <AvatarFallbackCn>CN</AvatarFallbackCn>
                    </AvatarCn>
                </ButtonCn>
            </DropdownMenuTriggerCn>
            <DropdownMenuContentCn Class="w-32">
                <DropdownMenuGroupCn>
                    <DropdownMenuItemCn>Profile</DropdownMenuItemCn>
                    <DropdownMenuItemCn>Billing</DropdownMenuItemCn>
                    <DropdownMenuItemCn>Settings</DropdownMenuItemCn>
                </DropdownMenuGroupCn>
                <DropdownMenuSeparatorCn />
                <DropdownMenuGroupCn>
                    <DropdownMenuItemCn Variant="destructive">Log out</DropdownMenuItemCn>
                </DropdownMenuGroupCn>
            </DropdownMenuContentCn>
        </DropdownMenuCn>
    </ComponentPreview>

    <ComponentPreview Title="Group" Code="@GroupCode">
        <AvatarGroupCn Class="grayscale">
            <AvatarCn>
                <AvatarImageCn Src="https://github.com/shadcn.png" Alt="@("@shadcn")" />
                <AvatarFallbackCn>CN</AvatarFallbackCn>
            </AvatarCn>
            <AvatarCn>
                <AvatarImageCn Src="https://github.com/maxleiter.png" Alt="@("@maxleiter")" />
                <AvatarFallbackCn>LR</AvatarFallbackCn>
            </AvatarCn>
            <AvatarCn>
                <AvatarImageCn Src="https://github.com/evilrabbit.png" Alt="@("@evilrabbit")" />
                <AvatarFallbackCn>ER</AvatarFallbackCn>
            </AvatarCn>
        </AvatarGroupCn>
    </ComponentPreview>

    <ComponentPreview Title="Group Count" Code="@GroupCountCode">
        <AvatarGroupCn Class="grayscale">
            <AvatarCn>
                <AvatarImageCn Src="https://github.com/shadcn.png" Alt="@("@shadcn")" />
                <AvatarFallbackCn>CN</AvatarFallbackCn>
            </AvatarCn>
            <AvatarCn>
                <AvatarImageCn Src="https://github.com/maxleiter.png" Alt="@("@maxleiter")" />
                <AvatarFallbackCn>LR</AvatarFallbackCn>
            </AvatarCn>
            <AvatarCn>
                <AvatarImageCn Src="https://github.com/evilrabbit.png" Alt="@("@evilrabbit")" />
                <AvatarFallbackCn>ER</AvatarFallbackCn>
            </AvatarCn>
            <AvatarGroupCountCn>+3</AvatarGroupCountCn>
        </AvatarGroupCn>
    </ComponentPreview>

    <ComponentPreview Title="Group Count with Icon" Code="@GroupCountIconCode">
        <AvatarGroupCn Class="grayscale">
            <AvatarCn>
                <AvatarImageCn Src="https://github.com/shadcn.png" Alt="@("@shadcn")" />
