@page "/docs/components/input-otp"
@layout DocsLayout

<PageTitle>Input OTP — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Input OTP</h1>
        <p class="mt-2 text-lg text-muted-foreground">Accessible one-time password input with copy-paste support.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <InputOtpCn MaxLength="6" Value="123456">
            <InputOtpGroupCn>
                <InputOtpSlotCn Index="0" />
                <InputOtpSlotCn Index="1" />
                <InputOtpSlotCn Index="2" />
                <InputOtpSlotCn Index="3" />
                <InputOtpSlotCn Index="4" />
                <InputOtpSlotCn Index="5" />
            </InputOtpGroupCn>
        </InputOtpCn>
    </ComponentPreview>

    <ComponentPreview Title="Four Digits" Code="@FourDigitsCode">
        <InputOtpCn MaxLength="4">
            <InputOtpGroupCn>
                <InputOtpSlotCn Index="0" />
                <InputOtpSlotCn Index="1" />
                <InputOtpSlotCn Index="2" />
                <InputOtpSlotCn Index="3" />
            </InputOtpGroupCn>
        </InputOtpCn>
    </ComponentPreview>

    <ComponentPreview Title="Controlled" Code="@ControlledCode">
        <div class="space-y-2">
            <InputOtpCn MaxLength="6" @bind-Value="_controlledValue">
                <InputOtpGroupCn>
                    <InputOtpSlotCn Index="0" />
                    <InputOtpSlotCn Index="1" />
                    <InputOtpSlotCn Index="2" />
                    <InputOtpSlotCn Index="3" />
                    <InputOtpSlotCn Index="4" />
                    <InputOtpSlotCn Index="5" />
                </InputOtpGroupCn>
            </InputOtpCn>
            <div class="text-center text-sm">
                @if (string.IsNullOrEmpty(_controlledValue))
                {
                    <span>Enter your one-time password.</span>
                }
                else
                {
                    <span>You entered: @_controlledValue</span>
                }
            </div>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Form" Code="@FormCode">
        <CardCn Class="mx-auto max-w-md">
            <CardHeaderCn>
                <CardTitleCn>Verify your login</CardTitleCn>
                <CardDescriptionCn>
                    Enter the verification code we sent to your email address:
                    <span class="font-medium">m@example.com</span>.
                </CardDescriptionCn>
            </CardHeaderCn>
            <CardContentCn>
                <div class="grid gap-2">
                    <div class="flex items-center justify-between">
                        <LabelCn For="otp-verification">Verification code</LabelCn>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">
                            <LucideRefreshCwCn Size="16" data-icon="inline-start" />
                            Resend Code
                        </ButtonCn>
                    </div>
                    <InputOtpCn MaxLength="6" @bind-Value="_formOtpValue">
                        <InputOtpGroupCn>
                            <InputOtpSlotCn Index="0" />
                            <InputOtpSlotCn Index="1" />
                            <InputOtpSlotCn Index="2" />
                        </InputOtpGroupCn>
                        <InputOtpSeparatorCn />
                        <InputOtpGroupCn>
                            <InputOtpSlotCn Index="3" />
                            <InputOtpSlotCn Index="4" />
                            <InputOtpSlotCn Index="5" />
                        </InputOtpGroupCn>
                    </InputOtpCn>
                    <p class="text-sm text-muted-foreground">
                        <a href="#">I no longer have access to this email address.</a>
                    </p>
                </div>
            </CardContentCn>
            <CardFooterCn>
                <div class="grid w-full gap-2">
                    <ButtonCn Class="w-full">Verify</ButtonCn>
                    <p class="text-sm text-muted-foreground">
                        Having trouble signing in?
                        <a href="#" class="underline underline-offset-4 transition-colors hover:text-primary">Contact support</a>
                    </p>
                </div>
            </CardFooterCn>
        </CardCn>
    </ComponentPreview>

    <ComponentPreview Title="Disabled" Code="@DisabledCode">
        <InputOtpCn MaxLength="6" Disabled="true" Value="123456">
            <InputOtpGroupCn>
                <InputOtpSlotCn Index="0" />
                <InputOtpSlotCn Index="1" />
                <InputOtpSlotCn Index="2" />
            </InputOtpGroupCn>
            <InputOtpSeparatorCn />
            <InputOtpGroupCn>
                <InputOtpSlotCn Index="3" />
                <InputOtpSlotCn Index="4" />
                <InputOtpSlotCn Index="5" />
            </InputOtpGroupCn>
        </InputOtpCn>
    </ComponentPreview>

    <ComponentPreview Title="Invalid" Code="@InvalidCode">
        <InputOtpCn MaxLength="6" Value="000000">
            <InputOtpGroupCn>
                <InputOtpSlotCn Index="0" aria-invalid="true" />
                <InputOtpSlotCn Index="1" aria-invalid="true" />
            </InputOtpGroupCn>
            <InputOtpSeparatorCn />
            <InputOtpGroupCn>
                <InputOtpSlotCn Index="2" aria-invalid="true" />
                <InputOtpSlotCn Index="3" aria-invalid="true" />
            </InputOtpGroupCn>
            <InputOtpSeparatorCn />
            <InputOtpGroupCn>
                <InputOtpSlotCn Index="4" aria-invalid="true" />
                <InputOtpSlotCn Index="5" aria-invalid="true" />
            </InputOtpGroupCn>
        </InputOtpCn>
    </ComponentPreview>

    <ComponentPreview Title="With Separator" Code="@SeparatorCode">
        <InputOtpCn MaxLength="6">
            <InputOtpGroupCn>
                <InputOtpSlotCn Index="0" />
                <InputOtpSlotCn Index="1" />
            </InputOtpGroupCn>
            <InputOtpSeparatorCn />
            <InputOtpGroupCn>
                <InputOtpSlotCn Index="2" />
                <InputOtpSlotCn Index="3" />
            </InputOtpGroupCn>
            <InputOtpSeparatorCn />
            <InputOtpGroupCn>
                <InputOtpSlotCn Index="4" />
                <InputOtpSlotCn Index="5" />
            </InputOtpGroupCn>
        </InputOtpCn>
    </ComponentPreview>

    <ComponentPreview Title="Pattern (Digits Only)" Code="@PatternCode">
        <InputOtpCn MaxLength="6" Pattern="@InputOtpCn.RegexpOnlyDigits">
            <InputOtpGroupCn>
                <InputOtpSlotCn Index="0" />
                <InputOtpSlotCn Index="1" />
                <InputOtpSlotCn Index="2" />
                <InputOtpSlotCn Index="3" />
                <InputOtpSlotCn Index="4" />
                <InputOtpSlotCn Index="5" />
            </InputOtpGroupCn>
        </InputOtpCn>
    </ComponentPreview>

    <ComponentPreview Title="Alphanumeric" Code="@AlphanumericCode">
        <InputOtpCn MaxLength="6" Pattern="@InputOtpCn.RegexpOnlyDigitsAndChars">
            <InputOtpGroupCn>
                <InputOtpSlotCn Index="0" />
                <InputOtpSlotCn Index="1" />
                <InputOtpSlotCn Index="2" />
            </InputOtpGroupCn>
            <InputOtpSeparatorCn />
            <InputOtpGroupCn>
                <InputOtpSlotCn Index="3" />
                <InputOtpSlotCn Index="4" />
                <InputOtpSlotCn Index="5" />
            </InputOtpGroupCn>
        </InputOtpCn>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div dir="rtl" class="mx-auto max-w-xs space-y-2">
            <LabelCn>رمز التحقق</LabelCn>
            <InputOtpCn MaxLength="6" Value="123456">
                <InputOtpGroupCn>
                    <InputOtpSlotCn Index="0" />
                    <InputOtpSlotCn Index="1" />
                    <InputOtpSlotCn Index="2" />
                    <InputOtpSlotCn Index="3" />
                    <InputOtpSlotCn Index="4" />
                    <InputOtpSlotCn Index="5" />
                </InputOtpGroupCn>
            </InputOtpCn>
        </div>
    </ComponentPreview>
</div>

