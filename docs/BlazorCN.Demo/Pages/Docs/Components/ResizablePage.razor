@page "/docs/components/resizable"
@layout DocsLayout

<PageTitle>Resizable — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Resizable</h1>
        <p class="mt-2 text-lg text-muted-foreground">Accessible resizable panel groups and layouts with keyboard support.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <ResizablePanelGroupCn Direction="ResizableDirection.Horizontal" Class="max-w-sm rounded-lg border">
            <ResizablePanelCn DefaultSize="50">
                <div class="flex h-[200px] items-center justify-center p-6">
                    <span class="font-semibold">One</span>
                </div>
            </ResizablePanelCn>
            <ResizableHandleCn WithHandle="true" />
            <ResizablePanelCn DefaultSize="50">
                <ResizablePanelGroupCn Direction="ResizableDirection.Vertical">
                    <ResizablePanelCn DefaultSize="25">
                        <div class="flex h-full items-center justify-center p-6">
                            <span class="font-semibold">Two</span>
                        </div>
                    </ResizablePanelCn>
                    <ResizableHandleCn WithHandle="true" />
                    <ResizablePanelCn DefaultSize="75">
                        <div class="flex h-full items-center justify-center p-6">
                            <span class="font-semibold">Three</span>
                        </div>
                    </ResizablePanelCn>
                </ResizablePanelGroupCn>
            </ResizablePanelCn>
        </ResizablePanelGroupCn>
    </ComponentPreview>

    <ComponentPreview Title="Handle" Code="@HandleCode">
        <ResizablePanelGroupCn Direction="ResizableDirection.Horizontal" Class="min-h-[200px] max-w-md rounded-lg border md:min-w-[450px]">
            <ResizablePanelCn DefaultSize="25">
                <div class="flex h-full items-center justify-center p-6">
                    <span class="font-semibold">Sidebar</span>
                </div>
            </ResizablePanelCn>
            <ResizableHandleCn WithHandle="true" />
            <ResizablePanelCn DefaultSize="75">
                <div class="flex h-full items-center justify-center p-6">
                    <span class="font-semibold">Content</span>
                </div>
            </ResizablePanelCn>
        </ResizablePanelGroupCn>
    </ComponentPreview>

    <ComponentPreview Title="Vertical" Code="@VerticalCode">
        <ResizablePanelGroupCn Direction="ResizableDirection.Vertical" Class="min-h-[200px] max-w-sm rounded-lg border">
            <ResizablePanelCn DefaultSize="25">
                <div class="flex h-full items-center justify-center p-6">
                    <span class="font-semibold">Header</span>
                </div>
            </ResizablePanelCn>
            <ResizableHandleCn />
            <ResizablePanelCn DefaultSize="75">
                <div class="flex h-full items-center justify-center p-6">
                    <span class="font-semibold">Content</span>
                </div>
            </ResizablePanelCn>
        </ResizablePanelGroupCn>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div dir="rtl" class="w-full max-w-sm">
            <ResizablePanelGroupCn Direction="ResizableDirection.Horizontal" Class="max-w-sm rounded-lg border">
                <ResizablePanelCn DefaultSize="50">
                    <div class="flex h-[200px] items-center justify-center p-6">
                        <span class="font-semibold">واحد</span>
                    </div>
                </ResizablePanelCn>
                <ResizableHandleCn WithHandle="true" />
                <ResizablePanelCn DefaultSize="50">
                    <ResizablePanelGroupCn Direction="ResizableDirection.Vertical">
                        <ResizablePanelCn DefaultSize="25">
                            <div class="flex h-full items-center justify-center p-6">
                                <span class="font-semibold">اثنان</span>
                            </div>
                        </ResizablePanelCn>
                        <ResizableHandleCn WithHandle="true" />
                        <ResizablePanelCn DefaultSize="75">
                            <div class="flex h-full items-center justify-center p-6">
                                <span class="font-semibold">ثلاثة</span>
                            </div>
                        </ResizablePanelCn>
                    </ResizablePanelGroupCn>
                </ResizablePanelCn>
            </ResizablePanelGroupCn>
        </div>
    </ComponentPreview>
</div>

