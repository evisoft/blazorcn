@page "/docs/components/select"
@layout DocsLayout

<PageTitle>Select — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Select</h1>
        <p class="mt-2 text-lg text-muted-foreground">Displays a list of options for the user to pick from, triggered by a button.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <SelectCn @bind-Value="_selected">
            <SelectTriggerCn Class="w-full max-w-48">
                <SelectValueCn Placeholder="Select a fruit" />
            </SelectTriggerCn>
            <SelectContentCn>
                <SelectGroupCn>
                    <SelectLabelCn>Fruits</SelectLabelCn>
                    <SelectItemCn Value="apple">Apple</SelectItemCn>
                    <SelectItemCn Value="banana">Banana</SelectItemCn>
                    <SelectItemCn Value="blueberry">Blueberry</SelectItemCn>
                    <SelectItemCn Value="grapes">Grapes</SelectItemCn>
                    <SelectItemCn Value="pineapple">Pineapple</SelectItemCn>
                </SelectGroupCn>
            </SelectContentCn>
        </SelectCn>
    </ComponentPreview>

    <ComponentPreview Title="With Groups" Code="@GroupsCode">
        <SelectCn @bind-Value="_grouped">
            <SelectTriggerCn Class="w-full max-w-48">
                <SelectValueCn Placeholder="Select a fruit" />
            </SelectTriggerCn>
            <SelectContentCn>
                <SelectGroupCn>
                    <SelectLabelCn>Fruits</SelectLabelCn>
                    <SelectItemCn Value="apple">Apple</SelectItemCn>
                    <SelectItemCn Value="banana">Banana</SelectItemCn>
                    <SelectItemCn Value="blueberry">Blueberry</SelectItemCn>
                </SelectGroupCn>
                <SelectSeparatorCn />
                <SelectGroupCn>
                    <SelectLabelCn>Vegetables</SelectLabelCn>
                    <SelectItemCn Value="carrot">Carrot</SelectItemCn>
                    <SelectItemCn Value="broccoli">Broccoli</SelectItemCn>
                    <SelectItemCn Value="spinach">Spinach</SelectItemCn>
                </SelectGroupCn>
            </SelectContentCn>
        </SelectCn>
    </ComponentPreview>

    <ComponentPreview Title="Scrollable" Code="@ScrollableCode">
        <SelectCn @bind-Value="_timezone">
            <SelectTriggerCn Class="w-full max-w-64">
                <SelectValueCn Placeholder="Select a timezone" />
            </SelectTriggerCn>
            <SelectContentCn>
                <SelectGroupCn>
                    <SelectLabelCn>North America</SelectLabelCn>
                    <SelectItemCn Value="est">Eastern Standard Time</SelectItemCn>
                    <SelectItemCn Value="cst">Central Standard Time</SelectItemCn>
                    <SelectItemCn Value="mst">Mountain Standard Time</SelectItemCn>
                    <SelectItemCn Value="pst">Pacific Standard Time</SelectItemCn>
                    <SelectItemCn Value="akst">Alaska Standard Time</SelectItemCn>
                    <SelectItemCn Value="hst">Hawaii Standard Time</SelectItemCn>
                </SelectGroupCn>
                <SelectGroupCn>
                    <SelectLabelCn>Europe &amp; Africa</SelectLabelCn>
                    <SelectItemCn Value="gmt">Greenwich Mean Time</SelectItemCn>
                    <SelectItemCn Value="cet">Central European Time</SelectItemCn>
                    <SelectItemCn Value="eet">Eastern European Time</SelectItemCn>
                    <SelectItemCn Value="west">Western European Summer Time</SelectItemCn>
                    <SelectItemCn Value="cat">Central Africa Time</SelectItemCn>
                    <SelectItemCn Value="eat">East Africa Time</SelectItemCn>
                </SelectGroupCn>
                <SelectGroupCn>
                    <SelectLabelCn>Asia</SelectLabelCn>
                    <SelectItemCn Value="msk">Moscow Time</SelectItemCn>
                    <SelectItemCn Value="ist">India Standard Time</SelectItemCn>
                    <SelectItemCn Value="cst_china">China Standard Time</SelectItemCn>
                    <SelectItemCn Value="jst">Japan Standard Time</SelectItemCn>
                    <SelectItemCn Value="kst">Korea Standard Time</SelectItemCn>
                    <SelectItemCn Value="ist_indonesia">Indonesia Central Standard Time</SelectItemCn>
                </SelectGroupCn>
                <SelectGroupCn>
                    <SelectLabelCn>Australia &amp; Pacific</SelectLabelCn>
                    <SelectItemCn Value="awst">Australian Western Standard Time</SelectItemCn>
                    <SelectItemCn Value="acst">Australian Central Standard Time</SelectItemCn>
                    <SelectItemCn Value="aest">Australian Eastern Standard Time</SelectItemCn>
                    <SelectItemCn Value="nzst">New Zealand Standard Time</SelectItemCn>
                    <SelectItemCn Value="fjt">Fiji Time</SelectItemCn>
                </SelectGroupCn>
                <SelectGroupCn>
                    <SelectLabelCn>South America</SelectLabelCn>
                    <SelectItemCn Value="art">Argentina Time</SelectItemCn>
                    <SelectItemCn Value="bot">Bolivia Time</SelectItemCn>
                    <SelectItemCn Value="brt">Brasilia Time</SelectItemCn>
                    <SelectItemCn Value="clt">Chile Standard Time</SelectItemCn>
                </SelectGroupCn>
            </SelectContentCn>
        </SelectCn>
    </ComponentPreview>

    <ComponentPreview Title="Align Item" Code="@AlignItemCode">
        <div class="flex flex-col gap-4 w-full max-w-xs">
            <div class="flex items-center justify-between gap-4">
                <div class="space-y-0.5">
                    <LabelCn For="align-item">Align Item</LabelCn>
                    <p class="text-sm text-muted-foreground">Toggle to align the item with the trigger.</p>
                </div>
                <SwitchCn id="align-item" @bind-Checked="_alignItemWithTrigger" />
            </div>
            <SelectCn Value="banana">
                <SelectTriggerCn>
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn Align="@(_alignItemWithTrigger ? FloatingAlign.Start : FloatingAlign.Center)">
                    <SelectGroupCn>
                        <SelectItemCn Value="apple">Apple</SelectItemCn>
                        <SelectItemCn Value="banana">Banana</SelectItemCn>
                        <SelectItemCn Value="blueberry">Blueberry</SelectItemCn>
                        <SelectItemCn Value="grapes">Grapes</SelectItemCn>
                        <SelectItemCn Value="pineapple">Pineapple</SelectItemCn>
                    </SelectGroupCn>
                </SelectContentCn>
            </SelectCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Disabled" Code="@DisabledCode">
        <SelectCn Disabled="true">
            <SelectTriggerCn Class="w-full max-w-48">
                <SelectValueCn Placeholder="Select a fruit" />
            </SelectTriggerCn>
            <SelectContentCn>
                <SelectGroupCn>
                    <SelectItemCn Value="apple">Apple</SelectItemCn>
                    <SelectItemCn Value="banana">Banana</SelectItemCn>
                    <SelectItemCn Value="blueberry">Blueberry</SelectItemCn>
                    <SelectItemCn Value="grapes" Disabled="true">Grapes</SelectItemCn>
                    <SelectItemCn Value="pineapple">Pineapple</SelectItemCn>
                </SelectGroupCn>
            </SelectContentCn>
        </SelectCn>
    </ComponentPreview>

    <ComponentPreview Title="Invalid" Code="@InvalidCode">
        <FieldCn Class="max-w-48" data-invalid="">
            <FieldLabelCn>Fruit</FieldLabelCn>
            <SelectCn @bind-Value="_invalid">
                <SelectTriggerCn aria-invalid="true">
                    <SelectValueCn Placeholder="Select a fruit" />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectGroupCn>
                        <SelectItemCn Value="apple">Apple</SelectItemCn>
                        <SelectItemCn Value="banana">Banana</SelectItemCn>
                        <SelectItemCn Value="blueberry">Blueberry</SelectItemCn>
                    </SelectGroupCn>
                </SelectContentCn>
            </SelectCn>
            <FieldErrorCn>Please select a fruit.</FieldErrorCn>
        </FieldCn>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div dir="rtl">
            <SelectCn @bind-Value="_rtl">
                <SelectTriggerCn Class="w-32">
                    <SelectValueCn Placeholder="اختر فاكهة" />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectGroupCn>
                        <SelectLabelCn>الفواكه</SelectLabelCn>
                        <SelectItemCn Value="apple">تفاح</SelectItemCn>
                        <SelectItemCn Value="banana">موز</SelectItemCn>
                        <SelectItemCn Value="blueberry">توت أزرق</SelectItemCn>
                        <SelectItemCn Value="grapes">عنب</SelectItemCn>
                        <SelectItemCn Value="pineapple">أناناس</SelectItemCn>
                    </SelectGroupCn>
                    <SelectSeparatorCn />
                    <SelectGroupCn>
                        <SelectLabelCn>الخضروات</SelectLabelCn>
                        <SelectItemCn Value="carrot">جزر</SelectItemCn>
                        <SelectItemCn Value="broccoli">بروكلي</SelectItemCn>
                        <SelectItemCn Value="spinach">سبانخ</SelectItemCn>
                    </SelectGroupCn>
                </SelectContentCn>
            </SelectCn>
        </div>
    </ComponentPreview>
</div>

