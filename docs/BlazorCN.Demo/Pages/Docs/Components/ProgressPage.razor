@page "/docs/components/progress"
@layout DocsLayout

<PageTitle>Progress — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Progress</h1>
        <p class="mt-2 text-lg text-muted-foreground">Displays an indicator showing the completion progress of a task.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <ProgressCn Value="66" Class="w-[60%]" aria-label="Progress" />
    </ComponentPreview>

    <ComponentPreview Title="Controlled" Code="@ControlledCode">
        <div class="flex w-full max-w-sm flex-col gap-4">
            <ProgressCn Value="_sliderValue" aria-label="Progress" />
            <SliderCn Value="_sliderValue" ValueChanged="OnSliderChanged" Min="0" Max="100" Step="1" aria-label="Set progress" />
        </div>
    </ComponentPreview>

    <ComponentPreview Title="With Label" Code="@LabelCode">
        <div class="grid w-full max-w-sm gap-1.5">
            <LabelCn id="progress-upload-label" Class="flex justify-between">
                <span>Upload progress</span>
                <span class="ml-auto">66%</span>
            </LabelCn>
            <ProgressCn Value="66" aria-labelledby="progress-upload-label" />
        </div>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div class="grid w-full max-w-sm gap-1.5" dir="rtl">
            <LabelCn id="progress-upload-rtl-label" Class="flex justify-between">
                <span>تقدم الرفع</span>
                <span class="ms-auto">٦٦%</span>
            </LabelCn>
            <ProgressCn Value="66" Class="rtl:rotate-180" aria-labelledby="progress-upload-rtl-label" />
        </div>
    </ComponentPreview>
</div>

@code {
    private double _sliderValue = 50;

    private void OnSliderChanged(double value)
    {
        _sliderValue = value;
    }

    private const string DemoCode = @"<ProgressCn Value=""66"" Class=""w-[60%]"" aria-label=""Progress"" />";

    private const string ControlledCode = @"<div class=""flex w-full max-w-sm flex-col gap-4"">
    <ProgressCn Value=""_sliderValue"" aria-label=""Progress"" />
    <SliderCn Value=""_sliderValue"" ValueChanged=""OnSliderChanged""
              Min=""0"" Max=""100"" Step=""1"" aria-label=""Set progress"" />
</div>

@code {
    private double _sliderValue = 50;

    private void OnSliderChanged(double value)
    {
        _sliderValue = value;
    }
}";

    private const string LabelCode = @"<div class=""grid w-full max-w-sm gap-1.5"">
    <LabelCn id=""progress-upload-label"" Class=""flex justify-between"">
        <span>Upload progress</span>
        <span class=""ml-auto"">66%</span>
    </LabelCn>
    <ProgressCn Value=""66"" aria-labelledby=""progress-upload-label"" />
</div>";

    private const string RtlCode = @"<div class=""grid w-full max-w-sm gap-1.5"" dir=""rtl"">
    <LabelCn id=""progress-upload-rtl-label"" Class=""flex justify-between"">
        <span>تقدم الرفع</span>
        <span class=""ms-auto"">٦٦%</span>
    </LabelCn>
    <ProgressCn Value=""66"" Class=""rtl:rotate-180"" aria-labelledby=""progress-upload-rtl-label"" />
</div>";
}
