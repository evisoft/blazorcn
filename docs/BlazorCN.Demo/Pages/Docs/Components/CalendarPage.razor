@page "/docs/components/calendar"
@layout DocsLayout

<PageTitle>Calendar — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Calendar</h1>
        <p class="mt-2 text-lg text-muted-foreground">A date field component that allows users to enter and edit date.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <CalendarCn @bind-Value="_selectedDate" Class="rounded-lg border" />
    </ComponentPreview>

    <ComponentPreview Title="Basic" Code="@BasicCode">
        <CalendarCn Class="rounded-lg border" />
    </ComponentPreview>

    <ComponentPreview Title="Multiple Selection" Code="@MultipleCode">
        <CardCn Class="mx-auto w-fit p-0">
            <CardContentCn Class="p-0">
                <CalendarCn Mode="CalendarSelectionMode.Multiple"
                            @bind-SelectedDates="_multipleDates" />
            </CardContentCn>
        </CardCn>
        <p class="mt-2 text-sm text-muted-foreground">
            Selected: @(_multipleDates?.Count ?? 0) date(s)
        </p>
    </ComponentPreview>

    <ComponentPreview Title="Range Selection" Code="@RangeCode">
        <CardCn Class="mx-auto w-fit p-0">
            <CardContentCn Class="p-0">
                <CalendarCn Mode="CalendarSelectionMode.Range"
                            @bind-RangeStart="_rangeStart"
                            @bind-RangeEnd="_rangeEnd" />
            </CardContentCn>
        </CardCn>
        <p class="mt-2 text-sm text-muted-foreground">
            @if (_rangeStart.HasValue && _rangeEnd.HasValue)
            {
                @($"{_rangeStart.Value:MMM dd} — {_rangeEnd.Value:MMM dd}")
            }
            else if (_rangeStart.HasValue)
            {
                @($"{_rangeStart.Value:MMM dd} — pick end date")
            }
            else
            {
                @("Pick a start date")
            }
        </p>
    </ComponentPreview>

    <ComponentPreview Title="Booked / Disabled Dates" Code="@BookedCode">
        <CardCn Class="mx-auto w-fit p-0">
            <CardContentCn Class="p-0">
                <CalendarCn @bind-Value="_bookedDate"
                            DisabledDates="@_bookedDates" />
            </CardContentCn>
        </CardCn>
        <p class="mt-2 text-sm text-muted-foreground">
            Dates with a line-through are booked and cannot be selected.
        </p>
    </ComponentPreview>

    <ComponentPreview Title="Week Numbers" Code="@WeekNumbersCode">
        <CardCn Class="mx-auto w-fit p-0">
            <CardContentCn Class="p-0">
                <CalendarCn @bind-Value="_weekNumDate" ShowWeekNumbers="true" />
            </CardContentCn>
        </CardCn>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div dir="rtl">
            <CalendarCn @bind-Value="_rtlDate" Class="rounded-lg border" />
        </div>
    </ComponentPreview>

    <ComponentPreview Title="With Presets" Code="@PresetsCode">
        <CardCn Class="mx-auto w-fit max-w-[300px]" Size="sm">
            <CardContentCn>
                <CalendarCn @bind-Value="_presetDate" Class="p-0" />
            </CardContentCn>
            <CardFooterCn Class="flex flex-wrap gap-2 border-t">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="flex-1" OnClick="@(() => SetPresetDate(0))">Today</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="flex-1" OnClick="@(() => SetPresetDate(1))">Tomorrow</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="flex-1" OnClick="@(() => SetPresetDate(3))">In 3 days</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="flex-1" OnClick="@(() => SetPresetDate(7))">In a week</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="flex-1" OnClick="@(() => SetPresetDate(14))">In 2 weeks</ButtonCn>
            </CardFooterCn>
        </CardCn>
    </ComponentPreview>

    <ComponentPreview Title="Min and Max Date" Code="@MinMaxCode">
        <CalendarCn @bind-Value="_constrainedDate" MinDate="@_minDate" MaxDate="@_maxDate" Class="rounded-lg border" />
        <p class="mt-2 text-sm text-muted-foreground">Dates before today or more than 30 days out are disabled.</p>
    </ComponentPreview>

    <ComponentPreview Title="In a Card" Code="@CardExampleCode">
        <CardCn Class="mx-auto w-fit p-0">
            <CardContentCn Class="p-0">
                <CalendarCn @bind-Value="_cardDate" />
            </CardContentCn>
        </CardCn>
    </ComponentPreview>
</div>

@code {
    private DateTime? _selectedDate = DateTime.Today;
    private DateTime? _presetDate = DateTime.Today;
    private DateTime? _constrainedDate = DateTime.Today;
    private DateTime? _cardDate = DateTime.Today;
    private DateTime _minDate = DateTime.Today;
    private DateTime _maxDate = DateTime.Today.AddDays(30);

    // Multiple
    private List<DateTime>? _multipleDates = new();

    // Range
    private DateTime? _rangeStart;
    private DateTime? _rangeEnd;

    // Booked dates
    private DateTime? _bookedDate;
    private List<DateTime> _bookedDates = Enumerable.Range(0, 15)
        .Select(i => new DateTime(DateTime.Today.Year, DateTime.Today.Month, Math.Min(12 + i, DateTime.DaysInMonth(DateTime.Today.Year, DateTime.Today.Month))))
        .Distinct()
        .ToList();

    // Week numbers
    private DateTime? _weekNumDate = DateTime.Today;

    // RTL
    private DateTime? _rtlDate = DateTime.Today;

    private void SetPresetDate(int daysFromNow)
    {
        _presetDate = DateTime.Today.AddDays(daysFromNow);
    }

    private const string DemoCode = @"<CalendarCn @bind-Value=""_selectedDate"" Class=""rounded-lg border"" />

@code {
    private DateTime? _selectedDate = DateTime.Today;
}";

    private const string BasicCode = @"<CalendarCn Class=""rounded-lg border"" />";

    private const string MultipleCode = @"<CalendarCn Mode=""CalendarSelectionMode.Multiple""
            @bind-SelectedDates=""_multipleDates"" />

@code {
    private List<DateTime>? _multipleDates = new();
}";

    private const string RangeCode = @"<CalendarCn Mode=""CalendarSelectionMode.Range""
            @bind-RangeStart=""_rangeStart""
            @bind-RangeEnd=""_rangeEnd"" />

@code {
    private DateTime? _rangeStart;
    private DateTime? _rangeEnd;
}";

    private const string BookedCode = @"<CalendarCn @bind-Value=""_bookedDate""
            DisabledDates=""@_bookedDates"" />

@code {
    private DateTime? _bookedDate;
    private List<DateTime> _bookedDates = Enumerable.Range(0, 15)
        .Select(i => new DateTime(DateTime.Today.Year, DateTime.Today.Month,
            Math.Min(12 + i, DateTime.DaysInMonth(DateTime.Today.Year, DateTime.Today.Month))))
        .Distinct()
        .ToList();
}";

    private const string WeekNumbersCode = @"<CalendarCn @bind-Value=""_weekNumDate"" ShowWeekNumbers=""true"" />

@code {
    private DateTime? _weekNumDate = DateTime.Today;
}";

    private const string RtlCode = @"<div dir=""rtl"">
    <CalendarCn @bind-Value=""_rtlDate"" Class=""rounded-lg border"" />
</div>

@code {
    private DateTime? _rtlDate = DateTime.Today;
}";

    private const string PresetsCode = @"<CardCn Class=""mx-auto w-fit max-w-[300px]"" Size=""sm"">
    <CardContentCn>
        <CalendarCn @bind-Value=""_presetDate"" Class=""p-0"" />
    </CardContentCn>
    <CardFooterCn Class=""flex flex-wrap gap-2 border-t"">
        <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm"" Class=""flex-1""
                  OnClick=""@(() => SetPresetDate(0))"">Today</ButtonCn>
        <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm"" Class=""flex-1""
                  OnClick=""@(() => SetPresetDate(1))"">Tomorrow</ButtonCn>
        <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm"" Class=""flex-1""
                  OnClick=""@(() => SetPresetDate(3))"">In 3 days</ButtonCn>
        <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm"" Class=""flex-1""
                  OnClick=""@(() => SetPresetDate(7))"">In a week</ButtonCn>
        <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm"" Class=""flex-1""
                  OnClick=""@(() => SetPresetDate(14))"">In 2 weeks</ButtonCn>
    </CardFooterCn>
</CardCn>

@code {
    private DateTime? _presetDate = DateTime.Today;

    private void SetPresetDate(int daysFromNow)
    {
        _presetDate = DateTime.Today.AddDays(daysFromNow);
    }
}";

    private const string MinMaxCode = @"<CalendarCn @bind-Value=""_constrainedDate""
             MinDate=""@_minDate""
             MaxDate=""@_maxDate""
             Class=""rounded-lg border"" />

@code {
    private DateTime? _constrainedDate = DateTime.Today;
    private DateTime _minDate = DateTime.Today;
    private DateTime _maxDate = DateTime.Today.AddDays(30);
}";

    private const string CardExampleCode = @"<CardCn Class=""mx-auto w-fit p-0"">
    <CardContentCn Class=""p-0"">
        <CalendarCn @bind-Value=""_cardDate"" />
    </CardContentCn>
</CardCn>

@code {
    private DateTime? _cardDate = DateTime.Today;
}";
}
