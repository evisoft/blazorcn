@page "/docs/components/pagination"
@layout DocsLayout

<PageTitle>Pagination — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Pagination</h1>
        <p class="mt-2 text-lg text-muted-foreground">Pagination with page navigation, previous and next links.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <PaginationCn>
            <PaginationContentCn>
                <PaginationItemCn>
                    <PaginationPreviousCn Href="#" />
                </PaginationItemCn>
                <PaginationItemCn>
                    <PaginationLinkCn Href="#">1</PaginationLinkCn>
                </PaginationItemCn>
                <PaginationItemCn>
                    <PaginationLinkCn Href="#" IsActive="true">2</PaginationLinkCn>
                </PaginationItemCn>
                <PaginationItemCn>
                    <PaginationLinkCn Href="#">3</PaginationLinkCn>
                </PaginationItemCn>
                <PaginationItemCn>
                    <PaginationEllipsisCn />
                </PaginationItemCn>
                <PaginationItemCn>
                    <PaginationNextCn Href="#" />
                </PaginationItemCn>
            </PaginationContentCn>
        </PaginationCn>
    </ComponentPreview>

    <ComponentPreview Title="Simple" Code="@SimpleCode">
        <PaginationCn>
            <PaginationContentCn>
                <PaginationItemCn>
                    <PaginationLinkCn Href="#">1</PaginationLinkCn>
                </PaginationItemCn>
                <PaginationItemCn>
                    <PaginationLinkCn Href="#" IsActive="true">2</PaginationLinkCn>
                </PaginationItemCn>
                <PaginationItemCn>
                    <PaginationLinkCn Href="#">3</PaginationLinkCn>
                </PaginationItemCn>
                <PaginationItemCn>
                    <PaginationLinkCn Href="#">4</PaginationLinkCn>
                </PaginationItemCn>
                <PaginationItemCn>
                    <PaginationLinkCn Href="#">5</PaginationLinkCn>
                </PaginationItemCn>
            </PaginationContentCn>
        </PaginationCn>
    </ComponentPreview>

    <ComponentPreview Title="Rows Per Page" Code="@IconsOnlyCode">
        <div class="flex items-center justify-between gap-4">
            <div class="flex shrink-0 items-center gap-2">
                <LabelCn For="select-rows-per-page" Class="whitespace-nowrap">Rows per page</LabelCn>
                <SelectCn Value="@_rowsPerPage" ValueChanged="OnRowsPerPageChanged">
                    <SelectTriggerCn Class="w-20" id="select-rows-per-page">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn Align="FloatingAlign.Start">
                        <SelectGroupCn>
                            <SelectItemCn Value="10">10</SelectItemCn>
                            <SelectItemCn Value="25">25</SelectItemCn>
                            <SelectItemCn Value="50">50</SelectItemCn>
                            <SelectItemCn Value="100">100</SelectItemCn>
                        </SelectGroupCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
            <PaginationCn Class="mx-0 w-auto">
                <PaginationContentCn>
                    <PaginationItemCn>
                        <PaginationPreviousCn Href="#" />
                    </PaginationItemCn>
                    <PaginationItemCn>
                        <PaginationNextCn Href="#" />
                    </PaginationItemCn>
                </PaginationContentCn>
            </PaginationCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div dir="rtl">
            <PaginationCn>
                <PaginationContentCn>
                    <PaginationItemCn>
                        <PaginationPreviousCn Href="#" />
                    </PaginationItemCn>
                    <PaginationItemCn>
                        <PaginationLinkCn Href="#">١</PaginationLinkCn>
                    </PaginationItemCn>
                    <PaginationItemCn>
                        <PaginationLinkCn Href="#" IsActive="true">٢</PaginationLinkCn>
                    </PaginationItemCn>
                    <PaginationItemCn>
                        <PaginationLinkCn Href="#">٣</PaginationLinkCn>
                    </PaginationItemCn>
                    <PaginationItemCn>
                        <PaginationEllipsisCn />
                    </PaginationItemCn>
                    <PaginationItemCn>
                        <PaginationNextCn Href="#" />
                    </PaginationItemCn>
                </PaginationContentCn>
            </PaginationCn>
        </div>
    </ComponentPreview>
</div>

@code {
    private string _rowsPerPage = "25";

