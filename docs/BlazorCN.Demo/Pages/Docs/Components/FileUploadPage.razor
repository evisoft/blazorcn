@page "/docs/components/file-upload"
@layout DocsLayout

<PageTitle>File Upload — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">File Upload</h1>
        <p class="mt-2 text-lg text-muted-foreground">A file upload pattern using existing components. Compose a drag-and-drop zone or file list with Card, Empty, Progress, and Input.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Upload Area" Code="@UploadAreaCode">
        <CardCn Class="w-full max-w-sm">
            <CardHeaderCn>
                <CardTitleCn>File Upload</CardTitleCn>
                <CardDescriptionCn>Drag and drop or browse</CardDescriptionCn>
            </CardHeaderCn>
            <CardContentCn>
                <EmptyCn Class="border border-dashed">
                    <div class="flex max-w-sm flex-col items-center gap-2">
                        <div class="mb-2 flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted text-foreground [&>svg:not([class*='size-'])]:size-4">
                            <LucideCloudUploadCn Size="16" />
                        </div>
                        <div class="text-sm font-medium tracking-tight">Upload files</div>
                        <div class="text-sm/relaxed text-muted-foreground">PNG, JPG, PDF up to 10MB</div>
                    </div>
                    <div class="flex w-full max-w-sm min-w-0 flex-col items-center gap-2.5 text-sm">
                        <ButtonCn>Browse Files</ButtonCn>
                    </div>
                </EmptyCn>
            </CardContentCn>
        </CardCn>
    </ComponentPreview>

    <ComponentPreview Title="File Input" Code="@FileInputCode">
        <div class="grid w-full max-w-sm gap-1.5">
            <LabelCn For="file-upload-input">Attachment</LabelCn>
            <InputCn id="file-upload-input" Type="file" />
            <p class="text-sm text-muted-foreground">Select a file to upload.</p>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Upload List" Code="@UploadListCode">
        <div class="w-full max-w-md space-y-2">
            @foreach (var file in _files)
            {
                <div class="flex items-center gap-3 rounded-md px-3 py-2">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted text-foreground [&>svg:not([class*='size-'])]:size-4">
                        <LucideFileCn Size="16" />
                    </div>
                    <span class="min-w-0 truncate text-sm font-medium">@file.Name</span>
                    <ProgressCn Value="@file.Progress" Class="w-32 ml-auto" />
                    <span class="w-16 shrink-0 text-right text-sm text-muted-foreground">@file.TimeRemaining</span>
                </div>
            }
        </div>
    </ComponentPreview>
</div>

@code {
    private record FileItem(string Name, double Progress, string TimeRemaining);

    private readonly FileItem[] _files =
    [
        new("document.pdf", 45, "2m 30s"),
        new("presentation.pptx", 78, "45s"),
        new("spreadsheet.xlsx", 12, "5m 12s"),
        new("image.jpg", 100, "Complete"),
    ];

    private const string UploadAreaCode = @"<CardCn Class=""w-full max-w-sm"">
    <CardHeaderCn>
        <CardTitleCn>File Upload</CardTitleCn>
        <CardDescriptionCn>Drag and drop or browse</CardDescriptionCn>
    </CardHeaderCn>
    <CardContentCn>
        <EmptyCn Class=""border border-dashed"">
            <div class=""flex max-w-sm flex-col items-center gap-2"">
                <div class=""mb-2 flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted text-foreground"">
                    <LucideCloudUploadCn Size=""16"" />
                </div>
                <div class=""text-sm font-medium tracking-tight"">Upload files</div>
                <div class=""text-sm/relaxed text-muted-foreground"">PNG, JPG, PDF up to 10MB</div>
            </div>
            <div class=""flex w-full max-w-sm min-w-0 flex-col items-center gap-2.5 text-sm"">
                <ButtonCn>Browse Files</ButtonCn>
            </div>
        </EmptyCn>
    </CardContentCn>
</CardCn>";

    private const string FileInputCode = @"<div class=""grid w-full max-w-sm gap-1.5"">
    <LabelCn For=""file-upload-input"">Attachment</LabelCn>
    <InputCn id=""file-upload-input"" Type=""file"" />
    <p class=""text-sm text-muted-foreground"">Select a file to upload.</p>
</div>";

    private const string UploadListCode = @"<div class=""w-full max-w-md space-y-2"">
    @foreach (var file in _files)
    {
        <div class=""flex items-center gap-3 rounded-md px-3 py-2"">
            <div class=""flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted text-foreground"">
                <LucideFileCn Size=""16"" />
            </div>
            <span class=""min-w-0 truncate text-sm font-medium"">@file.Name</span>
            <ProgressCn Value=""@file.Progress"" Class=""w-32 ml-auto"" />
            <span class=""w-16 shrink-0 text-right text-sm text-muted-foreground"">
                @file.TimeRemaining
            </span>
        </div>
    }
</div>

@code {
    private record FileItem(string Name, double Progress, string TimeRemaining);

    private readonly FileItem[] _files =
    [
        new(""document.pdf"", 45, ""2m 30s""),
        new(""presentation.pptx"", 78, ""45s""),
        new(""spreadsheet.xlsx"", 12, ""5m 12s""),
        new(""image.jpg"", 100, ""Complete""),
    ];
}";
}
