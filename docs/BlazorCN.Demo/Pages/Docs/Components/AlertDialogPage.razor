@page "/docs/components/alert-dialog"
@layout DocsLayout

<PageTitle>Alert Dialog — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Alert Dialog</h1>
        <p class="mt-2 text-lg text-muted-foreground">A modal dialog that interrupts the user with important content and expects a response.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <AlertDialogCn>
            <AlertDialogTriggerCn>
                <ButtonCn Variant="ButtonVariant.Outline">Show Dialog</ButtonCn>
            </AlertDialogTriggerCn>
            <AlertDialogOverlayCn />
            <AlertDialogContentCn>
                <AlertDialogHeaderCn>
                    <AlertDialogTitleCn>Are you absolutely sure?</AlertDialogTitleCn>
                    <AlertDialogDescriptionCn>
                        This action cannot be undone. This will permanently delete your
                        account from our servers.
                    </AlertDialogDescriptionCn>
                </AlertDialogHeaderCn>
                <AlertDialogFooterCn>
                    <AlertDialogCancelCn>Cancel</AlertDialogCancelCn>
                    <AlertDialogActionCn>Continue</AlertDialogActionCn>
                </AlertDialogFooterCn>
            </AlertDialogContentCn>
        </AlertDialogCn>
    </ComponentPreview>

    <ComponentPreview Title="Basic" Code="@BasicCode">
        <AlertDialogCn>
            <AlertDialogTriggerCn>
                <ButtonCn Variant="ButtonVariant.Outline">Show Dialog</ButtonCn>
            </AlertDialogTriggerCn>
            <AlertDialogOverlayCn />
            <AlertDialogContentCn>
                <AlertDialogHeaderCn>
                    <AlertDialogTitleCn>Are you absolutely sure?</AlertDialogTitleCn>
                    <AlertDialogDescriptionCn>
                        This action cannot be undone. This will permanently delete your
                        account and remove your data from our servers.
                    </AlertDialogDescriptionCn>
                </AlertDialogHeaderCn>
                <AlertDialogFooterCn>
                    <AlertDialogCancelCn>Cancel</AlertDialogCancelCn>
                    <AlertDialogActionCn>Continue</AlertDialogActionCn>
                </AlertDialogFooterCn>
            </AlertDialogContentCn>
        </AlertDialogCn>
    </ComponentPreview>

    <ComponentPreview Title="Destructive" Code="@DestructiveCode">
        <AlertDialogCn>
            <AlertDialogTriggerCn>
                <ButtonCn Variant="ButtonVariant.Destructive">Delete Chat</ButtonCn>
            </AlertDialogTriggerCn>
            <AlertDialogOverlayCn />
            <AlertDialogContentCn Size="AlertDialogSize.Sm">
                <AlertDialogHeaderCn>
                    <AlertDialogMediaCn Class="bg-destructive/10 text-destructive dark:bg-destructive/20 dark:text-destructive">
                        <LucideTrash2Cn />
                    </AlertDialogMediaCn>
                    <AlertDialogTitleCn>Delete chat?</AlertDialogTitleCn>
                    <AlertDialogDescriptionCn>
                        This will permanently delete this chat conversation. View
                        <a href="#" class="underline">Settings</a> to delete any memories saved during this chat.
                    </AlertDialogDescriptionCn>
                </AlertDialogHeaderCn>
                <AlertDialogFooterCn>
                    <AlertDialogCancelCn>Cancel</AlertDialogCancelCn>
                    <AlertDialogActionCn class="bg-destructive text-white hover:bg-destructive/90">Delete</AlertDialogActionCn>
                </AlertDialogFooterCn>
            </AlertDialogContentCn>
        </AlertDialogCn>
    </ComponentPreview>

    <ComponentPreview Title="With Media" Code="@MediaCode">
        <AlertDialogCn>
            <AlertDialogTriggerCn>
                <ButtonCn Variant="ButtonVariant.Outline">Share Project</ButtonCn>
            </AlertDialogTriggerCn>
            <AlertDialogOverlayCn />
            <AlertDialogContentCn>
                <AlertDialogHeaderCn>
                    <AlertDialogMediaCn>
                        <LucideCircleFadingPlusCn />
                    </AlertDialogMediaCn>
                    <AlertDialogTitleCn>Share this project?</AlertDialogTitleCn>
                    <AlertDialogDescriptionCn>
                        Anyone with the link will be able to view and edit this project.
                    </AlertDialogDescriptionCn>
                </AlertDialogHeaderCn>
                <AlertDialogFooterCn>
                    <AlertDialogCancelCn>Cancel</AlertDialogCancelCn>
                    <AlertDialogActionCn>Share</AlertDialogActionCn>
                </AlertDialogFooterCn>
            </AlertDialogContentCn>
        </AlertDialogCn>
    </ComponentPreview>

    <ComponentPreview Title="Small" Code="@SmallCode">
        <AlertDialogCn>
            <AlertDialogTriggerCn>
                <ButtonCn Variant="ButtonVariant.Outline">Show Dialog</ButtonCn>
            </AlertDialogTriggerCn>
            <AlertDialogOverlayCn />
            <AlertDialogContentCn Size="AlertDialogSize.Sm">
                <AlertDialogHeaderCn>
                    <AlertDialogTitleCn>Allow accessory to connect?</AlertDialogTitleCn>
                    <AlertDialogDescriptionCn>
                        Do you want to allow the USB accessory to connect to this device?
                    </AlertDialogDescriptionCn>
                </AlertDialogHeaderCn>
                <AlertDialogFooterCn>
                    <AlertDialogCancelCn>Don't allow</AlertDialogCancelCn>
                    <AlertDialogActionCn>Allow</AlertDialogActionCn>
                </AlertDialogFooterCn>
            </AlertDialogContentCn>
        </AlertDialogCn>
    </ComponentPreview>

    <ComponentPreview Title="Small with Media" Code="@SmallMediaCode">
        <AlertDialogCn>
            <AlertDialogTriggerCn>
                <ButtonCn Variant="ButtonVariant.Outline">Show Dialog</ButtonCn>
            </AlertDialogTriggerCn>
            <AlertDialogOverlayCn />
            <AlertDialogContentCn Size="AlertDialogSize.Sm">
                <AlertDialogHeaderCn>
                    <AlertDialogMediaCn>
                        <LucideBluetoothCn />
                    </AlertDialogMediaCn>
                    <AlertDialogTitleCn>Allow accessory to connect?</AlertDialogTitleCn>
                    <AlertDialogDescriptionCn>
                        Do you want to allow the USB accessory to connect to this device?
                    </AlertDialogDescriptionCn>
                </AlertDialogHeaderCn>
                <AlertDialogFooterCn>
                    <AlertDialogCancelCn>Don't allow</AlertDialogCancelCn>
                    <AlertDialogActionCn>Allow</AlertDialogActionCn>
                </AlertDialogFooterCn>
            </AlertDialogContentCn>
        </AlertDialogCn>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div class="flex gap-4" dir="rtl">
            <AlertDialogCn>
                <AlertDialogTriggerCn>
                    <ButtonCn Variant="ButtonVariant.Outline">إظهار الحوار</ButtonCn>
                </AlertDialogTriggerCn>
                <AlertDialogOverlayCn />
                <AlertDialogContentCn dir="rtl">
                    <AlertDialogHeaderCn>
                        <AlertDialogTitleCn>هل أنت متأكد تمامًا؟</AlertDialogTitleCn>
                        <AlertDialogDescriptionCn>
                            لا يمكن التراجع عن هذا الإجراء. سيؤدي هذا إلى حذف حسابك نهائيًا من خوادمنا.
                        </AlertDialogDescriptionCn>
                    </AlertDialogHeaderCn>
                    <AlertDialogFooterCn>
                        <AlertDialogCancelCn>إلغاء</AlertDialogCancelCn>
                        <AlertDialogActionCn>متابعة</AlertDialogActionCn>
                    </AlertDialogFooterCn>
                </AlertDialogContentCn>
            </AlertDialogCn>
            <AlertDialogCn>
                <AlertDialogTriggerCn>
                    <ButtonCn Variant="ButtonVariant.Outline">إظهار الحوار (صغير)</ButtonCn>
                </AlertDialogTriggerCn>
                <AlertDialogOverlayCn />
                <AlertDialogContentCn Size="AlertDialogSize.Sm" dir="rtl">
                    <AlertDialogHeaderCn>
                        <AlertDialogMediaCn>
                            <LucideBluetoothCn />
                        </AlertDialogMediaCn>
                        <AlertDialogTitleCn>السماح للملحق بالاتصال؟</AlertDialogTitleCn>
                        <AlertDialogDescriptionCn>
                            هل تريد السماح لملحق USB بالاتصال بهذا الجهاز؟
                        </AlertDialogDescriptionCn>
                    </AlertDialogHeaderCn>
                    <AlertDialogFooterCn>
                        <AlertDialogCancelCn>عدم السماح</AlertDialogCancelCn>
                        <AlertDialogActionCn>السماح</AlertDialogActionCn>
                    </AlertDialogFooterCn>
                </AlertDialogContentCn>
            </AlertDialogCn>
        </div>
    </ComponentPreview>
</div>

