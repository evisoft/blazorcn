@page "/docs/components/collapsible"
@layout DocsLayout

<PageTitle>Collapsible — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Collapsible</h1>
        <p class="mt-2 text-lg text-muted-foreground">An interactive component which expands and collapses a panel.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <CollapsibleCn @bind-Open="_demoOpen" Class="flex w-[350px] flex-col gap-2">
            <div class="flex items-center justify-between gap-4 px-4">
                <h4 class="text-sm font-semibold">Order #4189</h4>
                <CollapsibleTriggerCn class="inline-flex items-center justify-center rounded-lg text-sm font-medium">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8">
                        <LucideChevronsUpDownCn Size="16" />
                        <span class="sr-only">Toggle details</span>
                    </ButtonCn>
                </CollapsibleTriggerCn>
            </div>
            <div class="flex items-center justify-between rounded-md border px-4 py-2 text-sm">
                <span class="text-muted-foreground">Status</span>
                <span class="font-medium">Shipped</span>
            </div>
            <CollapsibleContentCn class="flex flex-col gap-2">
                <div class="rounded-md border px-4 py-2 text-sm">
                    <p class="font-medium">Shipping address</p>
                    <p class="text-muted-foreground">100 Market St, San Francisco</p>
                </div>
                <div class="rounded-md border px-4 py-2 text-sm">
                    <p class="font-medium">Items</p>
                    <p class="text-muted-foreground">2x Studio Headphones</p>
                </div>
            </CollapsibleContentCn>
        </CollapsibleCn>
    </ComponentPreview>

    <ComponentPreview Title="Basic" Code="@BasicCode">
        <CardCn Class="mx-auto w-full max-w-sm">
            <CardContentCn>
                <CollapsibleCn Class="rounded-md data-[state=open]:bg-muted">
                    <CollapsibleTriggerCn class="w-full">
                        <ButtonCn Variant="ButtonVariant.Ghost" Class="group w-full">
                            Product details
                            <LucideChevronDownCn Class="ml-auto group-data-[state=open]:rotate-180" Size="16" />
                        </ButtonCn>
                    </CollapsibleTriggerCn>
                    <CollapsibleContentCn class="flex flex-col items-start gap-2 p-2.5 pt-0 text-sm">
                        <div>
                            This panel can be expanded or collapsed to reveal additional content.
                        </div>
                        <ButtonCn Size="ButtonSize.Xs">Learn More</ButtonCn>
                    </CollapsibleContentCn>
                </CollapsibleCn>
            </CardContentCn>
        </CardCn>
    </ComponentPreview>

    <ComponentPreview Title="File Tree" Code="@FileTreeCode">
        <CardCn Class="mx-auto w-full max-w-[16rem] gap-2" Size="sm">
            <CardHeaderCn>
                <TabsCn DefaultValue="explorer">
                    <TabsListCn Class="w-full">
                        <TabsTriggerCn Value="explorer">Explorer</TabsTriggerCn>
                        <TabsTriggerCn Value="outline">Outline</TabsTriggerCn>
                    </TabsListCn>
                </TabsCn>
            </CardHeaderCn>
            <CardContentCn>
                <div class="flex flex-col gap-1">
                    @* components folder *@
                    <CollapsibleCn>
                        <CollapsibleTriggerCn class="w-full">
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="group w-full justify-start transition-none hover:bg-accent hover:text-accent-foreground">
                                <LucideChevronRightCn Class="transition-transform group-data-[state=open]:rotate-90" Size="16" />
                                <LucideFolderCn Size="16" />
                                components
                            </ButtonCn>
                        </CollapsibleTriggerCn>
                        <CollapsibleContentCn class="mt-1 ml-5">
                            <div class="flex flex-col gap-1">
                                @* ui subfolder *@
                                <CollapsibleCn>
                                    <CollapsibleTriggerCn class="w-full">
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="group w-full justify-start transition-none hover:bg-accent hover:text-accent-foreground">
                                            <LucideChevronRightCn Class="transition-transform group-data-[state=open]:rotate-90" Size="16" />
                                            <LucideFolderCn Size="16" />
                                            ui
                                        </ButtonCn>
                                    </CollapsibleTriggerCn>
                                    <CollapsibleContentCn class="mt-1 ml-5">
                                        <div class="flex flex-col gap-1">
                                            <ButtonCn Variant="ButtonVariant.Link" Size="ButtonSize.Sm" Class="w-full justify-start gap-2 text-foreground">
                                                <LucideFileCn Size="16" />
                                                <span>button.tsx</span>
                                            </ButtonCn>
                                            <ButtonCn Variant="ButtonVariant.Link" Size="ButtonSize.Sm" Class="w-full justify-start gap-2 text-foreground">
                                                <LucideFileCn Size="16" />
                                                <span>card.tsx</span>
                                            </ButtonCn>
                                            <ButtonCn Variant="ButtonVariant.Link" Size="ButtonSize.Sm" Class="w-full justify-start gap-2 text-foreground">
                                                <LucideFileCn Size="16" />
                                                <span>dialog.tsx</span>
                                            </ButtonCn>
                                        </div>
                                    </CollapsibleContentCn>
                                </CollapsibleCn>
                                <ButtonCn Variant="ButtonVariant.Link" Size="ButtonSize.Sm" Class="w-full justify-start gap-2 text-foreground">
                                    <LucideFileCn Size="16" />
                                    <span>login-form.tsx</span>
                                </ButtonCn>
                            </div>
                        </CollapsibleContentCn>
                    </CollapsibleCn>
                    @* lib folder *@
                    <CollapsibleCn>
                        <CollapsibleTriggerCn class="w-full">
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="group w-full justify-start transition-none hover:bg-accent hover:text-accent-foreground">
                                <LucideChevronRightCn Class="transition-transform group-data-[state=open]:rotate-90" Size="16" />
                                <LucideFolderCn Size="16" />
                                lib
                            </ButtonCn>
                        </CollapsibleTriggerCn>
                        <CollapsibleContentCn class="mt-1 ml-5">
                            <div class="flex flex-col gap-1">
                                <ButtonCn Variant="ButtonVariant.Link" Size="ButtonSize.Sm" Class="w-full justify-start gap-2 text-foreground">
                                    <LucideFileCn Size="16" />
                                    <span>utils.ts</span>
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Link" Size="ButtonSize.Sm" Class="w-full justify-start gap-2 text-foreground">
                                    <LucideFileCn Size="16" />
                                    <span>cn.ts</span>
                                </ButtonCn>
                            </div>
                        </CollapsibleContentCn>
                    </CollapsibleCn>
                    @* Root files *@
                    <ButtonCn Variant="ButtonVariant.Link" Size="ButtonSize.Sm" Class="w-full justify-start gap-2 text-foreground">
                        <LucideFileCn Size="16" />
                        <span>app.tsx</span>
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Link" Size="ButtonSize.Sm" Class="w-full justify-start gap-2 text-foreground">
                        <LucideFileCn Size="16" />
                        <span>package.json</span>
                    </ButtonCn>
                </div>
            </CardContentCn>
        </CardCn>
    </ComponentPreview>

    <ComponentPreview Title="Settings" Code="@SettingsCode">
        <CardCn Class="mx-auto w-full max-w-xs" Size="sm">
            <CardHeaderCn>
                <CardTitleCn>Radius</CardTitleCn>
                <CardDescriptionCn>Set the corner radius of the element.</CardDescriptionCn>
            </CardHeaderCn>
            <CardContentCn>
                <CollapsibleCn @bind-Open="_settingsOpen" Class="flex items-start gap-2">
                    <div class="grid w-full grid-cols-2 gap-2">
                        <InputCn placeholder="0" Value="0" />
                        <InputCn placeholder="0" Value="0" />
                        @if (_settingsOpen)
                        {
                            <InputCn placeholder="0" Value="0" />
                            <InputCn placeholder="0" Value="0" />
                        }
                    </div>
                    <CollapsibleTriggerCn>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon">
                            @if (_settingsOpen)
                            {
                                <LucideMinimizeCn Size="16" />
                            }
                            else
                            {
                                <LucideMaximizeCn Size="16" />
                            }
                        </ButtonCn>
                    </CollapsibleTriggerCn>
                </CollapsibleCn>
            </CardContentCn>
        </CardCn>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div dir="rtl">
            <CollapsibleCn @bind-Open="_rtlOpen" Class="flex w-[350px] flex-col gap-2">
                <div class="flex items-center justify-between gap-4 px-4">
                    <h4 class="text-sm font-semibold">الطلب #4189</h4>
                    <CollapsibleTriggerCn class="inline-flex items-center justify-center rounded-lg text-sm font-medium">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8">
                            <LucideChevronsUpDownCn Size="16" />
                            <span class="sr-only">Toggle details</span>
                        </ButtonCn>
                    </CollapsibleTriggerCn>
                </div>
                <div class="flex items-center justify-between rounded-md border px-4 py-2 text-sm">
                    <span class="text-muted-foreground">الحالة</span>
                    <span class="font-medium">تم الشحن</span>
                </div>
                <CollapsibleContentCn class="flex flex-col gap-2">
                    <div class="rounded-md border px-4 py-2 text-sm">
                        <p class="font-medium">عنوان الشحن</p>
                        <p class="text-muted-foreground">100 Market St, San Francisco</p>
                    </div>
                    <div class="rounded-md border px-4 py-2 text-sm">
                        <p class="font-medium">العناصر</p>
                        <p class="text-muted-foreground">2x سماعات الاستوديو</p>
                    </div>
                </CollapsibleContentCn>
            </CollapsibleCn>
        </div>
    </ComponentPreview>
</div>

