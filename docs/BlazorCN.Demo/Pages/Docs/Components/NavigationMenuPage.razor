        new("منطقة التمرير", "/docs/primitives/scroll-area", "يفصل المحتوى بصريًا أو دلاليًا."),
        new("التبويبات", "/docs/primitives/tabs", "مجموعة من أقسام المحتوى المتعددة الطبقات\u2014المعروفة بألواح التبويب\u2014التي يتم عرضها واحدة في كل مرة."),
        new("تلميح", "/docs/primitives/tooltip", "نافذة منبثقة تعرض معلومات متعلقة بعنصر عندما يتلقى العنصر التركيز على لوحة المفاتيح أو عند تحويم الماوس فوقه."),
