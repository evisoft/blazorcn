        new("Progress", "/docs/primitives/progress", "Displays an indicator showing the completion progress of a task, typically displayed as a progress bar."),
        new("Scroll-area", "/docs/primitives/scroll-area", "Visually or semantically separates content."),
        new("Tabs", "/docs/primitives/tabs", "A set of layered sections of content\u2014known as tab panels\u2014that are displayed one at a time."),
        new("Tooltip", "/docs/primitives/tooltip", "A popup that displays information related to an element when the element receives keyboard focus or the mouse hovers over it."),
