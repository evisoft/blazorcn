@page "/docs/components/navigation-menu"
@layout DocsLayout

<PageTitle>Navigation Menu — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Navigation Menu</h1>
        <p class="mt-2 text-lg text-muted-foreground">A collection of links for navigating websites, with support for expandable sub-menus.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <NavigationMenuCn>
            <NavigationMenuListCn>
                <NavigationMenuItemCn>
                    <NavigationMenuTriggerCn>Getting started</NavigationMenuTriggerCn>
                    <NavigationMenuContentCn>
                        <ul class="w-full sm:w-96">
                            <li>
                                <NavigationMenuLinkCn Href="/docs">
                                    <div class="flex flex-col gap-1 text-sm">
                                        <div class="leading-none font-medium">Introduction</div>
                                        <div class="line-clamp-2 text-muted-foreground">Re-usable components built with Tailwind CSS.</div>
                                    </div>
                                </NavigationMenuLinkCn>
                            </li>
                            <li>
                                <NavigationMenuLinkCn Href="/docs/installation">
                                    <div class="flex flex-col gap-1 text-sm">
                                        <div class="leading-none font-medium">Installation</div>
                                        <div class="line-clamp-2 text-muted-foreground">How to install dependencies and structure your app.</div>
                                    </div>
                                </NavigationMenuLinkCn>
                            </li>
                            <li>
                                <NavigationMenuLinkCn Href="/docs/primitives/typography">
                                    <div class="flex flex-col gap-1 text-sm">
                                        <div class="leading-none font-medium">Typography</div>
                                        <div class="line-clamp-2 text-muted-foreground">Styles for headings, paragraphs, lists...etc</div>
                                    </div>
                                </NavigationMenuLinkCn>
                            </li>
                        </ul>
                    </NavigationMenuContentCn>
                </NavigationMenuItemCn>
                <NavigationMenuItemCn Class="hidden md:flex">
                    <NavigationMenuTriggerCn>Components</NavigationMenuTriggerCn>
                    <NavigationMenuContentCn>
                        <ul class="grid w-[400px] gap-2 md:w-[500px] md:grid-cols-2 lg:w-[600px]">
                            @foreach (var component in _components)
                            {
                                <li>
                                    <NavigationMenuLinkCn Href="@component.Href">
                                        <div class="flex flex-col gap-1 text-sm">
                                            <div class="leading-none font-medium">@component.Title</div>
                                            <div class="line-clamp-2 text-muted-foreground">@component.Description</div>
                                        </div>
                                    </NavigationMenuLinkCn>
                                </li>
                            }
                        </ul>
                    </NavigationMenuContentCn>
                </NavigationMenuItemCn>
                <NavigationMenuItemCn>
                    <NavigationMenuTriggerCn>With Icon</NavigationMenuTriggerCn>
                    <NavigationMenuContentCn>
                        <ul class="grid w-[200px]">
                            <li>
                                <NavigationMenuLinkCn Href="#" Class="flex-row items-center gap-2">
                                    <LucideCircleAlertCn />
                                    Backlog
                                </NavigationMenuLinkCn>
                                <NavigationMenuLinkCn Href="#" Class="flex-row items-center gap-2">
                                    <LucideCircleDashedCn />
                                    To Do
                                </NavigationMenuLinkCn>
                                <NavigationMenuLinkCn Href="#" Class="flex-row items-center gap-2">
                                    <LucideCircleCheckCn />
                                    Done
                                </NavigationMenuLinkCn>
                            </li>
                        </ul>
                    </NavigationMenuContentCn>
                </NavigationMenuItemCn>
                <NavigationMenuItemCn>
                    <NavigationMenuLinkCn Href="/docs" Class="inline-flex h-9 w-max items-center justify-center rounded-md bg-background px-4 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground focus:outline-none disabled:pointer-events-none disabled:opacity-50">Docs</NavigationMenuLinkCn>
                </NavigationMenuItemCn>
            </NavigationMenuListCn>
        </NavigationMenuCn>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div dir="rtl">
            <NavigationMenuCn>
                <NavigationMenuListCn>
                    <NavigationMenuItemCn>
                        <NavigationMenuTriggerCn>البدء</NavigationMenuTriggerCn>
                        <NavigationMenuContentCn>
                            <ul class="w-full sm:w-96">
                                <li>
                                    <NavigationMenuLinkCn Href="/docs">
                                        <div class="flex flex-col gap-1 text-sm">
                                            <div class="leading-none font-medium">مقدمة</div>
                                            <div class="line-clamp-2 text-muted-foreground">مكونات قابلة لإعادة الاستخدام مبنية باستخدام Tailwind CSS.</div>
                                        </div>
                                    </NavigationMenuLinkCn>
                                </li>
                                <li>
                                    <NavigationMenuLinkCn Href="/docs/installation">
                                        <div class="flex flex-col gap-1 text-sm">
                                            <div class="leading-none font-medium">التثبيت</div>
                                            <div class="line-clamp-2 text-muted-foreground">كيفية تثبيت التبعيات وتنظيم تطبيقك.</div>
                                        </div>
                                    </NavigationMenuLinkCn>
                                </li>
                                <li>
                                    <NavigationMenuLinkCn Href="/docs/primitives/typography">
                                        <div class="flex flex-col gap-1 text-sm">
                                            <div class="leading-none font-medium">الطباعة</div>
                                            <div class="line-clamp-2 text-muted-foreground">أنماط للعناوين والفقرات والقوائم...إلخ</div>
                                        </div>
                                    </NavigationMenuLinkCn>
                                </li>
                            </ul>
                        </NavigationMenuContentCn>
                    </NavigationMenuItemCn>
                    <NavigationMenuItemCn Class="hidden md:flex">
                        <NavigationMenuTriggerCn>المكونات</NavigationMenuTriggerCn>
                        <NavigationMenuContentCn>
                            <ul class="grid w-[400px] gap-2 md:w-[500px] md:grid-cols-2 lg:w-[600px]">
                                @foreach (var component in _componentsRtl)
                                {
                                    <li>
                                        <NavigationMenuLinkCn Href="@component.Href">
                                            <div class="flex flex-col gap-1 text-sm">
                                                <div class="leading-none font-medium">@component.Title</div>
                                                <div class="line-clamp-2 text-muted-foreground">@component.Description</div>
                                            </div>
                                        </NavigationMenuLinkCn>
                                    </li>
                                }
                            </ul>
                        </NavigationMenuContentCn>
                    </NavigationMenuItemCn>
                    <NavigationMenuItemCn>
                        <NavigationMenuTriggerCn>مع أيقونة</NavigationMenuTriggerCn>
                        <NavigationMenuContentCn>
                            <ul class="grid w-[200px]">
                                <li>
                                    <NavigationMenuLinkCn Href="#" Class="flex-row items-center gap-2">
                                        <LucideCircleAlertCn />
                                        قائمة الانتظار
                                    </NavigationMenuLinkCn>
                                    <NavigationMenuLinkCn Href="#" Class="flex-row items-center gap-2">
                                        <LucideCircleDashedCn />
                                        المهام
                                    </NavigationMenuLinkCn>
                                    <NavigationMenuLinkCn Href="#" Class="flex-row items-center gap-2">
                                        <LucideCircleCheckCn />
                                        منجز
                                    </NavigationMenuLinkCn>
                                </li>
                            </ul>
                        </NavigationMenuContentCn>
                    </NavigationMenuItemCn>
                    <NavigationMenuItemCn>
                        <NavigationMenuLinkCn Href="/docs" Class="inline-flex h-9 w-max items-center justify-center rounded-md bg-background px-4 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground focus:outline-none disabled:pointer-events-none disabled:opacity-50">الوثائق</NavigationMenuLinkCn>
                    </NavigationMenuItemCn>
                </NavigationMenuListCn>
            </NavigationMenuCn>
        </div>
    </ComponentPreview>
</div>

@code {
