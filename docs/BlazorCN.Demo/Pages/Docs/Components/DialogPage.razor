@page "/docs/components/dialog"
@layout DocsLayout

<PageTitle>Dialog — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Dialog</h1>
        <p class="mt-2 text-lg text-muted-foreground">A window overlaid on either the primary window or another dialog window, rendering the content underneath inert.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <DialogCn>
            <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">Open Dialog</DialogTriggerCn>
            <DialogContentCn Class="sm:max-w-sm">
                <DialogHeaderCn>
                    <DialogTitleCn>Edit profile</DialogTitleCn>
                    <DialogDescriptionCn>
                        Make changes to your profile here. Click save when you're done.
                    </DialogDescriptionCn>
                </DialogHeaderCn>
                <div class="grid gap-4">
                    <div class="grid gap-2">
                        <LabelCn For="name-1">Name</LabelCn>
                        <InputCn id="name-1" Value="Pedro Duarte" />
                    </div>
                    <div class="grid gap-2">
                        <LabelCn For="username-1">Username</LabelCn>
                        <InputCn id="username-1" Value="@("@peduarte")" />
                    </div>
                </div>
                <DialogFooterCn>
                    <DialogCloseCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">Cancel</DialogCloseCn>
                    <ButtonCn>Save changes</ButtonCn>
                </DialogFooterCn>
            </DialogContentCn>
        </DialogCn>
    </ComponentPreview>

    <ComponentPreview Title="Close Button" Code="@CloseButtonCode">
        <DialogCn>
            <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">Share</DialogTriggerCn>
            <DialogContentCn Class="sm:max-w-md">
                <DialogHeaderCn>
                    <DialogTitleCn>Share link</DialogTitleCn>
                    <DialogDescriptionCn>
                        Anyone who has this link will be able to view this.
                    </DialogDescriptionCn>
                </DialogHeaderCn>
                <div class="flex items-center gap-2">
                    <div class="grid flex-1 gap-2">
                        <LabelCn For="link" Class="sr-only">Link</LabelCn>
                        <InputCn id="link" Value="https://ui.shadcn.com/docs/installation" readonly />
                    </div>
                </div>
                <DialogFooterCn Class="sm:justify-start">
                    <DialogCloseCn>
                        <ButtonCn>Close</ButtonCn>
                    </DialogCloseCn>
                </DialogFooterCn>
            </DialogContentCn>
        </DialogCn>
    </ComponentPreview>

    <ComponentPreview Title="No Close Button" Code="@NoCloseButtonCode">
        <DialogCn>
            <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">No Close Button</DialogTriggerCn>
            <DialogContentCn ShowCloseButton="false">
                <DialogHeaderCn>
                    <DialogTitleCn>No Close Button</DialogTitleCn>
                    <DialogDescriptionCn>
                        This dialog doesn't have a close button in the top-right corner.
                    </DialogDescriptionCn>
                </DialogHeaderCn>
            </DialogContentCn>
        </DialogCn>
    </ComponentPreview>

    <ComponentPreview Title="Scrollable Content" Code="@ScrollableCode">
        <DialogCn>
            <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">Scrollable Content</DialogTriggerCn>
            <DialogContentCn>
                <DialogHeaderCn>
                    <DialogTitleCn>Scrollable Content</DialogTitleCn>
                    <DialogDescriptionCn>
                        This is a dialog with scrollable content.
                    </DialogDescriptionCn>
                </DialogHeaderCn>
                <div class="-mx-4 no-scrollbar max-h-[50vh] overflow-y-auto px-4">
                    @for (var i = 0; i < 10; i++)
                    {
                        <p class="mb-4 leading-normal">
                            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do
                            eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut
                            enim ad minim veniam, quis nostrud exercitation ullamco laboris
                            nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in
                            reprehenderit in voluptate velit esse cillum dolore eu fugiat
                            nulla pariatur. Excepteur sint occaecat cupidatat non proident,
                            sunt in culpa qui officia deserunt mollit anim id est laborum.
                        </p>
                    }
                </div>
            </DialogContentCn>
        </DialogCn>
    </ComponentPreview>

    <ComponentPreview Title="Sticky Footer" Code="@StickyFooterCode">
        <DialogCn>
            <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">Sticky Footer</DialogTriggerCn>
            <DialogContentCn>
                <DialogHeaderCn>
                    <DialogTitleCn>Sticky Footer</DialogTitleCn>
                    <DialogDescriptionCn>
                        This dialog has a sticky footer that stays visible while the content scrolls.
                    </DialogDescriptionCn>
                </DialogHeaderCn>
                <div class="-mx-4 no-scrollbar max-h-[50vh] overflow-y-auto px-4">
                    @for (var i = 0; i < 10; i++)
                    {
                        <p class="mb-4 leading-normal">
                            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do
                            eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut
                            enim ad minim veniam, quis nostrud exercitation ullamco laboris
                            nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in
                            reprehenderit in voluptate velit esse cillum dolore eu fugiat
                            nulla pariatur. Excepteur sint occaecat cupidatat non proident,
                            sunt in culpa qui officia deserunt mollit anim id est laborum.
                        </p>
                    }
                </div>
                <DialogFooterCn>
                    <DialogCloseCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">Close</DialogCloseCn>
                </DialogFooterCn>
            </DialogContentCn>
        </DialogCn>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <DialogCn>
            <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">فتح الحوار</DialogTriggerCn>
            <DialogContentCn Class="sm:max-w-sm" dir="rtl">
                <DialogHeaderCn>
                    <DialogTitleCn>تعديل الملف الشخصي</DialogTitleCn>
                    <DialogDescriptionCn>
                        قم بإجراء تغييرات على ملفك الشخصي هنا. انقر فوق حفظ عند الانتهاء.
                    </DialogDescriptionCn>
                </DialogHeaderCn>
                <div class="grid gap-4">
                    <div class="grid gap-2">
                        <LabelCn For="name-rtl">الاسم</LabelCn>
                        <InputCn id="name-rtl" Value="Pedro Duarte" />
                    </div>
                    <div class="grid gap-2">
                        <LabelCn For="username-rtl">اسم المستخدم</LabelCn>
                        <InputCn id="username-rtl" Value="@("@peduarte")" />
                    </div>
                </div>
                <DialogFooterCn>
                    <DialogCloseCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">إلغاء</DialogCloseCn>
                    <ButtonCn>حفظ التغييرات</ButtonCn>
                </DialogFooterCn>
            </DialogContentCn>
        </DialogCn>
    </ComponentPreview>
</div>

