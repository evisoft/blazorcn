                        </ButtonCn>
                    </div>
                </div>
                <DrawerFooterCn>
                    <ButtonCn>إرسال</ButtonCn>
                    <DrawerCloseCn>
                        <ButtonCn Variant=""ButtonVariant.Outline"">إلغاء</ButtonCn>
                    </DrawerCloseCn>
                </DrawerFooterCn>
            </div>
        </DrawerContentCn>
    </DrawerCn>
</div>";
}
