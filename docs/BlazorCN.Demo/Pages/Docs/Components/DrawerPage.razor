@page "/docs/components/drawer"
@layout DocsLayout

<PageTitle>Drawer — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Drawer</h1>
        <p class="mt-2 text-lg text-muted-foreground">A panel that slides in from the edge of the screen.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Default" Code="@DefaultCode">
        <DrawerCn @bind-Open="_defaultOpen">
            <DrawerTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">Open Drawer</DrawerTriggerCn>
            <DrawerOverlayCn />
            <DrawerContentCn>
                <div class="mx-auto w-full max-w-sm">
                    <DrawerHeaderCn>
                        <DrawerTitleCn>Move Goal</DrawerTitleCn>
                        <DrawerDescriptionCn>Set your daily activity goal.</DrawerDescriptionCn>
                    </DrawerHeaderCn>
                    <div class="p-4 pb-0">
                        <div class="flex items-center justify-center space-x-2">
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="h-8 w-8 shrink-0 rounded-full" OnClick="() => AdjustGoal(-10)" disabled="@(_goal <= 200)">
                                <LucideMinusCn />
                                <span class="sr-only">Decrease</span>
                            </ButtonCn>
                            <div class="flex-1 text-center">
                                <div class="text-7xl font-bold tracking-tighter">@_goal</div>
                                <div class="text-[0.70rem] text-muted-foreground uppercase">Calories/day</div>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="h-8 w-8 shrink-0 rounded-full" OnClick="() => AdjustGoal(10)" disabled="@(_goal >= 400)">
                                <LucidePlusCn />
                                <span class="sr-only">Increase</span>
                            </ButtonCn>
                        </div>
                        <div class="mt-3 flex h-[120px] items-end gap-1">
                            @foreach (var value in _chartData)
                            {
                                <div class="flex-1 rounded-t" style="height: @(value * 100 / 400)%; background-color: var(--chart-1);"></div>
                            }
                        </div>
                    </div>
                    <DrawerFooterCn>
                        <ButtonCn>Submit</ButtonCn>
                        <DrawerCloseCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">Cancel</DrawerCloseCn>
                    </DrawerFooterCn>
                </div>
            </DrawerContentCn>
        </DrawerCn>
    </ComponentPreview>

    <ComponentPreview Title="Responsive Dialog + Drawer" Code="@DialogCode">
        <DrawerCn @bind-Open="_dialogOpen">
            <DrawerTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">Edit Profile</DrawerTriggerCn>
            <DrawerOverlayCn />
            <DrawerContentCn>
                <DrawerHeaderCn Class="text-left">
                    <DrawerTitleCn>Edit profile</DrawerTitleCn>
                    <DrawerDescriptionCn>Make changes to your profile here. Click save when you're done.</DrawerDescriptionCn>
                </DrawerHeaderCn>
                <form class="grid items-start gap-6 px-4">
                    <div class="grid gap-3">
                        <LabelCn For="email">Email</LabelCn>
                        <InputCn Type="email" id="email" Value="shadcn@example.com" />
                    </div>
                    <div class="grid gap-3">
                        <LabelCn For="username">Username</LabelCn>
                        <InputCn id="username" Value="@("@shadcn")" />
                    </div>
                    <ButtonCn>Save changes</ButtonCn>
                </form>
                <DrawerFooterCn Class="pt-2">
                    <DrawerCloseCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">Cancel</DrawerCloseCn>
                </DrawerFooterCn>
            </DrawerContentCn>
        </DrawerCn>
    </ComponentPreview>

    <ComponentPreview Title="Scrollable Content" Code="@ScrollableCode">
        <DrawerCn @bind-Open="_scrollableOpen">
            <DrawerTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">Scrollable Content</DrawerTriggerCn>
            <DrawerOverlayCn />
            <DrawerContentCn Direction="DrawerDirection.Right">
                <DrawerHeaderCn>
                    <DrawerTitleCn>Move Goal</DrawerTitleCn>
                    <DrawerDescriptionCn>Set your daily activity goal.</DrawerDescriptionCn>
                </DrawerHeaderCn>
                <div class="no-scrollbar overflow-y-auto px-4">
                    @for (var i = 0; i < 10; i++)
                    {
                        <p class="mb-4 leading-normal">
                            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.
                        </p>
                    }
                </div>
                <DrawerFooterCn>
                    <ButtonCn>Submit</ButtonCn>
                    <DrawerCloseCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">Cancel</DrawerCloseCn>
                </DrawerFooterCn>
            </DrawerContentCn>
        </DrawerCn>
    </ComponentPreview>

    <ComponentPreview Title="Sides" Code="@SidesCode">
        <div class="flex flex-wrap gap-2">
            @foreach (var direction in _directions)
            {
                <DrawerCn @bind-Open="_directionOpen[direction]">
                    <DrawerTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default capitalize" data-variant="outline" data-size="default">@direction.ToString()</DrawerTriggerCn>
                    <DrawerOverlayCn />
                    <DrawerContentCn Direction="direction" Class="@(direction is DrawerDirection.Bottom or DrawerDirection.Top ? "max-h-[50vh]" : "")">
                        <DrawerHeaderCn>
                            <DrawerTitleCn>Move Goal</DrawerTitleCn>
                            <DrawerDescriptionCn>Set your daily activity goal.</DrawerDescriptionCn>
                        </DrawerHeaderCn>
                        <div class="no-scrollbar overflow-y-auto px-4">
                            @for (var i = 0; i < 10; i++)
                            {
                                <p class="mb-4 leading-normal">
                                    Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.
                                </p>
                            }
                        </div>
                        <DrawerFooterCn>
                            <ButtonCn>Submit</ButtonCn>
                            <DrawerCloseCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">Cancel</DrawerCloseCn>
                        </DrawerFooterCn>
                    </DrawerContentCn>
                </DrawerCn>
            }
        </div>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div dir="rtl">
            <DrawerCn @bind-Open="_rtlOpen">
                <DrawerTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">&#x641;&#x62A;&#x62D; &#x627;&#x644;&#x62F;&#x631;&#x62C;</DrawerTriggerCn>
                <DrawerOverlayCn />
                <DrawerContentCn>
                    <div class="mx-auto w-full max-w-sm">
                        <DrawerHeaderCn>
                            <DrawerTitleCn>&#x646;&#x642;&#x644; &#x627;&#x644;&#x647;&#x62F;&#x641;</DrawerTitleCn>
                            <DrawerDescriptionCn>&#x62D;&#x62F;&#x62F; &#x647;&#x62F;&#x641; &#x646;&#x634;&#x627;&#x637;&#x643; &#x627;&#x644;&#x64A;&#x648;&#x645;&#x64A;.</DrawerDescriptionCn>
                        </DrawerHeaderCn>
                        <div class="p-4 pb-0">
                            <div class="flex items-center justify-center space-x-2">
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="h-8 w-8 shrink-0 rounded-full" OnClick="() => AdjustRtlGoal(-10)" disabled="@(_rtlGoal <= 200)">
                                    <LucideMinusCn />
                                    <span class="sr-only">&#x62A;&#x642;&#x644;&#x64A;&#x644;</span>
                                </ButtonCn>
                                <div class="flex-1 text-center">
                                    <div class="text-7xl font-bold tracking-tighter">@_rtlGoal</div>
                                    <div class="text-[0.70rem] text-muted-foreground uppercase">&#x633;&#x639;&#x631;&#x627;&#x62A; &#x62D;&#x631;&#x627;&#x631;&#x64A;&#x629;/&#x64A;&#x648;&#x645;</div>
                                </div>
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="h-8 w-8 shrink-0 rounded-full" OnClick="() => AdjustRtlGoal(10)" disabled="@(_rtlGoal >= 400)">
                                    <LucidePlusCn />
                                    <span class="sr-only">&#x632;&#x64A;&#x627;&#x62F;&#x629;</span>
                                </ButtonCn>
                            </div>
                            <div class="mt-3 flex h-[120px] items-end gap-1">
                                @foreach (var value in _chartData)
                                {
                                    <div class="flex-1 rounded-t" style="height: @(value * 100 / 400)%; background-color: var(--chart-2);"></div>
                                }
                            </div>
                        </div>
                        <DrawerFooterCn>
                            <ButtonCn>&#x625;&#x631;&#x633;&#x627;&#x644;</ButtonCn>
                            <DrawerCloseCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">&#x625;&#x644;&#x63A;&#x627;&#x621;</DrawerCloseCn>
                        </DrawerFooterCn>
                    </div>
                </DrawerContentCn>
            </DrawerCn>
        </div>
    </ComponentPreview>
</div>

@code {
    private bool _defaultOpen;
    private bool _dialogOpen;
    private bool _scrollableOpen;
    private bool _rtlOpen;
    private int _goal = 350;
    private int _rtlGoal = 350;

    private readonly int[] _chartData = [400, 300, 200, 300, 200, 278, 189, 239, 300, 200, 278, 189, 349];

    private readonly DrawerDirection[] _directions = [DrawerDirection.Top, DrawerDirection.Right, DrawerDirection.Bottom, DrawerDirection.Left];
    private readonly Dictionary<DrawerDirection, bool> _directionOpen = new()
    {
        [DrawerDirection.Top] = false,
        [DrawerDirection.Right] = false,
        [DrawerDirection.Bottom] = false,
        [DrawerDirection.Left] = false,
    };

    private void AdjustGoal(int adjustment)
    {
        _goal = Math.Max(200, Math.Min(400, _goal + adjustment));
    }

    private void AdjustRtlGoal(int adjustment)
    {
        _rtlGoal = Math.Max(200, Math.Min(400, _rtlGoal + adjustment));
    }

    private const string DefaultCode = @"<DrawerCn @bind-Open=""_open"">
