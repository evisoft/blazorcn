@page "/docs/components/form"
@layout DocsLayout

<PageTitle>Form — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Form</h1>
        <p class="mt-2 text-lg text-muted-foreground">Building forms with structured field layouts, labels, descriptions, and validation messages.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Default" Code="@DefaultCode">
        <div class="max-w-sm">
            <FormFieldCn>
                <FormLabelCn>Username</FormLabelCn>
                <FormControlCn>
                    <InputCn id="@context.FormItemId"
                             aria-describedby="@context.AriaDescribedBy"
                             Placeholder="Enter your username" />
                </FormControlCn>
                <FormDescriptionCn>This is your public display name.</FormDescriptionCn>
            </FormFieldCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="With Validation Message" Code="@ValidationCode">
        <div class="max-w-sm space-y-4">
            <FormFieldCn HasError="true">
                <FormLabelCn>Email</FormLabelCn>
                <FormControlCn>
                    <InputCn id="@context.FormItemId"
                             aria-describedby="@context.AriaDescribedBy"
                             aria-invalid="@(context.HasError ? "true" : null)"
                             Placeholder="Enter your email" />
                </FormControlCn>
                <FormDescriptionCn>We'll never share your email.</FormDescriptionCn>
                <FormMessageCn>Please enter a valid email address.</FormMessageCn>
            </FormFieldCn>
            <FormFieldCn>
                <FormLabelCn>Password</FormLabelCn>
                <FormControlCn>
                    <InputCn id="@context.FormItemId"
                             aria-describedby="@context.AriaDescribedBy"
                             Type="password" Placeholder="Enter your password" />
                </FormControlCn>
                <FormDescriptionCn>Must be at least 8 characters.</FormDescriptionCn>
            </FormFieldCn>
            <ButtonCn>Submit</ButtonCn>
        </div>
    </ComponentPreview>
</div>

@code {
    private const string DefaultCode = @"<FormFieldCn>
    <FormLabelCn>Username</FormLabelCn>
    <FormControlCn>
        <InputCn id=""@context.FormItemId""
                 aria-describedby=""@context.AriaDescribedBy""
                 Placeholder=""Enter your username"" />
    </FormControlCn>
    <FormDescriptionCn>This is your public display name.</FormDescriptionCn>
</FormFieldCn>";
    private const string ValidationCode = @"<FormFieldCn HasError=""true"">
    <FormLabelCn>Email</FormLabelCn>
    <FormControlCn>
        <InputCn id=""@context.FormItemId""
                 aria-describedby=""@context.AriaDescribedBy""
                 aria-invalid=""@(context.HasError ? ""true"" : null)""
                 Placeholder=""Enter your email"" />
    </FormControlCn>
    <FormDescriptionCn>We'll never share your email.</FormDescriptionCn>
    <FormMessageCn>Please enter a valid email address.</FormMessageCn>
</FormFieldCn>
<FormFieldCn>
    <FormLabelCn>Password</FormLabelCn>
    <FormControlCn>
        <InputCn id=""@context.FormItemId""
                 aria-describedby=""@context.AriaDescribedBy""
                 Type=""password"" Placeholder=""Enter your password"" />
    </FormControlCn>
    <FormDescriptionCn>Must be at least 8 characters.</FormDescriptionCn>
</FormFieldCn>
<ButtonCn>Submit</ButtonCn>";
}
