@page "/docs/components/scroll-area"
@layout DocsLayout

<PageTitle>Scroll Area — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Scroll Area</h1>
        <p class="mt-2 text-lg text-muted-foreground">Augments native scroll functionality for custom, cross-browser styling.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <ScrollAreaCn Class="h-72 w-48 rounded-md border" Orientation="ScrollOrientation.Vertical">
            <div class="p-4">
                <h3 class="mb-4 text-sm leading-none font-medium">Tags</h3>
                @foreach (var tag in _tags)
                {
                    <div class="text-sm">@tag</div>
                    <SeparatorCn Class="my-2" />
                }
            </div>
        </ScrollAreaCn>
    </ComponentPreview>

    <ComponentPreview Title="Horizontal" Code="@HorizontalCode">
        <ScrollAreaCn Class="w-96 rounded-md border whitespace-nowrap" Orientation="ScrollOrientation.Horizontal">
            <div class="flex w-max space-x-4 p-4">
                @foreach (var artwork in _works)
                {
                    <figure class="shrink-0">
                        <div class="overflow-hidden rounded-md">
                            <img src="@artwork.Art" alt="Photo by @artwork.Artist" class="aspect-[3/4] h-fit w-fit object-cover" width="300" height="400" />
                        </div>
                        <figcaption class="pt-2 text-xs text-muted-foreground">
                            Photo by <span class="font-semibold text-foreground">@artwork.Artist</span>
                        </figcaption>
                    </figure>
                }
            </div>
        </ScrollAreaCn>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <ScrollAreaCn Class="h-72 w-48 rounded-md border" Orientation="ScrollOrientation.Vertical" dir="rtl">
            <div class="p-4">
                <h3 class="mb-4 text-sm leading-none font-medium">العلامات</h3>
                @foreach (var tag in _tags)
                {
                    <div class="text-sm">@tag</div>
                    <SeparatorCn Class="my-2" />
                }
            </div>
        </ScrollAreaCn>
    </ComponentPreview>
</div>

@code {
    private static readonly string[] _tags = Enumerable.Range(1, 50)
        .Select(i => $"v1.2.0-beta.{50 - i + 1}")
        .ToArray();

    private record Artwork(string Artist, string Art);

    private static readonly Artwork[] _works =
    [
        new("Ornella Binni", "https://images.unsplash.com/photo-1465869185982-5a1a7522cbcb?auto=format&fit=crop&w=300&q=80"),
        new("Tom Byrom", "https://images.unsplash.com/photo-1548516173-3cabfa4607e9?auto=format&fit=crop&w=300&q=80"),
        new("Vladimir Malyavko", "https://images.unsplash.com/photo-1494337480532-3725c85fd2ab?auto=format&fit=crop&w=300&q=80"),
    ];

    private const string DemoCode = @"<ScrollAreaCn Class=""h-72 w-48 rounded-md border"" Orientation=""ScrollOrientation.Vertical"">
    <div class=""p-4"">
        <h3 class=""mb-4 text-sm leading-none font-medium"">Tags</h3>
        @foreach (var tag in tags)
        {
            <div class=""text-sm"">@tag</div>
            <SeparatorCn Class=""my-2"" />
        }
    </div>
</ScrollAreaCn>";

    private const string HorizontalCode = @"<ScrollAreaCn Class=""w-96 rounded-md border whitespace-nowrap"" Orientation=""ScrollOrientation.Horizontal"">
    <div class=""flex w-max space-x-4 p-4"">
        @foreach (var artwork in works)
        {
            <figure class=""shrink-0"">
                <div class=""overflow-hidden rounded-md"">
                    <img src=""@artwork.Art"" alt=""Photo by @artwork.Artist"" class=""aspect-[3/4] h-fit w-fit object-cover"" width=""300"" height=""400"" />
                </div>
                <figcaption class=""pt-2 text-xs text-muted-foreground"">
                    Photo by <span class=""font-semibold text-foreground"">@artwork.Artist</span>
                </figcaption>
            </figure>
        }
    </div>
</ScrollAreaCn>";

    private const string RtlCode = @"<ScrollAreaCn Class=""h-72 w-48 rounded-md border"" Orientation=""ScrollOrientation.Vertical"" dir=""rtl"">
    <div class=""p-4"">
        <h3 class=""mb-4 text-sm leading-none font-medium"">العلامات</h3>
        @foreach (var tag in tags)
        {
            <div class=""text-sm"">@tag</div>
            <SeparatorCn Class=""my-2"" />
        }
    </div>
</ScrollAreaCn>";
}
