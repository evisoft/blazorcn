@page "/docs/components/breadcrumb"
@layout DocsLayout

<PageTitle>Breadcrumb — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Breadcrumb</h1>
        <p class="mt-2 text-lg text-muted-foreground">Displays the path to the current resource using a hierarchy of links.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <BreadcrumbCn>
            <BreadcrumbListCn>
                <BreadcrumbItemCn>
                    <BreadcrumbLinkCn Href="#">Home</BreadcrumbLinkCn>
                </BreadcrumbItemCn>
                <BreadcrumbSeparatorCn />
                <BreadcrumbItemCn>
                    <DropdownMenuCn>
                        <DropdownMenuTriggerCn>
                            <ButtonCn Size="ButtonSize.IconSm" Variant="ButtonVariant.Ghost">
                                <BreadcrumbEllipsisCn />
                                <span class="sr-only">Toggle menu</span>
                            </ButtonCn>
                        </DropdownMenuTriggerCn>
                        <DropdownMenuContentCn Align="FloatingAlign.Start">
                            <DropdownMenuGroupCn>
                                <DropdownMenuItemCn>Documentation</DropdownMenuItemCn>
                                <DropdownMenuItemCn>Themes</DropdownMenuItemCn>
                                <DropdownMenuItemCn>GitHub</DropdownMenuItemCn>
                            </DropdownMenuGroupCn>
                        </DropdownMenuContentCn>
                    </DropdownMenuCn>
                </BreadcrumbItemCn>
                <BreadcrumbSeparatorCn />
                <BreadcrumbItemCn>
                    <BreadcrumbLinkCn Href="#">Components</BreadcrumbLinkCn>
                </BreadcrumbItemCn>
                <BreadcrumbSeparatorCn />
                <BreadcrumbItemCn>
                    <BreadcrumbPageCn>Breadcrumb</BreadcrumbPageCn>
                </BreadcrumbItemCn>
            </BreadcrumbListCn>
        </BreadcrumbCn>
    </ComponentPreview>

