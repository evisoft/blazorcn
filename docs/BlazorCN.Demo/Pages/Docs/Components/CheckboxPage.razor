@page "/docs/components/checkbox"
@layout DocsLayout

<PageTitle>Checkbox — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Checkbox</h1>
        <p class="mt-2 text-lg text-muted-foreground">A control that allows the user to toggle between checked and not checked.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <div class="flex w-full flex-col gap-5 max-w-sm">
            <FieldCn Orientation="FieldOrientation.Horizontal">
                <CheckboxCn id="terms-checkbox" @bind-Checked="_demoTerms" />
                <FieldLabelCn For="terms-checkbox">Accept terms and conditions</FieldLabelCn>
            </FieldCn>
            <FieldCn Orientation="FieldOrientation.Horizontal">
                <CheckboxCn id="terms-checkbox-2" @bind-Checked="_demoTerms2" />
                <FieldContentCn>
                    <FieldLabelCn For="terms-checkbox-2">Accept terms and conditions</FieldLabelCn>
                    <FieldDescriptionCn>By clicking this checkbox, you agree to the terms.</FieldDescriptionCn>
                </FieldContentCn>
            </FieldCn>
            <FieldCn Orientation="FieldOrientation.Horizontal" data-disabled="true">
                <CheckboxCn id="toggle-checkbox" Disabled="true" />
                <FieldLabelCn For="toggle-checkbox">Enable notifications</FieldLabelCn>
            </FieldCn>
            <label class="flex w-fit gap-2 leading-snug w-full flex-col rounded-lg border has-[:checked]:border-primary/30 has-[:checked]:bg-primary/5 dark:has-[:checked]:border-primary/20 dark:has-[:checked]:bg-primary/10">
                <FieldCn Orientation="FieldOrientation.Horizontal" Class="p-2.5">
                    <CheckboxCn id="toggle-checkbox-2" @bind-Checked="_demoNotify" />
                    <FieldContentCn>
                        <FieldTitleCn>Enable notifications</FieldTitleCn>
                        <FieldDescriptionCn>You can enable or disable notifications at any time.</FieldDescriptionCn>
                    </FieldContentCn>
                </FieldCn>
            </label>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Basic" Code="@BasicCode">
        <div class="mx-auto w-56">
            <FieldCn Orientation="FieldOrientation.Horizontal">
                <CheckboxCn id="terms-checkbox-basic" @bind-Checked="_basic" />
                <FieldLabelCn For="terms-checkbox-basic">Accept terms and conditions</FieldLabelCn>
            </FieldCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Group" Code="@GroupCode">
        <FieldSetCn>
            <FieldLegendCn Variant="FieldLegendVariant.Label">Show these items on the desktop:</FieldLegendCn>
            <FieldDescriptionCn>Select the items you want to show on the desktop.</FieldDescriptionCn>
            <div class="flex w-full flex-col gap-3">
                <FieldCn Orientation="FieldOrientation.Horizontal">
                    <CheckboxCn id="hard-disks-checkbox" @bind-Checked="_hardDisks" />
                    <FieldLabelCn For="hard-disks-checkbox" Class="font-normal">Hard disks</FieldLabelCn>
                </FieldCn>
                <FieldCn Orientation="FieldOrientation.Horizontal">
                    <CheckboxCn id="external-disks-checkbox" @bind-Checked="_externalDisks" />
                    <FieldLabelCn For="external-disks-checkbox" Class="font-normal">External disks</FieldLabelCn>
                </FieldCn>
                <FieldCn Orientation="FieldOrientation.Horizontal">
                    <CheckboxCn id="cds-dvds-checkbox" @bind-Checked="_cdsDvds" />
                    <FieldLabelCn For="cds-dvds-checkbox" Class="font-normal">CDs, DVDs, and iPods</FieldLabelCn>
                </FieldCn>
                <FieldCn Orientation="FieldOrientation.Horizontal">
                    <CheckboxCn id="connected-servers-checkbox" @bind-Checked="_connectedServers" />
                    <FieldLabelCn For="connected-servers-checkbox" Class="font-normal">Connected servers</FieldLabelCn>
                </FieldCn>
            </div>
        </FieldSetCn>
    </ComponentPreview>

    <ComponentPreview Title="With Description" Code="@DescriptionCode">
        <div class="mx-auto w-72">
            <FieldCn Orientation="FieldOrientation.Horizontal">
                <CheckboxCn id="terms-checkbox-desc" @bind-Checked="_desc" />
                <FieldContentCn>
                    <FieldLabelCn For="terms-checkbox-desc">Accept terms and conditions</FieldLabelCn>
                    <FieldDescriptionCn>By clicking this checkbox, you agree to the terms and conditions.</FieldDescriptionCn>
                </FieldContentCn>
            </FieldCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Disabled" Code="@DisabledCode">
        <div class="mx-auto w-56">
            <FieldCn Orientation="FieldOrientation.Horizontal" data-disabled="true">
                <CheckboxCn id="toggle-checkbox-disabled" Disabled="true" />
                <FieldLabelCn For="toggle-checkbox-disabled">Enable notifications</FieldLabelCn>
            </FieldCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Invalid" Code="@InvalidCode">
        <div class="mx-auto w-56">
            <FieldCn Orientation="FieldOrientation.Horizontal" data-invalid="true">
                <CheckboxCn id="terms-checkbox-invalid" @bind-Checked="_invalid" aria-invalid="true" />
                <FieldLabelCn For="terms-checkbox-invalid">Accept terms and conditions</FieldLabelCn>
            </FieldCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Table" Code="@TableCode">
        <TableCn>
            <TableHeaderCn>
                <TableRowCn>
                    <TableHeadCn Class="w-8">
                        <CheckboxCn id="select-all-checkbox" Checked="_selectAll" CheckedChanged="HandleSelectAll" />
                    </TableHeadCn>
                    <TableHeadCn>Name</TableHeadCn>
                    <TableHeadCn>Email</TableHeadCn>
                    <TableHeadCn>Role</TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var row in _tableData)
                {
                    <TableRowCn data-state="@(_selectedRows.Contains(row.Id) ? "selected" : null)">
                        <TableCellCn>
                            <CheckboxCn id="@($"row-{row.Id}-checkbox")"
                                        Checked="_selectedRows.Contains(row.Id)"
                                        CheckedChanged="@(c => HandleSelectRow(row.Id, c))" />
                        </TableCellCn>
                        <TableCellCn Class="font-medium">@row.Name</TableCellCn>
                        <TableCellCn>@row.Email</TableCellCn>
                        <TableCellCn>@row.Role</TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div class="flex w-full flex-col gap-5 max-w-sm" dir="rtl">
            <FieldCn Orientation="FieldOrientation.Horizontal">
                <CheckboxCn id="terms-checkbox-rtl" @bind-Checked="_rtlTerms" />
                <FieldLabelCn For="terms-checkbox-rtl">قبول الشروط والأحكام</FieldLabelCn>
            </FieldCn>
            <FieldCn Orientation="FieldOrientation.Horizontal">
                <CheckboxCn id="terms-checkbox-2-rtl" @bind-Checked="_rtlTerms2" />
                <FieldContentCn>
                    <FieldLabelCn For="terms-checkbox-2-rtl">قبول الشروط والأحكام</FieldLabelCn>
                    <FieldDescriptionCn>بالنقر على هذا المربع، فإنك توافق على الشروط.</FieldDescriptionCn>
                </FieldContentCn>
            </FieldCn>
            <FieldCn Orientation="FieldOrientation.Horizontal" data-disabled="true">
                <CheckboxCn id="toggle-checkbox-rtl" Disabled="true" />
                <FieldLabelCn For="toggle-checkbox-rtl">تفعيل الإشعارات</FieldLabelCn>
            </FieldCn>
            <label class="flex w-fit gap-2 leading-snug w-full flex-col rounded-lg border has-[:checked]:border-primary/30 has-[:checked]:bg-primary/5 dark:has-[:checked]:border-primary/20 dark:has-[:checked]:bg-primary/10">
                <FieldCn Orientation="FieldOrientation.Horizontal" Class="p-2.5">
                    <CheckboxCn id="toggle-checkbox-2-rtl" @bind-Checked="_rtlNotify" />
                    <FieldContentCn>
                        <FieldTitleCn>تفعيل الإشعارات</FieldTitleCn>
                        <FieldDescriptionCn>يمكنك تفعيل أو إلغاء تفعيل الإشعارات في أي وقت.</FieldDescriptionCn>
                    </FieldContentCn>
                </FieldCn>
            </label>
        </div>
    </ComponentPreview>
</div>

@code {
    private bool _demoTerms;
    private bool _demoTerms2 = true;
    private bool _demoNotify;
    private bool _basic;
    private bool _hardDisks = true;
    private bool _externalDisks = true;
    private bool _cdsDvds;
    private bool _connectedServers;
    private bool _desc = true;
    private bool _invalid;
    private bool _rtlTerms;
    private bool _rtlTerms2 = true;
    private bool _rtlNotify;

    private bool _selectAll => _selectedRows.Count == _tableData.Length;
    private HashSet<string> _selectedRows = new() { "1" };

    private record TableRow(string Id, string Name, string Email, string Role);
    private static readonly TableRow[] _tableData =
    [
        new("1", "Sarah Chen", "sarah.chen@example.com", "Admin"),
        new("2", "Marcus Rodriguez", "marcus.rodriguez@example.com", "User"),
        new("3", "Priya Patel", "priya.patel@example.com", "User"),
        new("4", "David Kim", "david.kim@example.com", "Editor"),
    ];

    private void HandleSelectAll(bool @checked)
    {
        if (@checked)
            _selectedRows = new HashSet<string>(_tableData.Select(r => r.Id));
        else
            _selectedRows = new HashSet<string>();
    }

    private void HandleSelectRow(string id, bool @checked)
    {
        if (@checked)
            _selectedRows.Add(id);
        else
            _selectedRows.Remove(id);
    }

    private const string DemoCode = @"<div class=""flex w-full flex-col gap-5 max-w-sm"">
    <FieldCn Orientation=""FieldOrientation.Horizontal"">
        <CheckboxCn id=""terms-checkbox"" @bind-Checked=""_terms"" />
        <FieldLabelCn For=""terms-checkbox"">Accept terms and conditions</FieldLabelCn>
    </FieldCn>
    <FieldCn Orientation=""FieldOrientation.Horizontal"">
        <CheckboxCn id=""terms-checkbox-2"" @bind-Checked=""_terms2"" />
        <FieldContentCn>
            <FieldLabelCn For=""terms-checkbox-2"">Accept terms and conditions</FieldLabelCn>
            <FieldDescriptionCn>By clicking this checkbox, you agree to the terms.</FieldDescriptionCn>
        </FieldContentCn>
    </FieldCn>
    <FieldCn Orientation=""FieldOrientation.Horizontal"" data-disabled=""true"">
        <CheckboxCn id=""toggle-checkbox"" Disabled=""true"" />
        <FieldLabelCn For=""toggle-checkbox"">Enable notifications</FieldLabelCn>
    </FieldCn>
    <label class=""flex w-fit gap-2 leading-snug w-full flex-col rounded-lg border has-[:checked]:border-primary/30 has-[:checked]:bg-primary/5"">
        <FieldCn Orientation=""FieldOrientation.Horizontal"" Class=""p-2.5"">
            <CheckboxCn id=""toggle-checkbox-2"" @bind-Checked=""_notify"" />
            <FieldContentCn>
                <FieldTitleCn>Enable notifications</FieldTitleCn>
                <FieldDescriptionCn>You can enable or disable notifications at any time.</FieldDescriptionCn>
            </FieldContentCn>
        </FieldCn>
    </label>
</div>";

    private const string BasicCode = @"<FieldCn Orientation=""FieldOrientation.Horizontal"">
    <CheckboxCn id=""terms-checkbox-basic"" @bind-Checked=""_checked"" />
    <FieldLabelCn For=""terms-checkbox-basic"">Accept terms and conditions</FieldLabelCn>
</FieldCn>";

    private const string GroupCode = @"<FieldSetCn>
    <FieldLegendCn Variant=""FieldLegendVariant.Label"">Show these items on the desktop:</FieldLegendCn>
    <FieldDescriptionCn>Select the items you want to show on the desktop.</FieldDescriptionCn>
    <div class=""flex w-full flex-col gap-3"">
        <FieldCn Orientation=""FieldOrientation.Horizontal"">
            <CheckboxCn id=""hard-disks"" @bind-Checked=""_hardDisks"" />
            <FieldLabelCn For=""hard-disks"" Class=""font-normal"">Hard disks</FieldLabelCn>
        </FieldCn>
        <FieldCn Orientation=""FieldOrientation.Horizontal"">
            <CheckboxCn id=""external-disks"" @bind-Checked=""_externalDisks"" />
            <FieldLabelCn For=""external-disks"" Class=""font-normal"">External disks</FieldLabelCn>
        </FieldCn>
        <FieldCn Orientation=""FieldOrientation.Horizontal"">
            <CheckboxCn id=""cds-dvds"" @bind-Checked=""_cdsDvds"" />
            <FieldLabelCn For=""cds-dvds"" Class=""font-normal"">CDs, DVDs, and iPods</FieldLabelCn>
        </FieldCn>
        <FieldCn Orientation=""FieldOrientation.Horizontal"">
            <CheckboxCn id=""connected-servers"" @bind-Checked=""_connectedServers"" />
            <FieldLabelCn For=""connected-servers"" Class=""font-normal"">Connected servers</FieldLabelCn>
        </FieldCn>
    </div>
</FieldSetCn>";

    private const string DescriptionCode = @"<FieldCn Orientation=""FieldOrientation.Horizontal"">
    <CheckboxCn id=""terms-checkbox-desc"" @bind-Checked=""_checked"" />
    <FieldContentCn>
        <FieldLabelCn For=""terms-checkbox-desc"">Accept terms and conditions</FieldLabelCn>
        <FieldDescriptionCn>By clicking this checkbox, you agree to the terms and conditions.</FieldDescriptionCn>
    </FieldContentCn>
</FieldCn>";

    private const string DisabledCode = @"<FieldCn Orientation=""FieldOrientation.Horizontal"" data-disabled=""true"">
    <CheckboxCn id=""toggle-checkbox-disabled"" Disabled=""true"" />
    <FieldLabelCn For=""toggle-checkbox-disabled"">Enable notifications</FieldLabelCn>
</FieldCn>";

    private const string InvalidCode = @"<FieldCn Orientation=""FieldOrientation.Horizontal"" data-invalid=""true"">
    <CheckboxCn id=""terms-checkbox-invalid"" @bind-Checked=""_invalid"" aria-invalid=""true"" />
    <FieldLabelCn For=""terms-checkbox-invalid"">Accept terms and conditions</FieldLabelCn>
</FieldCn>";

    private const string TableCode = @"<TableCn>
    <TableHeaderCn>
        <TableRowCn>
            <TableHeadCn Class=""w-8"">
                <CheckboxCn id=""select-all"" Checked=""_selectAll"" CheckedChanged=""HandleSelectAll"" />
            </TableHeadCn>
            <TableHeadCn>Name</TableHeadCn>
            <TableHeadCn>Email</TableHeadCn>
            <TableHeadCn>Role</TableHeadCn>
        </TableRowCn>
    </TableHeaderCn>
    <TableBodyCn>
        @foreach (var row in _tableData)
        {
            <TableRowCn data-state=""@(_selectedRows.Contains(row.Id) ? ""selected"" : null)"">
                <TableCellCn>
                    <CheckboxCn id=""@($""row-{row.Id}"")"" Checked=""_selectedRows.Contains(row.Id)""
                                CheckedChanged=""@(c => HandleSelectRow(row.Id, c))"" />
                </TableCellCn>
                <TableCellCn Class=""font-medium"">@row.Name</TableCellCn>
                <TableCellCn>@row.Email</TableCellCn>
                <TableCellCn>@row.Role</TableCellCn>
            </TableRowCn>
        }
    </TableBodyCn>
</TableCn>";

    private const string RtlCode = @"<div class=""flex w-full flex-col gap-5 max-w-sm"" dir=""rtl"">
    <FieldCn Orientation=""FieldOrientation.Horizontal"">
        <CheckboxCn id=""terms-checkbox-rtl"" @bind-Checked=""_rtlTerms"" />
        <FieldLabelCn For=""terms-checkbox-rtl"">قبول الشروط والأحكام</FieldLabelCn>
    </FieldCn>
    <FieldCn Orientation=""FieldOrientation.Horizontal"">
        <CheckboxCn id=""terms-checkbox-2-rtl"" @bind-Checked=""_rtlTerms2"" />
        <FieldContentCn>
            <FieldLabelCn For=""terms-checkbox-2-rtl"">قبول الشروط والأحكام</FieldLabelCn>
            <FieldDescriptionCn>بالنقر على هذا المربع، فإنك توافق على الشروط.</FieldDescriptionCn>
        </FieldContentCn>
    </FieldCn>
    <FieldCn Orientation=""FieldOrientation.Horizontal"" data-disabled=""true"">
        <CheckboxCn id=""toggle-checkbox-rtl"" Disabled=""true"" />
        <FieldLabelCn For=""toggle-checkbox-rtl"">تفعيل الإشعارات</FieldLabelCn>
    </FieldCn>
    <label class=""flex w-fit gap-2 leading-snug w-full flex-col rounded-lg border has-[:checked]:border-primary/30 has-[:checked]:bg-primary/5"">
        <FieldCn Orientation=""FieldOrientation.Horizontal"" Class=""p-2.5"">
            <CheckboxCn id=""toggle-checkbox-2-rtl"" @bind-Checked=""_rtlNotify"" />
            <FieldContentCn>
                <FieldTitleCn>تفعيل الإشعارات</FieldTitleCn>
