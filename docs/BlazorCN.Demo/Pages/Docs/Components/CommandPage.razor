@page "/docs/components/command"
@layout DocsLayout

<PageTitle>Command — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Command</h1>
        <p class="mt-2 text-lg text-muted-foreground">Fast, composable, unstyled command menu for Blazor.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <CommandCn Class="max-w-sm rounded-lg border">
            <CommandInputCn Placeholder="Type a command or search..." />
            <CommandListCn>
                <CommandEmptyCn>No results found.</CommandEmptyCn>
                <CommandGroupCn Heading="Suggestions">
                    <CommandItemCn Value="calendar">
                        <LucideCalendarCn Size="16" />
                        <span>Calendar</span>
                    </CommandItemCn>
                    <CommandItemCn Value="search-emoji">
                        <LucideSmileCn Size="16" />
                        <span>Search Emoji</span>
                    </CommandItemCn>
                    <CommandItemCn Value="calculator" Disabled="true">
                        <LucideCalculatorCn Size="16" />
                        <span>Calculator</span>
                    </CommandItemCn>
                </CommandGroupCn>
                <CommandSeparatorCn />
                <CommandGroupCn Heading="Settings">
                    <CommandItemCn Value="profile">
                        <LucideUserCn Size="16" />
                        <span>Profile</span>
                        <CommandShortcutCn>&#x2318;P</CommandShortcutCn>
                    </CommandItemCn>
                    <CommandItemCn Value="billing">
                        <LucideCreditCardCn Size="16" />
                        <span>Billing</span>
                        <CommandShortcutCn>&#x2318;B</CommandShortcutCn>
                    </CommandItemCn>
                    <CommandItemCn Value="settings">
