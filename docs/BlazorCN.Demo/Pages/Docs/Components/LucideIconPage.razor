@page "/docs/components/lucide-icon"
@layout DocsLayout

<PageTitle>Lucide Icon — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Lucide Icon</h1>
        <p class="mt-2 text-lg text-muted-foreground">1700+ icons from the Lucide icon library, available as individual Blazor components.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Default" Code="@DefaultCode">
        <LucideHeartCn />
    </ComponentPreview>

    <ComponentPreview Title="Sizes" Code="@SizesCode">
        <div class="flex items-end gap-4">
            <LucideHeartCn Size="16" />
            <LucideHeartCn Size="24" />
            <LucideHeartCn Size="32" />
            <LucideHeartCn Size="48" />
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Custom Color" Code="@ColorCode">
        <div class="flex items-center gap-4">
            <LucideHeartCn Stroke="red" />
            <LucideHeartCn Class="text-blue-500" />
            <LucideHeartCn Class="text-green-500" />
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Stroke Width" Code="@StrokeWidthCode">
        <div class="flex items-center gap-4">
            <LucideHeartCn StrokeWidth="1" />
            <LucideHeartCn StrokeWidth="2" />
            <LucideHeartCn StrokeWidth="3" />
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Popular Icons" Code="@PopularCode">
        <div class="grid grid-cols-4 gap-6 sm:grid-cols-6 md:grid-cols-8">
            <div class="flex flex-col items-center gap-1.5">
                <LucideHouseCn />
                <span class="text-xs text-muted-foreground">House</span>
            </div>
            <div class="flex flex-col items-center gap-1.5">
                <LucideSearchCn />
                <span class="text-xs text-muted-foreground">Search</span>
            </div>
            <div class="flex flex-col items-center gap-1.5">
                <LucideSettingsCn />
                <span class="text-xs text-muted-foreground">Settings</span>
            </div>
            <div class="flex flex-col items-center gap-1.5">
                <LucideUserCn />
                <span class="text-xs text-muted-foreground">User</span>
            </div>
            <div class="flex flex-col items-center gap-1.5">
                <LucideMailCn />
                <span class="text-xs text-muted-foreground">Mail</span>
            </div>
            <div class="flex flex-col items-center gap-1.5">
                <LucideHeartCn />
                <span class="text-xs text-muted-foreground">Heart</span>
            </div>
            <div class="flex flex-col items-center gap-1.5">
                <LucideStarCn />
