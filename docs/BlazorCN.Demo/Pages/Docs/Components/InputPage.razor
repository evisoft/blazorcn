@page "/docs/components/input"
@layout DocsLayout

<PageTitle>Input — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Input</h1>
        <p class="mt-2 text-lg text-muted-foreground">Displays a form input field.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <div class="grid w-full max-w-sm gap-1.5">
            <LabelCn For="input-demo-api-key">API Key</LabelCn>
            <InputCn id="input-demo-api-key" Type="password" Placeholder="sk-..." />
            <p class="text-sm text-muted-foreground">Your API key is encrypted and stored securely.</p>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Basic" Code="@BasicCode">
        <InputCn Placeholder="Enter text" Class="max-w-sm" />
    </ComponentPreview>

    <ComponentPreview Title="Disabled" Code="@DisabledCode">
        <FieldCn Class="max-w-sm gap-1.5" data-disabled="true">
            <FieldLabelCn For="input-demo-disabled">Email</FieldLabelCn>
            <InputCn id="input-demo-disabled" Type="email" Placeholder="Email" Disabled="true" />
            <FieldDescriptionCn>This field is currently disabled.</FieldDescriptionCn>
        </FieldCn>
    </ComponentPreview>

    <ComponentPreview Title="Invalid" Code="@InvalidCode">
        <FieldCn Class="max-w-sm gap-1.5" data-invalid="true">
            <FieldLabelCn For="input-invalid">Invalid Input</FieldLabelCn>
            <InputCn id="input-invalid" Placeholder="Error" aria-invalid="true" />
            <FieldDescriptionCn>This field contains validation errors.</FieldDescriptionCn>
        </FieldCn>
    </ComponentPreview>

    <ComponentPreview Title="Required" Code="@RequiredCode">
        <FieldCn Class="max-w-sm gap-1.5">
            <FieldLabelCn For="input-required">
                Required Field <span class="text-destructive">*</span>
            </FieldLabelCn>
            <InputCn id="input-required" Placeholder="This field is required" required />
            <FieldDescriptionCn>This field must be filled out.</FieldDescriptionCn>
        </FieldCn>
    </ComponentPreview>

    <ComponentPreview Title="File" Code="@FileCode">
        <div class="grid w-full max-w-sm gap-1.5">
            <LabelCn For="picture">Picture</LabelCn>
            <InputCn id="picture" Type="file" />
            <p class="text-sm text-muted-foreground">Select a picture to upload.</p>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Field" Code="@FieldCode">
        <FieldCn Class="max-w-sm gap-1.5">
            <FieldLabelCn For="input-field-username">Username</FieldLabelCn>
            <InputCn id="input-field-username" Type="text" Placeholder="Enter your username" />
            <FieldDescriptionCn>Choose a unique username for your account.</FieldDescriptionCn>
        </FieldCn>
    </ComponentPreview>

    <ComponentPreview Title="Form" Code="@FormCode">
        <form class="w-full max-w-sm space-y-4">
            <div class="grid gap-1.5">
                <LabelCn For="form-name">Name</LabelCn>
                <InputCn id="form-name" Type="text" Placeholder="Evil Rabbit" required />
            </div>
            <div class="grid gap-1.5">
                <LabelCn For="form-email">Email</LabelCn>
                <InputCn id="form-email" Type="email" Placeholder="john@example.com" />
                <p class="text-sm text-muted-foreground">We'll never share your email with anyone.</p>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div class="grid gap-1.5">
                    <LabelCn For="form-phone">Phone</LabelCn>
                    <InputCn id="form-phone" Type="tel" Placeholder="+1 (555) 123-4567" />
                </div>
                <div class="grid gap-1.5">
                    <LabelCn For="form-country">Country</LabelCn>
                    <SelectCn @bind-Value="_formCountry">
                        <SelectTriggerCn id="form-country">
                            <SelectValueCn Placeholder="Select" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectGroupCn>
                                <SelectItemCn Value="us">United States</SelectItemCn>
                                <SelectItemCn Value="uk">United Kingdom</SelectItemCn>
                                <SelectItemCn Value="ca">Canada</SelectItemCn>
                            </SelectGroupCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>
            <div class="grid gap-1.5">
                <LabelCn For="form-address">Address</LabelCn>
                <InputCn id="form-address" Type="text" Placeholder="123 Main St" />
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Type="button">Cancel</ButtonCn>
                <ButtonCn Type="submit">Submit</ButtonCn>
            </div>
        </form>
    </ComponentPreview>

    <ComponentPreview Title="Badge" Code="@BadgeCode">
        <div class="grid w-full max-w-sm gap-1.5">
            <div class="flex items-center">
                <LabelCn For="input-badge">Webhook URL</LabelCn>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto">Beta</BadgeCn>
            </div>
            <InputCn id="input-badge" Type="url" Placeholder="https://api.example.com/webhook" />
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Button Group" Code="@ButtonGroupCode">
        <div class="grid w-full max-w-sm gap-1.5">
            <LabelCn For="input-button-group">Search</LabelCn>
            <div class="flex">
                <InputCn id="input-button-group" Placeholder="Type to search..." Class="rounded-r-none" />
                <ButtonCn Variant="ButtonVariant.Outline" Class="rounded-l-none border-l-0">Search</ButtonCn>
            </div>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Grid" Code="@GridCode">
        <div class="grid max-w-sm grid-cols-2 gap-4">
            <div class="grid gap-1.5">
                <LabelCn For="first-name">First Name</LabelCn>
                <InputCn id="first-name" Placeholder="Jordan" />
            </div>
            <div class="grid gap-1.5">
                <LabelCn For="last-name">Last Name</LabelCn>
                <InputCn id="last-name" Placeholder="Lee" />
            </div>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Inline" Code="@InlineCode">
        <div class="flex w-full max-w-sm items-center gap-2">
            <InputCn Type="search" Placeholder="Search..." />
            <ButtonCn>Search</ButtonCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div dir="rtl" class="grid w-full max-w-sm gap-1.5">
            <LabelCn For="input-rtl-api-key">مفتاح API</LabelCn>
            <InputCn id="input-rtl-api-key" Type="password" Placeholder="sk-..." dir="rtl" />
            <p class="text-sm text-muted-foreground">مفتاح API الخاص بك مشفر ومخزن بأمان.</p>
        </div>
    </ComponentPreview>
</div>

