@page "/docs/components/toggle"
@layout DocsLayout

<PageTitle>Toggle — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Toggle</h1>
        <p class="mt-2 text-lg text-muted-foreground">A two-state button that can be either on or off.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <ToggleCn Variant="ToggleVariant.Outline" Size="ToggleSize.Sm" aria-label="Toggle bookmark" @bind-Pressed="_demoPressed">
            <LucideBookmarkCn Size="14" Class="group-data-[state=on]/toggle:fill-accent-foreground" />
            Bookmark
        </ToggleCn>
    </ComponentPreview>

    <ComponentPreview Title="Sizes" Code="@SizesCode">
        <div class="flex flex-wrap items-center gap-2">
            <ToggleCn Variant="ToggleVariant.Outline" Size="ToggleSize.Sm" aria-label="Toggle small">Small</ToggleCn>
            <ToggleCn Variant="ToggleVariant.Outline" aria-label="Toggle default">Default</ToggleCn>
            <ToggleCn Variant="ToggleVariant.Outline" Size="ToggleSize.Lg" aria-label="Toggle large">Large</ToggleCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Outline" Code="@OutlineCode">
        <div class="flex flex-wrap items-center gap-2">
            <ToggleCn Variant="ToggleVariant.Outline" aria-label="Toggle italic" @bind-Pressed="_outlineItalicPressed">
                <LucideItalicCn Size="16" />
                Italic
            </ToggleCn>
            <ToggleCn Variant="ToggleVariant.Outline" aria-label="Toggle bold" @bind-Pressed="_outlineBoldPressed">
                <LucideBoldCn Size="16" />
                Bold
            </ToggleCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Disabled" Code="@DisabledCode">
        <div class="flex flex-wrap items-center gap-2">
            <ToggleCn Disabled="true" aria-label="Toggle disabled">Disabled</ToggleCn>
            <ToggleCn Variant="ToggleVariant.Outline" Disabled="true" aria-label="Toggle disabled outline">Disabled</ToggleCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="With Text" Code="@WithTextCode">
        <ToggleCn aria-label="Toggle italic" @bind-Pressed="_textPressed">
            <LucideItalicCn Size="16" />
            Italic
        </ToggleCn>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div dir="rtl">
            <ToggleCn Variant="ToggleVariant.Outline" Size="ToggleSize.Sm" aria-label="Toggle bookmark" @bind-Pressed="_rtlPressed">
                <LucideBookmarkCn Size="14" Class="group-data-[state=on]/toggle:fill-accent-foreground" />
                إشارة مرجعية
            </ToggleCn>
        </div>
    </ComponentPreview>
</div>

@code {
    private bool _demoPressed;
    private bool _outlineItalicPressed;
    private bool _outlineBoldPressed;
    private bool _textPressed;
    private bool _rtlPressed;

    private const string DemoCode = @"<ToggleCn Variant=""ToggleVariant.Outline"" Size=""ToggleSize.Sm"" aria-label=""Toggle bookmark"" @bind-Pressed=""_pressed"">
    <LucideBookmarkCn Size=""14"" Class=""group-data-[state=on]/toggle:fill-accent-foreground"" />
    Bookmark
</ToggleCn>";

    private const string SizesCode = @"<div class=""flex flex-wrap items-center gap-2"">
    <ToggleCn Variant=""ToggleVariant.Outline"" Size=""ToggleSize.Sm"" aria-label=""Toggle small"">Small</ToggleCn>
    <ToggleCn Variant=""ToggleVariant.Outline"" aria-label=""Toggle default"">Default</ToggleCn>
    <ToggleCn Variant=""ToggleVariant.Outline"" Size=""ToggleSize.Lg"" aria-label=""Toggle large"">Large</ToggleCn>
</div>";

    private const string OutlineCode = @"<div class=""flex flex-wrap items-center gap-2"">
    <ToggleCn Variant=""ToggleVariant.Outline"" aria-label=""Toggle italic"" @bind-Pressed=""_italicPressed"">
        <LucideItalicCn Size=""16"" />
        Italic
    </ToggleCn>
    <ToggleCn Variant=""ToggleVariant.Outline"" aria-label=""Toggle bold"" @bind-Pressed=""_boldPressed"">
        <LucideBoldCn Size=""16"" />
        Bold
    </ToggleCn>
</div>";

    private const string DisabledCode = @"<div class=""flex flex-wrap items-center gap-2"">
    <ToggleCn Disabled=""true"" aria-label=""Toggle disabled"">Disabled</ToggleCn>
    <ToggleCn Variant=""ToggleVariant.Outline"" Disabled=""true"" aria-label=""Toggle disabled outline"">Disabled</ToggleCn>
</div>";

    private const string WithTextCode = @"<ToggleCn aria-label=""Toggle italic"" @bind-Pressed=""_pressed"">
    <LucideItalicCn Size=""16"" />
    Italic
</ToggleCn>";

    private const string RtlCode = @"<div dir=""rtl"">
    <ToggleCn Variant=""ToggleVariant.Outline"" Size=""ToggleSize.Sm"" aria-label=""Toggle bookmark"" @bind-Pressed=""_pressed"">
        <LucideBookmarkCn Size=""14"" Class=""group-data-[state=on]/toggle:fill-accent-foreground"" />
        إشارة مرجعية
    </ToggleCn>
</div>";
}
