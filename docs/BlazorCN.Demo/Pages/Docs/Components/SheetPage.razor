@page "/docs/components/sheet"
@layout DocsLayout

<PageTitle>Sheet — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Sheet</h1>
        <p class="mt-2 text-lg text-muted-foreground">Extends the Dialog component to display content that complements the main content of the screen.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Default" Code="@DefaultCode">
        <SheetCn @bind-Open="_defaultOpen">
            <SheetTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">Open</SheetTriggerCn>
            <SheetOverlayCn />
            <SheetContentCn>
                <SheetHeaderCn>
                    <SheetTitleCn>Edit profile</SheetTitleCn>
                    <SheetDescriptionCn>Make changes to your profile here. Click save when you're done.</SheetDescriptionCn>
                </SheetHeaderCn>
                <div class="grid flex-1 auto-rows-min gap-6 px-4">
                    <div class="grid gap-3">
                        <LabelCn For="sheet-demo-name">Name</LabelCn>
                        <InputCn id="sheet-demo-name" Value="Pedro Duarte" />
                    </div>
                    <div class="grid gap-3">
                        <LabelCn For="sheet-demo-username">Username</LabelCn>
                        <InputCn id="sheet-demo-username" Value="@("@peduarte")" />
                    </div>
                </div>
                <SheetFooterCn>
                    <ButtonCn>Save changes</ButtonCn>
                    <SheetCloseCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">Close</SheetCloseCn>
                </SheetFooterCn>
            </SheetContentCn>
        </SheetCn>
    </ComponentPreview>

    <ComponentPreview Title="Side" Code="@SideCode">
        <div class="flex flex-wrap gap-2">
            @foreach (var side in _sides)
            {
                <SheetCn @bind-Open="_sideOpen[side]">
                    <SheetTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default capitalize" data-variant="outline" data-size="default">@side.ToString()</SheetTriggerCn>
                    <SheetOverlayCn />
                    <SheetContentCn Side="side" Class="@(side is SheetSide.Bottom or SheetSide.Top ? "max-h-[50vh]" : "")">
                        <SheetHeaderCn>
                            <SheetTitleCn>Edit profile</SheetTitleCn>
                            <SheetDescriptionCn>Make changes to your profile here. Click save when you're done.</SheetDescriptionCn>
                        </SheetHeaderCn>
                        <div class="no-scrollbar overflow-y-auto px-4">
                            @for (var i = 0; i < 10; i++)
                            {
                                <p class="mb-2 leading-relaxed">
                                    Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.
                                </p>
                            }
                        </div>
                        <SheetFooterCn>
                            <ButtonCn>Save changes</ButtonCn>
                            <SheetCloseCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">Cancel</SheetCloseCn>
                        </SheetFooterCn>
                    </SheetContentCn>
                </SheetCn>
            }
        </div>
    </ComponentPreview>

    <ComponentPreview Title="No Close Button" Code="@NoCloseButtonCode">
        <SheetCn @bind-Open="_noCloseOpen">
            <SheetTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">Open Sheet</SheetTriggerCn>
            <SheetOverlayCn />
            <SheetContentCn ShowCloseButton="false">
                <SheetHeaderCn>
                    <SheetTitleCn>No Close Button</SheetTitleCn>
                    <SheetDescriptionCn>This sheet doesn't have a close button in the top-right corner. Click outside to close.</SheetDescriptionCn>
                </SheetHeaderCn>
            </SheetContentCn>
        </SheetCn>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div dir="rtl">
            <SheetCn @bind-Open="_rtlOpen">
                <SheetTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">&#x641;&#x62A;&#x62D;</SheetTriggerCn>
                <SheetOverlayCn />
                <SheetContentCn Side="SheetSide.Left">
                    <SheetHeaderCn>
                        <SheetTitleCn>&#x62A;&#x639;&#x62F;&#x64A;&#x644; &#x627;&#x644;&#x645;&#x644;&#x641; &#x627;&#x644;&#x634;&#x62E;&#x635;&#x64A;</SheetTitleCn>
                        <SheetDescriptionCn>&#x642;&#x645; &#x628;&#x625;&#x62C;&#x631;&#x627;&#x621; &#x62A;&#x63A;&#x64A;&#x64A;&#x631;&#x627;&#x62A; &#x639;&#x644;&#x649; &#x645;&#x644;&#x641;&#x643; &#x627;&#x644;&#x634;&#x62E;&#x635;&#x64A; &#x647;&#x646;&#x627;. &#x627;&#x646;&#x642;&#x631; &#x62D;&#x641;&#x638; &#x639;&#x646;&#x62F; &#x627;&#x644;&#x627;&#x646;&#x62A;&#x647;&#x627;&#x621;.</SheetDescriptionCn>
                    </SheetHeaderCn>
                    <div class="grid flex-1 auto-rows-min gap-6 px-4">
                        <div class="grid gap-3">
                            <LabelCn For="sheet-rtl-name">&#x627;&#x644;&#x627;&#x633;&#x645;</LabelCn>
                            <InputCn id="sheet-rtl-name" Value="Pedro Duarte" />
                        </div>
                        <div class="grid gap-3">
                            <LabelCn For="sheet-rtl-username">&#x627;&#x633;&#x645; &#x627;&#x644;&#x645;&#x633;&#x62A;&#x62E;&#x62F;&#x645;</LabelCn>
                            <InputCn id="sheet-rtl-username" Value="peduarte" />
                        </div>
                    </div>
                    <SheetFooterCn>
                        <ButtonCn>&#x62D;&#x641;&#x638; &#x627;&#x644;&#x62A;&#x63A;&#x64A;&#x64A;&#x631;&#x627;&#x62A;</ButtonCn>
                        <SheetCloseCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">&#x625;&#x63A;&#x644;&#x627;&#x642;</SheetCloseCn>
                    </SheetFooterCn>
                </SheetContentCn>
            </SheetCn>
        </div>
    </ComponentPreview>
</div>

@code {
    private bool _defaultOpen;
    private bool _noCloseOpen;
    private bool _rtlOpen;

    private readonly SheetSide[] _sides = [SheetSide.Top, SheetSide.Right, SheetSide.Bottom, SheetSide.Left];
    private readonly Dictionary<SheetSide, bool> _sideOpen = new()
    {
        [SheetSide.Top] = false,
        [SheetSide.Right] = false,
        [SheetSide.Bottom] = false,
        [SheetSide.Left] = false,
    };

    private const string DefaultCode = @"<SheetCn @bind-Open=""_open"">
    <SheetTriggerCn Class=""cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default"" data-variant=""outline"" data-size=""default"">Open</SheetTriggerCn>
    <SheetOverlayCn />
    <SheetContentCn>
        <SheetHeaderCn>
            <SheetTitleCn>Edit profile</SheetTitleCn>
            <SheetDescriptionCn>Make changes to your profile here. Click save when you're done.</SheetDescriptionCn>
        </SheetHeaderCn>
        <div class=""grid flex-1 auto-rows-min gap-6 px-4"">
            <div class=""grid gap-3"">
                <LabelCn For=""sheet-demo-name"">Name</LabelCn>
                <InputCn id=""sheet-demo-name"" Value=""Pedro Duarte"" />
            </div>
            <div class=""grid gap-3"">
                <LabelCn For=""sheet-demo-username"">Username</LabelCn>
                <InputCn id=""sheet-demo-username"" Value=""@@peduarte"" />
            </div>
        </div>
        <SheetFooterCn>
            <ButtonCn>Save changes</ButtonCn>
            <SheetCloseCn Class=""cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default"" data-variant=""outline"" data-size=""default"">Close</SheetCloseCn>
        </SheetFooterCn>
    </SheetContentCn>
</SheetCn>";

    private const string SideCode = @"<div class=""flex flex-wrap gap-2"">
    @foreach (var side in new[] { SheetSide.Top, SheetSide.Right, SheetSide.Bottom, SheetSide.Left })
    {
        <SheetCn @bind-Open=""_sideOpen[side]"">
            <SheetTriggerCn Class=""cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default capitalize"" data-variant=""outline"" data-size=""default"">@side.ToString()</SheetTriggerCn>
            <SheetOverlayCn />
            <SheetContentCn Side=""side"" Class=""@(side is SheetSide.Bottom or SheetSide.Top ? ""max-h-[50vh]"" : """")"">
                <SheetHeaderCn>
                    <SheetTitleCn>Edit profile</SheetTitleCn>
                    <SheetDescriptionCn>Make changes to your profile here. Click save when you're done.</SheetDescriptionCn>
                </SheetHeaderCn>
                <div class=""no-scrollbar overflow-y-auto px-4"">
                    @for (var i = 0; i < 10; i++)
                    {
                        <p class=""mb-2 leading-relaxed"">Lorem ipsum dolor sit amet...</p>
                    }
                </div>
                <SheetFooterCn>
                    <ButtonCn>Save changes</ButtonCn>
                    <SheetCloseCn Class=""cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default"" data-variant=""outline"" data-size=""default"">Cancel</SheetCloseCn>
                </SheetFooterCn>
            </SheetContentCn>
        </SheetCn>
    }
</div>";

    private const string NoCloseButtonCode = @"<SheetCn @bind-Open=""_open"">
    <SheetTriggerCn Class=""cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default"" data-variant=""outline"" data-size=""default"">Open Sheet</SheetTriggerCn>
    <SheetOverlayCn />
    <SheetContentCn ShowCloseButton=""false"">
        <SheetHeaderCn>
            <SheetTitleCn>No Close Button</SheetTitleCn>
            <SheetDescriptionCn>This sheet doesn't have a close button in the top-right corner. Click outside to close.</SheetDescriptionCn>
        </SheetHeaderCn>
    </SheetContentCn>
</SheetCn>";

    private const string RtlCode = @"<div dir=""rtl"">
    <SheetCn @bind-Open=""_open"">
        <SheetTriggerCn Class=""cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default"" data-variant=""outline"" data-size=""default"">فتح</SheetTriggerCn>
        <SheetOverlayCn />
        <SheetContentCn Side=""SheetSide.Left"">
            <SheetHeaderCn>
                <SheetTitleCn>تعديل الملف الشخصي</SheetTitleCn>
                <SheetDescriptionCn>قم بإجراء تغييرات على ملفك الشخصي هنا. انقر حفظ عند الانتهاء.</SheetDescriptionCn>
            </SheetHeaderCn>
            <div class=""grid flex-1 auto-rows-min gap-6 px-4"">
                <div class=""grid gap-3"">
                    <LabelCn For=""sheet-rtl-name"">الاسم</LabelCn>
                    <InputCn id=""sheet-rtl-name"" Value=""Pedro Duarte"" />
                </div>
                <div class=""grid gap-3"">
                    <LabelCn For=""sheet-rtl-username"">اسم المستخدم</LabelCn>
                    <InputCn id=""sheet-rtl-username"" Value=""peduarte"" />
                </div>
            </div>
            <SheetFooterCn>
                <ButtonCn>حفظ التغييرات</ButtonCn>
                <SheetCloseCn Class=""cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default"" data-variant=""outline"" data-size=""default"">إغلاق</SheetCloseCn>
            </SheetFooterCn>
        </SheetContentCn>
    </SheetCn>
</div>";
}
