@page "/docs/components/textarea"
@layout DocsLayout

<PageTitle>Textarea — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Textarea</h1>
        <p class="mt-2 text-lg text-muted-foreground">Displays a form textarea or a component that looks like a textarea.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Default" Code="@DefaultCode">
        <TextareaCn Placeholder="Type your message here." />
    </ComponentPreview>

    <ComponentPreview Title="Disabled" Code="@DisabledCode">
        <FieldCn Class="max-w-sm" data-disabled="">
            <FieldLabelCn For="textarea-disabled">Message</FieldLabelCn>
            <TextareaCn id="textarea-disabled" Placeholder="Type your message here." Disabled="true" />
        </FieldCn>
    </ComponentPreview>

    <ComponentPreview Title="Invalid" Code="@InvalidCode">
        <FieldCn Class="max-w-sm" data-invalid="">
            <FieldLabelCn For="textarea-invalid">Message</FieldLabelCn>
            <TextareaCn id="textarea-invalid" Placeholder="Type your message here." aria-invalid="true" />
            <FieldDescriptionCn>Please enter a valid message.</FieldDescriptionCn>
        </FieldCn>
    </ComponentPreview>

    <ComponentPreview Title="With Label and Description" Code="@FieldCode">
        <FieldCn Class="max-w-sm">
            <FieldLabelCn For="textarea-message">Message</FieldLabelCn>
            <FieldDescriptionCn>Enter your message below.</FieldDescriptionCn>
            <TextareaCn id="textarea-message" Placeholder="Type your message here." />
        </FieldCn>
    </ComponentPreview>

    <ComponentPreview Title="With Button" Code="@ButtonCode">
        <div class="grid w-full max-w-sm gap-2">
            <TextareaCn Placeholder="Type your message here." />
            <ButtonCn>Send message</ButtonCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Right-to-Left" Code="@RtlCode">
        <div class="w-full max-w-xs" dir="rtl">
            <div class="grid gap-1.5">
                <LabelCn For="feedback" dir="rtl">&#x0627;&#x0644;&#x062A;&#x0639;&#x0644;&#x064A;&#x0642;&#x0627;&#x062A;</LabelCn>
                <TextareaCn id="feedback" Placeholder="&#x062A;&#x0639;&#x0644;&#x064A;&#x0642;&#x0627;&#x062A;&#x0643; &#x062A;&#x0633;&#x0627;&#x0639;&#x062F;&#x0646;&#x0627; &#x0639;&#x0644;&#x0649; &#x0627;&#x0644;&#x062A;&#x062D;&#x0633;&#x064A;&#x0646;..." dir="rtl" rows="4" />
                <p class="text-sm text-muted-foreground" dir="rtl">&#x0634;&#x0627;&#x0631;&#x0643;&#x0646;&#x0627; &#x0623;&#x0641;&#x0643;&#x0627;&#x0631;&#x0643; &#x062D;&#x0648;&#x0644; &#x062E;&#x062F;&#x0645;&#x062A;&#x0646;&#x0627;.</p>
            </div>
        </div>
    </ComponentPreview>
</div>

@code {
    private const string DefaultCode = @"<TextareaCn Placeholder=""Type your message here."" />";
    private const string DisabledCode = @"<FieldCn Class=""max-w-sm"" data-disabled="""">
    <FieldLabelCn For=""textarea-disabled"">Message</FieldLabelCn>
    <TextareaCn id=""textarea-disabled"" Placeholder=""Type your message here."" Disabled=""true"" />
</FieldCn>";
    private const string InvalidCode = @"<FieldCn Class=""max-w-sm"" data-invalid="""">
    <FieldLabelCn For=""textarea-invalid"">Message</FieldLabelCn>
    <TextareaCn id=""textarea-invalid"" Placeholder=""Type your message here."" aria-invalid=""true"" />
    <FieldDescriptionCn>Please enter a valid message.</FieldDescriptionCn>
</FieldCn>";
    private const string FieldCode = @"<FieldCn Class=""max-w-sm"">
    <FieldLabelCn For=""textarea-message"">Message</FieldLabelCn>
    <FieldDescriptionCn>Enter your message below.</FieldDescriptionCn>
    <TextareaCn id=""textarea-message"" Placeholder=""Type your message here."" />
</FieldCn>";
    private const string ButtonCode = @"<div class=""grid w-full max-w-sm gap-2"">
    <TextareaCn Placeholder=""Type your message here."" />
    <ButtonCn>Send message</ButtonCn>
</div>";
    private const string RtlCode = @"<div class=""w-full max-w-xs"" dir=""rtl"">
    <div class=""grid gap-1.5"">
        <LabelCn For=""feedback"" dir=""rtl"">التعليقات</LabelCn>
        <TextareaCn id=""feedback"" Placeholder=""تعليقاتك تساعدنا على التحسين..."" dir=""rtl"" rows=""4"" />
        <p class=""text-sm text-muted-foreground"" dir=""rtl"">شاركنا أفكارك حول خدمتنا.</p>
    </div>
</div>";
}
