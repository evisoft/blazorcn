@page "/docs/components/toast"
@layout DocsLayout

<PageTitle>Toast — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Toast</h1>
        <p class="mt-2 text-lg text-muted-foreground">A succinct message that is displayed temporarily.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <ButtonCn Variant="ButtonVariant.Outline" @onclick="ShowDemo">Show Toast</ButtonCn>
    </ComponentPreview>

    <ComponentPreview Title="Types" Code="@TypesCode">
        <div class="flex flex-wrap gap-2">
            <ButtonCn Variant="ButtonVariant.Outline" @onclick="ShowDefault">Default</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" @onclick="ShowSuccess">Success</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" @onclick="ShowInfo">Info</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" @onclick="ShowWarning">Warning</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" @onclick="ShowError">Error</ButtonCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="With Description" Code="@DescriptionCode">
        <ButtonCn Variant="ButtonVariant.Outline" Class="w-fit" @onclick="ShowWithDescription">Show Toast</ButtonCn>
    </ComponentPreview>

    <ComponentPreview Title="With Title" Code="@TitleCode">
        <ButtonCn Variant="ButtonVariant.Outline" Class="w-fit" @onclick="ShowWithTitle">Show Toast</ButtonCn>
    </ComponentPreview>
</div>

@code {
    [Inject] private ToastService ToastService { get; set; } = default!;

    private void ShowDemo() =>
        ToastService.Show("Sunday, December 03, 2023 at 9:00 AM", title: "Event has been created");

    private void ShowDefault() => ToastService.Show("Event has been created");
    private void ShowSuccess() => ToastService.Success("Event has been created");
    private void ShowInfo() => ToastService.Info("Be at the area 10 minutes before the event time");
    private void ShowWarning() => ToastService.Warning("Event start time cannot be earlier than 8am");
    private void ShowError() => ToastService.Error("Event has not been created");

    private void ShowWithDescription() =>
        ToastService.Show("Monday, January 3rd at 6:00pm", title: "Event has been created");

    private void ShowWithTitle() =>
        ToastService.Show("Your changes have been saved.", title: "Saved");

    private const string DemoCode = @"@inject ToastService ToastService

<ButtonCn Variant=""ButtonVariant.Outline""
          @onclick=""ShowToast"">
    Show Toast
</ButtonCn>

@code {
    private void ShowToast() =>
        ToastService.Show(""Sunday, December 03, 2023 at 9:00 AM"",
                          title: ""Event has been created"");
}

@* Place <ToasterCn /> once in your layout *@";

    private const string TypesCode = @"@inject ToastService ToastService

<div class=""flex flex-wrap gap-2"">
    <ButtonCn Variant=""ButtonVariant.Outline""
              @onclick=""() => ToastService.Show(""""Event has been created"""")"">
        Default
    </ButtonCn>
    <ButtonCn Variant=""ButtonVariant.Outline""
              @onclick=""() => ToastService.Success(""""Event has been created"""")"">
        Success
    </ButtonCn>
    <ButtonCn Variant=""ButtonVariant.Outline""
              @onclick=""() => ToastService.Info(""""Be at the area 10 minutes before the event time"""")"">
        Info
    </ButtonCn>
    <ButtonCn Variant=""ButtonVariant.Outline""
              @onclick=""() => ToastService.Warning(""""Event start time cannot be earlier than 8am"""")"">
        Warning
    </ButtonCn>
    <ButtonCn Variant=""ButtonVariant.Outline""
              @onclick=""() => ToastService.Error(""""Event has not been created"""")"">
        Error
    </ButtonCn>
</div>";

    private const string DescriptionCode = @"@inject ToastService ToastService

<ButtonCn Variant=""ButtonVariant.Outline"" Class=""w-fit""
          @onclick=""ShowToast"">
    Show Toast
</ButtonCn>

@code {
    private void ShowToast() =>
        ToastService.Show(""Monday, January 3rd at 6:00pm"",
                          title: ""Event has been created"");
}";

    private const string TitleCode = @"@inject ToastService ToastService

<ButtonCn Variant=""ButtonVariant.Outline"" Class=""w-fit""
          @onclick=""ShowToast"">
    Show Toast
</ButtonCn>

@code {
    private void ShowToast() =>
        ToastService.Show(""Your changes have been saved."",
                          title: ""Saved"");
}";
}
