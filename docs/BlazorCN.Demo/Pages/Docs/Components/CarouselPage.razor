@page "/docs/components/carousel"
@layout DocsLayout
@using System.Threading
@implements IDisposable

<PageTitle>Carousel — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Carousel</h1>
        <p class="mt-2 text-lg text-muted-foreground">A carousel with motion and swipe built using a composable component set.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <CarouselCn Class="w-full max-w-[12rem] sm:max-w-xs">
            <CarouselContentCn>
                @for (var i = 1; i <= 5; i++)
                {
                    var num = i;
                    <CarouselItemCn>
                        <div class="p-1">
                            <CardCn>
                                <CardContentCn Class="flex aspect-square items-center justify-center p-6">
                                    <span class="text-4xl font-semibold">@num</span>
                                </CardContentCn>
                            </CardCn>
                        </div>
                    </CarouselItemCn>
                }
            </CarouselContentCn>
            <CarouselPreviousCn />
            <CarouselNextCn />
        </CarouselCn>
    </ComponentPreview>

    <ComponentPreview Title="Multiple" Code="@MultipleCode">
        <CarouselCn Class="mx-auto max-w-xs sm:max-w-sm">
            <CarouselContentCn>
                @for (var i = 1; i <= 5; i++)
                {
                    var num = i;
                    <CarouselItemCn Class="sm:basis-1/2 lg:basis-1/3">
                        <div class="p-1">
                            <CardCn>
                                <CardContentCn Class="flex aspect-square items-center justify-center p-6">
                                    <span class="text-3xl font-semibold">@num</span>
                                </CardContentCn>
                            </CardCn>
                        </div>
                    </CarouselItemCn>
                }
            </CarouselContentCn>
            <CarouselPreviousCn Class="hidden sm:inline-flex" />
            <CarouselNextCn Class="hidden sm:inline-flex" />
        </CarouselCn>
    </ComponentPreview>

    <ComponentPreview Title="Orientation" Code="@OrientationCode">
        <CarouselCn Orientation="CarouselOrientation.Vertical" Class="w-full max-w-xs">
            <CarouselContentCn Class="-mt-1 h-[270px]">
                @for (var i = 1; i <= 5; i++)
                {
                    var num = i;
                    <CarouselItemCn Class="basis-1/2 pt-1">
                        <div class="p-1">
                            <CardCn>
                                <CardContentCn Class="flex items-center justify-center p-6">
                                    <span class="text-3xl font-semibold">@num</span>
                                </CardContentCn>
                            </CardCn>
                        </div>
                    </CarouselItemCn>
                }
            </CarouselContentCn>
            <CarouselPreviousCn />
            <CarouselNextCn />
        </CarouselCn>
    </ComponentPreview>

    <ComponentPreview Title="Size" Code="@SizeCode">
        <CarouselCn Class="w-full max-w-[12rem] sm:max-w-xs md:max-w-sm">
            <CarouselContentCn>
                @for (var i = 1; i <= 5; i++)
                {
                    var num = i;
                    <CarouselItemCn Class="basis-1/2 lg:basis-1/3">
                        <div class="p-1">
                            <CardCn>
                                <CardContentCn Class="flex aspect-square items-center justify-center p-6">
                                    <span class="text-3xl font-semibold">@num</span>
                                </CardContentCn>
                            </CardCn>
                        </div>
                    </CarouselItemCn>
                }
            </CarouselContentCn>
            <CarouselPreviousCn />
            <CarouselNextCn />
        </CarouselCn>
    </ComponentPreview>

    <ComponentPreview Title="Spacing" Code="@SpacingCode">
        <CarouselCn Class="w-full max-w-[12rem] sm:max-w-xs md:max-w-sm">
            <CarouselContentCn Class="-ml-1">
                @for (var i = 1; i <= 5; i++)
                {
                    var num = i;
                    <CarouselItemCn Class="basis-1/2 pl-1 lg:basis-1/3">
                        <div class="p-1">
                            <CardCn>
                                <CardContentCn Class="flex aspect-square items-center justify-center p-6">
                                    <span class="text-2xl font-semibold">@num</span>
                                </CardContentCn>
                            </CardCn>
                        </div>
                    </CarouselItemCn>
                }
            </CarouselContentCn>
            <CarouselPreviousCn />
            <CarouselNextCn />
        </CarouselCn>
    </ComponentPreview>

    <ComponentPreview Title="API" Code="@ApiCode">
        <div class="mx-auto max-w-[10rem] sm:max-w-xs">
            <CarouselCn @bind-CurrentIndex="_apiCurrentIndex" Class="w-full max-w-xs">
                <CarouselContentCn>
                    @for (var i = 1; i <= 5; i++)
                    {
                        var num = i;
                        <CarouselItemCn>
                            <div class="p-1">
                                <CardCn>
                                    <CardContentCn Class="flex aspect-square items-center justify-center p-6">
                                        <span class="text-4xl font-semibold">@num</span>
                                    </CardContentCn>
                                </CardCn>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <CarouselPreviousCn />
                <CarouselNextCn />
            </CarouselCn>
            <div class="py-2 text-center text-sm text-muted-foreground">
                Slide @(_apiCurrentIndex + 1) of 5
            </div>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Autoplay" Code="@AutoplayCode">
        <div class="mx-auto max-w-[10rem] sm:max-w-xs">
            <CarouselCn @bind-CurrentIndex="_autoplayIndex"
                        Class="w-full max-w-xs"
                        @onmouseenter="StopAutoplay"
                        @onmouseleave="StartAutoplay">
                <CarouselContentCn>
                    @for (var i = 1; i <= 5; i++)
                    {
                        var num = i;
                        <CarouselItemCn>
                            <div class="p-1">
                                <CardCn>
                                    <CardContentCn Class="flex aspect-square items-center justify-center p-6">
                                        <span class="text-4xl font-semibold">@num</span>
                                    </CardContentCn>
                                </CardCn>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <CarouselPreviousCn />
                <CarouselNextCn />
            </CarouselCn>
            <div class="py-2 text-center text-sm text-muted-foreground">
                Slide @(_autoplayIndex + 1) of 5 — @(_autoplayRunning ? "playing" : "paused")
            </div>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div dir="rtl">
            <CarouselCn Class="w-full max-w-[12rem] sm:max-w-xs">
                <CarouselContentCn>
                    @foreach (var num in _arabicNumerals)
                    {
                        <CarouselItemCn>
                            <div class="p-1">
                                <CardCn>
                                    <CardContentCn Class="flex aspect-square items-center justify-center p-6">
                                        <span class="text-4xl font-semibold">@num</span>
                                    </CardContentCn>
                                </CardCn>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <CarouselPreviousCn />
                <CarouselNextCn />
            </CarouselCn>
        </div>
    </ComponentPreview>
</div>

@code {
    private static readonly string[] _arabicNumerals = ["١", "٢", "٣", "٤", "٥"];
    private int _apiCurrentIndex;
    private int _autoplayIndex;
    private bool _autoplayRunning = true;
    private Timer? _autoplayTimer;

    protected override void OnInitialized()
    {
        StartAutoplay();
    }

    private void StartAutoplay()
    {
        _autoplayRunning = true;
        _autoplayTimer?.Dispose();
        _autoplayTimer = new Timer(AutoAdvance, null, 2000, 2000);
    }

    private void StopAutoplay()
    {
        _autoplayRunning = false;
        _autoplayTimer?.Dispose();
        _autoplayTimer = null;
    }

    private async void AutoAdvance(object? state)
    {
        await InvokeAsync(() =>
        {
            _autoplayIndex = (_autoplayIndex + 1) % 5;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _autoplayTimer?.Dispose();
    }

