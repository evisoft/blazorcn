@page "/docs/components/input-group"
@layout DocsLayout

<PageTitle>Input Group — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Input Group</h1>
        <p class="mt-2 text-lg text-muted-foreground">A container that arranges input elements with addons (icons, text, buttons) in a unified visual group.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <InputGroupCn Class="max-w-xs">
            <InputGroupInputCn Placeholder="Search..." />
            <InputGroupAddonCn>
                <LucideSearchCn Size="16" />
            </InputGroupAddonCn>
            <InputGroupAddonCn Align="InputGroupAddonAlign.InlineEnd">12 results</InputGroupAddonCn>
        </InputGroupCn>
    </ComponentPreview>

    <ComponentPreview Title="Basic" Code="@BasicCode">
        <div class="grid w-full max-w-sm gap-6">
            <InputGroupCn>
                <InputGroupInputCn Placeholder="Placeholder" />
            </InputGroupCn>
            <InputGroupCn>
                <InputGroupInputCn Placeholder="This field is disabled" Disabled="true" />
            </InputGroupCn>
            <InputGroupCn>
                <InputGroupInputCn Placeholder="This field is invalid" aria-invalid="true" />
            </InputGroupCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="With Icons" Code="@IconCode">
        <div class="grid w-full max-w-sm gap-6">
            <InputGroupCn>
                <InputGroupInputCn Placeholder="Search..." />
                <InputGroupAddonCn>
                    <LucideSearchCn Size="16" />
                </InputGroupAddonCn>
            </InputGroupCn>
            <InputGroupCn>
                <InputGroupInputCn Type="email" Placeholder="Enter your email" />
                <InputGroupAddonCn>
                    <LucideMailCn Size="16" />
                </InputGroupAddonCn>
            </InputGroupCn>
            <InputGroupCn>
                <InputGroupInputCn Placeholder="Card number" />
                <InputGroupAddonCn>
                    <LucideCreditCardCn Size="16" />
                </InputGroupAddonCn>
                <InputGroupAddonCn Align="InputGroupAddonAlign.InlineEnd">
                    <LucideCheckCn Size="16" />
                </InputGroupAddonCn>
            </InputGroupCn>
            <InputGroupCn>
                <InputGroupInputCn Placeholder="Card number" />
                <InputGroupAddonCn Align="InputGroupAddonAlign.InlineEnd">
                    <LucideStarCn Size="16" />
                    <LucideInfoCn Size="16" />
                </InputGroupAddonCn>
            </InputGroupCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="With Text" Code="@TextCode">
        <div class="grid w-full max-w-sm gap-6">
            <InputGroupCn>
                <InputGroupAddonCn>
                    <InputGroupTextCn>$</InputGroupTextCn>
                </InputGroupAddonCn>
                <InputGroupInputCn Placeholder="0.00" />
                <InputGroupAddonCn Align="InputGroupAddonAlign.InlineEnd">
                    <InputGroupTextCn>USD</InputGroupTextCn>
                </InputGroupAddonCn>
            </InputGroupCn>
            <InputGroupCn>
                <InputGroupAddonCn>
                    <InputGroupTextCn>https://</InputGroupTextCn>
                </InputGroupAddonCn>
                <InputGroupInputCn Placeholder="example.com" Class="pl-0.5!" />
                <InputGroupAddonCn Align="InputGroupAddonAlign.InlineEnd">
                    <InputGroupTextCn>.com</InputGroupTextCn>
                </InputGroupAddonCn>
            </InputGroupCn>
            <InputGroupCn>
                <InputGroupInputCn Placeholder="Enter your username" />
                <InputGroupAddonCn Align="InputGroupAddonAlign.InlineEnd">
                    <InputGroupTextCn>@@company.com</InputGroupTextCn>
                </InputGroupAddonCn>
            </InputGroupCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="With Buttons" Code="@ButtonCode">
        <div class="grid w-full max-w-sm gap-6">
            <InputGroupCn>
                <InputGroupInputCn Placeholder="Enter text..." />
                <InputGroupAddonCn>
                    <InputGroupButtonCn>Default</InputGroupButtonCn>
                </InputGroupAddonCn>
            </InputGroupCn>
            <InputGroupCn>
                <InputGroupInputCn Placeholder="Enter text..." />
                <InputGroupAddonCn>
                    <InputGroupButtonCn Variant="ButtonVariant.Outline">Outline</InputGroupButtonCn>
                </InputGroupAddonCn>
            </InputGroupCn>
            <InputGroupCn>
                <InputGroupInputCn Placeholder="Enter text..." />
                <InputGroupAddonCn>
                    <InputGroupButtonCn Variant="ButtonVariant.Secondary">Secondary</InputGroupButtonCn>
                </InputGroupAddonCn>
            </InputGroupCn>
            <InputGroupCn>
                <InputGroupInputCn Placeholder="Enter text..." />
                <InputGroupAddonCn Align="InputGroupAddonAlign.InlineEnd">
                    <InputGroupButtonCn Variant="ButtonVariant.Secondary">Button</InputGroupButtonCn>
                </InputGroupAddonCn>
            </InputGroupCn>
            <InputGroupCn>
                <InputGroupInputCn Placeholder="Enter text..." />
                <InputGroupAddonCn Align="InputGroupAddonAlign.InlineEnd">
                    <InputGroupButtonCn Size="InputGroupButtonSize.IconXs">
                        <LucideCopyCn Size="14" />
                    </InputGroupButtonCn>
                </InputGroupAddonCn>
            </InputGroupCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Inline Start" Code="@InlineStartCode">
        <div class="w-full max-w-sm">
            <InputGroupCn>
                <InputGroupInputCn Placeholder="Search..." />
                <InputGroupAddonCn Align="InputGroupAddonAlign.InlineStart">
                    <LucideSearchCn Size="16" Class="text-muted-foreground" />
                </InputGroupAddonCn>
            </InputGroupCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Inline End" Code="@InlineEndCode">
        <div class="w-full max-w-sm">
            <InputGroupCn>
                <InputGroupInputCn Type="password" Placeholder="Enter password" />
                <InputGroupAddonCn Align="InputGroupAddonAlign.InlineEnd">
                    <LucideEyeOffCn Size="16" />
                </InputGroupAddonCn>
            </InputGroupCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Block Start" Code="@BlockStartCode">
        <div class="w-full max-w-sm">
            <InputGroupCn Class="h-auto">
                <InputGroupInputCn Placeholder="Enter your name" />
                <InputGroupAddonCn Align="InputGroupAddonAlign.BlockStart">
                    <InputGroupTextCn>Full Name</InputGroupTextCn>
                </InputGroupAddonCn>
            </InputGroupCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Block End" Code="@BlockEndCode">
        <div class="w-full max-w-sm">
            <InputGroupCn Class="h-auto">
                <InputGroupInputCn Placeholder="Enter amount" />
                <InputGroupAddonCn Align="InputGroupAddonAlign.BlockEnd">
                    <InputGroupTextCn>USD</InputGroupTextCn>
                </InputGroupAddonCn>
            </InputGroupCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Textarea" Code="@TextareaCode">
        <div class="w-full max-w-md">
            <InputGroupCn>
                <InputGroupTextareaCn Placeholder="Write a comment..." />
                <InputGroupAddonCn Align="InputGroupAddonAlign.BlockEnd">
                    <InputGroupTextCn>0/280</InputGroupTextCn>
                    <InputGroupButtonCn Variant="ButtonVariant.Default" Size="InputGroupButtonSize.Sm" Class="ml-auto">
                        Post
                    </InputGroupButtonCn>
                </InputGroupAddonCn>
            </InputGroupCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Textarea with Header" Code="@TextareaHeaderCode">
        <div class="w-full max-w-md">
            <InputGroupCn>
                <InputGroupTextareaCn Placeholder="console.log('Hello, world!');" Class="min-h-[200px] font-mono text-sm" />
                <InputGroupAddonCn Align="InputGroupAddonAlign.BlockEnd" Class="border-t">
                    <InputGroupTextCn>Line 1, Column 1</InputGroupTextCn>
                    <InputGroupButtonCn Size="InputGroupButtonSize.Sm" Class="ml-auto" Variant="ButtonVariant.Default">
                        Run
                    </InputGroupButtonCn>
                </InputGroupAddonCn>
                <InputGroupAddonCn Align="InputGroupAddonAlign.BlockStart" Class="border-b">
                    <InputGroupTextCn Class="font-mono font-medium">script.js</InputGroupTextCn>
                    <InputGroupButtonCn Class="ml-auto" Size="InputGroupButtonSize.IconXs">
                        <LucideCopyCn Size="14" />
                    </InputGroupButtonCn>
                </InputGroupAddonCn>
            </InputGroupCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="With Kbd" Code="@KbdCode">
        <div class="w-full max-w-sm">
            <InputGroupCn>
                <InputGroupInputCn Placeholder="Search..." />
                <InputGroupAddonCn>
                    <LucideSearchCn Size="16" Class="text-muted-foreground" />
                </InputGroupAddonCn>
                <InputGroupAddonCn Align="InputGroupAddonAlign.InlineEnd">
                    <KbdCn>&#x2318;K</KbdCn>
                </InputGroupAddonCn>
            </InputGroupCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Multiple Addons" Code="@MultipleAddonsCode">
        <div class="grid w-full max-w-sm gap-6">
            <InputGroupCn>
                <InputGroupInputCn Placeholder="Search..." />
                <InputGroupAddonCn>
                    <LucideSearchCn Size="16" Class="text-muted-foreground" />
                </InputGroupAddonCn>
                <InputGroupAddonCn Align="InputGroupAddonAlign.InlineEnd">12 results</InputGroupAddonCn>
            </InputGroupCn>
            <InputGroupCn>
                <InputGroupInputCn Placeholder="Enter text..." />
                <InputGroupAddonCn Align="InputGroupAddonAlign.InlineEnd">
                    <LucideStarCn Size="16" />
                    <InputGroupButtonCn Size="InputGroupButtonSize.IconXs">
                        <LucideCopyCn Size="14" />
                    </InputGroupButtonCn>
                </InputGroupAddonCn>
            </InputGroupCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Spinner" Code="@SpinnerCode">
        <div class="grid w-full max-w-sm gap-6">
            <InputGroupCn>
                <InputGroupInputCn Placeholder="Searching..." />
                <InputGroupAddonCn Align="InputGroupAddonAlign.InlineEnd">
                    <SpinnerCn />
                </InputGroupAddonCn>
            </InputGroupCn>
            <InputGroupCn>
                <InputGroupInputCn Placeholder="Processing..." />
                <InputGroupAddonCn>
                    <SpinnerCn />
                </InputGroupAddonCn>
            </InputGroupCn>
            <InputGroupCn>
                <InputGroupInputCn Placeholder="Saving changes..." />
                <InputGroupAddonCn Align="InputGroupAddonAlign.InlineEnd">
                    <InputGroupTextCn>Saving...</InputGroupTextCn>
                    <SpinnerCn />
                </InputGroupAddonCn>
            </InputGroupCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Disabled" Code="@DisabledCode">
        <div class="w-full max-w-sm">
            <InputGroupCn data-disabled="true">
                <InputGroupInputCn Placeholder="Search documentation..." Disabled="true" />
                <InputGroupAddonCn>
                    <LucideSearchCn Size="16" />
                </InputGroupAddonCn>
                <InputGroupAddonCn Align="InputGroupAddonAlign.InlineEnd">Disabled</InputGroupAddonCn>
            </InputGroupCn>
        </div>
    </ComponentPreview>
</div>

