@page "/docs/components/item"
@layout DocsLayout

<PageTitle>Item — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Item</h1>
        <p class="mt-2 text-lg text-muted-foreground">A flexible list item component with media, content, and actions.</p>
    </div>

    <SeparatorCn />

    @* 1. item-demo *@
    <ComponentPreview Title="Default" Code="@DemoCode">
        <div class="flex w-full max-w-md flex-col gap-6">
            <ItemCn Variant="ItemVariant.Outline">
                <ItemContentCn>
                    <ItemTitleCn>Basic Item</ItemTitleCn>
                    <ItemDescriptionCn>A simple item with title and description.</ItemDescriptionCn>
                </ItemContentCn>
                <ItemActionsCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">Action</ButtonCn>
                </ItemActionsCn>
            </ItemCn>
            <ItemCn Variant="ItemVariant.Outline" Size="ItemSize.Sm">
                <ItemMediaCn>
                    <LucideIconCn Name="badge-check" Class="size-5" />
                </ItemMediaCn>
                <ItemContentCn>
                    <ItemTitleCn>Your profile has been verified.</ItemTitleCn>
                </ItemContentCn>
                <ItemActionsCn>
                    <LucideIconCn Name="chevron-right" Class="size-4" />
                </ItemActionsCn>
            </ItemCn>
        </div>
    </ComponentPreview>

    @* 2. item-variant *@
    <ComponentPreview Title="Variants" Code="@VariantCode">
        <div class="flex w-full max-w-md flex-col gap-6">
            <ItemCn>
                <ItemMediaCn Variant="ItemMediaVariant.Icon">
                    <LucideIconCn Name="inbox" />
                </ItemMediaCn>
                <ItemContentCn>
                    <ItemTitleCn>Default Variant</ItemTitleCn>
                    <ItemDescriptionCn>Transparent background with no border.</ItemDescriptionCn>
                </ItemContentCn>
            </ItemCn>
            <ItemCn Variant="ItemVariant.Outline">
                <ItemMediaCn Variant="ItemMediaVariant.Icon">
                    <LucideIconCn Name="inbox" />
                </ItemMediaCn>
                <ItemContentCn>
                    <ItemTitleCn>Outline Variant</ItemTitleCn>
                    <ItemDescriptionCn>Outlined style with a visible border.</ItemDescriptionCn>
                </ItemContentCn>
            </ItemCn>
            <ItemCn Variant="ItemVariant.Muted">
                <ItemMediaCn Variant="ItemMediaVariant.Icon">
                    <LucideIconCn Name="inbox" />
                </ItemMediaCn>
                <ItemContentCn>
                    <ItemTitleCn>Muted Variant</ItemTitleCn>
                    <ItemDescriptionCn>Muted background for secondary content.</ItemDescriptionCn>
                </ItemContentCn>
            </ItemCn>
        </div>
    </ComponentPreview>

    @* 3. item-size *@
    <ComponentPreview Title="Sizes" Code="@SizeCode">
        <div class="flex w-full max-w-md flex-col gap-6">
            <ItemCn Variant="ItemVariant.Outline">
                <ItemMediaCn Variant="ItemMediaVariant.Icon">
                    <LucideIconCn Name="inbox" />
                </ItemMediaCn>
                <ItemContentCn>
                    <ItemTitleCn>Default Size</ItemTitleCn>
                    <ItemDescriptionCn>The standard size for most use cases.</ItemDescriptionCn>
                </ItemContentCn>
            </ItemCn>
            <ItemCn Variant="ItemVariant.Outline" Size="ItemSize.Sm">
                <ItemMediaCn Variant="ItemMediaVariant.Icon">
                    <LucideIconCn Name="inbox" />
                </ItemMediaCn>
                <ItemContentCn>
                    <ItemTitleCn>Small Size</ItemTitleCn>
                    <ItemDescriptionCn>A compact size for dense layouts.</ItemDescriptionCn>
                </ItemContentCn>
            </ItemCn>
            <ItemCn Variant="ItemVariant.Outline" Size="ItemSize.Xs">
                <ItemMediaCn Variant="ItemMediaVariant.Icon">
                    <LucideIconCn Name="inbox" />
                </ItemMediaCn>
                <ItemContentCn>
                    <ItemTitleCn>Extra Small Size</ItemTitleCn>
                    <ItemDescriptionCn>The most compact size available.</ItemDescriptionCn>
                </ItemContentCn>
            </ItemCn>
        </div>
    </ComponentPreview>

    @* 4. item-icon *@
    <ComponentPreview Title="Icon" Code="@IconCode">
        <div class="flex w-full max-w-lg flex-col gap-6">
            <ItemCn Variant="ItemVariant.Outline">
                <ItemMediaCn Variant="ItemMediaVariant.Icon">
                    <LucideIconCn Name="shield-alert" />
                </ItemMediaCn>
                <ItemContentCn>
                    <ItemTitleCn>Security Alert</ItemTitleCn>
                    <ItemDescriptionCn>New login detected from unknown device.</ItemDescriptionCn>
                </ItemContentCn>
                <ItemActionsCn>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">Review</ButtonCn>
                </ItemActionsCn>
            </ItemCn>
        </div>
    </ComponentPreview>

    @* 5. item-image *@
    <ComponentPreview Title="Image" Code="@ImageCode">
        <div class="flex w-full max-w-md flex-col gap-6">
            <ItemGroupCn Class="gap-4">
                @foreach (var song in _music)
                {
                    <ItemCn Variant="ItemVariant.Outline" role="listitem">
                        <ItemMediaCn Variant="ItemMediaVariant.Image">
                            <img src="@($"https://avatar.vercel.sh/{song.Title}")" alt="@song.Title" class="object-cover grayscale" />
                        </ItemMediaCn>
                        <ItemContentCn>
                            <ItemTitleCn Class="line-clamp-1">
                                @song.Title — <span class="text-muted-foreground">@song.Album</span>
                            </ItemTitleCn>
                            <ItemDescriptionCn>@song.Artist</ItemDescriptionCn>
                        </ItemContentCn>
                        <ItemContentCn Class="flex-none text-center">
                            <ItemDescriptionCn>@song.Duration</ItemDescriptionCn>
                        </ItemContentCn>
                    </ItemCn>
                }
            </ItemGroupCn>
        </div>
    </ComponentPreview>

    @* 6. item-avatar *@
    <ComponentPreview Title="Avatar" Code="@AvatarCode">
        <div class="flex w-full max-w-lg flex-col gap-6">
            <ItemCn Variant="ItemVariant.Outline">
                <ItemMediaCn>
                    <AvatarCn Class="size-10">
                        <AvatarImageCn Src="https://github.com/evilrabbit.png" />
                        <AvatarFallbackCn>ER</AvatarFallbackCn>
                    </AvatarCn>
                </ItemMediaCn>
                <ItemContentCn>
                    <ItemTitleCn>Evil Rabbit</ItemTitleCn>
                    <ItemDescriptionCn>Last seen 5 months ago</ItemDescriptionCn>
                </ItemContentCn>
                <ItemActionsCn>
                    <ButtonCn Size="ButtonSize.IconSm" Variant="ButtonVariant.Outline" Class="rounded-full" aria-label="Invite">
                        <LucideIconCn Name="plus" />
                    </ButtonCn>
                </ItemActionsCn>
            </ItemCn>
            <ItemCn Variant="ItemVariant.Outline">
                <ItemMediaCn>
                    <div class="flex -space-x-2 *:data-[slot=avatar]:ring-2 *:data-[slot=avatar]:ring-background *:data-[slot=avatar]:grayscale">
                        <AvatarCn Class="hidden sm:flex">
                            <AvatarImageCn Src="https://github.com/shadcn.png" Alt="shadcn" />
                            <AvatarFallbackCn>CN</AvatarFallbackCn>
                        </AvatarCn>
                        <AvatarCn Class="hidden sm:flex">
                            <AvatarImageCn Src="https://github.com/maxleiter.png" Alt="maxleiter" />
                            <AvatarFallbackCn>LR</AvatarFallbackCn>
                        </AvatarCn>
                        <AvatarCn>
                            <AvatarImageCn Src="https://github.com/evilrabbit.png" Alt="evilrabbit" />
                            <AvatarFallbackCn>ER</AvatarFallbackCn>
                        </AvatarCn>
                    </div>
                </ItemMediaCn>
                <ItemContentCn>
                    <ItemTitleCn>No Team Members</ItemTitleCn>
                    <ItemDescriptionCn>Invite your team to collaborate on this project.</ItemDescriptionCn>
                </ItemContentCn>
                <ItemActionsCn>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">Invite</ButtonCn>
                </ItemActionsCn>
            </ItemCn>
        </div>
    </ComponentPreview>

    @* 7. item-link *@
    <ComponentPreview Title="Link" Code="@LinkCode">
        <div class="flex w-full max-w-md flex-col gap-4">
            <a href="#">
                <ItemCn>
                    <ItemContentCn>
                        <ItemTitleCn>Visit our documentation</ItemTitleCn>
                        <ItemDescriptionCn>Learn how to get started with our components.</ItemDescriptionCn>
                    </ItemContentCn>
                    <ItemActionsCn>
                        <LucideIconCn Name="chevron-right" Class="size-4" />
                    </ItemActionsCn>
                </ItemCn>
            </a>
            <a href="#" target="_blank" rel="noopener noreferrer">
                <ItemCn Variant="ItemVariant.Outline">
                    <ItemContentCn>
                        <ItemTitleCn>External resource</ItemTitleCn>
                        <ItemDescriptionCn>Opens in a new tab with security attributes.</ItemDescriptionCn>
                    </ItemContentCn>
                    <ItemActionsCn>
                        <LucideIconCn Name="external-link" Class="size-4" />
                    </ItemActionsCn>
                </ItemCn>
            </a>
        </div>
    </ComponentPreview>

    @* 8. item-group *@
    <ComponentPreview Title="Group" Code="@GroupCode">
        <ItemGroupCn Class="max-w-sm">
            @foreach (var person in _people)
            {
                <ItemCn Variant="ItemVariant.Outline">
                    <ItemMediaCn>
                        <AvatarCn>
                            <AvatarImageCn Src="@person.Avatar" Class="grayscale" />
                            <AvatarFallbackCn>@person.Username[..1].ToUpperInvariant()</AvatarFallbackCn>
                        </AvatarCn>
                    </ItemMediaCn>
                    <ItemContentCn Class="gap-1">
                        <ItemTitleCn>@person.Username</ItemTitleCn>
                        <ItemDescriptionCn>@person.Email</ItemDescriptionCn>
                    </ItemContentCn>
                    <ItemActionsCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="rounded-full">
                            <LucideIconCn Name="plus" />
                        </ButtonCn>
                    </ItemActionsCn>
                </ItemCn>
            }
        </ItemGroupCn>
    </ComponentPreview>

    @* 9. item-header *@
    <ComponentPreview Title="Header" Code="@HeaderCode">
        <div class="flex w-full max-w-xl flex-col gap-6">
            <ItemGroupCn Class="grid grid-cols-3 gap-4">
                @foreach (var model in _models)
                {
                    <ItemCn Variant="ItemVariant.Outline">
                        <ItemHeaderCn>
                            <img src="@model.Image" alt="@model.Name"
                                 class="aspect-square w-full rounded-sm object-cover" />
                        </ItemHeaderCn>
                        <ItemContentCn>
                            <ItemTitleCn>@model.Name</ItemTitleCn>
                            <ItemDescriptionCn>@model.Description</ItemDescriptionCn>
                        </ItemContentCn>
                    </ItemCn>
                }
            </ItemGroupCn>
        </div>
    </ComponentPreview>

    @* 10. item-dropdown *@
    <ComponentPreview Title="Dropdown" Code="@DropdownCode">
        <DropdownMenuCn>
            <DropdownMenuTriggerCn>
                <ButtonCn Variant="ButtonVariant.Outline">
                    Select <LucideIconCn Name="chevron-down" />
                </ButtonCn>
            </DropdownMenuTriggerCn>
            <DropdownMenuContentCn Class="w-48" Align="FloatingAlign.End">
                <DropdownMenuGroupCn>
                    @foreach (var person in _people)
                    {
                        <DropdownMenuItemCn>
                            <ItemCn Size="ItemSize.Xs" Class="w-full p-2">
                                <ItemMediaCn>
                                    <AvatarCn Class="size-6">
                                        <AvatarImageCn Src="@person.Avatar" Class="grayscale" />
                                        <AvatarFallbackCn>@person.Username[..1].ToUpperInvariant()</AvatarFallbackCn>
                                    </AvatarCn>
                                </ItemMediaCn>
                                <ItemContentCn Class="gap-0">
                                    <ItemTitleCn>@person.Username</ItemTitleCn>
                                    <ItemDescriptionCn Class="leading-none">@person.Email</ItemDescriptionCn>
                                </ItemContentCn>
                            </ItemCn>
                        </DropdownMenuItemCn>
                    }
                </DropdownMenuGroupCn>
            </DropdownMenuContentCn>
        </DropdownMenuCn>
    </ComponentPreview>

    @* 11. muted-item-group *@
    <ComponentPreview Title="Muted Group" Code="@MutedGroupCode">
        <ItemGroupCn>
            <ItemCn Variant="ItemVariant.Muted">
                <ItemContentCn>
                    <ItemTitleCn>Item 1</ItemTitleCn>
                    <ItemDescriptionCn>First item in muted group.</ItemDescriptionCn>
                </ItemContentCn>
                <ItemActionsCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">Action</ButtonCn>
                </ItemActionsCn>
            </ItemCn>
            <ItemCn Variant="ItemVariant.Muted">
                <ItemContentCn>
                    <ItemTitleCn>Item 2</ItemTitleCn>
                    <ItemDescriptionCn>Second item in muted group.</ItemDescriptionCn>
                </ItemContentCn>
                <ItemActionsCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">Action</ButtonCn>
                </ItemActionsCn>
            </ItemCn>
            <ItemCn Variant="ItemVariant.Muted">
                <ItemContentCn>
                    <ItemTitleCn>Item 3</ItemTitleCn>
                    <ItemDescriptionCn>Third item in muted group.</ItemDescriptionCn>
                </ItemContentCn>
                <ItemActionsCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">Action</ButtonCn>
                </ItemActionsCn>
            </ItemCn>
        </ItemGroupCn>
    </ComponentPreview>

    @* 12. outline-item-group *@
    <ComponentPreview Title="Outline Group" Code="@OutlineGroupCode">
        <ItemGroupCn>
            <ItemCn Variant="ItemVariant.Outline">
                <ItemMediaCn Variant="ItemMediaVariant.Icon">
                    <LucideIconCn Name="inbox" />
                </ItemMediaCn>
                <ItemContentCn>
                    <ItemTitleCn>Item 1</ItemTitleCn>
                    <ItemDescriptionCn>First item with icon.</ItemDescriptionCn>
                </ItemContentCn>
            </ItemCn>
            <ItemCn Variant="ItemVariant.Outline">
                <ItemMediaCn Variant="ItemMediaVariant.Icon">
                    <LucideIconCn Name="inbox" />
                </ItemMediaCn>
                <ItemContentCn>
                    <ItemTitleCn>Item 2</ItemTitleCn>
                    <ItemDescriptionCn>Second item with icon.</ItemDescriptionCn>
                </ItemContentCn>
            </ItemCn>
            <ItemCn Variant="ItemVariant.Outline">
                <ItemMediaCn Variant="ItemMediaVariant.Icon">
                    <LucideIconCn Name="inbox" />
                </ItemMediaCn>
                <ItemContentCn>
                    <ItemTitleCn>Item 3</ItemTitleCn>
                    <ItemDescriptionCn>Third item with icon.</ItemDescriptionCn>
                </ItemContentCn>
            </ItemCn>
        </ItemGroupCn>
    </ComponentPreview>

    @* 13. item-rtl *@
    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div class="flex w-full max-w-md flex-col gap-6" dir="rtl">
            <ItemCn Variant="ItemVariant.Outline" dir="rtl">
                <ItemContentCn>
                    <ItemTitleCn>عنصر أساسي</ItemTitleCn>
                    <ItemDescriptionCn>عنصر بسيط يحتوي على عنوان ووصف.</ItemDescriptionCn>
                </ItemContentCn>
                <ItemActionsCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">إجراء</ButtonCn>
                </ItemActionsCn>
            </ItemCn>
            <ItemCn Variant="ItemVariant.Outline" Size="ItemSize.Sm" dir="rtl">
                <ItemMediaCn>
                    <LucideIconCn Name="badge-check" Class="size-5" />
                </ItemMediaCn>
                <ItemContentCn>
                    <ItemTitleCn>تم التحقق من ملفك الشخصي.</ItemTitleCn>
                </ItemContentCn>
                <ItemActionsCn>
                    <LucideIconCn Name="chevron-right" Class="size-4" />
                </ItemActionsCn>
            </ItemCn>
        </div>
    </ComponentPreview>
</div>

