@page "/docs/components/button"
@layout DocsLayout

<PageTitle>Button — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Button</h1>
        <p class="mt-2 text-lg text-muted-foreground">Displays a button or a component that looks like a button.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <div class="flex flex-wrap items-center gap-2 md:flex-row">
            <ButtonCn Variant="ButtonVariant.Outline">Button</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" aria-label="Submit">
                <LucideArrowUpCn Size="16" />
            </ButtonCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Default" Code="@DefaultCode">
        <ButtonCn>Button</ButtonCn>
    </ComponentPreview>

    <ComponentPreview Title="Secondary" Code="@SecondaryCode">
        <ButtonCn Variant="ButtonVariant.Secondary">Secondary</ButtonCn>
    </ComponentPreview>

    <ComponentPreview Title="Destructive" Code="@DestructiveCode">
        <ButtonCn Variant="ButtonVariant.Destructive">Destructive</ButtonCn>
    </ComponentPreview>

    <ComponentPreview Title="Outline" Code="@OutlineCode">
        <ButtonCn Variant="ButtonVariant.Outline">Outline</ButtonCn>
    </ComponentPreview>

    <ComponentPreview Title="Ghost" Code="@GhostCode">
        <ButtonCn Variant="ButtonVariant.Ghost">Ghost</ButtonCn>
    </ComponentPreview>

    <ComponentPreview Title="Link" Code="@LinkCode">
        <ButtonCn Variant="ButtonVariant.Link">Link</ButtonCn>
    </ComponentPreview>

    <ComponentPreview Title="Icon" Code="@IconCode">
        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon">
            <LucideCircleFadingArrowUpCn Size="16" />
        </ButtonCn>
    </ComponentPreview>

    <ComponentPreview Title="With Icon" Code="@WithIconCode">
        <div class="flex gap-2">
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideGitBranchCn Size="16" data-icon="inline-start" />
                New Branch
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                Fork
                <LucideGitForkCn Size="16" data-icon="inline-end" />
            </ButtonCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Rounded" Code="@RoundedCode">
        <div class="flex gap-2">
            <ButtonCn Class="rounded-full">Get Started</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="rounded-full">
                <LucideArrowUpCn Size="16" />
            </ButtonCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Sizes" Code="@SizesCode">
        <div class="flex flex-col items-start gap-8 sm:flex-row">
            <div class="flex items-start gap-2">
                <ButtonCn Size="ButtonSize.Xs" Variant="ButtonVariant.Outline">Extra Small</ButtonCn>
                <ButtonCn Size="ButtonSize.IconXs" aria-label="Submit" Variant="ButtonVariant.Outline">
                    <LucideArrowUpRightCn Size="12" />
                </ButtonCn>
            </div>
            <div class="flex items-start gap-2">
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">Small</ButtonCn>
                <ButtonCn Size="ButtonSize.IconSm" aria-label="Submit" Variant="ButtonVariant.Outline">
                    <LucideArrowUpRightCn Size="14" />
                </ButtonCn>
            </div>
            <div class="flex items-start gap-2">
                <ButtonCn Variant="ButtonVariant.Outline">Default</ButtonCn>
                <ButtonCn Size="ButtonSize.Icon" aria-label="Submit" Variant="ButtonVariant.Outline">
                    <LucideArrowUpRightCn Size="16" />
                </ButtonCn>
            </div>
            <div class="flex items-start gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Lg">Large</ButtonCn>
                <ButtonCn Size="ButtonSize.IconLg" aria-label="Submit" Variant="ButtonVariant.Outline">
                    <LucideArrowUpRightCn Size="16" />
                </ButtonCn>
            </div>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Loading" Code="@LoadingCode">
        <div class="flex gap-2">
            <ButtonCn Variant="ButtonVariant.Outline" Disabled="true">
                <SpinnerCn Class="size-4" data-icon="inline-start" />
                Generating
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Secondary" Disabled="true">
                Downloading
                <SpinnerCn Class="size-4" data-icon="inline-start" />
            </ButtonCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div class="flex flex-wrap items-center gap-2 md:flex-row" dir="rtl">
            <ButtonCn Variant="ButtonVariant.Outline">زر</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Destructive">حذف</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                إرسال
                <LucideArrowRightCn Size="16" Class="rtl:rotate-180" data-icon="inline-end" />
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" aria-label="Add">
                <LucidePlusCn Size="16" />
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Secondary" Disabled="true">
                <SpinnerCn Class="size-4" data-icon="inline-start" />
                جاري التحميل
            </ButtonCn>
        </div>
    </ComponentPreview>
</div>

