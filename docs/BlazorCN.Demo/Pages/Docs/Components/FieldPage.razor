@page "/docs/components/field"
@layout DocsLayout

<PageTitle>Field — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Field</h1>
        <p class="mt-2 text-lg text-muted-foreground">Layout components for grouping form controls with labels, descriptions, and errors.</p>
    </div>

    <SeparatorCn />

    @* 1. Demo (checkout form) *@
    <ComponentPreview Title="Demo" Code="@DemoCode">
        <div class="w-full max-w-md">
            <FieldGroupCn>
                <FieldSetCn>
                    <FieldLegendCn>Payment Method</FieldLegendCn>
                    <FieldDescriptionCn>All transactions are secure and encrypted</FieldDescriptionCn>
                    <FieldGroupCn>
                        <FieldCn>
                            <FieldLabelCn For="card-name">Name on Card</FieldLabelCn>
                            <InputCn id="card-name" Placeholder="Evil Rabbit" />
                        </FieldCn>
                        <FieldCn>
                            <FieldLabelCn For="card-number">Card Number</FieldLabelCn>
                            <InputCn id="card-number" Placeholder="1234 5678 9012 3456" />
                            <FieldDescriptionCn>Enter your 16-digit card number</FieldDescriptionCn>
                        </FieldCn>
                        <div class="grid grid-cols-3 gap-4">
                            <FieldCn>
                                <FieldLabelCn For="exp-month">Month</FieldLabelCn>
                                <SelectCn>
                                    <SelectTriggerCn id="exp-month">
                                        <SelectValueCn Placeholder="MM" />
                                    </SelectTriggerCn>
                                    <SelectContentCn>
                                        <SelectGroupCn>
                                            @for (var m = 1; m <= 12; m++)
                                            {
                                                var val = m.ToString("D2");
                                                <SelectItemCn Value="@val">@val</SelectItemCn>
                                            }
                                        </SelectGroupCn>
                                    </SelectContentCn>
                                </SelectCn>
                            </FieldCn>
                            <FieldCn>
                                <FieldLabelCn For="exp-year">Year</FieldLabelCn>
                                <SelectCn>
                                    <SelectTriggerCn id="exp-year">
                                        <SelectValueCn Placeholder="YYYY" />
                                    </SelectTriggerCn>
                                    <SelectContentCn>
                                        <SelectGroupCn>
                                            @for (var y = 2024; y <= 2029; y++)
                                            {
                                                var val = y.ToString();
                                                <SelectItemCn Value="@val">@val</SelectItemCn>
                                            }
                                        </SelectGroupCn>
                                    </SelectContentCn>
                                </SelectCn>
                            </FieldCn>
                            <FieldCn>
                                <FieldLabelCn For="cvv">CVV</FieldLabelCn>
                                <InputCn id="cvv" Placeholder="123" />
                            </FieldCn>
                        </div>
                    </FieldGroupCn>
                </FieldSetCn>
                <FieldSeparatorCn />
                <FieldSetCn>
                    <FieldLegendCn>Billing Address</FieldLegendCn>
                    <FieldDescriptionCn>The billing address associated with your payment method</FieldDescriptionCn>
                    <FieldGroupCn>
                        <FieldCn Orientation="FieldOrientation.Horizontal">
                            <CheckboxCn id="same-shipping" Checked="true" />
                            <FieldLabelCn For="same-shipping" Class="font-normal">Same as shipping address</FieldLabelCn>
                        </FieldCn>
                    </FieldGroupCn>
                </FieldSetCn>
                <FieldSetCn>
                    <FieldGroupCn>
                        <FieldCn>
                            <FieldLabelCn For="comments">Comments</FieldLabelCn>
                            <TextareaCn id="comments" Placeholder="Add any additional comments" Class="resize-none" />
                        </FieldCn>
                    </FieldGroupCn>
                </FieldSetCn>
                <FieldCn Orientation="FieldOrientation.Horizontal">
                    <ButtonCn Type="submit">Submit</ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Type="button">Cancel</ButtonCn>
                </FieldCn>
            </FieldGroupCn>
        </div>
    </ComponentPreview>

    @* 2. Input *@
    <ComponentPreview Title="Input" Code="@InputCode">
        <FieldSetCn Class="w-full max-w-xs">
            <FieldGroupCn>
                <FieldCn>
                    <FieldLabelCn For="username">Username</FieldLabelCn>
                    <InputCn id="username" Type="text" Placeholder="Max Leiter" />
                    <FieldDescriptionCn>Choose a unique username for your account.</FieldDescriptionCn>
                </FieldCn>
                <FieldCn>
                    <FieldLabelCn For="password">Password</FieldLabelCn>
                    <FieldDescriptionCn>Must be at least 8 characters long.</FieldDescriptionCn>
                    <InputCn id="password" Type="password" Placeholder="••••••••" />
                </FieldCn>
            </FieldGroupCn>
        </FieldSetCn>
    </ComponentPreview>

    @* 3. Textarea *@
    <ComponentPreview Title="Textarea" Code="@TextareaCode">
        <FieldSetCn Class="w-full max-w-xs">
            <FieldGroupCn>
                <FieldCn>
                    <FieldLabelCn For="feedback">Feedback</FieldLabelCn>
                    <TextareaCn id="feedback" Placeholder="Your feedback helps us improve..." />
                    <FieldDescriptionCn>Share your thoughts about our service.</FieldDescriptionCn>
                </FieldCn>
            </FieldGroupCn>
        </FieldSetCn>
    </ComponentPreview>

    @* 4. Select *@
    <ComponentPreview Title="Select" Code="@SelectCode">
        <FieldCn Class="w-full max-w-xs">
            <FieldLabelCn>Department</FieldLabelCn>
            <SelectCn>
                <SelectTriggerCn>
                    <SelectValueCn Placeholder="Choose department" />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectGroupCn>
                        <SelectItemCn Value="engineering">Engineering</SelectItemCn>
                        <SelectItemCn Value="design">Design</SelectItemCn>
                        <SelectItemCn Value="marketing">Marketing</SelectItemCn>
                        <SelectItemCn Value="sales">Sales</SelectItemCn>
                        <SelectItemCn Value="support">Customer Support</SelectItemCn>
                        <SelectItemCn Value="hr">Human Resources</SelectItemCn>
                        <SelectItemCn Value="finance">Finance</SelectItemCn>
                        <SelectItemCn Value="operations">Operations</SelectItemCn>
                    </SelectGroupCn>
                </SelectContentCn>
            </SelectCn>
            <FieldDescriptionCn>Select your department or area of work.</FieldDescriptionCn>
        </FieldCn>
    </ComponentPreview>

    @* 5. Checkbox *@
    <ComponentPreview Title="Checkbox" Code="@CheckboxCode">
        <FieldGroupCn Class="w-full max-w-xs">
            <FieldSetCn>
                <FieldLegendCn Variant="FieldLegendVariant.Label">Show these items on the desktop</FieldLegendCn>
                <FieldDescriptionCn>Select the items you want to show on the desktop.</FieldDescriptionCn>
                <FieldGroupCn Class="gap-3">
                    <FieldCn Orientation="FieldOrientation.Horizontal">
                        <CheckboxCn id="hard-disks" />
                        <FieldLabelCn For="hard-disks" Class="font-normal">Hard disks</FieldLabelCn>
                    </FieldCn>
                    <FieldCn Orientation="FieldOrientation.Horizontal">
                        <CheckboxCn id="external-disks" />
                        <FieldLabelCn For="external-disks" Class="font-normal">External disks</FieldLabelCn>
                    </FieldCn>
                    <FieldCn Orientation="FieldOrientation.Horizontal">
                        <CheckboxCn id="cds-dvds" />
                        <FieldLabelCn For="cds-dvds" Class="font-normal">CDs, DVDs, and iPods</FieldLabelCn>
                    </FieldCn>
                    <FieldCn Orientation="FieldOrientation.Horizontal">
                        <CheckboxCn id="connected-servers" />
                        <FieldLabelCn For="connected-servers" Class="font-normal">Connected servers</FieldLabelCn>
                    </FieldCn>
                </FieldGroupCn>
            </FieldSetCn>
            <FieldSeparatorCn />
            <FieldCn Orientation="FieldOrientation.Horizontal">
                <CheckboxCn id="sync-folders" Checked="true" />
                <FieldContentCn>
                    <FieldLabelCn For="sync-folders">Sync Desktop &amp; Documents folders</FieldLabelCn>
                    <FieldDescriptionCn>Your Desktop &amp; Documents folders are being synced with iCloud Drive. You can access them from other devices.</FieldDescriptionCn>
                </FieldContentCn>
            </FieldCn>
        </FieldGroupCn>
    </ComponentPreview>

    @* 6. Radio *@
    <ComponentPreview Title="Radio" Code="@RadioCode">
        <FieldSetCn Class="w-full max-w-xs">
            <FieldLegendCn Variant="FieldLegendVariant.Label">Subscription Plan</FieldLegendCn>
            <FieldDescriptionCn>Yearly and lifetime plans offer significant savings.</FieldDescriptionCn>
            <RadioGroupCn Value="monthly">
                <FieldCn Orientation="FieldOrientation.Horizontal">
                    <RadioGroupItemCn Value="monthly" id="plan-monthly" />
                    <FieldLabelCn For="plan-monthly" Class="font-normal">Monthly ($9.99/month)</FieldLabelCn>
                </FieldCn>
                <FieldCn Orientation="FieldOrientation.Horizontal">
                    <RadioGroupItemCn Value="yearly" id="plan-yearly" />
                    <FieldLabelCn For="plan-yearly" Class="font-normal">Yearly ($99.99/year)</FieldLabelCn>
                </FieldCn>
                <FieldCn Orientation="FieldOrientation.Horizontal">
                    <RadioGroupItemCn Value="lifetime" id="plan-lifetime" />
                    <FieldLabelCn For="plan-lifetime" Class="font-normal">Lifetime ($299.99)</FieldLabelCn>
                </FieldCn>
            </RadioGroupCn>
        </FieldSetCn>
    </ComponentPreview>

    @* 7. Switch *@
    <ComponentPreview Title="Switch" Code="@SwitchCode">
        <FieldCn Orientation="FieldOrientation.Horizontal" Class="w-fit">
            <FieldLabelCn For="2fa">Multi-factor authentication</FieldLabelCn>
            <SwitchCn id="2fa" />
        </FieldCn>
    </ComponentPreview>

    @* 8. Slider *@
    <ComponentPreview Title="Slider" Code="@SliderCode">
        <FieldCn Class="w-full max-w-xs">
            <FieldTitleCn>Price Range</FieldTitleCn>
            <FieldDescriptionCn>Set your budget range ($@_sliderValue).</FieldDescriptionCn>
            <SliderCn @bind-Value="_sliderValue" Min="0" Max="1000" Step="10" Class="mt-2 w-full" />
        </FieldCn>
    </ComponentPreview>

    @* 9. Choice Card *@
    <ComponentPreview Title="Choice Card" Code="@ChoiceCardCode">
        <FieldGroupCn Class="w-full max-w-xs">
            <FieldSetCn>
                <FieldLegendCn Variant="FieldLegendVariant.Label">Compute Environment</FieldLegendCn>
                <FieldDescriptionCn>Select the compute environment for your cluster.</FieldDescriptionCn>
                <RadioGroupCn Value="kubernetes">
                    <FieldLabelCn For="kubernetes">
                        <FieldCn Orientation="FieldOrientation.Horizontal">
                            <FieldContentCn>
                                <FieldTitleCn>Kubernetes</FieldTitleCn>
                                <FieldDescriptionCn>Run GPU workloads on a K8s cluster.</FieldDescriptionCn>
                            </FieldContentCn>
                            <RadioGroupItemCn Value="kubernetes" id="kubernetes" />
                        </FieldCn>
                    </FieldLabelCn>
                    <FieldLabelCn For="vm">
                        <FieldCn Orientation="FieldOrientation.Horizontal">
                            <FieldContentCn>
                                <FieldTitleCn>Virtual Machine</FieldTitleCn>
                                <FieldDescriptionCn>Access a cluster to run GPU workloads.</FieldDescriptionCn>
                            </FieldContentCn>
                            <RadioGroupItemCn Value="vm" id="vm" />
                        </FieldCn>
                    </FieldLabelCn>
                </RadioGroupCn>
            </FieldSetCn>
        </FieldGroupCn>
    </ComponentPreview>

    @* 10. Fieldset *@
    <ComponentPreview Title="Fieldset" Code="@FieldsetCode">
        <FieldSetCn Class="w-full max-w-sm">
            <FieldLegendCn>Address Information</FieldLegendCn>
            <FieldDescriptionCn>We need your address to deliver your order.</FieldDescriptionCn>
            <FieldGroupCn>
                <FieldCn>
                    <FieldLabelCn For="street">Street Address</FieldLabelCn>
                    <InputCn id="street" Type="text" Placeholder="123 Main St" />
                </FieldCn>
                <div class="grid grid-cols-2 gap-4">
                    <FieldCn>
                        <FieldLabelCn For="city">City</FieldLabelCn>
                        <InputCn id="city" Type="text" Placeholder="New York" />
                    </FieldCn>
                    <FieldCn>
                        <FieldLabelCn For="zip">Postal Code</FieldLabelCn>
                        <InputCn id="zip" Type="text" Placeholder="90502" />
                    </FieldCn>
                </div>
            </FieldGroupCn>
        </FieldSetCn>
    </ComponentPreview>

    @* 11. Group *@
    <ComponentPreview Title="Group" Code="@GroupCode">
        <FieldGroupCn Class="w-full max-w-xs">
            <FieldSetCn>
                <FieldLabelCn>Responses</FieldLabelCn>
                <FieldDescriptionCn>Get notified when ChatGPT responds to requests that take time, like research or image generation.</FieldDescriptionCn>
                <FieldGroupCn data-slot="checkbox-group">
                    <FieldCn Orientation="FieldOrientation.Horizontal">
                        <CheckboxCn id="push" Checked="true" Disabled="true" />
                        <FieldLabelCn For="push" Class="font-normal">Push notifications</FieldLabelCn>
                    </FieldCn>
                </FieldGroupCn>
            </FieldSetCn>
            <FieldSeparatorCn />
            <FieldSetCn>
                <FieldLabelCn>Tasks</FieldLabelCn>
                <FieldDescriptionCn>Get notified when tasks you've created have updates.</FieldDescriptionCn>
                <FieldGroupCn data-slot="checkbox-group">
                    <FieldCn Orientation="FieldOrientation.Horizontal">
                        <CheckboxCn id="push-tasks" />
                        <FieldLabelCn For="push-tasks" Class="font-normal">Push notifications</FieldLabelCn>
                    </FieldCn>
                    <FieldCn Orientation="FieldOrientation.Horizontal">
                        <CheckboxCn id="email-tasks" />
                        <FieldLabelCn For="email-tasks" Class="font-normal">Email notifications</FieldLabelCn>
                    </FieldCn>
                </FieldGroupCn>
            </FieldSetCn>
        </FieldGroupCn>
    </ComponentPreview>

    @* 12. Responsive *@
    <ComponentPreview Title="Responsive" Code="@ResponsiveCode">
        <div class="w-full max-w-lg">
            <FieldSetCn>
                <FieldLegendCn>Profile</FieldLegendCn>
                <FieldDescriptionCn>Fill in your profile information.</FieldDescriptionCn>
                <FieldGroupCn>
                    <FieldCn Orientation="FieldOrientation.Responsive">
                        <FieldContentCn>
                            <FieldLabelCn For="name">Name</FieldLabelCn>
                            <FieldDescriptionCn>Provide your full name for identification</FieldDescriptionCn>
                        </FieldContentCn>
                        <InputCn id="name" Placeholder="Evil Rabbit" />
                    </FieldCn>
                    <FieldCn Orientation="FieldOrientation.Responsive">
                        <ButtonCn Type="submit">Submit</ButtonCn>
                        <ButtonCn Type="button" Variant="ButtonVariant.Outline">Cancel</ButtonCn>
                    </FieldCn>
                </FieldGroupCn>
            </FieldSetCn>
        </div>
    </ComponentPreview>

    @* 13. Error *@
    <ComponentPreview Title="Error" Code="@ErrorCode">
        <FieldCn Class="w-full max-w-xs" data-invalid="true">
            <FieldLabelCn For="email-err">Email</FieldLabelCn>
            <InputCn id="email-err" Type="email" Placeholder="you@example.com" aria-invalid="true" />
            <FieldErrorCn>Please enter a valid email address.</FieldErrorCn>
        </FieldCn>
    </ComponentPreview>
</div>

