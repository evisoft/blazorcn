@page "/docs/components/chart"
@layout DocsLayout

<PageTitle>Chart — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Chart</h1>
        <p class="mt-2 text-lg text-muted-foreground">Beautiful charts. Built using a charting library of your choice inside ChartCn containers.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <CardCn Class="w-full max-w-2xl py-0 pb-4">
            <CardHeaderCn Class="flex flex-col items-stretch border-b p-0 sm:flex-row">
                <div class="flex flex-1 flex-col justify-center gap-1 px-6 pt-4 pb-3">
                    <CardTitleCn>Bar Chart - Interactive</CardTitleCn>
                    <CardDescriptionCn>Showing total visitors for the last 3 months</CardDescriptionCn>
                </div>
                <div class="flex">
                    <button class="@Cn.Merge("relative z-30 flex flex-1 flex-col justify-center gap-1 border-t px-6 py-4 text-left even:border-l sm:border-t-0 sm:border-l sm:px-8 sm:py-6", _activeChart == "desktop" ? "bg-muted/50" : "")"
                            @onclick="@(() => _activeChart = "desktop")">
                        <span class="text-xs text-muted-foreground">Desktop</span>
                        <span class="text-lg leading-none font-bold sm:text-3xl">7,405</span>
                    </button>
                    <button class="@Cn.Merge("relative z-30 flex flex-1 flex-col justify-center gap-1 border-t px-6 py-4 text-left even:border-l sm:border-t-0 sm:border-l sm:px-8 sm:py-6", _activeChart == "mobile" ? "bg-muted/50" : "")"
                            @onclick="@(() => _activeChart = "mobile")">
                        <span class="text-xs text-muted-foreground">Mobile</span>
                        <span class="text-lg leading-none font-bold sm:text-3xl">6,780</span>
                    </button>
                </div>
            </CardHeaderCn>
            <CardContentCn Class="px-2 sm:p-6">
                <ChartCn Class="aspect-auto h-[250px] w-full">
                    <div class="flex items-end gap-[2px] h-full w-full">
                        @foreach (var item in _chartData)
                        {
                            var value = _activeChart == "desktop" ? item.Desktop : item.Mobile;
                            var maxVal = _activeChart == "desktop" ? 454 : 420;
                            var pct = (int)(value * 100.0 / maxVal);
                            <div class="flex-1 rounded-t transition-all"
                                 style="@($"height: {pct}%; background-color: var(--chart-{(_activeChart == "desktop" ? "2" : "1")})")"
                                 title="@($"{item.Date:MMM d}: {value}")">
                            </div>
                        }
                    </div>
                </ChartCn>
            </CardContentCn>
        </CardCn>
    </ComponentPreview>

    <ComponentPreview Title="Chart Container" Code="@ContainerCode">
        <ChartContainerCn Class="h-[200px] w-full max-w-md">
            <ChartCn Class="h-full w-full">
                <div class="flex items-end gap-2 h-full">
                    @foreach (var item in _monthlyData)
                    {
                        <div class="flex flex-col items-center gap-1 flex-1">
                            <div class="flex items-end gap-0.5 w-full h-[160px]">
                                <div class="flex-1 rounded-t" style="@($"height: {(int)(item.Desktop * 100.0 / 305)}%; background-color: #2563eb")"></div>
                                <div class="flex-1 rounded-t" style="@($"height: {(int)(item.Mobile * 100.0 / 200)}%; background-color: #60a5fa")"></div>
                            </div>
                            <span class="text-xs text-muted-foreground">@item.Month[..3]</span>
                        </div>
                    }
                </div>
            </ChartCn>
        </ChartContainerCn>
    </ComponentPreview>

    <ComponentPreview Title="With Grid" Code="@GridCode">
        <ChartCn Class="min-h-[200px] w-full max-w-md">
            <div class="relative h-[200px] w-full">
                @* Horizontal grid lines *@
                @for (var i = 0; i < 5; i++)
                {
                    <div class="absolute left-0 right-0 border-t border-border/40" style="@($"bottom: {i * 25}%")"></div>
                }
                <div class="flex items-end gap-2 h-full relative z-10">
                    @foreach (var item in _monthlyData)
                    {
                        <div class="flex items-end gap-0.5 flex-1 h-full">
                            <div class="flex-1 rounded-t" style="@($"height: {(int)(item.Desktop * 100.0 / 305)}%; background-color: #2563eb")"></div>
                            <div class="flex-1 rounded-t" style="@($"height: {(int)(item.Mobile * 100.0 / 200)}%; background-color: #60a5fa")"></div>
                        </div>
                    }
                </div>
            </div>
        </ChartCn>
    </ComponentPreview>

    <ComponentPreview Title="With Axis" Code="@AxisCode">
        <ChartCn Class="min-h-[200px] w-full max-w-md">
            <div class="relative h-[200px] w-full">
                @for (var i = 0; i < 5; i++)
                {
                    <div class="absolute left-0 right-0 border-t border-border/40" style="@($"bottom: {i * 25}%")"></div>
                }
                <div class="flex items-end gap-2 h-full relative z-10">
                    @foreach (var item in _monthlyData)
                    {
                        <div class="flex flex-col items-center gap-1 flex-1">
                            <div class="flex items-end gap-0.5 w-full h-[170px]">
                                <div class="flex-1 rounded-t" style="@($"height: {(int)(item.Desktop * 100.0 / 305)}%; background-color: #2563eb")"></div>
                                <div class="flex-1 rounded-t" style="@($"height: {(int)(item.Mobile * 100.0 / 200)}%; background-color: #60a5fa")"></div>
                            </div>
                            <span class="text-xs text-muted-foreground">@item.Month[..3]</span>
                        </div>
                    }
                </div>
            </div>
        </ChartCn>
    </ComponentPreview>

    <ComponentPreview Title="With Tooltip" Code="@TooltipCode">
        <ChartCn Class="min-h-[200px] w-full max-w-md">
            <div class="flex items-end gap-2 h-[200px]">
                @foreach (var item in _monthlyData)
                {
                    <div class="group relative flex flex-col items-center gap-1 flex-1">
                        <div class="flex items-end gap-0.5 w-full h-[170px]">
                            <div class="flex-1 rounded-t" style="@($"height: {(int)(item.Desktop * 100.0 / 305)}%; background-color: #2563eb")"></div>
                            <div class="flex-1 rounded-t" style="@($"height: {(int)(item.Mobile * 100.0 / 200)}%; background-color: #60a5fa")"></div>
                        </div>
                        <span class="text-xs text-muted-foreground">@item.Month[..3]</span>
                        @* Tooltip on hover *@
                        <div class="absolute -top-16 left-1/2 -translate-x-1/2 hidden group-hover:block z-20">
                            <div class="rounded-lg border border-border/50 bg-background px-2.5 py-1.5 text-xs shadow-xl">
                                <div class="font-medium mb-1">@item.Month</div>
                                <div class="flex items-center gap-2">
                                    <span class="inline-block h-2.5 w-2.5 rounded-[2px]" style="background-color: #2563eb"></span>
                                    <span class="text-muted-foreground">Desktop</span>
                                    <span class="ml-auto font-mono font-medium tabular-nums">@item.Desktop</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="inline-block h-2.5 w-2.5 rounded-[2px]" style="background-color: #60a5fa"></span>
                                    <span class="text-muted-foreground">Mobile</span>
                                    <span class="ml-auto font-mono font-medium tabular-nums">@item.Mobile</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </ChartCn>
    </ComponentPreview>

    <ComponentPreview Title="With Legend" Code="@LegendCode">
        <ChartCn Class="min-h-[200px] w-full max-w-md">
            <div class="flex flex-col h-[230px]">
                <div class="relative flex-1">
                    @for (var i = 0; i < 5; i++)
                    {
                        <div class="absolute left-0 right-0 border-t border-border/40" style="@($"bottom: {i * 25}%")"></div>
                    }
                    <div class="flex items-end gap-2 h-full relative z-10">
                        @foreach (var item in _monthlyData)
                        {
                            <div class="flex flex-col items-center gap-1 flex-1">
                                <div class="flex items-end gap-0.5 w-full h-[160px]">
                                    <div class="flex-1 rounded-t" style="@($"height: {(int)(item.Desktop * 100.0 / 305)}%; background-color: #2563eb")"></div>
                                    <div class="flex-1 rounded-t" style="@($"height: {(int)(item.Mobile * 100.0 / 200)}%; background-color: #60a5fa")"></div>
                                </div>
                                <span class="text-xs text-muted-foreground">@item.Month[..3]</span>
                            </div>
                        }
                    </div>
                </div>
                <ChartContainerCn Class="mt-3 justify-center">
                    <div class="flex items-center gap-2">
                        <span class="inline-block h-2.5 w-2.5 rounded-[2px]" style="background-color: #2563eb"></span>
                        <span class="text-xs text-muted-foreground">Desktop</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="inline-block h-2.5 w-2.5 rounded-[2px]" style="background-color: #60a5fa"></span>
                        <span class="text-xs text-muted-foreground">Mobile</span>
                    </div>
                </ChartContainerCn>
            </div>
        </ChartCn>
    </ComponentPreview>
</div>

@code {
    private string _activeChart = "desktop";

    private record ChartDataItem(DateTime Date, int Desktop, int Mobile);
    private record MonthlyDataItem(string Month, int Desktop, int Mobile);

    private static readonly ChartDataItem[] _chartData =
    [
        new(new(2024, 4, 1), 222, 150), new(new(2024, 4, 2), 97, 180),
        new(new(2024, 4, 3), 167, 120), new(new(2024, 4, 4), 242, 260),
        new(new(2024, 4, 5), 373, 290), new(new(2024, 4, 6), 301, 340),
        new(new(2024, 4, 7), 245, 180), new(new(2024, 4, 8), 409, 320),
        new(new(2024, 4, 9), 59, 110),  new(new(2024, 4, 10), 261, 190),
        new(new(2024, 4, 11), 327, 350), new(new(2024, 4, 12), 292, 210),
        new(new(2024, 4, 13), 342, 380), new(new(2024, 4, 14), 137, 220),
        new(new(2024, 4, 15), 120, 170), new(new(2024, 4, 16), 138, 190),
        new(new(2024, 4, 17), 446, 360), new(new(2024, 4, 18), 364, 410),
        new(new(2024, 4, 19), 243, 180), new(new(2024, 4, 20), 89, 150),
        new(new(2024, 4, 21), 137, 200), new(new(2024, 4, 22), 224, 170),
        new(new(2024, 4, 23), 138, 230), new(new(2024, 4, 24), 387, 290),
        new(new(2024, 4, 25), 215, 250), new(new(2024, 4, 26), 75, 130),
        new(new(2024, 4, 27), 383, 420), new(new(2024, 4, 28), 122, 180),
        new(new(2024, 4, 29), 315, 240), new(new(2024, 4, 30), 454, 380),
    ];

    private static readonly MonthlyDataItem[] _monthlyData =
    [
        new("January", 186, 80),
        new("February", 305, 200),
        new("March", 237, 120),
        new("April", 73, 190),
        new("May", 209, 130),
        new("June", 214, 140),
    ];

    private const string DemoCode = @"<CardCn Class=""w-full max-w-2xl py-0 pb-4"">
    <CardHeaderCn Class=""flex flex-col items-stretch border-b p-0 sm:flex-row"">
        <div class=""flex flex-1 flex-col justify-center gap-1 px-6 pt-4 pb-3"">
            <CardTitleCn>Bar Chart - Interactive</CardTitleCn>
            <CardDescriptionCn>Showing total visitors for the last 3 months</CardDescriptionCn>
        </div>
        <div class=""flex"">
            <button class=""@Cn.Merge(""""..."""", _activeChart == """"desktop"""" ? """"bg-muted/50"""" : """""""")""
                    @onclick=""@(() => _activeChart = """"desktop"""")"">
                <span class=""text-xs text-muted-foreground"">Desktop</span>
                <span class=""text-lg leading-none font-bold sm:text-3xl"">7,405</span>
            </button>
            <button class=""...""
                    @onclick=""@(() => _activeChart = """"mobile"""")"">
                <span class=""text-xs text-muted-foreground"">Mobile</span>
                <span class=""text-lg leading-none font-bold sm:text-3xl"">6,780</span>
            </button>
        </div>
    </CardHeaderCn>
    <CardContentCn Class=""px-2 sm:p-6"">
        <ChartCn Class=""aspect-auto h-[250px] w-full"">
            @* Render bars from your chart data *@
        </ChartCn>
    </CardContentCn>
</CardCn>";

    private const string ContainerCode = @"<ChartContainerCn Class=""h-[200px] w-full max-w-md"">
    <ChartCn Class=""h-full w-full"">
        @* Place your chart content (bars, lines, etc.) here *@
    </ChartCn>
</ChartContainerCn>";

    private const string GridCode = @"<ChartCn Class=""min-h-[200px] w-full max-w-md"">
    <div class=""relative h-[200px] w-full"">
        @* Horizontal grid lines *@
        @for (var i = 0; i < 5; i++)
        {
            <div class=""absolute left-0 right-0 border-t border-border/40""
                 style=""@($""""bottom: {i * 25}%"""")""></div>
        }
        <div class=""flex items-end gap-2 h-full relative z-10"">
            @foreach (var item in chartData)
            {
                <div class=""flex items-end gap-0.5 flex-1 h-full"">
                    <div class=""flex-1 rounded-t""
                         style=""@($""""height: {pct}%; background-color: #2563eb"""")""></div>
                    <div class=""flex-1 rounded-t""
                         style=""@($""""height: {pct}%; background-color: #60a5fa"""")""></div>
                </div>
            }
        </div>
    </div>
</ChartCn>";

    private const string AxisCode = @"<ChartCn Class=""min-h-[200px] w-full max-w-md"">
    <div class=""relative h-[200px] w-full"">
        @* Grid lines + axis labels *@
        <div class=""flex items-end gap-2 h-full relative z-10"">
            @foreach (var item in chartData)
            {
                <div class=""flex flex-col items-center gap-1 flex-1"">
                    <div class=""flex items-end gap-0.5 w-full h-[170px]"">
                        <div class=""flex-1 rounded-t""
                             style=""@($""""height: {pct}%; background-color: #2563eb"""")""></div>
                        <div class=""flex-1 rounded-t""
                             style=""@($""""height: {pct}%; background-color: #60a5fa"""")""></div>
                    </div>
                    <span class=""text-xs text-muted-foreground"">@item.Month[..3]</span>
                </div>
            }
        </div>
    </div>
</ChartCn>";

    private const string TooltipCode = @"<ChartCn Class=""min-h-[200px] w-full max-w-md"">
    <div class=""flex items-end gap-2 h-[200px]"">
        @foreach (var item in chartData)
        {
            <div class=""group relative flex flex-col items-center gap-1 flex-1"">
                <div class=""flex items-end gap-0.5 w-full h-[170px]"">
                    <div class=""flex-1 rounded-t"" style=""...""></div>
                    <div class=""flex-1 rounded-t"" style=""...""></div>
                </div>
                <span class=""text-xs text-muted-foreground"">@item.Month[..3]</span>
                @* CSS-only tooltip on hover *@
                <div class=""absolute -top-16 left-1/2 -translate-x-1/2 hidden group-hover:block z-20"">
                    <div class=""rounded-lg border border-border/50 bg-background px-2.5 py-1.5 text-xs shadow-xl"">
                        <div class=""font-medium mb-1"">@item.Month</div>
                        <div class=""flex items-center gap-2"">
                            <span class=""inline-block h-2.5 w-2.5 rounded-[2px]"" style=""background-color: #2563eb""></span>
                            <span class=""text-muted-foreground"">Desktop</span>
                            <span class=""ml-auto font-mono font-medium tabular-nums"">@item.Desktop</span>
                        </div>
                        <div class=""flex items-center gap-2"">
                            <span class=""inline-block h-2.5 w-2.5 rounded-[2px]"" style=""background-color: #60a5fa""></span>
                            <span class=""text-muted-foreground"">Mobile</span>
                            <span class=""ml-auto font-mono font-medium tabular-nums"">@item.Mobile</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</ChartCn>";

    private const string LegendCode = @"<ChartCn Class=""min-h-[200px] w-full max-w-md"">
    <div class=""flex flex-col h-[230px]"">
        <div class=""relative flex-1"">
            @* Chart bars *@
        </div>
        <ChartContainerCn Class=""mt-3 justify-center"">
            <div class=""flex items-center gap-2"">
                <span class=""inline-block h-2.5 w-2.5 rounded-[2px]"" style=""background-color: #2563eb""></span>
                <span class=""text-xs text-muted-foreground"">Desktop</span>
            </div>
            <div class=""flex items-center gap-2"">
                <span class=""inline-block h-2.5 w-2.5 rounded-[2px]"" style=""background-color: #60a5fa""></span>
                <span class=""text-xs text-muted-foreground"">Mobile</span>
            </div>
        </ChartContainerCn>
    </div>
</ChartCn>";
}
