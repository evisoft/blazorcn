@page "/docs/components/aspect-ratio"
@layout DocsLayout

<PageTitle>Aspect Ratio — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Aspect Ratio</h1>
        <p class="mt-2 text-lg text-muted-foreground">Displays content within a desired ratio.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <div class="w-full max-w-sm">
            <AspectRatioCn Ratio="16.0 / 9.0" Class="rounded-lg bg-muted">
                <img src="https://avatar.vercel.sh/shadcn1" alt="Photo"
                     class="w-full rounded-lg object-cover grayscale dark:brightness-[0.2]" />
            </AspectRatioCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Square (1:1)" Code="@SquareCode">
        <div class="w-full max-w-[12rem]">
            <AspectRatioCn Ratio="1" Class="rounded-lg bg-muted">
                <img src="https://avatar.vercel.sh/shadcn1" alt="Photo"
                     class="rounded-lg object-cover grayscale dark:brightness-[0.2]" />
            </AspectRatioCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Portrait (9:16)" Code="@PortraitCode">
        <div class="w-full max-w-[10rem]">
            <AspectRatioCn Ratio="9.0 / 16.0" Class="rounded-lg bg-muted">
                <img src="https://avatar.vercel.sh/shadcn1" alt="Photo"
                     class="rounded-lg object-cover grayscale dark:brightness-[0.2]" />
            </AspectRatioCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <figure class="w-full max-w-sm" dir="rtl">
            <AspectRatioCn Ratio="16.0 / 9.0" Class="rounded-lg bg-muted">
                <img src="https://avatar.vercel.sh/shadcn1" alt="Photo"
                     class="w-full rounded-lg object-cover grayscale dark:brightness-[0.2]" />
            </AspectRatioCn>
            <figcaption class="mt-2 text-center text-sm text-muted-foreground">
                منظر طبيعي جميل
            </figcaption>
        </figure>
    </ComponentPreview>
</div>

