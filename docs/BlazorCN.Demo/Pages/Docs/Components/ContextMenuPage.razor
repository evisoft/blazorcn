@page "/docs/components/context-menu"
@layout DocsLayout

<PageTitle>Context Menu — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Context Menu</h1>
        <p class="mt-2 text-lg text-muted-foreground">Displays a menu to the user triggered by a right-click.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <ContextMenuCn>
            <ContextMenuTriggerCn class="flex aspect-video w-full max-w-xs items-center justify-center rounded-xl border border-dashed text-sm">
                Right click here
            </ContextMenuTriggerCn>
            <ContextMenuContentCn Class="w-48">
                <ContextMenuGroupCn>
                    <ContextMenuItemCn>
                        Back
                        <ContextMenuShortcutCn>&#x2318;[</ContextMenuShortcutCn>
                    </ContextMenuItemCn>
                    <ContextMenuItemCn Disabled="true">
                        Forward
                        <ContextMenuShortcutCn>&#x2318;]</ContextMenuShortcutCn>
                    </ContextMenuItemCn>
                    <ContextMenuItemCn>
                        Reload
                        <ContextMenuShortcutCn>&#x2318;R</ContextMenuShortcutCn>
                    </ContextMenuItemCn>
                    <ContextMenuSubCn>
                        <ContextMenuSubTriggerCn>More Tools</ContextMenuSubTriggerCn>
                        <ContextMenuSubContentCn Class="w-44">
                            <ContextMenuGroupCn>
                                <ContextMenuItemCn>Save Page...</ContextMenuItemCn>
                                <ContextMenuItemCn>Create Shortcut...</ContextMenuItemCn>
                                <ContextMenuItemCn>Name Window...</ContextMenuItemCn>
                            </ContextMenuGroupCn>
                            <ContextMenuSeparatorCn />
                            <ContextMenuGroupCn>
                                <ContextMenuItemCn>Developer Tools</ContextMenuItemCn>
                            </ContextMenuGroupCn>
                            <ContextMenuSeparatorCn />
                            <ContextMenuGroupCn>
                                <ContextMenuItemCn Variant="destructive">Delete</ContextMenuItemCn>
                            </ContextMenuGroupCn>
                        </ContextMenuSubContentCn>
                    </ContextMenuSubCn>
                </ContextMenuGroupCn>
                <ContextMenuSeparatorCn />
                <ContextMenuGroupCn>
                    <ContextMenuCheckboxItemCn @bind-Checked="_showBookmarks">
                        Show Bookmarks
                    </ContextMenuCheckboxItemCn>
                    <ContextMenuCheckboxItemCn @bind-Checked="_showFullUrls">Show Full URLs</ContextMenuCheckboxItemCn>
                </ContextMenuGroupCn>
                <ContextMenuSeparatorCn />
                <ContextMenuGroupCn>
                    <ContextMenuRadioGroupCn @bind-Value="_selectedPerson">
                        <ContextMenuLabelCn>People</ContextMenuLabelCn>
                        <ContextMenuRadioItemCn Value="pedro">Pedro Duarte</ContextMenuRadioItemCn>
                        <ContextMenuRadioItemCn Value="colm">Colm Tuite</ContextMenuRadioItemCn>
                    </ContextMenuRadioGroupCn>
                </ContextMenuGroupCn>
            </ContextMenuContentCn>
        </ContextMenuCn>
    </ComponentPreview>

    <ComponentPreview Title="Basic" Code="@BasicCode">
