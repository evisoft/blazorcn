@page "/docs/components/kbd"
@layout DocsLayout

<PageTitle>Kbd — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Kbd</h1>
        <p class="mt-2 text-lg text-muted-foreground">Displays a keyboard key or shortcut in a styled inline element.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <div class="flex flex-col items-center gap-4">
            <span class="inline-flex items-center gap-1">
                <KbdCn>&#x2318;</KbdCn>
                <KbdCn>&#x21E7;</KbdCn>
                <KbdCn>&#x2325;</KbdCn>
                <KbdCn>&#x2303;</KbdCn>
            </span>
            <span class="inline-flex items-center gap-1">
                <KbdCn>Ctrl</KbdCn>
                <span>+</span>
                <KbdCn>B</KbdCn>
            </span>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Group" Code="@GroupCode">
        <div class="flex flex-col items-center gap-4">
            <p class="text-sm text-muted-foreground">
                Use
                <span class="inline-flex items-center gap-1">
                    <KbdCn>Ctrl + B</KbdCn>
                    <KbdCn>Ctrl + K</KbdCn>
                </span>
                to open the command palette
            </p>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Button" Code="@ButtonCode">
        <ButtonCn Variant="ButtonVariant.Outline">
            Accept
            <KbdCn Class="translate-x-0.5">&#x23CE;</KbdCn>
        </ButtonCn>
    </ComponentPreview>

    <ComponentPreview Title="Input Group" Code="@InputGroupCode">
        <div class="flex w-full max-w-xs flex-col gap-6">
            <InputGroupCn>
                <InputGroupInputCn Placeholder="Search..." />
                <InputGroupAddonCn Align="InputGroupAddonAlign.InlineEnd">
                    <KbdCn>&#x2318;</KbdCn>
                    <KbdCn>K</KbdCn>
                </InputGroupAddonCn>
            </InputGroupCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Tooltip" Code="@TooltipCode">
        <div class="flex flex-wrap gap-4">
            <TooltipCn>
                <TooltipTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">Save</TooltipTriggerCn>
                <TooltipContentCn>
                    Save Changes <KbdCn>S</KbdCn>
                </TooltipContentCn>
            </TooltipCn>
            <TooltipCn>
                <TooltipTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">Print</TooltipTriggerCn>
                <TooltipContentCn>
                    Print Document
                    <span class="inline-flex items-center gap-1">
                        <KbdCn>Ctrl</KbdCn>
                        <KbdCn>P</KbdCn>
                    </span>
                </TooltipContentCn>
            </TooltipCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div class="flex flex-col items-center gap-4" dir="rtl">
            <span class="inline-flex items-center gap-1">
                <KbdCn>&#x2318;</KbdCn>
                <KbdCn>&#x21E7;</KbdCn>
                <KbdCn>&#x2325;</KbdCn>
                <KbdCn>&#x2303;</KbdCn>
            </span>
            <span class="inline-flex items-center gap-1">
                <KbdCn>Ctrl</KbdCn>
                <span>+</span>
                <KbdCn>B</KbdCn>
            </span>
        </div>
    </ComponentPreview>
</div>

