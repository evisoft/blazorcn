@page "/docs/components/label"
@layout DocsLayout

<PageTitle>Label — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Label</h1>
        <p class="mt-2 text-lg text-muted-foreground">Renders an accessible label associated with controls.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <div class="flex gap-2">
            <CheckboxCn id="terms" />
            <LabelCn For="terms">Accept terms and conditions</LabelCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="With Input" Code="@WithInputCode">
        <div class="grid w-full max-w-sm gap-1.5">
            <LabelCn For="email-label">Email</LabelCn>
            <InputCn id="email-label" Type="email" Placeholder="Email address" />
        </div>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div class="flex gap-2" dir="rtl">
            <CheckboxCn id="terms-rtl" />
            <LabelCn For="terms-rtl">قبول الشروط والأحكام</LabelCn>
        </div>
    </ComponentPreview>
</div>

@code {
    private const string DemoCode = @"<div class=""flex gap-2"">
    <CheckboxCn id=""terms"" />
    <LabelCn For=""terms"">Accept terms and conditions</LabelCn>
</div>";

    private const string WithInputCode = @"<div class=""grid w-full max-w-sm gap-1.5"">
    <LabelCn For=""email"">Email</LabelCn>
    <InputCn id=""email"" Type=""email"" Placeholder=""Email address"" />
</div>";

    private const string RtlCode = @"<div class=""flex gap-2"" dir=""rtl"">
    <CheckboxCn id=""terms-rtl"" />
    <LabelCn For=""terms-rtl"">قبول الشروط والأحكام</LabelCn>
</div>";
}
