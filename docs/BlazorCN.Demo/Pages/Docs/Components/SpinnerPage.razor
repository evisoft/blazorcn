@page "/docs/components/spinner"
@layout DocsLayout

<PageTitle>Spinner — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Spinner</h1>
        <p class="mt-2 text-lg text-muted-foreground">A spinning loading indicator.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <div class="flex w-full max-w-xs flex-col gap-4" style="--radius:1rem">
            <div class="flex w-full flex-wrap items-center gap-2.5 rounded-lg border-transparent bg-muted/50 px-3 py-2.5 text-sm">
                <div class="flex shrink-0 items-center justify-center">
                    <SpinnerCn />
                </div>
                <div class="flex flex-1 flex-col gap-1">
                    <div class="line-clamp-1 text-sm font-medium leading-snug">Processing payment...</div>
                </div>
                <div class="flex flex-none flex-col gap-1 justify-end">
                    <span class="text-sm tabular-nums">$100.00</span>
                </div>
            </div>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Sizes" Code="@SizesCode">
        <div class="flex items-center gap-6">
            <SpinnerCn Class="size-3" />
            <SpinnerCn Class="size-4" />
            <SpinnerCn Class="size-6" />
            <SpinnerCn Class="size-8" />
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Button" Code="@ButtonCode">
        <div class="flex flex-col items-center gap-4">
            <ButtonCn Disabled="true" Size="ButtonSize.Sm">
                <SpinnerCn />
                Loading...
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Disabled="true" Size="ButtonSize.Sm">
                <SpinnerCn />
                Please wait
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Secondary" Disabled="true" Size="ButtonSize.Sm">
                <SpinnerCn />
                Processing
            </ButtonCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Input Group" Code="@InputGroupCode">
        <div class="flex w-full max-w-md flex-col gap-4">
            <InputGroupCn>
                <InputGroupInputCn Placeholder="Send a message..." Disabled />
                <InputGroupAddonCn Align="InputGroupAddonAlign.InlineEnd">
                    <SpinnerCn />
                </InputGroupAddonCn>
            </InputGroupCn>
            <InputGroupCn>
                <InputGroupTextareaCn Placeholder="Send a message..." Disabled />
                <InputGroupAddonCn Align="InputGroupAddonAlign.BlockEnd" Class="border-t">
                    <SpinnerCn />
                    <span class="text-sm text-muted-foreground">Validating...</span>
                    <InputGroupButtonCn Size="InputGroupButtonSize.Sm" Class="ml-auto">
                        <LucideArrowUpCn Size="16" />
                        <span class="sr-only">Send</span>
                    </InputGroupButtonCn>
                </InputGroupAddonCn>
            </InputGroupCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Empty" Code="@EmptyCode">
        <EmptyCn Class="w-full">
            <div class="flex max-w-sm flex-col items-center gap-2">
                <div class="mb-2 flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted text-foreground">
                    <SpinnerCn />
                </div>
                <div class="text-sm font-medium tracking-tight">Processing your request</div>
                <div class="text-sm/relaxed text-muted-foreground">
                    Please wait while we process your request. Do not refresh the page.
                </div>
            </div>
            <div class="flex w-full max-w-sm min-w-0 flex-col items-center gap-2.5 text-sm">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">
                    Cancel
                </ButtonCn>
            </div>
        </EmptyCn>
    </ComponentPreview>

    <ComponentPreview Title="Badge" Code="@BadgeCode">
        <div class="flex items-center gap-4" style="--radius:1.2rem">
            <BadgeCn>
                <SpinnerCn Class="size-3" />
                Syncing
            </BadgeCn>
            <BadgeCn Variant="BadgeVariant.Secondary">
                <SpinnerCn Class="size-3" />
                Updating
            </BadgeCn>
            <BadgeCn Variant="BadgeVariant.Outline">
                <SpinnerCn Class="size-3" />
                Processing
            </BadgeCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Custom" Code="@CustomCode">
        <div class="flex items-center gap-4">
            <LucideLoaderCn Size="16" Class="animate-spin" />
        </div>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div class="flex w-full max-w-xs flex-col gap-4" style="--radius:1rem" dir="rtl">
            <div class="flex w-full flex-wrap items-center gap-2.5 rounded-lg border-transparent bg-muted/50 px-3 py-2.5 text-sm">
                <div class="flex shrink-0 items-center justify-center">
                    <SpinnerCn />
                </div>
                <div class="flex flex-1 flex-col gap-1">
                    <div class="line-clamp-1 text-sm font-medium leading-snug">جاري معالجة الدفع...</div>
                </div>
                <div class="flex flex-none flex-col gap-1 justify-end">
                    <span class="text-sm tabular-nums">١٠٠.٠٠ دولار</span>
                </div>
            </div>
        </div>
    </ComponentPreview>
</div>

