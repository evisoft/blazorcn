@page "/docs/components/button-group"
@layout DocsLayout

<PageTitle>Button Group — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Button Group</h1>
        <p class="mt-2 text-lg text-muted-foreground">Groups buttons together with connected borders and rounded corners.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <ButtonGroupCn>
            <ButtonCn Variant="ButtonVariant.Outline">Archive</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline">Report</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline">Snooze</ButtonCn>
        </ButtonGroupCn>
    </ComponentPreview>

    <ComponentPreview Title="Sizes" Code="@SizesCode">
        <div class="flex flex-col items-start gap-8">
            <ButtonGroupCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">Small</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">Button</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">Group</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.IconSm" aria-label="Add">
                    <LucidePlusCn Size="14" />
                </ButtonCn>
            </ButtonGroupCn>
            <ButtonGroupCn>
                <ButtonCn Variant="ButtonVariant.Outline">Default</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline">Button</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline">Group</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" aria-label="Add">
                    <LucidePlusCn Size="16" />
                </ButtonCn>
            </ButtonGroupCn>
            <ButtonGroupCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Lg">Large</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Lg">Button</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Lg">Group</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.IconLg" aria-label="Add">
                    <LucidePlusCn Size="16" />
                </ButtonCn>
            </ButtonGroupCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Orientation" Code="@OrientationCode">
        <ButtonGroupCn Orientation="Orientation.Vertical" aria-label="Media controls" Class="h-fit">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" aria-label="Increase">
                <LucidePlusCn Size="16" />
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" aria-label="Decrease">
                <LucideMinusCn Size="16" />
            </ButtonCn>
        </ButtonGroupCn>
    </ComponentPreview>

    <ComponentPreview Title="Separator" Code="@SeparatorCode">
        <ButtonGroupCn>
            <ButtonCn Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm">Copy</ButtonCn>
            <ButtonGroupSeparatorCn />
            <ButtonCn Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm">Paste</ButtonCn>
        </ButtonGroupCn>
    </ComponentPreview>

    <ComponentPreview Title="Split" Code="@SplitCode">
        <ButtonGroupCn>
            <ButtonCn Variant="ButtonVariant.Secondary">Button</ButtonCn>
            <ButtonGroupSeparatorCn />
            <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Secondary" aria-label="More">
                <LucidePlusCn Size="16" />
            </ButtonCn>
        </ButtonGroupCn>
    </ComponentPreview>

    <ComponentPreview Title="Dropdown" Code="@DropdownCode">
        <ButtonGroupCn>
            <ButtonCn Variant="ButtonVariant.Outline">Follow</ButtonCn>
            <DropdownMenuCn>
                <DropdownMenuTriggerCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Class="pl-2!" aria-label="More options">
                        <LucideChevronDownCn Size="16" />
                    </ButtonCn>
                </DropdownMenuTriggerCn>
                <DropdownMenuContentCn Align="FloatingAlign.End" Class="w-44">
                    <DropdownMenuItemCn>Mark as Read</DropdownMenuItemCn>
                    <DropdownMenuItemCn>Report Conversation</DropdownMenuItemCn>
                    <DropdownMenuItemCn>Block User</DropdownMenuItemCn>
                    <DropdownMenuSeparatorCn />
                    <DropdownMenuItemCn Variant="DropdownMenuItemVariant.Destructive">Delete Conversation</DropdownMenuItemCn>
                </DropdownMenuContentCn>
            </DropdownMenuCn>
        </ButtonGroupCn>
    </ComponentPreview>

    <ComponentPreview Title="Popover" Code="@PopoverCode">
        <ButtonGroupCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideBotCn Size="16" /> Copilot
            </ButtonCn>
            <PopoverCn>
                <PopoverTriggerCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" aria-label="Open Popover">
                        <LucideChevronDownCn Size="16" />
                    </ButtonCn>
                </PopoverTriggerCn>
                <PopoverContentCn Align="FloatingAlign.End" Class="rounded-xl text-sm">
                    <div class="space-y-2">
                        <h4 class="font-medium leading-none">Start a new task with Copilot</h4>
                        <p class="text-sm text-muted-foreground">Describe your task in natural language.</p>
                        <TextareaCn placeholder="I need to..." Class="resize-none" />
                        <p class="text-xs text-muted-foreground">Copilot will open a pull request for review.</p>
                    </div>
                </PopoverContentCn>
            </PopoverCn>
        </ButtonGroupCn>
    </ComponentPreview>

    <ComponentPreview Title="Input" Code="@InputCode">
        <ButtonGroupCn>
            <InputCn placeholder="Search..." />
            <ButtonCn Variant="ButtonVariant.Outline" aria-label="Search">
                <LucideSearchCn Size="16" />
            </ButtonCn>
        </ButtonGroupCn>
    </ComponentPreview>

    <ComponentPreview Title="Nested" Code="@NestedCode">
        <ButtonGroupCn>
            <ButtonGroupCn>
                <ButtonCn Variant="ButtonVariant.Outline">Archive</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline">Report</ButtonCn>
            </ButtonGroupCn>
            <ButtonGroupCn>
                <ButtonCn Variant="ButtonVariant.Outline">Snooze</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" aria-label="More">
                    <LucidePlusCn Size="16" />
                </ButtonCn>
            </ButtonGroupCn>
        </ButtonGroupCn>
    </ComponentPreview>

    <ComponentPreview Title="Text" Code="@TextCode">
        <ButtonGroupCn>
            <ButtonGroupTextCn>Label</ButtonGroupTextCn>
            <ButtonCn Variant="ButtonVariant.Outline">Action</ButtonCn>
        </ButtonGroupCn>
    </ComponentPreview>
</div>

