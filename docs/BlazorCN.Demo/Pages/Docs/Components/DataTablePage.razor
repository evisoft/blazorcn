@page "/docs/components/data-table"
@layout DocsLayout

<PageTitle>Data Table — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Data Table</h1>
        <p class="mt-2 text-lg text-muted-foreground">A powerful table with sorting, filtering, pagination, and row selection built using Table components.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <div class="w-full">
            <div class="flex items-center py-4">
                <InputCn Placeholder="Filter emails..."
                         Value="@_emailFilter"
                         ValueChanged="OnEmailFilterChanged"
                         Class="max-w-sm" />
                <DropdownMenuCn>
                    <DropdownMenuTriggerCn>
                        <ButtonCn Variant="ButtonVariant.Outline" Class="ml-auto">
                            Columns
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2 size-4" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                        </ButtonCn>
                    </DropdownMenuTriggerCn>
                    <DropdownMenuContentCn Align="FloatingAlign.End">
                        <DropdownMenuGroupCn>
                            <DropdownMenuCheckboxItemCn Checked="@_showStatus" CheckedChanged="@(v => { _showStatus = v; })">
                                Status
                            </DropdownMenuCheckboxItemCn>
                            <DropdownMenuCheckboxItemCn Checked="@_showEmail" CheckedChanged="@(v => { _showEmail = v; })">
                                Email
                            </DropdownMenuCheckboxItemCn>
                            <DropdownMenuCheckboxItemCn Checked="@_showAmount" CheckedChanged="@(v => { _showAmount = v; })">
                                Amount
                            </DropdownMenuCheckboxItemCn>
                        </DropdownMenuGroupCn>
                    </DropdownMenuContentCn>
                </DropdownMenuCn>
            </div>
            <div class="overflow-hidden rounded-md border">
                <TableCn>
                    <TableHeaderCn>
                        <TableRowCn>
                            <TableHeadCn Class="w-[40px]">
                                <CheckboxCn Checked="@_allSelected" CheckedChanged="ToggleSelectAll" />
                            </TableHeadCn>
                            @if (_showStatus)
                            {
                                <TableHeadCn>Status</TableHeadCn>
                            }
                            @if (_showEmail)
                            {
                                <TableHeadCn>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Class="-ml-4" OnClick="ToggleEmailSort">
                                        Email
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2 size-4" aria-hidden="true"><path d="m21 16-4 4-4-4"/><path d="M17 20V4"/><path d="m3 8 4-4 4 4"/><path d="M7 4v16"/></svg>
                                    </ButtonCn>
                                </TableHeadCn>
                            }
                            @if (_showAmount)
                            {
                                <TableHeadCn Class="text-right">Amount</TableHeadCn>
                            }
                            <TableHeadCn Class="w-[50px]">
                                <span class="sr-only">Actions</span>
                            </TableHeadCn>
                        </TableRowCn>
                    </TableHeaderCn>
                    <TableBodyCn>
                        @if (PagedRows.Any())
                        {
                            @foreach (var payment in PagedRows)
                            {
                                <TableRowCn data-state="@(payment.Selected ? "selected" : null)">
                                    <TableCellCn>
                                        <CheckboxCn Checked="@payment.Selected"
                                                    CheckedChanged="@(v => { payment.Selected = v; UpdateSelectAll(); })" />
                                    </TableCellCn>
                                    @if (_showStatus)
                                    {
                                        <TableCellCn>
                                            <span class="capitalize">@payment.Status</span>
                                        </TableCellCn>
                                    }
                                    @if (_showEmail)
                                    {
                                        <TableCellCn>
                                            <span class="lowercase">@payment.Email</span>
                                        </TableCellCn>
                                    }
                                    @if (_showAmount)
                                    {
                                        <TableCellCn Class="text-right font-medium">
                                            @payment.Amount.ToString("C")
                                        </TableCellCn>
                                    }
                                    <TableCellCn>
                                        <DropdownMenuCn>
                                            <DropdownMenuTriggerCn>
                                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8">
                                                    <LucideEllipsisCn Size="16" />
                                                    <span class="sr-only">Open menu</span>
                                                </ButtonCn>
                                            </DropdownMenuTriggerCn>
                                            <DropdownMenuContentCn Align="FloatingAlign.End" Class="w-40">
                                                <DropdownMenuGroupCn>
                                                    <DropdownMenuLabelCn>Actions</DropdownMenuLabelCn>
                                                    <DropdownMenuItemCn>Copy payment ID</DropdownMenuItemCn>
                                                </DropdownMenuGroupCn>
                                                <DropdownMenuSeparatorCn />
                                                <DropdownMenuGroupCn>
                                                    <DropdownMenuItemCn>View customer</DropdownMenuItemCn>
                                                    <DropdownMenuItemCn>View payment details</DropdownMenuItemCn>
                                                </DropdownMenuGroupCn>
                                            </DropdownMenuContentCn>
                                        </DropdownMenuCn>
                                    </TableCellCn>
                                </TableRowCn>
                            }
                        }
                        else
                        {
                            <TableRowCn>
                                <TableCellCn colspan="@ColumnCount" Class="h-24 text-center">
                                    No results.
                                </TableCellCn>
                            </TableRowCn>
                        }
                    </TableBodyCn>
                </TableCn>
            </div>
            <div class="flex items-center justify-end space-x-2 py-4">
                <div class="flex-1 text-sm text-muted-foreground">
                    @SelectedCount of @FilteredRows.Count() row(s) selected.
                </div>
                <div class="space-x-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                              Disabled="@(!CanGoPrevious)"
                              OnClick="PreviousPage">
                        Previous
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                              Disabled="@(!CanGoNext)"
                              OnClick="NextPage">
                        Next
                    </ButtonCn>
                </div>
            </div>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div dir="rtl" class="w-full">
            <div class="flex items-center gap-2 py-4">
                <InputCn Placeholder="تصفية البريد الإلكتروني..."
                         Value="@_rtlEmailFilter"
                         ValueChanged="OnRtlEmailFilterChanged"
                         Class="max-w-sm" />
            </div>
            <div class="overflow-hidden rounded-md border">
                <TableCn>
                    <TableHeaderCn>
                        <TableRowCn>
                            <TableHeadCn>الحالة</TableHeadCn>
                            <TableHeadCn>البريد الإلكتروني</TableHeadCn>
                            <TableHeadCn Class="text-left">المبلغ</TableHeadCn>
                        </TableRowCn>
                    </TableHeaderCn>
                    <TableBodyCn>
                        @foreach (var payment in RtlFilteredRows)
                        {
                            <TableRowCn>
                                <TableCellCn>
                                    <span class="capitalize">@GetArabicStatus(payment.Status)</span>
                                </TableCellCn>
                                <TableCellCn>
                                    <span class="lowercase">@payment.Email</span>
                                </TableCellCn>
                                <TableCellCn Class="text-left font-medium">
                                    @payment.Amount.ToString("C")
                                </TableCellCn>
                            </TableRowCn>
                        }
                    </TableBodyCn>
                </TableCn>
            </div>
        </div>
    </ComponentPreview>
</div>

@code {
    private class PaymentRow
    {
        public string Id { get; set; } = "";
        public decimal Amount { get; set; }
        public string Status { get; set; } = "";
        public string Email { get; set; } = "";
        public bool Selected { get; set; }
    }

    private List<PaymentRow> _payments = [];
    private string _emailFilter = "";
    private string _rtlEmailFilter = "";
    private bool _showStatus = true;
    private bool _showEmail = true;
    private bool _showAmount = true;
    private bool _allSelected;
    private int _currentPage;
    private const int PageSize = 5;
    private bool _emailSortAsc = true;

    protected override void OnInitialized()
    {
        _payments =
        [
            new() { Id = "m5gr84i9", Amount = 316, Status = "success", Email = "ken99@example.com" },
            new() { Id = "3u1reuv4", Amount = 242, Status = "success", Email = "Abe45@example.com" },
            new() { Id = "derv1ws0", Amount = 837, Status = "processing", Email = "Monserrat44@example.com" },
            new() { Id = "5kma53ae", Amount = 874, Status = "success", Email = "Silas22@example.com" },
            new() { Id = "bhqecj4p", Amount = 721, Status = "failed", Email = "carmella@example.com" },
            new() { Id = "p2kl94mn", Amount = 129, Status = "pending", Email = "jorge55@example.com" },
            new() { Id = "q8wr21xz", Amount = 493, Status = "success", Email = "laura.k@example.com" },
            new() { Id = "t7yh56ab", Amount = 658, Status = "processing", Email = "chen.w@example.com" },
        ];
    }

    private IEnumerable<PaymentRow> FilteredRows
    {
        get
        {
            var rows = _payments.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(_emailFilter))
                rows = rows.Where(p => p.Email.Contains(_emailFilter, StringComparison.OrdinalIgnoreCase));
            rows = _emailSortAsc
                ? rows.OrderBy(p => p.Email, StringComparer.OrdinalIgnoreCase)
                : rows.OrderByDescending(p => p.Email, StringComparer.OrdinalIgnoreCase);
            return rows;
        }
    }

    private IEnumerable<PaymentRow> PagedRows =>
        FilteredRows.Skip(_currentPage * PageSize).Take(PageSize);

    private int SelectedCount => _payments.Count(p => p.Selected);
    private int ColumnCount => 2 + (_showStatus ? 1 : 0) + (_showEmail ? 1 : 0) + (_showAmount ? 1 : 0);

    private bool CanGoPrevious => _currentPage > 0;
    private bool CanGoNext => (_currentPage + 1) * PageSize < FilteredRows.Count();

    private void OnEmailFilterChanged(string value)
    {
        _emailFilter = value ?? "";
        _currentPage = 0;
    }

    private void ToggleEmailSort()
    {
        _emailSortAsc = !_emailSortAsc;
    }

    private void ToggleSelectAll(bool value)
    {
        _allSelected = value;
        foreach (var p in _payments)
            p.Selected = value;
    }

    private void UpdateSelectAll()
    {
        _allSelected = _payments.All(p => p.Selected);
    }

    private void PreviousPage()
    {
        if (CanGoPrevious) _currentPage--;
    }

    private void NextPage()
    {
        if (CanGoNext) _currentPage++;
    }

    private IEnumerable<PaymentRow> RtlFilteredRows
    {
        get
        {
            var rows = _payments.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(_rtlEmailFilter))
                rows = rows.Where(p => p.Email.Contains(_rtlEmailFilter, StringComparison.OrdinalIgnoreCase));
            return rows;
        }
    }

    private void OnRtlEmailFilterChanged(string value)
    {
        _rtlEmailFilter = value ?? "";
    }

    private static string GetArabicStatus(string status) => status switch
    {
        "success" => "ناجح",
        "processing" => "قيد المعالجة",
        "failed" => "فشل",
        "pending" => "قيد الانتظار",
        _ => status
    };

    private const string DemoCode = @"<div class=""w-full"">
    <div class=""flex items-center py-4"">
        <InputCn Placeholder=""Filter emails...""
                 Value=""@_emailFilter""
                 ValueChanged=""OnEmailFilterChanged""
                 Class=""max-w-sm"" />
        <DropdownMenuCn>
            <DropdownMenuTriggerCn>
                <ButtonCn Variant=""ButtonVariant.Outline"" Class=""ml-auto"">
                    Columns
                </ButtonCn>
            </DropdownMenuTriggerCn>
            <DropdownMenuContentCn Align=""FloatingAlign.End"">
                <DropdownMenuGroupCn>
                    <DropdownMenuCheckboxItemCn Checked=""@_showStatus""
                        CheckedChanged=""@(v => _showStatus = v)"">
                        Status
                    </DropdownMenuCheckboxItemCn>
                    <DropdownMenuCheckboxItemCn Checked=""@_showEmail""
                        CheckedChanged=""@(v => _showEmail = v)"">
                        Email
                    </DropdownMenuCheckboxItemCn>
                    <DropdownMenuCheckboxItemCn Checked=""@_showAmount""
                        CheckedChanged=""@(v => _showAmount = v)"">
                        Amount
                    </DropdownMenuCheckboxItemCn>
                </DropdownMenuGroupCn>
            </DropdownMenuContentCn>
        </DropdownMenuCn>
    </div>
    <div class=""overflow-hidden rounded-md border"">
        <TableCn>
            <TableHeaderCn>
                <TableRowCn>
                    <TableHeadCn Class=""w-[40px]"">
                        <CheckboxCn Checked=""@_allSelected""
                                    CheckedChanged=""ToggleSelectAll"" />
                    </TableHeadCn>
                    <TableHeadCn>Status</TableHeadCn>
                    <TableHeadCn>
                        <ButtonCn Variant=""ButtonVariant.Ghost""
                                  OnClick=""ToggleEmailSort"">
                            Email
                            <!-- ArrowUpDown icon -->
                        </ButtonCn>
                    </TableHeadCn>
                    <TableHeadCn Class=""text-right"">Amount</TableHeadCn>
                    <TableHeadCn Class=""w-[50px]"" />
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var payment in PagedRows)
                {
                    <TableRowCn data-state=""@(payment.Selected ? ""selected"" : null)"">
                        <TableCellCn>
                            <CheckboxCn Checked=""@payment.Selected""
                                CheckedChanged=""@(v => payment.Selected = v)"" />
                        </TableCellCn>
                        <TableCellCn>@payment.Status</TableCellCn>
                        <TableCellCn>@payment.Email</TableCellCn>
                        <TableCellCn Class=""text-right font-medium"">
                            @payment.Amount.ToString(""C"")
                        </TableCellCn>
                        <TableCellCn>
                            <DropdownMenuCn>
                                <!-- Actions menu -->
                            </DropdownMenuCn>
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
    <div class=""flex items-center justify-end space-x-2 py-4"">
        <div class=""flex-1 text-sm text-muted-foreground"">
            @SelectedCount of @FilteredRows.Count() row(s) selected.
        </div>
        <div class=""space-x-2"">
            <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm""
                      Disabled=""@(!CanGoPrevious)""
                      OnClick=""PreviousPage"">Previous</ButtonCn>
            <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm""
                      Disabled=""@(!CanGoNext)""
                      OnClick=""NextPage"">Next</ButtonCn>
        </div>
    </div>
</div>

@code {
    private class PaymentRow
    {
        public string Id { get; set; } = """";
        public decimal Amount { get; set; }
        public string Status { get; set; } = """";
        public string Email { get; set; } = """";
        public bool Selected { get; set; }
    }

    private List<PaymentRow> _payments = [];
    private string _emailFilter = """";
    private bool _showStatus = true;
    private bool _showEmail = true;
    private bool _showAmount = true;
    private bool _allSelected;
    private int _currentPage;
    private const int PageSize = 5;
    private bool _emailSortAsc = true;
}";

    private const string RtlCode = @"<div dir=""rtl"" class=""w-full"">
    <div class=""flex items-center gap-2 py-4"">
        <InputCn Placeholder=""تصفية البريد الإلكتروني...""
                 Value=""@_rtlEmailFilter""
                 ValueChanged=""OnRtlEmailFilterChanged""
                 Class=""max-w-sm"" />
    </div>
    <div class=""overflow-hidden rounded-md border"">
        <TableCn>
            <TableHeaderCn>
                <TableRowCn>
                    <TableHeadCn>الحالة</TableHeadCn>
                    <TableHeadCn>البريد الإلكتروني</TableHeadCn>
                    <TableHeadCn Class=""text-left"">المبلغ</TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var payment in RtlFilteredRows)
                {
                    <TableRowCn>
                        <TableCellCn>@GetArabicStatus(payment.Status)</TableCellCn>
                        <TableCellCn>@payment.Email</TableCellCn>
                        <TableCellCn Class=""text-left font-medium"">
                            @payment.Amount.ToString(""C"")
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</div>

@code {
    private string _rtlEmailFilter = """";
}";
}
