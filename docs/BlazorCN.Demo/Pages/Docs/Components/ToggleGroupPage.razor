@page "/docs/components/toggle-group"
@layout DocsLayout

<PageTitle>Toggle Group — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Toggle Group</h1>
        <p class="mt-2 text-lg text-muted-foreground">A set of two-state buttons that can be toggled on or off.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <ToggleGroupCn Variant="ToggleVariant.Outline" @bind-Value="_demoSelected">
            <ToggleGroupItemCn Value="bold" aria-label="Toggle bold">
                <LucideBoldCn Size="16" />
            </ToggleGroupItemCn>
            <ToggleGroupItemCn Value="italic" aria-label="Toggle italic">
                <LucideItalicCn Size="16" />
            </ToggleGroupItemCn>
            <ToggleGroupItemCn Value="underline" aria-label="Toggle underline">
                <LucideUnderlineCn Size="16" />
            </ToggleGroupItemCn>
        </ToggleGroupCn>
    </ComponentPreview>

    <ComponentPreview Title="Sizes" Code="@SizesCode">
        <div class="flex flex-col gap-4">
            <ToggleGroupCn Size="ToggleSize.Sm" Variant="ToggleVariant.Outline" @bind-Value="_sizeSmSelected">
                <ToggleGroupItemCn Value="top" aria-label="Toggle top">Top</ToggleGroupItemCn>
                <ToggleGroupItemCn Value="bottom" aria-label="Toggle bottom">Bottom</ToggleGroupItemCn>
                <ToggleGroupItemCn Value="left" aria-label="Toggle left">Left</ToggleGroupItemCn>
                <ToggleGroupItemCn Value="right" aria-label="Toggle right">Right</ToggleGroupItemCn>
            </ToggleGroupCn>
            <ToggleGroupCn Variant="ToggleVariant.Outline" @bind-Value="_sizeDefaultSelected">
                <ToggleGroupItemCn Value="top" aria-label="Toggle top">Top</ToggleGroupItemCn>
                <ToggleGroupItemCn Value="bottom" aria-label="Toggle bottom">Bottom</ToggleGroupItemCn>
                <ToggleGroupItemCn Value="left" aria-label="Toggle left">Left</ToggleGroupItemCn>
                <ToggleGroupItemCn Value="right" aria-label="Toggle right">Right</ToggleGroupItemCn>
            </ToggleGroupCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Outline" Code="@OutlineCode">
        <ToggleGroupCn Variant="ToggleVariant.Outline" @bind-Value="_outlineSelected">
            <ToggleGroupItemCn Value="all" aria-label="Toggle all">All</ToggleGroupItemCn>
            <ToggleGroupItemCn Value="missed" aria-label="Toggle missed">Missed</ToggleGroupItemCn>
        </ToggleGroupCn>
    </ComponentPreview>

    <ComponentPreview Title="Disabled" Code="@DisabledCode">
        <ToggleGroupCn @bind-Value="_disabledSelected">
            <ToggleGroupItemCn Value="bold" aria-label="Toggle bold" Disabled="true">
                <LucideBoldCn Size="16" />
            </ToggleGroupItemCn>
            <ToggleGroupItemCn Value="italic" aria-label="Toggle italic" Disabled="true">
                <LucideItalicCn Size="16" />
            </ToggleGroupItemCn>
            <ToggleGroupItemCn Value="underline" aria-label="Toggle underline" Disabled="true">
                <LucideUnderlineCn Size="16" />
            </ToggleGroupItemCn>
        </ToggleGroupCn>
    </ComponentPreview>

    <ComponentPreview Title="Font Weight Selector" Code="@FontWeightCode">
        <div class="space-y-2">
            <LabelCn>Font Weight</LabelCn>
            <ToggleGroupCn Variant="ToggleVariant.Outline" Size="ToggleSize.Lg" @bind-Value="_fontWeight">
                <ToggleGroupItemCn Value="light" aria-label="Light" Class="flex size-16 flex-col items-center justify-center rounded-xl">
                    <span class="text-2xl leading-none font-light">Aa</span>
                    <span class="text-xs text-muted-foreground">Light</span>
                </ToggleGroupItemCn>
                <ToggleGroupItemCn Value="normal" aria-label="Normal" Class="flex size-16 flex-col items-center justify-center rounded-xl">
                    <span class="text-2xl leading-none font-normal">Aa</span>
                    <span class="text-xs text-muted-foreground">Normal</span>
                </ToggleGroupItemCn>
                <ToggleGroupItemCn Value="medium" aria-label="Medium" Class="flex size-16 flex-col items-center justify-center rounded-xl">
                    <span class="text-2xl leading-none font-medium">Aa</span>
                    <span class="text-xs text-muted-foreground">Medium</span>
                </ToggleGroupItemCn>
                <ToggleGroupItemCn Value="bold" aria-label="Bold" Class="flex size-16 flex-col items-center justify-center rounded-xl">
                    <span class="text-2xl leading-none font-bold">Aa</span>
                    <span class="text-xs text-muted-foreground">Bold</span>
                </ToggleGroupItemCn>
            </ToggleGroupCn>
            <p class="text-sm text-muted-foreground">
                Use <code class="rounded-md bg-muted px-1 py-0.5 font-mono">font-@(_fontWeight ?? "normal")</code> to set the font weight.
            </p>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Vertical" Code="@VerticalCode">
        <ToggleGroupCn Orientation="vertical" Spacing="1" @bind-Value="_verticalSelected">
            <ToggleGroupItemCn Value="bold" aria-label="Toggle bold">
                <LucideBoldCn Size="16" />
            </ToggleGroupItemCn>
            <ToggleGroupItemCn Value="italic" aria-label="Toggle italic">
                <LucideItalicCn Size="16" />
            </ToggleGroupItemCn>
            <ToggleGroupItemCn Value="underline" aria-label="Toggle underline">
                <LucideUnderlineCn Size="16" />
            </ToggleGroupItemCn>
        </ToggleGroupCn>
    </ComponentPreview>

    <ComponentPreview Title="Spacing" Code="@SpacingCode">
        <ToggleGroupCn Size="ToggleSize.Sm" Variant="ToggleVariant.Outline" Spacing="2" @bind-Value="_spacingSelected">
            <ToggleGroupItemCn Value="top" aria-label="Toggle top">Top</ToggleGroupItemCn>
            <ToggleGroupItemCn Value="bottom" aria-label="Toggle bottom">Bottom</ToggleGroupItemCn>
            <ToggleGroupItemCn Value="left" aria-label="Toggle left">Left</ToggleGroupItemCn>
            <ToggleGroupItemCn Value="right" aria-label="Toggle right">Right</ToggleGroupItemCn>
        </ToggleGroupCn>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div dir="rtl">
            <ToggleGroupCn Variant="ToggleVariant.Outline" @bind-Value="_rtlSelected">
                <ToggleGroupItemCn Value="list" aria-label="قائمة">قائمة</ToggleGroupItemCn>
                <ToggleGroupItemCn Value="grid" aria-label="شبكة">شبكة</ToggleGroupItemCn>
                <ToggleGroupItemCn Value="cards" aria-label="بطاقات">بطاقات</ToggleGroupItemCn>
            </ToggleGroupCn>
        </div>
    </ComponentPreview>
</div>

