@page "/docs/components/tooltip"
@layout DocsLayout

<PageTitle>Tooltip — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Tooltip</h1>
        <p class="mt-2 text-lg text-muted-foreground">A popup that displays information related to an element when the element receives keyboard focus or the mouse hovers over it.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Default" Code="@DefaultCode">
        <TooltipCn>
            <TooltipTriggerCn>
                <ButtonCn Variant="ButtonVariant.Outline">Hover</ButtonCn>
            </TooltipTriggerCn>
            <TooltipContentCn>
                <p>Add to library</p>
            </TooltipContentCn>
        </TooltipCn>
    </ComponentPreview>

    <ComponentPreview Title="Side Variations" Code="@SidesCode">
        <div class="flex flex-wrap gap-2">
            <TooltipCn>
                <TooltipTriggerCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Class="w-fit capitalize">Left</ButtonCn>
                </TooltipTriggerCn>
                <TooltipContentCn Side="FloatingSide.Left">
                    <p>Add to library</p>
                </TooltipContentCn>
            </TooltipCn>
            <TooltipCn>
                <TooltipTriggerCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Class="w-fit capitalize">Top</ButtonCn>
                </TooltipTriggerCn>
                <TooltipContentCn Side="FloatingSide.Top">
                    <p>Add to library</p>
                </TooltipContentCn>
            </TooltipCn>
            <TooltipCn>
                <TooltipTriggerCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Class="w-fit capitalize">Bottom</ButtonCn>
                </TooltipTriggerCn>
                <TooltipContentCn Side="FloatingSide.Bottom">
                    <p>Add to library</p>
                </TooltipContentCn>
            </TooltipCn>
            <TooltipCn>
                <TooltipTriggerCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Class="w-fit capitalize">Right</ButtonCn>
                </TooltipTriggerCn>
                <TooltipContentCn Side="FloatingSide.Right">
                    <p>Add to library</p>
                </TooltipContentCn>
            </TooltipCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="With Keyboard Shortcut" Code="@KeyboardCode">
        <TooltipCn>
            <TooltipTriggerCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.IconSm">
                    <LucideSaveCn />
                </ButtonCn>
            </TooltipTriggerCn>
            <TooltipContentCn>
                Save Changes <KbdCn>S</KbdCn>
            </TooltipContentCn>
        </TooltipCn>
    </ComponentPreview>

    <ComponentPreview Title="Disabled Button" Code="@DisabledCode">
        <TooltipCn>
            <TooltipTriggerCn>
                <span class="inline-block w-fit">
                    <ButtonCn Variant="ButtonVariant.Outline" Disabled="true">Disabled</ButtonCn>
                </span>
            </TooltipTriggerCn>
            <TooltipContentCn>
                <p>This feature is currently unavailable</p>
            </TooltipContentCn>
        </TooltipCn>
    </ComponentPreview>

    <ComponentPreview Title="Right-to-Left" Code="@RtlCode">
        <div class="flex flex-wrap gap-2">
            <TooltipCn>
                <TooltipTriggerCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Class="w-fit capitalize">&#x064A;&#x0633;&#x0627;&#x0631;</ButtonCn>
                </TooltipTriggerCn>
                <TooltipContentCn Side="FloatingSide.Left">&#x0625;&#x0636;&#x0627;&#x0641;&#x0629; &#x0625;&#x0644;&#x0649; &#x0627;&#x0644;&#x0645;&#x0643;&#x062A;&#x0628;&#x0629;</TooltipContentCn>
            </TooltipCn>
            <TooltipCn>
                <TooltipTriggerCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Class="w-fit capitalize">&#x0623;&#x0639;&#x0644;&#x0649;</ButtonCn>
                </TooltipTriggerCn>
                <TooltipContentCn Side="FloatingSide.Top">&#x0625;&#x0636;&#x0627;&#x0641;&#x0629; &#x0625;&#x0644;&#x0649; &#x0627;&#x0644;&#x0645;&#x0643;&#x062A;&#x0628;&#x0629;</TooltipContentCn>
            </TooltipCn>
            <TooltipCn>
                <TooltipTriggerCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Class="w-fit capitalize">&#x0623;&#x0633;&#x0641;&#x0644;</ButtonCn>
                </TooltipTriggerCn>
                <TooltipContentCn Side="FloatingSide.Bottom">&#x0625;&#x0636;&#x0627;&#x0641;&#x0629; &#x0625;&#x0644;&#x0649; &#x0627;&#x0644;&#x0645;&#x0643;&#x062A;&#x0628;&#x0629;</TooltipContentCn>
            </TooltipCn>
            <TooltipCn>
                <TooltipTriggerCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Class="w-fit capitalize">&#x064A;&#x0645;&#x064A;&#x0646;</ButtonCn>
                </TooltipTriggerCn>
                <TooltipContentCn Side="FloatingSide.Right">&#x0625;&#x0636;&#x0627;&#x0641;&#x0629; &#x0625;&#x0644;&#x0649; &#x0627;&#x0644;&#x0645;&#x0643;&#x062A;&#x0628;&#x0629;</TooltipContentCn>
            </TooltipCn>
        </div>
    </ComponentPreview>
</div>

