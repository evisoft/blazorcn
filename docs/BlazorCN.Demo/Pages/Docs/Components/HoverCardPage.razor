@page "/docs/components/hover-card"
@layout DocsLayout

<PageTitle>Hover Card — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Hover Card</h1>
        <p class="mt-2 text-lg text-muted-foreground">For sighted users to preview content behind a link.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <HoverCardCn OpenDelay="10" CloseDelay="100">
            <HoverCardTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-link cn-button-size-default" data-variant="link" data-size="default">Hover Here</HoverCardTriggerCn>
            <HoverCardContentCn Class="flex w-64 flex-col gap-0.5">
                <div class="font-semibold">@@nextjs</div>
                <div>The React Framework – created and maintained by @@vercel.</div>
                <div class="mt-1 text-xs text-muted-foreground">
                    Joined December 2021
                </div>
            </HoverCardContentCn>
        </HoverCardCn>
    </ComponentPreview>

    <ComponentPreview Title="Sides" Code="@SidesCode">
        <div class="flex flex-wrap justify-center gap-2">
            @foreach (var side in _sides)
            {
                <HoverCardCn OpenDelay="100" CloseDelay="100">
                    <HoverCardTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default capitalize" data-variant="outline" data-size="default">@side.ToString().ToLowerInvariant()</HoverCardTriggerCn>
                    <HoverCardContentCn Side="side">
                        <div class="flex flex-col gap-1">
                            <h4 class="font-medium">Hover Card</h4>
                            <p>This hover card appears on the @side.ToString().ToLowerInvariant() side of the trigger.</p>
                        </div>
                    </HoverCardContentCn>
                </HoverCardCn>
            }
        </div>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div class="flex flex-wrap justify-center gap-2">
            @foreach (var (side, label) in _rtlSides)
            {
                <HoverCardCn OpenDelay="10" CloseDelay="100">
                    <HoverCardTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">@label</HoverCardTriggerCn>
                    <HoverCardContentCn Side="side" Class="flex w-64 flex-col gap-1" dir="rtl">
                        <div class="font-semibold">سماعات لاسلكية</div>
                        <div class="text-sm text-muted-foreground">٩٩.٩٩ $</div>
                    </HoverCardContentCn>
                </HoverCardCn>
            }
        </div>
    </ComponentPreview>
</div>

@code {
    private static readonly FloatingSide[] _sides = [FloatingSide.Left, FloatingSide.Top, FloatingSide.Bottom, FloatingSide.Right];

    private static readonly (FloatingSide Side, string Label)[] _rtlSides =
    [
        (FloatingSide.Left, "يسار"),
        (FloatingSide.Top, "أعلى"),
        (FloatingSide.Bottom, "أسفل"),
        (FloatingSide.Right, "يمين"),
    ];

    private const string DemoCode = @"<HoverCardCn OpenDelay=""10"" CloseDelay=""100"">
    <HoverCardTriggerCn Class=""cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-link cn-button-size-default"" data-variant=""link"" data-size=""default"">Hover Here</HoverCardTriggerCn>
    <HoverCardContentCn Class=""flex w-64 flex-col gap-0.5"">
        <div class=""font-semibold"">@@nextjs</div>
        <div>The React Framework – created and maintained by @@vercel.</div>
        <div class=""mt-1 text-xs text-muted-foreground"">
            Joined December 2021
        </div>
    </HoverCardContentCn>
</HoverCardCn>";

    private const string SidesCode = @"<div class=""flex flex-wrap justify-center gap-2"">
    @foreach (var side in new[] { FloatingSide.Left, FloatingSide.Top, FloatingSide.Bottom, FloatingSide.Right })
    {
        <HoverCardCn OpenDelay=""100"" CloseDelay=""100"">
            <HoverCardTriggerCn Class=""cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default capitalize"" data-variant=""outline"" data-size=""default"">@side.ToString().ToLowerInvariant()</HoverCardTriggerCn>
            <HoverCardContentCn Side=""side"">
                <div class=""flex flex-col gap-1"">
                    <h4 class=""font-medium"">Hover Card</h4>
                    <p>This hover card appears on the @side.ToString().ToLowerInvariant() side of the trigger.</p>
                </div>
            </HoverCardContentCn>
        </HoverCardCn>
    }
</div>";

    private const string RtlCode = @"<div class=""flex flex-wrap justify-center gap-2"">
    <HoverCardCn OpenDelay=""10"" CloseDelay=""100"">
        <HoverCardTriggerCn Class=""cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default"" data-variant=""outline"" data-size=""default"">يسار</HoverCardTriggerCn>
        <HoverCardContentCn Side=""FloatingSide.Left"" Class=""flex w-64 flex-col gap-1"" dir=""rtl"">
            <div class=""font-semibold"">سماعات لاسلكية</div>
            <div class=""text-sm text-muted-foreground"">٩٩.٩٩ $</div>
        </HoverCardContentCn>
    </HoverCardCn>
    <!-- Repeat for Top, Bottom, Right -->
</div>";
}
