@page "/docs/components/popover"
@layout DocsLayout

<PageTitle>Popover — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Popover</h1>
        <p class="mt-2 text-lg text-muted-foreground">Displays rich content in a portal, triggered by a button.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <PopoverCn>
            <PopoverTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">Open popover</PopoverTriggerCn>
            <PopoverContentCn Class="w-80">
                <div class="grid gap-4">
                    <div class="space-y-2">
                        <h4 class="leading-none font-medium">Dimensions</h4>
                        <p class="text-sm text-muted-foreground">Set the dimensions for the layer.</p>
                    </div>
                    <div class="grid gap-2">
                        <div class="grid grid-cols-3 items-center gap-4">
                            <LabelCn For="width">Width</LabelCn>
                            <InputCn id="width" Class="col-span-2 h-8" Value="100%" />
                        </div>
                        <div class="grid grid-cols-3 items-center gap-4">
                            <LabelCn For="maxWidth">Max. width</LabelCn>
                            <InputCn id="maxWidth" Class="col-span-2 h-8" Value="300px" />
                        </div>
                        <div class="grid grid-cols-3 items-center gap-4">
                            <LabelCn For="height">Height</LabelCn>
                            <InputCn id="height" Class="col-span-2 h-8" Value="25px" />
                        </div>
                        <div class="grid grid-cols-3 items-center gap-4">
                            <LabelCn For="maxHeight">Max. height</LabelCn>
                            <InputCn id="maxHeight" Class="col-span-2 h-8" Value="none" />
                        </div>
                    </div>
                </div>
            </PopoverContentCn>
        </PopoverCn>
    </ComponentPreview>

    <ComponentPreview Title="Basic" Code="@BasicCode">
        <PopoverCn>
            <PopoverTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">Open Popover</PopoverTriggerCn>
            <PopoverContentCn Align="FloatingAlign.Start">
                <PopoverHeaderCn>
                    <PopoverTitleCn>Dimensions</PopoverTitleCn>
                    <PopoverDescriptionCn>Set the dimensions for the layer.</PopoverDescriptionCn>
                </PopoverHeaderCn>
            </PopoverContentCn>
        </PopoverCn>
    </ComponentPreview>

    <ComponentPreview Title="Alignments" Code="@AlignmentsCode">
        <div class="flex gap-6">
            <PopoverCn>
                <PopoverTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-sm" data-variant="outline" data-size="sm">Start</PopoverTriggerCn>
                <PopoverContentCn Align="FloatingAlign.Start" Class="w-40">
                    Aligned to start
                </PopoverContentCn>
            </PopoverCn>
            <PopoverCn>
                <PopoverTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-sm" data-variant="outline" data-size="sm">Center</PopoverTriggerCn>
                <PopoverContentCn Align="FloatingAlign.Center" Class="w-40">
                    Aligned to center
                </PopoverContentCn>
            </PopoverCn>
            <PopoverCn>
                <PopoverTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-sm" data-variant="outline" data-size="sm">End</PopoverTriggerCn>
                <PopoverContentCn Align="FloatingAlign.End" Class="w-40">
                    Aligned to end
                </PopoverContentCn>
            </PopoverCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Form" Code="@FormCode">
        <PopoverCn>
            <PopoverTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">Open Popover</PopoverTriggerCn>
            <PopoverContentCn Class="w-64" Align="FloatingAlign.Start">
                <PopoverHeaderCn>
                    <PopoverTitleCn>Dimensions</PopoverTitleCn>
                    <PopoverDescriptionCn>Set the dimensions for the layer.</PopoverDescriptionCn>
                </PopoverHeaderCn>
                <div class="grid gap-4 pt-4">
                    <div class="flex items-center gap-4">
                        <LabelCn For="form-width" Class="w-1/2">Width</LabelCn>
                        <InputCn id="form-width" Value="100%" />
                    </div>
                    <div class="flex items-center gap-4">
                        <LabelCn For="form-height" Class="w-1/2">Height</LabelCn>
                        <InputCn id="form-height" Value="25px" />
                    </div>
                </div>
            </PopoverContentCn>
        </PopoverCn>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div class="flex flex-wrap justify-center gap-2">
            @foreach (var (side, label) in _rtlSides)
            {
                <PopoverCn>
                    <PopoverTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">@label</PopoverTriggerCn>
                    <PopoverContentCn Side="side" dir="rtl">
                        <PopoverHeaderCn>
                            <PopoverTitleCn>الأبعاد</PopoverTitleCn>
                            <PopoverDescriptionCn>تعيين الأبعاد للطبقة.</PopoverDescriptionCn>
                        </PopoverHeaderCn>
                    </PopoverContentCn>
                </PopoverCn>
            }
        </div>
    </ComponentPreview>
</div>

