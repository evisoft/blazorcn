    <PopoverCn>
        <PopoverTriggerCn Class=""cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default w-[240px] justify-start font-normal"" data-variant=""outline"" data-size=""default"">
                <!-- Calendar icon -->
                @if (_date.HasValue)
                {
                    @_date.Value.ToString(""MMMM dd, yyyy"")
                }
                else
                {
                    <span class=""text-muted-foreground"">Pick a date</span>
                }
            </PopoverTriggerCn>
        <PopoverContentCn Class=""w-auto p-0"" Align=""FloatingAlign.Start"">
            <CalendarCn @bind-Value=""_date"" />
        </PopoverContentCn>
    </PopoverCn>
</div>

