@page "/docs/components/date-picker"
@layout DocsLayout

<PageTitle>Date Picker — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Date Picker</h1>
        <p class="mt-2 text-lg text-muted-foreground">A date picker built using a composition of Popover, Calendar, and Button.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <PopoverCn>
            <PopoverTriggerCn Class="@Cn.Merge("cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default w-[240px] justify-between text-left font-normal", _demoDate is null ? "text-muted-foreground" : "")" data-variant="outline" data-size="default">
                    @if (_demoDate.HasValue)
                    {
                        @_demoDate.Value.ToString("MMMM dd, yyyy")
                    }
                    else
                    {
                        <span>Pick a date</span>
                    }
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-auto size-4 opacity-50" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </PopoverTriggerCn>
            <PopoverContentCn Class="w-auto p-0" Align="FloatingAlign.Start">
                <CalendarCn @bind-Value="_demoDate" />
            </PopoverContentCn>
        </PopoverCn>
    </ComponentPreview>

    <ComponentPreview Title="Basic" Code="@BasicCode">
        <div class="space-y-2">
            <LabelCn>Date</LabelCn>
            <PopoverCn>
                <PopoverTriggerCn Class="@Cn.Merge("cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default w-[240px] justify-start font-normal", _basicDate is null ? "text-muted-foreground" : "")" data-variant="outline" data-size="default">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 size-4" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                        @if (_basicDate.HasValue)
                        {
                            @_basicDate.Value.ToString("MMMM dd, yyyy")
                        }
                        else
                        {
                            <span>Pick a date</span>
                        }
                    </PopoverTriggerCn>
                <PopoverContentCn Class="w-auto p-0" Align="FloatingAlign.Start">
                    <CalendarCn @bind-Value="_basicDate" />
                </PopoverContentCn>
            </PopoverCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Date of Birth" Code="@DobCode">
        <div class="space-y-2">
            <LabelCn>Date of birth</LabelCn>
            <PopoverCn @bind-Open="_dobOpen">
                <PopoverTriggerCn Class="@Cn.Merge("cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default w-[240px] justify-start font-normal", _dobDate is null ? "text-muted-foreground" : "")" data-variant="outline" data-size="default">
                        @if (_dobDate.HasValue)
                        {
                            @_dobDate.Value.ToString("MMMM dd, yyyy")
                        }
                        else
                        {
                            <span>Select date</span>
                        }
                    </PopoverTriggerCn>
                <PopoverContentCn Class="w-auto overflow-hidden p-0" Align="FloatingAlign.Start">
                    <div class="flex flex-col gap-2 p-3 pb-0">
                        <div class="flex gap-2">
                            <NativeSelectCn Value="@_dobMonth.ToString()" ValueChanged="DobMonthChanged" Class="flex-1">
                                @for (int m = 1; m <= 12; m++)
                                {
                                    var month = m;
                                    <option value="@month">@(new DateTime(2000, month, 1).ToString("MMMM"))</option>
                                }
                            </NativeSelectCn>
                            <NativeSelectCn Value="@_dobYear.ToString()" ValueChanged="DobYearChanged" Class="w-24">
                                @for (int y = DateTime.Today.Year; y >= 1900; y--)
                                {
                                    <option value="@y">@y</option>
                                }
                            </NativeSelectCn>
                        </div>
                    </div>
                    <CalendarCn Value="_dobDate" ValueChanged="DobDateSelected"
                                @bind-DisplayMonth:get="DobDisplayMonth" @bind-DisplayMonth:set="DobDisplayMonthChanged"
                                MinDate="@(new DateTime(1900, 1, 1))" MaxDate="@DateTime.Today" />
                </PopoverContentCn>
            </PopoverCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="With Presets" Code="@PresetsCode">
        <PopoverCn>
            <PopoverTriggerCn Class="@Cn.Merge("cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default w-[240px] justify-between text-left font-normal", _presetsDate is null ? "text-muted-foreground" : "")" data-variant="outline" data-size="default">
                    @if (_presetsDate.HasValue)
                    {
                        @_presetsDate.Value.ToString("MMMM dd, yyyy")
                    }
                    else
                    {
                        <span>Pick a date</span>
                    }
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-auto size-4 opacity-50" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </PopoverTriggerCn>
            <PopoverContentCn Class="w-auto p-0" Align="FloatingAlign.Start">
                <CalendarCn @bind-Value="_presetsDate" />
                <div class="flex gap-2 border-t p-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="flex-1"
                              OnClick="@(() => _presetsDate = DateTime.Today)">Today</ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="flex-1"
                              OnClick="@(() => _presetsDate = DateTime.Today.AddDays(1))">Tomorrow</ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="flex-1"
                              OnClick="@(() => _presetsDate = DateTime.Today.AddDays(7))">In a week</ButtonCn>
                </div>
            </PopoverContentCn>
        </PopoverCn>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div dir="rtl">
            <PopoverCn>
                <PopoverTriggerCn Class="@Cn.Merge("cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default w-[240px] justify-between text-right font-normal", _rtlDate is null ? "text-muted-foreground" : "")" data-variant="outline" data-size="default">
                        @if (_rtlDate.HasValue)
                        {
                            @_rtlDate.Value.ToString("MMMM dd, yyyy")
                        }
                        else
                        {
                            <span>اختر تاريخًا</span>
                        }
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-auto size-4 opacity-50" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </PopoverTriggerCn>
                <PopoverContentCn Class="w-auto p-0" Align="FloatingAlign.Start">
                    <CalendarCn @bind-Value="_rtlDate" />
                </PopoverContentCn>
            </PopoverCn>
        </div>
    </ComponentPreview>
</div>

@code {
    private DateTime? _demoDate;
    private DateTime? _basicDate;
    private DateTime? _dobDate;
    private bool _dobOpen;
    private int _dobMonth = DateTime.Today.Month;
    private int _dobYear = DateTime.Today.Year;
    private DateTime? _presetsDate;
    private DateTime? _rtlDate;

    // The dropdowns are the source of truth for the visible month; the calendar
    // binds to it via @bind-DisplayMonth so both stay in sync in either direction.
    private DateTime? DobDisplayMonth => new DateTime(_dobYear, _dobMonth, 1);

    private void DobDisplayMonthChanged(DateTime? month)
    {
        if (month.HasValue)
        {
            _dobMonth = month.Value.Month;
            _dobYear = month.Value.Year;
        }
    }

    private void DobMonthChanged(string value)
    {
        if (int.TryParse(value, out var month))
        {
            _dobMonth = month;
        }
    }

    private void DobYearChanged(string value)
    {
        if (int.TryParse(value, out var year))
        {
            _dobYear = year;
        }
    }

    private void DobDateSelected(DateTime? date)
    {
        _dobDate = date;
        _dobOpen = false;
    }

    private const string DemoCode = @"<PopoverCn>
    <PopoverTriggerCn Class=""cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default w-[240px] justify-between text-left font-normal"" data-variant=""outline"" data-size=""default"">
            @if (_date.HasValue)
            {
                @_date.Value.ToString(""MMMM dd, yyyy"")
            }
            else
            {
                <span class=""text-muted-foreground"">Pick a date</span>
            }
            <!-- ChevronDown icon -->
        </PopoverTriggerCn>
    <PopoverContentCn Class=""w-auto p-0"" Align=""FloatingAlign.Start"">
        <CalendarCn @bind-Value=""_date"" />
    </PopoverContentCn>
</PopoverCn>

@code {
    private DateTime? _date;
}";

    private const string BasicCode = @"<div class=""space-y-2"">
