@page "/docs/components/badge"
@layout DocsLayout

<PageTitle>Badge — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Badge</h1>
        <p class="mt-2 text-lg text-muted-foreground">Displays a badge or a component that looks like a badge.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Default" Code="@DefaultCode">
        <div class="flex w-full flex-wrap justify-center gap-2">
            <BadgeCn>Badge</BadgeCn>
            <BadgeCn Variant="BadgeVariant.Secondary">Secondary</BadgeCn>
            <BadgeCn Variant="BadgeVariant.Destructive">Destructive</BadgeCn>
            <BadgeCn Variant="BadgeVariant.Outline">Outline</BadgeCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Variants" Code="@VariantsCode">
        <div class="flex flex-wrap gap-2">
            <BadgeCn>Default</BadgeCn>
            <BadgeCn Variant="BadgeVariant.Secondary">Secondary</BadgeCn>
            <BadgeCn Variant="BadgeVariant.Destructive">Destructive</BadgeCn>
            <BadgeCn Variant="BadgeVariant.Outline">Outline</BadgeCn>
            <BadgeCn Variant="BadgeVariant.Ghost">Ghost</BadgeCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Custom Colors" Code="@ColorsCode">
        <div class="flex flex-wrap gap-2">
            <BadgeCn Class="bg-blue-50 text-blue-700 dark:bg-blue-950 dark:text-blue-300">Blue</BadgeCn>
            <BadgeCn Class="bg-green-50 text-green-700 dark:bg-green-950 dark:text-green-300">Green</BadgeCn>
            <BadgeCn Class="bg-sky-50 text-sky-700 dark:bg-sky-950 dark:text-sky-300">Sky</BadgeCn>
            <BadgeCn Class="bg-purple-50 text-purple-700 dark:bg-purple-950 dark:text-purple-300">Purple</BadgeCn>
            <BadgeCn Class="bg-red-50 text-red-700 dark:bg-red-950 dark:text-red-300">Red</BadgeCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="With Icon" Code="@IconCode">
        <div class="flex flex-wrap gap-2">
            <BadgeCn Variant="BadgeVariant.Secondary">
                <LucideBadgeCheckCn Size="14" data-icon="inline-start" />
                Verified
            </BadgeCn>
            <BadgeCn Variant="BadgeVariant.Outline">
                Bookmark
                <LucideBookmarkCn Size="14" data-icon="inline-end" />
            </BadgeCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="As Link" Code="@LinkCode">
        <a href="#link" class="inline-flex">
            <BadgeCn>
                Open Link
                <LucideArrowUpRightCn Size="14" data-icon="inline-end" />
            </BadgeCn>
        </a>
    </ComponentPreview>

    <ComponentPreview Title="With Spinner" Code="@SpinnerCode">
        <div class="flex flex-wrap gap-2">
            <BadgeCn Variant="BadgeVariant.Destructive">
                <SpinnerCn Class="size-3" data-icon="inline-start" />
                Deleting
            </BadgeCn>
            <BadgeCn Variant="BadgeVariant.Secondary">
                Generating
                <SpinnerCn Class="size-3" data-icon="inline-end" />
            </BadgeCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div class="flex w-full flex-wrap justify-center gap-2" dir="rtl">
            <BadgeCn>شارة</BadgeCn>
            <BadgeCn Variant="BadgeVariant.Secondary">ثانوي</BadgeCn>
            <BadgeCn Variant="BadgeVariant.Destructive">مدمر</BadgeCn>
            <BadgeCn Variant="BadgeVariant.Outline">مخطط</BadgeCn>
            <BadgeCn Variant="BadgeVariant.Secondary">
                <LucideBadgeCheckCn Size="14" data-icon="inline-start" />
                متحقق
            </BadgeCn>
            <BadgeCn Variant="BadgeVariant.Outline">
                إشارة مرجعية
                <LucideBookmarkCn Size="14" data-icon="inline-end" />
            </BadgeCn>
        </div>
    </ComponentPreview>
</div>

