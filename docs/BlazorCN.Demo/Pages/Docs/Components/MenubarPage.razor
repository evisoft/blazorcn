@page "/docs/components/menubar"
@layout DocsLayout

<PageTitle>Menubar — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Menubar</h1>
        <p class="mt-2 text-lg text-muted-foreground">A visually persistent menu common in desktop applications, providing quick access to a consistent set of commands.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <MenubarCn Class="w-72">
            <MenubarMenuCn>
                <MenubarTriggerCn>File</MenubarTriggerCn>
                <MenubarContentCn>
                    <MenubarGroupCn>
                        <MenubarItemCn>
                            New Tab <MenubarShortcutCn>&#x2318;T</MenubarShortcutCn>
                        </MenubarItemCn>
                        <MenubarItemCn>
                            New Window <MenubarShortcutCn>&#x2318;N</MenubarShortcutCn>
                        </MenubarItemCn>
                        <MenubarItemCn Disabled="true">New Incognito Window</MenubarItemCn>
                    </MenubarGroupCn>
                    <MenubarSeparatorCn />
                    <MenubarGroupCn>
                        <MenubarSubCn>
                            <MenubarSubTriggerCn>Share</MenubarSubTriggerCn>
                            <MenubarSubContentCn>
                                <MenubarGroupCn>
                                    <MenubarItemCn>Email link</MenubarItemCn>
                                    <MenubarItemCn>Messages</MenubarItemCn>
                                    <MenubarItemCn>Notes</MenubarItemCn>
                                </MenubarGroupCn>
                            </MenubarSubContentCn>
                        </MenubarSubCn>
                    </MenubarGroupCn>
                    <MenubarSeparatorCn />
                    <MenubarGroupCn>
                        <MenubarItemCn>
                            Print... <MenubarShortcutCn>&#x2318;P</MenubarShortcutCn>
                        </MenubarItemCn>
                    </MenubarGroupCn>
                </MenubarContentCn>
            </MenubarMenuCn>
            <MenubarMenuCn>
                <MenubarTriggerCn>Edit</MenubarTriggerCn>
                <MenubarContentCn>
                    <MenubarGroupCn>
                        <MenubarItemCn>
                            Undo <MenubarShortcutCn>&#x2318;Z</MenubarShortcutCn>
                        </MenubarItemCn>
                        <MenubarItemCn>
                            Redo <MenubarShortcutCn>&#x21E7;&#x2318;Z</MenubarShortcutCn>
                        </MenubarItemCn>
                    </MenubarGroupCn>
                    <MenubarSeparatorCn />
                    <MenubarGroupCn>
                        <MenubarSubCn>
                            <MenubarSubTriggerCn>Find</MenubarSubTriggerCn>
                            <MenubarSubContentCn>
                                <MenubarGroupCn>
                                    <MenubarItemCn>Search the web</MenubarItemCn>
                                </MenubarGroupCn>
                                <MenubarSeparatorCn />
                                <MenubarGroupCn>
                                    <MenubarItemCn>Find...</MenubarItemCn>
                                    <MenubarItemCn>Find Next</MenubarItemCn>
                                    <MenubarItemCn>Find Previous</MenubarItemCn>
                                </MenubarGroupCn>
                            </MenubarSubContentCn>
                        </MenubarSubCn>
                    </MenubarGroupCn>
                    <MenubarSeparatorCn />
                    <MenubarGroupCn>
                        <MenubarItemCn>Cut</MenubarItemCn>
                        <MenubarItemCn>Copy</MenubarItemCn>
                        <MenubarItemCn>Paste</MenubarItemCn>
                    </MenubarGroupCn>
                </MenubarContentCn>
            </MenubarMenuCn>
            <MenubarMenuCn>
                <MenubarTriggerCn>View</MenubarTriggerCn>
                <MenubarContentCn Class="w-44">
                    <MenubarGroupCn>
                        <MenubarCheckboxItemCn>Bookmarks Bar</MenubarCheckboxItemCn>
                        <MenubarCheckboxItemCn Checked="true">Full URLs</MenubarCheckboxItemCn>
                    </MenubarGroupCn>
                    <MenubarSeparatorCn />
                    <MenubarGroupCn>
                        <MenubarItemCn Inset="true">
                            Reload <MenubarShortcutCn>&#x2318;R</MenubarShortcutCn>
                        </MenubarItemCn>
                        <MenubarItemCn Disabled="true" Inset="true">
                            Force Reload <MenubarShortcutCn>&#x21E7;&#x2318;R</MenubarShortcutCn>
                        </MenubarItemCn>
                    </MenubarGroupCn>
                    <MenubarSeparatorCn />
                    <MenubarGroupCn>
                        <MenubarItemCn Inset="true">Toggle Fullscreen</MenubarItemCn>
                    </MenubarGroupCn>
                    <MenubarSeparatorCn />
                    <MenubarGroupCn>
                        <MenubarItemCn Inset="true">Hide Sidebar</MenubarItemCn>
                    </MenubarGroupCn>
                </MenubarContentCn>
            </MenubarMenuCn>
            <MenubarMenuCn>
                <MenubarTriggerCn>Profiles</MenubarTriggerCn>
                <MenubarContentCn>
                    <MenubarRadioGroupCn Value="benoit">
                        <MenubarRadioItemCn Value="andy">Andy</MenubarRadioItemCn>
                        <MenubarRadioItemCn Value="benoit">Benoit</MenubarRadioItemCn>
                        <MenubarRadioItemCn Value="Luis">Luis</MenubarRadioItemCn>
                    </MenubarRadioGroupCn>
                    <MenubarSeparatorCn />
                    <MenubarGroupCn>
                        <MenubarItemCn Inset="true">Edit...</MenubarItemCn>
                    </MenubarGroupCn>
                    <MenubarSeparatorCn />
                    <MenubarGroupCn>
                        <MenubarItemCn Inset="true">Add Profile...</MenubarItemCn>
                    </MenubarGroupCn>
                </MenubarContentCn>
            </MenubarMenuCn>
        </MenubarCn>
    </ComponentPreview>

