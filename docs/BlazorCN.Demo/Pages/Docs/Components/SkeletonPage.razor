@page "/docs/components/skeleton"
@layout DocsLayout

<PageTitle>Skeleton — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Skeleton</h1>
        <p class="mt-2 text-lg text-muted-foreground">Use to show a placeholder while content is loading.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Default" Code="@DefaultCode">
        <div class="flex items-center gap-4">
            <SkeletonCn Class="h-12 w-12 rounded-full" />
            <div class="space-y-2">
                <SkeletonCn Class="h-4 w-[250px]" />
                <SkeletonCn Class="h-4 w-[200px]" />
            </div>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Avatar" Code="@AvatarCode">
        <div class="flex w-fit items-center gap-4">
            <SkeletonCn Class="size-10 shrink-0 rounded-full" />
            <div class="grid gap-2">
                <SkeletonCn Class="h-4 w-[150px]" />
                <SkeletonCn Class="h-4 w-[100px]" />
            </div>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Text" Code="@TextCode">
        <div class="flex w-full max-w-xs flex-col gap-2">
            <SkeletonCn Class="h-4 w-full" />
            <SkeletonCn Class="h-4 w-full" />
            <SkeletonCn Class="h-4 w-3/4" />
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Card" Code="@CardCode">
        <CardCn Class="w-full max-w-xs">
            <CardHeaderCn>
                <SkeletonCn Class="h-4 w-2/3" />
                <SkeletonCn Class="h-4 w-1/2" />
            </CardHeaderCn>
            <CardContentCn>
                <SkeletonCn Class="aspect-video w-full" />
            </CardContentCn>
        </CardCn>
    </ComponentPreview>

    <ComponentPreview Title="Table" Code="@TableCode">
        <div class="flex w-full max-w-sm flex-col gap-2">
            @for (int i = 0; i < 5; i++)
            {
                <div class="flex gap-4">
                    <SkeletonCn Class="h-4 flex-1" />
                    <SkeletonCn Class="h-4 w-24" />
                    <SkeletonCn Class="h-4 w-20" />
                </div>
            }
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Form" Code="@FormCode">
        <div class="flex w-full max-w-xs flex-col gap-7">
            <div class="flex flex-col gap-3">
                <SkeletonCn Class="h-4 w-20" />
                <SkeletonCn Class="h-8 w-full" />
            </div>
            <div class="flex flex-col gap-3">
                <SkeletonCn Class="h-4 w-24" />
                <SkeletonCn Class="h-8 w-full" />
            </div>
            <SkeletonCn Class="h-8 w-24" />
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Right-to-Left" Code="@RtlCode">
        <div class="flex items-center gap-4" dir="rtl">
            <SkeletonCn Class="h-12 w-12 rounded-full" />
            <div class="space-y-2">
                <SkeletonCn Class="h-4 w-[250px]" />
                <SkeletonCn Class="h-4 w-[200px]" />
            </div>
        </div>
    </ComponentPreview>
</div>

@code {
    private const string DefaultCode = @"<div class=""flex items-center gap-4"">
    <SkeletonCn Class=""h-12 w-12 rounded-full"" />
    <div class=""space-y-2"">
        <SkeletonCn Class=""h-4 w-[250px]"" />
        <SkeletonCn Class=""h-4 w-[200px]"" />
    </div>
</div>";
    private const string AvatarCode = @"<div class=""flex w-fit items-center gap-4"">
    <SkeletonCn Class=""size-10 shrink-0 rounded-full"" />
    <div class=""grid gap-2"">
        <SkeletonCn Class=""h-4 w-[150px]"" />
        <SkeletonCn Class=""h-4 w-[100px]"" />
    </div>
</div>";
    private const string TextCode = @"<div class=""flex w-full max-w-xs flex-col gap-2"">
    <SkeletonCn Class=""h-4 w-full"" />
    <SkeletonCn Class=""h-4 w-full"" />
    <SkeletonCn Class=""h-4 w-3/4"" />
</div>";
    private const string CardCode = @"<CardCn Class=""w-full max-w-xs"">
    <CardHeaderCn>
        <SkeletonCn Class=""h-4 w-2/3"" />
        <SkeletonCn Class=""h-4 w-1/2"" />
    </CardHeaderCn>
    <CardContentCn>
        <SkeletonCn Class=""aspect-video w-full"" />
    </CardContentCn>
</CardCn>";
    private const string TableCode = @"<div class=""flex w-full max-w-sm flex-col gap-2"">
    @for (int i = 0; i < 5; i++)
    {
        <div class=""flex gap-4"">
