@page "/docs/components/radio-group"
@layout DocsLayout

<PageTitle>Radio Group — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Radio Group</h1>
        <p class="mt-2 text-lg text-muted-foreground">A set of checkable buttons where only one can be checked at a time.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Demo" Code="@DemoCode">
        <RadioGroupCn Value="comfortable" Class="w-fit">
            <div class="flex items-center gap-3">
                <RadioGroupItemCn Value="default" id="r1" />
                <LabelCn For="r1">Default</LabelCn>
            </div>
            <div class="flex items-center gap-3">
                <RadioGroupItemCn Value="comfortable" id="r2" />
                <LabelCn For="r2">Comfortable</LabelCn>
            </div>
            <div class="flex items-center gap-3">
                <RadioGroupItemCn Value="compact" id="r3" />
                <LabelCn For="r3">Compact</LabelCn>
            </div>
        </RadioGroupCn>
    </ComponentPreview>

    <ComponentPreview Title="Fields" Code="@FieldsCode">
        <div class="flex w-full flex-col gap-5">
            <FieldSetCn>
                <FieldLegendCn Variant="FieldLegendVariant.Label">Subscription Plan</FieldLegendCn>
                <RadioGroupCn Value="free">
                    <FieldCn Orientation="FieldOrientation.Horizontal">
                        <RadioGroupItemCn Value="free" id="radio-free" />
                        <FieldLabelCn For="radio-free" Class="font-normal">Free Plan</FieldLabelCn>
                    </FieldCn>
                    <FieldCn Orientation="FieldOrientation.Horizontal">
                        <RadioGroupItemCn Value="pro" id="radio-pro" />
                        <FieldLabelCn For="radio-pro" Class="font-normal">Pro Plan</FieldLabelCn>
                    </FieldCn>
                    <FieldCn Orientation="FieldOrientation.Horizontal">
                        <RadioGroupItemCn Value="enterprise" id="radio-enterprise" />
                        <FieldLabelCn For="radio-enterprise" Class="font-normal">Enterprise</FieldLabelCn>
                    </FieldCn>
                </RadioGroupCn>
            </FieldSetCn>
            <FieldSetCn>
                <FieldLegendCn Variant="FieldLegendVariant.Label">Battery Level</FieldLegendCn>
                <FieldDescriptionCn>Choose your preferred battery level.</FieldDescriptionCn>
                <RadioGroupCn @bind-Value="_batteryLevel">
                    <FieldCn Orientation="FieldOrientation.Horizontal">
                        <RadioGroupItemCn Value="high" id="battery-high" />
                        <FieldLabelCn For="battery-high">High</FieldLabelCn>
                    </FieldCn>
                    <FieldCn Orientation="FieldOrientation.Horizontal">
                        <RadioGroupItemCn Value="medium" id="battery-medium" />
                        <FieldLabelCn For="battery-medium">Medium</FieldLabelCn>
                    </FieldCn>
                    <FieldCn Orientation="FieldOrientation.Horizontal">
                        <RadioGroupItemCn Value="low" id="battery-low" />
                        <FieldLabelCn For="battery-low">Low</FieldLabelCn>
                    </FieldCn>
                </RadioGroupCn>
            </FieldSetCn>
            <RadioGroupCn Class="gap-6" @bind-Value="_touchOption">
                <FieldCn Orientation="FieldOrientation.Horizontal">
                    <RadioGroupItemCn Value="option1" id="radio-content-1" />
                    <FieldContentCn>
                        <FieldLabelCn For="radio-content-1">Enable Touch ID</FieldLabelCn>
                        <FieldDescriptionCn>Enable Touch ID to quickly unlock your device.</FieldDescriptionCn>
                    </FieldContentCn>
                </FieldCn>
                <FieldCn Orientation="FieldOrientation.Horizontal">
                    <RadioGroupItemCn Value="option2" id="radio-content-2" />
                    <FieldContentCn>
                        <FieldLabelCn For="radio-content-2">Enable Touch ID and Face ID to make it even faster to unlock your device. This is a long label to test the layout.</FieldLabelCn>
                        <FieldDescriptionCn>Enable Touch ID to quickly unlock your device.</FieldDescriptionCn>
                    </FieldContentCn>
                </FieldCn>
            </RadioGroupCn>
            <RadioGroupCn Class="gap-3" @bind-Value="_titleOption">
                <label class="flex w-fit gap-2 leading-snug w-full flex-col rounded-lg border has-[:checked]:border-primary/30 has-[:checked]:bg-primary/5 dark:has-[:checked]:border-primary/20 dark:has-[:checked]:bg-primary/10" for="radio-title-1">
                    <FieldCn Orientation="FieldOrientation.Horizontal" Class="p-2.5">
                        <RadioGroupItemCn Value="title1" id="radio-title-1" />
                        <FieldContentCn>
                            <FieldTitleCn>Enable Touch ID</FieldTitleCn>
                            <FieldDescriptionCn>Enable Touch ID to quickly unlock your device.</FieldDescriptionCn>
                        </FieldContentCn>
                    </FieldCn>
                </label>
                <label class="flex w-fit gap-2 leading-snug w-full flex-col rounded-lg border has-[:checked]:border-primary/30 has-[:checked]:bg-primary/5 dark:has-[:checked]:border-primary/20 dark:has-[:checked]:bg-primary/10" for="radio-title-2">
                    <FieldCn Orientation="FieldOrientation.Horizontal" Class="p-2.5">
                        <RadioGroupItemCn Value="title2" id="radio-title-2" />
                        <FieldContentCn>
                            <FieldTitleCn>Enable Touch ID and Face ID to make it even faster to unlock your device. This is a long label to test the layout.</FieldTitleCn>
                            <FieldDescriptionCn>Enable Touch ID to quickly unlock your device.</FieldDescriptionCn>
                        </FieldContentCn>
                    </FieldCn>
                </label>
            </RadioGroupCn>
            <FieldSetCn>
                <FieldLegendCn Variant="FieldLegendVariant.Label">Invalid Radio Group</FieldLegendCn>
                <RadioGroupCn @bind-Value="_invalidOption">
                    <FieldCn Orientation="FieldOrientation.Horizontal" data-invalid="true">
                        <RadioGroupItemCn Value="invalid1" id="radio-invalid-1" aria-invalid="true" />
                        <FieldLabelCn For="radio-invalid-1">Invalid Option 1</FieldLabelCn>
                    </FieldCn>
                    <FieldCn Orientation="FieldOrientation.Horizontal" data-invalid="true">
                        <RadioGroupItemCn Value="invalid2" id="radio-invalid-2" aria-invalid="true" />
                        <FieldLabelCn For="radio-invalid-2">Invalid Option 2</FieldLabelCn>
                    </FieldCn>
                </RadioGroupCn>
            </FieldSetCn>
            <FieldSetCn>
                <FieldLegendCn Variant="FieldLegendVariant.Label">Disabled Radio Group</FieldLegendCn>
                <RadioGroupCn @bind-Value="_disabledFieldsOption">
                    <FieldCn Orientation="FieldOrientation.Horizontal" data-disabled="true">
                        <RadioGroupItemCn Value="disabled1" id="radio-disabled-1" Disabled="true" />
                        <FieldLabelCn For="radio-disabled-1">Disabled Option 1</FieldLabelCn>
                    </FieldCn>
                    <FieldCn Orientation="FieldOrientation.Horizontal" data-disabled="true">
                        <RadioGroupItemCn Value="disabled2" id="radio-disabled-2" Disabled="true" />
                        <FieldLabelCn For="radio-disabled-2">Disabled Option 2</FieldLabelCn>
                    </FieldCn>
                </RadioGroupCn>
            </FieldSetCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Choice Card" Code="@ChoiceCardCode">
        <RadioGroupCn Value="plus" Class="max-w-sm">
            <label class="flex w-fit gap-2 leading-snug w-full flex-col rounded-lg border has-[:checked]:border-primary/30 has-[:checked]:bg-primary/5 dark:has-[:checked]:border-primary/20 dark:has-[:checked]:bg-primary/10" for="plus-plan">
                <div class="group/field flex w-full flex-row items-center gap-2 p-2.5">
                    <div class="flex flex-1 flex-col gap-0.5 leading-snug">
                        <span class="flex w-fit items-center gap-2 text-sm leading-snug font-medium">Plus</span>
                        <p class="text-sm text-muted-foreground">For individuals and small teams.</p>
                    </div>
                    <RadioGroupItemCn Value="plus" id="plus-plan" />
                </div>
            </label>
            <label class="flex w-fit gap-2 leading-snug w-full flex-col rounded-lg border has-[:checked]:border-primary/30 has-[:checked]:bg-primary/5 dark:has-[:checked]:border-primary/20 dark:has-[:checked]:bg-primary/10" for="pro-plan">
                <div class="group/field flex w-full flex-row items-center gap-2 p-2.5">
                    <div class="flex flex-1 flex-col gap-0.5 leading-snug">
                        <span class="flex w-fit items-center gap-2 text-sm leading-snug font-medium">Pro</span>
                        <p class="text-sm text-muted-foreground">For growing businesses.</p>
                    </div>
                    <RadioGroupItemCn Value="pro" id="pro-plan" />
                </div>
            </label>
            <label class="flex w-fit gap-2 leading-snug w-full flex-col rounded-lg border has-[:checked]:border-primary/30 has-[:checked]:bg-primary/5 dark:has-[:checked]:border-primary/20 dark:has-[:checked]:bg-primary/10" for="enterprise-plan">
                <div class="group/field flex w-full flex-row items-center gap-2 p-2.5">
                    <div class="flex flex-1 flex-col gap-0.5 leading-snug">
                        <span class="flex w-fit items-center gap-2 text-sm leading-snug font-medium">Enterprise</span>
                        <p class="text-sm text-muted-foreground">For large teams and enterprises.</p>
                    </div>
                    <RadioGroupItemCn Value="enterprise" id="enterprise-plan" />
                </div>
            </label>
        </RadioGroupCn>
    </ComponentPreview>

    <ComponentPreview Title="With Description" Code="@DescriptionCode">
        <RadioGroupCn Value="comfortable" Class="w-fit">
            <FieldCn Orientation="FieldOrientation.Horizontal">
                <RadioGroupItemCn Value="default" id="desc-r1" />
                <FieldContentCn>
                    <FieldLabelCn For="desc-r1">Default</FieldLabelCn>
                    <FieldDescriptionCn>Standard spacing for most use cases.</FieldDescriptionCn>
                </FieldContentCn>
            </FieldCn>
            <FieldCn Orientation="FieldOrientation.Horizontal">
                <RadioGroupItemCn Value="comfortable" id="desc-r2" />
                <FieldContentCn>
                    <FieldLabelCn For="desc-r2">Comfortable</FieldLabelCn>
                    <FieldDescriptionCn>More space between elements.</FieldDescriptionCn>
                </FieldContentCn>
            </FieldCn>
            <FieldCn Orientation="FieldOrientation.Horizontal">
                <RadioGroupItemCn Value="compact" id="desc-r3" />
                <FieldContentCn>
                    <FieldLabelCn For="desc-r3">Compact</FieldLabelCn>
                    <FieldDescriptionCn>Minimal spacing for dense layouts.</FieldDescriptionCn>
                </FieldContentCn>
            </FieldCn>
        </RadioGroupCn>
    </ComponentPreview>

    <ComponentPreview Title="Disabled" Code="@DisabledCode">
        <RadioGroupCn Value="option2" Class="w-fit">
            <FieldCn Orientation="FieldOrientation.Horizontal" data-disabled="true">
                <RadioGroupItemCn Value="option1" id="disabled-1" Disabled="true" />
                <FieldLabelCn For="disabled-1" Class="font-normal">Disabled</FieldLabelCn>
            </FieldCn>
            <FieldCn Orientation="FieldOrientation.Horizontal">
                <RadioGroupItemCn Value="option2" id="disabled-2" />
                <FieldLabelCn For="disabled-2" Class="font-normal">Option 2</FieldLabelCn>
            </FieldCn>
            <FieldCn Orientation="FieldOrientation.Horizontal">
                <RadioGroupItemCn Value="option3" id="disabled-3" />
                <FieldLabelCn For="disabled-3" Class="font-normal">Option 3</FieldLabelCn>
            </FieldCn>
        </RadioGroupCn>
    </ComponentPreview>

    <ComponentPreview Title="Fieldset" Code="@FieldsetCode">
        <FieldSetCn Class="w-full max-w-xs">
            <FieldLegendCn Variant="FieldLegendVariant.Label">Subscription Plan</FieldLegendCn>
            <FieldDescriptionCn>Yearly and lifetime plans offer significant savings.</FieldDescriptionCn>
            <RadioGroupCn Value="monthly">
                <FieldCn Orientation="FieldOrientation.Horizontal">
                    <RadioGroupItemCn Value="monthly" id="plan-monthly" />
                    <FieldLabelCn For="plan-monthly" Class="font-normal">Monthly ($9.99/month)</FieldLabelCn>
                </FieldCn>
                <FieldCn Orientation="FieldOrientation.Horizontal">
                    <RadioGroupItemCn Value="yearly" id="plan-yearly" />
                    <FieldLabelCn For="plan-yearly" Class="font-normal">Yearly ($99.99/year)</FieldLabelCn>
                </FieldCn>
                <FieldCn Orientation="FieldOrientation.Horizontal">
                    <RadioGroupItemCn Value="lifetime" id="plan-lifetime" />
                    <FieldLabelCn For="plan-lifetime" Class="font-normal">Lifetime ($299.99)</FieldLabelCn>
                </FieldCn>
            </RadioGroupCn>
        </FieldSetCn>
    </ComponentPreview>

    <ComponentPreview Title="Invalid" Code="@InvalidCode">
        <FieldSetCn Class="w-full max-w-xs">
            <FieldLegendCn Variant="FieldLegendVariant.Label">Notification Preferences</FieldLegendCn>
            <FieldDescriptionCn>Choose how you want to receive notifications.</FieldDescriptionCn>
            <RadioGroupCn Value="email">
                <FieldCn Orientation="FieldOrientation.Horizontal" data-invalid="true">
                    <RadioGroupItemCn Value="email" id="invalid-email" aria-invalid="true" />
                    <FieldLabelCn For="invalid-email" Class="font-normal">Email only</FieldLabelCn>
                </FieldCn>
                <FieldCn Orientation="FieldOrientation.Horizontal" data-invalid="true">
                    <RadioGroupItemCn Value="sms" id="invalid-sms" aria-invalid="true" />
                    <FieldLabelCn For="invalid-sms" Class="font-normal">SMS only</FieldLabelCn>
                </FieldCn>
                <FieldCn Orientation="FieldOrientation.Horizontal" data-invalid="true">
                    <RadioGroupItemCn Value="both" id="invalid-both" aria-invalid="true" />
                    <FieldLabelCn For="invalid-both" Class="font-normal">Both Email &amp; SMS</FieldLabelCn>
                </FieldCn>
            </RadioGroupCn>
        </FieldSetCn>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <RadioGroupCn Value="comfortable" Class="w-fit" dir="rtl">
            <FieldCn Orientation="FieldOrientation.Horizontal">
                <RadioGroupItemCn Value="default" id="r1-rtl" />
                <FieldContentCn>
                    <FieldLabelCn For="r1-rtl">افتراضي</FieldLabelCn>
                    <FieldDescriptionCn>تباعد قياسي لمعظم حالات الاستخدام.</FieldDescriptionCn>
                </FieldContentCn>
            </FieldCn>
            <FieldCn Orientation="FieldOrientation.Horizontal">
                <RadioGroupItemCn Value="comfortable" id="r2-rtl" />
                <FieldContentCn>
                    <FieldLabelCn For="r2-rtl">مريح</FieldLabelCn>
                    <FieldDescriptionCn>مساحة أكبر بين العناصر.</FieldDescriptionCn>
                </FieldContentCn>
            </FieldCn>
            <FieldCn Orientation="FieldOrientation.Horizontal">
                <RadioGroupItemCn Value="compact" id="r3-rtl" />
                <FieldContentCn>
                    <FieldLabelCn For="r3-rtl">مضغوط</FieldLabelCn>
                    <FieldDescriptionCn>تباعد أدنى للتخطيطات الكثيفة.</FieldDescriptionCn>
                </FieldContentCn>
            </FieldCn>
        </RadioGroupCn>
    </ComponentPreview>
</div>

