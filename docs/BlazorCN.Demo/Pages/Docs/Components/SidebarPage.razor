    @* Example 9: With trigger and inset *@
    <ComponentPreview Title="Controlled" Code="@ControlledCode">
        <div class="h-[500px] w-full overflow-hidden rounded-lg border">
            <SidebarProviderCn Open="_controlledOpen" OpenChanged="HandleControlledChange">
                <SidebarCn>
                    <SidebarContentCn>
                        <SidebarGroupCn>
                            <SidebarGroupLabelCn>Projects</SidebarGroupLabelCn>
                            <SidebarGroupContentCn>
                                <SidebarMenuCn>
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn Href="#">
                                            <LucideFrameCn Size="16" />
                                            <span>Design Engineering</span>
                                        </SidebarMenuButtonCn>
                                    </SidebarMenuItemCn>
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn Href="#">
                                            <LucideMapCn Size="16" />
                                            <span>Travel</span>
                                        </SidebarMenuButtonCn>
                                    </SidebarMenuItemCn>
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn Href="#">
                                            <LucideLifeBuoyCn Size="16" />
                                            <span>Support</span>
                                        </SidebarMenuButtonCn>
                                    </SidebarMenuItemCn>
                                </SidebarMenuCn>
                            </SidebarGroupContentCn>
                        </SidebarGroupCn>
                    </SidebarContentCn>
                </SidebarCn>
                <SidebarInsetCn>
                    <header class="flex h-12 items-center justify-between px-4">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" OnClick="ToggleControlled">
                            @if (_controlledOpen)
                            {
                                <LucidePanelLeftCloseCn Size="16" />
                                <span>Close Sidebar</span>
                            }
                            else
                            {
                                <LucidePanelLeftOpenCn Size="16" />
                                <span>Open Sidebar</span>
                            }
                        </ButtonCn>
                    </header>
                </SidebarInsetCn>
            </SidebarProviderCn>
        </div>
    </ComponentPreview>

    @* Example 10: Skeleton loading *@
    <ComponentPreview Title="Skeleton" Code="@SkeletonCode">
        <div class="h-[400px] w-full overflow-hidden rounded-lg border">
            <SidebarProviderCn>
                <SidebarCn Collapsible="SidebarCollapsible.None">
                    <SidebarContentCn>
                        <SidebarGroupCn>
                            <SidebarGroupLabelCn>Loading...</SidebarGroupLabelCn>
                            <SidebarGroupContentCn>
                                <SidebarMenuCn>
                                    @for (var i = 0; i < 5; i++)
                                    {
                                        <SidebarMenuItemCn>
                                            <SidebarMenuSkeletonCn ShowIcon="true" />
                                        </SidebarMenuItemCn>
                                    }
                                </SidebarMenuCn>
                            </SidebarGroupContentCn>
                        </SidebarGroupCn>
                    </SidebarContentCn>
                </SidebarCn>
            </SidebarProviderCn>
        </div>
    </ComponentPreview>
</div>

