@page "/docs/components/sidebar"
@layout DocsLayout

<PageTitle>Sidebar — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Sidebar</h1>
        <p class="mt-2 text-lg text-muted-foreground">A composable, themeable and customizable sidebar component.</p>
    </div>

    <SeparatorCn />

    @* Example 1: Basic sidebar with groups *@
    <ComponentPreview Title="Basic" Code="@BasicCode">
        <div class="h-[400px] w-full overflow-hidden rounded-lg border">
            <SidebarProviderCn>
                <SidebarCn Collapsible="SidebarCollapsible.None">
                    <SidebarContentCn>
                        <SidebarGroupCn>
                            <SidebarGroupLabelCn>Help</SidebarGroupLabelCn>
                            <SidebarGroupContentCn>
                                <SidebarMenuCn>
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn>
                                            <LucideLifeBuoyCn Size="16" />
                                            <span>Support</span>
                                        </SidebarMenuButtonCn>
                                    </SidebarMenuItemCn>
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn>
                                            <LucideSendCn Size="16" />
                                            <span>Feedback</span>
                                        </SidebarMenuButtonCn>
                                    </SidebarMenuItemCn>
                                </SidebarMenuCn>
                            </SidebarGroupContentCn>
                        </SidebarGroupCn>
                    </SidebarContentCn>
                </SidebarCn>
            </SidebarProviderCn>
        </div>
    </ComponentPreview>

