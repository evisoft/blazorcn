@page "/docs/components/switch"
@layout DocsLayout

<PageTitle>Switch — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Switch</h1>
        <p class="mt-2 text-lg text-muted-foreground">A control that allows the user to toggle between checked and not checked.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Default" Code="@DefaultCode">
        <div class="flex items-center space-x-2">
            <SwitchCn id="airplane-mode" @bind-Checked="_airplaneMode" />
            <LabelCn For="airplane-mode">Airplane Mode</LabelCn>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Sizes" Code="@SizesCode">
        <div class="w-full max-w-[10rem] space-y-4">
            <div class="flex items-center space-x-2">
                <SwitchCn id="switch-size-sm" Size="SwitchSize.Sm" @bind-Checked="_sizeSm" />
                <LabelCn For="switch-size-sm">Small</LabelCn>
            </div>
            <div class="flex items-center space-x-2">
                <SwitchCn id="switch-size-default" @bind-Checked="_sizeDefault" />
                <LabelCn For="switch-size-default">Default</LabelCn>
            </div>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Description" Code="@DescriptionCode">
        <div class="flex max-w-sm items-center justify-between gap-4">
            <div class="space-y-1">
                <LabelCn For="switch-share">Share across devices</LabelCn>
                <p class="text-sm text-muted-foreground">
                    Focus is shared across devices, and turns off when you leave the app.
                </p>
            </div>
            <SwitchCn id="switch-share" @bind-Checked="_shareDevices" />
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Disabled" Code="@DisabledCode">
        <FieldCn Orientation="FieldOrientation.Horizontal" Class="w-fit" data-disabled="true">
            <SwitchCn id="switch-disabled" Disabled="true" />
            <FieldLabelCn For="switch-disabled">Disabled</FieldLabelCn>
        </FieldCn>
    </ComponentPreview>

    <ComponentPreview Title="Invalid" Code="@InvalidCode">
        <div class="flex max-w-sm items-center justify-between gap-4" data-invalid="true">
            <div class="space-y-1">
                <LabelCn For="switch-terms">Accept terms and conditions</LabelCn>
                <p class="text-sm text-muted-foreground">
                    You must accept the terms and conditions to continue.
                </p>
            </div>
            <SwitchCn id="switch-terms" @bind-Checked="_terms" aria-invalid="true" />
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Choice Card" Code="@ChoiceCardCode">
        <div class="w-full max-w-sm space-y-3">
            <label for="switch-share-card" class="flex items-center justify-between gap-4 rounded-lg border p-4">
                <div class="space-y-1">
                    <span class="text-sm font-medium leading-none">Share across devices</span>
                    <p class="text-sm text-muted-foreground">
                        Focus is shared across devices, and turns off when you leave the app.
                    </p>
                </div>
                <SwitchCn id="switch-share-card" @bind-Checked="_shareCard" />
            </label>
            <label for="switch-notifications" class="flex items-center justify-between gap-4 rounded-lg border p-4">
                <div class="space-y-1">
                    <span class="text-sm font-medium leading-none">Enable notifications</span>
                    <p class="text-sm text-muted-foreground">
                        Receive notifications when focus mode is enabled or disabled.
                    </p>
                </div>
                <SwitchCn id="switch-notifications" @bind-Checked="_notifications" />
            </label>
        </div>
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div class="flex max-w-sm items-center justify-between gap-4" dir="rtl">
            <div class="space-y-1">
                <LabelCn For="switch-rtl" dir="rtl">المشاركة عبر الأجهزة</LabelCn>
                <p class="text-sm text-muted-foreground" dir="rtl">
                    يتم مشاركة التركيز عبر الأجهزة، ويتم إيقاف تشغيله عند مغادرة التطبيق.
                </p>
            </div>
            <SwitchCn id="switch-rtl" @bind-Checked="_rtl" dir="rtl" />
        </div>
    </ComponentPreview>
</div>

@code {
    private bool _airplaneMode;
    private bool _sizeSm;
    private bool _sizeDefault;
    private bool _shareDevices;
    private bool _terms;
    private bool _shareCard;
    private bool _notifications = true;
    private bool _rtl;

    private const string DefaultCode = @"<div class=""flex items-center space-x-2"">
    <SwitchCn id=""airplane-mode"" @bind-Checked=""_airplaneMode"" />
    <LabelCn For=""airplane-mode"">Airplane Mode</LabelCn>
</div>";

    private const string SizesCode = @"<div class=""w-full max-w-[10rem] space-y-4"">
    <div class=""flex items-center space-x-2"">
        <SwitchCn id=""switch-size-sm"" Size=""SwitchSize.Sm"" @bind-Checked=""_sizeSm"" />
        <LabelCn For=""switch-size-sm"">Small</LabelCn>
    </div>
    <div class=""flex items-center space-x-2"">
        <SwitchCn id=""switch-size-default"" @bind-Checked=""_sizeDefault"" />
        <LabelCn For=""switch-size-default"">Default</LabelCn>
    </div>
</div>";

    private const string DescriptionCode = @"<div class=""flex max-w-sm items-center justify-between gap-4"">
    <div class=""space-y-1"">
        <LabelCn For=""switch-share"">Share across devices</LabelCn>
        <p class=""text-sm text-muted-foreground"">
            Focus is shared across devices, and turns off when you leave the app.
        </p>
    </div>
    <SwitchCn id=""switch-share"" @bind-Checked=""_shareDevices"" />
</div>";

    private const string DisabledCode = @"<FieldCn Orientation=""FieldOrientation.Horizontal"" Class=""w-fit"" data-disabled=""true"">
    <SwitchCn id=""switch-disabled"" Disabled=""true"" />
    <FieldLabelCn For=""switch-disabled"">Disabled</FieldLabelCn>
</FieldCn>";

    private const string InvalidCode = @"<div class=""flex max-w-sm items-center justify-between gap-4"" data-invalid=""true"">
    <div class=""space-y-1"">
        <LabelCn For=""switch-terms"">Accept terms and conditions</LabelCn>
        <p class=""text-sm text-muted-foreground"">
            You must accept the terms and conditions to continue.
        </p>
    </div>
    <SwitchCn id=""switch-terms"" @bind-Checked=""_terms"" aria-invalid=""true"" />
</div>";

    private const string ChoiceCardCode = @"<div class=""w-full max-w-sm space-y-3"">
    <label for=""switch-share-card"" class=""flex items-center justify-between gap-4 rounded-lg border p-4"">
        <div class=""space-y-1"">
            <span class=""text-sm font-medium leading-none"">Share across devices</span>
            <p class=""text-sm text-muted-foreground"">
                Focus is shared across devices, and turns off when you leave the app.
            </p>
        </div>
        <SwitchCn id=""switch-share-card"" @bind-Checked=""_shareCard"" />
    </label>
    <label for=""switch-notifications"" class=""flex items-center justify-between gap-4 rounded-lg border p-4"">
        <div class=""space-y-1"">
            <span class=""text-sm font-medium leading-none"">Enable notifications</span>
            <p class=""text-sm text-muted-foreground"">
                Receive notifications when focus mode is enabled or disabled.
            </p>
        </div>
        <SwitchCn id=""switch-notifications"" @bind-Checked=""_notifications"" />
