</div>";

    private const string RtlCode = @"<div class=""flex max-w-sm items-center justify-between gap-4"" dir=""rtl"">
    <div class=""space-y-1"">
        <LabelCn For=""switch-rtl"" dir=""rtl"">المشاركة عبر الأجهزة</LabelCn>
        <p class=""text-sm text-muted-foreground"" dir=""rtl"">
            يتم مشاركة التركيز عبر الأجهزة، ويتم إيقاف تشغيله عند مغادرة التطبيق.
        </p>
    </div>
    <SwitchCn id=""switch-rtl"" @bind-Checked=""_rtl"" dir=""rtl"" />
</div>";
}
