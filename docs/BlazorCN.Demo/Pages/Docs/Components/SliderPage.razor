@page "/docs/components/slider"
@layout DocsLayout

<PageTitle>Slider — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Slider</h1>
        <p class="mt-2 text-lg text-muted-foreground">An input where the user selects a value from within a given range.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Default" Code="@DefaultCode">
        <SliderCn Value="75" Max="100" Step="1" Class="mx-auto w-full max-w-xs" />
    </ComponentPreview>

    <ComponentPreview Title="Controlled" Code="@ControlledCode">
        <div class="mx-auto grid w-full max-w-xs gap-3">
            <div class="flex items-center justify-between gap-2">
                <LabelCn For="slider-temperature">Temperature</LabelCn>
                <span class="text-sm text-muted-foreground">@_temperature</span>
            </div>
            <SliderCn id="slider-temperature"
                       @bind-Value="_temperature"
                       Min="0"
                       Max="1"
                       Step="0.1" />
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Range" Code="@RangeCode">
        <SliderCn Values="@_rangeValues"
                   ValuesChanged="@((v) => _rangeValues = v)"
                   Max="100"
                   Step="5"
                   Class="mx-auto w-full max-w-xs" />
    </ComponentPreview>

    <ComponentPreview Title="Multiple" Code="@MultipleCode">
        <SliderCn Values="@_multipleValues"
                   ValuesChanged="@((v) => _multipleValues = v)"
                   Max="100"
                   Step="10"
                   Class="mx-auto w-full max-w-xs" />
    </ComponentPreview>

    <ComponentPreview Title="Vertical" Code="@VerticalCode">
        <div class="mx-auto flex w-full max-w-xs items-center justify-center gap-6">
            <SliderCn Value="50"
                       Max="100"
                       Step="1"
                       Orientation="SliderOrientation.Vertical"
                       Class="h-40" />
            <SliderCn Value="25"
                       Max="100"
                       Step="1"
                       Orientation="SliderOrientation.Vertical"
                       Class="h-40" />
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Disabled" Code="@DisabledCode">
        <SliderCn Value="50" Max="100" Step="1" Disabled="true" Class="mx-auto w-full max-w-xs" />
    </ComponentPreview>

    <ComponentPreview Title="RTL" Code="@RtlCode">
        <div dir="rtl">
            <SliderCn Value="75" Max="100" Step="1" Class="mx-auto w-full max-w-xs" />
        </div>
    </ComponentPreview>
</div>

@code {
    private double _temperature = 0.5;
    private double[] _rangeValues = new[] { 25.0, 50.0 };
    private double[] _multipleValues = new[] { 10.0, 20.0, 70.0 };

    private const string DefaultCode = @"<SliderCn Value=""75"" Max=""100"" Step=""1"" Class=""mx-auto w-full max-w-xs"" />";

    private const string ControlledCode = @"<div class=""mx-auto grid w-full max-w-xs gap-3"">
    <div class=""flex items-center justify-between gap-2"">
        <LabelCn For=""slider-temperature"">Temperature</LabelCn>
        <span class=""text-sm text-muted-foreground"">@_temperature</span>
    </div>
    <SliderCn id=""slider-temperature""
               @bind-Value=""_temperature""
               Min=""0""
               Max=""1""
               Step=""0.1"" />
</div>

@code {
    private double _temperature = 0.5;
}";

    private const string RangeCode = @"<SliderCn Values=""@_rangeValues""
           ValuesChanged=""@((v) => _rangeValues = v)""
           Max=""100""
           Step=""5""
           Class=""mx-auto w-full max-w-xs"" />

@code {
    private double[] _rangeValues = new[] { 25.0, 50.0 };
}";

    private const string MultipleCode = @"<SliderCn Values=""@_multipleValues""
           ValuesChanged=""@((v) => _multipleValues = v)""
           Max=""100""
           Step=""10""
           Class=""mx-auto w-full max-w-xs"" />

@code {
    private double[] _multipleValues = new[] { 10.0, 20.0, 70.0 };
}";

    private const string VerticalCode = @"<div class=""mx-auto flex w-full max-w-xs items-center justify-center gap-6"">
    <SliderCn Value=""50""
               Max=""100""
               Step=""1""
               Orientation=""SliderOrientation.Vertical""
               Class=""h-40"" />
    <SliderCn Value=""25""
               Max=""100""
               Step=""1""
               Orientation=""SliderOrientation.Vertical""
               Class=""h-40"" />
</div>";

    private const string DisabledCode = @"<SliderCn Value=""50"" Max=""100"" Step=""1"" Disabled=""true"" Class=""mx-auto w-full max-w-xs"" />";

    private const string RtlCode = @"<div dir=""rtl"">
    <SliderCn Value=""75"" Max=""100"" Step=""1"" Class=""mx-auto w-full max-w-xs"" />
</div>";
}
