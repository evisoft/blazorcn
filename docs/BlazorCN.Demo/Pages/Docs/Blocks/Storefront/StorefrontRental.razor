@* ============================================================
   Block: storefront-rental
   Title: Storefront Rental
   Description: Rent vs buy product block with rental period selector, insurance add-on, deposit terms, and total calculation
   Dependencies: ButtonCn, CheckboxCn, LabelCn, LucideCheckCn, LucidePackageCn, LucideShieldCheckCn, RadioGroupCn, RadioGroupItemCn
   Source: original/blocks/storefront/storefront-rental.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h1 class="text-sm font-medium">Rent This Item</h1>
        </div>

        @* Product Info *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-16 shrink-0 items-center justify-center rounded-md bg-muted/50">
                <LucidePackageCn Size="16" Class="size-5 text-muted-foreground/60" />
            </div>
            <div class="min-w-0 flex-1">
                <span class="text-sm font-medium">Canon EOS R6 Mark II</span>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Full-frame mirrorless camera with 24.2MP sensor
                </p>
            </div>
            <div class="text-right">
                <span class="text-xs text-muted-foreground">Retail</span>
                <p class="text-sm font-medium tabular-nums">$@RetailPrice</p>
            </div>
        </div>

        @* Rental Period Selector *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">
                Rental Period
            </span>
            <RadioGroupCn TValue="string" Value="@_selectedPeriod" ValueChanged="@(v => _selectedPeriod = v)">
                @for (var i = 0; i < _rentalPeriods.Length; i++)
                {
                    var rp = _rentalPeriods[i];
                    var isLast = i == _rentalPeriods.Length - 1;
                    <div class="@(!isLast ? "border-b" : "")">
                        <div class="flex items-center gap-3 py-2.5">
                            <RadioGroupItemCn Value="@rp.Id" Id="@($"rental-{rp.Id}")" />
                            <LabelCn For="@($"rental-{rp.Id}")"
                                     Class="flex flex-1 cursor-pointer items-center justify-between">
                                <span class="text-sm font-medium">@rp.Label</span>
                                <div class="flex items-center gap-2">
                                    <span class="text-xs text-muted-foreground">@rp.DailyRate</span>
                                    <span class="text-sm font-medium tabular-nums">$@rp.Price</span>
                                </div>
                            </LabelCn>
                        </div>
                    </div>
                }
            </RadioGroupCn>
        </div>

        @* Rental Terms *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">Rental Terms</span>
            <div class="space-y-0">
                <div class="flex items-center justify-between border-b py-2">
                    <span class="text-xs text-muted-foreground">Security deposit (refundable)</span>
                    <span class="text-xs font-medium tabular-nums">$@DepositAmount</span>
                </div>
                <div class="flex items-center justify-between border-b py-2">
                    <span class="text-xs text-muted-foreground">Late fee per day</span>
                    <span class="text-xs font-medium tabular-nums">$@LateFee/day</span>
                </div>
                <div class="flex items-center justify-between py-2">
                    <span class="text-xs text-muted-foreground">Damage policy</span>
                    <span class="text-xs font-medium">Deposit may be withheld</span>
                </div>
            </div>
        </div>

        @* Insurance Add-on *@
        <div class="border-b px-4 py-3">
            <span class="flex cursor-pointer items-center gap-3" @onclick="ToggleInsurance">
                <CheckboxCn @bind-Checked="_hasInsurance" />
                <div class="flex flex-1 items-center justify-between">
                    <div class="flex items-center gap-1.5">
                        <LucideShieldCheckCn Size="16" Class="size-3.5 text-muted-foreground" />
                        <span class="text-sm font-medium">Rental Protection Plan</span>
                    </div>
                    <span class="text-sm font-medium tabular-nums">+$@InsuranceCost</span>
                </div>
            </span>
            <p class="mt-1 pl-7 text-xs text-muted-foreground">
                Covers accidental damage and theft during your rental period
            </p>
        </div>

        @* Total + Actions *@
        <div class="px-4 py-3">
            <div class="mb-3 space-y-1.5">
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Rental (@(SelectedPeriod?.Label))</span>
                    <span class="text-xs tabular-nums">$@RentalPrice</span>
                </div>
                @if (_hasInsurance)
                {
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-muted-foreground">Protection plan</span>
                        <span class="text-xs tabular-nums">$@InsuranceCost</span>
                    </div>
                }
                <div class="flex items-center justify-between border-t pt-2">
                    <span class="text-sm font-medium">Total</span>
                    <span class="text-2xl font-semibold tabular-nums">$@Total</span>
                </div>
            </div>
            <ButtonCn Class="h-8 w-full text-xs" Size="ButtonSize.Sm">
                <LucideCheckCn Size="16" Class="mr-1.5 size-3.5" />
                Rent Now
            </ButtonCn>
            <p class="mt-2 text-center text-xs text-muted-foreground">
                Or <a href="#" class="underline underline-offset-2">buy for $@RetailPrice</a>
            </p>
        </div>
    </div>
</section>

@code {
    private record RentalPeriod(string Id, string Label, int Price, string DailyRate);

    private const int RetailPrice = 495;
    private const int DepositAmount = 150;
    private const int LateFee = 15;
    private const int InsuranceCost = 10;

    private static readonly RentalPeriod[] _rentalPeriods =
    {
        new("3-days", "3 Days", 25, "$8.33/day"),
        new("1-week", "1 Week", 45, "$6.43/day"),
        new("2-weeks", "2 Weeks", 75, "$5.36/day"),
        new("1-month", "1 Month", 120, "$4.00/day")
    };

    private string _selectedPeriod = "1-week";
    private bool _hasInsurance;

    private RentalPeriod? SelectedPeriod => _rentalPeriods.FirstOrDefault(p => p.Id == _selectedPeriod);
    private int RentalPrice => SelectedPeriod?.Price ?? 0;
    private int Total => RentalPrice + (_hasInsurance ? InsuranceCost : 0);

    private void ToggleInsurance() => _hasInsurance = !_hasInsurance;
}
