@* ============================================================
   Block: storefront-vendor-profile
   Title: Storefront Vendor Profile
   Description: Marketplace vendor profile card with store name, seller rating, response time, total sales count, join date, top product listings, and contact seller button
   Dependencies: ButtonCn, LucideCheckCn, LucideClockCn, LucideMessageSquareCn, LucidePackageCn, LucideShieldCheckCn, LucideStarCn, LucideStoreCn
   Source: original/blocks/storefront/storefront-vendor-profile.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Store Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted">
                    <LucideStoreCn Size="16" Class="size-4 text-muted-foreground" />
                </div>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-1.5">
                        <h2 class="text-sm font-medium">@_vendor.Name</h2>
                        @if (_vendor.Verified)
                        {
                            <LucideShieldCheckCn Size="16" Class="size-3.5 text-primary" />
                        }
                    </div>
                    <p class="text-xs text-muted-foreground">
                        Joined @_vendor.JoinedDate &middot; Ships from @_vendor.ShipsFrom
                    </p>
                </div>
            </div>
        </div>

        @* Stats Row *@
        <div class="flex border-b">
            <div class="flex flex-1 flex-col items-center border-r px-4 py-3">
                <span class="text-2xl font-semibold tabular-nums">@_vendor.Rating</span>
                <div class="mt-0.5 flex items-center gap-1">
                    <LucideStarCn Size="16" Class="size-3 fill-primary text-primary" />
                    <span class="text-xs text-muted-foreground">
                        @_vendor.TotalReviews.ToString("N0") reviews
                    </span>
                </div>
            </div>
            <div class="flex flex-1 flex-col items-center border-r px-4 py-3">
                <span class="text-2xl font-semibold tabular-nums">
                    @((_vendor.TotalSales / 1000.0).ToString("F1"))k
                </span>
                <div class="mt-0.5 flex items-center gap-1">
                    <LucidePackageCn Size="16" Class="size-3 text-muted-foreground" />
                    <span class="text-xs text-muted-foreground">sales</span>
                </div>
            </div>
            <div class="flex flex-1 flex-col items-center px-4 py-3">
                <span class="text-sm font-semibold">@_vendor.ResponseTime</span>
                <div class="mt-0.5 flex items-center gap-1">
                    <LucideClockCn Size="16" Class="size-3 text-muted-foreground" />
                    <span class="text-xs text-muted-foreground">response</span>
                </div>
            </div>
        </div>

        @* About *@
        <div class="border-b px-4 py-3">
            <span class="mb-1 block text-xs font-medium text-muted-foreground">About</span>
            <p class="text-xs leading-relaxed text-muted-foreground">@_vendor.Description</p>
        </div>

        @* Top Products *@
        <div class="border-b">
            <div class="px-4 py-3">
                <span class="text-xs font-medium text-muted-foreground">Top products</span>
            </div>
            @{ var displayed = DisplayedProducts; }
            @for (var i = 0; i < displayed.Length; i++)
            {
                var product = displayed[i];
                var isLast = i == displayed.Length - 1;
                <a href="#" class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                    <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted">
                        <LucidePackageCn Size="16" Class="size-4 text-muted-foreground/40" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="block truncate text-sm font-medium">@product.Name</span>
                        <span class="text-xs text-muted-foreground">
                            @product.Rating stars &middot; @product.Sales.ToString("N0") sold
                        </span>
                    </div>
                    <span class="shrink-0 text-sm font-medium tabular-nums">$@product.Price</span>
                </a>
            }
            @if (_vendor.TopProducts.Length > 3)
            {
                <div class="px-4 py-2">
                    <button type="button"
                            class="text-xs text-muted-foreground hover:text-foreground"
                            @onclick="@(() => _showAllProducts = !_showAllProducts)">
                        @(_showAllProducts ? "Show less" : $"View all {_vendor.TopProducts.Length} products")
                    </button>
                </div>
            }
        </div>

        @* Seller Highlights *@
        <div class="border-b px-4 py-3">
            <div class="flex flex-wrap gap-3">
                @foreach (var highlight in _highlights)
                {
                    <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                        <LucideCheckCn Size="16" Class="size-3 text-emerald-500" />
                        @highlight
                    </span>
                }
            </div>
        </div>

        @* Contact Button *@
        <div class="px-4 py-3">
            <ButtonCn Class="h-8 w-full gap-1.5 text-xs" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">
                <LucideMessageSquareCn Size="16" Class="size-3" />
                Contact Seller
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TopProduct(int Id, string Name, int Price, int Sales, double Rating);

    private record VendorInfo(
        string Name, bool Verified, double Rating, int TotalReviews,
        string ResponseTime, int TotalSales, string JoinedDate,
        string Description, string ShipsFrom, TopProduct[] TopProducts);

    private static readonly VendorInfo _vendor = new(
        "Nordic Craft Co.", true, 4.8, 1847, "Under 2 hours", 12430,
        "March 2021",
        "Handcrafted Scandinavian-inspired home goods and accessories. We use sustainably sourced materials and traditional techniques passed down through generations.",
        "Stockholm, Sweden",
        new TopProduct[]
        {
            new(1, "Hand-Woven Wool Throw Blanket", 189, 2341, 4.9),
            new(2, "Birch Wood Serving Board", 65, 1856, 4.8),
            new(3, "Ceramic Stoneware Mug Set", 48, 1544, 4.7),
            new(4, "Linen Table Runner", 72, 1203, 4.8),
            new(5, "Reindeer Leather Key Holder", 34, 987, 4.6)
        });

    private static readonly string[] _highlights = { "Fast shipper", "Easy returns", "Responsive" };

    private bool _showAllProducts;

    private TopProduct[] DisplayedProducts =>
        _showAllProducts ? _vendor.TopProducts : _vendor.TopProducts.Take(3).ToArray();
}
