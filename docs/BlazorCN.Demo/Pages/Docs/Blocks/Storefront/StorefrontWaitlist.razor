@* ============================================================
   Block: storefront-waitlist
   Title: Storefront Waitlist
   Description: Storefront product waitlist signup with position tracker, notification preferences, and social sharing
   Dependencies: ButtonCn, CheckboxCn, InputCn, LabelCn, LucideCheckCn, LucideCopyCn, LucideMailCn, LucideMessageSquareCn, LucidePackageCn, LucideUsersCn
   Source: original/blocks/storefront/storefront-waitlist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Join the Waitlist</h2>
            <p class="text-xs text-muted-foreground">
                Get notified when this item is back in stock
            </p>
        </div>

        @* Product Info *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-12 shrink-0 items-center justify-center rounded-md bg-muted/50">
                <LucidePackageCn Size="16" Class="size-4 text-muted-foreground/60" />
            </div>
            <div class="min-w-0 flex-1">
                <p class="text-sm font-medium">Merino Wool Overcoat</p>
                <p class="text-xs text-muted-foreground">
                    Charcoal &middot; Size L &middot; Currently out of stock
                </p>
            </div>
            <span class="text-2xl font-semibold tabular-nums">$395</span>
        </div>

        @* Waitlist Position *@
        <div class="border-b px-4 py-3 text-center">
            <p class="text-xs text-muted-foreground">Your position in line</p>
            <p class="mt-1 text-2xl font-semibold tabular-nums">#847</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Estimated restock: April 15, 2026</p>
        </div>

        @* Email Signup *@
        <div class="border-b px-4 py-3">
            <LabelCn Class="mb-2 block text-xs font-medium text-muted-foreground"
                     For="waitlist-email">
                Email address
            </LabelCn>
            <div class="flex gap-2">
                <InputCn Class="h-8 flex-1 text-sm"
                         Id="waitlist-email"
                         Placeholder="@EmailPlaceholder"
                         Type="email" />
                <ButtonCn Class="h-8 px-3 text-xs"
                          Variant="ButtonVariant.Outline"
                          @onclick="@(() => _joined = true)">
                    @if (_joined)
                    {
                        <LucideCheckCn Size="16" Class="mr-1 size-3" />
                        <text>Joined</text>
                    }
                    else
                    {
                        <text>Join Waitlist</text>
                    }
                </ButtonCn>
            </div>
        </div>

        @* Notification Preferences *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">
                Notification Preferences
            </span>
            <div class="flex flex-col gap-2">
                <label class="flex cursor-pointer items-center gap-2" for="notify-email">
                    <CheckboxCn Id="notify-email" @bind-Checked="_notifyEmail" />
                    <LucideMailCn Size="16" Class="size-3.5 text-muted-foreground" />
                    <span class="text-sm">Email notifications</span>
                </label>
                <label class="flex cursor-pointer items-center gap-2" for="notify-sms">
                    <CheckboxCn Id="notify-sms" @bind-Checked="_notifySms" />
                    <LucideMessageSquareCn Size="16" Class="size-3.5 text-muted-foreground" />
                    <span class="text-sm">SMS notifications</span>
                </label>
            </div>
        </div>

        @* Share *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">
                Share with Friends
            </span>
            <p class="mb-2 text-xs text-muted-foreground">
                Move up the list when friends join through your link
            </p>
            <ButtonCn Class="h-7 gap-1 px-2 text-xs" Variant="ButtonVariant.Ghost" @onclick="HandleCopyLink">
                @if (_copied)
                {
                    <LucideCheckCn Size="16" Class="size-3" />
                    <text>Copied</text>
                }
                else
                {
                    <LucideCopyCn Size="16" Class="size-3" />
                    <text>Copy referral link</text>
                }
            </ButtonCn>
        </div>

        @* Stats *@
        <div class="flex items-center gap-6 px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideUsersCn Size="16" Class="size-3.5 text-muted-foreground" />
                <span class="text-xs text-muted-foreground">1,200 people waiting</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-xs text-muted-foreground">94% fulfillment rate</span>
            </div>
        </div>
    </div>
</section>

@code {
    private const string EmailPlaceholder = "you@example.com";

    private bool _joined;
    private bool _copied;
    private bool _notifyEmail = true;
    private bool _notifySms;

    private async Task HandleCopyLink()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
