@* ============================================================
   Block: storefront-reorder
   Title: Storefront Reorder
   Description: Quick reorder panel with past order items, one-click reorder buttons, quantity adjusters, price change indicators, and bulk add-to-cart action
   Long Description: Rent vs buy product block with rental period selector, insurance add-on, deposit terms, and total calculation
   Dependencies: ButtonCn, CheckboxCn, LucideCheckCn, LucideMinusCn, LucidePackageCn, LucidePlusCn, LucideRotateCcwCn, LucideShoppingBagCn, LucideTrendingDownCn, LucideTrendingUpCn
   Source: original/blocks/storefront/storefront-reorder.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header *@
            <div class="flex items-center justify-between border-b px-4 py-3">
                <div>
                    <div class="flex items-center gap-2">
                        <LucideRotateCcwCn Size="16" Class="size-4 text-muted-foreground" />
                        <h2 class="text-sm font-medium">Quick Reorder</h2>
                    </div>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_items.Length items from recent orders
                    </p>
                </div>
                <label
                    class="flex cursor-pointer items-center gap-2 text-xs text-muted-foreground"
                    for="select-all-reorder">
                    <CheckboxCn
                        Checked="@AllSelected"
                        CheckedChanged="@ToggleSelectAll"
                        Id="select-all-reorder" />
                    Select all
                </label>
            </div>

            @* Items *@
            @for (var i = 0; i < _items.Length; i++)
            {
                var item = _items[i];
                var isLast = i == _items.Length - 1;
                var qty = _quantities.GetValueOrDefault(item.Id, 1);
                var priceDiff = item.CurrentPrice - item.LastPrice;
                var isAdded = _addedItems.Contains(item.Id);
                var isSelected = _selected.Contains(item.Id);
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-3", !isLast ? "border-b" : "", !item.InStock ? "opacity-50" : ""))">
                    @* Checkbox *@
                    <CheckboxCn
                        Checked="@isSelected"
                        CheckedChanged="@((_) => ToggleSelect(item.Id))"
                        Disabled="@(!item.InStock)"
                        Id="@($"reorder-{item.Id}")" />

                    @* Product Image *@
                    <div class="flex size-12 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        <LucidePackageCn Size="16" Class="size-4 text-muted-foreground/60" />
                    </div>

                    @* Product Info *@
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@item.Name</p>
                        <p class="text-xs text-muted-foreground">@item.Variant</p>
                        <div class="mt-1 flex items-center gap-2">
                            <span class="text-xs text-muted-foreground">
                                Last ordered @item.LastOrdered
                            </span>
                            @if (!item.InStock)
                            {
                                <span class="text-xs text-muted-foreground">&middot;</span>
                                <div class="flex items-center gap-1">
                                    <span class="size-1.5 rounded-full bg-red-500"></span>
                                    <span class="text-xs text-muted-foreground">Out of stock</span>
                                </div>
                            }
                        </div>
                    </div>

                    @* Price & Controls *@
                    <div class="flex shrink-0 flex-col items-end gap-1.5">
                        <div class="flex items-center gap-1.5">
                            <span class="text-sm font-medium tabular-nums">$@item.CurrentPrice</span>
                            @if (priceDiff > 0)
                            {
                                <span class="flex items-center gap-0.5 text-[10px] text-red-600 dark:text-red-400">
                                    <LucideTrendingUpCn Size="10" Class="size-2.5" />
                                    +$@priceDiff
                                </span>
                            }
                            @if (priceDiff < 0)
                            {
                                <span class="flex items-center gap-0.5 text-[10px] text-emerald-600 dark:text-emerald-400">
                                    <LucideTrendingDownCn Size="10" Class="size-2.5" />
                                    -$@Math.Abs(priceDiff)
                                </span>
                            }
                        </div>
                        <div class="flex items-center gap-1.5">
                            <div class="flex items-center gap-1">
                                <ButtonCn
                                    Class="size-5"
                                    Disabled="@(!item.InStock || qty <= 1)"
                                    @onclick="@(() => UpdateQuantity(item.Id, -1))"
                                    Size="ButtonSize.Icon"
                                    Variant="ButtonVariant.Outline">
                                    <LucideMinusCn Size="10" Class="size-2.5" />
                                </ButtonCn>
                                <span class="w-4 text-center text-xs tabular-nums">@qty</span>
                                <ButtonCn
                                    Class="size-5"
                                    Disabled="@(!item.InStock || qty >= 10)"
                                    @onclick="@(() => UpdateQuantity(item.Id, 1))"
                                    Size="ButtonSize.Icon"
                                    Variant="ButtonVariant.Outline">
                                    <LucidePlusCn Size="10" Class="size-2.5" />
                                </ButtonCn>
                            </div>
                            <ButtonCn
                                Class="h-6 gap-1 px-2 text-xs"
                                Disabled="@(!item.InStock)"
                                @onclick="@(() => AddToCart(item.Id))"
                                Variant="ButtonVariant.Ghost">
                                @if (isAdded)
                                {
                                    <LucideCheckCn Size="12" Class="size-3" />
                                    <text>Added</text>
                                }
                                else
                                {
                                    <LucideShoppingBagCn Size="12" Class="size-3" />
                                    <text>Add</text>
                                }
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            }

            @* Bulk Action *@
            <div class="border-t px-4 py-3">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs text-muted-foreground">
                            @if (_selected.Count > 0)
                            {
                                @($"{_selected.Count} item{(_selected.Count > 1 ? "s" : "")} selected")
                            }
                            else
                            {
                                <text>Select items to add in bulk</text>
                            }
                        </p>
                        @if (_selected.Count > 0)
                        {
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                Estimated total: $@SelectedTotal
                            </p>
                        }
                    </div>
                    <ButtonCn
                        Class="gap-1.5 text-xs"
                        Disabled="@(_selected.Count == 0)"
                        @onclick="AddAllToCart"
                        Variant="ButtonVariant.Outline">
                        <LucideShoppingBagCn Size="14" Class="size-3.5" />
                        Add All to Cart
                    </ButtonCn>
                </div>
            </div>
        </div>
    </section>
</section>

@code {
    private List<int> _selected = new();
    private List<int> _addedItems = new();
    private Dictionary<int, int> _quantities = new();

    private record ReorderItem(int Id, string Name, string Variant, int CurrentPrice, int LastPrice, string LastOrdered, bool InStock);

    private static readonly ReorderItem[] _items =
    [
        new(1, "Organic Cold Brew Coffee", "12 oz / Medium Roast", 14, 14, "Mar 3, 2026", true),
        new(2, "Whole Grain Granola", "16 oz / Maple Pecan", 9, 8, "Mar 3, 2026", true),
        new(3, "Greek Yogurt", "32 oz / Plain", 6, 7, "Feb 24, 2026", true),
        new(4, "Almond Butter", "12 oz / Unsalted", 12, 12, "Feb 24, 2026", true),
        new(5, "Sourdough Bread", "1 loaf / Sesame", 7, 7, "Feb 17, 2026", false)
    ];

    protected override void OnInitialized()
    {
        foreach (var item in _items)
            _quantities[item.Id] = 1;
    }

    private void UpdateQuantity(int id, int delta)
    {
        var current = _quantities.GetValueOrDefault(id, 1);
        _quantities[id] = Math.Clamp(current + delta, 1, 10);
    }

    private void ToggleSelect(int id)
    {
        if (_selected.Contains(id))
            _selected.Remove(id);
        else
            _selected.Add(id);
    }

    private void ToggleSelectAll(bool _)
    {
        if (AllSelected)
            _selected.Clear();
        else
            _selected = _items.Where(i => i.InStock).Select(i => i.Id).ToList();
    }

    private async Task AddToCart(int id)
    {
        _addedItems.Add(id);
        StateHasChanged();
        await Task.Delay(2000);
        _addedItems.Remove(id);
    }

    private async Task AddAllToCart()
    {
        var toAdd = _selected.Where(id => _items.Any(i => i.Id == id && i.InStock)).ToList();
        _addedItems.AddRange(toAdd);
        StateHasChanged();
        await Task.Delay(2000);
        foreach (var id in toAdd)
            _addedItems.Remove(id);
    }

    private bool AllSelected => _items.Where(i => i.InStock).All(i => _selected.Contains(i.Id));

    private int SelectedTotal => _selected
        .Where(id => _items.Any(i => i.Id == id && i.InStock))
        .Sum(id => {
            var item = _items.First(i => i.Id == id);
            return item.CurrentPrice * _quantities.GetValueOrDefault(id, 1);
        });
}
