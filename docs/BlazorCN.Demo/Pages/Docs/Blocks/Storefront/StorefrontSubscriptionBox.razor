@* ============================================================
   Block: storefront-subscription-box
   Title: Storefront Subscription Box
   Description: Subscription product block with frequency selector, per-delivery pricing, savings display, and recurring benefits list
   Dependencies: ButtonCn, LabelCn, LucidePackageCn, LucideRepeatCn, RadioGroupCn, RadioGroupItemCn
   Source: original/blocks/storefront/storefront-subscription-box.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideRepeatCn Size="16" Class="size-4 text-muted-foreground" />
                <h1 class="text-sm font-medium">Subscribe &amp; Save</h1>
            </div>
        </div>

        @* Product Info *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-16 shrink-0 items-center justify-center rounded-md bg-muted/50">
                <LucidePackageCn Size="16" Class="size-5 text-muted-foreground/60" />
            </div>
            <div class="min-w-0 flex-1">
                <span class="text-sm font-medium">Organic Ceremonial Matcha Powder</span>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    30g tin &middot; Premium grade &middot; Uji, Japan
                </p>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-sm font-semibold tabular-nums">$@Selected.Price</span>
                    <span class="text-xs text-muted-foreground">per delivery</span>
                    <span class="text-xs tabular-nums text-muted-foreground line-through">$40</span>
                </div>
            </div>
        </div>

        @* Frequency Selector *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">
                Delivery frequency
            </span>
            <RadioGroupCn TValue="string" Value="@_frequency" ValueChanged="@(v => _frequency = v)">
                @for (var i = 0; i < _frequencies.Length; i++)
                {
                    var option = _frequencies[i];
                    var isLast = i == _frequencies.Length - 1;
                    <div class="@(!isLast ? "border-b" : "")">
                        <LabelCn Class="flex cursor-pointer items-center gap-3 py-2.5 transition-colors hover:bg-muted/50"
                                 For="@($"freq-{option.Value}")">
                            <RadioGroupItemCn Id="@($"freq-{option.Value}")" Value="@option.Value" />
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium">@option.Label</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-semibold tabular-nums">$@option.Price</span>
                                <span class="rounded-sm bg-emerald-500/10 px-1.5 py-0.5 text-xs font-medium text-emerald-600 dark:text-emerald-400">
                                    Save @option.Savings%
                                </span>
                            </div>
                        </LabelCn>
                    </div>
                }
            </RadioGroupCn>
        </div>

        @* Delivery Summary *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">
                Delivery summary
            </span>
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <LucidePackageCn Size="16" Class="size-3.5" />
                <span>
                    First delivery ships within 2 business days. Then @Selected.Label.ToLower()
                    starting from your first delivery date.
                </span>
            </div>
        </div>

        @* Benefits *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">
                Subscriber benefits
            </span>
            <ul class="space-y-2">
                @foreach (var benefit in _benefits)
                {
                    <li class="flex items-center gap-2 text-xs">
                        <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                        @benefit
                    </li>
                }
            </ul>
        </div>

        @* Subscribe Button *@
        <div class="px-4 py-3">
            <ButtonCn Class="h-8 w-full text-xs" Size="ButtonSize.Sm">
                Subscribe &mdash; $@Selected.Price/delivery
            </ButtonCn>
            <p class="mt-2 text-center text-xs text-muted-foreground">
                Cancel or modify anytime from your account
            </p>
        </div>
    </div>
</section>

@code {
    private record FrequencyOption(string Value, string Label, int Price, int Savings);

    private static readonly FrequencyOption[] _frequencies =
    {
        new("weekly", "Weekly", 32, 20),
        new("biweekly", "Every 2 Weeks", 34, 15),
        new("monthly", "Monthly", 36, 10)
    };

    private static readonly string[] _benefits =
    {
        "Free shipping on every delivery",
        "Cancel anytime, no commitment",
        "Skip or reschedule deliveries",
        "Exclusive subscriber pricing"
    };

    private string _frequency = "biweekly";

    private FrequencyOption Selected => _frequencies.FirstOrDefault(f => f.Value == _frequency) ?? _frequencies[1];
}
