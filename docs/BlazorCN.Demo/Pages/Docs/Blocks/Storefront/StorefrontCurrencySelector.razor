@* ============================================================
   Block: storefront-currency-selector
   Title: Storefront Currency Selector
   Description: Multi-currency pricing display with currency dropdown, converted price preview, exchange rate info, and popular currency shortcuts
   Dependencies: ButtonCn, LucideChevronDownCn, LucideInfoCn, LucideRefreshCwCn
   Source: original/blocks/storefront/storefront-currency-selector.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Currency</h2>
            <p class="text-xs text-muted-foreground">Select your preferred currency for pricing</p>
        </div>

        @* Price Display *@
        <div class="border-b px-4 py-3">
            <div class="flex items-baseline gap-2">
                <span class="text-2xl font-semibold tabular-nums">@FormatPrice(ConvertedPrice, SelectedCurrency)</span>
                <span class="text-xs text-muted-foreground">@SelectedCurrency.Code</span>
            </div>
            @if (_selectedCode != "USD")
            {
                <p class="mt-1 text-xs text-muted-foreground">Base price: $@BasePrice.ToString("F2") USD</p>
            }
        </div>

        @* Popular Currencies *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">Popular</span>
            <div class="flex flex-wrap gap-2">
                @foreach (var code in _popularCodes)
                {
                    var currency = _currencies.FirstOrDefault(c => c.Code == code);
                    if (currency != null)
                    {
                        <button type="button"
                                class="@Cn.Merge("flex h-8 items-center gap-1.5 rounded-md border px-3 text-xs font-medium transition-colors", _selectedCode == code ? "border-primary text-primary" : "hover:border-foreground/50")"
                                @onclick="() => { _selectedCode = code; _dropdownOpen = false; }">
                            @currency.Symbol @(code)
                        </button>
                    }
                }
            </div>
        </div>

        @* Currency Dropdown *@
        <div class="border-b px-4 py-3">
            <span class="mb-1.5 block text-xs font-medium text-muted-foreground">All currencies</span>
            <div class="relative">
                <button type="button"
                        class="flex h-8 w-full items-center justify-between rounded-md border px-3 text-xs transition-colors hover:border-foreground/50"
                        @onclick="() => _dropdownOpen = !_dropdownOpen">
                    <span>@SelectedCurrency.Symbol @SelectedCurrency.Name (@SelectedCurrency.Code)</span>
                    <LucideChevronDownCn Size="16" Class="@Cn.Merge("size-3.5 text-muted-foreground transition-transform duration-200", _dropdownOpen ? "rotate-180" : "")" />
                </button>
                @if (_dropdownOpen)
                {
                    <div class="absolute left-0 right-0 top-9 z-10 max-h-48 overflow-y-auto rounded-md border bg-card shadow-sm">
                        @foreach (var currency in _currencies)
                        {
                            <button type="button"
                                    class="@Cn.Merge("flex w-full items-center justify-between px-3 py-2 text-left text-xs transition-colors hover:bg-muted/50", _selectedCode == currency.Code ? "bg-muted/30" : "")"
                                    @onclick="() => { _selectedCode = currency.Code; _dropdownOpen = false; }">
                                <span>@currency.Symbol @currency.Name</span>
                                <span class="text-muted-foreground">@currency.Code</span>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        @* Exchange Rate Info *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-xs font-medium text-muted-foreground">Exchange rate</span>
                    <p class="mt-0.5 font-mono text-xs">
                        1 USD = @SelectedCurrency.Rate.ToString(_selectedCode == "JPY" ? "F1" : "F2") @SelectedCurrency.Code
                    </p>
                </div>
                <ButtonCn Class="h-6 gap-1 px-2 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                    <LucideRefreshCwCn Size="16" Class="size-3" />
                    Refresh
                </ButtonCn>
            </div>
        </div>

        @* Notice *@
        <div class="flex items-start gap-2 px-4 py-3">
            <LucideInfoCn Size="16" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
            <p class="text-xs text-muted-foreground">
                Prices shown in @SelectedCurrency.Code are estimates based on current exchange rates.
                Your bank may apply a different rate at the time of charge. All transactions are
                processed in USD.
            </p>
        </div>
    </div>
</section>

@code {
    private record CurrencyInfo(string Code, string Name, string Symbol, decimal Rate);

    private const decimal BasePrice = 149.00m;

    private static readonly CurrencyInfo[] _currencies =
    {
        new("USD", "US Dollar", "$", 1.0m),
        new("EUR", "Euro", "\u20AC", 0.92m),
        new("GBP", "British Pound", "\u00A3", 0.79m),
        new("JPY", "Japanese Yen", "\u00A5", 149.5m),
        new("CAD", "Canadian Dollar", "CA$", 1.36m),
        new("AUD", "Australian Dollar", "A$", 1.53m),
        new("CHF", "Swiss Franc", "CHF", 0.88m),
        new("CNY", "Chinese Yuan", "\u00A5", 7.24m),
        new("INR", "Indian Rupee", "\u20B9", 83.12m),
        new("BRL", "Brazilian Real", "R$", 4.97m)
    };

    private static readonly string[] _popularCodes = { "USD", "EUR", "GBP", "JPY" };

    private string _selectedCode = "USD";
    private bool _dropdownOpen;

    private CurrencyInfo SelectedCurrency => _currencies.FirstOrDefault(c => c.Code == _selectedCode) ?? _currencies[0];
    private decimal ConvertedPrice => BasePrice * SelectedCurrency.Rate;

    private static string FormatPrice(decimal amount, CurrencyInfo currency)
    {
        var decimals = currency.Code == "JPY" ? 0 : 2;
        return $"{currency.Symbol}{amount.ToString($"F{decimals}")}";
    }
}
