@* ============================================================
   Block: storefront-order-tracking
   Title: Storefront Order Tracking
   Description: Order tracking block with status timeline, shipping details, delivery address, and estimated delivery date
   Dependencies: ButtonCn, LucideCheckCn, LucideCopyCn, LucidePackageCn, LucideTruckCn
   Source: original/blocks/storefront/storefront-order-tracking.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-sm font-medium">Order #ORD-2847</h1>
                    <p class="mt-0.5 text-xs text-muted-foreground">Placed on March 12, 2026</p>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideTruckCn Size="16" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs font-medium">In Transit</span>
                </div>
            </div>
        </div>

        @* Tracking Timeline *@
        <div class="border-b px-4 py-4">
            <div class="relative space-y-0">
                @for (var i = 0; i < _trackingSteps.Length; i++)
                {
                    var step = _trackingSteps[i];
                    var isLast = i == _trackingSteps.Length - 1;
                    <div class="flex gap-3">
                        @* Timeline Line + Dot *@
                        <div class="flex flex-col items-center">
                            <div class="@Cn.Merge("size-2.5 shrink-0 rounded-full", step.Status == "completed" ? "bg-emerald-500" : step.Status == "current" ? "bg-primary" : "bg-muted-foreground/30")"></div>
                            @if (!isLast)
                            {
                                <div class="@Cn.Merge("w-px flex-1", step.Status == "completed" ? "bg-emerald-500/50" : "bg-muted-foreground/20")" style="min-height: 40px"></div>
                            }
                        </div>

                        @* Step Content *@
                        <div class="pb-4">
                            <span class="@Cn.Merge("text-xs font-medium", step.Status == "pending" ? "text-muted-foreground" : "text-foreground")">@step.Label</span>
                            <p class="text-xs text-muted-foreground">@step.Description</p>
                            @if (!string.IsNullOrEmpty(step.Timestamp))
                            {
                                <p class="mt-0.5 text-[10px] text-muted-foreground/60">@step.Timestamp</p>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Items in Order *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">Items</span>
            <div class="space-y-2">
                @foreach (var item in _orderItems)
                {
                    <div class="flex items-center gap-3">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucidePackageCn Size="16" Class="size-4 text-muted-foreground/60" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="text-xs font-medium">@item.Name</span>
                            <p class="text-[10px] text-muted-foreground">Size @item.Size &middot; Qty @item.Quantity</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Shipping Details *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">Shipping Details</span>
            <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Carrier</span>
                    <span class="text-xs font-medium">FedEx Ground</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Tracking</span>
                    <div class="flex items-center gap-1.5">
                        <span class="font-mono text-xs">7489 2641 0038</span>
                        <ButtonCn Class="size-5" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" @onclick="HandleCopy" aria-label="Confirm">
                            @if (_copied)
                            {
                                <LucideCheckCn Size="16" Class="size-3 text-emerald-500" />
                            }
                            else
                            {
                                <LucideCopyCn Size="16" Class="size-3" />
                            }
                        </ButtonCn>
                    </div>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Weight</span>
                    <span class="text-xs tabular-nums">1.8 lbs</span>
                </div>
            </div>
        </div>

        @* Delivery Address *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">Delivery Address</span>
            <div class="text-xs leading-relaxed">
                <p class="font-medium">Sarah Johnson</p>
                <p class="text-muted-foreground">742 Evergreen Terrace</p>
                <p class="text-muted-foreground">Apt 4B</p>
                <p class="text-muted-foreground">Brooklyn, NY 11201</p>
            </div>
        </div>

        @* Estimated Delivery *@
        <div class="px-4 py-3">
            <div class="flex items-center gap-2">
                <LucidePackageCn Size="16" Class="size-3.5 text-muted-foreground" />
                <div>
                    <span class="text-xs font-medium">Estimated Delivery: March 15&ndash;16</span>
                    <p class="text-[10px] text-muted-foreground">By end of day</p>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record TrackingStep(string Label, string Description, string Timestamp, string Status);
    private record OrderItem(int Id, string Name, string Size, int Quantity);

    private static readonly TrackingStep[] _trackingSteps =
    {
        new("Order Placed", "Your order has been confirmed", "Mar 12, 9:15 AM", "completed"),
        new("Processing", "Items are being prepared", "Mar 12, 2:30 PM", "completed"),
        new("Shipped", "Package picked up by carrier", "Mar 13, 10:45 AM", "completed"),
        new("Out for Delivery", "With local delivery driver", "Mar 15, 7:20 AM", "current"),
        new("Delivered", "Package delivered to your address", "", "pending")
    };

    private static readonly OrderItem[] _orderItems =
    {
        new(1, "Merino Wool Crewneck Sweater", "M", 1),
        new(2, "Slim Fit Chino Pants", "32", 1)
    };

    private bool _copied;

    private async Task HandleCopy()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
