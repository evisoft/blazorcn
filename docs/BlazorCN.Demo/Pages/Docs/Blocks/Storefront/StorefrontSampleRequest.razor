@* ============================================================
   Block: storefront-sample-request
   Title: Storefront Sample Request
   Description: Free sample request form with product selection checkboxes, shipping address summary, sample limit notice, and expected delivery timeline
   Dependencies: ButtonCn, CheckboxCn, LucideCheckCn, LucidePackageCn, LucideTruckCn
   Source: original/blocks/storefront/storefront-sample-request.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucidePackageCn Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Request Free Samples</h2>
            </div>
            <p class="text-xs text-muted-foreground">
                Choose up to @MaxSamples samples to be delivered to your door
            </p>
        </div>

        @* Sample Limit Notice *@
        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <p class="text-xs text-muted-foreground">
                    <span class="font-medium text-foreground">
                        @_selected.Count/@MaxSamples
                    </span>
                    samples selected &middot; Free shipping on all sample orders &middot; Limit one sample request per 30 days
                </p>
            </div>
        </div>

        @* Sample List *@
        <div class="border-b">
            @for (var i = 0; i < _availableSamples.Length; i++)
            {
                var sample = _availableSamples[i];
                var isSelected = _selected.Contains(sample.Id);
                var isDisabled = !isSelected && _selected.Count >= MaxSamples;
                var isLast = i == _availableSamples.Length - 1;
                <label class="@Cn.Merge("flex cursor-pointer items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "", isDisabled ? "cursor-not-allowed opacity-50" : "")"
                       for="@($"sample-{sample.Id}")">
                    <CheckboxCn Checked="@isSelected"
                                Disabled="@isDisabled"
                                Id="@($"sample-{sample.Id}")"
                                CheckedChanged="@(() => ToggleSample(sample.Id))" />
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@sample.Name</p>
                        <p class="text-xs text-muted-foreground">
                            @sample.Category &middot; @sample.Description
                        </p>
                    </div>
                </label>
            }
        </div>

        @* Shipping Address *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">
                Shipping address
            </span>
            <div class="rounded-md bg-muted/50 p-3">
                <p class="text-sm">Sarah Mitchell</p>
                <p class="text-xs text-muted-foreground">742 Evergreen Terrace, Apt 4B</p>
                <p class="text-xs text-muted-foreground">Portland, OR 97205</p>
                <button class="mt-1.5 text-xs text-muted-foreground underline underline-offset-2 hover:text-foreground"
                        type="button">
                    Change address
                </button>
            </div>
        </div>

        @* Delivery Estimate *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideTruckCn Size="16" Class="size-3.5 text-muted-foreground" />
                <span class="text-xs text-muted-foreground">
                    Expected delivery: 5-7 business days via USPS First Class
                </span>
            </div>
        </div>

        @* Submit *@
        <div class="px-4 py-3">
            <ButtonCn Class="h-8 w-full text-xs"
                      Disabled="@(_selected.Count == 0)"
                      Variant="ButtonVariant.Outline"
                      @onclick="@(() => _submitted = true)">
                @if (_submitted)
                {
                    <LucideCheckCn Size="16" Class="mr-1 size-3" />
                    <text>Request Submitted</text>
                }
                else
                {
                    @($"Request {_selected.Count} Sample{(_selected.Count != 1 ? "s" : "")} \u2014 Free")
                }
            </ButtonCn>
            <p class="mt-2 text-center text-xs text-muted-foreground">
                No payment required &middot; Samples are non-returnable
            </p>
        </div>
    </div>
</section>

@code {
    private record SampleInfo(string Id, string Name, string Category, string Description);

    private const int MaxSamples = 3;

    private static readonly SampleInfo[] _availableSamples =
    {
        new("s1", "Matte Porcelain - Arctic White", "Tile", "4\u2033 \u00d7 4\u2033 swatch \u00b7 Matte finish"),
        new("s2", "Matte Porcelain - Warm Grey", "Tile", "4\u2033 \u00d7 4\u2033 swatch \u00b7 Matte finish"),
        new("s3", "Natural Oak Hardwood", "Flooring", "6\u2033 \u00d7 6\u2033 swatch \u00b7 Wire-brushed"),
        new("s4", "Walnut Herringbone", "Flooring", "6\u2033 \u00d7 6\u2033 swatch \u00b7 Engineered"),
        new("s5", "Linen Blend - Oatmeal", "Fabric", "3\u2033 \u00d7 3\u2033 swatch \u00b7 Medium weight"),
        new("s6", "Brushed Cotton - Slate", "Fabric", "3\u2033 \u00d7 3\u2033 swatch \u00b7 Heavyweight")
    };

    private HashSet<string> _selected = new();
    private bool _submitted;

    private void ToggleSample(string id)
    {
        if (_selected.Contains(id))
        {
            _selected.Remove(id);
        }
        else if (_selected.Count < MaxSamples)
        {
            _selected.Add(id);
        }
    }
}
