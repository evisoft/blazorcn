@* ============================================================
   Block: storefront-price-history
   Title: Storefront Price History
   Description: Price tracking panel showing current price, 90-day high/low, trend direction with arrow indicators, price alert signup, and a text-based price timeline
   Dependencies: ButtonCn, InputCn, LabelCn, LucideArrowDownCn, LucideArrowRightCn, LucideArrowUpCn, LucideBellCn, LucideCheckCn, LucideTrendingDownCn
   Source: original/blocks/storefront/storefront-price-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Price History</h2>
            <p class="text-xs text-muted-foreground">
                Sony WH-1000XM6 Wireless Headphones &middot; Last 90 days
            </p>
        </div>

        @* Current Price + Trend *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div>
                <p class="text-xs text-muted-foreground">Current price</p>
                <span class="text-2xl font-semibold tabular-nums">$@CurrentPrice</span>
            </div>
            <div class="ml-auto flex items-center gap-1.5">
                <LucideTrendingDownCn Size="16" Class="size-4 text-emerald-600 dark:text-emerald-400" />
                <span class="text-sm font-medium text-emerald-600 dark:text-emerald-400">Falling</span>
            </div>
        </div>

        @* 90-Day High / Low *@
        <div class="flex border-b">
            <div class="flex-1 border-r px-4 py-3">
                <p class="text-xs text-muted-foreground">90-day high</p>
                <div class="mt-0.5 flex items-center gap-1.5">
                    <span class="text-lg font-semibold tabular-nums text-red-600 dark:text-red-400">
                        $@HighPrice
                    </span>
                    <LucideArrowUpCn Size="16" Class="size-3 text-red-500" />
                </div>
            </div>
            <div class="flex-1 px-4 py-3">
                <p class="text-xs text-muted-foreground">90-day low</p>
                <div class="mt-0.5 flex items-center gap-1.5">
                    <span class="text-lg font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">
                        $@LowPrice
                    </span>
                    <LucideArrowDownCn Size="16" Class="size-3 text-emerald-500" />
                </div>
            </div>
        </div>

        @* Price Timeline *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">
                Price timeline
            </span>
            <div class="space-y-0">
                @for (var i = 0; i < _priceTimeline.Length; i++)
                {
                    var point = _priceTimeline[i];
                    var isLast = i == _priceTimeline.Length - 1;
                    <div class="@Cn.Merge("flex items-center gap-3 py-2", !isLast ? "border-b border-dashed" : "")">
                        <span class="w-24 shrink-0 font-mono text-xs text-muted-foreground">@point.Date</span>
                        <span class="text-sm font-medium tabular-nums">$@point.Price</span>
                        @if (point.Change != 0)
                        {
                            <span class="@Cn.Merge("flex items-center gap-0.5 text-xs tabular-nums", point.Change > 0 ? "text-red-600 dark:text-red-400" : "text-emerald-600 dark:text-emerald-400")">
                                @if (point.Change > 0)
                                {
                                    <LucideArrowUpCn Size="16" Class="size-3" />
                                }
                                else
                                {
                                    <LucideArrowDownCn Size="16" Class="size-3" />
                                }
                                @(point.Change > 0 ? "+" : "")@point.Change
                            </span>
                        }
                    </div>
                }
            </div>
        </div>

        @* Price Alert Signup *@
        <div class="px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideBellCn Size="16" Class="size-3.5 text-muted-foreground" />
                <span class="text-xs font-medium text-muted-foreground">Price drop alert</span>
            </div>
            <p class="mb-2 mt-1 text-xs text-muted-foreground">
                Get notified when the price drops below your target
            </p>
            <div class="flex gap-2">
                <div class="flex flex-1 items-center gap-1">
                    <LabelCn Class="sr-only" For="price-alert-email">Email</LabelCn>
                    <InputCn Class="h-8 text-xs" id="price-alert-email" placeholder="you@example.com" Type="email" />
                </div>
                <div class="flex items-center gap-1">
                    <span class="text-xs text-muted-foreground">$</span>
                    <LabelCn Class="sr-only" For="price-alert-target">Target price</LabelCn>
                    <InputCn Class="h-8 w-20 text-xs" id="price-alert-target" Placeholder="700" Type="number" />
                </div>
                <ButtonCn Class="h-8 shrink-0 px-3 text-xs" Variant="ButtonVariant.Outline" @onclick="() => _alertSet = true">
                    @if (_alertSet)
                    {
                        <LucideCheckCn Size="16" Class="mr-1 size-3" />
                        <text>Set</text>
                    }
                    else
                    {
                        <text>Set Alert</text>
                    }
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record PricePoint(string Date, int Price, int Change);

    private const int CurrentPrice = 849;
    private const int HighPrice = 999;
    private const int LowPrice = 749;

    private static readonly PricePoint[] _priceTimeline =
    {
        new("Mar 14, 2026", 849, -50),
        new("Mar 7, 2026", 899, 0),
        new("Feb 28, 2026", 899, -100),
        new("Feb 14, 2026", 999, 50),
        new("Jan 31, 2026", 949, 0),
        new("Jan 15, 2026", 949, 200),
        new("Dec 26, 2025", 749, -150)
    };

    private bool _alertSet;
}
