@* ============================================================
   Block: storefront-trade-in
   Title: Storefront Trade In
   Description: Storefront trade-in estimator with product category selection, condition grading, and real-time value calculator
   Dependencies: ButtonCn, LabelCn, RadioGroupCn, RadioGroupItemCn
   Source: original/blocks/storefront/storefront-trade-in.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Trade In &amp; Save</h2>
            <p class="text-xs text-muted-foreground">Get credit toward your next purchase</p>
        </div>

        @* Step 1: Category *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Step 1 &mdash; Select category</p>
            <div class="flex gap-2">
                @foreach (var cat in _categories)
                {
                    <ButtonCn Class="h-7 text-xs"
                              Variant="@(_category == cat.Id ? ButtonVariant.Default : ButtonVariant.Outline)"
                              Size="ButtonSize.Sm"
                              @onclick="@(() => _category = cat.Id)">
                        @cat.Label
                    </ButtonCn>
                }
            </div>
        </div>

        @* Step 2: Condition *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Step 2 &mdash; Rate condition</p>
            <RadioGroupCn TValue="string" Value="@_condition" ValueChanged="@(v => _condition = v)">
                @for (var i = 0; i < _conditions.Length; i++)
                {
                    var cond = _conditions[i];
                    var isLast = i == _conditions.Length - 1;
                    <span class="@Cn.Merge("flex cursor-pointer items-start gap-3 py-2.5 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                        <RadioGroupItemCn Id="@cond.Id" Value="@cond.Id" Class="mt-0.5" />
                        <div class="min-w-0 flex-1">
                            <LabelCn For="@cond.Id" Class="cursor-pointer text-sm font-medium">
                                @cond.Label
                            </LabelCn>
                            <p class="text-xs text-muted-foreground">@cond.Description</p>
                        </div>
                    </span>
                }
            </RadioGroupCn>
        </div>

        @* Estimated Value *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs text-muted-foreground">Estimated trade-in value</p>
                    <p class="text-2xl font-semibold tabular-nums">$@TradeValue</p>
                </div>
                <ButtonCn Class="h-8 text-xs" Size="ButtonSize.Sm">
                    Apply to Cart
                </ButtonCn>
            </div>
        </div>

        @* Fine Print *@
        <div class="px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <p class="text-xs leading-relaxed text-muted-foreground">
                    Trade-in values are estimates and may change upon inspection. Device must be shipped
                    within 14 days of order. Final credit applied after device is received and verified.
                    Trade-in credit cannot be combined with other promotions.
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private record CategoryOption(string Id, string Label);
    private record ConditionOption(string Id, string Label, string Description);

    private static readonly CategoryOption[] _categories =
    {
        new("phones", "Phones"),
        new("laptops", "Laptops"),
        new("tablets", "Tablets")
    };

    private static readonly ConditionOption[] _conditions =
    {
        new("excellent", "Excellent", "Like new, no scratches or dents, fully functional with original accessories"),
        new("good", "Good", "Minor cosmetic wear, all features working, battery holds a full charge"),
        new("fair", "Fair", "Visible scratches or scuffs, fully functional but battery may be degraded"),
        new("poor", "Poor", "Cracked screen or casing damage, some features may not work properly")
    };

    private static readonly Dictionary<string, Dictionary<string, int>> _tradeValues = new()
    {
        ["phones"] = new() { ["excellent"] = 420, ["good"] = 310, ["fair"] = 180, ["poor"] = 75 },
        ["laptops"] = new() { ["excellent"] = 580, ["good"] = 430, ["fair"] = 260, ["poor"] = 110 },
        ["tablets"] = new() { ["excellent"] = 340, ["good"] = 250, ["fair"] = 150, ["poor"] = 60 }
    };

    private string _category = "phones";
    private string _condition = "good";

    private int TradeValue => _tradeValues.GetValueOrDefault(_category)?.GetValueOrDefault(_condition) ?? 0;
}
