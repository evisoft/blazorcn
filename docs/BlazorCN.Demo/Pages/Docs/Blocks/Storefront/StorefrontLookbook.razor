@* ============================================================
   Block: storefront-lookbook
   Title: Storefront Lookbook
   Description: Collection lookbook block with styled outfit looks, product item breakdowns, and shop-this-look actions
   Long Description: Layaway plan configurator with payment frequency selector, installment calculator, down payment breakdown, terms summary, and plan activation for e-commerce stores
   Dependencies: ButtonCn, LucideImageCn, LucidePackageCn, LucideShoppingBagCn
   Source: original/blocks/storefront/storefront-lookbook.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
    <section class="mx-auto w-full max-w-4xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header *@
            <div class="border-b px-4 py-3">
                <h1 class="text-sm font-medium">Spring 2026 Lookbook</h1>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    3 curated looks from our latest collection
                </p>
            </div>

            @* Looks *@
            @for (var li = 0; li < _looks.Length; li++)
            {
                var look = _looks[li];
                var lookTotal = look.Products.Sum(p => p.Price);
                var isLastLook = li == _looks.Length - 1;
                <div class="@(!isLastLook ? "border-b" : "")">
                    @* Look Image *@
                    <div class="flex aspect-[16/9] items-center justify-center border-b bg-muted/50">
                        <LucideImageCn Size="16" Class="size-8 text-muted-foreground/60" />
                    </div>

                    @* Look Title *@
                    <div class="border-b px-4 py-3">
                        <span class="text-sm font-medium">@look.Title</span>
                        <p class="mt-0.5 text-xs text-muted-foreground">@look.Description</p>
                    </div>

                    @* Products in this Look *@
                    <div class="border-b">
                        @for (var pi = 0; pi < look.Products.Length; pi++)
                        {
                            var product = look.Products[pi];
                            var isLastProduct = pi == look.Products.Length - 1;
                            <a
                                class="@(Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", !isLastProduct ? "border-b" : ""))"
                                href="#">
                                <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                                    <LucidePackageCn Size="16" Class="size-3.5 text-muted-foreground/60" />
                                </div>
                                <span class="min-w-0 flex-1 truncate text-xs font-medium">
                                    @product.Name
                                </span>
                                <span class="shrink-0 text-xs text-muted-foreground tabular-nums">
                                    $@product.Price
                                </span>
                            </a>
                        }
                    </div>

                    @* Shop This Look *@
                    <div class="flex items-center justify-between px-4 py-3">
                        <span class="text-xs text-muted-foreground">
                            @look.Products.Length items &middot; <span class="tabular-nums">$@lookTotal</span>
                        </span>
                        <ButtonCn Class="h-7 gap-1 px-3 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                            <LucideShoppingBagCn Size="16" Class="size-3" />
                            Shop this look
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>
    </section>
</section>

@code {
    private record LookProduct(int Id, string Name, int Price);
    private record Look(int Id, string Title, string Description, LookProduct[] Products);

    private static readonly Look[] _looks =
    [
        new(1, "Weekend Brunch", "Effortless layers for a relaxed Saturday morning",
        [
            new(101, "Linen Oversized Shirt", 89),
            new(102, "High-Rise Wide Leg Jeans", 120),
            new(103, "Leather Slide Sandals", 75),
            new(104, "Canvas Tote Bag", 65)
        ]),
        new(2, "Office Ready", "Polished separates that transition from desk to dinner",
        [
            new(201, "Tailored Wool Blazer", 245),
            new(202, "Silk Camisole", 78),
            new(203, "Slim Fit Trousers", 135)
        ]),
        new(3, "Evening Out", "Statement pieces for a night that calls for something special",
        [
            new(301, "Satin Midi Dress", 195),
            new(302, "Strappy Heeled Sandals", 165),
            new(303, "Gold Chain Necklace", 85),
            new(304, "Leather Clutch", 120)
        ])
    ];
}
