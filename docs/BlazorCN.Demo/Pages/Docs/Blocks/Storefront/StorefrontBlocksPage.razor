@code {
    private record QuestionInfo(string Id, string Question, string Asker, string TimeAgo, int Upvotes, string Answer, string AnsweredBy);

    private static readonly QuestionInfo[] _questions =
    {
        new(""1"", ""Is this machine dishwasher safe?"", ""Rachel M."", ""3 weeks ago"", 24, ""Yes, all removable parts including the carafe, filter basket, and water reservoir lid are top-rack dishwasher safe. The base unit should be wiped clean with a damp cloth only."", ""Store Team""),
        new(""2"", ""Does it have a built-in grinder?"", ""James K."", ""2 weeks ago"", 18, ""This model does not include a built-in grinder. We recommend pairing it with our Conical Burr Grinder for the best results. Pre-ground coffee works perfectly as well."", ""Store Team""),
        new(""3"", ""How long does it take to brew a full pot?"", ""Priya S."", ""1 week ago"", 12, ""A full 12-cup pot brews in approximately 8 minutes. The thermal carafe keeps coffee hot for up to 4 hours without a hot plate, which prevents burning."", ""Store Team""),
        new(""4"", ""Can I use it with a reusable filter?"", ""Tom H."", ""5 days ago"", 9, ""Absolutely. It\u2019s compatible with standard #4 cone filters, both paper and reusable mesh. A gold-tone reusable filter is included in the box."", ""Store Team""),
        new(""5"", ""What\u2019s the warranty period?"", ""Linda C."", ""3 days ago"", 6, ""The brewer comes with a 2-year manufacturer warranty covering defects in materials and workmanship. Register your product within 30 days of purchase for an additional 1-year extension."", ""Store Team"")
    };

    private string? _expanded = ""1"";
    private string _searchQuery = """";
    private string _newQuestion = """";
    private Dictionary<string, string> _voted = new();

    private QuestionInfo[] FilteredQuestions => string.IsNullOrWhiteSpace(_searchQuery)
        ? _questions
        : _questions.Where(q =>
            q.Question.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
            q.Answer.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)).ToArray();

    private string GetVoteClass(string id, string type)
    {
        var highlight = type == ""up""
            ? ""text-emerald-600 dark:text-emerald-400""
            : ""text-red-600 dark:text-red-400"";
        return Cn.Merge(""h-6 gap-1 px-2 text-xs"", _voted.GetValueOrDefault(id) == type ? highlight : """");
    }

    private void HandleVoteUp(string id) => HandleVote(id, ""up"");
    private void HandleVoteDown(string id) => HandleVote(id, ""down"");

    private void HandleVote(string id, string type)
    {
        if (_voted.TryGetValue(id, out var existing) && existing == type)
            _voted.Remove(id);
        else
            _voted[id] = type;
    }
}";

