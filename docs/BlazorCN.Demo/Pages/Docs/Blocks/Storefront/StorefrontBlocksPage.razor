                        <div class=""min-w-0 flex-1"">
                            <span class=""text-sm font-medium"">@region.Name</span>
                            <p class=""text-xs text-muted-foreground"">@region.Warehouse</p>
                        </div>
                        <span class=""shrink-0 text-xs text-muted-foreground"">@label</span>
                        <LucideChevronRightCn Size=""16"" Class=""@Cn.Merge(""size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200"", isExpanded ? ""rotate-90"" : """")"" />
                    </button>

                    @if (isExpanded)
                    {
