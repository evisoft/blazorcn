                                @onclick=""@(() => ToggleItem(step.Id, item.Id))""
                                type=""button"">
                                <div class=""@(Cn.Merge(""flex size-5 shrink-0 items-center justify-center rounded-full border transition-colors"", isSelected ? ""border-primary bg-primary"" : ""border-muted-foreground/30""))"">
