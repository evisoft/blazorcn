@code {
    private bool _annual;

    private record BenefitInfo(string Label, bool Included);
    private record TierInfo(string Id, string Name, decimal MonthlyPrice, decimal YearlyPrice, bool IsCurrent, BenefitInfo[] Benefits);

    private static readonly TierInfo[] _tiers =
    [
        new(""free"", ""Free"", 0, 0, true,
        [
            new(""Standard shipping"", true), new(""Order tracking"", true),
            new(""Birthday reward"", false), new(""Early access to sales"", false),
            new(""Free returns"", false), new(""Exclusive member pricing"", false)
        ]),
        new(""plus"", ""Plus"", 9.99m, 95.88m, false,
        [
            new(""Standard shipping"", true), new(""Order tracking"", true),
            new(""Birthday reward"", true), new(""Early access to sales"", true),
            new(""Free returns"", false), new(""Exclusive member pricing"", false)
        ]),
        new(""premium"", ""Premium"", 19.99m, 191.88m, false,
        [
            new(""Standard shipping"", true), new(""Order tracking"", true),
            new(""Birthday reward"", true), new(""Early access to sales"", true),
            new(""Free returns"", true), new(""Exclusive member pricing"", true)
        ])
    ];

    private string FormatPrice(TierInfo tier)
    {
        if (tier.MonthlyPrice == 0) return ""Free"";
        var price = _annual ? tier.YearlyPrice / 12 : tier.MonthlyPrice;
        return $""${price:F2}"";
    }

    private decimal YearlySavings(TierInfo tier)
    {
        if (tier.MonthlyPrice == 0) return 0;
        return tier.MonthlyPrice * 12 - tier.YearlyPrice;
    }
}";

