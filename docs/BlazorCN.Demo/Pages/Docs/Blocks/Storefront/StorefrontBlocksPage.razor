@code {
    private record CartItem(string Id, string Name, int Quantity, decimal UnitPrice);
    private record TaxRateInfo(decimal Rate, string Label);
    private record ItemTax(string Id, string Name, int Quantity, decimal UnitPrice, decimal LineTotal, decimal Tax);

    private static readonly CartItem[] _cartItems =
    {
        new(""1"", ""Ergonomic Office Chair"", 1, 549.0m),
        new(""2"", ""Wireless Keyboard"", 2, 79.0m),
        new(""3"", ""USB-C Monitor Cable"", 3, 24.99m)
    };

    private static readonly Dictionary<string, Dictionary<string, TaxRateInfo>> _taxRates = new()
    {
        [""US""] = new()
        {
            [""CA""] = new(7.25m, ""California Sales Tax""),
            [""NY""] = new(8.0m, ""New York Sales Tax""),
            [""TX""] = new(6.25m, ""Texas Sales Tax""),
            [""WA""] = new(6.5m, ""Washington Sales Tax""),
            [""OR""] = new(0m, ""Oregon (No Sales Tax)"")
        },
        [""GB""] = new()
        {
            [""EN""] = new(20m, ""UK VAT""),
            [""SC""] = new(20m, ""UK VAT"")
        },
        [""DE""] = new()
        {
            [""BY""] = new(19m, ""German VAT (MwSt)""),
            [""BE""] = new(19m, ""German VAT (MwSt)"")
        },
        [""CA""] = new()
        {
            [""ON""] = new(13m, ""Ontario HST""),
            [""BC""] = new(12m, ""British Columbia PST + GST""),
            [""AB""] = new(5m, ""Alberta GST"")
        }
    };

    private static readonly Dictionary<string, string> _countries = new()
    {
        [""US""] = ""United States"",
        [""GB""] = ""United Kingdom"",
        [""DE""] = ""Germany"",
        [""CA""] = ""Canada""
    };

    private static readonly Dictionary<string, Dictionary<string, string>> _states = new()
    {
        [""US""] = new() { [""CA""] = ""California"", [""NY""] = ""New York"", [""TX""] = ""Texas"", [""WA""] = ""Washington"", [""OR""] = ""Oregon"" },
        [""GB""] = new() { [""EN""] = ""England"", [""SC""] = ""Scotland"" },
        [""DE""] = new() { [""BY""] = ""Bavaria"", [""BE""] = ""Berlin"" },
        [""CA""] = new() { [""ON""] = ""Ontario"", [""BC""] = ""British Columbia"", [""AB""] = ""Alberta"" }
    };

    private string _country = ""US"";
    private string _state = ""CA"";
    private bool _taxInclusive;
    private string _vatNumber = """";
    private bool _vatApplied;

    private Dictionary<string, string> AvailableStates =>
        _states.GetValueOrDefault(_country) ?? new();

    private TaxRateInfo TaxInfo =>
        _taxRates.GetValueOrDefault(_country)?.GetValueOrDefault(_state) ?? new(0m, ""No tax data"");

    private decimal EffectiveRate => _vatApplied ? 0m : TaxInfo.Rate;

    private decimal Subtotal => _cartItems.Sum(i => i.UnitPrice * i.Quantity);

    private ItemTax[] ItemTaxes => _cartItems.Select(item =>
    {
        var lineTotal = item.UnitPrice * item.Quantity;
        var tax = _taxInclusive
            ? lineTotal - lineTotal / (1m + EffectiveRate / 100m)
            : lineTotal * (EffectiveRate / 100m);
        return new ItemTax(item.Id, item.Name, item.Quantity, item.UnitPrice, lineTotal, Math.Round(tax, 2));
    }).ToArray();

    private decimal TotalTax => ItemTaxes.Sum(i => i.Tax);
    private decimal GrandTotal => _taxInclusive ? Subtotal : Subtotal + TotalTax;

    private void OnCountryChange(ChangeEventArgs e)
    {
        _country = e.Value?.ToString() ?? ""US"";
        var states = AvailableStates;
        _state = states.Keys.FirstOrDefault() ?? """";
        _vatApplied = false;
    }

    private void OnStateChange(ChangeEventArgs e)
    {
        _state = e.Value?.ToString() ?? """";
        _vatApplied = false;
    }

    private void HandleValidateVat()
    {
        if (_vatNumber.Trim().Length >= 8)
        {
            _vatApplied = true;
        }
    }

    private void HandleRemoveVat()
    {
        _vatApplied = false;
        _vatNumber = """";
    }
}";

