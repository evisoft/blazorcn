@code {
    private List<string> _selectedColors = [""black""];
    private List<string> _selectedSizes = [""M""];
    private string _minPrice = """";
    private string _maxPrice = """";

    private record ColorOption(string Value, string Label, string Hex);
    private record ProductInfo(int Id, string Name, int Price, string Color, string ColorHex, string Size);
    private record FilterChip(string Type, string Value, string Label);

    private static readonly ColorOption[] _colors =
    [
        new(""black"", ""Black"", ""#1a1a1a""),
        new(""navy"", ""Navy"", ""#1e3a5f""),
        new(""cream"", ""Cream"", ""#f5f0e1""),
        new(""red"", ""Red"", ""#dc2626"")
    ];

    private static readonly string[] _sizes = [""XS"", ""S"", ""M"", ""L"", ""XL""];

    private static readonly ProductInfo[] _products =
    [
        new(1, ""Wool Blend Overcoat"", 345, ""black"", ""#1a1a1a"", ""M""),
        new(2, ""Quilted Puffer Jacket"", 225, ""navy"", ""#1e3a5f"", ""S""),
        new(3, ""Trench Coat"", 289, ""cream"", ""#f5f0e1"", ""L""),
        new(4, ""Leather Biker Jacket"", 495, ""black"", ""#1a1a1a"", ""M""),
        new(5, ""Down Parka"", 380, ""navy"", ""#1e3a5f"", ""XL""),
        new(6, ""Cropped Bomber Jacket"", 195, ""red"", ""#dc2626"", ""XS""),
        new(7, ""Shearling-Lined Coat"", 520, ""cream"", ""#f5f0e1"", ""M""),
        new(8, ""Rain Jacket"", 145, ""black"", ""#1a1a1a"", ""S"")
    ];

    private ProductInfo[] FilteredProducts => _products.Where(p =>
    {
        if (_selectedColors.Count > 0 && !_selectedColors.Contains(p.Color)) return false;
        if (_selectedSizes.Count > 0 && !_selectedSizes.Contains(p.Size)) return false;
        if (!string.IsNullOrEmpty(_minPrice) && int.TryParse(_minPrice, out var min) && p.Price < min) return false;
        if (!string.IsNullOrEmpty(_maxPrice) && int.TryParse(_maxPrice, out var max) && p.Price > max) return false;
        return true;
    }).ToArray();

    private FilterChip[] ActiveFilters
    {
        get
        {
            var filters = new List<FilterChip>();
            foreach (var c in _selectedColors)
            {
                var color = _colors.FirstOrDefault(col => col.Value == c);
                if (color != null) filters.Add(new(""color"", c, color.Label));
            }
            foreach (var s in _selectedSizes)
            {
                filters.Add(new(""size"", s, $""Size {s}""));
            }
            if (!string.IsNullOrEmpty(_minPrice)) filters.Add(new(""minPrice"", _minPrice, $""Min ${_minPrice}""));
            if (!string.IsNullOrEmpty(_maxPrice)) filters.Add(new(""maxPrice"", _maxPrice, $""Max ${_maxPrice}""));
            return filters.ToArray();
        }
    }

    private void ToggleColor(string color)
    {
        if (_selectedColors.Contains(color)) _selectedColors.Remove(color);
        else _selectedColors.Add(color);
    }

    private void ToggleSize(string size)
    {
        if (_selectedSizes.Contains(size)) _selectedSizes.Remove(size);
        else _selectedSizes.Add(size);
    }

    private void RemoveFilter(string type, string value)
    {
        if (type == ""color"") ToggleColor(value);
        else if (type == ""size"") ToggleSize(value);
        else if (type == ""minPrice"") _minPrice = """";
        else if (type == ""maxPrice"") _maxPrice = """";
    }

    private void ClearAll()
    {
        _selectedColors.Clear();
        _selectedSizes.Clear();
        _minPrice = """";
        _maxPrice = """";
    }
}
";

