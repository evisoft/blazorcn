@code {
    private record CartItem(string Id, string Name, string Variant, decimal Price, int Quantity);

    private const string DiscountCode = ""COMEBACK15"";
    private const int DiscountPercent = 15;

    private List<CartItem> _items = new()
    {
        new(""1"", ""Merino Wool Sweater"", ""Charcoal \u00b7 Size M"", 128.00m, 1),
        new(""2"", ""Slim Fit Chinos"", ""Navy \u00b7 32\u00d732"", 89.00m, 2),
        new(""3"", ""Canvas Sneakers"", ""White \u00b7 US 10"", 74.00m, 1)
    };

    private string _promoCode = """";
    private bool _promoApplied;
    private List<string> _savedForLater = new();

    private List<CartItem> _activeItems => _items.Where(i => !_savedForLater.Contains(i.Id)).ToList();
    private List<CartItem> _savedItems => _items.Where(i => _savedForLater.Contains(i.Id)).ToList();

    private decimal Subtotal => _activeItems.Sum(i => i.Price * i.Quantity);
    private decimal Discount => _promoApplied ? Subtotal * DiscountPercent / 100m : 0m;
    private decimal Total => Subtotal - Discount;

    private void RemoveItem(string id)
    {
        _items = _items.Where(i => i.Id != id).ToList();
        _savedForLater = _savedForLater.Where(s => s != id).ToList();
    }

    private void SaveForLater(string id)
    {
        _savedForLater.Add(id);
    }

    private void MoveToCart(string id)
    {
        _savedForLater = _savedForLater.Where(s => s != id).ToList();
    }

    private void ApplyPromo()
    {
        if (_promoCode.Trim().ToUpperInvariant() == DiscountCode)
        {
            _promoApplied = true;
        }
    }

    private void RemovePromo()
    {
        _promoApplied = false;
        _promoCode = """";
    }
}";

