@code {
    private enum VerificationState { Idle, Verified, Denied }

    private static readonly string[] _months = { ""January"", ""February"", ""March"", ""April"", ""May"", ""June"", ""July"", ""August"", ""September"", ""October"", ""November"", ""December"" };
    private static readonly string[] _days = Enumerable.Range(1, 31).Select(i => i.ToString()).ToArray();
    private static readonly string[] _years = Enumerable.Range(0, 100).Select(i => (2008 - i).ToString()).ToArray();

    private string _month = """";
    private string _day = """";
    private string _year = """";
    private bool _rememberMe;
    private VerificationState _status = VerificationState.Idle;

    private bool IsFormComplete => _month != """" && _day != """" && _year != """";

    private void HandleVerify()
    {
        if (!IsFormComplete) return;

        var birthYear = int.Parse(_year);
        var birthMonth = Array.IndexOf(_months, _month);
        var birthDay = int.Parse(_day);

        var minAge = 21;
        var cutoffYear = 2026 - minAge;
        var cutoffMonth = 2; // March (0-indexed)
        var cutoffDay = 16;

        if (birthYear < cutoffYear ||
            (birthYear == cutoffYear && birthMonth < cutoffMonth) ||
            (birthYear == cutoffYear && birthMonth == cutoffMonth && birthDay <= cutoffDay))
        {
            _status = VerificationState.Verified;
        }
        else
        {
            _status = VerificationState.Denied;
        }
    }
}
";

