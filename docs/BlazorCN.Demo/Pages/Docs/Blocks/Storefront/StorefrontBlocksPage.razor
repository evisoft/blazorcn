        new(5, ""Merino Wool Beanie"", 42, null, 4.7m, 198, ""Accessories""),
        new(6, ""Fleece Lined Gloves"", 58, 72, 4.4m, 83, ""Accessories""),
        new(7, ""Chunky Ribbed Cardigan"", 155, null, 4.8m, 142, ""Knitwear"")
    };

    private string _activeCategory = ""All"";
    private string _sortBy = ""relevance"";

    private ProductInfo[] SortedProducts
    {
        get
        {
            var filtered = _activeCategory == ""All""
                ? _products
                : _products.Where(p => p.Category == _activeCategory).ToArray();

            return _sortBy switch
            {
                ""price-low"" => filtered.OrderBy(p => p.Price).ToArray(),
                ""price-high"" => filtered.OrderByDescending(p => p.Price).ToArray(),
                ""rating"" => filtered.OrderByDescending(p => p.Rating).ToArray(),
                _ => filtered
            };
        }
    }

    private void OnSortChange(ChangeEventArgs e) => _sortBy = e.Value?.ToString() ?? ""relevance"";
}";

