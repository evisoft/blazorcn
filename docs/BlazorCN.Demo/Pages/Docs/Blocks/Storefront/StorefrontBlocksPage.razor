@code {
    private List<int> _selected = new();
    private List<int> _addedItems = new();
    private Dictionary<int, int> _quantities = new();

    private record ReorderItem(int Id, string Name, string Variant, int CurrentPrice, int LastPrice, string LastOrdered, bool InStock);

    private static readonly ReorderItem[] _items =
    [
        new(1, ""Organic Cold Brew Coffee"", ""12 oz / Medium Roast"", 14, 14, ""Mar 3, 2026"", true),
        new(2, ""Whole Grain Granola"", ""16 oz / Maple Pecan"", 9, 8, ""Mar 3, 2026"", true),
        new(3, ""Greek Yogurt"", ""32 oz / Plain"", 6, 7, ""Feb 24, 2026"", true),
        new(4, ""Almond Butter"", ""12 oz / Unsalted"", 12, 12, ""Feb 24, 2026"", true),
        new(5, ""Sourdough Bread"", ""1 loaf / Sesame"", 7, 7, ""Feb 17, 2026"", false)
    ];

    protected override void OnInitialized()
    {
        foreach (var item in _items)
            _quantities[item.Id] = 1;
    }

    private void UpdateQuantity(int id, int delta)
    {
        var current = _quantities.GetValueOrDefault(id, 1);
        _quantities[id] = Math.Clamp(current + delta, 1, 10);
    }

    private void ToggleSelect(int id)
    {
        if (_selected.Contains(id))
            _selected.Remove(id);
        else
            _selected.Add(id);
    }

    private void ToggleSelectAll(bool _)
    {
        if (AllSelected)
            _selected.Clear();
        else
            _selected = _items.Where(i => i.InStock).Select(i => i.Id).ToList();
    }

    private async Task AddToCart(int id)
    {
        _addedItems.Add(id);
        StateHasChanged();
        await Task.Delay(2000);
        _addedItems.Remove(id);
    }

    private async Task AddAllToCart()
    {
        var toAdd = _selected.Where(id => _items.Any(i => i.Id == id && i.InStock)).ToList();
        _addedItems.AddRange(toAdd);
        StateHasChanged();
        await Task.Delay(2000);
        foreach (var id in toAdd)
            _addedItems.Remove(id);
    }

    private bool AllSelected => _items.Where(i => i.InStock).All(i => _selected.Contains(i.Id));

    private int SelectedTotal => _selected
        .Where(id => _items.Any(i => i.Id == id && i.InStock))
        .Sum(id => {
            var item = _items.First(i => i.Id == id);
            return item.CurrentPrice * _quantities.GetValueOrDefault(id, 1);
        });
}";

