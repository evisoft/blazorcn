@code {
    private const string StorefrontAbandonedCartRecoveryCode = @"<section class=""mx-auto w-full max-w-2xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        @* Header *@
        <div class=""border-b px-4 py-3"">
            <div class=""flex items-center gap-2"">
                <LucideShoppingBagCn Size=""16"" Class=""size-4 text-muted-foreground"" />
                <h2 class=""font-medium text-sm"">You left something behind</h2>
            </div>
            <p class=""mt-0.5 text-muted-foreground text-xs"">
                Your cart is waiting — complete your purchase before items sell out
            </p>
        </div>

        @* Discount Banner *@
        <div class=""border-b bg-muted/50 px-4 py-3"">
            <div class=""flex items-center gap-2"">
                <LucideTagCn Size=""16"" Class=""size-3.5 text-muted-foreground"" />
                <p class=""font-medium text-sm"">@DiscountPercent% off your order</p>
            </div>
            <p class=""mt-0.5 text-muted-foreground text-xs"">
                Use code <span class=""font-mono font-medium text-foreground"">@DiscountCode</span> — expires in 23 hours
            </p>
        </div>

        @* Cart Items *@
        <div>
            @for (var i = 0; i < _activeItems.Count; i++)
            {
                var item = _activeItems[i];
                var isLast = i == _activeItems.Count - 1;
                <div class=""@Cn.Merge(""flex items-center gap-3 px-4 py-3"", !isLast ? ""border-b"" : """")"">
                    <div class=""flex size-12 shrink-0 items-center justify-center rounded-md bg-muted/50"">
                        <LucidePackageCn Size=""16"" Class=""size-4 text-muted-foreground/60"" />
                    </div>
                    <div class=""min-w-0 flex-1"">
                        <p class=""font-medium text-sm"">@item.Name</p>
                        <p class=""text-muted-foreground text-xs"">@item.Variant</p>
                        <p class=""mt-0.5 text-muted-foreground text-xs"">Qty: @item.Quantity</p>
                    </div>
                    <div class=""shrink-0 text-right"">
                        <p class=""font-medium text-sm tabular-nums"">
                            $@((item.Price * item.Quantity).ToString(""F2""))
                        </p>
                        <div class=""mt-1 flex items-center gap-1"">
                            <ButtonCn Class=""size-6"" Size=""ButtonSize.Icon"" Variant=""ButtonVariant.Ghost"" @onclick=""() => SaveForLater(item.Id)"" aria-label=""Bookmark"">
