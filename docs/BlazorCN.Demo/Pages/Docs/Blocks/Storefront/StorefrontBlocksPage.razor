    private List<AddressInfo> _addresses = new()
    {
        new() { Id = 1, Name = ""Sarah Mitchell"", Street = ""742 Evergreen Terrace"", City = ""Portland"", State = ""OR"", Zip = ""97201"", Phone = ""(503) 555-0147"", IsDefault = true },
        new() { Id = 2, Name = ""Sarah Mitchell"", Street = ""1200 NW Marshall St, Apt 4B"", City = ""Portland"", State = ""OR"", Zip = ""97209"", Phone = ""(503) 555-0183"", IsDefault = false },
        new() { Id = 3, Name = ""James Mitchell"", Street = ""89 Hawthorne Blvd"", City = ""Seattle"", State = ""WA"", Zip = ""98101"", Phone = ""(206) 555-0291"", IsDefault = false }
    };

    private bool _showForm;
    private string _formName = """";
    private string _formStreet = """";
    private string _formCity = """";
    private string _formState = """";
    private string _formZip = """";
    private string _formPhone = """";
    private bool _formDefault;

    private void RemoveAddress(int id) => _addresses.RemoveAll(a => a.Id == id);

    private void SetDefault(int id)
    {
        foreach (var a in _addresses) a.IsDefault = a.Id == id;
    }

    private void AddAddress()
    {
        if (string.IsNullOrEmpty(_formName) || string.IsNullOrEmpty(_formStreet) ||
            string.IsNullOrEmpty(_formCity) || string.IsNullOrEmpty(_formState) ||
            string.IsNullOrEmpty(_formZip)) return;

        var newId = _addresses.Count > 0 ? _addresses.Max(a => a.Id) + 1 : 1;
        if (_formDefault)
            foreach (var a in _addresses) a.IsDefault = false;

        _addresses.Add(new AddressInfo
        {
            Id = newId, Name = _formName, Street = _formStreet,
            City = _formCity, State = _formState, Zip = _formZip,
            Phone = _formPhone, IsDefault = _formDefault
        });

        _formName = """"; _formStreet = """"; _formCity = """";
        _formState = """"; _formZip = """"; _formPhone = """";
        _formDefault = false; _showForm = false;
    }
