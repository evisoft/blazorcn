@code {
    private string _chest = """";
    private string _waist = """";
    private string _fitPreference = ""regular"";
    private string? _recommendedSize;

    private record SizeChartRow(string Size, string Chest, string Waist, string Hips);
    private record FitOption(string Value, string Label, string Desc);
    private record MeasureGuideItem(string Label, string Description);

    private static readonly SizeChartRow[] _sizeChart =
    [
        new(""XS"", ""32-34"", ""26-28"", ""34-36""),
        new(""S"", ""35-37"", ""29-31"", ""37-39""),
        new(""M"", ""38-40"", ""32-34"", ""40-42""),
        new(""L"", ""41-43"", ""35-37"", ""43-45""),
        new(""XL"", ""44-46"", ""38-40"", ""46-48""),
        new(""XXL"", ""47-49"", ""41-43"", ""49-51"")
    ];

    private static readonly FitOption[] _fitOptions =
    [
        new(""slim"", ""Slim"", ""Close to body""),
        new(""regular"", ""Regular"", ""Classic fit""),
        new(""relaxed"", ""Relaxed"", ""Room to move"")
    ];

    private static readonly MeasureGuideItem[] _measureGuide =
    [
        new(""Chest"", ""Measure around the fullest part, keeping tape horizontal""),
        new(""Waist"", ""Measure at your natural waistline, the narrowest point""),
        new(""Hips"", ""Measure around the fullest part of hips and buttocks"")
    ];

    private static readonly string[] _sizeOrder = [""XS"", ""S"", ""M"", ""L"", ""XL"", ""XXL""];

    private void FindSize()
    {
        if (!int.TryParse(_chest, out var chestNum) || !int.TryParse(_waist, out var waistNum))
            return;

        string size;
        if (chestNum <= 34 && waistNum <= 28) size = ""XS"";
        else if (chestNum <= 37 && waistNum <= 31) size = ""S"";
        else if (chestNum <= 40 && waistNum <= 34) size = ""M"";
        else if (chestNum <= 43 && waistNum <= 37) size = ""L"";
        else if (chestNum <= 46 && waistNum <= 40) size = ""XL"";
        else size = ""XXL"";

        var idx = Array.IndexOf(_sizeOrder, size);
        if (_fitPreference == ""relaxed"" && size != ""XXL"")
            size = _sizeOrder[idx + 1];
        else if (_fitPreference == ""slim"" && size != ""XS"")
            size = _sizeOrder[idx - 1];

        _recommendedSize = size;
    }

    private void ResetFinder()
    {
        _chest = """";
        _waist = """";
        _fitPreference = ""regular"";
        _recommendedSize = null;
    }
}";

