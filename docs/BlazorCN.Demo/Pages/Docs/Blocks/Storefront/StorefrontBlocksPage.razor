                <LucideSearchCn Size=""16"" Class=""absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground"" />
                <InputCn aria-label=""Search by region or city"" Class=""h-8 pl-8 text-xs"" Placeholder=""Search by region or city..."" @bind-Value=""_search"" />
            </div>
        </div>

        @* Region List *@
        <div>
            @{ var filtered = FilteredRegions; }
            @for (var i = 0; i < filtered.Length; i++)
            {
                var region = filtered[i];
                var isExpanded = _selectedRegion == region.Id;
                var isLast = i == filtered.Length - 1;
                var dot = GetStatusDot(region.Status);
                var label = GetStatusLabel(region.Status);

                <div class=""@(!isLast || isExpanded ? ""border-b"" : """")"">
                    <button class=""@Cn.Merge(""flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"", region.Status == ""out-of-stock"" ? ""opacity-60"" : """")""
