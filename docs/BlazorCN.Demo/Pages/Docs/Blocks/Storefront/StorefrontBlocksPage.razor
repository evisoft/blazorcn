@code {
    private record PriceTier(int MinQty, int? MaxQty, decimal UnitPrice, string Label);

    private const string ProductName = ""Premium Cotton T-Shirt (Blank)"";
    private const decimal BasePrice = 24.99m;
    private const int MinOrder = 25;

    private static readonly PriceTier[] _tiers =
    {
        new(25, 49, 18.99m, ""25-49 units""),
        new(50, 99, 15.99m, ""50-99 units""),
        new(100, 249, 12.99m, ""100-249 units""),
        new(250, 499, 10.99m, ""250-499 units""),
        new(500, null, 8.99m, ""500+ units"")
    };

    private int _quantity = 50;
    private string _quantityStr
    {
        get => _quantity.ToString();
        set
        {
            if (int.TryParse(value, out var num) && num >= 0 && num <= 9999)
                _quantity = num;
        }
    }

    private PriceTier? CurrentTier
    {
        get
        {
            for (var i = _tiers.Length - 1; i >= 0; i--)
                if (_quantity >= _tiers[i].MinQty) return _tiers[i];
            return null;
        }
    }

    private decimal UnitPrice => CurrentTier?.UnitPrice ?? BasePrice;
    private decimal TotalPrice => UnitPrice * _quantity;
    private decimal Savings => (BasePrice - UnitPrice) * _quantity;
    private int DiscountPercent => (int)Math.Round((BasePrice - UnitPrice) / BasePrice * 100);
    private bool IsValidOrder => _quantity >= MinOrder;

    private string EstimatedDelivery => _quantity switch
    {
        <= 99 => ""5-7 business days"",
        <= 249 => ""7-10 business days"",
        <= 499 => ""10-14 business days"",
        _ => ""14-21 business days""
    };

    private void IncrementQuantity(int amount) => _quantity = Math.Max(0, Math.Min(9999, _quantity + amount));
}";

