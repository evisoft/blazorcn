@code {
    private string _activeStep = ""main"";
    private Dictionary<string, List<string>> _selections = new()
    {
        [""main""] = new(),
        [""sides""] = new(),
        [""drink""] = new()
    };

    private const decimal BundleDiscount = 0.1m;

    private record BundleItem(string Id, string Name, string Description, decimal Price);
    private record BundleStep(string Id, string Title, string ShortTitle, string Subtitle, int Required, BundleItem[] Items);

    private static readonly BundleStep[] _bundleSteps =
    [
        new(""main"", ""Choose Your Main"", ""Main"", ""Pick 1 entr\u00e9e"", 1,
        [
            new(""m1"", ""Grilled Chicken Bowl"", ""Herb-marinated chicken, jasmine rice, roasted vegetables"", 14.99m),
            new(""m2"", ""Teriyaki Salmon"", ""Glazed Atlantic salmon, soba noodles, edamame"", 17.99m),
            new(""m3"", ""Mushroom Risotto"", ""Arborio rice, wild mushrooms, parmesan, truffle oil"", 13.99m),
            new(""m4"", ""BBQ Pulled Pork"", ""Slow-smoked pork, coleslaw, brioche bun"", 15.99m)
        ]),
        new(""sides"", ""Add Two Sides"", ""Sides"", ""Pick 2 sides"", 2,
        [
            new(""s1"", ""Caesar Salad"", ""Romaine, croutons, parmesan, house dressing"", 5.99m),
            new(""s2"", ""Sweet Potato Fries"", ""Crispy baked with sea salt and chipotle aioli"", 4.99m),
            new(""s3"", ""Miso Soup"", ""White miso, tofu, wakame, scallions"", 3.99m),
            new(""s4"", ""Garlic Bread"", ""Sourdough, roasted garlic butter, herbs"", 4.49m),
            new(""s5"", ""Seasonal Fruit"", ""Fresh mixed berries and sliced melon"", 5.49m)
        ]),
        new(""drink"", ""Pick a Drink"", ""Drink"", ""Pick 1 beverage"", 1,
        [
            new(""d1"", ""Sparkling Water"", ""San Pellegrino, 500ml"", 2.99m),
            new(""d2"", ""Fresh Lemonade"", ""House-squeezed with mint"", 4.49m),
            new(""d3"", ""Iced Matcha Latte"", ""Ceremonial grade matcha, oat milk"", 5.99m),
            new(""d4"", ""Cold Brew Coffee"", ""24-hour steeped, served over ice"", 4.99m)
        ])
    ];

    private static readonly BundleItem[] _allItems = _bundleSteps.SelectMany(s => s.Items).ToArray();

    private void ToggleItem(string stepId, string itemId)
    {
        var step = _bundleSteps.FirstOrDefault(s => s.Id == stepId);
        if (step is null) return;

        var current = _selections[stepId];
        if (current.Contains(itemId))
        {
            current.Remove(itemId);
        }
        else if (current.Count >= step.Required)
        {
            if (step.Required == 1)
            {
                current.Clear();
                current.Add(itemId);
            }
        }
        else
        {
            current.Add(itemId);
        }
    }

    private BundleItem[] SelectedItems => _selections.Values
        .SelectMany(ids => ids)
        .Select(id => _allItems.FirstOrDefault(i => i.Id == id))
        .Where(i => i is not null)
        .ToArray()!;

    private decimal Subtotal => SelectedItems.Sum(i => i.Price);

    private bool IsComplete => _bundleSteps.All(s =>
        _selections.ContainsKey(s.Id) && _selections[s.Id].Count >= s.Required);

    private decimal Discount => IsComplete ? Math.Round(Subtotal * BundleDiscount, 2) : 0;
    private decimal Total => Subtotal - Discount;

    private int CompletedSteps => _bundleSteps.Count(s =>
        _selections.ContainsKey(s.Id) && _selections[s.Id].Count >= s.Required);
}";

