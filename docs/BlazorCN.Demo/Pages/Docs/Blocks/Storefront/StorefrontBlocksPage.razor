                         Placeholder=""@EmailPlaceholder""
                         Type=""email"" />
                <ButtonCn Class=""h-8 px-3 text-xs""
                          Variant=""ButtonVariant.Outline""
                          @onclick=""@(() => _joined = true)"">
                    @if (_joined)
                    {
                        <LucideCheckCn Size=""16"" Class=""mr-1 size-3"" />
                        <text>Joined</text>
                    }
                    else
                    {
                        <text>Join Waitlist</text>
                    }
                </ButtonCn>
            </div>
        </div>

        @* Notification Preferences *@
        <div class=""border-b px-4 py-3"">
            <span class=""mb-2 block text-xs font-medium text-muted-foreground"">
                Notification Preferences
            </span>
            <div class=""flex flex-col gap-2"">
                <label class=""flex cursor-pointer items-center gap-2"" for=""notify-email"">
                    <CheckboxCn Id=""notify-email"" @bind-Checked=""_notifyEmail"" />
                    <LucideMailCn Size=""16"" Class=""size-3.5 text-muted-foreground"" />
                    <span class=""text-sm"">Email notifications</span>
                </label>
                <label class=""flex cursor-pointer items-center gap-2"" for=""notify-sms"">
                    <CheckboxCn Id=""notify-sms"" @bind-Checked=""_notifySms"" />
                    <LucideMessageSquareCn Size=""16"" Class=""size-3.5 text-muted-foreground"" />
                    <span class=""text-sm"">SMS notifications</span>
                </label>
            </div>
        </div>

        @* Share *@
        <div class=""border-b px-4 py-3"">
            <span class=""mb-2 block text-xs font-medium text-muted-foreground"">
                Share with Friends
            </span>
            <p class=""mb-2 text-xs text-muted-foreground"">
                Move up the list when friends join through your link
            </p>
            <ButtonCn Class=""h-7 gap-1 px-2 text-xs"" Variant=""ButtonVariant.Ghost"" @onclick=""HandleCopyLink"">
                @if (_copied)
                {
                    <LucideCheckCn Size=""16"" Class=""size-3"" />
                    <text>Copied</text>
                }
                else
                {
                    <LucideCopyCn Size=""16"" Class=""size-3"" />
                    <text>Copy referral link</text>
                }
            </ButtonCn>
        </div>

        @* Stats *@
        <div class=""flex items-center gap-6 px-4 py-3"">
            <div class=""flex items-center gap-2"">
                <LucideUsersCn Size=""16"" Class=""size-3.5 text-muted-foreground"" />
                <span class=""text-xs text-muted-foreground"">1,200 people waiting</span>
            </div>
            <div class=""flex items-center gap-1.5"">
                <span class=""size-1.5 rounded-full bg-emerald-500""></span>
                <span class=""text-xs text-muted-foreground"">94% fulfillment rate</span>
            </div>
        </div>
    </div>
</section>

@code {
    private const string EmailPlaceholder = ""you@example.com"";

    private bool _joined;
    private bool _copied;
    private bool _notifyEmail = true;
    private bool _notifySms;

    private async Task HandleCopyLink()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}";

    private const string StorefrontWishlistCode = @"<section class=""mx-auto w-full max-w-4xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        @* Header *@
        <div class=""border-b px-4 py-3"">
            <div class=""flex items-center gap-2"">
                <LucideHeartCn Size=""16"" Class=""size-4 text-muted-foreground"" />
                <h1 class=""text-sm font-medium"">Saved Items (@_items.Count)</h1>
            </div>
        </div>

        @* Wishlist Items *@
        @if (_items.Count > 0)
        {
            <div>
                @for (var i = 0; i < _items.Count; i++)
                {
                    var item = _items[i];
                    var stockInfo = GetStockConfig(item.Stock);
                    var isLast = i == _items.Count - 1;
                    <div class=""@Cn.Merge(""flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50"", !isLast ? ""border-b"" : """")"">
                        @* Product Image *@
                        <div class=""flex size-14 shrink-0 items-center justify-center rounded-md border bg-muted/50"">
                            <LucidePackageCn Size=""16"" Class=""size-5 text-muted-foreground/60"" />
                        </div>

                        @* Product Info *@
                        <div class=""min-w-0 flex-1"">
                            <span class=""text-sm font-medium"">@item.Name</span>
                            <div class=""mt-0.5 flex items-center gap-2"">
                                <span class=""text-sm font-semibold tabular-nums"">$@item.Price</span>
                                @if (item.OriginalPrice.HasValue)
                                {
                                    <span class=""text-xs tabular-nums text-muted-foreground line-through"">
                                        $@item.OriginalPrice
                                    </span>
                                }
                            </div>
                            <div class=""mt-1 flex items-center gap-3"">
                                <span class=""text-xs text-muted-foreground"">Size: @item.Size</span>
                                <div class=""flex items-center gap-1"">
                                    <span class=""@Cn.Merge(""size-1.5 rounded-full"", stockInfo.DotClass)""></span>
                                    <span class=""text-xs text-muted-foreground"">@stockInfo.Label</span>
                                </div>
                            </div>
                        </div>

                        @* Actions *@
                        <div class=""flex shrink-0 items-center gap-1.5"">
                            <ButtonCn Class=""h-7 gap-1 px-2 text-xs""
                                      Disabled=""@(item.Stock == ""out-of-stock"")""
                                      Size=""ButtonSize.Sm""
                                      Variant=""ButtonVariant.Outline"">
                                <LucideShoppingBagCn Size=""16"" Class=""size-3"" />
                                <span class=""hidden sm:inline"">Add to Cart</span>
                            </ButtonCn>
                            @{
                                var itemId = item.Id;
                            }
                            <ButtonCn Class=""size-7 text-muted-foreground""
                                      Size=""ButtonSize.Icon""
                                      Variant=""ButtonVariant.Ghost""
                                      @onclick=""@(() => RemoveItem(itemId))"" aria-label=""Close"">
                                <LucideXCn Size=""16"" Class=""size-3.5"" />
                            </ButtonCn>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class=""px-4 py-12 text-center"">
                <LucideHeartCn Size=""16"" Class=""mx-auto mb-2 size-6 text-muted-foreground/40"" />
                <p class=""text-sm font-medium"">No saved items</p>
                <p class=""mt-1 text-xs text-muted-foreground"">Items you save will appear here</p>
            </div>
        }
    </div>
</section>

@code {
    private class WishlistItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = """";
        public int Price { get; set; }
        public int? OriginalPrice { get; set; }
        public string Size { get; set; } = """";
        public string Stock { get; set; } = """";
    }

    private record StockConfig(string Label, string DotClass);

    private List<WishlistItem> _items = new()
    {
        new() { Id = 1, Name = ""Cashmere Blend Overcoat"", Price = 389, OriginalPrice = null, Size = ""M"", Stock = ""in-stock"" },
        new() { Id = 2, Name = ""Leather Chelsea Boots"", Price = 245, OriginalPrice = 295, Size = ""10"", Stock = ""low-stock"" },
        new() { Id = 3, Name = ""Silk Blend Scarf"", Price = 78, OriginalPrice = null, Size = ""One Size"", Stock = ""in-stock"" },
        new() { Id = 4, Name = ""Linen Blazer"", Price = 275, OriginalPrice = 350, Size = ""L"", Stock = ""out-of-stock"" },
        new() { Id = 5, Name = ""Suede Crossbody Bag"", Price = 165, OriginalPrice = null, Size = ""One Size"", Stock = ""in-stock"" },
        new() { Id = 6, Name = ""Wool Fedora Hat"", Price = 89, OriginalPrice = null, Size = ""S/M"", Stock = ""low-stock"" }
    };

    private static StockConfig GetStockConfig(string stock) => stock switch
    {
        ""in-stock"" => new(""In Stock"", ""bg-emerald-500""),
        ""low-stock"" => new(""Low Stock"", ""bg-amber-500""),
        ""out-of-stock"" => new(""Out of Stock"", ""bg-red-500""),
        _ => new(""Unknown"", ""bg-gray-500"")
    };

    private void RemoveItem(int id)
    {
        _items.RemoveAll(i => i.Id == id);
    }
}";
}
