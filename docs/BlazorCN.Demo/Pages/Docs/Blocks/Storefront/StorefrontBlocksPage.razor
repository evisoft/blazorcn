                            <div class=""rounded-md bg-muted/50 p-3"">
                                <div class=""space-y-2"">
                                    <div class=""flex items-center justify-between"">
                                        <span class=""text-xs text-muted-foreground"">Stock</span>
                                        <span class=""text-xs font-medium tabular-nums"">
                                            @(region.Quantity > 0 ? $""{region.Quantity} units"" : ""Unavailable"")
                                        </span>
                                    </div>
                                    <div class=""flex items-center justify-between"">
                                        <span class=""text-xs text-muted-foreground"">Estimated delivery</span>
                                        <span class=""text-xs font-medium"">@region.Delivery</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(region.NearestAvailable))
                                    {
                                        <div class=""border-t pt-2"">
                                            <p class=""text-xs text-muted-foreground"">
                                                Nearest available: @region.NearestAvailable
                                            </p>
                                        </div>
                                    }
                                </div>
                            </div>
                            @if (region.Status != ""out-of-stock"")
