@code {
    private class NotificationSetting
    {
        public string Id { get; set; } = """";
        public string Label { get; set; } = """";
        public string Description { get; set; } = """";
        public bool Enabled { get; set; }
    }

    private class NotificationSection
    {
        public string Title { get; set; } = """";
        public NotificationSetting[] Settings { get; set; } = [];
    }

    private class ChannelSetting
    {
        public string Id { get; set; } = """";
        public string Label { get; set; } = """";
        public string Description { get; set; } = """";
        public bool Enabled { get; set; }
    }

    private NotificationSection[] _sections =
    {
        new()
        {
            Title = ""Order Updates"",
            Settings = new NotificationSetting[]
            {
                new() { Id = ""order-confirmation"", Label = ""Order confirmation"", Description = ""Receive confirmation when your order is placed"", Enabled = true },
                new() { Id = ""shipping-updates"", Label = ""Shipping updates"", Description = ""Get notified when your order ships and is in transit"", Enabled = true },
                new() { Id = ""delivery-notification"", Label = ""Delivery notification"", Description = ""Know when your package has been delivered"", Enabled = true }
            }
        },
        new()
        {
            Title = ""Marketing"",
            Settings = new NotificationSetting[]
            {
                new() { Id = ""new-arrivals"", Label = ""New arrivals"", Description = ""Be the first to see newly added products"", Enabled = true },
                new() { Id = ""sale-alerts"", Label = ""Sale alerts"", Description = ""Get notified about sales and promotions"", Enabled = false },
                new() { Id = ""back-in-stock"", Label = ""Back in stock"", Description = ""Alerts when wishlisted items are restocked"", Enabled = true }
            }
        }
    };

    private ChannelSetting[] _channels =
    {
        new() { Id = ""email"", Label = ""Email"", Description = ""Receive notifications via email"", Enabled = true },
        new() { Id = ""sms"", Label = ""SMS"", Description = ""Receive notifications via text message"", Enabled = false }
    };

    private void ToggleSetting(int sectionIndex, string settingId)
    {
        var setting = _sections[sectionIndex].Settings.FirstOrDefault(s => s.Id == settingId);
        if (setting != null) setting.Enabled = !setting.Enabled;
    }

    private void ToggleChannel(string channelId)
    {
        var channel = _channels.FirstOrDefault(c => c.Id == channelId);
        if (channel != null) channel.Enabled = !channel.Enabled;
    }

    private void UnsubscribeAll()
    {
        foreach (var section in _sections)
            foreach (var setting in section.Settings)
                setting.Enabled = false;
        foreach (var channel in _channels)
            channel.Enabled = false;
    }
}";

