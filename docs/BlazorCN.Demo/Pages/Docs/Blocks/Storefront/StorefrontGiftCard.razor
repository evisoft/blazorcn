@* ============================================================
   Block: storefront-gift-card
   Title: Storefront Gift Card
   Description: Gift card purchase block with preset amount selector, custom amount input, recipient details, personal message, and delivery method toggle
   Dependencies: ButtonCn, InputCn, LabelCn, LucideGiftCn, LucideMailCn, LucidePrinterCn
   Source: original/blocks/storefront/storefront-gift-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideGiftCn Size="16" Class="size-4 text-muted-foreground" />
                <h1 class="text-sm font-medium">Send a Gift Card</h1>
            </div>
        </div>

        @* Amount Selector *@
        <div class="border-b px-4 py-3">
            <LabelCn Class="mb-2 block text-xs font-medium text-muted-foreground">Select amount</LabelCn>
            <div class="flex flex-wrap gap-2">
                @foreach (var amount in _presetAmounts)
                {
                    <button type="button"
                            class="@Cn.Merge("flex h-8 items-center justify-center rounded-md border px-4 text-xs font-medium transition-colors", !_isCustom && _selectedAmount == amount ? "border-primary text-primary" : "hover:border-foreground/50")"
                            @onclick="() => SelectPreset(amount)">
                        $@amount
                    </button>
                }
            </div>
            <div class="mt-3">
                <LabelCn Class="mb-1 block text-xs text-muted-foreground" For="gc-custom-amount">Custom amount</LabelCn>
                <div class="flex items-center gap-2">
                    <span class="text-xs text-muted-foreground">$</span>
                    <InputCn Class="h-8 w-28 text-xs" id="gc-custom-amount" Type="number" Placeholder="10–500" Value="@_customAmount" ValueChanged="HandleCustomChange" />
                </div>
            </div>
        </div>

        @* Recipient Details *@
        <div class="border-b px-4 py-3">
            <LabelCn Class="mb-2 block text-xs font-medium text-muted-foreground">Recipient details</LabelCn>
            <div class="space-y-2">
                <div>
                    <LabelCn Class="mb-1 block text-xs text-muted-foreground" For="gc-name">Recipient name</LabelCn>
                    <InputCn Class="h-8 text-xs" id="gc-name" Placeholder="Jane Smith" @bind-Value="_recipientName" />
                </div>
                <div>
                    <LabelCn Class="mb-1 block text-xs text-muted-foreground" For="gc-email">Recipient email</LabelCn>
                    <InputCn Class="h-8 text-xs" id="gc-email" Type="email" placeholder="jane@example.com" @bind-Value="_recipientEmail" />
                </div>
            </div>
        </div>

        @* Personal Message *@
        <div class="border-b px-4 py-3">
            <LabelCn Class="mb-1 block text-xs font-medium text-muted-foreground" For="gc-message">Personal message (optional)</LabelCn>
            <TextareaCn Class="resize-none text-xs"
                        id="gc-message"
                        Placeholder="Happy birthday! Hope you find something you love."
                        rows="3"
                        @bind-Value="_message" />
        </div>

        @* Delivery Method *@
        <div class="border-b px-4 py-3">
            <LabelCn Class="mb-2 block text-xs font-medium text-muted-foreground">Delivery method</LabelCn>
            <div class="flex gap-2">
                <button type="button"
                        class="@Cn.Merge("flex h-8 items-center gap-1.5 rounded-md border px-3 text-xs font-medium transition-colors", _deliveryMethod == "email" ? "border-primary text-primary" : "hover:border-foreground/50")"
                        @onclick="SetDeliveryEmail">
                    <LucideMailCn Size="16" Class="size-3" />
                    Email
                </button>
                <button type="button"
                        class="@Cn.Merge("flex h-8 items-center gap-1.5 rounded-md border px-3 text-xs font-medium transition-colors", _deliveryMethod == "print" ? "border-primary text-primary" : "hover:border-foreground/50")"
                        @onclick="SetDeliveryPrint">
                    <LucidePrinterCn Size="16" Class="size-3" />
                    Print at Home
                </button>
            </div>
        </div>

        @* Gift Card Preview *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">Preview</span>
            <div class="rounded-md bg-muted/50 p-4">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs text-muted-foreground">Gift Card</p>
                        <p class="text-2xl font-semibold tabular-nums">
                            $@(DisplayAmount > 0 ? DisplayAmount.ToString() : "\u2014")
                        </p>
                    </div>
                    <LucideGiftCn Size="16" Class="size-6 text-muted-foreground/40" />
                </div>
                @if (!string.IsNullOrEmpty(_recipientName))
                {
                    <p class="mt-2 text-xs text-muted-foreground">To: @_recipientName</p>
                }
                @if (!string.IsNullOrEmpty(_message))
                {
                    <p class="mt-1 text-xs italic text-muted-foreground">
                        &ldquo;@(_message.Length > 80 ? $"{_message[..80]}..." : _message)&rdquo;
                    </p>
                }
            </div>
        </div>

        @* Send Button *@
        <div class="px-4 py-3">
            <ButtonCn Class="h-8 w-full text-xs" Disabled="@(DisplayAmount < 10)" Size="ButtonSize.Sm">
                @(_deliveryMethod == "email" ? "Send" : "Purchase") Gift Card &mdash; $@(DisplayAmount > 0 ? DisplayAmount : 0)
            </ButtonCn>
            <p class="mt-2 text-center text-xs text-muted-foreground">
                @(_deliveryMethod == "email" ? "Delivered instantly to recipient's inbox" : "You'll receive a printable PDF")
            </p>
        </div>
    </div>
</section>

@code {
    private static readonly int[] _presetAmounts = { 25, 50, 100, 200 };

    private int _selectedAmount = 50;
    private string _customAmount = "";
    private bool _isCustom;
    private string _recipientName = "";
    private string _recipientEmail = "";
    private string _message = "";
    private string _deliveryMethod = "email";

    private int DisplayAmount => _isCustom ? (int.TryParse(_customAmount, out var v) ? v : 0) : _selectedAmount;

    private void SelectPreset(int amount)
    {
        _selectedAmount = amount;
        _isCustom = false;
        _customAmount = "";
    }

    private void HandleCustomChange(string value) { _customAmount = value; _isCustom = true; }
    private void SetDeliveryEmail() => _deliveryMethod = "email";
    private void SetDeliveryPrint() => _deliveryMethod = "print";
}
