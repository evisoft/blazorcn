@* ============================================================
   Block: storefront-product-care
   Title: Storefront Product Care
   Description: Care instructions panel with wash, dry, and iron labels, storage tips, and material composition breakdown with percentages for apparel and textile products
   Dependencies: ButtonCn, LucideCheckCn, LucideCopyCn, LucideDropletCn, LucideFlame Cn, LucideSunCn, LucideThermometerCn, LucideWindCn
   Source: original/blocks/storefront/storefront-product-care.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="text-sm font-medium">@ProductName</h2>
                <p class="text-xs text-muted-foreground">Care Instructions</p>
            </div>
            <ButtonCn Class="h-6 gap-1 px-2 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="CopyAllInstructions">
                @if (_copied)
                {
                    <LucideCheckCn Size="16" Class="size-3" />
                    <text>Copied</text>
                }
                else
                {
                    <LucideCopyCn Size="16" Class="size-3" />
                    <text>Copy</text>
                }
            </ButtonCn>
        </div>

        @* Care Instructions *@
        @foreach (var care in _careInstructions)
        {
            var isExpanded = _expanded == care.Id;
            <div class="border-b">
                <button class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                        type="button"
                        @onclick="() => _expanded = isExpanded ? null : care.Id">
                    @switch (care.Category)
                    {
                        case "Washing":
                            <LucideDropletCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            break;
                        case "Drying":
                            <LucideWindCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            break;
                        case "Ironing":
                            <LucideThermometerCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            break;
                        case "Bleaching":
                            <LucideFlameCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            break;
                        default:
                            <LucideSunCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            break;
                    }
                    <div class="min-w-0 flex-1">
                        <span class="text-xs font-medium text-muted-foreground">@care.Category</span>
                        <p class="text-sm font-medium">@care.Instruction</p>
                    </div>
                </button>

                @if (isExpanded)
                {
                    <div class="px-4 pb-3 pl-11">
                        <p class="text-xs leading-relaxed text-muted-foreground">@care.Detail</p>
                    </div>
                }
            </div>
        }

        @* Material Composition *@
        <div class="border-b px-4 py-3">
            <span class="mb-3 block text-xs font-medium text-muted-foreground">
                Material Composition
            </span>
            <div class="space-y-3">
                @foreach (var material in _materials)
                {
                    <div>
                        <div class="mb-1 flex items-center justify-between">
                            <span class="text-sm font-medium">@material.Name</span>
                            <span class="font-mono text-xs tabular-nums text-muted-foreground">
                                @material.Percentage%
                            </span>
                        </div>
                        <div class="mb-1 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground/20" style="width: @(material.Percentage)%"></div>
                        </div>
                        <p class="text-xs text-muted-foreground">@material.Properties</p>
                    </div>
                }
            </div>
        </div>

        @* Storage Tips *@
        <div class="px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">Storage Tips</span>
            <div class="flex flex-col gap-2">
                @foreach (var tip in _storageTips)
                {
                    <div class="flex items-start gap-2">
                        <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                        <span class="text-sm">@tip</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record CareInstruction(string Id, string Category, string Instruction, string Detail);
    private record MaterialInfo(string Name, int Percentage, string Properties);

    private const string ProductName = "Cashmere Blend Overcoat";

    private static readonly CareInstruction[] _careInstructions =
    {
        new("wash", "Washing", "Dry clean only", "Professional dry cleaning recommended. Do not machine wash or hand wash."),
        new("dry", "Drying", "Do not tumble dry", "If spot cleaned, lay flat on a clean towel and reshape while damp."),
        new("iron", "Ironing", "Low heat, with cloth", "Use a pressing cloth between iron and fabric. Steam on low setting preferred."),
        new("bleach", "Bleaching", "Do not bleach", "No chlorine or oxygen-based bleach. For stains, consult a professional cleaner.")
    };

    private static readonly MaterialInfo[] _materials =
    {
        new("Cashmere", 60, "Ultra-soft hand feel, natural insulation"),
        new("Merino Wool", 30, "Temperature regulation, moisture wicking"),
        new("Silk", 10, "Lustrous sheen, smooth drape")
    };

    private static readonly string[] _storageTips =
    {
        "Hang on a wide, padded hanger to maintain shoulder shape",
        "Store in a breathable garment bag away from direct sunlight",
        "Use cedar blocks nearby to deter moths naturally",
        "Allow 24 hours between wears for fibers to recover"
    };

    private string? _expanded;
    private bool _copied;

    private async Task CopyAllInstructions()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
