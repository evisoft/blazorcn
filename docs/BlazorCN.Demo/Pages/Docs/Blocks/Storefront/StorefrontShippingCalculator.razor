@* ============================================================
   Block: storefront-shipping-calculator
   Title: Storefront Shipping Calculator
   Description: Storefront shipping rate estimator with country and zip input, method selection, and free shipping progress bar
   Long Description: Seasonal sale component with featured deals, copyable promo code, category links, and sale stats
   Dependencies: ButtonCn, InputCn, LabelCn, LucidePackageCn, LucideTruckCn, ProgressCn, RadioGroupCn, RadioGroupItemCn
   Source: original/blocks/storefront/storefront-shipping-calculator.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideTruckCn Size="16" Class="size-4 text-muted-foreground" />
                    <h2 class="text-sm font-medium">Shipping Estimator</h2>
                </div>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Calculate shipping costs for your order
                </p>
            </div>

            @* Destination Input *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-3">
                    <div class="flex-1">
                        <LabelCn Class="mb-1.5 block text-xs font-medium text-muted-foreground">
                            Country
                        </LabelCn>
                        <select
                            class="h-8 w-full rounded-md border bg-transparent px-2 text-sm focus:outline-none focus:ring-1 focus:ring-ring"
                            @bind="_country">
                            <option value="US">United States</option>
                            <option value="CA">Canada</option>
                            <option value="GB">United Kingdom</option>
                            <option value="DE">Germany</option>
                            <option value="AU">Australia</option>
                        </select>
                    </div>
                    <div class="w-32">
                        <LabelCn Class="mb-1.5 block text-xs font-medium text-muted-foreground">
                            ZIP / Postal Code
                        </LabelCn>
                        <InputCn
                            Class="h-8 text-sm"
                            Placeholder="97201"
                            @bind-Value="_zip" />
                    </div>
                    <div class="flex items-end">
                        <ButtonCn Class="h-8 px-3 text-xs" Variant="ButtonVariant.Outline">
                            Calculate
                        </ButtonCn>
                    </div>
                </div>
            </div>

            @* Shipping Methods *@
            <div class="border-b px-4 py-3">
                <p class="mb-2 text-xs font-medium text-muted-foreground">Shipping Method</p>
                <RadioGroupCn
                    Class="space-y-0"
                    @bind-Value="_selectedMethod">
                    @foreach (var method in _shippingMethods)
                    {
                        <label
                            class="@(Cn.Merge("flex cursor-pointer items-center gap-3 rounded-md px-3 py-2.5 transition-colors hover:bg-muted/50", _selectedMethod == method.Id ? "bg-muted/50" : ""))"
                            for="@($"shipping-{method.Id}")">
                            <RadioGroupItemCn Id="@($"shipping-{method.Id}")" Value="@method.Id" />
                            <div class="min-w-0 flex-1">
                                <p class="text-sm font-medium">@method.Name</p>
                                <p class="text-xs text-muted-foreground">@method.Description</p>
                            </div>
                            <div class="shrink-0 text-right">
                                <p class="text-sm font-medium tabular-nums">
                                    @if (QualifiesForFreeShipping && method.Id == "standard")
                                    {
                                        <span class="text-emerald-600">Free</span>
                                    }
                                    else
                                    {
                                        @($"${method.Price.ToString("F2")}")
                                    }
                                </p>
                                <p class="text-xs text-muted-foreground">@method.Estimate</p>
                            </div>
                        </label>
                    }
                </RadioGroupCn>
            </div>

            @* Cart Info *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucidePackageCn Size="14" Class="size-3.5 text-muted-foreground" />
                    <p class="text-xs font-medium text-muted-foreground">Package Details</p>
                </div>
                <div class="mt-1 flex items-center gap-3 text-xs text-muted-foreground">
                    <span>@CartItemCount items</span>
                    <span class="size-0.5 rounded-full bg-muted-foreground/40"></span>
                    <span>@CartWeight</span>
                    <span class="size-0.5 rounded-full bg-muted-foreground/40"></span>
                    <span>@CartDimensions</span>
                </div>
            </div>

            @* Free Shipping Progress *@
            <div class="border-b px-4 py-3">
                @if (QualifiesForFreeShipping)
                {
                    <div class="flex items-center gap-2">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <p class="text-xs text-emerald-600">You qualify for free standard shipping</p>
                    </div>
                }
                else
                {
                    <div class="mb-1.5 flex items-center justify-between">
                        <p class="text-xs text-muted-foreground">
                            Add $@AmountToFreeShipping for free standard shipping
                        </p>
                        <span class="text-xs tabular-nums text-muted-foreground">
                            $@CartSubtotal / $@FreeShippingThreshold
                        </span>
                    </div>
                    <ProgressCn Class="h-1.5" Value="@FreeShippingProgress" />
                }
            </div>

            @* Summary *@
            <div class="px-4 py-3">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs text-muted-foreground">
                            @(SelectedShipping?.Name) &middot; @(SelectedShipping?.Estimate)
                        </p>
                    </div>
                    <span class="text-2xl font-semibold tabular-nums">
                        @if (QualifiesForFreeShipping && _selectedMethod == "standard")
                        {
                            <span class="text-emerald-600">Free</span>
                        }
                        else
                        {
                            @($"${SelectedShipping?.Price.ToString("F2")}")
                        }
                    </span>
                </div>
            </div>
        </div>
    </section>
</section>

@code {
    private string? _selectedMethod = "standard";
    private string _zip = "";
    private string _country = "US";

    private const int CartSubtotal = 243;
    private const string CartWeight = "2.4 kg";
    private const string CartDimensions = "38 \u00d7 28 \u00d7 15 cm";
    private const int CartItemCount = 3;
    private const int FreeShippingThreshold = 300;

    private record ShippingMethod(string Id, string Name, string Estimate, decimal Price, string Description);

    private static readonly ShippingMethod[] _shippingMethods =
    [
        new("standard", "Standard Shipping", "5\u20137 business days", 5.99m, "Ground delivery via USPS"),
        new("express", "Express Shipping", "2\u20133 business days", 12.99m, "Priority delivery via UPS"),
        new("overnight", "Overnight Shipping", "Next business day", 24.99m, "Express air delivery via FedEx")
    ];

    private ShippingMethod? SelectedShipping => _shippingMethods.FirstOrDefault(m => m.Id == _selectedMethod);

    private double FreeShippingProgress => Math.Min(100, Math.Round((double)CartSubtotal / FreeShippingThreshold * 100));
    private int AmountToFreeShipping => FreeShippingThreshold - CartSubtotal;
    private bool QualifiesForFreeShipping => CartSubtotal >= FreeShippingThreshold;
}
