@* ============================================================
   Block: storefront-price-match
   Title: Storefront Price Match
   Description: Price match guarantee form with competitor URL input, screenshot upload, current vs competitor price comparison, policy terms, and claim submission
   Dependencies: ButtonCn, InputCn, LabelCn, LucideCheckCn, LucideImagePlusCn, LucideShieldCheckCn, LucideUploadCn, LucideXCn
   Source: original/blocks/storefront/storefront-price-match.tsx
   ============================================================ *@

@if (_submitted)
{
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="px-4 py-8 text-center">
                <div class="mx-auto mb-3 flex size-10 items-center justify-center rounded-full bg-emerald-500/10">
                    <LucideCheckCn Size="16" Class="size-5 text-emerald-600" />
                </div>
                <p class="text-sm font-medium">Price Match Claim Submitted</p>
                <p class="mt-1 text-xs text-muted-foreground">
                    We'll review your claim within 24-48 hours and notify you by email.
                </p>
                <p class="mt-0.5 text-xs text-muted-foreground">Reference: PM-20260316-4829</p>
                <ButtonCn Class="mt-4 h-7 px-3 text-xs" Variant="ButtonVariant.Outline" @onclick="() => _submitted = false">
                    Submit Another Claim
                </ButtonCn>
            </div>
        </div>
    </section>
}
else
{
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideShieldCheckCn Size="16" Class="size-4 text-muted-foreground" />
                    <h2 class="text-sm font-medium">Price Match Guarantee</h2>
                </div>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Found a lower price? We'll match it.
                </p>
            </div>

            @* Product Info *@
            <div class="border-b px-4 py-3">
                <p class="text-xs font-medium text-muted-foreground">Your Product</p>
                <div class="mt-1 flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium">@ProductName</p>
                        <p class="mt-0.5 font-mono text-xs text-muted-foreground">@ProductSku</p>
                    </div>
                    <span class="text-sm font-semibold tabular-nums">$@ProductPrice.ToString("F2")</span>
                </div>
            </div>

            @* Competitor URL *@
            <div class="border-b px-4 py-3">
                <LabelCn Class="mb-1.5 block text-xs font-medium text-muted-foreground">
                    Competitor Product URL
                </LabelCn>
                <InputCn Class="h-8 text-sm" Placeholder="https://competitor.com/product/..." @bind-Value="_competitorUrl" />
            </div>

            @* Competitor Price *@
            <div class="border-b px-4 py-3">
                <LabelCn Class="mb-1.5 block text-xs font-medium text-muted-foreground">
                    Competitor Price
                </LabelCn>
                <div class="flex items-center gap-2">
                    <span class="text-sm text-muted-foreground">$</span>
                    <InputCn Class="h-8 w-32 text-sm tabular-nums" Type="number" Placeholder="0.00" @bind-Value="_competitorPrice" />
                </div>
            </div>

            @* Price Comparison *@
            @if (HasValidPrice)
            {
                <div class="border-b px-4 py-3">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">Price Comparison</p>
                    <div class="space-y-1.5">
                        <div class="flex items-center justify-between">
                            <span class="text-xs text-muted-foreground">Our price</span>
                            <span class="text-xs tabular-nums">$@ProductPrice.ToString("F2")</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-xs text-muted-foreground">Competitor price</span>
                            <span class="text-xs tabular-nums">$@ParsedPrice.ToString("F2")</span>
                        </div>
                        <div class="flex items-center justify-between border-t pt-1.5">
                            <span class="text-xs font-medium">
                                @(IsEligible ? "You save" : "Difference")
                            </span>
                            <span class="@Cn.Merge("text-sm font-semibold tabular-nums", IsEligible ? "text-emerald-600 dark:text-emerald-400" : "text-muted-foreground")">
                                @(IsEligible ? $"-${PriceDifference:F2}" : $"+${Math.Abs(PriceDifference):F2}")
                            </span>
                        </div>
                    </div>
                    @if (!IsEligible)
                    {
                        <div class="mt-2 flex items-center gap-1.5">
                            <LucideXCn Size="16" Class="size-3 text-red-500" />
                            <span class="text-xs text-red-600 dark:text-red-400">
                                Competitor price must be lower than our current price
                            </span>
                        </div>
                    }
                </div>
            }

            @* Screenshot Upload *@
            <div class="border-b px-4 py-3">
                <LabelCn Class="mb-1.5 block text-xs font-medium text-muted-foreground">
                    Screenshot Proof (optional)
                </LabelCn>
                @if (!string.IsNullOrEmpty(_fileName))
                {
                    <div class="flex items-center gap-2 rounded-md bg-muted/50 px-3 py-2">
                        <LucideImagePlusCn Size="16" Class="size-3.5 text-muted-foreground" />
                        <span class="flex-1 truncate text-xs">@_fileName</span>
                        <ButtonCn Class="h-5 px-1.5 text-xs" Variant="ButtonVariant.Ghost" @onclick="() => _fileName = string.Empty">
                            <LucideXCn Size="16" Class="size-3" />
                        </ButtonCn>
                    </div>
                }
                else
                {
                    <label class="flex cursor-pointer items-center justify-center gap-2 rounded-md border border-dashed px-3 py-4 text-xs text-muted-foreground transition-colors hover:bg-muted/50">
                        <LucideUploadCn Size="16" Class="size-3.5" />
                        Upload screenshot of competitor price
                        <input accept="image/*" class="hidden" type="file" @onchange="HandleFileChange" />
                    </label>
                }
            </div>

            @* Additional Notes *@
            <div class="border-b px-4 py-3">
                <LabelCn Class="mb-1.5 block text-xs font-medium text-muted-foreground">
                    Additional Notes (optional)
                </LabelCn>
                <textarea class="w-full min-h-[60px] resize-none rounded-md border bg-transparent px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                          placeholder="Any details about the competitor listing..."
                          @bind="_notes"></textarea>
            </div>

            @* Policy Terms *@
            <div class="border-b px-4 py-3">
                <p class="mb-2 text-xs font-medium text-muted-foreground">Eligibility Requirements</p>
                <div class="space-y-1.5">
                    @foreach (var rule in _policyRules)
                    {
                        <div class="flex items-start gap-2">
                            <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-muted-foreground/40"></span>
                            <span class="text-xs text-muted-foreground">@rule</span>
                        </div>
                    }
                </div>
            </div>

            @* Submit *@
            <div class="px-4 py-3">
                <ButtonCn Class="h-8 w-full text-xs" Size="ButtonSize.Sm" Disabled="@(string.IsNullOrWhiteSpace(_competitorUrl) || !IsEligible)" @onclick="() => _submitted = true">
                    Submit Price Match Claim
                </ButtonCn>
                <p class="mt-2 text-center text-[10px] text-muted-foreground">
                    Claims are reviewed within 24-48 hours
                </p>
            </div>
        </div>
    </section>
}

@code {
    private const string ProductName = "Sony WH-1000XM5 Wireless Headphones";
    private const string ProductSku = "SNY-WH1000XM5-BLK";
    private const decimal ProductPrice = 349.99m;

    private static readonly string[] _policyRules =
    {
        "Competitor must be an authorized retailer",
        "Item must be identical (same SKU, color, size)",
        "Competitor must have item in stock at time of claim",
        "Excludes clearance, membership, or coupon-stacked pricing",
        "Price match valid within 14 days of purchase"
    };

    private string _competitorUrl = "";
    private string _competitorPrice = "";
    private string _fileName = "";
    private string _notes = "";
    private bool _submitted;

    private decimal ParsedPrice => decimal.TryParse(_competitorPrice, out var v) ? v : 0m;
    private bool HasValidPrice => ParsedPrice > 0;
    private decimal PriceDifference => ProductPrice - ParsedPrice;
    private bool IsEligible => HasValidPrice && ParsedPrice < ProductPrice;

    private void HandleFileChange(ChangeEventArgs e)
    {
        _fileName = "screenshot.png";
    }
}
