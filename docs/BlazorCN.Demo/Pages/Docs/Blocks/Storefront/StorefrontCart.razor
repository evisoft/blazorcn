@* ============================================================
   Block: storefront-cart
   Title: Storefront Cart
   Description: Shopping cart block with line items, quantity controls, promo code input, order summary, and checkout action
   Long Description: A polished shopping cart block that drives checkout completion. Features editable cart items in flat rows with product thumbnails, size and color details, quantity increment and decrement controls, and per-item removal. The order summary section displays subtotal, shipping, estimated tax, and total with a prominent checkout button. Includes a promo code input for discount application. Built with the Vercel minimal aesthetic using flat sections divided by borders.
   Dependencies: ButtonCn, InputCn, LucideMinusCn, LucidePackageCn, LucidePlusCn, LucideShoppingBagCn, LucideXCn
   Source: original/blocks/storefront/storefront-cart.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideShoppingBagCn Size="16" Class="size-4 text-muted-foreground" />
                    <h1 class="text-sm font-medium">
                        Your Cart (@_items.Sum(i => i.Quantity) items)
                    </h1>
                </div>
            </div>

            @* Cart Items *@
            @if (_items.Count > 0)
            {
                <div>
                    @for (var i = 0; i < _items.Count; i++)
                    {
                        var item = _items[i];
                        var isLast = i == _items.Count - 1;
                        <div class="@(Cn.Merge("flex items-start gap-3 px-4 py-3", !isLast ? "border-b" : ""))">
                            @* Product Image *@
                            <div class="flex size-16 shrink-0 items-center justify-center rounded-md bg-muted/50">
                                <LucidePackageCn Size="16" Class="size-5 text-muted-foreground/60" />
                            </div>

                            @* Product Info *@
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium">@item.Name</span>
                                <p class="mt-0.5 text-xs text-muted-foreground">
                                    @item.Color &middot; @item.Size
                                </p>
                                <div class="mt-2 flex items-center gap-2">
                                    <ButtonCn
                                        Class="size-6"
                                        Disabled="@(item.Quantity <= 1)"
                                        @onclick="@(() => UpdateQuantity(item.Id, -1))"
                                        Size="ButtonSize.Icon"
                                        Variant="ButtonVariant.Outline">
                                        <LucideMinusCn Size="16" Class="size-3" />
                                    </ButtonCn>
                                    <span class="w-5 text-center text-xs font-medium tabular-nums">
                                        @item.Quantity
                                    </span>
                                    <ButtonCn
                                        Class="size-6"
                                        Disabled="@(item.Quantity >= 10)"
                                        @onclick="@(() => UpdateQuantity(item.Id, 1))"
                                        Size="ButtonSize.Icon"
                                        Variant="ButtonVariant.Outline">
                                        <LucidePlusCn Size="16" Class="size-3" />
                                    </ButtonCn>
                                </div>
                            </div>

                            @* Price + Remove *@
                            <div class="flex flex-col items-end gap-1">
                                <span class="text-sm font-medium tabular-nums">
                                    $@(item.Price * item.Quantity)
                                </span>
                                <ButtonCn
                                    Class="size-6 text-muted-foreground"
                                    @onclick="@(() => RemoveItem(item.Id))"
                                    Size="ButtonSize.Icon"
                                    Variant="ButtonVariant.Ghost">
                                    <LucideXCn Size="16" Class="size-3" />
                                </ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="px-4 py-8 text-center">
                    <p class="text-sm text-muted-foreground">Your cart is empty</p>
                </div>
            }

            @* Promo Code *@
            @if (_items.Count > 0)
            {
                <div class="border-t px-4 py-3">
                    <div class="flex gap-2">
                        <InputCn
                            Class="h-8 text-xs"
                            placeholder="Promo code"
                            Value="@_promoCode" />
                        <ButtonCn Class="h-8 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                            Apply
                        </ButtonCn>
                    </div>
                </div>

                @* Order Summary *@
                <div class="border-t px-4 py-3">
                    <div class="space-y-1.5">
                        <div class="flex items-center justify-between">
                            <span class="text-xs text-muted-foreground">Subtotal</span>
                            <span class="text-xs tabular-nums">$@Subtotal</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-xs text-muted-foreground">Shipping</span>
                            <span class="text-xs tabular-nums">
                                @(Shipping == 0 ? "Free" : $"${Shipping}")
                            </span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-xs text-muted-foreground">Estimated tax</span>
                            <span class="text-xs tabular-nums">$@Tax</span>
                        </div>
                        <div class="flex items-center justify-between border-t pt-2">
                            <span class="text-sm font-medium">Total</span>
                            <span class="font-semibold text-2xl tabular-nums">$@Total</span>
                        </div>
                    </div>
                </div>

                @* Checkout *@
                <div class="border-t px-4 py-3">
                    <ButtonCn Class="h-8 w-full text-xs" Size="ButtonSize.Sm">
                        Proceed to Checkout
                    </ButtonCn>
                    <p class="mt-2 text-center text-[10px] text-muted-foreground">
                        Free shipping on orders over $100
                    </p>
                </div>
            }
        </div>
    </section>
</section>

@code {
    private string _promoCode = "";

    private record CartItem(int Id, string Name, int Price, string Size, string Color, int Quantity);

    private List<CartItem> _items =
    [
        new(1, "Merino Wool Crewneck Sweater", 145, "M", "Black", 1),
        new(2, "Slim Fit Chino Pants", 89, "32", "Khaki", 2),
        new(3, "Canvas Tote Bag", 65, "One Size", "Natural", 1)
    ];

    private int Subtotal => _items.Sum(i => i.Price * i.Quantity);
    private int Shipping => Subtotal >= 100 ? 0 : 12;
    private int Tax => (int)Math.Round(Subtotal * 0.08);
    private int Total => Subtotal + Shipping + Tax;

    private void UpdateQuantity(int id, int delta)
    {
        var index = _items.FindIndex(i => i.Id == id);
        if (index >= 0)
        {
            var item = _items[index];
            var newQty = Math.Max(1, Math.Min(10, item.Quantity + delta));
            _items[index] = item with { Quantity = newQty };
        }
    }

    private void RemoveItem(int id)
    {
        _items.RemoveAll(i => i.Id == id);
    }
}
