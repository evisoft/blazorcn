@* ============================================================
   Block: storefront-pick-up-in-store
   Title: Storefront Pick Up In Store
   Description: Buy online pick up in store (BOPIS) flow with store selector, pickup time slots, item availability per location, and pickup instructions
   Dependencies: ButtonCn, LucideCheckCn, LucideClockCn, LucideMapPinCn, LucidePackageCn
   Source: original/blocks/storefront/storefront-pick-up-in-store.tsx
   ============================================================ *@

@if (_confirmed && SelectedStoreData != null)
{
    var slot = _timeSlots.FirstOrDefault(s => s.Id == _selectedSlot);
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideCheckCn Size="16" Class="size-4 text-emerald-500" />
                    <span class="text-sm font-medium">Pickup Order Confirmed</span>
                </div>
                <p class="mt-0.5 text-xs text-muted-foreground">Order PKP-2026-7341</p>
            </div>
            <div class="border-b px-4 py-3">
                <div class="rounded-md bg-muted/50 p-3">
                    <p class="text-sm font-medium">@SelectedStoreData.Name</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@SelectedStoreData.Address</p>
                    <p class="mt-2 text-xs text-muted-foreground">
                        @slot?.Date &middot; @slot?.Label
                    </p>
                </div>
            </div>
            <div class="border-b px-4 py-3">
                <p class="mb-2 text-xs font-medium text-muted-foreground">Pickup instructions</p>
                <ul class="space-y-1.5 text-sm">
                    <li class="flex items-start gap-2">
                        <span class="mt-1.5 size-1 shrink-0 rounded-full bg-foreground"></span>
                        Bring a valid photo ID matching the order name
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1.5 size-1 shrink-0 rounded-full bg-foreground"></span>
                        Check in at the pickup counter on the ground floor
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1.5 size-1 shrink-0 rounded-full bg-foreground"></span>
                        Order held for 72 hours after the pickup window
                    </li>
                </ul>
            </div>
            <div class="flex items-center justify-between px-4 py-3">
                <span class="text-xs text-muted-foreground">@_items.Length items</span>
                <span class="text-2xl font-semibold tabular-nums">$@Total</span>
            </div>
        </div>
    </section>
}
else
{
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucidePackageCn Size="16" Class="size-4 text-muted-foreground" />
                    <h2 class="text-sm font-medium">Pick Up in Store</h2>
                </div>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Select a store and pickup time for your order
                </p>
            </div>

            @* Store Selection *@
            <div class="border-b px-4 py-3">
                <p class="mb-2 text-xs font-medium text-muted-foreground">Choose a store</p>
                <div class="space-y-1.5">
                    @foreach (var store in _stores)
                    {
                        var isSelected = _selectedStore == store.Id;
                        var itemsAvailable = _items.Count(item => GetAvailability(item, store.Id) != "out-of-stock");
                        <button class="@Cn.Merge("flex w-full items-start gap-3 rounded-md border px-3 py-2.5 text-left transition-colors", isSelected ? "border-primary bg-muted/50" : "hover:bg-muted/50")"
                                type="button"
                                @onclick="() => SelectStore(store.Id)">
                            <LucideMapPinCn Size="16" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@store.Name</span>
                                    <span class="text-xs text-muted-foreground">@store.Distance</span>
                                </div>
                                <p class="mt-0.5 text-xs text-muted-foreground">@store.Address</p>
                                <p class="mt-0.5 text-xs text-muted-foreground">
                                    @store.Hours &middot; @itemsAvailable/@_items.Length items available
                                </p>
                            </div>
                        </button>
                    }
                </div>
            </div>

            @* Item Availability *@
            @if (_selectedStore != null)
            {
                <div class="border-b">
                    <div class="border-b px-4 py-2">
                        <span class="text-xs font-medium text-muted-foreground">
                            Item availability at @SelectedStoreData?.Name
                        </span>
                    </div>
                    @for (var i = 0; i < _items.Length; i++)
                    {
                        var item = _items[i];
                        var status = GetAvailability(item, _selectedStore.Value);
                        var isLast = i == _items.Length - 1;
                        <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", !isLast ? "border-b" : "", status == "out-of-stock" ? "opacity-50" : "")">
                            <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                                <LucidePackageCn Size="16" Class="size-3.5 text-muted-foreground/60" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-sm font-medium">@item.Name</p>
                                <p class="text-xs text-muted-foreground">@item.Variant</p>
                            </div>
                            <div class="flex shrink-0 items-center gap-1.5">
                                <span class="@Cn.Merge("size-1.5 rounded-full", GetStockDot(status))" />
                                <span class="text-xs text-muted-foreground">@GetStockLabel(status)</span>
                            </div>
                        </div>
                    }
                </div>
            }

            @* Time Slot Selection *@
            @if (_selectedStore != null && AllAvailable)
            {
                <div class="border-b px-4 py-3">
                    <div class="mb-2 flex items-center gap-1.5">
                        <LucideClockCn Size="16" Class="size-3 text-muted-foreground" />
                        <p class="text-xs font-medium text-muted-foreground">Select pickup time</p>
                    </div>
                    <div class="grid grid-cols-2 gap-1.5 sm:grid-cols-3">
                        @foreach (var slot in _timeSlots)
                        {
                            <button class="@Cn.Merge("rounded-md border px-2.5 py-2 text-left transition-colors", !slot.Available ? "cursor-not-allowed opacity-40" : "", _selectedSlot == slot.Id ? "border-primary bg-muted/50" : slot.Available ? "hover:bg-muted/50" : "")"
                                    disabled="@(!slot.Available)"
                                    type="button"
                                    @onclick="() => _selectedSlot = slot.Id">
                                <p class="text-xs font-medium">@slot.Label</p>
                                <p class="text-[10px] text-muted-foreground">@slot.Date</p>
                            </button>
                        }
                    </div>
                </div>
            }

            @* Summary & Confirm *@
            <div class="px-4 py-3">
                <div class="mb-3 flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">
                        @_items.Length items &middot; Pickup is free
                    </span>
                    <span class="text-2xl font-semibold tabular-nums">$@Total</span>
                </div>
                <ButtonCn Class="w-full text-xs" Disabled="@(!CanConfirm)" Variant="ButtonVariant.Outline" @onclick="() => _confirmed = true">
                    Confirm Pickup Order
                </ButtonCn>
            </div>
        </div>
    </section>
}

@code {
    private record StoreInfo(int Id, string Name, string Address, string Distance, string Hours);
    private record TimeSlotInfo(string Id, string Label, string Date, bool Available);
    private record PickupItem(int Id, string Name, string Variant, int Price, Dictionary<int, string> StoreAvailability);

    private static readonly StoreInfo[] _stores =
    {
        new(1, "Downtown Flagship", "123 Main St, New York, NY 10001", "0.3 mi", "10am - 9pm"),
        new(2, "SoHo", "456 Broadway, New York, NY 10012", "0.8 mi", "10am - 8pm"),
        new(3, "Brooklyn Heights", "321 Atlantic Ave, Brooklyn, NY 11201", "3.5 mi", "11am - 8pm")
    };

    private static readonly PickupItem[] _items =
    {
        new(1, "Merino Wool Crewneck", "Charcoal / M", 145, new() { { 1, "in-stock" }, { 2, "low-stock" }, { 3, "in-stock" } }),
        new(2, "Canvas Low-Top Sneakers", "White / 10", 98, new() { { 1, "in-stock" }, { 2, "in-stock" }, { 3, "out-of-stock" } })
    };

    private static readonly TimeSlotInfo[] _timeSlots =
    {
        new("t1", "12:00 - 2:00 PM", "Today", true),
        new("t2", "2:00 - 4:00 PM", "Today", true),
        new("t3", "4:00 - 6:00 PM", "Today", false),
        new("t4", "10:00 AM - 12:00 PM", "Tomorrow", true),
        new("t5", "12:00 - 2:00 PM", "Tomorrow", true)
    };

    private int? _selectedStore;
    private string? _selectedSlot;
    private bool _confirmed;

    private StoreInfo? SelectedStoreData => _stores.FirstOrDefault(s => s.Id == _selectedStore);
    private int Total => _items.Sum(i => i.Price);

    private bool AllAvailable => _selectedStore != null &&
        _items.All(item => GetAvailability(item, _selectedStore.Value) != "out-of-stock");

    private bool CanConfirm => _selectedStore != null && _selectedSlot != null && AllAvailable;

    private static string GetAvailability(PickupItem item, int storeId) =>
        item.StoreAvailability.TryGetValue(storeId, out var status) ? status : "out-of-stock";

    private static string GetStockDot(string status) => status switch
    {
        "in-stock" => "bg-emerald-500",
        "low-stock" => "bg-amber-500",
        _ => "bg-red-500"
    };

    private static string GetStockLabel(string status) => status switch
    {
        "in-stock" => "In stock",
        "low-stock" => "Low stock",
        _ => "Unavailable"
    };

    private void SelectStore(int storeId)
    {
        _selectedStore = storeId;
        _selectedSlot = null;
    }
}
