@* ============================================================
   Block: storefront-quick-view
   Title: Storefront Quick View
   Description: Storefront product list with quick view modal for browsing details, selecting variants, and adding to cart
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogHeaderCn, DialogTitleCn, LabelCn, LucideCheckCn, LucideEyeCn, LucideImageCn, LucideLoader2Cn, LucideMinusCn, LucidePackageCn, LucidePlusCn, LucideShoppingBagCn, RadioGroupCn, RadioGroupItemCn
   Source: original/blocks/storefront/storefront-quick-view.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Most Popular</p>
            <p class="text-xs text-muted-foreground">Trending items this week</p>
        </div>

        <div>
            @for (var i = 0; i < _products.Length; i++)
            {
                var product = _products[i];
                var isLast = i == _products.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-4 px-4 py-3", !isLast ? "border-b" : "")">
                    <div class="flex size-16 shrink-0 items-center justify-center rounded-md border bg-muted/50">
                        <LucidePackageCn Size="16" Class="size-5 text-muted-foreground/60" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@product.Name</p>
                        <p class="text-xs text-muted-foreground">
                            @product.Category &middot; @product.Rating (@product.Reviews)
                        </p>
                    </div>
                    <span class="shrink-0 text-sm font-medium tabular-nums">$@product.Price</span>
                    <ButtonCn Class="h-7 shrink-0 gap-1 px-2 text-xs"
                              Variant="ButtonVariant.Ghost"
                              @onclick="@(() => OpenQuickView(product))">
                        <LucideEyeCn Size="16" Class="size-3" />
                        Quick View
                    </ButtonCn>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3 text-center">
            <a class="text-xs text-muted-foreground hover:text-foreground" href="#">
                View all products
            </a>
        </div>
    </div>

    <DialogCn Open="@(_selectedProduct != null)" OpenChanged="OnDialogOpenChanged">
        <DialogContentCn Class="max-w-3xl p-0">
            @if (_selectedProduct != null)
            {
                <div class="grid md:grid-cols-2">
                    <div class="flex aspect-square items-center justify-center bg-muted/50 md:rounded-l-lg">
                        <LucideImageCn Size="16" Class="size-8 text-muted-foreground/60" />
                    </div>

                    <div class="flex flex-col">
                        <div class="border-b px-4 py-3">
                            <DialogHeaderCn Class="text-left">
                                <p class="text-xs text-muted-foreground">@_selectedProduct.Category</p>
                                <DialogTitleCn Class="text-sm font-medium">
                                    @_selectedProduct.Name
                                </DialogTitleCn>
                            </DialogHeaderCn>
                            <p class="mt-1 text-xs text-muted-foreground">
                                @_selectedProduct.Rating (@_selectedProduct.Reviews reviews)
                            </p>
                        </div>

                        <div class="border-b px-4 py-3">
                            <span class="text-2xl font-semibold tabular-nums">
                                $@_selectedProduct.Price
                            </span>
                        </div>

                        <div class="border-b px-4 py-3">
                            <p class="text-xs text-muted-foreground">@_selectedProduct.Description</p>
                        </div>

                        <div class="border-b px-4 py-3">
                            <LabelCn Class="mb-2 block text-xs font-medium text-muted-foreground">
                                Size
                            </LabelCn>
                            <RadioGroupCn Value="@_selectedSize" ValueChanged="@(v => _selectedSize = v)" Class="flex flex-wrap gap-2">
                                @foreach (var size in _selectedProduct.Sizes)
                                {
                                    <div>
                                        <RadioGroupItemCn Class="peer sr-only" Id="@($"quick-view-size-{size}")" Value="@size" />
                                        <LabelCn For="@($"quick-view-size-{size}")"
                                                 Class="flex h-8 min-w-[2.5rem] cursor-pointer items-center justify-center rounded-md border px-2 text-xs font-medium transition-colors peer-data-[state=checked]:border-primary peer-data-[state=checked]:text-primary hover:border-foreground/50">
                                            @size
                                        </LabelCn>
                                    </div>
                                }
                            </RadioGroupCn>
                        </div>

                        <div class="border-b px-4 py-3">
                            <LabelCn Class="mb-2 block text-xs font-medium text-muted-foreground">
                                Quantity
                            </LabelCn>
                            <div class="flex items-center gap-2">
                                <ButtonCn Class="size-7"
                                          Disabled="@(_quantity <= 1)"
                                          Size="ButtonSize.Icon"
                                          Variant="ButtonVariant.Outline"
                                          @onclick="DecrementQuantity" aria-label="Remove">
                                    <LucideMinusCn Size="16" Class="size-3" />
                                </ButtonCn>
                                <span class="w-6 text-center text-sm font-medium tabular-nums">
                                    @_quantity
                                </span>
                                <ButtonCn Class="size-7"
                                          Disabled="@(_quantity >= 10)"
                                          Size="ButtonSize.Icon"
                                          Variant="ButtonVariant.Outline"
                                          @onclick="IncrementQuantity" aria-label="Add">
                                    <LucidePlusCn Size="16" Class="size-3" />
                                </ButtonCn>
                            </div>
                        </div>

                        <div class="mt-auto px-4 py-3">
                            @if (_addedToCart)
                            {
                                <ButtonCn Class="w-full" Disabled="true" Variant="ButtonVariant.Outline">
                                    <LucideCheckCn Size="16" Class="mr-2 size-4" />
                                    Added to Cart
                                </ButtonCn>
                            }
                            else
                            {
                                <ButtonCn Class="w-full"
                                          Disabled="@(_addingToCart || string.IsNullOrEmpty(_selectedSize))"
                                          Variant="ButtonVariant.Outline"
                                          @onclick="HandleAddToCart">
                                    @if (_addingToCart)
                                    {
                                        <LucideLoaderCircleCn Size="16" Class="mr-2 size-4 animate-spin" />
                                        <text>Adding...</text>
                                    }
                                    else
                                    {
                                        <LucideShoppingBagCn Size="16" Class="mr-2 size-4" />
                                        <text>Add to Cart &mdash; $@(_selectedProduct.Price * _quantity)</text>
                                    }
                                </ButtonCn>
                            }
                        </div>
                    </div>
                </div>
            }
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private record ProductInfo(int Id, string Name, int Price, string Category, decimal Rating, int Reviews, string Description, string[] Sizes);

    private static readonly ProductInfo[] _products =
    {
        new(1, "Merino Wool Crewneck", 145, "Knitwear", 4.8m, 124, "Lightweight merino wool sweater with a classic crewneck. Temperature regulating and naturally odor resistant.", new[] { "XS", "S", "M", "L", "XL" }),
        new(2, "Leather Weekend Bag", 295, "Accessories", 4.9m, 89, "Full-grain leather duffle with brass hardware. Spacious interior with multiple pockets for organization.", new[] { "One Size" }),
        new(3, "Canvas Low-Top Sneakers", 98, "Footwear", 4.7m, 256, "Classic canvas sneakers with vulcanized rubber sole. Comfortable for all-day wear.", new[] { "7", "8", "9", "10", "11", "12" }),
        new(4, "Linen Button-Down Shirt", 125, "Shirts", 4.6m, 178, "Breathable linen shirt with mother-of-pearl buttons. Relaxed fit perfect for warm weather.", new[] { "XS", "S", "M", "L", "XL", "XXL" })
    };

    private ProductInfo? _selectedProduct;
    private string _selectedSize = "";
    private int _quantity = 1;
    private bool _addingToCart;
    private bool _addedToCart;

    private void OpenQuickView(ProductInfo product)
    {
        _selectedProduct = product;
        _selectedSize = product.Sizes[0];
        _quantity = 1;
        _addedToCart = false;
    }

    private void OnDialogOpenChanged(bool open)
    {
        if (!open)
        {
            _selectedProduct = null;
            _selectedSize = "";
            _quantity = 1;
            _addedToCart = false;
        }
    }

    private void DecrementQuantity() => _quantity = Math.Max(1, _quantity - 1);
    private void IncrementQuantity() => _quantity = Math.Min(10, _quantity + 1);

    private async Task HandleAddToCart()
    {
        if (string.IsNullOrEmpty(_selectedSize)) return;
        _addingToCart = true;
        StateHasChanged();
        await Task.Delay(1000);
        _addingToCart = false;
        _addedToCart = true;
    }
}
