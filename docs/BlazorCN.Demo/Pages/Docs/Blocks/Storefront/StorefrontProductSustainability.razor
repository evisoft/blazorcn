@* ============================================================
   Block: storefront-product-sustainability
   Title: Storefront Product Sustainability
   Description: Product sustainability and eco info panel with carbon footprint score, recyclability, material sourcing, certifications, and environmental impact comparison
   Dependencies: LucideChevronRightCn, LucideLeafCn, LucideRecycleCn, LucideShieldCheckCn
   Source: original/blocks/storefront/storefront-product-sustainability.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideLeafCn Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Sustainability</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Environmental impact and ethical sourcing
            </p>
        </div>

        @* Score *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-4">
                <div class="flex items-baseline gap-1">
                    <span class="@Cn.Merge("text-2xl font-semibold tabular-nums", ScoreColor)">
                        @SustainabilityScore
                    </span>
                    <span class="text-xs text-muted-foreground">/100</span>
                </div>
                <span class="text-xs text-muted-foreground">@ScoreLabel</span>
                <div class="ml-auto flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-xs text-muted-foreground">Verified</span>
                </div>
            </div>
            @* Score bar *@
            <div class="mt-2 h-1 w-full rounded-full bg-muted">
                <div class="h-1 rounded-full bg-emerald-500/60"
                     style="@($"width: {SustainabilityScore}%")"></div>
            </div>
        </div>

        @* Material Sourcing *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">
                Material sourcing
            </span>
            <div class="flex flex-col gap-1.5">
                @foreach (var material in _materials)
                {
                    <div class="flex items-center justify-between">
                        <div>
                            <span class="text-sm">@material.Material</span>
                            <p class="text-xs text-muted-foreground">@material.Origin</p>
                        </div>
                        <div class="flex items-center gap-1.5">
                            @if (material.Recyclable)
                            {
                                <LucideRecycleCn Size="16" Class="size-3 text-emerald-500" />
                                <span class="text-xs text-muted-foreground">Recyclable</span>
                            }
                            else
                            {
                                <span class="text-xs text-muted-foreground">Not recyclable</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Environmental Impact Comparison *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">
                Environmental impact vs. industry average
            </span>
            <div class="flex flex-col gap-2">
                @foreach (var metric in _impactMetrics)
                {
                    <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                        <div>
                            <span class="text-sm font-medium">@metric.Label</span>
                            <div class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                                <span>This product: @metric.ProductValue</span>
                                <span>&middot;</span>
                                <span>Avg: @metric.IndustryAvg</span>
                            </div>
                        </div>
                        <span class="text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                            @metric.Improvement
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Certifications *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">
                Certifications
            </span>
        </div>
        <div>
            @for (var i = 0; i < _certifications.Length; i++)
            {
                var cert = _certifications[i];
                var isExpanded = _expandedCert == cert.Id;
                var isLast = i == _certifications.Length - 1;
                <div class="@(!isLast ? "border-b" : "")">
                    <button class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            type="button"
                            @onclick="@(() => _expandedCert = isExpanded ? null : cert.Id)">
                        <LucideShieldCheckCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@cert.Name</span>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                @cert.Issuer &middot; Valid through @cert.ValidThrough
                            </p>
                        </div>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>
                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-11">
                            <p class="text-sm leading-relaxed text-muted-foreground">
                                @cert.Description
                            </p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record CertificationInfo(string Id, string Name, string Issuer, string ValidThrough, string Description);
    private record MaterialSource(string Id, string Material, string Origin, bool Recyclable);
    private record ImpactMetric(string Id, string Label, string ProductValue, string IndustryAvg, string Improvement);

    private const int SustainabilityScore = 87;

    private static readonly CertificationInfo[] _certifications =
    {
        new("c1", "B Corp Certified", "B Lab", "Dec 2027", "Meets rigorous standards of social and environmental performance, accountability, and transparency."),
        new("c2", "Fair Trade Certified", "Fair Trade USA", "Jun 2027", "Workers received fair wages and worked in safe conditions. Community development premiums funded local projects."),
        new("c3", "OEKO-TEX Standard 100", "OEKO-TEX Association", "Mar 2027", "Tested for harmful substances at every stage of production. Safe for direct skin contact including for infants."),
        new("c4", "Climate Neutral Certified", "Climate Neutral", "Dec 2026", "Measured, reduced, and offset all carbon emissions from cradle to customer. Committed to annual reduction targets.")
    };

    private static readonly MaterialSource[] _materials =
    {
        new("m1", "Organic Cotton (60%)", "India, GOTS-certified farms", true),
        new("m2", "Recycled Polyester (30%)", "Post-consumer PET bottles", true),
        new("m3", "Elastane (10%)", "Japan", false)
    };

    private static readonly ImpactMetric[] _impactMetrics =
    {
        new("imp1", "Carbon emissions", "3.2 kg CO2e", "8.1 kg CO2e", "-60%"),
        new("imp2", "Water usage", "1,200 L", "2,700 L", "-56%"),
        new("imp3", "Waste diverted", "92%", "34%", "+171%")
    };

    private string? _expandedCert = "c1";

    private string ScoreColor => SustainabilityScore >= 80
        ? "text-emerald-600 dark:text-emerald-400"
        : SustainabilityScore >= 50
            ? "text-amber-600 dark:text-amber-400"
            : "text-red-600 dark:text-red-400";

    private string ScoreLabel => SustainabilityScore >= 80
        ? "Excellent"
        : SustainabilityScore >= 50
            ? "Good"
            : "Needs improvement";
}
