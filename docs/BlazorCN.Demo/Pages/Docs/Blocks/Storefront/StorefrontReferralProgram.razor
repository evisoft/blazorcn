@* ============================================================
   Block: storefront-referral-program
   Title: Storefront Referral Program
   Description: Storefront referral program with shareable link, earnings tracker, and referral history
   Dependencies: ButtonCn, InputCn, LucideCheckCn, LucideCopyCn, LucideSendCn
   Source: original/blocks/storefront/storefront-referral-program.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Refer &amp; Earn</h2>
            <p class="text-xs text-muted-foreground">
                Give $15, get $25 for every friend who shops
            </p>
        </div>

        @* How It Works *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">How it works</p>
            @for (var i = 0; i < _steps.Length; i++)
            {
                var step = _steps[i];
                var isLast = i == _steps.Length - 1;
                <div class="@Cn.Merge("flex items-start gap-3 py-2", !isLast ? "border-b" : "")">
                    <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium tabular-nums">
                        @step.Number
                    </span>
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@step.Title</p>
                        <p class="text-xs text-muted-foreground">@step.Description</p>
                    </div>
                </div>
            }
        </div>

        @* Referral Link *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Your referral link</p>
            <div class="flex items-center gap-2 rounded-md bg-muted/50 p-3">
                <span class="flex-1 truncate font-mono text-xs text-muted-foreground">
                    @ReferralLink
                </span>
                <ButtonCn Class="h-6 shrink-0 gap-1 px-2 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="HandleCopy">
                    @if (_copied)
                    {
                        <LucideCheckCn Size="16" Class="size-3" />
                        <text>Copied</text>
                    }
                    else
                    {
                        <LucideCopyCn Size="16" Class="size-3" />
                        <text>Copy</text>
                    }
                </ButtonCn>
            </div>
        </div>

        @* Stats *@
        <div class="flex items-center gap-6 border-b px-4 py-3">
            <div>
                <p class="text-2xl font-semibold tabular-nums">@StatsSent</p>
                <p class="text-xs text-muted-foreground">Sent</p>
            </div>
            <div>
                <p class="text-2xl font-semibold tabular-nums">@StatsCompleted</p>
                <p class="text-xs text-muted-foreground">Completed</p>
            </div>
            <div>
                <p class="text-2xl font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">
                    $@StatsEarned
                </p>
                <p class="text-xs text-muted-foreground">Earned</p>
            </div>
        </div>

        @* Referral History *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Referral history</p>
            @for (var i = 0; i < _referrals.Length; i++)
            {
                var referral = _referrals[i];
                var isLast = i == _referrals.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 py-2", !isLast ? "border-b" : "")">
                    <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">
                        @referral.Initial
                    </span>
                    <span class="flex-1 text-sm font-medium">@referral.Name</span>
                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", referral.Status == "earned" ? "bg-emerald-500" : "bg-amber-500")"></span>
                    <span class="text-xs text-muted-foreground">
                        @(referral.Status == "earned" ? "Earned" : "Pending")
                    </span>
                    <span class="font-mono text-xs tabular-nums text-muted-foreground">
                        $@referral.Amount
                    </span>
                </div>
            }
        </div>

        @* Share via Email *@
        <div class="px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Invite by email</p>
            <div class="flex gap-2">
                <InputCn @bind-Value="_email"
                         Placeholder="@EmailPlaceholder"
                         Type="email"
                         Class="h-8 text-sm" />
                <ButtonCn Class="h-8 shrink-0 gap-1.5 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                    <LucideSendCn Size="16" Class="size-3" />
                    Send
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record StepInfo(string Number, string Title, string Description);
    private record ReferralInfo(string Id, string Initial, string Name, string Status, int Amount);

    private const string EmailPlaceholder = "friend@email.com";
    private const string ReferralLink = "https://acme.com/ref/sarah-k42x";
    private const int StatsSent = 5;
    private const int StatsCompleted = 3;
    private const int StatsEarned = 75;

    private static readonly StepInfo[] _steps =
    {
        new("1", "Share your link", "Send your unique referral link to friends"),
        new("2", "Friend shops", "They get $15 off their first order"),
        new("3", "You earn", "Get $25 credit when they purchase")
    };

    private static readonly ReferralInfo[] _referrals =
    {
        new("1", "M", "Maria", "earned", 25),
        new("2", "J", "James", "earned", 25),
        new("3", "A", "Alex", "earned", 25),
        new("4", "S", "Sam", "pending", 25),
        new("5", "L", "Lisa", "pending", 25)
    };

    private bool _copied;
    private string _email = "";

    private async Task HandleCopy()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
