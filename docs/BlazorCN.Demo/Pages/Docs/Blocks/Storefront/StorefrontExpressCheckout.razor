@* ============================================================
   Block: storefront-express-checkout
   Title: Storefront Express Checkout
   Description: One-click express checkout with saved payment method, shipping preview, order total, and instant buy button for returning customers
   Dependencies: ButtonCn, LucideCheckCircle2Cn, LucideCreditCardCn, LucideMapPinCn, LucidePackageCn, LucideShieldCheckCn, LucideTruckCn, LucideZapCn
   Source: original/blocks/storefront/storefront-express-checkout.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideZapCn Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Express Checkout</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">Complete your order with saved details</p>
        </div>

        @* Saved Payment Method *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">Payment</span>
                <button type="button" class="text-xs text-muted-foreground hover:text-foreground">Change</button>
            </div>
            <div class="mt-1.5 flex items-center gap-2">
                <LucideCreditCardCn Size="16" Class="size-4 text-muted-foreground" />
                <div class="flex items-center gap-2">
                    <span class="text-xs font-medium text-muted-foreground">Visa</span>
                    <span class="font-mono text-sm font-medium">···· 4242</span>
                </div>
                <span class="text-xs text-muted-foreground">Exp 09/27</span>
                <span class="flex items-center gap-1 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Default
                </span>
            </div>
        </div>

        @* Saved Shipping Address *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">Ship to</span>
                <button type="button" class="text-xs text-muted-foreground hover:text-foreground">Change</button>
            </div>
            <div class="mt-1.5 flex items-center gap-2">
                <LucideMapPinCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                <div>
                    <p class="text-sm">Alex Johnson</p>
                    <p class="text-xs text-muted-foreground">742 Evergreen Terrace, Portland, OR 97201</p>
                </div>
            </div>
        </div>

        @* Delivery Estimate *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideTruckCn Size="16" Class="size-3.5 text-muted-foreground" />
                <span class="text-xs font-medium text-muted-foreground">Estimated Delivery</span>
            </div>
            <p class="mt-0.5 pl-[22px] text-sm">Mar 20 – Mar 22, 2026</p>
            <p class="pl-[22px] text-xs text-muted-foreground">Free standard shipping</p>
        </div>

        @* Order Items *@
        @foreach (var item in _cartItems)
        {
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                    <LucidePackageCn Size="16" Class="size-3.5 text-muted-foreground/60" />
                </div>
                <div class="min-w-0 flex-1">
                    <p class="truncate text-sm font-medium">@item.Name</p>
                    <p class="text-xs text-muted-foreground">@item.Variant · Qty @item.Quantity</p>
                </div>
                <span class="shrink-0 text-sm tabular-nums">$@(item.Price * item.Quantity)</span>
            </div>
        }

        @* Totals *@
        <div class="border-b px-4 py-3">
            <div class="space-y-1">
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Subtotal</span>
                    <span class="text-xs tabular-nums">$@Subtotal.ToString("F2")</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Shipping</span>
                    <span class="text-xs tabular-nums">Free</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Tax</span>
                    <span class="text-xs tabular-nums">$@Tax.ToString("F2")</span>
                </div>
            </div>
            <div class="mt-2 border-t pt-2">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium">Total</span>
                    <span class="text-2xl font-semibold tabular-nums">$@Total.ToString("F2")</span>
                </div>
            </div>
        </div>

        @* Buy Now *@
        <div class="px-4 py-3">
            @if (_confirmed)
            {
                <div class="flex items-center justify-center gap-2 py-2">
                    <LucideCircleCheckBigCn Size="16" Class="size-4 text-emerald-500" />
                    <span class="text-sm font-medium">Order placed successfully</span>
                </div>
            }
            else
            {
                <ButtonCn Class="h-9 w-full text-sm" Variant="ButtonVariant.Outline" @onclick="() => _confirmed = true">
                    Buy Now — $@Total.ToString("F2")
                </ButtonCn>
                <div class="mt-2 flex items-center justify-center gap-1.5">
                    <LucideShieldCheckCn Size="16" Class="size-3 text-muted-foreground" />
                    <span class="text-xs text-muted-foreground">Secure checkout with encrypted payment</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record CartItemInfo(int Id, string Name, string Variant, int Price, int Quantity);

    private static readonly CartItemInfo[] _cartItems =
    {
        new(1, "Merino Wool Crewneck", "Charcoal / M", 145, 1),
        new(2, "Canvas Low-Top Sneakers", "White / 10", 98, 2)
    };

    private bool _confirmed;

    private decimal Subtotal => _cartItems.Sum(i => (decimal)i.Price * i.Quantity);
    private decimal Tax => Math.Round(Subtotal * 0.08m, 2);
    private decimal Total => Subtotal + Tax;
}
