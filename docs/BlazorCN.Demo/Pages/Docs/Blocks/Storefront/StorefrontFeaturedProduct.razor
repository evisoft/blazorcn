@* ============================================================
   Block: storefront-featured-product
   Title: Storefront Featured Product
   Description: E-commerce featured product block with image, pricing, size selector, quantity picker, and add-to-cart action
   Dependencies: ButtonCn, LabelCn, LucideHeartCn, LucideImageCn, LucideLoader2Cn, LucideMinusCn, LucidePlusCn, LucideShoppingBagCn, LucideStarCn, RadioGroupCn, RadioGroupItemCn
   Source: original/blocks/storefront/storefront-featured-product.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h1 class="text-sm font-medium">Featured Product</h1>
        </div>

        @* Product Content *@
        <div class="grid md:grid-cols-2">
            @* Product Image *@
            <div class="flex aspect-square items-center justify-center border-b bg-muted/50 md:border-b-0 md:border-r">
                <LucideImageCn Size="16" Class="size-8 text-muted-foreground/60" />
            </div>

            @* Product Details *@
            <div class="flex flex-col">
                @* Name + Rating *@
                <div class="border-b px-4 py-3">
                    <div class="mb-1 flex items-center gap-1.5">
                        <div class="flex items-center gap-0.5">
                            @for (var i = 0; i < 5; i++)
                            {
                                <LucideStarCn Size="16" Class="@Cn.Merge("size-3", i < 4 ? "fill-primary text-primary" : "fill-muted text-muted")" />
                            }
                        </div>
                        <span class="text-xs text-muted-foreground">4.8 (2,847)</span>
                    </div>
                    <h2 class="text-sm font-medium">Premium Merino Wool Sweater</h2>
                    <p class="mt-1 text-xs text-muted-foreground">Crafted from 100% Australian Merino wool for exceptional warmth.</p>
                </div>

                @* Price *@
                <div class="border-b px-4 py-3">
                    <div class="flex items-baseline gap-2">
                        <span class="text-2xl font-semibold tabular-nums">$129</span>
                        <span class="text-xs text-muted-foreground line-through tabular-nums">$185</span>
                        <span class="text-xs text-muted-foreground">30% off</span>
                    </div>
                </div>

                @* Size Selector *@
                <div class="border-b px-4 py-3">
                    <LabelCn Class="mb-2 block text-xs font-medium text-muted-foreground">Size</LabelCn>
                    <RadioGroupCn Value="@_selectedSize" ValueChanged="v => _selectedSize = v" Class="flex flex-wrap gap-2">
                        @foreach (var size in _sizes)
                        {
                            <div>
                                <RadioGroupItemCn Class="peer sr-only" Disabled="@(!size.Available)" Id="@($"size-{size.Value}")" Value="@size.Value" />
                                <LabelCn Class="@Cn.Merge("flex h-8 w-11 cursor-pointer items-center justify-center rounded-md border text-xs font-medium transition-colors peer-data-[state=checked]:border-primary peer-data-[state=checked]:text-primary", size.Available ? "hover:border-foreground/50" : "cursor-not-allowed opacity-50 line-through")"
                                         For="@($"size-{size.Value}")">
                                    @size.Label
                                </LabelCn>
                            </div>
                        }
                    </RadioGroupCn>
                </div>

                @* Quantity Selector *@
                <div class="border-b px-4 py-3">
                    <LabelCn Class="mb-2 block text-xs font-medium text-muted-foreground">Quantity</LabelCn>
                    <div class="flex items-center gap-2">
                        <ButtonCn Class="size-7" Disabled="@(_quantity <= 1)" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline" @onclick="() => _quantity = Math.Max(1, _quantity - 1)">
                            <LucideMinusCn Size="16" Class="size-3" />
                        </ButtonCn>
                        <span class="w-6 text-center text-sm font-medium tabular-nums">@_quantity</span>
                        <ButtonCn Class="size-7" Disabled="@(_quantity >= 10)" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline" @onclick="() => _quantity = Math.Min(10, _quantity + 1)">
                            <LucidePlusCn Size="16" Class="size-3" />
                        </ButtonCn>
                    </div>
                </div>

                @* Action Buttons *@
                <div class="mt-auto flex items-center gap-2 px-4 py-3">
                    <ButtonCn Class="h-8 flex-1 text-xs" Disabled="@_isAddingToCart" Size="ButtonSize.Sm" @onclick="HandleAddToCart">
                        @if (_isAddingToCart)
                        {
                            <LucideLoader2Cn Size="16" Class="size-3.5 animate-spin" />
                        }
                        else
                        {
                            <LucideShoppingBagCn Size="16" Class="mr-1.5 size-3.5" />
                            <text>Add to Cart — $@(129 * _quantity)</text>
                        }
                    </ButtonCn>
                    <ButtonCn Class="size-8" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline" @onclick="() => _isWishlisted = !_isWishlisted">
                        <LucideHeartCn Size="16" Class="@Cn.Merge("size-3.5", _isWishlisted ? "fill-current text-red-500" : "")" />
                    </ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record SizeOption(string Value, string Label, bool Available);

    private static readonly SizeOption[] _sizes =
    {
        new("xs", "XS", true),
        new("s", "S", true),
        new("m", "M", true),
        new("l", "L", true),
        new("xl", "XL", false)
    };

    private string _selectedSize = "m";
    private int _quantity = 1;
    private bool _isAddingToCart;
    private bool _isWishlisted;

    private async Task HandleAddToCart()
    {
        _isAddingToCart = true;
        StateHasChanged();
        await Task.Delay(1500);
        _isAddingToCart = false;
    }
}
