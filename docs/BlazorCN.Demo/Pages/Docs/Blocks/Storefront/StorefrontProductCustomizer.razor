@* ============================================================
   Block: storefront-product-customizer
   Title: Storefront Product Customizer
   Description: Product customizer with live preview, color selection, monogram input, font picker, and dynamic pricing
   Long Description: Side-by-side product comparison table with feature checks, prices, ratings, and add-to-cart per product
   Dependencies: ButtonCn, InputCn, LabelCn, LucideImageCn, LucidePaletteCn, LucideShoppingBagCn
   Source: original/blocks/storefront/storefront-product-customizer.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
    <section class="mx-auto w-full max-w-4xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucidePaletteCn Size="16" Class="size-4 text-muted-foreground" />
                    <h1 class="text-sm font-medium">Customize Your Item</h1>
                </div>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Leather Travel Pouch &middot; Starting at $@BasePrice
                </p>
            </div>

            @* Two-Panel Layout *@
            <div class="flex flex-col md:flex-row">
                @* Left: Preview *@
                <div class="flex flex-1 items-center justify-center border-b bg-muted/30 p-6 md:border-b-0 md:border-r">
                    <div class="relative w-full max-w-[280px]">
                        <div class="flex aspect-square w-full items-center justify-center rounded-lg border bg-muted/50">
                            <LucideImageCn Size="32" Class="size-8 text-muted-foreground/60" />
                        </div>
                        @if (HasMonogram)
                        {
                            <div class="absolute inset-0 flex items-center justify-center">
                                <span
                                    class="@(Cn.Merge("text-2xl font-semibold tracking-widest", SelectedFont?.ClassName))"
                                    style="@($"color: {SelectedThread?.Hex}")">
                                    @_monogram.ToUpper()
                                </span>
                            </div>
                        }
                        <p class="mt-2 text-center text-[10px] text-muted-foreground">
                            Preview updates with your selections
                        </p>
                    </div>
                </div>

                @* Right: Options *@
                <div class="flex-1">
                    @* Base Color *@
                    <div class="border-b px-4 py-3">
                        <div class="flex items-center justify-between">
                            <LabelCn Class="text-xs font-medium text-muted-foreground">Base Color</LabelCn>
                            <span class="text-xs text-muted-foreground">@SelectedBase?.Name</span>
                        </div>
                        <div class="mt-2 flex items-center gap-2">
                            @foreach (var color in _baseColors)
                            {
                                <button
                                    class="@(Cn.Merge("relative size-7 rounded-full border-2 transition-all", _baseColor == color.Id ? "border-foreground scale-110" : "border-transparent hover:border-muted-foreground/30"))"
                                    @onclick="@(() => _baseColor = color.Id)"
                                    style="@($"background-color: {color.Hex}")"
                                    title="@color.Name"
                                    type="button">
                                </button>
                            }
                        </div>
                        @if ((SelectedBase?.Surcharge ?? 0) > 0)
                        {
                            <p class="mt-1.5 text-[10px] text-muted-foreground">
                                +$@(SelectedBase?.Surcharge) for @(SelectedBase?.Name)
                            </p>
                        }
                    </div>

                    @* Monogram *@
                    <div class="border-b px-4 py-3">
                        <div class="flex items-center justify-between">
                            <LabelCn For="customizer-monogram" Class="text-xs font-medium text-muted-foreground">
                                Monogram (optional)
                            </LabelCn>
                            <span class="text-[10px] text-muted-foreground">
                                @(HasMonogram ? $"+${MonogramSurcharge}" : "Free without")
                            </span>
                        </div>
                        <div class="mt-2 flex items-center gap-2">
                            <InputCn Id="customizer-monogram"
                                Class="h-8 w-24 text-center text-sm font-medium uppercase tracking-widest"
                                maxlength="@MaxChars"
                                Placeholder="ABC"
                                @bind-Value="_monogram" />
                            <span class="text-[10px] text-muted-foreground">
                                @_monogram.Length/@MaxChars characters
                            </span>
                        </div>
                    </div>

                    @* Font *@
                    @if (HasMonogram)
                    {
                        <div class="border-b px-4 py-3">
                            <LabelCn Class="text-xs font-medium text-muted-foreground">Font Style</LabelCn>
                            <div class="mt-2 space-y-1">
                                @foreach (var f in _fonts)
                                {
                                    <div
                                        class="@(Cn.Merge("flex cursor-pointer items-center gap-3 rounded-md px-3 py-2 transition-colors", _font == f.Id ? "bg-primary/5" : "hover:bg-muted/50"))"
                                        @onclick="@(() => _font = f.Id)"
                                        role="button"
                                        tabindex="0">
                                        <div class="@(Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded-full border", _font == f.Id ? "border-primary bg-primary" : "border-muted-foreground/30"))">
                                            @if (_font == f.Id)
                                            {
                                                <span class="size-1.5 rounded-full bg-primary-foreground"></span>
                                            }
                                        </div>
                                        <span class="@(Cn.Merge("text-sm", f.ClassName))">@f.Name</span>
                                        @if (f.Surcharge > 0)
                                        {
                                            <span class="ml-auto text-[10px] text-muted-foreground">
                                                +$@f.Surcharge
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @* Thread Color *@
                    @if (HasMonogram)
                    {
                        <div class="border-b px-4 py-3">
                            <div class="flex items-center justify-between">
                                <LabelCn Class="text-xs font-medium text-muted-foreground">Thread Color</LabelCn>
                                <span class="text-xs text-muted-foreground">@SelectedThread?.Name</span>
                            </div>
                            <div class="mt-2 flex items-center gap-2">
                                @foreach (var color in _threadColors)
                                {
                                    <button
                                        class="@(Cn.Merge("relative size-7 rounded-full border-2 transition-all", _threadColor == color.Id ? "border-foreground scale-110" : "border-transparent hover:border-muted-foreground/30"))"
                                        @onclick="@(() => _threadColor = color.Id)"
                                        style="@($"background-color: {color.Hex}")"
                                        title="@color.Name"
                                        type="button">
                                    </button>
                                }
                            </div>
                            @if ((SelectedThread?.Surcharge ?? 0) > 0)
                            {
                                <p class="mt-1.5 text-[10px] text-muted-foreground">
                                    +$@(SelectedThread?.Surcharge) for @(SelectedThread?.Name)
                                </p>
                            }
                        </div>
                    }

                    @* Price Breakdown + Add to Cart *@
                    <div class="px-4 py-3">
                        <div class="mb-3 space-y-1">
                            <div class="flex items-center justify-between">
                                <span class="text-xs text-muted-foreground">Base price</span>
                                <span class="text-xs tabular-nums">$@BasePrice</span>
                            </div>
                            @if ((SelectedBase?.Surcharge ?? 0) > 0)
                            {
                                <div class="flex items-center justify-between">
                                    <span class="text-xs text-muted-foreground">
                                        @(SelectedBase?.Name) leather
                                    </span>
                                    <span class="text-xs tabular-nums">+$@(SelectedBase?.Surcharge)</span>
                                </div>
                            }
                            @if (HasMonogram)
                            {
                                <div class="flex items-center justify-between">
                                    <span class="text-xs text-muted-foreground">
                                        Monogram &ldquo;@_monogram.ToUpper()&rdquo;
                                    </span>
                                    <span class="text-xs tabular-nums">+$@MonogramSurcharge</span>
                                </div>
                                @if (FontCost > 0)
                                {
                                    <div class="flex items-center justify-between">
                                        <span class="text-xs text-muted-foreground">
                                            @(SelectedFont?.Name) font
                                        </span>
                                        <span class="text-xs tabular-nums">+$@FontCost</span>
                                    </div>
                                }
                                @if (ThreadCost > 0)
                                {
                                    <div class="flex items-center justify-between">
                                        <span class="text-xs text-muted-foreground">
                                            @(SelectedThread?.Name) thread
                                        </span>
                                        <span class="text-xs tabular-nums">+$@ThreadCost</span>
                                    </div>
                                }
                            }
                            <div class="flex items-center justify-between border-t pt-2">
                                <span class="text-sm font-medium">Total</span>
                                <span class="font-semibold text-2xl tabular-nums">$@TotalPrice</span>
                            </div>
                        </div>
                        <ButtonCn Class="h-8 w-full text-xs" Size="ButtonSize.Sm">
                            <LucideShoppingBagCn Size="12" Class="mr-1.5 size-3" />
                            Add Custom Item
                        </ButtonCn>
                        <p class="mt-2 text-center text-[10px] text-muted-foreground">
                            Custom items ship within 5-7 business days
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</section>

@code {
    private const int BasePrice = 79;
    private const int MonogramSurcharge = 15;
    private const int MaxChars = 3;

    private string _baseColor = "navy";
    private string _monogram = "";
    private string _font = "serif";
    private string _threadColor = "gold";

    private record ColorOption(string Id, string Name, string Hex, int Surcharge);
    private record FontOption(string Id, string Name, string ClassName, int Surcharge);

    private static readonly ColorOption[] _baseColors =
    [
        new("black", "Black", "#1a1a1a", 0),
        new("navy", "Navy", "#1e3a5f", 0),
        new("burgundy", "Burgundy", "#722f37", 5),
        new("forest", "Forest", "#2d5a27", 5),
        new("camel", "Camel", "#c19a6b", 10)
    ];

    private static readonly ColorOption[] _threadColors =
    [
        new("gold", "Gold", "#d4a843", 0),
        new("silver", "Silver", "#c0c0c0", 0),
        new("white", "White", "#f5f5f5", 0),
        new("rose", "Rose Gold", "#b76e79", 5)
    ];

    private static readonly FontOption[] _fonts =
    [
        new("serif", "Classic Serif", "font-serif", 0),
        new("sans", "Modern Sans", "font-sans", 0),
        new("mono", "Monospaced", "font-mono", 5)
    ];

    private ColorOption? SelectedBase => _baseColors.FirstOrDefault(c => c.Id == _baseColor);
    private ColorOption? SelectedThread => _threadColors.FirstOrDefault(c => c.Id == _threadColor);
    private FontOption? SelectedFont => _fonts.FirstOrDefault(f => f.Id == _font);

    private bool HasMonogram => _monogram.Length > 0;
    private int FontCost => HasMonogram ? (SelectedFont?.Surcharge ?? 0) : 0;
    private int ThreadCost => HasMonogram ? (SelectedThread?.Surcharge ?? 0) : 0;
    private int TotalPrice => BasePrice + (SelectedBase?.Surcharge ?? 0)
        + (HasMonogram ? MonogramSurcharge : 0) + FontCost + ThreadCost;
}
