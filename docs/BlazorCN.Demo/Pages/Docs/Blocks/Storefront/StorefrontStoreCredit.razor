@* ============================================================
   Block: storefront-store-credit
   Title: Storefront Store Credit
   Description: Store credit balance dashboard with available credit, pending credits, transaction history, dates, amounts, and redemption information
   Dependencies: ButtonCn, LucideChevronRightCn, LucideWalletCn
   Source: original/blocks/storefront/storefront-store-credit.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideWalletCn Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Store Credit</h2>
            </div>
        </div>

        @* Balance *@
        <div class="border-b px-4 py-4">
            <span class="text-xs font-medium text-muted-foreground">Available Balance</span>
            <p class="mt-0.5 text-2xl font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">
                $@Balance.ToString("F2")
            </p>
            <div class="mt-2 flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>$@PendingTotal.ToString("F2") pending
                </span>
                <span class="text-xs text-muted-foreground">&middot;</span>
                <span class="text-xs text-muted-foreground">
                    @_transactions.Count(t => t.Amount > 0) credits earned
                </span>
            </div>
        </div>

        @* Redemption Info *@
        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <span class="text-xs font-medium">How to redeem</span>
                <p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">
                    Store credit is automatically available as a payment method at checkout. You can apply
                    any amount up to your available balance to reduce your order total.
                </p>
            </div>
        </div>

        @* Transaction History Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Transaction History</span>
            <div class="flex gap-1">
                @foreach (var option in _filterOptions)
                {
                    <ButtonCn Class="@Cn.Merge("h-6 px-2 text-xs capitalize", _filter == option ? "bg-muted" : "")"
                              Size="ButtonSize.Sm"
                              Variant="ButtonVariant.Ghost"
                              @onclick="@(() => _filter = option)">
                        @option
                    </ButtonCn>
                }
            </div>
        </div>

        @* Transactions *@
        @{ var filtered = FilteredTransactions; }
        @if (filtered.Length == 0)
        {
            <div class="px-4 py-8 text-center">
                <p class="text-xs text-muted-foreground">No transactions found</p>
            </div>
        }
        else
        {
            @for (var i = 0; i < filtered.Length; i++)
            {
                var txn = filtered[i];
                var isExpanded = _expandedId == txn.Id;
                var isPositive = txn.Amount > 0;
                var isLast = i == filtered.Length - 1;

                <div>
                    <button class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", (!isLast && !isExpanded) || isExpanded ? "border-b" : "")"
                            type="button"
                            @onclick="@(() => _expandedId = isExpanded ? null : txn.Id)">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", txn.Type == "pending" ? "bg-amber-500" : isPositive ? "bg-emerald-500" : "bg-red-500")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-1.5">
                                <span class="text-sm font-medium">@txn.Description</span>
                                @if (txn.Type == "pending")
                                {
                                    <span class="text-xs text-amber-600 dark:text-amber-400">Pending</span>
                                }
                            </div>
                            <p class="text-xs text-muted-foreground">@txn.Date</p>
                        </div>
                        <span class="@Cn.Merge("shrink-0 text-sm font-medium tabular-nums", txn.Type == "pending" ? "text-amber-600 dark:text-amber-400" : isPositive ? "text-emerald-600 dark:text-emerald-400" : "text-foreground")">
                            @(isPositive ? "+" : "")$@Math.Abs(txn.Amount).ToString("F2")
                        </span>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="@Cn.Merge("bg-muted/30 px-4 py-3 pl-9", !isLast ? "border-b" : "")">
                            <p class="text-sm leading-relaxed text-muted-foreground">@txn.Detail</p>
                            @if (!string.IsNullOrEmpty(txn.Reference))
                            {
                                <p class="mt-1 font-mono text-xs text-muted-foreground">
                                    Ref: @txn.Reference
                                </p>
                            }
                        </div>
                    }
                </div>
            }
        }

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <a class="text-xs text-muted-foreground hover:text-foreground" href="#">
                    Store credit terms and conditions
                </a>
                <ButtonCn Class="h-7 gap-1 px-2 text-xs" Variant="ButtonVariant.Outline">
                    <LucideWalletCn Size="16" Class="size-3" />
                    Redeem at Checkout
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record TransactionInfo(string Id, string Type, string Description, string Detail, string Date, decimal Amount, string? Reference = null);

    private const decimal Balance = 127.5m;
    private const decimal PendingTotal = 45.0m;

    private static readonly string[] _filterOptions = { "all", "credits", "debits" };

    private static readonly TransactionInfo[] _transactions =
    {
        new("txn-1", "pending", "Return refund \u2013 Cashmere Scarf", "Pending approval. Return received, under inspection.", "Mar 15, 2026", 45.0m, "RET-2026-0312"),
        new("txn-2", "debit", "Redeemed at checkout", "Applied to order ORD-2026-4817.", "Mar 14, 2026", -25.0m, "ORD-2026-4817"),
        new("txn-3", "credit", "Referral bonus", "Earned for referring a new customer who completed their first purchase.", "Mar 10, 2026", 20.0m, "REF-9X42"),
        new("txn-4", "credit", "Return refund \u2013 Slim Fit Chinos", "Full refund issued as store credit for returned item.", "Mar 5, 2026", 89.0m, "RET-2026-0287"),
        new("txn-5", "debit", "Redeemed at checkout", "Applied to order ORD-2026-4756.", "Feb 28, 2026", -42.5m, "ORD-2026-4756"),
        new("txn-6", "credit", "Loyalty reward", "Quarterly loyalty credit for Gold tier members.", "Feb 15, 2026", 15.0m),
        new("txn-7", "credit", "Compensation \u2013 late delivery", "Credit issued for order ORD-2026-4701 delivered 3 days late.", "Feb 10, 2026", 10.0m, "ORD-2026-4701"),
        new("txn-8", "debit", "Redeemed at checkout", "Applied to order ORD-2026-4698.", "Feb 5, 2026", -61.0m, "ORD-2026-4698")
    };

    private string? _expandedId;
    private string _filter = "all";

    private TransactionInfo[] FilteredTransactions => _filter switch
    {
        "credits" => _transactions.Where(t => t.Amount > 0).ToArray(),
        "debits" => _transactions.Where(t => t.Amount < 0).ToArray(),
        _ => _transactions
    };
}
