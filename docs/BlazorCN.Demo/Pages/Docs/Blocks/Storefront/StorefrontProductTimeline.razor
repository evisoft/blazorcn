@* ============================================================
   Block: storefront-product-timeline
   Title: Storefront Product Timeline
   Description: Product lifecycle timeline with upcoming releases, pre-order dates, shipping windows, and limited edition availability
   Long Description: Product sustainability and eco info panel with carbon footprint score, recyclability, material sourcing, certifications, and environmental impact comparison
   Dependencies: ButtonCn, LucideCalendarCn, LucideChevronRightCn, LucideClockCn, LucidePackageCn, LucideRocketCn, LucideSparklesCn, LucideTruckCn
   Source: original/blocks/storefront/storefront-product-timeline.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header *@
            <div class="border-b px-4 py-3">
                <h2 class="font-medium text-sm">Aurora Wireless Earbuds</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">Product launch timeline</p>
            </div>

            @* Summary *@
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>2 completed
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>1 in progress
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-muted-foreground/30"></span>3 upcoming
                </span>
            </div>

            @* Timeline Events *@
            <div>
                @for (var i = 0; i < _events.Length; i++)
                {
                    var evt = _events[i];
                    var isLast = i == _events.Length - 1;
                    var isExpanded = _expanded == evt.Id;
                    <div class="@(!isLast ? "border-b" : "")">
                        <button
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => _expanded = isExpanded ? null : evt.Id)"
                            type="button">
                            @* Timeline Indicator *@
                            <div class="flex flex-col items-center">
                                <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", StatusDotClass(evt.Status)))"></span>
                            </div>

                            @* Content *@
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    @RenderIcon(evt.Icon)
                                    <span class="font-medium text-sm">@evt.Title</span>
                                </div>
                                <p class="mt-0.5 text-muted-foreground text-xs">
                                    @evt.Date
                                    <span class="mx-1.5">&middot;</span>
                                    @StatusLabelText(evt.Status)
                                </p>
                            </div>

                            <LucideChevronRightCn Size="16" Class="@Cn.Merge(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                        </button>

                        @if (isExpanded)
                        {
                            <div class="px-4 pb-4 pl-9">
                                <p class="text-muted-foreground text-sm leading-relaxed">
                                    @evt.Description
                                </p>
                                <div class="mt-3 rounded-md bg-muted/50 p-3">
                                    <p class="mb-1.5 font-medium text-muted-foreground text-xs">Details</p>
                                    <p class="text-sm leading-relaxed">@evt.Details</p>
                                </div>
                                @if (!string.IsNullOrEmpty(evt.ActionLabel))
                                {
                                    <div class="mt-3">
                                        <ButtonCn Class="h-7 px-3 text-xs" Variant="ButtonVariant.Outline">
                                            @evt.ActionLabel
                                        </ButtonCn>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
</section>

@code {
    private string? _expanded = "production";

    private record TimelineEvent(string Id, string Title, string Date, string Status,
        string Description, string Details, string Icon, string? ActionLabel = null);

    private static readonly TimelineEvent[] _events =
    [
        new("announce", "Product Announced", "Feb 15, 2026", "completed",
            "Aurora Wireless Earbuds officially revealed at the Spring Tech Summit.",
            "Key specs: 40-hour battery life, adaptive noise cancellation, spatial audio, and IPX5 water resistance. Available in Midnight, Pearl, and Forest colorways.",
            "calendar"),
        new("preorder", "Pre-Orders Open", "Mar 1, 2026", "completed",
            "Early access pre-orders with a $30 discount for the first 5,000 customers.",
            "Pre-order customers receive exclusive Midnight colorway charging case and priority shipping. Full refund available until shipping date.",
            "rocket"),
        new("production", "In Production", "Mar 10, 2026", "active",
            "Manufacturing and quality assurance underway. Units passing final inspection.",
            "Batch production at Shenzhen facility with QA pass rate of 99.2%. Packaging and logistics coordination in progress for global distribution.",
            "package"),
        new("shipping", "Shipping Begins", "Apr 5, 2026", "upcoming",
            "Pre-order shipments start. Standard orders begin processing same day.",
            "Pre-order customers ship first in order received. Standard orders ship within 3-5 business days. Express shipping available at checkout.",
            "truck", "Pre-Order Now"),
        new("limited", "Limited Edition Drop", "Apr 20, 2026", "limited",
            "Artist Series collaboration with Yuki Tanaka. Only 500 units worldwide.",
            "Hand-numbered units with custom artwork on the charging case and earbuds. Includes a signed certificate of authenticity and exclusive packaging. Available exclusively on our website.",
            "sparkles", "Join Waitlist"),
        new("retail", "Retail Availability", "May 1, 2026", "upcoming",
            "Available at authorized retailers and partner stores nationwide.",
            "Launching in 12 countries across 400+ retail locations. In-store demo units available for customers to try before purchasing.",
            "clock")
    ];

    private static string StatusDotClass(string status) => status switch
    {
        "completed" => "bg-emerald-500",
        "active" => "bg-blue-500",
        "limited" => "bg-amber-500",
        _ => "bg-muted-foreground/30"
    };

    private static string StatusLabelText(string status) => status switch
    {
        "completed" => "Completed",
        "active" => "In Progress",
        "limited" => "Limited",
        _ => "Upcoming"
    };

    private RenderFragment RenderIcon(string icon) => icon switch
    {
        "calendar" => @<LucideCalendarCn Size="14" Class="size-3.5 text-muted-foreground" />,
        "rocket" => @<LucideRocketCn Size="14" Class="size-3.5 text-muted-foreground" />,
        "package" => @<LucidePackageCn Size="14" Class="size-3.5 text-muted-foreground" />,
        "truck" => @<LucideTruckCn Size="14" Class="size-3.5 text-muted-foreground" />,
        "sparkles" => @<LucideSparklesCn Size="14" Class="size-3.5 text-muted-foreground" />,
        "clock" => @<LucideClockCn Size="14" Class="size-3.5 text-muted-foreground" />,
        _ => @<span></span>
    };
}
