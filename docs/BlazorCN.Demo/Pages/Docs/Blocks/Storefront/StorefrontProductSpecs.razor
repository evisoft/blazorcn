@* ============================================================
   Block: storefront-product-specs
   Title: Storefront Product Specs
   Description: Storefront technical specifications table with alternating rows, key features section, and downloadable spec sheet
   Dependencies: ButtonCn, LucideDownloadCn, LucideFileTextCn
   Source: original/blocks/storefront/storefront-product-specs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="text-sm font-medium">@ProductName</h2>
                <p class="text-xs text-muted-foreground">Specifications</p>
            </div>
            <a href="#" class="inline-flex h-7 items-center gap-1 rounded-md px-2 text-xs text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground">
                <LucideDownloadCn Size="16" Class="size-3" />
                Spec Sheet
            </a>
        </div>

        @* Specifications Table *@
        @for (var i = 0; i < _specs.Length; i++)
        {
            var spec = _specs[i];
            var isLast = i == _specs.Length - 1;
            <div class="@Cn.Merge("flex items-start gap-4 px-4 py-2.5", !isLast ? "border-b" : "", i % 2 == 0 ? "bg-muted/20" : "")">
                <span class="w-40 shrink-0 text-xs font-medium text-muted-foreground">@spec.Label</span>
                <span class="text-sm">@spec.Value</span>
            </div>
        }

        @* Key Features *@
        <div class="border-t px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">Key Features</span>
            <div class="flex flex-col gap-2">
                @foreach (var feature in _keyFeatures)
                {
                    <div class="flex items-start gap-2">
                        <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                        <span class="text-sm">@feature</span>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center gap-2 border-t px-4 py-3">
            <LucideFileTextCn Size="16" Class="size-3.5 text-muted-foreground" />
            <span class="text-xs text-muted-foreground">
                Full specification sheet available as PDF
            </span>
        </div>
    </div>
</section>

@code {
    private record SpecRow(string Label, string Value);

    private const string ProductName = "Merino Wool Overcoat";

    private static readonly SpecRow[] _specs =
    {
        new("Material", "100% Australian Merino Wool"),
        new("Weight", "1,200g (Size M)"),
        new("Dimensions", "42\u2033 Length / 24\u2033 Chest / 34\u2033 Sleeve"),
        new("Color", "Charcoal Heather"),
        new("Lining", "Cupro Bemberg"),
        new("Closure", "Horn buttons, 3-button front"),
        new("Pockets", "2 flap, 1 interior, 1 breast"),
        new("Care Instructions", "Dry clean only"),
        new("Country of Origin", "Italy"),
        new("Season", "Fall / Winter"),
        new("Fit", "Regular"),
        new("SKU", "MW-OC-CHR-2026")
    };

    private static readonly string[] _keyFeatures =
    {
        "Temperature regulating merino wool keeps you warm without overheating",
        "Naturally water-resistant fibers repel light rain and snow",
        "Anti-odor properties allow multiple wears between cleanings",
        "Reinforced stitching at stress points for long-lasting durability",
        "Breathable cupro lining for comfortable all-day wear"
    };
}
