@* ============================================================
   Block: storefront-personalized
   Title: Storefront Personalized
   Description: Storefront personalized shopping experience with recently viewed and recommended products
   Dependencies: ButtonCn, LucideLoader2Cn, LucidePackageCn, TabsCn, TabsContentCn, TabsListCn, TabsTriggerCn
   Source: original/blocks/storefront/storefront-personalized.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Welcome Back</h2>
            <p class="text-xs text-muted-foreground">Pick up where you left off or explore new picks</p>
        </div>

        @* Tabs *@
        <TabsCn DefaultValue="recent" Class="w-full">
            <div class="border-b px-4 py-2">
                <TabsListCn Class="h-8">
                    <TabsTriggerCn Value="recent" Class="text-xs">Recently Viewed</TabsTriggerCn>
                    <TabsTriggerCn Value="recommended" Class="text-xs">For You</TabsTriggerCn>
                </TabsListCn>
            </div>

            <TabsContentCn Value="recent" Class="mt-0">
                @for (var i = 0; i < _recentlyViewed.Length; i++)
                {
                    var product = _recentlyViewed[i];
                    var isLast = i == _recentlyViewed.Length - 1;
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", !isLast ? "border-b" : "")">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-md border bg-muted/50">
                            <LucidePackageCn Size="16" Class="size-3.5 text-muted-foreground/60" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="text-xs text-muted-foreground">@product.Category</p>
                            <p class="text-sm font-medium">@product.Name</p>
                        </div>
                        @if (!string.IsNullOrEmpty(product.ViewedAt))
                        {
                            <span class="hidden text-xs text-muted-foreground sm:block">@product.ViewedAt</span>
                        }
                        <p class="shrink-0 text-sm tabular-nums">$@product.Price</p>
                        <ButtonCn Class="h-7 px-2 text-xs"
                                  Disabled="@(_addingToCart == product.Id)"
                                  Variant="ButtonVariant.Outline"
                                  @onclick="() => HandleAddToCart(product.Id)">
                            @if (_addingToCart == product.Id)
                            {
                                <LucideLoaderCircleCn Size="16" Class="size-3.5 animate-spin" />
                            }
                            else
                            {
                                <text>Add</text>
                            }
                        </ButtonCn>
                    </div>
                }
            </TabsContentCn>

            <TabsContentCn Value="recommended" Class="mt-0">
                @for (var i = 0; i < _recommendations.Length; i++)
                {
                    var product = _recommendations[i];
                    var isLast = i == _recommendations.Length - 1;
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", !isLast ? "border-b" : "")">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-md border bg-muted/50">
                            <LucidePackageCn Size="16" Class="size-3.5 text-muted-foreground/60" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="text-xs text-muted-foreground">@product.Category</p>
                            <p class="text-sm font-medium">@product.Name</p>
                        </div>
                        <p class="shrink-0 text-sm tabular-nums">$@product.Price</p>
                        <ButtonCn Class="h-7 px-2 text-xs"
                                  Disabled="@(_addingToCart == product.Id)"
                                  Variant="ButtonVariant.Outline"
                                  @onclick="() => HandleAddToCart(product.Id)">
                            @if (_addingToCart == product.Id)
                            {
                                <LucideLoaderCircleCn Size="16" Class="size-3.5 animate-spin" />
                            }
                            else
                            {
                                <text>Add</text>
                            }
                        </ButtonCn>
                    </div>
                }
            </TabsContentCn>
        </TabsCn>
    </div>
</section>

@code {
    private record ProductInfo(int Id, string Name, int Price, string Category, string? ViewedAt = null);

    private static readonly ProductInfo[] _recentlyViewed =
    {
        new(1, "Wool Blend Overcoat", 385, "Outerwear", "2 hours ago"),
        new(2, "Cashmere Scarf", 125, "Accessories", "5 hours ago"),
        new(3, "Leather Gloves", 89, "Accessories", "Yesterday"),
        new(4, "Merino Sweater", 165, "Knitwear", "Yesterday"),
        new(5, "Chelsea Boots", 245, "Footwear", "2 days ago")
    };

    private static readonly ProductInfo[] _recommendations =
    {
        new(6, "Quilted Vest", 195, "Outerwear"),
        new(7, "Wool Beanie", 45, "Accessories"),
        new(8, "Flannel Shirt", 98, "Shirts"),
        new(9, "Corduroy Trousers", 145, "Trousers"),
        new(10, "Leather Belt", 75, "Accessories")
    };

    private int? _addingToCart;

    private async Task HandleAddToCart(int productId)
    {
        _addingToCart = productId;
        StateHasChanged();
        await Task.Delay(1000);
        _addingToCart = null;
    }
}
