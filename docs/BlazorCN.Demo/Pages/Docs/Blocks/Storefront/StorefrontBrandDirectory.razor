@* ============================================================
   Block: storefront-brand-directory
   Title: Storefront Brand Directory
   Description: Storefront brand directory with A-Z alphabetical navigation, search filtering, featured brands section, and product count per brand
   Dependencies: InputCn, LucideSearchCn, LucideStoreCn
   Source: original/blocks/storefront/storefront-brand-directory.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with search *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideStoreCn Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Shop by Brand</h2>
            <div class="ml-auto flex items-center gap-1.5">
                <LucideSearchCn Size="16" Class="size-3.5 text-muted-foreground" />
                <InputCn Class="h-7 w-48 border-0 bg-transparent px-0 text-sm shadow-none focus-visible:ring-0"
                         placeholder="Search brands..."
                         @bind-Value="_search"
                         @bind-Value:after="() => _activeLetter = null" />
            </div>
        </div>

        @* Featured brands *@
        @if (string.IsNullOrEmpty(_search) && _activeLetter == null)
        {
            <div class="border-b px-4 py-3">
                <p class="mb-2 text-xs font-medium text-muted-foreground">Featured</p>
                <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
                    @foreach (var brand in _brands.Where(b => b.Featured))
                    {
                        <a class="flex flex-col rounded-md bg-muted/50 px-3 py-2 transition-colors hover:bg-muted" href="#">
                            <span class="text-sm font-medium">@brand.Name</span>
                            <span class="text-xs text-muted-foreground tabular-nums">@brand.ProductCount products</span>
                        </a>
                    }
                </div>
            </div>
        }

        @* Alphabet navigation *@
        <div class="flex flex-wrap items-center gap-0.5 border-b px-4 py-2">
            <button type="button"
                    class="@Cn.Merge("flex size-6 items-center justify-center rounded text-xs transition-colors", _activeLetter == null ? "bg-primary text-primary-foreground" : "text-muted-foreground hover:bg-muted")"
                    @onclick="() => _activeLetter = null">
                All
            </button>
            @foreach (var letter in _alphabet)
            {
                var l = letter;
                var hasItems = _brands.Any(b => b.Name[0].ToString().ToUpperInvariant() == l);
                <button type="button"
                        class="@Cn.Merge("flex size-6 items-center justify-center rounded text-xs transition-colors", _activeLetter == l ? "bg-primary text-primary-foreground" : hasItems ? "text-muted-foreground hover:bg-muted" : "text-muted-foreground/30 cursor-default")"
                        disabled="@(!hasItems)"
                        @onclick="() => _activeLetter = l">
                    @l
                </button>
            }
        </div>

        @* Brand list *@
        @{ var grouped = GetGroupedBrands(); }
        @if (grouped.Count > 0)
        {
            <div>
                @for (var gi = 0; gi < grouped.Count; gi++)
                {
                    var group = grouped[gi];
                    var isLastGroup = gi == grouped.Count - 1;
                    <div class="border-b bg-muted/30 px-4 py-1.5">
                        <span class="text-xs font-medium text-muted-foreground">@group.Letter</span>
                    </div>
                    @for (var bi = 0; bi < group.Brands.Count; bi++)
                    {
                        var brand = group.Brands[bi];
                        var isLastInGroup = bi == group.Brands.Count - 1;
                        <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", !(isLastInGroup && isLastGroup) ? "border-b" : "")">
                            <span class="min-w-0 flex-1 text-sm font-medium">@brand.Name</span>
                            <span class="text-xs text-muted-foreground tabular-nums">@brand.ProductCount products</span>
                            <a class="text-xs font-medium text-primary hover:underline" href="#">Shop</a>
                        </div>
                    }
                }
            </div>
        }
        else
        {
            <div class="px-4 py-12 text-center">
                <LucideSearchCn Size="16" Class="mx-auto mb-2 size-5 text-muted-foreground/40" />
                <p class="text-sm font-medium">No brands found</p>
                <p class="mt-1 text-xs text-muted-foreground">Try a different search term or letter</p>
            </div>
        }
    </div>
</section>

@code {
    private record BrandInfo(int Id, string Name, int ProductCount, bool Featured);
    private record BrandGroup(string Letter, List<BrandInfo> Brands);

    private static readonly string[] _alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".Select(c => c.ToString()).ToArray();

    private static readonly List<BrandInfo> _brands = new()
    {
        new(1, "Acme Studio", 142, true),
        new(2, "Alpine Goods", 89, false),
        new(3, "Artisan & Co", 56, false),
        new(4, "Beacon Supply", 203, true),
        new(5, "Birch & Vine", 34, false),
        new(6, "Canvas Republic", 78, false),
        new(7, "Cedar & Stone", 112, true),
        new(8, "Drift Apparel", 67, false),
        new(9, "Ember Workshop", 45, false),
        new(10, "Finch & Foster", 91, false),
        new(11, "Grove Collective", 128, true),
        new(12, "Harbor Goods", 73, false),
        new(13, "Ironwood Design", 52, false),
        new(14, "Juniper Home", 86, false),
        new(15, "Kestrel & Co", 39, false),
        new(16, "Linden Works", 64, false),
        new(17, "Meridian Craft", 97, false),
        new(18, "Noble Trade", 41, false),
        new(19, "Oakridge Supply", 155, false),
        new(20, "Petal & Thread", 83, false),
        new(21, "Ridge & Valley", 48, false),
        new(22, "Summit Leather", 62, false),
        new(23, "Thorn & Thistle", 37, false),
        new(24, "Union Standard", 109, false),
        new(25, "Verve Studio", 71, false),
        new(26, "Westerly Co", 95, false)
    };

    private string _search = "";
    private string? _activeLetter;

    private List<BrandGroup> GetGroupedBrands()
    {
        var filtered = _brands.AsEnumerable();
        if (!string.IsNullOrEmpty(_search))
            filtered = filtered.Where(b => b.Name.Contains(_search, StringComparison.OrdinalIgnoreCase));
        if (_activeLetter != null)
            filtered = filtered.Where(b => b.Name[0].ToString().ToUpperInvariant() == _activeLetter);

        var groups = new Dictionary<string, List<BrandInfo>>();
        foreach (var brand in filtered)
        {
            var letter = brand.Name[0].ToString().ToUpperInvariant();
            if (!groups.ContainsKey(letter)) groups[letter] = new();
            groups[letter].Add(brand);
        }
        return groups.OrderBy(g => g.Key).Select(g => new BrandGroup(g.Key, g.Value)).ToList();
    }
}
