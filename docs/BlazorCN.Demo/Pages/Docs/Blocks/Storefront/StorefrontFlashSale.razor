@* ============================================================
   Block: storefront-flash-sale
   Title: Storefront Flash Sale
   Description: Flash sale block with countdown timer, urgency messaging, and featured deal products with add-to-cart
   Long Description: Create urgency and drive conversions with this flash sale block. Features a real-time countdown timer displayed in a connected grid showing days, hours, minutes, and seconds. Below the timer, products are listed in flat rows with sale price, original price, and discount percentage as inline text. The countdown uses static initial values to prevent hydration mismatches, then syncs in useEffect. Built with the Vercel minimal aesthetic using flat sections divided by borders.
   Dependencies: ButtonCn, LucideLoader2Cn, LucidePackageCn, LucideShoppingCartCn
   Source: original/blocks/storefront/storefront-flash-sale.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
    <section class="mx-auto w-full max-w-4xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header *@
            <div class="flex items-baseline gap-2 border-b px-4 py-3">
                <h1 class="text-sm font-medium">Flash Sale</h1>
                <span class="text-xs text-muted-foreground">Ends soon</span>
            </div>

            @* Countdown Timer - Connected Grid *@
            <div class="border-b px-4 py-3">
                <div class="grid grid-cols-4 gap-px overflow-hidden rounded-md bg-border">
                    @foreach (var block in _timeBlocks)
                    {
                        <div class="flex flex-col items-center bg-card py-3">
                            <span class="text-2xl font-semibold tabular-nums">
                                @block.Value.ToString("D2")
                            </span>
                            <span class="text-[10px] text-muted-foreground">@block.Label</span>
                        </div>
                    }
                </div>
            </div>

            @* Featured Deals *@
            <div>
                @for (var i = 0; i < _featuredDeals.Length; i++)
                {
                    var deal = _featuredDeals[i];
                    var isLast = i == _featuredDeals.Length - 1;
                    <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : ""))">
                        @* Product Image *@
                        <div class="flex size-12 shrink-0 items-center justify-center rounded-md border bg-muted/50">
                            <LucidePackageCn Size="16" Class="size-4 text-muted-foreground/60" />
                        </div>

                        @* Product Info *@
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@deal.Name</span>
                            <div class="flex items-baseline gap-2">
                                <span class="text-sm font-semibold tabular-nums">$@deal.SalePrice</span>
                                <span class="text-xs text-muted-foreground line-through tabular-nums">
                                    $@deal.OriginalPrice
                                </span>
                                <span class="text-xs text-muted-foreground">-@deal.Discount% off</span>
                            </div>
                        </div>

                        @* Add to Cart *@
                        <ButtonCn
                            Class="size-7 shrink-0"
                            Disabled="@(_addingToCart == deal.Id)"
                            @onclick="@(() => HandleAddToCart(deal.Id))"
                            Size="ButtonSize.Icon"
                            Variant="ButtonVariant.Outline">
                            @if (_addingToCart == deal.Id)
                            {
                                <LucideLoader2Cn Size="16" Class="size-3.5 animate-spin" />
                            }
                            else
                            {
                                <LucideShoppingCartCn Size="16" Class="size-3.5" />
                            }
                        </ButtonCn>
                    </div>
                }
            </div>
        </div>
    </section>
</section>

@code {
    private int? _addingToCart;

    private record DealInfo(int Id, string Name, int OriginalPrice, int SalePrice, int Discount);
    private record TimeBlock(string Label, int Value);

    private static readonly DealInfo[] _featuredDeals =
    [
        new(1, "Wireless Headphones", 349, 199, 43),
        new(2, "Smart Watch Pro", 299, 179, 40),
        new(3, "Leather Backpack", 189, 99, 48),
        new(4, "Portable Speaker", 129, 79, 39)
    ];

    private static readonly TimeBlock[] _timeBlocks =
    [
        new("Days", 2),
        new("Hours", 23),
        new("Min", 59),
        new("Sec", 59)
    ];

    private async Task HandleAddToCart(int productId)
    {
        _addingToCart = productId;
        StateHasChanged();
        await Task.Delay(1000);
        _addingToCart = null;
    }
}
