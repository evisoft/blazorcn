@* ============================================================
   Block: storefront-back-in-stock
   Title: Storefront Back In Stock
   Description: Back in stock notification signup for out-of-stock products with email/SMS toggle, size and variant selection, and estimated restock date
   Dependencies: ButtonCn, InputCn, LabelCn, LucideCheckCn, LucideMailCn, LucideMessageSquareCn, LucidePackageCn
   Source: original/blocks/storefront/storefront-back-in-stock.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-red-500"></span>
                <h2 class="text-sm font-medium">Out of Stock</h2>
            </div>
            <p class="text-xs text-muted-foreground">
                Sign up to be notified when this item is available
            </p>
        </div>

        @* Product Info *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-14 shrink-0 items-center justify-center rounded-md border bg-muted/50">
                <LucidePackageCn Size="16" Class="size-5 text-muted-foreground/60" />
            </div>
            <div class="min-w-0 flex-1">
                <p class="text-sm font-medium">Organic Cotton Parka</p>
                <p class="text-xs text-muted-foreground">Heavyweight · Water-resistant</p>
            </div>
            <span class="text-2xl font-semibold tabular-nums">$285</span>
        </div>

        @* Size Selection *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">Select size</span>
            <div class="flex flex-wrap gap-2">
                @foreach (var size in _sizes)
                {
                    <button type="button"
                            class="@Cn.Merge("flex h-8 w-12 items-center justify-center rounded-md border text-xs font-medium transition-colors", _selectedSize == size ? "border-primary text-primary" : "hover:border-foreground/50")"
                            @onclick="() => _selectedSize = size">
                        @size
                    </button>
                }
            </div>
        </div>

        @* Color Selection *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">Select color</span>
            <div class="flex flex-wrap gap-2">
                @foreach (var color in _colors)
                {
                    <button type="button"
                            class="@Cn.Merge("flex h-8 items-center gap-1.5 rounded-md border px-3 text-xs font-medium transition-colors", _selectedColor == color.Value ? "border-primary text-primary" : "hover:border-foreground/50")"
                            @onclick="() => _selectedColor = color.Value">
                        @color.Name
                    </button>
                }
            </div>
        </div>

        @* Notification Method *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">Notify me via</span>
            <div class="flex gap-2">
                <button type="button"
                        class="@Cn.Merge("flex h-8 items-center gap-1.5 rounded-md border px-3 text-xs font-medium transition-colors", _notifyMethod == "email" ? "border-primary text-primary" : "hover:border-foreground/50")"
                        @onclick="SetNotifyEmail">
                    <LucideMailCn Size="16" Class="size-3" />
                    Email
                </button>
                <button type="button"
                        class="@Cn.Merge("flex h-8 items-center gap-1.5 rounded-md border px-3 text-xs font-medium transition-colors", _notifyMethod == "sms" ? "border-primary text-primary" : "hover:border-foreground/50")"
                        @onclick="SetNotifySms">
                    <LucideMessageSquareCn Size="16" Class="size-3" />
                    SMS
                </button>
            </div>
        </div>

        @* Contact Input *@
        <div class="border-b px-4 py-3">
            <LabelCn For="back-in-stock-contact" Class="mb-1 block text-xs text-muted-foreground">
                @(_notifyMethod == "email" ? "Email address" : "Phone number")
            </LabelCn>
            <div class="flex gap-2">
                <InputCn Id="back-in-stock-contact" Class="h-8 flex-1 text-xs"
                         placeholder="@(_notifyMethod == "email" ? "you@@example.com" : "+1 (555) 000-0000")"
                         type="@(_notifyMethod == "email" ? "email" : "tel")" />
                <ButtonCn Class="h-8 shrink-0 px-3 text-xs" Variant="ButtonVariant.Outline" @onclick="() => _subscribed = true">
                    @if (_subscribed)
                    {
                        <LucideCheckCn Size="16" Class="mr-1 size-3" />
                        <text>Subscribed</text>
                    }
                    else
                    {
                        <text>Notify Me</text>
                    }
                </ButtonCn>
            </div>
        </div>

        @* Restock Estimate *@
        <div class="px-4 py-3">
            <div class="flex items-center gap-2">
                <LucidePackageCn Size="16" Class="size-3.5 text-muted-foreground" />
                <span class="text-xs text-muted-foreground">
                    Estimated restock: April 8 - April 22, 2026
                </span>
            </div>
            <div class="mt-1.5 flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-xs text-muted-foreground">
                    This item has been restocked 4 times in the past 6 months
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record ColorOption(string Name, string Value);

    private static readonly string[] _sizes = { "XS", "S", "M", "L", "XL" };
    private static readonly ColorOption[] _colors =
    {
        new("Black", "black"),
        new("Navy", "navy"),
        new("Stone", "stone")
    };

    private string _selectedSize = "M";
    private string _selectedColor = "black";
    private string _notifyMethod = "email";
    private bool _subscribed;

    private void SetNotifyEmail() => _notifyMethod = "email";
    private void SetNotifySms() => _notifyMethod = "sms";
}
