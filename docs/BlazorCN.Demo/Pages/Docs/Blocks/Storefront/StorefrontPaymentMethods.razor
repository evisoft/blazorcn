@* ============================================================
   Block: storefront-payment-methods
   Title: Storefront Payment Methods
   Description: Storefront payment methods manager with saved cards, default selection, card brand labels, and add new card form with number, expiry, and CVC inputs
   Dependencies: ButtonCn, CheckboxCn, InputCn, LabelCn, LucideCreditCardCn, LucidePlusCn, LucideTrashCn
   Source: original/blocks/storefront/storefront-payment-methods.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideCreditCardCn Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Payment Methods</h2>
            </div>
            <ButtonCn Class="h-7 gap-1 px-2 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" @onclick="() => _showForm = !_showForm">
                <LucidePlusCn Size="16" Class="size-3" />
                Add New
            </ButtonCn>
        </div>

        @* Card rows *@
        @for (var i = 0; i < _cards.Count; i++)
        {
            var card = _cards[i];
            var isLast = i == _cards.Count - 1;
            <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast || _showForm ? "border-b" : "")">
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-medium text-muted-foreground">@card.Brand</span>
                        <span class="font-mono text-sm font-medium">&bull;&bull;&bull;&bull; @card.Last4</span>
                        @if (card.IsDefault)
                        {
                            <span class="flex items-center gap-1 text-xs text-muted-foreground">
                                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                Default
                            </span>
                        }
                    </div>
                    <p class="mt-0.5 text-xs text-muted-foreground">Expires @card.Expiry</p>
                </div>
                <div class="flex shrink-0 items-center gap-1">
                    @if (!card.IsDefault)
                    {
                        <ButtonCn Class="h-7 px-2 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="() => SetDefault(card.Id)">
                            Set Default
                        </ButtonCn>
                    }
                    <ButtonCn Class="size-7 text-muted-foreground" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" @onclick="() => RemoveCard(card.Id)" aria-label="Delete">
                        <LucideTrashCn Size="16" Class="size-3" />
                    </ButtonCn>
                </div>
            </div>
        }

        @* Add card form *@
        @if (_showForm)
        {
            <div class="px-4 py-4">
                <p class="mb-3 text-xs font-medium text-muted-foreground">New Card</p>
                <div class="space-y-3">
                    <div>
                        <LabelCn Class="text-xs" For="card-number">Card Number</LabelCn>
                        <InputCn Class="mt-1 h-8 font-mono text-sm" id="card-number" Placeholder="4242 4242 4242 4242" @bind-Value="_formNumber" />
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <LabelCn Class="text-xs" For="card-expiry">Expiry</LabelCn>
                            <InputCn Class="mt-1 h-8 font-mono text-sm" id="card-expiry" Placeholder="MM/YY" @bind-Value="_formExpiry" />
                        </div>
                        <div>
                            <LabelCn Class="text-xs" For="card-cvc">CVC</LabelCn>
                            <InputCn Class="mt-1 h-8 font-mono text-sm" id="card-cvc" Placeholder="123" @bind-Value="_formCvc" />
                        </div>
                    </div>
                    <span class="flex items-center gap-2">
                        <CheckboxCn id="card-default" @bind-Checked="_formDefault" />
                        <label class="text-xs text-muted-foreground" for="card-default">
                            Set as default payment method
                        </label>
                    </span>
                    <div class="flex justify-end gap-2 pt-1">
                        <ButtonCn Class="h-7 px-3 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="() => _showForm = false">
                            Cancel
                        </ButtonCn>
                        <ButtonCn Class="h-7 px-3 text-xs" Size="ButtonSize.Sm" @onclick="AddCard">
                            Save Card
                        </ButtonCn>
                    </div>
                </div>
            </div>
        }

        @* Empty state *@
        @if (_cards.Count == 0 && !_showForm)
        {
            <div class="px-4 py-12 text-center">
                <LucideCreditCardCn Size="16" Class="mx-auto mb-2 size-5 text-muted-foreground/40" />
                <p class="text-sm font-medium">No payment methods</p>
                <p class="mt-1 text-xs text-muted-foreground">Add a card to speed up checkout</p>
            </div>
        }
    </div>
</section>

@code {
    private class PaymentCard
    {
        public int Id { get; set; }
        public string Brand { get; set; } = "";
        public string Last4 { get; set; } = "";
        public string Expiry { get; set; } = "";
        public bool IsDefault { get; set; }
    }

    private List<PaymentCard> _cards = new()
    {
        new() { Id = 1, Brand = "Visa", Last4 = "4242", Expiry = "09/27", IsDefault = true },
        new() { Id = 2, Brand = "Mastercard", Last4 = "8910", Expiry = "03/28", IsDefault = false },
        new() { Id = 3, Brand = "Amex", Last4 = "1001", Expiry = "12/26", IsDefault = false }
    };

    private bool _showForm;
    private string _formNumber = "";
    private string _formExpiry = "";
    private string _formCvc = "";
    private bool _formDefault;

    private void RemoveCard(int id) => _cards.RemoveAll(c => c.Id == id);

    private void SetDefault(int id)
    {
        foreach (var c in _cards) c.IsDefault = c.Id == id;
    }

    private void AddCard()
    {
        if (string.IsNullOrWhiteSpace(_formNumber) || string.IsNullOrWhiteSpace(_formExpiry) || string.IsNullOrWhiteSpace(_formCvc)) return;

        var newId = _cards.Count > 0 ? _cards.Max(c => c.Id) + 1 : 1;
        var brand = _formNumber.StartsWith("3") ? "Amex"
            : _formNumber.StartsWith("5") ? "Mastercard"
            : "Visa";
        var last4 = _formNumber.Replace(" ", "");
        last4 = last4.Length >= 4 ? last4[^4..] : "0000";

        if (_formDefault)
            foreach (var c in _cards) c.IsDefault = false;

        _cards.Add(new PaymentCard
        {
            Id = newId,
            Brand = brand,
            Last4 = last4,
            Expiry = _formExpiry,
            IsDefault = _formDefault
        });

        _formNumber = "";
        _formExpiry = "";
        _formCvc = "";
        _formDefault = false;
        _showForm = false;
    }
}
