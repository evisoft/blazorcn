@* ============================================================
   Block: storefront-auction
   Title: Storefront Auction
   Description: Storefront live auction block with current bid, bid history, place bid input, and buy now option
   Long Description: Age gate verification panel with date of birth dropdowns, remember me checkbox, legal disclaimer, and verification status indicator
   Dependencies: ButtonCn, InputCn, LucideGavelCn, LucidePackageCn
   Source: original/blocks/storefront/storefront-auction.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header *@
            <div class="flex items-center gap-2 border-b px-4 py-3">
                <span class="relative flex size-2">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
                </span>
                <h2 class="text-sm font-medium">Live Auction</h2>
                <span class="text-xs text-muted-foreground">@_product.TimeRemaining</span>
            </div>

            @* Product *@
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <div class="flex size-14 shrink-0 items-center justify-center rounded-md bg-muted/50">
                    <LucidePackageCn Size="16" Class="size-5 text-muted-foreground/60" />
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium">@_product.Name</p>
                    <p class="text-xs text-muted-foreground">Authenticated vintage timepiece</p>
                </div>
            </div>

            @* Current Bid *@
            <div class="border-b px-4 py-3">
                <p class="text-xs text-muted-foreground">Current bid</p>
                <div class="flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">
                        $@_product.CurrentBid.ToString("N0")
                    </span>
                    <span class="text-xs text-muted-foreground">@_product.BidCount bids</span>
                </div>
            </div>

            @* Bid History *@
            <div class="border-b px-4 py-3">
                <p class="mb-2 text-xs font-medium text-muted-foreground">Recent bids</p>
                @for (var i = 0; i < _bidHistory.Length; i++)
                {
                    var bid = _bidHistory[i];
                    var isLast = i == _bidHistory.Length - 1;
                    <div class="@(Cn.Merge("flex items-center gap-3 py-2", !isLast ? "border-b" : ""))">
                        <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">
                            @bid.Initial
                        </span>
                        <span class="flex-1 font-mono text-sm tabular-nums">
                            $@bid.Amount.ToString("N0")
                        </span>
                        <span class="text-xs text-muted-foreground">@bid.Time</span>
                    </div>
                }
            </div>

            @* Place Bid *@
            <div class="border-b px-4 py-3">
                <p class="mb-2 text-xs font-medium text-muted-foreground">Place a bid</p>
                <div class="flex gap-2">
                    <div class="flex-1">
                        <InputCn aria-label="Bid amount"
                            Value="@_bidAmount"
                            placeholder="@($"${MinimumBid.ToString("N0")} or more")"
                            type="text"
                            inputmode="numeric"
                            Class="h-8 text-sm tabular-nums" />
                        <p class="mt-1 text-[10px] text-muted-foreground">
                            Minimum bid: $@MinimumBid.ToString("N0")
                        </p>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 shrink-0 gap-1.5 text-xs">
                        <LucideGavelCn Size="16" Class="size-3" />
                        Place Bid
                    </ButtonCn>
                </div>
            </div>

            @* Buy Now *@
            <div class="px-4 py-3">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs text-muted-foreground">Skip the bidding</p>
                        <p class="text-sm font-medium tabular-nums">
                            Buy Now for $@_product.BuyNowPrice.ToString("N0")
                        </p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                        Buy Now
                    </ButtonCn>
                </div>
            </div>
        </div>
    </section>
</section>

@code {
    private string _bidAmount = "";

    private record ProductInfo(string Name, int CurrentBid, int BidCount, string TimeRemaining, int MinimumIncrement, int BuyNowPrice);
    private record BidInfo(string Id, string Initial, int Amount, string Time);

    private static readonly ProductInfo _product = new("Vintage Chronograph Watch", 1250, 47, "2h 15m left", 50, 2200);

    private int MinimumBid => _product.CurrentBid + _product.MinimumIncrement;

    private static readonly BidInfo[] _bidHistory =
    [
        new("1", "R", 1250, "2 min ago"),
        new("2", "K", 1200, "8 min ago"),
        new("3", "T", 1150, "14 min ago"),
        new("4", "R", 1100, "22 min ago"),
        new("5", "M", 1050, "31 min ago")
    ];
}
