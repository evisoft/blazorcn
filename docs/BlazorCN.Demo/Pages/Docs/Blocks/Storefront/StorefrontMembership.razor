@* ============================================================
   Block: storefront-membership
   Title: Storefront Membership
   Description: Storefront membership tiers with benefit comparison, annual billing toggle, and upgrade actions
   Long Description: Display your membership program in a clean connected grid that makes it easy for customers to compare tiers and upgrade. Three tiers sit side by side in a gap-pixel layout showing tier name, price, and a benefit checklist with emerald dots for included features and muted dots for excluded ones. The annual billing toggle highlights savings inline. Current tier is visually marked so users know where they stand. Built with the Vercel minimal aesthetic using flat sections and border-separated rows.
   Dependencies: ButtonCn, LabelCn, SwitchCn
   Source: original/blocks/storefront/storefront-membership.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
    <section class="mx-auto w-full max-w-4xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header *@
            <div class="flex items-center justify-between border-b px-4 py-3">
                <div>
                    <h2 class="text-sm font-medium">Membership</h2>
                    <p class="text-xs text-muted-foreground">Choose the plan that fits your needs</p>
                </div>
                <div class="flex items-center gap-2">
                    <LabelCn for="billing-toggle" Class="text-xs text-muted-foreground cursor-pointer">
                        Monthly
                    </LabelCn>
                    <SwitchCn Id="billing-toggle" @bind-Checked="_annual" />
                    <LabelCn for="billing-toggle" Class="text-xs text-muted-foreground cursor-pointer">
                        Annual
                    </LabelCn>
                </div>
            </div>

            @* Tier Grid *@
            <div class="grid grid-cols-3 gap-px bg-border">
                @foreach (var tier in _tiers)
                {
                    <div class="flex flex-col bg-card">
                        @* Tier Header *@
                        <div class="border-b px-4 py-3">
                            <div class="flex items-center gap-2">
                                <p class="text-sm font-medium">@tier.Name</p>
                                @if (tier.IsCurrent)
                                {
                                    <span class="text-[10px] text-muted-foreground">Current</span>
                                }
                            </div>
                            <div class="mt-1 flex items-baseline gap-1">
                                <span class="text-2xl font-semibold tabular-nums">@FormatPrice(tier)</span>
                                @if (tier.MonthlyPrice > 0)
                                {
                                    <span class="text-xs text-muted-foreground">/mo</span>
                                }
                            </div>
                            @if (_annual && YearlySavings(tier) > 0)
                            {
                                <p class="mt-0.5 text-xs text-emerald-600 dark:text-emerald-400">
                                    Save $@YearlySavings(tier).ToString("F2")/yr
                                </p>
                            }
                        </div>

                        @* Benefits *@
                        <div class="flex-1 px-4 py-3">
                            <div class="space-y-0">
                                @for (var i = 0; i < tier.Benefits.Length; i++)
                                {
                                    var benefit = tier.Benefits[i];
                                    var isLast = i == tier.Benefits.Length - 1;
                                    <div class="@(Cn.Merge("flex items-center gap-2.5 py-1.5", !isLast ? "border-b" : ""))">
                                        @if (benefit.Included)
                                        {
                                            <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                                        }
                                        else
                                        {
                                            <span class="size-1.5 shrink-0 rounded-full bg-muted-foreground/30"></span>
                                        }
                                        <span class="@($"text-xs {(benefit.Included ? "text-foreground" : "text-muted-foreground")}")">
                                            @benefit.Label
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>

                        @* Action *@
                        <div class="px-4 py-3">
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 w-full text-xs" Disabled="@tier.IsCurrent">
                                @(tier.IsCurrent ? "Current Plan" : "Upgrade")
                            </ButtonCn>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
</section>

@code {
    private bool _annual;

    private record BenefitInfo(string Label, bool Included);
    private record TierInfo(string Id, string Name, decimal MonthlyPrice, decimal YearlyPrice, bool IsCurrent, BenefitInfo[] Benefits);

    private static readonly TierInfo[] _tiers =
    [
        new("free", "Free", 0, 0, true,
        [
            new("Standard shipping", true), new("Order tracking", true),
            new("Birthday reward", false), new("Early access to sales", false),
            new("Free returns", false), new("Exclusive member pricing", false)
        ]),
        new("plus", "Plus", 9.99m, 95.88m, false,
        [
            new("Standard shipping", true), new("Order tracking", true),
            new("Birthday reward", true), new("Early access to sales", true),
            new("Free returns", false), new("Exclusive member pricing", false)
        ]),
        new("premium", "Premium", 19.99m, 191.88m, false,
        [
            new("Standard shipping", true), new("Order tracking", true),
            new("Birthday reward", true), new("Early access to sales", true),
            new("Free returns", true), new("Exclusive member pricing", true)
        ])
    ];

    private string FormatPrice(TierInfo tier)
    {
        if (tier.MonthlyPrice == 0) return "Free";
        var price = _annual ? tier.YearlyPrice / 12 : tier.MonthlyPrice;
        return $"${price:F2}";
    }

    private decimal YearlySavings(TierInfo tier)
    {
        if (tier.MonthlyPrice == 0) return 0;
        return tier.MonthlyPrice * 12 - tier.YearlyPrice;
    }
}
