@* ============================================================
   Block: storefront-social-proof
   Title: Storefront Social Proof
   Description: Social proof panel with live viewer count, recent purchase notifications, trending badges, and purchase velocity indicator
   Dependencies: ButtonCn, LucideChevronDownCn, LucideEyeCn, LucideFlameCn, LucideShoppingBagCn, LucideTrendingUpCn, LucideUsersCn
   Source: original/blocks/storefront/storefront-social-proof.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideFlameCn Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Aurora Wireless Earbuds</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">Live purchase activity</p>
        </div>

        @* Live Stats *@
        <div class="grid grid-cols-2 border-b">
            <div class="px-4 py-3">
                <div class="flex items-center gap-1.5">
                    <LucideEyeCn Size="16" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs font-medium text-muted-foreground">Viewing now</span>
                </div>
                <div class="mt-1 flex items-baseline gap-1.5">
                    <span class="text-2xl font-semibold tabular-nums">@LiveViewers</span>
                    <span class="flex items-center gap-0.5">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="text-xs text-muted-foreground">live</span>
                    </span>
                </div>
            </div>
            <div class="border-l px-4 py-3">
                <div class="flex items-center gap-1.5">
                    <LucideShoppingBagCn Size="16" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs font-medium text-muted-foreground">Bought today</span>
                </div>
                <div class="mt-1 flex items-baseline gap-1.5">
                    <span class="text-2xl font-semibold tabular-nums">@Purchases24h</span>
                    <span class="text-xs text-muted-foreground">in 24h</span>
                </div>
            </div>
        </div>

        @* Trending Indicator *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center gap-1.5">
                <LucideTrendingUpCn Size="16" Class="size-3.5 text-muted-foreground" />
                <span class="text-xs font-medium text-muted-foreground">Trending Metrics</span>
            </div>
            <div class="grid grid-cols-3 gap-3">
                @foreach (var metric in _trendingMetrics)
                {
                    <div>
                        <p class="text-sm font-medium tabular-nums">@metric.Value</p>
                        <p class="text-xs text-muted-foreground">@metric.Label</p>
                        <p class="@Cn.Merge("mt-0.5 text-xs tabular-nums", metric.Positive ? "text-emerald-600" : "text-red-600")">
                            @metric.Change vs avg
                        </p>
                    </div>
                }
            </div>
        </div>

        @* Recent Purchases *@
        <div class="border-b px-4 py-2.5">
            <div class="flex items-center gap-1.5">
                <LucideUsersCn Size="16" Class="size-3.5 text-muted-foreground" />
                <span class="text-xs font-medium text-muted-foreground">Recent Purchases</span>
            </div>
        </div>

        <div>
            @{ var visible = VisibleNotifications; }
            @for (var i = 0; i < visible.Length; i++)
            {
                var notification = visible[i];
                var isLast = i == visible.Length - 1 && _showAll;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", !isLast ? "border-b" : "")">
                    <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">
                            @notification.Name
                            <span class="ml-1.5 text-xs font-normal text-muted-foreground">purchased</span>
                            <span class="ml-1 text-xs font-normal">@notification.Product</span>
                        </p>
                        <p class="text-xs text-muted-foreground">@notification.Location</p>
                    </div>
                    <span class="shrink-0 text-xs text-muted-foreground">
                        @notification.TimeAgo
                    </span>
                </div>
            }
        </div>

        @* Show More / Less *@
        @if (_purchaseNotifications.Length > InitialVisible)
        {
            <div class="border-t px-4 py-2.5">
                <ButtonCn Class="h-7 w-full gap-1 text-xs" Variant="ButtonVariant.Ghost" @onclick="@(() => _showAll = !_showAll)">
                    <LucideChevronDownCn Size="16" Class="@Cn.Merge("size-3.5 transition-transform duration-200", _showAll ? "rotate-180" : "")" />
                    @(_showAll ? "Show less" : $"Show {_purchaseNotifications.Length - InitialVisible} more")
                </ButtonCn>
            </div>
        }
    </div>
</section>

@code {
    private record PurchaseNotification(string Id, string Name, string Location, string Product, string TimeAgo);
    private record TrendingMetric(string Label, string Value, string Change, bool Positive);

    private const int LiveViewers = 47;
    private const int Purchases24h = 183;
    private const int InitialVisible = 4;

    private static readonly PurchaseNotification[] _purchaseNotifications =
    {
        new("1", "Sarah M.", "Austin, TX", "Midnight Colorway", "2 min ago"),
        new("2", "James K.", "London, UK", "Pearl Colorway", "5 min ago"),
        new("3", "Priya R.", "Toronto, CA", "Forest Colorway", "8 min ago"),
        new("4", "Lucas W.", "Berlin, DE", "Midnight Colorway", "12 min ago"),
        new("5", "Aiko T.", "Tokyo, JP", "Pearl Colorway", "18 min ago"),
        new("6", "Carlos D.", "Mexico City, MX", "Forest Colorway", "24 min ago"),
        new("7", "Emma L.", "Sydney, AU", "Midnight Colorway", "31 min ago"),
        new("8", "Noah B.", "Portland, OR", "Pearl Colorway", "38 min ago")
    };

    private static readonly TrendingMetric[] _trendingMetrics =
    {
        new("Orders / hour", "12.4", "+34%", true),
        new("Avg. time to purchase", "4.2 min", "-18%", true),
        new("Cart conversion", "68%", "+8%", true)
    };

    private bool _showAll;

    private PurchaseNotification[] VisibleNotifications =>
        _showAll ? _purchaseNotifications : _purchaseNotifications.Take(InitialVisible).ToArray();
}
