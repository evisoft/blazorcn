@* ============================================================
   Block: storefront-recently-viewed
   Title: Storefront Recently Viewed
   Description: Storefront recently viewed products list with timestamps, categories, and quick add-to-cart actions
   Dependencies: ButtonCn, LucideClockCn, LucidePackageCn, LucideShoppingBagCn, LucideTrash2Cn
   Source: original/blocks/storefront/storefront-recently-viewed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="text-sm font-medium">Recently Viewed</h2>
                <p class="text-xs text-muted-foreground">@_products.Count products</p>
            </div>
            @if (_products.Count > 0)
            {
                <ButtonCn Class="h-7 gap-1 px-2 text-xs" Variant="ButtonVariant.Ghost" @onclick="ClearHistory">
                    <LucideTrash2Cn Size="16" Class="size-3" />
                    Clear History
                </ButtonCn>
            }
        </div>

        @* Product List *@
        @if (_products.Count == 0)
        {
            <div class="px-4 py-12 text-center">
                <LucideClockCn Size="16" Class="mx-auto mb-2 size-5 text-muted-foreground/60" />
                <p class="text-sm text-muted-foreground">No recently viewed products</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Products you view will appear here
                </p>
            </div>
        }
        else
        {
            @for (var i = 0; i < _products.Count; i++)
            {
                var product = _products[i];
                var isLast = i == _products.Count - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                    <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        <LucidePackageCn Size="16" Class="size-4 text-muted-foreground/60" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@product.Name</p>
                        <p class="text-xs text-muted-foreground">@product.Category</p>
                    </div>
                    <span class="hidden shrink-0 text-xs text-muted-foreground sm:block">
                        @product.ViewedAt
                    </span>
                    <span class="shrink-0 text-sm font-medium tabular-nums">$@product.Price</span>
                    <ButtonCn Class="h-7 shrink-0 gap-1 px-2 text-xs" Variant="ButtonVariant.Outline">
                        <LucideShoppingBagCn Size="16" Class="size-3" />
                        Add to Cart
                    </ButtonCn>
                </div>
            }
        }
    </div>
</section>

@code {
    private record ViewedProduct(int Id, string Name, string Category, int Price, string ViewedAt);

    private static readonly ViewedProduct[] _initialProducts =
    {
        new(1, "Merino Wool Crewneck", "Knitwear", 145, "2h ago"),
        new(2, "Leather Weekend Bag", "Accessories", 295, "3h ago"),
        new(3, "Canvas Low-Top Sneakers", "Footwear", 98, "5h ago"),
        new(4, "Linen Button-Down Shirt", "Shirts", 125, "Yesterday"),
        new(5, "Slim Fit Chinos", "Pants", 89, "Yesterday"),
        new(6, "Cashmere Scarf", "Accessories", 175, "2 days ago"),
        new(7, "Suede Chelsea Boots", "Footwear", 220, "2 days ago"),
        new(8, "Cotton Polo Shirt", "Shirts", 65, "3 days ago")
    };

    private List<ViewedProduct> _products = new(_initialProducts);

    private void ClearHistory() => _products.Clear();
}
