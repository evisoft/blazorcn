@* ============================================================
   Block: storefront-address-book
   Title: Storefront Address Book
   Description: Storefront address book for managing saved shipping and billing addresses with default selection, inline editing, and add new address form
   Dependencies: ButtonCn, CheckboxCn, InputCn, LabelCn, LucideMapPinCn, LucidePencilCn, LucidePlusCn, LucideTrashCn
   Source: original/blocks/storefront/storefront-address-book.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideMapPinCn Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Address Book</h2>
            </div>
            <ButtonCn Class="h-7 gap-1 px-2 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" @onclick="() => _showForm = !_showForm">
                <LucidePlusCn Size="16" Class="size-3" />
                Add New
            </ButtonCn>
        </div>

        @* Address rows *@
        @for (var i = 0; i < _addresses.Count; i++)
        {
            var address = _addresses[i];
            var isLast = i == _addresses.Count - 1;
            <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast || _showForm ? "border-b" : "", address.IsDefault ? "border-l-2 border-l-primary" : "")">
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-medium">@address.Name</span>
                        @if (address.IsDefault)
                        {
                            <span class="flex items-center gap-1 text-xs text-muted-foreground">
                                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                Default
                            </span>
                        }
                    </div>
                    <p class="mt-0.5 text-xs text-muted-foreground">@address.Street</p>
                    <p class="text-xs text-muted-foreground">@address.City, @address.State @address.Zip</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@address.Phone</p>
                </div>
                <div class="flex shrink-0 items-center gap-1">
                    @if (!address.IsDefault)
                    {
                        <ButtonCn Class="h-7 px-2 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="() => SetDefault(address.Id)">
                            Set Default
                        </ButtonCn>
                    }
                    <ButtonCn Class="size-7 text-muted-foreground" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost">
                        <LucidePencilCn Size="16" Class="size-3" />
                    </ButtonCn>
                    <ButtonCn Class="size-7 text-muted-foreground" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" @onclick="() => RemoveAddress(address.Id)">
                        <LucideTrashCn Size="16" Class="size-3" />
                    </ButtonCn>
                </div>
            </div>
        }

        @* Add address form *@
        @if (_showForm)
        {
            <div class="px-4 py-4">
                <p class="mb-3 text-xs font-medium text-muted-foreground">New Address</p>
                <div class="space-y-3">
                    <div>
                        <LabelCn Class="text-xs" For="addr-name">Full Name</LabelCn>
                        <InputCn Class="mt-1 h-8 text-sm" Id="addr-name" placeholder="Jane Doe" @bind-Value="_formName" />
                    </div>
                    <div>
                        <LabelCn Class="text-xs" For="addr-street">Street Address</LabelCn>
                        <InputCn Class="mt-1 h-8 text-sm" Id="addr-street" placeholder="123 Main St, Apt 4" @bind-Value="_formStreet" />
                    </div>
                    <div class="grid grid-cols-3 gap-2">
                        <div>
                            <LabelCn Class="text-xs" For="addr-city">City</LabelCn>
                            <InputCn Class="mt-1 h-8 text-sm" Id="addr-city" placeholder="Portland" @bind-Value="_formCity" />
                        </div>
                        <div>
                            <LabelCn Class="text-xs" For="addr-state">State</LabelCn>
                            <InputCn Class="mt-1 h-8 text-sm" Id="addr-state" placeholder="OR" @bind-Value="_formState" />
                        </div>
                        <div>
                            <LabelCn Class="text-xs" For="addr-zip">ZIP Code</LabelCn>
                            <InputCn Class="mt-1 h-8 text-sm" Id="addr-zip" placeholder="97201" @bind-Value="_formZip" />
                        </div>
                    </div>
                    <div>
                        <LabelCn Class="text-xs" For="addr-phone">Phone</LabelCn>
                        <InputCn Class="mt-1 h-8 text-sm" Id="addr-phone" placeholder="(503) 555-0100" @bind-Value="_formPhone" />
                    </div>
                    <span class="flex items-center gap-2">
                        <CheckboxCn Checked="@_formDefault" CheckedChanged="v => _formDefault = v" Id="addr-default" />
                        <label class="text-xs text-muted-foreground" for="addr-default">Set as default address</label>
                    </span>
                    <div class="flex justify-end gap-2 pt-1">
                        <ButtonCn Class="h-7 px-3 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="() => _showForm = false">
                            Cancel
                        </ButtonCn>
                        <ButtonCn Class="h-7 px-3 text-xs" Size="ButtonSize.Sm" @onclick="AddAddress">
                            Save Address
                        </ButtonCn>
                    </div>
                </div>
            </div>
        }

        @* Empty state *@
        @if (_addresses.Count == 0 && !_showForm)
        {
            <div class="px-4 py-12 text-center">
                <LucideMapPinCn Size="16" Class="mx-auto mb-2 size-5 text-muted-foreground/40" />
                <p class="text-sm font-medium">No saved addresses</p>
                <p class="mt-1 text-xs text-muted-foreground">Add an address to speed up checkout</p>
            </div>
        }
    </div>
</section>

@code {
    private class AddressInfo
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Street { get; set; } = "";
        public string City { get; set; } = "";
        public string State { get; set; } = "";
        public string Zip { get; set; } = "";
        public string Phone { get; set; } = "";
        public bool IsDefault { get; set; }
    }

    private List<AddressInfo> _addresses = new()
    {
        new() { Id = 1, Name = "Sarah Mitchell", Street = "742 Evergreen Terrace", City = "Portland", State = "OR", Zip = "97201", Phone = "(503) 555-0147", IsDefault = true },
        new() { Id = 2, Name = "Sarah Mitchell", Street = "1200 NW Marshall St, Apt 4B", City = "Portland", State = "OR", Zip = "97209", Phone = "(503) 555-0183", IsDefault = false },
        new() { Id = 3, Name = "James Mitchell", Street = "89 Hawthorne Blvd", City = "Seattle", State = "WA", Zip = "98101", Phone = "(206) 555-0291", IsDefault = false }
    };

    private bool _showForm;
    private string _formName = "";
    private string _formStreet = "";
    private string _formCity = "";
    private string _formState = "";
    private string _formZip = "";
    private string _formPhone = "";
    private bool _formDefault;

    private void RemoveAddress(int id) => _addresses.RemoveAll(a => a.Id == id);

    private void SetDefault(int id)
    {
        foreach (var a in _addresses) a.IsDefault = a.Id == id;
    }

    private void AddAddress()
    {
        if (string.IsNullOrEmpty(_formName) || string.IsNullOrEmpty(_formStreet) ||
            string.IsNullOrEmpty(_formCity) || string.IsNullOrEmpty(_formState) ||
            string.IsNullOrEmpty(_formZip)) return;

        var newId = _addresses.Count > 0 ? _addresses.Max(a => a.Id) + 1 : 1;
        if (_formDefault)
            foreach (var a in _addresses) a.IsDefault = false;

        _addresses.Add(new AddressInfo
        {
            Id = newId, Name = _formName, Street = _formStreet,
            City = _formCity, State = _formState, Zip = _formZip,
            Phone = _formPhone, IsDefault = _formDefault
        });

        _formName = ""; _formStreet = ""; _formCity = "";
        _formState = ""; _formZip = ""; _formPhone = "";
        _formDefault = false; _showForm = false;
    }
}
