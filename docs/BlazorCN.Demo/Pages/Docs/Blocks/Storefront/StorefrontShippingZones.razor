@* ============================================================
   Block: storefront-shipping-zones
   Title: Storefront Shipping Zones
   Description: Shipping zones and rates table with domestic and international zones, carrier options, weight-based pricing tiers, free shipping thresholds, and estimated delivery ranges
   Long Description: Display transparent shipping costs with this shipping zones and rates block. Features a tabbed zone selector for domestic and international regions, carrier options per zone with logos and estimated delivery windows, weight-based pricing tiers in a clean table layout, free shipping thresholds for each zone, and expandable zone details. Customers can quickly find their shipping cost without guesswork. Built with Button and Tabs components using the Vercel minimal aesthetic.
   Dependencies: ButtonCn, LucideChevronRightCn, LucideGlobeCn, LucidePackageCn, LucideTruckCn
   Source: original/blocks/storefront/storefront-shipping-zones.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideGlobeCn Size="16" Class="size-4 text-muted-foreground" />
                    <h2 class="text-sm font-medium">Shipping Zones &amp; Rates</h2>
                </div>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Rates by region, carrier, and package weight
                </p>
            </div>

            @* Zone Selector *@
            <div class="flex border-b">
                @foreach (var z in _zones)
                {
                    <button
                        class="@(Cn.Merge("flex-1 px-3 py-2.5 text-center text-xs font-medium transition-colors", _selectedZone == z.Id ? "border-b-2 border-foreground text-foreground" : "text-muted-foreground hover:text-foreground"))"
                        @onclick="@(() => { _selectedZone = z.Id; _expandedCarrier = null; })"
                        type="button">
                        @z.Name
                    </button>
                }
            </div>

            @* Zone Info *@
            @if (SelectedZone is not null)
            {
                <div class="flex items-center justify-between border-b px-4 py-3">
                    <div>
                        <p class="text-xs text-muted-foreground">@SelectedZone.Countries</p>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="text-xs text-emerald-600 dark:text-emerald-400">
                            Free shipping over $@SelectedZone.FreeShippingMin
                        </span>
                    </div>
                </div>

                @* Carriers *@
                <div>
                    @for (var ci = 0; ci < SelectedZone.Carriers.Length; ci++)
                    {
                        var carrier = SelectedZone.Carriers[ci];
                        var isExpanded = _expandedCarrier == carrier.Id;
                        var isLastCarrier = ci == SelectedZone.Carriers.Length - 1;
                        <div class="@(!isLastCarrier || isExpanded ? "border-b" : "")">
                            <button
                                class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                                @onclick="@(() => _expandedCarrier = isExpanded ? null : carrier.Id)"
                                type="button">
                                <LucideTruckCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <span class="text-sm font-medium">@carrier.Name</span>
                                    <p class="text-xs text-muted-foreground">@carrier.Delivery</p>
                                </div>
                                <div class="shrink-0 text-right">
                                    <span class="text-xs text-muted-foreground tabular-nums">
                                        From $@carrier.WeightTiers[0].Price.ToString("F2")
                                    </span>
                                </div>
                                <LucideChevronRightCn Size="16" Class="@Cn.Merge(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                            </button>

                            @if (isExpanded)
                            {
                                <div class="px-4 pb-3">
                                    @* Weight Tiers Table *@
                                    <div class="overflow-hidden rounded-md border">
                                        <div class="grid grid-cols-3 bg-muted/30 px-3 py-1.5">
                                            <span class="text-[10px] font-medium text-muted-foreground">Tier</span>
                                            <span class="text-[10px] font-medium text-muted-foreground">Weight</span>
                                            <span class="text-right text-[10px] font-medium text-muted-foreground">Price</span>
                                        </div>
                                        @for (var ti = 0; ti < carrier.WeightTiers.Length; ti++)
                                        {
                                            var tier = carrier.WeightTiers[ti];
                                            <div class="@(Cn.Merge("grid grid-cols-3 px-3 py-2", ti > 0 ? "border-t" : ""))">
                                                <span class="text-xs">@tier.Label</span>
                                                <span class="font-mono text-xs text-muted-foreground">@tier.Range</span>
                                                <span class="text-right text-xs font-medium tabular-nums">$@tier.Price.ToString("F2")</span>
                                            </div>
                                        }
                                    </div>

                                    @* Free Shipping Note *@
                                    <div class="mt-2 flex items-center gap-1.5">
                                        <LucidePackageCn Size="12" Class="size-3 text-muted-foreground" />
                                        <span class="text-[10px] text-muted-foreground">
                                            Free standard shipping on orders over $@SelectedZone.FreeShippingMin to @SelectedZone.Name
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                @* Footer *@
                <div class="border-t px-4 py-3">
                    <div class="flex items-center justify-between">
                        <p class="text-[10px] text-muted-foreground">
                            Rates exclude duties and taxes for international orders
                        </p>
                        <ButtonCn Class="h-6 px-2 text-xs" Variant="ButtonVariant.Ghost">
                            Contact support
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>
    </section>
</section>

@code {
