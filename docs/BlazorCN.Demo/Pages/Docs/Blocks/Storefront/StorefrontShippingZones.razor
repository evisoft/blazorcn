    private string? _expandedCarrier = "usps";

    private record WeightTier(string Label, string Range, decimal Price);
    private record Carrier(string Id, string Name, string Delivery, WeightTier[] WeightTiers);
    private record ShippingZone(string Id, string Name, string Countries, int FreeShippingMin, Carrier[] Carriers);

