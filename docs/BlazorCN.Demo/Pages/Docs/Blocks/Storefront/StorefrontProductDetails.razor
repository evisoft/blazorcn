@* ============================================================
   Block: storefront-product-details
   Title: Storefront Product Details
   Description: Full product detail page with image gallery, pricing, color and size selectors, accordion info sections, and similar items
   Dependencies: AccordionCn, AccordionContentCn, AccordionItemCn, AccordionTriggerCn, ButtonCn, LabelCn, LucideHeartCn, LucideImageCn, LucidePackageCn, LucideShoppingBagCn, LucideStarCn, RadioGroupCn, RadioGroupItemCn
   Source: original/blocks/storefront/storefront-product-details.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="text-xs text-muted-foreground">
                    Women &rsaquo; Knitwear &rsaquo; Sweaters
                </span>
            </div>
        </div>

        @* Product Content *@
        <div class="grid border-b md:grid-cols-2">
            @* Product Image *@
            <div class="flex aspect-square items-center justify-center border-b bg-muted/50 md:border-b-0 md:border-r">
                <LucideImageCn Size="16" Class="size-8 text-muted-foreground/60" />
            </div>

            @* Product Details *@
            <div class="flex flex-col">
                @* Name + Price *@
                <div class="border-b px-4 py-3">
                    <div class="mb-1 flex items-center gap-1.5">
                        <div class="flex items-center gap-0.5">
                            @for (var i = 0; i < 5; i++)
                            {
                                <LucideStarCn Size="16" Class="@Cn.Merge("size-3", i < 4 ? "fill-primary text-primary" : "fill-muted text-muted")" />
                            }
                        </div>
                        <span class="text-xs text-muted-foreground">4.7 (1,243)</span>
                    </div>
                    <h2 class="text-sm font-medium">Merino Wool Crewneck Sweater</h2>
                    <div class="mt-1 flex items-baseline gap-2">
                        <span class="text-2xl font-semibold tabular-nums">$145</span>
                    </div>
                </div>

                @* Description *@
                <div class="border-b px-4 py-3">
                    <p class="text-xs leading-relaxed text-muted-foreground">
                        Crafted from 100% Australian Merino wool, this crewneck sweater offers exceptional
                        softness and natural temperature regulation. The fine gauge knit provides a refined
                        silhouette that layers effortlessly under blazers or over collared shirts.
                    </p>
                </div>

                @* Color Selector *@
                <div class="border-b px-4 py-3">
                    <LabelCn Class="mb-2 block text-xs font-medium text-muted-foreground">
                        Color &mdash; @(_colors.FirstOrDefault(c => c.Value == _selectedColor)?.Label)
                    </LabelCn>
                    <RadioGroupCn Value="@_selectedColor" ValueChanged="v => _selectedColor = v" Class="flex gap-2">
                        @foreach (var color in _colors)
                        {
                            <div>
                                <RadioGroupItemCn aria-label="@color.Label" Class="peer sr-only" Id="@($"product-details-color-{color.Value}")" Value="@color.Value" />
                                <LabelCn Class="flex size-7 cursor-pointer items-center justify-center rounded-full border-2 transition-colors peer-data-[state=checked]:border-primary"
                                         For="@($"product-details-color-{color.Value}")">
                                    <span class="size-4 rounded-full" style="background-color: @color.Hex"></span>
                                </LabelCn>
                            </div>
                        }
                    </RadioGroupCn>
                </div>

                @* Size Selector *@
                <div class="border-b px-4 py-3">
                    <LabelCn Class="mb-2 block text-xs font-medium text-muted-foreground">Size</LabelCn>
                    <RadioGroupCn Value="@_selectedSize" ValueChanged="v => _selectedSize = v" Class="flex flex-wrap gap-2">
                        @foreach (var size in _sizes)
                        {
                            <div>
                                <RadioGroupItemCn Class="peer sr-only" Disabled="@(!size.Available)" Id="@($"pd-size-{size.Value}")" Value="@size.Value" />
                                <LabelCn Class="@Cn.Merge("flex h-8 w-11 cursor-pointer items-center justify-center rounded-md border text-xs font-medium transition-colors peer-data-[state=checked]:border-primary peer-data-[state=checked]:text-primary", size.Available ? "hover:border-foreground/50" : "cursor-not-allowed opacity-50 line-through")"
                                         For="@($"pd-size-{size.Value}")">
                                    @size.Label
                                </LabelCn>
                            </div>
                        }
                    </RadioGroupCn>
                </div>

                @* Accordion Info Sections *@
                <div class="border-b">
                    <AccordionCn Type="AccordionType.Single" Class="px-4">
                        <AccordionItemCn>
                            <AccordionTriggerCn Class="py-3 text-xs font-medium">
                                Details &amp; Care
                            </AccordionTriggerCn>
                            <AccordionContentCn Class="pb-3 text-xs leading-relaxed text-muted-foreground">
                                <ul class="list-inside list-disc space-y-1">
                                    <li>100% Australian Merino wool</li>
                                    <li>Fine gauge knit, 12GG</li>
                                    <li>Ribbed cuffs, hem, and neckline</li>
                                    <li>Hand wash cold or dry clean</li>
                                    <li>Lay flat to dry</li>
                                </ul>
                            </AccordionContentCn>
                        </AccordionItemCn>
                        <AccordionItemCn>
                            <AccordionTriggerCn Class="py-3 text-xs font-medium">
                                Shipping &amp; Returns
                            </AccordionTriggerCn>
                            <AccordionContentCn Class="pb-3 text-xs leading-relaxed text-muted-foreground">
                                <ul class="list-inside list-disc space-y-1">
                                    <li>Free standard shipping on orders over $100</li>
                                    <li>Express shipping: 2-3 business days ($15)</li>
                                    <li>Free returns within 30 days</li>
                                    <li>Items must be unworn with tags attached</li>
                                </ul>
                            </AccordionContentCn>
                        </AccordionItemCn>
                        <AccordionItemCn Class="border-b-0">
                            <AccordionTriggerCn Class="py-3 text-xs font-medium">
                                Size &amp; Fit
                            </AccordionTriggerCn>
                            <AccordionContentCn Class="pb-3 text-xs leading-relaxed text-muted-foreground">
                                <ul class="list-inside list-disc space-y-1">
                                    <li>Model is 5&apos;10&quot; wearing size S</li>
                                    <li>Regular fit, true to size</li>
                                    <li>27&quot; length (size M)</li>
                                    <li>Consider sizing up for a relaxed fit</li>
                                </ul>
                            </AccordionContentCn>
                        </AccordionItemCn>
                    </AccordionCn>
                </div>

                @* Action Buttons *@
                <div class="flex items-center gap-2 px-4 py-3">
                    <ButtonCn Class="h-8 flex-1 text-xs" Size="ButtonSize.Sm">
                        <LucideShoppingBagCn Size="16" Class="mr-1.5 size-3.5" />
                        Add to Cart
                    </ButtonCn>
                    <ButtonCn Class="size-8" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline" @onclick="() => _isWishlisted = !_isWishlisted" aria-label="Like">
                        <LucideHeartCn Size="16" Class="@Cn.Merge("size-3.5", _isWishlisted ? "fill-current text-red-500" : "")" />
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Similar Items *@
        <div class="px-4 py-3">
            <span class="mb-3 block text-xs font-medium text-muted-foreground">
                You may also like
            </span>
            <div class="grid grid-cols-4 gap-3">
                @foreach (var item in _similarItems)
                {
                    <a class="group" href="#">
                        <div class="mb-1.5 flex aspect-square items-center justify-center rounded-md border bg-muted/50">
                            <LucidePackageCn Size="16" Class="size-5 text-muted-foreground/60" />
                        </div>
                        <span class="block truncate text-xs font-medium">@item.Name</span>
                        <span class="text-xs tabular-nums text-muted-foreground">$@item.Price</span>
                    </a>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ColorOption(string Value, string Label, string Hex);
    private record SizeOption(string Value, string Label, bool Available);
    private record SimilarItem(int Id, string Name, int Price);

    private static readonly ColorOption[] _colors =
    {
        new("black", "Black", "#1a1a1a"),
        new("navy", "Navy", "#1e3a5f"),
        new("camel", "Camel", "#c19a6b"),
        new("ivory", "Ivory", "#f5f0e8")
    };

    private static readonly SizeOption[] _sizes =
    {
        new("xs", "XS", true),
        new("s", "S", true),
        new("m", "M", true),
        new("l", "L", true),
        new("xl", "XL", true),
        new("xxl", "XXL", false)
    };

    private static readonly SimilarItem[] _similarItems =
    {
        new(1, "Ribbed Knit Cardigan", 98),
        new(2, "Cashmere Crewneck", 195),
        new(3, "Wool Blend Turtleneck", 115),
        new(4, "Cotton Half-Zip", 89)
    };

    private string _selectedColor = "black";
    private string _selectedSize = "m";
    private bool _isWishlisted;
}
