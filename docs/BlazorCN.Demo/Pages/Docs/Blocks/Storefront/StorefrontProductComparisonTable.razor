@* ============================================================
   Block: storefront-product-comparison-table
   Title: Storefront Product Comparison Table
   Description: Side-by-side product comparison table with feature checks, prices, ratings, and add-to-cart per product
   Dependencies: ButtonCn, LucideCheckCn, LucideLoader2Cn, LucidePackageCn, LucideShoppingCartCn, LucideXCn
   Source: original/blocks/storefront/storefront-product-comparison-table.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Compare Headphones</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Side-by-side feature comparison</p>
        </div>

        @* Product Headers *@
        <div class="grid grid-cols-4 border-b">
            <div class="px-4 py-3">
                <span class="text-xs font-medium text-muted-foreground">Feature</span>
            </div>
            @foreach (var product in _products)
            {
                <div class="border-l px-4 py-3 text-center">
                    <div class="mx-auto mb-2 flex size-12 items-center justify-center rounded-md bg-muted/50">
                        <LucidePackageCn Size="16" Class="size-4 text-muted-foreground/60" />
                    </div>
                    <p class="text-sm font-medium">@product.Name</p>
                    <p class="mt-0.5 text-sm font-semibold tabular-nums">$@product.Price</p>
                </div>
            }
        </div>

        @* Rating Row *@
        <div class="grid grid-cols-4 border-b">
            <div class="flex items-center px-4 py-2.5">
                <span class="text-xs font-medium text-muted-foreground">Rating</span>
            </div>
            @foreach (var product in _products)
            {
                <div class="flex items-center justify-center gap-1.5 border-l px-4 py-2.5">
                    <span class="text-sm font-medium tabular-nums">@product.Rating</span>
                    <span class="text-xs text-muted-foreground">/ 5</span>
                    <span class="text-xs text-muted-foreground">(@product.ReviewCount.ToString("N0"))</span>
                </div>
            }
        </div>

        @* Feature Rows *@
        @for (var fi = 0; fi < _featureKeys.Length; fi++)
        {
            var key = _featureKeys[fi];
            var label = _featureLabels[fi];
            var isLast = fi == _featureKeys.Length - 1;
            <div class="@Cn.Merge("grid grid-cols-4", !isLast ? "border-b" : "")">
                <div class="flex items-center px-4 py-2.5">
                    <span class="text-xs font-medium text-muted-foreground">@label</span>
                </div>
                @foreach (var product in _products)
                {
                    var hasFeature = product.Features.Contains(key);
                    <div class="flex items-center justify-center border-l px-4 py-2.5">
                        @if (hasFeature)
                        {
                            <LucideCheckCn Size="16" Class="size-4 text-emerald-600" />
                        }
                        else
                        {
                            <LucideXCn Size="16" Class="size-4 text-muted-foreground/40" />
                        }
                    </div>
                }
            </div>
        }

        @* Add to Cart Row *@
        <div class="grid grid-cols-4 border-t">
            <div class="px-4 py-3"></div>
            @foreach (var product in _products)
            {
                <div class="flex items-center justify-center border-l px-4 py-3">
                    <ButtonCn Class="h-8 gap-1.5 px-3 text-xs" Disabled="@(_addingToCart == product.Id)" Variant="ButtonVariant.Outline" @onclick="() => HandleAddToCart(product.Id)">
                        @if (_addingToCart == product.Id)
                        {
                            <LucideLoader2Cn Size="16" Class="size-3.5 animate-spin" />
                            <text>Adding</text>
                        }
                        else
                        {
                            <LucideShoppingCartCn Size="16" Class="size-3.5" />
                            <text>Add to Cart</text>
                        }
                    </ButtonCn>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ProductInfo(string Id, string Name, int Price, decimal Rating, int ReviewCount, HashSet<string> Features);

    private static readonly string[] _featureKeys = { "wireless", "noiseCancellation", "waterResistant", "fastCharging", "multiDevice", "appSupport", "warranty", "foldable" };
    private static readonly string[] _featureLabels = { "Wireless", "Noise Cancellation", "Water Resistant", "Fast Charging", "Multi-Device Pairing", "Companion App", "2+ Year Warranty", "Foldable Design" };

    private static readonly ProductInfo[] _products =
    {
        new("studio-pro", "Studio Pro", 349, 4.8m, 1243, new() { "wireless", "noiseCancellation", "fastCharging", "multiDevice", "appSupport", "warranty", "foldable" }),
        new("sport-elite", "Sport Elite", 199, 4.5m, 876, new() { "wireless", "waterResistant", "fastCharging", "appSupport" }),
        new("daily-comfort", "Daily Comfort", 89, 4.2m, 2104, new() { "wireless", "warranty", "foldable" })
    };

    private string? _addingToCart;

    private async Task HandleAddToCart(string productId)
    {
        _addingToCart = productId;
        StateHasChanged();
        await Task.Delay(1200);
        _addingToCart = null;
    }
}
