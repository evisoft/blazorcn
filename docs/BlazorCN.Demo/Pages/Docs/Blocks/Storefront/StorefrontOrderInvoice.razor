@* ============================================================
   Block: storefront-order-invoice
   Title: Storefront Order Invoice
   Description: Downloadable order invoice with line items, tax breakdown, billing and shipping addresses, invoice number, and receipt-style layout
   Dependencies: ButtonCn, LucideCheckCn, LucideCopyCn, LucideDownloadCn, LucideFileTextCn
   Source: original/blocks/storefront/storefront-order-invoice.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideFileTextCn Size="16" Class="size-4 text-muted-foreground" />
                    <h2 class="text-sm font-medium">Invoice</h2>
                </div>
                <ButtonCn Class="h-7 gap-1 px-2 text-xs" Variant="ButtonVariant.Outline">
                    <LucideDownloadCn Size="16" Class="size-3" />
                    Download PDF
                </ButtonCn>
            </div>
        </div>

        @* Invoice Meta *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-mono text-sm font-medium">@InvoiceNumber</span>
                <ButtonCn Class="h-5 gap-1 px-1.5 text-xs" Variant="ButtonVariant.Ghost" @onclick="HandleCopy">
                    @if (_copied)
                    {
                        <LucideCheckCn Size="16" Class="size-3" />
                        <text>Copied</text>
                    }
                    else
                    {
                        <LucideCopyCn Size="16" Class="size-3" />
                        <text>Copy</text>
                    }
                </ButtonCn>
            </div>
            <div class="mt-1.5 flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Paid
                </span>
                <span class="text-xs text-muted-foreground">&middot;</span>
                <span class="text-xs text-muted-foreground">Issued @IssueDate</span>
                <span class="text-xs text-muted-foreground">&middot;</span>
                <span class="text-xs text-muted-foreground">Paid @PaidDate</span>
            </div>
        </div>

        @* Addresses *@
        <div class="grid grid-cols-2 border-b">
            <div class="border-r px-4 py-3">
                <span class="text-xs font-medium text-muted-foreground">Bill to</span>
                <div class="mt-1">
                    <p class="text-sm">@BillingName</p>
                    <p class="text-xs text-muted-foreground">@BillingCompany</p>
                    <p class="text-xs text-muted-foreground">@BillingLine1</p>
                    <p class="text-xs text-muted-foreground">@BillingCity, @BillingState @BillingZip</p>
                    <p class="text-xs text-muted-foreground">@BillingCountry</p>
                </div>
            </div>
            <div class="px-4 py-3">
                <span class="text-xs font-medium text-muted-foreground">Ship to</span>
                <div class="mt-1">
                    <p class="text-sm">@ShippingName</p>
                    <p class="text-xs text-muted-foreground">@ShippingLine1</p>
                    <p class="text-xs text-muted-foreground">@ShippingCity, @ShippingState @ShippingZip</p>
                    <p class="text-xs text-muted-foreground">@ShippingCountry</p>
                </div>
            </div>
        </div>

        @* Line Items Header *@
        <div class="border-b px-4 py-2">
            <div class="grid grid-cols-[1fr,80px,80px,80px] gap-2">
                <span class="text-xs font-medium text-muted-foreground">Item</span>
                <span class="text-right text-xs font-medium text-muted-foreground">Qty</span>
                <span class="text-right text-xs font-medium text-muted-foreground">Unit Price</span>
                <span class="text-right text-xs font-medium text-muted-foreground">Total</span>
            </div>
        </div>

        @* Line Items *@
        @for (var i = 0; i < _items.Length; i++)
        {
            var item = _items[i];
            var isLast = i == _items.Length - 1;
            <div class="@Cn.Merge("px-4 py-2.5", !isLast ? "border-b" : "")">
                <div class="grid grid-cols-[1fr,80px,80px,80px] items-center gap-2">
                    <div>
                        <p class="text-sm font-medium">@item.Name</p>
                        <p class="font-mono text-xs text-muted-foreground">@item.Sku</p>
                    </div>
                    <span class="text-right text-sm tabular-nums">@item.Quantity</span>
                    <span class="text-right text-sm tabular-nums">$@item.UnitPrice.ToString("F2")</span>
                    <span class="text-right text-sm font-medium tabular-nums">$@((item.UnitPrice * item.Quantity).ToString("F2"))</span>
                </div>
            </div>
        }

        @* Cost Breakdown *@
        <div class="border-t px-4 py-3">
            <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Subtotal</span>
                    <span class="text-xs tabular-nums">$@Subtotal.ToString("F2")</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Shipping</span>
                    <span class="text-xs tabular-nums">$@Shipping.ToString("F2")</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Tax (@((TaxRate * 100).ToString("F0"))%)</span>
                    <span class="text-xs tabular-nums">$@Tax.ToString("F2")</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Promo discount</span>
                    <span class="text-xs tabular-nums text-emerald-600 dark:text-emerald-400">-$@Discount.ToString("F2")</span>
                </div>
            </div>
            <div class="mt-2 border-t pt-2">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium">Total</span>
                    <span class="text-2xl font-semibold tabular-nums">$@Total.ToString("F2")</span>
                </div>
            </div>
        </div>

        @* Payment Info *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-xs text-muted-foreground">Paid via @PaymentMethodText</span>
                <span class="text-xs text-muted-foreground">@PaidDate</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record InvoiceItem(int Id, string Name, string Sku, int Quantity, decimal UnitPrice);

    private const string InvoiceNumber = "INV-2026-0483";
    private const string IssueDate = "Mar 14, 2026";
    private const string PaidDate = "Mar 14, 2026";
    private const string PaymentMethodText = "Visa ending in 4242";

    private const string BillingName = "Alex Johnson";
    private const string BillingCompany = "Acme Corp";
    private const string BillingLine1 = "742 Evergreen Terrace";
    private const string BillingCity = "Portland";
    private const string BillingState = "OR";
    private const string BillingZip = "97201";
    private const string BillingCountry = "United States";

    private const string ShippingName = "Alex Johnson";
    private const string ShippingLine1 = "742 Evergreen Terrace";
    private const string ShippingCity = "Portland";
    private const string ShippingState = "OR";
    private const string ShippingZip = "97201";
    private const string ShippingCountry = "United States";

    private static readonly InvoiceItem[] _items =
    {
        new(1, "Merino Wool Crewneck", "MWC-CHR-M", 1, 145m),
        new(2, "Canvas Low-Top Sneakers", "CLT-WHT-10", 2, 98m),
        new(3, "Leather Weekend Bag", "LWB-TAN-OS", 1, 295m)
    };

    private static readonly decimal Subtotal = _items.Sum(i => i.UnitPrice * i.Quantity);
    private const decimal Shipping = 12m;
    private const decimal TaxRate = 0.08m;
    private static readonly decimal Tax = Math.Round(Subtotal * TaxRate, 2);
    private const decimal Discount = 50m;
    private static readonly decimal Total = Subtotal + Shipping + Tax - Discount;

    private bool _copied;

    private async Task HandleCopy()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
