@* ============================================================
   Block: storefront-order-history
   Title: Storefront Order History
   Description: Storefront order history with expandable rows showing order details, status indicators, and reorder actions
   Dependencies: ButtonCn, LucideChevronRightCn, LucidePackageCn, LucideRotateCcwCn
   Source: original/blocks/storefront/storefront-order-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="text-sm font-medium">Order History</h2>
                <p class="text-xs text-muted-foreground">@_orders.Length orders</p>
            </div>
            <div class="flex gap-1">
                @foreach (var option in _filterOptions)
                {
                    <ButtonCn Class="@Cn.Merge("h-7 px-2 text-xs capitalize", _filter == option ? "bg-muted" : "")"
                              Variant="ButtonVariant.Ghost"
                              @onclick="() => _filter = option">
                        @option
                    </ButtonCn>
                }
            </div>
        </div>

        @* Orders *@
        @if (FilteredOrders.Length == 0)
        {
            <div class="px-4 py-12 text-center">
                <LucidePackageCn Size="16" Class="mx-auto mb-2 size-5 text-muted-foreground/60" />
                <p class="text-sm text-muted-foreground">No orders found</p>
            </div>
        }
        else
        {
            @for (var idx = 0; idx < FilteredOrders.Length; idx++)
            {
                var order = FilteredOrders[idx];
                var isExpanded = _expandedId == order.Id;
                var statusLabel = GetStatusLabel(order.Status);
                var statusColor = GetStatusColor(order.Status);
                var isLastOrder = idx == FilteredOrders.Length - 1;

                <div>
                    @* Order Row *@
                    <button class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", !isLastOrder && !isExpanded ? "border-b" : "", isExpanded ? "border-b" : "")"
                            type="button"
                            @onclick="() => ToggleExpanded(order.Id)">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-mono text-sm font-medium">@order.Id</span>
                                <span class="@Cn.Merge("size-1.5 rounded-full", statusColor)" />
                                <span class="text-xs text-muted-foreground">@statusLabel</span>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                @order.Date &middot; @order.Items.Length @(order.Items.Length == 1 ? "item" : "items")
                            </p>
                        </div>
                        <span class="shrink-0 text-sm font-medium tabular-nums">$@order.Total</span>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @* Expanded Items *@
                    @if (isExpanded)
                    {
                        <div class="@(!isLastOrder ? "border-b" : "")">
                            <div class="bg-muted/30">
                                @for (var i = 0; i < order.Items.Length; i++)
                                {
                                    var item = order.Items[i];
                                    var isLastItem = i == order.Items.Length - 1;
                                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 pl-8", !isLastItem ? "border-b border-border/50" : "")">
                                        <div class="flex size-8 shrink-0 items-center justify-center rounded bg-muted/50">
                                            <LucidePackageCn Size="16" Class="size-3 text-muted-foreground/60" />
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <p class="text-sm font-medium">@item.Name</p>
                                            <p class="text-xs text-muted-foreground">@item.Variant</p>
                                        </div>
                                        <span class="shrink-0 text-sm tabular-nums">$@item.Price</span>
                                    </div>
                                }
                            </div>
                            <div class="flex justify-end border-t border-border/50 bg-muted/30 px-4 py-2">
                                <ButtonCn Class="h-7 gap-1 px-2 text-xs" Variant="ButtonVariant.Ghost">
                                    <LucideRotateCcwCn Size="16" Class="size-3" />
                                    Reorder
                                </ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</section>

@code {
    private record OrderItem(int Id, string Name, string Variant, int Price);
    private record OrderInfo(string Id, string Date, int Total, string Status, OrderItem[] Items);

    private static readonly string[] _filterOptions = { "all", "delivered", "shipped", "processing" };

    private static readonly OrderInfo[] _orders =
    {
        new("ORD-4821", "Mar 12, 2026", 243, "delivered", new OrderItem[]
        {
            new(1, "Merino Wool Crewneck", "Charcoal / M", 145),
            new(2, "Canvas Low-Top Sneakers", "White / 10", 98)
        }),
        new("ORD-4798", "Mar 5, 2026", 295, "shipped", new OrderItem[]
        {
            new(3, "Leather Weekend Bag", "Tan / One Size", 295)
        }),
        new("ORD-4756", "Feb 28, 2026", 300, "delivered", new OrderItem[]
        {
            new(4, "Cashmere Scarf", "Navy", 175),
            new(5, "Linen Button-Down Shirt", "White / L", 125)
        }),
        new("ORD-4734", "Feb 20, 2026", 89, "processing", new OrderItem[]
        {
            new(6, "Slim Fit Chinos", "Khaki / 32", 89)
        }),
        new("ORD-4701", "Feb 14, 2026", 220, "delivered", new OrderItem[]
        {
            new(7, "Suede Chelsea Boots", "Brown / 10", 220)
        })
    };

    private string? _expandedId;
    private string _filter = "all";

    private OrderInfo[] FilteredOrders => _filter == "all"
        ? _orders
        : _orders.Where(o => o.Status == _filter).ToArray();

    private void ToggleExpanded(string orderId) =>
        _expandedId = _expandedId == orderId ? null : orderId;

    private static string GetStatusLabel(string status) => status switch
    {
        "delivered" => "Delivered",
        "shipped" => "Shipped",
        "processing" => "Processing",
        _ => status
    };

    private static string GetStatusColor(string status) => status switch
    {
        "delivered" => "bg-emerald-500",
        "shipped" => "bg-amber-500",
        "processing" => "bg-blue-500",
        _ => "bg-muted-foreground"
    };
}
