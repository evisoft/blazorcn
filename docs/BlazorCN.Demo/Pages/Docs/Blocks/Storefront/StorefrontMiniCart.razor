@* ============================================================
   Block: storefront-mini-cart
   Title: Storefront Mini Cart
   Description: Mini cart sidebar block with line items, free shipping progress bar, product upsell, and checkout actions
   Dependencies: ButtonCn, ProgressCn, LucidePackageCn, LucidePlusCn, LucideShoppingBagCn, LucideXCn
   Source: original/blocks/storefront/storefront-mini-cart.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideShoppingBagCn Size="16" Class="size-4 text-muted-foreground" />
                    <h1 class="text-sm font-medium">Cart (@ItemCount)</h1>
                </div>
                <ButtonCn Class="size-6 text-muted-foreground" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost">
                    <LucideXCn Size="16" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>

        @if (_items.Count > 0)
        {
            @* Cart Items *@
            <div>
                @for (var i = 0; i < _items.Count; i++)
                {
                    var item = _items[i];
                    var isLast = i == _items.Count - 1;
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", !isLast ? "border-b" : "")">
                        <div class="flex size-12 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucidePackageCn Size="16" Class="size-4 text-muted-foreground/60" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@item.Name</span>
                            <p class="mt-0.5 text-xs text-muted-foreground">@item.Variant &middot; Qty @item.Quantity</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium tabular-nums">$@(item.Price * item.Quantity)</span>
                            <ButtonCn Class="size-6 text-muted-foreground" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" @onclick="() => RemoveItem(item.Id)">
                                <LucideXCn Size="16" Class="size-3" />
                            </ButtonCn>
                        </div>
                    </div>
                }
            </div>

            @* Subtotal *@
            <div class="border-t px-4 py-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Subtotal</span>
                    <span class="text-sm font-medium tabular-nums">$@Subtotal</span>
                </div>
            </div>

            @* Free Shipping Progress *@
            <div class="border-t px-4 py-3">
                @if (HasFreeShipping)
                {
                    <p class="text-xs text-emerald-600 dark:text-emerald-400">You've unlocked free shipping!</p>
                }
                else
                {
                    <p class="mb-2 text-xs text-muted-foreground">
                        Add <span class="font-medium text-foreground tabular-nums">$@AmountToFreeShipping</span> more for free shipping
                    </p>
                    <ProgressCn Value="@ShippingProgress" Class="h-1.5" />
                }
            </div>

            @* Upsell *@
            <div class="border-t px-4 py-3">
                <span class="mb-2 block text-xs font-medium text-muted-foreground">You might also like</span>
                <div class="flex items-center gap-3">
                    <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        <LucidePackageCn Size="16" Class="size-3.5 text-muted-foreground/60" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="text-xs font-medium">Cashmere Scarf</span>
                        <p class="text-xs text-muted-foreground tabular-nums">$78</p>
                    </div>
                    <ButtonCn Class="h-7 gap-1 px-2 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                        <LucidePlusCn Size="16" Class="size-3" />
                        Add
                    </ButtonCn>
                </div>
            </div>

            @* Actions *@
            <div class="border-t px-4 py-3">
                <div class="flex gap-2">
                    <ButtonCn Class="h-8 flex-1 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                        View Cart
                    </ButtonCn>
                    <ButtonCn Class="h-8 flex-1 text-xs" Size="ButtonSize.Sm">
                        Checkout
                    </ButtonCn>
                </div>
            </div>
        }
        else
        {
            <div class="px-4 py-12 text-center">
                <LucideShoppingBagCn Size="16" Class="mx-auto mb-2 size-6 text-muted-foreground/40" />
                <p class="text-sm font-medium">Your cart is empty</p>
                <p class="mt-1 text-xs text-muted-foreground">Add items to get started</p>
            </div>
        }
    </div>
</section>

@code {
    private record CartItem(int Id, string Name, string Variant, int Quantity, int Price);

    private const int FreeShippingThreshold = 150;

    private List<CartItem> _items = new()
    {
        new(1, "Merino Wool Crewneck", "Black / M", 1, 145),
        new(2, "Cotton Chino Shorts", "Khaki / 32", 1, 65),
        new(3, "Leather Belt", "Brown / One Size", 1, 48)
    };

    private int Subtotal => _items.Sum(i => i.Price * i.Quantity);
    private int ItemCount => _items.Sum(i => i.Quantity);
    private int AmountToFreeShipping => FreeShippingThreshold - Subtotal;
    private int ShippingProgress => (int)Math.Min(100, (double)Subtotal / FreeShippingThreshold * 100);
    private bool HasFreeShipping => Subtotal >= FreeShippingThreshold;

    private void RemoveItem(int id)
    {
        _items.RemoveAll(i => i.Id == id);
    }
}
