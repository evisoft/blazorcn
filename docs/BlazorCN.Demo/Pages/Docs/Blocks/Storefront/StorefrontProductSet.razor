@* ============================================================
   Block: storefront-product-set
   Title: Storefront Product Set
   Description: Curated product set with shop-the-look items, individual prices, set discount, total comparison, and add-set-to-cart for e-commerce stores
   Dependencies: ButtonCn, CheckboxCn, LucideCheckCn, LucideMinusCn, LucidePackageCn, LucidePlusCn, LucideShoppingBagCn
   Source: original/blocks/storefront/storefront-product-set.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideShoppingBagCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <h2 class="text-sm font-medium">@SetName</h2>
                    <p class="text-xs text-muted-foreground">@SetDescription</p>
                </div>
            </div>
        </div>

        @* Set Discount Banner *@
        <div class="border-b px-4 py-2">
            <div class="flex items-center justify-between">
                <span class="text-xs text-muted-foreground">
                    @SelectedItems.Length of @_items.Length items selected
                </span>
                @if (HasDiscount)
                {
                    <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">
                        @SetDiscount% set discount applied
                    </span>
                }
                else if (SelectedItems.Length > 0)
                {
                    <span class="text-xs text-muted-foreground">
                        Select 2+ items for @SetDiscount% off
                    </span>
                }
            </div>
        </div>

        @* Items List *@
        <div>
            @for (var i = 0; i < _items.Length; i++)
            {
                var item = _items[i];
                var isSelected = _selected.Contains(item.Id);
                var isLast = i == _items.Length - 1;
                <div class="@(!isLast ? "border-b" : "")">
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors", !isSelected ? "opacity-50" : "")">
                        <CheckboxCn Checked="@isSelected" CheckedChanged="() => ToggleItem(item.Id)" aria-label="@($"Include {item.Name} in set")" />
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucidePackageCn Size="16" Class="size-3.5 text-muted-foreground/60" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium">@item.Name</p>
                            <p class="text-xs text-muted-foreground">@item.Category</p>
                        </div>
                        <span class="shrink-0 text-sm font-medium tabular-nums">$@item.Price.ToString("N0")</span>
                    </div>
                </div>
            }
        </div>

        @* Price Summary *@
        <div class="border-t px-4 py-3">
            <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Subtotal</span>
                    <span class="text-xs tabular-nums text-muted-foreground">$@OriginalTotal.ToString("N0")</span>
                </div>
                @if (HasDiscount)
                {
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-muted-foreground">Set discount (@SetDiscount%)</span>
                        <span class="text-xs tabular-nums text-emerald-600 dark:text-emerald-400">
                            <LucideMinusCn Size="16" Class="mr-0.5 inline size-2.5" />$@DiscountAmount.ToString("F2")
                        </span>
                    </div>
                }
                <div class="flex items-center justify-between border-t pt-1.5">
                    <span class="text-sm font-medium">Total</span>
                    <div class="text-right">
                        <span class="text-2xl font-semibold tabular-nums">$@FinalTotal.ToString("F2")</span>
                        @if (HasDiscount)
                        {
                            <p class="text-xs text-muted-foreground line-through tabular-nums">$@OriginalTotal.ToString("N0")</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* Add to Cart *@
        <div class="border-t px-4 py-3">
            @if (_added)
            {
                <div class="flex items-center justify-center gap-2 py-1">
                    <LucideCheckCn Size="16" Class="size-4 text-emerald-500" />
                    <span class="text-sm font-medium">@SelectedItems.Length items added to cart</span>
                </div>
            }
            else
            {
                <ButtonCn Class="h-8 w-full gap-2 text-xs" Size="ButtonSize.Sm" Disabled="@(SelectedItems.Length == 0)" @onclick="() => _added = true">
                    <LucidePlusCn Size="16" Class="size-3.5" />
                    Add @(SelectedItems.Length > 0 ? $"{SelectedItems.Length} Items" : "Items") to Cart
                </ButtonCn>
            }
        </div>
    </div>
</section>

@code {
    private record SetItem(string Id, string Name, string Category, int Price);

    private const string SetName = "Coastal Living Room";
    private const string SetDescription = "A curated collection of 4 pieces for a relaxed, modern living space.";
    private const int SetDiscount = 15;

    private static readonly SetItem[] _items =
    {
        new("item-1", "Linen Sectional Sofa", "Seating", 2499),
        new("item-2", "Rattan Coffee Table", "Tables", 649),
        new("item-3", "Ceramic Table Lamp", "Lighting", 189),
        new("item-4", "Woven Throw Blanket", "Textiles", 79)
    };

    private HashSet<string> _selected = new(_items.Select(i => i.Id));
    private bool _added;

    private SetItem[] SelectedItems => _items.Where(i => _selected.Contains(i.Id)).ToArray();
    private decimal OriginalTotal => SelectedItems.Sum(i => (decimal)i.Price);
    private bool HasDiscount => SelectedItems.Length >= 2;
    private decimal DiscountAmount => HasDiscount ? Math.Round(OriginalTotal * SetDiscount / 100m, 2) : 0;
    private decimal FinalTotal => Math.Round(OriginalTotal - DiscountAmount, 2);

    private void ToggleItem(string id)
    {
        if (!_selected.Remove(id))
            _selected.Add(id);
        _added = false;
    }
}
