@* ============================================================
   Block: storefront-bundles
   Title: Storefront Bundles
   Description: Storefront bundle builder with curated bundles and interactive build-your-own kit using tabs
   Dependencies: ButtonCn, LucideCheckCn, LucideLoader2Cn, LucidePackageCn, LucideShoppingBagCn, TabsCn, TabsContentCn, TabsListCn, TabsTriggerCn
   Source: original/blocks/storefront/storefront-bundles.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h1 class="text-sm font-medium">Bundle & Save</h1>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Curated sets and build-your-own bundles with 15% off
            </p>
        </div>

        @* Curated Bundles *@
        <div>
            @foreach (var bundle in _curatedBundles)
            {
                var savingsPercent = (int)Math.Round((double)(bundle.OriginalPrice - bundle.BundlePrice) / bundle.OriginalPrice * 100);
                <div class="flex items-center gap-3 border-b px-4 py-3 transition-colors hover:bg-muted/50">
                    @* Product Thumbnails *@
                    <div class="flex shrink-0 -space-x-2">
                        @foreach (var item in bundle.Items)
                        {
                            <div class="flex size-10 items-center justify-center rounded-md border-2 border-background bg-muted/50">
                                <LucidePackageCn Size="16" Class="size-3.5 text-muted-foreground/60" />
                            </div>
                        }
                    </div>

                    @* Bundle Info *@
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@bundle.Name</span>
                            <span class="text-xs text-muted-foreground">@bundle.Items.Length items</span>
                        </div>
                        <div class="flex items-baseline gap-2">
                            <span class="text-sm font-semibold tabular-nums">$@bundle.BundlePrice</span>
                            <span class="text-xs text-muted-foreground line-through tabular-nums">$@bundle.OriginalPrice</span>
                            <span class="text-xs text-muted-foreground">@savingsPercent% off</span>
                        </div>
                    </div>

                    @* Add Bundle Button *@
                    <ButtonCn Class="h-7 shrink-0 px-3 text-xs" disabled="@(_addingBundle == bundle.Id)" Variant="ButtonVariant.Outline" @onclick="() => HandleAddBundle(bundle.Id)">
                        @if (_addingBundle == bundle.Id)
                        {
                            <LucideLoaderCircleCn Size="16" Class="size-3.5 animate-spin" />
                        }
                        else
                        {
                            <text>Add Bundle</text>
                        }
                    </ButtonCn>
                </div>
            }
        </div>

        @* Build Your Own Header *@
        <div class="flex items-center justify-between border-b bg-muted/30 px-4 py-3">
            <div>
                <span class="text-sm font-medium">Build Your Own</span>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Select a top + bottom to unlock 15% off
                </p>
            </div>
            @if (_selectedItems.Count > 0)
            {
                <ButtonCn Class="h-6 px-2 text-xs" Variant="ButtonVariant.Ghost" @onclick="() => _selectedItems.Clear()">
                    Clear all
                </ButtonCn>
            }
        </div>

        @* Build Your Own Tabs *@
        <div class="px-4 py-3">
            <TabsCn DefaultValue="Tops" Class="w-full">
                <TabsListCn Class="mb-3 w-full grid grid-cols-3">
                    @foreach (var category in _buildYourOwn.Keys)
                    {
                        var count = _allItems.Count(i => _selectedItems.Contains(i.Id) && i.Category == category);
                        <TabsTriggerCn Value="@category" Class="gap-1.5 text-xs">
                            @category
                            @if (count > 0)
                            {
                                <span class="flex size-4 items-center justify-center rounded-full bg-primary text-[10px] text-primary-foreground">
                                    @count
                                </span>
                            }
                        </TabsTriggerCn>
                    }
                </TabsListCn>

                @foreach (var (category, items) in _buildYourOwn)
                {
                    <TabsContentCn Value="@category" Class="mt-0 w-full">
                        <div class="overflow-hidden rounded-md border">
                            @for (var i = 0; i < items.Length; i++)
                            {
                                var item = items[i];
                                var isSelected = _selectedItems.Contains(item.Id);
                                var isLast = i == items.Length - 1;
                                <div class="@Cn.Merge("flex cursor-pointer items-center gap-3 px-3 py-2.5 transition-colors", isSelected ? "bg-primary/5" : "hover:bg-muted/50", !isLast ? "border-b" : "")"
                                     @onclick="() => ToggleItem(item.Id)" role="button" tabindex="0">
                                    <div class="flex size-10 shrink-0 items-center justify-center rounded-md border bg-muted/50">
                                        <LucidePackageCn Size="16" Class="size-3.5 text-muted-foreground/60" />
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <span class="text-sm font-medium">@item.Name</span>
                                        <p class="text-xs text-muted-foreground tabular-nums">$@item.Price</p>
                                    </div>
                                    @if (isSelected)
                                    {
                                        <div class="flex size-5 shrink-0 items-center justify-center rounded-full bg-primary text-primary-foreground">
                                            <LucideCheckCn Size="16" Class="size-3" />
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </TabsContentCn>
                }
            </TabsCn>
        </div>

        @* Summary Bar *@
        @if (SelectedProducts.Count > 0)
        {
            <div class="border-t px-4 py-3">
                <div class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-3">
                        @* Mini Thumbnails *@
                        <div class="flex shrink-0 -space-x-1.5">
                            @foreach (var product in SelectedProducts.Take(4))
                            {
                                <div class="flex size-7 items-center justify-center rounded-full border-2 border-background bg-muted/50">
                                    <LucidePackageCn Size="16" Class="size-3 text-muted-foreground/60" />
                                </div>
                            }
                            @if (SelectedProducts.Count > 4)
                            {
                                <div class="flex size-7 items-center justify-center rounded-full border-2 border-background bg-muted text-[10px] font-medium">
                                    +@(SelectedProducts.Count - 4)
                                </div>
                            }
                        </div>

                        @* Pricing *@
                        <div>
                            @if (HasCompleteBundle)
                            {
                                <div class="flex items-baseline gap-2">
                                    <span class="text-sm font-semibold tabular-nums">$@DiscountedTotal</span>
                                    <span class="text-xs text-muted-foreground line-through tabular-nums">$@OriginalTotal</span>
                                    <span class="text-xs text-muted-foreground">Save $@Savings</span>
                                </div>
                            }
                            else
                            {
                                <div>
                                    <span class="text-sm font-semibold tabular-nums">$@OriginalTotal</span>
                                    <p class="text-[10px] text-muted-foreground">
                                        Add a @(SelectedProducts.Any(p => p.Category == "Tops") ? "bottom" : "top") for 15% off
                                    </p>
                                </div>
                            }
                        </div>
                    </div>

                    <ButtonCn Class="h-7 shrink-0 px-3 text-xs" disabled="@_addingCustom" @onclick="HandleAddCustomBundle">
                        @if (_addingCustom)
                        {
                            <LucideLoaderCircleCn Size="16" Class="size-3.5 animate-spin" />
                        }
                        else
                        {
                            <LucideShoppingBagCn Size="16" Class="mr-1.5 size-3" />
                            <text>Add to Cart</text>
                        }
                    </ButtonCn>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record BundleItemInfo(string Name);
    private record CuratedBundleInfo(int Id, string Name, string Description, int OriginalPrice, int BundlePrice, BundleItemInfo[] Items);
    private record BuildItem(int Id, string Name, int Price, string Category);

    private static readonly CuratedBundleInfo[] _curatedBundles =
    {
        new(1, "Everyday Essentials", "Everything you need for daily wear", 295, 235, new[] { new BundleItemInfo("Cotton Tee"), new BundleItemInfo("Slim Chinos"), new BundleItemInfo("Canvas Sneakers") }),
        new(2, "Weekend Getaway", "Pack light, look great", 425, 340, new[] { new BundleItemInfo("Linen Shirt"), new BundleItemInfo("Swim Shorts"), new BundleItemInfo("Leather Sandals") }),
        new(3, "Office Ready", "Professional looks for less", 380, 299, new[] { new BundleItemInfo("Oxford Shirt"), new BundleItemInfo("Wool Trousers"), new BundleItemInfo("Leather Belt") })
    };

    private static readonly Dictionary<string, BuildItem[]> _buildYourOwn = new()
    {
        ["Tops"] = new[] { new BuildItem(1, "Classic White Tee", 45, "Tops"), new BuildItem(2, "Oxford Button-Down", 89, "Tops"), new BuildItem(3, "Merino Sweater", 125, "Tops") },
        ["Bottoms"] = new[] { new BuildItem(4, "Slim Chinos", 95, "Bottoms"), new BuildItem(5, "Denim Jeans", 110, "Bottoms"), new BuildItem(6, "Linen Trousers", 85, "Bottoms") },
        ["Accessories"] = new[] { new BuildItem(7, "Leather Belt", 65, "Accessories"), new BuildItem(8, "Canvas Watch", 145, "Accessories"), new BuildItem(9, "Wool Scarf", 55, "Accessories") }
    };

    private static readonly List<BuildItem> _allItems = _buildYourOwn.Values.SelectMany(v => v).ToList();

    private List<int> _selectedItems = new() { 1, 3 };
    private int? _addingBundle;
    private bool _addingCustom;

    private List<BuildItem> SelectedProducts => _allItems.Where(i => _selectedItems.Contains(i.Id)).ToList();
    private int OriginalTotal => SelectedProducts.Sum(i => i.Price);
    private bool HasCompleteBundle => SelectedProducts.Any(p => p.Category == "Tops") && SelectedProducts.Any(p => p.Category == "Bottoms");
    private int DiscountedTotal => (int)Math.Round(OriginalTotal * 0.85);
    private int Savings => OriginalTotal - DiscountedTotal;

    private void ToggleItem(int id)
    {
        if (_selectedItems.Contains(id))
            _selectedItems.Remove(id);
        else
            _selectedItems.Add(id);
    }

    private async Task HandleAddBundle(int bundleId)
    {
        _addingBundle = bundleId;
        await Task.Delay(1000);
        _addingBundle = null;
    }

    private async Task HandleAddCustomBundle()
    {
        _addingCustom = true;
        await Task.Delay(1000);
        _addingCustom = false;
        _selectedItems.Clear();
    }
}
