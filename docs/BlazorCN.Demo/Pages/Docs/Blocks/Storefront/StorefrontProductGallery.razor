@* ============================================================
   Block: storefront-product-gallery
   Title: Storefront Product Gallery
   Description: Storefront product image gallery with thumbnail switching, color variants, and product details panel
   Dependencies: ButtonCn, LucideCheckCn, LucideImageCn, LucideMinusCn, LucidePlusCn, LucideShoppingBagCn
   Source: original/blocks/storefront/storefront-product-gallery.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid md:grid-cols-2">
            @* Left: Image Gallery *@
            <div class="border-b md:border-r md:border-b-0">
                @* Main Image *@
                <div class="flex aspect-square w-full items-center justify-center bg-muted/50">
                    <LucideImageCn Size="16" Class="size-8 text-muted-foreground/60" />
                </div>

                @* Thumbnails *@
                <div class="flex gap-px border-t bg-border">
                    @for (var i = 0; i < _selectedColor.Images.Length; i++)
                    {
                        var index = i;
                        var image = _selectedColor.Images[i];
                        <button type="button"
                                class="@Cn.Merge("flex-1 overflow-hidden bg-card transition-opacity", index == _selectedImageIndex ? "opacity-100" : "opacity-60 hover:opacity-80")"
                                @onclick="() => _selectedImageIndex = index">
                            <div class="flex aspect-square w-full items-center justify-center bg-muted/50">
                                <LucideImageCn Size="16" Class="size-4 text-muted-foreground/60" />
                            </div>
                        </button>
                    }
                </div>
            </div>

            @* Right: Product Details *@
            <div class="flex flex-col">
                @* Name & Price *@
                <div class="border-b px-4 py-3">
                    <p class="text-xs text-muted-foreground">Weekend Bags</p>
                    <h2 class="mt-0.5 text-sm font-medium">@ProductName</h2>
                    <p class="mt-1 text-2xl font-semibold tabular-nums">$@ProductPrice</p>
                </div>

                @* Description *@
                <div class="border-b px-4 py-3">
                    <p class="text-xs text-muted-foreground">@ProductDescription</p>
                </div>

                @* Color Variants *@
                <div class="border-b px-4 py-3">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">Color — @_selectedColor.Name</p>
                    <div class="flex items-center gap-2">
                        @foreach (var variant in _colorVariants)
                        {
                            <button type="button"
                                    class="@Cn.Merge("flex size-7 items-center justify-center rounded-full border-2 transition-colors", _selectedColor.Id == variant.Id ? "border-foreground" : "border-transparent hover:border-muted-foreground/40")"
                                    @onclick="() => HandleColorChange(variant)">
                                <span class="@Cn.Merge("size-4 rounded-full", variant.ColorClass)"></span>
                            </button>
                        }
                    </div>
                </div>

                @* Features *@
                <div class="border-b px-4 py-3">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">Features</p>
                    <ul class="space-y-1">
                        @foreach (var feature in _features)
                        {
                            <li class="flex items-center gap-2 text-xs text-muted-foreground">
                                <LucideCheckCn Size="16" Class="size-3 shrink-0 text-emerald-500" />
                                @feature
                            </li>
                        }
                    </ul>
                </div>

                @* Quantity & Add to Cart *@
                <div class="mt-auto px-4 py-3">
                    <div class="flex items-center gap-3">
                        <div class="flex items-center gap-2">
                            <ButtonCn Class="size-7" Disabled="@(_quantity <= 1)" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline" @onclick="DecrementQuantity">
                                <LucideMinusCn Size="16" Class="size-3" />
                            </ButtonCn>
                            <span class="w-6 text-center text-sm font-medium tabular-nums">@_quantity</span>
                            <ButtonCn Class="size-7" Disabled="@(_quantity >= 10)" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline" @onclick="IncrementQuantity">
                                <LucidePlusCn Size="16" Class="size-3" />
                            </ButtonCn>
                        </div>
                        <ButtonCn Class="h-8 flex-1 gap-1.5 text-xs" Variant="ButtonVariant.Outline">
                            <LucideShoppingBagCn Size="16" Class="size-3.5" />
                            Add to Cart — $@(ProductPrice * _quantity)
                        </ButtonCn>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record GalleryImage(int Id, string Alt);
    private record ColorVariant(string Id, string Name, string ColorClass, GalleryImage[] Images);

    private const string ProductName = "Heritage Leather Weekend Bag";
    private const int ProductPrice = 295;
    private const string ProductDescription = "Full-grain vegetable-tanned leather duffle with brass hardware. Spacious interior with padded laptop sleeve and multiple organizer pockets. Reinforced handles and detachable shoulder strap.";

    private static readonly ColorVariant[] _colorVariants =
    {
        new("black", "Black", "bg-zinc-900", new GalleryImage[]
        {
            new(1, "Leather bag front view"),
            new(2, "Leather bag side view"),
            new(3, "Leather bag detail"),
            new(4, "Leather bag open")
        }),
        new("tan", "Tan", "bg-amber-700", new GalleryImage[]
        {
            new(5, "Tan leather bag front"),
            new(6, "Tan leather bag detail"),
            new(7, "Tan leather bag side"),
            new(8, "Tan leather bag open")
        })
    };

    private static readonly string[] _features =
    {
        "Full-grain vegetable-tanned leather",
        "Brass YKK zippers and hardware",
        "Padded 15\" laptop compartment",
        "Cotton twill lining",
        "Lifetime warranty"
    };

    private ColorVariant _selectedColor = _colorVariants[0];
    private int _selectedImageIndex;
    private int _quantity = 1;

    private void HandleColorChange(ColorVariant variant)
    {
        _selectedColor = variant;
        _selectedImageIndex = 0;
    }

    private void DecrementQuantity() => _quantity = Math.Max(1, _quantity - 1);
    private void IncrementQuantity() => _quantity = Math.Min(10, _quantity + 1);
}
