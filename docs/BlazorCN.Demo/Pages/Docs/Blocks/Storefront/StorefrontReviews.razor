@* ============================================================
   Block: storefront-reviews
   Title: Storefront Reviews
   Description: Product reviews section with rating breakdown, progress bars, and customer feedback rows
   Dependencies: ButtonCn, LucideThumbsUpCn, ProgressCn
   Source: original/blocks/storefront/storefront-reviews.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-baseline gap-2">
                <h1 class="text-sm font-medium">Customer Reviews</h1>
                <span class="text-xs text-muted-foreground">
                    @TotalReviews reviews, @AverageRating average
                </span>
            </div>
        </div>

        @* Rating Summary *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-4">
                <span class="text-2xl font-semibold tabular-nums">@AverageRating</span>
                <div class="flex-1 space-y-1">
                    @foreach (var item in _ratingBreakdown)
                    {
                        <button type="button"
                                class="@Cn.Merge("flex w-full items-center gap-2 rounded px-1 py-0.5 text-xs transition-colors hover:bg-muted/50", _filter == item.Stars ? "bg-muted" : "")"
                                @onclick="@(() => _filter = _filter == item.Stars ? null : item.Stars)">
                            <span class="w-10 text-left text-muted-foreground">@item.Stars star</span>
                            <ProgressCn Class="h-1.5 flex-1" Value="@item.Percentage" />
                            <span class="w-6 text-right tabular-nums text-muted-foreground">
                                @item.Count
                            </span>
                        </button>
                    }
                </div>
            </div>
        </div>

        @* Active Filter *@
        @if (_filter.HasValue)
        {
            <div class="border-b px-4 py-2">
                <div class="flex items-center gap-2">
                    <span class="text-xs text-muted-foreground">Filtered by:</span>
                    <span class="rounded bg-muted px-1.5 py-0.5 text-[10px] font-medium">
                        @_filter star
                    </span>
                    <button type="button"
                            class="text-xs text-muted-foreground hover:text-foreground"
                            @onclick="@(() => _filter = null)">
                        Clear
                    </button>
                </div>
            </div>
        }

        @* Reviews List *@
        <div>
            @{ var filtered = FilteredReviews; }
            @for (var i = 0; i < filtered.Length; i++)
            {
                var review = filtered[i];
                var isLast = i == filtered.Length - 1;
                <div class="@Cn.Merge("px-4 py-3", !isLast ? "border-b" : "")">
                    <div class="flex items-start gap-3">
                        @* Initials *@
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                            @GetInitials(review.Author)
                        </div>

                        <div class="min-w-0 flex-1">
                            @* Name + Verified + Date *@
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@review.Author</span>
                                @if (review.Verified)
                                {
                                    <span class="rounded bg-primary/10 px-1.5 py-0.5 text-[10px] font-medium text-primary">
                                        Verified
                                    </span>
                                }
                                <span class="text-xs text-muted-foreground">@review.Date</span>
                            </div>

                            @* Star count *@
                            <span class="text-xs text-muted-foreground">
                                @review.Rating out of 5 stars
                            </span>

                            @* Review content *@
                            <h4 class="mt-1.5 text-sm font-medium">@review.Title</h4>
                            <p class="mt-0.5 text-xs text-muted-foreground">@review.Content</p>

                            @* Helpful *@
                            <ButtonCn Class="mt-1.5 h-6 gap-1 px-2 text-xs"
                                      Disabled="@(_helpedReviews.Contains(review.Id))"
                                      Variant="ButtonVariant.Ghost"
                                      @onclick="@(() => HandleHelpful(review.Id))">
                                <LucideThumbsUpCn Size="16" Class="size-3" />
                                Helpful (@(review.Helpful + (_helpedReviews.Contains(review.Id) ? 1 : 0)))
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ReviewInfo(int Id, string Author, int Rating, string Date, string Title, string Content, int Helpful, bool Verified);
    private record RatingRow(int Stars, int Count, int Percentage);

    private const decimal AverageRating = 4.6m;
    private const int TotalReviews = 229;

    private static readonly ReviewInfo[] _reviews =
    {
        new(1, "Sarah M.", 5, "2 days ago", "Excellent quality!", "Absolutely love this product. The quality exceeded my expectations and it arrived quickly. Would definitely recommend to others.", 24, true),
        new(2, "James K.", 4, "1 week ago", "Great value for money", "Very happy with my purchase. Good quality and the price was reasonable. Shipping took a bit longer than expected but overall satisfied.", 12, true),
        new(3, "Emily R.", 5, "2 weeks ago", "Perfect fit", "Exactly what I was looking for. The size guide was accurate and the material feels premium. Will be ordering more colors.", 18, true),
        new(4, "Michael T.", 3, "3 weeks ago", "Decent product", "It\u2019s okay for the price. Nothing special but does the job. The color was slightly different from the photos.", 5, false)
    };

    private static readonly RatingRow[] _ratingBreakdown =
    {
        new(5, 156, 68),
        new(4, 52, 23),
        new(3, 14, 6),
        new(2, 5, 2),
        new(1, 2, 1)
    };

    private int? _filter;
    private HashSet<int> _helpedReviews = new();

    private ReviewInfo[] FilteredReviews => _filter.HasValue
        ? _reviews.Where(r => r.Rating == _filter.Value).ToArray()
        : _reviews;

    private void HandleHelpful(int reviewId)
    {
        _helpedReviews.Add(reviewId);
    }

    private static string GetInitials(string name) =>
        string.Concat(name.Split(' ').Select(n => n[0]));
}
