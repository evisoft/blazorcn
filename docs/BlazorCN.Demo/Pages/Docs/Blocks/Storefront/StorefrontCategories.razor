@* ============================================================
   Block: storefront-categories
   Title: Storefront Categories
   Description: Storefront category grid with product images, category names, and item counts
   Dependencies: LucideShoppingBagCn
   Source: original/blocks/storefront/storefront-categories.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h1 class="text-sm font-medium">Shop by Category</h1>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_categories.Sum(c => c.ItemCount).ToString("N0") items across @_categories.Length categories
            </p>
        </div>

        @* Connected Category Grid *@
        <div class="grid grid-cols-2 gap-px bg-border">
            @foreach (var category in _categories)
            {
                <a class="group flex flex-col bg-card transition-colors hover:bg-muted/50" href="#">
                    <div class="flex aspect-[3/4] items-center justify-center bg-muted/50">
                        <LucideShoppingBagCn Size="16" Class="size-8 text-muted-foreground/60" />
                    </div>
                    <div class="px-4 py-3">
                        <span class="text-sm font-medium">@category.Name</span>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @category.ItemCount.ToString("N0") items
                        </p>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

@code {
    private record CategoryInfo(int Id, string Name, int ItemCount);

    private static readonly CategoryInfo[] _categories =
    {
        new(1, "Women", 1247),
        new(2, "Men", 892),
        new(3, "Accessories", 634),
        new(4, "Footwear", 423)
    };
}
