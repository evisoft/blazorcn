@* ============================================================
   Block: storefront-product-dimensions
   Title: Storefront Product Dimensions
   Description: Product dimensions viewer with text-based measurement diagram, centimeter and inch unit toggle, and fit recommendation guidance for furniture, luggage, and apparel
   Dependencies: ButtonCn, LucideArrowLeftRightCn, LucideBoxCn, LucideInfoCn, LucideRulerCn
   Source: original/blocks/storefront/storefront-product-dimensions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="text-sm font-medium">@ProductName</h2>
                <p class="text-xs text-muted-foreground">Dimensions &amp; Measurements</p>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn Class="h-6 px-2 text-xs" Size="ButtonSize.Sm" Variant="@(_unit == "cm" ? ButtonVariant.Outline : ButtonVariant.Ghost)" @onclick="SetUnitCm">
                    cm
                </ButtonCn>
                <ButtonCn Class="h-6 px-2 text-xs" Size="ButtonSize.Sm" Variant="@(_unit == "in" ? ButtonVariant.Outline : ButtonVariant.Ghost)" @onclick="SetUnitIn">
                    in
                </ButtonCn>
            </div>
        </div>

        @* View Toggle *@
        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <button class="@Cn.Merge("flex items-center gap-1.5 text-xs font-medium transition-colors", _view == "product" ? "text-foreground" : "text-muted-foreground hover:text-foreground")"
                    type="button"
                    @onclick="SetViewProduct">
                <LucideRulerCn Size="16" Class="size-3" />
                Product
            </button>
            <span class="text-xs text-muted-foreground">&middot;</span>
            <button class="@Cn.Merge("flex items-center gap-1.5 text-xs font-medium transition-colors", _view == "package" ? "text-foreground" : "text-muted-foreground hover:text-foreground")"
                    type="button"
                    @onclick="SetViewPackage">
                <LucideBoxCn Size="16" Class="size-3" />
                Packaging
            </button>
        </div>

        @* Diagram *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-center rounded-md bg-muted/50 p-6">
                <div class="relative">
                    <div class="flex flex-col items-center gap-1 font-mono text-xs text-muted-foreground">
                        <div class="flex items-center gap-2">
                            <LucideArrowLeftRightCn Size="16" Class="size-3" />
                            <span class="tabular-nums">
                                @FormatDim(CurrentDims[0])
                            </span>
                        </div>
                        <div class="flex h-20 items-center gap-4 border border-dashed border-muted-foreground/30 px-12">
                            <span class="rotate-90 whitespace-nowrap text-[10px] tabular-nums">
                                @FormatDim(CurrentDims[2])
                            </span>
                        </div>
                        <div class="flex items-center gap-2">
                            <LucideArrowLeftRightCn Size="16" Class="size-3" />
                            <span class="tabular-nums">
                                @FormatDim(CurrentDims[1])
                            </span>
                            <span class="text-muted-foreground/50">(depth)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Measurements Table *@
        @for (var i = 0; i < CurrentDims.Length; i++)
        {
            var dim = CurrentDims[i];
            var isLast = i == CurrentDims.Length - 1;
            <div class="@Cn.Merge("flex items-center justify-between px-4 py-2.5", !isLast ? "border-b" : "", i % 2 == 0 ? "bg-muted/20" : "")">
                <span class="text-xs font-medium text-muted-foreground">@dim.Label</span>
                <span class="font-mono text-sm tabular-nums">@FormatDim(dim)</span>
            </div>
        }

        @* Weight & Volume *@
        <div class="flex items-center gap-4 border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="text-xs font-medium text-muted-foreground">Weight</span>
                <span class="font-mono text-sm tabular-nums">
                    @(_unit == "cm" ? $"{CurrentWeight.Kg} kg" : $"{CurrentWeight.Lb} lb")
                </span>
            </div>
            @if (_view == "product")
            {
                <span class="text-xs text-muted-foreground">&middot;</span>
                <div class="flex items-center gap-2">
                    <span class="text-xs font-medium text-muted-foreground">Volume</span>
                    <span class="font-mono text-sm tabular-nums">@Volume</span>
                </div>
            }
        </div>

        @* Fit Recommendations *@
        @if (_view == "product")
        {
            <div class="border-t px-4 py-3">
                <div class="mb-2 flex items-center gap-1.5">
                    <LucideInfoCn Size="16" Class="size-3 text-muted-foreground" />
                    <span class="text-xs font-medium text-muted-foreground">Fit Guide</span>
                </div>
                <div class="flex flex-col gap-2">
                    @foreach (var rec in _fitRecommendations)
                    {
                        <div class="flex items-start gap-2">
                            <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", rec.IsGood ? "bg-emerald-500" : "bg-amber-500")" />
                            <div class="min-w-0 flex-1">
                                <span class="text-xs font-medium">@rec.Scenario</span>
                                <p class="text-xs text-muted-foreground">@rec.Verdict</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record DimensionInfo(string Label, double Cm, double Inches);
    private record WeightInfo(double Kg, double Lb);
    private record FitRec(string Scenario, string Verdict, bool IsGood);

    private const string ProductName = "Weekender Duffel Bag \u2014 45L";
    private const string Volume = "45L";

    private static readonly DimensionInfo[] _productDims =
    {
        new("Length", 56, 22),
        new("Width", 28, 11),
        new("Height", 33, 13),
        new("Strap drop", 56, 22),
        new("Handle height", 14, 5.5)
    };

    private static readonly DimensionInfo[] _packageDims =
    {
        new("Box length", 60, 23.6),
        new("Box width", 32, 12.6),
        new("Box height", 10, 3.9)
    };

    private static readonly WeightInfo _productWeight = new(1.2, 2.6);
    private static readonly WeightInfo _packageWeight = new(1.6, 3.5);

    private static readonly FitRec[] _fitRecommendations =
    {
        new("Airline carry-on (most carriers)", "Fits within standard limits", true),
        new("Overhead bin (regional jets)", "May need to gate-check", false),
        new("Weekend trip (2-3 days)", "Ideal capacity", true),
        new("Gym / daily use", "Roomy with dedicated compartments", true)
    };

    private string _unit = "cm";
    private string _view = "product";

    private DimensionInfo[] CurrentDims => _view == "product" ? _productDims : _packageDims;
    private WeightInfo CurrentWeight => _view == "product" ? _productWeight : _packageWeight;

    private string FormatDim(DimensionInfo dim) =>
        _unit == "cm" ? $"{dim.Cm} cm" : $"{dim.Inches}\u2033";

    private void SetUnitCm() => _unit = "cm";
    private void SetUnitIn() => _unit = "in";
    private void SetViewProduct() => _view = "product";
    private void SetViewPackage() => _view = "package";
}
