@* ============================================================
   Block: storefront-delivery-slots
   Title: Storefront Delivery Slots
   Description: Delivery scheduling block with horizontal day selector, time slot radio rows with pricing, selected summary, and confirm button
   Long Description: A delivery scheduling block that reduces cart abandonment by letting customers choose their preferred delivery window. Features a horizontal row of selectable day buttons with sold-out indicators, time slot radio rows for Morning, Afternoon, and Evening with per-slot pricing, a selected delivery summary, and a confirm button. Built with the Vercel minimal aesthetic using flat sections divided by borders.
   Dependencies: ButtonCn, LabelCn, LucideCalendarCn, LucideClockCn, LucideTruckCn, RadioGroupCn, RadioGroupItemCn
   Source: original/blocks/storefront/storefront-delivery-slots.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideTruckCn Size="16" Class="size-4 text-muted-foreground" />
                    <h1 class="text-sm font-medium">Choose Delivery</h1>
                </div>
            </div>

            @* Date Selector *@
            <div class="border-b px-4 py-3">
                <div class="mb-2 flex items-center gap-1.5">
                    <LucideCalendarCn Size="16" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs font-medium text-muted-foreground">Select date</span>
                </div>
                <div class="flex gap-2 overflow-x-auto">
                    @foreach (var d in _days)
                    {
                        var day = d;
                        <button
                            class="@(Cn.Merge("flex min-w-[52px] flex-col items-center rounded-md border px-2 py-2 text-center transition-colors", day.Id == _selectedDay ? "border-primary text-primary" : day.Available ? "hover:border-foreground/50" : "cursor-not-allowed opacity-40"))"
                            disabled="@(!day.Available)"
                            @onclick="@(() => _selectedDay = day.Id)"
                            type="button">
                            <span class="text-xs text-muted-foreground">@day.DayName</span>
                            <span class="text-sm font-medium tabular-nums">@day.DayNumber</span>
                            @if (!day.Available)
                            {
                                <span class="text-xs text-muted-foreground">Sold out</span>
                            }
                        </button>
                    }
                </div>
            </div>

            @* Time Slot Selector *@
            <div class="border-b px-4 py-3">
                <div class="mb-2 flex items-center gap-1.5">
                    <LucideClockCn Size="16" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs font-medium text-muted-foreground">Select time</span>
                </div>
                <RadioGroupCn Value="@_selectedSlot" ValueChanged="@((string v) => _selectedSlot = v)">
                    @for (var i = 0; i < _timeSlots.Length; i++)
                    {
                        var ts = _timeSlots[i];
                        var isLast = i == _timeSlots.Length - 1;
                        <div class="@(!isLast ? "border-b" : "")">
                            <LabelCn
                                Class="flex cursor-pointer items-center gap-3 py-2.5 transition-colors hover:bg-muted/50"
                                for="@($"slot-{ts.Value}")">
                                <RadioGroupItemCn Id="@($"slot-{ts.Value}")" Value="@ts.Value" />
                                <div class="min-w-0 flex-1">
                                    <span class="text-sm font-medium">@ts.Label</span>
                                    <p class="mt-0.5 text-xs text-muted-foreground">@ts.Range</p>
                                </div>
                                <span class="text-xs font-medium tabular-nums text-muted-foreground">
                                    @(ts.Price == 0 ? "Free" : $"+${ts.Price}")
                                </span>
                            </LabelCn>
                        </div>
                    }
                </RadioGroupCn>
            </div>

            @* Selected Summary *@
            <div class="border-b px-4 py-3">
                <span class="mb-1 block text-xs font-medium text-muted-foreground">
                    Selected delivery
                </span>
                @if (SelectedDay != null && SelectedSlot != null)
                {
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-medium">
                            @SelectedDay.DayName, @SelectedDay.Month @SelectedDay.DayNumber
                        </span>
                        <span class="text-xs text-muted-foreground">&middot;</span>
                        <span class="text-xs text-muted-foreground">@SelectedSlot.Range</span>
                        @if (SelectedSlot.Price > 0)
                        {
                            <span class="text-xs text-muted-foreground">&middot;</span>
                            <span class="text-xs font-medium tabular-nums">$@SelectedSlot.Price fee</span>
                        }
                    </div>
                }
                else
                {
                    <span class="text-xs text-muted-foreground">No slot selected</span>
                }
            </div>

            @* Confirm Button *@
            <div class="px-4 py-3">
                <ButtonCn Class="h-8 w-full text-xs" Size="ButtonSize.Sm">
                    Confirm Delivery Slot
                </ButtonCn>
            </div>
        </div>
    </section>
</section>

@code {
    private string _selectedDay = "d2";
    private string _selectedSlot = "morning";

    private record DayOption(string Id, string DayName, string DayNumber, string Month, bool Available);
    private record TimeSlotOption(string Value, string Label, string Range, int Price);

    private static readonly DayOption[] _days =
    [
        new("d1", "Mon", "17", "Mar", true),
        new("d2", "Tue", "18", "Mar", true),
        new("d3", "Wed", "19", "Mar", true),
        new("d4", "Thu", "20", "Mar", false),
        new("d5", "Fri", "21", "Mar", true),
        new("d6", "Sat", "22", "Mar", true),
        new("d7", "Sun", "23", "Mar", false)
    ];

    private static readonly TimeSlotOption[] _timeSlots =
    [
        new("morning", "Morning", "8:00 AM \u2013 12:00 PM", 0),
        new("afternoon", "Afternoon", "12:00 PM \u2013 5:00 PM", 5),
        new("evening", "Evening", "5:00 PM \u2013 9:00 PM", 10)
    ];

    private DayOption? SelectedDay => _days.FirstOrDefault(d => d.Id == _selectedDay);
    private TimeSlotOption? SelectedSlot => _timeSlots.FirstOrDefault(s => s.Value == _selectedSlot);
}
