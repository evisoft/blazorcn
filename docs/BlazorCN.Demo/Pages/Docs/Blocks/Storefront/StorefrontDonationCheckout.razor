@* ============================================================
   Block: storefront-donation-checkout
   Title: Storefront Donation Checkout
   Description: Add a donation at checkout with preset amounts, custom input, charity description, impact statement, and tax deduction note
   Long Description: Order dispute and claim form with issue type selector, photo upload area, description field, resolution options, and case timeline
   Dependencies: ButtonCn, InputCn, LabelCn, LucideHeartCn, LucideXCn
   Source: original/blocks/storefront/storefront-donation-checkout.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideHeartCn Size="16" Class="size-4 text-muted-foreground" />
                    <h2 class="text-sm font-medium">Add a Donation</h2>
                </div>
                <p class="text-xs text-muted-foreground">
                    Round up your order or add a donation at checkout
                </p>
            </div>

            @* Charity Info *@
            <div class="border-b px-4 py-3">
                <div class="rounded-md bg-muted/50 p-3">
                    <p class="text-sm font-medium">Clean Water Initiative</p>
                    <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                        A nonprofit providing sustainable clean water access to communities in Sub-Saharan
                        Africa. 92% of every dollar goes directly to water infrastructure projects.
                    </p>
                    <div class="mt-2 flex items-center gap-3">
                        <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                            501(c)(3) verified
                        </span>
                        <span class="text-xs text-muted-foreground">·</span>
                        <span class="text-xs text-muted-foreground">EIN 84-2941036</span>
                    </div>
                </div>
            </div>

            @* Amount Selection *@
            <div class="border-b px-4 py-3">
                <span class="mb-2 block text-xs font-medium text-muted-foreground">
                    Select an amount
                </span>
                <div class="flex flex-wrap gap-2">
                    @foreach (var amount in _presetAmounts)
                    {
                        var amt = amount;
                        <button
                            class="@(Cn.Merge("flex h-8 items-center justify-center rounded-md border px-4 text-xs font-medium transition-colors", !_isCustom && _selectedAmount == amt ? "border-primary text-primary" : "hover:border-foreground/50"))"
                            @onclick="@(() => SelectPreset(amt))"
                            type="button">
                            $@amt
                        </button>
                    }
                </div>
                <div class="mt-3">
                    <LabelCn Class="mb-1 block text-xs text-muted-foreground" for="donation-custom">
                        Custom amount
                    </LabelCn>
                    <div class="flex items-center gap-2">
                        <span class="text-xs text-muted-foreground">$</span>
                        <InputCn
                            Class="h-8 w-28 text-xs"
                            id="donation-custom"
                            placeholder="Other"
                            type="number"
                            Value="@_customAmount" />
                    </div>
                </div>
            </div>

            @* Impact Statement *@
            @if (Impact != null || DisplayAmount > 0)
            {
                <div class="border-b px-4 py-3">
                    <span class="mb-1 block text-xs font-medium text-muted-foreground">
                        Your impact
                    </span>
                    <p class="text-sm leading-relaxed">
                        @(Impact ?? $"Your ${DisplayAmount} donation supports clean water projects worldwide")
                    </p>
                </div>
            }

            @* Donation Summary *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Donation amount</span>
                    <div class="flex items-center gap-2">
                        <span class="font-semibold text-lg tabular-nums">
                            $@(DisplayAmount > 0 ? DisplayAmount.ToString() : "0")
                        </span>
                        @if (DisplayAmount > 0)
                        {
                            <ButtonCn Class="h-6 w-6 p-0" @onclick="RemoveDonation" Variant="ButtonVariant.Ghost">
                                <LucideXCn Size="16" Class="size-3 text-muted-foreground" />
                            </ButtonCn>
                        }
                    </div>
                </div>
                <p class="mt-1 text-xs text-muted-foreground">
                    Added to your order total · Will appear on your receipt
                </p>
            </div>

            @* Tax Deduction Note *@
            <div class="px-4 py-3">
                <p class="text-xs text-muted-foreground leading-relaxed">
                    Your donation is tax-deductible to the extent allowed by law. A tax receipt will be
                    emailed to you after your purchase is confirmed. Clean Water Initiative is a registered
                    501(c)(3) nonprofit organization.
                </p>
            </div>
        </div>
    </section>
</section>

@code {
    private int? _selectedAmount;
    private string _customAmount = "";
    private bool _isCustom;

    private static readonly int[] _presetAmounts = [1, 5, 10];

    private static readonly Dictionary<int, string> _impactStatements = new()
    {
        { 1, "Provides clean water for one child for a day" },
        { 5, "Funds one school lunch for a student" },
        { 10, "Plants two trees in reforestation zones" }
    };

    private int DisplayAmount => _isCustom ? (int.TryParse(_customAmount, out var v) ? v : 0) : (_selectedAmount ?? 0);

    private string? Impact => !_isCustom && _selectedAmount.HasValue && _impactStatements.TryGetValue(_selectedAmount.Value, out var s) ? s : null;

    private void SelectPreset(int amount)
    {
        _selectedAmount = amount;
        _isCustom = false;
        _customAmount = "";
    }

    private void RemoveDonation()
    {
        _selectedAmount = null;
        _customAmount = "";
        _isCustom = false;
    }
}
