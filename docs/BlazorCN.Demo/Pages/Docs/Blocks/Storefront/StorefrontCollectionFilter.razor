@* ============================================================
   Block: storefront-collection-filter
   Title: Storefront Collection Filter
   Description: Filtered product collection block with sidebar filters for price, color, and size, removable filter chips, and product list rows
   Long Description: Storefront checkout form with contact info, shipping address, delivery method, and order summary
   Dependencies: CheckboxCn, InputCn, LucideShirtCn, LucideXCn
   Source: original/blocks/storefront/storefront-collection-filter.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
    <section class="mx-auto w-full max-w-4xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between">
                    <h1 class="text-sm font-medium">Women&apos;s Outerwear</h1>
                    <span class="text-xs text-muted-foreground tabular-nums">
                        @FilteredProducts.Length products
                    </span>
                </div>
            </div>

            @* Two-panel layout *@
            <div class="grid md:grid-cols-[220px_1fr]">
                @* Filter Sidebar *@
                <div class="border-b md:border-r md:border-b-0">
                    @* Price Range *@
                    <div class="border-b px-4 py-3">
                        <span class="mb-2 block text-xs font-medium text-muted-foreground">
                            Price Range
                        </span>
                        <div class="flex items-center gap-2">
                            <InputCn
                                Class="h-7 text-xs"
                                placeholder="Min"
                                Value="@_minPrice"
                                type="number" />
                            <span class="text-xs text-muted-foreground">&ndash;</span>
                            <InputCn
                                Class="h-7 text-xs"
                                placeholder="Max"
                                Value="@_maxPrice"
                                type="number" />
                        </div>
                    </div>

                    @* Color Filter *@
                    <div class="border-b px-4 py-3">
                        <span class="mb-2 block text-xs font-medium text-muted-foreground">Color</span>
                        <div class="space-y-2">
                            @foreach (var color in _colors)
                            {
                                var colorVal = color.Value;
                                <span class="flex cursor-pointer items-center gap-2" @onclick="@(() => ToggleColor(colorVal))">
                                    <CheckboxCn
                                        Checked="@_selectedColors.Contains(colorVal)"
                                        Id="@($"color-{colorVal}")" />
                                    <span
                                        class="size-3 rounded-full border"
                                        style="@($"background-color: {color.Hex}")"></span>
                                    <span class="text-xs font-medium">@color.Label</span>
                                </span>
                            }
                        </div>
                    </div>

                    @* Size Filter *@
                    <div class="px-4 py-3">
                        <span class="mb-2 block text-xs font-medium text-muted-foreground">Size</span>
                        <div class="space-y-2">
                            @foreach (var size in _sizes)
                            {
                                var s = size;
                                <span class="flex cursor-pointer items-center gap-2" @onclick="@(() => ToggleSize(s))">
                                    <CheckboxCn
                                        Checked="@_selectedSizes.Contains(s)"
                                        Id="@($"size-{s}")" />
                                    <span class="text-xs font-medium">@s</span>
                                </span>
                            }
                        </div>
                    </div>
                </div>

                @* Product List *@
                <div>
                    @* Active Filters *@
                    @if (ActiveFilters.Length > 0)
                    {
                        <div class="flex flex-wrap items-center gap-1.5 border-b px-4 py-2.5">
                            @foreach (var filter in ActiveFilters)
                            {
                                var f = filter;
                                <button
                                    type="button"
                                    @onclick="@(() => RemoveFilter(f.Type, f.Value))"
                                    class="flex items-center gap-1 rounded-md bg-muted/50 px-2 py-1 text-xs font-medium transition-colors hover:bg-muted">
                                    @f.Label
                                    <LucideXCn Size="16" Class="size-3 text-muted-foreground" />
                                </button>
                            }
                            <button
                                type="button"
                                @onclick="ClearAll"
                                class="text-xs text-muted-foreground underline underline-offset-2 transition-colors hover:text-foreground">
                                Clear all
                            </button>
                        </div>
                    }

                    @* Products *@
                    @if (FilteredProducts.Length > 0)
                    {
                        <div>
                            @for (var i = 0; i < FilteredProducts.Length; i++)
                            {
                                var product = FilteredProducts[i];
                                var isLast = i == FilteredProducts.Length - 1;
                                <a
                                    href="#"
                                    class="@(Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : ""))">
                                    <div class="flex size-12 shrink-0 items-center justify-center rounded-md border bg-muted/50">
                                        <LucideShirtCn Size="16" Class="size-4 text-muted-foreground/60" />
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <span class="text-sm font-medium">@product.Name</span>
                                        <p class="mt-0.5 text-xs text-muted-foreground">Size @product.Size</p>
                                    </div>
                                    <span
                                        class="size-3 shrink-0 rounded-full border"
                                        style="@($"background-color: {product.ColorHex}")"></span>
                                    <span class="shrink-0 text-sm font-medium tabular-nums">
                                        $@product.Price
                                    </span>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="px-4 py-12 text-center">
                            <p class="text-sm font-medium">No products found</p>
                            <p class="mt-1 text-xs text-muted-foreground">
                                Try adjusting your filters to see more results
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
</section>

@code {
    private List<string> _selectedColors = ["black"];
    private List<string> _selectedSizes = ["M"];
    private string _minPrice = "";
    private string _maxPrice = "";

    private record ColorOption(string Value, string Label, string Hex);
    private record ProductInfo(int Id, string Name, int Price, string Color, string ColorHex, string Size);
    private record FilterChip(string Type, string Value, string Label);

    private static readonly ColorOption[] _colors =
    [
        new("black", "Black", "#1a1a1a"),
        new("navy", "Navy", "#1e3a5f"),
        new("cream", "Cream", "#f5f0e1"),
        new("red", "Red", "#dc2626")
    ];

    private static readonly string[] _sizes = ["XS", "S", "M", "L", "XL"];

    private static readonly ProductInfo[] _products =
    [
        new(1, "Wool Blend Overcoat", 345, "black", "#1a1a1a", "M"),
        new(2, "Quilted Puffer Jacket", 225, "navy", "#1e3a5f", "S"),
        new(3, "Trench Coat", 289, "cream", "#f5f0e1", "L"),
        new(4, "Leather Biker Jacket", 495, "black", "#1a1a1a", "M"),
        new(5, "Down Parka", 380, "navy", "#1e3a5f", "XL"),
        new(6, "Cropped Bomber Jacket", 195, "red", "#dc2626", "XS"),
        new(7, "Shearling-Lined Coat", 520, "cream", "#f5f0e1", "M"),
        new(8, "Rain Jacket", 145, "black", "#1a1a1a", "S")
    ];

    private ProductInfo[] FilteredProducts => _products.Where(p =>
    {
        if (_selectedColors.Count > 0 && !_selectedColors.Contains(p.Color)) return false;
        if (_selectedSizes.Count > 0 && !_selectedSizes.Contains(p.Size)) return false;
        if (!string.IsNullOrEmpty(_minPrice) && int.TryParse(_minPrice, out var min) && p.Price < min) return false;
        if (!string.IsNullOrEmpty(_maxPrice) && int.TryParse(_maxPrice, out var max) && p.Price > max) return false;
        return true;
    }).ToArray();

    private FilterChip[] ActiveFilters
    {
        get
        {
            var filters = new List<FilterChip>();
            foreach (var c in _selectedColors)
            {
                var color = _colors.FirstOrDefault(col => col.Value == c);
                if (color != null) filters.Add(new("color", c, color.Label));
            }
            foreach (var s in _selectedSizes)
            {
                filters.Add(new("size", s, $"Size {s}"));
            }
            if (!string.IsNullOrEmpty(_minPrice)) filters.Add(new("minPrice", _minPrice, $"Min ${_minPrice}"));
            if (!string.IsNullOrEmpty(_maxPrice)) filters.Add(new("maxPrice", _maxPrice, $"Max ${_maxPrice}"));
            return filters.ToArray();
        }
    }

    private void ToggleColor(string color)
    {
        if (_selectedColors.Contains(color)) _selectedColors.Remove(color);
        else _selectedColors.Add(color);
    }

    private void ToggleSize(string size)
    {
        if (_selectedSizes.Contains(size)) _selectedSizes.Remove(size);
        else _selectedSizes.Add(size);
    }

    private void RemoveFilter(string type, string value)
    {
        if (type == "color") ToggleColor(value);
        else if (type == "size") ToggleSize(value);
        else if (type == "minPrice") _minPrice = "";
        else if (type == "maxPrice") _maxPrice = "";
    }

    private void ClearAll()
    {
        _selectedColors.Clear();
        _selectedSizes.Clear();
        _minPrice = "";
        _maxPrice = "";
    }
}
