@* ============================================================
   Block: storefront-product-availability-map
   Title: Storefront Product Availability Map
   Description: Regional product availability checker with stock levels per region, delivery estimates, and nearest location finder for e-commerce stores
   Dependencies: ButtonCn, InputCn, LucideChevronRightCn, LucideMapPinCn, LucideSearchCn
   Source: original/blocks/storefront/storefront-product-availability-map.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideMapPinCn Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Regional Availability</h2>
            </div>
        </div>

        @* Product *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium">@ProductName</p>
                    <p class="text-xs text-muted-foreground">@ProductVariant &middot; @ProductSku</p>
                </div>
                <span class="text-sm font-medium tabular-nums">$@ProductPriceValue</span>
            </div>
        </div>

        @* Stock Summary *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-4">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @InStockCount regions
                </span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @LowStockCount low
                </span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @OutOfStockCount unavailable
                </span>
            </div>
        </div>

        @* Search *@
        <div class="border-b px-4 py-3">
            <div class="relative">
                <LucideSearchCn Size="16" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Class="h-8 pl-8 text-xs" Placeholder="Search by region or city..." @bind-Value="_search" />
            </div>
        </div>

        @* Region List *@
        <div>
            @{ var filtered = FilteredRegions; }
            @for (var i = 0; i < filtered.Length; i++)
            {
                var region = filtered[i];
                var isExpanded = _selectedRegion == region.Id;
                var isLast = i == filtered.Length - 1;
                var dot = GetStatusDot(region.Status);
                var label = GetStatusLabel(region.Status);

                <div class="@(!isLast || isExpanded ? "border-b" : "")">
                    <button class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", region.Status == "out-of-stock" ? "opacity-60" : "")"
                            type="button"
                            @onclick="() => ToggleRegion(region.Id)">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", dot)" />
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@region.Name</span>
                            <p class="text-xs text-muted-foreground">@region.Warehouse</p>
                        </div>
                        <span class="shrink-0 text-xs text-muted-foreground">@label</span>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-9">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="space-y-2">
                                    <div class="flex items-center justify-between">
                                        <span class="text-xs text-muted-foreground">Stock</span>
                                        <span class="text-xs font-medium tabular-nums">
                                            @(region.Quantity > 0 ? $"{region.Quantity} units" : "Unavailable")
                                        </span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-xs text-muted-foreground">Estimated delivery</span>
                                        <span class="text-xs font-medium">@region.Delivery</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(region.NearestAvailable))
                                    {
                                        <div class="border-t pt-2">
                                            <p class="text-xs text-muted-foreground">
                                                Nearest available: @region.NearestAvailable
                                            </p>
                                        </div>
                                    }
                                </div>
                            </div>
                            @if (region.Status != "out-of-stock")
                            {
                                <ButtonCn Class="mt-2 h-7 w-full text-xs" Variant="ButtonVariant.Outline">
                                    Ship from @region.Warehouse
                                </ButtonCn>
                            }
                            else
                            {
                                <ButtonCn Class="mt-2 h-7 w-full text-xs" Variant="ButtonVariant.Ghost">
                                    Notify When Available
                                </ButtonCn>
                            }
                        </div>
                    }
                </div>
            }

            @if (filtered.Length == 0)
            {
                <div class="px-4 py-6 text-center">
                    <p class="text-xs text-muted-foreground">No regions match your search</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record RegionInfo(string Id, string Name, string Warehouse, string Status, int Quantity, string Delivery, string? NearestAvailable = null);

    private const string ProductName = "Ergonomic Standing Desk";
    private const string ProductVariant = "Walnut / 60 inch";
    private const int ProductPriceValue = 849;
    private const string ProductSku = "DSK-ERG-60-WLN";

    private static readonly RegionInfo[] _regions =
    {
        new("northeast", "Northeast", "Edison, NJ", "in-stock", 142, "2-3 business days"),
        new("southeast", "Southeast", "Atlanta, GA", "in-stock", 89, "2-4 business days"),
        new("midwest", "Midwest", "Columbus, OH", "low-stock", 8, "3-5 business days"),
        new("southwest", "Southwest", "Phoenix, AZ", "out-of-stock", 0, "5-7 business days", "West Coast (Los Angeles, CA)"),
        new("west-coast", "West Coast", "Los Angeles, CA", "in-stock", 215, "2-3 business days"),
        new("pacific-nw", "Pacific Northwest", "Portland, OR", "low-stock", 3, "3-4 business days")
    };

    private string _search = "";
    private string? _selectedRegion;

    private int InStockCount => _regions.Count(r => r.Status == "in-stock");
    private int LowStockCount => _regions.Count(r => r.Status == "low-stock");
    private int OutOfStockCount => _regions.Count(r => r.Status == "out-of-stock");

    private RegionInfo[] FilteredRegions => string.IsNullOrWhiteSpace(_search)
        ? _regions
        : _regions.Where(r =>
            r.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            r.Warehouse.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToArray();

    private void ToggleRegion(string regionId) =>
        _selectedRegion = _selectedRegion == regionId ? null : regionId;

    private static string GetStatusDot(string status) => status switch
    {
        "in-stock" => "bg-emerald-500",
        "low-stock" => "bg-amber-500",
        _ => "bg-red-500"
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "in-stock" => "In Stock",
        "low-stock" => "Low Stock",
        _ => "Out of Stock"
    };
}
