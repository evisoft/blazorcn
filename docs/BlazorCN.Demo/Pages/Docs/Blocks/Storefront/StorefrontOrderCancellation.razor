@* ============================================================
   Block: storefront-order-cancellation
   Title: Storefront Order Cancellation
   Description: Order cancellation flow with reason selection, refund estimate, cancellation policy notice, and confirmation step
   Dependencies: ButtonCn, LucideAlertTriangleCn, LucideCheckCircle2Cn, LucideChevronRightCn, LucidePackageCn, LucideXCircleCn
   Source: original/blocks/storefront/storefront-order-cancellation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideXCircleCn Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Cancel Order</h2>
            </div>
            <div class="mt-0.5 flex items-center gap-2">
                <span class="font-mono text-xs text-muted-foreground">@OrderId</span>
                <span class="text-xs text-muted-foreground">&middot;</span>
                <span class="text-xs text-muted-foreground">@OrderDate</span>
            </div>
        </div>

        @if (_step == "done")
        {
            @* Cancellation Complete *@
            <div class="px-4 py-8 text-center">
                <LucideCheckCircle2Cn Size="16" Class="mx-auto mb-3 size-6 text-emerald-500" />
                <p class="text-sm font-medium">Order cancelled</p>
                <p class="mt-1 text-xs text-muted-foreground">
                    Your refund of $@RefundAmount.ToString("F2") will be processed within @RefundTimeline
                </p>
                <p class="mt-0.5 text-xs text-muted-foreground">Refund to @PaymentMethod</p>
            </div>
        }
        else
        {
            @* Order Items Preview *@
            @foreach (var item in _orderItems)
            {
                <div class="flex items-center gap-3 border-b px-4 py-2.5">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        <LucidePackageCn Size="16" Class="size-3 text-muted-foreground/60" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="truncate text-sm">@item.Name</p>
                        <p class="text-xs text-muted-foreground">@item.Variant</p>
                    </div>
                    <span class="shrink-0 text-xs tabular-nums text-muted-foreground">
                        $@item.Price
                    </span>
                </div>
            }

            @if (_step == "reason")
            {
                @* Reason Selection *@
                <div class="border-b px-4 py-3">
                    <span class="mb-2 block text-xs font-medium text-muted-foreground">
                        Why are you cancelling?
                    </span>
                    <div class="space-y-0.5">
                        @foreach (var reason in _cancellationReasons)
                        {
                            <button class="@Cn.Merge("flex w-full items-center gap-2 rounded-md px-3 py-2 text-left text-sm transition-colors hover:bg-muted/50", _selectedReason == reason.Id ? "bg-muted/50" : "")"
                                    type="button"
                                    @onclick="() => _selectedReason = reason.Id">
                                <span class="@Cn.Merge("size-3.5 shrink-0 rounded-full border-2", _selectedReason == reason.Id ? "border-foreground bg-foreground" : "border-muted-foreground/30")" />
                                @reason.Label
                            </button>
                        }
                    </div>
                </div>

                @* Continue Button *@
                <div class="px-4 py-3">
                    <ButtonCn Class="h-8 w-full text-xs" Disabled="@(_selectedReason == null)" Variant="ButtonVariant.Outline" @onclick="GoToConfirm">
                        Continue
                        <LucideChevronRightCn Size="16" Class="ml-1 size-3" />
                    </ButtonCn>
                </div>
            }

            @if (_step == "confirm")
            {
                @* Refund Estimate *@
                <div class="border-b px-4 py-3">
                    <span class="text-xs font-medium text-muted-foreground">
                        Estimated Refund
                    </span>
                    <div class="mt-1 flex items-center justify-between">
                        <span class="text-sm">To @PaymentMethod</span>
                        <span class="text-2xl font-semibold tabular-nums">
                            $@RefundAmount.ToString("F2")
                        </span>
                    </div>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Refund will appear within @RefundTimeline
                    </p>
                </div>

                @* Cancellation Policy *@
                <div class="border-b px-4 py-3">
                    <div class="rounded-md bg-muted/50 p-3">
                        <div class="flex items-start gap-2">
                            <LucideAlertTriangleCn Size="16" Class="mt-0.5 size-3.5 shrink-0 text-amber-500" />
                            <div>
                                <span class="text-xs font-medium">Cancellation policy</span>
                                <p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">
                                    Once cancelled, this action cannot be undone. If you wish to purchase
                                    these items again, you will need to place a new order at the current
                                    prices. Promotional pricing or coupon codes from the original order may no
                                    longer be available.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                @* Confirm / Go Back *@
                <div class="px-4 py-3">
                    <div class="flex items-center gap-2">
                        <ButtonCn Class="h-8 flex-1 text-xs" Variant="ButtonVariant.Ghost" @onclick="GoToReason">
                            Go Back
                        </ButtonCn>
                        <ButtonCn Class="h-8 flex-1 text-xs text-red-600 hover:text-red-600 dark:text-red-400 dark:hover:text-red-400" Variant="ButtonVariant.Outline" @onclick="GoToDone">
                            Confirm Cancellation
                        </ButtonCn>
                    </div>
                </div>
            }
        }
    </div>
</section>

@code {
    private record OrderItem(int Id, string Name, string Variant, int Price);
    private record ReasonOption(string Id, string Label);

    private const string OrderId = "ORD-2026-4817";
    private const string OrderDate = "Mar 14, 2026";
    private const decimal RefundAmount = 543.04m;
    private const string RefundTimeline = "5\u201310 business days";
    private const string PaymentMethod = "Visa ending in 4242";

    private static readonly OrderItem[] _orderItems =
    {
        new(1, "Merino Wool Crewneck", "Charcoal / M", 145),
        new(2, "Canvas Low-Top Sneakers", "White / 10", 98),
        new(3, "Leather Weekend Bag", "Tan / One Size", 295)
    };

    private static readonly ReasonOption[] _cancellationReasons =
    {
        new("changed-mind", "Changed my mind"),
        new("found-cheaper", "Found a better price elsewhere"),
        new("wrong-item", "Ordered the wrong item"),
        new("delivery-too-slow", "Delivery time is too long"),
        new("duplicate-order", "Placed a duplicate order"),
        new("other", "Other reason")
    };

    private string? _selectedReason;
    private string _step = "reason";

    private void GoToConfirm() => _step = "confirm";
    private void GoToReason() => _step = "reason";
    private void GoToDone() => _step = "done";
}
