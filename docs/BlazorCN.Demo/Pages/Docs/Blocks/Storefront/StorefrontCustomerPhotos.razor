@* ============================================================
   Block: storefront-customer-photos
   Title: Storefront Customer Photos
   Description: User-generated content gallery showing customer photos alongside their reviews with star ratings, a masonry-style grid, and an upload CTA for social proof
   Dependencies: ButtonCn, LucideCameraCn, LucideImageCn
   Source: original/blocks/storefront/storefront-customer-photos.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideCameraCn Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Customer Photos</h2>
                <span class="text-xs text-muted-foreground">@TotalPhotos photos</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideImageCn Size="16" Class="size-3" />
                Upload Your Photo
            </ButtonCn>
        </div>

        @* Photo Grid *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-3 gap-2">
                @foreach (var photo in _photos)
                {
                    <button type="button"
                            class="@Cn.Merge("group relative overflow-hidden rounded-md transition-all", _selectedId == photo.Id ? "ring-2 ring-primary" : "")"
                            @onclick="() => _selectedId = _selectedId == photo.Id ? (int?)null : photo.Id">
                        <div class="@Cn.Merge(photo.AspectClass, photo.Color, "flex items-center justify-center transition-opacity group-hover:opacity-80")">
                            <LucideImageCn Size="16" Class="size-6 text-muted-foreground/30" />
                        </div>
                        <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent p-2">
                            <div class="flex items-center justify-between">
                                <span class="text-[10px] font-medium text-white">@photo.Customer</span>
                                <span class="text-[10px] text-white/80">@photo.Rating stars</span>
                            </div>
                        </div>
                    </button>
                }
            </div>
        </div>

        @* Selected Photo Detail *@
        @{ var selectedPhoto = _photos.FirstOrDefault(p => p.Id == _selectedId); }
        @if (selectedPhoto != null)
        {
            <div class="px-4 py-3">
                <div class="rounded-md bg-muted/50 p-3">
                    <div class="flex items-center gap-2">
                        <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">
                            @selectedPhoto.Customer[0]
                        </div>
                        <span class="text-sm font-medium">@selectedPhoto.Customer</span>
                        <span class="text-xs text-muted-foreground">@selectedPhoto.Rating out of 5 stars</span>
                    </div>
                    <p class="mt-2 text-xs text-muted-foreground leading-relaxed">
                        @selectedPhoto.Caption
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="px-4 py-3">
                <p class="text-center text-xs text-muted-foreground">
                    Tap a photo to see the full review
                </p>
            </div>
        }
    </div>
</section>

@code {
    private record PhotoInfo(int Id, string Customer, int Rating, string Caption, string Color, string AspectClass);

    private const int TotalPhotos = 148;

    private static readonly PhotoInfo[] _photos =
    {
        new(1, "Mia T.", 5, "Looks even better in person. The fabric quality is amazing.", "bg-stone-300 dark:bg-stone-700", "aspect-square"),
        new(2, "Alex K.", 4, "Perfect everyday piece. Fits true to size.", "bg-zinc-300 dark:bg-zinc-700", "aspect-[4/5]"),
        new(3, "Jordan P.", 5, "Third purchase from this brand. Never disappoints.", "bg-neutral-300 dark:bg-neutral-700", "aspect-square"),
        new(4, "Sam W.", 5, "Got so many compliments wearing this last weekend.", "bg-slate-300 dark:bg-slate-700", "aspect-[4/5]"),
        new(5, "Riley N.", 4, "Great color, great fit. Would buy again.", "bg-gray-300 dark:bg-gray-700", "aspect-square"),
        new(6, "Casey L.", 5, "Styled it for a date night and got endless compliments.", "bg-stone-400 dark:bg-stone-600", "aspect-square")
    };

    private int? _selectedId;
}
