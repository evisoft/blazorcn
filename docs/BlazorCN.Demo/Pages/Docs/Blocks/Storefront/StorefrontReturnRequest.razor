@* ============================================================
   Block: storefront-return-request
   Title: Storefront Return Request
   Description: Storefront return and exchange form with item selection, reason picker, and refund summary
   Dependencies: ButtonCn, CheckboxCn, LucideArrowLeftRightCn, LucidePackageCn, LucideRotateCcwCn, LucideSendCn, RadioGroupCn, RadioGroupItemCn
   Source: original/blocks/storefront/storefront-return-request.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideRotateCcwCn Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Return Request</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Order ORD-2026-4817 &middot; Select items to return
            </p>
        </div>

        @* Item Selection *@
        @for (var i = 0; i < _orderItems.Length; i++)
        {
            var item = _orderItems[i];
            var isSelected = _selectedItems.Contains(item.Id);
            var isLast = i == _orderItems.Length - 1;
            <label class="@Cn.Merge("flex cursor-pointer items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "", isSelected ? "bg-muted/30" : "")"
                   for="@($"return-item-{item.Id}")">
                <CheckboxCn Checked="@isSelected"
                            CheckedChanged="@(() => ToggleItem(item.Id))"
                            Class="size-4"
                            Id="@($"return-item-{item.Id}")" />
                <div class="flex size-12 shrink-0 items-center justify-center rounded-md bg-muted/50">
                    <LucidePackageCn Size="16" Class="size-4 text-muted-foreground/60" />
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium">@item.Name</p>
                    <p class="text-xs text-muted-foreground">@item.Variant</p>
                </div>
                <span class="shrink-0 text-sm tabular-nums">$@item.Price</span>
            </label>
        }

        @* Return Reason *@
        <div class="border-t px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Reason for return</p>
            <RadioGroupCn TValue="string" Value="@_reason" ValueChanged="@(v => _reason = v)" Class="space-y-0">
                @foreach (var r in _returnReasons)
                {
                    <label class="flex cursor-pointer items-center gap-3 rounded-md px-3 py-2 transition-colors hover:bg-muted/50"
                           for="@($"reason-{r.Id}")">
                        <RadioGroupItemCn Id="@($"reason-{r.Id}")" Value="@r.Id" />
                        <span class="text-sm">@r.Label</span>
                    </label>
                }
            </RadioGroupCn>
        </div>

        @* Return Type *@
        <div class="border-t px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Return method</p>
            <div class="flex gap-2">
                <button class="@Cn.Merge("flex flex-1 items-center justify-center gap-2 rounded-md border px-3 py-2 text-sm transition-colors", _returnType == "refund" ? "border-primary bg-muted/50 font-medium" : "hover:bg-muted/50")"
                        type="button"
                        @onclick="SetReturnTypeRefund">
                    <LucideRotateCcwCn Size="16" Class="size-3.5" />
                    Refund
                </button>
                <button class="@Cn.Merge("flex flex-1 items-center justify-center gap-2 rounded-md border px-3 py-2 text-sm transition-colors", _returnType == "exchange" ? "border-primary bg-muted/50 font-medium" : "hover:bg-muted/50")"
                        type="button"
                        @onclick="SetReturnTypeExchange">
                    <LucideArrowLeftRightCn Size="16" Class="size-3.5" />
                    Exchange
                </button>
            </div>
        </div>

        @* Summary *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs text-muted-foreground">
                        @if (_selectedItems.Count > 0)
                        {
                            @($"{_selectedItems.Count} item{(_selectedItems.Count > 1 ? "s" : "")} selected")
                        }
                        else
                        {
                            <text>No items selected</text>
                        }
                    </p>
                    @if (_returnType == "refund" && _selectedItems.Count > 0)
                    {
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            Refund to original payment method
                        </p>
                    }
                    @if (_returnType == "exchange" && _selectedItems.Count > 0)
                    {
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            Exchange credit for new items
                        </p>
                    }
                </div>
                @if (_selectedItems.Count > 0)
                {
                    <span class="text-2xl font-semibold tabular-nums">$@RefundAmount</span>
                }
            </div>
        </div>

        @* Submit *@
        <div class="border-t px-4 py-3">
            <ButtonCn Class="w-full gap-1.5 text-xs" Disabled="@(!CanSubmit)" Variant="ButtonVariant.Outline">
                <LucideSendCn Size="16" Class="size-3.5" />
                Submit Return Request
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record OrderItem(int Id, string Name, string Variant, int Price);
    private record ReturnReason(string Id, string Label);

    private static readonly OrderItem[] _orderItems =
    {
        new(1, "Merino Wool Crewneck", "Charcoal / M", 145),
        new(2, "Canvas Low-Top Sneakers", "White / 10", 98),
        new(3, "Linen Button-Down Shirt", "Sky Blue / L", 125)
    };

    private static readonly ReturnReason[] _returnReasons =
    {
        new("wrong-size", "Wrong size"),
        new("damaged", "Damaged or defective"),
        new("changed-mind", "Changed my mind"),
        new("not-as-described", "Not as described")
    };

    private HashSet<int> _selectedItems = new();
    private string _reason = "";
    private string _returnType = "refund";

    private int RefundAmount => _orderItems.Where(i => _selectedItems.Contains(i.Id)).Sum(i => i.Price);
    private bool CanSubmit => _selectedItems.Count > 0 && !string.IsNullOrEmpty(_reason);

    private void ToggleItem(int id)
    {
        if (!_selectedItems.Remove(id))
            _selectedItems.Add(id);
    }

    private void SetReturnTypeRefund() => _returnType = "refund";
    private void SetReturnTypeExchange() => _returnType = "exchange";
}
