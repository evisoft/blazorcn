@* ============================================================
   Block: storefront-registry
   Title: Storefront Registry
   Description: Gift and wedding registry view with registry name, event date, progress bar toward funding goal, item list with purchased and remaining counts, and a shareable link
   Dependencies: ButtonCn, LucideCalendarCn, LucideCheckCn, LucideCopyCn, LucideGiftCn, LucideLinkCn, LucideShareCn, ProgressCn
   Source: original/blocks/storefront/storefront-registry.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Registry Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideGiftCn Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">@RegistryName</h2>
            </div>
            <div class="mt-1 flex items-center gap-1.5">
                <LucideCalendarCn Size="16" Class="size-3 text-muted-foreground" />
                <span class="text-xs text-muted-foreground">@EventDate</span>
            </div>
        </div>

        @* Progress *@
        <div class="border-b px-4 py-3">
            <div class="flex items-baseline justify-between">
                <div class="flex items-baseline gap-1">
                    <span class="text-2xl font-semibold tabular-nums">
                        $@FundedAmount.ToString("N0")
                    </span>
                    <span class="text-xs text-muted-foreground">
                        of $@GoalAmount.ToString("N0") goal
                    </span>
                </div>
                <span class="text-sm font-medium tabular-nums">@Progress%</span>
            </div>
            <ProgressCn Value="@Progress" Class="mt-2 h-2" />
            <div class="mt-2 flex items-center gap-3">
                <span class="text-xs text-muted-foreground">
                    @PurchasedItems of @TotalItems items fulfilled
                </span>
            </div>
        </div>

        @* Filter Tabs *@
        <div class="flex border-b px-4 py-2">
            <button type="button"
                    class="@Cn.Merge("rounded-md px-3 py-1 text-xs font-medium transition-colors", _filter == "all" ? "bg-muted text-foreground" : "text-muted-foreground hover:text-foreground")"
                    @onclick="@(() => _filter = "all")">
                All
            </button>
            <button type="button"
                    class="@Cn.Merge("rounded-md px-3 py-1 text-xs font-medium transition-colors", _filter == "available" ? "bg-muted text-foreground" : "text-muted-foreground hover:text-foreground")"
                    @onclick="SetFilterAvailable">
                Still Needed
            </button>
            <button type="button"
                    class="@Cn.Merge("rounded-md px-3 py-1 text-xs font-medium transition-colors", _filter == "purchased" ? "bg-muted text-foreground" : "text-muted-foreground hover:text-foreground")"
                    @onclick="SetFilterPurchased">
                Purchased
            </button>
        </div>

        @* Items List *@
        <div>
            @{ var filtered = FilteredItems; }
            @for (var i = 0; i < filtered.Length; i++)
            {
                var item = filtered[i];
                var isFulfilled = item.Purchased >= item.Requested;
                var isLast = i == filtered.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", !isLast ? "border-b" : "")">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="@Cn.Merge("text-sm font-medium", isFulfilled ? "text-muted-foreground line-through" : "")">
                                @item.Name
                            </span>
                            @if (isFulfilled)
                            {
                                <span class="flex size-4 items-center justify-center rounded-full bg-emerald-500/10">
                                    <LucideCheckCn Size="16" Class="size-2.5 text-emerald-600 dark:text-emerald-400" />
                                </span>
                            }
                        </div>
                        <div class="mt-0.5 flex items-center gap-2">
                            <span class="text-xs text-muted-foreground">@item.Category</span>
                            <span class="text-xs text-muted-foreground">&middot;</span>
                            <span class="text-xs tabular-nums text-muted-foreground">
                                @item.Purchased/@item.Requested purchased
                            </span>
                        </div>
                    </div>
                    <span class="shrink-0 text-sm font-medium tabular-nums">$@item.Price</span>
                    @if (!isFulfilled)
                    {
                        <ButtonCn Class="h-7 shrink-0 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                            Contribute
                        </ButtonCn>
                    }
                </div>
            }
        </div>

        @* Share Link *@
        <div class="border-t px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">
                Share this registry
            </span>
            <div class="flex items-center gap-2">
                <div class="flex flex-1 items-center gap-2 rounded-md bg-muted/50 px-3 py-1.5">
                    <LucideLinkCn Size="16" Class="size-3 shrink-0 text-muted-foreground" />
                    <span class="truncate font-mono text-xs text-muted-foreground">
                        shop.example.com/registry/emma-james-2026
                    </span>
                </div>
                <ButtonCn Class="h-7 gap-1 px-2 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="HandleCopyLink">
                    @if (_copied)
                    {
                        <LucideCheckCn Size="16" Class="size-3" />
                        <text>Copied</text>
                    }
                    else
                    {
                        <LucideCopyCn Size="16" Class="size-3" />
                        <text>Copy</text>
                    }
                </ButtonCn>
                <ButtonCn Class="h-7 px-2" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                    <LucideShareCn Size="16" Class="size-3" />
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record RegistryItem(int Id, string Name, int Price, int Requested, int Purchased, string Category);

    private const string RegistryName = "Emma & James Wedding Registry";
    private const string EventDate = "September 14, 2026";
    private const int GoalAmount = 8500;
    private const int FundedAmount = 5320;

    private static readonly RegistryItem[] _items =
    {
        new(1, "Le Creuset Dutch Oven 5.5 Qt", 420, 1, 1, "Kitchen"),
        new(2, "Brooklinen Luxe Core Sheet Set", 169, 2, 1, "Bedroom"),
        new(3, "KitchenAid Stand Mixer", 350, 1, 0, "Kitchen"),
        new(4, "Dyson V15 Detect Vacuum", 749, 1, 0, "Home"),
        new(5, "All-Clad D5 10-Piece Cookware Set", 900, 1, 0, "Kitchen"),
        new(6, "Sonos One Speaker (Pair)", 438, 1, 1, "Electronics"),
        new(7, "Crate & Barrel Dining Chairs (Set of 4)", 796, 1, 0, "Dining"),
        new(8, "Nespresso Vertuo Plus", 189, 1, 1, "Kitchen")
    };

    private string _filter = "all";
    private bool _copied;

    private static int Progress => (int)Math.Round((double)FundedAmount / GoalAmount * 100);
    private static int TotalItems => _items.Sum(i => i.Requested);
    private static int PurchasedItems => _items.Sum(i => i.Purchased);

    private RegistryItem[] FilteredItems => _filter switch
    {
        "available" => _items.Where(i => i.Purchased < i.Requested).ToArray(),
        "purchased" => _items.Where(i => i.Purchased >= i.Requested).ToArray(),
        _ => _items
    };

    private void SetFilterAvailable() => _filter = "available";
    private void SetFilterPurchased() => _filter = "purchased";

    private async Task HandleCopyLink()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
