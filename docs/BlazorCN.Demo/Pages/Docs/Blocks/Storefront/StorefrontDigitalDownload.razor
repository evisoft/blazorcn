@* ============================================================
   Block: storefront-digital-download
   Title: Storefront Digital Download
   Description: Digital product delivery panel with download links, file sizes, format options, download count limit, license key with copy button, and expiration notice
   Dependencies: ButtonCn, LucideCheckCn, LucideCopyCn, LucideDownloadCn, LucideFileAudioCn, LucideFileCn, LucideFileTextCn, LucideInfoCn
   Source: original/blocks/storefront/storefront-digital-download.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">@_product.Title</h2>
            <div class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                <span>Order @_product.OrderId</span>
                <span>·</span>
                <span>@_product.PurchaseDate</span>
            </div>
        </div>

        @* Download Formats *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">Available formats</span>
            <div class="flex flex-col gap-1">
                @foreach (var file in _product.Files)
                {
                    var isSelected = _selectedFormat == file.Format;
                    <button type="button"
                            class="@Cn.Merge("flex w-full items-center gap-3 rounded-md px-3 py-2 text-left transition-colors", isSelected ? "bg-muted/50" : "hover:bg-muted/30")"
                            @onclick="() => _selectedFormat = file.Format">
                        @if (file.Icon == "pdf")
                        {
                            <LucideFileTextCn Size="16" Class="size-4 text-muted-foreground" />
                        }
                        else if (file.Icon == "epub")
                        {
                            <LucideFileCn Size="16" Class="size-4 text-muted-foreground" />
                        }
                        else
                        {
                            <LucideFileMusicCn Size="16" Class="size-4 text-muted-foreground" />
                        }
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@file.Label</span>
                            <p class="text-xs text-muted-foreground">@file.Size</p>
                        </div>
                        @if (isSelected)
                        {
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        }
                    </button>
                }
            </div>
        </div>

        @* Download Button + Count *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-sm font-medium">Download @_selectedFormat</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @DownloadsRemaining of @_product.DownloadsMax downloads remaining
                    </p>
                </div>
                <ButtonCn Class="h-7 gap-1 px-3 text-xs" disabled="@(DownloadsRemaining <= 0)" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                    <LucideDownloadCn Size="16" Class="size-3" />
                    Download
                </ButtonCn>
            </div>
            <div class="mt-2 h-1 w-full rounded-full bg-muted">
                <div class="h-1 rounded-full bg-foreground/20" style="@($"width: {(double)_product.DownloadsUsed / _product.DownloadsMax * 100}%")"></div>
            </div>
        </div>

        @* License Key *@
        <div class="border-b px-4 py-3">
            <span class="mb-1.5 block text-xs font-medium text-muted-foreground">License key</span>
            <div class="flex items-center gap-2">
                <span class="flex-1 rounded-md bg-muted/50 px-3 py-1.5 font-mono text-xs">
                    @_product.LicenseKey
                </span>
                <ButtonCn Class="h-7 gap-1 px-2 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="CopyKey">
                    @if (_copied)
                    {
                        <LucideCheckCn Size="16" Class="size-3" />
                        <text>Copied</text>
                    }
                    else
                    {
                        <LucideCopyCn Size="16" Class="size-3" />
                        <text>Copy</text>
                    }
                </ButtonCn>
            </div>
        </div>

        @* Expiration Notice *@
        <div class="flex items-start gap-2 px-4 py-3">
            <LucideInfoCn Size="16" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
            <p class="text-xs text-muted-foreground">
                Download links expire in @_product.ExpiresIn. After expiration, contact support to
                request a new download link. Your license key does not expire.
            </p>
        </div>
    </div>
</section>

@code {
    private record FileInfo(string Id, string Format, string Label, string Size, string Icon);
    private record ProductInfo(string Title, string OrderId, string PurchaseDate, string LicenseKey, int DownloadsUsed, int DownloadsMax, string ExpiresIn, FileInfo[] Files);

    private static readonly ProductInfo _product = new(
        "The Complete Guide to System Design",
        "ORD-48291",
        "Mar 12, 2026",
        "SD26-K9F2-M3PL-7XWQ",
        2, 5, "28 days",
        new FileInfo[]
        {
            new("f1", "PDF", "PDF Document", "24.3 MB", "pdf"),
            new("f2", "EPUB", "EPUB eBook", "18.7 MB", "epub"),
            new("f3", "MP3", "MP3 Audiobook", "312 MB", "audio")
        }
    );

    private string _selectedFormat = "PDF";
    private bool _copied;

    private int DownloadsRemaining => _product.DownloadsMax - _product.DownloadsUsed;

    private async Task CopyKey()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
