@* ============================================================
   Block: storefront-pre-order
   Title: Storefront Pre Order
   Description: Pre-order product block with release date, deposit pricing, exclusive benefits, email signup, and social proof counter
   Dependencies: ButtonCn, InputCn, LabelCn, LucideCalendarCn, LucideMailCn, LucidePackageCn, LucideUsersCn
   Source: original/blocks/storefront/storefront-pre-order.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucidePackageCn Size="16" Class="size-4 text-muted-foreground" />
                <h1 class="text-sm font-medium">Pre-Order</h1>
            </div>
        </div>

        @* Product Info *@
        <div class="flex items-start gap-3 border-b px-4 py-3">
            <div class="flex size-20 shrink-0 items-center justify-center rounded-md bg-muted/50">
                <LucidePackageCn Size="16" Class="size-7 text-muted-foreground/60" />
            </div>
            <div class="min-w-0 flex-1">
                <span class="text-sm font-medium">Nova Pro Wireless Headphones</span>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Active noise cancellation &middot; 40-hour battery &middot; Spatial audio
                </p>
                <div class="mt-1.5 flex items-center gap-1.5">
                    <LucideCalendarCn Size="16" Class="size-3 text-muted-foreground" />
                    <span class="text-xs font-medium text-muted-foreground">
                        Coming March 28, 2026
                    </span>
                </div>
                <div class="mt-1 flex items-baseline gap-1">
                    <span class="text-2xl font-semibold tabular-nums">$245</span>
                </div>
            </div>
        </div>

        @* Deposit Info *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">
                Payment breakdown
            </span>
            <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                    <span class="text-xs">Deposit due now</span>
                    <span class="text-sm font-semibold tabular-nums">$50</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Remaining balance on ship</span>
                    <span class="text-xs tabular-nums text-muted-foreground">$195</span>
                </div>
                <div class="flex items-center justify-between border-t pt-1.5">
                    <span class="text-xs font-medium">Total</span>
                    <span class="text-sm font-semibold tabular-nums">$245</span>
                </div>
            </div>
        </div>

        @* Pre-Order Benefits *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">
                Pre-order benefits
            </span>
            <ul class="space-y-2">
                @foreach (var benefit in _benefits)
                {
                    <li class="flex items-center gap-2 text-xs">
                        <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                        @benefit
                    </li>
                }
            </ul>
        </div>

        @* Email for Updates *@
        <div class="border-b px-4 py-3">
            <LabelCn Class="mb-1 block text-xs font-medium text-muted-foreground" For="preorder-email">
                Email for updates
            </LabelCn>
            <div class="flex items-center gap-2">
                <LucideMailCn Size="16" Class="size-3.5 shrink-0 text-muted-foreground" />
                <InputCn Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0"
                         id="preorder-email"
                         placeholder="you@example.com"
                         Type="email"
                         @bind-Value="_email" />
            </div>
            <p class="mt-1 text-xs text-muted-foreground">
                Get notified about shipping updates and release news
            </p>
        </div>

        @* Pre-Order Button *@
        <div class="border-b px-4 py-3">
            <ButtonCn Class="h-8 w-full text-xs" Size="ButtonSize.Sm">
                Pre-Order Now &mdash; $50 Deposit
            </ButtonCn>
            <p class="mt-2 text-center text-xs text-muted-foreground">
                Fully refundable if you cancel before shipping
            </p>
        </div>

        @* Social Proof *@
        <div class="px-4 py-3">
            <div class="flex items-center justify-center gap-1.5">
                <LucideUsersCn Size="16" Class="size-3.5 text-muted-foreground" />
                <span class="text-xs text-muted-foreground">
                    <span class="font-medium tabular-nums">1,247</span> pre-orders placed
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _benefits =
    {
        "Priority shipping \u2014 first to receive",
        "Exclusive Midnight Blue colorway",
        "Early access to companion app",
        "Limited edition packaging"
    };

    private string _email = "";
}
