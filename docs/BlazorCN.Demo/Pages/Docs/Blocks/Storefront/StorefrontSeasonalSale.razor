@* ============================================================
   Block: storefront-seasonal-sale
   Title: Storefront Seasonal Sale
   Description: Seasonal sale component with featured deals, copyable promo code, category links, and sale stats
   Dependencies: ButtonCn, LucideCheckCn, LucideCopyCn, LucideLoader2Cn, LucidePackageCn, LucideShoppingBagCn
   Source: original/blocks/storefront/storefront-seasonal-sale.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Winter Sale</p>
            <p class="text-xs text-muted-foreground">
                Up to 40% off select items through end of season
            </p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between rounded-md bg-muted/50 p-3">
                <div>
                    <p class="text-xs text-muted-foreground">Promo code</p>
                    <p class="font-mono text-sm font-medium">@PromoCode</p>
                </div>
                <ButtonCn Class="h-6 gap-1 px-2 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="HandleCopyCode">
                    @if (_copied)
                    {
                        <LucideCheckCn Size="16" Class="size-3" />
                        <text>Copied</text>
                    }
                    else
                    {
                        <LucideCopyCn Size="16" Class="size-3" />
                        <text>Copy</text>
                    }
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-3 overflow-x-auto border-b px-4 py-3">
            @foreach (var cat in _categoryLinks)
            {
                <a class="shrink-0 text-xs text-muted-foreground transition-colors hover:text-foreground"
                   href="#">
                    @cat
                </a>
            }
        </div>

        <div>
            @for (var i = 0; i < _saleProducts.Length; i++)
            {
                var product = _saleProducts[i];
                var discount = (int)Math.Round((double)(product.OriginalPrice - product.SalePrice) / product.OriginalPrice * 100);
                var isLast = i == _saleProducts.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-4 px-4 py-3", !isLast ? "border-b" : "")">
                    <div class="flex size-14 shrink-0 items-center justify-center rounded-md border bg-muted/50">
                        <LucidePackageCn Size="16" Class="size-5 text-muted-foreground/60" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@product.Name</p>
                        <p class="text-xs text-muted-foreground">@product.Category</p>
                    </div>
                    <div class="shrink-0 text-right">
                        <div class="flex items-baseline gap-2">
                            <span class="text-sm font-medium tabular-nums">$@product.SalePrice</span>
                            <span class="text-xs tabular-nums text-muted-foreground line-through">
                                $@product.OriginalPrice
                            </span>
                        </div>
                        <span class="text-xs text-muted-foreground">-@discount%</span>
                    </div>
                    <ButtonCn Class="h-7 shrink-0 gap-1 px-2 text-xs"
                              Disabled="@(_addingToCart == product.Id)"
                              Variant="ButtonVariant.Outline"
                              @onclick="@(() => HandleAddToCart(product.Id))">
                        @if (_addingToCart == product.Id)
                        {
                            <LucideLoader2Cn Size="16" Class="size-3 animate-spin" />
                        }
                        else
                        {
                            <LucideShoppingBagCn Size="16" Class="size-3" />
                        }
                    </ButtonCn>
                </div>
            }
        </div>

        <div class="grid grid-cols-3 gap-px border-t bg-border">
            <div class="bg-card px-4 py-3 text-center">
                <p class="text-2xl font-semibold tabular-nums">40%</p>
                <p class="text-xs text-muted-foreground">Max Discount</p>
            </div>
            <div class="bg-card px-4 py-3 text-center">
                <p class="text-2xl font-semibold tabular-nums">200+</p>
                <p class="text-xs text-muted-foreground">Items on Sale</p>
            </div>
            <div class="bg-card px-4 py-3 text-center">
                <p class="text-sm font-medium">Free</p>
                <p class="text-xs text-muted-foreground">Shipping $100+</p>
            </div>
        </div>
    </div>
</section>

@code {
    private record SaleProduct(int Id, string Name, int OriginalPrice, int SalePrice, string Category);

    private const string PromoCode = "WINTER40";

    private static readonly SaleProduct[] _saleProducts =
    {
        new(1, "Wool Blend Overcoat", 385, 231, "Outerwear"),
        new(2, "Cashmere Sweater", 245, 147, "Knitwear"),
        new(3, "Leather Chelsea Boots", 295, 177, "Footwear"),
        new(4, "Structured Tote Bag", 189, 113, "Accessories")
    };

    private static readonly string[] _categoryLinks = { "All Sale", "Outerwear", "Knitwear", "Footwear", "Accessories" };

    private bool _copied;
    private int? _addingToCart;

    private async Task HandleCopyCode()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }

    private async Task HandleAddToCart(int productId)
    {
        _addingToCart = productId;
        StateHasChanged();
        await Task.Delay(1000);
        _addingToCart = null;
    }
}
