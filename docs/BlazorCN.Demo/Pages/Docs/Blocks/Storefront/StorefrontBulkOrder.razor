@* ============================================================
   Block: storefront-bulk-order
   Title: Storefront Bulk Order
   Description: Bulk and wholesale ordering form with quantity tier price breaks, minimum order quantity, estimated delivery timeline, and an interactive volume discount calculator
   Dependencies: ButtonCn, InputCn, LucideMinusCn, LucidePackageCn, LucidePlusCn, LucideTruckCn
   Source: original/blocks/storefront/storefront-bulk-order.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Product Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucidePackageCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <h2 class="text-sm font-medium">@ProductName</h2>
                    <div class="flex items-center gap-2">
                        <span class="text-xs text-muted-foreground">Retail price: $@BasePrice/unit</span>
                        <span class="text-xs text-muted-foreground">&middot;</span>
                        <span class="text-xs text-muted-foreground">Min. order: @MinOrder units</span>
                    </div>
                </div>
            </div>
        </div>

        @* Pricing Tiers *@
        <div class="border-b">
            <div class="px-4 py-2.5">
                <span class="text-xs font-medium text-muted-foreground">Volume pricing</span>
            </div>
            @for (var i = 0; i < _tiers.Length; i++)
            {
                var t = _tiers[i];
                var isActive = CurrentTier?.MinQty == t.MinQty;
                var tierDiscount = (int)Math.Round((BasePrice - t.UnitPrice) / BasePrice * 100);
                var isLast = i == _tiers.Length - 1;
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-2.5", !isLast ? "border-b" : "", isActive ? "bg-muted/50" : "")">
                    <div class="flex items-center gap-3">
                        @if (isActive)
                        {
                            <span class="size-1.5 rounded-full bg-primary"></span>
                        }
                        <span class="@Cn.Merge("text-xs", isActive ? "font-medium" : "text-muted-foreground")">@t.Label</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="text-xs text-muted-foreground">-@tierDiscount%</span>
                        <span class="@Cn.Merge("text-sm tabular-nums", isActive ? "font-medium" : "")">$@t.UnitPrice.ToString("F2")</span>
                    </div>
                </div>
            }
        </div>

        @* Quantity Selector *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">Order quantity</span>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-8 p-0" Disabled="@(_quantity <= 0)" @onclick="() => IncrementQuantity(-25)">
                    <LucideMinusCn Size="16" Class="size-3" />
                </ButtonCn>
                <InputCn Class="h-8 w-24 text-center text-sm tabular-nums" type="number" @bind-Value="_quantityStr" />
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-8 p-0" Disabled="@(_quantity >= 9999)" @onclick="() => IncrementQuantity(25)">
                    <LucidePlusCn Size="16" Class="size-3" />
                </ButtonCn>
                <span class="text-xs text-muted-foreground">units</span>
            </div>
            @if (!IsValidOrder && _quantity > 0)
            {
                <p class="mt-1.5 text-xs text-red-600 dark:text-red-400">Minimum order quantity is @MinOrder units</p>
            }
        </div>

        @* Order Summary *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">Order summary</span>
            <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Unit price</span>
                    <span class="text-xs tabular-nums">$@UnitPrice.ToString("F2")</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Quantity</span>
                    <span class="text-xs tabular-nums">@_quantity</span>
                </div>
                @if (IsValidOrder)
                {
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-muted-foreground">Discount</span>
                        <span class="text-xs tabular-nums text-emerald-600 dark:text-emerald-400">
                            -@DiscountPercent% (save $@Savings.ToString("F2"))
                        </span>
                    </div>
                }
                <div class="border-t pt-1.5">
                    <div class="flex items-baseline justify-between">
                        <span class="text-sm font-medium">Total</span>
                        <span class="text-2xl font-semibold tabular-nums">
                            @(IsValidOrder ? $"${TotalPrice.ToString("F2")}" : "$\u2014")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        @* Estimated Delivery *@
        @if (IsValidOrder)
        {
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideTruckCn Size="16" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs text-muted-foreground">Estimated delivery: @EstimatedDelivery</span>
                </div>
            </div>
        }

        @* Add to Cart *@
        <div class="px-4 py-3">
            <ButtonCn Class="h-8 w-full text-xs" Size="ButtonSize.Sm" Disabled="@(!IsValidOrder)">
                @(IsValidOrder ? $"Add to Cart — ${TotalPrice.ToString("F2")}" : $"Minimum {MinOrder} units required")
            </ButtonCn>
            @if (_quantity >= 500)
            {
                <p class="mt-2 text-center text-xs text-muted-foreground">For orders over 1,000 units, contact us for custom pricing</p>
            }
        </div>
    </div>
</section>

@code {
    private record PriceTier(int MinQty, int? MaxQty, decimal UnitPrice, string Label);

    private const string ProductName = "Premium Cotton T-Shirt (Blank)";
    private const decimal BasePrice = 24.99m;
    private const int MinOrder = 25;

    private static readonly PriceTier[] _tiers =
    {
        new(25, 49, 18.99m, "25-49 units"),
        new(50, 99, 15.99m, "50-99 units"),
        new(100, 249, 12.99m, "100-249 units"),
        new(250, 499, 10.99m, "250-499 units"),
        new(500, null, 8.99m, "500+ units")
    };

    private int _quantity = 50;
    private string _quantityStr
    {
        get => _quantity.ToString();
        set
        {
            if (int.TryParse(value, out var num) && num >= 0 && num <= 9999)
                _quantity = num;
        }
    }

    private PriceTier? CurrentTier
    {
        get
        {
            for (var i = _tiers.Length - 1; i >= 0; i--)
                if (_quantity >= _tiers[i].MinQty) return _tiers[i];
            return null;
        }
    }

    private decimal UnitPrice => CurrentTier?.UnitPrice ?? BasePrice;
    private decimal TotalPrice => UnitPrice * _quantity;
    private decimal Savings => (BasePrice - UnitPrice) * _quantity;
    private int DiscountPercent => (int)Math.Round((BasePrice - UnitPrice) / BasePrice * 100);
    private bool IsValidOrder => _quantity >= MinOrder;

    private string EstimatedDelivery => _quantity switch
    {
        <= 99 => "5-7 business days",
        <= 249 => "7-10 business days",
        <= 499 => "10-14 business days",
        _ => "14-21 business days"
    };

    private void IncrementQuantity(int amount) => _quantity = Math.Max(0, Math.Min(9999, _quantity + amount));
}
