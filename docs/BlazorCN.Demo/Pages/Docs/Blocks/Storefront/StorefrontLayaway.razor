@* ============================================================
   Block: storefront-layaway
   Title: Storefront Layaway
   Description: Layaway plan configurator with payment frequency selector, installment calculator, down payment breakdown, terms summary, and plan activation
   Dependencies: ButtonCn, LucideCalendarCn, LucideCheckCn, LucidePackageCn
   Source: original/blocks/storefront/storefront-layaway.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideCalendarCn Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Layaway Plan</h2>
            </div>
        </div>

        @* Product Info *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-12 shrink-0 items-center justify-center rounded-md bg-muted/50">
                <LucidePackageCn Size="16" Class="size-4 text-muted-foreground/60" />
            </div>
            <div class="min-w-0 flex-1">
                <p class="text-sm font-medium">Samsung 65&quot; QLED 4K Smart TV</p>
                <p class="font-mono text-xs text-muted-foreground">TV-QLED-65-4K</p>
            </div>
            <span class="shrink-0 text-2xl font-semibold tabular-nums">$@ProductPrice.ToString("F2")</span>
        </div>

        @* Frequency Selector *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Payment Frequency</p>
            <div class="flex gap-2">
                @foreach (var opt in _frequencies)
                {
                    var isActive = _frequency == opt.Id;
                    <button type="button"
                            class="@Cn.Merge("flex-1 rounded-md px-3 py-2 text-center transition-colors", isActive ? "bg-primary text-primary-foreground" : "bg-muted/50 text-muted-foreground hover:bg-muted")"
                            @onclick="() => { _frequency = opt.Id; _showSchedule = false; }">
                        <p class="text-xs font-medium">@opt.Label</p>
                        <p class="@Cn.Merge("text-[10px]", isActive ? "text-primary-foreground/70" : "text-muted-foreground")">@opt.PeriodLabel</p>
                    </button>
                }
            </div>
        </div>

        @* Payment Breakdown *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Payment Breakdown</p>
            <div class="space-y-2">
                <div class="flex items-center justify-between">
                    <span class="text-sm">Down payment (@DownPaymentPercent%)</span>
                    <span class="text-sm font-medium tabular-nums">$@DownPayment.ToString("F2")</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-sm">@SelectedFreq?.Installments @_frequency payments</span>
                    <span class="text-sm font-medium tabular-nums">$@InstallmentAmount.ToString("F2") each</span>
                </div>
                <div class="border-t pt-2">
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-medium">Total</span>
                        <span class="text-sm font-medium tabular-nums">$@ProductPrice.ToString("N2")</span>
                    </div>
                    <p class="mt-0.5 text-right text-[10px] text-muted-foreground">No interest or fees</p>
                </div>
            </div>
        </div>

        @* Payment Schedule *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">Payment Schedule</span>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="h-6 px-2 text-xs" @onclick="() => _showSchedule = !_showSchedule">
                    @(_showSchedule ? "Hide" : "View")
                </ButtonCn>
            </div>
            @if (_showSchedule)
            {
                <div class="mt-2 rounded-md bg-muted/50 p-3">
                    <div class="space-y-1.5">
                        <div class="flex items-center justify-between">
                            <span class="flex items-center gap-2 text-xs">
                                <span class="text-muted-foreground">Due today</span>
                                <span class="text-[10px] text-muted-foreground">(down payment)</span>
                            </span>
                            <span class="text-xs font-medium tabular-nums">$@DownPayment.ToString("F2")</span>
                        </div>
                        @{ var dates = _scheduleDates[_frequency]; }
                        @for (var i = 0; i < dates.Length; i++)
                        {
                            <div class="flex items-center justify-between">
                                <span class="flex items-center gap-2 text-xs">
                                    <span class="text-muted-foreground">@(i + 1).</span>
                                    <span>@dates[i]</span>
                                </span>
                                <span class="text-xs font-medium tabular-nums">$@InstallmentAmount.ToString("F2")</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Terms *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Terms</p>
            <div class="space-y-1.5">
                @foreach (var term in _terms)
                {
                    <div class="flex items-start gap-2">
                        <span class="mt-1.5 size-1 shrink-0 rounded-full bg-muted-foreground"></span>
                        <p class="text-xs text-muted-foreground">@term</p>
                    </div>
                }
            </div>
        </div>

        @* Activate Button *@
        <div class="px-4 py-3">
            @if (_activated)
            {
                <div class="flex items-center justify-center gap-2 py-1">
                    <LucideCheckCn Size="16" Class="size-4 text-emerald-500" />
                    <span class="text-sm font-medium">Plan Activated</span>
                </div>
            }
            else
            {
                <ButtonCn Class="h-8 w-full text-xs" Size="ButtonSize.Sm" @onclick="() => _activated = true">
                    Activate Layaway — $@DownPayment.ToString("F2") due today
                </ButtonCn>
            }
        </div>
    </div>
</section>

@code {
    private record FrequencyOption(string Id, string Label, int Installments, string PeriodLabel);

    private const decimal ProductPrice = 1299.99m;
    private const int DownPaymentPercent = 20;

    private static readonly FrequencyOption[] _frequencies =
    {
        new("weekly", "Weekly", 12, "12 weeks"),
        new("biweekly", "Bi-weekly", 8, "16 weeks"),
        new("monthly", "Monthly", 4, "4 months")
    };

    private static readonly Dictionary<string, string[]> _scheduleDates = new()
    {
        ["weekly"] = new[] { "Mar 16, 2026", "Mar 23, 2026", "Mar 30, 2026", "Apr 6, 2026", "Apr 13, 2026", "Apr 20, 2026", "Apr 27, 2026", "May 4, 2026", "May 11, 2026", "May 18, 2026", "May 25, 2026", "Jun 1, 2026" },
        ["biweekly"] = new[] { "Mar 16, 2026", "Mar 30, 2026", "Apr 13, 2026", "Apr 27, 2026", "May 11, 2026", "May 25, 2026", "Jun 8, 2026", "Jun 22, 2026" },
        ["monthly"] = new[] { "Mar 16, 2026", "Apr 16, 2026", "May 16, 2026", "Jun 16, 2026" }
    };

    private static readonly string[] _terms =
    {
        "Item is reserved upon plan activation and ships after final payment.",
        "Missed payments have a 7-day grace period before plan cancellation.",
        "Cancellations receive a full refund minus a 5% restocking fee.",
        "No interest or additional fees are charged on layaway plans."
    };

    private string _frequency = "biweekly";
    private bool _showSchedule;
    private bool _activated;

    private FrequencyOption? SelectedFreq => _frequencies.FirstOrDefault(f => f.Id == _frequency);
    private decimal DownPayment => Math.Round(ProductPrice * DownPaymentPercent / 100m, 2);
    private decimal RemainingBalance => ProductPrice - DownPayment;
    private decimal InstallmentAmount => SelectedFreq != null ? Math.Round(RemainingBalance / SelectedFreq.Installments, 2) : 0;
}
