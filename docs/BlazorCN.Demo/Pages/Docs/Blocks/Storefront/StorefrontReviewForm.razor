@* ============================================================
   Block: storefront-review-form
   Title: Storefront Review Form
   Description: Write a review form with interactive star rating selector, title and body inputs, photo upload area, pros and cons fields, and a recommendation toggle
   Dependencies: ButtonCn, InputCn, LabelCn, SwitchCn, LucideImageCn, LucidePlusCn, LucideStarCn, LucideXCn
   Source: original/blocks/storefront/storefront-review-form.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Write a Review</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Merino Wool Crewneck Sweater</p>
        </div>

        @* Star Rating *@
        <div class="border-b px-4 py-3">
            <LabelCn Class="mb-2 block text-xs font-medium text-muted-foreground">
                Overall rating
            </LabelCn>
            <div class="flex items-center gap-3">
                <div class="flex gap-0.5">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var star = i;
                        <button aria-label="@($"Rate {star} out of 5")" type="button"
                                @onclick="() => { _rating = star; }"
                                @onmouseenter="() => { _hoverRating = star; }"
                                @onmouseleave="() => { _hoverRating = 0; }"
                                class="p-0.5 transition-colors">
                            <LucideStarCn Size="20"
                                          Class="@(star <= DisplayRating ? "fill-primary text-primary" : "fill-muted text-muted")" />
                        </button>
                    }
                </div>
                @if (DisplayRating > 0)
                {
                    <span class="text-xs text-muted-foreground">@_ratingLabels[DisplayRating]</span>
                }
            </div>
        </div>

        @* Review Title *@
        <div class="border-b px-4 py-3">
            <LabelCn Class="mb-1 block text-xs font-medium text-muted-foreground" For="review-title">
                Review title
            </LabelCn>
            <InputCn id="review-title"
                      Class="h-8 text-xs"
                      Placeholder="Summarize your experience"
                      @bind-Value="_title"
                      maxlength="100" />
            <span class="mt-1 block text-right text-[10px] text-muted-foreground tabular-nums">
                @(_title.Length)/100
            </span>
        </div>

        @* Review Body *@
        <div class="border-b px-4 py-3">
            <LabelCn Class="mb-1 block text-xs font-medium text-muted-foreground" For="review-body">
                Your review
            </LabelCn>
            <TextareaCn id="review-body"
                      Class="resize-none text-xs"
                      Placeholder="What did you like or dislike? How did you use this product?"
                      rows="4"
                      maxlength="2000"
                      @bind-Value="_body" />
            <span class="mt-1 block text-right text-[10px] text-muted-foreground tabular-nums">
                @(_body.Length)/2000
            </span>
        </div>

        @* Photo Upload *@
        <div class="border-b px-4 py-3">
            <LabelCn Class="mb-2 block text-xs font-medium text-muted-foreground">
                Add photos (optional)
            </LabelCn>
            <div class="flex items-center gap-2">
                <button type="button"
                        @onclick="() => { if (_photoCount < 5) _photoCount++; }"
                        class="flex size-16 flex-col items-center justify-center gap-1 rounded-md border border-dashed transition-colors hover:border-foreground/50 hover:bg-muted/50">
                    <LucideImageCn Size="16" Class="text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">Add</span>
                </button>
                @for (int i = 0; i < _photoCount; i++)
                {
                    <div class="relative flex size-16 items-center justify-center rounded-md bg-muted">
                        <LucideImageCn Size="16" Class="text-muted-foreground/40" />
                        <button aria-label="Remove photo" type="button"
                                @onclick="() => _photoCount--"
                                Class="absolute -right-1 -top-1 flex size-4 items-center justify-center rounded-full bg-foreground text-background">
                            <LucideXCn Size="10" />
                        </button>
                    </div>
                }
            </div>
            <span class="mt-1.5 block text-[10px] text-muted-foreground">
                Up to 5 photos. JPG or PNG, max 10MB each.
            </span>
        </div>

        @* Pros *@
        <div class="border-b px-4 py-3">
            <LabelCn Class="mb-2 block text-xs font-medium text-muted-foreground">Pros</LabelCn>
            @if (_pros.Count > 0)
            {
                <div class="mb-2 flex flex-wrap gap-1.5">
                    @foreach (var (pro, idx) in _pros.Select((p, i) => (p, i)))
                    {
                        var capturedIdx = idx;
                        <span class="flex items-center gap-1 rounded bg-emerald-500/10 px-2 py-0.5 text-[11px] text-emerald-700 dark:text-emerald-400">
                            @pro
                            <button aria-label="@($"Remove {pro}")" type="button" @onclick="() => _pros.RemoveAt(capturedIdx)" class="hover:opacity-70">
                                <LucideXCn Size="10" />
                            </button>
                        </span>
                    }
                </div>
            }
            <div class="flex gap-2">
                <InputCn aria-label="Add a pro" Class="h-7 flex-1 text-xs"
                          Placeholder="e.g. Soft fabric, great fit"
                          @bind-Value="_proInput" />
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 px-2"
                           @onclick="AddPro"
                           Disabled="@(string.IsNullOrWhiteSpace(_proInput) || _pros.Count >= 5)"
                           aria-label="Add pro">
                    <LucidePlusCn Size="12" />
                </ButtonCn>
            </div>
        </div>

        @* Cons *@
        <div class="border-b px-4 py-3">
            <LabelCn Class="mb-2 block text-xs font-medium text-muted-foreground">Cons</LabelCn>
            @if (_cons.Count > 0)
            {
                <div class="mb-2 flex flex-wrap gap-1.5">
                    @foreach (var (con, idx) in _cons.Select((c, i) => (c, i)))
                    {
                        var capturedIdx = idx;
                        <span class="flex items-center gap-1 rounded bg-red-500/10 px-2 py-0.5 text-[11px] text-red-700 dark:text-red-400">
                            @con
                            <button aria-label="@($"Remove {con}")" type="button" @onclick="() => _cons.RemoveAt(capturedIdx)" class="hover:opacity-70">
                                <LucideXCn Size="10" />
                            </button>
                        </span>
                    }
                </div>
            }
            <div class="flex gap-2">
                <InputCn aria-label="Add a con" Class="h-7 flex-1 text-xs"
                          Placeholder="e.g. Runs small, limited colors"
                          @bind-Value="_conInput" />
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 px-2"
                           @onclick="AddCon"
                           Disabled="@(string.IsNullOrWhiteSpace(_conInput) || _cons.Count >= 5)"
                           aria-label="Add con">
                    <LucidePlusCn Size="12" />
                </ButtonCn>
            </div>
        </div>

        @* Recommend Toggle *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-sm font-medium">Would you recommend this product?</span>
                    <p class="text-xs text-muted-foreground">
                        @(_recommend ? "Yes, I would recommend this product" : "No, I would not recommend this product")
                    </p>
                </div>
                <SwitchCn aria-label="Recommend this product" Checked="_recommend" CheckedChanged="v => _recommend = v" />
            </div>
        </div>

        @* Submit *@
        <div class="px-4 py-3">
            <ButtonCn Class="h-8 w-full text-xs" Size="ButtonSize.Sm"
                       Disabled="@(_rating == 0 || string.IsNullOrWhiteSpace(_title) || string.IsNullOrWhiteSpace(_body))">
                Submit Review
            </ButtonCn>
            <p class="mt-2 text-center text-xs text-muted-foreground">
                Your review will be posted after moderation
            </p>
        </div>
    </div>
</section>

@code {
    private int _rating;
    private int _hoverRating;
    private string _title = "";
    private string _body = "";
    private List<string> _pros = new();
    private List<string> _cons = new();
    private string _proInput = "";
    private string _conInput = "";
    private bool _recommend = true;
    private int _photoCount;

    private int DisplayRating => _hoverRating > 0 ? _hoverRating : _rating;

    private static readonly string[] _ratingLabels = { "", "Poor", "Fair", "Good", "Very Good", "Excellent" };

    private void AddPro()
    {
        if (!string.IsNullOrWhiteSpace(_proInput) && _pros.Count < 5)
        {
            _pros.Add(_proInput.Trim());
            _proInput = "";
        }
    }

    private void AddCon()
    {
        if (!string.IsNullOrWhiteSpace(_conInput) && _cons.Count < 5)
        {
            _cons.Add(_conInput.Trim());
            _conInput = "";
        }
    }
}
