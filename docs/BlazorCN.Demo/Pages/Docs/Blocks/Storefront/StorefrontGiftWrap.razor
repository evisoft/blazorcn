@* ============================================================
   Block: storefront-gift-wrap
   Title: Storefront Gift Wrap
   Description: Storefront gift wrapping selector with wrapping tier options, gift message textarea with character counter, gift receipt checkbox, and order summary
   Long Description: Storefront gift finder quiz to help customers discover the right product
   Dependencies: ButtonCn, CheckboxCn, LucideGiftCn
   Source: original/blocks/storefront/storefront-gift-wrap.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header *@
            <div class="flex items-center gap-2 border-b px-4 py-3">
                <LucideGiftCn Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Gift Wrapping</h2>
            </div>

            @* Wrapping options *@
            <div class="border-b">
                @for (var i = 0; i < _wrapOptions.Length; i++)
                {
                    var option = _wrapOptions[i];
                    var isLast = i == _wrapOptions.Length - 1;
                    <button
                        class="@(Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", !isLast ? "border-b" : ""))"
                        @onclick="@(() => _selected = option.Id)"
                        type="button">
                        <span class="@(Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded-full border", _selected == option.Id ? "border-primary bg-primary" : "border-muted-foreground/30"))">
                            @if (_selected == option.Id)
                            {
                                <span class="size-1.5 rounded-full bg-primary-foreground"></span>
                            }
                        </span>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@option.Name</span>
                            <p class="mt-0.5 text-xs text-muted-foreground">@option.Description</p>
                        </div>
                        <span class="shrink-0 text-sm font-medium tabular-nums">
                            @(option.Price == 0 ? "Free" : $"+${option.Price}")
                        </span>
                    </button>
                }
            </div>

            @* Gift message *@
            <div class="border-b px-4 py-3">
                <div class="mb-2 flex items-center justify-between">
                    <span class="text-xs font-medium text-muted-foreground">Gift Message</span>
                    <span class="text-xs text-muted-foreground tabular-nums">
                        @_message.Length/@MaxMessageLength
                    </span>
                </div>
                <TextareaCn
                    maxlength="@MaxMessageLength"
                    Placeholder="Write a personal message for the recipient..."
                    rows="3"
                    @bind-Value="_message" />
            </div>

            @* Gift receipt *@
            <div class="border-b px-4 py-3">
                <span class="flex items-center gap-2">
                    <CheckboxCn
                        @bind-Checked="_includeReceipt"
                        Id="gift-receipt" />
                    <label for="gift-receipt">
                        <span class="text-sm font-medium">Include gift receipt</span>
                        <p class="text-xs text-muted-foreground">
                            Prices will be hidden from the packing slip
                        </p>
                    </label>
                </span>
            </div>

            @* Summary *@
            <div class="px-4 py-3">
                <div class="mb-3 rounded-md bg-muted/50 p-3">
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-muted-foreground">Wrapping</span>
                        <span class="text-xs font-medium">@SelectedOption?.Name</span>
                    </div>
                    @if (_message.Length > 0)
                    {
                        <div class="mt-1.5 flex items-center justify-between">
                            <span class="text-xs text-muted-foreground">Message</span>
                            <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">Included</span>
                        </div>
                    }
                    @if (_includeReceipt)
                    {
                        <div class="mt-1.5 flex items-center justify-between">
                            <span class="text-xs text-muted-foreground">Gift receipt</span>
                            <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">Included</span>
                        </div>
                    }
                </div>
                <ButtonCn Class="h-8 w-full text-xs" Size="ButtonSize.Sm">
                    @ButtonText
                </ButtonCn>
            </div>
        </div>
    </section>
</section>

@code {
    private const int MaxMessageLength = 150;

    private string _selected = "standard";
    private string _message = "";
    private bool _includeReceipt;

    private record WrapOption(string Id, string Name, string Description, decimal Price);

    private static readonly WrapOption[] _wrapOptions =
    [
        new("standard", "Standard", "Kraft paper with twine bow", 0m),
        new("premium", "Premium", "White paper with fabric ribbon", 5m),
        new("luxury", "Luxury", "Matte black box with tissue paper and satin ribbon", 12m)
    ];

    private WrapOption? SelectedOption => _wrapOptions.FirstOrDefault(o => o.Id == _selected);

    private string ButtonText =>
        SelectedOption is not null && SelectedOption.Price > 0
            ? $"Add to Order — ${SelectedOption.Price}"
            : "Add to Order";
}
