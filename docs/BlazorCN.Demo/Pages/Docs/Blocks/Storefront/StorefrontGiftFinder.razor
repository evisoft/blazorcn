@* ============================================================
   Block: storefront-gift-finder
   Title: Storefront Gift Finder
   Description: Storefront gift finder quiz to help customers discover the right product
   Dependencies: ButtonCn, LabelCn, LucideArrowLeftCn, LucideArrowRightCn, LucidePackageCn, LucideRotateCcwCn, ProgressCn, RadioGroupCn, RadioGroupItemCn
   Source: original/blocks/storefront/storefront-gift-finder.tsx
   ============================================================ *@

@if (_showResults)
{
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Results Header *@
            <div class="flex items-center justify-between border-b px-4 py-3">
                <div>
                    <h2 class="text-sm font-medium">Your Recommendations</h2>
                    <p class="text-xs text-muted-foreground">@_sampleResults.Length products matched</p>
                </div>
                <ButtonCn Class="h-7 gap-1 px-2 text-xs" Variant="ButtonVariant.Outline" @onclick="HandleReset">
                    <LucideRotateCcwCn Size="16" Class="size-3" />
                    Start Over
                </ButtonCn>
            </div>

            @* Results List *@
            @for (var i = 0; i < _sampleResults.Length; i++)
            {
                var product = _sampleResults[i];
                var isLast = i == _sampleResults.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", !isLast ? "border-b" : "")">
                    <div class="flex size-12 shrink-0 items-center justify-center rounded-md border bg-muted/50">
                        <LucidePackageCn Size="16" Class="size-4 text-muted-foreground/60" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@product.Name</p>
                        <p class="text-xs text-muted-foreground">$@product.Price</p>
                    </div>
                    <span class="rounded bg-primary/10 px-1.5 py-0.5 font-mono text-[10px] font-medium text-primary">@product.Match%</span>
                    <ButtonCn Class="h-7 px-2 text-xs" Variant="ButtonVariant.Outline">View</ButtonCn>
                </div>
            }
        </div>
    </section>
}
else
{
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header with Progress *@
            <div class="border-b px-4 py-3">
                <div class="mb-2 flex items-center justify-between">
                    <h2 class="text-sm font-medium">Gift Finder</h2>
                    <span class="text-xs text-muted-foreground">Step @(_currentStep + 1) of @_questions.Length</span>
                </div>
                <ProgressCn Value="@Progress" Class="h-1.5" />
            </div>

            @* Question *@
            <div class="border-b px-4 py-3">
                <p class="text-sm font-medium">@CurrentQuestion.Title</p>
                <p class="text-xs text-muted-foreground">@CurrentQuestion.Subtitle</p>
            </div>

            @* Options *@
            <RadioGroupCn Value="@(_answers.GetValueOrDefault(CurrentQuestion.Id, ""))" ValueChanged="HandleAnswer">
                @for (var i = 0; i < CurrentQuestion.Options.Length; i++)
                {
                    var option = CurrentQuestion.Options[i];
                    var isLast = i == CurrentQuestion.Options.Length - 1;
                    <div class="@(!isLast ? "border-b" : "")">
                        <LabelCn Class="flex w-full cursor-pointer items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50"
                                 For="@($"option-{option.Value}")">
                            <RadioGroupItemCn Id="@($"option-{option.Value}")" Value="@option.Value" />
                            <div class="min-w-0 flex-1">
                                <p class="text-sm font-medium">@option.Label</p>
                                @if (!string.IsNullOrEmpty(option.Description))
                                {
                                    <p class="text-xs text-muted-foreground">@option.Description</p>
                                }
                            </div>
                        </LabelCn>
                    </div>
                }
            </RadioGroupCn>

            @* Navigation *@
            <div class="flex items-center justify-between border-t px-4 py-3">
                <ButtonCn Class="h-7 gap-1 px-2 text-xs" Disabled="@(_currentStep == 0)" Variant="ButtonVariant.Ghost" @onclick="HandleBack">
                    <LucideArrowLeftCn Size="16" Class="size-3" />
                    Back
                </ButtonCn>
                <ButtonCn Class="h-7 gap-1 px-2 text-xs" Disabled="@(!CanGoNext)" Variant="ButtonVariant.Outline" @onclick="HandleNext">
                    @(IsLastQuestion ? "See Results" : "Next")
                    <LucideArrowRightCn Size="16" Class="size-3" />
                </ButtonCn>
            </div>
        </div>
    </section>
}

@code {
    private record QuestionOption(string Value, string Label, string? Description = null);
    private record QuestionInfo(string Id, string Title, string Subtitle, QuestionOption[] Options);
    private record ProductResult(int Id, string Name, int Price, int Match);

    private static readonly QuestionInfo[] _questions =
    {
        new("recipient", "Who is this gift for?", "Help us understand the recipient", new QuestionOption[]
        {
            new("him", "Him", "Boyfriend, husband, father, brother"),
            new("her", "Her", "Girlfriend, wife, mother, sister"),
            new("anyone", "Anyone", "Gender-neutral options")
        }),
        new("occasion", "What's the occasion?", "We'll tailor suggestions accordingly", new QuestionOption[]
        {
            new("birthday", "Birthday"),
            new("holiday", "Holiday"),
            new("anniversary", "Anniversary"),
            new("just-because", "Just Because")
        }),
        new("budget", "What's your budget?", "All price ranges have great options", new QuestionOption[]
        {
            new("under-50", "Under $50"),
            new("50-100", "$50 - $100"),
            new("100-200", "$100 - $200"),
            new("over-200", "$200+")
        }),
        new("style", "What's their style?", "Choose what best describes them", new QuestionOption[]
        {
            new("classic", "Classic", "Timeless, elegant pieces"),
            new("modern", "Modern", "Contemporary, minimal designs"),
            new("cozy", "Cozy", "Comfortable, warm items"),
            new("adventurous", "Adventurous", "Bold, unique finds")
        })
    };

    private static readonly ProductResult[] _sampleResults =
    {
        new(1, "Cashmere Blend Scarf", 95, 98),
        new(2, "Leather Card Wallet", 75, 94),
        new(3, "Merino Wool Beanie", 45, 91)
    };

    private int _currentStep;
    private Dictionary<string, string> _answers = new();
    private bool _showResults;

    private QuestionInfo CurrentQuestion => _questions[_currentStep];
    private int Progress => (int)((_currentStep + 1.0) / _questions.Length * 100);
    private bool IsLastQuestion => _currentStep == _questions.Length - 1;
    private bool CanGoNext => _answers.ContainsKey(CurrentQuestion.Id);

    private void HandleAnswer(string value) => _answers[CurrentQuestion.Id] = value;

    private void HandleNext()
    {
        if (IsLastQuestion)
            _showResults = true;
        else
            _currentStep++;
    }

    private void HandleBack()
    {
        if (_currentStep > 0) _currentStep--;
    }

    private void HandleReset()
    {
        _currentStep = 0;
        _answers = new();
        _showResults = false;
    }
}
