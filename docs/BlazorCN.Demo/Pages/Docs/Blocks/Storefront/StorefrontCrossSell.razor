@* ============================================================
   Block: storefront-cross-sell
   Title: Storefront Cross Sell
   Description: Complete the look cross-sell block with selectable complementary products, running total, and bulk add to cart
   Dependencies: ButtonCn, LucideCheckCn, LucidePackageCn, LucideShoppingBagCn, LucideSparklesCn
   Source: original/blocks/storefront/storefront-cross-sell.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideSparklesCn Size="16" Class="size-4 text-muted-foreground" />
                <h1 class="text-sm font-medium">Complete the Look</h1>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Add @DiscountThreshold+ items and save @DiscountPercent% on extras
            </p>
        </div>

        @* Main Product *@
        <div class="flex items-center gap-3 border-b bg-muted/30 px-4 py-3">
            <div class="flex size-14 shrink-0 items-center justify-center rounded-md bg-muted/50">
                <LucidePackageCn Size="16" Class="size-5 text-muted-foreground/60" />
            </div>
            <div class="min-w-0 flex-1">
                <span class="text-sm font-medium">@_mainProduct.Name</span>
                <p class="text-xs text-muted-foreground">@_mainProduct.Color &middot; @_mainProduct.Size</p>
            </div>
            <div class="text-right">
                <span class="text-sm font-medium tabular-nums">$@_mainProduct.Price</span>
                <p class="text-[10px] text-muted-foreground">Your item</p>
            </div>
        </div>

        @* Suggested Items *@
        <div>
            @for (var i = 0; i < _suggestions.Length; i++)
            {
                var item = _suggestions[i];
                var isSelected = _selected.Contains(item.Id);
                var isLast = i == _suggestions.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors", isSelected ? "bg-primary/5" : "", !isLast ? "border-b" : "")">
                    @* Checkbox *@
                    <div aria-checked="@(isSelected ? "true" : "false")" aria-label="@($"Select {item.Name}")" class="@Cn.Merge("flex size-4 shrink-0 cursor-pointer items-center justify-center rounded border transition-colors", isSelected ? "border-primary bg-primary" : "border-muted-foreground/30 hover:border-muted-foreground/50")"
                         @onclick="() => ToggleItem(item.Id)" role="checkbox" tabindex="0">
                        @if (isSelected)
                        {
                            <LucideCheckCn Size="16" Class="size-2.5 text-primary-foreground" />
                        }
                    </div>

                    @* Product Image *@
                    <div class="flex size-12 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        <LucidePackageCn Size="16" Class="size-4 text-muted-foreground/60" />
                    </div>

                    @* Product Info *@
                    <div class="min-w-0 flex-1">
                        <span class="text-sm font-medium">@item.Name</span>
                        <p class="text-xs text-muted-foreground">@item.Category</p>
                    </div>

                    @* Size Selector *@
                    <div class="flex shrink-0 items-center gap-1">
                        @foreach (var size in item.Sizes)
                        {
                            <button type="button"
                                    class="@Cn.Merge("flex h-6 min-w-[28px] items-center justify-center rounded border px-1.5 text-[10px] transition-colors", _sizes[item.Id] == size ? "border-foreground bg-foreground text-background" : "border-muted-foreground/20 text-muted-foreground hover:border-muted-foreground/40")"
                                    @onclick="() => _sizes[item.Id] = size">
                                @size
                            </button>
                        }
                    </div>

                    @* Price *@
                    <span class="shrink-0 text-sm font-medium tabular-nums">$@item.Price</span>
                </div>
            }
        </div>

        @* Summary *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-xs text-muted-foreground">
                        @SelectedItems.Count item@(SelectedItems.Count != 1 ? "s" : "") selected
                    </span>
                    @if (HasDiscount)
                    {
                        <p class="text-xs text-emerald-600 dark:text-emerald-400">
                            You save $@Discount with multi-item discount
                        </p>
                    }
                </div>
                <div class="flex items-baseline gap-2">
                    @if (HasDiscount)
                    {
                        <span class="text-xs text-muted-foreground line-through tabular-nums">
                            $@(_mainProduct.Price + ItemsTotal)
                        </span>
                    }
                    <span class="font-semibold text-2xl tabular-nums">$@FinalTotal</span>
                </div>
            </div>
        </div>

        @* Add to Cart *@
        <div class="border-t px-4 py-3">
            <ButtonCn Class="h-8 w-full text-xs" Size="ButtonSize.Sm">
                <LucideShoppingBagCn Size="16" Class="mr-1.5 size-3" />
                Add All to Cart
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record MainProductInfo(string Name, int Price, string Size, string Color);
    private record CrossSellItemInfo(int Id, string Name, int Price, string[] Sizes, string Category);

    private const int DiscountThreshold = 2;
    private const int DiscountPercent = 10;

    private static readonly MainProductInfo _mainProduct = new("Relaxed Fit Linen Blazer", 195, "M", "Navy");

    private static readonly CrossSellItemInfo[] _suggestions =
    {
        new(1, "Slim Fit Cotton Trousers", 89, new[] { "28", "30", "32", "34", "36" }, "Bottoms"),
        new(2, "Textured Crew Socks (3-Pack)", 24, new[] { "S/M", "L/XL" }, "Accessories"),
        new(3, "Suede Desert Boots", 165, new[] { "8", "9", "10", "11", "12" }, "Shoes"),
        new(4, "Woven Leather Belt", 55, new[] { "S", "M", "L", "XL" }, "Accessories")
    };

    private HashSet<int> _selected = new() { 1, 3 };
    private Dictionary<int, string> _sizes = new() { [1] = "32", [2] = "S/M", [3] = "10", [4] = "M" };

    private List<CrossSellItemInfo> SelectedItems => _suggestions.Where(s => _selected.Contains(s.Id)).ToList();
    private int ItemsTotal => SelectedItems.Sum(i => i.Price);
    private bool HasDiscount => SelectedItems.Count >= DiscountThreshold;
    private int Discount => HasDiscount ? (int)Math.Round(ItemsTotal * DiscountPercent / 100.0) : 0;
    private int FinalTotal => _mainProduct.Price + ItemsTotal - Discount;

    private void ToggleItem(int id)
    {
        if (!_selected.Add(id))
            _selected.Remove(id);
    }
}
