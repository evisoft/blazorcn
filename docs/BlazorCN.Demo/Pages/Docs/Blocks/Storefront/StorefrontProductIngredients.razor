@* ============================================================
   Block: storefront-product-ingredients
   Title: Storefront Product Ingredients
   Description: Product ingredients and materials list with expandable allergen info, sourcing details, and certification indicators for food, cosmetics, and supplement storefronts
   Dependencies: ButtonCn, LucideAlertTriangleCn, LucideChevronRightCn, LucideLeafCn, LucideShieldCheckCn
   Source: original/blocks/storefront/storefront-product-ingredients.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">@ProductName</h2>
            <p class="text-xs text-muted-foreground">
                Ingredients &middot; @_ingredients.Length active compounds
            </p>
        </div>

        @* Allergen Summary *@
        @if (Allergens.Length > 0)
        {
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideTriangleAlertCn Size="16" Class="size-3.5 text-amber-500" />
                    <span class="text-xs font-medium text-muted-foreground">Allergen notice</span>
                </div>
                <p class="mt-1 text-xs text-muted-foreground">
                    Contains: @string.Join(", ", Allergens.Select(a => a.Name))
                </p>
            </div>
        }

        @* Ingredient List *@
        <div>
            @{ var visible = VisibleIngredients; }
            @for (var i = 0; i < visible.Length; i++)
            {
                var ingredient = visible[i];
                var isExpanded = _expanded == ingredient.Id;
                <div class="border-b">
                    <button class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            type="button"
                            @onclick="() => _expanded = isExpanded ? null : ingredient.Id">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", ingredient.IsAllergen ? "bg-amber-500" : "bg-emerald-500")" />
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@ingredient.Name</span>
                            <p class="mt-0.5 truncate font-mono text-xs text-muted-foreground">@ingredient.Inci</p>
                        </div>
                        <span class="shrink-0 font-mono text-xs tabular-nums text-muted-foreground">@ingredient.Percentage</span>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <div class="space-y-2">
                                <div class="flex gap-4 text-xs">
                                    <span class="w-16 shrink-0 font-medium text-muted-foreground">Purpose</span>
                                    <span>@ingredient.Purpose</span>
                                </div>
                                <div class="flex gap-4 text-xs">
                                    <span class="w-16 shrink-0 font-medium text-muted-foreground">Source</span>
                                    <span>@ingredient.Origin</span>
                                </div>
                                @if (ingredient.IsAllergen && !string.IsNullOrEmpty(ingredient.AllergenNote))
                                {
                                    <div class="rounded-md bg-muted/50 p-3">
                                        <span class="text-xs font-medium text-muted-foreground">Sensitivity warning</span>
                                        <p class="mt-1 text-sm leading-relaxed">@ingredient.AllergenNote</p>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Show More *@
        @if (_ingredients.Length > 5)
        {
            <div class="border-t px-4 py-3">
                <ButtonCn Class="h-7 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="() => _showAll = !_showAll">
                    @(_showAll ? "Show fewer ingredients" : $"Show all {_ingredients.Length} ingredients")
                </ButtonCn>
            </div>
        }

        @* Certifications *@
        <div class="border-t px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">Certifications</span>
            <div class="flex flex-wrap gap-2">
                @foreach (var cert in _certifications)
                {
                    <div class="flex items-center gap-1.5 rounded-md bg-muted/50 px-2.5 py-1.5">
                        @if (cert.Label == "Cruelty-Free")
                        {
                            <LucideShieldCheckCn Size="16" Class="size-3 text-muted-foreground" />
                        }
                        else
                        {
                            <LucideLeafCn Size="16" Class="size-3 text-muted-foreground" />
                        }
                        <span class="text-xs font-medium">@cert.Label</span>
                        <span class="text-xs text-muted-foreground">&middot; @cert.Body</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record IngredientInfo(string Id, string Name, string Inci, string Purpose, string Origin, string Percentage, bool IsAllergen, string? AllergenNote = null);
    private record CertInfo(string Label, string Body);

    private const string ProductName = "Revitalizing Night Serum";

    private static readonly IngredientInfo[] _ingredients =
    {
        new("1", "Hyaluronic Acid", "Sodium Hyaluronate", "Deep hydration and moisture retention in skin layers", "Fermentation-derived, France", "2.0%", false),
        new("2", "Niacinamide", "Nicotinamide", "Brightening, pore refinement, and barrier support", "Synthetic, Switzerland", "5.0%", false),
        new("3", "Squalane", "Squalane", "Lightweight emollient that mimics skin\u2019s natural oils", "Olive-derived, Spain", "3.0%", false),
        new("4", "Retinol", "Retinol", "Cell turnover stimulation and fine line reduction", "Synthetic, Germany", "0.3%", true, "May cause sensitivity in retinoid-intolerant individuals"),
        new("5", "Tocopherol", "Tocopherol", "Antioxidant protection and formula stabilization", "Sunflower-derived, Argentina", "1.0%", false),
        new("6", "Aloe Vera Extract", "Aloe Barbadensis Leaf Juice", "Soothing and anti-inflammatory hydration base", "Organic farm, Mexico", "4.0%", false),
        new("7", "Phenoxyethanol", "Phenoxyethanol", "Broad-spectrum preservative at safe concentration", "Synthetic, Japan", "0.8%", true, "Rare sensitivity possible in individuals with eczema")
    };

    private static readonly CertInfo[] _certifications =
    {
        new("Cruelty-Free", "Leaping Bunny"),
        new("Vegan", "Vegan Society"),
        new("Clean Beauty", "EWG Verified")
    };

    private string? _expanded;
    private bool _showAll;

    private IngredientInfo[] Allergens => _ingredients.Where(i => i.IsAllergen).ToArray();
    private IngredientInfo[] VisibleIngredients => _showAll ? _ingredients : _ingredients.Take(5).ToArray();
}
