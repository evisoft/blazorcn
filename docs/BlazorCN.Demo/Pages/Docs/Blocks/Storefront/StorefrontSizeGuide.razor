@* ============================================================
   Block: storefront-size-guide
   Title: Storefront Size Guide
   Description: Size guide with interactive fit finder and measurement chart to help customers find their perfect fit
   Long Description: Help customers find their perfect fit with this size guide component. Features an interactive fit finder that collects measurements and recommends the ideal size, along with a detailed size chart table. The clean interface reduces sizing anxiety and returns, with clear measurement instructions and fit preference options.
   Dependencies: ButtonCn, InputCn, LabelCn, LucideCheckCn, LucideRotateCcwCn, TableBodyCn, TableCellCn, TableCn, TableHeadCn, TableHeaderCn, TableRowCn, TabsCn, TabsContentCn, TabsListCn, TabsTriggerCn
   Source: original/blocks/storefront/storefront-size-guide.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="border-b px-4 py-3">
                <p class="text-sm font-medium">Find Your Fit</p>
                <p class="text-xs text-muted-foreground">
                    Get a personalized size recommendation or browse the chart
                </p>
            </div>

            <TabsCn Class="w-full" DefaultValue="finder">
                <div class="border-b px-4 py-2">
                    <TabsListCn Class="grid w-full grid-cols-2">
                        <TabsTriggerCn Value="finder">Fit Finder</TabsTriggerCn>
                        <TabsTriggerCn Value="chart">Size Chart</TabsTriggerCn>
                    </TabsListCn>
                </div>

                <TabsContentCn Class="mt-0" Value="finder">
                    @if (!string.IsNullOrEmpty(_recommendedSize))
                    {
                        <div>
                            <div class="border-b px-4 py-3">
                                <div class="flex items-center gap-2">
                                    <LucideCheckCn Size="16" Class="size-4 text-emerald-500" />
                                    <span class="text-xs text-muted-foreground">Your recommended size</span>
                                </div>
                                <p class="mt-1 text-2xl font-semibold tabular-nums">@_recommendedSize</p>
                                <p class="mt-1 text-xs text-muted-foreground">
                                    Based on @_chest" chest, @_waist" waist, @_fitPreference fit
                                </p>
                            </div>
                            <div class="flex gap-2 px-4 py-3">
                                <ButtonCn Class="h-7 gap-1 px-3 text-xs" Variant="ButtonVariant.Outline">
                                    Shop Size @_recommendedSize
                                </ButtonCn>
                                <ButtonCn Class="h-7 gap-1 px-3 text-xs" @onclick="ResetFinder" Variant="ButtonVariant.Ghost">
                                    <LucideRotateCcwCn Size="12" Class="size-3" />
                                    Start Over
                                </ButtonCn>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div>
                            <div class="border-b px-4 py-3">
                                <p class="mb-3 text-xs font-medium text-muted-foreground">
                                    Measurements (in)
                                </p>
                                <div class="grid grid-cols-2 gap-3">
                                    <div class="space-y-1.5">
                                        <LabelCn Class="text-xs" For="chest">
                                            Chest
                                        </LabelCn>
                                        <InputCn
                                            id="chest"
                                            Placeholder="38"
                                            Type="number"
                                            @bind-Value="_chest" />
                                    </div>
                                    <div class="space-y-1.5">
                                        <LabelCn Class="text-xs" For="waist">
                                            Waist
                                        </LabelCn>
                                        <InputCn
                                            id="waist"
                                            Placeholder="32"
                                            Type="number"
                                            @bind-Value="_waist" />
                                    </div>
                                </div>
                            </div>

                            <div class="border-b px-4 py-3">
                                <p class="mb-3 text-xs font-medium text-muted-foreground">Preferred fit</p>
                                <div class="grid grid-cols-3 gap-2">
                                    @foreach (var option in _fitOptions)
                                    {
                                        <button
                                            class="@(Cn.Merge("rounded-md border px-3 py-2 text-center transition-colors", _fitPreference == option.Value ? "border-primary bg-primary/5" : "hover:border-foreground/30"))"
                                            @onclick="@(() => _fitPreference = option.Value)"
                                            type="button">
                                            <p class="text-xs font-medium">@option.Label</p>
                                            <p class="text-[10px] text-muted-foreground">@option.Desc</p>
                                        </button>
                                    }
                                </div>
                            </div>

                            <div class="px-4 py-3">
                                <ButtonCn
                                    Class="w-full"
                                    Disabled="@(string.IsNullOrEmpty(_chest) || string.IsNullOrEmpty(_waist))"
                                    @onclick="FindSize"
                                    Size="ButtonSize.Sm"
                                    Variant="ButtonVariant.Outline">
                                    Find My Size
                                </ButtonCn>
                            </div>
                        </div>
                    }
                </TabsContentCn>

                <TabsContentCn Class="mt-0" Value="chart">
                    <div class="border-b px-4 py-3">
                        <div class="flex items-center justify-between">
                            <p class="text-xs text-muted-foreground">All measurements in inches</p>
                            <span class="rounded bg-muted px-1.5 py-0.5 font-mono text-[10px] font-medium text-muted-foreground">
                                US Sizing
                            </span>
                        </div>
                    </div>

                    <div class="border-b">
                        <TableCn>
                            <TableHeaderCn>
                                <TableRowCn>
                                    <TableHeadCn Class="w-[60px]">Size</TableHeadCn>
                                    <TableHeadCn Class="text-center">Chest</TableHeadCn>
                                    <TableHeadCn Class="text-center">Waist</TableHeadCn>
                                    <TableHeadCn Class="text-center">Hips</TableHeadCn>
                                </TableRowCn>
                            </TableHeaderCn>
                            <TableBodyCn>
                                @foreach (var row in _sizeChart)
                                {
                                    <TableRowCn>
                                        <TableCellCn Class="font-medium">@row.Size</TableCellCn>
                                        <TableCellCn Class="text-center text-muted-foreground">@row.Chest</TableCellCn>
                                        <TableCellCn Class="text-center text-muted-foreground">@row.Waist</TableCellCn>
                                        <TableCellCn Class="text-center text-muted-foreground">@row.Hips</TableCellCn>
                                    </TableRowCn>
                                }
                            </TableBodyCn>
                        </TableCn>
                    </div>

                    <div class="px-4 py-3">
                        <p class="mb-3 text-xs font-medium text-muted-foreground">How to measure</p>
                        <div class="space-y-2">
                            @foreach (var item in _measureGuide)
                            {
                                <div class="flex gap-2 text-xs">
                                    <span class="shrink-0 font-medium">@item.Label</span>
                                    <span class="text-muted-foreground">--</span>
                                    <span class="text-muted-foreground">@item.Description</span>
                                </div>
                            }
                        </div>
                    </div>
                </TabsContentCn>
            </TabsCn>
        </div>
    </section>
</section>

@code {
    private string _chest = "";
    private string _waist = "";
    private string _fitPreference = "regular";
    private string? _recommendedSize;

    private record SizeChartRow(string Size, string Chest, string Waist, string Hips);
    private record FitOption(string Value, string Label, string Desc);
    private record MeasureGuideItem(string Label, string Description);

    private static readonly SizeChartRow[] _sizeChart =
    [
        new("XS", "32-34", "26-28", "34-36"),
        new("S", "35-37", "29-31", "37-39"),
        new("M", "38-40", "32-34", "40-42"),
        new("L", "41-43", "35-37", "43-45"),
        new("XL", "44-46", "38-40", "46-48"),
        new("XXL", "47-49", "41-43", "49-51")
    ];

    private static readonly FitOption[] _fitOptions =
    [
        new("slim", "Slim", "Close to body"),
        new("regular", "Regular", "Classic fit"),
        new("relaxed", "Relaxed", "Room to move")
    ];

    private static readonly MeasureGuideItem[] _measureGuide =
    [
        new("Chest", "Measure around the fullest part, keeping tape horizontal"),
        new("Waist", "Measure at your natural waistline, the narrowest point"),
        new("Hips", "Measure around the fullest part of hips and buttocks")
    ];

    private static readonly string[] _sizeOrder = ["XS", "S", "M", "L", "XL", "XXL"];

    private void FindSize()
    {
        if (!int.TryParse(_chest, out var chestNum) || !int.TryParse(_waist, out var waistNum))
            return;

        string size;
        if (chestNum <= 34 && waistNum <= 28) size = "XS";
        else if (chestNum <= 37 && waistNum <= 31) size = "S";
        else if (chestNum <= 40 && waistNum <= 34) size = "M";
        else if (chestNum <= 43 && waistNum <= 37) size = "L";
        else if (chestNum <= 46 && waistNum <= 40) size = "XL";
        else size = "XXL";

        var idx = Array.IndexOf(_sizeOrder, size);
        if (_fitPreference == "relaxed" && size != "XXL")
            size = _sizeOrder[idx + 1];
        else if (_fitPreference == "slim" && size != "XS")
            size = _sizeOrder[idx - 1];

        _recommendedSize = size;
    }

    private void ResetFinder()
    {
        _chest = "";
        _waist = "";
        _fitPreference = "regular";
        _recommendedSize = null;
    }
}
