@* ============================================================
   Block: storefront-loyalty
   Title: Storefront Loyalty
   Description: Storefront loyalty rewards program with points tracker and redeemable rewards
   Long Description: Showcase your loyalty program with this minimal rewards block. Displays the user's points balance, current tier with progress toward the next level, a list of redeemable rewards, and simple ways to earn more points. The flat layout uses border-separated sections for a clean, scannable experience. Ideal for fashion retailers, beauty brands, or any e-commerce store with a points-based loyalty program.
   Dependencies: ButtonCn, ProgressCn
   Source: original/blocks/storefront/storefront-loyalty.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header with Points & Tier *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-sm font-medium">Rewards</h2>
                        <p class="text-xs text-muted-foreground">@_userData.Tier Member</p>
                    </div>
                    <div class="text-right">
                        <p class="text-2xl font-semibold tabular-nums">
                            @_userData.Points.ToString("N0")
                        </p>
                        <p class="text-xs text-muted-foreground">points</p>
                    </div>
                </div>
            </div>

            @* Tier Progress *@
            <div class="border-b px-4 py-3">
                <div class="mb-1.5 flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Progress to @_userData.NextTier</span>
                    <span class="text-xs tabular-nums text-muted-foreground">
                        @_userData.PointsToNextTier pts away
                    </span>
                </div>
                <ProgressCn Class="h-1.5" Value="@_userData.TierProgress" />
            </div>

            @* Redeem Rewards *@
            <div class="border-b px-4 py-3">
                <p class="mb-2 text-xs font-medium text-muted-foreground">Redeem</p>
                <div class="space-y-0">
                    @for (var i = 0; i < _rewards.Length; i++)
                    {
                        var reward = _rewards[i];
                        var available = _userData.Points >= reward.Points;
                        var isLast = i == _rewards.Length - 1;
                        <div class="@(Cn.Merge("flex items-center gap-3 py-2", !isLast ? "border-b" : ""))">
                            <div class="min-w-0 flex-1">
                                <p class="text-sm font-medium">@reward.Name</p>
                                <p class="text-xs text-muted-foreground">@reward.Description</p>
                            </div>
                            <span class="shrink-0 font-mono text-xs tabular-nums text-muted-foreground">
                                @reward.Points pts
                            </span>
                            <ButtonCn
                                Class="h-7 px-2 text-xs"
                                Disabled="@(!available)"
                                Variant="@(available ? ButtonVariant.Outline : ButtonVariant.Ghost)">
                                Redeem
                            </ButtonCn>
                        </div>
                    }
                </div>
            </div>

            @* Ways to Earn *@
            <div class="px-4 py-3">
                <p class="mb-2 text-xs font-medium text-muted-foreground">Earn Points</p>
                @for (var i = 0; i < _earnOptions.Length; i++)
                {
                    var option = _earnOptions[i];
                    var isLast = i == _earnOptions.Length - 1;
                    <div class="@(Cn.Merge("flex items-center gap-3 py-2", !isLast ? "border-b" : ""))">
                        <span class="@($"size-1.5 shrink-0 rounded-full {option.Color}")"></span>
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium">@option.Title</p>
                        </div>
                        <span class="text-xs text-muted-foreground">@option.Description</span>
                    </div>
                }
            </div>
        </div>
    </section>
</section>

@code {
    private record UserData(string Name, int Points, string Tier, string NextTier, int PointsToNextTier, int TierProgress);
    private record RewardInfo(int Id, string Name, int Points, string Description);
    private record EarnOption(string Title, string Description, string Color);

    private static readonly UserData _userData = new("Sarah", 2450, "Gold", "Platinum", 550, 82);

    private static readonly RewardInfo[] _rewards =
    [
        new(1, "$10 Off", 500, "Any purchase over $50"),
        new(2, "$25 Off", 1000, "Any purchase over $100"),
        new(3, "Free Shipping", 300, "On your next order")
    ];

    private static readonly EarnOption[] _earnOptions =
    [
        new("Shop", "1 point per $1 spent", "bg-primary"),
        new("Review", "50 points per review", "bg-amber-500"),
        new("Refer", "500 points per referral", "bg-emerald-500")
    ];
}
