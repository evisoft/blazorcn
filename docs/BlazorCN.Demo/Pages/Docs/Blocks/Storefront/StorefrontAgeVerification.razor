@* ============================================================
   Block: storefront-age-verification
   Title: Storefront Age Verification
   Description: Age gate verification panel with date of birth dropdowns, remember me checkbox, legal disclaimer, and verification status indicator
   Dependencies: ButtonCn, CheckboxCn, LucideCheckCn, LucideShieldCheckCn, LucideXCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn
   Source: original/blocks/storefront/storefront-age-verification.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideShieldCheckCn Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Age Verification Required</h2>
            </div>
            <p class="text-xs text-muted-foreground">
                You must be 21 or older to view and purchase these products
            </p>
        </div>

        @* Status Indicator *@
        @if (_status != VerificationState.Idle)
        {
            <div class="border-b px-4 py-3">
                <div class="@Cn.Merge("flex items-center gap-2 rounded-md p-3", _status == VerificationState.Verified ? "bg-emerald-500/10" : "bg-red-500/10")">
                    @if (_status == VerificationState.Verified)
                    {
                        <LucideCheckCn Size="16" Class="size-4 text-emerald-600 dark:text-emerald-400" />
                        <div>
                            <p class="text-sm font-medium text-emerald-600 dark:text-emerald-400">Age verified</p>
                            <p class="text-xs text-muted-foreground">You may now access age-restricted products</p>
                        </div>
                    }
                    else
                    {
                        <LucideXCn Size="16" Class="size-4 text-red-600 dark:text-red-400" />
                        <div>
                            <p class="text-sm font-medium text-red-600 dark:text-red-400">Verification failed</p>
                            <p class="text-xs text-muted-foreground">You must be 21 or older to access this content</p>
                        </div>
                    }
                </div>
            </div>
        }

        @* Date of Birth *@
        @if (_status != VerificationState.Verified)
        {
            <div class="border-b px-4 py-3">
                <span class="mb-2 block text-xs font-medium text-muted-foreground">Date of birth</span>
                <div class="grid grid-cols-3 gap-2">
                    <div>
                        <span class="mb-1 block text-xs text-muted-foreground">Month</span>
                        <SelectCn TValue="string" Value="@_month" ValueChanged="v => _month = v">
                            <SelectTriggerCn Class="h-8 text-xs">
                                <SelectValueCn Placeholder="Month" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                @foreach (var m in _months)
                                {
                                    <SelectItemCn Value="@m">@m</SelectItemCn>
                                }
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                    <div>
                        <span class="mb-1 block text-xs text-muted-foreground">Day</span>
                        <SelectCn TValue="string" Value="@_day" ValueChanged="v => _day = v">
                            <SelectTriggerCn Class="h-8 text-xs">
                                <SelectValueCn Placeholder="Day" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                @foreach (var d in _days)
                                {
                                    <SelectItemCn Value="@d">@d</SelectItemCn>
                                }
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                    <div>
                        <span class="mb-1 block text-xs text-muted-foreground">Year</span>
                        <SelectCn TValue="string" Value="@_year" ValueChanged="v => _year = v">
                            <SelectTriggerCn Class="h-8 text-xs">
                                <SelectValueCn Placeholder="Year" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                @foreach (var y in _years)
                                {
                                    <SelectItemCn Value="@y">@y</SelectItemCn>
                                }
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                </div>
            </div>

            @* Remember Me *@
            <div class="border-b px-4 py-3">
                <label class="flex cursor-pointer items-center gap-2">
                    <CheckboxCn @bind-Checked="_rememberMe" />
                    <span class="text-sm">Remember me for 30 days</span>
                </label>
                <p class="mt-1 pl-6 text-xs text-muted-foreground">
                    A cookie will be stored to skip verification on future visits
                </p>
            </div>

            @* Verify Button *@
            <div class="border-b px-4 py-3">
                <ButtonCn Class="h-8 w-full text-xs" disabled="@(!IsFormComplete)" Variant="ButtonVariant.Outline" @onclick="HandleVerify">
                    Verify Age
                </ButtonCn>
            </div>
        }

        @* Legal Disclaimer *@
        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground leading-relaxed">
                By entering your date of birth and clicking verify, you confirm that the information
                provided is accurate. This site sells age-restricted products and is required by law to
                verify your age. We do not store your date of birth. For more information, see our
                <a class="underline underline-offset-2 hover:text-foreground" href="#">Privacy Policy</a>
                and
                <a class="underline underline-offset-2 hover:text-foreground" href="#">Terms of Service</a>.
            </p>
        </div>
    </div>
</section>

@code {
    private enum VerificationState { Idle, Verified, Denied }

    private static readonly string[] _months = { "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };
    private static readonly string[] _days = Enumerable.Range(1, 31).Select(i => i.ToString()).ToArray();
    private static readonly string[] _years = Enumerable.Range(0, 100).Select(i => (2008 - i).ToString()).ToArray();

    private string _month = "";
    private string _day = "";
    private string _year = "";
    private bool _rememberMe;
    private VerificationState _status = VerificationState.Idle;

    private bool IsFormComplete => _month != "" && _day != "" && _year != "";

    private void HandleVerify()
    {
        if (!IsFormComplete) return;

        var birthYear = int.Parse(_year);
        var birthMonth = Array.IndexOf(_months, _month);
        var birthDay = int.Parse(_day);

        var minAge = 21;
        var cutoffYear = 2026 - minAge;
        var cutoffMonth = 2; // March (0-indexed)
        var cutoffDay = 16;

        if (birthYear < cutoffYear ||
            (birthYear == cutoffYear && birthMonth < cutoffMonth) ||
            (birthYear == cutoffYear && birthMonth == cutoffMonth && birthDay <= cutoffDay))
        {
            _status = VerificationState.Verified;
        }
        else
        {
            _status = VerificationState.Denied;
        }
    }
}
