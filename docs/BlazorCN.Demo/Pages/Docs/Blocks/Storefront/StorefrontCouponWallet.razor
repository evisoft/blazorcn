@* ============================================================
   Block: storefront-coupon-wallet
   Title: Storefront Coupon Wallet
   Description: Saved coupons and offers wallet with coupon code input, active and expired sections, and one-click apply
   Dependencies: ButtonCn, InputCn, LucideCheckCn, LucidePlusCn, LucideTagCn
   Source: original/blocks/storefront/storefront-coupon-wallet.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideTagCn Size="16" Class="size-4 text-muted-foreground" />
                <h1 class="text-sm font-medium">Your Offers (@_activeCoupons.Count available)</h1>
            </div>
        </div>

        @* Add Coupon Code *@
        <div class="border-b px-4 py-3">
            <div class="flex gap-2">
                <InputCn Class="h-8 text-xs" placeholder="Enter coupon code" @bind-Value="_couponInput" />
                <ButtonCn Class="h-8 shrink-0 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                    <LucidePlusCn Size="16" Class="mr-1 size-3" />
                    Add
                </ButtonCn>
            </div>
        </div>

        @* Active Coupons *@
        <div>
            @for (var i = 0; i < _activeCoupons.Count; i++)
            {
                var coupon = _activeCoupons[i];
                var isApplied = _appliedId == coupon.Id;
                var isLast = i == _activeCoupons.Count - 1 && _expiredCoupons.Count == 0;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors", isApplied ? "border-l-2 border-l-emerald-500 pl-[14px]" : "", !isLast ? "border-b" : "")">
                    @* Discount Amount *@
                    <div class="w-14 shrink-0 text-center">
                        <span class="font-semibold text-2xl tabular-nums">@coupon.Discount</span>
                        @if (coupon.Code == "FREESHIP")
                        {
                            <p class="text-[10px] text-muted-foreground">shipping</p>
                        }
                    </div>

                    @* Coupon Info *@
                    <div class="min-w-0 flex-1">
                        <span class="text-sm font-medium">@coupon.Description</span>
                        <div class="mt-0.5 flex items-center gap-2">
                            <span class="font-mono text-xs text-muted-foreground">@coupon.Code</span>
                            @if (coupon.MinSpend > 0)
                            {
                                <span class="text-muted-foreground text-xs">&middot;</span>
                                <span class="text-xs text-muted-foreground">Min. $@coupon.MinSpend</span>
                            }
                            <span class="text-muted-foreground text-xs">&middot;</span>
                            <span class="text-xs text-muted-foreground">Expires @coupon.ExpiresAt</span>
                        </div>
                    </div>

                    @* Apply/Remove Button *@
                    @if (isApplied)
                    {
                        <ButtonCn Class="h-7 shrink-0 gap-1 px-3 text-xs text-emerald-600 hover:text-red-600 dark:text-emerald-400 dark:hover:text-red-400"
                                  Variant="ButtonVariant.Ghost" @onclick="() => HandleApply(coupon.Id)">
                            <LucideCheckCn Size="16" Class="size-3" />
                            Applied
                        </ButtonCn>
                    }
                    else
                    {
                        <ButtonCn Class="h-7 shrink-0 px-3 text-xs" Variant="ButtonVariant.Outline" @onclick="() => HandleApply(coupon.Id)">
                            Apply
                        </ButtonCn>
                    }
                </div>
            }
        </div>

        @* Expired Section *@
        @if (_expiredCoupons.Count > 0)
        {
            <div class="border-t bg-muted/30 px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">Expired</span>
            </div>
            <div>
                @for (var i = 0; i < _expiredCoupons.Count; i++)
                {
                    var coupon = _expiredCoupons[i];
                    var isLast = i == _expiredCoupons.Count - 1;
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 opacity-50", !isLast ? "border-b" : "")">
                        <div class="w-14 shrink-0 text-center">
                            <span class="font-semibold text-2xl tabular-nums">@coupon.Discount</span>
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@coupon.Description</span>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="font-mono text-xs text-muted-foreground">@coupon.Code</span>
                                <span class="text-muted-foreground text-xs">&middot;</span>
                                <span class="text-xs text-muted-foreground">Expired @coupon.ExpiresAt</span>
                            </div>
                        </div>
                        <span class="shrink-0 text-xs text-muted-foreground">Expired</span>
                    </div>
                }
            </div>
        }

        @* Footer Note *@
        <div class="border-t px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <p class="text-xs text-muted-foreground">
                    Only one coupon can be applied per order. Free shipping codes can be combined with
                    discount coupons. Coupons cannot be applied to sale items.
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private record CouponInfo(string Id, string Code, string Discount, string Description, int MinSpend, string ExpiresAt, bool IsPercentage, bool Expired);

    private static readonly List<CouponInfo> _coupons = new()
    {
        new("1", "WELCOME20", "20%", "Welcome discount on your first order", 50, "Apr 30, 2026", true, false),
        new("2", "FREESHIP", "$0", "Free standard shipping on all orders", 0, "May 15, 2026", false, false),
        new("3", "SPRING15", "15%", "Spring collection seasonal discount", 75, "Jun 1, 2026", true, false),
        new("4", "SAVE10", "$10", "Flat discount on orders over $100", 100, "Jul 31, 2026", false, false),
        new("5", "LOYALTY25", "25%", "Loyalty member exclusive discount", 0, "Feb 28, 2026", true, true),
        new("6", "HOLIDAY50", "$50", "Holiday season special offer", 200, "Jan 15, 2026", false, true)
    };

    private string _couponInput = "";
    private string? _appliedId = "1";

    private List<CouponInfo> _activeCoupons => _coupons.Where(c => !c.Expired).ToList();
    private List<CouponInfo> _expiredCoupons => _coupons.Where(c => c.Expired).ToList();

    private void HandleApply(string id)
    {
        _appliedId = _appliedId == id ? null : id;
    }
}
