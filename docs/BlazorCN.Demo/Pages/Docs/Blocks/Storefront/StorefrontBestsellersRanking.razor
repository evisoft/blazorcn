@* ============================================================
   Block: storefront-bestsellers-ranking
   Title: Storefront Bestsellers Ranking
   Description: Ranked bestseller product list with time period filter, movement indicators, and sales counts
   Dependencies: ButtonCn, LucideArrowDownCn, LucideArrowUpCn, LucideMinusCn, LucidePackageCn, LucideTrophyCn
   Source: original/blocks/storefront/storefront-bestsellers-ranking.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideTrophyCn Size="16" Class="size-4 text-muted-foreground" />
                <h1 class="text-sm font-medium">Bestsellers</h1>
            </div>
            <div class="flex items-center gap-1">
                @foreach (var p in _periodLabels)
                {
                    <ButtonCn Class="@Cn.Merge("h-7 px-2.5 text-xs", _period != p.Key ? "text-muted-foreground" : "")"
                              Variant="@(_period == p.Key ? ButtonVariant.Outline : ButtonVariant.Ghost)"
                              @onclick="() => _period = p.Key">
                        @p.Value
                    </ButtonCn>
                }
            </div>
        </div>

        @* Ranked Products *@
        <div>
            @{ var sorted = _products.OrderByDescending(p => p.Sold[_period]).ToList(); }
            @for (var i = 0; i < sorted.Count; i++)
            {
                var product = sorted[i];
                var rank = i + 1;
                var isTop3 = rank <= 3;
                var isLast = i == sorted.Count - 1;
                var movement = product.Movement[_period];

                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                    @* Rank Number *@
                    <div class="flex w-6 shrink-0 items-center justify-center">
                        <span class="@Cn.Merge("font-mono text-sm", isTop3 ? "font-medium" : "text-muted-foreground")">
                            @rank
                        </span>
                    </div>

                    @* Top 3 Indicator *@
                    @if (isTop3)
                    {
                        <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                    }
                    else
                    {
                        <span class="size-1.5 shrink-0"></span>
                    }

                    @* Product Image *@
                    <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        <LucidePackageCn Size="16" Class="size-4 text-muted-foreground/60" />
                    </div>

                    @* Product Info *@
                    <div class="min-w-0 flex-1">
                        <span class="text-sm font-medium">@product.Name</span>
                        <p class="text-xs text-muted-foreground">@product.Category</p>
                    </div>

                    @* Price *@
                    <span class="shrink-0 text-sm font-medium tabular-nums">$@product.Price</span>

                    @* Units Sold *@
                    <span class="w-12 shrink-0 text-right text-xs text-muted-foreground tabular-nums">
                        @FormatSold(product.Sold[_period]) sold
                    </span>

                    @* Movement Indicator *@
                    <div class="flex w-5 shrink-0 items-center justify-center">
                        @if (movement == "up")
                        {
                            <LucideArrowUpCn Size="16" Class="size-3.5 text-emerald-500" />
                        }
                        else if (movement == "down")
                        {
                            <LucideArrowDownCn Size="16" Class="size-3.5 text-red-500" />
                        }
                        else
                        {
                            <LucideMinusCn Size="16" Class="size-3.5 text-muted-foreground/40" />
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-xs text-muted-foreground">
                    Updated hourly &middot; Based on units sold
                </span>
                <ButtonCn Class="h-7 px-3 text-xs" Variant="ButtonVariant.Ghost">
                    View All Products
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record RankedProduct(int Id, string Name, string Category, int Price, Dictionary<string, int> Sold, Dictionary<string, string> Movement);

    private static readonly Dictionary<string, string> _periodLabels = new()
    {
        ["week"] = "This Week",
        ["month"] = "This Month",
        ["all"] = "All Time"
    };

    private string _period = "week";

    private static string FormatSold(int n)
    {
        if (n >= 1000) return $"{n / 1000.0:F1}k";
        return n.ToString();
    }

    private static readonly List<RankedProduct> _products = new()
