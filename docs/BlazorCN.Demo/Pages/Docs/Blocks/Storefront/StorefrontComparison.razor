@* ============================================================
   Block: storefront-comparison
   Title: Storefront Comparison
   Description: Storefront product comparison tool with side-by-side specification table
   Dependencies: ButtonCn, CheckboxCn, LucideChevronRightCn, LucidePackageCn, LucideXCn, SheetCn, SheetContentCn, SheetHeaderCn, SheetTitleCn, SheetTriggerCn, TableCn, TableBodyCn, TableCellCn, TableHeadCn, TableHeaderCn, TableRowCn
   Source: original/blocks/storefront/storefront-comparison.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="text-sm font-medium">Compare Products</h2>
                <p class="text-xs text-muted-foreground">Select up to 3 items</p>
            </div>
            <SheetCn>
                <SheetTriggerCn
                                disabled="@(_selectedIds.Count < 2)"
                                Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default h-7 gap-1 px-2 text-xs"
                                data-variant="outline" data-size="default">
                    Compare (@_selectedIds.Count)
                    <LucideChevronRightCn Size="16" Class="size-3.5" />
                </SheetTriggerCn>
                <SheetContentCn Class="h-[80vh]" Side="SheetSide.Bottom">
                    <SheetHeaderCn>
                        <SheetTitleCn Class="text-sm font-medium">Product Comparison</SheetTitleCn>
                    </SheetHeaderCn>

                    <div class="mt-4 overflow-auto">
                        @* Product Headers *@
                        <div class="mb-4 grid gap-4" style="grid-template-columns: repeat(@SelectedProducts.Length, minmax(180px, 1fr))">
                            @foreach (var product in SelectedProducts)
                            {
                                <div class="text-center">
                                    <div class="mx-auto mb-2 flex size-16 items-center justify-center rounded-md border bg-muted/50">
                                        <LucidePackageCn Size="16" Class="size-5 text-muted-foreground/60" />
                                    </div>
                                    <p class="text-sm font-medium">@product.Name</p>
                                    <p class="text-xs text-muted-foreground">$@product.Price</p>
                                    <ButtonCn Class="mt-1 h-6 gap-1 px-2 text-xs" Variant="ButtonVariant.Ghost" @onclick="() => ToggleProduct(product.Id)">
                                        <LucideXCn Size="16" Class="size-3" />
                                        Remove
                                    </ButtonCn>
                                </div>
                            }
                        </div>

                        @* Comparison Table *@
                        <TableCn Class="w-full table-fixed">
                            <TableHeaderCn>
                                <TableRowCn>
                                    <TableHeadCn Class="w-[120px] text-xs">Specification</TableHeadCn>
                                    @foreach (var product in SelectedProducts)
                                    {
                                        <TableHeadCn Class="text-center text-xs">@product.Name</TableHeadCn>
                                    }
                                </TableRowCn>
                            </TableHeaderCn>
                            <TableBodyCn>
                                <TableRowCn>
                                    <TableCellCn Class="text-xs font-medium">Price</TableCellCn>
                                    @foreach (var product in SelectedProducts)
                                    {
                                        <TableCellCn Class="text-center text-xs">$@product.Price</TableCellCn>
                                    }
                                </TableRowCn>
                                @foreach (var spec in _specLabels)
                                {
                                    <TableRowCn>
                                        <TableCellCn Class="text-xs font-medium">@spec.Label</TableCellCn>
                                        @foreach (var product in SelectedProducts)
                                        {
                                            <TableCellCn Class="text-center text-xs">@spec.GetValue(product)</TableCellCn>
                                        }
                                    </TableRowCn>
                                }
                            </TableBodyCn>
                        </TableCn>
                    </div>
                </SheetContentCn>
            </SheetCn>
        </div>

        @* Product List *@
        @for (var i = 0; i < _products.Length; i++)
        {
            var product = _products[i];
            var isSelected = _selectedIds.Contains(product.Id);
            var isDisabled = !isSelected && _selectedIds.Count >= MaxCompare;
            var isLast = i == _products.Length - 1;
            <label class="@Cn.Merge("flex cursor-pointer items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "", isDisabled ? "opacity-50" : "")"
                   for="@($"compare-{product.Id}")">
                <CheckboxCn Checked="@isSelected" Class="size-4" Disabled="@isDisabled" Id="@($"compare-{product.Id}")" CheckedChanged="() => ToggleProduct(product.Id)" />
                <div class="flex size-10 shrink-0 items-center justify-center rounded-md border bg-muted/50">
                    <LucidePackageCn Size="16" Class="size-3.5 text-muted-foreground/60" />
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium">@product.Name</p>
                    <p class="text-xs text-muted-foreground">@product.Category</p>
                </div>
                <p class="text-sm tabular-nums">$@product.Price</p>
                @if (isSelected)
                {
                    <span class="text-xs text-muted-foreground">Selected</span>
                }
            </label>
        }
    </div>
</section>

@code {
    private record ProductInfo(int Id, string Name, int Price, string Category, string Material, string Weight, string Warranty, string Origin);
    private record SpecLabel(string Label, Func<ProductInfo, string> GetValue);

    private const int MaxCompare = 3;

    private static readonly ProductInfo[] _products =
    {
        new(1, "Classic Leather Wallet", 89, "Accessories", "Full-grain leather", "85g", "2 years", "Italy"),
        new(2, "Minimalist Card Holder", 45, "Accessories", "Top-grain leather", "40g", "1 year", "Portugal"),
        new(3, "Travel Passport Wallet", 125, "Accessories", "Full-grain leather", "120g", "3 years", "Italy"),
        new(4, "Zip-Around Wallet", 115, "Accessories", "Saffiano leather", "150g", "2 years", "Spain")
    };

    private static readonly SpecLabel[] _specLabels =
    {
        new("Material", p => p.Material),
        new("Weight", p => p.Weight),
        new("Warranty", p => p.Warranty),
        new("Made in", p => p.Origin)
    };

    private List<int> _selectedIds = new();

    private ProductInfo[] SelectedProducts => _products.Where(p => _selectedIds.Contains(p.Id)).ToArray();

    private void ToggleProduct(int id)
    {
        if (_selectedIds.Contains(id))
            _selectedIds.Remove(id);
        else if (_selectedIds.Count < MaxCompare)
            _selectedIds.Add(id);
    }
}
