@* ============================================================
   Block: storefront-customer-service
   Title: Storefront Customer Service
   Description: Customer service contact panel with support hours, response times, contact method options, order lookup, and help topic shortcuts
   Dependencies: ButtonCn, InputCn, LucideChevronRightCn, LucideClockCn, LucideHeadphonesCn, LucideMailCn, LucideMessageCircleCn, LucidePhoneCn, LucideSearchCn
   Source: original/blocks/storefront/storefront-customer-service.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideHeadphonesCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <h2 class="text-sm font-medium">Customer Support</h2>
                    <p class="text-xs text-muted-foreground">How can we help you today?</p>
                </div>
            </div>
        </div>

        @* Support Status *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-sm font-medium">Support Open</span>
                </div>
                <LucideClockCn Size="16" Class="size-3.5 text-muted-foreground" />
            </div>
            <div class="mt-1.5 flex items-center gap-3">
                <span class="text-xs text-muted-foreground">Mon-Fri 8am-8pm EST</span>
                <span class="text-xs text-muted-foreground">·</span>
                <span class="text-xs text-muted-foreground">Sat-Sun 10am-6pm EST</span>
            </div>
        </div>

        @* Contact Methods *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Contact Us</p>
            <div>
                @for (var i = 0; i < _contactMethods.Length; i++)
                {
                    var method = _contactMethods[i];
                    var isLast = i == _contactMethods.Length - 1;
                    <div class="@(!isLast ? "border-b" : "")">
                        <button type="button" class="flex w-full items-center gap-3 py-2.5 text-left transition-colors hover:bg-muted/50">
                            @if (method.Icon == "chat")
                            {
                                <LucideMessageCircleCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            }
                            else if (method.Icon == "email")
                            {
                                <LucideMailCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            }
                            else
                            {
                                <LucidePhoneCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            }
                            <div class="min-w-0 flex-1">
                                <p class="text-sm font-medium">@method.Name</p>
                                <p class="text-xs text-muted-foreground">@method.Description</p>
                            </div>
                            <div class="shrink-0 text-right">
                                <p class="text-xs text-muted-foreground">@method.ResponseTime</p>
                            </div>
                            <LucideChevronRightCn Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                        </button>
                    </div>
                }
            </div>
        </div>

        @* Order Lookup *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Order Lookup</p>
            @if (_lookupDone)
            {
                <div class="rounded-md bg-muted/50 p-3">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs font-medium">Order #@_orderNumber</p>
                            <p class="text-xs text-muted-foreground">Shipped · Estimated delivery Mar 20, 2026</p>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Ghost" Class="h-6 px-2 text-xs" @onclick="ClearLookup">
                            Clear
                        </ButtonCn>
                    </div>
                </div>
            }
            else
            {
                <div class="flex gap-2">
                    <div class="relative flex-1">
                        <LucideSearchCn Size="16" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                        <InputCn @bind-Value="_orderNumber" placeholder="Enter order number..." Class="h-8 pl-8 text-xs" />
                    </div>
                    <ButtonCn Variant="ButtonVariant.Outline" Class="h-8 px-3 text-xs" disabled="@(string.IsNullOrWhiteSpace(_orderNumber))" @onclick="HandleLookup">
                        Look Up
                    </ButtonCn>
                </div>
            }
        </div>

        @* Help Topics *@
        <div class="px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Common Topics</p>
            <div class="grid grid-cols-2 gap-1.5">
                @foreach (var topic in _helpTopics)
                {
                    <a href="#" class="flex items-center justify-between rounded-md px-2.5 py-2 transition-colors hover:bg-muted/50">
                        <span class="text-xs font-medium">@topic.Title</span>
                        <span class="text-[10px] text-muted-foreground">@topic.Articles</span>
                    </a>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ContactMethodInfo(string Id, string Name, string Description, string ResponseTime, string Icon);
    private record HelpTopicInfo(string Id, string Title, int Articles);

    private static readonly ContactMethodInfo[] _contactMethods =
    {
        new("chat", "Live Chat", "Chat with a support agent in real time", "Under 2 min", "chat"),
        new("email", "Email", "Get a detailed response to your inquiry", "Within 4 hours", "email"),
        new("phone", "Phone", "Speak directly with our support team", "Under 5 min wait", "phone")
    };

    private static readonly HelpTopicInfo[] _helpTopics =
    {
        new("shipping", "Shipping & Delivery", 12),
        new("returns", "Returns & Exchanges", 8),
        new("payments", "Payments & Billing", 6),
        new("account", "Account & Security", 9),
        new("products", "Product Information", 15),
        new("promotions", "Promotions & Discounts", 4)
    };

    private string _orderNumber = "";
    private bool _lookupDone;

    private void HandleLookup()
    {
        if (!string.IsNullOrWhiteSpace(_orderNumber))
            _lookupDone = true;
    }

    private void ClearLookup()
    {
        _lookupDone = false;
        _orderNumber = "";
    }
}
