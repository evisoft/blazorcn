@* ============================================================
   Block: storefront-product-certifications
   Title: Storefront Product Certifications
   Description: Product certification badges displaying organic, fair-trade, and cruelty-free status with verification dates, issuing bodies, and expandable certificate details
   Dependencies: ButtonCn, LucideChevronRightCn, LucideExternalLinkCn, LucideShieldCheckCn
   Source: original/blocks/storefront/storefront-product-certifications.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">@ProductName</h2>
            <p class="text-xs text-muted-foreground">Certifications &amp; Standards</p>
        </div>

        @* Summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideShieldCheckCn Size="16" Class="size-4 text-emerald-500" />
                <span class="text-sm font-medium">@ActiveCerts active certifications</span>
            </div>
            <span class="text-xs text-muted-foreground">&middot;</span>
            <span class="text-xs text-muted-foreground">@_certifications.Length total</span>
        </div>

        @* Certification List *@
        <div>
            @for (var i = 0; i < _certifications.Length; i++)
            {
                var cert = _certifications[i];
                var isExpanded = _expanded == cert.Id;
                var isLast = i == _certifications.Length - 1;
                var dot = GetStatusDot(cert.Status);
                var statusLabel = GetStatusLabel(cert.Status);

                <div class="@(!isLast ? "border-b" : "")">
                    <button class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            type="button"
                            @onclick="() => _expanded = isExpanded ? null : cert.Id">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", dot)" />
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@cert.Name</span>
                            <p class="mt-0.5 truncate text-xs text-muted-foreground">@cert.IssuingBody</p>
                        </div>
                        <span class="shrink-0 text-xs text-muted-foreground">@statusLabel</span>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <div class="space-y-2">
                                <div class="flex gap-4 text-xs">
                                    <span class="w-20 shrink-0 font-medium text-muted-foreground">Verified</span>
                                    <span>@cert.VerifiedDate</span>
                                </div>
                                <div class="flex gap-4 text-xs">
                                    <span class="w-20 shrink-0 font-medium text-muted-foreground">Expires</span>
                                    <span>@cert.ExpiryDate</span>
                                </div>
                                <div class="flex gap-4 text-xs">
                                    <span class="w-20 shrink-0 font-medium text-muted-foreground">Certificate</span>
                                    <span class="font-mono">@cert.CertificateId</span>
                                </div>
                            </div>

                            <div class="mt-3 rounded-md bg-muted/50 p-3">
                                <span class="text-xs font-medium text-muted-foreground">Scope</span>
                                <p class="mt-1 text-sm leading-relaxed">@cert.Scope</p>
                            </div>

                            <div class="mt-2">
                                <a href="#" class="inline-flex h-6 items-center gap-1 px-2 text-xs text-muted-foreground transition-colors hover:text-foreground">
                                    <LucideExternalLinkCn Size="16" Class="size-3" />
                                    Verify certificate
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record CertificationInfo(string Id, string Name, string IssuingBody, string Status, string VerifiedDate, string ExpiryDate, string CertificateId, string Scope);

    private const string ProductName = "Organic Daily Face Moisturizer";

    private static readonly CertificationInfo[] _certifications =
    {
        new("c1", "USDA Organic", "United States Department of Agriculture", "active", "Jan 2026", "Jan 2027", "USDA-ORG-2026-48291", "95%+ certified organic ingredients. Produced without synthetic fertilizers, pesticides, or genetically modified organisms. Facility audited annually."),
        new("c2", "Fair Trade Certified", "Fair Trade USA", "active", "Mar 2026", "Mar 2027", "FT-USA-2026-17834", "Shea butter and cocoa butter sourced from certified cooperatives in Ghana and Ivory Coast. Workers receive fair wages and community development premiums."),
        new("c3", "Leaping Bunny", "Coalition for Consumer Information on Cosmetics", "active", "Nov 2025", "Nov 2026", "LB-CCIC-2025-09412", "No animal testing at any stage of product development. Supplier monitoring program in place. Independent audit completed."),
        new("c4", "EWG Verified", "Environmental Working Group", "active", "Feb 2026", "Feb 2027", "EWG-V-2026-33105", "All ingredients meet EWG health standards. Free from EWG chemicals of concern. Full transparency in ingredient disclosure."),
        new("c5", "B Corp Certified", "B Lab Global", "renewal", "Sep 2023", "Sep 2026", "BCORP-2023-72841", "Company meets rigorous standards of social and environmental performance, accountability, and transparency. Overall B Impact Score: 89.3.")
    };

    private string? _expanded;

    private int ActiveCerts => _certifications.Count(c => c.Status == "active");

    private static string GetStatusDot(string status) => status switch
    {
        "active" => "bg-emerald-500",
        "pending" => "bg-amber-500",
        "renewal" => "bg-blue-500",
        _ => "bg-muted-foreground"
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "active" => "Active",
        "pending" => "Pending",
        "renewal" => "Up for renewal",
        _ => status
    };
}
