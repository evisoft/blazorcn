@* ============================================================
   Block: storefront-installments
   Title: Storefront Installments
   Description: Buy now pay later installment plan selector with provider options, payment schedule breakdown, and eligibility check
   Dependencies: ButtonCn, LucideCheckCn, LucideCreditCardCn, LucidePackageCn
   Source: original/blocks/storefront/storefront-installments.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideCreditCardCn Size="16" Class="size-4 text-muted-foreground" />
                <h1 class="text-sm font-medium">Pay in Installments</h1>
            </div>
        </div>

        @* Product Summary *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-12 shrink-0 items-center justify-center rounded-md bg-muted/50">
                <LucidePackageCn Size="16" Class="size-4 text-muted-foreground/60" />
            </div>
            <div class="min-w-0 flex-1">
                <span class="text-sm font-medium">Merino Wool Overcoat</span>
                <p class="text-xs text-muted-foreground">Total amount</p>
            </div>
            <span class="font-semibold text-2xl tabular-nums">$249</span>
        </div>

        @* Payment Plans *@
        <div>
            @for (var i = 0; i < _plans.Length; i++)
            {
                var plan = _plans[i];
                var isSelected = _selectedPlan == plan.Id;
                var isLast = i == _plans.Length - 1;
                <div class="@(!isLast || isSelected ? "border-b" : "")">
                    <div class="@Cn.Merge("flex cursor-pointer items-center gap-3 px-4 py-3 transition-colors", isSelected ? "bg-primary/5" : "hover:bg-muted/50")"
                         @onclick="() => _selectedPlan = plan.Id" role="button" tabindex="0">
                        <div class="@Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded-full border", isSelected ? "border-primary bg-primary" : "border-muted-foreground/30")">
                            @if (isSelected)
                            {
                                <LucideCheckCn Size="16" Class="size-2.5 text-primary-foreground" />
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@plan.Payments payments of $@plan.PerPayment.ToString("F2")</span>
                            <p class="text-xs text-muted-foreground">
                                @(plan.Apr == 0 ? "0% interest" : $"{plan.Apr}% APR")
                            </p>
                        </div>
                        <span class="shrink-0 text-xs text-muted-foreground">@plan.Provider</span>
                    </div>

                    @* Expanded Schedule *@
                    @if (isSelected)
                    {
                        <div class="px-4 pb-3 pl-11">
                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="mb-2 block font-medium text-muted-foreground text-xs">Payment schedule</span>
                                <div class="space-y-1.5">
                                    @for (var j = 0; j < plan.Schedule.Length; j++)
                                    {
                                        var entry = plan.Schedule[j];
                                        <div class="flex items-center justify-between">
                                            <span class="flex items-center gap-2 text-xs">
                                                <span class="text-muted-foreground">@(j + 1).</span>
                                                <span>@entry.Date</span>
                                                @if (j == 0)
                                                {
                                                    <span class="text-[10px] text-muted-foreground">(today)</span>
                                                }
                                            </span>
                                            <span class="text-xs font-medium tabular-nums">$@entry.Amount.ToString("F2")</span>
                                        </div>
                                    }
                                </div>
                                @if (plan.Apr > 0)
                                {
                                    <p class="mt-2 border-t pt-2 text-[10px] text-muted-foreground">
                                        Total with interest: $@((plan.PerPayment * plan.Payments).ToString("F2")) (@plan.Apr% APR)
                                    </p>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Eligibility Note *@
        <div class="border-t px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <p class="text-xs text-muted-foreground">
                    Subject to eligibility check. You must be 18+ with a valid payment method. No impact
                    on your credit score. Payment schedule begins at checkout confirmation.
                </p>
            </div>
        </div>

        @* Apply Button *@
        <div class="border-t px-4 py-3">
            <ButtonCn Class="h-8 w-full text-xs" Size="ButtonSize.Sm">
                Continue with @(_plans.FirstOrDefault(p => p.Id == _selectedPlan)?.Provider)
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ScheduleEntry(string Date, decimal Amount);
    private record PlanInfo(string Id, string Provider, int Payments, decimal PerPayment, decimal Apr, ScheduleEntry[] Schedule);

    private string _selectedPlan = "klarna-4";

    private static readonly PlanInfo[] _plans =
    {
        new("klarna-4", "Klarna", 4, 62.25m, 0,
            new[] { new ScheduleEntry("Mar 17, 2026", 62.25m), new ScheduleEntry("Apr 17, 2026", 62.25m), new ScheduleEntry("May 17, 2026", 62.25m), new ScheduleEntry("Jun 17, 2026", 62.25m) }),
        new("afterpay-6", "Afterpay", 6, 41.50m, 0,
            new[] { new ScheduleEntry("Mar 17, 2026", 41.50m), new ScheduleEntry("Apr 17, 2026", 41.50m), new ScheduleEntry("May 17, 2026", 41.50m), new ScheduleEntry("Jun 17, 2026", 41.50m), new ScheduleEntry("Jul 17, 2026", 41.50m), new ScheduleEntry("Aug 17, 2026", 41.50m) }),
        new("affirm-12", "Affirm", 12, 22.92m, 5.9m,
            new[] { new ScheduleEntry("Mar 17, 2026", 22.92m), new ScheduleEntry("Apr 17, 2026", 22.92m), new ScheduleEntry("May 17, 2026", 22.92m), new ScheduleEntry("Jun 17, 2026", 22.92m), new ScheduleEntry("Jul 17, 2026", 22.92m), new ScheduleEntry("Aug 17, 2026", 22.92m), new ScheduleEntry("Sep 17, 2026", 22.92m), new ScheduleEntry("Oct 17, 2026", 22.92m), new ScheduleEntry("Nov 17, 2026", 22.92m), new ScheduleEntry("Dec 17, 2026", 22.92m), new ScheduleEntry("Jan 17, 2027", 22.92m), new ScheduleEntry("Feb 17, 2027", 22.92m) })
    };
}
