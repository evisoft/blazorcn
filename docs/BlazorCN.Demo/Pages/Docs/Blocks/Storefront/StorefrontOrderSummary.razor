@* ============================================================
   Block: storefront-order-summary
   Title: Storefront Order Summary
   Description: Storefront order confirmation receipt with itemized breakdown, payment details, and delivery estimate
   Dependencies: ButtonCn, LucideCheckCircle2Cn, LucideCopyCn, LucidePackageCn, LucideTruckCn
   Source: original/blocks/storefront/storefront-order-summary.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideCircleCheckBigCn Size="16" Class="size-4 text-emerald-500" />
                <h2 class="text-sm font-medium">Order Confirmed</h2>
            </div>
            <div class="mt-1 flex items-center gap-1.5">
                <span class="font-mono text-xs text-muted-foreground">@_order.Id</span>
                <ButtonCn Class="h-5 gap-1 px-1.5 text-xs" Variant="ButtonVariant.Ghost" @onclick="HandleCopy">
                    <LucideCopyCn Size="16" Class="size-3" />
                    @(_copied ? "Copied" : "Copy")
                </ButtonCn>
            </div>
        </div>

        @* Items *@
        @foreach (var item in _orderItems)
        {
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <div class="flex size-12 shrink-0 items-center justify-center rounded-md bg-muted/50">
                    <LucidePackageCn Size="16" Class="size-4 text-muted-foreground/60" />
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium">@item.Name</p>
                    <p class="text-xs text-muted-foreground">@item.Variant · Qty @item.Quantity</p>
                </div>
                <span class="shrink-0 text-sm font-medium tabular-nums">$@item.Price</span>
            </div>
        }

        @* Payment Method *@
        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">Payment</p>
            <p class="mt-0.5 text-sm">Visa ending in 4242</p>
        </div>

        @* Shipping Address *@
        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">Ship to</p>
            <div class="mt-0.5 text-sm">
                <p>Alex Johnson</p>
                <p class="text-xs text-muted-foreground">742 Evergreen Terrace, Apt 3B</p>
                <p class="text-xs text-muted-foreground">Portland, OR 97201</p>
            </div>
        </div>

        @* Delivery Estimate *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideTruckCn Size="16" Class="size-3.5 text-muted-foreground" />
                <p class="text-xs font-medium text-muted-foreground">Estimated Delivery</p>
            </div>
            <p class="mt-0.5 text-sm">Mar 21 – Mar 24, 2026</p>
        </div>

        @* Order Total Breakdown *@
        <div class="px-4 py-3">
            <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Subtotal</span>
                    <span class="text-xs tabular-nums">$@_order.Subtotal.ToString("F2")</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Shipping</span>
                    <span class="text-xs tabular-nums">$@_order.Shipping.ToString("F2")</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Tax</span>
                    <span class="text-xs tabular-nums">$@_order.Tax.ToString("F2")</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Discount</span>
                    <span class="text-xs tabular-nums text-emerald-600">−$@Math.Abs(_order.Discount).ToString("F2")</span>
                </div>
                <div class="border-t pt-1.5">
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-medium">Total</span>
                        <span class="text-2xl font-semibold tabular-nums">$@_order.Total.ToString("F2")</span>
                    </div>
                </div>
            </div>
        </div>

        @* Footer Actions *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <a class="text-xs text-muted-foreground hover:text-foreground" href="#">Need help with this order?</a>
                <ButtonCn Class="h-7 gap-1 px-2 text-xs" Variant="ButtonVariant.Outline">
                    <LucidePackageCn Size="16" Class="size-3" />
                    Track Order
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record OrderItemInfo(int Id, string Name, string Variant, int Quantity, int Price);
    private record OrderInfo(string Id, decimal Subtotal, decimal Shipping, decimal Tax, decimal Discount, decimal Total);

    private static readonly OrderItemInfo[] _orderItems =
    {
        new(1, "Merino Wool Crewneck", "Charcoal / M", 1, 145),
        new(2, "Canvas Low-Top Sneakers", "White / 10", 1, 98),
        new(3, "Leather Weekend Bag", "Tan / One Size", 1, 295)
    };

    private static readonly OrderInfo _order = new("ORD-2026-4817", 538m, 12m, 43.04m, -50m, 543.04m);

    private bool _copied;

    private async Task HandleCopy()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
