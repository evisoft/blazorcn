@* ============================================================
   Block: storefront-abandoned-cart-recovery
   Title: Storefront Abandoned Cart Recovery
   Description: Cart recovery panel with saved items, limited-time discount, complete purchase CTA, and save for later option
   Long Description: Win back customers who left items behind with this abandoned cart recovery block. Displays a personalized message with saved cart items, a limited-time discount offer with expiration countdown, a prominent complete your purchase call to action, and a subtle save for later alternative. The flat container layout with border dividers keeps the urgency clear without being aggressive. Built with Button and Input components following the minimal Vercel aesthetic.
   Dependencies: ButtonCn, InputCn, LucideBookmarkCn, LucidePackageCn, LucideShoppingBagCn, LucideTagCn, LucideTrashCn, LucideXCn
   Source: original/blocks/storefront/storefront-abandoned-cart-recovery.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideShoppingBagCn Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="font-medium text-sm">You left something behind</h2>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Your cart is waiting — complete your purchase before items sell out
            </p>
        </div>

        @* Discount Banner *@
        <div class="border-b bg-muted/50 px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideTagCn Size="16" Class="size-3.5 text-muted-foreground" />
                <p class="font-medium text-sm">@DiscountPercent% off your order</p>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Use code <span class="font-mono font-medium text-foreground">@DiscountCode</span> — expires in 23 hours
            </p>
        </div>

        @* Cart Items *@
        <div>
            @for (var i = 0; i < _activeItems.Count; i++)
            {
                var item = _activeItems[i];
                var isLast = i == _activeItems.Count - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", !isLast ? "border-b" : "")">
                    <div class="flex size-12 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        <LucidePackageCn Size="16" Class="size-4 text-muted-foreground/60" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="font-medium text-sm">@item.Name</p>
                        <p class="text-muted-foreground text-xs">@item.Variant</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Qty: @item.Quantity</p>
                    </div>
                    <div class="shrink-0 text-right">
                        <p class="font-medium text-sm tabular-nums">
                            $@((item.Price * item.Quantity).ToString("F2"))
                        </p>
                        <div class="mt-1 flex items-center gap-1">
                            <ButtonCn Class="size-6" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" @onclick="() => SaveForLater(item.Id)" aria-label="Bookmark">
                                <LucideBookmarkCn Size="16" Class="size-3" />
                            </ButtonCn>
                            <ButtonCn Class="size-6" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" @onclick="() => RemoveItem(item.Id)" aria-label="Delete">
                                <LucideTrashCn Size="16" Class="size-3" />
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Promo Code *@
        <div class="border-t px-4 py-3">
            @if (_promoApplied)
            {
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-emerald-600 text-xs">
                        @DiscountCode applied — @DiscountPercent% off
                    </span>
                    <ButtonCn Class="ml-auto h-6 gap-1 px-2 text-xs" Variant="ButtonVariant.Ghost" @onclick="RemovePromo">
                        <LucideXCn Size="16" Class="size-3" />
                        Remove
                    </ButtonCn>
                </div>
            }
            else
            {
                <div class="flex items-center gap-2">
                    <InputCn aria-label="Promo code" Class="h-8 flex-1 text-sm" placeholder="Enter promo code" @bind-Value="_promoCode" />
                    <ButtonCn Class="h-8 px-3 text-xs" disabled="@(string.IsNullOrWhiteSpace(_promoCode))" Variant="ButtonVariant.Outline" @onclick="ApplyPromo">
                        Apply
                    </ButtonCn>
                </div>
            }
        </div>

        @* Summary *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between text-muted-foreground text-xs">
                <span>Subtotal (@_activeItems.Count items)</span>
                <span class="tabular-nums">$@Subtotal.ToString("F2")</span>
            </div>
            @if (_promoApplied)
            {
                <div class="mt-1 flex items-center justify-between text-emerald-600 text-xs">
                    <span>Discount (@DiscountPercent%)</span>
                    <span class="tabular-nums">-$@Discount.ToString("F2")</span>
                </div>
            }
            <div class="mt-2 flex items-center justify-between border-t pt-2">
                <span class="font-medium text-sm">Total</span>
                <span class="font-semibold text-2xl tabular-nums">$@Total.ToString("F2")</span>
            </div>
        </div>

        @* Actions *@
        <div class="border-t px-4 py-3">
            <ButtonCn Class="h-9 w-full text-sm" Size="ButtonSize.Sm">
                Complete Your Purchase
            </ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                Free shipping on orders over $150
            </p>
        </div>

        @* Saved for Later *@
        @if (_savedItems.Count > 0)
        {
            <div class="border-t">
                <div class="px-4 py-2">
                    <p class="font-medium text-muted-foreground text-xs">
                        Saved for Later (@_savedItems.Count)
                    </p>
                </div>
                @for (var i = 0; i < _savedItems.Count; i++)
                {
                    var item = _savedItems[i];
                    var isLast = i == _savedItems.Count - 1;
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 opacity-60", !isLast ? "border-b" : "")">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucidePackageCn Size="16" Class="size-3 text-muted-foreground/60" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="font-medium text-xs">@item.Name</p>
                            <p class="text-muted-foreground text-xs">$@item.Price.ToString("F2")</p>
                        </div>
                        <ButtonCn Class="h-6 px-2 text-xs" Variant="ButtonVariant.Ghost" @onclick="() => MoveToCart(item.Id)">
                            Move to Cart
                        </ButtonCn>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record CartItem(string Id, string Name, string Variant, decimal Price, int Quantity);

    private const string DiscountCode = "COMEBACK15";
    private const int DiscountPercent = 15;

    private List<CartItem> _items = new()
    {
        new("1", "Merino Wool Sweater", "Charcoal \u00b7 Size M", 128.00m, 1),
        new("2", "Slim Fit Chinos", "Navy \u00b7 32\u00d732", 89.00m, 2),
        new("3", "Canvas Sneakers", "White \u00b7 US 10", 74.00m, 1)
    };

    private string _promoCode = "";
    private bool _promoApplied;
    private List<string> _savedForLater = new();

    private List<CartItem> _activeItems => _items.Where(i => !_savedForLater.Contains(i.Id)).ToList();
    private List<CartItem> _savedItems => _items.Where(i => _savedForLater.Contains(i.Id)).ToList();

    private decimal Subtotal => _activeItems.Sum(i => i.Price * i.Quantity);
    private decimal Discount => _promoApplied ? Subtotal * DiscountPercent / 100m : 0m;
    private decimal Total => Subtotal - Discount;

    private void RemoveItem(string id)
    {
        _items = _items.Where(i => i.Id != id).ToList();
        _savedForLater = _savedForLater.Where(s => s != id).ToList();
    }

    private void SaveForLater(string id)
    {
        _savedForLater.Add(id);
    }

    private void MoveToCart(string id)
    {
        _savedForLater = _savedForLater.Where(s => s != id).ToList();
    }

    private void ApplyPromo()
    {
        if (_promoCode.Trim().ToUpperInvariant() == DiscountCode)
        {
            _promoApplied = true;
        }
    }

    private void RemovePromo()
    {
        _promoApplied = false;
        _promoCode = "";
    }
}
