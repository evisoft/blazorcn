@* ============================================================
   Block: storefront-product-qa
   Title: Storefront Product Qa
   Description: Product Q&A block with searchable questions, expandable answers, helpfulness voting, upvote counts, and ask-a-question form
   Dependencies: ButtonCn, InputCn, LucideChevronRightCn, LucideMessageCircleQuestionCn, LucideSearchCn, LucideThumbsDownCn, LucideThumbsUpCn
   Source: original/blocks/storefront/storefront-product-qa.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideMessageCircleQuestionCn Size="16" Class="size-4 text-muted-foreground" />
                <h1 class="text-sm font-medium">Questions &amp; Answers</h1>
                <span class="text-xs text-muted-foreground">(@_questions.Length)</span>
            </div>
        </div>

        @* Search *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideSearchCn Size="16" Class="size-3.5 shrink-0 text-muted-foreground" />
            <InputCn Class="h-7 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0"
                     Placeholder="Search questions..."
                     @bind-Value="_searchQuery" />
        </div>

        @* Questions *@
        <div>
            @{ var filtered = FilteredQuestions; }
            @if (filtered.Length > 0)
            {
                @for (var i = 0; i < filtered.Length; i++)
                {
                    var q = filtered[i];
                    var isExpanded = _expanded == q.Id;
                    var isLast = i == filtered.Length - 1;
                    <div class="@(!isLast ? "border-b" : "")">
                        <button class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                                type="button"
                                @onclick="() => _expanded = isExpanded ? null : q.Id">
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium">@q.Question</span>
                                <div class="mt-0.5 flex items-center gap-2">
                                    <span class="text-xs text-muted-foreground">Asked by @q.Asker</span>
                                    <span class="text-xs text-muted-foreground">&middot;</span>
                                    <span class="text-xs text-muted-foreground">@q.TimeAgo</span>
                                    <span class="text-xs text-muted-foreground">&middot;</span>
                                    <span class="text-xs tabular-nums text-muted-foreground">@q.Upvotes upvotes</span>
                                </div>
                            </div>
                            <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </button>

                        @if (isExpanded)
                        {
                            <div class="px-4 pb-4">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <div class="mb-1 flex items-center gap-1.5">
                                        <span class="text-xs font-medium">@q.AnsweredBy</span>
                                    </div>
                                    <p class="text-sm leading-relaxed">@q.Answer</p>
                                </div>
                                <div class="mt-2 flex items-center gap-3">
                                    <span class="text-xs text-muted-foreground">Was this helpful?</span>
                                    <div class="flex items-center gap-1">
                                        @{ var qId = q.Id; }
                                        <ButtonCn Class="@GetVoteClass(qId, "up")"
                                                  Size="ButtonSize.Sm"
                                                  Variant="ButtonVariant.Ghost"
                                                  @onclick="@(() => HandleVoteUp(qId))">
                                            <LucideThumbsUpCn Size="16" Class="size-3" />
                                            Yes
                                        </ButtonCn>
                                        <ButtonCn Class="@GetVoteClass(qId, "down")"
                                                  Size="ButtonSize.Sm"
                                                  Variant="ButtonVariant.Ghost"
                                                  @onclick="@(() => HandleVoteDown(qId))">
                                            <LucideThumbsDownCn Size="16" Class="size-3" />
                                            No
                                        </ButtonCn>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="px-4 py-8 text-center">
                    <p class="text-sm font-medium">No matching questions</p>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Try a different search or ask a new question below
                    </p>
                </div>
            }
        </div>

        @* Ask a Question *@
        <div class="border-t px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">Ask a question</span>
            <TextareaCn Class="resize-none text-xs"
                        Placeholder="What would you like to know about this product?"
                        rows="2"
                        @bind-Value="_newQuestion" />
            <div class="mt-2 flex justify-end">
                <ButtonCn Class="h-7 text-xs" Disabled="@(string.IsNullOrWhiteSpace(_newQuestion))" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                    Submit Question
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record QuestionInfo(string Id, string Question, string Asker, string TimeAgo, int Upvotes, string Answer, string AnsweredBy);

    private static readonly QuestionInfo[] _questions =
    {
        new("1", "Is this machine dishwasher safe?", "Rachel M.", "3 weeks ago", 24, "Yes, all removable parts including the carafe, filter basket, and water reservoir lid are top-rack dishwasher safe. The base unit should be wiped clean with a damp cloth only.", "Store Team"),
        new("2", "Does it have a built-in grinder?", "James K.", "2 weeks ago", 18, "This model does not include a built-in grinder. We recommend pairing it with our Conical Burr Grinder for the best results. Pre-ground coffee works perfectly as well.", "Store Team"),
        new("3", "How long does it take to brew a full pot?", "Priya S.", "1 week ago", 12, "A full 12-cup pot brews in approximately 8 minutes. The thermal carafe keeps coffee hot for up to 4 hours without a hot plate, which prevents burning.", "Store Team"),
        new("4", "Can I use it with a reusable filter?", "Tom H.", "5 days ago", 9, "Absolutely. It\u2019s compatible with standard #4 cone filters, both paper and reusable mesh. A gold-tone reusable filter is included in the box.", "Store Team"),
        new("5", "What\u2019s the warranty period?", "Linda C.", "3 days ago", 6, "The brewer comes with a 2-year manufacturer warranty covering defects in materials and workmanship. Register your product within 30 days of purchase for an additional 1-year extension.", "Store Team")
    };

    private string? _expanded = "1";
    private string _searchQuery = "";
    private string _newQuestion = "";
    private Dictionary<string, string> _voted = new();

    private QuestionInfo[] FilteredQuestions => string.IsNullOrWhiteSpace(_searchQuery)
        ? _questions
        : _questions.Where(q =>
            q.Question.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
            q.Answer.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)).ToArray();

    private string GetVoteClass(string id, string type)
    {
        var highlight = type == "up"
            ? "text-emerald-600 dark:text-emerald-400"
            : "text-red-600 dark:text-red-400";
        return Cn.Merge("h-6 gap-1 px-2 text-xs", _voted.GetValueOrDefault(id) == type ? highlight : "");
    }

    private void HandleVoteUp(string id) => HandleVote(id, "up");
    private void HandleVoteDown(string id) => HandleVote(id, "down");

    private void HandleVote(string id, string type)
    {
        if (_voted.TryGetValue(id, out var existing) && existing == type)
            _voted.Remove(id);
        else
            _voted[id] = type;
    }
}
