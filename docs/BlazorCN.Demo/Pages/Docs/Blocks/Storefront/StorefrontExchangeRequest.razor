@* ============================================================
   Block: storefront-exchange-request
   Title: Storefront Exchange Request
   Description: Product exchange form with original item details, exchange reason selector, new variant picker, price difference calculation, and return shipping method
   Dependencies: ButtonCn, LucideArrowLeftRightCn, LucideChevronRightCn, LucidePackageCn, LucideSendCn, RadioGroupCn, RadioGroupItemCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn
   Source: original/blocks/storefront/storefront-exchange-request.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideArrowLeftRightCn Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Exchange Request</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">@OriginalOrderId &middot; @OriginalOrderDate</p>
        </div>

        @* Original Item *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Original item</p>
            <div class="flex items-center gap-3">
                <div class="flex size-14 shrink-0 items-center justify-center rounded-md bg-muted/50">
                    <LucidePackageCn Size="16" Class="size-5 text-muted-foreground/60" />
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium">@OriginalName</p>
                    <p class="text-xs text-muted-foreground">@OriginalVariant</p>
                </div>
                <span class="shrink-0 text-sm font-medium tabular-nums">$@OriginalPrice</span>
            </div>
        </div>

        @* Exchange Reason *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Reason for exchange</p>
            <SelectCn TValue="string" Value="@_reason" ValueChanged="v => _reason = v">
                <SelectTriggerCn Class="h-8 text-xs">
                    <SelectValueCn placeholder="Select a reason" />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var r in _exchangeReasons)
                    {
                        <SelectItemCn Value="@r.Value">@r.Label</SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
        </div>

        @* New Variant: Size *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">New size</p>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var option in _sizeOptions)
                {
                    <button type="button"
                            class="@Cn.Merge("flex items-center gap-1.5 rounded-md border px-3 py-1.5 text-xs transition-colors", !option.Available ? "cursor-not-allowed opacity-40" : "", _newSize == option.Id ? "border-primary bg-muted/50 font-medium" : option.Available ? "hover:bg-muted/50" : "")"
                            disabled="@(!option.Available)"
                            @onclick="() => _newSize = option.Id">
                        @option.Label
                        @if (option.PriceDelta > 0)
                        {
                            <span class="text-muted-foreground">+$@option.PriceDelta</span>
                        }
                    </button>
                }
            </div>
        </div>

        @* New Variant: Color *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">New color</p>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var option in _colorOptions)
                {
                    <button type="button"
                            class="@Cn.Merge("flex items-center gap-1.5 rounded-md border px-3 py-1.5 text-xs transition-colors", !option.Available ? "cursor-not-allowed opacity-40" : "", _newColor == option.Id ? "border-primary bg-muted/50 font-medium" : option.Available ? "hover:bg-muted/50" : "")"
                            disabled="@(!option.Available)"
                            @onclick="() => _newColor = option.Id">
                        @option.Label
                        @if (option.PriceDelta > 0)
                        {
                            <span class="text-muted-foreground">+$@option.PriceDelta</span>
                        }
                    </button>
                }
            </div>
        </div>

        @* New Item Preview *@
        @if (_newSize != null && _newColor != null)
        {
            <div class="border-b px-4 py-3">
                <p class="mb-2 text-xs font-medium text-muted-foreground">Exchange summary</p>
                <div class="flex items-center gap-3">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2 text-xs text-muted-foreground">
                            <span>@OriginalVariant</span>
                            <LucideChevronRightCn Size="16" Class="size-3" />
                            <span class="font-medium text-foreground">@SelectedColor?.Label / @SelectedSize?.Label</span>
                        </div>
                    </div>
                    @if (PriceDifference != 0)
                    {
                        <span class="@Cn.Merge("text-sm font-medium tabular-nums", PriceDifference > 0 ? "text-red-600 dark:text-red-400" : "text-emerald-600 dark:text-emerald-400")">
                            @(PriceDifference > 0 ? "+" : "-")$@Math.Abs(PriceDifference)
                        </span>
                    }
                    else
                    {
                        <span class="text-xs text-muted-foreground">Even exchange</span>
                    }
                </div>
            </div>
        }

        @* Shipping Method *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Return shipping</p>
            <RadioGroupCn Value="@_shippingMethod" ValueChanged="v => _shippingMethod = v" Class="space-y-0">
                @foreach (var method in _shippingMethods)
                {
                    <label class="flex cursor-pointer items-center gap-3 rounded-md px-3 py-2 transition-colors hover:bg-muted/50"
                           for="@($"shipping-{method.Id}")">
                        <RadioGroupItemCn Id="@($"shipping-{method.Id}")" Value="@method.Id" />
                        <div class="min-w-0 flex-1">
                            <span class="text-sm">@method.Label</span>
                            <p class="text-xs text-muted-foreground">@method.Description</p>
                        </div>
                    </label>
                }
            </RadioGroupCn>
        </div>

        @* Price Summary *@
        <div class="border-b px-4 py-3">
            <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Original item</span>
                    <span class="text-xs tabular-nums">$@OriginalPrice</span>
                </div>
                @if (PriceDifference != 0)
                {
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-muted-foreground">Price difference</span>
                        <span class="@Cn.Merge("text-xs tabular-nums", PriceDifference > 0 ? "text-red-600 dark:text-red-400" : "text-emerald-600 dark:text-emerald-400")">
                            @(PriceDifference > 0 ? "+" : "-")$@Math.Abs(PriceDifference)
                        </span>
                    </div>
                }
                @if (ShippingCost > 0)
                {
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-muted-foreground">Return shipping</span>
                        <span class="text-xs tabular-nums">$@ShippingCost</span>
                    </div>
                }
                <div class="flex items-center justify-between border-t pt-2">
                    <span class="text-sm font-medium">
                        @(TotalDue > 0 ? "Amount due" : TotalDue < 0 ? "Refund amount" : "No charge")
                    </span>
                    <span class="text-2xl font-semibold tabular-nums">$@Math.Abs(TotalDue)</span>
                </div>
            </div>
        </div>

        @* Submit *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full gap-1.5 text-xs" Disabled="@(!CanSubmit)" Variant="ButtonVariant.Outline">
                <LucideSendCn Size="16" Class="size-3.5" />
                Submit Exchange Request
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record VariantOption(string Id, string Label, bool Available, int PriceDelta);
    private record ReasonOption(string Value, string Label);
    private record ShippingOption(string Id, string Label, string Description, int Cost);

    private const string OriginalName = "Merino Wool Crewneck";
    private const string OriginalVariant = "Charcoal / M";
    private const int OriginalPrice = 145;
    private const string OriginalOrderId = "ORD-2026-4817";
    private const string OriginalOrderDate = "Mar 10, 2026";

    private static readonly ReasonOption[] _exchangeReasons =
    {
        new("wrong-size", "Wrong size"),
        new("wrong-color", "Wrong color"),
        new("changed-mind", "Changed my mind"),
        new("quality-issue", "Quality issue"),
        new("not-as-described", "Not as described")
    };

    private static readonly VariantOption[] _sizeOptions =
    {
        new("xs", "XS", true, 0),
        new("s", "S", true, 0),
        new("m", "M", false, 0),
        new("l", "L", true, 0),
        new("xl", "XL", true, 10)
    };

    private static readonly VariantOption[] _colorOptions =
    {
        new("charcoal", "Charcoal", false, 0),
        new("navy", "Navy", true, 0),
        new("heather-grey", "Heather Grey", true, 0),
        new("camel", "Camel", true, 15),
        new("burgundy", "Burgundy", true, 0)
    };

    private static readonly ShippingOption[] _shippingMethods =
    {
        new("prepaid", "Prepaid return label", "Free \u00B7 5-7 business days", 0),
        new("drop-off", "Drop off at store", "Free \u00B7 Any location", 0),
        new("express", "Express return pickup", "$12 \u00B7 1-2 business days", 12)
    };

    private string _reason = "";
    private string? _newSize;
    private string? _newColor;
    private string _shippingMethod = "";

    private VariantOption? SelectedSize => _sizeOptions.FirstOrDefault(s => s.Id == _newSize);
    private VariantOption? SelectedColor => _colorOptions.FirstOrDefault(c => c.Id == _newColor);
    private int PriceDifference => (SelectedSize?.PriceDelta ?? 0) + (SelectedColor?.PriceDelta ?? 0);
    private int ShippingCost => _shippingMethods.FirstOrDefault(m => m.Id == _shippingMethod)?.Cost ?? 0;
    private int TotalDue => PriceDifference + ShippingCost;
    private bool CanSubmit => _reason != "" && _newSize != null && _newColor != null && _shippingMethod != "";
}
