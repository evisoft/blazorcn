@* ============================================================
   Block: storefront-dispute-resolution
   Title: Storefront Dispute Resolution
   Description: Order dispute and claim form with issue type selector, photo upload area, description field, resolution options, and case timeline
   Dependencies: ButtonCn, LucideAlertTriangleCn, LucideCameraCn, LucideCheckCircle2Cn, LucideCircleDotCn, LucideClockCn, LucideImageCn, LucidePackageCn, LucidePackageXCn, LucideSearchCn, LucideSendCn, LucideXCn, RadioGroupCn, RadioGroupItemCn
   Source: original/blocks/storefront/storefront-dispute-resolution.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @if (_submitted)
        {
            @* Submitted Header *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideCircleCheckBigCn Size="16" Class="size-4 text-emerald-500" />
                    <span class="text-sm font-medium">Dispute Submitted</span>
                </div>
                <p class="mt-0.5 text-xs text-muted-foreground">Case DSP-2026-0847 · @_order.Id</p>
            </div>

            @* Order Item *@
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                    <LucidePackageCn Size="16" Class="size-3.5 text-muted-foreground/60" />
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium">@_order.ItemName</p>
                    <p class="text-xs text-muted-foreground">@_order.ItemVariant</p>
                </div>
                <span class="shrink-0 text-sm tabular-nums">$@_order.ItemPrice</span>
            </div>

            @* Timeline *@
            <div class="border-b px-4 py-3">
                <p class="mb-3 text-xs font-medium text-muted-foreground">Case timeline</p>
                <div>
                    @for (var i = 0; i < _timelineEvents.Length; i++)
                    {
                        var evt = _timelineEvents[i];
                        var isLastEvent = i == _timelineEvents.Length - 1;
                        <div class="flex gap-3">
                            <div class="flex flex-col items-center">
                                @if (evt.Status == "completed")
                                {
                                    <LucideCircleCheckBigCn Size="16" Class="size-4 shrink-0 text-emerald-500" />
                                }
                                else if (evt.Status == "active")
                                {
                                    <LucideCircleDotCn Size="16" Class="size-4 shrink-0 text-blue-500" />
                                }
                                else
                                {
                                    <LucideClockCn Size="16" Class="size-4 shrink-0 text-muted-foreground/40" />
                                }
                                @if (!isLastEvent)
                                {
                                    <div class="my-1 h-6 w-px bg-border"></div>
                                }
                            </div>
                            <div class="pb-4">
                                <p class="@Cn.Merge("text-sm", evt.Status == "pending" ? "text-muted-foreground" : "font-medium")">
                                    @evt.Label
                                </p>
                                <p class="text-xs text-muted-foreground">@evt.Description</p>
                                @if (!string.IsNullOrEmpty(evt.Date))
                                {
                                    <p class="mt-0.5 text-[10px] text-muted-foreground">@evt.Date</p>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* Expected Resolution *@
            <div class="px-4 py-3">
                <div class="rounded-md bg-muted/50 p-3">
                    <p class="text-xs font-medium text-muted-foreground">Selected resolution</p>
                    <p class="mt-0.5 text-sm">
                        @(_resolutionOptions.FirstOrDefault(r => r.Id == _resolution)?.Label)
                    </p>
                    <p class="mt-1 text-xs text-muted-foreground">
                        You will receive an email when your case is resolved.
                    </p>
                </div>
            </div>
        }
        else
        {
            @* Header *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideTriangleAlertCn Size="16" Class="size-4 text-muted-foreground" />
                    <h2 class="text-sm font-medium">Report a Problem</h2>
                </div>
                <p class="mt-0.5 text-xs text-muted-foreground">@_order.Id · Delivered @_order.Date</p>
            </div>

            @* Order Item *@
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <div class="flex size-12 shrink-0 items-center justify-center rounded-md bg-muted/50">
                    <LucidePackageCn Size="16" Class="size-4 text-muted-foreground/60" />
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium">@_order.ItemName</p>
                    <p class="text-xs text-muted-foreground">@_order.ItemVariant</p>
                </div>
                <span class="shrink-0 text-sm font-medium tabular-nums">$@_order.ItemPrice</span>
            </div>

            @* Issue Type *@
            <div class="border-b px-4 py-3">
                <p class="mb-2 text-xs font-medium text-muted-foreground">What went wrong?</p>
                <div class="space-y-1.5">
                    @foreach (var issue in _issueTypes)
                    {
                        var isSelected = _issueType == issue.Value;
                        <button type="button"
                                class="@Cn.Merge("flex w-full items-center gap-3 rounded-md border px-3 py-2.5 text-left transition-colors", isSelected ? "border-primary bg-muted/50" : "hover:bg-muted/50")"
                                @onclick="() => _issueType = issue.Value">
                            @if (issue.Icon == "alert")
                            {
                                <LucideTriangleAlertCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            }
                            else if (issue.Icon == "package-x")
                            {
                                <LucidePackageXCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            }
                            else
                            {
                                <LucideSearchCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            }
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium">@issue.Label</span>
                                <p class="text-xs text-muted-foreground">@issue.Description</p>
                            </div>
                        </button>
                    }
                </div>
            </div>

            @* Photo Upload *@
            <div class="border-b px-4 py-3">
                <p class="mb-2 text-xs font-medium text-muted-foreground">Upload photos (optional)</p>
                <div class="flex flex-wrap gap-2">
                    @for (var i = 0; i < _photos.Count; i++)
                    {
                        var index = i;
                        <div class="group relative flex size-16 items-center justify-center rounded-md border bg-muted/50">
                            <LucideImageCn Size="16" Class="size-5 text-muted-foreground/60" />
                            <button aria-label="Remove photo" type="button" class="absolute -right-1.5 -top-1.5 flex size-4 items-center justify-center rounded-full border bg-card"
                                    @onclick="() => RemovePhoto(index)">
                                <LucideXCn Size="16" Class="size-2.5" />
                            </button>
                        </div>
                    }
                    @if (_photos.Count < 4)
                    {
                        <button aria-label="Add photo" type="button" class="flex size-16 items-center justify-center rounded-md border border-dashed transition-colors hover:bg-muted/50"
                                @onclick="AddPhoto">
                            <LucideCameraCn Size="16" Class="size-4 text-muted-foreground" />
                        </button>
                    }
                </div>
                <p class="mt-1.5 text-[10px] text-muted-foreground">Up to 4 photos. JPG or PNG, max 10MB each.</p>
            </div>

            @* Description *@
            <div class="border-b px-4 py-3">
                <p class="mb-2 text-xs font-medium text-muted-foreground">Describe the issue</p>
                <TextareaCn aria-label="Describe the issue" Class="min-h-[80px] resize-none"
                            Placeholder="Tell us what happened in detail..."
                            @bind-Value="_description" />
                <p class="mt-1 text-[10px] text-muted-foreground">
                    Minimum 10 characters. Be specific about the damage or discrepancy.
                </p>
            </div>

            @* Desired Resolution *@
            <div class="border-b px-4 py-3">
                <p class="mb-2 text-xs font-medium text-muted-foreground">Preferred resolution</p>
                <RadioGroupCn Value="@_resolution" ValueChanged="v => _resolution = v">
                    @foreach (var option in _resolutionOptions)
                    {
                        <label class="flex cursor-pointer items-center gap-3 rounded-md px-3 py-2 transition-colors hover:bg-muted/50">
                            <RadioGroupItemCn Value="@option.Id" />
                            <div class="min-w-0 flex-1">
                                <span class="text-sm">@option.Label</span>
                                <p class="text-xs text-muted-foreground">@option.Description</p>
                            </div>
                        </label>
                    }
                </RadioGroupCn>
            </div>

            @* Submit *@
            <div class="px-4 py-3">
                <ButtonCn Class="w-full gap-1.5 text-xs" disabled="@(!CanSubmit)" Variant="ButtonVariant.Outline" @onclick="() => _submitted = true">
                    <LucideSendCn Size="16" Class="size-3.5" />
                    Submit Dispute
                </ButtonCn>
                <p class="mt-2 text-center text-[10px] text-muted-foreground">
                    We typically resolve disputes within 2-3 business days
                </p>
            </div>
        }
    </div>
</section>

@code {
    private record OrderInfo(string Id, string Date, string ItemName, string ItemVariant, int ItemPrice);
    private record IssueTypeInfo(string Value, string Label, string Description, string Icon);
    private record ResolutionOptionInfo(string Id, string Label, string Description);
    private record TimelineEventInfo(string Id, string Label, string Description, string Date, string Status);

    private static readonly OrderInfo _order = new("ORD-2026-5102", "Mar 11, 2026", "Leather Weekend Bag", "Tan / One Size", 295);

    private static readonly IssueTypeInfo[] _issueTypes =
    {
        new("damaged", "Damaged item", "Item arrived broken, torn, or defective", "alert"),
        new("wrong-item", "Wrong item received", "Received a different product or variant", "package-x"),
        new("missing", "Missing from order", "Item was not included in the shipment", "search")
    };

    private static readonly ResolutionOptionInfo[] _resolutionOptions =
    {
        new("refund", "Full refund", "Refund to original payment method"),
        new("replacement", "Send replacement", "Ship a new item at no charge"),
        new("credit", "Store credit", "Receive 110% of item value as credit")
    };

    private static readonly TimelineEventInfo[] _timelineEvents =
    {
        new("t1", "Dispute submitted", "Your claim has been received", "Mar 14, 2026", "completed"),
        new("t2", "Under review", "Our team is investigating your claim", "Mar 14, 2026", "active"),
        new("t3", "Resolution", "Expected within 2-3 business days", "", "pending")
    };

    private string? _issueType;
    private string _description = "";
    private string _resolution = "";
    private List<string> _photos = new();
    private bool _submitted;

    private bool CanSubmit => _issueType != null && _description.Length >= 10 && _resolution != "";

    private void AddPhoto()
    {
        if (_photos.Count < 4)
        {
            var placeholders = new[] { "photo-1.jpg", "photo-2.jpg", "photo-3.jpg", "photo-4.jpg" };
            _photos.Add(placeholders[_photos.Count]);
        }
    }

    private void RemovePhoto(int index)
    {
        _photos.RemoveAt(index);
    }
}
