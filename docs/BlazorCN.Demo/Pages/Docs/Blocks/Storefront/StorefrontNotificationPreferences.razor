@* ============================================================
   Block: storefront-notification-preferences
   Title: Storefront Notification Preferences
   Description: Shopping notification preferences block with toggle switches for order updates, marketing alerts, and channel selection
   Dependencies: ButtonCn, LucideBellCn, SwitchCn
   Source: original/blocks/storefront/storefront-notification-preferences.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideBellCn Size="16" Class="size-4 text-muted-foreground" />
                <h1 class="text-sm font-medium">Notification Preferences</h1>
            </div>
        </div>

        @* Notification Sections *@
        @for (var si = 0; si < _sections.Length; si++)
        {
            var sec = _sections[si];
            <div class="border-b">
                <div class="border-b px-4 py-2.5">
                    <span class="text-xs font-medium text-muted-foreground">@sec.Title</span>
                </div>
                @for (var i = 0; i < sec.Settings.Length; i++)
                {
                    var setting = sec.Settings[i];
                    var isLast = i == sec.Settings.Length - 1;
                    var sectionIdx = si;
                    <div class="@Cn.Merge("flex items-center justify-between px-4 py-3", !isLast ? "border-b" : "")">
                        <div class="min-w-0 flex-1 pr-4">
                            <span class="text-sm font-medium">@setting.Label</span>
                            <p class="mt-0.5 text-xs text-muted-foreground">@setting.Description</p>
                        </div>
                        <SwitchCn aria-label="@setting.Label" Checked="@setting.Enabled" CheckedChanged="() => ToggleSetting(sectionIdx, setting.Id)" />
                    </div>
                }
            </div>
        }

        @* Channels *@
        <div class="border-b">
            <div class="border-b px-4 py-2.5">
                <span class="text-xs font-medium text-muted-foreground">Channels</span>
            </div>
            @for (var i = 0; i < _channels.Length; i++)
            {
                var channel = _channels[i];
                var isLast = i == _channels.Length - 1;
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-3", !isLast ? "border-b" : "")">
                    <div class="min-w-0 flex-1 pr-4">
                        <span class="text-sm font-medium">@channel.Label</span>
                        <p class="mt-0.5 text-xs text-muted-foreground">@channel.Description</p>
                    </div>
                    <SwitchCn aria-label="@channel.Label" Checked="@channel.Enabled" CheckedChanged="() => ToggleChannel(channel.Id)" />
                </div>
            }
        </div>

        @* Actions *@
        <div class="px-4 py-3">
            <ButtonCn Class="h-8 w-full text-xs" Size="ButtonSize.Sm">
                Save Preferences
            </ButtonCn>
            <p class="mt-2 text-center">
                <button type="button"
                        class="text-xs text-muted-foreground underline underline-offset-2 transition-colors hover:text-foreground"
                        @onclick="UnsubscribeAll">
                    Unsubscribe from all
                </button>
            </p>
        </div>
    </div>
</section>

@code {
    private class NotificationSetting
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string Description { get; set; } = "";
        public bool Enabled { get; set; }
    }

    private class NotificationSection
    {
        public string Title { get; set; } = "";
        public NotificationSetting[] Settings { get; set; } = [];
    }

    private class ChannelSetting
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string Description { get; set; } = "";
        public bool Enabled { get; set; }
    }

    private NotificationSection[] _sections =
    {
        new()
        {
            Title = "Order Updates",
            Settings = new NotificationSetting[]
            {
                new() { Id = "order-confirmation", Label = "Order confirmation", Description = "Receive confirmation when your order is placed", Enabled = true },
                new() { Id = "shipping-updates", Label = "Shipping updates", Description = "Get notified when your order ships and is in transit", Enabled = true },
                new() { Id = "delivery-notification", Label = "Delivery notification", Description = "Know when your package has been delivered", Enabled = true }
            }
        },
        new()
        {
            Title = "Marketing",
            Settings = new NotificationSetting[]
            {
                new() { Id = "new-arrivals", Label = "New arrivals", Description = "Be the first to see newly added products", Enabled = true },
                new() { Id = "sale-alerts", Label = "Sale alerts", Description = "Get notified about sales and promotions", Enabled = false },
                new() { Id = "back-in-stock", Label = "Back in stock", Description = "Alerts when wishlisted items are restocked", Enabled = true }
            }
        }
    };

    private ChannelSetting[] _channels =
    {
        new() { Id = "email", Label = "Email", Description = "Receive notifications via email", Enabled = true },
        new() { Id = "sms", Label = "SMS", Description = "Receive notifications via text message", Enabled = false }
    };

    private void ToggleSetting(int sectionIndex, string settingId)
    {
        var setting = _sections[sectionIndex].Settings.FirstOrDefault(s => s.Id == settingId);
        if (setting != null) setting.Enabled = !setting.Enabled;
    }

    private void ToggleChannel(string channelId)
    {
        var channel = _channels.FirstOrDefault(c => c.Id == channelId);
        if (channel != null) channel.Enabled = !channel.Enabled;
    }

    private void UnsubscribeAll()
    {
        foreach (var section in _sections)
            foreach (var setting in section.Settings)
                setting.Enabled = false;
        foreach (var channel in _channels)
            channel.Enabled = false;
    }
}
