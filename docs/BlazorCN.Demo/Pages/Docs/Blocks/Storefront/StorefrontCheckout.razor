@* ============================================================
   Block: storefront-checkout
   Title: Storefront Checkout
   Description: Storefront checkout form with contact info, shipping address, delivery method, and order summary
   Dependencies: ButtonCn, InputCn, LabelCn, LucidePackageCn, RadioGroupCn, RadioGroupItemCn
   Source: original/blocks/storefront/storefront-checkout.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Checkout</h2>
            <p class="text-xs text-muted-foreground">@_cartItems.Length items in your order</p>
        </div>

        <div class="grid md:grid-cols-[1fr,320px]">
            @* Left Panel - Form *@
            <div class="border-r">
                @* Contact *@
                <div class="border-b px-4 py-3">
                    <LabelCn Class="mb-2 block text-xs font-medium text-muted-foreground" For="checkout-email">Contact</LabelCn>
                    <InputCn Class="h-8 text-sm" Id="checkout-email" placeholder="Email address" type="email" />
                </div>

                @* Shipping Address *@
                <div class="border-b px-4 py-3">
                    <span class="mb-2 block text-xs font-medium text-muted-foreground">Shipping Address</span>
                    <div class="grid gap-2">
                        <div class="grid grid-cols-2 gap-2">
                            <InputCn aria-label="First name" Class="h-8 text-sm" placeholder="First name" />
                            <InputCn aria-label="Last name" Class="h-8 text-sm" placeholder="Last name" />
                        </div>
                        <InputCn aria-label="Address" Class="h-8 text-sm" placeholder="Address" />
                        <InputCn aria-label="Apartment, suite, etc." Class="h-8 text-sm" placeholder="Apartment, suite, etc. (optional)" />
                        <div class="grid grid-cols-3 gap-2">
                            <InputCn aria-label="City" Class="h-8 text-sm" placeholder="City" />
                            <InputCn aria-label="State" Class="h-8 text-sm" placeholder="State" />
                            <InputCn aria-label="ZIP code" Class="h-8 text-sm" placeholder="ZIP code" />
                        </div>
                    </div>
                </div>

                @* Shipping Method *@
                <div class="px-4 py-3">
                    <span class="mb-2 block text-xs font-medium text-muted-foreground">Shipping Method</span>
                    <RadioGroupCn Value="@_shippingMethod" ValueChanged="v => _shippingMethod = v">
                        @foreach (var method in _shippingMethods)
                        {
                            <label class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-md px-3 py-2 transition-colors hover:bg-muted/50", _shippingMethod == method.Id ? "bg-muted/50" : "")"
                                   for="@($"checkout-shipping-{method.Id}")">
                                <RadioGroupItemCn Id="@($"checkout-shipping-{method.Id}")" Value="@method.Id" />
                                <div class="flex-1">
                                    <p class="text-sm font-medium">@method.Label</p>
                                    <p class="text-xs text-muted-foreground">@method.Description</p>
                                </div>
                                <span class="text-sm tabular-nums">
                                    @(method.Price == 0 ? "Free" : $"${method.Price}")
                                </span>
                            </label>
                        }
                    </RadioGroupCn>
                </div>
            </div>

            @* Right Panel - Order Summary *@
            <div>
                <div class="border-b px-4 py-3">
                    <span class="text-xs font-medium text-muted-foreground">Order Summary</span>
                </div>

                @* Items *@
                @for (var i = 0; i < _cartItems.Length; i++)
                {
                    var item = _cartItems[i];
                    var isLast = i == _cartItems.Length - 1;
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", !isLast ? "border-b" : "")">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucidePackageCn Size="16" Class="size-4 text-muted-foreground/60" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="truncate text-sm font-medium">@item.Name</p>
                            <p class="text-xs text-muted-foreground">@item.Variant</p>
                        </div>
                        <span class="shrink-0 text-sm tabular-nums">$@item.Price</span>
                    </div>
                }

                @* Totals *@
                <div class="border-t px-4 py-3">
                    <div class="flex items-center justify-between py-0.5">
                        <span class="text-xs text-muted-foreground">Subtotal</span>
                        <span class="text-sm tabular-nums">$@Subtotal</span>
                    </div>
                    <div class="flex items-center justify-between py-0.5">
                        <span class="text-xs text-muted-foreground">Shipping</span>
                        <span class="text-sm tabular-nums">
                            @(Shipping == 0 ? "Free" : $"${Shipping}")
                        </span>
                    </div>
                    <div class="flex items-center justify-between py-0.5">
                        <span class="text-xs text-muted-foreground">Tax</span>
                        <span class="text-sm tabular-nums">$@Tax.ToString("F2")</span>
                    </div>
                </div>

                <div class="border-t px-4 py-3">
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-medium">Total</span>
                        <span class="text-2xl font-semibold tabular-nums">$@Total.ToString("F2")</span>
                    </div>
                </div>

                <div class="border-t px-4 py-3">
                    <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">
                        Place Order
                    </ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record CartItem(int Id, string Name, string Variant, int Price, int Quantity);
    private record ShippingMethodInfo(string Id, string Label, string Description, int Price);

    private static readonly CartItem[] _cartItems =
    {
        new(1, "Merino Wool Crewneck", "Charcoal / M", 145, 1),
        new(2, "Canvas Low-Top Sneakers", "White / 10", 98, 1),
        new(3, "Leather Weekend Bag", "Tan / One Size", 295, 1)
    };

    private static readonly ShippingMethodInfo[] _shippingMethods =
    {
        new("standard", "Standard Shipping", "5-7 business days", 0),
        new("express", "Express Shipping", "2-3 business days", 12),
        new("overnight", "Overnight Shipping", "Next business day", 25)
    };

    private string _shippingMethod = "standard";

    private int Subtotal => _cartItems.Sum(i => i.Price * i.Quantity);
    private int Shipping => _shippingMethods.FirstOrDefault(m => m.Id == _shippingMethod)?.Price ?? 0;
    private decimal Tax => Math.Round(Subtotal * 0.08m, 2);
    private decimal Total => Subtotal + Shipping + Tax;
}
