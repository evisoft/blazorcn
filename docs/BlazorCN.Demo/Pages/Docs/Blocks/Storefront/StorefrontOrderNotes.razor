@* ============================================================
   Block: storefront-order-notes
   Title: Storefront Order Notes
   Description: Order special instructions panel with delivery notes, gift message with preview, allergen and dietary notes, and preferred delivery time window selector
   Dependencies: ButtonCn, InputCn, LabelCn, SwitchCn, LucideCheckCn, LucideClockCn, LucideGiftCn, LucideMessageSquareCn, LucideTruckCn, LucideUtensilsCn
   Source: original/blocks/storefront/storefront-order-notes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideMessageSquareCn Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Order Instructions</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">Add special instructions for your order</p>
        </div>

        @* Delivery Notes *@
        <div class="border-b px-4 py-3">
            <div class="mb-1.5 flex items-center gap-2">
                <LucideTruckCn Size="16" Class="size-3.5 text-muted-foreground" />
                <LabelCn For="order-notes-delivery" Class="text-xs font-medium text-muted-foreground">Delivery Notes</LabelCn>
            </div>
            <TextareaCn Id="order-notes-delivery" Class="min-h-[72px] resize-none"
                        Placeholder="Gate code, building access, leave at door..."
                        @bind-Value="_deliveryNotes" />
            <p class="mt-1 text-[10px] text-muted-foreground">Instructions for the delivery driver</p>
        </div>

        @* Gift Message *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideGiftCn Size="16" Class="size-3.5 text-muted-foreground" />
                    <LabelCn Class="text-xs font-medium text-muted-foreground">This is a gift</LabelCn>
                </div>
                <SwitchCn aria-label="This is a gift" @bind-Checked="_isGift" />
            </div>

            @if (_isGift)
            {
                <div class="mt-3 space-y-3">
                    <div>
                        <LabelCn For="order-notes-recipient" Class="mb-1.5 block text-[10px] font-medium text-muted-foreground">Recipient Name</LabelCn>
                        <InputCn Id="order-notes-recipient" Class="h-8 text-sm" placeholder="Who is this for?" @bind-Value="_recipientName" />
                    </div>
                    <div>
                        <div class="mb-1.5 flex items-center justify-between">
                            <LabelCn For="order-notes-gift-message" Class="text-[10px] font-medium text-muted-foreground">Gift Message</LabelCn>
                            <span class="text-[10px] tabular-nums text-muted-foreground">@_giftMessage.Length/@GiftMessageLimit</span>
                        </div>
                        <TextareaCn Id="order-notes-gift-message" Class="min-h-[60px] resize-none"
                                    maxlength="@GiftMessageLimit"
                                    Placeholder="Write a personal message..."
                                    @bind-Value="_giftMessage" />
                    </div>

                    @if (_giftMessage.Length > 0)
                    {
                        <div class="rounded-md bg-muted/50 p-3">
                            <p class="mb-1.5 text-[10px] font-medium text-muted-foreground">Gift card preview</p>
                            <div class="rounded-md border bg-background p-3">
                                @if (!string.IsNullOrEmpty(_recipientName))
                                {
                                    <p class="mb-1 text-xs font-medium">To: @_recipientName</p>
                                }
                                <p class="text-xs leading-relaxed text-muted-foreground italic">&ldquo;@_giftMessage&rdquo;</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Dietary Requirements *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center gap-2">
                <LucideUtensilsCn Size="16" Class="size-3.5 text-muted-foreground" />
                <LabelCn Class="text-xs font-medium text-muted-foreground">Dietary Requirements</LabelCn>
            </div>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var option in _dietaryOptions)
                {
                    var isSelected = _selectedDietary.Contains(option.Id);
                    <button type="button"
                            class="@Cn.Merge("rounded-md border px-2.5 py-1 text-xs transition-colors", isSelected ? "border-foreground bg-foreground text-background" : "border-border text-muted-foreground hover:border-foreground/50")"
                            @onclick="() => ToggleDietary(option.Id)">
                        @option.Label
                    </button>
                }
            </div>
            <div class="mt-3">
                <LabelCn For="order-notes-allergy" Class="mb-1.5 block text-[10px] font-medium text-muted-foreground">Additional allergy notes</LabelCn>
                <TextareaCn Id="order-notes-allergy" Class="min-h-[48px] resize-none"
                            Placeholder="Any specific allergies or restrictions..."
                            @bind-Value="_dietaryNotes" />
            </div>
            <p class="mt-1.5 text-[10px] text-muted-foreground">Selections are informational. Please confirm with the restaurant for severe allergies.</p>
        </div>

        @* Preferred Delivery Time *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center gap-2">
                <LucideClockCn Size="16" Class="size-3.5 text-muted-foreground" />
                <LabelCn Class="text-xs font-medium text-muted-foreground">Preferred Delivery Window</LabelCn>
            </div>
            <div class="grid grid-cols-2 gap-1.5">
                @foreach (var window in _timeWindows)
                {
                    <button type="button"
                            class="@Cn.Merge("flex flex-col items-start rounded-md border px-3 py-2 text-left transition-colors", !window.Available ? "cursor-not-allowed border-muted bg-muted/30 opacity-50" : _selectedTimeWindow == window.Id ? "border-foreground bg-foreground/5" : "border-border hover:border-foreground/50")"
                            disabled="@(!window.Available)"
                            @onclick="() => _selectedTimeWindow = window.Id">
                        <span class="@Cn.Merge("text-xs font-medium", _selectedTimeWindow == window.Id ? "text-foreground" : "text-muted-foreground")">@window.Label</span>
                        <span class="text-[10px] text-muted-foreground">@window.Range</span>
                        @if (!window.Available)
                        {
                            <span class="text-[10px] text-red-500">Unavailable</span>
                        }
                    </button>
                }
            </div>
        </div>

        @* Save *@
        <div class="px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    @if (HasNotes)
                    {
                        <span class="size-1.5 rounded-full bg-blue-500"></span>
                        <span class="text-xs text-muted-foreground">Instructions added to order</span>
                    }
                </div>
                <ButtonCn Class="h-7 px-3 text-xs" Variant="ButtonVariant.Outline" @onclick="HandleSave">
                    @if (_saved)
                    {
                        <LucideCheckCn Size="16" Class="mr-1 size-3" />
                        <text>Saved</text>
                    }
                    else
                    {
                        <text>Save Instructions</text>
                    }
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record TimeWindowInfo(string Id, string Label, string Range, bool Available);
    private record DietaryOptionInfo(string Id, string Label);

    private const int GiftMessageLimit = 200;

    private static readonly TimeWindowInfo[] _timeWindows =
    {
        new("morning", "Morning", "9:00 AM - 12:00 PM", true),
        new("afternoon", "Afternoon", "12:00 PM - 5:00 PM", true),
        new("evening", "Evening", "5:00 PM - 8:00 PM", true),
        new("night", "Night", "8:00 PM - 10:00 PM", false)
    };

    private static readonly DietaryOptionInfo[] _dietaryOptions =
    {
        new("gluten-free", "Gluten-free"), new("dairy-free", "Dairy-free"),
        new("nut-free", "Nut-free"), new("vegan", "Vegan"),
        new("vegetarian", "Vegetarian"), new("halal", "Halal"),
        new("kosher", "Kosher"), new("shellfish-free", "Shellfish-free")
    };

    private string _deliveryNotes = "";
    private bool _isGift;
    private string _giftMessage = "";
    private string _recipientName = "";
    private List<string> _selectedDietary = new();
    private string _dietaryNotes = "";
    private string _selectedTimeWindow = "afternoon";
    private bool _saved;

    private bool HasNotes => _deliveryNotes.Length > 0 || _isGift || _selectedDietary.Count > 0 || _dietaryNotes.Length > 0;

    private void ToggleDietary(string id)
    {
        if (!_selectedDietary.Remove(id))
            _selectedDietary.Add(id);
    }

    private async Task HandleSave()
    {
        _saved = true;
        StateHasChanged();
        await Task.Delay(2000);
        _saved = false;
    }
}
