@* ============================================================
   Block: storefront-product-variants
   Title: Storefront Product Variants
   Description: Advanced product variant selector with color swatches, size grid, material options, combined availability check, and price adjustments
   Long Description: Product lifecycle timeline with upcoming releases, pre-order dates, shipping windows, and limited edition availability
   Dependencies: ButtonCn, LabelCn, LucideCheckCn, LucideShoppingBagCn
   Source: original/blocks/storefront/storefront-product-variants.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header *@
            <div class="border-b px-4 py-3">
                <h2 class="text-sm font-medium">Relaxed Oxford Shirt</h2>
                <p class="mt-0.5 text-xs text-muted-foreground">Select your options below</p>
            </div>

            @* Color Swatches *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between">
                    <LabelCn Class="text-xs font-medium text-muted-foreground">Color</LabelCn>
                    <span class="text-xs text-muted-foreground">@SelectedColor?.Name</span>
                </div>
                <div class="mt-2 flex items-center gap-2.5">
                    @foreach (var c in _colors)
                    {
                        <button
                            class="@(Cn.Merge("relative size-7 rounded-full border-2 transition-all", _selectedColor == c.Id ? "border-foreground scale-110" : "border-transparent hover:border-muted-foreground/30"))"
                            @onclick="@(() => _selectedColor = c.Id)"
                            style="@($"background-color: {c.Hex}")"
                            title="@c.Name"
                            type="button">
                            @if (_selectedColor == c.Id)
                            {
                                <LucideCheckCn Size="12" Class="absolute inset-0 m-auto size-3"
                                    style="@($"color: {(c.Id == "stone" || c.Id == "slate" ? "#1a1a1a" : "#ffffff")}")" />
                            }
                        </button>
                    }
                </div>
                @if ((SelectedColor?.Surcharge ?? 0) > 0)
                {
                    <p class="mt-1.5 text-[10px] text-muted-foreground">
                        +$@(SelectedColor?.Surcharge) for @(SelectedColor?.Name)
                    </p>
                }
            </div>

            @* Size Grid *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between">
                    <LabelCn Class="text-xs font-medium text-muted-foreground">Size</LabelCn>
                    <button
                        Class="text-[10px] text-muted-foreground underline underline-offset-2"
                        type="button">
                        Size guide
                    </button>
                </div>
                <div class="mt-2 grid grid-cols-6 gap-1.5">
                    @foreach (var size in _sizes)
                    {
                        <button
                            class="@(Cn.Merge("flex h-9 items-center justify-center rounded-md border text-xs font-medium transition-colors", !size.Available ? "cursor-not-allowed border-muted bg-muted/30 text-muted-foreground/40 line-through" : _selectedSize == size.Id ? "border-foreground bg-foreground text-background" : "border-border hover:border-foreground/50"))"
                            disabled="@(!size.Available)"
                            @onclick="@(() => _selectedSize = size.Id)"
                            type="button">
                            @size.Label
                        </button>
                    }
                </div>
            </div>

            @* Material Options *@
            <div class="border-b px-4 py-3">
                <LabelCn Class="text-xs font-medium text-muted-foreground">Material</LabelCn>
                <div class="mt-2 space-y-1">
                    @foreach (var m in _materials)
                    {
                        <div
                            class="@(Cn.Merge("flex cursor-pointer items-center gap-3 rounded-md px-3 py-2.5 transition-colors", _selectedMaterial == m.Id ? "bg-primary/5" : "hover:bg-muted/50"))"
                            @onclick="@(() => _selectedMaterial = m.Id)"
                            role="button"
                            tabindex="0">
                            <div class="@(Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded-full border", _selectedMaterial == m.Id ? "border-primary bg-primary" : "border-muted-foreground/30"))">
                                @if (_selectedMaterial == m.Id)
                                {
                                    <span class="size-1.5 rounded-full bg-primary-foreground"></span>
                                }
                            </div>
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium">@m.Name</span>
                                <p class="text-xs text-muted-foreground">@m.Description</p>
                            </div>
                            @if (m.Surcharge > 0)
                            {
                                <span class="shrink-0 text-xs text-muted-foreground tabular-nums">
                                    +$@m.Surcharge
                                </span>
                            }
                        </div>
                    }
                </div>
            </div>

            @* Availability Check *@
            <div class="border-b px-4 py-3">
                <p class="mb-1.5 text-xs font-medium text-muted-foreground">Availability</p>
                <div class="flex items-center gap-2">
                    <span class="@(Cn.Merge("size-1.5 rounded-full", IsInStock ? (IsLowStock ? "bg-amber-500" : "bg-emerald-500") : "bg-red-500"))"></span>
                    <span class="@(Cn.Merge("text-xs", IsInStock ? (IsLowStock ? "text-amber-600 dark:text-amber-400" : "text-emerald-600 dark:text-emerald-400") : "text-red-600 dark:text-red-400"))">
                        @if (IsInStock)
                        {
                            @(IsLowStock ? $"Only {Stock} left in stock" : "In stock")
                        }
                        else
                        {
                            <text>Out of stock for this combination</text>
                        }
                    </span>
                </div>
                <p class="mt-1 text-[10px] text-muted-foreground">
                    @(SelectedColor?.Name) &middot; @(SelectedSize?.Label) &middot; @(SelectedMaterial?.Name)
                </p>
            </div>

            @* Price + Add to Cart *@
            <div class="px-4 py-3">
                <div class="mb-3 space-y-1">
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-muted-foreground">Base price</span>
                        <span class="text-xs tabular-nums">$@BasePrice</span>
                    </div>
                    @if ((SelectedColor?.Surcharge ?? 0) > 0)
                    {
                        <div class="flex items-center justify-between">
                            <span class="text-xs text-muted-foreground">@(SelectedColor?.Name) color</span>
                            <span class="text-xs tabular-nums">+$@(SelectedColor?.Surcharge)</span>
                        </div>
                    }
                    @if ((SelectedMaterial?.Surcharge ?? 0) > 0)
                    {
                        <div class="flex items-center justify-between">
                            <span class="text-xs text-muted-foreground">@(SelectedMaterial?.Name)</span>
                            <span class="text-xs tabular-nums">+$@(SelectedMaterial?.Surcharge)</span>
                        </div>
                    }
                    <div class="flex items-center justify-between border-t pt-2">
                        <span class="text-sm font-medium">Total</span>
                        <span class="text-2xl font-semibold tabular-nums">$@TotalPrice</span>
                    </div>
                </div>
                <ButtonCn Class="h-8 w-full text-xs" Disabled="@(!IsInStock)" Size="ButtonSize.Sm">
                    <LucideShoppingBagCn Size="12" Class="mr-1.5 size-3" />
                    @(IsInStock ? "Add to Cart" : "Out of Stock")
                </ButtonCn>
            </div>
        </div>
    </section>
</section>

@code {
    private const int BasePrice = 189;

    private string _selectedColor = "navy";
    private string _selectedSize = "m";
    private string _selectedMaterial = "cotton";

    private record ColorVariant(string Id, string Name, string Hex, int Surcharge);
    private record SizeVariant(string Id, string Label, bool Available);
    private record MaterialVariant(string Id, string Name, string Description, int Surcharge);
    private record AvailabilityEntry(string Color, string Size, string Material, int Stock);

    private static readonly ColorVariant[] _colors =
    [
        new("black", "Black", "#1a1a1a", 0),
        new("navy", "Navy", "#1e3a5f", 0),
        new("olive", "Olive", "#556b2f", 0),
        new("burgundy", "Burgundy", "#722f37", 10),
        new("stone", "Stone", "#d4c5a9", 10),
        new("slate", "Slate Blue", "#6a7b8b", 15)
    ];

    private static readonly SizeVariant[] _sizes =
    [
        new("xs", "XS", true),
        new("s", "S", true),
        new("m", "M", true),
        new("l", "L", true),
        new("xl", "XL", true),
        new("2xl", "2XL", false)
    ];

    private static readonly MaterialVariant[] _materials =
    [
        new("cotton", "Organic Cotton", "Soft, breathable, 100% organic", 0),
        new("linen", "Belgian Linen", "Lightweight, textured weave", 20),
        new("merino", "Merino Wool Blend", "Temperature regulating, 70/30 blend", 45)
    ];

    private static readonly AvailabilityEntry[] _availability =
    [
        new("black", "m", "cotton", 12),
        new("black", "l", "cotton", 8),
        new("black", "m", "linen", 3),
        new("navy", "s", "cotton", 15),
        new("navy", "m", "cotton", 6),
        new("navy", "l", "merino", 2),
        new("olive", "m", "cotton", 9),
        new("olive", "xl", "linen", 4),
        new("burgundy", "s", "cotton", 7),
        new("burgundy", "m", "merino", 1),
        new("stone", "m", "linen", 5),
        new("stone", "l", "cotton", 10),
        new("slate", "m", "cotton", 0),
        new("slate", "l", "merino", 3)
    ];

    private ColorVariant? SelectedColor => _colors.FirstOrDefault(c => c.Id == _selectedColor);
    private SizeVariant? SelectedSize => _sizes.FirstOrDefault(s => s.Id == _selectedSize);
    private MaterialVariant? SelectedMaterial => _materials.FirstOrDefault(m => m.Id == _selectedMaterial);

    private int TotalPrice => BasePrice + (SelectedColor?.Surcharge ?? 0) + (SelectedMaterial?.Surcharge ?? 0);

    private int Stock => _availability
        .FirstOrDefault(a => a.Color == _selectedColor && a.Size == _selectedSize && a.Material == _selectedMaterial)
        ?.Stock ?? 0;

    private bool IsInStock => Stock > 0;
    private bool IsLowStock => Stock > 0 && Stock <= 3;
}
