@* ============================================================
   Block: storefront-search-results
   Title: Storefront Search Results
   Description: Product search results block with query display, category filters, sort controls, and product listing rows
   Dependencies: ButtonCn, LucidePackageCn, LucideSearchCn, LucideStarCn
   Source: original/blocks/storefront/storefront-search-results.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideSearchCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <h1 class="text-sm font-medium">Results for &ldquo;winter jacket&rdquo;</h1>
                    <p class="text-xs text-muted-foreground">
                        @SortedProducts.Length products found
                    </p>
                </div>
            </div>
        </div>

        @* Filters + Sort *@
        <div class="flex items-center justify-between border-b px-4 py-2.5">
            <div class="flex items-center gap-1.5">
                @foreach (var cat in _categories)
                {
                    <ButtonCn Class="h-7 px-2.5 text-xs"
                              Variant="@(_activeCategory == cat ? ButtonVariant.Default : ButtonVariant.Ghost)"
                              @onclick="@(() => _activeCategory = cat)">
                        @cat
                    </ButtonCn>
                }
            </div>
            <select class="h-7 rounded-md border bg-transparent px-2 text-xs text-muted-foreground outline-none"
                    value="@_sortBy"
                    @onchange="OnSortChange">
                <option value="relevance">Relevance</option>
                <option value="price-low">Price: Low to High</option>
                <option value="price-high">Price: High to Low</option>
                <option value="rating">Highest Rated</option>
            </select>
        </div>

        @* Product Results *@
        @{ var sorted = SortedProducts; }
        @if (sorted.Length > 0)
        {
            <div>
                @for (var i = 0; i < sorted.Length; i++)
                {
                    var product = sorted[i];
                    var isLast = i == sorted.Length - 1;
                    <a class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")"
                       href="#">
                        @* Product Image *@
                        <div class="flex size-14 shrink-0 items-center justify-center rounded-md border bg-muted/50">
                            <LucidePackageCn Size="16" Class="size-5 text-muted-foreground/60" />
                        </div>

                        @* Product Info *@
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@product.Name</span>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="text-sm font-semibold tabular-nums">$@product.Price</span>
                                @if (product.OriginalPrice.HasValue)
                                {
                                    <span class="text-xs tabular-nums text-muted-foreground line-through">
                                        $@product.OriginalPrice
                                    </span>
                                }
                            </div>
                            <div class="mt-1 flex items-center gap-3">
                                <div class="flex items-center gap-1">
                                    <LucideStarCn Size="16" Class="size-3 fill-primary text-primary" />
                                    <span class="text-xs tabular-nums text-muted-foreground">
                                        @product.Rating (@product.ReviewCount)
                                    </span>
                                </div>
                                <span class="text-xs text-muted-foreground">@product.Category</span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="px-4 py-12 text-center">
                <LucideSearchCn Size="16" Class="mx-auto mb-2 size-6 text-muted-foreground/40" />
                <p class="text-sm font-medium">No results found</p>
                <p class="mt-1 text-xs text-muted-foreground">
                    Try a different category or search term
                </p>
            </div>
        }
    </div>
</section>

@code {
    private record ProductInfo(int Id, string Name, int Price, int? OriginalPrice, decimal Rating, int ReviewCount, string Category);

    private static readonly string[] _categories = { "All", "Outerwear", "Knitwear", "Accessories" };

    private static readonly ProductInfo[] _products =
    {
        new(1, "Insulated Puffer Jacket", 229, 299, 4.8m, 124, "Outerwear"),
        new(2, "Wool Blend Peacoat", 345, null, 4.6m, 89, "Outerwear"),
        new(3, "Cable Knit Turtleneck", 125, null, 4.9m, 267, "Knitwear"),
        new(4, "Down Vest", 165, 195, 4.5m, 56, "Outerwear"),
        new(5, "Merino Wool Beanie", 42, null, 4.7m, 198, "Accessories"),
        new(6, "Fleece Lined Gloves", 58, 72, 4.4m, 83, "Accessories"),
        new(7, "Chunky Ribbed Cardigan", 155, null, 4.8m, 142, "Knitwear")
    };

    private string _activeCategory = "All";
    private string _sortBy = "relevance";

    private ProductInfo[] SortedProducts
    {
        get
        {
            var filtered = _activeCategory == "All"
                ? _products
                : _products.Where(p => p.Category == _activeCategory).ToArray();

            return _sortBy switch
            {
                "price-low" => filtered.OrderBy(p => p.Price).ToArray(),
                "price-high" => filtered.OrderByDescending(p => p.Price).ToArray(),
                "rating" => filtered.OrderByDescending(p => p.Rating).ToArray(),
                _ => filtered
            };
        }
    }

    private void OnSortChange(ChangeEventArgs e) => _sortBy = e.Value?.ToString() ?? "relevance";
}
