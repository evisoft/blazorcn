@* ============================================================
   Block: storefront-inventory-alert
   Title: Storefront Inventory Alert
   Description: Storefront stock notification manager with product watchlist, availability status, and email alert toggles
   Dependencies: ButtonCn, SwitchCn, LucideBellCn, LucideBellOffCn, LucidePackageCn, LucideShoppingCartCn, LucideXCn
   Source: original/blocks/storefront/storefront-inventory-alert.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="text-sm font-medium">Stock Alerts</h2>
                <p class="text-xs text-muted-foreground">
                    @if (InStockCount > 0)
                    {
                        <span class="text-emerald-600">@InStockCount back in stock</span>
                    }
                    @if (InStockCount > 0 && WatchingCount > 0)
                    {
                        <text> · </text>
                    }
                    @if (WatchingCount > 0)
                    {
                        <span>@WatchingCount watching</span>
                    }
                </p>
            </div>
            <div class="flex items-center gap-2">
                @if (_emailAlerts)
                {
                    <LucideBellCn Size="16" Class="size-3.5 text-muted-foreground" />
                }
                else
                {
                    <LucideBellOffCn Size="16" Class="size-3.5 text-muted-foreground" />
                }
                <span class="text-xs text-muted-foreground">Email alerts</span>
                <SwitchCn @bind-Checked="_emailAlerts" />
            </div>
        </div>

        @* Product List *@
        @for (var i = 0; i < _products.Count; i++)
        {
            var product = _products[i];
            var config = StatusConfig[product.Status];
            var isLast = i == _products.Count - 1;
            <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", !isLast ? "border-b" : "")">
                <div class="flex size-12 shrink-0 items-center justify-center rounded-md bg-muted/50">
                    <LucidePackageCn Size="16" Class="size-4 text-muted-foreground/60" />
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium">@product.Name</p>
                    <p class="text-xs text-muted-foreground">@product.Variant</p>
                    <div class="mt-0.5 flex items-center gap-1.5">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", config.DotClass)"></span>
                        <span class="text-xs text-muted-foreground">
                            @config.Label
                            @if (product.StockCount.HasValue && product.Status == "low_stock")
                            {
                                <text> — @product.StockCount left</text>
                            }
                        </span>
                    </div>
                </div>
                <span class="shrink-0 text-sm tabular-nums">$@product.Price</span>
                <div class="flex shrink-0 items-center gap-1">
                    @if (product.Status == "in_stock")
                    {
                        <ButtonCn Class="h-7 gap-1 px-2 text-xs" Variant="ButtonVariant.Outline">
                            <LucideShoppingCartCn Size="16" Class="size-3" />
                            Add to Cart
                        </ButtonCn>
                    }
                    else
                    {
                        <ButtonCn Class="h-7 gap-1 px-2 text-xs"
                                  Variant="@(product.NotifyEnabled ? ButtonVariant.Outline : ButtonVariant.Ghost)"
                                  @onclick="() => ToggleNotify(product.Id)">
                            @if (product.NotifyEnabled)
                            {
                                <LucideBellCn Size="16" Class="size-3" />
                                <text>Watching</text>
                            }
                            else
                            {
                                <LucideBellOffCn Size="16" Class="size-3" />
                                <text>Notify Me</text>
                            }
                        </ButtonCn>
                    }
                    <ButtonCn Class="size-7" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" @onclick="() => RemoveProduct(product.Id)">
                        <LucideXCn Size="16" Class="size-3" />
                    </ButtonCn>
                </div>
            </div>
        }

        @if (_products.Count == 0)
        {
            <div class="px-4 py-8 text-center">
                <p class="text-xs text-muted-foreground">No products in your watchlist</p>
            </div>
        }
    </div>
</section>

@code {
    private record StatusInfo(string Label, string DotClass);
    private class WatchedProduct
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Variant { get; set; } = "";
        public int Price { get; set; }
        public string Status { get; set; } = "";
        public int? StockCount { get; set; }
        public bool NotifyEnabled { get; set; }
    }

    private static readonly Dictionary<string, StatusInfo> StatusConfig = new()
    {
        ["in_stock"] = new("Back in Stock", "bg-emerald-500"),
        ["low_stock"] = new("Low Stock", "bg-amber-500"),
        ["out_of_stock"] = new("Still Out", "bg-red-500")
    };

    private List<WatchedProduct> _products = new()
    {
        new() { Id = 1, Name = "Merino Wool Crewneck", Variant = "Charcoal / M", Price = 145, Status = "in_stock", StockCount = 24, NotifyEnabled = true },
        new() { Id = 2, Name = "Linen Button-Down Shirt", Variant = "White / L", Price = 125, Status = "low_stock", StockCount = 3, NotifyEnabled = true },
        new() { Id = 3, Name = "Canvas Low-Top Sneakers", Variant = "Off-White / 10", Price = 98, Status = "out_of_stock", StockCount = null, NotifyEnabled = true },
        new() { Id = 4, Name = "Leather Weekend Bag", Variant = "Tan / One Size", Price = 295, Status = "out_of_stock", StockCount = null, NotifyEnabled = false },
        new() { Id = 5, Name = "Cashmere Scarf", Variant = "Navy / One Size", Price = 89, Status = "low_stock", StockCount = 1, NotifyEnabled = true }
    };

    private bool _emailAlerts = true;

    private int InStockCount => _products.Count(p => p.Status == "in_stock");
    private int WatchingCount => _products.Count(p => p.Status != "in_stock");

    private void ToggleNotify(int id)
    {
        var p = _products.FirstOrDefault(x => x.Id == id);
        if (p != null) p.NotifyEnabled = !p.NotifyEnabled;
    }

    private void RemoveProduct(int id)
    {
        _products.RemoveAll(p => p.Id == id);
    }
}
