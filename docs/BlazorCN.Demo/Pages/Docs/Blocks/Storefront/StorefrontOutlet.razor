@* ============================================================
   Block: storefront-outlet
   Title: Storefront Outlet
   Description: Storefront clearance outlet section with category filters, discount sorting, and final sale warnings
   Dependencies: ButtonCn, LucideLoader2Cn, LucidePackageCn, LucideShoppingCartCn
   Source: original/blocks/storefront/storefront-outlet.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-baseline gap-2 border-b px-4 py-3">
            <h2 class="text-sm font-medium">Outlet</h2>
            <span class="text-xs text-muted-foreground">
                @FilteredProducts.Length @(FilteredProducts.Length == 1 ? "item" : "items")
            </span>
        </div>

        @* Category Filters *@
        <div class="flex gap-2 border-b px-4 py-3">
            @foreach (var cat in _categoryFilters)
            {
                <ButtonCn Variant="@(_activeCategory == cat.Id ? ButtonVariant.Default : ButtonVariant.Outline)"
                          Size="ButtonSize.Sm"
                          Class="h-7 text-xs"
                          @onclick="() => _activeCategory = cat.Id">
                    @cat.Label
                </ButtonCn>
            }
        </div>

        @* Products *@
        <div>
            @for (var i = 0; i < FilteredProducts.Length; i++)
            {
                var product = FilteredProducts[i];
                var isLast = i == FilteredProducts.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                    @* Image *@
                    <div class="flex size-12 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        <LucidePackageCn Size="16" Class="size-4 text-muted-foreground/60" />
                    </div>

                    @* Info *@
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@product.Name</span>
                            @if (product.FinalSale)
                            {
                                <span class="text-[10px] text-red-600 dark:text-red-400">Final Sale</span>
                            }
                        </div>
                        <div class="flex items-baseline gap-2">
                            <span class="text-sm font-semibold tabular-nums">$@product.ClearancePrice</span>
                            <span class="text-xs text-muted-foreground line-through tabular-nums">$@product.OriginalPrice</span>
                            <span class="text-xs text-muted-foreground">-@(product.Discount)% off</span>
                        </div>
                    </div>

                    @* Add to Cart *@
                    <ButtonCn Class="size-7 shrink-0"
                              Disabled="@(_addingToCart == product.Id)"
                              Size="ButtonSize.Icon"
                              Variant="ButtonVariant.Outline"
                              @onclick="() => HandleAddToCart(product.Id)">
                        @if (_addingToCart == product.Id)
                        {
                            <LucideLoader2Cn Size="16" Class="size-3.5 animate-spin" />
                        }
                        else
                        {
                            <LucideShoppingCartCn Size="16" Class="size-3.5" />
                        }
                    </ButtonCn>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ProductInfo(int Id, string Name, string Category, int OriginalPrice, int ClearancePrice, int Discount, bool FinalSale);
    private record CategoryFilter(string Id, string Label);

    private static readonly ProductInfo[] _products =
    {
        new(1, "Wool Overcoat", "clothing", 289, 115, 60, true),
        new(2, "Leather Chelsea Boots", "shoes", 195, 85, 56, true),
        new(3, "Cashmere Scarf", "accessories", 120, 54, 55, false),
        new(4, "Linen Blazer", "clothing", 210, 105, 50, false),
        new(5, "Canvas Sneakers", "shoes", 89, 45, 49, true),
        new(6, "Leather Belt", "accessories", 65, 35, 46, false)
    };

    private static readonly CategoryFilter[] _categoryFilters =
    {
        new("all", "All"),
        new("clothing", "Clothing"),
        new("shoes", "Shoes"),
        new("accessories", "Accessories")
    };

    private string _activeCategory = "all";
    private int? _addingToCart;

    private ProductInfo[] FilteredProducts => _products
        .Where(p => _activeCategory == "all" || p.Category == _activeCategory)
        .OrderByDescending(p => p.Discount)
        .ToArray();

    private async Task HandleAddToCart(int productId)
    {
        _addingToCart = productId;
        StateHasChanged();
        await Task.Delay(1000);
        _addingToCart = null;
    }
}
