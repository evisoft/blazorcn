@* ============================================================
   Block: storefront-product-nutrition
   Title: Storefront Product Nutrition
   Description: Nutrition facts label component with serving size, calories, macronutrient breakdown with daily value percentages, and ingredient list in a clean table layout
   Dependencies: LucideChevronRightCn, LucideInfoCn
   Source: original/blocks/storefront/storefront-product-nutrition.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">@ProductName</h2>
            <p class="text-xs text-muted-foreground">Nutrition Facts</p>
        </div>

        @* Serving Size Selector *@
        <div class="border-b px-4 py-3">
            <span class="mb-1.5 block text-xs font-medium text-muted-foreground">Serving size</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var option in _servingOptions)
                {
                    <button class="@Cn.Merge("flex h-7 items-center rounded-md border px-2.5 text-xs font-medium transition-colors", _selectedServing == option.Id ? "border-primary text-primary" : "hover:border-foreground/50")"
                            type="button"
                            @onclick="() => _selectedServing = option.Id">
                        @option.Label
                    </button>
                }
            </div>
            <p class="mt-2 text-xs text-muted-foreground">
                Base serving: @BaseServingSize &middot; Servings per container: 8
            </p>
        </div>

        @* Calories *@
        <div class="border-b px-4 py-3">
            <div class="flex items-baseline justify-between">
                <span class="text-xs font-medium text-muted-foreground">Calories</span>
                <span class="text-2xl font-semibold tabular-nums">@Calories</span>
            </div>
        </div>

        @* Nutrient Table *@
        <div class="border-b">
            <div class="flex items-center justify-between px-4 py-2 text-xs font-medium text-muted-foreground">
                <span>Nutrient</span>
                <span>% Daily Value*</span>
            </div>
            @{ var nutrients = _baseNutrients.Where(n => n.Id != "calories").ToArray(); }
            @for (var i = 0; i < nutrients.Length; i++)
            {
                var nutrient = nutrients[i];
                var isLast = i == nutrients.Length - 1;
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-1.5", !isLast ? "border-b" : "", nutrient.Indent ? "pl-8" : "")">
                    <span class="@Cn.Merge("text-sm", nutrient.Bold ? "font-medium" : "", nutrient.Indent ? "text-muted-foreground" : "")">
                        @nutrient.Label
                        <span class="text-xs text-muted-foreground"> @nutrient.Amount</span>
                    </span>
                    @if (!string.IsNullOrEmpty(nutrient.DailyValue))
                    {
                        <span class="text-xs font-medium tabular-nums">@nutrient.DailyValue</span>
                    }
                </div>
            }
        </div>

        @* Daily Value Note *@
        <div class="border-b px-4 py-2">
            <p class="text-xs text-muted-foreground">
                * Percent Daily Values are based on a 2,000 calorie diet. Your daily values may be
                higher or lower depending on your calorie needs.
            </p>
        </div>

        @* Ingredients *@
        <div class="@(_showIngredients ? "border-b" : "")">
            <button class="flex w-full items-center gap-2 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                    type="button"
                    @onclick="() => _showIngredients = !_showIngredients">
                <span class="flex-1 text-sm font-medium">Ingredients</span>
                <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", _showIngredients ? "rotate-90" : "")" />
            </button>
            @if (_showIngredients)
            {
                <div class="px-4 pb-3">
                    <p class="text-sm leading-relaxed text-muted-foreground">@IngredientsText</p>
                </div>
            }
        </div>

        @* Allergen Notice *@
        <div class="flex items-start gap-2 px-4 py-3">
            <LucideInfoCn Size="16" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
            <p class="text-xs text-muted-foreground">
                <span class="font-medium">Contains:</span> Wheat, Tree Nuts (coconut). Manufactured
                in a facility that also processes peanuts, milk, and soy.
            </p>
        </div>
    </div>
</section>

@code {
    private record NutrientInfo(string Id, string Label, string Amount, string? DailyValue, bool Indent = false, bool Bold = false);
    private record ServingOption(string Id, string Label, int Multiplier);

    private const string ProductName = "Organic Dark Chocolate Granola";
    private const string BaseServingSize = "55g (about 2/3 cup)";
    private const string IngredientsText = "Whole grain oats, cane sugar, dark chocolate chips (cacao mass, cane sugar, cocoa butter, vanilla extract), expeller-pressed canola oil, brown rice syrup, honey, oat flour, vanilla extract, sea salt, mixed tocopherols (for freshness).";

    private static readonly ServingOption[] _servingOptions =
    {
        new("1", "1 serving (55g)", 1),
        new("2", "2 servings (110g)", 2),
        new("container", "Entire container (440g)", 8)
    };

    private static readonly NutrientInfo[] _baseNutrients =
    {
        new("calories", "Calories", "260", null, Bold: true),
        new("total-fat", "Total Fat", "9g", "12%", Bold: true),
        new("sat-fat", "Saturated Fat", "3.5g", "18%", Indent: true),
        new("trans-fat", "Trans Fat", "0g", null, Indent: true),
        new("cholesterol", "Cholesterol", "0mg", "0%", Bold: true),
        new("sodium", "Sodium", "95mg", "4%", Bold: true),
        new("total-carb", "Total Carbohydrate", "40g", "15%", Bold: true),
        new("dietary-fiber", "Dietary Fiber", "4g", "14%", Indent: true),
        new("total-sugars", "Total Sugars", "14g", null, Indent: true),
        new("added-sugars", "Incl. Added Sugars", "10g", "20%", Indent: true),
        new("protein", "Protein", "6g", "10%", Bold: true),
        new("vitamin-d", "Vitamin D", "0mcg", "0%"),
        new("calcium", "Calcium", "40mg", "4%"),
        new("iron", "Iron", "2.5mg", "15%"),
        new("potassium", "Potassium", "180mg", "4%")
    };

    private string _selectedServing = "1";
    private bool _showIngredients;

    private int Calories
    {
        get
        {
            var option = _servingOptions.FirstOrDefault(s => s.Id == _selectedServing) ?? _servingOptions[0];
            return 260 * option.Multiplier;
        }
    }
}
