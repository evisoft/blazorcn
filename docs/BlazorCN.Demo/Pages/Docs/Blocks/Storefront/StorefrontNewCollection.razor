@* ============================================================
   Block: storefront-new-collection
   Title: Storefront New Collection
   Description: Storefront new collection launch with featured products and newsletter signup
   Long Description: Launch new collections with this minimal storefront block. Features a clean header with collection stats, a curated list of featured products with add-to-cart interactions, and an integrated newsletter signup for early access. The flat layout lets your products speak for themselves without visual distractions. Ideal for fashion brands, seasonal launches, or curated product drops.
   Dependencies: ButtonCn, InputCn, LucideCheckCn, LucideLoaderCn, LucidePackageCn
   Source: original/blocks/storefront/storefront-new-collection.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
    <section class="mx-auto w-full max-w-4xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header *@
            <div class="flex items-center justify-between border-b px-4 py-3">
                <div>
                    <h2 class="text-sm font-medium">New Collection</h2>
                    <p class="text-xs text-muted-foreground">Winter 2024</p>
                </div>
                <ButtonCn Class="h-7 px-2 text-xs" Variant="ButtonVariant.Outline">
                    Shop Collection
                </ButtonCn>
            </div>

            @* Stats Row *@
            <div class="grid grid-cols-3 gap-px border-b bg-border">
                @foreach (var stat in _stats)
                {
                    <div class="bg-card px-4 py-3 text-center">
                        <p class="text-2xl font-semibold tabular-nums">@stat.Value</p>
                        <p class="text-xs text-muted-foreground">@stat.Label</p>
                    </div>
                }
            </div>

            @* Featured Products *@
            <div class="border-b px-4 py-3">
                <p class="text-xs font-medium text-muted-foreground">Featured</p>
            </div>

            @for (var i = 0; i < _products.Length; i++)
            {
                var product = _products[i];
                var isLast = i == _products.Length - 1;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-3", !isLast ? "border-b" : ""))">
                    <div class="flex size-12 shrink-0 items-center justify-center rounded-md border bg-muted/50">
                        <LucidePackageCn Size="16" Class="size-4 text-muted-foreground/60" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="text-xs text-muted-foreground">@product.Category</p>
                        <p class="text-sm font-medium">@product.Name</p>
                    </div>
                    <p class="shrink-0 text-sm tabular-nums">$@product.Price</p>
                    <ButtonCn
                        Class="h-7 px-2 text-xs"
                        Disabled="@(_addingToCart == product.Id)"
                        @onclick="@(() => HandleAddToCart(product.Id))"
                        Variant="ButtonVariant.Outline">
                        @if (_addingToCart == product.Id)
                        {
                            <LucideLoaderCn Size="14" Class="size-3.5 animate-spin" />
                        }
                        else
                        {
                            <text>Add</text>
                        }
                    </ButtonCn>
                </div>
            }

            @* Newsletter *@
            <div class="border-t px-4 py-3">
                @if (_subscribed)
                {
                    <div class="flex items-center gap-2">
                        <LucideCheckCn Size="14" Class="size-3.5 text-emerald-500" />
                        <p class="text-xs text-muted-foreground">
                            You@@("'")re on the list. We'll notify you about new arrivals.
                        </p>
                    </div>
                }
                else
                {
                    <form class="flex items-center gap-2" @onsubmit="HandleSubscribe" @onsubmit:preventDefault>
                        <div class="min-w-0 flex-1">
                            <p class="mb-1.5 text-xs font-medium text-muted-foreground">
                                Get early access to new collections
                            </p>
                            <div class="flex gap-2">
                                <InputCn
                                    Class="h-7 border-0 bg-muted/50 text-xs shadow-none focus-visible:ring-0"
                                    Disabled="@_subscribing"
                                    Placeholder="Enter your email"
                                    Type="email"
                                    @bind-Value="_email" />
                                <ButtonCn
                                    Class="h-7 px-2 text-xs"
                                    Disabled="@_subscribing"
                                    type="submit"
                                    Variant="ButtonVariant.Outline">
                                    @if (_subscribing)
                                    {
                                        <LucideLoaderCn Size="14" Class="size-3.5 animate-spin" />
                                    }
                                    else
                                    {
                                        <text>Subscribe</text>
                                    }
                                </ButtonCn>
                            </div>
                        </div>
                    </form>
                }
            </div>
        </div>
    </section>
</section>

@code {
    private int? _addingToCart;
    private string _email = "";
    private bool _subscribed;
    private bool _subscribing;

    private record Stat(string Label, string Value);
    private record Product(int Id, string Name, int Price, string Category);

    private static readonly Stat[] _stats =
    [
        new("New Styles", "48"),
        new("Categories", "12"),
        new("Sustainable", "100%")
    ];

    private static readonly Product[] _products =
    [
        new(1, "Cashmere Blend Coat", 425, "Outerwear"),
        new(2, "Silk Midi Dress", 289, "Dresses"),
        new(3, "Tailored Wool Blazer", 345, "Blazers"),
        new(4, "Leather Ankle Boots", 265, "Footwear")
    ];

    private async Task HandleAddToCart(int productId)
    {
        _addingToCart = productId;
        await Task.Delay(1000);
        _addingToCart = null;
    }

    private async Task HandleSubscribe()
    {
        if (string.IsNullOrEmpty(_email)) return;
        _subscribing = true;
        await Task.Delay(1000);
        _subscribing = false;
        _subscribed = true;
    }
}
