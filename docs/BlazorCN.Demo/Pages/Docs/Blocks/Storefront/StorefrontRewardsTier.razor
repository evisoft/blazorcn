@* ============================================================
   Block: storefront-rewards-tier
   Title: Storefront Rewards Tier
   Description: Loyalty tier status card with points balance, tier progress bar, benefits list, and points expiry notice for e-commerce rewards programs
   Dependencies: ButtonCn, LucideChevronRightCn, LucideGiftCn, LucideShieldCheckCn, LucideStarCn, LucideTruckCn, ProgressCn
   Source: original/blocks/storefront/storefront-rewards-tier.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Rewards Status</h2>
                    <p class="text-xs text-muted-foreground">Member since @MemberSince</p>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="@Cn.Merge("size-1.5 rounded-full", CurrentTier.DotColor)"></span>
                    <span class="@Cn.Merge("text-sm font-medium", CurrentTier.Color)">
                        @MemberCurrentTier
                    </span>
                </div>
            </div>
        </div>

        @* Points Balance *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-2xl font-semibold tabular-nums">
                        @MemberPoints.ToString("N0")
                    </p>
                    <p class="text-xs text-muted-foreground">available points</p>
                </div>
                <ButtonCn Class="h-7 text-xs" Variant="ButtonVariant.Outline">
                    Redeem
                </ButtonCn>
            </div>
        </div>

        @* Tier Progress *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-xs text-muted-foreground">
                    @(NextTier != null ? $"Progress to {NextTier.Name}" : "Highest tier reached")
                </span>
                @if (NextTier != null)
                {
                    <span class="text-xs tabular-nums text-muted-foreground">
                        @PointsToNext.ToString("N0") pts away
                    </span>
                }
            </div>
            <ProgressCn Class="h-1.5" Value="@ProgressPercent" />
            <div class="mt-2 flex items-center justify-between">
                @for (var i = 0; i < _tiers.Length; i++)
                {
                    var tier = _tiers[i];
                    <span class="@Cn.Merge("text-[10px]", i <= CurrentTierIndex ? "text-foreground" : "text-muted-foreground")">
                        @tier.Name
                    </span>
                }
            </div>
        </div>

        @* Benefits *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">Your Benefits</span>
                <ButtonCn Class="h-6 gap-1 px-2 text-xs text-muted-foreground" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="@(() => _expanded = !_expanded)">
                    @(_expanded ? "Show less" : "Show all")
                    <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-3 transition-transform duration-200", _expanded ? "rotate-90" : "")" />
                </ButtonCn>
            </div>
            <div class="space-y-0">
                @{ var visibleBenefits = _expanded ? _benefits : _benefits.Take(2).ToArray(); }
                @for (var i = 0; i < visibleBenefits.Length; i++)
                {
                    var benefit = visibleBenefits[i];
                    var isLast = i == visibleBenefits.Length - 1;
                    <div class="@Cn.Merge("flex items-start gap-3 py-2", !isLast ? "border-b" : "")">
                        @switch (benefit.Icon)
                        {
                            case "star":
                                <LucideStarCn Size="16" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                                break;
                            case "truck":
                                <LucideTruckCn Size="16" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                                break;
                            case "gift":
                                <LucideGiftCn Size="16" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                                break;
                            case "shield":
                                <LucideShieldCheckCn Size="16" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                                break;
                        }
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium">@benefit.Title</p>
                            <p class="text-xs text-muted-foreground">@benefit.Description</p>
                        </div>
                        @if (benefit.Unlocked)
                        {
                            <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                        }
                        else
                        {
                            <span class="shrink-0 text-[10px] text-muted-foreground">
                                @NextTier?.Name
                            </span>
                        }
                    </div>
                }
            </div>
        </div>

        @* Points Expiry Notice *@
        <div class="px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-medium">Points Expiring Soon</p>
                        <p class="text-xs text-muted-foreground">
                            @PointsExpiring points expire on @ExpiryDate
                        </p>
                    </div>
                    <ButtonCn Class="h-6 px-2 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                        Use Now
                    </ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record TierInfo(string Name, int MinPoints, string Color, string DotColor);
    private record BenefitInfo(string Id, string Title, string Description, string Icon, bool Unlocked);

    private const string MemberCurrentTier = "Gold";
    private const int MemberPoints = 4820;
    private const int PointsExpiring = 350;
    private const string ExpiryDate = "Jun 30, 2026";
    private const string MemberSince = "Jan 2024";

    private static readonly TierInfo[] _tiers =
    {
        new("Bronze", 0, "text-muted-foreground", "bg-muted-foreground"),
        new("Silver", 1000, "text-muted-foreground", "bg-muted-foreground"),
        new("Gold", 3000, "text-amber-600 dark:text-amber-400", "bg-amber-500"),
        new("Platinum", 7500, "text-foreground", "bg-foreground")
    };

    private static readonly BenefitInfo[] _benefits =
    {
        new("b1", "2x Points on All Purchases", "Earn double points on every dollar spent in-store and online", "star", true),
        new("b2", "Free Express Shipping", "Complimentary 2-day shipping on all orders, no minimum", "truck", true),
        new("b3", "Birthday Bonus", "500 bonus points credited during your birthday month", "gift", true),
        new("b4", "Early Access to Sales", "Shop new collections and sales 48 hours before everyone else", "shield", false)
    };

    private bool _expanded;

    private int CurrentTierIndex => Array.FindIndex(_tiers, t => t.Name == MemberCurrentTier);
    private TierInfo CurrentTier => _tiers[CurrentTierIndex];
    private TierInfo? NextTier => CurrentTierIndex < _tiers.Length - 1 ? _tiers[CurrentTierIndex + 1] : null;

    private int ProgressPercent => NextTier != null
        ? (int)Math.Round((double)(MemberPoints - CurrentTier.MinPoints) / (NextTier.MinPoints - CurrentTier.MinPoints) * 100)
        : 100;

    private int PointsToNext => NextTier != null ? NextTier.MinPoints - MemberPoints : 0;
}
