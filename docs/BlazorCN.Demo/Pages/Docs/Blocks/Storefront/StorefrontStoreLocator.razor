@* ============================================================
   Block: storefront-store-locator
   Title: Storefront Store Locator
   Description: Store locator with product availability search, stock status indicators, and reserve-for-pickup functionality
   Long Description: Help customers find products near them with this location-focused storefront component. Features a product display, store search by city or zip, and a flat list of nearby stores with distance, stock status indicated by tiny colored dots, hours, and reserve-for-pickup capability. The clean interface bridges online and offline shopping.
   Dependencies: ButtonCn, InputCn, LucideCheckCn, LucideLoaderCn, LucideNavigationCn, LucidePackageCn, LucideSearchCn
   Source: original/blocks/storefront/storefront-store-locator.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="border-b px-4 py-3">
                <p class="text-sm font-medium">Find in Store</p>
                <p class="text-xs text-muted-foreground">Check availability at a location near you</p>
            </div>

            <div class="flex items-center gap-3 border-b px-4 py-3">
                <div class="flex size-12 shrink-0 items-center justify-center rounded-md border bg-muted/50">
                    <LucidePackageCn Size="16" Class="size-4 text-muted-foreground/60" />
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium">@FeaturedProductName</p>
                    <p class="text-xs text-muted-foreground">
                        @FeaturedProductColor &middot; Size @FeaturedProductSize
                    </p>
                </div>
                <span class="shrink-0 text-sm font-medium tabular-nums">
                    $@FeaturedProductPrice
                </span>
            </div>

            <div class="border-b px-4 py-3">
                <form class="flex gap-2" @onsubmit="HandleSearch" @onsubmit:preventDefault>
                    <div class="relative flex-1">
                        <LucideSearchCn Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                        <InputCn aria-label="Search by city, state, or zip code"
                            Class="h-8 pl-8 text-xs"
                            Placeholder="City, state, or zip code"
                            @bind-Value="_searchQuery" />
                    </div>
                    <ButtonCn
                        Class="h-8 px-3 text-xs"
                        Disabled="@(_searching || string.IsNullOrEmpty(_searchQuery))"
                        type="submit"
                        Variant="ButtonVariant.Outline">
                        @if (_searching)
                        {
                            <LucideLoaderCn Size="12" Class="size-3 animate-spin" />
                        }
                        else
                        {
                            <text>Search</text>
                        }
                    </ButtonCn>
                    <ButtonCn
                        Class="h-8 gap-1 px-2 text-xs"
                        Disabled="@_searching"
                        @onclick="HandleUseLocation"
                        type="button"
                        aria-label="Use my location"
                        Variant="ButtonVariant.Ghost">
                        <LucideNavigationCn Size="12" Class="size-3" />
                    </ButtonCn>
                </form>
            </div>

            @if (_hasSearched)
            {
                @if (_reserved)
                {
                    <div>
                        <div class="border-b px-4 py-3">
                            <div class="flex items-center gap-2">
                                <LucideCheckCn Size="16" Class="size-4 text-emerald-500" />
                                <span class="text-sm font-medium">Reserved Successfully</span>
                            </div>
                            <p class="mt-1 text-xs text-muted-foreground">
                                Your item is waiting at @(SelectedStoreData?.Name)
                            </p>
                        </div>
                        <div class="border-b px-4 py-3">
                            <div class="rounded-md bg-muted/50 p-3">
                                <p class="text-xs font-medium">@(SelectedStoreData?.Name)</p>
                                <p class="text-xs text-muted-foreground">
                                    @(SelectedStoreData?.Address), @(SelectedStoreData?.City)
                                </p>
                                <p class="mt-2 text-xs text-muted-foreground">
                                    Pick up within 48 hours. Bring your confirmation email.
                                </p>
                            </div>
                        </div>
                        <div class="px-4 py-3">
                            <ButtonCn Class="h-7 text-xs" @onclick="@(() => _reserved = false)" Variant="ButtonVariant.Ghost">
                                Find Another Store
                            </ButtonCn>
                        </div>
                    </div>
                }
                else
                {
                    <div>
                        <div class="border-b px-4 py-2">
                            <div class="flex items-center justify-between">
                                <span class="text-xs text-muted-foreground">
                                    @_stores.Length stores near @_searchQuery
                                </span>
                                <span class="text-xs text-muted-foreground">
                                    @_stores.Count(s => s.InStock) with stock
                                </span>
                            </div>
                        </div>

                        @for (var i = 0; i < _stores.Length; i++)
                        {
                            var store = _stores[i];
                            var isLast = i == _stores.Length - 1;
                            <div class="@(Cn.Merge("px-4 py-3", !isLast ? "border-b" : "", !store.InStock ? "opacity-50" : ""))">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-2">
                                            <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", store.InStock ? (store.StockLevel == "low" ? "bg-amber-500" : "bg-emerald-500") : "bg-red-500"))"></span>
                                            <p class="text-sm font-medium">@store.Name</p>
                                            <span class="text-xs text-muted-foreground">@store.Distance</span>
                                        </div>
                                        <p class="mt-0.5 text-xs text-muted-foreground">
                                            @store.Address, @store.City
                                        </p>
                                        <div class="mt-1 flex items-center gap-3 text-xs text-muted-foreground">
                                            <span>@store.Hours</span>
                                            <span>@store.Phone</span>
                                            <span>
                                                @(store.InStock
                                                    ? store.StockLevel == "low"
                                                        ? "Low stock"
                                                        : "In stock"
                                                    : "Out of stock")
                                            </span>
                                        </div>
                                    </div>
                                    <ButtonCn
                                        Class="h-7 shrink-0 px-3 text-xs"
                                        Disabled="@(!store.InStock || _reserving)"
                                        @onclick="@(() => HandleReserve(store.Id))"
                                        Variant="ButtonVariant.Outline">
                                        @if (_reserving && _selectedStore == store.Id)
                                        {
                                            <LucideLoaderCn Size="12" Class="size-3 animate-spin" />
                                        }
                                        else
                                        {
                                            <text>Reserve</text>
                                        }
                                    </ButtonCn>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </section>
</section>

@code {
    private string _searchQuery = "";
    private bool _searching;
    private bool _hasSearched;
    private int? _selectedStore;
    private bool _reserving;
    private bool _reserved;

    private const string FeaturedProductName = "Cashmere Crewneck Sweater";
    private const int FeaturedProductPrice = 195;
    private const string FeaturedProductColor = "Navy";
    private const string FeaturedProductSize = "M";

    private record StoreLocation(int Id, string Name, string Address, string City,
        string Distance, string Phone, string Hours, bool InStock, string? StockLevel = null);

    private static readonly StoreLocation[] _stores =
    [
        new(1, "Downtown Flagship", "123 Main Street", "New York, NY 10001", "0.3 mi", "(212) 555-0123", "10am - 9pm", true, "high"),
        new(2, "SoHo", "456 Broadway", "New York, NY 10012", "0.8 mi", "(212) 555-0456", "10am - 8pm", true, "low"),
        new(3, "Upper East Side", "789 Madison Avenue", "New York, NY 10065", "2.1 mi", "(212) 555-0789", "10am - 7pm", false),
        new(4, "Brooklyn", "321 Atlantic Avenue", "Brooklyn, NY 11201", "3.5 mi", "(718) 555-0321", "11am - 8pm", true, "high")
    ];

    private StoreLocation? SelectedStoreData => _stores.FirstOrDefault(s => s.Id == _selectedStore);

    private async Task HandleSearch()
    {
        if (string.IsNullOrEmpty(_searchQuery)) return;
        _searching = true;
        await Task.Delay(800);
        _searching = false;
        _hasSearched = true;
    }

    private async Task HandleUseLocation()
    {
        _searching = true;
        _searchQuery = "New York, NY";
        await Task.Delay(1000);
        _searching = false;
        _hasSearched = true;
    }

    private async Task HandleReserve(int storeId)
    {
        _selectedStore = storeId;
        _reserving = true;
        await Task.Delay(1500);
        _reserving = false;
        _reserved = true;
    }
}
