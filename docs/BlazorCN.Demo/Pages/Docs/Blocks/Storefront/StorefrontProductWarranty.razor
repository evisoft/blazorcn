@* ============================================================
   Block: storefront-product-warranty
   Title: Storefront Product Warranty
   Description: Storefront protection plan selector with tiered warranty options, coverage details, included and excluded items checklist, and add-to-order action
   Dependencies: ButtonCn, LucideShieldCheckCn, LucideXCn
   Source: original/blocks/storefront/storefront-product-warranty.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideShieldCheckCn Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Protection Plans</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Wireless Noise-Cancelling Headphones
            </p>
        </div>

        @* Plan options *@
        <div class="border-b">
            @for (var i = 0; i < _plans.Length; i++)
            {
                var plan = _plans[i];
                var isLast = i == _plans.Length - 1;
                <button class="@Cn.Merge("flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")"
                        type="button"
                        @onclick="@(() => _selected = plan.Id)">
                    <span class="@Cn.Merge("mt-0.5 flex size-4 shrink-0 items-center justify-center rounded-full border", _selected == plan.Id ? "border-primary bg-primary" : "border-muted-foreground/30")">
                        @if (_selected == plan.Id)
                        {
                            <span class="size-1.5 rounded-full bg-primary-foreground"></span>
                        }
                    </span>
                    <div class="min-w-0 flex-1">
                        <span class="text-sm font-medium">@plan.Name</span>
                        <div class="mt-1 flex flex-wrap gap-x-3 gap-y-0.5">
                            @foreach (var h in plan.Highlights)
                            {
                                <span class="flex items-center gap-1 text-xs text-muted-foreground">
                                    <span class="size-1 rounded-full bg-emerald-500"></span>
                                    @h
                                </span>
                            }
                        </div>
                    </div>
                    <span class="shrink-0 text-sm font-medium tabular-nums">$@plan.Price</span>
                </button>
            }

            @* No protection option *@
            <button class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                    type="button"
                    @onclick="ClearSelection">
                <span class="@Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded-full border", _selected == null ? "border-primary bg-primary" : "border-muted-foreground/30")">
                    @if (_selected == null)
                    {
                        <span class="size-1.5 rounded-full bg-primary-foreground"></span>
                    }
                </span>
                <span class="text-sm font-medium">No Protection</span>
            </button>
        </div>

        @* What's covered *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">What&apos;s Covered</p>
            <div class="space-y-1.5">
                @foreach (var item in _covered)
                {
                    <div class="flex items-center gap-2">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="text-sm">@item</span>
                    </div>
                }
            </div>
        </div>

        @* What's not covered *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Not Covered</p>
            <div class="space-y-1.5">
                @foreach (var item in _notCovered)
                {
                    <div class="flex items-center gap-2">
                        <LucideXCn Size="16" Class="size-3 shrink-0 text-muted-foreground/60" />
                        <span class="text-sm text-muted-foreground">@item</span>
                    </div>
                }
            </div>
        </div>

        @* Add to order *@
        <div class="px-4 py-3">
            <ButtonCn Class="h-8 w-full text-xs" Disabled="@(_selected == null)" Size="ButtonSize.Sm">
                @if (_selected == null)
                {
                    <text>Skip Protection</text>
                }
                else
                {
                    <text>Add Protection &mdash; $@(SelectedPlan?.Price)</text>
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record WarrantyPlan(string Id, string Name, int Price, string[] Highlights);

    private static readonly WarrantyPlan[] _plans =
    {
        new("1year", "1 Year Protection", 29, new[] { "Manufacturing defects", "Free repairs" }),
        new("2year", "2 Year Protection", 49, new[] { "Accidental damage", "Manufacturing defects", "Free repairs" }),
        new("3year", "3 Year Protection", 69, new[] { "Accidental damage", "Manufacturing defects", "Free repairs", "Free replacement" })
    };

    private static readonly string[] _covered =
    {
        "Accidental drops and spills",
        "Manufacturing defects",
        "Battery degradation",
        "Mechanical and electrical failures",
        "Free repairs or replacement",
        "No deductibles"
    };

    private static readonly string[] _notCovered =
    {
        "Cosmetic damage (scratches, dents)",
        "Loss or theft",
        "Intentional damage",
        "Unauthorized modifications"
    };

    private string? _selected = "2year";

    private WarrantyPlan? SelectedPlan => _plans.FirstOrDefault(p => p.Id == _selected);

    private void ClearSelection() => _selected = null;
}
