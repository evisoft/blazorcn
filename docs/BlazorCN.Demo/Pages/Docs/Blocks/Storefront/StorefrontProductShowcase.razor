@* ============================================================
   Block: storefront-product-showcase
   Title: Storefront Product Showcase
   Description: Product showcase with tabbed categories and product grid for browsing best sellers, new arrivals, and sale items
   Dependencies: ButtonCn, LucideLoader2Cn, LucidePackageCn, LucideShoppingCartCn, TabsCn, TabsContentCn, TabsListCn, TabsTriggerCn
   Source: original/blocks/storefront/storefront-product-showcase.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Products</p>
            <p class="text-xs text-muted-foreground">Browse our curated collections</p>
        </div>

        <TabsCn DefaultValue="bestsellers" Class="w-full">
            <div class="border-b px-4 py-2">
                <TabsListCn>
                    <TabsTriggerCn Value="bestsellers">Best Sellers</TabsTriggerCn>
                    <TabsTriggerCn Value="newArrivals">New Arrivals</TabsTriggerCn>
                    <TabsTriggerCn Value="onSale">On Sale</TabsTriggerCn>
                </TabsListCn>
            </div>

            <TabsContentCn Value="bestsellers" Class="mt-0">
                <div class="grid grid-cols-2 gap-px bg-border">
                    @foreach (var product in _bestsellers)
                    {
                        @RenderProduct(product)
                    }
                </div>
            </TabsContentCn>
            <TabsContentCn Value="newArrivals" Class="mt-0">
                <div class="grid grid-cols-2 gap-px bg-border">
                    @foreach (var product in _newArrivals)
                    {
                        @RenderProduct(product)
                    }
                </div>
            </TabsContentCn>
            <TabsContentCn Value="onSale" Class="mt-0">
                <div class="grid grid-cols-2 gap-px bg-border">
                    @foreach (var product in _onSale)
                    {
                        @RenderProduct(product)
                    }
                </div>
            </TabsContentCn>
        </TabsCn>
    </div>
</section>

@code {
    private record ProductInfo(int Id, string Name, int Price, int? OriginalPrice, decimal Rating, int Reviews, string? Label);

    private static readonly ProductInfo[] _bestsellers =
    {
        new(1, "Classic White Sneakers", 129, null, 4.9m, 2847, "Best Seller"),
        new(2, "Leather Crossbody Bag", 195, null, 4.8m, 1923, null),
        new(3, "Minimalist Watch", 245, null, 4.7m, 1456, null),
        new(4, "Cashmere Scarf", 89, null, 4.8m, 892, null)
    };

    private static readonly ProductInfo[] _newArrivals =
    {
        new(5, "Wool Blend Overcoat", 385, null, 4.6m, 124, "New"),
        new(6, "Ribbed Knit Sweater", 145, null, 4.5m, 89, "New"),
        new(7, "Suede Chelsea Boots", 225, null, 4.7m, 156, "New"),
        new(8, "Structured Tote Bag", 265, null, 4.4m, 67, "New")
    };

    private static readonly ProductInfo[] _onSale =
    {
        new(9, "Denim Jacket", 89, 145, 4.6m, 734, "39% off"),
        new(10, "Canvas Backpack", 65, 95, 4.5m, 512, "32% off"),
        new(11, "Linen Shirt", 49, 85, 4.4m, 423, "42% off"),
        new(12, "Aviator Sunglasses", 79, 125, 4.7m, 891, "37% off")
    };

    private int? _addingToCart;

    private async Task HandleAddToCart(int productId)
    {
        _addingToCart = productId;
        StateHasChanged();
        await Task.Delay(1000);
        _addingToCart = null;
    }

    private RenderFragment RenderProduct(ProductInfo product) => __builder =>
    {
        <div class="flex flex-col bg-card p-4">
            <div class="mb-3 flex aspect-square items-center justify-center rounded-md bg-muted/50">
                <LucidePackageCn Size="16" Class="size-8 text-muted-foreground/60" />
            </div>
            <div class="flex min-w-0 flex-1 flex-col">
                <div class="mb-1 flex items-center gap-2">
                    <span class="truncate text-sm font-medium">@product.Name</span>
                    @if (!string.IsNullOrEmpty(product.Label))
                    {
                        <span class="shrink-0 rounded bg-primary/10 px-1.5 py-0.5 font-mono text-[10px] font-medium text-primary">
                            @product.Label
                        </span>
                    }
                </div>
                <div class="mb-1 flex items-baseline gap-2">
                    <span class="text-sm font-medium tabular-nums">$@product.Price</span>
                    @if (product.OriginalPrice.HasValue)
                    {
                        <span class="text-xs tabular-nums text-muted-foreground line-through">
                            $@product.OriginalPrice
                        </span>
                    }
                </div>
                <span class="mb-3 text-xs text-muted-foreground">
                    @product.Rating (@product.Reviews.ToString("N0"))
                </span>
                <ButtonCn Class="mt-auto h-7 gap-1 px-2 text-xs" Disabled="@(_addingToCart == product.Id)" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" @onclick="() => HandleAddToCart(product.Id)">
                    @if (_addingToCart == product.Id)
                    {
                        <LucideLoaderCircleCn Size="16" Class="size-3 animate-spin" />
                    }
                    else
                    {
                        <LucideShoppingCartCn Size="16" Class="size-3" />
                        <text>Add to Cart</text>
                    }
                </ButtonCn>
            </div>
        </div>
    };
}
