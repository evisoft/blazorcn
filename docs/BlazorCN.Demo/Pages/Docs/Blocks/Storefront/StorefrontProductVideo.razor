@* ============================================================
   Block: storefront-product-video
   Title: Storefront Product Video
   Description: Product video showcase with categorized video list, duration labels, view counts, and tab navigation for overview, how-to, and review content
   Dependencies: ButtonCn, LucideEyeCn, LucidePlayCn
   Source: original/blocks/storefront/storefront-product-video.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">@ProductName</h2>
            <p class="text-xs text-muted-foreground">
                @_videos.Length videos &middot; @TotalViews total views
            </p>
        </div>

        @* Featured Video *@
        <div class="border-b">
            <div class="@Cn.Merge("relative flex aspect-video items-center justify-center", Featured.Color)">
                <div class="flex flex-col items-center gap-2">
                    <div class="flex size-12 items-center justify-center rounded-full bg-white/10 backdrop-blur-sm">
                        <LucidePlayCn Size="16" Class="size-5 text-white" />
                    </div>
                    <span class="font-mono text-xs text-white/60 tabular-nums">
                        @Featured.Duration
                    </span>
                </div>
            </div>
            <div class="px-4 py-3">
                <p class="text-sm font-medium">@Featured.Title</p>
                <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
                    @Featured.Description
                </p>
                <div class="mt-2 flex items-center gap-1.5 text-xs text-muted-foreground">
                    <LucideEyeCn Size="16" Class="size-3" />
                    <span class="tabular-nums">@Featured.Views views</span>
                </div>
            </div>
        </div>

        @* Category Tabs *@
        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            @foreach (var cat in _categories)
            {
                var count = _videos.Count(v => v.Category == cat);
                <button type="button"
                        class="@Cn.Merge("flex items-center gap-1.5 text-xs font-medium transition-colors", _activeCategory == cat ? "text-foreground" : "text-muted-foreground hover:text-foreground")"
                        @onclick="@(() => SelectCategory(cat))">
                    @GetCategoryLabel(cat)
                    <span class="rounded bg-muted px-1 py-0.5 font-mono text-[10px] tabular-nums">
                        @count
                    </span>
                </button>
            }
        </div>

        @* Video List *@
        <div>
            @{ var filtered = FilteredVideos; }
            @for (var i = 0; i < filtered.Length; i++)
            {
                var video = filtered[i];
                var isSelected = _selectedVideo == video.Id;
                var isLast = i == filtered.Length - 1;
                <div class="@(!isLast ? "border-b" : "")">
                    <button type="button"
                            class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", isSelected ? "bg-muted/30" : "")"
                            @onclick="@(() => _selectedVideo = video.Id)">
                        @* Thumbnail Placeholder *@
                        <div class="@Cn.Merge("relative flex h-12 w-20 shrink-0 items-center justify-center rounded", video.Color)">
                            <LucidePlayCn Size="16" Class="size-3.5 text-white/70" />
                        </div>

                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@video.Title</span>
                            <div class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                                <span class="font-mono tabular-nums">@video.Duration</span>
                                <span>&middot;</span>
                                <span class="tabular-nums">@video.Views views</span>
                            </div>
                        </div>

                        @if (isSelected)
                        {
                            <span class="size-1.5 shrink-0 rounded-full bg-foreground"></span>
                        }
                    </button>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <ButtonCn Class="h-7 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                <a href="#">View all product videos</a>
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record VideoInfo(string Id, string Title, string Description, string Duration, string Views, string Category, string Color);

    private const string ProductName = "ProChef Stand Mixer \u2014 6Qt";
    private const string TotalViews = "139K";

    private static readonly string[] _categories = { "overview", "howto", "reviews" };

    private static readonly VideoInfo[] _videos =
    {
        new("v1", "ProChef Stand Mixer Overview", "Discover the 10-speed planetary mixing system, tilt-head design, and all-metal gear construction that makes this mixer a kitchen essential.", "2:34", "12.4K", "overview", "bg-zinc-800"),
        new("v2", "Unboxing & First Setup", "What comes in the box, how to attach the mixing bowl, and initial calibration for the beater clearance.", "4:12", "8.7K", "overview", "bg-zinc-700"),
        new("v3", "Making Sourdough Bread", "Step-by-step guide using the dough hook attachment. Covers mixing, kneading, and proofing for a perfect loaf.", "8:45", "24.1K", "howto", "bg-zinc-900"),
        new("v4", "Whipping Meringue to Stiff Peaks", "Wire whisk technique for Swiss meringue. Speed settings, timing, and visual cues for perfect peaks.", "5:18", "15.3K", "howto", "bg-zinc-800"),
        new("v5", "Pasta Making with Roller Attachment", "How to use the optional pasta roller and cutter attachments to make fresh fettuccine from scratch.", "11:02", "19.8K", "howto", "bg-zinc-700"),
        new("v6", "Home Baker Review \u2014 6 Months In", "Long-term review covering daily use, cleaning routine, noise levels, and comparison with previous mixer.", "6:33", "31.2K", "reviews", "bg-zinc-900"),
        new("v7", "Pro Pastry Chef Tests the ProChef", "Professional evaluation of motor power, bowl capacity, and attachment versatility across pastry recipes.", "9:15", "47.6K", "reviews", "bg-zinc-800")
    };

    private string _activeCategory = "overview";
    private string _selectedVideo = "v1";

    private VideoInfo[] FilteredVideos => _videos.Where(v => v.Category == _activeCategory).ToArray();

    private VideoInfo Featured => _videos.FirstOrDefault(v => v.Id == _selectedVideo) ?? FilteredVideos[0];

    private void SelectCategory(string cat)
    {
        _activeCategory = cat;
        var first = _videos.FirstOrDefault(v => v.Category == cat);
        if (first != null) _selectedVideo = first.Id;
    }

    private static string GetCategoryLabel(string cat) => cat switch
    {
        "overview" => "Overview",
        "howto" => "How-to",
        "reviews" => "Reviews",
        _ => cat
    };
}
