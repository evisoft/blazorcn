@* ============================================================
   Block: storefront-saved-carts
   Title: Storefront Saved Carts
   Description: Multiple saved and named shopping carts with item counts, total values, last modified dates, and actions to load, merge, share, or delete carts
   Dependencies: ButtonCn, LucideChevronRightCn, LucideCopyCn, LucideLinkCn, LucideLoader2Cn, LucidePackageCn, LucideShoppingBagCn, LucideTrash2Cn
   Source: original/blocks/storefront/storefront-saved-carts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideShoppingBagCn Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Saved Carts (@_carts.Count)</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">Manage your saved shopping lists</p>
        </div>

        @* Carts *@
        @if (_carts.Count == 0)
        {
            <div class="px-4 py-12 text-center">
                <LucideShoppingBagCn Size="16" Class="mx-auto mb-2 size-5 text-muted-foreground/40" />
                <p class="text-sm font-medium">No saved carts</p>
                <p class="mt-1 text-xs text-muted-foreground">Save your current cart for later</p>
            </div>
        }
        else
        {
            @for (var i = 0; i < _carts.Count; i++)
            {
                var cart = _carts[i];
                var isExpanded = _expandedId == cart.Id;
                var total = GetCartTotal(cart);
                var itemCount = GetCartItemCount(cart);
                var isLast = i == _carts.Count - 1;

                <div>
                    @* Cart Row *@
                    <button class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", (!isLast || isExpanded) ? "border-b" : "")"
                            type="button"
                            @onclick="@(() => _expandedId = isExpanded ? null : cart.Id)">
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@cart.Name</span>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                @itemCount @(itemCount == 1 ? "item" : "items") &middot; Modified @cart.LastModified
                            </p>
                        </div>
                        <span class="shrink-0 text-sm font-medium tabular-nums">$@total</span>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @* Expanded Content *@
                    @if (isExpanded)
                    {
                        <div class="@(!isLast ? "border-b" : "")">
                            @* Cart Items *@
                            <div class="bg-muted/30">
                                @for (var j = 0; j < cart.Items.Length; j++)
                                {
                                    var item = cart.Items[j];
                                    var isLastItem = j == cart.Items.Length - 1;
                                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 pl-8", !isLastItem ? "border-b border-border/50" : "")">
                                        <div class="flex size-8 shrink-0 items-center justify-center rounded bg-muted/50">
                                            <LucidePackageCn Size="16" Class="size-3 text-muted-foreground/60" />
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <p class="text-sm">@item.Name</p>
                                            <p class="text-xs text-muted-foreground">@item.Variant</p>
                                        </div>
                                        <span class="shrink-0 text-xs tabular-nums text-muted-foreground">
                                            x@item.Quantity
                                        </span>
                                        <span class="shrink-0 text-sm tabular-nums">
                                            $@(item.Price * item.Quantity)
                                        </span>
                                    </div>
                                }
                            </div>

                            @* Cart Actions *@
                            <div class="flex items-center justify-end gap-1 border-t border-border/50 bg-muted/30 px-4 py-2">
                                <ButtonCn Class="h-7 gap-1 px-2 text-xs"
                                          Disabled="@(_loadingAction != null)"
                                          Variant="ButtonVariant.Ghost"
                                          @onclick="@(() => HandleAction("load", cart.Id))">
                                    @if (_loadingAction == $"load-{cart.Id}")
                                    {
                                        <LucideLoaderCircleCn Size="16" Class="size-3 animate-spin" />
                                    }
                                    else
                                    {
                                        <LucideShoppingBagCn Size="16" Class="size-3" />
                                    }
                                    Load
                                </ButtonCn>
                                <ButtonCn Class="h-7 gap-1 px-2 text-xs"
                                          Disabled="@(_loadingAction != null)"
                                          Variant="ButtonVariant.Ghost"
                                          @onclick="@(() => HandleAction("merge", cart.Id))">
                                    @if (_loadingAction == $"merge-{cart.Id}")
                                    {
                                        <LucideLoaderCircleCn Size="16" Class="size-3 animate-spin" />
                                    }
                                    else
                                    {
                                        <LucideCopyCn Size="16" Class="size-3" />
                                    }
                                    Merge
                                </ButtonCn>
                                <ButtonCn Class="h-7 gap-1 px-2 text-xs"
                                          Disabled="@(_loadingAction != null)"
                                          Variant="ButtonVariant.Ghost"
                                          @onclick="@(() => HandleAction("share", cart.Id))">
                                    @if (_loadingAction == $"share-{cart.Id}")
                                    {
                                        <LucideLoaderCircleCn Size="16" Class="size-3 animate-spin" />
                                    }
                                    else
                                    {
                                        <LucideLinkCn Size="16" Class="size-3" />
                                    }
                                    Share
                                </ButtonCn>
                                <ButtonCn Class="h-7 gap-1 px-2 text-xs text-muted-foreground hover:text-red-600 dark:hover:text-red-400"
                                          Disabled="@(_loadingAction != null)"
                                          Variant="ButtonVariant.Ghost"
                                          @onclick="@(() => HandleAction("delete", cart.Id))">
                                    @if (_loadingAction == $"delete-{cart.Id}")
                                    {
                                        <LucideLoaderCircleCn Size="16" Class="size-3 animate-spin" />
                                    }
                                    else
                                    {
                                        <LucideTrash2Cn Size="16" Class="size-3" />
                                    }
                                    Delete
                                </ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</section>

@code {
    private record CartItem(int Id, string Name, string Variant, int Price, int Quantity);
    private record SavedCart(int Id, string Name, string LastModified, CartItem[] Items);

    private static readonly SavedCart[] _initialCarts =
    {
        new(1, "Weekly Groceries", "Mar 15, 2026", new CartItem[]
        {
            new(1, "Organic Cold Brew Coffee", "12 oz / Medium Roast", 14, 2),
            new(2, "Whole Grain Granola", "16 oz / Maple Pecan", 9, 1),
            new(3, "Greek Yogurt", "32 oz / Plain", 6, 3)
        }),
        new(2, "Office Supplies", "Mar 12, 2026", new CartItem[]
        {
            new(4, "Mechanical Pencil Set", "0.5mm / Pack of 3", 18, 2),
            new(5, "Lined Notebook", "A5 / 200 pages", 12, 4)
        }),
        new(3, "Birthday Gift Ideas", "Mar 8, 2026", new CartItem[]
        {
            new(6, "Cashmere Scarf", "Navy / One Size", 175, 1),
            new(7, "Leather Weekend Bag", "Tan / One Size", 295, 1),
            new(8, "Silk Blend Scarf", "Burgundy / One Size", 78, 1)
        }),
        new(4, "Home Refresh", "Feb 28, 2026", new CartItem[]
        {
            new(9, "Linen Throw Pillow", "20x20 / Sand", 45, 2)
        })
    };

    private List<SavedCart> _carts = new(_initialCarts);
    private int? _expandedId;
    private string? _loadingAction;

    private static int GetCartTotal(SavedCart cart) => cart.Items.Sum(i => i.Price * i.Quantity);
    private static int GetCartItemCount(SavedCart cart) => cart.Items.Sum(i => i.Quantity);

    private async Task HandleAction(string action, int cartId)
    {
        _loadingAction = $"{action}-{cartId}";
        StateHasChanged();
        await Task.Delay(1000);
        _loadingAction = null;

        if (action == "delete")
        {
            _carts.RemoveAll(c => c.Id == cartId);
            if (_expandedId == cartId) _expandedId = null;
        }
    }
}
