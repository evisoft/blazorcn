@* ============================================================
   Block: account-payment-methods
   Title: Account Payment Methods
   Description: Payment methods dashboard with credit cards, bank accounts, digital wallets, default payment selection, and secure card management for billing
   Long Description: Payment methods management
   Dependencies: BadgeCn, ButtonCn, LucideBuilding2Cn, LucideCircleCheckCn, LucideCreditCardCn, LucideEllipsisCn, LucidePlusCn, LucideTriangleAlertCn, LucideWalletCn
   Source: original/blocks/account/account-payment-methods.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="mb-1 flex items-center gap-2">
                <h2 class="text-sm font-medium">Payment Methods</h2>
            </div>
            <p class="text-xs text-muted-foreground">
                Manage your cards, bank accounts, and digital wallets
            </p>
        </div>

        @if (_paymentMethods.Any(m => m.IsExpiring))
        {
            <div class="border-b bg-muted/50 px-4 py-3">
                <div class="flex items-center gap-3">
                    <LucideTriangleAlertCn Size="16" Class="shrink-0 text-amber-600" />
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium text-amber-900">Card expiring soon</p>
                        <p class="text-xs text-amber-700">
                            Your Mastercard ending in 8888 expires in March 2025. Update it to avoid service interruption.
                        </p>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                        Update
                    </ButtonCn>
                </div>
            </div>
        }

        <div class="border-b">
            <div class="border-b bg-muted/50 px-4 py-2">
                <p class="text-xs font-medium text-muted-foreground">Credit & Debit Cards</p>
            </div>
            @foreach (var method in _paymentMethods.Where(m => m.Type == "card"))
            {
                <div class="flex items-center gap-3 border-b px-4 py-3 last:border-0">
                    <LucideCreditCardCn Size="16" Class="shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <div class="mb-0.5 flex items-center gap-1.5">
                            <p class="text-sm font-medium">@method.Brand &bull;&bull;&bull;&bull; @method.Last4</p>
                            @if (method.IsDefault)
                            {
                                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                            }
                            @if (method.IsExpiring)
                            {
                                <span class="size-1.5 rounded-full bg-amber-500"></span>
                            }
                        </div>
                        <p class="text-xs text-muted-foreground">Expires @method.Expiry</p>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                        <LucideEllipsisCn Size="16" />
                    </ButtonCn>
                </div>
            }
        </div>

        @{ var otherMethods = _paymentMethods.Where(m => m.Type != "card").ToArray(); }
        @if (otherMethods.Length > 0)
        {
            <div class="border-b">
                <div class="border-b bg-muted/50 px-4 py-2">
                    <p class="text-xs font-medium text-muted-foreground">Other Payment Methods</p>
                </div>
                @foreach (var method in otherMethods)
                {
                    <div class="flex items-center gap-3 border-b px-4 py-3 last:border-0">
                        @if (method.Type == "bank")
                        {
                            <LucideBuilding2Cn Size="16" Class="shrink-0 text-muted-foreground" />
                        }
                        else
                        {
                            <LucideWalletCn Size="16" Class="shrink-0 text-muted-foreground" />
                        }
                        <div class="min-w-0 flex-1">
                            <div class="mb-0.5 flex items-center gap-1.5">
                                <p class="text-sm font-medium">
                                    @(method.Type == "bank" ? $"@method.BankName \u2022\u2022\u2022\u2022 @method.Last4" : method.Brand)
                                </p>
                                @if (method.IsDefault)
                                {
                                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                }
                            </div>
                            <p class="text-xs text-muted-foreground">
                                @(method.Type == "bank" ? "Bank Account (ACH)" : method.WalletEmail)
                            </p>
                        </div>
                        <LucideCircleCheckCn Size="16" Class="shrink-0 text-muted-foreground" />
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                            <LucideEllipsisCn Size="16" />
                        </ButtonCn>
                    </div>
                }
            </div>
        }

        <div class="px-4 py-3">
            <ButtonCn Class="w-full gap-2" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                <LucidePlusCn Size="16" />
                Add Payment Method
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record PaymentMethod(string Id, string Type, string Brand, string Last4, string? Expiry = null, bool IsDefault = false, bool IsExpiring = false, string? BankName = null, string? WalletEmail = null);

    private static readonly PaymentMethod[] _paymentMethods =
    [
        new("1", "card", "Visa", "4242", "12/26", true),
        new("2", "card", "Mastercard", "8888", "03/25", false, true),
        new("3", "bank", "Bank Account", "6789", BankName: "Chase"),
    ];
}
