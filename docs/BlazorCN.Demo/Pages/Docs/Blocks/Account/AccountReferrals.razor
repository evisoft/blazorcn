@* ============================================================
   Block: account-referrals
   Title: Account Referrals
   Description: Referral program dashboard with unique referral links, reward tracking, referral statistics, social sharing, and earnings visualization
   Dependencies: ButtonCn, InputCn, ProgressCn
   Source: original/blocks/account/account-referrals.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <LucideGiftCn Class="h-5 w-5 text-muted-foreground" Size="20" />
                    <div>
                        <h2 class="text-sm font-medium">Referral Program</h2>
                        <p class="text-xs text-muted-foreground">Invite friends and earn rewards together</p>
                    </div>
                </div>
                <span class="text-xs text-muted-foreground">$@_totalEarnings earned</span>
            </div>
        </div>

        <div class="flex items-center gap-6 border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideUsersCn Class="h-3.5 w-3.5 text-muted-foreground" Size="14" />
                <span class="text-xs text-muted-foreground">Referrals</span>
                <span class="text-sm font-semibold tabular-nums">@_totalReferrals</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-xs text-muted-foreground">Converted</span>
                <span class="text-sm font-semibold tabular-nums">@_convertedReferrals</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-xs text-muted-foreground">Earned</span>
                <span class="text-sm font-semibold tabular-nums">$@_totalEarnings</span>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Your Referral Link</p>
            <div class="flex gap-2">
                <InputCn Class="flex-1 font-mono text-xs" ReadOnly Value="@_referralLink" />
                <ButtonCn Class="gap-1.5" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" OnClick="HandleCopyLink">
                    @if (_copied)
                    {
                        <LucideCheckCn Class="h-3.5 w-3.5" Size="14" />
                        <text>Copied</text>
                    }
                    else
                    {
                        <LucideCopyCn Class="h-3.5 w-3.5" Size="14" />
                        <text>Copy</text>
                    }
                </ButtonCn>
            </div>
            <div class="mt-2 flex items-center gap-2">
                <span class="text-xs text-muted-foreground">Share:</span>
                <ButtonCn Class="h-7 gap-1.5 px-2 text-xs" Variant="ButtonVariant.Ghost">
                    <LucideMailCn Class="h-3.5 w-3.5" Size="14" />
                    Email
                </ButtonCn>
                <ButtonCn Class="h-7 gap-1.5 px-2 text-xs" Variant="ButtonVariant.Ghost">
                    <LucideShare2Cn Class="h-3.5 w-3.5" Size="14" />
                    Twitter
                </ButtonCn>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">Next Milestone: $50 Bonus</span>
                <span class="text-xs text-muted-foreground">@_activeReferrals / @_nextMilestone referrals</span>
            </div>
            <ProgressCn Class="h-1.5" Value="@_progressToMilestone" />
            <p class="mt-1.5 text-xs text-muted-foreground">@(_nextMilestone - _activeReferrals) more referrals to reach your next milestone</p>
        </div>

        <div>
            <div class="px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">Your Referrals</span>
            </div>
            @for (var i = 0; i < _referrals.Length; i++)
            {
                var referral = _referrals[i];
                var statusConfig = GetStatusConfig(referral.Status);
                var initials = string.Join("", referral.Name.Split(' ').Select(n => n[0]));
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", i < _referrals.Length - 1 ? "border-b" : "")">
                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-muted">
                        <span class="text-xs font-medium text-muted-foreground">@initials</span>
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@referral.Name</span>
                            <span class="@Cn.Merge("size-1.5 rounded-full", statusConfig.Dot)"></span>
                            <span class="text-xs text-muted-foreground">@statusConfig.Label</span>
                        </div>
                        <p class="text-xs text-muted-foreground">@referral.JoinedAt</p>
                    </div>
                    <div class="shrink-0 text-right">
                        <p class="text-sm font-medium tabular-nums">$@referral.Reward</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Referral(string Id, string Name, string Email, string Status, int Reward, string JoinedAt);

    private const string _referralCode = "EMMA2024";
    private const int _totalReferrals = 12;
    private const int _activeReferrals = 8;
    private const int _convertedReferrals = 6;
    private const int _totalEarnings = 180;
    private const int _nextMilestone = 15;

    private static readonly string _referralLink = $"https://app.example.com/ref/{_referralCode}";
    private static readonly double _progressToMilestone = (double)_activeReferrals / _nextMilestone * 100;

    private bool _copied;

    private static readonly Referral[] _referrals =
    [
        new("1", "John Smith", "john@example.com", "converted", 20, "2 weeks ago"),
        new("2", "Sarah Johnson", "sarah@example.com", "active", 15, "1 month ago"),
        new("3", "Mike Chen", "mike@example.com", "pending", 10, "3 days ago"),
    ];

    private static (string Dot, string Label) GetStatusConfig(string status) => status switch
    {
        "converted" => ("bg-emerald-500", "Converted"),
        "active" => ("bg-blue-500", "Active"),
        "pending" => ("bg-amber-500", "Pending"),
        _ => ("bg-muted-foreground", "Unknown"),
    };

    private void HandleCopyLink()
    {
        _copied = true;
        _ = Task.Delay(2000).ContinueWith(_ =>
        {
            _copied = false;
            InvokeAsync(StateHasChanged);
        });
    }
}
