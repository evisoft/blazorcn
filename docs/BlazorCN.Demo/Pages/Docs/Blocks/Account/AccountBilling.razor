@* ============================================================
   Block: account-billing
   Title: Account Billing
   Description: Subscription and billing management with current plan details, payment methods, billing history, invoice downloads, and plan upgrade/downgrade options
   Long Description: Subscription and billing management
   Dependencies: BadgeCn, ButtonCn, ProgressCn, TableCn, TableBodyCn, TableCellCn, TableHeadCn, TableHeaderCn, TableRowCn, LucideCalendarCn, LucideCircleCheckCn, LucideCreditCardCn, LucideDownloadCn, LucideHardDriveCn, LucideReceiptCn, LucideSparklesCn, LucideTrendingUpCn, LucideUsersCn, LucideZapCn
   Source: original/blocks/account/account-billing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <LucideReceiptCn Size="20" Class="text-muted-foreground" />
                <div>
                    <h2 class="text-sm font-medium">Billing & Subscription</h2>
                    <p class="text-xs text-muted-foreground">
                        Manage your subscription, payment methods, and invoices
                    </p>
                </div>
            </div>
        </div>

        <div class="p-4 space-y-6">
            <div class="space-y-3">
                <span class="text-xs font-medium text-muted-foreground">CURRENT PLAN</span>
                <div class="rounded-md border bg-muted/50 p-4">
                    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                        <div class="flex-1">
                            <div class="flex items-center gap-2 mb-2">
                                <LucideSparklesCn Size="16" Class="text-muted-foreground" />
                                <div>
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">Professional Plan</span>
                                        <BadgeCn Variant="BadgeVariant.Secondary">
                                            <LucideCircleCheckCn Size="12" Class="mr-1" />
                                            Active
                                        </BadgeCn>
                                    </div>
                                    <p class="text-xs text-muted-foreground">
                                        Billed monthly &bull; Renews February 1, 2024
                                    </p>
                                </div>
                            </div>

                            <p class="text-2xl font-semibold tabular-nums mb-3">
                                $29.99
                                <span class="text-xs font-normal text-muted-foreground">/ month</span>
                            </p>

                            <div class="grid grid-cols-2 gap-2">
                                <div class="flex items-center gap-2 text-xs">
                                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                    <span>Unlimited projects</span>
                                </div>
                                <div class="flex items-center gap-2 text-xs">
                                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                    <span>50GB storage</span>
                                </div>
                                <div class="flex items-center gap-2 text-xs">
                                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                    <span>Priority support</span>
                                </div>
                            </div>
                        </div>

                        <div class="flex flex-col gap-2 w-full sm:w-auto">
                            <ButtonCn Size="ButtonSize.Sm" Class="gap-2">
                                <LucideTrendingUpCn Size="16" />
                                Upgrade Plan
                            </ButtonCn>
                            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                                Cancel Subscription
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            </div>

            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-muted-foreground">CURRENT USAGE</span>
                    <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                        <LucideCalendarCn Size="12" />
                        <span>Resets in 18 days</span>
                    </div>
                </div>
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
                    <div class="rounded-md border p-3">
                        <div class="flex items-center gap-2 mb-2">
                            <LucideHardDriveCn Size="16" Class="text-muted-foreground" />
                            <span class="text-xs font-medium">Storage</span>
                        </div>
                        <p class="text-2xl font-semibold tabular-nums">32.4 GB</p>
                        <p class="text-xs text-muted-foreground mt-1">of 50 GB</p>
                        <ProgressCn Class="mt-2 h-1.5" Value="65" />
                    </div>

                    <div class="rounded-md border p-3">
                        <div class="flex items-center gap-2 mb-2">
                            <LucideZapCn Size="16" Class="text-muted-foreground" />
                            <span class="text-xs font-medium">API Calls</span>
                        </div>
                        <p class="text-2xl font-semibold tabular-nums">847K</p>
                        <p class="text-xs text-muted-foreground mt-1">of 1M</p>
                        <ProgressCn Class="mt-2 h-1.5" Value="85" />
                    </div>

                    <div class="rounded-md border p-3">
                        <div class="flex items-center gap-2 mb-2">
                            <LucideUsersCn Size="16" Class="text-muted-foreground" />
                            <span class="text-xs font-medium">Team Members</span>
                        </div>
                        <p class="text-2xl font-semibold tabular-nums">8</p>
                        <p class="text-xs text-muted-foreground mt-1">of 10</p>
                        <ProgressCn Class="mt-2 h-1.5" Value="80" />
                    </div>
                </div>
            </div>

            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-muted-foreground">PAYMENT METHOD</span>
                    <ButtonCn Size="ButtonSize.Sm" Class="gap-2 h-7" Variant="ButtonVariant.Ghost">
                        <LucideCreditCardCn Size="14" />
                        Update
                    </ButtonCn>
                </div>

                <div class="flex items-center gap-3 rounded-md border p-3">
                    <LucideCreditCardCn Size="20" Class="text-muted-foreground" />
                    <div class="flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">Visa ending in 4242</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px]">
                                Default
                            </BadgeCn>
                        </div>
                        <p class="text-xs text-muted-foreground">Expires 12/2025</p>
                    </div>
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                </div>
            </div>

            <div class="space-y-3">
                <span class="text-xs font-medium text-muted-foreground">BILLING HISTORY</span>

                <div class="overflow-hidden rounded-md border">
                    <TableCn>
                        <TableHeaderCn>
                            <TableRowCn Class="bg-muted/50">
                                <TableHeadCn Class="text-xs font-medium">Invoice</TableHeadCn>
                                <TableHeadCn Class="text-xs font-medium">Date</TableHeadCn>
                                <TableHeadCn Class="text-xs font-medium">Amount</TableHeadCn>
                                <TableHeadCn Class="text-xs font-medium">Status</TableHeadCn>
                                <TableHeadCn Class="text-xs font-medium text-right">Download</TableHeadCn>
                            </TableRowCn>
                        </TableHeaderCn>
                        <TableBodyCn>
                            @foreach (var invoice in _invoices)
                            {
                                <TableRowCn Class="group">
                                    <TableCellCn Class="font-mono text-xs">@invoice.Id</TableCellCn>
                                    <TableCellCn Class="text-xs text-muted-foreground">@invoice.Date</TableCellCn>
                                    <TableCellCn Class="text-sm font-semibold tabular-nums">$@invoice.Amount.ToString("F2")</TableCellCn>
                                    <TableCellCn>
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px]">
                                            @invoice.StatusLabel
                                        </BadgeCn>
                                    </TableCellCn>
                                    <TableCellCn Class="text-right">
                                        <ButtonCn Size="ButtonSize.Icon" Class="h-7 w-7 opacity-50 group-hover:opacity-100 transition-opacity" Variant="ButtonVariant.Ghost">
                                            <LucideDownloadCn Size="14" />
                                        </ButtonCn>
                                    </TableCellCn>
                                </TableRowCn>
                            }
                        </TableBodyCn>
                    </TableCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Invoice(string Id, string Date, decimal Amount, string Status, string StatusLabel);

    private static readonly Invoice[] _invoices =
    [
        new("INV-2024-001", "Jan 1, 2024", 29.99m, "paid", "Paid"),
        new("INV-2023-012", "Dec 1, 2023", 29.99m, "paid", "Paid"),
        new("INV-2023-011", "Nov 1, 2023", 29.99m, "paid", "Paid"),
    ];
}
