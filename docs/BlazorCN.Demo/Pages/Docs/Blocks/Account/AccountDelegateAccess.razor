@* ============================================================
   Block: account-delegate-access
   Title: Account Delegate Access
   Description: Temporary account delegation with specific permissions, expiry dates, delegate management, and permission checkboxes
   Long Description: Delegate access management
   Dependencies: BadgeCn, ButtonCn, CheckboxCn, InputCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, LucideCalendarCn, LucideLoaderCircleCn, LucidePlusCn, LucideTrash2Cn, LucideUserCheckCn
   Source: original/blocks/account/account-delegate-access.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <LucideUserCheckCn Size="20" Class="text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Delegate Access</h2>
                        <p class="text-xs text-muted-foreground">
                            Grant temporary access to manage your account
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Class="gap-1.5 text-xs">
                    <LucidePlusCn Size="14" />
                    Add Delegate
                </ButtonCn>
            </div>
        </div>

        <div>
            <div class="px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">ACTIVE DELEGATES</span>
            </div>
            @foreach (var del in _delegates)
            {
                <div class="flex items-center gap-3 border-t px-4 py-3 transition-colors hover:bg-muted/50">
                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-muted/50 text-xs font-medium">
                        @GetInitials(del.Name)
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="mb-1 flex items-center gap-2 flex-wrap">
                            <span class="text-sm font-medium">@del.Name</span>
                            @foreach (var perm in del.Permissions)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px]">
                                    @GetPermissionLabel(perm)
                                </BadgeCn>
                            }
                        </div>
                        <div class="flex items-center gap-3 text-xs text-muted-foreground">
                            <span>@del.Email</span>
                            <div class="flex items-center gap-1">
                                <LucideCalendarCn Size="12" />
                                <span>Expires @del.Expiry</span>
                            </div>
                        </div>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 gap-1.5 px-2 text-xs text-destructive hover:text-destructive">
                        <LucideTrash2Cn Size="14" />
                        Revoke
                    </ButtonCn>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Delegate(string Id, string Name, string Email, string[] Permissions, string Expiry);

    private static readonly Delegate[] _delegates =
    [
        new("1", "Lisa Chen", "lisa@@example.com", ["billing", "reports"], "Apr 15, 2026"),
        new("2", "Mark Thompson", "mark@@example.com", ["team"], "Mar 30, 2026"),
    ];

    private static string GetPermissionLabel(string permId) => permId switch
    {
        "billing" => "View billing",
        "team" => "Manage team",
        "reports" => "Access reports",
        _ => permId,
    };

    private static string GetInitials(string name) =>
        string.Join("", name.Split(' ').Select(n => n[0])).ToUpper()[..Math.Min(2, name.Split(' ').Length)];
}
