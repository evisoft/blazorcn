@* ============================================================
   Block: account-security
   Title: AccountSecurity
   Description: A security score card for React and Next.js with checklist items, fix action buttons, score ring indicator, and recent security events built with shadcn/ui and Tailwind CSS
   Source: original/blocks/account/account-security.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Score Header *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-4">
                @* Score Ring *@
                <div class="relative shrink-0">
                    <svg width="88" height="88" viewBox="0 0 88 88" role="img" aria-label="@($"Security score: {_score} out of 100")">
                        <title>@($"Security score: {_score}")</title>
                        <circle cx="44" cy="44" r="38" fill="none" stroke-width="6" class="stroke-muted" />
                        <circle cx="44" cy="44" r="38" fill="none" stroke-width="6" stroke-linecap="round"
                                class="@_scoreStrokeColor"
                                stroke-dasharray="@_circumferenceStr"
                                stroke-dashoffset="@_strokeOffsetStr"
                                transform="rotate(-90 44 44)" />
                    </svg>
                    <div class="absolute inset-0 flex flex-col items-center justify-center">
                        <span class="@($"text-lg font-semibold tabular-nums {_scoreColor}")">@_score</span>
                        <span class="text-[10px] text-muted-foreground">/ 100</span>
                    </div>
                </div>

                @* Score Summary *@
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <h2 class="text-sm font-medium">Security Score</h2>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@_scoreBadgeClass">@_scoreLabel</BadgeCn>
                    </div>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_completedCount of @_totalCount security measures completed
                    </p>
                    @if (_completedCount < _totalCount)
                    {
                        <p class="mt-1 text-xs text-muted-foreground">
                            Complete <span class="font-medium text-foreground">@(_totalCount - _completedCount) more @(_totalCount - _completedCount == 1 ? "item" : "items")</span> to reach full protection
                        </p>
                    }
                </div>
            </div>
        </div>

        @* Security Checklist *@
        <div class="divide-y">
            @foreach (var check in _checks)
            {
                var isFixing = _fixingId == check.Id;
                <div class="flex items-start gap-3 px-4 py-3">
                    @* Status icon *@
                    <div class="mt-0.5 shrink-0">
                        @if (check.Completed)
                        {
                            <LucideIconCn Name="check-circle-2" Size="16" Class="h-4 w-4 text-emerald-500" />
                        }
                        else
                        {
                            <LucideIconCn Name="alert-triangle" Size="16" Class="h-4 w-4 text-amber-500" />
                        }
                    </div>

                    @* Content *@
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="@check.IconName" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                            <span class="text-sm font-medium">@check.Label</span>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">@check.Description</p>
                    </div>

                    @* Fix button or completed indicator *@
                    <div class="shrink-0">
                        @if (check.Completed)
                        {
                            <span class="text-[10px] text-emerald-600">Done</span>
                        }
                        else
                        {
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs"
                                      Disabled="@isFixing" OnClick="@(async () => await HandleFix(check.Id))">
                                @if (isFixing)
                                {
                                    <LucideIconCn Name="loader-2" Size="12" Class="h-3 w-3 animate-spin" />
                                }
                                else
                                {
                                    @check.FixAction
                                    <LucideIconCn Name="chevron-right" Size="12" Class="h-3 w-3" />
                                }
                            </ButtonCn>
                        }
                    </div>
                </div>
            }
        </div>

        @* Recent Security Events *@
        <div class="border-t px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                    <LucideIconCn Name="shield" Size="12" Class="h-3 w-3" />
                    Recent Security Events
                </span>
                @if (_recentEvents.Length > 2)
                {
                    <button type="button"
                            class="text-[10px] text-muted-foreground underline-offset-2 hover:underline"
                            @onclick="@(() => _showAllEvents = !_showAllEvents)">
                        @(_showAllEvents ? "Show less" : $"View all {_recentEvents.Length}")
                    </button>
                }
            </div>

            @foreach (var evt in _visibleEvents)
            {
                <div class="flex items-start gap-2 py-1.5">
                    <span class="@($"mt-1.5 size-1.5 shrink-0 rounded-full {_severityStyles[evt.Severity]}")"></span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-baseline justify-between gap-2">
                            <span class="text-xs font-medium">@evt.Action</span>
                            <span class="shrink-0 text-[10px] text-muted-foreground">@evt.Timestamp</span>
                        </div>
                        <p class="text-[10px] text-muted-foreground">@evt.Detail</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private class SecurityCheck
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string Description { get; set; } = "";
        public bool Completed { get; set; }
        public string FixAction { get; set; } = "";
        public string IconName { get; set; } = "";
        public string Category { get; set; } = "";
    }

    private class SecurityEvent
    {
        public string Id { get; set; } = "";
        public string Action { get; set; } = "";
        public string Detail { get; set; } = "";
        public string Timestamp { get; set; } = "";
        public string Severity { get; set; } = "";
    }

    private List<SecurityCheck> _checks =
    [
        new() { Id = "2fa", Label = "Two-factor authentication", Description = "Add a second layer of protection with an authenticator app or security key", Completed = true, FixAction = "Configure 2FA", IconName = "smartphone", Category = "authentication" },
        new() { Id = "strong-password", Label = "Strong password", Description = "Use at least 12 characters with uppercase, lowercase, numbers, and symbols", Completed = true, FixAction = "Update password", IconName = "lock", Category = "authentication" },
        new() { Id = "passkey", Label = "Passkey enrolled", Description = "Sign in faster and more securely with a device-bound passkey", Completed = false, FixAction = "Add passkey", IconName = "fingerprint", Category = "authentication" },
        new() { Id = "recovery", Label = "Recovery options configured", Description = "Backup email and phone number set for account recovery", Completed = true, FixAction = "Set recovery options", IconName = "key-round", Category = "recovery" },
        new() { Id = "login-review", Label = "Recent logins reviewed", Description = "Check for unrecognized devices or locations in the last 30 days", Completed = false, FixAction = "Review logins", IconName = "monitor", Category = "monitoring" },
        new() { Id = "trusted-devices", Label = "Trusted devices configured", Description = "Only verified devices can access your account without additional verification", Completed = true, FixAction = "Manage devices", IconName = "shield-check", Category = "monitoring" },
    ];

    private static readonly SecurityEvent[] _recentEvents =
    [
        new() { Id = "evt-1", Action = "Password changed", Detail = "Password updated successfully from Chrome on macOS", Timestamp = "Mar 28, 2026", Severity = "success" },
        new() { Id = "evt-2", Action = "New device login", Detail = "Firefox on Windows 11 from 203.45.67.89 (London, UK)", Timestamp = "Mar 25, 2026", Severity = "warning" },
        new() { Id = "evt-3", Action = "2FA verified", Detail = "Authenticator app confirmed during login", Timestamp = "Mar 24, 2026", Severity = "info" },
        new() { Id = "evt-4", Action = "Backup codes regenerated", Detail = "New set of 10 backup codes generated", Timestamp = "Mar 20, 2026", Severity = "info" },
    ];

    private static readonly Dictionary<string, string> _severityStyles = new()
    {
        ["success"] = "bg-emerald-500",
        ["warning"] = "bg-amber-500",
        ["info"] = "bg-blue-500",
    };

    private string? _fixingId;
    private bool _showAllEvents;

    private int _completedCount => _checks.Count(c => c.Completed);
    private int _totalCount => _checks.Count;
    private int _score => _totalCount > 0 ? (int)Math.Round((double)_completedCount / _totalCount * 100) : 0;

    private string _scoreColor => _score >= 80 ? "text-emerald-600" : _score >= 50 ? "text-amber-600" : "text-red-600";
    private string _scoreStrokeColor => _score >= 80 ? "stroke-emerald-500" : _score >= 50 ? "stroke-amber-500" : "stroke-red-500";
    private string _scoreLabel => _score >= 80 ? "Strong" : _score >= 50 ? "Moderate" : "Weak";
    private string _scoreBadgeClass => _score >= 80
        ? "h-4 px-1.5 text-[10px] bg-emerald-500/10 text-emerald-600"
        : _score >= 50
            ? "h-4 px-1.5 text-[10px] bg-amber-500/10 text-amber-600"
            : "h-4 px-1.5 text-[10px] bg-red-500/10 text-red-600";

    private double _circumference => 2 * Math.PI * 38;
    private double _strokeOffset => _circumference - (_score / 100.0) * _circumference;
    private string _circumferenceStr => _circumference.ToString("F4", System.Globalization.CultureInfo.InvariantCulture);
    private string _strokeOffsetStr => _strokeOffset.ToString("F4", System.Globalization.CultureInfo.InvariantCulture);

    private SecurityEvent[] _visibleEvents => _showAllEvents ? _recentEvents : _recentEvents[..2];

    private async Task HandleFix(string id)
    {
        _fixingId = id;
        StateHasChanged();
        await Task.Delay(1200);
        var check = _checks.FirstOrDefault(c => c.Id == id);
        if (check != null) check.Completed = true;
        _fixingId = null;
    }
}
