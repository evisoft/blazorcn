@* ============================================================
   Block: account-plan-comparison
   Title: Account Plan Comparison
   Description: Side-by-side plan comparison with feature matrix, current plan indicator, pricing columns, and upgrade buttons for subscription decision-making
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/account/account-plan-comparison.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <LucideCrownCn Class="h-5 w-5 text-muted-foreground" Size="20" />
                <div>
                    <h2 class="text-sm font-medium">Plan Comparison</h2>
                    <p class="text-xs text-muted-foreground">Compare plans and find the right fit</p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-4 gap-3">
                <div></div>
                @foreach (var plan in _plans)
                {
                    <div class="@Cn.Merge("rounded-md border p-3 text-center", plan.Current ? "border-primary bg-primary/5" : "")">
                        <div class="mb-1 flex items-center justify-center gap-1.5">
                            <span class="text-sm font-medium">@plan.Name</span>
                        </div>
                        @if (plan.Popular)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="mb-1.5 h-4 px-1.5 text-[10px]">Popular</BadgeCn>
                        }
                        @if (plan.Current)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="mb-1.5 h-4 px-1.5 text-[10px]">Current</BadgeCn>
                        }
                        <p class="text-xl font-semibold tabular-nums">@plan.Price</p>
                        <p class="text-xs text-muted-foreground">@plan.Interval</p>
                    </div>
                }
            </div>
        </div>

        <div class="divide-y">
            @foreach (var feature in _features)
            {
                <div class="grid grid-cols-4 gap-3 px-4 py-2.5">
                    <span class="flex items-center text-sm text-muted-foreground">@feature.Name</span>
                    @foreach (var value in new object[] { feature.Free, feature.Pro, feature.Enterprise })
                    {
                        <div class="flex items-center justify-center">
                            @if (value is bool boolVal)
                            {
                                @if (boolVal)
                                {
                                    <LucideCheckCn Class="h-4 w-4 text-emerald-500" Size="16" />
                                }
                                else
                                {
                                    <LucideXCn Class="h-4 w-4 text-muted-foreground/40" Size="16" />
                                }
                            }
                            else
                            {
                                <span class="text-xs font-medium">@value</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <div class="grid grid-cols-4 gap-3">
                <div></div>
                @foreach (var plan in _plans)
                {
                    <div class="flex justify-center">
                        @if (plan.Current)
                        {
                            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Disabled="true" Class="w-full text-xs">Current Plan</ButtonCn>
                        }
                        else
                        {
                            <ButtonCn Size="ButtonSize.Sm" Class="w-full text-xs">Upgrade</ButtonCn>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record PlanColumn(string Id, string Name, string Price, string Interval, bool Current, bool Popular = false);
    private record FeatureRow(string Name, object Free, object Pro, object Enterprise);

    private static readonly PlanColumn[] _plans =
    [
        new("free", "Free", "$0", "forever", true),
        new("pro", "Pro", "$29", "/mo", false, true),
        new("enterprise", "Enterprise", "$99", "/mo", false),
    ];

    private static readonly FeatureRow[] _features =
    [
        new("Projects", "3", "Unlimited", "Unlimited"),
        new("Team members", "1 seat", "10 seats", "Unlimited"),
        new("Storage", "1 GB", "50 GB", "500 GB"),
        new("API access", "1K calls/mo", "100K calls/mo", "Unlimited"),
        new("Priority support", false, true, true),
        new("SSO & SAML", false, false, true),
    ];
}
