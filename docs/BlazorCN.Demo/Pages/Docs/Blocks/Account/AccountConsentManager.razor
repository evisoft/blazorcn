@* ============================================================
   Block: account-consent-manager
   Title: Account Consent Manager
   Description: Granular cookie and tracking consent toggles for GDPR and CCPA compliance
   Dependencies: ButtonCn, SwitchCn
   Source: original/blocks/account/account-consent-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <LucideCookieCn Class="h-5 w-5 text-muted-foreground" Size="20" />
                    <div>
                        <h2 class="text-sm font-medium">Consent Manager</h2>
                        <p class="text-xs text-muted-foreground">Manage cookie and tracking preferences</p>
                    </div>
                </div>
                <span class="text-xs text-muted-foreground">Updated Mar 1, 2026</span>
            </div>
        </div>

        <div class="divide-y">
            @foreach (var category in _categories)
            {
                <div class="flex items-center gap-3 px-4 py-3">
                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", category.Enabled ? "bg-emerald-500" : "bg-muted-foreground/30")"></span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@category.Name</span>
                            @if (category.Required)
                            {
                                <span class="text-[10px] text-muted-foreground">Required</span>
                            }
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">@category.Description</p>
                    </div>
                    <SwitchCn aria-label="@category.Name" Checked="@category.Enabled" Disabled="@category.Required"
                              CheckedChanged="@((bool v) => { if (!category.Required) category.Enabled = v; })" />
                </div>
            }
        </div>

        <div class="flex items-center justify-end border-t px-4 py-3">
            <ButtonCn Class="min-w-[140px]">Save Preferences</ButtonCn>
        </div>
    </div>
</section>

@code {
    private class ConsentCategory
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public bool Enabled { get; set; }
        public bool Required { get; set; }
    }

    private List<ConsentCategory> _categories =
    [
        new() { Id = "essential", Name = "Essential", Description = "Required for basic site functionality, authentication, and security. Cannot be disabled.", Enabled = true, Required = true },
        new() { Id = "analytics", Name = "Analytics", Description = "Helps us understand how you use the product so we can improve performance and features.", Enabled = true, Required = false },
        new() { Id = "marketing", Name = "Marketing", Description = "Used for targeted advertising, retargeting pixels, and measuring campaign effectiveness.", Enabled = false, Required = false },
        new() { Id = "personalization", Name = "Personalization", Description = "Enables personalized recommendations, A/B testing, and tailored content based on your activity.", Enabled = true, Required = false },
    ];
}
