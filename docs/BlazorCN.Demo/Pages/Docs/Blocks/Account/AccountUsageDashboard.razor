@* ============================================================
   Block: account-usage-dashboard
   Title: AccountUsageDashboard
   Description: A usage analytics dashboard block for React and Next.js with metric cards, 7-day bar chart, endpoint breakdown table, and overage warnings built with shadcn/ui and Tailwind CSS
   Source: original/blocks/account/account-usage-dashboard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="text-sm font-medium">Usage Dashboard</h2>
                <p class="text-xs text-muted-foreground">
                    Current billing period: Mar 1 - Mar 31, 2026
                </p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 text-[10px]">
                Pro Plan
            </BadgeCn>
        </div>

        @* Overage Warning *@
        @if (_overageMetrics.Length > 0)
        {
            <div class="border-b px-4 py-3">
                <div class="flex items-start gap-2.5 rounded-md bg-amber-500/10 px-3 py-2.5">
                    <LucideIconCn Name="alert-triangle" Size="14" Class="mt-0.5 h-3.5 w-3.5 shrink-0 text-amber-600 dark:text-amber-400" />
                    <div>
                        <p class="text-xs font-medium text-amber-700 dark:text-amber-300">
                            Approaching plan limits
                        </p>
                        <p class="mt-0.5 text-[10px] text-amber-600 dark:text-amber-400">
                            @string.Join(", ", _overageMetrics.Select(m => m.Label))
                            @(_overageMetrics.Length == 1 ? " is" : " are") above 80% of
                            @(_overageMetrics.Length == 1 ? " its" : " their") limit. Consider upgrading to avoid
                            overage charges.
                        </p>
                    </div>
                </div>
            </div>
        }

        @* Metric Cards *@
        <div class="grid grid-cols-2 gap-px border-b bg-border sm:grid-cols-4">
            @foreach (var metric in _metrics)
            {
                var pct = (int)Math.Round(metric.Current / metric.Limit * 100);
                var statusColor = pct >= 90
                    ? "text-red-600 dark:text-red-400"
                    : pct >= 80
                        ? "text-amber-600 dark:text-amber-400"
                        : "text-emerald-600 dark:text-emerald-400";
                var barColor = pct >= 90 ? "bg-red-500" : pct >= 80 ? "bg-amber-500" : "bg-emerald-500";

                <div class="bg-card px-4 py-3">
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="@metric.IconName" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">@metric.Label</span>
                    </div>
                    <div class="mt-1.5 flex items-baseline gap-1">
                        <span class="text-xl font-semibold tabular-nums">@metric.FormattedCurrent</span>
                        <span class="text-xs text-muted-foreground">/ @metric.FormattedLimit @metric.Unit</span>
                    </div>
                    <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                        <div class="@($"h-full rounded-full transition-all {barColor}")"
                             style="@($"width:{Math.Min(pct, 100)}%")">
                        </div>
                    </div>
                    <span class="@($"mt-1 block text-[10px] font-medium tabular-nums {statusColor}")">
                        @(pct)% used
                    </span>
                </div>
            }
        </div>

        @* 7-Day Bar Chart *@
        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">
                    API CALLS (LAST 7 DAYS)
                </span>
                <span class="text-xs tabular-nums text-muted-foreground">
                    Total: @FormatCalls(_dailyUsage.Sum(d => d.Calls))
                </span>
            </div>
            <TooltipProviderCn>
                <div class="flex items-end gap-1.5" style="height:120px">
                    @foreach (var day in _dailyUsage)
                    {
                        var barHeightPx = (int)Math.Round((double)day.Calls / MaxDailyCalls * 100);
                        <TooltipCn>
                            <TooltipTriggerCn>
                                <div class="flex flex-1 flex-col items-center gap-1">
                                    <div class="w-full cursor-default rounded-sm bg-foreground/15 transition-colors hover:bg-foreground/25" role="img"
                                         style="@($"height:{barHeightPx}px")"
                                         aria-label="@($"{day.Day}: {FormatCalls(day.Calls)} API calls, {day.Bandwidth} GB bandwidth")">
                                    </div>
                                    <span class="text-[10px] text-muted-foreground">@day.Day</span>
                                </div>
                            </TooltipTriggerCn>
                            <TooltipContentCn Class="text-xs">
                                <p class="font-medium">@day.Day</p>
                                <p class="text-muted-foreground">@FormatCalls(day.Calls) calls</p>
                                <p class="text-muted-foreground">@day.Bandwidth GB bandwidth</p>
                            </TooltipContentCn>
                        </TooltipCn>
                    }
                </div>
            </TooltipProviderCn>
        </div>

        @* Endpoint Breakdown Table *@
        <div class="px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">TOP ENDPOINTS</span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-[10px] text-muted-foreground">
                    View All
                    <LucideIconCn Name="arrow-up-right" Size="12" Class="h-3 w-3" />
                </ButtonCn>
            </div>
            <div class="overflow-hidden rounded-md border">
                <table class="w-full">
                    <thead>
                        <tr class="border-b bg-muted/30">
                            <th class="px-3 py-2 text-left text-[10px] font-medium text-muted-foreground">
                                Endpoint
                            </th>
                            <th class="px-3 py-2 text-right text-[10px] font-medium text-muted-foreground">
                                Calls
                            </th>
                            <th class="hidden px-3 py-2 text-right text-[10px] font-medium text-muted-foreground sm:table-cell">
                                Latency
                            </th>
                            <th class="px-3 py-2 text-right text-[10px] font-medium text-muted-foreground">
                                Errors
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ep in _endpointUsage)
                        {
                            <tr class="border-b last:border-b-0 transition-colors hover:bg-muted/30">
                                <td class="px-3 py-2">
                                    <div class="flex items-center gap-2">
                                        <span class="@($"font-mono text-[10px] font-medium {GetMethodColor(ep.Method)}")">
                                            @ep.Method
                                        </span>
                                        <span class="truncate font-mono text-xs text-muted-foreground">
                                            @ep.Path
                                        </span>
                                    </div>
                                </td>
                                <td class="px-3 py-2 text-right font-mono text-xs tabular-nums text-muted-foreground">
                                    @FormatCalls(ep.Calls)
                                </td>
                                <td class="hidden px-3 py-2 text-right font-mono text-xs tabular-nums text-muted-foreground sm:table-cell">
                                    @ep.AvgLatency
                                </td>
                                <td class="px-3 py-2 text-right">
                                    <span class="@($"font-mono text-xs tabular-nums {(ep.ErrorRate >= 1 ? "text-red-600 dark:text-red-400" : "text-muted-foreground")}")">
                                        @(ep.ErrorRate)%
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-[10px] text-muted-foreground">Usage resets in 12 days</span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Upgrade Plan
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record UsageMetric(string Id, string Label, string IconName, double Current, double Limit, string Unit, string FormattedCurrent, string FormattedLimit);
    private record DailyUsageEntry(string Day, int Calls, double Bandwidth);
    private record EndpointEntry(string Method, string Path, int Calls, string AvgLatency, double ErrorRate);

    private static readonly UsageMetric[] _metrics =
    [
        new("api",       "API Calls",  "zap",   847200, 1000000, "requests", "847.2K", "1M"),
        new("bandwidth", "Bandwidth",  "globe",     78,     100, "GB",       "78",     "100"),
        new("storage",   "Storage",    "cloud",    7.2,      10, "GB",       "7.2",    "10"),
        new("compute",   "Compute",    "cpu",      312,     500, "hours",    "312",    "500"),
    ];

    private static readonly DailyUsageEntry[] _dailyUsage =
    [
        new("Mon", 142000, 11.2),
        new("Tue", 128000, 10.1),
        new("Wed", 156000, 13.4),
        new("Thu", 134000, 11.8),
        new("Fri", 161000, 14.2),
        new("Sat",  72000,  6.1),
        new("Sun",  54200,  4.8),
    ];

    private static readonly EndpointEntry[] _endpointUsage =
    [
        new("GET",    "/api/v2/users",        312400, "45ms",  0.12),
        new("POST",   "/api/v2/webhooks",     189200, "128ms", 1.8),
        new("GET",    "/api/v2/analytics",    156800, "210ms", 0.34),
        new("PUT",    "/api/v2/projects/:id",  98400, "67ms",  0.08),
        new("DELETE", "/api/v2/cache",         90400, "12ms",  0.02),
    ];

    private const int MaxDailyCalls = 161000;

    private UsageMetric[] _overageMetrics =>
        _metrics.Where(m => (int)Math.Round(m.Current / m.Limit * 100) >= 80).ToArray();

    private static string FormatCalls(int num)
    {
        if (num >= 1_000_000) return $"{num / 1_000_000.0:F1}M";
        if (num >= 1_000)     return $"{num / 1_000.0:F1}K";
        return num.ToString();
    }

    private static string GetMethodColor(string method) => method switch
    {
        "GET"    => "text-blue-600 dark:text-blue-400",
        "POST"   => "text-emerald-600 dark:text-emerald-400",
        "PUT"    => "text-amber-600 dark:text-amber-400",
        "DELETE" => "text-red-600 dark:text-red-400",
        _        => "text-muted-foreground",
    };
}
