@* ============================================================
   Block: account-certificates
   Title: Account Certificates
   Description: Certificates and achievements dashboard with earned credentials, digital badges, course completions, downloadable certificates, and LinkedIn sharing
   Long Description: Certificates and achievements dashboard
   Dependencies: BadgeCn, ButtonCn, ProgressCn, TabsCn, TabsContentCn, TabsListCn, TabsTriggerCn, LucideAwardCn, LucideCalendarCn, LucideChevronRightCn, LucideClockCn, LucideDownloadCn, LucideExternalLinkCn, LucideMedalCn, LucideStarCn, LucideTargetCn, LucideTriangleAlertCn, LucideTrophyCn, LucideZapCn
   Source: original/blocks/account/account-certificates.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex-1">
                    <h2 class="text-sm font-medium">Certificates & Achievements</h2>
                    <p class="text-muted-foreground text-xs">
                        Your earned credentials, badges, and accomplishments
                    </p>
                </div>
                <div class="text-right">
                    <p class="text-2xl font-semibold tabular-nums">@(_certificates.Length + _achievements.Length)</p>
                    <p class="text-muted-foreground text-xs">Total credentials</p>
                </div>
            </div>
        </div>

        @if (_certificates.Any(c => c.IsExpiring))
        {
            <div class="flex items-start gap-3 border-b bg-muted/50 px-4 py-3">
                <LucideTriangleAlertCn Size="16" Class="mt-0.5 shrink-0 text-amber-600" />
                <div class="flex-1">
                    <p class="text-xs font-medium text-amber-900">Certification expiring soon</p>
                    <p class="mt-0.5 text-xs text-amber-700">
                        Your Google Analytics certification expires in March 2025.
                    </p>
                </div>
                <ButtonCn Class="shrink-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                    Renew Now
                </ButtonCn>
            </div>
        }

        <div class="border-b px-4 py-3">
            <h3 class="mb-3 text-xs font-medium text-muted-foreground">IN PROGRESS</h3>

            <div class="space-y-3">
                @foreach (var cert in _inProgress)
                {
                    <div class="rounded-md border p-3">
                        <div class="mb-2 flex items-start justify-between">
                            <div>
                                <p class="text-sm font-medium">@cert.Title</p>
                                <p class="text-muted-foreground text-xs">@cert.Issuer</p>
                            </div>
                            <BadgeCn Class="h-4 px-1.5 text-xs" Variant="BadgeVariant.Secondary">
                                @cert.CompletedModules/@cert.TotalModules modules
                            </BadgeCn>
                        </div>
                        <ProgressCn Class="mb-2 h-2" Value="@cert.Progress" />
                        <div class="flex items-center justify-between text-xs text-muted-foreground">
                            <span>@cert.Progress% complete</span>
                            <span>~@cert.EstimatedTimeLeft left</span>
                        </div>
                        <ButtonCn Class="mt-3 w-full gap-1.5" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                            Continue Learning
                            <LucideChevronRightCn Size="16" />
                        </ButtonCn>
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <TabsCn DefaultValue="certificates">
                <TabsListCn Class="mb-4">
                    <TabsTriggerCn Value="certificates" Class="gap-1.5">
                        <LucideAwardCn Size="16" />
                        Certificates
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="achievements" Class="gap-1.5">
                        <LucideTrophyCn Size="16" />
                        Achievements
                    </TabsTriggerCn>
                </TabsListCn>

                <TabsContentCn Value="certificates">
                    <div class="space-y-3">
                        @foreach (var cert in _certificates)
                        {
                            <div class="rounded-md border px-4 py-3">
                                <div class="flex items-start gap-3">
                                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-blue-500"></span>

                                    <div class="min-w-0 flex-1">
                                        <div class="mb-1 flex items-center gap-2">
                                            <p class="text-sm font-medium">@cert.Title</p>
                                            <BadgeCn Class="h-4 px-1.5 text-xs" Variant="BadgeVariant.Secondary">
                                                @cert.Type
                                            </BadgeCn>
                                            @if (cert.IsExpiring)
                                            {
                                                <BadgeCn Class="h-4 px-1.5 text-xs" Variant="BadgeVariant.Secondary">
                                                    Expiring Soon
                                                </BadgeCn>
                                            }
                                        </div>

                                        <p class="mb-2 text-muted-foreground text-xs">@cert.Issuer</p>

                                        <div class="mb-2 flex items-center gap-3 text-xs text-muted-foreground">
                                            <div class="flex items-center gap-1.5">
                                                <LucideCalendarCn Size="14" />
                                                <span>Issued @cert.IssuedAt</span>
                                            </div>
                                            @if (cert.ExpiresAt is not null)
                                            {
                                                <span class="text-muted-foreground/40">&bull;</span>
                                                <div class="flex items-center gap-1.5">
                                                    <LucideClockCn Size="14" />
                                                    <span>Expires @cert.ExpiresAt</span>
                                                </div>
                                            }
                                        </div>

                                        <div class="flex flex-wrap gap-1.5">
                                            @foreach (var skill in cert.Skills)
                                            {
                                                <BadgeCn Class="h-4 px-1.5 text-xs" Variant="BadgeVariant.Secondary">
                                                    @skill
                                                </BadgeCn>
                                            }
                                        </div>
                                    </div>

                                    <div class="flex shrink-0 flex-col gap-2">
                                        <ButtonCn Class="gap-1.5" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                                            <LucideExternalLinkCn Size="16" />
                                            View
                                        </ButtonCn>
                                        <ButtonCn Class="gap-1.5" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                                            <LucideDownloadCn Size="16" />
                                            PDF
                                        </ButtonCn>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </TabsContentCn>

                <TabsContentCn Value="achievements">
                    <div class="space-y-3">
                        @foreach (var achievement in _achievements)
                        {
                            <div class="rounded-md border p-3">
                                <div class="flex items-start gap-3">
                                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-amber-500"></span>
                                    <div class="min-w-0 flex-1">
                                        <div class="mb-1 flex items-center gap-2">
                                            @switch (achievement.Icon)
                                            {
                                                case "trophy":
                                                    <LucideTrophyCn Size="16" Class="text-muted-foreground" />
                                                    break;
                                                case "star":
                                                    <LucideStarCn Size="16" Class="text-muted-foreground" />
                                                    break;
                                                case "zap":
                                                    <LucideZapCn Size="16" Class="text-muted-foreground" />
                                                    break;
                                                case "target":
                                                    <LucideTargetCn Size="16" Class="text-muted-foreground" />
                                                    break;
                                                case "medal":
                                                    <LucideMedalCn Size="16" Class="text-muted-foreground" />
                                                    break;
                                            }
                                            <p class="text-sm font-medium">@achievement.Title</p>
                                            <BadgeCn Class="h-4 px-1.5 text-xs" Variant="BadgeVariant.Secondary">
                                                @achievement.Rarity
                                            </BadgeCn>
                                        </div>
                                        <p class="mb-1 text-muted-foreground text-xs">@achievement.Description</p>
                                        <p class="text-xs text-muted-foreground">Earned @achievement.EarnedAt</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </TabsContentCn>
            </TabsCn>
        </div>
    </div>
</section>

@code {
    private record Certificate(string Id, string Title, string Issuer, string IssuedAt, string? ExpiresAt, bool IsExpiring, string Type, string[] Skills);
    private record Achievement(string Id, string Title, string Description, string EarnedAt, string Icon, string Rarity);
    private record InProgressCert(string Id, string Title, string Issuer, int Progress, int CompletedModules, int TotalModules, string EstimatedTimeLeft);

    private static readonly Certificate[] _certificates =
    [
        new("1", "Advanced React Development", "TechAcademy Pro", "Nov 15, 2024", null, false, "certificate", ["React", "TypeScript", "Next.js", "Testing"]),
        new("2", "AWS Solutions Architect", "Amazon Web Services", "Sep 20, 2024", "Sep 20, 2027", false, "license", ["AWS", "Cloud Architecture", "Security"]),
        new("3", "Google Analytics Certified", "Google", "Mar 15, 2024", "Mar 15, 2025", true, "certificate", ["Analytics", "Data Analysis", "Marketing"]),
    ];

    private static readonly Achievement[] _achievements =
    [
        new("1", "Fast Learner", "Completed 5 courses in one month", "Dec 1, 2024", "zap", "rare"),
        new("2", "Perfect Score", "Scored 100% on a certification exam", "Nov 15, 2024", "trophy", "epic"),
        new("3", "Early Adopter", "Among first 100 users to try new features", "Oct 5, 2024", "star", "rare"),
    ];

    private static readonly InProgressCert[] _inProgress =
    [
        new("1", "Kubernetes Administrator", "Cloud Native Foundation", 68, 17, 25, "8 hours"),
    ];
}
