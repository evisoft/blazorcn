@* ============================================================
   Block: account-cookie-preferences
   Title: AccountCookiePreferences
   Description: An accordion-based cookie consent preferences panel for React and Next.js with expandable categories, individual cookie details, master toggles, and bulk actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/account/account-cookie-preferences.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Cookie Preferences</h2>
                    <p class="text-xs text-muted-foreground">
                        Manage how cookies and tracking technologies are used
                    </p>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="shield" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-xs tabular-nums text-muted-foreground">
                        @_activeCookies/@_totalCookies active
                    </span>
                </div>
            </div>
        </div>

        @* Bulk actions *@
        <div class="flex items-center gap-2 border-b px-4 py-2">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="HandleAcceptAll">
                Accept All
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="HandleRejectNonEssential">
                Reject Non-Essential
            </ButtonCn>
            <span class="ml-auto text-[10px] text-muted-foreground">
                @_enabledOptional of @_totalOptional optional enabled
            </span>
        </div>

        @* Accordion categories *@
        <div class="divide-y">
            @foreach (var category in _categories)
            {
                var isExpanded = _expandedIds.Contains(category.Id);
                <div>
                    @* Category header row *@
                    <div class="flex items-center gap-3 px-4 py-3">
                        <button type="button" @onclick="@(() => ToggleExpanded(category.Id))"
                                class="flex min-w-0 flex-1 items-center gap-3 text-left">
                            <span class="@Cn.Merge("flex shrink-0 items-center justify-center transition-transform duration-150", isExpanded ? "rotate-180" : "")">
                                <LucideIconCn Name="chevron-down" Size="16" Class="size-4 text-muted-foreground" />
                            </span>
                            <div class="min-w-0 flex-1">
                                <span class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@category.Name</span>
                                    @if (category.Required)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 gap-0.5 px-1.5 text-[10px]">
                                            <LucideIconCn Name="lock" Size="8" Class="size-2" />
                                            Required
                                        </BadgeCn>
                                    }
                                    <span class="text-[10px] tabular-nums text-muted-foreground">
                                        @category.Cookies.Length cookies
                                    </span>
                                </span>
                                <p class="mt-0.5 text-xs text-muted-foreground line-clamp-1">
                                    @category.Description
                                </p>
                            </div>
                        </button>
                        <SwitchCn Checked="@category.Enabled"
                                  Disabled="@category.Required"
                                  CheckedChanged="@((bool v) => ToggleCategory(category.Id))"
                                  aria-label="@($"Toggle {category.Name} cookies")"
                                  Class="shrink-0" />
                    </div>

                    @* Expanded cookie details *@
                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="border-t bg-muted/30 px-4 py-2">
                                <p class="mb-2 text-xs text-muted-foreground">@category.Description</p>
                                @* Cookie table *@
                                <div class="overflow-hidden rounded-md border bg-card">
                                    <div class="grid grid-cols-[1fr_100px_70px_100px] gap-px bg-muted text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                                        <span class="bg-card px-3 py-1.5">Cookie</span>
                                        <span class="bg-card px-3 py-1.5">Provider</span>
                                        <span class="bg-card px-3 py-1.5">Expiry</span>
                                        <span class="bg-card px-3 py-1.5">Purpose</span>
                                    </div>
                                    @foreach (var cookie in category.Cookies)
                                    {
                                        <div class="grid grid-cols-[1fr_100px_70px_100px] gap-px bg-muted">
                                            <div class="bg-card px-3 py-2">
                                                <p class="font-mono text-xs">@cookie.Name</p>
                                                <p class="mt-0.5 text-[10px] text-muted-foreground">
                                                    @cookie.Description
                                                </p>
                                            </div>
                                            <span class="bg-card px-3 py-2 text-xs text-muted-foreground">
                                                @cookie.Provider
                                            </span>
                                            <span class="bg-card px-3 py-2 font-mono text-xs text-muted-foreground">
                                                @cookie.Expiry
                                            </span>
                                            <span class="bg-card px-3 py-2">
                                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px]">
                                                    @cookie.Purpose
                                                </BadgeCn>
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <p class="text-[10px] text-muted-foreground">
                Last updated: Mar 15, 2026 · Cookie policy v2.4
            </p>
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-xs text-emerald-600">
                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                    Preferences Saved
                </span>
            }
            else
            {
                <ButtonCn Size="ButtonSize.Sm" @onclick="HandleSave" Disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <LucideIconCn Name="loader-2" Size="14" Class="mr-1.5 size-3.5 animate-spin" />
                        @:Saving...
                    }
                    else
                    {
                        @:Save Preferences
                    }
                </ButtonCn>
            }
        </div>
    </div>
</section>

@code {
    private record CookieDetail(string Name, string Provider, string Expiry, string Purpose, string Description);

    private class CookieCategory
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public bool Required { get; set; }
        public bool Enabled { get; set; }
        public CookieDetail[] Cookies { get; set; } = [];
    }

    private List<CookieCategory> _categories =
    [
        new()
        {
            Id = "strictly-necessary",
            Name = "Strictly Necessary",
            Description = "Essential for the website to function. These cookies enable core functionality such as security, network management, and account access. Cannot be disabled.",
            Required = true,
            Enabled = true,
            Cookies =
            [
                new("__session_id", "First Party", "Session", "Authentication", "Maintains user login state across page navigations"),
                new("__csrf_token", "First Party", "Session", "Security", "Prevents cross-site request forgery attacks on form submissions"),
                new("__cookie_consent", "First Party", "365 days", "Compliance", "Stores the user's cookie consent preferences"),
                new("__device_id", "First Party", "730 days", "Security", "Identifies trusted devices for two-factor authentication"),
            ]
        },
        new()
        {
            Id = "performance",
            Name = "Performance",
            Description = "Help us measure and improve site performance by collecting anonymous usage statistics. No personally identifiable information is collected.",
            Required = false,
            Enabled = true,
            Cookies =
            [
                new("_ga", "Google Analytics", "730 days", "Analytics", "Distinguishes unique users by assigning a randomly generated number"),
                new("_ga_XXXXXXXX", "Google Analytics", "730 days", "Analytics", "Maintains session state across page requests"),
                new("mp_mixpanel_id", "Mixpanel", "365 days", "Analytics", "Tracks anonymous user interactions and event funnels"),
                new("_dd_s", "Datadog RUM", "Session", "Performance", "Monitors page load times and JavaScript errors in real time"),
                new("sb_perf_rum", "First Party", "30 days", "Performance", "Collects Core Web Vitals metrics (LCP, FID, CLS) for optimization"),
            ]
        },
        new()
        {
            Id = "functional",
            Name = "Functional",
            Description = "Enable personalized features like language preferences, theme settings, and recently viewed items. Disabling may reduce your experience quality.",
            Required = false,
            Enabled = true,
            Cookies =
            [
                new("locale", "First Party", "365 days", "Preferences", "Stores preferred language and regional formatting"),
                new("theme", "First Party", "365 days", "Preferences", "Remembers light or dark mode selection across sessions"),
                new("recent_views", "First Party", "30 days", "Personalization", "Tracks recently viewed pages for quick access and recommendations"),
                new("tz_offset", "First Party", "Session", "Preferences", "Detects timezone for displaying dates and times correctly"),
            ]
        },
        new()
        {
            Id = "targeting",
            Name = "Targeting & Advertising",
            Description = "Used to deliver relevant advertisements and measure campaign performance. These cookies may be set by advertising partners and used to build a profile of your interests.",
            Required = false,
            Enabled = false,
            Cookies =
            [
                new("_fbp", "Meta Pixel", "90 days", "Advertising", "Identifies browsers for ad targeting and conversion measurement"),
                new("_gcl_au", "Google Ads", "90 days", "Conversion", "Stores conversion data for Google Ads click attribution"),
                new("li_fat_id", "LinkedIn Insight", "30 days", "Advertising", "Enables LinkedIn ad targeting and demographic insights"),
                new("_tt_enable_cookie", "TikTok Pixel", "390 days", "Advertising", "Checks if cookies can be set for TikTok ad attribution"),
                new("rdt_uuid", "Reddit Pixel", "90 days", "Advertising", "Tracks conversions from Reddit ad campaigns"),
                new("_uetsid", "Microsoft Clarity", "1 day", "Analytics", "Tracks user session for Bing Ads attribution"),
            ]
        },
    ];

    private readonly HashSet<string> _expandedIds = [];
    private bool _isSaving;
    private bool _saved;

    private int _totalCookies => _categories.Sum(c => c.Cookies.Length);
    private int _activeCookies => _categories.Where(c => c.Enabled).Sum(c => c.Cookies.Length);
    private int _enabledOptional => _categories.Count(c => !c.Required && c.Enabled);
    private int _totalOptional => _categories.Count(c => !c.Required);

    private void ToggleExpanded(string id)
    {
        if (!_expandedIds.Add(id))
            _expandedIds.Remove(id);
    }

    private void ToggleCategory(string id)
    {
        var cat = _categories.FirstOrDefault(c => c.Id == id);
        if (cat is not null && !cat.Required)
            cat.Enabled = !cat.Enabled;
    }

    private void HandleAcceptAll()
    {
        foreach (var c in _categories) c.Enabled = true;
    }

    private void HandleRejectNonEssential()
    {
        foreach (var c in _categories) c.Enabled = c.Required;
    }

    private async Task HandleSave()
    {
        _isSaving = true;
        StateHasChanged();
        await Task.Delay(1200);
        _isSaving = false;
        _saved = true;
        StateHasChanged();
        await Task.Delay(2000);
        _saved = false;
    }
}
