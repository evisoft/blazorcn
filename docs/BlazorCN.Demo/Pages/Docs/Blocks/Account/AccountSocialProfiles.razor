@* ============================================================
   Block: account-social-profiles
   Title: Account Social Profiles
   Description: Social profiles management with platform links, public visibility controls, and profile verification status
   Long Description: Social profiles management
   Dependencies: BadgeCn, ButtonCn, SwitchCn, LucideCircleCheckCn, LucideExternalLinkCn, LucideEyeCn, LucideEyeOffCn, LucideGithubCn, LucideGlobeCn, LucideGripVerticalCn, LucidePencilCn, LucidePlusCn, LucideTrash2Cn, LucideTwitterCn, LucideUsersCn
   Source: original/blocks/account/account-social-profiles.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Social Profiles</h2>
                    <p class="text-muted-foreground text-xs">
                        Connect and manage your social media accounts
                    </p>
                </div>
                <ButtonCn Size="ButtonSize.Sm">
                    <LucidePlusCn Size="16" Class="mr-2" />
                    Add Profile
                </ButtonCn>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium">Show Social Profiles</p>
                    <p class="text-muted-foreground text-xs">
                        Display your social links on your public profile
                    </p>
                </div>
                <SwitchCn aria-label="Show Social Profiles" Checked="true" CheckedChanged="@(v => {})" />
            </div>
        </div>

        <div>
            @foreach (var profile in _profiles)
            {
                <div class="border-b px-4 py-3 last:border-b-0">
                    <div class="flex items-center gap-3">
                        <LucideGripVerticalCn Size="16" Class="text-muted-foreground" />
                        <div class="text-muted-foreground">
                            @switch (profile.Platform)
                            {
                                case "twitter":
                                    <LucideTwitterCn Size="16" />
                                    break;
                                case "github":
                                    <LucideGithubCn Size="16" />
                                    break;
                                default:
                                    <LucideGlobeCn Size="16" />
                                    break;
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <p class="text-sm font-medium">@GetPlatformName(profile.Platform)</p>
                                @if (profile.IsVerified)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                                        <LucideCircleCheckCn Size="12" Class="mr-1" />
                                        Verified
                                    </BadgeCn>
                                }
                                @if (!profile.IsPublic)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                                        <LucideEyeOffCn Size="12" Class="mr-1" />
                                        Hidden
                                    </BadgeCn>
                                }
                            </div>
                            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                                <span>@@@profile.Username</span>
                                @if (profile.Followers is not null)
                                {
                                    <span>&bull;</span>
                                    <span class="flex items-center gap-1">
                                        <LucideUsersCn Size="12" />
                                        @FormatFollowers(profile.Followers.Value) followers
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <ButtonCn aria-label="Toggle profile visibility" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                                @if (profile.IsPublic)
                                {
                                    <LucideEyeCn Size="16" />
                                }
                                else
                                {
                                    <LucideEyeOffCn Size="16" Class="text-muted-foreground" />
                                }
                            </ButtonCn>
                            <ButtonCn aria-label="Open profile" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                                <LucideExternalLinkCn Size="16" />
                            </ButtonCn>
                            <ButtonCn aria-label="Edit profile" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                                <LucidePencilCn Size="16" />
                            </ButtonCn>
                            <ButtonCn aria-label="Delete profile" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                                <LucideTrash2Cn Size="16" />
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record SocialProfile(string Id, string Platform, string Username, string Url, bool IsVerified, bool IsPublic, int? Followers = null);

    private static string GetPlatformName(string platform) => platform switch
    {
        "twitter" => "X (Twitter)",
        "github" => "GitHub",
        "instagram" => "Instagram",
        "linkedin" => "LinkedIn",
        _ => platform,
    };

    private static string FormatFollowers(int count)
    {
        if (count >= 1_000_000) return $"{count / 1_000_000.0:F1}M";
        if (count >= 1000) return $"{count / 1000.0:F1}K";
        return count.ToString();
    }

    private static readonly SocialProfile[] _profiles =
    [
        new("1", "twitter", "johndoe", "https://x.com/johndoe", true, true, 12500),
        new("2", "github", "johndoe", "https://github.com/johndoe", true, true, 1540),
        new("3", "instagram", "john.doe", "https://instagram.com/john.doe", false, false, 3200),
    ];
}
