@* ============================================================
   Block: account-audit-trail
   Title: Account Audit Trail
   Description: Compliance-focused audit log showing actor, action, resource, timestamp, IP address, and severity with filterable event types for admin and security teams
   Long Description: Compliance-focused audit log
   Dependencies: BadgeCn, ButtonCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, LucideClockCn, LucideDownloadCn, LucideFilterCn, LucideGlobeCn, LucideShieldCheckCn
   Source: original/blocks/account/account-audit-trail.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <LucideShieldCheckCn Size="20" Class="text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Audit Trail</h2>
                        <p class="text-xs text-muted-foreground">
                            Compliance log of all account actions
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="gap-1.5 text-xs">
                    <LucideDownloadCn Size="14" />
                    Export CSV
                </ButtonCn>
            </div>
        </div>

        <div class="border-b px-4 py-2">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">RECENT EVENTS</span>
                <div class="flex items-center gap-2">
                    <LucideFunnelCn Size="14" Class="text-muted-foreground" />
                    <SelectCn Value="@_filterType" ValueChanged='v => _filterType = v ?? "all"'>
                        <SelectTriggerCn aria-label="Filter type" Class="h-7 w-32 text-xs">
                            <SelectValueCn Placeholder="Filter type" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="all">All Events</SelectItemCn>
                            <SelectItemCn Value="security">Security</SelectItemCn>
                            <SelectItemCn Value="billing">Billing</SelectItemCn>
                            <SelectItemCn Value="team">Team</SelectItemCn>
                            <SelectItemCn Value="settings">Settings</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>
        </div>

        <div>
            @foreach (var entry in FilteredEntries)
            {
                <div class="border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <div class="flex items-start gap-3">
                        <span class="@($"mt-1.5 size-2 shrink-0 rounded-full @(GetSeverityDotColor(entry.Severity))")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="mb-1 flex items-center justify-between gap-2">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="text-sm font-medium">@entry.Action</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px]">
                                        @GetEventTypeLabel(entry.EventType)
                                    </BadgeCn>
                                </div>
                                <div class="flex shrink-0 items-center gap-1 text-xs text-muted-foreground">
                                    <LucideClockCn Size="12" />
                                    @entry.Timestamp
                                </div>
                            </div>
                            <p class="mb-2 text-xs text-muted-foreground">
                                by @entry.Actor on
                                <span class="font-medium text-foreground">@entry.Resource</span>
                            </p>
                            <div class="flex items-center gap-1 text-xs text-muted-foreground">
                                <LucideGlobeCn Size="12" />
                                <span class="font-mono">@entry.Ip</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record AuditEntry(string Id, string Actor, string Action, string Resource, string Timestamp, string Ip, string Severity, string EventType);

    private string _filterType = "all";

    private static readonly AuditEntry[] _entries =
    [
        new("1", "Emma Roberts", "Modified billing settings", "Subscription plan", "3 hours ago", "198.51.100.42", "warning", "billing"),
        new("2", "John Smith", "Removed team member", "sarah@@example.com", "1 day ago", "203.0.113.17", "critical", "team"),
        new("3", "Sarah Johnson", "Enabled two-factor authentication", "Account security", "3 days ago", "192.0.2.88", "info", "security"),
    ];

    private IEnumerable<AuditEntry> FilteredEntries =>
        _filterType == "all" ? _entries : _entries.Where(e => e.EventType == _filterType);

    private static string GetSeverityDotColor(string severity) => severity switch
    {
        "info" => "bg-blue-500",
        "warning" => "bg-amber-500",
        "critical" => "bg-red-500",
        _ => "bg-gray-500"
    };

    private static string GetEventTypeLabel(string eventType) => eventType switch
    {
        "security" => "Security",
        "billing" => "Billing",
        "team" => "Team",
        "settings" => "Settings",
        _ => eventType
    };
}
