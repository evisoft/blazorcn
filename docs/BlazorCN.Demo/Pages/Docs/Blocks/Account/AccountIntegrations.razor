@* ============================================================
   Block: account-integrations
   Title: Account Integrations
   Description: Third-party service integrations with OAuth connections, verification codes, toggle controls, and connected account management
   Long Description: Third-party integrations management
   Dependencies: BadgeCn, ButtonCn, SwitchCn, LucideCircleCheckCn, LucideExternalLinkCn, LucideGithubCn, LucideMessageCircleCn, LucideMusicCn, LucidePlugCn, LucideRefreshCwCn
   Source: original/blocks/account/account-integrations.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <LucidePlugCn Size="16" Class="text-muted-foreground" />
                <div class="flex-1">
                    <h2 class="text-sm font-medium">Third-Party Integrations</h2>
                    <p class="text-xs text-muted-foreground">
                        Connect external services and platforms to your account
                    </p>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary">
                    @(_integrations.Count(i => i.IsConfigured)) of @_integrations.Length connected
                </BadgeCn>
            </div>
        </div>

        <div class="divide-y">
            @foreach (var integration in _integrations)
            {
                <div class="px-4 py-3">
                    <div class="flex items-center gap-3">
                        @switch (integration.Id)
                        {
                            case "github":
                                <LucideGithubCn Size="16" Class="shrink-0 text-muted-foreground" />
                                break;
                            case "spotify":
                                <LucideMusicCn Size="16" Class="shrink-0 text-muted-foreground" />
                                break;
                            case "discord":
                                <LucideMessageCircleCn Size="16" Class="shrink-0 text-muted-foreground" />
                                break;
                        }
                        <div class="min-w-0 flex-1">
                            <div class="mb-0.5 flex items-center gap-2">
                                <h3 class="text-sm font-medium">@integration.Name</h3>
                                <BadgeCn Class="h-4 border-0 bg-muted px-1.5 py-0 text-[10px] text-muted-foreground">
                                    @integration.Category
                                </BadgeCn>
                                @if (integration.IsConfigured)
                                {
                                    <BadgeCn Class="h-4 border-0 bg-emerald-500/10 px-1.5 py-0 text-[10px] text-emerald-700">
                                        <LucideCircleCheckCn Size="12" Class="mr-1" />
                                        Connected
                                    </BadgeCn>
                                }
                            </div>
                            <p class="line-clamp-1 text-xs text-muted-foreground">
                                @integration.Description
                            </p>
                        </div>
                        <div class="flex shrink-0 items-center gap-3">
                            @if (integration.IsConfigured)
                            {
                                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                                    <LucideRefreshCwCn Size="14" Class="mr-1.5" />
                                    Sync
                                </ButtonCn>
                            }
                            else
                            {
                                <ButtonCn Size="ButtonSize.Sm">
                                    <LucideExternalLinkCn Size="14" Class="mr-1.5" />
                                    Connect
                                </ButtonCn>
                            }
                        </div>
                    </div>
                    @if (integration.IsConfigured && integration.ConnectedEmail is not null)
                    {
                        <div class="mt-2 ml-7 rounded-md bg-muted/50 p-3">
                            <p class="text-xs text-muted-foreground">Connected as @integration.ConnectedEmail</p>
                            @if (integration.LastSync is not null)
                            {
                                <p class="text-xs text-muted-foreground">Last sync: @integration.LastSync</p>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Integration(string Id, string Name, string Category, string Description, bool IsConfigured, string? ConnectedEmail, string? LastSync);

    private static readonly Integration[] _integrations =
    [
        new("github", "GitHub", "Development", "Connect your GitHub account to sync repositories and track contributions.", false, null, null),
        new("spotify", "Spotify", "Music", "Link your Spotify account to share playlists and sync listening activity.", true, "emma@@mail.com", "2 hours ago"),
        new("discord", "Discord", "Communication", "Integrate your Discord account to manage server connections and notifications.", false, null, null),
    ];
}
