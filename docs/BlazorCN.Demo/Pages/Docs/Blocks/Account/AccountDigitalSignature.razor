@* ============================================================
   Block: account-digital-signature
   Title: AccountDigitalSignature
   Description: A digital signature management card for React and Next.js with signature preview, cryptographic details, certificate upload, verification chain, and keypair generation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/account/account-digital-signature.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="text-sm font-medium">Digital Signature</h2>
                <p class="text-xs text-muted-foreground">
                    Cryptographic signing identity and certificate
                </p>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 text-[10px] text-emerald-600">
                <LucideIconCn Name="shield-check" Size="12" Class="h-3 w-3" />
                Active
            </BadgeCn>
        </div>

        @* Signature preview *@
        <div class="border-b px-4 py-4">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">
                SIGNATURE PREVIEW
            </span>
            <div class="flex items-center justify-center rounded-md border border-dashed bg-muted/20 px-6 py-8">
                <span class="font-serif text-3xl italic text-foreground/80">
                    @_profile.DisplayName
                </span>
            </div>
        </div>

        @* Certificate details *@
        <div class="border-b px-4 py-3">
            <span class="mb-3 block text-xs font-medium text-muted-foreground">
                CERTIFICATE DETAILS
            </span>
            <div class="space-y-2.5">
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Algorithm</span>
                    <span class="text-xs font-medium">
                        @_profile.Algorithm (@_profile.KeySize)
                    </span>
                </div>
                <div class="flex items-center justify-between gap-4">
                    <span class="shrink-0 text-xs text-muted-foreground">Fingerprint</span>
                    <div class="flex items-center gap-1.5">
                        <code class="truncate font-mono text-[11px] text-muted-foreground">
                            @_profile.Fingerprint
                        </code>
                        <button
                            type="button"
                            @onclick="HandleCopyFingerprint"
                            class="shrink-0 rounded p-0.5 text-muted-foreground transition-colors hover:text-foreground"
                            aria-label="Copy fingerprint">
                            @if (_copied)
                            {
                                <LucideIconCn Name="check-circle-2" Size="14" Class="h-3.5 w-3.5 text-emerald-600" />
                            }
                            else
                            {
                                <LucideIconCn Name="clipboard-copy" Size="14" Class="h-3.5 w-3.5" />
                            }
                        </button>
                    </div>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Serial Number</span>
                    <code class="font-mono text-[11px] text-muted-foreground">
                        @_profile.SerialNumber
                    </code>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Issuer</span>
                    <span class="text-xs font-medium">@_profile.Issuer</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Created</span>
                    <span class="text-xs">@_profile.CreatedDate</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Expires</span>
                    <span class="text-xs">@_profile.ExpiryDate</span>
                </div>
                <div class="space-y-1 pt-1">
                    <div class="flex items-center justify-between">
                        <span class="text-[10px] text-muted-foreground">Certificate lifetime</span>
                        <span class="text-[10px] text-muted-foreground">
                            @_profile.DaysUntilExpiry days remaining
                        </span>
                    </div>
                    <ProgressCn Value="@_expiryPercentage" Class="h-1.5" />
                </div>
            </div>
        </div>

        @* Verification chain *@
        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">VERIFICATION CHAIN</span>
                <span class="text-[10px] text-muted-foreground">
                    @_verifiedCount/@_profile.VerificationSteps.Length verified
                </span>
            </div>
            <div class="space-y-0">
                @for (var i = 0; i < _profile.VerificationSteps.Length; i++)
                {
                    var step = _profile.VerificationSteps[i];
                    var isLast = i == _profile.VerificationSteps.Length - 1;
                    <div class="flex gap-3">
                        @* Vertical connector *@
                        <div class="flex flex-col items-center">
                            <div class="@Cn.Merge("flex h-5 w-5 shrink-0 items-center justify-center rounded-full", step.Status == "verified" ? "bg-emerald-500/10 text-emerald-600" : step.Status == "pending" ? "bg-amber-500/10 text-amber-600" : "bg-red-500/10 text-red-600")">
                                @if (step.Status == "verified")
                                {
                                    <LucideIconCn Name="check-circle-2" Size="12" Class="h-3 w-3" />
                                }
                                else
                                {
                                    <LucideIconCn Name="chevron-right" Size="12" Class="h-3 w-3" />
                                }
                            </div>
                            @if (!isLast)
                            {
                                <div class="my-0.5 h-4 w-px bg-border"></div>
                            }
                        </div>
                        @* Step content *@
                        <div class="@(isLast ? "" : "pb-2")">
                            <span class="text-xs font-medium">@step.Label</span>
                            <p class="text-[11px] text-muted-foreground">@step.Detail</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Upload certificate *@
        @if (_showUpload)
        {
            <div class="border-b px-4 py-3">
                <span class="mb-2 block text-xs font-medium text-muted-foreground">
                    UPLOAD CERTIFICATE
                </span>
                <div class="rounded-md border-2 border-dashed border-muted-foreground/20 px-4 py-6 text-center">
                    <LucideIconCn Name="upload" Size="24" Class="mx-auto h-6 w-6 text-muted-foreground/40" />
                    <p class="mt-2 text-xs font-medium">Drop .pem or .p12 certificate file</p>
                    <p class="text-[11px] text-muted-foreground">
                        X.509 certificates, PKCS#12 bundles (max 5MB)
                    </p>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-3 h-7 text-xs">
                        Choose file
                    </ButtonCn>
                </div>
                <div class="mt-2 flex justify-end">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="@(() => _showUpload = false)">
                        Cancel
                    </ButtonCn>
                </div>
            </div>
        }

        @* Actions *@
        <div class="flex flex-wrap items-center gap-2 px-4 py-3">
            <ButtonCn
                Variant="ButtonVariant.Outline"
                Size="ButtonSize.Sm"
                Class="gap-1.5 text-xs"
                OnClick="HandleGenerateKeypair"
                Disabled="@_generating">
                <LucideIconCn Name="key" Size="14" Class="h-3.5 w-3.5" />
                @(_generating ? "Generating..." : "Generate new keypair")
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-1.5 text-xs">
                <LucideIconCn Name="download" Size="14" Class="h-3.5 w-3.5" />
                Download public key
            </ButtonCn>
            @if (!_showUpload)
            {
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="gap-1.5 text-xs" OnClick="@(() => _showUpload = true)">
                    <LucideIconCn Name="refresh-cw" Size="14" Class="h-3.5 w-3.5" />
                    Replace certificate
                </ButtonCn>
            }
        </div>
    </div>
</section>

@code {
    private record VerificationStep(string Id, string Label, string Status, string Detail);

    private record SignatureProfile(
        string DisplayName,
        string Algorithm,
        string KeySize,
        string Fingerprint,
        string CreatedDate,
        string ExpiryDate,
        int DaysUntilExpiry,
        int TotalDays,
        string SerialNumber,
        string Issuer,
        VerificationStep[] VerificationSteps);

    private static readonly SignatureProfile _profile = new(
        DisplayName: "Emma R. Castillo",
        Algorithm: "RSA-2048",
        KeySize: "2048-bit",
        Fingerprint: "SHA256:a4:9b:c3:d8:e1:f2:07:3a:b5:c6:d9:e0:f1:28:3c:4d",
        CreatedDate: "Jan 15, 2025",
        ExpiryDate: "Jan 15, 2027",
        DaysUntilExpiry: 285,
        TotalDays: 730,
        SerialNumber: "0x03:A1:B2:C3:D4:E5:F6",
        Issuer: "DigiCert SHA2 Extended Validation",
        VerificationSteps:
        [
            new("vs-1", "Certificate Authority", "verified", "DigiCert SHA2 Extended Validation CA"),
            new("vs-2", "Identity Verification", "verified", "Government ID + video verification completed"),
            new("vs-3", "Email Confirmation", "verified", "emma.castillo@acmecorp.com verified"),
            new("vs-4", "Organization Binding", "verified", "Acme Corp — Legal Department"),
            new("vs-5", "Revocation Check", "pending", "OCSP responder check pending"),
        ]);

    private static readonly int _expiryPercentage =
        (int)Math.Round(((double)(_profile.TotalDays - _profile.DaysUntilExpiry) / _profile.TotalDays) * 100);

    private int _verifiedCount => _profile.VerificationSteps.Count(s => s.Status == "verified");

    private bool _copied;
    private bool _showUpload;
    private bool _generating;

    private async Task HandleCopyFingerprint()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }

    private async Task HandleGenerateKeypair()
    {
        _generating = true;
        StateHasChanged();
        await Task.Delay(2000);
        _generating = false;
    }
}
