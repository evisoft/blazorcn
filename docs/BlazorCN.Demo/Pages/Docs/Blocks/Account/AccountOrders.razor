@* ============================================================
   Block: account-orders
   Title: Account Orders
   Description: Order history dashboard with purchase tracking, order status, invoice downloads, reorder options, and delivery tracking for e-commerce accounts
   Dependencies: BadgeCn, ButtonCn, DialogCn, SelectCn
   Source: original/blocks/account/account-orders.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <LucideShoppingBagCn Class="h-5 w-5 text-muted-foreground" Size="20" />
                    <div>
                        <h2 class="text-sm font-medium">Order History</h2>
                        <p class="text-xs text-muted-foreground">View and manage your past orders</p>
                    </div>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px]">@_orders.Length orders</BadgeCn>
            </div>
        </div>

        <div class="space-y-4 p-4">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">YOUR ORDERS</span>
                <SelectCn Value="@_statusFilter" ValueChanged="@((string v) => _statusFilter = v)">
                    <SelectTriggerCn aria-label="Filter orders" Class="h-8 w-[140px] text-xs">
                        <LucideFunnelCn Class="mr-1.5 h-3.5 w-3.5 text-muted-foreground" Size="14" />
                        <SelectValueCn Placeholder="Filter" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="all">All Orders</SelectItemCn>
                        <SelectItemCn Value="processing">Processing</SelectItemCn>
                        <SelectItemCn Value="shipped">Shipped</SelectItemCn>
                        <SelectItemCn Value="delivered">Delivered</SelectItemCn>
                        <SelectItemCn Value="cancelled">Cancelled</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            @{ var filtered = _statusFilter == "all" ? _orders : _orders.Where(o => o.Status == _statusFilter).ToArray(); }

            @if (filtered.Length == 0)
            {
                <div class="flex flex-col items-center justify-center rounded-md border border-dashed py-6">
                    <LucidePackageCn Class="mb-2 h-8 w-8 text-muted-foreground" Size="32" />
                    <p class="mb-2 text-sm text-muted-foreground">No orders found</p>
                    @if (_statusFilter != "all")
                    {
                        <ButtonCn OnClick="@(() => _statusFilter = "all")" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 text-xs">
                            <LucideRotateCcwCn Class="h-3 w-3" Size="12" />
                            Clear Filter
                        </ButtonCn>
                    }
                </div>
            }
            else
            {
                <div class="divide-y rounded-md border">
                    @foreach (var order in filtered)
                    {
                        var config = GetStatusConfig(order.Status);
                        <div class="px-3 py-3">
                            <div class="flex items-start gap-3">
                                <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-muted text-muted-foreground">
                                    @if (order.Status == "shipped") { <LucideTruckCn Class="h-4 w-4" Size="16" /> }
                                    else if (order.Status == "delivered") { <LucideCircleCheckCn Class="h-4 w-4" Size="16" /> }
                                    else { <LucidePackageCn Class="h-4 w-4" Size="16" /> }
                                </div>
                                <div class="min-w-0 flex-1">
                                    <div class="mb-0.5 flex items-center gap-1.5">
                                        <p class="text-sm font-medium">@order.OrderNumber</p>
                                        <span class="@Cn.Merge("size-1.5 rounded-full", config.Dot)"></span>
                                        <span class="@Cn.Merge("text-xs font-medium", config.Color)">@config.Label</span>
                                    </div>
                                    <p class="text-xs text-muted-foreground">
                                        @order.ItemCount @(order.ItemCount == 1 ? "item" : "items") &middot; Ordered @order.Date
                                    </p>
                                    @if (order.Status == "shipped" && order.TrackingNumber != null)
                                    {
                                        <div class="mt-1 flex items-center gap-3 text-xs">
                                            <span class="flex items-center gap-1 text-muted-foreground">
                                                <LucideTruckCn Class="h-3 w-3" Size="12" />
                                                Est. @order.EstimatedDelivery
                                            </span>
                                            <ButtonCn Class="h-auto gap-0.5 p-0 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Link">
                                                Track
                                                <LucideExternalLinkCn Class="h-3 w-3" Size="12" />
                                            </ButtonCn>
                                        </div>
                                    }
                                    @if (order.Status == "delivered")
                                    {
                                        <div class="mt-1 flex items-center gap-1 text-xs text-emerald-700">
                                            <LucideCircleCheckCn Class="h-3 w-3" Size="12" />
                                            Delivered on @order.Date
                                        </div>
                                    }
                                </div>
                                <div class="shrink-0 text-right">
                                    <p class="mb-1.5 text-sm font-semibold tabular-nums">@order.Total</p>
                                    <div class="flex items-center gap-1">
                                        <DialogCn>
                                            <ButtonCn Class="h-7 gap-1 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                                                Details
                                                <LucideChevronRightCn Class="h-3 w-3" Size="12" />
                                            </ButtonCn>
                                            <DialogContentCn Class="w-full max-w-[500px]">
                                                <DialogHeaderCn>
                                                    <DialogTitleCn>Order @order.OrderNumber</DialogTitleCn>
                                                    <DialogDescriptionCn>Placed on @order.Date</DialogDescriptionCn>
                                                </DialogHeaderCn>
                                                <div class="space-y-4 py-4">
                                                    <div class="flex items-center justify-between">
                                                        <span class="text-xs text-muted-foreground">Status</span>
                                                        <div class="flex items-center gap-1.5">
                                                            <span class="@Cn.Merge("size-1.5 rounded-full", config.Dot)"></span>
                                                            <span class="@Cn.Merge("text-xs font-medium", config.Color)">@config.Label</span>
                                                        </div>
                                                    </div>
                                                    <div class="border-t pt-4">
                                                        <p class="mb-2 text-sm font-medium">Items</p>
                                                        <div class="space-y-2">
                                                            @foreach (var item in order.Items)
                                                            {
                                                                <div class="flex items-center justify-between">
                                                                    <div class="flex items-center gap-2">
                                                                        <div class="flex h-8 w-8 items-center justify-center rounded-md bg-muted">
                                                                            <LucidePackageCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                                                                        </div>
                                                                        <div>
                                                                            <p class="text-sm font-medium">@item.Name</p>
                                                                            <p class="text-xs text-muted-foreground">Qty: @item.Quantity</p>
                                                                        </div>
                                                                    </div>
                                                                    <p class="text-sm font-medium tabular-nums">@item.Price</p>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="flex items-center justify-between border-t pt-4">
                                                        <span class="text-sm font-medium">Total</span>
                                                        <span class="text-sm font-semibold tabular-nums">@order.Total</span>
                                                    </div>
                                                </div>
                                                <div class="flex gap-2">
                                                    <ButtonCn Class="flex-1 h-8 gap-1.5 text-xs" Variant="ButtonVariant.Outline">
                                                        <LucideDownloadCn Class="h-3.5 w-3.5" Size="14" />
                                                        Invoice
                                                    </ButtonCn>
                                                    @if (order.Status == "delivered")
                                                    {
                                                        <ButtonCn Class="flex-1 h-8 gap-1.5 text-xs">
                                                            <LucideRefreshCwCn Class="h-3.5 w-3.5" Size="14" />
                                                            Reorder
                                                        </ButtonCn>
                                                    }
                                                </div>
                                            </DialogContentCn>
                                        </DialogCn>
                                        @if (order.Status == "delivered")
                                        {
                                            <ButtonCn Class="h-7 gap-1 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                                                <LucideRefreshCwCn Class="h-3 w-3" Size="12" />
                                                Reorder
                                            </ButtonCn>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record OrderItem(string Id, string Name, int Quantity, string Price);
    private record Order(string Id, string OrderNumber, string Status, string Date, string Total, int ItemCount, OrderItem[] Items, string? TrackingNumber = null, string? EstimatedDelivery = null);

    private string _statusFilter = "all";

    private static (string Color, string Dot, string Label) GetStatusConfig(string status) => status switch
    {
        "pending" => ("text-amber-700", "bg-amber-500", "Pending"),
        "processing" => ("text-blue-700", "bg-blue-500", "Processing"),
        "shipped" => ("text-blue-700", "bg-blue-500", "Shipped"),
        "delivered" => ("text-emerald-700", "bg-emerald-500", "Delivered"),
        "cancelled" => ("text-red-700", "bg-red-500", "Cancelled"),
        _ => ("text-muted-foreground", "bg-muted-foreground", status),
    };

    private static readonly Order[] _orders =
    [
        new("1", "ORD-2024-1847", "shipped", "Dec 5, 2024", "$156.00", 3,
            [new("1", "Wireless Headphones Pro", 1, "$89.00"), new("2", "USB-C Charging Cable", 2, "$24.00"), new("3", "Phone Stand", 1, "$19.00")],
            "1Z999AA10123456784", "Dec 10, 2024"),
        new("2", "ORD-2024-1832", "delivered", "Nov 28, 2024", "$249.00", 1,
            [new("1", "Mechanical Keyboard", 1, "$249.00")]),
        new("3", "ORD-2024-1815", "processing", "Dec 7, 2024", "$67.50", 2,
            [new("1", "Laptop Sleeve 15\"", 1, "$45.00"), new("2", "Screen Cleaner Kit", 1, "$22.50")]),
    ];
}
