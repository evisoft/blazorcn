@* ============================================================
   Block: account-permissions
   Title: Account Permissions
   Description: Permission and role management dashboard with granular access controls, role templates, resource permissions matrix, and audit trail for enterprise team access
   Dependencies: BadgeCn, ButtonCn, CheckboxCn
   Source: original/blocks/account/account-permissions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="mb-1 flex items-center gap-2">
                <h2 class="text-sm font-medium">Permissions &amp; Roles</h2>
            </div>
            <p class="text-xs text-muted-foreground">Manage access control and team permissions</p>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Select Role</p>
            <div class="flex gap-2 overflow-x-auto">
                @foreach (var role in _roles)
                {
                    <button type="button"
                            class="@Cn.Merge("shrink-0 rounded-md border px-3 py-2 text-left transition-colors hover:bg-muted/50", _selectedRole == role.Id ? "border-primary bg-primary/5" : "border-border")"
                            @onclick="@(() => _selectedRole = role.Id)">
                        <div class="mb-0.5 flex items-center gap-1.5">
                            <p class="text-sm font-medium">@role.Name</p>
                            @if (role.IsSystem)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px]">System</BadgeCn>
                            }
                        </div>
                        <p class="text-xs text-muted-foreground">@role.MemberCount members</p>
                    </button>
                }
            </div>
        </div>

        @{ var selectedRoleData = _roles.FirstOrDefault(r => r.Id == _selectedRole); }
        @if (selectedRoleData != null)
        {
            <div class="border-b bg-muted/50 px-4 py-3">
                <div class="flex items-center gap-3">
                    <LucideCrownCn Class="h-4 w-4 shrink-0 text-muted-foreground" Size="16" />
                    <div class="min-w-0 flex-1">
                        <div class="mb-0.5 flex items-center gap-1.5">
                            <p class="text-sm font-medium">@selectedRoleData.Name</p>
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                            <span class="text-xs text-muted-foreground">@TotalPermissions permissions</span>
                        </div>
                        <p class="text-xs text-muted-foreground">@selectedRoleData.Description</p>
                    </div>
                    <div class="flex shrink-0 items-center gap-2">
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                            <LucideCopyCn Class="mr-1.5 h-3.5 w-3.5" Size="14" />
                            Duplicate
                        </ButtonCn>
                        @if (!selectedRoleData.IsSystem)
                        {
                            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                                <LucideTrash2Cn Class="mr-1.5 h-3.5 w-3.5" Size="14" />
                                Delete
                            </ButtonCn>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="border-b">
            <div class="border-b bg-muted/50 px-4 py-2">
                <div class="flex items-center justify-between">
                    <p class="text-xs font-medium text-muted-foreground">Resource Permissions</p>
                    <div class="flex items-center gap-3 text-[10px] text-muted-foreground">
                        <span>View</span>
                        <span>Edit</span>
                        <span>Delete</span>
                        <span>Admin</span>
                    </div>
                </div>
            </div>

            @foreach (var resource in _resources)
            {
                <div class="border-b px-4 py-3 last:border-0">
                    <div class="flex items-center gap-3">
                        @if (resource.Icon == "users")
                        {
                            <LucideUsersCn Class="h-4 w-4 shrink-0 text-muted-foreground" Size="16" />
                        }
                        else if (resource.Icon == "billing")
                        {
                            <LucideCreditCardCn Class="h-4 w-4 shrink-0 text-muted-foreground" Size="16" />
                        }
                        else
                        {
                            <LucideFolderKanbanCn Class="h-4 w-4 shrink-0 text-muted-foreground" Size="16" />
                        }
                        <div class="min-w-0 flex-1">
                            <div class="mb-0.5 flex items-center gap-1.5">
                                <p class="text-sm font-medium">@resource.Name</p>
                                @if (resource.Inherited)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px]">Inherited</BadgeCn>
                                }
                            </div>
                            <p class="text-xs text-muted-foreground">@resource.Description</p>
                        </div>
                        <div class="flex shrink-0 items-center gap-4">
                            @foreach (var perm in new[] { "view", "edit", "delete", "admin" })
                            {
                                var permKey = perm;
                                <div class="flex w-8 items-center justify-center">
                                    <CheckboxCn Checked="@resource.GetPermission(permKey)"
                                                Disabled="@(resource.Inherited || _selectedRole == "owner")"
                                                CheckedChanged="@((bool _) => TogglePermission(resource.Id, permKey))" />
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (_selectedRole == "owner")
            {
                <div class="bg-muted/50 px-4 py-3">
                    <div class="flex items-start gap-3">
                        <LucideTriangleAlertCn Class="mt-0.5 h-4 w-4 shrink-0 text-amber-600" Size="16" />
                        <div>
                            <p class="text-sm font-medium text-amber-900">Owner permissions cannot be modified</p>
                            <p class="text-xs text-amber-700">The Owner role has full access to all resources by default. To restrict access, assign a different role.</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-b">
            <div class="flex items-center justify-between border-b bg-muted/50 px-4 py-2">
                <p class="text-xs font-medium text-muted-foreground">Recent Changes</p>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                    View All
                    <LucideChevronRightCn Class="ml-1 h-3.5 w-3.5" Size="14" />
                </ButtonCn>
            </div>
            @foreach (var change in _recentChanges)
            {
                <div class="flex items-center gap-3 border-b px-4 py-3 last:border-0">
                    @if (change.Type == "add")
                    {
                        <LucidePlusCn Class="h-4 w-4 shrink-0 text-emerald-600" Size="16" />
                    }
                    else if (change.Type == "remove")
                    {
                        <LucideXCn Class="h-4 w-4 shrink-0 text-red-600" Size="16" />
                    }
                    else
                    {
                        <LucideCrownCn Class="h-4 w-4 shrink-0 text-muted-foreground" Size="16" />
                    }
                    <div class="min-w-0 flex-1">
                        <p class="text-sm">
                            <span class="font-medium">@change.Action</span> for
                            <span class="font-medium">@change.Resource</span>
                            @if (change.Role != "\u2014")
                            {
                                <text> on </text>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px]">@change.Role</BadgeCn>
                            }
                        </p>
                        <p class="text-xs text-muted-foreground">by @change.User &middot; @change.Time</p>
                    </div>
                </div>
            }
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="w-full gap-2" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                <LucidePlusCn Class="h-4 w-4" Size="16" />
                Create Role
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private class Permission
    {
        public bool View { get; set; }
        public bool Edit { get; set; }
        public bool Delete { get; set; }
        public bool Admin { get; set; }

        public bool GetPermission(string key) => key switch
        {
            "view" => View,
            "edit" => Edit,
            "delete" => Delete,
            "admin" => Admin,
            _ => false,
        };

        public void SetPermission(string key, bool value)
        {
            switch (key)
            {
                case "view": View = value; break;
                case "edit": Edit = value; break;
                case "delete": Delete = value; break;
                case "admin": Admin = value; break;
            }
        }
    }

    private class Resource
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string Icon { get; set; } = "";
        public Permission Permissions { get; set; } = new();
        public bool Inherited { get; set; }

        public bool GetPermission(string key) => Permissions.GetPermission(key);
    }

    private record Role(string Id, string Name, string Description, int MemberCount, bool IsSystem);
    private record AuditChange(string Action, string Resource, string Role, string User, string Time, string Type);

    private string _selectedRole = "admin";

    private int TotalPermissions => _resources.Sum(r =>
        (r.Permissions.View ? 1 : 0) + (r.Permissions.Edit ? 1 : 0) +
        (r.Permissions.Delete ? 1 : 0) + (r.Permissions.Admin ? 1 : 0));

    private static readonly Role[] _roles =
    [
        new("admin", "Admin", "Manage team and settings", 3, true),
        new("member", "Member", "Standard team access", 12, true),
        new("guest", "Guest", "Limited read-only access", 4, false),
    ];

    private readonly List<Resource> _resources =
    [
        new() { Id = "users", Name = "Team Members", Description = "Manage team and invitations", Icon = "users", Permissions = new() { View = true, Edit = true, Delete = true, Admin = true } },
        new() { Id = "projects", Name = "Projects", Description = "Access and manage projects", Icon = "projects", Permissions = new() { View = true, Edit = true, Delete = true, Admin = true } },
        new() { Id = "billing", Name = "Billing & Payments", Description = "View invoices and manage payments", Icon = "billing", Permissions = new() { View = true, Edit = true, Delete = false, Admin = true } },
    ];

    private static readonly AuditChange[] _recentChanges =
    [
        new("Added delete permission", "Projects", "Manager", "Sarah Chen", "2 hours ago", "add"),
        new("Removed admin access", "Billing", "Member", "John Smith", "1 day ago", "remove"),
        new("Created custom role", "Guest", "\u2014", "Sarah Chen", "3 days ago", "create"),
    ];

    private void TogglePermission(string resourceId, string permissionType)
    {
        var resource = _resources.FirstOrDefault(r => r.Id == resourceId);
        if (resource != null && !resource.Inherited)
        {
            resource.Permissions.SetPermission(permissionType, !resource.GetPermission(permissionType));
        }
    }
}
