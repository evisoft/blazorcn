@* ============================================================
   Block: account-beta-programs
   Title: AccountBetaPrograms
   Description: A beta feature opt-in management panel for React and Next.js with feature cards, stage badges, risk indicators, enrollment toggles, and participant counts built with shadcn/ui and Tailwind CSS
   Source: original/blocks/account/account-beta-programs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Beta Programs</h2>
                    <p class="text-xs text-muted-foreground">
                        Opt in to upcoming features before general release
                    </p>
                </div>
                <div class="flex items-center gap-3 text-xs text-muted-foreground">
                    <span class="tabular-nums">
                        @EnrolledCount of @_programs.Count enrolled
                    </span>
                </div>
            </div>
        </div>

        @* Program Cards *@
        <div class="space-y-3 p-4">
            @foreach (var program in _programs)
            {
                    var stage = _stageConfig[program.Stage];
                    var risk = _riskConfig[program.RiskLevel];
                    int? spotsLeft = program.MaxParticipants.HasValue
                        ? program.MaxParticipants.Value - program.Participants
                        : (int?)null;
                <div class="rounded-md border border-l-2 @(stage.BorderColor) p-3 transition-colors hover:bg-muted/30">
                    @* Card Header *@
                    <div class="mb-2 flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="mb-1 flex flex-wrap items-center gap-2">
                                <LucideIconCn Name="@stage.IconName" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                                <span class="text-sm font-medium">@program.Name</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px]">
                                    @stage.Label
                                </BadgeCn>
                                <span class="flex items-center gap-1 text-[10px] text-muted-foreground">
                                    <span class="inline-block size-1.5 rounded-full @(risk.DotColor)"></span>
                                    @risk.Label
                                </span>
                            </div>
                            <p class="text-xs leading-relaxed text-muted-foreground">
                                @program.Description
                            </p>
                        </div>
                        <SwitchCn aria-label="@program.Name" Checked="@program.Enrolled" CheckedChanged="@(_ => HandleToggle(program.Id))" Class="shrink-0" />
                    </div>

                    @* Card Footer *@
                    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[10px] text-muted-foreground">
                        <span class="flex items-center gap-1">
                            <LucideIconCn Name="users" Size="12" Class="h-3 w-3" />
                            @program.Participants.ToString("N0") participants
                        </span>
                        @if (spotsLeft.HasValue && spotsLeft.Value > 0)
                        {
                            <span class="@(spotsLeft.Value < 50 ? "text-amber-600" : "")">
                                @spotsLeft.Value spots left
                            </span>
                        }
                        @if (program.EnrolledSince is not null)
                        {
                            <span>Enrolled @program.EnrolledSince</span>
                        }
                        @if (program.Changelog.Length > 0)
                        {
                            <span class="font-mono">
                                v@(program.Changelog[0].Version): @program.Changelog[0].Note
                            </span>
                        }
                        @if (program.Enrolled)
                        {
                            <a href="@program.FeedbackUrl" class="ml-auto inline-flex items-center gap-1 h-5 px-1.5 text-[10px] text-muted-foreground rounded-md hover:bg-accent hover:text-accent-foreground transition-colors">
                                <LucideIconCn Name="external-link" Size="10" Class="h-2.5 w-2.5" />
                                Feedback
                            </a>
                        }
                    </div>

                    @* Risk Warning for High Risk *@
                    @if (program.RiskLevel == "high" && !program.Enrolled)
                    {
                        <div class="mt-2 flex items-start gap-1.5 rounded bg-muted/50 px-2 py-1.5">
                            <LucideIconCn Name="alert-triangle" Size="12" Class="mt-0.5 h-3 w-3 shrink-0 text-amber-600" />
                            <p class="text-[10px] text-muted-foreground">
                                This program may cause breaking changes. We recommend testing in a staging
                                environment first.
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <p class="text-[10px] text-muted-foreground">
                Beta features may change without notice. Enrollment preferences are synced across all
                your workspaces.
            </p>
        </div>
    </div>
</section>

@code {
    private record ChangelogEntry(string Version, string Note);
    private record StageConfig(string Label, string BorderColor, string IconName);
    private record RiskConfig(string Label, string DotColor);

    private class BetaProgram
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string Stage { get; set; } = "";
        public string RiskLevel { get; set; } = "";
        public bool Enrolled { get; set; }
        public string? EnrolledSince { get; set; }
        public int Participants { get; set; }
        public int? MaxParticipants { get; set; }
        public ChangelogEntry[] Changelog { get; set; } = [];
        public string FeedbackUrl { get; set; } = "#";
    }

    private static readonly Dictionary<string, StageConfig> _stageConfig = new()
    {
        ["alpha"] = new("Alpha", "border-l-blue-500", "flask-conical"),
        ["beta"] = new("Beta", "border-l-amber-500", "beaker"),
        ["ga"] = new("GA Preview", "border-l-emerald-500", "rocket"),
    };

    private static readonly Dictionary<string, RiskConfig> _riskConfig = new()
    {
        ["low"] = new("Low risk", "bg-emerald-500"),
        ["medium"] = new("Medium risk", "bg-amber-500"),
        ["high"] = new("High risk", "bg-red-500"),
    };

    private List<BetaProgram> _programs =
    [
        new()
        {
            Id = "edge-functions-v2",
            Name = "Edge Functions v2",
            Description = "Next-generation serverless runtime with WebAssembly support, 10x cold start improvement, and streaming response bodies. Replaces current Edge Runtime.",
            Stage = "alpha",
            RiskLevel = "high",
            Enrolled = false,
            EnrolledSince = null,
            Participants = 342,
            MaxParticipants = 500,
            Changelog = [new("0.3.0", "Added WASM module support"), new("0.2.1", "Fixed streaming timeout issue")],
            FeedbackUrl = "#",
        },
        new()
        {
            Id = "collaborative-editing",
            Name = "Real-time Collaborative Editing",
            Description = "Multiplayer document editing with operational transforms, presence cursors, and conflict-free merge. Currently supports Markdown and JSON files.",
            Stage = "beta",
            RiskLevel = "medium",
            Enrolled = true,
            EnrolledSince = "Feb 14, 2026",
            Participants = 2847,
            MaxParticipants = null,
            Changelog = [new("1.2.0", "Added presence indicators"), new("1.1.0", "Conflict resolution improvements")],
            FeedbackUrl = "#",
        },
        new()
        {
            Id = "ai-code-review",
            Name = "AI-Assisted Code Review",
            Description = "Automated pull request analysis using LLM-powered review agents. Catches security vulnerabilities, performance regressions, and style inconsistencies before human review.",
            Stage = "beta",
            RiskLevel = "low",
            Enrolled = true,
            EnrolledSince = "Jan 8, 2026",
            Participants = 5621,
            MaxParticipants = null,
            Changelog = [new("2.0.0", "Upgraded to Claude model"), new("1.4.2", "Reduced false positive rate by 40%")],
            FeedbackUrl = "#",
        },
        new()
        {
            Id = "usage-based-billing",
            Name = "Usage-Based Billing",
            Description = "Pay-per-use pricing model with real-time metering for compute, bandwidth, and storage. Includes detailed cost breakdown dashboards and budget alerts.",
            Stage = "ga",
            RiskLevel = "low",
            Enrolled = false,
            EnrolledSince = null,
            Participants = 12340,
            MaxParticipants = null,
            Changelog = [new("3.1.0", "Added budget alert thresholds"), new("3.0.0", "General availability release")],
            FeedbackUrl = "#",
        },
        new()
        {
            Id = "git-backed-cms",
            Name = "Git-Backed Content Management",
            Description = "Headless CMS with content stored as Markdown in your repository. Visual editor syncs with git branches, supports draft previews, and auto-generates PRs for content changes.",
            Stage = "alpha",
            RiskLevel = "medium",
            Enrolled = false,
            EnrolledSince = null,
            Participants = 189,
            MaxParticipants = 300,
            Changelog = [new("0.1.2", "Branch-based draft previews"), new("0.1.0", "Initial alpha release")],
            FeedbackUrl = "#",
        },
    ];

    private int EnrolledCount => _programs.Count(p => p.Enrolled);

    private void HandleToggle(string id)
    {
        var program = _programs.FirstOrDefault(p => p.Id == id);
        if (program is null) return;
        program.Enrolled = !program.Enrolled;
        program.EnrolledSince = program.Enrolled ? "Apr 5, 2026" : null;
    }
}
