@* ============================================================
   Block: account-notifications
   Title: Account Notifications
   Description: Notification preferences panel with toggles for email notifications, push notifications, and communication settings organized by category
   Long Description: Notification preferences
   Dependencies: BadgeCn, ButtonCn, SwitchCn, LucideBellCn, LucideBellRingCn, LucideMailCn
   Source: original/blocks/account/account-notifications.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <LucideBellRingCn Size="20" Class="text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Notification Preferences</h2>
                        <p class="text-xs text-muted-foreground">
                            Choose what notifications you receive and how
                        </p>
                    </div>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] h-4 px-1.5">
                    @EnabledCount of @TotalCount enabled
                </BadgeCn>
            </div>
        </div>

        <div class="p-4 space-y-4">
            <div class="flex items-center justify-end gap-4 pb-2 border-b">
                <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <LucideMailCn Size="14" />
                    <span>Email</span>
                </div>
                <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <LucideBellCn Size="14" />
                    <span>Push</span>
                </div>
            </div>

            @foreach (var category in _categories)
            {
                <div class="space-y-2">
                    <span class="text-xs font-medium text-muted-foreground uppercase">
                        @category.Title
                    </span>

                    <div class="rounded-md border divide-y">
                        @foreach (var item in category.Items)
                        {
                            <div class="flex items-center justify-between px-3 py-3">
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium">@item.Label</p>
                                    <p class="text-xs text-muted-foreground">@item.Description</p>
                                </div>
                                <div class="flex items-center gap-4 shrink-0">
                                    <SwitchCn aria-label="@($"{item.Label} email notifications")" Checked="item.Email" CheckedChanged="@(v => {})" />
                                    <SwitchCn aria-label="@($"{item.Label} push notifications")" Checked="item.Push" Disabled="item.PushDisabled" CheckedChanged="@(v => {})" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="flex items-center justify-end gap-2 pt-2 border-t">
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                    Cancel
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="min-w-[120px]">
                    Save Preferences
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record NotificationItem(string Key, string Label, string Description, bool Email, bool Push, bool PushDisabled = false);
    private record NotificationCategory(string Id, string Title, NotificationItem[] Items);

    private int EnabledCount => _categories.SelectMany(c => c.Items).Sum(i => (i.Email ? 1 : 0) + (i.Push ? 1 : 0));
    private int TotalCount => _categories.SelectMany(c => c.Items).Count() * 2;

    private static readonly NotificationCategory[] _categories =
    [
        new("activity", "Activity Notifications",
        [
            new("comments", "Comments", "Someone comments on your posts", true, true),
            new("mentions", "Mentions", "Someone mentions you in a post or comment", true, true),
            new("follows", "New Followers", "Someone starts following you", false, true),
            new("likes", "Likes", "Someone likes your post or comment", false, false),
        ]),
        new("orders", "Orders & Purchases",
        [
            new("purchases", "Order Confirmations", "Confirmation emails for your orders", true, true),
            new("shipments", "Shipping Updates", "Tracking and delivery notifications", true, true),
            new("payments", "Payment Receipts", "Receipts and billing information", true, false),
        ]),
        new("marketing", "Marketing & Updates",
        [
            new("newsletter", "Newsletter", "Weekly newsletter with updates and tips", false, false, true),
            new("productUpdates", "Product Updates", "New features and improvements", true, false),
            new("tips", "Tips & Tutorials", "Helpful guides to get the most out of our platform", false, false),
        ]),
    ];
}
