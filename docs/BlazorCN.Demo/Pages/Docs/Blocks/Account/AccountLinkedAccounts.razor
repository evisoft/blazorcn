@* ============================================================
   Block: account-linked-accounts
   Title: AccountLinkedAccounts
   Description: A linked accounts management card for React and Next.js with provider icons, sync status indicators, primary account badge, unlink confirmation, and link new account section built with shadcn/ui and Tailwind CSS
   Source: original/blocks/account/account-linked-accounts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Linked Accounts</h2>
                    <p class="text-xs text-muted-foreground">
                        Manage your connected identity providers
                    </p>
                </div>
                <div class="flex items-center gap-3 text-xs text-muted-foreground">
                    <span class="flex items-center gap-1">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        @SyncedCount synced
                    </span>
                    @if (ErrorCount > 0)
                    {
                        <span class="flex items-center gap-1 text-red-600">
                            <span class="size-1.5 rounded-full bg-red-500"></span>
                            @ErrorCount error
                        </span>
                    }
                </div>
            </div>
        </div>

        @* Primary Account *@
        @if (PrimaryAccount is { } primary)
        {
            <div class="border-b bg-muted/20 px-4 py-3">
                <div class="mb-2 flex items-center gap-1.5">
                    <LucideIconCn Name="shield" Size="12" Class="h-3 w-3 text-muted-foreground" />
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Primary Account
                    </span>
                </div>
                <div class="flex items-center gap-3">
                    <div class="@Cn.Merge("flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-xs font-semibold text-white", primary.ProviderColor)">
                        @primary.ProviderInitial
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@primary.Provider</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px]">
                                Primary
                            </BadgeCn>
                        </div>
                        <div class="flex items-center gap-2 text-xs text-muted-foreground">
                            <span>@primary.Email</span>
                            <span>&middot;</span>
                            <span>@@@(primary.Username)</span>
                        </div>
                    </div>
                    <div class="text-right">
                        @{
                            var primaryStatus = GetSyncStatus(primary.SyncStatus);
                        }
                        <div class="flex items-center gap-1 text-xs">
                            <span class="@Cn.Merge("size-1.5 rounded-full", primaryStatus.DotClass)"></span>
                            <span class="@primaryStatus.TextClass">@primaryStatus.Label</span>
                        </div>
                        <p class="text-[10px] text-muted-foreground">
                            Linked @primary.LinkedDate
                        </p>
                    </div>
                </div>
            </div>
        }

        @* Secondary Accounts *@
        <div>
            @foreach (var account in _accounts.Where(a => !a.IsPrimary))
            {
                var status = GetSyncStatus(account.SyncStatus);
                <div class="border-b last:border-b-0">
                    <div class="flex items-center gap-3 px-4 py-3">
                        <div class="@Cn.Merge("flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-[10px] font-semibold text-white", account.ProviderColor)">
                            @account.ProviderInitial
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@account.Provider</span>
                                <div class="flex items-center gap-1">
                                    <span class="@Cn.Merge("size-1.5 rounded-full", status.DotClass)"></span>
                                    <span class="@Cn.Merge("text-[10px]", status.TextClass)">@status.Label</span>
                                </div>
                            </div>
                            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                                <span>@account.Email</span>
                                <span>&middot;</span>
                                <span>Linked @account.LinkedDate</span>
                            </div>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                  Class="h-7 gap-1 text-xs text-muted-foreground hover:text-destructive"
                                  OnClick="@(() => HandleUnlinkClick(account))">
                            <LucideIconCn Name="trash-2" Size="12" Class="h-3 w-3" />
                            Unlink
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

        @* Link New Account *@
        <div class="border-t bg-muted/10 px-4 py-3">
            <div class="mb-2.5 flex items-center gap-1.5">
                <LucideIconCn Name="link" Size="12" Class="h-3 w-3 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Link New Account
                </span>
            </div>
            <div class="grid grid-cols-3 gap-2">
                @foreach (var provider in _availableProviders)
                {
                    var alreadyLinked = IsProviderLinked(provider.Name);
                    <button type="button"
                            disabled="@(alreadyLinked ? "disabled" : null)"
                            @onclick="@(() => HandleLinkProvider(provider.Name))"
                            class="@Cn.Merge("flex items-center gap-2.5 rounded-md border px-3 py-2 text-left transition-colors", alreadyLinked ? "cursor-not-allowed border-transparent bg-muted/30 opacity-50" : "border-transparent bg-muted/30 hover:bg-muted/60")">
                        <div class="@Cn.Merge("flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-[9px] font-semibold text-white", provider.Color)">
                            @provider.Initial
                        </div>
                        <div class="min-w-0">
                            <span class="block text-xs font-medium leading-tight">@provider.Name</span>
                            <span class="block text-[10px] leading-tight text-muted-foreground">
                                @(alreadyLinked ? "Linked" : provider.Description)
                            </span>
                        </div>
                        @if (!alreadyLinked)
                        {
                            <LucideIconCn Name="external-link" Size="12" Class="ml-auto h-3 w-3 shrink-0 text-muted-foreground" />
                        }
                    </button>
                }
            </div>
        </div>
    </div>

    @* Unlink Confirmation Dialog *@
    <DialogCn @bind-Open="_unlinkConfirmOpen">
        <DialogContentCn Class="sm:max-w-md">
            <DialogHeaderCn>
                <DialogTitleCn Class="flex items-center gap-2 text-sm font-medium">
                    <LucideIconCn Name="triangle-alert" Size="16" Class="h-4 w-4 text-amber-500" />
                    Unlink @(_unlinkTarget?.Provider)?
                </DialogTitleCn>
                <DialogDescriptionCn Class="text-xs">
                    This will disconnect <span class="font-medium text-foreground">@_unlinkTarget?.Email</span> from your
                    account. You can re-link it later, but any provider-specific data may need to be
                    re-synced.
                </DialogDescriptionCn>
            </DialogHeaderCn>
            <DialogFooterCn Class="gap-2 sm:gap-0">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="@(() => _unlinkConfirmOpen = false)">
                    Cancel
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Destructive" Size="ButtonSize.Sm" OnClick="HandleConfirmUnlink">
                    <LucideIconCn Name="trash-2" Size="12" Class="mr-1.5 h-3 w-3" />
                    Unlink account
                </ButtonCn>
            </DialogFooterCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private class LinkedAccount
    {
        public string Id { get; set; } = "";
        public string Provider { get; set; } = "";
        public string ProviderInitial { get; set; } = "";
        public string ProviderColor { get; set; } = "";
        public string Email { get; set; } = "";
        public string Username { get; set; } = "";
        public string LinkedDate { get; set; } = "";
        public bool IsPrimary { get; set; }
        public string SyncStatus { get; set; } = "";
        public string LastSynced { get; set; } = "";
    }

    private record AvailableProvider(string Name, string Initial, string Color, string Description);

    private record SyncStatusInfo(string Label, string DotClass, string TextClass);

    private List<LinkedAccount> _accounts =
    [
        new() { Id = "1", Provider = "Google", ProviderInitial = "G", ProviderColor = "bg-blue-500", Email = "sarah.chen@gmail.com", Username = "sarah.chen", LinkedDate = "Jan 15, 2024", IsPrimary = true, SyncStatus = "synced", LastSynced = "Just now" },
        new() { Id = "2", Provider = "GitHub", ProviderInitial = "GH", ProviderColor = "bg-neutral-800 dark:bg-neutral-200 dark:text-neutral-900", Email = "sarahc@github.com", Username = "sarahchen-dev", LinkedDate = "Mar 2, 2024", IsPrimary = false, SyncStatus = "synced", LastSynced = "2 hours ago" },
        new() { Id = "3", Provider = "Microsoft", ProviderInitial = "M", ProviderColor = "bg-emerald-600", Email = "sarah.chen@outlook.com", Username = "sarah.chen", LinkedDate = "Aug 19, 2025", IsPrimary = false, SyncStatus = "pending", LastSynced = "Syncing..." },
        new() { Id = "4", Provider = "Apple", ProviderInitial = "A", ProviderColor = "bg-neutral-500", Email = "sarah.c@icloud.com", Username = "sarah.c", LinkedDate = "Dec 4, 2025", IsPrimary = false, SyncStatus = "error", LastSynced = "Failed 3 hours ago" },
    ];

    private static readonly AvailableProvider[] _availableProviders =
    [
        new("Slack", "S", "bg-purple-600", "Workspace messaging"),
        new("GitLab", "GL", "bg-orange-500", "Code repositories"),
        new("Notion", "N", "bg-neutral-800 dark:bg-neutral-200 dark:text-neutral-900", "Notes & docs"),
    ];

    private LinkedAccount? _unlinkTarget;
    private bool _unlinkConfirmOpen;

    private LinkedAccount? PrimaryAccount => _accounts.FirstOrDefault(a => a.IsPrimary);
    private int SyncedCount => _accounts.Count(a => a.SyncStatus == "synced");
    private int ErrorCount => _accounts.Count(a => a.SyncStatus == "error");

    private static SyncStatusInfo GetSyncStatus(string status) => status switch
    {
        "synced"  => new("Synced", "bg-emerald-500", "text-emerald-600"),
        "pending" => new("Syncing", "bg-amber-500", "text-amber-600"),
        "error"   => new("Error", "bg-red-500", "text-red-600"),
        _         => new("Unknown", "bg-gray-500", "text-gray-600"),
    };

    private void HandleUnlinkClick(LinkedAccount account)
    {
        _unlinkTarget = account;
        _unlinkConfirmOpen = true;
    }

    private void HandleConfirmUnlink()
    {
        if (_unlinkTarget is not null)
            _accounts.RemoveAll(a => a.Id == _unlinkTarget.Id);
        _unlinkConfirmOpen = false;
        _unlinkTarget = null;
    }

    private void HandleLinkProvider(string providerName)
    {
        var provider = _availableProviders.FirstOrDefault(p => p.Name == providerName);
        if (provider is null) return;
        _accounts.Add(new LinkedAccount
        {
            Id = $"new-{providerName.ToLower()}",
            Provider = provider.Name,
            ProviderInitial = provider.Initial,
            ProviderColor = provider.Color,
            Email = $"sarah@{providerName.ToLower()}.com",
            Username = "sarah.chen",
            LinkedDate = "Apr 5, 2026",
            IsPrimary = false,
            SyncStatus = "pending",
            LastSynced = "Syncing...",
        });
    }

    private bool IsProviderLinked(string name) =>
        _accounts.Any(a => a.Provider.Equals(name, StringComparison.OrdinalIgnoreCase));
}
