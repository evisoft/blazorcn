@* ============================================================
   Block: account-bookings
   Title: Account Bookings
   Description: Bookings and appointments dashboard with upcoming reservations, booking history, calendar view, reschedule options, and cancellation management for service businesses
   Long Description: Bookings and appointments management
   Dependencies: BadgeCn, ButtonCn, TabsCn, TabsContentCn, TabsListCn, TabsTriggerCn, LucideCalendarCn, LucideChevronRightCn, LucideClockCn, LucideEllipsisCn, LucideMapPinCn, LucidePhoneCn, LucideVideoCn
   Source: original/blocks/account/account-bookings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">My Bookings</h2>
            <p class="text-muted-foreground text-xs">Manage your appointments and reservations</p>
        </div>

        <div class="border-b bg-muted/50 px-4 py-3">
            <div class="flex items-center gap-3">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium">Next: @_bookings[0].Service</p>
                    <p class="text-muted-foreground text-xs">
                        @_bookings[0].Date at @_bookings[0].Time with @_bookings[0].Provider
                    </p>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                    View
                    <LucideChevronRightCn Size="16" Class="ml-1 text-muted-foreground" />
                </ButtonCn>
            </div>
        </div>

        <div class="px-4 py-3">
            <TabsCn DefaultValue="upcoming">
                <TabsListCn Class="mb-4">
                    <TabsTriggerCn Value="upcoming" Class="gap-1.5">
                        Upcoming
                        <BadgeCn Class="ml-1.5 h-4 px-1.5 text-xs" Variant="BadgeVariant.Secondary">
                            @(_bookings.Count(b => b.Status != "cancelled"))
                        </BadgeCn>
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="past">Past</TabsTriggerCn>
                </TabsListCn>

                <TabsContentCn Value="upcoming">
                    <div class="space-y-3">
                        @foreach (var booking in _bookings)
                        {
                            var dotClass = GetStatusDot(booking.Status);
                            var statusLabel = GetStatusLabel(booking.Status);

                            <div class="rounded-md border px-4 py-3 transition-colors hover:bg-muted/50">
                                <div class="flex items-start gap-3">
                                    <span class="@($"mt-1 size-1.5 shrink-0 rounded-full @dotClass")"></span>
                                    <div class="min-w-0 flex-1">
                                        <div class="mb-1 flex items-center gap-2">
                                            <p class="text-sm font-medium">@booking.Service</p>
                                            <BadgeCn Class="h-4 px-1.5 text-xs" Variant="BadgeVariant.Secondary">
                                                @statusLabel
                                            </BadgeCn>
                                        </div>

                                        <div class="mb-2 flex items-center gap-2 text-muted-foreground text-xs">
                                            <span>@booking.Provider</span>
                                            <span class="text-muted-foreground/40">&bull;</span>
                                            <span>@booking.ProviderTitle</span>
                                        </div>

                                        <div class="flex items-center gap-4 text-muted-foreground text-xs">
                                            <div class="flex items-center gap-1.5">
                                                <LucideClockCn Size="16" />
                                                <span>@booking.Time (@booking.Duration)</span>
                                            </div>
                                            <div class="flex items-center gap-1.5">
                                                @switch (booking.LocationType)
                                                {
                                                    case "video":
                                                        <LucideVideoCn Size="16" />
                                                        break;
                                                    case "phone":
                                                        <LucidePhoneCn Size="16" />
                                                        break;
                                                    default:
                                                        <LucideMapPinCn Size="16" />
                                                        break;
                                                }
                                                <span>@booking.Location</span>
                                            </div>
                                        </div>
                                    </div>

                                    <ButtonCn Class="size-9 shrink-0" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="More options">
                                        <LucideEllipsisCn Size="16" />
                                    </ButtonCn>
                                </div>
                            </div>
                        }
                    </div>
                </TabsContentCn>

                <TabsContentCn Value="past">
                    <div class="space-y-3">
                        @foreach (var booking in _pastBookings)
                        {
                            var dotClass = GetStatusDot(booking.Status);
                            var statusLabel = GetStatusLabel(booking.Status);

                            <div class="flex items-center gap-3 rounded-md border px-4 py-3 transition-colors hover:bg-muted/50">
                                <span class="@($"size-1.5 shrink-0 rounded-full @dotClass")"></span>

                                <div class="min-w-0 flex-1">
                                    <p class="text-sm font-medium">@booking.Service</p>
                                    <div class="flex items-center gap-2 text-muted-foreground text-xs">
                                        <span>@booking.Provider</span>
                                        <span class="text-muted-foreground/40">&bull;</span>
                                        <span>@booking.Date</span>
                                    </div>
                                </div>

                                <div class="shrink-0 text-right">
                                    <p class="text-sm font-medium">@booking.Price</p>
                                    <BadgeCn Class="h-4 px-1.5 text-xs" Variant="BadgeVariant.Secondary">
                                        @statusLabel
                                    </BadgeCn>
                                </div>

                                <ButtonCn Class="shrink-0 gap-1.5" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                                    Book Again
                                    <LucideChevronRightCn Size="16" />
                                </ButtonCn>
                            </div>
                        }
                    </div>
                </TabsContentCn>
            </TabsCn>
        </div>
    </div>
</section>

@code {
    private record Booking(string Id, string Service, string Provider, string ProviderTitle, string Location, string LocationType, string Date, string Time, string Duration, string Status, string Price);

    private static readonly Booking[] _bookings =
    [
        new("1", "Annual Health Checkup", "Dr. Sarah Chen", "Primary Care Physician", "Downtown Medical Center, Suite 302", "in-person", "Dec 15, 2024", "10:30 AM", "45 min", "confirmed", "$150.00"),
        new("2", "Hair Styling & Color", "Maria Rodriguez", "Senior Stylist", "Luxe Hair Studio", "in-person", "Dec 18, 2024", "2:00 PM", "2 hours", "confirmed", "$180.00"),
        new("3", "Financial Planning Consultation", "James Wilson", "Certified Financial Planner", "Video Call", "video", "Dec 20, 2024", "3:30 PM", "1 hour", "pending", "$200.00"),
    ];

    private static readonly Booking[] _pastBookings =
    [
        new("5", "Dental Cleaning", "Dr. Emily Park", "Dentist", "Smile Dental Clinic", "in-person", "Nov 28, 2024", "9:00 AM", "30 min", "completed", "$120.00"),
        new("6", "Therapy Session", "Dr. Lisa Morgan", "Licensed Therapist", "Phone Call", "phone", "Nov 20, 2024", "4:00 PM", "50 min", "completed", "$175.00"),
        new("7", "Car Service Appointment", "AutoCare Plus", "Service Center", "123 Auto Lane", "in-person", "Nov 10, 2024", "8:00 AM", "3 hours", "completed", "$450.00"),
    ];

    private static string GetStatusDot(string status) => status switch
    {
        "confirmed" => "bg-emerald-500",
        "pending" => "bg-amber-500",
        "completed" => "bg-blue-500",
        "cancelled" => "bg-red-500",
        _ => "bg-muted-foreground",
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "confirmed" => "Confirmed",
        "pending" => "Pending",
        "completed" => "Completed",
        "cancelled" => "Cancelled",
        "no-show" => "No Show",
        _ => status,
    };
}
