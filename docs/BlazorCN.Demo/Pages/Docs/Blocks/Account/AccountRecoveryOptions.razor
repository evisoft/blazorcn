@* ============================================================
   Block: account-recovery-options
   Title: AccountRecoveryOptions
   Description: An account recovery methods checklist block for React and Next.js with email, phone, security key, and trusted contact configuration, verification status, and recovery testing built with shadcn/ui and Tailwind CSS
   Source: original/blocks/account/account-recovery-options.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Recovery Options</h2>
                    <p class="text-xs text-muted-foreground">
                        Methods to regain access if you're locked out
                    </p>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="@Cn.Merge("size-1.5 rounded-full", ConfiguredCount >= 2 ? "bg-emerald-500" : ConfiguredCount == 1 ? "bg-amber-500" : "bg-red-500")"></span>
                    <span class="text-xs text-muted-foreground tabular-nums">
                        @ConfiguredCount of @_methods.Count active
                    </span>
                </div>
            </div>
        </div>

        @* Warning banner *@
        @if (IsVulnerable)
        {
            <div class="overflow-hidden">
                <div class="flex items-start gap-2.5 border-b bg-amber-500/5 px-4 py-2.5">
                    <LucideIconCn Name="alert-triangle" Size="14" Class="mt-0.5 h-3.5 w-3.5 shrink-0 text-amber-500" />
                    <div>
                        <p class="text-xs font-medium text-amber-700 dark:text-amber-400">
                            Your account recovery is vulnerable
                        </p>
                        <p class="mt-0.5 text-[10px] text-amber-600/80 dark:text-amber-400/70">
                            Configure at least 2 recovery methods to protect against account lockout. You
                            currently have @ConfiguredCount.
                        </p>
                    </div>
                </div>
            </div>
        }

        @* Recovery methods *@
        <div>
            @{
                var sortedMethods = SortedMethods.ToList();
            }
            @for (int idx = 0; idx < sortedMethods.Count; idx++)
            {
                var method = sortedMethods[idx];
                var display = GetStatusDisplay(method.Status);
                var isConfigured = method.Status == "configured";
                var isExpired = method.Status == "expired";
                var isLast = idx == sortedMethods.Count - 1;

                <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3", !isLast ? "border-b" : "")">
                    @* Priority + icon *@
                    <div class="flex flex-col items-center gap-1.5 pt-0.5">
                        <span class="text-[10px] font-medium tabular-nums text-muted-foreground/50">
                            @method.Priority
                        </span>
                        <div class="@Cn.Merge("flex h-8 w-8 items-center justify-center rounded-md", isConfigured ? "bg-foreground/5 text-foreground" : "bg-muted/50 text-muted-foreground/50")">
                            <LucideIconCn Name="@GetMethodIconName(method.Type)" Size="16" Class="h-4 w-4" />
                        </div>
                    </div>

                    @* Details *@
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@method.Label</span>
                            <span class="size-1.5 rounded-full @display.Dot"></span>
                            <span class="text-[10px] @display.Text">@display.Label</span>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">@method.Description</p>

                        @* Configured details *@
                        @if (method.MaskedValue != null)
                        {
                            <div class="mt-1.5 flex items-center gap-3">
                                <span class="font-mono text-xs text-muted-foreground">
                                    @method.MaskedValue
                                </span>
                                @if (method.LastVerified != null)
                                {
                                    <span class="text-muted-foreground/20">|</span>
                                    <span class="@Cn.Merge("text-[10px]", isExpired ? "text-amber-600" : "text-muted-foreground")">
                                        @(isExpired ? "Last verified" : "Verified") @method.LastVerified
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    @* Action *@
                    <div class="shrink-0 pt-0.5">
                        @if (isConfigured)
                        {
                            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 text-xs text-muted-foreground">
                                Update
                            </ButtonCn>
                        }
                        else
                        {
                            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs"
                                      OnClick="@(() => HandleConfigure(method.Id))">
                                Configure
                            </ButtonCn>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <div class="flex items-center gap-1.5">
                @if (ConfiguredCount >= 2)
                {
                    <LucideIconCn Name="check-circle-2" Size="14" Class="h-3.5 w-3.5 text-emerald-500" />
                    <span class="text-xs text-muted-foreground">Recovery protection is active</span>
                }
                else
                {
                    <span class="text-xs text-muted-foreground">
                        Add more methods to improve account security
                    </span>
                }
            </div>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="gap-1.5 text-xs"
                      OnClick="HandleTestRecovery"
                      Disabled="@(_testingRecovery || ConfiguredCount == 0)">
                @if (_testingRecovery)
                {
                    <LucideIconCn Name="loader-2" Size="12" Class="h-3 w-3 animate-spin" />
                    <text>Testing...</text>
                }
                else if (_testComplete)
                {
                    <LucideIconCn Name="check-circle-2" Size="12" Class="h-3 w-3 text-emerald-500" />
                    <text>All methods verified</text>
                }
                else
                {
                    <text>Test Recovery</text>
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record RecoveryMethod(
        string Id,
        string Type,
        string Label,
        string Description,
        string Status,
        string? MaskedValue,
        string? LastVerified,
        int Priority
    );

    private record StatusDisplay(string Label, string Dot, string Text);

    private List<RecoveryMethod> _methods =
    [
        new("m1", "email", "Recovery Email", "Receive a recovery link at an alternate email address", "configured", "e****a@gmail.com", "Mar 12, 2026", 1),
        new("m2", "phone", "Phone Number", "Receive a verification code via SMS", "configured", "+1 (***) ***-4821", "Feb 28, 2026", 2),
        new("m3", "security_key", "Security Key", "Use a FIDO2 hardware key to verify your identity", "not_configured", null, null, 3),
        new("m4", "trusted_contact", "Trusted Contact", "A verified person who can help you regain access", "expired", "Marcus W.", "Oct 15, 2025", 4),
    ];

    private bool _testingRecovery;
    private bool _testComplete;

    private int ConfiguredCount => _methods.Count(m => m.Status == "configured");
    private IEnumerable<RecoveryMethod> SortedMethods => _methods.OrderBy(m => m.Priority);
    private bool IsVulnerable => ConfiguredCount < 2;

    private static StatusDisplay GetStatusDisplay(string status) => status switch
    {
        "configured" => new("Configured", "bg-emerald-500", "text-emerald-600"),
        "expired" => new("Verification expired", "bg-amber-500", "text-amber-600"),
        _ => new("Not configured", "bg-muted-foreground/40", "text-muted-foreground"),
    };

    private static string GetMethodIconName(string type) => type switch
    {
        "email" => "mail",
        "phone" => "smartphone",
        "security_key" => "key-round",
        "trusted_contact" => "user-check",
        _ => "circle",
    };

    private void HandleConfigure(string id)
    {
        _methods = _methods
            .Select(m => m.Id == id ? m with { Status = "configured", LastVerified = "Apr 5, 2026" } : m)
            .ToList();
    }

    private async Task HandleTestRecovery()
    {
        _testingRecovery = true;
        _testComplete = false;
        await Task.Delay(2000);
        _testingRecovery = false;
        _testComplete = true;
        StateHasChanged();
        await Task.Delay(3000);
        _testComplete = false;
        StateHasChanged();
    }
}
