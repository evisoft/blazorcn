@* ============================================================
   Block: account-data-privacy
   Title: Account Data Privacy
   Description: Data privacy controls with GDPR export, download data, privacy settings, data retention, and consent management
   Long Description: Data privacy controls
   Dependencies: BadgeCn, ButtonCn, ProgressCn, SwitchCn, LucideClockCn, LucideDownloadCn, LucideLoaderCircleCn
   Source: original/blocks/account/account-data-privacy.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex-1">
                    <h2 class="text-sm font-medium">Data & Privacy</h2>
                    <p class="text-muted-foreground text-xs">
                        Control your data, manage privacy settings, and download your information
                    </p>
                </div>
                <BadgeCn Class="h-4 px-1.5 text-xs" Variant="BadgeVariant.Secondary">
                    GDPR Compliant
                </BadgeCn>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <h3 class="mb-3 text-xs font-medium text-muted-foreground">EXPORT YOUR DATA</h3>
            <div class="rounded-md border p-3">
                <div class="flex items-start gap-3">
                    <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-blue-500"></span>
                    <div class="flex-1">
                        <span class="text-xs font-medium">Download a copy of your data</span>
                        <div class="mt-2 flex items-center gap-4 text-muted-foreground text-xs">
                            <div class="flex items-center gap-1.5">
                                <LucideClockCn Size="16" />
                                <span>Total size: 50.3 MB</span>
                            </div>
                            <span class="text-muted-foreground/40">&bull;</span>
                            <span>Ready in ~5 minutes</span>
                        </div>
                    </div>
                    <ButtonCn Class="shrink-0 gap-2" Size="ButtonSize.Sm">
                        <LucideDownloadCn Size="16" />
                        Export Data
                    </ButtonCn>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <h3 class="mb-3 text-xs font-medium text-muted-foreground">YOUR DATA</h3>
            <div class="space-y-3">
                @foreach (var category in _dataCategories)
                {
                    <div class="flex items-center gap-3 rounded-md border px-4 py-3">
                        <span class="size-1.5 shrink-0 rounded-full bg-purple-500"></span>
                        <div class="min-w-0 flex-1">
                            <p class="text-xs font-medium">@category.Name</p>
                            <p class="text-muted-foreground text-xs">@category.Description</p>
                        </div>
                        <div class="shrink-0 text-right">
                            <p class="text-xs font-medium">@category.Size</p>
                            <p class="text-muted-foreground text-xs">Updated @category.LastUpdated</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <h3 class="mb-3 text-xs font-medium text-muted-foreground">PRIVACY SETTINGS</h3>
            <div class="space-y-3">
                @foreach (var setting in _privacySettings)
                {
                    <div class="flex items-center gap-3 rounded-md border px-4 py-3">
                        <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                        <div class="min-w-0 flex-1">
                            <p class="text-xs font-medium">@setting.Title</p>
                            <p class="text-muted-foreground text-xs">@setting.Description</p>
                        </div>
                        <SwitchCn aria-label="@setting.Title" Checked="setting.Enabled" CheckedChanged="v => setting.Enabled = v" />
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record DataCategory(string Id, string Name, string Description, string Size, string LastUpdated);

    private class PrivacySetting
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public bool Enabled { get; set; }
    }

    private static readonly DataCategory[] _dataCategories =
    [
        new("profile", "Profile Information", "Name, email, avatar, bio", "2.4 KB", "Today"),
        new("activity", "Activity & Usage", "Login history, actions, timestamps", "1.2 MB", "Today"),
        new("content", "Your Content", "Posts, comments, uploads", "48.6 MB", "Dec 5, 2024"),
    ];

    private readonly List<PrivacySetting> _privacySettings =
    [
        new() { Id = "analytics", Title = "Usage Analytics", Description = "Help improve our product with anonymous usage data", Enabled = true },
        new() { Id = "personalization", Title = "Personalized Experience", Description = "Use your activity to customize recommendations", Enabled = true },
        new() { Id = "marketing", Title = "Marketing Communications", Description = "Receive product updates and promotional offers", Enabled = false },
        new() { Id = "thirdparty", Title = "Third-Party Sharing", Description = "Share data with trusted partners for enhanced features", Enabled = false },
    ];
}
