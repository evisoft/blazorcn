@* ============================================================
   Block: account-basic-info
   Title: Account Basic Info
   Description: Comprehensive personal information form with sections for basic details, professional info, contact, and preferences
   Long Description: Personal details and profile info
   Dependencies: ButtonCn, InputCn, LabelCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, LucideCalendarCn, LucideCircleUserCn, LucideLoaderCircleCn
   Source: original/blocks/account/account-basic-info.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <LucideCircleUserCn Size="20" Class="text-muted-foreground" />
                <div>
                    <h2 class="text-sm font-medium">Personal Information</h2>
                    <p class="text-xs text-muted-foreground">
                        Manage your personal details and profile information
                    </p>
                </div>
            </div>
        </div>

        <div class="p-4 space-y-6">
            @* Basic Details *@
            <div class="space-y-3">
                <span class="text-xs font-medium text-muted-foreground">BASIC DETAILS</span>
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                    <div class="space-y-2">
                        <LabelCn Class="text-xs" For="firstName">First Name</LabelCn>
                        <InputCn id="firstName" aria-label="First Name" Value="Emma" Placeholder="Emma" />
                    </div>
                    <div class="space-y-2">
                        <LabelCn Class="text-xs" For="lastName">Last Name</LabelCn>
                        <InputCn id="lastName" aria-label="Last Name" Value="Roberts" Placeholder="Roberts" />
                    </div>
                </div>
            </div>

            @* Professional Information *@
            <div class="space-y-3">
                <span class="text-xs font-medium text-muted-foreground">PROFESSIONAL INFORMATION</span>
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
                    <div class="space-y-2">
                        <LabelCn Class="text-xs" For="gender">Gender</LabelCn>
                        <SelectCn Value="female">
                            <SelectTriggerCn id="gender" aria-label="Gender">
                                <SelectValueCn Placeholder="Select Gender" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="male">Male</SelectItemCn>
                                <SelectItemCn Value="female">Female</SelectItemCn>
                                <SelectItemCn Value="other">Other</SelectItemCn>
                                <SelectItemCn Value="prefer-not-to-say">Prefer not to say</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                    <div class="space-y-2">
                        <LabelCn Class="text-xs">Birth Date</LabelCn>
                        <ButtonCn Class="w-full justify-start text-left font-normal" Variant="ButtonVariant.Outline">
                            <LucideCalendarCn Size="16" Class="mr-2" />
                            Select a date
                        </ButtonCn>
                    </div>
                    <div class="space-y-2">
                        <LabelCn Class="text-xs" For="profession">Profession</LabelCn>
                        <SelectCn Value="ui-ux">
                            <SelectTriggerCn id="profession" aria-label="Profession">
                                <SelectValueCn Placeholder="Select Profession" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="ui-ux">UI/UX Designer</SelectItemCn>
                                <SelectItemCn Value="frontend">Frontend Developer</SelectItemCn>
                                <SelectItemCn Value="backend">Backend Developer</SelectItemCn>
                                <SelectItemCn Value="fullstack">Fullstack Developer</SelectItemCn>
                                <SelectItemCn Value="product-manager">Product Manager</SelectItemCn>
                                <SelectItemCn Value="data-scientist">Data Scientist</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                    <div class="space-y-2">
                        <LabelCn Class="text-xs" For="education">Education</LabelCn>
                        <SelectCn Value="university">
                            <SelectTriggerCn id="education" aria-label="Level">
                                <SelectValueCn Placeholder="Select Level" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="high-school">High School</SelectItemCn>
                                <SelectItemCn Value="college">College</SelectItemCn>
                                <SelectItemCn Value="university">University</SelectItemCn>
                                <SelectItemCn Value="masters">Master's Degree</SelectItemCn>
                                <SelectItemCn Value="phd">Ph.D.</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                </div>
            </div>

            @* Contact Information *@
            <div class="space-y-3">
                <span class="text-xs font-medium text-muted-foreground">CONTACT INFORMATION</span>
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                    <div class="space-y-2">
                        <LabelCn Class="text-xs" For="email">Email Address</LabelCn>
                        <InputCn id="email" aria-label="Email Address" Value="@("emma@@mail.com")" Placeholder="@("emma@@mail.com")" Type="email" />
                    </div>
                    <div class="space-y-2">
                        <LabelCn Class="text-xs" For="phone">Phone Number</LabelCn>
                        <InputCn id="phone" aria-label="Phone Number" Value="+1 (555) 123-4567" Placeholder="+1 (555) 123-4567" />
                    </div>
                    <div class="space-y-2">
                        <LabelCn Class="text-xs" For="location">Location</LabelCn>
                        <InputCn id="location" aria-label="Location" Value="Florida, USA" Placeholder="City, Country" />
                    </div>
                </div>
            </div>

            @* Footer *@
            <div class="flex items-center justify-end gap-2 border-t pt-4">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">
                    Cancel
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Disabled="@_isSaving" @onclick="HandleSave">
                    @if (_isSaving)
                    {
                        <LucideLoaderCircleCn Size="16" Class="mr-2 animate-spin" />
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Changes</span>
                    }
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private bool _isSaving;

    private async Task HandleSave()
    {
        _isSaving = true;
        StateHasChanged();
        await Task.Delay(1500);
        _isSaving = false;
    }
}
