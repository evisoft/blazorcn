@* ============================================================
   Block: account-avatar-upload
   Title: Account Avatar Upload
   Description: Profile avatar upload with image preview, drag-and-drop support, file validation, crop functionality, and remove/replace options
   Long Description: Personal details and profile info
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, ButtonCn, LucideCameraCn, LucideCheckCn, LucideImagePlusCn, LucideLoaderCircleCn, LucideTrash2Cn, LucideUploadCn, LucideUserCn, LucideXCn
   Source: original/blocks/account/account-avatar-upload.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <LucideCameraCn Size="20" Class="text-muted-foreground" />
                <div>
                    <h2 class="text-sm font-medium">Profile Picture</h2>
                    <p class="text-xs text-muted-foreground">
                        Upload a profile picture to personalize your account
                    </p>
                </div>
            </div>
        </div>

        <div class="p-4">
            <div class="flex flex-col lg:flex-row gap-6">
                <div class="flex flex-col items-center gap-3">
                    <div class="relative">
                        <AvatarCn Class="h-32 w-32 border">
                            <AvatarFallbackCn Class="text-2xl bg-muted/50">
                                <LucideUserCn Size="48" Class="text-muted-foreground" />
                            </AvatarFallbackCn>
                        </AvatarCn>
                    </div>
                    <p class="text-xs text-muted-foreground text-center">
                        Recommended: Square image, at least 400x400px
                    </p>
                </div>

                <div class="flex-1 space-y-3">
                    <div class="relative rounded-md border p-6 text-center transition-all border-border hover:bg-muted/50" role="button" tabindex="0">
                        <div class="flex flex-col items-center gap-3">
                            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-muted/50">
                                <LucideImagePlusCn Size="24" Class="text-muted-foreground" />
                            </div>
                            <div>
                                <p class="text-sm font-medium">Drop your image here</p>
                                <p class="text-xs text-muted-foreground mt-1">
                                    or
                                    <span class="text-foreground font-medium hover:underline cursor-pointer">browse from your computer</span>
                                </p>
                            </div>
                            <div class="flex flex-wrap justify-center gap-1.5 mt-2">
                                <span class="rounded-full bg-muted/50 px-2 py-0.5 text-xs text-muted-foreground">JPEG</span>
                                <span class="rounded-full bg-muted/50 px-2 py-0.5 text-xs text-muted-foreground">PNG</span>
                                <span class="rounded-full bg-muted/50 px-2 py-0.5 text-xs text-muted-foreground">GIF</span>
                                <span class="rounded-full bg-muted/50 px-2 py-0.5 text-xs text-muted-foreground">WebP</span>
                                <span class="rounded-full bg-muted/50 px-2 py-0.5 text-xs text-muted-foreground">Max 5MB</span>
                            </div>
                        </div>
                    </div>

                    <ButtonCn Class="w-full gap-2" Size="ButtonSize.Sm">
                        <LucideUploadCn Size="16" />
                        Choose File
                    </ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>

