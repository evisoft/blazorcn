@* ============================================================
   Block: account-linked-workspaces
   Title: Account Linked Workspaces
   Description: Workspace switcher showing all organizations the user belongs to with roles, member counts, current workspace highlighting, and workspace creation
   Dependencies: BadgeCn, ButtonCn, DialogCn, InputCn
   Source: original/blocks/account/account-linked-workspaces.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <LucideBuilding2Cn Class="h-5 w-5 text-muted-foreground" Size="20" />
                    <div>
                        <h2 class="text-sm font-medium">Linked Workspaces</h2>
                        <p class="text-xs text-muted-foreground">Switch between your organizations</p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Class="gap-1.5 text-xs" OnClick="@(() => _createDialogOpen = true)">
                    <LucidePlusCn Class="h-3.5 w-3.5" Size="14" />
                    Create Workspace
                </ButtonCn>
            </div>
        </div>

        <div>
            @foreach (var ws in _workspaces)
            {
                <div class="@Cn.Merge("flex items-center gap-3 border-b px-4 py-3 transition-colors last:border-b-0", ws.IsCurrent ? "bg-muted/50" : "hover:bg-muted/50")">
                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-muted text-xs font-semibold">
                        @ws.Initial
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="mb-0.5 flex flex-wrap items-center gap-2">
                            <span class="text-sm font-medium">@ws.Name</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("h-4 border-0 px-1.5 text-[10px]", GetRoleBadgeStyle(ws.Role))">@ws.Role</BadgeCn>
                            @if (ws.IsCurrent)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 border-0 bg-emerald-500/10 px-1.5 text-[10px] text-emerald-700">Current</BadgeCn>
                            }
                        </div>
                        <div class="flex items-center gap-1 text-xs text-muted-foreground">
                            <LucideUsersCn Class="h-3 w-3" Size="12" />
                            <span>@ws.MemberCount @(ws.MemberCount == 1 ? "member" : "members")</span>
                        </div>
                    </div>
                    @if (ws.IsCurrent)
                    {
                        <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                            <LucideCheckCn Class="h-3.5 w-3.5 text-emerald-600" Size="14" />
                            <span>Active</span>
                        </div>
                    }
                    else
                    {
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs"
                                  OnClick="@(() => HandleSwitch(ws.Id))">Switch</ButtonCn>
                    }
                </div>
            }
        </div>
    </div>

    <DialogCn @bind-Open="_createDialogOpen">
        <DialogContentCn Class="sm:max-w-md">
            <DialogHeaderCn>
                <DialogTitleCn Class="text-sm font-medium">Create Workspace</DialogTitleCn>
                <DialogDescriptionCn Class="text-xs">Create a new workspace to organize a separate team or project.</DialogDescriptionCn>
            </DialogHeaderCn>
            <div class="py-2">
                <span class="mb-1.5 block text-xs font-medium text-muted-foreground">Workspace Name</span>
                <InputCn aria-label="Workspace Name" Class="h-8 text-sm" placeholder="My New Workspace" @bind-Value="_newWorkspaceName" />
            </div>
            <DialogFooterCn Class="gap-2 sm:gap-0">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="@(() => _createDialogOpen = false)">Cancel</ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Disabled="@string.IsNullOrWhiteSpace(_newWorkspaceName)" OnClick="HandleCreate">
                    <LucidePlusCn Class="mr-1.5 h-3.5 w-3.5" Size="14" />
                    Create
                </ButtonCn>
            </DialogFooterCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private class Workspace
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Initial { get; set; } = "";
        public string Role { get; set; } = "";
        public int MemberCount { get; set; }
        public bool IsCurrent { get; set; }
    }

    private bool _createDialogOpen;
    private string _newWorkspaceName = "";

    private List<Workspace> _workspaces =
    [
        new() { Id = "1", Name = "Acme Corp", Initial = "AC", Role = "Owner", MemberCount = 12, IsCurrent = true },
        new() { Id = "2", Name = "Freelance Projects", Initial = "FP", Role = "Admin", MemberCount = 4, IsCurrent = false },
        new() { Id = "3", Name = "Open Source Collective", Initial = "OS", Role = "Member", MemberCount = 38, IsCurrent = false },
    ];

    private static string GetRoleBadgeStyle(string role) => role switch
    {
        "Owner" => "bg-amber-500/10 text-amber-700",
        "Admin" => "bg-blue-500/10 text-blue-700",
        _ => "bg-muted text-muted-foreground",
    };

    private void HandleSwitch(string id)
    {
        foreach (var ws in _workspaces) ws.IsCurrent = ws.Id == id;
    }

    private void HandleCreate()
    {
        if (string.IsNullOrWhiteSpace(_newWorkspaceName)) return;
        var initials = string.Concat(_newWorkspaceName.Split(' ').Where(w => w.Length > 0).Select(w => w[0])).ToUpper();
        if (initials.Length > 2) initials = initials[..2];
        if (string.IsNullOrEmpty(initials)) initials = "WS";
        _workspaces.Add(new Workspace
        {
            Id = (_workspaces.Count + 4).ToString(),
            Name = _newWorkspaceName,
            Initial = initials,
            Role = "Owner",
            MemberCount = 1,
            IsCurrent = false,
        });
        _createDialogOpen = false;
        _newWorkspaceName = "";
    }
}
