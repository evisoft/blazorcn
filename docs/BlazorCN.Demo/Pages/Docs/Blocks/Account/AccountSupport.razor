@* ============================================================
   Block: account-support
   Title: AccountSupport
   Description: A support hub card block for React and Next.js with support tier badge, contact options with availability, ticket history with status badges, new ticket form, and SLA display built with shadcn/ui and Tailwind CSS
   Source: original/blocks/account/account-support.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with tier badge *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideShieldCn Size="16" Class="h-4 w-4 text-muted-foreground" />
                    <h2 class="text-sm font-medium">Support</h2>
                </div>
                <div class="flex items-center gap-2">
                    <BadgeCn Class="@($"text-xs {_tierColor.Badge} border-0")">
                        <span class="@($"mr-1.5 size-1.5 rounded-full {_tierColor.Dot}")" />
                        @_supportTier.Label
                    </BadgeCn>
                </div>
            </div>
            <div class="mt-1.5 flex items-center gap-3 text-xs text-muted-foreground">
                <span class="flex items-center gap-1">
                    <LucideClockCn Size="12" Class="h-3 w-3" />
                    SLA: @_supportTier.ResponseTime response
                </span>
                <span class="text-muted-foreground/40">|</span>
                <span>@_supportTier.Channels.Length channels available</span>
            </div>
        </div>

        @* Contact channels *@
        <div class="border-b">
            <div class="px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">CONTACT</span>
            </div>
            @for (int i = 0; i < _contactChannels.Length; i++)
            {
                var channel = _contactChannels[i];
                var isNotLast = i < _contactChannels.Length - 1;
                <button type="button"
                        class="@($"flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50{(isNotLast ? " border-b" : "")}")">
                    <LucideIconCn Name="@channel.IconName" Size="16" Class="h-4 w-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <span class="text-sm font-medium">@channel.Method</span>
                        <p class="text-xs text-muted-foreground">@channel.Detail</p>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="@($"size-1.5 rounded-full {(channel.Available ? "bg-emerald-500" : "bg-muted-foreground")}")" />
                        <span class="text-xs text-muted-foreground">@channel.AvailabilityNote</span>
                    </div>
                </button>
            }
        </div>

        @* Tickets section *@
        <div class="border-b">
            <div class="flex items-center justify-between px-4 py-2">
                <div class="flex items-center gap-2">
                    <span class="text-xs font-medium text-muted-foreground">TICKETS</span>
                    @if (OpenCount > 0)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 py-0 text-[10px]">
                            @OpenCount open
                        </BadgeCn>
                    }
                    @if (PendingCount > 0)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 py-0 text-[10px]">
                            @PendingCount pending
                        </BadgeCn>
                    }
                </div>
                <div class="flex items-center gap-1">
                    @foreach (var filter in _filterOptions)
                    {
                        var isActive = _ticketFilter == filter;
                        <button type="button"
                                @onclick="@(() => _ticketFilter = filter)"
                                class="@($"rounded-sm px-2 py-0.5 text-xs transition-colors {(isActive ? "bg-muted font-medium text-foreground" : "text-muted-foreground hover:text-foreground")}")">
                            @FilterLabel(filter)
                        </button>
                    }
                </div>
            </div>

            @{
                var filtered = FilteredTickets;
            }
            @if (filtered.Length == 0)
            {
                <div class="px-4 py-6 text-center">
                    <p class="text-sm text-muted-foreground">No @_ticketFilter tickets</p>
                </div>
            }
            else
            {
                @for (int idx = 0; idx < filtered.Length; idx++)
                {
                    var ticket = filtered[idx];
                    var statusDot = GetStatusDot(ticket.Status);
                    var statusLabel = GetStatusLabel(ticket.Status);
                    var isExpanded = _expandedTicketId == ticket.Id;
                    var ticketNotLast = idx < filtered.Length - 1;
                    <div class="@(ticketNotLast ? "border-b" : "")">
                        <button type="button"
                                @onclick="@(() => _expandedTicketId = isExpanded ? null : ticket.Id)"
                                class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                            <span class="@($"size-1.5 shrink-0 rounded-full {statusDot}")" />
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-mono text-xs text-muted-foreground">@ticket.Number</span>
                                    <span class="truncate text-sm font-medium">@ticket.Subject</span>
                                </div>
                                <div class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                                    <span>@ticket.Category</span>
                                    <span class="text-muted-foreground/40">|</span>
                                    <span>@ticket.CreatedAt</span>
                                </div>
                            </div>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-[10px]">
                                @statusLabel
                            </BadgeCn>
                            @if (isExpanded)
                            {
                                <LucideChevronUpCn Size="14" Class="h-3.5 w-3.5 shrink-0 text-muted-foreground" />
                            }
                            else
                            {
                                <LucideChevronDownCn Size="14" Class="h-3.5 w-3.5 shrink-0 text-muted-foreground" />
                            }
                        </button>
                        @if (isExpanded)
                        {
                            <div class="overflow-hidden">
                                <div class="mx-4 mb-3 rounded-md bg-muted/50 p-3">
                                    <div class="grid grid-cols-3 gap-3 text-xs">
                                        <div>
                                            <span class="text-muted-foreground">Priority</span>
                                            <p class="mt-0.5 font-medium capitalize">@ticket.Priority</p>
                                        </div>
                                        <div>
                                            <span class="text-muted-foreground">Assigned to</span>
                                            <p class="mt-0.5 font-medium">@ticket.AssignedAgent</p>
                                        </div>
                                        <div>
                                            <span class="text-muted-foreground">Last response</span>
                                            <p class="mt-0.5 font-medium">@ticket.LastResponseAt</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>

        @* New ticket form (togglable) *@
        <div class="px-4 py-3">
            @if (_showNewTicket)
            {
                <p class="mb-3 text-sm font-medium">Create a new ticket</p>
                <div class="space-y-3">
                    <div>
                        <span class="mb-1 block text-xs font-medium text-muted-foreground">Subject</span>
                        <InputCn Placeholder="Brief description of your issue" />
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <span class="mb-1 block text-xs font-medium text-muted-foreground">Category</span>
                            <SelectCn>
                                <SelectTriggerCn><SelectValueCn Placeholder="Select" /></SelectTriggerCn>
                                <SelectContentCn>
                                    <SelectItemCn Value="technical">Technical</SelectItemCn>
                                    <SelectItemCn Value="billing">Billing</SelectItemCn>
                                    <SelectItemCn Value="account">Account</SelectItemCn>
                                    <SelectItemCn Value="feature">Feature Request</SelectItemCn>
                                </SelectContentCn>
                            </SelectCn>
                        </div>
                        <div>
                            <span class="mb-1 block text-xs font-medium text-muted-foreground">Priority</span>
                            <SelectCn>
                                <SelectTriggerCn><SelectValueCn Placeholder="Select" /></SelectTriggerCn>
                                <SelectContentCn>
                                    <SelectItemCn Value="low">Low</SelectItemCn>
                                    <SelectItemCn Value="normal">Normal</SelectItemCn>
                                    <SelectItemCn Value="high">High</SelectItemCn>
                                    <SelectItemCn Value="urgent">Urgent</SelectItemCn>
                                </SelectContentCn>
                            </SelectCn>
                        </div>
                    </div>
                    <div>
                        <span class="mb-1 block text-xs font-medium text-muted-foreground">Description</span>
                        <TextareaCn Class="min-h-[80px]" Placeholder="Provide as much detail as possible..." />
                    </div>
                    <div class="flex items-center gap-2">
                        <ButtonCn Size="ButtonSize.Sm" Disabled="@_isSubmitting" @onclick="HandleSubmitTicket" Class="gap-1.5">
                            @if (_isSubmitting)
                            {
                                <LucideLoader2Cn Size="14" Class="h-3.5 w-3.5 animate-spin" />
                                <span>Submitting...</span>
                            }
                            else
                            {
                                <LucideSendCn Size="14" Class="h-3.5 w-3.5" />
                                <span>Submit ticket</span>
                            }
                        </ButtonCn>
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="@(() => _showNewTicket = false)">
                            Cancel
                        </ButtonCn>
                    </div>
                </div>
            }
            else
            {
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" @onclick="@(() => _showNewTicket = true)" Class="w-full gap-1.5">
                    <LucidePlusCn Size="14" Class="h-3.5 w-3.5" />
                    New ticket
                </ButtonCn>
            }
        </div>
    </div>
</section>

@code {
    private record SupportTierInfo(string Level, string Label, string ResponseTime, string[] Channels);
    private record TierColorInfo(string Badge, string Dot);
    private record ContactChannelInfo(string Id, string Method, string Detail, string IconName, bool Available, string AvailabilityNote);
    private record TicketInfo(string Id, string Number, string Subject, string Status, string Priority, string Category, string CreatedAt, string LastResponseAt, string AssignedAgent);

    private bool _showNewTicket;
    private bool _isSubmitting;
    private string _ticketFilter = "all";
    private string? _expandedTicketId;

    private static readonly string[] _filterOptions = ["all", "open", "pending", "resolved"];

    private static readonly SupportTierInfo _supportTier = new("priority", "Priority Support", "4 hours", ["email", "chat", "phone"]);

    private static readonly Dictionary<string, TierColorInfo> _tierColors = new()
    {
        ["basic"] = new("bg-muted text-muted-foreground", "bg-muted-foreground"),
        ["priority"] = new("bg-blue-500/10 text-blue-700", "bg-blue-500"),
        ["enterprise"] = new("bg-violet-500/10 text-violet-700", "bg-violet-500"),
    };

    private TierColorInfo _tierColor => _tierColors[_supportTier.Level];

    private static readonly ContactChannelInfo[] _contactChannels =
    [
        new("email", "Email", "support@acme.com", "mail", true, "Replies within 4 hours"),
        new("chat", "Live Chat", "Chat with an agent", "message-circle", true, "Online now"),
        new("phone", "Phone", "+1 (555) 012-3456", "phone", false, "Mon-Fri 9am-6pm EST"),
    ];

    private static readonly TicketInfo[] _tickets =
    [
        new("t1", "TKT-2847", "Webhook delivery failures on /api/v2/events endpoint", "open", "high", "Technical", "Apr 3, 2026", "2 hours ago", "Sarah K."),
        new("t2", "TKT-2839", "Invoice discrepancy for March billing cycle", "pending", "normal", "Billing", "Apr 1, 2026", "1 day ago", "James R."),
        new("t3", "TKT-2801", "SSO SAML configuration not saving metadata URL", "resolved", "high", "Technical", "Mar 25, 2026", "5 days ago", "Maria L."),
        new("t4", "TKT-2788", "Request to increase API rate limit for production", "resolved", "normal", "Account", "Mar 20, 2026", "8 days ago", "Sarah K."),
    ];

    private int OpenCount => _tickets.Count(t => t.Status == "open");
    private int PendingCount => _tickets.Count(t => t.Status == "pending");

    private TicketInfo[] FilteredTickets => _ticketFilter == "all"
        ? _tickets
        : [.. _tickets.Where(t => t.Status == _ticketFilter)];

    private static string FilterLabel(string f) =>
        f == "all" ? "All" : char.ToUpper(f[0]) + f[1..];

    private static string GetStatusDot(string status) => status switch
    {
        "open" => "bg-blue-500",
        "pending" => "bg-amber-500",
        "resolved" => "bg-emerald-500",
        _ => "bg-muted-foreground",
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "open" => "Open",
        "pending" => "Pending",
        "resolved" => "Resolved",
        _ => status,
    };

    private async Task HandleSubmitTicket()
    {
        _isSubmitting = true;
        await Task.Delay(1500);
        _isSubmitting = false;
        _showNewTicket = false;
    }
}
