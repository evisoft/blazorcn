@* ============================================================
   Block: account-theme-customizer
   Title: AccountThemeCustomizer
   Description: A theme customization card for React and Next.js with color scheme presets, custom color pickers, border radius slider, font family select, live preview panel, and save/reset actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/account/account-theme-customizer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Theme</h2>
                    <p class="text-xs text-muted-foreground">
                        Customize the look and feel of your workspace
                    </p>
                </div>
                @if (IsDirty)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px]">Unsaved</BadgeCn>
                }
            </div>
        </div>

        @* Color Presets *@
        <div class="border-b px-4 py-3 space-y-3">
            <span class="text-xs font-medium text-muted-foreground">COLOR SCHEME</span>
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-5">
                @foreach (var preset in _presets)
                {
                    var isActive = _activePresetId == preset.Id;
                    <button
                        type="button"
                        @onclick="@(() => _activePresetId = preset.Id)"
                        class="@(Cn.Merge("relative flex flex-col items-center gap-1.5 rounded-md border px-2 py-2.5 text-center transition-colors", isActive ? "border-foreground bg-muted/50" : "border-transparent hover:bg-muted/30"))"
                    >
                        @if (isActive)
                        {
                            <div class="absolute top-1 right-1">
                                <LucideIconCn Name="check" Size="12" />
                            </div>
                        }
                        <div class="flex items-center gap-1">
                            <span class="size-3 rounded-full border border-black/10" style="background-color: @preset.Primary.Hex"></span>
                            <span class="size-3 rounded-full border border-black/10" style="background-color: @preset.Background.Hex"></span>
                            <span class="size-3 rounded-full border border-black/10" style="background-color: @preset.Accent.Hex"></span>
                        </div>
                        <span class="text-[10px] font-medium">@preset.Name</span>
                    </button>
                }
            </div>
        </div>

        @* Active Colors *@
        <div class="border-b px-4 py-3 space-y-3">
            <span class="text-xs font-medium text-muted-foreground">ACTIVE COLORS</span>
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
                @foreach (var color in ActiveColorEntries)
                {
                    <div class="flex items-center gap-2 rounded-md bg-muted/30 px-2.5 py-2">
                        <span class="size-4 shrink-0 rounded border border-black/10" style="background-color: @color.Value.Hex"></span>
                        <div class="min-w-0">
                            <span class="block text-[10px] font-medium capitalize">@color.Key</span>
                            <span class="block truncate font-mono text-[10px] text-muted-foreground">@color.Value.Hex</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Border Radius *@
        <div class="border-b px-4 py-3 space-y-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">BORDER RADIUS</span>
                <span class="font-mono text-xs text-muted-foreground">@_borderRadius@("px")</span>
            </div>
            <div class="flex items-center gap-4">
                <div
                    class="h-8 w-8 shrink-0 border-2 border-foreground/20"
                    style="border-radius: @(_borderRadius)px"
                ></div>
                <SliderCn Value="@((double)_borderRadius)" ValueChanged="@((double v) => _borderRadius = (int)v)" Min="0" Max="16" Step="1" Class="flex-1" />
                <div class="flex gap-1">
                    @foreach (var r in _radiusPresets)
                    {
                        var rVal = r;
                        <button
                            type="button"
                            @onclick="@(() => _borderRadius = rVal)"
                            class="@(Cn.Merge("flex h-6 w-6 items-center justify-center rounded text-[10px] transition-colors", _borderRadius == rVal ? "bg-foreground text-background" : "bg-muted/50 text-muted-foreground hover:bg-muted"))"
                        >
                            @r
                        </button>
                    }
                </div>
            </div>
        </div>

        @* Font Family *@
        <div class="border-b px-4 py-3 space-y-3">
            <span class="text-xs font-medium text-muted-foreground">FONT FAMILY</span>
            <div class="flex items-center gap-3">
                <SelectCn Value="@_fontFamily" ValueChanged="@(v => _fontFamily = v ?? "inter")">
                    <SelectTriggerCn Class="h-8 flex-1 text-sm">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        @foreach (var font in _fonts)
                        {
                            <SelectItemCn Value="@font.Value">@font.Label</SelectItemCn>
                        }
                    </SelectContentCn>
                </SelectCn>
                <span class="text-sm text-muted-foreground" style="font-family: @ActiveFont.Stack">
                    Aa Bb Cc 123
                </span>
            </div>
        </div>

        @* Live Preview *@
        <div class="border-b px-4 py-3 space-y-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">PREVIEW</span>
                <div class="flex items-center gap-1 rounded-md bg-muted/50 p-0.5">
                    <button
                        type="button"
                        @onclick="@(() => _previewMode = "light")"
                        class="@(Cn.Merge("flex h-5 items-center gap-1 rounded px-1.5 text-[10px] transition-colors", _previewMode == "light" ? "bg-background shadow-sm" : "text-muted-foreground"))"
                    >
                        <LucideIconCn Name="sun" Size="10" />
                        Light
                    </button>
                    <button
                        type="button"
                        @onclick="@(() => _previewMode = "dark")"
                        class="@(Cn.Merge("flex h-5 items-center gap-1 rounded px-1.5 text-[10px] transition-colors", _previewMode == "dark" ? "bg-background shadow-sm" : "text-muted-foreground"))"
                    >
                        <LucideIconCn Name="moon" Size="10" />
                        Dark
                    </button>
                </div>
            </div>
            <div
                class="overflow-hidden border"
                style="border-radius: @(_borderRadius)px; background-color: @(_previewMode == "dark" ? "#18181b" : ActivePreset.Background.Hex); font-family: @ActiveFont.Stack"
            >
                @* Preview Nav *@
                <div
                    class="flex items-center justify-between border-b px-3 py-2"
                    style="border-color: @(_previewMode == "dark" ? "rgba(255,255,255,0.1)" : "rgba(0,0,0,0.08)")"
                >
                    <div class="flex items-center gap-2">
                        <div
                            class="h-4 w-4"
                            style="background-color: @ActivePreset.Primary.Hex; border-radius: @(Math.Max(_borderRadius - 4, 0))px"
                        ></div>
                        <span
                            class="text-[10px] font-medium"
                            style="color: @(_previewMode == "dark" ? "#fafafa" : ActivePreset.Foreground.Hex)"
                        >
                            Workspace
                        </span>
                    </div>
                    <div class="flex gap-1.5">
                        @foreach (var item in new[] { "Dashboard", "Projects", "Settings" })
                        {
                            <span class="text-[10px]" style="color: @(_previewMode == "dark" ? "rgba(255,255,255,0.5)" : "rgba(0,0,0,0.4)")">@item</span>
                        }
                    </div>
                </div>
                @* Preview Body *@
                <div class="p-3 space-y-2">
                    <div class="flex items-center gap-2">
                        <div
                            class="px-2 py-0.5 text-[10px] font-medium text-white"
                            style="background-color: @ActivePreset.Primary.Hex; border-radius: @(Math.Max(_borderRadius - 4, 0))px"
                        >
                            Button
                        </div>
                        <div
                            class="border px-2 py-0.5 text-[10px]"
                            style="border-radius: @(Math.Max(_borderRadius - 4, 0))px; border-color: @(_previewMode == "dark" ? "rgba(255,255,255,0.15)" : "rgba(0,0,0,0.12)"); color: @(_previewMode == "dark" ? "#fafafa" : ActivePreset.Foreground.Hex)"
                        >
                            Outline
                        </div>
                        <div
                            class="px-2 py-0.5 text-[10px]"
                            style="background-color: @ActivePreset.Accent.Hex; border-radius: @(Math.Max(_borderRadius - 4, 0))px; color: @(_previewMode == "dark" ? "#fafafa" : ActivePreset.Foreground.Hex)"
                        >
                            Badge
                        </div>
                    </div>
                    <div class="flex gap-2" style="color: @(_previewMode == "dark" ? "rgba(255,255,255,0.5)" : "rgba(0,0,0,0.4)")">
                        <div
                            class="flex-1 border p-2"
                            style="border-radius: @(_borderRadius)px; border-color: @(_previewMode == "dark" ? "rgba(255,255,255,0.1)" : "rgba(0,0,0,0.08)"); background-color: @(_previewMode == "dark" ? "rgba(255,255,255,0.04)" : ActivePreset.Accent.Hex)"
                        >
                            <div
                                class="mb-1 h-1.5 w-12"
                                style="border-radius: 2px; background-color: @(_previewMode == "dark" ? "rgba(255,255,255,0.15)" : "rgba(0,0,0,0.12)")"
                            ></div>
                            <div
                                class="h-1 w-20"
                                style="border-radius: 2px; background-color: @(_previewMode == "dark" ? "rgba(255,255,255,0.08)" : "rgba(0,0,0,0.06)")"
                            ></div>
                        </div>
                        <div
                            class="flex-1 border p-2"
                            style="border-radius: @(_borderRadius)px; border-color: @(_previewMode == "dark" ? "rgba(255,255,255,0.1)" : "rgba(0,0,0,0.08)"); background-color: @(_previewMode == "dark" ? "rgba(255,255,255,0.04)" : ActivePreset.Accent.Hex)"
                        >
                            <div
                                class="mb-1 h-1.5 w-10"
                                style="border-radius: 2px; background-color: @(_previewMode == "dark" ? "rgba(255,255,255,0.15)" : "rgba(0,0,0,0.12)")"
                            ></div>
                            <div
                                class="h-1 w-16"
                                style="border-radius: 2px; background-color: @(_previewMode == "dark" ? "rgba(255,255,255,0.08)" : "rgba(0,0,0,0.06)")"
                            ></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs text-muted-foreground" @onclick="HandleReset" Disabled="@(!IsDirty)">
                <LucideIconCn Name="rotate-ccw" Size="12" />
                Reset to default
            </ButtonCn>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Disabled="@(!IsDirty)">Cancel</ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Disabled="@(_isSaving || !IsDirty)" @onclick="HandleSave">
                    @if (_isSaving)
                    {
                        <LucideIconCn Name="loader-2" Size="14" Class="mr-1.5 h-3.5 w-3.5 animate-spin" />
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save theme</span>
                    }
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record ColorValue(string Label, string Hsl, string Hex);
    private record ThemePreset(string Id, string Name, ColorValue Primary, ColorValue Background, ColorValue Accent, ColorValue Foreground);
    private record FontOption(string Value, string Label, string Stack);
    private record ColorEntry(string Key, ColorValue Value);

    private static readonly ThemePreset[] _presets =
    [
        new("default", "Default",
            new("Zinc", "240 5% 26%", "#3f3f46"),
            new("White", "0 0% 100%", "#ffffff"),
            new("Zinc 100", "240 5% 96%", "#f4f4f5"),
            new("Zinc 950", "240 6% 10%", "#18181b")),
        new("ocean", "Ocean",
            new("Blue 600", "221 83% 53%", "#2563eb"),
            new("Slate 50", "210 40% 98%", "#f8fafc"),
            new("Sky 100", "204 94% 94%", "#e0f2fe"),
            new("Slate 900", "222 47% 11%", "#0f172a")),
        new("forest", "Forest",
            new("Emerald 600", "160 84% 39%", "#059669"),
            new("Stone 50", "60 9% 98%", "#fafaf9"),
            new("Emerald 50", "152 81% 96%", "#ecfdf5"),
            new("Stone 900", "24 10% 10%", "#1c1917")),
        new("sunset", "Sunset",
            new("Orange 500", "25 95% 53%", "#f97316"),
            new("Amber 50", "48 100% 96%", "#fffbeb"),
            new("Orange 100", "34 100% 92%", "#ffedd5"),
            new("Stone 900", "24 10% 10%", "#1c1917")),
        new("midnight", "Midnight",
            new("Violet 500", "258 90% 66%", "#8b5cf6"),
            new("Zinc 950", "240 6% 10%", "#18181b"),
            new("Zinc 800", "240 4% 26%", "#3f3f46"),
            new("Zinc 50", "0 0% 98%", "#fafafa")),
    ];

    private static readonly FontOption[] _fonts =
    [
        new("inter", "Inter", "Inter, system-ui, sans-serif"),
        new("geist", "Geist", "Geist, system-ui, sans-serif"),
        new("geist-mono", "Geist Mono", "Geist Mono, monospace"),
        new("ibm-plex", "IBM Plex Sans", "IBM Plex Sans, sans-serif"),
        new("jetbrains", "JetBrains Mono", "JetBrains Mono, monospace"),
        new("system", "System Default", "system-ui, sans-serif"),
    ];

    private static readonly int[] _radiusPresets = [0, 4, 8, 12, 16];

    private string _activePresetId = "default";
    private int _borderRadius = 8;
    private string _fontFamily = "inter";
    private bool _isSaving;
    private string _previewMode = "light";

    private ThemePreset ActivePreset => Array.Find(_presets, p => p.Id == _activePresetId) ?? _presets[0];
    private FontOption ActiveFont => Array.Find(_fonts, f => f.Value == _fontFamily) ?? _fonts[0];
    private bool IsDirty => _activePresetId != "default" || _borderRadius != 8 || _fontFamily != "inter";

    private IEnumerable<ColorEntry> ActiveColorEntries =>
    [
        new("primary", ActivePreset.Primary),
        new("background", ActivePreset.Background),
        new("accent", ActivePreset.Accent),
        new("foreground", ActivePreset.Foreground),
    ];

    private void HandleReset()
    {
        _activePresetId = "default";
        _borderRadius = 8;
        _fontFamily = "inter";
    }

    private async Task HandleSave()
    {
        _isSaving = true;
        StateHasChanged();
        await Task.Delay(1500);
        _isSaving = false;
    }
}
