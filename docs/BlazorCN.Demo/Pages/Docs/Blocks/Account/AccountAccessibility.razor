@* ============================================================
   Block: account-accessibility
   Title: Account Accessibility
   Description: Accessibility settings panel with visual, motion, and assistive technology preferences
   Dependencies: BadgeCn, ButtonCn, LabelCn, RadioGroupCn, SelectCn, SliderCn, SwitchCn
   Source: original/blocks/account/account-accessibility.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <LucideAccessibilityCn Class="h-5 w-5 text-muted-foreground" Size="20" />
                    <div class="flex-1">
                        <h2 class="text-sm font-medium">Accessibility Settings</h2>
                        <p class="text-xs text-muted-foreground">Customize your experience for better accessibility</p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" OnClick="HandleReset" Class="gap-2">
                    <LucideRotateCcwCn Class="h-4 w-4" Size="16" />
                    Reset All
                </ButtonCn>
            </div>
        </div>

        <div class="flex flex-col gap-4 p-4">
            <div class="flex flex-col gap-3">
                <span class="text-xs font-medium text-muted-foreground">VISUAL PREFERENCES</span>
                <div class="divide-y rounded-md border">
                    <div class="flex items-center justify-between px-3 py-2">
                        <div class="flex-1">
                            <span class="text-sm font-medium">High Contrast Mode</span>
                            <p class="text-xs text-muted-foreground">Increase contrast for better visibility</p>
                        </div>
                        <SwitchCn aria-label="High Contrast Mode" Checked="@_highContrast" CheckedChanged="@((bool v) => _highContrast = v)" />
                    </div>
                    <div class="flex items-center justify-between px-3 py-2">
                        <div class="flex-1">
                            <span class="text-sm font-medium">Reduced Motion</span>
                            <p class="text-xs text-muted-foreground">Minimize animations and transitions</p>
                        </div>
                        <SwitchCn aria-label="Reduced Motion" Checked="@_reducedMotion" CheckedChanged="@((bool v) => _reducedMotion = v)" />
                    </div>
                    <div class="flex items-center justify-between px-3 py-2">
                        <div class="flex-1">
                            <span class="text-sm font-medium">Enhanced Focus Indicators</span>
                            <p class="text-xs text-muted-foreground">Show prominent outlines on focused elements</p>
                        </div>
                        <SwitchCn aria-label="Enhanced Focus Indicators" Checked="@_focusIndicators" CheckedChanged="@((bool v) => _focusIndicators = v)" />
                    </div>
                </div>
            </div>

            <div class="flex flex-col gap-3">
                <span class="text-xs font-medium text-muted-foreground">TEXT SIZE</span>
                <div class="rounded-md border p-4">
                    <div class="mb-4 flex flex-col gap-4">
                        <div class="flex items-center justify-between">
                            <div>
                                <span class="text-sm font-medium">Font Size</span>
                                <p class="text-xs text-muted-foreground">Adjust the base text size throughout the application</p>
                            </div>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@_fontSize% — @GetFontSizeLabel(_fontSize)</BadgeCn>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="w-6 text-xs text-muted-foreground">A</span>
                            <SliderCn aria-label="Font size" Class="flex-1" Max="175" Min="75" Value="@_fontSize"
                                      ValueChanged="@((double v) => _fontSize = v)" Step="25" />
                            <span class="w-6 text-sm font-semibold text-muted-foreground">A</span>
                        </div>
                        <div class="rounded-md border p-3">
                            <p class="text-muted-foreground" style="@(FormattableString.Invariant($"font-size: {_fontSize}%"))">
                                Preview: This is how text will appear at @_fontSize% size. The quick brown fox jumps over the lazy dog.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex flex-col gap-3">
                <span class="text-xs font-medium text-muted-foreground">COLOR VISION</span>
                <div class="rounded-md border p-4">
                    <div class="flex flex-col gap-3">
                        <div>
                            <span class="text-sm font-medium">Color Blind Mode</span>
                            <p class="text-xs text-muted-foreground">Optimize colors for different types of color vision deficiency</p>
                        </div>
                        <RadioGroupCn Class="grid grid-cols-2 gap-2" Value="@_colorBlindMode"
                                      ValueChanged="@(v => _colorBlindMode = v ?? "none")">
                            @foreach (var opt in _colorBlindOptions)
                            {
                                <LabelCn For="@($"cb-{opt.Value}")"
                                         Class="@Cn.Merge("flex items-center gap-2 rounded-md border p-3 cursor-pointer transition-colors", _colorBlindMode == opt.Value ? "border-foreground bg-muted/50" : "border-border hover:bg-muted/50")">
                                    <RadioGroupItemCn Id="@($"cb-{opt.Value}")" Value="@opt.Value" />
                                    <div>
                                        <p class="text-sm font-medium">@opt.Label</p>
                                        <p class="text-xs text-muted-foreground">@opt.Description</p>
                                    </div>
                                </LabelCn>
                            }
                        </RadioGroupCn>
                    </div>
                </div>
            </div>

            <div class="flex flex-col gap-3">
                <span class="text-xs font-medium text-muted-foreground">INTERACTION</span>
                <div class="divide-y rounded-md border">
                    <div class="flex items-center justify-between px-3 py-2">
                        <div class="flex-1">
                            <span class="text-sm font-medium">Large Click Targets</span>
                            <p class="text-xs text-muted-foreground">Increase button and link sizes for easier clicking</p>
                        </div>
                        <SwitchCn aria-label="Large Click Targets" Checked="@_largeClickTargets" CheckedChanged="@((bool v) => _largeClickTargets = v)" />
                    </div>
                    <div class="px-3 py-2">
                        <div class="flex items-center justify-between">
                            <div class="flex-1">
                                <span class="text-sm font-medium">Cursor Size</span>
                                <p class="text-xs text-muted-foreground">Adjust the mouse cursor size</p>
                            </div>
                            <SelectCn Value="@_cursorSize" ValueChanged="@((string v) => _cursorSize = v)">
                                <SelectTriggerCn aria-label="Cursor size" Class="w-[140px]">
                                    <SelectValueCn />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    <SelectItemCn Value="default">Default</SelectItemCn>
                                    <SelectItemCn Value="large">Large</SelectItemCn>
                                    <SelectItemCn Value="extra-large">Extra Large</SelectItemCn>
                                </SelectContentCn>
                            </SelectCn>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex flex-col gap-3">
                <span class="text-xs font-medium text-muted-foreground">ASSISTIVE TECHNOLOGY</span>
                <div class="divide-y rounded-md border">
                    <div class="flex items-center justify-between px-3 py-2">
                        <div class="flex-1">
                            <span class="text-sm font-medium">Screen Reader Optimizations</span>
                            <p class="text-xs text-muted-foreground">Optimize layout and announcements for screen readers</p>
                        </div>
                        <SwitchCn aria-label="Screen Reader Optimizations" Checked="@_screenReader" CheckedChanged="@((bool v) => _screenReader = v)" />
                    </div>
                    <div class="flex items-center justify-between px-3 py-2">
                        <div class="flex-1">
                            <span class="text-sm font-medium">Autoplay Media</span>
                            <p class="text-xs text-muted-foreground">Allow videos and audio to play automatically</p>
                        </div>
                        <SwitchCn aria-label="Autoplay Media" Checked="@_autoplayMedia" CheckedChanged="@((bool v) => _autoplayMedia = v)" />
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-end gap-2 border-t pt-4">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">Cancel</ButtonCn>
                <ButtonCn Size="ButtonSize.Sm">Save Changes</ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record ColorBlindOption(string Value, string Label, string Description);

    private bool _reducedMotion;
    private bool _highContrast;
    private bool _screenReader;
    private bool _largeClickTargets;
    private bool _focusIndicators = true;
    private bool _autoplayMedia;
    private double _fontSize = 100;
    private string _colorBlindMode = "none";
    private string _cursorSize = "default";

    private static readonly ColorBlindOption[] _colorBlindOptions =
    [
        new("none", "None", "Default colors"),
        new("deuteranopia", "Deuteranopia", "Green-blind"),
        new("protanopia", "Protanopia", "Red-blind"),
        new("tritanopia", "Tritanopia", "Blue-blind"),
    ];

    private static string GetFontSizeLabel(double value) => value switch
    {
        <= 85 => "Small",
        <= 100 => "Default",
        <= 125 => "Large",
        <= 150 => "Extra Large",
        _ => "Maximum",
    };

    private void HandleReset()
    {
        _reducedMotion = false;
        _highContrast = false;
        _screenReader = false;
        _largeClickTargets = false;
        _focusIndicators = true;
        _autoplayMedia = false;
        _fontSize = 100;
        _colorBlindMode = "none";
        _cursorSize = "default";
    }
}
