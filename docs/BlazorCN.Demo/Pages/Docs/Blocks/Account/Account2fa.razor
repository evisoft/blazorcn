@* ============================================================
   Block: account-2fa
   Title: Account 2fa
   Description: Two-factor authentication setup with QR code display, authenticator app instructions, backup code generation, SMS option toggle, and verification code confirmation
   Long Description: A visual workflow showing how work flows through the company from ideation to shipping, with team involvement at each stage.
   Dependencies: BadgeCn, ButtonCn, InputCn, LucideArrowLeftCn, LucideCheckCn, LucideChevronRightCn, LucideCopyCn, LucideDownloadCn, LucideKeyCn, LucideLoaderCircleCn, LucideMessageSquareCn, LucideShieldCn, LucideShieldCheckCn, LucideSmartphoneCn
   Source: original/blocks/account/account-2fa.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    @if (_is2FAEnabled)
                    {
                        <LucideShieldCheckCn Size="20" Class="text-muted-foreground" />
                    }
                    else
                    {
                        <LucideShieldCn Size="20" Class="text-muted-foreground" />
                    }
                    <div>
                        <h2 class="text-sm font-medium">Two-Factor Authentication</h2>
                        <p class="text-xs text-muted-foreground">Add an extra layer of security to your account</p>
                    </div>
                </div>
                @if (_is2FAEnabled)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary">
                        <LucideCheckCn Size="12" Class="mr-1" />
                        Enabled
                    </BadgeCn>
                }
            </div>
        </div>

        <div class="p-4">
            @if (_is2FAEnabled)
            {
                <div class="space-y-4">
                    <div>
                        <span class="text-xs font-medium text-muted-foreground">ACTIVE METHOD</span>
                        <div class="mt-2 flex items-center gap-3 rounded-md border p-3">
                            @if (_selectedMethod == "app")
                            {
                                <LucideSmartphoneCn Size="20" Class="text-muted-foreground" />
                            }
                            else
                            {
                                <LucideMessageSquareCn Size="20" Class="text-muted-foreground" />
                            }
                            <div class="flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">
                                        @(_selectedMethod == "app" ? "Authenticator App" : "SMS Text Message")
                                    </span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px]">Active</BadgeCn>
                                </div>
                                <p class="text-xs text-muted-foreground">You'll be asked for a verification code when signing in</p>
                            </div>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-2">
                            <LucideKeyCn Size="16" />
                            View Backup Codes
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-2" @onclick="HandleDisable2FA">
                            <LucideShieldCn Size="16" />
                            Disable 2FA
                        </ButtonCn>
                    </div>
                </div>
            }
            else
            {
                <div class="space-y-4">
                    @if (_setupStep == "choose")
                    {
                        <div class="space-y-2">
                            <span class="text-xs font-medium text-muted-foreground">CHOOSE YOUR 2FA METHOD</span>

                            <button type="button" class="group w-full rounded-md border p-3 text-left transition-colors hover:bg-muted/50" @onclick='() => HandleStartSetup("app")'>
                                <div class="flex items-start gap-3">
                                    <LucideSmartphoneCn Size="20" Class="text-muted-foreground" />
                                    <div class="flex-1">
                                        <div class="flex items-center gap-2">
                                            <span class="text-sm font-medium">Authenticator App</span>
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px]">Recommended</BadgeCn>
                                        </div>
                                        <p class="text-xs text-muted-foreground">Use an app like Google Authenticator or Authy to generate codes</p>
                                    </div>
                                    <LucideChevronRightCn Size="16" Class="text-muted-foreground transition-transform group-hover:translate-x-0.5" />
                                </div>
                            </button>

                            <button type="button" class="group w-full rounded-md border p-3 text-left transition-colors hover:bg-muted/50" @onclick='() => HandleStartSetup("sms")'>
                                <div class="flex items-start gap-3">
                                    <LucideMessageSquareCn Size="20" Class="text-muted-foreground" />
                                    <div class="flex-1">
                                        <span class="text-sm font-medium">SMS Text Message</span>
                                        <p class="text-xs text-muted-foreground">Receive verification codes via text message</p>
                                    </div>
                                    <LucideChevronRightCn Size="16" Class="text-muted-foreground transition-transform group-hover:translate-x-0.5" />
                                </div>
                            </button>
                        </div>
                    }

                    @if (_setupStep == "scan" && _selectedMethod == "app")
                    {
                        <div class="space-y-4">
                            <div class="flex items-center gap-2 text-xs">
                                <div class="flex h-5 w-5 items-center justify-center rounded-full bg-foreground text-background">1</div>
                                <span class="font-medium">Scan QR Code</span>
                                <div class="h-px flex-1 bg-border"></div>
                                <div class="flex h-5 w-5 items-center justify-center rounded-full bg-muted text-muted-foreground">2</div>
                                <span class="text-muted-foreground">Verify</span>
                            </div>
                            <div>
                                <h3 class="text-sm font-medium">Scan QR Code</h3>
                                <p class="text-xs text-muted-foreground">Open your authenticator app and scan this QR code to add your account</p>
                            </div>
                            <div class="flex flex-col items-center gap-4 rounded-md bg-muted/50 p-4">
                                <div class="rounded-md border bg-white p-3">
                                    <img alt="QR Code" class="h-40 w-40" height="400" src="@_qrCodeUrl" width="400" />
                                </div>
                                <div class="w-full space-y-2 text-center">
                                    <p class="text-xs text-muted-foreground">Can't scan? Enter this code manually:</p>
                                    <div class="flex items-center gap-2">
                                        <code class="flex-1 rounded-md bg-card px-3 py-2 font-mono text-sm">@SecretKey</code>
                                        <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="h-9 w-9 shrink-0" @onclick="HandleCopySecret">
                                            @if (_copiedSecret)
                                            {
                                                <LucideCheckCn Size="16" Class="text-emerald-500" />
                                            }
                                            else
                                            {
                                                <LucideCopyCn Size="16" />
                                            }
                                        </ButtonCn>
                                    </div>
                                </div>
                            </div>
                            <div class="flex gap-2">
                                <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" @onclick='() => _setupStep = "choose"'>
                                    <LucideArrowLeftCn Size="16" />
                                    Back
                                </ButtonCn>
                                <ButtonCn Class="flex-1" @onclick='() => _setupStep = "verify"'>Continue to Verification</ButtonCn>
                            </div>
                        </div>
                    }

                    @if (_setupStep == "verify")
                    {
                        <div class="space-y-4">
                            @if (_selectedMethod == "app")
                            {
                                <div class="flex items-center gap-2 text-xs">
                                    <div class="flex h-5 w-5 items-center justify-center rounded-full bg-emerald-500 text-white">
                                        <LucideCheckCn Size="12" />
                                    </div>
                                    <span class="text-muted-foreground">Scan QR Code</span>
                                    <div class="h-px flex-1 bg-border"></div>
                                    <div class="flex h-5 w-5 items-center justify-center rounded-full bg-foreground text-background">2</div>
                                    <span class="font-medium">Verify</span>
                                </div>
                            }
                            <div class="text-center">
                                <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-muted/50">
                                    <LucideKeyCn Size="24" Class="text-muted-foreground" />
                                </div>
                                <h3 class="text-sm font-medium">Enter Verification Code</h3>
                                <p class="text-xs text-muted-foreground">
                                    Enter the 6-digit code from your @(_selectedMethod == "app" ? "authenticator app" : "text message")
                                </p>
                            </div>
                            <div class="mx-auto max-w-xs space-y-2">
                                <InputCn Class="h-12 text-center font-mono text-2xl tracking-[0.5em]" maxlength="6" Placeholder="000000" type="text" @bind-Value="_verificationCode" />
                                <p class="text-center text-xs text-muted-foreground">Code refreshes every 30 seconds</p>
                            </div>
                            <div class="flex gap-2">
                                <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" @onclick='() => _setupStep = (_selectedMethod == "app" ? "scan" : "choose")'>
                                    <LucideArrowLeftCn Size="16" />
                                    Back
                                </ButtonCn>
                                <ButtonCn Class="flex-1" Disabled="@(_verificationCode.Length != 6 || _isVerifying)" @onclick="HandleVerify">
                                    @if (_isVerifying)
                                    {
                                        <LucideLoaderCircleCn Size="16" Class="mr-2 animate-spin" />
                                        <span>Verifying...</span>
                                    }
                                    else
                                    {
                                        <span>Verify &amp; Enable 2FA</span>
                                    }
                                </ButtonCn>
                            </div>
                        </div>
                    }

                    @if (_setupStep == "complete")
                    {
                        <div class="space-y-4">
                            <div class="text-center">
                                <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-emerald-500/10">
                                    <LucideShieldCheckCn Size="24" Class="text-emerald-500" />
                                </div>
                                <h3 class="text-sm font-medium">2FA Enabled Successfully!</h3>
                                <p class="text-xs text-muted-foreground">Your account is now protected with two-factor authentication</p>
                            </div>
                            <div class="rounded-md bg-amber-500/10 p-3">
                                <div class="mb-3 flex items-start gap-2">
                                    <LucideKeyCn Size="16" Class="text-amber-700" />
                                    <div>
                                        <span class="text-sm font-medium text-amber-900">Save Your Backup Codes</span>
                                        <p class="text-xs text-amber-700">Use these codes to access your account if you lose your device</p>
                                    </div>
                                </div>
                                <div class="mb-3 rounded-md border bg-card p-3">
                                    <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
                                        @foreach (var backupCode in _backupCodes)
                                        {
                                            <code class="block rounded-md bg-muted/50 px-2 py-1.5 text-center font-mono text-xs">@backupCode</code>
                                        }
                                    </div>
                                </div>
                                <div class="flex gap-2">
                                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="flex-1" @onclick="HandleCopyBackupCodes">
                                        @if (_copiedBackupCode)
                                        {
                                            <LucideCheckCn Size="16" Class="mr-2 text-emerald-500" />
                                            <span>Copied!</span>
                                        }
                                        else
                                        {
                                            <LucideCopyCn Size="16" Class="mr-2" />
                                            <span>Copy All</span>
                                        }
                                    </ButtonCn>
                                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="flex-1">
                                        <LucideDownloadCn Size="16" Class="mr-2" />
                                        Download
                                    </ButtonCn>
                                </div>
                            </div>
                            <ButtonCn Class="w-full" @onclick='() => _setupStep = "choose"'>Done</ButtonCn>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private bool _is2FAEnabled;
    private string _setupStep = "choose";
    private string _verificationCode = "";
    private bool _copiedSecret;
    private bool _copiedBackupCode;
    private string _selectedMethod = "app";
    private bool _isVerifying;

    private const string SecretKey = "JBSWY3DPEHPK3PXP";
    private string _qrCodeUrl => $"https://api.qrserver.com/v1/create-qr-code/?size=200x200&data={Uri.EscapeDataString($"otpauth://totp/YourApp:user@example.com?secret={SecretKey}&issuer=YourApp")}";

    private static readonly string[] _backupCodes = ["1a2b-3c4d", "5e6f-7g8h", "9i0j-1k2l", "3m4n-5o6p"];

    private void HandleStartSetup(string method)
    {
        _selectedMethod = method;
        _setupStep = method == "app" ? "scan" : "verify";
    }

    private async Task HandleCopySecret()
    {
        _copiedSecret = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copiedSecret = false;
    }

    private async Task HandleCopyBackupCodes()
    {
        _copiedBackupCode = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copiedBackupCode = false;
    }

    private async Task HandleVerify()
    {
        if (_verificationCode.Length == 6)
        {
            _isVerifying = true;
            StateHasChanged();
            await Task.Delay(1500);
            _isVerifying = false;
            _setupStep = "complete";
            _is2FAEnabled = true;
        }
    }

    private void HandleDisable2FA()
    {
        _is2FAEnabled = false;
        _setupStep = "choose";
        _verificationCode = "";
    }
}
