@* ============================================================
   Block: account-organization-settings
   Title: AccountOrganizationSettings
   Description: An organization settings block for React and Next.js with sectioned inline editing for general info, billing contact, security policies, and defaults built with shadcn/ui and Tailwind CSS
   Source: original/blocks/account/account-organization-settings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-5 py-4">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Organization Settings</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Manage identity, billing, security, and defaults for Acme Corporation
                    </p>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 px-2 text-[10px]">
                    Owner
                </BadgeCn>
            </div>
        </div>

        @* General Section *@
        <div class="border-b px-5 py-4">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground uppercase tracking-wide">
                    General
                </span>
                @if (!IsEditing("general"))
                {
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" @onclick="@(() => _editingSection = "general")">
                        <LucideIconCn Name="pencil" Size="12" Class="h-3 w-3" />
                        Edit
                    </ButtonCn>
                }
            </div>

            <div class="mt-3 space-y-3">
                @* Logo + Name Row *@
                <div class="flex items-start gap-4">
                    <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg border-2 border-dashed bg-muted/50">
                        <LucideIconCn Name="image" Size="20" Class="h-5 w-5 text-muted-foreground" />
                    </div>
                    <div class="flex-1 space-y-3">
                        <div>
                            <span class="text-xs text-muted-foreground">Organization name</span>
                            @if (IsEditing("general"))
                            {
                                <InputCn Class="mt-1 text-sm" @bind-Value="@_generalName" />
                            }
                            else
                            {
                                <p class="mt-0.5 text-sm font-medium">@_generalName</p>
                            }
                        </div>
                    </div>
                </div>

                @* Slug *@
                <div>
                    <span class="text-xs text-muted-foreground">URL slug</span>
                    @if (IsEditing("general"))
                    {
                        <div class="mt-1 flex items-center gap-2">
                            <span class="text-xs text-muted-foreground font-mono">app.acme.io/</span>
                            <InputCn Class="flex-1 text-sm font-mono" @bind-Value="@_generalSlug" />
                        </div>
                    }
                    else
                    {
                        <div class="mt-0.5 flex items-center gap-2">
                            <p class="text-sm font-mono text-muted-foreground">
                                app.acme.io/@_generalSlug
                            </p>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 w-6 p-0" @onclick="HandleCopySlug">
                                @if (_slugCopied)
                                {
                                    <LucideIconCn Name="check" Size="12" Class="h-3 w-3 text-emerald-500" />
                                }
                                else
                                {
                                    <LucideIconCn Name="copy" Size="12" Class="h-3 w-3" />
                                }
                            </ButtonCn>
                        </div>
                    }
                </div>

                @* Industry *@
                <div>
                    <span class="text-xs text-muted-foreground">Industry</span>
                    @if (IsEditing("general"))
                    {
                        <SelectCn Value="@_generalIndustry" ValueChanged='v => _generalIndustry = v ?? "technology"'>
                            <SelectTriggerCn Class="mt-1 text-sm">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="technology">Technology</SelectItemCn>
                                <SelectItemCn Value="finance">Finance &amp; Banking</SelectItemCn>
                                <SelectItemCn Value="healthcare">Healthcare</SelectItemCn>
                                <SelectItemCn Value="education">Education</SelectItemCn>
                                <SelectItemCn Value="ecommerce">E-Commerce</SelectItemCn>
                                <SelectItemCn Value="media">Media &amp; Entertainment</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    }
                    else
                    {
                        <p class="mt-0.5 text-sm capitalize">@_generalIndustry</p>
                    }
                </div>
            </div>

            @* Section Footer - General *@
            @if (IsEditing("general"))
            {
                <div class="flex items-center justify-end gap-2 pt-3">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="@(() => _editingSection = null)" Disabled="@(_savingSection == "general")">
                        Cancel
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="@(() => HandleSaveSection("general"))" Disabled="@(_savingSection == "general")">
                        @if (_savingSection == "general")
                        {
                            <LucideIconCn Name="loader-2" Size="12" Class="mr-1.5 h-3 w-3 animate-spin" />
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Save</span>
                        }
                    </ButtonCn>
                </div>
            }
            @if (_savedSection == "general" && !IsEditing("general"))
            {
                <div class="flex items-center justify-end gap-1.5 pt-3">
                    <LucideIconCn Name="check" Size="12" Class="h-3 w-3 text-emerald-500" />
                    <span class="text-xs text-emerald-600">Saved</span>
                </div>
            }
        </div>

        @* Billing Contact Section *@
        <div class="border-b px-5 py-4">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground uppercase tracking-wide">
                    Billing Contact
                </span>
                @if (!IsEditing("billing"))
                {
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" @onclick="@(() => _editingSection = "billing")">
                        <LucideIconCn Name="pencil" Size="12" Class="h-3 w-3" />
                        Edit
                    </ButtonCn>
                }
            </div>

            <div class="mt-3 grid grid-cols-2 gap-x-4 gap-y-3">
                @* Full name *@
                <div>
                    <span class="text-xs text-muted-foreground">Full name</span>
                    @if (IsEditing("billing"))
                    {
                        <InputCn Class="mt-1 text-sm" @bind-Value="@_billingFullName" />
                    }
                    else
                    {
                        <p class="mt-0.5 text-sm">@_billingFullName</p>
                    }
                </div>

                @* Email *@
                <div>
                    <span class="text-xs text-muted-foreground">Email</span>
                    @if (IsEditing("billing"))
                    {
                        <InputCn Class="mt-1 text-sm" Type="email" @bind-Value="@_billingEmail" />
                    }
                    else
                    {
                        <p class="mt-0.5 text-sm">@_billingEmail</p>
                    }
                </div>

                @* Phone *@
                <div>
                    <span class="text-xs text-muted-foreground">Phone</span>
                    @if (IsEditing("billing"))
                    {
                        <InputCn Class="mt-1 text-sm" Type="tel" @bind-Value="@_billingPhone" />
                    }
                    else
                    {
                        <p class="mt-0.5 text-sm">@_billingPhone</p>
                    }
                </div>

                @* Tax ID *@
                <div>
                    <span class="text-xs text-muted-foreground">Tax ID</span>
                    @if (IsEditing("billing"))
                    {
                        <InputCn Class="mt-1 text-sm" @bind-Value="@_billingTaxId" />
                    }
                    else
                    {
                        <p class="mt-0.5 text-sm font-mono text-muted-foreground">@_billingTaxId</p>
                    }
                </div>
            </div>

            @* Section Footer - Billing *@
            @if (IsEditing("billing"))
            {
                <div class="flex items-center justify-end gap-2 pt-3">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="@(() => _editingSection = null)" Disabled="@(_savingSection == "billing")">
                        Cancel
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="@(() => HandleSaveSection("billing"))" Disabled="@(_savingSection == "billing")">
                        @if (_savingSection == "billing")
                        {
                            <LucideIconCn Name="loader-2" Size="12" Class="mr-1.5 h-3 w-3 animate-spin" />
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Save</span>
                        }
                    </ButtonCn>
                </div>
            }
            @if (_savedSection == "billing" && !IsEditing("billing"))
            {
                <div class="flex items-center justify-end gap-1.5 pt-3">
                    <LucideIconCn Name="check" Size="12" Class="h-3 w-3 text-emerald-500" />
                    <span class="text-xs text-emerald-600">Saved</span>
                </div>
            }
        </div>

        @* Security Policies Section *@
        <div class="border-b px-5 py-4">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground uppercase tracking-wide">
                    Security Policies
                </span>
                @if (!IsEditing("security"))
                {
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" @onclick="@(() => _editingSection = "security")">
                        <LucideIconCn Name="pencil" Size="12" Class="h-3 w-3" />
                        Edit
                    </ButtonCn>
                }
            </div>

            <div class="mt-3 space-y-4">
                @* Require 2FA *@
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm">Require two-factor authentication</p>
                        <p class="text-xs text-muted-foreground">
                            All members must enable 2FA to access the organization
                        </p>
                    </div>
                    <SwitchCn Checked="@_securityRequire2FA" CheckedChanged="@(v => _securityRequire2FA = v)" Disabled="@(!IsEditing("security"))" />
                </div>

                @* Password Policy *@
                <div>
                    <span class="text-xs text-muted-foreground">Password complexity</span>
                    @if (IsEditing("security"))
                    {
                        <SelectCn Value="@_securityPasswordPolicy" ValueChanged='v => _securityPasswordPolicy = v ?? "strong"'>
                            <SelectTriggerCn Class="mt-1 text-sm">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="basic">Basic - 8+ characters</SelectItemCn>
                                <SelectItemCn Value="moderate">Moderate - 10+ with mixed case &amp; numbers</SelectItemCn>
                                <SelectItemCn Value="strong">Strong - 12+ with symbols, mixed case &amp; numbers</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    }
                    else
                    {
                        <p class="mt-0.5 text-sm">
                            @if (_securityPasswordPolicy == "basic")
                            {
                                <span>Basic - 8+ characters</span>
                            }
                            @if (_securityPasswordPolicy == "moderate")
                            {
                                <span>Moderate - 10+ with mixed case &amp; numbers</span>
                            }
                            @if (_securityPasswordPolicy == "strong")
                            {
                                <span>Strong - 12+ with symbols, mixed case &amp; numbers</span>
                            }
                        </p>
                    }
                </div>

                @* Session Timeout *@
                <div>
                    <span class="text-xs text-muted-foreground">Session timeout</span>
                    @if (IsEditing("security"))
                    {
                        <SelectCn Value="@_securitySessionTimeout" ValueChanged='v => _securitySessionTimeout = v ?? "480"'>
                            <SelectTriggerCn Class="mt-1 text-sm">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="30">30 minutes</SelectItemCn>
                                <SelectItemCn Value="60">1 hour</SelectItemCn>
                                <SelectItemCn Value="240">4 hours</SelectItemCn>
                                <SelectItemCn Value="480">8 hours</SelectItemCn>
                                <SelectItemCn Value="1440">24 hours</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    }
                    else
                    {
                        <p class="mt-0.5 text-sm">
                            @if (_securitySessionTimeout == "30") { <span>30 minutes</span> }
                            @if (_securitySessionTimeout == "60") { <span>1 hour</span> }
                            @if (_securitySessionTimeout == "240") { <span>4 hours</span> }
                            @if (_securitySessionTimeout == "480") { <span>8 hours</span> }
                            @if (_securitySessionTimeout == "1440") { <span>24 hours</span> }
                        </p>
                    }
                </div>
            </div>

            @* Section Footer - Security *@
            @if (IsEditing("security"))
            {
                <div class="flex items-center justify-end gap-2 pt-3">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="@(() => _editingSection = null)" Disabled="@(_savingSection == "security")">
                        Cancel
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="@(() => HandleSaveSection("security"))" Disabled="@(_savingSection == "security")">
                        @if (_savingSection == "security")
                        {
                            <LucideIconCn Name="loader-2" Size="12" Class="mr-1.5 h-3 w-3 animate-spin" />
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Save</span>
                        }
                    </ButtonCn>
                </div>
            }
            @if (_savedSection == "security" && !IsEditing("security"))
            {
                <div class="flex items-center justify-end gap-1.5 pt-3">
                    <LucideIconCn Name="check" Size="12" Class="h-3 w-3 text-emerald-500" />
                    <span class="text-xs text-emerald-600">Saved</span>
                </div>
            }
        </div>

        @* Defaults Section *@
        <div class="px-5 py-4">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground uppercase tracking-wide">
                    Defaults
                </span>
                @if (!IsEditing("defaults"))
                {
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" @onclick="@(() => _editingSection = "defaults")">
                        <LucideIconCn Name="pencil" Size="12" Class="h-3 w-3" />
                        Edit
                    </ButtonCn>
                }
            </div>

            <div class="mt-3 grid grid-cols-2 gap-x-4 gap-y-3">
                @* Timezone *@
                <div>
                    <span class="text-xs text-muted-foreground">Timezone</span>
                    @if (IsEditing("defaults"))
                    {
                        <SelectCn Value="@_defaultsTimezone" ValueChanged='v => _defaultsTimezone = v ?? "america-new-york"'>
                            <SelectTriggerCn Class="mt-1 text-sm">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="america-new-york">America/New_York (EST)</SelectItemCn>
                                <SelectItemCn Value="america-chicago">America/Chicago (CST)</SelectItemCn>
                                <SelectItemCn Value="america-los-angeles">America/Los_Angeles (PST)</SelectItemCn>
                                <SelectItemCn Value="europe-london">Europe/London (GMT)</SelectItemCn>
                                <SelectItemCn Value="asia-tokyo">Asia/Tokyo (JST)</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    }
                    else
                    {
                        <p class="mt-0.5 text-sm">
                            @if (_defaultsTimezone == "america-new-york") { <span>America/New_York (EST)</span> }
                            @if (_defaultsTimezone == "america-chicago") { <span>America/Chicago (CST)</span> }
                            @if (_defaultsTimezone == "america-los-angeles") { <span>America/Los_Angeles (PST)</span> }
                            @if (_defaultsTimezone == "europe-london") { <span>Europe/London (GMT)</span> }
                            @if (_defaultsTimezone == "asia-tokyo") { <span>Asia/Tokyo (JST)</span> }
                        </p>
                    }
                </div>

                @* Language *@
                <div>
                    <span class="text-xs text-muted-foreground">Language</span>
                    @if (IsEditing("defaults"))
                    {
                        <SelectCn Value="@_defaultsLanguage" ValueChanged='v => _defaultsLanguage = v ?? "en-us"'>
                            <SelectTriggerCn Class="mt-1 text-sm">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="en-us">English (US)</SelectItemCn>
                                <SelectItemCn Value="en-gb">English (UK)</SelectItemCn>
                                <SelectItemCn Value="es">Spanish</SelectItemCn>
                                <SelectItemCn Value="fr">French</SelectItemCn>
                                <SelectItemCn Value="de">German</SelectItemCn>
                                <SelectItemCn Value="ja">Japanese</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    }
                    else
                    {
                        <p class="mt-0.5 text-sm">
                            @if (_defaultsLanguage == "en-us") { <span>English (US)</span> }
                            @if (_defaultsLanguage == "en-gb") { <span>English (UK)</span> }
                            @if (_defaultsLanguage == "es") { <span>Spanish</span> }
                            @if (_defaultsLanguage == "fr") { <span>French</span> }
                            @if (_defaultsLanguage == "de") { <span>German</span> }
                            @if (_defaultsLanguage == "ja") { <span>Japanese</span> }
                        </p>
                    }
                </div>
            </div>

            @* Section Footer - Defaults *@
            @if (IsEditing("defaults"))
            {
                <div class="flex items-center justify-end gap-2 pt-3">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="@(() => _editingSection = null)" Disabled="@(_savingSection == "defaults")">
                        Cancel
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="@(() => HandleSaveSection("defaults"))" Disabled="@(_savingSection == "defaults")">
                        @if (_savingSection == "defaults")
                        {
                            <LucideIconCn Name="loader-2" Size="12" Class="mr-1.5 h-3 w-3 animate-spin" />
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Save</span>
                        }
                    </ButtonCn>
                </div>
            }
            @if (_savedSection == "defaults" && !IsEditing("defaults"))
            {
                <div class="flex items-center justify-end gap-1.5 pt-3">
                    <LucideIconCn Name="check" Size="12" Class="h-3 w-3 text-emerald-500" />
                    <span class="text-xs text-emerald-600">Saved</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    // General
    private string _generalName = "Acme Corporation";
    private string _generalSlug = "acme-corp";
    private string _generalIndustry = "technology";

    // Billing Contact
    private string _billingFullName = "Sarah Chen";
    private string _billingEmail = "billing@acme-corp.com";
    private string _billingPhone = "+1 (415) 555-0198";
    private string _billingTaxId = "US-87-2914583";

    // Security Policies
    private bool _securityRequire2FA = true;
    private string _securityPasswordPolicy = "strong";
    private string _securitySessionTimeout = "480";

    // Defaults
    private string _defaultsTimezone = "america-new-york";
    private string _defaultsLanguage = "en-us";

    // UI state
    private string? _editingSection;
    private string? _savingSection;
    private string? _savedSection;
    private bool _slugCopied;

    private bool IsEditing(string section) => _editingSection == section;

    private async Task HandleSaveSection(string sectionId)
    {
        _savingSection = sectionId;
        StateHasChanged();
        await Task.Delay(1200);
        _savingSection = null;
        _editingSection = null;
        _savedSection = sectionId;
        StateHasChanged();
        await Task.Delay(2000);
        _savedSection = null;
    }

    private async Task HandleCopySlug()
    {
        _slugCopied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _slugCopied = false;
    }
}
