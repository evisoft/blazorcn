@* ============================================================
   Block: account-language-region
   Title: Account Language Region
   Description: Language and region settings with locale, timezone, date format, currency, and accessibility preferences
   Long Description: Language and region settings
   Dependencies: ButtonCn, LabelCn, RadioGroupCn, RadioGroupItemCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, SwitchCn, LucideCircleCheckCn, LucideClockCn, LucideGlobeCn
   Source: original/blocks/account/account-language-region.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <LucideGlobeCn Size="16" Class="text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Language & Region</h2>
                        <p class="text-xs text-muted-foreground">
                            Set your language, timezone, and regional preferences
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm">
                    <LucideCircleCheckCn Size="14" Class="mr-1.5" />
                    Save
                </ButtonCn>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="mb-3 block text-xs font-medium uppercase tracking-wider text-muted-foreground">Language</span>

            <div class="space-y-3">
                <div>
                    <LabelCn Class="text-xs font-medium text-muted-foreground">Display Language</LabelCn>
                    <SelectCn Value="@_selectedLanguage" ValueChanged='v => _selectedLanguage = v ?? "en"'>
                        <SelectTriggerCn Class="mt-1">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="en">English</SelectItemCn>
                            <SelectItemCn Value="es">Spanish (Espanol)</SelectItemCn>
                            <SelectItemCn Value="fr">French (Francais)</SelectItemCn>
                            <SelectItemCn Value="de">German (Deutsch)</SelectItemCn>
                            <SelectItemCn Value="ja">Japanese</SelectItemCn>
                            <SelectItemCn Value="zh">Chinese</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>

                <div class="flex items-center justify-between rounded-md bg-muted/50 p-3">
                    <div>
                        <p class="text-sm font-medium">Auto-translate content</p>
                        <p class="text-xs text-muted-foreground">Translate user-generated content</p>
                    </div>
                    <SwitchCn Checked="_autoTranslate" CheckedChanged="v => _autoTranslate = v" />
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="mb-3 block text-xs font-medium uppercase tracking-wider text-muted-foreground">Region & Timezone</span>

            <div class="space-y-3">
                <div>
                    <div class="mb-1 flex items-center justify-between">
                        <LabelCn Class="text-xs font-medium text-muted-foreground">Timezone</LabelCn>
                        <div class="flex items-center gap-2">
                            <SwitchCn Checked="_autoDetectTimezone" CheckedChanged="v => _autoDetectTimezone = v" />
                            <LabelCn Class="text-xs font-normal text-muted-foreground">Auto-detect</LabelCn>
                        </div>
                    </div>
                    <SelectCn Value="@_selectedTimezone" ValueChanged='v => _selectedTimezone = v ?? "America/New_York"' Disabled="_autoDetectTimezone">
                        <SelectTriggerCn>
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="America/New_York">Eastern Time (ET) UTC-5</SelectItemCn>
                            <SelectItemCn Value="America/Los_Angeles">Pacific Time (PT) UTC-8</SelectItemCn>
                            <SelectItemCn Value="Europe/London">London (GMT) UTC+0</SelectItemCn>
                            <SelectItemCn Value="Asia/Tokyo">Tokyo (JST) UTC+9</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                    <p class="mt-1 flex items-center gap-1 text-xs text-muted-foreground">
                        <LucideClockCn Size="12" />
                        Current time: @(_timeFormat == "12h" ? "3:30 PM" : "15:30") (UTC-5)
                    </p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="mb-3 block text-xs font-medium uppercase tracking-wider text-muted-foreground">Date & Time Format</span>

            <div class="space-y-4">
                <div>
                    <LabelCn Class="text-xs font-medium text-muted-foreground">Date Format</LabelCn>
                    <RadioGroupCn Class="mt-2 space-y-2" Value="@_dateFormat" ValueChanged='v => _dateFormat = v ?? "mdy"'>
                        <div class="flex items-center space-x-2">
                            <RadioGroupItemCn Value="mdy" />
                            <LabelCn Class="text-sm font-normal">MM/DD/YYYY</LabelCn>
                        </div>
                        <div class="flex items-center space-x-2">
                            <RadioGroupItemCn Value="dmy" />
                            <LabelCn Class="text-sm font-normal">DD/MM/YYYY</LabelCn>
                        </div>
                        <div class="flex items-center space-x-2">
                            <RadioGroupItemCn Value="ymd" />
                            <LabelCn Class="text-sm font-normal">YYYY-MM-DD</LabelCn>
                        </div>
                    </RadioGroupCn>
                </div>

                <div>
                    <LabelCn Class="text-xs font-medium text-muted-foreground">Time Format</LabelCn>
                    <RadioGroupCn Class="mt-2 space-y-2" Value="@_timeFormat" ValueChanged='v => _timeFormat = v ?? "12h"'>
                        <div class="flex items-center space-x-2">
                            <RadioGroupItemCn Value="12h" />
                            <LabelCn Class="text-sm font-normal">12-hour (AM/PM)</LabelCn>
                        </div>
                        <div class="flex items-center space-x-2">
                            <RadioGroupItemCn Value="24h" />
                            <LabelCn Class="text-sm font-normal">24-hour</LabelCn>
                        </div>
                    </RadioGroupCn>
                </div>

                <div class="rounded-md bg-muted/50 p-3">
                    <p class="text-sm font-medium">Format Preview</p>
                    <p class="text-xs text-muted-foreground">
                        Date: <span class="font-mono">@FormatDateExample()</span>
                        &bull;
                        Time: <span class="font-mono">@(_timeFormat == "12h" ? "3:30 PM" : "15:30")</span>
                    </p>
                </div>
            </div>
        </div>

        <div class="px-4 py-3">
            <span class="mb-3 block text-xs font-medium uppercase tracking-wider text-muted-foreground">Currency & Units</span>

            <div class="space-y-3">
                <div>
                    <LabelCn Class="text-xs font-medium text-muted-foreground">Currency</LabelCn>
                    <SelectCn Value="@_selectedCurrency" ValueChanged='v => _selectedCurrency = v ?? "USD"'>
                        <SelectTriggerCn Class="mt-1">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="USD">$ US Dollar (USD)</SelectItemCn>
                            <SelectItemCn Value="EUR">Euro (EUR)</SelectItemCn>
                            <SelectItemCn Value="GBP">British Pound (GBP)</SelectItemCn>
                            <SelectItemCn Value="JPY">Japanese Yen (JPY)</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>

                <div>
                    <LabelCn Class="text-xs font-medium text-muted-foreground">Measurement Units</LabelCn>
                    <RadioGroupCn Class="mt-2 space-y-2" Value="@_measurementUnit" ValueChanged='v => _measurementUnit = v ?? "imperial"'>
                        <div class="flex items-center space-x-2">
                            <RadioGroupItemCn Value="imperial" />
                            <LabelCn Class="text-sm font-normal">Imperial (miles, pounds, deg F)</LabelCn>
                        </div>
                        <div class="flex items-center space-x-2">
                            <RadioGroupItemCn Value="metric" />
                            <LabelCn Class="text-sm font-normal">Metric (km, kg, deg C)</LabelCn>
                        </div>
                    </RadioGroupCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string _selectedLanguage = "en";
    private string _selectedTimezone = "America/New_York";
    private string _selectedCurrency = "USD";
    private string _dateFormat = "mdy";
    private string _timeFormat = "12h";
    private string _measurementUnit = "imperial";
    private bool _autoDetectTimezone = true;
    private bool _autoTranslate = true;

    private string FormatDateExample() => _dateFormat switch
    {
        "mdy" => "12/25/2024",
        "dmy" => "25/12/2024",
        "ymd" => "2024-12-25",
        _ => "12/25/2024",
    };
}
