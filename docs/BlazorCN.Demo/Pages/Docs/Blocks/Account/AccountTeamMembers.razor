@* ============================================================
   Block: account-team-members
   Title: AccountTeamMembers
   Description: A team member management table for React and Next.js with role assignment, member invitation, pending invites tracking, seat usage counter, and removal confirmation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/account/account-team-members.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Team Members</h2>
                    <p class="text-xs text-muted-foreground">
                        Manage roles and access for your workspace
                    </p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" @onclick="@(() => _showInviteForm = !_showInviteForm)">
                    <LucideIconCn Name="user-plus" Size="14" Class="h-3.5 w-3.5" />
                    Invite
                </ButtonCn>
            </div>
        </div>

        @* Invite Form *@
        @if (_showInviteForm)
        {
            <div class="overflow-hidden border-b">
                <div class="px-4 py-3 space-y-2">
                    <span class="text-xs font-medium text-muted-foreground">INVITE NEW MEMBER</span>
                    <div class="flex items-center gap-2">
                        <InputCn aria-label="Invite new member" Placeholder="name@company.com" Type="email" @bind-Value="_inviteEmail" Class="h-8 flex-1 text-sm" @onkeydown="HandleInviteKeyDown" Disabled="@_isSendingInvite" />
                        <SelectCn Value="@_inviteRole" ValueChanged="@((string v) => _inviteRole = v)">
                            <SelectTriggerCn aria-label="Role" Class="h-8 w-28 text-xs">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="admin">Admin</SelectItemCn>
                                <SelectItemCn Value="member">Member</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                        <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" Disabled="@(string.IsNullOrWhiteSpace(_inviteEmail) || _isSendingInvite)" @onclick="HandleSendInvite">
                            @if (_isSendingInvite)
                            {
                                <LucideIconCn Name="loader-2" Size="14" Class="h-3.5 w-3.5 animate-spin" />
                            }
                            else
                            {
                                <LucideIconCn Name="send" Size="14" Class="h-3.5 w-3.5" />
                            }
                            Send
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="h-8 w-8" @onclick="@(() => _showInviteForm = false)" aria-label="Close">
                            <LucideIconCn Name="x" Size="14" Class="h-3.5 w-3.5" />
                        </ButtonCn>
                    </div>
                </div>
            </div>
        }

        @* Pending Invitations *@
        @if (_pendingInvites.Count > 0)
        {
            <div class="border-b">
                <div class="px-4 py-2">
                    <span class="text-xs font-medium text-muted-foreground">
                        PENDING INVITATIONS (@_pendingInvites.Count)
                    </span>
                </div>
                @foreach (var invite in _pendingInvites)
                {
                    <div class="flex items-center gap-3 border-t px-4 py-2.5">
                        <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-muted/50">
                            <LucideIconCn Name="mail" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm">@invite.Email</span>
                            <p class="text-[10px] text-muted-foreground">
                                @GetRoleLabel(invite.Role) -- Invited by @invite.InvitedBy -- Expires in @invite.ExpiresIn
                            </p>
                        </div>
                        <div class="flex items-center gap-1">
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-[10px]" Disabled="@(_resendingId == invite.Id)" @onclick="@(() => HandleResendInvite(invite.Id))">
                                @if (_resendingId == invite.Id)
                                {
                                    <LucideIconCn Name="loader-2" Size="12" Class="h-3 w-3 animate-spin" />
                                }
                                else
                                {
                                    <LucideIconCn Name="send" Size="12" Class="h-3 w-3" />
                                }
                                Resend
                            </ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-[10px] text-destructive hover:text-destructive" @onclick="@(() => HandleCancelInvite(invite.Id))">
                                <LucideIconCn Name="x" Size="12" Class="h-3 w-3" />
                                Revoke
                            </ButtonCn>
                        </div>
                    </div>
                }
            </div>
        }

        @* Members Table *@
        <div>
            <TableCn>
                <TableHeaderCn>
                    <TableRowCn Class="hover:bg-transparent">
                        <TableHeadCn Class="h-8 text-[10px] font-medium uppercase text-muted-foreground">
                            Member
                        </TableHeadCn>
                        <TableHeadCn Class="h-8 text-[10px] font-medium uppercase text-muted-foreground">
                            Role
                        </TableHeadCn>
                        <TableHeadCn Class="h-8 text-[10px] font-medium uppercase text-muted-foreground">
                            Status
                        </TableHeadCn>
                        <TableHeadCn Class="h-8 text-[10px] font-medium uppercase text-muted-foreground">
                            Joined
                        </TableHeadCn>
                        <TableHeadCn Class="h-8 w-10"><span class="sr-only">Actions</span></TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var member in _members)
                    {
                        <TableRowCn Class="border-t transition-colors hover:bg-muted/50">
                            <TableCellCn Class="py-2.5">
                                <div class="flex items-center gap-2.5">
                                    <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-muted/50 text-[10px] font-medium">
                                        @GetInitials(member.Name)
                                    </div>
                                    <div class="min-w-0">
                                        <span class="text-sm font-medium">@member.Name</span>
                                        <p class="truncate text-[10px] text-muted-foreground">
                                            @member.Email
                                        </p>
                                    </div>
                                </div>
                            </TableCellCn>
                            <TableCellCn Class="py-2.5">
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 gap-1 px-1.5 text-[10px]">
                                    <LucideIconCn Name="@GetRoleIcon(member.Role)" Size="10" Class="h-2.5 w-2.5" />
                                    @GetRoleLabel(member.Role)
                                </BadgeCn>
                            </TableCellCn>
                            <TableCellCn Class="py-2.5">
                                <div class="flex items-center gap-1.5">
                                    <span class="@($"size-1.5 rounded-full {GetStatusDotClass(member.Status)}")"></span>
                                    <span class="text-xs text-muted-foreground">@GetStatusLabel(member.Status)</span>
                                </div>
                            </TableCellCn>
                            <TableCellCn Class="py-2.5">
                                <span class="text-xs text-muted-foreground">@member.JoinedAt</span>
                            </TableCellCn>
                            <TableCellCn Class="py-2.5">
                                @if (member.Role != "owner")
                                {
                                    <DropdownMenuCn>
                                        <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-ghost cn-button-size-icon h-7 w-7" data-variant="ghost" data-size="icon" aria-label="More options">
                                                <LucideIconCn Name="more-horizontal" Size="14" Class="h-3.5 w-3.5" />
                                            </DropdownMenuTriggerCn>
                                        <DropdownMenuContentCn Align="FloatingAlign.End">
                                            <DropdownMenuItemCn @onclick="@(() => HandleChangeRole(member.Id, member.Role == "admin" ? "member" : "admin"))">
                                                <LucideIconCn Name="chevron-down" Size="14" Class="mr-2 h-3.5 w-3.5" />
                                                Change to @(member.Role == "admin" ? "Member" : "Admin")
                                            </DropdownMenuItemCn>
                                            <DropdownMenuSeparatorCn />
                                            <DropdownMenuItemCn Class="text-destructive focus:text-destructive" @onclick="@(() => _removeTarget = member)">
                                                <LucideIconCn Name="trash-2" Size="14" Class="mr-2 h-3.5 w-3.5" />
                                                Remove member
                                            </DropdownMenuItemCn>
                                        </DropdownMenuContentCn>
                                    </DropdownMenuCn>
                                }
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        @* Seat Usage Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <span class="text-xs text-muted-foreground">
                        @ActiveCount of 10 seats used
                    </span>
                    <div class="h-1.5 w-24 overflow-hidden rounded-full bg-muted">
                        <div class="h-full rounded-full bg-foreground/70 transition-all" style="@(FormattableString.Invariant($"width:{Math.Min(SeatPercentage, 100)}%"))"></div>
                    </div>
                </div>
                <span class="text-[10px] text-muted-foreground">Team plan</span>
            </div>
        </div>
    </div>

    @* Remove Confirmation Dialog *@
    <AlertDialogCn Open="@(_removeTarget != null)" OpenChanged="@((bool open) => { if (!open) _removeTarget = null; })">
        <AlertDialogContentCn>
            <AlertDialogHeaderCn>
                <AlertDialogTitleCn>Remove team member?</AlertDialogTitleCn>
                <AlertDialogDescriptionCn>
                    @(_removeTarget?.Name) (@(_removeTarget?.Email)) will lose access to all workspace
                    resources. You can re-invite them later if needed.
                </AlertDialogDescriptionCn>
            </AlertDialogHeaderCn>
            <AlertDialogFooterCn>
                <AlertDialogCancelCn Disabled="@_isRemoving">Cancel</AlertDialogCancelCn>
                <ButtonCn Variant="ButtonVariant.Destructive" Disabled="@_isRemoving" @onclick="HandleRemoveMember">
                    @if (_isRemoving)
                    {
                        <LucideIconCn Name="loader-2" Size="14" Class="mr-1.5 h-3.5 w-3.5 animate-spin" />
                        <text>Removing...</text>
                    }
                    else
                    {
                        <text>Remove member</text>
                    }
                </ButtonCn>
            </AlertDialogFooterCn>
        </AlertDialogContentCn>
    </AlertDialogCn>
</section>

@code {
    private record TeamMember(string Id, string Name, string Email, string Role, string Status, string JoinedAt, string LastActive);
    private record PendingInvite(string Id, string Email, string Role, string InvitedBy, string SentAt, string ExpiresIn);

    private List<TeamMember> _members =
    [
        new("m1", "Elena Vasquez", "elena@acmecorp.com", "owner", "active", "Jan 2024", "Just now"),
        new("m2", "Marcus Chen", "marcus.chen@acmecorp.com", "admin", "active", "Mar 2024", "3 hours ago"),
        new("m3", "Priya Sharma", "priya@acmecorp.com", "member", "active", "Jun 2024", "1 day ago"),
        new("m4", "James Thornton", "james.t@acmecorp.com", "member", "active", "Sep 2024", "5 min ago"),
        new("m5", "Aisha Nkomo", "aisha@acmecorp.com", "admin", "suspended", "Nov 2024", "2 weeks ago"),
    ];

    private List<PendingInvite> _pendingInvites =
    [
        new("inv1", "kai.rodriguez@acmecorp.com", "member", "Elena Vasquez", "2 days ago", "5 days"),
        new("inv2", "sophie.muller@contractor.io", "member", "Marcus Chen", "4 hours ago", "7 days"),
    ];

    private string _inviteEmail = "";
    private string _inviteRole = "member";
    private bool _showInviteForm = false;
    private bool _isSendingInvite = false;
    private TeamMember? _removeTarget = null;
    private bool _isRemoving = false;
    private string? _resendingId = null;

    private int ActiveCount => _members.Count(m => m.Status == "active");
    private int SeatPercentage => (int)Math.Round(((double)(ActiveCount + _pendingInvites.Count) / 10) * 100);

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ');
        return string.Join("", parts.Select(n => char.ToUpper(n[0]))).Substring(0, Math.Min(2, parts.Length));
    }

    private static string GetRoleLabel(string role) => role switch
    {
        "owner" => "Owner",
        "admin" => "Admin",
        _ => "Member",
    };

    private static string GetRoleIcon(string role) => role switch
    {
        "owner" => "crown",
        "admin" => "shield",
        _ => "user",
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "active" => "Active",
        "invited" => "Invited",
        "suspended" => "Suspended",
        _ => status,
    };

    private static string GetStatusDotClass(string status) => status switch
    {
        "active" => "bg-emerald-500",
        "invited" => "bg-amber-500",
        "suspended" => "bg-red-500",
        _ => "bg-muted",
    };

    private void HandleInviteKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            _ = HandleSendInvite();
    }

    private async Task HandleSendInvite()
    {
        if (string.IsNullOrWhiteSpace(_inviteEmail)) return;
        _isSendingInvite = true;
        await Task.Delay(1200);
        _pendingInvites.Add(new($"inv-{_pendingInvites.Count + 3}", _inviteEmail, _inviteRole, "You", "Just now", "7 days"));
        _inviteEmail = "";
        _isSendingInvite = false;
        _showInviteForm = false;
    }

    private void HandleChangeRole(string memberId, string newRole)
    {
        var idx = _members.FindIndex(m => m.Id == memberId);
        if (idx >= 0)
            _members[idx] = _members[idx] with { Role = newRole };
    }

    private async Task HandleRemoveMember()
    {
        if (_removeTarget is null) return;
        _isRemoving = true;
        await Task.Delay(1200);
        _members.RemoveAll(m => m.Id == _removeTarget!.Id);
        _removeTarget = null;
        _isRemoving = false;
    }

    private async Task HandleResendInvite(string inviteId)
    {
        _resendingId = inviteId;
        await Task.Delay(1200);
        _resendingId = null;
    }

    private void HandleCancelInvite(string inviteId)
    {
        _pendingInvites.RemoveAll(i => i.Id == inviteId);
    }
}
