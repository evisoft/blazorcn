@* ============================================================
   Block: account-change-password
   Title: Account Change Password
   Description: Dedicated password change form with current password verification, new password requirements validation, strength meter, show/hide toggles, and confirmation matching
   Long Description: Password change form with strength validation
   Dependencies: ButtonCn, InputCn, LabelCn, ProgressCn, LucideCircleAlertCn, LucideCheckCn, LucideEyeCn, LucideEyeOffCn, LucideLoaderCircleCn, LucideXCn
   Source: original/blocks/account/account-change-password.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Change Password</h2>
            <p class="text-muted-foreground text-xs">
                Update your password to keep your account secure
            </p>
        </div>

        <div class="space-y-6 px-4 py-6">
            @if (_success)
            {
                <div class="flex flex-col items-center justify-center py-6 text-center">
                    <div class="mb-4 flex size-16 items-center justify-center rounded-full bg-muted">
                        <LucideCheckCn Size="32" Class="text-emerald-600" />
                    </div>
                    <h3 class="text-sm font-semibold">Password Changed Successfully</h3>
                    <p class="mt-2 max-w-sm text-muted-foreground text-xs">
                        Your password has been updated. You may need to log in again on other devices.
                    </p>
                    <ButtonCn Class="mt-6" @onclick="() => _success = false">
                        Change Password Again
                    </ButtonCn>
                </div>
            }
            else
            {
                @* Current Password *@
                <div class="space-y-3">
                    <span class="text-xs font-medium text-muted-foreground">CURRENT PASSWORD</span>
                    <div class="space-y-2">
                        <LabelCn Class="text-xs" For="current-password">Enter your current password</LabelCn>
                        <div class="relative">
                            <InputCn Class="h-11 pr-10" Placeholder="Enter current password" Type="@(_showCurrent ? "text" : "password")" Value="@_currentPassword" ValueChanged='v => _currentPassword = v ?? ""' />
                            <ButtonCn Class="absolute right-0 top-0 h-full px-3 hover:bg-transparent" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="() => _showCurrent = !_showCurrent">
                                @if (_showCurrent)
                                {
                                    <LucideEyeOffCn Size="16" Class="text-muted-foreground" />
                                }
                                else
                                {
                                    <LucideEyeCn Size="16" Class="text-muted-foreground" />
                                }
                            </ButtonCn>
                        </div>
                    </div>
                </div>

                @* New Password *@
                <div class="space-y-3">
                    <span class="text-xs font-medium text-muted-foreground">NEW PASSWORD</span>
                    <div class="space-y-2">
                        <LabelCn Class="text-xs" For="new-password">Create a strong password</LabelCn>
                        <div class="relative">
                            <InputCn Class="h-11 pr-10" Placeholder="Enter new password" Type="@(_showNew ? "text" : "password")" Value="@_newPassword" ValueChanged='v => _newPassword = v ?? ""' />
                            <ButtonCn Class="absolute right-0 top-0 h-full px-3 hover:bg-transparent" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="() => _showNew = !_showNew">
                                @if (_showNew)
                                {
                                    <LucideEyeOffCn Size="16" Class="text-muted-foreground" />
                                }
                                else
                                {
                                    <LucideEyeCn Size="16" Class="text-muted-foreground" />
                                }
                            </ButtonCn>
                        </div>

                        @if (!string.IsNullOrEmpty(_newPassword))
                        {
                            var strength = GetPasswordStrength(_newPassword);
                            var strengthInfo = GetStrengthLabel(strength);
                            <div class="mt-4 space-y-3">
                                <div class="flex items-center justify-between text-xs">
                                    <span class="text-muted-foreground">Password strength</span>
                                    <span class="@($"font-medium {strengthInfo.Color}")">@strengthInfo.Text</span>
                                </div>
                                <ProgressCn Class="h-2" Value="@strength" />

                                <div class="mt-4 rounded-md border p-3">
                                    <p class="mb-3 text-xs font-medium">Requirements</p>
                                    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                                        @foreach (var req in GetPasswordRequirements(_newPassword))
                                        {
                                            <div class="flex items-center gap-2 text-xs">
                                                @if (req.Met)
                                                {
                                                    <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                                                }
                                                else
                                                {
                                                    <span class="size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                                                }
                                                <span class="@(req.Met ? "text-foreground" : "text-muted-foreground")">@req.Label</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @* Confirm Password *@
                <div class="space-y-3">
                    <span class="text-xs font-medium text-muted-foreground">CONFIRM PASSWORD</span>
                    <div class="space-y-2">
                        <LabelCn Class="text-xs" For="confirm-password">Re-enter your new password</LabelCn>
                        <div class="relative">
                            <InputCn Class="h-11 pr-10" Placeholder="Confirm new password" Type="@(_showConfirm ? "text" : "password")" Value="@_confirmPassword" ValueChanged='v => _confirmPassword = v ?? ""' />
                            <ButtonCn Class="absolute right-0 top-0 h-full px-3 hover:bg-transparent" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="() => _showConfirm = !_showConfirm">
                                @if (_showConfirm)
                                {
                                    <LucideEyeOffCn Size="16" Class="text-muted-foreground" />
                                }
                                else
                                {
                                    <LucideEyeCn Size="16" Class="text-muted-foreground" />
                                }
                            </ButtonCn>
                        </div>
                        @if (!string.IsNullOrEmpty(_confirmPassword) && !PasswordsMatch)
                        {
                            <p class="mt-2 flex items-center gap-2 text-xs text-destructive">
                                <LucideXCn Size="16" />
                                Passwords do not match
                            </p>
                        }
                        @if (!string.IsNullOrEmpty(_confirmPassword) && PasswordsMatch)
                        {
                            <p class="mt-2 flex items-center gap-2 text-xs text-emerald-600">
                                <LucideCheckCn Size="16" />
                                Passwords match
                            </p>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="flex items-center gap-3 rounded-md bg-muted/50 p-3">
                        <LucideCircleAlertCn Size="16" Class="shrink-0 text-destructive" />
                        <p class="text-xs text-destructive">@_error</p>
                    </div>
                }

                <div class="flex items-center justify-end gap-3 border-t pt-4">
                    <ButtonCn Variant="ButtonVariant.Outline">Cancel</ButtonCn>
                    <ButtonCn Class="min-w-[140px]" Disabled="@(!CanSubmit || _isLoading)" @onclick="HandleSubmit">
                        @if (_isLoading)
                        {
                            <LucideLoaderCircleCn Size="16" Class="mr-2 animate-spin" />
                            <span>Updating...</span>
                        }
                        else
                        {
                            <span>Update Password</span>
                        }
                    </ButtonCn>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record PasswordRequirement(string Label, bool Met);
    private record StrengthInfo(string Text, string Color);

    private string _currentPassword = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private bool _showCurrent;
    private bool _showNew;
    private bool _showConfirm;
    private string? _error;
    private bool _success;
    private bool _isLoading;

    private bool PasswordsMatch => !string.IsNullOrEmpty(_newPassword) && _newPassword == _confirmPassword;
    private bool CanSubmit => !string.IsNullOrEmpty(_currentPassword) && GetPasswordRequirements(_newPassword).All(r => r.Met) && PasswordsMatch;

    private static int GetPasswordStrength(string password)
    {
        int strength = 0;
        if (password.Length >= 8) strength += 25;
        if (password.Length >= 12) strength += 25;
        if (password.Any(char.IsLower) && password.Any(char.IsUpper)) strength += 20;
        if (password.Any(char.IsDigit)) strength += 15;
        if (password.Any(c => !char.IsLetterOrDigit(c))) strength += 15;
        return Math.Min(strength, 100);
    }

    private static StrengthInfo GetStrengthLabel(int strength) => strength switch
    {
        < 40 => new("Weak", "text-red-600"),
        < 60 => new("Fair", "text-orange-600"),
        < 80 => new("Good", "text-yellow-600"),
        _ => new("Strong", "text-green-600")
    };

    private static PasswordRequirement[] GetPasswordRequirements(string password) =>
    [
        new("At least 8 characters", password.Length >= 8),
        new("Contains uppercase letter", password.Any(char.IsUpper)),
        new("Contains lowercase letter", password.Any(char.IsLower)),
        new("Contains number", password.Any(char.IsDigit)),
        new("Contains special character", password.Any(c => !char.IsLetterOrDigit(c))),
    ];

    private async Task HandleSubmit()
    {
        _error = null;
        if (!CanSubmit)
        {
            _error = "Please fill all fields correctly";
            return;
        }
        _isLoading = true;
        StateHasChanged();
        await Task.Delay(1500);
        _isLoading = false;
        _success = true;
        _currentPassword = "";
        _newPassword = "";
        _confirmPassword = "";
    }
}
