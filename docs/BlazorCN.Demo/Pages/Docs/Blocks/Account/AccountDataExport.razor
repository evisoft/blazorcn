@* ============================================================
   Block: account-data-export
   Title: Account Data Export
   Description: Account data management with GDPR-compliant data export, account data overview, download history, scheduled exports, and data deletion requests
   Dependencies: AlertDialogCn, BadgeCn, ButtonCn, SelectCn
   Source: original/blocks/account/account-data-export.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex-1">
                    <h2 class="text-sm font-medium">Your Data</h2>
                    <p class="text-xs text-muted-foreground">Export, download, or request deletion of your data</p>
                </div>
                <div class="flex items-center gap-2">
                    <BadgeCn Class="h-4 px-1.5 text-xs" Variant="BadgeVariant.Secondary">@_totalItems.ToString("N0") items</BadgeCn>
                    <BadgeCn Class="h-4 px-1.5 text-xs" Variant="BadgeVariant.Secondary">2.6 GB</BadgeCn>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <h3 class="mb-3 text-xs font-medium text-muted-foreground">DATA OVERVIEW</h3>
            <div class="space-y-3">
                @foreach (var category in _dataCategories)
                {
                    <div class="flex items-start gap-3 rounded-md border p-3">
                        <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-blue-500"></span>
                        <div class="min-w-0 flex-1">
                            <div class="mb-0.5 flex items-center justify-between">
                                <p class="text-xs font-medium">@category.Name</p>
                                <BadgeCn Class="h-4 px-1.5 text-xs" Variant="BadgeVariant.Secondary">@category.Size</BadgeCn>
                            </div>
                            <p class="text-xs text-muted-foreground">@category.Description</p>
                            <p class="mt-1 text-xs text-muted-foreground">@category.ItemCount.ToString("N0") items</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <h3 class="mb-3 text-xs font-medium text-muted-foreground">EXPORT YOUR DATA</h3>
            <div class="rounded-md border p-3">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-end">
                    <div class="flex-1 space-y-2">
                        <p class="text-xs font-medium">Download a copy of your data</p>
                        <p class="text-xs text-muted-foreground">Export links are valid for 7 days.</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <SelectCn Value="@_exportFormat" ValueChanged="@((string v) => _exportFormat = v)">
                            <SelectTriggerCn Class="h-10 w-32">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="json">JSON</SelectItemCn>
                                <SelectItemCn Value="csv">CSV</SelectItemCn>
                                <SelectItemCn Value="html">HTML</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                        <ButtonCn Class="min-w-[140px] gap-2" Size="ButtonSize.Sm">
                            <LucideDownloadCn Class="size-4" Size="16" />
                            Export Data
                        </ButtonCn>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <h3 class="mb-3 text-xs font-medium text-muted-foreground">EXPORT HISTORY</h3>
            <div class="space-y-3">
                @foreach (var item in _exportHistory)
                {
                    <div class="flex items-center gap-3 rounded-md border px-4 py-3">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", item.Status == "completed" ? "bg-emerald-500" : "bg-muted-foreground")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="mb-0.5 flex items-center gap-2">
                                <p class="text-xs font-medium">@item.Format Export</p>
                                <BadgeCn Class="h-4 px-1.5 text-xs" Variant="BadgeVariant.Secondary">@item.Status</BadgeCn>
                            </div>
                            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                                <span>@item.Date</span>
                                <span>&bull;</span>
                                <span class="font-mono">@item.Size</span>
                            </div>
                        </div>
                        @if (item.Status == "completed")
                        {
                            <ButtonCn Class="gap-2" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                                <LucideDownloadCn Class="size-4" Size="16" />
                                Download
                            </ButtonCn>
                        }
                        @if (item.Status == "expired")
                        {
                            <ButtonCn Disabled="true" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">Expired</ButtonCn>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="rounded-md border bg-muted/50 p-3">
                <div class="flex items-start gap-3">
                    <LucideAlertTriangleCn Class="mt-0.5 size-4 shrink-0 text-destructive" Size="16" />
                    <div class="flex-1">
                        <p class="text-xs font-medium text-destructive">Request data deletion</p>
                        <p class="mt-1 text-xs text-muted-foreground">Permanently delete all your data. 30-day grace period before deletion is final.</p>
                        <ButtonCn Class="mt-3 gap-2 text-destructive hover:text-destructive" OnClick="@(() => _deleteDialogOpen = true)"
                                  Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                            <LucideTrash2Cn Class="size-4" Size="16" />
                            Request Deletion
                        </ButtonCn>
                    </div>
                </div>
            </div>
        </div>

        <AlertDialogCn @bind-Open="_deleteDialogOpen">
            <AlertDialogContentCn>
                <AlertDialogHeaderCn>
                    <AlertDialogTitleCn>Request Data Deletion?</AlertDialogTitleCn>
                    <AlertDialogDescriptionCn Class="space-y-2">
                        <p>This will initiate a request to permanently delete all your data from our servers.</p>
                        <p class="pt-2 font-medium text-foreground">You have 30 days to cancel this request before deletion is permanent.</p>
                    </AlertDialogDescriptionCn>
                </AlertDialogHeaderCn>
                <AlertDialogFooterCn>
                    <AlertDialogCancelCn>Cancel</AlertDialogCancelCn>
                    <ButtonCn Class="min-w-[160px]" Variant="ButtonVariant.Destructive" OnClick="@(() => _deleteDialogOpen = false)">Request Deletion</ButtonCn>
                </AlertDialogFooterCn>
            </AlertDialogContentCn>
        </AlertDialogCn>
    </div>
</section>

@code {
    private record DataCategory(string Id, string Name, string Description, int ItemCount, string Size);
    private record ExportRecord(string Id, string Date, string Format, string Size, string Status);

    private string _exportFormat = "json";
    private bool _deleteDialogOpen;

    private static readonly DataCategory[] _dataCategories =
    [
        new("profile", "Profile Information", "Name, email, avatar, bio, and account details", 12, "24 KB"),
        new("content", "Content & Posts", "Posts, comments, and uploaded files", 847, "156 MB"),
        new("activity", "Activity & Logs", "Login history, page views, and actions", 15420, "8.2 MB"),
    ];

    private int _totalItems => _dataCategories.Sum(c => c.ItemCount);

    private static readonly ExportRecord[] _exportHistory =
    [
        new("1", "Dec 15, 2024", "JSON", "2.6 GB", "completed"),
        new("2", "Nov 1, 2024", "CSV", "1.8 GB", "expired"),
        new("3", "Oct 15, 2024", "JSON", "2.1 GB", "expired"),
    ];
}
