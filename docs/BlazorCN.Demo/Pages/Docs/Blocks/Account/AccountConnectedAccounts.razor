@* ============================================================
   Block: account-connected-accounts
   Title: Account Connected Accounts
   Description: Connected accounts management showing linked social media platforms and third-party services with connect/disconnect actions
   Long Description: Connected social accounts management
   Dependencies: BadgeCn, ButtonCn, LucideCheckCn, LucideExternalLinkCn, LucideGithubCn, LucideLoaderCircleCn, LucideMailCn, LucideMessageCircleCn, LucideTwitterCn
   Source: original/blocks/account/account-connected-accounts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex-1">
                    <h2 class="text-sm font-medium">Connected Accounts</h2>
                    <p class="text-muted-foreground text-xs">Link your social accounts for quick sign-in and profile sync</p>
                </div>
                <BadgeCn Class="h-4 px-1.5 text-xs" Variant="BadgeVariant.Secondary">
                    @(_accounts.Count(a => a.Connected)) of @_accounts.Length connected
                </BadgeCn>
            </div>
        </div>

        <div>
            @foreach (var account in _accounts)
            {
                <div class="flex items-center gap-3 border-b px-4 py-3 last:border-b-0">
                    <div class="flex size-8 items-center justify-center rounded-md bg-muted text-muted-foreground">
                        @switch (account.Id)
                        {
                            case "github":
                                <LucideGithubCn Size="16" />
                                break;
                            case "google":
                                <LucideMailCn Size="16" />
                                break;
                            case "twitter":
                                <LucideTwitterCn Size="16" />
                                break;
                            case "discord":
                                <LucideMessageCircleCn Size="16" />
                                break;
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="mb-0.5 flex items-center gap-2">
                            <span class="text-sm font-medium">@account.Provider</span>
                            @if (account.Connected)
                            {
                                <BadgeCn Class="h-4 px-1.5 text-xs" Variant="BadgeVariant.Secondary">
                                    <LucideCheckCn Size="12" Class="mr-1" />
                                    Connected
                                </BadgeCn>
                            }
                        </div>
                        @if (account.Connected)
                        {
                            <p class="text-muted-foreground text-xs">@(account.Email ?? account.Username)</p>
                        }
                        else
                        {
                            <p class="text-muted-foreground text-xs">Not connected</p>
                        }
                    </div>
                    <div class="flex items-center gap-2">
                        @if (account.Connected)
                        {
                            <ButtonCn Class="min-w-[100px]" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">Disconnect</ButtonCn>
                        }
                        else
                        {
                            <ButtonCn Class="min-w-[100px] gap-2" Size="ButtonSize.Sm">
                                <LucideExternalLinkCn Size="12" />
                                Connect
                            </ButtonCn>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ConnectedAccount(string Id, string Provider, bool Connected, string? Email = null, string? Username = null, string? ConnectedAt = null);

    private static readonly ConnectedAccount[] _accounts =
    [
        new("github", "GitHub", true, Username: "@@emmawilson", ConnectedAt: "Connected 3 months ago"),
        new("google", "Google", true, Email: "emma@@gmail.com", ConnectedAt: "Connected 6 months ago"),
        new("twitter", "Twitter", false),
        new("discord", "Discord", false),
    ];
}
