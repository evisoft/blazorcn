@* ============================================================
   Block: account-subscription
   Title: Account Subscription
   Description: Subscription management with current plan details, usage meters, plan comparison, billing cycle info, upgrade/downgrade options, and cancellation workflow
   Dependencies: AlertDialogCn, BadgeCn, ButtonCn, LabelCn, ProgressCn, RadioGroupCn
   Source: original/blocks/account/account-subscription.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Subscription</h2>
                    <p class="text-xs text-muted-foreground">Manage your plan and billing</p>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                    <LucideCrownCn Class="mr-1 h-3 w-3" Size="12" />
                    Pro Plan
                </BadgeCn>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-3 text-sm font-medium">Current Plan</p>
            <div class="rounded-md bg-muted/50 p-4">
                <div class="flex items-start justify-between">
                    <div>
                        <div class="mb-1 flex items-center gap-2">
                            <h3 class="text-lg font-semibold">Pro</h3>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">Active</BadgeCn>
                        </div>
                        <p class="text-sm text-muted-foreground">For growing teams and businesses</p>
                        <div class="mt-2 flex items-center gap-3 text-sm text-muted-foreground">
                            <span class="flex items-center gap-1">
                                <LucideCalendarCn Class="h-4 w-4" Size="16" />
                                Renews Jan 15, 2025
                            </span>
                            <span class="flex items-center gap-1">
                                <LucideCreditCardCn Class="h-4 w-4" Size="16" />
                                &bull;&bull;&bull;&bull; 4242
                            </span>
                        </div>
                    </div>
                    <div class="text-right">
                        <p class="text-2xl font-semibold tabular-nums">$29</p>
                        <p class="text-xs text-muted-foreground">per month</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-3 text-sm font-medium">Usage This Period</p>
            <div class="grid grid-cols-2 gap-3">
                @foreach (var metric in _usageMetrics)
                {
                    var percentage = metric.Current / metric.Limit * 100;
                    <div class="rounded-md border p-3">
                        <div class="mb-2 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                @if (metric.Icon == "zap")
                                {
                                    <LucideZapCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                                }
                                else if (metric.Icon == "users")
                                {
                                    <LucideUsersCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                                }
                                else
                                {
                                    <LucideHardDriveCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                                }
                                <span class="text-sm font-medium">@metric.Name</span>
                            </div>
                            <span class="@Cn.Merge("text-sm font-semibold tabular-nums", GetUsageColor(percentage))">@(percentage.ToString("F0"))%</span>
                        </div>
                        <ProgressCn Class="@Cn.Merge("h-1.5", GetProgressColor(percentage))" Value="@percentage" aria-label="Progress" />
                        <p class="mt-2 text-xs text-muted-foreground">
                            <span class="font-mono">@FormatNumber(metric.Current)</span> of
                            <span class="font-mono">@FormatNumber(metric.Limit)</span> @metric.Unit
                        </p>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <p class="text-sm font-medium">Available Plans</p>
                <div class="flex items-center gap-1 rounded-md border p-0.5">
                    <button type="button"
                            class="@Cn.Merge("rounded-sm px-2 py-1 text-xs font-medium transition-colors", _billingInterval == "month" ? "bg-primary text-primary-foreground" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => _billingInterval = "month")">
                        Monthly
                    </button>
                    <button type="button"
                            class="@Cn.Merge("rounded-sm px-2 py-1 text-xs font-medium transition-colors", _billingInterval == "year" ? "bg-primary text-primary-foreground" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => _billingInterval = "year")">
                        Yearly
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-1 text-xs">-17%</BadgeCn>
                    </button>
                </div>
            </div>

            <RadioGroupCn Value="@_selectedPlan" ValueChanged="@(v => _selectedPlan = v ?? "pro")" Class="grid grid-cols-3 gap-3">
                @foreach (var plan in Plans)
                {
                    var isSelected = _selectedPlan == plan.Id;
                    <div>
                        <LabelCn Class="@Cn.Merge("flex cursor-pointer flex-col rounded-md border p-3 transition-all", isSelected ? "border-primary bg-primary/5" : "border-border hover:border-primary/30")"
                                 For="@plan.Id">
                            <RadioGroupItemCn Class="sr-only" Id="@plan.Id" Value="@plan.Id" />
                            <div class="mb-2 flex items-center justify-between">
                                @if (plan.Id == "starter")
                                {
                                    <LucideSparklesCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                                }
                                else if (plan.Id == "pro")
                                {
                                    <LucideCrownCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                                }
                                else
                                {
                                    <LucideBuilding2Cn Class="h-4 w-4 text-muted-foreground" Size="16" />
                                }
                                <div class="flex items-center gap-1">
                                    @if (plan.Popular)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">Popular</BadgeCn>
                                    }
                                    @if (plan.Current)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">Current</BadgeCn>
                                    }
                                </div>
                            </div>
                            <h4 class="text-sm font-semibold">@plan.Name</h4>
                            <div class="mt-1 flex items-baseline gap-1">
                                <span class="text-xl font-semibold tabular-nums">$@(plan.GetPrice(_billingInterval))</span>
                                <span class="text-xs text-muted-foreground">/@(_billingInterval == "year" ? "yr" : "mo")</span>
                            </div>
                            <p class="mb-3 mt-1 text-xs text-muted-foreground">@plan.Description</p>
                            <div class="space-y-1 border-t pt-2">
                                @foreach (var feature in plan.Features.Take(3))
                                {
                                    <div class="flex items-center gap-2 text-xs">
                                        @if (feature.Included)
                                        {
                                            <LucideCheckCn Class="h-3 w-3 shrink-0 text-emerald-600" Size="12" />
                                        }
                                        else
                                        {
                                            <LucideXCn Class="h-3 w-3 shrink-0 text-muted-foreground" Size="12" />
                                        }
                                        <span class="@(feature.Included ? "" : "text-muted-foreground")">@(feature.Limit ?? feature.Name)</span>
                                    </div>
                                }
                            </div>
                        </LabelCn>
                    </div>
                }
            </RadioGroupCn>

            @if (_selectedPlan != "pro")
            {
                <div class="mt-3 flex justify-end">
                    <ButtonCn Size="ButtonSize.Sm" OnClick="@(() => _upgradeDialogOpen = true)">
                        <LucideArrowUpRightCn Class="mr-2 h-4 w-4" Size="16" />
                        @(_selectedPlan == "enterprise" ? "Upgrade to Enterprise" : _selectedPlan == "starter" ? "Downgrade to Starter" : "Change Plan")
                    </ButtonCn>
                </div>
            }
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium">Need to cancel?</p>
                    <p class="text-xs text-muted-foreground">Your subscription will remain active until the end of your billing period</p>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" OnClick="@(() => _cancelDialogOpen = true)">Cancel Plan</ButtonCn>
            </div>
        </div>
    </div>

    <AlertDialogCn @bind-Open="_upgradeDialogOpen">
        <AlertDialogContentCn>
            <AlertDialogHeaderCn>
                <AlertDialogTitleCn>@(_selectedPlan == "starter" ? "Downgrade" : "Upgrade") to @(Plans.FirstOrDefault(p => p.Id == _selectedPlan)?.Name)?</AlertDialogTitleCn>
                <AlertDialogDescriptionCn>
                    @if (_selectedPlan == "starter")
                    {
                        <p>You're about to downgrade to the Starter plan. You'll lose access to:</p>
                        <ul class="ml-2 mt-2 list-inside list-disc space-y-1 text-sm">
                            <li>Unlimited projects (limited to 3)</li>
                            <li>100K API calls (limited to 1K)</li>
                            <li>10 team seats (limited to 1)</li>
                            <li>Priority support</li>
                        </ul>
                        <p class="mt-2 font-medium text-amber-600">This change takes effect at the end of your billing period.</p>
                    }
                    else
                    {
                        <p>You're upgrading to @(Plans.FirstOrDefault(p => p.Id == _selectedPlan)?.Name). You'll get:</p>
                        <ul class="ml-2 mt-2 list-inside list-disc space-y-1 text-sm">
                            @foreach (var f in Plans.FirstOrDefault(p => p.Id == _selectedPlan)?.Features.Take(4) ?? [])
                            {
                                <li>@(f.Limit ?? f.Name)</li>
                            }
                        </ul>
                        <p class="mt-2 font-medium">You'll be charged a prorated amount of approximately $35 today.</p>
                    }
                </AlertDialogDescriptionCn>
            </AlertDialogHeaderCn>
            <AlertDialogFooterCn>
                <AlertDialogCancelCn>Cancel</AlertDialogCancelCn>
                <ButtonCn Variant="@(_selectedPlan == "starter" ? ButtonVariant.Destructive : ButtonVariant.Default)"
                          OnClick="@(() => _upgradeDialogOpen = false)">
                    Confirm @(_selectedPlan == "starter" ? "Downgrade" : "Upgrade")
                </ButtonCn>
            </AlertDialogFooterCn>
        </AlertDialogContentCn>
    </AlertDialogCn>

    <AlertDialogCn @bind-Open="_cancelDialogOpen">
        <AlertDialogContentCn>
            <AlertDialogHeaderCn>
                <AlertDialogTitleCn>Cancel your subscription?</AlertDialogTitleCn>
                <AlertDialogDescriptionCn>
                    <p>We're sorry to see you go. If you cancel:</p>
                    <ul class="ml-2 mt-2 list-inside list-disc space-y-1 text-sm">
                        <li>Your plan will remain active until Jan 15, 2025</li>
                        <li>You'll lose access to Pro features after that date</li>
                        <li>Your data will be preserved for 30 days</li>
                        <li>You can reactivate anytime</li>
                    </ul>
                </AlertDialogDescriptionCn>
            </AlertDialogHeaderCn>
            <AlertDialogFooterCn>
                <ButtonCn Variant="ButtonVariant.Outline" OnClick="@(() => _cancelDialogOpen = false)">Claim 20% Discount</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Destructive" OnClick="@(() => _cancelDialogOpen = false)">Cancel Subscription</ButtonCn>
            </AlertDialogFooterCn>
        </AlertDialogContentCn>
    </AlertDialogCn>
</section>

@code {
    private record PlanFeature(string Name, bool Included, string? Limit = null);

    private class Plan
    {
        public string Id { get; init; } = "";
        public string Name { get; init; } = "";
        public int MonthlyPrice { get; init; }
        public int YearlyPrice { get; init; }
        public string Description { get; init; } = "";
        public PlanFeature[] Features { get; init; } = [];
        public bool Popular { get; init; }
        public bool Current { get; init; }

        public int GetPrice(string interval) => interval == "year" ? YearlyPrice : MonthlyPrice;
    }

    private record UsageMetric(string Name, double Current, double Limit, string Unit, string Icon);

    private string _selectedPlan = "pro";
    private string _billingInterval = "month";
    private bool _upgradeDialogOpen;
    private bool _cancelDialogOpen;

    private static readonly UsageMetric[] _usageMetrics =
    [
        new("API Calls", 84700, 100000, "calls", "zap"),
        new("Team Members", 8, 10, "seats", "users"),
        new("Storage", 32.4, 50, "GB", "drive"),
    ];

    private static readonly Plan[] Plans =
    [
        new()
        {
            Id = "starter", Name = "Starter", MonthlyPrice = 0, YearlyPrice = 0,
            Description = "For individuals and small projects",
            Features = [new("3 projects", true), new("API access", true, "1K calls/mo"), new("Team members", true, "1 seat"), new("Storage", true, "1 GB"), new("Community support", true)],
        },
        new()
        {
            Id = "pro", Name = "Pro", MonthlyPrice = 29, YearlyPrice = 290,
            Description = "For growing teams and businesses", Popular = true, Current = true,
            Features = [new("Unlimited projects", true), new("API access", true, "100K calls/mo"), new("Team members", true, "10 seats"), new("Storage", true, "50 GB"), new("Priority support", true)],
        },
        new()
        {
            Id = "enterprise", Name = "Enterprise", MonthlyPrice = 99, YearlyPrice = 990,
            Description = "For large organizations",
            Features = [new("Unlimited everything", true), new("API access", true, "Unlimited"), new("Team members", true, "Unlimited"), new("Storage", true, "500 GB"), new("24/7 phone support", true), new("Custom integrations", true), new("SSO & SAML", true), new("Dedicated account manager", true)],
        },
    ];

    private static string GetUsageColor(double percentage) => percentage switch
    {
        >= 90 => "text-red-600",
        >= 70 => "text-amber-600",
        _ => "text-emerald-600",
    };

    private static string GetProgressColor(double percentage) => percentage switch
    {
        >= 90 => "[&>div]:bg-red-500",
        >= 70 => "[&>div]:bg-amber-500",
        _ => "",
    };

    private static string FormatNumber(double num) => num >= 1000 ? $"{num / 1000:F1}K" : num.ToString("G");
}
