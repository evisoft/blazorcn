@* ============================================================
   Block: account-accessibility-settings
   Title: AccountAccessibilitySettings
   Description: A split-panel accessibility settings block for React and Next.js with live preview, tabbed categories, font size stepper, and contrast controls built with shadcn/ui and Tailwind CSS
   Source: original/blocks/account/account-accessibility-settings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid grid-cols-1 md:grid-cols-2 md:divide-x">
            @* Left Panel — Settings Controls *@
            <div class="flex flex-col">
                @* Header *@
                <div class="border-b px-4 py-3">
                    <h2 class="text-sm font-medium">Accessibility Settings</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Adjust the interface to match your needs
                    </p>
                </div>

                @* Category Tabs *@
                <div class="border-b px-4 py-2">
                    <div class="flex gap-1 rounded-md bg-muted/50 p-0.5">
                        @foreach (var cat in _categories)
                        {
                            <button type="button"
                                    @onclick="@(() => _activeTab = cat.Id)"
                                    class="@Cn.Merge("relative flex-1 rounded-sm px-3 py-1.5 text-xs font-medium transition-colors", _activeTab == cat.Id ? "text-foreground bg-background shadow-sm" : "text-muted-foreground hover:text-foreground")">
                                <span class="relative z-10">@cat.Label</span>
                            </button>
                        }
                    </div>
                </div>

                @* Tab Content *@
                <div class="min-h-[260px] flex-1 px-4 py-3">
                    @if (_activeTab == "text")
                    {
                        <div class="space-y-4">
                            @* Font Size Stepper *@
                            <div>
                                <div class="flex items-center gap-2">
                                    <LucideIconCn Name="type" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                                    <span class="text-sm font-medium">Font Size</span>
                                </div>
                                <p class="mt-0.5 text-xs text-muted-foreground">
                                    Base size for all interface text
                                </p>
                                <div class="mt-2 flex items-center gap-2">
                                    <ButtonCn aria-label="Decrease font size" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 w-7 p-0"
                                              OnClick="DecreaseFontSize" Disabled="@(_fontSize <= 12)">
                                        <LucideIconCn Name="minus" Size="12" Class="h-3 w-3" />
                                    </ButtonCn>
                                    <span class="w-14 text-center font-mono text-sm tabular-nums">
                                        @(_fontSize)px
                                    </span>
                                    <ButtonCn aria-label="Increase font size" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 w-7 p-0"
                                              OnClick="IncreaseFontSize" Disabled="@(_fontSize >= 24)">
                                        <LucideIconCn Name="plus" Size="12" Class="h-3 w-3" />
                                    </ButtonCn>
                                    <div class="ml-2 h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                                        <div class="h-full rounded-full bg-foreground/30"
                                             style="@($"width: {((_fontSize - 12) / 12.0 * 100):F0}%")">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @* Line Spacing *@
                            <div>
                                <span class="text-sm font-medium">Line Spacing</span>
                                <p class="mt-0.5 text-xs text-muted-foreground">
                                    Space between lines of text
                                </p>
                                <div class="mt-2">
                                    <SelectCn Value="@_lineSpacing" ValueChanged="@((string v) => _lineSpacing = v)">
                                        <SelectTriggerCn aria-label="Line spacing" Class="w-full text-sm">
                                            <SelectValueCn />
                                        </SelectTriggerCn>
                                        <SelectContentCn>
                                            @foreach (var opt in _lineSpacingOptions)
                                            {
                                                <SelectItemCn Value="@opt.Value">
                                                    <span class="flex items-center justify-between gap-3">
                                                        @opt.Label
                                                        <span class="font-mono text-xs text-muted-foreground">
                                                            @(opt.Multiplier)x
                                                        </span>
                                                    </span>
                                                </SelectItemCn>
                                            }
                                        </SelectContentCn>
                                    </SelectCn>
                                </div>
                            </div>
                        </div>
                    }

                    @if (_activeTab == "visual")
                    {
                        <div class="space-y-4">
                            @* High Contrast *@
                            <div class="flex items-start justify-between gap-4">
                                <div>
                                    <div class="flex items-center gap-2">
                                        <LucideIconCn Name="eye" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                                        <span class="text-sm font-medium">High Contrast</span>
                                    </div>
                                    <p class="mt-0.5 text-xs text-muted-foreground">
                                        Increase contrast between text and backgrounds for better legibility
                                    </p>
                                </div>
                                <SwitchCn aria-label="High Contrast" Checked="@_highContrast" CheckedChanged="@((bool v) => _highContrast = v)" />
                            </div>

                            @* Reduce Transparency *@
                            <div class="flex items-start justify-between gap-4">
                                <div>
                                    <span class="text-sm font-medium">Reduce Transparency</span>
                                    <p class="mt-0.5 text-xs text-muted-foreground">
                                        Remove frosted glass and translucent overlay effects
                                    </p>
                                </div>
                                <SwitchCn aria-label="Reduce Transparency" Checked="@_reduceTransparency" CheckedChanged="@((bool v) => _reduceTransparency = v)" />
                            </div>

                            @* Cursor Size *@
                            <div>
                                <div class="flex items-center gap-2">
                                    <LucideIconCn Name="mouse-pointer" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                                    <span class="text-sm font-medium">Cursor Size</span>
                                </div>
                                <p class="mt-0.5 text-xs text-muted-foreground">
                                    Adjust the cursor size for easier targeting
                                </p>
                                <div class="mt-2">
                                    <SelectCn Value="@_cursorSize" ValueChanged="@((string v) => _cursorSize = v)">
                                        <SelectTriggerCn aria-label="Cursor size" Class="w-full text-sm">
                                            <SelectValueCn />
                                        </SelectTriggerCn>
                                        <SelectContentCn>
                                            @foreach (var opt in _cursorSizeOptions)
                                            {
                                                <SelectItemCn Value="@opt.Value">@opt.Label</SelectItemCn>
                                            }
                                        </SelectContentCn>
                                    </SelectCn>
                                </div>
                            </div>
                        </div>
                    }

                    @if (_activeTab == "motion")
                    {
                        <div class="space-y-4">
                            @* Reduce Motion *@
                            <div class="flex items-start justify-between gap-4">
                                <div>
                                    <div class="flex items-center gap-2">
                                        <LucideIconCn Name="sparkles" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                                        <span class="text-sm font-medium">Reduce Motion</span>
                                    </div>
                                    <p class="mt-0.5 text-xs text-muted-foreground">
                                        Minimize animations and transitions throughout the interface
                                    </p>
                                </div>
                                <SwitchCn aria-label="Reduce Motion" Checked="@_reduceMotion" CheckedChanged="@((bool v) => _reduceMotion = v)" />
                            </div>

                            @* Enhanced Focus Indicators *@
                            <div class="flex items-start justify-between gap-4">
                                <div>
                                    <div class="flex items-center gap-2">
                                        <LucideIconCn Name="scan-eye" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                                        <span class="text-sm font-medium">Enhanced Focus Indicators</span>
                                    </div>
                                    <p class="mt-0.5 text-xs text-muted-foreground">
                                        Show larger, more visible outlines when navigating with keyboard
                                    </p>
                                </div>
                                <SwitchCn aria-label="Enhanced Focus Indicators" Checked="@_focusIndicators" CheckedChanged="@((bool v) => _focusIndicators = v)" />
                            </div>

                            @* Info note *@
                            <div class="rounded-md bg-muted/50 px-3 py-2">
                                <p class="text-xs text-muted-foreground">
                                    Motion preferences also respect your operating system's
                                    <span class="font-mono text-[10px]">prefers-reduced-motion</span>
                                    setting.
                                </p>
                            </div>
                        </div>
                    }
                </div>

                @* Actions *@
                <div class="flex items-center justify-between border-t px-4 py-3">
                    <button type="button" @onclick="HandleReset"
                            class="flex items-center gap-1.5 text-xs text-muted-foreground transition-colors hover:text-foreground">
                        <LucideIconCn Name="rotate-ccw" Size="12" Class="h-3 w-3" />
                        Reset defaults
                    </button>
                    <ButtonCn Size="ButtonSize.Sm" Disabled="@_isSaving" OnClick="HandleSave">
                        @if (_saved)
                        {
                            <LucideIconCn Name="check" Size="14" Class="mr-1.5 h-3.5 w-3.5" />
                            @:Saved
                        }
                        else if (_isSaving)
                        {
                            <LucideIconCn Name="loader-2" Size="14" Class="mr-1.5 h-3.5 w-3.5 animate-spin" />
                            @:Saving...
                        }
                        else
                        {
                            @:Save Settings
                        }
                    </ButtonCn>
                </div>
            </div>

            @* Right Panel — Live Preview *@
            <div class="flex flex-col border-t bg-muted/30 md:border-t-0">
                <div class="flex items-center gap-2 border-b px-4 py-3">
                    <LucideIconCn Name="eye" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                    <span class="text-xs font-medium text-muted-foreground">Preview</span>
                </div>

                <div class="flex flex-1 items-start justify-center p-5">
                    <div class="@Cn.Merge("w-full rounded-md border bg-card p-4 shadow-sm", _highContrast ? "border-foreground/40" : "", _reduceTransparency ? "bg-card" : "bg-card/95")">
                        @* Preview Card Title *@
                        <div class="flex items-center gap-2">
                            <div class="@Cn.Merge("flex h-6 w-6 items-center justify-center rounded-md bg-muted", _highContrast ? "bg-foreground text-background" : "")">
                                <LucideIconCn Name="type" Size="14" Class="h-3.5 w-3.5" />
                            </div>
                            <span class="@Cn.Merge("font-medium transition-all", _highContrast ? "text-foreground" : "text-foreground/90")"
                                  style="@($"font-size: {_fontSize}px")">
                                Dashboard Overview
                            </span>
                        </div>

                        @* Preview Paragraph *@
                        <p class="@Cn.Merge("mt-3 transition-all", _highContrast ? "text-foreground/90" : "text-muted-foreground")"
                           style="@($"font-size: {Math.Max(_fontSize - 2, 11)}px; line-height: {LineHeightMultiplier}")">
                            @_previewParagraph
                        </p>

                        @* Preview Button *@
                        <div class="mt-4 flex items-center gap-2">
                            <div class="@Cn.Merge("inline-flex items-center justify-center rounded-md px-3 py-1.5 text-xs font-medium transition-all", _highContrast ? "bg-foreground text-background" : "bg-primary text-primary-foreground")"
                                 style="@($"font-size: {Math.Max(_fontSize - 3, 11)}px")">
                                Get Started
                            </div>
                            <div class="@Cn.Merge("inline-flex items-center justify-center rounded-md border px-3 py-1.5 text-xs font-medium transition-all", _highContrast ? "border-foreground/40" : "")"
                                 style="@($"font-size: {Math.Max(_fontSize - 3, 11)}px")">
                                Learn More
                            </div>
                        </div>

                        @* Focus Ring Indicator *@
                        @if (_focusIndicators)
                        {
                            <div class="mt-4 border-t pt-3">
                                <span class="text-[10px] font-medium text-muted-foreground">
                                    FOCUS INDICATOR
                                </span>
                                <div class="mt-1.5 flex items-center gap-2">
                                    <div class="@Cn.Merge("rounded-md border px-3 py-1 text-xs", _focusIndicators ? "ring-2 ring-blue-500 ring-offset-2 ring-offset-background" : "ring-1 ring-ring")">
                                        Focused Element
                                    </div>
                                    <span class="text-[10px] text-muted-foreground">
                                        @(_focusIndicators ? "Enhanced" : "Standard")
                                    </span>
                                </div>
                            </div>
                        }

                        @* Reduced Motion Indicator *@
                        @if (_reduceMotion)
                        {
                            <div class="mt-3 flex items-center gap-1.5 rounded-md bg-amber-500/10 px-2.5 py-1.5">
                                <span class="size-1.5 rounded-full bg-amber-500"></span>
                                <span class="text-[10px] text-amber-700 dark:text-amber-400">
                                    Animations disabled
                                </span>
                            </div>
                        }

                        @* Current Settings Summary *@
                        <div class="mt-4 border-t pt-3">
                            <div class="flex flex-wrap gap-x-3 gap-y-1">
                                <span class="font-mono text-[10px] text-muted-foreground">
                                    @(_fontSize)px
                                </span>
                                <span class="font-mono text-[10px] text-muted-foreground">
                                    @(LineHeightMultiplier)x
                                </span>
                                @if (_highContrast)
                                {
                                    <span class="font-mono text-[10px] text-muted-foreground">
                                        hi-contrast
                                    </span>
                                }
                                @if (_reduceMotion)
                                {
                                    <span class="font-mono text-[10px] text-muted-foreground">no-motion</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record CategoryOption(string Id, string Label);
    private record LineSpacingOption(string Value, string Label, double Multiplier);
    private record CursorSizeOption(string Value, string Label);

    private string _activeTab = "text";
    private int _fontSize = 16;
    private string _lineSpacing = "normal";
    private bool _highContrast;
    private bool _reduceTransparency;
    private string _cursorSize = "default";
    private bool _reduceMotion;
    private bool _focusIndicators = true;
    private bool _isSaving;
    private bool _saved;

    private const string _previewParagraph =
        "The quick brown fox jumps over the lazy dog. This sample text demonstrates how your accessibility preferences affect the reading experience across the interface.";

    private static readonly CategoryOption[] _categories =
    [
        new("text", "Text"),
        new("visual", "Visual"),
        new("motion", "Motion"),
    ];

    private static readonly LineSpacingOption[] _lineSpacingOptions =
    [
        new("compact", "Compact", 1.2),
        new("normal", "Normal", 1.5),
        new("relaxed", "Relaxed", 1.75),
        new("loose", "Loose", 2.0),
    ];

    private static readonly CursorSizeOption[] _cursorSizeOptions =
    [
        new("default", "Default"),
        new("large", "Large"),
        new("extra-large", "Extra Large"),
    ];

    private double LineHeightMultiplier =>
        _lineSpacingOptions.FirstOrDefault(o => o.Value == _lineSpacing)?.Multiplier ?? 1.5;

    private async Task HandleSave()
    {
        _isSaving = true;
        _saved = false;
        StateHasChanged();
        await Task.Delay(1200);
        _isSaving = false;
        _saved = true;
        StateHasChanged();
        await Task.Delay(2000);
        _saved = false;
    }

    private void HandleReset()
    {
        _fontSize = 16;
        _lineSpacing = "normal";
        _highContrast = false;
        _reduceTransparency = false;
        _cursorSize = "default";
        _reduceMotion = false;
        _focusIndicators = true;
    }

    private void DecreaseFontSize()
    {
        if (_fontSize > 12) _fontSize--;
    }

    private void IncreaseFontSize()
    {
        if (_fontSize < 24) _fontSize++;
    }
}
