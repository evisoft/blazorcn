@* ============================================================
   Block: account-content-preferences
   Title: AccountContentPreferences
   Description: A tabbed content preferences panel for React and Next.js with topic interest chips, source priority sliders, format toggles, and personalization scoring built with shadcn/ui and Tailwind CSS
   Source: original/blocks/account/account-content-preferences.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with personalization score *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Content Preferences</h2>
                    <p class="text-xs text-muted-foreground">
                        Tailor your feed across topics, sources, and formats
                    </p>
                </div>
                <div class="text-right">
                    <p class="text-2xl font-semibold tabular-nums">@PersonalizationScore%</p>
                    <p class="text-[10px] text-muted-foreground">Personalization</p>
                </div>
            </div>
            @* Score bar *@
            <div class="mt-2.5 h-1 w-full overflow-hidden rounded-full bg-muted">
                <div class="@Cn.Merge("h-full rounded-full transition-all duration-500 ease-out", PersonalizationScore >= 70 ? "bg-emerald-500" : PersonalizationScore >= 40 ? "bg-amber-500" : "bg-red-500")"
                     style="@($"width:{PersonalizationScore}%")">
                </div>
            </div>
        </div>

        @* Tabbed content *@
        <TabsCn DefaultValue="topics" Class="w-full">
            <div class="border-b px-4">
                <TabsListCn Class="h-9 w-full justify-start rounded-none border-none bg-transparent p-0">
                    <TabsTriggerCn Value="topics"
                                   Class="relative h-9 rounded-none border-b-2 border-transparent px-3 text-xs data-[state=active]:border-foreground data-[state=active]:bg-transparent data-[state=active]:shadow-none">
                        Topics
                        <span class="ml-1.5 text-[10px] tabular-nums text-muted-foreground">
                            @_selectedTopics.Count
                        </span>
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="sources"
                                   Class="relative h-9 rounded-none border-b-2 border-transparent px-3 text-xs data-[state=active]:border-foreground data-[state=active]:bg-transparent data-[state=active]:shadow-none">
                        Sources
                        <span class="ml-1.5 text-[10px] tabular-nums text-muted-foreground">
                            @ActiveSources
                        </span>
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="format"
                                   Class="relative h-9 rounded-none border-b-2 border-transparent px-3 text-xs data-[state=active]:border-foreground data-[state=active]:bg-transparent data-[state=active]:shadow-none">
                        Format
                        <span class="ml-1.5 text-[10px] tabular-nums text-muted-foreground">
                            @EnabledFormats
                        </span>
                    </TabsTriggerCn>
                </TabsListCn>
            </div>

            @* Topics tab *@
            <TabsContentCn Value="topics" Class="m-0">
                <div class="px-4 py-3 space-y-4">
                    @foreach (var category in _topicCategories)
                    {
                        <div>
                            <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                                @category.Name
                            </span>
                            <div class="mt-1.5 flex flex-wrap gap-1.5">
                                @foreach (var topic in category.Topics)
                                {
                                    var isSelected = _selectedTopics.Contains(topic.Id);
                                    <button type="button"
                                            @onclick="@(() => ToggleTopic(topic.Id))"
                                            class="@Cn.Merge("inline-flex items-center gap-1 rounded-md border px-2.5 py-1 text-xs transition-all", isSelected ? "border-foreground bg-foreground text-background" : "border-border bg-transparent text-muted-foreground hover:border-foreground/30 hover:text-foreground")">
                                        @if (isSelected)
                                        {
                                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                                        }
                                        @topic.Label
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </TabsContentCn>

            @* Sources tab *@
            <TabsContentCn Value="sources" Class="m-0">
                <div class="divide-y">
                    @foreach (var source in _sources)
                    {
                        <div class="flex items-center gap-4 px-4 py-3">
                            <div class="min-w-0 flex-1">
                                <p class="text-sm font-medium">@source.Name</p>
                                <p class="font-mono text-[10px] text-muted-foreground">@source.Domain</p>
                            </div>
                            <div class="flex w-36 items-center gap-3">
                                <SliderCn Class="flex-1" Min="0" Max="100" Step="5"
                                          Value="@((double)source.Priority)"
                                          ValueChanged="@((double v) => source.Priority = (int)v)"
                                          aria-label="@($"Priority for {source.Name}")" />
                                <span class="@Cn.Merge("w-7 text-right text-xs tabular-nums", source.Priority == 0 ? "text-muted-foreground/40" : "text-muted-foreground")">
                                    @source.Priority
                                </span>
                            </div>
                        </div>
                    }
                </div>
                <div class="border-t px-4 py-2">
                    <p class="text-[10px] text-muted-foreground">
                        Drag sliders to adjust how much each source influences your feed. Set to 0 to
                        exclude.
                    </p>
                </div>
            </TabsContentCn>

            @* Format tab *@
            <TabsContentCn Value="format" Class="m-0">
                <div class="divide-y">
                    @foreach (var format in _formats)
                    {
                        <div class="flex items-center gap-3 px-4 py-3">
                            <span class="flex size-8 items-center justify-center rounded-md bg-muted/50 text-muted-foreground">
                                <LucideIconCn Name="@format.IconName" Size="16" Class="size-4" />
                            </span>
                            <div class="min-w-0 flex-1">
                                <p class="text-sm font-medium">@format.Label</p>
                                <p class="text-xs text-muted-foreground">@format.Description</p>
                            </div>
                            <SwitchCn Checked="@format.Enabled"
                                      CheckedChanged="@((bool v) => format.Enabled = v)"
                                      aria-label="@($"Toggle {format.Label}")" />
                        </div>
                    }
                </div>
            </TabsContentCn>
        </TabsCn>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <div class="flex items-center gap-3 text-[10px] text-muted-foreground">
                <span>@_selectedTopics.Count topics</span>
                <span class="text-muted-foreground/40">·</span>
                <span>@ActiveSources sources</span>
                <span class="text-muted-foreground/40">·</span>
                <span>@EnabledFormats formats</span>
            </div>
            @if (_saved)
            {
                <span class="flex items-center gap-1 text-xs text-emerald-600">
                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                    Saved
                </span>
            }
            else
            {
                <ButtonCn Size="ButtonSize.Sm" OnClick="HandleSave" Disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <LucideIconCn Name="loader-2" Size="14" Class="mr-1.5 size-3.5 animate-spin" />
                        <text>Saving...</text>
                    }
                    else
                    {
                        <text>Save Preferences</text>
                    }
                </ButtonCn>
            }
        </div>
    </div>
</section>

@code {
    private record TopicItem(string Id, string Label);
    private record TopicCategory(string Name, TopicItem[] Topics);

    private class ContentSource
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Domain { get; set; } = "";
        public int Priority { get; set; }
    }

    private class ContentFormat
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string Description { get; set; } = "";
        public string IconName { get; set; } = "";
        public bool Enabled { get; set; }
    }

    private static readonly TopicCategory[] _topicCategories =
    [
        new("Technology",
        [
            new("react", "React"),
            new("typescript", "TypeScript"),
            new("nodejs", "Node.js"),
            new("ai-ml", "AI / ML"),
            new("devops", "DevOps"),
            new("cloud", "Cloud"),
            new("mobile", "Mobile"),
            new("security", "Security"),
            new("databases", "Databases"),
            new("rust", "Rust"),
        ]),
        new("Design",
        [
            new("ui-design", "UI Design"),
            new("ux-research", "UX Research"),
            new("accessibility", "Accessibility"),
            new("design-systems", "Design Systems"),
            new("figma", "Figma"),
            new("motion-design", "Motion Design"),
        ]),
        new("Business",
        [
            new("startups", "Startups"),
            new("product-mgmt", "Product Management"),
            new("marketing", "Marketing"),
            new("leadership", "Leadership"),
            new("remote-work", "Remote Work"),
            new("fundraising", "Fundraising"),
        ]),
        new("Career",
        [
            new("interviewing", "Interviewing"),
            new("salary-neg", "Salary Negotiation"),
            new("freelancing", "Freelancing"),
            new("open-source", "Open Source"),
        ]),
    ];

    private static readonly int _totalTopics = _topicCategories.Sum(c => c.Topics.Length);

    private HashSet<string> _selectedTopics = ["react", "typescript", "ui-design", "accessibility", "product-mgmt", "ai-ml"];

    private List<ContentSource> _sources =
    [
        new() { Id = "s1", Name = "Engineering Blog", Domain = "engineering.example.com", Priority = 80 },
        new() { Id = "s2", Name = "Hacker News", Domain = "news.ycombinator.com", Priority = 60 },
        new() { Id = "s3", Name = "Dev Community", Domain = "dev.to", Priority = 45 },
        new() { Id = "s4", Name = "CSS Tricks", Domain = "css-tricks.com", Priority = 70 },
        new() { Id = "s5", Name = "Smashing Magazine", Domain = "smashingmagazine.com", Priority = 55 },
        new() { Id = "s6", Name = "The Verge", Domain = "theverge.com", Priority = 30 },
    ];

    private List<ContentFormat> _formats =
    [
        new() { Id = "articles", Label = "Articles", Description = "Written tutorials, blog posts, and deep dives", IconName = "file-text", Enabled = true },
        new() { Id = "videos", Label = "Videos", Description = "Conference talks, screencasts, and tutorials", IconName = "monitor-play", Enabled = true },
        new() { Id = "podcasts", Label = "Podcasts", Description = "Audio interviews, roundtables, and commentary", IconName = "headphones", Enabled = false },
        new() { Id = "newsletters", Label = "Newsletters", Description = "Weekly curated digests and summaries", IconName = "newspaper", Enabled = true },
        new() { Id = "live", Label = "Live Streams", Description = "Real-time coding sessions and Q&A events", IconName = "radio", Enabled = false },
    ];

    private bool _isSaving;
    private bool _saved;

    private int EnabledFormats => _formats.Count(f => f.Enabled);
    private int ActiveSources => _sources.Count(s => s.Priority > 0);

    private int PersonalizationScore => Math.Min(100, (int)Math.Round(
        (_selectedTopics.Count / (double)_totalTopics) * 40 +
        (EnabledFormats / (double)_formats.Count) * 30 +
        (ActiveSources / (double)_sources.Count) * 30));

    private void ToggleTopic(string id)
    {
        if (_selectedTopics.Contains(id))
            _selectedTopics.Remove(id);
        else
            _selectedTopics.Add(id);
    }

    private async Task HandleSave()
    {
        _isSaving = true;
        StateHasChanged();
        await Task.Delay(1200);
        _isSaving = false;
        _saved = true;
        StateHasChanged();
        await Task.Delay(2000);
        _saved = false;
    }
}
