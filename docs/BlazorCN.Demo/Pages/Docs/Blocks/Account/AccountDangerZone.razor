@* ============================================================
   Block: account-danger-zone
   Title: Account Danger Zone
   Description: Account danger zone with destructive actions like deactivate account and delete account with confirmation dialogs and warnings
   Long Description: Danger zone with destructive actions
   Dependencies: ButtonCn, InputCn, LucideDownloadCn, LucideLoaderCircleCn
   Source: original/blocks/account/account-danger-zone.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Danger Zone</h2>
            <p class="text-muted-foreground text-xs">
                Irreversible and destructive actions. Please proceed with caution.
            </p>
        </div>

        <div class="space-y-6 px-4 py-6">
            <div class="flex items-center gap-3 rounded-md border p-3">
                <span class="size-1.5 shrink-0 rounded-full bg-blue-500"></span>
                <div class="flex-1">
                    <span class="text-xs font-medium">Export Your Data</span>
                    <p class="text-muted-foreground text-xs">
                        Download a copy of your data before deactivating or deleting your account.
                    </p>
                </div>
                <ButtonCn Class="gap-2" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                    <LucideDownloadCn Size="16" />
                    Export
                </ButtonCn>
            </div>

            <div class="rounded-md border bg-muted/50 p-3">
                <div class="flex flex-col gap-3 sm:flex-row sm:items-start">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-amber-500"></span>
                    <div class="flex-1">
                        <span class="mb-1 text-xs font-medium text-amber-900">Deactivate Account</span>
                        <p class="text-xs text-amber-800">
                            Temporarily disable your account. Your data is preserved and you can reactivate
                            within 30 days by logging back in.
                        </p>
                    </div>
                    <ButtonCn Class="shrink-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                        Deactivate
                    </ButtonCn>
                </div>
            </div>

            <div class="rounded-md border bg-muted/50 p-3">
                <div class="flex flex-col gap-3 sm:flex-row sm:items-start">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-red-500"></span>
                    <div class="flex-1">
                        <span class="mb-1 text-xs font-medium text-destructive">
                            Delete Account Permanently
                        </span>
                        <p class="text-destructive/80 text-xs">
                            Once you delete your account, there is no going back. All data, content, and
                            subscriptions will be permanently removed.
                        </p>
                    </div>
                    <ButtonCn Class="shrink-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Destructive">
                        Delete Account
                    </ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>
