@* ============================================================
   Block: account-backup-codes
   Title: Account Backup Codes
   Description: Two-factor authentication backup codes with generation, display, download, and regeneration
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/account/account-backup-codes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <LucideKeyCn Class="h-5 w-5 text-muted-foreground" Size="20" />
                    <div>
                        <h2 class="text-sm font-medium">Backup Codes</h2>
                        <p class="text-xs text-muted-foreground">Use these codes if you lose your 2FA device</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <BadgeCn Variant="BadgeVariant.Secondary">@_codes.Count(c => !c.Used) available</BadgeCn>
                </div>
            </div>
        </div>

        <div class="p-4">
            <div class="mb-3 flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">YOUR BACKUP CODES</span>
                <div class="flex gap-2">
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 gap-1.5 px-2"
                              OnClick="@(() => _copiedAll = true)">
                        @if (_copiedAll)
                        {
                            <LucideCheckCn Class="h-3.5 w-3.5 text-emerald-500" Size="14" />
                            <text>Copied!</text>
                        }
                        else
                        {
                            <LucideCopyCn Class="h-3.5 w-3.5" Size="14" />
                            <text>Copy All</text>
                        }
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 gap-1.5 px-2">
                        <LucideDownloadCn Class="h-3.5 w-3.5" Size="14" />
                        Download
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 gap-1.5 px-2">
                        <LucidePrinterCn Class="h-3.5 w-3.5" Size="14" />
                        Print
                    </ButtonCn>
                </div>
            </div>

            <div class="rounded-md border bg-muted/50 p-3">
                <div class="grid grid-cols-2 gap-2">
                    @foreach (var code in _codes)
                    {
                        <div class="@Cn.Merge("group flex items-center justify-between rounded-md border bg-card p-2 transition-colors", code.Used ? "opacity-50" : "hover:bg-muted/50")">
                            <div class="flex min-w-0 flex-1 items-center gap-2">
                                <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", code.Used ? "bg-muted-foreground" : "bg-emerald-500")"></span>
                                <div class="min-w-0 flex-1">
                                    <p class="@Cn.Merge("font-mono text-xs", code.Used ? "text-muted-foreground line-through" : "font-medium")">@(code.Code)</p>
                                    @if (code.Used && code.UsedAt != null)
                                    {
                                        <p class="text-[10px] text-muted-foreground">Used on @(code.UsedAt)</p>
                                    }
                                </div>
                            </div>
                            @if (!code.Used)
                            {
                                <ButtonCn Size="ButtonSize.Icon" Class="h-6 w-6 shrink-0 opacity-0 transition-opacity group-hover:opacity-100"
                                          Variant="ButtonVariant.Ghost" OnClick="@(() => _copiedCodeId = code.Id)">
                                    @if (_copiedCodeId == code.Id)
                                    {
                                        <LucideCheckCn Class="h-3.5 w-3.5 text-emerald-500" Size="14" />
                                    }
                                    else
                                    {
                                        <LucideCopyCn Class="h-3.5 w-3.5 text-muted-foreground" Size="14" />
                                    }
                                </ButtonCn>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="mt-4 flex flex-col gap-2 border-t pt-4 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <p class="text-sm font-medium">Need new codes?</p>
                    <p class="text-xs text-muted-foreground">Regenerating will invalidate all existing unused codes</p>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Class="gap-2" Variant="ButtonVariant.Outline">
                    <LucideRefreshCwCn Class="h-4 w-4" Size="16" />
                    Regenerate Codes
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record BackupCode(string Id, string Code, bool Used, string? UsedAt = null);

    private string? _copiedCodeId;
    private bool _copiedAll;

    private static readonly BackupCode[] _codes =
    [
        new("1", "ABCD-1234-EFGH-5678", false),
        new("2", "IJKL-9012-MNOP-3456", false),
        new("3", "QRST-7890-UVWX-1234", true, "Dec 15, 2023"),
        new("4", "YZAB-5678-CDEF-9012", false),
        new("5", "GHIJ-3456-KLMN-7890", false),
        new("6", "OPQR-1234-STUV-5678", true, "Nov 28, 2023"),
    ];
}
