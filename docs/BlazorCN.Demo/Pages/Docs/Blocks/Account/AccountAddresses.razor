@* ============================================================
   Block: account-addresses
   Title: Account Addresses
   Description: Address book management with shipping addresses, billing addresses, default address selection, and address validation for e-commerce accounts
   Long Description: Account preferences and settings
   Dependencies: BadgeCn, ButtonCn, InputCn, LabelCn, LucideBuilding2Cn, LucideCheckCn, LucideCreditCardCn, LucideHomeCn, LucideLoaderCircleCn, LucideMapPinCn, LucideEllipsisCn, LucidePackageCn, LucidePencilCn, LucidePlusCn, LucideStarCn, LucideTrash2Cn
   Source: original/blocks/account/account-addresses.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                    <LucideMapPinCn Size="20" Class="text-muted-foreground" />
                    <div class="flex-1">
                        <h2 class="text-sm font-medium">Address Book</h2>
                        <p class="text-xs text-muted-foreground">
                            Manage your shipping and billing addresses
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Class="gap-2" @onclick="() => _addDialogOpen = true">
                    <LucidePlusCn Size="16" />
                    Add Address
                </ButtonCn>
            </div>
        </div>

        <div class="p-4">
            <div class="flex flex-col gap-2">
                <span class="text-xs font-medium text-muted-foreground">YOUR ADDRESSES</span>

                <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                    @foreach (var address in _addresses)
                    {
                        <div class="rounded-md border p-3 relative">
                            <div class="flex items-start justify-between mb-3">
                                <div class="flex items-center gap-2">
                                    @switch (address.Type)
                                    {
                                        case "home":
                                            <LucideHouseCn Size="16" Class="text-muted-foreground" />
                                            break;
                                        case "work":
                                            <LucideBuilding2Cn Size="16" Class="text-muted-foreground" />
                                            break;
                                        default:
                                            <LucideMapPinCn Size="16" Class="text-muted-foreground" />
                                            break;
                                    }
                                    <div>
                                        <div class="flex items-center gap-1.5">
                                            <span class="text-sm font-medium">@address.Label</span>
                                            @if (address.IsDefaultShipping || address.IsDefaultBilling)
                                            {
                                                <LucideStarCn Size="12" Class="text-amber-500 fill-amber-500" />
                                            }
                                        </div>
                                        <div class="flex items-center gap-1 mt-0.5">
                                            @if (address.IsDefaultShipping)
                                            {
                                                <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 px-1.5 text-[10px]">
                                                    Shipping
                                                </BadgeCn>
                                            }
                                            @if (address.IsDefaultBilling)
                                            {
                                                <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 px-1.5 text-[10px]">
                                                    Billing
                                                </BadgeCn>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="h-7 w-7" aria-label="More options">
                                    <LucideEllipsisCn Size="16" />
                                </ButtonCn>
                            </div>

                            <div class="space-y-0.5 text-xs">
                                <p class="font-medium">@address.Name</p>
                                <p class="text-muted-foreground">@address.Street</p>
                                @if (!string.IsNullOrEmpty(address.Apt))
                                {
                                    <p class="text-muted-foreground">@address.Apt</p>
                                }
                                <p class="text-muted-foreground">
                                    @address.City, @address.State @address.Zip
                                </p>
                            </div>
                        </div>
                    }

                    <button type="button" class="rounded-md border p-3 flex flex-col items-center justify-center gap-2 text-muted-foreground hover:bg-muted/50 transition-colors min-h-[140px]" @onclick="() => _addDialogOpen = true">
                        <div class="flex h-10 w-10 items-center justify-center rounded-md bg-muted/50">
                            <LucidePlusCn Size="20" />
                        </div>
                        <span class="text-sm font-medium">Add New Address</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Address(string Id, string Label, string Type, string Name, string Street, string? Apt, string City, string State, string Zip, string Country, string Phone, bool IsDefaultShipping, bool IsDefaultBilling);

    private bool _addDialogOpen;
    private bool _isSubmitting;

    private static readonly Address[] _addresses =
    [
        new("1", "Home", "home", "Alex Johnson", "123 Main Street", "Apt 4B", "San Francisco", "CA", "94102", "United States", "+1 (555) 123-4567", true, true),
        new("2", "Work", "work", "Alex Johnson", "456 Market Street", "Suite 800", "San Francisco", "CA", "94105", "United States", "+1 (555) 987-6543", false, false),
        new("3", "Parents", "other", "Robert Johnson", "789 Oak Avenue", null, "Los Angeles", "CA", "90001", "United States", "+1 (555) 456-7890", false, false),
    ];
}
