@* ============================================================
   Block: account-wallet
   Title: Account Wallet
   Description: Digital wallet interface with balance display, fund deposits, withdrawals, transaction history, and auto-reload settings
   Dependencies: BadgeCn, ButtonCn, DialogCn, InputCn, LabelCn, RadioGroupCn, SelectCn, SwitchCn, TabsCn
   Source: original/blocks/account/account-wallet.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <LucideWalletCn Class="h-5 w-5 text-muted-foreground" Size="20" />
                    <div>
                        <h2 class="text-sm font-medium">Wallet &amp; Balance</h2>
                        <p class="text-xs text-muted-foreground">Manage your funds, add money, and track transactions</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs"
                              OnClick="@(() => _showWithdrawDialog = true)">
                        <LucideArrowUpRightCn Class="mr-1 h-3.5 w-3.5" Size="14" />
                        Withdraw
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs"
                              OnClick="@(() => _showTopUpDialog = true)">
                        <LucidePlusCn Class="mr-1 h-3.5 w-3.5" Size="14" />
                        Add Funds
                    </ButtonCn>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-3 border-b">
            <div class="border-r p-4">
                <div class="mb-1 flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Available</span>
                    <ButtonCn Class="h-5 w-5 p-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                              OnClick="@(() => _showBalance = !_showBalance)">
                        @if (_showBalance)
                        {
                            <LucideEyeCn Class="h-3 w-3" Size="12" />
                        }
                        else
                        {
                            <LucideEyeOffCn Class="h-3 w-3" Size="12" />
                        }
                    </ButtonCn>
                </div>
                <p class="text-2xl font-semibold tabular-nums">@(_showBalance ? FormatCurrency(_availableBalance) : "------")</p>
                <p class="mt-0.5 text-xs text-emerald-600">Ready to use</p>
            </div>
            <div class="border-r p-4">
                <div class="mb-1 flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Pending</span>
                    <LucideClockCn Class="h-3 w-3 text-muted-foreground" Size="12" />
                </div>
                <p class="text-2xl font-semibold tabular-nums text-muted-foreground">@(_showBalance ? FormatCurrency(_pendingBalance) : "------")</p>
                <p class="mt-0.5 text-xs text-amber-600">Processing withdrawal</p>
            </div>
            <div class="p-4">
                <div class="mb-1 flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Bonus Credits</span>
                    <LucideGiftCn Class="h-3 w-3 text-muted-foreground" Size="12" />
                </div>
                <p class="text-2xl font-semibold tabular-nums">@(_showBalance ? FormatCurrency(_bonusCredits) : "------")</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Non-withdrawable</p>
            </div>
        </div>

        @if (_autoReloadEnabled)
        {
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <LucideRefreshCwCn Class="h-4 w-4 shrink-0 text-emerald-600" Size="16" />
                <div class="flex-1">
                    <p class="text-xs font-medium">Auto-Reload Enabled</p>
                    <p class="text-xs text-muted-foreground">Adds $@_autoReloadAmount when balance falls below $@_autoReloadThreshold</p>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 text-xs"
                          OnClick="@(() => _showAutoReloadDialog = true)">
                    Configure
                </ButtonCn>
            </div>
        }

        <div class="p-4">
            <TabsCn DefaultValue="transactions" Class="w-full">
                <TabsListCn Class="grid w-full grid-cols-2">
                    <TabsTriggerCn Value="transactions">Transactions</TabsTriggerCn>
                    <TabsTriggerCn Value="methods">Payment Methods</TabsTriggerCn>
                </TabsListCn>

                <TabsContentCn Value="transactions" Class="mt-3 space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-muted-foreground">RECENT TRANSACTIONS</span>
                        <SelectCn Value="@_txFilter" ValueChanged="@((string v) => _txFilter = v)">
                            <SelectTriggerCn Class="h-7 w-28 text-xs">
                                <SelectValueCn Placeholder="Filter" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="all">All Types</SelectItemCn>
                                <SelectItemCn Value="deposit">Deposits</SelectItemCn>
                                <SelectItemCn Value="withdrawal">Withdrawals</SelectItemCn>
                                <SelectItemCn Value="purchase">Purchases</SelectItemCn>
                                <SelectItemCn Value="refund">Refunds</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>

                    <div class="divide-y rounded-md border">
                        @foreach (var tx in _transactions)
                        {
                            <div class="flex items-center gap-3 px-3 py-2.5 transition-colors hover:bg-muted/50">
                                <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-muted/50 text-muted-foreground">
                                    @if (tx.Type == "deposit")
                                    {
                                        <LucideArrowDownLeftCn Class="h-3.5 w-3.5" Size="14" />
                                    }
                                    else if (tx.Type == "withdrawal")
                                    {
                                        <LucideArrowUpRightCn Class="h-3.5 w-3.5" Size="14" />
                                    }
                                    else if (tx.Type == "purchase")
                                    {
                                        <LucideShoppingCartCn Class="h-3.5 w-3.5" Size="14" />
                                    }
                                    else if (tx.Type == "refund")
                                    {
                                        <LucideRefreshCwCn Class="h-3.5 w-3.5" Size="14" />
                                    }
                                    else
                                    {
                                        <LucideGiftCn Class="h-3.5 w-3.5" Size="14" />
                                    }
                                </div>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-1.5">
                                        <span class="truncate text-sm font-medium">@tx.Description</span>
                                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", GetStatusDot(tx.Status))"></span>
                                    </div>
                                    <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                        <span>@tx.Date</span>
                                        <span>--</span>
                                        <span class="font-mono">@tx.Reference</span>
                                    </div>
                                </div>
                                <span class="@Cn.Merge("text-sm font-medium tabular-nums", tx.Amount > 0 ? "text-emerald-600" : "")">
                                    @(tx.Amount > 0 ? "+" : "-")@FormatCurrency(tx.Amount)
                                </span>
                            </div>
                        }
                    </div>
                </TabsContentCn>

                <TabsContentCn Value="methods" Class="mt-3 space-y-3">
                    <span class="text-xs font-medium text-muted-foreground">SAVED PAYMENT METHODS</span>

                    <div class="divide-y rounded-md border">
                        @foreach (var method in _paymentMethods)
                        {
                            <div class="flex items-center gap-3 px-3 py-2.5 transition-colors hover:bg-muted/50">
                                @if (method.Type == "bank")
                                {
                                    <LucideBuilding2Cn Class="h-4 w-4 text-muted-foreground" Size="16" />
                                }
                                else
                                {
                                    <LucideCreditCardCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                                }
                                <div class="flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@method.Name</span>
                                        @if (method.IsDefault)
                                        {
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px]">Default</BadgeCn>
                                        }
                                    </div>
                                    <p class="text-xs text-muted-foreground">ending @method.Last4</p>
                                </div>
                                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 text-xs">Edit</ButtonCn>
                            </div>
                        }
                    </div>

                    <ButtonCn Class="w-full" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">
                        <LucidePlusCn Class="mr-1 h-3.5 w-3.5" Size="14" />
                        Add Payment Method
                    </ButtonCn>
                </TabsContentCn>
            </TabsCn>
        </div>
    </div>

    <DialogCn @bind-Open="_showTopUpDialog">
        <DialogContentCn Class="w-full max-w-[450px]">
            <DialogHeaderCn>
                <DialogTitleCn>Add Funds</DialogTitleCn>
                <DialogDescriptionCn>Add money to your wallet balance</DialogDescriptionCn>
            </DialogHeaderCn>
            <div class="space-y-4 py-4">
                <div class="space-y-2">
                    <LabelCn>Select Amount</LabelCn>
                    <div class="grid grid-cols-4 gap-2">
                        @foreach (var amount in _presetAmounts)
                        {
                            var amountStr = amount.ToString();
                            <ButtonCn Size="ButtonSize.Sm"
                                      Variant="@(_topUpAmount == amountStr ? ButtonVariant.Default : ButtonVariant.Outline)"
                                      OnClick="@(() => _topUpAmount = amountStr)">
                                $@amount
                            </ButtonCn>
                        }
                    </div>
                </div>
                <div class="space-y-2">
                    <LabelCn>Or Enter Custom Amount</LabelCn>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground">$</span>
                        <InputCn Class="pl-7" type="number" placeholder="0.00" @bind-Value="_topUpAmount" />
                    </div>
                </div>
                <div class="space-y-2">
                    <LabelCn>Payment Method</LabelCn>
                    <RadioGroupCn Value="@_selectedPaymentMethod" ValueChanged="@(v => _selectedPaymentMethod = v ?? "1")">
                        @foreach (var method in _paymentMethods.Where(m => m.Type != "bank"))
                        {
                            <div class="flex items-center space-x-3 rounded-md border p-3 hover:bg-muted/50">
                                <RadioGroupItemCn Id="@($"pm-{method.Id}")" Value="@method.Id" />
                                <LabelCn Class="flex flex-1 cursor-pointer items-center gap-3" For="@($"pm-{method.Id}")">
                                    <LucideCreditCardCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                                    <div>
                                        <p class="text-sm font-medium">@method.Name</p>
                                        <p class="text-xs text-muted-foreground">ending @method.Last4</p>
                                    </div>
                                </LabelCn>
                            </div>
                        }
                    </RadioGroupCn>
                </div>
            </div>
            <DialogFooterCn>
                <ButtonCn Variant="ButtonVariant.Outline" OnClick="@(() => _showTopUpDialog = false)">Cancel</ButtonCn>
                <ButtonCn Disabled="@string.IsNullOrEmpty(_topUpAmount)" OnClick="@(() => _showTopUpDialog = false)">
                    Add $@(string.IsNullOrEmpty(_topUpAmount) ? "0" : _topUpAmount)
                </ButtonCn>
            </DialogFooterCn>
        </DialogContentCn>
    </DialogCn>

    <DialogCn @bind-Open="_showWithdrawDialog">
        <DialogContentCn Class="w-full max-w-[450px]">
            <DialogHeaderCn>
                <DialogTitleCn>Withdraw Funds</DialogTitleCn>
                <DialogDescriptionCn>Transfer money to your bank account</DialogDescriptionCn>
            </DialogHeaderCn>
            <div class="space-y-4 py-4">
                <div class="rounded-md bg-muted/50 p-3">
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-muted-foreground">Available to withdraw</span>
                        <span class="text-sm font-medium">@FormatCurrency(_availableBalance)</span>
                    </div>
                </div>
                <div class="space-y-2">
                    <LabelCn>Withdrawal Amount</LabelCn>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground">$</span>
                        <InputCn Class="pl-7" type="number" placeholder="0.00" @bind-Value="_withdrawAmount" />
                    </div>
                    <p class="text-xs text-muted-foreground">Minimum withdrawal: $10.00</p>
                </div>
                <div class="space-y-2">
                    <LabelCn>Withdraw To</LabelCn>
                    <div class="flex items-center gap-3 rounded-md border bg-muted/50 p-3">
                        <LucideBuilding2Cn Class="h-4 w-4 text-muted-foreground" Size="16" />
                        <div>
                            <p class="text-sm font-medium">Chase Bank</p>
                            <p class="text-xs text-muted-foreground">ending 9012</p>
                        </div>
                    </div>
                </div>
                <div class="flex items-start gap-2 rounded-md bg-amber-500/10 p-3">
                    <LucideCircleAlertCn Class="h-4 w-4 shrink-0 text-amber-600" Size="16" />
                    <p class="text-xs text-amber-600">Withdrawals typically take 2-3 business days to process.</p>
                </div>
            </div>
            <DialogFooterCn>
                <ButtonCn Variant="ButtonVariant.Outline" OnClick="@(() => _showWithdrawDialog = false)">Cancel</ButtonCn>
                <ButtonCn Disabled="@(string.IsNullOrEmpty(_withdrawAmount))" OnClick="@(() => _showWithdrawDialog = false)">
                    Withdraw $@(string.IsNullOrEmpty(_withdrawAmount) ? "0" : _withdrawAmount)
                </ButtonCn>
            </DialogFooterCn>
        </DialogContentCn>
    </DialogCn>

    <DialogCn @bind-Open="_showAutoReloadDialog">
        <DialogContentCn Class="w-full max-w-[450px]">
            <DialogHeaderCn>
                <DialogTitleCn>Auto-Reload Settings</DialogTitleCn>
                <DialogDescriptionCn>Automatically add funds when your balance is low</DialogDescriptionCn>
            </DialogHeaderCn>
            <div class="space-y-4 py-4">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium">Enable Auto-Reload</p>
                        <p class="text-xs text-muted-foreground">Never run out of balance</p>
                    </div>
                    <SwitchCn Checked="@_autoReloadEnabled" CheckedChanged="@((bool v) => _autoReloadEnabled = v)" />
                </div>
                @if (_autoReloadEnabled)
                {
                    <div class="space-y-2">
                        <LabelCn>When balance falls below</LabelCn>
                        <SelectCn Value="@_autoReloadThreshold" ValueChanged="@((string v) => _autoReloadThreshold = v)">
                            <SelectTriggerCn>
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="10">$10</SelectItemCn>
                                <SelectItemCn Value="25">$25</SelectItemCn>
                                <SelectItemCn Value="50">$50</SelectItemCn>
                                <SelectItemCn Value="100">$100</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                    <div class="space-y-2">
                        <LabelCn>Reload amount</LabelCn>
                        <SelectCn Value="@_autoReloadAmount" ValueChanged="@((string v) => _autoReloadAmount = v)">
                            <SelectTriggerCn>
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="25">$25</SelectItemCn>
                                <SelectItemCn Value="50">$50</SelectItemCn>
                                <SelectItemCn Value="100">$100</SelectItemCn>
                                <SelectItemCn Value="200">$200</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                }
            </div>
            <DialogFooterCn>
                <ButtonCn Variant="ButtonVariant.Outline" OnClick="@(() => _showAutoReloadDialog = false)">Cancel</ButtonCn>
                <ButtonCn OnClick="@(() => _showAutoReloadDialog = false)">Save Settings</ButtonCn>
            </DialogFooterCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private record Transaction(string Id, string Type, string Description, double Amount, string Status, string Date, string Reference);
    private record PaymentMethod(string Id, string Type, string Name, string Last4, bool IsDefault);

    private bool _showBalance = true;
    private bool _showTopUpDialog;
    private bool _showWithdrawDialog;
    private bool _showAutoReloadDialog;
    private string _topUpAmount = "";
    private string _withdrawAmount = "";
    private string _selectedPaymentMethod = "1";
    private bool _autoReloadEnabled = true;
    private string _autoReloadThreshold = "25";
    private string _autoReloadAmount = "100";
    private string _txFilter = "all";

    private const double _availableBalance = 285.00;
    private const double _pendingBalance = 200.00;
    private const double _bonusCredits = 10.00;

    private static readonly int[] _presetAmounts = [25, 50, 100, 250];

    private static readonly Transaction[] _transactions =
    [
        new("1", "deposit", "Added funds via Visa 4242", 100, "completed", "2 hours ago", "TXN-2024-001847"),
        new("2", "purchase", "Order #ORD-8847 - Premium Headphones", -79.99, "completed", "1 day ago", "TXN-2024-001846"),
        new("3", "withdrawal", "Withdrawal to Bank 9012", -200, "pending", "4 days ago", "TXN-2024-001843"),
    ];

    private static readonly PaymentMethod[] _paymentMethods =
    [
        new("1", "card", "Visa", "4242", true),
        new("2", "card", "Mastercard", "8888", false),
        new("3", "bank", "Chase Bank", "9012", false),
    ];

    private static string GetStatusDot(string status) => status switch
    {
        "completed" => "bg-emerald-500",
        "pending" => "bg-amber-500",
        "failed" => "bg-red-500",
        _ => "bg-muted-foreground",
    };

    private static string FormatCurrency(double amount) => $"${Math.Abs(amount):F2}";
}
