@* ============================================================
   Block: account-activity-log
   Title: Account Activity Log
   Description: Activity and audit log showing account events, security actions, login history, and system changes with filtering
   Dependencies: BadgeCn, ButtonCn, SelectCn
   Source: original/blocks/account/account-activity-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <LucideActivityCn Class="h-5 w-5 text-muted-foreground" Size="20" />
                    <div>
                        <h2 class="text-sm font-medium">Activity Log</h2>
                        <p class="text-xs text-muted-foreground">Track your account activity and security events</p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="gap-2">
                    <LucideDownloadCn Class="h-4 w-4" Size="16" />
                    Export
                </ButtonCn>
            </div>
        </div>

        <div class="p-4">
            <div class="mb-3 flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">RECENT ACTIVITY</span>
                <div class="flex items-center gap-2">
                    <LucideFilterCn Class="h-3.5 w-3.5 text-muted-foreground" Size="14" />
                    <SelectCn Value="@_filterType" ValueChanged="@((string v) => _filterType = v)">
                        <SelectTriggerCn Class="h-8 w-36">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="all">All Events</SelectItemCn>
                            <SelectItemCn Value="security">Security</SelectItemCn>
                            <SelectItemCn Value="login">Login</SelectItemCn>
                            <SelectItemCn Value="settings">Settings</SelectItemCn>
                            <SelectItemCn Value="api">API</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="space-y-2">
                @foreach (var evt in _filteredEvents)
                {
                    var label = evt.Type switch { "login" => "Login", "security" => "Security", "settings" => "Settings", "api" => "API", _ => "Other" };
                    <button type="button" class="@Cn.Merge("group w-full rounded-md border p-3 text-left transition-colors hover:bg-muted/50", evt.Critical ? "border-l-4 border-l-red-500" : "")">
                        <div class="flex items-start gap-3">
                            @if (evt.Type == "login")
                            {
                                <LucideLogInCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                            }
                            else if (evt.Type == "security")
                            {
                                <LucideShieldCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                            }
                            else if (evt.Type == "settings")
                            {
                                <LucideSettingsCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                            }
                            else
                            {
                                <LucideKeyCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                            }

                            <div class="min-w-0 flex-1">
                                <div class="mb-1 flex items-start justify-between gap-2">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <span class="text-sm font-medium">@evt.Action</span>
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px]">@label</BadgeCn>
                                        @if (evt.Success)
                                        {
                                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                        }
                                        else
                                        {
                                            <span class="size-1.5 rounded-full bg-red-500"></span>
                                        }
                                    </div>
                                    <div class="flex items-center gap-1 whitespace-nowrap text-xs text-muted-foreground">
                                        <LucideClockCn Class="h-3 w-3" Size="12" />
                                        @evt.Timestamp
                                    </div>
                                </div>
                                <p class="mb-2 text-xs text-muted-foreground">@evt.Description</p>
                                <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                                    <div class="flex items-center gap-1 rounded-md bg-muted/50 px-2 py-0.5">
                                        <LucideMapPinCn Class="h-3 w-3" Size="12" />
                                        <span>@evt.Location</span>
                                    </div>
                                    <div class="flex items-center gap-1 rounded-md bg-muted/50 px-2 py-0.5">
                                        <LucideMonitorCn Class="h-3 w-3" Size="12" />
                                        <span>@evt.Device</span>
                                    </div>
                                </div>
                            </div>
                            <LucideChevronRightCn Class="h-4 w-4 text-muted-foreground/30 transition-colors group-hover:text-muted-foreground" Size="16" />
                        </div>
                    </button>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ActivityEvent(string Id, string Type, string Action, string Description, string Timestamp, string Location, string Device, bool Success, bool Critical = false);

    private string _filterType = "all";

    private ActivityEvent[] _filteredEvents => _filterType == "all"
        ? _events
        : _events.Where(e => e.Type == _filterType).ToArray();

    private static readonly ActivityEvent[] _events =
    [
        new("1", "login", "Successful login", "Signed in from Chrome on MacBook Pro", "2 hours ago", "New York, USA", "MacBook Pro", true),
        new("2", "security", "Password changed", "Account password was successfully updated", "1 day ago", "New York, USA", "MacBook Pro", true, true),
        new("3", "login", "Failed login attempt", "Login failed - incorrect password", "3 days ago", "London, UK", "Unknown", false, true),
    ];
}
