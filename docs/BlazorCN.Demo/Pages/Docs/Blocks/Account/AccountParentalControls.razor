@* ============================================================
   Block: account-parental-controls
   Title: Account Parental Controls
   Description: Content and spending restrictions for managed child accounts with content filtering, spending limits, and screen time controls
   Long Description: Parental controls for managed accounts
   Dependencies: ButtonCn, InputCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, SwitchCn, LucideLoaderCircleCn, LucideShieldCheckCn
   Source: original/blocks/account/account-parental-controls.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <LucideShieldCheckCn Size="20" Class="text-muted-foreground" />
                <div>
                    <h2 class="text-sm font-medium">Parental Controls</h2>
                    <p class="text-xs text-muted-foreground">Content and spending restrictions for this account</p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex-1">
                    <span class="text-sm font-medium">Content Filter</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">Control what content is visible</p>
                </div>
                <SelectCn Value="@_contentFilter" ValueChanged='v => _contentFilter = v ?? "moderate"'>
                    <SelectTriggerCn aria-label="Content filter" Class="h-9 w-[180px]">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="unrestricted">Unrestricted</SelectItemCn>
                        <SelectItemCn Value="moderate">Moderate</SelectItemCn>
                        <SelectItemCn Value="strict">Strict</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex-1">
                    <span class="text-sm font-medium">Monthly Spending Limit</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">$32 used of $@_spendingLimit this month</p>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="text-sm text-muted-foreground">$</span>
                    <InputCn aria-label="Monthly Spending Limit" Class="h-9 w-[80px] text-right font-mono tabular-nums" Value="@_spendingLimit" ValueChanged='v => _spendingLimit = v ?? "50"' />
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex-1">
                    <span class="text-sm font-medium">Daily Screen Time</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">Maximum time allowed per day</p>
                </div>
                <SelectCn Value="@_screenTime" ValueChanged='v => _screenTime = v ?? "2h"'>
                    <SelectTriggerCn aria-label="Daily screen time" Class="h-9 w-[180px]">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="1h">1 hour</SelectItemCn>
                        <SelectItemCn Value="2h">2 hours</SelectItemCn>
                        <SelectItemCn Value="4h">4 hours</SelectItemCn>
                        <SelectItemCn Value="unlimited">Unlimited</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex-1">
                    <span class="text-sm font-medium">Require Approval for Purchases</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">All purchases need parent approval before processing</p>
                </div>
                <SwitchCn aria-label="Require Approval for Purchases" Checked="_requireApproval" CheckedChanged="v => _requireApproval = v" />
            </div>
        </div>

        <div class="flex items-center justify-end px-4 py-3">
            <ButtonCn Class="min-w-[140px]" Disabled="@_isSaving" @onclick="HandleSave">
                @if (_isSaving)
                {
                    <LucideLoaderCircleCn Size="16" Class="mr-2 animate-spin" />
                    <span>Saving...</span>
                }
                else
                {
                    <span>Save Changes</span>
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _contentFilter = "moderate";
    private string _spendingLimit = "50";
    private string _screenTime = "2h";
    private bool _requireApproval = true;
    private bool _isSaving;

    private async Task HandleSave()
    {
        _isSaving = true;
        StateHasChanged();
        await Task.Delay(1500);
        _isSaving = false;
    }
}
