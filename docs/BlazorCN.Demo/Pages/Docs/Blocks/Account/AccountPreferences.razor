@* ============================================================
   Block: account-preferences
   Title: Account Preferences
   Description: Account preferences with language selection, timezone configuration, date/time format options, currency display, measurement units, and regional settings
   Long Description: Account preferences
   Dependencies: BadgeCn, ButtonCn, LabelCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, SwitchCn
   Source: original/blocks/account/account-preferences.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="mb-1 flex items-center gap-2">
                <h2 class="text-sm font-medium">Preferences</h2>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@SelectedLanguageNative</BadgeCn>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@SelectedTimezoneOffset</BadgeCn>
            </div>
            <p class="text-xs text-muted-foreground">
                Configure language, timezone, and regional settings
            </p>
        </div>

        <div class="border-b bg-muted/50 px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Live Preview</p>
            <div class="grid grid-cols-3 gap-2">
                <div class="rounded-md border bg-background px-2 py-1.5">
                    <p class="text-[10px] uppercase tracking-wide text-muted-foreground">Date</p>
                    <p class="font-mono text-sm font-semibold tabular-nums">@PreviewDate</p>
                </div>
                <div class="rounded-md border bg-background px-2 py-1.5">
                    <p class="text-[10px] uppercase tracking-wide text-muted-foreground">Time</p>
                    <p class="font-mono text-sm font-semibold tabular-nums">@PreviewTime</p>
                </div>
                <div class="rounded-md border bg-background px-2 py-1.5">
                    <p class="text-[10px] uppercase tracking-wide text-muted-foreground">Currency</p>
                    <p class="font-mono text-sm font-semibold tabular-nums">@PreviewCurrency</p>
                </div>
                <div class="rounded-md border bg-background px-2 py-1.5">
                    <p class="text-[10px] uppercase tracking-wide text-muted-foreground">Number</p>
                    <p class="font-mono text-sm font-semibold tabular-nums">1,234.56</p>
                </div>
                <div class="rounded-md border bg-background px-2 py-1.5">
                    <p class="text-[10px] uppercase tracking-wide text-muted-foreground">Temp</p>
                    <p class="font-mono text-sm font-semibold tabular-nums">@(_measurementUnit == "imperial" ? "72\u00b0F" : "22\u00b0C")</p>
                </div>
                <div class="rounded-md border bg-background px-2 py-1.5">
                    <p class="text-[10px] uppercase tracking-wide text-muted-foreground">Distance</p>
                    <p class="font-mono text-sm font-semibold tabular-nums">@(_measurementUnit == "imperial" ? "5.2 miles" : "8.4 km")</p>
                </div>
            </div>
        </div>

        <div class="border-b">
            <div class="border-b bg-muted/50 px-4 py-2">
                <p class="text-xs font-medium text-muted-foreground">Language & Region</p>
            </div>
            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between">
                    <div class="flex-1">
                        <LabelCn Class="font-medium">Language</LabelCn>
                        <p class="text-xs text-muted-foreground">Select your preferred display language</p>
                    </div>
                    <SelectCn Value="@_language" ValueChanged='v => _language = v ?? "en-US"'>
                        <SelectTriggerCn aria-label="Language" Class="h-9 w-[200px]">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="en-US">English (US)</SelectItemCn>
                            <SelectItemCn Value="en-GB">English (UK)</SelectItemCn>
                            <SelectItemCn Value="es-ES">Spanish</SelectItemCn>
                            <SelectItemCn Value="fr-FR">French</SelectItemCn>
                            <SelectItemCn Value="de-DE">German</SelectItemCn>
                            <SelectItemCn Value="ja-JP">Japanese</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>
            <div class="px-4 py-3">
                <div class="flex items-center justify-between">
                    <div class="flex-1">
                        <LabelCn Class="font-medium">Currency</LabelCn>
                        <p class="text-xs text-muted-foreground">Default currency for displaying prices</p>
                    </div>
                    <SelectCn Value="@_currency" ValueChanged='v => _currency = v ?? "USD"'>
                        <SelectTriggerCn aria-label="Currency" Class="h-9 w-[200px]">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="USD">$ USD - US Dollar</SelectItemCn>
                            <SelectItemCn Value="EUR">EUR - Euro</SelectItemCn>
                            <SelectItemCn Value="GBP">GBP - British Pound</SelectItemCn>
                            <SelectItemCn Value="JPY">JPY - Japanese Yen</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>
        </div>

        <div class="border-b">
            <div class="border-b bg-muted/50 px-4 py-2">
                <p class="text-xs font-medium text-muted-foreground">Date & Time</p>
            </div>
            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between">
                    <div class="flex-1">
                        <LabelCn Class="font-medium">Timezone</LabelCn>
                        <p class="text-xs text-muted-foreground">Your local timezone for displaying times</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="flex items-center gap-2">
                            <SwitchCn aria-label="Auto-detect timezone" Checked="_autoDetectTimezone" CheckedChanged="v => _autoDetectTimezone = v" />
                            <LabelCn Class="text-xs font-normal text-muted-foreground">Auto-detect</LabelCn>
                        </div>
                        <SelectCn Value="@_timezone" ValueChanged='v => _timezone = v ?? "America/New_York"' Disabled="_autoDetectTimezone">
                            <SelectTriggerCn aria-label="Timezone" Class="h-9 w-[200px]">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="America/New_York">Eastern Time (ET) UTC-5</SelectItemCn>
                                <SelectItemCn Value="America/Los_Angeles">Pacific Time (PT) UTC-8</SelectItemCn>
                                <SelectItemCn Value="Europe/London">London (GMT) UTC+0</SelectItemCn>
                                <SelectItemCn Value="Asia/Tokyo">Tokyo (JST) UTC+9</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                </div>
            </div>
            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between">
                    <div class="flex-1">
                        <LabelCn Class="font-medium">Date Format</LabelCn>
                        <p class="text-xs text-muted-foreground">How dates are displayed throughout the app</p>
                    </div>
                    <SelectCn Value="@_dateFormat" ValueChanged='v => _dateFormat = v ?? "MM/DD/YYYY"'>
                        <SelectTriggerCn aria-label="Date format" Class="h-9 w-[200px]">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="MM/DD/YYYY">01/15/2024</SelectItemCn>
                            <SelectItemCn Value="DD/MM/YYYY">15/01/2024</SelectItemCn>
                            <SelectItemCn Value="YYYY-MM-DD">2024-01-15</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>
            <div class="px-4 py-3">
                <div class="flex items-center justify-between">
                    <div class="flex-1">
                        <LabelCn Class="font-medium">Time Format</LabelCn>
                        <p class="text-xs text-muted-foreground">12-hour or 24-hour clock</p>
                    </div>
                    <SelectCn Value="@_timeFormat" ValueChanged='v => _timeFormat = v ?? "12h"'>
                        <SelectTriggerCn aria-label="Time format" Class="h-9 w-[200px]">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="12h">2:30 PM (12-hour)</SelectItemCn>
                            <SelectItemCn Value="24h">14:30 (24-hour)</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>
        </div>

        <div class="border-b">
            <div class="border-b bg-muted/50 px-4 py-2">
                <p class="text-xs font-medium text-muted-foreground">Measurement Units</p>
            </div>
            <div class="px-4 py-3">
                <div class="flex items-center justify-between">
                    <div class="flex-1">
                        <LabelCn Class="font-medium">Unit System</LabelCn>
                        <p class="text-xs text-muted-foreground">Metric (km, kg, \u00b0C) or Imperial (mi, lb, \u00b0F)</p>
                    </div>
                    <SelectCn Value="@_measurementUnit" ValueChanged='v => _measurementUnit = v ?? "imperial"'>
                        <SelectTriggerCn aria-label="Unit system" Class="h-9 w-[200px]">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="metric">Metric (km, kg, \u00b0C)</SelectItemCn>
                            <SelectItemCn Value="imperial">Imperial (mi, lb, \u00b0F)</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-end gap-3 px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline">
                Reset to Defaults
            </ButtonCn>
            <ButtonCn Class="min-w-[140px]">
                Save Preferences
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _language = "en-US";
    private string _timezone = "America/New_York";
    private string _currency = "USD";
    private string _dateFormat = "MM/DD/YYYY";
    private string _timeFormat = "12h";
    private string _measurementUnit = "imperial";
    private bool _autoDetectTimezone = true;

    private string SelectedLanguageNative => _language switch
    {
        "en-US" or "en-GB" => "English",
        "es-ES" => "Espa\u00f1ol",
        "fr-FR" => "Fran\u00e7ais",
        "de-DE" => "Deutsch",
        "ja-JP" => "\u65e5\u672c\u8a9e",
        _ => "English",
    };

    private string SelectedTimezoneOffset => _timezone switch
    {
        "America/New_York" => "UTC-5",
        "America/Los_Angeles" => "UTC-8",
        "Europe/London" => "UTC+0",
        "Asia/Tokyo" => "UTC+9",
        _ => "UTC-5",
    };

    private string PreviewDate => _dateFormat switch
    {
        "MM/DD/YYYY" => "01/15/2024",
        "DD/MM/YYYY" => "15/01/2024",
        "YYYY-MM-DD" => "2024-01-15",
        _ => "01/15/2024",
    };

    private string PreviewTime => _timeFormat == "12h" ? "2:30 PM" : "14:30";

    private string PreviewCurrency => _currency switch
    {
        "USD" => "$1,234.56",
        "EUR" => "\u20ac1,234.56",
        "GBP" => "\u00a31,234.56",
        "JPY" => "\u00a51,234.56",
        _ => "$1,234.56",
    };
}
