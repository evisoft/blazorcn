                                    <p class=""text-sm font-semibold tabular-nums"">$@card.RemainingAmount.ToString(""F2"")</p>
                                    <p class=""text-xs tabular-nums text-muted-foreground"">of $@card.OriginalAmount.ToString(""F2"")</p>
                                </div>
                            </div>
                        }
                    </div>
                </TabsContentCn>
            </TabsCn>
        </div>
    </div>
</section>

