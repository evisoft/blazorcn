    private List<AllowlistEntry> _entries =
    [
        new() { Id = ""1"", Label = ""Office Network"", Ip = ""203.0.113.0/24"", Added = ""Jan 12, 2026"" },
        new() { Id = ""2"", Label = ""VPN Gateway"", Ip = ""198.51.100.42"", Added = ""Feb 3, 2026"" },
        new() { Id = ""3"", Label = ""Home (Alice)"", Ip = ""192.0.2.17"", Added = ""Mar 1, 2026"" },
    ];

    private void HandleRemove(string id) => _entries.RemoveAll(e => e.Id == id);

    private void HandleAdd()
    {
        if (string.IsNullOrWhiteSpace(_newLabel) || string.IsNullOrWhiteSpace(_newIp)) return;
        _entries.Add(new AllowlistEntry
        {
            Id = (_entries.Count + 1).ToString(),
            Label = _newLabel.Trim(),
            Ip = _newIp.Trim(),
            Added = ""Mar 15, 2026"",
        });
        _newLabel = """";
        _newIp = """";
        _dialogOpen = false;
    }
}";
