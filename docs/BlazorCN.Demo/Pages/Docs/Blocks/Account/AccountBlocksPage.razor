            </div>
        </div>

        @* ── SEARCH STEP ── *@
        @if (_step == ""search"")
        {
            <div class=""px-6 py-5"">
                <span class=""text-xs font-medium text-muted-foreground"">
                    FIND ACCOUNT TO MERGE
