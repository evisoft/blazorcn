                                        <BadgeCn Variant=""BadgeVariant.Outline"" Class=""text-[10px] h-4 px-1.5 gap-0.5"">
                                            <LucideShieldCheckCn Class=""h-2.5 w-2.5"" Size=""10"" />
                                            Trusted
                                        </BadgeCn>
                                    }
                                    @if (device.IsNew)
                                    {
                                        <BadgeCn Class=""bg-amber-500/10 text-amber-600 text-[10px] h-4 px-1.5"">New</BadgeCn>
                                    }
                                </div>
                                <div class=""mt-0.5 flex items-center gap-2 text-xs text-muted-foreground"">
                                    <span class=""flex items-center gap-1"">
                                        <LucideGlobeCn Class=""h-3 w-3"" Size=""12"" />
                                        @device.Browser &middot; @device.Os
                                    </span>
                                    <span class=""flex items-center gap-1"">
                                        <LucideMapPinCn Class=""h-3 w-3"" Size=""12"" />
                                        @device.Location
                                    </span>
                                </div>
                            </div>
                            <p class=""shrink-0 text-xs text-muted-foreground"">@device.LastActive</p>
                            <DropdownMenuCn>
                                <DropdownMenuTriggerCn>
                                    <ButtonCn Class=""h-7 w-7 p-0"" Size=""ButtonSize.Sm"" Variant=""ButtonVariant.Ghost"">
                                        <LucideMoreVerticalCn Class=""h-4 w-4"" Size=""16"" />
                                    </ButtonCn>
                                </DropdownMenuTriggerCn>
                                <DropdownMenuContentCn Align=""FloatingAlign.End"">
                                    <DropdownMenuItemCn OnClick=""@(() => { _selectedDevice = device; _newDeviceName = device.Name; _showRenameDialog = true; })"">
                                        <LucidePencilCn Class=""mr-2 h-4 w-4"" Size=""16"" />
                                        Rename Device
                                    </DropdownMenuItemCn>
                                    @if (!device.IsCurrent)
                                    {
                                        <DropdownMenuItemCn OnClick=""@(() => ToggleTrusted(device.Id))"">
                                            <LucideShieldCheckCn Class=""mr-2 h-4 w-4"" Size=""16"" />
                                            @(device.IsTrusted ? ""Remove Trust"" : ""Mark as Trusted"")
                                        </DropdownMenuItemCn>
                                        <DropdownMenuSeparatorCn />
                                        <DropdownMenuItemCn Class=""text-destructive focus:text-destructive""
                                                            OnClick=""@(() => { _selectedDevice = device; _showRevokeDialog = true; })"">
                                            <LucideLogOutCn Class=""mr-2 h-4 w-4"" Size=""16"" />
                                            Revoke Access
                                        </DropdownMenuItemCn>
                                    }
                                </DropdownMenuContentCn>
                            </DropdownMenuCn>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <DialogCn @bind-Open=""_showRenameDialog"">
        <DialogContentCn Class=""w-full max-w-[400px]"">
            <DialogHeaderCn>
                <DialogTitleCn>Rename Device</DialogTitleCn>
                <DialogDescriptionCn>Give this device a name you'll recognize</DialogDescriptionCn>
            </DialogHeaderCn>
            <div class=""space-y-4 py-4"">
                <div class=""space-y-2"">
                    <LabelCn For=""device-name"">Device Name</LabelCn>
                    <InputCn id=""device-name"" placeholder=""e.g., Work Laptop, Personal Phone"" @bind-Value=""_newDeviceName"" />
                </div>
            </div>
            <DialogFooterCn>
                <ButtonCn Variant=""ButtonVariant.Outline"" OnClick=""@(() => _showRenameDialog = false)"">Cancel</ButtonCn>
                <ButtonCn Disabled=""@string.IsNullOrWhiteSpace(_newDeviceName)"" OnClick=""HandleRename"">Save Name</ButtonCn>
            </DialogFooterCn>
        </DialogContentCn>
    </DialogCn>

    <AlertDialogCn @bind-Open=""_showRevokeDialog"">
        <AlertDialogContentCn>
            <AlertDialogHeaderCn>
                <AlertDialogTitleCn>Revoke Device Access</AlertDialogTitleCn>
                <AlertDialogDescriptionCn>This will immediately log out ""@(_selectedDevice?.Name)"" and require re-authentication. Are you sure?</AlertDialogDescriptionCn>
            </AlertDialogHeaderCn>
            <AlertDialogFooterCn>
                <AlertDialogCancelCn>Cancel</AlertDialogCancelCn>
                <AlertDialogActionCn Class=""bg-destructive text-destructive-foreground hover:bg-destructive/90"" OnClick=""HandleRevoke"">Revoke Access</AlertDialogActionCn>
            </AlertDialogFooterCn>
        </AlertDialogContentCn>
    </AlertDialogCn>

    <AlertDialogCn @bind-Open=""_showLogoutAllDialog"">
        <AlertDialogContentCn>
            <AlertDialogHeaderCn>
                <AlertDialogTitleCn>Log Out All Devices</AlertDialogTitleCn>
                <AlertDialogDescriptionCn>This will log out all devices except your current one. You'll need to sign in again on those devices.</AlertDialogDescriptionCn>
            </AlertDialogHeaderCn>
            <AlertDialogFooterCn>
                <AlertDialogCancelCn>Cancel</AlertDialogCancelCn>
                <AlertDialogActionCn Class=""bg-destructive text-destructive-foreground hover:bg-destructive/90"" OnClick=""HandleLogoutAll"">Log Out All</AlertDialogActionCn>
            </AlertDialogFooterCn>
        </AlertDialogContentCn>
    </AlertDialogCn>
</section>

@code {
    private class Device
    {
        public string Id { get; set; } = """";
        public string Name { get; set; } = """";
        public string Type { get; set; } = """";
        public string Browser { get; set; } = """";
        public string Os { get; set; } = """";
        public string Location { get; set; } = """";
        public string LastActive { get; set; } = """";
        public bool IsCurrent { get; set; }
        public bool IsTrusted { get; set; }
        public bool IsNew { get; set; }
    }

    private Device? _selectedDevice;
    private bool _showRenameDialog;
    private bool _showRevokeDialog;
    private bool _showLogoutAllDialog;
    private string _newDeviceName = """";
    private bool _notifyNewDevices = true;

    private List<Device> _deviceList =
    [
        new() { Id = ""1"", Name = ""MacBook Pro"", Type = ""laptop"", Browser = ""Chrome 120"", Os = ""macOS Sonoma"", Location = ""New York, NY"", LastActive = ""Active now"", IsCurrent = true, IsTrusted = true, IsNew = false },
        new() { Id = ""2"", Name = ""iPhone 15 Pro"", Type = ""mobile"", Browser = ""Safari"", Os = ""iOS 17.2"", Location = ""New York, NY"", LastActive = ""30 min ago"", IsCurrent = false, IsTrusted = true, IsNew = false },
        new() { Id = ""3"", Name = ""Unknown Device"", Type = ""mobile"", Browser = ""Chrome Mobile"", Os = ""Android 14"", Location = ""Chicago, IL"", LastActive = ""2 hours ago"", IsCurrent = false, IsTrusted = false, IsNew = true },
    ];

    private void ToggleTrusted(string id)
    {
        var device = _deviceList.FirstOrDefault(d => d.Id == id);
        if (device != null) device.IsTrusted = !device.IsTrusted;
    }

    private void HandleRename()
    {
        if (_selectedDevice != null && !string.IsNullOrWhiteSpace(_newDeviceName))
        {
            _selectedDevice.Name = _newDeviceName.Trim();
            _showRenameDialog = false;
            _selectedDevice = null;
            _newDeviceName = """";
        }
    }

    private void HandleRevoke()
    {
        if (_selectedDevice != null)
        {
            _deviceList.RemoveAll(d => d.Id == _selectedDevice.Id);
            _showRevokeDialog = false;
            _selectedDevice = null;
        }
    }

    private void HandleLogoutAll()
    {
        _deviceList.RemoveAll(d => !d.IsCurrent);
        _showLogoutAllDialog = false;
    }
}";
