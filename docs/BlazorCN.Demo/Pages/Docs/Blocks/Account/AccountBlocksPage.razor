@code {
    private class NotificationRule
    {
        public string Id { get; set; } = """";
        public string Condition { get; set; } = """";
        public List<string> Channels { get; set; } = [];
        public bool Enabled { get; set; }
    }

    private bool _dialogOpen;
    private string _newCondition = """";
    private HashSet<string> _newChannels = [];

    private List<NotificationRule> _rules =
    [
        new() { Id = ""1"", Condition = ""When invoice exceeds $500"", Channels = [""email"", ""sms""], Enabled = true },
        new() { Id = ""2"", Condition = ""When new team member joins"", Channels = [""slack""], Enabled = true },
        new() { Id = ""3"", Condition = ""When storage hits 90%"", Channels = [""email""], Enabled = false },
    ];

    private static readonly string[] _conditionOptions =
    [
        ""When invoice exceeds $1,000"",
        ""When API usage hits 80%"",
        ""When payment fails"",
        ""When user role changes"",
        ""When security alert triggered"",
        ""When subscription renews"",
    ];

    private static string GetChannelLabel(string channel) => channel switch
    {
        ""email"" => ""Email"",
        ""sms"" => ""SMS"",
        ""slack"" => ""Slack"",
        ""push"" => ""Push"",
        _ => channel,
    };

    private void ToggleChannel(string channel)
    {
        if (!_newChannels.Remove(channel)) _newChannels.Add(channel);
    }

    private void HandleAddRule()
    {
        if (string.IsNullOrEmpty(_newCondition) || _newChannels.Count == 0) return;
        _rules.Add(new NotificationRule
        {
            Id = (_rules.Count + 1).ToString(),
            Condition = _newCondition,
            Channels = [.. _newChannels],
            Enabled = true,
        });
        _newCondition = """";
        _newChannels = [];
        _dialogOpen = false;
    }
}";
