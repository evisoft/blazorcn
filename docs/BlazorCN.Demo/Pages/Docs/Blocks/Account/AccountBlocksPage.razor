                            var dot = tx.Type switch { ""credit"" => ""bg-emerald-500"", ""debit"" => ""bg-blue-500"", ""expired"" => ""bg-red-500"", _ => ""bg-muted-foreground"" };
                            <div class=""flex items-center gap-3 rounded-md border px-4 py-3"">
