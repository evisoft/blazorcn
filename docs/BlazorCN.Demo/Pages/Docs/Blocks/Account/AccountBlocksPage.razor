                        <ButtonCn Variant=""ButtonVariant.Ghost"" Size=""ButtonSize.Icon"" Class=""h-8 w-8"" @onclick=""@(() => _showInviteForm = false)"">
                            <LucideIconCn Name=""x"" Size=""14"" Class=""h-3.5 w-3.5"" />
