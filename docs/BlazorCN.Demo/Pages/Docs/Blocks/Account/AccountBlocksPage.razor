        </div>

        <div class=""px-4 py-3"">
            <TabsCn DefaultValue=""history"">
                <TabsListCn Class=""mb-4"">
                    <TabsTriggerCn Value=""history"">Transaction History</TabsTriggerCn>
                    <TabsTriggerCn Value=""giftcards"">Gift Cards</TabsTriggerCn>
                </TabsListCn>

                <TabsContentCn Value=""history"">
                    <div class=""space-y-3"">
