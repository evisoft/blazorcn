@code {
    private class Permission
    {
        public bool View { get; set; }
        public bool Edit { get; set; }
        public bool Delete { get; set; }
        public bool Admin { get; set; }

        public bool GetPermission(string key) => key switch
        {
            ""view"" => View,
            ""edit"" => Edit,
            ""delete"" => Delete,
            ""admin"" => Admin,
            _ => false,
        };

        public void SetPermission(string key, bool value)
        {
            switch (key)
            {
                case ""view"": View = value; break;
                case ""edit"": Edit = value; break;
                case ""delete"": Delete = value; break;
                case ""admin"": Admin = value; break;
            }
        }
    }

    private class Resource
    {
        public string Id { get; set; } = """";
        public string Name { get; set; } = """";
        public string Description { get; set; } = """";
        public string Icon { get; set; } = """";
        public Permission Permissions { get; set; } = new();
        public bool Inherited { get; set; }

        public bool GetPermission(string key) => Permissions.GetPermission(key);
    }

    private record Role(string Id, string Name, string Description, int MemberCount, bool IsSystem);
    private record AuditChange(string Action, string Resource, string Role, string User, string Time, string Type);

    private string _selectedRole = ""admin"";

    private int TotalPermissions => _resources.Sum(r =>
        (r.Permissions.View ? 1 : 0) + (r.Permissions.Edit ? 1 : 0) +
        (r.Permissions.Delete ? 1 : 0) + (r.Permissions.Admin ? 1 : 0));

    private static readonly Role[] _roles =
    [
        new(""admin"", ""Admin"", ""Manage team and settings"", 3, true),
        new(""member"", ""Member"", ""Standard team access"", 12, true),
        new(""guest"", ""Guest"", ""Limited read-only access"", 4, false),
    ];

    private readonly List<Resource> _resources =
    [
        new() { Id = ""users"", Name = ""Team Members"", Description = ""Manage team and invitations"", Icon = ""users"", Permissions = new() { View = true, Edit = true, Delete = true, Admin = true } },
        new() { Id = ""projects"", Name = ""Projects"", Description = ""Access and manage projects"", Icon = ""projects"", Permissions = new() { View = true, Edit = true, Delete = true, Admin = true } },
        new() { Id = ""billing"", Name = ""Billing & Payments"", Description = ""View invoices and manage payments"", Icon = ""billing"", Permissions = new() { View = true, Edit = true, Delete = false, Admin = true } },
    ];

    private static readonly AuditChange[] _recentChanges =
    [
        new(""Added delete permission"", ""Projects"", ""Manager"", ""Sarah Chen"", ""2 hours ago"", ""add""),
        new(""Removed admin access"", ""Billing"", ""Member"", ""John Smith"", ""1 day ago"", ""remove""),
        new(""Created custom role"", ""Guest"", ""\u2014"", ""Sarah Chen"", ""3 days ago"", ""create""),
    ];

    private void TogglePermission(string resourceId, string permissionType)
    {
        var resource = _resources.FirstOrDefault(r => r.Id == resourceId);
        if (resource != null && !resource.Inherited)
        {
            resource.Permissions.SetPermission(permissionType, !resource.GetPermission(permissionType));
        }
    }
}";
