    private const string AccountPasskeysCode = @"<section class=""mx-auto w-full max-w-2xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        <div class=""border-b px-4 py-3"">
            <div class=""flex items-center justify-between"">
                <div class=""flex items-center gap-3"">
                    <LucideFingerprintCn Class=""h-5 w-5 text-muted-foreground"" Size=""20"" />
                    <div>
                        <h2 class=""text-sm font-medium"">Passkeys</h2>
                        <p class=""text-xs text-muted-foreground"">Sign in securely without passwords using biometrics</p>
                    </div>
                </div>
                <ButtonCn Size=""ButtonSize.Sm"" Class=""gap-1.5"" OnClick=""@(() => _showAddDialog = true)"">
                    <LucidePlusCn Class=""h-3.5 w-3.5"" Size=""14"" />
                    Add Passkey
                </ButtonCn>
            </div>
        </div>

        <div class=""space-y-4 p-4"">
            <div class=""space-y-2"">
