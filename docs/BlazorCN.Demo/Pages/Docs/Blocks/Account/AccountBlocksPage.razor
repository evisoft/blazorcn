@code {
    private class Workspace
    {
        public string Id { get; set; } = """";
        public string Name { get; set; } = """";
        public string Initial { get; set; } = """";
        public string Role { get; set; } = """";
        public int MemberCount { get; set; }
        public bool IsCurrent { get; set; }
    }

    private bool _createDialogOpen;
    private string _newWorkspaceName = """";

    private List<Workspace> _workspaces =
    [
        new() { Id = ""1"", Name = ""Acme Corp"", Initial = ""AC"", Role = ""Owner"", MemberCount = 12, IsCurrent = true },
        new() { Id = ""2"", Name = ""Freelance Projects"", Initial = ""FP"", Role = ""Admin"", MemberCount = 4, IsCurrent = false },
        new() { Id = ""3"", Name = ""Open Source Collective"", Initial = ""OS"", Role = ""Member"", MemberCount = 38, IsCurrent = false },
    ];

    private static string GetRoleBadgeStyle(string role) => role switch
    {
        ""Owner"" => ""bg-amber-500/10 text-amber-700"",
        ""Admin"" => ""bg-blue-500/10 text-blue-700"",
        _ => ""bg-muted text-muted-foreground"",
    };

    private void HandleSwitch(string id)
    {
        foreach (var ws in _workspaces) ws.IsCurrent = ws.Id == id;
    }

    private void HandleCreate()
    {
        if (string.IsNullOrWhiteSpace(_newWorkspaceName)) return;
        var initials = string.Concat(_newWorkspaceName.Split(' ').Where(w => w.Length > 0).Select(w => w[0])).ToUpper();
        if (initials.Length > 2) initials = initials[..2];
        if (string.IsNullOrEmpty(initials)) initials = ""WS"";
        _workspaces.Add(new Workspace
        {
            Id = (_workspaces.Count + 4).ToString(),
            Name = _newWorkspaceName,
            Initial = initials,
            Role = ""Owner"",
            MemberCount = 1,
            IsCurrent = false,
        });
        _createDialogOpen = false;
        _newWorkspaceName = """";
    }
}";
