                                <SelectItemCn Value=""25"">$25</SelectItemCn>
                                <SelectItemCn Value=""50"">$50</SelectItemCn>
                                <SelectItemCn Value=""100"">$100</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                    <div class=""space-y-2"">
                        <LabelCn>Reload amount</LabelCn>
                        <SelectCn Value=""@_autoReloadAmount"" ValueChanged=""@((string v) => _autoReloadAmount = v)"">
                            <SelectTriggerCn>
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value=""25"">$25</SelectItemCn>
