@code {
    private record PasswordRequirement(string Label, bool Met);
    private record StrengthInfo(string Text, string Color);

    private string _currentPassword = """";
    private string _newPassword = """";
    private string _confirmPassword = """";
    private bool _showCurrent;
    private bool _showNew;
    private bool _showConfirm;
    private string? _error;
    private bool _success;
    private bool _isLoading;

    private bool PasswordsMatch => !string.IsNullOrEmpty(_newPassword) && _newPassword == _confirmPassword;
    private bool CanSubmit => !string.IsNullOrEmpty(_currentPassword) && GetPasswordRequirements(_newPassword).All(r => r.Met) && PasswordsMatch;

    private static int GetPasswordStrength(string password)
    {
        int strength = 0;
        if (password.Length >= 8) strength += 25;
        if (password.Length >= 12) strength += 25;
        if (password.Any(char.IsLower) && password.Any(char.IsUpper)) strength += 20;
        if (password.Any(char.IsDigit)) strength += 15;
        if (password.Any(c => !char.IsLetterOrDigit(c))) strength += 15;
        return Math.Min(strength, 100);
    }

    private static StrengthInfo GetStrengthLabel(int strength) => strength switch
    {
        < 40 => new(""Weak"", ""text-red-600""),
        < 60 => new(""Fair"", ""text-orange-600""),
        < 80 => new(""Good"", ""text-yellow-600""),
        _ => new(""Strong"", ""text-green-600"")
    };

    private static PasswordRequirement[] GetPasswordRequirements(string password) =>
    [
        new(""At least 8 characters"", password.Length >= 8),
        new(""Contains uppercase letter"", password.Any(char.IsUpper)),
        new(""Contains lowercase letter"", password.Any(char.IsLower)),
        new(""Contains number"", password.Any(char.IsDigit)),
        new(""Contains special character"", password.Any(c => !char.IsLetterOrDigit(c))),
    ];

    private async Task HandleSubmit()
    {
        _error = null;
        if (!CanSubmit)
        {
            _error = ""Please fill all fields correctly"";
            return;
        }
        _isLoading = true;
        StateHasChanged();
        await Task.Delay(1500);
        _isLoading = false;
        _success = true;
        _currentPassword = """";
        _newPassword = """";
        _confirmPassword = """";
    }
}";
