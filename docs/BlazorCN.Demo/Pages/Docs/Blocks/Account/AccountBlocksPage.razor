                                    <p class=""@Cn.Merge(""text-xs font-semibold tabular-nums"", tx.Amount > 0 ? ""text-emerald-600"" : ""text-red-600"")"">
                                        @(tx.Amount > 0 ? ""+"" : """")$@Math.Abs(tx.Amount).ToString(""F2"")
                                    </p>
                                    <p class=""text-xs tabular-nums text-muted-foreground"">Balance: $@tx.Balance.ToString(""F2"")</p>
                                </div>
                            </div>
                        }
                    </div>
                </TabsContentCn>

                <TabsContentCn Value=""giftcards"">
                    <div class=""space-y-3"">
                        @foreach (var card in _giftCards)
