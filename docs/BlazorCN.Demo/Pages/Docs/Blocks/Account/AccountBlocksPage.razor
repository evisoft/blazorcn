    private string? _copiedId;

    private List<SessionRecord> FilteredSessions
    {
        get
        {
            IEnumerable<SessionRecord> result = _statusFilter == ""all""
                ? _data
                : _data.Where(s => s.Status == _statusFilter);

            return _sortKey switch
            {
                ""started"" => _sortDirection == ""asc""
                    ? result.OrderBy(s => s.Started).ToList()
                    : result.OrderByDescending(s => s.Started).ToList(),
                ""duration"" => _sortDirection == ""asc""
                    ? result.OrderBy(s => s.DurationMinutes ?? int.MaxValue).ToList()
                    : result.OrderByDescending(s => s.DurationMinutes ?? int.MaxValue).ToList(),
                ""status"" => _sortDirection == ""asc""
                    ? result.OrderBy(s => GetStatusOrder(s.Status)).ToList()
                    : result.OrderByDescending(s => GetStatusOrder(s.Status)).ToList(),
                _ => result.ToList(),
            };
        }
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredSessions.Count / _pageSize));

    private List<SessionRecord> PaginatedSessions =>
        FilteredSessions.Skip((_currentPage - 1) * _pageSize).Take(_pageSize).ToList();

    private void HandleFilterChange(string filter)
    {
        _statusFilter = filter;
        _currentPage = 1;
    }

    private void HandleSort(string key)
    {
        if (_sortKey == key)
            _sortDirection = _sortDirection == ""asc"" ? ""desc"" : ""asc"";
        else
        {
            _sortKey = key;
            _sortDirection = ""desc"";
        }
        _currentPage = 1;
    }

    private void HandlePageSizeChange(string? value)
    {
        _pageSize = int.Parse(value ?? ""5"");
        _currentPage = 1;
    }

    private async Task HandleCopyToken(string token, string id)
    {
        _copiedId = id;
        StateHasChanged();
        await Task.Delay(2000);
        _copiedId = null;
    }

    private static int GetStatusCount(string filter) =>
        filter == ""all"" ? _data.Length : _data.Count(s => s.Status == filter);

    private static string GetFilterLabel(string filter) =>
        filter == ""all"" ? ""All"" : char.ToUpper(filter[0]) + filter[1..];

    private static int GetStatusOrder(string status) => status switch
    {
        ""active"" => 0,
        ""expired"" => 1,
        ""revoked"" => 2,
        _ => 3,
    };

    private static string GetStatusLabel(string status) => status switch
    {
        ""active"" => ""Active"",
        ""expired"" => ""Expired"",
        ""revoked"" => ""Revoked"",
        _ => status,
    };

    private static string GetStatusDotClass(string status) => status switch
    {
        ""active"" => ""bg-emerald-500"",
        ""expired"" => ""bg-muted-foreground/40"",
        ""revoked"" => ""bg-red-500"",
        _ => ""bg-muted-foreground/40"",
    };

    private static string GetStatusBadgeBg(string status) => status switch
    {
        ""active"" => ""bg-emerald-500/10 text-emerald-700"",
        ""expired"" => ""bg-muted/80 text-muted-foreground"",
        ""revoked"" => ""bg-red-500/10 text-red-700"",
        _ => ""bg-muted/80 text-muted-foreground"",
    };

    private static string GetDeviceIconName(string device) => device switch
    {
        ""desktop"" => ""monitor"",
        ""mobile"" => ""smartphone"",
        ""tablet"" => ""tablet"",
        ""cli"" => ""laptop"",
        _ => ""monitor"",
    };

    private static string FormatDuration(int? minutes) => minutes switch
    {
        null => ""—"",
        < 60 => $""{minutes}m"",
        _ => $""{minutes / 60}h {minutes % 60}m"",
    };

    private string GetSortIconName(string column) =>
        _sortKey != column ? ""arrow-up-down"" : _sortDirection == ""asc"" ? ""arrow-up"" : ""arrow-down"";

    private string GetSortIconClass(string column) =>
        _sortKey != column ? ""ml-1 h-3 w-3 text-muted-foreground/50"" : ""ml-1 h-3 w-3"";
