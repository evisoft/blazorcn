@code {
    private class Passkey
    {
        public string Id { get; set; } = """";
        public string Name { get; set; } = """";
        public string Type { get; set; } = """";
        public string Device { get; set; } = """";
        public string CreatedAt { get; set; } = """";
        public string LastUsed { get; set; } = """";
        public bool IsDefault { get; set; }
        public bool IsSynced { get; set; }
    }

    private Passkey? _selectedPasskey;
    private bool _showAddDialog;
    private bool _showRenameDialog;
    private bool _showDeleteDialog;
    private string _newPasskeyName = """";
    private bool _passkeyAsDefault = true;

    private List<Passkey> _passkeys =
    [
        new() { Id = ""1"", Name = ""MacBook Pro Touch ID"", Type = ""platform"", Device = ""macOS"", CreatedAt = ""Jun 15, 2024"", LastUsed = ""Just now"", IsDefault = true, IsSynced = true },
        new() { Id = ""2"", Name = ""iPhone Face ID"", Type = ""platform"", Device = ""iOS"", CreatedAt = ""Jun 15, 2024"", LastUsed = ""2 days ago"", IsDefault = false, IsSynced = true },
        new() { Id = ""3"", Name = ""YubiKey 5 NFC"", Type = ""security-key"", Device = ""Hardware Key"", CreatedAt = ""Aug 20, 2024"", LastUsed = ""2 weeks ago"", IsDefault = false, IsSynced = false },
    ];

    private void SetAsDefault(string id) { foreach (var p in _passkeys) p.IsDefault = p.Id == id; }

    private void HandleRegisterPasskey()
    {
        var newPasskey = new Passkey
        {
            Id = $""pk_{_passkeys.Count + 1}"",
            Name = string.IsNullOrWhiteSpace(_newPasskeyName) ? ""New Passkey"" : _newPasskeyName,
            Type = ""platform"",
            Device = ""Current Device"",
            CreatedAt = ""Today"",
            LastUsed = ""Just now"",
            IsDefault = false,
            IsSynced = false,
        };
        if (_passkeyAsDefault) { foreach (var p in _passkeys) p.IsDefault = false; newPasskey.IsDefault = true; }
        _passkeys.Add(newPasskey);
        _showAddDialog = false;
        _newPasskeyName = """";
        _passkeyAsDefault = true;
    }

    private void HandleRename()
    {
        if (_selectedPasskey != null && !string.IsNullOrWhiteSpace(_newPasskeyName))
        {
            _selectedPasskey.Name = _newPasskeyName.Trim();
            _showRenameDialog = false;
            _selectedPasskey = null;
            _newPasskeyName = """";
        }
    }

    private void HandleDelete()
    {
        if (_selectedPasskey != null)
        {
            _passkeys.RemoveAll(p => p.Id == _selectedPasskey.Id);
            _showDeleteDialog = false;
            _selectedPasskey = null;
        }
    }
}";
