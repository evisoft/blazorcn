@* ============================================================
   Block: account-credits
   Title: Account Credits
   Description: Account credits and gift cards dashboard with balance management, gift card redemption, credit history, and transfer options
   Dependencies: BadgeCn, ButtonCn, DialogCn, InputCn, LabelCn, SwitchCn, TabsCn
   Source: original/blocks/account/account-credits.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex-1">
                    <h2 class="text-sm font-medium">Credits &amp; Gift Cards</h2>
                    <p class="text-xs text-muted-foreground">Manage your store credit and gift card balance</p>
                </div>
                <div class="text-right">
                    <p class="text-2xl font-semibold tabular-nums">$127.50</p>
                    <p class="text-xs text-muted-foreground">Available balance</p>
                </div>
            </div>
        </div>

        <div class="flex items-start gap-3 border-b bg-muted/50 px-4 py-3">
            <LucideAlertTriangleCn Class="mt-0.5 size-4 shrink-0 text-amber-600" Size="16" />
            <div class="flex-1">
                <p class="text-xs font-medium text-amber-900">$25.00 expiring soon</p>
                <p class="mt-0.5 text-xs text-amber-700">Use your promotional credits before Mar 31, 2025</p>
            </div>
            <ButtonCn Class="shrink-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">Shop Now</ButtonCn>
        </div>

        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-3 gap-3">
                <DialogCn @bind-Open="_redeemOpen">
                    <button type="button" class="flex items-center gap-3 rounded-md border p-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => _redeemOpen = true)">
                        <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                        <div>
                            <p class="text-xs font-medium">Redeem Gift Card</p>
                            <p class="text-xs text-muted-foreground">Add to balance</p>
                        </div>
                    </button>
                    <DialogContentCn Class="w-full max-w-[450px]">
                        <DialogHeaderCn>
                            <DialogTitleCn>Redeem Gift Card</DialogTitleCn>
                            <DialogDescriptionCn>Enter your gift card code to add it to your account</DialogDescriptionCn>
                        </DialogHeaderCn>
                        <div class="py-4">
                            <div class="space-y-2">
                                <LabelCn For="giftCode">Gift Card Code</LabelCn>
                                <InputCn Class="font-mono" id="giftCode" placeholder="XXXX-XXXX-XXXX-XXXX" @bind-Value="_giftCardCode" />
                            </div>
                        </div>
                        <DialogFooterCn>
                            <ButtonCn Variant="ButtonVariant.Outline" OnClick="@(() => _redeemOpen = false)">Cancel</ButtonCn>
                            <ButtonCn Disabled="@(_giftCardCode.Length < 10)" OnClick="@(() => { _redeemOpen = false; _giftCardCode = ""; })">
                                <LucideCheckCn Class="mr-2 size-4" Size="16" />
                                Redeem
                            </ButtonCn>
                        </DialogFooterCn>
                    </DialogContentCn>
                </DialogCn>

                <DialogCn @bind-Open="_transferOpen">
                    <button type="button" class="flex items-center gap-3 rounded-md border p-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => _transferOpen = true)">
                        <span class="size-1.5 shrink-0 rounded-full bg-blue-500"></span>
                        <div>
                            <p class="text-xs font-medium">Transfer Credit</p>
                            <p class="text-xs text-muted-foreground">Send to user</p>
                        </div>
                    </button>
                    <DialogContentCn Class="w-full max-w-[450px]">
                        <DialogHeaderCn>
                            <DialogTitleCn>Transfer Credit</DialogTitleCn>
                            <DialogDescriptionCn>Send store credit to another account</DialogDescriptionCn>
                        </DialogHeaderCn>
                        <div class="space-y-4 py-4">
                            <div class="space-y-2">
                                <LabelCn For="recipientEmail">Recipient Email</LabelCn>
                                <InputCn id="recipientEmail" placeholder="friend@example.com" type="email" />
                            </div>
                            <div class="space-y-2">
                                <LabelCn For="transferAmount">Amount</LabelCn>
                                <div class="relative">
                                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground">$</span>
                                    <InputCn Class="pl-7" id="transferAmount" placeholder="0.00" type="number" />
                                </div>
                            </div>
                        </div>
                        <DialogFooterCn>
                            <ButtonCn Variant="ButtonVariant.Outline" OnClick="@(() => _transferOpen = false)">Cancel</ButtonCn>
                            <ButtonCn>
                                <LucideSendCn Class="mr-2 size-4" Size="16" />
                                Send Credit
                            </ButtonCn>
                        </DialogFooterCn>
                    </DialogContentCn>
                </DialogCn>

                <button type="button" class="flex items-center gap-3 rounded-md border p-3 text-left transition-colors hover:bg-muted/50">
                    <span class="size-1.5 shrink-0 rounded-full bg-amber-500"></span>
                    <div>
                        <p class="text-xs font-medium">Buy Gift Card</p>
                        <p class="text-xs text-muted-foreground">For someone else</p>
                    </div>
                </button>
            </div>
        </div>

        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-xs font-medium">Auto-apply credits at checkout</p>
                <p class="text-xs text-muted-foreground">Automatically use your balance when placing orders</p>
            </div>
            <SwitchCn Checked="@_autoApply" CheckedChanged="@((bool v) => _autoApply = v)" />
        </div>

        <div class="px-4 py-3">
            <TabsCn DefaultValue="history">
                <TabsListCn Class="mb-4">
                    <TabsTriggerCn Value="history">Transaction History</TabsTriggerCn>
                    <TabsTriggerCn Value="giftcards">Gift Cards</TabsTriggerCn>
                </TabsListCn>

                <TabsContentCn Value="history">
                    <div class="space-y-3">
                        @foreach (var tx in _transactions)
                        {
                            var dot = tx.Type switch { "credit" => "bg-emerald-500", "debit" => "bg-blue-500", "expired" => "bg-red-500", _ => "bg-muted-foreground" };
                            <div class="flex items-center gap-3 rounded-md border px-4 py-3">
                                <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", dot)"></span>
                                <div class="min-w-0 flex-1">
                                    <p class="text-xs font-medium">@tx.Source</p>
                                    <p class="text-xs text-muted-foreground">@tx.Date</p>
                                </div>
                                <div class="shrink-0 text-right">
                                    <p class="@Cn.Merge("text-xs font-semibold tabular-nums", tx.Amount > 0 ? "text-emerald-600" : "text-red-600")">
                                        @(tx.Amount > 0 ? "+" : "")$@Math.Abs(tx.Amount).ToString("F2")
                                    </p>
                                    <p class="text-xs tabular-nums text-muted-foreground">Balance: $@tx.Balance.ToString("F2")</p>
                                </div>
                            </div>
                        }
                    </div>
                </TabsContentCn>

                <TabsContentCn Value="giftcards">
                    <div class="space-y-3">
                        @foreach (var card in _giftCards)
                        {
                            <div class="flex items-center gap-3 rounded-md border px-4 py-3">
                                <span class="size-1.5 shrink-0 rounded-full bg-purple-500"></span>
                                <div class="min-w-0 flex-1">
                                    <div class="mb-1 flex items-center gap-2">
                                        <p class="font-mono text-xs font-medium">@card.Code</p>
                                    </div>
                                    <div class="flex items-center gap-3 text-xs text-muted-foreground">
                                        <span>Added @card.AddedAt</span>
                                        @if (card.ExpiresAt != null)
                                        {
                                            <span class="text-muted-foreground/40">&bull;</span>
                                            <span>Expires @card.ExpiresAt</span>
                                        }
                                    </div>
                                </div>
                                <div class="shrink-0 text-right">
                                    <p class="text-sm font-semibold tabular-nums">$@card.RemainingAmount.ToString("F2")</p>
                                    <p class="text-xs tabular-nums text-muted-foreground">of $@card.OriginalAmount.ToString("F2")</p>
                                </div>
                            </div>
                        }
                    </div>
                </TabsContentCn>
            </TabsCn>
        </div>
    </div>
</section>

@code {
    private record CreditTransaction(string Id, string Type, string Source, decimal Amount, decimal Balance, string Date);
    private record GiftCard(string Id, string Code, decimal OriginalAmount, decimal RemainingAmount, string AddedAt, string? ExpiresAt);

    private bool _redeemOpen;
    private bool _transferOpen;
    private string _giftCardCode = "";
    private bool _autoApply = true;

    private static readonly CreditTransaction[] _transactions =
    [
        new("1", "debit", "Order #ORD-1847", -45.00m, 127.50m, "Dec 5, 2024"),
        new("2", "credit", "Gift Card Redeemed", 100.00m, 172.50m, "Dec 1, 2024"),
        new("3", "credit", "Referral Reward", 15.00m, 72.50m, "Nov 28, 2024"),
    ];

    private static readonly GiftCard[] _giftCards =
    [
        new("1", "GIFT-XXXX-XXXX-4821", 50.00m, 32.50m, "Nov 15, 2024", "Nov 15, 2026"),
        new("2", "GIFT-XXXX-XXXX-9156", 100.00m, 100.00m, "Dec 1, 2024", "Dec 1, 2026"),
    ];
}
