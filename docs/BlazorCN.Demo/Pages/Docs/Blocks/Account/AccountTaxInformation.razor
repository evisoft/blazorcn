@* ============================================================
   Block: account-tax-information
   Title: AccountTaxInformation
   Description: A tax information management form for React and Next.js with tax ID entry, W-9/W-8BEN form tracking, verification status, tax exemption certificate upload, and country-aware validation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/account/account-tax-information.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Tax Information</h2>
                    <p class="text-xs text-muted-foreground">
                        Tax ID, forms, and exemption status for invoicing
                    </p>
                </div>
                <div class="flex items-center gap-1.5">
                    @if (_verificationStatus == "verified")
                    {
                        <LucideCircleCheckBigCn Size="14" Class="h-3.5 w-3.5 text-emerald-600" />
                    }
                    else if (_verificationStatus == "pending")
                    {
                        <LucideClockCn Size="14" Class="h-3.5 w-3.5 text-amber-600" />
                    }
                    else
                    {
                        <LucideCircleXCn Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                    }
                    <span class="@($"text-xs font-medium {VerificationColor}")">
                        @VerificationLabel
                    </span>
                </div>
            </div>
        </div>

        @* Tax ID Section *@
        <div class="border-b px-4 py-3 space-y-3">
            <span class="text-xs font-medium text-muted-foreground">TAX IDENTIFICATION</span>

            <div class="space-y-1.5">
                <span class="text-xs text-muted-foreground">Business name</span>
                <InputCn aria-label="Legal business name" @bind-Value="BusinessName" Placeholder="Legal business name" />
            </div>

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <div class="space-y-1.5">
                    <span class="text-xs text-muted-foreground">Country</span>
                    <SelectCn Value="@_selectedCountry" ValueChanged="@HandleCountryChange">
                        <SelectTriggerCn aria-label="Country" Class="text-sm">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var c in _countries)
                            {
                                <SelectItemCn Value="@c.Code">@c.Label</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="space-y-1.5">
                    <span class="text-xs text-muted-foreground">Tax ID type</span>
                    <SelectCn Value="@_selectedTaxIdType" ValueChanged="@HandleTaxIdTypeChange">
                        <SelectTriggerCn aria-label="Tax ID type" Class="text-sm">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @for (int i = 0; i < Country.TaxIdTypes.Length; i++)
                            {
                                var idx = i;
                                <SelectItemCn Value="@idx.ToString()">@Country.TaxIdTypes[idx].Label</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Tax ID number</span>
                    <span class="font-mono text-[10px] text-muted-foreground">
                        Format: @CurrentTaxIdType.Mask
                    </span>
                </div>
                <InputCn aria-label="Tax ID number" @bind-Value="TaxIdValue" Placeholder="@CurrentTaxIdType.Placeholder" Class="font-mono" />
            </div>
        </div>

        @* Tax Forms Section *@
        <div class="border-b px-4 py-3 space-y-3">
            <span class="text-xs font-medium text-muted-foreground">TAX FORMS</span>
            <div class="space-y-2">
                @foreach (var form in Country.Forms)
                {
                    var statusLabel = GetFormStatusLabel(form.Status);
                    var dotClass = GetFormStatusDotClass(form.Status);
                    <div class="flex items-center justify-between rounded-md bg-muted/30 px-3 py-2.5">
                        <div class="flex items-center gap-3">
                            <LucideFileTextCn Size="16" Class="h-4 w-4 text-muted-foreground" />
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@form.Name</span>
                                    <div class="flex items-center gap-1.5">
                                        <span class="@($"size-1.5 rounded-full {dotClass}")"></span>
                                        <span class="text-[10px] text-muted-foreground">
                                            @statusLabel
                                        </span>
                                    </div>
                                </div>
                                <p class="text-xs text-muted-foreground">@form.Description</p>
                                @if (form.SubmittedAt != null)
                                {
                                    <p class="text-[10px] text-muted-foreground">
                                        Submitted @form.SubmittedAt
                                    </p>
                                }
                            </div>
                        </div>
                        @if (form.Status == "submitted")
                        {
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                                <LucideDownloadCn Size="12" Class="h-3 w-3" />
                                Download
                            </ButtonCn>
                        }
                        else
                        {
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                                <LucideUploadCn Size="12" Class="h-3 w-3" />
                                Submit
                            </ButtonCn>
                        }
                    </div>
                }
            </div>
        </div>

        @* Tax Exemption Section *@
        <div class="border-b px-4 py-3 space-y-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-sm font-medium">Tax exempt</span>
                    <p class="text-xs text-muted-foreground">
                        Mark this account as tax-exempt and upload your certificate
                    </p>
                </div>
                <SwitchCn aria-label="Tax exempt" Checked="@_taxExempt" CheckedChanged="@OnTaxExemptChanged" />
            </div>

            @if (_taxExempt)
            {
                <div class="overflow-hidden">
                    @if (_uploadedFile != null)
                    {
                        <div class="flex items-center justify-between rounded-md border px-3 py-2.5">
                            <div class="flex items-center gap-2.5">
                                <LucideFileTextCn Size="16" Class="h-4 w-4 text-muted-foreground" />
                                <div>
                                    <span class="text-sm font-medium">@_uploadedFile</span>
                                    <p class="text-[10px] text-muted-foreground">
                                        Uploaded -- Pending review
                                    </p>
                                </div>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="h-7 w-7" @onclick="@(() => { _uploadedFile = null; _isDirty = true; })" aria-label="Close">
                                <LucideXCn Size="14" Class="h-3.5 w-3.5" />
                            </ButtonCn>
                        </div>
                    }
                    else
                    {
                        <div class="rounded-md border-2 border-dashed border-muted-foreground/20 p-4 text-center">
                            <LucideUploadCn Size="20" Class="mx-auto h-5 w-5 text-muted-foreground/40" />
                            <p class="mt-1.5 text-xs font-medium">Upload exemption certificate</p>
                            <p class="text-[10px] text-muted-foreground">PDF, PNG, or JPG up to 10MB</p>
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-2 h-7 text-xs" @onclick="@(() => { _uploadedFile = "tax-exempt-cert-2026.pdf"; _isDirty = true; })">
                                Choose file
                            </ButtonCn>
                        </div>
                    }
                </div>
            }
        </div>

        @* Summary Footer *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                <div class="flex items-center gap-1.5">
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px]">
                        @Country.Label
                    </BadgeCn>
                </div>
                @if (_taxExempt)
                {
                    <span class="text-[10px] text-amber-600">Tax exempt</span>
                }
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Disabled="@(!_isDirty)">
                    Cancel
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Disabled="@(_isSaving || !_isDirty)" @onclick="HandleSave">
                    @if (_isSaving)
                    {
                        <LucideLoaderCircleCn Size="14" Class="mr-1.5 h-3.5 w-3.5 animate-spin" />
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save changes</span>
                    }
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record TaxIdTypeConfig(string Label, string Placeholder, string Mask);
    private record TaxFormConfig(string Name, string Status, string? SubmittedAt, string Description);
    private record CountryConfig(string Label, string Code, TaxIdTypeConfig[] TaxIdTypes, TaxFormConfig[] Forms);

    private static readonly CountryConfig[] _countries =
    [
        new("United States", "us",
            [
                new("EIN (Employer Identification Number)", "12-3456789", "XX-XXXXXXX"),
                new("SSN (Social Security Number)", "***-**-6789", "XXX-XX-XXXX"),
                new("ITIN (Individual Taxpayer ID)", "9XX-XX-XXXX", "9XX-XX-XXXX"),
            ],
            [
                new("W-9", "submitted", "Jan 15, 2026", "Request for Taxpayer Identification Number and Certification"),
                new("1099-K", "not_submitted", null, "Payment Card and Third Party Network Transactions"),
            ]),
        new("United Kingdom", "gb",
            [
                new("VAT Number", "GB123456789", "GBXXXXXXXXX"),
                new("UTR (Unique Taxpayer Reference)", "1234567890", "XXXXXXXXXX"),
            ],
            [
                new("W-8BEN", "pending", "Mar 2, 2026", "Certificate of Foreign Status of Beneficial Owner"),
            ]),
        new("Germany", "de",
            [
                new("VAT Number (USt-IdNr)", "DE123456789", "DEXXXXXXXXX"),
                new("Tax Number (Steuernummer)", "12/345/67890", "XX/XXX/XXXXX"),
            ],
            [
                new("W-8BEN-E", "not_submitted", null, "Certificate of Status of Beneficial Owner (Entities)"),
            ]),
        new("Canada", "ca",
            [
                new("BN (Business Number)", "123456789RC0001", "XXXXXXXXXRCXXXX"),
                new("GST/HST Number", "123456789RT0001", "XXXXXXXXXRTXXXX"),
            ],
            [
                new("W-8BEN", "not_submitted", null, "Certificate of Foreign Status of Beneficial Owner"),
            ]),
        new("Australia", "au",
            [
                new("ABN (Australian Business Number)", "51 824 753 556", "XX XXX XXX XXX"),
                new("TFN (Tax File Number)", "123 456 789", "XXX XXX XXX"),
            ],
            [
                new("W-8BEN", "not_submitted", null, "Certificate of Foreign Status of Beneficial Owner"),
            ]),
    ];

    private string _selectedCountry = "us";
    private string _selectedTaxIdType = "0";
    private string _taxIdValueBacking = "12-3456789";
    private string _businessNameBacking = "Acme Corporation";
    private bool _taxExempt = false;
    private string? _uploadedFile = null;
    private bool _isSaving = false;
    private bool _isDirty = false;
    private const string _verificationStatus = "verified";

    private string BusinessName
    {
        get => _businessNameBacking;
        set { _businessNameBacking = value; _isDirty = true; }
    }

    private string TaxIdValue
    {
        get => _taxIdValueBacking;
        set { _taxIdValueBacking = value; _isDirty = true; }
    }

    private CountryConfig Country =>
        Array.Find(_countries, c => c.Code == _selectedCountry) ?? _countries[0];

    private TaxIdTypeConfig CurrentTaxIdType =>
        int.TryParse(_selectedTaxIdType, out var i) && i < Country.TaxIdTypes.Length
            ? Country.TaxIdTypes[i]
            : Country.TaxIdTypes[0];

    private string VerificationColor => _verificationStatus switch
    {
        "verified" => "text-emerald-600",
        "pending" => "text-amber-600",
        _ => "text-muted-foreground",
    };

    private string VerificationLabel => _verificationStatus switch
    {
        "verified" => "Verified",
        "pending" => "Pending review",
        _ => "Not submitted",
    };

    private static string GetFormStatusLabel(string status) => status switch
    {
        "submitted" => "Submitted",
        "pending" => "Pending review",
        _ => "Not submitted",
    };

    private static string GetFormStatusDotClass(string status) => status switch
    {
        "submitted" => "bg-emerald-500",
        "pending" => "bg-amber-500",
        _ => "bg-muted-foreground/40",
    };

    private void HandleCountryChange(string? value)
    {
        _selectedCountry = value ?? "us";
        _selectedTaxIdType = "0";
        _taxIdValueBacking = "";
        _isDirty = true;
    }

    private void HandleTaxIdTypeChange(string? value)
    {
        _selectedTaxIdType = value ?? "0";
        _taxIdValueBacking = "";
        _isDirty = true;
    }

    private void OnTaxExemptChanged(bool value)
    {
        _taxExempt = value;
        if (!value) _uploadedFile = null;
        _isDirty = true;
    }

    private async Task HandleSave()
    {
        _isSaving = true;
        await Task.Delay(1500);
        _isSaving = false;
        _isDirty = false;
    }
}
