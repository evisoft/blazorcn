@* ============================================================
   Block: account-email-preferences
   Title: Account Email Preferences
   Description: Email address management with multiple email support, primary email selection, verification status badges, and add/remove email functionality
   Dependencies: AlertDialogCn, BadgeCn, ButtonCn, InputCn
   Source: original/blocks/account/account-email-preferences.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <LucideMailCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                <div class="flex-1">
                    <h2 class="text-sm font-medium">Email Addresses</h2>
                    <p class="text-xs text-muted-foreground">Manage your email addresses for login and notifications</p>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary">@_emails.Count(e => e.Verified) of @_emails.Count verified</BadgeCn>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">ADD NEW EMAIL</span>
            <div class="flex items-center gap-2">
                <InputCn aria-label="Add new email" Class="flex-1 border-0 bg-transparent shadow-none focus-visible:ring-0" placeholder="name@example.com" type="email" @bind-Value="_newEmail" />
                <ButtonCn Disabled="@string.IsNullOrWhiteSpace(_newEmail)" OnClick="HandleAddEmail" Size="ButtonSize.Sm">
                    <LucideSendCn Class="mr-1.5 h-3.5 w-3.5" Size="14" />
                    Add
                </ButtonCn>
            </div>
            <p class="mt-2 text-xs text-muted-foreground">A verification email will be sent to confirm ownership</p>
        </div>

        @foreach (var email in _emails)
        {
            <div class="@Cn.Merge("border-b px-4 py-3 last:border-0", email.Primary ? "bg-muted/50" : "")">
                <div class="flex items-center gap-3">
                    <LucideMailCn Class="@Cn.Merge("h-4 w-4 shrink-0", email.Verified ? "text-muted-foreground" : "text-amber-500")" Size="16" />
                    <div class="min-w-0 flex-1">
                        <div class="mb-0.5 flex items-center gap-2">
                            <p class="break-all text-sm font-medium">@email.Email</p>
                            @if (email.Primary)
                            {
                                <BadgeCn Class="h-4 border-0 bg-primary/10 px-1.5 py-0 text-[10px] text-primary">Primary</BadgeCn>
                            }
                            @if (email.Verified)
                            {
                                <BadgeCn Class="h-4 border-0 bg-emerald-500/10 px-1.5 py-0 text-[10px] text-emerald-700">Verified</BadgeCn>
                            }
                            else
                            {
                                <BadgeCn Class="h-4 border-0 bg-amber-500/10 px-1.5 py-0 text-[10px] text-amber-700">Pending</BadgeCn>
                            }
                        </div>
                        <p class="text-xs text-muted-foreground">Added @email.AddedAt</p>
                    </div>
                    <div class="flex shrink-0 items-center gap-2">
                        @if (!email.Primary && email.Verified)
                        {
                            <ButtonCn OnClick="@(() => HandleSetPrimary(email.Id))" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                                <LucideStarCn Class="mr-1.5 h-3.5 w-3.5" Size="14" />
                                Set Primary
                            </ButtonCn>
                        }
                        @if (!email.Primary)
                        {
                            <ButtonCn Class="h-8 w-8" OnClick="@(() => { _selectedEmailId = email.Id; _removeDialogOpen = true; })"
                                      Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="Delete">
                                <LucideTrash2Cn Class="h-4 w-4 text-muted-foreground" Size="16" />
                            </ButtonCn>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <AlertDialogCn @bind-Open="_removeDialogOpen">
        <AlertDialogContentCn>
            <AlertDialogHeaderCn>
                <AlertDialogTitleCn>Remove Email Address?</AlertDialogTitleCn>
                <AlertDialogDescriptionCn>This email address will be removed from your account. You won't be able to use it for login or receive notifications.</AlertDialogDescriptionCn>
            </AlertDialogHeaderCn>
            <AlertDialogFooterCn>
                <AlertDialogCancelCn>Cancel</AlertDialogCancelCn>
                <ButtonCn Class="min-w-[120px]" OnClick="HandleRemoveEmail" Variant="ButtonVariant.Destructive">Remove Email</ButtonCn>
            </AlertDialogFooterCn>
        </AlertDialogContentCn>
    </AlertDialogCn>
</section>

@code {
    private class EmailAddress
    {
        public string Id { get; set; } = "";
        public string Email { get; set; } = "";
        public bool Verified { get; set; }
        public bool Primary { get; set; }
        public string AddedAt { get; set; } = "";
    }

    private string _newEmail = "";
    private bool _removeDialogOpen;
    private string? _selectedEmailId;

    private List<EmailAddress> _emails =
    [
        new() { Id = "1", Email = "emma@example.com", Verified = true, Primary = true, AddedAt = "Jan 15, 2023" },
        new() { Id = "2", Email = "emma.roberts@work.com", Verified = true, Primary = false, AddedAt = "Mar 20, 2023" },
        new() { Id = "3", Email = "emma.r@personal.com", Verified = false, Primary = false, AddedAt = "Nov 10, 2023" },
    ];

    private void HandleAddEmail()
    {
        if (string.IsNullOrWhiteSpace(_newEmail) || _emails.Any(e => e.Email == _newEmail)) return;
        _emails.Add(new EmailAddress
        {
            Id = (_emails.Count + 1).ToString(),
            Email = _newEmail,
            Verified = false,
            Primary = false,
            AddedAt = "Today",
        });
        _newEmail = "";
    }

    private void HandleRemoveEmail()
    {
        if (_selectedEmailId != null)
        {
            _emails.RemoveAll(e => e.Id == _selectedEmailId);
            _removeDialogOpen = false;
            _selectedEmailId = null;
        }
    }

    private void HandleSetPrimary(string emailId)
    {
        foreach (var email in _emails) email.Primary = email.Id == emailId;
    }
}
