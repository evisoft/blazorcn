@* ============================================================
   Block: account-feedback-history
   Title: Account Feedback History
   Description: Feedback submission history with status tracking, category badges, and new feedback submission
   Long Description: Feedback submission history
   Dependencies: BadgeCn, ButtonCn, LucideMessageCircleCn, LucidePlusCn
   Source: original/blocks/account/account-feedback-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <LucideMessageCircleCn Size="20" Class="text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Feedback History</h2>
                        <p class="text-xs text-muted-foreground">
                            Track the status of your submissions
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Class="gap-2">
                    <LucidePlusCn Size="16" />
                    Submit Feedback
                </ButtonCn>
            </div>
        </div>

        <div class="divide-y">
            @foreach (var item in _items)
            {
                var statusDot = GetStatusDot(item.Status);
                var statusLabel = GetStatusLabel(item.Status);
                var categoryLabel = GetCategoryLabel(item.Category);

                <div class="flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                    <span class="@($"mt-1.5 size-1.5 shrink-0 rounded-full @statusDot")"></span>
                    <div class="min-w-0 flex-1">
                        <div class="mb-1 flex items-center gap-2 flex-wrap">
                            <span class="text-sm font-medium">@item.Title</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px]">
                                @categoryLabel
                            </BadgeCn>
                        </div>
                        <div class="flex items-center gap-2 text-xs text-muted-foreground">
                            <span>@item.Submitted</span>
                            <span>&middot;</span>
                            <span>@statusLabel</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record FeedbackItem(string Id, string Title, string Category, string Status, string Submitted);

    private static string GetStatusDot(string status) => status switch
    {
        "under-review" => "bg-blue-500",
        "planned" => "bg-emerald-500",
        "closed" => "bg-muted-foreground",
        _ => "bg-muted-foreground",
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "under-review" => "Under Review",
        "planned" => "Planned",
        "closed" => "Closed",
        _ => status,
    };

    private static string GetCategoryLabel(string category) => category switch
    {
        "feature" => "Feature Request",
        "bug" => "Bug Report",
        "improvement" => "Improvement",
        _ => category,
    };

    private static readonly FeedbackItem[] _items =
    [
        new("1", "Add dark mode to the analytics dashboard", "feature", "under-review", "Mar 2, 2026"),
        new("2", "Keyboard shortcuts for bulk actions", "improvement", "planned", "Feb 18, 2026"),
        new("3", "CSV export truncates long text fields", "bug", "closed", "Jan 30, 2026"),
    ];
}
