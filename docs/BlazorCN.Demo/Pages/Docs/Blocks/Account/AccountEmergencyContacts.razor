@* ============================================================
   Block: account-emergency-contacts
   Title: Account Emergency Contacts
   Description: Recovery contacts for account lockout scenarios with verification status, add and remove controls
   Dependencies: ButtonCn, DialogCn, InputCn
   Source: original/blocks/account/account-emergency-contacts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <LucideUsersCn Class="h-5 w-5 text-muted-foreground" Size="20" />
                    <div>
                        <h2 class="text-sm font-medium">Emergency Contacts</h2>
                        <p class="text-xs text-muted-foreground">Trusted contacts for account recovery</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="divide-y">
            @foreach (var contact in _contacts)
            {
                <div class="px-4 py-3">
                    <div class="flex items-start gap-3">
                        <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", contact.Verified ? "bg-emerald-500" : "bg-amber-500")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@contact.Name</span>
                                <span class="text-xs text-muted-foreground">@contact.Relationship</span>
                                <span class="text-[10px] text-muted-foreground">@(contact.Verified ? "Verified" : "Unverified")</span>
                            </div>
                            <div class="mt-1 flex flex-wrap items-center gap-3 text-xs text-muted-foreground">
                                <span>@contact.Email</span>
                                <span class="text-muted-foreground/40">&bull;</span>
                                <span>@contact.Phone</span>
                            </div>
                        </div>
                        <div class="flex shrink-0 items-center gap-1">
                            @if (!contact.Verified)
                            {
                                <ButtonCn Class="h-7 gap-1 px-2 text-xs" Variant="ButtonVariant.Ghost">
                                    <LucideRotateCcwCn Class="size-3.5" Size="14" />
                                    Resend
                                </ButtonCn>
                            }
                            <ButtonCn Class="h-7 gap-1 px-2 text-xs" Variant="ButtonVariant.Ghost"
                                      OnClick="@(() => _contacts.RemoveAll(c => c.Id == contact.Id))">
                                <LucideTrash2Cn Class="size-3.5" Size="14" />
                                Remove
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <DialogCn @bind-Open="_dialogOpen">
                <ButtonCn Class="gap-2" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline"
                          OnClick="@(() => _dialogOpen = true)">
                    <LucidePlusCn Class="size-4" Size="16" />
                    Add Contact
                </ButtonCn>
                <DialogContentCn Class="w-[420px]">
                    <DialogHeaderCn>
                        <DialogTitleCn>Add Emergency Contact</DialogTitleCn>
                        <DialogDescriptionCn>This person will receive a verification request via email.</DialogDescriptionCn>
                    </DialogHeaderCn>
                    <div class="space-y-4 py-4">
                        <div class="space-y-2">
                            <span class="text-xs font-medium text-muted-foreground">Full Name</span>
                            <InputCn aria-label="Full Name" placeholder="e.g., Jane Smith" @bind-Value="_newName" />
                        </div>
                        <div class="space-y-2">
                            <span class="text-xs font-medium text-muted-foreground">Email</span>
                            <InputCn aria-label="Email" placeholder="e.g., jane@email.com" type="email" @bind-Value="_newEmail" />
                        </div>
                        <div class="space-y-2">
                            <span class="text-xs font-medium text-muted-foreground">Phone</span>
                            <InputCn aria-label="Phone" placeholder="e.g., +1 (555) 123-4567" type="tel" @bind-Value="_newPhone" />
                        </div>
                    </div>
                    <DialogFooterCn>
                        <ButtonCn Variant="ButtonVariant.Outline" OnClick="@(() => _dialogOpen = false)">Cancel</ButtonCn>
                        <ButtonCn Disabled="@(string.IsNullOrWhiteSpace(_newName) || string.IsNullOrWhiteSpace(_newEmail) || string.IsNullOrWhiteSpace(_newPhone))"
                                  OnClick="HandleAdd">Add Contact</ButtonCn>
                    </DialogFooterCn>
                </DialogContentCn>
            </DialogCn>
        </div>
    </div>
</section>

@code {
    private class EmergencyContact
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Relationship { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public bool Verified { get; set; }
    }

    private bool _dialogOpen;
    private string _newName = "";
    private string _newEmail = "";
    private string _newPhone = "";

    private List<EmergencyContact> _contacts =
    [
        new() { Id = "1", Name = "Sarah Chen", Relationship = "Spouse", Email = "sarah.chen@email.com", Phone = "+1 (415) 555-0132", Verified = true },
        new() { Id = "2", Name = "Marcus Rivera", Relationship = "Brother", Email = "m.rivera@email.com", Phone = "+1 (212) 555-0198", Verified = false },
    ];

    private void HandleAdd()
    {
        if (string.IsNullOrWhiteSpace(_newName) || string.IsNullOrWhiteSpace(_newEmail) || string.IsNullOrWhiteSpace(_newPhone)) return;
        _contacts.Add(new EmergencyContact
        {
            Id = (_contacts.Count + 1).ToString(),
            Name = _newName.Trim(),
            Relationship = "Other",
            Email = _newEmail.Trim(),
            Phone = _newPhone.Trim(),
            Verified = false,
        });
        _newName = "";
        _newEmail = "";
        _newPhone = "";
        _dialogOpen = false;
    }
}
