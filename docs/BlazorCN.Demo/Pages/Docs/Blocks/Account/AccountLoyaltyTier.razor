@* ============================================================
   Block: account-loyalty-tier
   Title: Account Loyalty Tier
   Description: Loyalty tier status with progress bar toward next level, tier benefits list, and recent points transaction history
   Dependencies: ProgressCn
   Source: original/blocks/account/account-loyalty-tier.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <LucideAwardCn Class="h-5 w-5 text-muted-foreground" Size="20" />
                    <div>
                        <h2 class="text-sm font-medium">Loyalty Tier</h2>
                        <p class="text-xs text-muted-foreground">Your membership status and benefits</p>
                    </div>
                </div>
                <div class="text-right">
                    <p class="text-2xl font-semibold tabular-nums">@CurrentPoints.ToString("N0")</p>
                    <p class="text-xs text-muted-foreground">points</p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideStarCn Class="h-4 w-4 text-amber-500" Size="16" />
                    <span class="text-sm font-medium">Gold</span>
                </div>
                <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <LucideTrendingUpCn Class="h-3 w-3" Size="12" />
                    <span>@((NextTierThreshold - CurrentPoints).ToString("N0")) pts to Platinum</span>
                </div>
            </div>
            <ProgressCn Class="h-1.5" Value="@_tierProgress" aria-label="Progress" />
            <div class="mt-1.5 flex items-center justify-between text-xs text-muted-foreground">
                <span class="tabular-nums">@CurrentPoints.ToString("N0")</span>
                <span class="tabular-nums">@NextTierThreshold.ToString("N0")</span>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">GOLD BENEFITS</span>
            <div class="mt-2 space-y-2">
                @foreach (var benefit in _benefits)
                {
                    <div class="flex items-center gap-2.5">
                        <LucideCheckCn Class="h-3.5 w-3.5 shrink-0 text-emerald-500" Size="14" />
                        <span class="text-sm">@benefit</span>
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">RECENT ACTIVITY</span>
            <div class="mt-2 overflow-hidden rounded-md border">
                @for (var i = 0; i < _transactions.Length; i++)
                {
                    var tx = _transactions[i];
                    <div class="@Cn.Merge("flex items-center gap-3 px-3 py-2.5", i < _transactions.Length - 1 ? "border-b" : "")">
                        <LucideGiftCn Class="h-3.5 w-3.5 shrink-0 text-muted-foreground" Size="14" />
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium">@tx.Description</p>
                            <p class="text-xs text-muted-foreground">@tx.Date</p>
                        </div>
                        <span class="@Cn.Merge("shrink-0 text-sm font-medium tabular-nums", tx.Points > 0 ? "text-emerald-600" : "text-red-500")">
                            @(tx.Points > 0 ? "+" : "")@tx.Points.ToString("N0")
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record PointTransaction(string Id, string Description, int Points, string Date);

    private const int CurrentPoints = 2400;
    private const int NextTierThreshold = 5000;
    private static readonly double _tierProgress = (double)CurrentPoints / NextTierThreshold * 100;

    private static readonly string[] _benefits =
    [
        "10% discount on all orders",
        "Priority customer support",
        "Early access to new features",
    ];

    private static readonly PointTransaction[] _transactions =
    [
        new("1", "Purchase - Order #2847", 340, "Mar 8, 2026"),
        new("2", "Referral bonus - Sarah K.", 500, "Feb 22, 2026"),
        new("3", "Redeemed - $10 coupon", -1000, "Feb 15, 2026"),
    ];
}
