@* ============================================================
   Block: account-export-connections
   Title: Account Export Connections
   Description: Export contacts and connections from the platform with format selection, progress tracking, and download history
   Long Description: Export contacts and connections
   Dependencies: ButtonCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, LucideDownloadCn, LucideFileDownCn, LucideLoaderCircleCn, LucideUsersCn
   Source: original/blocks/account/account-export-connections.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <LucideUsersCn Size="20" Class="text-muted-foreground" />
                <div>
                    <h2 class="text-sm font-medium">Export Connections</h2>
                    <p class="text-xs text-muted-foreground">Download your contacts in your preferred format</p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <span class="size-1.5 shrink-0 rounded-full bg-blue-500"></span>
                <div class="flex-1">
                    <span class="text-2xl font-semibold tabular-nums">142</span>
                    <span class="ml-1.5 text-sm text-muted-foreground">connections</span>
                </div>
                <span class="text-xs text-muted-foreground">Last export: Mar 10, 2026</span>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex-1">
                    <span class="text-xs font-medium text-muted-foreground">Format</span>
                    <SelectCn Value="@_format" ValueChanged='v => _format = v ?? "csv"'>
                        <SelectTriggerCn aria-label="Export format" Class="mt-1.5 h-9 w-full">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="csv">CSV (.csv)</SelectItemCn>
                            <SelectItemCn Value="json">JSON (.json)</SelectItemCn>
                            <SelectItemCn Value="vcard">vCard (.vcf)</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="shrink-0 self-end">
                    <ButtonCn Class="gap-2" Disabled="@_exporting" @onclick="HandleExport">
                        @if (_exporting)
                        {
                            <LucideLoaderCircleCn Size="16" Class="animate-spin" />
                            <span>Exporting...</span>
                        }
                        else
                        {
                            <LucideFileDownCn Size="16" />
                            <span>Export</span>
                        }
                    </ButtonCn>
                </div>
            </div>
        </div>

        <div class="px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">RECENT EXPORTS</span>
            <div class="mt-2 divide-y">
                @foreach (var record in _recentExports)
                {
                    <div class="flex items-center gap-3 py-2.5 first:pt-0 last:pb-0">
                        <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@record.Format</span>
                            <p class="text-xs text-muted-foreground">@record.Date &bull; @record.Size</p>
                        </div>
                        <ButtonCn Class="h-7 gap-1 px-2 text-xs" Variant="ButtonVariant.Ghost">
                            <LucideDownloadCn Size="14" />
                            Download
                        </ButtonCn>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ExportRecord(string Id, string Date, string Format, string Size);

    private string _format = "csv";
    private bool _exporting;

    private static readonly ExportRecord[] _recentExports =
    [
        new("1", "Mar 10, 2026", "CSV", "84 KB"),
        new("2", "Feb 14, 2026", "JSON", "126 KB"),
        new("3", "Jan 5, 2026", "vCard", "210 KB"),
    ];

    private async Task HandleExport()
    {
        _exporting = true;
        StateHasChanged();
        await Task.Delay(2000);
        _exporting = false;
    }
}
