@* ============================================================
   Block: account-profile-completion
   Title: AccountProfileCompletion
   Description: A profile completion progress checklist for React and Next.js with animated progress bar, reward points, step descriptions, and quick action buttons built with shadcn/ui and Tailwind CSS
   Source: original/blocks/account/account-profile-completion.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with progress *@
        <div class="border-b px-4 py-4">
            <div class="flex items-start justify-between gap-4">
                <div class="min-w-0 flex-1">
                    <h2 class="text-sm font-medium">Profile completion</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_completedCount of @_steps.Length steps done
                        @if (_remainingCount > 0)
                        {
                            <text> &middot; @_remainingPoints pts remaining</text>
                        }
                    </p>
                </div>
                <div class="text-right shrink-0">
                    <span class="@($"text-2xl font-semibold tabular-nums {_scoreColor}")">
                        @_percentage%
                    </span>
                </div>
            </div>
            <div class="mt-3">
                <ProgressCn Value="@_percentage" Class="@($"h-2 {_progressColor}")" aria-label="Progress" />
            </div>
        </div>

        @* Checklist *@
        <div>
            @for (var idx = 0; idx < _steps.Length; idx++)
            {
                var step = _steps[idx];
                var stepId = step.Id;
                var isLast = idx == _steps.Length - 1;
                var justCompleted = _recentlyCompletedId == step.Id;

                <div class="@Cn.Merge("group flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/30", !isLast ? "border-b" : "", step.Completed ? "bg-muted/20" : "")">
                    @* Checkbox *@
                    <div class="pt-0.5">
                        <CheckboxCn aria-label="@step.Label" Checked="@step.Completed" CheckedChanged="() => HandleToggle(stepId)" />
                    </div>

                    @* Icon *@
                    <div class="pt-0.5">
                        <LucideIconCn Name="@step.IconName" Size="16" Class="@Cn.Merge("size-4 shrink-0", step.Completed ? "text-muted-foreground/50" : "text-muted-foreground")" />
                    </div>

                    @* Content *@
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="@Cn.Merge("text-sm font-medium", step.Completed ? "line-through text-muted-foreground" : "")">
                                @step.Label
                            </span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-[10px] px-1.5 py-0 h-4", step.Completed ? "opacity-50" : "")">
                                +@step.Points pts
                            </BadgeCn>
                            @if (justCompleted)
                            {
                                <span class="flex items-center gap-1 text-[10px] font-medium text-emerald-600 dark:text-emerald-400">
                                    <LucideCheckCn Size="12" Class="size-3" />
                                    Done
                                </span>
                            }
                        </div>
                        <p class="@Cn.Merge("text-xs text-muted-foreground", step.Completed ? "line-through opacity-60" : "")">
                            @step.Description
                        </p>
                    </div>

                    @* Action button *@
                    @if (!step.Completed)
                    {
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs opacity-0 transition-opacity group-hover:opacity-100" @onclick="() => HandleToggle(stepId)">
                            @step.Action
                        </ButtonCn>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            @if (_percentage == 100)
            {
                <div class="flex items-center gap-1.5 text-xs font-medium text-emerald-600 dark:text-emerald-400">
                    <LucideSparklesCn Size="12" Class="size-3" />
                    Profile complete — all rewards unlocked
                </div>
            }
            else
            {
                <span class="text-[10px] text-muted-foreground">
                    Complete all steps to unlock full collaboration features
                </span>
            }
            <span class="text-[10px] font-medium tabular-nums text-muted-foreground">
                @_earnedPoints / @_totalPoints pts
            </span>
        </div>
    </div>
</section>

@code {
    private record CompletionStep(string Id, string Label, string Description, int Points, bool Completed, string IconName, string Action);

    private CompletionStep[] _steps =
    [
        new("photo",    "Add a profile photo",              "Upload a photo so teammates can recognize you in conversations",                    15, false, "camera",     "Upload"),
        new("email",    "Verify email address",             "Confirm sarah.chen@acme.com to secure account recovery and notifications",          25, true,  "mail-check", "Resend"),
        new("bio",      "Write a short bio",                "Tell your team what you do — shown on your public profile card",                    10, true,  "pen-line",   "Write"),
        new("social",   "Connect a social account",         "Link GitHub, X, or LinkedIn for faster login and identity verification",            10, false, "link",       "Connect"),
        new("timezone", "Set your timezone",                "Helps schedule meetings and shows local time to collaborators",                     15, true,  "globe",      "Set"),
        new("2fa",      "Enable two-factor authentication", "Add TOTP or security key for an extra layer of account protection",                 25, false, "key-round",  "Enable"),
    ];

    private string? _recentlyCompletedId;

    private int _totalPoints => _steps.Sum(s => s.Points);
    private int _earnedPoints => _steps.Where(s => s.Completed).Sum(s => s.Points);
    private int _percentage => _totalPoints > 0 ? (int)Math.Round((double)_earnedPoints / _totalPoints * 100) : 0;
    private int _completedCount => _steps.Count(s => s.Completed);
    private int _remainingCount => _steps.Length - _completedCount;
    private int _remainingPoints => _totalPoints - _earnedPoints;

    private string _scoreColor => _percentage >= 80
        ? "text-emerald-600 dark:text-emerald-400"
        : _percentage >= 50
            ? "text-amber-600 dark:text-amber-400"
            : "text-red-600 dark:text-red-400";

    private string _progressColor => _percentage >= 80
        ? "[&>[data-slot=indicator]]:bg-emerald-500"
        : _percentage >= 50
            ? "[&>[data-slot=indicator]]:bg-amber-500"
            : "[&>[data-slot=indicator]]:bg-red-500";

    private async Task HandleToggle(string id)
    {
        var idx = Array.FindIndex(_steps, s => s.Id == id);
        if (idx < 0) return;

        var wasCompleted = _steps[idx].Completed;
        _steps[idx] = _steps[idx] with { Completed = !wasCompleted };

        if (!wasCompleted)
        {
            _recentlyCompletedId = id;
            StateHasChanged();
            await Task.Delay(2000);
            _recentlyCompletedId = null;
        }
    }
}
