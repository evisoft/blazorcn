@* ============================================================
   Block: account-compliance-status
   Title: AccountComplianceStatus
   Description: A bento grid compliance dashboard for React and Next.js showing SOC 2, GDPR, HIPAA, ISO 27001, and PCI DSS framework statuses with completion bars, audit dates, and requirement counts built with shadcn/ui and Tailwind CSS
   Source: original/blocks/account/account-compliance-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card p-4">
        @* Header *@
        <div class="flex items-center justify-between mb-4">
            <div>
                <h2 class="text-sm font-medium">Compliance Overview</h2>
                <p class="text-xs text-muted-foreground mt-0.5">
                    @_compliantCount of @_frameworks.Length frameworks compliant
                </p>
            </div>
            <div class="flex items-center gap-3">
                <div class="flex items-baseline gap-1">
                    <span class="@($"text-2xl font-semibold tabular-nums {(_overallPercent >= 80 ? "text-emerald-600 dark:text-emerald-400" : _overallPercent >= 50 ? "text-amber-600 dark:text-amber-400" : "text-red-600 dark:text-red-400")}")">
                        @_overallPercent%
                    </span>
                    <span class="text-xs text-muted-foreground">overall</span>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="download" Size="12" Class="size-3" />
                    Export
                </ButtonCn>
            </div>
        </div>

        @* Bento grid *@
        <div class="grid gap-3 md:grid-cols-2">
            @for (int i = 0; i < _frameworks.Length; i++)
            {
                var framework = _frameworks[i];
                bool featured = i == 0;
                var config = GetStatusConfig(framework.Status);
                int reqPercent = (int)Math.Round((double)framework.Requirements.Met / framework.Requirements.Total * 100);
                int inProgressPercent = (int)Math.Round((double)framework.Requirements.InProgress / framework.Requirements.Total * 100);

                <div class="@Cn.Merge("rounded-lg border bg-card p-4", featured ? "md:col-span-2" : "")">
                    @* Framework header *@
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                @if (framework.Status == "compliant")
                                {
                                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500 shrink-0" />
                                }
                                else if (framework.Status == "in-progress")
                                {
                                    <LucideIconCn Name="alert-triangle" Size="14" Class="size-3.5 text-amber-500 shrink-0" />
                                }
                                else
                                {
                                    <LucideIconCn Name="x-circle" Size="14" Class="size-3.5 text-red-500 shrink-0" />
                                }
                                <span class="text-sm font-medium truncate">@framework.Name</span>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground truncate">@framework.FullName</p>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("shrink-0 text-[10px] font-normal border-0", config.BgClass, config.TextClass)">
                            @config.Label
                        </BadgeCn>
                    </div>

                    @* Completion bar *@
                    <div class="mt-3">
                        <div class="flex items-baseline justify-between mb-1.5">
                            <span class="text-xs text-muted-foreground">Completion</span>
                            <span class="@($"text-sm font-semibold tabular-nums {config.TextClass}")">
                                @framework.CompletionPercent%
                            </span>
                        </div>
                        <ProgressCn Value="@((double)framework.CompletionPercent)" Class="h-1.5" />
                    </div>

                    @* Requirements breakdown *@
                    <div class="mt-3 rounded-md bg-muted/50 p-2.5">
                        <div class="flex items-center gap-1.5 mb-2">
                            <LucideIconCn Name="clipboard-list" Size="12" Class="size-3 text-muted-foreground" />
                            <span class="text-[10px] font-medium text-muted-foreground uppercase tracking-wide">
                                Requirements (@framework.Requirements.Total)
                            </span>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="flex items-center gap-1.5">
                                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                <span class="text-xs tabular-nums">@framework.Requirements.Met met</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <span class="size-1.5 rounded-full bg-amber-500"></span>
                                <span class="text-xs tabular-nums">@framework.Requirements.InProgress in progress</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <span class="size-1.5 rounded-full bg-red-500"></span>
                                <span class="text-xs tabular-nums">@framework.Requirements.NotMet not met</span>
                            </div>
                        </div>
                        @* Stacked mini bar *@
                        <div class="mt-2 flex h-1 w-full overflow-hidden rounded-full bg-muted">
                            <div class="bg-emerald-500 transition-all" style="@($"width:{reqPercent}%")"></div>
                            <div class="bg-amber-500 transition-all" style="@($"width:{inProgressPercent}%")"></div>
                        </div>
                    </div>

                    @* Audit dates *@
                    <div class="@Cn.Merge("mt-3 grid gap-2", featured ? "sm:grid-cols-3" : "grid-cols-2")">
                        <div class="flex items-center gap-1.5">
                            <LucideIconCn Name="calendar" Size="12" Class="size-3 text-muted-foreground shrink-0" />
                            <div class="min-w-0">
                                <span class="block text-[10px] text-muted-foreground">Last Audit</span>
                                <span class="block text-xs tabular-nums truncate">@framework.LastAuditDate</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <LucideIconCn Name="calendar" Size="12" Class="size-3 text-muted-foreground shrink-0" />
                            <div class="min-w-0">
                                <span class="block text-[10px] text-muted-foreground">Next Review</span>
                                <span class="block text-xs tabular-nums truncate">@framework.NextReviewDate</span>
                            </div>
                        </div>
                        @if (featured && framework.Auditor != null)
                        {
                            <div class="flex items-center gap-1.5">
                                <LucideIconCn Name="shield-check" Size="12" Class="size-3 text-muted-foreground shrink-0" />
                                <div class="min-w-0">
                                    <span class="block text-[10px] text-muted-foreground">Auditor</span>
                                    <span class="block text-xs truncate">@framework.Auditor</span>
                                </div>
                            </div>
                        }
                    </div>

                    @* Cert expiry for featured *@
                    @if (featured && framework.CertExpiry != null)
                    {
                        <div class="mt-2.5 flex items-center gap-1.5">
                            <span class="text-[10px] text-muted-foreground">Certificate expires:</span>
                            <span class="text-[10px] font-medium tabular-nums">@framework.CertExpiry</span>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer summary bar *@
        <div class="mt-4 flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-xs text-muted-foreground">@_overallMet requirements met</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    <span class="text-xs text-muted-foreground">@_overallInProgress in progress</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    <span class="text-xs text-muted-foreground">@_overallNotMet not met</span>
                </div>
            </div>
            <span class="text-[10px] text-muted-foreground">
                @_overallMet / @_overallTotal total requirements
            </span>
        </div>
    </div>
</section>

@code {
    private record RequirementBreakdown(int Total, int Met, int InProgress, int NotMet);

    private record ComplianceFramework(
        string Id,
        string Name,
        string FullName,
        string Status,
        int CompletionPercent,
        string LastAuditDate,
        string NextReviewDate,
        RequirementBreakdown Requirements,
        string? CertExpiry,
        string? Auditor);

    private record StatusConfig(string Label, string DotClass, string TextClass, string BgClass);

    private static readonly ComplianceFramework[] _frameworks =
    [
        new("soc2", "SOC 2 Type II", "Service Organization Control 2", "compliant", 100,
            "Jan 18, 2026", "Jan 18, 2027", new(64, 64, 0, 0), "Jan 18, 2027", "Deloitte"),
        new("gdpr", "GDPR", "General Data Protection Regulation", "compliant", 96,
            "Feb 5, 2026", "Aug 5, 2026", new(52, 50, 2, 0), null, "EY"),
        new("hipaa", "HIPAA", "Health Insurance Portability & Accountability Act", "in-progress", 68,
            "Dec 12, 2025", "Jun 12, 2026", new(45, 28, 11, 6), null, null),
        new("iso27001", "ISO 27001", "Information Security Management System", "compliant", 92,
            "Mar 1, 2026", "Mar 1, 2027", new(93, 86, 5, 2), "Mar 1, 2029", "BSI"),
        new("pcidss", "PCI DSS", "Payment Card Industry Data Security Standard", "non-compliant", 41,
            "Nov 20, 2025", "May 20, 2026", new(78, 30, 18, 30), null, null),
    ];

    private static readonly int _overallMet = _frameworks.Sum(f => f.Requirements.Met);
    private static readonly int _overallTotal = _frameworks.Sum(f => f.Requirements.Total);
    private static readonly int _overallPercent = (int)Math.Round((double)_overallMet / _overallTotal * 100);
    private static readonly int _compliantCount = _frameworks.Count(f => f.Status == "compliant");
    private static readonly int _overallInProgress = _frameworks.Sum(f => f.Requirements.InProgress);
    private static readonly int _overallNotMet = _frameworks.Sum(f => f.Requirements.NotMet);

    private static StatusConfig GetStatusConfig(string status) => status switch
    {
        "compliant" => new("Compliant", "bg-emerald-500", "text-emerald-600 dark:text-emerald-400", "bg-emerald-500/10"),
        "in-progress" => new("In Progress", "bg-amber-500", "text-amber-600 dark:text-amber-400", "bg-amber-500/10"),
        _ => new("Non-Compliant", "bg-red-500", "text-red-600 dark:text-red-400", "bg-red-500/10"),
    };
}
