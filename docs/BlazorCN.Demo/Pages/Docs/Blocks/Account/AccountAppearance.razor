@* ============================================================
   Block: account-appearance
   Title: Account Appearance
   Description: Appearance and display settings with theme selector, language preferences, and interface customization options
   Long Description: Personal details and profile info
   Dependencies: BadgeCn, ButtonCn, LabelCn, RadioGroupCn, RadioGroupItemCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, SwitchCn, LucideCheckCn, LucideLoaderCircleCn, LucideMonitorCn, LucideMoonCn, LucidePaletteCn, LucideSunCn
   Source: original/blocks/account/account-appearance.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <LucidePaletteCn Size="20" Class="text-muted-foreground" />
                <div>
                    <h2 class="text-sm font-medium">Appearance</h2>
                    <p class="text-xs text-muted-foreground">
                        Customize how the application looks and feels
                    </p>
                </div>
            </div>
        </div>

        <div class="p-4">
            <div class="space-y-6">
                @* Theme *@
                <div class="space-y-3">
                    <span class="text-xs font-medium text-muted-foreground">THEME</span>
                    <RadioGroupCn Class="grid grid-cols-1 gap-2 sm:grid-cols-3" Value="@_theme" ValueChanged='v => _theme = v ?? "system"'>
                        <LabelCn Class="relative flex flex-col items-center justify-between rounded-md border p-4 hover:bg-muted/50 cursor-pointer transition-all [&:has([data-state=checked])]:border-foreground" For="light">
                            <RadioGroupItemCn Class="sr-only" Value="light" />
                            @if (_theme == "light")
                            {
                                <div class="absolute -top-1.5 -right-1.5 flex h-5 w-5 items-center justify-center rounded-full bg-foreground text-background">
                                    <LucideCheckCn Size="12" />
                                </div>
                            }
                            <div class="mb-3 w-full overflow-hidden rounded-md border bg-white">
                                <div class="flex items-center gap-1 border-b bg-gray-50 px-2 py-1">
                                    <div class="h-1 w-1 rounded-full bg-red-400"></div>
                                    <div class="h-1 w-1 rounded-full bg-yellow-400"></div>
                                    <div class="h-1 w-1 rounded-full bg-green-400"></div>
                                </div>
                                <div class="flex">
                                    <div class="w-6 border-r bg-gray-50 p-1">
                                        <div class="h-1 w-full rounded bg-gray-200"></div>
                                        <div class="mt-1 h-0.5 w-full rounded bg-gray-200"></div>
                                        <div class="mt-1 h-0.5 w-full rounded bg-gray-200"></div>
                                    </div>
                                    <div class="flex-1 p-1.5">
                                        <div class="h-1.5 w-3/4 rounded bg-gray-200"></div>
                                        <div class="mt-1 h-1 w-1/2 rounded bg-gray-100"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <LucideSunCn Size="16" Class="text-amber-500" />
                                <span class="text-sm font-medium">Light</span>
                            </div>
                        </LabelCn>

                        <LabelCn Class="relative flex flex-col items-center justify-between rounded-md border p-4 hover:bg-muted/50 cursor-pointer transition-all [&:has([data-state=checked])]:border-foreground" For="dark">
                            <RadioGroupItemCn Class="sr-only" Value="dark" />
                            @if (_theme == "dark")
                            {
                                <div class="absolute -top-1.5 -right-1.5 flex h-5 w-5 items-center justify-center rounded-full bg-foreground text-background">
                                    <LucideCheckCn Size="12" />
                                </div>
                            }
                            <div class="mb-3 w-full overflow-hidden rounded-md border border-gray-700 bg-gray-900">
                                <div class="flex items-center gap-1 border-b border-gray-700 bg-gray-800 px-2 py-1">
                                    <div class="h-1 w-1 rounded-full bg-red-400"></div>
                                    <div class="h-1 w-1 rounded-full bg-yellow-400"></div>
                                    <div class="h-1 w-1 rounded-full bg-green-400"></div>
                                </div>
                                <div class="flex">
                                    <div class="w-6 border-r border-gray-700 bg-gray-800 p-1">
                                        <div class="h-1 w-full rounded bg-gray-600"></div>
                                        <div class="mt-1 h-0.5 w-full rounded bg-gray-700"></div>
                                        <div class="mt-1 h-0.5 w-full rounded bg-gray-700"></div>
                                    </div>
                                    <div class="flex-1 p-1.5">
                                        <div class="h-1.5 w-3/4 rounded bg-gray-700"></div>
                                        <div class="mt-1 h-1 w-1/2 rounded bg-gray-800"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <LucideMoonCn Size="16" Class="text-indigo-400" />
                                <span class="text-sm font-medium">Dark</span>
                            </div>
                        </LabelCn>

                        <LabelCn Class="relative flex flex-col items-center justify-between rounded-md border p-4 hover:bg-muted/50 cursor-pointer transition-all [&:has([data-state=checked])]:border-foreground" For="system">
                            <RadioGroupItemCn Class="sr-only" Value="system" />
                            @if (_theme == "system")
                            {
                                <div class="absolute -top-1.5 -right-1.5 flex h-5 w-5 items-center justify-center rounded-full bg-foreground text-background">
                                    <LucideCheckCn Size="12" />
                                </div>
                            }
                            <div class="mb-3 w-full overflow-hidden rounded-md border">
                                <div class="flex items-center gap-1 border-b px-2 py-1">
                                    <div class="h-1 w-1 rounded-full bg-red-400"></div>
                                    <div class="h-1 w-1 rounded-full bg-yellow-400"></div>
                                    <div class="h-1 w-1 rounded-full bg-green-400"></div>
                                </div>
                                <div class="flex">
                                    <div class="flex-1 bg-white p-1.5">
                                        <div class="h-1.5 w-3/4 rounded bg-gray-200"></div>
                                        <div class="mt-1 h-1 w-1/2 rounded bg-gray-100"></div>
                                    </div>
                                    <div class="flex-1 bg-gray-900 p-1.5">
                                        <div class="h-1.5 w-3/4 rounded bg-gray-700"></div>
                                        <div class="mt-1 h-1 w-1/2 rounded bg-gray-800"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <LucideMonitorCn Size="16" Class="text-muted-foreground" />
                                <span class="text-sm font-medium">System</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px]">Auto</BadgeCn>
                            </div>
                        </LabelCn>
                    </RadioGroupCn>
                </div>

                @* Interface *@
                <div class="space-y-3">
                    <span class="text-xs font-medium text-muted-foreground">INTERFACE</span>
                    <div class="divide-y rounded-md border">
                        <div class="flex items-center justify-between px-3 py-2">
                            <div class="flex-1">
                                <LabelCn Class="text-sm font-medium cursor-pointer" For="compact-mode">Compact Mode</LabelCn>
                                <p class="text-xs text-muted-foreground">
                                    Reduce spacing to show more content on screen
                                </p>
                            </div>
                            <SwitchCn Checked="_compactMode" CheckedChanged="v => _compactMode = v" />
                        </div>

                        <div class="flex items-center justify-between px-3 py-2">
                            <div class="flex-1">
                                <LabelCn Class="text-sm font-medium cursor-pointer" For="reduced-motion">Reduced Motion</LabelCn>
                                <p class="text-xs text-muted-foreground">
                                    Minimize animations for accessibility
                                </p>
                            </div>
                            <SwitchCn Checked="_reducedMotion" CheckedChanged="v => _reducedMotion = v" />
                        </div>
                    </div>
                </div>

                @* Language & Region *@
                <div class="space-y-3">
                    <span class="text-xs font-medium text-muted-foreground">LANGUAGE &amp; REGION</span>
                    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                        <div class="rounded-md border p-3 space-y-2">
                            <LabelCn Class="text-sm font-medium" For="language">Display Language</LabelCn>
                            <SelectCn Value="@_language" ValueChanged='v => _language = v ?? "en"'>
                                <SelectTriggerCn>
                                    <SelectValueCn Placeholder="Select language" />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    <SelectItemCn Value="en">English</SelectItemCn>
                                    <SelectItemCn Value="es">Espanol</SelectItemCn>
                                    <SelectItemCn Value="fr">Francais</SelectItemCn>
                                    <SelectItemCn Value="de">Deutsch</SelectItemCn>
                                </SelectContentCn>
                            </SelectCn>
                        </div>

                        <div class="rounded-md border p-3 space-y-2">
                            <LabelCn Class="text-sm font-medium" For="timezone">Timezone</LabelCn>
                            <SelectCn Value="@_timezone" ValueChanged='v => _timezone = v ?? "auto"'>
                                <SelectTriggerCn>
                                    <SelectValueCn Placeholder="Select timezone" />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    <SelectItemCn Value="auto">Automatic</SelectItemCn>
                                    <SelectItemCn Value="utc">UTC</SelectItemCn>
                                    <SelectItemCn Value="est">Eastern Time (ET)</SelectItemCn>
                                    <SelectItemCn Value="cst">Central Time (CT)</SelectItemCn>
                                    <SelectItemCn Value="pst">Pacific Time (PT)</SelectItemCn>
                                    <SelectItemCn Value="gmt">GMT</SelectItemCn>
                                </SelectContentCn>
                            </SelectCn>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-end gap-2 border-t pt-4 mt-6">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">
                    Reset to Defaults
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Disabled="@_isSaving" @onclick="HandleSave">
                    @if (_isSaving)
                    {
                        <LucideLoaderCircleCn Size="16" Class="mr-2 animate-spin" />
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Changes</span>
                    }
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private string _theme = "system";
    private bool _compactMode;
    private bool _reducedMotion;
    private string _language = "en";
    private string _timezone = "auto";
    private bool _isSaving;

    private async Task HandleSave()
    {
        _isSaving = true;
        StateHasChanged();
        await Task.Delay(1500);
        _isSaving = false;
    }
}
