@* ============================================================
   Block: account-privacy
   Title: AccountPrivacy
   Description: A privacy shield settings card for React and Next.js with profile visibility controls, data sharing toggles, privacy score indicator, and GDPR data actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/account/account-privacy.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with privacy score *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Privacy &amp; Data</h2>
                    <p class="text-xs text-muted-foreground">Last reviewed @_lastReviewDate</p>
                </div>
                <div class="flex items-center gap-3">
                    <div class="text-right">
                        <div class="flex items-center gap-1.5">
                            <span class="@($"text-lg font-semibold tabular-nums {ScoreColor}")">
                                @PrivacyScore
                            </span>
                            <span class="text-[10px] text-muted-foreground">/ 100</span>
                        </div>
                        <span class="@($"text-[10px] font-medium {ScoreColor}")">
                            @ScoreLabel privacy
                        </span>
                    </div>
                    @* Mini progress bar *@
                    <div class="h-8 w-1.5 rounded-full bg-muted">
                        <div class="@($"w-full rounded-full {ScoreBg}")"
                             style="@($"height:{PrivacyScore}%;margin-top:{100 - PrivacyScore}%")">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Visibility Controls *@
        <div class="border-b">
            <div class="border-b bg-muted/50 px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">Visibility</span>
            </div>

            <div class="flex items-center justify-between gap-4 border-b px-4 py-3">
                <div class="flex items-center gap-3 min-w-0 flex-1">
                    <LucideEyeCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0">
                        <span class="text-sm font-medium">Profile</span>
                        <p class="text-xs text-muted-foreground">
                            Who can view your profile page and bio
                        </p>
                    </div>
                </div>
                <SelectCn Value="@_profileVisibility" ValueChanged='v => _profileVisibility = v ?? "friends"'>
                    <SelectTriggerCn aria-label="Profile visibility" Class="h-8 w-[140px]">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        @foreach (var opt in _visibilityOptions)
                        {
                            <SelectItemCn Value="@opt.Value">@opt.Label</SelectItemCn>
                        }
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="flex items-center justify-between gap-4 border-b px-4 py-3">
                <div class="flex items-center gap-3 min-w-0 flex-1">
                    <LucideMessageSquareCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0">
                        <span class="text-sm font-medium">Messages</span>
                        <p class="text-xs text-muted-foreground">Who can send you direct messages</p>
                    </div>
                </div>
                <SelectCn Value="@_messagePermission" ValueChanged='v => _messagePermission = v ?? "friends"'>
                    <SelectTriggerCn aria-label="Message privacy" Class="h-8 w-[140px]">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        @foreach (var opt in _visibilityOptions)
                        {
                            <SelectItemCn Value="@opt.Value">@opt.Label</SelectItemCn>
                        }
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="flex items-center justify-between gap-4 px-4 py-3">
                <div class="flex items-center gap-3 min-w-0 flex-1">
                    <LucideUsersCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0">
                        <span class="text-sm font-medium">Activity</span>
                        <p class="text-xs text-muted-foreground">
                            Who can see your recent activity and status
                        </p>
                    </div>
                </div>
                <SelectCn Value="@_activityVisibility" ValueChanged='v => _activityVisibility = v ?? "private"'>
                    <SelectTriggerCn aria-label="Activity visibility" Class="h-8 w-[140px]">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        @foreach (var opt in _visibilityOptions)
                        {
                            <SelectItemCn Value="@opt.Value">@opt.Label</SelectItemCn>
                        }
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        @* Data Sharing *@
        <div class="border-b">
            <div class="border-b bg-muted/50 px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">Data Sharing</span>
            </div>

            @for (int i = 0; i < _dataSharingToggles.Length; i++)
            {
                var toggle = _dataSharingToggles[i];
                var isLast = i == _dataSharingToggles.Length - 1;
                <div class="@Cn.Merge("flex items-center justify-between gap-4 px-4 py-3", isLast ? "" : "border-b")">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@toggle.Label</span>
                            @if (_dataSharing[toggle.Key])
                            {
                                <span class="size-1.5 rounded-full bg-amber-500"></span>
                            }
                        </div>
                        <p class="text-xs text-muted-foreground">@toggle.Description</p>
                    </div>
                    <SwitchCn aria-label="@toggle.Label" Checked="@_dataSharing[toggle.Key]" CheckedChanged="@(v => _dataSharing[toggle.Key] = v)" />
                </div>
            }
        </div>

        @* Data Actions *@
        <div class="border-b">
            <div class="border-b bg-muted/50 px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">Your Data</span>
            </div>

            <div class="px-4 py-3">
                <div class="flex flex-col gap-3">
                    @* Download *@
                    <div class="flex items-center justify-between gap-3 rounded-md bg-muted/50 px-3 py-2.5">
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">Download my data</span>
                            <p class="text-xs text-muted-foreground">
                                Export all your data as a JSON archive
                            </p>
                        </div>
                        <ButtonCn Type="button" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                  Class="h-7 gap-1.5 text-xs" @onclick="HandleDownload" Disabled="@_downloadRequested">
                            @if (_downloadRequested)
                            {
                                <LucideCheckCn Size="12" Class="size-3" />
                                <text>Requested</text>
                            }
                            else
                            {
                                <LucideDownloadCn Size="12" Class="size-3" />
                                <text>Download</text>
                            }
                        </ButtonCn>
                    </div>

                    @* Delete *@
                    <div class="flex items-center justify-between gap-3 rounded-md bg-muted/50 px-3 py-2.5">
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">Delete my data</span>
                            <p class="text-xs text-muted-foreground">
                                Permanently erase all personal data from our servers
                            </p>
                        </div>
                        @if (_deleteConfirm)
                        {
                            <div class="flex items-center gap-1.5">
                                <ButtonCn Type="button" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                          Class="h-7 text-xs" @onclick="@(() => _deleteConfirm = false)">
                                    Cancel
                                </ButtonCn>
                                <ButtonCn Type="button" Variant="ButtonVariant.Destructive" Size="ButtonSize.Sm"
                                          Class="h-7 text-xs">
                                    Confirm
                                </ButtonCn>
                            </div>
                        }
                        else
                        {
                            <ButtonCn Type="button" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                      Class="h-7 gap-1.5 text-xs text-red-600 hover:text-red-600 dark:text-red-400 dark:hover:text-red-400"
                                      @onclick="@(() => _deleteConfirm = true)">
                                <LucideTrash2Cn Size="12" Class="size-3" />
                                Delete
                            </ButtonCn>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center gap-2 px-4 py-3">
            <LucideShieldCn Size="12" Class="size-3 text-muted-foreground" />
            <span class="text-[10px] text-muted-foreground">
                Privacy settings take effect immediately. Data deletion is irreversible and may take up
                to 30 days to process.
            </span>
        </div>
    </div>
</section>

@code {
    private record VisibilityOption(string Value, string Label, string Description);
    private record DataSharingToggle(string Key, string Label, string Description, int PrivacyWeight);

    private static readonly VisibilityOption[] _visibilityOptions =
    [
        new("public", "Public", "Visible to everyone"),
        new("friends", "Friends only", "Only approved connections"),
        new("private", "Private", "Only visible to you"),
    ];

    private static readonly DataSharingToggle[] _dataSharingToggles =
    [
        new("analytics", "Usage analytics", "Share anonymous usage patterns to help improve the platform experience", 10),
        new("personalization", "Personalization data", "Allow browsing behavior to personalize content recommendations", 15),
        new("third-party", "Third-party integrations", "Share limited profile data with connected third-party services", 20),
    ];

    private string _profileVisibility = "friends";
    private string _messagePermission = "friends";
    private string _activityVisibility = "private";

    private readonly Dictionary<string, bool> _dataSharing = new()
    {
        ["analytics"] = true,
        ["personalization"] = false,
        ["third-party"] = false,
    };

    private bool _downloadRequested = false;
    private bool _deleteConfirm = false;

    private readonly string _lastReviewDate = "Feb 12, 2026";

    private int PrivacyScore
    {
        get
        {
            int score = 0;
            int VisScore(string val) => val == "private" ? 20 : val == "friends" ? 12 : 0;
            score += VisScore(_profileVisibility);
            score += VisScore(_messagePermission);
            score += VisScore(_activityVisibility);
            foreach (var toggle in _dataSharingToggles)
            {
                if (!_dataSharing[toggle.Key])
                    score += toggle.PrivacyWeight;
            }
            return Math.Min(100, (int)Math.Round(score / 105.0 * 100));
        }
    }

    private string ScoreColor => PrivacyScore >= 75
        ? "text-emerald-600 dark:text-emerald-400"
        : PrivacyScore >= 40
            ? "text-amber-600 dark:text-amber-400"
            : "text-red-600 dark:text-red-400";

    private string ScoreBg => PrivacyScore >= 75 ? "bg-emerald-500"
        : PrivacyScore >= 40 ? "bg-amber-500"
        : "bg-red-500";

    private string ScoreLabel => PrivacyScore >= 75 ? "Strong"
        : PrivacyScore >= 40 ? "Moderate"
        : "Weak";

    private void HandleDownload() => _downloadRequested = true;
}
