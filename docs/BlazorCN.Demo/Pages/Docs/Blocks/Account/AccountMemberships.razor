@* ============================================================
   Block: account-memberships
   Title: Account Memberships
   Description: Membership management interface for clubs, gyms, associations, loyalty programs with renewal and cancellation flows
   Long Description: Membership management
   Dependencies: BadgeCn, ButtonCn, ProgressCn, SwitchCn, TabsCn, TabsContentCn, TabsListCn, TabsTriggerCn, LucideBuilding2Cn, LucideCalendarCn, LucideCheckCn, LucideCrownCn, LucideDumbbellCn, LucidePauseCn, LucideRefreshCwCn, LucideStarCn, LucideUsersCn, LucideZapCn
   Source: original/blocks/account/account-memberships.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <LucideCrownCn Size="20" Class="text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Memberships</h2>
                        <p class="text-xs text-muted-foreground">
                            Manage your clubs, subscriptions, and loyalty programs
                        </p>
                    </div>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary">@_memberships.Length active</BadgeCn>
            </div>
        </div>

        <div class="p-4 space-y-4">
            @{ var expiring = _memberships.FirstOrDefault(m => m.Status == "expiring"); }
            @if (expiring is not null)
            {
                <div class="flex items-start gap-2 rounded-md bg-amber-500/10 p-3">
                    <LucideCircleAlertCn Size="16" Class="text-amber-700 shrink-0 mt-0.5" />
                    <div class="flex-1">
                        <p class="text-sm font-medium">Membership Expiring Soon</p>
                        <p class="text-xs text-muted-foreground">
                            @expiring.Organization membership expires in @expiring.DaysUntilRenewal days.
                        </p>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Class="shrink-0 h-7 text-xs">
                        Renew Now
                    </ButtonCn>
                </div>
            }

            <TabsCn DefaultValue="active" Class="w-full">
                <TabsListCn Class="grid w-full grid-cols-2">
                    <TabsTriggerCn Value="active">Active (@_memberships.Length)</TabsTriggerCn>
                    <TabsTriggerCn Value="past">Past (@_pastMemberships.Length)</TabsTriggerCn>
                </TabsListCn>

                <TabsContentCn Value="active" Class="space-y-3 mt-4">
                    <span class="text-xs font-medium text-muted-foreground">YOUR MEMBERSHIPS</span>

                    <div class="space-y-2">
                        @foreach (var m in _memberships)
                        {
                            <div class="rounded-md border overflow-hidden">
                                <div class="p-3">
                                    <div class="flex items-start gap-3">
                                        <div class="flex h-8 w-8 items-center justify-center rounded-md bg-muted text-muted-foreground shrink-0">
                                            @switch (m.Type)
                                            {
                                                case "gym":
                                                    <LucideDumbbellCn Size="16" />
                                                    break;
                                                case "professional":
                                                    <LucideBuilding2Cn Size="16" />
                                                    break;
                                                case "loyalty":
                                                    <LucideStarCn Size="16" />
                                                    break;
                                                default:
                                                    <LucideUsersCn Size="16" />
                                                    break;
                                            }
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <div class="flex items-center gap-1.5">
                                                <p class="text-sm font-medium">@m.Organization</p>
                                                @switch (m.Status)
                                                {
                                                    case "active":
                                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-emerald-500/10 text-emerald-700 text-[10px] h-4 px-1.5">Active</BadgeCn>
                                                        break;
                                                    case "expiring":
                                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-amber-500/10 text-amber-700 text-[10px] h-4 px-1.5">Expiring Soon</BadgeCn>
                                                        break;
                                                    case "paused":
                                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] h-4 px-1.5">Paused</BadgeCn>
                                                        break;
                                                    default:
                                                        <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] h-4 px-1.5">Expired</BadgeCn>
                                                        break;
                                                }
                                            </div>
                                            <p class="text-xs text-muted-foreground">
                                                @m.Name &middot; @m.Tier
                                            </p>
                                        </div>
                                        <div class="text-right shrink-0">
                                            <p class="text-sm font-semibold">@FormatPrice(m.Price, m.BillingCycle)</p>
                                            <p class="text-xs text-muted-foreground">
                                                @(m.Status == "paused" ? "Paused" : $"Renews @m.RenewalDate")
                                            </p>
                                        </div>
                                    </div>

                                    @if (m.Status != "paused")
                                    {
                                        <div class="mt-3 space-y-1.5">
                                            <div class="flex items-center justify-between text-xs">
                                                <span class="text-muted-foreground">Membership period</span>
                                                <span class="text-muted-foreground">@m.DaysUntilRenewal days remaining</span>
                                            </div>
                                            <ProgressCn Class="h-1.5" Value="@(100 - (double)m.DaysUntilRenewal / 365 * 100)" />
                                        </div>
                                    }

                                    @if (m.Visits is not null || m.PointsEarned is not null || m.SavingsTotal is not null)
                                    {
                                        <div class="mt-3 flex items-center gap-4 text-xs text-muted-foreground">
                                            @if (m.Visits is not null)
                                            {
                                                <div class="flex items-center gap-1">
                                                    <LucideCalendarCn Size="12" />
                                                    @m.Visits visits
                                                </div>
                                            }
                                            @if (m.PointsEarned is not null)
                                            {
                                                <div class="flex items-center gap-1">
                                                    <LucideStarCn Size="12" />
                                                    @m.PointsEarned.Value.ToString("N0") pts
                                                </div>
                                            }
                                            @if (m.SavingsTotal is not null)
                                            {
                                                <div class="flex items-center gap-1">
                                                    <LucideZapCn Size="12" />
                                                    $@m.SavingsTotal.Value.ToString("F2") saved
                                                </div>
                                            }
                                        </div>
                                    }

                                    <div class="mt-3 flex flex-wrap gap-1">
                                        @foreach (var benefit in m.Benefits.Take(3))
                                        {
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] h-4 px-1.5 gap-0.5">
                                                <LucideCheckCn Size="10" />
                                                @benefit
                                            </BadgeCn>
                                        }
                                        @if (m.Benefits.Length > 3)
                                        {
                                            <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] h-4 px-1.5">
                                                +@(m.Benefits.Length - 3) more
                                            </BadgeCn>
                                        }
                                    </div>
                                </div>

                                <div class="border-t bg-muted/30 px-3 py-2 flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        <SwitchCn Checked="m.AutoRenew" Disabled="@(m.Status == "paused")" CheckedChanged="@(v => {})" />
                                        <span class="text-xs text-muted-foreground">Auto-renew</span>
                                    </div>
                                    <div class="flex items-center gap-1.5">
                                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                                            Details
                                        </ButtonCn>
                                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs gap-1">
                                            @if (m.Status == "paused")
                                            {
                                                <LucideRefreshCwCn Size="12" />
                                                <span>Resume</span>
                                            }
                                            else
                                            {
                                                <LucidePauseCn Size="12" />
                                                <span>Pause</span>
                                            }
                                        </ButtonCn>
                                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs text-destructive hover:text-destructive">
                                            Cancel
                                        </ButtonCn>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </TabsContentCn>

                <TabsContentCn Value="past" Class="space-y-3 mt-4">
                    <span class="text-xs font-medium text-muted-foreground">PAST MEMBERSHIPS</span>

                    <div class="rounded-md border divide-y">
                        @foreach (var pm in _pastMemberships)
                        {
                            <div class="flex items-center gap-3 px-3 py-3">
                                <div class="flex h-8 w-8 items-center justify-center rounded-md bg-muted shrink-0">
                                    <LucideUsersCn Size="16" Class="text-muted-foreground" />
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium">@pm.Organization</p>
                                    <p class="text-xs text-muted-foreground">
                                        @pm.StartDate - @pm.EndDate
                                    </p>
                                </div>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] h-4 px-1.5">
                                    Ended
                                </BadgeCn>
                                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                                    Rejoin
                                </ButtonCn>
                            </div>
                        }
                    </div>
                </TabsContentCn>
            </TabsCn>
        </div>
    </div>
</section>

@code {
    private record Membership(string Id, string Name, string Organization, string Type, string Tier, string Status, string StartDate, string RenewalDate, int DaysUntilRenewal, decimal Price, string BillingCycle, bool AutoRenew, string MemberNumber, string[] Benefits, int? Visits = null, int? PointsEarned = null, decimal? SavingsTotal = null);
    private record PastMembership(string Id, string Name, string Organization, string StartDate, string EndDate, string Reason);

    private static string FormatPrice(decimal price, string cycle)
    {
        if (price == 0) return "Free";
        var suffix = cycle switch { "monthly" => "mo", "quarterly" => "qtr", _ => "yr" };
        return $"${price:F2}/{suffix}";
    }

    private static readonly Membership[] _memberships =
    [
        new("1", "Premium Membership", "FitLife Gym", "gym", "Premium", "active", "Jan 15, 2024", "Jan 15, 2025", 180, 79.99m, "monthly", true, "FLG-2024-8847",
            ["Unlimited gym access", "All group classes", "Personal trainer sessions (2/month)", "Sauna & spa access"], Visits: 47),
        new("2", "Gold Rewards", "ShopMart Rewards", "loyalty", "Gold", "active", "Jun 1, 2023", "Jun 1, 2025", 320, 0m, "yearly", true, "SMR-847291",
            ["5% cashback on all purchases", "Free shipping on orders over $25", "Early access to sales", "Birthday bonus points"], PointsEarned: 12450, SavingsTotal: 347.82m),
        new("3", "Professional Membership", "Tech Professionals Association", "professional", "Full Member", "expiring", "Dec 1, 2023", "Dec 15, 2024", 14, 299m, "yearly", false, "TPA-2023-1847",
            ["Industry certifications", "Conference discounts", "Job board access", "Networking events"]),
    ];

    private static readonly PastMembership[] _pastMemberships =
    [
        new("p1", "Basic Membership", "Downtown Fitness", "Jan 1, 2022", "Dec 31, 2023", "Switched to different gym"),
        new("p2", "Book Club", "Literary Circle", "Mar 1, 2023", "Sep 30, 2023", "Not enough time"),
    ];
}
