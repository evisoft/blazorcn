@* ============================================================
   Block: account-login-history
   Title: Account Login History
   Description: Login history and session security dashboard showing all sign-in attempts, device fingerprints, location data, suspicious activity alerts, and active session management
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/account/account-login-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <LucideShieldCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                <div class="flex-1">
                    <h2 class="text-sm font-medium">Login History</h2>
                    <p class="text-xs text-muted-foreground">Review your recent sign-in activity and security events</p>
                </div>
                <ButtonCn aria-label="Refresh" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                    <LucideRefreshCwCn Class="h-3.5 w-3.5" Size="14" />
                </ButtonCn>
            </div>
        </div>

        @if (_events.Any(e => e.Status == "suspicious"))
        {
            <div class="border-b bg-amber-500/10 px-4 py-3">
                <div class="flex items-center gap-3">
                    <span class="size-1.5 shrink-0 rounded-full bg-amber-500"></span>
                    <div class="flex-1">
                        <p class="text-sm font-medium text-amber-900">Suspicious activity detected</p>
                        <p class="text-xs text-amber-700">We blocked @(_events.Count(e => e.Status == "suspicious")) login attempt from an unrecognized location</p>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">Secure Account</ButtonCn>
                </div>
            </div>
        }

        <div class="border-b px-4 py-2">
            <div class="flex items-center gap-2">
                @foreach (var tab in new[] { ("all", "All"), ("success", "Successful"), ("failed", "Failed"), ("suspicious", "Suspicious") })
                {
                    <button type="button" class="@Cn.Merge("rounded-md px-3 py-1 text-xs font-medium transition-colors", _filter == tab.Item1 ? "bg-muted text-foreground" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => _filter = tab.Item1)">@tab.Item2</button>
                }
            </div>
        </div>

        @foreach (var evt in FilteredEvents)
        {
            <div class="border-b px-4 py-3 last:border-0">
                <div class="flex items-start gap-3">
                    @if (evt.Status == "success")
                    {
                        <LucideCircleCheckCn Class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" Size="16" />
                    }
                    else if (evt.Status == "failed")
                    {
                        <LucideCircleXCn Class="mt-0.5 h-4 w-4 shrink-0 text-red-500" Size="16" />
                    }
                    else
                    {
                        <LucideTriangleAlertCn Class="mt-0.5 h-4 w-4 shrink-0 text-amber-500" Size="16" />
                    }

                    <div class="min-w-0 flex-1">
                        <div class="mb-1 flex items-center gap-2">
                            <p class="text-sm font-medium">@GetStatusLabel(evt.Status)</p>
                            @if (evt.IsCurrentSession)
                            {
                                <BadgeCn Class="h-4 border-0 bg-primary/10 px-1.5 py-0 text-[10px] text-primary">Current</BadgeCn>
                            }
                            @if (evt.IsNewDevice)
                            {
                                <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 px-1.5 py-0 text-[10px] font-normal text-muted-foreground">New Device</BadgeCn>
                            }
                            @if (evt.RiskScore is not null and not "low")
                            {
                                <BadgeCn Class="@Cn.Merge("h-4 border-0 px-1.5 py-0 text-[10px]", evt.RiskScore == "high" ? "bg-red-500/10 text-red-700" : "bg-amber-500/10 text-amber-700")">
                                    @(evt.RiskScore == "high" ? "High Risk" : "Medium")
                                </BadgeCn>
                            }
                        </div>

                        @if (evt.FailureReason != null)
                        {
                            <p class="mb-2 text-sm text-red-600">@evt.FailureReason</p>
                        }

                        <div class="flex items-center gap-3 text-xs text-muted-foreground">
                            <div class="flex items-center gap-1">
                                @if (evt.DeviceType == "mobile")
                                {
                                    <LucideSmartphoneCn Class="h-3 w-3" Size="12" />
                                }
                                else
                                {
                                    <LucideMonitorCn Class="h-3 w-3" Size="12" />
                                }
                                <span>@evt.DeviceName</span>
                            </div>
                            <span>&bull;</span>
                            <span>@evt.City, @evt.CountryCode</span>
                            <span>&bull;</span>
                            <BadgeCn Class="h-4 px-1.5 py-0 text-[10px] font-normal" Variant="BadgeVariant.Outline">@GetMethodLabel(evt.Method)</BadgeCn>
                        </div>

                        <p class="mt-1 text-xs text-muted-foreground">@evt.Timestamp</p>
                    </div>

                    @if (evt.Status == "success" && !evt.IsCurrentSession)
                    {
                        <ButtonCn aria-label="Revoke session" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                            <LucideLogOutCn Class="h-3.5 w-3.5" Size="14" />
                        </ButtonCn>
                    }
                    @if (evt.Status is "failed" or "suspicious")
                    {
                        <ButtonCn aria-label="Report activity" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                            <LucideFlagCn Class="h-3.5 w-3.5" Size="14" />
                        </ButtonCn>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record LoginEvent(string Id, string Timestamp, string Status, string Method, string DeviceType, string DeviceName, string City, string CountryCode, bool IsCurrentSession, bool IsNewDevice, string? FailureReason = null, string? RiskScore = null);

    private string _filter = "all";

    private LoginEvent[] FilteredEvents => _filter == "all"
        ? _events
        : _filter == "suspicious"
            ? _events.Where(e => e.Status is "suspicious" or "blocked").ToArray()
            : _events.Where(e => e.Status == _filter).ToArray();

    private static string GetStatusLabel(string status) => status switch
    {
        "success" => "Signed in",
        "failed" => "Failed sign-in",
        "blocked" => "Blocked sign-in",
        "suspicious" => "Suspicious attempt",
        _ => status,
    };

    private static string GetMethodLabel(string method) => method switch
    {
        "password" => "Password",
        "2fa" => "2FA",
        "sso" => "SSO",
        "magic-link" => "Magic Link",
        "passkey" => "Passkey",
        _ => method,
    };

    private static readonly LoginEvent[] _events =
    [
        new("1", "Dec 8, 2024 at 10:32 AM", "success", "passkey", "desktop", "MacBook Pro", "San Francisco", "US", true, false, null, "low"),
        new("2", "Dec 8, 2024 at 8:15 AM", "failed", "password", "desktop", "Windows PC", "London", "GB", false, true, "Incorrect password", "medium"),
        new("3", "Dec 7, 2024 at 3:20 PM", "suspicious", "password", "desktop", "Unknown Device", "Moscow", "RU", false, true, "Blocked by security rules", "high"),
    ];
}
