@* ============================================================
   Block: account-ip-allowlist
   Title: Account Ip Allowlist
   Description: Restrict account and API access to specific IP addresses or CIDR ranges with add, remove, and enable controls
   Dependencies: ButtonCn, DialogCn, InputCn, SwitchCn
   Source: original/blocks/account/account-ip-allowlist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <LucideShieldCn Class="h-5 w-5 text-muted-foreground" Size="20" />
                    <div>
                        <h2 class="text-sm font-medium">IP Allowlist</h2>
                        <p class="text-xs text-muted-foreground">Restrict access to trusted IP addresses</p>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <span class="text-xs text-muted-foreground">@(_enabled ? "Enforcing" : "Disabled")</span>
                    <SwitchCn Checked="@_enabled" CheckedChanged="@((bool v) => _enabled = v)" />
                </div>
            </div>
        </div>

        <div class="divide-y">
            @foreach (var entry in _entries)
            {
                <div class="flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", _enabled ? "bg-emerald-500" : "bg-muted-foreground/30")"></span>
                    <div class="min-w-0 flex-1">
                        <span class="text-sm font-medium">@entry.Label</span>
                        <p class="mt-0.5 font-mono text-xs text-muted-foreground">@entry.Ip</p>
                    </div>
                    <span class="shrink-0 text-xs text-muted-foreground">@entry.Added</span>
                    <ButtonCn Class="h-7 gap-1 px-2 text-xs" Variant="ButtonVariant.Ghost"
                              OnClick="@(() => HandleRemove(entry.Id))">
                        <LucideTrash2Cn Class="size-3.5" Size="14" />
                        Remove
                    </ButtonCn>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <DialogCn @bind-Open="_dialogOpen">
                <ButtonCn Class="gap-2" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline"
                          OnClick="@(() => _dialogOpen = true)">
                    <LucidePlusCn Class="size-4" Size="16" />
                    Add IP
                </ButtonCn>
                <DialogContentCn Class="w-[420px]">
                    <DialogHeaderCn>
                        <DialogTitleCn>Add IP Address</DialogTitleCn>
                        <DialogDescriptionCn>Enter an IPv4 address or CIDR range to allow.</DialogDescriptionCn>
                    </DialogHeaderCn>
                    <div class="space-y-4 py-4">
                        <div class="space-y-2">
                            <span class="text-xs font-medium text-muted-foreground">Label</span>
                            <InputCn placeholder="e.g., Office Network" @bind-Value="_newLabel" />
                        </div>
                        <div class="space-y-2">
                            <span class="text-xs font-medium text-muted-foreground">IP Address or CIDR</span>
                            <InputCn placeholder="e.g., 192.168.1.0/24" @bind-Value="_newIp" />
                        </div>
                    </div>
                    <DialogFooterCn>
                        <ButtonCn Variant="ButtonVariant.Outline" OnClick="@(() => _dialogOpen = false)">Cancel</ButtonCn>
                        <ButtonCn Disabled="@(string.IsNullOrWhiteSpace(_newLabel) || string.IsNullOrWhiteSpace(_newIp))"
                                  OnClick="HandleAdd">Add</ButtonCn>
                    </DialogFooterCn>
                </DialogContentCn>
            </DialogCn>
        </div>
    </div>
</section>

@code {
    private class AllowlistEntry
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string Ip { get; set; } = "";
        public string Added { get; set; } = "";
    }

    private bool _enabled = true;
    private bool _dialogOpen;
    private string _newLabel = "";
    private string _newIp = "";

    private List<AllowlistEntry> _entries =
    [
        new() { Id = "1", Label = "Office Network", Ip = "203.0.113.0/24", Added = "Jan 12, 2026" },
        new() { Id = "2", Label = "VPN Gateway", Ip = "198.51.100.42", Added = "Feb 3, 2026" },
        new() { Id = "3", Label = "Home (Alice)", Ip = "192.0.2.17", Added = "Mar 1, 2026" },
    ];

    private void HandleRemove(string id) => _entries.RemoveAll(e => e.Id == id);

    private void HandleAdd()
    {
        if (string.IsNullOrWhiteSpace(_newLabel) || string.IsNullOrWhiteSpace(_newIp)) return;
        _entries.Add(new AllowlistEntry
        {
            Id = (_entries.Count + 1).ToString(),
            Label = _newLabel.Trim(),
            Ip = _newIp.Trim(),
            Added = "Mar 15, 2026",
        });
        _newLabel = "";
        _newIp = "";
        _dialogOpen = false;
    }
}
