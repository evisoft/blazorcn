            ]),
        new("q3", "QT-2026-0037", "Sophie Andersen", "Nordic Health", "Mar 15, 2026", "Apr 15, 2026", "draft",
            [
                new("li6", "Patient portal UX audit and heuristic evaluation", 1, 2800),
                new("li7", "Wireframes for appointment booking flow (mobile + web)", 1, 3600),
