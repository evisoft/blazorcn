@* ============================================================
   Block: account-data-retention
   Title: Account Data Retention
   Description: Configure automatic data retention policies per category with customizable retention periods, retroactive application, and clean form controls
   Long Description: Data retention policy configuration
   Dependencies: ButtonCn, CheckboxCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, LucideDatabaseCn, LucideSaveCn
   Source: original/blocks/account/account-data-retention.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <LucideDatabaseCn Size="20" Class="text-muted-foreground" />
                <div>
                    <h2 class="text-sm font-medium">Data Retention</h2>
                    <p class="text-xs text-muted-foreground">
                        Configure how long data is kept before automatic deletion
                    </p>
                </div>
            </div>
        </div>

        <div class="border-b">
            @foreach (var category in _categories)
            {
                <div class="flex items-center gap-3 border-b px-4 py-3 last:border-b-0">
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@category.Name</p>
                        <p class="text-xs text-muted-foreground">@category.Description</p>
                    </div>
                    <SelectCn Value="@category.Period" ValueChanged="v => category.Period = v ?? category.Period">
                        <SelectTriggerCn aria-label="@($"{category.Name} retention period")" Class="h-8 w-[130px] text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="30d">30 days</SelectItemCn>
                            <SelectItemCn Value="90d">90 days</SelectItemCn>
                            <SelectItemCn Value="1y">1 year</SelectItemCn>
                            <SelectItemCn Value="forever">Forever</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            }
        </div>

        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <CheckboxCn aria-label="Apply to existing data" Checked="_applyToExisting" CheckedChanged="v => _applyToExisting = v" />
                <label class="text-xs text-muted-foreground cursor-pointer">Apply to existing data</label>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Class="gap-1.5">
                <LucideSaveCn Size="14" />
                Save
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private class RetentionCategory
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string Period { get; set; } = "90d";
    }

    private bool _applyToExisting;

    private readonly List<RetentionCategory> _categories =
    [
        new() { Id = "messages", Name = "Chat messages", Description = "Direct messages and channel conversations", Period = "90d" },
        new() { Id = "logs", Name = "Activity logs", Description = "Login history, API calls, and audit events", Period = "1y" },
        new() { Id = "uploads", Name = "File uploads", Description = "Images, documents, and attachments", Period = "forever" },
    ];
}
