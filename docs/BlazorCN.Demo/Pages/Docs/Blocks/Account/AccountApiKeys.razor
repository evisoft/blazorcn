@* ============================================================
   Block: account-api-keys
   Title: Account Api Keys
   Description: API key management for developers with key generation, revocation, permission scopes, usage tracking, and copy-to-clipboard functionality
   Long Description: API key management for developers
   Dependencies: BadgeCn, ButtonCn, LucideTriangleAlertCn, LucideCalendarCn, LucideCheckCn, LucideClockCn, LucideCopyCn, LucideEyeCn, LucideEyeOffCn, LucideKeyCn, LucidePlusCn, LucideTrash2Cn
   Source: original/blocks/account/account-api-keys.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <LucideKeyCn Size="20" Class="text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">API Keys</h2>
                        <p class="text-xs text-muted-foreground">
                            Manage your API keys for programmatic access
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Class="gap-2">
                    <LucidePlusCn Size="16" />
                    Create New Key
                </ButtonCn>
            </div>
        </div>

        <div class="p-4">
            <div class="space-y-2">
                <span class="text-xs font-medium text-muted-foreground">YOUR API KEYS</span>

                @foreach (var apiKey in _apiKeys)
                {
                    var scope = GetScopeLabel(apiKey.Scope);
                    var isVisible = _visibleKeyId == apiKey.Id;
                    var isCopied = _copiedKeyId == apiKey.Id;

                    <div class="group rounded-md border bg-card p-3 transition-colors hover:bg-muted/50">
                        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                            <div class="flex items-start gap-3 flex-1 min-w-0">
                                <LucideKeyCn Size="16" Class="text-muted-foreground shrink-0 mt-0.5" />
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2 flex-wrap mb-2">
                                        <span class="text-sm font-medium">@apiKey.Name</span>
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px]">
                                            @scope
                                        </BadgeCn>
                                    </div>

                                    <div class="flex items-center gap-2 mb-2">
                                        <code class="flex-1 rounded-md bg-muted/50 px-2 py-1.5 font-mono text-xs min-w-0 truncate">
                                            @(isVisible ? apiKey.Key : MaskKey(apiKey.Key))
                                        </code>
                                        <ButtonCn Size="ButtonSize.Icon" Class="h-7 w-7 shrink-0" Variant="ButtonVariant.Ghost" @onclick="() => ToggleKeyVisibility(apiKey.Id)">
                                            @if (isVisible)
                                            {
                                                <LucideEyeOffCn Size="16" Class="text-muted-foreground" />
                                            }
                                            else
                                            {
                                                <LucideEyeCn Size="16" Class="text-muted-foreground" />
                                            }
                                        </ButtonCn>
                                        <ButtonCn Size="ButtonSize.Icon" Class="h-7 w-7 shrink-0" Variant="ButtonVariant.Ghost" @onclick="() => HandleCopyKey(apiKey.Id)">
                                            @if (isCopied)
                                            {
                                                <LucideCheckCn Size="16" Class="text-emerald-500" />
                                            }
                                            else
                                            {
                                                <LucideCopyCn Size="16" Class="text-muted-foreground" />
                                            }
                                        </ButtonCn>
                                    </div>

                                    <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                                        <div class="flex items-center gap-1 rounded-md bg-muted/50 px-2 py-0.5">
                                            <LucideCalendarCn Size="12" />
                                            <span>Created @apiKey.Created</span>
                                        </div>
                                        <div class="flex items-center gap-1 rounded-md bg-muted/50 px-2 py-0.5">
                                            <LucideClockCn Size="12" />
                                            <span>Last used @apiKey.LastUsed</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <ButtonCn Size="ButtonSize.Sm" Class="gap-2" Variant="ButtonVariant.Outline">
                                <LucideTrash2Cn Size="16" />
                                Revoke
                            </ButtonCn>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ApiKeyInfo(string Id, string Name, string Key, string Created, string LastUsed, string Scope);

    private string? _visibleKeyId;
    private string? _copiedKeyId;

    private static readonly ApiKeyInfo[] _apiKeys =
    [
        new("1", "Production API", "sk_live_4f3d2e1c9b8a7f6e5d4c3b2a1", "Dec 15, 2023", "2 hours ago", "full"),
        new("2", "Mobile App", "sk_live_9a8b7c6d5e4f3a2b1c0d9e8f7", "Nov 20, 2023", "1 day ago", "read"),
        new("3", "Analytics Dashboard", "sk_live_1a2b3c4d5e6f7a8b9c0d1e2f3", "Oct 10, 2023", "5 days ago", "read"),
    ];

    private static string MaskKey(string key) =>
        $"{key[..8]}{"new string('\u2022', 12)"}{ key[^4..]}";

    private static string GetScopeLabel(string scope) => scope switch
    {
        "full" => "Full Access",
        "write" => "Read & Write",
        _ => "Read Only"
    };

    private void ToggleKeyVisibility(string keyId)
    {
        _visibleKeyId = _visibleKeyId == keyId ? null : keyId;
    }

    private async Task HandleCopyKey(string keyId)
    {
        _copiedKeyId = keyId;
        StateHasChanged();
        await Task.Delay(2000);
        _copiedKeyId = null;
    }
}
