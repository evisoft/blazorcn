@* ============================================================
   Block: account-downloads
   Title: Account Downloads
   Description: Digital downloads dashboard with purchased files, download history, license keys, file versions, and access management
   Long Description: Digital downloads management
   Dependencies: BadgeCn, ButtonCn, TabsCn, TabsContentCn, TabsListCn, TabsTriggerCn, LucideCalendarCn, LucideCircleCheckCn, LucideClockCn, LucideDownloadCn, LucideFileCodeCn, LucideFileImageCn, LucideFileTextCn, LucideKeyCn, LucidePackageCn, LucideRefreshCwCn
   Source: original/blocks/account/account-downloads.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <LucideDownloadCn Size="16" Class="text-muted-foreground" />
                <div class="flex-1">
                    <h2 class="text-sm font-medium">My Downloads</h2>
                    <p class="text-xs text-muted-foreground">
                        Access your purchased digital products and files
                    </p>
                </div>
                <div class="text-right">
                    <p class="text-2xl font-semibold tabular-nums">@_files.Length</p>
                    <p class="text-xs text-muted-foreground">Products</p>
                </div>
            </div>
        </div>

        <TabsCn Class="w-full" DefaultValue="files">
            <div class="border-b px-4">
                <TabsListCn Class="h-auto gap-4 bg-transparent p-0">
                    <TabsTriggerCn Value="files" Class="data-[state=active]:border-primary data-[state=active]:bg-transparent rounded-none border-b-2 border-transparent px-0 pb-2">
                        <LucidePackageCn Size="14" Class="mr-1.5" />
                        My Files
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="history" Class="data-[state=active]:border-primary data-[state=active]:bg-transparent rounded-none border-b-2 border-transparent px-0 pb-2">
                        <LucideClockCn Size="14" Class="mr-1.5" />
                        History
                    </TabsTriggerCn>
                </TabsListCn>
            </div>

            <TabsContentCn Value="files">
                @foreach (var file in _files)
                {
                    <div class="border-b px-4 py-3 last:border-0">
                        <div class="flex items-start gap-3">
                            @switch (file.Type)
                            {
                                case "software":
                                    <LucidePackageCn Size="16" Class="mt-0.5 shrink-0 text-muted-foreground" />
                                    break;
                                case "image":
                                    <LucideFileImageCn Size="16" Class="mt-0.5 shrink-0 text-muted-foreground" />
                                    break;
                                case "archive":
                                    <LucideFileCodeCn Size="16" Class="mt-0.5 shrink-0 text-muted-foreground" />
                                    break;
                                default:
                                    <LucideFileTextCn Size="16" Class="mt-0.5 shrink-0 text-muted-foreground" />
                                    break;
                            }

                            <div class="min-w-0 flex-1">
                                <div class="mb-1 flex items-center gap-2">
                                    <p class="text-sm font-medium">@file.Name</p>
                                    @if (file.HasUpdate)
                                    {
                                        <BadgeCn Class="h-4 border-0 bg-emerald-500/10 px-1.5 py-0 text-[10px] text-emerald-700">
                                            Update
                                        </BadgeCn>
                                    }
                                </div>

                                <p class="mb-2 text-xs text-muted-foreground">
                                    @file.Product &bull; v@@file.Version &bull; @file.Size
                                </p>

                                <div class="flex items-center gap-3 text-xs text-muted-foreground">
                                    <div class="flex items-center gap-1">
                                        <LucideCalendarCn Size="12" />
                                        <span>@file.PurchaseDate</span>
                                    </div>
                                    @if (file.DownloadLimit.HasValue)
                                    {
                                        <span>&bull;</span>
                                        <span>@file.DownloadCount/@file.DownloadLimit downloads</span>
                                    }
                                    @if (file.ExpiresAt is not null)
                                    {
                                        <span>&bull;</span>
                                        <span>Expires @file.ExpiresAt</span>
                                    }
                                </div>
                            </div>

                            <div class="flex shrink-0 items-center gap-2">
                                @if (file.LicenseKey is not null)
                                {
                                    <ButtonCn aria-label="View license key" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                                        <LucideKeyCn Size="14" />
                                    </ButtonCn>
                                }
                                @if (file.HasUpdate)
                                {
                                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                                        <LucideRefreshCwCn Size="14" Class="mr-1.5" />
                                        Update
                                    </ButtonCn>
                                }
                                else
                                {
                                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                                        <LucideDownloadCn Size="14" Class="mr-1.5" />
                                        Download
                                    </ButtonCn>
                                }
                            </div>
                        </div>
                    </div>
                }
            </TabsContentCn>

            <TabsContentCn Value="history">
                @foreach (var item in _downloadHistory)
                {
                    <div class="border-b px-4 py-3 last:border-0">
                        <div class="flex items-center gap-3">
                            <LucideCircleCheckCn Size="16" Class="shrink-0 text-emerald-500" />
                            <div class="min-w-0 flex-1">
                                <p class="text-sm font-medium">@item.FileName</p>
                                <p class="text-xs text-muted-foreground">@item.DownloadedAt</p>
                            </div>
                            <p class="shrink-0 text-xs text-muted-foreground">@item.Device</p>
                        </div>
                    </div>
                }
            </TabsContentCn>
        </TabsCn>
    </div>
</section>

@code {
    private record DownloadFile(string Id, string Name, string Product, string Version, string Size, string Type, string PurchaseDate, string? ExpiresAt, int DownloadCount, int? DownloadLimit, string? LicenseKey, bool HasUpdate);
    private record DownloadHistoryEntry(string Id, string FileName, string DownloadedAt, string Device);

    private static readonly DownloadFile[] _files =
    [
        new("1", "ProDesign Suite v3.2.1", "ProDesign Suite", "3.2.1", "2.4 GB", "software", "Oct 15, 2024", null, 2, 5, "PDSK-XXXX-XXXX-XXXX-1234", true),
        new("2", "UI Component Library", "Component Kit Pro", "2.1.0", "156 MB", "archive", "Nov 20, 2024", null, 1, null, "CKPRO-XXXX-XXXX-XXXX-5678", false),
        new("3", "Stock Photo Bundle", "Creative Assets Pack", "1.0", "890 MB", "image", "Dec 1, 2024", "Dec 1, 2025", 3, null, null, false),
    ];

    private static readonly DownloadHistoryEntry[] _downloadHistory =
    [
        new("1", "ProDesign Suite v3.2.1", "Dec 5, 2024 at 3:42 PM", "MacBook Pro"),
        new("2", "UI Component Library", "Nov 22, 2024 at 10:15 AM", "Windows PC"),
        new("3", "Stock Photo Bundle", "Dec 2, 2024 at 5:30 PM", "MacBook Pro"),
    ];
}
