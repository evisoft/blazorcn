@* ============================================================
   Block: account-login-providers
   Title: Account Login Providers
   Description: Manage authentication methods including password, magic link, SSO, and social login with primary method selection and enable/disable toggles
   Long Description: Login provider management
   Dependencies: BadgeCn, SwitchCn, LucideGithubCn, LucideKeyRoundCn, LucideMailCn, LucideShieldCn
   Source: original/blocks/account/account-login-providers.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <LucideKeyRoundCn Size="20" Class="text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Login Providers</h2>
                        <p class="text-xs text-muted-foreground">Configure how you sign in to your account</p>
                    </div>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@(_providers.Count(p => p.Enabled)) active</BadgeCn>
            </div>
        </div>

        <div>
            @foreach (var provider in _providers)
            {
                <div class="flex items-center gap-3 border-b px-4 py-3 last:border-b-0">
                    <div class="flex h-8 w-8 items-center justify-center rounded-md bg-muted text-muted-foreground shrink-0">
                        @switch (provider.Id)
                        {
                            case "password":
                                <LucideKeyRoundCn Size="16" />
                                break;
                            case "magic-link":
                                <LucideMailCn Size="16" />
                                break;
                            case "google":
                                <LucideShieldCn Size="16" />
                                break;
                            case "github":
                                <LucideGithubCn Size="16" />
                                break;
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <p class="text-sm font-medium">@provider.Name</p>
                            @if (provider.IsPrimary)
                            {
                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] h-4 px-1.5">Primary</BadgeCn>
                            }
                        </div>
                        <p class="text-xs text-muted-foreground">@provider.Description</p>
                    </div>
                    @if (provider.Enabled && !provider.IsPrimary)
                    {
                        <button class="shrink-0 text-xs text-muted-foreground hover:text-foreground transition-colors" type="button">
                            Set as primary
                        </button>
                    }
                    <SwitchCn aria-label="@provider.Name" Checked="provider.Enabled" CheckedChanged="v => provider.Enabled = v" />
                </div>
            }
        </div>
    </div>
</section>

@code {
    private class LoginProvider
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public bool Enabled { get; set; }
        public bool IsPrimary { get; set; }
    }

    private readonly List<LoginProvider> _providers =
    [
        new() { Id = "password", Name = "Password", Description = "Sign in with email and password", Enabled = true, IsPrimary = true },
        new() { Id = "magic-link", Name = "Magic Link", Description = "Passwordless sign-in via email link", Enabled = true, IsPrimary = false },
        new() { Id = "google", Name = "Google SSO", Description = "Sign in with your Google account", Enabled = true, IsPrimary = false },
        new() { Id = "github", Name = "GitHub", Description = "Sign in with your GitHub account", Enabled = false, IsPrimary = false },
    ];
}
