@* ============================================================
   Block: account-custom-domain
   Title: Account Custom Domain
   Description: Configure a custom domain for your workspace with DNS verification, CNAME records, and SSL certificate status
   Dependencies: ButtonCn, InputCn
   Source: original/blocks/account/account-custom-domain.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <LucideGlobeCn Class="h-5 w-5 text-muted-foreground" Size="20" />
                <div>
                    <h2 class="text-sm font-medium">Custom Domain</h2>
                    <p class="text-xs text-muted-foreground">Use your own domain for this workspace</p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">DOMAIN</span>
            <div class="mt-2 flex items-center gap-2">
                <InputCn Class="h-8 font-mono text-sm" placeholder="app.yourdomain.com" @bind-Value="_domain" />
                <ButtonCn Class="shrink-0 gap-1.5" Disabled="@string.IsNullOrWhiteSpace(_domain)" Size="ButtonSize.Sm">Verify</ButtonCn>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">DNS CONFIGURATION</span>
            <div class="mt-2 overflow-hidden rounded-md border">
                <table class="w-full text-xs">
                    <thead>
                        <tr class="border-b bg-muted/50">
                            <th class="px-3 py-2 text-left font-medium text-muted-foreground">Type</th>
                            <th class="px-3 py-2 text-left font-medium text-muted-foreground">Name</th>
                            <th class="px-3 py-2 text-left font-medium text-muted-foreground">Value</th>
                            <th class="px-3 py-2 text-right font-medium text-muted-foreground">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < _dnsRecords.Length; i++)
                        {
                            var record = _dnsRecords[i];
                            var index = i;
                            <tr class="border-b last:border-b-0">
                                <td class="px-3 py-2 font-mono">@record.Type</td>
                                <td class="px-3 py-2 font-mono">@record.Name</td>
                                <td class="px-3 py-2">
                                    <div class="flex items-center gap-1.5">
                                        <span class="truncate font-mono">@record.Value</span>
                                        <button type="button" class="shrink-0 text-muted-foreground transition-colors hover:text-foreground"
                                                @onclick="@(() => _copiedIndex = index)">
                                            @if (_copiedIndex == index)
                                            {
                                                <LucideCheckCn Class="h-3 w-3 text-emerald-500" Size="12" />
                                            }
                                            else
                                            {
                                                <LucideCopyCn Class="h-3 w-3" Size="12" />
                                            }
                                        </button>
                                    </div>
                                </td>
                                <td class="px-3 py-2 text-right">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <span class="@Cn.Merge("size-1.5 rounded-full", record.Status == "verified" ? "bg-emerald-500" : "bg-amber-500")"></span>
                                        <span class="capitalize">@record.Status</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">SSL CERTIFICATE</span>
            <div class="mt-2 flex items-center justify-between rounded-md border px-3 py-2">
                <div class="flex items-center gap-2">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-xs font-medium">Active</span>
                </div>
                <span class="text-xs text-muted-foreground">Expires Mar 15, 2027</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record DnsRecord(string Type, string Name, string Value, string Status);

    private string _domain = "app.acmecorp.com";
    private int? _copiedIndex;

    private static readonly DnsRecord[] _dnsRecords =
    [
        new("CNAME", "app", "cname.vercel-dns.com", "verified"),
        new("TXT", "_vercel", "vc-domain-verify=app.acmecorp.com", "pending"),
    ];
}
