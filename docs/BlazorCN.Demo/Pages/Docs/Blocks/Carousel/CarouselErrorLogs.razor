   Block: carousel-error-logs
   Title: Error Log Browser Carousel
   Description: Animated error log browser carousel slider with severity-coded entries, monospace stack traces, expandable details with AnimatePresence, and staggered row animations
   Dependencies: CarouselCn, LucideChevronRightCn
   Source: original/blocks/carousel/carousel-error-logs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Error Log Browser Carousel</span>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">3 items</span>
        </div>

        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @for (var i = 0; i < 3; i++)
                    {
                        <CarouselItemCn Class="basis-full pl-3 md:basis-1/2 lg:basis-1/3">
                            <div class="rounded-md border p-4">
                                <p class="text-sm font-medium">Item @(i + 1)</p>
                                <p class="mt-1 text-xs text-muted-foreground">Animated error log browser carousel slider with severity-coded entries, monospace stack traces, expandable details with AnimatePresence, and staggered row animations</p>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

