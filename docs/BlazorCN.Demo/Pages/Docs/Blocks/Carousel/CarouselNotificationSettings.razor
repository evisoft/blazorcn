@* ============================================================
   Block: carousel-notification-settings
   Title: Carousel Notification Settings
   Description: Notification preference settings carousel with channel icons, toggle buttons, frequency chips, and last-sent timestamps.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn, ButtonCn
   Source: original/blocks/carousel/carousel-notification-settings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideBellCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Notification settings</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                @_channels.Count(c => c.Enabled) active
            </span>
        </div>

        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var channel in _channels)
                    {
                        <CarouselItemCn Class="basis-full pl-3">
                            <div class="rounded-md border p-4">
                                <div class="mb-3 flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        @switch (channel.Icon)
                                        {
                                            case "mail": <LucideMailCn Size="16" Class="size-4 text-muted-foreground" />; break;
                                            case "smartphone": <LucideSmartphoneCn Size="16" Class="size-4 text-muted-foreground" />; break;
                                            case "message-square": <LucideMessageSquareCn Size="16" Class="size-4 text-muted-foreground" />; break;
                                            case "monitor": <LucideMonitorCn Size="16" Class="size-4 text-muted-foreground" />; break;
                                            case "bell": <LucideBellCn Size="16" Class="size-4 text-muted-foreground" />; break;
                                            case "webhook": <LucideWebhookCn Size="16" Class="size-4 text-muted-foreground" />; break;
                                        }
                                        <span class="text-sm font-medium">@channel.Name</span>
                                    </div>
                                    <ButtonCn Variant="ButtonVariant.Outline" Class="h-7 px-2 text-xs" OnClick="@(() => ToggleChannel(channel.Id))">
                                        @if (channel.Enabled)
                                        {
                                            <span class="text-emerald-600 dark:text-emerald-400">Enabled</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted-foreground">Disabled</span>
                                        }
                                    </ButtonCn>
                                </div>
                                <p class="mb-3 text-xs text-muted-foreground leading-relaxed">@channel.Description</p>
                                <div class="flex items-center gap-3">
                                    <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@channel.Frequency</span>
                                    <span class="text-xs text-muted-foreground">Last sent @channel.LastSent</span>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record NotificationChannel(string Id, string Name, string Icon, string Description, string Frequency, string LastSent, bool Enabled);

    private List<NotificationChannel> _channels =
    [
        new("ch1", "Email", "mail", "Receive digest emails with activity summaries, billing alerts, and security notifications delivered to your inbox.", "Daily", "2 hours ago", true),
        new("ch2", "Push Notifications", "smartphone", "Real-time mobile push notifications for mentions, direct messages, and critical system alerts on your device.", "Instant", "15 min ago", true),
        new("ch3", "SMS", "message-square", "Text message alerts for security events, two-factor authentication codes, and payment confirmations.", "Instant", "3 days ago", false),
        new("ch4", "Slack", "monitor", "Channel notifications in your Slack workspace for team activity, deployment status, and integration events.", "Hourly", "45 min ago", true),
        new("ch5", "In-App", "bell", "Notification center within the application for all activity types including comments, assignments, and system updates.", "Instant", "5 min ago", true),
        new("ch6", "Webhook", "webhook", "HTTP POST callbacks to your endpoint for programmatic integration with external systems and custom automation workflows.", "Weekly", "1 week ago", false)
    ];

    private void ToggleChannel(string id)
    {
        var idx = _channels.FindIndex(c => c.Id == id);
        if (idx >= 0)
        {
            var ch = _channels[idx];
            _channels[idx] = ch with { Enabled = !ch.Enabled };
        }
    }
}
