@* ============================================================
   Block: carousel-server-status
   Title: Carousel Server Status
   Description: Server status dashboard carousel with uptime percentages, status indicators, response times, and region labels.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/carousel/carousel-server-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideServerCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Infrastructure</p>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-xs text-muted-foreground">All systems operational</span>
            </div>
        </div>
        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var server in _servers)
                    {
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/3">
                            <div class="rounded-md border p-3">
                                <div class="mb-2 flex items-center justify-between">
                                    <span class="font-medium text-sm">@server.Name</span>
                                    <div class="flex items-center gap-1.5">
                                        <span class="@Cn.Merge("size-1.5 rounded-full", _statusDot[server.Status])"></span>
                                        <span class="text-xs text-muted-foreground capitalize">@server.Status</span>
                                    </div>
                                </div>
                                <span class="text-xs text-muted-foreground">@server.Region</span>
                                <div class="mt-3 flex items-center justify-between">
                                    <div>
                                        <p class="text-xl font-semibold tabular-nums">@(server.Uptime)%</p>
                                        <p class="text-xs text-muted-foreground">Uptime (30d)</p>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-xl font-semibold tabular-nums">@(server.ResponseTime)ms</p>
                                        <p class="text-xs text-muted-foreground">Avg response</p>
                                    </div>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Server(string Id, string Name, string Region, string Status, double Uptime, int ResponseTime);

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["operational"] = "bg-emerald-500", ["degraded"] = "bg-amber-500", ["down"] = "bg-red-500"
    };

    private readonly Server[] _servers =
    [
        new("s1", "API Gateway", "us-east-1", "operational", 99.99, 12),
        new("s2", "Database Primary", "us-east-1", "operational", 99.97, 4),
        new("s3", "CDN Edge", "global", "operational", 100.0, 8),
        new("s4", "Worker Pool", "us-west-2", "operational", 99.95, 45),
        new("s5", "Auth Service", "eu-west-1", "degraded", 99.82, 28),
        new("s6", "Search Index", "ap-southeast-1", "operational", 99.91, 18)
    ];
}
