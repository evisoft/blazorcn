@* ============================================================
   Block: carousel-release-channels
   Title: Carousel Release Channels
   Description: Release channels carousel with channel cards, version numbers, stability indicators, and feature lists.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn, ButtonCn
   Source: original/blocks/carousel/carousel-release-channels.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Release channels</span>
            <span class="text-muted-foreground text-xs">@_channels.Length channels</span>
        </div>
        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var channel in _channels)
                    {
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/4">
                            <div class="@Cn.Merge("flex h-full flex-col rounded-md border p-3", channel.IsCurrent ? "border-foreground" : "")">
                                <div class="mb-2 flex items-center justify-between">
                                    <span class="font-medium text-sm">@channel.Name</span>
                                    @if (channel.IsCurrent)
                                    {
                                        <span class="rounded bg-foreground px-1.5 py-0.5 text-xs text-background">Current</span>
                                    }
                                </div>
                                <div class="mb-1 flex items-center gap-2">
                                    <span class="font-mono text-xs text-muted-foreground">@channel.Version</span>
                                    <span class="@Cn.Merge("size-1.5 rounded-full", _stabilityDot[channel.Stability])"></span>
                                    <span class="text-xs text-muted-foreground">@channel.Stability</span>
                                </div>
                                <p class="mb-3 flex-1 text-xs text-muted-foreground leading-relaxed">@channel.Description</p>
                                <ButtonCn Variant="@(channel.IsCurrent ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Sm" Class="h-7 w-full text-xs" Disabled="@channel.IsCurrent">
                                    @(channel.IsCurrent ? "Active" : "Switch channel")
                                </ButtonCn>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record ReleaseChannel(string Id, string Name, string Version, string Stability, string Description, bool IsCurrent);

    private static readonly Dictionary<string, string> _stabilityDot = new()
    {
        ["Stable"] = "bg-emerald-500", ["Beta"] = "bg-amber-500", ["Alpha"] = "bg-red-500", ["Nightly"] = "bg-purple-500"
    };

    private readonly ReleaseChannel[] _channels =
    [
        new("c1", "Stable", "v2.4.1", "Stable", "Production-ready releases with full testing, security patches, and long-term support.", true),
        new("c2", "Beta", "v2.5.0-beta.3", "Beta", "Feature-complete pre-releases for early testing. May contain minor bugs.", false),
        new("c3", "Alpha", "v3.0.0-alpha.1", "Alpha", "Early access to upcoming major features. Not recommended for production use.", false),
        new("c4", "Nightly", "v3.0.0-dev.428", "Nightly", "Automated builds from main branch. Highly experimental and may break at any time.", false)
    ];
}
