@* ============================================================
   Block: carousel-partner-showcase
   Title: Carousel Partner Showcase
   Description: Partner and ecosystem showcase carousel with partnership type chips, featured project highlights, and company descriptions.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn, ButtonCn
   Source: original/blocks/carousel/carousel-partner-showcase.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Partners</span>
            <span class="text-muted-foreground text-xs">@_partners.Length partners</span>
        </div>

        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var partner in _partners)
                    {
                        <CarouselItemCn Class="basis-[80%] pl-3 sm:basis-1/2 lg:basis-1/3">
                            <div class="overflow-hidden rounded-md border">
                                <div class="px-3 py-3">
                                    <div class="mb-2 flex items-center gap-2.5">
                                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@partner.Initials</div>
                                        <div class="min-w-0">
                                            <span class="block font-medium text-sm">@partner.Name</span>
                                        </div>
                                    </div>
                                    <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@partner.Type</span>
                                </div>
                                <div class="border-t px-3 py-3">
                                    <p class="text-muted-foreground text-xs leading-relaxed">@partner.Description</p>
                                </div>
                                <div class="border-t px-3 py-3">
                                    <span class="mb-1 block font-medium text-muted-foreground text-xs">Featured project</span>
                                    <p class="text-xs leading-relaxed">@partner.FeaturedProject</p>
                                </div>
                                <div class="border-t px-3 py-2.5">
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                                        Learn more
                                        <LucideArrowRightCn Size="16" Class="size-3" />
                                    </ButtonCn>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Partner(string Id, string Name, string Type, string Description, string FeaturedProject, string Initials);

    private readonly Partner[] _partners =
    [
        new("p1", "Vercel", "Technology", "Frontend cloud platform powering deployments, edge functions, and analytics.", "Zero-downtime preview deployments with automatic branch environments.", "VC"),
        new("p2", "Neon", "Technology", "Serverless Postgres with branching, autoscaling, and a generous free tier.", "Database branching for every pull request with automatic schema diffing.", "NE"),
        new("p3", "Raycast", "Integration", "Productivity launcher with custom extensions and script commands.", "Custom extension for instant component search and documentation lookup.", "RC"),
        new("p4", "Acme Digital", "Agency", "Full-service digital agency specializing in SaaS product design and launch.", "Built 14 client dashboards using the component library in 2025.", "AD"),
        new("p5", "StackSync", "Reseller", "Enterprise software distributor serving the APAC region with localized support.", "Onboarded 200+ enterprise teams across Japan, Singapore, and Australia.", "SS"),
        new("p6", "Linear", "Integration", "Issue tracking and project management with real-time sync and keyboard-first UX.", "Two-way sync integration linking component issues to Linear projects.", "LN"),
        new("p7", "Supabase", "Technology", "Open source Firebase alternative with auth, storage, and real-time database.", "Auth adapter and real-time subscription hooks for component demos.", "SB"),
        new("p8", "Pixel Studio", "Agency", "Boutique design studio focused on developer tools and technical documentation.", "Redesigned the documentation portal with improved navigation and search.", "PS")
    ];
}
