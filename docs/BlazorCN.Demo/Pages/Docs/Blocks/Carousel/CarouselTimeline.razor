@* ============================================================
   Block: carousel-timeline
   Title: Carousel Timeline
   Description: Timeline carousel with chronological event cards, date labels, and milestone markers.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/carousel/carousel-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Company Timeline</span>
            <span class="text-muted-foreground text-xs">@_events.Length milestones</span>
        </div>
        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var evt in _events)
                    {
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/3">
                            <div class="flex h-full flex-col rounded-md border p-3">
                                <div class="mb-2 flex items-center gap-2">
                                    <span class="@Cn.Merge("size-2 rounded-full", evt.IsMilestone ? "bg-foreground" : "bg-muted-foreground/30")"></span>
                                    <span class="font-mono text-xs text-muted-foreground">@evt.Date</span>
                                    @if (evt.IsMilestone)
                                    {
                                        <span class="rounded bg-foreground px-1.5 py-0.5 text-xs text-background">Milestone</span>
                                    }
                                </div>
                                <p class="mb-1 text-sm font-medium">@evt.Title</p>
                                <p class="flex-1 text-xs text-muted-foreground leading-relaxed">@evt.Description</p>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record TimelineEvent(string Id, string Date, string Title, string Description, bool IsMilestone);

    private readonly TimelineEvent[] _events =
    [
        new("e1", "Jan 2024", "Company Founded", "Started as a two-person team building developer tools in a San Francisco apartment.", true),
        new("e2", "Apr 2024", "Seed Funding", "Raised $2.4M seed round led by Y Combinator to accelerate product development.", true),
        new("e3", "Jul 2024", "Public Beta", "Launched public beta with 500 early access users providing daily feedback.", false),
        new("e4", "Oct 2024", "1,000 Users", "Crossed 1,000 active users milestone with zero paid marketing spend.", true),
        new("e5", "Feb 2025", "Series A", "Closed $18M Series A to expand the team and launch enterprise features.", true),
        new("e6", "Jun 2025", "V2 Launch", "Released v2.0 with complete redesign, 50 new components, and dark mode support.", true),
        new("e7", "Dec 2025", "10,000 Users", "Reached 10,000 active users across 42 countries with 99.99% uptime.", true),
        new("e8", "Mar 2026", "Enterprise Launch", "Launched enterprise tier with SSO, audit logs, and dedicated support.", false)
    ];
}
