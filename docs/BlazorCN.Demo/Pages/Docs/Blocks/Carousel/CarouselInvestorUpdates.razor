@* ============================================================
   Block: carousel-investor-updates
   Title: Investor Updates Carousel
   Description: Animated investor quarterly update carousel slider with revenue figures, growth percentages, customer counts, ARR metrics, key highlights, and animated metric bars
   Dependencies: CarouselCn, LucideTrendingUpCn
   Source: original/blocks/carousel/carousel-investor-updates.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Investor Updates Carousel</span>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">3 items</span>
        </div>

        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @for (var i = 0; i < 3; i++)
                    {
                        <CarouselItemCn Class="basis-full pl-3 md:basis-1/2 lg:basis-1/3">
                            <div class="rounded-md border p-4">
                                <p class="text-sm font-medium">Item @(i + 1)</p>
                                <p class="mt-1 text-xs text-muted-foreground">Animated investor quarterly update carousel slider with revenue figures, growth percentages, customer counts, ARR metrics, key highlights, and animated metric bars</p>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

