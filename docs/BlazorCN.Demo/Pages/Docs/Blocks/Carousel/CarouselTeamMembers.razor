@* ============================================================
   Block: carousel-team-members
   Title: Carousel Team Members
   Description: Team member cards carousel with initials avatars, role labels, department chips, and contact actions.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn, ButtonCn
   Source: original/blocks/carousel/carousel-team-members.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideUsersCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Team</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@_members.Length members</span>
        </div>
        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var member in _members)
                    {
                        <CarouselItemCn Class="basis-[60%] pl-3 sm:basis-1/3 lg:basis-1/4">
                            <div class="flex h-full flex-col items-center rounded-md border p-3 text-center">
                                <div class="mb-2 flex size-12 items-center justify-center rounded-full bg-muted text-sm font-medium">@member.Initials</div>
                                <p class="mb-0.5 text-sm font-medium">@member.Name</p>
                                <p class="mb-2 text-xs text-muted-foreground">@member.Role</p>
                                <span class="mb-3 rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@member.Department</span>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="mt-auto h-7 w-full text-xs">
                                    <LucideMailCn Size="16" Class="size-3" />
                                    Contact
                                </ButtonCn>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record TeamMember(string Id, string Name, string Initials, string Role, string Department);

    private readonly TeamMember[] _members =
    [
        new("m1", "Sarah Chen", "SC", "Engineering Lead", "Engineering"),
        new("m2", "Marcus Rivera", "MR", "Product Designer", "Design"),
        new("m3", "Aisha Patel", "AP", "Backend Engineer", "Engineering"),
        new("m4", "Liam Bennett", "LB", "DevOps Engineer", "Infrastructure"),
        new("m5", "Yuki Tanaka", "YT", "Frontend Engineer", "Engineering"),
        new("m6", "Carlos Mendez", "CM", "Product Manager", "Product"),
        new("m7", "Nia Washington", "NW", "QA Engineer", "Engineering"),
        new("m8", "Elena Kowalski", "EK", "UX Researcher", "Design")
    ];
}
