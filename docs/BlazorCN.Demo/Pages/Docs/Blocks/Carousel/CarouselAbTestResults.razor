@* ============================================================
   Block: carousel-ab-test-results
   Title: CarouselAbTestResults
   Description: Animated A/B test experiment results carousel slider for React and Next.js with variant comparison bars, conversion rates, winner indicators, confidence levels, sample sizes, and status chips using shadcn/ui Carousel, framer-motion, and Tailwind CSS
   Source: original/blocks/carousel/carousel-ab-test-results.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">A/B test results</span>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                @_experiments.Length experiments
            </span>
        </div>

        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var exp in _experiments)
                    {
                        var maxRate = Math.Max(exp.VariantA.ConversionRate, exp.VariantB.ConversionRate);
                        <CarouselItemCn Class="basis-full pl-3">
                            <div class="rounded-md border">
                                <div class="border-b px-4 py-3">
                                    <div class="flex items-center justify-between">
                                        <span class="font-medium text-sm">@exp.Name</span>
                                        <span class="@Cn.Merge("rounded px-1.5 py-0.5 text-xs", exp.Status == "Completed" ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : "bg-blue-500/10 text-blue-600 dark:text-blue-400")">
                                            @exp.Status
                                        </span>
                                    </div>
                                    <p class="mt-0.5 text-muted-foreground text-xs">@exp.Description</p>
                                </div>

                                <div class="space-y-3 px-4 py-3">
                                    @foreach (var (variant, label) in new[] { (exp.VariantA, "A"), (exp.VariantB, "B") })
                                    {
                                        var isWinner = exp.Winner == label;
                                        var barWidth = maxRate > 0 ? (variant.ConversionRate / maxRate) * 100 : 0;
                                        <div>
                                            <div class="flex items-center justify-between">
                                                <div class="flex items-center gap-2">
                                                    @if (isWinner)
                                                    {
                                                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                                    }
                                                    <span class="@Cn.Merge("text-xs", isWinner ? "font-medium" : "text-muted-foreground")">
                                                        @label: @variant.Name
                                                    </span>
                                                </div>
                                                <span class="@Cn.Merge("font-semibold text-xl tabular-nums", isWinner ? "text-emerald-600 dark:text-emerald-400" : "")">
                                                    @(variant.ConversionRate)%
                                                </span>
                                            </div>
                                            <div class="mt-1.5 h-2 w-full rounded-full bg-muted">
                                                <div class="@Cn.Merge("h-full rounded-full", isWinner ? "bg-emerald-500" : "bg-muted-foreground/30")" style="@(FormattableString.Invariant($"width: {barWidth:F1}%"))"></div>
                                            </div>
                                            <div class="mt-1 flex items-center gap-2 text-muted-foreground text-xs">
                                                <span class="tabular-nums">@variant.Conversions.ToString("N0") conversions</span>
                                                <span class="text-muted-foreground/40">·</span>
                                                <span class="tabular-nums">@variant.Visitors.ToString("N0") visitors</span>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="flex items-center justify-between border-t px-4 py-2.5">
                                    <span class="text-muted-foreground text-xs">
                                        Confidence: <span class="tabular-nums">@(exp.Confidence)%</span>
                                    </span>
                                    <span class="text-muted-foreground text-xs">
                                        Total: <span class="tabular-nums">@((exp.VariantA.Visitors + exp.VariantB.Visitors).ToString("N0"))</span> visitors
                                    </span>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Variant(string Name, double ConversionRate, int Visitors, int Conversions);
    private record Experiment(string Id, string Name, string Description, Variant VariantA, Variant VariantB, string? Winner, double Confidence, string Status);

    private readonly Experiment[] _experiments =
    [
        new("exp1", "Checkout button color", "Testing emerald vs blue CTA on checkout page",
            new("Emerald CTA", 4.2, 24800, 1042),
            new("Blue CTA", 5.1, 24650, 1257),
            "B", 97.3, "Completed"),
        new("exp2", "Pricing page layout", "Horizontal cards vs vertical comparison table",
            new("Card layout", 3.8, 18200, 692),
            new("Table layout", 3.2, 18400, 589),
            "A", 94.1, "Completed"),
        new("exp3", "Onboarding flow length", "3-step vs 5-step onboarding wizard",
            new("3 steps", 68.4, 5200, 3557),
            new("5 steps", 61.2, 5100, 3121),
            "A", 99.1, "Completed"),
        new("exp4", "Hero headline copy", "Benefit-driven vs feature-driven headline",
            new("Benefit copy", 2.9, 12400, 360),
            new("Feature copy", 3.1, 12200, 378),
            null, 72.8, "Running"),
    ];
}
