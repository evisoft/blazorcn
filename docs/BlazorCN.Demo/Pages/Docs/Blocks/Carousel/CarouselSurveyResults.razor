@* ============================================================
   Block: carousel-survey-results
   Title: Carousel Survey Results
   Description: Survey results carousel with question cards, response percentages, bar charts, and total respondent counts.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/carousel/carousel-survey-results.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Survey Results</span>
            <span class="text-muted-foreground text-xs">@_questions.Length questions · @_totalRespondents respondents</span>
        </div>
        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var question in _questions)
                    {
                        <CarouselItemCn Class="basis-full pl-3">
                            <div class="rounded-md border p-4">
                                <p class="mb-4 text-sm font-medium">@question.Text</p>
                                <div class="space-y-3">
                                    @foreach (var option in question.Options)
                                    {
                                        <div>
                                            <div class="mb-1 flex items-center justify-between">
                                                <span class="text-xs">@option.Label</span>
                                                <span class="font-medium text-xs tabular-nums">@(option.Percent)%</span>
                                            </div>
                                            <div class="h-2 w-full overflow-hidden rounded-full bg-muted">
                                                <div class="h-full rounded-full bg-foreground" style="@("width: " + option.Percent + "%")"></div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record SurveyOption(string Label, int Percent);
    private record SurveyQuestion(string Id, string Text, SurveyOption[] Options);

    private int _totalRespondents = 2847;

    private readonly SurveyQuestion[] _questions =
    [
        new("q1", "How satisfied are you with the product?", [new("Very satisfied", 42), new("Satisfied", 31), new("Neutral", 15), new("Dissatisfied", 8), new("Very dissatisfied", 4)]),
        new("q2", "Which feature do you use most?", [new("Dashboard", 38), new("Analytics", 27), new("Integrations", 20), new("API", 15)]),
        new("q3", "How likely are you to recommend us?", [new("Very likely", 45), new("Likely", 28), new("Neutral", 16), new("Unlikely", 7), new("Very unlikely", 4)])
    ];
}
