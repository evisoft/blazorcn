@* ============================================================
   Block: carousel-press-mentions
   Title: Carousel Press Mentions
   Description: Press mentions carousel with publication names, article titles, quotes, and dates.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn, ButtonCn
   Source: original/blocks/carousel/carousel-press-mentions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideNewspaperCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Press</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@_mentions.Length mentions</span>
        </div>

        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var mention in _mentions)
                    {
                        <CarouselItemCn Class="basis-full pl-3 sm:basis-1/2 lg:basis-1/3">
                            <div class="flex h-full flex-col rounded-md border p-3">
                                <div class="mb-2 flex items-center gap-2">
                                    <span class="rounded bg-muted px-1.5 py-0.5 text-xs font-medium text-muted-foreground">@mention.Publication</span>
                                    <span class="text-xs text-muted-foreground">@mention.Date</span>
                                </div>
                                <p class="mb-2 text-sm font-medium leading-snug">@mention.Title</p>
                                <p class="mb-3 flex-1 text-xs text-muted-foreground leading-relaxed italic">"@mention.Quote"</p>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-full gap-1.5 text-xs">
                                    <LucideExternalLinkCn Size="16" Class="size-3" />
                                    Read article
                                </ButtonCn>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record PressMention(string Id, string Publication, string Title, string Quote, string Date);

    private readonly PressMention[] _mentions =
    [
        new("pm1", "TechCrunch", "The New Wave of Component Libraries", "A refreshingly opinionated approach to building UI components that prioritizes developer experience without sacrificing flexibility.", "Mar 12, 2026"),
        new("pm2", "The Verge", "Tools That Changed How We Build", "One of the most impactful developer tools released in the past year, fundamentally changing the component development workflow.", "Feb 28, 2026"),
        new("pm3", "Wired", "Open Source That Ships", "What sets this project apart is the relentless focus on shipping quality over accumulating features nobody asked for.", "Feb 15, 2026"),
        new("pm4", "Fast Company", "Design Engineering Comes of Age", "The bridge between design and engineering that the industry has been waiting for, delivered with remarkable polish.", "Jan 30, 2026"),
        new("pm5", "Bloomberg", "The Business of Developer Tools", "With adoption growing 400% year-over-year, it is quickly becoming the default choice for teams building modern web applications.", "Jan 18, 2026"),
        new("pm6", "MIT Technology Review", "Simplicity as a Feature", "In an era of over-engineered solutions, this project proves that the best developer tools are the ones that get out of your way.", "Jan 5, 2026")
    ];
}
