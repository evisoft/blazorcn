@* ============================================================
   Block: carousel-social-proof
   Title: Carousel Social Proof
   Description: Social proof testimonial carousel with customer quotes, company names, and role descriptions.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/carousel/carousel-social-proof.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">What our customers say</span>
            <span class="text-muted-foreground text-xs">@_testimonials.Length reviews</span>
        </div>
        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var t in _testimonials)
                    {
                        <CarouselItemCn Class="basis-full pl-3 sm:basis-1/2 lg:basis-1/3">
                            <div class="flex h-full flex-col rounded-md border p-3">
                                <div class="mb-3 flex items-center gap-1">
                                    @for (var i = 0; i < t.Rating; i++)
                                    {
                                        <LucideStarCn Size="16" Class="size-3 fill-amber-400 text-amber-400" />
                                    }
                                </div>
                                <p class="mb-3 flex-1 text-xs leading-relaxed italic">"@t.Quote"</p>
                                <div class="flex items-center gap-2">
                                    <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@t.Initials</div>
                                    <div>
                                        <p class="text-xs font-medium">@t.Name</p>
                                        <p class="text-xs text-muted-foreground">@t.Role, @t.Company</p>
                                    </div>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Name, string Initials, string Role, string Company, string Quote, int Rating);

    private readonly Testimonial[] _testimonials =
    [
        new("t1", "Sarah Chen", "SC", "Engineering Lead", "Vercel", "Reduced our component development time by 60%. The API design is exactly what we needed.", 5),
        new("t2", "Marcus Rivera", "MR", "CTO", "Linear", "Finally a component library that respects performance budgets. Our bundle size dropped significantly.", 5),
        new("t3", "Aisha Patel", "AP", "Design Engineer", "Stripe", "The theming system is incredibly flexible. We matched our brand perfectly in under an hour.", 5),
        new("t4", "Liam Bennett", "LB", "Senior Developer", "Shopify", "Best developer experience I have encountered in a component library. The docs are outstanding.", 4),
        new("t5", "Yuki Tanaka", "YT", "Product Designer", "Figma", "The accessibility defaults are production-ready. We passed our WCAG audit without any custom work.", 5),
        new("t6", "Carlos Mendez", "CM", "Frontend Architect", "Notion", "Migrated from our in-house system in two weeks. The migration guide made it painless.", 4)
    ];
}
