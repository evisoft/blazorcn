@* ============================================================
   Block: carousel-changelog-timeline
   Title: Animated Changelog Timeline Carousel
   Description: Changelog timeline carousel with connected version dots, release notes, and type chips
   Dependencies: CarouselCn
   Source: original/blocks/carousel/carousel-changelog-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideGitBranchCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Changelog</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                @_versions[0].Version
            </span>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center">
                @for (var vi = 0; vi < _versions.Length; vi++)
                {
                    var v = _versions[vi];
                    var isLast = vi == _versions.Length - 1;
                    <div class="@(isLast ? "flex flex-none items-center" : "flex flex-1 items-center")">
                        <div class="flex flex-col items-center gap-1">
                            <span class="size-2.5 rounded-full bg-muted-foreground/30"></span>
                            <span class="text-xs text-muted-foreground">@v.Version</span>
                        </div>
                        @if (!isLast)
                        {
                            <div class="mb-4 h-px flex-1 bg-muted"></div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var version in _versions)
                    {
                        var typeStyle = version.Type switch
                        {
                            "Feature" => "bg-blue-500/10 text-blue-600 dark:text-blue-400",
                            "Fix" => "bg-red-500/10 text-red-600 dark:text-red-400",
                            "Improvement" => "bg-amber-500/10 text-amber-600 dark:text-amber-400",
                            _ => "bg-muted text-muted-foreground",
                        };
                        <CarouselItemCn Class="basis-full pl-3">
                            <div class="rounded-md border p-4">
                                <div class="mb-3 flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        <span class="rounded bg-foreground px-1.5 py-0.5 text-xs font-medium text-background">@version.Version</span>
                                        <span class="text-xs text-muted-foreground">@version.Date</span>
                                    </div>
                                    <span class="@Cn.Merge("rounded px-1.5 py-0.5 text-xs", typeStyle)">@version.Type</span>
                                </div>

                                <p class="mb-3 text-sm font-medium">@version.Title</p>

                                <div class="space-y-2">
                                    @foreach (var change in version.Changes)
                                    {
                                        <div class="flex items-start gap-2">
                                            <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-muted-foreground/40"></span>
                                            <span class="text-xs text-muted-foreground leading-relaxed">@change</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record VersionItem(string Id, string Version, string Title, string Date, string Type, string[] Changes);

    private static readonly VersionItem[] _versions =
    [
        new("v1", "v3.0.0", "Platform Rewrite", "Mar 10, 2026", "Feature",
            ["Complete migration from REST to GraphQL federation", "New real-time sync engine with CRDT conflict resolution", "Redesigned component library with 60 new primitives", "Edge-first deployment with sub-50ms global latency"]),
        new("v2", "v2.8.0", "Enterprise SSO", "Feb 18, 2026", "Feature",
            ["SAML 2.0 and OpenID Connect single sign-on support", "SCIM 2.0 user provisioning and de-provisioning", "Audit log export with SOC 2 compliance fields"]),
        new("v3", "v2.7.2", "Performance Patch", "Feb 5, 2026", "Fix",
            ["Fixed memory leak in WebSocket connection pool manager", "Resolved N+1 query in dashboard aggregation pipeline", "Corrected timezone drift in scheduled report delivery"]),
        new("v4", "v2.7.0", "Workflow Automation", "Jan 22, 2026", "Feature",
            ["Visual workflow builder with conditional branching logic", "Webhook trigger nodes with retry and dead-letter queues", "Template library with 25 pre-built automation recipes"]),
        new("v5", "v2.6.1", "Dashboard Polish", "Jan 8, 2026", "Improvement",
            ["Reduced initial bundle size by 22 percent with code splitting", "Improved skeleton loading states across all dashboard views", "Standardized spacing and typography tokens for consistency"]),
        new("v6", "v2.6.0", "API v2 Launch", "Dec 15, 2025", "Feature",
            ["RESTful API v2 with OpenAPI 3.1 specification and SDK generation", "Rate limiting with configurable per-key quotas and burst allowances", "Interactive API explorer embedded in the developer dashboard", "Webhook signature verification with automatic key rotation"]),
    ];
}
