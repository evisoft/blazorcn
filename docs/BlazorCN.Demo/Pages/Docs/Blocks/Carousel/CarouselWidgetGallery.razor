@* ============================================================
   Block: carousel-widget-gallery
   Title: Carousel Widget Gallery
   Description: Widget gallery carousel with dashboard widget cards, preview placeholders, sizing options, and category labels.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn, ButtonCn
   Source: original/blocks/carousel/carousel-widget-gallery.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideLayoutGridCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Widget Gallery</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@_widgets.Length widgets</span>
        </div>
        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var widget in _widgets)
                    {
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/3">
                            <div class="flex h-full flex-col overflow-hidden rounded-md border">
                                <div class="flex aspect-[4/3] items-center justify-center bg-muted">
                                    <LucideLayoutGridCn Size="24" Class="size-6 text-muted-foreground/40" />
                                </div>
                                <div class="flex flex-1 flex-col p-3">
                                    <div class="mb-2 flex items-center gap-2">
                                        <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@widget.Category</span>
                                        <span class="text-xs text-muted-foreground">@widget.Size</span>
                                    </div>
                                    <p class="mb-1 text-sm font-medium">@widget.Name</p>
                                    <p class="mb-3 flex-1 text-xs text-muted-foreground leading-relaxed">@widget.Description</p>
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 w-full text-xs">Add to dashboard</ButtonCn>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Widget(string Id, string Name, string Category, string Size, string Description);

    private readonly Widget[] _widgets =
    [
        new("w1", "Revenue Chart", "Analytics", "2x1", "Real-time revenue tracking with daily, weekly, and monthly breakdowns."),
        new("w2", "Active Users", "Metrics", "1x1", "Live count of active users with trend sparkline and comparison period."),
        new("w3", "Recent Activity", "Feed", "1x2", "Scrollable feed of recent team activity including commits and deployments."),
        new("w4", "Server Health", "Infrastructure", "2x1", "CPU, memory, and disk usage across all production servers."),
        new("w5", "Conversion Funnel", "Analytics", "2x2", "Visual funnel showing drop-off rates at each stage of the user journey."),
        new("w6", "Quick Actions", "Utility", "1x1", "Shortcut buttons for common actions like deploy, restart, and clear cache.")
    ];
}
