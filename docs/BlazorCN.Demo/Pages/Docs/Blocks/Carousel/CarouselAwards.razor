@* ============================================================
   Block: carousel-awards
   Title: Animated Awards Recognition Carousel
   Description: Awards and recognition carousel with award badges, issuing organizations, year indicators, and descriptions
   Dependencies: CarouselCn
   Source: original/blocks/carousel/carousel-awards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Recognition</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Industry awards and certifications</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                @_awards.Length awards
            </span>
        </div>

        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var award in _awards)
                    {
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/3">
                            <div class="flex h-full flex-col rounded-md bg-muted/30 p-3">
                                <div class="mb-3 flex items-center justify-between">
                                    <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                                        @switch (award.Icon)
                                        {
                                            case "trophy":
                                                <LucideTrophyCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "rocket":
                                                <LucideRocketCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "shield-check":
                                                <LucideShieldCheckCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "star":
                                                <LucideStarCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "sparkles":
                                                <LucideSparklesCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "zap":
                                                <LucideZapCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "award":
                                                <LucideAwardCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                        }
                                    </div>
                                    <span class="text-xs tabular-nums text-muted-foreground">@award.Year</span>
                                </div>

                                <p class="text-sm font-medium">@award.Name</p>
                                <p class="mt-0.5 text-xs text-muted-foreground">@award.Organization</p>

                                <p class="mt-2 flex-1 text-xs leading-relaxed text-muted-foreground">@award.Description</p>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record AwardItem(string Id, string Name, string Organization, string Year, string Description, string Icon);

    private static readonly AwardItem[] _awards =
    [
        new("g2-leader", "Leader", "G2", "2025", "Ranked #1 in Developer Tools category based on user reviews.", "trophy"),
        new("product-hunt", "#1 Product of the Day", "Product Hunt", "2025", "Most upvoted launch in Developer Tools with 2,400+ votes.", "rocket"),
        new("soc2", "SOC 2 Type II", "AICPA", "2024", "Certified for security, availability, and confidentiality controls.", "shield-check"),
        new("forbes", "Cloud 100", "Forbes", "2025", "Named to the top 100 private cloud companies worldwide.", "star"),
        new("gartner", "Cool Vendor", "Gartner", "2024", "Recognized for innovative approach to developer experience.", "sparkles"),
        new("techcrunch", "Disrupt Finalist", "TechCrunch", "2024", "Selected as a top-5 finalist in the SaaS infrastructure category.", "zap"),
        new("yc", "Top Company", "Y Combinator", "2024", "Featured in the YC Top Companies list by revenue growth.", "award"),
        new("iso", "ISO 27001", "ISO", "2025", "Certified information security management system across all services.", "shield-check"),
    ];
}
