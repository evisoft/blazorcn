@* ============================================================
   Block: carousel-tech-stack
   Title: Carousel Tech Stack
   Description: Technology stack carousel with category chips, version badges, adoption status indicators, and tech descriptions.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/carousel/carousel-tech-stack.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Tech Stack</span>
            <span class="text-muted-foreground text-xs">@_technologies.Length technologies</span>
        </div>
        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var tech in _technologies)
                    {
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/3">
                            <div class="flex h-full flex-col rounded-md border p-3">
                                <div class="mb-2 flex items-center justify-between">
                                    <span class="font-medium text-sm">@tech.Name</span>
                                    <div class="flex items-center gap-1.5">
                                        <span class="@Cn.Merge("size-1.5 rounded-full", _statusDot[tech.Status])"></span>
                                        <span class="text-xs text-muted-foreground capitalize">@tech.Status</span>
                                    </div>
                                </div>
                                <div class="mb-2 flex items-center gap-2">
                                    <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@tech.Category</span>
                                    <span class="font-mono text-xs text-muted-foreground">@tech.Version</span>
                                </div>
                                <p class="flex-1 text-xs text-muted-foreground leading-relaxed">@tech.Description</p>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Technology(string Id, string Name, string Category, string Version, string Description, string Status);

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["production"] = "bg-emerald-500", ["evaluation"] = "bg-amber-500", ["deprecated"] = "bg-red-500"
    };

    private readonly Technology[] _technologies =
    [
        new("t1", "React", "Frontend", "19.1.0", "Core UI library powering all client-side rendering with server components support.", "production"),
        new("t2", "Next.js", "Frontend", "16.2.0", "Full-stack framework for routing, SSR, caching, and API layer with App Router.", "production"),
        new("t3", "PostgreSQL", "Database", "16.4", "Primary relational database for transactional data, user records, and audit logs.", "production"),
        new("t4", "Redis", "Database", "7.2", "In-memory store for session caching, rate limiting, and real-time pub/sub events.", "production"),
        new("t5", "Kubernetes", "Infrastructure", "1.31", "Container orchestration for all production services with auto-scaling.", "production"),
        new("t6", "Drizzle ORM", "Backend", "0.36.0", "TypeScript-first ORM under evaluation to replace Prisma for better edge compatibility.", "evaluation")
    ];
}
