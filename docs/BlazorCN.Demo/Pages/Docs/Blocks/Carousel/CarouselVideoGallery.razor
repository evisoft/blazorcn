@* ============================================================
   Block: carousel-video-gallery
   Title: Carousel Video Gallery
   Description: Video gallery carousel with thumbnail placeholders, play buttons, duration badges, and view counts.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/carousel/carousel-video-gallery.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucidePlayCircleCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Video Gallery</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@_videos.Length videos</span>
        </div>
        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var video in _videos)
                    {
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/3">
                            <div class="overflow-hidden rounded-md border">
                                <div class="relative flex aspect-video items-center justify-center bg-muted">
                                    <LucidePlayCn Size="24" Class="size-8 text-muted-foreground/40" />
                                    <span class="absolute bottom-2 right-2 rounded bg-black/70 px-1.5 py-0.5 text-xs text-white tabular-nums">@video.Duration</span>
                                </div>
                                <div class="p-3">
                                    <p class="mb-1 line-clamp-2 text-sm font-medium leading-snug">@video.Title</p>
                                    <div class="flex items-center justify-between text-xs text-muted-foreground">
                                        <span>@video.Channel</span>
                                        <span>@video.Views views</span>
                                    </div>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Video(string Id, string Title, string Channel, string Duration, string Views);

    private readonly Video[] _videos =
    [
        new("v1", "Building a Design System from Scratch", "DevChannel", "24:15", "142K"),
        new("v2", "Advanced TypeScript Patterns You Need to Know", "CodeCraft", "18:42", "89K"),
        new("v3", "Optimizing React Performance in 2026", "ReactConf", "32:08", "234K"),
        new("v4", "CSS Container Queries Deep Dive", "WebDev", "15:30", "67K"),
        new("v5", "Building Accessible Web Applications", "A11yTalks", "28:55", "45K"),
        new("v6", "The Future of Server Components", "NextConf", "41:22", "312K")
    ];
}
