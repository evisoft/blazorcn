@* ============================================================
   Block: carousel-office-locations
   Title: Carousel Office Locations
   Description: Office location cards carousel with city names, timezone displays, team size counters, contact details, and HQ highlighting.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/carousel/carousel-office-locations.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Office locations</span>
            <span class="text-muted-foreground text-xs">@_offices.Length offices · @_totalTeamSize people</span>
        </div>

        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var office in _offices)
                    {
                        <CarouselItemCn Class="basis-[80%] pl-3 sm:basis-1/2 lg:basis-1/3">
                            <div class="@Cn.Merge("overflow-hidden rounded-md border", office.IsHQ ? "border-foreground" : "")">
                                <div class="px-3 py-3">
                                    <div class="mb-2 flex items-center gap-2">
                                        <span class="font-medium text-sm">@office.City</span>
                                        @if (office.IsHQ)
                                        {
                                            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">HQ</span>
                                        }
                                    </div>
                                    <span class="block text-muted-foreground text-xs">@office.Country</span>
                                </div>
                                <div class="border-t px-3 py-3">
                                    <div class="mb-2 flex items-start gap-2">
                                        <LucideMapPinCn Size="16" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                                        <span class="text-xs text-muted-foreground leading-relaxed">@office.Address</span>
                                    </div>
                                    <div class="mb-2 flex items-center gap-2">
                                        <LucidePhoneCn Size="16" Class="size-3.5 shrink-0 text-muted-foreground" />
                                        <span class="font-mono text-xs text-muted-foreground">@office.Phone</span>
                                    </div>
                                </div>
                                <div class="flex items-center justify-between border-t px-3 py-3">
                                    <div class="flex items-center gap-1.5">
                                        <LucideUsersCn Size="16" Class="size-3.5 text-muted-foreground" />
                                        <span class="font-semibold text-xl tabular-nums">@office.TeamSize</span>
                                    </div>
                                    <span class="font-mono text-xs text-muted-foreground">@office.Timezone</span>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Office(string Id, string City, string Country, string Address, string Timezone, int TeamSize, string Phone, bool IsHQ);

    private readonly Office[] _offices =
    [
        new("o1", "San Francisco", "United States", "548 Market St, Suite 420", "UTC-8 (PST)", 142, "+1 (415) 555-0132", true),
        new("o2", "London", "United Kingdom", "71 Queen Victoria St, EC4V 4AY", "UTC+0 (GMT)", 87, "+44 20 7946 0958", false),
        new("o3", "Berlin", "Germany", "Friedrichstra\u00dfe 68, 10117", "UTC+1 (CET)", 53, "+49 30 1234 5678", false),
        new("o4", "Tokyo", "Japan", "Shibuya Scramble Square, 2-24-12", "UTC+9 (JST)", 34, "+81 3 6450 1234", false),
        new("o5", "S\u00e3o Paulo", "Brazil", "Av. Paulista, 1578 - Bela Vista", "UTC-3 (BRT)", 28, "+55 11 3456 7890", false),
        new("o6", "Sydney", "Australia", "100 Barangaroo Ave, NSW 2000", "UTC+11 (AEDT)", 19, "+61 2 8765 4321", false)
    ];

    private int _totalTeamSize => _offices.Sum(o => o.TeamSize);
}
