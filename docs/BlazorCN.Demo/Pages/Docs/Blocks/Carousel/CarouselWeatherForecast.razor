@* ============================================================
   Block: carousel-weather-forecast
   Title: Carousel Weather Forecast
   Description: Weather forecast carousel with daily temperature cards, weather condition icons, and precipitation percentages.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/carousel/carousel-weather-forecast.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideCloudSunCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">7-Day Forecast</p>
            </div>
            <span class="text-xs text-muted-foreground">San Francisco, CA</span>
        </div>
        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-2">
                    @foreach (var day in _forecast)
                    {
                        <CarouselItemCn Class="basis-[30%] pl-2 sm:basis-[20%] lg:basis-[14.28%]">
                            <div class="flex flex-col items-center rounded-md border p-3 text-center">
                                <span class="mb-1 text-xs font-medium">@day.Day</span>
                                <LucideCloudSunCn Size="24" Class="mb-1 size-6 text-muted-foreground" />
                                <span class="text-xs text-muted-foreground">@day.Condition</span>
                                <div class="mt-2 flex items-baseline gap-1">
                                    <span class="text-lg font-semibold tabular-nums">@(day.High)°</span>
                                    <span class="text-xs text-muted-foreground tabular-nums">@(day.Low)°</span>
                                </div>
                                <div class="mt-1 flex items-center gap-1 text-xs text-muted-foreground">
                                    <LucideDropletCn Size="16" Class="size-3" />
                                    <span class="tabular-nums">@(day.Precipitation)%</span>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record ForecastDay(string Day, string Condition, int High, int Low, int Precipitation);

    private readonly ForecastDay[] _forecast =
    [
        new("Mon", "Sunny", 68, 52, 5),
        new("Tue", "Cloudy", 64, 50, 20),
        new("Wed", "Rainy", 58, 48, 80),
        new("Thu", "Rainy", 56, 46, 70),
        new("Fri", "Partly Cloudy", 62, 49, 30),
        new("Sat", "Sunny", 70, 54, 10),
        new("Sun", "Sunny", 72, 55, 5)
    ];
}
