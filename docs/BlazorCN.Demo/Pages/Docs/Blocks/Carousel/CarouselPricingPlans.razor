@* ============================================================
   Block: carousel-pricing-plans
   Title: Carousel Pricing Plans
   Description: Pricing plans carousel with tiered pricing cards, feature checklists, and recommended plan highlight.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn, ButtonCn
   Source: original/blocks/carousel/carousel-pricing-plans.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Pricing</span>
            <span class="text-muted-foreground text-xs">@_plans.Length plans</span>
        </div>
        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var plan in _plans)
                    {
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/4">
                            <div class="@Cn.Merge("flex h-full flex-col rounded-md border p-3", plan.IsRecommended ? "border-foreground" : "")">
                                <div class="mb-2 flex items-center justify-between">
                                    <span class="font-medium text-sm">@plan.Name</span>
                                    @if (plan.IsRecommended)
                                    {
                                        <span class="rounded bg-foreground px-1.5 py-0.5 text-xs text-background">Recommended</span>
                                    }
                                </div>
                                <div class="mb-1 flex items-baseline gap-0.5">
                                    <span class="text-2xl font-semibold tabular-nums">$@plan.Price</span>
                                    <span class="text-xs text-muted-foreground">/mo</span>
                                </div>
                                <p class="mb-3 text-xs text-muted-foreground">@plan.Description</p>
                                <div class="mb-3 flex-1 space-y-1.5">
                                    @foreach (var feature in plan.Features)
                                    {
                                        <div class="flex items-center gap-2">
                                            <LucideCheckCn Size="16" Class="size-3.5 shrink-0 text-muted-foreground" />
                                            <span class="text-xs">@feature</span>
                                        </div>
                                    }
                                </div>
                                <ButtonCn Variant="@(plan.IsRecommended ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Sm" Class="h-7 w-full text-xs">
                                    @plan.Cta
                                </ButtonCn>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record PricingPlan(string Id, string Name, int Price, string Description, string[] Features, string Cta, bool IsRecommended);

    private readonly PricingPlan[] _plans =
    [
        new("starter", "Starter", 0, "For individuals exploring the platform.", ["1 project", "1,000 API requests/mo", "Community support", "Basic analytics", "48-hour response time"], "Get started free", false),
        new("pro", "Pro", 29, "For professionals who need more power.", ["Unlimited projects", "100,000 API requests/mo", "Priority support", "Advanced analytics", "Custom domains"], "Start free trial", true),
        new("business", "Business", 79, "For growing teams with advanced needs.", ["Unlimited projects", "1M API requests/mo", "Dedicated support", "Team analytics", "SSO & audit logs"], "Contact sales", false),
        new("enterprise", "Enterprise", 199, "For large organizations at scale.", ["Unlimited everything", "Custom API limits", "24/7 phone support", "Custom integrations", "SLA guarantee"], "Talk to us", false)
    ];
}
