@* ============================================================
   Block: carousel-portfolio
   Title: Carousel Portfolio
   Description: Portfolio and case study carousel with project cards, metric animations, and industry categorization.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn, ButtonCn
   Source: original/blocks/carousel/carousel-portfolio.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Case studies</span>
            <span class="text-muted-foreground text-xs">@_projects.Length projects</span>
        </div>

        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var project in _projects)
                    {
                        <CarouselItemCn Class="basis-full pl-3 sm:basis-1/2 lg:basis-1/3">
                            <div class="flex h-full flex-col overflow-hidden rounded-md border">
                                <div class="px-3 py-3">
                                    <div class="mb-2 flex items-center gap-2">
                                        <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@project.Category</span>
                                    </div>
                                    <p class="mb-1 text-sm font-medium leading-snug">@project.Name</p>
                                    <p class="mb-2 text-xs text-muted-foreground">@project.Client</p>
                                    <p class="mb-3 line-clamp-2 flex-1 text-xs text-muted-foreground leading-relaxed">@project.Description</p>
                                </div>
                                <div class="border-t px-3 py-3">
                                    <div class="flex items-center gap-3">
                                        @foreach (var metric in project.Metrics)
                                        {
                                            <div class="text-center">
                                                <p class="font-semibold text-sm tabular-nums">@metric.Value</p>
                                                <p class="text-xs text-muted-foreground">@metric.Label</p>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="border-t px-3 py-2.5">
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                                        View case study
                                        <LucideArrowUpRightCn Size="16" Class="size-3" />
                                    </ButtonCn>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Metric(string Label, string Value);
    private record Project(string Id, string Name, string Client, string Category, string Description, Metric[] Metrics);

    private readonly Project[] _projects =
    [
        new("p1", "Payment Infrastructure Rebuild", "NovaPay", "Fintech", "Migrated legacy payment processing to a distributed microservices architecture, reducing transaction latency and increasing throughput.", [new("Conversion", "+45%"), new("Latency", "12ms"), new("Uptime", "99.99%")]),
        new("p2", "Telehealth Platform", "MedConnect", "Healthtech", "Built a HIPAA-compliant telehealth platform with real-time video, scheduling, and EHR integration serving thousands of daily consultations.", [new("Consultations", "50K/mo"), new("Wait time", "-68%"), new("NPS", "92")]),
        new("p3", "Supply Chain Visibility", "TraceLogix", "Logistics", "Real-time shipment tracking dashboard with predictive ETA calculations and automated exception handling across global supply chains.", [new("Shipments", "2M/yr"), new("Accuracy", "99.7%"), new("Cost", "-34%")]),
        new("p4", "E-Commerce Personalization", "ShelfSpace", "Retail", "ML-powered product recommendation engine that increased average order value and reduced cart abandonment through contextual suggestions.", [new("AOV", "+28%"), new("Cart abandon", "-22%"), new("Revenue", "+$4.2M")]),
        new("p5", "Student Portal Redesign", "EduVerse", "Education", "Rebuilt the student-facing portal with modern UX, real-time grade tracking, and integrated collaboration tools for 180,000 active users.", [new("Users", "180K"), new("Engagement", "+61%"), new("Support", "-45%")]),
        new("p6", "Digital Banking App", "ClearBank", "Fintech", "Designed and launched a mobile banking application with biometric auth, instant transfers, and spending analytics for a neobank startup.", [new("Downloads", "850K"), new("DAU", "120K"), new("Rating", "4.8")])
    ];
}
