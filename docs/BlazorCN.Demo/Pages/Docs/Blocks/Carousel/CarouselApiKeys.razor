@* ============================================================
   Block: carousel-api-keys
   Title: Animated API Key Management Carousel
   Description: API key management carousel with masked key values, scope chips, usage statistics, and expandable detail rows
   Dependencies: CarouselCn, ButtonCn
   Source: original/blocks/carousel/carousel-api-keys.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideKeyRoundCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">API keys</span>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                @_apiKeys.Count(k => k.IsActive) active
            </span>
        </div>

        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var key in _apiKeys)
                    {
                        var isExpanded = _expanded == key.Id;
                        <CarouselItemCn Class="basis-full pl-3">
                            <div class="rounded-md border">
                                <button type="button" @onclick="() => _expanded = isExpanded ? null : key.Id" class="flex w-full cursor-pointer items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                                    <span class="@Cn.Merge("size-2 shrink-0 rounded-full", key.IsActive ? "bg-emerald-500" : "bg-muted-foreground/30")"></span>
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-2">
                                            <span class="font-medium text-sm">@key.Name</span>
                                            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@key.Scope</span>
                                        </div>
                                        <span class="mt-0.5 block font-mono text-xs text-muted-foreground">@key.MaskedValue</span>
                                    </div>
                                    <div class="hidden items-center gap-3 sm:flex">
                                        <span class="text-xs text-muted-foreground">@key.LastUsed</span>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" class="h-7 text-xs" disabled="@(!key.IsActive)">Revoke</ButtonCn>
                                    </div>
                                    <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                                </button>

                                @if (isExpanded)
                                {
                                    <div class="border-t px-4 py-3">
                                        <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
                                            <div>
                                                <span class="block text-xs text-muted-foreground">Created</span>
                                                <span class="font-mono text-xs">@key.CreatedDate</span>
                                            </div>
                                            <div>
                                                <span class="block text-xs text-muted-foreground">Requests/mo</span>
                                                <span class="font-semibold text-sm tabular-nums">@key.RequestsMonth</span>
                                            </div>
                                            <div>
                                                <span class="block text-xs text-muted-foreground">Error rate</span>
                                                <span class="font-mono text-xs">@key.ErrorRate</span>
                                            </div>
                                            <div>
                                                <span class="block text-xs text-muted-foreground">Last endpoint</span>
                                                <span class="block truncate font-mono text-xs text-muted-foreground">@key.LastEndpoint</span>
                                            </div>
                                        </div>
                                        <div class="mt-3 flex items-center justify-end sm:hidden">
                                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" class="h-7 text-xs" disabled="@(!key.IsActive)">Revoke</ButtonCn>
                                        </div>
                                    </div>
                                }
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record ApiKeyItem(string Id, string Name, string MaskedValue, string Scope, string CreatedDate, string LastUsed, bool IsActive, string RequestsMonth, string ErrorRate, string LastEndpoint);

    private static readonly ApiKeyItem[] _apiKeys =
    [
        new("k1", "Production API", "sk-prod-....a8f2", "Admin", "Jan 3, 2026", "2 hours ago", true, "1,284,391", "0.02%", "POST /api/v2/users"),
        new("k2", "Staging Environment", "sk-stag-....c4e1", "Write", "Feb 14, 2026", "5 hours ago", true, "48,207", "0.15%", "GET /api/v2/analytics"),
        new("k3", "CI/CD Pipeline", "sk-cicd-....b7d3", "Write", "Nov 28, 2025", "12 min ago", true, "342,108", "0.01%", "POST /api/v2/deployments"),
        new("k4", "Analytics Dashboard", "sk-dash-....e9a5", "Read", "Dec 5, 2025", "1 day ago", true, "89,431", "0.00%", "GET /api/v2/metrics"),
        new("k5", "Webhook Service", "sk-hook-....f2c8", "Write", "Oct 19, 2025", "3 days ago", false, "0", "0.00%", "POST /api/v2/webhooks"),
        new("k6", "Mobile Client", "sk-mob-....d1b6", "Read", "Mar 1, 2026", "30 min ago", true, "672,940", "0.08%", "GET /api/v2/feed"),
    ];
}
