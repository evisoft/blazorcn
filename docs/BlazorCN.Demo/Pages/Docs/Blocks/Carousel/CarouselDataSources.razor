@* ============================================================
   Block: carousel-data-sources
   Title: Animated Data Source Connections Carousel
   Description: Data source connection cards carousel with database status indicators, sync timestamps, record counts, and action buttons
   Dependencies: CarouselCn, ButtonCn
   Source: original/blocks/carousel/carousel-data-sources.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideServerCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Data sources</span>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                @_sources.Count(s => s.IsConnected) of @_sources.Length connected
            </span>
        </div>

        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var source in _sources)
                    {
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/3">
                            <div class="flex h-full flex-col rounded-md border p-3">
                                <div class="mb-2 flex items-center gap-2">
                                    <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted">
                                        @switch (source.Icon)
                                        {
                                            case "database":
                                                <LucideDatabaseCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "layers":
                                                <LucideLayersCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "circle-dot":
                                                <LucideCircleDotCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "search":
                                                <LucideSearchCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "hard-drive":
                                                <LucideHardDriveCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "warehouse":
                                                <LucideWarehouseCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "snowflake":
                                                <LucideSnowflakeCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                        }
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-1.5">
                                            <span class="font-medium text-sm">@source.Name</span>
                                            <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", source.IsConnected ? "bg-emerald-500" : "bg-red-500")"></span>
                                        </div>
                                        <span class="text-xs text-muted-foreground">Synced @source.LastSync</span>
                                    </div>
                                </div>

                                <div class="mb-3 flex-1">
                                    <span class="text-xs text-muted-foreground">Records</span>
                                    <p class="font-semibold text-xl tabular-nums">@source.Records</p>
                                </div>

                                <ButtonCn Variant="@(source.IsConnected ? ButtonVariant.Ghost : ButtonVariant.Outline)" Size="ButtonSize.Sm" class="h-7 w-full text-xs">
                                    @(source.IsConnected ? "Configure" : "Connect")
                                </ButtonCn>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record DataSourceItem(string Id, string Name, string Icon, bool IsConnected, string LastSync, string Records);

    private static readonly DataSourceItem[] _sources =
    [
        new("ds1", "PostgreSQL", "database", true, "3 min ago", "2,847,391"),
        new("ds2", "MySQL", "database", true, "12 min ago", "1,204,882"),
        new("ds3", "MongoDB", "layers", true, "1 hour ago", "892,104"),
        new("ds4", "Redis", "circle-dot", true, "30 sec ago", "48,291"),
        new("ds5", "Elasticsearch", "search", false, "2 days ago", "5,102,447"),
        new("ds6", "Amazon S3", "hard-drive", true, "45 min ago", "384,209"),
        new("ds7", "BigQuery", "warehouse", true, "6 hours ago", "12,840,105"),
        new("ds8", "Snowflake", "snowflake", false, "Never", "0"),
    ];
}
