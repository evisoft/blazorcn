@* ============================================================
   Block: carousel-before-after
   Title: Carousel Before After
   Description: Before and after comparison carousel with split-panel metrics and improvement indicators
   Dependencies: CarouselCn
   Source: original/blocks/carousel/carousel-before-after.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Results that speak</span>
            <span class="text-muted-foreground text-xs">83% average improvement across all metrics</span>
        </div>

        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var c in _comparisons)
                    {
                        <CarouselItemCn Class="basis-full pl-3">
                            <div class="rounded-md border">
                                <div class="flex items-center justify-between border-b px-4 py-3">
                                    <div>
                                        <span class="font-medium text-sm">@c.Title</span>
                                        <span class="ml-2 rounded bg-muted px-1.5 py-0.5 text-muted-foreground text-xs">@c.Category</span>
                                    </div>
                                    <div class="flex items-center gap-1">
                                        @if (c.IsPositive)
                                        {
                                            <LucideTrendingUpCn Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                                        }
                                        else
                                        {
                                            <LucideTrendingDownCn Size="14" Class="size-3.5 text-red-600 dark:text-red-400" />
                                        }
                                        <span class="@Cn.Merge("font-medium text-xs", c.IsPositive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">@c.Improvement</span>
                                    </div>
                                </div>

                                <div class="flex items-stretch">
                                    <div class="flex flex-1 flex-col items-center justify-center border-r bg-muted/30 px-4 py-6">
                                        <span class="mb-1 font-medium text-muted-foreground text-xs uppercase tracking-wider">Before</span>
                                        <div class="flex items-baseline gap-0.5">
                                            <span class="font-semibold text-2xl tabular-nums text-muted-foreground">@c.BeforeValue</span>
                                            <span class="text-muted-foreground text-sm">@c.BeforeUnit</span>
                                        </div>
                                        <span class="mt-1 text-muted-foreground text-xs">@c.BeforeLabel</span>
                                    </div>

                                    <div class="flex items-center px-2">
                                        <LucideArrowRightCn Size="16" Class="size-4 text-muted-foreground/40" />
                                    </div>

                                    <div class="flex flex-1 flex-col items-center justify-center px-4 py-6">
                                        <span class="mb-1 font-medium text-muted-foreground text-xs uppercase tracking-wider">After</span>
                                        <div class="flex items-baseline gap-0.5">
                                            <span class="font-semibold text-2xl tabular-nums">@c.AfterValue</span>
                                            <span class="text-sm">@c.AfterUnit</span>
                                        </div>
                                        <span class="mt-1 text-muted-foreground text-xs">@c.AfterLabel</span>
                                    </div>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record ComparisonItem(string Id, string Title, string Category, string BeforeValue, string BeforeUnit, string BeforeLabel, string AfterValue, string AfterUnit, string AfterLabel, string Improvement, bool IsPositive);

    private static readonly ComparisonItem[] _comparisons =
    [
        new("c1", "Page Load Time", "Performance", "4.2", "s", "Average TTFB", "0.8", "s", "Average TTFB", "81% faster", true),
        new("c2", "Conversion Rate", "Growth", "2.1", "%", "Checkout completion", "5.8", "%", "Checkout completion", "176% increase", true),
        new("c3", "Bundle Size", "Engineering", "847", "KB", "Gzipped JS payload", "214", "KB", "Gzipped JS payload", "75% smaller", true),
        new("c4", "Error Rate", "Reliability", "3.4", "%", "5xx responses", "0.02", "%", "5xx responses", "99.4% reduction", true),
    ];
}
