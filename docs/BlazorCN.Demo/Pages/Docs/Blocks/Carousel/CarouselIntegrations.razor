@* ============================================================
   Block: carousel-integrations
   Title: Animated Integrations Showcase Carousel
   Description: Integrations showcase carousel with app connection cards, category chips, and connected status indicators
   Dependencies: CarouselCn, ButtonCn
   Source: original/blocks/carousel/carousel-integrations.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideGlobeCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Integrations</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                @_integrations.Count(i => i.IsConnected) of @_integrations.Length connected
            </span>
        </div>

        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var integration in _integrations)
                    {
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/3">
                            <div class="flex h-full flex-col rounded-md border p-3">
                                <div class="mb-2 flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted">
                                            @switch (integration.Icon)
                                            {
                                                case "message-square":
                                                    <LucideMessageSquareCn Size="16" Class="size-4 text-muted-foreground" />
                                                    break;
                                                case "git-branch":
                                                    <LucideGitBranchCn Size="16" Class="size-4 text-muted-foreground" />
                                                    break;
                                                case "figma":
                                                    <LucideFigmaCn Size="16" Class="size-4 text-muted-foreground" />
                                                    break;
                                                case "target":
                                                    <LucideTargetCn Size="16" Class="size-4 text-muted-foreground" />
                                                    break;
                                                case "layout":
                                                    <LucideLayoutDashboardCn Size="16" Class="size-4 text-muted-foreground" />
                                                    break;
                                                case "bar-chart":
                                                    <LucideChartBarCn Size="16" Class="size-4 text-muted-foreground" />
                                                    break;
                                                case "credit-card":
                                                    <LucideCreditCardCn Size="16" Class="size-4 text-muted-foreground" />
                                                    break;
                                                case "triangle":
                                                    <LucideTriangleCn Size="16" Class="size-4 text-muted-foreground" />
                                                    break;
                                                case "cloud":
                                                    <LucideCloudCn Size="16" Class="size-4 text-muted-foreground" />
                                                    break;
                                                case "bell":
                                                    <LucideBellCn Size="16" Class="size-4 text-muted-foreground" />
                                                    break;
                                                case "zap":
                                                    <LucideZapCn Size="16" Class="size-4 text-muted-foreground" />
                                                    break;
                                            }
                                        </div>
                                        <div class="min-w-0">
                                            <div class="flex items-center gap-1.5">
                                                <span class="text-sm font-medium">@integration.Name</span>
                                                @if (integration.IsConnected)
                                                {
                                                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@integration.Category</span>
                                </div>

                                <p class="mb-3 flex-1 text-xs text-muted-foreground leading-relaxed">@integration.Description</p>

                                <ButtonCn Variant="@(integration.IsConnected ? ButtonVariant.Ghost : ButtonVariant.Outline)" Size="ButtonSize.Sm" class="h-7 w-full text-xs">
                                    @(integration.IsConnected ? "Connected" : "Connect")
                                </ButtonCn>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record IntegrationItem(string Id, string Name, string Icon, string Category, string Description, bool IsConnected);

    private static readonly IntegrationItem[] _integrations =
    [
        new("slack", "Slack", "message-square", "Communication", "Send alerts and notifications to channels", true),
        new("github", "GitHub", "git-branch", "Dev Tools", "Sync repos, PRs, and deployment status", true),
        new("figma", "Figma", "figma", "Design", "Import designs and sync component tokens", false),
        new("linear", "Linear", "target", "Project Mgmt", "Two-way sync issues and project boards", true),
        new("notion", "Notion", "layout", "Docs", "Embed dashboards and sync documentation", false),
        new("jira", "Jira", "bar-chart", "Project Mgmt", "Sync tickets, sprints, and release notes", false),
        new("stripe", "Stripe", "credit-card", "Payments", "Track revenue, subscriptions, and invoices", true),
        new("vercel", "Vercel", "triangle", "Hosting", "Auto-deploy previews and production builds", false),
        new("aws", "AWS", "cloud", "Infrastructure", "Connect S3, Lambda, and CloudWatch metrics", false),
        new("datadog", "Datadog", "bar-chart", "Monitoring", "Forward logs, traces, and custom metrics", false),
        new("pagerduty", "PagerDuty", "bell", "Incident Mgmt", "Trigger and resolve incidents automatically", false),
        new("zapier", "Zapier", "zap", "Automation", "Connect to 5,000+ apps with no-code workflows", false),
    ];
}
