@* ============================================================
   Block: carousel-notifications
   Title: Carousel Notifications
   Description: Activity feed notification carousel with grouped notifications by time period, colored status dots, and action chips.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/carousel/carousel-notifications.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <p class="text-sm font-medium">Activity</p>
                <span class="size-1.5 rounded-full bg-blue-500"></span>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">3 unread</span>
        </div>

        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var group in _groups)
                    {
                        <CarouselItemCn Class="basis-full pl-3">
                            <div class="rounded-md border">
                                <div class="border-b px-4 py-2">
                                    <span class="text-xs font-medium text-muted-foreground">@group.Label</span>
                                </div>
                                <div>
                                    @foreach (var notification in group.Notifications)
                                    {
                                        <div class="flex items-start gap-3 border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                                            <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", notification.StatusColor)"></span>
                                            <div class="min-w-0 flex-1">
                                                <div class="flex items-center justify-between gap-2">
                                                    <p class="truncate text-sm font-medium">@notification.Title</p>
                                                    <span class="shrink-0 rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@notification.Action</span>
                                                </div>
                                                <p class="mt-0.5 truncate text-xs text-muted-foreground">@notification.Description</p>
                                                <p class="mt-1 text-xs text-muted-foreground/60">@notification.Time</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Notification(string Id, string Title, string Description, string Time, string Action, string StatusColor);
    private record NotificationGroup(string Id, string Label, Notification[] Notifications);

    private readonly NotificationGroup[] _groups =
    [
        new("today", "Today", [
            new("n1", "Production deployment completed", "v2.4.1 deployed to us-east-1 cluster", "2 min ago", "Deployed", "bg-emerald-500"),
            new("n2", "Sarah Chen commented on PR #847", "Looks good, but let's add error handling for the edge case", "18 min ago", "Commented", "bg-blue-500"),
            new("n3", "CI pipeline failed on main", "Jest test suite: 3 failing tests in auth module", "1 hour ago", "Failed", "bg-red-500"),
            new("n4", "Branch feature/oauth merged", "Merged by Marcus Rivera with 4 approvals", "3 hours ago", "Merged", "bg-purple-500")
        ]),
        new("yesterday", "Yesterday", [
            new("n5", "Database migration completed", "Added indexes on users.email and sessions.token", "Yesterday at 4:32 PM", "Migrated", "bg-emerald-500"),
            new("n6", "New team member joined workspace", "Lena Johansson accepted the invitation", "Yesterday at 2:15 PM", "Joined", "bg-blue-500"),
            new("n7", "Stripe webhook endpoint updated", "Added invoice.payment_failed event handler", "Yesterday at 11:08 AM", "Updated", "bg-amber-500")
        ]),
        new("this-week", "This week", [
