@* ============================================================
   Block: carousel-stats-metrics
   Title: Carousel Stats Metrics
   Description: Stats and metrics dashboard carousel with KPI cards, trend indicators, sparkline placeholders, and comparison periods.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/carousel/carousel-stats-metrics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Key Metrics</span>
            <span class="text-muted-foreground text-xs">Last 30 days</span>
        </div>
        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var metric in _metrics)
                    {
                        <CarouselItemCn Class="basis-[45%] pl-3 sm:basis-1/3 lg:basis-1/4">
                            <div class="rounded-md border p-3">
                                <p class="mb-1 text-xs text-muted-foreground">@metric.Label</p>
                                <p class="text-2xl font-semibold tabular-nums">@metric.Value</p>
                                <div class="mt-1 flex items-center gap-1">
                                    @if (metric.TrendUp)
                                    {
                                        <LucideArrowUpCn Size="16" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                                        <span class="text-xs tabular-nums text-emerald-600 dark:text-emerald-400">@metric.Change</span>
                                    }
                                    else
                                    {
                                        <LucideArrowDownCn Size="16" Class="size-3 text-red-600 dark:text-red-400" />
                                        <span class="text-xs tabular-nums text-red-600 dark:text-red-400">@metric.Change</span>
                                    }
                                    <span class="text-xs text-muted-foreground">vs last period</span>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Metric(string Id, string Label, string Value, string Change, bool TrendUp);

    private readonly Metric[] _metrics =
    [
        new("m1", "Total Revenue", "$142.8K", "+12.5%", true),
        new("m2", "Active Users", "24,521", "+8.2%", true),
        new("m3", "Conversion Rate", "3.24%", "+0.4%", true),
        new("m4", "Avg Session", "4m 32s", "-0.8%", false),
        new("m5", "Bounce Rate", "38.2%", "-2.1%", true),
        new("m6", "New Signups", "1,847", "+15.3%", true),
        new("m7", "Churn Rate", "2.1%", "+0.3%", false),
        new("m8", "NPS Score", "72", "+4", true)
    ];
}
