@* ============================================================
   Block: carousel-meeting-agenda
   Title: Carousel Meeting Agenda
   Description: Meeting agenda carousel with time allocations, topic titles, presenter initials, type chips, and notes indicators.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/carousel/carousel-meeting-agenda.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideListCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Meeting Agenda</p>
            </div>
            <div class="flex items-center gap-2">
                <div class="flex items-center gap-1">
                    <LucideClockCn Size="16" Class="size-3 text-muted-foreground" />
                    <span class="text-xs text-muted-foreground tabular-nums">@_totalMinutes min</span>
                </div>
                <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                    @_agendaItems.Length items
                </span>
            </div>
        </div>

        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var item in _agendaItems)
                    {
                        <CarouselItemCn Class="basis-full pl-3">
                            <div class="rounded-md border p-4">
                                <div class="mb-3 flex items-center justify-between">
                                    <span class="rounded bg-foreground px-1.5 py-0.5 text-xs font-medium text-background">
                                        @item.Duration min
                                    </span>
                                    <span class="@Cn.Merge("rounded px-1.5 py-0.5 text-xs", _typeStyles[item.Type])">
                                        @item.Type
                                    </span>
                                </div>
                                <p class="mb-3 text-sm font-medium">@item.Title</p>
                                <div class="space-y-2">
                                    <div class="flex items-center gap-2">
                                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                                            @item.PresenterInitials
                                        </div>
                                        <div>
                                            <p class="text-sm font-medium">@item.PresenterName</p>
                                            <span class="text-xs text-muted-foreground">Presenter</span>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <LucideClockCn Size="16" Class="size-3.5 text-muted-foreground" />
                                        <span class="text-xs text-muted-foreground">
                                            @item.Duration minute@(item.Duration != 1 ? "s" : "") allocated
                                        </span>
                                    </div>
                                    @if (item.HasNotes)
                                    {
                                        <div class="flex items-center gap-2">
                                            <LucideFileTextCn Size="16" Class="size-3.5 text-muted-foreground" />
                                            <span class="text-xs text-muted-foreground">Notes attached</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record AgendaItem(string Id, int Duration, string Title, string PresenterName, string PresenterInitials, string Type, bool HasNotes);

    private static readonly Dictionary<string, string> _typeStyles = new()
    {
        ["Discussion"] = "bg-muted text-muted-foreground",
        ["Decision"] = "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        ["Update"] = "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        ["Demo"] = "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400"
    };

    private readonly AgendaItem[] _agendaItems =
    [
        new("a1", 5, "Sprint Review & Retrospective Summary", "Sarah Chen", "SC", "Update", true),
        new("a2", 15, "Q2 Roadmap Prioritization", "James Rivera", "JR", "Decision", true),
        new("a3", 10, "New Authentication Flow", "Aisha Patel", "AP", "Demo", false),
        new("a4", 10, "Infrastructure Cost Optimization", "Marcus Johansson", "MJ", "Discussion", true),
        new("a5", 15, "Hiring Plan for Engineering", "Elena Kowalski", "EK", "Decision", false),
        new("a6", 5, "Action Items & Next Steps", "David Okonkwo", "DO", "Update", false)
    ];

    private int _totalMinutes => _agendaItems.Sum(i => i.Duration);
}
