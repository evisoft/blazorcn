@* ============================================================
   Block: carousel-onboarding-steps
   Title: Carousel Onboarding Steps
   Description: Onboarding wizard steps carousel with progress bar, completion indicators, step navigation, and estimated time.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, ButtonCn
   Source: original/blocks/carousel/carousel-onboarding-steps.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <p class="text-sm font-medium">Getting started</p>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                Step @(_currentStep + 1) of @_steps.Length
            </span>
        </div>

        <div class="border-b px-4 py-2">
            <div class="h-1 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-foreground" style="@($"width: {(_currentStep + 1.0) / _steps.Length * 100:F0}%")"></div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                @for (var i = 0; i < _steps.Length; i++)
                {
                    var step = _steps[i];
                    var idx = i;
                    <div class="flex items-center gap-2">
                        <div class="flex flex-col items-center">
                            @if (step.IsCompleted)
                            {
                                <div class="flex size-6 items-center justify-center rounded-full bg-foreground">
                                    <LucideCheckCn Size="16" Class="size-3 text-background" />
                                </div>
                            }
                            else if (idx == _currentStep)
                            {
                                <div class="relative flex size-6 items-center justify-center rounded-full border-2 border-foreground">
                                    <span class="size-2 rounded-full bg-foreground"></span>
                                </div>
                            }
                            else
                            {
                                <div class="flex size-6 items-center justify-center rounded-full border text-xs text-muted-foreground">
                                    @(idx + 1)
                                </div>
                            }
                        </div>
                        @if (idx < _steps.Length - 1)
                        {
                            <div class="hidden h-px w-6 bg-border sm:block md:w-10 lg:w-14"></div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var step in _steps)
                    {
                        <CarouselItemCn Class="basis-full pl-3">
                            <div class="rounded-md border p-4">
                                <div class="mb-3 flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        @switch (step.Icon)
                                        {
                                            case "rocket": <LucideRocketCn Size="16" Class="size-4 text-muted-foreground" />; break;
                                            case "database": <LucideDatabaseCn Size="16" Class="size-4 text-muted-foreground" />; break;
                                            case "settings": <LucideSettingsCn Size="16" Class="size-4 text-muted-foreground" />; break;
                                            case "users": <LucideUsersCn Size="16" Class="size-4 text-muted-foreground" />; break;
                                            case "cloud": <LucideCloudCn Size="16" Class="size-4 text-muted-foreground" />; break;
                                        }
                                        <span class="text-sm font-medium">@step.Title</span>
                                    </div>
                                    <span class="text-xs text-muted-foreground">@step.EstimatedTime</span>
                                </div>
                                <p class="mb-2 text-xs text-muted-foreground">@step.Description</p>
                                <p class="mb-4 text-xs text-muted-foreground/80 leading-relaxed">@step.Detail</p>
                                <div class="flex items-center gap-2">
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Back</ButtonCn>
                                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">Continue</ButtonCn>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record OnboardingStep(string Id, string Title, string Description, string Detail, string EstimatedTime, string Icon, bool IsCompleted);

    private int _currentStep = 1;

    private readonly OnboardingStep[] _steps =
    [
        new("s1", "Create your account", "Set up your profile and workspace preferences.", "Choose a workspace name, upload a logo, and configure your timezone. Your workspace URL will be automatically generated from the name you pick.", "~1 min", "rocket", true),
        new("s2", "Connect your data", "Link your existing tools and import records.", "We support CSV imports and direct connections to PostgreSQL, MySQL, and MongoDB. Data is encrypted in transit and at rest using AES-256.", "~3 min", "database", false),
        new("s3", "Configure settings", "Customize notifications, permissions, and defaults.", "Set up email digest frequency, Slack notification channels, and default project settings. You can change these anytime from the settings page.", "~2 min", "settings", false),
        new("s4", "Invite your team", "Add collaborators and assign roles.", "Send invitations by email or share a join link. Assign Admin, Editor, or Viewer roles. Team members get access immediately after accepting.", "~2 min", "users", false),
        new("s5", "Go live", "Deploy your workspace and start collaborating.", "Review your configuration, run the pre-flight check, and publish your workspace. You can switch between staging and production environments at any time.", "~1 min", "cloud", false)
    ];
}
