@* ============================================================
   Block: carousel-culture-values
   Title: Culture Values Carousel
   Description: Company culture values carousel with value descriptions, team quotes, and related icons
   Dependencies: CarouselCn
   Source: original/blocks/carousel/carousel-culture-values.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Our values</span>
            <span class="text-muted-foreground text-xs">@_values.Length principles</span>
        </div>

        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var value in _values)
                    {
                        <CarouselItemCn Class="pl-3">
                            <div class="rounded-md border">
                                <div class="px-4 py-3">
                                    <div class="mb-3 flex items-center gap-2.5">
                                        <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                                            @switch (value.Icon)
                                            {
                                                case "lightbulb":
                                                    <LucideLightbulbCn Size="16" Class="size-4 text-muted-foreground" />
                                                    break;
                                                case "rocket":
                                                    <LucideRocketCn Size="16" Class="size-4 text-muted-foreground" />
                                                    break;
                                                case "shield":
                                                    <LucideShieldCn Size="16" Class="size-4 text-muted-foreground" />
                                                    break;
                                                case "users":
                                                    <LucideUsersCn Size="16" Class="size-4 text-muted-foreground" />
                                                    break;
                                                case "heart":
                                                    <LucideHeartCn Size="16" Class="size-4 text-muted-foreground" />
                                                    break;
                                                case "sparkles":
                                                    <LucideSparklesCn Size="16" Class="size-4 text-muted-foreground" />
                                                    break;
                                            }
                                        </div>
                                        <span class="font-medium text-sm">@value.Name</span>
                                    </div>
                                    <p class="text-muted-foreground text-sm leading-relaxed">@value.Description</p>
                                </div>

                                <div class="border-t bg-muted/30 px-4 py-3">
                                    <p class="mb-2 text-sm leading-relaxed italic">
                                        &ldquo;@value.Quote&rdquo;
                                    </p>
                                    <span class="text-muted-foreground text-xs">&mdash; @value.Quotee</span>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record ValueItem(string Id, string Name, string Description, string Quote, string Quotee, string Icon);

    private static readonly ValueItem[] _values =
    [
        new("v1", "Build in the open", "We share our roadmap, write public RFCs, and default to transparency. Decisions are documented and accessible to the entire team, not locked in private channels.", "Transparency isn't just a policy here. It's how we make better decisions and build trust with every person who depends on our work.", "Elena, CEO", "lightbulb"),
        new("v2", "Ship and iterate", "We prefer small, frequent releases over long development cycles. Every feature ships behind a flag, gets real user feedback, and improves in the next sprint.", "The fastest way to learn is to put something real in front of users. Perfection is the enemy of progress and we choose progress every time.", "Marcus, Engineering", "rocket"),
        new("v3", "Own the outcome", "Every team member has the autonomy to make decisions within their domain. We measure results, not hours. Accountability means celebrating wins and learning from misses.", "Nobody waits for permission to fix a problem. If you see something broken you have full authority to make it right.", "Asha, Design", "shield"),
        new("v4", "Lift each other up", "We run weekly pair sessions, maintain a mentorship program, and celebrate peer contributions publicly. Growth is collective. One person's success raises the whole team.", "My manager didn't just assign me a project. They paired me with a senior engineer who taught me more in three months than I learned in two years.", "James, Backend", "users"),
        new("v5", "Care deeply", "We sweat the details because our users notice. From error messages to loading states, every interaction is intentional. Quality is a habit, not a phase.", "We spent an entire sprint on error messages alone. That kind of care is why developers trust our tools with their production workloads.", "Sophie, Product", "heart"),
        new("v6", "Stay curious", "We allocate 20% time for exploration, fund conference attendance, and maintain an internal tech radar. Learning new things keeps our product ahead of the curve.", "The best ideas come from people who never stop asking why. Curiosity is the engine that drives everything we build here.", "Ryan, DevRel", "sparkles"),
    ];
}
