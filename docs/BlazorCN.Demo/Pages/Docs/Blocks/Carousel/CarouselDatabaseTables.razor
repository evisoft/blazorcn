@* ============================================================
   Block: carousel-database-tables
   Title: Database Table Schema Viewer Carousel
   Description: Database table schema viewer carousel with monospace table names, column/row counts, sizes, and expandable column details
   Dependencies: CarouselCn
   Source: original/blocks/carousel/carousel-database-tables.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Database tables</span>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@_tables.Length tables</span>
        </div>

        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var table in _tables)
                    {
                        var isExpanded = _expanded == table.Id;
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/3">
                            <div class="overflow-hidden rounded-md border">
                                <button type="button" @onclick="() => _expanded = isExpanded ? null : table.Id" class="w-full px-4 py-3 text-left transition-colors hover:bg-muted/50">
                                    <div class="flex items-center justify-between">
                                        <span class="font-mono text-sm">@table.Name</span>
                                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                                    </div>
                                    <div class="mt-2 flex items-center gap-2">
                                        <span class="font-semibold text-xl tabular-nums">@table.RowCount</span>
                                        <span class="text-muted-foreground text-xs">rows</span>
                                    </div>
                                    <div class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-muted-foreground text-xs">
                                        <span class="tabular-nums">@table.Columns.Length columns</span>
                                        <span class="text-muted-foreground/40">·</span>
                                        <span class="tabular-nums">@table.Size</span>
                                        <span class="text-muted-foreground/40">·</span>
                                        <span class="tabular-nums">@table.Relationships relations</span>
                                    </div>
                                    <div class="mt-1.5 text-muted-foreground/60 text-xs">Migrated @table.LastMigration</div>
                                </button>

                                @if (isExpanded)
                                {
                                    <div class="border-t px-4 py-2">
                                        <span class="font-medium text-muted-foreground text-xs">Columns</span>
                                        <div class="mt-1.5 space-y-1">
                                            @foreach (var col in table.Columns)
                                            {
                                                <div class="flex items-center justify-between">
                                                    <span class="font-mono text-xs">@col.Name</span>
                                                    <span class="font-mono text-muted-foreground text-xs">@col.Type</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record ColumnItem(string Name, string Type);
    private record TableItem(string Id, string Name, ColumnItem[] Columns, string RowCount, string Size, string LastMigration, int Relationships);

