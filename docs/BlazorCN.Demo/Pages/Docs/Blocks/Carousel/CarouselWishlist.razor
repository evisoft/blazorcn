@* ============================================================
   Block: carousel-wishlist
   Title: Carousel Wishlist
   Description: Wishlist carousel with product cards, prices, availability status, and add-to-cart actions.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn, ButtonCn
   Source: original/blocks/carousel/carousel-wishlist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideHeartCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Wishlist</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@_items.Length items</span>
        </div>
        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var item in _items)
                    {
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/4">
                            <div class="flex h-full flex-col overflow-hidden rounded-md border">
                                <div class="flex aspect-square items-center justify-center bg-muted">
                                    <LucidePackageCn Size="24" Class="size-6 text-muted-foreground/40" />
                                </div>
                                <div class="flex flex-1 flex-col p-3">
                                    <p class="mb-1 text-sm font-medium">@item.Name</p>
                                    <p class="mb-2 text-xs text-muted-foreground">@item.Brand</p>
                                    <div class="mb-3 flex items-center justify-between">
                                        <span class="text-sm font-semibold tabular-nums">@("$" + item.Price)</span>
                                        <div class="flex items-center gap-1">
                                            <span class="@Cn.Merge("size-1.5 rounded-full", item.InStock ? "bg-emerald-500" : "bg-red-500")"></span>
                                            <span class="text-xs text-muted-foreground">@(item.InStock ? "In stock" : "Out of stock")</span>
                                        </div>
                                    </div>
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 w-full text-xs" Disabled="@(!item.InStock)">
                                        @(item.InStock ? "Add to cart" : "Notify me")
                                    </ButtonCn>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record WishlistItem(string Id, string Name, string Brand, int Price, bool InStock);

    private readonly WishlistItem[] _items =
    [
        new("w1", "Mechanical Keyboard", "KeyCraft", 179, true),
        new("w2", "Ultrawide Monitor", "ViewMax", 899, true),
        new("w3", "Noise-Canceling Headphones", "SoundPro", 349, false),
        new("w4", "Standing Desk", "ErgoDesk", 649, true),
        new("w5", "Webcam 4K", "StreamClear", 199, true),
        new("w6", "Desk Mat XL", "DeskCraft", 45, false)
    ];
}
