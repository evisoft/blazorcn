@* ============================================================
   Block: carousel-news-headlines
   Title: Carousel News Headlines
   Description: News article cards carousel with headlines, source names, category chips, publication dates, and excerpts.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn, ButtonCn
   Source: original/blocks/carousel/carousel-news-headlines.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideNewspaperCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Latest Headlines</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                @_articles.Length articles
            </span>
        </div>

        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var article in _articles)
                    {
                        <CarouselItemCn Class="basis-full pl-3 sm:basis-1/2 lg:basis-1/3">
                            <div class="flex h-full flex-col overflow-hidden rounded-md border p-3">
                                <div class="mb-2 flex items-center gap-2">
                                    <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@article.Category</span>
                                    <span class="text-xs text-muted-foreground">@article.Date</span>
                                </div>
                                <p class="mb-1.5 line-clamp-2 text-sm font-medium leading-snug">@article.Headline</p>
                                <p class="mb-1 text-xs text-muted-foreground">@article.Source</p>
                                <p class="mb-3 line-clamp-2 flex-1 text-xs text-muted-foreground leading-relaxed">@article.Excerpt</p>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-full gap-1.5 text-xs">
                                    <LucideExternalLinkCn Size="16" Class="size-3" />
                                    Read
                                </ButtonCn>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Article(string Id, string Headline, string Source, string Category, string Date, string Excerpt);

    private readonly Article[] _articles =
    [
        new("a1", "WebAssembly Reaches 1.0 Milestone with Component Model Standard", "The Verge", "Tech", "Mar 15, 2026", "The W3C formally ratifies the component model specification, enabling cross-language interoperability in the browser and edge runtimes."),
        new("a2", "Global Semiconductor Investment Hits Record $240B in 2025", "Bloomberg", "Business", "Mar 14, 2026", "Capital expenditure across the chip industry surpassed projections as fab construction accelerated in the US, Japan, and Germany."),
        new("a3", "CRISPR Gene Therapy Shows 94% Efficacy in Sickle Cell Trial", "Nature", "Science", "Mar 13, 2026", "A Phase III clinical trial demonstrated near-complete elimination of vaso-occlusive crises in patients treated with the one-time therapy."),
        new("a4", "React Server Components Adoption Doubles Among Enterprise Teams", "InfoQ", "Tech", "Mar 12, 2026", "Survey of 2,500 engineering teams shows 61% have adopted RSC in production, up from 28% in the previous year."),
        new("a5", "Central Banks Explore Programmable Money with Smart Contract CBDCs", "Financial Times", "Business", "Mar 11, 2026", "The European Central Bank and Bank of England pilot programmable digital currencies with conditional payment execution for trade finance."),
        new("a6", "James Webb Telescope Detects New Biosignature on K2-18 b", "NASA", "Science", "Mar 10, 2026", "Spectral analysis of the sub-Neptune exoplanet reveals dimethyl sulfide concentrations consistent with biological activity."),
        new("a7", "EU AI Act Enforcement Begins with First Compliance Audits", "Reuters", "Tech", "Mar 9, 2026", "European regulators issue the first formal compliance requests to six major AI companies under the high-risk classification framework."),
