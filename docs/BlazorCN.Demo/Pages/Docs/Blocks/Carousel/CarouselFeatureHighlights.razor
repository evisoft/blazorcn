@* ============================================================
   Block: carousel-feature-highlights
   Title: Feature Highlights Carousel
   Description: Feature highlights carousel with icon-driven cards and expandable detail panels
   Dependencies: CarouselCn
   Source: original/blocks/carousel/carousel-feature-highlights.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Platform capabilities</span>
            <span class="text-muted-foreground text-xs">@_features.Length features</span>
        </div>

        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var feature in _features)
                    {
                        var isExpanded = _expanded == feature.Id;
                        <CarouselItemCn Class="basis-full pl-3 md:basis-1/2 lg:basis-1/3">
                            <div class="rounded-md border">
                                <button type="button" @onclick="() => _expanded = isExpanded ? null : feature.Id" class="w-full p-3 text-left transition-colors hover:bg-muted/50">
                                    <div class="mb-2 flex items-center justify-between">
                                        @switch (feature.Icon)
                                        {
                                            case "zap":
                                                <LucideZapCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "database":
                                                <LucideDatabaseCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "lock":
                                                <LucideLockCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "search":
                                                <LucideSearchCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "globe":
                                                <LucideGlobeCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "layers":
                                                <LucideLayersCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "code":
                                                <LucideCodeCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "settings":
                                                <LucideSettingsCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                        }
                                        <LucideChevronRightCn Size="14" Class="@Cn.Merge("size-3.5 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                                    </div>
                                    <span class="font-medium text-sm">@feature.Title</span>
                                    <p class="mt-1 text-muted-foreground text-xs leading-relaxed">@feature.Description</p>
                                </button>

                                @if (isExpanded)
                                {
                                    <div class="border-t px-3 py-3">
                                        <p class="text-muted-foreground text-xs leading-relaxed">@feature.Detail</p>
                                    </div>
                                }
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record FeatureItem(string Id, string Icon, string Title, string Description, string Detail);

    private static readonly FeatureItem[] _features =
    [
        new("f1", "zap", "Edge Runtime", "Deploy functions to 300+ edge locations worldwide with sub-millisecond cold starts.", "Our edge runtime uses V8 isolates to achieve near-instant startup times. Functions are automatically replicated across regions with intelligent routing based on user proximity."),
        new("f2", "database", "Managed Database", "Serverless PostgreSQL with automatic scaling, branching, and point-in-time recovery.", "Branch your database alongside your code for safe schema migrations. Automatic connection pooling handles traffic spikes without configuration changes."),
        new("f3", "lock", "Auth & Identity", "Built-in authentication with OAuth, magic links, passkeys, and session management.", "Supports 30+ OAuth providers out of the box. Session tokens are stored as encrypted HTTP-only cookies with configurable expiration and refresh policies."),
        new("f4", "search", "Full-Text Search", "Typo-tolerant search across your data with faceted filtering and instant results.", "Powered by an inverted index with BM25 ranking. Supports synonyms, stop words, and custom tokenizers for domain-specific search quality."),
        new("f5", "globe", "CDN & Assets", "Global asset delivery with automatic image optimization and format conversion.", "Images are automatically converted to WebP or AVIF based on browser support. Responsive srcsets are generated on-the-fly with configurable quality and dimensions."),
        new("f6", "layers", "Preview Environments", "Every pull request gets a unique preview URL with isolated data and configuration.", "Preview environments are provisioned in under 10 seconds. Each environment includes a database branch, environment variables, and a shareable URL for stakeholder review."),
        new("f7", "code", "CLI & SDK", "Manage infrastructure from your terminal with TypeScript-first SDK and CLI tooling.", "The SDK provides full type safety with auto-generated types from your schema. CLI commands support scripting with JSON output for CI/CD pipeline integration."),
        new("f8", "settings", "Observability", "Structured logs, distributed traces, and real-time metrics with alerting built in.", "Logs are automatically enriched with request context and correlation IDs. Set up alerts on error rate thresholds, latency percentiles, or custom metric conditions."),
    ];
}
