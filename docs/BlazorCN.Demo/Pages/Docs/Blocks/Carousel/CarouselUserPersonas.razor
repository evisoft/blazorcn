@* ============================================================
   Block: carousel-user-personas
   Title: Carousel User Personas
   Description: User persona cards carousel with demographic details, goals, pain points, and behavior patterns.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/carousel/carousel-user-personas.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">User Personas</span>
            <span class="text-muted-foreground text-xs">@_personas.Length personas</span>
        </div>
        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var persona in _personas)
                    {
                        <CarouselItemCn Class="basis-full pl-3 sm:basis-1/2">
                            <div class="rounded-md border p-4">
                                <div class="mb-3 flex items-center gap-3">
                                    <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-sm font-medium">@persona.Initials</div>
                                    <div>
                                        <p class="text-sm font-medium">@persona.Name</p>
                                        <p class="text-xs text-muted-foreground">@persona.Role · @persona.Age years old</p>
                                    </div>
                                </div>
                                <div class="space-y-3">
                                    <div>
                                        <span class="mb-1 block text-xs font-medium text-muted-foreground">Goals</span>
                                        <div class="space-y-1">
                                            @foreach (var goal in persona.Goals)
                                            {
                                                <div class="flex items-center gap-2">
                                                    <LucideTargetCn Size="16" Class="size-3 shrink-0 text-emerald-600 dark:text-emerald-400" />
                                                    <span class="text-xs">@goal</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <div>
                                        <span class="mb-1 block text-xs font-medium text-muted-foreground">Pain Points</span>
                                        <div class="space-y-1">
                                            @foreach (var pain in persona.PainPoints)
                                            {
                                                <div class="flex items-center gap-2">
                                                    <LucideAlertCircleCn Size="16" Class="size-3 shrink-0 text-red-600 dark:text-red-400" />
                                                    <span class="text-xs">@pain</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Persona(string Id, string Name, string Initials, string Role, int Age, string[] Goals, string[] PainPoints);

    private readonly Persona[] _personas =
    [
        new("p1", "Alex Rivera", "AR", "Senior Developer", 32, ["Ship features faster", "Maintain code quality", "Reduce tech debt"], ["Complex configuration", "Poor documentation", "Breaking changes"]),
        new("p2", "Maya Johnson", "MJ", "Product Designer", 28, ["Consistent design language", "Rapid prototyping", "Developer handoff"], ["Design-code gaps", "Limited customization", "Slow iteration"]),
        new("p3", "Chris Park", "CP", "Engineering Manager", 38, ["Team productivity", "Standardize tooling", "Reduce onboarding time"], ["Fragmented tech stack", "License costs", "Learning curves"]),
        new("p4", "Sam Okonkwo", "SO", "Startup Founder", 34, ["Ship MVP quickly", "Minimize costs", "Professional look"], ["Limited budget", "Small team", "Too many choices"])
    ];
}
