@* ============================================================
   Block: carousel-file-browser
   Title: File Browser Document Cards Carousel
   Description: File browser document cards carousel with file type icons, sizes, modified dates, owner initials, and sharing status chips
   Dependencies: CarouselCn
   Source: original/blocks/carousel/carousel-file-browser.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Files</span>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@_files.Length items</span>
        </div>

        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var file in _files)
                    {
                        var sharingStyle = file.Sharing switch
                        {
                            "Private" => "bg-muted text-muted-foreground",
                            "Team" => "bg-blue-500/10 text-blue-600 dark:text-blue-400",
                            "Public" => "bg-amber-500/10 text-amber-600 dark:text-amber-400",
                            _ => "bg-muted text-muted-foreground",
                        };
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/3">
                            <div class="rounded-md border px-4 py-3 transition-colors hover:bg-muted/50">
                                <div class="flex items-start gap-3">
                                    <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted">
                                        @switch (file.FileType)
                                        {
                                            case "document":
                                                <LucideFileTextCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "image":
                                                <LucideImageCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "code":
                                                <LucideFileCodeCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "spreadsheet":
                                                <LucideFileSpreadsheetCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                        }
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <p class="truncate font-medium text-sm">@file.Name</p>
                                        <p class="mt-0.5 text-muted-foreground text-xs tabular-nums">@file.Size</p>
                                    </div>
                                </div>

                                <div class="mt-3 flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        <div class="flex size-5 items-center justify-center rounded bg-muted text-muted-foreground text-xs">@file.OwnerInitials</div>
                                        <span class="text-muted-foreground text-xs">@file.Modified</span>
                                    </div>
                                    <span class="@Cn.Merge("rounded px-1.5 py-0.5 text-xs", sharingStyle)">@file.Sharing</span>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record FileItem(string Id, string Name, string FileType, string Size, string Modified, string OwnerInitials, string Sharing);

    private static readonly FileItem[] _files =
    [
        new("f1", "Q1 Revenue Report.pdf", "document", "2.4 MB", "Mar 15, 2026", "SC", "Team"),
        new("f2", "product-hero-v3.png", "image", "4.8 MB", "Mar 14, 2026", "MR", "Public"),
        new("f3", "api-migration.ts", "code", "12.1 KB", "Mar 13, 2026", "JP", "Private"),
        new("f4", "Customer Metrics.xlsx", "spreadsheet", "890 KB", "Mar 12, 2026", "LJ", "Team"),
        new("f5", "Architecture Diagram.pdf", "document", "1.7 MB", "Mar 11, 2026", "AT", "Team"),
        new("f6", "dashboard-mockup.png", "image", "3.2 MB", "Mar 10, 2026", "DK", "Private"),
        new("f7", "auth-middleware.ts", "code", "8.4 KB", "Mar 9, 2026", "EW", "Private"),
        new("f8", "Team Budget 2026.xlsx", "spreadsheet", "1.1 MB", "Mar 8, 2026", "CM", "Team"),
    ];
}
