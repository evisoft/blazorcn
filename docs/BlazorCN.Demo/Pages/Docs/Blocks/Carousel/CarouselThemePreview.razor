@* ============================================================
   Block: carousel-theme-preview
   Title: Carousel Theme Preview
   Description: Theme preview carousel with color palette cards, CSS variable previews, and light/dark mode samples.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn, ButtonCn
   Source: original/blocks/carousel/carousel-theme-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucidePaletteCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Themes</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@_themes.Length themes</span>
        </div>
        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var theme in _themes)
                    {
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/3">
                            <div class="@Cn.Merge("flex h-full flex-col rounded-md border p-3", theme.IsActive ? "border-foreground" : "")">
                                <div class="mb-2 flex items-center justify-between">
                                    <span class="font-medium text-sm">@theme.Name</span>
                                    @if (theme.IsActive)
                                    {
                                        <span class="rounded bg-foreground px-1.5 py-0.5 text-xs text-background">Active</span>
                                    }
                                </div>
                                <div class="mb-3 flex gap-1.5">
                                    @foreach (var color in theme.Colors)
                                    {
                                        <div class="size-6 rounded-full border" style="@("background-color: " + color)"></div>
                                    }
                                </div>
                                <p class="mb-3 flex-1 text-xs text-muted-foreground">@theme.Description</p>
                                <ButtonCn Variant="@(theme.IsActive ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Sm" Class="h-7 w-full text-xs" Disabled="@theme.IsActive">
                                    @(theme.IsActive ? "Current theme" : "Apply theme")
                                </ButtonCn>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Theme(string Id, string Name, string Description, string[] Colors, bool IsActive);

    private readonly Theme[] _themes =
    [
        new("t1", "Default", "Clean neutral theme with zinc gray tones and sharp contrast.", ["#09090b", "#ffffff", "#71717a", "#e4e4e7"], true),
        new("t2", "Ocean", "Cool blue palette inspired by deep ocean waters.", ["#0c4a6e", "#e0f2fe", "#0284c7", "#7dd3fc"], false),
        new("t3", "Forest", "Earthy green tones with warm amber accents.", ["#14532d", "#f0fdf4", "#16a34a", "#86efac"], false),
        new("t4", "Sunset", "Warm orange and rose gradient with golden highlights.", ["#7c2d12", "#fff7ed", "#ea580c", "#fdba74"], false),
        new("t5", "Midnight", "Deep purple theme with violet accents for dark mode lovers.", ["#2e1065", "#faf5ff", "#7c3aed", "#c4b5fd"], false)
    ];
}
