@* ============================================================
   Block: carousel-changelog
   Title: Animated Product Changelog Carousel
   Description: Product changelog carousel with version badges, release notes, and type chips
   Dependencies: CarouselCn
   Source: original/blocks/carousel/carousel-changelog.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideCircleArrowUpCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Changelog</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                @_releases[0].Version
            </span>
        </div>

        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var release in _releases)
                    {
                        <CarouselItemCn Class="basis-full pl-3">
                            <div class="rounded-md border p-4">
                                <div class="mb-3 flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        <span class="rounded bg-foreground px-1.5 py-0.5 text-xs font-medium text-background">@release.Version</span>
                                        <span class="text-xs text-muted-foreground">@release.Date</span>
                                    </div>
                                    <span class="flex items-center gap-1 rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                        @switch (release.Type)
                                        {
                                            case "Feature":
                                                <LucideSparklesCn Size="12" Class="size-3" />
                                                break;
                                            case "Fix":
                                                <LucideBugCn Size="12" Class="size-3" />
                                                break;
                                            case "Improvement":
                                                <LucideWrenchCn Size="12" Class="size-3" />
                                                break;
                                        }
                                        @release.Type
                                    </span>
                                </div>

                                <p class="mb-3 text-sm font-medium">@release.Title</p>

                                <div class="space-y-2">
                                    @foreach (var change in release.Changes)
                                    {
                                        <div class="flex items-start gap-2">
                                            <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-muted-foreground/40"></span>
                                            <span class="text-xs text-muted-foreground leading-relaxed">@change</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record ReleaseItem(string Id, string Version, string Title, string Date, string Type, string[] Changes);

    private static readonly ReleaseItem[] _releases =
    [
        new("r1", "v2.4.0", "Collaborative Editing", "Mar 12, 2026", "Feature",
            ["Real-time multiplayer editing with conflict resolution", "Presence indicators showing active collaborators", "Comment threads on any block or selection", "Version history with named snapshots"]),
        new("r2", "v2.3.2", "Performance Fixes", "Mar 5, 2026", "Fix",
            ["Fixed memory leak in WebSocket reconnection logic", "Resolved race condition in concurrent API mutations", "Corrected timezone handling for scheduled exports"]),
        new("r3", "v2.3.0", "Advanced Filtering", "Feb 24, 2026", "Feature",
            ["Compound filter builder with AND/OR logic", "Saved filter presets with keyboard shortcuts", "Filter by date ranges, tags, and custom fields", "Bulk actions on filtered results"]),
        new("r4", "v2.2.1", "Dashboard Polish", "Feb 15, 2026", "Improvement",
            ["Redesigned sidebar navigation with collapsible sections", "Improved loading skeleton animations", "Reduced bundle size by 18% with tree-shaking optimizations"]),
        new("r5", "v2.2.0", "API v2 & Webhooks", "Feb 3, 2026", "Feature",
            ["RESTful API v2 with OpenAPI 3.1 spec", "Webhook delivery with automatic retries and signing", "Rate limiting with configurable quotas per API key", "Interactive API explorer in the dashboard"]),
        new("r6", "v2.1.0", "SSO & Audit Logs", "Jan 20, 2026", "Feature",
            ["SAML 2.0 and OIDC single sign-on support", "Comprehensive audit log with exportable CSV", "IP allowlisting for workspace access control"]),
    ];
}
