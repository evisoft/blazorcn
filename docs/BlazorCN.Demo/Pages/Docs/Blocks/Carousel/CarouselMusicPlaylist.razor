@* ============================================================
   Block: carousel-music-playlist
   Title: Carousel Music Playlist
   Description: Music playlist carousel with track numbers, song titles, artists, albums, durations, genre chips, and play/pause buttons.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn, ButtonCn
   Source: original/blocks/carousel/carousel-music-playlist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideListMusicCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Curated Playlist</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                @_tracks.Length tracks
            </span>
        </div>

        <div class="py-1">
            <CarouselCn>
                <CarouselContentCn>
                    @for (var slideIndex = 0; slideIndex < _slides.Length; slideIndex++)
                    {
                        var slideGroup = _slides[slideIndex];
                        <CarouselItemCn Class="basis-full">
                            <div>
                                @for (var trackIndex = 0; trackIndex < slideGroup.Length; trackIndex++)
                                {
                                    var track = slideGroup[trackIndex];
                                    var isLast = trackIndex == slideGroup.Length - 1;
                                    var isPlaying = _playing == track.Id;
                                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                                        <span class="w-5 text-right text-xs text-muted-foreground tabular-nums">@track.Number</span>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 shrink-0 p-0" OnClick="@(() => TogglePlaying(track.Id))" aria-label="@($"{(isPlaying ? "Pause" : "Play")} {track.Title}")">
                                            @if (isPlaying)
                                            {
                                                <LucidePauseCn Size="16" Class="size-3.5" />
                                            }
                                            else
                                            {
                                                <LucidePlayCn Size="16" Class="size-3.5" />
                                            }
                                        </ButtonCn>
                                        <div class="min-w-0 flex-1">
                                            <p class="@Cn.Merge("truncate text-sm", isPlaying ? "font-medium" : "")">@track.Title</p>
                                            <p class="truncate text-xs text-muted-foreground">@track.Artist · @track.Album</p>
                                        </div>
                                        <span class="hidden rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground sm:inline">@track.Genre</span>
                                        <span class="w-10 text-right text-xs text-muted-foreground tabular-nums">@track.Duration</span>
                                    </div>
                                }
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="flex items-center justify-center gap-2 border-t px-4 py-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <span class="text-xs text-muted-foreground">@_slides.Length pages</span>
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Track(string Id, int Number, string Title, string Artist, string Album, string Duration, string Genre);

    private string? _playing;

    private void TogglePlaying(string id) => _playing = _playing == id ? null : id;

    private readonly Track[] _tracks =
    [
        new("t1", 1, "Northern Light", "Sigrid Aase", "Polar Sessions", "3:42", "Electronic"),
        new("t2", 2, "Concrete Garden", "The Narrows", "Urban Decay", "4:18", "Indie"),
        new("t3", 3, "Midnight Architecture", "Kael Driften", "Blueprint", "5:03", "Ambient"),
        new("t4", 4, "Rust and Gold", "Marina Vega", "Oxidize", "3:29", "Folk"),
        new("t5", 5, "Phase Shift", "Echo Terminal", "Frequency", "4:55", "Electronic"),
        new("t6", 6, "Glass Mountains", "Yuna Park", "Refraction", "3:17", "Indie"),
        new("t7", 7, "Slow Collapse", "Drift Theory", "Entropy", "6:12", "Post-Rock"),
        new("t8", 8, "Copper Wire", "Lena Torres", "Conductor", "3:48", "Folk"),
        new("t9", 9, "Digital Rain", "Neon Lattice", "Cascade", "4:31", "Electronic"),
        new("t10", 10, "Last Frequency", "The Narrows", "Urban Decay", "5:44", "Indie")
    ];

    private Track[][] _slides => _tracks.Chunk(5).ToArray();
}
