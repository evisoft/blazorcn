@* ============================================================
   Block: carousel-achievement-badges
   Title: Achievement Badges Carousel
   Description: Gamification achievement badge carousel with badge names, point values, rarity chips, earned indicators, and progress percentages
   Dependencies: CarouselCn, LucideCheckCn, LucideLockCn
   Source: original/blocks/carousel/carousel-achievement-badges.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Achievements</span>
            <span class="text-muted-foreground text-xs">
                @_earnedCount/@_badges.Length earned · @_totalPoints.ToString("N0") pts
            </span>
        </div>

        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var badge in _badges)
                    {
                        <CarouselItemCn Class="basis-[60%] pl-3 sm:basis-1/3 lg:basis-1/4">
                            <div>
                                <div class="@Cn.Merge("overflow-hidden rounded-md border", !badge.Earned ? "opacity-70" : "")">
                                    <div class="px-3 py-3">
                                        <div class="mb-1.5 flex items-center justify-between">
                                            <span class="font-medium text-sm">@badge.Name</span>
                                            @if (badge.Earned)
                                            {
                                                <LucideCheckCn Size="14" Class="size-3.5 shrink-0 text-emerald-600 dark:text-emerald-400" />
                                            }
                                            else
                                            {
                                                <LucideLockCn Size="14" Class="size-3.5 shrink-0 text-muted-foreground/40" />
                                            }
                                        </div>
                                        <p class="text-muted-foreground text-xs leading-relaxed">
                                            @badge.Description
                                        </p>
                                    </div>

                                    <div class="flex items-center justify-between border-t px-3 py-2.5">
                                        <span class="font-semibold text-xs tabular-nums">
                                            @badge.Points pts
                                        </span>
                                        <span class="@Cn.Merge("rounded px-1.5 py-0.5 text-xs", _rarityStyle[badge.Rarity])">
                                            @badge.Rarity
                                        </span>
                                    </div>

                                    <div class="border-t px-3 py-2.5">
                                        <div class="mb-1 flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Progress</span>
                                            <span class="font-medium text-xs tabular-nums">
                                                @(badge.Progress)%
                                            </span>
                                        </div>
                                        <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                                            <div class="h-full rounded-full bg-foreground" style="@($"width: {badge.Progress}%")"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record AchievementBadge(string Id, string Name, string Description, int Points, string Rarity, bool Earned, int Progress);

    private static readonly Dictionary<string, string> _rarityStyle = new()
    {
        ["Common"] = "bg-muted text-muted-foreground",
        ["Rare"] = "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        ["Epic"] = "bg-purple-500/10 text-purple-600 dark:text-purple-400",
        ["Legendary"] = "bg-amber-500/10 text-amber-600 dark:text-amber-400"
    };

    private static readonly AchievementBadge[] _badges =
    [
        new("b1", "First Commit", "Push your first commit to any project repository.", 10, "Common", true, 100),
        new("b2", "Bug Squasher", "Close 10 bug reports with verified fixes.", 50, "Common", true, 100),
        new("b3", "Code Reviewer", "Complete 25 pull request reviews with actionable feedback.", 75, "Rare", true, 100),
        new("b4", "Streak Master", "Maintain a 30-day contribution streak without breaks.", 100, "Rare", false, 73),
        new("b5", "Documentation Hero", "Write or update 20 documentation pages with examples.", 120, "Rare", false, 55),
        new("b6", "Performance Guru", "Optimize 5 critical paths reducing latency by over 50%.", 200, "Epic", false, 40),
        new("b7", "Mentor", "Successfully onboard 3 new team members through pair programming.", 250, "Epic", true, 100),
        new("b8", "Open Source Champion", "Get 5 contributions merged into upstream open source projects.", 300, "Epic", false, 60),
        new("b9", "Zero Downtime", "Deploy 50 production releases with zero rollbacks.", 500, "Legendary", false, 34),
        new("b10", "Architect", "Design and ship 3 system-level features used by every team.", 750, "Legendary", false, 22),
        new("b11", "Community Star", "Receive 100 upvotes on internal knowledge base articles.", 150, "Rare", false, 68),
        new("b12", "Founder Badge", "Be part of the team during the first year of the company.", 1000, "Legendary", true, 100)
    ];

    private static readonly int _earnedCount = _badges.Count(b => b.Earned);
    private static readonly int _totalPoints = _badges.Where(b => b.Earned).Sum(b => b.Points);
}
