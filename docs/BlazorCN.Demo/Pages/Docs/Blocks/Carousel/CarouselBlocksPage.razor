        new(""s5"", ""Create composite indexes"", ""Adds performance indexes on frequently queried column combinations for the dashboard queries"", ""CREATE INDEX CONCURRENTLY idx_users_v2_ws\n  ON users_v2(workspace_id, created_at DESC);"", ""~15s"", ""low"", true, ""pending""),
        new(""s6"", ""Drop legacy users table"", ""Removes the original users table after verifying all data has been successfully migrated to users_v2"", ""-- Verify row counts match before dropping\nDROP TABLE users;\nALTER TABLE users_v2 RENAME TO users;"", ""~5s"", ""high"", false, ""pending"")
    ];

