@* ============================================================
   Block: carousel-loyalty-tiers
   Title: Carousel Loyalty Tiers
   Description: Loyalty program tiers carousel with tier cards, points thresholds, perks checklists, and current tier highlighting.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn, ButtonCn
   Source: original/blocks/carousel/carousel-loyalty-tiers.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Loyalty Program</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Your current tier: Silver</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                @_tiers.Length tiers
            </span>
        </div>

        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var tier in _tiers)
                    {
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/4">
                            <div class="@Cn.Merge("flex h-full flex-col rounded-md border p-3", tier.IsCurrent ? "border-foreground" : "")">
                                <div class="mb-2 flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        <LucideStarCn Size="16" Class="size-3.5 text-muted-foreground" />
                                        <p class="text-sm font-medium">@tier.Name</p>
                                    </div>
                                    @if (tier.IsCurrent)
                                    {
                                        <span class="rounded bg-foreground px-1.5 py-0.5 text-xs text-background">Current</span>
                                    }
                                </div>
                                <div class="mb-0.5 flex items-baseline gap-0.5">
                                    <span class="text-xl font-semibold tabular-nums">@tier.PointsThreshold.ToString("N0")</span>
                                    <span class="text-xs text-muted-foreground">pts</span>
                                </div>
                                <p class="mb-3 text-xs text-muted-foreground">Points to qualify</p>
                                <div class="mb-3 flex-1 space-y-1.5">
                                    @foreach (var perk in tier.Perks)
                                    {
                                        <div class="flex items-center gap-2">
                                            <LucideCheckCn Size="16" Class="size-3.5 shrink-0 text-muted-foreground" />
                                            <span class="text-xs">@perk</span>
                                        </div>
                                    }
                                </div>
                                <ButtonCn Variant="@(tier.IsCurrent ? ButtonVariant.Default : ButtonVariant.Outline)"
                                          Size="ButtonSize.Sm"
                                          Class="h-7 w-full text-xs"
                                          Disabled="@tier.IsCurrent">
                                    @(tier.IsCurrent ? "Current tier" : "View details")
                                </ButtonCn>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record LoyaltyTier(string Id, string Name, int PointsThreshold, string[] Perks, bool IsCurrent);

    private readonly LoyaltyTier[] _tiers =
    [
        new("t1", "Bronze", 0, ["Earn 1 point per $1", "Birthday reward", "Member-only pricing"], false),
        new("t2", "Silver", 2500, ["Earn 1.5 points per $1", "Free standard shipping", "Early sale access", "Birthday double points"], true),
        new("t3", "Gold", 10000, ["Earn 2 points per $1", "Free express shipping", "Priority support", "Exclusive member events"], false),
        new("t4", "Platinum", 25000, ["Earn 3 points per $1", "Free overnight shipping", "Dedicated account manager", "Annual gift package"], false)
    ];
}
