@* ============================================================
   Block: carousel-product-showcase
   Title: Carousel Product Showcase
   Description: Product showcase carousel with product cards, pricing, category chips, and descriptions.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn, ButtonCn
   Source: original/blocks/carousel/carousel-product-showcase.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Products</span>
            <span class="text-muted-foreground text-xs">@_products.Length products</span>
        </div>
        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var product in _products)
                    {
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/4">
                            <div class="flex h-full flex-col rounded-md border p-3">
                                <div class="mb-3 flex items-center justify-between">
                                    <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@product.Category</span>
                                </div>
                                <p class="mb-1 text-sm font-medium">@product.Name</p>
                                <p class="mb-3 flex-1 text-xs text-muted-foreground leading-relaxed">@product.Description</p>
                                <div class="flex items-center justify-between">
                                    <div class="flex items-baseline gap-0.5">
                                        <span class="text-lg font-semibold tabular-nums">$@product.Price</span>
                                        <span class="text-xs text-muted-foreground">/mo</span>
                                    </div>
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Learn more</ButtonCn>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Product(string Id, string Name, string Description, int Price, string Category);

    private readonly Product[] _products =
    [
        new("p1", "Edge Functions", "Deploy serverless functions at the edge with zero cold starts and global distribution.", 29, "Compute"),
        new("p2", "Vector Database", "High-performance vector storage for embeddings with real-time similarity search.", 49, "Storage"),
        new("p3", "Auth Shield", "Enterprise authentication with SSO, MFA, and role-based access control built in.", 39, "Security"),
        new("p4", "GPU Instances", "On-demand GPU compute for ML inference and training with auto-scaling.", 199, "Compute"),
        new("p5", "CDN Pro", "Global content delivery with smart caching, image optimization, and analytics.", 59, "Network"),
        new("p6", "Log Stream", "Real-time log aggregation with full-text search, alerting, and dashboard visualizations.", 35, "Observability")
    ];
}
