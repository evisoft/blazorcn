@* ============================================================
   Block: carousel-permission-roles
   Title: Carousel Permission Roles
   Description: Permission and role management carousel with role cards, user counts, permission checklists, and role descriptions.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/carousel/carousel-permission-roles.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Roles &amp; permissions</span>
            <span class="text-muted-foreground text-xs">@_roles.Length roles · @_totalUsers users</span>
        </div>

        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var role in _roles)
                    {
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/3">
                            <div class="overflow-hidden rounded-md border">
                                <div class="px-3 py-3">
                                    <div class="mb-1 flex items-center justify-between">
                                        <span class="font-medium text-sm">@role.Name</span>
                                        <span class="font-semibold text-xs tabular-nums text-muted-foreground">@role.UserCount users</span>
                                    </div>
                                    <p class="text-muted-foreground text-xs leading-relaxed">@role.Description</p>
                                </div>
                                <div class="border-t px-3 py-2.5">
                                    <span class="mb-2 block font-medium text-muted-foreground text-xs">Permissions</span>
                                    <div class="space-y-1.5">
                                        @foreach (var perm in role.Permissions)
                                        {
                                            <div class="flex items-center gap-2">
                                                @if (perm.Granted)
                                                {
                                                    <LucideCheckCn Size="16" Class="size-3.5 shrink-0 text-emerald-600 dark:text-emerald-400" />
                                                }
                                                else
                                                {
                                                    <LucideXCn Size="16" Class="size-3.5 shrink-0 text-muted-foreground/40" />
                                                }
                                                <span class="@(perm.Granted ? "text-xs text-foreground" : "text-xs text-muted-foreground/60")">@perm.Name</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Permission(string Name, bool Granted);
    private record Role(string Id, string Name, int UserCount, string Description, Permission[] Permissions);

    private readonly Role[] _roles =
    [
        new("r1", "Admin", 3, "Full system access including user management, billing, and configuration.", [new("Manage users", true), new("Edit content", true), new("View analytics", true), new("Access billing", true), new("Delete resources", true)]),
        new("r2", "Editor", 12, "Create and edit content across all projects. Cannot manage users or billing.", [new("Manage users", false), new("Edit content", true), new("View analytics", true), new("Access billing", false), new("Delete resources", true)]),
        new("r3", "Viewer", 48, "Read-only access to content and dashboards. Cannot modify any resources.", [new("Manage users", false), new("Edit content", false), new("View analytics", true), new("Access billing", false), new("Delete resources", false)]),
        new("r4", "Billing", 2, "Manage subscriptions, invoices, and payment methods. No content access.", [new("Manage users", false), new("Edit content", false), new("View analytics", true), new("Access billing", true), new("Delete resources", false)]),
        new("r5", "Custom", 7, "Tailored permissions set by an administrator for specific team workflows.", [new("Manage users", false), new("Edit content", true), new("View analytics", true), new("Access billing", false), new("Delete resources", false)])
    ];

    private int _totalUsers => _roles.Sum(r => r.UserCount);
}
