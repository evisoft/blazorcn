@* ============================================================
   Block: carousel-workflow-templates
   Title: Carousel Workflow Templates
   Description: Workflow template carousel with automation cards, step counts, category labels, and use-case descriptions.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn, ButtonCn
   Source: original/blocks/carousel/carousel-workflow-templates.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideWorkflowCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Workflow Templates</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@_templates.Length templates</span>
        </div>
        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var template in _templates)
                    {
                        <CarouselItemCn Class="basis-full pl-3 sm:basis-1/2 lg:basis-1/3">
                            <div class="flex h-full flex-col rounded-md border p-3">
                                <div class="mb-2 flex items-center gap-2">
                                    <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@template.Category</span>
                                    <span class="text-xs text-muted-foreground">@template.Steps steps</span>
                                </div>
                                <p class="mb-1 text-sm font-medium">@template.Name</p>
                                <p class="mb-3 flex-1 text-xs text-muted-foreground leading-relaxed">@template.Description</p>
                                <div class="flex items-center justify-between">
                                    <span class="text-xs text-muted-foreground">@template.UsedBy uses</span>
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Use template</ButtonCn>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record WorkflowTemplate(string Id, string Name, string Category, int Steps, string Description, string UsedBy);

    private readonly WorkflowTemplate[] _templates =
    [
        new("t1", "CI/CD Pipeline", "DevOps", 6, "Automated build, test, and deployment pipeline with staging and production environments.", "2.4K"),
        new("t2", "Bug Report Triage", "Engineering", 4, "Automatically categorize, prioritize, and assign incoming bug reports to the right team.", "1.8K"),
        new("t3", "Customer Onboarding", "Sales", 8, "Welcome sequence with account setup, product tour, and first-value milestone tracking.", "3.1K"),
        new("t4", "Content Approval", "Marketing", 5, "Multi-stage content review with editor, legal, and final approval before publishing.", "1.2K"),
        new("t5", "Incident Response", "Operations", 7, "Automated alerting, escalation, communication, and post-mortem creation for incidents.", "2.7K"),
        new("t6", "Employee Offboarding", "HR", 9, "Systematic access revocation, equipment return, and exit interview scheduling.", "890")
    ];
}
