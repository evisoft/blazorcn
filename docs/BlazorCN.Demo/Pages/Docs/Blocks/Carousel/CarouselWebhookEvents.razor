@* ============================================================
   Block: carousel-webhook-events
   Title: Carousel Webhook Events
   Description: Webhook events log carousel with event type chips, HTTP method badges, status codes, and payload previews.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/carousel/carousel-webhook-events.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideWebhookCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Webhook Events</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@_events.Length events</span>
        </div>
        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var evt in _events)
                    {
                        <CarouselItemCn Class="basis-full pl-3">
                            <div class="rounded-md border p-4">
                                <div class="mb-3 flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        <span class="rounded bg-blue-500/10 px-1.5 py-0.5 text-xs font-medium text-blue-700 dark:text-blue-400">@evt.Method</span>
                                        <span class="font-mono text-xs text-muted-foreground">@evt.EventType</span>
                                    </div>
                                    <span class="@Cn.Merge("rounded px-1.5 py-0.5 text-xs font-medium", evt.StatusCode < 300 ? "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400" : "bg-red-500/10 text-red-700 dark:text-red-400")">@evt.StatusCode</span>
                                </div>
                                <p class="mb-2 text-sm font-medium">@evt.Description</p>
                                <div class="flex items-center gap-3 text-xs text-muted-foreground">
                                    <span>@evt.Time</span>
                                    <span>@(evt.Duration)ms</span>
                                    <span>@evt.Endpoint</span>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record WebhookEvent(string Id, string EventType, string Method, int StatusCode, string Description, string Time, int Duration, string Endpoint);

    private readonly WebhookEvent[] _events =
    [
        new("e1", "payment.completed", "POST", 200, "Payment of $49.99 processed successfully", "2 min ago", 124, "/api/webhooks/stripe"),
        new("e2", "user.created", "POST", 200, "New user registration from OAuth provider", "15 min ago", 89, "/api/webhooks/auth"),
        new("e3", "invoice.failed", "POST", 200, "Invoice payment attempt failed - card declined", "1 hour ago", 156, "/api/webhooks/stripe"),
        new("e4", "deployment.completed", "POST", 200, "Production deployment v2.4.1 completed", "3 hours ago", 203, "/api/webhooks/vercel"),
        new("e5", "issue.updated", "POST", 500, "Internal server error processing issue update", "5 hours ago", 5012, "/api/webhooks/linear"),
        new("e6", "subscription.renewed", "POST", 200, "Annual subscription renewed for Pro plan", "1 day ago", 98, "/api/webhooks/stripe")
    ];
}
