@* ============================================================
   Block: carousel-testimonial
   Title: Carousel Testimonial
   Description: Testimonial carousel with customer quotes, company logos as initials, star ratings, and role descriptions.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/carousel/carousel-testimonial.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Testimonials</span>
            <span class="text-muted-foreground text-xs">@_testimonials.Length reviews</span>
        </div>
        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var t in _testimonials)
                    {
                        <CarouselItemCn Class="basis-full pl-3">
                            <div class="rounded-md border p-4">
                                <div class="mb-3 flex items-center gap-1">
                                    @for (var i = 0; i < 5; i++)
                                    {
                                        <LucideStarCn Size="16" Class="@(i < t.Rating ? "size-3.5 fill-amber-400 text-amber-400" : "size-3.5 text-muted-foreground/30")" />
                                    }
                                </div>
                                <p class="mb-4 text-sm leading-relaxed italic">"@t.Quote"</p>
                                <div class="flex items-center gap-3">
                                    <div class="flex size-10 items-center justify-center rounded-full bg-muted text-sm font-medium">@t.Initials</div>
                                    <div>
                                        <p class="text-sm font-medium">@t.Name</p>
                                        <p class="text-xs text-muted-foreground">@t.Role at @t.Company</p>
                                    </div>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Name, string Initials, string Role, string Company, string Quote, int Rating);

    private readonly Testimonial[] _testimonials =
    [
        new("t1", "Sarah Chen", "SC", "VP Engineering", "Vercel", "This component library cut our development time in half. The API design is intuitive and the documentation is outstanding.", 5),
        new("t2", "Marcus Rivera", "MR", "CTO", "Linear", "We evaluated five component libraries and this was the clear winner. Performance, accessibility, and DX are all best-in-class.", 5),
        new("t3", "Aisha Patel", "AP", "Lead Designer", "Stripe", "The theming system gave us the flexibility to match our brand perfectly while maintaining consistency across 40+ components.", 5),
        new("t4", "Liam Bennett", "LB", "Senior Engineer", "Shopify", "Migrating from our custom components was seamless. The migration guide covered every edge case we encountered.", 4),
        new("t5", "Yuki Tanaka", "YT", "Product Designer", "Figma", "Finally a library where accessibility is not an afterthought. We passed our WCAG audit without any custom work.", 5)
    ];
}
