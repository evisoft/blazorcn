@* ============================================================
   Block: carousel-recipe-cards
   Title: Carousel Recipe Cards
   Description: Recipe cards carousel with prep/cook times, difficulty chips, serving counts, and ingredient totals.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/carousel/carousel-recipe-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideChefHatCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Recipes</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@_recipes.Length recipes</span>
        </div>
        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var recipe in _recipes)
                    {
                        <CarouselItemCn Class="basis-full pl-3 sm:basis-1/2 lg:basis-1/3">
                            <div class="flex h-full flex-col rounded-md border p-3">
                                <div class="mb-2 flex items-center gap-2">
                                    <span class="@Cn.Merge("rounded px-1.5 py-0.5 text-xs", _difficultyStyle[recipe.Difficulty])">@recipe.Difficulty</span>
                                </div>
                                <p class="mb-2 text-sm font-medium leading-snug">@recipe.Name</p>
                                <p class="mb-3 flex-1 text-xs text-muted-foreground leading-relaxed">@recipe.Description</p>
                                <div class="flex items-center gap-3 text-xs text-muted-foreground">
                                    <div class="flex items-center gap-1">
                                        <LucideClockCn Size="16" Class="size-3 text-muted-foreground" />
                                        <span>@recipe.PrepTime prep</span>
                                    </div>
                                    <span>·</span>
                                    <span>@recipe.CookTime cook</span>
                                </div>
                                <div class="mt-2 flex items-center justify-between text-xs text-muted-foreground">
                                    <span>@recipe.Servings servings</span>
                                    <span>@recipe.Ingredients ingredients</span>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Recipe(string Id, string Name, string PrepTime, string CookTime, string Difficulty, int Servings, int Ingredients, string Description);

    private static readonly Dictionary<string, string> _difficultyStyle = new()
    {
        ["Easy"] = "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        ["Medium"] = "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        ["Hard"] = "bg-red-500/10 text-red-600 dark:text-red-400"
    };

    private readonly Recipe[] _recipes =
    [
        new("r1", "Miso-Glazed Salmon with Sesame Rice", "15 min", "20 min", "Easy", 4, 9, "Pan-seared salmon with a caramelized white miso glaze served over toasted sesame rice with pickled cucumber."),
        new("r2", "Handmade Orecchiette with Broccoli Rabe", "45 min", "12 min", "Medium", 3, 7, "Fresh pasta shaped by hand, tossed with sauteed broccoli rabe, garlic, chili flakes, and pecorino romano."),
        new("r3", "Thai Basil Chicken Stir-Fry", "10 min", "8 min", "Easy", 2, 10, "Wok-fired chicken with Thai basil, bird's eye chilies, fish sauce, and oyster sauce over jasmine rice."),
        new("r4", "Lamb Shank Tagine", "20 min", "3 hr", "Medium", 4, 14, "Slow-braised lamb shanks with preserved lemon, saffron, apricots, and chickpeas in a spiced tomato broth."),
        new("r5", "Souffle au Chocolat", "25 min", "14 min", "Hard", 4, 6, "Classic French chocolate souffle with a molten center, served immediately with creme anglaise."),
        new("r6", "Grilled Octopus with Chimichurri", "30 min", "45 min", "Medium", 4, 11, "Tender grilled octopus with vibrant herb chimichurri, crispy potatoes, and charred lemon.")
    ];
}
