@* ============================================================
   Block: carousel-payment-methods
   Title: Carousel Payment Methods
   Description: Payment method carousel with card type display, masked digits, expiry dates, cardholder names, and default indicator.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn, ButtonCn
   Source: original/blocks/carousel/carousel-payment-methods.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Payment Methods</p>
                <p class="mt-0.5 text-xs text-muted-foreground">@_cards.Count cards saved</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">Billing</span>
        </div>

        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var card in _cards)
                    {
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/3">
                            <div class="@Cn.Merge("flex h-full flex-col rounded-md border p-3", card.IsDefault ? "border-foreground" : "")">
                                <div class="mb-3 flex items-center justify-between">
                                    <LucideCreditCardCn Size="16" Class="size-4 text-muted-foreground" />
                                    @if (card.IsDefault)
                                    {
                                        <span class="rounded bg-foreground px-1.5 py-0.5 text-xs text-background">Default</span>
                                    }
                                </div>
                                <p class="text-sm font-medium">@card.Type</p>
                                <p class="mt-1 font-mono text-xs text-muted-foreground">@($"•••• •••• •••• {card.Last4}")</p>
                                <div class="mt-3 flex items-center justify-between text-xs text-muted-foreground">
                                    <span>Expires @card.Expiry</span>
                                </div>
                                <p class="mt-1 text-xs text-muted-foreground">@card.Holder</p>
                                @if (!card.IsDefault)
                                {
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-3 h-7 w-full text-xs" OnClick="@(() => SetDefault(card.Id))">
                                        Set default
                                    </ButtonCn>
                                }
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record PaymentCard(string Id, string Type, string Last4, string Expiry, string Holder, bool IsDefault);

    private List<PaymentCard> _cards =
    [
        new("c1", "Visa", "4242", "09/27", "Alex Morgan", true),
        new("c2", "Mastercard", "8831", "03/26", "Alex Morgan", false),
        new("c3", "Amex", "1005", "12/28", "Alex Morgan", false),
        new("c4", "Visa", "7629", "06/27", "Morgan LLC", false),
        new("c5", "Mastercard", "3344", "11/26", "Alex Morgan", false),
        new("c6", "Visa", "9010", "02/29", "Morgan LLC", false)
    ];

    private void SetDefault(string id)
    {
        _cards = _cards.Select(c => c with { IsDefault = c.Id == id }).ToList();
    }
}
