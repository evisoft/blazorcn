@* ============================================================
   Block: carousel-leaderboard
   Title: Carousel Leaderboard
   Description: Ranking leaderboard carousel with weekly, monthly, and all-time periods, top 5 user rankings, initials avatars, and score counters.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/carousel/carousel-leaderboard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Leaderboard</span>
            <span class="text-muted-foreground text-xs">@_periods.Length periods</span>
        </div>

        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var period in _periods)
                    {
                        <CarouselItemCn Class="pl-3">
                            <div class="overflow-hidden rounded-md border">
                                <div class="border-b px-4 py-2.5">
                                    <span class="font-medium text-sm">@period.Label</span>
                                </div>
                                <div>
                                    @for (var i = 0; i < period.Users.Length; i++)
                                    {
                                        var user = period.Users[i];
                                        var isLast = i == period.Users.Length - 1;
                                        var dotColor = _medalColor.GetValueOrDefault(i, "bg-muted-foreground/30");
                                        <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                                            <div class="flex items-center gap-2">
                                                <span class="@Cn.Merge("size-2 rounded-full", dotColor)"></span>
                                                <span class="w-5 text-right font-medium text-xs tabular-nums text-muted-foreground">
                                                    @(i + 1)
                                                </span>
                                            </div>
                                            <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                                                @user.Initials
                                            </div>
                                            <span class="min-w-0 flex-1 truncate text-sm">@user.Name</span>
                                            <span class="font-semibold text-sm tabular-nums">
                                                @user.Score.ToString("N0")
                                            </span>
                                            <div class="flex w-12 items-center justify-end gap-0.5">
                                                @if (user.Change > 0)
                                                {
                                                    <LucideArrowUpCn Size="16" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                                                    <span class="text-xs tabular-nums text-emerald-600 dark:text-emerald-400">@user.Change</span>
                                                }
                                                else if (user.Change < 0)
                                                {
                                                    <LucideArrowDownCn Size="16" Class="size-3 text-red-600 dark:text-red-400" />
                                                    <span class="text-xs tabular-nums text-red-600 dark:text-red-400">@Math.Abs(user.Change)</span>
                                                }
                                                else
                                                {
                                                    <LucideMinusCn Size="16" Class="size-3 text-muted-foreground/40" />
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record LeaderboardUser(string Id, string Name, string Initials, int Score, int Change);
    private record Period(string Id, string Label, LeaderboardUser[] Users);

    private static readonly Dictionary<int, string> _medalColor = new()
    {
        [0] = "bg-amber-500",
        [1] = "bg-zinc-400",
        [2] = "bg-amber-700"
    };

    private readonly Period[] _periods =
    [
