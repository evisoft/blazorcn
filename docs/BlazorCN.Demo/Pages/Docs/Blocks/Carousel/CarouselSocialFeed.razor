@* ============================================================
   Block: carousel-social-feed
   Title: Carousel Social Feed
   Description: Social media feed carousel with post cards, author avatars, like/comment counts, and timestamps.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/carousel/carousel-social-feed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <p class="text-sm font-medium">Social Feed</p>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@_posts.Length posts</span>
        </div>
        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var post in _posts)
                    {
                        <CarouselItemCn Class="basis-full pl-3">
                            <div class="rounded-md border p-4">
                                <div class="mb-3 flex items-center gap-3">
                                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@post.Initials</div>
                                    <div>
                                        <p class="text-sm font-medium">@post.Author</p>
                                        <p class="text-xs text-muted-foreground">@post.Handle · @post.Time</p>
                                    </div>
                                </div>
                                <p class="mb-3 text-sm leading-relaxed">@post.Content</p>
                                <div class="flex items-center gap-4 text-xs text-muted-foreground">
                                    <div class="flex items-center gap-1">
                                        <LucideHeartCn Size="16" Class="size-3.5" />
                                        <span class="tabular-nums">@post.Likes</span>
                                    </div>
                                    <div class="flex items-center gap-1">
                                        <LucideMessageCircleCn Size="16" Class="size-3.5" />
                                        <span class="tabular-nums">@post.Comments</span>
                                    </div>
                                    <div class="flex items-center gap-1">
                                        <LucideRepeatCn Size="16" Class="size-3.5" />
                                        <span class="tabular-nums">@post.Shares</span>
                                    </div>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Post(string Id, string Author, string Handle, string Initials, string Content, string Time, int Likes, int Comments, int Shares);

    private readonly Post[] _posts =
    [
        new("p1", "Sarah Chen", "@@sarachen", "SC", "Just shipped the new component library v2. Six months of work and I could not be more proud of this team. The performance improvements alone are worth the upgrade.", "2h ago", 234, 42, 18),
        new("p2", "Marcus Rivera", "@@mrivera", "MR", "Hot take: the best developer experience is the one you do not notice. If your tooling requires a tutorial, it is already too complex.", "5h ago", 891, 156, 73),
        new("p3", "Aisha Patel", "@@aishapatel", "AP", "We just hit 10,000 stars on GitHub. When we started this project two years ago, we never imagined this kind of community support. Thank you all.", "8h ago", 1243, 89, 201),
        new("p4", "Liam Bennett", "@@liambennett", "LB", "Spent the weekend migrating our entire frontend to server components. The initial page load improvement is dramatic. Write-up coming soon.", "1d ago", 445, 67, 34)
    ];
}
