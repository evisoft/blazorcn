@* ============================================================
   Block: carousel-movie-cards
   Title: Carousel Movie Cards
   Description: Movie cards carousel with genre chips, ratings, director credits, runtime display, and responsive four-column grid.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/carousel/carousel-movie-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideFilmCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Featured Films</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                @_movies.Length titles
            </span>
        </div>

        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var movie in _movies)
                    {
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/4">
                            <div class="flex h-full flex-col overflow-hidden rounded-md border">
                                <div class="flex aspect-[2/3] items-center justify-center bg-muted">
                                    <LucideFilmCn Size="24" Class="size-6 text-muted-foreground/40" />
                                </div>
                                <div class="flex flex-1 flex-col p-3">
                                    <div class="mb-2 flex items-center gap-2">
                                        <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@movie.Genre</span>
                                        <span class="text-xs text-muted-foreground">@movie.Year</span>
                                    </div>
                                    <p class="mb-1 text-sm font-medium leading-snug">@movie.Title</p>
                                    <p class="mb-2 text-xs text-muted-foreground">@movie.Director</p>
                                    <p class="mb-3 line-clamp-2 flex-1 text-xs text-muted-foreground leading-relaxed">@movie.Plot</p>
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-1">
                                            <LucideStarCn Size="16" Class="size-3 fill-amber-400 text-amber-400" />
                                            <span class="text-xl font-semibold tabular-nums">@movie.Rating.ToString("F1")</span>
                                            <span class="text-xs text-muted-foreground">/10</span>
                                        </div>
                                        <span class="text-xs text-muted-foreground">@movie.Runtime</span>
                                    </div>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Movie(string Id, string Title, int Year, string Genre, double Rating, string Director, string Runtime, string Plot);

    private readonly Movie[] _movies =
    [
        new("m1", "The Architect", 2025, "Thriller", 8.4, "Sofia Coppola", "2h 14m", "A renowned architect discovers her award-winning designs are being used to conceal a criminal network operating beneath the buildings she created."),
        new("m2", "Meridian", 2026, "Sci-Fi", 7.9, "Denis Villeneuve", "2h 38m", "A deep-space cartographer mapping uncharted systems encounters a signal that predates human civilization by three billion years."),
        new("m3", "Salt & Iron", 2025, "Drama", 8.1, "Chloe Zhao", "1h 52m", "Two rival chefs in a dying coastal town must collaborate to save their community's last fishing season before corporate development arrives."),
        new("m4", "Nightfall Protocol", 2026, "Action", 7.2, "Christopher Nolan", "2h 27m", "When every satellite goes dark simultaneously, a retired signals analyst races against a twelve-hour clock to prevent global communications collapse."),
        new("m5", "The Garden Year", 2025, "Romance", 7.8, "Greta Gerwig", "1h 48m", "A botanist and a demolition contractor find unexpected connection while fighting over the fate of a century-old greenhouse."),
        new("m6", "Echoes of Karst", 2026, "Documentary", 8.6, "Werner Herzog", "1h 34m", "An expedition into the world's deepest cave system reveals geological formations that challenge our understanding of planetary history."),
        new("m7", "Proxy War", 2025, "Thriller", 7.5, "Kathryn Bigelow", "2h 11m", "A cybersecurity analyst uncovers evidence that an AI trading system has been waging an invisible economic war between two nations for a decade."),
        new("m8", "The Last Cartographer", 2026, "Adventure", 8.0, "Bong Joon-ho", "2h 3m", "The only person who still draws maps by hand is hired to chart an island that keeps changing shape according to local folklore.")
