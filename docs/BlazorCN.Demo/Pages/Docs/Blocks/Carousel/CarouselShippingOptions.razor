@* ============================================================
   Block: carousel-shipping-options
   Title: Carousel Shipping Options
   Description: Shipping options carousel with delivery speed cards, pricing, estimated delivery times, and tracking availability.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn, ButtonCn
   Source: original/blocks/carousel/carousel-shipping-options.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideTruckCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Shipping Options</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@_options.Length options</span>
        </div>
        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var option in _options)
                    {
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/4">
                            <div class="@Cn.Merge("flex h-full flex-col rounded-md border p-3", option.IsSelected ? "border-foreground" : "")">
                                <div class="mb-2 flex items-center justify-between">
                                    <span class="font-medium text-sm">@option.Name</span>
                                    @if (option.IsSelected)
                                    {
                                        <span class="rounded bg-foreground px-1.5 py-0.5 text-xs text-background">Selected</span>
                                    }
                                </div>
                                <p class="mb-2 text-xs text-muted-foreground">@option.Description</p>
                                <div class="mb-2 flex items-center gap-2 text-xs text-muted-foreground">
                                    <LucideClockCn Size="16" Class="size-3 text-muted-foreground" />
                                    <span>@option.Delivery</span>
                                </div>
                                <div class="mt-auto flex items-center justify-between">
                                    <span class="text-lg font-semibold tabular-nums">@(option.Price == 0 ? "Free" : "$" + option.Price)</span>
                                    @if (option.HasTracking)
                                    {
                                        <span class="text-xs text-muted-foreground">Tracking included</span>
                                    }
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record ShippingOption(string Id, string Name, string Description, string Delivery, int Price, bool HasTracking, bool IsSelected);

    private readonly ShippingOption[] _options =
    [
        new("s1", "Standard", "Regular ground shipping via USPS or UPS", "5-7 business days", 0, false, false),
        new("s2", "Express", "Priority shipping with tracking", "2-3 business days", 12, true, true),
        new("s3", "Overnight", "Next business day delivery guaranteed", "1 business day", 25, true, false),
        new("s4", "Same Day", "Order by 2 PM for same-day delivery", "Same day", 35, true, false)
    ];
}
