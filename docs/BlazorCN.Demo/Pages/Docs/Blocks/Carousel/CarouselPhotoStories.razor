@* ============================================================
   Block: carousel-photo-stories
   Title: Carousel Photo Stories
   Description: Photo story cards carousel with tall aspect ratio placeholders, story titles, location labels, author initials, and like counts.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/carousel/carousel-photo-stories.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideCameraCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Photo Stories</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@_stories.Length stories</span>
        </div>

        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-2">
                    @foreach (var story in _stories)
                    {
                        <CarouselItemCn Class="basis-[45%] pl-2 sm:basis-1/3 lg:basis-1/5">
                            <div class="overflow-hidden rounded-md border">
                                <div class="relative flex aspect-[3/4] items-center justify-center bg-muted">
                                    <LucideCameraCn Size="24" Class="size-6 text-muted-foreground/30" />
                                    <div class="absolute bottom-2 left-2 right-2">
                                        <p class="truncate text-xs font-medium text-foreground">@story.Title</p>
                                        <div class="mt-0.5 flex items-center gap-1">
                                            <LucideMapPinCn Size="16" Class="size-2.5 text-muted-foreground" />
                                            <span class="truncate text-xs text-muted-foreground">@story.Location</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2 p-2">
                                    <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@story.AuthorInitials</div>
                                    <span class="min-w-0 flex-1 truncate text-xs font-medium">@story.Author</span>
                                    <span class="flex shrink-0 items-center gap-1 text-xs text-muted-foreground">
                                        <LucideHeartCn Size="16" Class="size-3" />
                                        <span class="tabular-nums">@FormatLikes(story.Likes)</span>
                                    </span>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Story(string Id, string Title, string Location, string Author, string AuthorInitials, int Likes);

    private static string FormatLikes(int n) => n >= 1000 ? $"{n / 1000.0:F1}k" : n.ToString();

    private readonly Story[] _stories =
    [
        new("s1", "Morning Fog over the Bay", "San Francisco, CA", "Mia Zhang", "MZ", 2341),
        new("s2", "Street Markets at Dusk", "Marrakech, Morocco", "Omar Benali", "OB", 1876),
        new("s3", "Arctic Light", "Tromso, Norway", "Ingrid Larsen", "IL", 3214),
        new("s4", "Temple Gardens", "Kyoto, Japan", "Yuki Tanaka", "YT", 4502),
        new("s5", "Concrete and Sky", "Seoul, South Korea", "Jin Park", "JP", 1543),
        new("s6", "Golden Hour Fields", "Tuscany, Italy", "Lucia Moretti", "LM", 2987),
        new("s7", "Rainy Neon Reflections", "Tokyo, Japan", "Kenji Sato", "KS", 5123),
        new("s8", "Desert Silence", "Wadi Rum, Jordan", "Amira Hassan", "AH", 1298)
    ];
}
