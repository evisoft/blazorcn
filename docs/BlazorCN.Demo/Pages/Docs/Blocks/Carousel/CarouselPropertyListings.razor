@* ============================================================
   Block: carousel-property-listings
   Title: Carousel Property Listings
   Description: Real estate property listings carousel with property cards, pricing, bed/bath/sqft stats, and type chips.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn, ButtonCn
   Source: original/blocks/carousel/carousel-property-listings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideHouseCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Property Listings</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@_properties.Length listings</span>
        </div>
        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var prop in _properties)
                    {
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/4">
                            <div class="flex h-full flex-col overflow-hidden rounded-md border">
                                <div class="flex aspect-[4/3] items-center justify-center bg-muted">
                                    <LucideHouseCn Size="24" Class="size-6 text-muted-foreground/40" />
                                </div>
                                <div class="flex flex-1 flex-col p-3">
                                    <div class="mb-2 flex items-center gap-2">
                                        <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@prop.Type</span>
                                    </div>
                                    <p class="mb-1 text-sm font-medium">@prop.Name</p>
                                    <p class="mb-2 text-xs text-muted-foreground">@prop.Address</p>
                                    <div class="mb-3 flex items-center gap-2 text-xs text-muted-foreground">
                                        <span>@prop.Beds bed</span>
                                        <span>·</span>
                                        <span>@prop.Baths bath</span>
                                        <span>·</span>
                                        <span>@prop.Sqft.ToString("N0") sqft</span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-lg font-semibold tabular-nums">$@prop.Price.ToString("N0")</span>
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">View</ButtonCn>
                                    </div>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Property(string Id, string Name, string Address, int Price, int Beds, int Baths, int Sqft, string Type);

    private readonly Property[] _properties =
    [
        new("p1", "Skyline Loft", "412 W Elm St, Chicago, IL", 485000, 2, 2, 1150, "Apartment"),
        new("p2", "Oakwood Residence", "89 Maple Dr, Austin, TX", 725000, 4, 3, 2400, "House"),
        new("p3", "Harbor View Unit", "1200 Marina Blvd, San Diego, CA", 620000, 3, 2, 1680, "Condo"),
        new("p4", "Birchwood Cottage", "34 Lakeview Rd, Portland, OR", 395000, 2, 1, 980, "House"),
        new("p5", "Metro Studio", "88 5th Ave, New York, NY", 550000, 1, 1, 650, "Apartment"),
        new("p6", "Sunset Terrace", "2100 Pacific Coast Hwy, Malibu, CA", 1250000, 3, 3, 2100, "House")
    ];
}
