@* ============================================================
   Block: carousel-roadmap
   Title: Carousel Roadmap
   Description: Product roadmap carousel with quarter-based phases, feature lists, progress bars, and status indicators.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/carousel/carousel-roadmap.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Product Roadmap</span>
            <span class="text-muted-foreground text-xs">@_phases.Length phases</span>
        </div>
        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var phase in _phases)
                    {
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/4">
                            <div class="flex h-full flex-col rounded-md border p-3">
                                <div class="mb-2 flex items-center justify-between">
                                    <span class="font-medium text-sm">@phase.Quarter</span>
                                    <span class="@Cn.Merge("rounded px-1.5 py-0.5 text-xs", _statusStyle[phase.Status])">@phase.Status</span>
                                </div>
                                <p class="mb-1 text-xs font-medium">@phase.Title</p>
                                <p class="mb-3 flex-1 text-xs text-muted-foreground leading-relaxed">@phase.Description</p>
                                <div class="mb-2 space-y-1.5">
                                    @foreach (var feature in phase.Features)
                                    {
                                        <div class="flex items-center gap-2">
                                            <LucideCheckCn Size="16" Class="size-3 shrink-0 text-muted-foreground" />
                                            <span class="text-xs">@feature</span>
                                        </div>
                                    }
                                </div>
                                <div class="mt-auto">
                                    <div class="mb-1 flex items-center justify-between">
                                        <span class="text-xs text-muted-foreground">Progress</span>
                                        <span class="text-xs font-medium tabular-nums">@(phase.Progress)%</span>
                                    </div>
                                    <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                                        <div class="h-full rounded-full bg-foreground" style="@($"width: {phase.Progress}%")"></div>
                                    </div>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Phase(string Id, string Quarter, string Title, string Description, string Status, int Progress, string[] Features);

    private static readonly Dictionary<string, string> _statusStyle = new()
    {
        ["Completed"] = "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        ["In Progress"] = "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        ["Planned"] = "bg-muted text-muted-foreground",
        ["Exploring"] = "bg-amber-500/10 text-amber-600 dark:text-amber-400"
    };

    private readonly Phase[] _phases =
    [
        new("p1", "Q1 2026", "Foundation", "Core platform infrastructure and developer experience tooling.", "Completed", 100, ["Component library v2", "CLI toolchain", "Documentation site"]),
        new("p2", "Q2 2026", "Growth", "Expand ecosystem with integrations and advanced features.", "In Progress", 60, ["Plugin system", "Theme marketplace", "AI assistants"]),
        new("p3", "Q3 2026", "Scale", "Enterprise features and performance optimizations.", "Planned", 0, ["SSO & SCIM", "Audit logging", "Edge rendering"]),
        new("p4", "Q4 2026", "Innovate", "Next-generation capabilities and platform extensions.", "Exploring", 0, ["Visual editor", "Mobile SDK", "Real-time collab"])
    ];
}
