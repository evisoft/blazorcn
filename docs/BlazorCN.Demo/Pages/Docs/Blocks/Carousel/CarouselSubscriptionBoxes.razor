@* ============================================================
   Block: carousel-subscription-boxes
   Title: Carousel Subscription Boxes
   Description: Subscription box carousel with themed boxes, item previews, pricing, and frequency options.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn, ButtonCn
   Source: original/blocks/carousel/carousel-subscription-boxes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucidePackageCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Subscription Boxes</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@_boxes.Length boxes</span>
        </div>
        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var box in _boxes)
                    {
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/3">
                            <div class="flex h-full flex-col rounded-md border p-3">
                                <p class="mb-1 text-sm font-medium">@box.Name</p>
                                <p class="mb-2 text-xs text-muted-foreground">@box.Description</p>
                                <div class="mb-3 flex-1 space-y-1">
                                    @foreach (var item in box.Items)
                                    {
                                        <div class="flex items-center gap-2">
                                            <span class="size-1 shrink-0 rounded-full bg-muted-foreground/40"></span>
                                            <span class="text-xs text-muted-foreground">@item</span>
                                        </div>
                                    }
                                </div>
                                <div class="flex items-center justify-between">
                                    <div class="flex items-baseline gap-0.5">
                                        <span class="text-lg font-semibold tabular-nums">$@box.Price</span>
                                        <span class="text-xs text-muted-foreground">/@box.Frequency</span>
                                    </div>
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Subscribe</ButtonCn>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record SubscriptionBox(string Id, string Name, string Description, int Price, string Frequency, string[] Items);

    private readonly SubscriptionBox[] _boxes =
    [
        new("b1", "Developer Essentials", "Curated tools and resources for developers", 29, "month", ["Premium IDE license", "API credits", "Learning resources", "Sticker pack"]),
        new("b2", "Design Studio", "Creative assets and design tool subscriptions", 39, "month", ["Font licenses", "Icon packs", "Stock photos", "Color palettes"]),
        new("b3", "Startup Kit", "Everything you need to launch your startup", 49, "month", ["Cloud credits", "Legal templates", "Analytics tools", "Domain voucher"]),
        new("b4", "Coffee & Code", "Premium coffee paired with dev resources", 35, "month", ["Specialty coffee beans", "Coding challenges", "Exclusive tutorials", "Desk accessories"])
    ];
}
