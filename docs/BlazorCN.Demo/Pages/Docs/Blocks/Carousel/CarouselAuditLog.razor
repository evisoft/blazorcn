@* ============================================================
   Block: carousel-audit-log
   Title: Security Audit Trail Carousel
   Description: Security audit trail carousel with event rows showing user initials, action types, resources, IP addresses, and risk level indicators
   Dependencies: CarouselCn
   Source: original/blocks/carousel/carousel-audit-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Audit trail</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    High risk
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    Medium
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Low
                </span>
            </div>
        </div>

        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var slide in _slides)
                    {
                        <CarouselItemCn Class="basis-full pl-3">
                            <div class="rounded-md border">
                                <div class="border-b px-4 py-2">
                                    <span class="font-medium text-muted-foreground text-xs">@slide.Label</span>
                                </div>
                                <div>
                                    @for (var i = 0; i < slide.Events.Length; i++)
                                    {
                                        var evt = slide.Events[i];
                                        var isLast = i == slide.Events.Length - 1;
                                        var riskDot = evt.Risk switch { "high" => "bg-red-500", "medium" => "bg-amber-500", _ => "bg-emerald-500" };
                                        <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                                            <span class="@Cn.Merge("size-2 shrink-0 rounded-full", riskDot)"></span>
                                            <div class="flex size-7 shrink-0 items-center justify-center rounded-md bg-muted text-muted-foreground text-xs">@evt.Initials</div>
                                            <div class="min-w-0 flex-1">
                                                <div class="flex items-center gap-2">
                                                    <span class="font-medium text-sm">@evt.UserName</span>
                                                    <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@evt.Action</span>
                                                </div>
                                                <div class="mt-0.5 flex items-center gap-2">
                                                    <span class="truncate font-mono text-muted-foreground text-xs">@evt.Resource</span>
                                                    <span class="text-muted-foreground/40 text-xs">·</span>
                                                    <span class="shrink-0 font-mono text-muted-foreground text-xs">@evt.IpAddress</span>
                                                </div>
                                            </div>
                                            <span class="shrink-0 text-muted-foreground/60 text-xs">@evt.Timestamp</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record AuditEvent(string Id, string Action, string UserName, string Initials, string Resource, string IpAddress, string Timestamp, string Risk);
    private record AuditSlide(string Id, string Label, AuditEvent[] Events);

