@* ============================================================
   Block: carousel-podcast-episodes
   Title: Carousel Podcast Episodes
   Description: Podcast episode cards carousel with episode numbers, guest initials, duration badges, and play buttons.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn, ButtonCn
   Source: original/blocks/carousel/carousel-podcast-episodes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideMicCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">The Dev Pod</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@_episodes.Length episodes</span>
        </div>

        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var ep in _episodes)
                    {
                        <CarouselItemCn Class="basis-full pl-3 sm:basis-1/2 lg:basis-1/3">
                            <div class="flex h-full flex-col overflow-hidden rounded-md border">
                                <div class="px-3 py-3">
                                    <div class="mb-2 flex items-center justify-between">
                                        <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">Ep. @ep.Number</span>
                                        <span class="text-xs text-muted-foreground">@ep.Duration</span>
                                    </div>
                                    <p class="mb-2 line-clamp-2 text-sm font-medium leading-snug">@ep.Title</p>
                                    <div class="mb-2 flex items-center gap-2">
                                        <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@ep.GuestInitials</div>
                                        <span class="text-xs text-muted-foreground">@ep.Guest</span>
                                    </div>
                                    <p class="mb-3 line-clamp-2 flex-1 text-xs text-muted-foreground leading-relaxed">@ep.Description</p>
                                    <div class="flex items-center justify-between">
                                        <span class="text-xs text-muted-foreground">@ep.Date</span>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                                            <LucidePlayCn Size="16" Class="size-3" />
                                            Play
                                        </ButtonCn>
                                    </div>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Episode(string Id, int Number, string Title, string Guest, string GuestInitials, string Duration, string Date, string Description);

    private readonly Episode[] _episodes =
    [
        new("ep1", 142, "Scaling Developer Experience at Stripe", "Amara Osei", "AO", "42 min", "Mar 14, 2026", "How Stripe rebuilt their internal tooling platform to support 4,000 engineers shipping code daily without breaking production."),
        new("ep2", 141, "The Future of Edge Computing", "Liam Bennett", "LB", "38 min", "Mar 7, 2026", "Edge functions, regional databases, and why latency-sensitive applications are moving computation closer to users worldwide."),
        new("ep3", 140, "Design Systems That Actually Ship", "Yuki Tanaka", "YT", "51 min", "Feb 28, 2026", "Why most design systems fail to get adoption and the governance model that helped Figma maintain consistency across 200 components."),
        new("ep4", 139, "Building AI Agents for Code Review", "Priya Sharma", "PS", "45 min", "Feb 21, 2026", "Training LLMs to understand codebases contextually and provide meaningful review feedback beyond linting and formatting checks."),
        new("ep5", 138, "From Monolith to Modular Architecture", "Carlos Mendez", "CM", "36 min", "Feb 14, 2026", "A practical migration story from a Rails monolith to a modular TypeScript architecture without rewriting the entire codebase."),
        new("ep6", 137, "Building Accessible Components at Scale", "Nia Washington", "NW", "48 min", "Feb 7, 2026", "How her team automated accessibility testing and built a component library that meets WCAG 2.2 AAA standards by default.")
    ];
}
