@* ============================================================
   Block: carousel-learning-path
   Title: Carousel Learning Path
   Description: Learning path module carousel with lesson counts, estimated hours, difficulty chips, progress bars, and prerequisite indicators.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/carousel/carousel-learning-path.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Learning path</span>
            <span class="text-muted-foreground text-xs">
                @_completedCount/@_modules.Length completed · @_totalLessons lessons
            </span>
        </div>

        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var mod in _modules)
                    {
                        <CarouselItemCn Class="pl-3">
                            <div class="overflow-hidden rounded-md border">
                                <div class="px-4 py-3">
                                    <div class="mb-2 flex items-center justify-between">
                                        <span class="font-medium text-sm">@mod.Title</span>
                                        <span class="@Cn.Merge("rounded px-1.5 py-0.5 text-xs", _difficultyStyle[mod.Difficulty])">
                                            @mod.Difficulty
                                        </span>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <div class="flex items-center gap-1.5">
                                            <LucideBookOpenCn Size="16" Class="size-3.5 text-muted-foreground" />
                                            <span class="text-xs text-muted-foreground tabular-nums">
                                                @mod.LessonCount lessons
                                            </span>
                                        </div>
                                        <span class="text-muted-foreground text-xs">·</span>
                                        <div class="flex items-center gap-1.5">
                                            <LucideClockCn Size="16" Class="size-3.5 text-muted-foreground" />
                                            <span class="text-xs text-muted-foreground tabular-nums">
                                                @(mod.EstimatedHours)h estimated
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="border-t px-4 py-3">
                                    <div class="mb-1.5 flex items-center justify-between">
                                        <span class="text-muted-foreground text-xs">Progress</span>
                                        <span class="font-medium text-xs tabular-nums">@(mod.Progress)%</span>
                                    </div>
                                    <div class="h-2 w-full overflow-hidden rounded-full bg-muted">
                                        <div class="h-full rounded-full bg-foreground" style="@($"width: {mod.Progress}%")"></div>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(mod.Prerequisite))
                                {
                                    <div class="flex items-center gap-2 border-t px-4 py-2.5">
                                        <LucideLockCn Size="16" Class="size-3.5 shrink-0 text-muted-foreground/50" />
                                        <span class="text-muted-foreground text-xs">Requires: @mod.Prerequisite</span>
                                    </div>
                                }
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record LearningModule(string Id, string Title, int LessonCount, int EstimatedHours, string Difficulty, int Progress, string? Prerequisite);

    private static readonly Dictionary<string, string> _difficultyStyle = new()
    {
        ["Beginner"] = "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        ["Intermediate"] = "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        ["Advanced"] = "bg-red-500/10 text-red-600 dark:text-red-400"
    };

    private readonly LearningModule[] _modules =
    [
        new("lm1", "Getting Started with React", 12, 4, "Beginner", 100, null),
        new("lm2", "Component Patterns and Composition", 18, 6, "Intermediate", 75, "Getting Started with React"),
        new("lm3", "State Management Deep Dive", 15, 5, "Intermediate", 40, "Component Patterns and Composition"),
        new("lm4", "Server Components and Data Fetching", 20, 8, "Advanced", 10, "State Management Deep Dive"),
        new("lm5", "Testing and Quality Assurance", 14, 5, "Intermediate", 0, "Component Patterns and Composition"),
        new("lm6", "Performance Optimization", 16, 7, "Advanced", 0, "Server Components and Data Fetching")
    ];

    private int _completedCount => _modules.Count(m => m.Progress == 100);
    private int _totalLessons => _modules.Sum(m => m.LessonCount);
}
