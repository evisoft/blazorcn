@* ============================================================
   Block: carousel-travel-destinations
   Title: Carousel Travel Destinations
   Description: Travel destination cards carousel with location names, country labels, temperature, and best season indicators.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn, ButtonCn
   Source: original/blocks/carousel/carousel-travel-destinations.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideMapPinCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Destinations</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@_destinations.Length places</span>
        </div>
        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var dest in _destinations)
                    {
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/4">
                            <div class="flex h-full flex-col overflow-hidden rounded-md border">
                                <div class="flex aspect-[3/2] items-center justify-center bg-muted">
                                    <LucideMapPinCn Size="24" Class="size-6 text-muted-foreground/40" />
                                </div>
                                <div class="flex flex-1 flex-col p-3">
                                    <p class="mb-0.5 text-sm font-medium">@dest.City</p>
                                    <p class="mb-2 text-xs text-muted-foreground">@dest.Country</p>
                                    <p class="mb-3 flex-1 text-xs text-muted-foreground leading-relaxed">@dest.Description</p>
                                    <div class="flex items-center justify-between text-xs text-muted-foreground">
                                        <span>@dest.Temperature</span>
                                        <span>Best: @dest.BestSeason</span>
                                    </div>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Destination(string Id, string City, string Country, string Description, string Temperature, string BestSeason);

    private readonly Destination[] _destinations =
    [
        new("d1", "Kyoto", "Japan", "Ancient temples, bamboo forests, and traditional tea houses in Japan's cultural heart.", "18°C", "Spring"),
        new("d2", "Santorini", "Greece", "Whitewashed buildings with blue domes overlooking the Aegean Sea at sunset.", "26°C", "Summer"),
        new("d3", "Patagonia", "Argentina", "Dramatic glaciers, turquoise lakes, and rugged mountain peaks at the end of the world.", "8°C", "Fall"),
        new("d4", "Marrakech", "Morocco", "Vibrant souks, intricate mosaics, and aromatic spice markets in the Red City.", "22°C", "Spring"),
        new("d5", "Reykjavik", "Iceland", "Northern lights, geothermal hot springs, and volcanic landscapes of fire and ice.", "2°C", "Winter"),
        new("d6", "Lisbon", "Portugal", "Colorful tiled facades, historic trams, and pasteis de nata by the Tagus River.", "20°C", "Spring")
    ];
}
