@* ============================================================
   Block: carousel-security-features
   Title: Carousel Security Features
   Description: Security feature cards carousel with compliance tag chips, active status dot indicators, and feature descriptions.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/carousel/carousel-security-features.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideShieldCheckCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Security</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@_features.Length features</span>
        </div>
        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var feature in _features)
                    {
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/3">
                            <div class="flex h-full flex-col rounded-md border p-3">
                                <div class="mb-2 flex items-center justify-between">
                                    <LucideShieldCn Size="16" Class="size-4 text-muted-foreground" />
                                    <div class="flex items-center gap-1.5">
                                        <span class="@Cn.Merge("size-1.5 rounded-full", feature.IsActive ? "bg-emerald-500" : "bg-muted-foreground/30")"></span>
                                        <span class="text-xs text-muted-foreground">@(feature.IsActive ? "Active" : "Inactive")</span>
                                    </div>
                                </div>
                                <p class="mb-1 text-sm font-medium">@feature.Name</p>
                                <p class="mb-3 flex-1 text-xs text-muted-foreground leading-relaxed">@feature.Description</p>
                                <div class="flex flex-wrap gap-1">
                                    @foreach (var tag in feature.Tags)
                                    {
                                        <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@tag</span>
                                    }
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record SecurityFeature(string Id, string Name, string Description, string[] Tags, bool IsActive);

    private readonly SecurityFeature[] _features =
    [
        new("f1", "End-to-End Encryption", "AES-256 encryption for data at rest and TLS 1.3 for data in transit across all services", ["SOC 2", "GDPR", "HIPAA"], true),
        new("f2", "Role-Based Access Control", "Granular permission policies with custom roles, resource scoping, and audit trails", ["SOC 2", "HIPAA"], true),
        new("f3", "Multi-Factor Authentication", "TOTP, WebAuthn, and SMS-based second factor with backup recovery codes", ["SOC 2", "GDPR"], true),
        new("f4", "Vulnerability Scanning", "Automated dependency and container scanning with CVE alerts on every deployment", ["SOC 2"], true),
        new("f5", "DDoS Protection", "Layer 3/4/7 DDoS mitigation with automatic traffic analysis and rate limiting", ["SOC 2"], true),
        new("f6", "Network Isolation", "VPC peering, private endpoints, and IP allowlisting for production environments", ["SOC 2", "HIPAA"], false)
    ];
}
