@* ============================================================
   Block: carousel-countdown-events
   Title: Animated Countdown Event Carousel
   Description: Upcoming event countdown carousel with countdown grids, event type chips, location labels, and register buttons
   Dependencies: CarouselCn, ButtonCn
   Source: original/blocks/carousel/carousel-countdown-events.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideCalendarCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Upcoming events</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@_events.Length events</span>
        </div>

        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var evt in _events)
                    {
                        var typeColor = evt.Type switch
                        {
                            "Conference" => "bg-blue-500/10 text-blue-600 dark:text-blue-400",
                            "Webinar" => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
                            "Launch" => "bg-amber-500/10 text-amber-600 dark:text-amber-400",
                            _ => "bg-muted text-muted-foreground",
                        };
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/4">
                            <div class="flex h-full flex-col rounded-md border px-4 py-3">
                                <div class="mb-2 flex items-center justify-between">
                                    <span class="@Cn.Merge("rounded px-1.5 py-0.5 text-xs", typeColor)">@evt.Type</span>
                                </div>

                                <p class="mb-1 text-sm font-medium">@evt.Name</p>

                                <div class="mb-3 space-y-1">
                                    <div class="flex items-center gap-1 text-muted-foreground">
                                        <LucideCalendarCn Size="12" Class="size-3" />
                                        <span class="text-xs">@evt.Date</span>
                                    </div>
                                    <div class="flex items-center gap-1 text-muted-foreground">
                                        <LucideMapPinCn Size="12" Class="size-3" />
                                        <span class="text-xs">@evt.Location</span>
                                    </div>
                                </div>

                                <div class="mb-3 flex-1">
                                    <div class="grid grid-cols-3 gap-2">
                                        <div class="rounded-md bg-muted/50 p-2 text-center">
                                            <span class="block text-xl font-semibold tabular-nums">@evt.Days</span>
                                            <span class="text-xs text-muted-foreground">days</span>
                                        </div>
                                        <div class="rounded-md bg-muted/50 p-2 text-center">
                                            <span class="block text-xl font-semibold tabular-nums">@evt.Hours</span>
                                            <span class="text-xs text-muted-foreground">hrs</span>
                                        </div>
                                        <div class="rounded-md bg-muted/50 p-2 text-center">
                                            <span class="block text-xl font-semibold tabular-nums">@evt.Mins</span>
                                            <span class="text-xs text-muted-foreground">min</span>
                                        </div>
                                    </div>
                                </div>

                                <ButtonCn Variant="ButtonVariant.Outline" class="h-7 w-full text-xs">Register</ButtonCn>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record CountdownEvent(string Id, string Name, string Date, string Location, string Type, int Days, int Hours, int Mins);

    private static readonly CountdownEvent[] _events =
    [
        new("e1", "React Summit 2026", "Jun 14, 2026", "Amsterdam, NL", "Conference", 89, 14, 32),
        new("e2", "Design Systems Live", "Apr 22, 2026", "Online", "Webinar", 36, 8, 15),
        new("e3", "Platform v3.0 Launch", "May 1, 2026", "San Francisco, CA", "Launch", 45, 22, 48),
        new("e4", "Frontend Devs NYC", "Apr 5, 2026", "New York, NY", "Meetup", 19, 6, 10),
    ];
}
