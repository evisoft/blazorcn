@* ============================================================
   Block: carousel-how-it-works
   Title: Animated How It Works Process Steps Carousel
   Description: Process steps carousel with step numbers, icons, and step indicator dots
   Dependencies: CarouselCn
   Source: original/blocks/carousel/carousel-how-it-works.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">How it works</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Get started in minutes</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@_steps.Length steps</span>
        </div>

        <div class="px-3 py-3">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var step in _steps)
                    {
                        <CarouselItemCn Class="basis-full pl-3">
                            <div class="rounded-md border px-4 py-6">
                                <div class="flex items-start gap-4">
                                    <span class="text-xl font-semibold tabular-nums text-muted-foreground">@step.Number.ToString("D2")</span>
                                    <div class="min-w-0 flex-1">
                                        <div class="mb-2 flex items-center gap-2">
                                            <p class="text-sm font-medium">@step.Title</p>
                                            @switch (step.Icon)
                                            {
                                                case "database":
                                                    <LucideDatabaseCn Size="16" Class="size-4 text-muted-foreground" />
                                                    break;
                                                case "settings":
                                                    <LucideSettingsCn Size="16" Class="size-4 text-muted-foreground" />
                                                    break;
                                                case "workflow":
                                                    <LucideWorkflowCn Size="16" Class="size-4 text-muted-foreground" />
                                                    break;
                                                case "activity":
                                                    <LucideActivityCn Size="16" Class="size-4 text-muted-foreground" />
                                                    break;
                                            }
                                        </div>
                                        <p class="text-xs leading-relaxed text-muted-foreground">@step.Description</p>
                                    </div>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>

                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />

                    <div class="flex items-center gap-1">
                        @for (var i = 0; i < _steps.Length; i++)
                        {
                            var step = _steps[i];
                            var isLast = i == _steps.Length - 1;
                            <div class="flex items-center">
                                <span class="block size-1.5 rounded-full bg-muted-foreground" style="opacity: 0.4"></span>
                                @if (!isLast)
                                {
                                    <div class="h-px w-4 bg-muted-foreground/20"></div>
                                }
                            </div>
                        }
                    </div>

                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Id, int Number, string Title, string Description, string Icon);

    private static readonly StepItem[] _steps =
    [
        new("connect", 1, "Connect your data", "Link your databases, APIs, and third-party services in minutes. We support PostgreSQL, MySQL, MongoDB, REST, and GraphQL out of the box with zero-config connectors.", "database"),
        new("configure", 2, "Configure rules", "Define validation rules, transformation pipelines, and business logic using our visual editor. No code required for standard workflows — write custom functions when you need full control.", "settings"),
        new("automate", 3, "Automate workflows", "Set up triggers, schedules, and event-driven automations that run reliably at scale. Chain actions together with conditional branching, retries, and error handling built in.", "workflow"),
        new("monitor", 4, "Monitor results", "Track pipeline health, throughput, and error rates in real time. Get alerts via Slack, email, or PagerDuty when metrics cross your defined thresholds. Export logs to your observability stack.", "activity"),
    ];
}
