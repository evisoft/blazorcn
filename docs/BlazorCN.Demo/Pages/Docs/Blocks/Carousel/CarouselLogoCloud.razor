@* ============================================================
   Block: carousel-logo-cloud
   Title: Carousel Logo Cloud
   Description: Auto-scrolling logo cloud marquee with two rows of company logos scrolling in opposite directions using CSS keyframe animations.
   Dependencies: None (CSS animation only)
   Source: original/blocks/carousel/carousel-logo-cloud.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <style>
        @@keyframes carousel-scroll {
            from { transform: translateX(0); }
            to { transform: translateX(-50%); }
        }
    </style>
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Trusted by leading companies</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    @(_companiesRowOne.Length + _companiesRowTwo.Length) integration partners
                </p>
            </div>
        </div>
        <div class="flex flex-col gap-3 py-6">
            <div class="overflow-hidden">
                <div class="flex gap-3" style="animation: carousel-scroll 30s linear infinite; width: max-content;">
                    @foreach (var name in _companiesRowOne.Concat(_companiesRowOne))
                    {
                        <div class="flex shrink-0 items-center justify-center rounded-md border bg-muted/30 px-6 py-3 opacity-60 transition-colors hover:bg-muted/50 hover:opacity-100">
                            <span class="whitespace-nowrap font-mono text-sm font-medium text-foreground">@name</span>
                        </div>
                    }
                </div>
            </div>
            <div class="overflow-hidden">
                <div class="flex gap-3" style="animation: carousel-scroll 35s linear infinite reverse; width: max-content;">
                    @foreach (var name in _companiesRowTwo.Concat(_companiesRowTwo))
                    {
                        <div class="flex shrink-0 items-center justify-center rounded-md border bg-muted/30 px-6 py-3 opacity-60 transition-colors hover:bg-muted/50 hover:opacity-100">
                            <span class="whitespace-nowrap font-mono text-sm font-medium text-foreground">@name</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private readonly string[] _companiesRowOne = ["Vercel", "Stripe", "Linear", "Figma", "Supabase", "Planetscale", "Railway"];
    private readonly string[] _companiesRowTwo = ["Resend", "Neon", "Turso", "Clerk", "Convex", "Upstash", "Axiom"];
}
