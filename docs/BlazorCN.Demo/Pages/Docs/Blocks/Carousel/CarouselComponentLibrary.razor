@* ============================================================
   Block: carousel-component-library
   Title: Animated Component Library Carousel
   Description: Component library browser carousel with variant counts, bundle sizes, and status chips
   Dependencies: CarouselCn, ButtonCn
   Source: original/blocks/carousel/carousel-component-library.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Component Library</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    @_components.Length components · @_components.Count(c => c.Status == "Stable") stable
                </p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">v4.2.0</span>
        </div>

        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var comp in _components)
                    {
                        var statusDot = comp.Status switch { "Stable" => "bg-emerald-500", "Beta" => "bg-amber-500", _ => "bg-red-500" };
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/3">
                            <div class="flex h-full flex-col rounded-md border p-4">
                                <div class="mb-3 flex items-center justify-between">
                                    <div class="flex size-9 items-center justify-center rounded-md bg-muted">
                                        @switch (comp.Icon)
                                        {
                                            case "mouse-pointer-click":
                                                <LucideMousePointerClickCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "table":
                                                <LucideTableCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "box":
                                                <LucideBoxCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "form-input":
                                                <LucideTextCursorInputCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "sliders-horizontal":
                                                <LucideSlidersHorizontalCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "layout-dashboard":
                                                <LucideLayoutDashboardCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "list":
                                                <LucideListCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "menu":
                                                <LucideMenuCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                        }
                                    </div>
                                    <div class="flex items-center gap-1.5">
                                        <span class="@Cn.Merge("size-1.5 rounded-full", statusDot)"></span>
                                        <span class="text-xs text-muted-foreground">@comp.Status</span>
                                    </div>
                                </div>

                                <p class="text-sm font-medium">@comp.Name</p>
                                <p class="mt-1 flex-1 text-xs text-muted-foreground leading-relaxed">@comp.Description</p>

                                <div class="mt-3 flex items-center gap-3 text-xs text-muted-foreground">
                                    <span>@comp.Variants variants</span>
                                    <span>·</span>
                                    <span>@comp.Props props</span>
                                    <span>·</span>
                                    <span class="font-semibold tabular-nums text-foreground">@comp.Size</span>
                                </div>

                                <div class="mt-3 border-t pt-3">
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" class="h-7 w-full gap-1.5 text-xs">
                                        View docs
                                        <LucideChevronRightCn Size="12" Class="size-3" />
                                    </ButtonCn>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record ComponentItem(string Id, string Name, string Description, int Variants, int Props, string Size, string Status, string Icon);

    private static readonly ComponentItem[] _components =
    [
        new("c1", "Button", "Interactive trigger element with multiple variants, sizes, and loading states.", 6, 12, "2.1 kB", "Stable", "mouse-pointer-click"),
        new("c2", "DataTable", "Sortable, filterable table with pagination, row selection, and column resizing.", 3, 24, "8.4 kB", "Stable", "table"),
        new("c3", "Dialog", "Modal overlay with focus trap, keyboard navigation, and scroll locking.", 4, 15, "3.7 kB", "Stable", "box"),
        new("c4", "Form", "Validated form with field-level errors, async submission, and schema integration.", 2, 18, "5.2 kB", "Stable", "form-input"),
        new("c5", "Command", "Command palette with fuzzy search, keyboard navigation, and grouped results.", 3, 14, "6.8 kB", "Beta", "sliders-horizontal"),
        new("c6", "Sidebar", "Collapsible navigation sidebar with nested groups, tooltips, and mobile sheet.", 2, 11, "4.1 kB", "Beta", "layout-dashboard"),
        new("c7", "Select", "Dropdown select with search, multi-select, and custom option rendering.", 3, 16, "3.9 kB", "Stable", "list"),
        new("c8", "NavigationMenu", "Multi-level navigation with animated indicators and responsive mobile fallback.", 2, 9, "5.6 kB", "Deprecated", "menu"),
    ];
}
