@* ============================================================
   Block: carousel-restaurant-menu
   Title: Carousel Restaurant Menu
   Description: Restaurant menu carousel with dish cards, pricing, dietary labels, and category sections.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/carousel/carousel-restaurant-menu.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideUtensilsCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Menu</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@_categories.Length categories</span>
        </div>
        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var category in _categories)
                    {
                        <CarouselItemCn Class="basis-full pl-3">
                            <div class="rounded-md border">
                                <div class="border-b px-4 py-2.5">
                                    <span class="font-medium text-sm">@category.Name</span>
                                </div>
                                <div class="divide-y">
                                    @foreach (var dish in category.Dishes)
                                    {
                                        <div class="flex items-start justify-between gap-3 px-4 py-3">
                                            <div class="min-w-0 flex-1">
                                                <div class="flex items-center gap-2">
                                                    <p class="text-sm font-medium">@dish.Name</p>
                                                    @foreach (var tag in dish.Tags)
                                                    {
                                                        <span class="rounded bg-muted px-1 py-0.5 text-xs text-muted-foreground">@tag</span>
                                                    }
                                                </div>
                                                <p class="mt-1 text-xs text-muted-foreground leading-relaxed">@dish.Description</p>
                                            </div>
                                            <span class="shrink-0 font-semibold text-sm tabular-nums">$@dish.Price</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Dish(string Name, string Description, int Price, string[] Tags);
    private record MenuCategory(string Id, string Name, Dish[] Dishes);

    private readonly MenuCategory[] _categories =
    [
        new("c1", "Starters", [
            new("Burrata with Heirloom Tomatoes", "Creamy burrata, cherry tomatoes, basil oil, aged balsamic", 16, ["V"]),
            new("Tuna Tartare", "Yellowfin tuna, avocado, sesame, wonton crisps", 19, []),
            new("Roasted Bone Marrow", "Sourdough, herb gremolata, fleur de sel", 18, [])
        ]),
        new("c2", "Mains", [
            new("Dry-Aged Ribeye", "14oz prime ribeye, roasted garlic butter, seasonal vegetables", 52, []),
            new("Pan-Seared Halibut", "Wild halibut, saffron risotto, beurre blanc", 42, []),
            new("Wild Mushroom Risotto", "Arborio rice, porcini, truffle oil, parmesan", 28, ["V"])
        ]),
        new("c3", "Desserts", [
            new("Chocolate Fondant", "Dark chocolate, vanilla bean ice cream, salted caramel", 14, []),
            new("Lemon Tart", "Meyer lemon curd, Italian meringue, shortbread crust", 12, ["V"]),
            new("Cheese Selection", "Three artisan cheeses, honeycomb, fig compote, crackers", 18, ["V"])
        ])
    ];
}
