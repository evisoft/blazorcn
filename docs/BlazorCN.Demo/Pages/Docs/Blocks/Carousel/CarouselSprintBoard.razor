@* ============================================================
   Block: carousel-sprint-board
   Title: Carousel Sprint Board
   Description: Sprint board carousel with task cards grouped by status, assignee initials, priority dots, and story points.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/carousel/carousel-sprint-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Sprint 24</span>
            <span class="text-muted-foreground text-xs">@_totalTasks tasks · @_totalPoints pts</span>
        </div>
        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var column in _columns)
                    {
                        <CarouselItemCn Class="basis-[75%] pl-3 sm:basis-1/2 lg:basis-1/3">
                            <div class="rounded-md border">
                                <div class="flex items-center justify-between border-b px-3 py-2.5">
                                    <span class="font-medium text-xs">@column.Title</span>
                                    <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground tabular-nums">@column.Tasks.Length</span>
                                </div>
                                <div class="space-y-2 p-3">
                                    @foreach (var task in column.Tasks)
                                    {
                                        <div class="rounded-md border p-2.5">
                                            <div class="mb-1.5 flex items-center gap-2">
                                                <span class="@Cn.Merge("size-1.5 rounded-full", _priorityDot[task.Priority])"></span>
                                                <span class="font-mono text-xs text-muted-foreground">@task.Key</span>
                                            </div>
                                            <p class="mb-2 text-xs font-medium">@task.Title</p>
                                            <div class="flex items-center justify-between">
                                                <div class="flex size-5 items-center justify-center rounded-full bg-muted text-xs">@task.Initials</div>
                                                <span class="rounded bg-muted px-1 py-0.5 text-xs text-muted-foreground tabular-nums">@task.Points pt</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record SprintTask(string Key, string Title, string Initials, string Priority, int Points);
    private record SprintColumn(string Id, string Title, SprintTask[] Tasks);

    private static readonly Dictionary<string, string> _priorityDot = new()
    {
        ["high"] = "bg-red-500", ["medium"] = "bg-amber-500", ["low"] = "bg-emerald-500"
    };

    private readonly SprintColumn[] _columns =
    [
        new("todo", "To Do", [
            new("ENG-421", "Add WebSocket reconnect logic", "SC", "high", 5),
            new("ENG-422", "Update onboarding flow copy", "MR", "low", 1)
        ]),
        new("progress", "In Progress", [
            new("ENG-418", "Implement search indexing", "AP", "high", 8),
            new("ENG-419", "Refactor auth middleware", "LB", "medium", 3)
        ]),
        new("review", "In Review", [
            new("ENG-415", "Add CSV export to dashboard", "YT", "medium", 3),
            new("ENG-416", "Fix timezone handling in scheduler", "CM", "high", 2)
        ]),
        new("done", "Done", [
            new("ENG-410", "Migrate to new API versioning", "SC", "medium", 5),
            new("ENG-411", "Add rate limiting headers", "AP", "low", 2)
        ])
    ];

    private int _totalTasks => _columns.Sum(c => c.Tasks.Length);
    private int _totalPoints => _columns.SelectMany(c => c.Tasks).Sum(t => t.Points);
}
