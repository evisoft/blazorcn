@* ============================================================
   Block: carousel-quote-wall
   Title: Carousel Quote Wall
   Description: Inspirational quote carousel with large italic text, author names with roles, and category chips.
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/carousel/carousel-quote-wall.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideQuoteCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Inspiration</p>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@_quotes.Length quotes</span>
        </div>
        <div class="px-4 py-4">
            <CarouselCn>
                <CarouselContentCn Class="-ml-3">
                    @foreach (var quote in _quotes)
                    {
                        <CarouselItemCn Class="basis-full pl-3">
                            <div class="rounded-md border p-6">
                                <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@quote.Category</span>
                                <p class="mt-4 text-lg italic leading-relaxed">"@quote.Text"</p>
                                <div class="mt-4">
                                    <p class="text-sm font-medium">@quote.Author</p>
                                    <p class="text-xs text-muted-foreground">@quote.Role</p>
                                </div>
                            </div>
                        </CarouselItemCn>
                    }
                </CarouselContentCn>
                <div class="mt-3 flex items-center justify-center gap-2">
                    <CarouselPreviousCn Class="static translate-y-0" />
                    <CarouselNextCn Class="static translate-y-0" />
                </div>
            </CarouselCn>
        </div>
    </div>
</section>

@code {
    private record Quote(string Id, string Text, string Author, string Role, string Category);

    private readonly Quote[] _quotes =
    [
        new("q1", "The best way to predict the future is to invent it. You cannot wait for someone else to build the tools you need to change the world.", "Alan Kay", "Computer Scientist", "Innovation"),
        new("q2", "Management is doing things right. Leadership is doing the right things. The distinction matters more as organizations scale.", "Peter Drucker", "Management Consultant", "Leadership"),
        new("q3", "Innovation distinguishes between a leader and a follower. Stay hungry, stay foolish, and never stop questioning the obvious.", "Steve Jobs", "Co-founder, Apple", "Innovation"),
        new("q4", "Growth is never by mere chance. It is the result of forces working together with deliberate intention and consistent execution.", "James Cash Penney", "Entrepreneur", "Growth"),
        new("q5", "The task of leadership is not to put greatness into people but to elicit it, for the greatness is there already waiting to emerge.", "John Buchan", "Author & Statesman", "Leadership"),
        new("q6", "Without deviation from the norm, progress is not possible. Every breakthrough requires the courage to challenge established patterns.", "Frank Zappa", "Musician & Composer", "Innovation")
    ];
}
