@* ============================================================
   Block: empty-state-no-plugins
   Title: EmptyStateNoPlugins
   Description: An empty state block for when no plugins are installed showing a marketplace grid with empty placeholder cards and a CTA to browse plugins
   Source: original/blocks/empty-state/empty-state-no-plugins.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="plug" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Plugins</span>
                <span class="text-muted-foreground text-xs">0 installed</span>
            </div>
        </div>

        @* Empty content *@
        <div class="flex flex-col items-center justify-center px-6 py-14 text-center">
            @* Marketplace grid of empty cards *@
            <div class="grid w-full max-w-sm grid-cols-2 gap-2.5">
                @foreach (var card in _placeholderCards)
                {
                    <div class="rounded-lg border border-dashed bg-muted/20 p-3">
                        @* Icon placeholder *@
                        <div class="mb-2.5 flex size-8 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="plug" Size="14" Class="size-3.5 text-muted-foreground/30" />
                        </div>
                        @* Title skeleton *@
                        <div class="mb-1.5 h-2 w-16 rounded-sm bg-muted-foreground/12"></div>
                        @* Description skeleton lines *@
                        <div class="space-y-1">
                            <div class="h-1.5 w-full rounded-sm bg-muted-foreground/8"></div>
                            <div class="h-1.5 w-3/4 rounded-sm bg-muted-foreground/8"></div>
                        </div>
                        @* Install button skeleton *@
                        <div class="mt-3 h-5 w-14 rounded-md bg-muted/40"></div>
                    </div>
                }
            </div>

            <div class="mt-5">
                <h3 class="font-medium text-sm">No plugins installed</h3>
                <p class="mx-auto mt-1.5 max-w-xs text-muted-foreground text-sm">
                    Extend your workspace with plugins. Add new features, connect services, and customize
                    your experience.
                </p>
            </div>

            <div class="mt-6">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    <LucideIconCn Name="plug" Size="14" Class="mr-1.5 size-3.5" />
                    Browse plugins
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record PlaceholderCard(string Id);

    private static readonly PlaceholderCard[] _placeholderCards =
    [
        new("p1"),
        new("p2"),
        new("p3"),
        new("p4"),
    ];
}
