@* ============================================================
   Block: empty-state-no-favorites
   Title: EmptyStateNoFavorites
   Description: React empty state block for favorites sections with no saved items, featuring a heart icon, decorative star grid skeleton, and browse CTA built with Next.js, shadcn/ui, Tailwind CSS, and motion animations
   Source: original/blocks/empty-state/empty-state-no-favorites.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="heart" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Favorites</span>
            <span class="ml-auto text-muted-foreground text-xs">0 items</span>
        </div>

        @* Skeleton grid + empty message *@
        <div class="px-4 py-6">
            @* Skeleton favorite cards *@
            <div class="grid grid-cols-3 gap-2">
                @foreach (var item in _skeletonItems)
                {
                    <div class="relative rounded-md bg-muted/30 p-3">
                        <div class="flex items-center justify-between">
                            <div class="h-2 w-2/3 rounded bg-muted/50"></div>
                            <LucideIconCn Name="@item.IconName" Size="12" Class="size-3 text-muted-foreground/25" />
                        </div>
                        <div class="mt-3 h-8 w-full rounded bg-muted/20"></div>
                        <div class="mt-2 h-2 w-1/2 rounded bg-muted/40"></div>
                    </div>
                }
            </div>

            @* Message *@
            <div class="mt-6 flex flex-col items-center text-center">
                <h3 class="font-medium text-sm">No favorites yet</h3>
                <p class="mt-1.5 max-w-xs text-muted-foreground text-xs leading-relaxed">
                    Mark items you love with a heart to save them here for quick access. Your favorites
                    will appear in this list.
                </p>

                <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                    <LucideIconCn Name="compass" Size="14" Class="size-3.5" />
                    Browse items
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record SkeletonItem(string Id, string IconName);

    private static readonly SkeletonItem[] _skeletonItems =
    [
        new("s1", "heart"),
        new("s2", "star"),
        new("s3", "star"),
        new("s4", "heart"),
        new("s5", "heart"),
        new("s6", "star"),
    ];
}
