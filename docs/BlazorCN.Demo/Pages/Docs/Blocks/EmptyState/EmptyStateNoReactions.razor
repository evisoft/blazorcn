@* ============================================================
   Block: empty-state-no-reactions
   Title: EmptyStateNoReactions
   Description: An empty reactions state with emoji-style icons showing zero counters, engagement message, and share content CTA using shadcn/ui and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-reactions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="heart" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Reactions</span>
            </div>
        </div>

        @* Reaction counters *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-center gap-6">
                @foreach (var reaction in _reactionTypes)
                {
                    <div class="flex flex-col items-center gap-1.5">
                        <div class="flex size-10 items-center justify-center rounded-full bg-muted/50">
                            <LucideIconCn Name="@reaction.Icon" Size="18" Class="size-4.5 text-muted-foreground/40" />
                        </div>
                        <span class="font-medium text-muted-foreground/40 text-xs tabular-nums">0</span>
                    </div>
                }
            </div>
        </div>

        @* Empty message *@
        <div class="flex flex-col items-center px-6 py-10 text-center">
            <h3 class="font-medium text-sm">No reactions yet</h3>
            <p class="mx-auto mt-1.5 max-w-xs text-muted-foreground text-sm">
                Engagement metrics will appear here as people interact with your content. Share it to
                reach a wider audience.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="share" Size="14" Class="size-3.5" />
                Share content
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ReactionType(string Id, string Icon, string Label);

    private static readonly ReactionType[] _reactionTypes =
    [
        new("like", "thumbs-up", "Like"),
        new("love", "heart", "Love"),
        new("celebrate", "zap", "Celebrate"),
        new("smile", "smile", "Smile"),
    ];
}
