@* ============================================================
   Block: empty-state-invite-team
   Title: EmptyStateInviteTeam
   Description: An empty state prompting users to invite team members with avatar placeholders, email input field, and invite CTA built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-invite-team.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="user-plus" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Team</span>
                <span class="text-xs text-muted-foreground">1 member</span>
            </div>
        </div>

        @* Content *@
        <div class="flex flex-col items-center justify-center px-6 py-14 text-center">
            @* Avatar placeholders *@
            <div class="flex items-center -space-x-2">
                @foreach (var p in _placeholders)
                {
                    <div class="@Cn.Merge("flex size-10 items-center justify-center rounded-full text-xs", p.Filled ? "bg-foreground text-background font-medium" : "border-2 border-dashed border-muted-foreground/20 bg-muted/30 text-muted-foreground/40")">
                        @p.Initials
                    </div>
                }
            </div>

            @* Text *@
            <div class="mt-5">
                <h3 class="text-sm font-medium">Invite your team</h3>
                <p class="mx-auto mt-1.5 max-w-xs text-sm text-muted-foreground">
                    Collaborate in real-time with your team. Share projects, assign tasks, and keep
                    everyone aligned.
                </p>
            </div>

            @* Email input *@
            <div class="mt-6 flex w-full max-w-sm items-center gap-2">
                <InputCn Type="email" Placeholder="@("colleague@company.com")" @bind-Value="_email" Class="h-8 text-sm" />
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 shrink-0 gap-1.5 text-xs">
                    <LucideIconCn Name="send" Size="12" Class="size-3" />
                    Invite
                </ButtonCn>
            </div>

            @* Hint *@
            <p class="mt-3 text-xs text-muted-foreground/60">
                Invitations expire after 7 days
            </p>
        </div>
    </div>
</section>

@code {
    private record Placeholder(string Initials, bool Filled);

    private static readonly Placeholder[] _placeholders =
    [
        new("You", true),
        new("", false),
        new("", false),
        new("", false),
        new("+", false),
    ];

    private string _email = "";
}
