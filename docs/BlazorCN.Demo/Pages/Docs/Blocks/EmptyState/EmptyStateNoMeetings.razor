@* ============================================================
   Block: empty-state-no-meetings
   Title: EmptyStateNoMeetings
   Description: A video meeting list empty state with participant placeholder area and schedule CTA, built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-meetings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="video" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Meetings</span>
            </div>
            <span class="text-xs text-muted-foreground">Today</span>
        </div>

        @* Meeting slots skeleton *@
        <div class="relative">
            @foreach (var slot in _meetingSlots)
            {
                var participantCount = 2 + Array.IndexOf(_meetingSlots, slot);
                <div class="flex items-center gap-3 border-b px-4 py-3">
                    <span class="w-16 shrink-0 font-mono text-xs text-muted-foreground/50">
                        @slot.Time
                    </span>
                    <div class="@Cn.Merge("h-3 rounded bg-muted/60", slot.TitleWidth)"></div>
                    <div class="ml-auto flex -space-x-1.5">
                        @for (int j = 0; j < participantCount; j++)
                        {
                            <div class="size-8 rounded-full border-2 border-card bg-muted/50"></div>
                        }
                    </div>
                </div>
            }

            @* Overlay message *@
            <div class="absolute inset-0 flex flex-col items-center justify-center bg-card/80 backdrop-blur-[1px]">
                <div class="flex size-10 items-center justify-center rounded-full bg-muted/50">
                    <LucideIconCn Name="video" Size="20" Class="size-5 text-muted-foreground" />
                </div>
                <h2 class="mt-3 text-sm font-medium">No meetings scheduled</h2>
                <p class="mt-1 max-w-xs text-center text-xs text-muted-foreground">
                    You have no upcoming meetings. Schedule one to connect with your team or clients.
                </p>
                <ButtonCn Size="ButtonSize.Sm" Class="mt-4 gap-1.5">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    Schedule meeting
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                Meetings sync with your calendar and send automatic reminders to all participants.
            </p>
        </div>
    </div>
</section>

@code {
    private record MeetingSlot(string Time, string TitleWidth);

    private static readonly MeetingSlot[] _meetingSlots =
    [
        new("9:00 AM", "w-36"),
        new("11:00 AM", "w-44"),
        new("2:00 PM", "w-32"),
    ];
}
