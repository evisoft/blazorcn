@* ============================================================
   Block: empty-state-no-preferences
   Title: EmptyStateNoPreferences
   Description: An empty state block for when no preferences have been customized, showing a toggle list skeleton with switch placeholders and a CTA to customize settings
   Source: original/blocks/empty-state/empty-state-no-preferences.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="settings" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Preferences</span>
            <span class="ml-auto text-muted-foreground/40 text-xs">All defaults</span>
        </div>

        @* Toggle list skeleton *@
        <div class="border-b">
            @foreach (var pref in _ghostPreferences)
            {
                var isLast = pref == _ghostPreferences[^1];
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-3", !isLast ? "border-b" : "")">
                    <div class="flex flex-col gap-1">
                        <div class="h-2.5 w-28 rounded bg-muted/70"></div>
                        <span class="font-mono text-muted-foreground/25 text-[10px]">@pref.Category</span>
                    </div>
                    @* Ghost toggle switch *@
                    <div class="h-5 w-9 rounded-full border border-dashed bg-muted/20 p-0.5">
                        <div class="size-3.5 rounded-full bg-muted/40"></div>
                    </div>
                </div>
            }
        </div>

        @* Message and CTA *@
        <div class="flex flex-col items-center px-4 py-8 text-center">
            <h3 class="font-medium text-sm">Using default preferences</h3>
            <p class="mt-1.5 max-w-xs text-muted-foreground text-xs leading-relaxed">
                Personalize your experience by adjusting notifications, appearance, and editor settings.
                Your preferences sync across all your devices automatically.
            </p>

            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="settings" Size="14" Class="size-3.5" />
                Customize
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record GhostPreference(string Label, string Category);

    private static readonly GhostPreference[] _ghostPreferences =
    [
        new("Email notifications", "Notifications"),
        new("Dark mode", "Appearance"),
        new("Compact view", "Layout"),
        new("Weekly digest", "Notifications"),
        new("Auto-save drafts", "Editor"),
        new("Show tooltips", "Accessibility"),
    ];
}
