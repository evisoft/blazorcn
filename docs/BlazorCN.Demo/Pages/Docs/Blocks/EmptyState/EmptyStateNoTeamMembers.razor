@* ============================================================
   Block: empty-state-no-team-members
   Title: EmptyStateNoTeamMembers
   Description: An empty state block for when no team members have been invited yet, featuring overlapping avatar placeholders, ghost member rows, and an invite CTA button using shadcn/ui and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-team-members.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="user-plus" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Team Members</span>
            </div>
            <span class="text-xs text-muted-foreground">0 members</span>
        </div>

        @* Overlapping avatar row *@
        <div class="flex items-center justify-center border-b px-4 py-6">
            <div class="flex -space-x-2.5">
                @foreach (var i in _avatarIndexes)
                {
                    <div class="flex size-10 items-center justify-center rounded-full border-2 border-dashed border-muted-foreground/20 bg-muted/30">
                        @if (i == 0)
                        {
                            <span class="text-xs font-medium text-muted-foreground/50">You</span>
                        }
                        else
                        {
                            <LucideIconCn Name="user-plus" Size="14" Class="size-3.5 text-muted-foreground/25" />
                        }
                    </div>
                }
            </div>
        </div>

        @* Ghost member rows *@
        <div aria-hidden="true">
            @foreach (var member in _ghostMembers)
            {
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", member.BorderBottom ? "border-b" : "")">
                    <div class="size-7 shrink-0 rounded-full bg-muted/50"></div>
                    <div class="min-w-0 flex-1">
                        <div class="h-2 w-24 rounded bg-muted/50"></div>
                    </div>
                    <div class="@Cn.Merge("h-1.5 rounded bg-muted/40", member.RoleWidth)"></div>
                </div>
            }
        </div>

        @* CTA *@
        <div class="flex flex-col items-center border-t px-4 py-6 text-center">
            <h3 class="text-sm font-medium">Invite your team</h3>
            <p class="mt-1 max-w-xs text-xs text-muted-foreground">
                Collaborate by sending invitations. Members get access to shared projects and resources.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-4 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="user-plus" Size="14" Class="size-3.5" />
                Send invites
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private static readonly int[] _avatarIndexes = [0, 1, 2, 3, 4];

    private record GhostMember(string RoleWidth, bool BorderBottom);

    private static readonly GhostMember[] _ghostMembers =
    [
        new("w-16", true),
        new("w-12", true),
        new("w-20", false),
    ];
}
