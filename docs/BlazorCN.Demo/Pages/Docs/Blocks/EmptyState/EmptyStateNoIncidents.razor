@* ============================================================
   Block: empty-state-no-incidents
   Title: EmptyStateNoIncidents
   Description: React empty state block for security incident dashboards with all-clear status, severity breakdown, and monitoring configuration CTA, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations
   Source: original/blocks/empty-state/empty-state-no-incidents.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Security Incidents</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="relative flex size-2">
                    <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
                </span>
                <span class="text-emerald-600 text-xs dark:text-emerald-400">Secure</span>
            </div>
        </div>

        @* Incident count summary *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <span class="font-semibold text-2xl tabular-nums text-emerald-600 dark:text-emerald-400">
                    0
                </span>
                <div>
                    <p class="font-medium text-sm">No incidents detected</p>
                    <p class="text-muted-foreground text-xs">
                        Your environment is clear of security threats
                    </p>
                </div>
            </div>
        </div>

        @* Severity breakdown *@
        <div>
            @foreach (var level in _severityLevels)
            {
                var isLast = level == _severityLevels[^1];
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-3", !isLast ? "border-b" : "")">
                    <div class="flex items-center gap-2">
                        <span class="@Cn.Merge("size-1.5 rounded-full", level.Dot)"></span>
                        <span class="text-sm">@level.Label</span>
                    </div>
                    <span class="font-mono text-muted-foreground text-xs tabular-nums">@level.Count</span>
                </div>
            }
        </div>

        @* Footer CTA *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <p class="text-muted-foreground text-xs">Last scan: 3 hours ago</p>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideIconCn Name="settings" Size="14" Class="size-3.5" />
                Configure monitoring
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record SeverityLevel(string Label, string Dot, int Count);

    private static readonly SeverityLevel[] _severityLevels =
    [
        new("Critical", "bg-red-500", 0),
        new("High", "bg-amber-500", 0),
        new("Medium", "bg-yellow-500", 0),
        new("Low", "bg-blue-500", 0),
    ];
}
