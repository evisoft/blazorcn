@* ============================================================
   Block: empty-state-no-time-entries
   Title: EmptyStateNoTimeEntries
   Description: A timesheet table empty state with skeleton rows and start timer CTA, built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-time-entries.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="timer" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Time entries</span>
            </div>
            <span class="text-xs text-muted-foreground">0h 0m logged</span>
        </div>

        @* Table skeleton *@
        <div class="relative">
            @* Table header *@
            <div class="grid grid-cols-[1fr_1.5fr_80px] gap-3 border-b bg-muted/30 px-4 py-2">
                @foreach (var header in _tableHeaders)
                {
                    <span class="text-xs font-medium text-muted-foreground/60">@header</span>
                }
            </div>

            @* Table rows *@
            @foreach (var row in _skeletonRows)
            {
                <div class="grid grid-cols-[1fr_1.5fr_80px] items-center gap-3 border-b px-4 py-3">
                    <div class="@($"h-3 rounded bg-muted/60 {row.ProjectWidth}")"></div>
                    <div class="@($"h-3 rounded bg-muted/50 {row.TaskWidth}")"></div>
                    <div class="@($"h-3 rounded bg-muted/40 {row.DurationWidth}")"></div>
                </div>
            }

            @* Overlay message *@
            <div class="absolute inset-0 flex flex-col items-center justify-center bg-card/80 backdrop-blur-[1px]">
                <div class="flex size-10 items-center justify-center rounded-full bg-muted/50">
                    <LucideIconCn Name="timer" Size="20" Class="size-5 text-muted-foreground" />
                </div>
                <h2 class="mt-3 text-sm font-medium">No time tracked</h2>
                <p class="mt-1 max-w-xs text-center text-xs text-muted-foreground">
                    Start a timer to log your work hours. Track time across projects and tasks for
                    accurate reporting.
                </p>
                <ButtonCn Size="ButtonSize.Sm" Class="mt-4 gap-1.5">
                    <LucideIconCn Name="play" Size="14" Class="size-3.5" />
                    Start timer
                </ButtonCn>
            </div>
        </div>

        @* Footer with total *@
        <div class="flex items-center justify-between px-4 py-3">
            <p class="text-xs text-muted-foreground">
                Time entries can be exported for invoicing and payroll.
            </p>
            <span class="font-mono text-xs text-muted-foreground/50">00:00:00</span>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _tableHeaders = ["Project", "Task", "Duration"];

    private record SkeletonRow(string ProjectWidth, string TaskWidth, string DurationWidth);

    private static readonly SkeletonRow[] _skeletonRows =
    [
        new("w-24", "w-40", "w-14"),
        new("w-20", "w-32", "w-16"),
        new("w-28", "w-36", "w-12"),
        new("w-22", "w-44", "w-14"),
        new("w-26", "w-28", "w-16"),
    ];
}
