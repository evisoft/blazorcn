@* ============================================================
   Block: empty-state-no-collections
   Title: EmptyStateNoCollections
   Description: React empty state block for product collections with no groups created, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations featuring a grid of empty image placeholders and create collection CTA
   Source: original/blocks/empty-state/empty-state-no-collections.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="layout-grid" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">Collections</span>
        </div>

        @* Empty state content *@
        <div class="flex flex-col items-center px-4 py-12">
            @* Grid of empty image slots *@
            <div class="mb-6 grid w-full max-w-[200px] grid-cols-2 gap-2">
                @foreach (var slot in _gridSlots)
                {
                    <div class="flex aspect-square items-center justify-center rounded-md border border-dashed bg-muted/20">
                        <LucideIconCn Name="image" Size="20" Class="size-5 text-muted-foreground/30" />
                    </div>
                }
            </div>

            @* Text *@
            <h3 class="text-sm font-medium">No collections yet</h3>
            <p class="mt-1.5 max-w-xs text-center text-xs text-muted-foreground leading-relaxed">
                Group products into collections like "Summer Sale" or "New Arrivals" to help customers
                discover what they need.
            </p>

            @* CTA *@
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Create collection
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                Collections can be featured on your storefront and used for targeted promotions.
            </p>
        </div>
    </div>
</section>

@code {
    private static readonly int[] _gridSlots = [0, 1, 2, 3];
}
