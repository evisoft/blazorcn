@* ============================================================
   Block: empty-state-no-error-tracking
   Title: EmptyStateNoErrorTracking
   Description: React empty state block for error monitoring dashboards with zero-errors celebration, terminal-style SDK snippet, and setup CTA, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations
   Source: original/blocks/empty-state/empty-state-no-error-tracking.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="circle-check-big" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Error Tracking</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="relative flex size-2">
                    <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
                </span>
                <span class="text-emerald-600 text-xs dark:text-emerald-400">No errors</span>
            </div>
        </div>

        @* Zero count *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <span class="font-semibold text-2xl tabular-nums text-emerald-600 dark:text-emerald-400">
                    0
                </span>
                <div>
                    <p class="font-medium text-sm">No errors detected</p>
                    <p class="text-muted-foreground text-xs">
                        Your application is running without issues
                    </p>
                </div>
            </div>
        </div>

        @* Code snippet *@
        <div class="border-b px-4 py-4">
            <div class="overflow-hidden rounded-md bg-zinc-950">
                <div class="flex items-center justify-between px-3 py-2">
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="terminal" Size="12" Class="size-3 text-zinc-500" />
                        <span class="text-xs text-zinc-500">Quick start</span>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs text-zinc-400 hover:bg-zinc-800 hover:text-zinc-200" @onclick="HandleCopy">
                        @if (_copied)
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                            @("Copied")
                        }
                        else
                        {
                            <LucideIconCn Name="copy" Size="12" Class="size-3" />
                            @("Copy")
                        }
                    </ButtonCn>
                </div>
                <div class="px-3 pb-3">
                    <pre class="overflow-x-auto font-mono text-xs leading-relaxed text-zinc-300">@_codeSnippet</pre>
                </div>
            </div>
        </div>

        @* Footer CTA *@
        <div class="flex items-center gap-4 px-4 py-4">
            <div class="min-w-0 flex-1">
                <h3 class="font-medium text-sm">Get started with error tracking</h3>
                <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">
                    Install the SDK to capture exceptions, stack traces, and breadcrumbs automatically.
                </p>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 shrink-0 gap-1.5 text-xs">
                Install SDK
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private bool _copied = false;

    private const string _codeSnippet =
        "npm install @acme/error-tracking\n\nimport { init } from \"@acme/error-tracking\"\n\ninit({\n  dsn: \"https://key@errors.acme.dev/1\",\n  environment: \"production\",\n})";

    private async Task HandleCopy()
    {
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }
}
