@* ============================================================
   Block: empty-state-no-filter-results
   Title: EmptyStateNoFilterResults
   Description: React empty state block for filtered views returning no matches, built with Next.js, shadcn/ui, Tailwind CSS, and subtle motion animations
   Source: original/blocks/empty-state/empty-state-no-filter-results.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with filter icon *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="filter" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Filtered view</span>
            </div>
            <span class="text-muted-foreground text-xs">
                @_activeFilters.Length filters active
            </span>
        </div>

        @* Active filter badges *@
        <div class="flex flex-wrap items-center gap-1.5 border-b px-4 py-3">
            @foreach (var filter in _activeFilters)
            {
                <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 pr-1.5 font-normal text-xs">
                    <span class="text-muted-foreground">@filter.Label:</span>
                    @filter.Value
                    <button type="button" class="ml-0.5 rounded-sm p-0.5 transition-colors hover:bg-muted">
                        <LucideIconCn Name="x" Size="12" Class="size-3" />
                    </button>
                </BadgeCn>
            }
        </div>

        @* Empty grid placeholder *@
        <div class="flex flex-col items-center px-4 py-12">
            @* Skeleton grid *@
            <div class="mb-6 grid grid-cols-3 gap-2">
                @foreach (var i in Enumerable.Range(0, 6))
                {
                    <div class="h-10 w-16 rounded-md bg-muted/40"></div>
                }
            </div>

            <h3 class="font-medium text-sm">No items match these filters</h3>
            <p class="mt-1.5 max-w-xs text-center text-muted-foreground text-xs leading-relaxed">
                The combination of @_activeFilters.Length active filters didn&apos;t match any items.
                Try removing a filter or resetting all filters.
            </p>

            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                Reset all filters
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ActiveFilter(string Id, string Label, string Value);

    private static readonly ActiveFilter[] _activeFilters =
    [
        new("status", "Status", "Active"),
        new("category", "Category", "Enterprise"),
        new("region", "Region", "APAC"),
    ];
}
