@* ============================================================
   Block: empty-state-no-projects
   Title: EmptyStateNoProjects
   Description: A minimal empty state for workspaces with no projects, built with React, Next.js, shadcn/ui, and Tailwind CSS featuring ghost project card previews, a status column skeleton, and create project CTA
   Source: original/blocks/empty-state/empty-state-no-projects.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header row *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="folder-open" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Projects</span>
            </div>
            <span class="text-xs text-muted-foreground">0 items</span>
        </div>

        @* Ghost project rows *@
        <div aria-hidden="true">
            @foreach (var proj in _ghostProjects)
            {
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", proj.BorderBottom ? "border-b" : "")">
                    <div class="size-8 shrink-0 rounded-md bg-muted/60"></div>
                    <div class="min-w-0 flex-1">
                        <div class="@Cn.Merge("h-2 rounded bg-muted/60", proj.NameWidth)"></div>
                        <div class="mt-2 flex items-center gap-2">
                            <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full opacity-50", proj.StatusColor)"></span>
                            <div class="h-1.5 w-16 rounded bg-muted/40"></div>
                        </div>
                    </div>
                    <div class="w-20 shrink-0">
                        <div class="h-1.5 w-full rounded-full bg-muted/30">
                            <div class="@Cn.Merge("h-1.5 rounded-full bg-muted/50", proj.Progress)"></div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Message + CTA *@
        <div class="flex flex-col items-center border-t px-4 py-8 text-center">
            <h2 class="text-sm font-medium">No projects yet</h2>
            <p class="mt-1.5 max-w-xs text-xs text-muted-foreground">
                Create your first project to start organizing work and tracking progress.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-4 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Create project
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record GhostProject(string NameWidth, string StatusColor, string Progress, bool BorderBottom);

    private static readonly GhostProject[] _ghostProjects =
    [
        new("w-32", "bg-emerald-500", "w-3/4", true),
        new("w-40", "bg-amber-500", "w-1/2", true),
        new("w-28", "bg-blue-500", "w-1/3", false),
    ];
}
