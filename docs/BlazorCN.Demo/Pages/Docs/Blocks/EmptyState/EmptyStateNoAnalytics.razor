@* ============================================================
   Block: empty-state-no-analytics
   Title: EmptyStateNoAnalytics
   Description: React empty state block for analytics dashboards with no data yet, built with Next.js, shadcn/ui, Tailwind CSS, and subtle motion animations
   Source: original/blocks/empty-state/empty-state-no-analytics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="bar-chart-3" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Analytics</span>
        </div>

        @* Empty state content *@
        <div class="flex flex-col items-center px-4 py-12">
            @* Chart placeholder *@
            <div class="mb-6 flex items-end gap-1.5">
                @foreach (var height in _barHeights)
                {
                    <div class="@Cn.Merge("w-5 origin-bottom rounded-sm bg-muted/60", height)"></div>
                }
            </div>

            @* Text *@
            <h3 class="font-medium text-sm">No analytics data yet</h3>
            <p class="mt-1.5 max-w-xs text-center text-muted-foreground text-xs leading-relaxed">
                Connect a data source to start tracking page views, events, and user behavior across
                your application.
            </p>

            @* CTA *@
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Set up analytics
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _barHeights = ["h-4", "h-8", "h-12", "h-6", "h-16", "h-10", "h-14", "h-7"];
}
