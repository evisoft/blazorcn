@* ============================================================
   Block: empty-state-no-shared-items
   Title: EmptyStateNoSharedItems
   Description: React empty state block for shared content sections showing overlapping user avatars, a message about shared content appearing here, and an invite collaborators CTA built with Next.js, shadcn/ui, Tailwind CSS, and motion animations
   Source: original/blocks/empty-state/empty-state-no-shared-items.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="share" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Shared with you</span>
            <span class="ml-auto text-muted-foreground text-xs">0 items</span>
        </div>

        @* Content *@
        <div class="px-4 py-6">
            @* Overlapping avatar row *@
            <div class="flex justify-center">
                <div class="flex -space-x-2.5">
                    @foreach (var avatar in _placeholderAvatars)
                    {
                        <div class="@Cn.Merge("flex size-9 items-center justify-center rounded-full border-2 border-card", avatar.Bg)">
                            <span class="font-medium text-muted-foreground/50 text-xs">@avatar.Initials</span>
                        </div>
                    }
                </div>
            </div>

            @* Skeleton shared content rows *@
            <div class="mx-auto mt-5 max-w-xs space-y-2.5">
                @foreach (var row in _skeletonRows)
                {
                    <div class="flex items-center gap-3 rounded-md bg-muted/20 px-3 py-2.5">
                        <LucideIconCn Name="users" Size="14" Class="size-3.5 shrink-0 text-muted-foreground/25" />
                        <div class="@Cn.Merge("h-2 rounded bg-muted/40", row.Width)"></div>
                    </div>
                }
            </div>

            @* Message *@
            <div class="mt-6 flex flex-col items-center text-center">
                <h3 class="font-medium text-sm">Nothing shared with you</h3>
                <p class="mt-1.5 max-w-xs text-muted-foreground text-xs leading-relaxed">
                    When collaborators share files, documents, or projects with you, they will appear
                    here. Invite someone to get started.
                </p>

                <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                    <LucideIconCn Name="user-plus" Size="14" Class="size-3.5" />
                    Invite collaborators
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record PlaceholderAvatar(string Initials, string Bg);
    private record SkeletonRow(string Width);

    private static readonly PlaceholderAvatar[] _placeholderAvatars =
    [
        new("?", "bg-muted/60"),
        new("?", "bg-muted/50"),
        new("?", "bg-muted/40"),
        new("+", "bg-muted/30"),
    ];

    private static readonly SkeletonRow[] _skeletonRows =
    [
        new("w-3/4"),
        new("w-2/3"),
        new("w-1/2"),
    ];
}
