@* ============================================================
   Block: empty-state-no-roadmap
   Title: EmptyStateNoRoadmap
   Description: An empty product roadmap state with phased column layout and create roadmap CTA, built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-roadmap.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="text-sm font-medium">Product Roadmap</span>
        </div>

        @* Phase columns preview *@
        <div class="grid grid-cols-3 gap-px border-b bg-border">
            @foreach (var phase in _phases)
            {
                <div class="bg-card px-3 py-4 text-center">
                    <span class="text-xs font-medium">@phase.Label</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">@phase.Description</p>
                    <div class="mx-auto mt-3 space-y-1.5">
                        <div class="h-2 rounded bg-muted/50"></div>
                        <div class="mx-auto h-2 w-3/4 rounded bg-muted/30"></div>
                    </div>
                </div>
            }
        </div>

        @* Message and CTA *@
        <div class="flex flex-col items-center px-4 py-10 text-center">
            <div class="flex size-11 items-center justify-center rounded-full bg-muted/50">
                <LucideIconCn Name="route" Size="20" Class="size-5 text-muted-foreground" />
            </div>
            <h2 class="mt-4 text-sm font-medium">Build your product vision</h2>
            <p class="mt-1.5 max-w-[300px] text-xs text-muted-foreground leading-relaxed">
                A roadmap aligns your team around what to build and when. Organize initiatives by
                priority and share progress with stakeholders.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 gap-1.5">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Create roadmap
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                Roadmaps can be shared publicly or kept private to your team.
            </p>
        </div>
    </div>
</section>

@code {
    private record Phase(string Label, string Description);

    private static readonly Phase[] _phases =
    [
        new("Now", "Current focus"),
        new("Next", "Up next"),
        new("Later", "Future ideas"),
    ];
}
