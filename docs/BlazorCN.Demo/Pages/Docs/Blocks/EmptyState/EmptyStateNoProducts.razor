@* ============================================================
   Block: empty-state-no-products
   Title: EmptyStateNoProducts
   Description: React empty state block for product catalogs with no items, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations featuring a package icon, skeleton product card, and add product CTA
   Source: original/blocks/empty-state/empty-state-no-products.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="package" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">Products</span>
        </div>

        @* Empty state content *@
        <div class="flex flex-col items-center px-4 py-12">
            @* Icon *@
            <div class="flex size-12 items-center justify-center rounded-full bg-muted/50">
                <LucideIconCn Name="package" Size="24" Class="size-6 text-muted-foreground" />
            </div>

            @* Text *@
            <h3 class="mt-4 text-sm font-medium">No products added</h3>
            <p class="mt-1.5 max-w-xs text-center text-xs text-muted-foreground leading-relaxed">
                Add your first product to start building your catalog. Products will appear here with
                pricing, images, and inventory status.
            </p>

            @* Skeleton product card *@
            <div class="mt-6 w-full max-w-xs rounded-md border border-dashed p-3">
                <div class="flex items-start gap-3">
                    <div class="size-12 shrink-0 rounded-md bg-muted/50"></div>
                    <div class="flex-1 space-y-2">
                        <div class="h-3 w-3/4 rounded bg-muted/50"></div>
                        <div class="h-2.5 w-1/2 rounded bg-muted/40"></div>
                        <div class="h-2.5 w-1/4 rounded bg-muted/30"></div>
                    </div>
                </div>
            </div>

            @* CTA *@
            <ButtonCn Size="ButtonSize.Sm" Class="mt-6 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Add product
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                Products can include images, variants, pricing tiers, and inventory tracking.
            </p>
        </div>
    </div>
</section>
