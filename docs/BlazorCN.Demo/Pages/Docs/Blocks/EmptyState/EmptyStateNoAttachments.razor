@* ============================================================
   Block: empty-state-no-attachments
   Title: EmptyStateNoAttachments
   Description: React empty state block for items with no file attachments, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations with a paperclip icon
   Source: original/blocks/empty-state/empty-state-no-attachments.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="paperclip" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Attachments</span>
            </div>
            <span class="rounded-full bg-muted/50 px-2 py-0.5 text-muted-foreground text-xs tabular-nums">
                0
            </span>
        </div>

        @* Empty state content *@
        <div class="flex flex-col items-center px-4 py-14 text-center">
            @* Animated icon cluster *@
            <div class="relative flex size-14 items-center justify-center">
                <div class="flex size-12 items-center justify-center rounded-full bg-muted/50">
                    <LucideIconCn Name="paperclip" Size="24" Class="size-6 text-muted-foreground" />
                </div>
                <div class="absolute -right-1 -top-1 flex size-5 items-center justify-center rounded-full bg-muted">
                    <LucideIconCn Name="plus" Size="12" Class="size-3 text-muted-foreground" />
                </div>
            </div>

            <h3 class="mt-4 font-medium text-sm">No attachments</h3>
            <p class="mt-1.5 max-w-xs text-muted-foreground text-xs leading-relaxed">
                Add files to this item for easy reference. Attach documents, images, or any supporting
                material your team needs.
            </p>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="paperclip" Size="14" Class="size-3.5" />
                Attach file
            </ButtonCn>
        </div>
    </div>
</section>
