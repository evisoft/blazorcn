@* ============================================================
   Block: empty-state-no-threads
   Title: EmptyStateNoThreads
   Description: An empty discussion threads state with a message-square icon, conversation prompt, and create thread CTA using shadcn/ui and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-threads.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="message-square" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Threads</span>
            </div>
        </div>

        <div class="flex flex-col items-center gap-6 sm:flex-row sm:items-start sm:gap-0">
            @* Decorative illustration *@
            <div class="flex shrink-0 flex-col gap-2.5 px-6 pt-8 sm:border-r sm:py-10">
                <div class="h-8 w-44 rounded-md border border-dashed"></div>
                <div class="ml-6 h-6 w-36 rounded-md border border-dashed"></div>
                <div class="h-8 w-40 rounded-md border border-dashed"></div>
                <div class="ml-4 h-6 w-32 rounded-md border border-dashed"></div>
            </div>

            @* Content *@
            <div class="flex flex-1 flex-col items-center px-6 py-8 text-center sm:items-start sm:justify-center sm:py-10 sm:text-left">
                <h3 class="text-sm font-medium">No threads yet</h3>
                <p class="mt-1.5 max-w-xs text-xs text-muted-foreground">
                    Threads are where conversations happen. Start a discussion to share ideas, ask
                    questions, or coordinate with your team.
                </p>
                <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    Create thread
                </ButtonCn>
            </div>
        </div>
    </div>
</section>
