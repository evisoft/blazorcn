@* ============================================================
   Block: empty-state-no-uptime-checks
   Title: EmptyStateNoUptimeChecks
   Description: React empty state block for uptime monitoring with empty server grid placeholders, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations
   Source: original/blocks/empty-state/empty-state-no-uptime-checks.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="activity" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Uptime Monitors</span>
            </div>
            <span class="text-muted-foreground text-xs">0 monitors</span>
        </div>

        @* Monitor grid placeholders *@
        <div class="border-b px-4 py-4">
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
                @foreach (var monitor in _monitors)
                {
                    <div class="rounded-md border border-dashed border-muted-foreground/20 px-3 py-3">
                        <span class="text-muted-foreground/60 text-xs">@monitor.Label</span>
                        <div class="mt-1.5 flex items-center gap-1.5">
                            <span class="size-1.5 rounded-full bg-muted-foreground/20"></span>
                            <span class="font-mono text-muted-foreground/30 text-xs">@monitor.Protocol</span>
                        </div>
                        <div class="mt-2 flex gap-0.5">
                            @for (int j = 0; j < 7; j++)
                            {
                                <div class="h-3 flex-1 rounded-sm bg-muted-foreground/8"></div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Message and CTA *@
        <div class="flex items-center gap-4 px-4 py-4">
            <div class="min-w-0 flex-1">
                <h3 class="font-medium text-sm">No uptime monitors configured</h3>
                <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">
                    Add monitors to track the availability of your services, APIs, and websites.
                </p>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 shrink-0 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Add monitor
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Monitor(string Id, string Label, string Protocol);

    private static readonly Monitor[] _monitors =
    [
        new("m1", "API endpoint", "HTTPS"),
        new("m2", "Web application", "HTTPS"),
        new("m3", "Database server", "TCP"),
        new("m4", "CDN origin", "HTTPS"),
        new("m5", "Auth service", "HTTPS"),
        new("m6", "Worker process", "TCP"),
    ];
}
