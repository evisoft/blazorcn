@* ============================================================
   Block: empty-state-no-pinned-items
   Title: EmptyStateNoPinnedItems
   Description: React empty state block for pinned content sections with a pinboard grid skeleton, pin icon accents, and an explore CTA built with Next.js, shadcn/ui, Tailwind CSS, and motion animations
   Source: original/blocks/empty-state/empty-state-no-pinned-items.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="pin" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">Pinned</span>
            <span class="ml-auto text-xs text-muted-foreground">0 items</span>
        </div>

        @* Content *@
        <div class="px-4 py-6">
            @* Pinboard grid *@
            <div class="grid grid-cols-2 gap-2">
                @foreach (var card in _pinCards)
                {
                    <div class="@Cn.Merge(card.Height, card.Span, "relative rounded-md bg-muted/30")">
                        <LucideIconCn Name="pin" Size="12" Class="absolute right-2 top-2 size-3 rotate-45 text-muted-foreground/20" />
                        <div class="p-3">
                            <div class="h-2 w-3/5 rounded bg-muted/50"></div>
                            <div class="mt-2 h-2 w-2/5 rounded bg-muted/35"></div>
                        </div>
                    </div>
                }
            </div>

            @* Message *@
            <div class="mt-6 flex flex-col items-center text-center">
                <h3 class="text-sm font-medium">No pinned items</h3>
                <p class="mt-1.5 max-w-xs text-xs text-muted-foreground leading-relaxed">
                    Pin important items for quick access. Pinned content stays at the top of your
                    workspace so you can find it instantly.
                </p>

                <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                    <LucideIconCn Name="compass" Size="14" Class="size-3.5" />
                    Explore content
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record PinCard(string Id, string Height, string Span);

    private static readonly PinCard[] _pinCards =
    [
        new("p1", "h-24", "col-span-1"),
        new("p2", "h-24", "col-span-1"),
        new("p3", "h-28", "col-span-2"),
        new("p4", "h-24", "col-span-1"),
        new("p5", "h-24", "col-span-1"),
    ];
}
