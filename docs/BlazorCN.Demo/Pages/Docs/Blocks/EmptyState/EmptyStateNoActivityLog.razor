@* ============================================================
   Block: empty-state-no-activity-log
   Title: EmptyStateNoActivityLog
   Description: React empty state block for activity feeds with timeline skeleton nodes and event tracking CTA, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations
   Source: original/blocks/empty-state/empty-state-no-activity-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="scroll-text" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Activity Log</span>
            </div>
            <span class="text-muted-foreground text-xs">0 events</span>
        </div>

        @* Timeline skeleton *@
        <div class="relative">
            <div class="px-4 py-4">
                @foreach (var node in _timelineNodes)
                {
                    var isLast = node == _timelineNodes[_timelineNodes.Length - 1];
                    <div class="flex gap-3">
                        @* Timeline track *@
                        <div class="flex flex-col items-center">
                            <div class="size-2 rounded-full bg-muted/60" />
                            @if (!isLast)
                            {
                                <div class="w-px flex-1 bg-muted/40" />
                            }
                        </div>

                        @* Content placeholder *@
                        <div class="@Cn.Merge("flex items-center gap-3", isLast ? "pb-0" : "pb-5")">
                            <div class="@Cn.Merge("h-2.5 rounded bg-muted/40", node.TimeWidth)" />
                            <div class="@Cn.Merge("h-2.5 rounded bg-muted/50", node.TextWidth)" />
                        </div>
                    </div>
                }
            </div>

            @* Center overlay *@
            <div class="absolute inset-0 flex flex-col items-center justify-center bg-card/80 backdrop-blur-[1px]">
                <div class="flex size-10 items-center justify-center rounded-full bg-muted/50">
                    <LucideIconCn Name="scroll-text" Size="20" Class="size-5 text-muted-foreground" />
                </div>
                <h3 class="mt-3 font-medium text-sm">No activity recorded</h3>
                <p class="mt-1 max-w-xs text-center text-muted-foreground text-xs">
                    User actions, system events, and changes will appear here as they happen.
                </p>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-4 h-8 gap-1.5 text-xs">
                    <LucideIconCn Name="external-link" Size="14" Class="size-3.5" />
                    Learn about tracked events
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <p class="text-center text-muted-foreground text-xs">
                Activity logs are retained for 90 days and exportable as CSV.
            </p>
        </div>
    </div>
</section>

@code {
    private record TimelineNode(string TimeWidth, string TextWidth);

    private static readonly TimelineNode[] _timelineNodes =
    [
        new("w-12", "w-44"),
        new("w-10", "w-36"),
        new("w-14", "w-52"),
        new("w-10", "w-40"),
        new("w-12", "w-32"),
    ];
}
