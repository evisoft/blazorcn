@* ============================================================
   Block: empty-state-no-payment-methods
   Title: EmptyStateNoPaymentMethods
   Description: A minimal empty state for payment settings with no saved cards, built with React, Next.js, shadcn/ui, and Tailwind CSS featuring a card-shaped placeholder with dashed border and add payment method CTA
   Source: original/blocks/empty-state/empty-state-no-payment-methods.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="wallet" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">Payment methods</span>
        </div>

        @* Card placeholder *@
        <div class="px-4 pt-8 pb-4">
            <div class="mx-auto max-w-xs" aria-hidden="true">
                <div class="flex aspect-video flex-col justify-between rounded-lg border-2 border-dashed border-muted-foreground/20 bg-muted/30 p-4">
                    @* Top row - chip and brand *@
                    <div class="flex items-center justify-between">
                        <div class="h-5 w-8 rounded bg-muted/60"></div>
                        <LucideIconCn Name="credit-card" Size="20" Class="size-5 text-muted-foreground/30" />
                    </div>

                    @* Card number placeholder *@
                    <div class="flex gap-3">
                        @foreach (var i in _groupIndices)
                        {
                            <div class="flex gap-1">
                                @foreach (var j in _dotIndices)
                                {
                                    <div class="size-1.5 rounded-full bg-muted-foreground/20"></div>
                                }
                            </div>
                        }
                    </div>

                    @* Bottom row - name and expiry *@
                    <div class="flex items-end justify-between">
                        <div class="h-2.5 w-24 rounded bg-muted/60"></div>
                        <div class="h-2.5 w-12 rounded bg-muted/60"></div>
                    </div>
                </div>
            </div>
        </div>

        @* Empty message *@
        <div class="flex flex-col items-center px-4 pb-10 text-center">
            <h3 class="text-sm font-medium">No payment methods added</h3>
            <p class="mt-1.5 max-w-xs text-xs text-muted-foreground">
                Add a credit card, debit card, or bank account to enable payments and manage your
                billing securely.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Add payment method
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                Payment information is encrypted and stored securely.
            </p>
        </div>
    </div>
</section>

@code {
    private static readonly int[] _groupIndices = [0, 1, 2, 3];
    private static readonly int[] _dotIndices = [0, 1, 2, 3];
}
