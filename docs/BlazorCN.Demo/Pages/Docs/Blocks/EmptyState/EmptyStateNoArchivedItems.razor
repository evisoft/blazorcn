@* ============================================================
   Block: empty-state-no-archived-items
   Title: EmptyStateNoArchivedItems
   Description: React empty state block for archive sections showing a folder-based list skeleton with muted styling, a message about archived items being stored here, and a CTA to browse active items built with Next.js, shadcn/ui, Tailwind CSS, and motion animations
   Source: original/blocks/empty-state/empty-state-no-archived-items.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="archive" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Archive</span>
            <span class="ml-auto text-muted-foreground text-xs">0 items</span>
        </div>

        @* Content *@
        <div class="py-2">
            @* Skeleton file list *@
            <div>
                @foreach (var file in _skeletonFiles)
                {
                    <div class="flex items-center gap-3 px-4 py-2.5">
                        <LucideIconCn Name="@file.IconName" Size="16" Class="size-4 shrink-0 text-muted-foreground/20" />
                        <div class="min-w-0 flex-1">
                            <div class="@($"{file.Width} h-2 rounded bg-muted/40")" />
                            <div class="@($"{file.Sub} mt-1.5 h-1.5 rounded bg-muted/25")" />
                        </div>
                        <div class="h-1.5 w-10 rounded bg-muted/20" />
                    </div>
                }
            </div>

            @* Message *@
            <div class="mt-4 flex flex-col items-center border-t px-4 pt-6 pb-6 text-center">
                <h3 class="font-medium text-sm">Archive is empty</h3>
                <p class="mt-1.5 max-w-xs text-muted-foreground text-xs leading-relaxed">
                    Items you archive will be stored here for safekeeping. Archive content you no longer
                    need but want to keep for reference.
                </p>

                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                    <LucideIconCn Name="arrow-left" Size="14" Class="size-3.5" />
                    Browse active items
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record SkeletonFile(string Id, string IconName, string Width, string Sub);

    private static readonly SkeletonFile[] _skeletonFiles =
    [
        new("f1", "folder", "w-28", "w-16"),
        new("f2", "file",   "w-36", "w-20"),
        new("f3", "file",   "w-24", "w-14"),
        new("f4", "folder", "w-32", "w-18"),
        new("f5", "file",   "w-20", "w-12"),
    ];
}
