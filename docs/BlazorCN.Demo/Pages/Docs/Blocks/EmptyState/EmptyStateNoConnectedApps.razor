@* ============================================================
   Block: empty-state-no-connected-apps
   Title: EmptyStateNoConnectedApps
   Description: An empty state block for when no external applications are linked showing icon pairs with dotted connector lines and a CTA to connect an app
   Source: original/blocks/empty-state/empty-state-no-connected-apps.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="link" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Connected Apps</span>
                <span class="text-muted-foreground text-xs">0</span>
            </div>
        </div>

        @* Empty content *@
        <div class="flex flex-col items-center justify-center px-6 py-14 text-center">
            @* Icon pairs with dotted connectors *@
            <div class="flex items-center gap-0">
                @* Central hub icon *@
                <div class="flex size-10 items-center justify-center rounded-lg border bg-card shadow-sm">
                    <LucideIconCn Name="link" Size="16" Class="size-4 text-foreground" />
                </div>

                @* Connector lines and placeholder apps *@
                <div class="flex flex-col gap-2.5">
                    @foreach (var app in _placeholderApps)
                    {
                        <div class="flex items-center">
                            <div class="w-10 border-t border-dashed border-muted-foreground/25"></div>
                            <div class="flex size-9 items-center justify-center rounded-lg border border-dashed bg-muted/30">
                                <LucideIconCn Name="circle-dashed" Size="14" Class="size-3.5 text-muted-foreground/40" />
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="mt-5">
                <h3 class="font-medium text-sm">No apps connected</h3>
                <p class="mx-auto mt-1.5 max-w-xs text-muted-foreground text-sm">
                    Link external applications to sync data, trigger actions, and build a connected
                    workflow across your tools.
                </p>
            </div>

            <div class="mt-6">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="mr-1.5 size-3.5" />
                    Connect app
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record PlaceholderApp(string Id, string Label);

    private static readonly PlaceholderApp[] _placeholderApps =
    [
        new("app-1", "App"),
        new("app-2", "App"),
        new("app-3", "App"),
    ];
}
