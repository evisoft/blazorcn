@* ============================================================
   Block: empty-state-no-saved-searches
   Title: EmptyStateNoSavedSearches
   Description: React empty state block for saved searches section with no queries saved, built with Next.js, shadcn/ui, Tailwind CSS, and subtle motion animations
   Source: original/blocks/empty-state/empty-state-no-saved-searches.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="search-check" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Saved searches</span>
            <span class="ml-auto text-muted-foreground text-xs">0 saved</span>
        </div>

        @* Skeleton list *@
        <div class="border-b">
            @foreach (var row in _skeletonRows)
            {
                var isLast = row == _skeletonRows[^1];
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", !isLast ? "border-b" : "")">
                    <LucideIconCn Name="search" Size="14" Class="size-3.5 shrink-0 text-muted-foreground/25" />
                    <div class="@($"h-2 {row.Width} rounded bg-muted/40")"></div>
                    <div class="ml-auto h-2 w-8 rounded bg-muted/30"></div>
                </div>
            }
        </div>

        @* Empty message *@
        <div class="flex flex-col items-center px-4 py-8 text-center">
            <h3 class="font-medium text-sm">No saved searches</h3>
            <p class="mt-1.5 max-w-xs text-muted-foreground text-xs leading-relaxed">
                Save your frequent search queries for quick access. Click the save icon on any search
                result page to add it here.
            </p>

            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="search" Size="14" Class="size-3.5" />
                Search now
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record SkeletonRow(string Id, string Width);

    private static readonly SkeletonRow[] _skeletonRows =
    [
        new("r1", "w-40"),
        new("r2", "w-52"),
        new("r3", "w-36"),
        new("r4", "w-44"),
    ];
}
