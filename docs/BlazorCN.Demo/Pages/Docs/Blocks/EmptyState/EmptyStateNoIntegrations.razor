@* ============================================================
   Block: empty-state-no-integrations
   Title: EmptyStateNoIntegrations
   Description: An empty state block for a page with no third-party integrations showing a grid of empty connection slots with plus icons and a CTA to browse integrations
   Source: original/blocks/empty-state/empty-state-no-integrations.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="puzzle" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Integrations</span>
                <span class="text-muted-foreground text-xs">0 connected</span>
            </div>
        </div>

        @* Empty content *@
        <div class="flex flex-col items-center justify-center px-6 py-14 text-center">
            @* Grid of empty connection slots *@
            <div class="grid grid-cols-3 gap-3">
                @foreach (var slot in _slots)
                {
                    <div class="flex size-20 flex-col items-center justify-center gap-1.5 rounded-lg border border-dashed bg-muted/30">
                        <div class="flex size-7 items-center justify-center rounded-md bg-muted/60">
                            <LucideIconCn Name="plus" Size="14" Class="size-3.5 text-muted-foreground/50" />
                        </div>
                        <span class="text-muted-foreground/60 text-[10px]">@slot.Label</span>
                    </div>
                }
            </div>

            <div class="mt-5">
                <h3 class="font-medium text-sm">No integrations connected</h3>
                <p class="mx-auto mt-1.5 max-w-xs text-muted-foreground text-sm">
                    Connect your favorite tools and services to streamline your workflow and keep
                    everything in sync.
                </p>
            </div>

            <div class="mt-6">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    <LucideIconCn Name="puzzle" Size="14" Class="mr-1.5 size-3.5" />
                    Browse integrations
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record IntegrationSlot(string Label);

    private static readonly IntegrationSlot[] _slots =
    [
        new("Communication"),
        new("Storage"),
        new("Analytics"),
        new("CRM"),
        new("Payments"),
        new("Marketing"),
    ];
}
