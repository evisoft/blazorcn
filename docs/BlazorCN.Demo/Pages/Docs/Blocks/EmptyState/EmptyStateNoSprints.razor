@* ============================================================
   Block: empty-state-no-sprints
   Title: EmptyStateNoSprints
   Description: A sprint planning empty state with timeline visualization and start sprint CTA, built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-sprints.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="text-sm font-medium">Sprint Planning</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    No active sprint
                </BadgeCn>
            </div>
        </div>

        @* Empty timeline visualization *@
        <div class="border-b px-4 py-6">
            <div class="flex items-center gap-2">
                @foreach (var slot in _timelineSlots)
                {
                    <div class="@Cn.Merge("flex-1", slot.Opacity)">
                        <div class="h-8 rounded bg-muted"></div>
                        <span class="mt-1.5 block text-center text-xs text-muted-foreground">
                            @slot.Label
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Message and CTA *@
        <div class="flex flex-col items-center px-4 py-10 text-center">
            <div class="flex size-11 items-center justify-center rounded-full bg-muted/50">
                <LucideIconCn Name="timer" Size="20" Class="size-5 text-muted-foreground" />
            </div>
            <h2 class="mt-4 text-sm font-medium">Plan your first sprint</h2>
            <p class="mt-1.5 max-w-[300px] text-xs text-muted-foreground leading-relaxed">
                Sprints break work into focused iterations. Set a duration, pull items from the backlog,
                and ship incrementally.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 gap-1.5">
                <LucideIconCn Name="play" Size="14" Class="size-3.5" />
                Start sprint
            </ButtonCn>
        </div>

        @* Stats footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-center gap-4 text-xs text-muted-foreground">
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>0 sprints completed
                </span>
                <span class="text-muted-foreground/40">|</span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>0 story points
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record TimelineSlot(string Label, string Opacity);

    private static readonly TimelineSlot[] _timelineSlots =
    [
        new("Sprint 1", "opacity-30"),
        new("Sprint 2", "opacity-20"),
        new("Sprint 3", "opacity-10"),
    ];
}
