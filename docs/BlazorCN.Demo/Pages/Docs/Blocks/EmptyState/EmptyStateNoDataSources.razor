@* ============================================================
   Block: empty-state-no-data-sources
   Title: EmptyStateNoDataSources
   Description: An empty state block for when no data sources are linked showing a database diagram placeholder with table outlines and a CTA to add a data source
   Source: original/blocks/empty-state/empty-state-no-data-sources.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="database" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Data Sources</span>
                <span class="text-muted-foreground text-xs">0 connected</span>
            </div>
        </div>

        @* Empty content *@
        <div class="flex flex-col items-center justify-center px-6 py-14 text-center">
            @* Database diagram placeholder *@
            <div class="flex gap-3">
                @foreach (var tbl in _placeholderTables)
                {
                    <div class="w-24 overflow-hidden rounded-md border border-dashed bg-muted/20">
                        @* Table header *@
                        <div class="border-b border-dashed px-2.5 py-1.5">
                            <div class="h-2 w-14 rounded-sm bg-muted-foreground/15"></div>
                        </div>
                        @* Column rows *@
                        <div class="space-y-1.5 px-2.5 py-2">
                            @for (int j = 0; j < tbl.Columns; j++)
                            {
                                var colWidth = $"{60 + ((j * 17) % 35)}%";
                                <div class="h-1.5 rounded-sm bg-muted-foreground/10" style="@($"width:{colWidth}")"></div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="mt-5">
                <h3 class="font-medium text-sm">No data sources linked</h3>
                <p class="mx-auto mt-1.5 max-w-xs text-muted-foreground text-sm">
                    Connect a database, upload a file, or link an API to start importing and syncing your
                    data.
                </p>
            </div>

            <div class="mt-6">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="mr-1.5 size-3.5" />
                    Add data source
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record PlaceholderTable(string Name, int Columns);

    private static readonly PlaceholderTable[] _placeholderTables =
    [
        new("table_1", 4),
        new("table_2", 3),
        new("table_3", 5),
    ];
}
