@* ============================================================
   Block: empty-state-no-documents
   Title: EmptyStateNoDocuments
   Description: An empty document library state with document type selector cards, a dashed upload area, and create CTA button using React, shadcn/ui, and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-documents.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Documents</span>
            </div>
            <span class="text-xs text-muted-foreground">0 items</span>
        </div>

        @* Document type selector cards *@
        <div class="border-b px-4 py-4">
            <p class="mb-3 text-xs text-muted-foreground">Start with a new document</p>
            <div class="grid grid-cols-3 gap-2">
                @foreach (var docType in _docTypes)
                {
                    <button type="button" class="flex flex-col items-center gap-2 rounded-md border border-dashed border-muted-foreground/20 px-3 py-4 transition-colors hover:border-muted-foreground/40 hover:bg-muted/30">
                        <LucideIconCn Name="@docType.IconName" Size="20" Class="size-5 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">@docType.Label</span>
                    </button>
                }
            </div>
        </div>

        @* Dashed upload zone *@
        <div class="mx-4 my-4 flex flex-col items-center rounded-md border border-dashed border-muted-foreground/20 px-4 py-6 text-center">
            <LucideIconCn Name="upload" Size="20" Class="size-5 text-muted-foreground/40" />
            <p class="mt-2 text-xs text-muted-foreground">
                Or drag and drop files here to upload
            </p>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-3 h-7 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="12" Class="size-3" />
                Browse files
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-center gap-3 text-xs text-muted-foreground/60">
                <span>.docx</span>
                <span class="size-0.5 rounded-full bg-muted-foreground/30"></span>
                <span>.xlsx</span>
                <span class="size-0.5 rounded-full bg-muted-foreground/30"></span>
                <span>.pptx</span>
                <span class="size-0.5 rounded-full bg-muted-foreground/30"></span>
                <span>.pdf</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record DocType(string Label, string IconName);

    private static readonly DocType[] _docTypes =
    [
        new("Document", "file-text"),
        new("Spreadsheet", "file-spreadsheet"),
        new("Presentation", "presentation"),
    ];
}
