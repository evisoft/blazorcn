@code {
    private const string EmptyStateConnectToolsCode = @"<section class=""mx-auto w-full max-w-2xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        @* Header *@
        <div class=""border-b px-4 py-3"">
            <div class=""flex items-center gap-2"">
                <LucideIconCn Name=""plug"" Size=""16"" Class=""size-4 text-muted-foreground"" />
                <span class=""text-sm font-medium"">Integrations</span>
                <span class=""text-xs text-muted-foreground"">0 connected</span>
            </div>
