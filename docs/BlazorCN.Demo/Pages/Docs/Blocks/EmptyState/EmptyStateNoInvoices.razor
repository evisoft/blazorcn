@* ============================================================
   Block: empty-state-no-invoices
   Title: EmptyStateNoInvoices
   Description: A minimal empty state for billing dashboards with no invoices, built with React, Next.js, shadcn/ui, and Tailwind CSS featuring a table skeleton layout with column headers and a create invoice CTA
   Source: original/blocks/empty-state/empty-state-no-invoices.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Invoices</span>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 text-xs">
                <LucideIconCn Name="plus" Size="12" Class="size-3" />
                Create invoice
            </ButtonCn>
        </div>

        @* Table header *@
        <div class="grid grid-cols-4 border-b px-4 py-2">
            @foreach (var col in _columns)
            {
                <span class="text-xs font-medium text-muted-foreground">@col</span>
            }
        </div>

        @* Skeleton rows *@
        <div aria-hidden="true">
            @foreach (var row in _skeletonWidths)
            {
                var rowIndex = Array.IndexOf(_skeletonWidths, row);
                <div class="@Cn.Merge("grid grid-cols-4 items-center px-4 py-3", rowIndex < _skeletonWidths.Length - 1 ? "border-b" : "")">
                    @foreach (var w in row)
                    {
                        <div class="@Cn.Merge("h-3 animate-pulse rounded bg-muted/40", w)"></div>
                    }
                </div>
            }
        </div>

        @* Empty message overlay *@
        <div class="flex flex-col items-center border-t px-4 py-10 text-center">
            <h3 class="text-sm font-medium">No invoices yet</h3>
            <p class="mt-1.5 max-w-xs text-xs text-muted-foreground">
                Invoices will appear here after you set up billing. Create your first invoice to get
                started with payment tracking.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Create invoice
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _columns = ["Invoice", "Amount", "Status", "Date"];

    private static readonly string[][] _skeletonWidths =
    [
        ["w-28", "w-16", "w-14", "w-20"],
        ["w-32", "w-12", "w-14", "w-20"],
        ["w-24", "w-14", "w-14", "w-20"],
        ["w-30", "w-16", "w-14", "w-20"],
    ];
}
