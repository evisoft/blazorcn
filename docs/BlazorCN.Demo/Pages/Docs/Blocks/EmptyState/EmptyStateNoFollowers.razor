@* ============================================================
   Block: empty-state-no-followers
   Title: EmptyStateNoFollowers
   Description: An empty followers state with avatar circle placeholders, audience-building message, and share profile CTA using shadcn/ui and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-followers.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Followers</span>
                <span class="text-muted-foreground text-xs">0</span>
            </div>
        </div>

        @* Empty content *@
        <div class="flex flex-col items-center justify-center px-6 py-14 text-center">
            @* Avatar circle placeholders *@
            <div class="flex items-center -space-x-3">
                @foreach (var avatar in _placeholderAvatars)
                {
                    <div class="@Cn.Merge(avatar.Size, "rounded-full border-2 border-card bg-muted opacity-30")"></div>
                }
            </div>

            <div class="mt-5">
                <h3 class="font-medium text-sm">No followers yet</h3>
                <p class="mx-auto mt-1.5 max-w-xs text-muted-foreground text-sm">
                    Build your audience by sharing your profile. Followers will see your updates and
                    activity in their feed.
                </p>
            </div>

            <div class="mt-6">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                    <LucideIconCn Name="share" Size="14" Class="size-3.5" />
                    Share profile
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record AvatarPlaceholder(string Id, string Size);

    private static readonly AvatarPlaceholder[] _placeholderAvatars =
    [
        new("a1", "size-8"),
        new("a2", "size-9"),
        new("a3", "size-10"),
        new("a4", "size-9"),
        new("a5", "size-8"),
    ];
}
