@* ============================================================
   Block: empty-state-no-generated-content
   Title: EmptyStateNoGeneratedContent
   Description: An empty AI-generated content state with a document canvas placeholder, wand icon, and a CTA to generate content using shadcn/ui and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-generated-content.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="wand-sparkles" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Generated Content</span>
            </div>
            <span class="text-xs text-muted-foreground">0 outputs</span>
        </div>

        @* Document canvas placeholder *@
        <div class="relative border-b px-4 py-6">
            <div class="space-y-3">
                @* Title skeleton *@
                <div class="mb-4 h-3 w-2/5 rounded-full bg-muted/60"></div>

                @* Body lines *@
                @foreach (var line in _placeholderLines)
                {
                    <div class="@Cn.Merge("h-2 rounded-full", line.Width, line.Opacity)"></div>
                }
            </div>

            @* Centered overlay icon *@
            <div class="absolute inset-0 flex items-center justify-center">
                <div class="flex size-14 items-center justify-center rounded-full border border-dashed border-muted-foreground/20 bg-card/80 backdrop-blur-sm">
                    <LucideIconCn Name="wand-sparkles" Size="24" Class="size-6 text-muted-foreground/60" />
                </div>
            </div>
        </div>

        @* Message and CTA *@
        <div class="flex flex-col items-center px-4 py-6 text-center">
            <h3 class="text-sm font-medium">No generated content yet</h3>
            <p class="mt-1.5 max-w-xs text-xs text-muted-foreground">
                Use AI to generate articles, emails, marketing copy, and more. Your outputs will be
                saved here for easy access.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-4 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="wand-sparkles" Size="14" Class="size-3.5" />
                Generate content
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record PlaceholderLine(string Width, string Opacity);

    private static readonly PlaceholderLine[] _placeholderLines =
    [
        new("w-3/4", "bg-muted/50"),
        new("w-full", "bg-muted/40"),
        new("w-5/6", "bg-muted/35"),
        new("w-full", "bg-muted/30"),
        new("w-2/3", "bg-muted/25"),
        new("w-4/5", "bg-muted/20"),
        new("w-full", "bg-muted/15"),
        new("w-1/2", "bg-muted/10"),
    ];
}
