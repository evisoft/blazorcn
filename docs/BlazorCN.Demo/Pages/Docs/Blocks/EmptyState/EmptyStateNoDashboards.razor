@* ============================================================
   Block: empty-state-no-dashboards
   Title: EmptyStateNoDashboards
   Description: React empty state block for custom dashboards with no dashboards created, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations
   Source: original/blocks/empty-state/empty-state-no-dashboards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="layout-grid" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Dashboards</span>
            <span class="ml-auto font-mono text-muted-foreground text-xs">0 dashboards</span>
        </div>

        @* Empty state content *@
        <div class="flex flex-col items-center px-4 py-12">
            @* Grid placeholder *@
            <div class="mb-6 grid grid-cols-3 gap-2">
                @foreach (var idx in _cellIndexes)
                {
                    var i = idx;
                    <div class="flex size-14 items-center justify-center rounded-md border border-dashed border-muted-foreground/20 bg-muted/30">
                        @if (i == 0)
                        {
                            <div class="h-5 w-8 rounded-sm bg-muted-foreground/10"></div>
                        }
                        @if (i == 1)
                        {
                            <div class="flex gap-0.5">
                                <div class="h-5 w-1.5 rounded-sm bg-muted-foreground/10"></div>
                                <div class="h-3 w-1.5 self-end rounded-sm bg-muted-foreground/10"></div>
                                <div class="h-7 w-1.5 rounded-sm bg-muted-foreground/10"></div>
                            </div>
                        }
                        @if (i == 3)
                        {
                            <div class="size-6 rounded-full border-2 border-muted-foreground/10"></div>
                        }
                        @if (i == 4)
                        {
                            <div class="flex flex-col gap-1">
                                <div class="h-1 w-7 rounded bg-muted-foreground/10"></div>
                                <div class="h-1 w-5 rounded bg-muted-foreground/10"></div>
                                <div class="h-1 w-6 rounded bg-muted-foreground/10"></div>
                            </div>
                        }
                    </div>
                }
            </div>

            @* Text *@
            <h3 class="font-medium text-sm">No dashboards yet</h3>
            <p class="mt-1.5 max-w-xs text-center text-muted-foreground text-xs leading-relaxed">
                Create a custom dashboard to organize your metrics, charts, and key data points in one
                place.
            </p>

            @* CTA *@
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Create dashboard
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private static readonly int[] _cellIndexes = [0, 1, 2, 3, 4, 5];
}
