@* ============================================================
   Block: empty-state-no-deployments
   Title: EmptyStateNoDeployments
   Description: React empty state block for deployment history with no deploys yet, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations with a rocket icon and timeline skeleton
   Source: original/blocks/empty-state/empty-state-no-deployments.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="rocket" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Deployments</span>
        </div>

        @* Empty state content *@
        <div class="flex flex-col items-center px-4 py-10">
            @* Rocket icon *@
            <div class="flex size-12 items-center justify-center rounded-full bg-muted/50">
                <LucideIconCn Name="rocket" Size="24" Class="size-6 text-muted-foreground" />
            </div>

            @* Timeline skeleton *@
            <div class="mt-5 w-full max-w-xs space-y-0">
                @foreach (var entry in _timeline)
                {
                    var isLast = entry.Index == _timeline.Length - 1;
                    <div class="flex items-center gap-3">
                        <div class="flex flex-col items-center">
                            <div class="size-2 rounded-full bg-muted-foreground/15"></div>
                            @if (!isLast)
                            {
                                <div class="h-6 w-px bg-muted-foreground/10"></div>
                            }
                        </div>
                        <div class="@Cn.Merge("h-2.5 origin-left rounded bg-muted/60", entry.Width)"></div>
                    </div>
                }
            </div>

            @* Text *@
            <h3 class="mt-6 font-medium text-sm">No deployments yet</h3>
            <p class="mt-1.5 max-w-xs text-center text-muted-foreground text-xs leading-relaxed">
                Ship your code to production with a single click. Each deployment is immutable and can
                be instantly rolled back.
            </p>

            @* CTA *@
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Deploy now
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TimelineEntry(int Index, string Width);

    private static readonly TimelineEntry[] _timeline =
    [
        new(0, "w-48"),
        new(1, "w-36"),
        new(2, "w-40"),
        new(3, "w-28"),
    ];
}
