@* ============================================================
   Block: empty-state-no-bookmarks
   Title: EmptyStateNoBookmarks
   Description: React empty state block for bookmark sections with no saved items, built with Next.js, shadcn/ui, Tailwind CSS, and subtle motion animations
   Source: original/blocks/empty-state/empty-state-no-bookmarks.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="bookmark" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Bookmarks</span>
            <span class="ml-auto text-muted-foreground text-xs">0 items</span>
        </div>

        @* Skeleton grid + empty message *@
        <div class="px-4 py-6">
            @* Skeleton bookmark cards *@
            <div class="grid grid-cols-2 gap-2">
                @foreach (var card in _skeletonCards)
                {
                    <div class="@Cn.Merge(card.Width, card.Height, "relative rounded-md bg-muted/30")">
                        <LucideIconCn Name="bookmark" Size="14" Class="absolute right-2 top-2 size-3.5 text-muted-foreground/30" />
                        <div class="p-3">
                            <div class="h-2 w-3/4 rounded bg-muted/50"></div>
                            <div class="mt-2 h-2 w-1/2 rounded bg-muted/40"></div>
                        </div>
                    </div>
                }
            </div>

            @* Message *@
            <div class="mt-6 flex flex-col items-center text-center">
                <h3 class="font-medium text-sm">No bookmarks yet</h3>
                <p class="mt-1.5 max-w-xs text-muted-foreground text-xs leading-relaxed">
                    Save articles, pages, and resources for quick access later. Bookmark any item to see
                    it here.
                </p>

                <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                    <LucideIconCn Name="compass" Size="14" Class="size-3.5" />
                    Browse content
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record SkeletonCard(string Id, string Width, string Height);

    private static readonly SkeletonCard[] _skeletonCards =
    [
        new("s1", "w-full", "h-20"),
        new("s2", "w-full", "h-20"),
        new("s3", "w-full", "h-20"),
        new("s4", "w-full", "h-20"),
    ];
}
