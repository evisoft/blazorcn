@* ============================================================
   Block: empty-state-no-channels
   Title: EmptyStateNoChannels
   Description: An empty channels state with a hash icon, dashed placeholder rows, and a browse channels CTA using shadcn/ui and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-channels.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="hash" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Channels</span>
                <span class="text-xs text-muted-foreground">0 joined</span>
            </div>
        </div>

        @* Skeleton rows *@
        <div class="px-4 py-6">
            <div class="rounded-md border border-dashed p-4">
                @foreach (var row in _skeletonRows)
                {
                    <div class="flex items-center gap-3 py-2.5">
                        <span class="size-1.5 shrink-0 rounded-full bg-muted-foreground/20"></span>
                        <div class="@Cn.Merge("h-2.5 rounded-sm bg-muted/80", row.Width)"></div>
                        <div class="ml-auto h-2 w-10 rounded-sm bg-muted/50"></div>
                    </div>
                }
            </div>
        </div>

        @* CTA footer *@
        <div class="flex flex-col items-center border-t px-4 py-8 text-center">
            <h3 class="text-sm font-medium">No channels joined</h3>
            <p class="mt-1.5 max-w-xs text-xs text-muted-foreground">
                Join a channel to start collaborating with your team. Browse available channels or
                create a new one.
            </p>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-4 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="search" Size="14" Class="size-3.5" />
                Browse channels
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record SkeletonRow(string Width);

    private static readonly SkeletonRow[] _skeletonRows =
    [
        new("w-32"),
        new("w-24"),
        new("w-28"),
    ];
}
