@* ============================================================
   Block: empty-state-no-subscriptions
   Title: EmptyStateNoSubscriptions
   Description: A minimal empty state for subscription management with no active plans, built with React, Next.js, shadcn/ui, and Tailwind CSS featuring a centered card layout with a recurring billing icon and create subscription CTA
   Source: original/blocks/empty-state/empty-state-no-subscriptions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="refresh-cw" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">Subscriptions</span>
        </div>

        @* Stats row *@
        <div class="grid grid-cols-3 border-b">
            @foreach (var stat in _stats)
            {
                var statItem = stat;
                var idx = Array.IndexOf(_stats, statItem);
                <div class="@Cn.Merge("px-4 py-3", idx < _stats.Length - 1 ? "border-r" : "")">
                    <span class="text-xs text-muted-foreground">@statItem.Label</span>
                    <p class="mt-1 text-lg font-semibold tabular-nums text-muted-foreground/40">@statItem.Value</p>
                </div>
            }
        </div>

        @* Centered empty content *@
        <div class="flex flex-col items-center px-4 py-14 text-center">
            <div class="flex size-12 items-center justify-center rounded-full bg-muted/50">
                <LucideIconCn Name="refresh-cw" Size="24" Class="size-6 text-muted-foreground" />
            </div>
            <h3 class="mt-4 text-sm font-medium">No active subscriptions</h3>
            <p class="mt-1.5 max-w-xs text-xs text-muted-foreground">
                Manage recurring billing and track subscription revenue here. Create your first
                subscription to start collecting recurring payments.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Create subscription
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                Subscriptions automatically generate invoices on each billing cycle.
            </p>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Label, string Value);

    private static readonly StatItem[] _stats =
    [
        new("Monthly recurring", "$0.00"),
        new("Active subscribers", "0"),
        new("Avg. plan value", "--"),
    ];
}
