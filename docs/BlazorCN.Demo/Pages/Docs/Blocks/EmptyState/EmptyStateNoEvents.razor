@* ============================================================
   Block: empty-state-no-events
   Title: EmptyStateNoEvents
   Description: A calendar empty state with skeleton day cells and scheduling CTA, built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-events.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Calendar</span>
            </div>
            <span class="text-xs text-muted-foreground">April 2026</span>
        </div>

        @* Calendar grid skeleton *@
        <div class="relative border-b px-4 py-4">
            @* Day labels *@
            <div class="mb-2 grid grid-cols-7 gap-1.5">
                @foreach (var label in _dayLabels)
                {
                    <div class="text-center text-xs text-muted-foreground/60">@label</div>
                }
            </div>

            @* Day cells *@
            @foreach (var row in _calendarRows)
            {
                <div class="mb-1.5 grid grid-cols-7 gap-1.5">
                    @foreach (var active in row)
                    {
                        <div class="@Cn.Merge("aspect-square rounded-md", active ? "bg-muted/50" : "")"></div>
                    }
                </div>
            }

            @* Overlay message *@
            <div class="absolute inset-0 flex flex-col items-center justify-center bg-card/80 backdrop-blur-[1px]">
                <div class="flex size-10 items-center justify-center rounded-full bg-muted/50">
                    <LucideIconCn Name="calendar" Size="20" Class="size-5 text-muted-foreground" />
                </div>
                <h2 class="mt-3 text-sm font-medium">No events scheduled</h2>
                <p class="mt-1 max-w-xs text-center text-xs text-muted-foreground">
                    Your calendar is empty. Create your first event to start organizing your schedule.
                </p>
                <ButtonCn Size="ButtonSize.Sm" Class="mt-4 gap-1.5">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    Create event
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                Events can include reminders, recurring schedules, and invitees.
            </p>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _dayLabels = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

    private static readonly bool[][] _calendarRows =
    [
        [false, false, false, true, true, true, true],
        [true, true, true, true, true, true, true],
        [true, true, true, true, true, true, true],
        [true, true, true, true, true, false, false],
    ];
}
