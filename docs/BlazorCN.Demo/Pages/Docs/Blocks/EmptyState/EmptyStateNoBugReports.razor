@* ============================================================
   Block: empty-state-no-bug-reports
   Title: EmptyStateNoBugReports
   Description: React empty state block for bug tracking dashboards with a celebratory zero-bugs layout and a submit bug report CTA built with Next.js, shadcn/ui, Tailwind CSS, and motion animations
   Source: original/blocks/empty-state/empty-state-no-bug-reports.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bug" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Bug Reports</span>
            </div>
            <span class="text-muted-foreground text-xs">0 open</span>
        </div>

        @* Celebratory centered content (motion omitted — static port) *@
        <div class="flex flex-col items-center px-4 py-14">
            @* Check badge *@
            <div class="flex size-12 items-center justify-center rounded-full bg-emerald-500/10">
                <LucideIconCn Name="check" Size="24" Class="size-6 text-emerald-600 dark:text-emerald-400" />
            </div>

            @* Text *@
            <h3 class="mt-4 font-medium text-sm">No bugs reported</h3>
            <p class="mt-1.5 max-w-xs text-center text-muted-foreground text-xs leading-relaxed">
                Your project has zero open bug reports. When users or your team submit issues, they will
                be tracked and prioritized here.
            </p>

            @* CTA *@
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Submit bug report
            </ButtonCn>
        </div>

        @* Severity footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-center gap-5">
                @foreach (var severity in _severities)
                {
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", severity.Color)"></span>
                        @severity.Label
                        <span class="tabular-nums text-muted-foreground/60">0</span>
                    </span>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Severity(string Label, string Color);

    private static readonly Severity[] _severities =
    [
        new("Critical", "bg-red-500"),
        new("High",     "bg-amber-500"),
        new("Medium",   "bg-yellow-500"),
        new("Low",      "bg-blue-500"),
    ];
}
