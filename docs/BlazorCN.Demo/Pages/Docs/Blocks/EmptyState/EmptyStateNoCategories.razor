@* ============================================================
   Block: empty-state-no-categories
   Title: EmptyStateNoCategories
   Description: An empty state block for when no categories are set up, featuring a nested tree view skeleton with indented placeholder nodes and a CTA to add the first category
   Source: original/blocks/empty-state/empty-state-no-categories.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="layers" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Categories</span>
            <span class="ml-auto font-mono text-muted-foreground/40 text-xs">0 categories</span>
        </div>

        @* Tree view skeleton *@
        <div class="border-b px-4 py-5">
            <div class="space-y-1">
                @foreach (var node in _treeNodes)
                {
                    var paddingLeft = node.Depth * 20 + 8;
                    <div class="flex items-center gap-2 rounded-md px-2 py-1.5 opacity-40" style="@($"padding-left:{paddingLeft}px")">
                        @if (node.HasChildren)
                        {
                            <LucideIconCn Name="chevron-right" Size="12" Class="size-3 text-muted-foreground/30" />
                        }
                        else
                        {
                            <span class="size-3"></span>
                        }
                        <span class="size-1.5 rounded-full bg-muted-foreground/20"></span>
                        <div class="@($"{node.Width} h-2.5 rounded bg-muted/70")"></div>
                        <span class="ml-auto h-2 w-6 rounded bg-muted/40"></span>
                    </div>
                }
            </div>
        </div>

        @* Message and CTA *@
        <div class="flex flex-col items-center px-4 py-8 text-center">
            <h3 class="font-medium text-sm">No categories set up</h3>
            <p class="mt-1.5 max-w-xs text-muted-foreground text-xs leading-relaxed">
                Group your content into categories for better organization. Build nested hierarchies to
                create a structured taxonomy that scales with your project.
            </p>

            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Add category
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TreeNode(int Depth, string Width, bool HasChildren);

    private static readonly TreeNode[] _treeNodes =
    [
        new(0, "w-28", true),
        new(1, "w-20", true),
        new(2, "w-16", false),
        new(2, "w-24", false),
        new(1, "w-22", false),
        new(0, "w-32", true),
        new(1, "w-18", false),
    ];
}
