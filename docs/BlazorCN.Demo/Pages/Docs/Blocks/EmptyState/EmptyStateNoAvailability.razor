@* ============================================================
   Block: empty-state-no-availability
   Title: EmptyStateNoAvailability
   Description: A time slot grid empty state for availability settings with setup CTA, built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-availability.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="clock" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Availability</span>
            </div>
            <span class="text-xs text-muted-foreground">Not configured</span>
        </div>

        @* Time slot grid skeleton *@
        <div class="relative px-4 py-4">
            @* Day column headers *@
            <div class="mb-2 grid grid-cols-[48px_repeat(5,1fr)] gap-1.5">
                <div></div>
                @foreach (var day in _dayLabels)
                {
                    <div class="text-center text-xs text-muted-foreground/60">@day</div>
                }
            </div>

            @* Time rows *@
            @foreach (var time in _timeLabels)
            {
                <div class="mb-1.5 grid grid-cols-[48px_repeat(5,1fr)] gap-1.5">
                    <span class="flex items-center text-xs text-muted-foreground/40 tabular-nums">@time</span>
                    @foreach (var day in _dayLabels)
                    {
                        <div class="h-6 rounded bg-muted/40"></div>
                    }
                </div>
            }

            @* Overlay message *@
            <div class="absolute inset-0 flex flex-col items-center justify-center bg-card/80 backdrop-blur-[1px]">
                <div class="flex size-10 items-center justify-center rounded-full bg-muted/50">
                    <LucideIconCn Name="clock" Size="20" Class="size-5 text-muted-foreground" />
                </div>
                <h2 class="mt-3 text-sm font-medium">No availability set</h2>
                <p class="mt-1 max-w-xs text-center text-xs text-muted-foreground">
                    Define your available time slots so others can book meetings with you at the right
                    times.
                </p>
                <ButtonCn Size="ButtonSize.Sm" Class="mt-4 gap-1.5">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    Set availability
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                Availability syncs across all your calendars and respects time zone differences.
            </p>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _timeLabels = ["9 AM", "10 AM", "11 AM", "12 PM", "1 PM", "2 PM", "3 PM", "4 PM"];
    private static readonly string[] _dayLabels = ["Mon", "Tue", "Wed", "Thu", "Fri"];
}
