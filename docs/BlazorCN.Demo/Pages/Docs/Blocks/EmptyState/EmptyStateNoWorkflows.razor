@* ============================================================
   Block: empty-state-no-workflows
   Title: EmptyStateNoWorkflows
   Description: An empty AI workflows state with a node-based flowchart skeleton, git-branch icon, and a CTA to create a workflow using shadcn/ui and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-workflows.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="git-branch" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Workflows</span>
            </div>
            <span class="text-xs text-muted-foreground">0 workflows</span>
        </div>

        @* Flowchart skeleton *@
        <div class="flex flex-col items-center border-b px-4 py-8">
            <div class="flex flex-col items-center gap-0">
                @foreach (var node in _nodes)
                {
                    var idx = System.Array.IndexOf(_nodes, node);
                    <div class="flex flex-col items-center">
                        @* Connector line (before each node except first) *@
                        @if (idx > 0)
                        {
                            <div class="h-6 w-px origin-top bg-muted-foreground/20"></div>
                        }

                        @* Node *@
                        <div class="flex w-40 items-center gap-3 rounded-lg border border-dashed border-muted-foreground/20 bg-muted/20 px-3 py-2.5">
                            <div class="flex size-7 shrink-0 items-center justify-center rounded-md bg-muted/60">
                                <span class="text-[10px] font-medium text-muted-foreground">@(idx + 1)</span>
                            </div>
                            <div class="min-w-0">
                                <span class="block text-xs font-medium">@node.Label</span>
                                <span class="block text-[10px] text-muted-foreground">@node.Sublabel</span>
                            </div>
                        </div>
                    </div>
                }

                @* Trailing connector with plus *@
                <div class="flex h-6 w-px origin-top flex-col items-center justify-end bg-muted-foreground/20"></div>
                <div class="flex size-6 items-center justify-center rounded-full border border-dashed border-muted-foreground/25">
                    <LucideIconCn Name="plus" Size="12" Class="size-3 text-muted-foreground/40" />
                </div>
            </div>
        </div>

        @* Message and CTA *@
        <div class="flex flex-col items-center px-4 py-6 text-center">
            <h3 class="text-sm font-medium">No workflows yet</h3>
            <p class="mt-1.5 max-w-xs text-xs text-muted-foreground">
                Build automated AI pipelines by connecting triggers, processors, and outputs. Workflows
                run on schedule or in response to events.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-4 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Create workflow
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record WorkflowNode(string Id, string Label, string Sublabel);

    private static readonly WorkflowNode[] _nodes =
    [
        new("n1", "Trigger", "On new data"),
        new("n2", "Process", "AI model"),
        new("n3", "Output", "Send result"),
    ];
}
