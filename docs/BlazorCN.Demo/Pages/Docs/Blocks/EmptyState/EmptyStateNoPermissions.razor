@* ============================================================
   Block: empty-state-no-permissions
   Title: EmptyStateNoPermissions
   Description: An empty state block for when no permission rules are configured, featuring a matrix grid skeleton with checkbox placeholders and a CTA to set up permissions
   Source: original/blocks/empty-state/empty-state-no-permissions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Permissions</span>
            <span class="ml-auto font-mono text-muted-foreground/40 text-xs">0 rules</span>
        </div>

        @* Matrix skeleton *@
        <div class="border-b px-4 py-5">
            @* Column headers *@
            <div class="mb-3 flex items-center">
                <div class="w-20 shrink-0"></div>
                <div class="grid flex-1 grid-cols-4 gap-2">
                    @foreach (var action in _matrixActions)
                    {
                        <span class="text-center font-mono text-muted-foreground/40 text-[10px]">@action</span>
                    }
                </div>
            </div>

            @* Rows *@
            @foreach (var role in _matrixRoles)
            {
                var isLast = role == _matrixRoles[^1];
                <div class="@Cn.Merge("flex items-center py-2.5", !isLast ? "border-b" : "")">
                    <div class="w-20 shrink-0">
                        <div class="h-2.5 w-12 rounded bg-muted/70"></div>
                    </div>
                    <div class="grid flex-1 grid-cols-4 gap-2">
                        @foreach (var action in _matrixActions)
                        {
                            <div class="flex justify-center">
                                <div class="size-4 rounded border border-dashed bg-muted/20"></div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Message and CTA *@
        <div class="flex flex-col items-center px-4 py-8 text-center">
            <h3 class="font-medium text-sm">No permission rules configured</h3>
            <p class="mt-1.5 max-w-xs text-muted-foreground text-xs leading-relaxed">
                Control who can access what by defining permission rules. Set up a role-based access
                matrix to manage create, read, update, and delete actions across your resources.
            </p>

            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Set up permissions
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _matrixRoles = ["Admin", "Editor", "Viewer"];
    private static readonly string[] _matrixActions = ["Create", "Read", "Update", "Delete"];
}
