@* ============================================================
   Block: empty-state-no-messages
   Title: EmptyStateNoMessages
   Description: An empty inbox state with ghost conversation previews, unread counter, compose CTA, and keyboard shortcut hint using shadcn/ui and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-messages.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="mail" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Inbox</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px]">
                    0 unread
                </BadgeCn>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-2 text-xs">
                <LucideIconCn Name="pen-line" Size="12" Class="size-3" />
                Compose
            </ButtonCn>
        </div>

        @* Ghost conversation rows *@
        <div class="relative" aria-hidden="true">
            @foreach (var conv in _ghostConversations)
            {
                var isLast = conv == _ghostConversations[_ghostConversations.Length - 1];
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")" style="@($"opacity:{conv.Opacity}")">
                    <div class="@Cn.Merge("size-8 shrink-0 rounded-full", conv.AvatarBg)"></div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <div class="@Cn.Merge("h-2.5 rounded bg-muted", conv.NameWidth)"></div>
                            <div class="@Cn.Merge("h-2 rounded bg-muted/60", conv.TimeWidth)"></div>
                        </div>
                        <div class="@Cn.Merge("mt-1.5 h-2 rounded bg-muted/50", conv.PreviewWidth)"></div>
                    </div>
                </div>
            }

            @* Centered overlay *@
            <div class="absolute inset-0 flex flex-col items-center justify-center bg-card/80 backdrop-blur-[1px]">
                <div class="flex size-11 items-center justify-center rounded-full bg-muted/50">
                    <LucideIconCn Name="inbox" Size="20" Class="size-5 text-muted-foreground" />
                </div>
                <h3 class="mt-3 text-sm font-medium">Your inbox is empty</h3>
                <p class="mt-1 max-w-xs text-center text-xs text-muted-foreground">
                    Messages from your team and contacts will appear here.
                </p>
                <ButtonCn Size="ButtonSize.Sm" Class="mt-4 h-8 gap-1.5 text-xs">
                    <LucideIconCn Name="pen-line" Size="14" Class="size-3.5" />
                    Compose message
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-[10px] text-muted-foreground">
                Press <kbd class="rounded border bg-muted/50 px-1 py-0.5 font-mono text-[10px]">C</kbd> to compose a new message
            </p>
        </div>
    </div>
</section>

@code {
    private record GhostConversation(string AvatarBg, string NameWidth, string PreviewWidth, string TimeWidth, string Opacity);

    private static readonly GhostConversation[] _ghostConversations =
    [
        new("bg-muted",      "w-24", "w-48", "w-10", "0.15"),
        new("bg-muted/80",   "w-20", "w-40", "w-8",  "0.13"),
        new("bg-muted/60",   "w-28", "w-36", "w-10", "0.11"),
        new("bg-muted/40",   "w-16", "w-44", "w-8",  "0.09"),
    ];
}
