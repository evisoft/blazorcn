@* ============================================================
   Block: empty-state-no-transactions
   Title: EmptyStateNoTransactions
   Description: A minimal empty state for transaction history pages with no activity, built with React, Next.js, shadcn/ui, and Tailwind CSS featuring a timeline skeleton layout and a view accounts CTA
   Source: original/blocks/empty-state/empty-state-no-transactions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="arrow-left-right" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">Transactions</span>
        </div>

        @* Timeline skeleton *@
        <div class="relative" aria-hidden="true">
            @foreach (var grp in _timelineGroups)
            {
                <div>
                    @* Date label *@
                    <div class="border-b bg-muted/30 px-4 py-1.5">
                        <span class="text-xs font-medium text-muted-foreground/60">@grp.Label</span>
                    </div>

                    @* Placeholder rows *@
                    @for (int rowIndex = 0; rowIndex < grp.Rows; rowIndex++)
                    {
                        var currentRow = grp.StartRow + rowIndex;
                        var width = _rowWidths[currentRow % _rowWidths.Length];
                        var isLastRowOfLastGroup = grp.IsLast && rowIndex == grp.Rows - 1;
                        <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", !isLastRowOfLastGroup ? "border-b" : "")">
                            <div class="size-2 shrink-0 animate-pulse rounded-full bg-muted/60"></div>
                            <div class="@Cn.Merge("h-3 animate-pulse rounded bg-muted/40", width)"></div>
                            <div class="ml-auto h-3 w-14 animate-pulse rounded bg-muted/40"></div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Empty message *@
        <div class="flex flex-col items-center border-t px-4 py-10 text-center">
            <h3 class="text-sm font-medium">No transactions recorded</h3>
            <p class="mt-1.5 max-w-xs text-xs text-muted-foreground">
                Transactions will be recorded here as payments are processed. Connect an account or
                complete a payment to see activity.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="external-link" Size="14" Class="size-3.5" />
                View accounts
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TimelineGroup(string Label, int Rows, int StartRow, bool IsLast);

    private static readonly string[] _rowWidths = ["w-40", "w-32", "w-36", "w-28", "w-44", "w-24", "w-36"];

    private static readonly TimelineGroup[] _timelineGroups =
    [
        new("Today",      2, 0, false),
        new("Yesterday",  3, 2, false),
        new("This week",  2, 5, true),
    ];
}
