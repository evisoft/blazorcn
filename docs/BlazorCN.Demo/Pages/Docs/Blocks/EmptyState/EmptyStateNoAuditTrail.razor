@* ============================================================
   Block: empty-state-no-audit-trail
   Title: EmptyStateNoAuditTrail
   Description: React empty state block for audit logs with table skeleton column headers and compliance configuration CTA, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations
   Source: original/blocks/empty-state/empty-state-no-audit-trail.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="clipboard-list" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Audit Trail</span>
            </div>
            <span class="text-muted-foreground text-xs">0 events</span>
        </div>

        @* Table skeleton *@
        <div class="relative">
            @* Column headers *@
            <div class="flex items-center gap-4 border-b bg-muted/30 px-4 py-2">
                @foreach (var col in _columns)
                {
                    <span class="@Cn.Merge("font-medium text-muted-foreground text-xs", col.Width)">
                        @col.Label
                    </span>
                }
            </div>

            @* Ghost rows *@
            @foreach (var rowItem in _skeletonRows)
            {
                var row = rowItem;
                var isLast = row == _skeletonRows[_skeletonRows.Length - 1];
                <div class="@Cn.Merge("flex items-center gap-4 px-4 py-3", isLast ? "" : "border-b")">
                    @for (var j = 0; j < row.Widths.Length; j++)
                    {
                        var idx = j;
                        var w = row.Widths[idx];
                        <div class="@Cn.Merge("h-2.5 rounded bg-muted/40", idx == 3 ? "flex-1 max-w-36" : w)" />
                    }
                </div>
            }

            @* Center overlay *@
            <div class="absolute inset-0 flex flex-col items-center justify-center bg-card/80 backdrop-blur-[1px]">
                <div class="flex size-10 items-center justify-center rounded-full bg-muted/50">
                    <LucideIconCn Name="clipboard-list" Size="20" Class="size-5 text-muted-foreground" />
                </div>
                <h3 class="mt-3 font-medium text-sm">No audit events logged</h3>
                <p class="mt-1 max-w-xs text-center text-muted-foreground text-xs">
                    Compliance events, access changes, and admin actions will be recorded here
                    automatically.
                </p>
                <ButtonCn Size="ButtonSize.Sm" Class="mt-4 h-8 gap-1.5 text-xs">
                    <LucideIconCn Name="settings" Size="14" Class="size-3.5" />
                    Configure audit settings
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <p class="text-center text-muted-foreground text-xs">
                Audit events are immutable, tamper-proof, and retained for 7 years.
            </p>
        </div>
    </div>
</section>

@code {
    private record Column(string Label, string Width);
    private record SkeletonRow(string[] Widths);

    private static readonly Column[] _columns =
    [
        new("Timestamp", "w-28"),
        new("Actor", "w-24"),
        new("Action", "w-20"),
        new("Resource", "flex-1"),
    ];

    private static readonly SkeletonRow[] _skeletonRows =
    [
        new(["w-20", "w-16", "w-14", "w-32"]),
        new(["w-24", "w-20", "w-12", "w-28"]),
        new(["w-20", "w-14", "w-16", "w-36"]),
        new(["w-22", "w-18", "w-14", "w-24"]),
    ];
}
