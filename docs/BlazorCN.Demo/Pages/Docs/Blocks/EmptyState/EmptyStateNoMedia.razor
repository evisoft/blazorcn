@* ============================================================
   Block: empty-state-no-media
   Title: EmptyStateNoMedia
   Description: React empty state block for an empty media library with placeholder image grid, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations
   Source: original/blocks/empty-state/empty-state-no-media.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Media Library</span>
            <span class="ml-auto text-muted-foreground text-xs">0 items</span>
        </div>

        @* Placeholder grid *@
        <div class="border-b p-4">
            <div class="grid grid-cols-3 gap-2">
                @foreach (var slot in _placeholderSlots)
                {
                    <div class="aspect-square flex items-center justify-center rounded-md bg-muted/30">
                        <LucideIconCn Name="image" Size="20" Class="size-5 text-muted-foreground/30" />
                    </div>
                }
            </div>
        </div>

        @* Empty state message *@
        <div class="flex flex-col items-center px-4 py-10 text-center">
            <h3 class="font-medium text-sm">No media uploaded</h3>
            <p class="mt-1.5 max-w-xs text-muted-foreground text-xs leading-relaxed">
                Upload images and videos to your media library. Organize, tag, and reuse them across
                your content.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="upload" Size="14" Class="size-3.5" />
                Upload media
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record PlaceholderSlot(string Id, string Aspect);

    private static readonly PlaceholderSlot[] _placeholderSlots =
    [
        new("s1", "aspect-square"),
        new("s2", "aspect-square"),
        new("s3", "aspect-square"),
        new("s4", "aspect-square"),
        new("s5", "aspect-square"),
        new("s6", "aspect-square"),
    ];
}
