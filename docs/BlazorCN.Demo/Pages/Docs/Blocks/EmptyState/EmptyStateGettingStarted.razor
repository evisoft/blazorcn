@* ============================================================
   Block: empty-state-getting-started
   Title: EmptyStateGettingStarted
   Description: An onboarding checklist empty state with progress indicator, four setup steps with checkboxes, and completion tracking built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-getting-started.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="list-checks" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Getting started</span>
                <span class="text-xs text-muted-foreground">
                    @_checked.Count of @_steps.Length complete
                </span>
            </div>
        </div>

        @* Progress bar *@
        <div class="border-b px-4 py-3">
            <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted/50">
                <div class="h-full rounded-full bg-foreground transition-all duration-[400ms] ease-out"
                     style="@($"width:{_progress}%")">
                </div>
            </div>
        </div>

        @* Checklist *@
        <div>
            @for (var i = 0; i < _steps.Length; i++)
            {
                var step = _steps[i];
                var idx = i;
                var isChecked = _checked.Contains(step.Id);
                var isLast = idx == _steps.Length - 1;
                var rowClass = Cn.Merge("flex cursor-pointer items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b");
                var labelClass = Cn.Merge("text-sm font-medium", isChecked ? "text-muted-foreground line-through" : "");
                <span class="@rowClass" @onclick="@(() => Toggle(step.Id))">
                    <CheckboxCn Checked="@isChecked" Class="mt-0.5" aria-label="@step.Label" />
                    <div class="min-w-0 flex-1">
                        <span class="@labelClass">@step.Label</span>
                        <p class="mt-0.5 text-xs text-muted-foreground">@step.Description</p>
                    </div>
                    @if (!isChecked && idx == _checked.Count)
                    {
                        <span class="shrink-0 rounded-full bg-foreground/10 px-2 py-0.5 text-[10px] font-medium text-foreground">
                            Next
                        </span>
                    }
                </span>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                Complete all steps to unlock the full workspace experience
            </p>
        </div>
    </div>
</section>

@code {
    private record Step(string Id, string Label, string Description);

    private static readonly Step[] _steps =
    [
        new("profile", "Complete your profile", "Add your name, avatar, and role"),
        new("project", "Create your first project", "Set up a project to organize your work"),
        new("invite", "Invite team members", "Bring in collaborators to share progress"),
        new("integrate", "Connect an integration", "Link tools you already use like Slack or GitHub"),
    ];

    private List<string> _checked = ["profile"];

    private double _progress => (_checked.Count / (double)_steps.Length) * 100;

    private void Toggle(string id)
    {
        if (_checked.Contains(id))
            _checked = _checked.Where(s => s != id).ToList();
        else
            _checked = [.._checked, id];
    }
}
