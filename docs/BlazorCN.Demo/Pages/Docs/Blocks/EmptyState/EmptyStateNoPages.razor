@* ============================================================
   Block: empty-state-no-pages
   Title: EmptyStateNoPages
   Description: An empty wiki pages state with a dashed border upload area, message about building a knowledge base, and a CTA to create the first page using shadcn/ui and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-pages.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="book-open" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Pages</span>
        </div>

        @* Dashed drop zone *@
        <div class="px-4 py-6">
            <div class="flex flex-col items-center rounded-lg border-2 border-dashed border-muted-foreground/20 px-4 py-10 text-center">
                <LucideIconCn Name="book-open" Size="32" Class="mx-auto mb-4 size-8 text-muted-foreground/40" />

                <h3 class="font-medium text-sm">Build your knowledge base</h3>
                <p class="mt-1.5 max-w-sm text-muted-foreground text-sm leading-relaxed">
                    Create your first page to start organizing information. Import existing docs or
                    start from scratch.
                </p>

                <div class="mt-5 flex items-center justify-center gap-2">
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                        <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                        Create page
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 gap-1.5 text-xs">
                        <LucideIconCn Name="upload" Size="14" Class="size-3.5" />
                        Import
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Hints footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <span class="flex items-center gap-1.5">
                    <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                    Supports Markdown
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                    Nested pages
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                    Full-text search
                </span>
            </div>
        </div>
    </div>
</section>
