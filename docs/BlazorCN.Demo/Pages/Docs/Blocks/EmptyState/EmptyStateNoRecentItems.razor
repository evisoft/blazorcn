@* ============================================================
   Block: empty-state-no-recent-items
   Title: EmptyStateNoRecentItems
   Description: React empty state block for recent activity sections with no items yet, built with Next.js, shadcn/ui, Tailwind CSS, and subtle motion animations
   Source: original/blocks/empty-state/empty-state-no-recent-items.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="clock" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Recent items</span>
            <span class="ml-auto text-muted-foreground text-xs">Today</span>
        </div>

        @* Timeline skeleton *@
        <div class="relative border-b px-4 py-4">
            @* Vertical line *@
            <div class="absolute bottom-4 left-[29px] top-4 w-px bg-muted/60" />

            <div class="flex flex-col gap-4">
                @foreach (var entry in _timelineEntries)
                {
                    <div class="flex items-center gap-3">
                        <div class="@Cn.Merge("relative z-10 size-2 shrink-0 rounded-full bg-foreground", entry.DotOpacity)" />
                        <div class="flex flex-1 items-center gap-2">
                            <div class="@Cn.Merge("h-2 rounded bg-muted/40", entry.BarWidth)" />
                            <div class="ml-auto h-2 w-12 rounded bg-muted/25" />
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Empty message *@
        <div class="flex flex-col items-center px-4 py-8 text-center">
            <h3 class="font-medium text-sm">No recent activity</h3>
            <p class="mt-1.5 max-w-xs text-muted-foreground text-xs leading-relaxed">
                Items you view, edit, or interact with will appear here for quick access. Start
                exploring to build your history.
            </p>

            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="compass" Size="14" Class="size-3.5" />
                Start exploring
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TimelineEntry(string BarWidth, string DotOpacity);

    private static readonly TimelineEntry[] _timelineEntries =
    [
        new("w-48", "opacity-20"),
        new("w-36", "opacity-15"),
        new("w-52", "opacity-10"),
        new("w-40", "opacity-[0.07]"),
        new("w-44", "opacity-[0.05]"),
    ];
}
