@* ============================================================
   Block: empty-state-no-reminders
   Title: EmptyStateNoReminders
   Description: React empty state block for reminder lists with clock-centered time slot placeholders, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations
   Source: original/blocks/empty-state/empty-state-no-reminders.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="alarm-clock" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Reminders</span>
            </div>
            <span class="text-muted-foreground text-xs">Today</span>
        </div>

        @* Time slot placeholders with overlay *@
        <div class="relative">
            @foreach (var slot in _timeSlots)
            {
                var isLast = slot == _timeSlots[^1];
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", !isLast ? "border-b" : "")">
                    <span class="w-16 shrink-0 font-mono text-muted-foreground/40 text-xs">@slot.Time</span>
                    <div class="flex items-center gap-2">
                        <div class="size-1.5 rounded-full bg-muted/40"></div>
                        <div class="@Cn.Merge("h-2.5 rounded bg-muted/40", slot.Width)"></div>
                    </div>
                </div>
            }

            @* Center overlay *@
            <div class="absolute inset-0 flex flex-col items-center justify-center bg-card/80 backdrop-blur-[1px]">
                <div class="flex size-10 items-center justify-center rounded-full bg-muted/50">
                    <LucideIconCn Name="alarm-clock" Size="20" Class="size-5 text-muted-foreground" />
                </div>
                <h3 class="mt-3 font-medium text-sm">No reminders set</h3>
                <p class="mt-1 max-w-xs text-center text-muted-foreground text-xs">
                    Schedule reminders to stay on top of deadlines, meetings, and follow-ups.
                </p>
                <ButtonCn Size="ButtonSize.Sm" Class="mt-4 h-8 gap-1.5 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    Create reminder
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <p class="text-center text-muted-foreground text-xs">
                Reminders send push and email notifications at scheduled times.
            </p>
        </div>
    </div>
</section>

@code {
    private record TimeSlot(string Time, string Width);

    private static readonly TimeSlot[] _timeSlots =
    [
        new("9:00 AM",  "w-32"),
        new("10:00 AM", "w-24"),
        new("11:00 AM", "w-40"),
        new("12:00 PM", "w-28"),
        new("1:00 PM",  "w-36"),
    ];
}
