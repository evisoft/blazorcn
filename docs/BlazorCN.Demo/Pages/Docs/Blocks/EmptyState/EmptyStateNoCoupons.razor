@* ============================================================
   Block: empty-state-no-coupons
   Title: EmptyStateNoCoupons
   Description: React empty state block for discount codes with no coupons created, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations featuring a ticket-shaped dashed border element and create coupon CTA
   Source: original/blocks/empty-state/empty-state-no-coupons.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="ticket" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">Coupons</span>
        </div>

        @* Empty state content *@
        <div class="flex flex-col items-center px-4 py-12">
            @* Ticket-shaped element *@
            <div class="relative mb-6 flex w-full max-w-[240px] items-center rounded-lg border-2 border-dashed">
                @* Left section *@
                <div class="flex flex-1 flex-col items-center py-5">
                    <LucideIconCn Name="percent" Size="32" Class="size-8 text-muted-foreground/30" />
                    <div class="mt-2 h-2 w-20 rounded bg-muted/40"></div>
                    <div class="mt-1.5 h-2 w-14 rounded bg-muted/30"></div>
                </div>

                @* Divider with cutouts *@
                <div class="flex flex-col items-center gap-1 self-stretch py-2">
                    <div class="size-3 -mt-[7px] shrink-0 rounded-full border-2 border-dashed bg-card"></div>
                    <div class="w-px flex-1 border-l border-dashed"></div>
                    <div class="size-3 -mb-[7px] shrink-0 rounded-full border-2 border-dashed bg-card"></div>
                </div>

                @* Right section *@
                <div class="flex flex-col items-center px-4 py-5">
                    <span class="font-mono text-lg font-semibold text-muted-foreground/20">0%</span>
                    <span class="mt-0.5 text-xs text-muted-foreground/40">OFF</span>
                </div>
            </div>

            @* Text *@
            <h3 class="text-sm font-medium">No discount codes</h3>
            <p class="mt-1.5 max-w-xs text-center text-xs text-muted-foreground leading-relaxed">
                Create coupon codes to offer discounts, run promotions, and reward loyal customers with
                percentage or fixed-amount savings.
            </p>

            @* CTA *@
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Create coupon
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                Coupons can be limited by usage count, expiration date, or minimum order value.
            </p>
        </div>
    </div>
</section>
