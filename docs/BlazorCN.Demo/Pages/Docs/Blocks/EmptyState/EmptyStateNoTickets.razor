@* ============================================================
   Block: empty-state-no-tickets
   Title: EmptyStateNoTickets
   Description: React empty state block for support ticket queues with skeleton list rows, status indicators, and a create ticket CTA built with Next.js, shadcn/ui, Tailwind CSS, and motion animations
   Source: original/blocks/empty-state/empty-state-no-tickets.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="inbox" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Support Queue</span>
            </div>
            <div class="flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400">
                <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5" />
                <span class="text-xs font-medium">All clear</span>
            </div>
        </div>

        @* Skeleton ticket rows *@
        <div class="border-b">
            @foreach (var row in _skeletonRows)
            {
                var isLast = row == _skeletonRows[^1];
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", !isLast ? "border-b" : "")">
                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", row.Priority)"></span>
                    <div class="flex-1 space-y-1.5">
                        <div class="@Cn.Merge("h-2.5 rounded bg-muted/80", row.Width)"></div>
                        <div class="h-2 w-24 rounded bg-muted/50"></div>
                    </div>
                    <div class="h-5 w-14 rounded-full bg-muted/50"></div>
                </div>
            }
        </div>

        @* Message and CTA *@
        <div class="flex flex-col items-center px-4 py-10 text-center">
            <h3 class="font-medium text-sm">No open tickets</h3>
            <p class="mt-1.5 max-w-xs text-muted-foreground text-xs leading-relaxed">
                Your support queue is clear. All customer requests have been resolved. New tickets will
                appear here as they come in.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Create ticket
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record SkeletonRow(string Width, string Priority);

    private static readonly SkeletonRow[] _skeletonRows =
    [
        new("w-40", "bg-emerald-500"),
        new("w-32", "bg-amber-500"),
        new("w-48", "bg-blue-500"),
    ];
}
