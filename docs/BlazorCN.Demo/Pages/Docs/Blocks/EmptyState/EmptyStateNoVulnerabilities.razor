@* ============================================================
   Block: empty-state-no-vulnerabilities
   Title: EmptyStateNoVulnerabilities
   Description: React empty state block for vulnerability scanners with all-clear scan results, dependency summary, and security scan CTA, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations
   Source: original/blocks/empty-state/empty-state-no-vulnerabilities.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Vulnerability Scan</span>
            </div>
            <span class="rounded-full bg-emerald-500/10 px-2 py-0.5 text-emerald-600 text-xs dark:text-emerald-400">
                All clear
            </span>
        </div>

        @* Score summary *@
        <div class="flex items-center gap-4 border-b px-4 py-4">
            <span class="font-semibold text-2xl tabular-nums text-emerald-600 dark:text-emerald-400">
                0
            </span>
            <div>
                <p class="font-medium text-sm">No vulnerabilities found</p>
                <p class="text-muted-foreground text-xs">500 items scanned across 4 categories</p>
            </div>
        </div>

        @* Scan category rows *@
        <div>
            @foreach (var cat in _scanCategories)
            {
                var isLast = cat == _scanCategories[^1];
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-3", !isLast ? "border-b" : "")">
                    <div class="flex items-center gap-3">
                        <span class="text-sm">@cat.Name</span>
                        <span class="text-muted-foreground text-xs">@cat.Packages scanned</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="text-muted-foreground text-xs">@cat.Status</span>
                    </div>
                </div>
            }
        </div>

        @* Footer CTA *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <p class="text-muted-foreground text-xs">Last scan: 6 hours ago</p>
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideIconCn Name="play" Size="12" Class="size-3" />
                Run scan
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ScanCategory(string Name, int Packages, string Status);

    private static readonly ScanCategory[] _scanCategories =
    [
        new("Dependencies", 142, "Pass"),
        new("Container images", 8, "Pass"),
        new("Source code", 326, "Pass"),
        new("Infrastructure", 24, "Pass"),
    ];
}
