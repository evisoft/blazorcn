@* ============================================================
   Block: empty-state-no-metrics
   Title: EmptyStateNoMetrics
   Description: React empty state block for KPI metrics with placeholder values and configuration CTA, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations
   Source: original/blocks/empty-state/empty-state-no-metrics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="trending-up" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Key Metrics</span>
        </div>

        @* Placeholder metric cards *@
        <div class="border-b px-4 py-4">
            <div class="grid grid-cols-2 gap-3">
                @foreach (var metric in _placeholderMetrics)
                {
                    <div class="rounded-md border border-dashed border-muted-foreground/20 px-3 py-3">
                        <span class="text-muted-foreground/60 text-xs">@metric.Label</span>
                        <div class="mt-1 flex items-baseline gap-1.5">
                            <span class="font-semibold text-xl tabular-nums text-muted-foreground/25">
                                ---
                            </span>
                            <span class="text-muted-foreground/30 text-xs">@metric.Unit</span>
                        </div>
                        <div class="mt-2 flex items-center gap-1">
                            <div class="h-0.5 flex-1 rounded-full bg-muted-foreground/10"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Message and CTA *@
        <div class="flex items-center gap-4 px-4 py-4">
            <div class="min-w-0 flex-1">
                <h3 class="font-medium text-sm">No metrics configured</h3>
                <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">
                    Define your KPIs to track performance across revenue, engagement, and growth.
                </p>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 shrink-0 gap-1.5 text-xs">
                <LucideIconCn Name="settings" Size="14" Class="size-3.5" />
                Configure
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record PlaceholderMetric(string Id, string Label, string Unit);

    private static readonly PlaceholderMetric[] _placeholderMetrics =
    [
        new("m1", "Revenue", "USD"),
        new("m2", "Active users", "count"),
        new("m3", "Conversion rate", "%"),
        new("m4", "Avg. session time", "min"),
    ];
}
