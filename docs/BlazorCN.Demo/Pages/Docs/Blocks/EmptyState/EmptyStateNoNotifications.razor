@* ============================================================
   Block: empty-state-no-notifications
   Title: EmptyStateNoNotifications
   Description: React empty state block for notification centers with a celebratory all-caught-up message, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations
   Source: original/blocks/empty-state/empty-state-no-notifications.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bell-off" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Notifications</span>
            </div>
            <span class="text-muted-foreground text-xs">0 unread</span>
        </div>

        @* Celebration content (motion.div rendered as static div) *@
        <div class="flex flex-col items-center px-4 py-14">
            @* Animated check badge (motion.div rendered as static div) *@
            <div class="flex size-12 items-center justify-center rounded-full bg-emerald-500/10">
                <LucideIconCn Name="check" Size="24" Class="size-6 text-emerald-600 dark:text-emerald-400" />
            </div>

            @* Text *@
            <h3 class="mt-4 font-medium text-sm">You're all caught up</h3>
            <p class="mt-1.5 max-w-xs text-center text-muted-foreground text-xs leading-relaxed">
                No new notifications right now. We'll let you know when something needs your attention.
            </p>

            @* CTA *@
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="settings" Size="14" Class="size-3.5" />
                Manage preferences
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <p class="text-center text-muted-foreground text-xs">
                Notifications include mentions, replies, and system updates.
            </p>
        </div>
    </div>
</section>
