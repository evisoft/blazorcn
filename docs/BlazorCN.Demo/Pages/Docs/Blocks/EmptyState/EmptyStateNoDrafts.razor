@* ============================================================
   Block: empty-state-no-drafts
   Title: EmptyStateNoDrafts
   Description: An empty drafts state with lined-paper skeleton placeholder, message about automatic draft saving, and a CTA to start writing using shadcn/ui and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-drafts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="pen-line" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Drafts</span>
            <span class="text-muted-foreground text-xs">0 items</span>
        </div>

        @* Skeleton lines *@
        <div class="border-b px-4 py-5">
            <div class="space-y-3">
                @foreach (var line in _skeletonLines)
                {
                    <div class="@Cn.Merge("h-2 rounded-full bg-muted/60", line.Width)"></div>
                }
            </div>
        </div>

        @* Message and CTA *@
        <div class="flex flex-col items-center px-4 py-8 text-center">
            <h3 class="font-medium text-sm">No drafts saved</h3>
            <p class="mt-1.5 max-w-xs text-muted-foreground text-sm leading-relaxed">
                Your work is saved automatically as you write. Start a new document and your draft will
                appear here.
            </p>

            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="pen-line" Size="14" Class="size-3.5" />
                Start writing
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record SkeletonLine(string Width);

    private static readonly SkeletonLine[] _skeletonLines =
    [
        new("w-full"),
        new("w-4/5"),
        new("w-full"),
        new("w-3/5"),
        new("w-full"),
    ];
}
