@* ============================================================
   Block: empty-state-no-performance-data
   Title: EmptyStateNoPerformanceData
   Description: React empty state block for performance monitoring with chart skeleton placeholders and metric setup CTA, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations
   Source: original/blocks/empty-state/empty-state-no-performance-data.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="gauge" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Performance</span>
        </div>

        @* Chart skeleton *@
        <div class="border-b px-4 py-5">
            <div class="flex items-end justify-center gap-1.5">
                @foreach (var bar in _chartBars)
                {
                    <div class="@Cn.Merge("w-4 origin-bottom rounded-sm bg-muted-foreground/10", bar)"></div>
                }
            </div>
            <div class="mt-3 flex items-center justify-between">
                <span class="text-muted-foreground/40 text-xs">12:00</span>
                <span class="text-muted-foreground/40 text-xs">18:00</span>
                <span class="text-muted-foreground/40 text-xs">00:00</span>
            </div>
        </div>

        @* Metric placeholders *@
        <div class="grid grid-cols-2 gap-px border-b bg-border sm:grid-cols-4">
            @foreach (var slot in _metricSlots)
            {
                <div class="bg-card px-4 py-3">
                    <span class="text-muted-foreground/60 text-xs">@slot.Label</span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-semibold text-lg tabular-nums text-muted-foreground/25">
                            ---
                        </span>
                        <span class="text-muted-foreground/30 text-xs">@slot.Unit</span>
                    </div>
                </div>
            }
        </div>

        @* Message and CTA *@
        <div class="flex items-center gap-4 px-4 py-4">
            <div class="min-w-0 flex-1">
                <h3 class="font-medium text-sm">No performance data yet</h3>
                <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">
                    Install the monitoring SDK to track response times, latency, and throughput.
                </p>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 shrink-0 gap-1.5 text-xs">
                <LucideIconCn Name="settings" Size="14" Class="size-3.5" />
                Set up monitoring
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _chartBars =
    [
        "h-6", "h-10", "h-16", "h-12", "h-20", "h-14",
        "h-8", "h-18", "h-11", "h-15", "h-7", "h-13"
    ];

    private record MetricSlot(string Label, string Unit);

    private static readonly MetricSlot[] _metricSlots =
    [
        new("Avg. response time", "ms"),
        new("P95 latency", "ms"),
        new("Throughput", "req/s"),
        new("Error rate", "%"),
    ];
}
