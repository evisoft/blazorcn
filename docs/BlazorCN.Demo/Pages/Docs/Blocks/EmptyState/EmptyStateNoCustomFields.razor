@* ============================================================
   Block: empty-state-no-custom-fields
   Title: EmptyStateNoCustomFields
   Description: An empty state block for when no custom fields are defined, showing a form skeleton with empty field slots and a CTA to create the first custom field
   Source: original/blocks/empty-state/empty-state-no-custom-fields.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="sliders-horizontal" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Custom Fields</span>
            <span class="ml-auto font-mono text-muted-foreground/40 text-xs">0 fields</span>
        </div>

        @* Form skeleton placeholders *@
        <div class="border-b px-4 py-5">
            <div class="space-y-4">
                @foreach (var field in _ghostFields)
                {
                    <div class="space-y-1.5">
                        <div class="flex items-center justify-between">
                            <div class="h-2.5 w-24 rounded bg-muted/70"></div>
                            <span class="font-mono text-muted-foreground/30 text-[10px]">@field.Type</span>
                        </div>
                        <div class="@Cn.Merge(field.Width, "h-8 rounded-md border border-dashed bg-muted/20")"></div>
                    </div>
                }
            </div>
        </div>

        @* Message and CTA *@
        <div class="flex flex-col items-center px-4 py-8 text-center">
            <h3 class="font-medium text-sm">No custom fields defined</h3>
            <p class="mt-1.5 max-w-xs text-muted-foreground text-xs leading-relaxed">
                Extend your data models with custom fields. Add text, numbers, dates, and dropdowns to
                capture the information that matters to your workflow.
            </p>

            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Create field
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record GhostField(string Label, string Type, string Width);

    private static readonly GhostField[] _ghostFields =
    [
        new("Company Name", "Text", "w-full"),
        new("Annual Revenue", "Number", "w-2/3"),
        new("Industry", "Dropdown", "w-1/2"),
        new("Founded Date", "Date", "w-2/3"),
    ];
}
