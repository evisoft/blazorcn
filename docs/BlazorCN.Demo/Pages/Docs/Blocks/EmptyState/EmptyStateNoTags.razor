@* ============================================================
   Block: empty-state-no-tags
   Title: EmptyStateNoTags
   Description: An empty state block for when no tags or labels have been created, featuring colorful ghost tag chips and a CTA to create the first tag
   Source: original/blocks/empty-state/empty-state-no-tags.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="tag" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Tags</span>
            <span class="ml-auto font-mono text-muted-foreground/40 text-xs">0 tags</span>
        </div>

        @* Ghost tag chips *@
        <div class="flex flex-col items-center px-6 py-10">
            <div class="flex max-w-sm flex-wrap items-center justify-center gap-2">
                @foreach (var tag in _ghostTags)
                {
                    <span class="@Cn.Merge("inline-flex items-center rounded-full px-2.5 py-1 font-medium text-xs", tag.Color)">
                        @tag.Name
                    </span>
                }
            </div>

            @* Message *@
            <div class="mt-6 text-center">
                <h3 class="font-medium text-sm">No tags created</h3>
                <p class="mt-1.5 max-w-xs text-muted-foreground text-xs leading-relaxed">
                    Organize and filter your content with tags. Create color-coded labels to quickly
                    categorize items and build custom views.
                </p>
            </div>

            @* CTA *@
            <div class="mt-5">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    Create tag
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record GhostTag(string Name, string Color);

    private static readonly GhostTag[] _ghostTags =
    [
        new("Bug",      "bg-red-500/15 text-red-500/40"),
        new("Feature",  "bg-blue-500/15 text-blue-500/40"),
        new("Urgent",   "bg-amber-500/15 text-amber-500/40"),
        new("Design",   "bg-purple-500/15 text-purple-500/40"),
        new("Backend",  "bg-emerald-500/15 text-emerald-500/40"),
        new("v2.0",     "bg-zinc-500/15 text-zinc-500/40"),
        new("Docs",     "bg-cyan-500/15 text-cyan-500/40"),
        new("Blocked",  "bg-rose-500/15 text-rose-500/40"),
    ];
}
