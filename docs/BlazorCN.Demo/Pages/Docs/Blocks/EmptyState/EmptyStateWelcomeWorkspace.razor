@* ============================================================
   Block: empty-state-welcome-workspace
   Title: EmptyStateWelcomeWorkspace
   Description: A celebratory empty state welcoming users to a fresh workspace with scattered decorative icons, warm messaging, and an explore features CTA built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-welcome-workspace.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="text-sm font-medium">Workspace</span>
        </div>

        @* Welcome content *@
        <div class="relative flex flex-col items-center justify-center px-6 py-16 text-center">
            @* Decorative scattered dots *@
            @foreach (var dot in _dots)
            {
                <span class="@($"absolute rounded-full bg-muted-foreground {dot.Size} {dot.Opacity}")"
                      style="@dot.Style"></span>
            }

            @* Icon *@
            <div class="flex size-14 items-center justify-center rounded-full bg-muted/50">
                <LucideIconCn Name="sparkles" Size="24" Class="size-6 text-muted-foreground" />
            </div>

            @* Text *@
            <div class="mt-5">
                <h2 class="text-sm font-medium">Welcome to your workspace</h2>
                <p class="mx-auto mt-1.5 max-w-xs text-sm text-muted-foreground">
                    Your workspace is ready. Explore features, create your first project, and invite your
                    team to start collaborating.
                </p>
            </div>

            @* CTA *@
            <div class="mt-6">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                    Explore features
                    <LucideIconCn Name="arrow-right" Size="14" Class="size-3.5" />
                </ButtonCn>
            </div>

            @* Hint *@
            <p class="mt-4 text-xs text-muted-foreground/60">
                You can always access this from the sidebar
            </p>
        </div>
    </div>
</section>

@code {
    private record DotItem(string Size, string Opacity, string Style);

    private static readonly DotItem[] _dots =
    [
        new("size-1.5", "opacity-30", "top:15%;left:18%;"),
        new("size-1",   "opacity-20", "top:25%;right:22%;"),
        new("size-1",   "opacity-15", "top:10%;left:42%;"),
        new("size-1",   "opacity-20", "bottom:28%;left:25%;"),
        new("size-1.5", "opacity-25", "bottom:22%;right:28%;"),
        new("size-1",   "opacity-15", "top:35%;right:15%;"),
    ];
}
