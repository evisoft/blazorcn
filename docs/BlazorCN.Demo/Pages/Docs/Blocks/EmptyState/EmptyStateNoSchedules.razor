@* ============================================================
   Block: empty-state-no-schedules
   Title: EmptyStateNoSchedules
   Description: A weekly schedule view empty state with day column skeleton and create CTA, built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-schedules.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calendar-days" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Schedules</span>
            </div>
            <span class="text-xs text-muted-foreground">This week</span>
        </div>

        @* Weekly column skeleton *@
        <div class="relative border-b px-4 py-4">
            <div class="grid grid-cols-7 gap-2">
                @foreach (var col in _columns)
                {
                    <div class="flex flex-col gap-1.5">
                        <span class="mb-1 text-center text-xs text-muted-foreground/60">@col.Day</span>
                        @foreach (var height in col.Blocks)
                        {
                            <div class="origin-top rounded bg-muted/50" style="@($"height:{height * 10}px")"></div>
                        }
                    </div>
                }
            </div>

            @* Overlay message *@
            <div class="absolute inset-0 flex flex-col items-center justify-center bg-card/80 backdrop-blur-[1px]">
                <div class="flex size-10 items-center justify-center rounded-full bg-muted/50">
                    <LucideIconCn Name="calendar-days" Size="20" Class="size-5 text-muted-foreground" />
                </div>
                <h2 class="mt-3 text-sm font-medium">No schedules created</h2>
                <p class="mt-1 max-w-xs text-center text-xs text-muted-foreground">
                    Create a schedule to organize your weekly routine, assign time blocks, and share
                    availability with your team.
                </p>
                <ButtonCn Size="ButtonSize.Sm" Class="mt-4 gap-1.5">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    Create schedule
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                Schedules support recurring blocks, color coding, and team member assignment.
            </p>
        </div>
    </div>
</section>

@code {
    private record DayColumn(string Day, int[] Blocks);

    private static readonly DayColumn[] _columns =
    [
        new("Mon", [3, 2, 4]),
        new("Tue", [2, 3, 2]),
        new("Wed", [4, 2, 3]),
        new("Thu", [2, 4, 2]),
        new("Fri", [3, 3, 3]),
        new("Sat", [2, 2]),
        new("Sun", [2, 2]),
    ];
}
