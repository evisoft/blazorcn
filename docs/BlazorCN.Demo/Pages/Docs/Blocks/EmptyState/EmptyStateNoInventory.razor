@* ============================================================
   Block: empty-state-no-inventory
   Title: EmptyStateNoInventory
   Description: React empty state block for inventory management with no stock tracking set up, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations featuring a table skeleton with column headers and setup CTA
   Source: original/blocks/empty-state/empty-state-no-inventory.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="warehouse" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">Inventory</span>
        </div>

        @* Empty state content *@
        <div class="flex flex-col items-center px-4 py-10">
            @* Table skeleton *@
            <div class="mb-6 w-full max-w-sm rounded-md border border-dashed">
                @* Column headers *@
                <div class="flex items-center gap-4 border-b border-dashed px-3 py-2">
                    <span class="w-28 text-xs font-medium text-muted-foreground">Product</span>
                    <span class="w-20 text-xs font-medium text-muted-foreground">SKU</span>
                    <span class="ml-auto text-xs font-medium text-muted-foreground">Stock</span>
                </div>

                @* Skeleton rows *@
                @foreach (var rowItem in _skeletonRows)
                {
                    var row = rowItem;
                    var isLast = row == _skeletonRows[_skeletonRows.Length - 1];
                    <div class="@Cn.Merge("flex items-center gap-4 px-3 py-2.5", isLast ? "" : "border-b border-dashed")">
                        <div class="@Cn.Merge("h-2.5 rounded bg-muted/50", row.Name)" />
                        <div class="@Cn.Merge("h-2 rounded bg-muted/40 font-mono", row.Sku)" />
                        <div class="@Cn.Merge("ml-auto h-2.5 rounded bg-muted/40", row.Stock)" />
                    </div>
                }
            </div>

            @* Text *@
            <h3 class="text-sm font-medium">Inventory not set up</h3>
            <p class="mt-1.5 max-w-xs text-center text-xs text-muted-foreground leading-relaxed">
                Track stock levels, set reorder points, and manage warehouse locations. Enable inventory
                tracking to prevent overselling.
            </p>

            @* CTA *@
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Set up inventory
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record SkeletonRow(string Name, string Sku, string Stock);

    private static readonly SkeletonRow[] _skeletonRows =
    [
        new("w-28", "w-20", "w-10"),
        new("w-32", "w-16", "w-12"),
        new("w-24", "w-20", "w-8"),
    ];
}
