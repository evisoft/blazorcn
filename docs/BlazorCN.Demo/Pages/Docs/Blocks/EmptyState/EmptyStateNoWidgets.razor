@* ============================================================
   Block: empty-state-no-widgets
   Title: EmptyStateNoWidgets
   Description: React empty state block for an empty widget grid area with dashed border placeholders, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations
   Source: original/blocks/empty-state/empty-state-no-widgets.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="grip" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Widgets</span>
        </div>

        @* Dashed grid area *@
        <div class="p-4">
            <div class="grid grid-cols-2 gap-3">
                @foreach (var slot in _placeholders)
                {
                    <div class="@Cn.Merge("flex h-20 items-center justify-center rounded-md border border-dashed border-muted-foreground/25 bg-muted/20 transition-colors hover:border-muted-foreground/40 hover:bg-muted/30", slot.Span)">
                        <LucideIconCn Name="plus" Size="16" Class="size-4 text-muted-foreground/40" />
                    </div>
                }
            </div>
        </div>

        @* Footer message *@
        <div class="border-t px-4 py-4">
            <div class="flex flex-col items-center text-center">
                <h3 class="font-medium text-sm">No widgets added</h3>
                <p class="mt-1 max-w-xs text-muted-foreground text-xs leading-relaxed">
                    Add widgets to build your custom view. Choose from charts, tables, metrics, and more
                    from the widget library.
                </p>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-4 h-8 gap-1.5 text-xs">
                    <LucideIconCn Name="component" Size="14" Class="size-3.5" />
                    Browse widget library
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record Placeholder(string Id, string Span);

    private static readonly Placeholder[] _placeholders =
    [
        new("slot-1", "col-span-1"),
        new("slot-2", "col-span-1"),
        new("slot-3", "col-span-2"),
        new("slot-4", "col-span-1"),
        new("slot-5", "col-span-1"),
    ];
}
