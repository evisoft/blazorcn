@* ============================================================
   Block: empty-state-first-project
   Title: EmptyStateFirstProject
   Description: A split-layout empty state prompting users to create their first project with an illustration area on the left and encouraging copy with CTA on the right, built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-first-project.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="text-sm font-medium">Projects</span>
        </div>

        @* Split content *@
        <div class="grid md:grid-cols-2">
            @* Left: illustration area *@
            <div class="flex items-center justify-center border-b bg-muted/20 px-6 py-14 md:border-b-0 md:border-r">
                <div class="relative flex size-32 items-center justify-center">
                    @* Background folder *@
                    <div class="absolute flex size-16 items-center justify-center rounded-xl bg-muted/60">
                        <LucideIconCn Name="folder-plus" Size="28" Class="size-7 text-muted-foreground/40" />
                    </div>

                    @* Floating file icons *@
                    <div class="absolute -top-1 -right-1 flex size-9 items-center justify-center rounded-lg bg-muted/80">
                        <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground/50" />
                    </div>
                    <div class="absolute -bottom-1 -left-1 flex size-9 items-center justify-center rounded-lg bg-muted/80">
                        <LucideIconCn Name="layers" Size="16" Class="size-4 text-muted-foreground/50" />
                    </div>
                </div>
            </div>

            @* Right: text and CTA *@
            <div class="flex flex-col items-start justify-center px-6 py-14">
                <div>
                    <h2 class="text-sm font-medium">Start your first project</h2>
                    <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
                        Projects help you organize tasks, track milestones, and collaborate with your team.
                        Everything in one place.
                    </p>
                </div>

                <div class="mt-6">
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                        <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                        Create project
                    </ButtonCn>
                </div>

                <p class="mt-3 text-xs text-muted-foreground/60">
                    Takes less than a minute to set up
                </p>
            </div>
        </div>
    </div>
</section>
