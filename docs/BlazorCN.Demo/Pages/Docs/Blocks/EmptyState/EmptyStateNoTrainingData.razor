@* ============================================================
   Block: empty-state-no-training-data
   Title: EmptyStateNoTrainingData
   Description: An empty training data state with an upload dropzone showing file type icons, brain icon, and a CTA to upload a dataset using shadcn/ui and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-training-data.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="brain" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Training Data</span>
            </div>
            <span class="text-xs text-muted-foreground">0 datasets</span>
        </div>

        @* Dropzone *@
        <div class="border-b px-4 py-5">
            <div class="flex flex-col items-center rounded-lg border-2 border-dashed border-muted-foreground/20 px-4 py-10 text-center transition-colors hover:border-muted-foreground/30 hover:bg-muted/20">
                <div class="mb-4 flex size-12 items-center justify-center rounded-full bg-muted/50">
                    <LucideIconCn Name="upload" Size="20" Class="size-5 text-muted-foreground" />
                </div>

                <p class="text-sm font-medium">Drop files here to upload</p>
                <p class="mt-1 text-xs text-muted-foreground">
                    or click to browse from your computer
                </p>

                @* File type badges *@
                <div class="mt-4 flex items-center gap-2">
                    @foreach (var ft in _fileTypes)
                    {
                        <span class="@($"rounded-md px-2 py-0.5 font-mono text-[10px] font-medium {ft.Bg} {ft.Color}")">
                            .@ft.Label.ToLowerInvariant()
                        </span>
                    }
                    <span class="text-xs text-muted-foreground">up to 100 MB</span>
                </div>
            </div>
        </div>

        @* Message and CTA *@
        <div class="flex flex-col items-center px-4 py-6 text-center">
            <h3 class="text-sm font-medium">No training data uploaded</h3>
            <p class="mt-1.5 max-w-xs text-xs text-muted-foreground">
                Upload datasets to fine-tune and train your AI models. Supported formats include CSV,
                JSON, and plain text files.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-4 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="upload" Size="14" Class="size-3.5" />
                Upload dataset
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FileType(string Label, string Color, string Bg);

    private static readonly FileType[] _fileTypes =
    [
        new("CSV", "text-emerald-600 dark:text-emerald-400", "bg-emerald-500/10"),
        new("JSON", "text-blue-600 dark:text-blue-400", "bg-blue-500/10"),
        new("TXT", "text-amber-600 dark:text-amber-400", "bg-amber-500/10"),
    ];
}
