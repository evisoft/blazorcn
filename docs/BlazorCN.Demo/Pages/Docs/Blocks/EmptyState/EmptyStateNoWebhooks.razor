@* ============================================================
   Block: empty-state-no-webhooks
   Title: EmptyStateNoWebhooks
   Description: React empty state block for webhook configuration with no endpoints set up, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations with an arrow diagram layout
   Source: original/blocks/empty-state/empty-state-no-webhooks.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="webhook" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Webhooks</span>
            <span class="ml-auto font-mono text-muted-foreground/40 text-xs">0 endpoints</span>
        </div>

        @* Arrow diagram *@
        <div class="flex flex-col items-center px-4 py-10">
            <div class="mb-6 flex w-full max-w-sm items-center gap-3">
                @* Source *@
                <div class="flex-1 rounded-md border border-dashed p-3">
                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Events</span>
                    <div class="space-y-1">
                        @foreach (var evt in _eventTypes)
                        {
                            <div class="rounded bg-muted/50 px-2 py-1 font-mono text-muted-foreground/60 text-xs">
                                @evt
                            </div>
                        }
                    </div>
                </div>

                @* Arrow *@
                <div class="flex flex-col items-center gap-1">
                    <LucideIconCn Name="arrow-right" Size="16" Class="size-4 text-muted-foreground/40" />
                    <span class="text-muted-foreground/40 text-[10px]">POST</span>
                </div>

                @* Destination placeholder *@
                <div class="flex flex-1 items-center justify-center rounded-md border border-dashed p-3">
                    <div class="text-center">
                        <span class="block font-mono text-muted-foreground/30 text-xs">
                            https://your-app.com/webhook
                        </span>
                    </div>
                </div>
            </div>

            @* Text *@
            <h3 class="font-medium text-sm">No webhooks configured</h3>
            <p class="mt-1.5 max-w-xs text-center text-muted-foreground text-xs leading-relaxed">
                Receive real-time event notifications by adding a webhook endpoint. Events are delivered
                as signed POST requests to your URL.
            </p>

            @* CTA *@
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Add webhook endpoint
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _eventTypes =
    [
        "payment.succeeded",
        "user.created",
        "invoice.sent",
    ];
}
