@* ============================================================
   Block: empty-state-no-roles
   Title: EmptyStateNoRoles
   Description: An empty state block for when no custom roles are defined, featuring a split layout with role preview placeholders and create role CTA
   Source: original/blocks/empty-state/empty-state-no-roles.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid grid-cols-1 sm:grid-cols-2">
            @* Left: Message *@
            <div class="flex flex-col justify-center border-b px-6 py-12 sm:border-r sm:border-b-0">
                <div>
                    <div class="flex size-10 items-center justify-center rounded-full bg-muted/50">
                        <LucideIconCn Name="shield" Size="18" Class="size-4.5 text-muted-foreground" />
                    </div>

                    <h3 class="mt-4 font-medium text-sm">No custom roles</h3>
                    <p class="mt-1.5 max-w-[260px] text-muted-foreground text-sm">
                        Create roles to define what each team member can access. Assign granular permissions
                        for fine-grained access control.
                    </p>

                    <div class="mt-5">
                        <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                            <LucideIconCn Name="plus" Size="14" Class="mr-1.5 size-3.5" />
                            Create role
                        </ButtonCn>
                    </div>
                </div>
            </div>

            @* Right: Ghost role placeholders *@
            <div class="flex flex-col justify-center px-4 py-6">
                @foreach (var role in _ghostRoles)
                {
                    var isLast = role == _ghostRoles[^1];
                    <div class="@Cn.Merge("flex items-center gap-3 rounded-md px-3 py-2.5", !isLast ? "border-b" : "")">
                        <div class="@Cn.Merge("size-7 rounded", role.Color)"></div>
                        <div class="flex-1">
                            <div class="h-3 w-16 rounded bg-muted/80"></div>
                            <div class="mt-1.5 h-2 w-24 rounded bg-muted/50"></div>
                        </div>
                        <span class="font-mono text-muted-foreground/40 text-xs">
                            @role.Permissions perms
                        </span>
                    </div>
                }

                <p class="mt-3 px-3 text-muted-foreground/40 text-xs">
                    Roles will appear here once created
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private record GhostRole(string Name, int Permissions, string Color);

    private static readonly GhostRole[] _ghostRoles =
    [
        new("Admin",  24, "bg-zinc-300 dark:bg-zinc-600"),
        new("Editor", 16, "bg-zinc-200 dark:bg-zinc-700"),
        new("Viewer",  8, "bg-zinc-100 dark:bg-zinc-800"),
    ];
}
