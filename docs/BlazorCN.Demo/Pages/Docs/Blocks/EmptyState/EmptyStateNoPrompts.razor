@* ============================================================
   Block: empty-state-no-prompts
   Title: EmptyStateNoPrompts
   Description: An empty saved prompts state with a template card grid skeleton, sparkles icon, and a CTA to create a reusable prompt using shadcn/ui and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-prompts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Saved Prompts</span>
            </div>
            <span class="text-xs text-muted-foreground">0 prompts</span>
        </div>

        @* Skeleton grid *@
        <div class="border-b px-4 py-4">
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
                @foreach (var card in _skeletonCards)
                {
                    <div class="rounded-md border border-dashed border-muted-foreground/20 p-3">
                        <div class="@Cn.Merge("mb-2 h-1.5 rounded-full bg-muted/50", card.LabelWidth)"></div>
                        <div class="@Cn.Merge("mb-2.5 h-2 rounded-full bg-muted/60", card.TitleWidth)"></div>
                        <div class="space-y-1.5">
                            <div class="@Cn.Merge("h-1.5 rounded-full bg-muted/40", card.LineWidth)"></div>
                            <div class="h-1.5 w-1/2 rounded-full bg-muted/40"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Message and CTA *@
        <div class="flex flex-col items-center px-4 py-6 text-center">
            <h3 class="text-sm font-medium">No saved prompts yet</h3>
            <p class="mt-1.5 max-w-xs text-xs text-muted-foreground">
                Save reusable prompts to speed up your AI workflows. Create templates with variables for
                consistent, repeatable results.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-4 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Create prompt
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record SkeletonCard(string Id, string LabelWidth, string TitleWidth, string LineWidth);

    private static readonly SkeletonCard[] _skeletonCards =
    [
        new("s1", "w-16", "w-3/4", "w-full"),
        new("s2", "w-12", "w-1/2", "w-4/5"),
        new("s3", "w-14", "w-2/3", "w-full"),
        new("s4", "w-10", "w-3/5", "w-3/4"),
        new("s5", "w-16", "w-1/2", "w-full"),
        new("s6", "w-12", "w-2/3", "w-4/5"),
    ];
}
