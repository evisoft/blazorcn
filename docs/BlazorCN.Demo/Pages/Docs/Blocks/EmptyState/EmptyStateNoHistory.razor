@* ============================================================
   Block: empty-state-no-history
   Title: EmptyStateNoHistory
   Description: React empty state block for browsing and action history sections with a timeline skeleton, clock entries, and an explore CTA built with Next.js, shadcn/ui, Tailwind CSS, and motion animations
   Source: original/blocks/empty-state/empty-state-no-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="clock" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">History</span>
            <span class="ml-auto text-muted-foreground text-xs">0 entries</span>
        </div>

        @* Content *@
        <div class="px-4 py-6">
            @* Timeline skeleton *@
            <div class="relative ml-4">
                @* Vertical line *@
                <div class="absolute top-1 bottom-1 left-0 w-px bg-muted/50" />

                <div class="space-y-4">
                    @foreach (var entry in _timelineEntries)
                    {
                        <div class="relative flex items-center gap-3 pl-5">
                            @* Dot on timeline *@
                            <span class="absolute left-0 -translate-x-1/2 size-2 rounded-full bg-muted/60" />

                            <div class="flex min-w-0 flex-1 items-center gap-3 rounded-md bg-muted/20 px-3 py-2.5">
                                <LucideIconCn Name="clock" Size="14" Class="size-3.5 shrink-0 text-muted-foreground/20" />
                                <div class="@Cn.Merge(entry.Width, "h-2 rounded bg-muted/40")" />
                                <span class="ml-auto shrink-0 text-muted-foreground/25 text-xs">
                                    @entry.Label
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* Message *@
            <div class="mt-6 flex flex-col items-center text-center">
                <h3 class="font-medium text-sm">No history yet</h3>
                <p class="mt-1.5 max-w-xs text-muted-foreground text-xs leading-relaxed">
                    Your recent activity will be tracked here. Browse, create, or edit content and it will
                    appear in your history timeline.
                </p>

                <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                    <LucideIconCn Name="compass" Size="14" Class="size-3.5" />
                    Start exploring
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <p class="text-center text-muted-foreground text-xs">
                History includes views, edits, and actions from the last 90 days.
            </p>
        </div>
    </div>
</section>

@code {
    private record TimelineEntry(string Id, string Label, string Width);

    private static readonly TimelineEntry[] _timelineEntries =
    [
        new("t1", "Today", "w-32"),
        new("t2", "Today", "w-24"),
        new("t3", "Yesterday", "w-36"),
        new("t4", "Yesterday", "w-28"),
        new("t5", "This week", "w-20"),
    ];
}
