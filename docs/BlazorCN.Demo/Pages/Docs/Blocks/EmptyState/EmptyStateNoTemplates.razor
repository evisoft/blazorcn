@* ============================================================
   Block: empty-state-no-templates
   Title: EmptyStateNoTemplates
   Description: An empty template gallery state with a card grid preview placeholder, message about starting from templates, and a CTA to browse templates using shadcn/ui and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-templates.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="layout-template" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Templates</span>
            </div>
            <span class="text-muted-foreground text-xs">0 templates</span>
        </div>

        @* Placeholder grid *@
        <div class="border-b px-4 py-4">
            <div class="grid grid-cols-2 gap-3">
                @foreach (var card in _placeholders)
                {
                    <div class="rounded-md border border-dashed border-muted-foreground/20 p-3">
                        <div class="@Cn.Merge("mb-2.5 h-2 rounded-full bg-muted/60", card.TitleWidth)"></div>
                        <div class="space-y-1.5">
                            <div class="@Cn.Merge("h-1.5 rounded-full bg-muted/40", card.BodyWidth)"></div>
                            <div class="h-1.5 w-2/3 rounded-full bg-muted/40"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Message and CTA *@
        <div class="flex flex-col items-center px-4 py-6 text-center">
            <h3 class="font-medium text-sm">No templates yet</h3>
            <p class="mt-1.5 max-w-xs text-muted-foreground text-sm leading-relaxed">
                Start from a pre-built template to save time. Browse the gallery and add templates to
                your collection.
            </p>

            <ButtonCn Size="ButtonSize.Sm" Class="mt-4 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="layout-template" Size="14" Class="size-3.5" />
                Browse templates
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record PlaceholderCard(string Id, string TitleWidth, string BodyWidth);

    private static readonly PlaceholderCard[] _placeholders =
    [
        new("t1", "w-2/3", "w-full"),
        new("t2", "w-1/2", "w-4/5"),
        new("t3", "w-3/5", "w-full"),
        new("t4", "w-2/5", "w-3/4"),
    ];
}
