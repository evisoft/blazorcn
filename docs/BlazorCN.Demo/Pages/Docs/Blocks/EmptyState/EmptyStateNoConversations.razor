@* ============================================================
   Block: empty-state-no-conversations
   Title: EmptyStateNoConversations
   Description: React empty state block for customer conversation feeds with chat bubble placeholders and a start conversation CTA built with Next.js, shadcn/ui, Tailwind CSS, and motion animations
   Source: original/blocks/empty-state/empty-state-no-conversations.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="message-square" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Conversations</span>
            </div>
            <span class="text-xs text-muted-foreground">0 active</span>
        </div>

        @* Chat bubble placeholders *@
        <div class="border-b px-4 py-6">
            <div class="mx-auto flex max-w-xs flex-col gap-2.5">
                @foreach (var bubble in _chatBubbles)
                {
                    <div class="@(bubble.Align == "right" ? "flex justify-end" : "flex justify-start")">
                        <div class="@bubble.Width h-7 rounded-xl @(bubble.Align == "left" ? "rounded-bl-sm bg-muted/60" : "rounded-br-sm bg-muted/80") opacity-35"></div>
                    </div>
                }
            </div>
        </div>

        @* Message and CTA *@
        <div class="flex flex-col items-center px-4 py-10 text-center">
            <h3 class="text-sm font-medium">No conversations yet</h3>
            <p class="mt-1.5 max-w-xs text-xs text-muted-foreground leading-relaxed">
                Customer chats and support conversations will appear here. Reach out to a customer to
                start your first conversation.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="send" Size="14" Class="size-3.5" />
                Start conversation
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ChatBubble(string Align, string Width);

    private static readonly ChatBubble[] _chatBubbles =
    [
        new("left",  "w-36"),
        new("right", "w-44"),
        new("left",  "w-28"),
        new("right", "w-32"),
    ];
}
