@* ============================================================
   Block: empty-state-no-notes
   Title: EmptyStateNoNotes
   Description: A minimal text-focused empty notes state with a subtle sticky note icon, message about capturing ideas quickly, and a CTA to create a note using shadcn/ui and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-notes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sticky-note" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Notes</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs text-muted-foreground">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                New
            </ButtonCn>
        </div>

        @* Empty content *@
        <div class="px-4 py-14 text-center">
            <div>
                <p class="font-medium text-sm">Capture ideas as they come</p>
                <p class="mx-auto mt-1.5 max-w-xs text-muted-foreground text-sm leading-relaxed">
                    Jot down quick thoughts, meeting notes, or reminders. Your notes are private and
                    searchable.
                </p>
            </div>
        </div>

        @* Quick-add input *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <InputCn @bind-Value="_value"
                         Placeholder="Type a note and press Enter..."
                         Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 px-3 text-xs"
                          Disabled="@(string.IsNullOrWhiteSpace(_value))">
                    Add
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private string _value = "";
}
