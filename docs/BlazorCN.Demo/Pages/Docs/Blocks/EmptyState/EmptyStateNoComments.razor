@* ============================================================
   Block: empty-state-no-comments
   Title: EmptyStateNoComments
   Description: An empty comments state with a centered speech bubble icon, conversation-starting message, and add comment CTA using shadcn/ui and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-comments.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="message-circle" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Comments</span>
                <span class="text-muted-foreground text-xs">0</span>
            </div>
        </div>

        @* Empty content *@
        <div class="flex flex-col items-center justify-center px-6 py-14 text-center">
            <div class="relative">
                <div class="flex size-14 items-center justify-center rounded-2xl bg-muted/50">
                    <LucideIconCn Name="message-circle" Size="24" Class="size-6 text-muted-foreground" />
                </div>
                @* Small decorative dot *@
                <span class="absolute -bottom-1 -left-1 size-2 rounded-full bg-muted opacity-30"></span>
                <span class="absolute -bottom-2.5 -left-3 size-1.5 rounded-full bg-muted opacity-20"></span>
            </div>

            <div class="mt-5">
                <h3 class="font-medium text-sm">No comments yet</h3>
                <p class="mx-auto mt-1.5 max-w-xs text-muted-foreground text-sm">
                    Be the first to share your thoughts. Start the conversation and others will follow.
                </p>
            </div>
        </div>

        @* Inline comment input *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="size-7 shrink-0 rounded-full bg-muted"></div>
                <InputCn Placeholder="Add a comment..." Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 shrink-0 px-2 text-muted-foreground" aria-label="Post comment">
                    <LucideIconCn Name="send" Size="14" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>
    </div>
</section>
