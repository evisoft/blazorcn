@* ============================================================
   Block: empty-state-no-feedback
   Title: EmptyStateNoFeedback
   Description: React empty state block for feedback dashboards with an emoji rating scale showing zero counts and a request feedback CTA built with Next.js, shadcn/ui, Tailwind CSS, and motion animations
   Source: original/blocks/empty-state/empty-state-no-feedback.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="thumbs-up" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Feedback</span>
            </div>
            <span class="text-muted-foreground text-xs">0 responses</span>
        </div>

        @* Emoji rating scale *@
        <div class="border-b px-4 py-8">
            <div class="mx-auto flex max-w-sm items-end justify-center gap-4">
                @foreach (var rating in _ratings)
                {
                    <div class="flex flex-col items-center gap-2">
                        <span class="text-2xl">@rating.Emoji</span>
                        <div class="flex h-1 w-10 overflow-hidden rounded-full bg-muted/50">
                            <div class="@Cn.Merge("w-0", rating.Color)"></div>
                        </div>
                        <span class="text-muted-foreground text-xs">@rating.Label</span>
                        <span class="font-medium text-xs tabular-nums text-muted-foreground/60">0</span>
                    </div>
                }
            </div>
        </div>

        @* Message and CTA *@
        <div class="flex flex-col items-center px-4 py-10 text-center">
            <h3 class="font-medium text-sm">No feedback received</h3>
            <p class="mt-1.5 max-w-xs text-muted-foreground text-xs leading-relaxed">
                Collect user sentiment and satisfaction ratings to understand what your customers think.
                Responses will be summarized here.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="send" Size="14" Class="size-3.5" />
                Request feedback
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Rating(string Emoji, string Label, string Color);

    private static readonly Rating[] _ratings =
    [
        new("\U0001F614", "Awful",  "bg-red-500"),
        new("\U0001F641", "Poor",   "bg-amber-500"),
        new("\U0001F610", "Okay",   "bg-yellow-500"),
        new("\U0001F642", "Good",   "bg-emerald-500"),
        new("\U0001F929", "Great",  "bg-emerald-600"),
    ];
}
