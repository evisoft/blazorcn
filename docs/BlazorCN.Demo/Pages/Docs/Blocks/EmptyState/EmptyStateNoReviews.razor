@* ============================================================
   Block: empty-state-no-reviews
   Title: EmptyStateNoReviews
   Description: An empty reviews state with star rating skeleton slots, customer review message, and request reviews CTA using shadcn/ui and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-reviews.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with empty stars *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Reviews</span>
                    <span class="text-muted-foreground text-xs">0</span>
                </div>
                <div class="flex items-center gap-0.5">
                    @foreach (var i in Enumerable.Range(0, 5))
                    {
                        <LucideIconCn Name="star" Size="14" Class="size-3.5 text-muted-foreground/30" />
                    }
                </div>
            </div>
        </div>

        @* Ghost review slots *@
        <div>
            @foreach (var review in _ghostReviews)
            {
                <div class="border-b px-4 py-3">
                    <div class="flex items-start gap-3 opacity-15">
                        <div class="size-7 shrink-0 rounded-full bg-muted"></div>
                        <div class="min-w-0 flex-1 space-y-2">
                            <div class="flex items-center gap-2">
                                <div class="@($"h-2.5 rounded bg-muted {review.NameWidth}")"></div>
                                <div class="flex gap-0.5">
                                    @foreach (var j in Enumerable.Range(0, 5))
                                    {
                                        <div class="size-1.5 rounded-full bg-muted"></div>
                                    }
                                </div>
                            </div>
                            <div class="@($"h-2.5 rounded bg-muted {review.TextWidth}")"></div>
                            <div class="h-2.5 w-1/2 rounded bg-muted"></div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* CTA section *@
        <div class="flex flex-col items-center px-6 py-10 text-center">
            <h3 class="font-medium text-sm">No reviews yet</h3>
            <p class="mx-auto mt-1.5 max-w-xs text-muted-foreground text-sm">
                Customer reviews will appear here once submitted. Send a request to start collecting
                feedback.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="mail" Size="14" Class="size-3.5" />
                Request reviews
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record GhostReview(string Id, string NameWidth, string TextWidth);

    private static readonly GhostReview[] _ghostReviews =
    [
        new("r1", "w-20", "w-full"),
        new("r2", "w-16", "w-4/5"),
        new("r3", "w-24", "w-3/4"),
    ];
}
