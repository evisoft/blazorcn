@* ============================================================
   Block: empty-state-connect-tools
   Title: EmptyStateConnectTools
   Description: An empty state prompting users to connect their first integration with a grid of tool icon placeholders, descriptive messaging, and browse integrations CTA built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-connect-tools.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="plug" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Integrations</span>
                <span class="text-xs text-muted-foreground">0 connected</span>
            </div>
        </div>

        @* Content *@
        <div class="flex flex-col items-center justify-center px-6 py-14 text-center">
            @* Tool grid *@
            <div class="grid grid-cols-4 gap-3">
                @foreach (var tool in _tools)
                {
                    <div class="flex w-20 flex-col items-center gap-2 rounded-lg border border-dashed bg-muted/20 px-2 py-4">
                        <div class="flex size-9 items-center justify-center rounded-lg bg-muted/60">
                            <LucideIconCn Name="@tool.IconName" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="text-center">
                            <span class="block text-xs font-medium">@tool.Name</span>
                            <span class="block text-[10px] text-muted-foreground/60">@tool.Category</span>
                        </div>
                    </div>
                }
            </div>

            @* Text *@
            <div class="mt-6">
                <h3 class="text-sm font-medium">Connect tools you already use</h3>
                <p class="mx-auto mt-1.5 max-w-xs text-sm text-muted-foreground">
                    Bring your favorite tools together in one workspace. Sync data, automate workflows,
                    and reduce context switching.
                </p>
            </div>

            @* CTA *@
            <div class="mt-6">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                    <LucideIconCn Name="plug" Size="14" Class="size-3.5" />
                    Browse integrations
                </ButtonCn>
            </div>

            @* Hint *@
            <p class="mt-3 text-xs text-muted-foreground/60">
                50+ integrations available
            </p>
        </div>
    </div>
</section>

@code {
    private record Tool(string Name, string Category, string IconName);

    private static readonly Tool[] _tools =
    [
        new("Slack", "Communication", "message-square"),
        new("GitHub", "Version control", "git-branch"),
        new("Figma", "Design", "pen-tool"),
        new("Analytics", "Reporting", "bar-chart-3"),
    ];
}
