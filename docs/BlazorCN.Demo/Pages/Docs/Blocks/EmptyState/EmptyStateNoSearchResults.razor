@* ============================================================
   Block: empty-state-no-search-results
   Title: EmptyStateNoSearchResults
   Description: React empty state block for search pages returning no results, built with Next.js, shadcn/ui, Tailwind CSS, and subtle motion animations
   Source: original/blocks/empty-state/empty-state-no-search-results.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Search input *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="search" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
            <InputCn Value="@_searchQuery" Placeholder="" Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 shrink-0 gap-1 px-2 text-xs">
                <LucideIconCn Name="x" Size="12" Class="size-3" />
                Clear
            </ButtonCn>
        </div>

        @* Empty result area *@
        <div class="flex flex-col items-center px-4 py-12">
            <div class="mb-4 flex size-12 items-center justify-center rounded-full bg-muted/50">
                <LucideIconCn Name="search" Size="24" Class="size-6 text-muted-foreground" />
            </div>

            <h3 class="font-medium text-sm">No results found</h3>
            <p class="mt-1.5 max-w-xs text-center text-muted-foreground text-xs leading-relaxed">
                No items match &ldquo;@_searchQuery&rdquo;. Try different keywords or check for typos.
            </p>

            @* Suggestions *@
            <div class="mt-4 flex flex-wrap items-center justify-center gap-1.5">
                <span class="text-muted-foreground text-xs">Try:</span>
                @foreach (var term in _suggestions)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="cursor-pointer font-normal text-xs transition-colors hover:bg-muted">
                        @term
                    </BadgeCn>
                }
            </div>

            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                Clear search
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private const string _searchQuery = "quarterly revenue report";

    private static readonly string[] _suggestions =
    [
        "revenue report",
        "quarterly summary",
        "financial overview",
        "Q4 results",
    ];
}
