@* ============================================================
   Block: empty-state-no-tasks
   Title: EmptyStateNoTasks
   Description: A task board empty state with skeleton placeholders and create task CTA, built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-tasks.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="text-sm font-medium">Tasks</span>
            <span class="text-xs text-muted-foreground">0 items</span>
        </div>

        @* Skeleton rows with overlay *@
        <div class="relative">
            @foreach (var row in _skeletonRows)
            {
                <div class="flex items-center gap-3 border-b px-4 py-3">
                    <div class="size-4 shrink-0 rounded bg-muted/60"></div>
                    <div class="@Cn.Merge("h-3 rounded bg-muted/60", row.TitleWidth)"></div>
                    <div class="ml-auto flex items-center gap-2">
                        <div class="@Cn.Merge("h-2.5 rounded bg-muted/40", row.MetaWidth)"></div>
                        <div class="size-1.5 rounded-full bg-muted/40"></div>
                    </div>
                </div>
            }

            @* Overlay message *@
            <div class="absolute inset-0 flex flex-col items-center justify-center bg-card/80 backdrop-blur-[1px]">
                <div class="flex size-10 items-center justify-center rounded-full bg-muted/50">
                    <LucideIconCn Name="check-square" Size="20" Class="size-5 text-muted-foreground" />
                </div>
                <h2 class="mt-3 text-sm font-medium">No tasks on the board</h2>
                <p class="mt-1 max-w-xs text-center text-xs text-muted-foreground">
                    Add your first task to start tracking work and keeping your team aligned.
                </p>
                <ButtonCn Size="ButtonSize.Sm" Class="mt-4 gap-1.5">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    Create task
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                Tasks can be assigned, prioritized, and tracked across sprints.
            </p>
        </div>
    </div>
</section>

@code {
    private record SkeletonRow(string TitleWidth, string MetaWidth);

    private static readonly SkeletonRow[] _skeletonRows =
    [
        new("w-48", "w-16"),
        new("w-36", "w-20"),
        new("w-56", "w-14"),
        new("w-40", "w-18"),
    ];
}
