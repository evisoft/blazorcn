@* ============================================================
   Block: empty-state-no-environments
   Title: EmptyStateNoEnvironments
   Description: React empty state block for environment configuration with no environments set up, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations with three-column environment placeholders
   Source: original/blocks/empty-state/empty-state-no-environments.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="server" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Environments</span>
        </div>

        @* Empty state content *@
        <div class="flex flex-col items-center px-4 py-10">
            @* Three-column environment placeholders *@
            <div class="mb-6 grid w-full max-w-sm grid-cols-3 gap-2.5">
                @foreach (var env in _environments)
                {
                    <div class="rounded-md border border-dashed p-3 text-center">
                        <span class="@Cn.Merge("inline-flex rounded-full px-2 py-0.5 font-mono text-[10px] font-medium", env.Color)">
                            @env.Label
                        </span>
                        <span class="mt-2 block text-muted-foreground text-xs">@env.Name</span>
                        <div class="mx-auto mt-2 space-y-1">
                            <div class="mx-auto h-1.5 w-full rounded bg-muted/50"></div>
                            <div class="mx-auto h-1.5 w-3/4 rounded bg-muted/40"></div>
                        </div>
                    </div>
                }
            </div>

            @* Text *@
            <h3 class="font-medium text-sm">No environments set up</h3>
            <p class="mt-1.5 max-w-xs text-center text-muted-foreground text-xs leading-relaxed">
                Configure separate environments for development, staging, and production. Each
                environment has its own variables, domains, and deployment settings.
            </p>

            @* CTA *@
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Create environment
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <p class="text-center text-muted-foreground/60 text-xs">
                Environments isolate configuration and secrets across deployment tiers
            </p>
        </div>
    </div>
</section>

@code {
    private record EnvironmentItem(string Name, string Label, string Color);

    private static readonly EnvironmentItem[] _environments =
    [
        new("Development", "dev", "bg-emerald-500/15 text-emerald-600 dark:text-emerald-400"),
        new("Staging", "stg", "bg-amber-500/15 text-amber-600 dark:text-amber-400"),
        new("Production", "prod", "bg-blue-500/15 text-blue-600 dark:text-blue-400"),
    ];
}
