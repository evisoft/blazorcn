@* ============================================================
   Block: empty-state-no-alerts
   Title: EmptyStateNoAlerts
   Description: React empty state block for system alert dashboards with all-operational status indicators, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations
   Source: original/blocks/empty-state/empty-state-no-alerts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with status *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">System Alerts</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="relative flex size-2">
                    <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
                </span>
                <span class="text-emerald-600 text-xs dark:text-emerald-400">All clear</span>
            </div>
        </div>

        @* Status summary *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <span class="font-semibold text-2xl tabular-nums text-emerald-600 dark:text-emerald-400">
                    0
                </span>
                <div>
                    <p class="font-medium text-sm">Active alerts</p>
                    <p class="text-muted-foreground text-xs">All systems operational</p>
                </div>
            </div>
        </div>

        @* System rows *@
        <div>
            @foreach (var sys in _systems)
            {
                var isLast = sys == _systems[^1];
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-3", !isLast ? "border-b" : "")">
                    <span class="text-sm">@sys.Name</span>
                    <div class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="text-muted-foreground text-xs">@sys.Label</span>
                    </div>
                </div>
            }
        </div>

        @* CTA footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <p class="text-muted-foreground text-xs">Last incident: 14 days ago</p>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideIconCn Name="settings" Size="14" Class="size-3.5" />
                Configure alerts
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record SystemStatus(string Name, string Label);

    private static readonly SystemStatus[] _systems =
    [
        new("API", "Operational"),
        new("Database", "Operational"),
        new("CDN", "Operational"),
        new("Auth", "Operational"),
    ];
}
