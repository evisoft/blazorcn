@* ============================================================
   Block: empty-state-no-contacts
   Title: EmptyStateNoContacts
   Description: An empty state block for an empty contact list with avatar placeholders and import or manual add options
   Source: original/blocks/empty-state/empty-state-no-contacts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="contact" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Contacts</span>
                <span class="text-muted-foreground text-xs">0</span>
            </div>
        </div>

        @* Empty content *@
        <div class="flex flex-col items-center justify-center px-6 py-14 text-center">
            @* Stacked avatar placeholders *@
            <div class="flex -space-x-2">
                @foreach (var avatar in _placeholderAvatars)
                {
                    <div class="@Cn.Merge("flex size-9 items-center justify-center rounded-full border-2 border-card", avatar.Bg)">
                        <span class="font-medium text-muted-foreground/60 text-xs">@avatar.Initials</span>
                    </div>
                }
            </div>

            <div class="mt-5">
                <h3 class="font-medium text-sm">No contacts yet</h3>
                <p class="mx-auto mt-1.5 max-w-xs text-muted-foreground text-sm">
                    Import contacts from a CSV file or add them one by one to start building your address
                    book.
                </p>
            </div>

            <div class="mt-6 flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    <LucideIconCn Name="upload" Size="14" Class="mr-1.5 size-3.5" />
                    Import CSV
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="mr-1.5 size-3.5" />
                    Add contact
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record PlaceholderAvatar(string Initials, string Bg);

    private static readonly PlaceholderAvatar[] _placeholderAvatars =
    [
        new("AB", "bg-zinc-200 dark:bg-zinc-700"),
        new("CD", "bg-zinc-300 dark:bg-zinc-600"),
        new("EF", "bg-zinc-200 dark:bg-zinc-700"),
        new("GH", "bg-zinc-300 dark:bg-zinc-600"),
        new("IJ", "bg-zinc-200 dark:bg-zinc-700"),
    ];
}
