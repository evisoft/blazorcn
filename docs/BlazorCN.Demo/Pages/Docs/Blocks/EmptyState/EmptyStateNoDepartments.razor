@* ============================================================
   Block: empty-state-no-departments
   Title: EmptyStateNoDepartments
   Description: An empty state block for an empty org chart with no departments defined, featuring minimal text-only layout with subtle hierarchy hint
   Source: original/blocks/empty-state/empty-state-no-departments.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Departments</span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                <LucideIconCn Name="plus" Size="12" Class="mr-1.5 size-3" />
                Add department
            </ButtonCn>
        </div>

        @* Empty content with hierarchy hint *@
        <div class="px-6 py-14">
            <div class="flex flex-col items-center text-center">
                <h3 class="font-medium text-sm">No departments yet</h3>
                <p class="mx-auto mt-1.5 max-w-[300px] text-muted-foreground text-sm">
                    Organize your team by creating departments. Group members by function to streamline
                    communication and manage access.
                </p>
            </div>

            @* Subtle hierarchy hint *@
            <div class="mx-auto mt-8 max-w-[240px]">
                <div class="flex items-center gap-2.5 rounded-md bg-muted/30 px-3 py-2">
                    <LucideIconCn Name="building" Size="14" Class="size-3.5 text-muted-foreground/40" />
                    <div class="flex-1">
                        <div class="h-2.5 w-20 rounded bg-muted/60"></div>
                    </div>
                    <span class="font-mono text-muted-foreground/30 text-xs">0</span>
                </div>

                <div class="ml-5 mt-1 border-l pl-4">
                    <div class="flex items-center gap-2.5 rounded-md bg-muted/20 px-3 py-2">
                        <div class="size-3.5"></div>
                        <div class="flex-1">
                            <div class="h-2 w-16 rounded bg-muted/40"></div>
                        </div>
                    </div>
                    <div class="mt-1 flex items-center gap-2.5 rounded-md bg-muted/20 px-3 py-2">
                        <div class="size-3.5"></div>
                        <div class="flex-1">
                            <div class="h-2 w-12 rounded bg-muted/40"></div>
                        </div>
                    </div>
                </div>
            </div>

            <p class="mt-6 text-center text-muted-foreground/40 text-xs">
                Departments help organize your team into functional groups
            </p>
        </div>
    </div>
</section>
