@* ============================================================
   Block: empty-state-no-mentions
   Title: EmptyStateNoMentions
   Description: An empty mentions state with an at-sign icon, explanation of how mentions work, and a learn more CTA using shadcn/ui and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-mentions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="at-sign" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">Mentions</span>
        </div>

        <div class="flex flex-col items-center px-4 py-14 text-center">
            @* Icon with pulsing ring *@
            <div class="relative mb-5 flex items-center justify-center">
                <span class="absolute size-12 animate-ping rounded-full border border-muted-foreground/20 opacity-40"></span>
                <div class="flex size-10 items-center justify-center rounded-full bg-muted/50">
                    <LucideIconCn Name="at-sign" Size="20" Class="size-5 text-muted-foreground" />
                </div>
            </div>

            <h3 class="text-sm font-medium">No mentions yet</h3>
            <p class="mt-1.5 max-w-xs text-xs text-muted-foreground">
                When someone mentions you with <span class="font-mono">@@</span>
                in a thread or comment, it will show up here so you never miss a conversation.
            </p>

            @* Info hints *@
            <div class="mt-6 flex flex-col gap-2">
                <div class="flex items-center gap-2.5 rounded-md bg-muted/50 px-3 py-2">
                    <span class="size-1.5 shrink-0 rounded-full bg-muted-foreground/30"></span>
                    <span class="text-xs text-muted-foreground">
                        Teammates can mention you by typing <span class="font-mono">@@yourname</span>
                    </span>
                </div>
                <div class="flex items-center gap-2.5 rounded-md bg-muted/50 px-3 py-2">
                    <span class="size-1.5 shrink-0 rounded-full bg-muted-foreground/30"></span>
                    <span class="text-xs text-muted-foreground">
                        You will get a notification for each mention
                    </span>
                </div>
            </div>

            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="mt-5 h-7 gap-1.5 text-xs text-muted-foreground">
                <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                Learn more
            </ButtonCn>
        </div>
    </div>
</section>
