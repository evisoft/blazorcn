@* ============================================================
   Block: empty-state-no-files
   Title: EmptyStateNoFiles
   Description: React empty state block for file managers with no uploaded files, built with Next.js, shadcn/ui, Tailwind CSS, and subtle motion animations featuring skeleton file rows
   Source: original/blocks/empty-state/empty-state-no-files.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="hard-drive" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Files</span>
            <span class="ml-auto text-muted-foreground text-xs">0 items</span>
        </div>

        @* Skeleton file rows *@
        <div class="border-b">
            @foreach (var row in _skeletonRows)
            {
                var isLast = row == _skeletonRows[_skeletonRows.Length - 1];
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <div class="size-4 rounded bg-muted/60"></div>
                    <div class="@Cn.Merge("h-3 rounded bg-muted/40", row.NameWidth)"></div>
                    <div class="@Cn.Merge("ml-auto h-2.5 rounded bg-muted/30", row.SizeWidth)"></div>
                </div>
            }
        </div>

        @* Empty state content *@
        <div class="flex flex-col items-center px-4 py-12 text-center">
            <div class="flex size-12 items-center justify-center rounded-full bg-muted/50">
                <LucideIconCn Name="hard-drive" Size="24" Class="size-6 text-muted-foreground" />
            </div>
            <h3 class="mt-4 font-medium text-sm">No files uploaded</h3>
            <p class="mt-1.5 max-w-xs text-muted-foreground text-xs leading-relaxed">
                Upload your first file to get started. Supported formats include documents, images,
                spreadsheets, and archives.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="upload" Size="14" Class="size-3.5" />
                Upload files
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record SkeletonRow(string NameWidth, string SizeWidth);

    private static readonly SkeletonRow[] _skeletonRows =
    [
        new("w-32", "w-12"),
        new("w-40", "w-10"),
        new("w-28", "w-14"),
    ];
}
