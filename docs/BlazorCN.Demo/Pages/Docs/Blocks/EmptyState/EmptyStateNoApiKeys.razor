@* ============================================================
   Block: empty-state-no-api-keys
   Title: EmptyStateNoApiKeys
   Description: React empty state block for API key management with no keys generated, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations with a terminal-style code layout
   Source: original/blocks/empty-state/empty-state-no-api-keys.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="key-round" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">API Keys</span>
            <span class="ml-auto font-mono text-muted-foreground/40 text-xs">0 keys</span>
        </div>

        @* Terminal-style code placeholder *@
        <div class="flex flex-col items-center px-4 py-10">
            <div class="mb-6 w-full max-w-sm rounded-md bg-zinc-950 p-4">
                <div class="mb-2 flex items-center gap-1.5">
                    <span class="size-2 rounded-full bg-zinc-700"></span>
                    <span class="size-2 rounded-full bg-zinc-700"></span>
                    <span class="size-2 rounded-full bg-zinc-700"></span>
                </div>
                <div class="space-y-1.5">
                    <div class="flex items-center gap-2 font-mono text-xs">
                        <span class="text-zinc-500">$</span>
                        <span class="text-zinc-400">curl -H</span>
                        <span class="text-zinc-600">"Authorization: Bearer</span>
                    </div>
                    <div class="flex items-center gap-1 pl-4 font-mono text-xs">
                        <span class="text-emerald-400/60">@_placeholderLines[0].Value</span>
                        <span class="text-zinc-600">@_placeholderLines[1].Value</span>
                        <span class="text-zinc-600">"</span>
                    </div>
                    <div class="flex items-center gap-2 pl-4 font-mono text-xs">
                        <span class="text-zinc-400">https://api.example.com/v1/data</span>
                    </div>
                </div>
            </div>

            @* Text *@
            <h3 class="font-medium text-sm">No API keys generated</h3>
            <p class="mt-1.5 max-w-xs text-center text-muted-foreground text-xs leading-relaxed">
                Create an API key to authenticate requests to your application. Keys are shown once
                after generation and cannot be retrieved later.
            </p>

            @* CTA *@
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Generate API key
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <p class="text-center font-mono text-muted-foreground/60 text-xs">
                Keys use AES-256 encryption and are hashed at rest
            </p>
        </div>
    </div>
</section>

@code {
    private record PlaceholderLine(string Label, string Value);

    private static readonly PlaceholderLine[] _placeholderLines =
    [
        new("prefix", "sk_live_"),
        new("key", "••••••••••••••••••••••••••••••••"),
    ];
}
