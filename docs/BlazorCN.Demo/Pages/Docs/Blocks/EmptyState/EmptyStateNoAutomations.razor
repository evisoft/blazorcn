@* ============================================================
   Block: empty-state-no-automations
   Title: EmptyStateNoAutomations
   Description: An empty state block for when no automation rules exist showing a flowchart skeleton with node placeholders and connector lines and a CTA to create an automation
   Source: original/blocks/empty-state/empty-state-no-automations.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="zap" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Automations</span>
                <span class="text-muted-foreground text-xs">0 rules</span>
            </div>
        </div>

        @* Empty content *@
        <div class="flex flex-col items-center justify-center px-6 py-14 text-center">
            @* Flowchart skeleton *@
            <div class="flex items-center">
                @foreach (var node in _flowNodes)
                {
                    var idx = System.Array.IndexOf(_flowNodes, node);
                    <div class="flex items-center">
                        @if (idx > 0)
                        {
                            <div class="flex items-center">
                                <div class="h-px w-6 bg-muted-foreground/20"></div>
                                <div class="size-0 border-y-[3px] border-l-[5px] border-y-transparent border-l-muted-foreground/20"></div>
                            </div>
                        }
                        <div class="flex flex-col items-center gap-1">
                            <div class="@Cn.Merge("flex h-10 items-center justify-center rounded-lg border border-dashed bg-muted/30", node.Width)">
                                @if (idx == 0)
                                {
                                    <LucideIconCn Name="zap" Size="14" Class="size-3.5 text-muted-foreground/40" />
                                }
                                @if (idx == 1)
                                {
                                    <div class="flex flex-col items-center gap-0.5">
                                        <div class="h-1 w-8 rounded-sm bg-muted-foreground/15"></div>
                                        <div class="h-1 w-5 rounded-sm bg-muted-foreground/10"></div>
                                    </div>
                                }
                                @if (idx == 2)
                                {
                                    <div class="size-3 rounded-sm border border-dashed border-muted-foreground/25"></div>
                                }
                            </div>
                            <span class="text-muted-foreground/50 text-[10px]">@node.Label</span>
                        </div>
                    </div>
                }
            </div>

            @* Branch arms below condition *@
            <div class="mt-1 flex gap-8">
                <div class="flex flex-col items-center">
                    <div class="h-3 border-l border-dashed border-muted-foreground/15"></div>
                    <div class="h-6 w-12 rounded-md border border-dashed bg-muted/20"></div>
                </div>
                <div class="flex flex-col items-center">
                    <div class="h-3 border-l border-dashed border-muted-foreground/15"></div>
                    <div class="h-6 w-12 rounded-md border border-dashed bg-muted/20"></div>
                </div>
            </div>

            <div class="mt-5">
                <h3 class="font-medium text-sm">No automations yet</h3>
                <p class="mx-auto mt-1.5 max-w-xs text-muted-foreground text-sm">
                    Create rules to automate repetitive workflows. Set triggers, define conditions, and
                    let actions run on autopilot.
                </p>
            </div>

            <div class="mt-6">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="mr-1.5 size-3.5" />
                    Create automation
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record FlowNode(string Id, string Label, string Width);

    private static readonly FlowNode[] _flowNodes =
    [
        new("trigger", "Trigger", "w-20"),
        new("condition", "Condition", "w-22"),
        new("action", "Action", "w-20"),
    ];
}
