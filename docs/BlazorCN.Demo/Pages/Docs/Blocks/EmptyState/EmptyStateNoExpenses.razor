@* ============================================================
   Block: empty-state-no-expenses
   Title: EmptyStateNoExpenses
   Description: A minimal empty state for expense tracking with no logged expenses, built with React, Next.js, shadcn/ui, and Tailwind CSS featuring a receipt-style dashed border layout and add expense CTA
   Source: original/blocks/empty-state/empty-state-no-expenses.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="receipt" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">Expenses</span>
        </div>

        @* Receipt placeholder *@
        <div class="flex justify-center px-4 pt-8 pb-2">
            <div class="w-full max-w-[240px]" aria-hidden="true">
                <div class="rounded-lg border-2 border-dashed border-muted-foreground/20 bg-muted/20 px-5 py-5">
                    @* Store name placeholder *@
                    <div class="mb-4 flex justify-center">
                        <div class="h-3 w-20 rounded bg-muted/60"></div>
                    </div>

                    @* Divider *@
                    <div class="mb-3 border-b border-dashed border-muted-foreground/15"></div>

                    @* Line items *@
                    <div class="space-y-2.5">
                        @foreach (var line in _receiptLines)
                        {
                            <div class="flex items-center justify-between">
                                <div class="@Cn.Merge("h-2.5 animate-pulse rounded bg-muted/50", line.Label)"></div>
                                <div class="@Cn.Merge("h-2.5 animate-pulse rounded bg-muted/50", line.Amount)"></div>
                            </div>
                        }
                    </div>

                    @* Total divider *@
                    <div class="mt-3 mb-3 border-b border-dashed border-muted-foreground/15"></div>

                    @* Total line *@
                    <div class="flex items-center justify-between">
                        <div class="h-3 w-12 rounded bg-muted/60"></div>
                        <div class="h-3 w-16 rounded bg-muted/60"></div>
                    </div>
                </div>
            </div>
        </div>

        @* Empty message *@
        <div class="flex flex-col items-center px-4 py-8 text-center">
            <h3 class="text-sm font-medium">No expenses logged</h3>
            <p class="mt-1.5 max-w-xs text-xs text-muted-foreground">
                Track your spending by logging expenses here. Add receipts, categorize purchases, and
                monitor your budget in one place.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Add expense
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                Expenses can be exported to CSV for accounting and reimbursement.
            </p>
        </div>
    </div>
</section>

@code {
    private record ReceiptLine(string Label, string Amount);

    private static readonly ReceiptLine[] _receiptLines =
    [
        new("w-24", "w-12"),
        new("w-32", "w-10"),
        new("w-20", "w-14"),
        new("w-28", "w-10"),
    ];
}
