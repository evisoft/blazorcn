@* ============================================================
   Block: empty-state-no-logs
   Title: EmptyStateNoLogs
   Description: React empty state block for application logs with no log entries yet, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations with a dark terminal-style output area
   Source: original/blocks/empty-state/empty-state-no-logs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="terminal" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Logs</span>
            <div class="ml-auto flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-muted-foreground/20"></span>
                <span class="font-mono text-muted-foreground/40 text-xs">disconnected</span>
            </div>
        </div>

        @* Terminal output area *@
        <div class="bg-zinc-950 px-4 py-4">
            <div class="space-y-1">
                @foreach (var line in _ghostLines)
                {
                    <div class="flex items-center gap-2 font-mono text-xs">
                        <span class="text-zinc-700">@line.Timestamp</span>
                        <span class="@line.LevelColor">[@line.Level]</span>
                        <span class="text-zinc-500">@line.Message</span>
                    </div>
                }
                @* Blinking cursor *@
                <div class="flex items-center gap-2 font-mono text-xs">
                    <span class="text-zinc-700">00:00:00.000</span>
                    <span class="inline-block h-3.5 w-1.5 animate-pulse bg-zinc-600"></span>
                </div>
            </div>
        </div>

        @* Message section *@
        <div class="flex flex-col items-center px-4 py-8">
            <h3 class="font-medium text-sm">No log entries</h3>
            <p class="mt-1.5 max-w-xs text-center text-muted-foreground text-xs leading-relaxed">
                Logs appear here in real-time once your application is running. Deploy your project or
                check the documentation for setup instructions.
            </p>

            @* CTA *@
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="external-link" Size="14" Class="size-3.5" />
                View documentation
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record GhostLine(string Timestamp, string Level, string LevelColor, string Message);

    private static readonly GhostLine[] _ghostLines =
    [
        new("00:00:00.000", "info", "text-zinc-600", "Waiting for log output..."),
        new("00:00:00.000", "info", "text-zinc-600", "Deploy your application to start streaming"),
        new("00:00:00.000", "---", "text-zinc-700", "No log entries to display"),
    ];
}
