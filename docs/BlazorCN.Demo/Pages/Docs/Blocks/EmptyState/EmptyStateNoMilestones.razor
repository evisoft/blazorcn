@* ============================================================
   Block: empty-state-no-milestones
   Title: EmptyStateNoMilestones
   Description: An empty state for milestone tracking with a dashed dropzone layout, built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-milestones.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="text-sm font-medium">Milestones</span>
            <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                No milestones set
            </span>
        </div>

        @* Dashed dropzone area *@
        <div class="px-4 py-8">
            <div class="flex flex-col items-center rounded-md border border-dashed border-muted-foreground/25 px-6 py-12 text-center">
                <div class="flex size-11 items-center justify-center rounded-lg bg-muted/50">
                    <LucideIconCn Name="flag" Size="20" Class="size-5 text-muted-foreground" />
                </div>
                <h2 class="mt-4 text-sm font-medium">No milestones yet</h2>
                <p class="mt-1.5 max-w-[280px] text-xs text-muted-foreground leading-relaxed">
                    Milestones mark key checkpoints in your project. Set target dates, track completion,
                    and keep your team focused on what matters.
                </p>
                <ButtonCn Size="ButtonSize.Sm" Class="mt-5 gap-1.5">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    Add milestone
                </ButtonCn>
            </div>
        </div>

        @* Progress hint *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="h-1.5 flex-1 rounded-full bg-muted/60"></div>
                <span class="shrink-0 text-xs text-muted-foreground">0% complete</span>
            </div>
        </div>
    </div>
</section>
