@* ============================================================
   Block: empty-state-no-guests
   Title: EmptyStateNoGuests
   Description: An empty state block for when no guest users have been added, featuring a dashed border invitation area with external collaborator messaging
   Source: original/blocks/empty-state/empty-state-no-guests.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="circle-user" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Guest users</span>
            </div>
            <span class="text-muted-foreground text-xs">0 guests</span>
        </div>

        @* Dashed invitation area *@
        <div class="p-4">
            <div class="flex flex-col items-center justify-center rounded-md border border-dashed px-6 py-12 text-center">
                <div class="flex size-12 items-center justify-center rounded-full bg-muted/50">
                    <LucideIconCn Name="circle-user" Size="20" Class="size-5 text-muted-foreground" />
                </div>

                <div class="mt-4">
                    <h3 class="font-medium text-sm">No guest users</h3>
                    <p class="mx-auto mt-1.5 max-w-[280px] text-muted-foreground text-sm">
                        Share projects with external collaborators by inviting them as guests. They will get
                        scoped access without full workspace permissions.
                    </p>
                </div>

                <div class="mt-5">
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                        <LucideIconCn Name="mail" Size="14" Class="mr-1.5 size-3.5" />
                        Invite guest
                    </ButtonCn>
                </div>

                <div class="mt-4 flex items-center gap-3 text-muted-foreground/60 text-xs">
                    <span class="flex items-center gap-1">
                        <span class="size-1 rounded-full bg-emerald-500"></span>
                        Read access
                    </span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                        <span class="size-1 rounded-full bg-amber-500"></span>
                        Scoped permissions
                    </span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                        <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                        Auto-expires
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>

