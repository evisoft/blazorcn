<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with breadcrumb *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <span class="font-medium text-sm">All Files</span>
            <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 text-muted-foreground/50" />
            <span class="text-muted-foreground text-sm">Folders</span>
        </div>

        @* Empty state content *@
        <div class="flex flex-col items-center px-4 py-16 text-center">
            <div class="flex size-12 items-center justify-center rounded-full bg-muted/50">
                <LucideIconCn Name="folder-plus" Size="24" Class="size-6 text-muted-foreground" />
            </div>
            <h3 class="mt-4 font-medium text-sm">No folders yet</h3>
            <p class="mt-1.5 max-w-xs text-muted-foreground text-xs leading-relaxed">
                Organize your files into folders to keep your workspace tidy. Folders can be nested,
                shared, and color-coded.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Create folder
            </ButtonCn>
        </div>

        @* Footer hint *@
        <div class="border-t px-4 py-3">
            <p class="text-center text-muted-foreground text-xs">
                Tip: drag files onto a folder to move them inside.
            </p>
        </div>
    </div>
</section>
