@* ============================================================
   Block: empty-state-no-feature-requests
   Title: EmptyStateNoFeatureRequests
   Description: React empty state block for feature request boards with an idea card grid skeleton and a create request form CTA built with Next.js, shadcn/ui, Tailwind CSS, and motion animations
   Source: original/blocks/empty-state/empty-state-no-feature-requests.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="lightbulb" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Feature Requests</span>
            </div>
            <span class="text-muted-foreground text-xs">0 ideas</span>
        </div>

        @* Skeleton idea card grid *@
        <div class="border-b px-4 py-5">
            <div class="grid grid-cols-3 gap-3">
                @foreach (var card in _skeletonCards)
                {
                    <div class="rounded-md border border-border/50 p-3">
                        <div class="mb-2 flex items-center justify-between">
                            <div class="@Cn.Merge("h-2.5 rounded bg-muted/80", card.TitleWidth)"></div>
                        </div>
                        <div class="@Cn.Merge("mb-3 h-2 rounded bg-muted/50", card.DescWidth)"></div>
                        <div class="flex items-center gap-1 text-muted-foreground/50">
                            <LucideIconCn Name="chevron-up" Size="12" Class="size-3" />
                            <span class="font-medium text-xs tabular-nums">@card.Votes</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Message and CTA *@
        <div class="flex flex-col items-center px-4 py-10 text-center">
            <h3 class="font-medium text-sm">No feature requests yet</h3>
            <p class="mt-1.5 max-w-xs text-muted-foreground text-xs leading-relaxed">
                Let your users submit and vote on ideas for your product. Feature requests will be
                collected and ranked here.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Create request form
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record SkeletonCard(string TitleWidth, string DescWidth, int Votes);

    private static readonly SkeletonCard[] _skeletonCards =
    [
        new("w-28", "w-full", 0),
        new("w-36", "w-3/4", 0),
        new("w-24", "w-5/6", 0),
    ];
}
