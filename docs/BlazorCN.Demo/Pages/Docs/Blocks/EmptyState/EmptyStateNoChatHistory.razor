@* ============================================================
   Block: empty-state-no-chat-history
   Title: EmptyStateNoChatHistory
   Description: An empty AI chat state with a mock chat window, empty message area, input bar, and a CTA to start a conversation using shadcn/ui and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-chat-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="message-square" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">AI Chat</span>
            <span class="text-xs text-muted-foreground">0 messages</span>
        </div>

        @* Empty message area *@
        <div class="flex flex-1 flex-col items-center justify-center px-4">
            <div class="flex flex-col items-center text-center">
                <div class="mb-4 flex size-12 items-center justify-center rounded-full bg-muted/50">
                    <LucideIconCn Name="message-square" Size="24" Class="size-6 text-muted-foreground" />
                </div>
                <h3 class="text-sm font-medium">Start a conversation</h3>
                <p class="mt-1.5 max-w-xs text-xs text-muted-foreground">
                    Ask a question, get help writing, or brainstorm ideas. Your AI assistant is ready to
                    chat.
                </p>
            </div>

            @* Suggestion chips *@
            <div class="mt-5 flex flex-wrap justify-center gap-2">
                @foreach (var suggestion in _suggestions)
                {
                    <button type="button" class="rounded-full border border-dashed px-3 py-1.5 text-xs text-muted-foreground transition-colors hover:bg-muted/50">
                        @suggestion
                    </button>
                }
            </div>
        </div>

        @* Input bar *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <InputCn Placeholder="Message AI assistant..." Class="h-9 border-0 bg-muted/30 shadow-none focus-visible:ring-0" />
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 w-8 shrink-0 p-0" aria-label="Send message">
                    <LucideIconCn Name="arrow-up" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _suggestions =
    [
        "Summarize this document",
        "Write a follow-up email",
        "Brainstorm ideas",
    ];
}
