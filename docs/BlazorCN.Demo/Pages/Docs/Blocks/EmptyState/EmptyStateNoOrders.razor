@* ============================================================
   Block: empty-state-no-orders
   Title: EmptyStateNoOrders
   Description: React empty state block for order management with no orders received, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations featuring a receipt-style placeholder and storefront CTA
   Source: original/blocks/empty-state/empty-state-no-orders.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="shopping-cart" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">Orders</span>
            <span class="ml-auto text-xs text-muted-foreground tabular-nums">0 orders</span>
        </div>

        @* Empty state content *@
        <div class="flex flex-col items-center px-4 py-12">
            @* Receipt placeholder *@
            <div class="mb-6 w-full max-w-[200px] rounded-md border border-dashed px-4 py-3">
                <div class="mb-3 flex items-center justify-center">
                    <LucideIconCn Name="shopping-cart" Size="20" Class="size-5 text-muted-foreground/40" />
                </div>
                <div class="space-y-2.5">
                    @foreach (var line in _receiptLines)
                    {
                        <div class="flex items-center justify-between">
                            <div class="@Cn.Merge("h-2 rounded bg-muted/50", line.Left)"></div>
                            <div class="@Cn.Merge("h-2 rounded bg-muted/40", line.Right)"></div>
                        </div>
                    }
                </div>
                <div class="mt-3 border-t border-dashed pt-2.5">
                    <div class="flex items-center justify-between">
                        <div class="h-2.5 w-14 rounded bg-muted/50"></div>
                        <div class="h-2.5 w-16 rounded bg-muted/60"></div>
                    </div>
                </div>
            </div>

            @* Text *@
            <h3 class="text-sm font-medium">No orders yet</h3>
            <p class="mt-1.5 max-w-xs text-center text-xs text-muted-foreground leading-relaxed">
                Orders will appear here as customers complete purchases. Share your storefront link to
                start receiving orders.
            </p>

            @* CTA *@
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="external-link" Size="14" Class="size-3.5" />
                View storefront
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ReceiptLine(string Left, string Right);

    private static readonly ReceiptLine[] _receiptLines =
    [
        new("w-24", "w-12"),
        new("w-32", "w-10"),
        new("w-20", "w-14"),
        new("w-28", "w-10"),
    ];
}
