@* ============================================================
   Block: empty-state-no-uploads
   Title: EmptyStateNoUploads
   Description: React empty state block with a prominent dashed border drag-and-drop upload zone, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations
   Source: original/blocks/empty-state/empty-state-no-uploads.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="upload-cloud" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Uploads</span>
        </div>

        @* Dropzone *@
        <div class="p-4">
            <div
                class="@Cn.Merge("flex flex-col items-center rounded-md border-2 border-dashed px-4 py-14 text-center transition-colors", _isDragOver ? "border-primary bg-primary/5" : "border-muted-foreground/20 bg-muted/20")"
                @ondragenter="@(() => _isDragOver = true)"
                @ondragleave="@(() => _isDragOver = false)"
                @ondragover:preventDefault="true"
                @ondrop="@(() => _isDragOver = false)">
                <div class="flex size-12 items-center justify-center rounded-full bg-muted/50">
                    <LucideIconCn Name="upload-cloud" Size="24" Class="size-6 text-muted-foreground" />
                </div>
                <h3 class="mt-4 font-medium text-sm">
                    @(_isDragOver ? "Drop files to upload" : "Drag and drop files here")
                </h3>
                <p class="mt-1.5 max-w-xs text-muted-foreground text-xs leading-relaxed">
                    Or click below to browse your device. Supports images, documents, and archives up to
                    50 MB each.
                </p>
                <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                    <LucideIconCn Name="upload-cloud" Size="14" Class="size-3.5" />
                    Browse files
                </ButtonCn>
            </div>
        </div>

        @* Footer hint *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-center gap-3 text-muted-foreground text-xs">
                <span>.png</span>
                <span class="size-0.5 rounded-full bg-muted-foreground/40"></span>
                <span>.jpg</span>
                <span class="size-0.5 rounded-full bg-muted-foreground/40"></span>
                <span>.pdf</span>
                <span class="size-0.5 rounded-full bg-muted-foreground/40"></span>
                <span>.zip</span>
                <span class="size-0.5 rounded-full bg-muted-foreground/40"></span>
                <span>.csv</span>
            </div>
        </div>
    </div>
</section>

@code {
    private bool _isDragOver = false;
}
