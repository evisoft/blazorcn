@* ============================================================
   Block: empty-state-no-posts
   Title: EmptyStateNoPosts
   Description: An empty social feed state with skeleton post cards, first-update message, and create post CTA using shadcn/ui and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-posts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Skeleton feed cards *@
        <div>
            @foreach (var post in _skeletonPosts)
            {
                <div class="border-b px-4 py-3">
                    <div class="flex items-start gap-3 opacity-20">
                        <div class="size-8 shrink-0 rounded-full bg-muted"></div>
                        <div class="min-w-0 flex-1 space-y-2">
                            <div class="flex items-center gap-2">
                                <div class="@Cn.Merge("h-3 rounded bg-muted", post.TitleWidth)"></div>
                                <div class="h-2.5 w-12 rounded bg-muted"></div>
                            </div>
                            <div class="@Cn.Merge("h-2.5 rounded bg-muted", post.BodyWidth)"></div>
                            <div class="h-2.5 w-2/3 rounded bg-muted"></div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Empty message *@
        <div class="flex flex-col items-center px-6 py-14 text-center">
            <div class="mb-4 flex size-12 items-center justify-center rounded-full bg-muted/50">
                <LucideIconCn Name="pen-square" Size="24" Class="size-6 text-muted-foreground" />
            </div>
            <h3 class="font-medium text-sm">No posts yet</h3>
            <p class="mx-auto mt-1.5 max-w-xs text-muted-foreground text-sm">
                Your feed is empty. Share your first update and start a conversation with your audience.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="pen-square" Size="14" Class="size-3.5" />
                Create post
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record SkeletonPost(string Id, string TitleWidth, string BodyWidth);

    private static readonly SkeletonPost[] _skeletonPosts =
    [
        new("s1", "w-32", "w-full"),
        new("s2", "w-24", "w-4/5"),
        new("s3", "w-28", "w-3/4"),
    ];
}
