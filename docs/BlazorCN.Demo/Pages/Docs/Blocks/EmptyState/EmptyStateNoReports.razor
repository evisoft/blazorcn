@* ============================================================
   Block: empty-state-no-reports
   Title: EmptyStateNoReports
   Description: React empty state block for a reports section with no generated reports, built with Next.js, shadcn/ui, Tailwind CSS, and motion animations
   Source: original/blocks/empty-state/empty-state-no-reports.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Reports</span>
        </div>

        @* Document preview area *@
        <div class="flex flex-col items-center px-4 pt-10 pb-4">
            @* Document icon with skeleton lines *@
            <div class="mb-6 w-44 rounded-md border border-muted-foreground/15 bg-muted/20 p-4">
                @* Title skeleton *@
                <div class="mb-3 h-2 w-20 rounded bg-muted-foreground/15"></div>
                <div class="mb-4 h-1.5 w-32 rounded bg-muted-foreground/10"></div>

                @* Table header skeleton *@
                <div class="mb-2 flex gap-3 border-b border-muted-foreground/10 pb-2">
                    <div class="h-1 w-12 rounded bg-muted-foreground/15"></div>
                    <div class="h-1 w-16 rounded bg-muted-foreground/15"></div>
                    <div class="h-1 w-8 rounded bg-muted-foreground/15"></div>
                </div>

                @* Table rows *@
                @foreach (var row in _skeletonRows)
                {
                    <div class="mb-1.5 flex gap-3">
                        @foreach (var w in row.Widths)
                        {
                            <div class="@Cn.Merge("h-1 rounded bg-muted-foreground/8", w)"></div>
                        }
                    </div>
                }
            </div>

            @* Text *@
            <h3 class="font-medium text-sm">No reports generated</h3>
            <p class="mt-1.5 max-w-xs text-center text-muted-foreground text-xs leading-relaxed">
                Generate your first report to summarize key metrics, trends, and insights. Reports can
                be scheduled to run automatically.
            </p>

            @* CTA *@
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Generate report
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record SkeletonRow(string Id, string[] Widths);

    private static readonly SkeletonRow[] _skeletonRows =
    [
        new("r1", ["w-24", "w-32", "w-16"]),
        new("r2", ["w-20", "w-28", "w-12"]),
        new("r3", ["w-28", "w-24", "w-20"]),
    ];
}
