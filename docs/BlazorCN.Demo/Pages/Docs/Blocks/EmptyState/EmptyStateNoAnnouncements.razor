@* ============================================================
   Block: empty-state-no-announcements
   Title: EmptyStateNoAnnouncements
   Description: An empty announcements feed state with a megaphone icon, timeline placeholder, and create announcement CTA using shadcn/ui and Tailwind CSS
   Source: original/blocks/empty-state/empty-state-no-announcements.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="megaphone" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">Announcements</span>
        </div>

        @* Timeline placeholder *@
        <div class="relative px-4 py-6">
            <div class="absolute bottom-0 left-8 top-6 w-px bg-border" />
            <div class="flex flex-col gap-5">
                @foreach (var entry in _timelineEntries)
                {
                    <div class="@($"relative flex items-start gap-3 pl-4 {entry.Opacity}")">
                        <span class="relative z-10 mt-1 size-2 shrink-0 rounded-full bg-muted-foreground/40 ring-2 ring-card" />
                        <div class="flex flex-col gap-1.5">
                            <div class="@($"h-2.5 rounded-sm bg-muted {entry.BarWidth}")" />
                            <div class="@($"h-2 rounded-sm bg-muted/60 {entry.SubWidth}")" />
                        </div>
                    </div>
                }
            </div>
        </div>

        @* CTA section *@
        <div class="flex flex-col items-center border-t px-4 py-8 text-center">
            <h3 class="text-sm font-medium">No announcements yet</h3>
            <p class="mt-1.5 max-w-xs text-xs text-muted-foreground">
                Announcements keep your team informed about important updates, policy changes, and
                milestones. Post the first one.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-5 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Create announcement
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TimelineEntry(string BarWidth, string SubWidth, string Opacity);

    private static readonly TimelineEntry[] _timelineEntries =
    [
        new("w-36", "w-20", "opacity-60"),
        new("w-28", "w-16", "opacity-35"),
        new("w-32", "w-24", "opacity-15"),
    ];
}
