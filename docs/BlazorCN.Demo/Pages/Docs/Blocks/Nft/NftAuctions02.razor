@* ============================================================
   Block: nft-auctions-02
   Title: Nft Auctions 02
   Description: Top NFT auctions grid with time period filters, category selectors, and creator/owner badges on each listing
   Long Description: NFT auction marketplace with countdown timers, current bids, and place bid buttons for each listing
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, BadgeCn, ButtonCn, CardCn, CardContentCn, CardHeaderCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, LucideGrid3X3Cn, LucideMenuCn
   Source: original/blocks/nft/nft-auctions-02.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
    <CardCn Class="border shadow-sm">
        <CardHeaderCn Class="flex flex-row flex-wrap items-start justify-between gap-6 p-6">
            <div>
                <h1 class="mb-1 text-2xl font-bold">Top Auctions</h1>
                <p class="text-muted-foreground max-w-2xl text-lg">
                    The most sought-after collections across the entire ecosystem.
                </p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <SelectCn Value="Last 24H" ValueChanged="v => { }">
                    <SelectTriggerCn Class="w-max">
                        <SelectValueCn Placeholder="Select Date" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="Last 6H">Last 6H</SelectItemCn>
                        <SelectItemCn Value="Last 12H">Last 12H</SelectItemCn>
                        <SelectItemCn Value="Last 24H">Last 24H</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
                <SelectCn Value="Category 1" ValueChanged="v => { }">
                    <SelectTriggerCn Class="w-max">
                        <SelectValueCn Placeholder="Category" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="Category 1">Category 1</SelectItemCn>
                        <SelectItemCn Value="Category 2">Category 2</SelectItemCn>
                        <SelectItemCn Value="Category 3">Category 3</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
                <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Outline">
                    <LucideMenuCn class="h-4 w-4" />
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Outline">
                    <LucideGrid3X3Cn class="h-4 w-4" />
                </ButtonCn>
            </div>
        </CardHeaderCn>
        <CardContentCn Class="grid grid-cols-1 gap-6 px-6 pt-0 pb-6 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var item in _data)
            {
                <CardCn Class="overflow-hidden py-0">
                    <CardHeaderCn Class="relative p-0">
                        <img alt="@item.Name" class="h-80 w-full object-cover object-center" height="400" src="@item.Img" width="400" />
                        <BadgeCn Class="absolute bottom-4 left-4 flex items-center gap-2 border-white/50 bg-white/70 backdrop-blur" Variant="BadgeVariant.Secondary">
                            <AvatarCn Class="h-7 w-7">
                                <AvatarImageCn Alt="@item.Name" Src="@item.ProfileImg" />
                                <AvatarFallbackCn>@item.Name[1]</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="flex flex-col">
                                <span class="text-xs font-semibold text-black">@item.Name</span>
                                <span class="text-muted-foreground text-xs">@item.Desc</span>
                            </div>
                        </BadgeCn>
                    </CardHeaderCn>
                    <CardContentCn Class="px-4 pb-4">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-muted-foreground text-sm">Current bid</p>
                                <p class="text-lg font-bold">@item.Price</p>
                            </div>
                            <div>
                                <p class="text-muted-foreground text-sm">Auction ends in</p>
                                <p class="text-sm font-semibold">@item.Time</p>
                            </div>
                        </div>
                    </CardContentCn>
                </CardCn>
            }
        </CardContentCn>
    </CardCn>
</section>

@code {
    private record AuctionItem(string Img, string Name, string Desc, string ProfileImg, string Price, string Time);

    private readonly AuctionItem[] _data =
    [
        new("https://v3.material-tailwind.com/nft-1.svg", "@@thedreamytrees", "Owner",
            "https://images.unsplash.com/photo-1623853434105-8e7a72898180?auto=format&fit=crop&q=80&w=400&h=400",
            "1,3 BTC", "23h:03m:33s"),
        new("https://v3.material-tailwind.com/nft-2.svg", "@@lindemichael", "Creator",
            "https://images.unsplash.com/photo-1716662318479-a9c0f1cd1a0e?auto=format&fit=crop&q=80&w=400&h=400",
            "0,4 BTC", "23h:03m:33s"),
        new("https://v3.material-tailwind.com/nft-3.svg", "@@mishastam", "Owner",
            "https://v3.material-tailwind.com/man-profile-2.jpg",
            "0,3 BTC", "23h:03m:33s"),
    ];
}
