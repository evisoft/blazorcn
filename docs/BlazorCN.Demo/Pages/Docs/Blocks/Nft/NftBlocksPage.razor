@page "/docs/blocks/nft"
@layout DocsLayout

<PageTitle>NFT Blocks — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">NFT</h1>
        <p class="mt-2 text-lg text-muted-foreground">NFT auction marketplace, collection preview, and listing blocks.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Auction 01" Description="NFT auction marketplace with countdown timers, current bids, and place bid buttons for each listing." Code="@NftAuction01Code">
        <NftAuction01 />
    </ComponentPreview>

    <ComponentPreview Title="Auctions 02" Description="Top NFT auctions grid with time period filters, category selectors, and creator/owner badges on each listing." Code="@NftAuctions02Code">
        <NftAuctions02 />
    </ComponentPreview>

    <ComponentPreview Title="Collection 01" Description="NFT collection preview with pixel art showcasing digital assets with owner profiles and trader roles." Code="@NftCollection01Code">
        <NftCollection01 />
    </ComponentPreview>
</div>

@code {
    private const string NftAuction01Code = @"<section class=""container mx-auto py-16"">
    <CardCn Class=""border shadow-sm"">
        <CardHeaderCn Class=""flex flex-row flex-wrap items-start justify-between gap-6 p-6"">
            <div>
                <AvatarCn Class=""h-10 w-10"">
                    <AvatarImageCn Alt=""emma"" Src=""https://images.unsplash.com/photo-1623853434105-8e7a72898180?auto=format&fit=crop&q=80&w=400&h=400"" />
                    <AvatarFallbackCn>EM</AvatarFallbackCn>
                </AvatarCn>
                <h1 class=""mt-4 mb-1 flex items-center gap-2 text-2xl font-bold"">
                    Emma
                    <BadgeCn Class=""border-blue-500 text-blue-500"" Variant=""BadgeVariant.Outline"">
                        &#x2713;
                    </BadgeCn>
                </h1>
                <p class=""text-muted-foreground text-lg"">130 Collections</p>
            </div>
            <div class=""flex items-center gap-2"">
                <ButtonCn Size=""ButtonSize.Icon"" Variant=""ButtonVariant.Outline"" aria-label=""Menu"">
                    <LucideMenuCn class=""h-4 w-4"" />
                </ButtonCn>
                <ButtonCn Size=""ButtonSize.Icon"" Variant=""ButtonVariant.Outline"" aria-label=""Grid view"">
                    <LucideGrid3X3Cn class=""h-4 w-4"" />
                </ButtonCn>
                <ButtonCn>Follow Me</ButtonCn>
            </div>
        </CardHeaderCn>
        <CardContentCn Class=""grid grid-cols-1 gap-6 p-6 sm:grid-cols-2 lg:grid-cols-3"">
            @foreach (var item in _data)
            {
                <CardCn Class=""py-4"">
                    <CardHeaderCn Class=""relative gap-0 px-4"">
                        <img alt=""@item.Name"" class=""h-72 w-full rounded-md object-cover object-center"" height=""400"" src=""@item.Img"" width=""400"" />
                        <div class=""absolute top-6 right-6 flex items-center gap-2"">
                            <BadgeCn Class=""border-white/50 bg-white/70 text-black backdrop-blur"" Variant=""BadgeVariant.Secondary"">
                                Auction ends in 23h:03m:33s
                            </BadgeCn>
                            <ButtonCn Class=""h-7 w-7 bg-white text-black hover:bg-white"" Size=""ButtonSize.Icon"" Variant=""ButtonVariant.Secondary"" aria-label=""Like"">
                                <LucideHeartCn class=""h-3.5 w-3.5"" />
                            </ButtonCn>
                        </div>
                    </CardHeaderCn>
                    <CardContentCn Class=""px-4"">
                        <div class=""mb-2 flex items-center justify-between gap-4"">
                            <p class=""text-muted-foreground text-sm"">Cosmic creatures</p>
                            <div class=""flex items-center gap-1"">
                                <p class=""text-muted-foreground text-sm"">Current bid</p>
                                <div class=""flex gap-1"">
                                    <img alt=""ethereum"" class=""h-4 w-4"" height=""400"" src=""https://v3.material-tailwind.com/icon/eth.svg"" width=""400"" />
                                    <p class=""text-sm font-semibold"">@item.Price</p>
                                </div>
                            </div>
                        </div>
                        <div class=""flex items-center justify-between gap-4"">
                            <h2 class=""text-lg font-semibold"">Picture #@item.TokenId</h2>
                            <ButtonCn Size=""ButtonSize.Sm"">Place a Bid</ButtonCn>
                        </div>
                    </CardContentCn>
                </CardCn>
            }
        </CardContentCn>
    </CardCn>
</section>

