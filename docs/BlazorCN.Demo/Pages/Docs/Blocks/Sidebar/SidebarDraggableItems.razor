@* ============================================================
   Block: sidebar-draggable-items
   Title: SidebarDraggableItems
   Description: React sidebar with drag handle icons on navigation items for reordering. Built with Next.js, TypeScript, shadcn/ui Sidebar components, and Tailwind CSS transitions.
   Source: original/blocks/sidebar/sidebar-draggable-items.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <SidebarProviderCn Class="h-[700px] !min-h-0">
            <SidebarCn Class="border-r">
                <SidebarHeaderCn>
                    <SidebarMenuCn>
                        <SidebarMenuItemCn>
                            <SidebarMenuButtonCn Size="SidebarMenuButtonSize.Lg" Href="#">
                                <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                                    <LucideIconCn Name="gallery-vertical-end" Size="16" Class="size-4" />
                                </div>
                                <div class="flex flex-col gap-0.5 leading-none">
                                    <span class="font-medium">Workspace</span>
                                    <span class="text-xs text-muted-foreground">Drag to reorder</span>
                                </div>
                            </SidebarMenuButtonCn>
                        </SidebarMenuItemCn>
                    </SidebarMenuCn>
                </SidebarHeaderCn>
                <SidebarContentCn>
                    <SidebarGroupCn>
                        <SidebarGroupLabelCn>Favorites</SidebarGroupLabelCn>
                        <SidebarGroupContentCn>
                            <SidebarMenuCn>
                                @foreach (var item in _favorites)
                                {
                                    <SidebarMenuItemCn Class="group/drag">
                                        <div class="flex items-center">
                                            <span class="flex w-5 shrink-0 cursor-grab items-center justify-center opacity-0 transition-opacity group-hover/drag:opacity-100">
                                                <LucideIconCn Name="grip-vertical" Size="14" Class="size-3.5 text-muted-foreground/60" />
                                            </span>
                                            <SidebarMenuButtonCn Href="@item.Url" IsActive="@item.IsActive" Class="flex-1">
                                                <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                                <span>@item.Title</span>
                                            </SidebarMenuButtonCn>
                                        </div>
                                    </SidebarMenuItemCn>
                                }
                            </SidebarMenuCn>
                        </SidebarGroupContentCn>
                    </SidebarGroupCn>
                    <SidebarGroupCn>
                        <SidebarGroupLabelCn>Collections</SidebarGroupLabelCn>
                        <SidebarGroupContentCn>
                            <SidebarMenuCn>
                                @foreach (var item in _collections)
                                {
                                    <SidebarMenuItemCn Class="group/drag">
                                        <div class="flex items-center">
                                            <span class="flex w-5 shrink-0 cursor-grab items-center justify-center opacity-0 transition-opacity group-hover/drag:opacity-100">
                                                <LucideIconCn Name="grip-vertical" Size="14" Class="size-3.5 text-muted-foreground/60" />
                                            </span>
                                            <SidebarMenuButtonCn Href="@item.Url" Class="flex-1">
                                                <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                                <span>@item.Title</span>
                                            </SidebarMenuButtonCn>
                                        </div>
                                    </SidebarMenuItemCn>
                                }
                            </SidebarMenuCn>
                        </SidebarGroupContentCn>
                    </SidebarGroupCn>
                    <SidebarGroupCn>
                        <SidebarGroupLabelCn>System</SidebarGroupLabelCn>
                        <SidebarGroupContentCn>
                            <SidebarMenuCn>
                                @foreach (var item in _system)
                                {
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn Href="@item.Url">
                                            <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                            <span>@item.Title</span>
                                        </SidebarMenuButtonCn>
                                    </SidebarMenuItemCn>
                                }
                            </SidebarMenuCn>
                        </SidebarGroupContentCn>
                    </SidebarGroupCn>
                </SidebarContentCn>
                <SidebarRailCn />
            </SidebarCn>

            <SidebarInsetCn Class="min-w-0 flex-1">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <SidebarTriggerCn Class="-ml-1" />
                    <div class="mr-2 w-px self-stretch bg-border data-[orientation=vertical]:h-4" data-orientation="vertical"></div>
                    <nav aria-label="Breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground break-words sm:gap-2.5">
                            <li class="hidden md:block">
                                <a href="#" class="transition-colors hover:text-foreground">Favorites</a>
                            </li>
                            <li role="presentation" aria-hidden="true" class="hidden md:block [&>svg]:size-3.5">
                                <LucideIconCn Name="chevron-right" Size="14" />
                            </li>
                            <li>
                                <span role="link" aria-current="page" class="font-normal text-foreground">Dashboard</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </SidebarInsetCn>
        </SidebarProviderCn>
    </div>
</section>

@code {
    private record NavItem(string Title, string Url, string Icon, bool IsActive = false);

    private static readonly NavItem[] _favorites =
    [
        new("Dashboard", "#", "layout-dashboard", true),
        new("Inbox", "#", "inbox"),
        new("Documents", "#", "file-text"),
        new("Bookmarks", "#", "bookmark"),
    ];

    private static readonly NavItem[] _collections =
    [
        new("Project Alpha", "#", "folder"),
        new("Design Resources", "#", "star"),
        new("Meeting Notes", "#", "message-square"),
        new("Archive", "#", "folder"),
    ];

    private static readonly NavItem[] _system =
    [
        new("Settings", "#", "settings"),
    ];
}
