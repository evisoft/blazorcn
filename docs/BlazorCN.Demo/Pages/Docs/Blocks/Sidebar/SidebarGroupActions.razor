@* ============================================================
   Block: sidebar-group-actions
   Title: SidebarGroupActions
   Description: React sidebar with SidebarGroupAction buttons in group headers for adding items and quick actions. Built with Next.js, shadcn/ui Sidebar components, and Tailwind CSS.
   Source: original/blocks/sidebar/sidebar-group-actions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px]">
            @* Sidebar *@
            <div class="flex w-64 shrink-0 flex-col border-r bg-sidebar">
                @* Sidebar Header *@
                <div class="flex h-16 items-center border-b px-2">
                    <a href="#" class="flex w-full items-center gap-2 rounded-md p-2 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                        <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                            <LucideIconCn Name="gallery-vertical-end" Size="16" Class="size-4" />
                        </div>
                        <div class="flex flex-col gap-0.5 leading-none">
                            <span class="font-medium">Project Hub</span>
                            <span class="">Team workspace</span>
                        </div>
                    </a>
                </div>

                @* Sidebar Content *@
                <div class="flex flex-1 flex-col gap-2 overflow-y-auto py-2">
                    @* Projects Group *@
                    <div class="px-2">
                        <div class="relative flex items-center">
                            <span class="flex-1 px-2 py-1 text-xs font-medium text-sidebar-foreground/60">Projects</span>
                            <button type="button" title="Add Project"
                                    class="flex size-6 items-center justify-center rounded-md hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                                <LucideIconCn Name="plus" Size="16" Class="size-4" />
                                <span class="sr-only">Add Project</span>
                            </button>
                        </div>
                        <ul class="mt-1 space-y-0.5">
                            @foreach (var proj in _projectsNav)
                            {
                                var item = proj;
                                <li>
                                    <a href="@item.Url"
                                       class="@Cn.Merge("flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", item.IsActive ? "bg-sidebar-accent text-sidebar-accent-foreground font-medium" : "")">
                                        <LucideIconCn Name="folder" Size="16" Class="size-4 shrink-0" />
                                        <span>@item.Title</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    @* Documents Group *@
                    <div class="px-2">
                        <div class="relative flex items-center">
                            <span class="flex-1 px-2 py-1 text-xs font-medium text-sidebar-foreground/60">Documents</span>
                            <button type="button" title="Add Document"
                                    class="flex size-6 items-center justify-center rounded-md hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                                <LucideIconCn Name="plus" Size="16" Class="size-4" />
                                <span class="sr-only">Add Document</span>
                            </button>
                        </div>
                        <ul class="mt-1 space-y-0.5">
                            @foreach (var doc in _documentsNav)
                            {
                                var item = doc;
                                <li>
                                    <a href="@item.Url"
                                       class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                                        <LucideIconCn Name="file-text" Size="16" Class="size-4 shrink-0" />
                                        <span>@item.Title</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    @* Tags Group *@
                    <div class="px-2">
                        <div class="relative flex items-center">
                            <span class="flex-1 px-2 py-1 text-xs font-medium text-sidebar-foreground/60">Tags</span>
                            <button type="button" title="Add Tag"
                                    class="flex size-6 items-center justify-center rounded-md hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                                <LucideIconCn Name="plus" Size="16" Class="size-4" />
                                <span class="sr-only">Add Tag</span>
                            </button>
                        </div>
                        <ul class="mt-1 space-y-0.5">
                            @foreach (var tag in _tagsNav)
                            {
                                var item = tag;
                                <li>
                                    <a href="@item.Url"
                                       class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                                        <LucideIconCn Name="@item.Icon" Size="16" Class="size-4 shrink-0" />
                                        <span>@item.Title</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                @* Sidebar Rail *@
                <div class="absolute inset-y-0 right-0 w-px bg-border opacity-0 hover:opacity-100 cursor-col-resize"></div>
            </div>

            @* Main Content (SidebarInset) *@
            <div class="flex min-w-0 flex-1 flex-col">
                @* Header *@
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    @* Sidebar trigger *@
                    <button type="button" class="-ml-1 flex size-8 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    @* Vertical separator *@
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Projects</a>
                            </li>
                            <li class="hidden md:flex [&>svg]:size-3.5 [&>svg]:text-muted-foreground/70">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 text-muted-foreground/70" />
                            </li>
                            <li class="flex items-center">
                                <span role="link" aria-disabled="true" aria-current="page" class="font-normal text-foreground">Website Redesign</span>
                            </li>
                        </ol>
                    </nav>
                </header>

                @* Body *@
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record NavItem(string Title, string Url, bool IsActive = false);
    private record TagNavItem(string Title, string Url, string Icon);

    private static readonly NavItem[] _projectsNav =
    [
        new("Website Redesign", "#", true),
        new("Mobile App", "#"),
        new("API Platform", "#"),
    ];

    private static readonly NavItem[] _documentsNav =
    [
        new("Architecture Overview", "#"),
        new("API Specification", "#"),
        new("User Research Notes", "#"),
        new("Sprint Planning", "#"),
    ];

    private static readonly TagNavItem[] _tagsNav =
    [
        new("Frontend", "#", "hash"),
        new("Backend", "#", "hash"),
        new("Design", "#", "hash"),
        new("Urgent", "#", "tag"),
    ];
}
