@* ============================================================
   Block: sidebar-with-avatars
   Title: SidebarWithAvatars
   Description: A React team sidebar with Next.js, shadcn/ui Avatar and Sidebar components, and Tailwind CSS. Features avatar initials fallbacks for team members and project navigation.
   Source: original/blocks/sidebar/sidebar-with-avatars.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <SidebarProviderCn Class="h-[700px] !min-h-0">
            <SidebarCn Class="border-r">
                <SidebarHeaderCn>
                    <SidebarMenuCn>
                        <SidebarMenuItemCn>
                            <SidebarMenuButtonCn Size="SidebarMenuButtonSize.Lg" Href="#">
                                <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                                    <LucideIconCn Name="gallery-vertical-end" Size="16" Class="size-4" />
                                </div>
                                <div class="flex flex-col gap-0.5 leading-none">
                                    <span class="font-medium">Team Hub</span>
                                    <span class="text-xs text-muted-foreground">Workspace</span>
                                </div>
                            </SidebarMenuButtonCn>
                        </SidebarMenuItemCn>
                    </SidebarMenuCn>
                </SidebarHeaderCn>
                <SidebarContentCn>
                    <SidebarGroupCn>
                        <SidebarGroupLabelCn>Team Members</SidebarGroupLabelCn>
                        <SidebarGroupContentCn>
                            <SidebarMenuCn>
                                @foreach (var member in _teamMembers)
                                {
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn Href="#" IsActive="@member.IsActive" Class="h-auto py-2">
                                            <AvatarCn Class="size-7 shrink-0">
                                                <AvatarFallbackCn Class="text-[10px] font-medium">@member.Initials</AvatarFallbackCn>
                                            </AvatarCn>
                                            <div class="grid flex-1 text-left text-sm leading-tight">
                                                <span class="truncate font-medium">@member.Name</span>
                                                <span class="truncate text-xs text-muted-foreground">@member.Role</span>
                                            </div>
                                        </SidebarMenuButtonCn>
                                    </SidebarMenuItemCn>
                                }
                            </SidebarMenuCn>
                        </SidebarGroupContentCn>
                    </SidebarGroupCn>
                    <SidebarGroupCn>
                        <SidebarGroupLabelCn>Projects</SidebarGroupLabelCn>
                        <SidebarGroupContentCn>
                            <SidebarMenuCn>
                                @foreach (var proj in _projects)
                                {
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn Href="#" Class="h-auto py-2">
                                            <AvatarCn Class="size-7 shrink-0 rounded-md">
                                                <AvatarFallbackCn Class="rounded-md text-[10px] font-medium">@proj.Initials</AvatarFallbackCn>
                                            </AvatarCn>
                                            <div class="grid flex-1 text-left text-sm leading-tight">
                                                <span class="truncate font-medium">@proj.Name</span>
                                                <span class="truncate text-xs text-muted-foreground">@proj.Status</span>
                                            </div>
                                        </SidebarMenuButtonCn>
                                    </SidebarMenuItemCn>
                                }
                            </SidebarMenuCn>
                        </SidebarGroupContentCn>
                    </SidebarGroupCn>
                </SidebarContentCn>
                <SidebarRailCn />
            </SidebarCn>

            <SidebarInsetCn Class="min-w-0 flex-1">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <SidebarTriggerCn Class="-ml-1" />
                    <div class="mr-2 w-px self-stretch bg-border data-[orientation=vertical]:h-4" data-orientation="vertical"></div>
                    <nav aria-label="Breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground break-words sm:gap-2.5">
                            <li class="hidden md:block">
                                <a href="#" class="transition-colors hover:text-foreground">Team Members</a>
                            </li>
                            <li role="presentation" aria-hidden="true" class="hidden md:block [&>svg]:size-3.5">
                                <LucideIconCn Name="chevron-right" Size="14" />
                            </li>
                            <li>
                                <span role="link" aria-current="page" class="font-normal text-foreground">Sarah Chen</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </SidebarInsetCn>
        </SidebarProviderCn>
    </div>
</section>

@code {
    private record TeamMember(string Name, string Initials, string Role, bool IsActive = false);
    private record Project(string Name, string Initials, string Status);

    private static readonly TeamMember[] _teamMembers =
    [
        new("Sarah Chen", "SC", "Lead Designer", true),
        new("Marcus Johnson", "MJ", "Frontend Engineer"),
        new("Priya Patel", "PP", "Product Manager"),
        new("Alex Rivera", "AR", "Backend Engineer"),
        new("Jordan Kim", "JK", "QA Engineer"),
    ];

    private static readonly Project[] _projects =
    [
        new("Website Redesign", "WR", "Active"),
        new("Mobile App", "MA", "In Progress"),
        new("API Platform", "AP", "Planning"),
        new("Design System", "DS", "Active"),
    ];
}
