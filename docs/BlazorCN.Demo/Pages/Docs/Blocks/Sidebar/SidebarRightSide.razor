@* ============================================================
   Block: sidebar-right-side
   Title: SidebarRightSide
   Description: React right-aligned sidebar with Properties and Inspector sections. Built with Next.js, shadcn/ui Sidebar components with side="right", and Tailwind CSS.
   Source: original/blocks/sidebar/sidebar-right-side.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px] w-full bg-sidebar/50">

            @* Main content inset *@
            <div class="flex min-w-0 flex-1 flex-col">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Canvas</a>
                            </li>
                            <li class="hidden md:flex" aria-hidden="true">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                            </li>
                            <li class="flex items-center">
                                <span role="link" aria-current="page" aria-disabled="true" class="font-normal text-foreground">Design Editor</span>
                            </li>
                        </ol>
                    </nav>
                    <div class="ml-auto flex items-center gap-2">
                        <div class="mr-2 h-4 w-px bg-border"></div>
                        @* Sidebar trigger button *@
                        <button type="button" class="-mr-1 flex size-7 items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-accent-foreground">
                            <LucideIconCn Name="panel-right" Size="16" Class="size-4" />
                            <span class="sr-only">Toggle Sidebar</span>
                        </button>
                    </div>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>

            @* Right Sidebar *@
            <div class="flex w-64 shrink-0 flex-col border-l bg-sidebar">

                @* Sidebar Header *@
                <div class="flex h-16 items-center px-4 py-2">
                    <a href="#" class="flex items-center gap-3 rounded-md px-2 py-2 text-sm font-medium hover:bg-sidebar-accent hover:text-sidebar-accent-foreground w-full">
                        <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                            <LucideIconCn Name="gallery-vertical-end" Size="16" Class="size-4" />
                        </div>
                        <div class="flex flex-col gap-0.5 leading-none">
                            <span class="font-medium">Inspector</span>
                            <span class="">Properties panel</span>
                        </div>
                    </a>
                </div>

                @* Sidebar Content *@
                <div class="flex-1 overflow-y-auto px-2 py-2">

                    @* Properties group *@
                    <div class="mb-2">
                        <div class="flex items-center px-2 py-1.5 text-xs font-medium text-sidebar-foreground/70">
                            Properties
                        </div>
                        <ul class="space-y-0.5">
                            @foreach (var item in _propertiesNav)
                            {
                                var isActive = item.IsActive;
                                <li>
                                    <a href="@item.Url"
                                       class="@Cn.Merge("flex items-center gap-2 rounded-md px-2 py-1.5 text-sm text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", isActive ? "bg-sidebar-accent font-medium text-sidebar-accent-foreground" : "")">
                                        <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                        <span>@item.Title</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    @* Inspector group *@
                    <div class="mb-2">
                        <div class="flex items-center px-2 py-1.5 text-xs font-medium text-sidebar-foreground/70">
                            Inspector
                        </div>
                        <ul class="space-y-0.5">
                            @foreach (var item in _inspectorNav)
                            {
                                <li>
                                    <a href="@item.Url"
                                       class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                                        <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                        <span>@item.Title</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                </div>

                @* Sidebar Rail (visual left divider) *@
                <div class="absolute inset-y-0 left-0 hidden w-px -translate-x-px bg-sidebar-border"></div>

            </div>

        </div>
    </div>
</section>

@code {
    private record NavItem(string Title, string Url, string Icon, bool IsActive = false);

    private static readonly NavItem[] _propertiesNav =
    [
        new("Design", "#", "palette", true),
        new("Layout", "#", "layers"),
        new("Typography", "#", "type"),
        new("Spacing", "#", "ruler"),
    ];

    private static readonly NavItem[] _inspectorNav =
    [
        new("Components", "#", "box"),
        new("Styles", "#", "pen-tool"),
        new("Adjustments", "#", "sliders-horizontal"),
        new("Settings", "#", "settings"),
    ];
}
