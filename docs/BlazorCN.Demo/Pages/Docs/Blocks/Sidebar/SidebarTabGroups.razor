@* ============================================================
   Block: sidebar-tab-groups
   Title: SidebarTabGroups
   Description: A React sidebar with tab-like toggle buttons that switch between different navigation groups using React state, built with Next.js, shadcn/ui Sidebar components, and Tailwind CSS
   Source: original/blocks/sidebar/sidebar-tab-groups.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px]">
            @* Sidebar *@
            <div class="flex w-64 shrink-0 flex-col border-r bg-sidebar">
                @* Sidebar Header *@
                <div class="flex flex-col border-b">
                    @* Logo row *@
                    <div class="flex h-16 items-center px-2">
                        <a href="#" class="flex w-full items-center gap-2 rounded-md p-2 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                            <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                                <LucideIconCn Name="gallery-vertical-end" Size="16" Class="size-4" />
                            </div>
                            <div class="flex flex-col gap-0.5 leading-none">
                                <span class="font-medium">Studio</span>
                                <span class="text-xs text-muted-foreground">Design &amp; Code</span>
                            </div>
                        </a>
                    </div>
                    @* Tab toggle row *@
                    <div class="px-3 pb-2">
                        <div class="flex h-8 items-center rounded-md bg-muted p-1">
                            @foreach (var tb in _tabs)
                            {
                                var tab = tb;
                                <button type="button"
                                        @onclick="@(() => _activeTab = tab.Id)"
                                        class="@Cn.Merge("flex h-6 flex-1 items-center justify-center rounded-sm px-2 text-xs font-medium transition-colors", _activeTab == tab.Id ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")">
                                    @tab.Label
                                </button>
                            }
                        </div>
                    </div>
                </div>

                @* Sidebar Content *@
                <div class="flex flex-1 flex-col overflow-y-auto py-2">
                    @foreach (var grp in CurrentTab.Groups)
                    {
                        var group = grp;
                        <div>
                            <div class="px-4 py-1 text-xs font-medium text-sidebar-foreground/60">@group.Title</div>
                            <ul class="space-y-0.5 px-2">
                                @foreach (var itm in group.Items)
                                {
                                    var item = itm;
                                    <li>
                                        <a href="@item.Url"
                                           class="@Cn.Merge("flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", item.IsActive ? "bg-sidebar-accent text-sidebar-accent-foreground font-medium" : "")">
                                            <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                            <span>@item.Title</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>

                @* Sidebar Rail *@
                <div class="absolute inset-y-0 right-0 w-px bg-border opacity-0 hover:opacity-100 cursor-col-resize"></div>
            </div>

            @* Main Content (SidebarInset) *@
            <div class="flex min-w-0 flex-1 flex-col">
                @* Header *@
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <button type="button" class="-ml-1 flex size-8 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Explorer</a>
                            </li>
                            <li class="hidden md:flex [&>svg]:size-3.5 [&>svg]:text-muted-foreground/70">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 text-muted-foreground/70" />
                            </li>
                            <li class="flex items-center">
                                <span role="link" aria-disabled="true" aria-current="page" class="font-normal text-foreground">Files</span>
                            </li>
                        </ol>
                    </nav>
                </header>

                @* Body *@
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record NavItem(string Title, string Url, string Icon, bool IsActive = false);
    private record NavGroup(string Title, NavItem[] Items);
    private record TabDef(string Id, string Label, NavGroup[] Groups);

    private static readonly TabDef[] _tabs =
    [
        new("code", "Code",
        [
            new("Explorer",
            [
                new("Files", "#", "folder", true),
                new("Search", "#", "file-text"),
                new("Git Changes", "#", "git-branch"),
            ]),
            new("Development",
            [
                new("Components", "#", "package"),
                new("Dependencies", "#", "code"),
                new("Build Output", "#", "layout-dashboard"),
            ]),
        ]),
        new("design", "Design",
        [
            new("Canvas",
            [
                new("Artboards", "#", "palette"),
                new("Layers", "#", "image"),
                new("Assets", "#", "image"),
            ]),
            new("Styles",
            [
                new("Colors", "#", "palette"),
                new("Typography", "#", "type"),
                new("Effects", "#", "pen-tool"),
            ]),
        ]),
    ];

    private string _activeTab = "code";

    private TabDef CurrentTab =>
        Array.Find(_tabs, t => t.Id == _activeTab) ?? _tabs[0];
}
