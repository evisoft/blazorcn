@* ============================================================
   Block: sidebar-with-progress
   Title: SidebarWithProgress
   Description: A React sidebar with progress bars below nav items showing completion state. Built with Next.js, TypeScript, shadcn/ui Sidebar components, and Tailwind CSS.
   Source: original/blocks/sidebar/sidebar-with-progress.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <SidebarProviderCn Class="h-[700px] !min-h-0">
            <SidebarCn Class="border-r">
                <SidebarHeaderCn>
                    <SidebarMenuCn>
                        <SidebarMenuItemCn>
                            <SidebarMenuButtonCn Size="SidebarMenuButtonSize.Lg" Href="#">
                                <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                                    <LucideIconCn Name="gallery-vertical-end" Size="16" Class="size-4" />
                                </div>
                                <div class="flex flex-col gap-0.5 leading-none">
                                    <span class="font-medium">Learn Next.js</span>
                                    <span class="text-xs text-muted-foreground">Tutorial</span>
                                </div>
                            </SidebarMenuButtonCn>
                        </SidebarMenuItemCn>
                    </SidebarMenuCn>
                    <div class="px-3 pb-2">
                        <div class="rounded-md bg-muted/50 px-3 py-2">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-medium">Overall Progress</span>
                                <span class="text-xs tabular-nums text-muted-foreground">38%</span>
                            </div>
                            <div class="mt-1.5 h-1.5 rounded-full bg-muted">
                                <div class="h-1.5 rounded-full bg-primary" style="width:38%"></div>
                            </div>
                        </div>
                    </div>
                </SidebarHeaderCn>
                <SidebarContentCn>
                    <SidebarGroupCn>
                        <SidebarGroupLabelCn>Getting Started</SidebarGroupLabelCn>
                        <SidebarGroupContentCn>
                            <SidebarMenuCn>
                                @foreach (var item in _gettingStarted)
                                {
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn Href="#" IsActive="@item.IsActive">
                                            <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                            <span>@item.Title</span>
                                        </SidebarMenuButtonCn>
                                        @if (item.Progress == 100)
                                        {
                                            <div class="flex items-center gap-1 px-2 pb-1.5">
                                                <LucideIconCn Name="check-circle" Size="12" Class="size-3 text-emerald-500" />
                                                <span class="text-[10px] text-emerald-500 font-medium">Complete</span>
                                            </div>
                                        }
                                        else if (item.Progress == 0)
                                        {
                                            <div class="px-2 pb-1.5">
                                                <span class="text-[10px] text-muted-foreground">Not started</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="px-2 pb-1.5">
                                                <div class="flex items-center gap-2">
                                                    <div class="h-1 flex-1 rounded-full bg-muted">
                                                        <div class="h-1 rounded-full bg-primary transition-all duration-300" style="@($"width:{item.Progress}%")"></div>
                                                    </div>
                                                    <span class="text-[10px] tabular-nums text-muted-foreground">@(item.Progress)%</span>
                                                </div>
                                            </div>
                                        }
                                    </SidebarMenuItemCn>
                                }
                            </SidebarMenuCn>
                        </SidebarGroupContentCn>
                    </SidebarGroupCn>
                    <SidebarGroupCn>
                        <SidebarGroupLabelCn>Advanced Topics</SidebarGroupLabelCn>
                        <SidebarGroupContentCn>
                            <SidebarMenuCn>
                                @foreach (var item in _advanced)
                                {
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn Href="#">
                                            <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                            <span>@item.Title</span>
                                        </SidebarMenuButtonCn>
                                        @if (item.Progress == 100)
                                        {
                                            <div class="flex items-center gap-1 px-2 pb-1.5">
                                                <LucideIconCn Name="check-circle" Size="12" Class="size-3 text-emerald-500" />
                                                <span class="text-[10px] text-emerald-500 font-medium">Complete</span>
                                            </div>
                                        }
                                        else if (item.Progress == 0)
                                        {
                                            <div class="px-2 pb-1.5">
                                                <span class="text-[10px] text-muted-foreground">Not started</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="px-2 pb-1.5">
                                                <div class="flex items-center gap-2">
                                                    <div class="h-1 flex-1 rounded-full bg-muted">
                                                        <div class="h-1 rounded-full bg-primary transition-all duration-300" style="@($"width:{item.Progress}%")"></div>
                                                    </div>
                                                    <span class="text-[10px] tabular-nums text-muted-foreground">@(item.Progress)%</span>
                                                </div>
                                            </div>
                                        }
                                    </SidebarMenuItemCn>
                                }
                            </SidebarMenuCn>
                        </SidebarGroupContentCn>
                    </SidebarGroupCn>
                </SidebarContentCn>
                <SidebarRailCn />
            </SidebarCn>

            <SidebarInsetCn Class="min-w-0 flex-1">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <SidebarTriggerCn Class="-ml-1" />
                    <div class="mr-2 w-px self-stretch bg-border data-[orientation=vertical]:h-4" data-orientation="vertical"></div>
                    <nav aria-label="Breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground break-words sm:gap-2.5">
                            <li class="hidden md:block">
                                <a href="#" class="transition-colors hover:text-foreground">Getting Started</a>
                            </li>
                            <li role="presentation" aria-hidden="true" class="hidden md:block [&>svg]:size-3.5">
                                <LucideIconCn Name="chevron-right" Size="14" />
                            </li>
                            <li>
                                <span role="link" aria-current="page" class="font-normal text-foreground">Configuration</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </SidebarInsetCn>
        </SidebarProviderCn>
    </div>
</section>

@code {
    private record NavItem(string Title, string Url, string Icon, int Progress, bool IsActive = false);

    private static readonly NavItem[] _gettingStarted =
    [
        new("Installation", "#", "wrench", 100),
        new("Project Setup", "#", "rocket", 100),
        new("Configuration", "#", "server", 75, true),
        new("First Component", "#", "code", 30),
        new("Deployment", "#", "layout-dashboard", 0),
    ];

    private static readonly NavItem[] _advanced =
    [
        new("Authentication", "#", "shield", 60),
        new("Database", "#", "database", 20),
        new("API Routes", "#", "server", 0),
        new("Best Practices", "#", "book-open", 0),
    ];
}
