@* ============================================================
   Block: sidebar-icon-nav
   Title: SidebarIconNav
   Description: Collapsible React sidebar with icon-only mode, tooltips, and drag-to-resize using Next.js, shadcn/ui Sidebar components, and Tailwind CSS for responsive layouts.
   Source: original/blocks/sidebar/sidebar-icon-nav.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px]">
            @* Sidebar — collapsible icon nav *@
            <div class="@Cn.Merge("flex shrink-0 flex-col border-r bg-sidebar transition-all duration-300", _collapsed ? "w-14" : "w-64")">
                @* Sidebar Header *@
                <div class="flex h-16 items-center border-b px-2">
                    <a href="#" class="flex w-full items-center gap-2 rounded-md p-2 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground overflow-hidden">
                        <div class="flex aspect-square size-8 shrink-0 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                            <LucideIconCn Name="gallery-vertical-end" Size="16" Class="size-4" />
                        </div>
                        @if (!_collapsed)
                        {
                            <div class="flex flex-col gap-0.5 leading-none overflow-hidden">
                                <span class="font-medium truncate">Workspace</span>
                                <span class="truncate">Pro Plan</span>
                            </div>
                        }
                    </a>
                </div>

                @* Sidebar Content *@
                <div class="flex flex-1 flex-col overflow-y-auto py-2">
                    @* Navigation group *@
                    <div class="px-2">
                        @if (!_collapsed)
                        {
                            <div class="px-2 py-1 text-xs font-medium text-sidebar-foreground/60">Navigation</div>
                        }
                        <ul class="mt-0.5 space-y-0.5">
                            @foreach (var itm in _mainItems)
                            {
                                var item = itm;
                                <li title="@(_collapsed ? item.Title : null)">
                                    <a href="@item.Url"
                                       class="@Cn.Merge("flex items-center rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", item.IsActive ? "bg-sidebar-accent text-sidebar-accent-foreground font-medium" : "", _collapsed ? "justify-center" : "gap-2")">
                                        <LucideIconCn Name="@item.Icon" Size="16" Class="size-4 shrink-0" />
                                        @if (!_collapsed)
                                        {
                                            <span>@item.Title</span>
                                        }
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    @* Workspace group *@
                    <div class="mt-2 px-2">
                        @if (!_collapsed)
                        {
                            <div class="px-2 py-1 text-xs font-medium text-sidebar-foreground/60">Workspace</div>
                        }
                        <ul class="mt-0.5 space-y-0.5">
                            @foreach (var itm in _workspaceItems)
                            {
                                var item = itm;
                                <li title="@(_collapsed ? item.Title : null)">
                                    <a href="@item.Url"
                                       class="@Cn.Merge("flex items-center rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", _collapsed ? "justify-center" : "gap-2")">
                                        <LucideIconCn Name="@item.Icon" Size="16" Class="size-4 shrink-0" />
                                        @if (!_collapsed)
                                        {
                                            <span>@item.Title</span>
                                        }
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                @* Sidebar Rail (collapse toggle) *@
                <div class="flex items-center justify-center border-t py-2">
                    <button type="button"
                            class="flex size-8 items-center justify-center rounded-md hover:bg-sidebar-accent hover:text-sidebar-accent-foreground"
                            @onclick="ToggleCollapsed">
                        <LucideIconCn Name="@(_collapsed ? "panel-left-open" : "panel-left-close")" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                </div>
            </div>

            @* Main Content (SidebarInset) *@
            <div class="flex min-w-0 flex-1 flex-col">
                @* Header *@
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <button type="button"
                            class="-ml-1 flex size-8 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground"
                            @onclick="ToggleCollapsed">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Navigation</a>
                            </li>
                            <li class="hidden md:flex [&>svg]:size-3.5 [&>svg]:text-muted-foreground/70">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 text-muted-foreground/70" />
                            </li>
                            <li class="flex items-center">
                                <span role="link" aria-disabled="true" aria-current="page" class="font-normal text-foreground">Inbox</span>
                            </li>
                        </ol>
                    </nav>
                </header>

                @* Body *@
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record NavItem(string Title, string Icon, string Url, bool IsActive = false);

    private static readonly NavItem[] _mainItems =
    [
        new("Home", "home", "#"),
        new("Inbox", "inbox", "#", true),
        new("Messages", "message-square", "#"),
        new("Calendar", "calendar", "#"),
    ];

    private static readonly NavItem[] _workspaceItems =
    [
        new("Projects", "folder", "#"),
        new("Team", "users", "#"),
        new("Analytics", "bar-chart-3", "#"),
        new("Settings", "settings", "#"),
    ];

    private bool _collapsed = false;

    private void ToggleCollapsed() => _collapsed = !_collapsed;
}
