@* ============================================================
   Block: sidebar-with-input-filter
   Title: SidebarWithInputFilter
   Description: A React sidebar with search input in the header that filters navigation items in real time using React useState. Built with Next.js, shadcn/ui Sidebar and Input, and Tailwind CSS.
   Source: original/blocks/sidebar/sidebar-with-input-filter.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <SidebarProviderCn Class="h-[700px] !min-h-0">
            <SidebarCn Class="border-r">
                <SidebarHeaderCn>
                    <SidebarMenuCn>
                        <SidebarMenuItemCn>
                            <SidebarMenuButtonCn Size="SidebarMenuButtonSize.Lg" Href="#">
                                <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                                    <LucideIconCn Name="gallery-vertical-end" Size="16" Class="size-4" />
                                </div>
                                <div class="flex flex-col gap-0.5 leading-none">
                                    <span class="font-medium">Admin Panel</span>
                                    <span class="">Workspace</span>
                                </div>
                            </SidebarMenuButtonCn>
                        </SidebarMenuItemCn>
                    </SidebarMenuCn>
                    <div class="px-2 pb-2">
                        <div class="relative">
                            <LucideIconCn Name="search" Size="16" Class="pointer-events-none absolute left-2.5 top-1/2 size-4 -translate-y-1/2 text-muted-foreground" />
                            <InputCn @bind-Value="_query" Placeholder="Filter navigation..." Class="h-8 pl-8 text-sm" />
                        </div>
                    </div>
                </SidebarHeaderCn>
                <SidebarContentCn>
                    @foreach (var grp in FilteredGroups)
                    {
                        <SidebarGroupCn>
                            <SidebarGroupLabelCn>@grp.Title</SidebarGroupLabelCn>
                            <SidebarGroupContentCn>
                                <SidebarMenuCn>
                                    @foreach (var item in grp.Items)
                                    {
                                        <SidebarMenuItemCn>
                                            <SidebarMenuButtonCn Href="@item.Url" IsActive="@item.IsActive">
                                                <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                                <span>@item.Title</span>
                                            </SidebarMenuButtonCn>
                                        </SidebarMenuItemCn>
                                    }
                                </SidebarMenuCn>
                            </SidebarGroupContentCn>
                        </SidebarGroupCn>
                    }
                    @if (!FilteredGroups.Any())
                    {
                        <div class="px-4 py-6 text-center text-sm text-muted-foreground">
                            No results found
                        </div>
                    }
                </SidebarContentCn>
                <SidebarRailCn />
            </SidebarCn>

            <SidebarInsetCn Class="min-w-0 flex-1">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <SidebarTriggerCn Class="-ml-1" />
                    <div class="mr-2 w-px self-stretch bg-border data-[orientation=vertical]:h-4" data-orientation="vertical"></div>
                    <nav aria-label="Breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground break-words sm:gap-2.5">
                            <li class="hidden md:block">
                                <a href="#" class="transition-colors hover:text-foreground">Section</a>
                            </li>
                            <li role="presentation" aria-hidden="true" class="hidden md:block [&>svg]:size-3.5">
                                <LucideIconCn Name="chevron-right" Size="14" />
                            </li>
                            <li>
                                <span role="link" aria-current="page" class="font-normal text-foreground">Page</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </SidebarInsetCn>
        </SidebarProviderCn>
    </div>
</section>

@code {
    private string _query = "";

    private record NavItem(string Title, string Url, string Icon, bool IsActive = false);
    private record NavGroup(string Title, NavItem[] Items);

    private static readonly NavGroup[] _navGroups =
    [
        new("Main",
        [
            new("Dashboard", "#", "layout-dashboard", IsActive: true),
            new("Analytics", "#", "bar-chart-3"),
            new("Reports", "#", "file-text"),
        ]),
        new("Management",
        [
            new("Users", "#", "users"),
            new("Products", "#", "package"),
            new("Orders", "#", "box"),
            new("Inventory", "#", "wrench"),
        ]),
        new("System",
        [
            new("Settings", "#", "settings"),
            new("Security", "#", "shield"),
            new("Documentation", "#", "book-open"),
        ]),
    ];

    private IEnumerable<NavGroup> FilteredGroups =>
        _navGroups
            .Select(g => new NavGroup(g.Title,
                g.Items.Where(i => i.Title.Contains(_query, StringComparison.OrdinalIgnoreCase)).ToArray()))
            .Where(g => g.Items.Length > 0);
}
