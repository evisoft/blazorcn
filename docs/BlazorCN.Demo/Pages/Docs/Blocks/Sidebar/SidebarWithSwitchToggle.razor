@* ============================================================
   Block: sidebar-with-switch-toggle
   Title: SidebarWithSwitchToggle
   Description: A React sidebar with Switch toggle controls for enabling/disabling features. Built with Next.js, TypeScript, shadcn/ui Sidebar and Switch components, Tailwind CSS.
   Source: original/blocks/sidebar/sidebar-with-switch-toggle.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <SidebarProviderCn Class="h-[700px] !min-h-0">
            <SidebarCn Class="border-r">
                <SidebarHeaderCn>
                    <SidebarMenuCn>
                        <SidebarMenuItemCn>
                            <SidebarMenuButtonCn Size="SidebarMenuButtonSize.Lg" Href="#">
                                <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                                    <LucideIconCn Name="gallery-vertical-end" Size="16" Class="size-4" />
                                </div>
                                <div class="flex flex-col gap-0.5 leading-none">
                                    <span class="font-medium">Preferences</span>
                                    <span class="">Settings</span>
                                </div>
                            </SidebarMenuButtonCn>
                        </SidebarMenuItemCn>
                    </SidebarMenuCn>
                </SidebarHeaderCn>
                <SidebarContentCn>
                    <SidebarGroupCn>
                        <SidebarGroupLabelCn>General</SidebarGroupLabelCn>
                        <SidebarGroupContentCn>
                            <SidebarMenuCn>
                                @foreach (var toggle in _generalToggles)
                                {
                                    var key = toggle.Key;
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn Class="flex items-center justify-between">
                                            <span class="flex items-center gap-2">
                                                <LucideIconCn Name="@toggle.Icon" Size="16" Class="size-4" />
                                                <span>@toggle.Title</span>
                                            </span>
                                            <SwitchCn Checked="@_toggles[key]"
                                                      CheckedChanged="@((bool v) => HandleToggle(key, v))" />
                                        </SidebarMenuButtonCn>
                                    </SidebarMenuItemCn>
                                }
                            </SidebarMenuCn>
                        </SidebarGroupContentCn>
                    </SidebarGroupCn>

                    <SidebarGroupCn>
                        <SidebarGroupLabelCn>Notifications</SidebarGroupLabelCn>
                        <SidebarGroupContentCn>
                            <SidebarMenuCn>
                                @foreach (var toggle in _notificationToggles)
                                {
                                    var key = toggle.Key;
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn Class="flex items-center justify-between">
                                            <span class="flex items-center gap-2">
                                                <LucideIconCn Name="@toggle.Icon" Size="16" Class="size-4" />
                                                <span>@toggle.Title</span>
                                            </span>
                                            <SwitchCn Checked="@_toggles[key]"
                                                      CheckedChanged="@((bool v) => HandleToggle(key, v))" />
                                        </SidebarMenuButtonCn>
                                    </SidebarMenuItemCn>
                                }
                            </SidebarMenuCn>
                        </SidebarGroupContentCn>
                    </SidebarGroupCn>
                </SidebarContentCn>
                <SidebarRailCn />
            </SidebarCn>

            <SidebarInsetCn Class="min-w-0 flex-1">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <SidebarTriggerCn Class="-ml-1" />
                    <div class="mr-2 w-px self-stretch bg-border data-[orientation=vertical]:h-4" data-orientation="vertical"></div>
                    <nav aria-label="Breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground break-words sm:gap-2.5">
                            <li class="hidden md:block">
                                <a href="#" class="transition-colors hover:text-foreground">Section</a>
                            </li>
                            <li role="presentation" aria-hidden="true" class="hidden md:block [&>svg]:size-3.5">
                                <LucideIconCn Name="chevron-right" Size="14" />
                            </li>
                            <li>
                                <span role="link" aria-current="page" class="font-normal text-foreground">Page</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </SidebarInsetCn>
        </SidebarProviderCn>
    </div>
</section>

@code {
    private record ToggleItem(string Title, string Icon, string Key, bool DefaultChecked);

    private static readonly ToggleItem[] _generalToggles =
    [
        new("Dark Mode", "moon", "darkMode", true),
        new("Auto-Save", "save", "autoSave", true),
        new("Desktop App", "monitor", "desktopApp", false),
        new("Public Profile", "globe", "publicProfile", true),
        new("Two-Factor Auth", "shield", "twoFactor", false),
    ];

    private static readonly ToggleItem[] _notificationToggles =
    [
        new("Email Alerts", "mail", "emailAlerts", true),
        new("Push Notifications", "bell", "pushNotifications", true),
        new("SMS Alerts", "smartphone", "smsAlerts", false),
        new("Sound Effects", "volume-2", "soundEffects", false),
    ];

    private Dictionary<string, bool> _toggles = new();

    protected override void OnInitialized()
    {
        foreach (var item in _generalToggles)
            _toggles[item.Key] = item.DefaultChecked;
        foreach (var item in _notificationToggles)
            _toggles[item.Key] = item.DefaultChecked;
    }

    private void HandleToggle(string key, bool value)
    {
        _toggles[key] = value;
    }
}
