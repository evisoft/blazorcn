@* ============================================================
   Block: sidebar-admin-panel
   Title: SidebarAdminPanel
   Description: A React admin panel sidebar with logo header, grouped navigation, and user dropdown footer. Built with Next.js, shadcn/ui Sidebar and DropdownMenu, and Tailwind CSS for management consoles.
   Source: original/blocks/sidebar/sidebar-admin-panel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px]">

            @* ── Sidebar ── *@
            <aside class="flex w-64 shrink-0 flex-col border-r bg-sidebar text-sidebar-foreground">

                @* Sidebar Header *@
                <div class="flex h-16 items-center border-b px-4">
                    <a href="#" class="flex items-center gap-3 rounded-md px-2 py-2 text-sm font-medium hover:bg-sidebar-accent hover:text-sidebar-accent-foreground w-full">
                        <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                            <LucideIconCn Name="shield-check" Size="16" Class="size-4" />
                        </div>
                        <div class="flex flex-col gap-0.5 leading-none">
                            <span class="font-medium">Admin Panel</span>
                            <span class="text-xs text-muted-foreground">Management Console</span>
                        </div>
                    </a>
                </div>

                @* Sidebar Content — nav groups *@
                <div class="flex-1 overflow-y-auto py-2">
                    @foreach (var grp in _navGroups)
                    {
                        <div class="px-2 py-2">
                            <p class="mb-1 px-2 text-xs font-medium text-muted-foreground">@grp.Title</p>
                            <ul class="space-y-0.5">
                                @foreach (var item in grp.Items)
                                {
                                    <li>
                                        <a href="@item.Url"
                                           class="@Cn.Merge("flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", item.IsActive ? "bg-sidebar-accent text-sidebar-accent-foreground font-medium" : "")">
                                            <LucideIconCn Name="@item.Icon" Size="16" Class="size-4 shrink-0" />
                                            <span>@item.Title</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>

                @* Sidebar Footer — user dropdown *@
                <div class="border-t px-2 py-2">
                    <div class="relative">
                        <button type="button"
                                class="data-[state=open]:bg-sidebar-accent data-[state=open]:text-sidebar-accent-foreground flex w-full items-center gap-3 rounded-md px-2 py-2 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground"
                                @onclick="ToggleUserMenu">
                            <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-muted">
                                <LucideIconCn Name="user" Size="16" Class="size-4" />
                            </div>
                            <div class="flex flex-col gap-0.5 leading-none">
                                <span class="font-medium text-sm">Sarah Chen</span>
                                <span class="text-xs text-muted-foreground">Administrator</span>
                            </div>
                            <LucideIconCn Name="chevrons-up-down" Size="16" Class="ml-auto size-4" />
                        </button>

                        @if (_userMenuOpen)
                        {
                            <div class="absolute bottom-full left-0 mb-1 w-56 min-w-56 rounded-md border bg-popover p-1 shadow-md z-50">
                                <p class="px-2 py-1.5 text-xs text-muted-foreground">sarah@@acme.com</p>
                                <div class="my-1 h-px bg-border"></div>
                                <button type="button" class="flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-sm hover:bg-accent hover:text-accent-foreground">
                                    <LucideIconCn Name="user" Size="16" Class="mr-2 size-4" />
                                    Account Settings
                                </button>
                                <button type="button" class="flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-sm hover:bg-accent hover:text-accent-foreground">
                                    <LucideIconCn Name="settings" Size="16" Class="mr-2 size-4" />
                                    Preferences
                                </button>
                                <div class="my-1 h-px bg-border"></div>
                                <button type="button" class="flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-sm hover:bg-accent hover:text-accent-foreground">
                                    <LucideIconCn Name="log-out" Size="16" Class="mr-2 size-4" />
                                    Sign Out
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </aside>

            @* ── Main content (SidebarInset) ── *@
            <div class="min-w-0 flex-1 flex flex-col">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    @* Sidebar trigger button *@
                    <button type="button" class="-ml-1 flex size-7 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    <div class="mx-2 h-4 w-px bg-border"></div>
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center gap-1.5 md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Section</a>
                            </li>
                            <li class="hidden items-center gap-1.5 [&>svg]:hidden md:flex">
                                <LucideIconCn Name="chevron-right" Size="16" Class="size-3.5" />
                            </li>
                            <li class="flex items-center gap-1.5">
                                <span class="font-normal text-foreground">Page</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private record NavItem(string Title, string Url, string Icon, bool IsActive = false);
    private record NavGroup(string Title, NavItem[] Items);

    private static readonly NavGroup[] _navGroups =
    [
        new("Main",
        [
            new("Dashboard", "#", "layout-dashboard", true),
            new("Users",     "#", "users"),
            new("Roles",     "#", "shield"),
            new("Permissions", "#", "shield-check"),
        ]),
        new("Content",
        [
            new("Pages", "#", "file-text"),
            new("Media", "#", "image"),
            new("Files", "#", "folder"),
        ]),
        new("System",
        [
            new("Settings", "#", "settings"),
            new("Logs",     "#", "scroll-text"),
            new("Backups",  "#", "database"),
        ]),
    ];

    private bool _userMenuOpen = false;

    private void ToggleUserMenu()
    {
        _userMenuOpen = !_userMenuOpen;
    }
}
