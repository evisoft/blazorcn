@* ============================================================
   Block: sidebar-sticky-header
   Title: SidebarStickyHeader
   Description: A React sidebar layout with sticky content header that stays fixed while scrolling, built with Next.js, shadcn/ui Sidebar components, and Tailwind CSS
   Source: original/blocks/sidebar/sidebar-sticky-header.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <SidebarProviderCn Class="h-[700px] !min-h-0">
            <SidebarCn Class="border-r">
                <SidebarHeaderCn>
                    <SidebarMenuCn>
                        <SidebarMenuItemCn>
                            <SidebarMenuButtonCn Size="SidebarMenuButtonSize.Lg" Href="#">
                                <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                                    <LucideIconCn Name="gallery-vertical-end" Size="16" Class="size-4" />
                                </div>
                                <div class="flex flex-col gap-0.5 leading-none">
                                    <span class="font-medium">Commerce</span>
                                    <span class="">Store admin</span>
                                </div>
                            </SidebarMenuButtonCn>
                        </SidebarMenuItemCn>
                    </SidebarMenuCn>
                </SidebarHeaderCn>
                <SidebarContentCn>
                    <SidebarGroupCn>
                        <SidebarGroupLabelCn>Store</SidebarGroupLabelCn>
                        <SidebarGroupContentCn>
                            <SidebarMenuCn>
                                @foreach (var item in _navItems)
                                {
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn Href="@item.Url" IsActive="@item.IsActive">
                                            <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                            <span>@item.Title</span>
                                        </SidebarMenuButtonCn>
                                    </SidebarMenuItemCn>
                                }
                            </SidebarMenuCn>
                        </SidebarGroupContentCn>
                    </SidebarGroupCn>
                </SidebarContentCn>
                <SidebarRailCn />
            </SidebarCn>

            <SidebarInsetCn Class="min-w-0 flex-1 overflow-y-auto">
                <header class="sticky top-0 z-10 flex h-16 shrink-0 items-center gap-2 border-b bg-background px-4">
                    <SidebarTriggerCn Class="-ml-1" />
                    <div class="mr-2 w-px self-stretch bg-border" data-orientation="vertical"></div>
                    <nav aria-label="Breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground break-words sm:gap-2.5">
                            <li class="hidden md:block">
                                <a href="#" class="transition-colors hover:text-foreground">Store</a>
                            </li>
                            <li role="presentation" aria-hidden="true" class="hidden md:block [&>svg]:size-3.5">
                                <LucideIconCn Name="chevron-right" Size="14" />
                            </li>
                            <li>
                                <span role="link" aria-current="page" class="font-normal text-foreground">Overview</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="h-48 rounded-xl bg-muted/50"></div>
                    <div class="grid auto-rows-min gap-4 md:grid-cols-2">
                        <div class="h-40 rounded-xl bg-muted/50"></div>
                        <div class="h-40 rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="h-48 rounded-xl bg-muted/50"></div>
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="h-32 rounded-xl bg-muted/50"></div>
                        <div class="h-32 rounded-xl bg-muted/50"></div>
                        <div class="h-32 rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="h-48 rounded-xl bg-muted/50"></div>
                    <div class="h-40 rounded-xl bg-muted/50"></div>
                </div>
            </SidebarInsetCn>
        </SidebarProviderCn>
    </div>
</section>

@code {
    private record NavItem(string Title, string Url, string Icon, bool IsActive = false);

    private static readonly NavItem[] _navItems =
    [
        new("Overview", "#", "layout-dashboard", IsActive: true),
        new("Analytics", "#", "bar-chart-3"),
        new("Products", "#", "package"),
        new("Orders", "#", "shopping-cart"),
        new("Customers", "#", "users"),
        new("Categories", "#", "tag"),
        new("Inventory", "#", "list"),
    ];
}
