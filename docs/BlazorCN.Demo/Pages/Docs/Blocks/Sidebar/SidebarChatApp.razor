@* ============================================================
   Block: sidebar-chat-app
   Title: SidebarChatApp
   Description: React chat sidebar with channels, direct messages, and online status indicators using Next.js, shadcn/ui Sidebar, and Tailwind CSS. Features searchable conversations with unread badges.
   Source: original/blocks/sidebar/sidebar-chat-app.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px]">
            @* Sidebar *@
            <aside class="flex w-64 shrink-0 flex-col border-r bg-sidebar text-sidebar-foreground">
                @* SidebarHeader *@
                <div class="flex flex-col gap-2 p-2">
                    <ul class="flex w-full min-w-0 flex-col gap-1">
                        <li class="group/menu-item relative">
                            <a href="#"
                               class="flex w-full items-center gap-2 overflow-hidden rounded-md p-2 text-left text-sm outline-none transition-[width,height,padding] hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-2 active:bg-sidebar-accent active:text-sidebar-accent-foreground h-12 text-sm">
                                <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                                    <LucideIconCn Name="message-circle" Size="16" Class="size-4" />
                                </div>
                                <div class="flex flex-col gap-0.5 leading-none">
                                    <span class="font-medium">Messenger</span>
                                    <span class="text-xs text-muted-foreground">Workspace</span>
                                </div>
                            </a>
                        </li>
                    </ul>
                    <div class="px-2 pb-1">
                        <div class="relative">
                            <LucideIconCn Name="search" Size="16" Class="-translate-y-1/2 absolute top-1/2 left-2.5 size-4 text-muted-foreground" />
                            <input
                                placeholder="Search conversations..."
                                aria-label="Search conversations"
                                class="h-8 w-full rounded-md border-0 bg-muted/50 pl-8 shadow-none text-sm outline-none focus-visible:ring-0 placeholder:text-muted-foreground" />
                        </div>
                    </div>
                </div>

                @* SidebarContent *@
                <div class="flex min-h-0 flex-1 flex-col gap-2 overflow-auto px-2 pb-2">

                    @* Channels Group *@
                    <div class="relative flex w-full flex-col">
                        <div class="flex h-8 shrink-0 items-center rounded-md px-2 text-xs font-medium text-sidebar-foreground/70 outline-none ring-sidebar-ring transition-[margin,opacity] duration-200 ease-linear focus-visible:ring-2">
                            Channels
                        </div>
                        <div class="w-full text-sm">
                            <ul class="flex w-full min-w-0 flex-col gap-1">
                                @foreach (var ch in _channels)
                                {
                                    var channel = ch;
                                    <li class="group/menu-item relative">
                                        <a href="@channel.Url"
                                           class="@Cn.Merge("flex w-full items-center gap-2 overflow-hidden rounded-md p-2 text-left text-sm outline-none transition-[width,height,padding] hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-2 active:bg-sidebar-accent active:text-sidebar-accent-foreground h-8", channel.IsActive ? "bg-sidebar-accent font-medium text-sidebar-accent-foreground" : "")">
                                            <LucideIconCn Name="hash" Size="16" Class="size-4 text-muted-foreground" />
                                            <span class="@(channel.Unread > 0 ? "font-medium" : "")">@channel.Title</span>
                                        </a>
                                        @if (channel.Unread > 0)
                                        {
                                            <div class="absolute right-1 top-1/2 -translate-y-1/2 flex h-5 min-w-5 items-center justify-center rounded-full bg-sidebar-primary px-1 text-[10px] font-medium tabular-nums text-sidebar-primary-foreground select-none pointer-events-none">
                                                @channel.Unread
                                            </div>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                    @* Direct Messages Group *@
                    <div class="relative flex w-full flex-col">
                        <div class="flex h-8 shrink-0 items-center rounded-md px-2 text-xs font-medium text-sidebar-foreground/70 outline-none ring-sidebar-ring transition-[margin,opacity] duration-200 ease-linear focus-visible:ring-2">
                            Direct Messages
                        </div>
                        <div class="w-full text-sm">
                            <ul class="flex w-full min-w-0 flex-col gap-1">
                                @foreach (var dm in _directMessages)
                                {
                                    var person = dm;
                                    <li class="group/menu-item relative">
                                        <a href="@person.Url"
                                           class="flex w-full items-center gap-2 overflow-hidden rounded-md p-2 text-left text-sm outline-none transition-[width,height,padding] hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-2 active:bg-sidebar-accent active:text-sidebar-accent-foreground h-8 flex items-center gap-3">
                                            <span class="relative flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">
                                                @GetInitials(person.Name)
                                                <span class="@Cn.Merge("absolute -right-0.5 -bottom-0.5 size-2 rounded-full border border-sidebar", GetStatusColor(person.Status))"></span>
                                            </span>
                                            <span>@person.Name</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                </div>

                @* SidebarRail *@
                <button type="button" aria-label="Toggle Sidebar"
                        class="absolute inset-y-0 z-20 hidden w-4 -translate-x-1/2 transition-all ease-linear after:absolute after:inset-y-0 after:left-1/2 after:w-[2px] hover:after:bg-sidebar-border group-data-[side=left]:-right-4 sm:flex"></button>
            </aside>

            @* SidebarInset *@
            <div class="relative flex min-h-svh min-w-0 flex-1 flex-col bg-background">
                @* Header *@
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    @* SidebarTrigger *@
                    <button type="button"
                            class="-ml-1 inline-flex size-7 shrink-0 items-center justify-center gap-2 rounded-md p-0 text-sm font-medium text-sidebar-foreground/70 outline-none ring-sidebar-ring transition-transform hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-2">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    @* Vertical separator *@
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center gap-1.5 md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Section</a>
                            </li>
                            <li class="hidden md:block" aria-hidden="true" role="presentation">
                                <LucideIconCn Name="chevron-right" Size="16" Class="size-3.5" />
                            </li>
                            <li class="flex items-center gap-1.5">
                                <span role="link" aria-disabled="true" aria-current="page" class="font-normal text-foreground">Page</span>
                            </li>
                        </ol>
                    </nav>
                </header>

                @* Main content *@
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Channel(string Title, string Url, int Unread, bool IsActive = false);
    private record DirectMessage(string Name, string Status, string Url);

    private static readonly Channel[] _channels =
    [
        new("general", "#", 3, true),
        new("engineering", "#", 0),
        new("design", "#", 12),
        new("product", "#", 0),
        new("marketing", "#", 1),
        new("random", "#", 0),
    ];

    private static readonly DirectMessage[] _directMessages =
    [
        new("Sarah Chen", "online", "#"),
        new("Marcus Rivera", "online", "#"),
        new("Emma Wilson", "offline", "#"),
        new("James Kim", "online", "#"),
        new("Olivia Brown", "away", "#"),
        new("Liam Patel", "offline", "#"),
        new("Ava Johnson", "online", "#"),
    ];

    private static string GetStatusColor(string status) => status switch
    {
        "online" => "bg-emerald-500",
        "away" => "bg-amber-500",
        _ => "bg-zinc-300 dark:bg-zinc-600",
    };

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ');
        var result = "";
        foreach (var part in parts)
        {
            if (part.Length > 0)
                result += part[0];
        }
        return result;
    }
}
