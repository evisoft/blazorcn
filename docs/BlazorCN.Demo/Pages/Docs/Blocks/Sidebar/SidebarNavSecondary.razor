@* ============================================================
   Block: sidebar-nav-secondary
   Title: SidebarNavSecondary
   Description: React sidebar with primary nav at top and secondary links at bottom using Tailwind mt-auto. Built with Next.js, shadcn/ui Sidebar components, and Tailwind CSS.
   Source: original/blocks/sidebar/sidebar-nav-secondary.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px] w-full bg-sidebar/50">

            @* Sidebar *@
            <div class="flex w-64 shrink-0 flex-col border-r bg-sidebar">

                @* Sidebar Header *@
                <div class="flex h-16 items-center px-4 py-2">
                    <a href="#" class="flex items-center gap-3 rounded-md px-2 py-2 text-sm font-medium hover:bg-sidebar-accent hover:text-sidebar-accent-foreground w-full">
                        <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                            <LucideIconCn Name="gallery-vertical-end" Size="16" Class="size-4" />
                        </div>
                        <div class="flex flex-col gap-0.5 leading-none">
                            <span class="font-medium">Acme Corp</span>
                            <span class="">Workspace</span>
                        </div>
                    </a>
                </div>

                @* Sidebar Content *@
                <div class="flex flex-1 flex-col overflow-y-auto px-2 py-2">

                    @* Primary Navigation Group *@
                    <div class="mb-2">
                        <div class="flex items-center px-2 py-1.5 text-xs font-medium text-sidebar-foreground/70">
                            Navigation
                        </div>
                        <ul class="space-y-0.5">
                            @foreach (var navItem in _primaryNav)
                            {
                                var isActive = navItem.IsActive;
                                <li>
                                    <a href="@navItem.Url"
                                       class="@Cn.Merge("flex items-center gap-2 rounded-md px-2 py-1.5 text-sm text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", isActive ? "bg-sidebar-accent font-medium text-sidebar-accent-foreground" : "")">
                                        <LucideIconCn Name="@navItem.Icon" Size="16" Class="size-4" />
                                        <span>@navItem.Title</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    @* Secondary Navigation Group — pushed to bottom with mt-auto *@
                    <div class="mt-auto">
                        <ul class="space-y-0.5">
                            @foreach (var navItem in _secondaryNav)
                            {
                                <li>
                                    <a href="@navItem.Url"
                                       class="flex items-center gap-2 rounded-md px-2 py-1 text-xs text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                                        <LucideIconCn Name="@navItem.Icon" Size="16" Class="size-4" />
                                        <span>@navItem.Title</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                </div>

                @* Sidebar Rail *@
                <div class="absolute inset-y-0 right-0 hidden w-px translate-x-px bg-sidebar-border group-data-[side=left]/sidebar-wrapper:block"></div>

            </div>

            @* Main Content (SidebarInset) *@
            <div class="flex min-w-0 flex-1 flex-col">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    @* Sidebar trigger button *@
                    <button type="button" class="-ml-1 flex size-7 items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Navigation</a>
                            </li>
                            <li class="hidden md:flex" aria-hidden="true">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                            </li>
                            <li class="flex items-center">
                                <span role="link" aria-current="page" aria-disabled="true" class="font-normal text-foreground">Dashboard</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private record NavItem(string Title, string Url, string Icon, bool IsActive = false);

    private static readonly NavItem[] _primaryNav =
    [
        new("Dashboard", "#", "bar-chart-3", true),
        new("Projects", "#", "folder"),
        new("Documents", "#", "file-text"),
        new("Team", "#", "users"),
        new("Settings", "#", "settings"),
    ];

    private static readonly NavItem[] _secondaryNav =
    [
        new("Support", "#", "life-buoy"),
        new("Feedback", "#", "message-square"),
    ];
}
