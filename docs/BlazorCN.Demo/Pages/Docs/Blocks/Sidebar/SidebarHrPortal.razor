@* ============================================================
   Block: sidebar-hr-portal
   Title: SidebarHrPortal
   Description: React HR management sidebar with people directory, recruitment pipeline, and admin sections for payroll, benefits, and compliance. Built with Next.js, shadcn/ui Sidebar, Tailwind CSS.
   Source: original/blocks/sidebar/sidebar-hr-portal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px]">

            @* ── Sidebar ── *@
            <aside class="flex w-64 shrink-0 flex-col border-r bg-sidebar text-sidebar-foreground">

                @* Sidebar Header *@
                <div class="flex h-16 items-center border-b px-4">
                    <a href="#" class="flex items-center gap-3 rounded-md px-2 py-2 text-sm font-medium hover:bg-sidebar-accent hover:text-sidebar-accent-foreground w-full">
                        <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                            <LucideIconCn Name="user-round" Size="16" Class="size-4" />
                        </div>
                        <div class="flex flex-col gap-0.5 leading-none">
                            <span class="font-medium">HR Portal</span>
                            <span class="">People Operations</span>
                        </div>
                    </a>
                </div>

                @* Sidebar Content *@
                <div class="flex-1 overflow-y-auto py-2">

                    @* People group *@
                    <div class="px-2 py-2">
                        <p class="mb-1 px-2 text-xs font-medium text-muted-foreground">People</p>
                        <ul class="space-y-0.5">
                            @foreach (var item in _people)
                            {
                                <li>
                                    <a href="@item.Url"
                                       class="@Cn.Merge("flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", item.IsActive ? "bg-sidebar-accent text-sidebar-accent-foreground font-medium" : "")">
                                        <LucideIconCn Name="@item.Icon" Size="16" Class="size-4 shrink-0" />
                                        <span>@item.Title</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    @* Recruitment group *@
                    <div class="px-2 py-2">
                        <p class="mb-1 px-2 text-xs font-medium text-muted-foreground">Recruitment</p>
                        <ul class="space-y-0.5">
                            @foreach (var item in _recruitment)
                            {
                                <li>
                                    <a href="@item.Url"
                                       class="@Cn.Merge("flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", item.IsActive ? "bg-sidebar-accent text-sidebar-accent-foreground font-medium" : "")">
                                        <LucideIconCn Name="@item.Icon" Size="16" Class="size-4 shrink-0" />
                                        <span>@item.Title</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    @* Admin group *@
                    <div class="px-2 py-2">
                        <p class="mb-1 px-2 text-xs font-medium text-muted-foreground">Admin</p>
                        <ul class="space-y-0.5">
                            @foreach (var item in _admin)
                            {
                                <li>
                                    <a href="@item.Url"
                                       class="@Cn.Merge("flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", item.IsActive ? "bg-sidebar-accent text-sidebar-accent-foreground font-medium" : "")">
                                        <LucideIconCn Name="@item.Icon" Size="16" Class="size-4 shrink-0" />
                                        <span>@item.Title</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                </div>

                @* Sidebar Rail (decorative resize handle) *@
                <div class="absolute inset-y-0 right-0 hidden w-px translate-x-0 cursor-col-resize select-none bg-sidebar-border transition-colors after:absolute after:inset-y-0 after:left-1/2 after:w-1 after:-translate-x-1/2 group-data-[side=left]:-right-2 group-data-[side=right]:-left-2 sm:flex"></div>

            </aside>

            @* ── Main content (SidebarInset) ── *@
            <div class="min-w-0 flex-1 flex flex-col">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    @* Sidebar trigger button *@
                    <button type="button" class="-ml-1 flex size-7 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    <div class="mx-2 h-4 w-px bg-border"></div>
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center gap-1.5 md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Section</a>
                            </li>
                            <li class="hidden items-center gap-1.5 [&>svg]:hidden md:flex">
                                <LucideIconCn Name="chevron-right" Size="16" Class="size-3.5" />
                            </li>
                            <li class="flex items-center gap-1.5">
                                <span class="font-normal text-foreground">Page</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private record NavItem(string Title, string Url, string Icon, bool IsActive = false);

    private static readonly NavItem[] _people =
    [
        new("Employees",   "#", "users",    true),
        new("Departments", "#", "building"),
        new("Teams",       "#", "network"),
    ];

    private static readonly NavItem[] _recruitment =
    [
        new("Job Openings", "#", "briefcase"),
        new("Applications", "#", "file-text"),
        new("Interviews",   "#", "calendar"),
    ];

    private static readonly NavItem[] _admin =
    [
        new("Payroll",    "#", "dollar-sign"),
        new("Benefits",   "#", "heart"),
        new("Compliance", "#", "shield-check"),
    ];
}
