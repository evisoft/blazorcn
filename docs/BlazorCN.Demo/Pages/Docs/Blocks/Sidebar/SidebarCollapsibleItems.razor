@* ============================================================
   Block: sidebar-collapsible-items
   Title: SidebarCollapsibleItems
   Description: A React sidebar with collapsible navigation items using Collapsible and SidebarMenuAction with ChevronRight rotation and expandable SidebarMenuSub children using Next.js, shadcn/ui Sidebar, and Tailwind CSS.
   Source: original/blocks/sidebar/sidebar-collapsible-items.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px]">
            @* Sidebar *@
            <div class="flex w-64 shrink-0 flex-col border-r bg-sidebar">
                @* Sidebar Header *@
                <div class="flex h-16 items-center border-b px-2">
                    <a href="#" class="flex w-full items-center gap-2 rounded-md p-2 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                        <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                            <LucideIconCn Name="gallery-vertical-end" Size="16" Class="size-4" />
                        </div>
                        <div class="flex flex-col gap-0.5 leading-none">
                            <span class="font-medium">Component Lib</span>
                            <span class="">v5.0.0</span>
                        </div>
                    </a>
                </div>

                @* Sidebar Content *@
                <div class="flex flex-1 flex-col gap-2 overflow-y-auto py-2">
                    <div class="px-2">
                        <span class="px-2 py-1 text-xs font-medium text-sidebar-foreground/60">Navigation</span>
                        <ul class="mt-1 space-y-0.5">
                            @foreach (var navItem in _navMain)
                            {
                                var item = navItem;
                                <li class="group/collapsible">
                                    <div class="relative flex items-center">
                                        <a href="#"
                                           class="flex flex-1 items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                                            <LucideIconCn Name="@item.Icon" Size="16" Class="size-4 shrink-0" />
                                            <span>@item.Title</span>
                                        </a>
                                        <button type="button"
                                                @onclick="@(() => Toggle(item.Title))"
                                                class="flex size-6 items-center justify-center rounded-md hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                                            <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 transition-transform duration-200", item.IsOpen ? "rotate-90" : "")" />
                                            <span class="sr-only">Toggle</span>
                                        </button>
                                    </div>
                                    @if (item.IsOpen)
                                    {
                                        <ul class="ml-4 mt-0.5 space-y-0.5 border-l border-sidebar-border pl-2">
                                            @foreach (var subItem in item.Items)
                                            {
                                                var sub = subItem;
                                                <li>
                                                    <a href="@sub.Url"
                                                       class="@Cn.Merge("flex items-center rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", sub.IsActive ? "bg-sidebar-accent text-sidebar-accent-foreground font-medium" : "")">
                                                        @sub.Title
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                @* Sidebar Rail *@
                <div class="absolute inset-y-0 right-0 w-px bg-border opacity-0 hover:opacity-100 cursor-col-resize"></div>
            </div>

            @* Main Content (SidebarInset) *@
            <div class="flex min-w-0 flex-1 flex-col">
                @* Header *@
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <button type="button" class="-ml-1 flex size-8 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Components</a>
                            </li>
                            <li class="hidden md:flex [&>svg]:size-3.5 [&>svg]:text-muted-foreground/70">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 text-muted-foreground/70" />
                            </li>
                            <li class="flex items-center">
                                <span role="link" aria-disabled="true" aria-current="page" class="font-normal text-foreground">Input</span>
                            </li>
                        </ol>
                    </nav>
                </header>

                @* Body *@
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record SubNavItem(string Title, string Url, bool IsActive = false);

    private class NavItem
    {
        public string Title { get; set; } = "";
        public string Icon { get; set; } = "";
        public bool IsOpen { get; set; }
        public SubNavItem[] Items { get; set; } = [];
    }

    private NavItem[] _navMain =
    [
        new NavItem
        {
            Title = "Components",
            Icon = "layers",
            IsOpen = true,
            Items =
            [
                new SubNavItem("Button", "#"),
                new SubNavItem("Input", "#", true),
                new SubNavItem("Select", "#"),
                new SubNavItem("Checkbox", "#"),
            ]
        },
        new NavItem
        {
            Title = "Layout",
            Icon = "code",
            IsOpen = false,
            Items =
            [
                new SubNavItem("Container", "#"),
                new SubNavItem("Grid", "#"),
                new SubNavItem("Stack", "#"),
            ]
        },
        new NavItem
        {
            Title = "Theming",
            Icon = "paintbrush",
            IsOpen = false,
            Items =
            [
                new SubNavItem("Colors", "#"),
                new SubNavItem("Typography", "#"),
                new SubNavItem("Spacing", "#"),
                new SubNavItem("Dark Mode", "#"),
            ]
        },
        new NavItem
        {
            Title = "Documentation",
            Icon = "file-text",
            IsOpen = false,
            Items =
            [
                new SubNavItem("Getting Started", "#"),
                new SubNavItem("Migration", "#"),
                new SubNavItem("Changelog", "#"),
            ]
        },
        new NavItem
        {
            Title = "Authentication",
            Icon = "shield",
            IsOpen = false,
            Items =
            [
                new SubNavItem("Sign In", "#"),
                new SubNavItem("Sign Up", "#"),
                new SubNavItem("Password Reset", "#"),
            ]
        },
        new NavItem
        {
            Title = "Configuration",
            Icon = "settings",
            IsOpen = false,
            Items =
            [
                new SubNavItem("General", "#"),
                new SubNavItem("Appearance", "#"),
                new SubNavItem("Integrations", "#"),
            ]
        },
    ];

    private void Toggle(string title)
    {
        var item = System.Array.Find(_navMain, n => n.Title == title);
        if (item != null)
        {
            item.IsOpen = !item.IsOpen;
        }
    }
}
