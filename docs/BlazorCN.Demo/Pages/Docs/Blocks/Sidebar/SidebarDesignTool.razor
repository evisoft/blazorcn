@* ============================================================
   Block: sidebar-design-tool
   Title: SidebarDesignTool
   Description: A React design tool sidebar with grouped navigation for tools, layers, and assets using Next.js, shadcn/ui Sidebar components, and Tailwind CSS.
   Source: original/blocks/sidebar/sidebar-design-tool.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px]">
            @* Sidebar *@
            <aside class="flex w-64 shrink-0 flex-col border-r bg-sidebar text-sidebar-foreground">
                @* SidebarHeader *@
                <div class="flex flex-col gap-2 p-2">
                    <ul class="flex w-full min-w-0 flex-col gap-1">
                        <li class="group/menu-item relative">
                            <a href="#"
                               class="flex w-full items-center gap-2 overflow-hidden rounded-md p-2 text-left text-sm outline-none transition-[width,height,padding] hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-2 active:bg-sidebar-accent active:text-sidebar-accent-foreground h-12 text-sm">
                                <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                                    <LucideIconCn Name="pen-tool" Size="16" Class="size-4" />
                                </div>
                                <div class="flex flex-col gap-0.5 leading-none">
                                    <span class="font-medium">Design Studio</span>
                                    <span class="text-xs text-muted-foreground">Untitled Project</span>
                                </div>
                            </a>
                        </li>
                    </ul>
                </div>

                @* SidebarContent *@
                <div class="flex min-h-0 flex-1 flex-col gap-2 overflow-auto px-2 pb-2">

                    @* Tools Group *@
                    <div class="relative flex w-full flex-col">
                        <div class="flex h-8 shrink-0 items-center rounded-md px-2 text-xs font-medium text-sidebar-foreground/70 outline-none ring-sidebar-ring transition-[margin,opacity] duration-200 ease-linear focus-visible:ring-2">
                            Tools
                        </div>
                        <div class="w-full text-sm">
                            <ul class="flex w-full min-w-0 flex-col gap-1">
                                @foreach (var tool in _tools)
                                {
                                    var t = tool;
                                    <li class="group/menu-item relative">
                                        <button type="button"
                                                class="@Cn.Merge("flex w-full items-center gap-2 overflow-hidden rounded-md p-2 text-left text-sm outline-none transition-[width,height,padding] hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-2 active:bg-sidebar-accent active:text-sidebar-accent-foreground h-8", t.IsActive ? "bg-sidebar-accent font-medium text-sidebar-accent-foreground" : "")">
                                            <LucideIconCn Name="@t.IconName" Size="16" Class="size-4" />
                                            <span>@t.Title</span>
                                            <span class="ml-auto font-mono text-[10px] text-muted-foreground">@t.Shortcut</span>
                                        </button>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                    @* Layers Group *@
                    <div class="relative flex w-full flex-col">
                        <div class="flex h-8 shrink-0 items-center rounded-md px-2 text-xs font-medium text-sidebar-foreground/70 outline-none ring-sidebar-ring transition-[margin,opacity] duration-200 ease-linear focus-visible:ring-2">
                            Layers
                        </div>
                        <div class="w-full text-sm">
                            <ul class="flex w-full min-w-0 flex-col gap-1">
                                @foreach (var layer in _layers)
                                {
                                    var lyr = layer;
                                    <li class="group/menu-item relative">
                                        <button type="button"
                                                class="@Cn.Merge("flex w-full items-center gap-2 overflow-hidden rounded-md p-2 text-left text-sm outline-none transition-[width,height,padding] hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-2 active:bg-sidebar-accent active:text-sidebar-accent-foreground h-8", lyr.Visible ? "" : "text-muted-foreground/50")">
                                            <LucideIconCn Name="@lyr.IconName" Size="16" Class="size-4" />
                                            <span>@lyr.Title</span>
                                        </button>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                    @* Assets Group *@
                    <div class="relative flex w-full flex-col">
                        <div class="flex h-8 shrink-0 items-center rounded-md px-2 text-xs font-medium text-sidebar-foreground/70 outline-none ring-sidebar-ring transition-[margin,opacity] duration-200 ease-linear focus-visible:ring-2">
                            Assets
                        </div>
                        <div class="w-full text-sm">
                            <ul class="flex w-full min-w-0 flex-col gap-1">
                                @foreach (var asset in _assets)
                                {
                                    var ast = asset;
                                    <li class="group/menu-item relative">
                                        <a href="#"
                                           class="flex w-full items-center gap-2 overflow-hidden rounded-md p-2 text-left text-sm outline-none transition-[width,height,padding] hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-2 active:bg-sidebar-accent active:text-sidebar-accent-foreground h-8">
                                            <LucideIconCn Name="@ast.IconName" Size="16" Class="size-4" />
                                            <span>@ast.Title</span>
                                            <span class="ml-auto text-muted-foreground text-xs">@ast.Count</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                </div>

                @* SidebarRail — thin hover strip *@
                <button type="button" aria-label="Toggle Sidebar"
                        class="absolute inset-y-0 z-20 hidden w-4 -translate-x-1/2 transition-all ease-linear after:absolute after:inset-y-0 after:left-1/2 after:w-[2px] hover:after:bg-sidebar-border group-data-[side=left]:-right-4 sm:flex"></button>
            </aside>

            @* SidebarInset *@
            <div class="relative flex min-h-svh min-w-0 flex-1 flex-col bg-background">
                @* Header *@
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    @* SidebarTrigger *@
                    <button type="button"
                            class="-ml-1 inline-flex size-7 shrink-0 items-center justify-center gap-2 rounded-md p-0 text-sm font-medium text-sidebar-foreground/70 outline-none ring-sidebar-ring transition-transform hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-2">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    @* Vertical separator *@
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center gap-1.5 md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Section</a>
                            </li>
                            <li class="hidden md:block" aria-hidden="true" role="presentation">
                                <LucideIconCn Name="chevron-right" Size="16" Class="size-3.5" />
                            </li>
                            <li class="flex items-center gap-1.5">
                                <span role="link" aria-disabled="true" aria-current="page" class="font-normal text-foreground">Page</span>
                            </li>
                        </ol>
                    </nav>
                </header>

                @* Main content *@
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record ToolItem(string Title, string IconName, string Shortcut, bool IsActive = false);
    private record LayerItem(string Title, string IconName, bool Visible);
    private record AssetItem(string Title, string IconName, int Count);

    private static readonly ToolItem[] _tools =
    [
        new("Select", "mouse-pointer", "V", true),
        new("Frame", "frame", "F"),
        new("Text", "type", "T"),
        new("Shape", "square", "R"),
        new("Pen", "pen-tool", "P"),
    ];

    private static readonly LayerItem[] _layers =
    [
        new("Header Section", "layers", true),
        new("Hero Image", "image", true),
        new("Navigation Bar", "layers", true),
        new("CTA Button", "box", true),
        new("Footer", "layers", false),
        new("Background", "circle", true),
    ];

    private static readonly AssetItem[] _assets =
    [
        new("Components", "component", 48),
        new("Icons", "box", 256),
        new("Colors", "palette", 12),
        new("Images", "image", 34),
    ];
}
