@* ============================================================
   Block: sidebar-floating-variant
   Title: SidebarFloatingVariant
   Description: React floating sidebar with shadow, rounded corners, and card-like detached panel design. Built with Next.js, shadcn/ui Sidebar components, and Tailwind CSS.
   Source: original/blocks/sidebar/sidebar-floating-variant.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px] w-full bg-sidebar/50">

            @* Floating Sidebar wrapper — adds padding so the sidebar appears detached *@
            <div class="p-2">
                <div class="flex h-full w-64 shrink-0 flex-col rounded-lg border bg-sidebar shadow-md">

                    @* Sidebar Header *@
                    <div class="flex h-16 items-center px-4 py-2">
                        <a href="#" class="flex items-center gap-3 rounded-md px-2 py-2 text-sm font-medium hover:bg-sidebar-accent hover:text-sidebar-accent-foreground w-full">
                            <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                                <LucideIconCn Name="command" Size="16" Class="size-4" />
                            </div>
                            <div class="flex flex-col gap-0.5 leading-none">
                                <span class="font-medium">Design System</span>
                                <span class="">v3.1.0</span>
                            </div>
                        </a>
                    </div>

                    @* Sidebar Content *@
                    <div class="flex-1 overflow-y-auto px-2 py-2">
                        @foreach (var grp in _navMain)
                        {
                            <div class="mb-2">
                                <div class="flex items-center px-2 py-1.5 text-xs font-medium text-sidebar-foreground/70">
                                    <LucideIconCn Name="@grp.Icon" Size="16" Class="mr-2 size-4" />
                                    @grp.Title
                                </div>
                                <ul class="space-y-0.5">
                                    @foreach (var navItem in grp.Items)
                                    {
                                        var isActive = navItem.IsActive;
                                        <li>
                                            <a href="@navItem.Url"
                                               class="@Cn.Merge("flex items-center rounded-md px-2 py-1.5 text-sm text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", isActive ? "bg-sidebar-accent font-medium text-sidebar-accent-foreground" : "")">
                                                @navItem.Title
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>

                </div>
            </div>

            @* Sidebar Inset / Main Content *@
            <div class="flex min-w-0 flex-1 flex-col">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    @* Sidebar trigger button *@
                    <button type="button" class="-ml-1 flex size-7 items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Overview</a>
                            </li>
                            <li class="hidden md:flex" aria-hidden="true">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                            </li>
                            <li class="flex items-center">
                                <span role="link" aria-current="page" aria-disabled="true" class="font-normal text-foreground">Quick Start</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private record NavSubItem(string Title, string Url, bool IsActive = false);
    private record NavGroup(string Title, string Icon, NavSubItem[] Items);

    private static readonly NavGroup[] _navMain =
    [
        new("Overview", "layout-dashboard", new NavSubItem[]
        {
            new("Introduction", "#"),
            new("Quick Start", "#", true),
            new("Changelog", "#"),
        }),
        new("Components", "puzzle", new NavSubItem[]
        {
            new("Accordion", "#"),
            new("Alert Dialog", "#"),
            new("Breadcrumb", "#"),
            new("Button", "#"),
            new("Calendar", "#"),
        }),
        new("Theming", "brush", new NavSubItem[]
        {
            new("Colors", "#"),
            new("Typography", "#"),
            new("Dark Mode", "#"),
        }),
        new("Guides", "book-open", new NavSubItem[]
        {
            new("Frameworks", "#"),
            new("Figma", "#"),
            new("CLI", "#"),
        }),
        new("Utilities", "wrench", new NavSubItem[]
        {
            new("cn Helper", "#"),
            new("cva Variants", "#"),
        }),
    ];
}
