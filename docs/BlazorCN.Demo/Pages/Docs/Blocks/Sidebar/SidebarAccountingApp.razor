@* ============================================================
   Block: sidebar-accounting-app
   Title: SidebarAccountingApp
   Description: A React sidebar for accounting apps with collapsible groups for banking, invoicing, and tax management. Built with Next.js, shadcn/ui Sidebar, and Tailwind CSS with organized financial navigation.
   Source: original/blocks/sidebar/sidebar-accounting-app.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <SidebarProviderCn Class="h-[700px] !min-h-0">
            <SidebarCn Collapsible="SidebarCollapsible.Icon" Class="border-r">
                <SidebarHeaderCn>
                    <SidebarMenuCn>
                        <SidebarMenuItemCn>
                            <SidebarMenuButtonCn Size="SidebarMenuButtonSize.Lg" Href="#">
                                <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                                    <LucideIconCn Name="landmark" Size="16" Class="size-4" />
                                </div>
                                <div class="flex flex-col gap-0.5 leading-none">
                                    <span class="font-medium">Accounting</span>
                                    <span class="text-xs">FY 2026</span>
                                </div>
                            </SidebarMenuButtonCn>
                        </SidebarMenuItemCn>
                    </SidebarMenuCn>
                </SidebarHeaderCn>
                <SidebarContentCn>
                    @foreach (var grp in _groups)
                    {
                        var group = grp;
                        <SidebarGroupCn>
                            <SidebarGroupLabelCn>
                                <button type="button"
                                        class="flex w-full items-center"
                                        @onclick="@(() => ToggleGroup(group.Title))">
                                    @group.Title
                                    <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("ml-auto size-4 transition-transform duration-200", _openGroups.Contains(group.Title) ? "rotate-90" : "")" />
                                </button>
                            </SidebarGroupLabelCn>
                            @if (_openGroups.Contains(group.Title))
                            {
                                <SidebarGroupContentCn>
                                    <SidebarMenuCn>
                                        @foreach (var item in group.Items)
                                        {
                                            <SidebarMenuItemCn>
                                                <SidebarMenuButtonCn Href="@item.Url" IsActive="@item.IsActive" Tooltip="@item.Title">
                                                    <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                                    <span>@item.Title</span>
                                                </SidebarMenuButtonCn>
                                            </SidebarMenuItemCn>
                                        }
                                    </SidebarMenuCn>
                                </SidebarGroupContentCn>
                            }
                        </SidebarGroupCn>
                    }
                </SidebarContentCn>
                <SidebarRailCn />
            </SidebarCn>

            <SidebarInsetCn Class="min-w-0 flex-1">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <SidebarTriggerCn Class="-ml-1" />
                    <div class="mr-2 w-px self-stretch bg-border data-[orientation=vertical]:h-4" data-orientation="vertical"></div>
                    <nav aria-label="Breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground break-words sm:gap-2.5">
                            <li class="hidden md:block">
                                <a href="#" class="transition-colors hover:text-foreground">Banking</a>
                            </li>
                            <li role="presentation" aria-hidden="true" class="hidden md:block [&>svg]:size-3.5">
                                <LucideIconCn Name="chevron-right" Size="14" />
                            </li>
                            <li>
                                <span role="link" aria-current="page" class="font-normal text-foreground">Accounts</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </SidebarInsetCn>
        </SidebarProviderCn>
    </div>
</section>

@code {
    private record NavItem(string Title, string Url, string Icon, bool IsActive = false);
    private record NavGroup(string Title, bool DefaultOpen, NavItem[] Items);

    private static readonly NavGroup[] _groups =
    [
        new("Banking", true,
        [
            new("Accounts", "#", "wallet", true),
            new("Transactions", "#", "arrow-left-right"),
            new("Reconcile", "#", "scale"),
        ]),
        new("Invoicing", true,
        [
            new("Invoices", "#", "receipt"),
            new("Estimates", "#", "file-text"),
            new("Payments", "#", "credit-card"),
        ]),
        new("Tax", false,
        [
            new("Returns", "#", "file-check"),
            new("Documents", "#", "file-spreadsheet"),
            new("Reports", "#", "calculator"),
        ]),
    ];

    private HashSet<string> _openGroups = [];

    protected override void OnInitialized()
    {
        foreach (var grp in _groups)
        {
            if (grp.DefaultOpen)
                _openGroups.Add(grp.Title);
        }
    }

    private void ToggleGroup(string title)
    {
        if (!_openGroups.Add(title))
            _openGroups.Remove(title);
    }
}
