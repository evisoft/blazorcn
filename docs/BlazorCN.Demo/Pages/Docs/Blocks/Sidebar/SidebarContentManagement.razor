@* ============================================================
   Block: sidebar-content-management
   Title: SidebarContentManagement
   Description: A React sidebar for CMS platforms with collapsible groups, built with Next.js, TypeScript, shadcn/ui Sidebar components, and Tailwind CSS. Features content, media, structure navigation.
   Source: original/blocks/sidebar/sidebar-content-management.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px]">

            @* ── Sidebar ── *@
            <aside class="flex w-64 shrink-0 flex-col border-r bg-sidebar text-sidebar-foreground">

                @* Sidebar Header *@
                <div class="flex items-center border-b px-2 py-2">
                    <a href="#" class="flex w-full items-center gap-2 rounded-md px-2 py-2 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                        <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                            <LucideIconCn Name="book-open" Size="16" Class="size-4" />
                        </div>
                        <div class="flex flex-col gap-0.5 leading-none">
                            <span class="font-medium">CMS</span>
                            <span class="text-xs">acme-blog</span>
                        </div>
                    </a>
                </div>

                @* Sidebar Content — collapsible groups *@
                <div class="flex-1 overflow-y-auto py-2">
                    @foreach (var grp in _groups)
                    {
                        var isOpen = _openGroups.Contains(grp.Title);
                        <div class="px-2 py-1">
                            <button type="button"
                                    class="flex w-full items-center rounded-md px-2 py-1.5 text-xs font-medium text-muted-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground"
                                    @onclick="@(() => ToggleGroup(grp.Title))">
                                @grp.Title
                                <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("ml-auto size-4 transition-transform duration-200", isOpen ? "rotate-90" : "")" />
                            </button>
                            @if (isOpen)
                            {
                                <ul class="mt-0.5 space-y-0.5 px-1">
                                    @foreach (var item in grp.Items)
                                    {
                                        <li>
                                            <a href="@item.Url"
                                               class="@Cn.Merge("flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", item.IsActive ? "bg-sidebar-accent text-sidebar-accent-foreground font-medium" : "")">
                                                <LucideIconCn Name="@item.Icon" Size="16" Class="size-4 shrink-0" />
                                                <span>@item.Title</span>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                </div>

                @* Sidebar Rail *@
                <div class="absolute inset-y-0 right-0 w-px cursor-col-resize bg-transparent transition-colors hover:bg-sidebar-border"></div>

            </aside>

            @* ── Main content (SidebarInset) ── *@
            <div class="min-w-0 flex-1 flex flex-col">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    @* Sidebar trigger *@
                    <button type="button" class="-ml-1 flex size-7 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center gap-1.5 md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Content</a>
                            </li>
                            <li class="hidden items-center gap-1.5 md:flex" aria-hidden="true">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                            </li>
                            <li class="flex items-center gap-1.5">
                                <span role="link" aria-current="page" aria-disabled="true" class="font-normal text-foreground">Articles</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private record NavItem(string Title, string Url, string Icon, bool IsActive = false);
    private record NavGroup(string Title, bool DefaultOpen, NavItem[] Items);

    private static readonly NavGroup[] _groups =
    [
        new("Content", true,
        [
            new("Articles",    "#", "file-text",      true),
            new("Pages",       "#", "panels-top-left"),
            new("Collections", "#", "folder"),
        ]),
        new("Media", true,
        [
            new("Images", "#", "image"),
            new("Videos", "#", "film"),
            new("Files",  "#", "file-text"),
        ]),
        new("Structure", false,
        [
            new("Models",     "#", "layout-grid"),
            new("Fields",     "#", "list-tree"),
            new("Taxonomies", "#", "tag"),
        ]),
        new("Settings", false,
        [
            new("General", "#", "cog"),
        ]),
    ];

    private HashSet<string> _openGroups = new(
        _groups.Where(g => g.DefaultOpen).Select(g => g.Title)
    );

    private void ToggleGroup(string title)
    {
        if (!_openGroups.Remove(title))
            _openGroups.Add(title);
    }
}
