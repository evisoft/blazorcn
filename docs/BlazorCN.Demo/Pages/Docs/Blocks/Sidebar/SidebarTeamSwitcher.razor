@* ============================================================
   Block: sidebar-team-switcher
   Title: SidebarTeamSwitcher
   Description: A React sidebar with team/org switcher dropdown showing team avatar, name, and member count, built with Next.js, shadcn/ui Sidebar, DropdownMenu components, and Tailwind CSS
   Source: original/blocks/sidebar/sidebar-team-switcher.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px]">
            @* Sidebar *@
            <div class="flex w-64 shrink-0 flex-col border-r bg-sidebar">
                @* Sidebar Header *@
                <div class="flex shrink-0 flex-col gap-2 p-2">
                    <ul class="flex w-full min-w-0 flex-col gap-1">
                        <li class="group/menu-item relative">
                            @* DropdownMenu trigger — rendered as a static button for presentational port *@
                            <div class="relative">
                                <button type="button"
                                        class="peer/menu-button flex w-full items-center gap-2 overflow-hidden rounded-md p-2 text-left text-sm outline-none ring-sidebar-ring transition-[width,height,padding] hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-2 active:bg-sidebar-accent active:text-sidebar-accent-foreground data-[state=open]:bg-sidebar-accent data-[state=open]:text-sidebar-accent-foreground h-12 text-sm group-data-[collapsible=icon]:!size-8 group-data-[collapsible=icon]:!p-2"
                                        @onclick="@(() => _dropdownOpen = !_dropdownOpen)">
                                    <div class="@Cn.Merge("flex aspect-square size-8 items-center justify-center rounded-lg text-white", _activeTeam.Color)">
                                        <span class="font-medium text-xs">@_activeTeam.Initials</span>
                                    </div>
                                    <div class="flex flex-col gap-0.5 leading-none">
                                        <span class="font-medium">@_activeTeam.Name</span>
                                        <span class="text-xs text-muted-foreground">@_activeTeam.Members members</span>
                                    </div>
                                    <LucideIconCn Name="chevrons-up-down" Size="16" Class="ml-auto size-4" />
                                </button>
                                @if (_dropdownOpen)
                                {
                                    <div class="absolute left-0 top-full z-50 mt-1 w-56 min-w-[14rem] overflow-hidden rounded-md border bg-popover p-1 text-popover-foreground shadow-md">
                                        <p class="px-2 py-1.5 text-xs text-muted-foreground">Teams</p>
                                        @foreach (var team in _teams)
                                        {
                                            var t = team;
                                            <button type="button"
                                                    class="relative flex w-full cursor-default select-none items-center gap-2 rounded-sm p-2 text-sm outline-none transition-colors hover:bg-accent hover:text-accent-foreground"
                                                    @onclick="@(() => SelectTeam(t))">
                                                <div class="@Cn.Merge("flex size-6 items-center justify-center rounded-sm text-white", t.Color)">
                                                    <span class="font-medium text-[10px]">@t.Initials</span>
                                                </div>
                                                <span class="flex-1">@t.Name</span>
                                                <span class="text-muted-foreground text-xs">@t.Members</span>
                                            </button>
                                        }
                                        <div class="-mx-1 my-1 h-px bg-muted"></div>
                                        <button type="button"
                                                class="relative flex w-full cursor-default select-none items-center gap-2 rounded-sm p-2 text-sm outline-none transition-colors hover:bg-accent hover:text-accent-foreground">
                                            <div class="flex size-6 items-center justify-center rounded-sm border bg-background">
                                                <span class="text-muted-foreground text-lg leading-none">+</span>
                                            </div>
                                            <span class="text-muted-foreground">Create team</span>
                                        </button>
                                    </div>
                                }
                            </div>
                        </li>
                    </ul>
                </div>

                @* Sidebar Content *@
                <div class="flex min-h-0 flex-1 flex-col gap-2 overflow-auto px-2 py-2">
                    @* Workspace Group *@
                    <div>
                        <span class="px-2 py-1 text-xs font-medium text-sidebar-foreground/60">Workspace</span>
                        <ul class="mt-1 space-y-0.5">
                            @foreach (var navItem in _navItems)
                            {
                                var item = navItem;
                                <li>
                                    <a href="@item.Url"
                                       class="@Cn.Merge("flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", item.IsActive ? "bg-sidebar-accent text-sidebar-accent-foreground font-medium" : "")">
                                        <LucideIconCn Name="@item.Icon" Size="16" Class="size-4 shrink-0" />
                                        <span>@item.Title</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                @* Sidebar Rail *@
                <div class="absolute inset-y-0 right-0 w-px bg-border opacity-0 hover:opacity-100 cursor-col-resize"></div>
            </div>

            @* Main Content (SidebarInset) *@
            <div class="flex min-w-0 flex-1 flex-col">
                @* Header *@
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    @* Sidebar trigger *@
                    <button type="button" class="-ml-1 flex size-8 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    @* Vertical separator *@
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Section</a>
                            </li>
                            <li class="hidden md:flex [&>svg]:size-3.5 [&>svg]:text-muted-foreground/70">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 text-muted-foreground/70" />
                            </li>
                            <li class="flex items-center">
                                <span role="link" aria-disabled="true" aria-current="page" class="font-normal text-foreground">Page</span>
                            </li>
                        </ol>
                    </nav>
                </header>

                @* Body *@
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record TeamItem(string Name, string Initials, string Color, int Members);
    private record NavItem(string Title, string Url, string Icon, bool IsActive = false);

    private static readonly TeamItem[] _teams =
    [
        new("Acme Corp",      "AC", "bg-blue-600",    12),
        new("Globex Inc",     "GI", "bg-emerald-600",  8),
        new("Initech",        "IN", "bg-violet-600",  24),
        new("Umbrella Labs",  "UL", "bg-amber-600",    6),
    ];

    private static readonly NavItem[] _navItems =
    [
        new("Dashboard", "#", "bar-chart-3",  true),
        new("Projects",  "#", "folder"),
        new("Documents", "#", "file-text"),
        new("Members",   "#", "users"),
        new("Settings",  "#", "settings"),
    ];

    private TeamItem _activeTeam = _teams[0];
    private bool _dropdownOpen = false;

    private void SelectTeam(TeamItem team)
    {
        _activeTeam = team;
        _dropdownOpen = false;
    }
}
