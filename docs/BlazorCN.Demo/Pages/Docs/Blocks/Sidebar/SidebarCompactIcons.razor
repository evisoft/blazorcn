@* ============================================================
   Block: sidebar-compact-icons
   Title: SidebarCompactIcons
   Description: A React icon-only collapsed sidebar using collapsible icon mode with tooltips for labels and no visible text with Next.js, shadcn/ui Sidebar and Tooltip components, and Tailwind CSS.
   Source: original/blocks/sidebar/sidebar-compact-icons.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px]">
            @* Sidebar — collapsed to icon rail (defaultOpen=false, collapsible="icon") *@
            <div class="flex w-[3.25rem] shrink-0 flex-col border-r bg-sidebar">
                @* Sidebar Header *@
                <div class="flex items-center justify-center border-b py-3">
                    <a href="#" class="flex size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground" title="App">
                        <LucideIconCn Name="zap" Size="16" Class="size-4" />
                    </a>
                </div>

                @* Sidebar Content — top nav *@
                <div class="flex flex-1 flex-col items-center gap-0.5 overflow-y-auto py-2">
                    @foreach (var nav in _topNav)
                    {
                        var item = nav;
                        <a href="@item.Url"
                           title="@item.Title"
                           class="@Cn.Merge("flex size-8 items-center justify-center rounded-md hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", item.IsActive ? "bg-sidebar-accent text-sidebar-accent-foreground" : "text-sidebar-foreground")">
                            <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                            <span class="sr-only">@item.Title</span>
                        </a>
                    }
                </div>

                @* Sidebar Footer — bottom nav *@
                <div class="flex flex-col items-center gap-0.5 border-t py-2">
                    @foreach (var nav in _bottomNav)
                    {
                        var item = nav;
                        <a href="@item.Url"
                           title="@item.Title"
                           class="flex size-8 items-center justify-center rounded-md text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                            <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                            <span class="sr-only">@item.Title</span>
                        </a>
                    }
                </div>
            </div>

            @* Main Content (SidebarInset) *@
            <div class="flex min-w-0 flex-1 flex-col">
                @* Header *@
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    @* Sidebar trigger icon *@
                    <button type="button" class="-ml-1 flex size-8 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    @* Vertical separator *@
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Section</a>
                            </li>
                            <li class="hidden md:flex [&>svg]:size-3.5 [&>svg]:text-muted-foreground/70">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 text-muted-foreground/70" />
                            </li>
                            <li class="flex items-center">
                                <span role="link" aria-disabled="true" aria-current="page" class="font-normal text-foreground">Home</span>
                            </li>
                        </ol>
                    </nav>
                </header>

                @* Body *@
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record NavItem(string Title, string Url, string Icon, bool IsActive = false);

    private static readonly NavItem[] _topNav =
    [
        new("Home", "#", "home", true),
        new("Dashboard", "#", "layout-dashboard"),
        new("Search", "#", "search"),
        new("Inbox", "#", "inbox"),
        new("Documents", "#", "file-text"),
        new("Analytics", "#", "bar-chart"),
        new("Team", "#", "users"),
        new("Automations", "#", "zap"),
    ];

    private static readonly NavItem[] _bottomNav =
    [
        new("Notifications", "#", "bell"),
        new("Settings", "#", "settings"),
    ];
}
