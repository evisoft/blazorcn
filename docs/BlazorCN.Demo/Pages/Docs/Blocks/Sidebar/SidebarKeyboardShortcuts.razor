@* ============================================================
   Block: sidebar-keyboard-shortcuts
   Title: SidebarKeyboardShortcuts
   Description: A React sidebar displaying keyboard shortcut hints using shadcn/ui Sidebar components, Next.js, and Tailwind CSS with monospace kbd-style badges.
   Source: original/blocks/sidebar/sidebar-keyboard-shortcuts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <SidebarProviderCn Class="h-[700px] !min-h-0">
            <SidebarCn Class="border-r">
                <SidebarHeaderCn>
                    <SidebarMenuCn>
                        <SidebarMenuItemCn>
                            <SidebarMenuButtonCn Size="SidebarMenuButtonSize.Lg" Href="#">
                                <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                                    <LucideIconCn Name="gallery-vertical-end" Size="16" Class="size-4" />
                                </div>
                                <div class="flex flex-col gap-0.5 leading-none">
                                    <span class="font-medium">Acme Studio</span>
                                    <span class="text-xs text-muted-foreground">Pro Plan</span>
                                </div>
                            </SidebarMenuButtonCn>
                        </SidebarMenuItemCn>
                    </SidebarMenuCn>
                </SidebarHeaderCn>
                <SidebarContentCn>
                    <SidebarGroupCn>
                        <SidebarGroupLabelCn>Main</SidebarGroupLabelCn>
                        <SidebarGroupContentCn>
                            <SidebarMenuCn>
                                @foreach (var item in _mainNav)
                                {
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn Href="@item.Url" IsActive="@item.IsActive">
                                            <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                            <span>@item.Title</span>
                                        </SidebarMenuButtonCn>
                                        @if (!string.IsNullOrEmpty(item.Shortcut))
                                        {
                                            <SidebarMenuBadgeCn>
                                                <span class="rounded bg-muted px-1 font-mono text-muted-foreground text-xs">@item.Shortcut</span>
                                            </SidebarMenuBadgeCn>
                                        }
                                    </SidebarMenuItemCn>
                                }
                            </SidebarMenuCn>
                        </SidebarGroupContentCn>
                    </SidebarGroupCn>

                    <SidebarGroupCn>
                        <SidebarGroupLabelCn>Tools</SidebarGroupLabelCn>
                        <SidebarGroupContentCn>
                            <SidebarMenuCn>
                                @foreach (var item in _secondaryNav)
                                {
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn Href="@item.Url">
                                            <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                            <span>@item.Title</span>
                                        </SidebarMenuButtonCn>
                                        @if (!string.IsNullOrEmpty(item.Shortcut))
                                        {
                                            <SidebarMenuBadgeCn>
                                                <span class="rounded bg-muted px-1 font-mono text-muted-foreground text-xs">@item.Shortcut</span>
                                            </SidebarMenuBadgeCn>
                                        }
                                    </SidebarMenuItemCn>
                                }
                            </SidebarMenuCn>
                        </SidebarGroupContentCn>
                    </SidebarGroupCn>
                </SidebarContentCn>
                <SidebarRailCn />
            </SidebarCn>

            <SidebarInsetCn Class="min-w-0 flex-1">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <SidebarTriggerCn Class="-ml-1" />
                    <div class="mr-2 w-px self-stretch bg-border data-[orientation=vertical]:h-4" data-orientation="vertical"></div>
                    <nav aria-label="Breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground break-words sm:gap-2.5">
                            <li class="hidden md:block">
                                <a href="#" class="transition-colors hover:text-foreground">Main</a>
                            </li>
                            <li role="presentation" aria-hidden="true" class="hidden md:block [&>svg]:size-3.5">
                                <LucideIconCn Name="chevron-right" Size="14" />
                            </li>
                            <li>
                                <span role="link" aria-current="page" class="font-normal text-foreground">Dashboard</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </SidebarInsetCn>
        </SidebarProviderCn>
    </div>
</section>

@code {
    private record NavItem(string Title, string Url, string Icon, string Shortcut = "", bool IsActive = false);

    private static readonly NavItem[] _mainNav =
    [
        new("Dashboard", "#", "layout-dashboard", "⌘ 1", true),
        new("Inbox",     "#", "inbox",            "⌘ 2"),
        new("Documents", "#", "file-text",         "⌘ 3"),
        new("Analytics", "#", "bar-chart",         "⌘ 4"),
        new("Messages",  "#", "message-square",    "⌘ 5"),
    ];

    private static readonly NavItem[] _secondaryNav =
    [
        new("Team",     "#", "users",    "⌘ 6"),
        new("Search",   "#", "search",   "⌘ K"),
        new("Settings", "#", "settings", "⌘ ,"),
    ];
}
