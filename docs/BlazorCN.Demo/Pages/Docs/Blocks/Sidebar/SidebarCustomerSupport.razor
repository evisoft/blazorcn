@* ============================================================
   Block: sidebar-customer-support
   Title: SidebarCustomerSupport
   Description: A React sidebar for help desk platforms with badge counts, built with Next.js, TypeScript, shadcn/ui Sidebar components, and Tailwind CSS. Features conversations, contacts, and support tools.
   Source: original/blocks/sidebar/sidebar-customer-support.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px]">
            @* Sidebar *@
            <div class="flex w-64 shrink-0 flex-col border-r bg-sidebar">
                @* Sidebar Header *@
                <div class="flex h-16 items-center border-b px-2">
                    <a href="#" class="flex w-full items-center gap-2 rounded-md p-2 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                        <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                            <LucideIconCn Name="headphones" Size="16" Class="size-4" />
                        </div>
                        <div class="flex flex-col gap-0.5 leading-none">
                            <span class="font-medium">Support</span>
                            <span class="">Acme Help Desk</span>
                        </div>
                    </a>
                </div>

                @* Sidebar Content *@
                <div class="flex flex-1 flex-col overflow-y-auto py-2">
                    @* Conversations group *@
                    <div class="px-2 py-1">
                        <span class="px-2 text-xs font-medium text-sidebar-foreground/60">Conversations</span>
                        <ul class="mt-1 space-y-0.5">
                            @foreach (var itm in _conversationsNav)
                            {
                                var item = itm;
                                <li class="relative">
                                    <a href="@item.Url"
                                       class="@Cn.Merge("flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", item.IsActive ? "bg-sidebar-accent text-sidebar-accent-foreground font-medium" : "")">
                                        <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                        <span>@item.Title</span>
                                        @if (!string.IsNullOrEmpty(item.Badge))
                                        {
                                            <span class="ml-auto flex h-5 min-w-5 items-center justify-center rounded-full bg-sidebar-primary/10 px-1 text-xs font-medium tabular-nums text-sidebar-foreground">@item.Badge</span>
                                        }
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    @* Contacts group *@
                    <div class="px-2 py-1">
                        <span class="px-2 text-xs font-medium text-sidebar-foreground/60">Contacts</span>
                        <ul class="mt-1 space-y-0.5">
                            @foreach (var itm in _contactsNav)
                            {
                                var item = itm;
                                <li>
                                    <a href="@item.Url"
                                       class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                                        <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                        <span>@item.Title</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    @* Tools group *@
                    <div class="px-2 py-1">
                        <span class="px-2 text-xs font-medium text-sidebar-foreground/60">Tools</span>
                        <ul class="mt-1 space-y-0.5">
                            @foreach (var itm in _toolsNav)
                            {
                                var item = itm;
                                <li>
                                    <a href="@item.Url"
                                       class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                                        <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                        <span>@item.Title</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                @* Sidebar Rail *@
                <div class="absolute inset-y-0 right-0 w-px bg-border opacity-0 hover:opacity-100 cursor-col-resize"></div>
            </div>

            @* Main Content (SidebarInset) *@
            <div class="flex min-w-0 flex-1 flex-col">
                @* Header *@
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <button type="button" class="-ml-1 flex size-8 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Conversations</a>
                            </li>
                            <li class="hidden md:flex [&>svg]:size-3.5 [&>svg]:text-muted-foreground/70">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 text-muted-foreground/70" />
                            </li>
                            <li class="flex items-center">
                                <span role="link" aria-disabled="true" aria-current="page" class="font-normal text-foreground">Open</span>
                            </li>
                        </ol>
                    </nav>
                </header>

                @* Body *@
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record NavItem(string Title, string Url, string Icon, string Badge = "", bool IsActive = false);

    private static readonly NavItem[] _conversationsNav =
    [
        new("Open",     "#", "inbox",         "23", true),
        new("Pending",  "#", "clock",         "7"),
        new("Resolved", "#", "check-circle"),
    ];

    private static readonly NavItem[] _contactsNav =
    [
        new("Customers", "#", "users"),
        new("Companies", "#", "building"),
    ];

    private static readonly NavItem[] _toolsNav =
    [
        new("Macros",       "#", "bookmark"),
        new("Automations",  "#", "zap"),
        new("Reports",      "#", "bar-chart"),
    ];
}
