@* ============================================================
   Block: sidebar-mini-cards
   Title: SidebarMiniCards
   Description: React sidebar with compact header card showing plan and usage stats. Built with Next.js, shadcn/ui Sidebar, Progress components, and Tailwind CSS.
   Source: original/blocks/sidebar/sidebar-mini-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <SidebarProviderCn Class="h-[700px] !min-h-0">
            <SidebarCn Class="border-r">
                <SidebarHeaderCn>
                    <SidebarMenuCn>
                        <SidebarMenuItemCn>
                            <SidebarMenuButtonCn Size="SidebarMenuButtonSize.Lg" Href="#">
                                <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                                    <LucideIconCn Name="gallery-vertical-end" Size="16" Class="size-4" />
                                </div>
                                <div class="flex flex-col gap-0.5 leading-none">
                                    <span class="font-medium">Acme Platform</span>
                                    <span class="">Dashboard</span>
                                </div>
                            </SidebarMenuButtonCn>
                        </SidebarMenuItemCn>
                    </SidebarMenuCn>
                    <div class="mx-2 rounded-md border bg-sidebar-accent/50 p-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-medium text-muted-foreground">Current Plan</span>
                            <span class="rounded-md bg-sidebar-primary/10 px-2 py-0.5 text-xs font-medium text-sidebar-primary">
                                @_account.Plan
                            </span>
                        </div>
                        <div class="mt-3">
                            <div class="flex items-center justify-between text-xs">
                                <span class="text-muted-foreground">API Calls</span>
                                <span class="font-medium tabular-nums">
                                    @_account.ApiCalls.ToString("N0") / @_account.ApiLimit.ToString("N0")
                                </span>
                            </div>
                            <ProgressCn Value="@((double)_account.ApiCalls / _account.ApiLimit * 100)" Class="mt-1.5 h-1.5" />
                        </div>
                        <div class="mt-2 flex items-center justify-between text-xs">
                            <span class="text-muted-foreground">Storage</span>
                            <span class="font-medium">
                                @_account.Storage / @_account.StorageLimit
                            </span>
                        </div>
                    </div>
                </SidebarHeaderCn>
                <SidebarContentCn>
                    <SidebarGroupCn>
                        <SidebarGroupLabelCn>Main</SidebarGroupLabelCn>
                        <SidebarGroupContentCn>
                            <SidebarMenuCn>
                                @foreach (var item in _navMain)
                                {
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn Href="@item.Url" IsActive="@item.IsActive">
                                            <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                            <span>@item.Title</span>
                                        </SidebarMenuButtonCn>
                                    </SidebarMenuItemCn>
                                }
                            </SidebarMenuCn>
                        </SidebarGroupContentCn>
                    </SidebarGroupCn>

                    <SidebarGroupCn>
                        <SidebarGroupLabelCn>Resources</SidebarGroupLabelCn>
                        <SidebarGroupContentCn>
                            <SidebarMenuCn>
                                @foreach (var item in _navResources)
                                {
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn Href="@item.Url">
                                            <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                            <span>@item.Title</span>
                                        </SidebarMenuButtonCn>
                                    </SidebarMenuItemCn>
                                }
                            </SidebarMenuCn>
                        </SidebarGroupContentCn>
                    </SidebarGroupCn>
                </SidebarContentCn>
                <SidebarRailCn />
            </SidebarCn>

            <SidebarInsetCn Class="min-w-0 flex-1">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <SidebarTriggerCn Class="-ml-1" />
                    <div class="mr-2 w-px self-stretch bg-border data-[orientation=vertical]:h-4" data-orientation="vertical"></div>
                    <nav aria-label="Breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground break-words sm:gap-2.5">
                            <li class="hidden md:block">
                                <a href="#" class="transition-colors hover:text-foreground">Section</a>
                            </li>
                            <li role="presentation" aria-hidden="true" class="hidden md:block [&>svg]:size-3.5">
                                <LucideIconCn Name="chevron-right" Size="14" />
                            </li>
                            <li>
                                <span role="link" aria-current="page" class="font-normal text-foreground">Page</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </SidebarInsetCn>
        </SidebarProviderCn>
    </div>
</section>

@code {
    private record AccountInfo(string Plan, int ApiCalls, int ApiLimit, string Storage, string StorageLimit);
    private record NavItem(string Title, string Url, string Icon, bool IsActive = false);

    private static readonly AccountInfo _account = new("Pro", 8420, 10000, "4.2 GB", "10 GB");

    private static readonly NavItem[] _navMain =
    [
        new("Overview", "#", "bar-chart-3", true),
        new("Projects", "#", "folder"),
        new("Documents", "#", "file-text"),
        new("Team", "#", "users"),
    ];

    private static readonly NavItem[] _navResources =
    [
        new("Database", "#", "database"),
        new("Functions", "#", "zap"),
        new("Settings", "#", "settings"),
    ];
}
