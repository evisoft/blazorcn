@* ============================================================
   Block: sidebar-status-indicators
   Title: SidebarStatusIndicators
   Description: React and Next.js sidebar with colored status dots showing online, offline, and busy states using shadcn/ui Sidebar components and Tailwind CSS indicators
   Source: original/blocks/sidebar/sidebar-status-indicators.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <SidebarProviderCn Class="h-[700px] !min-h-0">
            <SidebarCn Class="border-r">
                <SidebarHeaderCn>
                    <SidebarMenuCn>
                        <SidebarMenuItemCn>
                            <SidebarMenuButtonCn Size="SidebarMenuButtonSize.Lg" Href="#">
                                <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                                    <LucideIconCn Name="users" Size="16" Class="size-4" />
                                </div>
                                <div class="flex flex-col gap-0.5 leading-none">
                                    <span class="font-medium">Team Directory</span>
                                    <span class="text-xs text-muted-foreground">10 members</span>
                                </div>
                            </SidebarMenuButtonCn>
                        </SidebarMenuItemCn>
                    </SidebarMenuCn>
                </SidebarHeaderCn>
                <SidebarContentCn>
                    <SidebarGroupCn>
                        <SidebarGroupLabelCn>Engineering</SidebarGroupLabelCn>
                        <SidebarGroupContentCn>
                            <SidebarMenuCn>
                                @foreach (var member in _engineering)
                                {
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn Href="@member.Url" IsActive="@member.IsActive">
                                            <span class="@Cn.Merge("size-2 shrink-0 rounded-full", StatusColor(member.Status))"></span>
                                            <span class="flex flex-col">
                                                <span>@member.Name</span>
                                                <span class="text-xs text-muted-foreground">@member.Role</span>
                                            </span>
                                        </SidebarMenuButtonCn>
                                    </SidebarMenuItemCn>
                                }
                            </SidebarMenuCn>
                        </SidebarGroupContentCn>
                    </SidebarGroupCn>

                    <SidebarGroupCn>
                        <SidebarGroupLabelCn>Design</SidebarGroupLabelCn>
                        <SidebarGroupContentCn>
                            <SidebarMenuCn>
                                @foreach (var member in _design)
                                {
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn Href="@member.Url">
                                            <span class="@Cn.Merge("size-2 shrink-0 rounded-full", StatusColor(member.Status))"></span>
                                            <span class="flex flex-col">
                                                <span>@member.Name</span>
                                                <span class="text-xs text-muted-foreground">@member.Role</span>
                                            </span>
                                        </SidebarMenuButtonCn>
                                    </SidebarMenuItemCn>
                                }
                            </SidebarMenuCn>
                        </SidebarGroupContentCn>
                    </SidebarGroupCn>

                    <SidebarGroupCn>
                        <SidebarGroupLabelCn>Product</SidebarGroupLabelCn>
                        <SidebarGroupContentCn>
                            <SidebarMenuCn>
                                @foreach (var member in _product)
                                {
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn Href="@member.Url">
                                            <span class="@Cn.Merge("size-2 shrink-0 rounded-full", StatusColor(member.Status))"></span>
                                            <span class="flex flex-col">
                                                <span>@member.Name</span>
                                                <span class="text-xs text-muted-foreground">@member.Role</span>
                                            </span>
                                        </SidebarMenuButtonCn>
                                    </SidebarMenuItemCn>
                                }
                            </SidebarMenuCn>
                        </SidebarGroupContentCn>
                    </SidebarGroupCn>
                </SidebarContentCn>
                <SidebarRailCn />
            </SidebarCn>

            <SidebarInsetCn Class="min-w-0 flex-1">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <SidebarTriggerCn Class="-ml-1" />
                    <div class="mr-2 w-px self-stretch bg-border data-[orientation=vertical]:h-4" data-orientation="vertical"></div>
                    <nav aria-label="Breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground break-words sm:gap-2.5">
                            <li class="hidden md:block">
                                <a href="#" class="transition-colors hover:text-foreground">Engineering</a>
                            </li>
                            <li role="presentation" aria-hidden="true" class="hidden md:block [&>svg]:size-3.5">
                                <LucideIconCn Name="chevron-right" Size="14" />
                            </li>
                            <li>
                                <span role="link" aria-current="page" class="font-normal text-foreground">Alice Chen</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </SidebarInsetCn>
        </SidebarProviderCn>
    </div>
</section>

@code {
    private enum MemberStatus { Online, Busy, Offline }

    private record TeamMember(string Name, string Role, MemberStatus Status, string Url, bool IsActive = false);

    private static string StatusColor(MemberStatus status) => status switch
    {
        MemberStatus.Online => "bg-emerald-500",
        MemberStatus.Busy => "bg-amber-500",
        MemberStatus.Offline => "bg-muted-foreground/40",
        _ => ""
    };

    private static readonly TeamMember[] _engineering =
    [
        new("Alice Chen", "Lead Engineer", MemberStatus.Online, "#", true),
        new("Bob Martinez", "Frontend Dev", MemberStatus.Online, "#"),
        new("Carol Kim", "Backend Dev", MemberStatus.Busy, "#"),
        new("Dave Wilson", "DevOps", MemberStatus.Offline, "#"),
    ];

    private static readonly TeamMember[] _design =
    [
        new("Eve Johnson", "Design Lead", MemberStatus.Online, "#"),
        new("Frank Lee", "UI Designer", MemberStatus.Busy, "#"),
        new("Grace Park", "UX Researcher", MemberStatus.Offline, "#"),
    ];

    private static readonly TeamMember[] _product =
    [
        new("Henry Nguyen", "Product Manager", MemberStatus.Online, "#"),
        new("Ivy Santos", "Data Analyst", MemberStatus.Online, "#"),
        new("Jack Thompson", "QA Engineer", MemberStatus.Offline, "#"),
    ];
}
