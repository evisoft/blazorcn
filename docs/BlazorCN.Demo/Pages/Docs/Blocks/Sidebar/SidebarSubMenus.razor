@* ============================================================
   Block: sidebar-sub-menus
   Title: SidebarSubMenus
   Description: A React sidebar with hierarchical nested sub-menu items using shadcn/ui SidebarMenuSub, SidebarMenuSubButton, and SidebarMenuSubItem components styled with Next.js and Tailwind CSS
   Source: original/blocks/sidebar/sidebar-sub-menus.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px]">
            @* Sidebar *@
            <div class="flex w-64 shrink-0 flex-col border-r bg-sidebar">
                @* Sidebar Header *@
                <div class="flex h-16 items-center border-b px-2">
                    <a href="#" class="flex w-full items-center gap-2 rounded-md p-2 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                        <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                            <LucideIconCn Name="gallery-vertical-end" Size="16" Class="size-4" />
                        </div>
                        <div class="flex flex-col gap-0.5 leading-none">
                            <span class="font-medium">UI Library</span>
                            <span class="">v4.2.0</span>
                        </div>
                    </a>
                </div>

                @* Sidebar Content *@
                <div class="flex flex-1 flex-col gap-2 overflow-y-auto py-2">
                    <div class="px-2">
                        <span class="px-2 py-1 text-xs font-medium text-sidebar-foreground/60">Reference</span>
                        <ul class="mt-1 space-y-0.5">
                            @foreach (var navItem in _navMain)
                            {
                                var sec = navItem;
                                <li>
                                    <a href="#"
                                       class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                                        <LucideIconCn Name="@sec.Icon" Size="16" Class="size-4 shrink-0" />
                                        <span>@sec.Title</span>
                                    </a>
                                    <ul class="ml-4 mt-0.5 space-y-0.5 border-l border-sidebar-border pl-2">
                                        @foreach (var subItem in sec.Items)
                                        {
                                            var sub = subItem;
                                            <li>
                                                <a href="@sub.Url"
                                                   class="@Cn.Merge("flex items-center rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", sub.IsActive ? "bg-sidebar-accent text-sidebar-accent-foreground font-medium" : "")">
                                                    @sub.Title
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                @* Sidebar Rail *@
                <div class="absolute inset-y-0 right-0 w-px bg-border opacity-0 hover:opacity-100 cursor-col-resize"></div>
            </div>

            @* Main Content (SidebarInset) *@
            <div class="flex min-w-0 flex-1 flex-col">
                @* Header *@
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <button type="button" class="-ml-1 flex size-8 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Components</a>
                            </li>
                            <li class="hidden md:flex [&>svg]:size-3.5 [&>svg]:text-muted-foreground/70">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 text-muted-foreground/70" />
                            </li>
                            <li class="flex items-center">
                                <span role="link" aria-disabled="true" aria-current="page" class="font-normal text-foreground">Dialog</span>
                            </li>
                        </ol>
                    </nav>
                </header>

                @* Body *@
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record SubNavItem(string Title, string Url, bool IsActive = false);

    private record NavItem(string Title, string Icon, SubNavItem[] Items);

    private static readonly NavItem[] _navMain =
    [
        new NavItem("Components", "layers",
        [
            new SubNavItem("Button", "#"),
            new SubNavItem("Input", "#"),
            new SubNavItem("Dialog", "#", true),
            new SubNavItem("Dropdown Menu", "#"),
            new SubNavItem("Select", "#"),
        ]),
        new NavItem("Data Display", "database",
        [
            new SubNavItem("Table", "#"),
            new SubNavItem("Card", "#"),
            new SubNavItem("Avatar", "#"),
            new SubNavItem("Badge", "#"),
        ]),
        new NavItem("Forms", "code",
        [
            new SubNavItem("Checkbox", "#"),
            new SubNavItem("Radio Group", "#"),
            new SubNavItem("Switch", "#"),
            new SubNavItem("Textarea", "#"),
        ]),
        new NavItem("Documentation", "book-open",
        [
            new SubNavItem("Introduction", "#"),
            new SubNavItem("Theming", "#"),
            new SubNavItem("Dark Mode", "#"),
            new SubNavItem("Typography", "#"),
        ]),
        new NavItem("Configuration", "settings",
        [
            new SubNavItem("Installation", "#"),
            new SubNavItem("CLI", "#"),
            new SubNavItem("Changelog", "#"),
        ]),
    ];
}
