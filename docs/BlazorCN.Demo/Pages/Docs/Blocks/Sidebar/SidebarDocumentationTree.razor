@* ============================================================
   Block: sidebar-documentation-tree
   Title: SidebarDocumentationTree
   Description: React documentation sidebar with nested tree navigation and collapsible sections. Built with Next.js, TypeScript, shadcn/ui Sidebar and Collapsible, and Tailwind CSS.
   Source: original/blocks/sidebar/sidebar-documentation-tree.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px] w-full">

            @* Sidebar *@
            <div class="flex h-full w-64 shrink-0 flex-col border-r bg-sidebar">

                @* Sidebar Header *@
                <div class="flex h-16 items-center px-4 py-2">
                    <a href="#" class="flex w-full items-center gap-3 rounded-md px-2 py-2 text-sm font-medium hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                        <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                            <LucideIconCn Name="book-open" Size="16" Class="size-4" />
                        </div>
                        <div class="flex flex-col gap-0.5 leading-none">
                            <span class="font-medium">Documentation</span>
                            <span class="text-xs text-muted-foreground">v3.0.0</span>
                        </div>
                    </a>
                </div>

                @* Sidebar Content *@
                <div class="flex-1 overflow-y-auto px-2 py-2">
                    @foreach (var grp in _docTree)
                    {
                        <div class="mb-2">
                            <div class="px-2 py-1.5 text-xs font-medium text-sidebar-foreground/70">
                                @grp.Title
                            </div>
                            <ul class="space-y-0.5">
                                @foreach (var navItem in grp.Items)
                                {
                                    var item = navItem;
                                    @if (item.Children != null && item.Children.Length > 0)
                                    {
                                        var key = grp.Title + "/" + item.Title;
                                        var isOpen = _open.ContainsKey(key) ? _open[key] : HasActiveChild(item.Children);
                                        <li>
                                            <button type="button"
                                                    class="flex w-full items-center rounded-md px-2 py-1.5 text-sm text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground"
                                                    @onclick="@(() => ToggleOpen(key))">
                                                <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 transition-transform duration-200", isOpen ? "rotate-90" : "")" />
                                                <span>@item.Title</span>
                                            </button>
                                            @if (isOpen)
                                            {
                                                <ul class="ml-4 mt-0.5 space-y-0.5 border-l border-sidebar-border pl-2">
                                                    @foreach (var childNav in item.Children)
                                                    {
                                                        var child = childNav;
                                                        @if (child.Children != null && child.Children.Length > 0)
                                                        {
                                                            var childKey = key + "/" + child.Title;
                                                            var childOpen = _open.ContainsKey(childKey) ? _open[childKey] : HasActiveChild(child.Children);
                                                            <li>
                                                                <button type="button"
                                                                        class="flex w-full items-center rounded-md px-2 py-1.5 text-sm text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground"
                                                                        @onclick="@(() => ToggleOpen(childKey))">
                                                                    <LucideIconCn Name="chevron-right" Size="12" Class="@Cn.Merge("size-3 transition-transform duration-200", childOpen ? "rotate-90" : "")" />
                                                                    <span>@child.Title</span>
                                                                </button>
                                                                @if (childOpen)
                                                                {
                                                                    <ul class="ml-3 mt-0.5 space-y-0.5 border-l border-sidebar-border pl-2">
                                                                        @foreach (var grandchildNav in child.Children)
                                                                        {
                                                                            var gc = grandchildNav;
                                                                            <li>
                                                                                <a href="@gc.Url"
                                                                                   class="@Cn.Merge("flex items-center rounded-md px-2 py-1.5 text-sm text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", gc.IsActive ? "bg-sidebar-accent font-medium text-sidebar-accent-foreground" : "")">
                                                                                    @gc.Title
                                                                                </a>
                                                                            </li>
                                                                        }
                                                                    </ul>
                                                                }
                                                            </li>
                                                        }
                                                        else
                                                        {
                                                            <li>
                                                                <a href="@child.Url"
                                                                   class="@Cn.Merge("flex items-center rounded-md px-2 py-1.5 text-sm text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", child.IsActive ? "bg-sidebar-accent font-medium text-sidebar-accent-foreground" : "")">
                                                                    @child.Title
                                                                </a>
                                                            </li>
                                                        }
                                                    }
                                                </ul>
                                            }
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <a href="@item.Url"
                                               class="@Cn.Merge("flex items-center rounded-md px-2 py-1.5 text-sm text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", item.IsActive ? "bg-sidebar-accent font-medium text-sidebar-accent-foreground" : "")">
                                                @item.Title
                                            </a>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                    }
                </div>

                @* Sidebar Rail *@
                <div class="absolute inset-y-0 right-0 w-px cursor-col-resize bg-transparent transition-colors hover:bg-sidebar-border"></div>
            </div>

            @* Sidebar Inset / Main Content *@
            <div class="flex min-w-0 flex-1 flex-col">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <button type="button" class="-ml-1 flex size-7 items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Section</a>
                            </li>
                            <li class="hidden md:flex" aria-hidden="true">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                            </li>
                            <li class="flex items-center">
                                <span role="link" aria-current="page" aria-disabled="true" class="font-normal text-foreground">Page</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private record NavItem(string Title, string? Url = null, bool IsActive = false, NavItem[]? Children = null);

    private record DocGroup(string Title, NavItem[] Items);

    private static readonly DocGroup[] _docTree =
    [
        new("Getting Started", new NavItem[]
        {
            new("Introduction", Url: "#"),
            new("Installation", Url: "#"),
            new("Configuration", Children: new NavItem[]
            {
                new("TypeScript", Url: "#"),
                new("ESLint", Url: "#"),
                new("Environment Variables", Url: "#"),
            }),
        }),
        new("Core Concepts", new NavItem[]
        {
            new("Routing", Children: new NavItem[]
            {
                new("Pages", Url: "#"),
                new("Layouts", Url: "#", IsActive: true),
                new("Loading States", Url: "#"),
                new("Error Handling", Url: "#"),
            }),
            new("Data Fetching", Children: new NavItem[]
            {
                new("Server Components", Url: "#"),
                new("Client Components", Url: "#"),
                new("Streaming", Url: "#"),
            }),
            new("Rendering", Children: new NavItem[]
            {
                new("Static", Url: "#"),
                new("Dynamic", Url: "#"),
                new("Edge", Url: "#"),
            }),
        }),
        new("API Reference", new NavItem[]
        {
            new("Components", Children: new NavItem[]
            {
                new("Image", Url: "#"),
                new("Link", Url: "#"),
                new("Script", Url: "#"),
                new("Font", Url: "#"),
            }),
            new("Functions", Children: new NavItem[]
            {
                new("fetch", Url: "#"),
                new("cookies", Url: "#"),
                new("headers", Url: "#"),
                new("redirect", Url: "#"),
            }),
        }),
    ];

    private readonly Dictionary<string, bool> _open = new();

    private static bool HasActiveChild(NavItem[] items)
    {
        foreach (var item in items)
        {
            if (item.IsActive) return true;
            if (item.Children != null && HasActiveChild(item.Children)) return true;
        }
        return false;
    }

    private void ToggleOpen(string key)
    {
        var current = _open.ContainsKey(key) ? _open[key] : false;
        _open[key] = !current;
    }
}
