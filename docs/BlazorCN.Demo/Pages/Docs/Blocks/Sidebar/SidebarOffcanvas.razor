@* ============================================================
   Block: sidebar-offcanvas
   Title: SidebarOffcanvas
   Description: React sidebar using collapsible offcanvas mode that slides completely off screen when collapsed, built with Next.js, shadcn/ui, and Tailwind CSS with smooth CSS transitions.
   Source: original/blocks/sidebar/sidebar-offcanvas.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px]">

            @* ── Sidebar ── *@
            <aside class="flex w-64 shrink-0 flex-col border-r bg-sidebar text-sidebar-foreground">

                @* Sidebar Header *@
                <div class="flex items-center border-b px-2 py-2">
                    <a href="#" class="flex w-full items-center gap-2 rounded-md px-2 py-2 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                        <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                            <LucideIconCn Name="gallery-vertical-end" Size="16" Class="size-4" />
                        </div>
                        <div class="flex flex-col gap-0.5 leading-none">
                            <span class="font-medium">Blog Editor</span>
                            <span class="">Content Platform</span>
                        </div>
                    </a>
                </div>

                @* Sidebar Content *@
                <div class="flex-1 overflow-y-auto py-2">

                    @* Quick Access group *@
                    <div class="px-2 py-2">
                        <p class="mb-1 px-2 text-xs font-medium text-muted-foreground">Quick Access</p>
                        <ul class="space-y-0.5">
                            @foreach (var item in _mainNav)
                            {
                                <li>
                                    <a href="@item.Url"
                                       class="@Cn.Merge("flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", item.IsActive ? "bg-sidebar-accent text-sidebar-accent-foreground font-medium" : "")">
                                        <LucideIconCn Name="@item.Icon" Size="16" Class="size-4 shrink-0" />
                                        <span>@item.Title</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    @* Content group *@
                    <div class="px-2 py-2">
                        <p class="mb-1 px-2 text-xs font-medium text-muted-foreground">Content</p>
                        <ul class="space-y-0.5">
                            @foreach (var item in _contentNav)
                            {
                                <li>
                                    <a href="@item.Url"
                                       class="@Cn.Merge("flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", item.IsActive ? "bg-sidebar-accent text-sidebar-accent-foreground font-medium" : "")">
                                        <LucideIconCn Name="@item.Icon" Size="16" Class="size-4 shrink-0" />
                                        <span>@item.Title</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                </div>

            </aside>

            @* ── Main content (SidebarInset) ── *@
            <div class="min-w-0 flex-1 flex flex-col">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    @* Sidebar trigger button *@
                    <button type="button" class="-ml-1 flex size-7 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    <div class="mx-2 h-4 w-px bg-border"></div>
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center gap-1.5 md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Blog Editor</a>
                            </li>
                            <li class="hidden items-center gap-1.5 md:flex">
                                <LucideIconCn Name="chevron-right" Size="16" Class="size-3.5" />
                            </li>
                            <li class="flex items-center gap-1.5">
                                <span class="font-normal text-foreground">Home</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private record NavItem(string Title, string Url, string Icon, bool IsActive = false);

    private static readonly NavItem[] _mainNav =
    [
        new("Home",     "#", "home",       true),
        new("Search",   "#", "search"),
        new("New Post", "#", "pen-square"),
        new("Library",  "#", "book-open"),
    ];

    private static readonly NavItem[] _contentNav =
    [
        new("Published", "#", "file-text"),
        new("Drafts",    "#", "file-text"),
        new("Favorites", "#", "star"),
        new("History",   "#", "history"),
        new("Tags",      "#", "tag"),
        new("Settings",  "#", "settings"),
    ];
}
