@* ============================================================
   Block: sidebar-cloud-console
   Title: SidebarCloudConsole
   Description: A React sidebar for cloud infrastructure consoles with collapsible groups for compute, storage, networking, and IAM management using Next.js, shadcn/ui Sidebar, and Tailwind CSS.
   Source: original/blocks/sidebar/sidebar-cloud-console.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px] w-full">

            @* Sidebar *@
            <div class="flex h-full w-64 shrink-0 flex-col border-r bg-sidebar">

                @* Sidebar Header *@
                <div class="flex h-16 items-center px-4 py-2">
                    <a href="#" class="flex items-center gap-3 rounded-md px-2 py-2 text-sm font-medium hover:bg-sidebar-accent hover:text-sidebar-accent-foreground w-full">
                        <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                            <LucideIconCn Name="cloud" Size="16" Class="size-4" />
                        </div>
                        <div class="flex flex-col gap-0.5 leading-none">
                            <span class="font-medium">Cloud Console</span>
                            <span class="text-xs">us-east-1</span>
                        </div>
                    </a>
                </div>

                @* Sidebar Content *@
                <div class="flex-1 overflow-y-auto px-2 py-2">
                    @foreach (var grp in _groups)
                    {
                        var group = grp;
                        <div class="mb-1">
                            @* Collapsible trigger / group label *@
                            <button type="button"
                                    class="flex w-full items-center rounded-md px-2 py-1.5 text-xs font-medium text-sidebar-foreground/70 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground"
                                    @onclick="@(() => ToggleGroup(group.Title))">
                                @group.Title
                                <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("ml-auto size-4 transition-transform duration-200", IsGroupOpen(group.Title) ? "rotate-90" : "")" />
                            </button>
                            @if (IsGroupOpen(group.Title))
                            {
                                <ul class="space-y-0.5 px-1 py-0.5">
                                    @foreach (var navItem in group.Items)
                                    {
                                        var item = navItem;
                                        <li>
                                            <a href="@item.Url"
                                               class="@Cn.Merge("flex items-center gap-2 rounded-md px-2 py-1.5 text-sm text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", item.IsActive ? "bg-sidebar-accent font-medium text-sidebar-accent-foreground" : "")">
                                                <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                                <span>@item.Title</span>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                </div>

                @* Sidebar Rail *@
                <div class="absolute inset-y-0 right-0 w-px cursor-col-resize bg-transparent transition-colors hover:bg-sidebar-border"></div>
            </div>

            @* Sidebar Inset / Main Content *@
            <div class="flex min-w-0 flex-1 flex-col">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    @* Sidebar trigger button *@
                    <button type="button" class="-ml-1 flex size-7 items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Compute</a>
                            </li>
                            <li class="hidden md:flex" aria-hidden="true">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                            </li>
                            <li class="flex items-center">
                                <span role="link" aria-current="page" aria-disabled="true" class="font-normal text-foreground">Instances</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private record NavItem(string Title, string Url, string Icon, bool IsActive = false);

    private record NavGroup(string Title, bool DefaultOpen, NavItem[] Items);

    private static readonly NavGroup[] _groups =
    [
        new("Compute", true, new NavItem[]
        {
            new("Instances", "#", "server", true),
            new("Functions", "#", "zap"),
            new("Containers", "#", "container"),
        }),
        new("Storage", true, new NavItem[]
        {
            new("Buckets", "#", "box"),
            new("Databases", "#", "database"),
            new("Queues", "#", "network"),
        }),
        new("Networking", false, new NavItem[]
        {
            new("VPCs", "#", "network"),
            new("Load Balancers", "#", "server"),
            new("DNS", "#", "globe"),
        }),
        new("IAM", false, new NavItem[]
        {
            new("Users", "#", "users"),
            new("Roles", "#", "key"),
            new("Policies", "#", "shield"),
        }),
    ];

    private readonly HashSet<string> _openGroups = new(StringComparer.Ordinal);

    protected override void OnInitialized()
    {
        foreach (var grp in _groups)
        {
            if (grp.DefaultOpen)
                _openGroups.Add(grp.Title);
        }
    }

    private bool IsGroupOpen(string title) => _openGroups.Contains(title);

    private void ToggleGroup(string title)
    {
        if (_openGroups.Contains(title))
            _openGroups.Remove(title);
        else
            _openGroups.Add(title);
    }
}
