@* ============================================================
   Block: sidebar-emoji-labels
   Title: SidebarEmojiLabels
   Description: Playful sidebar navigation with React, Next.js, shadcn/ui Sidebar, and Tailwind CSS using emoji-prefixed group labels and text-only menu items for clean visual identity.
   Source: original/blocks/sidebar/sidebar-emoji-labels.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <SidebarProviderCn Class="h-[700px] !min-h-0">
            <SidebarCn Class="border-r">
                <SidebarHeaderCn>
                    <SidebarMenuCn>
                        <SidebarMenuItemCn>
                            <SidebarMenuButtonCn Size="SidebarMenuButtonSize.Lg" Href="#">
                                <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                                    <LucideIconCn Name="gallery-vertical-end" Size="16" Class="size-4" />
                                </div>
                                <div class="flex flex-col gap-0.5 leading-none">
                                    <span class="font-medium">Design System</span>
                                    <span class="text-xs text-muted-foreground">v2.4.0</span>
                                </div>
                            </SidebarMenuButtonCn>
                        </SidebarMenuItemCn>
                    </SidebarMenuCn>
                </SidebarHeaderCn>
                <SidebarContentCn>
                    @foreach (var grp in _navGroups)
                    {
                        <SidebarGroupCn>
                            <SidebarGroupLabelCn>@grp.Emoji @grp.Label</SidebarGroupLabelCn>
                            <SidebarGroupContentCn>
                                <SidebarMenuCn>
                                    @foreach (var item in grp.Items)
                                    {
                                        <SidebarMenuItemCn>
                                            <SidebarMenuButtonCn Href="@item.Url" IsActive="@item.IsActive">
                                                @item.Title
                                            </SidebarMenuButtonCn>
                                        </SidebarMenuItemCn>
                                    }
                                </SidebarMenuCn>
                            </SidebarGroupContentCn>
                        </SidebarGroupCn>
                    }
                </SidebarContentCn>
                <SidebarRailCn />
            </SidebarCn>

            <SidebarInsetCn Class="min-w-0 flex-1">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <SidebarTriggerCn Class="-ml-1" />
                    <div class="mr-2 w-px self-stretch bg-border data-[orientation=vertical]:h-4" data-orientation="vertical"></div>
                    <nav aria-label="Breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground break-words sm:gap-2.5">
                            <li class="hidden md:block">
                                <a href="#" class="transition-colors hover:text-foreground">Getting Started</a>
                            </li>
                            <li role="presentation" aria-hidden="true" class="hidden md:block [&>svg]:size-3.5">
                                <LucideIconCn Name="chevron-right" Size="14" />
                            </li>
                            <li>
                                <span role="link" aria-current="page" class="font-normal text-foreground">Introduction</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </SidebarInsetCn>
        </SidebarProviderCn>
    </div>
</section>

@code {
    private record NavItem(string Title, string Url, bool IsActive = false);
    private record NavGroup(string Emoji, string Label, NavItem[] Items);

    private static readonly NavGroup[] _navGroups =
    [
        new("🚀", "Getting Started",
        [
            new("Introduction", "#", true),
            new("Quick Start Guide", "#"),
            new("Installation", "#"),
            new("Configuration", "#"),
        ]),
        new("📦", "Components",
        [
            new("Buttons", "#"),
            new("Form Controls", "#"),
            new("Navigation", "#"),
            new("Data Display", "#"),
            new("Feedback", "#"),
        ]),
        new("🎨", "Theming",
        [
            new("Color Tokens", "#"),
            new("Typography Scale", "#"),
            new("Spacing System", "#"),
            new("Dark Mode", "#"),
        ]),
        new("🔧", "Utilities",
        [
            new("Class Merging", "#"),
            new("Responsive Helpers", "#"),
            new("Animation Presets", "#"),
        ]),
        new("📚", "Resources",
        [
            new("API Reference", "#"),
            new("Examples Gallery", "#"),
            new("Changelog", "#"),
        ]),
    ];
}
