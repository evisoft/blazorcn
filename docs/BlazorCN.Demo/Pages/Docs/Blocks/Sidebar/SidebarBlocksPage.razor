@code {
    private record FileNode(string Name, string Type, FileNode[]? Children = null, bool IsActive = false);

    private static readonly FileNode[] _fileTree =
    [
        new FileNode(""src"", ""folder"", Children:
        [
            new FileNode(""components"", ""folder"", Children:
            [
                new FileNode(""button.tsx"", ""file""),
                new FileNode(""card.tsx"", ""file""),
                new FileNode(""dialog.tsx"", ""file"", IsActive: true),
                new FileNode(""sidebar.tsx"", ""file""),
            ]),
            new FileNode(""lib"", ""folder"", Children:
            [
                new FileNode(""utils.ts"", ""file""),
                new FileNode(""cn.ts"", ""file""),
            ]),
            new FileNode(""app"", ""folder"", Children:
            [
                new FileNode(""layout.tsx"", ""file""),
                new FileNode(""page.tsx"", ""file""),
                new FileNode(""globals.css"", ""file""),
            ]),
        ]),
        new FileNode(""public"", ""folder"", Children:
        [
            new FileNode(""favicon.ico"", ""file""),
            new FileNode(""robots.txt"", ""file""),
        ]),
        new FileNode(""config"", ""folder"", Children:
        [
            new FileNode(""tailwind.config.ts"", ""file""),
            new FileNode(""tsconfig.json"", ""file""),
            new FileNode(""next.config.mjs"", ""file""),
        ]),
    ];

    // Track open/closed state by node path (name path joined by ""/"")
    private readonly HashSet<string> _openFolders = new() { ""src"", ""src/components"" };

    private bool IsOpen(string path) => _openFolders.Contains(path);

    private void ToggleFolder(string path)
    {
        if (_openFolders.Contains(path))
            _openFolders.Remove(path);
        else
            _openFolders.Add(path);
    }

    private RenderFragment RenderFolder(FileNode node, int depth, string parentPath = """") => builder =>
    {
        var path = parentPath.Length > 0 ? $""{parentPath}/{node.Name}"" : node.Name;
        var isOpen = IsOpen(path);
        var capPath = path;

        builder.OpenElement(0, ""li"");
        builder.AddAttribute(1, ""class"", ""group/collapsible"");

        // Collapsible trigger row
        builder.OpenElement(2, ""div"");
        builder.AddAttribute(3, ""class"", ""relative flex items-center"");

        builder.OpenElement(4, ""button"");
        builder.AddAttribute(5, ""type"", ""button"");
        builder.AddAttribute(6, ""onclick"", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => ToggleFolder(capPath)));
        builder.AddAttribute(7, ""class"", ""flex flex-1 items-center gap-1 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground"");

        // Chevron icon
        builder.OpenComponent<LucideIconCn>(8);
        builder.AddAttribute(9, ""Name"", ""chevron-right"");
        builder.AddAttribute(10, ""Size"", 16);
        builder.AddAttribute(11, ""Class"", Cn.Merge(""size-4 shrink-0 transition-transform duration-200"", isOpen ? ""rotate-90"" : """"));
        builder.CloseComponent();

        // Folder icon
        builder.OpenComponent<LucideIconCn>(12);
        builder.AddAttribute(13, ""Name"", ""folder"");
        builder.AddAttribute(14, ""Size"", 16);
        builder.AddAttribute(15, ""Class"", ""size-4 shrink-0"");
        builder.CloseComponent();

        builder.OpenElement(16, ""span"");
        builder.AddContent(17, node.Name);
        builder.CloseElement();

        builder.CloseElement(); // button
        builder.CloseElement(); // div.relative

        // Children when open
        if (isOpen && node.Children != null)
        {
            builder.OpenElement(18, ""ul"");
            builder.AddAttribute(19, ""class"", ""ml-4 mt-0.5 space-y-0.5 border-l border-sidebar-border pl-2"");

            foreach (var child in node.Children)
            {
                if (child.Type == ""folder"")
                {
                    builder.AddContent(20, RenderFolder(child, depth + 1, capPath));
                }
                else
                {
                    var fileNode = child;
                    builder.OpenElement(21, ""li"");
                    builder.OpenElement(22, ""a"");
                    builder.AddAttribute(23, ""href"", ""#"");
                    builder.AddAttribute(24, ""class"", Cn.Merge(
                        ""flex items-center gap-1 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground"",
                        fileNode.IsActive ? ""bg-sidebar-accent text-sidebar-accent-foreground font-medium"" : """"));

                    // File icon — .md and .txt get file-text, else file
                    var iconName = (fileNode.Name.EndsWith("".md"") || fileNode.Name.EndsWith("".txt"")) ? ""file-text"" : ""file"";
                    builder.OpenComponent<LucideIconCn>(25);
                    builder.AddAttribute(26, ""Name"", iconName);
                    builder.AddAttribute(27, ""Size"", 16);
                    builder.AddAttribute(28, ""Class"", ""size-4 shrink-0"");
                    builder.CloseComponent();

                    builder.OpenElement(29, ""span"");
                    builder.AddContent(30, fileNode.Name);
                    builder.CloseElement();

                    builder.CloseElement(); // a
                    builder.CloseElement(); // li
                }
            }

            builder.CloseElement(); // ul
        }

        builder.CloseElement(); // li
    };
}";

