@* ============================================================
   Block: sidebar-api-docs
   Title: SidebarApiDocs
   Description: A React API documentation sidebar with grouped endpoints, HTTP method badges, and sections for Authentication, Webhooks, and SDKs. Built with Next.js, shadcn/ui Sidebar, and Tailwind CSS.
   Source: original/blocks/sidebar/sidebar-api-docs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px] w-full">

            @* Sidebar *@
            <div class="flex h-full w-64 shrink-0 flex-col border-r bg-sidebar">

                @* Sidebar Header *@
                <div class="flex h-16 items-center px-4 py-2">
                    <a href="#" class="flex items-center gap-3 rounded-md px-2 py-2 text-sm font-medium hover:bg-sidebar-accent hover:text-sidebar-accent-foreground w-full">
                        <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                            <LucideIconCn Name="book-open" Size="16" Class="size-4" />
                        </div>
                        <div class="flex flex-col gap-0.5 leading-none">
                            <span class="font-medium">API Reference</span>
                            <span class="">v2.0</span>
                        </div>
                    </a>
                </div>

                @* Sidebar Content *@
                <div class="flex-1 overflow-y-auto px-2 py-2">

                    @* Authentication Group *@
                    <div class="mb-2">
                        <div class="flex items-center px-2 py-1.5 text-xs font-medium text-sidebar-foreground/70">
                            <LucideIconCn Name="key" Size="14" Class="mr-1.5 size-3.5" />
                            Authentication
                        </div>
                        <ul class="space-y-0.5">
                            @foreach (var item in _authItems)
                            {
                                <li>
                                    <a href="@item.Url" class="flex items-center rounded-md px-2 py-1.5 text-sm text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                                        @item.Title
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    @* Endpoints Group *@
                    <div class="mb-2">
                        <div class="flex items-center px-2 py-1.5 text-xs font-medium text-sidebar-foreground/70">
                            <LucideIconCn Name="box" Size="14" Class="mr-1.5 size-3.5" />
                            Endpoints
                        </div>
                        <ul class="space-y-0.5">
                            @foreach (var resource in _endpoints)
                            {
                                <li>
                                    <a href="#" class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                                        <LucideIconCn Name="@resource.Icon" Size="16" Class="size-4" />
                                        <span>@resource.Title</span>
                                    </a>
                                    <ul class="ml-6 mt-0.5 space-y-0.5 border-l border-sidebar-border pl-2">
                                        @foreach (var endpointItem in resource.Items)
                                        {
                                            var isActive = endpointItem.IsActive;
                                            <li>
                                                <a href="@endpointItem.Url"
                                                   class="@Cn.Merge("flex items-center rounded-md px-2 py-1.5 text-sm text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", isActive ? "bg-sidebar-accent font-medium text-sidebar-accent-foreground" : "")">
                                                    <span class="@Cn.Merge("mr-1 font-mono text-[10px] font-semibold", _methodColors.TryGetValue(endpointItem.Method, out var mc) ? mc : "")">@endpointItem.Method</span>
                                                    <span>@endpointItem.Title</span>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                            }
                        </ul>
                    </div>

                    @* Webhooks Group *@
                    <div class="mb-2">
                        <div class="flex items-center px-2 py-1.5 text-xs font-medium text-sidebar-foreground/70">
                            <LucideIconCn Name="webhook" Size="14" Class="mr-1.5 size-3.5" />
                            Webhooks
                        </div>
                        <ul class="space-y-0.5">
                            @foreach (var item in _webhookItems)
                            {
                                <li>
                                    <a href="@item.Url" class="flex items-center rounded-md px-2 py-1.5 text-sm text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                                        @item.Title
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    @* SDKs Group *@
                    <div class="mb-2">
                        <div class="flex items-center px-2 py-1.5 text-xs font-medium text-sidebar-foreground/70">
                            <LucideIconCn Name="code" Size="14" Class="mr-1.5 size-3.5" />
                            SDKs
                        </div>
                        <ul class="space-y-0.5">
                            @foreach (var item in _sdkItems)
                            {
                                <li>
                                    <a href="@item.Url" class="flex items-center rounded-md px-2 py-1.5 text-sm text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                                        @item.Title
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                </div>

                @* Sidebar Rail (thin resize handle) *@
                <div class="absolute inset-y-0 right-0 w-px cursor-col-resize bg-transparent transition-colors hover:bg-sidebar-border"></div>
            </div>

            @* Sidebar Inset / Main Content *@
            <div class="flex min-w-0 flex-1 flex-col">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    @* Sidebar trigger button *@
                    <button type="button" class="-ml-1 flex size-7 items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Section</a>
                            </li>
                            <li class="hidden md:flex" aria-hidden="true">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                            </li>
                            <li class="flex items-center">
                                <span role="link" aria-current="page" aria-disabled="true" class="font-normal text-foreground">Page</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private static readonly Dictionary<string, string> _methodColors = new()
    {
        ["GET"] = "text-emerald-600",
        ["POST"] = "text-blue-600",
        ["PUT"] = "text-amber-600",
        ["DELETE"] = "text-red-600",
    };

    private record NavItem(string Title, string Url);

    private record EndpointItem(string Title, string Method, string Url, bool IsActive = false);

    private record EndpointGroup(string Title, string Icon, EndpointItem[] Items);

    private static readonly NavItem[] _authItems =
    [
        new("Overview", "#"),
        new("API Keys", "#"),
        new("OAuth 2.0", "#"),
        new("JWT Tokens", "#"),
    ];

    private static readonly EndpointGroup[] _endpoints =
    [
        new("Users", "users", new EndpointItem[]
        {
            new("List Users", "GET", "#", true),
            new("Create User", "POST", "#"),
            new("Update User", "PUT", "#"),
            new("Delete User", "DELETE", "#"),
        }),
        new("Products", "package", new EndpointItem[]
        {
            new("List Products", "GET", "#"),
            new("Create Product", "POST", "#"),
            new("Update Product", "PUT", "#"),
            new("Delete Product", "DELETE", "#"),
        }),
        new("Orders", "shopping-cart", new EndpointItem[]
        {
            new("List Orders", "GET", "#"),
            new("Create Order", "POST", "#"),
            new("Update Order", "PUT", "#"),
            new("Cancel Order", "DELETE", "#"),
        }),
    ];

    private static readonly NavItem[] _webhookItems =
    [
        new("Overview", "#"),
        new("Event Types", "#"),
        new("Signatures", "#"),
        new("Retry Policy", "#"),
    ];

    private static readonly NavItem[] _sdkItems =
    [
        new("JavaScript / TypeScript", "#"),
        new("Python", "#"),
        new("Go", "#"),
        new("Ruby", "#"),
    ];
}
