@* ============================================================
   Block: sidebar-dark-theme
   Title: SidebarDarkTheme
   Description: A React sidebar with dark zinc-950 background and light text contrasting against light content using Next.js, shadcn/ui Sidebar, and Tailwind CSS.
   Source: original/blocks/sidebar/sidebar-dark-theme.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px]">
            @* Sidebar — dark zinc-950 theme *@
            <div class="flex w-64 shrink-0 flex-col border-r border-zinc-800 bg-zinc-950 text-zinc-100">
                @* Sidebar Header *@
                <div class="flex h-16 items-center border-b border-zinc-800 px-2">
                    <a href="#" class="flex w-full items-center gap-2 rounded-md p-2 hover:bg-zinc-800/50 hover:text-zinc-100">
                        <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-zinc-100 text-zinc-950">
                            <LucideIconCn Name="terminal" Size="16" Class="size-4" />
                        </div>
                        <div class="flex flex-col gap-0.5 leading-none">
                            <span class="font-medium text-zinc-100">DevConsole</span>
                            <span class="text-xs text-zinc-500">v2.4.1</span>
                        </div>
                    </a>
                </div>

                @* Sidebar Content *@
                <div class="flex flex-1 flex-col gap-2 overflow-y-auto py-2">
                    @* Navigation Group *@
                    <div class="px-2">
                        <span class="px-2 py-1 text-xs font-medium text-zinc-500">Navigation</span>
                        <ul class="mt-1 space-y-0.5">
                            @foreach (var nav in _mainNav)
                            {
                                var item = nav;
                                <li>
                                    <a href="@item.Url"
                                       class="@Cn.Merge("flex items-center gap-2 rounded-md px-2 py-1.5 text-sm text-zinc-400 hover:bg-zinc-800/50 hover:text-zinc-100", item.IsActive ? "bg-zinc-800 text-zinc-50" : "")">
                                        <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                        <span>@item.Title</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    @* Tools Group *@
                    <div class="px-2">
                        <span class="px-2 py-1 text-xs font-medium text-zinc-500">Tools</span>
                        <ul class="mt-1 space-y-0.5">
                            @foreach (var tool in _tools)
                            {
                                var item = tool;
                                <li>
                                    <a href="@item.Url"
                                       class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm text-zinc-400 hover:bg-zinc-800/50 hover:text-zinc-100">
                                        <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                        <span>@item.Title</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                @* Sidebar Footer *@
                <div class="border-t border-zinc-800 p-2">
                    <a href="#" class="flex items-center gap-3 rounded-md px-2 py-1.5 text-sm text-zinc-400 hover:bg-zinc-800/50 hover:text-zinc-100">
                        <LucideIconCn Name="circle-user" Size="20" Class="size-5" />
                        <div class="grid flex-1 text-left text-sm leading-tight">
                            <span class="truncate font-medium text-zinc-200">developer</span>
                            <span class="truncate text-xs text-zinc-500">dev@@example.com</span>
                        </div>
                    </a>
                </div>

                @* Sidebar Rail *@
                <div class="absolute inset-y-0 right-0 w-px bg-zinc-800 opacity-0 hover:opacity-100 cursor-col-resize"></div>
            </div>

            @* Main Content (SidebarInset) *@
            <div class="flex min-w-0 flex-1 flex-col">
                @* Header *@
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    @* Sidebar trigger *@
                    <button type="button" class="-ml-1 flex size-8 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    @* Vertical separator *@
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Navigation</a>
                            </li>
                            <li class="hidden md:flex [&>svg]:size-3.5 [&>svg]:text-muted-foreground/70">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 text-muted-foreground/70" />
                            </li>
                            <li class="flex items-center">
                                <span role="link" aria-disabled="true" aria-current="page" class="font-normal text-foreground">Dashboard</span>
                            </li>
                        </ol>
                    </nav>
                </header>

                @* Body *@
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record NavItem(string Title, string Url, string Icon, bool IsActive = false);

    private static readonly NavItem[] _mainNav =
    [
        new("Dashboard", "#", "layout-dashboard", true),
        new("Projects", "#", "package"),
        new("Source Code", "#", "code"),
        new("Branches", "#", "git-branch"),
        new("Deployments", "#", "play"),
    ];

    private static readonly NavItem[] _tools =
    [
        new("Terminal", "#", "terminal"),
        new("Packages", "#", "box"),
        new("Documentation", "#", "file-text"),
        new("Settings", "#", "settings"),
    ];
}
