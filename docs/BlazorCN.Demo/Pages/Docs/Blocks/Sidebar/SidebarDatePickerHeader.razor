@* ============================================================
   Block: sidebar-date-picker-header
   Title: SidebarDatePickerHeader
   Description: A React sidebar with compact date display header and time-based navigation for day, week, month, and year views using Next.js, shadcn/ui Sidebar, and Tailwind CSS.
   Source: original/blocks/sidebar/sidebar-date-picker-header.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <SidebarProviderCn Class="h-[700px] !min-h-0">
            <SidebarCn Class="border-r">
                <SidebarHeaderCn>
                    <div class="px-3 py-4">
                        <div class="flex items-center justify-between">
                            <button type="button" aria-label="Previous month" class="flex size-7 items-center justify-center rounded-md hover:bg-sidebar-accent">
                                <LucideIconCn Name="chevron-left" Size="16" Class="size-4" />
                            </button>
                            <div class="text-center">
                                <p class="font-medium text-sm">March 2026</p>
                            </div>
                            <button type="button" aria-label="Next month" class="flex size-7 items-center justify-center rounded-md hover:bg-sidebar-accent">
                                <LucideIconCn Name="chevron-right" Size="16" Class="size-4" />
                            </button>
                        </div>
                        <div class="mt-3 flex items-center justify-center gap-2 rounded-md bg-sidebar-accent px-3 py-2">
                            <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                            <span class="font-semibold text-2xl tabular-nums">24</span>
                            <div class="flex flex-col text-left leading-tight">
                                <span class="text-xs font-medium">Tuesday</span>
                                <span class="text-xs text-muted-foreground">March 2026</span>
                            </div>
                        </div>
                        <div class="mt-3 flex justify-center">
                            <button type="button" class="flex h-7 items-center gap-1.5 rounded-md bg-sidebar-primary px-3 text-xs font-medium text-sidebar-primary-foreground hover:bg-sidebar-primary/90">
                                <LucideIconCn Name="plus" Size="12" Class="size-3" />
                                New Event
                            </button>
                        </div>
                    </div>
                </SidebarHeaderCn>
                <SidebarContentCn>
                    @foreach (var grp in _timeViews)
                    {
                        <SidebarGroupCn>
                            <SidebarGroupLabelCn>@grp.Title</SidebarGroupLabelCn>
                            <SidebarGroupContentCn>
                                <SidebarMenuCn>
                                    @foreach (var item in grp.Items)
                                    {
                                        <SidebarMenuItemCn>
                                            <SidebarMenuButtonCn Href="@item.Url" IsActive="@item.IsActive">
                                                <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                                <span>@item.Title</span>
                                            </SidebarMenuButtonCn>
                                            @if (!string.IsNullOrEmpty(item.Badge))
                                            {
                                                <SidebarMenuBadgeCn>@item.Badge</SidebarMenuBadgeCn>
                                            }
                                        </SidebarMenuItemCn>
                                    }
                                </SidebarMenuCn>
                            </SidebarGroupContentCn>
                        </SidebarGroupCn>
                    }
                </SidebarContentCn>
                <SidebarRailCn />
            </SidebarCn>

            <SidebarInsetCn Class="min-w-0 flex-1">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <SidebarTriggerCn Class="-ml-1" />
                    <div class="mr-2 w-px self-stretch bg-border data-[orientation=vertical]:h-4" data-orientation="vertical"></div>
                    <nav aria-label="Breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground break-words sm:gap-2.5">
                            <li class="hidden md:block">
                                <a href="#" class="transition-colors hover:text-foreground">Day Views</a>
                            </li>
                            <li role="presentation" aria-hidden="true" class="hidden md:block [&>svg]:size-3.5">
                                <LucideIconCn Name="chevron-right" Size="14" />
                            </li>
                            <li>
                                <span role="link" aria-current="page" class="font-normal text-foreground">Schedule</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </SidebarInsetCn>
        </SidebarProviderCn>
    </div>
</section>

@code {
    private record NavItem(string Title, string Url, string Icon, string Badge = "", bool IsActive = false);
    private record NavGroup(string Title, NavItem[] Items);

    private static readonly NavGroup[] _timeViews =
    [
        new("Day Views",
        [
            new("Schedule", "#", "clock", IsActive: true),
            new("Timeline", "#", "list"),
            new("Agenda", "#", "calendar"),
        ]),
        new("Week Views",
        [
            new("Work Week", "#", "calendar-days", Badge: "12"),
            new("Full Week", "#", "calendar-range", Badge: "18"),
            new("Team Schedule", "#", "users"),
        ]),
        new("Month Views",
        [
            new("Calendar Grid", "#", "calendar", Badge: "47"),
            new("List View", "#", "list"),
        ]),
        new("Year Views",
        [
            new("Overview", "#", "sun"),
            new("Heatmap", "#", "calendar-days"),
        ]),
    ];
}
