@* ============================================================
   Block: sidebar-version-switcher
   Title: SidebarVersionSwitcher
   Description: A React documentation sidebar with Next.js, shadcn/ui DropdownMenu version switcher, and Tailwind CSS. Displays app name, version selector, and check icon for active version.
   Source: original/blocks/sidebar/sidebar-version-switcher.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px] w-full">

            @* Sidebar *@
            <div class="flex h-full w-64 shrink-0 flex-col border-r bg-sidebar">

                @* Sidebar Header *@
                <div class="flex shrink-0 flex-col gap-2 p-2">
                    <div class="relative">
                        <button type="button"
                                class="flex w-full items-center gap-2 rounded-lg p-2 text-left text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground"
                                @onclick="@(() => _dropdownOpen = !_dropdownOpen)">
                            <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                                <LucideIconCn Name="gallery-vertical-end" Size="16" Class="size-4" />
                            </div>
                            <div class="flex flex-col gap-0.5 leading-none">
                                <span class="font-medium">API Docs</span>
                                <span class="">@_selectedVersion</span>
                            </div>
                            <LucideIconCn Name="chevrons-up-down" Size="16" Class="ml-auto size-4" />
                        </button>

                        @if (_dropdownOpen)
                        {
                            <div class="absolute left-0 top-full z-50 mt-1 w-full rounded-md border bg-popover p-1 shadow-md">
                                @foreach (var ver in _versions)
                                {
                                    var version = ver;
                                    <button type="button"
                                            class="flex w-full items-center rounded-sm px-2 py-1.5 text-sm hover:bg-accent hover:text-accent-foreground"
                                            @onclick="@(() => SelectVersion(version))">
                                        @version
                                        @if (version == _selectedVersion)
                                        {
                                            <LucideIconCn Name="check" Size="16" Class="ml-auto size-4" />
                                        }
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>

                @* Sidebar Content *@
                <div class="flex-1 overflow-y-auto px-2 py-2">
                    @foreach (var grp in _navMain)
                    {
                        var group = grp;
                        <div class="mb-2">
                            <div class="px-2 py-1.5 text-xs font-medium text-sidebar-foreground/70">
                                @group.Title
                            </div>
                            <ul class="space-y-0.5">
                                @foreach (var it in group.Items)
                                {
                                    var item = it;
                                    <li>
                                        <a href="@item.Url"
                                           class="@Cn.Merge("flex items-center rounded-md px-2 py-1.5 text-sm text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", item.IsActive ? "bg-sidebar-accent font-medium text-sidebar-accent-foreground" : "")">
                                            @item.Title
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>

                @* Sidebar Rail *@
                <div class="absolute inset-y-0 right-0 w-px cursor-col-resize bg-transparent transition-colors hover:bg-sidebar-border"></div>
            </div>

            @* Sidebar Inset / Main Content *@
            <div class="flex min-w-0 flex-1 flex-col">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    @* Sidebar trigger button *@
                    <button type="button" class="-ml-1 flex size-7 items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Getting Started</a>
                            </li>
                            <li class="hidden md:flex" aria-hidden="true">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                            </li>
                            <li class="flex items-center">
                                <span role="link" aria-current="page" aria-disabled="true" class="font-normal text-foreground">Installation</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private bool _dropdownOpen = false;

    private static readonly string[] _versions = ["v3.0.0", "v2.4.1", "v2.3.0", "v1.9.2", "v1.0.0"];

    private string _selectedVersion = "v3.0.0";

    private void SelectVersion(string version)
    {
        _selectedVersion = version;
        _dropdownOpen = false;
    }

    private record NavItem(string Title, string Url, bool IsActive = false);

    private record NavGroup(string Title, NavItem[] Items);

    private static readonly NavGroup[] _navMain =
    [
        new("Getting Started", new NavItem[]
        {
            new("Introduction", "#"),
            new("Installation", "#", true),
            new("Quick Start", "#"),
        }),
        new("API Reference", new NavItem[]
        {
            new("Authentication", "#"),
            new("Endpoints", "#"),
            new("Rate Limits", "#"),
            new("Errors", "#"),
            new("Webhooks", "#"),
        }),
        new("SDKs", new NavItem[]
        {
            new("JavaScript", "#"),
            new("Python", "#"),
            new("Go", "#"),
            new("Ruby", "#"),
        }),
        new("Resources", new NavItem[]
        {
            new("Migration Guide", "#"),
            new("Examples", "#"),
            new("Community", "#"),
        }),
    ];
}
