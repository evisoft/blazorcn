@* ============================================================
   Block: sidebar-calendar-app
   Title: SidebarCalendarApp
   Description: React calendar sidebar with view switching, toggleable calendar sources, and color-coded tags using Next.js, shadcn/ui Sidebar, and Tailwind CSS. Features interactive calendar filters.
   Source: original/blocks/sidebar/sidebar-calendar-app.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <SidebarProviderCn Class="h-[700px] !min-h-0">
            <SidebarCn Class="border-r">
                <SidebarHeaderCn>
                    <SidebarMenuCn>
                        <SidebarMenuItemCn>
                            <SidebarMenuButtonCn Size="SidebarMenuButtonSize.Lg" Href="#">
                                <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                                    <LucideIconCn Name="calendar-days" Size="16" Class="size-4" />
                                </div>
                                <div class="flex flex-col gap-0.5 leading-none">
                                    <span class="font-medium">Calendar</span>
                                    <span class="text-xs text-muted-foreground">March 2026</span>
                                </div>
                            </SidebarMenuButtonCn>
                        </SidebarMenuItemCn>
                    </SidebarMenuCn>
                </SidebarHeaderCn>
                <SidebarContentCn>
                    <SidebarGroupCn>
                        <SidebarGroupLabelCn>Views</SidebarGroupLabelCn>
                        <SidebarGroupContentCn>
                            <SidebarMenuCn>
                                @foreach (var view in _views)
                                {
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn Href="@view.Url" IsActive="@view.IsActive">
                                            <LucideIconCn Name="@view.Icon" Size="16" Class="size-4" />
                                            <span>@view.Title</span>
                                        </SidebarMenuButtonCn>
                                    </SidebarMenuItemCn>
                                }
                            </SidebarMenuCn>
                        </SidebarGroupContentCn>
                    </SidebarGroupCn>

                    <SidebarGroupCn>
                        <SidebarGroupLabelCn>Calendars</SidebarGroupLabelCn>
                        <SidebarGroupContentCn>
                            <SidebarMenuCn>
                                @foreach (var cal in _calendars)
                                {
                                    var calendar = cal;
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn Class="gap-3" OnClick="@(() => ToggleCalendar(calendar.Title))">
                                            <span class="@Cn.Merge("size-2 shrink-0 rounded-full", calendar.Color, _activeCalendars.Contains(calendar.Title) ? "opacity-100" : "opacity-30")"></span>
                                            <span class="@Cn.Merge("", _activeCalendars.Contains(calendar.Title) ? "" : "text-muted-foreground line-through")">@calendar.Title</span>
                                        </SidebarMenuButtonCn>
                                    </SidebarMenuItemCn>
                                }
                            </SidebarMenuCn>
                        </SidebarGroupContentCn>
                    </SidebarGroupCn>

                    <SidebarGroupCn>
                        <SidebarGroupLabelCn>Tags</SidebarGroupLabelCn>
                        <SidebarGroupContentCn>
                            <SidebarMenuCn>
                                @foreach (var tag in _tags)
                                {
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn Href="#" Class="gap-3">
                                            <LucideIconCn Name="tag" Size="16" Class="size-4 text-muted-foreground" />
                                            <span>@tag.Title</span>
                                            <span class="@Cn.Merge("ml-auto size-2 shrink-0 rounded-full", tag.Color)"></span>
                                        </SidebarMenuButtonCn>
                                    </SidebarMenuItemCn>
                                }
                            </SidebarMenuCn>
                        </SidebarGroupContentCn>
                    </SidebarGroupCn>
                </SidebarContentCn>
                <SidebarRailCn />
            </SidebarCn>

            <SidebarInsetCn Class="min-w-0 flex-1">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <SidebarTriggerCn Class="-ml-1" />
                    <div class="mr-2 w-px self-stretch bg-border data-[orientation=vertical]:h-4" data-orientation="vertical"></div>
                    <nav aria-label="Breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground break-words sm:gap-2.5">
                            <li class="hidden md:block">
                                <a href="#" class="transition-colors hover:text-foreground">Section</a>
                            </li>
                            <li role="presentation" aria-hidden="true" class="hidden md:block [&>svg]:size-3.5">
                                <LucideIconCn Name="chevron-right" Size="14" />
                            </li>
                            <li>
                                <span role="link" aria-current="page" class="font-normal text-foreground">Page</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </SidebarInsetCn>
        </SidebarProviderCn>
    </div>
</section>

@code {
    private record ViewItem(string Title, string Url, string Icon, bool IsActive = false);
    private record CalendarItem(string Title, string Color, bool DefaultActive);
    private record TagItem(string Title, string Color);

    private static readonly ViewItem[] _views =
    [
        new("Day", "#", "calendar"),
        new("Week", "#", "calendar-days", true),
        new("Month", "#", "calendar-range"),
        new("Year", "#", "columns-3"),
    ];

    private static readonly CalendarItem[] _calendars =
    [
        new("Personal", "bg-blue-500", true),
        new("Work", "bg-emerald-500", true),
        new("Holidays", "bg-red-500", true),
        new("Birthdays", "bg-violet-500", false),
        new("Reminders", "bg-amber-500", true),
    ];

    private static readonly TagItem[] _tags =
    [
        new("Meeting", "bg-blue-500"),
        new("Focus Time", "bg-emerald-500"),
        new("Travel", "bg-amber-500"),
        new("Deadline", "bg-red-500"),
    ];

    private HashSet<string> _activeCalendars = [];

    protected override void OnInitialized()
    {
        foreach (var cal in _calendars)
        {
            if (cal.DefaultActive)
                _activeCalendars.Add(cal.Title);
        }
    }

    private void ToggleCalendar(string title)
    {
        if (!_activeCalendars.Add(title))
            _activeCalendars.Remove(title);
    }
}
