@* ============================================================
   Block: sidebar-data-science
   Title: SidebarDataScience
   Description: A React data science platform sidebar with collapsible groups for workspace, ML pipelines, and compute resources using Next.js, shadcn/ui Sidebar, and Tailwind CSS.
   Source: original/blocks/sidebar/sidebar-data-science.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px]">
            @* Sidebar *@
            <div class="flex w-64 shrink-0 flex-col border-r bg-sidebar">
                @* Sidebar Header *@
                <div class="flex h-16 items-center border-b px-2">
                    <a href="#" class="flex w-full items-center gap-2 rounded-md p-2 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                        <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                            <LucideIconCn Name="sparkles" Size="16" Class="size-4" />
                        </div>
                        <div class="flex flex-col gap-0.5 leading-none">
                            <span class="font-medium">ML Studio</span>
                            <span class="text-xs">research-lab</span>
                        </div>
                    </a>
                </div>

                @* Sidebar Content — collapsible groups *@
                <div class="flex flex-1 flex-col overflow-y-auto py-2">
                    @foreach (var grp in _groups)
                    {
                        var group = grp;
                        <div class="px-2">
                            @* Collapsible trigger — group label row *@
                            <button type="button"
                                    class="flex w-full items-center rounded-md px-2 py-1 text-xs font-medium text-sidebar-foreground/60 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground transition-colors"
                                    @onclick="@(() => ToggleGroup(group.Title))">
                                <span>@group.Title</span>
                                <LucideIconCn Name="chevron-right" Size="16"
                                    Class="@Cn.Merge("ml-auto size-4 transition-transform duration-200", IsGroupOpen(group.Title) ? "rotate-90" : "")" />
                            </button>
                            @* Collapsible content *@
                            @if (IsGroupOpen(group.Title))
                            {
                                <ul class="mt-0.5 space-y-0.5">
                                    @foreach (var itm in group.Items)
                                    {
                                        var item = itm;
                                        <li>
                                            <a href="@item.Url"
                                               class="@Cn.Merge("flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", item.IsActive ? "bg-sidebar-accent text-sidebar-accent-foreground font-medium" : "")">
                                                <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                                <span>@item.Title</span>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                </div>

                @* Sidebar Rail *@
                <div class="absolute inset-y-0 right-0 w-px bg-border opacity-0 hover:opacity-100 cursor-col-resize"></div>
            </div>

            @* Main Content (SidebarInset) *@
            <div class="flex min-w-0 flex-1 flex-col">
                @* Header *@
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <button type="button" class="-ml-1 flex size-8 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Workspace</a>
                            </li>
                            <li class="hidden md:flex [&>svg]:size-3.5 [&>svg]:text-muted-foreground/70">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 text-muted-foreground/70" />
                            </li>
                            <li class="flex items-center">
                                <span role="link" aria-disabled="true" aria-current="page" class="font-normal text-foreground">Notebooks</span>
                            </li>
                        </ol>
                    </nav>
                </header>

                @* Body *@
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record NavItem(string Title, string Url, string Icon, bool IsActive = false);
    private record NavGroup(string Title, bool DefaultOpen, NavItem[] Items);

    private static readonly NavGroup[] _groups =
    [
        new("Workspace", true,
        [
            new("Notebooks", "#", "notebook-pen", true),
            new("Datasets", "#", "database"),
            new("Models", "#", "brain-circuit"),
        ]),
        new("Pipelines", true,
        [
            new("Training", "#", "flask-conical"),
            new("Inference", "#", "play"),
            new("Monitoring", "#", "activity"),
        ]),
        new("Resources", false,
        [
            new("Compute", "#", "cpu"),
            new("Storage", "#", "hard-drive"),
            new("Secrets", "#", "key"),
        ]),
    ];

    private Dictionary<string, bool> _openGroups = _groups
        .ToDictionary(g => g.Title, g => g.DefaultOpen);

    private bool IsGroupOpen(string title) =>
        _openGroups.TryGetValue(title, out var open) && open;

    private void ToggleGroup(string title)
    {
        if (_openGroups.ContainsKey(title))
            _openGroups[title] = !_openGroups[title];
    }
}
