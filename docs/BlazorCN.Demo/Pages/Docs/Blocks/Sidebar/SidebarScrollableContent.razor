@* ============================================================
   Block: sidebar-scrollable-content
   Title: SidebarScrollableContent
   Description: React sidebar with 30+ navigation items demonstrating natural scrolling with Next.js, shadcn/ui SidebarContent components, and Tailwind CSS styling.
   Source: original/blocks/sidebar/sidebar-scrollable-content.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px]">
            @* Sidebar *@
            <div class="flex w-64 shrink-0 flex-col border-r bg-sidebar">
                @* Sidebar Header *@
                <div class="flex h-16 items-center border-b px-2">
                    <a href="#" class="flex w-full items-center gap-2 rounded-md p-2 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                        <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                            <LucideIconCn Name="gallery-vertical-end" Size="16" Class="size-4" />
                        </div>
                        <div class="flex flex-col gap-0.5 leading-none">
                            <span class="font-medium">Platform</span>
                            <span class="text-xs text-muted-foreground">Admin Console</span>
                        </div>
                    </a>
                </div>

                @* Sidebar Content — scrollable groups *@
                <div class="flex flex-1 flex-col overflow-y-auto py-2">
                    @foreach (var grp in _groups)
                    {
                        <div class="px-2">
                            <p class="px-2 py-1 text-xs font-medium text-sidebar-foreground/60">@grp.Label</p>
                            <ul class="space-y-0.5">
                                @foreach (var itm in grp.Items)
                                {
                                    var item = itm;
                                    <li>
                                        <a href="#"
                                           class="@Cn.Merge("flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", item.IsActive ? "bg-sidebar-accent text-sidebar-accent-foreground font-medium" : "")">
                                            <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                            <span>@item.Title</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>

                @* Sidebar Footer *@
                <div class="border-t px-2 py-2">
                    <a href="#" class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                        <LucideIconCn Name="settings" Size="16" Class="size-4" />
                        <span>Preferences</span>
                    </a>
                </div>
            </div>

            @* Main Content (SidebarInset) *@
            <div class="flex min-w-0 flex-1 flex-col">
                @* Header *@
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <button type="button" class="-ml-1 flex size-8 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Overview</a>
                            </li>
                            <li class="hidden md:flex [&>svg]:size-3.5 [&>svg]:text-muted-foreground/70">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 text-muted-foreground/70" />
                            </li>
                            <li class="flex items-center">
                                <span role="link" aria-disabled="true" aria-current="page" class="font-normal text-foreground">Dashboard</span>
                            </li>
                        </ol>
                    </nav>
                </header>

                @* Body *@
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record NavItem(string Title, string Icon, bool IsActive = false);
    private record NavGroup(string Label, NavItem[] Items);

    private static readonly NavGroup[] _groups =
    [
        new("Overview",
        [
            new("Dashboard", "layout-dashboard", true),
            new("Activity Feed", "zap"),
            new("Notifications", "bell"),
            new("Search", "search"),
        ]),
        new("Content",
        [
            new("Documents", "file-text"),
            new("Media Library", "folder"),
            new("Blog Posts", "book-open"),
            new("Pages", "globe"),
            new("Templates", "clipboard"),
            new("Tags", "tag"),
        ]),
        new("Communication",
        [
            new("Inbox", "inbox"),
            new("Messages", "message-square"),
            new("Email Campaigns", "mail"),
            new("Calendar", "calendar"),
        ]),
        new("Analytics",
        [
            new("Reports", "bar-chart"),
            new("Conversions", "circle-check"),
            new("Link Tracking", "link"),
            new("Audience", "users"),
        ]),
        new("Developer",
        [
            new("API Keys", "key"),
            new("Webhooks", "code"),
            new("Database", "database"),
            new("Integrations", "smartphone"),
        ]),
        new("Settings",
        [
            new("General", "settings"),
            new("Appearance", "palette"),
            new("Security", "shield"),
            new("Privacy", "lock"),
            new("Billing", "credit-card"),
            new("Team", "users"),
        ]),
    ];
}
