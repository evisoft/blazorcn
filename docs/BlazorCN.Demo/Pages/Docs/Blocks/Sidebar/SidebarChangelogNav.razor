@* ============================================================
   Block: sidebar-changelog-nav
   Title: SidebarChangelogNav
   Description: React changelog sidebar with version-grouped collapsible navigation and dated entries using Next.js, shadcn/ui Sidebar, and Tailwind CSS. Features expandable version sections with release dates.
   Source: original/blocks/sidebar/sidebar-changelog-nav.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px] w-full">

            @* Sidebar *@
            <div class="flex h-full w-64 shrink-0 flex-col border-r bg-sidebar">

                @* Sidebar Header *@
                <div class="flex h-16 items-center px-4 py-2">
                    <a href="#" class="flex items-center gap-3 rounded-md px-2 py-2 text-sm font-medium hover:bg-sidebar-accent hover:text-sidebar-accent-foreground w-full">
                        <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                            <LucideIconCn Name="tag" Size="16" Class="size-4" />
                        </div>
                        <div class="flex flex-col gap-0.5 leading-none">
                            <span class="font-medium">Changelog</span>
                            <span class="">Release Notes</span>
                        </div>
                    </a>
                </div>

                @* Sidebar Content — version groups *@
                <div class="flex-1 overflow-y-auto px-2 py-2">
                    @foreach (var grp in _versions)
                    {
                        var group = grp;
                        var isOpen = _openGroups.Contains(group.Version);
                        <div class="mb-1">
                            @* Group label / collapsible trigger *@
                            <button type="button"
                                    class="flex w-full items-center rounded-md px-2 py-1.5 text-xs font-medium text-sidebar-foreground/70 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground"
                                    @onclick="@(() => ToggleGroup(group.Version))">
                                @group.Version
                                <span class="ml-1.5 text-xs text-muted-foreground">
                                    (@group.Entries.Length)
                                </span>
                                <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("ml-auto size-4 transition-transform duration-200", isOpen ? "rotate-90" : "")" />
                            </button>
                            @* Collapsible content *@
                            @if (isOpen)
                            {
                                <ul class="mt-0.5 space-y-0.5">
                                    @foreach (var ent in group.Entries)
                                    {
                                        var entry = ent;
                                        <li>
                                            <a href="@entry.Url"
                                               class="@Cn.Merge("flex items-center rounded-md px-2 py-2 text-sm text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground h-auto", entry.IsActive ? "bg-sidebar-accent font-medium text-sidebar-accent-foreground" : "")">
                                                <div class="flex flex-col gap-0.5">
                                                    <span class="text-sm leading-snug">@entry.Title</span>
                                                    <span class="text-xs text-muted-foreground">@entry.Date</span>
                                                </div>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                </div>

                @* Sidebar Rail (thin resize handle) *@
                <div class="absolute inset-y-0 right-0 w-px cursor-col-resize bg-transparent transition-colors hover:bg-sidebar-border"></div>
            </div>

            @* Sidebar Inset / Main Content *@
            <div class="flex min-w-0 flex-1 flex-col">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    @* Sidebar trigger button *@
                    <button type="button" class="-ml-1 flex size-7 items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Section</a>
                            </li>
                            <li class="hidden md:flex" aria-hidden="true">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                            </li>
                            <li class="flex items-center">
                                <span role="link" aria-current="page" aria-disabled="true" class="font-normal text-foreground">Page</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private record ChangelogEntry(string Title, string Date, string Url, bool IsActive = false);

    private record VersionGroup(string Version, bool DefaultOpen, ChangelogEntry[] Entries);

    private static readonly VersionGroup[] _versions =
    [
        new("v3.0", true, new ChangelogEntry[]
        {
            new("v3.0.2 — Performance improvements", "Mar 15, 2026", "#", true),
            new("v3.0.1 — Bug fixes", "Mar 8, 2026", "#"),
            new("v3.0.0 — Major redesign", "Mar 1, 2026", "#"),
        }),
        new("v2.5", false, new ChangelogEntry[]
        {
            new("v2.5.3 — Security patch", "Feb 20, 2026", "#"),
            new("v2.5.2 — New API endpoints", "Feb 10, 2026", "#"),
            new("v2.5.1 — Dashboard widgets", "Jan 28, 2026", "#"),
            new("v2.5.0 — Plugin system", "Jan 15, 2026", "#"),
        }),
        new("v2.0", false, new ChangelogEntry[]
        {
            new("v2.0.4 — Stability fixes", "Dec 20, 2025", "#"),
            new("v2.0.3 — Dark mode support", "Dec 5, 2025", "#"),
            new("v2.0.2 — Accessibility audit", "Nov 22, 2025", "#"),
            new("v2.0.1 — Hotfix release", "Nov 10, 2025", "#"),
            new("v2.0.0 — Initial v2 release", "Nov 1, 2025", "#"),
        }),
        new("v1.x", false, new ChangelogEntry[]
        {
            new("v1.9.0 — Final v1 release", "Oct 15, 2025", "#"),
            new("v1.8.0 — Legacy migration tools", "Sep 1, 2025", "#"),
        }),
    ];

    private HashSet<string> _openGroups = new(
        _versions.Where(v => v.DefaultOpen).Select(v => v.Version)
    );

    private void ToggleGroup(string version)
    {
        if (!_openGroups.Add(version))
            _openGroups.Remove(version);
    }
}
