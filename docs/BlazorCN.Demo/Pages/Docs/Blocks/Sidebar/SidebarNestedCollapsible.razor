@* ============================================================
   Block: sidebar-nested-collapsible
   Title: SidebarNestedCollapsible
   Description: React sidebar with two-level collapsible navigation using nested Collapsible components, ChevronRight rotation animation, and grouped items built with Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/sidebar/sidebar-nested-collapsible.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px]">
            @* Sidebar *@
            <div class="flex w-64 shrink-0 flex-col border-r bg-sidebar">
                @* Sidebar Header *@
                <div class="flex h-16 items-center border-b px-2">
                    <a href="#" class="flex w-full items-center gap-2 rounded-md p-2 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                        <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                            <LucideIconCn Name="gallery-vertical-end" Size="16" Class="size-4" />
                        </div>
                        <div class="flex flex-col gap-0.5 leading-none">
                            <span class="font-medium">UI Library</span>
                            <span class="">v3.1.0</span>
                        </div>
                    </a>
                </div>

                @* Sidebar Content *@
                <div class="flex flex-1 flex-col overflow-y-auto py-2">
                    @foreach (var grp in _navMain)
                    {
                        var group = grp;
                        <div class="px-2">
                            @* Group label / outer collapsible trigger *@
                            <button type="button"
                                    @onclick="@(() => ToggleGroup(group.Title))"
                                    class="flex w-full items-center px-2 py-1 text-xs font-medium text-sidebar-foreground/60 hover:text-sidebar-foreground">
                                <LucideIconCn Name="@group.Icon" Size="16" Class="mr-2 size-4" />
                                @group.Title
                                <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("ml-auto size-4 transition-transform duration-200", group.IsOpen ? "rotate-90" : "")" />
                            </button>
                            @if (group.IsOpen)
                            {
                                <ul class="mt-1 space-y-0.5">
                                    @foreach (var itm in group.Items)
                                    {
                                        var item = itm;
                                        <li>
                                            @* Inner collapsible trigger *@
                                            <button type="button"
                                                    @onclick="@(() => ToggleItem(group.Title, item.Title))"
                                                    class="flex w-full items-center rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                                                <span>@item.Title</span>
                                                <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("ml-auto size-4 transition-transform duration-200", item.IsOpen ? "rotate-90" : "")" />
                                            </button>
                                            @if (item.IsOpen)
                                            {
                                                <ul class="ml-4 mt-0.5 space-y-0.5 border-l border-sidebar-border pl-2">
                                                    @foreach (var sub in item.SubItems)
                                                    {
                                                        <li>
                                                            <a href="@sub.Url"
                                                               class="@Cn.Merge("flex items-center rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", sub.IsActive ? "bg-sidebar-accent text-sidebar-accent-foreground font-medium" : "")">
                                                                @sub.Title
                                                            </a>
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                </div>

                @* Sidebar Rail *@
                <div class="absolute inset-y-0 right-0 w-px bg-border opacity-0 hover:opacity-100 cursor-col-resize"></div>
            </div>

            @* Main Content (SidebarInset) *@
            <div class="flex min-w-0 flex-1 flex-col">
                @* Header *@
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <button type="button" class="-ml-1 flex size-8 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Section</a>
                            </li>
                            <li class="hidden md:flex [&>svg]:size-3.5 [&>svg]:text-muted-foreground/70">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 text-muted-foreground/70" />
                            </li>
                            <li class="flex items-center">
                                <span role="link" aria-disabled="true" aria-current="page" class="font-normal text-foreground">Page</span>
                            </li>
                        </ol>
                    </nav>
                </header>

                @* Body *@
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record SubItem(string Title, string Url, bool IsActive = false);

    private class NavSubGroup
    {
        public string Title { get; set; } = "";
        public bool IsOpen { get; set; }
        public SubItem[] SubItems { get; set; } = [];
    }

    private class NavGroup
    {
        public string Title { get; set; } = "";
        public string Icon { get; set; } = "";
        public bool IsOpen { get; set; }
        public NavSubGroup[] Items { get; set; } = [];
    }

    private NavGroup[] _navMain =
    [
        new NavGroup
        {
            Title = "Components",
            Icon = "layers",
            IsOpen = true,
            Items =
            [
                new NavSubGroup
                {
                    Title = "Inputs",
                    IsOpen = true,
                    SubItems =
                    [
                        new SubItem("Text Input", "#"),
                        new SubItem("Number Input", "#"),
                        new SubItem("Search Input", "#", true),
                    ]
                },
                new NavSubGroup
                {
                    Title = "Display",
                    IsOpen = false,
                    SubItems =
                    [
                        new SubItem("Card", "#"),
                        new SubItem("Badge", "#"),
                        new SubItem("Avatar", "#"),
                    ]
                },
                new NavSubGroup
                {
                    Title = "Feedback",
                    IsOpen = false,
                    SubItems =
                    [
                        new SubItem("Alert", "#"),
                        new SubItem("Toast", "#"),
                        new SubItem("Progress", "#"),
                    ]
                },
            ]
        },
        new NavGroup
        {
            Title = "Patterns",
            Icon = "code",
            IsOpen = false,
            Items =
            [
                new NavSubGroup
                {
                    Title = "Forms",
                    IsOpen = false,
                    SubItems =
                    [
                        new SubItem("Login Form", "#"),
                        new SubItem("Registration", "#"),
                        new SubItem("Settings Form", "#"),
                    ]
                },
                new NavSubGroup
                {
                    Title = "Layouts",
                    IsOpen = false,
                    SubItems =
                    [
                        new SubItem("Dashboard", "#"),
                        new SubItem("Sidebar Layout", "#"),
                        new SubItem("Split View", "#"),
                    ]
                },
            ]
        },
        new NavGroup
        {
            Title = "Guides",
            Icon = "book-open",
            IsOpen = false,
            Items =
            [
                new NavSubGroup
                {
                    Title = "Getting Started",
                    IsOpen = false,
                    SubItems =
                    [
                        new SubItem("Installation", "#"),
                        new SubItem("Configuration", "#"),
                    ]
                },
                new NavSubGroup
                {
                    Title = "Advanced",
                    IsOpen = false,
                    SubItems =
                    [
                        new SubItem("Theming", "#"),
                        new SubItem("Accessibility", "#"),
                        new SubItem("Performance", "#"),
                    ]
                },
            ]
        },
        new NavGroup
        {
            Title = "Configuration",
            Icon = "settings",
            IsOpen = false,
            Items =
            [
                new NavSubGroup
                {
                    Title = "Build",
                    IsOpen = false,
                    SubItems =
                    [
                        new SubItem("Bundler", "#"),
                        new SubItem("Transpiler", "#"),
                    ]
                },
                new NavSubGroup
                {
                    Title = "Deploy",
                    IsOpen = false,
                    SubItems =
                    [
                        new SubItem("Vercel", "#"),
                        new SubItem("Docker", "#"),
                        new SubItem("AWS", "#"),
                    ]
                },
            ]
        },
    ];

    private void ToggleGroup(string groupTitle)
    {
        var grp = System.Array.Find(_navMain, g => g.Title == groupTitle);
        if (grp != null)
        {
            grp.IsOpen = !grp.IsOpen;
        }
    }

    private void ToggleItem(string groupTitle, string itemTitle)
    {
        var grp = System.Array.Find(_navMain, g => g.Title == groupTitle);
        if (grp != null)
        {
            var item = System.Array.Find(grp.Items, i => i.Title == itemTitle);
            if (item != null)
            {
                item.IsOpen = !item.IsOpen;
            }
        }
    }
}
