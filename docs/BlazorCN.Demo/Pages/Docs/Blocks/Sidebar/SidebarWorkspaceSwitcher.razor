@* ============================================================
   Block: sidebar-workspace-switcher
   Title: SidebarWorkspaceSwitcher
   Description: A React sidebar with dropdown workspace switcher showing icon, name, and plan. Built with Next.js, TypeScript, shadcn/ui Sidebar and DropdownMenu, Tailwind CSS.
   Source: original/blocks/sidebar/sidebar-workspace-switcher.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px]">
            @* Sidebar *@
            <div class="flex w-64 shrink-0 flex-col border-r bg-sidebar">
                @* Sidebar Header *@
                <div class="flex shrink-0 flex-col gap-2 p-2">
                    <ul class="flex w-full min-w-0 flex-col gap-1">
                        <li class="group/menu-item relative">
                            <div class="relative">
                                <button type="button"
                                        class="peer/menu-button flex w-full items-center gap-2 overflow-hidden rounded-md p-2 text-left text-sm outline-none ring-sidebar-ring transition-[width,height,padding] hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-2 active:bg-sidebar-accent active:text-sidebar-accent-foreground data-[state=open]:bg-sidebar-accent data-[state=open]:text-sidebar-accent-foreground h-12 text-sm group-data-[collapsible=icon]:!size-8 group-data-[collapsible=icon]:!p-2"
                                        @onclick="@(() => _dropdownOpen = !_dropdownOpen)">
                                    <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                                        <LucideIconCn Name="@_activeWorkspace.Icon" Size="16" Class="size-4" />
                                    </div>
                                    <div class="grid flex-1 text-left text-sm leading-tight">
                                        <span class="truncate font-medium">@_activeWorkspace.Name</span>
                                        <span class="truncate text-xs text-muted-foreground">@_activeWorkspace.Plan</span>
                                    </div>
                                    <LucideIconCn Name="chevrons-up-down" Size="16" Class="ml-auto size-4" />
                                </button>
                                @if (_dropdownOpen)
                                {
                                    <div class="absolute left-0 top-full z-50 mt-1 w-[--radix-dropdown-menu-trigger-width] min-w-56 overflow-hidden rounded-lg border bg-popover p-1 text-popover-foreground shadow-md">
                                        <p class="px-2 py-1.5 text-xs text-muted-foreground">Workspaces</p>
                                        @foreach (var workspace in _workspaces)
                                        {
                                            var ws = workspace;
                                            <button type="button"
                                                    class="relative flex w-full cursor-default select-none items-center gap-2 rounded-sm p-2 text-sm outline-none transition-colors hover:bg-accent hover:text-accent-foreground"
                                                    @onclick="@(() => SelectWorkspace(ws))">
                                                <div class="flex size-6 items-center justify-center rounded-sm border">
                                                    <LucideIconCn Name="@ws.Icon" Size="16" Class="size-4 shrink-0" />
                                                </div>
                                                <span class="flex-1">@ws.Name</span>
                                                <span class="text-xs text-muted-foreground">@ws.Plan</span>
                                                @if (_activeWorkspace.Id == ws.Id)
                                                {
                                                    <LucideIconCn Name="check" Size="16" Class="ml-1 size-4" />
                                                }
                                            </button>
                                        }
                                        <div class="-mx-1 my-1 h-px bg-muted"></div>
                                        <button type="button"
                                                class="relative flex w-full cursor-default select-none items-center gap-2 rounded-sm p-2 text-sm outline-none transition-colors hover:bg-accent hover:text-accent-foreground">
                                            <div class="flex size-6 items-center justify-center rounded-md border bg-background">
                                                <span class="text-sm">+</span>
                                            </div>
                                            <span class="text-muted-foreground">Add workspace</span>
                                        </button>
                                    </div>
                                }
                            </div>
                        </li>
                    </ul>
                </div>

                @* Sidebar Content *@
                <div class="flex min-h-0 flex-1 flex-col gap-2 overflow-auto px-2 py-2">
                    @foreach (var grp in _navItems)
                    {
                        var group = grp;
                        <div>
                            <span class="px-2 py-1 text-xs font-medium text-sidebar-foreground/60">@group.Title</span>
                            <ul class="mt-1 space-y-0.5">
                                @foreach (var navItem in group.Items)
                                {
                                    var item = navItem;
                                    <li>
                                        <a href="@item.Url"
                                           class="@Cn.Merge("flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", item.IsActive ? "bg-sidebar-accent text-sidebar-accent-foreground font-medium" : "")">
                                            <LucideIconCn Name="@item.Icon" Size="16" Class="size-4 shrink-0" />
                                            <span>@item.Title</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>

                @* Sidebar Rail *@
                <div class="absolute inset-y-0 right-0 w-px bg-border opacity-0 hover:opacity-100 cursor-col-resize"></div>
            </div>

            @* Main Content (SidebarInset) *@
            <div class="flex min-w-0 flex-1 flex-col">
                @* Header *@
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    @* Sidebar trigger *@
                    <button type="button" class="-ml-1 flex size-8 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    @* Vertical separator *@
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Main</a>
                            </li>
                            <li class="hidden md:flex [&>svg]:size-3.5 [&>svg]:text-muted-foreground/70">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 text-muted-foreground/70" />
                            </li>
                            <li class="flex items-center">
                                <span role="link" aria-disabled="true" aria-current="page" class="font-normal text-foreground">Dashboard</span>
                            </li>
                        </ol>
                    </nav>
                </header>

                @* Body *@
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record WorkspaceItem(string Id, string Name, string Plan, string Icon);
    private record NavItem(string Title, string Url, string Icon, bool IsActive = false);
    private record NavGroup(string Title, NavItem[] Items);

    private static readonly WorkspaceItem[] _workspaces =
    [
        new("1", "Acme Corp",    "Pro",  "building"),
        new("2", "Personal",     "Free", "code"),
        new("3", "Startup Labs", "Team", "rocket"),
    ];

    private static readonly NavGroup[] _navItems =
    [
        new("Main", [
            new("Dashboard", "#", "layout-dashboard", true),
            new("Analytics",  "#", "bar-chart"),
            new("Documents",  "#", "file-text"),
        ]),
        new("Organization", [
            new("Members",  "#", "users"),
            new("Settings", "#", "settings"),
        ]),
    ];

    private WorkspaceItem _activeWorkspace = _workspaces[0];
    private bool _dropdownOpen = false;

    private void SelectWorkspace(WorkspaceItem workspace)
    {
        _activeWorkspace = workspace;
        _dropdownOpen = false;
    }
}
