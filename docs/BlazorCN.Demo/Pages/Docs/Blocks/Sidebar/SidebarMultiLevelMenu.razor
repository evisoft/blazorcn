@* ============================================================
   Block: sidebar-multi-level-menu
   Title: SidebarMultiLevelMenu
   Description: React sidebar with three levels of nested navigation using SidebarMenuSub. Built with Next.js, shadcn/ui Sidebar and Collapsible components, and Tailwind CSS.
   Source: original/blocks/sidebar/sidebar-multi-level-menu.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px]">
            @* Sidebar *@
            <div class="flex w-64 shrink-0 flex-col border-r bg-sidebar">
                @* Sidebar Header *@
                <div class="flex h-16 items-center border-b px-2">
                    <a href="#" class="flex w-full items-center gap-2 rounded-md p-2 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                        <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                            <LucideIconCn Name="gallery-vertical-end" Size="16" Class="size-4" />
                        </div>
                        <div class="flex flex-col gap-0.5 leading-none">
                            <span class="font-medium">UI Library</span>
                            <span class="text-xs text-muted-foreground">v3.2.0</span>
                        </div>
                    </a>
                </div>

                @* Sidebar Content *@
                <div class="flex flex-1 flex-col gap-2 overflow-y-auto py-2">
                    <div class="px-2">
                        <span class="px-2 py-1 text-xs font-medium text-sidebar-foreground/60">Documentation</span>
                        <ul class="mt-1 space-y-0.5">
                            @foreach (var navSection in _navData)
                            {
                                var sec = navSection;
                                <li>
                                    <div class="relative flex items-center">
                                        <button type="button"
                                                @onclick="@(() => ToggleSection(sec.Title))"
                                                class="flex flex-1 items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground w-full text-left">
                                            <LucideIconCn Name="@sec.Icon" Size="16" Class="size-4 shrink-0" />
                                            <span>@sec.Title</span>
                                            <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("ml-auto size-4 transition-transform duration-200", sec.IsOpen ? "rotate-90" : "")" />
                                        </button>
                                    </div>
                                    @if (sec.IsOpen)
                                    {
                                        <ul class="ml-4 mt-0.5 space-y-0.5 border-l border-sidebar-border pl-2">
                                            @foreach (var subSection in sec.Children)
                                            {
                                                var sub = subSection;
                                                <li>
                                                    <div class="relative flex items-center">
                                                        <button type="button"
                                                                @onclick="@(() => ToggleSubSection(sec.Title, sub.Title))"
                                                                class="flex flex-1 items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground w-full text-left cursor-pointer">
                                                            <span>@sub.Title</span>
                                                            <LucideIconCn Name="chevron-right" Size="12" Class="@Cn.Merge("ml-auto size-3 transition-transform duration-200", sub.IsOpen ? "rotate-90" : "")" />
                                                        </button>
                                                    </div>
                                                    @if (sub.IsOpen)
                                                    {
                                                        <ul class="ml-4 mt-0.5 space-y-0.5 border-l border-sidebar-border pl-2">
                                                            @foreach (var leafItem in sub.Children)
                                                            {
                                                                var leaf = leafItem;
                                                                <li>
                                                                    <a href="@leaf.Url"
                                                                       class="@Cn.Merge("flex items-center rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", leaf.IsActive ? "bg-sidebar-accent text-sidebar-accent-foreground font-medium" : "")">
                                                                        @leaf.Title
                                                                    </a>
                                                                </li>
                                                            }
                                                        </ul>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                @* Sidebar Rail *@
                <div class="absolute inset-y-0 right-0 w-px bg-border opacity-0 hover:opacity-100 cursor-col-resize"></div>
            </div>

            @* Main Content (SidebarInset) *@
            <div class="flex min-w-0 flex-1 flex-col">
                @* Header *@
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <button type="button" class="-ml-1 flex size-8 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Components</a>
                            </li>
                            <li class="hidden md:flex [&>svg]:size-3.5 [&>svg]:text-muted-foreground/70">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 text-muted-foreground/70" />
                            </li>
                            <li class="flex items-center">
                                <span role="link" aria-disabled="true" aria-current="page" class="font-normal text-foreground">Card</span>
                            </li>
                        </ol>
                    </nav>
                </header>

                @* Body *@
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record LeafItem(string Title, string Url, bool IsActive = false);

    private class SubSection
    {
        public string Title { get; set; } = "";
        public bool IsOpen { get; set; }
        public LeafItem[] Children { get; set; } = [];
    }

    private class NavSection
    {
        public string Title { get; set; } = "";
        public string Icon { get; set; } = "";
        public bool IsOpen { get; set; }
        public SubSection[] Children { get; set; } = [];
    }

    private NavSection[] _navData =
    [
        new NavSection
        {
            Title = "Components",
            Icon = "component",
            IsOpen = true,
            Children =
            [
                new SubSection
                {
                    Title = "Data Display",
                    IsOpen = true,
                    Children =
                    [
                        new LeafItem("Table", "#"),
                        new LeafItem("Card", "#", true),
                        new LeafItem("List", "#"),
                        new LeafItem("Badge", "#"),
                    ]
                },
                new SubSection
                {
                    Title = "Data Input",
                    IsOpen = true,
                    Children =
                    [
                        new LeafItem("Form", "#"),
                        new LeafItem("Input", "#"),
                        new LeafItem("Select", "#"),
                        new LeafItem("Checkbox", "#"),
                    ]
                },
                new SubSection
                {
                    Title = "Feedback",
                    IsOpen = true,
                    Children =
                    [
                        new LeafItem("Alert", "#"),
                        new LeafItem("Toast", "#"),
                        new LeafItem("Progress", "#"),
                    ]
                },
            ]
        },
        new NavSection
        {
            Title = "Hooks",
            Icon = "code",
            IsOpen = true,
            Children =
            [
                new SubSection
                {
                    Title = "State",
                    IsOpen = true,
                    Children =
                    [
                        new LeafItem("useToggle", "#"),
                        new LeafItem("useLocalStorage", "#"),
                    ]
                },
                new SubSection
                {
                    Title = "Effects",
                    IsOpen = true,
                    Children =
                    [
                        new LeafItem("useDebounce", "#"),
                        new LeafItem("useInterval", "#"),
                    ]
                },
            ]
        },
        new NavSection
        {
            Title = "Guides",
            Icon = "book-open",
            IsOpen = true,
            Children =
            [
                new SubSection
                {
                    Title = "Getting Started",
                    IsOpen = true,
                    Children =
                    [
                        new LeafItem("Installation", "#"),
                        new LeafItem("Configuration", "#"),
                    ]
                },
                new SubSection
                {
                    Title = "Advanced",
                    IsOpen = true,
                    Children =
                    [
                        new LeafItem("Theming", "#"),
                        new LeafItem("Accessibility", "#"),
                        new LeafItem("Performance", "#"),
                    ]
                },
            ]
        },
    ];

    private void ToggleSection(string title)
    {
        var item = System.Array.Find(_navData, n => n.Title == title);
        if (item != null)
        {
            item.IsOpen = !item.IsOpen;
        }
    }

    private void ToggleSubSection(string sectionTitle, string subTitle)
    {
        var sec = System.Array.Find(_navData, n => n.Title == sectionTitle);
        if (sec != null)
        {
            var sub = System.Array.Find(sec.Children, s => s.Title == subTitle);
            if (sub != null)
            {
                sub.IsOpen = !sub.IsOpen;
            }
        }
    }
}
