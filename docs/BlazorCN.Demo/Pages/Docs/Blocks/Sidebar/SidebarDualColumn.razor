@* ============================================================
   Block: sidebar-dual-column
   Title: SidebarDualColumn
   Description: React two-column sidebar with ultra-narrow icon rail and wider navigation panel. Built with Next.js, TypeScript, shadcn/ui Sidebar components, and Tailwind CSS.
   Source: original/blocks/sidebar/sidebar-dual-column.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px]">
            @* Icon Rail *@
            <div class="flex w-14 shrink-0 flex-col items-center gap-2 border-r bg-sidebar py-3">
                <div class="flex size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                    <LucideIconCn Name="gallery-vertical-end" Size="16" Class="size-4" />
                </div>
                <div class="mx-2 my-1 h-px w-full bg-border"></div>
                @foreach (var sec in _sections)
                {
                    var s = sec;
                    <ButtonCn Variant="@(s.Title == _sections[_activeSection].Title ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                              Size="ButtonSize.Icon"
                              Class="size-9"
                              OnClick="@(() => SelectSection(s))" aria-label="@s.Title">
                        <LucideIconCn Name="@s.Icon" Size="16" Class="size-4" />
                    </ButtonCn>
                }
            </div>

            @* Nav Panel *@
            <div class="flex w-52 shrink-0 flex-col border-r bg-sidebar">
                <div class="border-b px-3 py-3">
                    <span class="text-sm font-medium">@_sections[_activeSection].Title</span>
                </div>
                <div class="flex-1 overflow-y-auto py-2">
                    <div class="flex flex-col gap-0.5 px-2">
                        @foreach (var item in _sections[_activeSection].Items)
                        {
                            var navItem = item;
                            <a href="@navItem.Url"
                               class="@Cn.Merge("flex items-center gap-2 rounded-md px-2.5 py-1.5 text-sm transition-colors", navItem.IsActive ? "bg-sidebar-accent font-medium text-sidebar-accent-foreground" : "text-sidebar-foreground hover:bg-sidebar-accent/50")">
                                @navItem.Title
                            </a>
                        }
                    </div>
                </div>
            </div>

            @* Content (SidebarInset) *@
            <div class="min-w-0 flex-1 flex flex-col">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    @* Sidebar trigger *@
                    <button type="button" class="-ml-1 flex size-8 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    @* Vertical separator *@
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Section</a>
                            </li>
                            <li class="hidden md:flex [&>svg]:size-3.5 [&>svg]:text-muted-foreground/70">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 text-muted-foreground/70" />
                            </li>
                            <li class="flex items-center">
                                <span role="link" aria-disabled="true" aria-current="page" class="font-normal text-foreground">Page</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record NavEntry(string Title, string Url, bool IsActive = false);

    private record SidebarSection(string Title, string Icon, NavEntry[] Items);

    private static readonly SidebarSection[] _sections =
    [
        new("Dashboard", "layout-dashboard",
        [
            new("Overview", "#", true),
            new("Analytics", "#"),
            new("Reports", "#"),
            new("Real-time", "#"),
        ]),
        new("Content", "file-text",
        [
            new("Pages", "#"),
            new("Blog Posts", "#"),
            new("Media Library", "#"),
            new("Templates", "#"),
        ]),
        new("Commerce", "package",
        [
            new("Products", "#"),
            new("Orders", "#"),
            new("Customers", "#"),
            new("Inventory", "#"),
            new("Discounts", "#"),
        ]),
        new("Data", "database",
        [
            new("Tables", "#"),
            new("Queries", "#"),
            new("Backups", "#"),
        ]),
        new("Settings", "settings",
        [
            new("General", "#"),
            new("Team", "#"),
            new("Billing", "#"),
            new("API Keys", "#"),
        ]),
    ];

    private int _activeSection = 0;

    private void SelectSection(SidebarSection sec)
    {
        _activeSection = Array.IndexOf(_sections, sec);
    }
}
