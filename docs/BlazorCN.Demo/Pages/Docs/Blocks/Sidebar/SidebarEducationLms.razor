@* ============================================================
   Block: sidebar-education-lms
   Title: SidebarEducationLms
   Description: Learning management sidebar with React, Next.js, shadcn/ui Sidebar components, and Tailwind CSS featuring collapsible course sub-menus, assignments, and community groups.
   Source: original/blocks/sidebar/sidebar-education-lms.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px]">
            @* Sidebar *@
            <div class="flex w-64 shrink-0 flex-col border-r bg-sidebar">
                @* Sidebar Header *@
                <div class="flex h-16 items-center border-b px-2">
                    <a href="#" class="flex w-full items-center gap-2 rounded-md p-2 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                        <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                            <LucideIconCn Name="graduation-cap" Size="16" Class="size-4" />
                        </div>
                        <div class="flex flex-col gap-0.5 leading-none">
                            <span class="font-medium">LearnHub</span>
                            <span class="text-xs">Spring 2026</span>
                        </div>
                    </a>
                </div>

                @* Sidebar Content *@
                <div class="flex flex-1 flex-col gap-2 overflow-y-auto py-2">

                    @* Learn Group *@
                    <div class="px-2">
                        <span class="px-2 py-1 text-xs font-medium text-sidebar-foreground/60">Learn</span>
                        <ul class="mt-1 space-y-0.5">
                            @foreach (var learnItem in _learnItems)
                            {
                                var item = learnItem;
                                <li class="group/collapsible">
                                    <div class="relative flex items-center">
                                        <button type="button"
                                                @onclick="@(() => ToggleLearn(item.Title))"
                                                class="@Cn.Merge("flex flex-1 items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", item.IsActive ? "bg-sidebar-accent text-sidebar-accent-foreground font-medium" : "")">
                                            <LucideIconCn Name="@item.Icon" Size="16" Class="size-4 shrink-0" />
                                            <span>@item.Title</span>
                                            <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("ml-auto size-4 transition-transform duration-200", item.IsOpen ? "rotate-90" : "")" />
                                        </button>
                                    </div>
                                    @if (item.IsOpen)
                                    {
                                        <ul class="ml-4 mt-0.5 space-y-0.5 border-l border-sidebar-border pl-2">
                                            @foreach (var subItem in item.SubItems)
                                            {
                                                var sub = subItem;
                                                <li>
                                                    <a href="@sub.Url"
                                                       class="flex items-center rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                                                        @sub.Title
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </li>
                            }
                        </ul>
                    </div>

                    @* Community Group *@
                    <div class="px-2">
                        <span class="px-2 py-1 text-xs font-medium text-sidebar-foreground/60">Community</span>
                        <ul class="mt-1 space-y-0.5">
                            @foreach (var item in _communityItems)
                            {
                                <li>
                                    <a href="@item.Url"
                                       class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                                        <LucideIconCn Name="@item.Icon" Size="16" Class="size-4 shrink-0" />
                                        <span>@item.Title</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    @* Resources Group *@
                    <div class="px-2">
                        <span class="px-2 py-1 text-xs font-medium text-sidebar-foreground/60">Resources</span>
                        <ul class="mt-1 space-y-0.5">
                            @foreach (var item in _resourceItems)
                            {
                                <li>
                                    <a href="@item.Url"
                                       class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                                        <LucideIconCn Name="@item.Icon" Size="16" Class="size-4 shrink-0" />
                                        <span>@item.Title</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                @* Sidebar Rail *@
                <div class="absolute inset-y-0 right-0 w-px bg-border opacity-0 hover:opacity-100 cursor-col-resize"></div>
            </div>

            @* Main Content (SidebarInset) *@
            <div class="flex min-w-0 flex-1 flex-col">
                @* Header *@
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <button type="button" class="-ml-1 flex size-8 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Learn</a>
                            </li>
                            <li class="hidden md:flex [&>svg]:size-3.5 [&>svg]:text-muted-foreground/70">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 text-muted-foreground/70" />
                            </li>
                            <li class="flex items-center">
                                <span role="link" aria-disabled="true" aria-current="page" class="font-normal text-foreground">Courses</span>
                            </li>
                        </ol>
                    </nav>
                </header>

                @* Body *@
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record SubItem(string Title, string Url);

    private class LearnItem
    {
        public string Title { get; set; } = "";
        public string Icon { get; set; } = "";
        public bool IsActive { get; set; }
        public bool IsOpen { get; set; }
        public SubItem[] SubItems { get; set; } = [];
    }

    private record SimpleItem(string Title, string Url, string Icon);

    private LearnItem[] _learnItems =
    [
        new LearnItem
        {
            Title = "Courses",
            Icon = "book-open",
            IsActive = true,
            IsOpen = true,
            SubItems =
            [
                new SubItem("Introduction to React", "#"),
                new SubItem("Advanced TypeScript", "#"),
                new SubItem("System Design", "#"),
                new SubItem("Data Structures", "#"),
            ]
        },
        new LearnItem
        {
            Title = "Assignments",
            Icon = "clipboard-check",
            IsOpen = false,
            SubItems =
            [
                new SubItem("Pending", "#"),
                new SubItem("Submitted", "#"),
                new SubItem("Graded", "#"),
            ]
        },
        new LearnItem
        {
            Title = "Grades",
            Icon = "star",
            IsOpen = false,
            SubItems =
            [
                new SubItem("Current Semester", "#"),
                new SubItem("Transcript", "#"),
            ]
        },
    ];

    private static readonly SimpleItem[] _communityItems =
    [
        new SimpleItem("Discussions", "#", "message-square"),
        new SimpleItem("Study Groups", "#", "users"),
    ];

    private static readonly SimpleItem[] _resourceItems =
    [
        new SimpleItem("Library", "#", "library"),
        new SimpleItem("Calendar", "#", "calendar"),
    ];

    private void ToggleLearn(string title)
    {
        var item = System.Array.Find(_learnItems, n => n.Title == title);
        if (item != null)
        {
            item.IsOpen = !item.IsOpen;
        }
    }
}
