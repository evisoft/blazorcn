@* ============================================================
   Block: sidebar-action-buttons
   Title: SidebarActionButtons
   Description: A React sidebar with hover-revealed action buttons on nav items using shadcn/ui SidebarMenuAction. Built with Next.js and Tailwind CSS for context menus and quick actions.
   Source: original/blocks/sidebar/sidebar-action-buttons.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px]">
            @* Sidebar *@
            <div class="flex w-64 shrink-0 flex-col border-r bg-sidebar">
                @* Sidebar Header *@
                <div class="flex h-16 items-center border-b px-2">
                    <a href="#" class="flex w-full items-center gap-2 rounded-md p-2 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                        <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                            <LucideIconCn Name="gallery-vertical-end" Size="16" Class="size-4" />
                        </div>
                        <div class="flex flex-col gap-0.5 leading-none">
                            <span class="font-medium">Workspace</span>
                            <span class="">Team Plan</span>
                        </div>
                    </a>
                </div>

                @* Sidebar Content *@
                <div class="flex flex-1 flex-col gap-2 overflow-y-auto py-2">
                    @* Projects Group *@
                    <div class="px-2">
                        <span class="px-2 py-1 text-xs font-medium text-sidebar-foreground/60">Projects</span>
                        <ul class="mt-1 space-y-0.5">
                            @foreach (var proj in _projects)
                            {
                                var item = proj;
                                <li class="group/item relative flex items-center">
                                    <a href="@item.Url"
                                       class="@Cn.Merge("flex flex-1 items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", item.IsActive ? "bg-sidebar-accent text-sidebar-accent-foreground font-medium" : "")">
                                        <LucideIconCn Name="folder" Size="16" Class="size-4 shrink-0" />
                                        <span>@item.Title</span>
                                    </a>
                                    <button type="button"
                                            class="absolute right-1 flex size-6 items-center justify-center rounded-md opacity-0 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground group-hover/item:opacity-100 transition-opacity">
                                        <LucideIconCn Name="more-horizontal" Size="16" Class="size-4" />
                                        <span class="sr-only">More</span>
                                    </button>
                                </li>
                            }
                            <li>
                                <button type="button" class="flex w-full items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                                    <LucideIconCn Name="plus" Size="16" Class="size-4 shrink-0" />
                                    <span>New Project</span>
                                </button>
                            </li>
                        </ul>
                    </div>

                    @* Documents Group *@
                    <div class="px-2">
                        <span class="px-2 py-1 text-xs font-medium text-sidebar-foreground/60">Documents</span>
                        <ul class="mt-1 space-y-0.5">
                            @foreach (var doc in _documents)
                            {
                                var item = doc;
                                <li class="group/item relative flex items-center">
                                    <a href="@item.Url"
                                       class="flex flex-1 items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                                        <LucideIconCn Name="@item.Icon" Size="16" Class="size-4 shrink-0" />
                                        <span>@item.Title</span>
                                    </a>
                                    <button type="button"
                                            class="absolute right-1 flex size-6 items-center justify-center rounded-md opacity-0 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground group-hover/item:opacity-100 transition-opacity">
                                        <LucideIconCn Name="trash" Size="16" Class="size-4" />
                                        <span class="sr-only">Delete</span>
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                @* Sidebar Rail (thin drag handle) *@
                <div class="absolute inset-y-0 right-0 w-px bg-border opacity-0 hover:opacity-100 cursor-col-resize"></div>
            </div>

            @* Main Content (SidebarInset) *@
            <div class="flex min-w-0 flex-1 flex-col">
                @* Header *@
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    @* Sidebar trigger icon *@
                    <button type="button" class="-ml-1 flex size-8 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    @* Vertical separator *@
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Section</a>
                            </li>
                            <li class="hidden md:flex [&>svg]:size-3.5 [&>svg]:text-muted-foreground/70">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 text-muted-foreground/70" />
                            </li>
                            <li class="flex items-center">
                                <span role="link" aria-disabled="true" aria-current="page" class="font-normal text-foreground">Page</span>
                            </li>
                        </ol>
                    </nav>
                </header>

                @* Body *@
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record ProjectItem(string Title, string Url, bool IsActive);
    private record DocumentItem(string Title, string Url, string Icon);

    private static readonly ProjectItem[] _projects =
    [
        new("Marketing Site", "#", true),
        new("Mobile App", "#", false),
        new("API Backend", "#", false),
    ];

    private static readonly DocumentItem[] _documents =
    [
        new("Design Brief", "#", "file-text"),
        new("Brand Guidelines", "#", "image"),
        new("Product Roadmap", "#", "table"),
        new("Demo Video", "#", "video"),
    ];
}
