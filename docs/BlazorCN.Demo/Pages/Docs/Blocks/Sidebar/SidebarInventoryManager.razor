@* ============================================================
   Block: sidebar-inventory-manager
   Title: SidebarInventoryManager
   Description: Full-featured React inventory sidebar with products, warehouses, orders, and analytics using Next.js, shadcn/ui Sidebar, and Tailwind CSS for e-commerce apps.
   Source: original/blocks/sidebar/sidebar-inventory-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px]">
            @* Sidebar *@
            <div class="flex w-64 shrink-0 flex-col border-r bg-sidebar">
                @* Sidebar Header *@
                <div class="flex h-16 items-center border-b px-2">
                    <a href="#" class="flex w-full items-center gap-2 rounded-md p-2 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                        <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                            <LucideIconCn Name="box" Size="16" Class="size-4" />
                        </div>
                        <div class="flex flex-col gap-0.5 leading-none">
                            <span class="font-medium">Inventory</span>
                            <span class="">Stock Manager</span>
                        </div>
                    </a>
                </div>

                @* Sidebar Content *@
                <div class="flex flex-1 flex-col overflow-y-auto py-2">
                    @* Products group *@
                    <div class="px-2">
                        <p class="mb-1 px-2 py-1 text-xs font-medium text-sidebar-foreground/60">Products</p>
                        <ul class="space-y-0.5">
                            @foreach (var itm in _products)
                            {
                                var item = itm;
                                <li>
                                    <a href="@item.Url"
                                       class="@Cn.Merge("flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground", item.IsActive ? "bg-sidebar-accent text-sidebar-accent-foreground font-medium" : "")">
                                        <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                        <span>@item.Title</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    @* Warehouses group *@
                    <div class="px-2 mt-2">
                        <p class="mb-1 px-2 py-1 text-xs font-medium text-sidebar-foreground/60">Warehouses</p>
                        <ul class="space-y-0.5">
                            @foreach (var itm in _warehouses)
                            {
                                var item = itm;
                                <li>
                                    <a href="@item.Url"
                                       class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                                        <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                        <span>@item.Title</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    @* Orders group *@
                    <div class="px-2 mt-2">
                        <p class="mb-1 px-2 py-1 text-xs font-medium text-sidebar-foreground/60">Orders</p>
                        <ul class="space-y-0.5">
                            @foreach (var itm in _orders)
                            {
                                var item = itm;
                                <li>
                                    <a href="@item.Url"
                                       class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                                        <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                        <span>@item.Title</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    @* Analytics group *@
                    <div class="px-2 mt-2">
                        <p class="mb-1 px-2 py-1 text-xs font-medium text-sidebar-foreground/60">Analytics</p>
                        <ul class="space-y-0.5">
                            @foreach (var itm in _reports)
                            {
                                var item = itm;
                                <li>
                                    <a href="@item.Url"
                                       class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground">
                                        <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                        <span>@item.Title</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                @* Sidebar Rail *@
                <div class="absolute inset-y-0 right-0 w-px bg-border opacity-0 hover:opacity-100 cursor-col-resize"></div>
            </div>

            @* Main Content (SidebarInset) *@
            <div class="flex min-w-0 flex-1 flex-col">
                @* Header *@
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <button type="button" class="-ml-1 flex size-8 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Section</a>
                            </li>
                            <li class="hidden md:flex [&>svg]:size-3.5 [&>svg]:text-muted-foreground/70">
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 text-muted-foreground/70" />
                            </li>
                            <li class="flex items-center">
                                <span role="link" aria-disabled="true" aria-current="page" class="font-normal text-foreground">Page</span>
                            </li>
                        </ol>
                    </nav>
                </header>

                @* Body *@
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record NavItem(string Title, string Url, string Icon, bool IsActive = false);

    private static readonly NavItem[] _products =
    [
        new("All Items", "#", "package", true),
        new("Categories", "#", "tag"),
        new("Brands", "#", "building"),
    ];

    private static readonly NavItem[] _warehouses =
    [
        new("Location A", "#", "map-pin"),
        new("Location B", "#", "map-pin"),
    ];

    private static readonly NavItem[] _orders =
    [
        new("Inbound", "#", "arrow-down-to-line"),
        new("Outbound", "#", "arrow-up-from-line"),
        new("Returns", "#", "rotate-ccw"),
    ];

    private static readonly NavItem[] _reports =
    [
        new("Reports", "#", "bar-chart"),
    ];
}
