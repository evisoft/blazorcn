@* ============================================================
   Block: sidebar-header-with-logo
   Title: SidebarHeaderWithLogo
   Description: React sidebar with geometric logo, app name, and tagline in header with navigation groups. Built with Next.js, TypeScript, shadcn/ui Sidebar components, and Tailwind CSS.
   Source: original/blocks/sidebar/sidebar-header-with-logo.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <SidebarProviderCn Class="h-[700px] !min-h-0">
            <SidebarCn Class="border-r">
                <SidebarHeaderCn>
                    <SidebarMenuCn>
                        <SidebarMenuItemCn>
                            <SidebarMenuButtonCn Href="#" Size="SidebarMenuButtonSize.Lg">
                                <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                                    <div class="grid size-4 grid-cols-2 gap-0.5">
                                        <div class="size-full rounded-sm bg-current"></div>
                                        <div class="size-full rounded-sm bg-current opacity-60"></div>
                                        <div class="size-full rounded-sm bg-current opacity-60"></div>
                                        <div class="size-full rounded-sm bg-current"></div>
                                    </div>
                                </div>
                                <div class="flex flex-col gap-0.5 leading-none">
                                    <span class="font-medium">Gridwork</span>
                                    <span class="text-xs text-muted-foreground">Build better products</span>
                                </div>
                            </SidebarMenuButtonCn>
                        </SidebarMenuItemCn>
                    </SidebarMenuCn>
                </SidebarHeaderCn>
                <SidebarContentCn>
                    <SidebarGroupCn>
                        <SidebarGroupLabelCn>Platform</SidebarGroupLabelCn>
                        <SidebarGroupContentCn>
                            <SidebarMenuCn>
                                @foreach (var item in _mainNav)
                                {
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn Href="@item.Url" IsActive="@item.IsActive">
                                            <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                            <span>@item.Title</span>
                                        </SidebarMenuButtonCn>
                                    </SidebarMenuItemCn>
                                }
                            </SidebarMenuCn>
                        </SidebarGroupContentCn>
                    </SidebarGroupCn>
                    <SidebarGroupCn>
                        <SidebarGroupLabelCn>Workspace</SidebarGroupLabelCn>
                        <SidebarGroupContentCn>
                            <SidebarMenuCn>
                                @foreach (var item in _workspace)
                                {
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn Href="@item.Url">
                                            <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                            <span>@item.Title</span>
                                        </SidebarMenuButtonCn>
                                    </SidebarMenuItemCn>
                                }
                            </SidebarMenuCn>
                        </SidebarGroupContentCn>
                    </SidebarGroupCn>
                </SidebarContentCn>
                <SidebarFooterCn>
                    <SidebarMenuCn>
                        <SidebarMenuItemCn>
                            <SidebarMenuButtonCn Href="#">
                                <LucideIconCn Name="circle-user" Size="20" Class="size-5" />
                                <div class="grid flex-1 text-left text-sm leading-tight">
                                    <span class="truncate font-medium">Jane Doe</span>
                                    <span class="truncate text-xs text-muted-foreground">jane@@gridwork.io</span>
                                </div>
                            </SidebarMenuButtonCn>
                        </SidebarMenuItemCn>
                    </SidebarMenuCn>
                </SidebarFooterCn>
                <SidebarRailCn />
            </SidebarCn>

            <SidebarInsetCn Class="min-w-0 flex-1">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <SidebarTriggerCn Class="-ml-1" />
                    <div class="mr-2 w-px self-stretch bg-border data-[orientation=vertical]:h-4" data-orientation="vertical"></div>
                    <nav aria-label="Breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground break-words sm:gap-2.5">
                            <li class="hidden md:block">
                                <a href="#" class="transition-colors hover:text-foreground">Platform</a>
                            </li>
                            <li role="presentation" aria-hidden="true" class="hidden md:block [&>svg]:size-3.5">
                                <LucideIconCn Name="chevron-right" Size="14" />
                            </li>
                            <li>
                                <span role="link" aria-current="page" class="font-normal text-foreground">Home</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </SidebarInsetCn>
        </SidebarProviderCn>
    </div>
</section>

@code {
    private record NavItem(string Title, string Url, string Icon, bool IsActive = false);

    private static readonly NavItem[] _mainNav =
    [
        new("Home", "#", "home", IsActive: true),
        new("Inbox", "#", "inbox"),
        new("Documents", "#", "file-text"),
        new("Projects", "#", "folder"),
    ];

    private static readonly NavItem[] _workspace =
    [
        new("Team", "#", "users"),
        new("Analytics", "#", "bar-chart"),
        new("Settings", "#", "settings"),
    ];
}
