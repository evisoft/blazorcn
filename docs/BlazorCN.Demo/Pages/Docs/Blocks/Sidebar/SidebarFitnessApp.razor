@* ============================================================
   Block: sidebar-fitness-app
   Title: SidebarFitnessApp
   Description: React fitness app sidebar with workout tracking, nutrition logging, and social features. Built with Next.js, shadcn/ui Sidebar components, and Tailwind CSS.
   Source: original/blocks/sidebar/sidebar-fitness-app.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <SidebarProviderCn Class="h-[700px] !min-h-0">
            <SidebarCn Class="border-r">
                <SidebarHeaderCn>
                    <SidebarMenuCn>
                        <SidebarMenuItemCn>
                            <SidebarMenuButtonCn Size="SidebarMenuButtonSize.Lg" Href="#">
                                <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                                    <LucideIconCn Name="activity" Size="16" Class="size-4" />
                                </div>
                                <div class="flex flex-col gap-0.5 leading-none">
                                    <span class="font-medium">FitTrack</span>
                                    <span class="">Fitness Platform</span>
                                </div>
                            </SidebarMenuButtonCn>
                        </SidebarMenuItemCn>
                    </SidebarMenuCn>
                </SidebarHeaderCn>
                <SidebarContentCn>
                    <SidebarGroupCn>
                        <SidebarGroupLabelCn>Training</SidebarGroupLabelCn>
                        <SidebarGroupContentCn>
                            <SidebarMenuCn>
                                @foreach (var item in _training)
                                {
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn Href="@item.Url" IsActive="@item.IsActive">
                                            <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                            <span>@item.Title</span>
                                        </SidebarMenuButtonCn>
                                    </SidebarMenuItemCn>
                                }
                            </SidebarMenuCn>
                        </SidebarGroupContentCn>
                    </SidebarGroupCn>

                    <SidebarGroupCn>
                        <SidebarGroupLabelCn>Tracking</SidebarGroupLabelCn>
                        <SidebarGroupContentCn>
                            <SidebarMenuCn>
                                @foreach (var item in _tracking)
                                {
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn Href="@item.Url" IsActive="@item.IsActive">
                                            <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                            <span>@item.Title</span>
                                        </SidebarMenuButtonCn>
                                    </SidebarMenuItemCn>
                                }
                            </SidebarMenuCn>
                        </SidebarGroupContentCn>
                    </SidebarGroupCn>

                    <SidebarGroupCn>
                        <SidebarGroupLabelCn>Social</SidebarGroupLabelCn>
                        <SidebarGroupContentCn>
                            <SidebarMenuCn>
                                @foreach (var item in _social)
                                {
                                    <SidebarMenuItemCn>
                                        <SidebarMenuButtonCn Href="@item.Url" IsActive="@item.IsActive">
                                            <LucideIconCn Name="@item.Icon" Size="16" Class="size-4" />
                                            <span>@item.Title</span>
                                        </SidebarMenuButtonCn>
                                    </SidebarMenuItemCn>
                                }
                            </SidebarMenuCn>
                        </SidebarGroupContentCn>
                    </SidebarGroupCn>
                </SidebarContentCn>
                <SidebarRailCn />
            </SidebarCn>

            <SidebarInsetCn Class="min-w-0 flex-1">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <SidebarTriggerCn Class="-ml-1" />
                    <div class="mr-2 w-px self-stretch bg-border data-[orientation=vertical]:h-4" data-orientation="vertical"></div>
                    <nav aria-label="Breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground break-words sm:gap-2.5">
                            <li class="hidden md:block">
                                <a href="#" class="transition-colors hover:text-foreground">Section</a>
                            </li>
                            <li role="presentation" aria-hidden="true" class="hidden md:block [&>svg]:size-3.5">
                                <LucideIconCn Name="chevron-right" Size="14" />
                            </li>
                            <li>
                                <span role="link" aria-current="page" class="font-normal text-foreground">Page</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </SidebarInsetCn>
        </SidebarProviderCn>
    </div>
</section>

@code {
    private record NavItem(string Title, string Url, string Icon, bool IsActive = false);

    private static readonly NavItem[] _training =
    [
        new("Workouts", "#", "dumbbell", true),
        new("Programs", "#", "calendar"),
        new("Exercises", "#", "list"),
    ];

    private static readonly NavItem[] _tracking =
    [
        new("Progress", "#", "trending-up"),
        new("Body", "#", "heart-pulse"),
        new("Nutrition", "#", "apple"),
    ];

    private static readonly NavItem[] _social =
    [
        new("Feed", "#", "rss"),
        new("Challenges", "#", "trophy"),
        new("Leaderboard", "#", "medal"),
    ];
}
