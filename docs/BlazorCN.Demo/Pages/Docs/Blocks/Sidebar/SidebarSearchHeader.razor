@* ============================================================
   Block: sidebar-search-header
   Title: SidebarSearchHeader
   Description: React sidebar with search input in header using Next.js, shadcn/ui SidebarInput and Label components, and Tailwind CSS for accessible navigation filtering.
   Source: original/blocks/sidebar/sidebar-search-header.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <SidebarProviderCn Class="h-[700px] !min-h-0">
            <SidebarCn Class="border-r">
                <SidebarHeaderCn>
                    <div class="relative">
                        <LabelCn For="sidebar-search" Class="sr-only">Search</LabelCn>
                        <LucideIconCn Name="search" Size="16" Class="pointer-events-none absolute top-1/2 left-2 size-4 -translate-y-1/2 text-muted-foreground" />
                        <SidebarInputCn id="sidebar-search" Placeholder="Search..." Class="pl-8" />
                    </div>
                </SidebarHeaderCn>
                <SidebarContentCn>
                    @foreach (var grp in _navMain)
                    {
                        <SidebarGroupCn>
                            <SidebarGroupLabelCn>@grp.Title</SidebarGroupLabelCn>
                            <SidebarGroupContentCn>
                                <SidebarMenuCn>
                                    @foreach (var item in grp.Items)
                                    {
                                        <SidebarMenuItemCn>
                                            <SidebarMenuButtonCn Href="@item.Url" IsActive="@item.IsActive">
                                                <span>@item.Title</span>
                                            </SidebarMenuButtonCn>
                                        </SidebarMenuItemCn>
                                    }
                                </SidebarMenuCn>
                            </SidebarGroupContentCn>
                        </SidebarGroupCn>
                    }
                </SidebarContentCn>
                <SidebarRailCn />
            </SidebarCn>

            <SidebarInsetCn Class="min-w-0 flex-1">
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    <SidebarTriggerCn Class="-ml-1" />
                    <div class="mr-2 w-px self-stretch bg-border data-[orientation=vertical]:h-4" data-orientation="vertical"></div>
                    <nav aria-label="Breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground break-words sm:gap-2.5">
                            <li class="hidden md:block">
                                <a href="#" class="transition-colors hover:text-foreground">Platform</a>
                            </li>
                            <li role="presentation" aria-hidden="true" class="hidden md:block [&>svg]:size-3.5">
                                <LucideIconCn Name="chevron-right" Size="14" />
                            </li>
                            <li>
                                <span role="link" aria-current="page" class="font-normal text-foreground">Projects</span>
                            </li>
                        </ol>
                    </nav>
                </header>
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </SidebarInsetCn>
        </SidebarProviderCn>
    </div>
</section>

@code {
    private record NavItem(string Title, string Url, bool IsActive = false);
    private record NavGroup(string Title, NavItem[] Items);

    private static readonly NavGroup[] _navMain =
    [
        new("Platform",
        [
            new("Dashboard", "#"),
            new("Projects", "#", IsActive: true),
            new("Tasks", "#"),
            new("Reports", "#"),
        ]),
        new("Resources",
        [
            new("Documentation", "#"),
            new("API Reference", "#"),
            new("Guides", "#"),
            new("Changelog", "#"),
        ]),
        new("Settings",
        [
            new("General", "#"),
            new("Team", "#"),
            new("Billing", "#"),
            new("Integrations", "#"),
            new("Notifications", "#"),
        ]),
        new("Support",
        [
            new("Help Center", "#"),
            new("Contact Us", "#"),
            new("Status Page", "#"),
        ]),
    ];
}
