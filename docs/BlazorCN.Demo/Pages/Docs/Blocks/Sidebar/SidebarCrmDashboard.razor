@* ============================================================
   Block: sidebar-crm-dashboard
   Title: SidebarCrmDashboard
   Description: A React sidebar for CRM platforms with nested navigation, built with Next.js, TypeScript, shadcn/ui Sidebar and SidebarMenuSub components, and Tailwind CSS. Features pipeline, activities, and reports.
   Source: original/blocks/sidebar/sidebar-crm-dashboard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex h-[700px]">
            @* Sidebar *@
            <aside class="flex w-64 shrink-0 flex-col border-r bg-sidebar text-sidebar-foreground">
                @* SidebarHeader *@
                <div class="flex flex-col gap-2 p-2">
                    <ul class="flex w-full min-w-0 flex-col gap-1">
                        <li class="group/menu-item relative">
                            <a href="#"
                               class="flex w-full items-center gap-2 overflow-hidden rounded-md p-2 text-left text-sm outline-none transition-[width,height,padding] hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-2 active:bg-sidebar-accent active:text-sidebar-accent-foreground h-12">
                                <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                                    <LucideIconCn Name="target" Size="16" Class="size-4" />
                                </div>
                                <div class="flex flex-col gap-0.5 leading-none">
                                    <span class="font-medium">SalesCRM</span>
                                    <span class="text-xs">Enterprise</span>
                                </div>
                            </a>
                        </li>
                    </ul>
                </div>

                @* SidebarContent *@
                <div class="flex min-h-0 flex-1 flex-col gap-2 overflow-auto px-2 pb-2">
                    @foreach (var grp in _groups)
                    {
                        var navGroup = grp;
                        <div class="relative flex w-full flex-col">
                            @* SidebarGroupLabel *@
                            <div class="flex h-8 shrink-0 items-center rounded-md px-2 text-xs font-medium text-sidebar-foreground/70 outline-none ring-sidebar-ring transition-[margin,opacity] duration-200 ease-linear focus-visible:ring-2">
                                @navGroup.Title
                            </div>
                            @* SidebarGroupContent *@
                            <div class="w-full text-sm">
                                <ul class="flex w-full min-w-0 flex-col gap-1">
                                    @foreach (var item in navGroup.Items)
                                    {
                                        var navItem = item;
                                        var isOpen = _openItems.Contains(navItem.Title);
                                        <li class="group/menu-item relative">
                                            @* CollapsibleTrigger acting as SidebarMenuButton *@
                                            <button type="button"
                                                    @onclick="@(() => ToggleItem(navItem.Title))"
                                                    class="@Cn.Merge("flex w-full items-center gap-2 overflow-hidden rounded-md p-2 text-left text-sm outline-none transition-[width,height,padding] hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-2 active:bg-sidebar-accent active:text-sidebar-accent-foreground h-8", navItem.IsActive ? "bg-sidebar-accent font-medium text-sidebar-accent-foreground" : "")">
                                                <LucideIconCn Name="@navItem.IconName" Size="16" Class="size-4" />
                                                <span>@navItem.Title</span>
                                                <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("ml-auto size-4 transition-transform duration-200", isOpen ? "rotate-90" : "")" />
                                            </button>
                                            @* CollapsibleContent — SidebarMenuSub *@
                                            @if (isOpen)
                                            {
                                                <ul class="mx-3.5 flex min-w-0 translate-x-px flex-col gap-1 border-l border-sidebar-border px-2.5 py-0.5">
                                                    @foreach (var sub in navItem.SubItems)
                                                    {
                                                        <li class="group/menu-sub-item relative">
                                                            <a href="@sub.Url"
                                                               class="flex h-7 min-w-0 -translate-x-px items-center gap-2 overflow-hidden rounded-md px-2 text-sidebar-foreground outline-none ring-sidebar-ring hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-2 active:bg-sidebar-accent active:text-sidebar-accent-foreground disabled:pointer-events-none disabled:opacity-50 aria-disabled:pointer-events-none aria-disabled:opacity-50 [&>span:last-child]:truncate [&>svg]:size-4 [&>svg]:shrink-0 [&>svg]:text-sidebar-accent-foreground text-xs">
                                                                <span>@sub.Title</span>
                                                            </a>
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                </div>

                @* SidebarRail — thin hover strip *@
                <button type="button" aria-label="Toggle Sidebar"
                        class="absolute inset-y-0 z-20 hidden w-4 -translate-x-1/2 transition-all ease-linear after:absolute after:inset-y-0 after:left-1/2 after:w-[2px] hover:after:bg-sidebar-border group-data-[side=left]:-right-4 sm:flex"></button>
            </aside>

            @* SidebarInset *@
            <div class="relative flex min-h-svh min-w-0 flex-1 flex-col bg-background">
                @* Header *@
                <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                    @* SidebarTrigger *@
                    <button type="button"
                            class="-ml-1 inline-flex size-7 shrink-0 items-center justify-center gap-2 rounded-md p-0 text-sm font-medium text-sidebar-foreground/70 outline-none ring-sidebar-ring transition-transform hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-2">
                        <LucideIconCn Name="panel-left" Size="16" Class="size-4" />
                        <span class="sr-only">Toggle Sidebar</span>
                    </button>
                    @* Vertical separator *@
                    <div class="mr-2 h-4 w-px bg-border"></div>
                    @* Breadcrumb *@
                    <nav aria-label="breadcrumb">
                        <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                            <li class="hidden items-center gap-1.5 md:flex">
                                <a href="#" class="transition-colors hover:text-foreground">Pipeline</a>
                            </li>
                            <li class="hidden md:block" aria-hidden="true" role="presentation">
                                <LucideIconCn Name="chevron-right" Size="16" Class="size-3.5" />
                            </li>
                            <li class="flex items-center gap-1.5">
                                <span role="link" aria-disabled="true" aria-current="page" class="font-normal text-foreground">Deals</span>
                            </li>
                        </ol>
                    </nav>
                </header>

                @* Main content *@
                <div class="flex flex-1 flex-col gap-4 p-4">
                    <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                        <div class="aspect-video rounded-xl bg-muted/50"></div>
                    </div>
                    <div class="flex-1 rounded-xl bg-muted/50"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record SubItem(string Title, string Url);
    private record NavItem(string Title, string IconName, SubItem[] SubItems, bool IsActive = false);
    private record NavGroup(string Title, NavItem[] Items);

    private static readonly NavGroup[] _groups =
    [
        new("Pipeline",
        [
            new("Deals", "handshake", [new("All Deals", "#"), new("Won", "#"), new("Lost", "#")], true),
            new("Contacts", "contact", [new("All Contacts", "#"), new("Recently Added", "#")]),
            new("Companies", "building", [new("All Companies", "#"), new("Prospects", "#")]),
        ]),
        new("Activities",
        [
            new("Tasks", "list-todo", [new("My Tasks", "#"), new("Overdue", "#")]),
            new("Calls", "phone-call", [new("Scheduled", "#"), new("Call Log", "#")]),
            new("Meetings", "calendar", [new("Upcoming", "#"), new("Past", "#")]),
        ]),
        new("Reports",
        [
            new("Dashboard", "layout-dashboard", [new("Overview", "#"), new("Team Performance", "#")]),
            new("Forecasts", "trending-up", [new("Revenue Forecast", "#"), new("Pipeline Forecast", "#")]),
        ]),
    ];

    private readonly HashSet<string> _openItems = ["Deals"];

    private void ToggleItem(string title)
    {
        if (!_openItems.Add(title))
            _openItems.Remove(title);
    }
}
