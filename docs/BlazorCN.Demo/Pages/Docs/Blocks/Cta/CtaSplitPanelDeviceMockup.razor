   Block: cta-split-panel-device-mockup
   Title: CtaSplitPanelDeviceMockup
   Description: A split panel dark CTA for React and Next.js with left copy stack, dual action buttons, and right-side device frame mockup, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-split-panel-device-mockup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground">
        <div class="grid items-center md:grid-cols-2">

            @* Left — copy + actions *@
            <div class="px-8 py-12 md:px-12 md:py-14">
                <p class="mb-4 text-xs font-medium uppercase tracking-wider text-background/50">
                    Mobile app
                </p>
                <h2 class="text-3xl font-semibold tracking-tight text-background sm:text-4xl">
                    Your workspace,
                    <br />
                    in your pocket.
                </h2>
                <p class="mt-4 max-w-md text-base leading-relaxed text-background/60">
                    Manage projects, review changes, and collaborate with your team — anywhere, anytime.
                </p>

                <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
                    <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[180px]">
                        Get the app
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[170px]">
                        Learn more
                    </ButtonCn>
                </div>

                <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-background/40">
                    <span>4.9 rating</span>
                    <span aria-hidden="true">&middot;</span>
                    <span>50k+ downloads</span>
                    <span aria-hidden="true">&middot;</span>
                    <span>Works offline</span>
                </div>
            </div>

            @* Right — decorative device frame *@
            <div aria-hidden="true" class="hidden items-center justify-center py-12 md:flex">
                <div class="relative h-[320px] w-[160px] rounded-[2rem] border-[5px] border-background/20 bg-background/[0.06]">
                    <div class="absolute left-1/2 top-0 z-10 h-4 w-14 -translate-x-1/2 rounded-b-lg bg-background/20"></div>
                    <div class="flex h-full w-full items-center justify-center overflow-hidden rounded-[1.5rem]">
                        <svg
                            aria-hidden="true"
                            class="size-8 text-background/20"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1"
                            viewBox="0 0 24 24">
                            <path d="M12 3v18M3 12h18" />
                        </svg>
                    </div>
                    <div class="absolute bottom-1.5 left-1/2 h-1 w-12 -translate-x-1/2 rounded-full bg-background/15"></div>
                </div>
            </div>

        </div>
    </div>
</section>
