@* ============================================================
   Block: cta-email-capture-light-pill
   Title: CtaEmailCaptureLightPill
   Description: A light email capture CTA for React and Next.js with a bordered card, status-dot announcement pill, inline email form, AnimatePresence success state, and user count trust row, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-email-capture-light-pill.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl border bg-card px-6 py-12 text-center sm:px-12 sm:py-14">

        <span class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs font-medium text-foreground">
            <span class="size-1.5 rounded-full bg-emerald-500"></span>
            Beta now open
        </span>

        <h2 class="mx-auto mt-6 max-w-lg text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
            Be the first to experience what's next.
        </h2>

        <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
            Join the beta and get early access to new features, a direct line to our team, and free
            Pro access while we're in beta.
        </p>

        <div class="mt-8">
            @if (_submitted)
            {
                <div class="mx-auto flex max-w-md items-center justify-center gap-2 rounded-lg border bg-muted/50 px-4 py-3"
                     role="status">
                    <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-foreground">
                        <LucideIconCn Name="check" Size="12" Class="size-3 text-background" />
                    </span>
                    <span class="text-sm font-medium text-foreground">
                        You're in. Check your inbox for next steps.
                    </span>
                </div>
            }
            else
            {
                <form class="mx-auto flex max-w-md flex-col items-stretch gap-2 sm:flex-row sm:items-center"
                      @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
                    <InputCn @bind-Value="_email"
                             Type="email"
                             Placeholder="@("you@company.com")"
                             aria-label="Email address"
                             Class="h-12 flex-1"
                             Required="true" />
                    <ButtonCn Class="h-12 w-full shrink-0 sm:w-auto" type="submit">
                        Request access
                    </ButtonCn>
                </form>
            }
        </div>

        <div class="mt-6 flex items-center justify-center gap-2 text-xs text-muted-foreground">
            <LucideIconCn Name="users" Size="14" Class="size-3.5" />
            <span>2,847 developers already signed up</span>
        </div>

    </div>
</section>

@code {
    private string _email = "";
    private bool _submitted = false;

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_email)) return;
        _submitted = true;
    }
}
