@* ============================================================
   Block: cta-centered-light-category-tile-grid
   Title: CtaCenteredLightCategoryTileGrid
   Description: A centered light CTA section for React and Next.js with an eyebrow count badge, headline, two-up to four-up category tile grid, and primary ShadcnioButton browse action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-light-category-tile-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl border bg-card px-6 py-12 text-center sm:px-10 sm:py-14">
        <div class="inline-flex items-center gap-2">
            <LucideIconCn Name="layout-grid" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium text-foreground">Template gallery</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                @_totalItems+ templates
            </BadgeCn>
        </div>

        <h2 class="mx-auto mt-5 max-w-lg text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
            Skip the blank canvas
        </h2>
        <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
            Start with a professionally designed template. Customize colors, content, and layout to
            make it yours.
        </p>

        <div class="mx-auto mt-8 grid max-w-xl grid-cols-2 gap-2 sm:grid-cols-4">
            @foreach (var cat in _categories)
            {
                <div class="rounded-lg border bg-muted/40 px-3 py-3 text-left transition-colors hover:bg-muted/60">
                    <p class="text-xs font-medium text-foreground">@cat.Name</p>
                    <p class="mt-0.5 text-xs tabular-nums text-muted-foreground">
                        @cat.Count templates
                    </p>
                </div>
            }
        </div>

        <div class="mt-8 flex justify-center">
            <ButtonCn Class="w-full sm:w-[210px]">Browse all templates</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TemplateCategory(string Name, int Count);

    private static readonly TemplateCategory[] _categories =
    [
        new("Dashboards",     42),
        new("Landing Pages",  36),
        new("Admin Panels",   28),
        new("E-commerce",     24),
        new("Portfolios",     18),
        new("Documentation",  14),
        new("Blogs",          12),
        new("SaaS Apps",       9),
    ];

    private static readonly int _totalItems = 183;
}
