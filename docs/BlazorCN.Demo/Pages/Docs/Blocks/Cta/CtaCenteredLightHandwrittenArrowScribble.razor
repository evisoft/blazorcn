@* ============================================================
   Block: cta-centered-light-handwritten-arrow-scribble
   Title: CtaCenteredLightHandwrittenArrowScribble
   Description: A centered light CTA for React and Next.js with a hand-drawn SVG curved arrow scribble pointing from the subtext down to the primary ShadcnioButton, italic handwritten note, and friendly onboarding copy built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-light-handwritten-arrow-scribble.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="relative overflow-hidden rounded-2xl border bg-card px-8 py-10 text-center">

        @* Eyebrow *@
        <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-3 py-1 text-xs font-medium text-foreground">
            <LucideIconCn Name="sparkles" Size="12" Class="size-3 text-foreground/70" />
            Welcome aboard
        </span>

        @* Headline *@
        <h2 class="mx-auto mt-5 max-w-md text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
            Your first workspace is ready
        </h2>

        @* Subtext *@
        <p class="mx-auto mt-3 max-w-sm text-sm text-muted-foreground leading-relaxed">
            We prepared a starter project with sample data so you can explore every feature without
            setting anything up.
        </p>

        @* Hand-drawn arrow + handwritten note wrapper *@
        <div aria-hidden="true" class="pointer-events-none relative mx-auto mt-6 hidden h-16 w-full max-w-xs sm:block">
            <svg
                aria-hidden="true"
                class="absolute inset-0 h-full w-full stroke-foreground/40"
                fill="none"
                preserveAspectRatio="none"
                role="img"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.75"
                viewBox="0 0 280 64"
                xmlns="http://www.w3.org/2000/svg">
                <title>Hand-drawn arrow pointing to the primary action button</title>
                @* Wobbly bezier that arcs right-to-left and dips down toward the button *@
                <path d="M 30 8 Q 70 -4 118 14 T 196 38 Q 214 46 224 56" />
                @* Arrowhead at the end of the path *@
                <path d="M 214 48 L 224 56 L 216 62" />
            </svg>

            @* Handwritten note tilted over the arrow *@
            <span class="-translate-y-1/2 absolute top-1/2 left-3 rotate-[-8deg] font-serif text-muted-foreground text-sm italic">
                Start here!
            </span>
        </div>

        @* Button row *@
        <div class="mt-4 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <ButtonCn Class="w-full sm:w-[195px]">Open workspace</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[150px]">
                Take a tour
            </ButtonCn>
        </div>

        @* Trust text *@
        <p class="mt-5 text-xs text-muted-foreground">
            Sample data included &middot; Delete anytime &middot; No setup required
        </p>
    </div>
</section>
