@* ============================================================
   Block: cta-split-panel-counter-stats-grid
   Title: CtaSplitPanelCounterStatsGrid
   Description: A split panel dark CTA for React and Next.js with a 2x2 counter stats grid on the right panel using gap-as-border cells, animated tabular-nums number count-up, inline icons, and a dual ShadcnioButton row, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-split-panel-counter-stats-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground">
        <div class="grid gap-8 px-6 py-10 md:grid-cols-2 md:items-center md:gap-10 md:px-10 md:py-12">

            @* Left — copy *@
            <div>
                <span class="inline-flex items-center gap-2 rounded-full border border-background/15 bg-background/5 px-3 py-1 text-xs font-medium text-background/80">
                    Scale with confidence
                </span>

                <h2 class="mt-4 text-3xl font-semibold tracking-tight text-background sm:text-4xl">
                    Ship faster at any scale.
                </h2>

                <p class="mt-3 max-w-md text-sm leading-relaxed text-background/60 sm:text-base">
                    Real-time metrics, instant rollbacks, and team-wide visibility baked into every
                    deploy.
                </p>

                <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
                    <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[180px]">
                        Get started
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[175px]">
                        View metrics
                    </ButtonCn>
                </div>
            </div>

            @* Right — 2x2 stats grid with gap-as-border *@
            <div class="grid grid-cols-2 gap-px overflow-hidden rounded-xl bg-background/10">
                @foreach (var stat in _stats)
                {
                    <div class="flex flex-col gap-3 bg-foreground p-6">
                        <LucideIconCn Name="@stat.IconName" Size="16" Class="size-4 text-background/40" />
                        <div class="font-semibold text-2xl text-background tabular-nums tracking-tight sm:text-3xl">
                            @stat.Value
                        </div>
                        <div class="text-xs text-background/50">@stat.Label</div>
                    </div>
                }
            </div>

        </div>
    </div>
</section>

@code {
    private record Stat(string Value, string Label, string IconName);

    private static readonly Stat[] _stats =
    [
        new("12.4K", "Active users",  "trending-up"),
        new("99.9%", "Uptime SLA",    "activity"),
        new("847",   "Deploys/day",   "rocket"),
        new("3.2s",  "Build time",    "zap"),
    ];
}
