@* ============================================================
   Block: cta-centered-dark-orbit-ring-avatars
   Title: CtaCenteredDarkOrbitRingAvatars
   Description: A centered dark CTA for React and Next.js with a circular orbital ring of 8 avatars around a central icon medallion on bg-foreground, community-building headline, and single inverted ShadcnioButton built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-dark-orbit-ring-avatars.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="relative overflow-hidden rounded-2xl bg-foreground px-6 py-14 text-center sm:px-12 sm:py-16">

        @* Orbit ring + avatars *@
        <div aria-hidden="true" class="relative mx-auto flex h-64 w-64 items-center justify-center sm:h-72 sm:w-72">

            @* Dashed orbit ring *@
            <div class="absolute inset-8 rounded-full border border-dashed border-background/15"></div>
            <div class="absolute inset-0 rounded-full border border-background/5"></div>

            @* Central icon medallion *@
            <div class="relative z-10 flex size-16 items-center justify-center rounded-full border border-background/20 bg-background/10 shadow-[inset_0_0_0_1px_rgb(255_255_255_/_0.04)]">
                <div class="flex size-12 items-center justify-center rounded-full bg-background text-foreground">
                    <LucideIconCn Name="users" Size="20" Class="size-5" StrokeWidth="2" />
                </div>
            </div>

            @* Orbiting avatars *@
            @foreach (var member in _members)
            {
                <span
                    class="absolute left-1/2 top-1/2 flex size-10 items-center justify-center rounded-full border border-background/15 bg-background/10 text-[11px] font-semibold text-background/85 backdrop-blur-sm transition-transform hover:scale-110 sm:size-11"
                    style="@($"transform: translate(calc(-50% + {member.X}px), calc(-50% + {member.Y}px));")"
                    title="@member.Name">
                    @member.Initials
                </span>
            }
        </div>

        @* Content *@
        <div class="relative z-10 mt-8">
            <h2 class="mx-auto max-w-xl text-3xl font-semibold tracking-tight text-background sm:text-4xl">
                Join @_communityCount developers
                <br />
                building in the open.
            </h2>

            <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-background/60">
                A private Slack for component authors, design engineers, and indie hackers. Weekly
                office hours, monthly showcases, early previews.
            </p>

            <ButtonCn Class="mt-8 w-full bg-background text-foreground hover:bg-background/90 sm:w-[210px]">
                Request invite
            </ButtonCn>

            <p class="mt-4 text-xs text-background/35">
                Free forever &middot; Approved within 24 hours
            </p>
        </div>
    </div>
</section>

@code {
    private record Member(string Initials, string Name, int X, int Y);

    private static readonly Member[] _members =
    [
        new("EV", "Emma Vargas",   0,    -118),
        new("JM", "Jordan Maro",   83,   -83),
        new("KL", "Kenji Liu",     118,  0),
        new("AP", "Aditi Patel",   83,   83),
        new("RS", "Rosa Silva",    0,    118),
        new("TN", "Theo Nwosu",   -83,   83),
        new("MC", "Mira Chen",    -118,  0),
        new("DB", "Dani Bauer",   -83,  -83),
    ];

    private const string _communityCount = "12,000+";
}
