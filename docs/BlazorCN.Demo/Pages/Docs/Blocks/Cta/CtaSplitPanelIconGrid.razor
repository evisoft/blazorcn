@* ============================================================
   Block: cta-split-panel-icon-grid
   Title: CtaSplitPanelIconGrid
   Description: A split panel dark CTA for React and Next.js with a 3x3 icon-tile grid visual, inverted primary ShadcnioButton, and ghost secondary action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-split-panel-icon-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground">
        <div class="grid items-center gap-8 px-8 py-12 md:grid-cols-2 md:gap-10 md:px-12 md:py-14">

            @* Left — copy *@
            <div>
                <p class="text-xs font-medium uppercase tracking-wider text-background/50">
                    Integrations
                </p>
                <h2 class="mt-4 text-3xl font-semibold tracking-tight text-background sm:text-4xl">
                    Connect with 200+ tools
                </h2>
                <p class="mt-4 max-w-sm text-base leading-relaxed text-background/60">
                    Plug into your existing stack. GitHub, Slack, Linear, Figma, Notion, and hundreds more
                    &mdash; all with first-class support.
                </p>
                <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
                    <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[200px]">
                        Browse integrations
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[200px]">
                        Request a tool
                    </ButtonCn>
                </div>
            </div>

            @* Right — icon tile grid *@
            <div aria-hidden="true" class="flex items-center justify-center">
                <div class="grid grid-cols-3 place-items-center gap-3">
                    @foreach (var tile in _tiles)
                    {
                        <div class="@Cn.Merge("flex items-center justify-center rounded-xl border border-background/10 bg-background/[0.06]", tile.Size == "lg" ? "size-14" : "size-10")">
                            <LucideIconCn Name="plus" Size="16" Class="size-4 text-background/25" />
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private record Tile(string Id, string Size);

    private static readonly Tile[] _tiles =
    [
        new("t1", "lg"),
        new("t2", "sm"),
        new("t3", "lg"),
        new("t4", "sm"),
        new("t5", "lg"),
        new("t6", "sm"),
        new("t7", "lg"),
        new("t8", "sm"),
        new("t9", "lg"),
    ];
}
