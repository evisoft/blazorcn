@* ============================================================
   Block: cta-centered-light-ranked-avatar-list
   Title: CtaCenteredLightRankedAvatarList
   Description: A centered light CTA section for React and Next.js with numbered ranked avatar list, highlighted user position callout, and inverted primary ShadcnioButton built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-light-ranked-avatar-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl border bg-card px-6 py-12 text-center sm:px-10 sm:py-14">
        <span class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs font-medium text-foreground">
            <span class="size-1.5 rounded-full bg-emerald-500"></span>
            Top performers this month
        </span>

        <h2 class="mx-auto mt-5 max-w-lg text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
            Climb the leaderboard
        </h2>

        <p class="mx-auto mt-4 max-w-sm text-base leading-relaxed text-muted-foreground">
            Top contributors earn exclusive rewards every month. See where you stand and move up the
            list.
        </p>

        <ul class="mx-auto mt-8 w-full max-w-xs space-y-1.5">
            @foreach (var entry in _leaderboard)
            {
                <li class="flex items-center gap-3 rounded-lg border bg-muted/30 px-3 py-2.5">
                    <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-foreground text-xs font-semibold tabular-nums text-background">
                        @entry.Rank
                    </span>
                    <span class="size-7 shrink-0 rounded-full bg-muted"></span>
                    <span class="flex-1 text-left text-sm font-medium text-foreground">
                        @entry.Name
                    </span>
                    <span class="text-xs font-semibold tabular-nums text-muted-foreground">
                        @entry.Count
                    </span>
                </li>
            }
        </ul>

        <div class="mx-auto mt-3 flex w-full max-w-xs items-center gap-3 rounded-lg border border-foreground/15 bg-foreground/[0.04] px-3 py-2.5">
            <span class="flex size-7 shrink-0 items-center justify-center rounded-full border bg-background text-xs font-semibold tabular-nums text-foreground">
                @_userPosition.Rank
            </span>
            <span class="size-7 shrink-0 rounded-full bg-muted"></span>
            <span class="flex-1 text-left text-sm font-medium text-foreground">You</span>
            <span class="text-xs font-semibold tabular-nums text-muted-foreground">
                @_userPosition.Count
            </span>
        </div>

        <div class="mt-8 flex justify-center">
            <ButtonCn Class="w-full sm:w-[170px]">Invite now</ButtonCn>
        </div>

        <p class="mt-4 text-xs text-muted-foreground">
            847 invites sent this month &middot; Resets on the 1st
        </p>
    </div>
</section>

@code {
    private record LeaderboardEntry(int Rank, string Name, int Count);

    private static readonly LeaderboardEntry[] _leaderboard =
    [
        new(1, "Sarah Chen", 47),
        new(2, "Marcus Rivera", 34),
        new(3, "Aisha Patel", 28),
    ];

    private static readonly LeaderboardEntry _userPosition = new(12, "You", 3);
}
