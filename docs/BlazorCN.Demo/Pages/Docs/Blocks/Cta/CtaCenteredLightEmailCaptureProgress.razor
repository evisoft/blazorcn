@* ============================================================
   Block: cta-centered-light-email-capture-progress
   Title: CtaCenteredLightEmailCaptureProgress
   Description: A centered light email capture CTA section for React and Next.js with avatar stack social proof, inline Input and ShadcnioButton form, animated progress bar, and spots-claimed counter built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-light-email-capture-progress.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card px-6 py-12 text-center sm:px-10 sm:py-14">

        @* Avatar stack *@
        <div aria-hidden="true" class="flex items-center justify-center">
            <div class="flex -space-x-2">
                @foreach (var avatar in _avatars)
                {
                    <div class="@Cn.Merge("flex size-7 items-center justify-center rounded-full border-2 border-card text-[10px] font-semibold", avatar.ClassName)">
                        @avatar.Initials
                    </div>
                }
                <div class="flex size-7 items-center justify-center rounded-full border-2 border-card bg-muted text-[10px] font-semibold text-muted-foreground">
                    +@((_claimed - _avatars.Length).ToString("N0"))
                </div>
            </div>
        </div>

        @* Headline *@
        <h2 class="mx-auto mt-5 max-w-lg text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
            Get early access.
        </h2>
        <p class="mx-auto mt-3 max-w-md text-base text-muted-foreground leading-relaxed">
            Join @_claimed.ToString("N0") others on the waitlist. Be the first to experience a
            faster way to build and ship.
        </p>

        @* Email capture form *@
        @if (_submitted)
        {
            <p aria-live="polite" class="mx-auto mt-8 max-w-sm text-sm font-medium text-foreground">
                Thanks! Check your inbox to confirm your spot.
            </p>
        }
        else
        {
            <form class="mx-auto mt-8 flex max-w-sm flex-col items-stretch gap-2 sm:flex-row sm:items-center"
                  @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
                <InputCn @bind-Value="_email"
                         Class="h-12 flex-1"
                         Placeholder="@("you@company.com")"
                         Type="email" />
                <ButtonCn Class="h-12 w-full shrink-0 sm:w-auto" type="submit">
                    Join waitlist
                </ButtonCn>
            </form>
        }

        @* Progress bar + spots *@
        <div class="mx-auto mt-8 max-w-sm">
            <div aria-valuemax="@_total"
                 aria-valuemin="0"
                 aria-valuenow="@_claimed"
                 class="h-1.5 w-full overflow-hidden rounded-full bg-muted"
                 role="progressbar">
                <div class="h-full rounded-full bg-foreground" style="@($"width:{_percentage}%")"></div>
            </div>
            <div class="mt-2 flex items-center justify-between text-xs text-muted-foreground">
                <span>
                    <span class="font-semibold tabular-nums text-foreground">@_claimed.ToString("N0")</span>
                    &nbsp;of @_total.ToString("N0") spots claimed
                </span>
                <span class="font-semibold tabular-nums text-foreground">@_percentage%</span>
            </div>
        </div>

        <p class="mt-6 text-xs text-muted-foreground">
            No spam &middot; Unsubscribe anytime &middot; First to know
        </p>
    </div>
</section>

@code {
    private record AvatarItem(string Initials, string ClassName);

    private static readonly AvatarItem[] _avatars =
    [
        new("JD", "bg-blue-500/20 text-blue-600"),
        new("KL", "bg-emerald-500/20 text-emerald-600"),
        new("MR", "bg-amber-500/20 text-amber-600"),
        new("AS", "bg-red-500/20 text-red-600"),
    ];

    private const int _claimed = 2847;
    private const int _total = 5000;
    private static readonly int _percentage = (int)Math.Round((double)_claimed / _total * 100);

    private string _email = "";
    private bool _submitted = false;

    private void HandleSubmit()
    {
        if (string.IsNullOrEmpty(_email)) return;
        _submitted = true;
    }
}
