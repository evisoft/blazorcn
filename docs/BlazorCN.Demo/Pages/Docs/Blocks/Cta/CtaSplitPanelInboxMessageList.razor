@* ============================================================
   Block: cta-split-panel-inbox-message-list
   Title: CtaSplitPanelInboxMessageList
   Description: A split panel CTA for React and Next.js with a left-side inbox message list preview, search bar, selected row highlight, right-side headline, and dual ShadcnioButton row built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-split-panel-inbox-message-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid md:grid-cols-2">

            @* Left — inbox preview *@
            <div class="bg-muted/40 p-6 sm:p-8" aria-hidden="true">
                <div class="overflow-hidden rounded-md border bg-background">

                    @* Search bar *@
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                        <LucideIconCn Name="search" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">Search messages</span>
                        <span class="ml-auto rounded border bg-background px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">
                            ⌘K
                        </span>
                    </div>

                    @* Message list *@
                    <ul class="divide-y">
                        @foreach (var msg in _messages)
                        {
                            var message = msg;
                            <li class="@Cn.Merge("flex items-start gap-3 px-3 py-3", message.Selected ? "bg-muted/50" : "")">
                                @* Avatar *@
                                <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-semibold text-foreground">
                                    @message.Initials
                                </div>

                                @* Sender / subject / preview *@
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-baseline justify-between gap-2">
                                        <p class="truncate text-xs font-semibold text-foreground">
                                            @message.Sender
                                        </p>
                                        <span class="shrink-0 text-[10px] text-muted-foreground">
                                            @message.Time
                                        </span>
                                    </div>
                                    <p class="mt-0.5 truncate text-xs font-medium text-foreground">
                                        @message.Subject
                                    </p>
                                    <p class="mt-0.5 truncate text-[11px] text-muted-foreground">
                                        @message.Preview
                                    </p>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            @* Right — copy + dual button row *@
            <div class="flex flex-col justify-center px-6 py-10 sm:px-10 sm:py-12">
                <p class="mb-3 text-sm font-medium text-muted-foreground">Inbox, reimagined</p>

                <h2 class="text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
                    Zero inbox,
                    <br />
                    for real this time.
                </h2>

                <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                    Triage, reply, and archive at the speed of thought. Built for teams that live in their
                    inbox but don&apos;t want to.
                </p>

                <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
                    <ButtonCn Class="w-full sm:w-[180px]">Get started</ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[170px]">Watch demo</ButtonCn>
                </div>

                <p class="mt-4 text-xs text-muted-foreground">
                    Free for 14 days &middot; No credit card required &middot; Cancel anytime
                </p>
            </div>

        </div>
    </div>
</section>

@code {
    private record Message(string Id, string Sender, string Initials, string Subject, string Preview, string Time, bool Selected);

    private static readonly Message[] _messages =
    [
        new("m1", "Sarah Chen", "SC", "Re: Q1 planning doc", "We've updated the timeline based on the feedback from engineering — take a look…", "2m", true),
        new("m2", "Marcus Lee", "ML", "Design review — final mocks", "Pushed the latest screens to Figma. Main changes are on the dashboard and the empty state.", "18m", false),
        new("m3", "Priya Rao", "PR", "Customer interview notes", "Three calls wrapped this morning. One theme keeps coming up around onboarding friction.", "1h", false),
        new("m4", "Diego Alvarez", "DA", "Infra costs are trending down", "Snapshot for this week — the new caching layer is already paying for itself.", "4h", false),
        new("m5", "Hannah Weiss", "HW", "Welcome aboard!", "Excited to have you on the team. Here's a short guide to your first week at the company.", "Yesterday", false),
    ];
}
