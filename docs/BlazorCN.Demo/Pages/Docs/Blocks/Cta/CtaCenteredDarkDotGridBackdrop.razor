@* ============================================================
   Block: cta-centered-dark-dot-grid-backdrop
   Title: CtaCenteredDarkDotGridBackdrop
   Description: A centered dark CTA for React and Next.js with a subtle radial-gradient dot grid backdrop on bg-foreground, edge runtime release content, inverted primary ShadcnioButton, and ghost secondary action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-dark-dot-grid-backdrop.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="relative overflow-hidden rounded-2xl bg-foreground px-6 py-14 text-center sm:px-12 sm:py-20">
        @* Decorative dot-grid backdrop *@
        <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0"
            style="background-image:radial-gradient(circle, rgb(255 255 255 / 0.12) 1px, transparent 1px);background-size:18px 18px;mask-image:radial-gradient(ellipse 70% 60% at center, black 40%, transparent 95%);-webkit-mask-image:radial-gradient(ellipse 70% 60% at center, black 40%, transparent 95%);">
        </div>

        @* Content *@
        <div class="relative z-10">
            <span class="inline-flex items-center gap-2 rounded-full border border-background/15 bg-background/5 px-3 py-1 font-mono text-[11px] font-medium uppercase tracking-wider text-background/80">
                <span class="size-1 rounded-full bg-background/80"></span>
                @_meta.Eyebrow
            </span>

            <h2 class="mx-auto mt-6 max-w-xl text-3xl font-semibold tracking-tight text-background sm:text-4xl">
                Build faster on<br />the edge runtime.
            </h2>

            <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-background/60">
                Stream responses in under 40ms. Zero cold starts. One deploy command to ship to every
                region at once.
            </p>

            <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[200px]">
                    Deploy in 60s
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[170px]">
                    Read the docs
                </ButtonCn>
            </div>

            <p class="mt-6 font-mono text-[11px] text-background/40">@_meta.Runtime</p>
        </div>
    </div>
</section>

@code {
    private record MetaInfo(string Eyebrow, string Runtime);

    private static readonly MetaInfo _meta = new("Edge Runtime 2.0", "Deployed in 32 regions");
}
