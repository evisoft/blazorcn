@* ============================================================
   Block: cta-left-right-dark-progress-ring-tracker
   Title: CtaLeftRightDarkProgressRingTracker
   Description: A left right dark CTA section for React and Next.js with a circular SVG progress ring tracker beside the headline, subtext, and dual inverted ShadcnioButton actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-left-right-dark-progress-ring-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="flex flex-col gap-6 rounded-2xl bg-foreground px-6 py-8 md:flex-row md:items-center md:justify-between md:gap-10 md:px-10">

        @* Left — progress ring + headline cluster *@
        <div class="flex items-center gap-5">
            <div
                aria-label="Setup 68% complete"
                class="relative size-20 shrink-0"
                role="img">
                <svg
                    aria-hidden="true"
                    class="-rotate-90 size-full"
                    viewBox="0 0 80 80"
                    xmlns="http://www.w3.org/2000/svg">
                    @* Background track *@
                    <circle
                        class="stroke-background/15"
                        cx="40"
                        cy="40"
                        fill="none"
                        r="30"
                        stroke-width="6" />
                    @* Progress stroke *@
                    <circle
                        class="stroke-background"
                        cx="40"
                        cy="40"
                        fill="none"
                        r="30"
                        stroke-dasharray="@_circumference.ToString("F4")"
                        stroke-dashoffset="@_dashOffset.ToString("F4")"
                        stroke-linecap="round"
                        stroke-width="6" />
                </svg>
                <div class="absolute inset-0 flex items-center justify-center">
                    <span
                        aria-hidden="true"
                        class="font-semibold text-background text-lg tabular-nums">
                        @_progress%
                    </span>
                </div>
            </div>

            <div class="min-w-0">
                <h2 class="font-semibold text-background text-xl tracking-tight sm:text-2xl">
                    You&apos;re almost there
                </h2>
                <p class="mt-1.5 max-w-md text-background/60 text-sm">
                    Two quick steps left — invite your team and connect a repo to finish setup.
                </p>
            </div>
        </div>

        @* Right — dual action buttons *@
        <div class="flex shrink-0 flex-col gap-3 sm:flex-row sm:items-center">
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[170px]">
                Read the docs
            </ButtonCn>
            <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[180px]">
                Resume setup
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private const int _progress = 68;
    private const int _radius = 30;
    private static readonly double _circumference = 2 * Math.PI * _radius;
    private static readonly double _dashOffset = _circumference - (_progress / 100.0) * _circumference;
}
