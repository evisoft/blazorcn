@* ============================================================
   Block: cta-centered-light-polaroid-stack
   Title: CtaCenteredLightPolaroidStack
   Description: A centered light CTA for React and Next.js with three rotated offset polaroid cards stacked above the headline on bg-card, creative story sample content, and single primary ShadcnioButton built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-light-polaroid-stack.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="rounded-2xl border bg-card px-6 py-12 text-center sm:px-10 sm:py-14">
        @* Polaroid stack *@
        <div aria-hidden="true" class="flex items-center justify-center pb-8 pt-2">
            @foreach (var polaroid in _polaroids)
            {
                <div class="@($"{polaroid.Rotation} {polaroid.Offset} rounded-md border border-border/80 bg-background p-2 pb-8 shadow-sm transition-transform hover:-translate-y-1 hover:rotate-0")">
                    <div class="@($"relative flex size-28 items-center justify-center overflow-hidden rounded-sm bg-gradient-to-br sm:size-32 {polaroid.Gradient}")">
                        <LucideIconCn Name="camera" Size="24" Class="@($"size-6 {polaroid.Accent}")" StrokeWidth="1" />
                    </div>
                    <p class="mt-2 text-[10px] font-medium text-muted-foreground">
                        @polaroid.Caption
                    </p>
                </div>
            }
        </div>

        <h2 class="mx-auto max-w-md text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
            Share your story
            <br />
            in seconds.
        </h2>

        <p class="mx-auto mt-4 max-w-sm text-base leading-relaxed text-muted-foreground">
            Drop in a photo, write one line, post anywhere. Your memories, arranged as beautifully as
            a shoebox of keepsakes.
        </p>

        <div class="mt-8 flex justify-center">
            <ButtonCn Class="w-full sm:w-[200px]">Start your album</ButtonCn>
        </div>

        <p class="mt-4 text-xs text-muted-foreground">
            Free forever &middot; No ads &middot; Unlimited albums
        </p>
    </div>
</section>

@code {
    private record Polaroid(string Id, string Caption, string Rotation, string Offset, string Gradient, string Accent);

    private static readonly Polaroid[] _polaroids =
    [
        new("sunset", "Summer, 2026", "rotate-[-7deg]", "", "from-amber-200 via-orange-200 to-rose-200", "text-amber-700/40"),
        new("coast",  "Coastal loop",  "rotate-[3deg]",  "-ml-5 z-10", "from-sky-200 via-blue-200 to-indigo-200", "text-sky-700/40"),
        new("trail",  "North trail",   "rotate-[6deg]",  "-ml-5",      "from-emerald-200 via-teal-200 to-cyan-200", "text-emerald-700/40"),
    ];
}
