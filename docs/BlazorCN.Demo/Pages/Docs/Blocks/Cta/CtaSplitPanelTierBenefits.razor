@* ============================================================
   Block: cta-split-panel-tier-benefits
   Title: CtaSplitPanelTierBenefits
   Description: A split panel dark CTA for React and Next.js with a tier benefits list on the left, minimalist icon visual on the right, and ShadcnioButton action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-split-panel-tier-benefits.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground">
        <div class="grid md:grid-cols-2">

            @* Left — copy + tier list + CTA *@
            <div class="flex flex-col justify-center px-8 py-12 sm:px-10 sm:py-14">
                <p class="text-xs font-medium uppercase tracking-widest text-background/50">
                    Partner Program
                </p>

                <h2 class="mt-3 text-2xl font-semibold tracking-tight text-background sm:text-3xl">
                    Grow with us.
                    <br />
                    Earn recurring revenue.
                </h2>

                <div class="mt-6 space-y-3">
                    @foreach (var tier in _tiers)
                    {
                        <div class="flex items-start gap-2.5">
                            <LucideIconCn Name="check" Size="14" Class="mt-0.5 size-3.5 shrink-0 stroke-[3] text-emerald-400" />
                            <div>
                                <span class="text-sm font-medium text-background">
                                    @tier.Name &mdash; @tier.Perk
                                </span>
                                <span class="ml-2 text-xs text-background/40">@tier.Requirement</span>
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-8">
                    <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[170px]">
                        Apply now
                    </ButtonCn>
                    <p class="mt-4 text-xs text-background/30">320+ certified partners worldwide</p>
                </div>
            </div>

            @* Right — minimalist visual *@
            <div aria-hidden="true" class="hidden items-center justify-center bg-background/5 md:flex">
                <div class="flex flex-col items-center gap-3 p-12">
                    <div class="flex size-16 items-center justify-center rounded-full border border-background/10 bg-background/5">
                        <span class="text-2xl font-semibold text-background/30">%</span>
                    </div>
                    <div class="mt-2 space-y-1.5 text-center">
                        <div class="h-2 w-24 rounded-full bg-background/10"></div>
                        <div class="h-2 w-16 rounded-full bg-background/5"></div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private record Tier(string Name, string Perk, string Requirement);

    private static readonly Tier[] _tiers =
    [
        new("Silver", "15% commission", "5+ referrals / quarter"),
        new("Gold", "25% commission", "15+ referrals / quarter"),
        new("Platinum", "35% commission", "40+ referrals / quarter"),
    ];
}
