@* ============================================================
   Block: cta-card-inset-keyboard-hero
   Title: CtaCardInsetKeyboardHero
   Description: A card-inset dark CTA section for React and Next.js with a light outer wrapper, dark inner card, oversized keyboard key mockup hero with plus connectors, and an inverted primary ShadcnioButton built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-card-inset-keyboard-hero.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl border bg-card p-4 sm:p-5">
        <div class="rounded-xl bg-foreground px-6 py-10 text-center sm:px-10 sm:py-14">
            <span class="inline-flex items-center gap-2 rounded-full border border-background/15 bg-background/[0.06] px-3 py-1 text-background text-xs font-medium">
                Universal search
            </span>

            @* Keyboard keys row *@
            <div class="mt-7 flex items-center justify-center gap-2 sm:gap-3">
                @foreach (var key in _keys)
                {
                    var keyItem = key;
                    <div class="flex items-center gap-2 sm:gap-3">
                        <kbd class="@Cn.Merge("group/key inline-flex size-12 items-center justify-center rounded-lg border border-background/25 border-b-4 bg-background/10 font-mono text-background text-sm shadow-lg shadow-background/5 transition-all hover:border-b-2 hover:translate-y-0.5 sm:size-14 sm:text-base", keyItem.Wide ? "w-auto px-4 sm:w-auto sm:px-5" : "")">
                            @keyItem.Label
                        </kbd>
                        @if (keyItem != _keys[_keys.Length - 1])
                        {
                            <span aria-hidden="true" class="font-mono text-background/40 text-lg sm:text-xl">+</span>
                        }
                    </div>
                }
            </div>

            <h2 class="mx-auto mt-8 max-w-lg text-3xl font-semibold tracking-tight text-background sm:text-4xl">
                Find anything in milliseconds
            </h2>
            <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-background/60">
                A single keystroke opens the command palette — search files, run actions, jump to any
                view across your entire workspace.
            </p>

            <div class="mt-8 flex justify-center">
                <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[215px]">
                    Try the shortcut
                </ButtonCn>
            </div>

            <p class="mt-4 text-xs text-background/35">Available on macOS, Windows, and Linux</p>
        </div>
    </div>
</section>

@code {
    private record KeyCap(string Label, bool Wide = false);

    private static readonly KeyCap[] _keys =
    [
        new("⌘"),
        new("Shift", Wide: true),
        new("K"),
    ];
}
