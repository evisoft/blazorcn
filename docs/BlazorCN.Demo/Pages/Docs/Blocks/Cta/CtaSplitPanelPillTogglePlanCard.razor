@* ============================================================
   Block: cta-split-panel-pill-toggle-plan-card
   Title: CtaSplitPanelPillTogglePlanCard
   Description: A split panel CTA section for React and Next.js with a left-side pill toggle, animated savings badge, and right-side plan card featuring price reveal, feature checklist, and ShadcnioButton built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-split-panel-pill-toggle-plan-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground">
        <div class="grid grid-cols-1 md:grid-cols-2">

            @* Left — copy + toggle *@
            <div class="flex flex-col justify-center px-8 py-12 sm:px-10">
                <p class="font-medium text-background/40 text-xs uppercase tracking-widest">
                    Simple pricing
                </p>

                <h2 class="mt-3 font-semibold text-2xl text-background tracking-tight sm:text-3xl">
                    One plan.
                    <br />
                    Everything included.
                </h2>

                <p class="mt-3 max-w-sm text-background/50 text-sm leading-relaxed">
                    No feature gates, no per-seat surprises. Get the full platform for one transparent
                    price. Switch to annual and save.
                </p>

                @* Pill toggle *@
                <div class="mt-6 flex items-center gap-3">
                    <div class="flex items-center gap-0.5 rounded-lg bg-background/10 p-0.5">
                        <button
                            aria-pressed="@(_billing == "monthly")"
                            class="@Cn.Merge("rounded-md px-3 py-1.5 font-medium text-xs transition-colors", _billing == "monthly" ? "bg-background text-foreground shadow-sm" : "text-background/60 hover:text-background/80")"
                            @onclick="@(() => _billing = "monthly")"
                            type="button">
                            Monthly
                        </button>
                        <button
                            aria-pressed="@(_billing == "yearly")"
                            class="@Cn.Merge("rounded-md px-3 py-1.5 font-medium text-xs transition-colors", _billing == "yearly" ? "bg-background text-foreground shadow-sm" : "text-background/60 hover:text-background/80")"
                            @onclick="@(() => _billing = "yearly")"
                            type="button">
                            Yearly
                        </button>
                    </div>
                    @if (_billing == "yearly")
                    {
                        <BadgeCn Class="border-0 bg-emerald-500/20 text-[10px] text-emerald-400">
                            Save @SavingsPercent%
                        </BadgeCn>
                    }
                </div>
            </div>

            @* Right — plan card *@
            <div class="flex flex-col justify-center border-background/10 border-t bg-background/[0.04] px-8 py-12 sm:px-10 md:border-t-0 md:border-l">
                <p class="font-medium text-background/40 text-xs">Pro plan</p>

                @* Price *@
                <div class="mt-2 flex items-baseline gap-1">
                    <span class="font-semibold text-4xl text-background tabular-nums">$@Price</span>
                    <span class="text-background/40 text-sm">@Period</span>
                </div>
                @if (_billing == "yearly")
                {
                    <p class="mt-1 text-background/30 text-xs">Billed annually at $@YearlyPrice</p>
                }

                @* Features *@
                <div class="mt-6 space-y-2.5">
                    @foreach (var feature in _features)
                    {
                        <div class="flex items-start gap-2">
                            <LucideIconCn Name="check" Size="14" Class="mt-0.5 size-3.5 shrink-0 stroke-[3] text-emerald-400" />
                            <span class="text-background/70 text-sm">@feature</span>
                        </div>
                    }
                </div>

                @* CTA *@
                <ButtonCn Class="mt-8 w-full bg-background text-foreground hover:bg-background/90 sm:w-[180px]">
                    Get started
                </ButtonCn>

                <p class="mt-3 text-background/25 text-xs">
                    No credit card required &middot; Cancel anytime
                </p>
            </div>

        </div>
    </div>
</section>

@code {
    private const int MonthlyPrice = 29;
    private const int YearlyPrice = 290;
    private static int SavingsPercent => (int)Math.Round((1.0 - (double)YearlyPrice / (MonthlyPrice * 12)) * 100);

    private string _billing = "monthly";

    private int Price => _billing == "monthly" ? MonthlyPrice : YearlyPrice;
    private string Period => _billing == "monthly" ? "/mo" : "/yr";

    private static readonly string[] _features =
    [
        "Unlimited projects & collaborators",
        "Advanced analytics dashboard",
        "Priority email & chat support",
        "Custom integrations via API",
        "SSO & team management",
        "99.9% uptime SLA",
    ];
}
