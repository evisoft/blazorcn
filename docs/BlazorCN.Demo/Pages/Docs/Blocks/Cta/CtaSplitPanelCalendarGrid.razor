@* ============================================================
   Block: cta-split-panel-calendar-grid
   Title: CtaSplitPanelCalendarGrid
   Description: A split panel dark CTA section for React and Next.js with left-side headline and inverted primary ShadcnioButton plus a 5x4 calendar grid visual on the right built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-split-panel-calendar-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground">
        <div class="grid gap-8 px-6 py-10 md:grid-cols-2 md:items-center md:gap-12 md:px-10 md:py-12">

            @* Left — copy *@
            <div>
                <span class="inline-flex items-center gap-2 rounded-full border border-background/15 bg-background/5 px-3 py-1 text-xs font-medium text-background/80">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Slots open this week
                </span>
                <h2 class="mt-4 text-3xl font-semibold tracking-tight text-background sm:text-4xl">
                    See the product<br />
                    in action
                </h2>
                <p class="mt-4 max-w-sm text-base leading-relaxed text-background/60">
                    Book a 15-minute walkthrough with our team. We'll tailor the demo to your use case
                    &mdash; no slides, just the real product.
                </p>
                <ButtonCn Class="mt-7 w-full bg-background text-foreground hover:bg-background/90 sm:w-[185px]">
                    Book a demo
                </ButtonCn>
                <p class="mt-4 text-xs text-background/30">
                    Free &middot; No commitment &middot; 15 minutes
                </p>
            </div>

            @* Right — calendar grid visual *@
            <div aria-hidden="true" class="hidden overflow-hidden rounded-xl border border-background/10 bg-background/[0.04] p-5 md:block">

                @* Calendar header *@
                <div class="mb-4 flex items-center justify-between">
                    <span class="text-xs font-medium text-background/60">April 2026</span>
                    <div class="flex items-center gap-1">
                        <div class="size-1.5 rounded-full bg-background/20"></div>
                        <div class="size-1.5 rounded-full bg-background/20"></div>
                        <div class="size-1.5 rounded-full bg-background/40"></div>
                    </div>
                </div>

                @* Calendar grid *@
                <div class="grid grid-cols-5 gap-1.5">
                    @foreach (var day in _days)
                    {
                        var d = day;
                        var idx = _days.IndexOf(d);
                        var cellClass = idx < 5
                            ? "flex aspect-square items-center justify-center rounded-md text-[11px] font-medium text-background/40"
                            : d.Highlighted
                                ? "flex aspect-square items-center justify-center rounded-md text-[11px] font-medium bg-background text-foreground"
                                : "flex aspect-square items-center justify-center rounded-md text-[11px] font-medium border border-background/10 bg-background/[0.06] text-background/70";
                        <div class="@cellClass">
                            @d.Label
                        </div>
                    }
                </div>

                @* Selected slot label *@
                <div class="mt-4 flex items-center justify-between rounded-md border border-background/15 bg-background/[0.06] px-3 py-2">
                    <span class="text-xs font-medium text-background">Wed, Apr 16</span>
                    <span class="text-[11px] text-background/60">10:30 AM</span>
                </div>

            </div>

        </div>
    </div>
</section>

@code {
    private record CalendarDay(string Label, bool Highlighted = false);

    private static readonly List<CalendarDay> _days =
    [
        new("Mo"),
        new("Tu"),
        new("We"),
        new("Th"),
        new("Fr"),
        new("8"),
        new("9"),
        new("10"),
        new("11"),
        new("12"),
        new("15"),
        new("16", Highlighted: true),
        new("17"),
        new("18"),
        new("19"),
        new("22"),
        new("23"),
        new("24"),
        new("25"),
        new("26"),
    ];
}
