@* ============================================================
   Block: cta-card-inset-big-metric-checklist
   Title: CtaCardInsetBigMetricChecklist
   Description: A card-inset dark CTA block for React and Next.js with a muted outer panel, a dark inset card containing a big hero metric, a three-item emerald checklist, an inverted primary ShadcnioButton, and an eligibility footnote built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-card-inset-big-metric-checklist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-3xl bg-muted/40 p-2 sm:p-4">
        <div class="rounded-2xl bg-foreground px-6 py-12 text-center sm:px-12 sm:py-14">
            @* Eyebrow tagline *@
            <p class="text-xs font-semibold uppercase tracking-widest text-background/60">
                @_tagline
            </p>

            @* Hero metric *@
            <p class="mt-3 text-5xl font-semibold tabular-nums tracking-tight text-background sm:text-6xl">
                @_metric
            </p>
            <p class="mt-1 text-sm text-background/50">@_metricLabel</p>

            @* Headline *@
            <h2 class="mx-auto mt-6 max-w-md text-2xl font-semibold tracking-tight text-background sm:text-3xl">
                @_headline
            </h2>

            @* Benefits checklist *@
            <ul class="mx-auto mt-6 flex max-w-xs flex-col gap-2.5 text-left">
                @foreach (var benefit in _benefits)
                {
                    <li class="flex items-center gap-2.5">
                        <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
                        <span class="text-sm text-background/80">@benefit</span>
                    </li>
                }
            </ul>

            @* Primary CTA *@
            <div class="mt-8 flex items-center justify-center">
                <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[170px]">
                    Apply now
                </ButtonCn>
            </div>

            @* Eligibility footnote *@
            <p class="mt-4 text-xs text-background/30">@_eligibility</p>
        </div>
    </div>
</section>

@code {
    private const string _metric = "$25,000";
    private const string _metricLabel = "in platform credits";
    private const string _tagline = "Startup Program";
    private const string _headline = "Built for early-stage founders";
    private const string _eligibility = "For startups with less than $5M in funding, under 50 employees";

    private static readonly string[] _benefits =
    [
        "12 months of Pro plan access",
        "Dedicated success manager",
        "Co-marketing and logo placement",
    ];
}
