@* ============================================================
   Block: cta-split-panel-terminal-cursor
   Title: CtaSplitPanelTerminalCursor
   Description: A split panel dark CTA section for React and Next.js with terminal mockup visual, blinking cursor animation, traffic-light dots, monospace command line, and inverted primary ShadcnioButton built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-split-panel-terminal-cursor.tsx
   ============================================================ *@

<style>
    .blazorcn-blink {
        animation: blazorcn-cursor-blink 0.6s step-start infinite alternate;
    }
    @@keyframes blazorcn-cursor-blink {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0; }
    }
</style>

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground">
        <div class="grid gap-10 px-8 py-12 md:grid-cols-2 md:items-center md:gap-12 md:px-12 md:py-14">

            @* Left — copy *@
            <div>
                <span class="inline-flex items-center gap-2 rounded-full border border-background/15 bg-background/[0.06] px-3 py-1 text-background text-xs font-medium">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    CLI v1.0 — now stable
                </span>

                <h2 class="mt-5 text-3xl font-semibold tracking-tight text-background sm:text-4xl">
                    Install with<br />
                    one command
                </h2>

                <p class="mt-4 max-w-md text-base leading-relaxed text-background/60">
                    Spin up a production-ready project in seconds. No config files, no manual wiring —
                    just a single command and you're live.
                </p>

                <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
                    <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[180px]">
                        Get started
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[160px]">
                        View docs
                    </ButtonCn>
                </div>

                <p class="mt-4 text-xs text-background/35">
                    Works with Next.js, Remix, Vite, and Astro &middot; MIT licensed
                </p>
            </div>

            @* Right — terminal mockup *@
            <div aria-hidden="true" class="min-w-0">
                <div class="overflow-hidden rounded-lg border border-background/10 bg-background/[0.04] shadow-xl shadow-background/5">

                    @* Terminal title bar with traffic-light dots *@
                    <div class="flex items-center gap-3 border-b border-background/10 px-4 py-3">
                        <div class="flex items-center gap-1.5">
                            <span class="size-2.5 rounded-full bg-red-500/90"></span>
                            <span class="size-2.5 rounded-full bg-amber-500/90"></span>
                            <span class="size-2.5 rounded-full bg-emerald-500/90"></span>
                        </div>
                        <span class="flex-1 text-center font-mono text-[10px] text-background/35">
                            ~/projects/my-app — zsh
                        </span>
                    </div>

                    @* Terminal body *@
                    <div class="space-y-2 px-5 py-5 font-mono text-xs leading-relaxed">

                        @* Command line with blinking cursor *@
                        <div class="flex items-center gap-2">
                            <span class="text-emerald-400/90">$</span>
                            <span class="text-background/90">@_terminal.Command</span>
                            <span class="blazorcn-blink inline-block h-3 w-1.5 bg-background/80"></span>
                        </div>

                        @* Output lines *@
                        @foreach (var line in _terminal.Output)
                        {
                            var ln = line;
                            <div class="flex items-start gap-2">
                                @if (ln.Tone == "success")
                                {
                                    <LucideIconCn Name="check" Size="12" Class="mt-0.5 size-3 shrink-0 stroke-[3] text-emerald-400" />
                                }
                                else
                                {
                                    <span class="mt-0.5 size-3 shrink-0"></span>
                                }
                                <span class="@(ln.Tone == "success" ? "text-emerald-400/90" : ln.Tone == "muted" ? "text-background/40" : "text-background/80")">@ln.Text</span>
                            </div>
                        }

                        @* Trailing prompt *@
                        <div class="flex items-center gap-2 pt-1">
                            <span class="text-emerald-400/90">$</span>
                            <span class="blazorcn-blink inline-block h-3 w-1.5 bg-background/80"></span>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private record TerminalLine(string Text, string Tone);

    private record TerminalData(string Command, TerminalLine[] Output);

    private static readonly TerminalData _terminal = new(
        "npx create-stream@latest init",
        [
            new("◐  Resolving latest version...", "muted"),
            new("◑  Downloading package (2.4 MB)", "muted"),
            new("◒  Linking dependencies", "muted"),
            new("Ready on http://localhost:3000", "success"),
        ]
    );
}
