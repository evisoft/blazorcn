@* ============================================================
   Block: cta-split-panel-dual-preview
   Title: CtaSplitPanelDualPreview
   Description: A split panel dark CTA for React and Next.js with dual skeleton preview cards, inverted primary ShadcnioButton, ghost secondary action, and trust row built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-split-panel-dual-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground">
        <div class="grid gap-8 px-8 py-12 md:grid-cols-2 md:items-center md:gap-12 md:px-12 md:py-14">

            @* Left — copy *@
            <div>
                <p class="mb-4 text-sm font-medium text-background/50">Experimentation platform</p>

                <h2 class="text-3xl font-semibold tracking-tight text-background sm:text-4xl">
                    Stop guessing.
                    <br />
                    Start testing.
                </h2>

                <p class="mt-4 max-w-md text-base leading-relaxed text-background/60">
                    Run experiments on your product with zero engineering effort. Get statistically
                    significant results in days, not months.
                </p>

                <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
                    <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[210px]">
                        Start free trial
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[220px]">
                        See how it works
                    </ButtonCn>
                </div>

                <p class="mt-4 text-xs text-background/35">
                    No credit card required &middot; 14-day free trial &middot; Cancel anytime
                </p>
            </div>

            @* Right — A/B variant preview cards *@
            <div class="flex gap-3" aria-hidden="true">
                @foreach (var variant in _variants)
                {
                    <div class="flex-1 overflow-hidden rounded-xl border border-background/10 bg-background/[0.06]">

                        @* Card header *@
                        <div class="flex items-center gap-2 border-b border-background/10 px-4 py-2.5">
                            <span class="flex size-5 items-center justify-center rounded bg-background/15 text-[10px] font-bold text-background/70">
                                @variant.Label
                            </span>
                            <span class="text-xs font-medium text-background/40">
                                Variant @variant.Label
                            </span>
                        </div>

                        @* Skeleton content *@
                        <div class="space-y-2.5 px-4 py-4">
                            @* Skeleton heading *@
                            <div class="h-3 w-1/2 rounded-full bg-background/12"></div>

                            @* Skeleton body lines *@
                            @foreach (var width in variant.Lines)
                            {
                                <div class="@($"h-2 rounded-full bg-background/[0.07] {width}")"></div>
                            }

                            @* Skeleton button *@
                            <div class="mt-3 h-6 w-20 rounded-md bg-background/10"></div>
                        </div>

                    </div>
                }
            </div>

        </div>
    </div>
</section>

@code {
    private record Variant(string Label, string[] Lines);

    private static readonly Variant[] _variants =
    [
        new("A", ["w-3/4", "w-full", "w-2/3", "w-5/6"]),
        new("B", ["w-full", "w-1/2", "w-4/5", "w-2/3"]),
    ];
}
