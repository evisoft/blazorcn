        @* Left side — eyebrow pill + headline + subtitle *@
        <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-background/15 bg-background/5 px-3 py-1 text-xs font-medium text-background/80">
                <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-500"></span>
                For teams of 50+
            </span>
            <h2 class="mt-3 text-xl font-semibold tracking-tight text-background sm:text-2xl">
                Ready for enterprise?
            </h2>
            <p class="mt-1.5 max-w-md text-sm text-background/60">
                SSO, SLAs, dedicated support, and custom contracts for your team.
            </p>
        </div>

        @* Right side — buttons *@
        <div class="flex shrink-0 flex-col items-stretch gap-3 sm:flex-row sm:items-center">
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[180px]">
                See plans
            </ButtonCn>
            <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[190px]">
