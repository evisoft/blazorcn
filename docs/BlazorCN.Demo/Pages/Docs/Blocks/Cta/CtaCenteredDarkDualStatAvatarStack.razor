@* ============================================================
   Block: cta-centered-dark-dual-stat-avatar-stack
   Title: CtaCenteredDarkDualStatAvatarStack
   Description: A centered dark CTA section for React and Next.js with dual stat badges, contributor avatar stack, and paired ShadcnioButton actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-dark-dual-stat-avatar-stack.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl bg-foreground px-6 py-12 text-center sm:px-12 sm:py-16">
        @* Dual stat badges *@
        <div class="flex items-center justify-center gap-2">
            @foreach (var stat in _stats)
            {
                <span class="inline-flex items-center gap-1.5 rounded-full border border-background/15 bg-background/5 px-3 py-1 text-xs font-medium text-background">
                    <LucideIconCn Name="@stat.IconName" Size="12" Class="size-3 text-background/70" />
                    <span class="tabular-nums">@stat.Value</span>
                    <span class="text-background/50">@stat.Label</span>
                </span>
            }
        </div>

        @* Headline *@
        <h2 class="mx-auto mt-6 max-w-xl text-3xl font-semibold tracking-tight text-background sm:text-4xl">
            Built by the community,
            <br />
            for the community
        </h2>

        @* Subtitle *@
        <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-background/60">
            Join hundreds of contributors shipping production-ready components used by thousands of
            developers worldwide.
        </p>

        @* Contributor avatar stack *@
        <div aria-hidden="true" class="mt-7 flex items-center justify-center">
            <div class="flex -space-x-2">
                @foreach (var contributor in _contributors)
                {
                    <div class="flex size-8 items-center justify-center rounded-full border-2 border-foreground bg-background/15 text-[10px] font-medium text-background">
                        @contributor.Initials
                    </div>
                }
                <div class="flex size-8 items-center justify-center rounded-full border-2 border-foreground bg-background/10 text-[10px] font-medium text-background">
                    +@_overflowCount
                </div>
            </div>
        </div>

        @* CTA row *@
        <div class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
            <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[205px]">
                Star on GitHub
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[175px]">
                View repo
            </ButtonCn>
        </div>

        <p class="mt-4 text-xs text-background/30">
            MIT licensed &middot; Active since 2023 &middot; 342 contributors
        </p>
    </div>
</section>

@code {
    private record Stat(string IconName, string Label, string Value);
    private record Contributor(string Initials, string Name);

    private static readonly Stat[] _stats =
    [
        new("star", "stars", "12.4k"),
        new("git-fork", "forks", "1.8k"),
    ];

    private static readonly Contributor[] _contributors =
    [
        new("SC", "Sarah Chen"),
        new("MW", "Marcus Webb"),
        new("LP", "Lina Park"),
        new("DR", "Dev Rajan"),
        new("AT", "Ava Torres"),
    ];

    private const int _overflowCount = 342;
}
