@* ============================================================
   Block: cta-centered-light-email-capture
   Title: CtaCenteredLightEmailCapture
   Description: A centered light email capture CTA for React and Next.js with icon medallion, inline Input plus ShadcnioButton, AnimatePresence success state, and trust text, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-light-email-capture.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl border bg-card px-6 py-12 text-center sm:px-10 sm:py-16">

        <div class="mx-auto flex size-10 items-center justify-center rounded-full bg-muted">
            <LucideIconCn Name="mail" Size="20" Class="size-5 text-muted-foreground" />
        </div>

        <h2 class="mt-5 text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
            Never miss an update.
        </h2>

        <p class="mx-auto mt-3 max-w-md text-sm text-muted-foreground leading-relaxed">
            Get notified when we ship new features, improvements, and fixes. Delivered to your inbox
            every two weeks.
        </p>

        <div class="mx-auto mt-8 max-w-sm">
            @if (_subscribed)
            {
                <div class="flex items-center justify-center gap-2 py-2.5">
                    <span class="flex size-5 items-center justify-center rounded-full bg-emerald-500/10">
                        <LucideIconCn Name="check" Size="12" Class="size-3 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                    </span>
                    <span class="text-sm font-medium text-foreground">
                        You're subscribed. Check your inbox.
                    </span>
                </div>
            }
            else
            {
                <form class="flex items-center gap-2"
                      @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
                    <InputCn @bind-Value="_email"
                             Type="email"
                             Placeholder="@("you@company.com")"
                             aria-label="Email address"
                             Class="h-12 flex-1"
                             Required="true" />
                    <ButtonCn Class="h-12 shrink-0" type="submit">
                        Subscribe
                    </ButtonCn>
                </form>
            }
        </div>

        <p class="mt-4 text-xs text-muted-foreground">No spam &middot; Unsubscribe anytime</p>
    </div>
</section>

@code {
    private string _email = "";
    private bool _subscribed = false;

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_email)) return;
        _subscribed = true;
    }
}
