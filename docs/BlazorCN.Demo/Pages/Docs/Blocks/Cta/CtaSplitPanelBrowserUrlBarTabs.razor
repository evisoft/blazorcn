@* ============================================================
   Block: cta-split-panel-browser-url-bar-tabs
   Title: CtaSplitPanelBrowserUrlBarTabs
   Description: A split panel CTA for React and Next.js with a detailed browser window mockup, traffic light dots, monospace URL bar, tabbed chrome, and dual ShadcnioButton row built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-split-panel-browser-url-bar-tabs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="flex flex-col md:grid md:grid-cols-2 md:divide-x">

            @* Left panel — browser mockup *@
            <div aria-hidden="true"
                 class="flex items-center justify-center bg-muted/40 px-6 py-10 sm:px-10 sm:py-12">
                <div class="w-full max-w-md overflow-hidden rounded-md border bg-background shadow-sm">

                    @* Tab row *@
                    <div class="flex items-end gap-1 border-b bg-muted/60 px-3 pt-2.5">
                        @* Traffic lights *@
                        <div class="mr-3 mb-2 flex items-center gap-1.5">
                            <span class="size-2.5 rounded-full bg-red-500/80"></span>
                            <span class="size-2.5 rounded-full bg-amber-500/80"></span>
                            <span class="size-2.5 rounded-full bg-emerald-500/80"></span>
                        </div>
                        @* Tabs *@
                        <div class="flex min-w-0 flex-1 items-end gap-1">
                            @foreach (var tab in _tabs)
                            {
                                var t = tab;
                                <div class="@(t.Active
                                    ? "flex min-w-0 max-w-[120px] items-center gap-1.5 rounded-t-md border-t border-r border-l bg-background px-3 py-1.5 text-[10px] font-medium text-foreground"
                                    : "flex min-w-0 max-w-[100px] items-center gap-1.5 rounded-t-md bg-muted/40 px-3 py-1.5 text-[10px] font-medium text-muted-foreground/60")">
                                    <span class="@(t.Active
                                        ? "size-1.5 shrink-0 rounded-full bg-emerald-500"
                                        : "size-1.5 shrink-0 rounded-full bg-muted-foreground/30")"></span>
                                    <span class="truncate">@t.Title</span>
                                </div>
                            }
                        </div>
                    </div>

                    @* URL bar *@
                    <div class="flex items-center gap-2 border-b px-3 py-2">
                        <LucideIconCn Name="lock" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                        <div class="flex min-w-0 flex-1 items-center rounded-md bg-muted/50 px-2.5 py-1 font-mono text-[10px]">
                            <span class="text-muted-foreground/50">https://</span>
                            <span class="truncate text-foreground">@_urlHost</span>
                            <span class="hidden text-muted-foreground/50 sm:inline">@_urlPath</span>
                        </div>
                    </div>

                    @* Page body *@
                    <div class="space-y-3 px-4 py-4">
                        @* Fake nav *@
                        <div class="flex items-center justify-between">
                            <div class="h-2 w-16 rounded-full bg-muted"></div>
                            <div class="flex gap-2">
                                <div class="h-2 w-8 rounded-full bg-muted/70"></div>
                                <div class="h-2 w-8 rounded-full bg-muted/70"></div>
                                <div class="h-2 w-10 rounded-full bg-muted/70"></div>
                            </div>
                        </div>
                        @* Fake hero *@
                        <div class="space-y-2 pt-2">
                            <div class="h-3 w-4/5 rounded-full bg-muted"></div>
                            <div class="h-3 w-3/5 rounded-full bg-muted"></div>
                            <div class="h-1.5 w-full rounded-full bg-muted/60"></div>
                            <div class="h-1.5 w-5/6 rounded-full bg-muted/60"></div>
                        </div>
                        @* Fake button + grid *@
                        <div class="flex items-center gap-2 pt-1">
                            <div class="h-5 w-16 rounded-md bg-foreground/80"></div>
                            <div class="h-5 w-14 rounded-md border bg-background"></div>
                        </div>
                        <div class="grid grid-cols-3 gap-2 pt-2">
                            <div class="aspect-[4/3] rounded-md bg-muted/70"></div>
                            <div class="aspect-[4/3] rounded-md bg-muted/70"></div>
                            <div class="aspect-[4/3] rounded-md bg-muted/70"></div>
                        </div>
                    </div>

                </div>
            </div>

            @* Right panel — copy *@
            <div class="flex flex-col justify-center px-6 py-10 sm:px-10 sm:py-14">
                <p class="mb-4 text-sm font-medium text-muted-foreground">Website builder</p>

                <h2 class="font-semibold text-2xl tracking-tight text-foreground sm:text-3xl lg:text-4xl">
                    Ship your site in<br />
                    30 seconds.
                </h2>

                <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                    Pick a template, connect your domain, and go live before your coffee gets cold. No
                    DevOps. No build configs. No wait.
                </p>

                <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
                    <ButtonCn Class="w-full sm:w-[195px]">Start for free</ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[180px]">View templates</ButtonCn>
                </div>

                <p class="mt-4 text-xs text-muted-foreground">
                    Free SSL &middot; Custom domains &middot; No credit card required
                </p>
            </div>

        </div>
    </div>
</section>

@code {
    private record BrowserTab(string Id, string Title, bool Active);

    private static readonly BrowserTab[] _tabs =
    [
        new("tab-1", "My Portfolio", true),
        new("tab-2", "Dashboard", false),
        new("tab-3", "Docs", false),
    ];

    private const string _urlHost = "myportfolio.studio";
    private const string _urlPath = "/projects";
}
