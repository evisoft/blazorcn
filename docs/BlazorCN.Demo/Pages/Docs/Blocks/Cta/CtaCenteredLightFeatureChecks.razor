@* ============================================================
   Block: cta-centered-light-feature-checks
   Title: CtaCenteredLightFeatureChecks
   Description: A centered light CTA for React and Next.js with a bordered card, inline feature check row, single primary ShadcnioButton, and trust text, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-light-feature-checks.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl border bg-card px-6 py-12 text-center sm:px-12 sm:py-14">
        <h2 class="mx-auto max-w-lg text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
            Your data. Always yours. Always portable.
        </h2>

        <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
            Export everything in one click. JSON, CSV, or PDF — your choice. No lock-in, no friction,
            no questions asked.
        </p>

        <div class="mx-auto mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
            @foreach (var feature in _features)
            {
                <span class="flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                    <LucideIconCn Name="check" Size="12" Class="size-3 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                    @feature
                </span>
            }
        </div>

        <div class="mt-8 flex justify-center">
            <ButtonCn Class="w-full sm:w-[215px]">Start free export</ButtonCn>
        </div>

        <p class="mt-4 text-xs text-muted-foreground">
            No credit card required &middot; Export up to 10 GB free
        </p>
    </div>
</section>

@code {
    private static readonly string[] _features = ["GDPR compliant", "SOC 2 certified", "End-to-end encrypted"];
}
