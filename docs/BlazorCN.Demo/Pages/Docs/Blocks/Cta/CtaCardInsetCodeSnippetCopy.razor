@* ============================================================
   Block: cta-card-inset-code-snippet-copy
   Title: CtaCardInsetCodeSnippetCopy
   Description: A card-inset dark CTA section for React and Next.js with a light outer wrapper, dark inner card, prominent copy-to-clipboard code block with toggle feedback, and inverted primary ShadcnioButton built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-card-inset-code-snippet-copy.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl border bg-card p-4 sm:p-5">
        <div class="rounded-xl bg-foreground px-6 py-10 sm:px-10 sm:py-14">
            <div class="text-center">
                <h2 class="mx-auto max-w-lg text-3xl font-semibold tracking-tight text-background sm:text-4xl">
                    Query any database in 3 lines
                </h2>
                <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-background/60">
                    One SDK, any datasource. Drop it into your app and start shipping &mdash; no ORM, no schema
                    sync, no migrations.
                </p>
            </div>

            @* Code snippet with copy button *@
            <div class="relative mx-auto mt-8 max-w-xl overflow-hidden rounded-lg border border-background/10 bg-background/[0.05]">
                @* Snippet header *@
                <div class="flex items-center justify-between border-b border-background/10 px-4 py-2.5">
                    <span class="font-mono text-[10px] text-background/40 uppercase tracking-wider">
                        example.ts
                    </span>
                    <button
                        aria-label="Copy code snippet"
                        class="inline-flex items-center gap-1.5 rounded-md px-2 py-1 font-mono text-[11px] text-background/60 transition-colors hover:bg-background/10 hover:text-background"
                        @onclick="HandleCopy"
                        type="button"
                    >
                        @if (_copied)
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3 stroke-[2.5] text-emerald-400" />
                            <span class="text-emerald-400">Copied</span>
                        }
                        else
                        {
                            <LucideIconCn Name="copy" Size="12" Class="size-3" />
                            <span>Copy</span>
                        }
                    </button>
                </div>

                @* Snippet body *@
                <pre class="overflow-x-auto px-4 py-4 font-mono text-xs leading-relaxed text-background/85"><code>@foreach (var (line, i) in _snippet.Select((l, idx) => (l, idx)))
{
    <div class="flex" key="@($"line-{i}-{line.Length}")">
        <span class="mr-4 w-4 shrink-0 select-none text-right text-background/25">@(i + 1)</span>
        <span>@(string.IsNullOrEmpty(line) ? " " : line)</span>
    </div>
}</code></pre>
            </div>

            @* Primary action *@
            <div class="mt-8 flex justify-center">
                <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[200px]">
                    Start building
                </ButtonCn>
            </div>

            <p class="mt-4 text-center text-xs text-background/35">
                Free for development &middot; Pay per query in production
            </p>
        </div>
    </div>
</section>

@code {
    private bool _copied = false;

    private static readonly string[] _snippet =
    [
        "import { stream } from '@stream/sdk'",
        "",
        "const users = await stream.query(",
        "  `SELECT name, email FROM users WHERE active = true`",
        ")",
    ];

    private async Task HandleCopy()
    {
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }
}
