@* ============================================================
   Block: cta-centered-dark-event-details-row
   Title: CtaCenteredDarkEventDetailsRow
   Description: A centered dark CTA section for React and Next.js with announcement pill, event metadata row, overlapping speaker avatar stack, inverted primary ShadcnioButton, and live attendee counter built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-dark-event-details-row.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground px-6 py-12 text-center sm:px-12 sm:py-16">
        @* Announcement pill *@
        <span class="inline-flex items-center gap-2 rounded-full border border-background/15 bg-background/5 px-3 py-1 text-xs font-medium text-background">
            <span class="size-1.5 rounded-full bg-emerald-500"></span>
            Live Webinar
        </span>

        @* Headline *@
        <h2 class="mx-auto mt-5 max-w-xl text-3xl font-semibold tracking-tight text-background sm:text-4xl">
            @_event.Headline
        </h2>

        @* Event metadata row *@
        <div class="mt-4 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-sm text-background/60">
            <LucideIconCn Name="calendar" Size="14" Class="size-3.5" />
            <span>@_event.Date</span>
            <span aria-hidden="true">&middot;</span>
            <span>@_event.Time</span>
            <span aria-hidden="true">&middot;</span>
            <span>@_event.Duration</span>
        </div>

        @* Speaker avatar stack *@
        <div class="mt-6 flex items-center justify-center gap-3">
            <div class="flex -space-x-2">
                @foreach (var speaker in _speakers)
                {
                    <div class="flex size-8 items-center justify-center rounded-full border-2 border-foreground bg-background/15 text-[10px] font-medium text-background">
                        @speaker.Initials
                    </div>
                }
            </div>
            <span class="text-xs text-background/60">@string.Join(", ", Array.ConvertAll(_speakers, s => s.Name))</span>
        </div>

        @* Primary CTA *@
        <div class="mt-8 flex items-center justify-center">
            <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[180px]">
                Register now
            </ButtonCn>
        </div>

        @* Trust text *@
        <p class="mt-4 flex items-center justify-center gap-1.5 text-xs text-background/30">
            <LucideIconCn Name="users" Size="12" Class="size-3" />
            <span class="tabular-nums">@_event.Registered</span>
            <span>registered &middot; Limited seats</span>
        </p>
    </div>
</section>

@code {
    private record EventDetails(string Headline, string Date, string Time, string Duration, int Registered);
    private record Speaker(string Name, string Initials);

    private static readonly EventDetails _event = new(
        Headline: "Building Production-Ready Design Systems at Scale",
        Date: "April 24, 2026",
        Time: "2:00 PM EST",
        Duration: "45 min",
        Registered: 128
    );

    private static readonly Speaker[] _speakers =
    [
        new("Sarah Chen", "SC"),
        new("Marcus Rivera", "MR"),
        new("Ava Lindqvist", "AL"),
    ];
}
