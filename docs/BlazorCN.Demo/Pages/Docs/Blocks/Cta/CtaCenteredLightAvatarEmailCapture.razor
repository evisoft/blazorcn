@* ============================================================
   Block: cta-centered-light-avatar-email-capture
   Title: CtaCenteredLightAvatarEmailCapture
   Description: A centered light email capture CTA for React and Next.js with avatar stack above the headline, inline Input plus ShadcnioButton, AnimatePresence success state, and join-count trust row, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-light-avatar-email-capture.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl border bg-card px-6 py-12 text-center sm:px-10 sm:py-14">

        <div class="flex items-center justify-center">
            <div aria-hidden="true" class="flex -space-x-2">
                @foreach (var avatar in _avatars)
                {
                    <div class="@Cn.Merge("size-8 rounded-full border-2 border-card", avatar.Color)"></div>
                }
            </div>
        </div>

        <h2 class="mx-auto mt-5 max-w-xl text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
            Stay in the loop
        </h2>

        <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-muted-foreground">
            Get weekly updates on new components, design patterns, and engineering deep-dives. No
            spam, unsubscribe anytime.
        </p>

        <div class="mx-auto mt-8 max-w-md">
            @if (_subscribed)
            {
                <div class="flex items-center justify-center gap-2 py-2.5">
                    <span class="flex size-5 items-center justify-center rounded-full bg-emerald-500/10">
                        <LucideIconCn Name="check" Size="12" Class="size-3 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                    </span>
                    <span class="text-sm font-medium text-foreground">
                        You&apos;re subscribed. Check your inbox.
                    </span>
                </div>
            }
            else
            {
                <form class="flex flex-col items-stretch gap-2 sm:flex-row sm:items-center"
                      @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
                    <InputCn @bind-Value="_email"
                             Type="email"
                             Placeholder="@("you@company.com")"
                             aria-label="Email address"
                             Class="h-12 flex-1"
                             Required="true" />
                    <ButtonCn Class="h-12 shrink-0" type="submit">
                        Subscribe
                    </ButtonCn>
                </form>
            }
        </div>

        <p class="mt-4 text-xs text-muted-foreground">
            Join <span class="font-semibold text-foreground">12,000+</span> developers &middot;
            Free forever
        </p>

    </div>
</section>

@code {
    private record AvatarItem(string Id, string Color);

    private static readonly AvatarItem[] _avatars =
    [
        new("a1", "bg-rose-200 dark:bg-rose-900"),
        new("a2", "bg-amber-200 dark:bg-amber-900"),
        new("a3", "bg-emerald-200 dark:bg-emerald-900"),
        new("a4", "bg-sky-200 dark:bg-sky-900"),
        new("a5", "bg-violet-200 dark:bg-violet-900"),
    ];

    private string _email = "";
    private bool _subscribed = false;

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_email)) return;
        _subscribed = true;
    }
}
