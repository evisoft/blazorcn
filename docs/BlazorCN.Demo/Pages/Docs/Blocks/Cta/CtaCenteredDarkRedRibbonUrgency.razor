<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground">

        @* Red ribbon strip *@
        <div class="flex items-center justify-center gap-2 bg-red-500 py-2">
            <span class="size-1.5 rounded-full bg-background"></span>
            <span class="text-[11px] font-extrabold uppercase tracking-[0.15em] text-background">
                Limited time &middot; Ends April 30
            </span>
            <span class="size-1.5 rounded-full bg-background"></span>
        </div>

        @* Dark band body *@
        <div class="px-6 py-12 text-center sm:px-12 sm:py-16">
            <h2 class="mx-auto max-w-xl text-3xl font-semibold tracking-tight text-background sm:text-4xl">
                40% off everything
            </h2>
            <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-background/60">
                Our biggest sale of the season. Get full access to every component, template, and future
                update at a fraction of the price.
            </p>
            <ButtonCn Class="mt-8 w-full bg-background text-foreground hover:bg-background/90 sm:w-[210px]">
                Claim your discount
            </ButtonCn>
            <p class="mt-4 text-xs text-background/30">
                Offer ends April 30, 2026 &middot; All plans included &middot; No code needed
            </p>
        </div>

    </div>
</section>
