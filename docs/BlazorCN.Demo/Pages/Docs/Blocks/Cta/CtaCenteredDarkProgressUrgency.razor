@* ============================================================
   Block: cta-centered-dark-progress-urgency
   Title: CtaCenteredDarkProgressUrgency
   Description: A centered dark urgency CTA for React and Next.js with announcement pill, price comparison, animated progress bar, and ShadcnioButton, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-dark-progress-urgency.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl bg-foreground px-6 py-12 text-center sm:px-12 sm:py-16">
        <div class="mx-auto max-w-lg">
            <span class="inline-flex items-center gap-2 rounded-full border border-background/15 bg-background/5 px-3 py-1 text-xs font-medium text-background">
                <LucideIconCn Name="zap" Size="12" Class="size-3" />
                Early bird pricing
            </span>

            <h2 class="mt-5 text-3xl font-semibold tracking-tight text-background sm:text-4xl">
                Lock in the lowest price
                <br />
                we will ever offer.
            </h2>

            <div class="mt-6 flex items-baseline justify-center gap-2">
                <span class="text-4xl font-semibold tabular-nums text-background">
                    $@CurrentPrice
                </span>
                <span class="text-sm text-background/50">/mo</span>
                <span class="text-sm tabular-nums text-background/30 line-through">
                    $@OriginalPrice
                </span>
            </div>
            <p class="mt-1 text-xs text-emerald-400">
                Save $@Savings/mo &middot; @SavingsPercent% off
            </p>

            <div class="mx-auto mt-8 max-w-xs">
                <div class="mb-2 flex items-center justify-between text-xs text-background/40">
                    <span>
                        <span class="font-medium tabular-nums text-background/70">@SpotsRemaining</span>
                        of @SpotsTotal spots left
                    </span>
                    <span class="tabular-nums">@Percentage%</span>
                </div>
                <div class="h-1.5 w-full overflow-hidden rounded-full bg-background/10">
                    <div class="h-full rounded-full bg-background" style="@($"width:{Percentage}%")"></div>
                </div>
            </div>

            <ButtonCn Class="mt-8 w-full bg-background text-foreground hover:bg-background/90 sm:w-[210px]">
                Claim your spot
            </ButtonCn>

            <p class="mt-4 text-xs text-background/30">Price increases when spots fill up</p>
        </div>
    </div>
</section>

@code {
    private const int OriginalPrice = 39;
    private const int CurrentPrice = 19;
    private const int SpotsUsed = 153;
    private const int SpotsTotal = 200;
    private const int SpotsRemaining = SpotsTotal - SpotsUsed;
    private const int Savings = OriginalPrice - CurrentPrice;

    // Math.Round is not a compile-time const — use static readonly
    private static readonly int Percentage = (int)Math.Round((double)SpotsUsed / SpotsTotal * 100);
    private static readonly int SavingsPercent = 100 - (int)Math.Round((double)CurrentPrice / OriginalPrice * 100);
}
