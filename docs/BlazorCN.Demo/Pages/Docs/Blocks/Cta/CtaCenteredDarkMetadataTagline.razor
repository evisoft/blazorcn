@* ============================================================
   Block: cta-centered-dark-metadata-tagline
   Title: CtaCenteredDarkMetadataTagline
   Description: A centered dark CTA for React and Next.js with an uppercase metadata tagline, headline plus subtitle stack, inline price compare, inverted ShadcnioButton, and small-print trust line built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-dark-metadata-tagline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground px-6 py-12 text-center sm:px-12 sm:py-16">
        <p class="text-xs font-semibold uppercase tracking-widest text-background/50">
            Jun 12 &ndash; 14, 2026 &middot; San Francisco
        </p>

        <h2 class="mt-4 text-2xl font-semibold tracking-tight text-background sm:text-3xl">
            DevConf 2026
        </h2>

        <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-background/60">
            Three days of talks, workshops, and networking with 200+ speakers from the world&apos;s
            leading engineering teams.
        </p>

        <div class="mt-5 flex items-center justify-center gap-3 text-sm">
            <del class="text-background/30">@_originalPrice</del>
            <span class="font-semibold text-background">@_offerPrice early bird</span>
        </div>

        <div class="mt-7 flex justify-center">
            <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[195px]">
                Get tickets
            </ButtonCn>
        </div>

        <p class="mt-4 text-xs text-background/30">
            Limited to 500 attendees &middot; Early bird ends May 1
        </p>
    </div>
</section>

@code {
    private const string _originalPrice = "$499";
    private const string _offerPrice = "$299";
}
