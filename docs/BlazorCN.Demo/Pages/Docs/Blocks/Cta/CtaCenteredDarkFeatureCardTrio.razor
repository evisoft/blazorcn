@* ============================================================
   Block: cta-centered-dark-feature-card-trio
   Title: CtaCenteredDarkFeatureCardTrio
   Description: A centered dark CTA for React and Next.js with a rounded icon badge above the headline, a three-column feature card trio, inverted ShadcnioButton, and trust text below, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-dark-feature-card-trio.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground px-6 py-12 text-center sm:px-12 sm:py-16">

        <div class="mx-auto flex size-10 items-center justify-center rounded-full bg-background/10">
            <LucideIconCn Name="bell" Size="20" Class="size-5 text-background/70" />
        </div>

        <h2 class="mt-5 text-3xl font-semibold tracking-tight text-background sm:text-4xl">
            Never miss what matters
        </h2>

        <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-background/60">
            Real-time alerts for every critical event across your stack. Delivered to Slack, email, or
            in-app &mdash; your choice.
        </p>

        <div class="mx-auto mt-8 grid max-w-lg grid-cols-1 gap-3 sm:grid-cols-3">
            @foreach (var card in _cards)
            {
                <div class="rounded-lg border border-background/10 bg-background/[0.05] px-4 py-4 text-left">
                    <LucideIconCn Name="@card.Icon" Size="16" Class="size-4 text-background/50" />
                    <p class="mt-2.5 text-sm font-medium text-background">@card.Title</p>
                    <p class="mt-1 text-xs leading-relaxed text-background/50">@card.Description</p>
                </div>
            }
        </div>

        <div class="mt-8">
            <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[215px]">
                Enable notifications
            </ButtonCn>
        </div>

        <p class="mt-4 text-xs text-background/30">
            Customize channels anytime &middot; Unsubscribe in one click
        </p>
    </div>
</section>

@code {
    private record FeatureCard(string Icon, string Title, string Description);

    private static readonly FeatureCard[] _cards =
    [
        new("zap",         "Deployments", "Build success, failures, and rollback alerts"),
        new("shield",      "Security",    "Login attempts, API key usage, and threat alerts"),
        new("credit-card", "Billing",     "Payment confirmations, usage limits, and renewals"),
    ];
}
