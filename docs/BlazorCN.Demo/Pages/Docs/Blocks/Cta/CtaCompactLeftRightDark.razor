@* ============================================================
   Block: cta-compact-left-right-dark
   Title: CtaCompactLeftRightDark
   Description: A compact left-right dark CTA for React and Next.js with headline column on the left, dual ShadcnioButton row on the right, and no subtitle wrap, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-compact-left-right-dark.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="flex flex-col items-start gap-6 rounded-2xl bg-foreground px-8 py-8 md:flex-row md:items-center md:justify-between md:px-10 md:py-10">

        @* Left side — headline + subtitle *@
        <div class="max-w-md">
            <h2 class="text-2xl font-semibold tracking-tight text-background sm:text-3xl">
                Lock in 2026 pricing today
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-background/60">
                Switch to annual billing before December 31 and save 20% on every seat. Your current
                plan renews in 14 days.
            </p>
        </div>

        @* Right side — buttons *@
        <div class="flex w-full flex-col items-stretch gap-3 sm:w-auto sm:flex-row sm:items-center md:shrink-0">
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[180px]">
                Compare plans
            </ButtonCn>
            <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[205px]">
                Upgrade to annual
            </ButtonCn>
        </div>

    </div>
</section>
