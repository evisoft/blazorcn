@* ============================================================
   Block: cta-split-panel-email-capture-document-visual
   Title: CtaSplitPanelEmailCaptureDocumentVisual
   Description: A split panel dark CTA for React and Next.js with inline email capture form on the left panel, stylized document placeholder visual on the right panel, AnimatePresence success swap, and compact trust line built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-split-panel-email-capture-document-visual.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground">
        <div class="grid grid-cols-1 sm:grid-cols-2">

            @* Left: eyebrow + headline + description + email form *@
            <div class="flex flex-col justify-center px-6 py-10 sm:px-10 sm:py-14">
                <p class="text-xs font-medium uppercase tracking-widest text-background/50">
                    Free Resource
                </p>
                <h2 class="mt-3 text-xl font-semibold leading-tight tracking-tight text-background sm:text-2xl">
                    @_document.Title
                </h2>
                <p class="mt-2 text-sm leading-relaxed text-background/60">
                    @_document.Description
                </p>

                <div class="mt-6">
                    @if (_submitted)
                    {
                        <div aria-live="polite" class="flex items-center gap-2">
                            <LucideIconCn Name="check" Size="16" Class="size-4 stroke-[3] text-emerald-500" />
                            <span class="text-sm text-background">
                                Check your inbox for the download link.
                            </span>
                        </div>
                    }
                    else
                    {
                        <form class="flex items-center gap-2" @onsubmit="HandleSubmit">
                            <InputCn @bind-Value="_email"
                                     placeholder="@("you@company.com")"
                                     aria-label="Email address"
                                     type="email"
                                     required="required"
                                     Class="h-12 flex-1 border-background/10 bg-background/5 text-background placeholder:text-background/30 focus-visible:ring-background/20" />
                            <ButtonCn type="submit" Class="h-12 shrink-0 bg-background text-foreground hover:bg-background/90">
                                Download
                            </ButtonCn>
                        </form>
                    }
                </div>

                <p class="mt-4 text-xs text-background/30">
                    12,000+ downloads &middot; No spam, ever
                </p>
            </div>

            @* Right: document placeholder visual *@
            <div aria-hidden="true"
                 class="relative hidden items-center justify-center bg-background/5 px-6 py-10 sm:flex sm:px-10 sm:py-14">
                <div class="flex w-full max-w-[180px] flex-col items-center">
                    <div class="flex aspect-[3/4] w-full flex-col items-center justify-center rounded-md border border-background/10 bg-background/5">
                        <LucideIconCn Name="file-text" Size="40" Class="size-10 text-background/20" />
                        <p class="mt-3 text-xs font-medium text-background/50">@_document.Format</p>
                        <p class="mt-0.5 text-[10px] text-background/30">@_document.PageCount pages</p>
                    </div>
                    <p class="mt-3 max-w-[160px] text-center text-[10px] leading-relaxed text-background/40">
                        @_document.Updated
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private record DocumentMeta(string Title, string Description, int PageCount, string Format, string Updated);

    private static readonly DocumentMeta _document = new(
        Title: "The Complete Guide to Design Systems",
        Description: "A deep dive into building, scaling, and maintaining design systems across product teams. Covers token architecture, component APIs, versioning strategies, and adoption playbooks.",
        PageCount: 42,
        Format: "PDF",
        Updated: "Updated March 2026"
    );

    private string _email = "";
    private bool _submitted = false;

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_email))
            _submitted = true;
    }
}
