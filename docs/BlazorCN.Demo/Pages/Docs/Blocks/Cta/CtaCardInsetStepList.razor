@* ============================================================
   Block: cta-card-inset-step-list
   Title: CtaCardInsetStepList
   Description: A card-inset dark CTA for React and Next.js with a numbered three-step vertical list, inverted primary ShadcnioButton, and outer trust-row strip built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-card-inset-step-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl border bg-card p-3 sm:p-4">
        <div class="overflow-hidden rounded-xl bg-foreground px-6 py-12 text-center sm:px-12 sm:py-16">
            <h2 class="mx-auto max-w-md text-3xl font-semibold tracking-tight text-background sm:text-4xl">
                Switch to us in minutes, not days
            </h2>

            <p class="mx-auto mt-4 max-w-sm text-base leading-relaxed text-background/60">
                Our migration tool handles everything. Zero data loss, zero downtime.
            </p>

            <ul class="mx-auto mt-8 max-w-xs space-y-3">
                @foreach (var step in _steps)
                {
                    <li class="flex items-center gap-3 text-left">
                        <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-background/10 text-xs font-medium text-background">
                            @step.Number
                        </span>
                        <span class="text-sm text-background/80">@step.Label</span>
                    </li>
                }
            </ul>

            <div class="mt-8 flex flex-col items-center gap-4">
                <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[200px]">
                    Start migration
                </ButtonCn>
                <span class="flex items-center gap-1.5 text-xs text-background/40">
                    <LucideIconCn Name="clock" Size="12" Class="size-3" />
                    @_estimatedTime
                </span>
            </div>
        </div>

        <div class="mt-3 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 px-4 py-1">
            @foreach (var item in _trustItems)
            {
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                    @item
                </span>
            }
        </div>
    </div>
</section>

@code {
    private record Step(string Id, int Number, string Label);

    private static readonly Step[] _steps =
    [
        new("connect", 1, "Connect your existing account"),
        new("migrate", 2, "We migrate your data automatically"),
        new("verify", 3, "Review, verify, and go live"),
    ];

    private const string _estimatedTime = "Takes about 15 minutes";

    private static readonly string[] _trustItems =
    [
        "2,400+ teams migrated",
        "Zero data loss",
    ];
}
