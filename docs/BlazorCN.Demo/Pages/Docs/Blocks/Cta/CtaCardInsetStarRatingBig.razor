@* ============================================================
   Block: cta-card-inset-star-rating-big
   Title: CtaCardInsetStarRatingBig
   Description: A card-inset light CTA for React and Next.js with an oversized 5-star amber rating cluster, a large tabular rating score, a row of plain-text platform badges, headline, and primary ShadcnioButton built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-card-inset-star-rating-big.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl border bg-card p-8 text-center sm:p-12">

        @* Big star rating cluster *@
        <div class="flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-6">
            <div class="flex items-center gap-1" aria-hidden="true">
                @foreach (var i in Enumerable.Range(0, 5))
                {
                    <LucideIconCn Name="star" Size="32" Class="size-8 fill-amber-500 text-amber-500 sm:size-10" />
                }
            </div>

            <div class="flex items-baseline gap-2">
                <span class="text-4xl font-semibold tabular-nums text-foreground sm:text-5xl">
                    @_rating
                </span>
                <span class="text-sm text-muted-foreground">out of 5</span>
            </div>
        </div>

        @* Platform badges row *@
        <div class="mt-6 flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
            @foreach (var entry in _platforms)
            {
                var platform = entry;
                <div class="flex items-center gap-3">
                    <div class="flex items-baseline gap-1.5">
                        <span class="text-xs font-semibold uppercase tracking-wider text-foreground">
                            @platform.Name
                        </span>
                        <span class="text-[11px] text-muted-foreground">@platform.Count</span>
                    </div>
                    @if (platform != _platforms[_platforms.Length - 1])
                    {
                        <span aria-hidden="true" class="hidden size-1 rounded-full bg-muted-foreground/40 sm:block"></span>
                    }
                </div>
            }
        </div>

        @* Headline *@
        <h2 class="mx-auto mt-8 max-w-xl text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
            Loved by 12,000+ teams
        </h2>

        @* Subtitle *@
        <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
            Join the teams shipping faster with the most-loved tool in its category. Rated #1 on every
            platform that matters.
        </p>

        @* Primary button *@
        <div class="mt-8 flex justify-center">
            <ButtonCn Class="w-full sm:w-[195px]">Start for free</ButtonCn>
        </div>

        <p class="mt-4 text-xs text-muted-foreground">
            14-day free trial &middot; No credit card required
        </p>
    </div>
</section>

@code {
    private const string _rating = "4.9";

    private record Platform(string Name, string Count);

    private static readonly Platform[] _platforms =
    [
        new("G2", "1,240 reviews"),
        new("Capterra", "890 reviews"),
        new("Product Hunt", "#1 Product of the Day"),
        new("Trustpilot", "2,310 reviews"),
    ];
}
