@* ============================================================
   Block: cta-split-panel-waveform-visual
   Title: CtaSplitPanelWaveformVisual
   Description: A split panel dark CTA for React and Next.js with a staggered audio waveform visual on the left, featured episode card and paired ShadcnioButton actions on the right, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-split-panel-waveform-visual.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground">
        <div class="grid grid-cols-1 md:grid-cols-2">

            @* Left — waveform visual *@
            <div aria-hidden="true" class="hidden items-end justify-center gap-[3px] bg-background/[0.04] px-8 py-12 md:flex">
                @foreach (var bar in _barHeights)
                {
                    <div class="w-1.5 rounded-full bg-background/20" style="@($"height:{bar * 4}px")"></div>
                }
            </div>

            @* Right — copy + featured item + CTA row *@
            <div class="flex flex-col justify-center px-8 py-12 sm:px-10">

                @* Eyebrow *@
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="headphones" Size="16" Class="size-4 text-background/40" />
                    <span class="text-xs font-medium uppercase tracking-widest text-background/40">
                        Podcast
                    </span>
                </div>

                @* Headline *@
                <h2 class="mt-4 text-2xl font-semibold tracking-tight text-background sm:text-3xl">
                    The Dev Podcast
                </h2>

                @* Subtitle *@
                <p class="mt-2 max-w-sm text-sm leading-relaxed text-background/60">
                    Weekly conversations with the engineers building the tools and frameworks you use
                    every day.
                </p>

                @* Featured item card *@
                <div class="mt-6 flex items-center gap-3 rounded-lg bg-background/[0.06] px-4 py-3">
                    <button class="flex size-9 shrink-0 items-center justify-center rounded-full bg-background text-foreground transition-opacity hover:opacity-80" type="button">
                        <LucideIconCn Name="play" Size="14" Class="ml-0.5 size-3.5" />
                        <span class="sr-only">Play episode @_featuredItem.Number</span>
                    </button>
                    <div class="min-w-0 flex-1">
                        <p class="truncate text-sm font-medium text-background/80">
                            Ep. @_featuredItem.Number: @_featuredItem.Title
                        </p>
                        <p class="mt-0.5 text-xs text-background/40">
                            @_featuredItem.Date &middot; @_featuredItem.Duration
                        </p>
                    </div>
                </div>

                @* CTA row *@
                <div class="mt-6 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
                    <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[160px]">
                        Subscribe
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[175px]">
                        Listen now
                    </ButtonCn>
                </div>

                <p class="mt-4 text-xs text-background/30">
                    New episodes every Tuesday &middot; 15,000+ listeners
                </p>

            </div>
        </div>
    </div>
</section>

@code {
    private static readonly int[] _barHeights =
    [
        3, 6, 4, 8, 5, 10, 7, 12, 6, 14, 8, 16, 10, 12, 8, 14, 6, 10, 12, 8, 6, 14, 10, 16, 12, 8, 5, 10,
        6, 4,
    ];

    private record FeaturedItem(int Number, string Title, string Duration, string Date);

    private static readonly FeaturedItem _featuredItem = new(
        47,
        "Infrastructure Lessons from Hypergrowth",
        "42 min",
        "Mar 25, 2026"
    );
}
