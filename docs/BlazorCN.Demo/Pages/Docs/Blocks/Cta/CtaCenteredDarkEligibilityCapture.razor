@* ============================================================
   Block: cta-centered-dark-eligibility-capture
   Title: CtaCenteredDarkEligibilityCapture
   Description: A centered dark eligibility capture CTA section for React and Next.js with verification pill, inline email input, ShadcnioButton submit, and trust row built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-dark-eligibility-capture.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl bg-foreground px-6 py-12 text-center sm:px-12 sm:py-16">

        @* Verification pill *@
        <span class="inline-flex items-center gap-2 rounded-full border border-background/15 bg-background/5 px-3 py-1 text-xs font-medium text-background">
            <LucideIconCn Name="graduation-cap" Size="14" Class="size-3.5" />
            Student program
        </span>

        @* Headline *@
        <h2 class="mx-auto mt-5 max-w-xl text-3xl font-semibold tracking-tight text-background sm:text-4xl">
            Get 50% off with a verified .edu email
        </h2>

        @* Subtitle *@
        <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-background/60">
            Verify your student status and unlock half-price access to every feature for the duration
            of your enrollment.
        </p>

        @* Form / success state *@
        @if (_submitted)
        {
            <p class="mx-auto mt-8 max-w-md text-sm text-background">
                Thanks! Check your inbox for your verification link.
            </p>
        }
        else
        {
            <form class="mx-auto mt-8 flex max-w-md flex-col items-stretch gap-2 sm:flex-row sm:items-center"
                  @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
                <InputCn @bind-Value="_email"
                         Type="email"
                         Placeholder="@("you@university.edu")"
                         Required="true"
                         Class="h-12 flex-1 border-background/10 bg-background/5 text-background placeholder:text-background/30 focus-visible:ring-background/20" />
                <ButtonCn Type="submit"
                          Class="h-12 w-full shrink-0 bg-background text-foreground hover:bg-background/90 sm:w-auto">
                    Verify
                </ButtonCn>
            </form>
        }

        @* Trust row *@
        <div class="mt-6 inline-flex items-center gap-1.5 text-xs text-background/30">
            <LucideIconCn Name="shield-check" Size="14" Class="size-3.5" />
            Verified by SheerID &middot; 45,000+ students enrolled
        </div>

    </div>
</section>

@code {
    private string _email = "";
    private bool _submitted = false;

    private void HandleSubmit()
    {
        if (string.IsNullOrEmpty(_email)) return;
        _submitted = true;
    }
}
