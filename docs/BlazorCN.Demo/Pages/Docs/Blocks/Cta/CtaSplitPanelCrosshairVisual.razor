<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground">
        <div class="grid md:grid-cols-2">

            @* Left — copy *@
            <div class="flex flex-col justify-center px-6 py-10 sm:px-10 sm:py-12">
                <p class="text-xs font-medium uppercase tracking-widest text-background/40">
                    Design system
                </p>
                <h2 class="mt-3 text-3xl font-semibold tracking-tight text-background sm:text-4xl">
                    Ship consistent UI, faster
                </h2>
                <p class="mt-3 max-w-sm text-sm leading-relaxed text-background/60">
                    120+ production-ready components and 60+ composable patterns. One design language
                    across every product surface.
                </p>

                <div class="mt-8 flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:items-center">
                    <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[195px]">
                        Browse system
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[200px]">
                        View on GitHub
                    </ButtonCn>
                </div>

                <p class="mt-4 text-xs text-background/30">
                    MIT licensed &middot; Open source &middot; Copy-paste ready
                </p>
            </div>

            @* Right — SVG crosshair visual *@
            <div aria-hidden="true" class="hidden items-center justify-center border-l border-background/10 md:flex">
                <svg class="size-40 text-background/10" fill="none" role="presentation" viewBox="0 0 128 128">
                    <line stroke="currentColor" stroke-width="0.5" x1="64" x2="64" y1="0" y2="128" />
                    <line stroke="currentColor" stroke-width="0.5" x1="0" x2="128" y1="64" y2="64" />
                    <circle cx="64" cy="64" r="16" stroke="currentColor" stroke-width="0.5" />
                    <circle cx="64" cy="64" r="32" stroke="currentColor" stroke-width="0.5" />
                    <circle cx="64" cy="64" r="48" stroke="currentColor" stroke-width="0.5" />
                </svg>
            </div>

        </div>
    </div>
</section>
