@* ============================================================
   Block: cta-compact-dismissible-action-banner
   Title: CtaCompactDismissibleActionBanner
   Description: A compact dismissible action banner CTA for React and Next.js with inline icon, message, meta badge, ShadcnioButton action, and close affordance built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-compact-dismissible-action-banner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    @if (_visible)
    {
        <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border bg-card px-5 py-3">

            <div class="flex min-w-0 items-center gap-3">
                <LucideIconCn Name="message-circle-question" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                <p class="text-sm font-medium text-foreground">
                    Help us improve &mdash; share your feedback in a quick survey.
                </p>
                <BadgeCn Class="shrink-0 text-xs font-normal" Variant="BadgeVariant.Secondary">
                    2 min
                </BadgeCn>
            </div>

            <div class="flex items-center gap-2">
                <ButtonCn Class="w-full sm:w-[140px]" Size="ButtonSize.Sm">Take survey</ButtonCn>
                <button
                    aria-label="Dismiss banner"
                    class="inline-flex size-8 shrink-0 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted/50 hover:text-foreground"
                    @onclick="@(() => _visible = false)"
                    type="button">
                    <LucideIconCn Name="x" Size="16" Class="size-4" />
                </button>
            </div>

        </div>
    }
</section>

@code {
    private bool _visible = true;
}
