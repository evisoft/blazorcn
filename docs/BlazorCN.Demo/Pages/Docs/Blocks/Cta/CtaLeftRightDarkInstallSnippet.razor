@* ============================================================
   Block: cta-left-right-dark-install-snippet
   Title: CtaLeftRightDarkInstallSnippet
   Description: A compact left-right dark CTA section for React and Next.js with left-side headline and inline monospace install snippet, right-side inverted primary ShadcnioButton paired with a ghost docs action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-left-right-dark-install-snippet.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground px-6 py-10 sm:px-10 sm:py-12">
        <div class="flex flex-col items-start gap-8 sm:flex-row sm:items-center sm:justify-between">

            @* Left — Headline + install snippet *@
            <div class="min-w-0 flex-1">
                <h2 class="font-semibold text-background text-xl tracking-tight sm:text-2xl">
                    Start building in minutes
                </h2>
                <p class="mt-2 max-w-md text-background/60 text-sm leading-relaxed">
                    Everything you need to ship production-ready interfaces. One command, zero config.
                </p>

                @* Install snippet *@
                <div class="mt-4 inline-flex items-center gap-2 rounded-lg border border-background/10 bg-background/[0.06] px-3.5 py-2">
                    <span class="select-none font-mono text-background/35 text-xs">$</span>
                    <code class="font-mono text-background/90 text-xs">@_installCommand</code>
                </div>
            </div>

            @* Right — Buttons *@
            <div class="flex w-full shrink-0 flex-col items-stretch gap-3 sm:w-auto sm:flex-row sm:items-center">
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[160px]">
                    Read docs
                </ButtonCn>
                <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[180px]">
                    Get started
                </ButtonCn>
            </div>

        </div>
    </div>
</section>

@code {
    private const string _installCommand = "npx shadcn@latest add button";
}
