@* ============================================================
   Block: cta-centered-light-seat-capacity-capture
   Title: CtaCenteredLightSeatCapacityCapture
   Description: A centered light seat capacity capture CTA for React and Next.js with email input, ShadcnioButton send action, avatar stack of existing members, and remaining seat counter built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-light-seat-capacity-capture.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl border bg-card px-6 py-12 text-center sm:px-12 sm:py-14">

        <h2 class="mx-auto max-w-lg text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
            Invite your team
        </h2>
        <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
            Collaboration starts here. Add teammates by email and start building together in a shared
            workspace.
        </p>

        <form class="mx-auto mt-8 flex max-w-md flex-col items-stretch gap-2 sm:flex-row sm:items-center"
              @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <InputCn @bind-Value="_email"
                     Type="email"
                     Placeholder="@("colleague@company.com")"
                     aria-label="Colleague's email address"
                     Class="h-12 flex-1"
                     Required="true" />
            <ButtonCn Class="h-12 w-full shrink-0 sm:w-[160px]" type="submit">
                Send invite
            </ButtonCn>
        </form>

        <div class="mt-8 flex flex-col items-center gap-3">
            <div class="flex -space-x-2">
                @foreach (var member in _members)
                {
                    <AvatarCn Class="size-8 border-2 border-card">
                        <AvatarFallbackCn Class="text-[10px] font-medium">@member.Initials</AvatarFallbackCn>
                    </AvatarCn>
                }
            </div>
            <p class="text-xs text-muted-foreground">
                <span class="font-semibold text-foreground">@_members.Length</span> members joined
                &middot; @_remainingSeats seats remaining
            </p>
        </div>

    </div>
</section>

@code {
    private record Member(string Name, string Initials);

    private static readonly Member[] _members =
    [
        new("Sarah Chen", "SC"),
        new("Alex Rivera", "AR"),
        new("Mika Patel", "MP"),
        new("Jordan Lee", "JL"),
    ];

    private const int MaxSeats = 10;
    private int _remainingSeats = MaxSeats - 4; // 4 = _members.Length (computed at init)

    private string _email = "";

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_email)) return;
        // In production: POST to /api/team/invite and reset the input on success
    }
}
