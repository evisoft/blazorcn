@* ============================================================
   Block: cta-split-panel-numbered-module-list
   Title: CtaSplitPanelNumberedModuleList
   Description: A split panel CTA with numbered module list for React and Next.js with dark card, eyebrow pill, four-step list on the left, skeleton visual on the right, and inverted ShadcnioButton, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-split-panel-numbered-module-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground">
        <div class="grid gap-8 px-8 py-10 md:grid-cols-2 md:items-center md:gap-12 md:px-10 md:py-12">

            @* Left — copy and numbered module list *@
            <div>
                <span class="inline-flex items-center gap-2 rounded-full border border-background/15 bg-background/5 px-3 py-1 text-xs font-medium text-background">
                    Free course
                </span>

                <h2 class="mt-4 text-3xl font-semibold tracking-tight text-background sm:text-4xl">
                    Level up in four modules
                </h2>

                <p class="mt-4 max-w-md text-base leading-relaxed text-background/60">
                    Four hands-on modules. Four hours total. Certificate of completion included.
                </p>

                <ol class="mt-7 space-y-3">
                    @foreach (var mod in _modules)
                    {
                        var idx = Array.IndexOf(_modules, mod);
                        <li class="flex items-center gap-3">
                            <span class="flex size-7 shrink-0 items-center justify-center rounded-md border border-background/15 bg-background/5 text-[11px] font-semibold tabular-nums text-background/70">
                                @((idx + 1).ToString().PadLeft(2, '0'))
                            </span>
                            <span class="text-sm text-background/85">@mod.Title</span>
                        </li>
                    }
                </ol>

                <div class="mt-8">
                    <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 md:w-[195px]">
                        Start for free
                    </ButtonCn>
                </div>

                <p class="mt-4 text-xs text-background/35">
                    2,800+ students enrolled &middot; No credit card required
                </p>
            </div>

            @* Right — skeleton visual cluster *@
            <div aria-hidden="true"
                 class="relative hidden items-center justify-center overflow-hidden rounded-xl border border-background/10 bg-background/[0.04] md:flex">
                <div class="flex w-full flex-col gap-4 p-8">
                    @foreach (var mod in _modules)
                    {
                        var idx = Array.IndexOf(_modules, mod);
                        <div class="flex items-center gap-3 rounded-lg border border-background/10 bg-background/[0.05] px-3 py-2.5">
                            <div class="flex size-6 shrink-0 items-center justify-center rounded-md bg-background/10 text-[10px] font-semibold text-background/50">
                                @((idx + 1).ToString().PadLeft(2, '0'))
                            </div>
                            <div class="flex-1">
                                <div class="h-2 w-3/4 rounded-full bg-background/12"></div>
                                <div class="mt-1.5 h-1.5 w-1/2 rounded-full bg-background/[0.07]"></div>
                            </div>
                            <div class="h-1.5 w-6 rounded-full bg-background/10"></div>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private record Module(string Title);

    private static readonly Module[] _modules =
    [
        new("Component architecture fundamentals"),
        new("State management patterns"),
        new("Server components and streaming"),
        new("Performance optimization"),
    ];
}
