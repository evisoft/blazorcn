@* ============================================================
   Block: cta-centered-dark-email-capture
   Title: CtaCenteredDarkEmailCapture
   Description: A centered dark email capture CTA section for React and Next.js with bold two-line headline, inline feature checkmark row, flexing Input with fixed submit ShadcnioButton, and trust text (demonstrated with a free trial signup) built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-dark-email-capture.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground px-6 py-12 text-center sm:px-12 sm:py-16">
        <h2 class="mx-auto max-w-lg text-3xl font-semibold leading-tight tracking-tight text-background sm:text-4xl">
            Start building for free.
            <br />
            No credit card required.
        </h2>

        <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-background/60">
            Get full access to every component, pattern, and developer tool. Your 14-day trial starts
            the moment you sign up.
        </p>

        <div class="mx-auto mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
            @foreach (var feature in _features)
            {
                <span class="flex items-center gap-1.5 text-xs text-background/60">
                    <LucideIconCn Name="check" Size="12" Class="size-3 stroke-[3] text-emerald-400" />
                    @feature
                </span>
            }
        </div>

        <form class="mx-auto mt-8 flex max-w-md flex-col items-stretch gap-2 sm:flex-row sm:items-center"
              @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <InputCn @bind-Value="_email"
                     Type="email"
                     Placeholder="@("you@company.com")"
                     Class="h-12 flex-1 border-background/10 bg-background/5 text-background placeholder:text-background/30 focus-visible:ring-background/20"
                     Required="true" />
            <ButtonCn Class="h-12 w-full shrink-0 bg-background text-foreground hover:bg-background/90 sm:w-auto"
                      type="submit">
                Start trial
            </ButtonCn>
        </form>

        <p class="mt-4 text-xs text-background/30">
            Free for 14 days &middot; Then $19/mo &middot; Cancel anytime
        </p>
    </div>
</section>

@code {
    private static readonly string[] _features =
    [
        "Unlimited components",
        "Priority support",
        "Team collaboration",
        "Cancel anytime",
    ];

    private string _email = "";

    private void HandleSubmit()
    {
        if (string.IsNullOrEmpty(_email)) return;
        // In production: POST to /api/subscribe, then set submitted=true
    }
}
