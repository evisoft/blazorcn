@* ============================================================
   Block: cta-centered-avatar-social-proof
   Title: CtaCenteredAvatarSocialProof
   Description: A centered light CTA for React and Next.js with an avatar stack social proof cluster, member count pill, headline, and ShadcnioButton, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-avatar-social-proof.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl border bg-card px-6 py-12 text-center sm:px-10 sm:py-14">
        <div class="flex justify-center">
            <div aria-label="Community members" class="flex -space-x-2" role="group">
                @foreach (var member in _members)
                {
                    <AvatarCn Class="size-9 border-2 border-background">
                        <AvatarImageCn Src="@member.Image" Alt="@member.Name" />
                        <AvatarFallbackCn Class="text-xs">@member.Initials</AvatarFallbackCn>
                    </AvatarCn>
                }
                <div class="flex size-9 items-center justify-center rounded-full border-2 border-background bg-muted text-xs font-medium text-muted-foreground">
                    +8k
                </div>
            </div>
        </div>

        <p class="mt-4 text-sm font-medium text-muted-foreground">Join 8,400+ developers</p>

        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
            Build together, ship faster
        </h2>

        <p class="mx-auto mt-3 max-w-md text-base leading-relaxed text-muted-foreground">
            Get help, share ideas, and connect with engineers who care about quality code as much as
            you do.
        </p>

        <div class="mt-8 flex justify-center">
            <ButtonCn Class="w-full sm:w-[210px]">Join community</ButtonCn>
        </div>

        <p class="mt-4 text-xs text-muted-foreground">
            Free to join &middot; No credit card required
        </p>
    </div>
</section>

@code {
    private record Member(string Name, string Image, string Initials);

    private static readonly Member[] _members =
    [
        new("Sarah Chen",     "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=80&h=80&fit=crop&crop=face", "SC"),
        new("Marcus Johnson", "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=80&h=80&fit=crop&crop=face", "MJ"),
        new("Anika Patel",    "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=80&h=80&fit=crop&crop=face", "AP"),
        new("James Liu",      "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=80&h=80&fit=crop&crop=face", "JL"),
        new("Priya Sharma",   "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=80&h=80&fit=crop&crop=face", "PS"),
    ];
}
