@* ============================================================
   Block: cta-centered-dark-badge-cloud
   Title: CtaCenteredDarkBadgeCloud
   Description: A centered dark CTA for React and Next.js with a badge-cloud header of translucent code chips, inverted primary ShadcnioButton, and ghost secondary action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-dark-badge-cloud.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground px-6 py-12 text-center sm:px-12 sm:py-16">

        @* Badge cloud *@
        <div aria-hidden="true" class="mx-auto flex max-w-xl flex-wrap items-center justify-center gap-2">
            @foreach (var badge in _badges)
            {
                <span class="inline-flex items-center rounded-md border border-background/10 bg-background/[0.06] px-2.5 py-1 font-mono text-xs font-medium text-background/50">
                    @badge
                </span>
            }
        </div>

        @* Headline + CTA *@
        <h2 class="mx-auto mt-8 max-w-xl text-3xl font-semibold tracking-tight text-background sm:text-4xl">
            Speak your users&apos; language
        </h2>
        <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-background/60">
            Built-in support for @_badges.Length languages. Every UI string, notification, and
            document adapts to your users&apos; preferred locale automatically.
        </p>

        <div class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
            <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[180px]">
                Get started
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[210px]">
                View supported locales
            </ButtonCn>
        </div>

        <p class="mt-5 text-xs text-background/35">
            RTL support included &middot; Community translations welcome
        </p>
    </div>
</section>

@code {
    private static readonly string[] _badges =
    [
        "EN", "ES", "FR", "DE", "IT", "PT", "JA", "KO", "ZH", "AR",
        "HI", "RU", "NL", "SV", "PL", "TR", "TH", "VI", "ID", "DA",
        "FI", "NO", "CS", "UK"
    ];
}
