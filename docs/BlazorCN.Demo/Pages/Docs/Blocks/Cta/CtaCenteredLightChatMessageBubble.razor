@* ============================================================
   Block: cta-centered-light-chat-message-bubble
   Title: CtaCenteredLightChatMessageBubble
   Description: A centered light CTA for React and Next.js with a mini chat message bubble preview above the headline showing user and AI reply bubbles and an animated typing indicator, plus a single primary ShadcnioButton, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-light-chat-message-bubble.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="rounded-2xl border bg-card px-6 py-12 text-center sm:px-10 sm:py-14">

        @* Chat bubble preview *@
        <div class="mx-auto flex max-w-sm flex-col gap-2">
            @foreach (var msg in _messages)
            {
                <div class="@(msg.Role == "user" ? "flex justify-end" : "flex justify-start")">
                    <div class="@(msg.Role == "user" ? "max-w-[240px] rounded-2xl rounded-br-sm bg-foreground px-3 py-2 text-left text-xs text-background" : "max-w-[240px] rounded-2xl rounded-bl-sm bg-muted px-3 py-2 text-left text-xs text-foreground")">
                        @msg.Content
                    </div>
                </div>
            }

            @* Typing indicator *@
            <div class="flex justify-start">
                <div class="rounded-2xl rounded-bl-sm bg-muted">
                    <div aria-hidden="true" class="flex items-center gap-1 px-3 py-2.5">
                        <span class="size-1.5 rounded-full bg-muted-foreground/60" style="animation: typingBounce 1.1s ease-in-out infinite; animation-delay: 0ms;"></span>
                        <span class="size-1.5 rounded-full bg-muted-foreground/60" style="animation: typingBounce 1.1s ease-in-out infinite; animation-delay: 150ms;"></span>
                        <span class="size-1.5 rounded-full bg-muted-foreground/60" style="animation: typingBounce 1.1s ease-in-out infinite; animation-delay: 300ms;"></span>
                    </div>
                </div>
            </div>
        </div>

        @* Headline *@
        <h2 class="mx-auto mt-8 max-w-md text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
            Get instant answers from your data.
        </h2>

        <p class="mx-auto mt-3 max-w-md text-sm text-muted-foreground leading-relaxed">
            Ask plain-English questions. Get SQL-accurate answers in seconds &mdash; no dashboards to build,
            no queries to write.
        </p>

        @* CTA *@
        <div class="mt-8 flex justify-center">
            <ButtonCn Class="w-full sm:w-[200px]">Try it free</ButtonCn>
        </div>

        <p class="mt-4 text-xs text-muted-foreground">
            No credit card required &middot; Connect your data in 2 minutes
        </p>
    </div>
</section>

<style>
    @@keyframes typingBounce {
        0%, 100% { opacity: 0.2; transform: translateY(0); }
        50%       { opacity: 1;   transform: translateY(-2px); }
    }
</style>

@code {
    private record ChatMessage(string Id, string Role, string Content);

    private static readonly ChatMessage[] _messages =
    [
        new("m1", "user",      "What were our top 3 products by revenue last week?"),
        new("m2", "assistant", "Pro plan led at $48.2K, followed by Team at $31.7K and Starter at $12.4K."),
    ];
}
