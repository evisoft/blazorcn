@* ============================================================
   Block: cta-card-inset-feature-checklist
   Title: CtaCardInsetFeatureChecklist
   Description: A card-inset dark CTA for React and Next.js with kicker, headline, two-column feature checklist, and inverted ShadcnioButton, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-card-inset-feature-checklist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-3xl border bg-muted/40 p-2 sm:p-4">
        <div class="rounded-2xl bg-foreground px-6 py-10 sm:px-10 sm:py-14">
            <div class="mx-auto max-w-2xl text-center">
                <p class="text-xs font-medium uppercase tracking-widest text-background/50">
                    Enterprise
                </p>
                <h2 class="mt-3 text-3xl font-semibold tracking-tight text-background sm:text-4xl">
                    Build a plan that fits your scale
                </h2>
                <p class="mt-3 text-sm leading-relaxed text-background/60">
                    For teams that need advanced security, dedicated support, and custom contract terms.
                </p>
            </div>

            <div class="mx-auto mt-8 grid max-w-lg grid-cols-1 gap-x-8 gap-y-2.5 sm:grid-cols-2">
                @foreach (var feature in _features)
                {
                    <div class="flex items-center gap-2.5">
                        <LucideIconCn Name="check" Size="14" Class="size-3.5 shrink-0 stroke-[3] text-emerald-500" aria-hidden="true" />
                        <span class="text-sm text-background/80">@feature</span>
                    </div>
                }
            </div>

            <div class="mt-8 flex justify-center">
                <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[190px]">
                    Contact sales
                </ButtonCn>
            </div>

            <p class="mt-4 text-center text-xs text-background/30">
                Custom terms &middot; Volume pricing &middot; 30-day evaluation
            </p>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _features =
    [
        "Unlimited seats & projects",
        "Dedicated account manager",
        "Custom SLA & uptime guarantee",
        "SSO, SCIM & audit logs",
        "Priority support & onboarding",
        "Custom integrations & API limits",
    ];
}
