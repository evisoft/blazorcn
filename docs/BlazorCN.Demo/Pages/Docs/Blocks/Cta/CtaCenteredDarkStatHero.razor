@* ============================================================
   Block: cta-centered-dark-stat-hero
   Title: CtaCenteredDarkStatHero
   Description: A centered dark CTA for React and Next.js with uppercase kicker, oversized stat hero, inverted ShadcnioButton, and ghost secondary action, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-dark-stat-hero.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl bg-foreground px-8 py-12 text-center sm:px-12 sm:py-16">
        <p class="text-sm font-medium uppercase tracking-widest text-background/60">@_kicker</p>

        <div class="mt-5 font-semibold text-5xl tabular-nums text-background sm:text-6xl">
            @_statValue
        </div>

        <h2 class="mx-auto mt-4 max-w-md text-3xl font-semibold tracking-tight text-background sm:text-4xl">
            Teams trust us to ship faster
        </h2>

        <p class="mx-auto mt-4 max-w-sm text-base leading-relaxed text-background/60">
            Join the community of developers building the future of the web with production-ready
            components.
        </p>

        <div class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
            <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[195px]">
                Get started free
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[210px]">
                View case studies
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private const string _statValue = "50,000+";
    private const string _kicker = "A milestone worth celebrating";
}
