@* ============================================================
   Block: cta-card-inset-metric-row
   Title: CtaCardInsetMetricRow
   Description: A card-inset dark CTA for React and Next.js with a light outer frame, dark inner card, inline metric trust row, and dual ShadcnioButton action, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-card-inset-metric-row.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-3xl bg-muted/40 p-2 sm:p-3">
        <div class="rounded-2xl bg-foreground px-6 py-12 sm:px-10 sm:py-14">
            <p class="text-xs font-medium uppercase tracking-widest text-background/50">
                Built for scale
            </p>

            <h2 class="mt-4 max-w-md text-3xl font-semibold tracking-tight text-background sm:text-4xl">
                The API platform your infrastructure deserves.
            </h2>

            <p class="mt-4 max-w-md text-base leading-relaxed text-background/60">
                Ship faster with managed endpoints, automatic scaling, and real-time observability out
                of the box.
            </p>

            <div class="mt-7 flex flex-wrap items-baseline gap-x-8 gap-y-3">
                @foreach (var metric in _metrics)
                {
                    <div class="flex items-baseline gap-2">
                        <span class="text-lg font-semibold tabular-nums text-background">@metric.Value</span>
                        <span class="text-xs text-background/50">@metric.Label</span>
                    </div>
                }
            </div>

            <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
                <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[200px]">
                    Start building
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[230px]">
                    View documentation
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record Metric(string Value, string Label);

    private static readonly Metric[] _metrics =
    [
        new("2.4B+", "API calls per day"),
        new("99.99%", "Uptime SLA"),
        new("<50ms", "Global p95 latency"),
    ];
}
