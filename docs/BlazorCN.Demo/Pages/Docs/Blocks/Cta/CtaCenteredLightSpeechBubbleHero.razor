@* ============================================================
   Block: cta-centered-light-speech-bubble-hero
   Title: CtaCenteredLightSpeechBubbleHero
   Description: A centered light CTA for React and Next.js where the card itself is a giant speech bubble with a downward tail notch, a quote-style headline, and an attributed speaker row below, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-light-speech-bubble-hero.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @* The card IS the speech bubble *@
    <div class="relative rounded-3xl border bg-card px-6 py-10 text-center sm:px-10 sm:py-14">

        @* Oversized decorative quote mark *@
        <span
            aria-hidden="true"
            class="pointer-events-none absolute top-4 left-5 font-serif text-5xl leading-none text-muted-foreground/25 select-none sm:top-6 sm:left-8 sm:text-6xl">
            &ldquo;
        </span>

        @* Quote-style headline *@
        <h2 class="relative mx-auto max-w-lg text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
            We ship every week &mdash; and our users notice every single release.
        </h2>

        <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-muted-foreground">
            The velocity compounds. After six months on the platform, our release cadence felt like
            a competitive advantage nobody could match.
        </p>

        @* Primary CTA inside the bubble *@
        <div class="mt-7 flex justify-center">
            <ButtonCn Class="w-full sm:w-[195px]">Start for free</ButtonCn>
        </div>

        @* Bubble tail — rotated square positioned to look continuous with the card *@
        <span
            aria-hidden="true"
            class="-bottom-[9px] absolute left-12 size-4 rotate-45 border-r border-b bg-card sm:left-16" />
    </div>

    @* Speaker attribution below the tail *@
    <div class="mt-7 flex items-center justify-center gap-3">
        <div class="flex size-10 items-center justify-center rounded-full border bg-muted text-xs font-semibold text-foreground">
            @_speaker.Initials
        </div>
        <div class="text-left">
            <p class="text-sm font-medium text-foreground">&mdash; @_speaker.Name</p>
            <p class="text-xs text-muted-foreground">@_speaker.Role</p>
        </div>
    </div>
</section>

@code {
    private record Speaker(string Name, string Role, string Initials);

    private static readonly Speaker _speaker = new("Sarah Chen", "Head of Design at Linear", "SC");
}
