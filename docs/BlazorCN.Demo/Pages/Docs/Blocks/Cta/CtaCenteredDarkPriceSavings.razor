@* ============================================================
   Block: cta-centered-dark-price-savings
   Title: CtaCenteredDarkPriceSavings
   Description: A centered dark CTA for React and Next.js with uppercase kicker, crossed-out price compare, inline feature row, and inverted ShadcnioButton, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-dark-price-savings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground px-6 py-14 text-center sm:px-10 sm:py-20">
        <p class="text-xs font-medium uppercase tracking-widest text-background/40">
            Limited Time Bundle
        </p>

        <h2 class="mx-auto mt-4 max-w-lg text-3xl font-semibold tracking-tight text-background sm:text-4xl">
            Everything you need.
            <br />
            One price. Save $@_savings.
        </h2>

        <div class="mt-5 flex items-center justify-center gap-2">
            <span class="text-sm text-background/40 line-through">$@_individualTotal/mo</span>
            <span class="text-2xl font-semibold tabular-nums text-background">
                $@_bundlePrice/mo
            </span>
        </div>

        <div class="mt-4 flex flex-wrap items-center justify-center gap-2 text-sm text-background/50">
            @foreach (var item in _products)
            {
                var idx = Array.IndexOf(_products, item);
                <span class="flex items-center gap-2">
                    @if (idx > 0)
                    {
                        <span class="size-1 rounded-full bg-background/20"></span>
                    }
                    @item
                </span>
            }
        </div>

        <div class="mt-8 flex justify-center">
            <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[200px]">
                Get the bundle
            </ButtonCn>
        </div>

        <p class="mt-4 text-xs text-background/30">
            14-day money-back guarantee &middot; Cancel anytime
        </p>
    </div>
</section>

@code {
    private static readonly string[] _products = ["Components", "Icons", "Templates"];
    private const int _individualTotal = 40;
    private const int _bundlePrice = 29;
    private const int _savings = _individualTotal - _bundlePrice;
}
