@* ============================================================
   Block: cta-split-panel-pricing-card-visual
   Title: CtaSplitPanelPricingCardVisual
   Description: A split panel dark CTA for React and Next.js with a left-side feature checklist, eyebrow pill, primary ShadcnioButton action, and a right-side pricing card visual built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-split-panel-pricing-card-visual.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="grid overflow-hidden rounded-2xl bg-foreground md:grid-cols-2">

        @* Left — eyebrow pill + headline + checklist + CTA *@
        <div class="flex flex-col justify-center px-6 py-10 sm:px-10 sm:py-12">
            <span class="inline-flex w-fit items-center gap-2 rounded-full border border-background/15 bg-background/5 px-3 py-1 text-xs font-medium text-background">
                Team plan
            </span>

            <h2 class="mt-4 text-3xl font-semibold tracking-tight text-background sm:text-4xl">
                Build together, ship faster
            </h2>
            <p class="mt-4 max-w-sm text-base leading-relaxed text-background/60">
                Everything your team needs to collaborate, review, and deliver at scale.
            </p>

            <ul class="mt-6 space-y-2.5">
                @foreach (var feature in _features)
                {
                    <li class="flex items-center gap-2.5 text-sm text-background/80">
                        <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-400" />
                        @feature
                    </li>
                }
            </ul>

            <ButtonCn Class="mt-8 w-full bg-background text-foreground hover:bg-background/90 sm:w-[200px]">
                Upgrade to Team
            </ButtonCn>
        </div>

        @* Right — pricing card visual *@
        <div class="flex items-center justify-center border-t border-background/10 bg-background/5 px-6 py-10 sm:px-10 sm:py-12 md:border-t-0 md:border-l">
            <div class="w-full max-w-xs text-center">
                <p class="text-xs font-medium uppercase tracking-wider text-background/40">
                    Starting at
                </p>
                <div class="mt-2 flex items-baseline justify-center gap-1">
                    <span class="text-5xl font-semibold tabular-nums text-background">
                        @_pricingPlan.Currency@(_pricingPlan.PricePerSeat)
                    </span>
                    <span class="text-sm text-background/50">@_pricingPlan.Cadence</span>
                </div>
                <p class="mt-3 text-xs text-background/40">
                    Billed annually &middot; 10% off at 10+ seats
                </p>

                <div class="mt-6 rounded-xl border border-background/10 bg-background/5 px-4 py-3">
                    <p class="text-xs text-background/60">
                        @(_pricingPlan.Seats) seats &times; @(_pricingPlan.Currency)@(_pricingPlan.PricePerSeat)/mo
                    </p>
                    <p class="mt-1 text-2xl font-semibold tabular-nums text-background">
                        @(_pricingPlan.Currency)@(_pricingPlan.Total)
                        <span class="ml-1 text-sm font-normal text-background/50">/mo</span>
                    </p>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private static readonly string[] _features =
    [
        "Unlimited team members",
        "Shared workspace with roles",
        "Real-time collaboration",
        "Priority support & SLA",
        "Advanced audit logging",
        "SSO & SAML integration",
    ];

    private sealed class PricingPlan
    {
        public int PricePerSeat { get; } = 15;
        public int Seats { get; } = 5;
        public string Currency { get; } = "$";
        public string Cadence { get; } = "/seat/mo";
        public int Total => PricePerSeat * Seats;
    }

    private static readonly PricingPlan _pricingPlan = new();
}
