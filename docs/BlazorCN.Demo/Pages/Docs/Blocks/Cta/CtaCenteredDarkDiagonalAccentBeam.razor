@* ============================================================
   Block: cta-centered-dark-diagonal-accent-beam
   Title: CtaCenteredDarkDiagonalAccentBeam
   Description: A centered dark CTA band for React and Next.js with a diagonal SVG light beam sweeping across bg-foreground, version announcement pill, inverted ShadcnioButton and text link secondary built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-dark-diagonal-accent-beam.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="relative overflow-hidden rounded-2xl bg-foreground px-6 py-14 text-center sm:px-12 sm:py-20">
        @* Decorative diagonal light beam *@
        <svg
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 h-full w-full"
            preserveAspectRatio="none"
            viewBox="0 0 800 400">
            <defs>
                <linearGradient id="beam-gradient" x1="0%" x2="100%" y1="0%" y2="0%">
                    <stop offset="0%" stop-color="currentColor" stop-opacity="0" />
                    <stop offset="45%" stop-color="currentColor" stop-opacity="0.18" />
                    <stop offset="55%" stop-color="currentColor" stop-opacity="0.18" />
                    <stop offset="100%" stop-color="currentColor" stop-opacity="0" />
                </linearGradient>
                <linearGradient id="beam-gradient-faint" x1="0%" x2="100%" y1="0%" y2="0%">
                    <stop offset="0%" stop-color="currentColor" stop-opacity="0" />
                    <stop offset="50%" stop-color="currentColor" stop-opacity="0.08" />
                    <stop offset="100%" stop-color="currentColor" stop-opacity="0" />
                </linearGradient>
            </defs>
            <g class="text-background" transform="rotate(-14 400 200)">
                <line
                    stroke="url(#beam-gradient)"
                    stroke-width="1.5"
                    x1="-100"
                    x2="900"
                    y1="140"
                    y2="140" />
                <line
                    stroke="url(#beam-gradient-faint)"
                    stroke-width="28"
                    x1="-100"
                    x2="900"
                    y1="140"
                    y2="140" />
                <line
                    stroke="url(#beam-gradient)"
                    stroke-width="1"
                    x1="-100"
                    x2="900"
                    y1="260"
                    y2="260" />
            </g>
        </svg>

        @* Content *@
        <div class="relative z-10">
            <span class="inline-flex items-center gap-2 rounded-full border border-background/15 bg-background/5 px-3 py-1 text-xs font-medium text-background">
                <span class="relative flex size-1.5">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-70"></span>
                    <span class="relative inline-flex size-1.5 rounded-full bg-emerald-500"></span>
                </span>
                @_release.Label &middot; @_release.Version
            </span>

            <h2 class="mx-auto mt-6 max-w-xl text-3xl font-semibold tracking-tight text-background sm:text-4xl">
                A week of launches.
                <br />
                One calm release.
            </h2>

            <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-background/60">
                Five new features, two refreshed blocks, and a faster CLI. Everything we shipped this
                week, bundled into one update.
            </p>

            <div class="mt-8 flex flex-col items-center justify-center gap-4">
                <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[200px]">
                    See what&#39;s new
                </ButtonCn>
                <a
                    class="inline-flex items-center gap-1 text-sm text-background/60 transition-colors hover:text-background"
                    href="#changelog">
                    Read the changelog &rarr;
                </a>
            </div>
        </div>
    </div>
</section>

@code {
    private record Release(string Version, string Label, string Status);

    private static readonly Release _release = new("v3.0", "Launch week is live", "live");
}
