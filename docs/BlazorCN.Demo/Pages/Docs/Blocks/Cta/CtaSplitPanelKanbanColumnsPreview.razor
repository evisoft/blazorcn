@* ============================================================
   Block: cta-split-panel-kanban-columns-preview
   Title: CtaSplitPanelKanbanColumnsPreview
   Description: A split panel CTA for React and Next.js with a three-column kanban board preview, task cards with avatar and priority dot, uppercase column headers, and dual ShadcnioButton row built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-split-panel-kanban-columns-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="flex flex-col md:grid md:grid-cols-2 md:divide-x">

            @* Left panel — kanban preview *@
            <div aria-hidden="true" class="bg-muted/40 px-6 py-10 sm:px-8 sm:py-12">
                <div class="flex gap-2">
                    @foreach (var col in _board)
                    {
                        var column = col;
                        <div class="flex flex-1 flex-col gap-2">
                            @* Column header *@
                            <div class="flex items-center justify-between px-1 pb-1">
                                <span class="font-bold text-[10px] uppercase tracking-[0.12em] text-muted-foreground">
                                    @column.Title
                                </span>
                                <span class="font-medium text-[10px] text-muted-foreground/60">
                                    @column.Tasks.Length
                                </span>
                            </div>

                            @* Task cards *@
                            @foreach (var tsk in column.Tasks)
                            {
                                var task = tsk;
                                <div class="rounded-md border bg-background px-3 py-2 shadow-[0_1px_0_rgba(0,0,0,0.02)]">
                                    <p class="line-clamp-2 text-[11px] font-medium text-foreground leading-snug">
                                        @task.Title
                                    </p>
                                    <div class="mt-2 flex items-center justify-between">
                                        <div class="flex size-5 items-center justify-center rounded-full bg-muted font-semibold text-[9px] text-muted-foreground">
                                            @task.Assignee
                                        </div>
                                        <span class="@($"size-1.5 rounded-full {PriorityDot(task.Priority)}")" />
                                    </div>
                                </div>
                            }

                            @* Empty slot hint *@
                            <div class="h-5 rounded-md border border-dashed border-muted-foreground/15" />
                        </div>
                    }
                </div>
            </div>

            @* Right panel — copy *@
            <div class="flex flex-col justify-center px-6 py-10 sm:px-10 sm:py-14">
                <p class="mb-4 font-medium text-sm text-muted-foreground">Project management</p>

                <h2 class="font-semibold text-2xl tracking-tight text-foreground sm:text-3xl lg:text-4xl">
                    Drag, drop,
                    <br />
                    done.
                </h2>

                <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                    The simplest way to track work without drowning your team in status meetings. Boards,
                    tasks, and priorities — nothing more.
                </p>

                <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
                    <ButtonCn Class="w-full sm:w-[180px]">Get started</ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[185px]">
                        Book a demo
                    </ButtonCn>
                </div>

                <p class="mt-4 text-xs text-muted-foreground">
                    Free for up to 10 users &middot; No credit card required
                </p>
            </div>

        </div>
    </div>
</section>

@code {
    private enum Priority { High, Medium, Low }

    private record Task(string Id, string Title, string Assignee, Priority Priority);
    private record Column(string Id, string Title, Task[] Tasks);

    private static readonly Column[] _board =
    [
        new("todo", "Todo",
        [
            new("t1", "Update pricing page", "AM", Priority.High),
            new("t2", "Fix header on mobile", "JR", Priority.Medium),
        ]),
        new("in-progress", "In Progress",
        [
            new("t3", "Ship v2.4 release notes", "SK", Priority.High),
            new("t4", "Redesign onboarding", "EL", Priority.Medium),
        ]),
        new("done", "Done",
        [
            new("t5", "Migrate to Postgres 17", "TN", Priority.Low),
            new("t6", "Audit billing emails", "RP", Priority.Low),
        ]),
    ];

    private static string PriorityDot(Priority priority) => priority switch
    {
        Priority.High   => "bg-red-500",
        Priority.Medium => "bg-amber-500",
        Priority.Low    => "bg-emerald-500",
        _               => "bg-muted",
    };
}
