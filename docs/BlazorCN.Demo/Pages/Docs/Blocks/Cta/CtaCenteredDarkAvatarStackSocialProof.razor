@* ============================================================
   Block: cta-centered-dark-avatar-stack-social-proof
   Title: CtaCenteredDarkAvatarStackSocialProof
   Description: A centered dark CTA section for React and Next.js with overlapping avatar stack, team count label, h2 headline, inverted primary ShadcnioButton, and trust row built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-dark-avatar-stack-social-proof.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground px-6 py-12 text-center sm:px-12 sm:py-16">
        @* Avatar stack + team count *@
        <div class="flex items-center justify-center">
            <div class="flex -space-x-2">
                @foreach (var avatar in _avatars)
                {
                    <AvatarCn Class="size-8 border-2 border-foreground">
                        <AvatarImageCn Src="@avatar.Src" Alt="" />
                        <AvatarFallbackCn Class="bg-background/20 text-[10px] text-background">@avatar.Fallback</AvatarFallbackCn>
                    </AvatarCn>
                }
            </div>
            <span class="ml-3 text-xs font-medium text-background">@_teamCount teams</span>
        </div>

        @* Headline *@
        <h2 class="mx-auto mt-6 max-w-md text-3xl font-semibold tracking-tight text-background sm:text-4xl">
            Join the teams shipping faster
        </h2>

        @* Subtitle *@
        <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-background/60">
            From seed-stage startups to public companies, engineering teams choose us to move faster
            without breaking things.
        </p>

        @* Primary CTA *@
        <div class="mt-8 flex items-center justify-center">
            <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[190px]">
                Get started free
            </ButtonCn>
        </div>

        @* Trust text *@
        <p class="mt-4 text-xs text-background/30">
            Free for 14 days &middot; No credit card required &middot; Cancel anytime
        </p>
    </div>
</section>

@code {
    private record TeamAvatar(string Src, string Fallback);

    private static readonly TeamAvatar[] _avatars =
    [
        new("https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=64&h=64&fit=crop&crop=face", "SL"),
        new("https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=64&h=64&fit=crop&crop=face", "MR"),
        new("https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=64&h=64&fit=crop&crop=face", "AJ"),
        new("https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?w=64&h=64&fit=crop&crop=face", "TK"),
        new("https://images.unsplash.com/photo-1517841905240-472988babdf9?w=64&h=64&fit=crop&crop=face", "ER"),
    ];

    private const string _teamCount = "2,400+";
}
