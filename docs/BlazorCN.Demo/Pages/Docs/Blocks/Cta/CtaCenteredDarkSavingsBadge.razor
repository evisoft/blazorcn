@* ============================================================
   Block: cta-centered-dark-savings-badge
   Title: CtaCenteredDarkSavingsBadge
   Description: A centered dark CTA for React and Next.js with a prominent savings Badge above the headline, inverted primary ShadcnioButton, and clock-icon deadline footer built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-dark-savings-badge.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground px-6 py-12 text-center sm:px-12 sm:py-16">

        <BadgeCn Class="border-background/20 bg-background/10 text-background hover:bg-background/15">
            Save @_savingsPercent%
        </BadgeCn>

        <h2 class="mx-auto mt-5 max-w-lg text-3xl font-semibold tracking-tight text-background sm:text-4xl">
            Get Pro for $@_discountPrice/mo instead of $@_originalPrice
        </h2>

        <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-background/60">
            Lock in the lowest price this year. Full access to every component, block, and template.
        </p>

        <div class="mt-8 flex flex-col items-center gap-4">
            <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[210px]">
                Claim this deal
            </ButtonCn>
            <span class="flex items-center gap-1.5 text-xs text-background/40">
                <LucideIconCn Name="clock" Size="12" Class="size-3" />
                @_deadlineLabel
            </span>
        </div>

    </div>
</section>

@code {
    private const int _originalPrice = 39;
    private const int _discountPrice = 19;
    private static readonly int _savingsPercent = (int)Math.Round(((double)(_originalPrice - _discountPrice) / _originalPrice) * 100);
    private const string _deadlineLabel = "Offer ends April 15, 2026";
}
