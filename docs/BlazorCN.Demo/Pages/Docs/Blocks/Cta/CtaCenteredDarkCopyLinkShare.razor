@* ============================================================
   Block: cta-centered-dark-copy-link-share
   Title: CtaCenteredDarkCopyLinkShare
   Description: A centered dark CTA section for React and Next.js with inline copy-link field, primary ShadcnioButton share action, and secondary channel chips built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-dark-copy-link-share.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl bg-foreground px-6 py-12 text-center sm:px-12 sm:py-16">
        <h2 class="mx-auto max-w-lg text-3xl font-semibold tracking-tight text-background sm:text-4xl">
            Give a month, get a month
        </h2>

        <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-background/60">
            Share your link and you both get one month of Pro free. No limits on how many friends you
            refer.
        </p>

        <div class="mx-auto mt-8 flex max-w-md flex-col items-stretch gap-2 sm:flex-row sm:items-center">
            <div class="flex h-12 flex-1 items-center overflow-hidden rounded-xl border border-background/10 bg-background/5 px-4">
                <input
                    aria-label="Invite link"
                    class="w-full truncate bg-transparent font-mono text-xs text-background/70 outline-none"
                    readonly="readonly"
                    type="text"
                    value="@_inviteUrl"
                />
            </div>
            <ButtonCn
                Class="h-12 w-full shrink-0 bg-background text-foreground hover:bg-background/90 sm:w-[150px]"
                @onclick="HandleCopy"
                type="button"
            >
                @if (_copied)
                {
                    <LucideIconCn Name="check" Size="16" Class="size-4" />
                    <span>Copied</span>
                }
                else
                {
                    <LucideIconCn Name="copy" Size="16" Class="size-4" />
                    <span>Copy link</span>
                }
            </ButtonCn>
        </div>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
            @foreach (var channel in _channels)
            {
                var ch = channel;
                <button
                    class="inline-flex h-9 items-center gap-1.5 rounded-full border border-background/20 bg-transparent px-4 text-xs font-medium text-background transition-colors hover:bg-background/10"
                    type="button"
                >
                    <LucideIconCn Name="@ch.IconName" Size="14" Class="size-3.5" />
                    @ch.Label
                </button>
            }
        </div>

        <p class="mt-8 text-xs text-background/30">
            3 invites sent &middot; 1 accepted &middot; 1 month earned
        </p>
    </div>
</section>

@code {
    private const string _inviteUrl = "https://app.acme.com/invite/x7k2m";
    private bool _copied = false;

    private record Channel(string Label, string IconName);

    private static readonly Channel[] _channels =
    [
        new("Email", "mail"),
        new("Share", "share"),
    ];

    private async Task HandleCopy()
    {
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }
}
