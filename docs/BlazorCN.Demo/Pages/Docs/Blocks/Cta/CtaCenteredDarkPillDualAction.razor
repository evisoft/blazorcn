@* ============================================================
   Block: cta-centered-dark-pill-dual-action
   Title: CtaCenteredDarkPillDualAction
   Description: A centered dark CTA band for React and Next.js with a status-dot announcement pill, dual ShadcnioButton action row, and trust text below, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-dark-pill-dual-action.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl bg-foreground px-6 py-12 text-center sm:px-12 sm:py-16">
        <span class="inline-flex items-center gap-2 rounded-full border border-background/15 bg-background/5 px-3 py-1 text-xs font-medium text-background">
            <span class="size-1.5 rounded-full bg-emerald-500"></span>
            Save @SavingsPercent% with annual billing
        </span>

        <h2 class="mx-auto mt-6 max-w-lg text-3xl font-semibold tracking-tight text-background sm:text-4xl">
            Switch to annual.
            <br />
            Keep $@MonthlySavings in your pocket.
        </h2>

        <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-background/60">
            That's just $@AnnualPerMonth/mo billed annually, instead of $@MonthlyPrice/mo. Same
            features, same team, lower price.
        </p>

        <div class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
            <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[220px]">
                Upgrade to annual
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[190px]">
                Compare plans
            </ButtonCn>
        </div>

        <p class="mt-6 text-xs text-background/35">
            Cancel anytime &middot; Prorated refund if you switch back
        </p>
    </div>
</section>

@code {
    private const int MonthlyPrice = 29;
    private const int AnnualPrice = 228;
    private static readonly int MonthlySavings = MonthlyPrice * 12 - AnnualPrice;
    private static readonly int SavingsPercent = (int)Math.Round((double)MonthlySavings / (MonthlyPrice * 12) * 100);
    private static readonly int AnnualPerMonth = (int)Math.Round((double)AnnualPrice / 12);
}
