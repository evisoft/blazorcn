<section class="mx-auto w-full max-w-4xl p-4">
    <div class="flex flex-col gap-6 rounded-2xl bg-foreground px-6 py-8 sm:flex-row sm:items-center sm:justify-between sm:px-10">

        @* Left side — headline + subtitle *@
        <div>
            <h2 class="text-xl font-semibold tracking-tight text-background sm:text-2xl">
                Ready for enterprise?
            </h2>
            <p class="mt-1 text-sm text-background/60">
                Custom plans, dedicated support, and SLAs for your team.
            </p>
        </div>

        @* Right side — buttons *@
        <div class="flex shrink-0 flex-col items-stretch gap-3 sm:flex-row sm:items-center">
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[180px]">
                See pricing
            </ButtonCn>
            <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[190px]">
                Contact sales
            </ButtonCn>
        </div>

    </div>
</section>
