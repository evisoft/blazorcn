@* ============================================================
   Block: cta-centered-dark-graph-grid-paper
   Title: CtaCenteredDarkGraphGridPaper
   Description: A centered dark CTA for React and Next.js with an engineering graph grid paper backdrop on bg-foreground, monospace version badge, inverted primary ShadcnioButton, and ghost secondary action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-dark-graph-grid-paper.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="relative overflow-hidden rounded-2xl bg-foreground px-6 py-14 text-center sm:px-12 sm:py-20">

        @* Decorative graph-paper grid backdrop *@
        <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 z-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.06)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.06)_1px,transparent_1px)] bg-[size:32px_32px] [mask-image:radial-gradient(ellipse_at_center,black_40%,transparent_80%)] [-webkit-mask-image:radial-gradient(ellipse_at_center,black_40%,transparent_80%)]">
        </div>

        @* Content *@
        <div class="relative z-10">
            <span class="inline-flex items-center gap-2 rounded-full border border-background/15 bg-background/5 px-3 py-1 font-mono text-[11px] font-medium text-background/80">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                @_meta.Version
            </span>

            <h2 class="mx-auto mt-6 max-w-xl text-3xl font-semibold tracking-tight text-background sm:text-4xl">
                @_meta.HeadlineA
                <br />
                @_meta.HeadlineB
            </h2>

            <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-background/60">
                @_meta.Subtext
            </p>

            <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[180px]">
                    Install SDK
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[180px]">
                    View on GitHub
                </ButtonCn>
            </div>

            <p class="mt-5 font-mono text-xs text-background/30">
                npm i @@horizon/sdk &middot; MIT licensed &middot; TypeScript first
            </p>
        </div>
    </div>
</section>

@code {
    private record ReleaseMeta(string Version, string HeadlineA, string HeadlineB, string Subtext);

    private static readonly ReleaseMeta _meta = new(
        Version: "v2.0.0 — stable",
        HeadlineA: "The developer SDK",
        HeadlineB: "for modern teams.",
        Subtext: "A typed client, streaming endpoints, and zero-config retries. Install in under a minute."
    );
}
