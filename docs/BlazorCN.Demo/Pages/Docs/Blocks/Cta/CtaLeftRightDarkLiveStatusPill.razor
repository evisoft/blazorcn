@* ============================================================
   Block: cta-left-right-dark-live-status-pill
   Title: CtaLeftRightDarkLiveStatusPill
   Description: A left-right dark CTA section for React and Next.js with a pulsing live status pill, left-aligned headline on bg-foreground, inverted primary ShadcnioButton, and ghost secondary action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-left-right-dark-live-status-pill.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground">
        <div class="flex flex-col gap-6 px-6 py-8 sm:flex-row sm:items-center sm:justify-between sm:gap-10 sm:px-10 sm:py-8">

            @* Left — live status pill + headline + subtitle *@
            <div class="min-w-0 flex-1 text-center sm:text-left">
                <div class="inline-flex items-center gap-2 rounded-full border border-background/15 bg-background/5 px-3 py-1 text-xs font-medium text-background/80">
                    <span class="relative flex size-1.5">
                        <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-500 opacity-75"></span>
                        <span class="relative inline-flex size-1.5 rounded-full bg-emerald-500"></span>
                    </span>
                    All systems operational
                </div>

                <h2 class="mt-3 text-xl font-semibold tracking-tight text-background sm:text-2xl">
                    99.99% uptime, guaranteed.
                </h2>
                <p class="mt-2 max-w-md text-sm text-background/60 leading-relaxed">
                    Enterprise-grade reliability backed by SLA. Monitored every 30 seconds across 12
                    global regions.
                </p>
            </div>

            @* Right — dual action buttons *@
            <div class="flex shrink-0 flex-col items-stretch gap-3 sm:flex-row sm:items-center">
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[200px]">
                    View status page
                </ButtonCn>
                <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[210px]">
                    Start monitoring
                </ButtonCn>
            </div>

        </div>
    </div>
</section>
