@* ============================================================
   Block: cta-centered-light-ticket-perforated-edge
   Title: CtaCenteredLightTicketPerforatedEdge
   Description: A centered light CTA for React and Next.js shaped like a perforated admission ticket with two semi-circle notches cut into a vertical tear line, a left info panel, and a right stub panel holding a mono promo code and primary ShadcnioButton, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-light-ticket-perforated-edge.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="relative overflow-hidden rounded-2xl border bg-card">
        @* Top notch — sits on the tear line. Vertical-tear layout (sm+): horizontal position
           at roughly 60%. Stacked layout (mobile): hidden. *@
        <span
            aria-hidden="true"
            class="-top-2 absolute left-[calc(58.33%-8px)] hidden size-4 rounded-full bg-background sm:block" />
        @* Bottom notch on sm+ tear line *@
        <span
            aria-hidden="true"
            class="-bottom-2 absolute left-[calc(58.33%-8px)] hidden size-4 rounded-full bg-background sm:block" />

        @* Mobile horizontal-tear notches *@
        <span
            aria-hidden="true"
            class="-left-2 absolute top-[calc(62%-8px)] size-4 rounded-full bg-background sm:hidden" />
        <span
            aria-hidden="true"
            class="-right-2 absolute top-[calc(62%-8px)] size-4 rounded-full bg-background sm:hidden" />

        <div class="grid grid-rows-[1fr_auto] sm:grid-cols-[1.4fr_1fr] sm:grid-rows-none">
            @* Left info panel *@
            <div class="border-b border-dashed px-6 py-10 sm:border-r sm:border-b-0 sm:px-10 sm:py-12">
                <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-2.5 py-1 text-xs font-medium text-foreground">
                    <LucideIconCn Name="ticket" Size="12" Class="size-3" aria-hidden="true" />
                    Launch Week 08
                </span>

                <h2 class="mt-5 text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
                    Your launch week pass is ready.
                </h2>

                <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted-foreground">
                    Unlock every new release, daily livestreams, and a private community channel for seven days.
                </p>
            </div>

            @* Right stub panel *@
            <div class="flex flex-col justify-center gap-4 px-6 py-8 text-center sm:px-8 sm:py-12">
                <div>
                    <p class="text-[10px] font-medium tracking-wider text-muted-foreground uppercase">
                        Your access code
                    </p>
                    <p class="mt-2 font-mono text-xl font-semibold tracking-[0.2em] text-foreground sm:text-2xl">
                        LAUNCH25
                    </p>
                </div>

                <div class="flex justify-center">
                    <ButtonCn Class="w-full sm:w-[180px]">Claim offer</ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>
