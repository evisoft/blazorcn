@* ============================================================
   Block: cta-centered-dark-starfield-sparse
   Title: CtaCenteredDarkStarfieldSparse
   Description: A centered dark CTA section for React and Next.js with a sparse starfield backdrop of deterministic dot positions, eyebrow pill, inverted primary ShadcnioButton, and ghost secondary action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-dark-starfield-sparse.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="relative overflow-hidden rounded-2xl bg-foreground px-6 py-14 text-center sm:px-12 sm:py-16">

        @* Sparse starfield backdrop — decorative, behind content *@
        <div aria-hidden="true" class="pointer-events-none absolute inset-0">
            @foreach (var star in _stars)
            {
                <span class="@($"absolute rounded-full bg-background {star.Size} {star.Opacity}")"
                      style="@($"top:{star.Top};left:{star.Left}")"></span>
            }
        </div>

        @* Content layer *@
        <div class="relative z-10">
            @* Eyebrow pill *@
            <span class="inline-flex items-center gap-2 rounded-full border border-background/15 bg-background/5 px-3 py-1 text-xs font-medium text-background">
                <LucideIconCn Name="sparkles" Size="12" Class="size-3 text-background/70" />
                Launch night &middot; v3.0 is live
            </span>

            @* Headline *@
            <h2 class="mx-auto mt-5 max-w-xl text-3xl font-semibold tracking-tight text-background sm:text-4xl">
                The next chapter of shadcn.io
                <br />
                starts tonight.
            </h2>

            @* Subtitle *@
            <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-background/60">
                One hundred new blocks, a redesigned registry, and a faster CLI. Go see what the team
                shipped.
            </p>

            @* Button row *@
            <div class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
                <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[180px]">
                    Get started
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[170px]">
                    Read the notes
                </ButtonCn>
            </div>

            @* Trust text *@
            <p class="mt-4 text-xs text-background/35">
                Free forever &middot; Open source &middot; No account required
            </p>
        </div>
    </div>
</section>

@code {
    private record Star(string Top, string Left, string Size, string Opacity);

    private static readonly Star[] _stars =
    [
        new("8%",  "6%",  "size-0.5", "opacity-60"),
        new("14%", "22%", "size-1",   "opacity-80"),
        new("11%", "41%", "size-0.5", "opacity-40"),
        new("7%",  "63%", "size-0.5", "opacity-60"),
        new("18%", "78%", "size-1",   "opacity-80"),
        new("24%", "92%", "size-0.5", "opacity-40"),
        new("34%", "4%",  "size-0.5", "opacity-60"),
        new("42%", "14%", "size-1",   "opacity-40"),
        new("48%", "88%", "size-0.5", "opacity-60"),
        new("56%", "71%", "size-0.5", "opacity-80"),
        new("62%", "9%",  "size-0.5", "opacity-40"),
        new("68%", "32%", "size-1",   "opacity-60"),
        new("74%", "58%", "size-0.5", "opacity-80"),
        new("81%", "84%", "size-0.5", "opacity-40"),
        new("88%", "18%", "size-0.5", "opacity-60"),
        new("92%", "47%", "size-1",   "opacity-80"),
    ];
}
