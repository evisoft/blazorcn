@* ============================================================
   Block: cta-centered-light-icon-medallion
   Title: CtaCenteredLightIconMedallion
   Description: A centered light CTA with icon medallion for React and Next.js with circular icon tile, short headline, subtitle, and dual ShadcnioButton row, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-light-icon-medallion.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card px-6 py-12 sm:px-10 sm:py-14">
        <div class="mx-auto max-w-md text-center">

            <div aria-hidden="true"
                 class="mx-auto flex size-14 items-center justify-center rounded-full border bg-muted/50">
                <LucideIconCn Name="shield-check" Size="24" Class="size-6 text-foreground" />
            </div>

            <h2 class="mt-6 text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
                Protect your account
            </h2>

            <p class="mt-4 text-base leading-relaxed text-muted-foreground">
                Two-factor authentication adds a second layer of security. Accounts with 2FA enabled are
                99.9% less likely to be compromised.
            </p>

            <div class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
                <ButtonCn Class="w-full sm:w-[155px]">Enable 2FA</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[175px]">
                    Remind me later
                </ButtonCn>
            </div>

            <p class="mt-5 text-xs text-muted-foreground">
                Supports authenticator apps and hardware security keys
            </p>
        </div>
    </div>
</section>
