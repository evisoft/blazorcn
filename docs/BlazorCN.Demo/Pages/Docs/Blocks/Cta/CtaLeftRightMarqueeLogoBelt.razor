@* ============================================================
   Block: cta-left-right-marquee-logo-belt
   Title: CtaLeftRightMarqueeLogoBelt
   Description: A left right dark CTA for React and Next.js with an infinite horizontal logo marquee belt spanning the full width below the headline and dual ShadcnioButton row, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-left-right-marquee-logo-belt.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground">

        @* Top row: headline left, buttons right *@
        <div class="flex flex-col gap-6 px-6 py-10 sm:flex-row sm:items-center sm:justify-between sm:gap-8 sm:px-10 sm:py-12">
            <div class="max-w-lg">
                <span class="inline-flex items-center gap-2 rounded-full border border-background/15 bg-background/5 px-3 py-1 text-xs font-medium text-background/80">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Trusted by 12,000+ teams
                </span>

                <h2 class="mt-4 text-3xl font-semibold tracking-tight text-background sm:text-4xl">
                    The platform engineering teams rely on.
                </h2>

                <p class="mt-3 max-w-md text-sm leading-relaxed text-background/60 sm:text-base">
                    From early-stage startups to the Fortune 500 — teams ship faster with our
                    infrastructure.
                </p>
            </div>

            <div class="flex shrink-0 flex-col items-stretch gap-3 sm:flex-row sm:items-center">
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[185px]">
                    Read case studies
                </ButtonCn>
                <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[190px]">
                    Contact sales
                </ButtonCn>
            </div>
        </div>

        @* Logo marquee belt — spans full width *@
        <div class="relative border-t border-background/10 py-6">
            @* Edge fade overlays *@
            <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-16 bg-gradient-to-r from-foreground to-transparent"></div>
            <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-16 bg-gradient-to-l from-foreground to-transparent"></div>

            <div class="flex overflow-hidden">
                <div class="blazorcn-marquee flex shrink-0 items-center gap-8 pr-8">
                    @* First copy *@
                    @foreach (var logo in _logos)
                    {
                        <div class="flex h-8 shrink-0 items-center rounded-md border border-background/10 bg-background/5 px-4 text-xs font-medium text-background/60">
                            @logo.Name
                        </div>
                    }
                    @* Second copy — seamless loop *@
                    @foreach (var logo in _logos)
                    {
                        <div aria-hidden="true" class="flex h-8 shrink-0 items-center rounded-md border border-background/10 bg-background/5 px-4 text-xs font-medium text-background/60">
                            @logo.Name
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</section>

<style>
    @@keyframes blazorcn-marquee-scroll {
        from { transform: translateX(0%); }
        to   { transform: translateX(-50%); }
    }
    .blazorcn-marquee {
        animation: blazorcn-marquee-scroll 30s linear infinite;
    }
</style>

@code {
    private record Logo(string Name);

    private static readonly Logo[] _logos =
    [
        new("Stripe"),
        new("Vercel"),
        new("Linear"),
        new("Notion"),
        new("Figma"),
        new("Framer"),
        new("Supabase"),
        new("Cloudflare"),
        new("Shopify"),
        new("Airbnb"),
        new("Datadog"),
        new("GitHub"),
    ];
}
