@* ============================================================
   Block: cta-centered-light-confetti-burst-overlay
   Title: CtaCenteredLightConfettiBurstOverlay
   Description: A centered light CTA for React and Next.js with a static deterministic confetti burst overlay of rotated rectangles and circles scattered around the card edges, celebratory icon badge, and single primary ShadcnioButton built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-light-confetti-burst-overlay.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="relative overflow-hidden rounded-2xl border bg-card px-8 py-10 text-center">

        @* Confetti overlay layer *@
        <div aria-hidden="true" class="pointer-events-none absolute inset-0">
            @foreach (var piece in _confetti)
            {
                <span class="@($"absolute {piece.Color} {(piece.Shape == "rect" ? "h-3 w-1 rounded-sm" : "size-1.5 rounded-full")}")"
                      style="@($"top:{piece.Top};left:{piece.Left};transform:rotate({piece.Rotate}deg)")"></span>
            }
        </div>

        @* Celebratory icon badge *@
        <div class="relative">
            <span aria-hidden="true" class="inline-flex size-12 items-center justify-center rounded-full border bg-muted/50">
                <LucideIconCn Name="party-popper" Size="20" Class="size-5 text-emerald-600 dark:text-emerald-500" />
            </span>

            @* Headline *@
            <h2 class="mx-auto mt-5 max-w-md text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
                You unlocked Pro
            </h2>

            @* Subtext *@
            <p class="mx-auto mt-3 max-w-sm text-sm text-muted-foreground leading-relaxed">
                Every premium block, team collaboration, and priority support are now active on your
                account.
            </p>

            @* Primary button *@
            <div class="mt-7 flex justify-center">
                <ButtonCn Class="w-full sm:w-[205px]">Explore new tools</ButtonCn>
            </div>

            @* Trust text *@
            <p class="mt-4 text-xs text-muted-foreground">
                Enjoy your upgrade &middot; Renews yearly &middot; Manage in settings
            </p>
        </div>
    </div>
</section>

@code {
    private record ConfettiPiece(string Id, string Top, string Left, int Rotate, string Color, string Shape);

    private static readonly ConfettiPiece[] _confetti =
    [
        new("c1",  "8%",  "6%",   -18, "bg-amber-500/70",   "rect"),
        new("c2",  "14%", "88%",   32, "bg-emerald-500/70", "rect"),
        new("c3",  "4%",  "42%",   -8, "bg-blue-500/70",    "dot"),
        new("c4",  "22%", "18%",   14, "bg-red-500/70",     "dot"),
        new("c5",  "10%", "72%",  -24, "bg-amber-500/70",   "dot"),
        new("c6",  "78%", "8%",    42, "bg-emerald-500/70", "rect"),
        new("c7",  "86%", "24%",  -14, "bg-blue-500/70",    "rect"),
        new("c8",  "90%", "58%",   22, "bg-amber-500/70",   "dot"),
        new("c9",  "82%", "84%",  -36, "bg-red-500/70",     "rect"),
        new("c10", "36%", "4%",     8, "bg-emerald-500/70", "dot"),
        new("c11", "48%", "94%",  -28, "bg-blue-500/70",    "rect"),
        new("c12", "66%", "92%",   18, "bg-amber-500/70",   "dot"),
        new("c13", "60%", "2%",   -22, "bg-red-500/70",     "rect"),
        new("c14", "28%", "54%",   30, "bg-emerald-500/70", "dot"),
    ];
}
