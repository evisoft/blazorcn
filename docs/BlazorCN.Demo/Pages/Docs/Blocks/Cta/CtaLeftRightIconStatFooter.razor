@* ============================================================
   Block: cta-left-right-icon-stat-footer
   Title: CtaLeftRightIconStatFooter
   Description: A compact left-right dark CTA section for React and Next.js with an icon-led headline pair, right-aligned inverted primary ShadcnioButton, and a pipe-separated stat footer strip (demonstrated with a GitHub Action install) built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-left-right-icon-stat-footer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground px-6 py-8 sm:px-10 sm:py-10">

        <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">

            @* Left side — icon + headline + subtitle *@
            <div class="flex items-start gap-4">
                <div aria-hidden="true" class="mt-0.5 flex size-10 shrink-0 items-center justify-center rounded-lg bg-background/10">
                    <LucideIconCn Name="git-branch" Size="20" Class="size-5 text-background/70" />
                </div>

                <div>
                    <h2 class="font-semibold text-background text-lg leading-tight tracking-tight">
                        Automate with GitHub Actions
                    </h2>
                    <p class="mt-1 max-w-md text-background/50 text-sm">
                        Deploy on every push. Run tests on every PR. Zero configuration, instant CI/CD.
                    </p>
                </div>
            </div>

            @* Right side — CTA button *@
            <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[200px]">
                Add to repository
            </ButtonCn>

        </div>

        @* Stat footer strip *@
        <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-background/10 pt-5">
            @foreach (var stat in _stats)
            {
                var statItem = stat;
                <div class="flex items-center gap-x-4">
                    <span class="text-background/30 text-xs">@statItem.Text</span>
                    @if (statItem.ShowPipe)
                    {
                        <span class="text-background/15">|</span>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record StatItem(string Text, bool ShowPipe);

    private static readonly StatItem[] _stats =
    [
        new("1,200+ repos using this action", true),
        new("Works with Node.js, Python, Go, and Rust", true),
        new("MIT License", false),
    ];
}
