@* ============================================================
   Block: cta-centered-dark-number-with-stats
   Title: CtaCenteredDarkNumberWithStats
   Description: A centered dark CTA for React and Next.js with oversized anchor number, three-stat support row, inverted ShadcnioButton, and uppercase kicker, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-dark-number-with-stats.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground px-6 py-12 text-center sm:px-12 sm:py-16">
        <p class="text-xs font-medium uppercase tracking-widest text-background/60">
            A milestone worth celebrating
        </p>

        <h2 class="mt-4 text-4xl font-semibold tabular-nums tracking-tight text-background sm:text-5xl">
            @_anchorNumber
        </h2>

        <p class="mt-2 text-sm font-medium text-background/70">
            developers trust us to ship faster
        </p>

        <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-background/60">
            From solo founders to Fortune 500 engineering teams, our platform powers production
            applications at every scale.
        </p>

        <div class="mt-8 flex items-center justify-center gap-8 sm:gap-12">
            @foreach (var stat in _stats)
            {
                <div class="text-center">
                    <span class="text-lg font-semibold tabular-nums text-background">
                        @stat.Value
                    </span>
                    <p class="mt-0.5 text-xs text-background/40">@stat.Label</p>
                </div>
            }
        </div>

        <div class="mt-8">
            <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[215px]">
                Join the community
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private const string _anchorNumber = "10,000+";

    private record Stat(string Value, string Label);

    private static readonly Stat[] _stats =
    [
        new("99.9%", "Uptime"),
        new("140+", "Countries"),
        new("4.9/5", "Rating"),
    ];
}
