@* ============================================================
   Block: cta-compact-dark-digit-countdown
   Title: CtaCompactDarkDigitCountdown
   Description: A compact dark digit countdown CTA strip for React and Next.js with an eyebrow pill, single-line headline, four-cell monospace timer row with colon separators, and right-pinned inverted ShadcnioButton built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-compact-dark-digit-countdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="flex flex-col items-start gap-4 overflow-hidden rounded-xl bg-foreground px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6">

        @* Left — eyebrow pill + headline *@
        <div class="min-w-0">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-background/15 bg-background/5 px-2.5 py-0.5 font-semibold text-[10px] text-background/70 tracking-[0.14em] uppercase">
                <span class="size-1.5 rounded-full bg-red-500"></span>
                Limited time
            </span>
            <h2 class="mt-1.5 font-semibold text-background text-sm leading-tight sm:text-base">
                Early pricing ends soon
            </h2>
        </div>

        @* Center — timer cells *@
        <div class="flex shrink-0 items-center gap-1.5">
            @foreach (var cell in _timer)
            {
                var isLast = cell == _timer[_timer.Length - 1];
                <div class="contents">
                    <div class="rounded-md border border-background/15 bg-background/5 px-3 py-2 text-center">
                        <div class="font-mono font-semibold tabular-nums text-2xl text-background leading-none">
                            @cell.Value
                        </div>
                        <div class="mt-1 font-medium text-[10px] text-background/40 tracking-[0.12em] uppercase">
                            @cell.Label
                        </div>
                    </div>
                    @if (!isLast)
                    {
                        <span aria-hidden="true" class="font-mono font-semibold text-background/30 text-xl">:</span>
                    }
                </div>
            }
        </div>

        @* Right — single primary action *@
        <ButtonCn Size="ButtonSize.Sm" Class="w-full shrink-0 bg-background text-foreground hover:bg-background/90 sm:w-[140px]">
            Claim offer
        </ButtonCn>
    </div>
</section>

@code {
    private record TimerCell(string Value, string Label);

    private static readonly TimerCell[] _timer =
    [
        new("02", "Days"),
        new("14", "Hrs"),
        new("32", "Min"),
        new("18", "Sec"),
    ];
}
