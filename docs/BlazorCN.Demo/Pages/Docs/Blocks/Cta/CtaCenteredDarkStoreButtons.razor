@* ============================================================
   Block: cta-centered-dark-store-buttons
   Title: CtaCenteredDarkStoreButtons
   Description: A centered dark CTA for React and Next.js with dual ShadcnioButton store actions, star rating trust cluster, and uppercase platform kicker, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-dark-store-buttons.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground px-6 py-12 text-center sm:px-12 sm:py-16">
        <p class="text-xs font-medium uppercase tracking-widest text-background/60">
            Now on iOS and Android
        </p>

        <h2 class="mx-auto mt-4 max-w-xl text-3xl font-semibold tracking-tight text-background sm:text-4xl">
            Take your workspace everywhere
        </h2>

        <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-background/60">
            Ship from anywhere with the full power of your dashboard in your pocket. Free to download
            and works offline.
        </p>

        <div class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
            <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[180px]">
                App Store
            </ButtonCn>
            <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[185px]">
                Google Play
            </ButtonCn>
        </div>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
            <div class="flex">
                @for (int i = 0; i < 5; i++)
                {
                    <LucideIconCn Name="star" Size="16" Class="size-4 fill-amber-400 text-amber-400" />
                }
            </div>
            <span class="text-sm font-medium text-background">@_rating.Score / 5</span>
            <span class="text-sm text-background/50">from @_rating.ReviewCount</span>
        </div>
    </div>
</section>

@code {
    private static readonly RatingInfo _rating = new("4.9", "12,000+ ratings");

    private record RatingInfo(string Score, string ReviewCount);
}
