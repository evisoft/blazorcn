@* ============================================================
   Block: cta-centered-light-tier-selector
   Title: CtaCenteredLightTierSelector
   Description: A centered light CTA section for React and Next.js with icon accent, tier pill selector, dynamic ShadcnioButton label, and avatar stack with count footer (demonstrated with an open source sponsorship) built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-light-tier-selector.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card px-6 py-12 text-center sm:px-12 sm:py-14">
        <div aria-hidden="true" class="mx-auto flex size-12 items-center justify-center rounded-full bg-muted">
            <LucideIconCn Name="heart" Size="20" Class="size-5 text-muted-foreground" />
        </div>

        <h2 class="mx-auto mt-5 max-w-md font-semibold text-3xl leading-tight tracking-tight sm:text-4xl">
            Fund open source.
            <br />
            Keep it free for everyone.
        </h2>

        <p class="mx-auto mt-4 max-w-lg text-muted-foreground text-sm leading-relaxed">
            Your sponsorship funds development, infrastructure, and documentation. Every contribution
            helps us stay independent and ship faster.
        </p>

        @* Tier selector *@
        <div class="mx-auto mt-8 flex flex-wrap items-center justify-center gap-2">
            @foreach (var tier in _tiers)
            {
                var t = tier;
                <button
                    aria-pressed="@(_selectedTier == t.Amount ? "true" : "false")"
                    class="@Cn.Merge("rounded-full px-5 py-2 font-medium text-sm tabular-nums transition-colors", _selectedTier == t.Amount ? "bg-foreground text-background" : "bg-muted text-muted-foreground hover:bg-muted/80")"
                    type="button"
                    @onclick="@(() => _selectedTier = t.Amount)">
                    @t.Label
                </button>
            }
        </div>

        @* Sponsor button *@
        <div class="mt-8 flex justify-center">
            <ButtonCn Class="w-full sm:w-[245px]">Sponsor for $@(_selectedTier)/month</ButtonCn>
        </div>

        @* Social proof *@
        <div class="mt-8 flex flex-col items-center gap-3">
            <div aria-hidden="true" class="flex -space-x-2">
                @foreach (var supporter in _supporters)
                {
                    <div class="flex size-8 items-center justify-center rounded-full border-2 border-background bg-muted font-medium text-[10px] text-muted-foreground">
                        @supporter.Initials
                    </div>
                }
                <div class="flex size-8 items-center justify-center rounded-full border-2 border-background bg-muted font-medium text-[10px] text-muted-foreground">
                    +137
                </div>
            </div>
            <p class="text-muted-foreground text-xs">142 sponsors &middot; $2,400/mo raised</p>
        </div>
    </div>
</section>

@code {
    private int _selectedTier = 10;

    private record Tier(int Amount, string Label);
    private record Supporter(string Initials, string Name);

    private static readonly Tier[] _tiers =
    [
        new(5,  "$5/mo"),
        new(10, "$10/mo"),
        new(25, "$25/mo"),
        new(50, "$50/mo"),
    ];

    private static readonly Supporter[] _supporters =
    [
        new("JD", "Jane D."),
        new("MK", "Mike K."),
        new("AR", "Alice R."),
        new("TS", "Tom S."),
        new("LW", "Lisa W."),
    ];
}
