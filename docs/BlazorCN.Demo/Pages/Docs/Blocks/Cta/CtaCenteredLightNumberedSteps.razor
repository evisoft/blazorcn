@* ============================================================
   Block: cta-centered-light-numbered-steps
   Title: CtaCenteredLightNumberedSteps
   Description: A centered light CTA for React and Next.js with uppercase kicker, three numbered-circle setup steps, a primary ShadcnioButton, and a trust row, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-light-numbered-steps.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl border bg-card px-6 py-12 text-center sm:px-12 sm:py-16">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Get started in 3 steps
        </p>

        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
            From zero to production in minutes
        </h2>

        <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-muted-foreground">
            No complex configuration. No hidden steps. Just a fast path from signup to a live
            deployment.
        </p>

        <div class="mx-auto mt-8 grid max-w-2xl gap-6 sm:grid-cols-3">
            @foreach (var step in _steps)
            {
                <div class="text-center">
                    <span class="mx-auto flex size-8 items-center justify-center rounded-full bg-foreground text-xs font-semibold tabular-nums text-background">
                        @step.Number
                    </span>
                    <h3 class="mt-3 text-sm font-medium text-foreground">@step.Title</h3>
                    <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
                        @step.Description
                    </p>
                </div>
            }
        </div>

        <div class="mt-8">
            <ButtonCn Class="w-full sm:w-[200px]">Start building</ButtonCn>
        </div>

        <p class="mt-4 text-xs text-muted-foreground">
            Free tier available &middot; No credit card required
        </p>
    </div>
</section>

@code {
    private record Step(int Number, string Title, string Description);

    private static readonly Step[] _steps =
    [
        new(1, "Create your account", "Sign up with your email or GitHub. Takes less than 30 seconds."),
        new(2, "Connect your repo", "Import an existing project or start from one of our templates."),
        new(3, "Deploy to production", "Push to main and your site goes live. Zero config required."),
    ];
}
