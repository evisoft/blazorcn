@* ============================================================
   Block: cta-compact-segmented-tab-control
   Title: CtaCompactSegmentedTabControl
   Description: A compact segmented tab control banner CTA for React and Next.js with interactive three-way plan toggle, dynamic price label, and right-aligned small ShadcnioButton built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-compact-segmented-tab-control.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="flex flex-col gap-4 rounded-xl border bg-card px-5 py-4 md:flex-row md:items-center">

        @* Left cluster — headline + dynamic price *@
        <div class="flex min-w-0 flex-1 flex-col gap-0.5">
            <h2 class="text-base font-semibold text-foreground sm:text-lg">
                Ready to upgrade? Pick your plan
            </h2>
            <p class="flex items-baseline gap-1 text-xs text-muted-foreground">
                <span>From</span>
                <span aria-live="polite" class="text-sm font-semibold tabular-nums text-foreground">
                    @_activePlan.Price
                </span>
                <span class="text-foreground/60">@_activePlan.Cadence</span>
                <span class="hidden sm:inline">· billed as @_activePlan.Label.ToLower()</span>
            </p>
        </div>

        @* Center — segmented 3-tab control *@
        <div aria-label="Choose billing cadence" class="flex gap-1 rounded-lg bg-muted/50 p-1" role="group">
            @foreach (var option in _plans)
            {
                var opt = option;
                var isActive = opt.Value == _plan;
                <button
                    aria-pressed="@isActive.ToString().ToLower()"
                    class="@Cn.Merge("rounded-md px-3 py-1.5 text-xs font-medium transition-all", isActive ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                    type="button"
                    @onclick="@(() => SetPlan(opt.Value))">
                    @opt.Label
                </button>
            }
        </div>

        @* Right — primary action *@
        <ButtonCn Class="w-full md:w-[140px]" Size="ButtonSize.Sm">Upgrade</ButtonCn>

    </div>
</section>

@code {
    private record Plan(string Value, string Label, string Price, string Cadence);

    private static readonly Plan[] _plans =
    [
        new("monthly",   "Monthly",   "$19", "/mo"),
        new("quarterly", "Quarterly", "$15", "/mo"),
        new("yearly",    "Yearly",    "$12", "/mo"),
    ];

    private string _plan = "monthly";

    private Plan _activePlan => Array.Find(_plans, p => p.Value == _plan) ?? _plans[0];

    private void SetPlan(string value) => _plan = value;
}
