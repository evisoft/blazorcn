@* ============================================================
   Block: cta-centered-dark-stat-strip
   Title: CtaCenteredDarkStatStrip
   Description: A centered dark CTA for React and Next.js with headline, three-stat horizontal strip, dual ShadcnioButton row, and trust row, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-dark-stat-strip.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl bg-foreground px-8 py-10 text-center sm:px-12 sm:py-14">
        <h2 class="mx-auto max-w-lg text-3xl font-semibold tracking-tight text-background sm:text-4xl">
            Analytics that respect your users and your time
        </h2>

        <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-background/60">
            Privacy-first, lightweight, and blazing fast. One script tag to understand everything
            about your product.
        </p>

        <div class="mx-auto mt-8 flex max-w-sm flex-wrap items-center justify-center gap-6">
            @foreach (var stat in _stats)
            {
                <div class="text-center">
                    <div class="text-xl font-semibold tabular-nums text-background">@stat.Value</div>
                    <div class="mt-0.5 text-xs text-background/50">@stat.Label</div>
                </div>
            }
        </div>

        <div class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
            <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[210px]">
                Start tracking free
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[195px]">
                View live demo
            </ButtonCn>
        </div>

        <p class="mt-6 text-xs text-background/40">
            No cookie banner required &middot; GDPR &amp; CCPA compliant &middot; Open source
        </p>
    </div>
</section>

@code {
    private record Stat(string Value, string Label);

    private static readonly Stat[] _stats =
    [
        new("50ms", "Avg. latency"),
        new("99.9%", "Uptime SLA"),
        new("5 min", "Setup time"),
    ];
}
