@* ============================================================
   Block: cta-card-inset-benefits-stack
   Title: CtaCardInsetBenefitsStack
   Description: A card-inset dark CTA for React and Next.js with outer light panel, inner dark card, icon medallion, emerald check benefits list, headline stat, and dual ShadcnioButton row, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-card-inset-benefits-stack.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div class="rounded-2xl border bg-card p-3 sm:p-4">
    <div class="overflow-hidden rounded-xl bg-foreground px-6 py-12 text-center sm:px-10 sm:py-16">
      <div class="mx-auto flex size-10 items-center justify-center rounded-full bg-background/10">
        <LucideCloudCn Size="20" Class="size-5 text-background/70" />
      </div>

      <h2 class="mt-5 text-3xl font-semibold tracking-tight text-background sm:text-4xl">
        Stop managing servers.
        <br />
        Start shipping faster.
      </h2>

      <p class="mx-auto mt-3 max-w-md text-sm text-background/60 leading-relaxed">
        Migrate to our managed cloud in minutes. We handle infrastructure so you can focus on
        building.
      </p>

      <div class="mx-auto mt-8 flex max-w-md flex-col items-start gap-2.5">
        @foreach (var benefit in _benefits)
        {
          <div class="flex items-center gap-2.5">
            <LucideCheckCn Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
            <span class="text-sm text-background/80">@benefit</span>
          </div>
        }
      </div>

      <div class="mt-6 flex items-baseline justify-center gap-1.5">
        <span class="text-2xl font-semibold tabular-nums text-background">15</span>
        <span class="text-sm text-background/40">min avg migration</span>
      </div>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[200px]">
          Start migration
        </ButtonCn>
        <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[185px]">
          Compare plans
        </ButtonCn>
      </div>

      <p class="mt-5 text-xs text-background/30">
        Free migration support &middot; No downtime
      </p>
    </div>
  </div>
</section>

@code {
  private static readonly string[] _benefits =
  [
    "Automatic backups & disaster recovery",
    "Zero-downtime updates & patching",
    "Global edge network with 99.99% SLA",
  ];
}
