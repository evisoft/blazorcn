@* ============================================================
   Block: cta-centered-dark-metric-cluster
   Title: CtaCenteredDarkMetricCluster
   Description: A centered dark CTA section for React and Next.js with large metric cluster (icon tile plus oversized tabular number), announcement badge, headline, and inverted primary ShadcnioButton built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-dark-metric-cluster.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground px-6 py-16 text-center sm:px-12">
        <BadgeCn Class="border-0 bg-background/10 font-normal text-background/70 text-xs">
            @_badgeLabel
        </BadgeCn>

        <div class="mt-8 flex items-center justify-center gap-3">
            <div aria-hidden="true"
                 class="flex size-10 items-center justify-center rounded-lg bg-background/10">
                <LucideIconCn Name="arrow-up" Size="20" Class="size-5 text-background" />
            </div>
            <span class="font-semibold text-5xl text-background tabular-nums">
                @_metricValue.ToString("N0")
            </span>
        </div>

        <p class="mt-2 text-background/40 text-xs">@_metricLabel</p>

        <h2 class="mx-auto mt-8 max-w-md font-semibold text-2xl text-background tracking-tight sm:text-3xl">
            Help us reach #1 Product of the Day
        </h2>

        <p class="mx-auto mt-3 max-w-sm text-background/50 text-sm leading-relaxed">
            Your upvote helps us reach more developers and keeps the momentum going. It takes 10
            seconds.
        </p>

        <div class="mt-8 flex justify-center">
            <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[260px]">
                Support on Product Hunt
            </ButtonCn>
        </div>

        <p class="mt-6 text-background/30 text-xs">@_rankLine</p>
    </div>
</section>

@code {
    private const int _metricValue = 847;
    private const string _metricLabel = "upvotes and counting";
    private const string _badgeLabel = "Live on Product Hunt";
    private const string _rankLine = "Currently #3 Product of the Day";
}
