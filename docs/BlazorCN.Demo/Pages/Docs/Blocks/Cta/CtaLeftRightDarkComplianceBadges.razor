@* ============================================================
   Block: cta-left-right-dark-compliance-badges
   Title: CtaLeftRightDarkComplianceBadges
   Description: A left right dark CTA section for React and Next.js with a shield icon headline cluster, uppercase compliance badge row, and dual inverted ShadcnioButton actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-left-right-dark-compliance-badges.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="flex flex-col gap-6 rounded-2xl bg-foreground px-6 py-8 md:flex-row md:items-center md:justify-between md:px-10">

        @* Left — headline cluster + compliance row *@
        <div class="flex items-start gap-4">
            <div aria-hidden="true"
                 class="flex size-10 shrink-0 items-center justify-center rounded-lg border border-background/15 bg-background/5">
                <LucideIconCn Name="shield-check" Size="20" Class="size-5 text-background" />
            </div>
            <div class="min-w-0">
                <h2 class="text-xl font-semibold tracking-tight text-background sm:text-2xl">
                    Enterprise-grade security
                </h2>
                <p class="mt-1.5 max-w-md text-sm text-background/60">
                    Your data is encrypted at rest and in transit. Independently audited every quarter.
                </p>
                <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
                    @foreach (var badge in _badges)
                    {
                        <span class="text-[10px] font-bold uppercase tracking-[0.12em] text-background/50">
                            @badge
                        </span>
                    }
                </div>
            </div>
        </div>

        @* Right — dual action buttons *@
        <div class="flex shrink-0 flex-col gap-3 sm:flex-row sm:items-center">
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[180px]">
                Contact sales
            </ButtonCn>
            <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[170px]">
                Security page
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private static readonly string[] _badges = ["SOC 2 Type II", "GDPR", "HIPAA", "ISO 27001"];
}
