@* ============================================================
   Block: cta-centered-dark-testimonial-quote
   Title: CtaCenteredDarkTestimonialQuote
   Description: A centered dark CTA with testimonial quote for React and Next.js with inset quote icon, customer attribution row, and inverted ShadcnioButton, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-centered-dark-testimonial-quote.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground px-6 py-12 sm:px-12 sm:py-14">
        <div class="mx-auto max-w-2xl text-center">
            <LucideIconCn Name="quote" Size="28" Class="mx-auto size-7 text-background/25" aria-hidden="true" />

            <blockquote class="mt-6">
                <p class="text-lg font-semibold leading-relaxed text-background sm:text-xl">
                    @_testimonial.Quote
                </p>
            </blockquote>

            <div class="mt-6 flex items-center justify-center gap-3">
                <div aria-hidden="true" class="size-9 shrink-0 rounded-full bg-background/10"></div>
                <div class="text-left">
                    <p class="text-sm font-semibold text-background">@_testimonial.Name</p>
                    <p class="text-xs text-background/50">@_testimonial.Role</p>
                </div>
            </div>

            <div class="mt-8">
                <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[200px]">
                    Start building
                </ButtonCn>
            </div>

            <p class="mt-4 text-xs text-background/35">
                Trusted by 2,000+ engineering teams worldwide
            </p>
        </div>
    </div>
</section>

@code {
    private record TestimonialData(string Quote, string Name, string Role);

    private static readonly TestimonialData _testimonial = new(
        "We shipped our entire design system in two weeks. The component quality matched what our senior engineers would build from scratch.",
        "Sarah Chen",
        "Engineering Lead, Vercel"
    );
}
