<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl border bg-card px-6 py-12 text-center sm:px-10 sm:py-14">

        <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
            Public Roadmap
        </span>

        <h2 class="mx-auto mt-3 max-w-lg text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
            See what we're building next
        </h2>

        <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
            Our roadmap is public. Explore upcoming features, vote on priorities, and shape the
            product with us.
        </p>

        <ButtonCn Class="mt-8 w-full sm:w-[175px]">View roadmap</ButtonCn>

        <div class="mt-4">
            <a class="inline-flex items-center gap-1 text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
               href="/changelog">
                Read the changelog &rarr;
            </a>
        </div>

    </div>
</section>
