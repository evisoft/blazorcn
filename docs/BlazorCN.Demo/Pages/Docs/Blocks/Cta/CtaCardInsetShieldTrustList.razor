@* ============================================================
   Block: cta-card-inset-shield-trust-list
   Title: CtaCardInsetShieldTrustList
   Description: A card inset dark CTA section for React and Next.js with shield icon focal, trust checklist, inverted primary ShadcnioButton, and outer light wrapper built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-card-inset-shield-trust-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-3xl bg-muted/40 p-4 sm:p-6">
        <div class="mx-auto max-w-2xl rounded-2xl bg-foreground px-6 py-12 text-center sm:px-12 sm:py-16">
            <div class="flex justify-center">
                <span class="flex size-12 items-center justify-center rounded-full border border-background/15 bg-background/5">
                    <LucideIconCn Name="shield-check" Size="24" Class="size-6 text-background" aria-hidden="true" />
                </span>
            </div>

            <h2 class="mx-auto mt-6 max-w-md text-3xl font-semibold tracking-tight text-background sm:text-4xl">
                30-day money-back guarantee
            </h2>

            <p class="mx-auto mt-4 max-w-sm text-base leading-relaxed text-background/60">
                Try it completely risk-free. Not the right fit? Get a full refund, no questions asked.
            </p>

            <ul class="mx-auto mt-8 max-w-sm space-y-3 text-left">
                @foreach (var item in _trustItems)
                {
                    <li class="flex items-start gap-3">
                        <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-background/10">
                            <LucideIconCn Name="check" Size="12" Class="size-3 stroke-[3] text-emerald-400" />
                        </span>
                        <span class="text-sm text-background/80">@item</span>
                    </li>
                }
            </ul>

            <div class="mt-8 flex justify-center">
                <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[200px]">
                    Start risk-free
                </ButtonCn>
            </div>

            <p class="mt-4 text-xs text-background/30">
                Over 50,000 customers &middot; Less than 2% refund rate
            </p>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _trustItems =
    [
        "Full refund within 30 days, no questions asked",
        "Cancel anytime in one click from your dashboard",
        "Keep all data exports even after cancellation",
    ];
}
