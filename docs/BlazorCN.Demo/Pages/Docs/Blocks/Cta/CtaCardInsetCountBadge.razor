   Block: cta-card-inset-count-badge
   Title: CtaCardInsetCountBadge
   Description: A card-inset dark CTA for React and Next.js with a count-badge above the headline, inverted primary ShadcnioButton, and light outer frame built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-card-inset-count-badge.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-3xl bg-muted/40 p-4 sm:p-6">
        <div class="rounded-2xl bg-foreground px-6 py-12 text-center sm:px-12 sm:py-16">
            <BadgeCn Class="mb-5 bg-background text-foreground hover:bg-background/90">
                @_count open positions
            </BadgeCn>

            <h2 class="mx-auto max-w-xl text-3xl font-semibold tracking-tight text-background sm:text-4xl">
                We&apos;re hiring
            </h2>

            <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-background/60">
                Join a team of engineers, designers, and researchers building tools used by thousands of
                developers worldwide.
            </p>

            <div class="mt-8 flex justify-center">
                <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[200px]">
                    View open roles
                </ButtonCn>
            </div>

            <p class="mt-4 text-xs text-background/35">
                Remote friendly &middot; Full benefits &middot; Async first
            </p>
        </div>
    </div>
</section>

@code {
    private const int _count = 12;
}
