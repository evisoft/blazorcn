@* ============================================================
   Block: cta-split-panel-avatar-team
   Title: CtaSplitPanelAvatarTeam
   Description: A split panel dark CTA section for React and Next.js with left-side headline and benefit checklist, right-side team avatar stack, inverted primary ShadcnioButton, and trust row built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-split-panel-avatar-team.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground">
        <div class="grid grid-cols-1 lg:grid-cols-2">

            @* Left — copy + checklist *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 sm:py-14">
                <p class="font-medium text-background/50 text-xs uppercase tracking-widest">
                    Free consultation
                </p>

                <h2 class="mt-4 font-semibold text-3xl text-background leading-tight tracking-tight sm:text-4xl">
                    Talk to an expert.
                    <br />
                    Ship with confidence.
                </h2>

                <p class="mt-4 max-w-md text-background/60 text-sm leading-relaxed">
                    Book a 30-minute session with one of our senior engineers. We will review your project
                    and recommend the best path forward.
                </p>

                <ul class="mt-6 flex flex-col gap-2.5">
                    @foreach (var benefit in _benefits)
                    {
                        <li class="flex items-start gap-2.5">
                            <span class="mt-0.5 flex size-4 shrink-0 items-center justify-center rounded-full bg-background/10">
                                <LucideIconCn Name="check" Size="10" Class="size-2.5 stroke-[3] text-background/80" />
                            </span>
                            <span class="text-background/80 text-sm">@benefit</span>
                        </li>
                    }
                </ul>

                <div class="mt-8">
                    <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[215px]">
                        Book a session
                    </ButtonCn>
                </div>

                <div class="mt-6 flex flex-wrap items-center gap-4">
                    @foreach (var signal in _trustSignals)
                    {
                        var sig = signal;
                        <span class="flex items-center gap-1.5 text-background/40 text-xs">
                            <LucideIconCn Name="@sig.Icon" Size="12" Class="size-3" />
                            @sig.Label
                        </span>
                    }
                </div>
            </div>

            @* Right — team avatar stack *@
            <div aria-hidden="true" class="hidden items-center justify-center bg-background/5 lg:flex">
                <div class="flex flex-col items-center gap-4 px-12 py-14">
                    <div class="flex -space-x-2">
                        @foreach (var member in _team)
                        {
                            var mem = member;
                            <div class="flex size-10 items-center justify-center rounded-full border-2 border-foreground bg-background/10 font-medium text-background/60 text-xs"
                                 style="@($"z-index:{_team.Length - System.Array.IndexOf(_team, mem)}")">
                                @mem.Initials
                            </div>
                        }
                    </div>
                    <p class="text-center text-background/30 text-sm">
                        Our engineering team has
                        <br />
                        helped 500+ companies ship faster.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private record TeamMember(string Initials, string Name);
    private record TrustSignal(string Icon, string Label);

    private static readonly string[] _benefits =
    [
        "Expert architecture review of your current stack",
        "Personalized migration roadmap and timeline",
        "Performance bottleneck identification",
        "No obligation — actionable insights guaranteed",
    ];

    private static readonly TeamMember[] _team =
    [
        new("EW", "Emma W."),
        new("SK", "Sarah K."),
        new("AR", "Alex R."),
        new("ML", "Marcus L."),
    ];

    private static readonly TrustSignal[] _trustSignals =
    [
        new("users", "500+ sessions booked"),
        new("clock", "30 min, free"),
        new("shield-check", "NDA available"),
    ];
}
