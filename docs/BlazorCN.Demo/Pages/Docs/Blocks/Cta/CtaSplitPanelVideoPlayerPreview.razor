@* ============================================================
   Block: cta-split-panel-video-player-preview
   Title: CtaSplitPanelVideoPlayerPreview
   Description: A split panel dark CTA section for React and Next.js with a video player preview on the right, eyebrow label plus headline on the left, a bulleted feature trio, and an inverted primary ShadcnioButton built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-split-panel-video-player-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground">
        <div class="grid gap-8 px-6 py-10 md:grid-cols-2 md:items-center md:gap-12 md:px-12 md:py-12">

            @* Left — copy *@
            <div>
                <p class="text-xs font-medium uppercase tracking-wider text-background/50">
                    Product demo
                </p>

                <h2 class="mt-3 text-3xl font-semibold tracking-tight text-background sm:text-4xl">
                    See the platform in action.
                </h2>

                <p class="mt-4 max-w-md text-base text-background/60 leading-relaxed">
                    Watch how teams ship 10&times; faster with zero-config deployments, instant previews, and
                    real-time collaboration.
                </p>

                <ul class="mt-6 flex flex-col gap-2.5">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-center gap-2.5 text-sm text-background/70">
                            <span class="size-1 shrink-0 rounded-full bg-background/40"></span>
                            @feature
                        </li>
                    }
                </ul>

                <ButtonCn Class="mt-8 w-full bg-background text-foreground hover:bg-background/90 sm:w-[175px]">
                    Watch demo
                </ButtonCn>
            </div>

            @* Right — video player preview *@
            <div aria-hidden="true" class="relative">
                <div class="relative flex aspect-video w-full items-center justify-center overflow-hidden rounded-xl border border-background/10 bg-background/[0.06]">
                    @* Decorative scanline *@
                    <div class="absolute inset-x-6 top-6 h-px bg-background/10"></div>
                    <div class="absolute inset-x-6 bottom-6 h-px bg-background/10"></div>

                    @* Play control *@
                    <div class="flex size-16 items-center justify-center rounded-full border border-background/15 bg-background/10">
                        <LucideIconCn Name="play" Size="24" Class="ml-1 size-6 text-background" />
                    </div>

                    @* Duration chip *@
                    <span class="absolute right-3 bottom-3 rounded-md border border-background/15 bg-background/10 px-2 py-0.5 font-mono text-xs text-background/70">
                        @_duration
                    </span>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private const string _duration = "3:42";

    private static readonly string[] _features =
    [
        "Deploy in under 60 seconds",
        "Automatic scaling and rollbacks",
        "Built-in observability and logs",
    ];
}
