@* ============================================================
   Block: cta-split-before-after-list
   Title: CtaSplitBeforeAfterList
   Description: A split dark CTA for React and Next.js with a two-column before after list using X and check icons, dual ShadcnioButton row, and centered headline built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-split-before-after-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl bg-foreground px-6 py-12 sm:px-12 sm:py-14">
        <h2 class="text-center text-3xl font-semibold tracking-tight text-background sm:text-4xl">
            Stop shipping broken code
        </h2>

        <div class="mx-auto mt-10 grid max-w-2xl gap-8 sm:grid-cols-2">
            <div>
                <span class="text-xs font-medium uppercase tracking-wider text-background/40">
                    Without us
                </span>
                <ul class="mt-3 space-y-3">
                    @foreach (var item in _beforeItems)
                    {
                        <li class="flex items-start gap-2.5">
                            <LucideIconCn Name="x" Size="16" Class="mt-0.5 size-4 shrink-0 text-red-400" aria-hidden="true" />
                            <span class="text-sm leading-snug text-background/70">@item</span>
                        </li>
                    }
                </ul>
            </div>

            <div>
                <span class="text-xs font-medium uppercase tracking-wider text-background/40">
                    With us
                </span>
                <ul class="mt-3 space-y-3">
                    @foreach (var item in _afterItems)
                    {
                        <li class="flex items-start gap-2.5">
                            <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-500 dark:text-emerald-400" aria-hidden="true" />
                            <span class="text-sm leading-snug text-background/70">@item</span>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <div class="mt-10 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
            <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[195px]">
                Start for free
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[170px]">
                See a demo
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _beforeItems =
    [
        "Manual reviews that take days",
        "Inconsistent standards across teams",
        "Bugs caught in production, not PRs",
    ];

    private static readonly string[] _afterItems =
    [
        "Automated feedback in seconds",
        "One config, every repo enforced",
        "Issues flagged before they merge",
    ];
}
