@* ============================================================
   Block: cta-card-inset-notification-toast-preview
   Title: CtaCardInsetNotificationToastPreview
   Description: A card-inset notification toast preview CTA for React and Next.js with floating toast mockup, app icon square, sender title, message snippet, timestamp, dismiss control, and centered primary ShadcnioButton built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-card-inset-notification-toast-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-8">

        @* Toast mockup — the visual hero *@
        <div aria-hidden="true"
             class="mx-auto flex max-w-sm items-start gap-3 rounded-xl border bg-background p-4 shadow-md">

            @* App icon square *@
            <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-foreground">
                <LucideIconCn Name="bell" Size="20" Class="size-5 text-background" />
            </div>

            @* Title + message *@
            <div class="flex min-w-0 flex-1 flex-col gap-0.5">
                <div class="flex items-center gap-1.5 text-xs">
                    <span class="font-semibold text-foreground">@_toast.SenderName</span>
                    <span class="text-muted-foreground">· @_toast.AppName</span>
                </div>
                <p class="truncate text-xs text-muted-foreground">@_toast.Message</p>
            </div>

            @* Timestamp + dismiss *@
            <div class="flex shrink-0 items-start gap-2">
                <span class="text-[10px] text-muted-foreground tabular-nums">
                    @_toast.Timestamp
                </span>
                <span class="flex size-4 items-center justify-center rounded text-muted-foreground"
                      tabindex="-1">
                    <LucideIconCn Name="x" Size="12" Class="size-3" />
                </span>
            </div>
        </div>

        @* Headline *@
        <h2 class="mx-auto mt-8 max-w-md text-center text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
            Never miss what matters
        </h2>

        @* Subtext *@
        <p class="mx-auto mt-3 max-w-md text-center text-sm text-muted-foreground leading-relaxed">
            Realtime mentions, DMs, and alerts from every tool your team lives in — delivered in one
            calm inbox.
        </p>

        @* Primary CTA *@
        <div class="mt-7 flex justify-center">
            <ButtonCn Class="w-full sm:w-[195px]">Start for free</ButtonCn>
        </div>

        @* Trust text *@
        <p class="mt-4 text-center text-xs text-muted-foreground">
            Free forever · No credit card required
        </p>
    </div>
</section>

@code {
    private sealed record Toast(string AppName, string SenderName, string Message, string Timestamp);

    private static readonly Toast _toast = new(
        AppName: "Slack",
        SenderName: "Sarah Chen",
        Message: "mentioned you in #design — “Hey can you review the new onboarding flow?”",
        Timestamp: "2m"
    );
}
