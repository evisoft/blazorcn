@* ============================================================
   Block: cta-split-benefits-visual
   Title: CtaSplitBenefitsVisual
   Description: A split panel dark CTA for React and Next.js with uppercase kicker, checkmark benefits list, inverted ShadcnioButton, and right-side visual panel, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/cta/cta-split-benefits-visual.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl bg-foreground">
        <div class="grid items-center md:grid-cols-2">

            @* Left — copy *@
            <div class="px-8 py-10 sm:px-10 sm:py-12">
                <p class="text-sm font-medium uppercase tracking-widest text-background/60">
                    Affiliate program
                </p>

                <h2 class="mt-4 text-2xl font-semibold tracking-tight text-background sm:text-3xl">
                    Earn while you share what you love
                </h2>

                <ul class="mt-6 space-y-3">
                    @foreach (var benefit in _benefits)
                    {
                        <li class="flex items-start gap-2.5">
                            <span class="mt-0.5 flex size-4 shrink-0 items-center justify-center rounded-full bg-background/10">
                                <LucideIconCn Name="check" Size="10" Class="size-2.5 text-background/70" />
                            </span>
                            <span class="text-sm text-background/80">@benefit</span>
                        </li>
                    }
                </ul>

                <ButtonCn Class="mt-8 w-full bg-background text-foreground hover:bg-background/90 sm:w-[180px]">
                    Apply to join
                </ButtonCn>
            </div>

            @* Right — decorative visual *@
            <div aria-hidden="true" class="px-8 pb-10 md:px-0 md:py-10 md:pb-0 md:pr-8">
                <div class="flex aspect-[4/3] w-full items-center justify-center rounded-xl bg-background/[0.06]">
                    <div class="relative flex items-center justify-center">
                        <div class="absolute size-24 rounded-full border border-background/10"></div>
                        <div class="absolute size-14 rounded-full border border-background/15"></div>
                        <div class="absolute h-px w-32 bg-background/10"></div>
                        <div class="absolute h-32 w-px bg-background/10"></div>
                        <div class="flex size-8 items-center justify-center rounded-full border border-background/15 bg-background/10">
                            <LucideIconCn Name="image" Size="16" Class="size-4 text-background/40" />
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private static readonly string[] _benefits =
    [
        "30% recurring commission on every referral",
        "90-day cookie window for attribution",
        "Real-time dashboard with payout tracking",
        "Dedicated partner success manager",
    ];
}
