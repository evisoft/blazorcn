@* ============================================================
   Block: awards-poll-vote
   Title: AwardsPollVote
   Description: Block example: awards
   Source: original/blocks/awards/awards-poll-vote.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-sm p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="trophy" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Vote for Best Product</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">Cast your vote — polls close in 2 days</p>
        </div>

        <div class="divide-y">
            @foreach (var option in _options)
            {
                <div class="px-4 py-3">
                    <button
                        class="@Cn.Merge("w-full text-left", _votedId == option.Id ? "cursor-default" : "cursor-pointer")"
                        @onclick="@(() => Vote(option.Id))"
                        disabled="@(_votedId != null && _votedId != option.Id ? "disabled" : null)">
                        <div class="mb-1.5 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                @if (_votedId == option.Id)
                                {
                                    <LucideIconCn Name="circle-check-big" Size="14" Class="h-3.5 w-3.5 text-primary" />
                                }
                                else
                                {
                                    <LucideIconCn Name="circle" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                                }
                                <span class="text-xs font-medium">@option.Label</span>
                            </div>
                            <span class="text-[10px] text-muted-foreground">@GetPercent(option.Votes)%</span>
                        </div>
                        <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                            <div
                                class="h-full rounded-full bg-primary transition-all duration-500"
                                style="@($"width:{GetPercent(option.Votes)}%")">
                            </div>
                        </div>
                    </button>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="users" Size="12" Class="h-3 w-3 text-muted-foreground" />
                <p class="text-xs text-muted-foreground">@_totalVotes total votes</p>
            </div>
        </div>
    </div>
</section>

@code {
    private record PollOption(string Id, string Label, int Votes);

    private static readonly PollOption[] _options =
    [
        new("opt1", "Acme Analytics Suite",      1482),
        new("opt2", "Nova Design Platform",       937),
        new("opt3", "Apex Developer Toolkit",     753),
        new("opt4", "Zenith Cloud Infrastructure", 401),
    ];

    private string? _votedId;
    private int _totalVotes => _options.Sum(o => o.Votes) + (_votedId != null ? 1 : 0);

    private int GetPercent(int votes)
    {
        var total = _options.Sum(o => o.Votes);
        if (total == 0) return 0;
        return (int)Math.Round(votes / (double)total * 100);
    }

    private void Vote(string id)
    {
        if (_votedId == null)
            _votedId = id;
    }
}
