@* ============================================================
   Block: awards-scoring-panel
   Title: AwardsScoringPanel
   Description: A judge scoring panel block for React and Next.js with criteria rows, judge columns, weighted averages, and score highlighting built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-scoring-panel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="clipboard-list" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Judge Scoring Panel</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Individual scores by criterion with weighted averages
            </p>
        </div>

        @* Scoring table *@
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="border-b">
                        <th class="px-4 py-2.5 text-left text-xs font-medium text-muted-foreground">
                            Criterion
                        </th>
                        @foreach (var judge in _judges)
                        {
                            <th class="px-3 py-2.5 text-center text-xs font-medium text-muted-foreground">
                                @judge
                            </th>
                        }
                        <th class="px-4 py-2.5 text-right text-xs font-medium text-muted-foreground">
                            Weighted
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @for (int rowIdx = 0; rowIdx < _criteria.Length; rowIdx++)
                    {
                        var criterion = _criteria[rowIdx];
                        var highIdx = GetHighestIndex(criterion.Scores);
                        var isLast = rowIdx == _criteria.Length - 1;
                        <tr class="@(isLast ? "" : "border-b")">
                            <td class="px-4 py-2.5">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@criterion.Name</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">@($"{criterion.Weight * 100:F0}%")</BadgeCn>
                                </div>
                            </td>
                            @for (int colIdx = 0; colIdx < criterion.Scores.Length; colIdx++)
                            {
                                var score = criterion.Scores[colIdx];
                                <td class="px-3 py-2.5 text-center">
                                    <span class="@Cn.Merge("font-mono text-sm tabular-nums", colIdx == highIdx ? "font-semibold text-emerald-600 dark:text-emerald-400" : "text-muted-foreground")">
                                        @score
                                    </span>
                                </td>
                            }
                            <td class="px-4 py-2.5 text-right">
                                <span class="font-mono text-sm font-semibold tabular-nums">
                                    @GetWeightedAvg(criterion.Scores, criterion.Weight)
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <span>@(_judges.Length) judges</span>
                <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                <span>@(_criteria.Length) criteria</span>
                <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                <span class="text-emerald-600 dark:text-emerald-400">
                    Highest scores highlighted
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record Criterion(string Id, string Name, double Weight, int[] Scores);

    private static readonly string[] _judges = ["Judge 1", "Judge 2", "Judge 3", "Judge 4"];

    private static readonly Criterion[] _criteria =
    [
        new("1", "Innovation",  0.30, [92, 88, 95, 90]),
        new("2", "Impact",      0.25, [85, 90, 88, 92]),
        new("3", "Design",      0.20, [94, 91, 89, 93]),
        new("4", "Execution",   0.15, [88, 86, 92, 87]),
        new("5", "Scalability", 0.10, [90, 85, 88, 91]),
    ];

    private static string GetWeightedAvg(int[] scores, double weight)
    {
        double avg = scores.Sum() / (double)scores.Length;
        return (avg * weight * 10).ToString("F1");
    }

    private static int GetHighestIndex(int[] scores)
    {
        int max = scores.Max();
        return Array.IndexOf(scores, max);
    }
}
