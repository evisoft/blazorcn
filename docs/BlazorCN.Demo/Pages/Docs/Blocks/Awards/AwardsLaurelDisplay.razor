@* ============================================================
   Block: awards-laurel-display
   Title: AwardsLaurelDisplay
   Description: A film festival laurel wreath awards block for React and Next.js with bordered oval frames, official selection text, festival names, and year displays built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-laurel-display.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Festival Laurels</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Official selections and awards from the festival circuit
            </p>
        </div>

        <div class="grid grid-cols-2 gap-0">
            @for (int i = 0; i < _festivals.Length; i++)
            {
                var fest = _festivals[i];
                var isLastRow = i >= _festivals.Length - 2;
                var isRightCol = i % 2 == 1;
                <div class="@Cn.Merge(!isLastRow ? "border-b" : "", !isRightCol ? "border-r" : "")">
                    <div class="flex items-center justify-center px-4 py-5">
                        <div class="flex flex-col items-center text-center">
                            <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                                @fest.Selection
                            </span>
                            <span class="mt-1.5 rounded-full border px-3 py-1 text-xs font-medium">
                                @fest.Festival
                            </span>
                            <span class="mt-1.5 font-mono text-[10px] text-muted-foreground tabular-nums">
                                @fest.Year
                            </span>
                            @if (fest.IsWinner)
                            {
                                <span class="mt-1 size-1.5 rounded-full bg-amber-500"></span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="flex items-center gap-2 border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                @_winCount wins
            </span>
            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
            <span class="text-xs text-muted-foreground">
                @_selectionCount selections
            </span>
        </div>
    </div>
</section>

@code {
    private record FestivalLaurel(string Id, string Festival, string Selection, string Year, bool IsWinner);

    private static readonly FestivalLaurel[] _festivals =
    [
        new("1", "Sundance Film Festival", "Official Selection",      "2025", false),
        new("2", "Tribeca Film Festival",  "Best Short Film",         "2025", true),
        new("3", "SXSW Film Festival",     "Audience Award",          "2024", true),
        new("4", "Toronto International",  "Official Selection",      "2024", false),
        new("5", "Berlinale Shorts",       "Golden Bear Nominee",     "2024", false),
        new("6", "Cannes Court Metrage",   "Palme d'Or — Short Film", "2025", true),
    ];

    private static readonly int _winCount       = Array.FindAll(_festivals, f => f.IsWinner).Length;
    private static readonly int _selectionCount = Array.FindAll(_festivals, f => !f.IsWinner).Length;
}
