@* ============================================================
   Block: awards-rankings
   Title: AwardsRankings
   Description: Awards section with comparison table showing rankings across platforms
   Source: original/blocks/awards/awards-rankings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Platform Rankings</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                How we compare across review platforms.
            </p>
        </div>

        <div class="grid grid-cols-3 border-b">
            <div class="px-6 py-4 text-center">
                <p class="text-2xl font-semibold tabular-nums">4.8</p>
                <p class="text-xs text-muted-foreground">Avg. rating</p>
            </div>
            <div class="border-x px-6 py-4 text-center">
                <p class="text-2xl font-semibold tabular-nums">2,900+</p>
                <p class="text-xs text-muted-foreground">Total reviews</p>
            </div>
            <div class="px-6 py-4 text-center">
                <p class="text-2xl font-semibold tabular-nums">#1</p>
                <p class="text-xs text-muted-foreground">In category</p>
            </div>
        </div>

        <TableCn>
            <TableHeaderCn>
                <TableRowCn>
                    <TableHeadCn Class="px-6">Platform</TableHeadCn>
                    <TableHeadCn Class="text-center">Rating</TableHeadCn>
                    <TableHeadCn Class="text-center">Reviews</TableHeadCn>
                    <TableHeadCn Class="text-right px-6">Rank</TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var row in _rankings)
                {
                    <TableRowCn>
                        <TableCellCn Class="px-6 text-sm font-medium">@row.Platform</TableCellCn>
                        <TableCellCn Class="text-center">
                            <span class="inline-flex items-center gap-1 text-sm tabular-nums">
                                <LucideIconCn Name="star" Size="12" Class="h-3 w-3 fill-amber-500 text-amber-500" />
                                @row.Rating
                            </span>
                        </TableCellCn>
                        <TableCellCn Class="text-center text-sm tabular-nums text-muted-foreground">
                            @row.Reviews
                        </TableCellCn>
                        <TableCellCn Class="px-6 text-right text-sm font-medium tabular-nums">
                            @row.Rank
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private record RankingRow(string Platform, string Rating, string Reviews, string Rank);

    private static readonly RankingRow[] _rankings =
    [
        new("G2 Crowd", "4.8", "1,200+", "#1"),
        new("Capterra", "4.7", "850+", "#2"),
        new("TrustRadius", "4.9", "320+", "#1"),
        new("GetApp", "4.6", "540+", "#3"),
    ];
}
