@* ============================================================
   Block: awards-badge-wall
   Title: AwardsBadgeWall
   Description: Wall of achievement badges in a dense grid layout for maximum visual impact
   Source: original/blocks/awards/awards-badge-wall.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Wall of Recognition</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                12 awards and certifications earned
            </p>
        </div>

        <div class="grid grid-cols-3 gap-px bg-border sm:grid-cols-4">
            @foreach (var badge in _badges)
            {
                <div class="flex flex-col items-center gap-1.5 bg-card px-3 py-4">
                    <LucideIconCn Name="@badge.Icon" Size="16" Class="h-4 w-4 text-muted-foreground" />
                    <div class="text-center">
                        <p class="text-xs font-medium">@badge.Label</p>
                        <p class="text-[10px] text-muted-foreground">@badge.Org</p>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                Verified by independent organizations worldwide
            </p>
        </div>
    </div>
</section>

@code {
    private record BadgeItem(string Icon, string Label, string Org);

    private static readonly BadgeItem[] _badges =
    [
        new("trophy",       "Product of Year", "TechCrunch"),
        new("star",         "Top Rated",        "G2 2025"),
        new("medal",        "Best Value",        "Capterra"),
        new("shield-check", "SOC 2 Verified",   "AICPA"),
        new("award",        "Leader",            "Forrester"),
        new("crown",        "Category King",     "Gartner"),
        new("trophy",       "Innovation",        "CES 2025"),
        new("star",         "Users Love Us",     "G2 2024"),
        new("medal",        "Best Support",      "TrustRadius"),
        new("shield-check", "ISO 27001",         "BSI"),
        new("award",        "Best UX",           "Webby"),
        new("crown",        "Market Leader",     "IDC"),
    ];
}
