@* ============================================================
   Block: awards-department
   Title: AwardsDepartment
   Description: Department-specific awards showcasing recognition across organizational teams
   Source: original/blocks/awards/awards-department.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="trophy" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Department Awards</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">Excellence across every team</p>
        </div>

        <div class="divide-y">
            @foreach (var dept in _departments)
            {
                <div class="flex items-start gap-3 px-4 py-3">
                    <LucideIconCn Name="@dept.Icon" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center justify-between gap-2">
                            <p class="text-sm font-medium">@dept.Department</p>
                            <span class="text-xs tabular-nums text-muted-foreground">
                                @dept.Members members
                            </span>
                        </div>
                        <p class="text-xs font-medium text-muted-foreground">@dept.Award</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">@dept.Detail</p>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                6 departments recognized in the past 12 months
            </p>
        </div>
    </div>
</section>

@code {
    private record DeptAward(string Department, string Icon, string Award, string Detail, int Members);

    private static readonly DeptAward[] _departments =
    [
        new("Engineering",      "code",        "Best API Design 2025",        "DevOps World — recognized for exceptional developer experience",     42),
        new("Design",           "palette",     "UX Excellence Award",         "Webby Awards — consumer-grade enterprise experience",               14),
        new("Customer Success", "headphones",  "Best Support Team",           "SaaS Customer Awards — 97% satisfaction rating",                    28),
        new("Marketing",        "megaphone",   "Best B2B Campaign",           "Content Marketing Awards — product-led growth strategy",            18),
        new("Security",         "shield",      "Security Team of the Year",   "Cybersecurity Excellence — zero breaches in 3 years",               9),
        new("Data Science",     "brain",       "AI Innovation Award",         "ML Summit — predictive analytics engine",                           11),
    ];
}
