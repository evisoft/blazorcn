@* ============================================================
   Block: awards-conference
   Title: AwardsConference
   Description: Conference speaking awards and event participation showcase
   Source: original/blocks/awards/awards-conference.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Conference Recognition</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Speaking engagements and event awards
            </p>
        </div>

        <div class="divide-y">
            @foreach (var conf in _conferences)
            {
                <div class="px-4 py-4">
                    <div class="flex items-center gap-2 mb-1.5">
                        <LucideIconCn Name="mic" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">@conf.Type</span>
                    </div>
                    <p class="text-sm font-medium">@conf.Event</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@conf.Talk</p>
                    <div class="mt-2 flex flex-wrap gap-3 text-xs text-muted-foreground">
                        <span class="flex items-center gap-1">
                            <LucideIconCn Name="map-pin" Size="12" Class="h-3 w-3" />
                            @conf.Location
                        </span>
                        <span class="flex items-center gap-1">
                            <LucideIconCn Name="calendar" Size="12" Class="h-3 w-3" />
                            @conf.Date
                        </span>
                        <span class="flex items-center gap-1">
                            <LucideIconCn Name="users" Size="12" Class="h-3 w-3" />
                            @conf.Audience
                        </span>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                130,000+ total audience reached across 12 events
            </p>
        </div>
    </div>
</section>

@code {
    private record ConferenceAward(string Event, string Talk, string Type, string Location, string Date, string Audience);

    private static readonly ConferenceAward[] _conferences =
    [
        new("AWS re:Invent 2025", "Keynote: Scaling Developer Platforms to 10M Users", "Keynote", "Las Vegas, NV", "Dec 2025", "45,000 attendees"),
        new("React Summit 2025", "Best Talk Award: Building Accessible Component Systems", "Award Winner", "Amsterdam, NL", "Oct 2025", "3,200 attendees"),
        new("KubeCon 2024", "Invited Talk: Zero-Downtime Deployments at Scale", "Invited Speaker", "Chicago, IL", "Nov 2024", "12,000 attendees"),
        new("Web Summit 2024", "PITCH Competition Winner — Enterprise Category", "Competition Winner", "Lisbon, PT", "Nov 2024", "70,000 attendees"),
    ];
}
