@* ============================================================
   Block: awards-team-spotlight
   Title: AwardsTeamSpotlight
   Description: A team member achievement spotlight block for React and Next.js with avatar initials, roles, awards, and staggered animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-team-spotlight.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="award" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Team Behind the Wins</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Recognizing the individuals who drove award-winning work
            </p>
        </div>

        @* Member list *@
        <div>
            @for (var i = 0; i < _members.Length; i++)
            {
                var member = _members[i];
                var isLast = i == _members.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <div class="flex size-9 shrink-0 items-center justify-center rounded-full bg-muted">
                            <span class="text-xs font-medium text-muted-foreground">@member.Initials</span>
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@member.Name</span>
                                <span class="text-xs text-muted-foreground">@member.Role</span>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">@member.Award</p>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-[10px] font-normal">@member.Category</BadgeCn>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">@_members.Length team members recognized</span>
        </div>

    </div>
</section>

@code {
    private record TeamMember(string Id, string Name, string Initials, string Role, string Award, string Category);

    private static readonly TeamMember[] _members =
    [
        new("1", "Sarah Chen",       "SC", "Lead Designer",       "Best Product Design",        "Design Excellence"),
        new("2", "Marcus Johnson",   "MJ", "Engineering Manager", "Innovation in Architecture", "Technical Leadership"),
        new("3", "Elena Rodriguez",  "ER", "Product Manager",     "Product Strategy Award",     "Product Vision"),
        new("4", "David Kim",        "DK", "Senior Engineer",     "Outstanding Contribution",   "Engineering Impact"),
        new("5", "Aisha Patel",      "AP", "UX Researcher",       "Research Excellence",        "User Experience"),
    ];
}
