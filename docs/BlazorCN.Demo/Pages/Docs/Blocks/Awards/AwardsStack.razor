@* ============================================================
   Block: awards-stack
   Title: AwardsStack
   Description: Awards displayed as an interactive stacked card deck with visual depth
   Source: original/blocks/awards/awards-stack.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Awards & recognition</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Click to browse through our accolades
            </p>
        </div>

        <div class="px-6 py-8">
            <div
                class="relative mx-auto h-44 max-w-sm cursor-pointer"
                @onclick="HandleCycle"
                @onkeydown="HandleKeyDown"
                role="button"
                tabindex="0"
                aria-label="Cycle through awards">
                @for (int i = 0; i < _awards.Length; i++)
                {
                    var award = _awards[i];
                    var order = GetOrder(i);
                    <div
                        class="absolute inset-x-0 rounded-md border bg-card px-5 py-4 transition-all duration-300"
                        style="@GetCardStyle(order)">
                        <div class="flex items-start gap-3">
                            <div class="mt-0.5 shrink-0">
                                @if (order == 0)
                                {
                                    <LucideIconCn Name="trophy" Size="16" Class="h-4 w-4 text-muted-foreground" />
                                }
                                else
                                {
                                    <LucideIconCn Name="award" Size="16" Class="h-4 w-4 text-muted-foreground" />
                                }
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center justify-between gap-2">
                                    <h3 class="text-sm font-medium">@award.Title</h3>
                                    <span class="shrink-0 text-xs text-muted-foreground">@award.Year</span>
                                </div>
                                <p class="mt-0.5 text-xs text-muted-foreground">@award.Org</p>
                                <p class="mt-2 text-sm text-muted-foreground">@award.Detail</p>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <p class="mt-16 text-center text-xs text-muted-foreground">
                @(_activeIndex + 1) of @_awards.Length
            </p>
        </div>
    </div>
</section>

@code {
    private record AwardItem(string Id, string Title, string Org, string Year, string Detail);

    private static readonly AwardItem[] _awards =
    [
        new("product-year", "Product of the Year", "Global Technology Awards", "2024", "Selected from 2,000+ submissions across 50 countries."),
        new("innovation", "Innovation Excellence", "Tech Innovators Summit", "2024", "Recognized for AI features that cut onboarding time by 60%."),
        new("customer-choice", "Customer Choice Award", "G2 Crowd", "2023", "Highest satisfaction score in category with 4.8/5 stars."),
    ];

    private int _activeIndex = 0;

    private void HandleCycle()
    {
        _activeIndex = (_activeIndex + 1) % _awards.Length;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            HandleCycle();
        }
    }

    private int GetOrder(int index)
    {
        return (index - _activeIndex + _awards.Length) % _awards.Length;
    }

    private string GetCardStyle(int order)
    {
        var scale = (1 - order * 0.04).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
        var opacity = order == 2 ? "0.5" : "1";
        return FormattableString.Invariant($"transform: translateY({order * 12}px) scale({scale}); z-index: {_awards.Length - order}; opacity: {opacity};");
    }
}
