@* ============================================================
   Block: awards-hall-of-fame
   Title: AwardsHallOfFame
   Description: Hall of fame inductees with portraits, achievements, and induction year
   Source: original/blocks/awards/awards-hall-of-fame.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="crown" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Hall of Fame</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">Honoring exceptional contributions</p>
        </div>

        <div class="divide-y">
            @foreach (var person in _inductees)
            {
                <div class="px-4 py-4">
                    <div class="flex items-start gap-3">
                        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-muted/50">
                            <LucideIconCn Name="user" Size="16" Class="h-4 w-4 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center justify-between gap-2">
                                <p class="text-sm font-medium">@person.Name</p>
                                <span class="flex items-center gap-1 text-xs text-muted-foreground">
                                    <LucideIconCn Name="star" Size="12" Class="h-3 w-3" />
                                    @person.InductionYear
                                </span>
                            </div>
                            <p class="text-xs text-muted-foreground">@person.Title</p>
                            <p class="mt-1.5 text-xs text-muted-foreground leading-relaxed">
                                @person.Achievement
                            </p>
                            <span class="mt-1.5 inline-block rounded-md bg-muted/50 px-2 py-0.5 text-[10px] font-medium text-muted-foreground">
                                @person.Highlight
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">@_inductees.Length inductees since 2023</p>
        </div>
    </div>
</section>

@code {
    private record Inductee(string Name, string Title, string InductionYear, string Achievement, string Highlight);

    private static readonly Inductee[] _inductees =
    [
        new("Dr. Sarah Chen", "Co-Founder & Former CTO", "2025", "Architected the platform that now serves 50,000+ companies worldwide", "15 patents filed"),
        new("Marcus Williams", "Head of Engineering (2018-2024)", "2024", "Scaled the engineering team from 5 to 120 while maintaining 99.99% uptime", "Zero major outages"),
        new("Elena Rodriguez", "VP of Customer Success", "2024", "Built the customer success function that achieved industry-leading 97% retention", "NPS score of 78"),
        new("James Nakamura", "Principal Engineer", "2023", "Created the open-source framework that became the foundation of the product", "42K GitHub stars"),
        new("Amara Osei", "VP of Design", "2023", "Established the design system that won 3 consecutive Webby Awards", "5 design awards"),
    ];
}
