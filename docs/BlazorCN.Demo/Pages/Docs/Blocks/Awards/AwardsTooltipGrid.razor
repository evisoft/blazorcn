@* ============================================================
   Block: awards-tooltip-grid
   Title: AwardsTooltipGrid
   Description: An ultra-compact grid of award cells with hover tooltips revealing full details including award name, organization, year, and category
   Source: original/blocks/awards/awards-tooltip-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Awards &amp; Recognition</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Hover over each cell to see full details
            </p>
        </div>

        <div class="p-4">
            <TooltipProviderCn>
                <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
                    @foreach (var award in _awards)
                    {
                        <TooltipCn>
                            <TooltipTriggerCn>
                                <div class="flex aspect-square cursor-default flex-col items-center justify-center gap-1.5 rounded-md border bg-muted/30 transition-colors hover:bg-muted/60">
                                    <LucideIconCn Name="trophy" Size="16" Class="size-4 text-muted-foreground/60" />
                                    <span class="font-medium text-xs">@award.Initials</span>
                                </div>
                            </TooltipTriggerCn>
                            <TooltipContentCn Side="FloatingSide.Top" Class="max-w-[220px] space-y-1.5 px-3 py-2.5">
                                <p class="font-medium text-xs">@award.Title</p>
                                <p class="text-[11px] opacity-80">@award.Organization</p>
                                <div class="flex items-center gap-1.5">
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 font-normal text-[10px]">
                                        @award.Category
                                    </BadgeCn>
                                    <span class="text-[10px] opacity-60">@award.Year</span>
                                </div>
                            </TooltipContentCn>
                        </TooltipCn>
                    }
                </div>
            </TooltipProviderCn>
        </div>
    </div>
</section>

@code {
    private record Award(string Id, string Title, string Organization, string Initials, string Year, string Category);

    private static readonly Award[] _awards =
    [
        new("1", "Best SaaS Product", "TechCrunch", "TC", "2025", "Product"),
        new("2", "Innovation Award", "Fast Company", "FC", "2025", "Innovation"),
        new("3", "Top Developer Tool", "Product Hunt", "PH", "2024", "Developer Tools"),
        new("4", "Excellence in Design", "Awwwards", "AW", "2024", "Design"),
        new("5", "Best Workplace Culture", "Glassdoor", "GD", "2025", "Workplace"),
        new("6", "Cloud Infrastructure Leader", "Gartner", "GR", "2024", "Infrastructure"),
        new("7", "Startup of the Year", "Forbes", "FB", "2025", "Business"),
        new("8", "Security Excellence", "ISO Board", "IS", "2024", "Security"),
    ];
}
