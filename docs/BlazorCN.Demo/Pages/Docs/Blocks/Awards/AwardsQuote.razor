@* ============================================================
   Block: awards-quote
   Title: AwardsQuote
   Description: Awards section with quote testimonial from award organization
   Source: original/blocks/awards/awards-quote.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Featured Recognition</h2>
            <p class="mt-1 text-muted-foreground text-sm">Why we were chosen.</p>
        </div>

        <div class="grid md:grid-cols-5">
            <div class="flex flex-col items-center justify-center border-b px-6 py-8 md:border-b-0 md:border-r md:col-span-2">
                <LucideIconCn Name="trophy" Size="16" Class="mb-3 h-4 w-4 text-muted-foreground" />
                <p class="text-sm font-medium">Product of the Year</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Global Technology Awards</p>
                <span class="mt-2 text-xs tabular-nums text-muted-foreground">2024</span>
            </div>

            <div class="flex flex-col justify-center px-6 py-8 md:col-span-3">
                <LucideIconCn Name="quote" Size="16" Class="mb-3 h-4 w-4 text-muted-foreground" />

                <blockquote class="text-sm leading-relaxed text-foreground">
                    "This product represents a paradigm shift in how teams collaborate. The judges were
                    unanimous in their praise for the intuitive design and measurable impact on
                    productivity."
                </blockquote>

                <div class="mt-4">
                    <p class="text-sm font-medium">Jennifer Reynolds</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Head Judge, Global Technology Awards
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
