@* ============================================================
   Block: awards-playlist-format
   Title: AwardsPlaylistFormat
   Description: A music tracklist-style awards display block for React and Next.js with numbered tracks, award names as titles, organizations as artists, and year as duration built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-playlist-format.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-10 items-center justify-center rounded-md bg-muted/50">
                <LucideIconCn Name="disc" Size="20" Class="size-5 text-muted-foreground" />
            </div>
            <div class="min-w-0 flex-1">
                <h2 class="text-sm font-medium">Greatest Hits</h2>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Awards Collection &middot; @_totalTracks tracks
                </p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                2022 - 2025
            </BadgeCn>
        </div>

        <div>
            @for (int i = 0; i < _tracks.Length; i++)
            {
                var track = _tracks[i];
                var isLast = i == _tracks.Length - 1;
                var trackNumber = (i + 1).ToString("D2");
                var isHovered = _hoveredId == track.Id;

                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50"
                         @onmouseenter="@(() => _hoveredId = track.Id)"
                         @onmouseleave="@(() => _hoveredId = null)">
                        <span class="flex w-6 shrink-0 items-center justify-center">
                            @if (isHovered)
                            {
                                <LucideIconCn Name="play" Size="12" Class="size-3 text-foreground" />
                            }
                            else
                            {
                                <span class="font-mono text-xs tabular-nums text-muted-foreground">@trackNumber</span>
                            }
                        </span>

                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-1.5">
                                <span class="truncate text-sm font-medium">@track.Title</span>
                                @if (track.Featured)
                                {
                                    <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                                }
                            </div>
                            <p class="mt-0.5 truncate text-xs text-muted-foreground">@track.Artist</p>
                        </div>

                        <span class="shrink-0 font-mono text-xs tabular-nums text-muted-foreground">@track.Year</span>
                    </div>
                </div>
            }
        </div>

        <div class="flex items-center gap-2 border-t px-4 py-2.5 text-xs text-muted-foreground">
            <span>@_totalTracks tracks</span>
            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
            <span class="flex items-center gap-1">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                Featured
            </span>
        </div>
    </div>
</section>

@code {
    private record Track(string Id, string Title, string Artist, string Year, bool Featured);

    private static readonly Track[] _tracks =
    [
        new("1", "Product of the Year",   "TechCrunch Disrupt", "2025", true),
        new("2", "Best User Experience",  "Webby Awards",       "2025", false),
        new("3", "Innovation Excellence", "Fast Company",       "2024", true),
        new("4", "Developer Tool Award",  "DevOps Awards",      "2024", false),
        new("5", "Customer Choice",       "G2 Crowd",           "2023", false),
        new("6", "Top 50 Startups",       "Forbes Cloud 100",   "2023", false),
        new("7", "Design of the Year",    "Awwwards",           "2023", true),
        new("8", "Best SaaS Product",     "SaaS Awards",        "2022", false),
    ];

    private static readonly int _totalTracks = _tracks.Length;

    private string? _hoveredId;
}
