@* ============================================================
   Block: awards-count-by-year
   Title: AwardsCountByYear
   Description: A count by year awards block for React and Next.js with inline horizontal bars, year labels, and count totals built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-count-by-year.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Awards by Year</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Annual award count with inline bars
            </p>
        </div>

        <div>
            @foreach (var entry in _yearData.Select((d, i) => new { Data = d, Idx = i }))
            {
                var isLast = entry.Idx == _yearData.Length - 1;
                var barWidth = (int)Math.Round((double)entry.Data.Count / _maxCount * 100);
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3 px-4 py-2.5">
                        <span class="w-10 shrink-0 text-xs font-medium tabular-nums">
                            @entry.Data.Year
                        </span>
                        <div class="h-2 flex-1 rounded-full bg-muted/30">
                            <div class="h-2 rounded-full bg-foreground/15" style="@($"width:{barWidth}%")"></div>
                        </div>
                        <span class="w-6 shrink-0 text-right text-xs font-semibold tabular-nums">
                            @entry.Data.Count
                        </span>
                    </div>
                </div>
            }
        </div>

        <div class="flex items-center gap-2 border-t px-4 py-2.5 text-xs text-muted-foreground">
            <span class="tabular-nums">@_totalAwards total awards</span>
            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
            <span>@_yearData.Length years tracked</span>
        </div>
    </div>
</section>

@code {
    private record YearItem(string Id, int Year, int Count);

    private static readonly YearItem[] _yearData =
    [
        new("1", 2026, 16),
        new("2", 2025, 14),
        new("3", 2024, 11),
        new("4", 2023,  8),
        new("5", 2022,  6),
        new("6", 2021,  4),
        new("7", 2020,  3),
    ];

    private static readonly int _maxCount = _yearData.Max(d => d.Count);
    private static readonly int _totalAwards = _yearData.Sum(d => d.Count);
}
