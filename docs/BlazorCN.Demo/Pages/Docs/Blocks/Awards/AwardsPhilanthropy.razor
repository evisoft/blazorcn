@* ============================================================
   Block: awards-philanthropy
   Title: AwardsPhilanthropy
   Description: Philanthropy and charitable giving awards showcasing corporate social responsibility recognition
   Source: original/blocks/awards/awards-philanthropy.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="heart" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Philanthropy Awards</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Recognized for meaningful giving and community impact
            </p>
        </div>

        <div class="divide-y">
            @foreach (var award in _awards)
            {
                <div class="px-4 py-4">
                    <div class="flex items-start gap-3">
                        <LucideIconCn Name="@award.IconName" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <p class="text-sm font-medium">@award.Title</p>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] px-1.5 py-0">
                                    @award.Year
                                </BadgeCn>
                            </div>
                            <p class="text-xs text-muted-foreground">
                                @award.Org &middot; @award.Cause
                            </p>
                            <p class="mt-1.5 text-xs text-muted-foreground">@award.Impact</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                $4.8M+ donated across 30+ causes since 2020
            </p>
        </div>
    </div>
</section>

@code {
    private record PhilanthropyAward(string Title, string Org, string Year, string Cause, string Impact, string IconName);

    private static readonly PhilanthropyAward[] _awards =
    [
        new("Corporate Giving Excellence", "Pledge 1% Foundation", "2025", "Education access",
            "$2.4M donated to 120+ schools worldwide", "heart"),
        new("Community Champion Award", "United Way", "2025", "Housing stability",
            "1,200 families supported through emergency housing", "users"),
        new("Global Impact Partner", "UNICEF Innovation", "2024", "Clean water initiative",
            "40 wells built across 12 countries", "globe"),
        new("Volunteer Excellence Award", "Points of Light", "2024", "Employee volunteerism",
            "18,000+ volunteer hours logged by team members", "handshake"),
    ];
}
