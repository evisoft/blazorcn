@* ============================================================
   Block: awards-event-agenda
   Title: AwardsEventAgenda
   Description: Block example: awards
   Source: original/blocks/awards/awards-event-agenda.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Event Agenda</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Annual Excellence Awards Ceremony 2025</p>
        </div>

        @* Event meta *@
        <div class="border-b px-4 py-3">
            <div class="flex flex-wrap gap-4 text-xs text-muted-foreground">
                <span class="flex items-center gap-1.5">
                    <LucideIconCn Name="calendar" Size="12" Class="h-3 w-3" />
                    October 22, 2025
                </span>
                <span class="flex items-center gap-1.5">
                    <LucideIconCn Name="map-pin" Size="12" Class="h-3 w-3" />
                    Grand Ballroom, The Ritz-Carlton
                </span>
                <span class="flex items-center gap-1.5">
                    <LucideIconCn Name="users" Size="12" Class="h-3 w-3" />
                    350 guests
                </span>
            </div>
        </div>

        @* Agenda items *@
        <div class="divide-y">
            @foreach (var item in _agenda)
            {
                <div class="flex items-start gap-3 px-4 py-3">
                    <span class="shrink-0 w-14 font-mono text-xs tabular-nums text-muted-foreground pt-0.5">
                        @item.Time
                    </span>
                    <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        <LucideIconCn Name="@item.Icon" Size="12" Class="h-3 w-3 text-muted-foreground" />
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <p class="text-sm font-medium">@item.Title</p>
                            @if (!string.IsNullOrEmpty(item.Badge))
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs px-1.5 py-0">
                                    @item.Badge
                                </BadgeCn>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(item.Description))
                        {
                            <p class="mt-0.5 text-xs text-muted-foreground leading-relaxed">@item.Description</p>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                Dress code: Black tie. Doors open at 5:30 PM.
            </p>
        </div>
    </div>
</section>

@code {
    private record AgendaItem(string Time, string Icon, string Title, string Description, string Badge = "");

    private static readonly AgendaItem[] _agenda =
    [
        new("6:00 PM", "door-open",   "Doors Open & Registration",    "Welcome reception with cocktails and light refreshments."),
        new("6:45 PM", "mic",         "Opening Remarks",               "Welcome address from the awards committee chair.", "Keynote"),
        new("7:15 PM", "trophy",      "Category Awards: Innovation",   "Recognizing breakthroughs in product and technology innovation.", "Awards"),
        new("7:45 PM", "star",        "Category Awards: Leadership",   "Honoring individuals who inspire and lead their industries.", "Awards"),
        new("8:15 PM", "utensils",    "Gala Dinner",                   "Seated three-course dinner served tableside."),
        new("9:00 PM", "gift",        "Grand Prize Presentation",      "The most prestigious award of the evening — announced live.", "Featured"),
        new("9:30 PM", "music",       "Entertainment & Celebration",   "Live performance followed by open dancing and networking."),
        new("10:30 PM","log-out",     "Closing & Farewell",            "Thank you from the hosts. Goodie bags provided at the exit."),
    ];
}
