@* ============================================================
   Block: awards-accordion
   Title: Awards Accordion
   Description: Expandable award rows revealing description, criteria, and organization details on click
   Long Description: Side-by-side recognition comparison
   Dependencies: LucideChevronRightCn, LucideTrophyCn
   Source: original/blocks/awards/awards-accordion.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Awards &amp; recognition</h2>
            <p class="mt-1 text-muted-foreground text-sm">Click any award to see full details</p>
        </div>

        <div>
            @for (var i = 0; i < _awards.Count; i++)
            {
                var award = _awards[i];
                var isExpanded = _expanded == award.Id;
                var isLast = i == _awards.Count - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="() => _expanded = isExpanded ? null : award.Id"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <LucideTrophyCn Size="16" Class="h-4 w-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@award.Title</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @award.Org &middot; @award.Year
                            </p>
                        </div>
                        <LucideChevronRightCn Size="16"
                            Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-11">
                            <p class="text-muted-foreground text-sm leading-relaxed">
                                @award.Description
                            </p>
                            <div class="mt-3 rounded-md bg-muted/50 p-3">
                                <span class="font-medium text-muted-foreground text-xs">
                                    Selection criteria
                                </span>
                                <p class="mt-1 text-sm leading-relaxed">@award.Criteria</p>
                            </div>
                            <div class="mt-2 flex items-center gap-3 text-muted-foreground text-xs">
                                <span>Category: @award.Category</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record AwardItem(string Id, string Title, string Year, string Org, string Category, string Description, string Criteria);

    private readonly List<AwardItem> _awards =
    [
        new("product-year", "Product of the Year", "2024", "Global Technology Awards", "SaaS Platform",
            "Selected from 2,000+ submissions across 50 countries for innovative workflow automation and exceptional user experience design.",
            "Evaluated on innovation impact, user adoption growth, and technical architecture quality."),
        new("innovation", "Innovation Excellence Award", "2024", "Tech Innovators Summit", "AI & Automation",
            "Recognized for AI-powered features that reduced customer onboarding time by 60% while maintaining enterprise-grade security.",
            "Judged by a panel of 12 industry experts on measurable business impact and technical novelty."),
        new("customer-choice", "Customer Choice Award", "2024", "G2 Crowd", "Developer Tools",
            "Highest satisfaction score in category with 4.8/5 stars based on 1,200+ verified user reviews.",
            "Based entirely on authenticated customer reviews, adoption rates, and net promoter scores."),
        new("design", "Best UX Design", "2023", "Webby Awards", "Enterprise Software",
            "Honored for delivering a consumer-grade experience in an enterprise product, setting a new standard for B2B design.",
            "Selected by the International Academy of Digital Arts and Sciences from 3,000 entries."),
    ];
}
