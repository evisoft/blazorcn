@* ============================================================
   Block: awards-lifetime-achievement
   Title: AwardsLifetimeAchievement
   Description: Lifetime achievement spotlight with career highlights and legacy summary
   Source: original/blocks/awards/awards-lifetime-achievement.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideAwardCn class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Lifetime Achievement Award</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Presented by the Software Engineering Institute &middot; 2025
            </p>
        </div>

        @* Honoree *@
        <div class="border-b px-4 py-4">
            <p class="text-sm font-medium">Dr. Maya Patel</p>
            <p class="text-xs text-muted-foreground">Founder &amp; CEO</p>
            <p class="mt-2 text-xs text-muted-foreground leading-relaxed">Dr. Patel has spent 25 years transforming how developers build software. From pioneering early CI/CD practices to leading the open-source movement that shaped modern DevOps, her contributions have touched millions of developers worldwide.</p>
        </div>

        @* Milestones *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-1.5 mb-3">
                <LucideCalendarCn class="h-3 w-3 text-muted-foreground" />
                <span class="text-xs font-medium text-muted-foreground">Career milestones</span>
            </div>
            <div class="space-y-2">
                @foreach (var ms in _milestones)
                {
                    <div class="flex items-start gap-3">
                        <span class="shrink-0 font-mono text-xs tabular-nums text-muted-foreground w-10">
                            @ms.Year
                        </span>
                        <div class="flex items-center gap-2">
                            <LucideStarCn class="h-3 w-3 shrink-0 text-muted-foreground" />
                            <p class="text-xs text-muted-foreground">@ms.Event</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Quote *@
        <div class="px-4 py-4">
            <div class="rounded-md bg-muted/50 p-3">
                <p class="text-xs text-muted-foreground leading-relaxed">"The best software is built by teams that are empowered to experiment, fail fast, and learn continuously. That's what we set out to enable 25 years ago."</p>
                <p class="mt-2 text-[10px] text-muted-foreground">— Dr. Maya Patel</p>
            </div>
        </div>
    </div>
</section>

@code {
    private record Milestone(string Year, string Event);

    private static readonly Milestone[] _milestones =
    [
        new("2000", "Founded first open-source CI platform"),
        new("2008", "Published 'Continuous Delivery' methodology"),
        new("2015", "Grew company to $100M ARR"),
        new("2020", "Open-sourced core platform (100K+ GitHub stars)"),
        new("2025", "Lifetime Achievement — Software Engineering Institute"),
    ];
}
