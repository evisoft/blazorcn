@* ============================================================
   Block: awards-technology
   Title: AwardsTechnology
   Description: Technology innovation awards highlighting technical excellence, engineering breakthroughs, and platform recognition
   Source: original/blocks/awards/awards-technology.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="cpu" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Technology Awards</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Recognized for technical excellence and engineering innovation
            </p>
        </div>

        <div class="divide-y">
            @foreach (var award in _awards)
            {
                <div class="px-4 py-3">
                    <div class="flex items-start gap-3">
                        <LucideIconCn Name="@award.IconName" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <p class="text-sm font-medium">@award.Title</p>
                                <span class="rounded bg-muted/50 px-1.5 py-0.5 text-[10px] font-medium text-muted-foreground">
                                    @award.Category
                                </span>
                            </div>
                            <p class="text-xs text-muted-foreground">
                                @award.Org &middot; @award.Year
                            </p>
                            <p class="mt-1 font-mono text-[11px] text-muted-foreground">@award.Spec</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                5 technology awards from independent evaluations in 2024-2025
            </p>
        </div>
    </div>
</section>

@code {
    private record TechAward(string Title, string Org, string Year, string Category, string Spec, string IconName);

    private static readonly TechAward[] _awards =
    [
        new("Best Cloud Platform", "Cloud Awards", "2025", "Infrastructure", "99.999% uptime across 40 regions", "server"),
        new("Security Innovation Award", "RSA Conference", "2025", "Security", "Zero breaches since inception, SOC 2 Type II certified", "shield"),
        new("Fastest API Platform", "API World", "2024", "Performance", "Sub-5ms P99 latency at 1M+ req/sec", "gauge"),
        new("Best Developer Experience", "SlashData", "2024", "DevEx", "Top-rated SDK across 12 languages", "cpu"),
        new("Database Innovation Award", "DB-Engines", "2024", "Data", "Novel query engine with 10x throughput improvement", "database"),
    ];
}
