@* ============================================================
   Block: awards-origin-story
   Title: AwardsOriginStory
   Description: A behind-the-scenes awards narrative block for React and Next.js with storytelling prose, inline stats, milestone markers, and award reveal built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-origin-story.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">The Journey to Our First Award</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">How a side project became an award-winning platform</p>
        </div>

        @* Narrative prose *@
        <div class="space-y-3 border-b px-4 py-3">
            @foreach (var text in _paragraphs)
            {
                <p class="text-sm leading-relaxed text-muted-foreground">@text</p>
            }
        </div>

        @* Inline stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            @foreach (var stat in _stats)
            {
                <div class="flex items-baseline gap-1.5">
                    <span class="text-sm font-semibold tabular-nums">@stat.Value</span>
                    <span class="text-xs text-muted-foreground">@stat.Label</span>
                </div>
            }
        </div>

        @* Milestones *@
        <div class="border-b">
            <div class="px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">Key Milestones</span>
            </div>
            @for (var i = 0; i < _milestones.Length; i++)
            {
                var milestone = _milestones[i];
                var isLast = i == _milestones.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <LucideIconCn Name="calendar" Size="12" Class="size-3 shrink-0 text-muted-foreground/60" />
                    <span class="w-20 shrink-0 font-mono text-xs text-muted-foreground tabular-nums">@milestone.Date</span>
                    <span class="text-sm">@milestone.Label</span>
                </div>
            }
        </div>

        @* Award reveal *@
        <div class="px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                    <LucideIconCn Name="trophy" Size="16" Class="size-4 text-emerald-600 dark:text-emerald-400" />
                </div>
                <div class="min-w-0 flex-1">
                    <span class="text-sm font-medium">Best Developer Tool</span>
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <span>DevOps Awards 2025</span>
                        <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                            <LucideIconCn Name="sparkles" Size="10" Class="mr-1 size-2.5" />
                            Winner
                        </BadgeCn>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Milestone(string Id, string Date, string Label);
    private record Stat(string Value, string Label);

    private static readonly string[] _paragraphs =
    [
        "It started as a side project. Four engineers, one shared frustration: developer tooling was fragmented, slow, and poorly designed. We spent weekends prototyping a unified platform that could replace six separate tools.",
        "By spring, we had a working prototype. The feedback from early beta users was immediate and clear — this solved a real problem. We iterated fast, shipping weekly updates based on direct user conversations.",
        "The public launch exceeded every projection. Within the first month, 12,000 developers signed up. Retention was unusually high. We knew we had built something that mattered.",
    ];

    private static readonly Stat[] _stats =
    [
        new("12,000", "signups at launch"),
        new("94%", "retention rate"),
        new("4", "founding engineers"),
    ];

    private static readonly Milestone[] _milestones =
    [
        new("1", "Jan 2024", "Project kickoff with a team of 4"),
        new("2", "Apr 2024", "First prototype shipped to beta users"),
        new("3", "Aug 2024", "Public launch with 12,000 signups"),
        new("4", "Nov 2024", "Nominated for Best Developer Tool"),
        new("5", "Mar 2025", "Award ceremony in San Francisco"),
    ];
}
