@* ============================================================
   Block: awards-verification-seal
   Title: AwardsVerificationSeal
   Description: Block example: awards
   Source: original/blocks/awards/awards-verification-seal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex flex-col items-center gap-6 px-6 py-8">
            <div class="relative flex items-center justify-center">
                <div class="flex h-28 w-28 flex-col items-center justify-center rounded-full border-4 border-primary/20 bg-primary/5">
                    <LucideIconCn Name="shield-check" Size="40" Class="h-10 w-10 text-primary" />
                </div>
                <div class="absolute -bottom-1 -right-1 flex items-center gap-1 rounded-full bg-emerald-500 px-2 py-0.5">
                    <LucideIconCn Name="check" Size="10" Class="h-2.5 w-2.5 text-white" />
                    <span class="text-[10px] font-semibold text-white">Verified</span>
                </div>
            </div>

            <div class="text-center">
                <h2 class="font-semibold text-xl tracking-tight">Best-in-Class Award</h2>
                <p class="mt-1 text-sm text-muted-foreground">Enterprise Software Excellence</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Issued by the Global Technology Awards Committee</p>
            </div>

            <div class="w-full rounded-md bg-muted/50 px-4 py-3">
                <div class="grid grid-cols-2 gap-3 text-sm">
                    @foreach (var item in _details)
                    {
                        <div>
                            <p class="text-xs text-muted-foreground">@item.Label</p>
                            <p class="mt-0.5 font-medium">@item.Value</p>
                        </div>
                    }
                </div>
            </div>

            <div class="flex w-full items-center gap-2 rounded-md border border-dashed px-4 py-3">
                <LucideIconCn Name="fingerprint" Size="16" Class="h-4 w-4 shrink-0 text-muted-foreground" />
                <div class="min-w-0 flex-1">
                    <p class="text-xs text-muted-foreground">Verification ID</p>
                    <p class="truncate font-mono text-xs font-medium">GTAC-2024-BICE-8847-VRF</p>
                </div>
                <div class="flex items-center gap-1 rounded-md bg-emerald-500/10 px-2 py-1">
                    <LucideIconCn Name="circle-check-big" Size="12" Class="h-3 w-3 text-emerald-500" />
                    <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">Authentic</span>
                </div>
            </div>

            <p class="text-center text-xs text-muted-foreground">
                This seal certifies the authenticity of the award. Independently audited and verified by a third-party review board.
            </p>
        </div>
    </div>
</section>

@code {
    private record DetailItem(string Label, string Value);

    private static readonly DetailItem[] _details =
    [
        new("Award Category", "Best Enterprise Solution"),
        new("Year", "2024"),
        new("Recipient", "Acme Corporation"),
        new("Expiration", "December 31, 2025"),
    ];
}
