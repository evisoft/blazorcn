@* ============================================================
   Block: awards-collapsible-list
   Title: AwardsCollapsibleList
   Description: Collapsible award category list with expandable sections and nested items
   Source: original/blocks/awards/awards-collapsible-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Awards &amp; Certifications</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @(_categories.Sum(c => c.Awards.Length)) awards across @_categories.Length categories
            </p>
        </div>

        <div class="divide-y">
            @foreach (var cat in _categories)
            {
                var isOpen = _expanded == cat.Id;
                <div>
                    <button type="button"
                            @onclick="() => _expanded = (isOpen ? null : cat.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <LucideChevronRightCn Size="16"
                            Class="@Cn.Merge("h-4 w-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isOpen ? "rotate-90" : "")" />
                        <span class="flex-1 text-sm font-medium">@cat.Name</span>
                        <span class="rounded-full bg-muted/50 px-2 py-0.5 text-xs tabular-nums text-muted-foreground">
                            @cat.Awards.Length
                        </span>
                    </button>

                    @if (isOpen)
                    {
                        <div class="pb-2 pl-11 pr-4">
                            @foreach (var award in cat.Awards)
                            {
                                <div class="flex items-center gap-2 py-1.5">
                                    <LucideTrophyCn Size="12" Class="h-3 w-3 shrink-0 text-muted-foreground" />
                                    <div class="min-w-0 flex-1">
                                        <p class="text-xs font-medium">@award.Title</p>
                                        <p class="text-[10px] text-muted-foreground">
                                            @award.Org &middot; @award.Year
                                        </p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "product";

    private record Award(string Title, string Org, string Year);
    private record AwardCategory(string Id, string Name, Award[] Awards);

    private static readonly AwardCategory[] _categories =
    [
        new("product", "Product Awards",
        [
            new("Product of the Year", "Global SaaS Awards", "2025"),
            new("Best New Product", "Product Hunt", "2024"),
            new("Editor's Choice", "PCMag", "2024"),
        ]),
        new("design", "Design Awards",
        [
            new("Best UX Design", "Webby Awards", "2025"),
            new("Design Excellence", "Awwwards", "2024"),
        ]),
        new("security", "Security & Compliance",
        [
            new("SOC 2 Type II", "AICPA", "2025"),
            new("ISO 27001", "BSI", "2024"),
            new("GDPR Compliant", "EU Commission", "2024"),
        ]),
        new("workplace", "Workplace Awards",
        [
            new("Best Places to Work", "Glassdoor", "2025"),
            new("Top Employer", "Forbes", "2024"),
        ]),
    ];
}
