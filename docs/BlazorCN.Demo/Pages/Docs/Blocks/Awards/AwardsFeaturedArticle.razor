@* ============================================================
   Block: awards-featured-article
   Title: AwardsFeaturedArticle
   Description: Award featured in a publication with article excerpt and publication details
   Source: original/blocks/awards/awards-featured-article.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="newspaper" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Featured In</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Award coverage by leading publications
            </p>
        </div>

        @* Article header *@
        <div class="border-b px-4 py-4">
            <p class="text-xs font-medium text-muted-foreground">@_article.Publication</p>
            <h3 class="mt-1 text-sm font-medium leading-snug">@_article.Headline</h3>
            <div class="mt-2 flex flex-wrap items-center gap-3 text-xs text-muted-foreground">
                <span>
                    @_article.Author, @_article.AuthorRole
                </span>
                <span class="flex items-center gap-1">
                    <LucideIconCn Name="calendar" Size="12" Class="h-3 w-3" />
                    @_article.Date
                </span>
                <span class="flex items-center gap-1">
                    <LucideIconCn Name="book-open" Size="12" Class="h-3 w-3" />
                    @_article.ReadTime
                </span>
            </div>
        </div>

        @* Article excerpt *@
        <div class="border-b px-4 py-4">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Excerpt</p>
            <div class="space-y-3">
                @foreach (var paragraph in _article.Excerpt)
                {
                    <p class="text-xs text-muted-foreground leading-relaxed">@paragraph</p>
                }
            </div>
        </div>

        @* Tags and link *@
        <div class="px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex gap-2">
                    @foreach (var tag in _article.Tags)
                    {
                        <span class="rounded-md bg-muted/50 px-2 py-0.5 text-[10px] text-muted-foreground">@tag</span>
                    }
                </div>
                <button type="button" class="inline-flex items-center gap-1 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground">
                    Read full article
                    <LucideIconCn Name="external-link" Size="12" Class="h-3 w-3" />
                </button>
            </div>
        </div>
    </div>
</section>

@code {
    private record ArticleData(
        string Publication,
        string Headline,
        string Author,
        string AuthorRole,
        string Date,
        string ReadTime,
        string[] Excerpt,
        string[] Tags
    );

    private static readonly ArticleData _article = new(
        Publication: "TechCrunch",
        Headline: "How This Startup Won Product of the Year Against 2,000 Competitors",
        Author: "Sarah Perez",
        AuthorRole: "Senior Enterprise Reporter",
        Date: "March 18, 2025",
        ReadTime: "6 min read",
        Excerpt: [
            "In a field of over 2,000 submissions from 50 countries, one company stood out to the judges not for its marketing budget, but for its relentless focus on developer experience.",
            "\"What impressed us was the measurable impact,\" said lead judge David Kim. \"Their customers saw a 60% reduction in onboarding time — that's not incremental improvement, that's a paradigm shift.\"",
            "The win marks the company's third major award in 18 months, following an Innovation Leader recognition from Gartner and a Customer Choice award from G2 Crowd.",
        ],
        Tags: ["Enterprise Software", "Developer Tools", "Awards"]
    );
}
