@* ============================================================
   Block: awards-badges
   Title: Awards Badges
   Description: Awards badges section with icon collection and trust signals for React landing pages
   Long Description: Awards section formatted as a year-in-review report card with quarterly breakdowns
   Dependencies: LucideCrownCn, LucideMedalCn, LucideShieldCn, LucideStarCn
   Source: original/blocks/awards/awards-badges.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Backed by industry leaders</h2>
            <p class="mt-1 text-muted-foreground text-sm">Recognition from the organizations that matter most</p>
        </div>

        <div class="grid grid-cols-2 gap-4 p-6 sm:grid-cols-4">
            @foreach (var badge in _badges)
            {
                <div class="flex flex-col items-center gap-2 rounded-md bg-muted/50 p-4">
                    <LucideStarCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                    <div class="text-center">
                        <p class="text-sm font-medium">@badge.Label</p>
                        <p class="text-xs text-muted-foreground">@badge.Org</p>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-6 py-3">
            <p class="text-xs text-muted-foreground">Trusted by 10,000+ companies worldwide</p>
        </div>
    </div>
</section>

@code {
    private record BadgeItem(string Label, string Org);

    private static readonly BadgeItem[] _badges =
    [
        new("Leader", "G2 2024"),
        new("Top Rated", "Capterra"),
        new("Best Value", "TrustRadius"),
        new("Verified", "ISO 27001"),
    ];
}
