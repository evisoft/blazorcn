@* ============================================================
   Block: awards-industry
   Title: AwardsIndustry
   Description: Awards grouped by industry vertical showing breadth of recognition across sectors
   Source: original/blocks/awards/awards-industry.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Industry recognition</h2>
            <p class="mt-1 text-muted-foreground text-sm">Awarded across multiple verticals</p>
        </div>

        <div class="divide-y">
            @foreach (var group in _industries)
            {
                <div class="px-6 py-5">
                    <p class="mb-3 text-xs font-medium text-muted-foreground uppercase tracking-wider">
                        @group.Industry
                    </p>
                    <div class="space-y-3">
                        @foreach (var award in group.Awards)
                        {
                            <div class="flex items-start gap-3">
                                <LucideIconCn Name="award" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
                                <div class="flex min-w-0 flex-1 items-baseline justify-between gap-2">
                                    <div class="min-w-0">
                                        <span class="text-sm font-medium">@award.Title</span>
                                        <span class="ml-2 text-xs text-muted-foreground">@award.Org</span>
                                    </div>
                                    <span class="shrink-0 text-xs tabular-nums text-muted-foreground">
                                        @award.Year
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record IndustryAward(string Title, string Org, string Year);
    private record IndustryGroup(string Id, string Industry, IndustryAward[] Awards);

    private static readonly IndustryGroup[] _industries =
    [
        new("saas", "SaaS & Cloud",
        [
            new("Best Cloud Platform", "SaaS Awards", "2024"),
            new("Top 10 Developer Tools", "G2 Crowd", "2024"),
        ]),
        new("fintech", "Fintech",
        [
            new("Most Innovative Solution", "Finovate Awards", "2023"),
            new("Best Compliance Tool", "FinTech Breakthrough", "2024"),
        ]),
        new("healthcare", "Healthcare",
        [
            new("Digital Health Innovation", "HIMSS", "2024"),
            new("Best Patient Engagement", "Health Tech Awards", "2023"),
        ]),
    ];
}
