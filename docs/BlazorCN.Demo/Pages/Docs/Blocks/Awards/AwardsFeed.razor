@* ============================================================
   Block: awards-feed
   Title: AwardsFeed
   Description: Awards activity feed section with social-style notification items for React about pages
   Source: original/blocks/awards/awards-feed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Award Activity</h2>
            <p class="mt-1 text-muted-foreground text-sm">Latest recognitions and nominations.</p>
        </div>

        <div>
            @foreach (var item in _feedItems)
            {
                <div class="flex items-start gap-3 border-b px-6 py-4 last:border-b-0">
                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-muted/50">
                        <LucideIconCn Name="@item.Icon" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                    </div>

                    <div class="min-w-0 flex-1 pt-0.5">
                        <div class="flex items-center gap-2">
                            <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", StatusDotClass(item.Status))"></span>
                            <p class="text-sm">
                                <span class="text-muted-foreground">@item.Action</span>@(" ")
                                <span class="font-medium">@item.Award</span>
                            </p>
                        </div>
                        <p class="mt-1 ml-3.5 text-xs text-muted-foreground">
                            @item.Org &middot; @item.Time
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record FeedItem(string Id, string Action, string Award, string Org, string Time, string Icon, string Status);

    private static readonly FeedItem[] _feedItems =
    [
        new("1", "Won",            "Best Developer Tool",  "TechCrunch Disrupt",          "2 days ago",  "trophy", "won"),
        new("2", "Nominated for",  "Innovation in SaaS",   "SaaStr Annual Awards",         "1 week ago",  "star",   "nominated"),
        new("3", "Shortlisted for","Best User Experience",  "Webby Awards",                "3 weeks ago", "medal",  "shortlisted"),
        new("4", "Finalist in",    "Product of the Year",  "Product Hunt Golden Kitty",   "1 month ago", "award",  "finalist"),
    ];

    private static string StatusDotClass(string status) => status switch
    {
        "won"         => "bg-emerald-500",
        "nominated"   => "bg-blue-500",
        "shortlisted" => "bg-amber-500",
        "finalist"    => "bg-blue-400",
        _             => ""
    };
}
