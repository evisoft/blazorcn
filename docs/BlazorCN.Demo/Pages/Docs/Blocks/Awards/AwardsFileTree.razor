@* ============================================================
   Block: awards-file-tree
   Title: AwardsFileTree
   Description: Block example: awards
   Source: original/blocks/awards/awards-file-tree.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h3 class="text-sm font-medium">Award Documents</h3>
                <p class="text-xs text-muted-foreground">
                    @_folderCount folders · @_fileCount files@(_selected.Count > 0 ? $" · {_selected.Count} selected" : "")
                </p>
            </div>
        </div>

        <TableCn>
            <TableHeaderCn>
                <TableRowCn>
                    <TableHeadCn Class="w-12 text-xs font-medium text-muted-foreground"><span class="sr-only">Select</span></TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Name</TableHeadCn>
                    <TableHeadCn Class="w-24 text-right text-xs font-medium text-muted-foreground">Size</TableHeadCn>
                    <TableHeadCn Class="w-32 text-xs font-medium text-muted-foreground">Modified</TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var (node, depth) in GetVisibleNodes(_fileTree))
                {
                    var captured = node;
                    var capturedDepth = depth;
                    var isExpanded = _expanded.Contains(captured.Id);
                    var isSelected = _selected.Contains(captured.Id);
                    <TableRowCn Class="@(isSelected ? "bg-primary/5" : "")">
                        <TableCellCn Class="w-8">
                            <input type="checkbox"
                                   class="h-4 w-4 cursor-pointer rounded border border-input accent-primary"
                                   aria-label="Select @captured.Name"
                                   checked="@isSelected"
                                   @onchange="@(() => ToggleSelect(captured.Id))" />
                        </TableCellCn>
                        <TableCellCn>
                            <div class="flex items-center gap-1" style="@($"padding-left:{capturedDepth * 20}px")">
                                @if (captured.IsFolder)
                                {
                                    <button type="button"
                                            class="flex h-6 w-6 items-center justify-center rounded p-0 transition-colors hover:bg-muted"
                                            aria-label="@(isExpanded ? $"Collapse {captured.Name}" : $"Expand {captured.Name}")"
                                            @onclick="@(() => ToggleExpand(captured.Id))">
                                        @if (isExpanded)
                                        {
                                            <LucideIconCn Name="chevron-down" Size="16" Class="h-4 w-4" />
                                        }
                                        else
                                        {
                                            <LucideIconCn Name="chevron-right" Size="16" Class="h-4 w-4" />
                                        }
                                    </button>
                                    @if (isExpanded)
                                    {
                                        <LucideIconCn Name="folder-open" Size="16" Class="h-4 w-4 text-yellow-500" />
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="folder" Size="16" Class="h-4 w-4 text-yellow-500" />
                                    }
                                }
                                else
                                {
                                    <span class="w-6"></span>
                                    @if (captured.FileKind == "document")
                                    {
                                        <LucideIconCn Name="file-text" Size="16" Class="h-4 w-4 text-blue-500" />
                                    }
                                    else if (captured.FileKind == "image")
                                    {
                                        <LucideIconCn Name="file-image" Size="16" Class="h-4 w-4 text-green-500" />
                                    }
                                    else if (captured.FileKind == "code")
                                    {
                                        <LucideIconCn Name="file-code" Size="16" Class="h-4 w-4 text-orange-500" />
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="file" Size="16" Class="h-4 w-4 text-muted-foreground" />
                                    }
                                }
                                <span class="@Cn.Merge("ml-1.5", captured.IsFolder ? "font-medium" : "")">
                                    @captured.Name
                                </span>
                            </div>
                        </TableCellCn>
                        <TableCellCn Class="text-right text-sm text-muted-foreground tabular-nums">
                            @(captured.Size ?? "--")
                        </TableCellCn>
                        <TableCellCn Class="text-sm text-muted-foreground">@captured.Modified</TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private record FileNode(string Id, string Name, bool IsFolder, string? Size, string Modified, string FileKind, FileNode[] Children);

    private readonly FileNode[] _fileTree =
    [
        new("awards", "awards", true, null, "Today", "", [
            new("awards/2024", "2024", true, null, "Today", "", [
                new("awards/2024/certificates", "certificates", true, null, "Today", "", [
                    new("awards/2024/certificates/product-of-the-year.pdf", "product-of-the-year.pdf", false, "6.2 KB", "Nov 2024", "other", []),
                    new("awards/2024/certificates/innovation-award.pdf", "innovation-award.pdf", false, "4.8 KB", "Sep 2024", "other", []),
                    new("awards/2024/certificates/customer-choice.pdf", "customer-choice.pdf", false, "3.1 KB", "Jun 2024", "other", []),
                ]),
                new("awards/2024/press", "press", true, null, "Nov 2024", "", [
                    new("awards/2024/press/techcrunch-coverage.md", "techcrunch-coverage.md", false, "2.4 KB", "Nov 2024", "document", []),
                    new("awards/2024/press/g2-announcement.md", "g2-announcement.md", false, "1.8 KB", "Jun 2024", "document", []),
                ]),
                new("awards/2024/media", "media", true, null, "Dec 2024", "", [
                    new("awards/2024/media/trophy-photo.jpg", "trophy-photo.jpg", false, "890 KB", "Nov 2024", "image", []),
                    new("awards/2024/media/award-banner.png", "award-banner.png", false, "120 KB", "Dec 2024", "image", []),
                ]),
            ]),
            new("awards/2023", "2023", true, null, "1 week ago", "", [
                new("awards/2023/certificates", "certificates", true, null, "Dec 2023", "", [
                    new("awards/2023/certificates/platform-excellence.pdf", "platform-excellence.pdf", false, "5.1 KB", "Dec 2023", "other", []),
                    new("awards/2023/certificates/design-award.pdf", "design-award.pdf", false, "3.7 KB", "Sep 2023", "other", []),
                ]),
                new("awards/2023/press", "press", true, null, "Sep 2023", "", [
                    new("awards/2023/press/webby-announcement.md", "webby-announcement.md", false, "2.1 KB", "Sep 2023", "document", []),
                ]),
            ]),
        ]),
        new("README.md", "README.md", false, "1.2 KB", "Today", "document", []),
        new("awards-catalog.json", "awards-catalog.json", false, "4.5 KB", "Today", "code", []),
    ];

    private readonly HashSet<string> _expanded = ["awards", "awards/2024", "awards/2024/certificates"];
    private readonly HashSet<string> _selected = [];

    private int _folderCount;
    private int _fileCount;

    protected override void OnInitialized()
    {
        (_folderCount, _fileCount) = CountItems(_fileTree);
    }

    private static (int Folders, int Files) CountItems(FileNode[] nodes)
    {
        var folders = 0;
        var files = 0;
        foreach (var node in nodes)
        {
            if (node.IsFolder)
            {
                folders++;
                var (subFolders, subFiles) = CountItems(node.Children);
                folders += subFolders;
                files += subFiles;
            }
            else
            {
                files++;
            }
        }
        return (folders, files);
    }

    private IEnumerable<(FileNode Node, int Depth)> GetVisibleNodes(FileNode[] nodes, int depth = 0)
    {
        foreach (var node in nodes)
        {
            yield return (node, depth);
            if (node.IsFolder && _expanded.Contains(node.Id))
            {
                foreach (var child in GetVisibleNodes(node.Children, depth + 1))
                    yield return child;
            }
        }
    }

    private void ToggleExpand(string id)
    {
        if (!_expanded.Add(id))
            _expanded.Remove(id);
    }

    private void ToggleSelect(string id)
    {
        if (!_selected.Add(id))
            _selected.Remove(id);
    }
}
