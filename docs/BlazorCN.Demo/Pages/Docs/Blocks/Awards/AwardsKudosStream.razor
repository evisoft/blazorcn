@* ============================================================
   Block: awards-kudos-stream
   Title: AwardsKudosStream
   Description: A kudos recognition stream block for React and Next.js with sender-recipient messages, timestamps, and award mentions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-kudos-stream.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="message-circle" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Kudos Stream</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">Recent recognition from the team</p>
        </div>

        <div>
            @for (var i = 0; i < _messages.Length; i++)
            {
                var msg = _messages[i];
                var isLast = i == _messages.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-3">
                        <div class="flex items-start gap-3">
                            <AvatarCn Class="size-7 shrink-0">
                                <AvatarFallbackCn Class="text-[10px]">@msg.SenderInitials</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="min-w-0 flex-1">
                                <p class="text-sm">
                                    <span class="font-medium">@msg.Sender</span>
                                    <span class="text-muted-foreground"> gave kudos to </span>
                                    <span class="font-medium">@msg.Recipient</span>
                                </p>
                                <div class="mt-1.5 flex items-center gap-1.5">
                                    <LucideIconCn Name="trophy" Size="12" Class="size-3 text-muted-foreground" />
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">@msg.Award</BadgeCn>
                                </div>
                                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">@msg.Message</p>
                                <div class="mt-2 flex items-center gap-3 text-xs text-muted-foreground">
                                    <span class="flex items-center gap-1">
                                        <LucideIconCn Name="heart" Size="12" Class="size-3" />
                                        @msg.Reactions
                                    </span>
                                    <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                                    <span>@msg.Timestamp</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">@_messages.Length kudos this week</span>
        </div>
    </div>
</section>

@code {
    private record KudosMessage(
        string Id,
        string Sender,
        string SenderInitials,
        string Recipient,
        string Award,
        string Message,
        string Timestamp,
        int Reactions
    );

    private static readonly KudosMessage[] _messages =
    [
        new("1", "Sarah Chen",    "SC", "Product Team",     "Best UX Design",        "Incredible work on the redesign that earned us the Best UX Design award. The attention to detail was remarkable.",                      "2 hours ago",  12),
        new("2", "Marcus Rivera", "MR", "Elena Kowalski",   "Innovation Excellence", "Your AI integration prototype was the reason we won Innovation Excellence at TechCrunch. Well deserved!",                               "5 hours ago",   8),
        new("3", "Aisha Patel",   "AP", "Engineering",      "Reliability Award",     "99.99% uptime this quarter sealed the Reliability Award. The on-call rotations paid off.",                                             "Yesterday",     15),
        new("4", "James OBrien",  "JO", "Design Team",      "Webby Award",           "The landing page that won us a Webby was a masterclass in simplicity. Proud to work alongside you all.",                               "2 days ago",    21),
        new("5", "Lina Yamamoto", "LY", "Customer Success", "Customer Choice",       "Our NPS score drove the Customer Choice win at G2. Every support ticket you resolved mattered.",                                       "3 days ago",     9),
    ];
}
