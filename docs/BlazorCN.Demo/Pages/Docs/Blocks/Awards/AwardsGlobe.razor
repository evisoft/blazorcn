@* ============================================================
   Block: awards-globe
   Title: AwardsGlobe
   Description: International awards organized by geographic region with country details
   Source: original/blocks/awards/awards-globe.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="globe" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">International Awards</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_totalAwards awards across @_regions.Length regions
            </p>
        </div>

        <div class="divide-y">
            @foreach (var region in _regions)
            {
                <div class="px-4 py-3">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="flex h-5 w-7 items-center justify-center rounded border bg-muted/50 font-mono text-[10px] font-medium text-muted-foreground">
                            @region.Flag
                        </span>
                        <span class="text-xs font-medium">@region.Region</span>
                        <span class="ml-auto text-xs tabular-nums text-muted-foreground">
                            @region.Awards.Length
                        </span>
                    </div>
                    <div class="space-y-1.5 pl-9">
                        @foreach (var award in region.Awards)
                        {
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="trophy" Size="12" Class="h-3 w-3 shrink-0 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <span class="text-xs font-medium">@award.Title</span>
                                    <span class="text-xs text-muted-foreground"> &middot; @award.Org</span>
                                </div>
                                <span class="shrink-0 text-[10px] text-muted-foreground">
                                    @award.Country
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record AwardItem(string Title, string Org, string Country);
    private record RegionAwards(string Region, string Flag, AwardItem[] Awards);

    private static readonly RegionAwards[] _regions =
    [
        new("North America", "NA", [
            new("Product of the Year", "SaaS Awards",  "United States"),
            new("Innovation Leader",   "CIX Top 20",   "Canada"),
        ]),
        new("Europe", "EU", [
            new("Best Enterprise Tool", "SaaStock",    "Ireland"),
            new("Digital Champion",     "Web Summit",  "Portugal"),
        ]),
        new("Asia Pacific", "AP", [
            new("Top Tech Company",       "APAC CIO Outlook", "Singapore"),
            new("Innovation Excellence",  "Tech in Asia",     "Japan"),
        ]),
        new("Latin America", "LA", [
            new("Best SaaS Platform", "LatAm Tech Awards", "Brazil"),
        ]),
    ];

    private static readonly int _totalAwards = _regions.Sum(r => r.Awards.Length);
}
