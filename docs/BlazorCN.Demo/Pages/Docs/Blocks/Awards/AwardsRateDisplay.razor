@* ============================================================
   Block: awards-rate-display
   Title: AwardsRateDisplay
   Description: A rate display awards block for React and Next.js with large center-stage percentage, supporting context, and submission details built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-rate-display.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Acceptance Rate</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">Award submission success rate</p>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                    Since @_since
                </BadgeCn>
            </div>
        </div>

        <div class="border-b px-4 py-8 text-center">
            <div class="flex items-baseline justify-center gap-1">
                <span class="text-5xl font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">@_rate</span>
                <span class="text-2xl font-semibold text-emerald-600 dark:text-emerald-400">%</span>
            </div>
            <p class="mt-2 text-sm text-muted-foreground">
                Based on @_submissions submissions across @_categories categories
            </p>
        </div>

        <div class="border-b">
            <div class="grid grid-cols-3">
                <div class="border-r px-4 py-3 text-center">
                    <span class="text-lg font-semibold tabular-nums">@_submissions</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">Submitted</p>
                </div>
                <div class="border-r px-4 py-3 text-center">
                    <span class="text-lg font-semibold tabular-nums">@_accepted</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">Accepted</p>
                </div>
                <div class="px-4 py-3 text-center">
                    <span class="text-lg font-semibold tabular-nums">@(_submissions - _accepted)</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">Declined</p>
                </div>
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="h-1.5 rounded-full bg-muted/50">
                <div class="h-1.5 rounded-full bg-emerald-500 transition-all duration-500"
                     style="@($"width:{_rate}%")"></div>
            </div>
            <div class="mt-2 flex items-center justify-between text-xs text-muted-foreground">
                <span>0%</span>
                <span>100%</span>
            </div>
        </div>
    </div>
</section>

@code {
    private const double _rate = 94.7;
    private const int _submissions = 156;
    private const int _accepted = 148;
    private const int _categories = 12;
    private const int _since = 2020;
}
