@* ============================================================
   Block: awards-gala-invitation
   Title: AwardsGalaInvitation
   Description: Block example: awards
   Source: original/blocks/awards/awards-gala-invitation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex flex-col items-center gap-2 border-b px-6 py-8 text-center">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-muted">
                <LucideIconCn Name="trophy" Size="20" Class="h-5 w-5 text-muted-foreground" />
            </div>
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                You are cordially invited
            </p>
            <h2 class="text-2xl font-semibold tracking-tight">Annual Excellence Awards Gala</h2>
            <p class="max-w-sm text-sm text-muted-foreground">
                Join us for an evening celebrating outstanding achievements across the industry.
            </p>
        </div>

        <div class="divide-y">
            @foreach (var detail in _details)
            {
                <div class="flex items-center gap-4 px-6 py-4">
                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        <LucideIconCn Name="@detail.Icon" Size="16" Class="h-4 w-4 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="text-xs font-medium text-muted-foreground">@detail.Label</p>
                        <p class="text-sm font-medium">@detail.Value</p>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-6 py-5">
            <p class="mb-3 text-sm font-medium">Award categories</p>
            <div class="flex flex-wrap gap-2">
                @foreach (var cat in _categories)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary">@cat</BadgeCn>
                }
            </div>
        </div>

        <div class="flex flex-col gap-3 border-t px-6 py-5 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-xs text-muted-foreground">
                Seats are limited. RSVP by <span class="font-medium text-foreground">November 30, 2025</span>.
            </p>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">
                    Decline
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="gap-2">
                    <LucideIconCn Name="circle-check-big" Size="16" Class="h-4 w-4" />
                    RSVP Now
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record EventDetail(string Icon, string Label, string Value);

    private static readonly EventDetail[] _details =
    [
        new("calendar", "Date", "Saturday, December 13, 2025"),
        new("clock", "Time", "7:00 PM — 11:00 PM"),
        new("map-pin", "Venue", "The Grand Ballroom, Meridian Hotel"),
        new("shirt", "Dress code", "Black tie"),
    ];

    private static readonly string[] _categories =
    [
        "Innovation of the Year",
        "Best Product Design",
        "Leadership Excellence",
        "Sustainability Award",
        "Community Impact",
        "Rising Star",
    ];
}
