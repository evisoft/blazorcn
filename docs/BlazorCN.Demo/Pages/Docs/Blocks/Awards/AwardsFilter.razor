@* ============================================================
   Block: awards-filter
   Title: AwardsFilter
   Description: Awards section with filter chips for browsing by category or year
   Source: original/blocks/awards/awards-filter.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Browse awards</h2>
            <p class="mt-1 text-sm text-muted-foreground">Filter by category or year</p>
        </div>

        <div class="space-y-3 border-b px-6 py-4">
            <div class="flex flex-wrap items-center gap-2">
                <span class="mr-1 text-xs text-muted-foreground">Category:</span>
                @foreach (var category in _categories)
                {
                    var cat = category;
                    <ToggleCn Pressed="@(_selectedCategory == cat)"
                              PressedChanged="@(_ => _selectedCategory = cat)"
                              Size="ToggleSize.Sm"
                              Variant="ToggleVariant.Outline">
                        @cat
                    </ToggleCn>
                }
            </div>

            <div class="flex flex-wrap items-center gap-2">
                <span class="mr-1 text-xs text-muted-foreground">Year:</span>
                @foreach (var year in _years)
                {
                    var yr = year;
                    <ToggleCn Pressed="@(_selectedYear == yr)"
                              PressedChanged="@(_ => _selectedYear = yr)"
                              Size="ToggleSize.Sm"
                              Variant="ToggleVariant.Outline">
                        @yr
                    </ToggleCn>
                }
            </div>
        </div>

        @{
            var filteredAwards = _awards.Where(a =>
                (_selectedCategory == "All" || a.Category == _selectedCategory) &&
                (_selectedYear == "All" || a.Year == _selectedYear)).ToList();
        }
        @if (filteredAwards.Count > 0)
        {
            <div class="divide-y">
                @foreach (var award in filteredAwards)
                {
                    <div class="flex items-center gap-3 px-6 py-3 transition-colors hover:bg-muted/50">
                        <LucideTrophyCn Size="16" Class="h-4 w-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium">@award.Title</p>
                            <p class="text-xs text-muted-foreground">@award.Org</p>
                        </div>
                        <span class="shrink-0 text-xs text-muted-foreground">@award.Year</span>
                        <span class="shrink-0 rounded-md bg-muted/50 px-2 py-0.5 text-xs text-muted-foreground">
                            @award.Category
                        </span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="px-6 py-8 text-center text-sm text-muted-foreground">
                No awards found for the selected filters.
            </div>
        }
    </div>
</section>

@code {
    private string _selectedCategory = "All";
    private string _selectedYear = "All";

    private static readonly string[] _categories = ["All", "Product", "Design", "Innovation"];
    private static readonly string[] _years = ["All", "2024", "2023"];

    private record AwardItem(string Title, string Org, string Year, string Category);

    private static readonly AwardItem[] _awards =
    [
        new("Product of the Year", "TechCrunch", "2024", "Product"),
        new("Best UX Design", "Awwwards", "2024", "Design"),
        new("Innovation Award", "CES", "2024", "Innovation"),
        new("Customer Choice", "G2 Crowd", "2023", "Product"),
        new("Design Excellence", "Red Dot", "2023", "Design"),
        new("Startup Award", "Forbes", "2023", "Innovation"),
    ];
}
