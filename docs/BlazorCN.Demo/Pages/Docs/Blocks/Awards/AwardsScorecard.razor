@* ============================================================
   Block: awards-scorecard
   Title: AwardsScorecard
   Description: Single award deep-dive with score breakdown and category ratings
   Source: original/blocks/awards/awards-scorecard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Award scorecard</h2>
            <p class="mt-1 text-muted-foreground text-sm">Detailed evaluation breakdown</p>
        </div>

        @* Featured award header *@
        <div class="flex items-center gap-4 border-b px-6 py-5">
            <LucideIconCn Name="trophy" Size="16" Class="h-4 w-4 shrink-0 text-muted-foreground" />
            <div class="min-w-0 flex-1">
                <h3 class="text-sm font-medium">Best SaaS Product 2024</h3>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Global Technology Awards &middot; Enterprise Category
                </p>
            </div>
            <div class="text-right">
                <p class="text-2xl font-semibold tabular-nums">9.4</p>
                <p class="text-xs text-muted-foreground">/10</p>
            </div>
        </div>

        @* Category scores *@
        <div class="border-b px-6 py-5">
            <p class="mb-4 text-xs font-medium text-muted-foreground">Category scores</p>
            <div class="space-y-4">
                @foreach (var category in _categories)
                {
                    <div class="space-y-1.5">
                        <div class="flex items-center justify-between text-sm">
                            <span class="font-medium">@category.Name</span>
                            <span class="tabular-nums text-muted-foreground">@category.Score</span>
                        </div>
                        <ProgressCn Class="h-1.5" Value="@((int)(category.Score * 10))" />
                    </div>
                }
            </div>
        </div>

        @* Judge quote *@
        <div class="px-6 py-5">
            <div class="rounded-md bg-muted/50 p-4">
                <div class="mb-2 flex items-center gap-2">
                    <LucideIconCn Name="quote" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                    <span class="text-xs font-medium text-muted-foreground">Judge's comment</span>
                </div>
                <p class="text-sm text-muted-foreground">
                    "An exceptional product that combines innovation with practical value. The attention
                    to UX detail sets it apart from every other submission in the category."
                </p>
                <p class="mt-2 text-xs text-muted-foreground">— Sarah Chen, Lead Judge</p>
            </div>
        </div>
    </div>
</section>

@code {
    private record AwardCategory(string Name, double Score);

    private static readonly AwardCategory[] _categories =
    [
        new("Innovation",   9.2),
        new("UX Design",    9.6),
        new("Performance",  9.1),
        new("Value",        9.8),
    ];
}
