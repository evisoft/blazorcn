@* ============================================================
   Block: awards-grid-animate
   Title: AwardsGridAnimate
   Description: An animated awards grid block for React and Next.js with staggered entrance animations, hover lift effects, and a responsive card layout built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-grid-animate.tsx
   ============================================================ *@

<style>
    @@keyframes agFadeInUp {
        from { opacity: 0; transform: translateY(12px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .ag-enter {
        animation: agFadeInUp var(--ag-dur, 0.3s) ease-out both;
        animation-delay: var(--ag-delay, 0s);
    }
</style>

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card ag-enter"
         style="--ag-dur:0.4s; --ag-delay:0s;">

        @* Header *@
        <div class="border-b px-4 py-3 ag-enter"
             style="--ag-dur:0.3s; --ag-delay:0.05s;">
            <h2 class="text-sm font-medium">Awards &amp; Recognition</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Our recent achievements
            </p>
        </div>

        @* Grid *@
        <div class="grid gap-px bg-border sm:grid-cols-2">
            @for (var i = 0; i < _awards.Length; i++)
            {
                var award = _awards[i];
                var delay = (0.1 + i * 0.07).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                <div class="bg-card p-4 transition hover:bg-muted/50 hover:-translate-y-0.5 ag-enter"
                     style="@(FormattableString.Invariant($"--ag-dur:0.3s; --ag-delay:{delay}s;"))">
                    <div class="flex items-start gap-3">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="trophy" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@award.Name</span>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                @award.Org
                            </p>
                            <div class="mt-2 flex items-center gap-2">
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                    @award.Category
                                </BadgeCn>
                                <span class="text-[10px] text-muted-foreground tabular-nums">
                                    @award.Year
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5 ag-enter"
             style="--ag-dur:0.3s; --ag-delay:0.6s;">
            <span class="text-xs text-muted-foreground">
                @_awards.Length awards across multiple categories
            </span>
        </div>
    </div>
</section>

@code {
    private record Award(string Id, string Name, string Org, string Category, string Year);

    private static readonly Award[] _awards =
    [
        new("1", "Product of the Year",  "Global Technology Awards", "Enterprise", "2025"),
        new("2", "Best User Experience", "UX Design Awards",          "Design",     "2025"),
        new("3", "Innovation Leader",    "Forrester Research",        "Strategy",   "2024"),
        new("4", "Top Rated Platform",   "G2 Crowd",                  "Reviews",    "2024"),
        new("5", "Design Excellence",    "Webby Awards",              "Web App",    "2024"),
        new("6", "Customer Choice",      "TrustRadius",               "Dev Tools",  "2025"),
    ];
}
