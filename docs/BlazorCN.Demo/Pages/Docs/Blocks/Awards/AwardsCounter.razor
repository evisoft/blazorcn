@* ============================================================
   Block: awards-counter
   Title: Awards Counter
   Description: Awards section with animated counters and achievement statistics
   Long Description: Two awards side-by-side comparing year-over-year recognition with scores and highlights
   Dependencies: LucideGlobeCn, LucideStarCn, LucideTrophyCn, LucideUsersCn
   Source: original/blocks/awards/awards-counter.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">By the numbers</h2>
            <p class="mt-1 text-sm text-muted-foreground">Milestones that tell our story</p>
        </div>

        <div class="grid grid-cols-2 border-b sm:grid-cols-4">
            @for (var i = 0; i < _stats.Length; i++)
            {
                var stat = _stats[i];
                var borderClass = i < _stats.Length - 1 ? "border-b sm:border-b-0 sm:border-r" : "";
                <div class="@borderClass">
                    <div class="flex flex-col items-center gap-1 p-4">
                        <LucideTrophyCn Class="mb-1 h-4 w-4 text-muted-foreground" Size="16" />
                        <p class="text-2xl font-semibold tabular-nums">@stat.Value@stat.Suffix</p>
                        <p class="text-xs text-muted-foreground">@stat.Label</p>
                    </div>
                </div>
            }
        </div>

        <div class="px-6 py-4">
            <p class="mb-3 text-xs font-medium text-muted-foreground">Recent recognition</p>
            <div class="flex flex-wrap items-center gap-3">
                @foreach (var award in _recent)
                {
                    <div class="flex items-center gap-2 rounded-md bg-muted/50 px-3 py-1.5">
                        <LucideTrophyCn class="h-3.5 w-3.5 text-muted-foreground" />
                        <span class="text-sm font-medium">@award.Title</span>
                        <span class="text-xs text-muted-foreground">@award.Org</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Value, string Suffix, string Label);
    private record RecentAward(string Title, string Org);

    private static readonly StatItem[] _stats =
    [
        new("50", "+", "Awards won"),
        new("98", "%", "Customer satisfaction"),
        new("25", "K+", "Happy customers"),
        new("40", "+", "Countries"),
    ];

    private readonly RecentAward[] _recent =
    [
        new("Best SaaS 2024", "TechCrunch"),
        new("Top Rated", "G2 Crowd"),
        new("Innovation Award", "CES"),
    ];
}
