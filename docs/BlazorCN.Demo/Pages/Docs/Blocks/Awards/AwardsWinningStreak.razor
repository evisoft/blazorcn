@* ============================================================
   Block: awards-winning-streak
   Title: AwardsWinningStreak
   Description: A winning streak awards block for React and Next.js with consecutive year display, streak badges, and historical streaks built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-winning-streak.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Winning Streak</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Consecutive years of recognition</p>
        </div>

        <div class="border-b px-4 py-5 text-center">
            <span class="text-3xl font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">
                @_currentStreakCount
            </span>
            <p class="mt-1 text-sm font-medium">Year Winning Streak</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Best in Class Award, @_currentStreakYears[0]-@_currentStreakYears[_currentStreakYears.Length - 1]
            </p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex flex-wrap items-center justify-center gap-1.5">
                @for (var i = 0; i < _currentStreakYears.Length; i++)
                {
                    var year = _currentStreakYears[i];
                    var isCurrent = i == _currentStreakYears.Length - 1;
                    if (isCurrent)
                    {
                        <BadgeCn Class="text-xs font-normal tabular-nums">@year</BadgeCn>
                    }
                    else
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal tabular-nums">@year</BadgeCn>
                    }
                }
            </div>
        </div>

        <div>
            <div class="border-b px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">Other Active Streaks</span>
            </div>
            @for (var i = 0; i < _previousStreaks.Length; i++)
            {
                var streak = _previousStreaks[i];
                var isLast = i == _previousStreaks.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-center justify-between px-4 py-2.5">
                        <div>
                            <span class="text-sm font-medium">@streak.Label</span>
                            <p class="mt-0.5 text-xs text-muted-foreground">@streak.Years</p>
                        </div>
                        <span class="text-sm font-semibold tabular-nums">@streak.Count@("yr")</span>
                    </div>
                </div>
            }
        </div>

        <div class="flex items-center gap-2 border-t px-4 py-2.5 text-xs text-muted-foreground">
            <span class="size-1.5 rounded-full bg-emerald-500"></span>
            <span>Current streak active</span>
        </div>

    </div>
</section>

@code {
    private record Streak(string Id, string Label, string Years, int Count);

    private static readonly int[] _currentStreakYears =
        [2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025, 2026];

    private static readonly int _currentStreakCount = _currentStreakYears.Length;

    private static readonly Streak[] _previousStreaks =
    [
        new("1", "Design Excellence", "2018-2026", 9),
        new("2", "Customer Choice", "2020-2025", 6),
        new("3", "Innovation Award", "2012-2014", 3),
    ];
}
