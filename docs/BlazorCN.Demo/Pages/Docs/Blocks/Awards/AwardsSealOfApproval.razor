@* ============================================================
   Block: awards-seal-of-approval
   Title: AwardsSealOfApproval
   Description: Seal of approval showcase displaying official certifications and endorsements from trusted authorities
   Source: original/blocks/awards/awards-seal-of-approval.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-check" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Seals of Approval</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Independently verified certifications and compliance
            </p>
        </div>

        <div class="divide-y">
            @foreach (var seal in _seals)
            {
                <div class="px-4 py-3">
                    <div class="flex items-start gap-3">
                        <LucideIconCn Name="check-circle" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-emerald-600" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <p class="text-sm font-medium">@seal.Name</p>
                                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                            </div>
                            <p class="text-xs text-muted-foreground">
                                @seal.Authority &middot; Valid until @seal.ValidUntil
                            </p>
                            <p class="mt-1 text-xs text-muted-foreground">@seal.Description</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="flex items-center justify-between border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                6 active certifications &middot; All independently audited
            </p>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                View reports
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Seal(string Name, string Authority, string Status, string ValidUntil, string Description);

    private static readonly Seal[] _seals =
    [
        new("SOC 2 Type II", "AICPA", "active", "Dec 2025", "Security, availability, and confidentiality controls verified"),
        new("ISO 27001", "ISO/IEC", "active", "Mar 2026", "Information security management system certified"),
        new("GDPR Compliant", "EU Data Protection", "renewed", "Ongoing", "Full compliance with European data protection regulation"),
        new("HIPAA Compliant", "HHS Office for Civil Rights", "active", "Jun 2025", "Healthcare data handling and privacy standards met"),
        new("PCI DSS Level 1", "PCI Security Standards Council", "active", "Sep 2025", "Highest level of payment card data security compliance"),
        new("CSA STAR Level 2", "Cloud Security Alliance", "active", "Nov 2025", "Third-party audit of cloud security controls"),
    ];
}
