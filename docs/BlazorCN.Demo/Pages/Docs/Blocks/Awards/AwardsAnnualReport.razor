@* ============================================================
   Block: awards-annual-report
   Title: Awards Annual Report
   Description: Awards section formatted as a year-in-review report card with quarterly breakdowns
   Long Description: Your year of wins, at a glance. This React awards annual report presents a single year's recognition in a structured report-card format with summary stats, quarterly award breakdowns, and an aggregate recognition score. Built with Tailwind CSS and Lucide icons. Unlike a timeline spanning multiple years, this goes deep on one year. Perfect for annual review pages, investor decks, or year-end marketing campaigns.
   Dependencies: LucideCalendarCn, LucideTrophyCn
   Source: original/blocks/awards/awards-annual-report.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">2024 Year in Review</h2>
            <p class="mt-1 text-muted-foreground text-sm">A summary of our recognition this year.</p>
        </div>

        @* Summary stats *@
        <div class="flex items-center gap-3 border-b px-6 py-4">
            <LucideCalendarCn class="h-4 w-4 text-muted-foreground" />
            <p class="text-sm text-muted-foreground">
                @for (var i = 0; i < _summary.Length; i++)
                {
                    <span>
                        <span class="font-medium text-foreground">@_summary[i].Value</span>
                        @(" ")@_summary[i].Label.ToLower()
                    </span>
                    @if (i < _summary.Length - 1)
                    {
                        <span class="mx-2 text-muted-foreground/40">&middot;</span>
                    }
                }
            </p>
        </div>

        @* Quarterly breakdown *@
        <div class="divide-y">
            @foreach (var item in _quarters)
            {
                <div class="flex items-center gap-4 px-6 py-3.5">
                    <span class="w-8 shrink-0 font-mono text-xs font-medium text-muted-foreground">@item.Quarter</span>
                    <LucideTrophyCn class="h-3.5 w-3.5 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@item.Title</p>
                        <p class="text-xs text-muted-foreground">@item.Org</p>
                    </div>
                </div>
            }
        </div>

        @* Recognition score *@
        <div class="border-t bg-muted/50 px-6 py-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-muted-foreground">Total recognition score</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">Weighted by award prestige and reach</p>
                </div>
                <p class="text-2xl font-semibold tabular-nums">94.2</p>
            </div>
        </div>
    </div>
</section>

@code {
    private record SummaryStat(string Label, string Value);
    private record QuarterAward(string Quarter, string Title, string Org);

    private readonly SummaryStat[] _summary =
    [
        new("Awards", "6"),
        new("Categories", "4"),
        new("Countries", "3"),
    ];

    private readonly QuarterAward[] _quarters =
    [
        new("Q1", "Top Rated Product", "G2 Crowd"),
        new("Q2", "Innovation Excellence", "Tech Leaders Summit"),
        new("Q3", "Best Enterprise Platform", "SaaS Awards"),
        new("Q4", "Product of the Year", "Global Technology Awards"),
    ];
}
