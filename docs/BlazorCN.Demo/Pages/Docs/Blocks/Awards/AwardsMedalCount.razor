@* ============================================================
   Block: awards-medal-count
   Title: AwardsMedalCount
   Description: An Olympic-style medal tally block for React and Next.js with gold, silver, and bronze columns, category rows, large tabular numbers, and total medal counts built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-medal-count.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Medal Tally</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Achievement medals across all categories
            </p>
        </div>

        @* Table header *@
        <div class="grid grid-cols-[1fr_60px_60px_60px_60px] gap-0 border-b bg-muted/30 px-4 py-2">
            <span class="text-xs font-medium text-muted-foreground">Category</span>
            <span class="text-center text-xs font-medium text-amber-600 dark:text-amber-400">Gold</span>
            <span class="text-center text-xs font-medium text-muted-foreground">Silver</span>
            <span class="text-center text-xs font-medium text-amber-800 dark:text-amber-600">Bronze</span>
            <span class="text-center text-xs font-medium text-muted-foreground">Total</span>
        </div>

        @* Table rows *@
        <div>
            @foreach (var item in _entries.Select((e, i) => new { Entry = e, Idx = i }))
            {
                var isLast = item.Idx == _entries.Length - 1;
                var rowTotal = item.Entry.Gold + item.Entry.Silver + item.Entry.Bronze;
                <div class="@(Cn.Merge("grid grid-cols-[1fr_60px_60px_60px_60px] gap-0 px-4 py-2.5 transition-colors hover:bg-muted/50", !isLast ? "border-b" : ""))">
                    <span class="text-sm">@item.Entry.Category</span>
                    <span class="text-center text-sm font-semibold tabular-nums text-amber-600 dark:text-amber-400">
                        @item.Entry.Gold
                    </span>
                    <span class="text-center text-sm tabular-nums text-muted-foreground">
                        @item.Entry.Silver
                    </span>
                    <span class="text-center text-sm tabular-nums text-amber-800 dark:text-amber-600">
                        @item.Entry.Bronze
                    </span>
                    <span class="text-center text-sm font-medium tabular-nums">
                        @rowTotal
                    </span>
                </div>
            }
        </div>

        @* Totals footer *@
        <div class="grid grid-cols-[1fr_60px_60px_60px_60px] gap-0 border-t bg-muted/30 px-4 py-2.5">
            <span class="text-xs font-medium text-muted-foreground">Total</span>
            <span class="text-center text-sm font-semibold tabular-nums text-amber-600 dark:text-amber-400">
                @_totalsGold
            </span>
            <span class="text-center text-sm font-semibold tabular-nums text-muted-foreground">
                @_totalsSilver
            </span>
            <span class="text-center text-sm font-semibold tabular-nums text-amber-800 dark:text-amber-600">
                @_totalsBronze
            </span>
            <span class="text-center text-sm font-semibold tabular-nums">
                @_totalMedals
            </span>
        </div>
    </div>
</section>

@code {
    private record MedalEntry(string Id, string Category, int Gold, int Silver, int Bronze);

    private static readonly MedalEntry[] _entries =
    [
        new("1", "Engineering Excellence", 5, 3, 7),
        new("2", "Product Innovation",     3, 6, 2),
        new("3", "Customer Success",       4, 2, 5),
        new("4", "Design Quality",         2, 4, 3),
        new("5", "Team Collaboration",     6, 1, 4),
        new("6", "Sustainability Impact",  1, 3, 2),
    ];

    private static readonly int _totalsGold   = _entries.Sum(e => e.Gold);
    private static readonly int _totalsSilver = _entries.Sum(e => e.Silver);
    private static readonly int _totalsBronze = _entries.Sum(e => e.Bronze);
    private static readonly int _totalMedals  = _totalsGold + _totalsSilver + _totalsBronze;
}
