@* ============================================================
   Block: awards-sidebar
   Title: AwardsSidebar
   Description: Narrow vertical sidebar layout for embedding award recognition alongside other content
   Source: original/blocks/awards/awards-sidebar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-xs p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-semibold text-sm tracking-tight">Awards</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Industry recognition</p>
        </div>

        <div>
            @for (var i = 0; i < _awards.Length; i++)
            {
                var award = _awards[i];
                var isLast = i == _awards.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-2.5 px-4 py-2.5", isLast ? "" : "border-b")">
                    <span class="size-1.5 shrink-0 rounded-full bg-muted-foreground/40"></span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center justify-between gap-2">
                            <span class="truncate font-medium text-xs">@award.Title</span>
                            <span class="shrink-0 text-muted-foreground text-xs tabular-nums">@award.Year</span>
                        </div>
                        <p class="text-muted-foreground text-xs">@award.Org</p>
                    </div>
                </div>
            }
        </div>

        <div class="border-t bg-muted/50 px-4 py-2.5">
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="trophy" Size="12" Class="h-3 w-3" />
                <span>@_awards.Length awards earned</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record Award(string Id, string Title, string Org, string Year);

    private static readonly Award[] _awards =
    [
        new("product", "Product of the Year", "TechCrunch", "2024"),
        new("innovation", "Innovation Award", "Web Summit", "2024"),
        new("customer", "Customer Choice", "G2 Crowd", "2023"),
        new("design", "Best UX Design", "Webby Awards", "2023"),
    ];
}
