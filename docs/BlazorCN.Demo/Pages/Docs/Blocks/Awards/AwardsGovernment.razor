@* ============================================================
   Block: awards-government
   Title: AwardsGovernment
   Description: Government and regulatory awards, certifications, and compliance recognitions
   Source: original/blocks/awards/awards-government.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="building" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Government &amp; Regulatory</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Certifications and recognitions from public institutions
            </p>
        </div>

        <div class="divide-y">
            @foreach (var award in _govAwards)
            {
                <div class="flex items-start gap-3 px-4 py-3">
                    <LucideIconCn Name="@award.IconName" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center justify-between gap-2">
                            <p class="text-sm font-medium">@award.Title</p>
                            <span class="flex shrink-0 items-center gap-1 text-xs text-emerald-600">
                                <LucideIconCn Name="check-circle-2" Size="12" Class="h-3 w-3" />
                                @award.Status
                            </span>
                        </div>
                        <p class="text-xs text-muted-foreground">@award.Agency</p>
                        <p class="mt-0.5 text-[10px] text-muted-foreground">@award.Type</p>
                        <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                            @award.Detail
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record GovAward(string Title, string Agency, string Type, string Status, string Detail, string IconName);

    private static readonly GovAward[] _govAwards =
    [
        new("FedRAMP Authorized (Moderate)", "General Services Administration", "Cloud Authorization", "Active",
            "Authorized for use by all federal agencies at the moderate impact level", "shield-check"),
        new("StateRAMP Authorized", "StateRAMP PMO", "State-Level Authorization", "Active",
            "Approved for state and local government cloud deployments", "building"),
        new("GSA Schedule 70 Contract", "General Services Administration", "Federal Contract", "Active",
            "Pre-approved procurement vehicle for all federal agencies", "file-text"),
        new("DISA Impact Level 4", "Defense Information Systems Agency", "DoD Authorization", "Active",
            "Cleared for controlled unclassified information in defense environments", "shield-check"),
        new("Government Innovation Award", "Government Technology Magazine", "Industry Award", "2025 Winner",
            "Recognized for modernizing legacy government workflows", "building"),
    ];
}
