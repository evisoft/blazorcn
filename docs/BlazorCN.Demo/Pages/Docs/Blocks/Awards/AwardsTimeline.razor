@* ============================================================
   Block: awards-timeline
   Title: Awards Timeline
   Description: Awards timeline section with chronological year markers for React about pages
   Long Description: Awards section with a single-line scrolling news ticker of award announcements
   Dependencies: LucideTrophyCn
   Source: original/blocks/awards/awards-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Years of Recognition</h2>
            <p class="mt-1 text-muted-foreground text-sm">A timeline of achievements reflecting sustained excellence.</p>
        </div>

        <div class="p-6">
            @for (var idx = 0; idx < _timeline.Length; idx++)
            {
                var yearGroup = _timeline[idx];
                var isLast = idx == _timeline.Length - 1;
                <div class="relative pb-6 last:pb-0">
                    @* Connector line *@
                    @if (!isLast)
                    {
                        <div class="absolute left-[15px] top-8 h-full w-px bg-border"></div>
                    }

                    <div class="flex items-start gap-4">
                        @* Year marker *@
                        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border bg-muted/50 font-mono text-xs font-medium">
                            @yearGroup.Year[2..]
                        </div>

                        <div class="flex-1 space-y-2 pt-0.5">
                            <p class="text-xs font-medium text-muted-foreground">@yearGroup.Year</p>
                            @foreach (var award in yearGroup.Awards)
                            {
                                <div class="flex items-center gap-2 rounded-md bg-muted/50 px-3 py-2">
                                    <LucideTrophyCn class="h-3.5 w-3.5 shrink-0 text-muted-foreground" />
                                    <div class="min-w-0">
                                        <p class="text-sm font-medium">@award.Title</p>
                                        <p class="text-xs text-muted-foreground">@award.Org</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TimelineAward(string Title, string Org);
    private record YearGroup(string Year, TimelineAward[] Awards);

    private readonly YearGroup[] _timeline =
    [
        new("2024", [new("Best in Class", "Software Awards"), new("Innovation Leader", "Tech Excellence")]),
        new("2023", [new("Top Rated Product", "G2 Crowd"), new("Editor's Choice", "PCMag")]),
        new("2022", [new("Rising Star", "Gartner"), new("Best UX", "Awwwards")]),
    ];
}
