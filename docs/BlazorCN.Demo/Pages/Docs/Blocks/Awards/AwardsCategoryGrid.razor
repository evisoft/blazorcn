@* ============================================================
   Block: awards-category-grid
   Title: AwardsCategoryGrid
   Description: Awards organized by category in a structured grid layout
   Source: original/blocks/awards/awards-category-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Awards by Category</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Recognition across every dimension</p>
        </div>

        <div class="grid grid-cols-1 gap-px bg-border sm:grid-cols-2">
            @foreach (var cat in _categories)
            {
                <div class="bg-card px-4 py-4">
                    <div class="flex items-center gap-2 mb-3">
                        <LucideIconCn Name="@cat.Icon" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">@cat.Name</span>
                    </div>
                    <div class="space-y-2">
                        @foreach (var award in cat.Awards)
                        {
                            <div>
                                <p class="text-sm font-medium">@award.Title</p>
                                <p class="text-xs text-muted-foreground">@award.Org &middot; @award.Year</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record AwardItem(string Title, string Org, string Year);
    private record CategoryGroup(string Name, string Icon, AwardItem[] Awards);

    private static readonly CategoryGroup[] _categories =
    [
        new("Product", "trophy",
        [
            new("Product of the Year", "SaaS Awards", "2025"),
            new("Best New Product", "Product Hunt", "2024"),
        ]),
        new("Engineering", "code",
        [
            new("Best API Design", "DevOps World", "2025"),
            new("Open Source Champion", "GitHub", "2024"),
        ]),
        new("Design", "palette",
        [
            new("Best UX", "Webby Awards", "2025"),
            new("Design Excellence", "Awwwards", "2024"),
        ]),
        new("Security", "shield-check",
        [
            new("SOC 2 Type II", "AICPA", "2025"),
            new("Best Security Practice", "CSA", "2024"),
        ]),
        new("Culture", "users",
        [
            new("Best Places to Work", "Glassdoor", "2025"),
            new("Top Employer", "Forbes", "2024"),
        ]),
        new("Innovation", "award",
        [
            new("Innovation Leader", "Gartner", "2025"),
            new("Breakthrough Award", "CES", "2024"),
        ]),
    ];
}
