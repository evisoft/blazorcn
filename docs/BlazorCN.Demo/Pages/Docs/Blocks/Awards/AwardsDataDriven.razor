@* ============================================================
   Block: awards-data-driven
   Title: AwardsDataDriven
   Description: Data-driven impact awards with concrete metrics and measurable outcomes
   Source: original/blocks/awards/awards-data-driven.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Data-Driven Awards</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Recognition backed by measurable outcomes
            </p>
        </div>

        <div class="divide-y">
            @foreach (var award in _awards)
            {
                <div class="px-4 py-4">
                    <div class="flex items-start gap-3">
                        <LucideIconCn Name="@award.Icon" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium">@award.Title</p>
                            <p class="text-xs text-muted-foreground">
                                @award.Org &middot; @award.Year
                            </p>
                            <div class="mt-2 flex items-baseline gap-2">
                                <span class="text-2xl font-semibold tabular-nums">@award.Metric</span>
                                <span class="text-xs text-muted-foreground">@award.MetricLabel</span>
                            </div>
                            <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                                @award.Context
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record DataAward(string Title, string Org, string Year, string Metric, string MetricLabel, string Context, string Icon);

    private static readonly DataAward[] _awards =
    [
        new("Fastest Growing SaaS", "Deloitte Fast 500", "2025", "3,200%", "3-year revenue growth",
            "Ranked #12 among 500 fastest growing tech companies in North America", "trending-up"),
        new("Best Customer Retention", "SaaS Industry Awards", "2025", "97.3%", "Annual retention rate",
            "Highest retention rate in the enterprise developer tools category", "users"),
        new("Top Performing Platform", "Cloud Performance Index", "2024", "99.99%", "Uptime achieved",
            "Only 4.3 minutes of unplanned downtime across the entire calendar year", "bar-chart-3"),
        new("Innovation Excellence", "Tech Innovation Summit", "2024", "142", "Features shipped",
            "More product updates than any competitor in the same period", "award"),
    ];
}
