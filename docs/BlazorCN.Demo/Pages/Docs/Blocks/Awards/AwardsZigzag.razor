@* ============================================================
   Block: awards-zigzag
   Title: AwardsZigzag
   Description: Awards section with alternating left-right card layout creating a zigzag visual rhythm
   Source: original/blocks/awards/awards-zigzag.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Recognition &amp; Awards</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Achievements that reflect our commitment to excellence.
            </p>
        </div>

        <div class="relative px-6 py-8">
            @* Center connector line *@
            <div class="absolute inset-y-0 left-1/2 hidden w-px -translate-x-1/2 bg-border md:block"></div>

            <div class="space-y-6 md:space-y-8">
                @for (var index = 0; index < _awards.Length; index++)
                {
                    var award = _awards[index];
                    var isLeft = index % 2 == 0;
                    <div class="@Cn.Merge("relative md:w-[65%]", isLeft ? "md:mr-auto md:pr-8" : "md:ml-auto md:pl-8")">
                        @* Connector dot on center line *@
                        <div class="@Cn.Merge("absolute top-5 hidden size-2 rounded-full border bg-card md:block", isLeft ? "right-0 translate-x-1/2" : "left-0 -translate-x-1/2")"></div>

                        <div class="rounded-md border bg-card px-4 py-3 transition-colors hover:bg-muted/30">
                            <div class="flex items-start gap-3">
                                <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                                    <LucideIconCn Name="@award.Icon" Size="16" Class="size-4 text-muted-foreground" />
                                </div>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center justify-between gap-2">
                                        <p class="text-sm font-medium">@award.Title</p>
                                        <span class="shrink-0 font-mono text-xs text-muted-foreground">
                                            @award.Year
                                        </span>
                                    </div>
                                    <p class="mt-0.5 text-xs text-muted-foreground">@award.Organization</p>
                                    <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                                        @award.Description
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record AwardItem(string Title, string Organization, string Year, string Description, string Icon);

    private static readonly AwardItem[] _awards =
    [
        new("Product of the Year", "TechCrunch Disrupt", "2024",
            "Recognized for exceptional product innovation and market impact across the SaaS category.",
            "trophy"),
        new("Best Developer Experience", "DevTools Awards", "2024",
            "Awarded for intuitive API design, comprehensive documentation, and developer-first approach.",
            "star"),
        new("Excellence in Design", "Webby Awards", "2023",
            "Honored for outstanding interface design that balances aesthetics with usability.",
            "award"),
        new("Industry Leader", "Forrester Wave", "2023",
            "Named a leader in the component platform category for strategy and current offering.",
            "medal"),
    ];
}
