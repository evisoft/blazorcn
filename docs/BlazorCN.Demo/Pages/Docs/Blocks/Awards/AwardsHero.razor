@* ============================================================
   Block: awards-hero
   Title: AwardsHero
   Description: Awards section with large hero award and supporting grid
   Source: original/blocks/awards/awards-hero.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Award-Winning Product</h2>
            <p class="mt-1 text-muted-foreground text-sm">Industry-leading recognition</p>
        </div>

        @* Hero Award *@
        <div class="grid border-b md:grid-cols-2">
            <div class="flex items-center justify-center bg-muted/50 px-6 py-8">
                <div class="text-center">
                    <LucideIconCn Name="trophy" Size="32" Class="mx-auto mb-3 h-8 w-8 text-muted-foreground" />
                    <p class="text-xs font-medium text-muted-foreground">2024 Grand Winner</p>
                </div>
            </div>
            <div class="px-6 py-6">
                <p class="text-xs font-medium text-muted-foreground">Featured Award</p>
                <h3 class="mt-1 text-lg font-semibold">Product of the Year</h3>
                <p class="mt-0.5 text-sm text-muted-foreground">Global Technology Awards</p>
                <p class="mt-3 text-xs text-muted-foreground">
                    Selected from over 2,000 submissions across 50 countries.
                </p>
                <button
                    type="button"
                    class="mt-4 inline-flex items-center gap-1.5 rounded-md border px-3 py-1.5 text-xs font-medium transition-colors hover:bg-muted/50"
                >
                    Read more
                    <LucideIconCn Name="external-link" Size="12" Class="h-3 w-3" />
                </button>
            </div>
        </div>

        @* Supporting Awards *@
        <div class="grid sm:grid-cols-2">
            @foreach (var (award, index) in _supportingAwards.Select((a, i) => (a, i)))
            {
                <div class="@Cn.Merge("flex items-start gap-3 px-6 py-4", index < _supportingAwards.Length - 2 ? "border-b" : "", index % 2 == 0 ? "sm:border-r" : "", index == _supportingAwards.Length - 2 ? "sm:border-b" : "")">
                    <LucideIconCn Name="@award.Icon" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0">
                        <p class="text-sm font-medium">@award.Title</p>
                        <p class="text-xs text-muted-foreground">@award.Org · @award.Year</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record SupportingAward(string Icon, string Title, string Org, string Year);

    private static readonly SupportingAward[] _supportingAwards =
    [
        new("award",  "Innovation Leader", "Gartner",   "2024"),
        new("star",   "Customer Choice",   "G2 Crowd",  "2024"),
        new("medal",  "Best UX Design",    "Awwwards",  "2023"),
        new("trophy", "Startup of Year",   "TechCrunch","2023"),
    ];
}
