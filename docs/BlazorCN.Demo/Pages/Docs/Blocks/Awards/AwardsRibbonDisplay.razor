@* ============================================================
   Block: awards-ribbon-display
   Title: AwardsRibbonDisplay
   Description: Ribbon and medal display showcasing competition placements with visual ranking indicators
   Source: original/blocks/awards/awards-ribbon-display.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="medal" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Competition Results</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Placements across industry competitions
            </p>
        </div>

        <div class="divide-y">
            @foreach (var ribbon in _ribbons)
            {
                var style = _placementStyles[ribbon.Placement];
                <div class="flex items-center gap-3 px-4 py-3">
                    <div class="flex flex-col items-center gap-1">
                        <span class="@($"size-2 rounded-full {style.Dot}")" />
                        <span class="text-[9px] font-medium text-muted-foreground">
                            @style.Label
                        </span>
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@ribbon.Title</p>
                        <p class="text-xs text-muted-foreground">
                            @ribbon.Competition &middot; @ribbon.Year
                        </p>
                    </div>
                    <div class="flex flex-col items-end gap-0.5">
                        <span class="text-[10px] text-muted-foreground">@ribbon.Category</span>
                        <span class="text-[10px] text-muted-foreground">
                            of @ribbon.Competitors.ToString("N0") entries
                        </span>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-3">
                <LucideIconCn Name="award" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                <p class="text-xs text-muted-foreground">
                    3 gold, 1 silver, 1 bronze across 5,390+ total competitors
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private record RibbonAward(string Title, string Competition, string Year, string Placement, string Category, int Competitors);
    private record PlacementStyle(string Dot, string Label);

    private static readonly RibbonAward[] _ribbons =
    [
        new("Best Enterprise Platform",  "Global SaaS Awards",   "2025", "gold",   "Enterprise Software", 340),
        new("Most Innovative Product",   "TechCrunch Disrupt",   "2025", "gold",   "Developer Tools",     1200),
        new("Best User Experience",      "Webby Awards",         "2024", "silver", "SaaS & B2B",          890),
        new("Startup of the Year",       "Web Summit PITCH",     "2024", "bronze", "Growth Stage",        2400),
        new("Design Excellence",         "Red Dot Awards",       "2024", "gold",   "Digital Product",     560),
    ];

    private static readonly Dictionary<string, PlacementStyle> _placementStyles = new()
    {
        ["gold"]   = new("bg-amber-500", "1st Place"),
        ["silver"] = new("bg-zinc-400",  "2nd Place"),
        ["bronze"] = new("bg-amber-700", "3rd Place"),
    };
}
