@* ============================================================
   Block: awards-peek-drawer
   Title: AwardsPeekDrawer
   Description: An awards list block for React and Next.js with inline peek drawer expansion, smooth slide-down animation, and single-item-open accordion behavior built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-peek-drawer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Awards</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Click to peek at award details
            </p>
        </div>

        @* Award list with peek drawers *@
        <div>
            @for (var i = 0; i < _awards.Length; i++)
            {
                var award = _awards[i];
                var isExpanded = _expanded == award.Id;
                var isLast = i == _awards.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="() => _expanded = isExpanded ? null : award.Id"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <LucideTrophyCn Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@award.Name</span>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                @award.Org &middot; @award.Year
                            </p>
                        </div>
                        <LucideChevronRightCn Size="16"
                            Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-11">
                            <p class="mb-3 text-sm leading-relaxed text-muted-foreground">
                                @award.Description
                            </p>
                            <div class="flex items-center gap-2">
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                    @award.Category
                                </BadgeCn>
                                <span class="text-xs text-muted-foreground tabular-nums">
                                    @award.Year
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                @(_awards.Length) awards total
            </span>
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record Award(string Id, string Name, string Org, string Category, string Year, string Description);

    private static readonly Award[] _awards =
    [
        new("1", "Product of the Year", "Global Technology Awards", "Enterprise Software", "2025",
            "Recognized for outstanding innovation in enterprise collaboration tools, selected from over 1,200 submissions across 40 countries."),
        new("2", "Best User Experience", "UX Design Awards", "SaaS Platform", "2025",
            "Awarded for exceptional interface design and user-centered workflows that reduced onboarding time by 60%."),
        new("3", "Innovation Leader", "Forrester Research", "Collaboration Tools", "2024",
            "Named a Leader in the Forrester Wave for collaboration platforms, scoring highest in strategy and current offering."),
        new("4", "Top Rated Platform", "G2 Crowd", "Project Management", "2024",
            "Earned Top Rated status based on verified user reviews, with a 4.8/5 average across 2,400+ reviews."),
        new("5", "Design Excellence", "Webby Awards", "Web Application", "2024",
            "Honored for outstanding visual design, functionality, and user experience in the web application category."),
        new("6", "Customer Choice Award", "TrustRadius", "Developer Tools", "2025",
            "Voted best developer platform by verified users with a 9.2/10 satisfaction score across all evaluation criteria."),
    ];
}
