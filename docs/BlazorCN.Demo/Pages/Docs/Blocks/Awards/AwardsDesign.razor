@* ============================================================
   Block: awards-design
   Title: AwardsDesign
   Description: Design awards showcase in the style of Webby, Awwwards, and CSS Design Awards
   Source: original/blocks/awards/awards-design.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="palette" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Design Awards</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Recognized by the world's top design organizations
            </p>
        </div>

        <div class="divide-y">
            @foreach (var award in _designAwards)
            {
                <div class="flex items-center gap-3 px-4 py-3">
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@award.Title</p>
                        <p class="text-xs text-muted-foreground">
                            @award.Platform &middot; @award.Category
                        </p>
                        <p class="mt-0.5 font-mono text-[10px] text-muted-foreground">@award.Url</p>
                    </div>
                    <div class="text-right shrink-0">
                        <p class="text-sm font-semibold tabular-nums">@award.Score</p>
                        <p class="text-[10px] text-muted-foreground">@award.Year</p>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">5 design awards from 5 independent juries</p>
        </div>
    </div>
</section>

@code {
    private record DesignAward(string Platform, string Title, string Score, string Category, string Url, string Year);

    private static readonly DesignAward[] _designAwards =
    [
        new("Awwwards", "Site of the Day", "8.94", "Corporate / Business", "awwwards.com", "2025"),
        new("Webby Awards", "Best Visual Design — Function", "Winner", "Websites & Mobile Sites", "webbyawards.com", "2025"),
        new("CSS Design Awards", "Website of the Day", "9.1", "UI Design", "cssdesignawards.com", "2024"),
        new("FWA", "FWA of the Day", "Featured", "Web Application", "thefwa.com", "2024"),
        new("iF Design Award", "Gold — Digital Media", "Gold", "Service Design / UX", "ifdesign.com", "2024"),
    ];
}
