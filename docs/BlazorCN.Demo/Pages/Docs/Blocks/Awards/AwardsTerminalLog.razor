@* ============================================================
   Block: awards-terminal-log
   Title: AwardsTerminalLog
   Description: A CLI terminal-style awards display block for React and Next.js with dark terminal background, command syntax highlighting, and output formatting built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-terminal-log.tsx
   ============================================================ *@

@inject IJSRuntime JSRuntime

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="terminal" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-sm font-medium">awards.sh</span>
                <span class="text-xs text-muted-foreground">~/@_totalAwards records</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs" OnClick="HandleCopy">
                @if (_copied)
                {
                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                    <text> Copied</text>
                }
                else
                {
                    <LucideIconCn Name="copy" Size="12" Class="size-3" />
                    <text> Copy</text>
                }
            </ButtonCn>
        </div>

        <div class="overflow-x-auto bg-zinc-950 p-4">
            @foreach (var entry in _entries)
            {
                <div class="mb-3 last:mb-0">
                    <p class="font-mono text-xs leading-relaxed text-emerald-400">@entry.Command</p>
                    <p class="font-mono text-xs leading-relaxed text-zinc-500">@entry.Output</p>
                </div>
            }
            <div class="mt-4 flex items-center gap-1">
                <span class="font-mono text-xs text-emerald-400">$</span>
                <span class="inline-block h-3.5 w-1.5 animate-pulse bg-emerald-400"></span>
            </div>
        </div>
    </div>
</section>

@code {
    private record TerminalEntry(string Id, string Command, string Output);

    private static readonly TerminalEntry[] _entries =
    [
        new("1", "$ award --winner \"Product of the Year\" --org \"TechCrunch\" --year 2025",        "  status: won | category: product | verified: true"),
        new("2", "$ award --winner \"Best User Experience\" --org \"Webby Awards\" --year 2025",     "  status: won | category: design | verified: true"),
        new("3", "$ award --winner \"Innovation Excellence\" --org \"Fast Company\" --year 2024",    "  status: won | category: innovation | verified: true"),
        new("4", "$ award --winner \"Developer Tool of Year\" --org \"DevOps Awards\" --year 2024",  "  status: won | category: developer-tools | verified: true"),
        new("5", "$ award --winner \"Top 50 Startups\" --org \"Forbes Cloud 100\" --year 2023",      "  status: won | category: enterprise | verified: true"),
        new("6", "$ award --list --total",                                                           "  total: 5 awards | span: 2023-2025 | win-rate: 100%"),
    ];

    private static readonly int _totalAwards = _entries.Length - 1;

    private bool _copied;

    private async Task HandleCopy()
    {
        var text = string.Join("\n\n", _entries.Select(e => $"{e.Command}\n{e.Output}"));
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
