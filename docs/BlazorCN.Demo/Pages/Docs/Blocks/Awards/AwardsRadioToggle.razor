@* ============================================================
   Block: awards-radio-toggle
   Title: AwardsRadioToggle
   Description: A radio toggle filter block for React and Next.js with pill-style view switching between All, Won, Nominated, and Pending award statuses built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-radio-toggle.tsx
   ============================================================ *@

@{
    var filteredList = _activeStatus == "all"
        ? _awards.ToList()
        : _awards.Where(a => a.Status == _activeStatus).ToList();
}

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Toggle bar *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <div class="inline-flex items-center gap-0.5 rounded-md bg-muted/50 p-0.5">
                @foreach (var opt in _statusOptions)
                {
                    var optVal = opt.Value;
                    <button type="button"
                            @onclick="@(() => _activeStatus = optVal)"
                            class="@Cn.Merge("rounded-sm px-2.5 py-1 text-xs font-medium transition-all", _activeStatus == optVal ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")">
                        @opt.Label
                    </button>
                }
            </div>
            <span class="ml-auto text-xs text-muted-foreground tabular-nums">
                @filteredList.Count award@(filteredList.Count != 1 ? "s" : "")
            </span>
        </div>

        @* Award list *@
        <div>
            @if (filteredList.Count > 0)
            {
                @foreach (var (award, index) in filteredList.Select((a, i) => (a, i)))
                {
                    var isLast = index == filteredList.Count - 1;
                    <div class="@(isLast ? "" : "border-b")">
                        <div class="flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                            <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", StatusDot(award.Status))" />
                            <LucideTrophyCn Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium">@award.Name</span>
                                <p class="mt-0.5 text-xs text-muted-foreground">@award.Org</p>
                            </div>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-[10px] font-normal">
                                @StatusLabel(award.Status)
                            </BadgeCn>
                            <span class="shrink-0 text-xs text-muted-foreground tabular-nums">@award.Year</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="px-4 py-8 text-center text-sm text-muted-foreground">
                    No awards in this category
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <span>@_counts.Won won</span>
                <span class="size-1 rounded-full bg-muted-foreground/40" />
                <span>@_counts.Nominated nominated</span>
                <span class="size-1 rounded-full bg-muted-foreground/40" />
                <span>@_counts.Pending pending</span>
            </div>
        </div>
    </div>
</section>

@code {
    private string _activeStatus = "all";

    private record StatusOption(string Value, string Label);
    private record AwardItem(string Id, string Name, string Org, string Year, string Status);
    private record AwardCounts(int Won, int Nominated, int Pending);

    private static readonly StatusOption[] _statusOptions =
    [
        new("all", "All Awards"),
        new("won", "Won"),
        new("nominated", "Nominated"),
        new("pending", "Pending"),
    ];

    private static readonly AwardItem[] _awards =
    [
        new("1", "Product of the Year", "Global Technology Awards", "2025", "won"),
        new("2", "Best User Experience", "UX Design Awards", "2025", "won"),
        new("3", "Innovation Leader", "Forrester Research", "2024", "won"),
        new("4", "Rising Star Platform", "SaaS Awards", "2025", "nominated"),
        new("5", "Design Excellence", "Webby Awards", "2025", "nominated"),
        new("6", "Best Workplace Tech", "HR Tech Awards", "2025", "pending"),
        new("7", "Customer Choice Award", "TrustRadius", "2025", "pending"),
        new("8", "Sustainability Champion", "Green Business Awards", "2024", "won"),
    ];

    private static readonly AwardCounts _counts = new(
        Won: _awards.Count(a => a.Status == "won"),
        Nominated: _awards.Count(a => a.Status == "nominated"),
        Pending: _awards.Count(a => a.Status == "pending")
    );

    private static string StatusDot(string status) => status switch
    {
        "won" => "bg-emerald-500",
        "nominated" => "bg-blue-500",
        "pending" => "bg-amber-500",
        _ => ""
    };

    private static string StatusLabel(string status) => status switch
    {
        "won" => "Won",
        "nominated" => "Nominated",
        "pending" => "Pending",
        _ => status
    };
}
