@* ============================================================
   Block: awards-brand-recognition
   Title: AwardsBrandRecognition
   Description: Brand recognition showcase highlighting media mentions and industry acknowledgments
   Source: original/blocks/awards/awards-brand-recognition.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Brand Recognition</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">How the industry sees us</p>
        </div>

        <div class="divide-y">
            @foreach (var item in _recognitions)
            {
                <div class="px-4 py-4">
                    <div class="flex items-center gap-2 mb-2">
                        <LucideIconCn Name="@item.IconName" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">@item.Type</span>
                    </div>
                    <p class="text-sm font-medium">@item.Title</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@item.Source</p>
                    <p class="mt-2 text-xs text-muted-foreground leading-relaxed">@item.Detail</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record RecognitionItem(string Type, string IconName, string Title, string Source, string Detail);

    private static readonly RecognitionItem[] _recognitions =
    [
        new("Analyst Report", "book-open", "Named a Strong Performer", "Forrester Wave Report", "Recognized for vision and strategy in the developer platform market"),
        new("Media Feature", "newspaper", "Featured in Top 50 Startups", "TechCrunch", "Listed among the most promising enterprise software companies"),
        new("Community Vote", "message-square", "Most Loved Tool 2025", "Stack Overflow Survey", "Voted by 65,000+ developers as a top developer experience"),
        new("Market Growth", "trending-up", "Fastest Growing Platform", "Deloitte Fast 500", "3,200% revenue growth over the past three years"),
    ];
}
