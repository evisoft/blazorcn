@* ============================================================
   Block: awards-regional
   Title: AwardsRegional
   Description: Regional and local awards showcase organized by geographic market and territory
   Source: original/blocks/awards/awards-regional.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="map-pin" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Regional Awards</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">Recognized across global markets</p>
        </div>

        <div class="divide-y">
            @foreach (var region in _regions)
            {
                <div class="px-4 py-3">
                    <div class="flex items-center gap-2">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="text-xs font-medium">@region.Region</span>
                        <span class="ml-auto text-[10px] text-muted-foreground">
                            @region.Awards.Length @(region.Awards.Length == 1 ? "award" : "awards")
                        </span>
                    </div>
                    <div class="mt-2 ml-3.5 space-y-1.5">
                        @foreach (var award in region.Awards)
                        {
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="trophy" Size="12" Class="h-3 w-3 shrink-0 text-muted-foreground" />
                                <span class="text-xs font-medium">@award.Title</span>
                                <span class="text-[10px] text-muted-foreground">
                                    @award.Org &middot; @award.Year
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                Awards from 4 regions &middot; 15+ countries served
            </p>
        </div>
    </div>
</section>

@code {
    private record AwardEntry(string Title, string Org, string Year);
    private record RegionalAward(string Region, AwardEntry[] Awards);

    private static readonly RegionalAward[] _regions =
    [
        new("North America",
        [
            new("Best Enterprise Software", "SaaS Awards NA", "2025"),
            new("Top 10 Startup", "Forbes Cloud 100", "2024"),
        ]),
        new("Europe",
        [
            new("Technology Champion", "European Tech Awards", "2025"),
            new("Best B2B Solution", "SaaS Awards EMEA", "2024"),
        ]),
        new("Asia-Pacific",
        [
            new("Innovation Leader", "APAC Business Awards", "2025"),
            new("Best New Entrant", "Singapore Tech Awards", "2024"),
        ]),
        new("Latin America",
        [
            new("Best SaaS Platform", "LATAM Tech Summit", "2024"),
        ]),
    ];
}
