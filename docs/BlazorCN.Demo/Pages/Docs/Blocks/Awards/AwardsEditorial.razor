@* ============================================================
   Block: awards-editorial
   Title: AwardsEditorial
   Description: Editorial and press awards featuring publication recognition and editor picks
   Source: original/blocks/awards/awards-editorial.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Editorial Awards</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Recognized by leading tech publications
            </p>
        </div>

        <div class="divide-y">
            @foreach (var award in _editorialAwards)
            {
                <div class="px-4 py-4">
                    <div class="flex items-center gap-2 mb-1.5">
                        <LucideIconCn Name="@award.Icon" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">@award.Type</span>
                        <span class="text-xs text-muted-foreground">&middot;</span>
                        <span class="text-xs text-muted-foreground">@award.Date</span>
                    </div>
                    <p class="text-sm font-medium">@award.Publication</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@award.Title</p>
                    <div class="mt-2 rounded-md bg-muted/50 p-3">
                        <div class="flex items-start gap-2">
                            <LucideIconCn Name="quote" Size="12" Class="mt-0.5 h-3 w-3 shrink-0 text-muted-foreground" />
                            <div>
                                <p class="text-xs text-muted-foreground leading-relaxed">@award.Quote</p>
                                <p class="mt-1.5 text-[10px] text-muted-foreground">— @award.Author</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record EditorialAward(string Publication, string Title, string Type, string Quote, string Author, string Date, string Icon);

    private static readonly EditorialAward[] _editorialAwards =
    [
        new("TechCrunch", "Editor's Pick: Best Developer Tool 2025", "Editor's Pick",
            "A genuinely useful product that solves real problems without adding complexity.",
            "Sarah Perez, Senior Editor", "Feb 2025", "pen"),
        new("The Verge", "Featured in '10 Tools That Changed How We Work'", "Feature",
            "The kind of tool that makes you wonder how you worked without it.",
            "Dieter Bohn, Executive Editor", "Jan 2025", "newspaper"),
        new("Wired", "Wired Recommends — Productivity Category", "Recommendation",
            "Quietly becoming the backbone of modern development workflows.",
            "Boone Ashworth, Staff Writer", "Dec 2024", "book-open"),
    ];
}
