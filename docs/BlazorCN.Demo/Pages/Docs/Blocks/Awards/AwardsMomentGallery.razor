@* ============================================================
   Block: awards-moment-gallery
   Title: AwardsMomentGallery
   Description: A photo moments gallery block for React and Next.js with placeholder images, captions, hover overlays, and event details built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-moment-gallery.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="camera" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Award Moments</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Highlights from award ceremonies and events
            </p>
        </div>

        @* Photo grid *@
        <div class="grid grid-cols-3 gap-px bg-border p-px">
            @foreach (var moment in _moments)
            {
                <div class="group relative bg-card">
                    @* Photo placeholder *@
                    <div class="aspect-[4/3] bg-muted"></div>

                    @* Hover overlay *@
                    <div class="absolute inset-0 flex flex-col justify-end bg-black/0 p-3 transition-all duration-200 group-hover:bg-black/60">
                        <div class="translate-y-2 opacity-0 transition-all duration-200 group-hover:translate-y-0 group-hover:opacity-100">
                            <span class="text-xs font-medium text-white">
                                @moment.Event
                            </span>
                            <div class="mt-0.5 flex items-center gap-1.5 text-[10px] text-white/70">
                                <span>@moment.Date</span>
                                <span class="size-1 rounded-full bg-white/40"></span>
                                <span>@moment.People</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                @_moments.Length moments captured
            </span>
        </div>

    </div>
</section>

@code {
    private record GalleryMoment(string Id, string Event, string Date, string People);

    private static readonly GalleryMoment[] _moments =
    [
        new("1", "DevOps Awards Gala",          "Mar 2025", "Sarah, Marcus, Elena"),
        new("2", "SaaS Innovation Summit",       "Jan 2025", "David, Aisha"),
        new("3", "Webby Awards Ceremony",        "Nov 2024", "Full product team"),
        new("4", "Forbes Cloud 100 Dinner",      "Sep 2024", "Leadership team"),
        new("5", "Product Design Conference",    "Jun 2024", "Sarah, Aisha, Priya"),
        new("6", "Engineering Excellence Awards","Apr 2024", "Marcus, David, Leo"),
    ];
}
