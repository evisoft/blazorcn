@* ============================================================
   Block: awards-startup
   Title: AwardsStartup
   Description: Startup competition awards showcasing accelerator programs, pitch competitions, and emerging company recognition
   Source: original/blocks/awards/awards-startup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="rocket" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Startup Awards</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Competition wins and emerging company recognition
            </p>
        </div>

        <div class="divide-y">
            @foreach (var award in _awards)
            {
                <div class="flex items-start gap-3 px-4 py-3">
                    <LucideIconCn Name="@award.IconName" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@award.Title</p>
                        <p class="text-xs text-muted-foreground">
                            @award.Competition &middot; @award.Year
                        </p>
                        <p class="mt-1 text-xs text-muted-foreground">@award.Detail</p>
                    </div>
                    <span class="shrink-0 rounded-md bg-muted/50 px-2 py-1 text-[10px] font-medium text-muted-foreground">
                        @award.Highlight
                    </span>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                5 competition wins since founding &middot; Recognized by top-tier programs
            </p>
        </div>
    </div>
</section>

@code {
    private record StartupAward(string Title, string Competition, string Year, string Detail, string Highlight, string IconName);

    private static readonly StartupAward[] _awards =
    [
        new("Grand Prize Winner", "TechCrunch Disrupt Battlefield", "2025", "Selected from 200+ applicants worldwide", "$100K prize", "trophy"),
        new("Top 50 AI Startups", "CB Insights AI 50", "2025", "Recognized among the most promising AI companies globally", "2nd year", "sparkles"),
        new("Y Combinator Top Company", "YC W24 Batch", "2024", "Top performer in Winter 2024 batch of 240 companies", "Top 5%", "rocket"),
        new("Forbes 30 Under 30", "Forbes Enterprise Technology", "2024", "Co-founders recognized for disrupting enterprise workflows", "2 founders", "flame"),
        new("Emerging Startup Award", "Web Summit PITCH", "2024", "Winner of the largest startup pitch competition in Europe", "3,000+ entries", "trophy"),
    ];
}
