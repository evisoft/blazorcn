@* ============================================================
   Block: awards-testimonials
   Title: AwardsTestimonials
   Description: Awards section pairing each award with a judge or reviewer quote for social proof
   Source: original/blocks/awards/awards-testimonials.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">What the Judges Said</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Recognition backed by expert endorsement.
            </p>
        </div>

        <div class="divide-y">
            @foreach (var award in _awards)
            {
                <div class="grid gap-4 px-6 py-5 md:grid-cols-2 md:gap-6">
                    <div class="flex items-start gap-3">
                        <LucideIconCn Name="trophy" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
                        <div>
                            <p class="text-sm font-medium">@award.Title</p>
                            <p class="mt-0.5 text-xs text-muted-foreground">@award.Org</p>
                        </div>
                    </div>

                    <div class="rounded-md bg-muted/50 p-3">
                        <LucideIconCn Name="quote" Size="14" Class="mb-2 h-3.5 w-3.5 text-muted-foreground" />
                        <p class="text-sm leading-relaxed text-foreground">"@award.Quote"</p>
                        <div class="mt-2">
                            <p class="text-xs font-medium">@award.Judge</p>
                            <p class="text-xs text-muted-foreground">@award.JudgeTitle</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Award(string Title, string Org, string Quote, string Judge, string JudgeTitle);

    private static readonly Award[] _awards =
    [
        new("Best Enterprise Platform", "SaaS Awards 2024",
            "A clear step ahead of the competition in both reliability and developer experience.",
            "Sarah Chen", "Lead Judge, SaaS Awards"),
        new("Innovation Excellence", "Tech Leaders Summit 2024",
            "The most significant advancement in team collaboration we've evaluated this year.",
            "Marcus Rivera", "CTO, Tech Leaders Summit"),
        new("Customer Choice Award", "G2 Spring 2024",
            "Consistently rated highest by verified users for ease of use and customer support.",
            "Emily Nakamura", "VP of Research, G2 Crowd"),
    ];
}
