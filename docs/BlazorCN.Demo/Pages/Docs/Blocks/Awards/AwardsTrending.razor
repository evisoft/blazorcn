@* ============================================================
   Block: awards-trending
   Title: AwardsTrending
   Description: Trending and recent awards feed showing latest recognition in a chronological activity stream
   Source: original/blocks/awards/awards-trending.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="trending-up" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Trending Awards</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">Latest recognition and activity</p>
        </div>

        <div class="divide-y">
            @foreach (var item in _feed)
            {
                <div class="flex items-center gap-3 px-4 py-2.5">
                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", TypeColorClass(item.Type))"></span>
                    <LucideIconCn Name="@item.Icon" Size="14" Class="h-3.5 w-3.5 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <p class="truncate text-sm font-medium">@item.Title</p>
                        <p class="text-[10px] text-muted-foreground">@item.Org</p>
                    </div>
                    <span class="shrink-0 text-[10px] text-muted-foreground">@item.Time</span>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                7 recognitions in the last 3 weeks &middot; Momentum building
            </p>
        </div>
    </div>
</section>

@code {
    private record TrendingAward(string Title, string Org, string Time, string Type, string Icon);

    private static readonly TrendingAward[] _feed =
    [
        new("Named Leader in G2 Spring 2025 Grid",   "G2",                 "2 hours ago",  "ranking", "trending-up"),
        new("Won Best Developer Tool at DevWorld",    "DevWorld Conference","1 day ago",    "award",   "trophy"),
        new("Reached 4.9 rating on Capterra",         "Capterra",           "3 days ago",   "review",  "star"),
        new("Featured in Forrester Wave Report",      "Forrester Research", "5 days ago",   "feature", "sparkles"),
        new("Top 10 Fastest Growing SaaS",            "SaaS Mag",           "1 week ago",   "ranking", "zap"),
        new("Innovation Award at SaaStr Annual",      "SaaStr",             "2 weeks ago",  "award",   "award"),
        new("Best Enterprise Platform finalist",      "Cloud Awards",       "3 weeks ago",  "award",   "trophy"),
    ];

    private static string TypeColorClass(string type) => type switch
    {
        "award"   => "bg-amber-500",
        "ranking" => "bg-blue-500",
        "review"  => "bg-emerald-500",
        "feature" => "bg-violet-500",
        _         => ""
    };
}
