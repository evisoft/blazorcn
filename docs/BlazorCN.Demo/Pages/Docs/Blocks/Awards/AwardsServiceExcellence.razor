@* ============================================================
   Block: awards-service-excellence
   Title: AwardsServiceExcellence
   Description: Service excellence awards highlighting customer support and service quality recognition
   Source: original/blocks/awards/awards-service-excellence.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="headset" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Service Excellence</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Award-winning customer support and service quality
            </p>
        </div>

        <div class="divide-y">
            @foreach (var award in _awards)
            {
                <div class="flex items-center gap-3 px-4 py-3">
                    <LucideIconCn Name="@award.IconName" Size="16" Class="h-4 w-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@award.Title</p>
                        <p class="text-xs text-muted-foreground">
                            @award.Org &middot; @award.Year
                        </p>
                    </div>
                    <div class="flex flex-col items-end">
                        <span class="text-sm font-semibold tabular-nums">@award.MetricValue</span>
                        <span class="text-[10px] text-muted-foreground">@award.Metric</span>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="trophy" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                <p class="text-xs text-muted-foreground">
                    4 service awards &middot; 50,000+ tickets resolved with 98% satisfaction
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private record ServiceAward(string Title, string Org, string Year, string Metric, string MetricValue, string IconName);

    private static readonly ServiceAward[] _awards =
    [
        new("Best Customer Support", "Stevie Awards", "2025", "CSAT Score", "98.2%", "headset"),
        new("Fastest Response Time", "SupportWorld", "2025", "Avg Response", "< 2 min", "clock"),
        new("Customer Champion", "G2 Best Of", "2024", "Satisfaction", "4.9/5", "thumbs-up"),
        new("Excellence in Service", "HDI Service Management", "2024", "NPS Score", "+82", "message-square"),
    ];
}
