@* ============================================================
   Block: awards-masonry
   Title: AwardsMasonry
   Description: Awards section with masonry grid layout for varied card sizes
   Source: original/blocks/awards/awards-masonry.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">A collection of achievements</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Awards that reflect our commitment to excellence.
            </p>
        </div>

        <div class="columns-1 gap-4 p-6 sm:columns-2">
            @foreach (var award in _awards)
            {
                <div class="mb-4 break-inside-avoid rounded-md bg-muted/50 p-4">
                    <div class="mb-2 flex items-center justify-between">
                        <LucideIconCn Name="@award.IconName" Size="16" Class="h-4 w-4 text-muted-foreground" />
                        <span class="text-xs tabular-nums text-muted-foreground">@award.Year</span>
                    </div>
                    <p class="text-sm font-medium">@award.Title</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@award.Org</p>
                    @if (award.Description != null)
                    {
                        <p class="mt-2 text-xs text-muted-foreground">@award.Description</p>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Award(string IconName, string Title, string Org, string Year, string? Description = null);

    private static readonly Award[] _awards =
    [
        new("trophy", "Product of the Year", "TechCrunch Disrupt", "2024", "Recognized as the most innovative product across all categories."),
        new("star", "Best User Experience", "Awwwards", "2024"),
        new("award", "Innovation Excellence", "Fast Company", "2024", "Named to the list of World's Most Innovative Companies."),
        new("medal", "Customer Choice", "G2 Crowd", "2024"),
    ];
}
