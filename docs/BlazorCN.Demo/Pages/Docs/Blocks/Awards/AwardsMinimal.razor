@* ============================================================
   Block: awards-minimal
   Title: AwardsMinimal
   Description: Awards minimal list section with clean typography for React landing pages
   Source: original/blocks/awards/awards-minimal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Awards & Honors</h2>
            <p class="mt-1 text-muted-foreground text-sm">Recognition across the industry.</p>
        </div>

        <div>
            @foreach (var award in _awards)
            {
                <div class="flex items-center justify-between gap-4 border-b px-6 py-4 last:border-b-0">
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@award.Title</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">@award.Org</p>
                    </div>
                    <span class="shrink-0 text-xs tabular-nums text-muted-foreground">@award.Year</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record AwardItem(string Title, string Org, string Year);

    private static readonly AwardItem[] _awards =
    [
        new("Product of the Year", "TechCrunch Disrupt", "2024"),
        new("Best User Experience", "Webby Awards", "2024"),
        new("Innovation Excellence", "Fast Company", "2023"),
        new("Customer Choice", "G2 Crowd", "2023"),
    ];
}
