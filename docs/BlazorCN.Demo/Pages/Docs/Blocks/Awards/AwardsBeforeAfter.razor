@* ============================================================
   Block: awards-before-after
   Title: AwardsBeforeAfter
   Description: Awards section showing measurable before-and-after impact metrics that led to recognition
   Source: original/blocks/awards/awards-before-after.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Proven impact</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                The measurable results behind each award
            </p>
        </div>

        @foreach (var (award, index) in _awards.Select((a, i) => (a, i)))
        {
            <div class="@Cn.Merge("px-6 py-5", index < _awards.Length - 1 ? "border-b" : "")">
                <div class="flex items-start gap-3">
                    <LucideIconCn Name="@award.Icon" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <div class="flex items-baseline justify-between gap-2">
                            <h3 class="text-sm font-medium">@award.Title</h3>
                            <span class="shrink-0 text-xs text-muted-foreground tabular-nums">
                                @award.Year
                            </span>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">@award.Org</p>

                        <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2">
                            @foreach (var metric in award.Metrics)
                            {
                                <div class="rounded-md bg-muted/50 px-3 py-2">
                                    <p class="mb-1.5 text-xs font-medium text-muted-foreground">@metric.Label</p>
                                    <div class="flex items-center gap-2">
                                        <span class="font-mono text-xs text-red-500/80 tabular-nums">@metric.Before</span>
                                        <LucideIconCn Name="arrow-right" Size="12" Class="h-3 w-3 shrink-0 text-muted-foreground/60" />
                                        <span class="font-mono text-xs text-emerald-600 tabular-nums dark:text-emerald-500">
                                            @metric.After
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Metric(string Label, string Before, string After);
    private record AwardEntry(string Title, string Org, string Year, string Icon, Metric[] Metrics);

    private static readonly AwardEntry[] _awards =
    [
        new("Customer Experience Excellence", "CX Industry Awards", "2024", "trophy",
        [
            new("Customer Satisfaction", "72%", "96%"),
            new("Support Resolution", "48h", "4h"),
        ]),
        new("Best Engineering Team", "DevOps Excellence Awards", "2024", "zap",
        [
            new("Response Time", "4.2s", "0.8s"),
            new("Uptime", "99.1%", "99.99%"),
        ]),
        new("Innovation of the Year", "Global SaaS Awards", "2024", "award",
        [
            new("User Adoption", "12K", "84K"),
            new("Time to Value", "14 days", "2 days"),
        ]),
    ];
}
