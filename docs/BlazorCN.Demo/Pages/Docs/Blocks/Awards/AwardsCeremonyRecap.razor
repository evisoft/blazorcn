@* ============================================================
   Block: awards-ceremony-recap
   Title: AwardsCeremonyRecap
   Description: Award ceremony highlights with event details, photos description, and key moments
   Source: original/blocks/awards/awards-ceremony-recap.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Ceremony Recap</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Global Technology Awards 2025</p>
        </div>

        @* Event details *@
        <div class="border-b px-4 py-3">
            <div class="flex flex-wrap gap-4 text-xs text-muted-foreground">
                <span class="flex items-center gap-1.5">
                    <LucideCalendarCn class="h-3 w-3" />
                    March 15, 2025
                </span>
                <span class="flex items-center gap-1.5">
                    <LucideMapPinCn class="h-3 w-3" />
                    Moscone Center, San Francisco
                </span>
                <span class="flex items-center gap-1.5">
                    <LucideUsersCn class="h-3 w-3" />
                    2,400 attendees
                </span>
            </div>
        </div>

        @* Award won *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-md bg-muted/50">
                    <LucideTrophyCn class="h-5 w-5 text-muted-foreground" />
                </div>
                <div>
                    <p class="text-sm font-medium">Product of the Year</p>
                    <p class="text-xs text-muted-foreground">
                        Enterprise SaaS Category &middot; Grand Winner
                    </p>
                </div>
            </div>
            <p class="mt-3 text-xs text-muted-foreground leading-relaxed">
                Selected from over 2,000 submissions across 50 countries. The judges praised our
                innovative approach to workflow automation and the measurable impact on customer
                productivity.
            </p>
        </div>

        @* Key moments timeline *@
        <div class="px-4 py-4">
            <div class="flex items-center gap-1.5 mb-3">
                <LucideSparklesCn class="h-3 w-3 text-muted-foreground" />
                <span class="text-xs font-medium text-muted-foreground">Key moments</span>
            </div>
            <div class="space-y-3">
                @foreach (var item in _highlights)
                {
                    <div class="flex items-start gap-3">
                        <span class="shrink-0 font-mono text-xs tabular-nums text-muted-foreground w-14">
                            @item.Time
                        </span>
                        <p class="text-xs text-muted-foreground leading-relaxed">@item.Moment</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Highlight(string Time, string Moment);

    private static readonly Highlight[] _highlights =
    [
        new("7:00 PM", "Opening keynote on innovation in enterprise software"),
        new("8:15 PM", "Shortlist announced — named among top 5 finalists"),
        new("9:00 PM", "Product of the Year announced — our team takes the stage"),
        new("9:30 PM", "Acceptance speech by CEO highlighting the engineering team"),
    ];
}
