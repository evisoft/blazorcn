        @* Milestones *@
        <div class=""px-4 py-3"">
            <p class=""text-xs font-medium text-muted-foreground mb-2"">Key Milestones</p>
            <div class=""space-y-1.5"">
                @foreach (var milestone in _milestones)
                {
                    <div class=""flex items-center gap-2"">
                        <LucideStarCn class=""h-3 w-3 shrink-0 text-muted-foreground"" />
                        <span class=""text-xs text-muted-foreground"">@milestone</span>
                    </div>
                }
            </div>
        </div>

        <div class=""border-t px-4 py-3"">
            <div class=""flex items-center gap-2"">
                <LucideAwardCn class=""h-3.5 w-3.5 text-muted-foreground"" />
                <p class=""text-xs text-muted-foreground"">
                    Our most awarded year yet &middot; 24 wins across 12 categories
                </p>
            </div>
        </div>
    </div>
</section>

