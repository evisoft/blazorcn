@page "/docs/blocks/awards"
@layout DocsLayout

<PageTitle>Awards Blocks — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Awards</h1>
        <p class="mt-2 text-lg text-muted-foreground">Awards, recognition, and achievement showcase blocks.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Accordion" Description="Expandable award rows revealing description, criteria, and organization details on click." Code="@AwardsAccordionCode">
        <AwardsAccordion />
    </ComponentPreview>

    <ComponentPreview Title="Annual Report" Description="Awards section formatted as a year-in-review report card with quarterly breakdowns." Code="@AwardsAnnualReportCode">
        <AwardsAnnualReport />
    </ComponentPreview>

    <ComponentPreview Title="Badges" Description="Awards badges section with icon collection and trust signals." Code="@AwardsBadgesCode">
        <AwardsBadges />
    </ComponentPreview>

    <ComponentPreview Title="Banner" Description="Single-line announcement banner featuring one major award with a learn more link." Code="@AwardsBannerCode">
        <AwardsBanner />
    </ComponentPreview>

    <ComponentPreview Title="Carousel" Description="Awards carousel section with navigation arrows and dots." Code="@AwardsCarouselCode">
        <AwardsCarousel />
    </ComponentPreview>

    <ComponentPreview Title="Comparison" Description="Two awards side-by-side comparing year-over-year recognition with scores and highlights." Code="@AwardsComparisonCode">
        <AwardsComparison />
    </ComponentPreview>

    <ComponentPreview Title="Counter" Description="Awards section with animated counters and achievement statistics." Code="@AwardsCounterCode">
        <AwardsCounter />
    </ComponentPreview>

    <ComponentPreview Title="Featured" Description="Featured award section with single highlight and details." Code="@AwardsFeaturedCode">
        <AwardsFeatured />
    </ComponentPreview>

    <ComponentPreview Title="Marquee" Description="Awards section with horizontal scrolling logo strip." Code="@AwardsMarqueeCode">
        <AwardsMarquee />
    </ComponentPreview>

    <ComponentPreview Title="Spotlight" Description="Awards section with a clickable grid that opens a dialog with full award details." Code="@AwardsSpotlightCode">
        <AwardsSpotlight />
    </ComponentPreview>

    <ComponentPreview Title="Ticker" Description="Awards section with a single-line scrolling news ticker of award announcements." Code="@AwardsTickerCode">
        <AwardsTicker />
    </ComponentPreview>

    <ComponentPreview Title="Timeline" Description="Awards timeline section with chronological year markers." Code="@AwardsTimelineCode">
        <AwardsTimeline />
    </ComponentPreview>
</div>

@code {
    private const string AwardsAccordionCode = @"<section class=""mx-auto w-full max-w-4xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        <div class=""border-b px-6 py-5"">
            <h2 class=""font-semibold text-xl tracking-tight"">Awards &amp; recognition</h2>
            <p class=""mt-1 text-muted-foreground text-sm"">Click any award to see full details</p>
        </div>

        <div>
            @for (var i = 0; i < _awards.Count; i++)
            {
                var award = _awards[i];
                var isExpanded = _expanded == award.Id;
                var isLast = i == _awards.Count - 1;
                <div class=""@(isLast ? """" : ""border-b"")"">
                    <button type=""button""
                            @onclick=""() => _expanded = isExpanded ? null : award.Id""
                            class=""flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"">
                        <LucideTrophyCn Size=""16"" Class=""h-4 w-4 shrink-0 text-muted-foreground"" />
                        <div class=""min-w-0 flex-1"">
                            <span class=""font-medium text-sm"">@award.Title</span>
                            <p class=""mt-0.5 text-muted-foreground text-xs"">
                                @award.Org &middot; @award.Year
                            </p>
                        </div>
                        <LucideChevronRightCn Size=""16""
                            Class=""@Cn.Merge(""size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200"", isExpanded ? ""rotate-90"" : """")"" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class=""px-4 pb-4 pl-11"">
                            <p class=""text-muted-foreground text-sm leading-relaxed"">
                                @award.Description
                            </p>
                            <div class=""mt-3 rounded-md bg-muted/50 p-3"">
                                <span class=""font-medium text-muted-foreground text-xs"">
                                    Selection criteria
                                </span>
                                <p class=""mt-1 text-sm leading-relaxed"">@award.Criteria</p>
                            </div>
                            <div class=""mt-2 flex items-center gap-3 text-muted-foreground text-xs"">
                                <span>Category: @award.Category</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record AwardItem(string Id, string Title, string Year, string Org, string Category, string Description, string Criteria);

    private readonly List<AwardItem> _awards =
    [
        new(""product-year"", ""Product of the Year"", ""2024"", ""Global Technology Awards"", ""SaaS Platform"",
            ""Selected from 2,000+ submissions across 50 countries for innovative workflow automation and exceptional user experience design."",
            ""Evaluated on innovation impact, user adoption growth, and technical architecture quality.""),
        new(""innovation"", ""Innovation Excellence Award"", ""2024"", ""Tech Innovators Summit"", ""AI & Automation"",
            ""Recognized for AI-powered features that reduced customer onboarding time by 60% while maintaining enterprise-grade security."",
            ""Judged by a panel of 12 industry experts on measurable business impact and technical novelty.""),
        new(""customer-choice"", ""Customer Choice Award"", ""2024"", ""G2 Crowd"", ""Developer Tools"",
            ""Highest satisfaction score in category with 4.8/5 stars based on 1,200+ verified user reviews."",
            ""Based entirely on authenticated customer reviews, adoption rates, and net promoter scores.""),
        new(""design"", ""Best UX Design"", ""2023"", ""Webby Awards"", ""Enterprise Software"",
            ""Honored for delivering a consumer-grade experience in an enterprise product, setting a new standard for B2B design."",
            ""Selected by the International Academy of Digital Arts and Sciences from 3,000 entries.""),
    ];
}";
    private const string AwardsAnnualReportCode = @"<section class=""mx-auto w-full max-w-4xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        <div class=""border-b px-6 py-5"">
            <h2 class=""font-semibold text-xl tracking-tight"">2024 Year in Review</h2>
            <p class=""mt-1 text-muted-foreground text-sm"">A summary of our recognition this year.</p>
        </div>

        @* Summary stats *@
        <div class=""flex items-center gap-3 border-b px-6 py-4"">
            <LucideCalendarCn class=""h-4 w-4 text-muted-foreground"" />
            <p class=""text-sm text-muted-foreground"">
                @for (var i = 0; i < _summary.Length; i++)
                {
                    <span>
                        <span class=""font-medium text-foreground"">@_summary[i].Value</span>
                        @("" "")@_summary[i].Label.ToLower()
                    </span>
                    @if (i < _summary.Length - 1)
                    {
                        <span class=""mx-2 text-muted-foreground/40"">&middot;</span>
                    }
                }
            </p>
        </div>

        @* Quarterly breakdown *@
        <div class=""divide-y"">
            @foreach (var item in _quarters)
            {
                <div class=""flex items-center gap-4 px-6 py-3.5"">
                    <span class=""w-8 shrink-0 font-mono text-xs font-medium text-muted-foreground"">@item.Quarter</span>
                    <LucideTrophyCn class=""h-3.5 w-3.5 shrink-0 text-muted-foreground"" />
                    <div class=""min-w-0 flex-1"">
                        <p class=""text-sm font-medium"">@item.Title</p>
                        <p class=""text-xs text-muted-foreground"">@item.Org</p>
                    </div>
                </div>
            }
        </div>

        @* Recognition score *@
        <div class=""border-t bg-muted/50 px-6 py-5"">
            <div class=""flex items-center justify-between"">
                <div>
                    <p class=""text-xs font-medium text-muted-foreground"">Total recognition score</p>
                    <p class=""mt-0.5 text-xs text-muted-foreground"">Weighted by award prestige and reach</p>
                </div>
                <p class=""text-2xl font-semibold tabular-nums"">94.2</p>
            </div>
        </div>
    </div>
</section>

