            @for (var i = 0; i < _awards.Length; i++)
            {
                var award = _awards[i];
                var delay = (0.1 + i * 0.07).ToString(""F2"", System.Globalization.CultureInfo.InvariantCulture);
                <div class=""bg-card p-4 transition hover:bg-muted/50 hover:-translate-y-0.5 ag-enter""
                     style=""@(FormattableString.Invariant($""--ag-dur:0.3s; --ag-delay:{delay}s;""))"">
