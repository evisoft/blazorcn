@code {
    private record AwardItem(string Id, string Title, string Org, string Year, string Detail);

    private static readonly AwardItem[] _awards =
    [
        new(""product-year"", ""Product of the Year"", ""Global Technology Awards"", ""2024"", ""Selected from 2,000+ submissions across 50 countries.""),
        new(""innovation"", ""Innovation Excellence"", ""Tech Innovators Summit"", ""2024"", ""Recognized for AI features that cut onboarding time by 60%.""),
        new(""customer-choice"", ""Customer Choice Award"", ""G2 Crowd"", ""2023"", ""Highest satisfaction score in category with 4.8/5 stars.""),
    ];

    private int _activeIndex = 0;

    private void HandleCycle()
    {
        _activeIndex = (_activeIndex + 1) % _awards.Length;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == ""Enter"" || e.Key == "" "")
        {
            HandleCycle();
        }
    }

    private int GetOrder(int index)
    {
        return (index - _activeIndex + _awards.Length) % _awards.Length;
    }

    private string GetCardStyle(int order)
    {
        var scale = (1 - order * 0.04).ToString(""F2"", System.Globalization.CultureInfo.InvariantCulture);
        var opacity = order == 2 ? ""0.5"" : ""1"";
        return FormattableString.Invariant($""transform: translateY({order * 12}px) scale({scale}); z-index: {_awards.Length - order}; opacity: {opacity};"");
    }
}
";

