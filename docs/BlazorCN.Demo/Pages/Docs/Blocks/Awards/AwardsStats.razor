@* ============================================================
   Block: awards-stats
   Title: AwardsStats
   Description: Awards stats section with metrics and achievement highlights for React landing pages
   Source: original/blocks/awards/awards-stats.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Awards by the Numbers</h2>
            <p class="mt-1 text-muted-foreground text-sm">The metrics behind our recognition.</p>
        </div>

        @* Stats grid *@
        <div class="grid grid-cols-2 border-b lg:grid-cols-4">
            @for (var i = 0; i < _stats.Length; i++)
            {
                var stat = _stats[i];
                var isLast = i == _stats.Length - 1;
                <div class="@Cn.Merge("px-6 py-5", !isLast ? "border-r" : "")">
                    <LucideIconCn Name="@stat.Icon" Size="16" Class="mb-2 h-4 w-4 text-muted-foreground" />
                    <p class="text-2xl font-semibold tabular-nums">@stat.Value</p>
                    <p class="text-sm font-medium">@stat.Label</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@stat.Detail</p>
                </div>
            }
        </div>

        @* Recent highlights *@
        <div class="px-6 py-5">
            <p class="mb-3 text-xs font-medium text-muted-foreground">Recent Highlights</p>
            <div class="flex flex-wrap gap-2">
                @foreach (var item in _highlights)
                {
                    <div class="flex items-center gap-2 rounded-md bg-muted/50 px-3 py-1.5">
                        <LucideIconCn Name="trophy" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                        <span class="text-sm font-medium">@item.Award</span>
                        <span class="text-xs text-muted-foreground">&middot; @item.Org</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Stat(string Icon, string Value, string Label, string Detail);
    private record Highlight(string Award, string Org);

    private static readonly Stat[] _stats =
    [
        new("trophy", "24", "Awards won", "Across 5 categories"),
        new("users", "2,000+", "Competitors", "In our category"),
        new("calendar", "4", "Consecutive years", "As category leader"),
        new("target", "Top 1%", "Selection rate", "Of all submissions"),
    ];

    private static readonly Highlight[] _highlights =
    [
        new("Best Overall Product", "SaaS Awards 2024"),
        new("Innovation Excellence", "Tech Leaders 2024"),
        new("Customer Satisfaction", "G2 Spring 2024"),
    ];
}
