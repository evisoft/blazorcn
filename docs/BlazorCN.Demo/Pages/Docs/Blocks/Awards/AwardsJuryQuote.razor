@* ============================================================
   Block: awards-jury-quote
   Title: AwardsJuryQuote
   Description: A jury statement awards block for React and Next.js with blockquote excerpts, jury member attribution, left border accent, and staggered animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-jury-quote.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Jury Statements</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                What the judges said about our work
            </p>
        </div>

        <div>
            @for (var i = 0; i < _juryQuotes.Length; i++)
            {
                var item = _juryQuotes[i];
                var isLast = i == _juryQuotes.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-4">
                        <div class="mb-2 flex items-center gap-2">
                            <span class="text-sm font-medium">@item.Award</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                @item.Category
                            </BadgeCn>
                        </div>
                        <div class="border-l-2 border-muted-foreground/20 pl-3">
                            <LucideIconCn Name="quote" Size="12" Class="mb-1 size-3 text-muted-foreground/40" />
                            <p class="text-sm italic leading-relaxed text-muted-foreground">
                                @item.Quote
                            </p>
                        </div>
                        <div class="mt-2.5 pl-3">
                            <span class="text-xs font-medium">@item.JurorName</span>
                            <span class="mx-1.5 text-xs text-muted-foreground">/</span>
                            <span class="text-xs text-muted-foreground">@item.JurorTitle</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                @_juryQuotes.Length jury statements
            </span>
        </div>
    </div>
</section>

@code {
    private record JuryQuote(string Id, string Award, string Category, string Quote, string JurorName, string JurorTitle);

    private static readonly JuryQuote[] _juryQuotes =
    [
        new("1", "Product of the Year", "Enterprise Software",
            "What set this product apart was the rare combination of technical depth and effortless usability. The team demonstrated that enterprise software does not have to be painful.",
            "Dr. Elena Vasquez", "Chair, Global Technology Awards"),
        new("2", "Best User Experience", "SaaS Platform",
            "The attention to micro-interactions and progressive disclosure was extraordinary. Every screen felt considered, every transition purposeful. This is the standard others will chase.",
            "Marcus Chen", "Lead Judge, UX Design Awards"),
        new("3", "Innovation Leader", "Collaboration Tools",
            "We evaluated 340 products across 12 criteria. This platform scored highest in strategy, vision, and current offering. The innovation roadmap is years ahead of competitors.",
            "Sarah Okafor", "Principal Analyst, Forrester Research"),
        new("4", "People's Choice Award", "Developer Tools",
            "With over 18,000 community votes, this was the clear winner. Developers praised its intuitive API design and the speed at which new features ship without breaking changes.",
            "James Whitfield", "Committee Director, Dev Awards Summit"),
    ];
}
