@* ============================================================
   Block: awards-funnel
   Title: AwardsFunnel
   Description: Award selection funnel showing stages from application to winner with narrowing visual pipeline
   Source: original/blocks/awards/awards-funnel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Selection funnel</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                How we progressed through the 2024 Global Technology Awards.
            </p>
        </div>

        <div class="px-6 py-6">
            <div class="space-y-0">
                @for (int i = 0; i < _stages.Length; i++)
                {
                    var stage = _stages[i];
                    @if (i > 0)
                    {
                        <div class="flex justify-center py-2">
                            <LucideChevronDownCn class="h-4 w-4 text-muted-foreground/60" />
                        </div>
                    }
                    <div class="@Cn.Merge("mx-auto w-full", stage.Width)">
                        <div class="rounded-md bg-muted/50 px-4 py-3">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2.5">
                                    @if (stage.Highlight)
                                    {
                                        <LucideTrophyCn class="h-3.5 w-3.5 text-emerald-600 dark:text-emerald-500" />
                                    }
                                    <span class="text-xs font-medium text-muted-foreground">
                                        @stage.Label
                                    </span>
                                </div>
                                <span class="@Cn.Merge("text-2xl font-semibold tabular-nums", stage.Highlight ? "text-emerald-600 dark:text-emerald-500" : "text-foreground")">
                                    @stage.Count
                                </span>
                            </div>
                            @if (stage.Awards.Length > 0)
                            {
                                <div class="mt-1.5 flex flex-wrap gap-x-3 gap-y-0.5">
                                    @foreach (var award in stage.Awards)
                                    {
                                        <span class="text-xs text-muted-foreground">@award</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Summary footer *@
        <div class="border-t px-6 py-4">
            <p class="text-center text-xs text-muted-foreground">
                Top 8% selection rate across all categories
            </p>
        </div>
    </div>
</section>

@code {
    private record FunnelStage(string Label, int Count, string Width, string[] Awards, bool Highlight = false);

    private static readonly FunnelStage[] _stages =
    [
        new("Applied",     24, "max-w-full",    ["Best SaaS Product", "Innovation in Design"]),
        new("Shortlisted", 12, "max-w-[75%]",   ["Best SaaS Product", "Innovation in Design"]),
        new("Finalist",     5, "max-w-[50%]",   ["Best SaaS Product"]),
        new("Winner",       2, "max-w-[33%]",   ["Best SaaS Product"], Highlight: true),
    ];
}
