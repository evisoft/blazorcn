@* ============================================================
   Block: awards-rating-stars
   Title: AwardsRatingStars
   Description: Star rating-based awards display with review scores and platform ratings
   Source: original/blocks/awards/awards-rating-stars.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideStarCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                <h2 class="text-sm font-medium">Review Ratings</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Consistently top-rated across major review platforms
            </p>
        </div>

        <div class="divide-y">
            @foreach (var platform in _platforms)
            {
                <div class="flex items-center gap-3 px-4 py-3">
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@platform.Platform</p>
                        <p class="text-[10px] text-muted-foreground">@platform.Badge</p>
                    </div>
                    <div class="flex flex-col items-end gap-0.5">
                        <div class="flex items-center gap-1.5">
                            <div class="flex items-center gap-0.5">
                                @for (int i = 0; i < 5; i++)
                                {
                                    <LucideStarCn Size="12" Class="@GetStarClass(i, platform.Rating, platform.MaxRating)" />
                                }
                            </div>
                            <span class="font-mono text-sm font-semibold tabular-nums">
                                @platform.Rating
                            </span>
                            <span class="text-[10px] text-muted-foreground">/ @platform.MaxRating</span>
                        </div>
                        <span class="text-[10px] text-muted-foreground">
                            @platform.ReviewCount reviews
                        </span>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                6,200+ verified reviews &middot; 4.7 average rating
            </p>
        </div>
    </div>
</section>

@code {
    private record RatingPlatform(string Platform, double Rating, int MaxRating, string ReviewCount, string Badge);

    private static readonly RatingPlatform[] _platforms =
    [
        new("G2", 4.8, 5, "2,430", "Leader"),
        new("Capterra", 4.7, 5, "1,856", "Top Rated"),
        new("TrustRadius", 9.2, 10, "890", "Best of"),
        new("Gartner Peer Insights", 4.6, 5, "634", "Customers' Choice"),
        new("ProductHunt", 4.9, 5, "412", "#1 Product"),
    ];

    private static string GetStarClass(int i, double rating, int max)
    {
        var normalized = max == 10 ? rating / 2.0 : rating;
        var fullStars = (int)Math.Floor(normalized);
        var hasHalf = normalized - fullStars >= 0.5;

        if (i < fullStars)
            return "h-3 w-3 fill-amber-400 text-amber-400";
        if (i == fullStars && hasHalf)
            return "h-3 w-3 fill-amber-400/50 text-amber-400";
        return "h-3 w-3 text-muted-foreground/30";
    }
}
