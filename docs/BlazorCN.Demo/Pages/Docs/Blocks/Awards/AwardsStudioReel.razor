@* ============================================================
   Block: awards-studio-reel
   Title: AwardsStudioReel
   Description: A creative studio awards reel block for React and Next.js with project showcases, client names, award details, and horizontal card layout built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-studio-reel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Award-Winning Work</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Selected projects recognized by leading industry bodies
            </p>
        </div>

        <div class="flex gap-0 overflow-x-auto" tabindex="0" role="group" aria-label="Award-winning projects">
            @for (var i = 0; i < _projects.Length; i++)
            {
                var project = _projects[i];
                var isLast = i == _projects.Length - 1;
                <div class="@Cn.Merge("min-w-[280px] flex-1", isLast ? "" : "border-r")">
                    <div class="px-4 py-3">
                        <div class="flex items-center gap-1.5">
                            <LucideIconCn Name="award" Size="12" Class="size-3 text-amber-500" />
                            <span class="text-[10px] font-medium text-amber-600 dark:text-amber-400">
                                @project.AwardBody
                            </span>
                            <span class="ml-auto font-mono text-[10px] text-muted-foreground">
                                @project.Year
                            </span>
                        </div>
                        <h3 class="mt-2 text-sm font-medium">@project.Project</h3>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            for @project.Client
                        </p>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="mt-2 text-[10px] font-normal">
                            @project.Award
                        </BadgeCn>
                        <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                            @project.Description
                        </p>
                    </div>
                </div>
            }
        </div>

        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                @_projects.Length award-winning projects
            </span>
            <span class="flex items-center gap-1 text-xs text-muted-foreground">
                View all work
                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
            </span>
        </div>
    </div>
</section>

@code {
    private record StudioProject(string Id, string Project, string Client, string Award, string AwardBody, string Description, string Year);

    private static readonly StudioProject[] _projects =
    [
        new("1", "Meridian Brand Identity", "Meridian Health", "Best Brand Identity", "D&AD",
            "Complete rebrand for a healthcare platform including logo, type system, and guidelines", "2025"),
        new("2", "Volta Campaign", "Volta Energy", "Gold — Integrated Campaign", "Cannes Lions",
            "Multi-channel campaign for renewable energy provider driving 340% awareness lift", "2025"),
        new("3", "Noma Digital Experience", "Noma Restaurant", "Site of the Year", "Awwwards",
            "Immersive digital experience showcasing seasonal menus and foraging philosophy", "2024"),
        new("4", "Atlas Wayfinding System", "Atlas Airports", "Best Environmental Design", "Core77",
            "Airport wayfinding system serving 45 million passengers annually across 3 terminals", "2024"),
    ];
}
