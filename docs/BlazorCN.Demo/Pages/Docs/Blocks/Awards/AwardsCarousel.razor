@* ============================================================
   Block: awards-carousel
   Title: Awards Carousel
   Description: Awards carousel section with navigation arrows and dots for React landing pages
   Long Description: Awards bento grid section with varying card sizes for visual hierarchy on React landing pages
   Dependencies: ButtonCn, LucideChevronLeftCn, LucideChevronRightCn, LucideTrophyCn
   Source: original/blocks/awards/awards-carousel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Awards that inspire us</h2>
            <p class="mt-1 text-muted-foreground text-sm">Recognition across the industry</p>
        </div>

        <div class="relative px-6 py-8">
            <div class="mx-auto max-w-md text-center">
                <LucideTrophyCn Size="16" Class="mx-auto mb-4 h-4 w-4 text-muted-foreground" />
                <p class="mb-1 text-xs text-muted-foreground">
                    @_awards[_current].Year &middot; @_awards[_current].Org
                </p>
                <h3 class="text-sm font-medium">@_awards[_current].Title</h3>
                <p class="mt-2 text-xs text-muted-foreground italic">
                    &ldquo;@_awards[_current].Quote&rdquo;
                </p>
            </div>

            <div class="absolute left-2 top-1/2 -translate-y-1/2">
                <ButtonCn Class="h-7 w-7" @onclick="Prev" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="Previous">
                    <LucideChevronLeftCn Size="16" Class="h-4 w-4" />
                </ButtonCn>
            </div>
            <div class="absolute right-2 top-1/2 -translate-y-1/2">
                <ButtonCn Class="h-7 w-7" @onclick="Next" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="Next">
                    <LucideChevronRightCn Size="16" Class="h-4 w-4" />
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center justify-center gap-0.5 border-t px-6 py-3">
            @for (var i = 0; i < _awards.Count; i++)
            {
                var index = i;
                <button type="button"
                        class="inline-flex size-6 items-center justify-center"
                        aria-label="Go to award @(index + 1)"
                        @onclick="() => _current = index">
                    <span class="@Cn.Merge("h-1.5 rounded-full transition-all", index == _current ? "w-4 bg-foreground" : "w-1.5 bg-muted-foreground/30")"></span>
                </button>
            }
        </div>
    </div>
</section>

@code {
    private int _current;

    private void Next() => _current = (_current + 1) % _awards.Count;
    private void Prev() => _current = (_current - 1 + _awards.Count) % _awards.Count;

    private record AwardItem(string Title, string Org, string Year, string Quote);

    private readonly List<AwardItem> _awards =
    [
        new("Best SaaS Platform", "SaaS Awards", "2024", "Setting new standards in cloud software excellence."),
        new("Innovation Champion", "Tech Innovators", "2024", "Pioneering solutions that reshape industries."),
        new("Customer Choice Award", "G2 Crowd", "2024", "Voted #1 by users for three consecutive quarters."),
        new("Sustainability Leader", "Green Tech Awards", "2023", "Committed to carbon-neutral operations."),
    ];
}
