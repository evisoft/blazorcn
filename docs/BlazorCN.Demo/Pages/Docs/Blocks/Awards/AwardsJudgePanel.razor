@* ============================================================
   Block: awards-judge-panel
   Title: AwardsJudgePanel
   Description: Award judge panel display showing who evaluated and selected the winners
   Source: original/blocks/awards/awards-judge-panel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Judging Panel</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Global Technology Awards 2025</p>
        </div>

        @* Award context *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="trophy" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                <span class="text-xs text-muted-foreground">
                    Product of the Year &middot; Selected from 2,000+ submissions
                </span>
            </div>
        </div>

        @* Judges *@
        <div class="divide-y">
            @foreach (var judge in _judges)
            {
                <div class="flex items-start gap-3 px-4 py-3">
                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-muted/50">
                        <LucideIconCn Name="user" Size="16" Class="h-4 w-4 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@judge.Name</p>
                        <p class="text-xs text-muted-foreground">
                            @judge.Title, @judge.Organization
                        </p>
                        <p class="mt-0.5 text-[10px] text-muted-foreground">
                            Expertise: @judge.Expertise
                        </p>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                @(_judges.Length)-member independent panel &middot; Blind evaluation process
            </p>
        </div>
    </div>
</section>

@code {
    private record Judge(string Name, string Title, string Organization, string Expertise);

    private static readonly Judge[] _judges =
    [
        new("Dr. Sarah Chen",    "Chief Technology Officer", "Sequoia Capital",        "Enterprise Infrastructure"),
        new("David Kim",         "Partner",                  "Andreessen Horowitz",     "Developer Tools & AI"),
        new("Maria Santos",      "VP of Engineering",        "Google Cloud",            "Cloud Architecture"),
        new("Prof. James Morton","Department Chair",         "MIT CSAIL",               "Distributed Systems"),
        new("Lisa Park",         "Editor-in-Chief",          "InfoWorld",               "Enterprise Software"),
    ];
}
