@* ============================================================
   Block: awards-media-coverage
   Title: AwardsMediaCoverage
   Description: Media coverage summary of awards with publication logos and article counts
   Source: original/blocks/awards/awards-media-coverage.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="newspaper" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Media Coverage</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Award coverage across major publications
            </p>
        </div>

        <div class="flex gap-6 border-b px-4 py-3">
            <div>
                <p class="text-2xl font-semibold tabular-nums">@_outlets.Sum(o => o.Articles)</p>
                <p class="text-xs text-muted-foreground">Articles published</p>
            </div>
            <div>
                <p class="text-2xl font-semibold tabular-nums">@_outlets.Length</p>
                <p class="text-xs text-muted-foreground">Publications</p>
            </div>
            <div>
                <p class="text-2xl font-semibold tabular-nums">220M+</p>
                <p class="text-xs text-muted-foreground">Total reach</p>
            </div>
        </div>

        <div class="divide-y">
            @foreach (var outlet in _outlets)
            {
                <div class="px-4 py-3">
                    <div class="flex items-center justify-between gap-2">
                        <p class="text-sm font-medium">@outlet.Name</p>
                        <span class="text-xs tabular-nums text-muted-foreground">@outlet.Date</span>
                    </div>
                    <p class="mt-0.5 text-xs text-muted-foreground">@outlet.Headline</p>
                    <div class="mt-1 flex items-center gap-3 text-[10px] text-muted-foreground">
                        <span>
                            @outlet.Articles article@(outlet.Articles > 1 ? "s" : "")
                        </span>
                        <span>&middot;</span>
                        <span>@outlet.Reach</span>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <button type="button" class="inline-flex items-center gap-1 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground">
                View all press coverage
                <LucideIconCn Name="external-link" Size="12" Class="h-3 w-3" />
            </button>
        </div>
    </div>
</section>

@code {
    private record MediaOutlet(string Name, int Articles, string Reach, string Headline, string Date);

    private static readonly MediaOutlet[] _outlets =
    [
        new("TechCrunch",  3, "12M monthly readers",  "Startup Wins Product of the Year at Global Tech Awards",          "Mar 2025"),
        new("Forbes",      2, "140M monthly readers", "The 10 Most Innovative Companies You Should Watch in 2025",        "Feb 2025"),
        new("The Verge",   1, "35M monthly readers",  "This Tool Just Won the Webby — and It Deserves It",               "Jan 2025"),
        new("Wired",       2, "25M monthly readers",  "Inside the Platform That's Quietly Winning Every Award",           "Dec 2024"),
        new("VentureBeat", 4, "8M monthly readers",   "Enterprise Software Startup Continues Award Streak",              "Nov 2024"),
    ];
}
