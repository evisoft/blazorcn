@* ============================================================
   Block: awards-verified
   Title: AwardsVerified
   Description: Verified award certifications with validation status, verification links, and authenticity indicators
   Source: original/blocks/awards/awards-verified.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="badge-check" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Verified Certifications</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Independently verifiable awards and credentials
            </p>
        </div>

        <div class="divide-y">
            @foreach (var award in _awards)
            {
                <div class="px-4 py-3">
                    <div class="flex items-start gap-3">
                        <LucideIconCn Name="shield-check" Size="16" Class="@Cn.Merge("mt-0.5 h-4 w-4 shrink-0", award.Status == "verified" ? "text-emerald-600" : "text-muted-foreground/40")" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <p class="text-sm font-medium">@award.Title</p>
                                <span class="@Cn.Merge("size-1.5 rounded-full", award.Status == "verified" ? "bg-emerald-500" : "bg-amber-500")"></span>
                            </div>
                            <p class="text-xs text-muted-foreground">
                                @award.Org &middot; @award.VerifiedDate
                            </p>
                            <p class="mt-1 font-mono text-[10px] text-muted-foreground">
                                @award.CredentialId
                            </p>
                        </div>
                        <a href="@award.Url" target="_blank" rel="noopener noreferrer"
                           class="inline-flex items-center justify-center rounded-md font-medium ring-offset-background transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 h-6 gap-1 px-2 text-xs">
                            <LucideIconCn Name="external-link" Size="12" Class="h-3 w-3" />
                            Verify
                        </a>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                4 verified &middot; 1 pending &middot; All credentials independently auditable
            </p>
        </div>
    </div>
</section>

@code {
    private record VerifiedAward(string Title, string Org, string VerifiedDate, string Status, string CredentialId, string Url);

    private static readonly VerifiedAward[] _awards =
    [
        new("G2 Leader Spring 2025", "G2", "Mar 2025", "verified", "G2-LDR-2025-4821", "https://example.com"),
        new("SOC 2 Type II Certified", "AICPA", "Jan 2025", "verified", "SOC2-T2-2025-0093", "https://example.com"),
        new("ISO 27001:2022", "ISO/IEC", "Nov 2024", "verified", "ISO-27001-2024-1847", "https://example.com"),
        new("Best Enterprise Platform", "Cloud Awards", "Oct 2024", "verified", "CLA-ENT-2024-0562", "https://example.com"),
        new("HIPAA Compliance", "HHS", "Pending review", "pending", "HIPAA-2025-PENDING", "https://example.com"),
    ];
}
