@* ============================================================
   Block: awards-saas-category
   Title: AwardsSaasCategory
   Description: A SaaS product category awards block for React and Next.js with category groupings, G2-style ratings, review counts, and leader badges built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-saas-category.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">SaaS Category Awards 2025</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Top-rated products by category based on verified user reviews
            </p>
        </div>

        <div>
            @foreach (var entry in _categories.Select((cat, i) => new { Cat = cat, Idx = i }))
            {
                var isLast = entry.Idx == _categories.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-medium text-muted-foreground">
                                @entry.Cat.Category
                            </span>
                            <BadgeCn Variant="BadgeVariant.Secondary"
                                     Class="@Cn.Merge("text-[10px] font-medium", entry.Cat.Badge == "Leader" ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : "bg-blue-500/10 text-blue-600 dark:text-blue-400")">
                                @entry.Cat.Badge
                            </BadgeCn>
                        </div>
                        <div class="mt-1.5 flex items-center gap-2">
                            <LucideIconCn Name="trophy" Size="14" Class="size-3.5 shrink-0 text-amber-500" />
                            <span class="text-sm font-medium">@entry.Cat.Winner</span>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @entry.Cat.Description
                        </p>
                        <div class="mt-2 flex items-center gap-2">
                            <span class="inline-flex items-center gap-0.5" role="img" aria-label="@entry.Cat.Rating out of 5 stars">
                                @for (var i = 0; i < 5; i++)
                                {
                                    var fullStars = (int)Math.Floor(entry.Cat.Rating);
                                    var hasHalf = entry.Cat.Rating - fullStars >= 0.5;
                                    var starClass = i < fullStars
                                        ? "size-3 fill-amber-500 text-amber-500"
                                        : (i == fullStars && hasHalf
                                            ? "size-3 fill-amber-500/50 text-amber-500"
                                            : "size-3 fill-muted text-muted");
                                    <LucideIconCn Name="star" Size="12" Class="@starClass" />
                                }
                            </span>
                            <span class="text-xs font-medium tabular-nums">
                                @entry.Cat.Rating
                            </span>
                            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                            <span class="text-xs text-muted-foreground tabular-nums">
                                @entry.Cat.ReviewCount.ToString("N0") reviews
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                @_categories.Length categories evaluated
            </span>
        </div>
    </div>
</section>

@code {
    private record SaasCategory(string Id, string Category, string Winner, string Description, double Rating, int ReviewCount, string Badge);

    private static readonly SaasCategory[] _categories =
    [
        new("1", "Best CRM",           "Attio",   "Relationship intelligence platform for modern teams",      4.8, 2341, "Leader"),
        new("2", "Best Analytics",     "PostHog", "Open-source product analytics with session replay",        4.7, 1856, "Leader"),
        new("3", "Best DevTool",       "Linear",  "Issue tracking built for modern software teams",           4.9, 3102, "Leader"),
        new("4", "Best Design Tool",   "Figma",   "Collaborative interface design and prototyping",           4.7, 4510, "Leader"),
        new("5", "Best Communication", "Slack",   "Messaging and workflow automation for teams",              4.5, 5230, "High Performer"),
    ];
}
