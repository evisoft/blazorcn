@* ============================================================
   Block: awards-trend-arrows
   Title: AwardsTrendArrows
   Description: A trend arrows awards block for React and Next.js with year-over-year indicators, percentage change, and semantic color coding built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-trend-arrows.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Year-over-Year Trends</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Performance compared to last year
                    </p>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                    2025 vs 2024
                </BadgeCn>
            </div>
        </div>

        <div>
            @foreach (var item in _metrics.Select((m, i) => new { Metric = m, Index = i }))
            {
                <div class="@(item.Index < _metrics.Length - 1 ? "border-b" : "")">
                    <div class="flex items-center justify-between px-4 py-3">
                        <span class="text-sm font-medium">@item.Metric.Label</span>
                        <div class="flex items-center gap-3">
                            <span class="text-sm font-semibold tabular-nums">@item.Metric.Value</span>
                            <span class="@($"inline-flex items-center gap-1 rounded-md px-1.5 py-0.5 text-xs tabular-nums {TrendBg(item.Metric.Direction)} {TrendColor(item.Metric.Direction)}")">
                                @if (item.Metric.Direction == "up")
                                {
                                    <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3" />
                                }
                                else if (item.Metric.Direction == "down")
                                {
                                    <LucideIconCn Name="arrow-down-right" Size="12" Class="size-3" />
                                }
                                else
                                {
                                    <LucideIconCn Name="minus" Size="12" Class="size-3" />
                                }
                                @item.Metric.Change
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="flex items-center gap-2 border-t px-4 py-2.5 text-xs text-muted-foreground">
            <span class="flex items-center gap-1">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                @_metrics.Count(m => m.Direction == "up") improving
            </span>
            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
            <span class="flex items-center gap-1">
                <span class="size-1.5 rounded-full bg-red-500"></span>
                @_metrics.Count(m => m.Direction == "down") declining
            </span>
        </div>
    </div>
</section>

@code {
    private record TrendMetric(string Id, string Label, string Value, string Change, string Direction);

    private static readonly TrendMetric[] _metrics =
    [
        new("1", "Awards Won",        "14",    "+23%",  "up"),
        new("2", "New Categories",    "3",     "+50%",  "up"),
        new("3", "Win Rate",          "81%",   "+5%",   "up"),
        new("4", "Nominations",       "18",    "-10%",  "down"),
        new("5", "Industry Rankings", "Top 3", "0%",    "flat"),
        new("6", "Team Awards",       "6",     "+100%", "up"),
    ];

    private static string TrendColor(string direction) => direction switch
    {
        "up"   => "text-emerald-600 dark:text-emerald-400",
        "down" => "text-red-600 dark:text-red-400",
        _      => "text-muted-foreground",
    };

    private static string TrendBg(string direction) => direction switch
    {
        "up"   => "bg-emerald-500/10",
        "down" => "bg-red-500/10",
        _      => "bg-muted/50",
    };
}
