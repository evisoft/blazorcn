@* ============================================================
   Block: awards-checklist
   Title: AwardsChecklist
   Description: Award criteria checklist showing met and pending requirements for each award
   Source: original/blocks/awards/awards-checklist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Award criteria</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Requirements met for each award qualification.
            </p>
        </div>

        @for (int i = 0; i < _awards.Length; i++)
        {
            var award = _awards[i];
            var metCount = award.Criteria.Count(c => c.Met);
            var totalCount = award.Criteria.Length;

            <div class="@(Cn.Merge(i < _awards.Length - 1 ? "border-b" : ""))">
                @* Award header *@
                <div class="flex items-center gap-4 border-b px-6 py-4">
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@award.Title</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">@award.Organization</p>
                    </div>
                    <BadgeCn Variant="BadgeVariant.Secondary"
                             Class="@(Cn.Merge("tabular-nums", metCount == totalCount ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : ""))">
                        @metCount/@totalCount criteria met
                    </BadgeCn>
                </div>

                @* Criteria list *@
                <div>
                    @for (int ci = 0; ci < award.Criteria.Length; ci++)
                    {
                        var criterion = award.Criteria[ci];
                        <div class="@(Cn.Merge("flex items-start gap-3 px-6 py-3", ci < award.Criteria.Length - 1 ? "border-b" : ""))">
                            @if (criterion.Met)
                            {
                                <LucideIconCn Name="check" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-emerald-600 dark:text-emerald-400" />
                            }
                            else
                            {
                                <LucideIconCn Name="circle" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground/40" />
                            }
                            <span class="@(Cn.Merge("text-sm", criterion.Met ? "text-foreground" : "text-muted-foreground"))">
                                @criterion.Label
                            </span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Criterion(string Label, bool Met);
    private record Award(string Title, string Organization, Criterion[] Criteria);

    private static readonly Award[] _awards =
    [
        new("Best Developer Experience 2024", "DevTools Awards",
        [
            new("Average onboarding time under 5 minutes", true),
            new("Documentation coverage above 95%", true),
            new("API response time under 200ms (p99)", true),
            new("Community satisfaction score above 4.5/5", true),
            new("Accessibility compliance (WCAG 2.1 AA)", false),
        ]),
        new("Enterprise Security Excellence", "Cloud Security Alliance",
        [
            new("SOC 2 Type II certification", true),
            new("End-to-end encryption for data at rest and in transit", true),
            new("Zero critical vulnerabilities in annual penetration test", true),
            new("GDPR and CCPA compliance verified by third party", false),
        ]),
    ];
}
