@* ============================================================
   Block: awards-product-award
   Title: AwardsProductAward
   Description: Product-specific awards section highlighting individual product recognition and accolades
   Source: original/blocks/awards/awards-product-award.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="package" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Product Awards</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Recognition earned by each product individually
            </p>
        </div>

        <div class="divide-y">
            @for (var idx = 0; idx < _products.Length; idx++)
            {
                var product = _products[idx];
                var iconName = _icons[idx % _icons.Length];
                <div class="px-4 py-4">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="@iconName" Size="16" Class="h-4 w-4 text-muted-foreground" />
                        <p class="text-sm font-medium">@product.Product</p>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] px-1.5 py-0">
                            @(product.Awards.Length) awards
                        </BadgeCn>
                    </div>
                    <div class="mt-2 ml-6 space-y-1.5">
                        @foreach (var award in product.Awards)
                        {
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="shield-check" Size="12" Class="h-3 w-3 shrink-0 text-muted-foreground" />
                                <span class="text-xs font-medium">@award.Title</span>
                                <span class="text-[10px] text-muted-foreground">@award.Org</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                8 product awards across 3 products in 2024-2025
            </p>
        </div>
    </div>
</section>

@code {
    private record AwardItem(string Title, string Org, string Category);
    private record ProductAward(string Product, AwardItem[] Awards);

    private static readonly string[] _icons = ["package", "zap", "star"];

    private static readonly ProductAward[] _products =
    [
        new("Studio Pro",
        [
            new("Best Design Tool", "Webby Awards", "Creativity"),
            new("Editor's Pick", "ProductHunt", "Design"),
            new("Top Rated", "G2 Crowd", "Design Software"),
        ]),
        new("Deploy Engine",
        [
            new("Best DevOps Tool", "DevOps Excellence", "Infrastructure"),
            new("Innovation Award", "Cloud 100", "Platform"),
        ]),
        new("Analytics Hub",
        [
            new("Best Analytics Platform", "Martech Breakthrough", "Analytics"),
            new("Leader Q1 2025", "G2 Grid Report", "BI Tools"),
        ]),
    ];
}
