@* ============================================================
   Block: awards-growth
   Title: AwardsGrowth
   Description: Awards section with year-over-year comparison showing growth
   Source: original/blocks/awards/awards-growth.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Recognition Growth</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Year-over-year improvement in industry recognition
            </p>
        </div>

        @* Growth highlights *@
        <div class="grid gap-px border-b sm:grid-cols-3">
            @foreach (var item in _highlights.Select((h, i) => new { Item = h, Idx = i }))
            {
                <div class="@Cn.Merge("px-6 py-5", item.Idx < _highlights.Length - 1 ? "sm:border-r" : "")">
                    <div class="mb-1 flex items-center justify-between">
                        <p class="text-xs text-muted-foreground">@item.Item.Label</p>
                        <span class="flex items-center gap-1 text-xs font-medium text-emerald-600">
                            <LucideIconCn Name="trending-up" Size="12" Class="h-3 w-3" />
                            @item.Item.Growth
                        </span>
                    </div>
                    <p class="text-2xl font-semibold tabular-nums">@item.Item.Current</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">vs @item.Item.Previous last year</p>
                </div>
            }
        </div>

        @* Year comparison *@
        <div class="px-6 py-5">
            <div class="mb-4 flex items-center gap-2">
                <LucideIconCn Name="trophy" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <p class="text-sm font-medium">Awards by Year</p>
            </div>
            <div class="space-y-4">
                @foreach (var data in _yearlyData)
                {
                    <div class="space-y-1.5">
                        <div class="flex items-center justify-between text-sm">
                            <span class="font-medium">@data.Year</span>
                            <span class="text-xs text-muted-foreground">
                                @data.Awards awards · @data.Rating rating · @data.Reviews reviews
                            </span>
                        </div>
                        <ProgressCn Class="h-1.5" Value="@((double)data.Awards / 30 * 100)" />
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Highlight(string Label, double Current, double Previous, string Growth);
    private record YearlyData(string Year, int Awards, double Rating, int Reviews);

    private static readonly Highlight[] _highlights =
    [
        new("Awards won", 24, 15, "+60%"),
        new("Avg rating",  4.8, 4.6, "+0.2"),
        new("New badges",  12,  7,  "+71%"),
    ];

    private static readonly YearlyData[] _yearlyData =
    [
        new("2022",  8, 4.2,  450),
        new("2023", 15, 4.6, 1200),
        new("2024", 24, 4.8, 2900),
    ];
}
