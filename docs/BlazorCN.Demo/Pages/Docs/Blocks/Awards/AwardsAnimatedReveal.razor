@* ============================================================
   Block: awards-animated-reveal
   Title: AwardsAnimatedReveal
   Description: Awards section with staggered reveal animations on scroll and load
   Source: original/blocks/awards/awards-animated-reveal.tsx
   ============================================================ *@

@implements IDisposable

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Awards &amp; Recognition</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Our achievements, revealed</p>
        </div>

        <div class="divide-y">
            @for (var i = 0; i < _awards.Length; i++)
            {
                var award = _awards[i];
                var idx = i;
                var opacity = idx < _visibleCount ? "1" : "0";
                var transform = idx < _visibleCount ? "translateY(0)" : "translateY(8px)";
                <div class="flex items-center gap-3 px-4 py-3 transition-all duration-500"
                     style="@($"opacity:{opacity};transform:{transform}")">
                    <LucideIconCn Name="@award.Icon" Size="16" Class="h-4 w-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@award.Title</p>
                        <p class="text-xs text-muted-foreground">@award.Org</p>
                    </div>
                    <span class="text-xs tabular-nums text-muted-foreground">@award.Year</span>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                @_visibleCount of @_awards.Length awards revealed
            </p>
        </div>
    </div>
</section>

@code {
    private record Award(string Id, string Icon, string Title, string Org, string Year);

    private static readonly Award[] _awards =
    [
        new("a1", "trophy", "Product of the Year", "Global SaaS Awards", "2025"),
        new("a2", "award", "Best Developer Tool", "DevOps Excellence", "2025"),
        new("a3", "star", "Top Rated Platform", "G2 Crowd", "2024"),
        new("a4", "trophy", "Innovation Award", "TechCrunch Disrupt", "2024"),
        new("a5", "award", "Editor's Choice", "PCMag", "2024"),
        new("a6", "star", "Best in Show", "CES Innovation", "2023"),
    ];

    private int _visibleCount = 0;
    private System.Threading.Timer? _timer;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _timer = new System.Threading.Timer(_ =>
            {
                if (_visibleCount < _awards.Length)
                {
                    _visibleCount++;
                    InvokeAsync(StateHasChanged);
                }
                else
                {
                    _timer?.Dispose();
                    _timer = null;
                }
            }, null, 150, 150);
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
