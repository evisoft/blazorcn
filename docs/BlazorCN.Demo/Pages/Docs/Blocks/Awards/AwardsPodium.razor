@* ============================================================
   Block: awards-podium
   Title: AwardsPodium
   Description: Awards podium section with ranked showcase for top achievements on React landing pages
   Source: original/blocks/awards/awards-podium.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Our proudest moments</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Top-ranked achievements across the industry.
            </p>
        </div>

        <div class="flex items-end justify-center gap-4 p-6">
            @foreach (var award in _podium)
            {
                <div class="max-w-[200px] flex-1">
                    <div class="mb-2 rounded-md bg-muted/50 p-4 text-center">
                        <LucideIconCn Name="@award.IconName" Size="16" Class="mx-auto mb-2 h-4 w-4 text-muted-foreground" />
                        <p class="text-sm font-medium">@award.Title</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">@award.Org</p>
                        <p class="mt-1 text-xs tabular-nums text-muted-foreground">@award.Year</p>
                    </div>
                    <div class="@($"{award.Height} flex items-center justify-center rounded-t-md border border-b-0")">
                        <span class="text-2xl font-semibold tabular-nums text-muted-foreground">
                            @award.Position
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record PodiumEntry(int Position, string IconName, string Title, string Org, string Year, string Height);

    private static readonly PodiumEntry[] _podium =
    [
        new(2, "award",  "Innovation Leader",    "Tech Excellence Awards", "2024", "h-20"),
        new(1, "trophy", "Product of the Year",  "Global SaaS Awards",     "2024", "h-28"),
        new(3, "medal",  "Best User Experience", "UX Design Awards",       "2024", "h-14"),
    ];
}
