@* ============================================================
   Block: awards-year-in-review
   Title: AwardsYearInReview
   Description: Year in review awards summary with annual highlights, key metrics, and milestone recap
   Source: original/blocks/awards/awards-year-in-review.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideCalendarCn class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">2024 Year in Review</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                A year of recognition and milestones
            </p>
        </div>

        @* Stats row *@
        <div class="flex items-center justify-around border-b px-4 py-4">
            @foreach (var stat in _yearStats)
            {
                <div class="text-center">
                    <p class="text-2xl font-semibold tabular-nums">@stat.Value</p>
                    <p class="text-[10px] text-muted-foreground">@stat.Label</p>
                    <div class="mt-0.5 flex items-center justify-center gap-0.5 text-emerald-600">
                        <LucideArrowUpCn class="h-2.5 w-2.5" />
                        <span class="text-[10px] font-medium tabular-nums">@stat.Change</span>
                        <span class="text-[10px] text-muted-foreground">vs 2023</span>
                    </div>
                </div>
            }
        </div>

        @* Top awards *@
        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground mb-2">Top Awards</p>
            <div class="grid grid-cols-1 gap-1.5 sm:grid-cols-2">
                @foreach (var award in _highlights)
                {
                    <div class="flex items-center gap-2">
                        <LucideTrophyCn class="h-3 w-3 shrink-0 text-muted-foreground" />
                        <span class="truncate text-xs font-medium">@award.Title</span>
                        <span class="ml-auto shrink-0 text-[10px] text-muted-foreground">
                            @award.Quarter
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Milestones *@
        <div class="px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground mb-2">Key Milestones</p>
            <div class="space-y-1.5">
                @foreach (var milestone in _milestones)
                {
                    <div class="flex items-center gap-2">
                        <LucideStarCn class="h-3 w-3 shrink-0 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">@milestone</span>
                    </div>
                }
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideAwardCn class="h-3.5 w-3.5 text-muted-foreground" />
                <p class="text-xs text-muted-foreground">
                    Our most awarded year yet &middot; 24 wins across 12 categories
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private record YearStat(string Label, string Value, string Change);
    private record HighlightAward(string Title, string Org, string Quarter);

    private readonly YearStat[] _yearStats =
    [
        new("Awards Won", "24", "+8"),
        new("Categories", "12", "+3"),
        new("Countries", "18", "+5"),
    ];

    private readonly HighlightAward[] _highlights =
    [
        new("Product of the Year", "Global SaaS Awards", "Q1"),
        new("Best Developer Experience", "SlashData", "Q1"),
        new("Innovation Leader", "Forrester Wave", "Q2"),
        new("Top Rated Platform", "G2 Summer Report", "Q2"),
        new("Design Excellence Award", "Webby Awards", "Q3"),
        new("Fastest Growing Company", "Deloitte Fast 500", "Q3"),
        new("Best Enterprise Tool", "TechCrunch", "Q4"),
        new("Customer Choice Award", "Gartner Peer Insights", "Q4"),
    ];

    private readonly string[] _milestones =
    [
        "Entered 6 new international markets",
        "Crossed 50,000 enterprise customers",
        "Team grew from 120 to 280 people",
        "Launched 3 new product lines",
    ];
}
