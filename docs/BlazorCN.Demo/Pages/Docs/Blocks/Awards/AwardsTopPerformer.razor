@* ============================================================
   Block: awards-top-performer
   Title: AwardsTopPerformer
   Description: Top performer spotlight showcasing standout individuals with metrics, achievements, and recognition details
   Source: original/blocks/awards/awards-top-performer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="star" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Top Performers</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Standout individuals driving exceptional results
            </p>
        </div>

        <div class="divide-y">
            @foreach (var person in _performers)
            {
                <div class="px-4 py-4">
                    <div class="flex items-start gap-3">
                        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-muted/50">
                            <span class="text-xs font-medium">
                                @(string.Join("", person.Name.Split(' ').Select(n => n[0])))
                            </span>
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <p class="text-sm font-medium">@person.Name</p>
                                <span class="text-[10px] text-muted-foreground">@person.Quarter</span>
                            </div>
                            <p class="text-xs text-muted-foreground">
                                @person.Role &middot; @person.Department
                            </p>
                            <p class="mt-1.5 text-xs text-muted-foreground leading-relaxed">
                                @person.Achievement
                            </p>
                            <div class="mt-2 flex items-center gap-4">
                                @foreach (var metric in person.Metrics)
                                {
                                    <div class="flex items-center gap-1">
                                        <span class="text-xs font-semibold tabular-nums">@metric.Value</span>
                                        <span class="text-[10px] text-muted-foreground">@metric.Label</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="trophy" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                <p class="text-xs text-muted-foreground">
                    Recognized quarterly based on peer nominations and measurable impact
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private record Metric(string Label, string Value);
    private record Performer(string Name, string Role, string Department, string Achievement, Metric[] Metrics, string Quarter);

    private static readonly Performer[] _performers =
    [
        new("Maya Rodriguez", "Senior Engineer", "Platform",
            "Architected the real-time sync engine that reduced latency by 94%",
            [new("PRs merged", "147"), new("Uptime", "99.99%")],
            "Q1 2025"),
        new("James Park", "Product Designer", "Design",
            "Redesigned onboarding flow, lifting activation rate from 34% to 71%",
            [new("Activation", "+109%"), new("NPS lift", "+28")],
            "Q1 2025"),
        new("Aisha Okonkwo", "Account Executive", "Sales",
            "Closed the company's largest enterprise deal at $2.4M ARR",
            [new("Quota", "284%"), new("Pipeline", "$8.1M")],
            "Q4 2024"),
    ];
}
