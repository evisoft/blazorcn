@* ============================================================
   Block: awards-big-numbers
   Title: AwardsBigNumbers
   Description: A big numbers awards block for React and Next.js with large format stat cards, metric labels, and grid layout built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-big-numbers.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Awards Overview</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Key metrics at a glance</p>
        </div>

        <div class="grid grid-cols-2">
            @for (var i = 0; i < _metrics.Length; i++)
            {
                var metric = _metrics[i];
                var isLastRow = i >= _metrics.Length - 2;
                var isLeftCol = i % 2 == 0;
                <div class="@Cn.Merge("px-4 py-5", !isLastRow ? "border-b" : "", isLeftCol ? "border-r" : "")">
                    <span class="text-3xl font-semibold tabular-nums">@metric.Value</span>
                    <p class="mt-1 text-sm font-medium">@metric.Label</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@metric.Detail</p>
                </div>
            }
        </div>

        <div class="flex items-center gap-2 border-t px-4 py-2.5 text-xs text-muted-foreground">
            <span class="tabular-nums">@_totalAwards total awards</span>
            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
            <span>Updated annually</span>
        </div>
    </div>
</section>

@code {
    private record Metric(string Id, string Value, string Label, string Detail);

    private static readonly Metric[] _metrics =
    [
        new("1", "42", "Awards Won", "Across all categories"),
        new("2", "98%", "Win Rate", "From 43 nominations"),
        new("3", "12x", "Consecutive Years", "Unbroken streak since 2014"),
        new("4", "6", "Categories Led", "Out of 8 total"),
    ];

    private const int _totalAwards = 42;
}
