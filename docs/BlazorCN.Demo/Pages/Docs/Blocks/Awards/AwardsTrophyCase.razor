@* ============================================================
   Block: awards-trophy-case
   Title: AwardsTrophyCase
   Description: A virtual trophy case display block for React and Next.js with two-column shelf grid, trophy icons, award names, years, and organizations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-trophy-case.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="trophy" Size="16" Class="size-4 text-amber-500" />
                <div>
                    <h2 class="text-sm font-medium">Trophy Case</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_trophies.Length awards earned
                    </p>
                </div>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                2023 - 2025
            </BadgeCn>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2">
            @for (int i = 0; i < _trophies.Length; i++)
            {
                var trophy = _trophies[i];
                var isLastRow = i >= _trophies.Length - 2;
                var isLeftCol = i % 2 == 0;
                var articleClass = Cn.Merge(
                    "flex flex-col items-center gap-2 px-4 py-6 text-center",
                    isLeftCol ? "sm:border-r" : "",
                    isLastRow ? "" : "border-b"
                );
                <article class="@articleClass">
                    <div class="flex size-10 items-center justify-center rounded-lg bg-muted/50">
                        <LucideIconCn Name="award" Size="20" Class="size-5 text-muted-foreground" />
                    </div>
                    <div>
                        <p class="text-sm font-medium">@trophy.Name</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @trophy.Organization
                        </p>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="font-mono text-[10px] tabular-nums text-muted-foreground">
                            @trophy.Year
                        </span>
                        <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                        <span class="text-[10px] text-muted-foreground">
                            @trophy.Category
                        </span>
                    </div>
                </article>
            }
        </div>

        <div class="border-t px-4 py-2.5 text-center">
            <span class="text-xs text-muted-foreground">
                All awards independently verified
            </span>
        </div>
    </div>
</section>

@code {
    private record Trophy(string Id, string Name, string Organization, string Year, string Category);

    private static readonly Trophy[] _trophies =
    [
        new("1", "Product of the Year", "TechCrunch Disrupt", "2025", "Product"),
        new("2", "Best User Experience", "Webby Awards", "2025", "Design"),
        new("3", "Innovation Excellence", "Fast Company", "2024", "Innovation"),
        new("4", "Developer Tool of the Year", "DevOps Awards", "2024", "Developer"),
        new("5", "Customer Choice Award", "G2 Crowd", "2023", "Community"),
        new("6", "Top 50 Cloud Startups", "Forbes Cloud 100", "2023", "Enterprise"),
    ];
}
