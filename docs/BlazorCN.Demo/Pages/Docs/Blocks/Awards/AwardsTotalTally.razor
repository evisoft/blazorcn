@* ============================================================
   Block: awards-total-tally
   Title: AwardsTotalTally
   Description: A total tally awards block for React and Next.js with scoreboard-style columns, award type tallies, and monospace numbers built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-total-tally.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Award Tally</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Running totals by award tier</p>
        </div>

        <div class="border-b">
            <div class="grid grid-cols-4">
                @for (var i = 0; i < _tallyTypes.Length; i++)
                {
                    var type = _tallyTypes[i];
                    var isNotLast = i < _tallyTypes.Length - 1;
                    <div class="@(isNotLast ? "border-r" : "") px-4 py-4 text-center">
                        <span class="flex items-center justify-center gap-1.5">
                            <span class="@($"size-1.5 rounded-full {type.DotColor}")" />
                            <span class="text-xs font-medium text-muted-foreground">@type.Label</span>
                        </span>
                        <span class="mt-1 block font-mono text-2xl font-semibold tabular-nums">
                            @type.Count
                        </span>
                    </div>
                }
                <div class="border-l px-4 py-4 text-center">
                    <span class="text-xs font-medium text-muted-foreground">Total</span>
                    <span class="mt-1 block font-mono text-2xl font-semibold tabular-nums">
                        @_totalCount
                    </span>
                </div>
            </div>
        </div>

        <div>
            <div class="border-b px-4 py-2">
                <div class="grid grid-cols-4 text-xs font-medium text-muted-foreground">
                    <span>Year</span>
                    <span class="text-center">Gold</span>
                    <span class="text-center">Silver</span>
                    <span class="text-center">Bronze</span>
                </div>
            </div>
            @for (var i = 0; i < _yearBreakdowns.Length; i++)
            {
                var row = _yearBreakdowns[i];
                var isLast = i == _yearBreakdowns.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="grid grid-cols-4 px-4 py-2.5">
                        <span class="text-sm font-medium tabular-nums">@row.Year</span>
                        <span class="text-center font-mono text-sm tabular-nums text-muted-foreground">
                            @row.Gold
                        </span>
                        <span class="text-center font-mono text-sm tabular-nums text-muted-foreground">
                            @row.Silver
                        </span>
                        <span class="text-center font-mono text-sm tabular-nums text-muted-foreground">
                            @row.Bronze
                        </span>
                    </div>
                </div>
            }
        </div>

        <div class="flex items-center gap-2 border-t px-4 py-2.5 text-xs text-muted-foreground">
            <span class="tabular-nums">@_totalCount total awards</span>
            <span class="size-1 rounded-full bg-muted-foreground/40" />
            <span>@_yearBreakdowns.Length years</span>
        </div>

    </div>
</section>

@code {
    private record TallyType(string Id, string Label, int Count, string DotColor);
    private record YearBreakdown(string Id, int Year, int Gold, int Silver, int Bronze);

    private static readonly TallyType[] _tallyTypes =
    [
        new("1", "Gold",   23, "bg-amber-500"),
        new("2", "Silver", 15, "bg-muted-foreground/60"),
        new("3", "Bronze",  8, "bg-amber-700"),
    ];

    private static readonly YearBreakdown[] _yearBreakdowns =
    [
        new("1", 2026, 7, 4, 2),
        new("2", 2025, 6, 3, 2),
        new("3", 2024, 5, 4, 1),
        new("4", 2023, 3, 2, 2),
        new("5", 2022, 2, 2, 1),
    ];

    private static readonly int _totalCount = _tallyTypes.Sum(t => t.Count);
}
