@* ============================================================
   Block: awards-map
   Title: AwardsMap
   Description: Awards organized by geographic region with country flags and organization details
   Source: original/blocks/awards/awards-map.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Recognition by region</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Awards across 3 continents and 6 markets
            </p>
        </div>

        <div>
            @for (int regionIndex = 0; regionIndex < _regions.Length; regionIndex++)
            {
                var region = _regions[regionIndex];
                var isLast = regionIndex == _regions.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-6 py-3">
                        <span class="font-medium text-muted-foreground text-xs uppercase tracking-wider">
                            @region.Name
                        </span>
                    </div>
                    <div class="px-6 pb-4">
                        <div class="grid gap-3 sm:grid-cols-2">
                            @foreach (var award in region.Awards)
                            {
                                <div class="flex items-start gap-3 rounded-md bg-muted/50 p-3">
                                    <LucideIconCn Name="trophy" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
                                    <div class="min-w-0 flex-1">
                                        <span class="font-medium text-sm">@award.Title</span>
                                        <p class="mt-0.5 text-muted-foreground text-xs">@award.Org</p>
                                        <p class="mt-1 text-muted-foreground text-xs">
                                            @award.Flag @award.Country
                                        </p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record RegionAward(string Title, string Org, string Country, string Flag);
    private record Region(string Name, RegionAward[] Awards);

    private static readonly Region[] _regions =
    [
        new("North America", [
            new("Product of the Year",     "TechCrunch Disrupt",   "United States", "🇺🇸"),
            new("Innovation Leader Award", "Canadian Tech Awards",  "Canada",        "🇨🇦"),
        ]),
        new("Europe", [
            new("Best Enterprise Platform",      "Web Summit",       "Portugal",        "🇵🇹"),
            new("Digital Transformation Award",  "London Tech Week", "United Kingdom",  "🇬🇧"),
        ]),
        new("Asia Pacific", [
            new("Top SaaS Product",           "RISE Conference",     "Hong Kong", "🇭🇰"),
            new("Developer Tool of the Year", "Tech in Asia Awards", "Singapore", "🇸🇬"),
        ]),
    ];
}
