@* ============================================================
   Block: awards-horizontal
   Title: AwardsHorizontal
   Description: Awards horizontal cards section with bottom statistics bar for React landing pages
   Source: original/blocks/awards/awards-horizontal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Excellence Recognized</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Recognition from the world's most prestigious organizations
            </p>
        </div>

        @* Awards grid *@
        <div class="grid border-b sm:grid-cols-2">
            @for (var i = 0; i < _awards.Length; i++)
            {
                var award = _awards[i];
                var hasBottomBorder = i < _awards.Length - 2;
                var hasRightBorder = i % 2 == 0;
                var hasSmBottomBorder = i == _awards.Length - 2;
                <div class="@Cn.Merge("flex items-start gap-3 px-6 py-4", hasBottomBorder ? "border-b" : "", hasRightBorder ? "sm:border-r" : "", hasSmBottomBorder ? "sm:border-b" : "")">
                    <LucideIconCn Name="@award.Icon" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <p class="text-sm font-medium">@award.Title</p>
                            <span class="shrink-0 text-xs text-muted-foreground">@award.Year</span>
                        </div>
                        <p class="text-xs text-muted-foreground">@award.Org</p>
                    </div>
                </div>
            }
        </div>

        @* Bottom stats *@
        <div class="flex items-center justify-around px-6 py-4">
            @for (var i = 0; i < _stats.Length; i++)
            {
                var stat = _stats[i];
                <div class="flex items-center gap-6">
                    <div class="text-center">
                        <p class="text-2xl font-semibold tabular-nums">@stat.Value</p>
                        <p class="text-xs text-muted-foreground">@stat.Label</p>
                    </div>
                    @if (i < _stats.Length - 1)
                    {
                        <div class="h-8 w-px bg-border"></div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Award(string Icon, string Title, string Org, string Year);
    private record Stat(string Value, string Label);

    private static readonly Award[] _awards =
    [
        new("trophy", "Grand Champion", "Global Tech Awards", "2024"),
        new("zap", "Breakthrough Innovation", "CES Innovation Awards", "2024"),
        new("star", "Editor's Choice", "The Verge", "2023"),
        new("crown", "Industry Leader", "Forrester Wave", "2023"),
    ];

    private static readonly Stat[] _stats =
    [
        new("50+", "Awards won"),
        new("12", "Countries"),
        new("5", "Years running"),
    ];
}
