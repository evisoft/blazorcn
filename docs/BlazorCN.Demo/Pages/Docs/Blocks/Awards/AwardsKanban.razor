@* ============================================================
   Block: awards-kanban
   Title: AwardsKanban
   Description: Kanban-column awards section grouping achievements by status with Won, Nominated, and Pending columns
   Source: original/blocks/awards/awards-kanban.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Awards pipeline</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Track achievements from submission to recognition
            </p>
        </div>

        <div class="grid grid-cols-3 gap-4 p-4">
            @foreach (var column in _columns)
            {
                <div class="space-y-3">
                    @* Column header *@
                    <div class="flex items-center gap-2 px-1">
                        <span class="@($"size-1.5 shrink-0 rounded-full {column.DotColor}")" />
                        <span class="text-xs font-medium text-muted-foreground">@column.Label</span>
                        <span class="ml-auto rounded-full bg-muted/70 px-1.5 py-0.5 text-xs tabular-nums text-muted-foreground">
                            @column.Items.Length
                        </span>
                    </div>

                    @* Award cards *@
                    <div class="space-y-2">
                        @foreach (var item in column.Items)
                        {
                            <div class="rounded-md border bg-card p-3 transition-colors hover:bg-muted/50">
                                <div class="mb-1.5 flex items-center gap-1.5">
                                    <LucideIconCn Name="trophy" Size="12" Class="size-3 text-muted-foreground" />
                                    <span class="text-sm font-medium">@item.Title</span>
                                </div>
                                <p class="text-xs text-muted-foreground">@item.Org</p>
                                <p class="mt-1.5 text-xs text-muted-foreground">@item.Year</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record AwardItem(string Title, string Org, string Year);
    private record Column(string Label, string Color, string DotColor, AwardItem[] Items);

    private static readonly Column[] _columns =
    [
        new("Won", "text-emerald-600", "bg-emerald-500",
        [
            new("Best SaaS Product", "TechCrunch Disrupt", "2024"),
        ]),
        new("Nominated", "text-blue-600", "bg-blue-500",
        [
            new("Innovation Award", "Webby Awards", "2025"),
        ]),
        new("Pending", "text-amber-600", "bg-amber-500",
        [
            new("Top 100 Startups", "Forbes", "2025"),
            new("Design Excellence", "Awwwards", "2025"),
        ]),
    ];
}
