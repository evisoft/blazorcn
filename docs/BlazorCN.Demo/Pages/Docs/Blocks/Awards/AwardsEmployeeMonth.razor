@* ============================================================
   Block: awards-employee-month
   Title: AwardsEmployeeMonth
   Description: Employee of the month showcase with profile, achievement, and nomination details
   Source: original/blocks/awards/awards-employee-month.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="award" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Employee of the Month</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">@_currentWinner.Month</p>
        </div>

        @* Current winner *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3 mb-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-muted/50">
                    <LucideIconCn Name="user" Size="20" Class="h-5 w-5 text-muted-foreground" />
                </div>
                <div>
                    <p class="text-sm font-medium">@_currentWinner.Name</p>
                    <p class="text-xs text-muted-foreground">
                        @_currentWinner.Role &middot; @_currentWinner.Department
                    </p>
                </div>
            </div>
            <p class="text-xs text-muted-foreground leading-relaxed">
                @_currentWinner.Achievement
            </p>
            <div class="mt-3 flex gap-4">
                @foreach (var stat in _currentWinner.Stats)
                {
                    <div>
                        <p class="text-lg font-semibold tabular-nums">@stat.Value</p>
                        <p class="text-[10px] text-muted-foreground">@stat.Label</p>
                    </div>
                }
            </div>
        </div>

        @* Nomination quote *@
        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <div class="flex items-center gap-1.5 mb-1.5">
                    <LucideIconCn Name="message-square" Size="12" Class="h-3 w-3 text-muted-foreground" />
                    <span class="text-[10px] font-medium text-muted-foreground">
                        Nominated by @_currentWinner.NominatedBy
                    </span>
                </div>
                <p class="text-xs text-muted-foreground leading-relaxed">
                    "@_currentWinner.NominationQuote"
                </p>
            </div>
        </div>

        @* Past winners *@
        <div class="px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Previous winners</p>
            <div class="space-y-2">
                @foreach (var winner in _pastWinners)
                {
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="star" Size="12" Class="h-3 w-3 shrink-0 text-muted-foreground" />
                        <span class="text-xs font-medium">@winner.Name</span>
                        <span class="text-xs text-muted-foreground">&middot;</span>
                        <span class="text-xs text-muted-foreground">@winner.Role</span>
                        <span class="ml-auto text-xs tabular-nums text-muted-foreground">@winner.Month</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Stat(string Label, string Value);

    private record Winner(string Name, string Role, string Department, string Month,
        string Achievement, string NominatedBy, string NominationQuote, Stat[] Stats);

    private record PastWinner(string Name, string Role, string Month);

    private static readonly Winner _currentWinner = new(
        Name: "Priya Sharma",
        Role: "Senior Frontend Engineer",
        Department: "Engineering",
        Month: "March 2025",
        Achievement: "Led the complete redesign of the component library, reducing bundle size by 34% while adding 12 new accessible components. Mentored 3 junior developers throughout the process.",
        NominatedBy: "David Chen, VP of Engineering",
        NominationQuote: "Priya's technical excellence and mentorship have raised the bar for the entire team.",
        Stats:
        [
            new("Components shipped", "12"),
            new("Bundle size reduction", "34%"),
            new("Team members mentored", "3"),
        ]
    );

    private static readonly PastWinner[] _pastWinners =
    [
        new("Marcus Johnson", "Product Manager", "Feb 2025"),
        new("Elena Rodriguez", "DevOps Engineer", "Jan 2025"),
        new("James Kim", "Customer Success Lead", "Dec 2024"),
    ];
}
