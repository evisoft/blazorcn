@* ============================================================
   Block: awards-embed-badge
   Title: AwardsEmbedBadge
   Description: Block example: awards
   Source: original/blocks/awards/awards-embed-badge.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Embed our award badge</h2>
            <p class="mt-1 text-muted-foreground text-sm">Add this badge to your website to showcase your recognition</p>
        </div>

        <div class="flex flex-col items-center gap-6 p-6">
            <div class="flex items-center gap-3 rounded-lg border bg-muted/50 px-6 py-4">
                <LucideIconCn Name="award" Size="32" Class="size-8 text-primary" />
                <div>
                    <p class="text-sm font-semibold">Top Rated 2024</p>
                    <p class="text-xs text-muted-foreground">Industry Excellence Award</p>
                </div>
            </div>

            <div class="w-full space-y-2">
                <p class="text-sm font-medium">Embed code</p>
                <div class="relative">
                    <pre class="overflow-x-auto rounded-md border bg-muted px-4 py-3 text-xs font-mono text-muted-foreground" tabindex="0" role="group" aria-label="Embed code">@_embedCode</pre>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                              Class="absolute right-2 top-2 h-7 w-7"
                              @onclick="CopyEmbed" aria-label="Confirm">
                        @if (_copied)
                        {
                            <LucideIconCn Name="check" Size="14" Class="size-3.5 text-green-600" />
                        }
                        else
                        {
                            <LucideIconCn Name="copy" Size="14" Class="size-3.5" />
                        }
                    </ButtonCn>
                </div>
            </div>

            <div class="flex w-full items-center gap-3">
                @foreach (var size in _sizes)
                {
                    <ButtonCn Variant="@(size.Key == _activeSize ? ButtonVariant.Default : ButtonVariant.Outline)"
                              Size="ButtonSize.Sm"
                              Class="flex-1"
                              @onclick="@(() => SetSize(size.Key))">
                        @size.Label
                    </ButtonCn>
                }
            </div>
        </div>

        <div class="border-t px-6 py-3">
            <p class="text-xs text-muted-foreground">Badge image hosted on our CDN — always up to date</p>
        </div>
    </div>
</section>

@code {
    private record SizeOption(string Key, string Label, int Width, int Height);

    private static readonly SizeOption[] _sizes =
    [
        new("sm",  "Small",  120, 60),
        new("md",  "Medium", 180, 90),
        new("lg",  "Large",  240, 120),
    ];

    private string _activeSize = "md";
    private bool _copied = false;

    private SizeOption ActiveSizeOption => Array.Find(_sizes, s => s.Key == _activeSize) ?? _sizes[1];

    private string _embedCode =>
        $"<img src=\"https://cdn.example.com/badges/top-rated-2024.svg\" " +
        $"width=\"{ActiveSizeOption.Width}\" height=\"{ActiveSizeOption.Height}\" " +
        $"alt=\"Top Rated 2024 — Industry Excellence Award\" />";

    private void SetSize(string key)
    {
        _activeSize = key;
    }

    private void CopyEmbed()
    {
        _copied = true;
        // In a real implementation, use JSInterop to copy to clipboard.
    }
}
