@* ============================================================
   Block: awards-press
   Title: AwardsPress
   Description: Awards presented as press and media coverage with publication names and links
   Source: original/blocks/awards/awards-press.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">In the press</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Featured in leading technology publications
            </p>
        </div>

        <div class="divide-y">
            @foreach (var item in _pressItems)
            {
                <a href="@item.Url"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="flex items-start gap-4 px-6 py-4 transition-colors hover:bg-muted/50">
                    <div class="mt-0.5 shrink-0">
                        <LucideIconCn Name="newspaper" Size="16" Class="h-4 w-4 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@item.Publication</span>
                            <span class="text-xs text-muted-foreground">@item.Date</span>
                        </div>
                        <p class="mt-0.5 text-sm text-muted-foreground">@item.Headline</p>
                    </div>
                    <div class="mt-0.5 shrink-0">
                        <LucideIconCn Name="external-link" Size="14" Class="h-3.5 w-3.5 text-muted-foreground/60" />
                    </div>
                </a>
            }
        </div>
    </div>
</section>

@code {
    private record PressItem(string Id, string Publication, string Headline, string Date, string Url);

    private static readonly PressItem[] _pressItems =
    [
        new("techcrunch", "TechCrunch", "Featured as Best SaaS Product of 2024",                          "Mar 2024", "#"),
        new("forbes",     "Forbes",     "Named to Top 100 Startups Redefining Enterprise Software",        "Jan 2024", "#"),
        new("wired",      "Wired",      "Selected as an Innovation Pick for AI-Powered Workflows",         "Nov 2023", "#"),
    ];
}
