@* ============================================================
   Block: awards-rubric-grid
   Title: AwardsRubricGrid
   Description: An evaluation rubric grid block for React and Next.js with criteria rows, performance levels, check marks, and clean table layout built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-rubric-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="table" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Evaluation Rubric</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Performance assessment across key criteria
            </p>
        </div>

        @* Rubric table *@
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="border-b">
                        <th class="w-32 px-4 py-2.5 text-left text-xs font-medium text-muted-foreground">
                            Criterion
                        </th>
                        @foreach (var level in _levels)
                        {
                            <th class="px-3 py-2.5 text-left text-xs font-medium text-muted-foreground">
                                @level.Label
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (int rowIndex = 0; rowIndex < _criteria.Length; rowIndex++)
                    {
                        var criterion = _criteria[rowIndex];
                        var isLast = rowIndex == _criteria.Length - 1;
                        <tr class="@(isLast ? "" : "border-b")">
                            <td class="px-4 py-3 align-top">
                                <span class="text-sm font-medium">@criterion.Name</span>
                            </td>
                            @foreach (var level in _levels)
                            {
                                var isScored = criterion.ScoredLevel == level.Key;
                                <td class="@Cn.Merge("px-3 py-3 align-top", isScored ? "bg-emerald-500/5" : "")">
                                    <div class="flex items-start gap-2">
                                        @if (isScored)
                                        {
                                            <span class="mt-0.5 flex size-4 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                                                <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                                            </span>
                                        }
                                        <span class="@Cn.Merge("text-xs leading-relaxed", isScored ? "text-foreground" : "text-muted-foreground")">
                                            @criterion.Descriptions[level.Key]
                                        </span>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <span>@_criteria.Length criteria evaluated</span>
                <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                <span>@_criteria.Count(c => c.ScoredLevel == "excellent") excellent</span>
                <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                <span>@_criteria.Count(c => c.ScoredLevel == "good") good</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record RubricLevel(string Key, string Label);
    private record RubricCriterion(string Id, string Name, Dictionary<string, string> Descriptions, string ScoredLevel);

    private static readonly RubricLevel[] _levels =
    [
        new("excellent", "Excellent"),
        new("good", "Good"),
        new("fair", "Fair"),
        new("poor", "Poor"),
    ];

    private static readonly RubricCriterion[] _criteria =
    [
        new("1", "Innovation", new Dictionary<string, string>
        {
            ["excellent"] = "Novel approach that redefines the category",
            ["good"] = "Creative solution with meaningful differentiation",
            ["fair"] = "Incremental improvement over existing solutions",
            ["poor"] = "No notable innovation or differentiation",
        }, "excellent"),
        new("2", "User Impact", new Dictionary<string, string>
        {
            ["excellent"] = "Measurable improvement for over 10,000 users",
            ["good"] = "Clear positive impact with supporting metrics",
            ["fair"] = "Some evidence of user benefit",
            ["poor"] = "Minimal or unclear user impact",
        }, "good"),
        new("3", "Design Quality", new Dictionary<string, string>
        {
            ["excellent"] = "Exceptional craft, consistency, and attention to detail",
            ["good"] = "Strong visual design with minor inconsistencies",
            ["fair"] = "Acceptable design that meets basic standards",
            ["poor"] = "Significant design issues or inconsistencies",
        }, "excellent"),
        new("4", "Technical Execution", new Dictionary<string, string>
        {
            ["excellent"] = "Flawless implementation with exemplary code quality",
            ["good"] = "Solid engineering with good architecture decisions",
            ["fair"] = "Functional but with notable technical debt",
            ["poor"] = "Significant bugs or architectural concerns",
        }, "good"),
        new("5", "Scalability", new Dictionary<string, string>
        {
            ["excellent"] = "Proven at scale with documented performance",
            ["good"] = "Designed for scale with clear growth path",
            ["fair"] = "Can handle current load with some limitations",
            ["poor"] = "Performance concerns at current usage levels",
        }, "fair"),
    ];
}
