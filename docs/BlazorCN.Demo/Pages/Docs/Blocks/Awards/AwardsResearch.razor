@* ============================================================
   Block: awards-research
   Title: AwardsResearch
   Description: Research excellence awards highlighting academic citations, published papers, and scientific recognition
   Source: original/blocks/awards/awards-research.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="graduation-cap" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Research Excellence</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Peer-reviewed recognition and academic impact
            </p>
        </div>

        <div class="flex items-center gap-6 border-b px-4 py-3">
            @foreach (var stat in _stats)
            {
                <div class="flex items-center gap-1.5">
                    <span class="text-lg font-semibold tabular-nums">@stat.Value</span>
                    <span class="text-[10px] text-muted-foreground">@stat.Label</span>
                </div>
            }
        </div>

        <div class="divide-y">
            @foreach (var award in _awards)
            {
                <div class="px-4 py-3">
                    <div class="flex items-start gap-3">
                        <LucideIconCn Name="@award.IconName" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium">@award.Title</p>
                            <p class="text-xs text-muted-foreground">
                                @award.Venue &middot; @award.Year
                            </p>
                            <p class="mt-1 text-xs text-muted-foreground">@award.Metric</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                Research published across top-tier venues since 2020
            </p>
        </div>
    </div>
</section>

@code {
    private record ResearchAward(string Title, string Venue, string Year, string Type, string Metric, string IconName);
    private record Stat(string Label, string Value);

    private static readonly Stat[] _stats =
    [
        new("Papers", "47"),
        new("Citations", "12.4K"),
        new("h-index", "34"),
    ];

    private static readonly ResearchAward[] _awards =
    [
        new("Best Paper Award", "NeurIPS 2024", "2024", "paper", "Top 0.5% of 12,000+ submissions", "file-text"),
        new("Outstanding Research Contribution", "ACM SIGCHI", "2025", "award", "Recognized for advancing human-computer interaction", "graduation-cap"),
        new("Most Cited Paper", "ICML Proceedings", "2024", "citation", "3,400+ citations in 18 months", "book-open"),
        new("Innovation in Applied ML", "Google Research Awards", "2024", "award", "$150K research grant recipient", "flask-conical"),
    ];
}
