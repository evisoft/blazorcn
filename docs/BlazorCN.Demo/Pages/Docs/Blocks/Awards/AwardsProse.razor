@* ============================================================
   Block: awards-prose
   Title: AwardsProse
   Description: Awards woven into flowing narrative paragraphs with inline highlighted award names and subtle badges
   Source: original/blocks/awards/awards-prose.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Recognition &amp; Awards</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                A decade of building products the industry has noticed
            </p>
        </div>

        <div class="space-y-4 px-6 py-5">
            <p class="text-sm leading-relaxed text-foreground">
                In 2024, we were recognized with the
                <span class="font-semibold">Best Developer Tool</span> award by ProductHunt, a
                distinction shared with only twelve other companies worldwide. That same year, G2
                selected us for their
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[11px] px-1.5 py-0">
                    <LucideIconCn Name="award" Size="12" Class="size-3" />
                    Top 100 SaaS
                </BadgeCn>
                list based on verified user reviews, and Fast Company included our platform in their
                <span class="font-semibold">Most Innovative Companies</span> roundup for enterprise
                software.
            </p>

            <p class="text-sm leading-relaxed text-foreground">
                The previous year brought its own milestones. Our design system earned the
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[11px] px-1.5 py-0">
                    <LucideIconCn Name="award" Size="12" Class="size-3" />
                    Excellence in UX
                </BadgeCn>
                award at the Webby Awards, while TechCrunch named us a
                <span class="font-semibold">Startup to Watch</span> in their annual developer tools
                report. We also received the
                <span class="font-semibold">Customer Choice Award</span> from G2 for the second
                consecutive quarter, driven by a 4.8-star average across over 1,200 reviews.
            </p>

            <p class="text-sm leading-relaxed text-foreground">
                Earlier recognition includes the
                <span class="font-semibold">Innovation Excellence Prize</span> from the World
                Technology Forum in 2022 and a
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[11px] px-1.5 py-0">
                    <LucideIconCn Name="award" Size="12" Class="size-3" />
                    Best in Show
                </BadgeCn>
                selection at React Summit the same year. These honors reflect a consistent commitment to
                developer experience, performance, and thoughtful design across every release.
            </p>
        </div>

        <div class="border-t px-6 py-4">
            <p class="text-xs text-muted-foreground">Recognized by</p>
            <div class="mt-2.5 flex items-center gap-2">
                @foreach (var org in _recognizedBy)
                {
                    <div class="flex size-8 items-center justify-center rounded-full bg-muted/50 text-[10px] font-semibold text-muted-foreground"
                         title="@org.Name">
                        @org.Initials
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record OrgItem(string Id, string Name, string Initials);

    private static readonly OrgItem[] _recognizedBy =
    [
        new("ph", "ProductHunt", "PH"),
        new("g2", "G2", "G2"),
        new("fc", "Fast Company", "FC"),
        new("tc", "TechCrunch", "TC"),
        new("webby", "Webby Awards", "WA"),
    ];
}
