@* ============================================================
   Block: awards-environmental
   Title: AwardsEnvironmental
   Description: Environmental and sustainability awards with green impact metrics
   Source: original/blocks/awards/awards-environmental.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="leaf" Size="16" Class="h-4 w-4 text-emerald-600" />
                <h2 class="text-sm font-medium">Environmental Awards</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Our commitment to sustainability, recognized
            </p>
        </div>

        <div class="divide-y">
            @foreach (var award in _awards)
            {
                <div class="flex items-start gap-3 px-4 py-3">
                    <LucideIconCn Name="@award.IconName" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-emerald-600" />
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center justify-between gap-2">
                            <p class="text-sm font-medium">@award.Title</p>
                            <span class="shrink-0 text-xs tabular-nums text-muted-foreground">
                                @award.Year
                            </span>
                        </div>
                        <p class="text-xs text-muted-foreground">@award.Org</p>
                        <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                            @award.Impact
                        </p>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">Committed to net-zero operations by 2030</p>
        </div>
    </div>
</section>

@code {
    private record EnvironmentalAward(string Title, string Org, string Year, string Impact, string IconName);

    private static readonly EnvironmentalAward[] _awards =
    [
        new("Carbon Neutral Certified", "Climate Neutral", "2025",
            "Offset 2,400 tons of CO2 through verified carbon removal projects", "cloud"),
        new("Green Web Foundation Certified", "The Green Web Foundation", "2025",
            "100% renewable energy powering all infrastructure and offices", "zap"),
        new("Sustainable Business Award", "B Corp", "2024",
            "B Corp score of 92.3, ranking in top 5% of certified companies", "leaf"),
        new("Zero Waste to Landfill", "Green Business Bureau", "2024",
            "98.7% waste diversion rate across all company operations", "recycle"),
        new("Environmental Champion", "1% for the Planet", "2024",
            "Donated 1% of annual revenue to environmental nonprofits since 2021", "trees"),
    ];
}
