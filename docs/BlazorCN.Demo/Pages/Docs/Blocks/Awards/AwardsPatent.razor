@* ============================================================
   Block: awards-patent
   Title: AwardsPatent
   Description: Patent awards and intellectual property filings showcase with patent details
   Source: original/blocks/awards/awards-patent.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-check" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Patent Portfolio</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_granted granted &middot; @_pending pending
            </p>
        </div>

        <div class="divide-y">
            @foreach (var patent in _patents)
            {
                <div class="px-4 py-3">
                    <div class="flex items-start gap-3">
                        <LucideIconCn Name="file-text" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center justify-between gap-2">
                                <p class="text-sm font-medium">@patent.Title</p>
                                @if (patent.Status == "granted")
                                {
                                    <span class="flex shrink-0 items-center gap-1 text-xs text-emerald-600">
                                        <LucideIconCn Name="check-circle-2" Size="12" Class="h-3 w-3" />
                                        Granted
                                    </span>
                                }
                                else
                                {
                                    <span class="flex shrink-0 items-center gap-1 text-xs text-amber-600">
                                        <LucideIconCn Name="clock" Size="12" Class="h-3 w-3" />
                                        Pending
                                    </span>
                                }
                            </div>
                            <p class="font-mono text-xs text-muted-foreground">@patent.Number</p>
                            <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                                @patent.Summary
                            </p>
                            <div class="mt-1.5 flex gap-3 text-[10px] text-muted-foreground">
                                <span>Inventors: @patent.Inventors</span>
                                <span>&middot;</span>
                                <span>Filed @patent.Filed</span>
                                <span>&middot;</span>
                                <span>@patent.Jurisdiction</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Patent(string Number, string Title, string Inventors, string Filed, string Status, string Jurisdiction, string Summary);

    private static readonly Patent[] _patents =
    [
        new("US 11,234,567 B2", "Method for Real-Time Collaborative Code Analysis", "S. Chen, M. Williams, P. Sharma", "2022", "granted", "United States", "Novel approach to real-time multi-user code analysis using distributed AST merging"),
        new("US 11,345,678 B2", "Predictive Infrastructure Scaling System", "J. Nakamura, A. Osei", "2023", "granted", "United States", "ML-based system for predicting infrastructure load and pre-scaling resources"),
        new("EP 4,123,456 A1", "Context-Aware Code Generation Engine", "S. Chen, D. Kim", "2024", "pending", "European Union", "AI engine that generates code aware of full project context and coding conventions"),
        new("US 18/234,567", "Zero-Latency Edge Deployment Protocol", "M. Williams, L. Park", "2024", "pending", "United States", "Protocol for deploying application updates to edge nodes with zero perceived latency"),
    ];

    private int _granted => _patents.Count(p => p.Status == "granted");
    private int _pending => _patents.Count(p => p.Status == "pending");
}
