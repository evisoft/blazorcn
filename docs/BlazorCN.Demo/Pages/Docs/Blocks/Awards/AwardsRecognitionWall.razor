@* ============================================================
   Block: awards-recognition-wall
   Title: AwardsRecognitionWall
   Description: Team recognition appreciation wall showcasing peer-to-peer shoutouts and kudos
   Source: original/blocks/awards/awards-recognition-wall.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sparkles" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Recognition Wall</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Peer appreciation and team shoutouts
            </p>
        </div>

        <div class="divide-y">
            @foreach (var item in _recognitions)
            {
                <div class="px-4 py-3">
                    <div class="flex items-start gap-3">
                        <LucideIconCn Name="@item.Icon" Size="14" Class="mt-0.5 h-3.5 w-3.5 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-1.5">
                                <span class="text-xs font-medium">@item.From</span>
                                <span class="text-[10px] text-muted-foreground">&rarr;</span>
                                <span class="text-xs font-medium">@item.To</span>
                                <span class="ml-auto text-[10px] text-muted-foreground">
                                    @item.Category
                                </span>
                            </div>
                            <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                                &ldquo;@item.Message&rdquo;
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                142 recognitions this quarter &middot; 89% team participation
            </p>
        </div>
    </div>
</section>

@code {
    private record Recognition(
        string From,
        string To,
        string Message,
        string Category,
        string Icon
    );

    private static readonly Recognition[] _recognitions =
    [
        new("Sarah K.",  "Mike Chen",     "Shipped the new onboarding flow two days early. The conversion lift is already visible.",                   "Execution",  "rocket"),
        new("David R.",  "Priya Patel",   "Mentored three junior engineers this quarter. Each one has shipped features independently.",                "Mentorship", "sparkles"),
        new("Alex T.",   "Jordan Lee",    "Caught a critical security issue during code review. Saved us from a potential breach.",                    "Vigilance",  "zap"),
        new("Lisa M.",   "Carlos Reyes",  "Built the internal CLI tool that cut deploy time from 45 minutes to 3.",                                   "Innovation", "star"),
        new("Tom W.",    "Emily Zhang",   "Led the migration to the new API with zero customer-facing downtime.",                                      "Leadership", "heart"),
    ];
}
