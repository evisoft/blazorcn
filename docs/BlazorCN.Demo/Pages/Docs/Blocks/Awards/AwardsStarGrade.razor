@* ============================================================
   Block: awards-star-grade
   Title: AwardsStarGrade
   Description: A star grade rating display block for React and Next.js with filled star visuals, award names, granting bodies, and universal rating scale built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-star-grade.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Star Ratings &amp; Grades</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Official ratings from recognized hospitality authorities
            </p>
        </div>

        <div>
            @for (int idx = 0; idx < _awards.Length; idx++)
            {
                var award = _awards[idx];
                var isLast = idx == _awards.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-3">
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-medium">@award.Name</span>
                            <span class="inline-flex items-center gap-0.5" aria-label="@award.Stars out of 5 stars">
                                @for (int i = 0; i < 5; i++)
                                {
                                    var filled = i < award.Stars;
                                    <LucideIconCn Name="star" Size="14" Class="@Cn.Merge("size-3.5", filled ? "fill-amber-500 text-amber-500" : "fill-muted text-muted")" />
                                }
                            </span>
                        </div>
                        <div class="mt-1 flex items-center gap-2 text-xs text-muted-foreground">
                            <span>@award.GrantedBy</span>
                            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                            <span class="font-mono tabular-nums">@award.Year</span>
                        </div>
                        <p class="mt-1.5 text-xs text-muted-foreground">
                            @award.Note
                        </p>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                @_awards.Length certified ratings
            </span>
        </div>
    </div>
</section>

@code {
    private record StarAward(string Id, string Name, string GrantedBy, int Stars, string Year, string Note);

    private static readonly StarAward[] _awards =
    [
        new("1", "Culinary Excellence", "Michelin Guide", 3, "2025", "Exceptional cuisine worth a special journey"),
        new("2", "Luxury Accommodation", "Forbes Travel Guide", 5, "2025", "Outstanding service and world-class facilities"),
        new("3", "Spa & Wellness", "Forbes Travel Guide", 4, "2024", "Superior wellness experience with exceptional treatments"),
        new("4", "Sustainable Hospitality", "Green Globe", 3, "2024", "Certified commitment to sustainable tourism practices"),
        new("5", "Guest Experience", "AAA Diamond", 5, "2025", "Ultimate in luxury with meticulous personalized service"),
    ];
}
