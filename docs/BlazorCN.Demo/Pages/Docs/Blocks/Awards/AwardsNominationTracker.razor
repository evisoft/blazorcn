@* ============================================================
   Block: awards-nomination-tracker
   Title: AwardsNominationTracker
   Description: Block example: awards
   Source: original/blocks/awards/awards-nomination-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-3xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="gift" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="font-semibold text-xl tracking-tight">Nomination Tracker</h2>
            </div>
            <p class="mt-1 text-sm text-muted-foreground">
                Monitor all active and past award nominations in one place
            </p>
        </div>

        @* Summary stats *@
        <div class="grid grid-cols-4 divide-x border-b">
            @foreach (var stat in _stats)
            {
                <div class="px-4 py-3 text-center">
                    <p class="text-2xl font-semibold tabular-nums">@stat.Value</p>
                    <p class="text-xs text-muted-foreground">@stat.Label</p>
                </div>
            }
        </div>

        @* Column headers *@
        <div class="grid grid-cols-[1fr_auto_auto_auto] items-center gap-3 border-b bg-muted/30 px-6 py-2 text-xs font-medium text-muted-foreground">
            <span>Award</span>
            <span class="w-28">Category</span>
            <span class="w-24 text-center">Deadline</span>
            <span class="w-24 text-center">Status</span>
        </div>

        @* Nomination rows *@
        <div class="divide-y">
            @foreach (var nomination in _nominations)
            {
                <div class="grid grid-cols-[1fr_auto_auto_auto] items-center gap-3 px-6 py-3 transition-colors hover:bg-muted/40">
                    <div class="min-w-0">
                        <p class="truncate text-sm font-medium">@nomination.Title</p>
                        <p class="truncate text-xs text-muted-foreground">@nomination.Organization</p>
                    </div>
                    <span class="w-28 truncate text-xs text-muted-foreground">@nomination.Category</span>
                    <span class="w-24 text-center font-mono text-xs text-muted-foreground">@nomination.Deadline</span>
                    <span class="flex w-24 justify-center">
                        <span class="@($"inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium {StatusClass(nomination.Status)}")">
                            @nomination.Status
                        </span>
                    </span>
                </div>
            }
        </div>

        <div class="border-t px-6 py-3">
            <p class="text-xs text-muted-foreground">
                @_nominations.Length nominations tracked &middot; Last updated June 2025
            </p>
        </div>
    </div>
</section>

@code {
    private record Stat(string Label, int Value);
    private record Nomination(string Title, string Organization, string Category, string Deadline, string Status);

    private static readonly Stat[] _stats =
    [
        new("Total", 8),
        new("Won", 3),
        new("Pending", 3),
        new("Not Selected", 2),
    ];

    private static readonly Nomination[] _nominations =
    [
        new("Best SaaS Product",         "TechCrunch Disrupt",   "Software",     "Apr 2025", "Won"),
        new("Design Excellence Award",   "Awwwards",             "UX / Design",  "May 2025", "Won"),
        new("Top 100 Startups",          "Forbes",               "Startup",      "Mar 2025", "Won"),
        new("Innovation of the Year",    "Webby Awards",         "Technology",   "Jun 2025", "Shortlisted"),
        new("People's Choice Award",     "Product Hunt",         "Community",    "Jul 2025", "Submitted"),
        new("Sustainability Leader",     "Green Business Awards","Environment",  "Aug 2025", "Submitted"),
        new("Best Developer Tool",       "GitHub Stars",         "Open Source",  "Feb 2025", "Not Selected"),
        new("Customer Success Award",    "G2 Spring 2025",       "B2B SaaS",     "Jan 2025", "Not Selected"),
    ];

    private static string StatusClass(string status) => status switch
    {
        "Won"          => "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400",
        "Shortlisted"  => "bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400",
        "Submitted"    => "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400",
        "Not Selected" => "bg-muted text-muted-foreground",
        _              => "bg-muted text-muted-foreground",
    };
}
