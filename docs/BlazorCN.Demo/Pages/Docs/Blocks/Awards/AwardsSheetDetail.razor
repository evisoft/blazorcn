@* ============================================================
   Block: awards-sheet-detail
   Title: AwardsSheetDetail
   Description: An awards list block for React and Next.js with a slide-out Sheet panel for full award details, criteria, and external links built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-sheet-detail.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Awards &amp; Recognition</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Select an award to view full details
            </p>
        </div>

        @* Award list *@
        <div>
            @for (var i = 0; i < _awards.Length; i++)
            {
                var award = _awards[i];
                var isLast = i == _awards.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _selected = award)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <LucideTrophyCn Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@award.Name</span>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                @award.Org &middot; @award.Year
                            </p>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-[10px] font-normal">
                            @award.Category
                        </BadgeCn>
                        <LucideChevronRightCn Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                    </button>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                @(_awards.Length) awards earned
            </span>
        </div>
    </div>
</section>

@* Sheet detail panel *@
<SheetCn Open="@(_selected != null)" OpenChanged="@(v => { if (!v) _selected = null; })">
    <SheetContentCn Side="SheetSide.Right">
        <SheetHeaderCn>
            <SheetTitleCn Class="text-sm font-medium">@_selected?.Name</SheetTitleCn>
            <SheetDescriptionCn>@_selected?.Org &middot; @_selected?.Year</SheetDescriptionCn>
        </SheetHeaderCn>
        @if (_selected != null)
        {
            <div class="space-y-4 px-4">
                <div>
                    <span class="text-xs font-medium text-muted-foreground">Description</span>
                    <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                        @_selected.Description
                    </p>
                </div>

                <div>
                    <span class="text-xs font-medium text-muted-foreground">Evaluation Criteria</span>
                    <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                        @_selected.Criteria
                    </p>
                </div>

                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-muted-foreground">Category</span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                            @_selected.Category
                        </BadgeCn>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-muted-foreground">Year</span>
                        <span class="text-xs font-medium tabular-nums">@_selected.Year</span>
                    </div>
                </div>

                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs"
                          Href="@_selected.Url" target="_blank" rel="noopener noreferrer">
                    <LucideExternalLinkCn Size="12" Class="size-3" />
                    View award details
                </ButtonCn>
            </div>
        }
    </SheetContentCn>
</SheetCn>

@code {
    private Award? _selected;

    private record Award(string Id, string Name, string Org, string Category, string Year, string Description, string Criteria, string Url);

    private static readonly Award[] _awards =
    [
        new("1", "Product of the Year", "Global Technology Awards", "Enterprise Software", "2025",
            "Recognized for outstanding innovation in enterprise collaboration tools, selected from over 1,200 submissions across 40 countries.",
            "Products are evaluated on innovation, market impact, user satisfaction, and technical excellence by an independent panel of 50 industry experts.",
            "https://example.com/awards/product-of-the-year"),
        new("2", "Best User Experience", "UX Design Awards", "SaaS Platform", "2025",
            "Awarded for exceptional interface design and user-centered workflows that reduced onboarding time by 60%.",
            "Judged on usability testing results, accessibility compliance, design consistency, and measurable improvements in user task completion rates.",
            "https://example.com/awards/best-ux"),
        new("3", "Innovation Leader", "Forrester Research", "Collaboration Tools", "2024",
            "Named a Leader in the Forrester Wave for collaboration platforms, scoring highest in strategy and current offering.",
            "Evaluated across 28 criteria spanning current offering, strategy, and market presence with weighted scoring methodology.",
            "https://example.com/awards/forrester-leader"),
        new("4", "Top Rated Platform", "G2 Crowd", "Project Management", "2024",
            "Earned Top Rated status based on verified user reviews, with a 4.8/5 average across 2,400+ reviews.",
            "Based on authentic user reviews, implementation scores, user adoption rates, and satisfaction metrics collected over 12 months.",
            "https://example.com/awards/g2-top-rated"),
