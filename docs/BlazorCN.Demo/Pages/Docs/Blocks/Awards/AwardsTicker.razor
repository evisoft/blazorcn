@* ============================================================
   Block: awards-ticker
   Title: Awards Ticker
   Description: Awards section with a single-line scrolling news ticker of award announcements
   Long Description: Subtle credibility on a single line. This React awards ticker displays award wins in a smooth horizontally scrolling single line, like a stock ticker or news crawl. Built with Tailwind CSS keyframe animation and pause-on-hover. Unlike a marquee with rows of pills, this is just one continuous line of text separated by dots. Perfect for placing between hero and features sections, above footers, or anywhere you need a lightweight trust signal without taking up vertical space.
   Dependencies: (none)
   Source: original/blocks/awards/awards-ticker.tsx
   ============================================================ *@

@{
    var tickerText = string.Join(" \u00B7 ", _awards);
}

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="overflow-hidden px-6 py-3">
            <div class="flex animate-[ticker_25s_linear_infinite] hover:[animation-play-state:paused]">
                <p class="shrink-0 whitespace-nowrap pr-8 font-mono text-xs text-muted-foreground">@tickerText</p>
                <p class="shrink-0 whitespace-nowrap pr-8 font-mono text-xs text-muted-foreground">@tickerText</p>
            </div>
        </div>
    </div>

    <style>
        @@keyframes ticker {
            from { transform: translateX(0); }
            to { transform: translateX(-50%); }
        }
    </style>
</section>

@code {
    private readonly string[] _awards =
    [
        "Best SaaS 2024 — TechCrunch",
        "Forbes Cloud 100",
        "Product Hunt #1 Product of the Day",
        "Webby Award Winner",
    ];
}
