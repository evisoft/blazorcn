@* ============================================================
   Block: awards-org-overview
   Title: AwardsOrgOverview
   Description: An organization awards profile block for React and Next.js with company info, total award count, recent wins, and category breakdown built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-org-overview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Company header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-muted">
                    <LucideIconCn Name="building" Size="20" Class="size-5 text-muted-foreground" />
                </div>
                <div class="min-w-0 flex-1">
                    <h2 class="text-sm font-medium">@_companyName</h2>
                    <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                        <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                        <span>Founded @_foundedYear</span>
                    </div>
                </div>
            </div>
            <p class="mt-2 text-xs text-muted-foreground">@_description</p>
        </div>

        @* Total awards count *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideIconCn Name="trophy" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-2xl font-semibold tabular-nums">@_totalAwards</span>
            <span class="text-xs text-muted-foreground">awards and recognitions</span>
        </div>

        @* Recent awards *@
        <div class="border-b">
            <div class="px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">Recent Awards</span>
            </div>
            @for (int i = 0; i < _recentAwards.Length; i++)
            {
                var award = _recentAwards[i];
                var isLast = i == _recentAwards.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                    <div class="min-w-0 flex-1">
                        <span class="text-sm font-medium">@award.Name</span>
                    </div>
                    <span class="text-xs text-muted-foreground">@award.Organization</span>
                    <span class="font-mono text-xs text-muted-foreground tabular-nums">@award.Year</span>
                </div>
            }
        </div>

        @* Categories *@
        <div class="px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Key Categories</span>
            <div class="mt-2 flex flex-wrap gap-1.5">
                @foreach (var cat in _categories)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">@cat</BadgeCn>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private const string _companyName = "Acme Corp";
    private const string _foundedYear = "2018";
    private const int _totalAwards = 47;
    private const string _description =
        "Enterprise software platform recognized across design, engineering, and product innovation categories.";

    private record RecentAward(string Id, string Name, string Organization, string Year);

    private static readonly RecentAward[] _recentAwards =
    [
        new("1", "Best Developer Tool", "DevOps Awards", "2025"),
        new("2", "Product of the Year", "SaaS Awards", "2025"),
        new("3", "Innovation in Design", "Webby Awards", "2024"),
        new("4", "Top 50 Startups", "Forbes Cloud 100", "2024"),
    ];

    private static readonly string[] _categories =
    [
        "Design Excellence",
        "Technical Innovation",
        "Product Strategy",
        "User Experience",
        "Engineering Leadership",
    ];
}
