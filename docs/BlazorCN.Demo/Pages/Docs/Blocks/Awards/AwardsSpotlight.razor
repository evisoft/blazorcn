@* ============================================================
   Block: awards-spotlight
   Title: Awards Spotlight
   Description: Awards section with a clickable grid that opens a dialog with full award details
   Long Description: Awards split layout section with image and detailed award information for React landing pages
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogHeaderCn, DialogTitleCn, LucideExternalLinkCn, LucideTrophyCn
   Source: original/blocks/awards/awards-spotlight.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Award Spotlight</h2>
            <p class="mt-1 text-muted-foreground text-sm">Click an award to see the full story.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2">
            @for (var i = 0; i < _awards.Length; i++)
            {
                var award = _awards[i];
                var index = i;
                var borderClasses = (index < 2 ? "border-b " : "") +
                                    (index % 2 == 0 ? "sm:border-r " : "") +
                                    (index == 2 ? "sm:border-b-0 border-b " : "");
                <button class="@($"flex items-center gap-3 px-6 py-4 text-left transition-colors hover:bg-muted/50 @borderClasses")"
                        @onclick="() => _selected = award" type="button">
                    <LucideTrophyCn class="h-4 w-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0">
                        <p class="text-sm font-medium">@award.Title</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">@award.Org</p>
                    </div>
                </button>
            }
        </div>
    </div>

    <DialogCn Open="@(_selected != null)" OpenChanged="v => { if (!v) _selected = null; }">
        <DialogContentCn Class="sm:max-w-md">
            <DialogHeaderCn>
                <DialogTitleCn Class="text-sm font-semibold">@_selected?.Title</DialogTitleCn>
            </DialogHeaderCn>
            @if (_selected != null)
            {
                <div class="space-y-4">
                    <p class="text-sm leading-relaxed text-muted-foreground">@_selected.Description</p>

                    <div class="space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-xs text-muted-foreground">Organization</span>
                            <span class="text-xs font-medium">@_selected.Org</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-xs text-muted-foreground">Category</span>
                            <span class="text-xs font-medium">@_selected.Category</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-xs text-muted-foreground">Date</span>
                            <span class="text-xs font-medium">@_selected.Date</span>
                        </div>
                    </div>

                    <a href="@_selected.Url" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-md border px-3 py-1.5 text-xs font-medium transition-colors hover:bg-accent">
                        <LucideExternalLinkCn class="h-3 w-3" />
                        Visit website
                    </a>
                </div>
            }
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private record SpotlightAward(string Title, string Org, string Category, string Date, string Description, string Url);

    private SpotlightAward? _selected;

    private readonly SpotlightAward[] _awards =
    [
        new("Product of the Year", "Global Technology Awards", "Enterprise Software", "November 2024",
            "Recognized for outstanding innovation in enterprise collaboration tools, selected from over 1,200 submissions across 40 countries.",
            "https://example.com"),
        new("Best User Experience", "UX Design Awards", "SaaS Platform", "September 2024",
            "Awarded for exceptional interface design and user-centered workflows that reduced onboarding time by 60%.",
            "https://example.com"),
        new("Innovation Leader", "Forrester Research", "Collaboration Tools", "June 2024",
            "Named a Leader in the Forrester Wave for collaboration platforms, scoring highest in strategy and current offering.",
            "https://example.com"),
        new("Top Rated 2024", "G2 Crowd", "Project Management", "March 2024",
            "Earned Top Rated status based on verified user reviews, with a 4.8/5 average across 2,400+ reviews.",
            "https://example.com"),
    ];
}
