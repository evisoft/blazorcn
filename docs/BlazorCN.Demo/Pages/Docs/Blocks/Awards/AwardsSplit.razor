@* ============================================================
   Block: awards-split
   Title: AwardsSplit
   Description: Awards split layout section with image and detailed award information for React landing pages
   Source: original/blocks/awards/awards-split.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Product of the Year 2024</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Global Technology Awards recognition for innovation and user experience.
            </p>
        </div>

        <div class="grid md:grid-cols-2">
            @* Image side *@
            <div class="border-b md:border-b-0 md:border-r">
                <div class="aspect-[4/3] overflow-hidden">
                    <img
                        alt="Award ceremony"
                        class="h-full w-full object-cover"
                        height="400"
                        src="https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=800&h=600&fit=crop"
                        width="400" />
                </div>
            </div>

            @* Content side *@
            <div class="p-6">
                <div class="mb-4 flex items-center gap-2">
                    <LucideTrophyCn class="h-4 w-4 text-muted-foreground" />
                    <span class="text-2xl font-semibold tabular-nums">#1</span>
                    <span class="text-xs text-muted-foreground">in category</span>
                </div>

                <div class="mb-4 flex flex-wrap gap-4 text-xs text-muted-foreground">
                    <div class="flex items-center gap-1.5">
                        <LucideCalendarCn class="h-3.5 w-3.5" />
                        <span>December 2024</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <LucideMapPinCn class="h-3.5 w-3.5" />
                        <span>San Francisco, CA</span>
                    </div>
                </div>

                <div class="mb-4 space-y-2">
                    @foreach (var item in _highlights)
                    {
                        <div class="flex items-center gap-2 text-sm">
                            <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-foreground"></span>
                            <span>@item</span>
                        </div>
                    }
                </div>

                <ButtonCn Class="h-8 gap-1.5 px-3 text-xs" Variant="ButtonVariant.Outline">
                    View press release
                    <LucideExternalLinkCn class="h-3.5 w-3.5" />
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _highlights =
    [
        "Selected from 2,000+ global submissions",
        "Judged by 50 industry experts",
        "Recognized for innovation and impact",
    ];
}
