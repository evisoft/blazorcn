@* ============================================================
   Block: awards-certificate
   Title: AwardsCertificate
   Description: Awards certificate-style section with formal presentation and verification for React landing pages
   Source: original/blocks/awards/awards-certificate.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Official recognition</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Verified achievements from respected industry bodies
            </p>
        </div>

        <div class="divide-y">
            @foreach (var cert in _certificates)
            {
                <div class="flex items-start gap-4 px-6 py-4">
                    <div class="mt-0.5 rounded-md bg-muted/50 p-2">
                        <LucideIconCn Name="award" Size="16" Class="h-4 w-4 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@cert.Title</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">@cert.Org</p>
                        <div class="mt-2 flex items-center gap-3">
                            <span class="text-xs text-muted-foreground">@cert.Date</span>
                            <span class="text-xs text-muted-foreground">&middot;</span>
                            <span class="font-mono text-xs text-muted-foreground">@cert.Id</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-1 rounded-md bg-emerald-500/10 px-2 py-1">
                        <LucideIconCn Name="check-circle" Size="12" Class="h-3 w-3 text-emerald-500" />
                        <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">
                            Verified
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Certificate(string Title, string Org, string Date, string Id);

    private static readonly Certificate[] _certificates =
    [
        new("Excellence in Innovation", "International Technology Council", "December 2024", "ITC-2024-EXC-4892"),
        new("Best Enterprise Solution", "Enterprise Software Awards", "November 2024", "ESA-2024-BES-7731"),
        new("Security Compliance", "SOC 2 Type II", "October 2024", "SOC2-2024-SEC-3310"),
    ];
}
