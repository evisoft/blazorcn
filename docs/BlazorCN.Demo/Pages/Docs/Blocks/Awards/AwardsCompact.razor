@* ============================================================
   Block: awards-compact
   Title: AwardsCompact
   Description: Awards section with compact inline badges for tight spaces
   Source: original/blocks/awards/awards-compact.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Award-winning platform</h2>
            <p class="mt-1 text-muted-foreground text-sm">Trusted by 10,000+ teams worldwide</p>
        </div>

        <div class="p-6">
            <TooltipProviderCn>
                <div class="flex flex-wrap items-center gap-3">
                    @foreach (var award in _awards)
                    {
                        <TooltipCn>
                            <TooltipTriggerCn>
                                <div class="flex cursor-default items-center gap-2 rounded-md bg-muted/50 px-3 py-2">
                                    <LucideIconCn Name="@award.IconName" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                                    <span class="text-xs font-medium">@award.Label</span>
                                </div>
                            </TooltipTriggerCn>
                            <TooltipContentCn>
                                <p class="text-sm font-medium">@award.Label</p>
                                <p class="text-xs text-muted-foreground">@award.Org</p>
                            </TooltipContentCn>
                        </TooltipCn>
                    }
                </div>
            </TooltipProviderCn>
        </div>
    </div>
</section>

@code {
    private record AwardItem(string IconName, string Label, string Org);

    private static readonly AwardItem[] _awards =
    [
        new("trophy", "Product of the Year", "TechCrunch 2024"),
        new("star", "Top Rated", "G2 Crowd 2024"),
        new("award", "Innovation Award", "CES 2024"),
        new("shield", "SOC 2 Certified", "Verified 2024"),
    ];
}
