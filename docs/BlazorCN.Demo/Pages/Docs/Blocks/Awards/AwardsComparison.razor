@* ============================================================
   Block: awards-comparison
   Title: Awards Comparison
   Description: Two awards side-by-side comparing year-over-year recognition with scores and highlights
   Long Description: Awards section with compact inline badges for tight spaces
   Dependencies: BadgeCn
   Source: original/blocks/awards/awards-comparison.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Year-over-year recognition</h2>
            <p class="mt-1 text-muted-foreground text-sm">How our industry standing has evolved</p>
        </div>

        <div class="grid grid-cols-2 border-b">
            @for (var i = 0; i < _years.Length; i++)
            {
                var data = _years[i];
                var borderClass = i == 0 ? "border-r" : "";
                <div class="@($"px-6 py-5 @borderClass")">
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="mb-3 font-normal text-xs">@data.Year</BadgeCn>
                    <h3 class="font-medium text-sm">@data.Award</h3>
                    <p class="mt-0.5 text-muted-foreground text-xs">@data.Org</p>

                    <div class="mt-4 flex items-baseline gap-2">
                        <span class="font-semibold text-2xl tabular-nums">@data.Score</span>
                        <span class="text-muted-foreground text-xs">/100</span>
                    </div>
                    <p class="mt-0.5 text-muted-foreground text-xs">@data.Rank</p>

                    <ul class="mt-4 space-y-2">
                        @foreach (var h in data.Highlights)
                        {
                            <li class="flex items-start gap-2 text-sm">
                                <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-muted-foreground/40"></span>
                                <span class="text-muted-foreground">@h</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        <div class="flex items-center justify-between px-6 py-4">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <span class="font-medium text-sm tabular-nums">+7</span>
                    <span class="text-muted-foreground text-xs">score increase</span>
                </div>
                <span class="text-muted-foreground text-xs">&middot;</span>
                <div class="flex items-center gap-1.5">
                    <span class="font-medium text-sm tabular-nums">+16</span>
                    <span class="text-muted-foreground text-xs">new markets</span>
                </div>
            </div>
            <span class="text-muted-foreground text-xs">3 ranks improved</span>
        </div>
    </div>
</section>

@code {
    private record YearData(string Year, string Award, string Org, int Score, string Rank, string[] Highlights);

    private readonly YearData[] _years =
    [
        new("2023", "Platform Excellence Award", "SaaS Industry Awards", 87, "#4 in Category",
            ["Top 5 in developer tools", "92% customer satisfaction", "Recognized in 12 markets"]),
        new("2024", "Platform of the Year", "SaaS Industry Awards", 94, "#1 in Category",
            ["Category leader across all regions", "97% customer satisfaction", "Recognized in 28 markets"]),
    ];
}
