@* ============================================================
   Block: awards-category-counts
   Title: AwardsCategoryCounts
   Description: A category counts awards block for React and Next.js with icon tiles, category names, and count badges in a grid layout built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-category-counts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Awards by Category</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_categories.Length categories, @_totalAwards total awards
                    </p>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-3">
            @foreach (var entry in _categories.Select((c, i) => new { Cat = c, Idx = i }))
            {
                var row = entry.Idx / 3;
                var col = entry.Idx % 3;
                var isLastRow = row == (_categories.Length - 1) / 3;
                var isLastCol = col == 2;
                <div class="@(Cn.Merge("px-4 py-4", !isLastRow ? "border-b" : "", !isLastCol ? "border-r" : ""))">
                    <div class="flex items-start justify-between">
                        <LucideIconCn Name="@entry.Cat.Icon" Size="16" Class="size-4 text-muted-foreground" />
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal tabular-nums">
                            @entry.Cat.Count
                        </BadgeCn>
                    </div>
                    <p class="mt-2 text-sm font-medium">@entry.Cat.Name</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @(entry.Cat.Count == 1 ? "1 award" : $"{entry.Cat.Count} awards")
                    </p>
                </div>
            }
        </div>

        <div class="flex items-center gap-2 border-t px-4 py-2.5 text-xs text-muted-foreground">
            <span class="tabular-nums">@_totalAwards total awards</span>
            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
            <span>@_categories.Length categories</span>
        </div>
    </div>
</section>

@code {
    private record CategoryItem(string Id, string Name, int Count, string Icon);

    private static readonly CategoryItem[] _categories =
    [
        new("1", "Technology",    12, "cpu"),
        new("2", "Design",         9, "brush"),
        new("3", "Innovation",     7, "lightbulb"),
        new("4", "Sustainability", 5, "leaf"),
        new("5", "Leadership",     4, "shield"),
        new("6", "Community",      3, "heart"),
        new("7", "Performance",    6, "zap"),
        new("8", "Teamwork",       4, "users"),
        new("9", "Communication",  2, "mic"),
    ];

    // 12+9+7+5+4+3+6+4+2 = 52
    private static readonly int _totalAwards = 52;
}
