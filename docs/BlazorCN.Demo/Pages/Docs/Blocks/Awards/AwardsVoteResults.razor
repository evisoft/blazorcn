@* ============================================================
   Block: awards-vote-results
   Title: AwardsVoteResults
   Description: A community voting results display block for React and Next.js with horizontal fill bars, vote counts, percentages, and total votes summary built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-vote-results.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="text-sm font-medium">Community Voting Results</h2>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Best Developer Tool 2025
                </p>
            </div>
            <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <LucideIconCn Name="users" Size="14" Class="size-3.5" />
                <span class="tabular-nums">@_totalVotes.ToString("N0")</span>
                <span>votes</span>
            </div>
        </div>

        <div>
            @for (var i = 0; i < _nominees.Length; i++)
            {
                var nominee = _nominees[i];
                var percentage = (int)Math.Round((double)nominee.Votes / _totalVotes * 100);
                var barWidth = (int)Math.Round((double)nominee.Votes / _maxVotes * 100);
                var isLast = i == _nominees.Length - 1;
                var isWinner = i == 0;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-3">
                        <div class="mb-2 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                @if (isWinner)
                                {
                                    <LucideIconCn Name="trophy" Size="14" Class="size-3.5 text-amber-500" />
                                }
                                <span class="text-sm font-medium">@nominee.Name</span>
                                @if (isWinner)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                        Winner
                                    </BadgeCn>
                                }
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="text-xs tabular-nums text-muted-foreground">
                                    @nominee.Votes.ToString("N0")
                                </span>
                                <span class="w-8 text-right text-xs tabular-nums font-medium">
                                    @percentage%
                                </span>
                            </div>
                        </div>
                        <div class="h-2 w-full overflow-hidden rounded-full bg-muted/50">
                            <div class="h-full rounded-full @nominee.Color"
                                 style="width:@(barWidth)%"
                                 role="progressbar"
                                 aria-valuenow="@nominee.Votes"
                                 aria-valuemax="@_maxVotes">
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="flex items-center gap-2 border-t px-4 py-2.5 text-xs text-muted-foreground">
            <span>Voting closed</span>
            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
            <span>@_nominees.Length nominees</span>
            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
            <span>Results certified</span>
        </div>
    </div>
</section>

@code {
    private record Nominee(string Id, string Name, string Category, int Votes, string Color);

    private static readonly Nominee[] _nominees =
    [
        new("1", "Vercel",        "Best Developer Tool", 4218, "bg-foreground"),
        new("2", "Linear",        "Best Developer Tool", 3876, "bg-blue-500"),
        new("3", "Figma",         "Best Developer Tool", 3241, "bg-violet-500"),
        new("4", "Raycast",       "Best Developer Tool", 2890, "bg-emerald-500"),
        new("5", "Arc Browser",   "Best Developer Tool", 1654, "bg-amber-500"),
        new("6", "Warp Terminal", "Best Developer Tool", 1102, "bg-red-500"),
    ];

    private static readonly int _totalVotes = _nominees.Sum(n => n.Votes);
    private static readonly int _maxVotes   = _nominees[0].Votes;
}
