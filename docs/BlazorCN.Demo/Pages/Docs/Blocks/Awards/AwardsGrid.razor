@* ============================================================
   Block: awards-grid
   Title: AwardsGrid
   Description: Awards grid section with trophy icons and recognition cards for React landing pages
   Source: original/blocks/awards/awards-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Industry Recognition</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Awards from leading organizations worldwide
            </p>
        </div>

        <div class="grid gap-px bg-border sm:grid-cols-2">
            @foreach (var award in _awards)
            {
                <div class="bg-card p-5">
                    <LucideIconCn Name="trophy" Size="16" Class="mb-2 h-4 w-4 text-muted-foreground" />
                    <p class="text-sm font-medium">@award.Title</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@award.Org</p>
                    <p class="mt-2 text-xs text-muted-foreground">@award.Year</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Award(string Title, string Org, string Year);

    private static readonly Award[] _awards =
    [
        new("Best SaaS Product", "TechCrunch Disrupt", "2024"),
        new("Top 100 Startups", "Forbes", "2024"),
        new("Innovation Award", "Product Hunt", "2023"),
        new("Best UX Design", "Webby Awards", "2023"),
    ];
}
