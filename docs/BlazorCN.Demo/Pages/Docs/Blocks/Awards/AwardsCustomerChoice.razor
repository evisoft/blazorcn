@* ============================================================
   Block: awards-customer-choice
   Title: AwardsCustomerChoice
   Description: Customer choice awards with voting results and satisfaction scores
   Source: original/blocks/awards/awards-customer-choice.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="trophy" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Customer Choice Awards</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Voted by real users on independent platforms
            </p>
        </div>

        <div class="divide-y">
            @foreach (var award in _customerAwards)
            {
                var percent = (award.Score / award.MaxScore) * 100;
                <div class="px-4 py-4">
                    <div class="flex items-start gap-3">
                        <LucideIconCn Name="@award.Icon" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center justify-between gap-2">
                                <p class="text-sm font-medium">@award.Platform</p>
                                <p class="text-lg font-semibold tabular-nums">
                                    @award.Score
                                    <span class="text-xs font-normal text-muted-foreground">
                                        /@award.MaxScore
                                    </span>
                                </p>
                            </div>
                            <p class="text-xs text-muted-foreground">@award.Title</p>
                            <div class="mt-2">
                                <ProgressCn Class="h-1.5" Value="@((int)percent)" />
                            </div>
                            <p class="mt-1.5 text-xs text-muted-foreground">
                                Based on @award.Reviews verified reviews
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                5,880+ verified customer reviews across all platforms
            </p>
        </div>
    </div>
</section>

@code {
    private record CustomerAward(string Platform, string Title, double Score, double MaxScore, string Reviews, string Icon);

    private static readonly CustomerAward[] _customerAwards =
    [
        new("G2 Crowd", "Leader — Spring 2025", 4.8, 5, "2,340", "star"),
        new("Capterra", "Best Value 2025", 4.7, 5, "1,890", "thumbs-up"),
        new("TrustRadius", "Top Rated 2025", 9.2, 10, "980", "heart"),
        new("Gartner Peer Insights", "Customers' Choice", 4.6, 5, "670", "users"),
    ];
}
