@* ============================================================
   Block: awards-social-impact
   Title: AwardsSocialImpact
   Description: Social impact awards showcasing contributions to community, equity, diversity, and positive change
   Source: original/blocks/awards/awards-social-impact.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="heart-handshake" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Social Impact Awards</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Recognized for meaningful contributions to society
            </p>
        </div>

        <div class="divide-y">
            @foreach (var award in _awards)
            {
                <div class="px-4 py-3">
                    <div class="flex items-start gap-3">
                        <LucideIconCn Name="@award.IconName" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <p class="text-sm font-medium">@award.Title</p>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] px-1.5 py-0">
                                    @award.Area
                                </BadgeCn>
                            </div>
                            <p class="text-xs text-muted-foreground">
                                @award.Org &middot; @award.Year
                            </p>
                            <p class="mt-1 text-xs text-muted-foreground">@award.Outcome</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                5 impact awards across community, diversity, climate, ethics, and inclusion
            </p>
        </div>
    </div>
</section>

@code {
    private record ImpactAward(string Title, string Org, string Year, string Area, string Outcome, string IconName);

    private static readonly ImpactAward[] _awards =
    [
        new("Social Enterprise of the Year", "B Lab Global", "2025", "Community Development",
            "Top 10% of B-Corps worldwide for community impact", "heart-handshake"),
        new("Best Workplace for Diversity", "Great Place to Work", "2025", "Equity & Inclusion",
            "52% underrepresented groups in leadership roles", "users"),
        new("Climate Action Leader", "CDP", "2024", "Carbon Reduction",
            "Carbon neutral operations since 2023", "tree-pine"),
        new("Ethical Business Award", "Ethisphere Institute", "2024", "Corporate Ethics",
            "5th consecutive year on World's Most Ethical list", "scale"),
        new("Digital Inclusion Champion", "World Economic Forum", "2024", "Accessibility",
            "Free tier serving 200K+ users in underserved communities", "globe"),
    ];
}
