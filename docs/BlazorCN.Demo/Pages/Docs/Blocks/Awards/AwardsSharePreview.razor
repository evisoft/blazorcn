@* ============================================================
   Block: awards-share-preview
   Title: AwardsSharePreview
   Description: Block example: awards
   Source: original/blocks/awards/awards-share-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Share this award</h2>
            <p class="mt-1 text-sm text-muted-foreground">Let the world know about your recognition</p>
        </div>

        <div class="p-6 space-y-6">
            @* Social share preview card *@
            <div class="overflow-hidden rounded-lg border bg-muted/40">
                <div class="flex items-center gap-4 border-b bg-background px-5 py-4">
                    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary/10">
                        <LucideIconCn Name="trophy" Size="22" Class="size-5 text-primary" />
                    </div>
                    <div class="min-w-0">
                        <p class="truncate text-sm font-semibold">Best Innovation Award 2024</p>
                        <p class="text-xs text-muted-foreground">TechCrunch Disrupt · November 2024</p>
                    </div>
                    <BadgeCn Class="ml-auto shrink-0">Winner</BadgeCn>
                </div>
                <div class="px-5 py-4">
                    <p class="text-sm text-muted-foreground">
                        Proud to be recognized for outstanding innovation in workflow automation.
                        Selected from over 2,000 global submissions.
                    </p>
                    <p class="mt-3 text-xs text-muted-foreground/70">example.com</p>
                </div>
            </div>

            @* Share to platforms *@
            <div class="space-y-2">
                <p class="text-sm font-medium">Share to</p>
                <div class="flex flex-wrap gap-2">
                    @foreach (var platform in _platforms)
                    {
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-2">
                            <LucideIconCn Name="@platform.Icon" Size="16" Class="size-4" />
                            @platform.Label
                        </ButtonCn>
                    }
                </div>
            </div>

            @* Copy link *@
            <div class="space-y-2">
                <p class="text-sm font-medium">Or copy link</p>
                <div class="flex gap-2">
                    <div class="flex h-9 flex-1 items-center overflow-hidden rounded-md border bg-muted px-3">
                        <span class="truncate text-sm text-muted-foreground">@_shareUrl</span>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="shrink-0 gap-2" @onclick="CopyLink">
                        @if (_copied)
                        {
                            <LucideIconCn Name="check" Size="16" Class="size-4 text-green-600" />
                            <span>Copied</span>
                        }
                        else
                        {
                            <LucideIconCn Name="copy" Size="16" Class="size-4" />
                            <span>Copy</span>
                        }
                    </ButtonCn>
                </div>
            </div>
        </div>

        <div class="border-t px-6 py-3">
            <p class="text-xs text-muted-foreground">Sharing this award helps build trust with future customers.</p>
        </div>
    </div>
</section>

@code {
    private record SharePlatform(string Label, string Icon);

    private static readonly SharePlatform[] _platforms =
    [
        new("LinkedIn",  "linkedin"),
        new("Twitter / X", "twitter"),
        new("Facebook",  "facebook"),
        new("Email",     "mail"),
    ];

    private const string _shareUrl = "https://example.com/awards/best-innovation-2024";
    private bool _copied = false;

    private void CopyLink()
    {
        _copied = true;
        // In a real implementation, use JSInterop to copy to clipboard.
    }
}
