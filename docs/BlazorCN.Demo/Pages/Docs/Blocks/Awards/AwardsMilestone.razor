@* ============================================================
   Block: awards-milestone
   Title: AwardsMilestone
   Description: Awards tied to company milestones showing cause-and-effect between growth and recognition
   Source: original/blocks/awards/awards-milestone.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Milestones & recognition</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                How growth unlocked industry recognition
            </p>
        </div>

        <div class="divide-y">
            @foreach (var item in _milestones)
            {
                <div class="px-6 py-4">
                    <p class="mb-3 text-xs text-muted-foreground">@item.Period</p>
                    <div class="flex items-center gap-3">
                        @* Milestone *@
                        <div class="flex min-w-0 flex-1 items-start gap-2.5">
                            <LucideIconCn Name="flag" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
                            <span class="text-sm font-medium">@item.Milestone</span>
                        </div>

                        @* Connector *@
                        <LucideIconCn Name="arrow-right" Size="14" Class="h-3.5 w-3.5 shrink-0 text-muted-foreground/40" />

                        @* Award *@
                        <div class="flex min-w-0 flex-1 items-start gap-2.5">
                            <LucideIconCn Name="trophy" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
                            <div class="min-w-0">
                                <span class="text-sm font-medium">@item.Award</span>
                                <p class="mt-0.5 text-xs text-muted-foreground">@item.AwardOrg</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record MilestoneItem(string Id, string Milestone, string Award, string AwardOrg, string Period);

    private static readonly MilestoneItem[] _milestones =
    [
        new("100k-users", "Reached 100K users", "Product Hunt #1 Product of the Day", "Product Hunt", "Q1 2024"),
        new("series-a", "Closed $12M Series A", "Forbes 30 Under 30 — Enterprise Tech", "Forbes", "Q3 2023"),
        new("10m-arr", "Surpassed $10M ARR", "Deloitte Technology Fast 500", "Deloitte", "Q4 2023"),
    ];
}
