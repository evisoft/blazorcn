@* ============================================================
   Block: awards-receipt-slip
   Title: AwardsReceiptSlip
   Description: A receipt-style awards display block for React and Next.js with monospace line items, separator dashes, subtotal count, and verified stamp built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-receipt-slip.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3 text-center">
            <p class="font-mono text-sm font-medium">AWARDS RECEIPT</p>
            <p class="mt-0.5 font-mono text-[10px] text-muted-foreground">
                Transaction ID: AWD-2025-0001
            </p>
            <p class="font-mono text-[10px] text-muted-foreground">
                Date: March 15, 2025
            </p>
        </div>

        <div class="px-4 py-3">
            <p class="mb-2 font-mono text-[10px] tracking-wider text-muted-foreground">
                ITEM                        YR
            </p>
            <p class="mb-2 font-mono text-[10px] text-muted-foreground/50">
                @_separator
            </p>

            @foreach (var item in _lineItems)
            {
                <div class="mb-1.5">
                    <div class="flex items-baseline justify-between gap-2">
                        <span class="min-w-0 truncate font-mono text-xs">
                            @item.Name
                        </span>
                        <span class="shrink-0 font-mono text-xs tabular-nums text-muted-foreground">
                            @item.Year
                        </span>
                    </div>
                    <p class="font-mono text-[10px] text-muted-foreground">
                        via @item.Organization
                    </p>
                </div>
            }

            <p class="my-2 font-mono text-[10px] text-muted-foreground/50">
                @_separator
            </p>

            <div class="flex items-baseline justify-between">
                <span class="font-mono text-xs font-medium">AWARDS WON</span>
                <span class="font-mono text-xs font-medium tabular-nums">@_totalAwards</span>
            </div>

            <div class="mt-1 flex items-baseline justify-between">
                <span class="font-mono text-[10px] text-muted-foreground">WIN RATE</span>
                <span class="font-mono text-[10px] tabular-nums text-muted-foreground">100%</span>
            </div>
        </div>

        <div class="border-t px-4 py-3 text-center">
            <div class="flex items-center justify-center gap-1.5">
                <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500" />
                <span class="font-mono text-xs font-medium text-emerald-600 dark:text-emerald-400">
                    VERIFIED
                </span>
            </div>
            <p class="mt-1 font-mono text-[10px] text-muted-foreground">
                Thank you for your excellence
            </p>
        </div>
    </div>
</section>

@code {
    private record LineItem(string Id, string Name, string Organization, string Year);

    private static readonly LineItem[] _lineItems =
    [
        new("1", "Product of the Year", "TechCrunch", "2025"),
        new("2", "Best User Experience", "Webby Awards", "2025"),
        new("3", "Innovation Excellence", "Fast Company", "2024"),
        new("4", "Developer Tool Award", "DevOps Awards", "2024"),
        new("5", "Customer Choice", "G2 Crowd", "2023"),
        new("6", "Top 50 Startups", "Forbes", "2023"),
    ];

    private static readonly int _totalAwards = _lineItems.Length;
    private static readonly string _separator = string.Concat(Enumerable.Repeat("- ", 20));
}
