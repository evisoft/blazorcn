@* ============================================================
   Block: awards-flip
   Title: AwardsFlip
   Description: Awards flip card section with CSS perspective 3D hover effect revealing award details for React landing pages
   Source: original/blocks/awards/awards-flip.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Award-Winning Platform</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Hover or tap each card to see the full story
            </p>
        </div>

        <div class="grid grid-cols-2 gap-4 p-6">
            @for (var i = 0; i < _awards.Length; i++)
            {
                var award = _awards[i];
                var idx = i;
                var isFlipped = _flipped[idx];
                <div class="group cursor-pointer"
                     style="perspective:600px"
                     @onclick="@(() => ToggleFlip(idx))"
                     role="button"
                     tabindex="0"
                     aria-label="@($"{award.Title} — {award.Org}. Click to {(isFlipped ? "hide" : "show")} details.")">
                    <div class="relative aspect-[4/3] w-full transition-transform duration-600"
                         style="@($"transform-style:preserve-3d;transform:{(isFlipped ? "rotateY(180deg)" : "rotateY(0deg)")}")">
                        @* Front Face *@
                        <div class="absolute inset-0 flex flex-col items-center justify-center rounded-md border bg-muted/50 p-4 transition-colors group-hover:bg-muted/80"
                             style="backface-visibility:hidden">
                            <LucideIconCn Name="trophy" Size="20" Class="mb-3 h-5 w-5 text-muted-foreground" />
                            <p class="text-center text-sm font-medium">@award.Title</p>
                            <p class="mt-1 text-center text-xs text-muted-foreground">@award.Org</p>
                            <p class="mt-3 text-xs text-muted-foreground/60">Click to flip</p>
                        </div>

                        @* Back Face *@
                        <div class="absolute inset-0 flex flex-col justify-between rounded-md border bg-muted/50 p-4"
                             style="backface-visibility:hidden;transform:rotateY(180deg)">
                            <div>
                                <p class="text-sm font-medium">@award.Title</p>
                                <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                                    @award.Description
                                </p>
                            </div>
                            <div class="mt-3 space-y-1.5">
                                <div class="flex items-center gap-1.5">
                                    <LucideIconCn Name="award" Size="12" Class="h-3 w-3 text-muted-foreground/60" />
                                    <span class="text-xs text-muted-foreground">@award.Org</span>
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <LucideIconCn Name="layers" Size="12" Class="h-3 w-3 text-muted-foreground/60" />
                                    <span class="text-xs text-muted-foreground">@award.Category</span>
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <LucideIconCn Name="calendar" Size="12" Class="h-3 w-3 text-muted-foreground/60" />
                                    <span class="text-xs text-muted-foreground">@award.Year</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-6 py-3">
            <p class="text-xs text-muted-foreground">
                Recognized by leading industry organizations since 2023
            </p>
        </div>
    </div>
</section>

@code {
    private bool[] _flipped = new bool[4];

    private void ToggleFlip(int index)
    {
        _flipped[index] = !_flipped[index];
    }

    private record FlipAward(string Title, string Org, string Year, string Category, string Description);

    private static readonly FlipAward[] _awards =
    [
        new("Best SaaS Product", "TechCrunch Disrupt", "2024", "Product Excellence",
            "Recognized for outstanding innovation in developer tooling and exceptional user experience across the platform."),
        new("Top 100 Startups", "Forbes", "2024", "Growth & Impact",
            "Selected among the fastest-growing startups globally for sustained revenue growth and market expansion."),
        new("Innovation Award", "Product Hunt", "2023", "Technical Innovation",
            "Awarded for pioneering new approaches to component-driven development and open-source community building."),
        new("Best UX Design", "Webby Awards", "2023", "Design & Usability",
            "Honored for intuitive interface design, accessibility-first approach, and seamless developer workflows."),
    ];
}
