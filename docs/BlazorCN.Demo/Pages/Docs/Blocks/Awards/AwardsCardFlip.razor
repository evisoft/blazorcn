@* ============================================================
   Block: awards-card-flip
   Title: AwardsCardFlip
   Description: Interactive cards that flip on click to reveal detailed award information
   Source: original/blocks/awards/awards-card-flip.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Award Details</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Click any award to reveal details</p>
        </div>

        <div class="grid grid-cols-2 gap-px bg-border">
            @foreach (var award in _awards)
            {
                var isFlipped = _flipped == award.Id;
                <button type="button"
                        @onclick="@(() => _flipped = isFlipped ? null : award.Id)"
                        class="relative bg-card p-4 text-left transition-colors hover:bg-muted/50"
                        style="min-height:140px">
                    @if (!isFlipped)
                    {
                        <div class="flex flex-col items-center gap-2 text-center">
                            <LucideIconCn Name="@award.Icon" Size="20" Class="h-5 w-5 text-muted-foreground" />
                            <div>
                                <p class="text-sm font-medium">@award.Title</p>
                                <p class="mt-0.5 text-xs text-muted-foreground">@award.Org</p>
                                <p class="mt-1 text-xs tabular-nums text-muted-foreground">
                                    @award.Year
                                </p>
                            </div>
                            <span class="text-[10px] text-muted-foreground/60">Click to flip</span>
                        </div>
                    }
                    else
                    {
                        <div>
                            <p class="text-xs font-medium text-muted-foreground">@award.Title</p>
                            <p class="mt-1.5 text-xs text-muted-foreground leading-relaxed">
                                @award.Description
                            </p>
                            <div class="mt-2 rounded bg-muted/50 px-2 py-1">
                                <p class="text-[10px] text-muted-foreground">
                                    Criteria: @award.Criteria
                                </p>
                            </div>
                        </div>
                    }
                </button>
            }
        </div>
    </div>
</section>

@code {
    private string? _flipped;

    private record FlipAward(string Id, string Icon, string Title, string Org, string Year, string Description, string Criteria);

    private static readonly FlipAward[] _awards =
    [
        new("f1", "trophy", "Product of the Year", "Global SaaS Awards", "2025",
            "Selected from 2,400 nominations across 60 countries for exceptional product innovation.",
            "Innovation, adoption, user satisfaction"),
        new("f2", "award", "Best Developer Experience", "DevOps World", "2025",
            "Recognized for API design excellence and comprehensive documentation standards.",
            "API quality, docs, onboarding time"),
        new("f3", "star", "Most Loved Tool", "Stack Overflow Survey", "2024",
            "Voted by 70,000+ developers as the top tool for productivity and developer experience.",
            "Community votes, satisfaction score"),
        new("f4", "trophy", "Enterprise Innovation", "Gartner", "2024",
            "Named a Leader in the Magic Quadrant for completeness of vision and ability to execute.",
            "Market presence, vision, execution"),
    ];
}
