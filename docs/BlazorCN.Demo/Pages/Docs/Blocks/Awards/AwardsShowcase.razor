@* ============================================================
   Block: awards-showcase
   Title: AwardsShowcase
   Description: Awards showcase section with detailed award cards for React landing pages
   Source: original/blocks/awards/awards-showcase.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Industry Recognition</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Awards that reflect our commitment to quality and innovation.
            </p>
        </div>

        <div class="grid gap-4 p-6 sm:grid-cols-3">
            @foreach (var award in _awards)
            {
                <div class="rounded-md bg-muted/50 p-4" key="@award.Title">
                    <LucideIconCn Name="@award.Icon" Size="16" Class="mb-2 h-4 w-4 text-muted-foreground" />
                    <p class="text-sm font-medium">@award.Title</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @award.Org &middot; @award.Year
                    </p>
                    <p class="mt-2 text-xs text-muted-foreground">@award.Description</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Award(string Icon, string Title, string Org, string Year, string Description);

    private static readonly Award[] _awards =
    [
        new("sparkles", "Excellence in Innovation", "World Tech Summit", "2024", "Recognized for groundbreaking AI integration"),
        new("star", "Best Enterprise Solution", "Enterprise Tech Awards", "2024", "Top-rated platform for large organizations"),
        new("gem", "Design Excellence", "International Design Awards", "2023", "Outstanding user interface and experience"),
    ];
}
