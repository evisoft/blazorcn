@* ============================================================
   Block: awards-leaderboard
   Title: AwardsLeaderboard
   Description: Awards leaderboard with ranked positions, scores, and competitive standings
   Source: original/blocks/awards/awards-leaderboard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="trophy" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Industry Leaderboard</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Developer Tools Category &middot; G2 Spring 2025
            </p>
        </div>

        @* Column headers *@
        <div class="flex items-center gap-3 border-b bg-muted/30 px-4 py-2 text-xs font-medium text-muted-foreground">
            <span class="w-8">#</span>
            <span class="flex-1">Company</span>
            <span class="w-12 text-right">Score</span>
            <span class="w-12 text-right">Trend</span>
        </div>

        <div class="divide-y">
            @foreach (var entry in _leaderboard)
            {
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", entry.IsUs ? "bg-muted/30" : "")">
                    <span class="w-8 font-mono text-sm font-semibold tabular-nums text-muted-foreground">
                        @entry.Rank
                    </span>
                    <div class="flex-1 min-w-0">
                        <p class="@Cn.Merge("text-sm", entry.IsUs ? "font-medium" : "text-muted-foreground")">
                            @entry.Name
                            @if (entry.IsUs)
                            {
                                <span class="ml-1.5 text-[10px] text-muted-foreground">(You)</span>
                            }
                        </p>
                    </div>
                    <span class="w-12 text-right font-mono text-sm tabular-nums">@entry.Score</span>
                    <span class="flex w-12 items-center justify-end gap-0.5 text-xs">
                        @if (entry.Change == "up")
                        {
                            <LucideIconCn Name="arrow-up" Size="12" Class="h-3 w-3 text-emerald-600" />
                            <span class="tabular-nums text-emerald-600">@entry.ChangeValue</span>
                        }
                        @if (entry.Change == "down")
                        {
                            <LucideIconCn Name="arrow-up" Size="12" Class="h-3 w-3 rotate-180 text-red-500" />
                            <span class="tabular-nums text-red-500">@entry.ChangeValue</span>
                        }
                        @if (entry.Change == "same")
                        {
                            <LucideIconCn Name="minus" Size="12" Class="h-3 w-3 text-muted-foreground" />
                        }
                    </span>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                Based on 5,200+ verified reviews &middot; Updated quarterly
            </p>
        </div>
    </div>
</section>

@code {
    private record LeaderboardEntry(int Rank, string Name, double Score, string Change, int ChangeValue, bool IsUs);

    private static readonly LeaderboardEntry[] _leaderboard =
    [
        new(1, "Our Company",  9.7, "up",   2, true),
        new(2, "Competitor A", 9.4, "down", 1, false),
        new(3, "Competitor B", 9.2, "same", 0, false),
        new(4, "Competitor C", 9.0, "up",   1, false),
        new(5, "Competitor D", 8.8, "down", 2, false),
        new(6, "Competitor E", 8.6, "same", 0, false),
        new(7, "Competitor F", 8.3, "up",   3, false),
    ];
}
