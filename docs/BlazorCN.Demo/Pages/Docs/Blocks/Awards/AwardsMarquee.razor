@* ============================================================
   Block: awards-marquee
   Title: Awards Marquee
   Description: Awards section with horizontal scrolling logo strip
   Long Description: Awards organized by geographic region with country flags and organization details
   Dependencies: LucideAwardCn, LucideCrownCn, LucideMedalCn, LucideStarCn, LucideTrophyCn
   Source: original/blocks/awards/awards-marquee.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Recognized Worldwide</h2>
            <p class="mt-1 text-muted-foreground text-sm">Trusted by industry leaders across the globe</p>
        </div>

        @* Marquee container *@
        <div class="relative overflow-hidden py-5">
            @* Row 1 - scrolling left *@
            <div class="mb-3 flex gap-3">
                <div class="flex animate-[scroll_30s_linear_infinite] gap-3 hover:[animation-play-state:paused]">
                    @foreach (var award in _row1.Concat(_row1))
                    {
                        <div class="flex shrink-0 items-center gap-2 rounded-md bg-muted/50 px-3 py-2">
                            <LucideTrophyCn Class="h-3.5 w-3.5 text-muted-foreground" Size="14" />
                            <span class="whitespace-nowrap text-sm font-medium">@award.Name</span>
                            <span class="whitespace-nowrap text-xs text-muted-foreground">@award.Org</span>
                        </div>
                    }
                </div>
            </div>

            @* Row 2 - scrolling right *@
            <div class="flex gap-3">
                <div class="flex animate-[scroll_35s_linear_infinite_reverse] gap-3 hover:[animation-play-state:paused]">
                    @foreach (var award in _row2.Concat(_row2))
                    {
                        <div class="flex shrink-0 items-center gap-2 rounded-md bg-muted/50 px-3 py-2">
                            <LucideAwardCn Class="h-3.5 w-3.5 text-muted-foreground" Size="14" />
                            <span class="whitespace-nowrap text-sm font-medium">@award.Name</span>
                            <span class="whitespace-nowrap text-xs text-muted-foreground">@award.Org</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <style>
        @@keyframes scroll {
            from { transform: translateX(0); }
            to { transform: translateX(-50%); }
    </style>
</section>

@code {
    private record MarqueeAward(string Name, string Org);

    private static readonly MarqueeAward[] _row1 =
    [
        new("Best Product 2024", "TechCrunch"),
        new("Top Rated", "G2 Crowd"),
        new("Innovation Award", "CES"),
        new("Market Leader", "Forrester"),
    ];

    private static readonly MarqueeAward[] _row2 =
    [
        new("Trust Leader", "TrustRadius"),
        new("Customer Favorite", "Capterra"),
        new("Growth Champion", "Deloitte"),
        new("Design Award", "Red Dot"),
    ];
}
