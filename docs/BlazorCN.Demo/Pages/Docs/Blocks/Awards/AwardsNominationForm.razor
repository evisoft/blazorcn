@* ============================================================
   Block: awards-nomination-form
   Title: AwardsNominationForm
   Description: Award nomination submission form with category selection and nominee details
   Source: original/blocks/awards/awards-nomination-form.tsx
   ============================================================ *@

@if (_submitted)
{
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="px-4 py-12 text-center">
                <LucideIconCn Name="award" Class="mx-auto mb-3 h-6 w-6 text-muted-foreground" />
                <p class="text-sm font-medium">Nomination submitted</p>
                <p class="mt-1 text-xs text-muted-foreground">
                    Thank you. Winners will be announced in Q2 2025.
                </p>
                <button
                    type="button"
                    @onclick="@(() => _submitted = false)"
                    class="mt-4 rounded-md border px-3 py-1.5 text-xs font-medium transition-colors hover:bg-muted/50">
                    Submit another
                </button>
            </div>
        </div>
    </section>
}
else
{
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="award" Class="h-4 w-4 text-muted-foreground" />
                    <h2 class="text-sm font-medium">Submit a Nomination</h2>
                </div>
                <p class="mt-0.5 text-xs text-muted-foreground">Annual Excellence Awards 2025</p>
            </div>

            <div class="px-4 py-4 space-y-4">
                @* Category *@
                <div>
                    <span class="text-xs font-medium text-muted-foreground">Category</span>
                    <div class="mt-1.5 flex flex-wrap gap-1.5">
                        @foreach (var cat in _categories)
                        {
                            <button
                                type="button"
                                @onclick="@(() => _category = cat)"
                                class="@GetCatClass(cat)">
                                @cat
                            </button>
                        }
                    </div>
                </div>

                @* Nominee *@
                <div>
                    <span class="text-xs font-medium text-muted-foreground">Nominee name</span>
                    <input
                        type="text"
                        placeholder="Person or team name"
                        class="mt-1.5 w-full rounded-md border bg-transparent px-3 py-2 text-sm outline-none placeholder:text-muted-foreground focus:ring-1 focus:ring-ring" />
                </div>

                @* Department *@
                <div>
                    <span class="text-xs font-medium text-muted-foreground">Department</span>
                    <input
                        type="text"
                        placeholder="e.g., Engineering, Design, Sales"
                        class="mt-1.5 w-full rounded-md border bg-transparent px-3 py-2 text-sm outline-none placeholder:text-muted-foreground focus:ring-1 focus:ring-ring" />
                </div>

                @* Reason *@
                <div>
                    <span class="text-xs font-medium text-muted-foreground">Why should they win?</span>
                    <textarea
                        rows="3"
                        placeholder="Describe their specific achievement or impact..."
                        class="mt-1.5 w-full resize-none rounded-md border bg-transparent px-3 py-2 text-sm outline-none placeholder:text-muted-foreground focus:ring-1 focus:ring-ring"></textarea>
                </div>
            </div>

            <div class="border-t px-4 py-3">
                <div class="flex items-center justify-between">
                    <p class="text-xs text-muted-foreground">Nominations close April 30, 2025</p>
                    <button
                        type="button"
                        @onclick="@(() => _submitted = true)"
                        class="inline-flex items-center gap-1.5 rounded-md bg-foreground px-3 py-1.5 text-xs font-medium text-background transition-opacity hover:opacity-90">
                        <LucideIconCn Name="send" Class="h-3 w-3" />
                        Submit
                    </button>
                </div>
            </div>
        </div>
    </section>
}

@code {
    private static readonly string[] _categories =
    [
        "Product Excellence",
        "Innovation",
        "Customer Success",
        "Design",
        "Engineering",
        "Leadership",
    ];

    private string _category = "";
    private bool _submitted = false;

    private string GetCatClass(string cat) =>
        Cn.Merge(
            "rounded-md px-2.5 py-1 text-xs font-medium transition-colors",
            _category == cat ? "bg-foreground text-background" : "border text-muted-foreground hover:bg-muted/50");
}
