@* ============================================================
   Block: awards-impact-metrics
   Title: AwardsImpactMetrics
   Description: Awards paired with measurable impact metrics and before/after comparisons
   Source: original/blocks/awards/awards-impact-metrics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Impact Metrics</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Measurable outcomes behind each award
            </p>
        </div>

        <div class="divide-y">
            @foreach (var award in _awards)
            {
                <div class="px-4 py-4">
                    <div class="flex items-center gap-2 mb-3">
                        <LucideIconCn Name="trophy" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                        <span class="text-sm font-medium">@award.Title</span>
                        <span class="text-xs text-muted-foreground">&middot;</span>
                        <span class="text-xs text-muted-foreground">@award.Org</span>
                    </div>

                    <div class="space-y-3">
                        @foreach (var metric in award.Metrics)
                        {
                            <div>
                                <div class="flex items-center justify-between text-xs mb-1">
                                    <span class="text-muted-foreground">@metric.Label</span>
                                    <span class="flex items-center gap-1 font-medium">
                                        <LucideIconCn Name="arrow-up" Size="12" Class="h-3 w-3 text-emerald-600" />
                                        @metric.Improvement
                                    </span>
                                </div>
                                <ProgressCn Class="h-1.5" Value="@metric.Progress" aria-label="Progress" />
                                <div class="mt-1 flex justify-between text-[10px] text-muted-foreground">
                                    <span>Before: @metric.Before</span>
                                    <span>After: @metric.After</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Metric(string Label, string Before, string After, string Improvement, int Progress);
    private record ImpactAward(string Title, string Org, string Year, Metric[] Metrics);

    private static readonly ImpactAward[] _awards =
    [
        new("Best Developer Experience", "DevOps Excellence Awards", "2025",
        [
            new("Onboarding time", "4.2 hours", "45 minutes", "-82%", 82),
            new("API adoption rate", "23%", "67%", "+191%", 67),
        ]),
        new("Customer Success Award", "SaaS Industry Awards", "2025",
        [
            new("Customer retention", "84%", "97.3%", "+15.8%", 97),
            new("Support resolution", "18 hours", "2.4 hours", "-87%", 87),
        ]),
        new("Platform Performance Award", "Cloud Excellence", "2024",
        [
            new("Uptime", "99.9%", "99.99%", "+0.09%", 100),
            new("Response time (p95)", "340ms", "89ms", "-74%", 74),
        ]),
    ];
}
