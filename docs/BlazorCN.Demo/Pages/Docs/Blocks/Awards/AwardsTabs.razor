@* ============================================================
   Block: awards-tabs
   Title: AwardsTabs
   Description: Awards section with tabbed categories for different award types
   Source: original/blocks/awards/awards-tabs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Awards by Category</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Recognition across product, design, workplace, and innovation.
            </p>
        </div>

        <div class="p-6">
            <TabsCn DefaultValue="product" Class="w-full">
                <TabsListCn Class="mb-4 grid w-full grid-cols-4">
                    @foreach (var category in _categories)
                    {
                        <TabsTriggerCn Value="@category.Key" Class="gap-1.5 text-xs">
                            <LucideIconCn Name="@category.IconName" Size="14" Class="h-3.5 w-3.5" />
                            <span class="hidden sm:inline">@category.Label</span>
                        </TabsTriggerCn>
                    }
                </TabsListCn>

                @foreach (var category in _categories)
                {
                    <TabsContentCn Value="@category.Key">
                        <div class="divide-y rounded-md border">
                            @foreach (var award in category.Awards)
                            {
                                <div class="flex items-center justify-between px-4 py-3 transition-colors hover:bg-muted/50">
                                    <div class="flex items-center gap-3">
                                        <LucideIconCn Name="@category.IconName" Size="16" Class="h-4 w-4 text-muted-foreground" />
                                        <div>
                                            <p class="text-sm font-medium">@award.Title</p>
                                            <p class="text-xs text-muted-foreground">@award.Org</p>
                                        </div>
                                    </div>
                                    <span class="text-xs text-muted-foreground">@award.Year</span>
                                </div>
                            }
                        </div>
                    </TabsContentCn>
                }
            </TabsCn>
        </div>
    </div>
</section>

@code {
    private record CategoryAward(string Title, string Org, string Year);
    private record AwardCategory(string Key, string IconName, string Label, CategoryAward[] Awards);

    private static readonly AwardCategory[] _categories =
    [
        new("product", "trophy", "Product",
        [
            new("Best SaaS Product", "TechCrunch", "2024"),
            new("Product of the Year", "Product Hunt", "2024"),
            new("Editor's Choice", "PCMag", "2023"),
        ]),
        new("design", "palette", "Design",
        [
            new("Best UX Design", "Awwwards", "2024"),
            new("Design Excellence", "Red Dot", "2023"),
            new("CSS Design Award", "CSSDA", "2023"),
        ]),
        new("workplace", "users", "Workplace",
        [
            new("Best Places to Work", "Glassdoor", "2024"),
            new("Top Startup Employer", "Forbes", "2024"),
        ]),
        new("innovation", "lightbulb", "Innovation",
        [
            new("Innovation Award", "CES", "2024"),
            new("Tech Pioneer", "World Economic Forum", "2023"),
            new("Breakthrough Technology", "MIT Tech Review", "2023"),
        ]),
    ];
}
