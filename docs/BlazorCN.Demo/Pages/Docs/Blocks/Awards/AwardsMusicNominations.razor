@* ============================================================
   Block: awards-music-nominations
   Title: AwardsMusicNominations
   Description: A music industry nominations and wins block for React and Next.js with Grammy-style categories, nominee lists, winner indicators, and category groupings built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-music-nominations.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Music Awards 2025</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Nominations and winners across major categories
            </p>
        </div>

        <div>
            @for (var catIndex = 0; catIndex < _categories.Length; catIndex++)
            {
                var cat = _categories[catIndex];
                var isLast = catIndex == _categories.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-3">
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">
                                @cat.Category
                            </span>
                        </div>
                        <div class="mt-2 space-y-1.5">
                            @foreach (var nominee in cat.Nominees)
                            {
                                <div class="flex items-center gap-2">
                                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", nominee.IsWinner ? "bg-amber-500" : "bg-muted-foreground/20")" />
                                    <span class="@Cn.Merge("text-sm", nominee.IsWinner ? "font-medium" : "")">
                                        @nominee.Name
                                    </span>
                                    @if (!string.IsNullOrEmpty(nominee.Work))
                                    {
                                        <span class="text-xs text-muted-foreground">
                                            — @nominee.Work
                                        </span>
                                    }
                                    @if (nominee.IsWinner)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto bg-amber-500/10 text-[10px] font-medium text-amber-600 dark:text-amber-400">
                                            Winner
                                        </BadgeCn>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="flex items-center gap-2 border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                @_categories.Length categories
            </span>
            <span class="size-1 rounded-full bg-muted-foreground/40" />
            <span class="text-xs text-muted-foreground">
                @_totalWins winners announced
            </span>
        </div>
    </div>
</section>

@code {
    private record Nominee(string Name, string Work, bool IsWinner);
    private record AwardCategory(string Id, string Category, Nominee[] Nominees);

    private static readonly AwardCategory[] _categories =
    [
        new("1", "Record of the Year",
        [
            new("Aria Mitchell", "Daylight Hours", false),
            new("The Commons", "Running Still", true),
            new("Kai Nakamura", "Afterimage", false),
            new("Lena Park", "Golden Gate", false),
        ]),
        new("2", "Best New Artist",
        [
            new("Sable", "", true),
            new("Echo Park", "", false),
            new("J. Meridian", "", false),
            new("Voss", "", false),
        ]),
        new("3", "Album of the Year",
        [
            new("The Commons", "Quiet Machines", false),
            new("Aria Mitchell", "Interior Weather", true),
            new("Kai Nakamura", "Soft Focus", false),
            new("Lena Park", "Maps of Light", false),
        ]),
        new("4", "Song of the Year",
        [
            new("Sable", "Telephone Wire", false),
            new("Echo Park", "Last Train", false),
            new("Aria Mitchell", "Daylight Hours", true),
            new("J. Meridian", "Paper Moon", false),
        ]),
    ];

    private static readonly int _totalWins =
        _categories.Sum(c => c.Nominees.Count(n => n.IsWinner));
}
