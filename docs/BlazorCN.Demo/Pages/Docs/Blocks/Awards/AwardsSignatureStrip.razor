@* ============================================================
   Block: awards-signature-strip
   Title: AwardsSignatureStrip
   Description: Block example: awards
   Source: original/blocks/awards/awards-signature-strip.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="flex flex-wrap items-center justify-center gap-6 rounded-lg border bg-card px-6 py-5">
        @foreach (var award in _awards)
        {
            <div class="flex flex-col items-center gap-1.5 text-center">
                <LucideIconCn Name="@award.Icon" Size="24" Class="size-6 text-muted-foreground" />
                <div>
                    <p class="text-xs font-semibold leading-tight">@award.Title</p>
                    <p class="text-xs text-muted-foreground">@award.Year</p>
                </div>
            </div>
            @if (award != _awards[^1])
            {
                <div class="hidden h-10 w-px bg-border sm:block"></div>
            }
        }
    </div>
</section>

@code {
    private record AwardItem(string Icon, string Title, string Year);

    private static readonly AwardItem[] _awards =
    [
        new("trophy",    "Best Product",        "2024"),
        new("star",      "Top Innovator",       "2024"),
        new("award",     "Design Excellence",   "2023"),
        new("medal",     "Customer Choice",     "2023"),
        new("badge-check","Industry Leader",    "2022"),
    ];
}
