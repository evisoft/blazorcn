@* ============================================================
   Block: awards-win-percentage
   Title: AwardsWinPercentage
   Description: A win percentage awards block for React and Next.js with nomination-to-win conversion rate, flanking stats, and large center metric built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-win-percentage.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Win Rate</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">Nomination to award conversion</p>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                    All time
                </BadgeCn>
            </div>
        </div>

        <div class="border-b px-4 py-6">
            <div class="flex items-center justify-center gap-6">
                <div class="text-center">
                    <span class="text-2xl font-semibold tabular-nums">@_nominations</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">Nominations</p>
                </div>

                <LucideIconCn Name="arrow-right" Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />

                <div class="text-center">
                    <span class="text-3xl font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">
                        @(_winRate)%
                    </span>
                    <p class="mt-0.5 text-xs text-muted-foreground">Win Rate</p>
                </div>

                <LucideIconCn Name="arrow-right" Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />

                <div class="text-center">
                    <span class="text-2xl font-semibold tabular-nums">@_wins</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">Awards Won</p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="h-1.5 flex-1 rounded-full bg-muted/50">
                    <div
                        class="h-1.5 rounded-full bg-emerald-500 transition-all duration-500"
                        style="@($"width:{_winRate}%")"
                    ></div>
                </div>
                <span class="text-xs tabular-nums text-muted-foreground">
                    @_wins/@_nominations
                </span>
            </div>
        </div>

        <div class="flex items-center gap-2 px-4 py-2.5 text-xs text-muted-foreground">
            <span>Across 8 categories</span>
            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
            <span>Since 2018</span>
        </div>
    </div>
</section>

@code {
    private const int _nominations = 47;
    private const int _wins = 38;
    private static readonly int _winRate = (int)Math.Round((_wins / (double)_nominations) * 100);
}
