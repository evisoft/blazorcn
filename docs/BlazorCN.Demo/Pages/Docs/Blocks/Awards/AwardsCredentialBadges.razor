@* ============================================================
   Block: awards-credential-badges
   Title: AwardsCredentialBadges
   Description: Professional credential and certification badge display with verification status
   Source: original/blocks/awards/awards-credential-badges.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-check" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Credentials &amp; Certifications</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">Independently verified compliance</p>
        </div>

        <div class="divide-y">
            @foreach (var cred in _credentials)
            {
                <div class="flex items-start gap-3 px-4 py-3">
                    @if (cred.Status == "active")
                    {
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                    }
                    else
                    {
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-amber-500"></span>
                    }
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center justify-between gap-2">
                            <p class="text-sm font-medium">@cred.Name</p>
                            @if (cred.Status == "active")
                            {
                                <span class="flex items-center gap-1 text-xs text-emerald-600">
                                    <LucideIconCn Name="check-circle-2" Size="12" Class="h-3 w-3" />
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="flex items-center gap-1 text-xs text-amber-600">
                                    <LucideIconCn Name="clock" Size="12" Class="h-3 w-3" />
                                    Renewing
                                </span>
                            }
                        </div>
                        <p class="text-xs text-muted-foreground">@cred.Issuer</p>
                        <p class="mt-1 text-xs text-muted-foreground">@cred.Scope</p>
                        <p class="mt-0.5 text-[10px] text-muted-foreground">
                            Valid through @cred.ValidThrough
                        </p>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                All certifications independently audited and verified
            </p>
        </div>
    </div>
</section>

@code {
    private record Credential(string Name, string Issuer, string Status, string ValidThrough, string Scope);

    private static readonly Credential[] _credentials =
    [
        new("SOC 2 Type II", "AICPA / Deloitte", "active", "Dec 2025", "Security, Availability, Confidentiality"),
        new("ISO 27001:2022", "BSI Group", "active", "Mar 2026", "Information Security Management"),
        new("GDPR Compliant", "EU Data Protection Board", "active", "Ongoing", "Data Processing, Privacy Rights"),
        new("HIPAA Compliant", "HHS / Coalfire", "active", "Sep 2025", "Protected Health Information"),
        new("FedRAMP Authorized", "GSA / PMO", "renewing", "Renewal in progress", "Federal Cloud Security"),
    ];
}
