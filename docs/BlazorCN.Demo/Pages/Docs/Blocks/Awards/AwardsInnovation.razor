@* ============================================================
   Block: awards-innovation
   Title: AwardsInnovation
   Description: Innovation awards showcase highlighting breakthrough technologies and novel solutions
   Source: original/blocks/awards/awards-innovation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="lightbulb" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Innovation Awards</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Recognized for breakthrough technology
            </p>
        </div>

        <div class="divide-y">
            @foreach (var award in _awards)
            {
                <div class="px-4 py-4">
                    <div class="flex items-start gap-3">
                        <LucideIconCn Name="@award.IconName" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium">@award.Title</p>
                            <p class="text-xs text-muted-foreground">
                                @award.Org &middot; @award.Year
                            </p>
                            <div class="mt-2 space-y-1">
                                <div class="flex items-start gap-2">
                                    <span class="shrink-0 text-[10px] font-medium text-muted-foreground w-16">
                                        Innovation
                                    </span>
                                    <span class="text-xs text-muted-foreground">@award.Innovation</span>
                                </div>
                                <div class="flex items-start gap-2">
                                    <span class="shrink-0 text-[10px] font-medium text-muted-foreground w-16">
                                        Impact
                                    </span>
                                    <span class="text-xs text-muted-foreground">@award.Impact</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                4 innovation awards from independent panels in 2024-2025
            </p>
        </div>
    </div>
</section>

@code {
    private record InnovationAward(string Title, string Org, string Year, string Innovation, string Impact, string IconName);

    private static readonly InnovationAward[] _awards =
    [
        new("AI Innovation of the Year", "World AI Summit", "2025",
            "Context-aware code generation engine",
            "Reduced development time by 3x for enterprise customers",
            "brain"),
        new("Breakthrough Technology Award", "CES Innovation Awards", "2025",
            "Zero-latency edge computing architecture",
            "Sub-10ms response times across 40 global regions",
            "zap"),
        new("Most Innovative Product", "TechCrunch Disrupt", "2024",
            "Real-time collaborative development environment",
            "10x improvement in cross-timezone team productivity",
            "rocket"),
        new("Innovation Excellence", "Gartner Cool Vendor", "2024",
            "Predictive infrastructure scaling using ML",
            "89% cost reduction in cloud infrastructure spend",
            "sparkles"),
    ];
}
