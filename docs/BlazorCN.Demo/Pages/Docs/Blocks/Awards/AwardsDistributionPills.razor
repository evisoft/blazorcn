@* ============================================================
   Block: awards-distribution-pills
   Title: AwardsDistributionPills
   Description: A distribution pills awards block for React and Next.js with category pill badges, count indicators, and clickable filtering built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-distribution-pills.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Award Distribution</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Awards by category, sorted by count
                    </p>
                </div>
                <span class="text-xs tabular-nums text-muted-foreground">@_totalAwards total</span>
            </div>
        </div>

        <div class="border-b px-4 py-4">
            <div class="flex flex-wrap gap-2">
                @foreach (var category in _categories)
                {
                    var isSelected = _selected == category.Id;
                    <button type="button"
                            class="focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 rounded-md"
                            @onclick="@(() => HandleToggle(category.Id))">
                        <BadgeCn Variant="@(isSelected ? BadgeVariant.Default : BadgeVariant.Secondary)"
                                 Class="cursor-pointer gap-1.5 text-xs font-normal transition-all hover:opacity-80">
                            @category.Name
                            <span class="tabular-nums opacity-70">@category.Count</span>
                        </BadgeCn>
                    </button>
                }
            </div>
        </div>

        @if (_selected != null)
        {
            var sel = _categories.First(c => c.Id == _selected);
            var pct = (int)Math.Round((double)sel.Count / _totalAwards * 100);
            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium">@sel.Name</span>
                    <span class="text-2xl font-semibold tabular-nums">@sel.Count</span>
                </div>
                <div class="mt-2 h-1.5 rounded-full bg-muted/50">
                    <div class="h-1.5 rounded-full bg-foreground/20 transition-all duration-300"
                         style="@($"width:{pct}%")">
                    </div>
                </div>
                <p class="mt-1.5 text-xs text-muted-foreground">
                    @pct% of all awards
                </p>
            </div>
        }

        <div class="flex items-center gap-2 px-4 py-2.5 text-xs text-muted-foreground">
            <span>@_categories.Length categories</span>
            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
            <span>Click to filter</span>
        </div>
    </div>
</section>

@code {
    private record CategoryData(string Id, string Name, int Count);

    private static readonly CategoryData[] _categories =
    [
        new("1", "Design",             14),
        new("2", "Technology",          9),
        new("3", "Innovation",          7),
        new("4", "Customer Experience", 6),
        new("5", "Sustainability",      5),
        new("6", "Leadership",          4),
        new("7", "Community Impact",    3),
        new("8", "Workplace Culture",   2),
    ];

    // 14+9+7+6+5+4+3+2 = 50
    private static readonly int _totalAwards = 50;

    private string? _selected;

    private void HandleToggle(string id)
    {
        _selected = _selected == id ? null : id;
    }
}
