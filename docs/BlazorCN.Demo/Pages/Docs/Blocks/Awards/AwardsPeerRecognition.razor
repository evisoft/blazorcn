@* ============================================================
   Block: awards-peer-recognition
   Title: AwardsPeerRecognition
   Description: Peer-to-peer recognition wall with kudos, shoutouts, and team appreciation
   Source: original/blocks/awards/awards-peer-recognition.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="heart" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Peer Recognition</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">Kudos from the team</p>
        </div>

        <div class="divide-y">
            @foreach (var kudos in _kudosList)
            {
                <div class="px-4 py-3">
                    <div class="flex items-center gap-2 mb-2">
                        <div class="flex items-center gap-1.5">
                            <LucideIconCn Name="user" Size="12" Class="h-3 w-3 text-muted-foreground" />
                            <span class="text-xs font-medium">@kudos.From</span>
                        </div>
                        <span class="text-xs text-muted-foreground">recognized</span>
                        <span class="text-xs font-medium">@kudos.To</span>
                        <span class="ml-auto text-[10px] text-muted-foreground">@kudos.TimeAgo</span>
                    </div>
                    <p class="text-xs text-muted-foreground leading-relaxed">@kudos.Message</p>
                    <div class="mt-2 flex items-center gap-1.5">
                        <LucideIconCn Name="@kudos.Icon" Size="12" Class="h-3 w-3 text-muted-foreground" />
                        <span class="rounded-md bg-muted/50 px-2 py-0.5 text-[10px] font-medium text-muted-foreground">
                            @kudos.Value
                        </span>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">247 kudos shared this month</p>
        </div>
    </div>
</section>

@code {
    private record Kudos(
        string Id,
        string From,
        string FromRole,
        string To,
        string ToRole,
        string Message,
        string Value,
        string Icon,
        string TimeAgo
    );

    private static readonly Kudos[] _kudosList =
    [
        new("k1", "Sarah Chen",   "VP Engineering",    "Marcus Johnson",    "Senior Engineer", "Incredible work debugging the production incident. Your calm under pressure saved us hours of downtime.",        "Reliability", "zap",   "2 hours ago"),
        new("k2", "David Kim",    "Product Manager",   "Elena Rodriguez",   "UX Designer",     "The new onboarding flow you designed increased activation by 23%. Outstanding user research.",                   "Impact",      "star",  "5 hours ago"),
        new("k3", "Priya Sharma", "Tech Lead",         "James Nakamura",    "Junior Engineer", "Your first open-source contribution was merged upstream. So proud of your growth this quarter.",                "Growth",      "heart", "1 day ago"),
        new("k4", "Lisa Park",    "Customer Success",  "Engineering Team",  "Platform Team",   "Three enterprise customers specifically thanked us for the API improvements this sprint. Great teamwork.",       "Teamwork",    "star",  "2 days ago"),
    ];
}
