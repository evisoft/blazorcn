@* ============================================================
   Block: awards-team-achievement
   Title: AwardsTeamAchievement
   Description: Team achievement awards celebrating collaborative wins, department milestones, and group accomplishments
   Source: original/blocks/awards/awards-team-achievement.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Team Achievements</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Celebrating collaborative excellence across teams
            </p>
        </div>

        <div class="divide-y">
            @foreach (var team in _teams)
            {
                <div class="px-4 py-4">
                    <div class="flex items-start gap-3">
                        <LucideIconCn Name="@team.IconName" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <p class="text-sm font-medium">@team.Team</p>
                                <span class="text-[10px] text-muted-foreground">@team.Size members</span>
                            </div>
                            <p class="text-xs text-muted-foreground">
                                @team.Award &middot; @team.Org &middot; @team.Year
                            </p>
                            <p class="mt-1.5 text-xs text-muted-foreground leading-relaxed">
                                @team.Achievement
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                4 team awards &middot; 60 people recognized across departments
            </p>
        </div>
    </div>
</section>

@code {
    private record TeamAward(string Team, int Size, string Achievement, string Award, string Org, string Year, string IconName);

    private static readonly TeamAward[] _teams =
    [
        new("Platform Engineering", 24, "Built zero-downtime deploy system handling 1M+ deploys/day", "Best Engineering Team", "DevOps Enterprise Summit", "2025", "code"),
        new("Design Systems", 8, "Created component library adopted by 2,000+ teams externally", "Design System of the Year", "Clarity Conference", "2025", "palette"),
        new("Growth Marketing", 12, "Drove 340% organic traffic increase in 12 months", "Marketing Team of the Year", "SaaStr Annual", "2024", "megaphone"),
        new("Infrastructure", 16, "Achieved 99.999% uptime across all production services", "Operational Excellence", "SRE Conference", "2024", "wrench"),
    ];
}
