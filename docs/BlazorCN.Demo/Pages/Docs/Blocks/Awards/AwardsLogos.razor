@* ============================================================
   Block: awards-logos
   Title: AwardsLogos
   Description: Awards section with logo cloud of awarding organizations
   Source: original/blocks/awards/awards-logos.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Recognized By</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Trusted by the world's most respected organizations
            </p>
        </div>

        @* Logo cloud *@
        <div class="grid grid-cols-2 gap-px bg-border sm:grid-cols-4">
            @foreach (var org in _organizations)
            {
                <div class="flex flex-col items-center justify-center bg-card px-6 py-6">
                    <div class="mb-2 flex h-10 w-10 items-center justify-center rounded-full bg-muted/50 font-semibold text-sm text-muted-foreground">
                        @org.Initial
                    </div>
                    <p class="text-sm font-medium">@org.Name</p>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-6 py-3">
            <p class="text-center text-xs text-muted-foreground">
                And 40+ more industry publications and analyst firms
            </p>
        </div>
    </div>
</section>

@code {
    private record Organization(string Name, string Initial);

    private static readonly Organization[] _organizations =
    [
        new("TechCrunch", "TC"),
        new("Forbes", "F"),
        new("Gartner", "G"),
        new("G2 Crowd", "G2"),
    ];
}
