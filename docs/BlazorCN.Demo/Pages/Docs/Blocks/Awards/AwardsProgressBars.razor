@* ============================================================
   Block: awards-progress-bars
   Title: AwardsProgressBars
   Description: A progress bars awards block for React and Next.js with horizontal fill bars, target tracking, and category breakdowns built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-progress-bars.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Award Targets</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Progress toward annual award goals
                    </p>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                    @_completedCategories/@_categories.Length complete
                </BadgeCn>
            </div>
        </div>

        <div>
            @for (var i = 0; i < _categories.Length; i++)
            {
                var category = _categories[i];
                var percentage = Math.Min((int)Math.Round((double)category.Current / category.Target * 100), 100);
                var isLast = i == _categories.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-3">
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-medium">@category.Name</span>
                            <span class="text-xs tabular-nums text-muted-foreground">
                                @category.Current/@category.Target won
                            </span>
                        </div>
                        <div class="mt-2 flex items-center gap-3">
                            <div class="h-1.5 flex-1 rounded-full bg-muted/50">
                                <div class="h-1.5 rounded-full @(ColorBar(category.Color)) transition-all duration-500"
                                     style="width:@(percentage)%">
                                </div>
                            </div>
                            <span class="w-8 text-right text-xs tabular-nums text-muted-foreground">
                                @percentage%
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="flex items-center gap-2 border-t px-4 py-2.5 text-xs text-muted-foreground">
            <span class="tabular-nums">@_totalCurrent awards won</span>
            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
            <span class="tabular-nums">@_totalTarget targeted</span>
        </div>
    </div>
</section>

@code {
    private record AwardCategory(string Id, string Name, int Current, int Target, string Color);

    private static readonly AwardCategory[] _categories =
    [
        new("1", "Innovation Awards", 8, 10, "emerald"),
        new("2", "Design Excellence", 12, 12, "blue"),
        new("3", "Customer Choice", 5, 8, "amber"),
        new("4", "Technology Leadership", 3, 10, "emerald"),
        new("5", "Sustainability Impact", 6, 7, "blue"),
        new("6", "People & Culture", 2, 5, "amber"),
    ];

    private static readonly int _totalCurrent = _categories.Sum(c => c.Current);
    private static readonly int _totalTarget = _categories.Sum(c => c.Target);
    private static readonly int _completedCategories = _categories.Count(c => c.Current >= c.Target);

    private static string ColorBar(string color) => color switch
    {
        "emerald" => "bg-emerald-500",
        "blue"    => "bg-blue-500",
        "amber"   => "bg-amber-500",
        "red"     => "bg-red-500",
        _         => ""
    };
}
