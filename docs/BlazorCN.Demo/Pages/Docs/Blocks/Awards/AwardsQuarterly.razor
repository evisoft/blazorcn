@* ============================================================
   Block: awards-quarterly
   Title: AwardsQuarterly
   Description: Quarterly award highlights showcasing recent achievements organized by business quarter
   Source: original/blocks/awards/awards-quarterly.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calendar" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Quarterly Highlights</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Recent recognition organized by quarter
            </p>
        </div>

        <div class="divide-y">
            @foreach (var q in _quarters)
            {
                <div class="px-4 py-3">
                    <div class="flex items-center gap-2">
                        <span class="font-mono text-xs font-medium">@q.Quarter</span>
                        @if (q.IsCurrent)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] px-1.5 py-0">
                                Current
                            </BadgeCn>
                        }
                        <span class="ml-auto text-[10px] text-muted-foreground">
                            @q.Awards.Length @(q.Awards.Length == 1 ? "award" : "awards")
                        </span>
                    </div>
                    <div class="mt-2 space-y-1.5">
                        @foreach (var award in q.Awards)
                        {
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="trophy" Size="12" Class="h-3 w-3 shrink-0 text-muted-foreground" />
                                <span class="text-xs font-medium">@award.Title</span>
                                <span class="text-[10px] text-muted-foreground">@award.Org</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                9 awards earned across 4 quarters &middot; Consistent recognition
            </p>
        </div>
    </div>
</section>

@code {
    private record Award(string Title, string Org);
    private record QuarterData(string Quarter, bool IsCurrent, Award[] Awards);

    private static readonly QuarterData[] _quarters =
    [
        new("Q1 2025", true,
        [
            new("Best Developer Tool", "DevOps Awards"),
            new("Leader Spring 2025", "G2 Grid Report"),
            new("Innovation Award", "SaaStr Annual"),
        ]),
        new("Q4 2024", false,
        [
            new("Product of the Year", "TechRadar"),
            new("Top 50 SaaS", "SaaS Mag"),
        ]),
        new("Q3 2024", false,
        [
            new("Best UX Design", "Awwwards"),
            new("Fastest Growing", "Deloitte Fast 500"),
        ]),
        new("Q2 2024", false,
        [
            new("Editor's Choice", "WIRED"),
        ]),
    ];
}
