@* ============================================================
   Block: awards-command-search
   Title: AwardsCommandSearch
   Description: A command palette search block for React and Next.js with instant filtering, keyboard navigation styling, and multi-field matching built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-command-search.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Search input *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="search" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
            <input
                type="text"
                value="@_query"
                @oninput="@(e => _query = e.Value?.ToString() ?? "")"
                placeholder="Search awards by name, organization, or category..."
                class="h-8 w-full border-0 bg-transparent px-0 text-sm shadow-none outline-none placeholder:text-muted-foreground" />
            @if (!string.IsNullOrEmpty(_query))
            {
                <span class="shrink-0 text-xs text-muted-foreground tabular-nums">
                    @FilteredAwards.Length result@(FilteredAwards.Length != 1 ? "s" : "")
                </span>
            }
        </div>

        @* Results *@
        <div>
            @{
                var filtered = FilteredAwards;
            }
            @for (int i = 0; i < filtered.Length; i++)
            {
                var award = filtered[i];
                var isLast = i == filtered.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="trophy" Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@award.Name</span>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                @award.Org
                            </p>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-[10px] font-normal">
                            @award.Category
                        </BadgeCn>
                        <span class="shrink-0 text-xs text-muted-foreground tabular-nums">
                            @award.Year
                        </span>
                    </div>
                </div>
            }

            @if (filtered.Length == 0)
            {
                <div class="px-4 py-8 text-center text-sm text-muted-foreground">
                    No awards match your search
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                @_awards.Length awards in directory
            </span>
        </div>
    </div>
</section>

@code {
    private string _query = "";

    private Award[] FilteredAwards
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_query)) return _awards;
            return _awards.Where(a =>
                a.Name.Contains(_query, StringComparison.OrdinalIgnoreCase) ||
                a.Org.Contains(_query, StringComparison.OrdinalIgnoreCase) ||
                a.Category.Contains(_query, StringComparison.OrdinalIgnoreCase)
            ).ToArray();
        }
    }

    private record Award(string Id, string Name, string Org, string Category, string Year);

    private static readonly Award[] _awards =
    [
        new("1", "Product of the Year", "Global Technology Awards", "Enterprise Software", "2025"),
        new("2", "Best User Experience", "UX Design Awards", "SaaS Platform", "2025"),
        new("3", "Innovation Leader", "Forrester Research", "Collaboration Tools", "2024"),
        new("4", "Top Rated Platform", "G2 Crowd", "Project Management", "2024"),
        new("5", "Design Excellence", "Webby Awards", "Web Application", "2024"),
        new("6", "Best Workplace Tech", "HR Tech Awards", "Employee Experience", "2023"),
        new("7", "Sustainability Champion", "Green Business Awards", "Corporate Responsibility", "2023"),
        new("8", "Customer Choice Award", "TrustRadius", "Developer Tools", "2025"),
    ];
}
