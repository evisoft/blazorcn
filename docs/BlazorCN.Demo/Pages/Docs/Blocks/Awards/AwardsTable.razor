@* ============================================================
   Block: awards-table
   Title: AwardsTable
   Description: A data table listing all awards with sortable columns for award name, organization, year, category, and status
   Source: original/blocks/awards/awards-table.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Awards &amp; Recognition</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                A complete record of industry awards, nominations, and honors.
            </p>
        </div>

        <TableCn>
            <TableHeaderCn>
                <TableRowCn>
                    <TableHeadCn Class="px-6">
                        <span class="inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                            <LucideIconCn Name="award" Size="14" Class="size-3.5" />
                            Award
                        </span>
                    </TableHeadCn>
                    <TableHeadCn>
                        <span class="inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                            <LucideIconCn Name="building-2" Size="14" Class="size-3.5" />
                            Organization
                        </span>
                    </TableHeadCn>
                    <TableHeadCn>
                        <span class="inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                            <LucideIconCn Name="calendar" Size="14" Class="size-3.5" />
                            Year
                        </span>
                    </TableHeadCn>
                    <TableHeadCn>
                        <span class="inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                            <LucideIconCn Name="tag" Size="14" Class="size-3.5" />
                            Category
                        </span>
                    </TableHeadCn>
                    <TableHeadCn Class="px-6 text-right">
                        <span class="inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                            <LucideIconCn Name="circle-check" Size="14" Class="size-3.5" />
                            Status
                        </span>
                    </TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var entry in _awards)
                {
                    <TableRowCn>
                        <TableCellCn Class="px-6 text-sm font-medium">@entry.Award</TableCellCn>
                        <TableCellCn Class="text-sm text-muted-foreground">@entry.Organization</TableCellCn>
                        <TableCellCn Class="font-mono text-xs text-muted-foreground tabular-nums">@entry.Year</TableCellCn>
                        <TableCellCn>
                            <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">@entry.Category</BadgeCn>
                        </TableCellCn>
                        <TableCellCn Class="px-6 text-right">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("border-0 text-xs", _statusStyles[entry.Status])">@entry.Status</BadgeCn>
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private record AwardEntry(string Award, string Organization, string Year, string Category, string Status);

    private static readonly Dictionary<string, string> _statusStyles = new()
    {
        ["Won"] = "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        ["Nominated"] = "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        ["Pending"] = "bg-amber-500/10 text-amber-600 dark:text-amber-400",
    };

    private static readonly AwardEntry[] _awards =
    [
        new("Best Developer Tool", "DevOps Awards", "2025", "Developer Experience", "Won"),
        new("Product of the Year", "SaaS Awards", "2025", "Enterprise Software", "Nominated"),
        new("Innovation in Design", "Webby Awards", "2024", "User Interface", "Won"),
        new("Top 50 Startups", "Forbes Cloud 100", "2024", "Cloud Infrastructure", "Won"),
        new("Excellence in AI", "AI Breakthrough Awards", "2025", "Artificial Intelligence", "Pending"),
    ];
}
