@* ============================================================
   Block: awards-trust-bar
   Title: AwardsTrustBar
   Description: Compact horizontal trust bar with recognizing organizations and aggregate rating
   Source: original/blocks/awards/awards-trust-bar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="bg-muted/50 px-6 py-4">
            <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
                    <span class="text-xs font-medium text-muted-foreground">Recognized by</span>
                    @for (var i = 0; i < _organizations.Length; i++)
                    {
                        var org = _organizations[i];
                        var index = i;
                        <span class="flex items-center">
                            @if (index > 0)
                            {
                                <span class="mx-1 text-muted-foreground/40">&middot;</span>
                            }
                            <span class="text-xs font-medium">@org</span>
                        </span>
                    }
                </div>

                <div class="flex shrink-0 items-center gap-1.5">
                    <LucideStarCn class="h-3.5 w-3.5 fill-amber-500 text-amber-500" />
                    <span class="text-sm font-semibold tabular-nums">4.9</span>
                    <span class="text-xs text-muted-foreground">/5 avg rating</span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _organizations = ["TechCrunch", "Forrester", "G2 Crowd", "Gartner"];
}
