@* ============================================================
   Block: awards-asymmetric-mosaic
   Title: AwardsAsymmetricMosaic
   Description: An asymmetric mosaic awards block for React and Next.js with mixed-size card grid, featured large card, and compact award tiles built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-asymmetric-mosaic.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Awards &amp; Recognition</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Industry recognition and achievements</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 sm:grid-rows-2">
            @if (_featuredAward != null)
            {
                <div class="border-b sm:row-span-2 sm:border-b-0 sm:border-r">
                    <div class="flex h-full flex-col justify-center px-5 py-5">
                        <div class="mb-3 flex items-center gap-2">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">Featured</BadgeCn>
                            <span class="text-xs text-muted-foreground">@_featuredAward.Year</span>
                        </div>
                        <h3 class="text-sm font-medium">@_featuredAward.Title</h3>
                        <p class="mt-1 text-xs text-muted-foreground">@_featuredAward.Org</p>
                        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">@_featuredAward.Description</p>
                        <div class="mt-3 flex items-center gap-1.5 text-xs text-muted-foreground">
                            <LucideIconCn Name="award" Size="12" Class="size-3" />
                            <span>@_featuredAward.Category</span>
                        </div>
                    </div>
                </div>
            }
            @foreach (var (award, index) in _smallAwards.Select((a, i) => (a, i)))
            {
                <div class="@(index == _smallAwards.Length - 1 ? "" : "border-b")">
                    <div class="flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <span class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="award" Size="16" Class="size-4 text-muted-foreground" />
                        </span>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@award.Title</span>
                            <p class="mt-0.5 text-xs text-muted-foreground">@award.Org</p>
                        </div>
                        <div class="flex items-center gap-1 text-xs text-muted-foreground">
                            <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                            <span>@award.Year</span>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">@_awards.Length awards earned</span>
        </div>
    </div>
</section>

@code {
    private record Award(string Id, string Title, string Org, string Year, string Category, string Description, bool Featured);

    private static readonly Award[] _awards =
    [
        new("1", "Product of the Year", "Global Technology Awards", "2025", "Enterprise Software", "Recognized for outstanding innovation in enterprise collaboration tools, selected from over 1,200 submissions across 40 countries.", true),
        new("2", "Best User Experience", "UX Design Awards", "2025", "SaaS Platform", "Exceptional interface design and user-centered workflows.", false),
        new("3", "Innovation Leader", "Forrester Research", "2024", "Collaboration Tools", "Named a Leader in the Forrester Wave for collaboration.", false),
        new("4", "Top Rated Platform", "G2 Crowd", "2024", "Project Management", "Earned Top Rated status with 4.8/5 average rating.", false),
        new("5", "Best Workplace Tech", "HR Technology Awards", "2024", "Workplace Solutions", "Recognized for transforming remote work productivity.", false),
    ];

    private static readonly Award? _featuredAward = _awards.FirstOrDefault(a => a.Featured);
    private static readonly Award[] _smallAwards = _awards.Where(a => !a.Featured).ToArray();
}
