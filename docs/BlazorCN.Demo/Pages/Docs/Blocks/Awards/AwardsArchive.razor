@* ============================================================
   Block: awards-archive
   Title: AwardsArchive
   Description: Historical awards archive browser with year filtering and search
   Source: original/blocks/awards/awards-archive.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Awards Archive</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Browse our complete recognition history
            </p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2 rounded-md border bg-transparent px-3 py-1.5">
                <LucideIconCn Name="search" Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                <input
                    type="text"
                    placeholder="Search awards..."
                    value="@_search"
                    @oninput="@(e => _search = e.Value?.ToString() ?? "")"
                    class="w-full border-0 bg-transparent text-sm outline-none placeholder:text-muted-foreground" />
            </div>
        </div>

        <div class="flex gap-1 border-b px-4 py-2">
            @foreach (var year in _years)
            {
                var y = year;
                <button
                    type="button"
                    @onclick="@(() => _selectedYear = y)"
                    class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", (_selectedYear == y ? "bg-foreground text-background" : "text-muted-foreground hover:bg-muted/50"))">
                    @y
                </button>
            }
        </div>

        <div class="divide-y">
            @if (!Filtered.Any())
            {
                <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                    No awards found
                </div>
            }
            @foreach (var award in Filtered)
            {
                <div class="flex items-center gap-3 px-4 py-3">
                    <LucideIconCn Name="trophy" Size="16" Class="h-4 w-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@award.Title</p>
                        <p class="text-xs text-muted-foreground">@award.Org</p>
                    </div>
                    <div class="flex items-center gap-1 text-xs text-muted-foreground">
                        <LucideIconCn Name="calendar" Size="12" Class="h-3 w-3" />
                        <span class="tabular-nums">@award.Year</span>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                Showing @Filtered.Count() of @_archivedAwards.Length awards
            </p>
        </div>
    </div>
</section>

@code {
    private string _selectedYear = "All";
    private string _search = "";

    private IEnumerable<ArchivedAward> Filtered => _archivedAwards.Where(a =>
        (_selectedYear == "All" || a.Year == _selectedYear) &&
        (a.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         a.Org.Contains(_search, StringComparison.OrdinalIgnoreCase)));

    private record ArchivedAward(string Id, string Title, string Org, string Year, string Category);

    private static readonly string[] _years = ["All", "2025", "2024", "2023", "2022"];

    private static readonly ArchivedAward[] _archivedAwards =
    [
        new("a1", "Product of the Year", "Global Tech Awards", "2025", "Product"),
        new("a2", "Best Developer Tool", "DevOps World", "2025", "Engineering"),
        new("a3", "Innovation Award", "TechCrunch", "2024", "Innovation"),
        new("a4", "Top Rated Platform", "G2 Crowd", "2024", "Product"),
        new("a5", "Best UX Design", "Webby Awards", "2024", "Design"),
        new("a6", "Startup of the Year", "Forbes", "2023", "Company"),
        new("a7", "Customer Choice", "TrustRadius", "2023", "Product"),
        new("a8", "Best Workplace", "Glassdoor", "2023", "Company"),
        new("a9", "Rising Star", "Gartner", "2022", "Company"),
        new("a10", "Design Excellence", "Awwwards", "2022", "Design"),
    ];
}
