@* ============================================================
   Block: awards-roi-impact
   Title: AwardsRoiImpact
   Description: A business ROI impact awards block for React and Next.js with measurable metrics, award-to-outcome mapping, large stat numbers, and staggered animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-roi-impact.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <h2 class="text-sm font-medium">Awards ROI</h2>
                <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-muted-foreground" />
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Measurable business impact from industry recognition
            </p>
        </div>

        <div>
            @for (var i = 0; i < _impacts.Length; i++)
            {
                var item = _impacts[i];
                var isLast = i == _impacts.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-4">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@item.Award</span>
                            <LucideIconCn Name="arrow-right" Size="12" Class="size-3 text-muted-foreground/40" aria-hidden="true" />
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">@item.AwardOrg</BadgeCn>
                        </div>
                        <div class="mt-3 flex items-baseline gap-2">
                            <span class="text-2xl font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">
                                @item.Metric
                            </span>
                            <span class="text-xs font-medium text-muted-foreground">
                                @item.MetricLabel
                            </span>
                        </div>
                        <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
                            @item.Description
                        </p>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                @_impacts.Length awards with measurable outcomes
            </span>
        </div>
    </div>
</section>

@code {
    private record Impact(string Id, string Award, string AwardOrg, string Metric, string MetricLabel, string Description);

    private static readonly Impact[] _impacts =
    [
        new("1", "Best User Experience", "UX Design Awards", "+42%", "User retention",
            "Post-award redesign validation led to a 42% increase in 30-day user retention across all cohorts."),
        new("2", "Product of the Year", "Global Technology Awards", "3.2x", "Inbound leads",
            "Award badge placement on landing pages generated 3.2x more qualified inbound leads within 90 days."),
        new("3", "Innovation Leader", "Forrester Research", "+.4M", "Pipeline value",
            "Analyst recognition directly attributed to .4M in new enterprise pipeline from Fortune 500 prospects."),
        new("4", "Top Rated Platform", "G2 Crowd", "+67%", "Conversion rate",
            "Displaying the G2 Top Rated badge on pricing pages increased free-to-paid conversion by 67%."),
    ];
}
