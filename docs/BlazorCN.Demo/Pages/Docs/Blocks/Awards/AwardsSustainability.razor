@* ============================================================
   Block: awards-sustainability
   Title: AwardsSustainability
   Description: Sustainability certification awards showcasing environmental credentials, green certifications, and eco-friendly recognition
   Source: original/blocks/awards/awards-sustainability.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="leaf" Size="16" Class="h-4 w-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Sustainability Certifications</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Verified environmental credentials and green certifications
            </p>
        </div>

        <div class="divide-y">
            @foreach (var cert in _certifications)
            {
                <div class="px-4 py-3">
                    <div class="flex items-start gap-3">
                        <LucideIconCn Name="@cert.IconName" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-emerald-600" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <p class="text-sm font-medium">@cert.Name</p>
                                <span class="rounded bg-muted/50 px-1.5 py-0.5 text-[10px] font-medium text-muted-foreground">
                                    @cert.Level
                                </span>
                            </div>
                            <p class="text-xs text-muted-foreground">
                                @cert.Authority &middot; @cert.Year
                            </p>
                            <p class="mt-1 text-xs text-muted-foreground">@cert.Metric</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                5 environmental certifications &middot; Carbon neutral since 2023
            </p>
        </div>
    </div>
</section>

@code {
    private record SustainabilityCert(string Name, string Authority, string Level, string Year, string Metric, string IconName);

    private static readonly SustainabilityCert[] _certifications =
    [
        new("Carbon Neutral Certified", "Climate Partner", "Gold Standard", "2025",
            "Net-zero emissions across all operations", "leaf"),
        new("Green Cloud Provider", "The Green Web Foundation", "Verified", "2025",
            "100% renewable energy for data centers", "sun"),
        new("Circular Economy Award", "Ellen MacArthur Foundation", "Pioneer", "2024",
            "95% hardware recycling rate achieved", "recycle"),
        new("Water Stewardship", "Alliance for Water Stewardship", "Core", "2024",
            "40% reduction in water usage since 2022", "droplet"),
        new("Clean Energy Commitment", "RE100", "Member", "2024",
            "Committed to 100% renewable electricity by 2026", "wind"),
    ];
}
