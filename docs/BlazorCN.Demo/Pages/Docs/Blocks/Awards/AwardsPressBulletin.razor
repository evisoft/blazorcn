@* ============================================================
   Block: awards-press-bulletin
   Title: AwardsPressBulletin
   Description: A press release bulletin block for React and Next.js with formal release headers, award headlines, body paragraphs, and contact info built with shadcn/ui and Tailwind CSS
   Source: original/blocks/awards/awards-press-bulletin.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="newspaper" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Press Releases</h2>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Official announcements for award wins and nominations
            </p>
        </div>

        @* Press releases *@
        <div>
            @for (var i = 0; i < _releases.Length; i++)
            {
                var release = _releases[i];
                var isLast = i == _releases.Length - 1;
                <div class="@Cn.Merge(isLast ? "" : "border-b")">
                    <div class="px-4 py-4">
                        <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                            For Immediate Release
                        </span>
                        <span class="ml-2 font-mono text-[10px] text-muted-foreground">
                            @release.Date
                        </span>

                        <h3 class="mt-2 text-sm font-medium leading-snug">
                            @release.Headline
                        </h3>

                        <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                            @release.Body
                        </p>

                        <div class="mt-3 flex items-center gap-2 text-[10px] text-muted-foreground">
                            <span>Media Contact:</span>
                            <span class="font-mono">@release.Contact</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                @_releases.Length press releases
            </span>
        </div>
    </div>
</section>

@code {
    private record PressRelease(string Id, string Date, string Headline, string Body, string Contact);

    private static readonly PressRelease[] _releases =
    [
        new("1", "March 15, 2025",
            "Acme Corp Wins Best Developer Tool at 2025 DevOps Awards",
            "Acme Corp, the enterprise developer platform, has been named Best Developer Tool at the 2025 DevOps Awards. The award recognizes the platform’s unified approach to developer tooling, which has attracted over 50,000 active users since its public launch in August 2024.",
            "press@acme.com"),
        new("2", "January 22, 2025",
            "Acme Corp Named Product of the Year Finalist by SaaS Awards",
            "Acme Corp has been selected as a finalist for Product of the Year in the Enterprise Software category at the annual SaaS Awards. The nomination highlights the platform’s rapid adoption among Fortune 500 engineering teams and its 94% retention rate.",
            "press@acme.com"),
        new("3", "November 8, 2024",
            "Acme Corp Receives Webby Award for Innovation in Design",
            "The Webby Awards has honored Acme Corp with the Innovation in Design award in the User Interface category. Judges cited the platform’s clean, typography-driven interface and its approach to reducing cognitive load in complex developer workflows.",
            "press@acme.com"),
    ];
}
