@* ============================================================
   Block: awards-client-wins
   Title: AwardsClientWins
   Description: Client success and customer awards section showcasing partner achievements
   Source: original/blocks/awards/awards-client-wins.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Client Wins</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Awards our customers earned using our platform
            </p>
        </div>

        <div class="divide-y">
            @foreach (var win in _clientWins)
            {
                <div class="px-4 py-4">
                    <div class="flex items-start gap-3">
                        <LucideIconCn Name="trophy" Size="16" Class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center justify-between gap-2">
                                <p class="text-sm font-medium">@win.Award</p>
                                <span class="shrink-0 text-xs tabular-nums text-muted-foreground">
                                    @win.Year
                                </span>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                @win.Client &middot; @win.Industry
                            </p>
                            <p class="mt-0.5 text-xs text-muted-foreground">Awarded by @win.Org</p>
                            <div class="mt-2 rounded-md bg-muted/50 p-2.5">
                                <p class="text-xs text-muted-foreground leading-relaxed">"@win.Quote"</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <button
                type="button"
                class="inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground">
                View all client success stories
                <LucideIconCn Name="external-link" Size="12" Class="h-3 w-3" />
            </button>
        </div>
    </div>
</section>

@code {
    private record ClientWin(string Client, string Industry, string Award, string Org, string Year, string Quote);

    private static readonly ClientWin[] _clientWins =
    [
        new("Meridian Health", "Healthcare", "Digital Transformation Award", "Healthcare Innovation Forum", "2025",
            "Our platform migration reduced patient wait times by 40%."),
        new("Vertex Financial", "Fintech", "Best Customer Experience", "Fintech Breakthrough", "2025",
            "NPS increased from 32 to 71 within six months of launch."),
        new("Atlas Logistics", "Supply Chain", "Operational Excellence", "Supply Chain Awards", "2024",
            "Route optimization saved $2.3M in annual fuel costs."),
        new("Nimbus Education", "EdTech", "Innovation in Learning", "EdTech Digest", "2024",
            "Student engagement improved 3x after implementing our integration."),
    ];
}
