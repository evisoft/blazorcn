@* ============================================================
   Block: awards-bento
   Title: AwardsBento
   Description: Awards bento grid section with varying card sizes for visual hierarchy on React landing pages
   Source: original/blocks/awards/awards-bento.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">A legacy of excellence</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Awards and recognition across the industry
            </p>
        </div>

        <div class="grid gap-px bg-border sm:grid-cols-3">
            @* Featured award spanning 2 rows *@
            <div class="flex flex-col justify-between bg-card p-6 sm:col-span-2 sm:row-span-2">
                <div>
                    <LucideIconCn Name="trophy" Size="16" Class="mb-3 h-4 w-4 text-muted-foreground" />
                    <p class="mb-1 text-xs text-muted-foreground">2024 Winner</p>
                    <h3 class="text-sm font-medium">Product of the Year</h3>
                    <p class="mt-2 text-xs text-muted-foreground leading-relaxed">
                        Recognized as the leading innovation in our category by TechCrunch Disrupt,
                        competing against 500+ submissions worldwide.
                    </p>
                </div>
                <div class="mt-4 flex items-center gap-2">
                    <div class="flex -space-x-1.5">
                        @foreach (var i in new[] { 1, 2, 3 })
                        {
                            <div class="h-5 w-5 rounded-full border border-background bg-muted" key="@i"></div>
                        }
                    </div>
                    <span class="text-xs text-muted-foreground">50+ judges</span>
                </div>
            </div>

            @* Side awards *@
            @foreach (var award in _sideAwards)
            {
                <div class="bg-card p-6">
                    <LucideIconCn Name="@award.IconName" Size="16" Class="mb-2 h-4 w-4 text-muted-foreground" />
                    <p class="mb-1 text-xs text-muted-foreground">@award.Year</p>
                    <p class="text-sm font-medium">@award.Title</p>
                    <p class="mt-1 text-xs text-muted-foreground">@award.Org</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record SideAward(string IconName, string Title, string Org, string Year);

    private static readonly SideAward[] _sideAwards =
    [
        new("star", "Best UX Design", "Awwwards", "2024"),
        new("award", "Innovation Leader", "Gartner", "2024"),
        new("medal", "Customer Choice", "G2 Crowd", "2023"),
    ];
}
