@* ============================================================
   Block: awards-details
   Title: AwardsDetails
   Description: Awards section with detailed cards showing full award information
   Source: original/blocks/awards/awards-details.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Awards &amp; achievements</h2>
            <p class="mt-1 text-sm text-muted-foreground">Detailed recognition highlights</p>
        </div>

        <div class="divide-y">
            @foreach (var award in _awards)
            {
                <div class="flex items-start gap-4 px-6 py-5">
                    <div class="mt-0.5 shrink-0">
                        <LucideIconCn Name="trophy" Size="16" Class="h-4 w-4 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-start justify-between gap-2">
                            <h3 class="text-sm font-medium">@award.Title</h3>
                            <span class="shrink-0 text-xs text-muted-foreground">@award.Year</span>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">@award.Org</p>
                        <p class="mt-2 text-sm text-muted-foreground">@award.Details</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record AwardItem(string Id, string Title, string Org, string Year, string Details);

    private static readonly AwardItem[] _awards =
    [
        new("product-year", "Product of the Year 2024", "Global Technology Awards", "2024",
            "Selected from over 2,000 submissions across 50 countries for innovative workflow automation and exceptional user experience."),
        new("innovation", "Innovation Excellence Award", "Tech Innovators Summit", "2024",
            "Recognized for AI-powered features that reduced customer onboarding time by 60%."),
        new("customer-choice", "Customer Choice Award", "G2 Crowd", "2024",
            "Highest satisfaction score in category with 4.8/5 stars based on verified user reviews."),
    ];
}
