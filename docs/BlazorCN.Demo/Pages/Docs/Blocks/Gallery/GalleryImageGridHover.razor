@* ============================================================
   Block: gallery-image-grid-hover
   Title: GalleryImageGridHover
   Description: A simple image grid gallery where hovering reveals full image details including title, description, and camera settings built with React, Next.js, shadcn/ui, Tailwind CSS, and Framer Motion
   Source: original/blocks/gallery/gallery-image-grid-hover.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Photography Gallery</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Hover to view details</p>
        </div>

        <div class="grid grid-cols-2 gap-2 p-4 sm:grid-cols-3">
            @foreach (var img in _images)
            {
                var image = img;
                <div class="group relative aspect-square overflow-hidden rounded-md bg-muted">
                    <img src="@image.Image"
                         alt="@image.Title"
                         class="absolute inset-0 size-full object-cover" />

                    @* Hover overlay *@
                    <div class="absolute inset-x-0 bottom-0 translate-y-full bg-gradient-to-t from-black/90 via-black/60 to-transparent p-3 pt-8 transition-transform duration-300 ease-out group-hover:translate-y-0">
                        <div class="flex items-start gap-2">
                            <LucideIconCn Name="camera" Size="14" Class="size-3.5 shrink-0 text-white/80" />
                            <div class="min-w-0 flex-1">
                                <h3 class="truncate text-xs font-medium text-white">@image.Title</h3>
                                <p class="mt-0.5 truncate text-xs text-white/70">@image.Description</p>
                                <div class="mt-2 flex flex-wrap gap-1.5 text-xs text-white/60">
                                    <span>@image.Camera.Aperture</span>
                                    <span>•</span>
                                    <span>@image.Camera.Shutter</span>
                                    <span>•</span>
                                    <span>@image.Camera.Iso</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Hover border effect *@
                    <div class="absolute inset-0 border-2 border-white/0 transition-colors duration-200 group-hover:border-white/30 rounded-md"></div>
                </div>
            }
        </div>

        <div class="flex items-center justify-between border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">@_images.Length photos</p>
            <p class="text-xs text-muted-foreground">Captured in 2026</p>
        </div>
    </div>
</section>

@code {
    private record CameraSettings(string Aperture, string Shutter, string Iso);
    private record ImageData(string Id, string Title, string Description, string Image, CameraSettings Camera);

    private static readonly ImageData[] _images =
    [
        new("1", "Golden Hour Landscape", "Mountain vista at sunset",
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop",
            new("f/2.8", "1/500s", "ISO 400")),
        new("2", "Urban Architecture", "Modern building facade",
            "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=800&auto=format&fit=crop",
            new("f/8", "1/125s", "ISO 200")),
        new("3", "Portrait Study", "Natural light portrait",
            "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=800&auto=format&fit=crop",
            new("f/1.8", "1/250s", "ISO 800")),
        new("4", "Street Photography", "City life in motion",
            "https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=800&auto=format&fit=crop",
            new("f/5.6", "1/1000s", "ISO 1600")),
        new("5", "Nature Macro", "Dew drops on leaves",
            "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&auto=format&fit=crop",
            new("f/2.8", "1/60s", "ISO 100")),
        new("6", "Night Sky", "Milky way timelapse",
            "https://images.unsplash.com/photo-1475924156734-496f6cac6ec1?w=800&auto=format&fit=crop",
