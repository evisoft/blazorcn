@* ============================================================
   Block: gallery-case-study
   Title: GalleryCaseStudy
   Description: A case study portfolio gallery with project cards, client metrics, and expandable details built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/gallery/gallery-case-study.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Client Success Stories</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Recent projects and measurable results
            </p>
        </div>

        <div class="divide-y">
            @foreach (var cs in _caseStudies)
            {
                var study = cs;
                var isExpanded = _expandedId == study.Id;
                var chevronStyle = isExpanded ? "transform:rotate(90deg);transition:transform 0.2s" : "transform:rotate(0deg);transition:transform 0.2s";
                var detailStyle = isExpanded ? "display:block" : "display:none";
                <div>
                    <button type="button"
                            class="w-full text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => ToggleExpand(study.Id))">
                        <div class="p-4">
                            <img src="https://images.unsplash.com/photo-1475924156734-496f6cac6ec1?w=800&auto=format&fit=crop&h=450"
                                 alt=""
                                 class="aspect-[16/9] overflow-hidden rounded-md object-cover" />

                            <div class="mt-3 space-y-2">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="min-w-0 flex-1">
                                        <h3 class="text-sm font-medium">@study.Client</h3>
                                        <BadgeCn Variant="BadgeVariant.Outline" Class="mt-1 h-5 text-xs">
                                            @study.Industry
                                        </BadgeCn>
                                    </div>
                                    <div style="@chevronStyle">
                                        <LucideIconCn Name="chevron-right" Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                                    </div>
                                </div>

                                <div class="flex gap-3">
                                    @foreach (var m in study.Metrics)
                                    {
                                        var metric = m;
                                        <div class="flex items-center gap-1.5">
                                            <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-emerald-500" />
                                            <span class="text-sm font-semibold tabular-nums text-emerald-600">@metric.Value</span>
                                            <span class="text-xs text-muted-foreground">@metric.Label</span>
                                        </div>
                                    }
                                </div>

                                <p class="text-xs text-muted-foreground">@study.Description</p>
                            </div>
                        </div>
                    </button>

                    <div class="overflow-hidden" style="@detailStyle">
                        <div class="border-t bg-muted/50 px-4 py-3">
                            <p class="text-xs leading-relaxed text-muted-foreground">@study.Details</p>
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-3 h-7 text-xs">
                                View Full Case Study
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Metric(string Label, string Value);
    private record CaseStudy(string Id, string Client, string Industry, Metric[] Metrics, string Description, string Details);

    private string? _expandedId = null;

    private void ToggleExpand(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private static readonly CaseStudy[] _caseStudies =
    [
        new("1", "TechStart Inc", "SaaS",
            [
                new("Revenue Growth", "+145%"),
                new("User Retention", "+67%"),
            ],
            "Complete platform redesign and growth strategy implementation",
            "Redesigned the entire user onboarding flow, implemented advanced analytics tracking, and developed a comprehensive content marketing strategy that resulted in sustained growth over 12 months."),
        new("2", "RetailHub", "E-commerce",
            [
                new("Conversion Rate", "+89%"),
                new("Cart Value", "+34%"),
            ],
            "Checkout optimization and personalization engine",
            "Built a machine learning-powered recommendation system and streamlined the checkout process, reducing cart abandonment by 45% and increasing average order value significantly."),
        new("3", "HealthTrack", "Healthcare",
            [
                new("App Downloads", "+220%"),
                new("Engagement", "+156%"),
            ],
            "Mobile app development and user acquisition campaign",
            "Developed a cross-platform mobile application with HIPAA compliance, integrated wearable device data, and executed a targeted marketing campaign across multiple channels."),
    ];
}
