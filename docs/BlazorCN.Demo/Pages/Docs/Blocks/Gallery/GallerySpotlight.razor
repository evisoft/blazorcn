@* ============================================================
   Block: gallery-spotlight
   Title: GallerySpotlight
   Description: A dynamic spotlight gallery component for React and Next.js with radial layout and interactive image selection, built with shadcn/ui and Tailwind CSS. Features a prominent hero image surrounded by thumbnail ring.
   Source: original/blocks/gallery/gallery-spotlight.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Spotlight Gallery</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Click any thumbnail to feature it</p>
        </div>

        <div class="relative flex min-h-[600px] items-center justify-center p-8">
            @* Spotlight Image *@
            <div class="relative aspect-[4/3] w-full max-w-md overflow-hidden rounded-lg border shadow-lg transition-opacity duration-300">
                <img
                    src="@_images[_selectedIndex].Image"
                    alt="@_images[_selectedIndex].Alt"
                    class="size-full object-cover" />
                <ButtonCn Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" Class="absolute top-3 right-3 h-8 w-8 p-0">
                    <LucideIconCn Name="zoom-in" Size="16" Class="size-4" />
                </ButtonCn>
            </div>

            @* Radial Thumbnail Ring *@
            <div class="absolute inset-0 pointer-events-none">
                @foreach (var img in _images)
                {
                    var idx = Array.IndexOf(_images, img);
                    var angle = (idx / (double)_images.Length) * 2 * Math.PI - Math.PI / 2;
                    const double radius = 220;
                    var x = Math.Cos(angle) * radius;
                    var y = Math.Sin(angle) * radius;
                    var transformStyle = $"transform: translate(calc(-50% + {x:F2}px), calc(-50% + {y:F2}px));";
                    var isSelected = _selectedIndex == idx;
                    var capturedIdx = idx;
                    <button
                        type="button"
                        @onclick="@(() => _selectedIndex = capturedIdx)"
                        class="@Cn.Merge("pointer-events-auto absolute left-1/2 top-1/2 size-16 -translate-x-1/2 -translate-y-1/2 overflow-hidden rounded-lg border-2 transition-all hover:scale-110", isSelected ? "border-primary shadow-md" : "border-border opacity-60 hover:opacity-100")"
                        style="@transformStyle">
                        <img src="@img.Image" alt="@img.Alt" class="size-full object-cover" />
                    </button>
                }
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">
                    Image @(_selectedIndex + 1) of @(_images.Length)
                </span>
                <span class="text-muted-foreground">@_images[_selectedIndex].Alt</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record GalleryImage(string Id, string Alt, string Image);

    private int _selectedIndex = 0;

    private static readonly GalleryImage[] _images =
    [
        new("1", "Mountain landscape",
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop"),
        new("2", "Desert sunset",
            "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&auto=format&fit=crop"),
        new("3", "Forest trail",
            "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800&auto=format&fit=crop"),
