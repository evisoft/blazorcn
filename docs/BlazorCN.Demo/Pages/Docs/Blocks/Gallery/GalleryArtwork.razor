@* ============================================================
   Block: gallery-artwork
   Title: GalleryArtwork
   Description: A museum-style art gallery with paintings on simulated walls, title plaques, and elegant spacing built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/gallery/gallery-artwork.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Contemporary Exhibition</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Spring Collection 2026</p>
        </div>

        <div class="bg-gradient-to-b from-zinc-50 to-zinc-100 p-6 dark:from-zinc-900 dark:to-zinc-800">
            <div class="space-y-8">
                @foreach (var artwork in _artworks)
                {
                    var aw = artwork;
                    <button type="button"
                            class="w-full text-left transition-transform hover:scale-[1.02]"
                            @onclick="@(() => ToggleSelected(aw.Id))">
                        <div class="mx-auto max-w-md space-y-3">
                            <div class="@Cn.Merge("relative overflow-hidden rounded-sm shadow-lg transition-shadow duration-300", _selectedId == aw.Id ? "shadow-2xl" : "shadow-md hover:shadow-xl")">
                                <img src="@aw.Image"
                                     alt="@aw.Title"
                                     class="aspect-[4/3] w-full object-cover" />
                                @if (_selectedId == aw.Id)
                                {
                                    <div class="absolute inset-0 border-2 border-primary"></div>
                                }
                            </div>

                            <div class="bg-white px-4 py-2 shadow-sm dark:bg-zinc-950">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="min-w-0 flex-1">
                                        <h3 class="text-sm font-medium">@aw.Title</h3>
                                        <p class="mt-0.5 text-xs text-muted-foreground">
                                            @aw.Artist, @aw.Year
                                        </p>
                                    </div>
                                    <div class="shrink-0 text-right">
                                        <span class="text-xs text-muted-foreground">@aw.Dimensions</span>
                                    </div>
                                </div>

                                @if (_selectedId == aw.Id)
                                {
                                    <div class="overflow-hidden">
                                        <div class="mt-2 border-t pt-2">
                                            <div class="flex items-center justify-between">
                                                <span class="text-xs text-muted-foreground">Medium:</span>
                                                <span class="text-xs font-medium">@aw.Medium</span>
                                            </div>
                                            <div class="mt-1 flex items-center justify-between">
                                                <span class="text-xs text-muted-foreground">Year:</span>
                                                <span class="text-xs font-medium">@aw.Year</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </button>
                }
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                Click on any artwork to view details
            </p>
        </div>
    </div>
</section>

@code {
    private record Artwork(string Id, string Title, string Artist, string Year, string Medium, string Dimensions, string Image);

    private string? _selectedId = null;

    private void ToggleSelected(string id)
    {
        _selectedId = _selectedId == id ? null : id;
    }

    private static readonly Artwork[] _artworks =
    [
        new("1", "Urban Reflections", "Elena Martinez", "2024", "Oil on canvas", "48 × 36 in",
            "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=800&h=600&auto=format&fit=crop"),
        new("2", "Mountain Solitude", "James Chen", "2023", "Acrylic on canvas", "60 × 40 in",
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&h=600&auto=format&fit=crop"),
        new("3", "Abstract Geometry", "Sarah Kim", "2025", "Mixed media", "40 × 40 in",
            "https://images.unsplash.com/photo-1550859492-d5da9d8e45f3?w=800&h=600&auto=format&fit=crop"),
        new("4", "Coastal Serenity", "Michael Brown", "2024", "Watercolor", "30 × 24 in",
            "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&h=600&auto=format&fit=crop"),
        new("5", "Night in the City", "Anna Kowalski", "2023", "Digital art print", "36 × 24 in",
            "https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=800&h=600&auto=format&fit=crop"),
        new("6", "Botanical Dreams", "David Lee", "2025", "Oil on canvas", "44 × 32 in",
            "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800&h=600&auto=format&fit=crop"),
    ];
}
