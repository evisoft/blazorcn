@* ============================================================
   Block: gallery-lookbook
   Title: GalleryLookbook
   Description: An elegant fashion lookbook gallery component with full-bleed images and minimal overlays built with React, Next.js, shadcn/ui, and Tailwind CSS. Perfect for e-commerce and editorial content.
   Source: original/blocks/gallery/gallery-lookbook.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-4">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="font-semibold text-lg">Spring 2026 Lookbook</h2>
                    <p class="mt-1 text-muted-foreground text-sm">
                        Discover the season's defining pieces
                    </p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-2">
                    <LucideIconCn Name="shopping-bag" Size="16" Class="size-4" />
                    View Collection
                </ButtonCn>
            </div>
        </div>

        <div class="grid gap-px bg-muted md:grid-cols-2 lg:grid-cols-3">
            @foreach (var it in _lookbookItems)
            {
                var item = it;
                <div class="group relative aspect-[3/4] overflow-hidden bg-card">
                    @* Image *@
                    <img src="@item.Image"
                         alt="@item.Title"
                         class="absolute inset-0 h-full w-full object-cover" />

                    @* Gradient Overlay *@
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

                    @* Content Overlay *@
                    <div class="absolute inset-x-0 bottom-0 translate-y-2 space-y-3 p-6 transition-transform duration-300 group-hover:translate-y-0">
                        <div class="space-y-1">
                            <p class="font-mono text-white/60 text-xs uppercase tracking-wider">
                                @item.Category
                            </p>
                            <h3 class="font-medium text-lg text-white leading-tight">@item.Title</h3>
                            <p class="font-semibold text-white text-xl">@item.Price</p>
                        </div>

                        <div class="flex gap-2 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                            <ButtonCn Size="ButtonSize.Sm" Class="flex-1 bg-white text-black hover:bg-white/90">
                                Shop the Look
                            </ButtonCn>
                            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Secondary" Class="bg-white/20 text-white backdrop-blur-sm hover:bg-white/30" aria-label="@($"Add {item.Title} to favorites")">
                                <LucideIconCn Name="heart" Size="16" Class="size-4" />
                            </ButtonCn>
                        </div>
                    </div>

                    @* Season Badge *@
                    <div class="absolute top-4 right-4 rounded-full bg-white/90 px-3 py-1 font-mono text-xs backdrop-blur-sm">
                        @item.Season
                    </div>
                </div>
            }
        </div>

        <div class="border-t bg-muted/30 px-6 py-4">
            <p class="text-center text-muted-foreground text-sm">
                Explore the complete collection with over 120 curated pieces
            </p>
        </div>
    </div>
</section>

@code {
    private record LookbookItem(string Id, string Title, string Price, string Category, string Season, string Image);

    private static readonly LookbookItem[] _lookbookItems =
    [
        new("1", "Midnight Noir Ensemble", "$495", "Evening Wear", "Spring 2026",
