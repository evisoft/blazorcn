@* ============================================================
   Block: gallery-press-coverage
   Title: GalleryPressCoverage
   Description: A press and media coverage gallery built with React, Next.js, shadcn/ui, and Tailwind CSS. Displays publication logos with article titles, dates, and read links in a clean grid layout for showcasing media mentions.
   Source: original/blocks/gallery/gallery-press-coverage.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Press Coverage</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Featured in leading publications</p>
        </div>

        <div class="divide-y">
            @foreach (var pa in _pressArticles)
            {
                var article = pa;
                <div class="group flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                    <div class="size-10 shrink-0 overflow-hidden rounded-md bg-muted">
                        <img src="@article.Image"
                             alt="@article.Publication"
                             class="h-full w-full object-cover" />
                    </div>

                    <div class="min-w-0 flex-1">
                        <div class="flex items-start justify-between gap-2">
                            <div class="min-w-0 flex-1">
                                <h3 class="font-medium text-sm leading-tight">@article.Title</h3>
                                <div class="mt-1 flex flex-wrap items-center gap-2">
                                    <span class="font-medium text-muted-foreground text-xs">@article.Publication</span>
                                    <span class="size-1 rounded-full bg-border"></span>
                                    <span class="text-muted-foreground text-xs">@article.Date</span>
                                </div>
                                <span class="mt-1 inline-flex items-center rounded-full bg-muted px-2 py-0.5 text-[10px] text-muted-foreground">
                                    @article.Category
                                </span>
                            </div>

                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs opacity-0 transition-opacity group-hover:opacity-100">
                                Read
                                <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3" />
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-center text-muted-foreground text-xs">
                As featured in major tech and business publications
            </p>
        </div>
    </div>
</section>

@code {
    private record PressArticle(string Id, string Publication, string Title, string Date, string Category, string Image);

    private static readonly PressArticle[] _pressArticles =
    [
        new("1", "TechCrunch", "This startup is revolutionizing the industry with AI", "Mar 15, 2026", "Technology",
            "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=800&auto=format&fit=crop"),
        new("2", "Forbes", "The future of work: How innovation is changing everything", "Mar 10, 2026", "Business",
            "https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=800&auto=format&fit=crop"),
        new("3", "The Verge", "A deep dive into the platform everyone is talking about", "Mar 5, 2026", "Product Review",
            "https://images.unsplash.com/photo-1518173946687-a544bf02a536?w=800&auto=format&fit=crop"),
        new("4", "Wired", "Why leading companies are making the switch", "Feb 28, 2026", "Industry",
            "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&auto=format&fit=crop"),
        new("5", "Fast Company", "Innovation award winner redefines user experience", "Feb 20, 2026", "Design",
            "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=800&auto=format&fit=crop"),
        new("6", "VentureBeat", "Securing series B funding to accelerate growth", "Feb 15, 2026", "Funding",
