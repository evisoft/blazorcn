@* ============================================================
   Block: gallery-app-screens
   Title: GalleryAppScreens
   Description: A mobile app screenshots gallery built with React, Next.js, shadcn/ui, and Tailwind CSS. Displays screenshots in phone frame mockups with horizontal scrolling and feature descriptions in an app store style layout.
   Source: original/blocks/gallery/gallery-app-screens.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">App Preview</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Experience the interface on mobile</p>
        </div>

        <div class="p-4">
            <div class="flex flex-wrap justify-center gap-4">
                @foreach (var screen in _appScreens)
                {
                    <div class="group flex flex-col items-center">
                        <div class="relative rounded-[2rem] border-4 border-muted bg-card p-2 shadow-lg transition-transform group-hover:scale-105">
                            <div class="absolute left-1/2 top-2 z-10 h-1 w-12 -translate-x-1/2 rounded-full bg-muted"></div>
                            <div class="h-[280px] w-[140px] overflow-hidden rounded-[1.5rem]">
                                <img
                                    src="@screen.Image"
                                    alt="@screen.Title"
                                    class="h-full w-full object-cover" />
                            </div>
                        </div>

                        <div class="mt-3 w-[140px] text-center">
                            <h3 class="font-medium text-sm">@screen.Title</h3>
                            <p class="mt-1 text-muted-foreground text-xs leading-tight">
                                @screen.Description
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-center text-muted-foreground text-xs">Available on iOS and Android</p>
        </div>
    </div>
</section>

@code {
    private record AppScreen(string Id, string Title, string Description, string Image);

    private static readonly AppScreen[] _appScreens =
    [
        new("1", "Dashboard", "Get a complete overview of your metrics and activity",
            "https://images.unsplash.com/photo-1518770660439-4636190af475?w=400&h=800&auto=format&fit=crop"),
        new("2", "Analytics", "Track performance with detailed charts and insights",
            "https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=400&h=800&auto=format&fit=crop"),
        new("3", "Messages", "Stay connected with real-time messaging and notifications",
            "https://images.unsplash.com/photo-1531297484001-80022131f5a1?w=400&h=800&auto=format&fit=crop"),
        new("4", "Profile", "Manage your account settings and preferences",
            "https://images.unsplash.com/photo-1488590528505-98d2b5aba04b?w=400&h=800&auto=format&fit=crop"),
        new("5", "Settings", "Customize your experience with advanced options",
            "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=400&h=800&auto=format&fit=crop"),
    ];
}
