@* ============================================================
   Block: gallery-magazine
   Title: GalleryMagazine
   Description: An editorial magazine-style gallery with mixed layouts for React, Next.js, shadcn/ui, and Tailwind CSS applications. Features large hero images, text excerpts, and pull quotes.
   Source: original/blocks/gallery/gallery-magazine.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Editorial Gallery</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Magazine-style layout</p>
        </div>

        <div class="divide-y">
            @foreach (var art in _articles)
            {
                var article = art;
                <div class="@Cn.Merge(article.Type == "hero" ? "p-4" : "", article.Type == "standard" ? "p-4" : "", article.Type == "quote" ? "px-4 py-6" : "", article.Type == "grid" ? "p-4" : "")">
                    @if (article.Type == "hero")
                    {
                        <div class="space-y-3">
                            <img src="https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&auto=format&fit=crop&h=450"
                                 alt=""
                                 class="aspect-[16/9] w-full rounded-md object-cover" />
                            <div class="space-y-2">
                                <div class="flex items-center gap-2">
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@article.Category</BadgeCn>
                                    <span class="text-muted-foreground text-xs">@article.ReadTime</span>
                                </div>
                                <h3 class="font-semibold text-base leading-tight">@article.Title</h3>
                                <p class="text-muted-foreground text-sm leading-relaxed">@article.Excerpt</p>
                            </div>
                        </div>
                    }

                    @if (article.Type == "standard")
                    {
                        <div class="grid grid-cols-[120px,1fr] gap-3">
                            <img src="https://images.unsplash.com/photo-1518173946687-a544bf02a536?w=600&auto=format&fit=crop&h=600"
                                 alt=""
                                 class="aspect-square w-full rounded-md object-cover" />
                            <div class="space-y-1">
                                <div class="flex items-center gap-2">
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@article.Category</BadgeCn>
                                    <span class="text-muted-foreground text-xs">@article.ReadTime</span>
                                </div>
                                <h3 class="font-medium text-sm leading-tight">@article.Title</h3>
                                <p class="line-clamp-2 text-muted-foreground text-xs leading-relaxed">@article.Excerpt</p>
                            </div>
                        </div>
                    }

                    @if (article.Type == "quote")
                    {
                        <div class="space-y-2 border-l-2 border-primary pl-4">
                            <p class="font-medium text-sm italic leading-relaxed">@article.Quote</p>
                            <p class="text-muted-foreground text-xs">— @article.Author</p>
                        </div>
                    }

                    @if (article.Type == "grid")
                    {
                        <div class="grid grid-cols-3 gap-2">
                            <img src="https://images.unsplash.com/photo-1475924156734-496f6cac6ec1?w=600&auto=format&fit=crop&h=600"
                                 alt=""
                                 class="aspect-square w-full rounded-md object-cover" />
                            <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=600&auto=format&fit=crop&h=600"
                                 alt=""
                                 class="aspect-square w-full rounded-md object-cover" />
                            <img src="https://images.unsplash.com/photo-1472214103451-9374bd1c798e?w=600&auto=format&fit=crop&h=600"
                                 alt=""
                                 class="aspect-square w-full rounded-md object-cover" />
                        </div>
                    }
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-center text-muted-foreground text-xs">Editorial collection</p>
        </div>
    </div>
</section>

@code {
    private record Article(
        string Id,
        string Type,
        string? Title = null,
        string? Excerpt = null,
        string? Quote = null,
        string? Author = null,
        string? Category = null,
        string? ReadTime = null
    );

    private static readonly Article[] _articles =
    [
        new("1", "hero",
            Title: "The Art of Modern Photography",
            Excerpt: "Exploring the intersection of technology and creativity in contemporary visual storytelling.",
            Category: "Photography",
            ReadTime: "8 min read"),
        new("2", "quote",
            Quote: "Photography is the story I fail to put into words. Every frame tells a thousand stories.",
            Author: "Anonymous Artist"),
        new("3", "standard",
            Title: "Urban Landscapes",
            Excerpt: "Capturing the raw energy and architectural beauty of cityscapes at golden hour.",
            Category: "Architecture",
            ReadTime: "5 min read"),
        new("4", "standard",
            Title: "Minimalist Composition",
            Excerpt: "Less is more: the power of negative space in creating impactful visual narratives.",
            Category: "Design",
            ReadTime: "6 min read"),
        new("5", "grid"),
        new("6", "standard",
            Title: "Natural Light Mastery",
            Excerpt: "Working with available light to create mood and atmosphere in portrait photography.",
            Category: "Technique",
            ReadTime: "7 min read"),
    ];
}
