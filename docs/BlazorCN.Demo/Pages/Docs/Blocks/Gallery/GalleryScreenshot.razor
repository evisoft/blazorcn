@* ============================================================
   Block: gallery-screenshot
   Title: GalleryScreenshot
   Description: A production-ready app screenshot gallery component for SaaS landing pages built with React, Next.js, shadcn/ui, and Tailwind CSS. Features browser chrome mockups with feature labels.
   Source: original/blocks/gallery/gallery-screenshot.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-4">
            <h2 class="font-semibold text-lg">Product Screenshots</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Explore key features and capabilities
            </p>
        </div>

        <div class="grid gap-6 p-6 md:grid-cols-2">
            @foreach (var shot in _screenshots)
            {
                <div class="group relative">
                    <div class="overflow-hidden rounded-lg border bg-background shadow-sm">
                        @* Browser Chrome *@
                        <div class="flex items-center gap-1.5 border-b bg-muted/50 px-3 py-2">
                            <div class="size-2.5 rounded-full bg-red-500/80"></div>
                            <div class="size-2.5 rounded-full bg-yellow-500/80"></div>
                            <div class="size-2.5 rounded-full bg-green-500/80"></div>
                            <div class="mx-2 flex-1 rounded bg-background px-2 py-1">
                                <div class="h-2 w-32 rounded bg-muted"></div>
                            </div>
                        </div>

                        @* Screenshot *@
                        <div class="relative aspect-[16/10] bg-muted">
                            <img
                                src="@shot.Image"
                                alt="@shot.ImageAlt"
                                class="size-full object-cover" />

                            @* Hover Overlay *@
                            <div class="absolute inset-0 flex items-center justify-center bg-black/60 opacity-0 transition-opacity duration-200 group-hover:opacity-100">
                                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Secondary" Class="gap-2">
                                    <LucideIconCn Name="maximize-2" Size="16" Class="size-4" />
                                    View Full Size
                                </ButtonCn>
                            </div>
                        </div>
                    </div>

                    @* Feature Info *@
                    <div class="mt-3 space-y-1">
                        <div class="flex items-start justify-between gap-2">
                            <h3 class="font-medium text-sm">@shot.Title</h3>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-xs">
                                @shot.Category
                            </BadgeCn>
                        </div>
                        <p class="text-muted-foreground text-xs">@shot.Description</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Screenshot(string Id, string Title, string Description, string Category, string ImageAlt, string Image);

    private static readonly Screenshot[] _screenshots =
    [
        new("1", "Dashboard Overview", "Real-time analytics and performance metrics", "Analytics",
            "Dashboard with charts and metrics",
            "https://images.unsplash.com/photo-1518770660439-4636190af475?w=800&auto=format&fit=crop"),
        new("2", "Team Collaboration", "Manage team members and permissions", "Teams",
            "Team management interface",
            "https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=800&auto=format&fit=crop"),
        new("3", "Project Management", "Track progress and manage workflows", "Projects",
            "Project kanban board",
            "https://images.unsplash.com/photo-1531297484001-80022131f5a1?w=800&auto=format&fit=crop"),
        new("4", "Reporting Tools", "Generate custom reports and insights", "Reports",
            "Report generation interface",
            "https://images.unsplash.com/photo-1488590528505-98d2b5aba04b?w=800&auto=format&fit=crop"),
        new("5", "API Integration", "Connect with your favorite tools", "Integration",
            "API integration settings",
