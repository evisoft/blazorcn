@* ============================================================
   Block: gallery-testimonial-photos
   Title: GalleryTestimonialPhotos
   Description: A testimonial gallery component combining customer photos with quotes built with React, Next.js, shadcn/ui, and Tailwind CSS. Features alternating layouts for visual interest.
   Source: original/blocks/gallery/gallery-testimonial-photos.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-6 py-4">
            <h2 class="font-semibold text-lg">Customer Stories</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Hear from teams who transformed their workflow
            </p>
        </div>

        <div class="divide-y">
            @foreach (var t in _testimonials)
            {
                var testimonial = t;
                var index = System.Array.IndexOf(_testimonials, testimonial);
                var isEven = index % 2 == 0;
                <div class="p-6">
                    <div class="@Cn.Merge("flex flex-col gap-6 md:flex-row md:items-center", isEven ? "" : "md:flex-row-reverse")">

                        @* Photo Side *@
                        <div class="flex shrink-0 flex-col items-center gap-3 md:w-48">
                            <div class="size-24 overflow-hidden rounded-full border-2">
                                <img src="@testimonial.Image" alt="@testimonial.Name" class="h-full w-full object-cover" />
                            </div>
                            <div class="text-center">
                                <p class="font-medium text-sm">@testimonial.Name</p>
                                <p class="text-muted-foreground text-xs">@testimonial.Role</p>
                                <p class="text-muted-foreground text-xs">@testimonial.Company</p>
                            </div>
                        </div>

                        @* Quote Side *@
                        <div class="flex-1 space-y-3">
                            <div class="flex items-center gap-0.5">
                                @for (var i = 0; i < testimonial.Rating; i++)
                                {
                                    <LucideIconCn Name="star" Size="16" Class="size-4 fill-yellow-500 text-yellow-500" />
                                }
                            </div>

                            <div class="relative">
                                <LucideIconCn Name="quote" Size="24" Class="absolute -top-1 -left-1 size-6 text-muted-foreground/20" />
                                <p class="pl-6 text-foreground/90 text-sm leading-relaxed">
                                    @testimonial.Quote
                                </p>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>

        <div class="border-t bg-muted/30 px-6 py-4">
            <div class="flex items-center justify-between">
                <p class="text-muted-foreground text-xs">Join 10,000+ happy customers</p>
                <div class="flex items-center gap-1">
                    @for (var i = 0; i < 5; i++)
                    {
                        <LucideIconCn Name="star" Size="16" Class="size-4 fill-yellow-500 text-yellow-500" />
                    }
                    <span class="ml-1 font-medium text-sm">5.0 average</span>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private record Testimonial(
        string Id,
        string Name,
        string Role,
        string Company,
        string Quote,
        int Rating,
        string Initials,
        string Image
    );

    private static readonly Testimonial[] _testimonials =
    [
        new("1", "Sarah Chen",     "Product Manager",  "TechFlow Inc",
            "This platform transformed how our team collaborates. We've seen a 3x increase in productivity and our project delivery time has been cut in half.",
            5, "SC",
            "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=400&h=400&auto=format&fit=crop"),

        new("2", "Michael Torres", "Engineering Lead", "CloudSync",
            "The best development tool we've adopted this year. The integration with our existing workflow was seamless and the performance is outstanding.",
            5, "MT",
            "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&h=400&auto=format&fit=crop"),

        new("3", "Emily Watson",   "Design Director",  "Studio Pixel",
            "Beautiful interface, powerful features. Our design team loves the attention to detail and how intuitive everything is to use.",
            5, "EW",
            "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=400&h=400&auto=format&fit=crop"),

        new("4", "David Park",     "CTO",              "StartupLab",
            "We evaluated dozens of solutions and this was the clear winner. The ROI has been incredible and our team adoption rate was nearly 100% within the first week.",
            5, "DP",
            "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=400&h=400&auto=format&fit=crop"),
    ];
}
