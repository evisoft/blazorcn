@* ============================================================
   Block: gallery-user-generated
   Title: GalleryUserGenerated
   Description: A user-generated content gallery with moderation actions, user avatars, and featured badges built with React, Next.js, shadcn/ui, and Tailwind CSS. Perfect for community platforms with content management.
   Source: original/blocks/gallery/gallery-user-generated.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="font-medium text-sm">Community Gallery</h2>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        User-submitted content for review
                    </p>
                </div>
                <div class="flex items-center gap-2">
                    @if (_pendingCount > 0)
                    {
                        <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 text-[10px]">
                            <span class="size-1.5 rounded-full bg-amber-500"></span>
                            <span>@_pendingCount pending</span>
                        </BadgeCn>
                    }
                    <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 text-[10px]">
                        <LucideIconCn Name="star" Size="12" Class="size-3 fill-current" />
                        <span>@_featuredCount featured</span>
                    </BadgeCn>
                </div>
            </div>
        </div>

        <div class="grid gap-4 p-4 sm:grid-cols-2 md:grid-cols-3">
            @foreach (var content in _userContent)
            {
                var item = content;
                <div class="group relative overflow-hidden rounded-lg border bg-card transition-colors hover:bg-muted/50">
                    @* Image placeholder *@
                    <img src="https://images.unsplash.com/photo-1531746020798-e6953c6e8e04?w=600&auto=format&fit=crop&h=600"
                         alt=""
                         class="aspect-square object-cover" />

                    @* Featured badge *@
                    @if (item.IsFeatured)
                    {
                        <div class="absolute top-2 left-2">
                            <div class="flex items-center gap-1 rounded-full bg-amber-500/90 px-2 py-0.5 backdrop-blur-sm">
                                <LucideIconCn Name="star" Size="12" Class="size-3 fill-white text-white" />
                                <span class="font-medium text-white text-[10px]">Featured</span>
                            </div>
                        </div>
                    }

                    @* Pending badge *@
                    @if (item.IsPending)
                    {
                        <div class="absolute top-2 right-2">
                            <BadgeCn Variant="BadgeVariant.Outline" Class="border-amber-500/50 bg-amber-500/10 text-amber-700 text-[10px]">
                                Pending Review
                            </BadgeCn>
                        </div>
                    }

                    @* User info *@
                    <div class="border-t p-3">
                        <div class="mb-2 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <AvatarCn Class="size-6">
                                    <AvatarFallbackCn Class="text-[10px]">@item.UserInitials</AvatarFallbackCn>
                                </AvatarCn>
                                <div class="min-w-0 flex-1">
                                    <div class="truncate font-medium text-xs">@item.Username</div>
                                    <div class="text-muted-foreground text-[10px]">
                                        @item.SubmittedDate
                                    </div>
                                </div>
                            </div>
                            <DropdownMenuCn>
                                <DropdownMenuTriggerCn>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 p-0 opacity-0 transition-opacity group-hover:opacity-100">
                                        <LucideIconCn Name="more-vertical" Size="12" Class="size-3" />
                                    </ButtonCn>
                                </DropdownMenuTriggerCn>
                                <DropdownMenuContentCn Align="FloatingAlign.End" Class="w-48">
                                    @if (item.IsPending)
                                    {
                                        <DropdownMenuItemCn Class="text-xs">
                                            <LucideIconCn Name="check" Size="12" Class="mr-2 size-3" />
                                            Approve
                                        </DropdownMenuItemCn>
                                        <DropdownMenuSeparatorCn />
                                    }
                                    <DropdownMenuItemCn Class="text-xs">
                                        <LucideIconCn Name="star" Size="12" Class="mr-2 size-3" />
                                        @(item.IsFeatured ? "Remove from featured" : "Mark as featured")
                                    </DropdownMenuItemCn>
                                    <DropdownMenuItemCn Class="text-xs">
                                        <LucideIconCn Name="flag" Size="12" Class="mr-2 size-3" />
                                        Flag content
                                    </DropdownMenuItemCn>
                                </DropdownMenuContentCn>
                            </DropdownMenuCn>
                        </div>

                        @* Stats *@
                        <div class="flex items-center gap-3 text-muted-foreground text-xs">
                            <span>@item.Likes likes</span>
                            <span>•</span>
                            <span>@item.Comments comments</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <div class="flex items-center gap-1.5 text-muted-foreground">
                    <LucideIconCn Name="users" Size="12" Class="size-3" />
                    <span>@_userContent.Length submissions</span>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Load more
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record UserContent(string Id, string Username, string UserInitials, string SubmittedDate, bool IsFeatured, bool IsPending, int Likes, int Comments);

    private static readonly UserContent[] _userContent =
    [
        new("1", "sarah_designs", "SD", "2 hours ago", true,  false, 234, 18),
        new("2", "alex_creative", "AC", "5 hours ago", false, true,  89,  7),
        new("3", "jamie_photo",   "JP", "1 day ago",   true,  false, 567, 42),
        new("4", "taylor_art",    "TA", "1 day ago",   false, false, 143, 12),
        new("5", "morgan_studio", "MS", "2 days ago",  false, true,  67,  4),
        new("6", "casey_digital", "CD", "3 days ago",  false, false, 289, 21),
    ];

    private int _pendingCount  => Array.FindAll(_userContent, c => c.IsPending).Length;
    private int _featuredCount => Array.FindAll(_userContent, c => c.IsFeatured).Length;
}
