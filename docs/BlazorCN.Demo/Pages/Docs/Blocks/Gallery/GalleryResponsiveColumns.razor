@* ============================================================
   Block: gallery-responsive-columns
   Title: GalleryResponsiveColumns
   Description: A gallery that demonstrates responsive column counts with 1 col on mobile, 2 on md, 3 on lg, 4 on xl built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/gallery/gallery-responsive-columns.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="font-medium text-sm">Responsive Gallery</h2>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Adapts to screen size automatically
                    </p>
                </div>
                <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1.5">
                    <LucideIconCn Name="@_badgeIconName" Size="12" Class="size-3" />
                    <span class="font-mono text-xs">@_columnCount col</span>
                </BadgeCn>
            </div>
        </div>

        <div class="border-b bg-muted/30 px-4 py-2.5">
            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                <span class="font-medium">Current:</span>
                <span>@_breakpointLabel</span>
            </div>
        </div>

        <div class="p-4">
            <div class="mb-4 grid grid-cols-4 gap-2 rounded-md bg-muted/30 p-2">
                @foreach (var bp in _breakpoints)
                {
                    var breakpoint = bp;
                    <div class="@Cn.Merge("flex flex-col items-center gap-1 rounded px-2 py-1.5 transition-colors", _columnCount == breakpoint.Cols ? "bg-background" : "")">
                        <LucideIconCn Name="@breakpoint.Icon"
                                      Size="14"
                                      Class="@Cn.Merge("size-3.5", _columnCount == breakpoint.Cols ? "text-foreground" : "text-muted-foreground")" />
                        <span class="@Cn.Merge("font-mono text-xs", _columnCount == breakpoint.Cols ? "font-medium" : "text-muted-foreground")">
                            @breakpoint.Cols
                        </span>
                    </div>
                }
            </div>

            <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                @foreach (var img in _galleryImages)
                {
                    var image = img;
                    <div class="overflow-hidden rounded-md border bg-muted">
                        <img src="@image.Image"
                             alt="@image.Title"
                             class="aspect-square w-full object-cover" />
                        <div class="border-t px-2 py-1.5">
                            <p class="text-center font-mono text-muted-foreground text-xs">
                                @image.Title
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Resize your browser to see column count change
            </p>
        </div>
    </div>
</section>

@code {
    private record GalleryImage(string Id, string Title, string Image);
    private record Breakpoint(int Cols, string Label, string Icon);

    private int _columnCount = 1;

    private string _badgeIconName => _columnCount switch
    {
        1 => "smartphone",
        2 => "tablet",
        3 => "monitor",
        4 => "maximize",
        _ => "smartphone"
    };

    private string _breakpointLabel => _columnCount switch
    {
        1 => "Mobile (< 768px)",
        2 => "Tablet (≥ 768px)",
        3 => "Desktop (≥ 1024px)",
        4 => "Wide (≥ 1280px)",
        _ => "Mobile"
    };

    private static readonly Breakpoint[] _breakpoints =
    [
        new(1, "SM", "smartphone"),
        new(2, "MD", "tablet"),
        new(3, "LG", "monitor"),
        new(4, "XL", "maximize"),
    ];

    private static readonly GalleryImage[] _galleryImages =
    [
