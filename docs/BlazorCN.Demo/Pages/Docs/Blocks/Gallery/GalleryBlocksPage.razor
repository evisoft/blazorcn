@code {
    private record GalleryImage(string Id, string Title, string Location, string Image);

    private record KenBurnsVariant(string From, string To);

    private int _currentIndex = 0;
    private bool _isPlaying = true;
    private System.Threading.Timer? _timer;

    private static readonly GalleryImage[] _images =
    [
        new(""1"", ""Alpine Summit"",       ""Swiss Alps"",              ""https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop""),
        new(""2"", ""Ocean Horizon"",       ""Pacific Coast"",           ""https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&auto=format&fit=crop""),
        new(""3"", ""Ancient Forest"",      ""Redwood National Park"",   ""https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800&auto=format&fit=crop""),
        new(""4"", ""Desert Expanse"",      ""Sahara Desert"",           ""https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=800&auto=format&fit=crop""),
        new(""5"", ""Urban Skyline"",       ""New York City"",           ""https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&auto=format&fit=crop""),
        new(""6"", ""Winter Wonderland"",   ""Norwegian Fjords"",        ""https://images.unsplash.com/photo-1518173946687-a544bf02a536?w=800&auto=format&fit=crop""),
    ];

    // CSS transform strings matching the original Framer Motion variants
    private static readonly KenBurnsVariant[] _kenBurnsVariants =
    [
        new(""scale(1)   translate(0px, 0px)"",     ""scale(1.15) translate(-20px, -20px)""),
        new(""scale(1.1) translate(0px, 0px)"",      ""scale(1)    translate(15px, 15px)""),
        new(""scale(1)   translate(-10px, 0px)"",    ""scale(1.12) translate(10px, -15px)""),
        new(""scale(1.08) translate(0px, -10px)"",   ""scale(1)    translate(-15px, 10px)""),
        new(""scale(1)   translate(10px, 10px)"",    ""scale(1.1)  translate(-10px, -10px)""),
        new(""scale(1.05) translate(-5px, 5px)"",    ""scale(1)    translate(5px, -5px)""),
    ];

    protected override void OnInitialized()
    {
        StartTimer();
    }

    private void StartTimer()
    {
        _timer?.Dispose();
        if (_isPlaying)
        {
            _timer = new System.Threading.Timer(_ =>
            {
                _currentIndex = (_currentIndex + 1) % _images.Length;
                InvokeAsync(StateHasChanged);
            }, null, 6000, 6000);
        }
    }

    private void TogglePlayPause()
    {
        _isPlaying = !_isPlaying;
        if (_isPlaying)
        {
            StartTimer();
        }
        else
        {
            _timer?.Dispose();
            _timer = null;
        }
    }

    private void SetIndex(int index)
    {
        _currentIndex = index;
        if (_isPlaying)
        {
            StartTimer(); // reset interval on manual nav
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}";

