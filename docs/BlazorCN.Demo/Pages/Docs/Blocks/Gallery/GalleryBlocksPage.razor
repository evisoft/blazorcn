            ""https://images.unsplash.com/photo-1472214103451-9374bd1c798e?w=800&auto=format&fit=crop"",
            ""https://images.unsplash.com/photo-1504567961542-e24d9439a724?w=800&auto=format&fit=crop""),
        new(""3"", ""Interior Renovation"", ""Architecture"", ""Before"", ""After"",
            ""https://images.unsplash.com/photo-1481026469463-66327c86e544?w=800&auto=format&fit=crop"",
            ""https://images.unsplash.com/photo-1486325212027-8081e485255e?w=800&auto=format&fit=crop""),
        new(""4"", ""Color Grading"", ""Post-Production"", ""Raw"", ""Graded"",
            ""https://images.unsplash.com/photo-1557672172-298e090bd0f1?w=800&auto=format&fit=crop"",
            ""https://images.unsplash.com/photo-1553356084-58ef4a67b2a7?w=800&auto=format&fit=crop""),
    ];

    private int _selectedIndex = 0;
    private double _sliderPosition = 50;
    private bool _isDragging = false;
    private readonly string _viewerId = ""gallery-before-after-viewer"";

    private ComparisonItem _selectedItem => _comparisonItems[_selectedIndex];

    private void SelectItem(int index)
    {
        _selectedIndex = index;
        _sliderPosition = 50;
    }

    private void HandleMouseDown(MouseEventArgs e)
    {
        _isDragging = true;
    }

    private void HandleMouseUp(MouseEventArgs e)
    {
        _isDragging = false;
    }

    private async Task HandleMouseMove(MouseEventArgs e)
    {
        if (!_isDragging) return;
        var rect = await JS.InvokeAsync<ViewerRect>(
            ""eval"",
            $""(function(){{var r=document.getElementById('{_viewerId}').getBoundingClientRect();return{{left:r.left,width:r.width}};}})()"");
        if (rect.Width <= 0) return;
        var x = e.ClientX - rect.Left;
        var pct = (x / rect.Width) * 100.0;
        _sliderPosition = Math.Max(0, Math.Min(100, pct));
    }

    private sealed class ViewerRect
    {
        [System.Text.Json.Serialization.JsonPropertyName(""left"")]
        public double Left { get; init; }

        [System.Text.Json.Serialization.JsonPropertyName(""width"")]
        public double Width { get; init; }
    }
}";

