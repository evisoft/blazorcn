    ];

    private static readonly GalleryItem[][] _columns = DistributeItems();

    private HashSet<string> _likedItems = [];

    private static GalleryItem[][] DistributeItems()
    {
        const int columns = 3;
        var cols = new List<GalleryItem>[columns];
        var colHeights = new int[columns];
        for (var i = 0; i < columns; i++)
            cols[i] = [];

        foreach (var item in _items)
        {
            var shortest = 0;
            for (var i = 1; i < columns; i++)
                if (colHeights[i] < colHeights[shortest])
                    shortest = i;
            cols[shortest].Add(item);
            colHeights[shortest] += item.Height;
        }

        return [cols[0].ToArray(), cols[1].ToArray(), cols[2].ToArray()];
    }

    private void ToggleLike(string id)
    {
        if (!_likedItems.Remove(id))
            _likedItems.Add(id);
    }
