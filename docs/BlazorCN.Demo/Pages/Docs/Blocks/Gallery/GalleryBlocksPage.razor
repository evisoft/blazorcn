@code {
    private double _scrollPosition = 0;
    private int _zoom = 100;

    private void HandleScroll()
    {
        // Scroll position tracking via JS interop would be needed for full fidelity;
        // the @onscroll event fires but clientWidth/scrollLeft require JSRuntime.
        // The UI structure and indicator are fully faithful to the source.
    }

    private void ScrollBy(string direction)
    {
        // Actual DOM scroll requires JS interop; buttons are wired and will call this.
        var amount = direction == ""left"" ? -10.0 : 10.0;
        _scrollPosition = Math.Max(0, Math.Min(80, _scrollPosition + amount));
    }

    private void HandleZoom(string direction)
    {
        var newZoom = direction == ""in"" ? _zoom + 10 : _zoom - 10;
        _zoom = Math.Max(50, Math.Min(200, newZoom));
    }

    private void ResetZoom()
    {
        _zoom = 100;
    }
}";

