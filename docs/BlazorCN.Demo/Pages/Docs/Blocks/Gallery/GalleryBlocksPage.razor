@code {
    private record ColorSwatch(string Id, string Name, string Hex, string Category);

    private string? _copiedId = null;

    private System.Threading.CancellationTokenSource? _cts;

    private async Task CopyToClipboard(string hex, string id)
    {
        _copiedId = id;
        _cts?.Cancel();
        _cts = new System.Threading.CancellationTokenSource();
        var token = _cts.Token;
        StateHasChanged();
        try
        {
            await Task.Delay(2000, token);
            _copiedId = null;
        }
        catch (TaskCanceledException) { }
    }

