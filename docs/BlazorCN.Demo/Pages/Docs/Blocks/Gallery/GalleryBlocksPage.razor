        new(""9"",  ""Family Photo"",     ""people"", 29, 4, ""https://images.unsplash.com/photo-1518173946687-a544bf02a536?w=800&auto=format&fit=crop""),
        new(""10"", ""Desert Dunes"",     ""nature"", 34, 4, ""https://images.unsplash.com/photo-1475924156734-496f6cac6ec1?w=800&auto=format&fit=crop""),
        new(""11"", ""Night City"",       ""urban"",  39, 5, ""https://images.unsplash.com/photo-1431576901776-e539bd916ba2?w=800&auto=format&fit=crop""),
        new(""12"", ""Beach Sunset"",     ""nature"", 19, 3, ""https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=800&auto=format&fit=crop""),
    ];

    private HashSet<string> _selectedCategories = new HashSet<string> { ""nature"", ""urban"", ""people"" };
    private double[] _priceRange = [0, 50];
    private int _minRating = 0;

    private GalleryItem[] _filteredItems => _galleryItems
        .Where(item =>
            _selectedCategories.Contains(item.Category) &&
            item.Price >= (int)_priceRange[0] &&
            item.Price <= (int)_priceRange[1] &&
            item.Rating >= _minRating)
        .ToArray();

    private bool _hasActiveFilters =>
        _selectedCategories.Count < _categories.Length ||
        _priceRange[0] > 0 ||
        _priceRange[1] < 50 ||
        _minRating > 0;

    private void ToggleCategory(string categoryId)
    {
        if (_selectedCategories.Contains(categoryId))
            _selectedCategories.Remove(categoryId);
        else
            _selectedCategories.Add(categoryId);
    }

    private void ClearFilters()
    {
        _selectedCategories = new HashSet<string> { ""nature"", ""urban"", ""people"" };
        _priceRange = [0, 50];
        _minRating = 0;
    }
}";

