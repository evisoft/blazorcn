        string BeforeImage,
        string AfterImage);

    private static readonly ComparisonItem[] _comparisonItems =
    [
        new(""1"", ""Website Redesign"", ""UI/UX"", ""Old Design"", ""New Design"",
            ""https://images.unsplash.com/photo-1431576901776-e539bd916ba2?w=800&auto=format&fit=crop"",
