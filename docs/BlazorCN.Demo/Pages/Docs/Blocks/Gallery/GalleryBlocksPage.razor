@code {
    private const string _beforeImage =
        ""https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop"";
    private const string _afterImage =
        ""https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&auto=format&fit=crop"";

    private readonly string _containerId = ""gallery-image-comparison-slider-container"";
    private double _sliderPosition = 50;
    private bool _isDragging = false;

    private void HandleMouseDown(MouseEventArgs e)
    {
        _isDragging = true;
    }

    private void HandleMouseUp(MouseEventArgs e)
    {
        _isDragging = false;
    }

    private async Task HandleMouseMove(MouseEventArgs e)
    {
        if (!_isDragging) return;
        var rect = await JS.InvokeAsync<ContainerRect>(
            ""eval"",
            $""(function(){{var r=document.getElementById('{_containerId}').getBoundingClientRect();return{{left:r.left,width:r.width}};}})()"");
        if (rect.Width <= 0) return;
        var x = e.ClientX - rect.Left;
        var pct = (x / rect.Width) * 100.0;
        _sliderPosition = Math.Max(0, Math.Min(100, pct));
    }

    private sealed class ContainerRect
    {
        [System.Text.Json.Serialization.JsonPropertyName(""left"")]
        public double Left { get; init; }

        [System.Text.Json.Serialization.JsonPropertyName(""width"")]
        public double Width { get; init; }
    }
}";

