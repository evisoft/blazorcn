    private record CarouselItem(string Id, string Title, string Category, double Rating, bool Featured, string Image);

    private int _currentIndex = 0;

    private static readonly List<CarouselItem> _items =
    [
        new(""1"", ""Mountain Vista"",   ""Landscape"",    4.9, true,  ""https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop""),
        new(""2"", ""Urban Geometry"",   ""Architecture"", 4.7, false, ""https://images.unsplash.com/photo-1486325212027-8081e485255e?w=800&auto=format&fit=crop""),
        new(""3"", ""Ocean Waves"",      ""Seascape"",     4.8, true,  ""https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&auto=format&fit=crop""),
        new(""4"", ""Forest Light"",     ""Nature"",       4.6, false, ""https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&auto=format&fit=crop""),
        new(""5"", ""City Nights"",      ""Urban"",        4.9, true,  ""https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=800&auto=format&fit=crop""),
    ];

    private void Rotate(int direction)
    {
        var next = _currentIndex + direction;
        if (next < 0) next = _items.Count - 1;
        else if (next >= _items.Count) next = 0;
        _currentIndex = next;
    }

    private void GoTo(int index)
    {
        _currentIndex = index;
    }

    private int GetItemPosition(int index)
    {
        var diff = index - _currentIndex;
        var normalizedDiff = ((diff % _items.Count) + _items.Count) % _items.Count;
        var adjustedDiff = normalizedDiff > _items.Count / 2.0 ? normalizedDiff - _items.Count : normalizedDiff;
        return adjustedDiff;
    }
}";

