@* ============================================================
   Block: gallery-staggered-reveal
   Title: GalleryStaggeredReveal
   Description: A gallery that reveals items one by one with staggered animation on mount, featuring fade-in and scale effects with impression tracking built with React, Next.js, shadcn/ui, Tailwind CSS, and Framer Motion
   Source: original/blocks/gallery/gallery-staggered-reveal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Featured Gallery</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Items reveal as they load</p>
        </div>

        <div class="grid grid-cols-2 gap-3 p-4 sm:grid-cols-3">
            @foreach (var galleryItem in _items)
            {
                var item = galleryItem;
                var isViewed = _viewedItems.Contains(item.Id);
                <div class="group relative overflow-hidden rounded-md bg-muted"
                     @onmouseover="@(() => HandleItemView(item.Id))">
                    @* Image *@
                    <img src="@item.Image"
                         alt="@item.Title"
                         class="aspect-square object-cover" />

                    @* Content overlay *@
                    <div class="absolute inset-0 flex flex-col justify-between bg-gradient-to-t from-black/80 via-transparent to-transparent p-3 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                        <div class="flex justify-end gap-1">
                            <ButtonCn Variant="ButtonVariant.Ghost"
                                      Size="ButtonSize.Icon"
                                      Class="size-7 bg-white/10 backdrop-blur-sm hover:bg-white/20">
                                <LucideIconCn Name="heart" Size="14" Class="size-3.5 text-white" />
                            </ButtonCn>
                        </div>

                        <div>
                            <h3 class="font-medium text-white text-xs">@item.Title</h3>
                            <p class="mt-0.5 text-white/70 text-xs">@item.Category</p>
                            <div class="mt-2 flex items-center gap-3 text-white/60 text-xs">
                                <div class="flex items-center gap-1">
                                    <LucideIconCn Name="eye" Size="12" Class="size-3" />
                                    <span>@item.Impressions.ToString("N0")</span>
                                </div>
                                <div class="flex items-center gap-1">
                                    <LucideIconCn Name="heart" Size="12" Class="size-3" />
                                    <span>@item.Likes.ToString("N0")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Viewed indicator *@
                    @if (isViewed)
                    {
                        <div class="absolute right-2 top-2 rounded-full bg-emerald-500/90 px-2 py-0.5 backdrop-blur-sm">
                            <span class="font-medium text-white text-xs">Viewed</span>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="flex items-center justify-between border-t px-4 py-3">
            <p class="text-muted-foreground text-xs">
                @_viewedItems.Count of @_items.Length viewed
            </p>
            <p class="text-muted-foreground text-xs">
                Total: @_totalImpressions.ToString("N0") impressions
            </p>
        </div>
    </div>
</section>

@code {
    private record GalleryItem(string Id, string Title, string Category, int Impressions, int Likes, string Image);

    private HashSet<string> _viewedItems = [];

    private static readonly GalleryItem[] _items =
    [
        new("1", "Abstract Composition", "Digital Art", 2847, 342,
            "https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=600&h=600&auto=format&fit=crop"),
        new("2", "Minimalist Design", "Graphic Design", 1923, 278,
            "https://images.unsplash.com/photo-1481026469463-66327c86e544?w=600&h=600&auto=format&fit=crop"),
        new("3", "Nature Photography", "Photography", 3421, 489,
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=600&h=600&auto=format&fit=crop"),
        new("4", "Urban Exploration", "Photography", 1654, 201,
            "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=600&h=600&auto=format&fit=crop"),
        new("5", "Color Studies", "Digital Art", 2103, 315,
            "https://images.unsplash.com/photo-1431576901776-e539bd916ba2?w=600&h=600&auto=format&fit=crop"),
        new("6", "Typography", "Graphic Design", 1789, 234,
            "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=600&h=600&auto=format&fit=crop"),
    ];

    private int _totalImpressions => _items.Sum(i => i.Impressions);

    private void HandleItemView(string id)
    {
        _viewedItems.Add(id);
    }
}
