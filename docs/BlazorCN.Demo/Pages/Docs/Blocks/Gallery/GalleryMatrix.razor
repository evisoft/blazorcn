@* ============================================================
   Block: gallery-matrix
   Title: GalleryMatrix
   Description: A matrix grid gallery with equal-size cells and 3D flip hover animation built with React, Next.js, shadcn/ui, and Tailwind CSS. Front shows image, back reveals details with playing card flip effect.
   Source: original/blocks/gallery/gallery-matrix.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Matrix Flip Gallery</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Hover over cards to reveal details</p>
        </div>

        <div class="p-4">
            <div class="grid grid-cols-3 gap-3">
                @foreach (var item in _galleryItems)
                {
                    var it = item;
                    <div class="group relative aspect-square [perspective:1000px]">
                        <div class="relative h-full w-full transition-transform duration-500 [transform-style:preserve-3d] group-hover:[transform:rotateY(180deg)]">
                            @* Front face *@
                            <div class="absolute inset-0 rounded-md [backface-visibility:hidden]">
                                <img src="@it.Image"
                                     alt="@it.Title"
                                     class="h-full w-full rounded-md object-cover" />
                            </div>

                            @* Back face *@
                            <div class="absolute inset-0 flex flex-col gap-2 rounded-md bg-muted p-3 [backface-visibility:hidden] [transform:rotateY(180deg)]">
                                <div class="flex-1">
                                    <h3 class="font-medium text-xs leading-tight">@it.Title</h3>
                                    <div class="mt-2 flex items-center gap-1 text-muted-foreground text-xs">
                                        <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                        <span>@it.Date</span>
                                    </div>
                                </div>
                                <div class="flex items-center gap-1">
                                    <LucideIconCn Name="tag" Size="12" Class="size-3 text-muted-foreground" />
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var tag in it.Tags)
                                        {
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px]">@tag</BadgeCn>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-4 flex items-center gap-2 rounded-md bg-muted/50 p-3">
                <div class="size-1.5 shrink-0 rounded-full bg-blue-500"></div>
                <p class="text-muted-foreground text-xs">
                    3D flip animation reveals metadata on hover
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private record GalleryItem(string Id, string Title, string Date, string[] Tags, string Image);

    private static readonly GalleryItem[] _galleryItems =
    [
        new("1", "Mountain Sunrise", "Mar 20, 2026", ["Nature", "Landscape"],
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=600&h=600&auto=format&fit=crop"),
        new("2", "City Lights", "Mar 18, 2026", ["Urban", "Night"],
            "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=600&h=600&auto=format&fit=crop"),
        new("3", "Ocean Waves", "Mar 15, 2026", ["Sea", "Nature"],
