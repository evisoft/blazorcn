@* ============================================================
   Block: gallery-infinite-marquee
   Title: GalleryInfiniteMarquee
   Description: A horizontally scrolling infinite marquee gallery with dual opposite-direction rows built with React, Next.js, shadcn/ui, and Tailwind CSS. Features continuous CSS animation and smooth looping for logos and images.
   Source: original/blocks/gallery/gallery-infinite-marquee.tsx
   ============================================================ *@

<style>
    @@keyframes marquee-left {
        0%   { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }

    @@keyframes marquee-right {
        0%   { transform: translateX(-50%); }
        100% { transform: translateX(0); }
    }

    .animate-marquee-left {
        animation: marquee-left 30s linear infinite;
    }

    .animate-marquee-right {
        animation: marquee-right 30s linear infinite;
    }

    .animate-marquee-left:hover,
    .animate-marquee-right:hover {
        animation-play-state: paused;
    }
</style>

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Infinite Marquee Gallery</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Continuous scrolling in opposite directions
            </p>
        </div>

        <div class="space-y-6 p-4">
            @* First marquee row - scrolling left *@
            <div class="relative overflow-hidden">
                <div class="flex animate-marquee-left gap-4">
                    @foreach (var item in _doubledItems)
                    {
                        var it = item;
                        <div class="h-24 w-32 shrink-0 overflow-hidden rounded-md">
                            <img src="@it.Image" alt="@it.Title" class="size-full object-cover" />
                        </div>
                    }
                </div>
            </div>

            @* Second marquee row - scrolling right *@
            <div class="relative overflow-hidden">
                <div class="flex animate-marquee-right gap-4">
                    @foreach (var item in _reversedDoubledItems)
                    {
                        var it = item;
                        <div class="h-24 w-32 shrink-0 overflow-hidden rounded-md">
                            <img src="@it.Image" alt="@it.Title" class="size-full object-cover" />
                        </div>
                    }
                </div>
            </div>

            <div class="flex items-center gap-2 rounded-md bg-muted/50 p-3">
                <div class="size-1.5 shrink-0 rounded-full bg-emerald-500"></div>
                <p class="text-muted-foreground text-xs">
                    Continuous infinite scroll with CSS animations
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private record GalleryItem(string Id, string Title, string Color, string Image);

    private static readonly GalleryItem[] _galleryItems =
    [
        new("1", "Brand A", "bg-blue-500/10",
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop"),
        new("2", "Brand B", "bg-purple-500/10",
            "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&auto=format&fit=crop"),
        new("3", "Brand C", "bg-green-500/10",
            "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800&auto=format&fit=crop"),
        new("4", "Brand D", "bg-orange-500/10",
            "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=800&auto=format&fit=crop"),
        new("5", "Brand E", "bg-pink-500/10",
            "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&auto=format&fit=crop"),
        new("6", "Brand F", "bg-cyan-500/10",
            "https://images.unsplash.com/photo-1518173946687-a544bf02a536?w=800&auto=format&fit=crop"),
        new("7", "Brand G", "bg-amber-500/10",
            "https://images.unsplash.com/photo-1475924156734-496f6cac6ec1?w=800&auto=format&fit=crop"),
        new("8", "Brand H", "bg-rose-500/10",
            "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=800&auto=format&fit=crop"),
    ];

    // Doubled arrays for seamless infinite loop (mirrors the TSX [...galleryItems, ...galleryItems])
    private static readonly GalleryItem[] _doubledItems =
        [.. _galleryItems, .. _galleryItems];

    // Reversed doubled array (mirrors the TSX [...galleryItems, ...galleryItems].reverse())
    private static readonly GalleryItem[] _reversedDoubledItems =
        [.. _galleryItems.Reverse(), .. _galleryItems.Reverse()];
}
