@* ============================================================
   Block: gallery-band-layout
   Title: GalleryBandLayout
   Description: A horizontal band gallery built with React, Next.js, shadcn/ui, and Tailwind CSS. Full-width horizontal stripes stacked vertically for a cinematic, panoramic presentation.
   Source: original/blocks/gallery/gallery-band-layout.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Company Timeline</h2>
            <p class="mt-1 text-xs text-muted-foreground">Key moments from the past year</p>
        </div>

        @* Band Gallery *@
        <div class="divide-y">
            @foreach (var band in _bands)
            {
                <div class="group relative overflow-hidden">
                    @* Band Image *@
                    <div class="relative h-32 overflow-hidden transition-all duration-500 group-hover:scale-105">
                        <img src="@band.Image" alt="@band.Title" class="h-full w-full object-cover" />

                        @* Overlay Gradient *@
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>

                        @* Content Overlay *@
                        <div class="absolute inset-0 flex items-end p-4">
                            <div class="w-full">
                                <div class="flex items-start justify-between">
                                    <div class="min-w-0 flex-1">
                                        <BadgeCn Variant="BadgeVariant.Outline" Class="@($"mb-2 border-0 {CategoryColor(band.Category)}")">
                                            @band.Category
                                        </BadgeCn>
                                        <h3 class="font-medium text-sm text-white">@band.Title</h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Band Details *@
                    <div class="bg-muted/30 px-4 py-3">
                        <p class="text-muted-foreground text-xs">@band.Description</p>

                        <div class="mt-3 flex flex-wrap items-center gap-3 text-muted-foreground text-xs">
                            <div class="flex items-center gap-1.5">
                                <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                <span>@band.Date</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                                <span>@band.Location</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <LucideIconCn Name="users" Size="12" Class="size-3" />
                                <span>@band.Attendees attendees</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record BandItem(string Id, string Title, string Description, string Location, string Date, int Attendees, string Category, string Image);

    private static readonly BandItem[] _bands =
    [
        new("1", "Annual Company Summit 2025", "Three-day conference bringing together teams from across the globe", "San Francisco, CA", "March 15-17, 2025", 450, "event", "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop"),
        new("2", "Product Launch Milestone", "Successfully launched version 2.0 with revolutionary features", "Virtual Event", "February 28, 2025", 1200, "milestone", "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800&auto=format&fit=crop"),
        new("3", "Team Building Retreat", "Weekend getaway focused on collaboration and innovation", "Lake Tahoe, NV", "January 20-22, 2025", 85, "event", "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=800&auto=format&fit=crop"),
        new("4", "Infrastructure Overhaul Complete", "Migrated entire platform to cloud-native architecture", "Engineering HQ", "December 10, 2024", 32, "project", "https://images.unsplash.com/photo-1518770660439-4636190af475?w=800&auto=format&fit=crop"),
        new("5", "First International Office Opening", "Expanded operations with new office in London", "London, UK", "November 1, 2024", 250, "milestone", "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=800&auto=format&fit=crop"),
    ];

    private static string CategoryColor(string category) => category switch
    {
        "event" => "bg-blue-500/10 text-blue-500",
        "milestone" => "bg-green-500/10 text-green-500",
        "project" => "bg-purple-500/10 text-purple-500",
        _ => ""
    };
}
