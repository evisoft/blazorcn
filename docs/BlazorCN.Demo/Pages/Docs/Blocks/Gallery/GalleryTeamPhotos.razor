@* ============================================================
   Block: gallery-team-photos
   Title: GalleryTeamPhotos
   Description: A team member photo gallery with circular avatars, roles, and department filters built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/gallery/gallery-team-photos.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-4">
            <h2 class="font-semibold text-base">Meet Our Team</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                @_filteredMembers.Length talented individuals shaping the future
            </p>
        </div>

        @* Department Filters *@
        <div class="border-b px-6 py-3">
            <div class="flex flex-wrap gap-2">
                @foreach (var dep in _departments)
                {
                    var dept = dep;
                    var deptCount = _teamMembers.Count(m => m.Department == dept);
                    <ButtonCn Size="ButtonSize.Sm"
                              Variant="@(_selectedDepartment == dept ? ButtonVariant.Default : ButtonVariant.Outline)"
                              Class="h-7 text-xs"
                              @onclick="@(() => _selectedDepartment = dept)">
                        @dept
                        @if (dept != "All")
                        {
                            <span class="ml-1.5 text-muted-foreground text-xs">@deptCount</span>
                        }
                    </ButtonCn>
                }
            </div>
        </div>

        @* Team Grid *@
        <div class="grid grid-cols-2 gap-6 p-6 sm:grid-cols-3 md:grid-cols-4">
            @foreach (var mem in _filteredMembers)
            {
                var member = mem;
                <div class="group">
                    @* Avatar *@
                    <div class="relative mb-3 overflow-hidden">
                        <div class="relative aspect-square w-full overflow-hidden rounded-full bg-muted">
                            <img src="@member.Image" alt="@member.Name" class="size-full object-cover" />
                        </div>

                        @* Social Links Overlay *@
                        <div class="absolute inset-0 flex items-center justify-center gap-2 rounded-full bg-black/70 opacity-0 transition-opacity duration-200 group-hover:opacity-100">
                            <button type="button"
                                    class="flex size-8 items-center justify-center rounded-full bg-white/20 text-white transition-colors hover:bg-white/30"
                                    aria-label="@($"View {member.Name}'s LinkedIn profile")">
                                <LucideIconCn Name="linkedin" Size="16" Class="size-4" />
                            </button>
                            <button type="button"
                                    class="flex size-8 items-center justify-center rounded-full bg-white/20 text-white transition-colors hover:bg-white/30"
                                    aria-label="@($"View {member.Name}'s Twitter profile")">
                                <LucideIconCn Name="twitter" Size="16" Class="size-4" />
                            </button>
                            <button type="button"
                                    class="flex size-8 items-center justify-center rounded-full bg-white/20 text-white transition-colors hover:bg-white/30"
                                    aria-label="@($"Email {member.Name}")">
                                <LucideIconCn Name="mail" Size="16" Class="size-4" />
                            </button>
                        </div>
                    </div>

                    @* Info *@
                    <div class="text-center">
                        <h3 class="font-medium text-sm">@member.Name</h3>
                        <p class="mt-0.5 text-muted-foreground text-xs">@member.Role</p>
                        <span class="mt-1 inline-block rounded-full bg-muted px-2 py-0.5 text-muted-foreground text-xs">
                            @member.Department
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TeamMember(string Id, string Name, string Role, string Department, string Image);

    private string _selectedDepartment = "All";

    private static readonly string[] _departments = ["All", "Engineering", "Design", "Marketing", "Operations"];

    private static readonly TeamMember[] _teamMembers =
    [
