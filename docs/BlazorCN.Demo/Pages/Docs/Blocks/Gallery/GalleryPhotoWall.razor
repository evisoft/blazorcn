@* ============================================================
   Block: gallery-photo-wall
   Title: GalleryPhotoWall
   Description: A compact photo wall gallery built with React, Next.js, shadcn/ui, and Tailwind CSS. Features tight grid layout with no gaps and hover-revealed quick actions for sharing, downloading, and favoriting.
   Source: original/blocks/gallery/gallery-photo-wall.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Photo Wall</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_photoItems.Length photos · @_favorites.Count favorites
            </p>
        </div>

        <div class="p-0">
            <div class="grid grid-cols-4 gap-0">
                @foreach (var ph in _photoItems)
                {
                    var photo = ph;
                    var sizeClass = _sizeClasses[photo.Size];
                    var isFav = _favorites.Contains(photo.Id);
                    <div class="@Cn.Merge("group relative overflow-hidden bg-muted", sizeClass)">
                        <img src="@photo.Image"
                             alt="@photo.Title"
                             class="absolute inset-0 h-full w-full object-cover" />

                        @* Overlay — shown on hover via CSS group-hover *@
                        <div class="absolute inset-0 bg-black/60 opacity-0 transition-opacity duration-200 group-hover:opacity-100"></div>

                        @* Action buttons — shown on hover *@
                        <div class="absolute inset-0 flex items-center justify-center gap-1 opacity-0 transition-all duration-200 group-hover:opacity-100">
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                                      Class="h-8 w-8 rounded-full bg-white/10 text-white backdrop-blur-sm hover:bg-white/20" aria-label="Share">
                                <LucideIconCn Name="share-2" Size="14" Class="size-3.5" />
                            </ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                                      Class="h-8 w-8 rounded-full bg-white/10 text-white backdrop-blur-sm hover:bg-white/20" aria-label="Download">
                                <LucideIconCn Name="download" Size="14" Class="size-3.5" />
                            </ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                                      Class="h-8 w-8 rounded-full bg-white/10 text-white backdrop-blur-sm hover:bg-white/20"
                                      OnClick="@((MouseEventArgs _) => ToggleFavorite(photo.Id))" aria-label="Like">
                                <LucideIconCn Name="heart" Size="14" Class="@Cn.Merge("size-3.5", isFav ? "fill-red-500 text-red-500" : "")" />
                            </ButtonCn>
                        </div>

                        @* Favorite indicator badge *@
                        @if (isFav)
                        {
                            <div class="absolute right-2 top-2">
                                <LucideIconCn Name="heart" Size="12" Class="size-3 fill-red-500 text-red-500" />
                            </div>
                        }

                        @* Title overlay — slides up on hover *@
                        <div class="absolute inset-x-0 bottom-0 translate-y-2 bg-gradient-to-t from-black/80 to-transparent p-2 opacity-0 transition-all group-hover:translate-y-0 group-hover:opacity-100">
                            <span class="text-xs font-medium text-white">@photo.Title</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record PhotoItem(string Id, string Title, string Size, bool IsFavorite, string Image);

    private static readonly PhotoItem[] _photoItems =
    [
        new("p1",  "Mountain View",   "large",  false, "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop"),
        new("p2",  "Ocean Beach",     "small",  true,  "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&auto=format&fit=crop"),
        new("p3",  "Forest Trail",    "medium", false, "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800&auto=format&fit=crop"),
        new("p4",  "Desert Sand",     "small",  false, "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=800&auto=format&fit=crop"),
        new("p5",  "City Skyline",    "large",  true,  "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=800&auto=format&fit=crop"),
        new("p6",  "Aurora Sky",      "medium", false, "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&auto=format&fit=crop"),
        new("p7",  "Waterfall",       "small",  false, "https://images.unsplash.com/photo-1518173946687-a544bf02a536?w=800&auto=format&fit=crop"),
        new("p8",  "Sunset Clouds",   "medium", false, "https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=800&auto=format&fit=crop"),
        new("p9",  "Lake Reflection", "large",  false, "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop"),
        new("p10", "Snow Peak",       "small",  true,  "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&auto=format&fit=crop"),
        new("p11", "Valley View",     "medium", false, "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800&auto=format&fit=crop"),
        new("p12", "Canyon Edge",     "small",  false, "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=800&auto=format&fit=crop"),
    ];

    private static readonly Dictionary<string, string> _sizeClasses = new()
    {
        ["small"]  = "col-span-1 row-span-1 h-24",
        ["medium"] = "col-span-2 row-span-1 h-24",
        ["large"]  = "col-span-2 row-span-2 h-52",
    };

    // Initialise favorites from the seed data (items where IsFavorite is true)
    private HashSet<string> _favorites = new(
        _photoItems.Where(p => p.IsFavorite).Select(p => p.Id));

    private void ToggleFavorite(string id)
    {
        if (!_favorites.Remove(id))
            _favorites.Add(id);
    }
}
