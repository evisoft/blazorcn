@* ============================================================
   Block: gallery-countdown
   Title: GalleryCountdown
   Description: A gallery reveal component with countdown timer showcasing locked and unlocked items built with React, Next.js, shadcn/ui, and Tailwind CSS. Perfect for product launches and teasers.
   Source: original/blocks/gallery/gallery-countdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Gallery Collection</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                @_unlockedCount of @_items.Length items available
            </p>
        </div>

        @* Progress Bar *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Release Progress</span>
                <span class="font-medium">@(Math.Round((double)_unlockedCount / _items.Length * 100))%</span>
            </div>
            <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                <div class="h-full bg-emerald-500"
                     style="@($"width:{(double)_unlockedCount / _items.Length * 100}%")"></div>
            </div>
        </div>

        @* Legend *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-4 text-xs">
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-muted-foreground">Available</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    <span class="text-muted-foreground">Unlocking</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-muted-foreground"></span>
                    <span class="text-muted-foreground">Coming</span>
                </div>
            </div>
        </div>

        @* Gallery Grid *@
        <div class="p-4">
            <div class="grid grid-cols-3 gap-3">
                @foreach (var it in _items)
                {
                    var item = it;
                    var isLocked = item.Status != "unlocked";
                    var dotColor = item.Status == "unlocked"
                        ? "bg-emerald-500"
                        : item.Status == "locked"
                            ? "bg-amber-500"
                            : "bg-muted-foreground";
                    var iconName = item.Status == "unlocked"
                        ? "check-circle"
                        : item.Status == "locked"
                            ? "lock"
                            : "clock";
                    var iconColor = item.Status == "unlocked"
                        ? "text-emerald-500"
                        : item.Status == "locked"
                            ? "text-amber-500"
                            : "text-muted-foreground";
                    <div class="relative overflow-hidden rounded-lg border bg-card">
                        @* Image Area *@
                        <div class="relative h-20 overflow-hidden">
                            <img src="@item.Image" alt="@item.Title" class="size-full object-cover" />
                            @if (isLocked)
                            {
                                <div class="absolute inset-0 flex items-center justify-center bg-background/80 backdrop-blur-sm">
                                    <LucideIconCn Name="@iconName" Size="20" Class="@($"size-5 {iconColor}")" />
                                </div>
                            }
                            @if (!isLocked)
                            {
                                <div class="absolute right-1 top-1">
                                    <LucideIconCn Name="check-circle" Size="12" Class="size-3 text-emerald-500" />
                                </div>
                            }
                        </div>

                        @* Content *@
                        <div class="p-2">
                            <div class="mb-1 flex items-start justify-between gap-1">
                                <span class="@Cn.Merge("line-clamp-1 font-medium text-xs", isLocked ? "text-muted-foreground" : "")">
                                    @item.Title
                                </span>
                                <span class="@($"size-1.5 shrink-0 rounded-full {dotColor}")"></span>
                            </div>
                            @if (item.UnlockDate != null && isLocked)
                            {
                                <div class="flex items-center gap-1 text-muted-foreground text-xs">
                                    <LucideIconCn Name="clock" Size="10" Class="size-2.5" />
                                    <span>@item.UnlockDate</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Next Unlock *@
        <div class="border-t p-4">
            <div class="rounded-md bg-muted/50 p-3">
                <div class="mb-1 flex items-center gap-2">
                    <LucideIconCn Name="unlock" Size="14" Class="size-3.5 text-amber-500" />
                    <span class="font-medium text-sm">Next Unlock</span>
                </div>
                <p class="mb-2 text-muted-foreground text-xs">
                    Nature Pack unlocks on March 28 — 3 days remaining
                </p>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="w-full text-xs">
                    Notify Me
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record GalleryItem(string Id, string Title, string Description, string Status, string Category, string Image, string? UnlockDate = null);

    private static readonly GalleryItem[] _items =
    [
        new("1", "Summer Collection", "Vibrant designs for warm weather", "unlocked", "Seasonal",
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=600&h=600&auto=format&fit=crop"),
        new("2", "Minimal Series", "Clean and sophisticated layouts", "unlocked", "Design",
            "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=600&h=600&auto=format&fit=crop"),
        new("3", "Bold Typography", "Statement-making text designs", "unlocked", "Typography",
            "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=600&h=600&auto=format&fit=crop"),
        new("4", "Nature Pack", "Organic and earthy visuals", "locked", "Seasonal",
            "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=600&h=600&auto=format&fit=crop", "March 28"),
        new("5", "Neon Dreams", "Electric and vibrant aesthetics", "locked", "Design",
            "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=600&h=600&auto=format&fit=crop", "March 30"),
        new("6", "Retro Revival", "Vintage-inspired designs", "locked", "Design",
            "https://images.unsplash.com/photo-1518173946687-a544bf02a536?w=600&h=600&auto=format&fit=crop", "April 2"),
        new("7", "Tech Forward", "Futuristic UI elements", "coming-soon", "UI Kit",
            "https://images.unsplash.com/photo-1475924156734-496f6cac6ec1?w=600&h=600&auto=format&fit=crop", "April 5"),
        new("8", "Organic Shapes", "Flowing natural forms", "coming-soon", "Design",
            "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=600&h=600&auto=format&fit=crop", "April 8"),
        new("9", "Dark Mode Pack", "Elegant dark interfaces", "coming-soon", "UI Kit",
            "https://images.unsplash.com/photo-1472214103451-9374bd1c798e?w=600&h=600&auto=format&fit=crop", "April 10"),
    ];

    private int _unlockedCount => _items.Count(i => i.Status == "unlocked");
}
