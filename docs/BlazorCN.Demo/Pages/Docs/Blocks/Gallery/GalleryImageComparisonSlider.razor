@* ============================================================
   Block: gallery-image-comparison-slider
   Title: GalleryImageComparisonSlider
   Description: An interactive before/after image comparison slider built with React, Next.js, shadcn/ui, and Tailwind CSS. Features draggable divider, labeled sides, center grab handle, and real-time progress percentage display.
   Source: original/blocks/gallery/gallery-image-comparison-slider.tsx
   ============================================================ *@

@inject IJSRuntime JS

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Image Comparison</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Drag to compare before and after
                    </p>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-6 tabular-nums text-xs">
                    @(Math.Round(_sliderPosition))%
                </BadgeCn>
            </div>
        </div>

        <div class="p-4">
            <div
                id="@_containerId"
                class="relative aspect-[4/3] w-full cursor-col-resize select-none overflow-hidden rounded-lg border bg-muted"
                @onmousemove="HandleMouseMove"
                @onmouseup="HandleMouseUp"
                @onmouseleave="HandleMouseUp">

                <img src="@_afterImage" alt="After" class="absolute inset-0 size-full object-cover" />

                <div
                    class="absolute inset-0"
                    style="@($"clip-path:inset(0 {100 - _sliderPosition}% 0 0)")">
                    <img src="@_beforeImage" alt="Before" class="size-full object-cover" />
                </div>

                <div class="absolute inset-y-0 z-10" style="@($"left:{_sliderPosition}%")">
                    <div class="relative h-full">
                        <div class="absolute inset-y-0 left-1/2 w-0.5 -translate-x-1/2 bg-white shadow-lg"></div>

                        <button
                            type="button"
                            class="absolute left-1/2 top-1/2 flex h-10 w-10 -translate-x-1/2 -translate-y-1/2 cursor-col-resize items-center justify-center rounded-full border-2 border-white bg-white shadow-lg transition-transform hover:scale-110 active:scale-95"
                            aria-label="Drag to compare images"
                            @onmousedown="HandleMouseDown">
                            <LucideIconCn Name="grip-vertical" Size="20" Class="size-5 text-muted-foreground" />
                        </button>
                    </div>
                </div>

                <div class="absolute left-3 top-3">
                    <BadgeCn Class="h-6 bg-black/40 text-xs text-white backdrop-blur-sm hover:bg-black/40">
                        Before
                    </BadgeCn>
                </div>

                <div class="absolute right-3 top-3">
                    <BadgeCn Class="h-6 bg-black/40 text-xs text-white backdrop-blur-sm hover:bg-black/40">
                        After
                    </BadgeCn>
                </div>
            </div>

            <div class="mt-3 flex items-center justify-between text-xs text-muted-foreground">
                <span>Original image</span>
                <span>Enhanced version</span>
            </div>
        </div>
    </div>
</section>

@code {
    private const string _beforeImage =
        "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop";
    private const string _afterImage =
        "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&auto=format&fit=crop";

    private readonly string _containerId = "gallery-image-comparison-slider-container";
    private double _sliderPosition = 50;
    private bool _isDragging = false;

    private void HandleMouseDown(MouseEventArgs e)
    {
        _isDragging = true;
    }

    private void HandleMouseUp(MouseEventArgs e)
    {
        _isDragging = false;
    }

    private async Task HandleMouseMove(MouseEventArgs e)
    {
        if (!_isDragging) return;
        var rect = await JS.InvokeAsync<ContainerRect>(
            "eval",
            $"(function(){{var r=document.getElementById('{_containerId}').getBoundingClientRect();return{{left:r.left,width:r.width}};}})()");
        if (rect.Width <= 0) return;
        var x = e.ClientX - rect.Left;
        var pct = (x / rect.Width) * 100.0;
        _sliderPosition = Math.Max(0, Math.Min(100, pct));
    }

    private sealed class ContainerRect
    {
        [System.Text.Json.Serialization.JsonPropertyName("left")]
        public double Left { get; init; }

        [System.Text.Json.Serialization.JsonPropertyName("width")]
        public double Width { get; init; }
    }
}
