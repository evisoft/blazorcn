@* ============================================================
   Block: gallery-favorites
   Title: GalleryFavorites
   Description: A gallery component with favorite/heart toggle functionality for React, Next.js, shadcn/ui, and Tailwind CSS applications. Features filter toggle and favorite counter.
   Source: original/blocks/gallery/gallery-favorites.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Gallery</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_favorites.Count @(_favorites.Count == 1 ? "favorite" : "favorites")
                    </p>
                </div>
                <ButtonCn Variant="@(_showOnlyFavorites ? ButtonVariant.Default : ButtonVariant.Outline)"
                          Size="ButtonSize.Sm"
                          Class="h-7 gap-1.5 text-xs"
                          OnClick="@(() => _showOnlyFavorites = !_showOnlyFavorites)">
                    <LucideIconCn Name="heart" Size="14" Class="@Cn.Merge("size-3.5", _showOnlyFavorites ? "fill-current" : "")" />
                    Favorites
                </ButtonCn>
            </div>
        </div>

        <div class="p-4">
            @if (_displayedImages.Length > 0)
            {
                <div class="grid grid-cols-2 gap-3">
                    @foreach (var img in _displayedImages)
                    {
                        var image = img;
                        var isFavorite = _favorites.Contains(image.Id);
                        <div class="group relative">
                            <div class="@Cn.Merge("aspect-video w-full overflow-hidden rounded-md transition-all", isFavorite ? "ring-2 ring-red-500/20 ring-offset-2" : "")">
                                <img src="@image.Image" alt="@image.Title" class="size-full object-cover" />
                            </div>
                            <ButtonCn Variant="ButtonVariant.Ghost"
                                      Size="ButtonSize.Sm"
                                      Class="@Cn.Merge("absolute top-2 right-2 size-7 rounded-full bg-background/80 p-0 opacity-0 backdrop-blur-sm transition-opacity hover:bg-background/90 group-hover:opacity-100", isFavorite ? "opacity-100" : "")"
                                      OnClick="@(() => ToggleFavorite(image.Id))">
                                <LucideIconCn Name="heart" Size="16" Class="@Cn.Merge("size-4 transition-all", isFavorite ? "fill-red-500 text-red-500" : "text-muted-foreground")" />
                            </ButtonCn>
                            <div class="mt-2">
                                <p class="text-sm font-medium">@image.Title</p>
                                <p class="text-xs text-muted-foreground">@image.Category</p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="py-12 text-center">
                    <LucideIconCn Name="heart" Size="32" Class="mx-auto size-8 text-muted-foreground/40" />
                    <p class="mt-2 text-sm text-muted-foreground">No favorites yet</p>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Click the heart icon to save your favorites
                    </p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record GalleryImage(string Id, string Title, string Category, string Image);

    private HashSet<string> _favorites = ["1", "3"];
    private bool _showOnlyFavorites = false;

    private GalleryImage[] _displayedImages => _showOnlyFavorites
        ? _images.Where(img => _favorites.Contains(img.Id)).ToArray()
        : _images;

    private void ToggleFavorite(string id)
    {
        if (_favorites.Contains(id))
            _favorites.Remove(id);
        else
            _favorites.Add(id);
    }

    private static readonly GalleryImage[] _images =
    [
        new("1", "Mountain Vista", "Landscape",
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&h=450&auto=format&fit=crop"),
        new("2", "Urban Architecture", "City",
            "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=800&h=450&auto=format&fit=crop"),
        new("3", "Coastal Sunset", "Nature",
            "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=800&h=450&auto=format&fit=crop"),
        new("4", "Desert Highway", "Landscape",
            "https://images.unsplash.com/photo-1550859492-d5da9d8e45f3?w=800&h=450&auto=format&fit=crop"),
        new("5", "Forest Morning", "Nature",
            "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&h=450&auto=format&fit=crop"),
        new("6", "Glass Tower", "Architecture",
            "https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=800&h=450&auto=format&fit=crop"),
        new("7", "Ocean Waves", "Nature",
            "https://images.unsplash.com/photo-1475924156734-496f6cac6ec1?w=800&h=450&auto=format&fit=crop"),
        new("8", "City Lights", "City",
            "https://images.unsplash.com/photo-1481026469463-66327c86e544?w=800&h=450&auto=format&fit=crop"),
    ];
}
