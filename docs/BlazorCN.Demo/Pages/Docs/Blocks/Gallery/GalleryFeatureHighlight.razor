@* ============================================================
   Block: gallery-feature-highlight
   Title: GalleryFeatureHighlight
   Description: A feature highlight gallery with large screenshots, descriptions, and learn more links built with React, Next.js, shadcn/ui, and Tailwind CSS. Perfect for product pages with alternating left/right layout.
   Source: original/blocks/gallery/gallery-feature-highlight.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Featured Capabilities</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Explore our most powerful features</p>
        </div>

        <div class="divide-y">
            @foreach (var feat in _features)
            {
                var feature = feat;
                var index = System.Array.IndexOf(_features, feature);
                var isOdd = index % 2 == 1;
                <div class="@Cn.Merge("grid gap-6 p-6 md:grid-cols-2 md:items-center", isOdd ? "md:grid-flow-dense" : "")">
                    @* Content *@
                    <div class="@Cn.Merge("flex flex-col gap-3", isOdd ? "md:col-start-2" : "")">
                        <div>
                            <div class="mb-2 flex items-center gap-2">
                                @if (feature.IsNew)
                                {
                                    <div class="flex items-center gap-1 rounded-full bg-blue-500/10 px-2 py-0.5">
                                        <LucideIconCn Name="sparkles" Size="12" Class="size-3 text-blue-600" />
                                        <span class="font-medium text-blue-600 text-[10px]">NEW</span>
                                    </div>
                                }
                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px]">@feature.Badge</BadgeCn>
                            </div>
                            <h3 class="font-semibold text-lg">@feature.Title</h3>
                            <p class="mt-1 text-muted-foreground text-sm leading-relaxed">@feature.Description</p>
                        </div>

                        <div class="rounded-md bg-muted/50 p-3">
                            <div class="mb-1.5 flex items-center gap-1.5">
                                <LucideIconCn Name="zap" Size="12" Class="size-3 text-muted-foreground" />
                                <span class="font-medium text-muted-foreground text-xs">Key Features</span>
                            </div>
                            <p class="text-muted-foreground text-xs leading-relaxed">@feature.Details</p>
                        </div>

                        <ButtonCn Variant="ButtonVariant.Ghost" Class="h-8 w-fit gap-1.5 px-3 text-xs">
                            <span>Learn more</span>
                            <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
                        </ButtonCn>
                    </div>

                    @* Screenshot placeholder *@
                    <div class="@Cn.Merge("overflow-hidden rounded-md border", isOdd ? "md:col-start-1 md:row-start-1" : "")">
                        <img src="https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=800&auto=format&fit=crop&h=500"
                             alt=""
                             class="aspect-[16/10] object-cover" />
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">4 core features highlighted</span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    View all features
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record Feature(string Id, string Title, string Description, string Details, string Badge, bool IsNew = false);

    private static readonly Feature[] _features =
    [
        new("1", "Real-time Collaboration",
            "Work together seamlessly with your team. See changes instantly, comment on designs, and collaborate in real-time without version conflicts.",
            "Built-in presence indicators, live cursors, and instant sync across all devices",
            "Core"),
        new("2", "AI-Powered Insights",
            "Get intelligent suggestions and automated analysis. Our AI understands your workflow and provides contextual recommendations to accelerate your work.",
            "Smart pattern detection, predictive analytics, and automated optimization",
            "AI", true),
        new("3", "Advanced Security",
            "Enterprise-grade security with end-to-end encryption. Your data is protected with industry-leading security standards and compliance certifications.",
            "SOC 2 Type II, GDPR compliant, 256-bit encryption, SSO support",
            "Enterprise"),
        new("4", "Seamless Integrations",
            "Connect with all your favorite tools. Import, export, and sync data across your entire tech stack with pre-built integrations and APIs.",
            "200+ integrations, REST API, webhooks, and custom automation support",
            "Platform"),
    ];
}
