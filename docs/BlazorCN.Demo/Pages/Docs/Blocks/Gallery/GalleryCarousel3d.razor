@* ============================================================
   Block: gallery-carousel-3d
   Title: GalleryCarousel3d
   Description: A three-dimensional rotating carousel using CSS perspective and rotateY transforms with circular arrangement and arrow navigation built with React, Next.js, shadcn/ui, Tailwind CSS, and Framer Motion
   Source: original/blocks/gallery/gallery-carousel-3d.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">3D Gallery Carousel</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Rotate to explore collection</p>
        </div>

        <div class="relative h-80 overflow-hidden bg-gradient-to-b from-muted/30 to-transparent p-8">
            @* 3D carousel container *@
            <div class="relative mx-auto h-full w-full max-w-xs" style="perspective:1000px">
                @foreach (var it in _items)
                {
                    var item = it;
                    var index = _items.IndexOf(item);
                    var position = GetItemPosition(index);
                    var isCenter = position == 0;
                    var angle = position * (360.0 / _items.Count);
                    var translateZ = isCenter ? 180 : 120;
                    var scale = isCenter ? 1.0 : 0.7;
                    var opacity = Math.Abs(position) <= 2 ? 1.0 : 0.0;
                    var zIndex = isCenter ? 10 : 1;
                    var borderClass = isCenter ? "border-foreground/20" : "border-transparent";
                    var transformStyle = $"transform:rotateY({angle}deg) translateZ({translateZ}px) scale({scale.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)});opacity:{opacity.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)};z-index:{zIndex};transform-style:preserve-3d;transition:transform 0.6s cubic-bezier(0.22,1,0.36,1),opacity 0.6s cubic-bezier(0.22,1,0.36,1)";
                    <div class="absolute left-1/2 top-1/2 w-48 -translate-x-1/2 -translate-y-1/2"
                         style="@transformStyle">
                        <div class="@Cn.Merge("overflow-hidden rounded-lg border-2 bg-card shadow-lg transition-colors", borderClass)">
                            @* Image *@
                            <div class="aspect-[4/5]">
                                <img src="@item.Image"
                                     alt="@item.Title"
                                     class="h-full w-full object-cover" />
                            </div>

                            @* Content *@
                            @if (isCenter)
                            {
                                <div class="border-t p-3">
                                    <div class="flex items-start justify-between gap-2">
                                        <div class="min-w-0 flex-1">
                                            <h3 class="truncate font-medium text-sm">@item.Title</h3>
                                            <p class="mt-0.5 text-muted-foreground text-xs">
                                                @item.Category
                                            </p>
                                        </div>
                                        @if (item.Featured)
                                        {
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-xs">
                                                Featured
                                            </BadgeCn>
                                        }
                                    </div>
                                    <div class="mt-2 flex items-center gap-1">
                                        <LucideIconCn Name="star" Size="12" Class="size-3 fill-amber-500 text-amber-500" />
                                        <span class="font-medium text-xs">@item.Rating</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            @* Navigation *@
            <div class="absolute inset-x-0 top-1/2 flex -translate-y-1/2 justify-between px-4">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon"
                          Class="bg-background/80 backdrop-blur-sm"
                          OnClick="@(() => Rotate(-1))">
                    <LucideIconCn Name="chevron-left" Size="16" Class="size-4" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon"
                          Class="bg-background/80 backdrop-blur-sm"
                          OnClick="@(() => Rotate(1))">
                    <LucideIconCn Name="chevron-right" Size="16" Class="size-4" />
                </ButtonCn>
            </div>

            @* Position indicators *@
            <div class="absolute bottom-4 left-1/2 flex -translate-x-1/2 gap-1.5">
                @foreach (var it2 in _items)
                {
                    var item2 = it2;
                    var idx = _items.IndexOf(item2);
                    var dotClass = idx == _currentIndex
                        ? "w-4 bg-foreground"
                        : "bg-foreground/30 hover:bg-foreground/50";
                    <button type="button"
                            class="@Cn.Merge("size-1.5 rounded-full transition-all", dotClass)"
                            @onclick="@(() => GoTo(idx))"
                            aria-label="@($"Go to {item2.Title}")">
                    </button>
                }
            </div>
        </div>

        <div class="flex items-center justify-between border-t px-4 py-3">
            <p class="text-muted-foreground text-xs">
                @(_currentIndex + 1) of @_items.Count
            </p>
            <p class="text-muted-foreground text-xs">@_items[_currentIndex].Title</p>
        </div>
    </div>
</section>

@code {
    private record CarouselItem(string Id, string Title, string Category, double Rating, bool Featured, string Image);

    private int _currentIndex = 0;

    private static readonly List<CarouselItem> _items =
    [
        new("1", "Mountain Vista",   "Landscape",    4.9, true,  "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop"),
        new("2", "Urban Geometry",   "Architecture", 4.7, false, "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=800&auto=format&fit=crop"),
        new("3", "Ocean Waves",      "Seascape",     4.8, true,  "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&auto=format&fit=crop"),
        new("4", "Forest Light",     "Nature",       4.6, false, "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&auto=format&fit=crop"),
        new("5", "City Nights",      "Urban",        4.9, true,  "https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=800&auto=format&fit=crop"),
    ];

    private void Rotate(int direction)
    {
        var next = _currentIndex + direction;
        if (next < 0) next = _items.Count - 1;
        else if (next >= _items.Count) next = 0;
        _currentIndex = next;
    }

    private void GoTo(int index)
    {
        _currentIndex = index;
    }

    private int GetItemPosition(int index)
    {
        var diff = index - _currentIndex;
        var normalizedDiff = ((diff % _items.Count) + _items.Count) % _items.Count;
        var adjustedDiff = normalizedDiff > _items.Count / 2.0 ? normalizedDiff - _items.Count : normalizedDiff;
        return adjustedDiff;
    }
}
