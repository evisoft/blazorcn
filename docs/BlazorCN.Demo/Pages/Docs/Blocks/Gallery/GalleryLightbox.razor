@* ============================================================
   Block: gallery-lightbox
   Title: GalleryLightbox
   Description: An interactive lightbox gallery built with React, Next.js, shadcn/ui, and Tailwind CSS featuring expandable modal previews with navigation
   Source: original/blocks/gallery/gallery-lightbox.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Photo Collection</h2>
            <p class="mt-1 text-xs text-muted-foreground">Click any image to view in lightbox</p>
        </div>

        <div class="p-4">
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
                @foreach (var gi in _galleryImages)
                {
                    var image = gi;
                    var idx = System.Array.IndexOf(_galleryImages, image);
                    <button type="button"
                            class="group relative overflow-hidden rounded-md"
                            @onclick="@(() => _selectedIndex = idx)">
                        <img src="@image.Image"
                             alt="@image.Title"
                             class="aspect-square w-full object-cover transition-transform duration-300 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-black/0 transition-colors duration-300 group-hover:bg-black/20"></div>
                    </button>
                }
            </div>
        </div>
    </div>

    @if (_selectedIndex.HasValue)
    {
        var selIdx = _selectedIndex.Value;
        var selImage = _galleryImages[selIdx];
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/95 p-4"
             @onclick="@(() => _selectedIndex = null)">
            <div class="relative w-full max-w-4xl"
                 @onclick:stopPropagation="true">
                <div class="overflow-hidden rounded-lg bg-card">
                    <img src="@selImage.Image"
                         alt="@selImage.Title"
                         class="aspect-video w-full object-cover" />

                    <div class="border-t px-4 py-3">
                        <h3 class="text-sm font-medium">@selImage.Title</h3>
                        <div class="mt-1 flex items-center gap-3 text-xs text-muted-foreground">
                            <span>By @selImage.Photographer</span>
                            <span class="size-1 rounded-full bg-muted-foreground/30"></span>
                            <span>@selImage.Location</span>
                        </div>
                    </div>
                </div>

                <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                          Class="absolute right-0 top-0 -translate-y-12 text-white hover:bg-white/10 hover:text-white"
                          OnClick="@(() => _selectedIndex = null)">
                    <LucideIconCn Name="x" Size="20" Class="size-5" />
                </ButtonCn>

                <div class="mt-4 flex items-center justify-between">
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                              Class="gap-1 text-white hover:bg-white/10 hover:text-white"
                              OnClick="HandlePrevious">
                        <LucideIconCn Name="chevron-left" Size="16" Class="size-4" />
                        Previous
                    </ButtonCn>

                    <span class="text-xs text-white/80">
                        @(selIdx + 1) / @_galleryImages.Length
                    </span>

                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                              Class="gap-1 text-white hover:bg-white/10 hover:text-white"
                              OnClick="HandleNext">
                        Next
                        <LucideIconCn Name="chevron-right" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private record GalleryImage(string Id, string Title, string Photographer, string Location, string Image);

    private int? _selectedIndex = null;

    private static readonly GalleryImage[] _galleryImages =
    [
        new("1", "Alpine Reflection", "Sarah Chen", "Swiss Alps",
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&h=450&auto=format&fit=crop"),
        new("2", "Tokyo Street", "Kenji Tanaka", "Shibuya, Japan",
            "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=800&h=450&auto=format&fit=crop"),
        new("3", "Moroccan Sunset", "Aisha El-Amin", "Marrakech",
            "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&h=450&auto=format&fit=crop"),
        new("4", "Icelandic Coast", "Erik Johansson", "Reykjavik",
            "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800&h=450&auto=format&fit=crop"),
        new("5", "Parisian Cafe", "Marie Laurent", "Montmartre, Paris",
            "https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=800&h=450&auto=format&fit=crop"),
        new("6", "Australian Outback", "Jack Murphy", "Uluru",
            "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=800&h=450&auto=format&fit=crop"),
        new("7", "New York Skyline", "David Brooks", "Manhattan",
            "https://images.unsplash.com/photo-1431576901776-e539bd916ba2?w=800&h=450&auto=format&fit=crop"),
        new("8", "Bali Rice Terraces", "Putu Wijaya", "Ubud, Indonesia",
            "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&h=450&auto=format&fit=crop"),
    ];

    private void HandlePrevious()
    {
        if (!_selectedIndex.HasValue) return;
        _selectedIndex = _selectedIndex.Value == 0 ? _galleryImages.Length - 1 : _selectedIndex.Value - 1;
    }

    private void HandleNext()
    {
        if (!_selectedIndex.HasValue) return;
        _selectedIndex = _selectedIndex.Value == _galleryImages.Length - 1 ? 0 : _selectedIndex.Value + 1;
    }
}
