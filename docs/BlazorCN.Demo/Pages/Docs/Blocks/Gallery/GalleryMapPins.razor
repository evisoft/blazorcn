@* ============================================================
   Block: gallery-map-pins
   Title: GalleryMapPins
   Description: A location-based gallery with map markers and photo navigation, built with React, Next.js, shadcn/ui, Framer Motion, and Tailwind CSS
   Source: original/blocks/gallery/gallery-map-pins.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="map-pin" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Travel Gallery</h2>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">
                Click map pins to view photos from each location
            </p>
        </div>

        <div class="border-b bg-muted/30 p-6">
            <div class="relative mx-auto aspect-[2/1] w-full max-w-md rounded-md border bg-card/50">
                @foreach (var photo in _photos)
                {
                    var loc = photo;
                    <button
                        aria-label="@($"Show photos from {loc.Location}")" @onclick="@(() => SetActivePin(loc.Id))"
                        style="@($"left:{loc.PinPosition.X}%;top:{loc.PinPosition.Y}%")"
                        class="@Cn.Merge("absolute -translate-x-1/2 -translate-y-1/2 transition-transform hover:scale-110", _activePin == loc.Id ? "scale-125" : "")"
                        type="button">
                        <div class="@Cn.Merge("flex size-6 items-center justify-center rounded-full border-2 transition-colors", _activePin == loc.Id ? "border-foreground bg-foreground text-background" : "border-foreground/20 bg-background text-foreground/60")">
                            <LucideIconCn Name="map-pin" Size="14" Class="size-3.5" />
                        </div>
                    </button>
                }
            </div>
        </div>

        <div class="max-h-[400px] overflow-y-auto" tabindex="0" role="group" aria-label="Photo locations">
            @for (int i = 0; i < _photos.Length; i++)
            {
                var photo = _photos[i];
                var index = i;
                <div class="@Cn.Merge("border-b p-4 last:border-b-0", _activePin == photo.Id ? "bg-muted/50" : "")">
                    <div class="flex items-start gap-3">
                        <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted">
                            <span class="text-xs font-medium text-muted-foreground">@(index + 1)</span>
                        </div>
                        <div class="flex-1">
                            <div class="flex items-center gap-2">
                                <h3 class="text-sm font-medium">@photo.Location</h3>
                                <span class="text-xs text-muted-foreground">@photo.Country</span>
                            </div>
                            <img
                                src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=800&auto=format&fit=crop&h=500"
                                alt=""
                                class="mt-3 aspect-[16/10] overflow-hidden rounded-md object-cover" />
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">@_photos.Length locations</p>
        </div>
    </div>
</section>

@code {
    private record PinPosition(double X, double Y);
    private record LocationPhoto(string Id, string Location, string Country, PinPosition PinPosition);

    private string? _activePin = null;

    private void SetActivePin(string id)
    {
        _activePin = id;
    }

    private static readonly LocationPhoto[] _photos =
    [
        new("loc1", "Paris",    "France",    new(48, 35)),
        new("loc2", "Tokyo",    "Japan",     new(85, 42)),
        new("loc3", "New York", "USA",       new(22, 38)),
        new("loc4", "Sydney",   "Australia", new(88, 75)),
        new("loc5", "Dubai",    "UAE",       new(58, 50)),
        new("loc6", "London",   "UK",        new(46, 32)),
    ];
}
