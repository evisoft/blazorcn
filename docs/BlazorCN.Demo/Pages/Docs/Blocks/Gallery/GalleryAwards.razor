@* ============================================================
   Block: gallery-awards
   Title: GalleryAwards
   Description: An awards and recognition gallery component built with React, Next.js, shadcn/ui, and Tailwind CSS. Displays award badges in a grid with trophy icons, award names, years, and issuing organizations with gold accents for winners.
   Source: original/blocks/gallery/gallery-awards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Awards &amp; Recognition</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Celebrating excellence and innovation
            </p>
        </div>

        <div class="grid gap-3 p-4 sm:grid-cols-2">
            @foreach (var aw in _awards)
            {
                var award = aw;
                <div class="group relative overflow-hidden rounded-md border bg-card p-4 transition-colors hover:bg-muted/50">
                    @if (award.Featured)
                    {
                        <div class="absolute right-2 top-2">
                            <LucideIconCn Name="star" Size="12" Class="size-3 fill-amber-500 text-amber-500" />
                        </div>
                    }

                    <div class="flex items-start gap-3">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-md">
                            <img src="@award.Image" alt="@award.Name" class="h-full w-full object-cover" />
                            <div class="@Cn.Merge("absolute inset-0 flex items-center justify-center backdrop-blur-[1px]", award.Featured ? "bg-amber-500/20" : "bg-muted/20")">
                                @if (award.Featured)
                                {
                                    <LucideIconCn Name="trophy" Size="20" Class="size-5 text-amber-600 dark:text-amber-500" />
                                }
                                else
                                {
                                    <LucideIconCn Name="award" Size="20" Class="size-5 text-muted-foreground" />
                                }
                            </div>
                        </div>

                        <div class="min-w-0 flex-1">
                            <h3 class="font-medium text-sm">@award.Name</h3>
                            <p class="mt-0.5 text-muted-foreground text-xs">@award.Organization</p>
                            <div class="mt-2 flex items-center gap-2">
                                <span class="@Cn.Merge("inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-medium", award.Featured ? "bg-amber-500/10 text-amber-700 dark:text-amber-500" : "bg-muted text-muted-foreground")">
                                    @award.Year
                                </span>
                                <span class="text-muted-foreground text-[10px]">@award.Category</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-center text-muted-foreground text-xs">
                Recognized by leading industry organizations worldwide
            </p>
        </div>
    </div>
</section>

@code {
    private record AwardItem(string Id, string Name, string Year, string Organization, string Category, bool Featured, string Image);

    private static readonly AwardItem[] _awards =
    [
        new("1", "Product of the Year", "2025", "Tech Awards", "Innovation", true,
            "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=600&h=600&auto=format&fit=crop"),
        new("2", "Best Design", "2025", "Design Excellence", "UI/UX", true,
            "https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=600&h=600&auto=format&fit=crop"),
        new("3", "Customer Choice", "2024", "Industry Leader", "Service", false,
            "https://images.unsplash.com/photo-1481026469463-66327c86e544?w=600&h=600&auto=format&fit=crop"),
        new("4", "Innovation Award", "2024", "Tech Summit", "Technology", true,
            "https://images.unsplash.com/photo-1518770660439-4636190af475?w=600&h=600&auto=format&fit=crop"),
        new("5", "Best Startup", "2024", "Startup Awards", "Growth", false,
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=600&h=600&auto=format&fit=crop"),
        new("6", "Excellence in Service", "2023", "Service Council", "Support", false,
            "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=600&h=600&auto=format&fit=crop"),
    ];
}
