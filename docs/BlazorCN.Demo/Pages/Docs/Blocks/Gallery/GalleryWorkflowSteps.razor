@* ============================================================
   Block: gallery-workflow-steps
   Title: GalleryWorkflowSteps
   Description: A step-by-step visual workflow with screenshots, step numbers, and connecting lines built with React, Next.js, shadcn/ui, and Tailwind CSS. Perfect for onboarding guides and process documentation.
   Source: original/blocks/gallery/gallery-workflow-steps.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="font-medium text-sm">Getting Started Workflow</h2>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Complete setup in @_totalDuration minutes
                    </p>
                </div>
                <div class="flex items-center gap-2">
                    <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 text-[10px]">
                        <LucideIconCn Name="check-circle-2" Size="12" Class="size-3" />
                        <span>
                            @_completedSteps/@_steps.Length complete
                        </span>
                    </BadgeCn>
                </div>
            </div>
        </div>

        <div class="p-6">
            <div class="space-y-6">
                @foreach (var st in _steps)
                {
                    var step = st;
                    var index = System.Array.IndexOf(_steps, step);
                    <div class="relative">
                        @* Connector line *@
                        @if (index < _steps.Length - 1)
                        {
                            <div class="absolute left-[19px] top-[60px] h-[calc(100%+24px)] w-px bg-border"></div>
                        }

                        <div class="flex gap-4">
                            @* Step number *@
                            <div class="relative z-10 flex shrink-0 flex-col items-center">
                                <div class="@Cn.Merge("flex size-10 items-center justify-center rounded-full border-2", step.IsCompleted ? "border-emerald-500 bg-emerald-500/10" : "border-border bg-card")">
                                    @if (step.IsCompleted)
                                    {
                                        <LucideIconCn Name="check-circle-2" Size="20" Class="size-5 text-emerald-600" />
                                    }
                                    else
                                    {
                                        <span class="font-semibold text-sm">@step.StepNumber</span>
                                    }
                                </div>
                            </div>

                            @* Content *@
                            <div class="flex-1 pb-6">
                                <div class="mb-3 flex items-start justify-between gap-4">
                                    <div>
                                        <h3 class="mb-1 font-medium text-sm">@step.Title</h3>
                                        <p class="text-muted-foreground text-xs leading-relaxed">
                                            @step.Description
                                        </p>
                                    </div>
                                    <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                        <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                        <span>@step.Duration</span>
                                    </div>
                                </div>

                                @* Screenshot placeholder *@
                                <div class="overflow-hidden rounded-md border">
                                    <img src="https://images.unsplash.com/photo-1504868584819-f8e8b4b6d7e3?w=800&auto=format&fit=crop&h=450"
                                         alt=""
                                         class="aspect-video object-cover" />
                                </div>

                                @* Action button *@
                                @if (!step.IsCompleted && index == _completedSteps)
                                {
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-3 h-7 gap-1.5 text-xs">
                                        <span>Continue to this step</span>
                                        <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
                                    </ButtonCn>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">@_steps.Length steps in workflow</span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    View full guide
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record WorkflowStep(string Id, int StepNumber, string Title, string Description, string Duration, bool IsCompleted);

    private static readonly WorkflowStep[] _steps =
    [
        new("1", 1, "Create Your Account",
            "Sign up with your email or connect with Google. Set up your profile and preferences to personalize your experience.",
            "2 min", true),
        new("2", 2, "Configure Integration",
            "Connect your existing tools and services. Import your data and configure sync settings for seamless workflow integration.",
            "5 min", true),
        new("3", 3, "Set Up Your Workspace",
            "Create projects, invite team members, and organize your workspace. Customize settings to match your team's workflow.",
            "10 min", false),
        new("4", 4, "Import Existing Data",
            "Upload files, import from connected services, or migrate from other platforms. Our tool automatically organizes everything.",
            "3 min", false),
        new("5", 5, "Launch Your First Project",
            "Start working with your team. Collaborate in real-time, track progress, and achieve your goals with our powerful tools.",
            "1 min", false),
    ];

    private static readonly int _completedSteps = System.Array.FindAll(_steps, s => s.IsCompleted).Length;

    private static readonly int _totalDuration = System.Array.FindAll(_steps, _ => true)
        .Aggregate(0, (acc, s) => acc + int.Parse(s.Duration.Split(' ')[0]));
}
