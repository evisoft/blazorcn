@* ============================================================
   Block: gallery-stories
   Title: GalleryStories
   Description: A stories-style photo gallery with horizontal thumbnails and full-screen preview built with React, Next.js, shadcn/ui, Framer Motion, and Tailwind CSS. Features progress indicators and tap navigation.
   Source: original/blocks/gallery/gallery-stories.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Stories</h2>
            <p class="mt-1 text-muted-foreground text-xs">Tap to view story collections</p>
        </div>

        <div class="p-4">
            <div class="flex gap-3 overflow-x-auto pb-2">
                @foreach (var st in _stories)
                {
                    var story = st;
                    var idx = System.Array.IndexOf(_stories, story);
                    <button type="button"
                            @onclick="@(() => HandleStoryClick(idx))"
                            class="group shrink-0">
                        <div class="@Cn.Merge("size-16 overflow-hidden rounded-full border-2 transition-colors", _selectedStory == idx ? "border-muted-foreground" : "border-muted-foreground/30 group-hover:border-muted-foreground/60")">
                            <img src="@story.Items[0].Image"
                                 alt=""
                                 class="size-full object-cover" />
                        </div>
                        <p class="mt-1 truncate text-center text-xs" style="max-width:64px">@story.Title</p>
                    </button>
                }
            </div>

            @if (_activeStory != null)
            {
                var active = _activeStory;
                var totalItems = active.Items.Length;
                <div class="mt-4 overflow-hidden rounded-lg border bg-muted">
                    <div class="p-3">
                        <div class="mb-3 flex gap-1">
                            @for (int pi = 0; pi < active.Items.Length; pi++)
                            {
                                var progIdx = pi;
                                <div class="h-0.5 flex-1 overflow-hidden rounded-full bg-muted-foreground/20">
                                    <div class="h-full bg-foreground transition-all duration-300"
                                         style="@($"width:{(progIdx <= _currentItem ? 100 : 0)}%")">
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="mb-3 flex items-center justify-between">
                            <div>
                                <p class="font-medium text-sm">@active.Title</p>
                                <p class="text-muted-foreground text-xs">@(_currentItem + 1) of @totalItems</p>
                            </div>
                            <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                                      Class="size-6"
                                      OnClick="HandleClose" aria-label="Close">
                                <LucideIconCn Name="x" Size="16" Class="size-4" />
                            </ButtonCn>
                        </div>

                        <div class="relative">
                            <div class="aspect-[9/16] w-full overflow-hidden rounded-md bg-muted/50">
                                <img src="@active.Items[_currentItem].Image"
                                     alt="@active.Items[_currentItem].Caption"
                                     class="size-full object-cover" />
                                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent p-4">
                                    <p class="font-medium text-sm text-white">@active.Items[_currentItem].Caption</p>
                                </div>
                            </div>

                            <div class="mt-3 flex gap-2">
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                          OnClick="HandlePrev"
                                          Disabled="@(_selectedStory == 0 && _currentItem == 0)"
                                          Class="flex-1 gap-2">
                                    <LucideIconCn Name="chevron-left" Size="16" Class="size-4" />
                                    Previous
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                          OnClick="HandleNext"
                                          Disabled="@(_selectedStory == _stories.Length - 1 && _currentItem == totalItems - 1)"
                                          Class="flex-1 gap-2">
                                    Next
                                    <LucideIconCn Name="chevron-right" Size="16" Class="size-4" />
                                </ButtonCn>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record StoryItem(string Id, string Caption, string Image);
    private record Story(string Id, string Title, StoryItem[] Items);

    private int? _selectedStory = null;
    private int _currentItem = 0;

    private Story? _activeStory => _selectedStory.HasValue ? _stories[_selectedStory.Value] : null;

    private static readonly Story[] _stories =
    [
        new("story-1", "Summer 2025",
        [
            new("1-1", "Beach sunset",
                "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop"),
            new("1-2", "Ocean waves",
                "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&auto=format&fit=crop"),
            new("1-3", "Coastal walk",
                "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800&auto=format&fit=crop"),
        ]),
        new("story-2", "City Life",
        [
            new("2-1", "Downtown view",
                "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=800&auto=format&fit=crop"),
            new("2-2", "Street art",
                "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&auto=format&fit=crop"),
            new("2-3", "Night lights",
                "https://images.unsplash.com/photo-1518173946687-a544bf02a536?w=800&auto=format&fit=crop"),
        ]),
        new("story-3", "Nature",
        [
            new("3-1", "Mountain peak",
                "https://images.unsplash.com/photo-1475924156734-496f6cac6ec1?w=800&auto=format&fit=crop"),
            new("3-2", "Forest trail",
                "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=800&auto=format&fit=crop"),
        ]),
        new("story-4", "Travel",
        [
            new("4-1", "Airport terminal",
                "https://images.unsplash.com/photo-1472214103451-9374bd1c798e?w=800&auto=format&fit=crop"),
            new("4-2", "Destination",
                "https://images.unsplash.com/photo-1504567961542-e24d9439a724?w=800&auto=format&fit=crop"),
            new("4-3", "Local market",
                "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop"),
        ]),
    ];

    private void HandleStoryClick(int index)
    {
        _selectedStory = index;
        _currentItem = 0;
    }

    private void HandleNext()
    {
        if (_activeStory == null || !_selectedStory.HasValue) return;
        var totalItems = _activeStory.Items.Length;
        if (_currentItem < totalItems - 1)
        {
            _currentItem++;
        }
        else if (_selectedStory.Value < _stories.Length - 1)
        {
            _selectedStory = _selectedStory.Value + 1;
            _currentItem = 0;
        }
    }

    private void HandlePrev()
    {
        if (!_selectedStory.HasValue) return;
        if (_currentItem > 0)
        {
            _currentItem--;
        }
        else if (_selectedStory.Value > 0)
        {
            var prevStory = _stories[_selectedStory.Value - 1];
            _selectedStory = _selectedStory.Value - 1;
            _currentItem = prevStory.Items.Length - 1;
        }
    }

    private void HandleClose()
    {
        _selectedStory = null;
        _currentItem = 0;
    }
}
