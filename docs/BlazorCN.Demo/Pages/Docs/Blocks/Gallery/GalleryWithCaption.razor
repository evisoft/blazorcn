@* ============================================================
   Block: gallery-with-caption
   Title: GalleryWithCaption
   Description: A gallery grid where each image has a prominent caption below with title, photographer credit, and date in React with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/gallery/gallery-with-caption.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Photography Collection</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Featured work from our contributors
            </p>
        </div>

        <div class="p-4">
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                @foreach (var img in _galleryImages)
                {
                    var image = img;
                    var aspectClass = image.AspectRatio == "portrait"
                        ? "aspect-[3/4]"
                        : image.AspectRatio == "square"
                            ? "aspect-square"
                            : "aspect-[4/3]";
                    <div>
                        <img src="@image.Image"
                             alt="@image.Title"
                             class="@($"mb-3 overflow-hidden rounded-md object-cover {aspectClass}")" />
                        <div class="space-y-1">
                            <h3 class="text-sm font-medium">@image.Title</h3>
                            <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                <LucideIconCn Name="user" Size="12" Class="size-3" />
                                <span>@image.Photographer</span>
                            </div>
                            <p class="text-xs text-muted-foreground">@image.Date</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record GalleryImage(string Id, string Title, string Photographer, string Date, string AspectRatio, string Image);

    private static readonly GalleryImage[] _galleryImages =
    [
        new("1", "Golden Hour Architecture", "Sarah Mitchell", "March 15, 2026", "landscape",
