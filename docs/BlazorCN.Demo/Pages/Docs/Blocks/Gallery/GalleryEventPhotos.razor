@* ============================================================
   Block: gallery-event-photos
   Title: GalleryEventPhotos
   Description: An event photo gallery block with event header, date, attendee count, and downloadable images built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/gallery/gallery-event-photos.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">@_eventData.Name</h2>
            <div class="mt-1 flex items-center gap-4">
                <span class="text-xs text-muted-foreground">@_eventData.Date</span>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-xs text-muted-foreground">@_eventData.Attendees attendees</span>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-3 p-4">
            @foreach (var photo in _eventData.Photos)
            {
                var p = photo;
                <div class="space-y-2">
                    <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop&h=600"
                         alt=""
                         class="aspect-[4/3] overflow-hidden rounded-md object-cover" />
                    <div class="space-y-1">
                        <p class="text-xs leading-tight">@p.Caption</p>
                        <div class="flex items-center justify-between">
                            <span class="text-xs text-muted-foreground">by @p.Photographer</span>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2" OnClick="@((MouseEventArgs e) => Download(p.Id))">
                                <LucideIconCn Name="download" Size="12" Class="size-3" />
                                <span class="text-xs">Download</span>
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Photo(string Id, string Caption, string Photographer);

    private record EventData(string Name, string Date, int Attendees, Photo[] Photos);

    private void Download(string id)
    {
        // Download handler
    }

    private static readonly EventData _eventData = new(
        "Annual Tech Summit 2026",
        "March 15, 2026",
        450,
        [
            new("1", "Keynote presentation by Sarah Chen", "Mike Johnson"),
            new("2", "Networking session in the main hall", "Emily Davis"),
            new("3", "Workshop: Building scalable APIs", "Mike Johnson"),
            new("4", "Panel discussion on AI ethics", "Alex Kim"),
            new("5", "Team lunch and networking", "Emily Davis"),
            new("6", "Award ceremony for best project", "Mike Johnson"),
        ]
    );
}
