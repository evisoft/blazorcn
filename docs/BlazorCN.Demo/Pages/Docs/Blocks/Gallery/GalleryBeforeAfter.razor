@* ============================================================
   Block: gallery-before-after
   Title: GalleryBeforeAfter
   Description: A comparison gallery with interactive slider control built with React, Next.js, shadcn/ui, and Tailwind CSS. Drag to reveal before and after images with smooth transitions.
   Source: original/blocks/gallery/gallery-before-after.tsx
   ============================================================ *@

@inject IJSRuntime JS

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Before &amp; After</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Drag the slider to compare transformations
            </p>
        </div>

        <div class="p-4">
            <div class="space-y-4">
                @* Comparison Viewer *@
                <div
                    id="@_viewerId"
                    class="relative overflow-hidden rounded-lg border bg-muted"
                    @onmousemove="HandleMouseMove"
                    @onmouseup="HandleMouseUp"
                    @onmouseleave="HandleMouseUp">
                    <div class="relative aspect-video w-full select-none">
                        @* After Image (Background) *@
                        <img
                            src="@_selectedItem.AfterImage"
                            alt="@_selectedItem.AfterLabel"
                            class="absolute inset-0 size-full object-cover" />

                        @* Before Image (Clipped) *@
                        <img
                            src="@_selectedItem.BeforeImage"
                            alt="@_selectedItem.BeforeLabel"
                            class="absolute inset-0 size-full object-cover"
                            style="@($"clip-path:inset(0 {100 - _sliderPosition}% 0 0)")" />

                        @* Slider Control *@
                        <div
                            class="absolute inset-y-0 flex cursor-ew-resize items-center"
                            style="@($"left:{_sliderPosition}%")"
                            @onmousedown="HandleMouseDown">
                            <div class="relative">
                                <div class="h-full w-0.5 bg-foreground"></div>
                                <div class="absolute left-1/2 top-1/2 flex size-8 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-2 border-foreground bg-background shadow-lg">
                                    <LucideIconCn Name="chevron-left" Size="12" Class="absolute left-0.5 size-3" />
                                    <LucideIconCn Name="chevron-right" Size="12" Class="absolute right-0.5 size-3" />
                                </div>
                            </div>
                        </div>

                        @* Labels *@
                        <div class="absolute left-2 top-2 rounded bg-background/80 px-2 py-1 text-xs font-medium backdrop-blur-sm">
                            @_selectedItem.BeforeLabel
                        </div>
                        <div class="absolute right-2 top-2 rounded bg-background/80 px-2 py-1 text-xs font-medium backdrop-blur-sm">
                            @_selectedItem.AfterLabel
                        </div>
                    </div>
                </div>

                @* Comparison List *@
                <div class="space-y-1">
                    @foreach (var item in _comparisonItems)
                    {
                        var capturedItem = item;
                        var capturedIndex = Array.IndexOf(_comparisonItems, capturedItem);
                        var btnClass = _selectedIndex == capturedIndex
                            ? "flex w-full items-center gap-3 rounded-md px-3 py-2 text-left transition-colors bg-muted"
                            : "flex w-full items-center gap-3 rounded-md px-3 py-2 text-left transition-colors hover:bg-muted/50";
                        <button
                            type="button"
                            class="@btnClass"
                            @onclick="@(() => SelectItem(capturedIndex))">
                            <div class="flex size-12 shrink-0 items-center justify-center rounded border bg-background">
                                <LucideIconCn Name="image" Size="20" Class="size-5 text-muted-foreground/30" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-sm font-medium">@capturedItem.Title</p>
                                <p class="mt-0.5 text-xs text-muted-foreground">@capturedItem.Category</p>
                            </div>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record ComparisonItem(
        string Id,
        string Title,
        string Category,
        string BeforeLabel,
        string AfterLabel,
        string BeforeImage,
        string AfterImage);

    private static readonly ComparisonItem[] _comparisonItems =
    [
        new("1", "Website Redesign", "UI/UX", "Old Design", "New Design",
            "https://images.unsplash.com/photo-1431576901776-e539bd916ba2?w=800&auto=format&fit=crop",
            "https://images.unsplash.com/photo-1449157291145-7efd050a4d0e?w=800&auto=format&fit=crop"),
        new("2", "Photo Restoration", "Photography", "Original", "Restored",
            "https://images.unsplash.com/photo-1472214103451-9374bd1c798e?w=800&auto=format&fit=crop",
            "https://images.unsplash.com/photo-1504567961542-e24d9439a724?w=800&auto=format&fit=crop"),
        new("3", "Interior Renovation", "Architecture", "Before", "After",
            "https://images.unsplash.com/photo-1481026469463-66327c86e544?w=800&auto=format&fit=crop",
            "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=800&auto=format&fit=crop"),
        new("4", "Color Grading", "Post-Production", "Raw", "Graded",
            "https://images.unsplash.com/photo-1557672172-298e090bd0f1?w=800&auto=format&fit=crop",
            "https://images.unsplash.com/photo-1553356084-58ef4a67b2a7?w=800&auto=format&fit=crop"),
    ];

    private int _selectedIndex = 0;
    private double _sliderPosition = 50;
    private bool _isDragging = false;
    private readonly string _viewerId = "gallery-before-after-viewer";

    private ComparisonItem _selectedItem => _comparisonItems[_selectedIndex];

    private void SelectItem(int index)
    {
        _selectedIndex = index;
        _sliderPosition = 50;
    }

    private void HandleMouseDown(MouseEventArgs e)
    {
        _isDragging = true;
    }

    private void HandleMouseUp(MouseEventArgs e)
    {
        _isDragging = false;
    }

    private async Task HandleMouseMove(MouseEventArgs e)
    {
        if (!_isDragging) return;
        var rect = await JS.InvokeAsync<ViewerRect>(
            "eval",
            $"(function(){{var r=document.getElementById('{_viewerId}').getBoundingClientRect();return{{left:r.left,width:r.width}};}})()");
        if (rect.Width <= 0) return;
        var x = e.ClientX - rect.Left;
        var pct = (x / rect.Width) * 100.0;
        _sliderPosition = Math.Max(0, Math.Min(100, pct));
    }

    private sealed class ViewerRect
    {
        [System.Text.Json.Serialization.JsonPropertyName("left")]
        public double Left { get; init; }

        [System.Text.Json.Serialization.JsonPropertyName("width")]
        public double Width { get; init; }
    }
}
