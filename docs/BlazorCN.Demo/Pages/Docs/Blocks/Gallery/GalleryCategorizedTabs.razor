@* ============================================================
   Block: gallery-categorized-tabs
   Title: GalleryCategorizedTabs
   Description: A tab-based categorized gallery component for React and Next.js with vertical sidebar navigation, built with shadcn/ui and Tailwind CSS. Perfect for organizing large image collections by category.
   Source: original/blocks/gallery/gallery-categorized-tabs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Gallery by Category</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Browse images organized by theme</p>
        </div>

        <div class="flex min-h-[500px]">
            @* Vertical Tabs Sidebar *@
            <div class="w-40 shrink-0 border-r">
                <nav class="flex flex-col">
                    @foreach (var cat in _categories)
                    {
                        var category = cat;
                        var isActive = _activeCategory == category.Id;
                        <button type="button"
                                class="@Cn.Merge("relative flex items-center gap-3 border-b px-4 py-3 text-left transition-colors", isActive ? "bg-muted" : "hover:bg-muted/50")"
                                @onclick="@(() => _activeCategory = category.Id)">
                            @if (isActive)
                            {
                                <div class="absolute inset-y-0 left-0 w-0.5 bg-primary"></div>
                            }
                            <div class="@Cn.Merge("text-muted-foreground", isActive ? "text-foreground" : "")">
                                <LucideIconCn Name="@category.IconName" Size="16" Class="size-4" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="@Cn.Merge("font-medium text-xs", isActive ? "text-foreground" : "text-muted-foreground")">
                                    @category.Label
                                </div>
                                <div class="text-muted-foreground text-xs">@category.Images.Length</div>
                            </div>
                        </button>
                    }
                </nav>
            </div>

            @* Gallery Content *@
            <div class="flex-1 p-4">
                @{
                    var currentCategory = System.Array.Find(_categories, c => c.Id == _activeCategory);
                }
                @if (currentCategory != null)
                {
                    <div class="mb-4">
                        <h3 class="font-medium text-sm">@currentCategory.Label</h3>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            @currentCategory.Images.Length images in this category
                        </p>
                    </div>

                    <div class="grid grid-cols-3 gap-3">
                        @foreach (var img in currentCategory.Images)
                        {
                            var image = img;
                            <div class="group relative aspect-square overflow-hidden rounded-lg border transition-shadow hover:shadow-md">
                                <img src="@image.Image"
                                     alt="@image.Title"
                                     class="size-full object-cover transition-transform group-hover:scale-105" />
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">
                    @_totalImages total images
                </span>
                <span class="text-muted-foreground">@_categories.Length categories</span>
            </div>
        </div>
    </div>
</section>

@code {
