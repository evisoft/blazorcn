@* ============================================================
   Block: gallery-mixed-media
   Title: GalleryMixedMedia
   Description: A gallery mixing images, videos, and documents with type badges and filtering built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/gallery/gallery-mixed-media.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="font-medium text-sm">Mixed Media Gallery</h2>
                    <p class="mt-0.5 text-muted-foreground text-xs">@_filteredItems.Length items</p>
                </div>
                <DropdownMenuCn>
                    <DropdownMenuTriggerCn>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-2.5 text-xs">
                            <LucideIconCn Name="filter" Size="14" Class="size-3.5" />
                            Filter
                        </ButtonCn>
                    </DropdownMenuTriggerCn>
                    <DropdownMenuContentCn Align="FloatingAlign.End" Class="w-44">
                        @foreach (var tc in _typeConfigs)
                        {
                            var cfg = tc;
                            <DropdownMenuCheckboxItemCn
                                Checked="@_selectedTypes.Contains(cfg.Key)"
                                CheckedChanged="@((bool v) => ToggleType(cfg.Key, v))">
                                <span class="flex items-center gap-2">
                                    <LucideIconCn Name="@cfg.IconName" Size="14" Class="@($"size-3.5 {cfg.Color}")" />
                                    @cfg.Label (@_typeCounts[cfg.Key])
                                </span>
                            </DropdownMenuCheckboxItemCn>
                        }
                    </DropdownMenuContentCn>
                </DropdownMenuCn>
            </div>
        </div>

        <div class="border-b bg-muted/30 px-4 py-2.5">
            <div class="flex items-center gap-3">
                @foreach (var tc in _typeConfigs)
                {
                    var cfg = tc;
                    var isActive = _selectedTypes.Contains(cfg.Key);
                    <div class="@Cn.Merge("flex items-center gap-1.5 transition-opacity", isActive ? "opacity-100" : "opacity-40")">
                        <LucideIconCn Name="@cfg.IconName" Size="14" Class="@($"size-3.5 {cfg.Color}")" />
                        <span class="text-xs">
                            <span class="font-medium">@_typeCounts[cfg.Key]</span>
                            <span class="text-muted-foreground"> @cfg.Label.ToLowerInvariant()</span>
                        </span>
                    </div>
                }
            </div>
        </div>

        <div class="p-4">
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
                @foreach (var mi in _filteredItems)
                {
                    var item = mi;
                    var cfg = _typeConfigMap[item.Type];
                    <div class="group overflow-hidden rounded-md border bg-muted/50 transition-colors hover:border-foreground/20 hover:bg-muted">
                        <div class="relative aspect-square">
                            @if (item.Image != null)
                            {
                                <img src="@item.Image" alt="@item.Title" class="size-full object-cover" />
                            }
                            else
                            {
                                <div class="absolute inset-0 flex items-center justify-center bg-muted">
                                    <LucideIconCn Name="@cfg.IconName" Size="48" Class="@($"size-12 {cfg.Color}")" />
                                </div>
                            }
                            @if (item.Type == "video")
                            {
                                <div class="absolute inset-0 flex items-center justify-center">
                                    <div class="flex size-12 items-center justify-center rounded-full bg-black/50 transition-transform group-hover:scale-110">
                                        <LucideIconCn Name="play" Size="24" Class="size-6 fill-white text-white" />
                                    </div>
                                </div>
                            }
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"absolute top-2 right-2 gap-1 {cfg.BgColor}")">
                                <LucideIconCn Name="@cfg.IconName" Size="12" Class="@($"size-3 {cfg.Color}")" />
                            </BadgeCn>
                            @if (item.Duration != null)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="absolute right-2 bottom-2 bg-black/70">
                                    <span class="font-mono text-white text-xs">@item.Duration</span>
                                </BadgeCn>
                            }
                        </div>
                        <div class="border-t p-2">
                            <div class="flex items-start justify-between gap-2">
                                <div class="min-w-0 flex-1">
                                    <p class="truncate font-medium text-xs">@item.Title</p>
                                    <p class="text-muted-foreground text-xs">@item.Size</p>
                                </div>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 w-6 shrink-0 p-0">
                                    <LucideIconCn Name="download" Size="12" Class="size-3" />
                                </ButtonCn>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record MediaItem(string Id, string Title, string Type, string Size, string? Duration, string? Image);

    private record TypeConfig(string Key, string IconName, string Label, string Color, string BgColor);

    private static readonly TypeConfig[] _typeConfigs =
    [
        new("image",    "file-image", "Images",    "text-blue-500",   "bg-blue-500/10"),
        new("video",    "file-video", "Videos",    "text-purple-500", "bg-purple-500/10"),
        new("document", "file-text",  "Documents", "text-amber-500",  "bg-amber-500/10"),
    ];

    private static readonly Dictionary<string, TypeConfig> _typeConfigMap =
        _typeConfigs.ToDictionary(c => c.Key);

    private static readonly MediaItem[] _mediaItems =
    [
        new("1", "Product Hero",  "image",    "2.4 MB",  null,   "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=600&h=600&auto=format&fit=crop"),
        new("2", "Demo Video",    "video",    "15.8 MB", "2:34", "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=600&h=600&auto=format&fit=crop"),
        new("3", "Brand Guide",   "document", "1.2 MB",  null,   null),
        new("4", "Team Photo",    "image",    "3.1 MB",  null,   "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=600&h=600&auto=format&fit=crop"),
        new("5", "Tutorial",      "video",    "22.5 MB", "5:12", "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=600&h=600&auto=format&fit=crop"),
        new("6", "Presentation",  "document", "890 KB",  null,   null),
        new("7", "Logo Assets",   "image",    "1.8 MB",  null,   "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=600&h=600&auto=format&fit=crop"),
        new("8", "Testimonial",   "video",    "8.3 MB",  "1:45", "https://images.unsplash.com/photo-1518173946687-a544bf02a536?w=600&h=600&auto=format&fit=crop"),
        new("9", "Contract",      "document", "450 KB",  null,   null),
    ];

    private HashSet<string> _selectedTypes = ["image", "video", "document"];

    private MediaItem[] _filteredItems =>
        _mediaItems.Where(i => _selectedTypes.Contains(i.Type)).ToArray();

    private Dictionary<string, int> _typeCounts => new()
    {
        ["image"]    = _mediaItems.Count(i => i.Type == "image"),
        ["video"]    = _mediaItems.Count(i => i.Type == "video"),
        ["document"] = _mediaItems.Count(i => i.Type == "document"),
    };

    private void ToggleType(string type, bool include)
    {
        if (include)
            _selectedTypes.Add(type);
        else
            _selectedTypes.Remove(type);
    }
}
