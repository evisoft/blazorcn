@* ============================================================
   Block: gallery-real-estate
   Title: GalleryRealEstate
   Description: A real estate property showcase with hero images, floor plans, room thumbnails, and property details built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/gallery/gallery-real-estate.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-start justify-between gap-2">
                <div class="min-w-0 flex-1">
                    <h2 class="text-sm font-medium">@_selected.Address</h2>
                    <div class="mt-1 flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">@_selected.City</span>
                    </div>
                </div>
                <div class="text-right">
                    <div class="text-xl font-semibold tabular-nums">@_selected.Price</div>
                    <BadgeCn Variant="BadgeVariant.Outline" Class="mt-1 h-5 text-xs">@_selected.Type</BadgeCn>
                </div>
            </div>
        </div>

        <div class="p-4">
            <img
                src="https://images.unsplash.com/photo-1462826303086-329426d1aef5?w=800&auto=format&fit=crop&h=450"
                alt=""
                class="aspect-[16/9] overflow-hidden rounded-md object-cover" />

            <div class="mt-3 flex items-center gap-4 border-b pb-3">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="bed" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-sm font-medium">@_selected.Beds</span>
                    <span class="text-xs text-muted-foreground">beds</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="bath" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-sm font-medium">@_selected.Baths</span>
                    <span class="text-xs text-muted-foreground">baths</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="maximize" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-sm font-medium tabular-nums">@_selected.Sqft.ToString("N0")</span>
                    <span class="text-xs text-muted-foreground">sqft</span>
                </div>
            </div>

            <div class="mt-3 space-y-2">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium">Floor Plan</span>
                    <span class="text-xs text-muted-foreground">Click to enlarge</span>
                </div>
                <button type="button" class="aspect-[4/3] w-full overflow-hidden rounded-md bg-muted transition-opacity hover:opacity-80"></button>
            </div>

            <div class="mt-3 space-y-2">
                <span class="text-xs font-medium">Room Photos</span>
                <div class="grid grid-cols-4 gap-2">
                    @foreach (var rm in _selected.Rooms)
                    {
                        var room = rm;
                        <button type="button" class="group space-y-1">
                            <img
                                src="https://images.unsplash.com/photo-1516483638261-f4dbaf036963?w=600&auto=format&fit=crop&h=600"
                                alt=""
                                class="aspect-square overflow-hidden rounded-md transition-opacity group-hover:opacity-80 object-cover" />
                            <span class="block truncate text-xs text-muted-foreground">@room.Name</span>
                        </button>
                    }
                </div>
            </div>
        </div>

        @if (_properties.Length > 1)
        {
            <div class="border-t px-4 py-3">
                <span class="text-xs font-medium text-muted-foreground">Other Properties</span>
                <div class="mt-2 flex gap-2">
                    @foreach (var prop in _properties)
                    {
                        var p = prop;
                        <button
                            type="button"
                            @onclick="@(() => SelectProperty(p.Id))"
                            class="@Cn.Merge("flex-1 rounded-md border p-2 text-left transition-colors hover:bg-muted/50",
                                _selected.Id == p.Id ? "border-primary bg-muted/50" : "border-border")">
                            <div class="text-xs font-medium leading-tight">@p.Address</div>
                            <div class="mt-0.5 text-xs text-muted-foreground">@p.Price</div>
                        </button>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Room(string Id, string Name);

    private record Property(string Id, string Address, string City, string Price, int Beds, int Baths, int Sqft, string Type, Room[] Rooms);

    private static readonly Property[] _properties =
    [
        new("1", "1847 Oak Valley Drive", "San Francisco, CA", "$1,850,000", 4, 3, 2850, "Single Family",
        [
            new("r1", "Living Room"),
            new("r2", "Kitchen"),
            new("r3", "Master Bedroom"),
            new("r4", "Backyard"),
        ]),
        new("2", "432 Maple Street", "Austin, TX", "$675,000", 3, 2, 1920, "Townhouse",
        [
            new("r1", "Open Floor Plan"),
            new("r2", "Dining Area"),
            new("r3", "Bedrooms"),
            new("r4", "Patio"),
        ]),
    ];

    private Property _selected = _properties[0];

    private void SelectProperty(string id)
    {
        _selected = System.Array.Find(_properties, p => p.Id == id) ?? _properties[0];
    }
}
