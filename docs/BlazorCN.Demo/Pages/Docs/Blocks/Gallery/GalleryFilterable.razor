@* ============================================================
   Block: gallery-filterable
   Title: GalleryFilterable
   Description: An interactive filterable gallery built with React, Next.js, shadcn/ui, and Tailwind CSS featuring category tabs and animated transitions
   Source: original/blocks/gallery/gallery-filterable.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Art Collection</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Browse @_galleryItems.Length artworks across categories
            </p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex flex-wrap gap-2">
                @foreach (var cat in _categories)
                {
                    var category = cat;
                    var count = category == "All"
                        ? _galleryItems.Length
                        : _galleryItems.Count(item => item.Category == category);
                    <button type="button"
                            class="@Cn.Merge("rounded-md px-3 py-1.5 text-xs font-medium transition-colors", _activeCategory == category ? "bg-foreground text-background" : "bg-muted text-muted-foreground hover:bg-muted/80")"
                            @onclick="@(() => _activeCategory = category)">
                        @category
                        <span class="ml-1.5 opacity-60">(@count)</span>
                    </button>
                }
            </div>
        </div>

        <div class="p-4">
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
                @foreach (var gi in _filteredItems)
                {
                    var item = gi;
                    <div class="group relative overflow-hidden rounded-md">
                        <img src="@item.Image"
                             alt="@item.Title"
                             class="aspect-square w-full object-cover transition-transform duration-300 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                            <div class="absolute bottom-0 left-0 right-0 p-3">
                                <h3 class="text-xs font-medium text-white">@item.Title</h3>
                                <p class="mt-0.5 text-xs text-white/80">@item.Artist</p>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (_filteredItems.Length == 0)
            {
                <div class="flex flex-col items-center justify-center py-12">
                    <p class="mt-3 text-sm text-muted-foreground">No items in this category</p>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                Showing @_filteredItems.Length of @_galleryItems.Length items
            </p>
        </div>
    </div>
</section>

@code {
    private record GalleryItem(string Id, string Title, string Artist, string Category, string Image);

    private string _activeCategory = "All";

    private static readonly string[] _categories = ["All", "Nature", "Architecture", "Portrait", "Abstract"];

    private static readonly GalleryItem[] _galleryItems =
    [
        new("1", "Mountain Peak", "Alex Rivera", "Nature",
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop"),
        new("2", "Modern Building", "Sam Chen", "Architecture",
            "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=800&auto=format&fit=crop"),
        new("3", "Studio Portrait", "Maya Patel", "Portrait",
            "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&auto=format&fit=crop"),
        new("4", "Color Waves", "Jordan Kim", "Abstract",
            "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800&auto=format&fit=crop"),
        new("5", "Forest Stream", "Alex Rivera", "Nature",
            "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=800&auto=format&fit=crop"),
        new("6", "Glass Tower", "Sam Chen", "Architecture",
            "https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=800&auto=format&fit=crop"),
        new("7", "Outdoor Portrait", "Maya Patel", "Portrait",
            "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&auto=format&fit=crop"),
        new("8", "Geometric Forms", "Jordan Kim", "Abstract",
