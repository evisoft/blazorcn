@* ============================================================
   Block: gallery-dual-scroll
   Title: GalleryDualScroll
   Description: A parallax-style dual scrolling gallery component for React and Next.js with opposite-direction columns, built with shadcn/ui and Tailwind CSS. Creates dynamic visual depth with independent scroll directions.
   Source: original/blocks/gallery/gallery-dual-scroll.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="font-medium text-sm">Dual Scroll Gallery</h2>
                    <p class="mt-0.5 text-muted-foreground text-xs">Scroll to see parallax effect</p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-2.5 text-xs" OnClick="ToggleAnimation">
                    @if (_isAnimating)
                    {
                        <LucideIconCn Name="pause" Size="12" Class="size-3" />
                        <span>Pause</span>
                    }
                    else
                    {
                        <LucideIconCn Name="play" Size="12" Class="size-3" />
                        <span>Play</span>
                    }
                </ButtonCn>
            </div>
        </div>

        <div class="relative h-[600px] overflow-hidden">
            <div class="grid h-full grid-cols-2 gap-4 p-4">
                @* Left Column - Scrolls Down *@
                <div class="@Cn.Merge("space-y-4 transition-transform duration-700", _isAnimating ? "animate-scroll-down" : "")"
                     style="@(_isAnimating ? "" : "transform:translateY(0)")">
                    @foreach (var img in _leftColumnImages)
                    {
                        var image = img;
                        <div class="overflow-hidden rounded-lg border" style="@($"height:{image.Height}px")">
                            <img src="@image.Image" alt="@image.Alt" class="size-full object-cover" />
                        </div>
                    }
                </div>

                @* Right Column - Scrolls Up *@
                <div class="@Cn.Merge("space-y-4 transition-transform duration-700", _isAnimating ? "animate-scroll-up" : "")"
                     style="@(_isAnimating ? "" : "transform:translateY(0)")">
                    @foreach (var img in _rightColumnImages)
                    {
                        var image = img;
                        <div class="overflow-hidden rounded-lg border" style="@($"height:{image.Height}px")">
                            <img src="@image.Image" alt="@image.Alt" class="size-full object-cover" />
                        </div>
                    }
                </div>
            </div>

            @* Gradient Overlays *@
            <div class="pointer-events-none absolute inset-x-0 top-0 h-20 bg-gradient-to-b from-card to-transparent"></div>
            <div class="pointer-events-none absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-card to-transparent"></div>
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">@(_leftColumnImages.Length + _rightColumnImages.Length) images</span>
                <span class="text-muted-foreground">Scroll or use mouse wheel</span>
            </div>
        </div>
    </div>
</section>

@code {
