@* ============================================================
   Block: gallery-hexagonal
   Title: GalleryHexagonal
   Description: A unique honeycomb pattern gallery using CSS clip-path for hexagonal shapes with hover overlays built with React, Next.js, shadcn/ui, Tailwind CSS, and Framer Motion
   Source: original/blocks/gallery/gallery-hexagonal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Services Portfolio</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Hexagonal showcase grid</p>
        </div>

        <div class="p-6">
            @* Hexagonal grid *@
            <div class="relative mx-auto max-w-md">
                @* Row 1 *@
                <div class="flex justify-center gap-2">
                    @foreach (var idx in new[] { 0, 1 })
                    {
                        var item = _hexItems[idx];
                        <div class="group relative size-24 cursor-pointer transition-transform duration-300 hover:scale-105">
                            @* Hexagon shape with image *@
                            <div class="absolute inset-0"
                                 style="clip-path:polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%)">
                                <img src="@item.Image" alt="@item.Title" class="size-full object-cover" />
                            </div>

                            @* Hover overlay *@
                            <div class="absolute inset-0 bg-gradient-to-br from-black/60 to-black/40 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                                 style="clip-path:polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%)">
                            </div>

                            @* Content *@
                            <div class="absolute inset-0 flex flex-col items-center justify-center p-3 text-center">
                                <h3 class="font-medium text-foreground text-xs transition-colors duration-300 group-hover:text-white">
                                    @item.Title
                                </h3>
                                <div class="mt-1 flex flex-wrap justify-center gap-1 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                                    @foreach (var tag in item.Tags)
                                    {
                                        <span class="flex items-center gap-0.5 rounded-full bg-white/20 px-1.5 py-0.5 text-white text-xs backdrop-blur-sm">
                                            <LucideIconCn Name="tag" Size="10" Class="size-2.5" />
                                            @tag
                                        </span>
                                    }
                                </div>
                            </div>

                            @* Border effect *@
                            <div class="absolute inset-0 border-2 border-foreground/0 transition-colors duration-200 group-hover:border-white/40"
                                 style="clip-path:polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%)">
                            </div>
                        </div>
                    }
                </div>

                @* Row 2 *@
                <div class="-mt-6 flex justify-center gap-2">
                    @foreach (var idx in new[] { 2, 3, 4 })
                    {
                        var item = _hexItems[idx];
                        <div class="group relative size-24 cursor-pointer transition-transform duration-300 hover:scale-105">
                            <div class="absolute inset-0"
                                 style="clip-path:polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%)">
                                <img src="@item.Image" alt="@item.Title" class="size-full object-cover" />
                            </div>

                            <div class="absolute inset-0 bg-gradient-to-br from-black/60 to-black/40 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                                 style="clip-path:polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%)">
                            </div>

                            <div class="absolute inset-0 flex flex-col items-center justify-center p-3 text-center">
                                <h3 class="font-medium text-foreground text-xs transition-colors duration-300 group-hover:text-white">
                                    @item.Title
                                </h3>
                                <div class="mt-1 flex flex-wrap justify-center gap-1 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                                    @foreach (var tag in item.Tags)
                                    {
                                        <span class="flex items-center gap-0.5 rounded-full bg-white/20 px-1.5 py-0.5 text-white text-xs backdrop-blur-sm">
                                            <LucideIconCn Name="tag" Size="10" Class="size-2.5" />
                                            @tag
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="absolute inset-0 border-2 border-foreground/0 transition-colors duration-200 group-hover:border-white/40"
                                 style="clip-path:polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%)">
                            </div>
                        </div>
                    }
                </div>

                @* Row 3 *@
                <div class="-mt-6 flex justify-center gap-2">
                    @foreach (var idx in new[] { 5, 6 })
                    {
                        var item = _hexItems[idx];
                        <div class="group relative size-24 cursor-pointer transition-transform duration-300 hover:scale-105">
                            <div class="absolute inset-0"
                                 style="clip-path:polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%)">
                                <img src="@item.Image" alt="@item.Title" class="size-full object-cover" />
                            </div>

                            <div class="absolute inset-0 bg-gradient-to-br from-black/60 to-black/40 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                                 style="clip-path:polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%)">
                            </div>

                            <div class="absolute inset-0 flex flex-col items-center justify-center p-3 text-center">
                                <h3 class="font-medium text-foreground text-xs transition-colors duration-300 group-hover:text-white">
                                    @item.Title
                                </h3>
                                <div class="mt-1 flex flex-wrap justify-center gap-1 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                                    @foreach (var tag in item.Tags)
                                    {
                                        <span class="flex items-center gap-0.5 rounded-full bg-white/20 px-1.5 py-0.5 text-white text-xs backdrop-blur-sm">
                                            <LucideIconCn Name="tag" Size="10" Class="size-2.5" />
                                            @tag
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="absolute inset-0 border-2 border-foreground/0 transition-colors duration-200 group-hover:border-white/40"
                                 style="clip-path:polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%)">
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="flex items-center justify-between border-t px-4 py-3">
            <p class="text-muted-foreground text-xs">@_hexItems.Length services</p>
            <p class="text-muted-foreground text-xs">Geometric layout</p>
        </div>
    </div>
</section>

@code {
