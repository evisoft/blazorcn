    private static readonly HexItem[] _hexItems =
    [
        new("1", "Brand Identity",  ["Design", "Logo"],
            "from-blue-500/20 to-blue-600/20",
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=600&h=600&auto=format&fit=crop"),
        new("2", "Web Development", ["Code", "React"],
            "from-emerald-500/20 to-emerald-600/20",
            "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=600&h=600&auto=format&fit=crop"),
        new("3", "UI/UX Design",    ["Interface", "Mobile"],
            "from-purple-500/20 to-purple-600/20",
            "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=600&h=600&auto=format&fit=crop"),
        new("4", "Marketing",       ["Strategy", "Content"],
            "from-orange-500/20 to-orange-600/20",
            "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=600&h=600&auto=format&fit=crop"),
        new("5", "Photography",     ["Visual", "Portrait"],
            "from-pink-500/20 to-pink-600/20",
            "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=600&h=600&auto=format&fit=crop"),
        new("6", "Animation",       ["Motion", "3D"],
            "from-cyan-500/20 to-cyan-600/20",
            "https://images.unsplash.com/photo-1518173946687-a544bf02a536?w=600&h=600&auto=format&fit=crop"),
        new("7", "Illustration",    ["Art", "Vector"],
            "from-amber-500/20 to-amber-600/20",
            "https://images.unsplash.com/photo-1475924156734-496f6cac6ec1?w=600&h=600&auto=format&fit=crop"),
    ];
}
