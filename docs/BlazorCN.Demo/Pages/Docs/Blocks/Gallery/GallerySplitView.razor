@* ============================================================
   Block: gallery-split-view
   Title: GallerySplitView
   Description: A dual-pane gallery interface with list navigation and detail preview built with React, Next.js, shadcn/ui, Framer Motion, and Tailwind CSS. Features responsive layout and smooth transitions.
   Source: original/blocks/gallery/gallery-split-view.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Gallery Browser</h2>
            <p class="mt-1 text-xs text-muted-foreground">Select an item to view details</p>
        </div>

        <div class="grid gap-0 md:grid-cols-[280px_1fr]">
            <div class="border-b md:border-b-0 md:border-r">
                <div class="max-h-[500px] overflow-y-auto">
                    @foreach (var gi in _items)
                    {
                        var item = gi;
                        <button type="button"
                                class="@Cn.Merge("flex w-full items-center gap-3 border-b px-4 py-3 text-left transition-colors last:border-b-0 hover:bg-muted/50", _selectedId == item.Id ? "bg-muted" : "")"
                                @onclick="@(() => _selectedId = item.Id)">
                            <img src="@item.Image"
                                 alt=""
                                 class="size-12 shrink-0 overflow-hidden rounded border object-cover" />
                            <div class="min-w-0 flex-1">
                                <p class="truncate text-sm font-medium">@item.Title</p>
                                <p class="truncate text-xs text-muted-foreground">@item.Category</p>
                            </div>
                        </button>
                    }
                </div>
            </div>

            <div class="p-4">
                @{
                    var sel = _items.FirstOrDefault(i => i.Id == _selectedId) ?? _items[0];
                }
                <img src="@sel.Image"
                     alt="@sel.Title"
                     class="mb-4 aspect-video w-full overflow-hidden rounded-lg border object-cover" />

                <div class="space-y-3">
                    <div>
                        <h3 class="text-lg font-semibold">@sel.Title</h3>
                        <p class="mt-1 text-sm text-muted-foreground">@sel.Category</p>
                    </div>

                    <div class="flex items-center gap-4 text-xs text-muted-foreground">
                        <div class="flex items-center gap-1.5">
                            <LucideIconCn Name="calendar" Size="14" Class="size-3.5" />
                            <span>@sel.Date</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <LucideIconCn Name="tag" Size="14" Class="size-3.5" />
                            <span>@sel.Tags.Length tags</span>
                        </div>
                    </div>

                    <div class="flex flex-wrap gap-1.5">
                        @foreach (var tag in sel.Tags)
                        {
                            <span class="rounded bg-muted px-2 py-0.5 text-xs">@tag</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record GalleryItem(string Id, string Title, string Category, string Date, string[] Tags, string Image);

    private string _selectedId = "1";

    private static readonly GalleryItem[] _items =
    [
        new("1", "Mountain Sunrise", "Landscape", "2026-03-20", ["nature", "mountains", "sunrise"],
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&h=450&auto=format&fit=crop"),
        new("2", "Urban Portrait", "Portrait", "2026-03-18", ["people", "urban", "street"],
            "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=800&h=450&auto=format&fit=crop"),
        new("3", "Abstract Waves", "Abstract", "2026-03-15", ["abstract", "art", "waves"],
            "https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=800&h=450&auto=format&fit=crop"),
        new("4", "Forest Path", "Nature", "2026-03-12", ["nature", "forest", "trail"],
            "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=800&h=450&auto=format&fit=crop"),
        new("5", "City Lights", "Urban", "2026-03-10", ["city", "night", "lights"],
            "https://images.unsplash.com/photo-1481026469463-66327c86e544?w=800&h=450&auto=format&fit=crop"),
        new("6", "Ocean View", "Landscape", "2026-03-08", ["ocean", "beach", "water"],
            "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&h=450&auto=format&fit=crop"),
    ];
}
