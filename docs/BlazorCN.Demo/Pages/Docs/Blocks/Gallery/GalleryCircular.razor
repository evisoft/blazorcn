@* ============================================================
   Block: gallery-circular
   Title: GalleryCircular
   Description: A circular image gallery built with React, Next.js, shadcn/ui, and Tailwind CSS. Images are cropped to circles with hover effects and optional captions.
   Source: original/blocks/gallery/gallery-circular.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Team Directory</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                @(_items.Count(i => i.Status == "active")) members online
            </p>
        </div>

        @* Circular Grid *@
        <div class="grid grid-cols-3 gap-6 p-6">
            @foreach (var item in _items)
            {
                <div class="flex flex-col items-center">
                    @* Circular Image *@
                    <div class="group relative">
                        <div class="size-24 overflow-hidden rounded-full transition-all duration-300 group-hover:scale-110 group-hover:shadow-lg">
                            <img src="@item.Image" alt="@item.Name" class="h-full w-full object-cover" />
                        </div>

                        @* Status Indicator *@
                        <span class="@Cn.Merge("absolute bottom-1 right-1 size-3 rounded-full border-2 border-card", StatusColor(item.Status))"></span>

                        @* Hover Overlay *@
                        <div class="absolute inset-0 flex items-center justify-center rounded-full bg-black/0 transition-all duration-300 group-hover:bg-black/50">
                            <div class="flex gap-1 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                                <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7 bg-white/10 hover:bg-white/20">
                                    <LucideIconCn Name="mail" Size="12" Class="size-3 text-white" />
                                </ButtonCn>
                                <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7 bg-white/10 hover:bg-white/20">
                                    <LucideIconCn Name="linkedin" Size="12" Class="size-3 text-white" />
                                </ButtonCn>
                            </div>
                        </div>
                    </div>

                    @* Info *@
                    <div class="mt-3 text-center">
                        <h3 class="font-medium text-sm">@item.Name</h3>
                        <p class="mt-0.5 text-muted-foreground text-xs">@item.Role</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">@item.Department</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record CircularItem(string Id, string Name, string Role, string Department, string Status, string Image);

    private static string StatusColor(string status) => status switch
    {
        "active" => "bg-green-500",
        "away" => "bg-amber-500",
        _ => "bg-muted-foreground/40"
    };

    private static readonly CircularItem[] _items =
    [
        new("1", "Sarah Chen", "Product Designer", "Design", "active",
