@* ============================================================
   Block: gallery-ribbon
   Title: GalleryRibbon
   Description: A horizontal filmstrip gallery with sprocket decorations and retro film aesthetic featuring scrollable single-row layout built with React, Next.js, shadcn/ui, Tailwind CSS, and Framer Motion
   Source: original/blocks/gallery/gallery-ribbon.tsx
   ============================================================ *@

@inject IJSRuntime JS

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="film" Size="16" Class="size-4 text-muted-foreground" />
                <div class="flex-1">
                    <h2 class="font-medium text-sm">Film Roll Gallery</h2>
                    <p class="mt-0.5 text-muted-foreground text-xs">35mm filmstrip collection</p>
                </div>
            </div>
        </div>

        <div class="relative bg-zinc-900 p-4">
            @* Film sprocket holes - top *@
            <div class="absolute left-0 right-0 top-0 flex justify-around border-b border-zinc-800 bg-zinc-950 px-4 py-1">
                @foreach (var i in Enumerable.Range(0, 20))
                {
                    <div class="size-1.5 rounded-sm bg-zinc-800"></div>
                }
            </div>

            @* Scroll container *@
            <div id="@_scrollId"
                 class="scrollbar-hide flex gap-1 overflow-x-auto px-8 py-6" tabindex="0" role="group" aria-label="Film ribbon">
                @foreach (var frame in _frames)
                {
                    var fr = frame;
                    <div class="group relative shrink-0">
                        @* Frame border *@
                        <div class="relative h-48 w-64 border-2 border-zinc-700 bg-zinc-800 p-2">
                            @* Image area *@
                            <div class="relative h-full w-full overflow-hidden">
                                <img src="@fr.Image" alt="@fr.Title" class="size-full object-cover" />
                                @* Hover overlay *@
                                <div class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/90 to-transparent p-3 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                                    <h3 class="font-medium text-white text-sm">@fr.Title</h3>
                                    <p class="mt-0.5 text-white/70 text-xs">@fr.Location</p>
                                </div>
                            </div>

                            @* Frame number *@
                            <div class="absolute bottom-1 right-1 rounded bg-black/60 px-1.5 py-0.5 font-mono text-amber-500 text-xs backdrop-blur-sm">
                                @fr.FrameNumber
                            </div>
                        </div>

                        @* Sprocket holes on sides *@
                        <div class="absolute -left-3 top-0 flex h-full flex-col justify-around">
                            @foreach (var j in Enumerable.Range(0, 8))
                            {
                                <div class="size-2 rounded-sm bg-zinc-950"></div>
                            }
                        </div>
                        <div class="absolute -right-3 top-0 flex h-full flex-col justify-around">
                            @foreach (var k in Enumerable.Range(0, 8))
                            {
                                <div class="size-2 rounded-sm bg-zinc-950"></div>
                            }
                        </div>
                    </div>
                }
            </div>

            @* Film sprocket holes - bottom *@
            <div class="absolute bottom-0 left-0 right-0 flex justify-around border-t border-zinc-800 bg-zinc-950 px-4 py-1">
                @foreach (var i in Enumerable.Range(0, 20))
                {
                    <div class="size-1.5 rounded-sm bg-zinc-800"></div>
                }
            </div>

            @* Navigation buttons *@
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                      Class="absolute left-2 top-1/2 -translate-y-1/2 bg-zinc-950/80 text-white backdrop-blur-sm hover:bg-zinc-900 hover:text-white"
                      @onclick="ScrollLeft" aria-label="Previous">
                <LucideIconCn Name="chevron-left" Size="16" Class="size-4" />
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                      Class="absolute right-2 top-1/2 -translate-y-1/2 bg-zinc-950/80 text-white backdrop-blur-sm hover:bg-zinc-900 hover:text-white"
                      @onclick="ScrollRight" aria-label="Next">
                <LucideIconCn Name="chevron-right" Size="16" Class="size-4" />
            </ButtonCn>
        </div>

        <div class="flex items-center justify-between border-t px-4 py-3">
            <p class="text-muted-foreground text-xs">@_frames.Length frames</p>
            <p class="font-mono text-muted-foreground text-xs">35MM-001-008</p>
        </div>
    </div>
</section>

@code {
    private record FilmFrame(string Id, string Title, string Location, string FrameNumber, string Image);

    private readonly string _scrollId = "ribbon-scroll-" + Guid.NewGuid().ToString("N");

    private static readonly FilmFrame[] _frames =
    [
        new("1", "Urban Sunset",   "New York",   "001", "https://images.unsplash.com/photo-1504567961542-e24d9439a724?w=800&auto=format&fit=crop"),
        new("2", "Street Corner",  "Tokyo",      "002", "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=800&auto=format&fit=crop"),
        new("3", "Market Scene",   "Barcelona",  "003", "https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=800&auto=format&fit=crop"),
        new("4", "Coastal View",   "Sydney",     "004", "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop"),
        new("5", "Mountain Peak",  "Colorado",   "005", "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&auto=format&fit=crop"),
        new("6", "City Lights",    "Paris",      "006", "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800&auto=format&fit=crop"),
        new("7", "Desert Road",    "Arizona",    "007", "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=800&auto=format&fit=crop"),
        new("8", "Forest Path",    "Oregon",     "008", "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&auto=format&fit=crop"),
    ];

    private async Task ScrollLeft() => await ScrollRibbon(-280);
    private async Task ScrollRight() => await ScrollRibbon(280);

    private async Task ScrollRibbon(int scrollAmount)
    {
        await JS.InvokeVoidAsync("eval",
            $"(function(){{var el=document.getElementById('{_scrollId}');if(el)el.scrollBy({{left:{scrollAmount},behavior:'smooth'}});}})()");
    }
}
