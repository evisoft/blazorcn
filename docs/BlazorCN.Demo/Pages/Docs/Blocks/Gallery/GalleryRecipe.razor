@* ============================================================
   Block: gallery-recipe
   Title: GalleryRecipe
   Description: A recipe and food gallery with dish photos, prep time, difficulty badges, and ingredient previews built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/gallery/gallery-recipe.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Featured Recipes</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Curated collection of delicious dishes
            </p>
        </div>

        <div class="grid grid-cols-2 gap-3 p-4">
            @foreach (var rec in _recipes)
            {
                var recipe = rec;
                var isHovered = _hoveredId == recipe.Id;
                <div class="group cursor-pointer"
                     @onmouseenter="@(() => _hoveredId = recipe.Id)"
                     @onmouseleave="@(() => _hoveredId = null)">
                    <div class="relative overflow-hidden rounded-md">
                        <img src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=600&auto=format&fit=crop&h=600"
                             alt=""
                             class="aspect-square transition-transform duration-300 group-hover:scale-105 object-cover" />
                        <div class="@Cn.Merge("absolute inset-0 bg-black/60 p-3 transition-opacity duration-200", isHovered ? "opacity-100" : "opacity-0")">
                            <div class="flex h-full flex-col justify-end">
                                <span class="mb-1 text-xs font-medium text-white">Ingredients:</span>
                                <ul class="space-y-0.5">
                                    @foreach (var ing in recipe.Ingredients.Take(4))
                                    {
                                        <li class="text-xs text-white/90">• @ing</li>
                                    }
                                    @if (recipe.Ingredients.Length > 4)
                                    {
                                        <li class="text-xs text-white/70">+@(recipe.Ingredients.Length - 4) more</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="mt-2 space-y-1.5">
                        <div class="flex items-start justify-between gap-1">
                            <h3 class="text-sm font-medium leading-tight">@recipe.Name</h3>
                            <BadgeCn Variant="BadgeVariant.Outline" Class="shrink-0 h-5 text-xs">
                                @recipe.Category
                            </BadgeCn>
                        </div>

                        <div class="flex items-center gap-2">
                            <div class="flex items-center gap-1">
                                <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                                <span class="text-xs text-muted-foreground">@recipe.PrepTime</span>
                            </div>
                            <div class="size-1 rounded-full bg-muted-foreground/30"></div>
                            <div class="flex items-center gap-1">
                                <LucideIconCn Name="chef-hat" Size="12" Class="size-3 text-muted-foreground" />
                                <span class="text-xs text-muted-foreground">@recipe.Servings servings</span>
                            </div>
                        </div>

                        <BadgeCn Variant="BadgeVariant.Outline" Class="@($"h-5 text-xs {DifficultyColor(recipe.Difficulty)}")">
                            @recipe.Difficulty
                        </BadgeCn>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Recipe(
        string Id,
        string Name,
        string PrepTime,
        string Difficulty,
        int Servings,
        string[] Ingredients,
        string Category
    );

    private string? _hoveredId = null;

    private static string DifficultyColor(string difficulty) => difficulty switch
    {
        "Easy"   => "text-emerald-600 border-emerald-200 bg-emerald-50",
        "Medium" => "text-amber-600 border-amber-200 bg-amber-50",
        "Hard"   => "text-red-600 border-red-200 bg-red-50",
        _        => ""
    };

    private static readonly Recipe[] _recipes =
    [
        new("1", "Mediterranean Quinoa Bowl", "25 min", "Easy", 4,
            ["1 cup quinoa", "Cherry tomatoes", "Cucumber", "Feta cheese", "Olive oil", "Lemon juice"],
            "Healthy"),
        new("2", "Spicy Thai Basil Chicken", "35 min", "Medium", 2,
            ["Chicken breast", "Thai basil", "Garlic", "Chilies", "Fish sauce", "Oyster sauce"],
            "Asian"),
        new("3", "Classic French Ratatouille", "50 min", "Medium", 6,
            ["Eggplant", "Zucchini", "Bell peppers", "Tomatoes", "Herbs de Provence", "Garlic"],
            "French"),
        new("4", "Homemade Margherita Pizza", "45 min", "Hard", 4,
            ["Pizza dough", "San Marzano tomatoes", "Fresh mozzarella", "Basil", "Olive oil", "Sea salt"],
            "Italian"),
        new("5", "Chocolate Lava Cake", "30 min", "Medium", 4,
            ["Dark chocolate", "Butter", "Eggs", "Sugar", "Flour", "Vanilla extract"],
            "Dessert"),
        new("6", "Avocado Toast Deluxe", "10 min", "Easy", 2,
            ["Sourdough bread", "Ripe avocado", "Cherry tomatoes", "Feta cheese", "Red pepper flakes", "Lemon"],
            "Breakfast"),
    ];
}
