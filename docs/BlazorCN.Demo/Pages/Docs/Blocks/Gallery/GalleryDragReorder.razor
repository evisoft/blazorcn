@* ============================================================
   Block: gallery-drag-reorder
   Title: GalleryDragReorder
   Description: A reorderable photo gallery with drag-and-drop functionality built with React, Next.js, shadcn/ui, Framer Motion, and Tailwind CSS. Features smooth layout animations and visual drag handles.
   Source: original/blocks/gallery/gallery-drag-reorder.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Organize Gallery</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                Drag items to reorder your collection
            </p>
        </div>

        <div class="p-4">
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
                @foreach (var it in _items)
                {
                    var item = it;
                    <div class="group relative cursor-grab overflow-hidden rounded-md border bg-muted transition-shadow hover:shadow-md active:cursor-grabbing">
                        <div class="aspect-square w-full">
                            <img src="@item.Image" alt="@item.Title" class="size-full object-cover" />
                        </div>
                        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-2">
                            <p class="font-medium text-white text-xs">@item.Title</p>
                            <p class="text-white/80 text-xs">@item.Category</p>
                        </div>
                        <div class="absolute right-1 top-1 rounded bg-black/50 p-1 opacity-0 transition-opacity group-hover:opacity-100">
                            <LucideIconCn Name="grip-vertical" Size="16" Class="size-4 text-white" />
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-t bg-muted/50 px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="grip-vertical" Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-muted-foreground text-xs">Drag handles appear on hover</p>
            </div>
        </div>
    </div>
</section>

@code {
    private record GalleryItem(string Id, string Title, string Category, string Image);

    private GalleryItem[] _items =
    [
        new("1", "Mountain Sunrise", "Landscape",
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=600&h=600&auto=format&fit=crop"),
        new("2", "Urban Portrait", "Portrait",
