@* ============================================================
   Block: gallery-floor-plan
   Title: GalleryFloorPlan
   Description: An architectural floor plan gallery built with React, Next.js, shadcn/ui, and Tailwind CSS. Features room layout previews with labels, dimensions, and unit selection for property development and real estate applications.
   Source: original/blocks/gallery/gallery-floor-plan.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Available Floor Plans</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Select a unit to view details</p>
        </div>

        <div class="grid gap-3 p-4 sm:grid-cols-2">
            @foreach (var fp in _floorPlans)
            {
                var plan = fp;
                var isSelected = _selectedId == plan.Id;
                <button type="button"
                        @onclick="@(() => SelectPlan(plan.Id))"
                        disabled="@(!plan.Available)"
                        class="@Cn.Merge("group relative overflow-hidden rounded-lg border-2 text-left transition-all",
                            isSelected ? "border-foreground bg-muted/50" : "border-border bg-card hover:border-muted-foreground/50 hover:bg-muted/50",
                            !plan.Available ? "opacity-60" : "")">
                    @if (isSelected)
                    {
                        <div class="absolute right-2 top-2 z-10 flex size-5 items-center justify-center rounded-full bg-foreground">
                            <LucideIconCn Name="check" Size="12" Class="size-3 text-background" />
                        </div>
                    }

                    @if (!plan.Available)
                    {
                        <div class="absolute right-2 top-2 z-10 rounded-full bg-muted px-2 py-0.5 text-[10px] text-muted-foreground">
                            Unavailable
                        </div>
                    }

                    <div class="aspect-[4/3] border-b">
                        <img src="@plan.Image" alt="@plan.Name" class="aspect-[4/3] w-full object-cover" />
                    </div>

                    <div class="p-3">
                        <div class="flex items-start justify-between gap-2">
                            <div class="min-w-0 flex-1">
                                <h3 class="font-medium text-sm">@plan.Name</h3>
                                <p class="mt-0.5 text-muted-foreground text-xs">@plan.Type</p>
                            </div>
                            <div class="flex shrink-0 items-center gap-1 text-muted-foreground">
                                <LucideIconCn Name="maximize-2" Size="12" Class="size-3" />
                                <span class="text-xs">@plan.Sqft sqft</span>
                            </div>
                        </div>

                        <div class="mt-2 flex items-center gap-3 text-muted-foreground text-xs">
                            <span>@(plan.Bedrooms == 0 ? "Studio" : $"{plan.Bedrooms} bed")</span>
                            <span class="size-1 rounded-full bg-border"></span>
                            <span>@plan.Bathrooms bath</span>
                        </div>
                    </div>
                </button>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-center text-muted-foreground text-xs">
                @_floorPlans.Count(p => p.Available) units currently available
            </p>
        </div>
    </div>
</section>

@code {
    private record FloorPlan(string Id, string Name, string Type, int Bedrooms, int Bathrooms, int Sqft, bool Available, string Image);

    private string? _selectedId = null;

    private void SelectPlan(string id)
    {
        _selectedId = id;
    }

    private static readonly FloorPlan[] _floorPlans =
    [
        new("1", "Unit A1", "Studio", 0, 1, 550, true,
            "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=800&auto=format&fit=crop"),
        new("2", "Unit B2", "One Bedroom", 1, 1, 750, true,
            "https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=800&auto=format&fit=crop"),
        new("3", "Unit C3", "Two Bedroom", 2, 2, 1100, true,
            "https://images.unsplash.com/photo-1481026469463-66327c86e544?w=800&auto=format&fit=crop"),
        new("4", "Unit D4", "Three Bedroom", 3, 2, 1450, false,
            "https://images.unsplash.com/photo-1431576901776-e539bd916ba2?w=800&auto=format&fit=crop"),
        new("5", "Unit E5", "Penthouse", 3, 3, 2200, true,
            "https://images.unsplash.com/photo-1449157291145-7efd050a4d0e?w=800&auto=format&fit=crop"),
    ];
}
