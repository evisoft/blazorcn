@* ============================================================
   Block: gallery-sortable
   Title: GallerySortable
   Description: A sortable image gallery built with React, Next.js, shadcn/ui, and Tailwind CSS. Features dropdown sorting by newest, oldest, most liked, and alphabetical order with smooth layout animations.
   Source: original/blocks/gallery/gallery-sortable.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="text-sm font-medium">Photo Gallery</h2>
                <p class="mt-0.5 text-xs text-muted-foreground">@_sortedImages.Length images</p>
            </div>
            <SelectCn Value="@_sortBy" ValueChanged="@((string v) => SetSortBy(v))">
                <SelectTriggerCn Class="h-8 w-[140px] text-xs" aria-label="sort images">
                    <LucideIconCn Name="arrow-up-down" Size="12" Class="mr-1.5 size-3" />
                    <SelectValueCn Placeholder="Sort" />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value="newest">Newest First</SelectItemCn>
                    <SelectItemCn Value="oldest">Oldest First</SelectItemCn>
                    <SelectItemCn Value="likes">Most Liked</SelectItemCn>
                    <SelectItemCn Value="alphabetical">A-Z</SelectItemCn>
                </SelectContentCn>
            </SelectCn>
        </div>

        <div class="border-b bg-muted/30 px-4 py-2">
            <p class="text-xs text-muted-foreground">
                Sorted by: <span class="font-medium">@GetSortLabel()</span>
            </p>
        </div>

        <div class="grid grid-cols-2 gap-3 p-4">
            @foreach (var gi in _sortedImages)
            {
                var image = gi;
                <div class="group relative overflow-hidden rounded-md border bg-muted">
                    <img src="@image.Image"
                         alt="@image.Title"
                         class="aspect-square w-full object-cover" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/0 to-transparent opacity-0 transition-opacity group-hover:opacity-100"></div>
                    <div class="absolute inset-x-0 bottom-0 translate-y-2 p-3 opacity-0 transition-all group-hover:translate-y-0 group-hover:opacity-100">
                        <h3 class="text-sm font-medium text-white">@image.Title</h3>
                        <div class="mt-1 flex items-center gap-3 text-xs text-white/80">
                            <span>@image.Date</span>
                            <span class="flex items-center gap-1">
                                <LucideIconCn Name="heart" Size="12" Class="size-3" />
                                @image.Likes
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record GalleryImage(string Id, string Title, string Date, int Likes, long Timestamp, string Image);

    private string _sortBy = "newest";

    private static readonly GalleryImage[] _galleryImages =
    [
        new("img-1", "Mountain Sunrise", "2026-03-20", 234, 1742428800000L,
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=600&h=600&auto=format&fit=crop"),
        new("img-2", "Ocean Waves", "2026-03-18", 456, 1742256000000L,
            "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=600&h=600&auto=format&fit=crop"),
        new("img-3", "Forest Path", "2026-03-22", 189, 1742601600000L,
            "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=600&h=600&auto=format&fit=crop"),
        new("img-4", "Desert Dunes", "2026-03-15", 312, 1741996800000L,
            "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=600&h=600&auto=format&fit=crop"),
        new("img-5", "City Lights", "2026-03-24", 567, 1742774400000L,
            "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=600&h=600&auto=format&fit=crop"),
        new("img-6", "Aurora Borealis", "2026-03-19", 891, 1742342400000L,
            "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=600&h=600&auto=format&fit=crop"),
    ];

    private GalleryImage[] _sortedImages => _sortBy switch
    {
        "newest"       => _galleryImages.OrderByDescending(x => x.Timestamp).ToArray(),
        "oldest"       => _galleryImages.OrderBy(x => x.Timestamp).ToArray(),
        "likes"        => _galleryImages.OrderByDescending(x => x.Likes).ToArray(),
        "alphabetical" => _galleryImages.OrderBy(x => x.Title).ToArray(),
        _              => _galleryImages,
    };

    private void SetSortBy(string value) => _sortBy = value;

    private string GetSortLabel() => _sortBy switch
    {
        "newest"       => "Newest First",
        "oldest"       => "Oldest First",
        "likes"        => "Most Liked",
        "alphabetical" => "A-Z",
        _              => "Sort",
    };
}
