@* ============================================================
   Block: gallery-multi-select
   Title: GalleryMultiSelect
   Description: A photo gallery with multi-select checkboxes for bulk actions, built with React, Next.js, shadcn/ui, and Tailwind CSS. Select multiple images to download, delete, or share.
   Source: original/blocks/gallery/gallery-multi-select.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Photo Gallery</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Select multiple images for bulk actions
            </p>
        </div>

        <div class="p-4">
            <div class="grid grid-cols-3 gap-3">
                @foreach (var img in _galleryImages)
                {
                    var image = img;
                    var isSelected = _selectedIds.Contains(image.Id);
                    var isHovered = _hoveredId == image.Id;
                    @* The tile used to carry its own @onclick="ToggleSelection" on top of the
                       checkbox's CheckedChanged. Clicking the checkbox toggled once, then the
                       click bubbled to the tile and toggled back — the control was dead. The tile
                       is now a <label for> pointing at the checkbox, so clicking anywhere in it
                       activates the one control exactly once. *@
                    <label for="@($"gallery-multi-select-{image.Id}")"
                           class="relative aspect-square cursor-pointer overflow-hidden rounded-md bg-muted"
                           @onmouseenter="@(() => _hoveredId = image.Id)"
                           @onmouseleave="@(() => _hoveredId = null)">
                        <img src="@image.Image" alt="@image.Title" class="size-full object-cover" />

                        @* Checkbox overlay *@
                        @if (isHovered || isSelected)
                        {
                            <div class="absolute inset-0 bg-black/20">
                                <div class="absolute right-2 top-2">
                                    <CheckboxCn id="@($"gallery-multi-select-{image.Id}")"
                                                Checked="@isSelected"
                                                aria-label="@($"Select {image.Title}")"
                                                Class="size-5 border-2 border-white bg-white data-[state=checked]:bg-primary data-[state=checked]:border-primary"
                                                CheckedChanged="@((bool _) => ToggleSelection(image.Id))" />
                                </div>
                            </div>
                        }

                        @* Image info *@
                        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent p-2">
                            <p class="truncate text-xs text-white">@image.Title</p>
                        </div>
                    </label>
                }
            </div>
        </div>

        @* Bulk actions toolbar *@
        @if (_selectedCount > 0)
        {
            <div class="border-t bg-muted/50 px-4 py-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-medium">@_selectedCount selected</span>
                        <ButtonCn Variant="ButtonVariant.Ghost"
                                  Size="ButtonSize.Sm"
                                  Class="h-7 gap-1 px-2 text-xs"
                                  OnClick="ClearSelection">
                            <LucideIconCn Name="x" Size="12" Class="size-3" />
                            Clear
                        </ButtonCn>
                    </div>

                    <div class="flex items-center gap-2">
                        <ButtonCn Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Sm"
                                  Class="h-7 gap-1.5 px-3 text-xs"
                                  OnClick="@(() => HandleBulkAction("download"))">
                            <LucideIconCn Name="download" Size="12" Class="size-3" />
                            Download
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Sm"
                                  Class="h-7 gap-1.5 px-3 text-xs"
                                  OnClick="@(() => HandleBulkAction("share"))">
                            <LucideIconCn Name="share-2" Size="12" Class="size-3" />
                            Share
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Sm"
                                  Class="h-7 gap-1.5 px-3 text-xs text-red-600 hover:text-red-700"
                                  OnClick="@(() => HandleBulkAction("delete"))">
                            <LucideIconCn Name="trash" Size="12" Class="size-3" />
                            Delete
                        </ButtonCn>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record GalleryImage(string Id, string Title, string Category, string Image);

    private HashSet<string> _selectedIds = [];
    private string? _hoveredId = null;

    private int _selectedCount => _selectedIds.Count;

    private void ToggleSelection(string id)
    {
        if (_selectedIds.Contains(id))
            _selectedIds.Remove(id);
        else
            _selectedIds.Add(id);
    }

    private void ClearSelection()
    {
        _selectedIds.Clear();
    }

    private void HandleBulkAction(string action)
    {
        // action: download / share / delete
    }

    private static readonly GalleryImage[] _galleryImages =
    [
