@* ============================================================
   Block: gallery-grid-minimal
   Title: GalleryGridMinimal
   Description: A clean minimal grid gallery built with React, Next.js, shadcn/ui, and Tailwind CSS featuring hover zoom effects and load more functionality
   Source: original/blocks/gallery/gallery-grid-minimal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Photography Portfolio</h2>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Explore @_allImages.Length curated images
                    </p>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                    @_visibleCount of @_allImages.Length
                </BadgeCn>
            </div>
        </div>

        <div class="p-4">
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
                @foreach (var img in _visibleImages)
                {
                    var image = img;
                    <div class="group relative overflow-hidden rounded-md">
                        <img src="@image.Image"
                             alt="@image.Title"
                             class="aspect-square w-full object-cover transition-transform duration-500 ease-out group-hover:scale-110" />
                        <div class="absolute inset-0 bg-black/0 transition-colors duration-300 group-hover:bg-black/10"></div>
                        <div class="absolute left-2 top-2 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                            <span class="rounded-md bg-white/90 px-2 py-1 text-xs font-medium text-foreground backdrop-blur-sm">
                                @image.Category
                            </span>
                        </div>
                        <div class="absolute bottom-2 right-2 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                            <span class="rounded-md bg-black/80 px-2 py-1 text-xs text-white backdrop-blur-sm">
                                @image.Views.ToString("N0") views
                            </span>
                        </div>
                    </div>
                }
            </div>

            @if (_hasMore)
            {
                <div class="mt-6 flex justify-center">
                    <ButtonCn Variant="ButtonVariant.Outline" OnClick="HandleLoadMore" Class="gap-2">
                        Load More Images
                        <span class="text-xs text-muted-foreground">
                            (@(_allImages.Length - _visibleCount) remaining)
                        </span>
                    </ButtonCn>
                </div>
            }

            @if (!_hasMore)
            {
                <div class="mt-6 flex justify-center">
                    <p class="text-xs text-muted-foreground">All images loaded</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record GalleryImage(string Id, string Title, string Category, int Views, string Image);

    private const int InitialLoad = 9;

    private int _visibleCount = InitialLoad;

    private GalleryImage[] _visibleImages => _allImages[.._visibleCount];
    private bool _hasMore => _visibleCount < _allImages.Length;

    private void HandleLoadMore()
    {
        _visibleCount = Math.Min(_visibleCount + 6, _allImages.Length);
    }

