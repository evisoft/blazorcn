@* ============================================================
   Block: gallery-client-logos
   Title: GalleryClientLogos
   Description: A client and partner logo gallery grid built with React, Next.js, shadcn/ui, and Tailwind CSS. Features grayscale logos that colorize on hover with smooth transitions for showcasing trusted brands.
   Source: original/blocks/gallery/gallery-client-logos.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Trusted by Industry Leaders</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Over 500+ companies rely on our platform
            </p>
        </div>

        <div class="grid grid-cols-3 gap-px bg-border p-4 sm:grid-cols-4">
            @foreach (var logo in _clientLogos)
            {
                <div class="group relative flex aspect-[3/2] items-center justify-center bg-card transition-colors hover:bg-muted/50">
                    <img
                        src="@logo.Image"
                        alt="@logo.Name"
                        class="size-full object-cover grayscale transition-all duration-300 group-hover:grayscale-0" />
                    <div class="absolute inset-x-0 bottom-0 flex items-center justify-center border-t border-transparent bg-background/80 pb-1 pt-1 opacity-0 backdrop-blur-sm transition-opacity group-hover:border-border group-hover:opacity-100">
                        <span class="text-muted-foreground text-[10px]">@logo.Category</span>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-center text-muted-foreground text-xs">
                Join leading companies transforming their workflows
            </p>
        </div>
    </div>
</section>

