@* ============================================================
   Block: gallery-color-palette
   Title: GalleryColorPalette
   Description: A gallery organized by dominant color themes with filter swatches, built with React, Next.js, shadcn/ui, Framer Motion, and Tailwind CSS
   Source: original/blocks/gallery/gallery-color-palette.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="palette" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Color Palette Gallery</h2>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">
                Filter images by dominant color theme
            </p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex flex-wrap gap-2">
                <button type="button"
                        class="@Cn.Merge("flex h-7 items-center gap-1.5 rounded-md px-2.5 text-xs transition-colors", _activeFilter == "all" ? "bg-foreground text-background" : "bg-muted text-muted-foreground hover:bg-muted/80")"
                        @onclick="@(() => _activeFilter = "all")">
                    All
                </button>
                @foreach (var f in _colorFilters)
                {
                    var filter = f;
                    <button type="button"
                            class="@Cn.Merge("flex h-7 items-center gap-1.5 rounded-md px-2.5 text-xs transition-colors", _activeFilter == filter.Name ? "bg-foreground text-background" : "bg-muted text-muted-foreground hover:bg-muted/80")"
                            @onclick="@(() => _activeFilter = filter.Name)">
                        <div class="flex gap-0.5">
                            @foreach (var color in filter.Colors)
                            {
                                <span class="@Cn.Merge("size-2.5 rounded-full", color)"></span>
                            }
                        </div>
                        @filter.Label
                    </button>
                }
            </div>
        </div>

        <div class="p-4">
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
                @foreach (var img in FilteredImages)
                {
                    var image = img;
                    var themeFilter = System.Array.Find(_colorFilters, fi => fi.Name == image.ColorTheme);
                    <div class="group relative cursor-pointer">
                        <img src="https://images.unsplash.com/photo-1557672172-298e090bd0f1?w=600&auto=format&fit=crop&h=600"
                             alt=""
                             class="aspect-square overflow-hidden rounded-md transition-transform group-hover:scale-[1.02] object-cover" />
                        <div class="mt-1.5 flex items-center justify-between">
                            <span class="text-xs text-muted-foreground">@image.Title</span>
                            <div class="flex gap-0.5">
                                @if (themeFilter != null && themeFilter.Colors.Length > 0)
                                {
                                    <span class="@Cn.Merge("size-1.5 rounded-full", themeFilter.Colors[0])"></span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                Showing @FilteredImages.Length of @_images.Length images
            </p>
        </div>
    </div>
</section>

@code {
    private record GalleryImage(string Id, string Title, string ColorTheme);

    private record ColorFilter(string Name, string Label, string[] Colors);

    private string _activeFilter = "all";

    private GalleryImage[] FilteredImages =>
        _activeFilter == "all" ? _images : System.Array.FindAll(_images, img => img.ColorTheme == _activeFilter);

    private static readonly GalleryImage[] _images =
    [
        new("img1",  "Sunset Desert",    "warm"),
        new("img2",  "Ocean Blue",       "cool"),
        new("img3",  "Golden Hour",      "warm"),
        new("img4",  "Stone Path",       "neutral"),
        new("img5",  "Tropical Flowers", "vibrant"),
        new("img6",  "Mountain Snow",    "cool"),
        new("img7",  "Autumn Leaves",    "warm"),
        new("img8",  "City Lights",      "vibrant"),
        new("img9",  "Beach Sand",       "neutral"),
        new("img10", "Forest Stream",    "cool"),
        new("img11", "Neon Signs",       "vibrant"),
        new("img12", "Concrete Wall",    "neutral"),
    ];

    private static readonly ColorFilter[] _colorFilters =
    [
        new("warm",    "Warm",    ["bg-orange-500", "bg-amber-500", "bg-red-500"]),
        new("cool",    "Cool",    ["bg-blue-500",   "bg-cyan-500",  "bg-indigo-500"]),
        new("neutral", "Neutral", ["bg-zinc-400",   "bg-stone-400", "bg-neutral-400"]),
        new("vibrant", "Vibrant", ["bg-pink-500",   "bg-purple-500","bg-emerald-500"]),
    ];
}
