@* ============================================================
   Block: gallery-mini-preview
   Title: GalleryMiniPreview
   Description: A compact mini gallery widget with 2x2 thumbnail grid and expandable full view built with React, Next.js, shadcn/ui, and Tailwind CSS. Features "+N more" overlay and dialog expansion.
   Source: original/blocks/gallery/gallery-mini-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Mini Gallery Widget</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Compact preview with expandable view
            </p>
        </div>

        <div class="p-4">
            <div class="flex items-start gap-4">
                @* Mini gallery widget *@
                <div class="relative">
                    <button type="button"
                            @onclick="@(() => _isExpanded = true)"
                            class="group relative grid grid-cols-2 gap-1 rounded-md border bg-muted/30 p-1 transition-all hover:border-foreground/20"
                            aria-label="Expand gallery">
                        @foreach (var gi in _visibleItems)
                        {
                            var item = gi;
                            var index = System.Array.IndexOf(_visibleItems, item);
                            <div class="relative aspect-square w-20 overflow-hidden rounded">
                                <img src="@item.Image" alt="@item.Title" class="h-full w-full object-cover" />
                                @if (index == 3 && _remainingCount > 0)
                                {
                                    <div class="absolute inset-0 flex items-center justify-center rounded bg-black/60">
                                        <span class="font-semibold text-sm text-white">+@_remainingCount</span>
                                    </div>
                                }
                            </div>
                        }
                        <div class="absolute inset-0 flex items-center justify-center opacity-0 transition-opacity group-hover:opacity-100">
                            <div class="rounded-full bg-black/60 p-2">
                                <LucideIconCn Name="maximize-2" Size="16" Class="size-4 text-white" />
                            </div>
                        </div>
                    </button>
                </div>

                @* Info *@
                <div class="flex-1 space-y-2">
                    <div>
                        <p class="font-medium text-sm">Gallery Collection</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            @_galleryItems.Length items total
                        </p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                              Class="h-7 gap-1 text-xs"
                              OnClick="@(() => _isExpanded = true)">
                        <LucideIconCn Name="maximize-2" Size="12" Class="size-3" />
                        View All
                    </ButtonCn>
                </div>
            </div>

            <div class="mt-4 flex items-center gap-2 rounded-md bg-muted/50 p-3">
                <div class="size-1.5 shrink-0 rounded-full bg-blue-500"></div>
                <p class="text-muted-foreground text-xs">Click widget to expand full gallery</p>
            </div>
        </div>
    </div>

    @* Expanded gallery dialog *@
    @* The React original uses shadcn's <Dialog> (original/blocks/gallery/gallery-mini-preview.tsx:192).
       The port hand-rolled an overlay div, which dropped Escape-to-close, the focus trap and
       role="dialog". *@
    <DialogCn @bind-Open="_isExpanded">
        <DialogContentCn Class="max-w-2xl" ShowCloseButton="false">
                <div class="flex items-center justify-between border-b pb-3">
                    <div>
                        <DialogTitleCn Class="font-medium text-sm">Full Gallery</DialogTitleCn>
                        <p class="mt-0.5 text-muted-foreground text-xs">@_galleryItems.Length items</p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                              Class="size-8"
                              OnClick="@(() => _isExpanded = false)" aria-label="Close">
                        <LucideIconCn Name="x" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>

                <div class="max-h-[500px] overflow-y-auto">
                    <div class="grid grid-cols-4 gap-2">
                        @foreach (var gi in _galleryItems)
                        {
                            var item = gi;
                            <div class="aspect-square overflow-hidden rounded">
                                <img src="@item.Image" alt="@item.Title" class="h-full w-full object-cover" />
                            </div>
                        }
                    </div>
                </div>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
