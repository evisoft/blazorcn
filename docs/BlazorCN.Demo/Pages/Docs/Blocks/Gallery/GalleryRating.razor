@* ============================================================
   Block: gallery-rating
   Title: GalleryRating
   Description: A gallery with star ratings and review system built with React, Next.js, shadcn/ui, and Tailwind CSS. Features sortable items, rating distribution, and review counts.
   Source: original/blocks/gallery/gallery-rating.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Gallery Collection</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">@_items.Length curated items</p>
        </div>

        @* Stats Overview *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="star" Size="16" Class="size-4 fill-amber-500 text-amber-500" />
                    <div>
                        <div class="text-sm font-semibold tabular-nums">@_averageRating</div>
                        <div class="text-xs text-muted-foreground">Avg Rating</div>
                    </div>
                </div>
                <div class="h-8 w-px bg-border"></div>
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <div class="text-sm font-semibold tabular-nums">@_totalReviews</div>
                        <div class="text-xs text-muted-foreground">Reviews</div>
                    </div>
                </div>
                <div class="h-8 w-px bg-border"></div>
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="trending-up" Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <div class="text-sm font-semibold tabular-nums">@_items.Count(i => i.Trending)</div>
                        <div class="text-xs text-muted-foreground">Trending</div>
                    </div>
                </div>
            </div>
        </div>

        @* Sort Controls *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3 text-muted-foreground" />
                <span class="text-xs text-muted-foreground">Sort by:</span>
                <div class="flex gap-1">
                    <ButtonCn Variant="@(_sortBy == "rating" ? ButtonVariant.Default : ButtonVariant.Ghost)"
                              Size="ButtonSize.Sm"
                              Class="h-6 px-2 text-xs"
                              OnClick="@(() => _sortBy = "rating")">
                        Rating
                    </ButtonCn>
                    <ButtonCn Variant="@(_sortBy == "reviews" ? ButtonVariant.Default : ButtonVariant.Ghost)"
                              Size="ButtonSize.Sm"
                              Class="h-6 px-2 text-xs"
                              OnClick="@(() => _sortBy = "reviews")">
                        Reviews
                    </ButtonCn>
                    <ButtonCn Variant="@(_sortBy == "trending" ? ButtonVariant.Default : ButtonVariant.Ghost)"
                              Size="ButtonSize.Sm"
                              Class="h-6 px-2 text-xs"
                              OnClick="@(() => _sortBy = "trending")">
                        Trending
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Gallery Grid *@
        <div class="p-4">
            <div class="grid grid-cols-3 gap-3">
                @foreach (var it in _sortedItems)
                {
                    var item = it;
                    <div class="overflow-hidden rounded-lg border bg-card transition-colors hover:bg-muted/30">
                        @* Image Area *@
                        <div class="relative h-20">
                            <img src="@item.Image" alt="@item.Title" class="size-full object-cover" />
                            @if (item.Trending)
                            {
                                <div class="absolute right-1 top-1">
                                    <BadgeCn Class="h-4 gap-0.5 px-1 text-xs">
                                        <LucideIconCn Name="trending-up" Size="10" Class="size-2.5" />
                                        Trending
                                    </BadgeCn>
                                </div>
                            }
                        </div>

                        @* Content *@
                        <div class="p-2">
                            <div class="mb-1 line-clamp-1 text-xs font-medium">@item.Title</div>
                            <p class="mb-2 line-clamp-1 text-xs text-muted-foreground">@item.Description</p>

                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-1">
                                    @RenderStars(item.Rating)
                                    <span class="ml-1 text-xs font-medium tabular-nums">@item.Rating</span>
                                </div>
                                <span class="text-xs text-muted-foreground">(@item.Reviews)</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Rating Distribution *@
        <div class="border-t p-4">
            <div class="mb-2 text-sm font-medium">Rating Distribution</div>
            <div class="space-y-2">
                @foreach (var stars in new[] { 5, 4, 3, 2, 1 })
                {
                    var s = stars;
                    var count = _items.Count(i => (int)Math.Round(i.Rating) == s);
                    var percentage = (_items.Length > 0 ? (double)count / _items.Length * 100 : 0);
                    <div class="flex items-center gap-2 text-xs">
                        <div class="flex w-12 items-center gap-0.5">
                            <LucideIconCn Name="star" Size="10" Class="size-2.5 fill-amber-500 text-amber-500" />
                            <span class="tabular-nums">@s</span>
                        </div>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full bg-amber-500" style="@(FormattableString.Invariant($"width:{percentage:F1}%"))"></div>
                        </div>
                        <span class="w-8 text-right tabular-nums text-muted-foreground">@count</span>
                    </div>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private record GalleryItem(
        string Id,
        string Title,
        string Description,
        double Rating,
        int Reviews,
        string Category,
        bool Trending,
        string Image
    );

    private string _sortBy = "rating";

    private static readonly GalleryItem[] _items =
    [
        new("1", "Sunset Photography",   "Golden hour captures",  4.9, 127, "Nature",       true,  "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop"),
        new("2", "Urban Architecture",   "Modern cityscapes",     4.7,  89, "Architecture", false, "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&auto=format&fit=crop"),
        new("3", "Portrait Series",      "Character studies",     4.8, 156, "People",       true,  "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800&auto=format&fit=crop"),
        new("4", "Abstract Patterns",    "Geometric designs",     4.5,  63, "Abstract",     false, "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=800&auto=format&fit=crop"),
        new("5", "Wildlife Collection",  "Animal photography",    4.9, 201, "Nature",       true,  "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&auto=format&fit=crop"),
        new("6", "Minimalist Design",    "Clean aesthetics",      4.6,  78, "Design",       false, "https://images.unsplash.com/photo-1518173946687-a544bf02a536?w=800&auto=format&fit=crop"),
        new("7", "Street Photography",   "Urban moments",         4.8, 143, "Street",       false, "https://images.unsplash.com/photo-1475924156734-496f6cac6ec1?w=800&auto=format&fit=crop"),
        new("8", "Landscape Vistas",     "Scenic views",          4.7, 112, "Nature",       false, "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=800&auto=format&fit=crop"),
        new("9", "Food Photography",     "Culinary artistry",     4.4,  54, "Food",         false, "https://images.unsplash.com/photo-1472214103451-9374bd1c798e?w=800&auto=format&fit=crop"),
    ];

    private GalleryItem[] _sortedItems => _sortBy switch
    {
        "reviews"  => [.. _items.OrderByDescending(i => i.Reviews)],
        "trending" => [.. _items.OrderByDescending(i => i.Trending ? 1 : 0)],
        _          => [.. _items.OrderByDescending(i => i.Rating)],
    };

    private string _averageRating =>
        (_items.Average(i => i.Rating)).ToString("F1");

    private int _totalReviews =>
        _items.Sum(i => i.Reviews);

    private RenderFragment RenderStars(double rating) => __builder =>
    {
        __builder.OpenElement(0, "div");
        __builder.AddAttribute(1, "class", "flex items-center gap-0.5");
        foreach (var star in new[] { 1, 2, 3, 4, 5 })
        {
            var s = star;
            var filled = s <= (int)Math.Round(rating);
            __builder.OpenComponent<LucideIconCn>(2);
            __builder.AddAttribute(3, "Name", "star");
            __builder.AddAttribute(4, "Size", 12);
            __builder.AddAttribute(5, "Class", filled
                ? "size-3 fill-amber-500 text-amber-500"
                : "size-3 text-muted-foreground/30");
            __builder.CloseComponent();
        }
        __builder.CloseElement();
    };
}
