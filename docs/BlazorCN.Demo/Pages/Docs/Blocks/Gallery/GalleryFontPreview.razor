@* ============================================================
   Block: gallery-font-preview
   Title: GalleryFontPreview
   Description: A typography and font preview gallery showcasing font samples with classification, weight options, and style variations. Built with React, Next.js, shadcn/ui, Tailwind CSS, and Framer Motion.
   Source: original/blocks/gallery/gallery-font-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-4">
            <div class="flex items-center gap-3">
                <LucideIconCn Name="type" Size="20" Class="size-5 text-muted-foreground" />
                <div>
                    <h2 class="font-semibold text-lg">Typography System</h2>
                    <p class="mt-1 text-muted-foreground text-sm">
                        Curated font collection with classification and weight options
                    </p>
                </div>
            </div>
        </div>

        <div class="p-6">
            <div class="space-y-6">
                @foreach (var f in _fontSamples)
                {
                    var font = f;
                    <div class="overflow-hidden rounded-lg border bg-card">
                        <div class="border-b px-4 py-3">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <h3 class="font-medium text-sm">@font.Name</h3>
                                    <span class="@Cn.Merge("rounded-full px-2 py-0.5 text-xs font-medium", ClassificationColor(font.Classification))">
                                        @font.Classification
                                    </span>
                                </div>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7">
                                    <LucideIconCn Name="download" Size="14" Class="size-3.5" />
                                </ButtonCn>
                            </div>
                        </div>

                        <div class="px-4 py-6">
                            <p class="text-2xl leading-relaxed" style="@($"font-family:{font.FontFamily}")">
                                @font.SampleText
                            </p>
                        </div>

                        <div class="border-t bg-muted/30 px-4 py-3">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="mb-2 text-muted-foreground text-xs">Available Weights</p>
                                    <div class="flex flex-wrap gap-2">
                                        @foreach (var weight in font.Weights)
                                        {
                                            <span class="rounded border bg-card px-2 py-0.5 font-mono text-xs">
                                                @weight
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-t bg-muted/30 px-6 py-4">
            <div class="flex items-center justify-between">
                <p class="text-muted-foreground text-sm">
                    @_fontSamples.Length typefaces • Multiple weights available
                </p>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">
                    Export Font List
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record FontSample(string Id, string Name, string Classification, string[] Weights, string SampleText, string FontFamily);

    private static readonly FontSample[] _fontSamples =
    [
        new("1", "Inter",             "Sans Serif", ["300","400","500","600","700"],             "The quick brown fox jumps over the lazy dog", "ui-sans-serif, system-ui, sans-serif"),
        new("2", "Merriweather",      "Serif",      ["300","400","700","900"],                   "The quick brown fox jumps over the lazy dog", "ui-serif, Georgia, serif"),
        new("3", "Fira Code",         "Monospace",  ["300","400","500","600","700"],             "const greeting = 'Hello, World!'",            "ui-monospace, monospace"),
        new("4", "Poppins",           "Sans Serif", ["200","300","400","500","600","700","800"], "The quick brown fox jumps over the lazy dog", "ui-sans-serif, system-ui, sans-serif"),
        new("5", "Playfair Display",  "Serif",      ["400","500","600","700","800","900"],       "The quick brown fox jumps over the lazy dog", "ui-serif, Georgia, serif"),
        new("6", "JetBrains Mono",    "Monospace",  ["200","300","400","500","600","700","800"], "function sum(a, b) { return a + b; }",        "ui-monospace, monospace"),
    ];

    private static string ClassificationColor(string classification) => classification switch
    {
        "Sans Serif" => "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        "Serif"      => "bg-purple-500/10 text-purple-600 dark:text-purple-400",
        "Monospace"  => "bg-green-500/10 text-green-600 dark:text-green-400",
        "Display"    => "bg-pink-500/10 text-pink-600 dark:text-pink-400",
        _            => "",
    };
}
