@* ============================================================
   Block: gallery-tab-categories
   Title: GalleryTabCategories
   Description: A tabbed image gallery built with React, Next.js, shadcn/ui, and Tailwind CSS. Features animated tab indicators, category-based filtering, smooth fade transitions, and count badges per category.
   Source: original/blocks/gallery/gallery-tab-categories.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Gallery Categories</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Browse by collection</p>
        </div>

        <div class="relative border-b">
            <div class="flex gap-1 px-2 py-2">
                @foreach (var tb in _tabs)
                {
                    var tab = tb;
                    var isActive = _activeTab == tab.Id;
                    <button type="button"
                            class="@Cn.Merge("relative flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-medium transition-colors", isActive ? "text-foreground" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => _activeTab = tab.Id)">
                        @if (isActive)
                        {
                            <div class="absolute inset-0 rounded-md bg-muted"></div>
                        }
                        <LucideIconCn Name="@tab.IconName" Size="14" Class="relative z-10 size-3.5" />
                        <span class="relative z-10">@tab.Label</span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="relative z-10 h-4 min-w-4 px-1 text-xs">
                            @GetTabCount(tab.Id)
                        </BadgeCn>
                    </button>
                }
            </div>
        </div>

        <div class="min-h-[400px] p-4">
            <div class="grid grid-cols-2 gap-3">
                @foreach (var img in GetFilteredImages())
                {
                    var image = img;
                    <div class="group relative overflow-hidden rounded-md border bg-muted">
                        <img src="@image.Image"
                             alt="@image.Title"
                             class="aspect-square w-full object-cover" />
                        @if (image.Featured)
                        {
                            <div class="absolute right-2 top-2">
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 gap-1 bg-yellow-500/10 text-yellow-600">
                                    <LucideIconCn Name="image" Size="10" Class="size-2.5 fill-yellow-600" />
                                    <span class="text-xs">Featured</span>
                                </BadgeCn>
                            </div>
                        }
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/0 to-transparent opacity-0 transition-opacity group-hover:opacity-100"></div>
                        <div class="absolute inset-x-0 bottom-0 translate-y-2 p-3 opacity-0 transition-all group-hover:translate-y-0 group-hover:opacity-100">
                            <h3 class="text-sm font-medium text-white">@image.Title</h3>
                            <p class="mt-0.5 text-xs text-white/70">@image.Date</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record CategoryImage(string Id, string Title, string Category, string Date, bool Featured, string Image);

    private record TabConfig(string Id, string Label, string IconName);

    private string _activeTab = "all";

    private static readonly CategoryImage[] _galleryImages =
    [
        new("i1", "Mountain Dawn",  "recent",   "2 days ago",   false, "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop"),
        new("i2", "Ocean Vista",    "recent",   "3 days ago",   true,  "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&auto=format&fit=crop"),
        new("i3", "Forest Path",    "popular",  "1 week ago",   false, "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800&auto=format&fit=crop"),
        new("i4", "Desert Sunset",  "popular",  "2 weeks ago",  true,  "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=800&auto=format&fit=crop"),
        new("i5", "City Nights",    "featured", "1 day ago",    true,  "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&auto=format&fit=crop"),
        new("i6", "Aurora Sky",     "featured", "4 days ago",   true,  "https://images.unsplash.com/photo-1518173946687-a544bf02a536?w=800&auto=format&fit=crop"),
        new("i7", "Valley View",    "all",      "5 days ago",   false, "https://images.unsplash.com/photo-1475924156734-496f6cac6ec1?w=800&auto=format&fit=crop"),
        new("i8", "Coastal Cliffs", "all",      "1 week ago",   false, "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=800&auto=format&fit=crop"),
    ];

    private static readonly TabConfig[] _tabs =
    [
        new("all",      "All",      "layout-grid"),
        new("recent",   "Recent",   "clock"),
        new("popular",  "Popular",  "trending-up"),
        new("featured", "Featured", "image"),
    ];

    private CategoryImage[] GetFilteredImages()
    {
        if (_activeTab == "all") return _galleryImages;
        return System.Array.FindAll(_galleryImages, img => img.Category == _activeTab);
    }

    private int GetTabCount(string tabId)
    {
        if (tabId == "all") return _galleryImages.Length;
        return System.Array.FindAll(_galleryImages, img => img.Category == tabId).Length;
    }
}
