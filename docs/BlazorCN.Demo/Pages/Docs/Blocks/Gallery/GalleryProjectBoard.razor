@* ============================================================
   Block: gallery-project-board
   Title: GalleryProjectBoard
   Description: A Kanban-style project board gallery built with React, Next.js, shadcn/ui, and Tailwind CSS. Organize images or assets by status columns with drag-and-drop visual design.
   Source: original/blocks/gallery/gallery-project-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Design Review Board</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                @_cards.Length active projects across @_columns.Length stages
            </p>
        </div>

        @* Board Columns *@
        <div class="grid grid-cols-3 divide-x">
            @foreach (var col in _columns)
            {
                var column = col;
                var columnCards = Array.FindAll(_cards, c => c.Status == column.Id);
                <div class="min-h-[400px]">
                    @* Column Header *@
                    <div class="border-b bg-muted/30 px-3 py-2">
                        <div class="flex items-center justify-between">
                            <h3 class="@($"text-xs font-medium {column.Color}")">@column.Title</h3>
                            <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px]">
                                @columnCards.Length
                            </BadgeCn>
                        </div>
                    </div>

                    @* Column Cards *@
                    <div class="space-y-2 p-2">
                        @foreach (var item in columnCards)
                        {
                            var card = item;
                            <div class="group overflow-hidden rounded-lg border bg-card transition-all hover:shadow-md">
                                @* Card Image *@
                                <img src="@card.Image"
                                     alt="@card.Title"
                                     class="aspect-video w-full object-cover transition-all duration-300 group-hover:scale-105" />

                                @* Card Content *@
                                <div class="p-3">
                                    <h4 class="font-medium text-xs leading-tight">@card.Title</h4>
                                    <p class="mt-1 line-clamp-2 text-muted-foreground text-[10px] leading-tight">
                                        @card.Description
                                    </p>

                                    @* Card Meta *@
                                    <div class="mt-3 flex items-center justify-between border-t pt-2">
                                        <div class="flex items-center gap-2">
                                            <div class="flex items-center gap-1 text-muted-foreground">
                                                <LucideIconCn Name="user" Size="12" Class="size-3" />
                                                <span class="truncate text-[10px]">
                                                    @card.Assignee.Split(' ')[0]
                                                </span>
                                            </div>
                                            <div class="flex items-center gap-1 text-muted-foreground">
                                                <LucideIconCn Name="message-square" Size="12" Class="size-3" />
                                                <span class="text-[10px]">@card.Comments</span>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-1 text-muted-foreground">
                                            <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                            <span class="text-[10px]">@card.LastUpdated</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ProjectCard(string Id, string Title, string Description, string Assignee,
        int Comments, string LastUpdated, string Status, string Image);

    private record BoardColumn(string Id, string Title, string Color);

