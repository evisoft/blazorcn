@* ============================================================
   Block: gallery-mosaic
   Title: GalleryMosaic
   Description: An editorial mosaic gallery with irregular grid layout built with React, Next.js, shadcn/ui, and Tailwind CSS. Dynamic column and row spans create a magazine-style composition.
   Source: original/blocks/gallery/gallery-mosaic.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Mosaic Gallery</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Editorial-style irregular grid layout
            </p>
        </div>

        <div class="p-4">
            <div class="grid auto-rows-[180px] grid-cols-3 gap-4">
                @foreach (var it in _mosaicItems)
                {
                    var item = it;
                    <button type="button"
                            class="@Cn.Merge("group relative overflow-hidden rounded-lg border bg-muted transition-transform hover:scale-[1.02]", item.ColSpan, item.RowSpan)">
                        <img src="@item.Image" alt="@item.Title" class="size-full object-cover" />

                        @* Overlay Info *@
                        <div class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-background/90 to-transparent p-3 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                            <p class="text-sm font-medium">@item.Title</p>
                            <p class="mt-0.5 text-xs text-muted-foreground">@item.Category</p>
                        </div>

                        @* Category Badge - Always Visible *@
                        <div class="absolute right-2 top-2 rounded-full bg-background/80 px-2 py-1 text-xs font-medium backdrop-blur-sm">
                            @item.Category
                        </div>
                    </button>
                }
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between text-xs text-muted-foreground">
                <span>@_mosaicItems.Length items</span>
                <span>Editorial grid layout</span>
            </div>
        </div>
    </div>
</section>

@code {
