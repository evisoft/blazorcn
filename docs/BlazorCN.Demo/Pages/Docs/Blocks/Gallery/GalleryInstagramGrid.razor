@* ============================================================
   Block: gallery-instagram-grid
   Title: GalleryInstagramGrid
   Description: An Instagram-style 3-column square grid gallery with hover overlays and profile header built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/gallery/gallery-instagram-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Profile Header *@
        <div class="border-b px-6 py-4">
            <div class="flex items-center gap-4">
                <AvatarCn Class="size-16">
                    <AvatarFallbackCn Class="bg-muted text-lg font-medium">JD</AvatarFallbackCn>
                </AvatarCn>
                <div class="flex-1">
                    <h2 class="font-semibold text-base">johndoe</h2>
                    <p class="text-muted-foreground text-sm">Professional Photographer</p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">
                    <LucideIconCn Name="settings" Size="16" Class="mr-2 size-4" />
                    Edit Profile
                </ButtonCn>
            </div>

            @* Stats *@
            <div class="mt-4 flex gap-6">
                <div class="text-center">
                    <div class="font-semibold text-base tabular-nums">@_galleryItems.Length</div>
                    <div class="text-muted-foreground text-xs">posts</div>
                </div>
                <div class="text-center">
                    <div class="font-semibold text-base tabular-nums">1.2k</div>
                    <div class="text-muted-foreground text-xs">followers</div>
                </div>
                <div class="text-center">
                    <div class="font-semibold text-base tabular-nums">847</div>
                    <div class="text-muted-foreground text-xs">following</div>
                </div>
            </div>
        </div>

        @* Grid *@
        <div class="grid grid-cols-3 gap-1 p-1">
            @foreach (var galleryItem in _galleryItems)
            {
                var item = galleryItem;
                <button class="group relative aspect-square overflow-hidden bg-muted"
                        type="button"
                        @onmouseenter="@(() => _hoveredId = item.Id)"
                        @onmouseleave="@(() => _hoveredId = null)">
                    <img src="@item.Image" alt="" class="size-full object-cover" />

                    @* Hover Overlay *@
                    <div class="@Cn.Merge("absolute inset-0 flex items-center justify-center bg-black/50 transition-opacity duration-200", _hoveredId == item.Id ? "opacity-100" : "opacity-0")">
                        <div class="flex items-center gap-2 text-white">
                            <LucideIconCn Name="heart" Size="20" Class="size-5 fill-white" />
                            <span class="font-semibold text-sm tabular-nums">@item.Likes</span>
                        </div>
                    </div>
                </button>
            }
        </div>
    </div>
</section>

@code {
    private record GalleryItem(string Id, int Likes, string Image);

    private string? _hoveredId = null;

    private static readonly GalleryItem[] _galleryItems =
