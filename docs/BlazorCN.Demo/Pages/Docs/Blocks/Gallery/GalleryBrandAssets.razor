@* ============================================================
   Block: gallery-brand-assets
   Title: GalleryBrandAssets
   Description: A brand asset library gallery for logos, color palettes, and usage guidelines built with React, Next.js, shadcn/ui, and Tailwind CSS. Features organized sections for brand downloads.
   Source: original/blocks/gallery/gallery-brand-assets.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Brand Assets</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Download logos, colors, and brand guidelines
            </p>
        </div>

        @* Logo Assets *@
        <div class="border-b p-4">
            <h3 class="mb-3 font-medium text-sm">Logo Assets</h3>
            <div class="space-y-2">
                @foreach (var asset in _logoAssets)
                {
                    <div class="flex items-center gap-3 rounded-md border bg-muted/30 px-3 py-2">
                        <div class="size-12 shrink-0 overflow-hidden rounded">
                            <img src="@asset.Image" alt="@asset.Name" class="h-full w-full object-cover" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="font-medium text-sm">@asset.Name</div>
                            <div class="text-muted-foreground text-xs">
                                @asset.Format • @asset.Size
                            </div>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                            <LucideIconCn Name="download" Size="12" Class="size-3" />
                            Download
                        </ButtonCn>
                    </div>
                }
            </div>
        </div>

        @* Color Palette *@
        <div class="border-b p-4">
            <h3 class="mb-3 font-medium text-sm">Color Palette</h3>
            <div class="space-y-2">
                @foreach (var color in _colorPalette)
                {
                    var colorItem = color;
                    <div class="flex items-center gap-3 rounded-md border bg-muted/30 px-3 py-2">
                        <div class="size-10 shrink-0 rounded border" style="@($"background-color:{colorItem.Hex}")"></div>
                        <div class="min-w-0 flex-1">
                            <div class="font-medium text-sm">@colorItem.Name</div>
                            <div class="text-muted-foreground text-xs">@colorItem.Usage</div>
                        </div>
                        <div class="flex flex-col gap-1">
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs" OnClick="@(() => CopyToClipboard(colorItem.Hex, $"{colorItem.Id}-hex"))">
                                @if (_copiedColor == $"{colorItem.Id}-hex")
                                {
                                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                                }
                                else
                                {
                                    <LucideIconCn Name="copy" Size="12" Class="size-3" />
                                }
                                @colorItem.Hex
                            </ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs" OnClick="@(() => CopyToClipboard(colorItem.Rgb, $"{colorItem.Id}-rgb"))">
                                @if (_copiedColor == $"{colorItem.Id}-rgb")
                                {
                                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                                }
                                else
                                {
                                    <LucideIconCn Name="copy" Size="12" Class="size-3" />
                                }
                                RGB
                            </ButtonCn>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Usage Guidelines *@
        <div class="p-4">
            <h3 class="mb-3 font-medium text-sm">Usage Guidelines</h3>
            <div class="space-y-3">
                @foreach (var guideline in _guidelines)
                {
                    <div class="rounded-md bg-muted/50 p-3">
                        <div class="mb-1 font-medium text-sm">@guideline.Title</div>
                        <p class="text-muted-foreground text-xs">@guideline.Description</p>
                    </div>
                }
            </div>
            <ButtonCn Class="mt-4 w-full" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">
                <LucideIconCn Name="download" Size="12" Class="mr-2 size-3" />
                Download Complete Brand Kit
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record BrandAsset(string Id, string Name, string Format, string Size, string Category, string Image);
    private record ColorAsset(string Id, string Name, string Hex, string Rgb, string Usage);
    private record Guideline(string Id, string Title, string Description);

    private string? _copiedColor = null;

    private static readonly BrandAsset[] _logoAssets =
    [
        new("1", "Primary Logo", "SVG", "Vector", "logo",
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop"),
        new("2", "Secondary Logo", "SVG", "Vector", "logo",
            "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&auto=format&fit=crop"),
        new("3", "Logo Icon", "SVG", "Vector", "logo",
            "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800&auto=format&fit=crop"),
        new("4", "Light Version", "PNG", "2048x512", "logo",
            "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=800&auto=format&fit=crop"),
        new("5", "Dark Version", "PNG", "2048x512", "logo",
            "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&auto=format&fit=crop"),
    ];

    private static readonly ColorAsset[] _colorPalette =
    [
        new("1", "Primary", "#0F172A", "15, 23, 42", "Primary brand color"),
        new("2", "Accent", "#3B82F6", "59, 130, 246", "Interactive elements"),
        new("3", "Success", "#10B981", "16, 185, 129", "Success states"),
        new("4", "Warning", "#F59E0B", "245, 158, 11", "Warning states"),
        new("5", "Error", "#EF4444", "239, 68, 68", "Error states"),
    ];

    private static readonly Guideline[] _guidelines =
    [
        new("1", "Logo Usage", "Maintain minimum clear space equal to the height of the logo mark"),
        new("2", "Color Application", "Use primary color for main UI elements, accent for CTAs"),
        new("3", "Typography", "Primary font: Inter, fallback to system sans-serif"),
        new("4", "Spacing", "Follow 8px grid system for all layout spacing"),
    ];

    private void CopyToClipboard(string text, string id)
    {
        _copiedColor = id;
        // Reset after 2 seconds is not directly supported without JS interop;
        // state is set and will clear on next interaction or via a timer if needed.
    }
}
