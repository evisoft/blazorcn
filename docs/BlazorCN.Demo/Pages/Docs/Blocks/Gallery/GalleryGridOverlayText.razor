@* ============================================================
   Block: gallery-grid-overlay-text
   Title: GalleryGridOverlayText
   Description: A bold text-overlay gallery component for React and Next.js with typography-first design, built with shadcn/ui and Tailwind CSS. Perfect for year-in-review showcases and statistics combined with imagery.
   Source: original/blocks/gallery/gallery-grid-overlay-text.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">2025 Year in Review</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Our journey in numbers and milestones
            </p>
        </div>

        <div class="grid grid-cols-2 gap-0">
            @foreach (var gi in _gridItems)
            {
                var item = gi;
                var index = System.Array.IndexOf(_gridItems, item);
                <div class="@Cn.Merge("relative aspect-square overflow-hidden border-b border-r p-6",
                                      index % 2 == 1 ? "border-r-0" : "",
                                      index >= _gridItems.Length - 2 ? "border-b-0" : "")">
                    @* Image Background *@
                    <img src="@item.Image"
                         alt="@item.Title"
                         class="absolute inset-0 size-full object-cover opacity-30" />

                    @* Content Overlay *@
                    <div class="relative z-10 flex h-full flex-col justify-between">
                        <div class="flex items-start justify-between">
                            <div class="rounded-lg bg-background/80 p-2 backdrop-blur-sm">
                                <LucideIconCn Name="@item.IconName" Size="24" Class="size-6" />
                            </div>
                        </div>

                        <div>
                            <div class="mb-1 font-semibold text-4xl tabular-nums">@item.Value</div>
                            <div class="mb-0.5 font-medium text-sm">@item.Title</div>
                            <div class="text-muted-foreground text-xs">@item.Description</div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-muted-foreground text-xs">
                Data represents performance metrics from January to December 2025
            </p>
        </div>
    </div>
</section>

@code {
    private record GridItem(string Id, string Title, string Value, string Description, string Color, string IconName, string Image);

    private static readonly GridItem[] _gridItems =
    [
        new("1", "Total Users",  "2.4M",   "Active users worldwide",  "bg-blue-100",   "users",        "https://images.unsplash.com/photo-1504567961542-e24d9439a724?w=600&h=600&auto=format&fit=crop"),
        new("2", "Growth Rate",  "145%",   "Year over year",          "bg-green-100",  "trending-up",  "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=600&h=600&auto=format&fit=crop"),
        new("3", "Performance",  "99.9%",  "Uptime achieved",         "bg-purple-100", "zap",          "https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=600&h=600&auto=format&fit=crop"),
        new("4", "Conversions",  "32K",    "This quarter",            "bg-orange-100", "target",       "https://images.unsplash.com/photo-1550859492-d5da9d8e45f3?w=600&h=600&auto=format&fit=crop"),
        new("5", "Revenue",      "$18M",   "Annual recurring",        "bg-cyan-100",   "trending-up",  "https://images.unsplash.com/photo-1553356084-58ef4a67b2a7?w=600&h=600&auto=format&fit=crop"),
        new("6", "Customers",    "8,450",  "Enterprise clients",      "bg-pink-100",   "users",        "https://images.unsplash.com/photo-1472214103451-9374bd1c798e?w=600&h=600&auto=format&fit=crop"),
    ];
}
