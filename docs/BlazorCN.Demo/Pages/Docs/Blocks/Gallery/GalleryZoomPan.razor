@* ============================================================
   Block: gallery-zoom-pan
   Title: GalleryZoomPan
   Description: A gallery with zoom and pan functionality on individual images with click to zoom and drag to pan interactions built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/gallery/gallery-zoom-pan.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="font-medium text-sm">Interactive Gallery</h2>
                    <p class="mt-0.5 text-muted-foreground text-xs">Click to zoom, drag to pan</p>
                </div>
                @if (_selectedImage != null)
                {
                    <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1.5">
                        <LucideIconCn Name="maximize-2" Size="12" Class="size-3" />
                        <span class="font-mono text-xs">@_scale x</span>
                    </BadgeCn>
                }
            </div>
        </div>

        <div class="grid grid-cols-2 gap-3 border-b p-4">
            @foreach (var image in _galleryImages)
            {
                var img = image;
                var isSelected = _selectedImage == img.Id;
                <button type="button"
                        class="@Cn.Merge("group overflow-hidden rounded-md border transition-all", isSelected ? "border-foreground/40 ring-2 ring-foreground/20" : "border-transparent hover:border-foreground/20")"
                        @onclick="@(() => HandleImageClick(img.Id))">
                    <img src="@img.Image"
                         alt=""
                         class="@Cn.Merge("object-cover transition-opacity group-hover:opacity-90", img.AspectRatio == "portrait" ? "aspect-[3/4]" : "aspect-[4/3]")" />
                    <div class="border-t px-2 py-1.5">
                        <p class="truncate text-center font-medium text-xs">@img.Title</p>
                    </div>
                </button>
            }
        </div>

        @if (_selectedImage != null)
        {
            var selData = _galleryImages.FirstOrDefault(i => i.Id == _selectedImage);
            <div class="relative overflow-hidden bg-muted/30"
                 style="height:400px"
                 @onmousedown="HandleMouseDown"
                 @onmousemove="HandleMouseMove"
                 @onmouseup="HandleMouseUp"
                 @onmouseleave="HandleMouseUp">
                <div class="@Cn.Merge("absolute inset-0 flex items-center justify-center bg-muted", _isDragging ? "cursor-grabbing" : _scale > 1 ? "cursor-grab" : "cursor-zoom-in")"
                     style="@($"transform:scale({_scale.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}) translate({_posX.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}px,{_posY.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}px)")">
                    @if (selData != null)
                    {
                        <img src="@selData.Image"
                             alt="@selData.Title"
                             class="@Cn.Merge("size-full max-h-full max-w-full object-cover", selData.AspectRatio == "portrait" ? "aspect-[3/4]" : "aspect-[4/3]")" />
                    }
                </div>

                @if (_scale > 1)
                {
                    <div class="absolute top-3 left-3">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1">
                            <span class="text-xs">Drag to pan</span>
                        </BadgeCn>
                    </div>
                }
            </div>

            <div class="border-t px-4 py-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-1">
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                  Class="h-7 gap-1 px-2 text-xs"
                                  Disabled="@(_scale <= 1)"
                                  OnClick="HandleZoomOut">
                            <LucideIconCn Name="zoom-out" Size="14" Class="size-3.5" />
                            Out
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                  Class="h-7 gap-1 px-2 text-xs"
                                  Disabled="@(_scale >= 3)"
                                  OnClick="HandleZoomIn">
                            <LucideIconCn Name="zoom-in" Size="14" Class="size-3.5" />
                            In
                        </ButtonCn>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                              Class="h-7 px-2 text-xs"
                              Disabled="@(_scale == 1 && _posX == 0 && _posY == 0)"
                              OnClick="HandleReset">
                        Reset
                    </ButtonCn>
                </div>
            </div>
        }
        else
        {
            <div class="flex h-[400px] items-center justify-center bg-muted/30">
                <p class="text-center text-muted-foreground text-sm">
                    Select an image to zoom and pan
                </p>
            </div>
        }
    </div>
</section>

@code {
    private record GalleryImage(string Id, string Title, string AspectRatio, string Image);

    private static readonly GalleryImage[] _galleryImages =
    [
        new("1", "Mountain Vista", "landscape",
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop"),
        new("2", "City Night", "portrait",
            "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=600&h=600&auto=format&fit=crop"),
        new("3", "Ocean Waves", "landscape",
            "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800&auto=format&fit=crop"),
        new("4", "Forest Path", "portrait",
            "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=600&h=600&auto=format&fit=crop"),
    ];

    private string? _selectedImage = null;
    private double _scale = 1;
    private double _posX = 0;
    private double _posY = 0;
    private bool _isDragging = false;
    private double _dragStartX = 0;
    private double _dragStartY = 0;

    private void HandleZoomIn()
    {
        _scale = Math.Min(_scale + 0.5, 3);
    }

    private void HandleZoomOut()
    {
        _scale = Math.Max(_scale - 0.5, 1);
    }

    private void HandleReset()
    {
        _scale = 1;
        _posX = 0;
        _posY = 0;
    }

    private void HandleImageClick(string imageId)
    {
        if (_selectedImage == imageId)
        {
            HandleZoomIn();
        }
        else
        {
            _selectedImage = imageId;
            _scale = 1;
            _posX = 0;
            _posY = 0;
        }
    }

    private void HandleMouseDown(MouseEventArgs e)
    {
        if (_scale > 1)
        {
            _isDragging = true;
            _dragStartX = e.ClientX - _posX;
            _dragStartY = e.ClientY - _posY;
        }
    }

    private void HandleMouseMove(MouseEventArgs e)
    {
        if (_isDragging && _scale > 1)
        {
            _posX = e.ClientX - _dragStartX;
            _posY = e.ClientY - _dragStartY;
        }
    }

    private void HandleMouseUp()
    {
        _isDragging = false;
    }
}
