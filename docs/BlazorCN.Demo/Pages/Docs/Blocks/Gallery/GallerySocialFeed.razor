@* ============================================================
   Block: gallery-social-feed
   Title: GallerySocialFeed
   Description: A social media feed-style gallery with avatars, interactions, and timestamps, built with React, Next.js, shadcn/ui, Framer Motion, and Tailwind CSS
   Source: original/blocks/gallery/gallery-social-feed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Feed</h2>
            <p class="mt-1 text-xs text-muted-foreground">Latest from your community</p>
        </div>

        <div class="max-h-[700px] overflow-y-auto">
            @foreach (var post in _feedPosts)
            {
                var p = post;
                var isLiked = _likedPosts.Contains(p.Id);
                <div class="border-b p-4 last:border-b-0">
                    <div class="flex items-start gap-3">
                        <div class="size-9 shrink-0 rounded-full bg-muted"></div>
                        <div class="flex-1">
                            <div class="flex items-start justify-between">
                                <div>
                                    <p class="text-sm font-medium">@p.Username</p>
                                    <p class="text-xs text-muted-foreground">
                                        @p.UserHandle · @p.Timestamp
                                    </p>
                                </div>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0" aria-label="@($"More options for {p.Username}'s post")">
                                    <LucideIconCn Name="more-horizontal" Size="16" Class="size-4 text-muted-foreground" />
                                </ButtonCn>
                            </div>

                            <p class="mt-2 text-sm text-muted-foreground">@p.Caption</p>

                            <img src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=600&auto=format&fit=crop&h=600"
                                 alt=""
                                 class="mt-3 aspect-square overflow-hidden rounded-md object-cover" />

                            <div class="mt-3 flex items-center gap-1">
                                <ButtonCn Variant="ButtonVariant.Ghost"
                                          Size="ButtonSize.Sm"
                                          Class="h-7 gap-1.5 px-2 text-xs"
                                          OnClick="@(() => ToggleLike(p.Id))">
                                    <LucideIconCn Name="heart" Size="16" Class="@Cn.Merge("size-4 transition-colors", isLiked ? "fill-red-500 text-red-500" : "text-muted-foreground")" />
                                    @(isLiked ? p.Likes + 1 : p.Likes)
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Ghost"
                                          Size="ButtonSize.Sm"
                                          Class="h-7 gap-1.5 px-2 text-xs text-muted-foreground">
                                    <LucideIconCn Name="message-circle" Size="16" Class="size-4" />
                                    @p.Comments
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Ghost"
                                          Size="ButtonSize.Sm"
                                          Class="h-7 gap-1.5 px-2 text-xs text-muted-foreground">
                                    <LucideIconCn Name="share" Size="16" Class="size-4" />
                                    Share
                                </ButtonCn>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">@_feedPosts.Length posts</p>
        </div>
    </div>
</section>

@code {
    private record FeedPost(string Id, string Username, string UserHandle, string Timestamp, int Likes, int Comments, string Caption);

    private HashSet<string> _likedPosts = [];

    private void ToggleLike(string postId)
    {
        if (_likedPosts.Contains(postId))
            _likedPosts.Remove(postId);
        else
            _likedPosts.Add(postId);
    }

    private static readonly FeedPost[] _feedPosts =
    [
        new("post1", "Sarah Chen", "@sarahc", "2h ago", 234, 12, "Golden hour at the coast"),
        new("post2", "Mike Torres", "@miket", "4h ago", 189, 8, "Morning coffee ritual"),
        new("post3", "Emma Wilson", "@emmaw", "6h ago", 412, 23, "City lights from above"),
        new("post4", "Alex Rivera", "@alexr", "8h ago", 567, 31, "Mountain peak adventure"),
    ];
}
