@* ============================================================
   Block: gallery-product-showcase
   Title: GalleryProductShowcase
   Description: An e-commerce product image gallery with main viewer, thumbnail selectors, and color variants built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/gallery/gallery-product-showcase.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-4">
            <h2 class="font-semibold text-base">Premium Cotton T-Shirt</h2>
            <p class="mt-1 text-muted-foreground text-sm">Classic fit, 100% organic cotton</p>
            <div class="mt-2 flex items-baseline gap-2">
                <span class="font-semibold text-2xl tabular-nums">$49.00</span>
                <span class="text-muted-foreground text-sm line-through">$69.00</span>
                <span class="rounded bg-emerald-500/10 px-2 py-0.5 font-medium text-emerald-600 text-xs">
                    30% off
                </span>
            </div>
        </div>

        <div class="p-6">
            @* Main Image *@
            <div class="relative mb-4 aspect-[4/3] overflow-hidden rounded-lg bg-muted"
                 @onmouseenter="@(() => _isHovering = true)"
                 @onmouseleave="@(() => _isHovering = false)">
                <img src="@_selectedImage.Image"
                     alt="@_selectedImage.Label"
                     class="size-full object-cover" />

                @* Zoom Indicator *@
                @if (_isHovering)
                {
                    <div class="absolute right-4 top-4 flex items-center gap-2 rounded-md bg-black/70 px-3 py-2 text-white">
                        <LucideIconCn Name="zoom-in" Size="16" Class="size-4" />
                        <span class="text-xs">Hover to zoom</span>
                    </div>
                }

                @* Image Label *@
                <div class="absolute bottom-4 left-4 rounded-md bg-black/70 px-3 py-1.5 text-white text-xs">
                    @_selectedImage.Label
                </div>
            </div>

            @* Thumbnails *@
            <div class="mb-6 flex gap-2">
                @foreach (var img in _productImages)
                {
                    var image = img;
                    <button type="button"
                            @onclick="@(() => _selectedImage = image)"
                            class="@Cn.Merge("aspect-square flex-1 overflow-hidden rounded-md border-2 bg-muted transition-all", _selectedImage.Id == image.Id ? "border-foreground" : "border-transparent hover:border-muted-foreground/30")">
                        <img src="@image.Image" alt="@image.Label" class="size-full object-cover" />
                    </button>
                }
            </div>

            @* Color Variants *@
            <div class="border-t pt-4">
                <span class="mb-3 block font-medium text-sm">Color: @_selectedColor.Name</span>
                <div class="flex gap-2">
                    @foreach (var col in _colorVariants)
                    {
                        var variant = col;
                        <button type="button"
                                @onclick="@(() => _selectedColor = variant)"
                                class="@Cn.Merge("size-10 rounded-full border-2 transition-all", _selectedColor.Id == variant.Id ? "border-foreground ring-2 ring-offset-2" : "border-transparent hover:border-muted-foreground/30")"
                                aria-label="@($"Select {variant.Name} color")">
                            <div class="@Cn.Merge("size-full rounded-full", variant.Color)"></div>
                        </button>
                    }
                </div>
            </div>

            @* Actions *@
            <div class="mt-6 flex gap-3">
                <ButtonCn Class="flex-1">Add to Cart</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline">Save</ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record ProductImage(string Id, string Label, string Image);
    private record ColorVariant(string Id, string Name, string Color);

    private static readonly ProductImage[] _productImages =
    [
        new("1", "Front view",
            "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=800&auto=format&fit=crop"),
        new("2", "Side view",
            "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=800&auto=format&fit=crop"),
        new("3", "Back view",
            "https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=800&auto=format&fit=crop"),
        new("4", "Detail view",
            "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=800&auto=format&fit=crop"),
    ];

    private static readonly ColorVariant[] _colorVariants =
    [
        new("1", "Black", "bg-zinc-900"),
        new("2", "White", "bg-zinc-100"),
        new("3", "Navy", "bg-blue-900"),
        new("4", "Olive", "bg-green-800"),
    ];

    private ProductImage _selectedImage = _productImages[0];
    private ColorVariant _selectedColor = _colorVariants[0];
    private bool _isHovering = false;
}
