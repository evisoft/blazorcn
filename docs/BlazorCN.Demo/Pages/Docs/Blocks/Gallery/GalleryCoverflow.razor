@* ============================================================
   Block: gallery-coverflow
   Title: GalleryCoverflow
   Description: A 3D coverflow carousel gallery with perspective transforms built with React, Next.js, shadcn/ui, Tailwind CSS, and Framer Motion for smooth transitions and depth effects
   Source: original/blocks/gallery/gallery-coverflow.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Gallery Coverflow</h2>
            <p class="mt-1 text-muted-foreground text-xs">3D perspective carousel with depth</p>
        </div>

        <div class="relative h-[500px] px-4 py-8">
            <div class="relative h-full w-full" style="perspective:1000px">
                <div class="relative flex h-full items-center justify-center">
                    @foreach (var it in _images)
                    {
                        var img = it;
                        var index = _images.IndexOf(img);
                        var isActive = index == _activeIndex;
                        var transform = GetTransformStyle(index);
                        var zIndex = isActive ? 10 : 5 - Math.Abs(index - _activeIndex);
                        var ringClass = isActive ? "ring-2 ring-primary ring-offset-2" : "";
                        var containerStyle = $"transform-style:preserve-3d;z-index:{zIndex};transition:transform 0.5s cubic-bezier(0.34,1.56,0.64,1),opacity 0.5s ease;{transform}";
                        <div class="absolute"
                             style="@containerStyle">
                            <div class="@Cn.Merge("relative overflow-hidden rounded-lg border shadow-lg", ringClass)"
                                 style="width:320px;height:400px">
                                <img src="@img.Image" alt="@img.Title" class="size-full object-cover" />
                                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent p-4">
                                    <div class="text-center text-white">
                                        <div class="mb-1 text-xs opacity-80">Image @(index + 1)</div>
                                        <div class="font-medium text-sm">@img.Title</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="absolute inset-x-4 top-1/2 flex -translate-y-1/2 justify-between">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon"
                          Class="h-8 w-8 rounded-full bg-background shadow-md"
                          OnClick="HandlePrevious" aria-label="Previous">
                    <LucideIconCn Name="chevron-left" Size="16" Class="size-4" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon"
                          Class="h-8 w-8 rounded-full bg-background shadow-md"
                          OnClick="HandleNext" aria-label="Next">
                    <LucideIconCn Name="chevron-right" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center justify-center gap-0.5 border-t px-4 py-3">
            @foreach (var it2 in _images)
            {
                var img2 = it2;
                var idx = _images.IndexOf(img2);
                var dotClass = idx == _activeIndex
                    ? "bg-primary"
                    : "bg-muted-foreground/30 group-hover:bg-muted-foreground/50";
                <button type="button"
                        class="group relative inline-flex size-6 items-center justify-center"
                        aria-label="@($"Go to slide {idx + 1}")" @onclick="@(() => SetActive(idx))">
                    <span class="@Cn.Merge("block size-1.5 rounded-full transition-all", dotClass)"></span>
                </button>
            }
        </div>
    </div>
</section>

@code {
    private record GalleryImage(string Id, string Title, string Image);

    private int _activeIndex = 3;

    private static readonly List<GalleryImage> _images =
    [
        new("1", "Mountain Landscape", "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop"),
        new("2", "Ocean Sunset",       "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&auto=format&fit=crop"),
        new("3", "Forest Path",        "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800&auto=format&fit=crop"),
        new("4", "Desert Dunes",       "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=800&auto=format&fit=crop"),
        new("5", "City Skyline",       "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&auto=format&fit=crop"),
        new("6", "Winter Valley",      "https://images.unsplash.com/photo-1518173946687-a544bf02a536?w=800&auto=format&fit=crop"),
        new("7", "Tropical Beach",     "https://images.unsplash.com/photo-1475924156734-496f6cac6ec1?w=800&auto=format&fit=crop"),
    ];

    private void HandlePrevious()
    {
        _activeIndex = _activeIndex > 0 ? _activeIndex - 1 : _images.Count - 1;
    }

    private void HandleNext()
    {
        _activeIndex = _activeIndex < _images.Count - 1 ? _activeIndex + 1 : 0;
    }

    private void SetActive(int index)
    {
        _activeIndex = index;
    }

    private string GetTransformStyle(int index)
    {
        var offset = index - _activeIndex;
        var absOffset = Math.Abs(offset);

        if (absOffset > 2)
        {
            var hiddenX = offset > 0 ? "120%" : "-120%";
            return $"transform:translateX({hiddenX}) scale(0.6) rotateY({(offset > 0 ? 45 : -45)}deg) translateZ(-200px);opacity:0";
        }

        var scale = 1.0 - absOffset * 0.2;
        var rotateY = offset * 35;
        var z = -absOffset * 100;
        var x = offset * 45;

        return $"transform:translateX({x.ToString(System.Globalization.CultureInfo.InvariantCulture)}%) scale({scale.ToString("0.0##", System.Globalization.CultureInfo.InvariantCulture)}) rotateY({rotateY}deg) translateZ({z}px);opacity:1";
    }
}
