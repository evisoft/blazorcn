@* ============================================================
   Block: gallery-collage
   Title: GalleryCollage
   Description: An artistic collage layout with overlapping images at various sizes and rotations, built with React, Next.js, shadcn/ui, and Tailwind CSS. Tightly packed arrangement with dynamic positioning.
   Source: original/blocks/gallery/gallery-collage.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Photo Collage</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Artistic arrangement of memories</p>
        </div>

        @* Collage container *@
        <div class="relative aspect-[4/3] overflow-hidden bg-muted/30 p-4">
            @foreach (var image in _collageImages)
            {
                var sizeClass = image.Size switch
                {
                    "sm" => "h-32 w-28",
                    "md" => "h-40 w-36",
                    _ => "h-48 w-44"
                };
                <div class="@Cn.Merge(sizeClass, "group cursor-pointer")"
                     style="@($"position:absolute; top:{image.Top}; left:{image.Left}; z-index:{image.ZIndex}; transform:rotate({image.Rotation}deg);")">
                    @* Image frame with shadow *@
                    <div class="relative size-full overflow-hidden rounded-md border-4 border-white bg-white shadow-xl transition-shadow group-hover:shadow-2xl">
                        @* Image *@
                        <img src="@image.Image" alt="@image.Title" class="size-full object-cover" />

                        @* Hover overlay *@
                        <div class="absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/20"></div>

                        @* Title overlay *@
                        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent p-2 opacity-0 transition-opacity group-hover:opacity-100">
                            <p class="text-xs text-white">@image.Title</p>
                        </div>

                        @* Like button *@
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="absolute right-1 top-1 size-7 p-0 opacity-0 transition-opacity group-hover:opacity-100" aria-label="@($"Like {image.Title}")">
                            <LucideIconCn Name="heart" Size="14" Class="size-3.5" />
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <p class="text-xs text-muted-foreground">@_collageImages.Length photos</p>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 px-3 text-xs">
                    Regenerate Layout
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record CollageImage(string Id, string Title, string Size, int Rotation, int ZIndex, string Top, string Left, string Image);

    private static readonly CollageImage[] _collageImages =
    [
        new("1", "Mountain Peak",   "lg", -3, 3, "0%",  "5%",
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=600&h=600&auto=format&fit=crop"),
        new("2", "Ocean View",      "md",  4, 2, "8%",  "45%",
            "https://images.unsplash.com/photo-1475924156734-496f6cac6ec1?w=600&h=600&auto=format&fit=crop"),
        new("3", "Forest Trail",    "sm", -6, 4, "35%", "15%",
            "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=600&h=600&auto=format&fit=crop"),
        new("4", "City Lights",     "md",  2, 1, "30%", "55%",
            "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=600&h=600&auto=format&fit=crop"),
        new("5", "Desert Sunset",   "lg", -2, 2, "60%", "8%",
            "https://images.unsplash.com/photo-1550859492-d5da9d8e45f3?w=600&h=600&auto=format&fit=crop"),
        new("6", "Waterfall",       "sm",  5, 5, "68%", "62%",
            "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=600&h=600&auto=format&fit=crop"),
        new("7", "Beach Walk",      "md", -4, 3, "48%", "38%",
            "https://images.unsplash.com/photo-1472214103451-9374bd1c798e?w=600&h=600&auto=format&fit=crop"),
    ];
}
