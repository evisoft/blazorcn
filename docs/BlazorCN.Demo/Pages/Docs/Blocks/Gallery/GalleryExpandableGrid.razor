@* ============================================================
   Block: gallery-expandable-grid
   Title: GalleryExpandableGrid
   Description: A dynamic expandable grid gallery component for React and Next.js with smooth layout animations, built with shadcn/ui, Tailwind CSS, and Framer Motion. Features intelligent grid rearrangement on click.
   Source: original/blocks/gallery/gallery-expandable-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Expandable Grid Gallery</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Click any image to expand it</p>
        </div>

        <div class="p-4">
            <div class="grid grid-cols-3 gap-3">
                @foreach (var img in _images)
                {
                    var image = img;
                    var isExpanded = _expandedId == image.Id;
                    <button type="button"
                            class="@Cn.Merge("relative overflow-hidden rounded-lg border transition-shadow hover:shadow-md", isExpanded ? "col-span-2 row-span-2" : "aspect-square")"
                            @onclick="@(() => ToggleExpand(image.Id))">
                        <div class="relative size-full">
                            <img src="@image.Image" alt="@image.Title" class="size-full object-cover" />
                            <div class="absolute inset-0 flex flex-col items-center justify-center bg-black/40">
                                <div class="text-center">
                                    <span class="@Cn.Merge("font-medium text-white", isExpanded ? "text-lg" : "text-sm")">
                                        @image.Title
                                    </span>
                                    @if (isExpanded)
                                    {
                                        <p class="mt-2 text-white/80 text-xs">@image.Category</p>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (isExpanded)
                        {
                            <div class="absolute top-2 right-2" @onclick:stopPropagation="true" @onclick="@(() => _expandedId = null)">
                                <ButtonCn Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" Class="size-7 p-0">
                                    <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                                </ButtonCn>
                            </div>
                        }
                    </button>
                }
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">@_images.Length images</span>
                @if (_expandedId != null)
                {
                    var viewing = System.Array.Find(_images, img => img.Id == _expandedId);
                    @if (viewing != null)
                    {
                        <span class="text-muted-foreground">Viewing: @viewing.Title</span>
                    }
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record GalleryImage(string Id, string Title, string Category, string Color, string Image);

    private string? _expandedId = null;

    private void ToggleExpand(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private static readonly GalleryImage[] _images =
    [
        new("1", "Mountain Peak", "Nature", "bg-blue-200",
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop"),
