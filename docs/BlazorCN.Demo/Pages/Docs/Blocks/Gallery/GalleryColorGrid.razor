@* ============================================================
   Block: gallery-color-grid
   Title: GalleryColorGrid
   Description: A design system color palette gallery with hex values, color names, and copy-to-clipboard functionality. Built with React, Next.js, shadcn/ui, Tailwind CSS, and Framer Motion.
   Source: original/blocks/gallery/gallery-color-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-4">
            <div class="flex items-center gap-3">
                <LucideIconCn Name="palette" Size="20" Class="size-5 text-muted-foreground" />
                <div>
                    <h2 class="font-semibold text-lg">Design System Palette</h2>
                    <p class="mt-1 text-muted-foreground text-sm">
                        Click any color to copy its hex value
                    </p>
                </div>
            </div>
        </div>

        <div class="p-6">
            <div class="space-y-8">
                @foreach (var cat in _categories)
                {
                    var category = cat;
                    <div>
                        <h3 class="mb-4 font-medium text-sm text-muted-foreground">@category</h3>
                        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                            @foreach (var sw in _colorSwatches.Where(s => s.Category == category))
                            {
                                var swatch = sw;
                                <button type="button"
                                        @onclick="@(() => CopyToClipboard(swatch.Hex, swatch.Id))"
                                        class="group overflow-hidden rounded-lg border bg-card text-left transition-shadow hover:shadow-md">
                                    <div class="h-24 w-full transition-transform group-hover:scale-105"
                                         style="@($"background-color:{swatch.Hex}")">
                                    </div>
                                    <div class="p-3">
                                        <div class="flex items-center justify-between">
                                            <div class="min-w-0 flex-1">
                                                <p class="font-medium text-sm">@swatch.Name</p>
                                                <p class="font-mono text-muted-foreground text-xs">
                                                    @swatch.Hex
                                                </p>
                                            </div>
                                            <div class="ml-2 flex size-8 items-center justify-center rounded-md border bg-muted/50">
                                                @if (_copiedId == swatch.Id)
                                                {
                                                    <LucideIconCn Name="check" Size="16" Class="size-4 text-green-600" />
                                                }
                                                else
                                                {
                                                    <LucideIconCn Name="copy" Size="14" Class="size-3.5 text-muted-foreground transition-colors group-hover:text-foreground" />
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-t bg-muted/30 px-6 py-4">
            <div class="flex items-center justify-between">
                <p class="text-muted-foreground text-sm">
                    @_colorSwatches.Length colors across @_categories.Length categories
                </p>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">
                    Export Palette
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record ColorSwatch(string Id, string Name, string Hex, string Category);

    private string? _copiedId = null;

    private System.Threading.CancellationTokenSource? _cts;

    private async Task CopyToClipboard(string hex, string id)
    {
        _copiedId = id;
        _cts?.Cancel();
        _cts = new System.Threading.CancellationTokenSource();
        var token = _cts.Token;
        StateHasChanged();
        try
        {
            await Task.Delay(2000, token);
            _copiedId = null;
        }
        catch (TaskCanceledException) { }
    }

    private static readonly ColorSwatch[] _colorSwatches =
    [
        new("1",  "Primary",      "#3B82F6", "Brand"),
        new("2",  "Primary Dark", "#2563EB", "Brand"),
        new("3",  "Primary Light","#60A5FA", "Brand"),
        new("4",  "Secondary",    "#8B5CF6", "Brand"),
        new("5",  "Accent",       "#EC4899", "Brand"),
        new("6",  "Success",      "#10B981", "Semantic"),
        new("7",  "Warning",      "#F59E0B", "Semantic"),
        new("8",  "Error",        "#EF4444", "Semantic"),
        new("9",  "Info",         "#06B6D4", "Semantic"),
        new("10", "Background",   "#FFFFFF", "Neutral"),
        new("11", "Foreground",   "#18181B", "Neutral"),
        new("12", "Muted",        "#F4F4F5", "Neutral"),
        new("13", "Border",       "#E4E4E7", "Neutral"),
        new("14", "Card",         "#FAFAFA", "Neutral"),
        new("15", "Popover",      "#FFFFFF", "Neutral"),
    ];

    private static readonly string[] _categories =
        _colorSwatches.Select(s => s.Category).Distinct().ToArray();
}
