@* ============================================================
   Block: gallery-slider-fullwidth
   Title: GallerySliderFullwidth
   Description: A full-width image slider with navigation controls built with React, Next.js, shadcn/ui, and Tailwind CSS. Features autoplay indicator, slide counter, and thumbnail strip navigation.
   Source: original/blocks/gallery/gallery-slider-fullwidth.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Full-Width Slider</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Navigate with arrows or thumbnails
                    </p>
                </div>
                <div class="flex items-center gap-2">
                    <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                        @if (_isPaused)
                        {
                            <LucideIconCn Name="pause" Size="12" Class="size-3" />
                            <span>Paused</span>
                        }
                    </div>
                    <div class="flex items-center gap-1 text-xs">
                        <span class="tabular-nums font-medium text-foreground">@(_currentIndex + 1)</span>
                        <span class="text-muted-foreground">/</span>
                        <span class="tabular-nums text-muted-foreground">@_slideItems.Length</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="relative">
            @* Main Slide *@
            <div class="relative overflow-hidden bg-muted">
                <div class="relative aspect-video">
                    <img src="@_slideItems[_currentIndex].Image"
                         alt="@_slideItems[_currentIndex].Title"
                         class="size-full object-cover" />
                    <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-t from-black/60 via-transparent to-transparent">
                        <div class="text-center">
                            <h3 class="mt-4 text-lg font-medium text-white">@_slideItems[_currentIndex].Title</h3>
                            <p class="mt-1 text-sm text-white/80">@_slideItems[_currentIndex].Subtitle</p>
                            <p class="mt-2 text-xs font-medium text-white/70">
                                @_slideItems[_currentIndex].Location
                            </p>
                        </div>
                    </div>
                </div>

                @* Navigation Buttons *@
                <div class="absolute inset-y-0 left-0 flex items-center pl-4">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="size-8 rounded-full bg-background/80 backdrop-blur-sm" @onclick="HandlePrevious">
                        <LucideIconCn Name="chevron-left" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
                <div class="absolute inset-y-0 right-0 flex items-center pr-4">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="size-8 rounded-full bg-background/80 backdrop-blur-sm" @onclick="HandleNext">
                        <LucideIconCn Name="chevron-right" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </div>

            @* Thumbnail Strip *@
            <div class="border-t bg-muted/30 p-3">
                <div class="flex gap-2 overflow-x-auto pb-1">
                    @foreach (var (slide, index) in _slideItems.Select((s, i) => (s, i)))
                    {
                        var idx = index;
                        <button type="button"
                                @onclick="@(() => HandleThumbnailClick(idx))"
                                class="@Cn.Merge("group relative shrink-0 overflow-hidden rounded border-2 transition-all", _currentIndex == idx ? "border-foreground" : "border-transparent hover:border-muted-foreground/30")">
                            <img src="@slide.Image"
                                 alt="@slide.Title"
                                 class="size-16 object-cover transition-opacity group-hover:opacity-80" />
                            @if (_currentIndex == idx)
                            {
                                <div class="absolute inset-x-0 bottom-0 h-0.5 bg-foreground"></div>
                            }
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record SlideItem(string Id, string Title, string Subtitle, string Location, string Image);

    private int _currentIndex = 0;
    private bool _isPaused = false;

    private void HandlePrevious()
    {
        _currentIndex = _currentIndex == 0 ? _slideItems.Length - 1 : _currentIndex - 1;
    }

    private void HandleNext()
    {
        _currentIndex = _currentIndex == _slideItems.Length - 1 ? 0 : _currentIndex + 1;
    }

    private void HandleThumbnailClick(int index)
    {
        _currentIndex = index;
    }

    private static readonly SlideItem[] _slideItems =
    [
        new("1", "Mountain Peaks", "Explore breathtaking alpine landscapes", "Swiss Alps",
