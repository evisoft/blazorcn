@* ============================================================
   Block: gallery-media-library
   Title: GalleryMediaLibrary
   Description: A media library manager view with grid/list toggle, file type icons, and filtering toolbar built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/gallery/gallery-media-library.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Media Library</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">@_filteredFiles.Length files</p>
                </div>
                <div class="flex items-center gap-1">
                    <ButtonCn Variant="@(_view == "grid" ? ButtonVariant.Outline : ButtonVariant.Ghost)"
                              Size="ButtonSize.Sm"
                              Class="h-7 px-2"
                              aria-label="Grid view" OnClick="@(() => _view = "grid")">
                        <LucideIconCn Name="grid-3x3" Size="14" Class="size-3.5" />
                    </ButtonCn>
                    <ButtonCn Variant="@(_view == "list" ? ButtonVariant.Outline : ButtonVariant.Ghost)"
                              Size="ButtonSize.Sm"
                              Class="h-7 px-2"
                              aria-label="List view" OnClick="@(() => _view = "list")">
                        <LucideIconCn Name="list" Size="14" Class="size-3.5" />
                    </ButtonCn>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="relative flex-1">
                    <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                    <InputCn Placeholder="Search files..."
                             aria-label="Search files"
                             Class="h-8 border-0 bg-muted/50 pl-8 text-xs shadow-none focus-visible:ring-0" />
                </div>
                <DropdownMenuCn>
                    <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-sm h-8 gap-1.5 px-2.5 text-xs" data-variant="outline" data-size="sm">
                            <LucideIconCn Name="filter" Size="14" Class="size-3.5" />
                            Type
                        </DropdownMenuTriggerCn>
                    <DropdownMenuContentCn Align="FloatingAlign.End" Class="w-48">
                        <DropdownMenuCheckboxItemCn Checked="@_showImages" CheckedChanged="@((v) => ToggleType("image", v))">
                            <span class="flex items-center gap-2">
                                <LucideIconCn Name="file-image" Size="14" Class="size-3.5" />
                                Images (@_typeCountImage)
                            </span>
                        </DropdownMenuCheckboxItemCn>
                        <DropdownMenuCheckboxItemCn Checked="@_showVideos" CheckedChanged="@((v) => ToggleType("video", v))">
                            <span class="flex items-center gap-2">
                                <LucideIconCn Name="file-video" Size="14" Class="size-3.5" />
                                Videos (@_typeCountVideo)
                            </span>
                        </DropdownMenuCheckboxItemCn>
                        <DropdownMenuCheckboxItemCn Checked="@_showDocuments" CheckedChanged="@((v) => ToggleType("document", v))">
                            <span class="flex items-center gap-2">
                                <LucideIconCn Name="file-text" Size="14" Class="size-3.5" />
                                Documents (@_typeCountDocument)
                            </span>
                        </DropdownMenuCheckboxItemCn>
                    </DropdownMenuContentCn>
                </DropdownMenuCn>
            </div>
        </div>

        <div class="p-4">
            @if (_view == "grid")
            {
                <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
                    @foreach (var mf in _filteredFiles)
                    {
                        var file = mf;
                        <button type="button"
                                class="group overflow-hidden rounded-md border bg-muted/50 p-3 text-left transition-colors hover:border-foreground/20 hover:bg-muted">
                            <div class="mb-2 flex aspect-square items-center justify-center overflow-hidden rounded bg-muted">
                                @if (!string.IsNullOrEmpty(file.Image))
                                {
                                    <img src="@file.Image" alt="" class="h-full w-full object-cover" />
                                }
                                else if (file.Type == "video")
                                {
                                    <LucideIconCn Name="file-video" Size="32" Class="size-8 text-muted-foreground/40" />
                                }
                                else if (file.Type == "document")
                                {
                                    <LucideIconCn Name="file-text" Size="32" Class="size-8 text-muted-foreground/40" />
                                }
                                else
                                {
                                    <LucideIconCn Name="file-image" Size="32" Class="size-8 text-muted-foreground/40" />
                                }
                            </div>
                            <p class="truncate text-xs font-medium">@file.Name</p>
                            <div class="mt-1 flex items-center justify-between text-xs text-muted-foreground">
                                <span>@file.Size</span>
                                <span>@file.UploadDate</span>
                            </div>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="space-y-1">
                    @foreach (var mf in _filteredFiles)
                    {
                        var file = mf;
                        <button type="button"
                                class="flex w-full items-center gap-3 rounded-md px-3 py-2.5 text-left transition-colors hover:bg-muted/50">
                            <div class="flex size-10 shrink-0 items-center justify-center rounded bg-muted">
                                @if (file.Type == "video")
                                {
                                    <LucideIconCn Name="file-video" Size="20" Class="size-5 text-muted-foreground" />
                                }
                                else if (file.Type == "document")
                                {
                                    <LucideIconCn Name="file-text" Size="20" Class="size-5 text-muted-foreground" />
                                }
                                else
                                {
                                    <LucideIconCn Name="file-image" Size="20" Class="size-5 text-muted-foreground" />
                                }
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="truncate text-sm font-medium">@file.Name</p>
                                <p class="text-xs text-muted-foreground">
                                    @file.Size · @file.UploadDate
                                </p>
                            </div>
                        </button>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record MediaFile(string Id, string Name, string Type, string Size, string UploadDate, string? Image = null);

    private string _view = "grid";
    private bool _showImages = true;
    private bool _showVideos = true;
    private bool _showDocuments = true;

    private static readonly MediaFile[] _mediaFiles =
    [
        new("1", "hero-banner.jpg", "image", "2.4 MB", "2 hours ago",
            "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=800&auto=format&fit=crop"),
        new("2", "product-demo.mp4", "video", "15.8 MB", "5 hours ago"),
        new("3", "brand-guidelines.pdf", "document", "1.2 MB", "1 day ago"),
        new("4", "team-photo.png", "image", "3.1 MB", "2 days ago",
            "https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=800&auto=format&fit=crop"),
        new("5", "tutorial-video.mp4", "video", "22.5 MB", "3 days ago"),
        new("6", "presentation.pdf", "document", "890 KB", "1 week ago"),
    ];

    private int _typeCountImage => _mediaFiles.Count(f => f.Type == "image");
    private int _typeCountVideo => _mediaFiles.Count(f => f.Type == "video");
    private int _typeCountDocument => _mediaFiles.Count(f => f.Type == "document");

    private MediaFile[] _filteredFiles =>
        _mediaFiles.Where(f =>
            (f.Type == "image" && _showImages) ||
            (f.Type == "video" && _showVideos) ||
            (f.Type == "document" && _showDocuments)
        ).ToArray();

    private void ToggleType(string type, bool value)
    {
        if (type == "image") _showImages = value;
        else if (type == "video") _showVideos = value;
        else if (type == "document") _showDocuments = value;
    }
}
