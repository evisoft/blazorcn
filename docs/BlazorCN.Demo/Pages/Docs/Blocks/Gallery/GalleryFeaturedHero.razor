@* ============================================================
   Block: gallery-featured-hero
   Title: GalleryFeaturedHero
   Description: A hero gallery with featured image and thumbnail navigation built with React, Next.js, shadcn/ui, and Tailwind CSS. Click thumbnails to swap the featured image with smooth transitions.
   Source: original/blocks/gallery/gallery-featured-hero.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Featured Gallery</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Click thumbnails to change the featured image
            </p>
        </div>

        <div class="p-4">
            <div class="space-y-4">
                @* Featured Image *@
                <div class="relative overflow-hidden rounded-lg border">
                    <div class="relative aspect-video w-full">
                        <img src="@_selectedImage.Image"
                             alt="@_selectedImage.Title"
                             class="aspect-video w-full object-cover" />
                        <div class="absolute inset-0 flex items-end bg-gradient-to-t from-black/60 to-transparent p-4">
                            <div>
                                <p class="text-sm font-medium text-white">@_selectedImage.Title</p>
                                <p class="mt-1 text-xs text-white/80">@_selectedImage.Category</p>
                            </div>
                        </div>
                    </div>
                </div>

                @* Thumbnail Strip *@
                <div class="grid grid-cols-5 gap-2">
                    @foreach (var img in _galleryImages)
                    {
                        var image = img;
                        var idx = Array.IndexOf(_galleryImages, image);
                        <button type="button"
                                class="@Cn.Merge("group relative overflow-hidden rounded-md border-2 transition-all", _selectedIndex == idx ? "border-foreground" : "border-transparent hover:border-muted-foreground/30")"
                                @onclick="@(() => _selectedIndex = idx)">
                            <img src="@image.Image"
                                 alt="@image.Title"
                                 class="aspect-video object-cover transition-opacity group-hover:opacity-80" />
                            @if (_selectedIndex == idx)
                            {
                                <div class="absolute inset-0 border-2 border-foreground"></div>
                            }
                        </button>
                    }
                </div>

                @* Image Counter *@
                <div class="flex items-center justify-center gap-2 text-xs text-muted-foreground">
                    <span class="tabular-nums font-medium text-foreground">@(_selectedIndex + 1)</span>
                    <span>/</span>
                    <span class="tabular-nums">@_galleryImages.Length</span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record GalleryImage(string Id, string Title, string Category, string Image);

    private int _selectedIndex = 0;
    private GalleryImage _selectedImage => _galleryImages[_selectedIndex];

    private static readonly GalleryImage[] _galleryImages =
    [
        new("1", "Mountain Landscape", "Nature",
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop"),
        new("2", "Urban Architecture", "Architecture",
            "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=800&auto=format&fit=crop"),
        new("3", "Ocean Sunset", "Seascape",
            "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&auto=format&fit=crop"),
        new("4", "Forest Trail", "Nature",
            "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800&auto=format&fit=crop"),
        new("5", "City Skyline", "Urban",
            "https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=800&auto=format&fit=crop"),
    ];
}
