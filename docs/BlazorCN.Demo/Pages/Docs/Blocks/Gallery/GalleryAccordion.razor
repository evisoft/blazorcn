@* ============================================================
   Block: gallery-accordion
   Title: GalleryAccordion
   Description: An interactive accordion-style gallery with expandable vertical strips built with React, Next.js, shadcn/ui, Tailwind CSS, and Framer Motion for smooth width transitions
   Source: original/blocks/gallery/gallery-accordion.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Accordion Gallery</h2>
            <p class="mt-1 text-muted-foreground text-xs">Expandable vertical strips</p>
        </div>

        <div class="p-4">
            <div class="flex h-[500px] gap-2 overflow-hidden rounded-lg">
                @foreach (var img in _images)
                {
                    var image = img;
                    var isActive = _activeIndex == image.Index;
                    var isInactive = _activeIndex != null && _activeIndex != image.Index;
                    var flexStyle = isActive ? "flex: 1 1 60%" : (isInactive ? "flex: 1 1 10%" : "flex: 1 1 20%");
                    var writingModeStyle = isInactive ? "writing-mode:vertical-rl;transform:rotate(180deg)" : "writing-mode:horizontal-tb;transform:none";
                    var borderOpacity = isActive ? "opacity-100" : "opacity-0";
                    <button class="group relative overflow-hidden rounded-md"
                            style="@flexStyle; transition: flex 0.4s cubic-bezier(0.4,0,0.2,1);"
                            @onclick="@(() => HandleClick(image.Index))"
                            type="button">
                        <img src="@image.Image" alt="@image.Title" class="h-full w-full object-cover" />

                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>

                        <div class="absolute inset-0 flex items-center justify-center">
                            @if (isActive)
                            {
                                <div class="text-center text-white">
                                    <div class="mb-2 text-xs text-white/80">Image @(image.Index + 1)</div>
                                    <div class="mb-1 text-lg font-semibold">@image.Title</div>
                                    <div class="text-sm text-white/80">@image.Subtitle</div>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-white">
                                    <div class="text-sm font-medium transition-opacity group-hover:opacity-100"
                                         style="@writingModeStyle">
                                        @image.Title
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="@Cn.Merge("absolute inset-0 border-2 border-primary transition-opacity", borderOpacity)"></div>
                    </button>
                }
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-center text-muted-foreground text-xs">Click any strip to expand</p>
        </div>
    </div>
</section>

@code {
    private record GalleryImage(int Index, string Id, string Title, string Subtitle, string Image);

    private int? _activeIndex = 2;

    private void HandleClick(int index)
    {
        _activeIndex = _activeIndex == index ? null : index;
    }

    private static readonly GalleryImage[] _images =
    [
        new(0, "1", "Mountain Peaks", "Alpine Region",
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop"),
        new(1, "2", "Ocean Waves", "Pacific Coast",
            "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&auto=format&fit=crop"),
        new(2, "3", "Forest Path", "Ancient Woods",
            "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&auto=format&fit=crop"),
        new(3, "4", "Desert Sand", "Sahara Dunes",
            "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800&auto=format&fit=crop"),
        new(4, "5", "City Lights", "Urban Landscape",
            "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=800&auto=format&fit=crop"),
    ];
}
