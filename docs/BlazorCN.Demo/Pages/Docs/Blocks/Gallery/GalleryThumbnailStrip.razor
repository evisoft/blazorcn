@* ============================================================
   Block: gallery-thumbnail-strip
   Title: GalleryThumbnailStrip
   Description: A gallery with large preview area and horizontal scrollable thumbnail strip built with React, Next.js, shadcn/ui, Tailwind CSS, and Framer Motion for smooth transitions and navigation
   Source: original/blocks/gallery/gallery-thumbnail-strip.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Thumbnail Strip Gallery</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Large preview with scrollable thumbnails
            </p>
        </div>

        <div class="relative border-b">
            <div class="relative h-[400px]">
                <div class="h-full w-full">
                    <img src="@_images[_activeIndex].Image"
                         alt="@_images[_activeIndex].Title"
                         class="h-full w-full object-cover" />
                    <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent p-4">
                        <div class="text-center text-white">
                            <div class="mb-1 text-lg font-semibold">@_images[_activeIndex].Title</div>
                            <div class="inline-block rounded-full bg-white/20 px-2 py-1 text-xs backdrop-blur-sm">
                                @_images[_activeIndex].Category
                            </div>
                        </div>
                    </div>
                </div>

                <div class="absolute inset-x-4 top-1/2 flex -translate-y-1/2 justify-between">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="h-8 w-8 rounded-full bg-background shadow-md" @onclick="HandlePrevious" aria-label="Previous">
                        <LucideIconCn Name="chevron-left" Size="16" Class="size-4" />
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="h-8 w-8 rounded-full bg-background shadow-md" @onclick="HandleNext" aria-label="Next">
                        <LucideIconCn Name="chevron-right" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </div>
        </div>

        <div class="relative px-4 py-4">
            <div class="flex gap-2 overflow-x-auto pb-2" style="scrollbar-width:thin">
                @foreach (var (img, index) in _images.Select((im, i) => (im, i)))
                {
                    var idx = index;
                    <button type="button"
                            @onclick="@(() => SetActive(idx))"
                            class="group relative shrink-0">
                        <div class="@Cn.Merge("h-20 w-24 overflow-hidden rounded-md border-2 transition-all", idx == _activeIndex ? "border-primary ring-2 ring-primary ring-offset-2" : "border-transparent opacity-60 group-hover:opacity-100")">
                            <img src="@img.Image" alt="@img.Title" class="h-full w-full object-cover" />
                        </div>
                    </button>
                }
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">
                    @(_activeIndex + 1) / @_images.Length
                </span>
                <span class="text-muted-foreground">Click thumbnails to navigate</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record GalleryImage(string Id, string Title, string Category, string Image);

    private int _activeIndex = 0;

    private void SetActive(int index)
    {
        _activeIndex = index;
    }

    private void HandlePrevious()
    {
        _activeIndex = _activeIndex > 0 ? _activeIndex - 1 : _images.Length - 1;
    }

    private void HandleNext()
    {
        _activeIndex = _activeIndex < _images.Length - 1 ? _activeIndex + 1 : 0;
    }

    private static readonly GalleryImage[] _images =
    [
        new("1", "Mountain Vista", "Landscape",
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop"),
