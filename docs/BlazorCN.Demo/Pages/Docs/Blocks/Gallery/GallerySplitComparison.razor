@* ============================================================
   Block: gallery-split-comparison
   Title: GallerySplitComparison
   Description: A side-by-side comparison gallery built with React, Next.js, shadcn/ui, and Tailwind CSS. Compare items with images and detailed specifications with highlighted differences.
   Source: original/blocks/gallery/gallery-split-comparison.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Compare Options</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Side-by-side comparison with key differences highlighted
            </p>
        </div>

        @* Comparisons *@
        <div class="divide-y">
            @foreach (var comparison in _comparisons)
            {
                <div class="p-4">
                    @* Images *@
                    <div class="grid grid-cols-[1fr,auto,1fr] gap-3">
                        <div class="space-y-2">
                            <img
                                src="@comparison.Left.Image"
                                alt="@comparison.Left.Title"
                                class="aspect-video overflow-hidden rounded-lg object-cover" />
                            <div>
                                <h3 class="font-medium text-sm">@comparison.Left.Title</h3>
                                <p class="text-muted-foreground text-xs">@comparison.Left.Subtitle</p>
                            </div>
                        </div>

                        <div class="flex items-center justify-center">
                            <BadgeCn Variant="BadgeVariant.Outline" Class="text-muted-foreground text-xs">
                                VS
                            </BadgeCn>
                        </div>

                        <div class="space-y-2">
                            <img
                                src="@comparison.Right.Image"
                                alt="@comparison.Right.Title"
                                class="aspect-video overflow-hidden rounded-lg object-cover" />
                            <div>
                                <h3 class="font-medium text-sm">@comparison.Right.Title</h3>
                                <p class="text-muted-foreground text-xs">@comparison.Right.Subtitle</p>
                            </div>
                        </div>
                    </div>

                    @* Specifications *@
                    <div class="mt-4 space-y-2">
                        @foreach (var spec in comparison.Specs)
                        {
                            <div class="@Cn.Merge("grid grid-cols-[1fr,auto,1fr] items-center gap-3 rounded-md px-3 py-2 transition-colors", spec.IsDifferent ? "bg-muted/50" : "bg-transparent")">
                                <div class="flex items-center gap-2">
                                    @if (spec.LeftBool.HasValue)
                                    {
                                        @if (spec.LeftBool.Value)
                                        {
                                            <LucideIconCn Name="check" Size="14" Class="size-3.5 text-green-500" />
                                        }
                                        else
                                        {
                                            <LucideIconCn Name="x" Size="14" Class="size-3.5 text-red-500" />
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-xs">@spec.LeftText</span>
                                    }
                                </div>

                                <span class="text-muted-foreground text-xs">@spec.Label</span>

                                <div class="flex items-center justify-end gap-2">
                                    @if (spec.RightBool.HasValue)
                                    {
                                        @if (spec.RightBool.Value)
                                        {
                                            <LucideIconCn Name="check" Size="14" Class="size-3.5 text-green-500" />
                                        }
                                        else
                                        {
                                            <LucideIconCn Name="x" Size="14" Class="size-3.5 text-red-500" />
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-xs">@spec.RightText</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record SideInfo(string Title, string Subtitle, string Category, string Image);

    private record SpecRow(string Label, string? LeftText, bool? LeftBool, string? RightText, bool? RightBool, bool IsDifferent);

    private record ComparisonItem(string Id, SideInfo Left, SideInfo Right, SpecRow[] Specs);

    private static readonly ComparisonItem[] _comparisons =
    [
        new(
            "1",
            new SideInfo("Standard Plan", "For individuals", "Personal",
                "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&h=450&auto=format&fit=crop"),
            new SideInfo("Pro Plan", "For professionals", "Business",
                "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&h=450&auto=format&fit=crop"),
            [
                new("Storage",    "10 GB",   null,  "100 GB",   null,  true),
                new("Users",      "1",       null,  "5",        null,  true),
                new("Support",    "Email",   null,  "Priority", null,  true),
                new("API Access", null,      false, null,       true,  true),
                new("SSL",        null,      true,  null,       true,  false),
                new("Backups",    "Weekly",  null,  "Daily",    null,  true),
            ]
        ),
        new(
