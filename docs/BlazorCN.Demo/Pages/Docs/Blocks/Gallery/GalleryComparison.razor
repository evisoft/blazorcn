@* ============================================================
   Block: gallery-comparison
   Title: GalleryComparison
   Description: A side-by-side image comparison grid for React, Next.js, shadcn/ui, and Tailwind CSS applications. Perfect for A/B testing, before/after, and product comparisons.
   Source: original/blocks/gallery/gallery-comparison.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Comparison Gallery</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Side-by-side comparisons</p>
        </div>

        <div class="divide-y">
            @foreach (var comparison in _comparisons)
            {
                <div class="p-4">
                    <div class="mb-3 flex items-start justify-between gap-2">
                        <div>
                            <h3 class="text-sm font-medium">@comparison.Title</h3>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="mt-1 text-xs">
                                @comparison.Category
                            </BadgeCn>
                        </div>
                    </div>

                    <div class="grid grid-cols-[1fr,auto,1fr] items-center gap-3">
                        <div class="space-y-2">
                            <img
                                src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=800&auto=format&fit=crop&h=450"
                                alt=""
                                class="aspect-video w-full rounded-md object-cover" />
                            <p class="text-center text-xs text-muted-foreground">
                                @comparison.LeftLabel
                            </p>
                        </div>

                        <div class="flex flex-col items-center gap-1">
                            <div class="flex size-8 items-center justify-center rounded-full bg-muted">
                                <span class="text-xs font-medium text-muted-foreground">VS</span>
                            </div>
                        </div>

                        <div class="space-y-2">
                            <img
                                src="https://images.unsplash.com/photo-1472214103451-9374bd1c798e?w=800&auto=format&fit=crop&h=450"
                                alt=""
                                class="aspect-video w-full rounded-md object-cover" />
                            <p class="text-center text-xs text-muted-foreground">
                                @comparison.RightLabel
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                @_comparisons.Length comparisons
            </p>
        </div>
    </div>
</section>

@code {
    private record ComparisonPair(string Id, string Title, string LeftLabel, string RightLabel, string Category);

    private static readonly ComparisonPair[] _comparisons =
    [
        new("1", "Modern Architecture Redesign", "Original", "Redesigned", "Architecture"),
        new("2", "Color Grading Comparison", "Before", "After", "Photography"),
        new("3", "UI Layout Update", "Version 1.0", "Version 2.0", "Design"),
        new("4", "Product Photo Enhancement", "Raw", "Enhanced", "Photography"),
    ];
}
