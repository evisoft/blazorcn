@* ============================================================
   Block: gallery-video-thumbnails
   Title: GalleryVideoThumbnails
   Description: A video thumbnail gallery component with play button overlays and metadata built with React, Next.js, shadcn/ui, and Tailwind CSS. Perfect for video libraries and course platforms.
   Source: original/blocks/gallery/gallery-video-thumbnails.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-4">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="font-semibold text-lg">Video Library</h2>
                    <p class="mt-1 text-muted-foreground text-sm">
                        Browse our collection of tutorials and courses
                    </p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">
                    View All
                </ButtonCn>
            </div>
        </div>

        <div class="grid gap-4 p-6 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var vid in _videos)
            {
                var video = vid;
                <div class="group cursor-pointer">
                    @* Thumbnail *@
                    <div class="relative aspect-video overflow-hidden rounded-lg border">
                        <img src="@video.Image" alt="@video.Title" class="size-full object-cover" />

                        @* Play Button Overlay *@
                        <div class="absolute inset-0 flex items-center justify-center bg-black/40 transition-all duration-200 group-hover:bg-black/50">
                            <div class="flex size-14 items-center justify-center rounded-full bg-white shadow-lg transition-transform duration-200 group-hover:scale-110">
                                <LucideIconCn Name="play" Size="24" Class="ml-0.5 size-6 fill-black text-black" />
                            </div>
                        </div>

                        @* Duration Badge *@
                        <div class="absolute bottom-2 right-2 flex items-center gap-1 rounded bg-black/80 px-1.5 py-0.5 text-white text-xs">
                            <LucideIconCn Name="clock" Size="12" Class="size-3" />
                            @video.Duration
                        </div>

                        @* New Badge *@
                        @if (video.IsNew)
                        {
                            <div class="absolute top-2 left-2">
                                <BadgeCn Class="bg-red-500 text-white hover:bg-red-600">New</BadgeCn>
                            </div>
                        }
                    </div>

                    @* Video Info *@
                    <div class="mt-3 space-y-1.5">
                        <h3 class="line-clamp-2 font-medium text-sm leading-snug group-hover:text-foreground/80">
                            @video.Title
                        </h3>
                        <div class="flex items-center gap-3 text-muted-foreground text-xs">
                            <div class="flex items-center gap-1">
                                <LucideIconCn Name="eye" Size="12" Class="size-3" />
                                @video.Views views
                            </div>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                                @video.Category
                            </BadgeCn>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-6 py-3">
            <p class="text-center text-muted-foreground text-xs">
                Showing @_videos.Length of 120+ videos
            </p>
        </div>
    </div>
</section>

@code {
    private record Video(string Id, string Title, string Duration, string Views, string Category, string Image, bool IsNew = false);

    private static readonly Video[] _videos =
    [
        new("1", "Getting Started with React Server Components", "12:34", "45.2K", "Tutorial",
            "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&h=450&auto=format&fit=crop",
            IsNew: true),
        new("2", "Building a Full-Stack App with Next.js 16", "28:15", "32.8K", "Course",
            "https://images.unsplash.com/photo-1518173946687-a544bf02a536?w=800&h=450&auto=format&fit=crop"),
        new("3", "Tailwind CSS 4.0 New Features", "8:42", "28.5K", "Update",
            "https://images.unsplash.com/photo-1475924156734-496f6cac6ec1?w=800&h=450&auto=format&fit=crop",
