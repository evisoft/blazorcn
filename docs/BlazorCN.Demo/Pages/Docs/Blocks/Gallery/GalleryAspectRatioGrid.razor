@* ============================================================
   Block: gallery-aspect-ratio-grid
   Title: GalleryAspectRatioGrid
   Description: A gallery demonstrating different aspect ratios with interactive selector built with React, Next.js, shadcn/ui, and Tailwind CSS. Features 1:1, 4:3, 16:9, 3:2, and 9:16 ratios with toggle controls.
   Source: original/blocks/gallery/gallery-aspect-ratio-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Aspect Ratio Gallery</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Different image aspect ratios demonstration
            </p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex flex-wrap gap-2">
                <ButtonCn Variant="@(_selectedRatio == null ? ButtonVariant.Default : ButtonVariant.Outline)"
                          Size="ButtonSize.Sm"
                          Class="h-7 text-xs"
                          OnClick="@(() => _selectedRatio = null)">
                    All Ratios
                </ButtonCn>
                @foreach (var ar in _aspectRatios)
                {
                    var item = ar;
                    <ButtonCn Variant="@(_selectedRatio == item.Id ? ButtonVariant.Default : ButtonVariant.Outline)"
                              Size="ButtonSize.Sm"
                              Class="h-7 text-xs"
                              OnClick="@(() => _selectedRatio = item.Id)">
                        @item.Ratio
                    </ButtonCn>
                }
            </div>
        </div>

        <div class="p-4">
            <div class="grid grid-cols-2 gap-4">
                @foreach (var ar in FilteredRatios)
                {
                    <div class="w-full">
                        <div class="relative w-full overflow-hidden rounded-md">
                            <img src="@ar.Image"
                                 alt="@($"{ar.Label} - {ar.Ratio}")"
                                 class="@($"{ar.Class} w-full object-cover")" />
                            <div class="absolute inset-0 flex flex-col items-center justify-center bg-black/40">
                                <span class="font-medium text-sm text-white">@ar.Ratio</span>
                                <span class="mt-1 text-xs text-white/80">@ar.Label</span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-4 space-y-2">
                <div class="flex items-center gap-2 rounded-md bg-muted/50 p-3">
                    <div class="size-1.5 shrink-0 rounded-full bg-blue-500"></div>
                    <p class="text-muted-foreground text-xs">
                        @if (_selectedRatio != null)
                        {
                            @($"Showing {FilteredRatios[0].Ratio} aspect ratio")
                        }
                        else
                        {
                            @($"Showing {_aspectRatios.Length} aspect ratios")
                        }
                    </p>
                </div>

                <div class="grid grid-cols-2 gap-2">
                    @foreach (var ar in _aspectRatios)
                    {
                        <div class="flex items-center gap-2 text-xs">
                            <div class="@($"size-3 shrink-0 rounded {ar.Color}")"></div>
                            <span class="text-muted-foreground">@ar.Ratio - @ar.Label</span>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private record AspectRatioItem(string Id, string Label, string Ratio, string Class, string Color, string Image);

    private static readonly AspectRatioItem[] _aspectRatios =
    [
        new("1", "Square", "1:1", "aspect-square", "bg-blue-500/10",
            "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=600&h=600&auto=format&fit=crop"),
        new("2", "Standard", "4:3", "aspect-[4/3]", "bg-purple-500/10",
            "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&h=600&auto=format&fit=crop"),
        new("3", "Widescreen", "16:9", "aspect-video", "bg-green-500/10",
            "https://images.unsplash.com/photo-1518173946687-a544bf02a536?w=800&h=450&auto=format&fit=crop"),
        new("4", "Classic", "3:2", "aspect-[3/2]", "bg-amber-500/10",
            "https://images.unsplash.com/photo-1475924156734-496f6cac6ec1?w=800&h=600&auto=format&fit=crop"),
        new("5", "Portrait", "9:16", "aspect-[9/16]", "bg-pink-500/10",
            "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=600&h=600&auto=format&fit=crop"),
    ];

    private string? _selectedRatio = null;

    private AspectRatioItem[] FilteredRatios =>
        _selectedRatio != null
            ? _aspectRatios.Where(ar => ar.Id == _selectedRatio).ToArray()
            : _aspectRatios;
}
