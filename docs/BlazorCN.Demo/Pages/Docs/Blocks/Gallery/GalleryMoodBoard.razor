@* ============================================================
   Block: gallery-mood-board
   Title: GalleryMoodBoard
   Description: A creative mood board layout with overlapping, rotated items and pinning functionality built with React, Next.js, shadcn/ui, Framer Motion, and Tailwind CSS. Features organic, scattered positioning.
   Source: original/blocks/gallery/gallery-mood-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Mood Board</h2>
            <p class="mt-1 text-muted-foreground text-xs">Click items to pin them in place</p>
        </div>

        <div class="p-4">
            <div class="relative h-[500px] overflow-hidden rounded-lg border bg-muted/30">
                @foreach (var it in _items)
                {
                    var item = it;
                    var isPinned = _pinnedIds.Contains(item.Id);
                    <button type="button"
                            class="@Cn.Merge("group absolute overflow-hidden rounded-lg border-2 bg-card shadow-lg transition-all hover:z-10 hover:scale-105 hover:shadow-xl", _sizeMap[item.Size], isPinned ? "border-foreground" : "border-border")"
                            style="@($"left:{item.X}px;top:{item.Y}px;rotate:{item.Rotation}deg")"
                            @onclick="@(() => TogglePin(item.Id))">
                        <img src="@item.Image" alt="" class="size-full object-cover" />
                        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-2">
                            <p class="truncate font-medium text-white text-xs">@item.Title</p>
                        </div>
                        <div class="@Cn.Merge("absolute right-1 top-1 rounded-full bg-white p-1 shadow-sm transition-colors", isPinned ? "text-foreground" : "text-muted-foreground opacity-0 group-hover:opacity-100")">
                            <LucideIconCn Name="pin" Size="12" Class="size-3" />
                        </div>
                    </button>
                }
            </div>
        </div>

        <div class="border-t bg-muted/50 px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <div class="flex items-center gap-2 text-muted-foreground">
                    <LucideIconCn Name="pin" Size="16" Class="size-4" />
                    <span>@_pinnedIds.Count items pinned</span>
                </div>
                <p class="text-muted-foreground">Click items to pin or unpin</p>
            </div>
        </div>
    </div>
</section>

@code {
    private record MoodBoardItem(string Id, string Title, int Rotation, int X, int Y, string Size, string Image);

    private HashSet<string> _pinnedIds = [];

    private static readonly Dictionary<string, string> _sizeMap = new()
    {
        ["sm"] = "w-32 h-32",
        ["md"] = "w-40 h-40",
        ["lg"] = "w-48 h-48",
    };

    private static readonly MoodBoardItem[] _items =
    [
        new("1", "Sunrise",  -3, 10,  20,  "md",
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=600&h=600&auto=format&fit=crop"),
        new("2", "Portrait",  5, 180, 40,  "sm",
            "https://images.unsplash.com/photo-1550859492-d5da9d8e45f3?w=600&h=600&auto=format&fit=crop"),
        new("3", "Abstract", -2, 300, 15,  "lg",
            "https://images.unsplash.com/photo-1557672172-298e090bd0f1?w=600&h=600&auto=format&fit=crop"),
        new("4", "Forest",    4, 40,  180, "md",
            "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=600&h=600&auto=format&fit=crop"),
        new("5", "City",     -5, 220, 160, "sm",
            "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=600&h=600&auto=format&fit=crop"),
        new("6", "Ocean",     3, 350, 190, "md",
            "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=600&h=600&auto=format&fit=crop"),
    ];

    private void TogglePin(string id)
    {
        if (_pinnedIds.Contains(id))
            _pinnedIds.Remove(id);
        else
            _pinnedIds.Add(id);
    }
}
