@* ============================================================
   Block: gallery-polaroid
   Title: GalleryPolaroid
   Description: A nostalgic polaroid-style gallery with white borders and scattered layout for React, Next.js, shadcn/ui, and Tailwind CSS applications. Features rotation animations on hover.
   Source: original/blocks/gallery/gallery-polaroid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Polaroid Gallery</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Vintage photo collection</p>
        </div>

        <div class="p-4">
            <div class="grid grid-cols-2 gap-6 sm:grid-cols-3">
                @foreach (var img in _images)
                {
                    var image = img;
                    <div class="group cursor-pointer"
                         style="@($"transform: rotate({image.Rotation}deg); transition: transform 0.2s ease, box-shadow 0.2s ease;")">
                        <div class="rounded-sm bg-white p-3 shadow-md transition-shadow group-hover:shadow-xl">
                            <img
                                src="https://images.unsplash.com/photo-1475924156734-496f6cac6ec1?w=600&auto=format&fit=crop&h=600"
                                alt=""
                                class="aspect-square w-full rounded-sm object-cover" />
                            <div class="mt-3 space-y-1">
                                <p class="text-center font-medium text-foreground text-sm">
                                    @image.Caption
                                </p>
                                <div class="flex items-center justify-between text-muted-foreground text-xs">
                                    <span>@image.Location</span>
                                    <span>@image.Date</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-center text-muted-foreground text-xs">@_images.Length memories</p>
        </div>
    </div>
</section>

@code {
    private record PolaroidImage(string Id, string Caption, int Rotation, string Location, string Date);

    private static readonly PolaroidImage[] _images =
    [
        new("1", "Mountain sunrise",      -2, "Colorado", "Jan 15"),
        new("2", "City lights at night",   3, "New York",  "Feb 8"),
        new("3", "Ocean waves",           -1, "California","Mar 2"),
        new("4", "Desert landscape",       2, "Arizona",   "Jan 22"),
        new("5", "Forest morning mist",   -3, "Oregon",    "Feb 14"),
        new("6", "Urban architecture",     1, "Chicago",   "Mar 5"),
    ];
}
