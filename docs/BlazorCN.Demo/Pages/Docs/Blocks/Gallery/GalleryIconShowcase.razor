@* ============================================================
   Block: gallery-icon-showcase
   Title: GalleryIconShowcase
   Description: An icon and illustration showcase gallery component with search and category filtering built with React, Next.js, shadcn/ui, and Tailwind CSS. Perfect for design systems and icon libraries.
   Source: original/blocks/gallery/gallery-icon-showcase.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-4">
            <h2 class="font-semibold text-lg">Icon Library</h2>
            <p class="mt-1 text-muted-foreground text-sm">Browse 1,000+ production-ready icons</p>
        </div>

        <div class="space-y-4 border-b px-6 py-4">
            @* Search *@
            <div class="relative">
                <LucideIconCn Name="search" Size="16" Class="absolute top-2.5 left-3 size-4 text-muted-foreground" />
                <InputCn Type="text" Placeholder="Search icons..." aria-label="Search icons" @bind-Value="_searchQuery" Class="pl-9" />
            </div>

            @* Category Tabs *@
            <div class="h-auto w-full overflow-x-auto">
                <div class="flex">
                    @foreach (var cat in _categories)
                    {
                        var category = cat;
                        <button type="button"
                                class="@Cn.Merge("inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-xs font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50", _activeCategory == category ? "bg-background text-foreground shadow-sm" : "text-muted-foreground")"
                                @onclick="@(() => _activeCategory = category)">
                            @category
                        </button>
                    }
                </div>
            </div>
        </div>

        @* Icon Grid *@
        <div class="p-6">
            @if (_filteredIcons.Length > 0)
            {
                <div class="grid gap-2 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8">
                    @foreach (var iconItem in _filteredIcons)
                    {
                        var item = iconItem;
                        <button type="button"
                                class="group relative flex aspect-square flex-col items-center justify-center gap-2 rounded-lg border bg-background p-3 transition-all hover:border-foreground/20 hover:bg-muted/50">
                            <LucideIconCn Name="@item.IconName" Size="24" Class="size-6 text-foreground" />
                            <span class="w-full truncate text-center font-mono text-[10px] text-muted-foreground">
                                @item.Name
                            </span>

                            @* Hover Tooltip *@
                            <div class="pointer-events-none absolute -top-8 left-1/2 -translate-x-1/2 whitespace-nowrap rounded bg-foreground px-2 py-1 font-mono text-white text-xs opacity-0 transition-opacity group-hover:opacity-100">
                                @item.Name
                            </div>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="py-12 text-center">
                    <LucideIconCn Name="search" Size="48" Class="mx-auto mb-3 size-12 text-muted-foreground/40" />
                    <p class="font-medium text-sm">No icons found</p>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Try adjusting your search or category filter
                    </p>
                </div>
            }
        </div>

        <div class="border-t px-6 py-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-2 text-muted-foreground text-xs">
                    <span>
                        Showing @_filteredIcons.Length of @_icons.Length icons
                    </span>
                    @if (_activeCategory != "All")
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@_activeCategory</BadgeCn>
                    }
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-2">
                    <LucideIconCn Name="download" Size="16" Class="size-4" />
                    Download All
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record IconItem(string Id, string Name, string Category, string IconName);

    private string _searchQuery = "";
    private string _activeCategory = "All";

    private static readonly string[] _categories =
    [
        "All", "Navigation", "Actions", "Communication", "Social",
        "User", "Time", "Files", "Media", "Location", "Organization"
    ];

    private static readonly IconItem[] _icons =
    [
        new("1",  "home",        "Navigation",    "home"),
        new("2",  "search",      "Actions",       "search"),
        new("3",  "bell",        "Communication", "bell"),
        new("4",  "heart",       "Social",        "heart"),
        new("5",  "star",        "Social",        "star"),
        new("6",  "user",        "User",          "user"),
        new("7",  "settings",    "Actions",       "settings"),
        new("8",  "mail",        "Communication", "mail"),
        new("9",  "calendar",    "Time",          "calendar"),
        new("10", "clock",       "Time",          "clock"),
        new("11", "folder",      "Files",         "folder"),
        new("12", "file",        "Files",         "file"),
        new("13", "image",       "Media",         "image"),
        new("14", "video",       "Media",         "video"),
        new("15", "download",    "Actions",       "download"),
        new("16", "share",       "Social",        "share"),
        new("17", "bookmark",    "Social",        "bookmark"),
        new("18", "message",     "Communication", "message-square"),
        new("19", "map-pin",     "Location",      "map-pin"),
        new("20", "tag",         "Organization",  "tag"),
        new("21", "hash",        "Organization",  "hash"),
        new("22", "zap",         "Actions",       "zap"),
        new("23", "check",       "Actions",       "check"),
    ];

    private IconItem[] _filteredIcons => _icons.Where(icon =>
    {
        var matchesSearch = icon.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase);
        var matchesCategory = _activeCategory == "All" || icon.Category == _activeCategory;
        return matchesSearch && matchesCategory;
    }).ToArray();
}
