@* ============================================================
   Block: gallery-grid-with-sidebar
   Title: GalleryGridWithSidebar
   Description: A gallery grid with a left filter sidebar for categories, price range, and ratings, built with React, Next.js, shadcn/ui, and Tailwind CSS. Real-time filtering of gallery items.
   Source: original/blocks/gallery/gallery-grid-with-sidebar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Photo Gallery</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_filteredItems.Length of @_galleryItems.Length photos
                    </p>
                </div>
                @if (_hasActiveFilters)
                {
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs" OnClick="ClearFilters">
                        <LucideIconCn Name="x" Size="12" Class="size-3" />
                        Clear filters
                    </ButtonCn>
                }
            </div>
        </div>

        <div class="flex">
            @* Sidebar *@
            <div class="w-48 shrink-0 border-r bg-muted/30 p-4">
                <div class="space-y-6">
                    @* Categories *@
                    <div>
                        <h3 class="mb-3 text-xs font-medium">Categories</h3>
                        <div class="space-y-2">
                            @foreach (var cat in _categories)
                            {
                                var category = cat;
                                var isChecked = _selectedCategories.Contains(category.Id);
                                <div class="flex items-center gap-2">
                                    <CheckboxCn id="@category.Id"
                                               Checked="@isChecked"
                                               CheckedChanged="@((bool v) => ToggleCategory(category.Id))" />
                                    <LabelCn For="@category.Id" Class="text-sm font-normal">@category.Label</LabelCn>
                                </div>
                            }
                        </div>
                    </div>

                    @* Price range *@
                    <div>
                        <div class="mb-3 flex items-center justify-between">
                            <h3 class="text-xs font-medium">Price</h3>
                            <span class="text-xs text-muted-foreground">
                                $@((int)_priceRange[0])-$@((int)_priceRange[1])
                            </span>
                        </div>
                        <SliderCn aria-label="Price range" Values="_priceRange"
                                  ValuesChanged="@((double[] v) => _priceRange = v)"
                                  Min="0"
                                  Max="50"
                                  Step="5"
                                  Class="mb-2" />
                        <div class="flex justify-between text-xs text-muted-foreground">
                            <span>$0</span>
                            <span>$50</span>
                        </div>
                    </div>

                    @* Rating *@
                    <div>
                        <h3 class="mb-3 text-xs font-medium">Minimum Rating</h3>
                        <div class="space-y-2">
                            @foreach (var r in _ratingOptions)
                            {
                                var rating = r;
                                <button type="button"
                                        @onclick="@(() => _minRating = rating)"
                                        class="@Cn.Merge("flex w-full items-center gap-1.5 rounded-md px-2 py-1.5 text-left text-sm transition-colors", _minRating == rating ? "bg-primary/10 text-primary" : "hover:bg-muted")">
                                    @if (rating == 0)
                                    {
                                        <span class="text-xs text-muted-foreground">All ratings</span>
                                    }
                                    else
                                    {
                                        @for (var i = 0; i < rating; i++)
                                        {
                                            <LucideIconCn Name="star" Size="12" Class="size-3 fill-amber-400 text-amber-400" />
                                        }
                                        <span class="text-xs text-muted-foreground">& up</span>
                                    }
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @* Gallery grid *@
            <div class="min-w-0 flex-1 p-4">
                @if (_filteredItems.Length > 0)
                {
                    <div class="grid grid-cols-3 gap-3">
                        @foreach (var itm in _filteredItems)
                        {
                            var item = itm;
                            <div class="group relative cursor-pointer overflow-hidden rounded-md">
                                @* Image *@
                                <img src="@item.Image" alt="@item.Title" class="aspect-square object-cover" />

                                @* Info overlay *@
                                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 to-transparent p-2 opacity-0 transition-opacity group-hover:opacity-100">
                                    <p class="truncate text-xs text-white">@item.Title</p>
                                    <div class="mt-1 flex items-center justify-between">
                                        <div class="flex items-center gap-0.5">
                                            @for (var i = 0; i < item.Rating; i++)
                                            {
                                                <LucideIconCn Name="star" Size="10" Class="size-2.5 fill-amber-400 text-amber-400" />
                                            }
                                        </div>
                                        <span class="text-xs text-white/90">$@item.Price</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="flex h-64 items-center justify-center rounded-md border border-dashed">
                        <div class="text-center">
                            <p class="text-sm text-muted-foreground">No photos match your filters</p>
                            <ButtonCn Variant="ButtonVariant.Link" Size="ButtonSize.Sm" Class="mt-2 h-auto p-0 text-xs" OnClick="ClearFilters">
                                Clear all filters
                            </ButtonCn>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record GalleryItem(string Id, string Title, string Category, int Price, int Rating, string Image);
    private record CategoryOption(string Id, string Label);

    private static readonly int[] _ratingOptions = [0, 3, 4, 5];

    private static readonly CategoryOption[] _categories =
    [
        new("nature", "Nature"),
        new("urban", "Urban"),
        new("people", "People"),
    ];

    private static readonly GalleryItem[] _galleryItems =
    [
        new("1",  "Mountain Sunset",  "nature", 29, 5, "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop"),
        new("2",  "City Streets",     "urban",  19, 4, "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=800&auto=format&fit=crop"),
        new("3",  "Ocean Waves",      "nature", 39, 5, "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&auto=format&fit=crop"),
        new("4",  "Portrait Study",   "people", 49, 4, "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800&auto=format&fit=crop"),
        new("5",  "Forest Path",      "nature", 24, 3, "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=800&auto=format&fit=crop"),
        new("6",  "Architecture",     "urban",  34, 5, "https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=800&auto=format&fit=crop"),
        new("7",  "Street Art",       "urban",  15, 3, "https://images.unsplash.com/photo-1481026469463-66327c86e544?w=800&auto=format&fit=crop"),
        new("8",  "Wildlife",         "nature", 44, 5, "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&auto=format&fit=crop"),
        new("9",  "Family Photo",     "people", 29, 4, "https://images.unsplash.com/photo-1518173946687-a544bf02a536?w=800&auto=format&fit=crop"),
        new("10", "Desert Dunes",     "nature", 34, 4, "https://images.unsplash.com/photo-1475924156734-496f6cac6ec1?w=800&auto=format&fit=crop"),
        new("11", "Night City",       "urban",  39, 5, "https://images.unsplash.com/photo-1431576901776-e539bd916ba2?w=800&auto=format&fit=crop"),
        new("12", "Beach Sunset",     "nature", 19, 3, "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=800&auto=format&fit=crop"),
    ];

    private HashSet<string> _selectedCategories = new HashSet<string> { "nature", "urban", "people" };
    private double[] _priceRange = [0, 50];
    private int _minRating = 0;

    private GalleryItem[] _filteredItems => _galleryItems
        .Where(item =>
            _selectedCategories.Contains(item.Category) &&
            item.Price >= (int)_priceRange[0] &&
            item.Price <= (int)_priceRange[1] &&
            item.Rating >= _minRating)
        .ToArray();

    private bool _hasActiveFilters =>
        _selectedCategories.Count < _categories.Length ||
        _priceRange[0] > 0 ||
        _priceRange[1] < 50 ||
        _minRating > 0;

    private void ToggleCategory(string categoryId)
    {
        if (_selectedCategories.Contains(categoryId))
            _selectedCategories.Remove(categoryId);
        else
            _selectedCategories.Add(categoryId);
    }

    private void ClearFilters()
    {
        _selectedCategories = new HashSet<string> { "nature", "urban", "people" };
        _priceRange = [0, 50];
        _minRating = 0;
    }
}
