@* ============================================================
   Block: gallery-nft-collection
   Title: GalleryNftCollection
   Description: A digital art collection gallery with NFT cards, creator info, floor prices, and buy actions. Built with React, Next.js, shadcn/ui, Tailwind CSS, and Framer Motion.
   Source: original/blocks/gallery/gallery-nft-collection.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-4">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="font-semibold text-lg">Genesis Collection</h2>
                    <p class="mt-1 text-muted-foreground text-sm">
                        Premium digital art collection with verified creators
                    </p>
                </div>
                <div class="flex items-center gap-2 text-muted-foreground text-sm">
                    <LucideIconCn Name="trending-up" Size="16" Class="size-4" />
                    <span class="font-medium">Floor: 0.5 ETH</span>
                </div>
            </div>
        </div>

        <div class="p-6">
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var nft in _nftItems)
                {
                    var item = nft;
                    <div class="group overflow-hidden rounded-lg border bg-card transition-shadow hover:shadow-lg">
                        <div class="relative">
                            <div class="aspect-square w-full overflow-hidden">
                                <img src="@item.Image" alt="@item.Name" class="h-full w-full object-cover" />
                            </div>
                            <div class="absolute top-3 right-3">
                                <span class="@Cn.Merge("rounded-full px-2 py-1 text-xs font-medium", _rarityColors[item.Rarity])">
                                    @if (item.Rarity == "Legendary")
                                    {
                                        <LucideIconCn Name="sparkles" Size="12" Class="mr-1 inline-block size-3" />
                                    }
                                    @item.Rarity
                                </span>
                            </div>
                        </div>

                        <div class="p-4">
                            <h3 class="font-medium text-sm">@item.Name</h3>
                            <p class="mt-1 text-muted-foreground text-xs">by @item.Creator</p>

                            <div class="mt-4 flex items-center justify-between">
                                <div>
                                    <p class="text-muted-foreground text-xs">Floor Price</p>
                                    <p class="font-semibold text-lg">@item.FloorPrice ETH</p>
                                </div>
                                <div class="text-right">
                                    <p class="text-muted-foreground text-xs">Last Sale</p>
                                    <p class="text-sm">@item.LastSale</p>
                                </div>
                            </div>

                            <ButtonCn Class="mt-4 w-full" Size="ButtonSize.Sm">
                                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                                Buy Now
                            </ButtonCn>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record NftItem(string Id, string Name, string Creator, string FloorPrice, string Rarity, string LastSale, string ImageColor, string Image);

    private static readonly NftItem[] _nftItems =
    [
        new("1", "Cosmic Dream #4521", "ArtByNova", "2.4", "Legendary", "2.8 ETH",
            "bg-gradient-to-br from-purple-500 to-pink-500",
            "https://images.unsplash.com/photo-1550859492-d5da9d8e45f3?w=600&h=600&auto=format&fit=crop"),
        new("2", "Digital Sunset #892", "PixelMaster", "1.2", "Epic", "1.5 ETH",
            "bg-gradient-to-br from-orange-500 to-red-500",
            "https://images.unsplash.com/photo-1557672172-298e090bd0f1?w=600&h=600&auto=format&fit=crop"),
        new("3", "Abstract Mind #3301", "CryptoArtist", "0.8", "Rare", "0.9 ETH",
            "bg-gradient-to-br from-blue-500 to-cyan-500",
            "https://images.unsplash.com/photo-1553356084-58ef4a67b2a7?w=600&h=600&auto=format&fit=crop"),
        new("4", "Neon Genesis #7744", "DigitalVision", "3.1", "Legendary", "3.6 ETH",
            "bg-gradient-to-br from-green-500 to-emerald-500",
            "https://images.unsplash.com/photo-1579546929518-9e396f3cc809?w=600&h=600&auto=format&fit=crop"),
        new("5", "Pixel Paradise #1205", "ArtByNova", "0.5", "Common", "0.6 ETH",
            "bg-gradient-to-br from-yellow-500 to-amber-500",
            "https://images.unsplash.com/photo-1558618666-fcd25c85f82e?w=600&h=600&auto=format&fit=crop"),
        new("6", "Ethereum Dreams #9982", "BlockchainArt", "1.9", "Epic", "2.2 ETH",
