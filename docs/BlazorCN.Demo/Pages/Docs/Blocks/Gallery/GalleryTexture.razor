@* ============================================================
   Block: gallery-texture
   Title: GalleryTexture
   Description: A texture and pattern library gallery with CSS-generated patterns, pattern names, and download options. Built with React, Next.js, shadcn/ui, Tailwind CSS, and Framer Motion.
   Source: original/blocks/gallery/gallery-texture.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-4">
            <div class="flex items-center gap-3">
                <LucideIconCn Name="grid-3x3" Size="20" Class="size-5 text-muted-foreground" />
                <div>
                    <h2 class="font-semibold text-lg">Pattern Library</h2>
                    <p class="mt-1 text-muted-foreground text-sm">
                        CSS-generated repeating patterns for backgrounds and textures
                    </p>
                </div>
            </div>
        </div>

        <div class="p-6">
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var pat in _patternSwatches)
                {
                    var pattern = pat;
                    <div class="group overflow-hidden rounded-lg border bg-card transition-shadow hover:shadow-md">
                        <div class="relative aspect-square w-full overflow-hidden bg-muted/30">
                            <div class="absolute inset-0 text-muted-foreground/20 transition-all group-hover:scale-110"
                                 style="@($"background-image:{pattern.CssPattern}")">
                            </div>
                        </div>

                        <div class="p-4">
                            <h3 class="font-medium text-sm">@pattern.Name</h3>
                            <p class="mt-1 text-muted-foreground text-xs">@pattern.Description</p>

                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-4 w-full" OnClick="@(() => HandleDownload(pattern))">
                                <LucideIconCn Name="download" Size="14" Class="mr-2 size-3.5" />
                                Download
                            </ButtonCn>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-t bg-muted/30 px-6 py-4">
            <p class="text-muted-foreground text-sm">
                @_patternSwatches.Length CSS patterns • All patterns are scalable and customizable
            </p>
        </div>
    </div>
</section>

@code {
    private record PatternSwatch(string Id, string Name, string Description, string CssPattern);

    private void HandleDownload(PatternSwatch pattern)
    {
        // no-op: download action (console.log in original)
    }

    private static readonly PatternSwatch[] _patternSwatches =
    [
        new("1", "Dots",             "Classic polka dot pattern",
            "radial-gradient(circle, currentColor 1px, transparent 1px) 0 0 / 20px 20px"),
        new("2", "Grid",             "Simple grid lines",
            "linear-gradient(currentColor 1px, transparent 1px) 0 0 / 20px 20px, linear-gradient(90deg, currentColor 1px, transparent 1px) 0 0 / 20px 20px"),
        new("3", "Diagonal Stripes", "Diagonal stripe pattern",
            "repeating-linear-gradient(45deg, transparent, transparent 10px, currentColor 10px, currentColor 11px)"),
        new("4", "Zigzag",           "Chevron zigzag pattern",
            "linear-gradient(135deg, currentColor 25%, transparent 25%) -10px 0 / 20px 20px, linear-gradient(225deg, currentColor 25%, transparent 25%) -10px 0 / 20px 20px, linear-gradient(315deg, currentColor 25%, transparent 25%) 0 0 / 20px 20px, linear-gradient(45deg, currentColor 25%, transparent 25%) 0 0 / 20px 20px"),
        new("5", "Cross Hatch",      "Diagonal cross pattern",
            "repeating-linear-gradient(45deg, transparent, transparent 5px, currentColor 5px, currentColor 6px), repeating-linear-gradient(-45deg, transparent, transparent 5px, currentColor 5px, currentColor 6px)"),
        new("6", "Waves",            "Horizontal wave pattern",
            "radial-gradient(ellipse at 50% 100%, transparent 40%, currentColor 41%, currentColor 43%, transparent 44%) 0 0 / 30px 15px"),
        new("7", "Checkerboard",     "Classic checkerboard",
            "conic-gradient(currentColor 90deg, transparent 90deg 180deg, currentColor 180deg 270deg, transparent 270deg) 0 0 / 20px 20px"),
        new("8", "Hexagons",         "Hexagonal tile pattern",
            "radial-gradient(circle at 0% 50%, transparent 9px, currentColor 10px, currentColor 11px, transparent 12px) 0 0 / 30px 15px"),
        new("9", "Vertical Stripes", "Simple vertical stripes",
            "repeating-linear-gradient(90deg, transparent, transparent 10px, currentColor 10px, currentColor 11px)"),
    ];
}
