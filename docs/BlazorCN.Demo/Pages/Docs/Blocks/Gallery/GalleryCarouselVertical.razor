@* ============================================================
   Block: gallery-carousel-vertical
   Title: GalleryCarouselVertical
   Description: A vertical scrolling carousel gallery with up/down navigation built with React, Next.js, shadcn/ui, and Tailwind CSS. Features current item indicator and smooth vertical transitions.
   Source: original/blocks/gallery/gallery-carousel-vertical.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Vertical Carousel Gallery</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Navigate up and down through items</p>
        </div>

        <div class="p-4">
            <div class="flex items-center gap-4">
                @* Indicators *@
                <div class="flex flex-col gap-2">
                    @foreach (var item in _galleryItems)
                    {
                        var it = item;
                        <button type="button"
                                class="@Cn.Merge("size-2 rounded-full transition-all", _currentIndex == it.Index ? "bg-foreground" : "bg-muted-foreground/30 hover:bg-muted-foreground/50")"
                                aria-label="@($"Go to slide {it.Index + 1}")"
                                @onclick="@(() => _currentIndex = it.Index)">
                        </button>
                    }
                </div>

                @* Carousel container *@
                <div class="relative flex-1 overflow-hidden rounded-md">
                    <div class="h-[300px]">
                        <div class="relative h-full">
                            <img src="@_galleryItems[_currentIndex].Image"
                                 alt="@_galleryItems[_currentIndex].Title"
                                 class="h-full w-full object-cover" />
                            <div class="@Cn.Merge("absolute inset-0 flex flex-col justify-between p-6", _galleryItems[_currentIndex].Color)">
                                <div>
                                    <h3 class="font-medium text-sm">@_galleryItems[_currentIndex].Title</h3>
                                    <p class="mt-1 text-muted-foreground text-xs">
                                        @_galleryItems[_currentIndex].Description
                                    </p>
                                </div>
                                <div class="text-muted-foreground text-xs">
                                    @_galleryItems[_currentIndex].Date
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* Navigation *@
                <div class="flex flex-col gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="size-8"
                              OnClick="@GoToPrevious"
                              Disabled="@(_currentIndex == 0)"
                              aria-label="Previous slide">
                        <LucideIconCn Name="chevron-up" Size="16" Class="size-4" />
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="size-8"
                              OnClick="@GoToNext"
                              Disabled="@(_currentIndex == _galleryItems.Length - 1)"
                              aria-label="Next slide">
                        <LucideIconCn Name="chevron-down" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </div>

            <div class="mt-4 flex items-center justify-between rounded-md bg-muted/50 p-3">
                <div class="flex items-center gap-2">
                    <div class="size-1.5 shrink-0 rounded-full bg-blue-500"></div>
                    <p class="text-muted-foreground text-xs">
                        @(_currentIndex + 1) of @_galleryItems.Length
                    </p>
                </div>
                <p class="text-muted-foreground text-xs">Vertical scroll pattern</p>
            </div>
        </div>
    </div>
</section>

@code {
    private record GalleryItem(int Index, string Id, string Title, string Description, string Date, string Color, string Image);

    private int _currentIndex = 0;

    private void GoToPrevious()
    {
        _currentIndex = _currentIndex == 0 ? _galleryItems.Length - 1 : _currentIndex - 1;
    }

    private void GoToNext()
    {
        _currentIndex = _currentIndex == _galleryItems.Length - 1 ? 0 : _currentIndex + 1;
    }

    private static readonly GalleryItem[] _galleryItems =
    [
        new(0, "1", "Mountain Peak", "Summit at sunrise", "Mar 24, 2026", "bg-blue-500/10",
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop"),
        new(1, "2", "Ocean View", "Coastal landscape", "Mar 22, 2026", "bg-cyan-500/10",
            "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&auto=format&fit=crop"),
        new(2, "3", "Forest Trail", "Morning light through trees", "Mar 20, 2026", "bg-green-500/10",
            "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&auto=format&fit=crop"),
        new(3, "4", "Desert Sunset", "Golden hour in the dunes", "Mar 18, 2026", "bg-amber-500/10",
            "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800&auto=format&fit=crop"),
        new(4, "5", "Urban Night", "City lights after dark", "Mar 16, 2026", "bg-purple-500/10",
            "https://images.unsplash.com/photo-1518173946687-a544bf02a536?w=800&auto=format&fit=crop"),
    ];
}
