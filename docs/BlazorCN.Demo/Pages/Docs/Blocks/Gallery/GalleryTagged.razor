@* ============================================================
   Block: gallery-tagged
   Title: GalleryTagged
   Description: A tagged gallery component with filterable labels for React, Next.js, shadcn/ui, and Tailwind CSS applications. Features tag cloud filtering with counts and smooth transitions.
   Source: original/blocks/gallery/gallery-tagged.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Tagged Gallery</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Filter by category</p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex flex-wrap items-center gap-2">
                <ButtonCn Variant="@(_selectedTag == null ? ButtonVariant.Default : ButtonVariant.Outline)"
                          Size="ButtonSize.Sm"
                          Class="h-7 text-xs"
                          @onclick="@(() => _selectedTag = null)">
                    All
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-1.5 px-1 text-xs">
                        @_images.Length
                    </BadgeCn>
                </ButtonCn>
                @foreach (var tg in _allTags)
                {
                    var tag = tg;
                    <ButtonCn Variant="@(_selectedTag == tag ? ButtonVariant.Default : ButtonVariant.Outline)"
                              Size="ButtonSize.Sm"
                              Class="h-7 text-xs"
                              @onclick="@(() => _selectedTag = tag)">
                        @tag
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-1.5 px-1 text-xs">
                            @GetTagCount(tag)
                        </BadgeCn>
                    </ButtonCn>
                }
            </div>
        </div>

        <div class="p-4">
            <div class="grid grid-cols-2 gap-3">
                @foreach (var img in FilteredImages)
                {
                    var image = img;
                    <div class="group relative">
                        <img src="https://images.unsplash.com/photo-1472214103451-9374bd1c798e?w=800&auto=format&fit=crop&h=450"
                             alt=""
                             class="aspect-video w-full rounded-md object-cover" />
                        <div class="mt-2">
                            <p class="font-medium text-sm">@image.Title</p>
                            <div class="mt-1 flex flex-wrap gap-1">
                                @foreach (var tg2 in image.Tags)
                                {
                                    var tagItem = tg2;
                                    <BadgeCn Variant="BadgeVariant.Secondary"
                                             Class="@Cn.Merge("cursor-pointer text-xs transition-colors", _selectedTag == tagItem ? "bg-primary text-primary-foreground" : "")"
                                             @onclick="@(() => _selectedTag = tagItem)">
                                        @tagItem
                                    </BadgeCn>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (FilteredImages.Length == 0)
            {
                <div class="py-12 text-center">
                    <p class="text-muted-foreground text-sm">No images found with this tag</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record GalleryImage(string Id, string Title, string[] Tags);

    private string? _selectedTag = null;

    private static readonly GalleryImage[] _images =
    [
        new("1", "Mountain Landscape", ["nature", "landscape", "mountains"]),
        new("2", "City Skyline",        ["urban", "architecture", "city"]),
        new("3", "Ocean Sunset",        ["nature", "sunset", "ocean"]),
        new("4", "Desert Dunes",        ["nature", "landscape", "desert"]),
        new("5", "Forest Path",         ["nature", "forest", "trees"]),
        new("6", "Modern Building",     ["urban", "architecture", "modern"]),
        new("7", "Beach Waves",         ["nature", "ocean", "beach"]),
        new("8", "Night City",          ["urban", "city", "night"]),
    ];

    private static readonly string[] _allTags =
        _images.SelectMany(img => img.Tags).Distinct().ToArray();

    private int GetTagCount(string tag) =>
        _images.Count(img => img.Tags.Contains(tag));

    private GalleryImage[] FilteredImages =>
        _selectedTag == null
            ? _images
            : _images.Where(img => img.Tags.Contains(_selectedTag)).ToArray();
}
