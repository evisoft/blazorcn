@* ============================================================
   Block: gallery-seasonal
   Title: GallerySeasonal
   Description: A themed gallery with season selector showcasing different color schemes and content for Spring, Summer, Fall, and Winter built with React, Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/gallery/gallery-seasonal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Seasonal Gallery</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Explore nature through the seasons</p>
        </div>

        @* Season Selector *@
        <div class="border-b p-4">
            <div class="flex gap-2">
                @foreach (var sk in _seasonKeys)
                {
                    var seasonKey = sk;
                    var theme = _seasonThemes[seasonKey];
                    var isSelected = _selectedSeason == seasonKey;
                    <ButtonCn Variant="@(isSelected ? ButtonVariant.Default : ButtonVariant.Outline)"
                              Size="ButtonSize.Sm"
                              Class="flex-1 gap-1.5"
                              OnClick="@(() => _selectedSeason = seasonKey)">
                        <LucideIconCn Name="@theme.IconName" Size="12" Class="size-3" />
                        @theme.Name
                    </ButtonCn>
                }
            </div>
        </div>

        @* Gallery Grid *@
        @{
            var currentTheme = _seasonThemes[_selectedSeason];
        }
        <div class="@Cn.Merge("bg-gradient-to-br p-4", currentTheme.BgGradient)">
            <div class="mb-3 flex items-center gap-2">
                <LucideIconCn Name="@currentTheme.IconName" Size="20" Class="@Cn.Merge("size-5", currentTheme.Color)" />
                <span class="text-sm font-medium">@currentTheme.Name Collection</span>
            </div>

            <div class="grid grid-cols-2 gap-3">
                @foreach (var gi in currentTheme.Items)
                {
                    var item = gi;
                    <div class="overflow-hidden rounded-lg border bg-card">
                        <div class="h-24">
                            <img src="@item.Image" alt="@item.Title" class="size-full object-cover" />
                        </div>
                        <div class="p-2">
                            <div class="mb-0.5 text-xs font-medium">@item.Title</div>
                            <p class="text-xs text-muted-foreground">@item.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">
                    @currentTheme.Items.Length items in @currentTheme.Name collection
                </span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs">
                    View All
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

