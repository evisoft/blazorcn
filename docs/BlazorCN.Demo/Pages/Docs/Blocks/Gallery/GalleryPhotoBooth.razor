@* ============================================================
   Block: gallery-photo-booth
   Title: GalleryPhotoBooth
   Description: A photo booth strip layout with vintage aesthetic and decorative borders, built with React, Next.js, shadcn/ui, Framer Motion, and Tailwind CSS
   Source: original/blocks/gallery/gallery-photo-booth.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="camera" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Photo Booth Memories</h2>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">
                Classic photo booth strips from events
            </p>
        </div>

        <div class="grid gap-4 p-4 sm:grid-cols-2">
            @foreach (var strip in _photoStrips)
            {
                var s = strip;
                <div class="group relative">
                    <div class="overflow-hidden rounded-lg border-2 border-foreground/10 bg-background p-2 shadow-sm">
                        <div class="space-y-2">
                            @for (int pi = 0; pi < s.Photos.Length; pi++)
                            {
                                var photoUrl = s.Photos[pi];
                                var photoIndex = pi;
                                <div class="aspect-[4/3] overflow-hidden rounded-sm border border-foreground/5 bg-muted">
                                    <img src="@photoUrl"
                                         alt="@($"{s.Event} {photoIndex + 1}")"
                                         class="size-full object-cover" />
                                </div>
                            }
                        </div>

                        <div class="mt-2 border-t border-foreground/5 pt-2 text-center">
                            <p class="text-xs font-medium">@s.Event</p>
                            <p class="text-[10px] text-muted-foreground">@s.Date</p>
                        </div>

                        <div class="mt-2 flex gap-1">
                            @for (int i = 0; i < 8; i++)
                            {
                                <div class="h-1 flex-1 rounded-full bg-foreground/5"></div>
                            }
                        </div>
                    </div>

                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="absolute right-2 top-2 h-6 w-6 p-0 opacity-0 transition-opacity group-hover:opacity-100">
                        <LucideIconCn Name="download" Size="14" Class="size-3.5" />
                    </ButtonCn>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">@_photoStrips.Length photo strips</p>
        </div>
    </div>
</section>

