@* ============================================================
   Block: gallery-card-stack
   Title: GalleryCardStack
   Description: A stacked card gallery where the top card shows fully while cards beneath peek out, with swipe-to-cycle functionality built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/gallery/gallery-card-stack.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-6 py-4">
            <div>
                <h2 class="font-semibold text-base">Featured Gallery</h2>
                <p class="mt-1 text-muted-foreground text-sm">Explore our curated collection</p>
            </div>
            <div class="text-right">
                <div class="font-medium text-sm tabular-nums">
                    @(_currentIndex + 1) / @_galleryCards.Length
                </div>
                <div class="text-muted-foreground text-xs">@_galleryCards[_currentIndex].Category</div>
            </div>
        </div>

        @* Card Stack Container *@
        <div class="relative h-[500px] p-6">
            @* Background Cards (Stack Effect) — offset 2 (bottom-most) *@
            <div class="absolute inset-x-6 rounded-lg border bg-muted"
                 style="z-index:8; top:40px; height:calc(100% - 48px); transform:scale(0.90); opacity:0.4;"></div>
            @* Background Cards (Stack Effect) — offset 1 *@
            <div class="absolute inset-x-6 rounded-lg border bg-muted"
                 style="z-index:9; top:32px; height:calc(100% - 48px); transform:scale(0.95); opacity:0.7;"></div>

            @* Main Card *@
            @{
                var card = _galleryCards[_currentIndex];
            }
            <div class="absolute inset-0 overflow-hidden rounded-lg border bg-card shadow-lg transition-all duration-300"
                 style="z-index:20;">
                @* Image *@
                <div class="relative h-[320px] w-full">
                    <img src="@card.Image"
                         alt="@card.Title"
                         class="size-full object-cover" />

                    @* Category Badge *@
                    <BadgeCn Variant="BadgeVariant.Secondary"
                             Class="@Cn.Merge("absolute right-4 top-4 text-xs", CategoryColor(card.Category))">
                        @card.Category
                    </BadgeCn>
                </div>

                @* Content *@
                <div class="p-6">
                    <div class="mb-2 flex items-start justify-between gap-4">
                        <h3 class="font-semibold text-lg">@card.Title</h3>
                        <span class="shrink-0 text-muted-foreground text-xs">@card.Date</span>
                    </div>
                    <p class="text-muted-foreground text-sm">@card.Description</p>
                </div>
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between border-t px-6 py-4">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1 px-3" OnClick="HandlePrev">
                <LucideIconCn Name="chevron-left" Size="16" Class="size-4" />
                Previous
            </ButtonCn>

            @* Progress Dots *@
            <div class="flex gap-0.5">
                @for (int i = 0; i < _galleryCards.Length; i++)
                {
                    var idx = i;
                    <button type="button"
                            @onclick="@(() => GoToCard(idx))"
                            class="inline-flex size-6 items-center justify-center"
                            aria-label="@($"Go to card {idx + 1}")">
                        <span class="@Cn.Merge("size-2 rounded-full transition-all", idx == _currentIndex ? "w-6 bg-foreground" : "bg-muted-foreground/30 hover:bg-muted-foreground/50")"></span>
                    </button>
                }
            </div>

            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1 px-3" OnClick="HandleNext">
                Next
                <LucideIconCn Name="chevron-right" Size="16" Class="size-4" />
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record GalleryCard(string Id, string Title, string Description, string Category, string Date, string Image);

    private int _currentIndex = 0;

    private void HandleNext()
    {
        _currentIndex = (_currentIndex + 1) % _galleryCards.Length;
    }

    private void HandlePrev()
    {
        _currentIndex = (_currentIndex - 1 + _galleryCards.Length) % _galleryCards.Length;
    }

    private void GoToCard(int index)
    {
        _currentIndex = index;
    }

    private static string CategoryColor(string category) => category switch
    {
        "Nature" => "bg-emerald-500/10 text-emerald-600",
        "Architecture" => "bg-blue-500/10 text-blue-600",
        "Landscape" => "bg-purple-500/10 text-purple-600",
        "Urban" => "bg-amber-500/10 text-amber-600",
        "Wildlife" => "bg-red-500/10 text-red-600",
        _ => ""
    };

    private static readonly GalleryCard[] _galleryCards =
    [
        new("1", "Mountain Expedition 2024", "Captured the breathtaking sunrise at 14,000 feet elevation",
            "Nature", "March 2024",
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop"),
        new("2", "Urban Architecture", "Modern design meets historic preservation in downtown district",
            "Architecture", "February 2024",
            "https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=800&auto=format&fit=crop"),
        new("3", "Coastal Landscapes", "Dramatic cliffs and crashing waves along the Pacific coastline",
            "Landscape", "January 2024",
            "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800&auto=format&fit=crop"),
        new("4", "Street Photography", "Candid moments capturing the essence of city life",
            "Urban", "December 2023",
            "https://images.unsplash.com/photo-1579546929518-9e396f3cc809?w=800&auto=format&fit=crop"),
        new("5", "Wildlife Safari", "Rare glimpses of animals in their natural habitat",
            "Wildlife", "November 2023",
            "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&auto=format&fit=crop"),
    ];
}
