@* ============================================================
   Block: gallery-portfolio
   Title: GalleryPortfolio
   Description: A portfolio-style gallery with project cards built with React, Next.js, shadcn/ui, and Tailwind CSS. Hover to reveal project descriptions with smooth overlay transitions.
   Source: original/blocks/gallery/gallery-portfolio.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Portfolio</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Selected projects and client work</p>
        </div>

        <div class="p-4">
            <div class="grid gap-4 sm:grid-cols-2">
                @foreach (var proj in _projects)
                {
                    var project = proj;
                    <div class="group relative overflow-hidden rounded-lg border bg-muted transition-transform hover:scale-[1.02]">
                        @* Project Image *@
                        <img src="@project.Image"
                             alt="@project.Title"
                             class="aspect-[4/3] w-full object-cover" />

                        @* Project Info - Always Visible *@
                        <div class="border-t bg-card px-3 py-3">
                            <div class="flex items-start justify-between gap-2">
                                <div class="min-w-0 flex-1">
                                    <h3 class="text-sm font-medium">@project.Title</h3>
                                    <p class="mt-0.5 text-xs text-muted-foreground">@project.Client</p>
                                </div>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-xs font-normal">
                                    @project.Year
                                </BadgeCn>
                            </div>
                            <div class="mt-2">
                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs font-normal">
                                    @project.Category
                                </BadgeCn>
                            </div>
                        </div>

                        @* Hover Overlay *@
                        <div class="absolute inset-0 flex items-center justify-center bg-background/95 p-4 opacity-0 backdrop-blur-sm transition-opacity duration-300 group-hover:opacity-100">
                            <div class="text-center">
                                <h3 class="text-sm font-medium">@project.Title</h3>
                                <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                                    @project.Description
                                </p>
                                <button type="button"
                                        class="mt-4 inline-flex items-center gap-1.5 text-xs font-medium transition-colors hover:text-muted-foreground">
                                    <span>View Project</span>
                                    <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record PortfolioProject(string Id, string Title, string Category, string Year, string Description, string Client, string Image);

