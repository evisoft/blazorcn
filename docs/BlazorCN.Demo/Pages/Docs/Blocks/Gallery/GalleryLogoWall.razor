@* ============================================================
   Block: gallery-logo-wall
   Title: GalleryLogoWall
   Description: A logo wall with animated marquee scroll effect featuring two rows scrolling in opposite directions. Built with React, Next.js, shadcn/ui, Tailwind CSS, and Framer Motion.
   Source: original/blocks/gallery/gallery-logo-wall.tsx
   ============================================================ *@

<style>
    @@keyframes logo-wall-left {
        0%   { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }

    @@keyframes logo-wall-right {
        0%   { transform: translateX(-50%); }
        100% { transform: translateX(0); }
    }

    .animate-logo-wall-left {
        animation: logo-wall-left 30s linear infinite;
    }

    .animate-logo-wall-right {
        animation: logo-wall-right 30s linear infinite;
    }

    .animate-logo-wall-left:hover,
    .animate-logo-wall-right:hover {
        animation-play-state: paused;
    }

    .logo-wall-fade-in {
        animation: logo-wall-fade-in 0.5s ease forwards;
    }

    @@keyframes logo-wall-fade-in {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }
</style>

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="logo-wall-fade-in overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-4 text-center">
            <div class="flex items-center justify-center gap-2">
                <LucideIconCn Name="award" Size="20" Class="size-5 text-muted-foreground" />
                <h2 class="font-semibold text-lg">Trusted by Industry Leaders</h2>
            </div>
            <p class="mt-2 text-muted-foreground text-sm">
                Join thousands of companies building with our platform
            </p>
        </div>

        <div class="py-8">
            <div class="relative">
                <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-card to-transparent"></div>
                <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-card to-transparent"></div>

                @* Row 1 — scrolls left, shows colored square + name *@
                <div class="mb-8 overflow-hidden">
                    <div class="flex animate-logo-wall-left gap-8">
                        @foreach (var logo in _duplicatedRow1)
                        {
                            var lg = logo;
                            <div class="flex shrink-0 items-center justify-center">
                                <div class="flex h-16 w-40 items-center justify-center rounded-lg border bg-card/50 transition-all hover:shadow-md">
                                    <div class="flex items-center gap-3">
                                        <div class="@($"size-8 rounded {lg.Color}")"></div>
                                        <span class="font-medium text-sm">@lg.Name</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @* Row 2 — scrolls right, shows images *@
                <div class="overflow-hidden">
                    <div class="flex animate-logo-wall-right gap-8">
                        @foreach (var logo in _duplicatedRow2)
                        {
                            var lg = logo;
                            <div class="flex shrink-0 items-center justify-center">
                                <div class="flex h-16 w-40 items-center justify-center overflow-hidden rounded-lg border bg-card/50 transition-all hover:shadow-md">
                                    <img
                                        src="@lg.Image"
                                        alt="@lg.Name"
                                        class="h-full w-full object-cover" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="border-t bg-muted/30 px-6 py-4 text-center">
            <p class="text-muted-foreground text-sm">Used by over 10,000+ teams worldwide</p>
        </div>
    </div>
</section>

