@* ============================================================
   Block: gallery-timeline
   Title: GalleryTimeline
   Description: A chronological photo timeline gallery with year sections and vertical timeline connector built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/gallery/gallery-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-4">
            <h2 class="font-semibold text-base">Our Journey</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Key moments that shaped our story from 2021 to present
            </p>
        </div>

        @* Timeline *@
        <div class="p-6">
            @foreach (var yr in _years)
            {
                var year = yr;
                var yearIndex = System.Array.IndexOf(_years, year);
                var entries = _groupedByYear[year];
                <div class="relative">
                    @* Year Header *@
                    <div class="mb-6 flex items-center gap-3">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-foreground">
                            <LucideIconCn Name="calendar" Size="20" Class="size-5 text-background" />
                        </div>
                        <div>
                            <h3 class="font-semibold text-xl tabular-nums">@year</h3>
                            <p class="text-muted-foreground text-xs">
                                @entries.Length events
                            </p>
                        </div>
                    </div>

                    @* Timeline Entries *@
                    <div class="ml-5 space-y-6 border-l-2 pl-8">
                        @foreach (var en in entries)
                        {
                            var entry = en;
                            <div class="group relative">
                                @* Timeline Dot *@
                                <div class="absolute -left-[41px] top-2 size-3 rounded-full border-2 border-background bg-foreground"></div>

                                @* Entry Card *@
                                <div class="overflow-hidden rounded-lg border bg-muted/30 transition-all hover:border-muted-foreground/30 hover:bg-muted/50">
                                    @* Image *@
                                    <img src="@entry.Image"
                                         alt="@entry.Title"
                                         class="aspect-video w-full object-cover" />

                                    @* Content *@
                                    <div class="p-4">
                                        <div class="mb-2 flex items-start justify-between gap-2">
                                            <div>
                                                <h4 class="font-medium text-sm">@entry.Title</h4>
                                                <p class="mt-0.5 text-muted-foreground text-xs">
                                                    @entry.Month @entry.Year
                                                </p>
                                            </div>
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-xs", _categoryColors.TryGetValue(entry.Category, out var cc) ? cc : "")">
                                                @entry.Category
                                            </BadgeCn>
                                        </div>
                                        <p class="text-muted-foreground text-sm">@entry.Description</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @* Spacer between years *@
                    @if (yearIndex < _years.Length - 1)
                    {
                        <div class="h-8"></div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TimelineEntry(string Id, string Year, string Month, string Title, string Description, string Category, string Image);

    private static readonly TimelineEntry[] _timelineData =
    [
        new("1", "2024", "March",    "Product Launch Event",  "Unveiled our latest innovation to over 500 attendees",          "Launch",      "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=800&h=450&auto=format&fit=crop"),
        new("2", "2024", "January",  "New Office Opening",    "Expanded to our fourth location in downtown district",          "Milestone",   "https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=800&h=450&auto=format&fit=crop"),
        new("3", "2023", "September","Team Retreat",          "Company-wide gathering in the mountains",                       "Event",       "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&h=450&auto=format&fit=crop"),
        new("4", "2023", "June",     "Award Ceremony",        "Recognized as Innovation Leader of the Year",                   "Achievement", "https://images.unsplash.com/photo-1481026469463-66327c86e544?w=800&h=450&auto=format&fit=crop"),
        new("5", "2023", "February", "Series B Funding",      "Closed $50M round led by top tier investors",                   "Milestone",   "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&h=450&auto=format&fit=crop"),
        new("6", "2022", "November", "First Major Client",    "Signed partnership with Fortune 500 company",                   "Achievement", "https://images.unsplash.com/photo-1431576901776-e539bd916ba2?w=800&h=450&auto=format&fit=crop"),
        new("7", "2022", "March",    "Platform Launch",       "Released public beta to 10,000 early adopters",                 "Launch",      "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800&h=450&auto=format&fit=crop"),
        new("8", "2021", "August",   "Company Founded",       "Started our journey with a team of five in a garage",           "Milestone",   "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=800&h=450&auto=format&fit=crop"),
    ];

    private static readonly Dictionary<string, string> _categoryColors = new()
    {
        ["Launch"]      = "bg-blue-500/10 text-blue-600",
        ["Milestone"]   = "bg-emerald-500/10 text-emerald-600",
        ["Event"]       = "bg-purple-500/10 text-purple-600",
        ["Achievement"] = "bg-amber-500/10 text-amber-600",
    };

    private static readonly Dictionary<string, TimelineEntry[]> _groupedByYear =
        _timelineData
            .GroupBy(e => e.Year)
            .ToDictionary(g => g.Key, g => g.ToArray());

    private static readonly string[] _years =
        _groupedByYear.Keys
            .OrderByDescending(y => int.Parse(y))
            .ToArray();
}
