@* ============================================================
   Block: gallery-carousel
   Title: GalleryCarousel
   Description: A smooth scrollable carousel gallery built with React, Next.js, shadcn/ui, and Tailwind CSS featuring snap points and navigation controls
   Source: original/blocks/gallery/gallery-carousel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Featured Destinations</h2>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Explore @_slides.Length iconic locations
                    </p>
                </div>
                <div class="flex items-center gap-1">
                    <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7" @onclick="HandlePrevious">
                        <LucideIconCn Name="chevron-left" Size="16" Class="size-4" />
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7" @onclick="HandleNext">
                        <LucideIconCn Name="chevron-right" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </div>
        </div>

        <div class="relative">
            <div class="flex snap-x snap-mandatory overflow-x-hidden">
                @foreach (var slide in _slides)
                {
                    var sl = slide;
                    <div class="@Cn.Merge("min-w-full snap-center transition-opacity duration-300", _slides[_activeIndex].Id == sl.Id ? "opacity-100" : "opacity-0 absolute inset-0 pointer-events-none")">
                        <div class="p-4">
                            <div class="overflow-hidden rounded-md">
                                <img src="@sl.Image"
                                     alt="@sl.Title"
                                     class="aspect-video w-full object-cover" />
                                <div class="border-t bg-card px-4 py-3">
                                    <h3 class="text-sm font-medium">@sl.Title</h3>
                                    <p class="mt-0.5 text-xs text-muted-foreground">@sl.Subtitle</p>
                                    <p class="mt-2 text-xs text-muted-foreground">@sl.Description</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex gap-1.5">
                    @foreach (var (slide, index) in _slides.Select((s, i) => (s, i)))
                    {
                        var idx = index;
                        <button type="button"
                                @onclick="@(() => ScrollToIndex(idx))"
                                class="@Cn.Merge("size-1.5 rounded-full transition-all duration-200", idx == _activeIndex ? "w-6 bg-foreground" : "bg-muted-foreground/30 hover:bg-muted-foreground/50")"
                                aria-label="@($"Go to slide {idx + 1}")" />
                    }
                </div>
                <span class="text-xs text-muted-foreground">
                    @(_activeIndex + 1) / @_slides.Length
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record CarouselSlide(string Id, string Title, string Subtitle, string Description, string Image);

    private int _activeIndex = 0;

    private void ScrollToIndex(int index)
    {
        _activeIndex = index;
    }

    private void HandlePrevious()
    {
        var newIndex = _activeIndex == 0 ? _slides.Length - 1 : _activeIndex - 1;
        ScrollToIndex(newIndex);
    }

    private void HandleNext()
    {
        var newIndex = _activeIndex == _slides.Length - 1 ? 0 : _activeIndex + 1;
        ScrollToIndex(newIndex);
    }

    private static readonly CarouselSlide[] _slides =
    [
        new("1", "Northern Lights", "Aurora Borealis", "Spectacular light display over Iceland",
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&h=450&auto=format&fit=crop"),
        new("2", "Grand Canyon", "Arizona, USA", "Breathtaking natural wonder at sunset",
            "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&h=450&auto=format&fit=crop"),
        new("3", "Santorini Sunset", "Greek Islands", "White-washed buildings against blue domes",
            "https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=800&h=450&auto=format&fit=crop"),
        new("4", "Machu Picchu", "Peru", "Ancient Incan city in the clouds",
            "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800&h=450&auto=format&fit=crop"),
        new("5", "Petra Treasury", "Jordan", "Rose-red city carved into rock",
            "https://images.unsplash.com/photo-1518173946687-a544bf02a536?w=800&h=450&auto=format&fit=crop"),
        new("6", "Mount Fuji", "Japan", "Iconic volcanic peak reflected in lake",
            "https://images.unsplash.com/photo-1475924156734-496f6cac6ec1?w=800&h=450&auto=format&fit=crop"),
    ];
}
