@* ============================================================
   Block: gallery-masonry
   Title: GalleryMasonry
   Description: A responsive masonry grid gallery built with React, Next.js, shadcn/ui, and Tailwind CSS featuring staggered heights and hover overlays
   Source: original/blocks/gallery/gallery-masonry.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Gallery Collection</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                @_galleryItems.Length images across multiple categories
            </p>
        </div>

        <div class="p-4">
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var it in _galleryItems)
                {
                    var item = it;
                    <div class="@Cn.Merge("group relative overflow-hidden rounded-md", item.Featured ? "sm:col-span-2" : "", item.AspectRatio == "portrait" ? "sm:row-span-2" : "")">
                        <img src="@item.Image"
                             alt="@item.Title"
                             class="@Cn.Merge("w-full object-cover transition-transform duration-300 group-hover:scale-105", item.AspectRatio == "square" ? "aspect-square" : "", item.AspectRatio == "portrait" ? "aspect-[3/4]" : "", item.AspectRatio == "landscape" ? "aspect-video" : "")" />

                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                            <div class="absolute bottom-0 left-0 right-0 p-4">
                                <div class="mb-1 flex items-center gap-2">
                                    <span class="rounded-full bg-white/20 px-2 py-0.5 text-xs text-white">
                                        @item.Category
                                    </span>
                                    @if (item.Featured)
                                    {
                                        <span class="rounded-full bg-blue-500/80 px-2 py-0.5 text-xs text-white">
                                            Featured
                                        </span>
                                    }
                                </div>
                                <h3 class="text-sm font-medium text-white">@item.Title</h3>
                                <p class="mt-0.5 text-xs text-white/80">@item.Description</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record GalleryItem(string Id, string Title, string Description, string Category, bool Featured, string AspectRatio, string Image);

