@* ============================================================
   Block: gallery-masonry-hover
   Title: GalleryMasonryHover
   Description: A responsive masonry image gallery built with React, Next.js, shadcn/ui, and Tailwind CSS. Features sophisticated hover effects with image scaling, sliding title overlays, and gradient transitions.
   Source: original/blocks/gallery/gallery-masonry-hover.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Masonry Gallery</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Hover to reveal details</p>
        </div>

        <div class="p-4">
            <div class="grid grid-cols-3 gap-3">
                @foreach (var img in _masonryImages)
                {
                    var image = img;
                    var colSpan = (Array.IndexOf(_masonryImages, image) % 3 == 0) ? "col-span-2" : "col-span-1";
                    <div class="@colSpan">
                        <div class="group relative overflow-hidden rounded-md border bg-muted">
                            <div class="w-full overflow-hidden" style="@($"height:{image.Height}px")">
                                <img src="@image.Image"
                                     alt="@image.Title"
                                     class="h-full w-full object-cover transition-transform duration-400 ease-out group-hover:scale-105" />
                            </div>

                            @* Gradient overlay — visible on hover *@
                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>

                            @* Slide-up info panel *@
                            <div class="absolute inset-x-0 bottom-0 translate-y-5 p-3 opacity-0 transition-all duration-300 ease-out group-hover:translate-y-0 group-hover:opacity-100">
                                <span class="mb-1 inline-block rounded-full bg-white/20 px-2 py-0.5 text-xs font-medium text-white backdrop-blur-sm">
                                    @image.Category
                                </span>
                                <h3 class="text-sm font-medium text-white">@image.Title</h3>
                                <div class="mt-2 flex items-center gap-3 text-xs text-white/80">
                                    <span class="flex items-center gap-1">
                                        <LucideIconCn Name="eye" Size="12" Class="size-3" />
                                        @image.Views
                                    </span>
                                    <span class="flex items-center gap-1">
                                        <LucideIconCn Name="heart" Size="12" Class="size-3" />
                                        @image.Likes
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record MasonryImage(string Id, string Title, int Height, string Views, string Likes, string Category, string Image);

