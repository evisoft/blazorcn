@* ============================================================
   Block: gallery-design-system
   Title: GalleryDesignSystem
   Description: A design system component gallery showcasing UI components with previews, variants, and status built with React, Next.js, shadcn/ui, and Tailwind CSS. Perfect for component documentation.
   Source: original/blocks/gallery/gallery-design-system.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Design System Components</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                @_components.Length components • 37 total variants
            </p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-4 text-xs">
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-muted-foreground">Stable</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    <span class="text-muted-foreground">Beta</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    <span class="text-muted-foreground">Experimental</span>
                </div>
            </div>
        </div>

        <div class="p-4">
            <div class="grid gap-3">
                @foreach (var comp in _components)
                {
                    var component = comp;
                    var statusColor = GetStatusColor(component.Status);
                    var categoryIcon = GetCategoryIcon(component.Category);
                    <div class="rounded-lg border bg-muted/30 p-3 transition-colors hover:bg-muted/50">
                        <div class="flex items-start justify-between">
                            <div class="flex items-start gap-3">
                                <div class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-md bg-muted">
                                    <LucideIconCn Name="@categoryIcon" Size="16" Class="size-4 text-muted-foreground" />
                                </div>
                                <div class="min-w-0 flex-1">
                                    <div class="mb-1 flex items-center gap-2">
                                        <span class="font-medium text-sm">@component.Name</span>
                                        <span class="@Cn.Merge("size-1.5 rounded-full", statusColor)"></span>
                                    </div>
                                    <p class="mb-2 text-muted-foreground text-xs">
                                        @component.Description
                                    </p>
                                    <div class="flex items-center gap-2">
                                        <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 px-1.5 text-xs">
                                            @component.Category
                                        </BadgeCn>
                                        <span class="text-muted-foreground text-xs">
                                            @component.Variants variants
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 px-2 text-xs">
                                View
                            </ButtonCn>
                        </div>

                        @* Preview mockup *@
                        <div class="mt-3 flex items-center gap-2 rounded-md bg-background p-2">
                            @if (component.Name == "Button")
                            {
                                <div class="h-6 w-16 rounded-md bg-primary"></div>
                                <div class="h-6 w-16 rounded-md border"></div>
                                <div class="h-6 w-16 rounded-md bg-muted"></div>
                            }
                            @if (component.Name == "Input")
                            {
                                <div class="h-8 flex-1 rounded-md border bg-background"></div>
                            }
                            @if (component.Name == "Card")
                            {
                                <div class="h-20 flex-1 rounded-md border bg-background"></div>
                            }
                            @if (component.Name == "Badge")
                            {
                                <div class="h-5 w-12 rounded-full bg-muted"></div>
                                <div class="h-5 w-12 rounded-full bg-primary"></div>
                                <div class="h-5 w-12 rounded-full border"></div>
                            }
                            @if (component.Name != "Button" && component.Name != "Input" && component.Name != "Card" && component.Name != "Badge")
                            {
                                <div class="h-12 flex-1 rounded-md bg-muted/50"></div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="w-full">
                View Complete Documentation
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record DesignComponent(string Id, string Name, string Category, int Variants, string Status, string Description);

    private static readonly DesignComponent[] _components =
    [
        new("1", "Button",  "Actions",      8, "stable",       "Primary action component with multiple variants"),
        new("2", "Input",   "Forms",         6, "stable",       "Text input with validation support"),
        new("3", "Card",    "Layout",        4, "stable",       "Container for content grouping"),
        new("4", "Badge",   "Data Display",  5, "stable",       "Small status indicators and labels"),
        new("5", "Dialog",  "Overlays",      3, "stable",       "Modal dialog for important actions"),
        new("6", "Tooltip", "Overlays",      2, "beta",         "Contextual help on hover"),
        new("7", "Select",  "Forms",         4, "stable",       "Dropdown selection component"),
        new("8", "Tabs",    "Navigation",    3, "stable",       "Content organization in tabs"),
        new("9", "Command", "Navigation",    2, "experimental", "Command palette interface"),
    ];

    private static string GetStatusColor(string status) => status switch
    {
        "stable"       => "bg-emerald-500",
        "beta"         => "bg-amber-500",
        "experimental" => "bg-blue-500",
        _              => "bg-muted",
    };

    private static string GetCategoryIcon(string category) => category switch
    {
        "Actions"      => "circle",
        "Forms"        => "square",
        "Layout"       => "triangle",
        "Data Display" => "circle",
        "Overlays"     => "square",
        "Navigation"   => "triangle",
        _              => "circle",
    };
}
