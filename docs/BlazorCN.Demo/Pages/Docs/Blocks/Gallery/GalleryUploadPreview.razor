@* ============================================================
   Block: gallery-upload-preview
   Title: GalleryUploadPreview
   Description: An upload preview gallery showing uploaded files as thumbnails with progress bars, built with React, Next.js, shadcn/ui, and Tailwind CSS. View file names, sizes, and upload progress with individual remove actions.
   Source: original/blocks/gallery/gallery-upload-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Upload Preview</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_files.Count(f => f.Status == "complete") of @_files.Count files uploaded
            </p>
        </div>

        <div class="p-4">
            <div class="grid gap-3">
                @foreach (var file in _files.ToArray())
                {
                    var item = file;
                    <div class="flex items-start gap-3 rounded-md border bg-muted/50 p-3">
                        @* Thumbnail *@
                        <div class="relative size-16 shrink-0 overflow-hidden rounded-md">
                            @if (item.Status == "complete")
                            {
                                <img src="@item.Image" alt="@item.Name" class="h-full w-full object-cover" />
                            }
                            else
                            {
                                <div class="flex size-full items-center justify-center bg-muted">
                                    <LucideIconCn Name="file" Size="24" Class="size-6 text-muted-foreground/40" />
                                </div>
                            }
                        </div>

                        @* File info *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-start justify-between gap-2">
                                <div class="min-w-0 flex-1">
                                    <p class="truncate text-sm font-medium">@item.Name</p>
                                    <p class="mt-0.5 text-xs text-muted-foreground">@item.Size</p>
                                </div>

                                <ButtonCn Variant="ButtonVariant.Ghost"
                                          Size="ButtonSize.Sm"
                                          Class="size-6 shrink-0 p-0"
                                          OnClick="@(() => RemoveFile(item.Id))">
                                    <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                                </ButtonCn>
                            </div>

                            @* Progress bar *@
                            @if (item.Status == "uploading")
                            {
                                <div class="mt-2 space-y-1">
                                    <ProgressCn Value="@item.Progress" Class="h-1.5" />
                                    <p class="text-xs text-muted-foreground">@item.Progress% uploaded</p>
                                </div>
                            }

                            @if (item.Status == "complete")
                            {
                                <p class="mt-2 text-xs text-emerald-600">Upload complete</p>
                            }

                            @if (item.Status == "error")
                            {
                                <p class="mt-2 text-xs text-red-600">Upload failed</p>
                            }
                        </div>
                    </div>
                }

                @* Add more button *@
                <button @onclick="AddMoreFiles"
                        class="flex items-center justify-center gap-2 rounded-md border-2 border-dashed bg-muted/30 px-4 py-8 text-sm text-muted-foreground transition-colors hover:border-muted-foreground/50 hover:bg-muted/50">
                    <LucideIconCn Name="plus" Size="16" Class="size-4" />
                    Add more files
                </button>
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <p class="text-xs text-muted-foreground">
                    @_files.Count files •
                    @TotalSizeMb().ToString("F1") MB total
                </p>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 px-3 text-xs">
                    Upload All
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record UploadedFile(string Id, string Name, string Size, int Progress, string Status, string Image);

    private List<UploadedFile> _files =
    [
        new("1", "summer-vacation.jpg", "2.4 MB", 100, "complete",
            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop"),
        new("2", "birthday-party.jpg", "1.8 MB", 100, "complete",
            "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&auto=format&fit=crop"),
        new("3", "family-portrait.jpg", "3.1 MB", 67, "uploading",
            "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800&auto=format&fit=crop"),
        new("4", "graduation-day.jpg", "2.2 MB", 34, "uploading",
            "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=800&auto=format&fit=crop"),
    ];

    private void RemoveFile(string id)
    {
        _files.RemoveAll(f => f.Id == id);
    }

    private void AddMoreFiles()
    {
        // Open file picker dialog (no-op in static demo)
    }

    private double TotalSizeMb()
    {
        double total = 0;
        foreach (var f in _files)
        {
            var parts = f.Size.Split(' ');
            if (parts.Length > 0 && double.TryParse(parts[0], System.Globalization.NumberStyles.Any,
                    System.Globalization.CultureInfo.InvariantCulture, out var val))
            {
                total += val;
            }
        }
        return total;
    }
}
