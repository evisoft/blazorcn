@* ============================================================
   Block: gallery-waterfall
   Title: GalleryWaterfall
   Description: A Pinterest-style waterfall masonry layout with variable-height cards built with React, Next.js, shadcn/ui, Tailwind CSS, and Framer Motion for responsive multi-column layouts
   Source: original/blocks/gallery/gallery-waterfall.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Waterfall Gallery</h2>
            <p class="mt-1 text-muted-foreground text-xs">Pinterest-style masonry layout</p>
        </div>

        <div class="p-4">
            <div class="grid grid-cols-3 gap-3">
                @foreach (var col in _columns)
                {
                    <div class="flex flex-col gap-3">
                        @foreach (var it in col)
                        {
                            var item = it;
                            <div class="group relative overflow-hidden rounded-md border"
                                 style="@($"height:{item.Height}px")">
                                <img src="@item.Image" alt="@item.Title" class="h-full w-full object-cover" />

                                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent p-3 opacity-0 transition-opacity group-hover:opacity-100">
                                    <div class="flex items-center justify-between">
                                        <span class="font-medium text-sm text-white">@item.Title</span>
                                        <button @onclick="@(() => ToggleLike(item.Id))"
                                                class="flex items-center gap-1 rounded-full bg-white/20 px-2 py-1 backdrop-blur-sm transition-colors hover:bg-white/30"
                                                type="button">
                                            <LucideIconCn Name="heart" Size="12"
                                                          Class="@Cn.Merge("size-3", _likedItems.Contains(item.Id) ? "fill-red-500 text-red-500" : "text-white")" />
                                            <span class="text-white text-xs">
                                                @(item.Likes + (_likedItems.Contains(item.Id) ? 1 : 0))
                                            </span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-center text-muted-foreground text-xs">
                @_items.Length items in gallery
            </p>
        </div>
    </div>
</section>

@code {
    private record GalleryItem(string Id, string Title, int Likes, int Height, string Image);

    private static readonly GalleryItem[] _items =
    [
        new("1",  "Mountain Peak",      234, 320, "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop"),
        new("2",  "Urban Architecture", 189, 240, "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=800&auto=format&fit=crop"),
        new("3",  "Forest Trail",       412, 380, "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800&auto=format&fit=crop"),
        new("4",  "Coastal View",       567, 280, "https://images.unsplash.com/photo-1518173946687-a544bf02a536?w=800&auto=format&fit=crop"),
        new("5",  "Desert Sunset",      891, 360, "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=800&auto=format&fit=crop"),
        new("6",  "City Lights",        145, 240, "https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=800&auto=format&fit=crop"),
        new("7",  "Winter Scene",       678, 320, "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&auto=format&fit=crop"),
        new("8",  "Tropical Paradise",  234, 400, "https://images.unsplash.com/photo-1475924156734-496f6cac6ec1?w=800&auto=format&fit=crop"),
        new("9",  "Canyon Vista",       456, 280, "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800&auto=format&fit=crop"),
        new("10", "River Valley",       321, 360, "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=800&auto=format&fit=crop"),
        new("11", "Mountain Lake",      789, 240, "https://images.unsplash.com/photo-1472214103451-9374bd1c798e?w=800&auto=format&fit=crop"),
        new("12", "Beach Sunrise",      512, 340, "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop"),
    ];

    private static readonly GalleryItem[][] _columns = DistributeItems();

    private HashSet<string> _likedItems = [];

    private static GalleryItem[][] DistributeItems()
    {
        const int columns = 3;
        var cols = new List<GalleryItem>[columns];
        var colHeights = new int[columns];
        for (var i = 0; i < columns; i++)
            cols[i] = [];

        foreach (var item in _items)
        {
            var shortest = 0;
            for (var i = 1; i < columns; i++)
                if (colHeights[i] < colHeights[shortest])
                    shortest = i;
            cols[shortest].Add(item);
            colHeights[shortest] += item.Height;
        }

        return [cols[0].ToArray(), cols[1].ToArray(), cols[2].ToArray()];
    }

    private void ToggleLike(string id)
    {
        if (!_likedItems.Remove(id))
            _likedItems.Add(id);
    }
}
