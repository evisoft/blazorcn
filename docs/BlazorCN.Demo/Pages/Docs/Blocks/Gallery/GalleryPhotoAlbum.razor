@* ============================================================
   Block: gallery-photo-album
   Title: GalleryPhotoAlbum
   Description: A photo album gallery with cover page and page flip transitions, built with React, Next.js, shadcn/ui, Framer Motion, and Tailwind CSS
   Source: original/blocks/gallery/gallery-photo-album.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @if (!_isOpen)
    {
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="flex min-h-[600px] flex-col items-center justify-center p-8">
                <div class="flex size-16 items-center justify-center rounded-full bg-muted/50">
                    <LucideIconCn Name="book-open" Size="32" Class="size-8 text-muted-foreground" />
                </div>
                <h1 class="mt-6 text-2xl font-semibold">Travel Memories</h1>
                <p class="mt-2 text-center text-sm text-muted-foreground">
                    A collection of moments from around the world
                </p>
                <p class="mt-1 text-xs text-muted-foreground">@_albumPages.Length pages</p>
                <ButtonCn @onclick="OpenAlbum" Class="mt-8" Variant="ButtonVariant.Outline">
                    Open Album
                </ButtonCn>
            </div>
        </div>
    }
    else
    {
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="flex items-center justify-between border-b px-4 py-3">
                <ButtonCn @onclick="CloseAlbum" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Close Album
                </ButtonCn>
                <span class="text-xs text-muted-foreground">
                    Page @(_currentPage + 1) of @_albumPages.Length
                </span>
            </div>

            <div class="relative min-h-[600px]">
                <div class="p-6">
                    @if (_albumPages[_currentPage].Layout == "single")
                    {
                        <div class="flex h-[520px] items-center justify-center">
                            <img src="https://images.unsplash.com/photo-1472214103451-9374bd1c798e?w=800&auto=format&fit=crop&h=600"
                                 alt=""
                                 class="aspect-[4/3] h-full rounded-md object-cover" />
                        </div>
                    }
                    else
                    {
                        <div class="grid h-[520px] grid-cols-2 gap-4">
                            <div class="flex items-center justify-center">
                                <img src="https://images.unsplash.com/photo-1504567961542-e24d9439a724?w=600&auto=format&fit=crop&h=800"
                                     alt=""
                                     class="aspect-[3/4] h-full rounded-md object-cover" />
                            </div>
                            <div class="flex items-center justify-center">
                                <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=600&auto=format&fit=crop&h=800"
                                     alt=""
                                     class="aspect-[3/4] h-full rounded-md object-cover" />
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="flex items-center justify-between border-t px-4 py-3">
                <ButtonCn @onclick="PrevPage" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                          Disabled="@(_currentPage == 0)" Class="h-7 gap-1 text-xs">
                    <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                    Previous
                </ButtonCn>
                <div class="flex gap-1.5">
                    @foreach (var (page, index) in _albumPages.Select((p, i) => (p, i)))
                    {
                        var idx = index;
                        <button type="button"
                                aria-label="@($"Go to page {idx + 1}")" @onclick="@(() => GoToPage(idx))"
                                class="@Cn.Merge("size-1.5 rounded-full transition-colors", idx == _currentPage ? "bg-foreground" : "bg-muted")" />
                    }
                </div>
                <ButtonCn @onclick="NextPage" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                          Disabled="@(_currentPage == _albumPages.Length - 1)" Class="h-7 gap-1 text-xs">
                    Next
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>
    }
</section>

@code {
    private record AlbumPage(string Id, string[] Images, string Layout);

    private bool _isOpen = false;
    private int _currentPage = 0;

    private static readonly AlbumPage[] _albumPages =
    [
        new("page1", ["Sunset Beach"], "single"),
        new("page2", ["Mountain Peak", "Forest Trail"], "double"),
        new("page3", ["City Lights"], "single"),
        new("page4", ["Desert Dunes", "Ocean Waves"], "double"),
        new("page5", ["Northern Lights"], "single"),
    ];

    private void OpenAlbum() => _isOpen = true;
    private void CloseAlbum() => _isOpen = false;

    private void NextPage()
    {
        if (_currentPage < _albumPages.Length - 1)
            _currentPage++;
    }

    private void PrevPage()
    {
        if (_currentPage > 0)
            _currentPage--;
    }

    private void GoToPage(int index)
    {
        _currentPage = index;
    }
}
