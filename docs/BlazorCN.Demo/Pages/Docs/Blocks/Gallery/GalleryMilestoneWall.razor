@* ============================================================
   Block: gallery-milestone-wall
   Title: GalleryMilestoneWall
   Description: A company milestone gallery with year markers, event photos, and descriptions built with React, Next.js, shadcn/ui, and Tailwind CSS. Perfect for history and about pages with timeline-style milestone displays.
   Source: original/blocks/gallery/gallery-milestone-wall.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Company Milestones</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Key moments in our journey</p>
        </div>

        <div class="relative overflow-x-auto" tabindex="0" role="group" aria-label="Milestones timeline">
            <div class="flex gap-6 p-6">
                @foreach (var ms in _milestones)
                {
                    var milestone = ms;
                    var index = System.Array.IndexOf(_milestones, milestone);
                    <div class="relative flex min-w-[280px] flex-col">
                        @* Timeline connector *@
                        @if (index < _milestones.Length - 1)
                        {
                            <div class="absolute left-[140px] top-8 h-px w-[calc(100%+24px)] bg-border"></div>
                        }

                        @* Year marker *@
                        <div class="relative z-10 mb-3 flex items-center gap-2">
                            <div class="flex size-8 shrink-0 items-center justify-center rounded-full border-2 bg-card">
                                <span class="font-medium text-xs">@(index + 1)</span>
                            </div>
                            <div>
                                <div class="font-medium text-sm">@milestone.Year</div>
                                <div class="text-muted-foreground text-xs">@milestone.Month</div>
                            </div>
                        </div>

                        @* Image placeholder *@
                        <div class="mb-3 overflow-hidden rounded-md border">
                            <img src="https://images.unsplash.com/photo-1475924156734-496f6cac6ec1?w=800&auto=format&fit=crop&h=600"
                                 alt=""
                                 class="aspect-[4/3] object-cover" />
                        </div>

                        @* Content *@
                        <div class="flex flex-col gap-2">
                            <div>
                                <div class="flex items-start justify-between gap-2">
                                    <h3 class="font-medium text-sm leading-tight">@milestone.Title</h3>
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="shrink-0 text-[10px]">
                                        @milestone.Category
                                    </BadgeCn>
                                </div>
                                <p class="mt-1 text-muted-foreground text-xs leading-relaxed">
                                    @milestone.Description
                                </p>
                            </div>

                            <div class="flex flex-col gap-1">
                                <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                    <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                                    <span>@milestone.Location</span>
                                </div>
                                <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                    <LucideIconCn Name="users" Size="12" Class="size-3" />
                                    <span>@milestone.Attendees team members</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer stats *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-4 text-xs">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="calendar" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-muted-foreground">6 milestones since 2018</span>
                </div>
                <span class="text-muted-foreground">•</span>
                <span class="text-muted-foreground">Scroll to view timeline</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record Milestone(string Id, string Year, string Month, string Title, string Description, string Location, int Attendees, string Category);

    private static readonly Milestone[] _milestones =
    [
        new("1", "2018", "Jan", "Company Founded", "Started with a vision to revolutionize the industry", "San Francisco, CA", 3, "Launch"),
        new("2", "2019", "Jun", "Series A Funding", "Raised $10M to accelerate product development", "San Francisco, CA", 25, "Funding"),
        new("3", "2020", "Mar", "First 1,000 Customers", "Reached milestone of serving 1,000 active customers", "Remote", 50, "Growth"),
        new("4", "2021", "Sep", "Global Expansion", "Opened offices in London, Tokyo, and Sydney", "Multiple", 120, "Expansion"),
        new("5", "2022", "Dec", "Series B Funding", "Secured $50M to expand globally and grow team", "New York, NY", 200, "Funding"),
        new("6", "2024", "May", "Product 2.0 Launch", "Released completely redesigned platform with AI features", "San Francisco, CA", 500, "Product"),
    ];
}
