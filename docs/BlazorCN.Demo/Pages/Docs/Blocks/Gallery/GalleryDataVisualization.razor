@* ============================================================
   Block: gallery-data-visualization
   Title: GalleryDataVisualization
   Description: A gallery of chart and graph previews with data sources and last updated info built with React, Next.js, shadcn/ui, and Tailwind CSS. Perfect for analytics dashboards with visual data browsing.
   Source: original/blocks/gallery/gallery-data-visualization.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="font-medium text-sm">Analytics Dashboard</h2>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Browse your data visualizations
                    </p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                    <span>Refresh all</span>
                </ButtonCn>
            </div>
        </div>

        <div class="grid gap-4 p-4 sm:grid-cols-2 md:grid-cols-3">
            @foreach (var chart in _charts)
            {
                var chartItem = chart;
                @* The card used to be one big <button> wrapping the per-chart options button —
                   invalid HTML, and the outer button swallowed the inner one's clicks (hence the
                   @onclick:stopPropagation workaround that used to sit on it). The card action is
                   now a stretched overlay button covering the card for pointer users, with the
                   options control as a real sibling button stacked above it. *@
                <div class="group relative overflow-hidden rounded-lg border bg-card text-left transition-colors hover:bg-muted/50">
                    <button type="button"
                            aria-label="@($"View {chartItem.Title}")"
                            class="absolute inset-0 z-10 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-ring"></button>

                    @* Chart preview placeholder *@
                    <div class="relative border-b bg-muted p-4">
                        <div class="flex h-32 items-end justify-around gap-1">
                            @if (chartItem.Type == "bar")
                            {
                                <div class="w-full rounded-t bg-foreground/20" style="height:40%"></div>
                                <div class="w-full rounded-t bg-foreground/20" style="height:70%"></div>
                                <div class="w-full rounded-t bg-foreground/20" style="height:55%"></div>
                                <div class="w-full rounded-t bg-foreground/20" style="height:85%"></div>
                                <div class="w-full rounded-t bg-foreground/20" style="height:60%"></div>
                            }
                            @if (chartItem.Type == "line")
                            {
                                <div class="relative size-full">
                                    <svg class="size-full" viewBox="0 0 100 100" preserveAspectRatio="none">
                                        <title>Line chart preview</title>
                                        <polyline
                                            points="0,80 20,60 40,70 60,40 80,50 100,20"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            class="text-foreground/20" />
                                    </svg>
                                </div>
                            }
                            @if (chartItem.Type == "pie")
                            {
                                <div class="mx-auto flex size-24 items-center justify-center rounded-full border-[12px] border-foreground/20"></div>
                            }
                            @if (chartItem.Type == "area")
                            {
                                <div class="relative size-full">
                                    <svg class="size-full" viewBox="0 0 100 100" preserveAspectRatio="none">
                                        <title>Area chart preview</title>
                                        <polygon
                                            points="0,100 0,80 20,60 40,70 60,40 80,50 100,20 100,100"
                                            class="fill-foreground/10" />
                                    </svg>
                                </div>
                            }
                        </div>
                        <div class="absolute top-2 right-2">
                            <LucideIconCn Name="@ChartIconName(chartItem.Type)" Size="16" Class="size-4 text-muted-foreground/60" />
                        </div>
                    </div>

                    @* Chart info *@
                    <div class="p-3">
                        <div class="mb-2 flex items-start justify-between gap-2">
                            <h3 class="font-medium text-sm leading-tight">@chartItem.Title</h3>
                            <div class="relative z-20">
                                <button type="button"
                                        class="size-6 shrink-0 p-0 opacity-0 transition-opacity group-hover:opacity-100 inline-flex items-center justify-center rounded-md text-sm font-medium hover:bg-accent hover:text-accent-foreground" aria-label="@($"Options for {chartItem.Title}")">
                                    <LucideIconCn Name="more-vertical" Size="12" Class="size-3" />
                                </button>
                            </div>
                        </div>

                        <div class="mb-2 flex items-center gap-2">
                            <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px]">
                                @chartItem.DataSource
                            </BadgeCn>
                            @if (chartItem.Trend != "neutral")
                            {
                                <div class="@Cn.Merge("flex items-center gap-0.5 text-[10px]", chartItem.Trend == "up" ? "text-emerald-600" : "text-red-600")">
                                    <LucideIconCn Name="trending-up" Size="12" Class="@Cn.Merge("size-3", chartItem.Trend == "down" ? "rotate-180" : "")" />
                                    <span>@chartItem.TrendValue</span>
                                </div>
                            }
                        </div>

                        <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                            <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                            <span>Updated @chartItem.LastUpdated</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">@_charts.Length visualizations</span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Create new chart
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record ChartData(string Id, string Title, string Type, string DataSource, string LastUpdated, string Trend, string TrendValue);

    private static readonly ChartData[] _charts =
    [
        new("1", "Monthly Revenue",    "bar",  "Stripe API",        "5 min ago",   "up",      "+12.5%"),
        new("2", "User Growth",        "line", "PostgreSQL",        "15 min ago",  "up",      "+8.2%"),
        new("3", "Traffic Sources",    "pie",  "Google Analytics",  "1 hour ago",  "neutral", "0%"),
        new("4", "Conversion Rate",    "area", "Mixpanel",          "2 hours ago", "down",    "-2.1%"),
        new("5", "Customer Retention", "line", "Internal DB",       "3 hours ago", "up",      "+5.7%"),
        new("6", "Feature Usage",      "bar",  "Segment",           "5 hours ago", "neutral", "+0.3%"),
    ];

    private static string ChartIconName(string type) => type switch
    {
        "bar"  => "bar-chart-3",
        "line" => "line-chart",
        "pie"  => "pie-chart",
        "area" => "trending-up",
        _      => "bar-chart-3",
    };
}
