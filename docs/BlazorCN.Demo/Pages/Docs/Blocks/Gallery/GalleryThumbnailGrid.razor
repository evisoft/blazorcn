@* ============================================================
   Block: gallery-thumbnail-grid
   Title: GalleryThumbnailGrid
   Description: A dense thumbnail grid gallery built with React, Next.js, shadcn/ui, and Tailwind CSS. Click any thumbnail to expand into a full modal view with navigation controls.
   Source: original/blocks/gallery/gallery-thumbnail-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Photo Gallery</h2>
            <p class="mt-1 text-xs text-muted-foreground">@_images.Length images available</p>
        </div>

        @* Thumbnail Grid *@
        <div class="grid grid-cols-6 gap-1 p-4">
            @foreach (var img in _images)
            {
                var image = img;
                var index = System.Array.IndexOf(_images, image);
                <button type="button"
                        class="group relative aspect-square overflow-hidden rounded bg-muted transition-all hover:ring-2 hover:ring-ring"
                        @onclick="@(() => _selectedIndex = index)">
                    <img src="@image.Image" alt="@image.Title" class="size-full object-cover" />
                    <div class="absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/20"></div>
                </button>
            }
        </div>

        @* Modal *@
        @if (_selectedIndex.HasValue)
        {
            var selIdx = _selectedIndex.Value;
            var selImage = _images[selIdx];
            @* React hand-rolls this overlay too, so the markup stays — but it needs a role and
               an Escape handler, or the only way out is a mouse. *@
            <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/90"
                 role="dialog" aria-modal="true" aria-label="@($"{selImage.Title} — enlarged")"
                 tabindex="-1" autofocus
                 @onkeydown="@((KeyboardEventArgs e) => { if (e.Key == "Escape") { _selectedIndex = null; } })"
                 @onclick="@(() => _selectedIndex = null)">
                <div class="relative mx-4 w-full max-w-4xl"
                     @onclick:stopPropagation="true">
                    @* Close Button *@
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                              Class="absolute -top-12 right-0 text-white hover:bg-white/10"
                              OnClick="@(() => _selectedIndex = null)" aria-label="Close">
                        <LucideIconCn Name="x" Size="20" Class="size-5" />
                    </ButtonCn>

                    @* Image *@
                    <img src="@selImage.Image"
                         alt="@selImage.Title"
                         class="aspect-video w-full overflow-hidden rounded-lg object-cover" />

                    @* Image Info *@
                    <div class="mt-4 flex items-start justify-between text-white">
                        <div>
                            <h3 class="font-medium text-sm">@selImage.Title</h3>
                            <p class="mt-1 text-muted-foreground text-xs">@selImage.Category</p>
                        </div>
                        <span class="text-muted-foreground text-xs">@(selIdx + 1) / @_images.Length</span>
                    </div>

                    @* Navigation *@
                    <div class="mt-4 flex gap-2">
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                  Class="bg-white/10 hover:bg-white/20"
                                  Disabled="@(selIdx == 0)"
                                  OnClick="HandlePrevious">
                            <LucideIconCn Name="chevron-left" Size="16" Class="size-4" />
                            <span class="ml-1">Previous</span>
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                  Class="bg-white/10 hover:bg-white/20"
                                  Disabled="@(selIdx == _images.Length - 1)"
                                  OnClick="HandleNext">
                            <span class="mr-1">Next</span>
                            <LucideIconCn Name="chevron-right" Size="16" Class="size-4" />
                        </ButtonCn>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

