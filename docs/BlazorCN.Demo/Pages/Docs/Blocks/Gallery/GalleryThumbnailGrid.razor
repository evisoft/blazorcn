    private void HandlePrevious()
    {
        if (!_selectedIndex.HasValue || _selectedIndex.Value == 0) return;
        _selectedIndex = _selectedIndex.Value - 1;
    }

    private void HandleNext()
    {
        if (!_selectedIndex.HasValue || _selectedIndex.Value >= _images.Length - 1) return;
        _selectedIndex = _selectedIndex.Value + 1;
    }
