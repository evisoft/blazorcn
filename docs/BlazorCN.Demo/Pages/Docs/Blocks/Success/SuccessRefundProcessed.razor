@* ============================================================
   Block: success-refund-processed
   Title: SuccessRefundProcessed
   Description: A transparent refund status block showing the timeline of funds returning to the bank account, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-refund-processed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10">
                    <div class="size-1.5 rounded-full bg-emerald-500"></div>
                </div>
                <h2 class="text-sm font-medium">Refund processed</h2>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">
                A total of $49.00 has been returned to your original payment method.
            </p>
        </div>

        @* Timeline Section *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2 mb-4">
                <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Return timeline
                </span>
            </div>
            <div class="space-y-4">
                @for (int i = 0; i < _steps.Length; i++)
                {
                    var step = _steps[i];
                    <div class="flex gap-3">
                        <div class="flex flex-col items-center">
                            <div class="@Cn.Merge("size-4 rounded-full border flex items-center justify-center", step.Status == "completed" ? "bg-emerald-500 border-emerald-500" : "bg-background")">
                                @if (step.Status == "completed")
                                {
                                    <LucideIconCn Name="check-circle-2" Size="10" Class="size-2.5 text-white" />
                                }
                            </div>
                            @if (i != _steps.Length - 1)
                            {
                                <div class="w-px h-6 bg-border my-1"></div>
                            }
                        </div>
                        <div>
                            <p class="text-xs font-medium text-foreground">@step.Title</p>
                            <p class="text-[10px] text-muted-foreground">@step.Date</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Transaction Summary *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="rounded-full bg-background p-1.5 border">
                        <LucideIconCn Name="arrow-left-right" Size="12" Class="size-3 text-muted-foreground" />
                    </div>
                    <div>
                        <p class="text-xs font-medium">Visa ending in 4242</p>
                        <p class="text-[10px] text-muted-foreground">Reference: REF-109238</p>
                    </div>
                </div>
                <div class="text-right">
                    <p class="text-sm font-medium text-emerald-600">+$49.00</p>
                </div>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-2.5 flex justify-end bg-muted/50">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                View Billing History
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Step(string Title, string Date, string Status);

    private static readonly Step[] _steps =
    [
        new("Refund initiated", "April 3, 2026", "completed"),
        new("Processed by processor", "April 3, 2026", "completed"),
        new("Funds sent to bank", "Estimated 3-5 business days", "pending"),
    ];
}
