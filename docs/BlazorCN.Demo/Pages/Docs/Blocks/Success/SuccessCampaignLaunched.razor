@* ============================================================
   Block: success-campaign-launched
   Title: SuccessCampaignLaunched
   Description: A marketing-focused success block for campaign launches, featuring real-time sending stats and live links, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-campaign-launched.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground shadow-sm">

        @* Header Section *@
        <div class="border-b px-4 py-4">
            <div class="flex flex-col items-center gap-3 sm:flex-row">
                <div class="flex size-10 items-center justify-center rounded-full bg-muted">
                    <LucideIconCn Name="zap" Size="20" Class="size-5 text-foreground" />
                </div>
                <div class="flex-1 text-center sm:text-left">
                    <h2 class="text-sm font-medium">Campaign "Summer-Sale-2024" is live</h2>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Your marketing blast has been initiated and is now being delivered.
                    </p>
                </div>
            </div>
        </div>

        @* Stats Grid *@
        <div class="border-b px-4 py-4 bg-muted/10">
            <div class="flex items-center gap-2 mb-4">
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Campaign Stats
                </span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                @foreach (var stat in _stats)
                {
                    <div class="flex flex-col gap-1.5 p-3 rounded border bg-background text-center sm:text-left shadow-sm">
                        <div class="flex items-center justify-center sm:justify-start gap-2">
                            <LucideIconCn Name="@stat.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="text-[10px] text-muted-foreground uppercase">@stat.Label</span>
                        </div>
                        <p class="text-xs font-semibold">@stat.Value</p>
                    </div>
                }
            </div>
        </div>

        @* Live Link Section *@
        <div class="border-b px-4 py-4 bg-muted/30">
            <div class="flex items-center gap-2 mb-3">
                <LucideIconCn Name="globe" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Live Preview Link
                </span>
            </div>
            <div class="flex items-center gap-2">
                <div class="flex-1 px-3 py-2 rounded border bg-background text-xs font-mono text-muted-foreground overflow-hidden text-ellipsis whitespace-nowrap shadow-inner">
                    https://acme.com/campaigns/summer-sale-2024
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-[11px] gap-1.5 shrink-0">
                    Visit Page
                    <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                <p class="text-[10px] text-muted-foreground">Delivery in progress...</p>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Manage
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    View Analytics
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record StatItem(string Label, string Value, string Icon);

    private static readonly StatItem[] _stats =
    [
        new("Total Recipients", "48,290", "send"),
        new("Channel", "Email + SMS", "megaphone"),
        new("Estimated Reach", "98.2%", "bar-chart-3"),
    ];
}
