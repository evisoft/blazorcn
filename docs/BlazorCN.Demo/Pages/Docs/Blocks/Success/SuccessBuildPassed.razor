@* ============================================================
   Block: success-build-passed
   Title: SuccessBuildPassed
   Description: A CI/CD pipeline success block that confirms a green build with test results and artifact details, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-build-passed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-emerald-500/10">
                    <LucideIconCn Name="check-circle-2" Size="20" Class="size-5 text-emerald-500" />
                </div>
                <div>
                    <h2 class="text-sm font-medium text-emerald-600 dark:text-emerald-400">
                        Build #1284 passed
                    </h2>
                    <p class="text-xs text-muted-foreground">
                        CI/CD pipeline completed successfully for commit 8f2a1c9.
                    </p>
                </div>
            </div>
        </div>

        @* Pipeline Stages *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex flex-wrap gap-4">
                <div class="flex items-center gap-2">
                    <div class="size-1.5 rounded-full bg-emerald-500"></div>
                    <span class="text-[11px] font-medium">Linting</span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="size-1.5 rounded-full bg-emerald-500"></div>
                    <span class="text-[11px] font-medium">Unit Tests (142 passed)</span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="size-1.5 rounded-full bg-emerald-500"></div>
                    <span class="text-[11px] font-medium">Artifacts Generated</span>
                </div>
            </div>
        </div>

        @* Build Stats *@
        <div class="border-b px-4 py-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="flex items-center justify-between p-2 rounded-md border bg-muted/10">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="timer" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">Duration</span>
                    </div>
                    <span class="text-xs font-medium font-mono">2m 14s</span>
                </div>
                <div class="flex items-center justify-between p-2 rounded-md border bg-muted/10">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="box" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">Artifact Size</span>
                    </div>
                    <span class="text-xs font-medium font-mono">14.2 MB</span>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3 bg-muted/50">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="history" Size="14" Class="size-3.5 text-muted-foreground" />
                <p class="text-[10px] text-muted-foreground">Branch: main</p>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5">
                    View Tests
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5">
                    Deploy Now
                    <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>
