@* ============================================================
   Block: success-password-reset
   Title: SuccessPasswordReset
   Description: A secure and clear success confirmation block for password resets, featuring security reminders and a login CTA, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-password-reset.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-6 text-center">
            <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-emerald-500/10 mb-4">
                <LucideIconCn Name="shield-check" Size="24" Class="size-6 text-emerald-500" />
            </div>
            <h2 class="text-sm font-medium">Password reset successfully</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Your password has been updated. You can now use your new password to log in to your
                account.
            </p>
        </div>

        @* Security Reminders *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2 mb-3">
                <LucideIconCn Name="key-round" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Security Best Practices
                </span>
            </div>
            <div class="space-y-3">
                @foreach (var tip in _securityTips)
                {
                    <div class="flex items-start gap-2.5">
                        <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 mt-0.5 text-emerald-500 shrink-0" />
                        <p class="text-xs text-muted-foreground leading-snug">@tip</p>
                    </div>
                }
            </div>
        </div>

        @* Status Section *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="size-1.5 rounded-full bg-emerald-500"></div>
                    <span class="text-[11px] font-medium">Account Status: Secure</span>
                </div>
                <span class="text-[11px] text-muted-foreground italic">Last changed: Just now</span>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-3 flex justify-center bg-muted/50">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5 w-full sm:w-auto px-8">
                <LucideIconCn Name="log-in" Size="14" Class="size-3.5" />
                Continue to Login
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private static readonly string[] _securityTips =
    [
        "Use a unique password for every account.",
        "Enable two-factor authentication (2FA) for added security.",
        "Never share your password with anyone, including our staff.",
    ];
}
