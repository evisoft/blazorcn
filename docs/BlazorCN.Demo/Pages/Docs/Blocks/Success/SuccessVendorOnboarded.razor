                        </div>
                    </div>
                </div>
                <div class="rounded border bg-muted/10 p-3">
                    <div class="text-[10px] font-medium text-muted-foreground uppercase mb-2">
                        Primary Contact
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-medium">David Richardson</span>
                        <span class="text-[10px] text-muted-foreground">david@@acme-global.com</span>
                    </div>
                </div>
            </div>
        </div>

        @* Footer Actions *@
        <div class="bg-muted/50 px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500" />
                    <span class="text-[11px] font-medium text-muted-foreground">
                        All Systems Synchronized
                    </span>
                </div>
                <div class="flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                        View Contract
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs gap-2">
                        <LucideIconCn Name="layout-dashboard" Size="12" Class="size-3" />
