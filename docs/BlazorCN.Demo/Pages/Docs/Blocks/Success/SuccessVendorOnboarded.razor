                    <LucideIconCn Name="building-2" Size="20" Class="size-5 text-emerald-500" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Vendor successfully onboarded</h2>
                    <p class="mt-1 text-xs text-muted-foreground leading-snug">
                        Acme Global Systems is now active. All legal contracts are signed and their
                        dedicated partner portal is ready for use.
                    </p>
                </div>
            </div>
        </div>

        @* Status Indicators *@
        <div class="border-b px-4 py-5">
            <div class="grid gap-3 sm:grid-cols-2">
                <div class="flex items-center justify-between rounded border bg-muted/30 px-3 py-2.5">
                    <div class="flex items-center gap-2.5">
                        <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-emerald-500" />
