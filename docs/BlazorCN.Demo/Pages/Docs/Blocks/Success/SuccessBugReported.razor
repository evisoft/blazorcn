@* ============================================================
   Block: success-bug-reported
   Title: SuccessBugReported
   Description: A technical success screen for confirming bug report submissions, featuring an issue ID, triaging status, and developer-focused tracking links, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-bug-reported.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground shadow-sm">

        @* Header Section *@
        <div class="border-b px-4 py-5 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="flex size-9 items-center justify-center rounded-lg bg-red-500/10">
                    <LucideIconCn Name="bug" Size="20" Class="size-5 text-red-500" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Issue Reported</h2>
                    <p class="text-xs text-muted-foreground">Thank you for your contribution.</p>
                </div>
            </div>
            <div class="flex items-center gap-1.5 rounded-full border bg-muted/50 px-2 py-0.5">
                <div class="size-1.5 rounded-full bg-amber-500 animate-pulse"></div>
                <span class="text-[10px] font-medium uppercase tracking-tight text-muted-foreground">
                    Triaging
                </span>
            </div>
        </div>

        @* Issue Details *@
        <div class="border-b px-4 py-4 grid sm:grid-cols-2 gap-4">
            <div class="space-y-1">
                <p class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Tracking ID
                </p>
                <div class="flex items-center gap-2">
                    <code class="text-sm font-mono font-bold">#ISSUE-7421</code>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-5">
                        <LucideIconCn Name="terminal" Size="12" Class="size-3" />
                    </ButtonCn>
                </div>
            </div>
            <div class="space-y-1">
                <p class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Priority
                </p>
                <p class="text-sm font-medium">Medium (P2)</p>
            </div>
        </div>

        @* Report Summary *@
        <div class="border-b px-4 py-4 bg-muted/20">
            <div class="flex items-start gap-3">
                <div class="mt-0.5">
                    <LucideIconCn Name="info" Size="14" Class="size-3.5 text-muted-foreground" />
                </div>
                <div class="space-y-1">
                    <p class="text-xs font-medium">Report Summary</p>
                    <p class="text-[11px] text-muted-foreground leading-relaxed">
                        Component: <code>@@shadcn/ui-table</code> <br />
                        Environment: Production / Chrome 122.0.0 / macOS 14.3 <br />
                        Status: Reproducing in staging environment.
                    </p>
                </div>
            </div>
        </div>

        @* Action Links *@
        <div class="border-b px-0">
            <button type="button" class="flex w-full items-center justify-between px-4 py-3 hover:bg-muted/50 transition-colors">
                <div class="flex items-center gap-3">
                    <LucideIconCn Name="github" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-xs">Track on GitHub Issues</span>
                </div>
                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 text-muted-foreground" />
            </button>
            <button type="button" class="flex w-full items-center justify-between px-4 py-3 hover:bg-muted/50 transition-colors border-t">
                <div class="flex items-center gap-3">
                    <LucideIconCn Name="message-square" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-xs">Join the discussion on Discord</span>
                </div>
                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 text-muted-foreground" />
            </button>
        </div>

        @* Footer *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <p class="text-[10px] text-muted-foreground italic">
                Fixes are typically deployed within 48-72 hours.
            </p>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-500" />
                <span class="text-[10px] font-medium">Logged</span>
            </div>
        </div>

    </div>
</section>
