@* ============================================================
   Block: success-rate-limit-increased
   Title: SuccessRateLimitIncreased
   Description: React success block for API rate limit or quota increase confirmation in Next.js, featuring throughput metrics, bursting capabilities, and usage summaries using shadcn/ui and Tailwind CSS.
   Source: original/blocks/success/success-rate-limit-increased.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b p-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                    </div>
                    <h1 class="font-medium text-sm">Rate limit increased</h1>
                </div>
                <div class="flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[10px] font-bold uppercase tracking-wider">
                    <LucideIconCn Name="zap" Size="10" Class="size-2.5" />
                    Pro Tier
                </div>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Your API throughput capacity has been significantly expanded across all production
                endpoints.
            </p>
        </div>

        @* Quota Stats *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        New Limit
                    </span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-medium text-sm">@_newLimit</span>
                        <span class="text-[10px] font-medium text-muted-foreground uppercase">RPS</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Burst Allowance
                    </span>
                    <div class="mt-1 flex items-center gap-1">
                        <LucideIconCn Name="activity" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="font-medium text-xs">+@_burstCapacity RPS</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Increase
                    </span>
                    <div class="mt-1 flex items-center gap-1 text-emerald-600 dark:text-emerald-400">
                        <span class="font-medium text-xs">+@(_percentageIncrease)%</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Region Scope
                    </span>
                    <div class="mt-1 flex items-center gap-1">
                        <LucideIconCn Name="globe" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="font-medium text-xs">@_region</span>
                    </div>
                </div>
            </div>
        </div>

        @* Technical Details *@
        <div class="border-b p-4">
            <div class="flex items-center gap-2 mb-3">
                <LucideIconCn Name="gauge" Size="14" Class="size-3.5 text-muted-foreground" />
                <h2 class="font-medium text-sm">Throughput architecture</h2>
            </div>
            <div class="rounded-md border bg-muted/20 p-4">
                <div class="space-y-4">
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-muted-foreground">Concurrency Limit</span>
                        <span class="text-xs font-mono font-medium">1,200 active connections</span>
                    </div>
                    <div class="h-1.5 w-full bg-muted rounded-full overflow-hidden">
                        <div class="h-full bg-foreground" style="width: 20%"></div>
                    </div>
                    <p class="text-[10px] text-muted-foreground italic">
                        Note: Burst capacity is replenished at a rate of 50 requests per second after
                        exhaustion.
                    </p>
                </div>
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="settings-2" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Update your local SDK config</span>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    <LucideIconCn Name="play" Size="12" Class="size-3" />
                    Run Benchmark
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-3 text-xs">
                    Done
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private const int _newLimit = 5000;
    private const int _burstCapacity = 250;
    private const string _region = "Global Edge";
    private const int _percentageIncrease = 400;
}
