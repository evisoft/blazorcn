@* ============================================================
   Block: success-shipping-label-created
   Title: SuccessShippingLabelCreated
   Description: A logistics success state for fulfillment workflows featuring tracking numbers and carrier pickup details, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-shipping-label-created.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-emerald-500/10 shrink-0">
                    <LucideIconCn Name="barcode" Size="20" Class="size-5 text-emerald-500" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Shipping label created</h2>
                    <p class="mt-1 text-xs text-muted-foreground leading-snug">
                        Postage for Order #8821 has been paid. The label is ready for printing and a
                        pickup has been scheduled.
                    </p>
                </div>
            </div>
        </div>

        @* Tracking Number Section *@
        <div class="border-b px-4 py-5 bg-muted/20">
            <div class="flex items-center justify-between">
                <div class="space-y-1">
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        FedEx Tracking Number
                    </span>
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-mono font-bold tracking-tight">@_trackingNumber</span>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-6" OnClick="HandleCopy">
                            @if (_copied)
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                            }
                            else
                            {
                                <LucideIconCn Name="copy" Size="12" Class="size-3" />
                            }
                        </ButtonCn>
                    </div>
                </div>
                <div class="flex size-12 items-center justify-center rounded border bg-card p-1 shadow-sm">
                    <LucideIconCn Name="qr-code" Size="40" Class="size-full text-muted-foreground opacity-20" />
                </div>
            </div>
        </div>

        @* Logistics Details *@
        <div class="border-b px-4 py-5">
            <div class="grid gap-6 sm:grid-cols-2">
                <div class="space-y-3">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="truck" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                            Carrier Pickup
                        </span>
                    </div>
                    <div class="space-y-1">
                        <div class="text-xs font-medium">Today, Oct 24</div>
                        <div class="text-[10px] text-muted-foreground italic">
                            Window: 2:00 PM — 5:00 PM
                        </div>
                    </div>
                </div>
                <div class="space-y-3">
                    <div class="flex items-center gap-2">
                        <div class="size-1.5 rounded-full bg-emerald-500"></div>
                        <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                            Service Level
                        </span>
                    </div>
                    <div class="text-xs font-medium">FedEx Ground (2-Day)</div>
                </div>
            </div>
        </div>

        @* Action Footer *@
        <div class="bg-muted/50 px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-[11px] text-muted-foreground">Weight: 2.4 lbs | Zone: 4</span>
                <div class="flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                        Edit Manifest
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs gap-2">
                        <LucideIconCn Name="printer" Size="12" Class="size-3" />
                        Print Label
                    </ButtonCn>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private const string _trackingNumber = "FX-8842-9910-X2";
    private bool _copied = false;

    private async Task HandleCopy(MouseEventArgs e)
    {
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }
}
