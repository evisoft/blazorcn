@* ============================================================
   Block: success-loyalty-tier-unlocked
   Title: SuccessLoyaltyTierUnlocked
   Description: A marketing success block for loyalty program advancement, featuring tier details and active rewards, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-loyalty-tier-unlocked.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground shadow-sm">

        @* Header Section *@
        <div class="border-b px-4 py-6 text-center">
            <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-amber-500/10 mb-4">
                <LucideIconCn Name="trophy" Size="24" Class="size-6 text-amber-500" />
            </div>
            <h2 class="text-sm font-medium">Gold Tier Unlocked</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Congratulations! You've earned enough points to advance to the next level of rewards.
            </p>
        </div>

        @* Progress & Tier Info *@
        <div class="border-b px-4 py-4 bg-muted/30">
            <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="star" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Progress to Platinum
                    </span>
                </div>
                <span class="text-[10px] font-medium">2,500 / 5,000 pts</span>
            </div>
            <div class="h-1.5 w-full bg-muted rounded-full overflow-hidden mb-1">
                <div class="h-full w-1/2 bg-amber-500 rounded-full"></div>
            </div>
            <p class="text-[10px] text-muted-foreground text-right">50% completed</p>
        </div>

        @* Rewards Grid *@
        <div class="border-b px-4 py-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="flex items-center gap-3 p-3 rounded border bg-background shadow-sm">
                <div class="flex size-8 items-center justify-center rounded-full bg-emerald-500/10">
                    <LucideIconCn Name="zap" Size="16" Class="size-4 text-emerald-500" />
                </div>
                <div>
                    <p class="text-xs font-medium">2x Point Multiplier</p>
                    <p class="text-[10px] text-muted-foreground">On every purchase</p>
                </div>
            </div>
            <div class="flex items-center gap-3 p-3 rounded border bg-background shadow-sm">
                <div class="flex size-8 items-center justify-center rounded-full bg-blue-500/10">
                    <LucideIconCn Name="gift" Size="16" Class="size-4 text-blue-500" />
                </div>
                <div>
                    <p class="text-xs font-medium">Early Access</p>
                    <p class="text-[10px] text-muted-foreground">To new collections</p>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5 flex items-center justify-between bg-muted/50">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="crown" Size="14" Class="size-3.5 text-amber-500" />
                <p class="text-[10px] text-muted-foreground">Premium perks active</p>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    View Benefits
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Redeem Points
                </ButtonCn>
            </div>
        </div>

    </div>
</section>
