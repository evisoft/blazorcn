@* ============================================================
   Block: success-backup-created
   Title: SuccessBackupCreated
   Description: React success block for database or file backup confirmation in Next.js, featuring snapshot size, restoration instructions, and storage location details using shadcn/ui and Tailwind CSS.
   Source: original/blocks/success/success-backup-created.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b p-4">
            <div class="flex items-center gap-2">
                <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                </div>
                <h1 class="font-medium text-sm">Backup successful</h1>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Snapshot <span class="text-foreground font-mono">@_backup.Id</span> has been
                archived and encrypted.
            </p>
        </div>

        @* Backup Stats *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Snapshot Size
                    </span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-medium text-sm">@_backup.Size.ToString("F1")</span>
                        <span class="text-[10px] font-medium text-muted-foreground uppercase">GB</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Status
                    </span>
                    <div class="mt-1 flex items-center gap-1 text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="lock" Size="12" Class="size-3" />
                        <span class="font-medium text-xs">Encrypted</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Created At
                    </span>
                    <span class="mt-1 block font-medium text-xs tabular-nums">
                        @_backup.CreatedAt.Split(',')[1]
                    </span>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Storage Region
                    </span>
                    <span class="mt-1 block font-medium text-xs">@_backup.Region</span>
                </div>
            </div>
        </div>

        @* Restoration Guide *@
        <div class="border-b p-4">
            <div class="flex items-center gap-2 mb-3">
                <LucideIconCn Name="book-open" Size="14" Class="size-3.5 text-muted-foreground" />
                <h2 class="font-medium text-sm">Restoration guide</h2>
            </div>
            <div class="rounded-md border bg-muted/20 p-4">
                <p class="text-xs text-muted-foreground leading-relaxed">
                    To restore this backup, use the CLI command below or navigate to the restoration
                    portal. Ensure your production environment is in maintenance mode before proceeding.
                </p>
                <div class="mt-3 flex items-center justify-between rounded bg-black/5 p-2 dark:bg-white/5">
                    <code class="font-mono text-[10px] text-foreground">
                        shadcn-cli restore --id @_backup.Id
                    </code>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-6" aria-label="Archive">
                        <LucideIconCn Name="archive" Size="12" Class="size-3" />
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="server" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">@_backup.Provider</span>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    <LucideIconCn Name="rotate-ccw" Size="12" Class="size-3" />
                    Test Restore
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-3 text-xs">
                    Done
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record BackupData(string Id, string CreatedAt, double Size, bool Encrypted, string Provider, string Region);

    private static readonly BackupData _backup = new(
        Id: "snp_928374_db_prod",
        CreatedAt: "Oct 24, 2025, 3:12 AM",
        Size: 4.8,
        Encrypted: true,
        Provider: "AWS S3 (Standard)",
        Region: "us-west-2"
    );
}
