@* ============================================================
   Block: success-storage-optimized
   Title: SuccessStorageOptimized
   Description: React success block for database or disk optimization confirmation in Next.js, featuring reclaimed space metrics, compression ratios, and health status using shadcn/ui and Tailwind CSS.
   Source: original/blocks/success/success-storage-optimized.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b p-4">
            <div class="flex items-center gap-2">
                <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                </div>
                <h1 class="font-medium text-sm">Storage optimized</h1>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Maintenance cycle complete. System storage has been reorganized and compressed for
                peak performance.
            </p>
        </div>

        @* Storage Metrics *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Reclaimed Space
                    </span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-medium text-sm text-emerald-600 dark:text-emerald-400">@_reclaimedSpace.ToString("F1")</span>
                        <span class="text-[10px] font-medium text-muted-foreground uppercase">GB</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Compression
                    </span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-medium text-sm">@_compressionRatio</span>
                        <span class="text-[10px] font-medium text-muted-foreground">%</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Duration
                    </span>
                    <span class="mt-1 block font-medium text-sm tabular-nums">@_duration</span>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Disk Health
                    </span>
                    <div class="mt-1 flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400">
                        <div class="size-1.5 rounded-full bg-current"></div>
                        <span class="font-medium text-xs">@_healthStatus</span>
                    </div>
                </div>
            </div>
        </div>

        @* Volume Summary *@
        <div class="border-b p-4">
            <h2 class="mb-3 font-medium text-sm text-foreground">Optimization summary</h2>
            <div class="space-y-2">
                @foreach (var volume in _affectedVolumes)
                {
                    <div class="flex items-center justify-between rounded-md border bg-muted/10 px-3 py-2">
                        <div class="flex items-center gap-3">
                            <LucideIconCn Name="database" Size="14" Class="size-3.5 text-muted-foreground" />
                            <div>
                                <span class="block font-mono text-[11px] font-medium text-foreground">@volume.Name</span>
                                <span class="text-[10px] text-muted-foreground uppercase tracking-tighter">@volume.Result</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="font-mono text-[11px] text-emerald-600 dark:text-emerald-400">@volume.Size</span>
                            <LucideIconCn Name="zap" Size="12" Class="size-3 text-amber-500" />
                        </div>
                    </div>
                }
            </div>
            <button type="button" class="mt-4 flex items-center gap-1 font-medium text-[11px] text-muted-foreground hover:text-foreground transition-colors">
                View performance report
                <LucideIconCn Name="chevron-right" Size="12" Class="size-3" />
            </button>
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="hard-drive" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Drive: NVMe RAID-10</span>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    <LucideIconCn Name="line-chart" Size="12" Class="size-3" />
                    IOPS Stats
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                    Schedule Next
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record VolumeItem(string Name, string Result, string Size);

    private const double _reclaimedSpace = 2.4;
    private const int _compressionRatio = 42;
    private const string _duration = "14m";
    private const string _healthStatus = "Optimal";

    private static readonly VolumeItem[] _affectedVolumes =
    [
        new("primary_db_data", "Vacuumed",   "-1.2 GB"),
        new("assets_cdn_cache", "Compressed", "-840 MB"),
        new("audit_log_archive", "Pruned",    "-420 MB"),
    ];
}
