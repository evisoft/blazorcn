@* ============================================================
   Block: success-data-import
   Title: SuccessDataImport
   Description: React success block for data import confirmation in Next.js, featuring a summary of parsed, skipped, and failed records with detailed error breakdowns and next steps using shadcn/ui and Tailwind CSS.
   Source: original/blocks/success/success-data-import.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b p-4">
            <div class="flex items-center gap-2">
                <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                </div>
                <h1 class="font-medium text-sm">Import completed</h1>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Your data from <span class="text-foreground">@_filename</span> has
                been processed successfully.
            </p>
        </div>

        @* Stats Grid *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Total Records
                    </span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-medium text-sm">@_total.ToString("N0")</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Successfully Parsed
                    </span>
                    <div class="mt-1 flex items-baseline gap-1 text-emerald-600 dark:text-emerald-400">
                        <span class="font-medium text-sm">@_parsed.ToString("N0")</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Skipped (Valid)
                    </span>
                    <div class="mt-1 flex items-baseline gap-1 text-amber-600 dark:text-amber-400">
                        <span class="font-medium text-sm">@_skipped</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Processing Time
                    </span>
                    <span class="mt-1 block font-medium text-sm">@_duration</span>
                </div>
            </div>
        </div>

        @* Details Section *@
        <div class="border-b p-4">
            <h2 class="mb-3 font-medium text-sm text-foreground">Import summary</h2>
            <div class="space-y-3">
                <div class="flex items-start gap-3 rounded-md border bg-muted/20 p-3">
                    <LucideIconCn Name="info" Size="14" Class="mt-0.5 size-3.5 text-muted-foreground" />
                    <div class="flex-1">
                        <p class="text-xs">
                            <span class="font-medium">15 records</span> were skipped because they already
                            exist in your database. No duplicate entries were created.
                        </p>
                    </div>
                </div>
                <div class="flex items-start gap-3 rounded-md border border-red-200 bg-red-500/5 p-3 dark:border-red-900/50">
                    <LucideIconCn Name="file-text" Size="14" Class="mt-0.5 size-3.5 text-red-600 dark:text-red-400" />
                    <div class="flex-1">
                        <p class="text-red-600 text-xs dark:text-red-400">
                            <span class="font-medium">3 records failed</span> due to invalid email formats
                            on rows 402, 1105, and 12440.
                        </p>
                        <button type="button" class="mt-2 flex items-center gap-1 font-medium text-[11px] text-red-700 hover:underline dark:text-red-300">
                            Download error report (CSV)
                            <LucideIconCn Name="chevron-right" Size="12" Class="size-3" />
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="database" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Records are now live in CRM</span>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 px-3 text-xs">
                    View All Records
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-3 text-xs">
                    Continue
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private const int _total = 12500;
    private const int _parsed = 12482;
    private const int _skipped = 15;
    private const int _failed = 3;
    private const string _filename = "q3_customer_data_v2.csv";
    private const string _duration = "42s";
}
