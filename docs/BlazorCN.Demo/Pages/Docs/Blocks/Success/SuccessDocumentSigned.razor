@* ============================================================
   Block: success-document-signed
   Title: SuccessDocumentSigned
   Description: A formal success block for e-signature completion, featuring download options and email confirmation details, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-document-signed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4 text-center sm:text-left">
            <div class="flex flex-col items-center gap-3 sm:flex-row">
                <div class="flex size-10 items-center justify-center rounded-full bg-blue-500/10">
                    <LucideIconCn Name="pen-tool" Size="20" Class="size-5 text-blue-500" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Document signed successfully</h2>
                    <p class="mt-1 text-xs text-muted-foreground">
                        "Service-Agreement-2024.pdf" has been fully executed by all parties.
                    </p>
                </div>
            </div>
        </div>

        @* Status Summary *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2 mb-4">
                <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Execution details
                </span>
            </div>
            <div class="grid gap-3">
                <div class="flex items-center justify-between p-2 rounded-md border bg-muted/30">
                    <div class="flex items-center gap-3">
                        <div class="flex size-7 items-center justify-center rounded bg-background border">
                            <LucideIconCn Name="file-check" Size="14" Class="size-3.5 text-muted-foreground" />
                        </div>
                        <div class="space-y-0.5">
                            <p class="text-xs font-medium">Verification Status</p>
                            <p class="text-[10px] text-muted-foreground">Tamper-proof seal applied</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                        <span class="text-[10px] font-medium">Verified</span>
                    </div>
                </div>
                <div class="flex items-center justify-between p-2 rounded-md border bg-muted/30">
                    <div class="flex items-center gap-3">
                        <div class="flex size-7 items-center justify-center rounded bg-background border">
                            <LucideIconCn Name="mail" Size="14" Class="size-3.5 text-muted-foreground" />
                        </div>
                        <div class="space-y-0.5">
                            <p class="text-xs font-medium">Copies Dispatched</p>
                            <p class="text-[10px] text-muted-foreground">Sent to 3 signers</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                        <span class="text-[10px] font-medium">Sent</span>
                    </div>
                </div>
            </div>
        </div>

        @* Info Section *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-blue-500"></div>
                <p class="text-[11px] text-muted-foreground">
                    A copy of the signed document has been sent to your registered email address.
                </p>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <p class="text-[10px] text-muted-foreground">Reference: #DOC-SIG-8812</p>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5">
                    <LucideIconCn Name="download" Size="12" Class="size-3" />
                    Download PDF
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Done
                </ButtonCn>
            </div>
        </div>

    </div>
</section>
