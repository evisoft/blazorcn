@* ============================================================
   Block: success-abandoned-cart-recovered
   Title: SuccessAbandonedCartRecovered
   Description: A marketing success block for recovered sales, featuring email effectiveness stats and order confirmation, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-abandoned-cart-recovered.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground shadow-sm">

        @* Header Section *@
        <div class="border-b px-4 py-4">
            <div class="flex flex-col items-center gap-3 sm:flex-row">
                <div class="flex size-10 items-center justify-center rounded-full bg-muted">
                    <LucideIconCn Name="shopping-cart" Size="20" Class="size-5 text-foreground" />
                </div>
                <div class="flex-1 text-center sm:text-left">
                    <h2 class="text-sm font-medium">Abandoned Cart Recovered</h2>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Customer completed their purchase after receiving the recovery sequence.
                    </p>
                </div>
            </div>
        </div>

        @* Recovery Stats *@
        <div class="border-b px-4 py-4 grid grid-cols-1 sm:grid-cols-2 gap-4 bg-muted/10">
            <div class="space-y-3 p-3 rounded border bg-background shadow-sm">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="mail-check" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Recovery Trigger
                    </span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium">Email #2 (24h)</span>
                    <div class="px-2 py-0.5 rounded-full border bg-emerald-500/10 text-[9px] font-bold text-emerald-600 uppercase">
                        Success
                    </div>
                </div>
            </div>
            <div class="space-y-3 p-3 rounded border bg-background shadow-sm">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Revenue Saved
                    </span>
                </div>
                <div class="flex items-baseline gap-1">
                    <span class="text-lg font-semibold">$184.99</span>
                    <span class="text-[10px] text-muted-foreground">USD</span>
                </div>
            </div>
        </div>

        @* Order Confirmation *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between py-1">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="receipt" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs text-muted-foreground">Order Number</span>
                </div>
                <span class="text-xs font-mono font-medium">#ORD-92841-X</span>
            </div>
            <div class="flex items-center justify-between py-1">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="credit-card" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs text-muted-foreground">Payment Method</span>
                </div>
                <span class="text-xs font-medium">Visa •••• 4242</span>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5 flex items-center justify-between bg-muted/50">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sparkles" Size="14" Class="size-3.5 text-amber-500" />
                <p class="text-[10px] text-muted-foreground">Automation performing well</p>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    View Cart Log
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Manage Order
                </ButtonCn>
            </div>
        </div>

    </div>
</section>
