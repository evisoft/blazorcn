@* ============================================================
   Block: success-rating-collected
   Title: SuccessRatingCollected
   Description: A vibrant and encouraging success block for confirming feature or service ratings, featuring community impact stats and appreciation messages, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-rating-collected.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground shadow-sm">

        @* Top Celebration *@
        <div class="border-b px-4 py-8 text-center bg-primary/5">
            <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-primary/10 ring-8 ring-primary/5">
                <LucideIconCn Name="sparkles" Size="24" Class="size-6 text-primary" />
            </div>
            <h2 class="text-sm font-medium">Rating Received!</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Thanks for letting us know what you think. Your input directly influences our product
                roadmap.
            </p>
        </div>

        @* Rating Value *@
        <div class="border-b px-4 py-5 flex items-center justify-center gap-2">
            <div class="flex gap-1.5">
                @foreach (var i in new[] { 1, 2, 3, 4, 5 })
                {
                    <LucideIconCn Name="star" Size="20" Class="size-5 text-primary fill-primary" />
                }
            </div>
            <div class="h-4 w-px bg-border mx-2"></div>
            <span class="text-sm font-bold">5.0 / 5.0</span>
        </div>

        @* Community Impact Stats *@
        <div class="border-b px-4 py-6">
            <div class="mb-4">
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Community Impact
                </span>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="flex items-center gap-4 rounded-md border p-3 bg-muted/30">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-background border">
                        <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                    </div>
                    <div>
                        <p class="text-xs font-medium">1,240 Ratings</p>
                        <p class="text-[10px] text-muted-foreground">Total for this feature</p>
                    </div>
                </div>
                <div class="flex items-center gap-4 rounded-md border p-3 bg-muted/30">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-background border">
                        <LucideIconCn Name="trophy" Size="16" Class="size-4 text-muted-foreground" />
                    </div>
                    <div>
                        <p class="text-xs font-medium">Top Rated</p>
                        <p class="text-[10px] text-muted-foreground">In our latest release</p>
                    </div>
                </div>
            </div>
        </div>

        @* Action / Footer Section *@
        <div class="px-4 py-4 flex flex-col sm:flex-row items-center justify-between gap-4 bg-muted/50">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="heart" Size="14" Class="size-3.5 text-red-500" />
                <p class="text-[10px] text-muted-foreground">
                    We appreciate your continued support.
                </p>
            </div>
            <div class="flex items-center gap-2 w-full sm:w-auto">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs flex-1 sm:flex-initial gap-1.5">
                    <LucideIconCn Name="message-square" Size="12" Class="size-3" />
                    Leave Comment
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs flex-1 sm:flex-initial">
                    Back to App
                </ButtonCn>
            </div>
        </div>

        @* Status indicator *@
        <div class="px-4 py-2 border-t bg-muted/30">
            <div class="flex items-center gap-2 justify-center sm:justify-start">
                <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-500" />
                <p class="text-[10px] text-muted-foreground">Feedback Logged Successfully</p>
            </div>
        </div>

    </div>
</section>
