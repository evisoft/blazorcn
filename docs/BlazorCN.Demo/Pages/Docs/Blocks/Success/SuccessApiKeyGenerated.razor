@* ============================================================
   Block: success-api-key-generated
   Title: SuccessApiKeyGenerated
   Description: A developer-focused success block for API key creation, featuring a secure one-time secret reveal and copy utility, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-api-key-generated.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-primary/10 shrink-0">
                    <LucideIconCn Name="key" Size="20" Class="size-5 text-primary" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">API key generated</h2>
                    <p class="mt-1 text-xs text-muted-foreground leading-snug">
                        This is your only chance to view this secret key. Copy it now and store it in a
                        secure location.
                    </p>
                </div>
            </div>
        </div>

        @* Secret Key Section *@
        <div class="border-b px-4 py-6">
            <div class="flex items-center justify-between mb-3">
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Secret Key
                </span>
                <div class="flex items-center gap-1">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7" @onclick="@(() => _isVisible = !_isVisible)">
                        @if (_isVisible)
                        {
                            <LucideIconCn Name="eye-off" Size="14" Class="size-3.5" />
                        }
                        else
                        {
                            <LucideIconCn Name="eye" Size="14" Class="size-3.5" />
                        }
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7" @onclick="HandleCopy">
                        @if (_copied)
                        {
                            <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                        }
                        else
                        {
                            <LucideIconCn Name="copy" Size="14" Class="size-3.5" />
                        }
                    </ButtonCn>
                </div>
            </div>

            <div class="relative group">
                <div class="rounded border bg-muted/50 px-3 py-2.5 font-mono text-xs break-all tracking-tight min-h-[40px] flex items-center">
                    @if (_isVisible)
                    {
                        @_apiKey
                    }
                    else
                    {
                        @("••••••••••••••••••••••••••••••••••••••••")
                    }
                </div>
                @if (!_isVisible)
                {
                    <div class="absolute inset-0 flex items-center justify-center bg-muted/20 backdrop-blur-[1px] rounded transition-opacity group-hover:opacity-100 opacity-0 pointer-events-none">
                        <span class="text-[10px] text-muted-foreground font-medium uppercase tracking-widest">
                            Click eye to reveal
                        </span>
                    </div>
                }
            </div>

            <div class="mt-4 flex items-start gap-3 rounded border border-amber-500/20 bg-amber-500/5 p-3">
                <LucideIconCn Name="shield-alert" Size="16" Class="size-4 text-amber-600 shrink-0 mt-0.5" />
                <div>
                    <p class="text-[11px] font-medium text-amber-700">Security Warning</p>
                    <p class="text-[10px] text-amber-600 mt-1 leading-normal">
                        Never share this key or expose it in client-side code. If leaked, anyone can access
                        your data.
                    </p>
                </div>
            </div>
        </div>

        @* Integration Section *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="text-[11px] text-muted-foreground uppercase tracking-wider font-medium">
                        Environment
                    </span>
                    <span class="text-[11px] font-medium text-blue-500">Production</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-[11px] text-muted-foreground uppercase tracking-wider font-medium">
                        Created By
                    </span>
                    <span class="text-[11px] text-muted-foreground">Admin</span>
                </div>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-3 flex justify-end bg-muted/50">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs px-6">
                I've saved my key
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private bool _isVisible = false;
    private bool _copied = false;
    private const string _apiKey = "sk_live_51N2x9L4m7v8P9Q0R1S2T3U4V5W6X7Y8Z";

    private async Task HandleCopy()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
        StateHasChanged();
    }
}
