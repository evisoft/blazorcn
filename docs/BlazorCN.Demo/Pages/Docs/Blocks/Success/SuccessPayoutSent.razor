@* ============================================================
   Block: success-payout-sent
   Title: SuccessPayoutSent
   Description: React success block for affiliate and creator payouts in Next.js with a visual processing timeline, bank transfer details, and arrival estimation using shadcn/ui and Tailwind CSS.
   Source: original/blocks/success/success-payout-sent.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b p-4">
            <div class="flex items-center gap-2">
                <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                    <LucideIconCn Name="banknote" Size="14" Class="size-3.5" />
                </div>
                <h1 class="font-medium text-sm">Payout in progress</h1>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                We've initiated a transfer of @_payoutData.Amount to your primary bank account.
            </p>
        </div>

        @* Quick Summary *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                <div class="flex items-start gap-2.5">
                    <LucideIconCn Name="landmark" Size="14" Class="mt-0.5 size-3.5 text-muted-foreground" />
                    <div>
                        <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                            Destination
                        </span>
                        <span class="mt-0.5 block font-medium text-xs">@_payoutData.Destination</span>
                    </div>
                </div>
                <div class="flex items-start gap-2.5">
                    <LucideIconCn Name="calendar" Size="14" Class="mt-0.5 size-3.5 text-muted-foreground" />
                    <div>
                        <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                            Estimated arrival
                        </span>
                        <span class="mt-0.5 block font-medium text-xs">
                            @_payoutData.EstimatedArrival
                        </span>
                    </div>
                </div>
                <div class="flex items-start gap-2.5">
                    <LucideIconCn Name="clock" Size="14" Class="mt-0.5 size-3.5 text-muted-foreground" />
                    <div>
                        <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                            Payout ID
                        </span>
                        <span class="mt-0.5 block font-mono text-xs">@_payoutData.Id</span>
                    </div>
                </div>
            </div>
        </div>

        @* Timeline *@
        <div class="px-4 py-6">
            <div class="relative space-y-6 before:absolute before:bottom-0 before:left-[11px] before:top-0 before:w-px before:bg-border">
                @foreach (var step in _payoutData.Steps)
                {
                    <div class="relative flex items-start gap-4 pl-8">
                        <div class="@Cn.Merge("absolute left-0 flex size-6 items-center justify-center rounded-full border bg-background transition-colors", step.Status == "completed" ? "border-emerald-500 bg-emerald-500 text-white dark:text-emerald-950" : "border-border")">
                            @if (step.Status == "completed")
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3" />
                            }
                            else
                            {
                                <div class="@Cn.Merge("size-1.5 rounded-full", step.Status == "pending" ? "bg-amber-500 animate-pulse" : "bg-muted-foreground/30")"></div>
                            }
                        </div>
                        <div class="flex flex-1 flex-col gap-0.5">
                            <span class="@Cn.Merge("text-sm", step.Status == "upcoming" ? "text-muted-foreground" : "font-medium")">
                                @step.Label
                            </span>
                            <span class="text-muted-foreground text-xs">@step.Time</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <p class="text-muted-foreground text-xs">
                Having trouble? Check our
                <a href="#" class="underline underline-offset-2 hover:text-foreground">
                    Help Center
                </a>
            </p>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 px-3 text-xs">
                    View History
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-3 text-xs">
                    Manage Payouts
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record PayoutStep(string Label, string Time, string Status);

    private record PayoutData(string Id, string Amount, string Destination, string EstimatedArrival, PayoutStep[] Steps);

    private static readonly PayoutData _payoutData = new(
        Id: "po_2m1n9K7v",
        Amount: "$1,842.50",
        Destination: "Chase Bank •••• 8812",
        EstimatedArrival: "Oct 28 - Oct 30, 2025",
        Steps: [
            new("Payout initiated", "Oct 24, 09:12 AM", "completed"),
            new("Processing at Stripe", "Oct 24, 10:45 AM", "completed"),
            new("Sent to bank", "Estimated Oct 25", "pending"),
            new("Available in account", "Estimated Oct 28", "upcoming"),
        ]
    );
}
