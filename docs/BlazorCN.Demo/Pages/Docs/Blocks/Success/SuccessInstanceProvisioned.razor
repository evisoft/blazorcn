@* ============================================================
   Block: success-instance-provisioned
   Title: SuccessInstanceProvisioned
   Description: A cloud infrastructure success block for server provisioning, featuring IP addresses, credentials, and connection snippets, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-instance-provisioned.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-blue-500/10">
                    <LucideIconCn Name="server" Size="20" Class="size-5 text-blue-500" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Instance app-server-01 online</h2>
                    <p class="text-xs text-muted-foreground">
                        Successfully provisioned in us-east-1 (N. Virginia).
                    </p>
                </div>
            </div>
        </div>

        @* Connection Details *@
        <div class="border-b px-4 py-4 space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Public IP
                    </span>
                    <div class="flex items-center justify-between p-2 rounded-md border bg-muted/30">
                        <span class="text-xs font-mono">157.245.12.84</span>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-6 shrink-0" @onclick="@(() => CopyToClipboard("ip"))" aria-label="Confirm">
                            @if (_copiedField == "ip")
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                            }
                            else
                            {
                                <LucideIconCn Name="copy" Size="12" Class="size-3" />
                            }
                        </ButtonCn>
                    </div>
                </div>
                <div class="space-y-1.5">
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Username
                    </span>
                    <div class="flex items-center justify-between p-2 rounded-md border bg-muted/30">
                        <span class="text-xs font-mono">root</span>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-6 shrink-0" @onclick="@(() => CopyToClipboard("user"))" aria-label="Confirm">
                            @if (_copiedField == "user")
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                            }
                            else
                            {
                                <LucideIconCn Name="copy" Size="12" Class="size-3" />
                            }
                        </ButtonCn>
                    </div>
                </div>
            </div>

            <div class="space-y-1.5">
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground flex items-center gap-1.5">
                    <LucideIconCn Name="terminal" Size="12" Class="size-3" /> SSH Command
                </span>
                <div class="flex items-center justify-between p-2 rounded-md border bg-black text-white font-mono text-[11px] overflow-hidden">
                    <span class="truncate">ssh root@@157.245.12.84</span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-6 shrink-0 text-white hover:text-white hover:bg-white/10" @onclick="@(() => CopyToClipboard("ssh"))" aria-label="Confirm">
                        @if (_copiedField == "ssh")
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                        }
                        else
                        {
                            <LucideIconCn Name="copy" Size="12" Class="size-3" />
                        }
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Status Pills *@
        <div class="border-b px-4 py-3 bg-muted/30 flex flex-wrap gap-4">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield" Size="14" Class="size-3.5 text-emerald-500" />
                <span class="text-[11px] font-medium">Firewall Active</span>
            </div>
            <div class="flex items-center gap-2">
                <LucideIconCn Name="key" Size="14" Class="size-3.5 text-blue-500" />
                <span class="text-[11px] font-medium">SSH Keys Injected</span>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3 bg-muted/50">
            <p class="text-[10px] text-muted-foreground">Provisioning took 48s</p>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    View Console
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Manage Server
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string? _copiedField = null;

    private async Task CopyToClipboard(string field)
    {
        _copiedField = field;
        StateHasChanged();
        await Task.Delay(2000);
        _copiedField = null;
        StateHasChanged();
    }
}
