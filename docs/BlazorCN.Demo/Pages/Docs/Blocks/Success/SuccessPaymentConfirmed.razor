@* ============================================================
   Block: success-payment-confirmed
   Title: SuccessPaymentConfirmed
   Description: A professional payment confirmation block with a Stripe-style receipt and invoice download button, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-payment-confirmed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10">
                    <div class="size-1.5 rounded-full bg-emerald-500"></div>
                </div>
                <h2 class="text-sm font-medium">Payment confirmed</h2>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">
                A receipt has been sent to your email address. You can also download it below.
            </p>
        </div>

        @* Receipt Section *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2 mb-3">
                <LucideIconCn Name="receipt-text" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Receipt breakdown
                </span>
            </div>
            <div class="space-y-2">
                <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">Pro Plan (Annual)</span>
                    <span class="font-medium text-foreground">$144.00</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">Additional Seats (2)</span>
                    <span class="font-medium text-foreground">$24.00</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">Tax (GST 10%)</span>
                    <span class="font-medium text-foreground">$16.80</span>
                </div>
            </div>
        </div>

        @* Total Section *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex justify-between items-center">
                <span class="text-sm font-medium">Total amount paid</span>
                <span class="text-sm font-medium">$184.80</span>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-2.5 flex justify-end gap-2 bg-muted/50">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5">
                <LucideIconCn Name="download" Size="12" Class="size-3" />
                Download Invoice
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                Go to Dashboard
            </ButtonCn>
        </div>

    </div>
</section>
