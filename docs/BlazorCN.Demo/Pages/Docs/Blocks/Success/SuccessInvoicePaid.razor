@* ============================================================
   Block: success-invoice-paid
   Title: SuccessInvoicePaid
   Description: React success block for settled overdue invoices in Next.js with account restoration status, payment breakdown, and direct link to active dashboard using shadcn/ui and Tailwind CSS.
   Source: original/blocks/success/success-invoice-paid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header - Account Status *@
        <div class="border-b bg-muted/30 px-4 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="flex size-8 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="shield-check" Size="16" Class="size-4.5" />
                    </div>
                    <div>
                        <h1 class="font-medium text-sm">Account access restored</h1>
                        <p class="text-muted-foreground text-xs">
                            Invoice @_invoice.Number paid successfully.
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-2 rounded-full border bg-background px-2.5 py-1">
                    <span class="relative flex size-1.5">
                        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
                        <span class="relative inline-flex size-1.5 rounded-full bg-emerald-500"></span>
                    </span>
                    <span class="font-medium text-[10px] uppercase tracking-wider">
                        Account Active
                    </span>
                </div>
            </div>
        </div>

        @* Payment Details *@
        <div class="border-b px-4 py-4">
            <div class="grid grid-cols-2 gap-8">
                <div>
                    <h2 class="mb-2 font-medium text-muted-foreground text-xs uppercase tracking-wider">
                        Payment Summary
                    </h2>
                    <div class="space-y-1.5">
                        <div class="flex justify-between text-xs">
                            <span class="text-muted-foreground">Amount settled</span>
                            <span class="font-medium">@_invoice.Amount</span>
                        </div>
                        <div class="flex justify-between text-xs">
                            <span class="text-muted-foreground">Payment date</span>
                            <span class="font-medium">@_invoice.Date</span>
                        </div>
                        <div class="flex justify-between text-xs">
                            <span class="text-muted-foreground">Method</span>
                            <div class="flex items-center gap-1.5 font-medium">
                                <LucideIconCn Name="credit-card" Size="12" Class="size-3 text-muted-foreground" />
                                <span>Amex •••• 1005</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div>
                    <h2 class="mb-2 font-medium text-muted-foreground text-xs uppercase tracking-wider">
                        Unlocked Features
                    </h2>
                    <ul class="space-y-1.5">
                        @foreach (var feature in _invoice.Features)
                        {
                            <li class="flex items-center gap-2 text-xs">
                                <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-500" />
                                <span>@feature</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3">
            <p class="max-w-[300px] text-muted-foreground text-xs italic">
                Your billing cycle remains unchanged. Next invoice: Nov 24, 2025.
            </p>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 px-3 text-xs">
                    View Invoice
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 px-3 text-xs">
                    Open Dashboard
                    <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record InvoiceData(string Number, string Amount, string Date, string Status, string[] Features);

    private static readonly InvoiceData _invoice = new(
        Number: "INV-2025-0482",
        Amount: "$249.00",
        Date: "Oct 24, 2025",
        Status: "Settled",
        Features: ["Unlimited projects", "Team collaboration", "Advanced analytics", "Priority support"]
    );
}
