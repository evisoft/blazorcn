@* ============================================================
   Block: success-promo-applied
   Title: SuccessPromoApplied
   Description: A marketing success block for promotional code application, featuring discount details and expiration countdown, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-promo-applied.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header *@
        <div class="border-b px-4 py-4">
            <div class="flex flex-col items-center gap-3 sm:flex-row">
                <div class="flex size-10 items-center justify-center rounded-full bg-muted">
                    <LucideIconCn Name="tag" Size="20" Class="size-5 text-foreground" />
                </div>
                <div class="flex-1 text-center sm:text-left">
                    <h2 class="text-sm font-medium">Promo Code "SAVE20" Applied</h2>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Your account has been credited with a 20% discount for your next purchase.
                    </p>
                </div>
            </div>
        </div>

        @* Discount Summary *@
        <div class="border-b px-4 py-4 bg-muted/30">
            <div class="flex items-center gap-2 mb-4">
                <LucideIconCn Name="ticket" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Promotion Summary
                </span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="flex flex-col gap-1 p-3 rounded border bg-background">
                    <span class="text-[10px] text-muted-foreground uppercase">Discount</span>
                    <div class="flex items-baseline gap-1">
                        <span class="text-lg font-semibold">-20%</span>
                        <span class="text-[10px] text-emerald-500 font-medium tracking-tight">
                            ACTIVE
                        </span>
                    </div>
                </div>
                <div class="flex flex-col gap-1 p-3 rounded border bg-background">
                    <span class="text-[10px] text-muted-foreground uppercase">Valid Until</span>
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-medium">Dec 31, 2024</span>
                        <LucideIconCn Name="timer" Size="12" Class="size-3 text-amber-500" />
                    </div>
                </div>
            </div>
        </div>

        @* Details & Conditions *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-3">
                <div class="mt-0.5 p-1 rounded bg-blue-500/10">
                    <LucideIconCn Name="info" Size="12" Class="size-3 text-blue-500" />
                </div>
                <div class="flex-1">
                    <p class="text-[11px] font-medium leading-none">Applicable Items</p>
                    <p class="mt-1 text-[10px] text-muted-foreground leading-relaxed">
                        Applies to all annual plans and selected add-ons. Minimum purchase of $50 required
                        for discount to trigger at checkout.
                    </p>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-2.5 bg-muted/50">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sparkles" Size="14" Class="size-3.5 text-amber-500" />
                <span class="text-[10px] text-muted-foreground">Rewards active</span>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    View Terms
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5">
                    Shop Now
                    <LucideIconCn Name="circle-check" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>
