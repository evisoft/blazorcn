@* ============================================================
   Block: success-post-published
   Title: SuccessPostPublished
   Description: A clean success block for content publishing, featuring live URL preview and social sharing options, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-post-published.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4 text-center sm:text-left">
            <div class="flex flex-col items-center gap-3 sm:flex-row">
                <div class="flex size-10 items-center justify-center rounded-full bg-emerald-500/10">
                    <LucideIconCn Name="check-circle-2" Size="20" Class="size-5 text-emerald-500" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Post published successfully</h2>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Your article "The Future of Design Systems" is now live on your blog.
                    </p>
                </div>
            </div>
        </div>

        @* URL Section *@
        <div class="border-b px-4 py-4 bg-muted/30">
            <div class="flex items-center gap-2 mb-3">
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Live URL
                </span>
            </div>
            <div class="flex items-center gap-2">
                <div class="flex-1 px-3 py-2 rounded border bg-background text-xs font-mono text-muted-foreground overflow-hidden text-ellipsis whitespace-nowrap">
                    https://shadcn.io/posts/future-of-design-systems
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="size-8 shrink-0" @onclick="CopyToClipboard">
                    <LucideIconCn Name="copy" Size="14" Class="size-3.5" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="size-8 shrink-0">
                    <LucideIconCn Name="external-link" Size="14" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>

        @* Share Section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2 mb-4">
                <LucideIconCn Name="share-2" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Share with your network
                </span>
            </div>
            <div class="grid grid-cols-3 gap-3">
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-9 text-xs gap-2">
                    <LucideIconCn Name="twitter" Size="14" Class="size-3.5 text-[#1DA1F2]" />
                    Twitter
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-9 text-xs gap-2">
                    <LucideIconCn Name="linkedin" Size="14" Class="size-3.5 text-[#0A66C2]" />
                    LinkedIn
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-9 text-xs gap-2">
                    <LucideIconCn Name="facebook" Size="14" Class="size-3.5 text-[#1877F2]" />
                    Facebook
                </ButtonCn>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500"></div>
                <p class="text-[10px] text-muted-foreground">Status: Publicly Visible</p>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-8 text-xs">
                View Analytics
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private void CopyToClipboard()
    {
        // Clipboard interop omitted in presentational port
    }
}
