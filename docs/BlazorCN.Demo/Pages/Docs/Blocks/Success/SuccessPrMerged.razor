@* ============================================================
   Block: success-pr-merged
   Title: SuccessPrMerged
   Description: A development-focused success block for pull request merges, featuring branch deletion confirmation and deployment status, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-pr-merged.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4 text-center sm:text-left">
            <div class="flex flex-col items-center gap-3 sm:flex-row">
                <div class="flex size-10 items-center justify-center rounded-full bg-purple-500/10">
                    <LucideIconCn Name="git-merge" Size="20" Class="size-5 text-purple-500" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">PR #452 merged into main</h2>
                    <p class="mt-1 text-xs text-muted-foreground">
                        "feat: implement advanced search filtering" has been successfully integrated.
                    </p>
                </div>
            </div>
        </div>

        @* Branch & Deployment Status *@
        <div class="border-b px-4 py-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-3">
                    <div class="flex items-center gap-2">
                        <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                            Branch Status
                        </span>
                    </div>
                    <div class="flex items-center justify-between p-2 rounded-md border bg-muted/30">
                        <div class="flex items-center gap-2 overflow-hidden">
                            <LucideIconCn Name="git-branch" Size="14" Class="size-3.5 text-muted-foreground shrink-0" />
                            <span class="text-xs font-mono truncate">feat/search-filters</span>
                        </div>
                        <div class="flex items-center gap-1.5 shrink-0">
                            <LucideIconCn Name="trash-2" Size="12" Class="size-3 text-red-500" />
                            <span class="text-[10px] font-medium text-red-500">Deleted</span>
                        </div>
                    </div>
                </div>
                <div class="space-y-3">
                    <div class="flex items-center gap-2">
                        <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                            Deployment
                        </span>
                    </div>
                    <div class="flex items-center justify-between p-2 rounded-md border bg-muted/30">
                        <div class="flex items-center gap-2 overflow-hidden">
                            <LucideIconCn Name="rocket" Size="14" Class="size-3.5 text-muted-foreground shrink-0" />
                            <span class="text-xs font-medium">Production</span>
                        </div>
                        <div class="flex items-center gap-1.5 shrink-0">
                            <div class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
                            <span class="text-[10px] font-medium">Building...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Info Section *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                <p class="text-[11px] text-muted-foreground">
                    All 12 checks passed. No conflicts found during the merge process.
                </p>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <p class="text-[10px] text-muted-foreground">Merged by @@shadcn 2 minutes ago</p>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5">
                    View PR
                    <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Open Repo
                </ButtonCn>
            </div>
        </div>

    </div>
</section>
