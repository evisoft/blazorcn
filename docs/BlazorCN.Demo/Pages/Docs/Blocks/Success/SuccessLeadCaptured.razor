@* ============================================================
   Block: success-lead-captured
   Title: SuccessLeadCaptured
   Description: A sales-focused success block for new lead intake, showing CRM sync status and auto-responder confirmation, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-lead-captured.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header *@
        <div class="border-b px-4 py-4">
            <div class="flex flex-col items-center gap-3 sm:flex-row">
                <div class="flex size-10 items-center justify-center rounded-full bg-muted">
                    <LucideIconCn Name="user-plus" Size="20" Class="size-5 text-foreground" />
                </div>
                <div class="flex-1 text-center sm:text-left">
                    <h2 class="text-sm font-medium">Lead Captured</h2>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Prospect details have been recorded and added to your active pipeline.
                    </p>
                </div>
            </div>
        </div>

        @* Sync Status *@
        <div class="border-b px-4 py-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="flex flex-col gap-3 p-3 rounded-md border bg-muted/30">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="database" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        CRM Sync
                    </span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium">HubSpot</span>
                    <div class="flex items-center gap-1.5 px-2 py-0.5 rounded-full border bg-background">
                        <div class="size-1.5 rounded-full bg-emerald-500"></div>
                        <span class="text-[10px] text-muted-foreground">Synced</span>
                    </div>
                </div>
            </div>
            <div class="flex flex-col gap-3 p-3 rounded-md border bg-muted/30">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="mail-check" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Auto-Responder
                    </span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium">Intro Sequence</span>
                    <div class="flex items-center gap-1.5 px-2 py-0.5 rounded-full border bg-background">
                        <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-500" />
                        <span class="text-[10px] text-muted-foreground">Delivered</span>
                    </div>
                </div>
            </div>
        </div>

        @* Lead Details *@
        <div class="border-b px-4 py-3 bg-muted/10">
            <div class="flex items-center gap-2 mb-3">
                <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Lead Information
                </span>
            </div>
            <div class="space-y-2">
                <div class="flex items-center justify-between py-1.5 border-b border-dashed last:border-0">
                    <span class="text-xs text-muted-foreground">Name</span>
                    <span class="text-xs font-medium">Sarah Jenkins</span>
                </div>
                <div class="flex items-center justify-between py-1.5 border-b border-dashed last:border-0">
                    <span class="text-xs text-muted-foreground">Company</span>
                    <span class="text-xs font-medium">Acme Corp</span>
                </div>
                <div class="flex items-center justify-between py-1.5 border-b border-dashed last:border-0">
                    <span class="text-xs text-muted-foreground">Intent Score</span>
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="zap" Size="12" Class="size-3 text-amber-500 fill-amber-500" />
                        <span class="text-xs font-medium">High</span>
                    </div>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-2.5 bg-muted/50">
            <p class="text-[10px] text-muted-foreground italic">Lead ID: LD-92841-B</p>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    View Lead
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Assign to Rep
                </ButtonCn>
            </div>
        </div>

    </div>
</section>
