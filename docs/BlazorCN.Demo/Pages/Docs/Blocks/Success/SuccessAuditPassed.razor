@* ============================================================
   Block: success-audit-passed
   Title: SuccessAuditPassed
   Description: React success block for security audits or compliance scan completion in Next.js, featuring risk assessment scores, vulnerability summaries, and certification badges using shadcn/ui and Tailwind CSS.
   Source: original/blocks/success/success-audit-passed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b p-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                    </div>
                    <h1 class="font-medium text-sm">Audit passed successfully</h1>
                </div>
                <span class="font-mono text-[10px] text-muted-foreground bg-muted px-1.5 py-0.5 rounded">
                    @_auditId
                </span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Your system has met all compliance requirements for the Q4 Security Standards audit.
            </p>
        </div>

        @* Audit Stats *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Risk Score
                    </span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-medium text-sm">@_score</span>
                        <span class="text-[10px] font-medium text-muted-foreground uppercase">
                            /100
                        </span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Critical Risks
                    </span>
                    <div class="mt-1 flex items-center gap-1">
                        <LucideIconCn Name="shield-check" Size="12" Class="size-3 text-emerald-600" />
                        <span class="font-medium text-xs">@_criticalRisks</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Scan Speed
                    </span>
                    <div class="mt-1 flex items-center gap-1">
                        <LucideIconCn Name="zap" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="font-medium text-xs">Fast Path</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Last Audit
                    </span>
                    <span class="mt-1 block font-medium text-xs tabular-nums">Oct 24, 2025</span>
                </div>
            </div>
        </div>

        @* Vector Breakdown *@
        <div class="border-b p-4">
            <div class="flex items-center gap-2 mb-3">
                <LucideIconCn Name="search" Size="14" Class="size-3.5 text-muted-foreground" />
                <h2 class="font-medium text-sm">Security vector breakdown</h2>
            </div>
            <div class="space-y-2">
                @foreach (var vec in _vectors)
                {
                    <div class="flex items-center justify-between rounded-md border bg-muted/20 px-3 py-2">
                        <div class="flex items-center gap-2">
                            <div class="size-1.5 rounded-full bg-emerald-500"></div>
                            <span class="text-xs font-medium">@vec.Name</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="text-[10px] text-muted-foreground uppercase font-medium">
                                @vec.Status
                            </span>
                            <span class="text-xs font-mono font-medium">@vec.Score</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2 text-muted-foreground">
                <LucideIconCn Name="shield-check" Size="14" Class="size-3.5" />
                <span class="text-xs">Certified until Jan 2026</span>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    <LucideIconCn Name="share-2" Size="12" Class="size-3" />
                    Share Report
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    <LucideIconCn Name="download" Size="12" Class="size-3" />
                    Download Cert
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record VectorItem(string Name, string Status, int Score);

    private const string _auditId = "AUDIT-2025-Q4-SEC";
    private const int _score = 98;
    private const int _criticalRisks = 0;

    private static readonly VectorItem[] _vectors =
    [
        new("Network Infrastructure", "Clean", 100),
        new("Identity & Access",       "Clean",  96),
        new("Encryption Standards",    "Clean", 100),
    ];
}
