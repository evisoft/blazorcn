@* ============================================================
   Block: success-timeoff-approved
   Title: SuccessTimeoffApproved
   Description: An operational success state for employee time-off requests featuring calendar dates and OOO automation status, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-timeoff-approved.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-emerald-500/10 shrink-0">
                    <LucideIconCn Name="calendar-check-2" Size="20" Class="size-5 text-emerald-500" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Time-off request approved</h2>
                    <p class="mt-1 text-xs text-muted-foreground leading-snug">
                        Enjoy your break! Your request for Annual Leave has been approved by your manager
                        and added to the company calendar.
                    </p>
                </div>
            </div>
        </div>

        @* Schedule Details *@
        <div class="border-b px-4 py-5">
            <div class="mb-4 flex items-center gap-2">
                <LucideIconCn Name="palmtree" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Leave Summary
                </span>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-1">
                    <span class="text-[10px] text-muted-foreground uppercase">Dates</span>
                    <div class="flex items-center gap-2 text-xs font-medium">
                        <span>Nov 12</span>
                        <span class="text-muted-foreground">&#8594;</span>
                        <span>Nov 15, 2024</span>
                    </div>
                </div>
                <div class="space-y-1">
                    <span class="text-[10px] text-muted-foreground uppercase">Duration</span>
                    <div class="flex items-center gap-2 text-xs font-medium">
                        <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                        <span>4 Business Days (32 Hours)</span>
                    </div>
                </div>
            </div>
        </div>

        @* Automation Status *@
        <div class="border-b px-4 py-5">
            <div class="mb-4 flex items-center gap-2">
                <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Workflow Automations
                </span>
            </div>
            <div class="space-y-3">
                <div class="flex items-center justify-between rounded border bg-muted/30 px-3 py-2">
                    <div class="flex items-center gap-3">
                        <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10">
                            <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                        </div>
                        <span class="text-xs font-medium">Team Calendar Synced</span>
                    </div>
                    <div class="size-1.5 rounded-full bg-emerald-500"></div>
                </div>
                <div class="flex items-center justify-between rounded border bg-muted/30 px-3 py-2">
                    <div class="flex items-center gap-3">
                        <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10">
                            <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                        </div>
                        <span class="text-xs font-medium">OOO Auto-Reply Scheduled</span>
                    </div>
                    <div class="size-1.5 rounded-full bg-emerald-500"></div>
                </div>
                <div class="flex items-center justify-between rounded border bg-muted/30 px-3 py-2 opacity-60">
                    <div class="flex items-center gap-3">
                        <div class="flex size-6 items-center justify-center rounded-full bg-muted">
                            <LucideIconCn Name="message-square" Size="12" Class="size-3 text-muted-foreground" />
                        </div>
                        <span class="text-xs font-medium">Slack Status Update (Pending)</span>
                    </div>
                    <div class="size-1.5 rounded-full bg-muted-foreground/30"></div>
                </div>
            </div>
        </div>

        @* Footer Section *@
        <div class="bg-muted/50 px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-[11px] text-muted-foreground italic">
                    Remaining PTO Balance: 14.5 days
                </span>
                <div class="flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                        Edit Request
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                        View Calendar
                    </ButtonCn>
                </div>
            </div>
        </div>

    </div>
</section>
