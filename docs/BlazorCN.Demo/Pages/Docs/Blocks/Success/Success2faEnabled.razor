@* ============================================================
   Block: success-2fa-enabled
   Title: Success2faEnabled
   Description: A security-focused success block for two-factor authentication activation, featuring recovery codes display and management, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-2fa-enabled.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-emerald-500/10 shrink-0">
                    <LucideIconCn Name="shield-check" Size="20" Class="size-5 text-emerald-500" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Two-factor authentication enabled</h2>
                    <p class="mt-1 text-xs text-muted-foreground leading-snug">
                        Your account is now protected with an extra layer of security. Use your
                        authenticator app to log in.
                    </p>
                </div>
            </div>
        </div>

        @* Recovery Codes Section *@
        <div class="border-b px-4 py-5">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="smartphone" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Backup recovery codes
                    </span>
                </div>
                <div class="flex items-center gap-2">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7" OnClick="HandleCopy" aria-label="Confirm">
                        @if (_copied)
                        {
                            <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                        }
                        else
                        {
                            <LucideIconCn Name="copy" Size="14" Class="size-3.5" />
                        }
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7" aria-label="Download">
                        <LucideIconCn Name="download" Size="14" Class="size-3.5" />
                    </ButtonCn>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
                @foreach (var recoveryCode in _recoveryCodes)
                {
                    <div class="flex items-center justify-center rounded border bg-muted/50 px-2 py-1.5 font-mono text-[10px] tracking-tight text-muted-foreground">
                        @recoveryCode
                    </div>
                }
            </div>

            <p class="mt-4 text-[11px] text-amber-600 bg-amber-500/5 p-2 rounded border border-amber-500/10 text-center">
                Store these codes securely. They are the only way to recover your account if you lose
                your 2FA device.
            </p>
        </div>

        @* Device Info *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="size-1.5 rounded-full bg-emerald-500"></div>
                    <span class="text-[11px] text-muted-foreground font-medium uppercase tracking-wider">
                        Primary Method
                    </span>
                </div>
                <span class="text-[11px] text-muted-foreground">Authenticator App</span>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-3 flex justify-end bg-muted/50">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs px-6">
                Finished
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private bool _copied = false;

    private static readonly string[] _recoveryCodes =
    [
        "AAAA-BBBB-CCCC",
        "DDDD-EEEE-FFFF",
        "GGGG-HHHH-IIII",
        "JJJJ-KKKK-LLLL",
        "MMMM-NNNN-OOOO",
        "PPPP-QQQQ-RRRR",
    ];

    private async Task HandleCopy()
    {
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }
}
