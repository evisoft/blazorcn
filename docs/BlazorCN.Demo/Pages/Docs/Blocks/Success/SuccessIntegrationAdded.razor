@* ============================================================
   Block: success-integration-added
   Title: SuccessIntegrationAdded
   Description: A clean success block for third-party service connections (Slack, Discord, etc.), featuring connection status and quick settings, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-integration-added.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4 text-center sm:text-left">
            <div class="flex flex-col items-center gap-3 sm:flex-row">
                <div class="flex size-10 items-center justify-center rounded-full bg-[#4A154B]/10">
                    <LucideIconCn Name="slack" Size="20" Class="size-5 text-[#4A154B]" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Slack integration connected</h2>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Your workspace is now connected to the #product-alerts channel.
                    </p>
                </div>
            </div>
        </div>

        @* Connection Details *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2 mb-4">
                <LucideIconCn Name="link-2" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Integration Summary
                </span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="flex items-center justify-between p-3 rounded-md border bg-muted/30">
                    <div class="flex items-center gap-3">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded bg-background border">
                            <LucideIconCn Name="message-circle" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="space-y-0.5">
                            <p class="text-xs font-medium">Target Channel</p>
                            <p class="text-[10px] text-muted-foreground">#product-updates</p>
                        </div>
                    </div>
                    <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                </div>
                <div class="flex items-center justify-between p-3 rounded-md border bg-muted/30">
                    <div class="flex items-center gap-3">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded bg-background border">
                            <LucideIconCn Name="cpu" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="space-y-0.5">
                            <p class="text-xs font-medium">Automation</p>
                            <p class="text-[10px] text-muted-foreground">Active (5 triggers)</p>
                        </div>
                    </div>
                    <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                </div>
            </div>
        </div>

        @* Info Section *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-blue-500"></div>
                <p class="text-[11px] text-muted-foreground">
                    You can now configure which events trigger notifications in Slack.
                </p>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <p class="text-[10px] text-muted-foreground">App ID: #SLK-9902-EXT</p>
            <div class="flex gap-2">
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 text-xs gap-1.5">
                    <LucideIconCn Name="settings-2" Size="12" Class="size-3" />
                    Configure
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5">
                    Open Slack
                    <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>
