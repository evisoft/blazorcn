@* ============================================================
   Block: success-maintenance-completed
   Title: SuccessMaintenanceCompleted
   Description: React success block for system maintenance or downtime conclusion confirmation in Next.js, featuring system health metrics, service status, and uptime reports using shadcn/ui and Tailwind CSS.
   Source: original/blocks/success/success-maintenance-completed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b p-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                    </div>
                    <h1 class="font-medium text-sm">Maintenance completed</h1>
                </div>
                <span class="font-mono text-[10px] text-muted-foreground bg-muted px-1.5 py-0.5 rounded">
                    @_maintenanceId
                </span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                All systems have passed the post-maintenance health checks and are now serving
                traffic.
            </p>
        </div>

        @* Maintenance Stats *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Total Downtime
                    </span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-medium text-sm">@_duration</span>
                        <span class="text-[10px] font-medium text-muted-foreground uppercase">min</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Health Score
                    </span>
                    <div class="mt-1 flex items-center gap-1 text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="shield-check" Size="12" Class="size-3" />
                        <span class="font-medium text-xs">@_healthScore</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Active Services
                    </span>
                    <div class="mt-1 flex items-center gap-1">
                        <LucideIconCn Name="activity" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="font-medium text-xs">All Systems Live</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Last Heartbeat
                    </span>
                    <div class="mt-1 flex items-center gap-1">
                        <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="font-medium text-xs tabular-nums">Just now</span>
                    </div>
                </div>
            </div>
        </div>

        @* Service Grid *@
        <div class="border-b p-4">
            <div class="flex items-center gap-2 mb-3">
                <LucideIconCn Name="wrench" Size="14" Class="size-3.5 text-muted-foreground" />
                <h2 class="font-medium text-sm">Service health summary</h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                @foreach (var svc in _services)
                {
                    <div class="flex items-center justify-between rounded-md border bg-muted/20 px-3 py-2">
                        <div class="flex items-center gap-2">
                            <div class="size-1.5 rounded-full bg-emerald-500"></div>
                            <span class="text-xs font-medium">@svc.Name</span>
                        </div>
                        <span class="text-[10px] text-muted-foreground font-mono">@svc.Latency</span>
                    </div>
                }
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="file-text" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Incident report generated</span>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                    Status Page
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    View Post-Mortem
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record ServiceItem(string Name, string Status, string Latency);

    private const string _maintenanceId = "MNT-2025-1024";
    private const int _duration = 42;
    private const int _healthScore = 100;

    private static readonly ServiceItem[] _services =
    [
        new("API Gateway",  "Operational", "12ms"),
        new("Core Database","Operational", "4ms"),
        new("Edge Network", "Operational", "18ms"),
        new("Auth Service", "Operational", "8ms"),
    ];
}
