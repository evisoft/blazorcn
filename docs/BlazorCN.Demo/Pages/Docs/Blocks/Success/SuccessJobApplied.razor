@* ============================================================
   Block: success-job-applied
   Title: SuccessJobApplied
   Description: A professional success state for job applications featuring a hiring timeline and application details, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-job-applied.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-emerald-500/10 shrink-0">
                    <LucideIconCn Name="check-circle-2" Size="20" Class="size-5 text-emerald-500" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Application successfully submitted</h2>
                    <p class="mt-1 text-xs text-muted-foreground leading-snug">
                        Thank you for applying to the Senior Product Designer position. We've sent a
                        confirmation email to your inbox.
                    </p>
                </div>
            </div>
        </div>

        @* Application Details *@
        <div class="border-b px-4 py-5">
            <div class="mb-4 flex items-center gap-2">
                <LucideIconCn Name="briefcase" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Position Details
                </span>
            </div>
            <div class="grid gap-3 sm:grid-cols-2">
                <div class="flex items-center gap-2.5 rounded border bg-muted/30 px-3 py-2">
                    <LucideIconCn Name="map-pin" Size="14" Class="size-3.5 text-muted-foreground" />
                    <div class="flex flex-col">
                        <span class="text-[10px] text-muted-foreground">Location</span>
                        <span class="text-xs font-medium">Remote (Global)</span>
                    </div>
                </div>
                <div class="flex items-center gap-2.5 rounded border bg-muted/30 px-3 py-2">
                    <LucideIconCn Name="mail" Size="14" Class="size-3.5 text-muted-foreground" />
                    <div class="flex flex-col">
                        <span class="text-[10px] text-muted-foreground">Reference</span>
                        <span class="text-xs font-medium">#APP-8842-X</span>
                    </div>
                </div>
            </div>
        </div>

        @* Hiring Timeline *@
        <div class="border-b px-4 py-5">
            <div class="mb-6 flex items-center gap-2">
                <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Estimated Timeline
                </span>
            </div>
            <div class="relative space-y-6 before:absolute before:left-[7px] before:top-2 before:h-[calc(100%-16px)] before:w-px before:bg-border">
                @foreach (var step in _timeline)
                {
                    <div class="relative flex items-start gap-4 pl-6">
                        <div class="@Cn.Merge("absolute left-0 top-1.5 size-3.5 rounded-full border-2 bg-card transition-colors", GetDotClass(step.Status))">
                            @if (step.Status == "completed")
                            {
                                <LucideIconCn Name="check-circle-2" Size="12" Class="absolute -left-[1px] -top-[1px] size-3 text-white" />
                            }
                        </div>
                        <div class="flex flex-1 items-center justify-between">
                            <span class="@Cn.Merge("text-xs font-medium", step.Status == "upcoming" ? "text-muted-foreground" : "text-foreground")">
                                @step.Label
                            </span>
                            <span class="text-[10px] text-muted-foreground">@step.Date</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Next Steps Footer *@
        <div class="bg-muted/50 px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs text-muted-foreground">Applied on Oct 24, 2024</span>
                </div>
                <div class="flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                        View Portal
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                        Back to Careers
                    </ButtonCn>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private record TimelineStep(string Label, string Status, string Date);

    private static readonly TimelineStep[] _timeline =
    [
        new("Application Received", "completed", "Today"),
        new("Initial Screening", "pending", "Est. 3 days"),
        new("Technical Interview", "upcoming", "TBD"),
        new("Final Selection", "upcoming", "TBD"),
    ];

    private static string GetDotClass(string status) => status switch
    {
        "completed" => "border-emerald-500 bg-emerald-500",
        "pending"   => "border-emerald-500",
        _           => "border-muted",
    };
}
