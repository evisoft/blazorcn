@* ============================================================
   Block: success-webhook-tested
   Title: SuccessWebhookTested
   Description: React success block for webhook delivery testing confirmation in Next.js, featuring payload delivery status, response codes, and timing metrics using shadcn/ui and Tailwind CSS.
   Source: original/blocks/success/success-webhook-tested.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b p-4">
            <div class="flex items-center gap-2">
                <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                </div>
                <h1 class="font-medium text-sm">Webhook delivery successful</h1>
            </div>
            <p class="mt-1 text-muted-foreground text-xs truncate">
                <span class="font-mono text-foreground">POST</span> https://api.acme.com/v1/webhooks/receive
            </p>
        </div>

        @* Test Stats *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Status Code
                    </span>
                    <div class="mt-1 flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400">
                        <div class="size-1.5 rounded-full bg-current"></div>
                        <span class="font-medium text-sm">200 OK</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Response Time
                    </span>
                    <div class="mt-1 flex items-center gap-1">
                        <LucideIconCn Name="zap" Size="12" Class="size-3 text-amber-500" />
                        <span class="font-medium text-sm tabular-nums">420ms</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Delivery ID
                    </span>
                    <span class="mt-1 block font-mono text-[10px] text-foreground truncate">
                        wh_test_928374
                    </span>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Size
                    </span>
                    <span class="mt-1 block font-medium text-sm">1.2 KB</span>
                </div>
            </div>
        </div>

        @* Response Inspector *@
        <div class="border-b p-4">
            <div class="flex items-center justify-between mb-3">
                <h2 class="font-medium text-sm">Response body</h2>
                <button type="button" class="text-[10px] text-muted-foreground hover:text-foreground uppercase tracking-wider">
                    Copy JSON
                </button>
            </div>
            <div class="rounded-md border bg-black/[0.02] p-4 dark:bg-white/[0.02]">
                <pre class="font-mono text-[11px] text-foreground overflow-x-auto leading-relaxed">@_responseBodyJson</pre>
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="globe" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Target: Production Endpoint</span>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    <LucideIconCn Name="play" Size="12" Class="size-3 fill-current" />
                    Send Again
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-3 text-xs">
                    Save Changes
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private readonly string _responseBodyJson =
        "{\n  \"status\": \"success\",\n  \"message\": \"Event received\",\n  \"timestamp\": 1731548000\n}";
}
