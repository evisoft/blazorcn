@* ============================================================
   Block: success-goal-crushed
   Title: SuccessGoalCrushed
   Description: A high-energy success block for completing specific targets or sales goals, featuring a full progress bar animation and goal summary, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-goal-crushed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground shadow-sm">

        @* Goal Hero Section *@
        <div class="border-b px-4 py-8 bg-muted/30">
            <div class="flex flex-col items-center text-center space-y-4">
                <div class="flex size-12 items-center justify-center rounded-full bg-emerald-500/10 border border-emerald-500/20">
                    <LucideIconCn Name="flag" Size="24" Class="size-6 text-emerald-500" />
                </div>
                <div class="space-y-1">
                    <h2 class="text-sm font-medium">Monthly Goal Crushed!</h2>
                    <p class="text-xs text-muted-foreground">
                        You've reached your target of $50,000 in monthly recurring revenue 4 days ahead of
                        schedule.
                    </p>
                </div>

                @* Progress Bar *@
                <div class="w-full max-w-sm space-y-2">
                    <div class="flex items-center justify-between text-[10px] font-medium uppercase tracking-wider">
                        <span class="text-muted-foreground">Progress</span>
                        <span class="text-emerald-500">100% Complete</span>
                    </div>
                    <div class="h-2 w-full bg-muted rounded-full overflow-hidden">
                        <div class="h-full w-full bg-emerald-500" style="box-shadow:0 0 10px rgba(16,185,129,0.3)"></div>
                    </div>
                </div>
            </div>
        </div>

        @* Goal Summary Section *@
        <div class="border-b px-4 py-5">
            <div class="flex items-center gap-2 mb-4">
                <LucideIconCn Name="target" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Achievement Breakdown
                </span>
            </div>
            <div class="grid gap-3">
                @foreach (var achievement in _achievements)
                {
                    <div class="flex items-start gap-3 p-3 rounded-lg border bg-background group transition-colors hover:border-primary/50">
                        <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-primary/10 mt-0.5">
                            <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-primary" />
                        </div>
                        <div>
                            <p class="text-xs font-medium">@achievement.Title</p>
                            <p class="text-[10px] text-muted-foreground mt-0.5">@achievement.Detail</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Pro Tip / Next Action Section *@
        <div class="border-b px-4 py-3 bg-primary/5">
            <div class="flex items-center gap-2.5">
                <LucideIconCn Name="zap" Size="14" Class="size-3.5 text-primary fill-primary/20" />
                <p class="text-[11px] text-muted-foreground">
                    Ready for a challenge? Set a <span class="font-semibold text-primary">Stretch Goal</span> for the remaining
                    days of the month.
                </p>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <span class="text-[10px] text-muted-foreground">Goal reached on June 1, 2026</span>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5">
                Set Next Target
                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record AchievementItem(string Title, string Detail);

    private static readonly AchievementItem[] _achievements =
    [
        new("Q3 Revenue Target",        "Target: $150k • Actual: $154.2k"),
        new("New Customer Acquisition", "Target: 200 • Actual: 218"),
    ];
}
