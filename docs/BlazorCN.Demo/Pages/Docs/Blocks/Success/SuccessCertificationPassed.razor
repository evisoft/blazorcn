@* ============================================================
   Block: success-certification-passed
   Title: SuccessCertificationPassed
   Description: A professional success block for users who complete courses or pass certifications, featuring certificate details and a PDF download action, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-certification-passed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground shadow-sm">

        @* Certification Hero *@
        <div class="border-b px-4 py-10 text-center bg-muted/30">
            <div class="mx-auto flex size-20 items-center justify-center rounded-2xl bg-primary text-primary-foreground mb-6 shadow-xl shadow-primary/20">
                <LucideIconCn Name="graduation-cap" Size="40" Class="size-10" />
            </div>
            <div class="space-y-2">
                <h2 class="text-sm font-medium">Certification Passed</h2>
                <h3 class="text-xl font-bold">Advanced System Architecture</h3>
                <p class="text-xs text-muted-foreground mx-auto max-w-sm mt-2">
                    You've successfully completed the final assessment with a score of 98%. Your
                    credential has been added to your profile.
                </p>
            </div>
        </div>

        @* Certificate Details *@
        <div class="border-b px-4 py-5">
            <div class="flex items-center gap-2 mb-4">
                <LucideIconCn Name="file-check" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Credential Information
                </span>
            </div>
            <div class="grid gap-4 sm:grid-cols-3">
                @foreach (var detail in _certificateDetails)
                {
                    <div class="space-y-1.5">
                        <div class="flex items-center gap-1.5">
                            <LucideIconCn Name="@detail.IconName" Size="12" Class="size-3 text-muted-foreground" />
                            <p class="text-[10px] text-muted-foreground font-medium uppercase tracking-tight">
                                @detail.Label
                            </p>
                        </div>
                        <p class="text-xs font-semibold">@detail.Value</p>
                    </div>
                }
            </div>
        </div>

        @* Share & Verify Section *@
        <div class="border-b px-4 py-4 grid sm:grid-cols-2 gap-4">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-9 text-xs gap-2">
                <LucideIconCn Name="share-2" Size="14" Class="size-3.5" />
                Add to LinkedIn
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-9 text-xs gap-2">
                <LucideIconCn Name="external-link" Size="14" Class="size-3.5" />
                Verify Credential
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <p class="text-[10px] text-muted-foreground">
                Issued by <span class="font-semibold text-foreground">Acme Engineering Academy</span>
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5">
                <LucideIconCn Name="download" Size="12" Class="size-3" />
                Download PDF
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record CertificateDetail(string Label, string Value, string IconName);

    private static readonly CertificateDetail[] _certificateDetails =
    [
        new("Credential ID", "CERT-8291-XLK", "shield"),
        new("Date Issued",   "June 1, 2026",  "file-check"),
        new("Expires",       "Never",          "medal"),
    ];
}
