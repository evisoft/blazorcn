@* ============================================================
   Block: success-comment-posted
   Title: SuccessCommentPosted
   Description: A sleek success block for collaboration threads, confirming comment posting and participant notification, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-comment-posted.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4 text-center sm:text-left">
            <div class="flex flex-col items-center gap-3 sm:flex-row">
                <div class="flex size-10 items-center justify-center rounded-full bg-amber-500/10">
                    <LucideIconCn Name="message-square" Size="20" Class="size-5 text-amber-500" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Comment posted successfully</h2>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Your reply has been added to "Project Roadmap Discussion".
                    </p>
                </div>
            </div>
        </div>

        @* Notification Status *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2 mb-4">
                <LucideIconCn Name="bell" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Notifications dispatched
                </span>
            </div>
            <div class="space-y-3">
                <div class="flex items-center justify-between p-2 rounded-md border bg-muted/30">
                    <div class="flex items-center gap-3">
                        <div class="flex -space-x-2">
                            @foreach (var i in new[] { 1, 2, 3 })
                            {
                                <div class="size-6 rounded-full border bg-background flex items-center justify-center">
                                    <LucideIconCn Name="user" Size="12" Class="size-3 text-muted-foreground" />
                                </div>
                            }
                        </div>
                        <p class="text-xs font-medium">8 team members notified</p>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="user-check" Size="14" Class="size-3.5 text-emerald-500" />
                        <span class="text-[10px] font-medium">Received</span>
                    </div>
                </div>
            </div>
        </div>

        @* Info Section *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                <p class="text-[11px] text-muted-foreground">
                    You will be notified when someone replies to your comment.
                </p>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <p class="text-[10px] text-muted-foreground">Thread ID: #DISC-7721</p>
            <div class="flex gap-2">
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 text-xs gap-1.5">
                    <LucideIconCn Name="reply" Size="12" Class="size-3" />
                    Post Another
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Return to Discussion
                </ButtonCn>
            </div>
        </div>

    </div>
</section>
