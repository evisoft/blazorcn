@* ============================================================
   Block: success-ad-set-published
   Title: SuccessAdSetPublished
   Description: A marketing success block for advertising campaign activation, featuring targeting details and budget confirmation, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-ad-set-published.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground shadow-sm">

        @* Header Section *@
        <div class="border-b px-4 py-4">
            <div class="flex flex-col items-center gap-3 sm:flex-row">
                <div class="flex size-10 items-center justify-center rounded-full bg-muted">
                    <LucideIconCn Name="layers" Size="20" Class="size-5 text-foreground" />
                </div>
                <div class="flex-1 text-center sm:text-left">
                    <h2 class="text-sm font-medium">Ad Set "Q4-Retargeting" Published</h2>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Your advertising campaign is now active and being served to your audience.
                    </p>
                </div>
            </div>
        </div>

        @* Configuration Summary *@
        <div class="border-b px-4 py-4 grid grid-cols-1 sm:grid-cols-2 gap-4 bg-muted/10">
            <div class="space-y-3 p-3 rounded border bg-background shadow-sm">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="target" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Targeting Active
                    </span>
                </div>
                <div class="flex flex-wrap gap-1.5">
                    @foreach (var tag in _tags)
                    {
                        <span class="px-1.5 py-0.5 rounded border bg-muted/50 text-[10px] font-medium">
                            @tag
                        </span>
                    }
                </div>
            </div>
            <div class="space-y-3 p-3 rounded border bg-background shadow-sm">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="dollar-sign" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Daily Budget
                    </span>
                </div>
                <div class="flex items-baseline gap-1">
                    <span class="text-lg font-semibold">$250.00</span>
                    <span class="text-[10px] text-muted-foreground">USD / day</span>
                </div>
            </div>
        </div>

        @* Platform Status *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-emerald-500" />
                    <span class="text-xs font-medium">Optimization: Lowest Cost</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <div class="size-1.5 rounded-full bg-emerald-500"></div>
                    <span class="text-[10px] text-muted-foreground">Serving</span>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5 flex items-center justify-between bg-muted/50">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="mouse-pointer-click" Size="14" Class="size-3.5 text-muted-foreground" />
                <p class="text-[10px] text-muted-foreground">Tracking pixel active</p>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Manage Ad Set
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5">
                    Ad Manager
                    <LucideIconCn Name="zap" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private static readonly string[] _tags = ["US/CA", "Ages 25-45", "SaaS Interest"];
}
