@* ============================================================
   Block: success-storage-quota-expanded
   Title: SuccessStorageQuotaExpanded
   Description: React success block for cloud storage limit or disk quota increase confirmation in Next.js, featuring capacity metrics, utilization forecasts, and regional availability using shadcn/ui and Tailwind CSS.
   Source: original/blocks/success/success-storage-quota-expanded.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b p-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                    </div>
                    <h1 class="font-medium text-sm">Storage quota expanded</h1>
                </div>
                <div class="flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[10px] font-bold uppercase tracking-wider">
                    <LucideIconCn Name="zap" Size="10" Class="size-2.5" />
                    Active
                </div>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Your cloud storage limit has been increased to
                <span class="text-foreground font-medium">2.0 TB</span> across all global buckets.
            </p>
        </div>

        @* Storage Stats *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Total Capacity
                    </span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-medium text-sm">2</span>
                        <span class="text-[10px] font-medium text-muted-foreground uppercase">TB</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Utilization
                    </span>
                    <div class="mt-1 flex items-center gap-1">
                        <span class="font-medium text-xs">@_utilization%</span>
                        <div class="size-2 rounded-full bg-emerald-500"></div>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Days Headroom
                    </span>
                    <div class="mt-1 flex items-center gap-1">
                        <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="font-medium text-xs tabular-nums">@(_forecastDays)d</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Availability
                    </span>
                    <span class="mt-1 block font-medium text-[10px] uppercase">99.999%</span>
                </div>
            </div>
        </div>

        @* Usage Breakdown *@
        <div class="border-b p-4">
            <div class="flex items-center gap-2 mb-3">
                <LucideIconCn Name="hard-drive" Size="14" Class="size-3.5 text-muted-foreground" />
                <h2 class="font-medium text-sm">Resource allocation</h2>
            </div>
            <div class="space-y-4">
                <div class="flex items-center justify-between text-[11px]">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="database" Size="12" Class="size-3 text-muted-foreground" />
                        <span>Object Storage (S3)</span>
                    </div>
                    <span class="font-mono text-muted-foreground">1.5 TB allocated</span>
                </div>
                <div class="flex items-center justify-between text-[11px]">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="cloud-upload" Size="12" Class="size-3 text-muted-foreground" />
                        <span>Block Storage (EBS)</span>
                    </div>
                    <span class="font-mono text-muted-foreground">500 GB allocated</span>
                </div>
                <div class="pt-2">
                    <div class="h-2 w-full bg-muted rounded-full overflow-hidden flex">
                        <div class="h-full bg-foreground w-[75%]" title="Object Storage"></div>
                        <div class="h-full bg-muted-foreground/30 w-[25%]" title="Block Storage"></div>
                    </div>
                    <div class="mt-2 flex justify-between text-[10px] text-muted-foreground uppercase font-medium tracking-tighter">
                        <span>0 GB</span>
                        <span>2,000 GB</span>
                    </div>
                </div>
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2 text-muted-foreground">
                <LucideIconCn Name="settings-2" Size="14" Class="size-3.5" />
                <span class="text-xs">Propagating to us-east-1...</span>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 px-3 text-xs">
                    View Analytics
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-3 text-xs">
                    Optimize Storage
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private const int _previous = 500;
    private const int _current = 2000;
    private const int _used = 420;
    private const int _forecastDays = 180;
    private const string _region = "Multi-Region (Global)";

    private int _utilization => (int)Math.Round((_used / (double)_current) * 100);
}
