@* ============================================================
   Block: success-newsletter-scheduled
   Title: SuccessNewsletterScheduled
   Description: A marketing-focused success block for scheduled newsletters, featuring delivery time and audience details, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-newsletter-scheduled.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header *@
        <div class="border-b px-4 py-4">
            <div class="flex flex-col items-center gap-3 sm:flex-row">
                <div class="flex size-10 items-center justify-center rounded-full bg-muted">
                    <LucideIconCn Name="mail" Size="20" Class="size-5 text-foreground" />
                </div>
                <div class="flex-1 text-center sm:text-left">
                    <h2 class="text-sm font-medium">Newsletter Scheduled</h2>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Your "Weekly Product Update" is set to be delivered to your subscribers.
                    </p>
                </div>
            </div>
        </div>

        @* Schedule Details *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div class="flex items-center gap-3">
                    <div class="flex size-8 items-center justify-center rounded border bg-muted/50">
                        <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                    </div>
                    <div>
                        <p class="text-[10px] text-muted-foreground uppercase tracking-wider font-medium">
                            Delivery Date
                        </p>
                        <p class="text-xs font-medium">October 24, 2024</p>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <div class="flex size-8 items-center justify-center rounded border bg-muted/50">
                        <LucideIconCn Name="clock" Size="16" Class="size-4 text-muted-foreground" />
                    </div>
                    <div>
                        <p class="text-[10px] text-muted-foreground uppercase tracking-wider font-medium">
                            Release Time
                        </p>
                        <p class="text-xs font-medium">09:00 AM (UTC-5)</p>
                    </div>
                </div>
            </div>
        </div>

        @* Audience Segment *@
        <div class="border-b px-4 py-4 bg-muted/30">
            <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-xs font-medium">Audience Segment</span>
                </div>
                <span class="text-[10px] font-medium px-1.5 py-0.5 rounded border bg-background">
                    Active Users
                </span>
            </div>
            <div class="flex items-center gap-4">
                <div class="flex-1">
                    <div class="flex items-center justify-between text-[11px] mb-1">
                        <span class="text-muted-foreground">Total Recipients</span>
                        <span class="font-medium">12,480 users</span>
                    </div>
                    <div class="h-1 w-full bg-muted rounded-full overflow-hidden">
                        <div class="h-full w-full bg-foreground/20"></div>
                    </div>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8" aria-label="More options">
                    <LucideIconCn Name="more-horizontal" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-2.5 bg-muted/50">
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
                <p class="text-[10px] text-muted-foreground">Standing by for delivery</p>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Edit Campaign
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Go to Dashboard
                </ButtonCn>
            </div>
        </div>

    </div>
</section>
