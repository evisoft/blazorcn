@* ============================================================
   Block: success-opt-out-confirmed
   Title: SuccessOptOutConfirmed
   Description: A respectful and clear success screen for confirming email or notification opt-outs, featuring preference management links and re-subscribe options, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-opt-out-confirmed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground shadow-sm">

        @* Header Section *@
        <div class="border-b px-4 py-6 text-center">
            <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-muted">
                <LucideIconCn Name="bell-off" Size="24" Class="size-6 text-muted-foreground" />
            </div>
            <h2 class="text-sm font-medium">Unsubscribed Successfully</h2>
            <p class="mt-1 text-xs text-muted-foreground max-w-sm mx-auto">
                Your preferences have been updated. You will no longer receive marketing
                communications from this channel.
            </p>
        </div>

        @* Channel Details *@
        <div class="border-b px-4 py-5 bg-muted/20">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="flex size-9 items-center justify-center rounded-lg border bg-background">
                        <LucideIconCn Name="mail" Size="16" Class="size-4 text-muted-foreground" />
                    </div>
                    <div>
                        <p class="text-xs font-medium">Marketing Newsletter</p>
                        <p class="text-[10px] text-muted-foreground">channel: email</p>
                    </div>
                </div>
                <div class="rounded-full border bg-emerald-500/10 px-2.5 py-0.5">
                    <span class="text-[10px] font-medium text-emerald-600 uppercase">Updated</span>
                </div>
            </div>
        </div>

        @* Other Channels Info *@
        <div class="border-b px-4 py-5">
            <div class="mb-4 flex items-center justify-between">
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Your other active channels
                </span>
            </div>
            <div class="flex flex-wrap gap-2">
                <div class="flex items-center gap-2 rounded-md border px-3 py-1.5 bg-muted/30">
                    <LucideIconCn Name="smartphone" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] font-medium">Push Notifications</span>
                </div>
                <div class="flex items-center gap-2 rounded-md border px-3 py-1.5 bg-muted/30">
                    <LucideIconCn Name="inbox" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] font-medium">System Alerts</span>
                </div>
                <div class="flex items-center gap-2 rounded-md border px-3 py-1.5 bg-muted/30 opacity-50">
                    <LucideIconCn Name="settings" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] font-medium italic">Configure all...</span>
                </div>
            </div>
        </div>

        @* Propagation note *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 text-blue-500" />
                <p class="text-[11px] text-muted-foreground">
                    Please allow up to 24 hours for all systems to synchronize your request.
                </p>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-4 flex flex-col sm:flex-row items-center justify-between gap-4 bg-muted/50">
            <p class="text-[10px] text-muted-foreground text-center sm:text-left">
                Did you unsubscribe by mistake?
            </p>
            <div class="flex items-center gap-2 w-full sm:w-auto">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs flex-1 sm:flex-initial">
                    Re-subscribe
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs flex-1 sm:flex-initial gap-1.5">
                    <LucideIconCn Name="settings" Size="12" Class="size-3" />
                    Manage All Preferences
                </ButtonCn>
            </div>
        </div>

        @* Bottom verification *@
        <div class="px-4 py-2 border-t">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-500" />
                <p class="text-[10px] text-muted-foreground">Privacy settings synchronized</p>
            </div>
        </div>

    </div>
</section>
