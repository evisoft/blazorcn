@* ============================================================
   Block: success-role-updated
   Title: SuccessRoleUpdated
   Description: A security-focused success block for user role changes and permission elevations, featuring a summary of new access levels, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-role-updated.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4 text-center sm:text-left">
            <div class="flex flex-col items-center gap-3 sm:flex-row">
                <div class="flex size-10 items-center justify-center rounded-full bg-blue-500/10">
                    <LucideIconCn Name="shield-check" Size="20" Class="size-5 text-blue-500" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Role updated to "Organization Admin"</h2>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Your permissions have been elevated. You now have full access to workspace
                        settings.
                    </p>
                </div>
            </div>
        </div>

        @* Permissions Summary *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2 mb-4">
                <LucideIconCn Name="lock" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    New Access Levels
                </span>
            </div>
            <div class="grid gap-3">
                @foreach (var perm in _permissions)
                {
                    <div class="flex items-start gap-4 p-3 rounded-md border bg-muted/30">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded bg-background border">
                            <LucideIconCn Name="user-cog" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="flex-1 space-y-0.5">
                            <div class="flex items-center justify-between">
                                <p class="text-xs font-medium">@perm.Label</p>
                                <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                            </div>
                            <p class="text-[10px] text-muted-foreground">@perm.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Info Section *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-alert" Size="14" Class="size-3.5 text-amber-500" />
                <p class="text-[11px] text-muted-foreground">
                    Security Note: Some changes may take up to 2 minutes to propagate across all systems.
                </p>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <p class="text-[10px] text-muted-foreground">Updated by @@system-security</p>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5">
                Explore Dashboard
                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Permission(string Label, string Description, bool Allowed);

    private static readonly Permission[] _permissions =
    [
        new("User Management",    "Invite and manage team members",      true),
        new("Billing & Invoices", "View and update payment methods",     true),
        new("Production Access",  "Deploy changes to production",        true),
    ];
}
