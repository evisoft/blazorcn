@* ============================================================
   Block: success-expense-submitted
   Title: SuccessExpenseSubmitted
   Description: A financial operations success state for expense reports featuring receipt attachments and reimbursement tracking, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-expense-submitted.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-emerald-500/10 shrink-0">
                    <LucideIconCn Name="check-circle-2" Size="20" Class="size-5 text-emerald-500" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Expense report submitted</h2>
                    <p class="mt-1 text-xs text-muted-foreground leading-snug">
                        Report #EXP-2024-089 has been sent to Sarah Chen for approval. You'll be
                        notified once it's processed.
                    </p>
                </div>
            </div>
        </div>

        @* Claim Summary *@
        <div class="border-b px-4 py-5">
            <div class="mb-4 flex items-center gap-2">
                <LucideIconCn Name="wallet" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Claim Summary
                </span>
            </div>
            <div class="grid gap-3 sm:grid-cols-3">
                <div class="rounded border bg-muted/30 p-3">
                    <span class="text-[10px] text-muted-foreground uppercase">Total Amount</span>
                    <div class="mt-1 flex items-center gap-1.5 text-sm font-medium">
                        <LucideIconCn Name="indian-rupee" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span>1,240.50</span>
                    </div>
                </div>
                <div class="rounded border bg-muted/30 p-3">
                    <span class="text-[10px] text-muted-foreground uppercase">Category</span>
                    <div class="mt-1 flex items-center gap-1.5 text-sm font-medium">
                        <LucideIconCn Name="receipt" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span>Business Travel</span>
                    </div>
                </div>
                <div class="rounded border bg-muted/30 p-3">
                    <span class="text-[10px] text-muted-foreground uppercase">Status</span>
                    <div class="mt-1 flex items-center gap-2">
                        <div class="size-1.5 rounded-full bg-amber-500 animate-pulse"></div>
                        <span class="text-xs font-medium">Pending Review</span>
                    </div>
                </div>
            </div>
        </div>

        @* Attachments Section *@
        <div class="border-b px-4 py-5">
            <div class="mb-4 flex items-center gap-2">
                <LucideIconCn Name="paperclip" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Attached Receipts (2)
                </span>
            </div>
            <div class="space-y-2">
                @foreach (var file in _attachments)
                {
                    <div class="flex items-center justify-between rounded border px-3 py-2">
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="file-text" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="text-xs font-medium">@file.FileName</span>
                        </div>
                        <span class="text-[10px] text-muted-foreground">@file.FileSize</span>
                    </div>
                }
            </div>
        </div>

        @* Action Footer *@
        <div class="bg-muted/50 px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-[11px] text-muted-foreground">Submitted on Oct 24, 2:45 PM</span>
                <div class="flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                        Withdraw
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                        View History
                    </ButtonCn>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private record Attachment(string FileName, string FileSize);

    private static readonly Attachment[] _attachments =
    [
        new("uber_receipt_oct24.pdf", "1.2 MB"),
        new("hotel_invoice_final.jpg", "2.4 MB"),
    ];
}
