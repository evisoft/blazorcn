@* ============================================================
   Block: success-dns-record-active
   Title: SuccessDnsRecordActive
   Description: A domain management success block for DNS record creation, featuring record types, TTL settings, and propagation status, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-dns-record-active.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-blue-500/10">
                    <LucideIconCn Name="globe" Size="20" Class="size-5 text-blue-500" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">DNS Record Active</h2>
                    <p class="text-xs text-muted-foreground">
                        New CNAME record added for api.shadcn.io successfully.
                    </p>
                </div>
            </div>
        </div>

        @* Record Details *@
        <div class="border-b px-4 py-4 space-y-4">
            <div class="flex items-center justify-between p-3 rounded-md border bg-muted/30 font-mono text-xs">
                <div class="flex flex-col gap-1">
                    <span class="text-[10px] uppercase text-muted-foreground font-sans">Type</span>
                    <span class="font-bold text-blue-500">CNAME</span>
                </div>
                <div class="flex flex-col gap-1">
                    <span class="text-[10px] uppercase text-muted-foreground font-sans">Host</span>
                    <span>api</span>
                </div>
                <div class="flex flex-col gap-1 overflow-hidden">
                    <span class="text-[10px] uppercase text-muted-foreground font-sans">Value</span>
                    <span class="truncate">alias.zeit.co</span>
                </div>
                <div class="flex flex-col gap-1">
                    <span class="text-[10px] uppercase text-muted-foreground font-sans">TTL</span>
                    <span>3600</span>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div class="flex items-center gap-2 p-2 rounded-md border bg-muted/10">
                    <LucideIconCn Name="hash" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-[11px] font-medium">ID: dns_9a2f1b</span>
                </div>
                <div class="flex items-center gap-2 p-2 rounded-md border bg-muted/10">
                    <LucideIconCn Name="zap" Size="14" Class="size-3.5 text-orange-500" />
                    <span class="text-[11px] font-medium">Proxy: Active</span>
                </div>
            </div>
        </div>

        @* Propagation Status *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="refresh-ccw" Size="14" Class="size-3.5 text-blue-500 animate-spin-slow" />
                    <span class="text-[11px] font-medium">Global Propagation: 85%</span>
                </div>
                <div class="flex gap-1">
                    <div class="size-1.5 rounded-full bg-emerald-500"></div>
                    <div class="size-1.5 rounded-full bg-emerald-500"></div>
                    <div class="size-1.5 rounded-full bg-emerald-500"></div>
                    <div class="size-1.5 rounded-full bg-emerald-500"></div>
                    <div class="size-1.5 rounded-full bg-muted-foreground/30"></div>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3 bg-muted/50">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                <p class="text-[10px] text-muted-foreground">Record is live</p>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Check Status
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Manage DNS
                </ButtonCn>
            </div>
        </div>

    </div>
</section>
