@* ============================================================
   Block: success-support-resolved
   Title: SuccessSupportResolved
   Description: A clean and professional success block for confirming the resolution of a support ticket, featuring a satisfaction rating prompt and archival information, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-support-resolved.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground shadow-sm">

        @* Header Section *@
        <div class="border-b px-4 py-6 text-center">
            <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-emerald-500/10">
                <LucideIconCn Name="check-circle-2" Size="24" Class="size-6 text-emerald-500" />
            </div>
            <h2 class="text-sm font-medium">Ticket Successfully Resolved</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Your request #TK-84291 has been marked as resolved. We hope we were able to help!
            </p>
        </div>

        @* Resolution Summary *@
        <div class="border-b px-4 py-5 bg-muted/20">
            <div class="flex items-start gap-4">
                <div class="flex size-8 shrink-0 items-center justify-center rounded-lg border bg-background">
                    <LucideIconCn Name="life-buoy" Size="16" Class="size-4 text-muted-foreground" />
                </div>
                <div class="space-y-1">
                    <p class="text-sm font-medium leading-none">Resolution Summary</p>
                    <p class="text-xs text-muted-foreground leading-relaxed">
                        "The API authentication issue was caused by an expired token. We've updated your
                        account permissions and verified the connection."
                    </p>
                </div>
            </div>
        </div>

        @* Feedback Section *@
        <div class="border-b px-4 py-5 text-center">
            <p class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground mb-4">
                How was your support experience?
            </p>
            <div class="flex justify-center gap-2">
                @foreach (var star in new[] { 1, 2, 3, 4, 5 })
                {
                    var s = star;
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="size-10 rounded-full hover:border-primary hover:text-primary transition-all" @onclick="@(() => SetRating(s))">
                        <LucideIconCn Name="star" Size="16" Class="size-4" />
                    </ButtonCn>
                }
            </div>
            <p class="mt-3 text-[10px] text-muted-foreground">
                Click a star to submit your rating
            </p>
        </div>

        @* Info Banner *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center justify-center gap-2">
                <LucideIconCn Name="archive" Size="14" Class="size-3.5 text-muted-foreground" />
                <p class="text-[11px] text-muted-foreground">
                    This conversation will be archived in 24 hours.
                </p>
            </div>
        </div>

        @* Footer Actions *@
        <div class="px-4 py-3 flex flex-col sm:flex-row items-center justify-between gap-3 bg-muted/50">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="message-square" Size="14" Class="size-3.5 text-muted-foreground" />
                <p class="text-[10px] text-muted-foreground">Still need help?</p>
            </div>
            <div class="flex gap-2 w-full sm:w-auto">
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-8 text-xs flex-1 sm:flex-initial gap-1.5">
                    <LucideIconCn Name="rotate-ccw" Size="12" Class="size-3" />
                    Reopen Ticket
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 text-xs flex-1 sm:flex-initial">
                    View All Tickets
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private int _rating = 0;

    private void SetRating(int value)
    {
        _rating = value;
    }
}
