@* ============================================================
   Block: success-feature-flag-enabled
   Title: SuccessFeatureFlagEnabled
   Description: A feature flag enabled success block for React and Next.js with rollout percentage, environment details, affected users count, and action buttons built with shadcn/ui and Tailwind CSS
   Source: original/blocks/success/success-feature-flag-enabled.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Success icon header *@
        <div class="flex items-center gap-3 border-b px-4 py-4">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                <LucideIconCn Name="check-circle-2" Size="20" Class="size-5 text-emerald-600 dark:text-emerald-400" />
            </span>
            <div class="min-w-0 flex-1">
                <h2 class="text-sm font-medium">Feature flag enabled</h2>
                <p class="mt-0.5 text-xs text-muted-foreground">@_flagDetails.EnabledAt</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 bg-emerald-500/10 text-emerald-700 hover:bg-emerald-500/10 dark:text-emerald-300">
                Active
            </BadgeCn>
        </div>

        @* Flag details *@
        <div class="space-y-4 border-b px-4 py-4">
            <div>
                <span class="text-sm font-medium">@_flagDetails.Name</span>
                <p class="mt-0.5 font-mono text-xs text-muted-foreground">@_flagDetails.Key</p>
            </div>

            <div class="flex items-center gap-4">
                <div class="flex items-center gap-2">
                    <span class="text-xs text-muted-foreground">Environment</span>
                    <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs font-normal">
                        @_flagDetails.Environment
                    </BadgeCn>
                </div>
            </div>
        </div>

        @* Rollout percentage *@
        <div class="border-b px-4 py-4">
            <div class="mb-3 flex items-end justify-between">
                <span class="text-xs font-medium text-muted-foreground">Rollout percentage</span>
                <span class="text-2xl font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">
                    @(_flagDetails.RolloutPercentage)%
                </span>
            </div>
            <ProgressCn Value="@((double)_flagDetails.RolloutPercentage)" Class="h-1.5" />
        </div>

        @* Affected users *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <span class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                    <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                </span>
                <div class="min-w-0 flex-1">
                    <span class="text-sm font-medium">Affected users</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Currently receiving the new feature
                    </p>
                </div>
                <span class="shrink-0 text-lg font-semibold tabular-nums">
                    @(_flagDetails.AffectedUsers.ToString("N0"))
                </span>
            </div>
        </div>

        @* Action buttons *@
        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 flex-1 gap-1.5 text-xs" OnClick="HandleViewAnalytics">
                <LucideIconCn Name="bar-chart-3" Size="14" Class="size-3.5" />
                View analytics
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 flex-1 text-xs" OnClick="HandleRollback">
                Rollback flag
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record FlagDetails(
        string Name,
        string Key,
        string Environment,
        int RolloutPercentage,
        int AffectedUsers,
        string EnabledAt
    );

    private static readonly FlagDetails _flagDetails = new(
        Name: "Enhanced Search Algorithm",
        Key: "enhanced-search-v2",
        Environment: "Production",
        RolloutPercentage: 25,
        AffectedUsers: 1247,
        EnabledAt: "2 minutes ago"
    );

    private void HandleViewAnalytics() { }
    private void HandleRollback() { }
}
