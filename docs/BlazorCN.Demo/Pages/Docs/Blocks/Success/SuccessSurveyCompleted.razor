@* ============================================================
   Block: success-survey-completed
   Title: SuccessSurveyCompleted
   Description: A grateful success block for confirming survey and NPS score submissions, featuring reward indicators and feedback appreciation, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-survey-completed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground shadow-sm">

        @* Celebration Header *@
        <div class="border-b px-4 py-8 text-center bg-muted/20">
            <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-emerald-500/10 ring-8 ring-emerald-500/5">
                <LucideIconCn Name="thumbs-up" Size="24" Class="size-6 text-emerald-500" />
            </div>
            <h2 class="text-sm font-medium">Thank you for your feedback!</h2>
            <p class="mt-1 text-xs text-muted-foreground max-w-xs mx-auto">
                Your insights are invaluable. We've recorded your responses and will use them to
                improve your experience.
            </p>
        </div>

        @* NPS Score Display *@
        <div class="border-b px-4 py-5 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="flex size-9 items-center justify-center rounded-lg border bg-background font-bold text-sm">
                    10
                </div>
                <div>
                    <p class="text-xs font-medium">NPS Score Submitted</p>
                    <p class="text-[10px] text-muted-foreground">Likelihood to recommend</p>
                </div>
            </div>
            <div class="flex -space-x-1">
                @foreach (var i in _stars)
                {
                    <LucideIconCn Name="star" Size="12" Class="size-3 text-emerald-500 fill-emerald-500" />
                }
            </div>
        </div>

        @* Reward Section (Optional) *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-4 rounded-md border border-dashed border-primary/30 bg-primary/5 p-4">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-primary/10">
                    <LucideIconCn Name="gift" Size="20" Class="size-5 text-primary" />
                </div>
                <div class="flex-1">
                    <p class="text-xs font-medium text-primary">A small token of our appreciation</p>
                    <p class="text-[11px] text-muted-foreground mt-0.5">
                        Use code <span class="font-mono font-bold text-foreground">FEEDBACK20</span> for
                        20% off your next month.
                    </p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-[10px]">
                    Copy Code
                </ButtonCn>
            </div>
        </div>

        @* Quote/Impact Section *@
        <div class="border-b px-4 py-4 bg-muted/10">
            <div class="flex gap-3">
                <LucideIconCn Name="quote" Size="16" Class="size-4 text-muted-foreground shrink-0 mt-1" />
                <p class="text-[11px] text-muted-foreground leading-relaxed italic">
                    "We take user feedback seriously. Over 40% of our new features in the last quarter
                    were directly inspired by survey responses like yours."
                    <span class="block mt-2 font-medium not-italic">— Product Team @@ shadcn/io</span>
                </p>
            </div>
        </div>

        @* Footer Actions *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="heart" Size="12" Class="size-3 text-red-500" />
                <p class="text-[10px] text-muted-foreground">Contribution logged to your profile</p>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Back to Home
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5">
                    View Roadmap
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private static readonly int[] _stars = [1, 2, 3, 4, 5];
}
