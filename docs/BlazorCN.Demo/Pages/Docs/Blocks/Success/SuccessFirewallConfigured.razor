@* ============================================================
   Block: success-firewall-configured
   Title: SuccessFirewallConfigured
   Description: A network security success block for firewall rule application, featuring active rules, security status, and protocol details, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-firewall-configured.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-red-500/10">
                    <LucideIconCn Name="shield-alert" Size="20" Class="size-5 text-red-500" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Firewall Rules Applied</h2>
                    <p class="text-xs text-muted-foreground">
                        Infrastructure hardened. 4 new inbound rules are now active.
                    </p>
                </div>
            </div>
        </div>

        @* Active Rules List *@
        <div class="border-b px-4 py-4 space-y-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="list" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Recent Rule Updates
                </span>
            </div>
            <div class="space-y-2">
                @foreach (var rule in _rules)
                {
                    <div class="flex items-center justify-between p-2 rounded-md border bg-muted/30 text-xs font-mono">
                        <div class="flex items-center gap-3">
                            <span class="text-emerald-500 font-bold">@rule.Access</span>
                            <span class="text-muted-foreground">@rule.Protocol</span>
                            <span>Port @rule.Port</span>
                        </div>
                        <span class="text-muted-foreground">@rule.Source</span>
                    </div>
                }
            </div>
        </div>

        @* Security Status *@
        <div class="border-b px-4 py-3 bg-muted/30 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield" Size="14" Class="size-3.5 text-emerald-500" />
                <span class="text-[11px] font-medium">Policy Integrity: Verified</span>
            </div>
            <div class="flex items-center gap-2">
                <LucideIconCn Name="lock" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[11px] text-muted-foreground font-medium">Deny-all Fallback</span>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3 bg-muted/50">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                <p class="text-[10px] text-muted-foreground">Deployed to 12 instances</p>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    View Logs
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Edit Policy
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record FirewallRule(string Port, string Protocol, string Access, string Source);

    private static readonly FirewallRule[] _rules =
    [
        new("443", "TCP", "Allow", "Anywhere"),
        new("80",  "TCP", "Allow", "Anywhere"),
        new("22",  "TCP", "Allow", "192.168.1.1/32"),
    ];
}
