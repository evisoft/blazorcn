@* ============================================================
   Block: success-deployment-live
   Title: SuccessDeploymentLive
   Description: A Vercel-style deployment summary block that confirms a successful production push with live URL and branch details, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-deployment-live.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4">
            <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-between">
                <div class="flex items-center gap-3">
                    <div class="flex size-10 items-center justify-center rounded-full bg-emerald-500/10">
                        <LucideIconCn Name="rocket" Size="20" Class="size-5 text-emerald-500" />
                    </div>
                    <div>
                        <h2 class="text-sm font-medium">Deployment Successful</h2>
                        <p class="text-xs text-muted-foreground">
                            Your project is now live and accessible to users.
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-1.5 rounded-full border bg-muted/50 px-2.5 py-0.5">
                    <div class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
                    <span class="text-[10px] font-medium uppercase tracking-wider">Production</span>
                </div>
            </div>
        </div>

        @* Live URL Section *@
        <div class="border-b bg-muted/30 px-4 py-4">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex items-center gap-2 overflow-hidden">
                    <LucideIconCn Name="globe" Size="14" Class="size-3.5 text-muted-foreground shrink-0" />
                    <span class="text-xs font-mono truncate">shadcnio-app-v2-zeta.vercel.app</span>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5 shrink-0">
                    Visit Site
                    <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

        @* Metadata Grid *@
        <div class="border-b px-4 py-4">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
                <div class="space-y-1.5">
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Source
                    </span>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="git-branch" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium">main</span>
                    </div>
                </div>
                <div class="space-y-1.5">
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Build Time
                    </span>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="zap" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium">42s</span>
                    </div>
                </div>
                <div class="space-y-1.5 col-span-2 sm:col-span-1">
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Checks
                    </span>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                        <span class="text-xs font-medium">All Passed</span>
                    </div>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3 bg-muted/50">
            <p class="text-[10px] text-muted-foreground">Deployed by @@shadcn 1 minute ago</p>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Inspect
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    View Logs
                </ButtonCn>
            </div>
        </div>

    </div>
</section>
