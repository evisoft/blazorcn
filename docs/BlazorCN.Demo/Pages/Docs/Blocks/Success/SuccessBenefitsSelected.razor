@* ============================================================
   Block: success-benefits-selected
   Title: SuccessBenefitsSelected
   Description: An HR operations success state for employee benefits enrollment featuring plan summaries and coverage timelines, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-benefits-selected.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-emerald-500/10 shrink-0">
                    <LucideIconCn Name="heart" Size="20" Class="size-5 text-emerald-500" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Benefits enrollment complete</h2>
                    <p class="mt-1 text-xs text-muted-foreground leading-snug">
                        Your selections for the 2024-2025 plan year have been recorded. A summary has been
                        sent to your company email.
                    </p>
                </div>
            </div>
        </div>

        @* Coverage Start Date *@
        <div class="border-b px-4 py-5 bg-muted/20">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="size-1.5 rounded-full bg-emerald-500"></div>
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Coverage Start Date
                    </span>
                </div>
                <span class="text-sm font-medium">January 1, 2025</span>
            </div>
        </div>

        @* Selected Plans Grid *@
        <div class="border-b px-4 py-5">
            <div class="mb-4 flex items-center gap-2">
                <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Enrollment Summary
                </span>
            </div>
            <div class="space-y-2">
                @foreach (var plan in _plans)
                {
                    <div class="flex items-center justify-between rounded border px-3 py-2.5">
                        <div class="flex items-center gap-3">
                            <LucideIconCn Name="@plan.IconName" Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-xs font-medium">@plan.Name</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-500" />
                            <span class="text-[10px] text-muted-foreground font-medium">
                                @plan.Status
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Beneficiary Info *@
        <div class="border-b px-4 py-5">
            <div class="flex items-center gap-2 mb-3">
                <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Covered Dependents
                </span>
            </div>
            <div class="flex flex-wrap gap-2">
                @foreach (var tag in _dependentTags)
                {
                    <span class="rounded-full bg-muted border px-2.5 py-0.5 text-[10px] font-medium text-muted-foreground">
                        @tag
                    </span>
                }
            </div>
        </div>

        @* Action Footer *@
        <div class="bg-muted/50 px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-[11px] text-muted-foreground italic">
                    Confirmation ID: #BEN-229-X
                </span>
                <div class="flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                        Edit Beneficiaries
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                        Download Summary
                    </ButtonCn>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private record PlanItem(string Name, string IconName, string Status);

    private static readonly PlanItem[] _plans =
    [
        new("Medical Premium PPO",       "stethoscope", "Enrolled"),
        new("Vision & Dental Plus",      "activity",    "Enrolled"),
        new("Group Life Insurance (2x)", "umbrella",    "Active"),
    ];

    private static readonly string[] _dependentTags = ["Primary Member", "Spouse", "2 Dependents"];
}
