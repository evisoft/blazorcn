@* ============================================================
   Block: success-onboarding-complete
   Title: SuccessOnboardingComplete
   Description: A celebratory success block for reaching 100% onboarding completion, featuring a confetti burst and next steps, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-onboarding-complete.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Hero Section *@
        <div class="border-b px-4 py-8 text-center bg-muted/30">
            <div class="mx-auto flex size-16 items-center justify-center rounded-full bg-primary/10 mb-4">
                <LucideIconCn Name="trophy" Size="32" Class="size-8 text-primary" />
            </div>
            <h2 class="text-sm font-medium">Onboarding 100% Complete</h2>
            <p class="mt-2 text-xs text-muted-foreground">
                Congratulations! You've successfully completed all the steps to get your workspace up
                and running. You're ready to start building.
            </p>
            <div class="mt-6 mx-auto max-w-[240px]">
                <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                    <div class="h-full w-full bg-primary"></div>
                </div>
            </div>
        </div>

        @* Recap Section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2 mb-4">
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    What you've achieved
                </span>
            </div>
            <div class="grid gap-3">
                @foreach (var step in _completedSteps)
                {
                    <div class="flex items-center gap-3">
                        <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                            <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                        </div>
                        <div>
                            <p class="text-xs font-medium">@step.Title</p>
                            <p class="text-[11px] text-muted-foreground">@step.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Feature Suggestion Section *@
        <div class="border-b px-4 py-4 grid sm:grid-cols-2 gap-4">
            <div class="flex items-start gap-3 p-3 rounded-lg border bg-muted/20">
                <LucideIconCn Name="rocket" Size="16" Class="size-4 text-muted-foreground mt-0.5" />
                <div>
                    <p class="text-xs font-medium">Launch Project</p>
                    <p class="text-[10px] text-muted-foreground mt-0.5">
                        Start your first production deployment.
                    </p>
                </div>
            </div>
            <div class="flex items-start gap-3 p-3 rounded-lg border bg-muted/20">
                <LucideIconCn Name="star" Size="16" Class="size-4 text-muted-foreground mt-0.5" />
                <div>
                    <p class="text-xs font-medium">Explore Pro</p>
                    <p class="text-[10px] text-muted-foreground mt-0.5">
                        Unlock advanced analytics and scale.
                    </p>
                </div>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <div class="flex items-center gap-2 text-[10px] text-muted-foreground">
                <LucideIconCn Name="party-popper" Size="12" Class="size-3" />
                <span>Well done, Alex!</span>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5">
                Enter Dashboard
                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record CompletedStep(string Title, string Description);

    private static readonly CompletedStep[] _completedSteps =
    [
        new("Account setup",         "Email verified and profile created"),
        new("Workspace initialized", "Team invited and roles assigned"),
        new("First integration",     "External data sources connected"),
    ];
}
