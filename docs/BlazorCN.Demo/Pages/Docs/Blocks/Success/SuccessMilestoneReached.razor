@* ============================================================
   Block: success-milestone-reached
   Title: SuccessMilestoneReached
   Description: A reward-focused success block for celebrating key performance milestones and metric achievements, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-milestone-reached.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Milestone Header *@
        <div class="border-b px-4 py-10 flex flex-col items-center text-center">
            <div class="relative mb-6">
                <div class="absolute inset-0 blur-2xl bg-amber-500/20 rounded-full"></div>
                <div class="relative flex size-20 items-center justify-center rounded-full border-4 border-amber-500/20 bg-amber-500/10">
                    <LucideIconCn Name="award" Size="40" Class="size-10 text-amber-500" />
                </div>
                <div class="absolute -bottom-1 -right-1 flex size-7 items-center justify-center rounded-full border-2 border-background bg-emerald-500">
                    <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-white" />
                </div>
            </div>

            <div class="space-y-2">
                <h2 class="text-sm font-medium">Milestone Reached: 10k Active Users</h2>
                <p class="text-xs text-muted-foreground mx-auto max-w-sm">
                    Your application has officially crossed the 10,000 active user mark. This puts you
                    in the top 5% of growing workspaces this month.
                </p>
            </div>
        </div>

        @* Stats Summary *@
        <div class="border-b p-4">
            <div class="flex items-center gap-2 mb-4">
                <LucideIconCn Name="bar-chart-3" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Performance Highlights
                </span>
            </div>
            <div class="grid gap-4">
                <div class="flex items-center justify-between group cursor-pointer">
                    <div class="flex items-center gap-3">
                        <div class="size-1.5 rounded-full bg-emerald-500"></div>
                        <p class="text-xs">Growth Rate</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-medium text-emerald-500">+12.4%</span>
                        <LucideIconCn Name="chevron-right" Size="12" Class="size-3 text-muted-foreground group-hover:translate-x-0.5 transition-transform" />
                    </div>
                </div>
                <div class="flex items-center justify-between group cursor-pointer">
                    <div class="flex items-center gap-3">
                        <div class="size-1.5 rounded-full bg-blue-500"></div>
                        <p class="text-xs">Retention</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-medium">68.2%</span>
                        <LucideIconCn Name="chevron-right" Size="12" Class="size-3 text-muted-foreground group-hover:translate-x-0.5 transition-transform" />
                    </div>
                </div>
                <div class="flex items-center justify-between group cursor-pointer">
                    <div class="flex items-center gap-3">
                        <div class="size-1.5 rounded-full bg-purple-500"></div>
                        <p class="text-xs">Avg. Session</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-medium">4m 32s</span>
                        <LucideIconCn Name="chevron-right" Size="12" Class="size-3 text-muted-foreground group-hover:translate-x-0.5 transition-transform" />
                    </div>
                </div>
            </div>
        </div>

        @* Action Link *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center justify-between gap-4">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="target" Size="14" Class="size-3.5 text-primary" />
                    <p class="text-[11px] font-medium">Next Target: 25k Users</p>
                </div>
                <div class="h-1 flex-1 bg-muted rounded-full overflow-hidden">
                    <div class="h-full w-[40%] bg-primary"></div>
                </div>
                <span class="text-[10px] text-muted-foreground">40%</span>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5 hover:bg-background">
                <LucideIconCn Name="share-2" Size="12" Class="size-3" />
                Share Achievement
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                View Analytics
            </ButtonCn>
        </div>

    </div>
</section>
