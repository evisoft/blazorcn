@* ============================================================
   Block: success-feedback-received
   Title: SuccessFeedbackReceived
   Description: A modern success block for confirming feature request submissions, showcasing the product roadmap and internal review process, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-feedback-received.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground shadow-sm">

        @* Header Section *@
        <div class="border-b px-4 py-6 text-center">
            <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-amber-500/10">
                <LucideIconCn Name="lightbulb" Size="24" Class="size-6 text-amber-500" />
            </div>
            <h2 class="text-sm font-medium">Feedback Logged Successfully</h2>
            <p class="mt-1 text-xs text-muted-foreground max-w-sm mx-auto">
                Thank you for helping us shape the future of our platform. Your request has been added
                to our queue for review.
            </p>
        </div>

        @* Process Section *@
        <div class="border-b px-4 py-5">
            <div class="mb-4">
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    What happens next?
                </span>
            </div>
            <div class="space-y-4">
                @foreach (var step in _reviewSteps)
                {
                    <div class="flex items-start gap-4">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-lg border bg-muted/50">
                            <LucideIconCn Name="@step.Icon" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div>
                            <p class="text-xs font-medium leading-none mb-1">@step.Title</p>
                            <p class="text-[11px] text-muted-foreground leading-normal">
                                @step.Description
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Roadmap Promo Section *@
        <div class="border-b px-4 py-4 bg-muted/30">
            <div class="flex items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <div class="flex size-8 items-center justify-center rounded-md bg-background border shadow-sm">
                        <LucideIconCn Name="map" Size="16" Class="size-4 text-primary" />
                    </div>
                    <div>
                        <p class="text-xs font-medium">Public Roadmap</p>
                        <p class="text-[10px] text-muted-foreground">See what we're building next</p>
                    </div>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-[11px] px-3">
                    View Roadmap
                </ButtonCn>
            </div>
        </div>

        @* Footer Info *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="zap" Size="12" Class="size-3 text-amber-500" />
                <p class="text-[10px] text-muted-foreground">
                    You'll be notified if this moves to 'In Progress'
                </p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-500" />
                <span class="text-[10px] font-medium">Logged</span>
            </div>
        </div>

    </div>
</section>

@code {
    private record ReviewStep(string Title, string Description, string Icon);

    private static readonly ReviewStep[] _reviewSteps =
    [
        new("Triaging", "Our product team reviews every submission for feasibility and alignment.", "search"),
        new("Community Signal", "We group similar requests to identify high-impact opportunities.", "users"),
        new("Prioritization", "Top requests move into our active development cycle based on demand.", "bar-chart-3"),
    ];
}
