@* ============================================================
   Block: success-first-project
   Title: SuccessFirstProject
   Description: A significant milestone block for users who have just created their first project, featuring project details and quick-start commands, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-first-project.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Project Hero *@
        <div class="border-b px-4 py-8 text-center sm:text-left">
            <div class="flex flex-col items-center gap-4 sm:flex-row">
                <div class="flex size-12 items-center justify-center rounded-xl bg-primary/10 border border-primary/20">
                    <LucideIconCn Name="box" Size="24" Class="size-6 text-primary" />
                </div>
                <div>
                    <div class="flex items-center justify-center gap-2 sm:justify-start">
                        <h2 class="text-sm font-medium">Project Created: "Acme Cloud"</h2>
                        <div class="flex items-center gap-1 rounded-full bg-emerald-500/10 px-1.5 py-0.5 border border-emerald-500/20">
                            <div class="size-1 rounded-full bg-emerald-500"></div>
                            <span class="text-[10px] font-medium text-emerald-600 uppercase">Active</span>
                        </div>
                    </div>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Your workspace environment is now provisioned and ready for deployment.
                    </p>
                </div>
            </div>
        </div>

        @* Config Summary *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2 mb-4">
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Configuration Summary
                </span>
            </div>
            <div class="grid gap-4 sm:grid-cols-3">
                @foreach (var item in _projectConfig)
                {
                    <div class="flex flex-col gap-1.5 p-3 rounded-lg border bg-muted/20">
                        <LucideIconCn Name="@item.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
                        <p class="text-[10px] text-muted-foreground font-medium uppercase tracking-tight">
                            @item.Label
                        </p>
                        <p class="text-xs font-semibold truncate">@item.Value</p>
                    </div>
                }
            </div>
        </div>

        @* Quick Start Commands *@
        <div class="border-b px-4 py-4 bg-muted/30">
            <div class="flex items-center gap-2 mb-3">
                <LucideIconCn Name="terminal" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Quick Start
                </span>
            </div>
            <div class="rounded-md bg-zinc-950 p-3 font-mono text-[11px] text-zinc-300 border border-zinc-800">
                <div class="flex items-center justify-between mb-1 opacity-50">
                    <span># Install dependencies and start dev server</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-zinc-500 select-none">$</span>
                    <span>bun install &amp;&amp; bun dev</span>
                </div>
            </div>
        </div>

        @* Footer Actions *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <div class="flex items-center gap-2 text-[10px] text-muted-foreground">
                <LucideIconCn Name="sparkles" Size="12" Class="size-3 text-amber-500" />
                <span>Project ID: acme_6391_x</span>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5">
                    <LucideIconCn Name="settings-2" Size="12" Class="size-3" />
                    Settings
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Go to Project
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record ProjectConfigItem(string Label, string Value, string Icon);

    private static readonly ProjectConfigItem[] _projectConfig =
    [
        new("Environment", "Production", "globe"),
        new("Framework", "Next.js 16 (App Router)", "code-2"),
        new("Region", "us-east-1 (N. Virginia)", "layout"),
    ];
}
