@* ============================================================
   Block: success-profile-100
   Title: SuccessProfile100
   Description: A reward-focused success block for users who reach 100% profile completion, featuring visibility stats and identity verification status, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-profile-100.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground shadow-sm">

        @* Profile Strength Header *@
        <div class="border-b px-4 py-8 text-center sm:text-left bg-muted/30">
            <div class="flex flex-col items-center gap-5 sm:flex-row">
                <div class="relative">
                    <div class="flex size-16 items-center justify-center rounded-full bg-background border-2 border-primary overflow-hidden">
                        <LucideIconCn Name="user" Size="32" Class="size-8 text-muted-foreground/50" />
                    </div>
                    <div class="absolute -bottom-1 -right-1 flex size-6 items-center justify-center rounded-full bg-primary text-primary-foreground border-2 border-background">
                        <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                    </div>
                </div>
                <div class="flex-1 space-y-1">
                    <h2 class="text-sm font-medium">Profile 100% Complete</h2>
                    <p class="text-xs text-muted-foreground">
                        Excellent work! Your profile is fully optimized. This increases your chances of
                        connecting with top-tier collaborators by up to 3x.
                    </p>
                </div>
            </div>
        </div>

        @* Visibility Stats *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2 mb-4">
                <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Platform Visibility Impact
                </span>
            </div>
            <div class="grid gap-3 sm:grid-cols-3">
                @foreach (var stat in _visibilityStats)
                {
                    <div class="flex flex-col items-center justify-center gap-1.5 p-3 rounded-lg border bg-background text-center">
                        <LucideIconCn Name="@stat.Icon" Size="16" Class="@($"size-4 {stat.Color}")" />
                        <p class="text-xs font-bold leading-none">@stat.Value</p>
                        <p class="text-[10px] text-muted-foreground font-medium">@stat.Label</p>
                    </div>
                }
            </div>
        </div>

        @* Trust Badge Section *@
        <div class="border-b px-4 py-3 bg-emerald-500/5">
            <div class="flex items-center gap-2.5">
                <div class="flex size-5 items-center justify-center rounded-full bg-emerald-500/10">
                    <LucideIconCn Name="shield-check" Size="12" Class="size-3 text-emerald-500" />
                </div>
                <p class="text-[11px] text-muted-foreground">
                    Your identity is now <span class="font-semibold text-foreground">Verified</span>.
                    You have been granted the Trusted Contributor badge.
                </p>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <p class="text-[10px] text-muted-foreground">Last updated: June 1, 2026</p>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                View Public Profile
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record VisibilityStat(string Label, string Value, string Icon, string Color);

    private static readonly VisibilityStat[] _visibilityStats =
    [
        new("Profile Views",  "+250%",   "eye",          "text-blue-500"),
        new("Search Ranking", "Top 10%", "search",       "text-emerald-500"),
        new("Network Trust",  "High",    "shield-check", "text-purple-500"),
    ];
}
