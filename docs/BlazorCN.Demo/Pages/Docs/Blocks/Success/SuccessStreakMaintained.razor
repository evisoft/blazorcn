@* ============================================================
   Block: success-streak-maintained
   Title: SuccessStreakMaintained
   Description: An engagement-focused success block that celebrates a user's activity streak with animated counters and historical context, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-streak-maintained.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground shadow-sm">

        @* Streak Hero Section *@
        <div class="border-b px-4 py-10 flex flex-col items-center text-center">
            <div class="relative mb-6">
                <div class="absolute inset-0 blur-3xl bg-orange-500/20 rounded-full"></div>
                <div class="relative flex size-24 items-center justify-center rounded-full border-4 border-orange-500/10 bg-orange-500/5">
                    <LucideIconCn Name="flame" Size="48" Class="size-12 text-orange-500 fill-orange-500/20" />
                </div>
                <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 bg-zinc-950 text-white px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-widest uppercase border border-white/10 whitespace-nowrap">
                    Mastery
                </div>
            </div>

            <div class="space-y-1">
                <h2 class="text-3xl font-bold tracking-tight">14 Days</h2>
                <p class="text-xs text-muted-foreground font-medium uppercase tracking-wider">
                    Current Daily Streak
                </p>
            </div>

            <p class="mt-4 text-xs text-muted-foreground mx-auto max-w-xs">
                Impressive! You've logged in for 14 consecutive days. You're only 7 days away from
                earning the "Weekly Warrior" badge.
            </p>
        </div>

        @* Weekly Activity Section *@
        <div class="border-b px-4 py-6">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        This Week's Activity
                    </span>
                </div>
                <span class="text-[10px] text-emerald-500 font-medium">+100 XP Earned</span>
            </div>
            <div class="flex justify-between items-center gap-2">
                @foreach (var wd in _weekDays)
                {
                    var day = wd;
                    <div class="flex flex-col items-center gap-2">
                        <div class="@Cn.Merge("flex size-8 items-center justify-center rounded-lg border text-xs font-medium transition-colors", day.Active ? "bg-orange-500 border-orange-600 text-white shadow-sm shadow-orange-500/20" : "bg-muted/50 text-muted-foreground")">
                            @day.Day
                        </div>
                        @if (day.Active)
                        {
                            <div class="size-1 rounded-full bg-orange-500"></div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Bonus Info Section *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center gap-2.5">
                <div class="flex size-5 shrink-0 items-center justify-center rounded-full bg-primary/10">
                    <LucideIconCn Name="info" Size="12" Class="size-3 text-primary" />
                </div>
                <p class="text-[11px] text-muted-foreground">
                    Maintain your streak for <span class="font-semibold text-foreground">30 days</span> to unlock a permanent
                    1.5x XP multiplier.
                </p>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <div class="flex items-center gap-4">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5 px-0 hover:bg-transparent">
                    <LucideIconCn Name="share-2" Size="12" Class="size-3" />
                    Share
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5 px-0 hover:bg-transparent">
                    <LucideIconCn Name="history" Size="12" Class="size-3" />
                    History
                </ButtonCn>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5">
                <LucideIconCn Name="trophy" Size="12" Class="size-3" />
                View Awards
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record WeekDay(string Day, bool Active);

    private static readonly WeekDay[] _weekDays =
    [
        new("M", true),
        new("T", true),
        new("W", true),
        new("T", true),
        new("F", true),
        new("S", true),
        new("S", false),
    ];
}
