@* ============================================================
   Block: success-asset-uploaded
   Title: SuccessAssetUploaded
   Description: A clean success block for file uploads, featuring an asset preview and CDN link generation, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-asset-uploaded.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4 text-center sm:text-left">
            <div class="flex flex-col items-center gap-3 sm:flex-row">
                <div class="flex size-10 items-center justify-center rounded-full bg-emerald-500/10">
                    <LucideIconCn Name="upload-cloud" Size="20" Class="size-5 text-emerald-500" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Asset uploaded successfully</h2>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Your file &ldquo;hero-banner.png&rdquo; is processed and ready for use.
                    </p>
                </div>
            </div>
        </div>

        @* Asset Preview *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2 mb-4">
                <LucideIconCn Name="file-text" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Asset preview &amp; Details
                </span>
            </div>
            <div class="flex items-center gap-4 p-3 rounded-md border bg-muted/30">
                <div class="flex size-16 shrink-0 items-center justify-center rounded border bg-background">
                    <LucideIconCn Name="image" Size="24" Class="size-6 text-muted-foreground/50" />
                </div>
                <div class="flex-1 min-w-0 space-y-1">
                    <p class="text-xs font-medium truncate">hero-banner.png</p>
                    <div class="flex items-center gap-2 text-[10px] text-muted-foreground">
                        <span>PNG Image</span>
                        <span class="size-1 rounded-full bg-muted-foreground/30"></span>
                        <span>2.4 MB</span>
                        <span class="size-1 rounded-full bg-muted-foreground/30"></span>
                        <span>1920 × 1080</span>
                    </div>
                </div>
                <div class="flex items-center gap-1.5 shrink-0">
                    <div class="size-1.5 rounded-full bg-emerald-500"></div>
                    <span class="text-[10px] font-medium text-emerald-500">Live</span>
                </div>
            </div>
        </div>

        @* CDN Link Section *@
        <div class="border-b px-4 py-4 bg-muted/30">
            <div class="flex items-center gap-2 mb-3">
                <LucideIconCn Name="link" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Production CDN URL
                </span>
            </div>
            <div class="flex items-center gap-2">
                <div class="flex-1 px-3 py-2 rounded border bg-background text-xs font-mono text-muted-foreground overflow-hidden text-ellipsis whitespace-nowrap">
                    https://cdn.shadcn.io/assets/hero-banner.png
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="size-8 shrink-0" OnClick="CopyLink">
                    <LucideIconCn Name="copy" Size="14" Class="size-3.5" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="size-8 shrink-0">
                    <LucideIconCn Name="external-link" Size="14" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                <p class="text-[10px] text-muted-foreground">Optimized for web delivery</p>
            </div>
            <div class="flex gap-2">
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-8 text-xs">
                    Manage Assets
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Upload More
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private void CopyLink()
    {
        // Clipboard copy requires JS interop; omitted in this presentational port.
    }
}
