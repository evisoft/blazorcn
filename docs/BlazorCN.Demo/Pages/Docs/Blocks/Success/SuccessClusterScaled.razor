@* ============================================================
   Block: success-cluster-scaled
   Title: SuccessClusterScaled
   Description: A cloud infrastructure success block for cluster scaling, featuring node counts, resource allocation, and health check status, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-cluster-scaled.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-blue-500/10">
                    <LucideIconCn Name="layers" Size="20" Class="size-5 text-blue-500" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Cluster "production-main" Scaled</h2>
                    <p class="text-xs text-muted-foreground">
                        Increased capacity to handle 2.5x more concurrent requests.
                    </p>
                </div>
            </div>
        </div>

        @* Scaling Stats *@
        <div class="border-b px-4 py-4">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="p-3 rounded-md border bg-muted/10 space-y-1">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="plus" Size="12" Class="size-3 text-emerald-500" />
                        <span class="text-[10px] font-medium uppercase text-muted-foreground">
                            Nodes Added
                        </span>
                    </div>
                    <p class="text-lg font-semibold">+4</p>
                </div>
                <div class="p-3 rounded-md border bg-muted/10 space-y-1">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="cpu" Size="12" Class="size-3 text-blue-500" />
                        <span class="text-[10px] font-medium uppercase text-muted-foreground">
                            Total CPU
                        </span>
                    </div>
                    <p class="text-lg font-semibold">32 vCPU</p>
                </div>
                <div class="p-3 rounded-md border bg-muted/10 space-y-1">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="hard-drive" Size="12" Class="size-3 text-purple-500" />
                        <span class="text-[10px] font-medium uppercase text-muted-foreground">
                            Total RAM
                        </span>
                    </div>
                    <p class="text-lg font-semibold">64 GB</p>
                </div>
            </div>
        </div>

        @* Health Check Status *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="activity" Size="14" Class="size-3.5 text-emerald-500" />
                    <span class="text-[11px] font-medium">Health Check: All Nodes OK</span>
                </div>
                <div class="flex -space-x-1">
                    @for (int i = 1; i <= 6; i++)
                    {
                        <div class="size-2 rounded-full border border-background bg-emerald-500"></div>
                    }
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3 bg-muted/50">
            <p class="text-[10px] text-muted-foreground">Last updated: Just now</p>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    View Metrics
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Scaling Rules
                </ButtonCn>
            </div>
        </div>

    </div>
</section>
