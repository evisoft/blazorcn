@* ============================================================
   Block: success-level-up
   Title: SuccessLevelUp
   Description: A gamified success block for user tier advancement or plan upgrades, featuring unlocked perks and progress visuals, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-level-up.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground shadow-sm">

        @* Tier Upgrade Header *@
        <div class="relative border-b px-4 py-12 text-center overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-b from-primary/5 to-transparent pointer-events-none"></div>

            <div class="relative mx-auto flex size-14 items-center justify-center rounded-xl bg-primary text-primary-foreground mb-4 shadow-lg shadow-primary/20">
                <LucideIconCn Name="crown" Size="28" Class="size-7" />
                <div class="absolute -top-1 -right-1 flex size-5 items-center justify-center rounded-full bg-amber-500">
                    <LucideIconCn Name="zap" Size="12" Class="size-3 text-white fill-current" />
                </div>
            </div>

            <div class="relative space-y-2">
                <h2 class="text-sm font-medium">New Tier Unlocked: Pro Elite</h2>
                <p class="text-xs text-muted-foreground mx-auto max-w-sm">
                    You've officially graduated from the Pro plan to our Elite tier. Experience the full
                    power of our platform with these new capabilities.
                </p>
            </div>
        </div>

        @* Perks Section *@
        <div class="border-b px-4 py-5">
            <div class="flex items-center gap-2 mb-4">
                <LucideIconCn Name="gem" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    New Perks Available
                </span>
            </div>
            <div class="grid sm:grid-cols-2 gap-3">
                @foreach (var perk in _perks)
                {
                    <div class="flex items-center gap-2.5 p-2.5 rounded-md border bg-muted/20">
                        <div class="flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                            <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                        </div>
                        <span class="text-xs font-medium">@perk</span>
                    </div>
                }
            </div>
        </div>

        @* Informational Section *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex items-start gap-3">
                <div class="flex size-5 shrink-0 items-center justify-center rounded-full bg-primary/10 mt-0.5">
                    <LucideIconCn Name="info" Size="12" Class="size-3 text-primary" />
                </div>
                <p class="text-[11px] text-muted-foreground leading-relaxed">
                    Your billing cycle will adjust automatically on the next renewal date. You can manage
                    your subscription and seat limits in the&nbsp;<span class="underline cursor-pointer text-foreground font-medium">Billing Portal</span>.
                </p>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <span class="text-[10px] text-muted-foreground cursor-pointer hover:underline">View Level History</span>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5">
                Explore New Perks
                <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3" />
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private static readonly string[] _perks =
    [
        "Priority support queue",
        "Advanced team permissions",
        "Custom domain white-labeling",
        "Unlimited cloud storage",
    ];
}
