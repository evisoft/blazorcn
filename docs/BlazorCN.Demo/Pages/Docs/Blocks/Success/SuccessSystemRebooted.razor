@* ============================================================
   Block: success-system-rebooted
   Title: SuccessSystemRebooted
   Description: React success block for server restart or service reboot confirmation in Next.js, featuring uptime tracking, service health checks, and process status using shadcn/ui and Tailwind CSS.
   Source: original/blocks/success/success-system-rebooted.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b p-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="power" Size="14" Class="size-3.5" />
                    </div>
                    <h1 class="font-medium text-sm">System rebooted successfully</h1>
                </div>
                <span class="font-mono text-[10px] text-muted-foreground bg-muted px-1.5 py-0.5 rounded">
                    @_rebootId
                </span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                The system has returned from the <span class="text-foreground">@_rebootReason</span> and is now healthy.
            </p>
        </div>

        @* Reboot Stats *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Current Uptime
                    </span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-medium text-sm">@_uptime</span>
                        <span class="text-[10px] font-medium text-muted-foreground uppercase">sec</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Health Score
                    </span>
                    <div class="mt-1 flex items-center gap-1 text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="heart-pulse" Size="12" Class="size-3" />
                        <span class="font-medium text-xs">@_healthScore</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Processes
                    </span>
                    <div class="mt-1 flex items-center gap-1">
                        <LucideIconCn Name="cpu" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="font-medium text-xs tabular-nums">@_processes</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Load Avg
                    </span>
                    <span class="mt-1 block font-medium text-xs tabular-nums">0.02, 0.05</span>
                </div>
            </div>
        </div>

        @* Service Checklist *@
        <div class="border-b p-4">
            <div class="flex items-center gap-2 mb-3">
                <LucideIconCn Name="activity" Size="14" Class="size-3.5 text-muted-foreground" />
                <h2 class="font-medium text-sm">Post-boot service health</h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                @foreach (var svc in _services)
                {
                    <div class="flex items-center justify-between rounded-md border bg-muted/20 px-3 py-2">
                        <div class="flex items-center gap-2">
                            <div class="size-1.5 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.5)]"></div>
                            <span class="text-xs font-medium">@svc.Name</span>
                        </div>
                        <span class="text-[10px] text-muted-foreground uppercase font-bold tracking-tighter">
                            @svc.Status
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2 text-muted-foreground">
                <LucideIconCn Name="refresh-cw" Size="14" Class="size-3.5" />
                <span class="text-xs">Next sync in 4m 22s</span>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    <LucideIconCn Name="file-text" Size="12" Class="size-3" />
                    View System Logs
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-3 text-xs">
                    Done
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private const string _rebootId = "REBOOT_82374";
    private const string _rebootReason = "Kernel Update (5.15.0-x)";
    private const int _uptime = 142;
    private const int _processes = 124;
    private const int _healthScore = 100;

    private record ServiceItem(string Name, string Status);

    private static readonly ServiceItem[] _services =
    [
        new("System Init", "Active"),
        new("Networking", "Active"),
        new("SSH Daemon", "Active"),
        new("Docker Engine", "Active"),
    ];
}
