@* ============================================================
   Block: success-email-verified
   Title: SuccessEmailVerified
   Description: A dynamic success block for email verification, featuring an automatic redirect countdown and status indicators, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-email-verified.tsx
   ============================================================ *@

@implements IDisposable

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-8 text-center">
            <div class="mx-auto flex size-14 items-center justify-center rounded-full bg-blue-500/10 mb-5 relative">
                <LucideIconCn Name="mail-check" Size="28" Class="size-7 text-blue-500" />
                <div class="absolute -right-1 -bottom-1 size-6 rounded-full bg-background border flex items-center justify-center">
                    <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-500" />
                </div>
            </div>
            <h2 class="text-sm font-medium">Email address verified</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Thank you for verifying your email. Your account is now fully active and ready to use.
            </p>
        </div>

        @* Redirect Section *@
        <div class="border-b px-4 py-6 text-center bg-muted/20">
            <div class="flex flex-col items-center gap-3">
                <div class="flex items-center gap-2 text-[11px] font-medium text-muted-foreground uppercase tracking-widest">
                    <LucideIconCn Name="loader-2" Size="12" Class="size-3 animate-spin" />
                    Redirecting in @(_countdown)s
                </div>
                <div class="w-full max-w-[200px] h-1 bg-muted rounded-full overflow-hidden">
                    <div class="h-full bg-blue-500 transition-all duration-1000 ease-linear"
                         style="@($"width:{_countdown * 20}%")">
                    </div>
                </div>
            </div>
        </div>

        @* Info Section *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="text-[11px] text-muted-foreground uppercase tracking-wider font-medium">
                        Account ID
                    </span>
                    <span class="text-[11px] font-mono bg-muted px-1.5 py-0.5 rounded">
                        usr_294x92
                    </span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-[11px] text-muted-foreground uppercase tracking-wider font-medium">
                        Status
                    </span>
                    <span class="text-[11px] text-emerald-500 font-medium">Active</span>
                </div>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-3 flex justify-center bg-muted/50">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5 px-8">
                Go to Dashboard
                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private int _countdown = 5;
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ =>
        {
            if (_countdown > 0)
            {
                _countdown--;
                InvokeAsync(StateHasChanged);
            }
            else
            {
                _timer?.Dispose();
                _timer = null;
            }
        }, null, 1000, 1000);
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _timer = null;
    }
}
