@* ============================================================
   Block: success-affiliate-approved
   Title: SuccessAffiliateApproved
   Description: A marketing success block for affiliate program approval, featuring referral link generation and sharing options, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-affiliate-approved.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header *@
        <div class="border-b px-4 py-4">
            <div class="flex flex-col items-center gap-3 sm:flex-row">
                <div class="flex size-10 items-center justify-center rounded-full bg-muted">
                    <LucideIconCn Name="user-check" Size="20" Class="size-5 text-foreground" />
                </div>
                <div class="flex-1 text-center sm:text-left">
                    <h2 class="text-sm font-medium">Affiliate Application Approved</h2>
                    <p class="mt-1 text-xs text-muted-foreground">
                        You're now an official partner. Start sharing your link to earn commissions.
                    </p>
                </div>
            </div>
        </div>

        @* Referral Link Section *@
        <div class="border-b px-4 py-4 bg-muted/30">
            <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="link" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Your Unique Referral Link
                    </span>
                </div>
                <div class="flex items-center gap-1">
                    <LucideIconCn Name="globe" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">Global Tracking Active</span>
                </div>
            </div>
            <div class="flex items-center gap-2 p-2 rounded border bg-background shadow-sm">
                <code class="flex-1 text-[11px] font-mono text-muted-foreground overflow-hidden truncate px-1">
                    https://acme.com/ref/partner-92841
                </code>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-[10px] gap-1.5 px-2">
                    <LucideIconCn Name="copy" Size="12" Class="size-3" />
                    Copy
                </ButtonCn>
            </div>
        </div>

        @* Commission Summary *@
        <div class="border-b px-4 py-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1">
                <p class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Standard Commission
                </p>
                <div class="flex items-baseline gap-1">
                    <span class="text-lg font-semibold">15%</span>
                    <span class="text-[10px] text-muted-foreground">per sale</span>
                </div>
            </div>
            <div class="space-y-1">
                <p class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Cookie Duration
                </p>
                <div class="flex items-baseline gap-1">
                    <span class="text-lg font-semibold">90</span>
                    <span class="text-[10px] text-muted-foreground">Days</span>
                </div>
            </div>
        </div>

        @* Footer Sharing *@
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 px-4 py-3 bg-muted/50">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sparkles" Size="14" Class="size-3.5 text-amber-500" />
                <span class="text-[10px] text-muted-foreground">Start promoting now</span>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-[11px] gap-1.5">
                    <LucideIconCn Name="share-2" Size="12" Class="size-3" />
                    Share
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Brand Assets
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Go to Portal
                </ButtonCn>
            </div>
        </div>

    </div>
</section>
