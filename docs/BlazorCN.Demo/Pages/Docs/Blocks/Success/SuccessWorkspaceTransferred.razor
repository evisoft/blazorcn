@* ============================================================
   Block: success-workspace-transferred
   Title: SuccessWorkspaceTransferred
   Description: A collaborative success block for workspace ownership transfer, featuring participant summaries and access status updates, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-workspace-transferred.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-emerald-500/10 shrink-0">
                    <LucideIconCn Name="briefcase" Size="20" Class="size-5 text-emerald-600" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Workspace ownership transferred</h2>
                    <p class="mt-1 text-xs text-muted-foreground leading-snug">
                        Ownership of the <strong>Acme Design</strong> workspace has been successfully moved to the new administrator.
                    </p>
                </div>
            </div>
        </div>

        @* Participant Summary *@
        <div class="border-b px-4 py-6">
            <div class="flex items-center justify-between gap-4">

                @* Previous Owner *@
                <div class="flex flex-1 flex-col items-center text-center gap-2 p-3 rounded border bg-muted/20">
                    <div class="flex size-8 items-center justify-center rounded-full border bg-background">
                        <LucideIconCn Name="user-minus" Size="14" Class="size-3.5 text-muted-foreground" />
                    </div>
                    <div>
                        <p class="text-[11px] font-medium">Previous Owner</p>
                        <p class="text-[10px] text-muted-foreground mt-0.5 italic">Downgraded to Admin</p>
                    </div>
                </div>

                <LucideIconCn Name="arrow-right" Size="16" Class="size-4 text-muted-foreground shrink-0" />

                @* New Owner *@
                <div class="flex flex-1 flex-col items-center text-center gap-2 p-3 rounded border border-emerald-500/20 bg-emerald-500/5">
                    <div class="flex size-8 items-center justify-center rounded-full border border-emerald-500/30 bg-background relative">
                        <LucideIconCn Name="user-check" Size="14" Class="size-3.5 text-emerald-600" />
                        <div class="absolute -right-1 -bottom-1 size-3 rounded-full bg-emerald-500 flex items-center justify-center">
                            <LucideIconCn Name="check-circle-2" Size="8" Class="size-2 text-white" />
                        </div>
                    </div>
                    <div>
                        <p class="text-[11px] font-medium">New Owner</p>
                        <p class="text-[10px] text-emerald-600 mt-0.5 font-medium">Primary Access</p>
                    </div>
                </div>

            </div>
        </div>

        @* Security / Access Info *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center gap-3">
                <LucideIconCn Name="shield-ellipsis" Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-[11px] text-muted-foreground">
                    Billing and subscription management have also been transferred to the new owner&#39;s account.
                </p>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-3 flex justify-end bg-muted/50">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs px-6">
                Enter Workspace
            </ButtonCn>
        </div>

    </div>
</section>
