@* ============================================================
   Block: success-ab-test-started
   Title: SuccessAbTestStarted
   Description: A marketing success block for split test initiation, featuring variation details and real-time monitoring stats, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-ab-test-started.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground shadow-sm">

        @* Header Section *@
        <div class="border-b px-4 py-4">
            <div class="flex flex-col items-center gap-3 sm:flex-row">
                <div class="flex size-10 items-center justify-center rounded-full bg-muted">
                    <LucideIconCn Name="flask-conical" Size="20" Class="size-5 text-foreground" />
                </div>
                <div class="flex-1 text-center sm:text-left">
                    <h2 class="text-sm font-medium">A/B Test "Hero-Optimization" Started</h2>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Your split test is live and currently distributing traffic to variations.
                    </p>
                </div>
            </div>
        </div>

        @* Experiment Variations *@
        <div class="border-b px-4 py-4 bg-muted/10">
            <div class="flex items-center gap-2 mb-4">
                <LucideIconCn Name="split" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Active Variations
                </span>
            </div>
            <div class="space-y-2">
                @foreach (var variation in _variations)
                {
                    <div class="flex items-center justify-between p-2.5 rounded border bg-background shadow-sm">
                        <div class="flex items-center gap-3">
                            <div class="size-2 rounded-full bg-blue-500"></div>
                            <span class="text-xs font-medium">@variation.Name</span>
                        </div>
                        <div class="flex items-center gap-4">
                            <span class="text-[10px] text-muted-foreground font-mono">
                                @variation.Id
                            </span>
                            <div class="flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-muted border text-[10px] font-medium">
                                @variation.Traffic Traffic
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Goal & Metrics Preview *@
        <div class="border-b px-4 py-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded border bg-muted/50">
                    <LucideIconCn Name="trending-up" Size="16" Class="size-4 text-muted-foreground" />
                </div>
                <div>
                    <p class="text-[10px] text-muted-foreground uppercase tracking-wider font-medium">
                        Primary Goal
                    </p>
                    <p class="text-xs font-medium">Conversion Rate</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded border bg-muted/50">
                    <LucideIconCn Name="activity" Size="16" Class="size-4 text-muted-foreground" />
                </div>
                <div>
                    <p class="text-[10px] text-muted-foreground uppercase tracking-wider font-medium">
                        Confidence Level
                    </p>
                    <p class="text-xs font-medium">95% Required</p>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5 flex items-center justify-between bg-muted/50">
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
                <p class="text-[10px] text-muted-foreground italic">Collecting data...</p>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-[11px] gap-1.5">
                    <LucideIconCn Name="eye" Size="14" Class="size-3.5" />
                    Preview
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5">
                    View Results
                    <LucideIconCn Name="play" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record VariationItem(string Name, string Traffic, string Id);

    private static readonly VariationItem[] _variations =
    [
        new("Control (Original)", "50%", "VAR-A"),
        new("Variant (New Hero)",  "50%", "VAR-B"),
    ];
}
