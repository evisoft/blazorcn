@* ============================================================
   Block: success-analytics-connected
   Title: SuccessAnalyticsConnected
   Description: React success block for analytics or data stream connection confirmation in Next.js, featuring real-time data status, event count metrics, and source details using shadcn/ui and Tailwind CSS.
   Source: original/blocks/success/success-analytics-connected.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b p-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                    </div>
                    <h1 class="font-medium text-sm">Data stream connected</h1>
                </div>
                <div class="flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400">
                    <div class="size-1.5 animate-pulse rounded-full bg-current"></div>
                    <span class="text-[10px] font-bold uppercase tracking-widest">
                        @_analyticsData.Status
                    </span>
                </div>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Successfully receiving events from
                <span class="text-foreground">@_analyticsData.SourceName</span> via
                @_analyticsData.Provider.
            </p>
        </div>

        @* Analytics Stats *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Events / min
                    </span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-medium text-sm">@_analyticsData.EventsLastMinute</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Data Volume
                    </span>
                    <span class="mt-1 block font-medium text-sm tabular-nums">
                        @_analyticsData.TotalVolume
                    </span>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Active Regions
                    </span>
                    <div class="mt-1 flex items-center gap-1">
                        <span class="font-medium text-sm">@_analyticsData.Regions.Length</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Protocol
                    </span>
                    <div class="mt-1 flex items-center gap-1 text-amber-600 dark:text-amber-400">
                        <LucideIconCn Name="zap" Size="12" Class="size-3" />
                        <span class="font-medium text-[10px] uppercase tracking-tighter">gRPC</span>
                    </div>
                </div>
            </div>
        </div>

        @* Integration Summary *@
        <div class="border-b p-4">
            <h2 class="mb-3 font-medium text-sm text-foreground">Active collection</h2>
            <div class="grid gap-2">
                @foreach (var ev in _events)
                {
                    <div class="flex items-center justify-between rounded-md border bg-muted/10 px-3 py-2">
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="line-chart" Size="12" Class="size-3 text-muted-foreground" />
                            <span class="text-muted-foreground text-xs">@ev.Label</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="font-mono text-[11px] tabular-nums">
                                @ev.Count.ToString("N0")
                            </span>
                            <div class="size-1 rounded-full bg-emerald-500"></div>
                        </div>
                    </div>
                }
            </div>
            <button type="button" class="mt-4 flex items-center gap-1 font-medium text-[11px] text-muted-foreground hover:text-foreground transition-colors">
                Go to Debugger
                <LucideIconCn Name="chevron-right" Size="12" Class="size-3" />
            </button>
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="layout-grid" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Schema: Unified v2.4</span>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    <LucideIconCn Name="bar-chart-3" Size="12" Class="size-3" />
                    View Dashboard
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    Source App
                    <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record AnalyticsInfo(
        string Provider,
        string SourceName,
        int EventsLastMinute,
        string TotalVolume,
        string Status,
        string[] Regions
    );

    private record EventItem(string Label, int Count, string Status);

    private static readonly AnalyticsInfo _analyticsData = new(
        "Segment (Cloud Mode)",
        "Main Web App",
        420,
        "12.4 MB",
        "Live",
        ["US-East", "EU-West"]
    );

    private static readonly EventItem[] _events =
    [
        new("Page Views",    1240, "stable"),
        new("Button Clicks", 4802, "stable"),
        new("User Signups",    82, "stable"),
    ];
}
