@* ============================================================
   Block: success-card-updated
   Title: SuccessCardUpdated
   Description: React success block for payment method updates in Next.js with secure masking, card type detection, and default status confirmation using shadcn/ui and Tailwind CSS.
   Source: original/blocks/success/success-card-updated.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b p-4">
            <div class="flex items-center gap-2">
                <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                    <LucideIconCn Name="shield-check" Size="14" Class="size-3.5" />
                </div>
                <h1 class="font-medium text-sm">Payment method updated</h1>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Your new default card has been securely saved and verified.
            </p>
        </div>

        @* Card Details Card *@
        <div class="border-b px-4 py-6">
            <div class="mx-auto max-w-sm rounded-xl border bg-gradient-to-b from-muted/50 to-muted/20 p-5 shadow-sm">
                <div class="mb-8 flex items-start justify-between">
                    <div class="rounded-lg bg-background p-2 shadow-sm">
                        <LucideIconCn Name="credit-card" Size="24" Class="size-6 text-foreground/80" />
                    </div>
                    @if (_cardData.IsDefault)
                    {
                        <BadgeCn Variant="BadgeVariant.Outline" Class="border-emerald-500/30 bg-emerald-500/5 text-emerald-600 text-[10px] dark:text-emerald-400">
                            Default Method
                        </BadgeCn>
                    }
                </div>

                <div class="space-y-4">
                    <div class="flex items-baseline gap-1.5">
                        <span class="text-muted-foreground">••••</span>
                        <span class="text-muted-foreground">••••</span>
                        <span class="text-muted-foreground">••••</span>
                        <span class="font-mono text-lg tracking-wider">@_cardData.Last4</span>
                    </div>

                    <div class="flex justify-between">
                        <div>
                            <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                                Expiry
                            </span>
                            <span class="font-medium text-xs">@_cardData.Expiry</span>
                        </div>
                        <div>
                            <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                                Brand
                            </span>
                            <span class="font-medium text-xs">@_cardData.Brand</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Security Confirmation *@
        <div class="flex items-center gap-3 border-b bg-muted/30 px-4 py-3">
            <div class="flex size-8 items-center justify-center rounded-full border bg-background">
                <LucideIconCn Name="lock" Size="14" Class="size-3.5 text-muted-foreground" />
            </div>
            <div>
                <span class="block font-medium text-xs">Securely stored</span>
                <span class="block text-muted-foreground text-[10px]">
                    PCI DSS Level 1 Compliant via Stripe
                </span>
            </div>
            <div class="ml-auto text-right">
                <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                    Last updated
                </span>
                <span class="block font-medium text-[11px]">@_cardData.UpdatedAt</span>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3">
            <p class="max-w-[280px] text-muted-foreground text-xs leading-relaxed">
                This card will be used for all future subscription renewals and one-time purchases.
            </p>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 px-3 text-xs">
                    Manage All
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-3 text-xs">
                    Done
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record CardData(string Brand, string Last4, string Expiry, bool IsDefault, string UpdatedAt);

    private static readonly CardData _cardData = new(
        Brand: "Visa",
        Last4: "4242",
        Expiry: "09/28",
        IsDefault: true,
        UpdatedAt: "Oct 24, 2025"
    );
}
