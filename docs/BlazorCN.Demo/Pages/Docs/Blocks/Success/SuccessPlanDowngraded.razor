@* ============================================================
   Block: success-plan-downgraded
   Title: SuccessPlanDowngraded
   Description: A muted plan downgrade acknowledgment block with a retention survey link and feature change summary, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-plan-downgraded.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-6 items-center justify-center rounded-full bg-muted">
                    <div class="size-1.5 rounded-full bg-muted-foreground/50"></div>
                </div>
                <h2 class="text-sm font-medium">Plan changed to Free</h2>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">
                Your Pro subscription has been cancelled and will not renew.
            </p>
        </div>

        @* Status Section *@
        <div class="border-b px-4 py-3">
            <div class="flex gap-3 items-start">
                <div class="mt-0.5">
                    <LucideIconCn Name="info" Size="14" Class="size-3.5 text-muted-foreground" />
                </div>
                <div>
                    <p class="text-xs font-medium text-foreground">
                        Changes take effect on May 12, 2026
                    </p>
                    <p class="mt-1 text-[11px] text-muted-foreground leading-relaxed">
                        You will continue to have access to Pro features until the end of your current
                        billing cycle. After that, your workspace will be limited to 3 members and 1GB of
                        storage.
                    </p>
                </div>
            </div>
        </div>

        @* Survey Section *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <LucideIconCn Name="message-square-text" Size="16" Class="size-4 text-muted-foreground" />
                    <p class="text-xs text-muted-foreground">We'd love to know how we can improve.</p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-[11px] shrink-0">
                    Share Feedback
                </ButtonCn>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-2.5 flex justify-end bg-muted/50">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                Return to Settings
            </ButtonCn>
        </div>

    </div>
</section>
