@* ============================================================
   Block: success-sso-configured
   Title: SuccessSsoConfigured
   Description: An enterprise-grade success block for Single Sign-On (SSO) configuration, featuring SAML/Okta connection status and metadata summary, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-sso-configured.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-blue-500/10 shrink-0">
                    <LucideIconCn Name="shield-check" Size="20" Class="size-5 text-blue-600" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">SSO connection established</h2>
                    <p class="mt-1 text-xs text-muted-foreground leading-snug">
                        Your organization's identity provider has been successfully linked to your
                        workspace.
                    </p>
                </div>
            </div>
        </div>

        @* Configuration Summary *@
        <div class="border-b px-4 py-5">
            <div class="flex items-center gap-2 mb-4">
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Configuration Summary
                </span>
            </div>
            <div class="grid gap-4 sm:grid-cols-3">
                @foreach (var detail in _configDetails)
                {
                    <div class="space-y-1.5 rounded border bg-muted/20 p-3">
                        <LucideIconCn Name="@detail.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
                        <div>
                            <p class="text-[10px] text-muted-foreground uppercase tracking-tight">
                                @detail.Label
                            </p>
                            <p class="@($"text-[11px] font-medium {(detail.Color ?? "text-foreground")}")">
                                @detail.Value
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Next Steps / Testing *@
        <div class="border-b px-4 py-4 bg-muted/30">
            <div class="flex items-start gap-3">
                <div class="mt-0.5 rounded-full bg-blue-500/10 p-1">
                    <LucideIconCn Name="link-2" Size="12" Class="size-3 text-blue-600" />
                </div>
                <div>
                    <p class="text-xs font-medium">Ready for deployment</p>
                    <p class="text-[11px] text-muted-foreground mt-0.5 leading-normal">
                        You can now enable "SSO Enforcement" to require all team members to log in via your
                        identity provider.
                    </p>
                </div>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs underline underline-offset-4">
                View Metadata
            </ButtonCn>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Test Connection
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Manage SSO
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record ConfigDetail(string Label, string Value, string Icon, string? Color = null);

    private static readonly ConfigDetail[] _configDetails =
    [
        new("Provider", "Okta (SAML 2.0)", "building-2"),
        new("Domain",   "acme-corp.com",    "globe"),
        new("Status",   "Connected",        "check-circle-2", "text-emerald-500"),
    ];
}
