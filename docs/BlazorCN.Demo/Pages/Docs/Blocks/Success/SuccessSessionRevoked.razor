@* ============================================================
   Block: success-session-revoked
   Title: SuccessSessionRevoked
   Description: A security-oriented success block for remote session termination, featuring device status summaries and security confirmation, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-session-revoked.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-5">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-amber-500/10 shrink-0">
                    <LucideIconCn Name="monitor-off" Size="20" Class="size-5 text-amber-600" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Remote sessions revoked</h2>
                    <p class="mt-1 text-xs text-muted-foreground leading-snug">
                        All other devices have been logged out. Your account is now only active on this
                        device.
                    </p>
                </div>
            </div>
        </div>

        @* Revoked Devices Summary *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2 mb-4">
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Revocation Summary
                </span>
            </div>
            <div class="space-y-3">
                @foreach (var device in _revokedDevices)
                {
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="flex size-8 items-center justify-center rounded border bg-muted/30">
                                <LucideIconCn Name="@device.Icon" Size="16" Class="size-4 text-muted-foreground" />
                            </div>
                            <div>
                                <p class="text-[11px] font-medium leading-none">@device.Name</p>
                                <p class="text-[10px] text-muted-foreground mt-1">@device.Location</p>
                            </div>
                        </div>
                        <div class="text-[10px] text-amber-600 font-medium bg-amber-500/5 px-2 py-0.5 rounded border border-amber-500/10 uppercase tracking-tighter">
                            Revoked
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Security Confirmation *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center gap-3">
                <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-emerald-500" />
                <p class="text-[11px] text-muted-foreground">
                    Your account security has been restored. No other active sessions were found.
                </p>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-3 flex justify-between items-center bg-muted/50">
            <p class="text-[10px] text-muted-foreground italic">Action completed: May 20, 2026</p>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 text-xs px-4">
                Security Settings
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record RevokedDevice(string Type, string Name, string Location, string Icon);

    private static readonly RevokedDevice[] _revokedDevices =
    [
        new("Mobile", "iPhone 15 Pro", "London, UK", "smartphone"),
        new("Desktop", "macOS • Chrome", "San Francisco, US", "monitor-off"),
        new("Tablet", "iPad Air", "Tokyo, JP", "tablet"),
    ];
}
