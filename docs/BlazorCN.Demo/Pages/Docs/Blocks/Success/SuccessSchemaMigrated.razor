@* ============================================================
   Block: success-schema-migrated
   Title: SuccessSchemaMigrated
   Description: React success block for database schema migration confirmation in Next.js, featuring a summary of tables modified, row counts affected, and environment details using shadcn/ui and Tailwind CSS.
   Source: original/blocks/success/success-schema-migrated.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b p-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                    </div>
                    <h1 class="font-medium text-sm">Schema migrated</h1>
                </div>
                <div class="flex items-center gap-1.5 rounded-full border bg-muted/50 px-2 py-0.5">
                    <div class="size-1 rounded-full bg-emerald-500"></div>
                    <span class="text-[10px] font-medium uppercase tracking-tight">@_env</span>
                </div>
            </div>
            <p class="mt-1 text-muted-foreground text-xs font-mono">v@_version</p>
        </div>

        @* Migration Stats *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Duration
                    </span>
                    <span class="mt-1 block font-medium text-sm tabular-nums">@_duration</span>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Tables Affected
                    </span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-medium text-sm">@_tablesAffected</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Rows Modified
                    </span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-medium text-sm">@_rowsModified.ToString("N0")</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Status
                    </span>
                    <div class="mt-1 flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400">
                        <span class="font-medium text-xs">Healthy</span>
                    </div>
                </div>
            </div>
        </div>

        @* Change List *@
        <div class="border-b p-4">
            <h2 class="mb-3 font-medium text-sm">Changes summary</h2>
            <div class="space-y-2">
                @foreach (var change in _changes)
                {
                    <div class="flex items-center justify-between rounded-md border bg-muted/10 px-3 py-2.5 transition-colors hover:bg-muted/20">
                        <div class="flex items-center gap-3">
                            <div class="flex size-7 items-center justify-center rounded-md border bg-background">
                                <LucideIconCn Name="database" Size="14" Class="size-3.5 text-muted-foreground" />
                            </div>
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="font-mono text-xs font-medium text-foreground">@change.Table</span>
                                    <span class="text-[9px] font-semibold uppercase tracking-widest text-muted-foreground/60">@change.Type</span>
                                </div>
                                <p class="text-[11px] text-muted-foreground">@change.Details</p>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="12" Class="size-3 text-muted-foreground/40" />
                    </div>
                }
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="layers" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Prisma Client updated</span>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    <LucideIconCn Name="rotate-ccw" Size="12" Class="size-3" />
                    Rollback
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    <LucideIconCn Name="code" Size="12" Class="size-3" />
                    View Diff
                    <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private const string _version = "20251024_add_user_prefs";
    private const string _env = "Production";
    private const string _duration = "4.2s";
    private const int _tablesAffected = 3;
    private const int _rowsModified = 12500;

    private record MigrationChange(string Type, string Table, string Details);

    private static readonly MigrationChange[] _changes =
    [
        new("Added", "user_preferences", "New table for UI state"),
        new("Modified", "users", "Added last_login_ip column"),
        new("Index", "audit_logs", "Added GIN index on metadata"),
    ];
}
