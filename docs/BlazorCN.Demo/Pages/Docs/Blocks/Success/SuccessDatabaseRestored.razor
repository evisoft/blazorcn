@* ============================================================
   Block: success-database-restored
   Title: SuccessDatabaseRestored
   Description: A data infrastructure success block for point-in-time recovery, featuring restore snapshots, data integrity status, and recovery metrics, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-database-restored.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-purple-500/10">
                    <LucideIconCn Name="history" Size="20" Class="size-5 text-purple-500" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Point-in-Time Restore Complete</h2>
                    <p class="text-xs text-muted-foreground">
                        Database "customer_prod" successfully restored to Jun 01, 14:22 UTC.
                    </p>
                </div>
            </div>
        </div>

        @* Restore Metrics *@
        <div class="border-b px-4 py-4">
            <div class="grid grid-cols-2 gap-4">
                <div class="space-y-1.5">
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Snapshot Source
                    </span>
                    <div class="flex items-center gap-2 text-xs font-mono">
                        <LucideIconCn Name="database" Size="12" Class="size-3 text-muted-foreground" />
                        <span>db-snap-283192</span>
                    </div>
                </div>
                <div class="space-y-1.5">
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Restore Date
                    </span>
                    <div class="flex items-center gap-2 text-xs font-mono">
                        <LucideIconCn Name="calendar" Size="12" Class="size-3 text-muted-foreground" />
                        <span>Jun 01, 2026</span>
                    </div>
                </div>
                <div class="space-y-1.5">
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Data Integrity
                    </span>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                        <span class="text-xs font-medium">100% Verified</span>
                    </div>
                </div>
                <div class="space-y-1.5">
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Total Size
                    </span>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="file-text" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium">42.8 GB</span>
                    </div>
                </div>
            </div>
        </div>

        @* Status Info *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <p class="text-[11px] text-muted-foreground text-center">
                The database is now available at&#32;<code class="bg-muted px-1 rounded">prod-restored.cluster.internal</code>
            </p>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3 bg-muted/50">
            <p class="text-[10px] text-muted-foreground">Restore duration: 12m 44s</p>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    View Logs
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Connect Now
                </ButtonCn>
            </div>
        </div>

    </div>
</section>
