@* ============================================================
   Block: success-tutorial-finished
   Title: SuccessTutorialFinished
   Description: A clean success block for users who complete a product tour or educational tutorial, featuring a summary of learned concepts and a direct path to the dashboard, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-tutorial-finished.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground shadow-sm">

        @* Tutorial Hero Section *@
        <div class="border-b px-4 py-8 text-center sm:text-left bg-muted/30">
            <div class="flex flex-col items-center gap-4 sm:flex-row">
                <div class="flex size-12 items-center justify-center rounded-full bg-primary/10 border border-primary/20">
                    <LucideIconCn Name="compass" Size="24" Class="size-6 text-primary" />
                </div>
                <div class="flex-1 space-y-1">
                    <div class="flex items-center justify-center gap-2 sm:justify-start">
                        <h2 class="text-sm font-medium">Tutorial Completed</h2>
                        <LucideIconCn Name="sparkles" Size="14" Class="size-3.5 text-amber-500 fill-amber-500/20" />
                    </div>
                    <p class="text-xs text-muted-foreground">
                        You've successfully completed the "Quick Start" guide. You now have the
                        foundational knowledge to build amazing things.
                    </p>
                </div>
            </div>
        </div>

        @* Learned Concepts Section *@
        <div class="border-b px-4 py-5">
            <div class="flex items-center gap-2 mb-4">
                <LucideIconCn Name="book-open" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    What you've mastered
                </span>
            </div>
            <div class="grid gap-3">
                @foreach (var concept in _learnedConcepts)
                {
                    <div class="flex items-start gap-3 p-3 rounded-lg border bg-background">
                        <div class="flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/10 mt-0.5">
                            <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-500" />
                        </div>
                        <div>
                            <p class="text-xs font-medium">@concept.Title</p>
                            <p class="text-[10px] text-muted-foreground mt-0.5">@concept.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Next Resources Section *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center justify-between text-[11px] text-muted-foreground">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="play-circle" Size="14" Class="size-3.5" />
                    <span>
                        Next up: <span class="text-foreground font-medium">Advanced Workflows</span>
                    </span>
                </div>
                <span class="underline cursor-pointer">Explore Guides</span>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <span class="text-[10px] text-muted-foreground cursor-pointer hover:underline">
                Restart Tutorial
            </span>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5">
                <LucideIconCn Name="layout-dashboard" Size="12" Class="size-3" />
                Go to Dashboard
                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record LearnedConcept(string Title, string Description);

    private static readonly LearnedConcept[] _learnedConcepts =
    [
        new("Dashboard Navigation", "Finding your way around the core interface."),
        new("Team Collaboration",   "Inviting members and assigning workspace roles."),
        new("Advanced Search",      "Using filters and syntax to find data quickly."),
    ];
}
