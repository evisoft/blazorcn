@* ============================================================
   Block: success-sync-completed
   Title: SuccessSyncCompleted
   Description: React success block for data synchronization confirmation in Next.js, featuring last synced timestamps, health check status, and latency metrics using shadcn/ui and Tailwind CSS.
   Source: original/blocks/success/success-sync-completed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b p-4">
            <div class="flex items-center gap-2">
                <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                </div>
                <h1 class="font-medium text-sm">Synchronization complete</h1>
            </div>
            <div class="mt-1 flex items-center gap-1.5 text-muted-foreground text-xs">
                <span>@_syncData.Source</span>
                <LucideIconCn Name="arrow-right" Size="10" Class="size-2.5" />
                <span>@_syncData.Target</span>
            </div>
        </div>

        @* Sync Metrics *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Last Sync
                    </span>
                    <span class="mt-1 block font-medium text-xs">@_syncData.LastSync</span>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Latency
                    </span>
                    <div class="mt-1 flex items-center gap-1">
                        <LucideIconCn Name="zap" Size="12" Class="size-3 text-amber-500" />
                        <span class="font-medium text-xs tabular-nums">@_syncData.Latency</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Records Updated
                    </span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-medium text-xs">@_syncData.RecordsUpdated.ToString("N0")</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Data Health
                    </span>
                    <div class="mt-1 flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400">
                        <div class="size-1.5 rounded-full bg-current"></div>
                        <span class="font-medium text-xs">@($"{_syncData.HealthScore}%")</span>
                    </div>
                </div>
            </div>
        </div>

        @* Health Check Details *@
        <div class="border-b p-4">
            <div class="flex items-center justify-between mb-4">
                <h2 class="font-medium text-sm">Connection health</h2>
                <div class="flex items-center gap-1 text-[10px] text-muted-foreground uppercase tracking-wider">
                    <LucideIconCn Name="globe" Size="12" Class="size-3" />
                    Region: us-east-1
                </div>
            </div>
            <div class="grid gap-2">
                @foreach (var chk in _healthChecks)
                {
                    <div class="flex items-center justify-between rounded-md border bg-muted/10 px-3 py-2">
                        <span class="text-muted-foreground text-xs">@chk.Label</span>
                        <span class="font-medium text-xs text-foreground">@chk.Status</span>
                    </div>
                }
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="activity" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Monitoring active via Datadog</span>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 px-3 text-xs">
                    View Logs
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                    Sync Now
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record SyncInfo(string Source, string Target, string LastSync, string Latency, int RecordsUpdated, double HealthScore);
    private record HealthCheck(string Label, string Status);

    private static readonly SyncInfo _syncData = new(
        "Salesforce CRM",
        "Main Production DB",
        "Oct 24, 2025, 11:45 AM",
        "340ms",
        1240,
        99.8
    );

    private static readonly HealthCheck[] _healthChecks =
    [
        new("API Connectivity", "Optimal"),
        new("Schema Validation", "Passed"),
        new("Throughput Limit", "92% available"),
    ];
}
