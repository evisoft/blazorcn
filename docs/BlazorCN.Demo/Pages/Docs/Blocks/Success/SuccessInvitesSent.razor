@* ============================================================
   Block: success-invites-sent
   Title: SuccessInvitesSent
   Description: A summary block for team invitations, displaying the number of emails dispatched and their current status, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-invites-sent.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4 text-center sm:text-left">
            <div class="flex flex-col items-center gap-3 sm:flex-row">
                <div class="flex size-10 items-center justify-center rounded-full bg-blue-500/10">
                    <LucideIconCn Name="send" Size="20" Class="size-5 text-blue-500" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Invitations sent</h2>
                    <p class="mt-1 text-xs text-muted-foreground">
                        We&#39;ve successfully dispatched 12 invitations to your team members.
                    </p>
                </div>
            </div>
        </div>

        @* Summary Section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2 mb-4">
                <LucideIconCn Name="mail" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Recent dispatch status
                </span>
            </div>
            <div class="grid gap-3">
                @foreach (var invite in _invitations)
                {
                    <div class="flex items-center justify-between p-2 rounded-md border bg-muted/30">
                        <div class="flex items-center gap-3">
                            <div class="flex size-7 items-center justify-center rounded bg-background border">
                                <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground" />
                            </div>
                            <div class="space-y-0.5">
                                <p class="text-xs font-medium">@invite.Email</p>
                                <p class="text-[10px] text-muted-foreground">@invite.Time</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <div class="size-1.5 rounded-full @(invite.Status == "Delivered" ? "bg-emerald-500" : "bg-blue-500")"></div>
                            <span class="text-[10px] font-medium">@invite.Status</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Info Section *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                <p class="text-[11px] text-muted-foreground">
                    Invitees will receive an email with instructions on how to join your workspace.
                </p>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <p class="text-[10px] text-muted-foreground">Batch ID: #INV-9284</p>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5">
                Manage Team
                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Invitation(string Email, string Status, string Time);

    private static readonly Invitation[] _invitations =
    [
        new("alex.smith@example.com", "Sent",      "Just now"),
        new("sarah.j@company.org",    "Delivered", "2m ago"),
        new("dev-team@internal.io",   "Sent",      "5m ago"),
    ];
}
