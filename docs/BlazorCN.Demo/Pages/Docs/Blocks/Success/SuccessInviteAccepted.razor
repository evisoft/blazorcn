@* ============================================================
   Block: success-invite-accepted
   Title: SuccessInviteAccepted
   Description: A collaborative success block for when a new team member joins a workspace, featuring member details and immediate team actions, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-invite-accepted.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground shadow-sm">

        @* Member Join Hero *@
        <div class="border-b px-4 py-8 text-center sm:text-left bg-muted/30">
            <div class="flex flex-col items-center gap-5 sm:flex-row">
                <div class="relative">
                    <div class="flex size-16 items-center justify-center rounded-full bg-background border-2 border-emerald-500 overflow-hidden p-1">
                        <div class="flex size-full items-center justify-center rounded-full bg-emerald-500/10">
                            <LucideIconCn Name="user-plus" Size="32" Class="size-8 text-emerald-500" />
                        </div>
                    </div>
                    <div class="absolute -bottom-1 -right-1 flex size-6 items-center justify-center rounded-full bg-emerald-500 text-white border-2 border-background shadow-sm">
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                    </div>
                </div>
                <div class="flex-1 space-y-1 text-center sm:text-left">
                    <h2 class="text-sm font-medium">New Team Member Joined</h2>
                    <p class="text-xs text-muted-foreground">
                        Sarah Chen has successfully joined the
                        <span class="text-foreground font-medium">Marketing Strategy</span> workspace.
                    </p>
                </div>
            </div>
        </div>

        @* Member Details Section *@
        <div class="border-b px-4 py-5">
            <div class="flex items-center gap-2 mb-4">
                <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Member Configuration
                </span>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="flex items-center gap-3 p-3 rounded-lg border bg-background">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted/50">
                        <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
                    </div>
                    <div>
                        <p class="text-[10px] text-muted-foreground font-medium uppercase tracking-tight">
                            Role
                        </p>
                        <p class="text-xs font-semibold">Editor</p>
                    </div>
                </div>
                <div class="flex items-center gap-3 p-3 rounded-lg border bg-background">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted/50">
                        <LucideIconCn Name="mail" Size="16" Class="size-4 text-muted-foreground" />
                    </div>
                    <div class="flex-1 overflow-hidden">
                        <p class="text-[10px] text-muted-foreground font-medium uppercase tracking-tight">
                            Email
                        </p>
                        <p class="text-xs font-semibold truncate">sarah.c@@acme.corp</p>
                    </div>
                </div>
            </div>
        </div>

        @* Team Overview / Quick Action *@
        <div class="border-b px-4 py-3 bg-blue-500/5">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="flex -space-x-2">
                        @foreach (var i in new[] { 1, 2, 3 })
                        {
                            <div class="size-5 rounded-full border-2 border-background bg-muted"></div>
                        }
                    </div>
                    <p class="text-[11px] text-muted-foreground">
                        Sarah is the <span class="font-semibold text-foreground">12th member</span> to
                        join this workspace.
                    </p>
                </div>
                <span class="text-[10px] font-medium text-blue-600 cursor-pointer hover:underline">
                    Team View
                </span>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5 px-2 hover:bg-background">
                <LucideIconCn Name="settings" Size="12" Class="size-3" />
                Manage Roles
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5">
                Assign First Task
                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
            </ButtonCn>
        </div>

    </div>
</section>
