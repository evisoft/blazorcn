@* ============================================================
   Block: success-oncall-swapped
   Title: SuccessOncallSwapped
   Description: An incident response and operations success state for on-call shift swaps featuring PagerDuty integration status, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-oncall-swapped.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-emerald-500/10 shrink-0">
                    <LucideIconCn Name="arrow-left-right" Size="20" Class="size-5 text-emerald-500" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">On-call shift swap confirmed</h2>
                    <p class="mt-1 text-xs text-muted-foreground leading-snug">
                        Your shift for the 'Infrastructure' rotation has been successfully
                        swapped with Marcus Aurelius.
                    </p>
                </div>
            </div>
        </div>

        @* Swap Details *@
        <div class="border-b px-4 py-5">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-3">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                            Schedule Window
                        </span>
                    </div>
                    <div class="flex flex-col gap-1">
                        <span class="text-xs font-medium">Oct 26 — Oct 28, 2024</span>
                        <div class="flex items-center gap-1.5 text-[10px] text-muted-foreground">
                            <LucideIconCn Name="clock" Size="12" Class="size-3" />
                            <span>Start: 08:00 AM UTC</span>
                        </div>
                    </div>
                </div>
                <div class="space-y-3">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="user-check" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                            New Coverage
                        </span>
                    </div>
                    <div class="flex items-center gap-2.5 rounded border bg-muted/30 px-3 py-2">
                        <div class="size-1.5 rounded-full bg-emerald-500"></div>
                        <span class="text-xs font-medium">Marcus Aurelius (Primary)</span>
                    </div>
                </div>
            </div>
        </div>

        @* Integration Status *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10">
                        <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                    </div>
                    <span class="text-[11px] font-medium text-muted-foreground">
                        PagerDuty API Override Active
                    </span>
                </div>
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="bell-off" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-[10px] text-muted-foreground">Alerts Muted for You</span>
                </div>
            </div>
        </div>

        @* Footer Info *@
        <div class="bg-muted/50 px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-amber-600">
                    <LucideIconCn Name="alert-circle" Size="14" Class="size-3.5" />
                    <span class="text-[10px] font-medium">Ensure your partner is reachable</span>
                </div>
                <div class="flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                        View Rotation
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                        Back to Dashboard
                    </ButtonCn>
                </div>
            </div>
        </div>

    </div>
</section>
