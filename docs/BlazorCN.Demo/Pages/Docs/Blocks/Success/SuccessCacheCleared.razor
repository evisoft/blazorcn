@* ============================================================
   Block: success-cache-cleared
   Title: SuccessCacheCleared
   Description: React success block for edge cache invalidation confirmation in Next.js, featuring edge node status, invalidated paths summary, and propagation metrics using shadcn/ui and Tailwind CSS.
   Source: original/blocks/success/success-cache-cleared.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b p-4">
            <div class="flex items-center gap-2">
                <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                </div>
                <h1 class="font-medium text-sm">Cache invalidated</h1>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                All edge nodes have been purged successfully across @_cacheData.Regions global
                regions.
            </p>
        </div>

        @* Cache Metrics *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Purge Time
                    </span>
                    <span class="mt-1 block font-medium text-sm tabular-nums">
                        @_cacheData.PurgeTime
                    </span>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Edge Nodes
                    </span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-medium text-sm">@_cacheData.Nodes.ToString("N0")</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Propagation
                    </span>
                    <div class="mt-1 flex items-center gap-1 text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="wifi" Size="12" Class="size-3" />
                        <span class="font-medium text-xs">100%</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Method
                    </span>
                    <span class="mt-1 block font-medium text-[10px] uppercase tracking-tighter">
                        @_cacheData.MethodFirstWord
                    </span>
                </div>
            </div>
        </div>

        @* Region Grid *@
        <div class="border-b p-4">
            <h2 class="mb-3 font-medium text-sm">Regional PoP status</h2>
            <div class="grid grid-cols-3 gap-2 sm:grid-cols-6">
                @foreach (var pop in _popStatus)
                {
                    <div class="flex flex-col items-center justify-center rounded-md border bg-muted/20 py-2">
                        <span class="font-mono text-[10px] font-bold text-foreground">@pop.Code</span>
                        <div class="mt-1 size-1 rounded-full bg-emerald-500"></div>
                        <span class="mt-1 text-[8px] uppercase tracking-widest text-muted-foreground">
                            @pop.Status
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Paths Summary *@
        <div class="p-4">
            <div class="flex items-center gap-2 mb-3">
                <LucideIconCn Name="layers" Size="14" Class="size-3.5 text-muted-foreground" />
                <h2 class="font-medium text-sm">Invalidated paths</h2>
            </div>
            <div class="space-y-1.5">
                @foreach (var path in _cacheData.Paths)
                {
                    <div class="flex items-center gap-2 rounded-md bg-muted/50 px-2 py-1.5 font-mono text-[10px] text-foreground">
                        <div class="size-1 rounded-full bg-muted-foreground/30"></div>
                        @path
                    </div>
                }
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-between px-4 py-3 border-t">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="globe" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">CDN: Cloudflare Global</span>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                    Purge Again
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    <LucideIconCn Name="server" Size="12" Class="size-3" />
                    View Headers
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record CacheData(string[] Paths, int Regions, int Nodes, string PurgeTime, string Method)
    {
        public string MethodFirstWord => Method.Split(' ')[0];
    }

    private record PopEntry(string Code, string City, string Status);

    private static readonly CacheData _cacheData = new(
        Paths: ["/products/*", "/categories/electronics", "/static/v2/*"],
        Regions: 42,
        Nodes: 1240,
        PurgeTime: "120ms",
        Method: "Path-based Invalidation"
    );

    private static readonly PopEntry[] _popStatus =
    [
        new("LHR", "London",       "cleared"),
        new("JFK", "New York",     "cleared"),
        new("HKG", "Hong Kong",    "cleared"),
        new("SJC", "San Jose",     "cleared"),
        new("FRA", "Frankfurt",    "cleared"),
        new("SYD", "Sydney",       "cleared"),
    ];
}
