@* ============================================================
   Block: success-review-posted
   Title: SuccessReviewPosted
   Description: A sleek success block for confirming a product review submission, featuring the rating, a quote preview, and social sharing options, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-review-posted.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground shadow-sm">

        @* Top Celebration Header *@
        <div class="relative border-b bg-muted/30 px-4 py-8 text-center">
            <div class="absolute top-4 right-4">
                <LucideIconCn Name="heart" Size="16" Class="size-4 text-red-500 fill-red-500/20" />
            </div>
            <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-primary/10 ring-8 ring-primary/5">
                <LucideIconCn Name="star" Size="24" Class="size-6 text-primary fill-primary" />
            </div>
            <h2 class="text-sm font-medium">Review Posted Successfully!</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Your voice helps others make better decisions. Your review is now live and public.
            </p>
        </div>

        @* Rating & Content Preview *@
        <div class="border-b px-4 py-5">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <div class="flex items-center gap-1 mb-1">
                        @foreach (var star in new[] { 1, 2, 3, 4, 5 })
                        {
                            <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-primary text-primary" />
                        }
                    </div>
                    <p class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Your 5-Star Rating
                    </p>
                </div>
                <div class="h-px w-full bg-border sm:h-8 sm:w-px"></div>
                <div class="flex-1 max-w-sm">
                    <p class="text-xs italic text-muted-foreground leading-relaxed">
                        <LucideIconCn Name="message-square" Size="12" Class="inline-block size-3 mr-1 -mt-0.5 opacity-50" />
                        "The interface is incredibly intuitive and saved our team hours of work every week.
                        Highly recommend to any SaaS founder!"
                    </p>
                </div>
            </div>
        </div>

        @* Public Link Section *@
        <div class="border-b px-4 py-4">
            <p class="mb-2 text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                Share your review
            </p>
            <div class="flex items-center gap-2">
                <div class="flex h-9 flex-1 items-center gap-2 rounded-md border bg-muted/50 px-3 overflow-hidden">
                    <LucideIconCn Name="globe" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                    <p class="flex-1 truncate text-xs text-muted-foreground font-mono">
                        https://shadcn.io/reviews/alex-design-8291
                    </p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="size-9 shrink-0" aria-label="Copy">
                    <LucideIconCn Name="copy" Size="14" Class="size-3.5" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="size-9 shrink-0" aria-label="Open in new tab">
                    <LucideIconCn Name="external-link" Size="14" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>

        @* Social Sharing *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <div class="flex items-center gap-4">
                <span class="text-[10px] font-medium text-muted-foreground">Quick Share:</span>
                <div class="flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7 rounded-full hover:bg-sky-500/10 hover:text-sky-500" aria-label="Twitter">
                        <LucideIconCn Name="twitter" Size="14" Class="size-3.5" />
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7 rounded-full hover:bg-primary/10" aria-label="Share">
                        <LucideIconCn Name="share-2" Size="14" Class="size-3.5" />
                    </ButtonCn>
                </div>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-8 text-xs underline underline-offset-4">
                Write another review
            </ButtonCn>
        </div>

    </div>
</section>
