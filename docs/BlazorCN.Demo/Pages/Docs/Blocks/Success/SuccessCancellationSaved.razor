@* ============================================================
   Block: success-cancellation-saved
   Title: SuccessCancellationSaved
   Description: A respectful and empathetic success block for confirming subscription cancellation feedback, featuring a win-back offer and data retention info, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-cancellation-saved.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground shadow-sm">

        @* Header Section *@
        <div class="border-b px-4 py-6 text-center">
            <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-muted">
                <LucideIconCn Name="cloud-off" Size="24" Class="size-6 text-muted-foreground" />
            </div>
            <h2 class="text-sm font-medium">Cancellation Confirmed</h2>
            <p class="mt-1 text-xs text-muted-foreground max-w-sm mx-auto">
                Your subscription has been cancelled. We've recorded your feedback and will use it to
                improve the platform.
            </p>
        </div>

        @* Feedback Confirmation *@
        <div class="border-b px-4 py-4 bg-muted/20">
            <div class="flex items-start gap-4">
                <div class="flex size-8 shrink-0 items-center justify-center rounded-lg border bg-background">
                    <LucideIconCn Name="message-square" Size="16" Class="size-4 text-muted-foreground" />
                </div>
                <div class="space-y-1">
                    <p class="text-sm font-medium leading-none">Feedback Received</p>
                    <p class="text-xs text-muted-foreground leading-relaxed">
                        "Switching to a different tool that better fits our current team size." <br />
                        Our product team has been notified of your specific reasoning.
                    </p>
                </div>
            </div>
        </div>

        @* Data Retention Info *@
        <div class="border-b px-4 py-5">
            <div class="mb-4">
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    What happens now?
                </span>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="rounded-md border p-3">
                    <div class="flex items-center gap-2 mb-2">
                        <LucideIconCn Name="smile" Size="14" Class="size-3.5 text-blue-500" />
                        <p class="text-xs font-medium">Access remains</p>
                    </div>
                    <p class="text-[11px] text-muted-foreground">
                        You'll have full access to Pro features until the end of your billing cycle on June
                        12.
                    </p>
                </div>
                <div class="rounded-md border p-3">
                    <div class="flex items-center gap-2 mb-2">
                        <LucideIconCn Name="refresh-ccw" Size="14" Class="size-3.5 text-amber-500" />
                        <p class="text-xs font-medium">Data is safe</p>
                    </div>
                    <p class="text-[11px] text-muted-foreground">
                        We'll keep your projects and settings for 12 months in case you decide to return.
                    </p>
                </div>
            </div>
        </div>

        @* Win-back / Footer Section *@
        <div class="px-4 py-4 flex flex-col sm:flex-row items-center justify-between gap-4 bg-muted/50">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="heart" Size="14" Class="size-3.5 text-red-500" />
                <p class="text-[10px] text-muted-foreground">
                    Changed your mind? You can reactivate anytime.
                </p>
            </div>
            <div class="flex items-center gap-2 w-full sm:w-auto">
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 text-xs flex-1 sm:flex-initial">
                    Export My Data
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5 flex-1 sm:flex-initial">
                    Reactivate Subscription
                </ButtonCn>
            </div>
        </div>

        @* Status indicator *@
        <div class="px-4 py-2 border-t bg-muted/30">
            <div class="flex items-center gap-2 justify-center sm:justify-start">
                <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-500" />
                <p class="text-[10px] text-muted-foreground">Successfully Unsubscribed</p>
            </div>
        </div>

    </div>
</section>
