@* ============================================================
   Block: success-ticket-submitted
   Title: SuccessTicketSubmitted
   Description: A professional support success screen confirming ticket submission with ticket ID, expected SLA, and helpful resources, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-ticket-submitted.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground shadow-sm">

        @* Header Section *@
        <div class="border-b px-4 py-5 text-center sm:text-left">
            <div class="flex flex-col items-center gap-4 sm:flex-row">
                <div class="flex size-10 items-center justify-center rounded-full bg-primary/10">
                    <LucideIconCn Name="check-circle-2" Size="20" Class="size-5 text-primary" />
                </div>
                <div class="flex-1">
                    <h2 class="text-sm font-medium">Support Ticket Submitted</h2>
                    <p class="mt-1 text-xs text-muted-foreground">
                        We've received your request and our team is already on it. A confirmation email
                        has been sent to your inbox.
                    </p>
                </div>
                <div class="hidden sm:block">
                    <div class="rounded-md border bg-muted/50 px-2.5 py-1">
                        <p class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                            Ticket ID
                        </p>
                        <p class="text-sm font-mono font-bold">#TK-84291</p>
                    </div>
                </div>
            </div>
            <div class="mt-4 block sm:hidden">
                <div class="rounded-md border bg-muted/50 px-2.5 py-1">
                    <p class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Ticket ID
                    </p>
                    <p class="text-sm font-mono font-bold">#TK-84291</p>
                </div>
            </div>
        </div>

        @* SLA & Status Section *@
        <div class="border-b px-4 py-4 bg-muted/20">
            <div class="flex items-start gap-4">
                <div class="flex size-8 shrink-0 items-center justify-center rounded-lg border bg-background">
                    <LucideIconCn Name="clock" Size="16" Class="size-4 text-muted-foreground" />
                </div>
                <div class="space-y-1">
                    <p class="text-sm font-medium leading-none">Expected Response Time</p>
                    <p class="text-xs text-muted-foreground leading-relaxed">
                        Our current average response time for your plan is **under 4 hours**. You'll
                        receive an update as soon as a support specialist is assigned.
                    </p>
                </div>
            </div>
        </div>

        @* Resources Section *@
        <div class="border-b px-4 py-4">
            <div class="mb-4">
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    While you wait
                </span>
            </div>
            <div class="grid gap-3 sm:grid-cols-1">
                @foreach (var resource in _resources)
                {
                    <div class="flex items-center gap-4 rounded-md border p-3 transition-colors hover:bg-muted/50">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted">
                            <LucideIconCn Name="@resource.IconName" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="flex-1">
                            <p class="text-sm font-medium leading-none">@resource.Title</p>
                            <p class="mt-1 text-xs text-muted-foreground">@resource.Description</p>
                        </div>
                        <LucideIconCn Name="arrow-right" Size="12" Class="size-3 text-muted-foreground/50" />
                    </div>
                }
            </div>
        </div>

        @* Info Banner *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="mail" Size="14" Class="size-3.5 text-blue-500" />
                <p class="text-[11px] text-muted-foreground">
                    Didn't receive the email? Check your spam folder or <span class="underline cursor-pointer">resend confirmation</span>.
                </p>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
                <p class="text-[10px] text-muted-foreground">
                    System Status: All Systems Operational
                </p>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 text-xs gap-1.5">
                View My Tickets
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Resource(string Title, string Description, string IconName);

    private static readonly Resource[] _resources =
    [
        new("Help Center", "Browse our comprehensive guides and tutorials.", "help-circle"),
        new("Community Forum", "Ask questions and get answers from other users.", "message-square"),
        new("Service Status", "Check if there are any ongoing system outages.", "life-buoy"),
    ];
}
