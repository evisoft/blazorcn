@* ============================================================
   Block: success-referral-accepted
   Title: SuccessReferralAccepted
   Description: A celebratory success screen for confirming a successful referral, featuring bonus reward details and easy sharing actions, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-referral-accepted.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground shadow-sm">

        @* Celebration Header *@
        <div class="relative border-b px-4 py-8 text-center bg-gradient-to-b from-primary/5 to-transparent">
            <div class="mx-auto mb-4 flex size-14 items-center justify-center rounded-full bg-primary/10 ring-8 ring-primary/5">
                <LucideIconCn Name="users-2" Size="28" Class="size-7 text-primary" />
            </div>
            <h2 class="text-sm font-medium">Referral Successfully Confirmed!</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Your friend has joined the platform. As a thank you, we've applied a bonus to both of
                your accounts.
            </p>
            <div class="absolute top-4 right-4 animate-bounce">
                <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-amber-500" />
            </div>
        </div>

        @* Bonus Section *@
        <div class="border-b px-4 py-6 text-center">
            <div class="inline-flex items-center gap-3 rounded-full border bg-muted/50 px-4 py-2">
                <LucideIconCn Name="gift" Size="16" Class="size-4 text-primary" />
                <span class="text-sm font-bold">$20.00 Credit Applied</span>
            </div>
            <p class="mt-3 text-[10px] text-muted-foreground uppercase tracking-widest font-medium">
                Available on your next billing cycle
            </p>
        </div>

        @* Share Again Section *@
        <div class="border-b px-4 py-5">
            <div class="flex items-center justify-between mb-4">
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Keep the momentum going
                </span>
            </div>
            <div class="grid gap-3 sm:grid-cols-2">
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-10 text-xs gap-2 justify-start px-4">
                    <LucideIconCn Name="twitter" Size="14" Class="size-3.5 text-sky-500" />
                    Share on Twitter
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-10 text-xs gap-2 justify-start px-4">
                    <LucideIconCn Name="mail" Size="14" Class="size-3.5 text-muted-foreground" />
                    Invite by Email
                </ButtonCn>
            </div>
        </div>

        @* Referral Stats *@
        <div class="border-b px-4 py-4 bg-muted/30">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="size-8 rounded-md bg-background border flex items-center justify-center font-bold text-xs">
                        12
                    </div>
                    <p class="text-xs text-muted-foreground">Total friends referred to date</p>
                </div>
                <ButtonCn Variant="ButtonVariant.Link" Size="ButtonSize.Sm" Class="h-auto p-0 text-xs font-medium">
                    View Leaderboard
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500"></div>
                <p class="text-[10px] text-muted-foreground">Bonus active for June 2024</p>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5">
                Go to Credits
                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
            </ButtonCn>
        </div>

    </div>
</section>
