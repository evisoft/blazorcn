@* ============================================================
   Block: success-backup-restored
   Title: SuccessBackupRestored
   Description: React success block for database or file system restoration confirmation in Next.js, featuring data integrity checks, restoration timestamps, and source snapshot details using shadcn/ui and Tailwind CSS.
   Source: original/blocks/success/success-backup-restored.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b p-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="rotate-ccw" Size="14" Class="size-3.5" />
                    </div>
                    <h1 class="font-medium text-sm">System restored</h1>
                </div>
                <div class="flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[10px] font-bold uppercase tracking-wider">
                    <LucideIconCn Name="shield-check" Size="10" Class="size-2.5" />
                    Integrity Pass
                </div>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                The system has been successfully rolled back to the state recorded at
                <span class="text-foreground font-medium">@_restoreData.SnapshotDate</span>.
            </p>
        </div>

        @* Restore Stats *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Restore Time
                    </span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-medium text-sm">@_restoreData.Duration</span>
                        <span class="text-[10px] font-medium text-muted-foreground uppercase">min</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Integrity
                    </span>
                    <div class="mt-1 flex items-center gap-1 text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                        <span class="font-medium text-[10px] uppercase tracking-tighter">
                            @_restoreData.Integrity
                        </span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Target
                    </span>
                    <div class="mt-1 flex items-center gap-1">
                        <LucideIconCn Name="database" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="font-medium text-xs">@(_restoreData.Target.Split(" ")[2])</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Records
                    </span>
                    <div class="mt-1 flex items-center gap-1">
                        <LucideIconCn Name="timer" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="font-medium text-xs tabular-nums">4.2M</span>
                    </div>
                </div>
            </div>
        </div>

        @* Restore History *@
        <div class="border-b p-4">
            <div class="flex items-center gap-2 mb-3">
                <LucideIconCn Name="history" Size="14" Class="size-3.5 text-muted-foreground" />
                <h2 class="font-medium text-sm">Restoration source details</h2>
            </div>
            <div class="rounded-md border bg-muted/20 p-4">
                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-muted-foreground">Snapshot ID</span>
                        <span class="text-xs font-mono font-medium">@_restoreData.SnapshotId</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-muted-foreground">Region Source</span>
                        <span class="text-xs font-medium">us-east-1 (Primary)</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-muted-foreground">Encryption</span>
                        <span class="text-xs font-medium">AES-256-GCM</span>
                    </div>
                </div>
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2 text-muted-foreground">
                <LucideIconCn Name="activity" Size="14" Class="size-3.5" />
                <span class="text-xs italic">Awaiting service warm-up (30s)</span>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    Run Health Check
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-3 text-xs">
                    Go to Dashboard
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record RestoreData(
        string SnapshotId,
        string SnapshotDate,
        double Duration,
        string Integrity,
        string Target
    );

    private static readonly RestoreData _restoreData = new(
        SnapshotId: "snp_v82_prod_20251024",
        SnapshotDate: "Oct 24, 2025, 02:00 AM",
        Duration: 8.5,
        Integrity: "Verified (CRC32)",
        Target: "Production Cluster A"
    );
}
