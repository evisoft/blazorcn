@* ============================================================
   Block: success-subscription-upgraded
   Title: SuccessSubscriptionUpgraded
   Description: An interactive subscription upgrade success block featuring tier benefit highlights and celebratory confetti, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-subscription-upgraded.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10">
                    <div class="size-1.5 rounded-full bg-emerald-500"></div>
                </div>
                <h2 class="text-sm font-medium">Subscription upgraded</h2>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">
                You now have full access to all Pro features and higher usage limits.
            </p>
        </div>

        @* Benefits Section *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2 mb-3">
                <LucideIconCn Name="sparkles" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    New benefits unlocked
                </span>
            </div>
            <div class="grid gap-3 sm:grid-cols-2">
                @foreach (var benefit in _benefits)
                {
                    <div class="flex items-start gap-2">
                        <div class="mt-0.5 rounded-full bg-emerald-500/10 p-0.5">
                            <LucideIconCn Name="check" Size="10" Class="size-2.5 text-emerald-500" />
                        </div>
                        <span class="text-xs">@benefit</span>
                    </div>
                }
            </div>
        </div>

        @* Promotion Section *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded border bg-background shadow-sm">
                    <LucideIconCn Name="zap" Size="16" Class="size-4 text-emerald-500" />
                </div>
                <div>
                    <p class="text-sm font-medium">Start using AI features</p>
                    <p class="text-xs text-muted-foreground leading-snug">
                        Your Pro plan includes 1,000 AI credits per month to accelerate your workflow.
                    </p>
                </div>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-2.5 flex justify-end bg-muted/50">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                Enter Workspace
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private static readonly string[] _benefits =
    [
        "Unlimited workspace members",
        "Advanced analytics & reporting",
        "Custom domain integration",
        "Priority 24/7 support",
    ];
}
