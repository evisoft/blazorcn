@* ============================================================
   Block: success-team-workspace-created
   Title: SuccessTeamWorkspaceCreated
   Description: React success block for new team or organizational workspace creation in Next.js, featuring member counts, resource allocation, and initial setup status using shadcn/ui and Tailwind CSS.
   Source: original/blocks/success/success-team-workspace-created.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b p-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    </div>
                    <h1 class="font-medium text-sm">Workspace created</h1>
                </div>
                <div class="flex items-center gap-1 text-[10px] text-muted-foreground uppercase font-bold tracking-tighter">
                    <LucideIconCn Name="shield" Size="10" Class="size-2.5" />
                    Private
                </div>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Workspace <span class="font-medium text-foreground">@_workspace.Name</span>
                has been provisioned and is ready for your team.
            </p>
        </div>

        @* Workspace Stats *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Initial Members
                    </span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-medium text-sm">@_workspace.Members</span>
                        <span class="text-[10px] font-medium text-muted-foreground uppercase">User</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Project Limit
                    </span>
                    <div class="mt-1 flex items-center gap-1">
                        <LucideIconCn Name="layout-grid" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="font-medium text-xs">@_workspace.Projects Slots</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Allocated Space
                    </span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-medium text-xs">@_workspace.Storage</span>
                        <span class="text-[10px] font-medium text-muted-foreground uppercase">GB</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Environment
                    </span>
                    <span class="mt-1 block font-medium text-xs">Production</span>
                </div>
            </div>
        </div>

        @* Setup Progress *@
        <div class="border-b p-4">
            <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="settings" Size="14" Class="size-3.5 text-muted-foreground" />
                    <h2 class="font-medium text-sm">Initial configuration</h2>
                </div>
                <span class="text-[10px] font-mono text-muted-foreground">@(_workspace.SetupProgress)% Complete</span>
            </div>
            <div class="space-y-3">
                <div class="h-1.5 w-full bg-muted rounded-full overflow-hidden">
                    <div class="h-full bg-foreground" style="@($"width:{_workspace.SetupProgress}%")"></div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    @foreach (var step in _steps)
                    {
                        <div class="flex items-center gap-2 px-1">
                            <div class="@Cn.Merge("size-3.5 rounded-full border flex items-center justify-center", step.Done ? "bg-emerald-500 border-emerald-500 text-white" : "bg-transparent border-muted-foreground/30 text-transparent")">
                                <LucideIconCn Name="check" Size="10" Class="size-2.5" StrokeWidth="3" />
                            </div>
                            <span class="@Cn.Merge("text-xs", step.Done ? "text-foreground" : "text-muted-foreground")">
                                @step.Label
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs font-mono">@_workspace.Slug</span>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 px-3 text-xs">
                    Invite Team
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    Go to Workspace
                    <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record WorkspaceData(string Name, string Slug, int Members, int Projects, int Storage, int SetupProgress);

    private static readonly WorkspaceData _workspace = new(
        "Engineering Core",
        "engineering-core-92",
        1,
        5,
        10,
        60
    );

    private record SetupStep(string Label, bool Done);

    private static readonly SetupStep[] _steps =
    [
        new("Infrastructure Setup", true),
        new("Auth Provider Link", true),
        new("Invite Team Members", false),
        new("Connect Custom Domain", false),
    ];
}
