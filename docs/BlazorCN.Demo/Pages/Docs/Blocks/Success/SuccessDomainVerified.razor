@* ============================================================
   Block: success-domain-verified
   Title: SuccessDomainVerified
   Description: A technical success block for custom domain verification, featuring DNS propagation status and configuration details, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-domain-verified.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-emerald-500/10 shrink-0">
                    <LucideIconCn Name="globe" Size="20" Class="size-5 text-emerald-600" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Domain successfully verified</h2>
                    <p class="mt-1 text-xs text-muted-foreground leading-snug">
                        The DNS records for **acme.sh** have been correctly configured and verified.
                    </p>
                </div>
            </div>
        </div>

        @* Record Status Section *@
        <div class="border-b px-4 py-5">
            <div class="flex items-center gap-2 mb-4">
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Verified DNS Records
                </span>
            </div>
            <div class="space-y-2">
                @foreach (var rec in _records)
                {
                    <div class="flex items-center justify-between p-2 rounded border bg-muted/20">
                        <div class="flex items-center gap-3">
                            <div class="flex size-7 items-center justify-center rounded bg-background border font-mono text-[9px] font-bold">
                                @rec.RecordType
                            </div>
                            <div>
                                <p class="text-[10px] font-medium leading-none">@rec.RecordName</p>
                                <p class="text-[9px] text-muted-foreground mt-1 font-mono">
                                    @rec.RecordValue
                                </p>
                            </div>
                        </div>
                        <div class="flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20">
                            <LucideIconCn Name="check" Size="10" Class="size-2.5 text-emerald-600" />
                            <span class="text-[9px] font-medium text-emerald-700 uppercase tracking-tighter">
                                @rec.Status
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Benefits Section *@
        <div class="border-b px-4 py-4 bg-muted/30">
            <div class="grid grid-cols-2 gap-4">
                <div class="flex items-start gap-2.5">
                    <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 text-muted-foreground mt-0.5" />
                    <div>
                        <p class="text-[11px] font-medium">SSL Provisioned</p>
                        <p class="text-[10px] text-muted-foreground">Automatic certificate issued</p>
                    </div>
                </div>
                <div class="flex items-start gap-2.5">
                    <LucideIconCn Name="zap" Size="14" Class="size-3.5 text-muted-foreground mt-0.5" />
                    <div>
                        <p class="text-[11px] font-medium">Global CDN</p>
                        <p class="text-[10px] text-muted-foreground">Traffic routed via edge</p>
                    </div>
                </div>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5">
                <LucideIconCn Name="layout" Size="12" Class="size-3" />
                View Site
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs px-6">
                Domain Settings
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private sealed record DnsRecord(string RecordType, string RecordName, string RecordValue, string Status);

    private static readonly DnsRecord[] _records =
    [
        new("A", "@", "76.76.21.21", "Verified"),
        new("CNAME", "www", "cname.platform.com", "Verified"),
    ];
}
