@* ============================================================
   Block: success-bulk-purchase
   Title: SuccessBulkPurchase
   Description: React success summary block for bulk seat or license purchases in Next.js with a detailed seat allocation table, transaction details, and team onboarding steps using shadcn/ui and Tailwind CSS.
   Source: original/blocks/success/success-bulk-purchase.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b p-4">
            <div class="flex items-center gap-2">
                <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                </div>
                <h1 class="font-medium text-sm">Purchase successful</h1>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                12 seats have been added to your team workspace.
            </p>
        </div>

        @* Transaction Summary *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Transaction ID
                    </span>
                    <button
                        type="button"
                        @onclick="CopyTransactionId"
                        class="mt-1 flex items-center gap-1 font-mono text-xs transition-colors hover:text-foreground/80">
                        @(_purchaseId.Substring(0, 8))...
                        <LucideIconCn Name="copy" Size="10" Class="@Cn.Merge("size-2.5", _copied ? "text-emerald-500" : "")" />
                    </button>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Date
                    </span>
                    <span class="mt-1 block font-medium text-xs">@_purchaseDate</span>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Total Amount
                    </span>
                    <span class="mt-1 block font-medium text-xs">@_purchaseAmount</span>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Payment Method
                    </span>
                    <span class="mt-1 block font-medium text-xs">Visa @("••••") 4242</span>
                </div>
            </div>
        </div>

        @* Seats Table *@
        <div class="border-b">
            <div class="px-4 py-3">
                <h2 class="font-medium text-sm">Seat allocation</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="border-b bg-muted/50">
                            <th class="px-4 py-2 font-medium text-muted-foreground text-xs">Plan type</th>
                            <th class="px-4 py-2 font-medium text-muted-foreground text-xs text-right">Quantity</th>
                            <th class="px-4 py-2 font-medium text-muted-foreground text-xs text-right">Unit price</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y">
                        @foreach (var seat in _seats)
                        {
                            <tr class="text-xs transition-colors hover:bg-muted/30">
                                <td class="px-4 py-2.5 font-medium">@seat.Type</td>
                                <td class="px-4 py-2.5 text-right tabular-nums">@seat.Count</td>
                                <td class="px-4 py-2.5 text-right tabular-nums">@seat.Price</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Available to allocate immediately</span>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 px-3 text-xs">
                    View Receipt
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-3 text-xs">
                    Invite Team
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record SeatItem(string Id, string Type, int Count, string Price);

    private const string _purchaseId = "txn_8L2k9P1m0J5v";
    private const string _purchaseDate = "Oct 24, 2025";
    private const string _purchaseAmount = "$1,240.00";

    private static readonly SeatItem[] _seats =
    [
        new("1", "Pro Seat",   10, "$99.00/ea"),
        new("2", "Admin Seat",  2, "$125.00/ea"),
    ];

    private bool _copied = false;

    private async Task CopyTransactionId()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
