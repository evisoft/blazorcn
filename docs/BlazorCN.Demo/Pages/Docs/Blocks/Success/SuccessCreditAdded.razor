@* ============================================================
   Block: success-credit-added
   Title: SuccessCreditAdded
   Description: A dynamic wallet balance update block using @number-flow/react for smooth numeric transitions, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-credit-added.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10">
                    <div class="size-1.5 rounded-full bg-emerald-500"></div>
                </div>
                <h2 class="text-sm font-medium">Credits added to wallet</h2>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">
                Your transaction was successful and your balance is now updated.
            </p>
        </div>

        @* Balance Section *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2 mb-4">
                <LucideIconCn Name="wallet" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Current Balance
                </span>
            </div>
            <div class="flex items-center justify-center py-6">
                <div class="flex items-center gap-3">
                    <div class="text-2xl font-medium tracking-tight text-foreground">
                        $1,250.00
                    </div>
                    <div class="flex items-center gap-1 rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-medium text-emerald-600 border border-emerald-500/20">
                        <LucideIconCn Name="plus" Size="10" Class="size-2.5" />
                        <span>$250.00</span>
                    </div>
                </div>
            </div>
        </div>

        @* Info Section *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded border bg-background shadow-sm text-muted-foreground">
                    <LucideIconCn Name="coins" Size="16" Class="size-4" />
                </div>
                <div>
                    <p class="text-xs font-medium text-foreground">Credits expire in 12 months</p>
                    <p class="text-[10px] text-muted-foreground">
                        Your credits are valid for any usage across the platform.
                    </p>
                </div>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-2.5 flex justify-end bg-muted/50">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                Start using credits
            </ButtonCn>
        </div>

    </div>
</section>
