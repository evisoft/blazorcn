@* ============================================================
   Block: success-bulk-update
   Title: SuccessBulkUpdate
   Description: React success block for mass record updates in Next.js, featuring a counter of affected records, an undo action, and a summary of property changes using shadcn/ui and Tailwind CSS.
   Source: original/blocks/success/success-bulk-update.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b p-4">
            <div class="flex items-center gap-2">
                <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                </div>
                <h1 class="font-medium text-sm">Bulk update complete</h1>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Changes have been applied across
                <span class="text-foreground font-medium">@_category</span>.
            </p>
        </div>

        @* Affected Metric *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Records Affected
                    </span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-medium text-sm">@_recordsAffected.ToString("N0")</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Duration
                    </span>
                    <span class="mt-1 block font-medium text-xs tabular-nums">@_duration</span>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Consistency
                    </span>
                    <div class="mt-1 flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400">
                        <div class="size-1.5 rounded-full bg-current"></div>
                        <span class="font-medium text-xs">Strong</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Source
                    </span>
                    <span class="mt-1 block font-medium text-xs">Batch API</span>
                </div>
            </div>
        </div>

        @* Modifications Summary *@
        <div class="border-b p-4">
            <h2 class="mb-3 font-medium text-sm">Applied modifications</h2>
            <div class="grid gap-2">
                @foreach (var item in _fieldsModified)
                {
                    <div class="flex items-center justify-between rounded-md border bg-muted/10 px-3 py-2">
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="settings-2" Size="12" Class="size-3 text-muted-foreground" />
                            <span class="text-muted-foreground text-xs">@item.Field</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-[10px] text-muted-foreground">Set to</span>
                            <span class="font-medium text-xs text-foreground">@item.NewValue</span>
                        </div>
                    </div>
                }
            </div>
            <button type="button" class="mt-4 flex items-center gap-1 font-medium text-[11px] text-muted-foreground hover:text-foreground transition-colors">
                View affected record IDs
                <LucideIconCn Name="chevron-right" Size="12" Class="size-3" />
            </button>
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="layout-grid" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Database transaction closed</span>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    <LucideIconCn Name="rotate-ccw" Size="12" Class="size-3" />
                    Undo Changes
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    <LucideIconCn Name="history" Size="12" Class="size-3" />
                    Audit Log
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record FieldModification(string Field, string NewValue);

    private const int _recordsAffected = 1420;
    private const string _duration = "1.2s";
    private const string _category = "Inventory";

    private static readonly FieldModification[] _fieldsModified =
    [
        new("Status",      "Archived"),
        new("Modified By", "System (Auto)"),
    ];
}
