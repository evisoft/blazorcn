@* ============================================================
   Block: success-contract-generated
   Title: SuccessContractGenerated
   Description: A legal and operations success state for document generation featuring PDF previews and signature workflow status, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-contract-generated.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                    <LucideIconCn Name="file-check" Size="20" Class="size-5 text-emerald-500" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Contract successfully generated</h2>
                    <p class="mt-1 text-xs text-muted-foreground leading-snug">
                        The Master Service Agreement for Acme Corp is now ready. Review the draft below
                        before sending for signature.
                    </p>
                </div>
            </div>
        </div>

        @* Document Preview Card *@
        <div class="border-b px-4 py-5">
            <div class="flex items-center justify-between rounded-md border bg-muted/30 p-4">
                <div class="flex items-center gap-4">
                    <div class="relative flex size-12 items-center justify-center rounded border bg-card shadow-sm">
                        <LucideIconCn Name="file-text" Size="24" Class="size-6 text-muted-foreground" />
                        <div class="absolute -bottom-1 -right-1 flex size-5 items-center justify-center rounded-full border bg-emerald-500">
                            <LucideIconCn Name="check" Size="12" Class="size-3 text-white" />
                        </div>
                    </div>
                    <div>
                        <h3 class="text-xs font-medium">MSA_AcmeCorp_v2.pdf</h3>
                        <p class="text-[10px] text-muted-foreground">Generated today at 10:24 AM</p>
                    </div>
                </div>
                <div class="flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8">
                        <LucideIconCn Name="download" Size="14" Class="size-3.5" />
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8">
                        <LucideIconCn Name="share-2" Size="14" Class="size-3.5" />
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Signature Workflow *@
        <div class="border-b px-4 py-5">
            <div class="mb-4 flex items-center gap-2">
                <LucideIconCn Name="file-signature" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Signatory Requirements
                </span>
            </div>
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <div class="size-1.5 rounded-full bg-emerald-500"></div>
                        <span class="text-xs font-medium">John Doe (CEO, Acme Corp)</span>
                    </div>
                    <span class="text-[10px] text-muted-foreground">External Signer</span>
                </div>
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <div class="size-1.5 rounded-full bg-emerald-500"></div>
                        <span class="text-xs font-medium">Sarah Miller (VP Ops, Us)</span>
                    </div>
                    <span class="text-[10px] text-muted-foreground">Internal Signer</span>
                </div>
            </div>
        </div>

        @* Footer Actions *@
        <div class="bg-muted/50 px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 text-emerald-500" />
                    <span class="text-[10px] font-medium text-muted-foreground">
                        Document Verified &amp; Encrypted
                    </span>
                </div>
                <div class="flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                        Preview PDF
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                        Request Signatures
                    </ButtonCn>
                </div>
            </div>
        </div>

    </div>
</section>
