@* ============================================================
   Block: success-license-key-activated
   Title: SuccessLicenseKeyActivated
   Description: React success block for software license activation or seat entitlement confirmation in Next.js, featuring plan details, expiration dates, and active seat counts using shadcn/ui and Tailwind CSS.
   Source: original/blocks/success/success-license-key-activated.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b p-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                    </div>
                    <h1 class="font-medium text-sm">License activated</h1>
                </div>
                <div class="flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[10px] font-bold uppercase tracking-wider">
                    <LucideIconCn Name="shield-check" Size="10" Class="size-2.5" />
                    Verified
                </div>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Your entitlement for <span class="text-foreground font-medium">@_plan</span> is now linked
                to this organization.
            </p>
        </div>

        @* License Stats *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Seat Usage
                    </span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-medium text-sm">@_seatsUsed</span>
                        <span class="text-[10px] font-medium text-muted-foreground uppercase">
                            / @_seatsTotal
                        </span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Status
                    </span>
                    <div class="mt-1 flex items-center gap-1 text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="check-circle-2" Size="12" Class="size-3" />
                        <span class="font-medium text-xs">@_status</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Expires On
                    </span>
                    <span class="mt-1 block font-medium text-xs tabular-nums">@_expiresAt</span>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Key ID
                    </span>
                    <span class="mt-1 block font-mono text-[10px] font-medium text-muted-foreground">@_keyId</span>
                </div>
            </div>
        </div>

        @* Entitlement Summary *@
        <div class="border-b p-4">
            <div class="flex items-center gap-2 mb-3">
                <LucideIconCn Name="key" Size="14" Class="size-3.5 text-muted-foreground" />
                <h2 class="font-medium text-sm">Entitlement summary</h2>
            </div>
            <div class="space-y-2">
                @foreach (var feature in _features)
                {
                    <div class="flex items-center gap-2 text-xs">
                        <div class="size-1 rounded-full bg-foreground/50"></div>
                        <span class="text-muted-foreground">@feature</span>
                    </div>
                }
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2 text-muted-foreground">
                <LucideIconCn Name="users" Size="14" Class="size-3.5" />
                <span class="text-xs">38 seats remaining</span>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    <LucideIconCn Name="download" Size="12" Class="size-3" />
                    Proof of License
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-3 text-xs">
                    Manage Seats
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private const string _plan = "Enterprise Plus";
    private const int _seatsUsed = 12;
    private const int _seatsTotal = 50;
    private const string _expiresAt = "Oct 24, 2026";
    private const string _status = "Active";
    private const string _keyId = "928X";

    private static readonly string[] _features =
    [
        "High-Availability Cluster Support",
        "Advanced Audit Logging (24 months)",
        "Premium 24/7 Technical Support",
        "Unlimited API Integrations",
    ];
}
