@* ============================================================
   Block: success-account-created
   Title: SuccessAccountCreated
   Description: A comprehensive onboarding success block for new account creation, featuring a welcome message and a next-steps checklist, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-account-created.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4 text-center sm:text-left">
            <div class="flex flex-col items-center gap-3 sm:flex-row">
                <div class="flex size-10 items-center justify-center rounded-full bg-primary/10">
                    <LucideIconCn Name="rocket" Size="20" Class="size-5 text-primary" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Welcome to the platform</h2>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Your account has been created successfully. Let's get you started with a few quick
                        steps.
                    </p>
                </div>
            </div>
        </div>

        @* Steps Section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2 mb-4">
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Next steps to complete
                </span>
            </div>
            <div class="grid gap-4">
                @foreach (var step in _steps)
                {
                    <div class="flex items-start gap-4">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-lg border bg-muted/50">
                            <LucideIconCn Name="@step.Icon" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="flex-1 space-y-1">
                            <div class="flex items-center justify-between">
                                <p class="text-sm font-medium leading-none">@step.Title</p>
                                @if (step.Completed)
                                {
                                    <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-500" />
                                }
                            </div>
                            <p class="text-xs text-muted-foreground">@step.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Info Section *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-blue-500"></div>
                <p class="text-[11px] text-muted-foreground">
                    Need help? Check out our <span class="underline cursor-pointer">Quick Start Guide</span> or <span class="underline cursor-pointer">Contact Support</span>.
                </p>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <p class="text-[10px] text-muted-foreground">Account created on May 20, 2026</p>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5">
                Go to Dashboard
                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Step(string Title, string Description, string Icon, bool Completed);

    private static readonly Step[] _steps =
    [
        new("Verify your email", "We've sent a confirmation link to your inbox.", "mail", false),
        new("Complete your profile", "Add your name and photo to personalize your experience.", "shield-check", false),
        new("Invite your team", "Collaborate with others by sending workspace invites.", "user-plus", false),
    ];
}
