@* ============================================================
   Block: success-project-created
   Title: SuccessProjectCreated
   Description: A comprehensive success block for new project or workspace initialization, featuring repository links and quick-start commands, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-project-created.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4 text-center sm:text-left">
            <div class="flex flex-col items-center gap-3 sm:flex-row">
                <div class="flex size-10 items-center justify-center rounded-full bg-primary/10">
                    <LucideIconCn Name="folder-plus" Size="20" Class="size-5 text-primary" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Project "Acme-Dashboard" created</h2>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Your workspace has been successfully initialized and connected to GitHub.
                    </p>
                </div>
            </div>
        </div>

        @* Configuration Summary *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2 mb-4">
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Configuration details
                </span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                @foreach (var detail in _projectDetails)
                {
                    <div class="flex flex-col gap-1.5 p-3 rounded-md border bg-muted/30 text-center sm:text-left">
                        <div class="flex items-center justify-center sm:justify-start gap-2">
                            <LucideIconCn Name="@detail.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="text-[10px] text-muted-foreground">@detail.Label</span>
                        </div>
                        <p class="text-xs font-medium truncate">@detail.Value</p>
                    </div>
                }
            </div>
        </div>

        @* Quick Start Commands *@
        <div class="border-b px-4 py-4 bg-muted/30">
            <div class="flex items-center gap-2 mb-3">
                <LucideIconCn Name="terminal" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Get started locally
                </span>
            </div>
            <div class="space-y-2">
                <div class="flex items-center justify-between px-3 py-2 rounded border bg-background font-mono text-xs text-muted-foreground">
                    <span>git clone https://github.com/acme/dashboard.git</span>
                    <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                </div>
                <div class="flex items-center justify-between px-3 py-2 rounded border bg-background font-mono text-xs text-muted-foreground">
                    <span>cd acme-dashboard &amp;&amp; bun install</span>
                </div>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-3 flex items-center justify-between bg-muted/50">
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-emerald-500"></div>
                <p class="text-[10px] text-muted-foreground">Deployment: Live</p>
            </div>
            <div class="flex gap-2">
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 text-xs">
                    Project Settings
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Open Dashboard
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record ProjectDetail(string Label, string Value, string Icon);

    private static readonly ProjectDetail[] _projectDetails =
    [
        new("Repository", "shadcn/ui-blocks", "github"),
        new("Environment", "Production", "globe"),
        new("Framework", "Next.js 16 (App Router)", "layout"),
    ];
}
