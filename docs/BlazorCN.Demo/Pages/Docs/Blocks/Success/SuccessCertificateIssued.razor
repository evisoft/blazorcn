@* ============================================================
   Block: success-certificate-issued
   Title: SuccessCertificateIssued
   Description: A security-focused success block for SSL/TLS certificate issuance, featuring auto-renewal status and expiration tracking, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-certificate-issued.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-emerald-500/10">
                    <LucideIconCn Name="shield-check" Size="20" Class="size-5 text-emerald-500" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">SSL/TLS Certificate Issued</h2>
                    <p class="text-xs text-muted-foreground">
                        Your connection to shadcn.io is now fully encrypted.
                    </p>
                </div>
            </div>
        </div>

        @* Certificate Details *@
        <div class="border-b px-4 py-4">
            <div class="space-y-4">
                <div class="flex items-center justify-between p-3 rounded-md border bg-muted/30">
                    <div class="flex items-center gap-3">
                        <LucideIconCn Name="lock" Size="16" Class="size-4 text-muted-foreground" />
                        <div class="space-y-0.5">
                            <p class="text-xs font-medium">Encryption Strength</p>
                            <p class="text-[10px] text-muted-foreground">RSA 2048-bit (SHA-256)</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-2 py-0.5 border border-emerald-500/20">
                        <span class="text-[10px] font-medium text-emerald-600 dark:text-emerald-400">
                            Active
                        </span>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1.5">
                        <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                            Valid From
                        </span>
                        <div class="flex items-center gap-2 text-xs font-mono">
                            <LucideIconCn Name="calendar" Size="12" Class="size-3 text-muted-foreground" />
                            <span>Jun 01, 2026</span>
                        </div>
                    </div>
                    <div class="space-y-1.5">
                        <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                            Expires On
                        </span>
                        <div class="flex items-center gap-2 text-xs font-mono">
                            <LucideIconCn Name="calendar" Size="12" Class="size-3 text-muted-foreground" />
                            <span>Aug 30, 2026</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Auto-renewal Notice *@
        <div class="border-b px-4 py-3 bg-muted/30 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="refresh-cw" Size="14" Class="size-3.5 text-blue-500 animate-spin-slow" />
                <p class="text-[11px] text-muted-foreground">
                    Auto-renewal is enabled and managed by Let's Encrypt.
                </p>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3 bg-muted/50">
            <p class="text-[10px] text-muted-foreground">ID: cert_82f19a2b</p>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5">
                    View JSON
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5">
                    Domain Settings
                    <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>
