@* ============================================================
   Block: success-settings-saved
   Title: SuccessSettingsSaved
   Description: React success block for global preferences or system settings update confirmation in Next.js, featuring change summaries, propagation status, and versioning details using shadcn/ui and Tailwind CSS.
   Source: original/blocks/success/success-settings-saved.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b p-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                    </div>
                    <h1 class="font-medium text-sm">Settings saved successfully</h1>
                </div>
                <span class="font-mono text-[10px] text-muted-foreground bg-muted px-1.5 py-0.5 rounded">
                    @_version
                </span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Global preferences have been updated and are now live across all production nodes.
            </p>
        </div>

        @* Sync Stats *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Changes Applied
                    </span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-medium text-sm">@_changes</span>
                        <span class="text-[10px] font-medium text-muted-foreground uppercase">
                            Fields
                        </span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Active Nodes
                    </span>
                    <div class="mt-1 flex items-center gap-1">
                        <LucideIconCn Name="globe" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="font-medium text-xs">@_nodes</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Propagation
                    </span>
                    <div class="mt-1 flex items-center gap-1 text-emerald-600 dark:text-emerald-400">
                        <span class="font-medium text-xs">@_propagation%</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Timestamp
                    </span>
                    <span class="mt-1 block font-medium text-xs tabular-nums">
                        @(_updatedAt.Split(',')[1])
                    </span>
                </div>
            </div>
        </div>

        @* Change Summary *@
        <div class="border-b p-4">
            <div class="flex items-center gap-2 mb-3">
                <LucideIconCn Name="settings-2" Size="14" Class="size-3.5 text-muted-foreground" />
                <h2 class="font-medium text-sm">Change summary</h2>
            </div>
            <div class="space-y-2">
                @foreach (var change in _changes_list)
                {
                    <div class="flex items-center justify-between rounded-md border bg-muted/20 px-3 py-2">
                        <span class="text-xs font-medium">@change.Label</span>
                        <div class="flex items-center gap-2 text-[10px]">
                            <span class="text-muted-foreground line-through">@change.From</span>
                            <span class="text-muted-foreground">→</span>
                            <span class="text-foreground font-medium">@change.To</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="history" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Last change by admin_jane</span>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    <LucideIconCn Name="undo-2" Size="12" Class="size-3" />
                    Rollback
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                    Force Sync
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record ChangeItem(string Label, string From, string To);

    private const string _version = "v2.8.45";
    private const string _updatedAt = "Oct 24, 2025, 10:15 AM";
    private const int _changes = 4;
    private const int _nodes = 12;
    private const int _propagation = 100;

    private static readonly ChangeItem[] _changes_list =
    [
        new("Session Timeout", "15m", "30m"),
        new("API Rate Limit", "1,000", "5,000"),
        new("Audit Logging", "Disabled", "Enabled"),
    ];
}
