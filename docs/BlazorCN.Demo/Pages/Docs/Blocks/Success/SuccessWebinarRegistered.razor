@* ============================================================
   Block: success-webinar-registered
   Title: SuccessWebinarRegistered
   Description: A marketing success block for webinar registrations, featuring event details and calendar integration, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-webinar-registered.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header *@
        <div class="border-b px-4 py-4">
            <div class="flex flex-col items-center gap-3 sm:flex-row">
                <div class="flex size-10 items-center justify-center rounded-full bg-muted">
                    <LucideIconCn Name="video" Size="20" Class="size-5 text-foreground" />
                </div>
                <div class="flex-1 text-center sm:text-left">
                    <h2 class="text-sm font-medium">Registration Confirmed</h2>
                    <p class="mt-1 text-xs text-muted-foreground">
                        You are registered for &quot;Scaling Your SaaS in 2025: Expert Strategies&quot;.
                    </p>
                </div>
            </div>
        </div>

        @* Event Meta *@
        <div class="border-b px-4 py-4 grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="space-y-1">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Time
                    </span>
                </div>
                <p class="text-xs font-medium">Nov 12, 11:00 AM EST</p>
            </div>
            <div class="space-y-1">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="map-pin" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Location
                    </span>
                </div>
                <p class="text-xs font-medium">Online (Live Stream)</p>
            </div>
            <div class="space-y-1">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="video" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Format
                    </span>
                </div>
                <p class="text-xs font-medium">Interactive Workshop</p>
            </div>
        </div>

        @* Link Section *@
        <div class="border-b px-4 py-4 bg-muted/30">
            <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="link-2" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Access Link
                    </span>
                </div>
            </div>
            <div class="flex items-center gap-2 p-2 rounded border bg-background">
                <code class="flex-1 text-[11px] font-mono text-muted-foreground overflow-hidden truncate">
                    https://webinar.acme.com/join/saas-2025-x92
                </code>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-[10px] px-2">
                    Copy Link
                </ButtonCn>
            </div>
        </div>

        @* Calendar Integration *@
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 px-4 py-3 bg-muted/50">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calendar-plus" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-xs font-medium">Save to your calendar</span>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs px-3">
                    Google
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs px-3">
                    Outlook
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs px-3">
                    Apple
                </ButtonCn>
            </div>
        </div>

    </div>
</section>
