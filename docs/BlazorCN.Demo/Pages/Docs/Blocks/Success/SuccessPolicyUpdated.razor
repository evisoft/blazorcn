@* ============================================================
   Block: success-policy-updated
   Title: SuccessPolicyUpdated
   Description: React success block for organizational policy or compliance update confirmation in Next.js, featuring scope summary, enforcement status, and acknowledgment tracking using shadcn/ui and Tailwind CSS.
   Source: original/blocks/success/success-policy-updated.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b p-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                    </div>
                    <h1 class="font-medium text-sm">Policy updated successfully</h1>
                </div>
                <span class="font-mono text-[10px] text-muted-foreground bg-muted px-1.5 py-0.5 rounded">
                    @_policyId
                </span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                The updated Security and Privacy policy has been published and is now the active
                standard.
            </p>
        </div>

        @* Policy Stats *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Effective
                    </span>
                    <div class="mt-1 flex items-center gap-1 text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="shield-check" Size="12" Class="size-3" />
                        <span class="font-medium text-xs">@_effectiveDate</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Scope
                    </span>
                    <span class="mt-1 block font-medium text-xs">@_scope</span>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Acknowledged
                    </span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-medium text-sm">@_acknowledged</span>
                        <span class="text-[10px] font-medium text-muted-foreground uppercase">%</span>
                    </div>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Total Reach
                    </span>
                    <div class="mt-1 flex items-center gap-1">
                        <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="font-medium text-xs tabular-nums">@_totalUsers</span>
                    </div>
                </div>
            </div>
        </div>

        @* Key Changes Section *@
        <div class="border-b p-4">
            <div class="flex items-center gap-2 mb-3">
                <LucideIconCn Name="file-check" Size="14" Class="size-3.5 text-muted-foreground" />
                <h2 class="font-medium text-sm">Key changes summary</h2>
            </div>
            <div class="space-y-3">
                <div class="rounded-md border bg-muted/20 p-3">
                    <h3 class="text-xs font-medium mb-1">Data Retention</h3>
                    <p class="text-[11px] text-muted-foreground leading-relaxed">
                        Retention period for inactive user logs increased from 12 to 24 months for
                        compliance with new regional regulations.
                    </p>
                </div>
                <div class="rounded-md border bg-muted/20 p-3">
                    <h3 class="text-xs font-medium mb-1">Password Complexity</h3>
                    <p class="text-[11px] text-muted-foreground leading-relaxed">
                        Minimum character length increased to 14. Support for biometric MFA added as a
                        primary authentication factor.
                    </p>
                </div>
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2 text-muted-foreground">
                <span class="text-xs italic">Awaiting compliance team final sign-off</span>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    <LucideIconCn Name="download" Size="12" Class="size-3" />
                    Download PDF
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    <LucideIconCn Name="mail" Size="12" Class="size-3" />
                    Notify Team
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private const string _policyId = "POL-SEC-2025-V4";
    private const string _effectiveDate = "Immediate";
    private const string _scope = "All Employees";
    private const int _acknowledged = 0;
    private const int _totalUsers = 1240;
}
