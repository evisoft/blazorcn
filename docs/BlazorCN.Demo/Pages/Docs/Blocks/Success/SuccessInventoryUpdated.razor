@* ============================================================
   Block: success-inventory-updated
   Title: SuccessInventoryUpdated
   Description: A logistics and operations success state for warehouse management featuring stock level adjustments and SKU availability, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-inventory-updated.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-emerald-500/10 shrink-0">
                    <LucideIconCn Name="package" Size="20" Class="size-5 text-emerald-500" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Inventory successfully updated</h2>
                    <p class="mt-1 text-xs text-muted-foreground leading-snug">
                        Stock levels for Batch #884 have been synchronized. All sales channels have been
                        notified of the new availability.
                    </p>
                </div>
            </div>
        </div>

        @* Warehouse Context *@
        <div class="border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="warehouse" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Location: Primary DC (San Francisco)
                    </span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="refresh-cw" Size="12" Class="size-3 text-emerald-500 animate-spin-slow" />
                    <span class="text-[10px] text-muted-foreground">Channel Sync Live</span>
                </div>
            </div>
        </div>

        @* Adjustment Table *@
        <div class="border-b px-4 py-5">
            <div class="mb-4 flex items-center gap-2">
                <LucideIconCn Name="archive" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    SKU Adjustments
                </span>
            </div>
            <div class="space-y-2">
                @foreach (var item in _adjustments)
                {
                    <div class="flex items-center justify-between rounded border px-3 py-2">
                        <div>
                            <div class="text-xs font-medium">@item.Name</div>
                            <div class="text-[10px] text-muted-foreground font-mono">@item.Sku</div>
                        </div>
                        <div class="text-right">
                            <div class="flex items-center justify-end gap-1 text-xs font-bold text-emerald-600">
                                <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3" />
                                <span>@item.Change</span>
                            </div>
                            <div class="text-[10px] text-muted-foreground font-medium">
                                New Total: @item.Total
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer Actions *@
        <div class="bg-muted/50 px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500" />
                    <span class="text-[11px] font-medium text-muted-foreground">
                        Audit Log: #INV-BATCH-2490
                    </span>
                </div>
                <div class="flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                        Export Log
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                        Manage Inventory
                    </ButtonCn>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private record Adjustment(string Sku, string Name, string Change, string Total);

    private static readonly Adjustment[] _adjustments =
    [
        new("LNR-BLK-MD", "Linear Tee (Black, M)", "+50", "142"),
        new("LNR-WHT-LG", "Linear Tee (White, L)", "+25", "88"),
    ];
}
