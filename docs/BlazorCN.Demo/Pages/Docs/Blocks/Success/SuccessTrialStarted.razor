@* ============================================================
   Block: success-trial-started
   Title: SuccessTrialStarted
   Description: React success block for SaaS trial initiations in Next.js with a countdown to first billing, feature checklist, and immediate next steps using shadcn/ui and Tailwind CSS.
   Source: original/blocks/success/success-trial-started.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header - Trial Countdown *@
        <div class="border-b bg-muted/30 px-4 py-5 text-center">
            <div class="mx-auto mb-3 flex size-10 items-center justify-center rounded-full bg-primary/10 text-primary">
                <LucideIconCn Name="rocket" Size="20" Class="size-5" />
            </div>
            <h1 class="font-medium text-sm">
                Your @(_daysRemaining)-day trial has started
            </h1>
            <p class="mt-1 text-muted-foreground text-xs">
                Full access to all @(_plan) features until @(_endDate).
            </p>
            <div class="mt-4 flex justify-center gap-2">
                @for (int i = 0; i < _daysRemaining; i++)
                {
                    <div class="@Cn.Merge("h-1.5 w-6 rounded-full", i == 0 ? "bg-emerald-500" : "bg-muted-foreground/20")"></div>
                }
            </div>
            <p class="mt-2 text-[10px] text-muted-foreground uppercase tracking-wider">
                Day 1 of @_daysRemaining
            </p>
        </div>

        @* Unlocked Features *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2 px-1 mb-3">
                <LucideIconCn Name="sparkles" Size="14" Class="size-3.5 text-amber-500" />
                <h2 class="font-medium text-xs uppercase tracking-wider">
                    Premium features unlocked
                </h2>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div class="flex items-center gap-2.5 rounded-md border bg-muted/20 p-2.5">
                    <LucideIconCn Name="zap" Size="14" Class="size-3.5 text-blue-500" />
                    <span class="text-xs">Advanced Analytics</span>
                </div>
                <div class="flex items-center gap-2.5 rounded-md border bg-muted/20 p-2.5">
                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500" />
                    <span class="text-xs">Custom Domains</span>
                </div>
            </div>
        </div>

        @* Onboarding Checklist *@
        <div class="px-4 py-5">
            <h2 class="mb-4 font-medium text-sm">Next steps for success</h2>
            <div class="space-y-3">
                @foreach (var item in _onboarding)
                {
                    <div class="flex items-center justify-between rounded-lg border px-3 py-2.5 transition-colors hover:bg-muted/30">
                        <div class="flex items-center gap-3">
                            <div class="@Cn.Merge("flex size-5 items-center justify-center rounded-full border", item.Completed ? "bg-emerald-500 border-emerald-500 text-white" : "border-muted-foreground/30")">
                                @if (item.Completed)
                                {
                                    <LucideIconCn Name="check-circle-2" Size="12" Class="size-3" />
                                }
                            </div>
                            <span class="@Cn.Merge("text-xs", item.Completed ? "text-muted-foreground line-through" : "font-medium")">
                                @item.Task
                            </span>
                        </div>
                        @if (!item.Completed)
                        {
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-[10px]">
                                Go
                                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
                            </ButtonCn>
                        }
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t bg-muted/10 px-4 py-3">
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-normal">
                    Trialing
                </BadgeCn>
                <span class="text-muted-foreground text-[11px]">Billing starts Nov 07</span>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-4 text-xs">
                Explore Dashboard
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record OnboardingTask(string Id, string Task, bool Completed);

    private static readonly int _daysRemaining = 14;
    private static readonly string _plan = "Pro Annual";
    private static readonly string _endDate = "Nov 07, 2025";

    private static readonly OnboardingTask[] _onboarding =
    [
        new("1", "Connect your first data source", true),
        new("2", "Invite at least one team member", false),
        new("3", "Set up your primary dashboard", false),
    ];
}
