@code {
    private const string Success2faEnabledCode = @"<section class=""mx-auto w-full max-w-2xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card text-card-foreground"">

        @* Header Section *@
        <div class=""border-b px-4 py-4"">
            <div class=""flex items-center gap-3"">
                <div class=""flex size-10 items-center justify-center rounded-full bg-emerald-500/10 shrink-0"">
                    <LucideIconCn Name=""shield-check"" Size=""20"" Class=""size-5 text-emerald-500"" />
                </div>
                <div>
                    <h2 class=""text-sm font-medium"">Two-factor authentication enabled</h2>
                    <p class=""mt-1 text-xs text-muted-foreground leading-snug"">
                        Your account is now protected with an extra layer of security. Use your
                        authenticator app to log in.
                    </p>
                </div>
            </div>
        </div>

        @* Recovery Codes Section *@
        <div class=""border-b px-4 py-5"">
            <div class=""flex items-center justify-between mb-4"">
                <div class=""flex items-center gap-2"">
                    <LucideIconCn Name=""smartphone"" Size=""14"" Class=""size-3.5 text-muted-foreground"" />
                    <span class=""text-[10px] font-medium uppercase tracking-wider text-muted-foreground"">
                        Backup recovery codes
                    </span>
                </div>
                <div class=""flex items-center gap-2"">
