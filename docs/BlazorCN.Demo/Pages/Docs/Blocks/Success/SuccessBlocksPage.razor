@code {
    private int _countdown = 5;
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ =>
        {
            if (_countdown > 0)
            {
                _countdown--;
                InvokeAsync(StateHasChanged);
            }
            else
            {
                _timer?.Dispose();
                _timer = null;
            }
        }, null, 1000, 1000);
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _timer = null;
    }
}";

