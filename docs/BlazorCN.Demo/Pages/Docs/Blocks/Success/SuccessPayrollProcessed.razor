@* ============================================================
   Block: success-payroll-processed
   Title: SuccessPayrollProcessed
   Description: A financial and HR operations success state for payroll cycles featuring earning statement access and deposit scheduling, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-payroll-processed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-emerald-500/10 shrink-0">
                    <LucideIconCn Name="banknote" Size="20" Class="size-5 text-emerald-500" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Payroll processed successfully</h2>
                    <p class="mt-1 text-xs text-muted-foreground leading-snug">
                        Your earning statement for Oct 1 — Oct 15 is now available. Your net pay will be
                        deposited into your primary account.
                    </p>
                </div>
            </div>
        </div>

        @* Payment Summary *@
        <div class="border-b px-4 py-5">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-3">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                            Deposit Date
                        </span>
                    </div>
                    <div class="flex items-center gap-2 text-xs font-medium">
                        <span>Friday, Oct 25, 2024</span>
                    </div>
                </div>
                <div class="space-y-3">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="landmark" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                            Destination
                        </span>
                    </div>
                    <div class="flex items-center gap-2 text-xs font-medium">
                        <span>CHASE BANK (•••• 8821)</span>
                    </div>
                </div>
            </div>
        </div>

        @* Earning Statement Preview *@
        <div class="border-b px-4 py-5">
            <div class="mb-4 flex items-center gap-2">
                <LucideIconCn Name="file-text" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Statement Summary
                </span>
            </div>
            <div class="space-y-3">
                <div class="flex items-center justify-between rounded border bg-muted/30 px-3 py-2">
                    <span class="text-xs text-muted-foreground">Gross Earnings</span>
                    <span class="text-xs font-medium">$5,240.00</span>
                </div>
                <div class="flex items-center justify-between rounded border bg-muted/30 px-3 py-2">
                    <span class="text-xs text-muted-foreground">Taxes &amp; Deductions</span>
                    <span class="text-xs font-medium text-red-500">-$1,412.30</span>
                </div>
                <div class="flex items-center justify-between rounded border bg-emerald-500/5 px-3 py-2 border-emerald-500/10">
                    <span class="text-xs font-medium">Net Pay</span>
                    <span class="text-sm font-bold text-emerald-600">$3,827.70</span>
                </div>
            </div>
        </div>

        @* Footer Actions *@
        <div class="bg-muted/50 px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="piggy-bank" Size="14" Class="size-3.5 text-emerald-500" />
                    <span class="text-[11px] font-medium text-muted-foreground">
                        Automatic Savings Contribution Active
                    </span>
                </div>
                <div class="flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                        View History
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs gap-2">
                        <LucideIconCn Name="download" Size="12" Class="size-3" />
                        Download PDF
                    </ButtonCn>
                </div>
            </div>
        </div>

    </div>
</section>
