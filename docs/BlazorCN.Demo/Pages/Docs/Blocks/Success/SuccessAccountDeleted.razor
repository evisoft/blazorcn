@* ============================================================
   Block: success-account-deleted
   Title: SuccessAccountDeleted
   Description: A respectful and clear success block for account termination, featuring a data removal timeline and final goodbye message, built with React, Next.js, and shadcn/ui.
   Source: original/blocks/success/success-account-deleted.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-card-foreground">

        @* Header Section *@
        <div class="border-b px-4 py-8 text-center">
            <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-red-500/10 mb-4">
                <LucideIconCn Name="heart" Size="24" Class="size-6 text-red-500" />
            </div>
            <h2 class="text-sm font-medium text-foreground">Account deletion scheduled</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                We've received your request to delete your account. Thank you for being a part of our
                community.
            </p>
        </div>

        @* Removal Timeline *@
        <div class="border-b px-4 py-6 bg-muted/20">
            <div class="flex items-center gap-2 mb-6">
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Removal Timeline
                </span>
            </div>
            <div class="relative flex justify-between px-4">
                <div class="absolute top-4 left-0 right-0 h-px bg-border -z-10 mx-8"></div>
                @foreach (var step in _timeline)
                {
                    var circleClass = Cn.Merge("flex size-8 items-center justify-center rounded-full border bg-background", step.IsFirst ? "border-red-500/50" : "");
                    var iconClass = Cn.Merge("size-3.5", step.IsFirst ? "text-red-500" : "text-muted-foreground");
                    <div class="flex flex-col items-center text-center gap-2 group">
                        <div class="@circleClass">
                            <LucideIconCn Name="@step.Icon" Size="14" Class="@iconClass" />
                        </div>
                        <div>
                            <p class="text-[10px] font-medium leading-none">@step.Label</p>
                            <p class="text-[9px] text-muted-foreground mt-1 uppercase tracking-tighter">
                                @step.Time
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Important Info *@
        <div class="border-b px-4 py-4">
            <div class="flex items-start gap-3 rounded-lg border bg-muted/30 p-3">
                <LucideIconCn Name="info" Size="14" Class="size-3.5 text-muted-foreground shrink-0 mt-0.5" />
                <p class="text-[11px] text-muted-foreground leading-normal">
                    You will receive a final confirmation email once all your data has been permanently
                    removed from our systems. If this was a mistake, please
                    <span class="underline cursor-pointer">contact support</span> within the next 14
                    days.
                </p>
            </div>
        </div>

        @* Footer Section *@
        <div class="px-4 py-3 flex justify-center bg-muted/50">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs px-8">
                Return to Homepage
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record TimelineStep(string Label, string Time, string Icon, bool IsFirst);

    private static readonly TimelineStep[] _timeline =
    [
        new("Account Deactivated", "Immediate", "trash-2", true),
        new("Data Removal Starts", "In 14 days", "clock", false),
        new("Permanent Deletion", "In 30 days", "archive", false),
    ];
}
