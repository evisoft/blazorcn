@* ============================================================
   Block: success-export-ready
   Title: SuccessExportReady
   Description: React success block for data export completion in Next.js, featuring a secure download link, expiration notice, and file metadata summary using shadcn/ui and Tailwind CSS.
   Source: original/blocks/success/success-export-ready.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b p-4">
            <div class="flex items-center gap-2">
                <div class="flex size-6 items-center justify-center rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400">
                    <LucideIconCn Name="shield-check" Size="14" Class="size-3.5" />
                </div>
                <h1 class="font-medium text-sm">Export ready</h1>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Your requested archive has been generated and is ready for secure download.
            </p>
        </div>

        @* File Metadata *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        File Size
                    </span>
                    <span class="mt-1 block font-medium text-sm">@_size</span>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Format
                    </span>
                    <span class="mt-1 block font-medium text-sm">@_format</span>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Records
                    </span>
                    <span class="mt-1 block font-medium text-sm tabular-nums">@_records.ToString("N0")</span>
                </div>
                <div>
                    <span class="block text-muted-foreground text-[10px] uppercase tracking-wider">
                        Secure Link
                    </span>
                    <div class="mt-1 flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400">
                        <div class="size-1.5 rounded-full bg-current"></div>
                        <span class="font-medium text-[11px] uppercase tracking-tighter">Active</span>
                    </div>
                </div>
            </div>
        </div>

        @* Download Section *@
        <div class="border-b p-6">
            <div class="flex flex-col items-center justify-center rounded-lg border border-dashed p-8 text-center">
                <div class="mb-4 flex size-12 items-center justify-center rounded-full bg-muted">
                    <LucideIconCn Name="file" Size="24" Class="size-6 text-muted-foreground" />
                </div>
                <h2 class="mb-1 font-medium text-sm">@_filename</h2>
                <p class="mb-6 max-w-[280px] text-muted-foreground text-xs">
                    This download link is temporary and will expire for security reasons.
                </p>
                <ButtonCn Class="h-9 gap-2 px-6 text-xs">
                    <LucideIconCn Name="download" Size="14" Class="size-3.5" />
                    Download Archive
                </ButtonCn>
            </div>
        </div>

        @* Expiration Notice *@
        <div class="border-b bg-amber-500/5 px-4 py-2.5">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-amber-600 dark:text-amber-400" />
                <span class="text-amber-700 text-xs dark:text-amber-300">
                    Link expires on <span class="font-medium">@_expiresAt</span>
                </span>
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="hard-drive" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Generated on Edge Node (IAD)</span>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 px-3 text-xs gap-1.5">
                    <LucideIconCn Name="refresh-ccw" Size="12" Class="size-3" />
                    New Export
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private const string _filename = "user_audit_logs_2025_q4.zip";
    private const string _size = "142.5 MB";
    private const string _format = "ZIP Archive";
    private const string _expiresAt = "Oct 24, 2025, 2:00 PM";
    private const int _records = 48200;
}
