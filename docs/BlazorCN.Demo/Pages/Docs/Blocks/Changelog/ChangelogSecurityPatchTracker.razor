@* ============================================================
   Block: changelog-security-patch-tracker
   Title: ChangelogSecurityPatchTracker
   Description: CVE tracking with severity badges, patch status, and affected versions for security-critical releases, built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-security-patch-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-alert" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Security Vulnerabilities</h2>
            </div>
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Outline" Class="bg-red-500/10 text-xs text-red-500">
                    @_criticalCount Critical
                </BadgeCn>
                <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                    @_patchedCount Patched
                </BadgeCn>
            </div>
        </div>

        @* Summary *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-6">
                <div>
                    <p class="text-xs text-muted-foreground">Total Vulnerabilities</p>
                    <p class="text-2xl font-semibold tabular-nums">@_vulnerabilities.Length</p>
                </div>
                <div>
                    <p class="text-xs text-muted-foreground">Patch Rate</p>
                    <p class="text-2xl font-semibold tabular-nums text-emerald-500">
                        @(Math.Round((double)_patchedCount / _vulnerabilities.Length * 100))%
                    </p>
                </div>
            </div>
        </div>

        @* Vulnerabilities *@
        <div class="divide-y">
            @foreach (var vln in _vulnerabilities)
            {
                var vuln = vln;
                var isExpanded = _expandedId == vuln.CveId;
                var dotColor = vuln.Severity == "critical" ? "bg-red-500"
                             : vuln.Severity == "high"     ? "bg-orange-500"
                             : vuln.Severity == "medium"   ? "bg-amber-500"
                             : "bg-blue-500";
                <div>
                    <button type="button"
                            class="w-full px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => ToggleExpanded(vuln.CveId))">
                        <div class="flex items-start gap-3">
                            <div class="mt-1 flex items-center gap-2">
                                <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", dotColor)"></span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-start justify-between gap-3">
                                    <div>
                                        <div class="flex items-center gap-2">
                                            <h3 class="text-sm font-medium">@vuln.Title</h3>
                                        </div>
                                        <div class="mt-1 flex items-center gap-2">
                                            <span class="font-mono text-xs text-muted-foreground">@vuln.CveId</span>
                                            <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("text-xs", GetSeverityColor(vuln.Severity))">
                                                @vuln.Severity
                                            </BadgeCn>
                                            <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("gap-1 text-xs", GetStatusColor(vuln.Status))">
                                                @GetStatusIcon(vuln.Status)
                                                @vuln.Status
                                            </BadgeCn>
                                        </div>
                                    </div>
                                </div>

                                @if (isExpanded)
                                {
                                    <div class="mt-3 space-y-2">
                                        <p class="text-sm text-muted-foreground">@vuln.Description</p>
                                        <div class="grid gap-2 rounded-md bg-muted/50 p-3 text-xs">
                                            <div class="flex items-center justify-between">
                                                <span class="text-muted-foreground">Affected Versions:</span>
                                                <span class="font-medium">@vuln.AffectedVersions</span>
                                            </div>
                                            <div class="flex items-center justify-between">
                                                <span class="text-muted-foreground">Patched In:</span>
                                                <span class="font-medium">@vuln.PatchedVersion</span>
                                            </div>
                                            <div class="flex items-center justify-between">
                                                <span class="text-muted-foreground">Discovered:</span>
                                                <span class="font-medium">@vuln.DiscoveredDate</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </button>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Vulnerability(
        string CveId,
        string Severity,
        string Title,
        string Description,
        string AffectedVersions,
        string PatchedVersion,
        string Status,
        string DiscoveredDate);

    private static readonly Vulnerability[] _vulnerabilities =
    [
        new("CVE-2026-12345", "critical", "SQL Injection in User Authentication",
            "A critical SQL injection vulnerability in the authentication module allows attackers to bypass login and execute arbitrary SQL commands.",
            "v3.0 - v3.2", "v4.0.0", "patched", "2026-03-15"),
        new("CVE-2026-12346", "high", "XSS Vulnerability in Comment System",
            "Cross-site scripting vulnerability allows malicious users to inject JavaScript code through comment fields.",
            "v2.5 - v3.1", "v3.2.0", "patched", "2026-03-10"),
        new("CVE-2026-12347", "high", "Authentication Token Exposure",
            "API authentication tokens can be exposed through browser cache under specific conditions.",
            "v3.0 - v3.2", "v4.1.0", "pending", "2026-03-25"),
        new("CVE-2026-12348", "medium", "Rate Limiting Bypass",
            "Rate limiting can be bypassed by manipulating request headers, potentially enabling brute-force attacks.",
            "v3.1 - v3.2", "v4.0.0", "patched", "2026-03-08"),
        new("CVE-2026-12349", "low", "Information Disclosure in Error Messages",
            "Verbose error messages may expose sensitive system information to unauthenticated users.",
            "v2.5 - v3.2", "v4.0.0", "patched", "2026-03-05"),
    ];

    private string? _expandedId;

    private int _criticalCount => _vulnerabilities.Count(v => v.Severity == "critical");
    private int _patchedCount => _vulnerabilities.Count(v => v.Status == "patched");

    private void ToggleExpanded(string cveId)
    {
        _expandedId = _expandedId == cveId ? null : cveId;
    }

    private static string GetSeverityColor(string severity) => severity switch
    {
        "critical" => "bg-red-500/10 text-red-500",
        "high"     => "bg-orange-500/10 text-orange-500",
        "medium"   => "bg-amber-500/10 text-amber-500",
        _          => "bg-blue-500/10 text-blue-500",
    };

    private static string GetStatusColor(string status) => status switch
    {
        "patched"      => "bg-emerald-500/10 text-emerald-500",
        "pending"      => "bg-amber-500/10 text-amber-500",
        "investigating" => "bg-blue-500/10 text-blue-500",
        _              => "",
    };

    private RenderFragment GetStatusIcon(string status) => status switch
    {
        "patched"      => @<LucideIconCn Name="check-circle-2" Size="12" Class="size-3" />,
        "pending"      => @<LucideIconCn Name="clock" Size="12" Class="size-3" />,
        "investigating" => @<LucideIconCn Name="alert-triangle" Size="12" Class="size-3" />,
        _              => @<text></text>,
    };
}
