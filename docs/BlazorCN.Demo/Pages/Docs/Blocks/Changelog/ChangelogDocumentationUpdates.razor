@* ============================================================
   Block: changelog-documentation-updates
   Title: ChangelogDocumentationUpdates
   Description: A changelog block tracking documentation changes with page or section affected, change type such as New Page, Updated, or Rewritten, and author attribution with staggered motion.
   Source: original/blocks/changelog/changelog-documentation-updates.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Documentation Updates</h2>
            <span class="ml-auto text-xs text-muted-foreground">@_docChanges.Length changes</span>
        </div>

        <div class="flex items-center gap-3 border-b px-4 py-2">
            @foreach (var type in _types)
            {
                var count = _docChanges.Count(c => c.Type == type);
                var typeStyle = GetTypeStyle(type);
                <span class="@Cn.Merge("rounded-full px-2 py-0.5 text-xs font-medium", typeStyle)">
                    @count @type
                </span>
            }
        </div>

        @foreach (var change in _docChanges)
        {
            var isExpanded = _expanded == change.Id;
            var chevronClass = Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
            var typeStyle = GetTypeStyle(change.Type);
            <div class="border-b last:border-b-0">
                <button
                    type="button"
                    @onclick="@(() => ToggleExpanded(change.Id))"
                    class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@change.Section</span>
                            <span class="@Cn.Merge("rounded-full px-1.5 py-0.5 text-[10px] font-medium leading-none", typeStyle)">
                                @change.Type
                            </span>
                        </div>
                        <div class="mt-0.5 flex items-center gap-2">
                            <span class="font-mono text-xs text-muted-foreground">@change.Page</span>
                            <span class="text-xs text-muted-foreground">·</span>
                            <span class="text-xs text-muted-foreground">@change.Author</span>
                        </div>
                    </div>
                    <div class="flex shrink-0 items-center gap-2">
                        <span class="hidden text-xs text-muted-foreground sm:block">@change.Date</span>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                    </div>
                </button>

                @if (isExpanded)
                {
                    <div class="border-t bg-muted/30 px-4 py-3">
                        <p class="text-xs text-muted-foreground">@change.Description</p>
                    </div>
                }
            </div>
        }

    </div>
</section>

@code {
    private record DocChange(
        string Id,
        string Page,
        string Section,
        string Type,
        string Description,
        string Author,
        string Date
    );

    private string? _expanded;

    private static readonly string[] _types = ["New Page", "Updated", "Rewritten"];

    private void ToggleExpanded(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private static string GetTypeStyle(string type) => type switch
    {
        "New Page"  => "bg-emerald-500/10 text-emerald-600",
        "Updated"   => "bg-blue-500/10 text-blue-600",
        "Rewritten" => "bg-amber-500/10 text-amber-600",
        _           => "bg-gray-500/10 text-gray-600",
    };

    private static readonly DocChange[] _docChanges =
    [
        new("dc1", "/docs/authentication", "Magic Link Setup", "New Page",
            "Added complete guide for magic link authentication including email template customization and rate limiting configuration.",
            "Sarah Chen", "Mar 28, 2026"),
        new("dc2", "/docs/components/dialog", "Accessibility", "Updated",
            "Expanded keyboard navigation section with focus trap examples and screen reader announcement patterns.",
            "Marcus Rivera", "Mar 27, 2026"),
        new("dc3", "/docs/getting-started", "Installation", "Rewritten",
            "Complete rewrite of installation guide to support Bun, pnpm, and yarn. Added troubleshooting section for common setup issues.",
            "Alex Kim", "Mar 26, 2026"),
        new("dc4", "/docs/api/webhooks", "Event Types", "Updated",
            "Added documentation for 12 new webhook events including subscription.paused and invoice.payment_retry.",
            "Priya Patel", "Mar 25, 2026"),
        new("dc5", "/docs/deployment/edge", "Edge Runtime", "New Page",
            "New guide covering edge runtime deployment, middleware configuration, and geo-routing patterns.",
            "Sarah Chen", "Mar 23, 2026"),
        new("dc6", "/docs/theming", "Dark Mode", "Rewritten",
            "Rewrote dark mode guide with CSS custom property approach replacing the old class-based toggle. Includes system preference detection.",
            "Marcus Rivera", "Mar 21, 2026"),
        new("dc7", "/docs/testing", "Component Testing", "Updated",
            "Updated testing patterns to use Vitest and Testing Library. Removed deprecated Enzyme examples.",
            "Alex Kim", "Mar 19, 2026"),
    ];
}
