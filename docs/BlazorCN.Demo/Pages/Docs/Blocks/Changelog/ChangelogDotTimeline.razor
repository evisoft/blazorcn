@* ============================================================
   Block: changelog-dot-timeline
   Title: ChangelogDotTimeline
   Description: React dot timeline changelog block for Next.js with a horizontal dot selector connected by a line, version labels, and animated change list for the selected release built with TypeScript, useState, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-dot-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="circle-dot" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Version History</h2>
        </div>

        <div class="border-b px-4 py-4">
            <div class="relative flex items-center justify-between">
                <div class="absolute top-1/2 right-0 left-0 h-px -translate-y-1/2 bg-border"></div>

                @for (var i = 0; i < _releases.Length; i++)
                {
                    var r = _releases[i];
                    var idx = i;
                    <div class="relative flex flex-col items-center gap-1.5">
                        <button
                            type="button"
                            @onclick="@(() => SetSelected(idx))"
                            aria-label="@($"Select {r.Version}")"
                            aria-current="@(idx == _selected ? "true" : null)"
                            class="@Cn.Merge("relative z-10 size-3 rounded-full border-2 transition-all duration-200", idx == _selected ? "scale-125 border-foreground bg-foreground" : "border-muted-foreground/40 bg-card hover:border-muted-foreground")">
                        </button>
                        <span class="@Cn.Merge("whitespace-nowrap text-xs transition-colors", idx == _selected ? "font-medium text-foreground" : "text-muted-foreground")">
                            @r.Version
                        </span>
                        <span class="text-[10px] text-muted-foreground">@r.Date</span>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-2">
            <span class="text-xs font-medium text-muted-foreground">
                @_releases[_selected].Changes.Length changes in @_releases[_selected].Version
            </span>
        </div>

        <div>
            @for (var i = 0; i < _releases[_selected].Changes.Length; i++)
            {
                var change = _releases[_selected].Changes[i];
                var isLast = i == _releases[_selected].Changes.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", GetDotColor(change.Category))"></span>
                    <span class="text-sm">@change.Title</span>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Change(string Title, string Category);
    private record Release(string Version, string Date, Change[] Changes);

    private int _selected = 0;

    private static readonly Release[] _releases =
    [
        new("v3.12.0", "Mar 28",
        [
            new("Collaborative workspaces with real-time presence", "feature"),
            new("Inline comment threads on table cells", "feature"),
            new("Fixed export timeout on large datasets", "fix"),
            new("Dashboard load time reduced by 40%", "improvement"),
        ]),
        new("v3.11.2", "Mar 14",
        [
            new("Webhook retry logic with exponential backoff", "improvement"),
            new("Fixed session expiry during long edits", "fix"),
            new("Keyboard shortcut overlay panel", "feature"),
        ]),
        new("v3.11.0", "Feb 28",
        [
            new("Bulk import batch size increased to 500", "improvement"),
            new("Custom field types for project tables", "feature"),
            new("Fixed cursor pagination duplicate rows", "fix"),
            new("API rate limit headers on all responses", "feature"),
        ]),
        new("v3.10.1", "Feb 14",
        [
            new("Fixed dark mode contrast on status badges", "fix"),
            new("Improved search indexing speed by 60%", "improvement"),
        ]),
        new("v3.10.0", "Jan 31",
        [
            new("Activity feed with real-time updates", "feature"),
            new("Two-factor authentication via TOTP", "feature"),
            new("Fixed notification emails not sending", "fix"),
            new("Reduced memory usage in background workers", "improvement"),
        ]),
    ];

    private void SetSelected(int index) => _selected = index;

    private static string GetDotColor(string category) => category switch
    {
        "feature" => "bg-emerald-500",
        "fix" => "bg-red-500",
        "improvement" => "bg-blue-500",
        _ => "bg-muted-foreground"
    };
}
