@* ============================================================
   Block: changelog-kanban-status
   Title: ChangelogKanbanStatus
   Description: React kanban-style changelog block for Next.js with three-column status layout showing Planned, In Progress, and Done phases built with TypeScript, Framer Motion stagger, and Tailwind CSS grid.
   Source: original/blocks/changelog/changelog-kanban-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="columns-3" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Changelog</h2>
            <span class="text-xs text-muted-foreground">Roadmap status</span>
        </div>

        <div class="grid grid-cols-1 gap-px bg-border md:grid-cols-3">
            @foreach (var col in _columns)
            {
                var colItems = _items.Where(i => i.Status == col.Status).ToArray();
                <div class="bg-card">
                    <div class="flex items-center gap-2 border-b px-4 py-2.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", GetDotColor(col.Status))"></span>
                        <span class="text-xs font-medium">@col.Label</span>
                        <span class="ml-auto text-xs text-muted-foreground">@colItems.Length</span>
                    </div>
                    <div class="divide-y">
                        @foreach (var entry in colItems)
                        {
                            <div class="px-4 py-3 transition-colors hover:bg-muted/50">
                                <div class="flex items-start justify-between gap-2">
                                    <span class="text-sm font-medium leading-snug">@entry.Title</span>
                                    <span class="shrink-0 text-xs text-muted-foreground">@entry.Date</span>
                                </div>
                                <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
                                    @entry.Description
                                </p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record KanbanItem(string Title, string Description, string Date, string Status);
    private record Column(string Status, string Label);

    private static string GetDotColor(string status) => status switch
    {
        "planned"     => "bg-blue-500",
        "in-progress" => "bg-amber-500",
        "done"        => "bg-emerald-500",
        _             => "",
    };

    private static readonly KanbanItem[] _items =
    [
        new("Webhook retry policies",    "Configurable retry intervals with exponential backoff for failed webhook deliveries.",      "Apr 12", "planned"),
        new("SAML SSO support",          "Enterprise single sign-on with SAML 2.0 identity provider integration.",                   "Apr 8",  "planned"),
        new("Bulk CSV import",           "Import thousands of records via CSV with column mapping and validation.",                   "Apr 5",  "planned"),
        new("Real-time notifications",   "WebSocket-based push notifications with customizable delivery channels.",                  "Mar 28", "in-progress"),
        new("API rate limit dashboard",  "Visual monitoring of API usage and rate limit consumption per key.",                        "Mar 25", "in-progress"),
        new("Dark mode refinements",     "Improved contrast ratios and color consistency across all dark mode surfaces.",             "Mar 22", "in-progress"),
        new("Two-factor authentication", "TOTP-based 2FA with backup recovery codes and device management.",                         "Mar 18", "done"),
        new("Search indexing v2",        "Rebuilt full-text search with trigram matching and relevance scoring.",                    "Mar 15", "done"),
        new("Audit log export",          "Download audit trail events as CSV or JSON with date range filtering.",                    "Mar 10", "done"),
    ];

    private static readonly Column[] _columns =
    [
        new("planned",     "Planned"),
        new("in-progress", "In Progress"),
        new("done",        "Done"),
    ];
}
