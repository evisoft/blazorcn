@* ============================================================
   Block: changelog-localized
   Title: ChangelogLocalized
   Description: React multi-language changelog block for Next.js with locale switcher, translated entries, and language indicator badges built with TypeScript, shadcn/ui Button and Badge, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-localized.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="globe" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Changelog</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="px-1.5 py-0 font-mono font-normal text-[10px]">
                @_localeLabels[_activeLocale].Code
            </BadgeCn>
        </div>

        @* Locale switcher *@
        <div class="flex flex-wrap items-center gap-1.5 border-b px-4 py-2.5">
            @foreach (var loc in _locales)
            {
                var locale = loc;
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                    Class="@Cn.Merge("h-7 gap-1.5 text-xs", _activeLocale == locale ? "bg-muted text-foreground" : "text-muted-foreground")"
                    @onclick="@(() => _activeLocale = locale)"
                    aria-pressed="@(_activeLocale == locale ? "true" : "false")">
                    <span class="font-mono text-[10px]">@_localeLabels[locale].Code</span>
                    @_localeLabels[locale].Name
                </ButtonCn>
            }
        </div>

        @* Entries *@
        <div lang="@_activeLocale">
            @for (var i = 0; i < ActiveEntries.Length; i++)
            {
                var entry = ActiveEntries[i];
                var isLast = i == ActiveEntries.Length - 1;
                <div class="@Cn.Merge("px-4 py-2.5", isLast ? "" : "border-b")">
                    <div class="flex items-center justify-between gap-2">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@entry.Title</span>
                            <span class="font-mono text-muted-foreground/60 text-[10px] tabular-nums">v@entry.Version</span>
                        </div>
                        <span class="shrink-0 text-muted-foreground/60 text-xs">@entry.Date</span>
                    </div>
                    <p class="mt-0.5 text-muted-foreground text-xs">@entry.Description</p>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">@ActiveEntries.Length entries</span>
            <span class="text-muted-foreground text-xs">@_locales.Length languages available</span>
        </div>

    </div>
</section>

@code {
    private record ChangeEntry(string Title, string Description, string Date, string Version);
    private record LocaleLabel(string Code, string Name);

    private static readonly string[] _locales = ["en", "es", "de", "ja"];

    private static readonly Dictionary<string, LocaleLabel> _localeLabels = new()
    {
        ["en"] = new("EN", "English"),
        ["es"] = new("ES", "Espanol"),
        ["de"] = new("DE", "Deutsch"),
        ["ja"] = new("JA", "Japanese"),
    };

