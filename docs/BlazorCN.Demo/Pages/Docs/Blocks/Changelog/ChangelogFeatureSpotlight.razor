@* ============================================================
   Block: changelog-feature-spotlight
   Title: ChangelogFeatureSpotlight
   Description: A changelog block with a hero section highlighting the primary new feature and a compact list of other updates grouped beneath it.
   Source: original/blocks/changelog/changelog-feature-spotlight.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="star" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Feature Spotlight</span>
            </div>
            <span class="text-xs text-muted-foreground">
                @_featuredChange.Version &middot; @_featuredChange.Date
            </span>
        </div>

        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                    @_featuredChange.Category
                </BadgeCn>
            </div>
            <h3 class="mt-2 text-base font-semibold">@_featuredChange.Title</h3>
            <p class="mt-1 text-sm text-muted-foreground">@_featuredChange.Description</p>
        </div>

        <div class="border-b px-4 py-2">
            <span class="text-xs font-medium text-muted-foreground">Other updates</span>
        </div>

        <div>
            @for (var i = 0; i < _otherUpdates.Length; i++)
            {
                var update = _otherUpdates[i];
                var isLast = i == _otherUpdates.Length - 1;
                <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <LucideIconCn Name="arrow-right" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground/60" />
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@update.Title</span>
                            <BadgeCn Variant="BadgeVariant.Outline" Class="shrink-0 text-xs">
                                @update.Category
                            </BadgeCn>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">@update.Description</p>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ChangeEntry(string Title, string Description, string Category, string Version, string Date);
    private record Update(string Title, string Category, string Description);

    private static readonly ChangeEntry _featuredChange = new(
        "Real-time collaboration",
        "Multiple team members can now edit the same document simultaneously with live cursors, presence indicators, and automatic conflict resolution.",
        "New Feature",
        "v3.8.0",
        "March 22, 2026"
    );

    private static readonly Update[] _otherUpdates =
    [
        new("Improved search indexing performance", "Performance", "Search queries now resolve 3x faster with the new inverted index."),
        new("Dark mode color contrast fixes", "Bug Fix", "Resolved low-contrast text issues on sidebar navigation in dark mode."),
        new("Export to PDF now supports tables", "Enhancement", "Table elements are now preserved with proper formatting in PDF exports."),
        new("New keyboard shortcuts for code blocks", "Enhancement", "Press Cmd+Shift+C to toggle code block formatting in the editor."),
        new("Deprecated legacy webhook format", "Deprecation", "The v1 webhook payload format will be removed in v4.0. Migrate to v2 format."),
    ];
}
