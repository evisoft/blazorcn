@* ============================================================
   Block: changelog-schema-diff
   Title: ChangelogSchemaDiff
   Description: React database schema diff viewer changelog block for Next.js displaying added, modified, and removed columns with inline diff highlighting built with shadcn/ui Badge, Tailwind CSS, and Framer Motion.
   Source: original/blocks/changelog/changelog-schema-diff.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="database" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Schema Diff</h2>
            <span class="ml-auto text-xs text-muted-foreground">@_migrations.Length migrations</span>
        </div>

        <div class="flex items-center gap-4 border-b bg-muted/30 px-4 py-2.5">
            @foreach (var type in _changeTypes)
            {
                var t = type;
                var count = 0;
                foreach (var m in _migrations) { foreach (var c in m.Changes) { if (c.ChangeType == t) count++; } }
                <div class="flex items-center gap-1.5">
                    <span class="@Cn.Merge("size-1.5 rounded-full", GetChangeDot(t))"></span>
                    <span class="text-[10px] text-muted-foreground capitalize">@count @t</span>
                </div>
            }
        </div>

        <div>
            @for (var i = 0; i < _migrations.Length; i++)
            {
                var migration = _migrations[i];
                var idx = i;
                var isExpanded = _expanded == migration.Id;
                var addedCount = 0;
                var modifiedCount = 0;
                var removedCount = 0;
                foreach (var c in migration.Changes)
                {
                    if (c.ChangeType == "added") addedCount++;
                    else if (c.ChangeType == "modified") modifiedCount++;
                    else if (c.ChangeType == "removed") removedCount++;
                }
                var buttonBorder = idx < _migrations.Length - 1 ? "border-b" : "";
                <div>
                    <button type="button"
                            class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", buttonBorder)"
                            @onclick="@(() => Toggle(migration.Id))">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <code class="font-mono text-xs text-muted-foreground">@migration.Table</code>
                                <span class="font-mono text-[10px] text-muted-foreground/60">@migration.Version</span>
                            </div>
                            <p class="mt-0.5 text-sm font-medium">@migration.Description</p>
                            <div class="mt-1 flex items-center gap-2">
                                @if (addedCount > 0)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">
                                        <span class="mr-1 text-emerald-600 dark:text-emerald-400">+@addedCount</span>
                                    </BadgeCn>
                                }
                                @if (modifiedCount > 0)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">
                                        <span class="mr-1 text-amber-600 dark:text-amber-400">~@modifiedCount</span>
                                    </BadgeCn>
                                }
                                @if (removedCount > 0)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">
                                        <span class="mr-1 text-red-600 dark:text-red-400">-@removedCount</span>
                                    </BadgeCn>
                                }
                            </div>
                        </div>
                        <span class="shrink-0 text-xs text-muted-foreground">@migration.Date</span>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>
                    @if (isExpanded)
                    {
                        var contentBorder = idx < _migrations.Length - 1 ? "border-b" : "";
                        <div class="overflow-hidden">
                            <div class="@Cn.Merge("px-4 py-3", contentBorder)">
                                <div class="overflow-hidden rounded-md bg-zinc-950">
                                    <div class="p-3 space-y-0.5">
                                        @foreach (var col in migration.Changes)
                                        {
                                            var rowBg = GetChangeBg(col.ChangeType);
                                            var prefixClass = GetChangeText(col.ChangeType);
                                            var prefix = GetChangePrefix(col.ChangeType);
                                            var nameClass = col.ChangeType == "removed"
                                                ? "text-red-400 line-through decoration-red-400/40"
                                                : "text-zinc-200";
                                            <div class="@Cn.Merge("-mx-3 px-3 py-0.5", rowBg)">
                                                <div class="flex items-center gap-2">
                                                    <span class="@Cn.Merge("w-3 shrink-0 font-mono text-xs", prefixClass)">@prefix</span>
                                                    <span class="@Cn.Merge("font-mono text-xs", nameClass)">@col.Name</span>
                                                    @if (col.ChangeType == "modified" && col.PreviousType != null)
                                                    {
                                                        <span class="font-mono text-[10px]">
                                                            <span class="text-red-400 line-through decoration-red-400/40">@col.PreviousType</span>
                                                            <span class="mx-1 text-zinc-600">-&gt;</span>
                                                            <span class="text-emerald-400">@col.ColumnType</span>
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        var typeClass = col.ChangeType == "removed" ? "text-red-400/60" : "text-zinc-500";
                                                        <span class="@Cn.Merge("font-mono text-[10px]", typeClass)">@col.ColumnType</span>
                                                    }
                                                    @if (col.Nullable)
                                                    {
                                                        <span class="font-mono text-[10px] text-zinc-600">nullable</span>
                                                    }
                                                    @if (col.DefaultValue != null)
                                                    {
                                                        <span class="font-mono text-[10px] text-zinc-500">= @col.DefaultValue</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ColumnChange(
        string Name,
        string ChangeType,
        string ColumnType,
        bool Nullable,
        string? PreviousType = null,
        string? DefaultValue = null);

    private record Migration(
        string Id,
        string Version,
        string Date,
        string Table,
        string Description,
        ColumnChange[] Changes);

    private static readonly string[] _changeTypes = ["added", "modified", "removed"];

    private static readonly Migration[] _migrations =
    [
        new("m1", "20260330_001", "Mar 30, 2026", "subscriptions",
            "Add trial period tracking and usage-based billing fields",
            [
                new("trial_ends_at", "added", "timestamp with time zone", true),
                new("usage_limit", "added", "integer", false, DefaultValue: "10000"),
                new("usage_current", "added", "integer", false, DefaultValue: "0"),
                new("billing_cycle", "modified", "text", false, PreviousType: "varchar(20)"),
                new("legacy_plan_id", "removed", "varchar(50)", true),
            ]),
        new("m2", "20260326_002", "Mar 26, 2026", "users",
            "Add two-factor authentication and session management columns",
            [
                new("totp_secret", "added", "text", true),
                new("totp_enabled_at", "added", "timestamp with time zone", true),
                new("recovery_codes", "added", "jsonb", true),
                new("max_sessions", "added", "integer", false, DefaultValue: "5"),
                new("phone_number", "modified", "varchar(20)", true, PreviousType: "varchar(15)"),
            ]),
        new("m3", "20260322_001", "Mar 22, 2026", "audit_logs",
            "Restructure audit log schema for partitioning support",
            [
                new("partition_key", "added", "date", false),
                new("actor_ip", "added", "inet", true),
                new("metadata", "modified", "jsonb", true, PreviousType: "text"),
                new("old_values", "removed", "text", true),
                new("new_values", "removed", "text", true),
                new("changes_jsonb", "added", "jsonb", true),
            ]),
        new("m4", "20260318_003", "Mar 18, 2026", "workspaces",
            "Add workspace-level feature flags and branding columns",
            [
                new("feature_flags", "added", "jsonb", false, DefaultValue: "'{}'"),
                new("custom_domain", "added", "varchar(255)", true),
                new("logo_url", "added", "text", true),
                new("primary_color", "added", "varchar(7)", true, DefaultValue: "'#000000'"),
                new("plan", "modified", "text", false, PreviousType: "varchar(20)"),
            ]),
        new("m5", "20260314_001", "Mar 14, 2026", "api_keys",
            "Replace simple token with scoped permissions model",
            [
                new("scopes", "added", "text[]", false, DefaultValue: "'{read}'"),
                new("rate_limit", "added", "integer", false, DefaultValue: "1000"),
                new("last_rotated_at", "added", "timestamp with time zone", true),
                new("is_admin", "removed", "boolean", false),
                new("access_level", "removed", "varchar(10)", false),
            ]),
    ];

    private string? _expanded = "m1";

    private void Toggle(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private static string GetChangeDot(string changeType) => changeType switch
    {
        "added" => "bg-emerald-500",
        "modified" => "bg-amber-500",
        "removed" => "bg-red-500",
        _ => "",
    };

    private static string GetChangeText(string changeType) => changeType switch
    {
        "added" => "text-emerald-600 dark:text-emerald-400",
        "modified" => "text-amber-600 dark:text-amber-400",
        "removed" => "text-red-600 dark:text-red-400",
        _ => "",
    };

    private static string GetChangeBg(string changeType) => changeType switch
    {
        "added" => "bg-emerald-500/10",
        "modified" => "bg-amber-500/10",
        "removed" => "bg-red-500/10",
        _ => "",
    };

    private static string GetChangePrefix(string changeType) => changeType switch
    {
        "added" => "+",
        "modified" => "~",
        "removed" => "-",
        _ => " ",
    };
}
