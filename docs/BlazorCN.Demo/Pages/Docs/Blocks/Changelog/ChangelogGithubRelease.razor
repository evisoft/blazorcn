@* ============================================================
   Block: changelog-github-release
   Title: ChangelogGithubRelease
   Description: A GitHub release-style changelog block built with React, Next.js, shadcn/ui, and Tailwind CSS showing version tags, release notes, contributor avatars, and downloadable asset badges
   Source: original/blocks/changelog/changelog-github-release.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="package" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Releases</h2>
            <span class="ml-auto text-xs text-muted-foreground tabular-nums">@_releases.Length releases</span>
        </div>

        @* Release list *@
        @foreach (var rel in _releases)
        {
            var release = rel;
            var isExpanded = _expanded == release.Id;
            <div class="border-b last:border-b-0">
                <button type="button"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => _expanded = isExpanded ? null : release.Id)">
                    <LucideIconCn Name="tag" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-mono text-sm font-medium">@release.Tag</span>
                            <span class="@Cn.Merge("rounded-md px-1.5 py-0.5 text-[10px] font-medium", GetTypeStyle(release.Type))">@GetTypeLabel(release.Type)</span>
                        </div>
                        <p class="mt-0.5 truncate text-xs text-muted-foreground">@release.Title</p>
                    </div>
                    <span class="shrink-0 text-xs text-muted-foreground">@release.Date</span>
                    <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                </button>

                @if (isExpanded)
                {
                    <div class="border-t bg-muted/30 px-4 py-3">
                        <div class="space-y-1.5">
                            @foreach (var line in release.Body)
                            {
                                <div class="flex items-start gap-2">
                                    <span class="mt-1.5 size-1 shrink-0 rounded-full bg-muted-foreground/40"></span>
                                    <p class="text-sm leading-relaxed">@line</p>
                                </div>
                            }
                        </div>

                        <div class="mt-3 flex items-center gap-2">
                            <LucideIconCn Name="git-branch" Size="12" Class="size-3 text-muted-foreground" />
                            <span class="text-xs text-muted-foreground tabular-nums">@release.CommitCount commits</span>
                            <span class="text-xs text-muted-foreground/50">&middot;</span>
                            <div class="flex -space-x-1.5">
                                @foreach (var c in release.Contributors)
                                {
                                    <span title="@c.Username"
                                          class="flex size-5 items-center justify-center rounded-full border border-background bg-muted text-[8px] font-medium text-muted-foreground">
                                        @c.Initials
                                    </span>
                                }
                            </div>
                            <span class="text-xs text-muted-foreground">@release.Contributors.Length contributors</span>
                        </div>

                        @if (release.Assets.Length > 0)
                        {
                            <div class="mt-3 space-y-1.5">
                                <span class="text-xs font-medium text-muted-foreground">Assets</span>
                                @foreach (var asset in release.Assets)
                                {
                                    <div class="flex items-center gap-2 rounded-md bg-muted/50 px-3 py-2">
                                        <LucideIconCn Name="download" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                                        <span class="min-w-0 flex-1 truncate font-mono text-xs">@asset.Name</span>
                                        <span class="shrink-0 text-[10px] text-muted-foreground tabular-nums">@asset.Size</span>
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-[10px] tabular-nums">@FormatDownloads(asset.Downloads)</BadgeCn>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }

    </div>
</section>

@code {
    private record GhAsset(string Name, string Size, int Downloads);
    private record GhContributor(string Username, string Initials);
    private record GhRelease(string Id, string Tag, string Title, string Type, string Date, string[] Body, GhAsset[] Assets, GhContributor[] Contributors, int CommitCount);

