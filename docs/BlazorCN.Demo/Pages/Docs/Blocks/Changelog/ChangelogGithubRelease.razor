    private string? _expanded = "r1";

    private static string GetTypeStyle(string type) => type switch
    {
        "stable"      => "bg-emerald-500/10 text-emerald-600",
        "pre-release" => "bg-amber-500/10 text-amber-600",
        "rc"          => "bg-blue-500/10 text-blue-600",
        _             => "",
    };

    private static string GetTypeLabel(string type) => type switch
    {
        "stable"      => "Latest",
        "pre-release" => "Pre-release",
        "rc"          => "RC",
        _             => type,
    };

    private static string FormatDownloads(int n) => n.ToString("N0");
}
