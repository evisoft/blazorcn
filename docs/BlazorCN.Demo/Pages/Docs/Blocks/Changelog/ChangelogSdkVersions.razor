@* ============================================================
   Block: changelog-sdk-versions
   Title: ChangelogSdkVersions
   Description: A multi-platform SDK version matrix displaying latest versions, release dates, and platform badges for JavaScript, Python, Go, and Ruby SDKs with staggered animations.
   Source: original/blocks/changelog/changelog-sdk-versions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="box" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">SDK Version Matrix</h2>
            <span class="ml-auto text-xs text-muted-foreground">4 platforms</span>
        </div>

        @* Column headers *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-4 text-xs font-medium text-muted-foreground">
                <span>Platform</span>
                <span>Version</span>
                <span>Released</span>
                <span class="text-right">Status</span>
            </div>
        </div>

        @* SDK rows *@
        @foreach (var sdk in _sdkVersions)
        {
            var platform = sdk.Platform;
            <div>
                <button type="button"
                        class="flex w-full items-center border-b px-4 py-3 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => ToggleExpanded(platform))">
                    <div class="grid w-full grid-cols-4 items-center">
                        <span class="text-sm font-medium">@sdk.Platform</span>
                        <span class="font-mono text-xs text-muted-foreground">@sdk.Version</span>
                        <span class="text-xs text-muted-foreground">@sdk.ReleaseDate</span>
                        <div class="flex items-center justify-end gap-2">
                            <span class="@Cn.Merge("size-1.5 rounded-full", GetStatusDotClass(sdk.Status))" />
                            <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", _expanded == sdk.Platform ? "rotate-90" : "")" />
                        </div>
                    </div>
                </button>

                @if (_expanded == sdk.Platform)
                {
                    var expandedSdk = sdk;
                    <div class="border-b bg-muted/30 px-4 py-3">
                        <div class="mb-2 flex items-center justify-between">
                            <span class="text-xs font-medium text-muted-foreground">
                                Changes in @expandedSdk.Version
                            </span>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs"
                                      @onclick="@(() => HandleCopy(expandedSdk.Version, expandedSdk.Platform))">
                                @if (_copied == expandedSdk.Platform)
                                {
                                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                                }
                                else
                                {
                                    <LucideIconCn Name="copy" Size="12" Class="size-3" />
                                }
                                @(_copied == expandedSdk.Platform ? "Copied" : "Copy version")
                            </ButtonCn>
                        </div>
                        <ul class="space-y-1">
                            @foreach (var change in expandedSdk.Changes)
                            {
                                <li class="flex items-start gap-2 text-xs text-muted-foreground">
                                    <span class="mt-1.5 size-1 shrink-0 rounded-full bg-muted-foreground/40" />
                                    @change
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }

        @* Footer *@
        <div class="px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                All SDKs follow semantic versioning
            </p>
        </div>

    </div>
</section>

@code {
    private record SdkVersion(
        string Platform,
        string Language,
        string Version,
        string ReleaseDate,
        string[] Changes,
        string Status
    );

    private static readonly SdkVersion[] _sdkVersions =
    [
        new("JavaScript", "js", "4.12.0", "Mar 25, 2026",
            [
                "Added streaming support for real-time events",
                "Fixed retry logic for 429 responses",
                "Tree-shaking improvements reduce bundle by 18%",
            ],
            "stable"),
        new("Python", "py", "3.8.2", "Mar 22, 2026",
            [
                "Async client now supports Python 3.13",
                "Added type stubs for all public APIs",
                "Fixed connection pooling memory leak",
            ],
            "stable"),
        new("Go", "go", "2.5.0", "Mar 18, 2026",
            [
                "Context propagation for distributed tracing",
                "Added generics-based pagination helper",
                "Upgraded to Go 1.23 minimum",
            ],
            "stable"),
        new("Ruby", "rb", "1.14.1", "Mar 10, 2026",
            [
                "Rails 8 compatibility fixes",
                "Faraday adapter now default",
                "Deprecated legacy auth methods",
            ],
            "deprecated"),
    ];

    private string? _expanded;
    private string? _copied;

    private void ToggleExpanded(string platform)
    {
        _expanded = _expanded == platform ? null : platform;
    }

    private async Task HandleCopy(string version, string platform)
    {
        _copied = platform;
        await Task.Delay(1500);
        _copied = null;
    }

    private static string GetStatusDotClass(string status) => status switch
    {
        "stable"     => "bg-emerald-500",
        "beta"       => "bg-amber-500",
        _            => "bg-red-500",
    };
}
