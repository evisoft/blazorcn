@* ============================================================
   Block: changelog-two-column-split
   Title: ChangelogTwoColumnSplit
   Description: A two-column changelog layout splitting Added features on the left and Fixed issues on the right, separated by a vertical border for clear categorization
   Source: original/blocks/changelog/changelog-two-column-split.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="columns-2" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">Changelog</span>
            <span class="text-xs text-muted-foreground">March 2026 summary</span>
        </div>

        <div class="grid grid-cols-2">
            <div class="border-r">
                <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-2">
                    <LucideIconCn Name="plus-circle" Size="14" Class="size-3.5 text-emerald-500" />
                    <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">Added</span>
                    <span class="ml-auto text-[10px] text-muted-foreground">@_addedEntries.Length</span>
                </div>
                @for (var i = 0; i < _addedEntries.Length; i++)
                {
                    var entry = _addedEntries[i];
                    var rowClass = i < _addedEntries.Length - 1
                        ? "px-4 py-2.5 transition-colors hover:bg-muted/50 border-b"
                        : "px-4 py-2.5 transition-colors hover:bg-muted/50";
                    <div class="@rowClass">
                        <div class="flex items-start justify-between gap-2">
                            <span class="text-sm font-medium leading-snug">@entry.Title</span>
                            <span class="shrink-0 font-mono text-[10px] text-muted-foreground">@entry.Date</span>
                        </div>
                        <p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">@entry.Description</p>
                    </div>
                }
            </div>

            <div>
                <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-2">
                    <LucideIconCn Name="wrench" Size="14" Class="size-3.5 text-red-500" />
                    <span class="text-xs font-medium text-red-600 dark:text-red-400">Fixed</span>
                    <span class="ml-auto text-[10px] text-muted-foreground">@_fixedEntries.Length</span>
                </div>
                @for (var i = 0; i < _fixedEntries.Length; i++)
                {
                    var entry = _fixedEntries[i];
                    var rowClass = i < _fixedEntries.Length - 1
                        ? "px-4 py-2.5 transition-colors hover:bg-muted/50 border-b"
                        : "px-4 py-2.5 transition-colors hover:bg-muted/50";
                    <div class="@rowClass">
                        <div class="flex items-start justify-between gap-2">
                            <span class="text-sm font-medium leading-snug">@entry.Title</span>
                            <span class="shrink-0 font-mono text-[10px] text-muted-foreground">@entry.Date</span>
                        </div>
                        <p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">@entry.Description</p>
                    </div>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private record Entry(string Id, string Title, string Description, string Date);

    private static readonly Entry[] _addedEntries =
    [
        new("a1", "Environment variable encryption",
            "All env vars are now encrypted at rest with AES-256-GCM.",
            "Mar 27"),
        new("a2", "Batch webhook delivery",
            "Send up to 100 webhook events in a single batched payload.",
            "Mar 23"),
        new("a3", "Custom log drain destinations",
            "Forward application logs to Datadog, Splunk, or any HTTP endpoint.",
            "Mar 19"),
        new("a4", "API request tracing",
            "Trace individual requests across services with distributed tracing IDs.",
            "Mar 15"),
        new("a5", "Scheduled function triggers",
            "Run serverless functions on cron schedules directly from the dashboard.",
            "Mar 11"),
    ];

    private static readonly Entry[] _fixedEntries =
    [
        new("f1", "DNS propagation delay on custom domains",
            "Reduced average propagation time from 45 minutes to under 5 minutes.",
            "Mar 26"),
        new("f2", "Memory leak in connection pooler",
            "Patched a leak causing gradual memory growth under sustained high concurrency.",
            "Mar 22"),
        new("f3", "Incorrect byte count in usage billing",
            "Fixed an off-by-one error in bandwidth calculation for egress metering.",
            "Mar 18"),
        new("f4", "CORS headers missing on 4xx responses",
            "Error responses now include proper CORS headers matching the origin configuration.",
            "Mar 14"),
        new("f5", "Stale cache after branch deployment",
            "CDN cache is now correctly purged when a new branch deployment goes live.",
            "Mar 10"),
    ];
}
