@* ============================================================
   Block: changelog-design-system
   Title: ChangelogDesignSystem
   Description: A changelog block for design system component updates showing component names, change types like New, Updated, or Deprecated, and visual change descriptions with staggered reveal.
   Source: original/blocks/changelog/changelog-design-system.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="palette" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Design System Updates</h2>
            <span class="ml-auto text-xs text-muted-foreground">v3.6 — v3.8</span>
        </div>

        <div class="flex items-center gap-3 border-b px-4 py-2">
            @foreach (var type in _types)
            {
                var t = type;
                var count = _changes.Count(c => c.Type == t);
                var spanClass = Cn.Merge("rounded-full px-2 py-0.5 text-xs font-medium", GetTypeBadgeStyle(t));
                <span class="@spanClass">@count @t</span>
            }
        </div>

        @foreach (var change in _changes)
        {
            var ch = change;
            var isExpanded = _expanded == ch.Id;
            var chevronClass = Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
            var typeInlineBadgeClass = Cn.Merge("rounded-full px-1.5 py-0.5 text-[10px] font-medium leading-none", GetTypeBadgeStyle(ch.Type));
            <div class="border-b last:border-b-0">
                <button
                    type="button"
                    @onclick="@(() => ToggleExpanded(ch.Id))"
                    class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-mono text-sm font-medium">@ch.Component</span>
                            <span class="@typeInlineBadgeClass">@ch.Type</span>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">@ch.Description</p>
                    </div>
                    <div class="flex shrink-0 items-center gap-2">
                        <span class="hidden text-xs text-muted-foreground sm:block">@ch.Date</span>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                    </div>
                </button>

                @if (isExpanded)
                {
                    <div class="border-t bg-muted/30 px-4 py-3">
                        <p class="text-xs text-muted-foreground">@ch.Details</p>
                        <p class="mt-2 font-mono text-xs text-muted-foreground">@ch.Version</p>
                    </div>
                }
            </div>
        }

    </div>
</section>

@code {
    private record DesignChange(
        string Id,
        string Component,
        string Type,
        string Description,
        string Details,
        string Version,
        string Date
    );

    private string? _expanded;

    private static readonly string[] _types = ["New", "Updated", "Deprecated"];

    private void ToggleExpanded(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private static string GetTypeBadgeStyle(string type) => type switch
    {
        "New"        => "bg-emerald-500/10 text-emerald-600",
        "Updated"    => "bg-blue-500/10 text-blue-600",
        "Deprecated" => "bg-amber-500/10 text-amber-600",
        _            => "",
    };

    private static readonly DesignChange[] _changes =
    [
        new("d1", "DateRangePicker", "New",        "Added date range picker with preset ranges and custom selection",
            "Supports single date, date range, and preset options like Last 7 days. Built on top of the Calendar primitive with full keyboard navigation.",
            "v3.8.0", "Mar 28, 2026"),
        new("d2", "Button",          "Updated",    "Increased default padding from px-3 to px-4 for better touch targets",
            "Minimum touch target is now 44px across all variants. Ghost and link variants unchanged. Updated Figma tokens to match.",
            "v3.8.0", "Mar 28, 2026"),
        new("d3", "Toast",           "Updated",    "New stacking behavior for multiple simultaneous toasts",
            "Toasts now stack vertically with a 8px gap instead of overlapping. Maximum visible toasts increased from 3 to 5. Swipe-to-dismiss gesture improved.",
            "v3.7.2", "Mar 25, 2026"),
        new("d4", "InputGroup",      "Deprecated", "Use Field component instead — InputGroup will be removed in v4.0",
            "The Field component provides the same functionality with better accessibility, validation support, and composition patterns. Migration guide available in docs.",
            "v3.7.0", "Mar 22, 2026"),
        new("d5", "Avatar",          "Updated",    "Added ring indicator for online status and notification dot",
            "New status prop accepts online, offline, busy, or away. Ring color follows semantic status colors. Dot position configurable via dotPosition prop.",
            "v3.7.0", "Mar 22, 2026"),
        new("d6", "Skeleton",        "New",        "Skeleton primitives for card, table row, and text block loading states",
            "Pre-built skeleton compositions that match common layouts. Pulse animation synced across all visible skeletons. Supports custom shapes via children.",
            "v3.6.1", "Mar 18, 2026"),
    ];
}
