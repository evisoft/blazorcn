@* ============================================================
   Block: changelog-newsletter
   Title: ChangelogNewsletter
   Description: An email newsletter-style changelog layout built with React, Next.js, shadcn/ui, and Tailwind CSS featuring a featured entry and weekly update digest
   Source: original/blocks/changelog/changelog-newsletter.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="mail" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Weekly Digest</h2>
            <span class="ml-auto text-xs text-muted-foreground">Issue #47 · Mar 24–28, 2026</span>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs text-muted-foreground">
                This week brought a major release alongside 8 improvements. Here is everything that
                shipped.
            </p>
        </div>

        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px]">
                    @_featured.Version
                </BadgeCn>
                <span class="rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-medium text-emerald-600">
                    @_featured.Tag
                </span>
            </div>
            <h3 class="mt-2 text-base font-semibold">@_featured.Title</h3>
            <p class="mt-1.5 text-sm text-muted-foreground leading-relaxed">
                @_featured.Description
            </p>
        </div>

        <div class="border-b px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Other Updates</span>
        </div>

        <div>
            @for (int i = 0; i < _bulletEntries.Length; i++)
            {
                var entry = _bulletEntries[i];
                var isLast = i == _bulletEntries.Length - 1;
                <div class="@Cn.Merge("flex items-start gap-3 border-b px-4 py-2.5", isLast ? "border-b-0" : "")">
                    <LucideIconCn Name="@entry.IconName" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground/60" />
                    <div class="min-w-0 flex-1">
                        <span class="text-xs leading-relaxed">@entry.Title</span>
                    </div>
                    <span class="shrink-0 text-[10px] text-muted-foreground">@entry.Category</span>
                </div>
            }
        </div>

        <div class="flex items-center justify-between border-t bg-muted/30 px-4 py-2.5">
            <span class="text-[10px] text-muted-foreground">9 updates this week</span>
            <button type="button" class="flex items-center gap-1 text-[10px] font-medium text-muted-foreground transition-colors hover:text-foreground">
                View full changelog
                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
            </button>
        </div>

    </div>
</section>

@code {
    private record FeaturedEntry(string Title, string Description, string Version, string Tag);

    private record BulletEntry(string Id, string Title, string Category, string IconName);

    private static readonly FeaturedEntry _featured = new(
        Title: "Real-time collaboration is here",
        Description: "Multiple team members can now edit the same document simultaneously with live cursors, presence indicators, and automatic conflict resolution. Built on CRDTs for offline-first reliability.",
        Version: "v3.0.0",
        Tag: "Major Release"
    );

    private static readonly BulletEntry[] _bulletEntries =
    [
        new("b1", "Added webhook retry logic with exponential backoff up to 3 attempts",       "API",         "zap"),
        new("b2", "Fixed memory leak in WebSocket connections during long-running sessions",    "Bug Fix",     "bug"),
        new("b3", "New keyboard shortcuts panel accessible via Cmd+/ or Ctrl+/",               "Feature",     "sparkles"),
        new("b4", "Upgraded TLS certificates to support TLS 1.3 across all endpoints",        "Security",    "shield"),
        new("b5", "Improved query planner reduces complex join latency by 35%",                "Performance", "zap"),
        new("b6", "Refactored auth module to support custom SAML identity providers",          "Enhancement", "wrench"),
        new("b7", "Added interactive API reference with try-it-now functionality",             "Docs",        "book-open"),
        new("b8", "Fixed incorrect timezone handling in scheduled task execution",             "Bug Fix",     "bug"),
    ];
}
