@* ============================================================
   Block: changelog-monorepo-packages
   Title: ChangelogMonorepoPackages
   Description: A changelog block showing monorepo package release matrix with version changes, package dependencies, and multi-package deployments built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-monorepo-packages.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Monorepo Releases</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Package version changes across releases
                    </p>
                </div>
                <LucideIconCn Name="package" Size="16" Class="size-4 text-muted-foreground" />
            </div>
        </div>

        @* Stats *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-3 gap-4">
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="tag" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Releases</span>
                    </div>
                    <p class="mt-1 font-semibold tabular-nums text-2xl">5</p>
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="box" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Total Packages</span>
                    </div>
                    <p class="mt-1 font-semibold tabular-nums text-2xl">@_allPackages.Length</p>
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="git-branch" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Active Branch</span>
                    </div>
                    <p class="mt-1 font-semibold text-sm">main</p>
                </div>
            </div>
        </div>

        @* Releases *@
        <div>
            @foreach (var rel in _releases)
            {
                var release = rel;
                var isExpanded = _expandedId == release.Id;
                var isLast = release.Id == _releases[^1].Id;
                var majorCount = release.Packages.Count(p => p.Type == "major");
                var minorCount = release.Packages.Count(p => p.Type == "minor");
                var patchCount = release.Packages.Count(p => p.Type == "patch");
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => ToggleRelease(release.Id))">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted">
                            <LucideIconCn Name="package" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@release.Version</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 border-0 bg-muted/50 px-1.5 text-[10px]">
                                    @release.TotalPackages @(release.TotalPackages == 1 ? "package" : "packages")
                                </BadgeCn>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                                <span class="tabular-nums">@release.Date</span>
                                @if (majorCount > 0)
                                {
                                    <span>•</span>
                                    <span class="text-red-600">@majorCount major</span>
                                }
                                @if (minorCount > 0)
                                {
                                    <span>•</span>
                                    <span class="text-blue-600">@minorCount minor</span>
                                }
                                @if (patchCount > 0)
                                {
                                    <span>•</span>
                                    <span class="text-emerald-600">@patchCount patch</span>
                                }
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/30 px-4 py-3">
                            <div class="space-y-2">
                                @foreach (var pkg in release.Packages)
                                {
                                    <div class="flex items-center justify-between rounded-md border bg-card px-3 py-2">
                                        <div class="flex items-center gap-2">
                                            <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("h-5 border-0 px-1.5 text-[10px]", GetTypeColor(pkg.Type))">
                                                @GetTypeLabel(pkg.Type)
                                            </BadgeCn>
                                            <span class="font-mono text-sm">@pkg.Name</span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <span class="font-mono tabular-nums text-muted-foreground text-xs">@pkg.From</span>
                                            <span class="text-muted-foreground text-xs">→</span>
                                            <span class="font-mono font-medium tabular-nums text-xs">@pkg.To</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-xs text-muted-foreground">
                    @_allPackages.Length packages • Last release 2 days ago
                </span>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="h-7 gap-1.5 px-2 text-xs">
                    View Workspace
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record PackageChange(string Name, string From, string To, string Type);
    private record Release(string Id, string Version, string Date, string Branch, int TotalPackages, PackageChange[] Packages);

    private static readonly Release[] _releases =
    [
        new("1", "Release 2026.03.28", "2026-03-28", "main", 4,
        [
            new("@@acme/web", "2.3.0", "2.4.0", "minor"),
            new("@@acme/api", "1.5.2", "1.6.0", "minor"),
            new("@@acme/shared", "0.8.1", "0.9.0", "minor"),
            new("@@acme/config", "1.2.0", "1.2.1", "patch"),
        ]),
        new("2", "Release 2026.03.25", "2026-03-25", "main", 2,
        [
            new("@@acme/api", "1.5.1", "1.5.2", "patch"),
            new("@@acme/database", "2.1.0", "2.1.1", "patch"),
        ]),
        new("3", "Release 2026.03.22", "2026-03-22", "main", 5,
        [
            new("@@acme/web", "2.2.0", "2.3.0", "minor"),
            new("@@acme/mobile", "1.8.0", "2.0.0", "major"),
            new("@@acme/shared", "0.8.0", "0.8.1", "patch"),
            new("@@acme/analytics", "0.5.0", "0.6.0", "minor"),
            new("@@acme/auth", "1.3.0", "1.4.0", "minor"),
        ]),
        new("4", "Release 2026.03.18", "2026-03-18", "main", 1,
        [
            new("@@acme/database", "2.0.0", "2.1.0", "minor"),
        ]),
        new("5", "Release 2026.03.15", "2026-03-15", "main", 6,
        [
            new("@@acme/web", "2.1.0", "2.2.0", "minor"),
            new("@@acme/api", "1.5.0", "1.5.1", "patch"),
            new("@@acme/shared", "0.7.0", "0.8.0", "minor"),
            new("@@acme/config", "1.1.0", "1.2.0", "minor"),
            new("@@acme/analytics", "0.4.0", "0.5.0", "minor"),
            new("@@acme/auth", "1.2.0", "1.3.0", "minor"),
        ]),
    ];

    private static readonly string[] _allPackages =
        _releases.SelectMany(r => r.Packages.Select(p => p.Name)).Distinct().ToArray();

    private string? _expandedId;

    private void ToggleRelease(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private static string GetTypeColor(string type) => type switch
    {
        "major" => "bg-red-500/10 text-red-600",
        "minor" => "bg-blue-500/10 text-blue-600",
        "patch" => "bg-emerald-500/10 text-emerald-600",
        _ => "",
    };

    private static string GetTypeLabel(string type) => type switch
    {
        "major" => "Major",
        "minor" => "Minor",
        "patch" => "Patch",
        _ => type,
    };
}
