@* ============================================================
   Block: changelog-reaction-votes
   Title: ChangelogReactionVotes
   Description: A changelog block where each entry has emoji reaction buttons that users can toggle on and off, displaying live counts for community engagement on product updates.
   Source: original/blocks/changelog/changelog-reaction-votes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="smile" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Changelog</span>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">React to updates you care about</p>
        </div>

        @* Entries *@
        <div>
            @foreach (var entry in _entries)
            {
                var isLast = entry.Id == _entries[^1].Id;
                var entryId = entry.Id;
                <div class="@(Cn.Merge("px-4 py-3", !isLast ? "border-b" : ""))">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium">@entry.Title</p>
                            <p class="mt-0.5 text-xs text-muted-foreground">@entry.Description</p>
                            <p class="mt-1 text-xs text-muted-foreground/70">@entry.Date</p>
                        </div>
                    </div>
                    <div class="mt-2 flex items-center gap-1.5">
                        @foreach (var emoji in _reactionEmojis)
                        {
                            var em = emoji;
                            var isActive = _activeReactions.TryGetValue(entryId, out var set) && set.Contains(em);
                            var count = GetCount(entryId, em);
                            <button type="button"
                                    @onclick="@(() => ToggleReaction(entryId, em))"
                                    class="@(Cn.Merge("flex items-center gap-1 rounded-full border px-2 py-0.5 text-xs transition-colors", isActive ? "border-foreground/20 bg-muted" : "border-transparent bg-muted/50 hover:bg-muted"))">
                                <span class="text-sm">@em</span>
                                <span class="@(Cn.Merge("tabular-nums", isActive ? "font-medium text-foreground" : "text-muted-foreground"))">@count</span>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private static readonly string[] _reactionEmojis = ["🎉", "👍", "❤️", "🚀"];

    private record ChangelogEntry(string Id, string Title, string Description, string Date, Dictionary<string, int> Reactions);

    private static readonly ChangelogEntry[] _initialEntries =
    [
        new("r1", "Team workspace sharing is now live",
            "Invite teammates to your workspace with granular role-based permissions. Supports viewer, editor, and admin roles.",
            "Mar 28, 2026",
            new Dictionary<string, int> { ["🎉"] = 24, ["👍"] = 18, ["❤️"] = 9, ["🚀"] = 31 }),
        new("r2", "Dark mode support across all components",
            "Every UI component now respects system preferences and supports manual dark mode toggling with smooth transitions.",
            "Mar 26, 2026",
            new Dictionary<string, int> { ["🎉"] = 42, ["👍"] = 27, ["❤️"] = 35, ["🚀"] = 19 }),
        new("r3", "Bulk import from CSV, JSON, and XML",
            "Upload files up to 50MB with automatic schema detection, field mapping preview, and validation before import.",
            "Mar 25, 2026",
            new Dictionary<string, int> { ["🎉"] = 11, ["👍"] = 22, ["❤️"] = 5, ["🚀"] = 14 }),
        new("r4", "Two-factor authentication with TOTP",
            "Secure your account with time-based one-time passwords. Compatible with Google Authenticator, Authy, and 1Password.",
            "Mar 23, 2026",
            new Dictionary<string, int> { ["🎉"] = 8, ["👍"] = 33, ["❤️"] = 12, ["🚀"] = 7 }),
        new("r5", "Custom webhook event filtering",
            "Select exactly which events trigger your webhooks. Filter by resource type, action, and field-level changes.",
            "Mar 21, 2026",
            new Dictionary<string, int> { ["🎉"] = 6, ["👍"] = 15, ["❤️"] = 3, ["🚀"] = 10 }),
    ];

    // Mutable copy of reactions so toggling updates the displayed counts
    private readonly Dictionary<string, Dictionary<string, int>> _reactions = new();
    private readonly Dictionary<string, HashSet<string>> _activeReactions = new();
    private readonly ChangelogEntry[] _entries = _initialEntries;

    protected override void OnInitialized()
    {
        foreach (var entry in _initialEntries)
        {
            _reactions[entry.Id] = new Dictionary<string, int>(entry.Reactions);
            _activeReactions[entry.Id] = new HashSet<string>();
        }
    }

    private int GetCount(string entryId, string emoji)
    {
        if (_reactions.TryGetValue(entryId, out var reactionMap) && reactionMap.TryGetValue(emoji, out var count))
            return count;
        return 0;
    }

    private void ToggleReaction(string entryId, string emoji)
    {
        if (!_activeReactions.TryGetValue(entryId, out var activeSet))
        {
            activeSet = new HashSet<string>();
            _activeReactions[entryId] = activeSet;
        }

        if (!_reactions.TryGetValue(entryId, out var reactionMap))
            return;

        if (activeSet.Contains(emoji))
        {
            activeSet.Remove(emoji);
            reactionMap[emoji] = reactionMap[emoji] - 1;
        }
        else
        {
            activeSet.Add(emoji);
            reactionMap[emoji] = reactionMap[emoji] + 1;
        }
    }
}
