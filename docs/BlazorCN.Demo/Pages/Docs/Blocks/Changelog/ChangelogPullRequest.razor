@* ============================================================
   Block: changelog-pull-request
   Title: ChangelogPullRequest
   Description: A changelog block styled like pull request entries with PR numbers, author names, and merge status badges in emerald, blue, and muted tones.
   Source: original/blocks/changelog/changelog-pull-request.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="git-pull-request" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Pull Requests</span>
            </div>
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                <span class="flex items-center gap-1">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Merged
                </span>
                <span class="flex items-center gap-1">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    Open
                </span>
                <span class="flex items-center gap-1">
                    <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                    Draft
                </span>
            </div>
        </div>

        <div>
            @for (var idx = 0; idx < _pullRequests.Length; idx++)
            {
                var pr = _pullRequests[idx];
                var iconClass = Cn.Merge(
                    "size-4 shrink-0",
                    pr.Status == "Merged" ? "text-emerald-500" :
                    pr.Status == "Open" ? "text-blue-500" :
                    "text-muted-foreground/40");
                var badgeClass = Cn.Merge(
                    "shrink-0 rounded-md px-2 py-0.5 text-xs font-medium",
                    _statusStyles.GetValueOrDefault(pr.Status, "bg-muted text-muted-foreground"));
                var rowClass = idx < _pullRequests.Length - 1 ? "flex items-center gap-3 px-4 py-3 border-b" : "flex items-center gap-3 px-4 py-3";
                <div class="@rowClass">
                    <LucideIconCn Name="git-pull-request" Size="16" Class="@iconClass" />
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-mono text-xs text-muted-foreground">@pr.Number</span>
                            <span class="truncate text-sm font-medium">@pr.Title</span>
                        </div>
                        <div class="mt-0.5 flex items-center gap-2">
                            <span class="text-xs text-muted-foreground">@pr.Author</span>
                            <span class="text-xs text-muted-foreground/50">&middot;</span>
                            <span class="text-xs text-muted-foreground">@pr.Date</span>
                        </div>
                    </div>
                    <span class="@badgeClass">@pr.Status</span>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record PullRequest(string Number, string Title, string Author, string Status, string Date);

    private static readonly Dictionary<string, string> _statusStyles = new()
    {
        ["Merged"] = "bg-emerald-500/10 text-emerald-600",
        ["Open"]   = "bg-blue-500/10 text-blue-600",
        ["Draft"]  = "bg-muted text-muted-foreground",
    };

    private static readonly PullRequest[] _pullRequests =
    [
        new("#1847", "feat: add real-time presence indicators",           "sarah-chen", "Merged", "Mar 27"),
        new("#1845", "fix: resolve race condition in WebSocket reconnect", "marcus-r",   "Merged", "Mar 26"),
        new("#1842", "refactor: extract shared validation utils",          "priya-s",    "Open",   "Mar 25"),
        new("#1840", "feat: batch API endpoint for bulk operations",       "alex-kim",   "Merged", "Mar 24"),
        new("#1838", "docs: update migration guide for v4 plugin API",     "sarah-chen", "Draft",  "Mar 24"),
        new("#1835", "fix: correct date parsing in CSV import",            "marcus-r",   "Merged", "Mar 23"),
        new("#1833", "chore: upgrade dependencies to latest patch versions","alex-kim",  "Open",   "Mar 22"),
    ];
}
