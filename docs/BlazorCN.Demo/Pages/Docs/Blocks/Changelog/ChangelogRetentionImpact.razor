@* ============================================================
   Block: changelog-retention-impact
   Title: ChangelogRetentionImpact
   Description: Analyze user retention impact per release with cohort metrics and engagement tracking. Built with React, Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-retention-impact.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Retention Impact</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_filteredReleases.Count releases with cohort analysis
                    </p>
                </div>
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground/60" />
            </div>
        </div>

        @* Filter toolbar *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between gap-3">
                <select class="h-8 w-40 rounded-md border border-input bg-background px-2 text-xs focus:outline-none focus:ring-2 focus:ring-ring"
                        value="@_timeFilter"
                        @onchange="OnFilterChange">
                    <option value="all">All releases</option>
                    <option value="positive">Positive impact</option>
                    <option value="negative">Negative impact</option>
                </select>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Export data
                </ButtonCn>
            </div>
        </div>

        @* Release rows *@
        <div class="divide-y">
            @foreach (var rel in _filteredReleases)
            {
                var release = rel;
                var isExpanded = _expandedId == release.Id;
                var isPositiveImpact = release.Retention.Day30Delta > 0;
                var isNegativeImpact = release.Retention.Day30Delta < 0;

                var iconBoxClass = Cn.Merge(
                    "flex size-8 shrink-0 items-center justify-center rounded-md",
                    isPositiveImpact ? "bg-emerald-500/10" : "",
                    isNegativeImpact ? "bg-red-500/10" : "",
                    (!isPositiveImpact && !isNegativeImpact) ? "bg-muted/50" : "");

                var chevronClass = Cn.Merge(
                    "size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200",
                    isExpanded ? "rotate-90" : "");

                <div>
                    <button type="button" @onclick="@(() => ToggleExpanded(release.Id))"
                            class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">

                        <div class="@iconBoxClass">
                            @if (isPositiveImpact)
                            {
                                <LucideIconCn Name="trending-up" Size="16" Class="size-4 text-emerald-600" />
                            }
                            else if (isNegativeImpact)
                            {
                                <LucideIconCn Name="trending-down" Size="16" Class="size-4 text-red-600" />
                            }
                            else
                            {
                                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                            }
                        </div>

                        <div class="min-w-0 flex-1">
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="font-mono text-sm font-medium">@release.Version</span>
                                        @if (isPositiveImpact)
                                        {
                                            <BadgeCn Variant="BadgeVariant.Outline" Class="border-emerald-500/20 bg-emerald-500/10 text-emerald-600">
                                                Positive
                                            </BadgeCn>
                                        }
                                        @if (isNegativeImpact)
                                        {
                                            <BadgeCn Variant="BadgeVariant.Outline" Class="border-red-500/20 bg-red-500/10 text-red-600">
                                                Negative
                                            </BadgeCn>
                                        }
                                    </div>
                                    <p class="mt-1 text-xs text-muted-foreground">
                                        @release.ReleaseDate &middot; @release.CohortSize.ToString("N0") users in cohort
                                    </p>

                                    <div class="mt-2 grid grid-cols-3 gap-3">
                                        @* Day 7 *@
                                        <div>
                                            <p class="text-xs text-muted-foreground">Day 7</p>
                                            <div class="mt-0.5 flex items-baseline gap-1">
                                                <span class="text-sm font-medium tabular-nums">@release.Retention.Day7%</span>
                                                @{
                                                    var d7Delta = release.Retention.Day7Delta;
                                                    var d7Class = d7Delta > 0 ? "flex items-center text-xs text-emerald-600"
                                                                : d7Delta < 0 ? "flex items-center text-xs text-red-600"
                                                                : "flex items-center text-xs text-muted-foreground";
                                                }
                                                <span class="@d7Class">
                                                    @if (d7Delta > 0)
                                                    {
                                                        <LucideIconCn Name="arrow-up" Size="12" Class="size-3" />
                                                    }
                                                    else if (d7Delta < 0)
                                                    {
                                                        <LucideIconCn Name="arrow-down" Size="12" Class="size-3" />
                                                    }
                                                    @if (d7Delta != 0)
                                                    {
                                                        @Math.Abs(d7Delta)
                                                    }
                                                </span>
                                            </div>
                                        </div>

                                        @* Day 30 *@
                                        <div>
                                            <p class="text-xs text-muted-foreground">Day 30</p>
                                            <div class="mt-0.5 flex items-baseline gap-1">
                                                <span class="text-sm font-medium tabular-nums">@release.Retention.Day30%</span>
                                                @{
                                                    var d30Delta = release.Retention.Day30Delta;
                                                    var d30Class = d30Delta > 0 ? "flex items-center text-xs text-emerald-600"
                                                                 : d30Delta < 0 ? "flex items-center text-xs text-red-600"
                                                                 : "flex items-center text-xs text-muted-foreground";
                                                }
                                                <span class="@d30Class">
                                                    @if (d30Delta > 0)
                                                    {
                                                        <LucideIconCn Name="arrow-up" Size="12" Class="size-3" />
                                                    }
                                                    else if (d30Delta < 0)
                                                    {
                                                        <LucideIconCn Name="arrow-down" Size="12" Class="size-3" />
                                                    }
                                                    @if (d30Delta != 0)
                                                    {
                                                        @Math.Abs(d30Delta)
                                                    }
                                                </span>
                                            </div>
                                        </div>

                                        @* Churn *@
                                        <div>
                                            <p class="text-xs text-muted-foreground">Churn</p>
                                            <div class="mt-0.5 flex items-baseline gap-1">
                                                <span class="text-sm font-medium tabular-nums">@release.Churn.Rate%</span>
                                                @{
                                                    var churnDelta = release.Churn.Delta;
                                                    var churnClass = churnDelta < 0 ? "flex items-center text-xs text-emerald-600"
                                                                   : churnDelta > 0 ? "flex items-center text-xs text-red-600"
                                                                   : "flex items-center text-xs text-muted-foreground";
                                                }
                                                <span class="@churnClass">
                                                    @if (churnDelta < 0)
                                                    {
                                                        <LucideIconCn Name="arrow-down" Size="12" Class="size-3" />
                                                    }
                                                    else if (churnDelta > 0)
                                                    {
                                                        <LucideIconCn Name="arrow-up" Size="12" Class="size-3" />
                                                    }
                                                    @if (churnDelta != 0)
                                                    {
                                                        @Math.Abs(churnDelta)
                                                    }
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                            </div>
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/30 px-4 py-3">
                            <div class="space-y-3 pl-11">
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <p class="text-xs font-medium text-muted-foreground">Avg session duration</p>
                                        <div class="mt-1 flex items-baseline gap-2">
                                            <span class="text-2xl font-semibold tabular-nums">@release.Engagement.AvgSessionMin</span>
                                            <span class="text-xs text-muted-foreground">min</span>
                                            @{
                                                var engDelta = release.Engagement.Delta;
                                                var engClass = engDelta > 0 ? "flex items-center text-xs text-emerald-600"
                                                             : engDelta < 0 ? "flex items-center text-xs text-red-600"
                                                             : "flex items-center text-xs text-muted-foreground";
                                            }
                                            <span class="@engClass">
                                                @if (engDelta > 0)
                                                {
                                                    <LucideIconCn Name="arrow-up" Size="12" Class="size-3" />
                                                }
                                                else if (engDelta < 0)
                                                {
                                                    <LucideIconCn Name="arrow-down" Size="12" Class="size-3" />
                                                }
                                                @if (engDelta != 0)
                                                {
                                                    @Math.Abs(engDelta)
                                                }
                                            </span>
                                        </div>
                                    </div>
                                    <div>
                                        <p class="text-xs font-medium text-muted-foreground">Feature adoption</p>
                                        <div class="mt-1 flex items-baseline gap-2">
                                            <span class="text-2xl font-semibold tabular-nums">@release.Engagement.FeatureAdoption</span>
                                            <span class="text-xs text-muted-foreground">%</span>
                                        </div>
                                    </div>
                                </div>

                                <div>
                                    <p class="text-xs font-medium text-muted-foreground">Reactivation</p>
                                    <p class="mt-1 text-sm">
                                        <span class="font-medium tabular-nums">@release.Reactivation.ToString("N0")</span>
                                        dormant users returned
                                    </p>
                                </div>

                                <div>
                                    <p class="text-xs font-medium text-muted-foreground">Top churn driver</p>
                                    <p class="mt-1 text-sm">@release.Churn.TopReason</p>
                                </div>

                                <div class="flex gap-2">
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                        View cohort
                                    </ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                        Segment analysis
                                    </ButtonCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record RetentionData(int Day7, int Day30, int Day7Delta, int Day30Delta);
    private record EngagementData(int AvgSessionMin, int FeatureAdoption, int Delta);
    private record ChurnData(double Rate, double Delta, string TopReason);
    private record RetentionRelease(string Id, string Version, string ReleaseDate, int CohortSize,
        RetentionData Retention, EngagementData Engagement, ChurnData Churn, int Reactivation);

    private static readonly RetentionRelease[] _releases =
    [
        new("ret-1", "v3.2.0", "2026-03-15", 12400,
            new(68, 42, 8, 6),
            new(18, 34, 12),
            new(4.2, -1.8, "Improved onboarding"),
            890),
        new("ret-2", "v3.1.5", "2026-02-28", 9800,
            new(62, 38, 2, 1),
            new(16, 28, 3),
            new(5.8, -0.4, "Bug fixes"),
            340),
        new("ret-3", "v3.1.0", "2026-02-10", 15600,
            new(58, 35, -4, -3),
            new(14, 19, -8),
            new(7.2, 1.4, "Performance issues"),
            120),
        new("ret-4", "v3.0.0", "2026-01-20", 18900,
            new(64, 40, 4, 4),
            new(17, 45, 15),
            new(5.6, -2.1, "Major redesign appeal"),
            1240),
        new("ret-5", "v2.9.2", "2026-01-05", 11200,
            new(60, 36, 0, -1),
            new(15, 22, 1),
            new(6.2, 0.2, "Neutral impact"),
            280),
    ];

    private string _timeFilter = "all";
    private string? _expandedId;

    private List<RetentionRelease> _filteredReleases => _releases
        .Where(r => _timeFilter switch
        {
            "positive" => r.Retention.Day30Delta > 0,
            "negative" => r.Retention.Day30Delta < 0,
            _ => true,
        })
        .ToList();

    private void OnFilterChange(ChangeEventArgs e)
    {
        _timeFilter = e.Value?.ToString() ?? "all";
        _expandedId = null;
    }

    private void ToggleExpanded(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }
}
