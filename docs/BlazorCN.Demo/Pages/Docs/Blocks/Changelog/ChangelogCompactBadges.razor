@* ============================================================
   Block: changelog-compact-badges
   Title: ChangelogCompactBadges
   Description: React compact badge changelog block for Next.js with dense entry list, version badges, and category indicators built with TypeScript, Framer Motion, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-compact-badges.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="list" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Changelog</h2>
            </div>
            <span class="font-mono text-xs text-muted-foreground">@_entries.Length entries</span>
        </div>

        <div>
            @for (var i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                var config = _categoryConfig[entry.Category];
                var borderB = i < _entries.Length - 1 ? "border-b" : "";
                <div class="@($"flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50 {borderB}")">
                    <BadgeCn Variant="@config.Variant" Class="shrink-0 px-1.5 py-0 text-[10px]">
                        @config.Label
                    </BadgeCn>
                    <span class="min-w-0 flex-1 truncate text-sm">@entry.Title</span>
                    <span class="shrink-0 font-mono text-xs text-muted-foreground">
                        @entry.Version
                    </span>
                    <span class="shrink-0 text-xs text-muted-foreground">@entry.Date</span>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ChangeEntry(string Id, string Title, string Version, string Category, string Date);
    private record CategoryInfo(string Label, BadgeVariant Variant);

    private static readonly Dictionary<string, CategoryInfo> _categoryConfig = new()
    {
        ["feature"]     = new("Feature",     BadgeVariant.Default),
        ["fix"]         = new("Fix",         BadgeVariant.Secondary),
        ["improvement"] = new("Improvement", BadgeVariant.Outline),
        ["breaking"]    = new("Breaking",    BadgeVariant.Destructive),
    };

    private static readonly ChangeEntry[] _entries =
    [
        new("1",  "Added batch import for CSV and JSON files",        "v4.1.0", "feature",     "Mar 28"),
        new("2",  "Fixed timezone offset in scheduled reports",        "v4.1.0", "fix",         "Mar 28"),
        new("3",  "Reduced API response time for list endpoints",      "v4.0.9", "improvement", "Mar 27"),
        new("4",  "Removed deprecated /v1/users endpoint",            "v4.0.9", "breaking",    "Mar 27"),
        new("5",  "Custom domain support for workspaces",              "v4.0.8", "feature",     "Mar 25"),
        new("6",  "Fixed duplicate webhook deliveries on retry",       "v4.0.8", "fix",         "Mar 25"),
        new("7",  "Improved search relevance scoring algorithm",       "v4.0.7", "improvement", "Mar 23"),
        new("8",  "Added granular notification preferences",           "v4.0.7", "feature",     "Mar 23"),
        new("9",  "Fixed memory leak in real-time sync worker",        "v4.0.6", "fix",         "Mar 21"),
        new("10", "Auth token format changed to EdDSA signing",        "v4.0.6", "breaking",    "Mar 21"),
        new("11", "Inline editing for table cells",                    "v4.0.5", "feature",     "Mar 19"),
        new("12", "Optimized image thumbnail generation pipeline",     "v4.0.5", "improvement", "Mar 19"),
    ];
}
