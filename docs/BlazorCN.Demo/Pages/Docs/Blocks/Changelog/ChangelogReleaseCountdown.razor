@* ============================================================
   Block: changelog-release-countdown
   Title: ChangelogReleaseCountdown
   Description: A countdown timer changelog showing time until next release with scheduled features and version details using React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-release-countdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b bg-muted/50 px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Next Release</h2>
                <BadgeCn Variant="BadgeVariant.Outline" Class="ml-auto">
                    v3.0.0
                </BadgeCn>
            </div>
        </div>

        <div class="border-b px-4 py-6">
            <div class="mb-4 flex items-center justify-center gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="calendar" Size="14" Class="size-3.5" />
                <span>Scheduled for April 12, 2026 at 10:00 AM PT</span>
            </div>

            <div class="grid grid-cols-4 gap-3">
                @foreach (var unit in _timeUnits)
                {
                    <div class="flex flex-col items-center gap-2 rounded-md bg-muted/50 p-3">
                        <div class="text-2xl font-semibold tabular-nums">
                            @unit.Value.ToString().PadLeft(2, '0')
                        </div>
                        <div class="text-xs text-muted-foreground">@unit.Label</div>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-sm font-medium">Scheduled Features</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 px-1.5 text-xs">
                        @_scheduledFeatures.Length
                    </BadgeCn>
                </div>
            </div>
        </div>

        <div class="max-h-80 overflow-y-auto" tabindex="0" role="group" aria-label="Scheduled features">
            @for (var idx = 0; idx < _scheduledFeatures.Length; idx++)
            {
                var feature = _scheduledFeatures[idx];
                var rowClass = Cn.Merge("flex items-center gap-3 px-4 py-3", idx != _scheduledFeatures.Length - 1 ? "border-b" : "");
                <div class="@rowClass">
                    <div class="flex size-5 shrink-0 items-center justify-center rounded-sm bg-muted/50">
                        <LucideIconCn Name="check" Size="12" Class="size-3 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="text-sm">@feature.Title</p>
                    </div>
                    <BadgeCn Variant="BadgeVariant.Outline" Class="shrink-0 text-xs">
                        @feature.Category
                    </BadgeCn>
                </div>
            }
        </div>

        <div class="border-t bg-muted/50 px-4 py-3">
            <div class="flex items-center gap-2">
                <ButtonCn Size="ButtonSize.Sm"
                          Class="h-8 flex-1 gap-1.5"
                          Variant="@(_subscribed ? ButtonVariant.Outline : ButtonVariant.Default)"
                          OnClick="@(() => _subscribed = !_subscribed)">
                    @if (_subscribed)
                    {
                        <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                        <span>Subscribed to updates</span>
                    }
                    else
                    {
                        <LucideIconCn Name="bell" Size="14" Class="size-3.5" />
                        <span>Notify me at launch</span>
                    }
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record ScheduledFeature(string Id, string Title, string Category);
    private record TimeUnit(int Value, string Label);

    private static readonly ScheduledFeature[] _scheduledFeatures =
    [
        new("1", "Real-time collaboration with cursors", "Editor"),
        new("2", "Advanced AI code completion", "AI"),
        new("3", "Team workspaces with role permissions", "Teams"),
        new("4", "Git integration with visual diff", "Version Control"),
        new("5", "Custom component library manager", "UI"),
        new("6", "Performance profiler dashboard", "DevTools"),
        new("7", "Dark mode theme customization", "Design"),
        new("8", "Export to Figma plugin", "Integration"),
    ];

    private static readonly TimeUnit[] _timeUnits =
    [
        new(12, "Days"),
        new(8, "Hours"),
        new(34, "Minutes"),
        new(57, "Seconds"),
    ];

    private bool _subscribed = false;
}
