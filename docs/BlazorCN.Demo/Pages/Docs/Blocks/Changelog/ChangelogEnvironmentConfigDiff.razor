@* ============================================================
   Block: changelog-environment-config-diff
   Title: ChangelogEnvironmentConfigDiff
   Description: A side-by-side environment configuration comparison tool for staging vs production using React, Next.js, shadcn/ui components, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-environment-config-diff.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Environment Configuration</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Compare staging and production settings
                    </p>
                </div>
                <div class="flex items-center gap-2">
                    @if (_mismatchCount > 0)
                    {
                        <BadgeCn Class="h-5 gap-1 bg-amber-500/10 text-amber-600 text-xs">
                            <LucideIconCn Name="alert-triangle" Size="12" Class="size-3" />
                            @_mismatchCount differences
                        </BadgeCn>
                    }
                    <ButtonCn Variant="ButtonVariant.Outline" Class="h-7 gap-1.5 px-2 text-xs">
                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                        Export Diff
                    </ButtonCn>
                </div>
            </div>
        </div>

        <div class="border-b bg-muted/20 px-4 py-2">
            <div class="grid grid-cols-[1fr_1fr_1fr] gap-3">
                <div class="text-xs font-medium text-muted-foreground">Configuration Key</div>
                <div class="flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                    <LucideIconCn Name="server" Size="12" Class="size-3" />
                    Staging
                </div>
                <div class="flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                    <LucideIconCn Name="server" Size="12" Class="size-3" />
                    Production
                </div>
            </div>
        </div>

        <div>
            @for (var i = 0; i < _categories.Length; i++)
            {
                var category = _categories[i];
                var categoryConfigs = _configDiffs.Where(d => d.Category == category).ToArray();
                var isExpanded = _expandedCategory == category;
                var divClass = i != _categories.Length - 1 ? "border-b" : "";
                var chevronClass = Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
                var cat = category;
                <div class="@divClass">
                    <button
                        type="button"
                        @onclick="@(() => ToggleCategory(cat))"
                        class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="settings" Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm font-medium">@category</span>
                        </div>
                        <BadgeCn Class="ml-auto h-4 bg-muted/50 text-muted-foreground text-xs">
                            @categoryConfigs.Length
                        </BadgeCn>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/20 px-4 py-2">
                            @for (var j = 0; j < categoryConfigs.Length; j++)
                            {
                                var config = categoryConfigs[j];
                                var isLastConfig = j == categoryConfigs.Length - 1;
                                var configRowClass = Cn.Merge("grid grid-cols-[1fr_1fr_1fr] gap-3 py-2.5", !isLastConfig ? "border-b" : "");
                                var stagingClass = Cn.Merge("rounded-md px-2 py-1.5", config.Status == "mismatch" ? "bg-amber-500/10" : "");
                                var productionClass = Cn.Merge("rounded-md px-2 py-1.5", config.Status == "mismatch" ? "bg-amber-500/10" : "");
                                var alertIconClass = Cn.Merge("size-3.5", config.Severity == "critical" ? "text-red-500" : "text-amber-500");
                                var severityBadgeClass = Cn.Merge("ml-1.5 h-4 text-xs", config.Severity == "critical" ? "bg-red-500/10 text-red-600" : "bg-amber-500/10 text-amber-600");
                                <div class="@configRowClass">
                                    <div class="flex items-start gap-2">
                                        <div class="mt-0.5 flex size-4 shrink-0 items-center justify-center">
                                            @if (config.Status == "match")
                                            {
                                                <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500" />
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="alert-triangle" Size="14" Class="@alertIconClass" />
                                            }
                                        </div>
                                        <div>
                                            <span class="font-mono text-xs">@config.Key</span>
                                            @if (config.Severity != null)
                                            {
                                                <BadgeCn Class="@severityBadgeClass">@config.Severity</BadgeCn>
                                            }
                                        </div>
                                    </div>
                                    <div class="@stagingClass">
                                        <span class="font-mono text-xs">@config.Staging</span>
                                    </div>
                                    <div class="@productionClass">
                                        <span class="font-mono text-xs">@config.Production</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ConfigDiff(
        string Key,
        string Category,
        string Staging,
        string Production,
        string Status,
        string? Severity = null
    );

    private string? _expandedCategory;

    private int _mismatchCount => _configDiffs.Count(d => d.Status == "mismatch");

    private void ToggleCategory(string category)
    {
        _expandedCategory = _expandedCategory == category ? null : category;
    }

    private static readonly ConfigDiff[] _configDiffs =
    [
        new("API_BASE_URL",                 "API Endpoints",   "https://api-staging.example.com",    "https://api.example.com",     "match"),
        new("DATABASE_POOL_SIZE",           "Database",        "10",                                  "50",                          "mismatch", "warning"),
        new("REDIS_URL",                    "Cache",           "redis://staging-cache:6379",          "redis://prod-cache:6379",     "match"),
        new("FEATURE_FLAG_NEW_DASHBOARD",   "Feature Flags",   "true",                                "false",                       "mismatch", "warning"),
        new("LOG_LEVEL",                    "Logging",         "debug",                               "error",                       "mismatch", "critical"),
        new("MAX_UPLOAD_SIZE_MB",           "Limits",          "50",                                  "100",                         "mismatch", "warning"),
        new("STRIPE_PUBLISHABLE_KEY",       "Payments",        "pk_test_••••••••••••", "pk_live_••••••••••••", "match"),
        new("SESSION_TIMEOUT_MINUTES",      "Auth",            "30",                                  "30",                          "match"),
        new("ENABLE_EMAIL_NOTIFICATIONS",   "Notifications",   "true",                                "true",                        "match"),
    ];

    private static readonly string[] _categories =
        _configDiffs.Select(d => d.Category).Distinct().ToArray();
}
