@* ============================================================
   Block: changelog-preview-deployments
   Title: ChangelogPreviewDeployments
   Description: A changelog block tracking preview deployment URLs, branch status, and deployment health for pull request workflows built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-preview-deployments.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Preview Deployments</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Ephemeral environments for pull requests
                    </p>
                </div>
                <LucideIconCn Name="globe" Size="16" Class="size-4 text-muted-foreground" />
            </div>
        </div>

        @* Stats *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-4 gap-4">
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Ready</span>
                    </div>
                    <p class="mt-1 font-semibold tabular-nums text-2xl">@_readyCount</p>
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Building</span>
                    </div>
                    <p class="mt-1 font-semibold tabular-nums text-2xl">@_buildingCount</p>
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="x-circle" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Failed</span>
                    </div>
                    <p class="mt-1 font-semibold tabular-nums text-2xl">@_failedCount</p>
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="git-branch" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Total PRs</span>
                    </div>
                    <p class="mt-1 font-semibold tabular-nums text-2xl">@_deployments.Length</p>
                </div>
            </div>
        </div>

        @* Deployment list *@
        <div>
            @foreach (var dep in _deployments)
            {
                var deployment = dep;
                var isExpanded = _expandedId == deployment.Id;
                var isLast = deployment.Id == _deployments[^1].Id;
                var statusColor = GetStatusColor(deployment.Status);
                var statusLabel = GetStatusLabel(deployment.Status);
                var statusIconName = GetStatusIconName(deployment.Status);
                var statusBadgeClass = GetStatusBadgeClass(deployment.Status);
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => ToggleExpanded(deployment.Id))">
                        <div class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-md", statusColor)">
                            <LucideIconCn Name="@statusIconName" Size="16" Class="size-4" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@deployment.Branch</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 border-0 bg-muted/50 px-1.5 text-[10px]">
                                    #@deployment.PrNumber
                                </BadgeCn>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("h-4 border-0 px-1.5 text-[10px]", statusBadgeClass)">
                                    @statusLabel
                                </BadgeCn>
                            </div>
                            <div class="mt-0.5 flex items-center gap-3 text-xs text-muted-foreground">
                                <span>@deployment.Author</span>
                                <span>•</span>
                                <span>@deployment.CreatedAt</span>
                                @if (deployment.Status == "ready")
                                {
                                    <span>•</span>
                                    <span class="tabular-nums">@deployment.BuildTime</span>
                                }
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/30 px-4 py-3">
                            <div class="space-y-3">
                                <div>
                                    <span class="text-xs font-medium text-muted-foreground">
                                        Commit Message
                                    </span>
                                    <p class="mt-1 text-sm">@deployment.CommitMessage</p>
                                </div>

                                @if (deployment.Status == "ready" && !string.IsNullOrEmpty(deployment.Url))
                                {
                                    <div>
                                        <span class="text-xs font-medium text-muted-foreground">
                                            Preview URL
                                        </span>
                                        <div class="mt-1 flex items-center gap-2 rounded-md border bg-card px-3 py-2">
                                            <LucideIconCn Name="globe" Size="12" Class="size-3 text-muted-foreground" />
                                            <span class="flex-1 font-mono text-xs text-muted-foreground">
                                                @deployment.Url
                                            </span>
                                            <ButtonCn Variant="ButtonVariant.Ghost" Class="h-6 gap-1 px-2 text-xs">
                                                <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                                                Visit
                                            </ButtonCn>
                                        </div>
                                    </div>
                                }

                                @if (deployment.Status == "failed")
                                {
                                    <div class="rounded-md bg-red-500/10 p-3">
                                        <div class="flex items-start gap-2">
                                            <LucideIconCn Name="x-circle" Size="16" Class="mt-0.5 size-4 shrink-0 text-red-600" />
                                            <div>
                                                <span class="font-medium text-red-600 text-sm">Build Failed</span>
                                                <p class="mt-1 text-xs text-red-600/80">
                                                    The deployment failed during the build step. Check build logs for
                                                    details.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                }

                                @if (deployment.Status == "building")
                                {
                                    <div class="rounded-md bg-blue-500/10 p-3">
                                        <div class="flex items-start gap-2">
                                            <LucideIconCn Name="clock" Size="16" Class="mt-0.5 size-4 shrink-0 text-blue-600" />
                                            <div>
                                                <span class="font-medium text-blue-600 text-sm">
                                                    Build in Progress
                                                </span>
                                                <p class="mt-1 text-xs text-blue-600/80">
                                                    Preview URL will be available once the build completes.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                }

                                @if (deployment.Status == "queued")
                                {
                                    <div class="rounded-md bg-amber-500/10 p-3">
                                        <div class="flex items-start gap-2">
                                            <LucideIconCn Name="clock" Size="16" Class="mt-0.5 size-4 shrink-0 text-amber-600" />
                                            <div>
                                                <span class="font-medium text-amber-600 text-sm">Queued</span>
                                                <p class="mt-1 text-xs text-amber-600/80">
                                                    Waiting for available build capacity.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-xs text-muted-foreground">
                    @_deployments.Length active previews • Avg build time: 2m 22s
                </span>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="h-7 gap-1.5 px-2 text-xs">
                    View All PRs
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record Deployment(
        string Id, string Branch, int PrNumber, string Url,
        string Status, string Author, string CreatedAt,
        string BuildTime, string CommitMessage);

    private static readonly Deployment[] _deployments =
    [
        new("1", "feat/new-dashboard", 142, "feat-new-dashboard-a8c3f2.preview.acme.dev",
            "ready", "Sarah Chen", "2 hours ago", "2m 15s", "Add revenue analytics dashboard"),
        new("2", "fix/api-timeout", 138, "fix-api-timeout-9d2e1b.preview.acme.dev",
            "ready", "Marcus Rodriguez", "4 hours ago", "1m 45s", "Increase API gateway timeout to 30s"),
        new("3", "feat/user-onboarding", 135, "feat-user-onboarding-7f5a3c.preview.acme.dev",
            "building", "Alex Thompson", "10 minutes ago", "—", "Implement multi-step onboarding flow"),
        new("4", "refactor/auth-module", 129, "refactor-auth-module-4b8d9a.preview.acme.dev",
            "failed", "Jamie Kim", "1 day ago", "—", "Refactor authentication middleware"),
        new("5", "feat/team-collaboration", 127, "feat-team-collaboration-6e2c1f.preview.acme.dev",
            "ready", "Taylor Morgan", "2 days ago", "3m 30s", "Add real-time team workspace features"),
        new("6", "fix/mobile-responsive", 124, "",
            "queued", "Jordan Lee", "5 minutes ago", "—", "Fix mobile layout issues on checkout"),
    ];

    private string? _expandedId;

    private int _readyCount => _deployments.Count(d => d.Status == "ready");
    private int _buildingCount => _deployments.Count(d => d.Status == "building");
    private int _failedCount => _deployments.Count(d => d.Status == "failed");

    private static string GetStatusColor(string status) => status switch
    {
        "ready" => "text-emerald-600",
        "building" => "text-blue-600",
        "failed" => "text-red-600",
        "queued" => "text-amber-600",
        _ => ""
    };

    private static string GetStatusIconName(string status) => status switch
    {
        "ready" => "check-circle-2",
        "building" => "clock",
        "failed" => "x-circle",
        "queued" => "clock",
        _ => "clock"
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "ready" => "Ready",
        "building" => "Building",
        "failed" => "Failed",
        "queued" => "Queued",
        _ => status
    };

    private static string GetStatusBadgeClass(string status) => status switch
    {
        "ready" => "bg-emerald-500/10 text-emerald-600",
        "building" => "bg-blue-500/10 text-blue-600",
        "failed" => "bg-red-500/10 text-red-600",
        "queued" => "bg-amber-500/10 text-amber-600",
        _ => ""
    };

    private void ToggleExpanded(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }
}
