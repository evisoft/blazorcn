@* ============================================================
   Block: changelog-emoji-categories
   Title: ChangelogEmojiCategories
   Description: React emoji-categorized changelog block for Next.js with tagged entries, category indicators, and stagger animations built with TypeScript, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-emoji-categories.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Changelog</h2>
            <span class="text-xs text-muted-foreground">March 2026</span>
        </div>

        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            @foreach (var cat in _categories)
            {
                <div class="flex items-center gap-1.5">
                    <span class="@Cn.Merge("size-1.5 rounded-full", cat.DotColor)"></span>
                    <span class="text-xs text-muted-foreground">@cat.Label</span>
                </div>
            }
        </div>

        <div>
            @for (var i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                var cat = _categoryMap.TryGetValue(entry.Category, out var c) ? c : null;
                var rowClass = Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", i < _entries.Length - 1 ? "border-b" : "");
                <div class="@rowClass">
                    <div class="flex items-start gap-3">
                        <span class="mt-0.5 text-base leading-none">@(cat?.Emoji ?? "")</span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@entry.Title</span>
                                <span class="shrink-0 font-mono text-xs text-muted-foreground">@entry.Version</span>
                            </div>
                            <p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">
                                @entry.Description
                            </p>
                        </div>
                        <span class="shrink-0 text-xs text-muted-foreground">@entry.Date</span>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record CategoryInfo(string Key, string Emoji, string Label, string DotColor);
    private record ChangeEntry(string Id, string Category, string Title, string Description, string Date, string Version);

    private static readonly CategoryInfo[] _categories =
    [
        new("feature",     "✨", "Feature",     "bg-blue-500"),
        new("fix",         "🐛", "Fix",         "bg-red-500"),
        new("improvement", "⚡", "Improvement", "bg-amber-500"),
        new("security",    "🔒", "Security",    "bg-emerald-500"),
    ];

    private static readonly Dictionary<string, CategoryInfo> _categoryMap =
        _categories.ToDictionary(c => c.Key);

    private static readonly ChangeEntry[] _entries =
    [
        new("1", "feature",     "Team workspace sharing",
            "Invite team members to collaborate on shared workspaces with role-based permissions and real-time sync.",
            "Mar 28", "v3.2.0"),
        new("2", "security",    "SOC 2 Type II compliance",
            "All data endpoints now enforce encryption at rest and in transit. Audit logs retained for 90 days.",
            "Mar 27", "v3.2.0"),
        new("3", "fix",         "CSV export missing columns",
            "Fixed an issue where custom fields were omitted from CSV exports when the dataset exceeded 10,000 rows.",
            "Mar 25", "v3.1.4"),
        new("4", "improvement", "Dashboard loading speed",
            "Reduced initial dashboard render time by 40% through query optimization and component lazy loading.",
            "Mar 24", "v3.1.3"),
        new("5", "feature",     "Webhook event filtering",
            "Configure webhook subscriptions to receive only specific event types instead of all workspace events.",
            "Mar 22", "v3.1.2"),
        new("6", "fix",         "OAuth token refresh loop",
            "Resolved infinite refresh loop when the identity provider returns a 503 during token renewal.",
            "Mar 20", "v3.1.1"),
        new("7", "improvement", "Search indexing for attachments",
            "File attachments are now full-text indexed. Search results include matching content from PDFs and documents.",
            "Mar 18", "v3.1.0"),
        new("8", "security",    "API key rotation policy",
            "API keys older than 90 days trigger a rotation reminder. Admins can enforce mandatory rotation intervals.",
            "Mar 16", "v3.0.9"),
    ];
}
