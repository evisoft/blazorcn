@* ============================================================
   Block: changelog-infrastructure-cost
   Title: ChangelogInfrastructureCost
   Description: Infrastructure cost changes per release with delta indicators and budget alerts, built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-infrastructure-cost.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="dollar-sign" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Infrastructure Cost</h2>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">v4.2.0</BadgeCn>
        </div>

        @* Summary *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start justify-between">
                <div>
                    <p class="text-xs text-muted-foreground">Monthly Cost</p>
                    <p class="text-2xl font-semibold tabular-nums">@FormatCurrency(_totalCurrent)</p>
                </div>
                <div class="text-right">
                    <p class="text-xs text-muted-foreground">vs Previous Release</p>
                    <div class="@Cn.Merge("flex items-center gap-1 text-sm font-medium tabular-nums", _totalChange > 0 ? "text-red-500" : _totalChange < 0 ? "text-emerald-500" : "text-muted-foreground")">
                        @if (_totalChange > 0)
                        {
                            <LucideIconCn Name="arrow-up" Size="16" Class="size-4" />
                        }
                        else if (_totalChange < 0)
                        {
                            <LucideIconCn Name="arrow-down" Size="16" Class="size-4" />
                        }
                        @(_totalChange > 0 ? "+" : "")@(_totalChange.ToString("F2"))%
                    </div>
                </div>
            </div>
            @if (_totalChange < 0)
            {
                <div class="mt-2 flex items-center gap-2 rounded-md bg-emerald-500/10 p-2">
                    <LucideIconCn Name="trending-down" Size="12" Class="size-3 text-emerald-500" />
                    <p class="text-xs text-emerald-500">
                        Cost reduced by @FormatCurrency(_totalPrevious - _totalCurrent) this release
                    </p>
                </div>
            }
        </div>

        @* Cost Breakdown *@
        <div class="divide-y">
            @foreach (var costItem in _costData)
            {
                var item = costItem;
                <div class="px-4 py-3 transition-colors hover:bg-muted/50">
                    <div class="flex items-center justify-between">
                        <div class="flex-1">
                            <h3 class="text-sm font-medium">@item.Service</h3>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                Previous: @FormatCurrency(item.Previous)
                            </p>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="text-right">
                                <p class="text-sm font-medium tabular-nums">@FormatCurrency(item.Current)</p>
                                <div class="@Cn.Merge("mt-0.5 flex items-center justify-end gap-1 text-xs tabular-nums", item.Change > 0 ? "text-red-500" : item.Change < 0 ? "text-emerald-500" : "text-muted-foreground")">
                                    @if (item.Change > 0)
                                    {
                                        <LucideIconCn Name="arrow-up" Size="12" Class="size-3" />
                                    }
                                    else if (item.Change < 0)
                                    {
                                        <LucideIconCn Name="arrow-down" Size="12" Class="size-3" />
                                    }
                                    @(item.Change > 0 ? "+" : "")@(item.Change.ToString("F2"))%
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Total *@
        <div class="flex items-center justify-between border-t bg-muted/50 px-4 py-3">
            <span class="text-sm font-medium">Total Monthly Cost</span>
            <div class="flex items-center gap-3">
                <span class="text-sm font-semibold tabular-nums">@FormatCurrency(_totalCurrent)</span>
                <div class="@Cn.Merge("flex items-center gap-1 text-xs font-medium tabular-nums", _totalChange > 0 ? "text-red-500" : _totalChange < 0 ? "text-emerald-500" : "text-muted-foreground")">
                    @if (_totalChange > 0)
                    {
                        <LucideIconCn Name="arrow-up" Size="12" Class="size-3" />
                    }
                    else if (_totalChange < 0)
                    {
                        <LucideIconCn Name="arrow-down" Size="12" Class="size-3" />
                    }
                    @(_totalChange > 0 ? "+" : "")@(_totalChange.ToString("F2"))%
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private record CostItem(string Service, int Current, int Previous, double Change);

    private static readonly CostItem[] _costData =
    [
        new("AWS EC2",          1240, 1180,   5.08),
        new("AWS RDS",           890,  890,   0.0),
        new("AWS S3",            320,  380, -15.79),
        new("CloudFront CDN",    580,  620,  -6.45),
        new("Lambda Functions",  150,  140,   7.14),
        new("ElastiCache",       420,  420,   0.0),
    ];

    private static readonly int _totalCurrent  = _costData.Sum(x => x.Current);
    private static readonly int _totalPrevious = _costData.Sum(x => x.Previous);
    private static readonly double _totalChange =
        ((_totalCurrent - _totalPrevious) / (double)_totalPrevious) * 100.0;

    private static string FormatCurrency(int amount) => $"${amount:N0}";
}
