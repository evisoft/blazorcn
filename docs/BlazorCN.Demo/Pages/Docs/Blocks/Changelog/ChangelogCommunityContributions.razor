@* ============================================================
   Block: changelog-community-contributions
   Title: ChangelogCommunityContributions
   Description: A changelog block showcasing community and open-source pull requests with contributor avatars, PR titles, first contribution badges, and merged dates using staggered animations.
   Source: original/blocks/changelog/changelog-community-contributions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="heart-handshake" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Community Contributions</h2>
            <span class="ml-auto text-xs text-muted-foreground">
                @_contributions.Length merged PRs
            </span>
        </div>

        @* Stats bar *@
        <div class="flex items-center gap-3 border-b px-4 py-2">
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="git-merge" Size="12" Class="size-3 text-purple-500" />
                <span class="text-xs text-muted-foreground">@_contributions.Length merged</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500" />
                <span class="text-xs text-muted-foreground">
                    @_firstTimers first-time contributors
                </span>
            </div>
        </div>

        @* Contributions list *@
        @for (int i = 0; i < _contributions.Length; i++)
        {
            var contribution = _contributions[i];
            var index = i;
            var isExpanded = _expanded == contribution.Id;
            var avatarClass = Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full text-xs font-medium", _avatarColors[index % _avatarColors.Length]);
            var chevronClass = Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
            var captureId = contribution.Id;
            <div class="border-b last:border-b-0">
                <button
                    type="button"
                    @onclick="@(() => ToggleExpanded(captureId))"
                    class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                    <div class="@avatarClass">
                        @contribution.Initials
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="truncate text-sm font-medium">@contribution.PrTitle</span>
                            @if (contribution.IsFirstContribution)
                            {
                                <span class="shrink-0 rounded-full bg-emerald-500/10 px-1.5 py-0.5 text-[10px] font-medium leading-none text-emerald-600">
                                    First contribution
                                </span>
                            }
                        </div>
                        <div class="mt-0.5 flex items-center gap-2">
                            <span class="text-xs text-muted-foreground">
                                @contribution.Contributor
                            </span>
                            <span class="text-xs text-muted-foreground">&middot;</span>
                            <span class="font-mono text-xs text-muted-foreground">
                                #@contribution.PrNumber
                            </span>
                            <span class="text-xs text-muted-foreground">&middot;</span>
                            <span class="text-xs text-muted-foreground">@contribution.MergedDate</span>
                        </div>
                    </div>
                    <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                </button>

                @if (isExpanded)
                {
                    <div class="border-t bg-muted/30 px-4 py-3">
                        <p class="text-xs text-muted-foreground">@contribution.Description</p>
                        <div class="mt-2 flex items-center gap-1.5">
                            @foreach (var label in contribution.Labels)
                            {
                                <span class="rounded-full bg-muted px-2 py-0.5 text-[10px] font-medium text-muted-foreground">
                                    @label
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</section>

@code {
    private record Contribution(
        string Id,
        string Contributor,
        string Initials,
        string PrTitle,
        int PrNumber,
        string Description,
        bool IsFirstContribution,
        string MergedDate,
        string[] Labels
    );

    private string? _expanded;

    private void ToggleExpanded(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private static readonly string[] _avatarColors =
    [
        "bg-blue-500/10 text-blue-600",
        "bg-purple-500/10 text-purple-600",
        "bg-amber-500/10 text-amber-600",
        "bg-emerald-500/10 text-emerald-600",
        "bg-rose-500/10 text-rose-600",
        "bg-cyan-500/10 text-cyan-600",
    ];

    private static readonly Contribution[] _contributions =
    [
        new("c1", "Lina Takahashi", "LT",
            "Add RTL support to Sidebar component", 1847,
            "Implemented bidirectional layout support for the sidebar including mirrored icons, reversed slide animations, and proper logical properties.",
            false, "Mar 28, 2026",
            ["enhancement", "accessibility"]),
        new("c2", "Dmitri Volkov", "DV",
            "Fix timezone offset in DatePicker", 1842,
            "Resolved an issue where dates were shifted by one day in negative UTC offsets. Added timezone-aware date normalization.",
            true, "Mar 27, 2026",
            ["bug fix"]),
        new("c3", "Amara Osei", "AO",
            "Add keyboard shortcuts to CommandMenu", 1835,
            "Added configurable keyboard shortcut hints displayed alongside menu items. Supports both Mac and Windows modifier key formats.",
            false, "Mar 25, 2026",
            ["enhancement"]),
        new("c4", "Raj Mehta", "RM",
            "Improve Table virtualization for 10k+ rows", 1829,
            "Replaced fixed-height row assumption with dynamic measurement using ResizeObserver. Reduces initial render time by 60% on large datasets.",
            true, "Mar 24, 2026",
            ["performance"]),
        new("c5", "Sophie Laurent", "SL",
            "Add French translations to i18n bundle", 1821,
            "Complete French locale translation covering all 340 UI strings. Includes plural form handling and date format localization.",
            false, "Mar 22, 2026",
            ["i18n"]),
        new("c6", "James Okonkwo", "JO",
            "Fix color contrast in high-contrast mode", 1818,
            "Updated 23 components to meet WCAG AAA contrast ratios when Windows high contrast mode is active. Added forced-colors media query support.",
            true, "Mar 20, 2026",
            ["accessibility", "bug fix"]),
    ];

    private int _firstTimers => _contributions.Count(c => c.IsFirstContribution);
}
