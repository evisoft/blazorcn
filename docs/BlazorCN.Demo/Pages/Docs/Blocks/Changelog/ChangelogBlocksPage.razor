                @if (_totalSkipped > 0)
                {
                    <div class=""flex items-center gap-1"">
                        <LucideIconCn Name=""clock"" Size=""12"" Class=""size-3 text-muted-foreground"" />
                        <span class=""text-muted-foreground"">
