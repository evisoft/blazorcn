@* ============================================================
   Block: changelog-release-train
   Title: ChangelogReleaseTrain
   Description: A release train schedule display with version lanes, deployment windows, and environment progression tracking built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-release-train.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="train" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Release Train Schedule</h2>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">
                Continuous delivery pipeline · Next deploy window in 2 hours
            </p>
        </div>

        @* Summary Stats *@
        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="calendar" Size="12" Class="size-3 text-muted-foreground" />
                    <p class="text-xs text-muted-foreground">Scheduled</p>
                </div>
                <p class="mt-1 font-semibold tabular-nums text-2xl">@_releases.Length</p>
            </div>
            <div class="border-r px-4 py-3">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="loader-2" Size="12" Class="size-3 text-muted-foreground" />
                    <p class="text-xs text-muted-foreground">In Progress</p>
                </div>
                <p class="mt-1 font-semibold tabular-nums text-2xl text-blue-500">@_activeReleases</p>
            </div>
            <div class="px-4 py-3">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="alert-circle" Size="12" Class="size-3 text-muted-foreground" />
                    <p class="text-xs text-muted-foreground">Blockers</p>
                </div>
                <p class="mt-1 font-semibold tabular-nums text-2xl text-amber-500">@_totalBlockers</p>
            </div>
        </div>

        @* Releases List *@
        <div>
            @foreach (var it in _releases)
            {
                var release = it;
                var isExpanded = _expandedRelease == release.Id;
                var isLast = release.Id == _releases[^1].Id;
                var currentEnv = Array.Find(release.Environments, e => e.Status == "in-progress");
                var rowClass = isLast ? "" : "border-b";
                <div class="@rowClass">
                    <button
                        type="button"
                        @onclick="@(() => Toggle(release.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex shrink-0 items-center gap-2">
                            <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("text-xs", GetTypeColors(release.Type))">
                                @release.Type
                            </BadgeCn>
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <code class="font-mono text-sm font-medium">@release.Version</code>
                                @if (release.Blockers > 0)
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 border-amber-500/20 bg-amber-500/10 text-amber-500 text-xs">
                                        <LucideIconCn Name="alert-circle" Size="10" Class="size-2.5" />
                                        @release.Blockers
                                    </BadgeCn>
                                }
                            </div>
                            <div class="mt-0.5 flex items-center gap-3 text-xs text-muted-foreground">
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                    @release.ScheduledDate
                                </span>
                                <span>·</span>
                                <span>@release.CommitsCount commits</span>
                                @if (currentEnv != null)
                                {
                                    <span>·</span>
                                    <span class="text-blue-500">Deploying to @currentEnv.Name</span>
                                }
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/30">
                            <div class="space-y-3 px-4 py-3">
                                <div>
                                    <p class="mb-2 text-xs font-medium text-muted-foreground">
                                        Deployment Pipeline
                                    </p>
                                    <div class="space-y-1.5">
                                        @foreach (var env in release.Environments)
                                        {
                                            <div class="flex items-center gap-3 rounded-md bg-muted/50 px-3 py-2">
                                                <div class="flex size-5 shrink-0 items-center justify-center">
                                                    @if (env.Status == "deployed")
                                                    {
                                                        <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-500" />
                                                    }
                                                    @if (env.Status == "in-progress")
                                                    {
                                                        <LucideIconCn Name="loader-2" Size="16" Class="size-4 animate-spin text-blue-500" />
                                                    }
                                                    @if (env.Status == "pending")
                                                    {
                                                        <LucideIconCn Name="circle" Size="12" Class="size-3 text-muted-foreground" />
                                                    }
                                                    @if (env.Status == "blocked")
                                                    {
                                                        <LucideIconCn Name="alert-circle" Size="16" Class="size-4 text-amber-500" />
                                                    }
                                                </div>
                                                <div class="min-w-0 flex-1">
                                                    <p class="text-sm">@env.Name</p>
                                                    @if (env.DeployedAt != null)
                                                    {
                                                        <p class="mt-0.5 flex items-center gap-1 text-xs text-muted-foreground">
                                                            <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                                            @env.DeployedAt
                                                        </p>
                                                    }
                                                </div>
                                                <span class="@Cn.Merge("text-xs capitalize", GetEnvStatusClass(env.Status))">
                                                    @env.Status
                                                </span>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="flex gap-2">
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                        View Commits
                                    </ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                        Deployment Logs
                                    </ButtonCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ReleaseEnvironment(string Name, string Status, string? DeployedAt = null);
    private record Release(string Id, string Version, string Type, string ScheduledDate, ReleaseEnvironment[] Environments, int CommitsCount, int Blockers);

    private string? _expandedRelease;

    private int _activeReleases => Array.FindAll(_releases, r => Array.Exists(r.Environments, e => e.Status != "pending")).Length;
    private int _totalBlockers => _releases.Sum(r => r.Blockers);

    private void Toggle(string id)
    {
        _expandedRelease = _expandedRelease == id ? null : id;
    }

    private static string GetTypeColors(string type) => type switch
    {
        "major" => "border-red-500/20 bg-red-500/10 text-red-500",
        "minor" => "border-blue-500/20 bg-blue-500/10 text-blue-500",
        "patch" => "border-emerald-500/20 bg-emerald-500/10 text-emerald-500",
        _       => "",
    };

    private static string GetEnvStatusClass(string status) => status switch
    {
        "deployed"    => "text-emerald-500",
        "in-progress" => "text-blue-500",
        "blocked"     => "text-amber-500",
        _             => "text-muted-foreground",
    };

    private static readonly Release[] _releases =
    [
        new("v2.5.0", "v2.5.0", "minor", "Mar 30, 2026",
        [
            new("Development", "deployed",    "Mar 28, 14:23"),
            new("Staging",     "deployed",    "Mar 29, 09:15"),
            new("Production",  "in-progress"),
            new("Canary",      "pending"),
        ], 47, 0),
        new("v2.6.0", "v2.6.0", "minor", "Apr 6, 2026",
        [
            new("Development", "deployed",    "Mar 29, 16:45"),
            new("Staging",     "in-progress"),
            new("Production",  "pending"),
            new("Canary",      "pending"),
        ], 23, 1),
        new("v2.7.0", "v2.7.0", "minor", "Apr 13, 2026",
        [
            new("Development", "in-progress"),
            new("Staging",     "pending"),
            new("Production",  "pending"),
            new("Canary",      "pending"),
        ], 8, 0),
        new("v3.0.0", "v3.0.0", "major", "May 1, 2026",
        [
            new("Development", "pending"),
            new("Staging",     "pending"),
            new("Production",  "pending"),
            new("Canary",      "pending"),
        ], 0, 2),
    ];
}
