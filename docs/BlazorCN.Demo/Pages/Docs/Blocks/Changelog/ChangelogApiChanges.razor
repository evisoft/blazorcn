@* ============================================================
   Block: changelog-api-changes
   Title: ChangelogApiChanges
   Description: An API-specific changelog block built with React, Next.js, shadcn/ui, and Tailwind CSS showing endpoint changes with HTTP method badges and monospace paths
   Source: original/blocks/changelog/changelog-api-changes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="code" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">API Changes</h2>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto text-[10px]">v2.8.0</BadgeCn>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2.5">
            @foreach (var method in _methods)
            {
                var m = method;
                var btnClass = Cn.Merge("rounded-md px-2 py-1 text-[10px] font-semibold transition-colors", _activeMethod == m ? GetMethodColors(m) : "text-muted-foreground hover:text-foreground");
                <button
                    type="button"
                    @onclick="@(() => ToggleMethod(m))"
                    class="@btnClass">
                    @m
                </button>
            }
            <span class="ml-auto text-[10px] text-muted-foreground tabular-nums">
                @Filtered.Length endpoints
            </span>
        </div>

        <div>
            @foreach (var change in Filtered)
            {
                var dotClass = Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", GetKindDot(change.Kind));
                var methodSpanClass = Cn.Merge("shrink-0 rounded px-1.5 py-0.5 font-mono text-[10px] font-semibold", GetMethodColors(change.Method));
                var codeClass = Cn.Merge("truncate font-mono text-xs text-muted-foreground", change.Kind == "deprecated" ? "line-through" : "");
                <div class="border-b px-4 py-3 last:border-b-0">
                    <div class="flex items-start gap-3">
                        <span class="@dotClass"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@methodSpanClass">@change.Method</span>
                                <code class="@codeClass">@change.Path</code>
                            </div>
                            <p class="mt-1 text-xs text-muted-foreground leading-relaxed">@change.Description</p>
                        </div>
                        <span class="shrink-0 rounded-full bg-muted/50 px-2 py-0.5 text-[10px] text-muted-foreground capitalize">
                            @change.Kind
                        </span>
                    </div>
                </div>
            }
        </div>

        <div class="flex items-center gap-4 border-t bg-muted/30 px-4 py-2.5">
            @foreach (var kind in _kinds)
            {
                var legendDotClass = Cn.Merge("size-1.5 rounded-full", GetKindDot(kind));
                <div class="flex items-center gap-1.5">
                    <span class="@legendDotClass"></span>
                    <span class="text-[10px] text-muted-foreground capitalize">@kind</span>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ApiChange(
        string Id,
        string Method,
        string Path,
        string Description,
        string Kind,
        string Version
    );

    private string? _activeMethod;

    private static readonly string[] _methods = ["GET", "POST", "PATCH", "DELETE"];
    private static readonly string[] _kinds = ["added", "changed", "deprecated", "removed"];

    private ApiChange[] Filtered => _activeMethod is null
        ? _changes
        : [.. _changes.Where(c => c.Method == _activeMethod)];

    private void ToggleMethod(string method)
    {
        _activeMethod = _activeMethod == method ? null : method;
    }

    private static string GetMethodColors(string method) => method switch
    {
        "GET"    => "bg-emerald-500/10 text-emerald-600",
        "POST"   => "bg-blue-500/10 text-blue-600",
        "PATCH"  => "bg-amber-500/10 text-amber-600",
        "DELETE" => "bg-red-500/10 text-red-600",
        _        => "",
    };

    private static string GetKindDot(string kind) => kind switch
    {
        "added"      => "bg-emerald-500",
        "changed"    => "bg-blue-500",
        "deprecated" => "bg-amber-500",
        "removed"    => "bg-red-500",
        _            => "",
    };

    private static readonly ApiChange[] _changes =
    [
        new("c1",  "GET",    "/api/v2/users/{id}/sessions",  "New endpoint to list all active sessions for a user with device info and IP metadata.",               "added",      "v2.8.0"),
        new("c2",  "POST",   "/api/v2/webhooks",             "Added retry configuration options: max_retries, backoff_multiplier, and timeout_ms fields.",          "changed",    "v2.8.0"),
        new("c3",  "PATCH",  "/api/v2/teams/{id}",           "Now accepts nested permissions object for granular role-based access control updates.",               "changed",    "v2.8.0"),
        new("c4",  "DELETE", "/api/v2/tokens/{id}",          "Added soft-delete behavior with 30-day recovery window. Hard delete requires force=true param.",     "changed",    "v2.8.0"),
        new("c5",  "GET",    "/api/v2/analytics/realtime",   "New streaming endpoint for real-time dashboard metrics using Server-Sent Events.",                    "added",      "v2.8.0"),
        new("c6",  "POST",   "/api/v1/auth/login",           "Deprecated in favor of /api/v2/auth/authenticate with OAuth 2.1 support.",                           "deprecated", "v2.8.0"),
        new("c7",  "GET",    "/api/v2/search",               "Added faceted search with filter[field]=value syntax and cursor-based pagination.",                   "added",      "v2.8.0"),
        new("c8",  "POST",   "/api/v2/uploads/batch",        "New batch upload endpoint supporting up to 50 files per request with progress tracking.",             "added",      "v2.8.0"),
        new("c9",  "DELETE", "/api/v1/legacy/export",        "Removed legacy CSV export. Use /api/v2/exports with format=csv instead.",                            "removed",    "v2.8.0"),
        new("c10", "PATCH",  "/api/v2/billing/subscription", "Supports mid-cycle plan changes with prorated billing calculation.",                                  "changed",    "v2.8.0"),
    ];
}
