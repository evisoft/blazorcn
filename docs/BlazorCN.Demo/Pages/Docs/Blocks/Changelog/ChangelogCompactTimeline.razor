@* ============================================================
   Block: changelog-compact-timeline
   Title: ChangelogCompactTimeline
   Description: React changelog block for Next.js with an ultra-compact vertical timeline using tiny dots, thin connecting lines, and minimal text built with TypeScript, Framer Motion staggered animations, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-compact-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="clock" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Timeline</h2>
            <span class="ml-auto text-xs tabular-nums text-muted-foreground">
                @_entries.Length updates
            </span>
        </div>

        <div class="relative px-4 py-3">
            <div class="absolute top-3 bottom-3 left-[29px] w-px bg-border" aria-hidden="true"></div>

            @foreach (var entry in _entries)
            {
                <div class="relative flex items-start gap-3 py-1.5">
                    <div class="relative z-10 mt-1.5 flex size-3 shrink-0 items-center justify-center">
                        <span class="@Cn.Merge("size-1.5 rounded-full", GetTypeDot(entry.Type))"></span>
                    </div>

                    <div class="flex min-w-0 flex-1 items-baseline gap-2">
                        <span class="shrink-0 font-mono text-xs tabular-nums text-muted-foreground">
                            @entry.Date
                        </span>
                        <span class="shrink-0 font-mono text-xs text-muted-foreground/60">
                            @entry.Version
                        </span>
                        <span class="truncate text-sm text-foreground">@entry.Description</span>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record TimelineEntry(string Date, string Version, string Description, string Type);

    private static readonly TimelineEntry[] _entries =
    [
        new("Mar 28", "3.4.0", "Add real-time collaboration cursors to canvas editor", "feature"),
        new("Mar 27", "3.3.5", "Fix memory leak in WebSocket connection handler", "fix"),
        new("Mar 26", "3.3.4", "Optimize image lazy loading threshold to 200px", "improvement"),
        new("Mar 25", "3.3.3", "Fix OAuth state parameter not validating on callback", "fix"),
        new("Mar 24", "3.3.2", "Reduce initial JS bundle by tree-shaking unused icons", "improvement"),
        new("Mar 22", "3.3.1", "Fix timezone display for UTC offset calculations", "fix"),
        new("Mar 21", "3.3.0", "Add granular notification preferences per channel", "feature"),
        new("Mar 20", "3.2.4", "Rename deprecated config keys to match new schema", "breaking"),
        new("Mar 18", "3.2.3", "Fix CSV export truncating rows beyond 10,000", "fix"),
        new("Mar 17", "3.2.2", "Improve search ranking with TF-IDF scoring", "improvement"),
        new("Mar 15", "3.2.1", "Fix dropdown menu not closing on outside click", "fix"),
        new("Mar 14", "3.2.0", "Add API versioning with automatic deprecation notices", "feature"),
        new("Mar 12", "3.1.2", "Compress response payloads with Brotli encoding", "improvement"),
        new("Mar 10", "3.1.1", "Fix race condition in concurrent file upload handler", "fix"),
    ];

    private static string GetTypeDot(string type) => type switch
    {
        "feature" => "bg-emerald-500",
        "fix" => "bg-red-500",
        "improvement" => "bg-blue-500",
        "breaking" => "bg-amber-500",
        _ => "bg-muted-foreground"
    };
}
