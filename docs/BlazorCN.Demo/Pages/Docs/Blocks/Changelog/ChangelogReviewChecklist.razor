@* ============================================================
   Block: changelog-review-checklist
   Title: ChangelogReviewChecklist
   Description: A review checklist changelog block for React and Next.js with pre-release verification items, assignee tracking, check-off progress, and blocker indicators built with shadcn/ui and Tailwind CSS
   Source: original/blocks/changelog/changelog-review-checklist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="clipboard-check" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Release Checklist</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">v3.12.0</BadgeCn>
            </div>
            @if (_hasBlockers)
            {
                <div class="flex items-center gap-1 text-xs text-amber-600 dark:text-amber-400">
                    <LucideIconCn Name="alert-triangle" Size="12" Class="size-3" />
                    <span>Blockers remain</span>
                </div>
            }
        </div>

        @* Progress bar *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-xs text-muted-foreground">@_checkedItems of @_totalItems completed</span>
                <span class="font-mono text-xs tabular-nums text-muted-foreground">@_progressPercent%</span>
            </div>
            <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="@Cn.Merge("h-full rounded-full", _progressPercent == 100 ? "bg-emerald-500" : "bg-foreground")"
                     style="@($"width:{_progressPercent}%")">
                </div>
            </div>
        </div>

        @* Checklist categories *@
        @for (var ci = 0; ci < _categories.Length; ci++)
        {
            var catIndex = ci;
            var category = _categories[catIndex];
            var categoryClass = catIndex < _categories.Length - 1 ? "border-b" : "";
            <div class="@categoryClass">
                <div class="px-4 pb-1 pt-3">
                    <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">@category.Name</span>
                </div>
                @foreach (var it in category.Items)
                {
                    var item = it;
                    <label class="flex cursor-pointer items-center gap-3 px-4 py-2 transition-colors hover:bg-muted/50">
                        <CheckboxCn Checked="@item.Checked" CheckedChanged="@((bool _) => ToggleItem(catIndex, item.Id))" />
                        <div class="min-w-0 flex-1">
                            <span class="@Cn.Merge("text-sm", item.Checked ? "text-muted-foreground line-through" : "")">@item.Title</span>
                            @if (item.IsBlocker && !item.Checked)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-2 border-0 bg-red-500/10 text-[10px] font-normal text-red-600 dark:text-red-400">Blocker</BadgeCn>
                            }
                        </div>
                        <AvatarCn Class="size-5 shrink-0">
                            <AvatarFallbackCn Class="bg-muted text-[8px] text-muted-foreground">@item.AssigneeInitials</AvatarFallbackCn>
                        </AvatarCn>
                    </label>
                }
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-xs text-muted-foreground">All items must be checked before deploy</p>
        </div>

    </div>
</section>

@code {
    private record ChecklistItem(string Id, string Title, string Assignee, string AssigneeInitials, bool Checked, bool IsBlocker = false)
    {
        public bool Checked { get; set; } = Checked;
    }

    private record ChecklistCategory(string Name, ChecklistItem[] Items);

    private ChecklistCategory[] _categories =
    [
        new("Code Quality",
        [
            new("c1", "All tests passing in CI", "Maya Lin", "ML", true),
            new("c2", "Code review approved (2+ reviewers)", "Tom Wu", "TW", true),
            new("c3", "No critical linter warnings", "Maya Lin", "ML", true),
        ]),
        new("Security",
        [
            new("s1", "Dependency vulnerability scan clean", "Ravi Shah", "RS", true),
            new("s2", "API input validation reviewed", "Ravi Shah", "RS", false, true),
            new("s3", "Auth flow regression tested", "Tom Wu", "TW", false),
        ]),
        new("UX & Docs",
        [
            new("u1", "Mobile responsiveness verified", "Zoe Park", "ZP", true),
            new("u2", "Changelog entry written", "Zoe Park", "ZP", false),
            new("u3", "API docs updated for new endpoints", "Maya Lin", "ML", false),
        ]),
    ];

    private int _totalItems => _categories.Sum(c => c.Items.Length);
    private int _checkedItems => _categories.Sum(c => c.Items.Count(i => i.Checked));
    private int _progressPercent => _totalItems == 0 ? 0 : (int)Math.Round((double)_checkedItems / _totalItems * 100);
    private bool _hasBlockers => _categories.Any(c => c.Items.Any(i => i.IsBlocker && !i.Checked));

    private void ToggleItem(int categoryIndex, string itemId)
    {
        var item = _categories[categoryIndex].Items.FirstOrDefault(i => i.Id == itemId);
        if (item is not null)
        {
            item.Checked = !item.Checked;
        }
    }
}
