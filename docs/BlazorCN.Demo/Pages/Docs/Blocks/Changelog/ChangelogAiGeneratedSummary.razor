@* ============================================================
   Block: changelog-ai-generated-summary
   Title: ChangelogAiGeneratedSummary
   Description: An AI-generated changelog summary block for React and Next.js with auto-summarized release highlights, confidence scores, and key metrics built with shadcn/ui and Tailwind CSS
   Source: original/blocks/changelog/changelog-ai-generated-summary.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bot" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">AI Summary</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">v3.12.0</BadgeCn>
            </div>
            <span class="text-muted-foreground text-xs">Mar 30, 2026</span>
        </div>

        @* Summary paragraph *@
        <div class="border-b px-4 py-3">
            <p class="text-sm leading-relaxed">
                This release focuses on infrastructure performance and compliance readiness. Cold start
                times were cut in half through module loading optimizations, and full SOC 2 audit
                logging is now active across all admin surfaces.
            </p>
        </div>

        @* Metrics row *@
        <div class="grid grid-cols-4 border-b">
            @for (int i = 0; i < _metrics.Length; i++)
            {
                var metric = _metrics[i];
                var metricClass = Cn.Merge("px-4 py-3", i < _metrics.Length - 1 ? "border-r" : "");
                <div class="@metricClass">
                    <p class="font-semibold text-lg tabular-nums">@metric.Value</p>
                    <p class="text-muted-foreground text-xs">@metric.Label</p>
                </div>
            }
        </div>

        @* Highlights *@
        <div>
            @for (int i = 0; i < _highlights.Length; i++)
            {
                var item = _highlights[i];
                var highlightClass = Cn.Merge("flex gap-3 px-4 py-3", i < _highlights.Length - 1 ? "border-b" : "");
                var badgeClass = Cn.Merge("text-[10px] font-normal", GetCategoryClass(item.Category));
                <div class="@highlightClass">
                    <LucideIconCn Name="@item.IconName" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@item.Title</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@badgeClass">@item.Category</BadgeCn>
                        </div>
                        <p class="mt-0.5 text-muted-foreground text-xs">@item.Description</p>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-xs">
                    Generated from 47 commits and 12 PRs
                </span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                    View full changelog
                    <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record MetricItem(string Label, string Value);

    private record Highlight(string Id, string IconName, string Title, string Description, string Category);

    private static readonly MetricItem[] _metrics =
    [
        new("Commits", "47"),
        new("PRs merged", "12"),
        new("Contributors", "8"),
        new("Files changed", "134"),
    ];

    private static readonly Highlight[] _highlights =
    [
        new("h1", "zap", "50% faster cold starts",
            "Optimized module loading reduces serverless cold start time from 1.2s to 0.6s on average.",
            "performance"),
        new("h2", "shield", "SOC 2 audit logging",
            "All admin actions now produce immutable audit trail entries with actor, action, and timestamp.",
            "security"),
        new("h3", "code", "TypeScript 5.7 support",
            "Updated compiler target and resolved type narrowing issues in conditional return paths.",
            "developer-experience"),
        new("h4", "circle-check", "Webhook retry with backoff",
            "Failed webhook deliveries now retry 5 times with exponential backoff up to 30 minutes.",
            "reliability"),
    ];

    private static string GetCategoryClass(string category) => category switch
    {
        "performance"          => "bg-amber-500/10 text-amber-600 dark:text-amber-400 border-0",
        "security"             => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-0",
        "developer-experience" => "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-0",
        "reliability"          => "bg-violet-500/10 text-violet-600 dark:text-violet-400 border-0",
        _                      => "",
    };
}
