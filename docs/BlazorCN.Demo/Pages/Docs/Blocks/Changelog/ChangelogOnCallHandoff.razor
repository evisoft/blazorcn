@* ============================================================
   Block: changelog-on-call-handoff
   Title: ChangelogOnCallHandoff
   Description: A changelog block for on-call rotation handoffs showing incidents handled, resolution notes, and next responder assignments built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-on-call-handoff.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">On-Call Handoffs</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Shift summaries and incident reports
                    </p>
                </div>
                <LucideIconCn Name="user" Size="16" Class="size-4 text-muted-foreground" />
            </div>
        </div>

        @* Stats *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-4 gap-4">
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="alert-circle" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Total Incidents</span>
                    </div>
                    <p class="mt-1 font-semibold tabular-nums text-2xl">7</p>
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Resolved</span>
                    </div>
                    <p class="mt-1 font-semibold tabular-nums text-2xl">6</p>
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Avg MTTR</span>
                    </div>
                    <p class="mt-1 font-semibold tabular-nums text-2xl">1.8h</p>
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="user" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Handoffs</span>
                    </div>
                    <p class="mt-1 font-semibold tabular-nums text-2xl">3</p>
                </div>
            </div>
        </div>

        @* Handoff list *@
        <div>
            @foreach (var hof in _handoffs)
            {
                var handoff = hof;
                var isExpanded = _expandedId == handoff.Id;
                var criticalCount = handoff.Incidents.Count(i => i.Severity == "critical");
                var unresolvedCount = handoff.Incidents.Count(i => i.Status != "resolved");
                var isLast = handoff.Id == _handoffs[^1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => ToggleHandoff(handoff.Id))">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted">
                            <LucideIconCn Name="user" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">
                                    @handoff.From &#x2192; @handoff.To
                                </span>
                                @if (criticalCount > 0)
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 border-0 bg-red-500/10 px-1.5 text-[10px] text-red-600">
                                        @criticalCount critical
                                    </BadgeCn>
                                }
                                @if (unresolvedCount > 0)
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 border-0 bg-amber-500/10 px-1.5 text-[10px] text-amber-600">
                                        @unresolvedCount unresolved
                                    </BadgeCn>
                                }
                            </div>
                            <div class="mt-0.5 flex items-center gap-3 text-xs text-muted-foreground">
                                <span>@handoff.StartDate</span>
                                <span>•</span>
                                <span>
                                    @handoff.TotalIncidents @(handoff.TotalIncidents == 1 ? "incident" : "incidents")
                                </span>
                                <span>•</span>
                                <span>@handoff.ShiftDuration</span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/30 px-4 py-3">
                            <div class="space-y-3">
                                <div>
                                    <span class="text-xs font-medium text-muted-foreground">Incidents</span>
                                    <div class="mt-2 space-y-2">
                                        @foreach (var inc in handoff.Incidents)
                                        {
                                            var incident = inc;
                                            <div class="rounded-md border bg-card p-3">
                                                <div class="flex items-start justify-between">
                                                    <div class="flex items-start gap-2">
                                                        <span class="@Cn.Merge("mt-0.5 size-1.5 shrink-0 rounded-full", GetSeverityColor(incident.Severity))" />
                                                        <div class="min-w-0">
                                                            <div class="flex items-center gap-2">
                                                                <span class="font-medium text-sm">@incident.Title</span>
                                                                <div class="flex items-center gap-1">
                                                                    @GetStatusIcon(incident.Status)
                                                                    <span class="text-xs text-muted-foreground">
                                                                        @GetStatusLabel(incident.Status)
                                                                    </span>
                                                                </div>
                                                            </div>
                                                            <p class="mt-1 text-xs text-muted-foreground">
                                                                @incident.Notes
                                                            </p>
                                                            <div class="mt-2 flex items-center gap-3">
                                                                <span class="text-xs text-muted-foreground">
                                                                    Duration: @incident.Duration
                                                                </span>
                                                                <span class="text-xs text-muted-foreground">•</span>
                                                                <span class="text-xs text-muted-foreground">
                                                                    @incident.Severity
                                                                </span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>

                                @if (handoff.ActionItems.Length > 0)
                                {
                                    <div>
                                        <span class="text-xs font-medium text-muted-foreground">
                                            Action Items for Next Shift
                                        </span>
                                        <div class="mt-2 space-y-2">
                                            @foreach (var item in handoff.ActionItems)
                                            {
                                                <div class="flex items-start gap-2 rounded-md bg-muted/50 p-2">
                                                    <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-blue-500" />
                                                    <span class="text-xs">@item</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-xs text-muted-foreground">
                    3 shifts • Current on-call: Marcus Rodriguez
                </span>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="h-7 gap-1.5 px-2 text-xs">
                    View Rotation
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record Incident(string Id, string Title, string Severity, string Status, string Duration, string Notes);
    private record Handoff(string Id, string From, string To, string StartDate, string EndDate, string ShiftDuration, int TotalIncidents, Incident[] Incidents, string[] ActionItems);

    private static readonly Handoff[] _handoffs =
    [
        new("1", "Sarah Chen", "Marcus Rodriguez", "Mar 25, 9:00 AM", "Apr 1, 9:00 AM", "7 days", 4,
            [
                new("inc-1", "API Gateway timeout spike", "critical", "resolved", "2h 15m",
                    "Rate limit misconfiguration after deploy. Rolled back to v2.3.1 and incident auto-resolved."),
                new("inc-2", "Database connection pool exhaustion", "high", "resolved", "1h 45m",
                    "Increased pool size from 50 to 100. Monitoring for 24h to ensure stability."),
                new("inc-3", "CDN cache invalidation delays", "medium", "monitoring", "Ongoing",
                    "Cloudflare purge API showing 30s+ delays. Ticket #42890 open with support."),
                new("inc-4", "Elevated 4xx error rate on /checkout", "low", "resolved", "45m",
                    "Client-side validation bug causing form submission failures. Fixed in v2.4.1."),
            ],
            [
                "Monitor CDN cache invalidation (Cloudflare ticket #42890)",
                "Review database connection pool metrics after increase",
                "Follow up on rate limit tuning with Platform team",
            ]),
        new("2", "Alex Thompson", "Sarah Chen", "Mar 18, 9:00 AM", "Mar 25, 9:00 AM", "7 days", 2,
            [
                new("inc-5", "Redis cluster failover", "critical", "resolved", "3h 30m",
                    "Primary node crashed due to OOM. Promoted replica, increased memory allocation."),
                new("inc-6", "Search indexing lag", "medium", "resolved", "2h 10m",
                    "Elasticsearch reindexing job stuck. Cancelled and restarted with smaller batch size."),
            ],
            [
                "Monitor Redis memory usage after allocation increase",
                "Document Elasticsearch batch size tuning in runbook",
            ]),
        new("3", "Jamie Kim", "Alex Thompson", "Mar 11, 9:00 AM", "Mar 18, 9:00 AM", "7 days", 1,
            [
                new("inc-7", "SSL certificate renewal failure", "high", "resolved", "1h 20m",
                    "Let's Encrypt rate limit hit. Switched to manual cert upload temporarily."),
            ],
            [
                "Review SSL cert renewal automation with Security team",
            ]),
    ];

    private string? _expandedId;

    private void ToggleHandoff(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private static string GetSeverityColor(string severity) => severity switch
    {
        "critical" => "bg-red-500",
        "high"     => "bg-amber-500",
        "medium"   => "bg-blue-500",
        "low"      => "bg-emerald-500",
        _          => "",
    };

    private static RenderFragment GetStatusIcon(string status) => status switch
    {
        "resolved"   => @<LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-600" />,
        "ongoing"    => @<LucideIconCn Name="alert-circle" Size="12" Class="size-3 text-amber-600" />,
        "monitoring" => @<LucideIconCn Name="clock" Size="12" Class="size-3 text-blue-600" />,
        _            => @<text></text>,
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "resolved"   => "Resolved",
        "ongoing"    => "Ongoing",
        "monitoring" => "Monitoring",
        _            => status,
    };
}
