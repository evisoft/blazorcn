@* ============================================================
   Block: changelog-webhook-events
   Title: ChangelogWebhookEvents
   Description: React webhook event types changelog block for Next.js displaying new, updated, and deprecated webhook events with payload previews built with shadcn/ui Badge, Tailwind CSS, and Framer Motion.
   Source: original/blocks/changelog/changelog-webhook-events.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="webhook" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Webhook Events</h2>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto text-[10px]">v2.8.0</BadgeCn>
        </div>

        <div class="flex items-center gap-4 border-b bg-muted/30 px-4 py-2.5">
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-[10px] text-muted-foreground">@_countNew new</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-blue-500"></span>
                <span class="text-[10px] text-muted-foreground">@_countUpdated updated</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-amber-500"></span>
                <span class="text-[10px] text-muted-foreground">@_countDeprecated deprecated</span>
            </div>
            <span class="ml-auto text-[10px] text-muted-foreground tabular-nums">
                @_events.Length events
            </span>
        </div>

        <div>
            @for (int i = 0; i < _events.Length; i++)
            {
                var evt = _events[i];
                var idx = i;
                var isExpanded = _expanded == evt.Id;
                var dotClass = Cn.Merge("mt-0.5 size-1.5 shrink-0 rounded-full", GetStatusDot(evt.Status));
                var btnClass = Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", idx < _events.Length - 1 ? "border-b" : "");
                var codeClass = Cn.Merge("font-mono text-xs", evt.Status == "deprecated" ? "text-muted-foreground line-through decoration-muted-foreground/40" : "text-foreground");
                var statusSpanClass = Cn.Merge("shrink-0 rounded px-1.5 py-0.5 text-[10px] font-medium capitalize", GetStatusBadge(evt.Status));
                var chevronClass = Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
                var expandedPanelClass = Cn.Merge("px-4 py-3", idx < _events.Length - 1 ? "border-b" : "");
                <div>
                    <button
                        type="button"
                        class="@btnClass"
                        @onclick="@(() => Toggle(evt.Id))">
                        <span class="@dotClass"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <code class="@codeClass">@evt.Name</code>
                                <span class="@statusSpanClass">@evt.Status</span>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground leading-relaxed line-clamp-1">@evt.Description</p>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                    </button>
                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="@expandedPanelClass">
                                <p class="mb-3 text-xs text-muted-foreground leading-relaxed">@evt.Description</p>
                                <div class="overflow-hidden rounded-md bg-zinc-950">
                                    <div class="flex items-center justify-between border-b border-zinc-800 px-3 py-1.5">
                                        <span class="font-mono text-[10px] text-zinc-500">Example payload</span>
                                        <span class="font-mono text-[10px] text-zinc-600">@evt.Version</span>
                                    </div>
                                    <div class="overflow-x-auto p-3">
                                        <pre class="font-mono text-xs leading-relaxed text-zinc-300">@evt.Payload</pre>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record WebhookEvent(
        string Id,
        string Name,
        string Status,
        string Version,
        string Description,
        string Payload
    );

    private string? _expanded = "e1";

    private int _countNew => _events.Count(e => e.Status == "new");
    private int _countUpdated => _events.Count(e => e.Status == "updated");
    private int _countDeprecated => _events.Count(e => e.Status == "deprecated");

    private void Toggle(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private static string GetStatusBadge(string status) => status switch
    {
        "new"        => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        "updated"    => "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        "deprecated" => "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        _            => "",
    };

    private static string GetStatusDot(string status) => status switch
    {
        "new"        => "bg-emerald-500",
        "updated"    => "bg-blue-500",
        "deprecated" => "bg-amber-500",
        _            => "",
    };

    private static readonly WebhookEvent[] _events =
    [
        new("e1", "subscription.trial_ending", "new", "v2.8.0",
            "Fires 3 days before a trial period expires. Includes the subscription ID, trial end date, and the plan the user will convert to.",
            "{\n  \"event\": \"subscription.trial_ending\",\n  \"timestamp\": \"2026-03-30T10:00:00Z\",\n  \"data\": {\n    \"subscription_id\": \"sub_8xK2mN\",\n    \"trial_ends_at\": \"2026-04-02T00:00:00Z\",\n    \"plan\": \"pro_monthly\",\n    \"user_id\": \"usr_4jR9vL\"\n  }\n}"),
        new("e2", "team.member_role_changed", "new", "v2.8.0",
            "Fires when a team member role is changed. Includes the previous and new role, the actor who made the change, and the affected user.",
            "{\n  \"event\": \"team.member_role_changed\",\n  \"timestamp\": \"2026-03-28T14:30:00Z\",\n  \"data\": {\n    \"team_id\": \"team_3nP7qW\",\n    \"user_id\": \"usr_9kM2xJ\",\n    \"previous_role\": \"member\",\n    \"new_role\": \"admin\",\n    \"changed_by\": \"usr_1aB4cD\"\n  }\n}"),
        new("e3", "invoice.payment_failed", "updated", "v2.8.0",
            "Now includes the failure reason code, next retry timestamp, and the number of previous retry attempts in the payload.",
            "{\n  \"event\": \"invoice.payment_failed\",\n  \"timestamp\": \"2026-03-26T09:15:00Z\",\n  \"data\": {\n    \"invoice_id\": \"inv_2pQ8rT\",\n    \"amount\": 3900,\n    \"currency\": \"usd\",\n    \"failure_code\": \"card_declined\",\n    \"retry_at\": \"2026-03-29T09:15:00Z\",\n    \"retry_count\": 2\n  }\n}"),
        new("e4", "workspace.usage_threshold", "new", "v2.8.0",
            "Fires when workspace usage reaches 80% and 95% of the plan limit. Includes current usage, limit, and percentage.",
            "{\n  \"event\": \"workspace.usage_threshold\",\n  \"timestamp\": \"2026-03-24T16:45:00Z\",\n  \"data\": {\n    \"workspace_id\": \"ws_6hN3mK\",\n    \"resource\": \"api_calls\",\n    \"current_usage\": 8500,\n    \"limit\": 10000,\n    \"percentage\": 85,\n    \"threshold\": 80\n  }\n}"),
        new("e5", "deployment.status_changed", "updated", "v2.8.0",
            "Added build_duration_ms, commit_sha, and environment fields. The status field now includes a queued state in addition to building, succeeded, and failed.",
            "{\n  \"event\": \"deployment.status_changed\",\n  \"timestamp\": \"2026-03-22T11:20:00Z\",\n  \"data\": {\n    \"deployment_id\": \"dpl_5vR8wX\",\n    \"status\": \"succeeded\",\n    \"environment\": \"production\",\n    \"commit_sha\": \"a1b2c3d\",\n    \"build_duration_ms\": 42300\n  }\n}"),
        new("e6", "user.login", "deprecated", "v2.8.0",
            "Replaced by session.created which includes device info, IP address, and geo-location. Will be removed in v3.0.0.",
            "{\n  \"event\": \"user.login\",\n  \"timestamp\": \"2026-03-20T08:00:00Z\",\n  \"data\": {\n    \"user_id\": \"usr_4jR9vL\",\n    \"method\": \"password\",\n    \"ip\": \"192.168.1.1\"\n  },\n  \"_deprecated\": true,\n  \"_replacement\": \"session.created\",\n  \"_removal_version\": \"v3.0.0\"\n}"),
        new("e7", "api_key.rotated", "new", "v2.8.0",
            "Fires when an API key is rotated via the dashboard or API. Includes the key prefix, rotation reason, and the new expiration date.",
            "{\n  \"event\": \"api_key.rotated\",\n  \"timestamp\": \"2026-03-18T13:10:00Z\",\n  \"data\": {\n    \"key_id\": \"key_7tY2uN\",\n    \"prefix\": \"sk_live_8x\",\n    \"reason\": \"scheduled\",\n    \"expires_at\": \"2026-06-18T13:10:00Z\",\n    \"rotated_by\": \"usr_1aB4cD\"\n  }\n}"),
    ];
}
