@* ============================================================
   Block: changelog-condensed-feed
   Title: ChangelogCondensedFeed
   Description: An ultra-condensed changelog feed with single-line entries showing just a dot indicator, title, and date for maximum information density
   Source: original/blocks/changelog/changelog-condensed-feed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="list" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">Activity Feed</span>
            <span class="ml-auto text-xs text-muted-foreground">@_entries.Length updates</span>
        </div>

        <div class="flex items-center gap-4 border-b px-4 py-2">
            @foreach (var tag in _tags)
            {
                <div class="flex items-center gap-1.5">
                    <span class="@Cn.Merge("size-1.5 rounded-full", GetDotColor(tag))"></span>
                    <span class="text-[10px] capitalize text-muted-foreground">@tag</span>
                </div>
            }
        </div>

        <div>
            @for (int i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                var isLast = i == _entries.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", GetDotColor(entry.Tag))"></span>
                    <span class="min-w-0 flex-1 truncate text-sm text-foreground">@entry.Title</span>
                    <span class="shrink-0 font-mono text-[11px] text-muted-foreground">@entry.Date</span>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record FeedEntry(string Id, string Title, string Date, string Tag);

    private static readonly string[] _tags = ["feature", "fix", "improvement", "deprecation"];

    private static readonly FeedEntry[] _entries =
    [
        new("1",  "Added team role management API",              "Mar 28", "feature"),
        new("2",  "Fixed webhook retry logic for 5xx errors",    "Mar 27", "fix"),
        new("3",  "Improved dashboard load time by 35%",         "Mar 26", "improvement"),
        new("4",  "Added bulk user import from CSV",             "Mar 25", "feature"),
        new("5",  "Fixed pagination offset in search results",   "Mar 24", "fix"),
        new("6",  "Deprecated legacy v1 REST endpoints",         "Mar 23", "deprecation"),
        new("7",  "Added custom SMTP configuration",             "Mar 22", "feature"),
        new("8",  "Improved rate limiter accuracy under load",   "Mar 21", "improvement"),
        new("9",  "Fixed timezone offset in scheduled tasks",    "Mar 20", "fix"),
        new("10", "Added SSO enforcement for enterprise plans",  "Mar 19", "feature"),
        new("11", "Improved API response compression",           "Mar 18", "improvement"),
        new("12", "Fixed duplicate notification delivery",       "Mar 17", "fix"),
        new("13", "Deprecated XML export format",                "Mar 16", "deprecation"),
        new("14", "Added audit log filtering by action type",    "Mar 15", "feature"),
        new("15", "Fixed OAuth state parameter validation",      "Mar 14", "fix"),
    ];

    private static string GetDotColor(string tag) => tag switch
    {
        "feature"     => "bg-emerald-500",
        "fix"         => "bg-red-500",
        "improvement" => "bg-blue-500",
        "deprecation" => "bg-amber-500",
        _             => "bg-muted-foreground"
    };
}
