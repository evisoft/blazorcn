@* ============================================================
   Block: changelog-api-response-time
   Title: ChangelogApiResponseTime
   Description: An API response time improvement tracking changelog block built with React, Next.js, shadcn/ui, and Tailwind CSS showing latency reductions with before/after metrics and percentage gains
   Source: original/blocks/changelog/changelog-api-response-time.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="gauge" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">API Response Time Improvements</h2>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto text-[10px]">
                @_improvements.Length optimizations
            </BadgeCn>
        </div>

        @* Stats row *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <LucideIconCn Name="trending-down" Size="14" Class="size-3.5 text-emerald-500" />
                <span class="ml-1 font-semibold text-2xl tabular-nums text-emerald-600 dark:text-emerald-400">
                    @(_avgImprovement)%
                </span>
                <span class="text-xs text-muted-foreground">avg improvement</span>
            </div>
            <span class="text-xs text-muted-foreground/50">&middot;</span>
            <span class="text-xs text-muted-foreground tabular-nums">
                @($"{_totalReduction:N0}")ms total saved
            </span>
        </div>

        @* Improvement items *@
        <div>
            @for (var idx = 0; idx < _improvements.Length; idx++)
            {
                var imp = _improvements[idx];
                var isExpanded = _expandedId == imp.Id;
                var capturedImp = imp;
                var divClass = idx < _improvements.Length - 1 ? "border-b" : "";
                var chevronClass = Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
                var methodClass = Cn.Merge("shrink-0 rounded px-1.5 py-0.5 font-mono text-[10px] font-semibold", GetMethodColor(capturedImp.Method));
                var pctClass = Cn.Merge("text-xs font-medium tabular-nums", GetImprovementColor(capturedImp.PercentImproved));
                var beforeWidth = (capturedImp.BeforeMs / (double)_maxMs) * 100.0;
                var afterWidth = (capturedImp.AfterMs / (double)_maxMs) * 100.0;
                <div class="@divClass">
                    <button
                        type="button"
                        @onclick="@(() => ToggleExpanded(capturedImp.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="arrow-down" Size="14" Class="size-3.5 shrink-0 text-emerald-500" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@methodClass">@capturedImp.Method</span>
                                <code class="truncate font-mono text-xs text-muted-foreground">@capturedImp.Endpoint</code>
                            </div>
                            <div class="mt-1 flex items-center gap-2">
                                <span class="font-mono text-xs text-muted-foreground tabular-nums line-through">@(capturedImp.BeforeMs)ms</span>
                                <span class="text-muted-foreground/50">&rarr;</span>
                                <span class="font-mono text-xs tabular-nums font-medium">@(capturedImp.AfterMs)ms</span>
                                <span class="@pctClass">-@(capturedImp.PercentImproved)%</span>
                            </div>
                        </div>
                        <span class="shrink-0 text-xs text-muted-foreground">@capturedImp.Version</span>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/30 px-4 py-3 pl-9">
                            <div class="space-y-2">
                                <div>
                                    <span class="text-[10px] font-medium text-muted-foreground">Before</span>
                                    <div class="mt-1 flex items-center gap-2">
                                        <div class="h-1.5 flex-1 rounded-full bg-muted">
                                            <div class="h-1.5 rounded-full bg-red-400/60" style="@($"width:{beforeWidth:F1}%")" />
                                        </div>
                                        <span class="w-14 text-right font-mono text-[10px] tabular-nums text-muted-foreground">@(capturedImp.BeforeMs)ms</span>
                                    </div>
                                </div>
                                <div>
                                    <span class="text-[10px] font-medium text-muted-foreground">After</span>
                                    <div class="mt-1 flex items-center gap-2">
                                        <div class="h-1.5 flex-1 rounded-full bg-muted">
                                            <div class="h-1.5 rounded-full bg-emerald-400/60" style="@($"width:{afterWidth:F1}%")" />
                                        </div>
                                        <span class="w-14 text-right font-mono text-[10px] tabular-nums text-muted-foreground">@(capturedImp.AfterMs)ms</span>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-3 rounded-md bg-muted/50 p-3">
                                <span class="text-xs font-medium text-muted-foreground">Optimization</span>
                                <p class="mt-1 text-sm leading-relaxed">@capturedImp.Optimization</p>
                            </div>
                            <p class="mt-2 text-xs text-muted-foreground leading-relaxed">@capturedImp.Description</p>
                            <span class="mt-2 block text-[10px] text-muted-foreground">@capturedImp.Date</span>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Improvement(
        string Id,
        string Endpoint,
        string Method,
        int BeforeMs,
        int AfterMs,
        int PercentImproved,
        string Optimization,
        string Description,
        string Date,
        string Version
    );

    private string? _expandedId = "i1";

    private void ToggleExpanded(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private static string GetMethodColor(string method) => method switch
    {
        "GET"  => "bg-emerald-500/10 text-emerald-600",
        "POST" => "bg-blue-500/10 text-blue-600",
        "PUT"  => "bg-amber-500/10 text-amber-600",
        _      => "",
    };

    private static string GetImprovementColor(int percent)
    {
        if (percent >= 80) return "text-emerald-600 dark:text-emerald-400";
        if (percent >= 60) return "text-blue-600 dark:text-blue-400";
        return "text-amber-600 dark:text-amber-400";
    }

    private static readonly Improvement[] _improvements =
    [
        new("i1", "/api/v2/search", "GET", 820, 145, 82,
            "Added Elasticsearch caching layer with 30s TTL",
            "Search queries were hitting the database directly on every request. Introduced a caching layer with intelligent invalidation based on write patterns.",
            "Mar 28, 2026", "v3.2.0"),
        new("i2", "/api/v2/analytics/dashboard", "GET", 2400, 380, 84,
            "Pre-aggregated materialized views for dashboard metrics",
            "Dashboard analytics computed aggregations on every request across millions of events. Materialized views now pre-compute hourly rollups.",
            "Mar 25, 2026", "v3.1.8"),
        new("i3", "/api/v2/users/{id}/feed", "GET", 560, 190, 66,
            "Cursor-based pagination replacing offset queries",
            "Large offset values caused sequential scans on the feed table. Cursor-based pagination with indexed timestamp columns eliminated the scan overhead.",
            "Mar 22, 2026", "v3.1.7"),
        new("i4", "/api/v2/uploads/batch", "POST", 4200, 1100, 74,
            "Parallel S3 multipart uploads with stream piping",
            "Batch uploads were serialized through a single upload stream. Parallel multipart uploads now process up to 5 files concurrently with backpressure handling.",
            "Mar 19, 2026", "v3.1.6"),
        new("i5", "/api/v2/teams/{id}", "PUT", 340, 95, 72,
            "Eliminated N+1 queries in permission validation",
            "Team updates triggered individual permission checks for each member. Batch query now validates all member permissions in a single database round-trip.",
            "Mar 15, 2026", "v3.1.5"),
        new("i6", "/api/v2/export/csv", "GET", 8500, 2200, 74,
            "Streaming CSV generation with chunked transfer encoding",
            "Large exports buffered the entire dataset in memory before sending. Streaming serialization now pipes rows directly to the response with 1000-row chunks.",
            "Mar 12, 2026", "v3.1.4"),
    ];

    private static int _maxMs => _improvements.Max(i => i.BeforeMs);
    private static int _totalReduction => _improvements.Sum(i => i.BeforeMs - i.AfterMs);
    private static int _avgImprovement => (int)Math.Round(_improvements.Average(i => i.PercentImproved));
}
