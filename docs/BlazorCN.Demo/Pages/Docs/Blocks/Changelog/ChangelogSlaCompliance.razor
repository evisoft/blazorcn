@* ============================================================
   Block: changelog-sla-compliance
   Title: ChangelogSlaCompliance
   Description: A React SLA compliance changelog block for Next.js with uptime metrics, response time targets, breach indicators, and compliance history built with shadcn/ui and Tailwind CSS
   Source: original/blocks/changelog/changelog-sla-compliance.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">SLA Compliance</span>
            </div>
            <span class="text-muted-foreground text-xs">Last 3 releases</span>
        </div>

        @* Overall score *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="font-semibold text-2xl tabular-nums text-amber-600 dark:text-amber-400">
                    @_overallCompliance%
                </span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Needs attention
            </BadgeCn>
            <div class="ml-auto flex items-center gap-3 text-muted-foreground text-xs">
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_releases.Count(r => r.Breaches == 0) clean
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_releases.Sum(r => r.Breaches) breaches
                </span>
            </div>
        </div>

        @* Release rows *@
        @foreach (var release in _releases)
        {
            var rel = release;
            var index = Array.IndexOf(_releases, rel);
            var complianceColor = rel.OverallPercent == 100
                ? "text-emerald-600 dark:text-emerald-400"
                : rel.OverallPercent >= 75
                    ? "text-amber-600 dark:text-amber-400"
                    : "text-red-600 dark:text-red-400";
            var barColor = rel.OverallPercent == 100
                ? "bg-emerald-500"
                : rel.OverallPercent >= 75
                    ? "bg-amber-500"
                    : "bg-red-500";
            var rowClass = Cn.Merge("px-4 py-3", index < _releases.Length - 1 ? "border-b" : "");
            <div class="@rowClass">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        @if (rel.Breaches == 0)
                        {
                            <LucideIconCn Name="check-circle" Size="16" Class="size-4 text-emerald-500" />
                        }
                        else
                        {
                            <LucideIconCn Name="alert-triangle" Size="16" Class="size-4 text-amber-500" />
                        }
                        <span class="font-medium text-sm">@rel.Version</span>
                        <span class="text-muted-foreground text-xs">@rel.Date</span>
                    </div>
                    <span class="@Cn.Merge("font-semibold text-sm tabular-nums", complianceColor)">
                        @rel.OverallPercent%
                    </span>
                </div>

                @* Progress bar *@
                <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-muted">
                    <div class="@Cn.Merge("h-full rounded-full", barColor)" style="@($"width:{rel.OverallPercent}%")"></div>
                </div>

                @* Metrics *@
                <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1">
                    @foreach (var metric in rel.Metrics)
                    {
                        var m = metric;
                        <div class="flex items-center gap-1.5 text-xs">
                            <LucideIconCn Name="circle-dot" Size="10" Class="@Cn.Merge("size-2.5", m.Met ? "text-emerald-500" : "text-red-500")" />
                            <span class="text-muted-foreground">@m.Name</span>
                            <span class="font-mono tabular-nums">@m.Actual</span>
                        </div>
                    }
                </div>
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                SLA targets: 99.95% uptime · P99 &lt;200ms · Error rate &lt;0.1% · Response &lt;15min
            </p>
        </div>

    </div>
</section>

@code {
    private record SlaMetric(
        string Id,
        string Name,
        string Target,
        string Actual,
        string Unit,
        bool Met
    );

    private record ReleaseCompliance(
        string Id,
        string Version,
        string Date,
        int OverallPercent,
        int Breaches,
        SlaMetric[] Metrics
    );

    private const int _overallCompliance = 75;

    private static readonly ReleaseCompliance[] _releases =
    [
        new("r1", "v4.8.0", "Mar 28, 2026", 100, 0,
        [
            new("m1", "Uptime",            "99.95%", "99.98%", "%",   true),
            new("m2", "P99 latency",       "<200ms", "142ms",  "ms",  true),
            new("m3", "Error rate",        "<0.1%",  "0.04%",  "%",   true),
            new("m4", "Incident response", "<15min", "8min",   "min", true),
        ]),
        new("r2", "v4.7.2", "Mar 21, 2026", 75, 1,
        [
            new("m5", "Uptime",            "99.95%", "99.91%", "%",   false),
            new("m6", "P99 latency",       "<200ms", "178ms",  "ms",  true),
            new("m7", "Error rate",        "<0.1%",  "0.07%",  "%",   true),
            new("m8", "Incident response", "<15min", "12min",  "min", true),
        ]),
        new("r3", "v4.7.0", "Mar 14, 2026", 50, 2,
        [
            new("m9",  "Uptime",            "99.95%", "99.87%", "%",   false),
            new("m10", "P99 latency",       "<200ms", "312ms",  "ms",  false),
            new("m11", "Error rate",        "<0.1%",  "0.06%",  "%",   true),
            new("m12", "Incident response", "<15min", "11min",  "min", true),
        ]),
    ];
}
