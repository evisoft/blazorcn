@* ============================================================
   Block: changelog-checklist-style
   Title: ChangelogChecklistStyle
   Description: A changelog block styled as a completed checklist with filled check circles and titles conveying a satisfying sense of shipped accomplishments
   Source: original/blocks/changelog/changelog-checklist-style.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="check-circle" Size="16" Class="size-4 text-emerald-500" />
            <span class="text-sm font-medium">Shipped</span>
            <span class="ml-auto text-xs text-muted-foreground">@_entries.Length completed</span>
        </div>

        <div>
            @for (var i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                var rowClass = Cn.Merge("flex gap-3 px-4 py-3 transition-colors hover:bg-muted/50", i < _entries.Length - 1 ? "border-b" : "");
                <div class="@rowClass">
                    <div class="mt-0.5 shrink-0">
                        <LucideIconCn Name="check-circle" Size="16" Class="size-4 text-emerald-500" aria-hidden="true" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@entry.Title</span>
                        </div>
                        <p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">
                            @entry.Description
                        </p>
                        <div class="mt-1.5 flex items-center gap-2">
                            <span class="rounded-md bg-muted/50 px-1.5 py-0.5 text-[10px] font-medium text-muted-foreground">
                                @entry.Category
                            </span>
                            <span class="text-[10px] text-muted-foreground">@entry.Date</span>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ChecklistEntry(string Id, string Title, string Description, string Date, string Category);

    private static readonly ChecklistEntry[] _entries =
    [
        new("1", "Multi-region database replication",
            "Automatic read replicas deployed to 6 regions with sub-50ms latency for global users.",
            "Mar 28, 2026", "Infrastructure"),
        new("2", "Role-based access control for workspaces",
            "Define custom roles with granular permissions per workspace, project, and resource level.",
            "Mar 24, 2026", "Security"),
        new("3", "Automated backup verification",
            "Backups are now automatically restored to a sandbox environment and validated every 24 hours.",
            "Mar 20, 2026", "Reliability"),
        new("4", "Native Slack integration for alerts",
            "Connect your Slack workspace to receive real-time alerts for deployments, errors, and usage spikes.",
            "Mar 16, 2026", "Integrations"),
        new("5", "Query performance analyzer",
            "Visual query planner showing execution times, index usage, and optimization suggestions for slow queries.",
            "Mar 12, 2026", "Developer Tools"),
        new("6", "SOC 2 Type II compliance",
            "Successfully completed SOC 2 Type II audit covering security, availability, and confidentiality controls.",
            "Mar 8, 2026", "Compliance"),
        new("7", "Branch-based preview environments",
            "Every git branch automatically gets an isolated preview environment with its own database and URL.",
            "Mar 4, 2026", "Developer Tools"),
    ];
}
