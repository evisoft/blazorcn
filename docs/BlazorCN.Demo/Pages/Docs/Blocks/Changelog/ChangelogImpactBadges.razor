@* ============================================================
   Block: changelog-impact-badges
   Title: ChangelogImpactBadges
   Description: React changelog block with impact level badges showing Critical, High, Medium, and Low severity entries built with TypeScript, shadcn/ui Badge, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-impact-badges.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="zap" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Changes by Impact</h2>
            <div class="ml-auto flex items-center gap-3">
                @foreach (var level in _impactLevels)
                {
                    var cfg = _impactConfig[level];
                    <div class="flex items-center gap-1">
                        <span class="@($"size-1.5 rounded-full {cfg.Dot}")"></span>
                        <span class="text-xs text-muted-foreground">@CountByImpact(level)</span>
                    </div>
                }
            </div>
        </div>

        @for (var i = 0; i < _entries.Length; i++)
        {
            var entry = _entries[i];
            var cfg = _impactConfig[entry.Impact];
            var borderClass = i < _entries.Length - 1 ? "border-b" : "";
            <div class="@($"flex items-start gap-3 px-4 py-3 {borderClass}")">
                <span class="@($"mt-1.5 size-2 shrink-0 rounded-full {cfg.Dot}")"></span>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-medium">@entry.Title</span>
                        <BadgeCn Class="@($"text-[10px] {cfg.Badge}")">@cfg.Label</BadgeCn>
                    </div>
                    <p class="mt-0.5 text-xs text-muted-foreground">@entry.Description</p>
                    <div class="mt-1 flex items-center gap-2 text-xs text-muted-foreground">
                        <span>@entry.Category</span>
                        <span>·</span>
                        <span>@entry.Date</span>
                    </div>
                </div>
            </div>
        }

    </div>
</section>

@code {
    private record ImpactCfg(string Dot, string Badge, string Label);
    private record ChangeEntry(string Title, string Description, string Impact, string Date, string Category);

    private static readonly Dictionary<string, ImpactCfg> _impactConfig = new()
    {
        ["critical"] = new("bg-red-500",            "bg-red-500/10 text-red-600 dark:text-red-400 border-0",       "Critical"),
        ["high"]     = new("bg-amber-500",           "bg-amber-500/10 text-amber-600 dark:text-amber-400 border-0", "High"),
        ["medium"]   = new("bg-blue-500",            "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-0",    "Medium"),
        ["low"]      = new("bg-muted-foreground/40", "bg-muted text-muted-foreground border-0",                     "Low"),
    };

    private static readonly string[] _impactLevels = ["critical", "high", "medium", "low"];

    private static readonly ChangeEntry[] _entries =
    [
        new("Authentication bypass in SSO flow",
            "Patched a vulnerability where expired SAML assertions were accepted during single sign-on, allowing unauthorized session creation.",
            "critical", "Mar 28, 2026", "Security"),
        new("Database connection pool exhaustion",
            "Fixed connection leak in long-running background jobs that caused pool exhaustion under sustained load above 2,000 RPM.",
            "critical", "Mar 26, 2026", "Infrastructure"),
        new("Webhook retry mechanism redesign",
            "Replaced linear retry with exponential backoff and dead-letter queue. Failed webhooks now retry up to 8 times over 24 hours.",
            "high", "Mar 22, 2026", "API"),
        new("Bulk export memory optimization",
            "Switched CSV and JSON exports to streaming writes, reducing peak memory from 2.1 GB to 180 MB for large datasets.",
            "high", "Mar 18, 2026", "Performance"),
        new("Dashboard chart tooltip positioning",
            "Fixed tooltip overflow on narrow viewports where chart tooltips were clipped by the container boundary.",
            "medium", "Mar 15, 2026", "UI"),
        new("Deprecated v1 API endpoints removed",
            "Removed 14 legacy v1 REST endpoints that were deprecated in September 2025. All consumers migrated to v2.",
            "medium", "Mar 8, 2026", "API"),
        new("Updated timezone database to 2026a",
            "Applied the latest IANA timezone release with corrections for Kazakhstan and Palestine daylight saving changes.",
            "low", "Mar 10, 2026", "Data"),
        new("README typo corrections",
            "Fixed grammatical errors and broken links in the contributor documentation and quick-start guide.",
            "low", "Mar 5, 2026", "Docs"),
    ];

    private int CountByImpact(string impact) =>
        _entries.Count(e => e.Impact == impact);
}
