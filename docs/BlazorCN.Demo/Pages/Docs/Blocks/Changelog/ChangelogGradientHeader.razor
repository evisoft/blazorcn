@* ============================================================
   Block: changelog-gradient-header
   Title: ChangelogGradientHeader
   Description: React changelog block for Next.js with visually distinct version headers using alternating muted backgrounds, prominent version numbers, and categorized entries built with TypeScript, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-gradient-header.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="layers" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Changelog</h2>
            <span class="ml-auto text-xs text-muted-foreground">@_releases.Length releases</span>
        </div>

        @for (var i = 0; i < _releases.Length; i++)
        {
            var release = _releases[i];
            var isLast = i == _releases.Length - 1;
            var bgClass = i % 2 == 0 ? "bg-muted/30" : "bg-card";
            var borderClass = isLast ? "" : "border-b";
            <div class="@($"{borderClass} {bgClass}")">
                <div class="bg-muted/50 px-4 py-3">
                    <div class="flex items-baseline gap-3">
                        <span class="text-sm font-semibold tabular-nums">v@(release.Version)</span>
                        <span class="text-xs text-muted-foreground">@release.Date</span>
                    </div>
                    <p class="mt-0.5 text-xs text-muted-foreground">@release.Summary</p>
                </div>

                <div class="px-4 py-2">
                    @foreach (var entry in release.Entries)
                    {
                        <div class="flex items-start gap-2.5 py-1.5">
                            <span class="@($"mt-1.5 size-1.5 shrink-0 rounded-full {GetCategoryDot(entry.Category)}")"></span>
                            <div class="flex min-w-0 flex-1 items-baseline gap-2">
                                <span class="shrink-0 text-xs font-medium text-muted-foreground">@entry.Category</span>
                                <span class="text-sm text-foreground">@entry.Description</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

    </div>
</section>

@code {
    private record Entry(string Category, string Description);
    private record Release(string Version, string Date, string Summary, Entry[] Entries);

    private static string GetCategoryDot(string category) => category switch
    {
        "Added"    => "bg-emerald-500",
        "Fixed"    => "bg-red-500",
        "Improved" => "bg-blue-500",
        "Removed"  => "bg-amber-500",
        _          => "bg-muted-foreground",
    };

    private static readonly Release[] _releases =
    [
        new("2.6.0", "Mar 28, 2026", "Workspace collaboration and real-time features",
        [
            new("Added",    "Real-time cursor presence for team workspaces"),
            new("Added",    "Slash command menu in rich text editor"),
            new("Improved", "Reduced WebSocket reconnection latency by 40%"),
            new("Fixed",    "Avatar upload failing for images over 2MB"),
        ]),
        new("2.5.2", "Mar 21, 2026", "Performance improvements and bug fixes",
        [
            new("Improved", "Dashboard initial load time reduced to under 800ms"),
            new("Fixed",    "CSV export missing UTF-8 BOM for Excel compatibility"),
            new("Fixed",    "Notification badge count not resetting after read"),
        ]),
        new("2.5.0", "Mar 14, 2026", "API key management and audit logging",
        [
            new("Added",    "Scoped API keys with granular permission controls"),
            new("Added",    "Audit log export in JSON and CSV formats"),
            new("Improved", "Search indexing now processes documents in parallel"),
            new("Removed",  "Deprecated v1 webhook endpoint (/api/v1/hooks)"),
        ]),
        new("2.4.1", "Mar 7, 2026", "Security patches and minor improvements",
        [
            new("Fixed",    "CSRF token validation bypass on session renewal"),
            new("Improved", "Rate limiter now uses sliding window algorithm"),
            new("Fixed",    "Timezone offset incorrect for Asia/Kolkata locale"),
        ]),
    ];
}
