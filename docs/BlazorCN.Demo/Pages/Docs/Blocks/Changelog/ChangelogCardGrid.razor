@* ============================================================
   Block: changelog-card-grid
   Title: ChangelogCardGrid
   Description: React card grid changelog block for Next.js with feature cards, category badges, and responsive two-column layout built with TypeScript, shadcn/ui Badge, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-card-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">What's New</span>
        </div>

        <div class="grid grid-cols-1 gap-px bg-border md:grid-cols-2">
            @foreach (var update in _updates)
            {
                <div class="bg-card px-4 py-3">
                    <div class="flex items-center gap-2">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-[10px] font-normal capitalize", GetBadgeStyle(update.Category))">
                            @update.Category
                        </BadgeCn>
                        <span class="text-xs text-muted-foreground/60">@update.Date</span>
                    </div>
                    <p class="mt-1.5 text-sm font-medium">@update.Title</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@update.Description</p>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Update(string Title, string Description, string Date, string Category);

    private static string GetBadgeStyle(string category) => category switch
    {
        "feature"     => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-0",
        "fix"         => "bg-red-500/10 text-red-600 dark:text-red-400 border-0",
        "improvement" => "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-0",
        "breaking"    => "bg-amber-500/10 text-amber-600 dark:text-amber-400 border-0",
        _             => "",
    };

    private static readonly Update[] _updates =
    [
        new("Real-time collaboration",  "Multiple users can now edit documents simultaneously with live cursor presence.",          "Mar 28", "feature"),
        new("Build cache optimization", "Incremental builds are now 3x faster with improved dependency graph caching.",             "Mar 26", "improvement"),
        new("Safari upload fix",        "Resolved blob URL revocation timing that caused blank file previews on Safari.",           "Mar 25", "fix"),
        new("API v2 migration",         "REST API v1 endpoints deprecated. Migrate to v2 by April 30 for continued access.",        "Mar 24", "breaking"),
        new("Custom theme editor",      "Create and preview themes with HSL color pickers and live CSS variable export.",           "Mar 22", "feature"),
        new("Webhook retry logic",      "Failed webhook deliveries now retry with exponential backoff up to 5 attempts.",           "Mar 20", "improvement"),
    ];
}
