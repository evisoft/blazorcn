@* ============================================================
   Block: changelog-performance-log
   Title: ChangelogPerformanceLog
   Description: React performance metrics changelog block for Next.js showing before and after values with improvement percentages in a clean comparison layout built with TypeScript, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-performance-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="trending-up" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Performance Log</h2>
            <span class="text-xs text-muted-foreground">Recent optimizations</span>
        </div>

        <div class="divide-y">
            @foreach (var m in _metrics)
            {
                <div class="px-4 py-3 transition-colors hover:bg-muted/50">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@m.Name</span>
                                <span class="shrink-0 rounded bg-emerald-500/10 px-1.5 py-0.5 font-mono text-xs font-medium text-emerald-600 dark:text-emerald-400">
                                    -@m.Improvement
                                </span>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">@m.Description</p>
                        </div>
                        <div class="shrink-0 text-right">
                            <span class="font-mono text-xs text-muted-foreground">@m.Version</span>
                            <p class="text-xs text-muted-foreground">@m.Date</p>
                        </div>
                    </div>
                    <div class="mt-2.5 flex items-center gap-2 rounded-md bg-muted/50 px-3 py-2">
                        <span class="font-mono text-sm tabular-nums text-muted-foreground line-through decoration-muted-foreground/40">
                            @m.Before
                        </span>
                        <LucideIconCn Name="arrow-right" Size="14" Class="size-3.5 shrink-0 text-muted-foreground/60" />
                        <span class="font-mono text-sm font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                            @m.After
                        </span>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Metric(
        string Name,
        string Description,
        string Before,
        string After,
        string Improvement,
        string Version,
        string Date);

    private static readonly Metric[] _metrics =
    [
        new("Cold start latency",
            "Serverless function initialization time reduced via snapshot restore.",
            "1,240ms", "310ms", "75%", "v4.2.0", "Mar 28"),
        new("Bundle size (gzipped)",
            "Tree-shaking improvements and removal of unused polyfills.",
            "287 KB", "142 KB", "51%", "v4.1.0", "Mar 22"),
        new("Database query p99",
            "Added composite indexes and query plan caching for hot paths.",
            "890ms", "145ms", "84%", "v4.1.0", "Mar 22"),
        new("Time to interactive",
            "Deferred non-critical hydration and lazy-loaded below-fold components.",
            "3.8s", "1.4s", "63%", "v4.0.2", "Mar 15"),
        new("Image optimization",
            "Switched to AVIF format with responsive srcset and blur placeholders.",
            "4.2 MB", "680 KB", "84%", "v4.0.1", "Mar 12"),
        new("API response time (avg)",
            "Introduced edge caching with stale-while-revalidate for read endpoints.",
            "420ms", "85ms", "80%", "v4.0.0", "Mar 8"),
    ];
}
