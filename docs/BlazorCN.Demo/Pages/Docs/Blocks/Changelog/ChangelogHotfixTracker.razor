@* ============================================================
   Block: changelog-hotfix-tracker
   Title: ChangelogHotfixTracker
   Description: A hotfix tracking dashboard with urgency levels, deployment status, and incident tracking for React and Next.js applications using shadcn/ui components and Tailwind CSS.
   Source: original/blocks/changelog/changelog-hotfix-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Hotfix Tracker</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Emergency fixes and deployment status
                    </p>
                </div>
                <div class="flex items-center gap-2">
                    <BadgeCn Class="h-5 gap-1 bg-red-500/10 text-red-600 text-xs">
                        <LucideIconCn Name="alert-triangle" Size="12" Class="size-3" />
                        @_criticalActiveCount critical
                    </BadgeCn>
                </div>
            </div>
        </div>

        <div>
            @foreach (var hf in _hotfixes)
            {
                var hotfix = hf;
                var isExpanded = _expandedHotfix == hotfix.Id;
                var isLast = hotfix.Id == _hotfixes[^1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => ToggleHotfix(hotfix.Id))"
                            class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex size-6 shrink-0 items-center justify-center">
                            @if (hotfix.Urgency == "critical")
                            {
                                <LucideIconCn Name="alert-triangle" Size="16" Class="size-4 text-red-500" />
                            }
                            else if (hotfix.Urgency == "high")
                            {
                                <LucideIconCn Name="zap" Size="16" Class="size-4 text-amber-500" />
                            }
                            else
                            {
                                <LucideIconCn Name="clock" Size="16" Class="size-4 text-blue-500" />
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@hotfix.Title</span>
                                        <BadgeCn Class="@Cn.Merge("h-5 text-xs", GetUrgencyBadgeClass(hotfix.Urgency))">
                                            @hotfix.Urgency
                                        </BadgeCn>
                                        <BadgeCn Class="@Cn.Merge("h-5 text-xs", GetStatusBadgeClass(hotfix.Status))">
                                            @hotfix.Status
                                        </BadgeCn>
                                    </div>
                                    <p class="mt-0.5 text-xs text-muted-foreground">@hotfix.Description</p>
                                    <div class="mt-1.5 flex items-center gap-3 text-xs text-muted-foreground">
                                        <span class="flex items-center gap-1">
                                            <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                            @hotfix.CreatedAt
                                        </span>
                                        @if (hotfix.ResolutionTime != null)
                                        {
                                            <span class="flex items-center gap-1">
                                                <LucideIconCn Name="timer" Size="12" Class="size-3" />
                                                @hotfix.ResolutionTime
                                            </span>
                                        }
                                        <span>@hotfix.AffectedUsers.ToString("N0") users affected</span>
                                    </div>
                                </div>
                                <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                            </div>
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/20 px-4 py-3">
                            <div class="space-y-3">
                                <div class="grid grid-cols-2 gap-3">
                                    <div class="rounded-md bg-card px-3 py-2">
                                        <div class="text-xs text-muted-foreground">Author</div>
                                        <div class="mt-1 font-medium text-sm">@hotfix.Author</div>
                                    </div>
                                    <div class="rounded-md bg-card px-3 py-2">
                                        <div class="text-xs text-muted-foreground">Deployment Stage</div>
                                        <div class="mt-1 font-medium text-sm">@hotfix.DeploymentStage</div>
                                    </div>
                                </div>

                                <div class="rounded-md bg-card px-3 py-2">
                                    <div class="mb-2 text-xs text-muted-foreground">Affected Services</div>
                                    <div class="flex flex-wrap gap-1.5">
                                        @foreach (var svc in hotfix.Services)
                                        {
                                            <BadgeCn Class="h-5 bg-muted/50 font-mono text-muted-foreground text-xs">
                                                @svc
                                            </BadgeCn>
                                        }
                                    </div>
                                </div>

                                @if (hotfix.Status == "deployed")
                                {
                                    <div class="rounded-md bg-emerald-500/10 px-3 py-2">
                                        <div class="flex items-center gap-2">
                                            <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-600" />
                                            <div>
                                                <div class="text-xs font-medium text-emerald-600">
                                                    Successfully Deployed
                                                </div>
                                                <div class="text-xs text-emerald-600/80">
                                                    Deployed @hotfix.DeployedAt • Resolved in @hotfix.ResolutionTime
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <div class="flex gap-2">
                                    <ButtonCn Variant="ButtonVariant.Outline" Class="h-6 flex-1 text-xs">View Logs</ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Outline" Class="h-6 flex-1 text-xs">Incident Report</ButtonCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Hotfix(
        string Id,
        string Title,
        string Description,
        string Urgency,
        string Status,
        string CreatedAt,
        string? DeployedAt,
        string? ResolutionTime,
        string Author,
        int AffectedUsers,
        string[] Services,
        string DeploymentStage
    );

    private static readonly Hotfix[] _hotfixes =
    [
        new("hf-2024-001", "Payment processing timeout",
            "Critical timeout issue affecting Stripe payment confirmations",
            "critical", "deployed", "45 min ago", "12 min ago", "33 min",
            "ops_team", 1247, ["payment-service", "checkout-api"], "production"),
        new("hf-2024-002", "Authentication token expiry",
            "Users being logged out prematurely due to incorrect token TTL",
            "high", "testing", "1 hour ago", null, null,
            "auth_team", 3421, ["auth-service", "session-manager"], "staging"),
        new("hf-2024-003", "Image upload corruption",
            "Uploaded images occasionally corrupted in Safari browsers",
            "medium", "in-progress", "2 hours ago", null, null,
            "frontend_team", 892, ["upload-service", "cdn"], "development"),
        new("hf-2024-004", "Database connection pool leak",
            "Connection pool exhaustion causing intermittent 503 errors",
            "critical", "deployed", "3 hours ago", "1 hour ago", "2h 4m",
            "backend_team", 5678, ["api-gateway", "database-proxy"], "production"),
        new("hf-2024-005", "Email notification delay",
            "Email notifications delayed by 10-15 minutes",
            "medium", "pending", "5 hours ago", null, null,
            "notification_team", 2134, ["email-service", "queue-worker"], "development"),
    ];

    private string? _expandedHotfix;

    private int _criticalActiveCount =>
        _hotfixes.Count(h => h.Urgency == "critical" && h.Status != "deployed");

    private void ToggleHotfix(string id)
    {
        _expandedHotfix = _expandedHotfix == id ? null : id;
    }

    private static string GetUrgencyBadgeClass(string urgency) => urgency switch
    {
        "critical" => "bg-red-500/10 text-red-600",
        "high"     => "bg-amber-500/10 text-amber-600",
        _          => "bg-blue-500/10 text-blue-600",
    };

    private static string GetStatusBadgeClass(string status) => status switch
    {
        "deployed"    => "bg-emerald-500/10 text-emerald-600",
        "testing"     => "bg-blue-500/10 text-blue-600",
        "in-progress" => "bg-amber-500/10 text-amber-600",
        _             => "bg-muted/50 text-muted-foreground",
    };
}
