@* ============================================================
   Block: changelog-experiment-results
   Title: ChangelogExperimentResults
   Description: A React changelog component for A/B test results built with Next.js, shadcn/ui, and Tailwind CSS showing statistical significance, lift metrics, and experiment outcomes
   Source: original/blocks/changelog/changelog-experiment-results.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="flask-conical" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Experiment Results</h2>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">
                A/B test outcomes with statistical significance and lift metrics
            </p>
        </div>

        <div>
            @foreach (var experiment in _experiments)
            {
                var exp = experiment;
                var isExpanded = _expandedId == exp.Id;
                var liftClass = exp.Lift > 0
                    ? "font-semibold tabular-nums text-emerald-500"
                    : exp.Lift < 0
                        ? "font-semibold tabular-nums text-red-500"
                        : "font-semibold tabular-nums text-muted-foreground";
                var chevronClass = isExpanded
                    ? "size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 rotate-90"
                    : "size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200";
                <div class="border-b last:border-b-0">
                    <button type="button" @onclick="@(() => SetExpanded(exp.Id))" class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex min-w-0 flex-1 flex-col gap-2">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@exp.Name</span>
                            </div>
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="@Cn.Merge("inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-xs font-medium", GetStatusBg(exp.Status), GetStatusText(exp.Status))">
                                    <LucideIconCn Name="@GetStatusIcon(exp.Status)" Size="12" Class="size-3" />
                                    @GetStatusLabel(exp.Status)
                                </span>
                                <span class="text-xs text-muted-foreground">@exp.Timestamp</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <div class="flex items-baseline gap-1">
                                    <span class="@liftClass">
                                        @(exp.Lift > 0 ? "+" : "")@(exp.Lift.ToString("F1"))%
                                    </span>
                                    <span class="text-xs text-muted-foreground">lift</span>
                                </div>
                                <span class="text-xs text-muted-foreground">•</span>
                                <div class="flex items-baseline gap-1">
                                    <span class="font-medium tabular-nums text-xs">
                                        @exp.Confidence.ToString("F1")%
                                    </span>
                                    <span class="text-xs text-muted-foreground">confidence</span>
                                </div>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/50 px-4 py-3">
                            <div class="mb-3">
                                <span class="mb-1 block text-xs font-medium text-muted-foreground">
                                    Hypothesis
                                </span>
                                <p class="text-xs text-muted-foreground">@exp.Hypothesis</p>
                            </div>

                            <div class="mb-3">
                                <span class="mb-1.5 block text-xs font-medium text-muted-foreground">
                                    Variant Performance
                                </span>
                                <div class="space-y-2">
                                    @foreach (var variant in exp.Variants)
                                    {
                                        var displayValue = variant.ConversionRate > 0
                                            ? $"{variant.ConversionRate:F2}%"
                                            : $"${variant.AverageValue:F2}";
                                        <div class="rounded-md bg-background px-3 py-2">
                                            <div class="mb-1 flex items-center justify-between">
                                                <span class="text-xs font-medium">@variant.Name</span>
                                                @if (variant.IsControl)
                                                {
                                                    <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                                                        Control
                                                    </BadgeCn>
                                                }
                                            </div>
                                            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                                                <span>@variant.SampleSize.ToString("N0") users</span>
                                                <span>•</span>
                                                <span class="font-medium tabular-nums">
                                                    @displayValue
                                                </span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="mb-3 rounded-md bg-background px-3 py-2">
                                <span class="block text-xs font-medium text-muted-foreground">
                                    Statistical Significance
                                </span>
                                <div class="mt-1 flex items-center gap-2 text-xs">
                                    <span class="font-mono">p = @exp.PValue.ToString("F4")</span>
                                    @if (exp.PValue < 0.05)
                                    {
                                        <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500" />
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="x-circle" Size="14" Class="size-3.5 text-red-500" />
                                    }
                                </div>
                            </div>

                            <div class="mb-3">
                                <span class="mb-1 block text-xs font-medium text-muted-foreground">
                                    Decision
                                </span>
                                <p class="text-xs font-medium">@exp.Decision</p>
                            </div>

                            <div>
                                <span class="mb-1 block text-xs font-medium text-muted-foreground">
                                    Impact
                                </span>
                                <p class="text-xs text-muted-foreground">@exp.Impact</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ExperimentVariant(string Name, bool IsControl, int SampleSize, double ConversionRate, double AverageValue);
    private record ExperimentResult(string Id, string Name, string Hypothesis, string Metric, string Status, string Timestamp, ExperimentVariant[] Variants, double Lift, double PValue, double Confidence, string Decision, string Impact);

    private string? _expandedId;

    private static readonly ExperimentResult[] _experiments =
    [
        new("1", "Checkout Button Color Test",
            "Green CTA will increase conversion rate by creating stronger urgency signal",
            "Purchase Conversion Rate", "winner", "2 days ago",
            [
                new("Control (Blue)", true, 12480, 3.42, 127.5),
                new("Treatment (Green)", false, 12520, 4.18, 129.2),
            ],
            22.2, 0.0012, 99.88, "Ship to 100% of users",
            "Projected +$142k annual revenue from 0.76pp conversion lift"),
        new("2", "Onboarding Flow Simplification",
            "Reducing signup steps from 4 to 2 will decrease drop-off",
            "Signup Completion Rate", "winner", "5 days ago",
            [
                new("Control (4 steps)", true, 8340, 47.2, 0),
                new("Treatment (2 steps)", false, 8410, 61.8, 0),
            ],
            30.9, 0.0001, 99.99, "Ship to 100% of users",
            "Expect +2,140 additional signups per month"),
        new("3", "Pricing Page Social Proof",
            "Adding customer logos will increase trial signups via trust signals",
            "Trial Signup Rate", "neutral", "1 week ago",
            [
                new("Control (No logos)", true, 15620, 8.24, 0),
                new("Treatment (Customer logos)", false, 15580, 8.31, 0),
            ],
            0.8, 0.4821, 51.79, "No ship - insufficient evidence",
            "No statistically significant impact detected"),
        new("4", "Email Digest Frequency Test",
            "Daily digests will increase engagement vs weekly",
            "Click-through Rate", "loser", "2 weeks ago",
            [
                new("Control (Weekly)", true, 24300, 12.4, 0),
                new("Treatment (Daily)", false, 24280, 9.1, 0),
            ],
            -26.6, 0.0008, 99.92, "Do not ship - control wins",
            "Daily emails significantly reduced engagement and increased unsubscribe rate"),
        new("5", "Product Image Carousel Size",
            "Larger product images (720px) will increase add-to-cart rate",
            "Add to Cart Rate", "winner", "3 weeks ago",
            [
                new("Control (480px)", true, 18920, 14.2, 0),
                new("Treatment (720px)", false, 18840, 16.8, 0),
            ],
            18.3, 0.0024, 99.76, "Ship to 100% of users",
            "Increased add-to-cart rate drives +$89k projected quarterly revenue"),
        new("6", "Free Shipping Threshold Test",
            "Lowering threshold from $75 to $50 will increase average order value",
            "Average Order Value", "inconclusive", "1 month ago",
            [
                new("Control ($75)", true, 6240, 0, 82.4),
                new("Treatment ($50)", false, 6190, 0, 78.2),
            ],
            -5.1, 0.1842, 81.58, "Extend test - needs more data",
            "Trending negative but not yet statistically significant at 95% threshold"),
    ];

    private void SetExpanded(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private static string GetStatusBg(string status) => status switch
    {
        "winner" => "bg-emerald-500/10",
        "loser" => "bg-red-500/10",
        "neutral" => "bg-gray-500/10",
        "inconclusive" => "bg-amber-500/10",
        _ => "",
    };

    private static string GetStatusText(string status) => status switch
    {
        "winner" => "text-emerald-500",
        "loser" => "text-red-500",
        "neutral" => "text-gray-500",
        "inconclusive" => "text-amber-500",
        _ => "",
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "winner" => "Winner",
        "loser" => "Loser",
        "neutral" => "Neutral",
        "inconclusive" => "Inconclusive",
        _ => "",
    };

    private static string GetStatusIcon(string status) => status switch
    {
        "winner" => "trending-up",
        "loser" => "trending-down",
        "neutral" => "minus-circle",
        "inconclusive" => "minus-circle",
        _ => "circle",
    };
}
