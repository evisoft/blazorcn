@* ============================================================
   Block: changelog-numbered-list
   Title: ChangelogNumberedList
   Description: React numbered changelog block for Next.js with sequentially numbered entries in circular badges, titles, descriptions, and dates built with TypeScript, Framer Motion staggered animations, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-numbered-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="hash" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Changelog</h2>
            <span class="ml-auto text-xs text-muted-foreground">@_entries.Length updates</span>
        </div>

        <div>
            @for (int i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                var number = _entries.Length - i;
                var isLast = i == _entries.Length - 1;
                <div class="@Cn.Merge("flex gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex size-7 shrink-0 items-center justify-center rounded-full border bg-muted/50">
                        <span class="font-mono text-xs font-medium text-muted-foreground">@number</span>
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@entry.Title</span>
                            <span class="shrink-0 rounded-full bg-muted px-1.5 py-0.5 text-[10px] font-medium text-muted-foreground">@entry.Tag</span>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground leading-relaxed">@entry.Description</p>
                        <span class="mt-1 block text-[11px] text-muted-foreground/60">@entry.Date</span>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record NumberedEntry(string Title, string Description, string Date, string Tag);

    private static readonly NumberedEntry[] _entries =
    [
        new("Unified notification center",
            "All alerts, mentions, and system notifications consolidated into a single inbox with read/unread state and bulk actions.",
            "Mar 28, 2026", "Feature"),
        new("Database query profiler",
