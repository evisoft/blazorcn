@* ============================================================
   Block: changelog-token-usage-report
   Title: ChangelogTokenUsageReport
   Description: A React changelog component tracking API token and credit consumption across releases with visual graphs and usage analytics built with shadcn/ui, Tailwind CSS, and Next.js
   Source: original/blocks/changelog/changelog-token-usage-report.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="bar-chart-3" Size="16" Class="size-4 text-muted-foreground" />
                    <h2 class="text-sm font-medium">Token Usage Reports</h2>
                </div>
                <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 px-1.5 text-xs">Last 90 days</BadgeCn>
            </div>
        </div>

        @* Report rows *@
        <div class="divide-y">
            @foreach (var rep in _reports)
            {
                var report = rep;
                var isExpanded = _expandedItems.Contains(report.Id);
                var usagePercent = GetUsagePercentage(report.TotalTokens, report.Quota);
                var isHighUsage = double.Parse(usagePercent) > 75;

                <div>
                    <button type="button"
                            class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => ToggleItem(report.Id))">
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("mt-1 size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@report.Version</span>
                                <span class="text-xs text-muted-foreground">@report.ReleaseDate</span>
                                @if (report.Trend == "up")
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 gap-0.5 px-1 text-xs text-amber-600">
                                        <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                                        @report.TrendPercentage%
                                    </BadgeCn>
                                }
                                @if (report.Trend == "down")
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 gap-0.5 px-1 text-xs text-emerald-600">
                                        <LucideIconCn Name="trending-down" Size="12" Class="size-3" />
                                        @report.TrendPercentage%
                                    </BadgeCn>
                                }
                            </div>

                            <div class="mt-2 grid grid-cols-3 gap-3">
                                <div>
                                    <div class="flex items-center gap-1 text-xs text-muted-foreground">
                                        <LucideIconCn Name="zap" Size="12" Class="size-3" />
                                        <span>Tokens</span>
                                    </div>
                                    <p class="mt-1 font-mono text-sm font-medium tabular-nums">@FormatNumber(report.TotalTokens)</p>
                                    <p class="text-xs text-muted-foreground">@usagePercent% of quota</p>
                                </div>
                                <div>
                                    <span class="text-xs text-muted-foreground">Requests</span>
                                    <p class="mt-1 font-mono text-sm font-medium tabular-nums">@FormatNumber(report.TotalRequests)</p>
                                </div>
                                <div>
                                    <div class="flex items-center gap-1 text-xs text-muted-foreground">
                                        <LucideIconCn Name="coins" Size="12" Class="size-3" />
                                        <span>Cost</span>
                                    </div>
                                    <p class="mt-1 font-mono text-sm font-medium tabular-nums">$@report.TotalCost.ToString("F2")</p>
                                </div>
                            </div>

                            @if (isHighUsage)
                            {
                                <div class="mt-2 flex items-center gap-1.5 text-xs text-amber-600">
                                    <LucideIconCn Name="alert-circle" Size="12" Class="size-3" />
                                    <span>High usage - approaching quota limit</span>
                                </div>
                            }
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t px-4 py-3">
                            <div class="space-y-3">
                                <div>
                                    <h3 class="mb-2 text-xs font-medium text-muted-foreground">Endpoint Breakdown</h3>
                                    <div class="space-y-2">
                                        @foreach (var ep in report.Endpoints)
                                        {
                                            var endpoint = ep;
                                            <div class="rounded-md bg-muted/50 p-2">
                                                <p class="font-mono text-xs text-muted-foreground">@endpoint.Endpoint</p>
                                                <div class="mt-2 grid grid-cols-3 gap-2 text-xs">
                                                    <div>
                                                        <span class="text-muted-foreground">Tokens</span>
                                                        <p class="font-mono font-medium tabular-nums">@FormatNumber(endpoint.Tokens)</p>
                                                    </div>
                                                    <div>
                                                        <span class="text-muted-foreground">Requests</span>
                                                        <p class="font-mono font-medium tabular-nums">@FormatNumber(endpoint.Requests)</p>
                                                    </div>
                                                    <div>
                                                        <span class="text-muted-foreground">Cost</span>
                                                        <p class="font-mono font-medium tabular-nums">$@endpoint.Cost.ToString("F2")</p>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>

                                @if (report.Notes.Length > 0)
                                {
                                    <div>
                                        <h4 class="mb-2 text-xs font-medium text-muted-foreground">Notes</h4>
                                        <ul class="space-y-1">
                                            @foreach (var note in report.Notes)
                                            {
                                                <li class="text-xs text-muted-foreground">• @note</li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record EndpointUsage(string Endpoint, int Tokens, int Requests, double Cost);

    private record UsageReport(
        string Id,
        string Version,
        string ReleaseDate,
        int TotalTokens,
        int Quota,
        int TotalRequests,
        double TotalCost,
        string Trend,
        double TrendPercentage,
        EndpointUsage[] Endpoints,
        string[] Notes);

    private static readonly UsageReport[] _reports =
    [
        new("usage-1", "v2.4.0", "2026-03-30", 2847392, 5000000, 14672, 284.74, "up", 18.3,
            [
                new("/api/chat/completions", 1892340, 8934, 189.23),
                new("/api/embeddings", 673842, 4123, 67.38),
                new("/api/moderations", 281210, 1615, 28.13),
            ],
            [
                "Increased usage due to new AI chat feature rollout",
                "Embeddings usage stable month-over-month",
                "Consider upgrading quota tier next month",
            ]),
        new("usage-2", "v2.3.0", "2026-03-15", 2410283, 5000000, 12453, 241.03, "down", 7.2,
            [
                new("/api/chat/completions", 1615892, 7621, 161.59),
                new("/api/embeddings", 658291, 3892, 65.83),
                new("/api/moderations", 136100, 940, 13.61),
            ],
            [
                "Optimized prompt templates reduced token usage by 12%",
                "Implemented response caching for common queries",
            ]),
        new("usage-3", "v2.2.0", "2026-03-01", 2597845, 5000000, 13892, 259.78, "stable", 1.8,
            [
                new("/api/chat/completions", 1823940, 8234, 182.39),
                new("/api/embeddings", 621783, 4102, 62.18),
                new("/api/moderations", 152122, 1556, 15.21),
            ],
            [
                "Baseline month - normal usage patterns observed",
            ]),
    ];

    private readonly HashSet<string> _expandedItems = [];

    private void ToggleItem(string id)
    {
        if (!_expandedItems.Add(id))
            _expandedItems.Remove(id);
    }

    private static string FormatNumber(int num) => num.ToString("N0");

    private static string GetUsagePercentage(int used, int quota) =>
        ((double)used / quota * 100).ToString("F1");
}
