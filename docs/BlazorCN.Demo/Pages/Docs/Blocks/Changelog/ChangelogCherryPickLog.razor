@* ============================================================
   Block: changelog-cherry-pick-log
   Title: ChangelogCherryPickLog
   Description: Track cherry-picked commits across branches with source/target references and conflict status. Built with React, Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-cherry-pick-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Cherry-Pick Log</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @FilteredPicks.Count() operations across @UniqueBranches.Count() branches
                    </p>
                </div>
                <LucideIconCn Name="git-branch" Size="16" Class="size-4 text-muted-foreground/60" />
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex gap-2">
                <div class="relative flex-1">
                    <LucideIconCn Name="search" Size="16" Class="absolute top-2 left-2.5 size-4 text-muted-foreground/60" />
                    <InputCn
                        Placeholder="Search commits, messages, authors..."
                        @bind-Value="_searchQuery"
                        Class="h-8 border-0 bg-muted/50 pl-8 text-xs shadow-none focus-visible:ring-1" />
                </div>
                <select @bind="_branchFilter" class="h-8 w-[160px] rounded-md border border-input bg-background px-3 text-xs">
                    <option value="all">All branches</option>
                    @foreach (var branch in UniqueBranches)
                    {
                        <option value="@branch">@branch</option>
                    }
                </select>
            </div>
        </div>

        <div class="divide-y">
            @foreach (var it in FilteredPicks)
            {
                var pick = it;
                var isExpanded = _expandedId == pick.Id;
                var isSelected = _selectedIds.Contains(pick.Id);
                <div>
                    <div class="flex items-start gap-3 px-4 py-3">
                        <label class="flex items-center pt-0.5">
                            <input type="checkbox" checked="@isSelected" @onchange="@(() => ToggleSelected(pick.Id))" class="size-4" />
                        </label>

                        <button
                            type="button"
                            @onclick="@(() => ToggleExpanded(pick.Id))"
                            class="min-w-0 flex-1 text-left">
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@pick.Message</span>
                                        @if (pick.Status == "success" && pick.Verified)
                                        {
                                            <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 shrink-0 text-emerald-500" />
                                        }
                                        @if (pick.Status == "conflict")
                                        {
                                            <LucideIconCn Name="alert-circle" Size="14" Class="size-3.5 shrink-0 text-amber-500" />
                                        }
                                        @if (pick.Status == "pending")
                                        {
                                            <span class="size-1.5 shrink-0 rounded-full bg-blue-500"></span>
                                        }
                                    </div>
                                    <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
                                        <span class="flex items-center gap-1">
                                            <LucideIconCn Name="git-commit" Size="12" Class="size-3" />
                                            @pick.SourceCommit
                                        </span>
                                        <span class="flex items-center gap-1">
                                            <LucideIconCn Name="git-branch" Size="12" Class="size-3" />
                                            @pick.SourceBranch → @pick.TargetBranch
                                        </span>
                                        <span>@pick.Author</span>
                                        <span>@pick.Timestamp</span>
                                    </div>
                                </div>

                                <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                            </div>
                        </button>
                    </div>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/30 px-4 py-3">
                            <div class="space-y-3 pl-7">
                                <div class="flex items-center justify-between">
                                    <div class="space-y-1">
                                        <div class="flex items-center gap-2">
                                            <span class="text-xs font-medium text-muted-foreground">Status</span>
                                            @if (pick.Status == "success")
                                            {
                                                <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 border-emerald-500/20 bg-emerald-500/10 text-emerald-600">
                                                    <LucideIconCn Name="check-circle-2" Size="12" Class="size-3" />
                                                    Success
                                                </BadgeCn>
                                            }
                                            @if (pick.Status == "conflict")
                                            {
                                                <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 border-amber-500/20 bg-amber-500/10 text-amber-600">
                                                    <LucideIconCn Name="alert-circle" Size="12" Class="size-3" />
                                                    @pick.ConflictFiles conflicts
                                                </BadgeCn>
                                            }
                                            @if (pick.Status == "pending")
                                            {
                                                <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 border-blue-500/20 bg-blue-500/10 text-blue-600">
                                                    Pending verification
                                                </BadgeCn>
                                            }
                                        </div>
                                        <p class="text-xs text-muted-foreground">
                                            @pick.FilesChanged files changed@(pick.Verified ? " · CI verified" : "")
                                        </p>
                                    </div>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                                        Copy SHA
                                    </ButtonCn>
                                </div>

                                @if (pick.Status == "conflict")
                                {
                                    <div class="rounded-md bg-amber-500/10 p-3">
                                        <p class="text-xs font-medium text-amber-600">Merge conflicts detected</p>
                                        <div class="mt-2 space-y-1">
                                            <p class="font-mono text-xs text-muted-foreground">src/auth/session.ts</p>
                                            <p class="font-mono text-xs text-muted-foreground">src/middleware/rate-limit.ts</p>
                                        </div>
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-3 h-6 text-xs">
                                            Resolve conflicts
                                        </ButtonCn>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @if (_selectedIds.Count > 0)
        {
            <div class="border-t bg-muted/30 px-4 py-3">
                <div class="flex items-center justify-between">
                    <p class="text-xs text-muted-foreground">@_selectedIds.Count selected</p>
                    <div class="flex gap-2">
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Reverify</ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Export</ButtonCn>
                    </div>
                </div>
            </div>
        }

    </div>
</section>

@code {
    private record CherryPickItem(
        string Id, string SourceCommit, string TargetBranch, string SourceBranch,
        string Author, string Message, string Timestamp, string Status,
        bool Verified, int FilesChanged, int? ConflictFiles = null
    );

    private static readonly CherryPickItem[] _cherryPicks =
    [
        new("cp-1", "a3f89dc", "release/v2.1", "main", "Sarah Chen",
            "Fix memory leak in WebSocket reconnection logic", "2 hours ago", "success", true, 3),
        new("cp-2", "b7e42a1", "release/v2.1", "main", "Marcus Rodriguez",
            "Update rate limiting thresholds for API endpoints", "4 hours ago", "conflict", false, 5, 2),
        new("cp-3", "d9c1f58", "hotfix/auth-bypass", "security/CVE-2026-1234", "Dev Security",
            "Patch authentication bypass vulnerability", "6 hours ago", "success", true, 2),
        new("cp-4", "e4a2b91", "release/v2.0", "main", "Emily Parker",
            "Backport database connection pool optimization", "8 hours ago", "success", true, 4),
        new("cp-5", "f1d3c72", "release/v2.1", "feature/metrics", "James Wilson",
            "Add telemetry for checkout flow timing", "12 hours ago", "pending", false, 6),
        new("cp-6", "c8e5a44", "hotfix/auth-bypass", "security/CVE-2026-1234", "Dev Security",
            "Add regression tests for auth flow", "14 hours ago", "success", true, 8),
    ];

    private string _searchQuery = "";
    private string _branchFilter = "all";
    private string? _expandedId;
    private readonly HashSet<string> _selectedIds = new();

    private IEnumerable<CherryPickItem> FilteredPicks => _cherryPicks.Where(pick =>
    {
        var matchesSearch = pick.Message.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)
            || pick.SourceCommit.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)
            || pick.Author.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase);
        var matchesBranch = _branchFilter == "all" || pick.TargetBranch == _branchFilter;
        return matchesSearch && matchesBranch;
    });

    private IEnumerable<string> UniqueBranches => _cherryPicks.Select(p => p.TargetBranch).Distinct();

    private void ToggleExpanded(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private void ToggleSelected(string id)
    {
        if (_selectedIds.Contains(id))
            _selectedIds.Remove(id);
        else
            _selectedIds.Add(id);
    }
}
