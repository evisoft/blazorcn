@* ============================================================
   Block: changelog-commit-log
   Title: ChangelogCommitLog
   Description: A git commit-style changelog block built with React, Next.js, shadcn/ui, and Tailwind CSS with monospace hashes, authors, and relative timestamps
   Source: original/blocks/changelog/changelog-commit-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="git-commit-horizontal" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Commit Log</h2>
            <span class="ml-auto font-mono text-xs text-muted-foreground">
                @_commits.Length commits
            </span>
        </div>

        <div>
            @for (var idx = 0; idx < _commits.Length; idx++)
            {
                var commit = _commits[idx];
                var type = GetCommitType(commit.Message);
                var isExpanded = _expandedId == commit.Id;
                var hasDescription = commit.Description is not null;
                var dotColor = _typeColor.GetValueOrDefault(type, "bg-muted-foreground");
                var itemClass = idx < _commits.Length - 1 ? "border-b" : "";
                var buttonClass = Cn.Merge(
                    "flex w-full items-start gap-3 px-4 py-2.5 text-left transition-colors",
                    hasDescription ? "cursor-pointer hover:bg-muted/50" : "cursor-default");
                var chevronClass = Cn.Merge(
                    "mt-1 size-3.5 shrink-0 text-muted-foreground/60 transition-transform duration-200",
                    isExpanded ? "rotate-90" : "");
                <div class="@itemClass">
                    <button
                        type="button"
                        @onclick="@(() => HandleCommitClick(commit))"
                        class="@buttonClass">
                        <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", dotColor)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate text-sm font-medium">@commit.Message</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2">
                                <button
                                    type="button"
                                    @onclick="@(() => HandleCopyHash(commit.Hash))"
                                    @onclick:stopPropagation="true"
                                    class="flex items-center gap-1 rounded font-mono text-xs text-muted-foreground transition-colors hover:text-foreground">
                                    @if (_copiedHash == commit.Hash)
                                    {
                                        <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                                    }
                                    @commit.Hash
                                </button>
                                <span class="text-xs text-muted-foreground/40">·</span>
                                <span class="text-xs text-muted-foreground">@commit.Author</span>
                                <span class="text-xs text-muted-foreground/40">·</span>
                                <span class="text-xs text-muted-foreground/60">@commit.Date</span>
                                @if (commit.Branch is not null)
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="ml-auto font-mono text-xs font-normal">
                                        @commit.Branch
                                    </BadgeCn>
                                }
                            </div>
                        </div>
                        @if (hasDescription)
                        {
                            <LucideIconCn Name="chevron-right" Size="14" Class="@chevronClass" />
                        }
                    </button>
                    @if (isExpanded && commit.Description is not null)
                    {
                        <div class="px-4 pb-3 pl-10">
                            <div class="rounded-md bg-muted/50 p-3">
                                <p class="text-xs text-muted-foreground">@commit.Description</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Commit(
        string Id,
        string Hash,
        string Message,
        string Author,
        string Date,
        string? Description = null,
        string? Branch = null
    );

    private string? _expandedId;
    private string? _copiedHash;

    private void HandleCommitClick(Commit commit)
    {
        if (commit.Description is not null)
            _expandedId = _expandedId == commit.Id ? null : commit.Id;
    }

    private async Task HandleCopyHash(string hash)
    {
        _copiedHash = hash;
        await Task.Delay(1500);
        _copiedHash = null;
        StateHasChanged();
    }

    private static string GetCommitType(string message)
    {
        var colonIdx = message.IndexOf(':');
        if (colonIdx > 0)
        {
            var prefix = message[..colonIdx];
            if (prefix.All(char.IsLetter))
                return prefix;
        }
        return "other";
    }

    private static readonly Dictionary<string, string> _typeColor = new()
    {
        ["feat"]     = "bg-emerald-500",
        ["fix"]      = "bg-red-500",
        ["refactor"] = "bg-blue-500",
        ["chore"]    = "bg-amber-500",
        ["perf"]     = "bg-violet-500",
        ["docs"]     = "bg-muted-foreground",
    };

    private static readonly Commit[] _commits =
    [
        new("c1",  "a3f8c2d", "feat: add granular role-based permissions",
            "Sarah Chen", "2 hours ago",
            "Implements RBAC with workspace-level and project-level permission scopes. Includes migration for existing team roles.",
            "main"),
        new("c2",  "e7b1a09", "fix: resolve memory leak in WebSocket handler",
            "Marcus Johnson", "5 hours ago"),
        new("c3",  "1d4f6e8", "refactor: migrate auth middleware to Edge Runtime",
            "Sarah Chen", "8 hours ago",
            "Moves session validation to Edge Runtime for reduced latency. Auth checks now complete in under 3ms at the edge."),
        new("c4",  "b92c3a1", "feat: webhook event subscriptions for CRUD operations",
            "Alex Rivera", "Yesterday"),
        new("c5",  "f5d8e72", "fix: incorrect UTC offset for Pacific/Auckland timezone",
            "Priya Patel", "Yesterday"),
        new("c6",  "8a1b3c4", "chore: upgrade Prisma to 6.4.0 with improved query engine",
            "Marcus Johnson", "2 days ago"),
        new("c7",  "c6e9f01", "feat: PDF export with custom branding and page layouts",
            "Alex Rivera", "2 days ago",
            "Adds configurable PDF generation using react-pdf. Supports custom logos, color schemes, and multi-page layouts."),
        new("c8",  "3b7d2a5", "fix: CSV export missing headers for custom fields",
            "Priya Patel", "3 days ago"),
        new("c9",  "d4e6f89", "perf: reduce dashboard initial load by 40% with lazy loading",
            "Sarah Chen", "3 days ago"),
        new("c10", "7f2a1b3", "docs: update API v2 migration guide with examples",
            "Marcus Johnson", "4 days ago"),
    ];
}
