@* ============================================================
   Block: changelog-permission-changes
   Title: ChangelogPermissionChanges
   Description: React changelog block for Next.js displaying permission and role change audits with added or removed indicators, role badges, affected user counts, and author attribution built with TypeScript, Framer Motion, shadcn/ui Badge, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-permission-changes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="font-medium text-sm">Permission Audit Log</h2>
            <span class="ml-auto text-muted-foreground text-xs">@_changes.Length changes</span>
        </div>

        <div class="flex items-center gap-4 border-b bg-muted/30 px-4 py-2">
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-muted-foreground text-xs">@_addedCount added</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-red-500"></span>
                <span class="text-muted-foreground text-xs">@_removedCount removed</span>
            </div>
        </div>

        @for (var i = 0; i < _changes.Length; i++)
        {
            var change = _changes[i];
            var isLast = i == _changes.Length - 1;
            var rowClass = Cn.Merge("flex items-start gap-3 px-4 py-3", isLast ? "" : "border-b");
            <div class="@rowClass">
                @if (change.Action == "added")
                {
                    <LucideIconCn Name="plus-circle" Size="16" Class="mt-0.5 size-4 shrink-0 text-emerald-500" />
                }
                else
                {
                    <LucideIconCn Name="minus-circle" Size="16" Class="mt-0.5 size-4 shrink-0 text-red-500" />
                }
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-xs">@change.Role</BadgeCn>
                        <span class="truncate font-mono text-muted-foreground text-xs">@change.Permission</span>
                    </div>
                    <div class="mt-1.5 flex items-center gap-3">
                        <span class="flex items-center gap-1 text-muted-foreground text-xs">
                            <LucideIconCn Name="users" Size="12" Class="size-3" />
                            @change.AffectedUsers users affected
                        </span>
                        <span class="text-muted-foreground text-xs">by @change.ChangedBy</span>
                        <span class="ml-auto text-muted-foreground text-xs">@change.Date</span>
                    </div>
                </div>
            </div>
        }

    </div>
</section>

@code {
    private record PermissionChange(
        string Id,
        string Date,
        string Role,
        string Permission,
        string Action,
        int AffectedUsers,
        string ChangedBy
    );

    private static readonly PermissionChange[] _changes =
    [
        new("pc-1", "Mar 26, 2026", "Editor",      "publish:articles",    "added",   24,  "Sarah Chen"),
        new("pc-2", "Mar 25, 2026", "Viewer",      "export:reports",      "removed", 156, "James Wright"),
        new("pc-3", "Mar 24, 2026", "Admin",       "manage:billing",      "added",   5,   "Sarah Chen"),
        new("pc-4", "Mar 23, 2026", "Developer",   "access:staging-env",  "added",   38,  "Maria Lopez"),
        new("pc-5", "Mar 22, 2026", "Contributor", "delete:own-drafts",   "removed", 67,  "James Wright"),
        new("pc-6", "Mar 20, 2026", "Support",     "view:user-data",      "added",   12,  "Alex Kim"),
    ];

    private int _addedCount   => Array.FindAll(_changes, c => c.Action == "added").Length;
    private int _removedCount => Array.FindAll(_changes, c => c.Action == "removed").Length;
}
