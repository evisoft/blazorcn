@* ============================================================
   Block: changelog-compliance-updates
   Title: ChangelogComplianceUpdates
   Description: A changelog block for regulatory and compliance changes showing regulation names, change descriptions, compliance status badges, and effective dates for audit readiness.
   Source: original/blocks/changelog/changelog-compliance-updates.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Compliance Updates</h2>
            <span class="ml-auto text-xs text-muted-foreground">@_entries.Length updates</span>
        </div>

        <div>
            @foreach (var entry in _entries)
            {
                var isExpanded = _expandedId == entry.Id;
                var config = GetStatusConfig(entry.Status);
                var dotClass = Cn.Merge("size-1.5 shrink-0 rounded-full", config.Dot);
                var chevronClass = Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
                <div class="border-b last:border-b-0">
                    <button
                        type="button"
                        @onclick="@(() => ToggleExpanded(entry.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@dotClass"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate text-sm font-medium">@entry.Title</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px]">@entry.Regulation</BadgeCn>
                                <span>&middot;</span>
                                <span>@entry.UpdatedDate</span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-3 px-4 pb-4">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <p class="text-xs text-muted-foreground">@entry.Description</p>
                                </div>
                                <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-muted-foreground">
                                    <div class="flex items-center gap-1.5">
                                        <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                        <span>Effective @entry.EffectiveDate</span>
                                    </div>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-[10px]", config.Badge)">@config.Label</BadgeCn>
                                </div>
                                <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted-foreground">
                                    <span>Owner: @entry.Owner</span>
                                    <span>Impact: @entry.Impact</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ComplianceEntry(
        string Id,
        string Regulation,
        string Title,
        string Description,
        string Status,
        string EffectiveDate,
        string UpdatedDate,
        string Owner,
        string Impact
    );

    private record StatusConfig(string Label, string Dot, string Badge);

    private string? _expandedId;

    private void ToggleExpanded(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private static StatusConfig GetStatusConfig(string status) => status switch
    {
        "compliant"   => new("Compliant",   "bg-emerald-500", "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"),
        "in-progress" => new("In Progress", "bg-amber-500",   "bg-amber-500/10 text-amber-600 dark:text-amber-400"),
        _             => new("Pending",      "bg-muted-foreground", "bg-muted text-muted-foreground"),
    };

    private static readonly ComplianceEntry[] _entries =
    [
        new("ce-1", "GDPR", "Updated data retention policy for EU users",
            "Reduced default retention from 36 to 24 months. Added automated purge pipeline for expired records. Cookie consent banner updated to reflect new processing categories.",
            "compliant", "Apr 1, 2026", "Mar 26, 2026", "Legal Team",
            "All EU user data, analytics events, and session logs"),
        new("ce-2", "SOC 2 Type II", "Encryption at rest for backup volumes",
            "Enabled AES-256 encryption on all database backup volumes and snapshot storage. Key rotation schedule set to 90 days via AWS KMS.",
            "compliant", "Mar 15, 2026", "Mar 22, 2026", "Infrastructure",
            "Database backups, EBS snapshots, S3 archive buckets"),
        new("ce-3", "HIPAA", "Audit logging for PHI access events",
            "Implemented immutable audit trail for all read/write operations on protected health information. Logs forwarded to dedicated SIEM with 7-year retention.",
            "in-progress", "May 1, 2026", "Mar 20, 2026", "Security Team",
            "Healthcare module, patient records API, admin panel"),
        new("ce-4", "PCI DSS 4.0", "Client-side script integrity monitoring",
            "Added Subresource Integrity (SRI) hashes for all third-party scripts on payment pages. Content Security Policy updated to block inline scripts.",
            "in-progress", "Jun 1, 2026", "Mar 18, 2026", "Payments Team",
            "Checkout flow, payment form, hosted fields integration"),
        new("ce-5", "CCPA", "Automated data deletion request pipeline",
            "Built self-service deletion portal for California consumers. Requests processed within 72 hours with confirmation email. Cascade deletion across all dependent services.",
            "pending", "Jul 1, 2026", "Mar 15, 2026", "Platform Team",
            "User accounts, billing records, support tickets, analytics"),
    ];
}
