@* ============================================================
   Block: changelog-dependency-updates
   Title: ChangelogDependencyUpdates
   Description: A dependency updates changelog block for React and Next.js with package version diffs, risk indicators, and grouped update categories built with shadcn/ui and Tailwind CSS
   Source: original/blocks/changelog/changelog-dependency-updates.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="package" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Dependency Updates</span>
            </div>
            <span class="text-muted-foreground text-xs">@_packages.Length packages</span>
        </div>

        @* Risk summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-red-500"></span>
                <span class="text-muted-foreground text-xs">@_riskCounts.Major major</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-amber-500"></span>
                <span class="text-muted-foreground text-xs">@_riskCounts.Minor minor</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-muted-foreground text-xs">@_riskCounts.Patch patch</span>
            </div>
        </div>

        @* Production dependencies *@
        <div class="border-b px-4 py-2">
            <span class="font-medium text-muted-foreground text-xs uppercase tracking-wider">Production</span>
        </div>

        @foreach (var pkg in _prodPackages)
        {
            var item = pkg;
            var dotClass = Cn.Merge("size-1.5 shrink-0 rounded-full", GetRiskColor(item.Risk));
            var badgeClass = Cn.Merge("text-[10px] font-normal", GetRiskBadgeStyle(item.Risk));
            <div class="flex items-center gap-3 border-b px-4 py-2.5 transition-colors hover:bg-muted/50">
                <span class="@dotClass"></span>
                <span class="min-w-0 flex-1 truncate font-mono text-sm">@item.Name</span>
                <div class="flex items-center gap-1.5">
                    <span class="font-mono text-muted-foreground text-xs">@item.From</span>
                    <LucideIconCn Name="arrow-right" Size="12" Class="size-3 text-muted-foreground/60" />
                    <span class="font-mono text-xs">@item.To</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="@badgeClass">@item.Risk</BadgeCn>
            </div>
        }

        @* Dev dependencies *@
        <div class="border-b px-4 py-2">
            <span class="font-medium text-muted-foreground text-xs uppercase tracking-wider">Dev Dependencies</span>
        </div>

        @foreach (var pair in _devPackages.Select((p, i) => (Pkg: p, Idx: i)))
        {
            var item = pair.Pkg;
            var isLast = pair.Idx == _devPackages.Length - 1;
            var rowClass = Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b");
            var dotClass = Cn.Merge("size-1.5 shrink-0 rounded-full", GetRiskColor(item.Risk));
            var badgeClass = Cn.Merge("text-[10px] font-normal", GetRiskBadgeStyle(item.Risk));
            <div class="@rowClass">
                <span class="@dotClass"></span>
                <span class="min-w-0 flex-1 truncate font-mono text-sm">@item.Name</span>
                <div class="flex items-center gap-1.5">
                    <span class="font-mono text-muted-foreground text-xs">@item.From</span>
                    <LucideIconCn Name="arrow-right" Size="12" Class="size-3 text-muted-foreground/60" />
                    <span class="font-mono text-xs">@item.To</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="@badgeClass">@item.Risk</BadgeCn>
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">Last scanned Mar 30, 2026 · Renovate</p>
        </div>

    </div>
</section>

@code {
    private record PackageUpdate(
        string Id,
        string Name,
        string From,
        string To,
        string Risk,
        string Type
    );

    private record RiskCounts(int Major, int Minor, int Patch);

    private static readonly PackageUpdate[] _packages =
    [
        new("p1", "next",           "15.2.1", "16.0.0", "major", "production"),
        new("p2", "react",          "19.0.0", "19.1.0", "minor", "production"),
        new("p3", "@prisma/client", "6.4.0",  "6.4.1",  "patch", "production"),
        new("p4", "stripe",         "17.3.0", "17.4.0", "minor", "production"),
        new("p5", "zod",            "3.23.0", "4.0.0",  "major", "production"),
        new("p6", "@biomejs/biome", "1.9.0",  "1.9.4",  "patch", "dev"),
        new("p7", "typescript",     "5.6.3",  "5.7.0",  "minor", "dev"),
        new("p8", "vitest",         "3.0.0",  "3.0.2",  "patch", "dev"),
    ];

    private static readonly PackageUpdate[] _prodPackages = _packages.Where(p => p.Type == "production").ToArray();
    private static readonly PackageUpdate[] _devPackages  = _packages.Where(p => p.Type == "dev").ToArray();

    private static readonly RiskCounts _riskCounts = new(
        Major: _packages.Count(p => p.Risk == "major"),
        Minor: _packages.Count(p => p.Risk == "minor"),
        Patch: _packages.Count(p => p.Risk == "patch")
    );

    private static string GetRiskColor(string risk) => risk switch
    {
        "patch" => "bg-emerald-500",
        "minor" => "bg-amber-500",
        "major" => "bg-red-500",
        _       => "",
    };

    private static string GetRiskBadgeStyle(string risk) => risk switch
    {
        "patch" => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-0",
        "minor" => "bg-amber-500/10 text-amber-600 dark:text-amber-400 border-0",
        "major" => "bg-red-500/10 text-red-600 dark:text-red-400 border-0",
        _       => "",
    };
}
