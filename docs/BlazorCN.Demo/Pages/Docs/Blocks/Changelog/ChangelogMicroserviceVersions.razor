@* ============================================================
   Block: changelog-microservice-versions
   Title: ChangelogMicroserviceVersions
   Description: A changelog showing microservice version matrix with deployed versions per environment, built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-microservice-versions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Microservice Version Matrix</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Deployed versions across all environments
            </p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-3 gap-4">
                <div>
                    <p class="text-xs text-muted-foreground">Total Services</p>
                    <p class="mt-1 font-semibold tabular-nums text-2xl">@_services.Length</p>
                </div>
                <div>
                    <p class="text-xs text-muted-foreground">Synchronized</p>
                    <p class="mt-1 font-semibold tabular-nums text-2xl text-emerald-500">
                        @_services.Count(s => s.Drift == "none")
                    </p>
                </div>
                <div>
                    <p class="text-xs text-muted-foreground">Drifted</p>
                    <p class="mt-1 font-semibold tabular-nums text-2xl text-amber-500">
                        @_services.Count(s => s.Drift != "none")
                    </p>
                </div>
            </div>
        </div>

        <div>
            @foreach (var service in _services)
            {
                var svc = service;
                var isExpanded = _expandedService == svc.Name;
                <div class="border-b last:border-b-0">
                    <button type="button" @onclick="@(() => ToggleService(svc.Name))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex items-center gap-2">
                            @if (svc.Drift == "none")
                            {
                                <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-500" />
                            }
                            else
                            {
                                <LucideIconCn Name="alert-circle" Size="16" Class="size-4 text-amber-500" />
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-mono text-sm font-medium">@svc.Name</span>
                                @if (svc.Drift == "none")
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="border-0 bg-emerald-500/10 text-emerald-500">synced</BadgeCn>
                                }
                                else if (svc.Drift == "minor")
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="border-0 bg-amber-500/10 text-amber-500">drift</BadgeCn>
                                }
                                else
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="border-0 bg-red-500/10 text-red-500">outdated</BadgeCn>
                                }
                            </div>
                            <div class="mt-1 flex items-center gap-2 text-xs">
                                <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("border-0 font-mono", GetVersionBadgeColor(svc.Versions.Dev, svc.LatestVersion, svc.Drift))">
                                    dev: @svc.Versions.Dev
                                </BadgeCn>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("border-0 font-mono", GetVersionBadgeColor(svc.Versions.Staging, svc.LatestVersion, svc.Drift))">
                                    staging: @svc.Versions.Staging
                                </BadgeCn>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("border-0 font-mono", GetVersionBadgeColor(svc.Versions.Production, svc.LatestVersion, svc.Drift))">
                                    prod: @svc.Versions.Production
                                </BadgeCn>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/30 px-4 py-3">
                            <div class="mb-2 flex items-center gap-2">
                                <LucideIconCn Name="git-branch" Size="12" Class="size-3 text-muted-foreground" />
                                <span class="text-xs font-medium text-muted-foreground">
                                    Deployment History
                                </span>
                            </div>
                            <div class="space-y-2">
                                @foreach (var deployment in svc.Deployments)
                                {
                                    <div class="rounded-md bg-card p-3">
                                        <div class="flex items-start justify-between gap-3">
                                            <div class="min-w-0 flex-1">
                                                <div class="flex items-center gap-2">
                                                    <span class="font-mono text-xs font-medium">@deployment.Version</span>
                                                    <BadgeCn Variant="BadgeVariant.Outline" Class="border-0 bg-muted/50 text-xs">
                                                        @deployment.Environment
                                                    </BadgeCn>
                                                </div>
                                                <div class="mt-1 flex items-center gap-2 text-xs text-muted-foreground">
                                                    <span>@deployment.Timestamp</span>
                                                    <span class="text-muted-foreground/40">•</span>
                                                    <span>by @deployment.Deployer</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <p class="text-xs text-muted-foreground">Last sync: 2 minutes ago</p>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Refresh Status
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record ServiceVersions(string Dev, string Staging, string Production);

    private record DeploymentEntry(string Version, string Environment, string Timestamp, string Deployer);

    private record ServiceVersion(
        string Name,
        ServiceVersions Versions,
        string LatestVersion,
        string Drift,
        DeploymentEntry[] Deployments
    );

    private string? _expandedService = null;

    private void ToggleService(string name)
    {
        _expandedService = _expandedService == name ? null : name;
    }

    private static string GetVersionBadgeColor(string version, string latest, string drift)
    {
        if (version == latest) return "bg-emerald-500/10 text-emerald-500";
        if (drift == "major") return "bg-red-500/10 text-red-500";
        return "bg-amber-500/10 text-amber-500";
    }

    private static readonly ServiceVersion[] _services =
    [
        new("api-gateway",
            new("v2.5.0", "v2.4.1", "v2.4.1"),
            "v2.5.0", "minor",
            [
                new("v2.5.0", "dev",        "2026-03-30 14:23", "jenkins-bot"),
                new("v2.4.1", "staging",    "2026-03-28 09:15", "sarah.chen"),
                new("v2.4.1", "production", "2026-03-28 16:30", "sarah.chen"),
            ]),
        new("user-service",
            new("v1.8.3", "v1.8.3", "v1.8.2"),
            "v1.8.3", "minor",
            [
                new("v1.8.3", "dev",        "2026-03-30 11:42", "github-actions"),
                new("v1.8.3", "staging",    "2026-03-29 15:20", "mike.torres"),
                new("v1.8.2", "production", "2026-03-27 10:00", "mike.torres"),
            ]),
        new("payment-processor",
            new("v3.1.0", "v3.1.0", "v3.1.0"),
            "v3.1.0", "none",
            [
                new("v3.1.0", "production", "2026-03-27 14:00", "alex.kumar"),
                new("v3.1.0", "staging",    "2026-03-27 10:30", "alex.kumar"),
                new("v3.1.0", "dev",        "2026-03-26 16:45", "circleci"),
            ]),
        new("search-service",
            new("v4.1.8", "v4.2.0", "v4.1.8"),
            "v4.2.1", "major",
            [
                new("v4.2.0", "staging",    "2026-03-26 13:00", "emma.park"),
                new("v4.1.8", "production", "2026-03-24 09:00", "emma.park"),
                new("v4.1.8", "dev",        "2026-03-30 08:30", "github-actions"),
            ]),
        new("notification-worker",
            new("v2.3.1", "v2.3.1", "v2.3.1"),
            "v2.3.1", "none",
            [
                new("v2.3.1", "production", "2026-03-25 11:00", "deploy-bot"),
            ]),
    ];
}
