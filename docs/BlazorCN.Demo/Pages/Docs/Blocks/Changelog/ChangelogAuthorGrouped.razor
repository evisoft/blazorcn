@* ============================================================
   Block: changelog-author-grouped
   Title: ChangelogAuthorGrouped
   Description: React changelog block for Next.js grouped by contributor with avatar initials, author names, roles, and individual change lists built with TypeScript, Framer Motion staggered animations, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-author-grouped.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="user" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">v@_version</h2>
            <span class="text-xs text-muted-foreground">@_date</span>
            <span class="ml-auto text-xs text-muted-foreground">
                @_authors.Length contributors
            </span>
        </div>

        @foreach (var author in _authors)
        {
            <div class="border-b last:border-b-0">
                <div class="flex items-center gap-3 px-4 pb-1 pt-3">
                    <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @author.Initials
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="text-sm font-medium">@author.Name</span>
                        <span class="ml-2 text-xs text-muted-foreground">@author.Role</span>
                    </div>
                    <span class="tabular-nums text-xs text-muted-foreground">
                        @author.Entries.Length changes
                    </span>
                </div>

                <div class="pb-3 pl-14 pr-4 pt-1">
                    @foreach (var entry in author.Entries)
                    {
                        var dotClass = GetCategoryDot(entry.Category);
                        <div class="flex items-start gap-2.5 py-1">
                            <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", dotClass)" />
                            <div class="flex min-w-0 items-baseline gap-2">
                                <span class="shrink-0 text-xs font-medium text-muted-foreground">
                                    @entry.Category
                                </span>
                                <span class="text-sm text-foreground">@entry.Description</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

    </div>
</section>

@code {
    private record Entry(string Category, string Description);

    private record Author(string Name, string Initials, string Role, Entry[] Entries);

    private const string _version = "4.1.0";
    private const string _date = "Mar 28, 2026";

    private static string GetCategoryDot(string category) => category switch
    {
        "Added"      => "bg-emerald-500",
        "Fixed"      => "bg-red-500",
        "Improved"   => "bg-blue-500",
        "Refactored" => "bg-violet-500",
        _            => "bg-gray-500",
    };

    private static readonly Author[] _authors =
    [
        new("Sarah Chen", "SC", "Frontend Lead",
        [
            new("Added",    "Keyboard navigation for data table column reordering"),
            new("Improved", "Reduced bundle size of chart components by 18%"),
            new("Fixed",    "Tooltip positioning overflow on narrow viewports"),
        ]),
        new("Marcus Rivera", "MR", "Backend Engineer",
        [
            new("Added",      "GraphQL subscription support for real-time updates"),
            new("Added",      "Connection pooling with automatic failover for Postgres"),
            new("Refactored", "Migrated auth middleware to edge-compatible runtime"),
        ]),
        new("Elena Volkov", "EV", "Design Engineer",
        [
            new("Improved", "Increased touch targets to 44px on all interactive elements"),
            new("Fixed",    "Color contrast ratio for muted text in dark mode"),
            new("Added",    "Motion-reduced variants for all animated components"),
        ]),
        new("James Park", "JP", "Platform Engineer",
        [
            new("Improved", "CI pipeline now runs tests in parallel across 4 shards"),
            new("Fixed",    "Docker build cache invalidation on dependency updates"),
        ]),
    ];
}
