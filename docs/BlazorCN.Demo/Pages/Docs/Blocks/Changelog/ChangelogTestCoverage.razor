@* ============================================================
   Block: changelog-test-coverage
   Title: ChangelogTestCoverage
   Description: React test coverage metrics changelog block for Next.js displaying per-release coverage percentages, pass/fail counts, and trend indicators built with shadcn/ui Badge, Tailwind CSS, and Framer Motion.
   Source: original/blocks/changelog/changelog-test-coverage.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Test Coverage</h2>
            <span class="ml-auto text-xs text-muted-foreground">Per release</span>
        </div>

        @* Summary stats (latest release) *@
        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-4 text-center">
                <span class="text-xs text-muted-foreground">Coverage</span>
                <p class="@Cn.Merge("mt-1 text-2xl font-semibold tabular-nums", GetScoreColor(_latest.TotalCoverage))">
                    @(_latest.TotalCoverage)%
                </p>
            </div>
            <div class="border-r px-4 py-4 text-center">
                <span class="text-xs text-muted-foreground">Tests</span>
                <p class="mt-1 text-2xl font-semibold tabular-nums">
                    @(_latest.TotalTests.ToString("N0"))
                </p>
            </div>
            <div class="px-4 py-4 text-center">
                <span class="text-xs text-muted-foreground">Failed</span>
                <p class="@Cn.Merge("mt-1 text-2xl font-semibold tabular-nums", _latest.Failed > 0 ? "text-red-600 dark:text-red-400" : "text-emerald-600 dark:text-emerald-400")">
                    @(_latest.Failed)
                </p>
            </div>
        </div>

        @* Release list *@
        <div>
            @foreach (var release in _releases)
            {
                var isExpanded = _expanded == release.Id;
                var isLast = release.Id == _releases[_releases.Length - 1].Id;
                <div>
                    <button type="button"
                            class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")"
                            @onclick="@(() => ToggleExpand(release.Id))">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", release.Failed > 0 ? "bg-red-500" : "bg-emerald-500")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@release.Version</span>
                                <span class="@Cn.Merge("flex items-center gap-0.5 text-xs tabular-nums", GetDeltaColor(release.Delta))">
                                    @if (release.Delta > 0)
                                    {
                                        <LucideIconCn Name="arrow-up" Size="12" Class="size-3" />
                                    }
                                    else if (release.Delta < 0)
                                    {
                                        <LucideIconCn Name="arrow-down" Size="12" Class="size-3" />
                                    }
                                    @if (release.Delta != 0)
                                    {
                                        @(Math.Abs(release.Delta).ToString("G") + "%")
                                    }
                                </span>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                @release.Passed passed &middot; @release.Failed failed &middot; @release.Skipped skipped
                            </p>
                        </div>
                        <span class="@Cn.Merge("shrink-0 font-mono text-sm font-semibold tabular-nums", GetScoreColor(release.TotalCoverage))">
                            @(release.TotalCoverage)%
                        </span>
                        <span class="shrink-0 text-xs text-muted-foreground">@release.Date</span>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>
                    @if (isExpanded)
                    {
                        <div class="@Cn.Merge("bg-muted/50 px-4 py-3", !isLast ? "border-b" : "")">
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <span class="text-xs font-medium text-muted-foreground">Line coverage</span>
                                    <p class="@Cn.Merge("mt-0.5 font-mono text-sm tabular-nums", GetScoreColor(release.LineCoverage))">
                                        @(release.LineCoverage)%
                                    </p>
                                </div>
                                <div>
                                    <span class="text-xs font-medium text-muted-foreground">Branch coverage</span>
                                    <p class="@Cn.Merge("mt-0.5 font-mono text-sm tabular-nums", GetScoreColor(release.BranchCoverage))">
                                        @(release.BranchCoverage)%
                                    </p>
                                </div>
                            </div>
                            <div class="mt-3 flex items-center gap-3">
                                @if (release.NewTests > 0)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                        +@release.NewTests new tests
                                    </BadgeCn>
                                }
                                @if (release.RemovedTests > 0)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                        -@release.RemovedTests removed
                                    </BadgeCn>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Release(
        string Id,
        string Version,
        string Date,
        double TotalCoverage,
        double LineCoverage,
        double BranchCoverage,
        int TotalTests,
        int Passed,
        int Failed,
        int Skipped,
        double Delta,
        int NewTests,
        int RemovedTests);

    private static readonly Release[] _releases =
    [
        new("r1", "v5.4.0", "Mar 30, 2026", 87.3, 89.1, 82.6, 2847, 2839, 0, 8,  2.1, 64, 3),
        new("r2", "v5.3.0", "Mar 22, 2026", 85.2, 87.0, 80.4, 2786, 2782, 1, 3,  1.4, 38, 12),
        new("r3", "v5.2.1", "Mar 15, 2026", 83.8, 85.9, 78.2, 2760, 2755, 2, 3, -0.6, 11, 24),
        new("r4", "v5.2.0", "Mar 8, 2026",  84.4, 86.1, 79.8, 2773, 2770, 0, 3,  3.2, 92, 5),
        new("r5", "v5.1.0", "Feb 28, 2026", 81.2, 83.4, 76.1, 2686, 2680, 3, 3, -1.1, 15, 41),
        new("r6", "v5.0.0", "Feb 18, 2026", 82.3, 84.7, 77.0, 2712, 2706, 4, 2,  0.0,  0,  0),
    ];

    private Release _latest => _releases[0];

    private string? _expanded = "r1";

    private void ToggleExpand(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private static string GetScoreColor(double score)
    {
        if (score >= 80) return "text-emerald-600 dark:text-emerald-400";
        if (score >= 60) return "text-amber-600 dark:text-amber-400";
        return "text-red-600 dark:text-red-400";
    }

    private static string GetDeltaColor(double delta)
    {
        if (delta > 0) return "text-emerald-600 dark:text-emerald-400";
        if (delta < 0) return "text-red-600 dark:text-red-400";
        return "text-muted-foreground";
    }
}
