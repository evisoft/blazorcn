@* ============================================================
   Block: changelog-milestone-markers
   Title: ChangelogMilestoneMarkers
   Description: React changelog timeline with diamond milestone markers for major releases and smaller dots for patches built with TypeScript, Framer Motion, shadcn/ui Badge, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-milestone-markers.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="flag" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Milestones</h2>
            <span class="ml-auto text-xs text-muted-foreground">
                @(_entries.Count(e => e.IsMilestone)) major releases
            </span>
        </div>

        <div class="relative">
            <div class="absolute top-0 bottom-0 left-[23px] w-px bg-border"></div>

            @for (var i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                var isLast = i == _entries.Length - 1;
                <div class="@Cn.Merge("relative flex gap-4 px-4 py-3", isLast ? "" : "border-b")">
                    <div class="relative z-10 flex w-3 shrink-0 items-start justify-center pt-1">
                        @if (entry.IsMilestone)
                        {
                            <span class="size-3 rotate-45 border-2 border-foreground bg-card"></span>
                        }
                        else
                        {
                            <span class="size-2 rounded-full bg-muted-foreground/40"></span>
                        }
                    </div>

                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@entry.Title</span>
                            <BadgeCn Class="@($"text-[10px] {TagStyle(entry.Tag)}")">@entry.Tag</BadgeCn>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">@entry.Description</p>
                        <div class="mt-1 flex items-center gap-2 text-xs text-muted-foreground">
                            <span class="font-mono">@entry.Version</span>
                            <span>·</span>
                            <span>@entry.Date</span>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Entry(string Version, string Date, string Title, string Description, bool IsMilestone, string Tag);

    private static readonly Entry[] _entries =
    [
        new("v4.0.0", "Mar 28, 2026", "Platform V4 — Unified Workspace",
            "Complete architecture overhaul with unified workspace, real-time multiplayer, and a new plugin system.",
            true, "major"),
        new("v3.9.2", "Mar 14, 2026", "Hotfix: CSV export encoding",
            "Fixed UTF-8 BOM encoding for CSV exports in non-English locales.",
            false, "patch"),
        new("v3.9.1", "Mar 7, 2026", "Performance improvements",
            "Reduced initial bundle size by 18% through dynamic imports and tree-shaking optimizations.",
            false, "patch"),
        new("v3.9.0", "Feb 20, 2026", "Team analytics dashboard",
            "New analytics page with team activity heatmaps, sprint velocity charts, and custom date ranges.",
            false, "minor"),
        new("v3.0.0", "Jan 15, 2026", "Platform V3 — API-First Redesign",
            "Public REST and GraphQL APIs, webhook system, and a developer portal with interactive documentation.",
            true, "major"),
        new("v2.12.0", "Dec 3, 2025", "Dark mode and theme engine",
            "System-wide dark mode with a custom theme engine supporting brand color overrides and contrast checking.",
            false, "minor"),
    ];

    private static string TagStyle(string tag) => tag switch
    {
        "major" => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-0",
        "minor" => "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-0",
        _ => "bg-muted text-muted-foreground border-0",
    };
}
