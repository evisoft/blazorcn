@* ============================================================
   Block: changelog-workflow-automation
   Title: ChangelogWorkflowAutomation
   Description: A React changelog component tracking workflow automation changes with trigger definitions, action configurations, and conditional logic built with shadcn/ui, Tailwind CSS, and Next.js
   Source: original/blocks/changelog/changelog-workflow-automation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="zap" Size="16" Class="size-4 text-muted-foreground" />
                    <h2 class="text-sm font-medium">Workflow Automation</h2>
                </div>
                <div class="flex items-center gap-2 text-xs text-muted-foreground">
                    <LucideIconCn Name="activity" Size="12" Class="size-3" />
                    <span>Active workflows</span>
                </div>
            </div>
        </div>

        @* Workflow list *@
        <div class="divide-y">
            @foreach (var wf in _workflows)
            {
                var workflow = wf;
                var isExpanded = _expandedItems.Contains(workflow.Id);
                var changeConfig = _changeTypeConfig[workflow.ChangeType];
                var triggerIcon = _triggerIcons[workflow.Trigger.Type];
                <div>
                    <button type="button"
                            class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => ToggleItem(workflow.Id))">
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("mt-1 size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@workflow.WorkflowName</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("h-4 px-1 text-xs", changeConfig.Bg, changeConfig.Color)">
                                    @changeConfig.Label
                                </BadgeCn>
                            </div>

                            <div class="mt-1 flex items-center gap-2">
                                <span class="text-xs text-muted-foreground">@workflow.Version</span>
                                <span class="text-xs text-muted-foreground">•</span>
                                <span class="text-xs text-muted-foreground">@workflow.ReleaseDate</span>
                            </div>

                            <div class="mt-2 flex items-center gap-2 rounded-md bg-muted/50 px-2 py-1">
                                <LucideIconCn Name="@triggerIcon" Size="12" Class="size-3 text-muted-foreground" />
                                <span class="text-xs text-muted-foreground">@workflow.Trigger.Description</span>
                            </div>

                            <div class="mt-3 grid grid-cols-3 gap-3">
                                <div>
                                    <span class="text-xs text-muted-foreground">Executions</span>
                                    <p class="mt-1 font-mono text-sm font-medium tabular-nums">@workflow.Metrics.Executions</p>
                                </div>
                                <div>
                                    <span class="text-xs text-muted-foreground">Success Rate</span>
                                    <div class="mt-1 flex items-center gap-1">
                                        <p class="font-mono text-sm font-medium tabular-nums text-emerald-600">@(workflow.Metrics.SuccessRate)%</p>
                                        <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-600" />
                                    </div>
                                </div>
                                <div>
                                    <span class="text-xs text-muted-foreground">Avg Duration</span>
                                    <p class="mt-1 font-mono text-sm font-medium tabular-nums">@workflow.Metrics.AvgDuration</p>
                                </div>
                            </div>
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t px-4 py-3">
                            <div class="space-y-4">
                                @if (workflow.Conditions.Length > 0)
                                {
                                    <div>
                                        <h3 class="mb-2 flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                                            <LucideIconCn Name="filter" Size="12" Class="size-3" />
                                            Conditions
                                        </h3>
                                        <div class="space-y-1">
                                            @foreach (var cond in workflow.Conditions)
                                            {
                                                var condition = cond;
                                                <div class="flex items-center gap-2 text-sm">
                                                    <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 px-1.5 font-mono text-xs">@condition.Field</BadgeCn>
                                                    <span class="text-xs text-muted-foreground">@_operatorLabels[condition.Operator]</span>
                                                    <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 px-1.5 text-xs">@condition.Value</BadgeCn>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                <div>
                                    <h4 class="mb-2 flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                                        <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
                                        Actions
                                    </h4>
                                    <div class="space-y-2">
                                        @{ var actionIdx = 0; }
                                        @foreach (var act in workflow.Actions)
                                        {
                                            var action = act;
                                            var idx = actionIdx++;
                                            <div class="rounded-md bg-muted/50 p-2">
                                                <p class="text-sm font-medium">@(idx + 1). @action.Type</p>
                                                <div class="mt-1 flex flex-wrap gap-2">
                                                    @foreach (var kv in action.Config)
                                                    {
                                                        <span class="text-xs text-muted-foreground">@kv.Key: @kv.Value</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>

                                @if (workflow.Notes.Length > 0)
                                {
                                    <div>
                                        <h4 class="mb-2 text-xs font-medium text-muted-foreground">Notes</h4>
                                        <ul class="space-y-1">
                                            @foreach (var note in workflow.Notes)
                                            {
                                                <li class="text-sm text-muted-foreground">• @note</li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record WorkflowTrigger(string Type, string Description);
    private record WorkflowCondition(string Field, string Operator, string Value);
    private record WorkflowAction(string Type, Dictionary<string, string> Config);
    private record WorkflowMetrics(int Executions, double SuccessRate, string AvgDuration);
    private record WorkflowChange(
        string Id,
        string Version,
        string ReleaseDate,
        string WorkflowName,
        string ChangeType,
        WorkflowTrigger Trigger,
        WorkflowCondition[] Conditions,
        WorkflowAction[] Actions,
        WorkflowMetrics Metrics,
        string[] Notes
    );

    private record ChangeTypeInfo(string Label, string Color, string Bg);

    private static readonly WorkflowChange[] _workflows =
    [
        new(
            Id: "workflow-1",
            Version: "v3.2.0",
            ReleaseDate: "2026-03-29",
            WorkflowName: "Auto-assign Support Tickets",
            ChangeType: "added",
            Trigger: new("event", "New support ticket created"),
