                new("Wait", new() { ["duration"] = "3 days" }),
                new("Send email", new() { ["template"] = "feature-highlights", ["personalized"] = "true" }),
            ],
            Metrics: new(1847, 99.2, "72h 3m"),
            Notes:
            [
                "Updated email templates with personalized content",
                "Added 3-day delay before feature highlights email",
                "Improved open rates by 23% compared to previous version",
            ]
        ),
        new(
            Id: "workflow-3",
            Version: "v3.0.0",
            ReleaseDate: "2026-03-01",
            WorkflowName: "Daily Usage Report Generation",
            ChangeType: "optimized",
            Trigger: new("schedule", "Daily at 9:00 AM UTC"),
            Conditions: [],
            Actions:
            [
                new("Query database", new() { ["query"] = "aggregate_daily_metrics" }),
                new("Generate PDF report", new() { ["template"] = "daily-usage", ["charts"] = "true" }),
                new("Send email", new() { ["recipients"] = "admin@@example.com", ["attach"] = "report.pdf" }),
            ],
            Metrics: new(30, 100, "12.4s"),
            Notes:
            [
                "Optimized database query - reduced execution time by 64%",
                "Implemented incremental data aggregation for better performance",
                "Added retry logic for email delivery failures",
            ]
        ),
    ];

    private static readonly Dictionary<string, ChangeTypeInfo> _changeTypeConfig = new()
    {
        ["added"]      = new("Added",      "text-emerald-600", "bg-emerald-500/10 border-emerald-500/20"),
        ["modified"]   = new("Modified",   "text-blue-600",    "bg-blue-500/10 border-blue-500/20"),
        ["deprecated"] = new("Deprecated", "text-red-600",     "bg-red-500/10 border-red-500/20"),
        ["optimized"]  = new("Optimized",  "text-purple-600",  "bg-purple-500/10 border-purple-500/20"),
    };

    private static readonly Dictionary<string, string> _triggerIcons = new()
    {
        ["webhook"]  = "zap",
        ["schedule"] = "activity",
        ["event"]    = "play",
        ["manual"]   = "filter",
    };

    private static readonly Dictionary<string, string> _operatorLabels = new()
    {
        ["equals"]       = "=",
        ["contains"]     = "contains",
        ["greater_than"] = ">",
        ["less_than"]    = "<",
    };

    private readonly HashSet<string> _expandedItems = [];

    private void ToggleItem(string id)
    {
        if (!_expandedItems.Add(id))
            _expandedItems.Remove(id);
    }
}
