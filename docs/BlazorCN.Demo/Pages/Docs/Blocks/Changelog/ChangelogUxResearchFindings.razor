                "Icon+label combination significantly improved recognition speed",
                "Mobile users particularly benefited from the hamburger menu reorganization",
            ]),
        new("research-2", "v3.0.0", "2026-03-15", "interview", 8,
            "Deep-dive interviews on onboarding experience and feature discovery",
            "high",
            [
                new("Onboarding Completion", "78%", "+23%", true),
