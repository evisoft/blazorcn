@* ============================================================
   Block: changelog-ux-research-findings
   Title: ChangelogUxResearchFindings
   Description: A React changelog component displaying user experience research insights tied to releases with participant quotes, metrics, and behavioral data built with shadcn/ui, Tailwind CSS, and Next.js
   Source: original/blocks/changelog/changelog-ux-research-findings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="clipboard-list" Size="16" Class="size-4 text-muted-foreground" />
                    <h2 class="text-sm font-medium">UX Research Findings</h2>
                </div>
                <div class="flex items-center gap-2 text-xs text-muted-foreground">
                    <LucideIconCn Name="users" Size="12" Class="size-3" />
                    <span>User insights</span>
                </div>
            </div>
        </div>

        @* Findings list *@
        <div class="divide-y">
            @foreach (var finding in _findings)
            {
                var isExpanded = _expandedItems.Contains(finding.Id);
                var methodConfig = _methodologyConfig[finding.Methodology];
                var chevronClass = Cn.Merge("mt-1 size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
                var impactDotClass = Cn.Merge("size-1.5 rounded-full", _impactColors[finding.Impact]);
                var metricImprovedClass = "flex items-center gap-1 text-xs text-emerald-600";
                var metricNotImprovedClass = "flex items-center gap-1 text-xs text-red-600";
                var badgeClass = Cn.Merge("h-5 px-1.5 text-xs", methodConfig.Bg, methodConfig.Color);
                var findingId = finding.Id;
                <div>
                    <button type="button" @onclick="@(() => ToggleItem(findingId))"
                            class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@finding.Version</span>
                                <span class="text-xs text-muted-foreground">@finding.ReleaseDate</span>
                                <span class="@impactDotClass"></span>
                            </div>

                            <div class="mt-1 flex flex-wrap items-center gap-2">
                                <BadgeCn Variant="BadgeVariant.Outline" Class="@badgeClass">
                                    @methodConfig.Label
                                </BadgeCn>
                                <span class="text-xs text-muted-foreground">
                                    @finding.Participants participants
                                </span>
                            </div>

                            <p class="mt-2 text-sm text-muted-foreground">@finding.Summary</p>

                            <div class="mt-3 grid grid-cols-3 gap-3">
                                @foreach (var metric in finding.Metrics)
                                {
                                    <div>
                                        <span class="text-xs text-muted-foreground">@metric.Label</span>
                                        <p class="mt-1 font-mono text-sm font-medium tabular-nums">
                                            @metric.Value
                                        </p>
                                        @if (metric.Change != null)
                                        {
                                            var trendClass = metric.Improved ? metricImprovedClass : metricNotImprovedClass;
                                            <div class="@trendClass">
                                                <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                                                <span>@metric.Change</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t px-4 py-3">
                            <div class="space-y-4">
                                @if (finding.Quotes.Length > 0)
                                {
                                    <div>
                                        <h3 class="mb-2 flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                                            <LucideIconCn Name="message-square" Size="12" Class="size-3" />
                                            Participant Quotes
                                        </h3>
                                        <div class="space-y-2">
                                            @foreach (var quote in finding.Quotes)
                                            {
                                                <div class="rounded-md bg-muted/50 p-3">
                                                    <div class="flex items-start gap-2">
                                                        <LucideIconCn Name="quote" Size="12" Class="mt-0.5 size-3 shrink-0 text-muted-foreground/40" />
                                                        <p class="text-sm italic text-muted-foreground">
                                                            @quote.Text
                                                        </p>
                                                    </div>
                                                    <div class="mt-2 flex items-center gap-2 text-xs text-muted-foreground">
                                                        <span class="font-medium">@quote.Participant</span>
                                                        <span>&bull;</span>
                                                        <span>@quote.Role</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (finding.Insights.Length > 0)
                                {
                                    <div>
                                        <h4 class="mb-2 flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                                            <LucideIconCn Name="target" Size="12" Class="size-3" />
                                            Key Insights
                                        </h4>
                                        <ul class="space-y-1">
                                            @foreach (var insight in finding.Insights)
                                            {
                                                <li class="text-sm text-muted-foreground">
                                                    &bull; @insight
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Metric(string Label, string Value, string? Change, bool Improved);
    private record Quote(string Text, string Participant, string Role);
    private record Finding(string Id, string Version, string ReleaseDate, string Methodology, int Participants, string Summary, string Impact, Metric[] Metrics, Quote[] Quotes, string[] Insights);
    private record MethodologyConfig(string Label, string Color, string Bg);

    private readonly HashSet<string> _expandedItems = [];

    private void ToggleItem(string id)
    {
        if (!_expandedItems.Add(id))
            _expandedItems.Remove(id);
    }

    private static readonly Dictionary<string, MethodologyConfig> _methodologyConfig = new()
    {
        ["usability-test"] = new("Usability Test", "text-blue-600", "bg-blue-500/10 border-blue-500/20"),
        ["interview"]       = new("User Interview", "text-purple-600", "bg-purple-500/10 border-purple-500/20"),
        ["survey"]          = new("Survey", "text-emerald-600", "bg-emerald-500/10 border-emerald-500/20"),
        ["analytics"]       = new("Analytics", "text-amber-600", "bg-amber-500/10 border-amber-500/20"),
        ["a-b-test"]        = new("A/B Test", "text-cyan-600", "bg-cyan-500/10 border-cyan-500/20"),
    };

    private static readonly Dictionary<string, string> _impactColors = new()
    {
        ["high"]   = "bg-red-500",
        ["medium"] = "bg-amber-500",
        ["low"]    = "bg-emerald-500",
    };

    private static readonly Finding[] _findings =
