@* ============================================================
   Block: changelog-with-avatars
   Title: ChangelogWithAvatars
   Description: React changelog with author avatars block for Next.js with contributor initials, role labels, and categorized entries built with TypeScript, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-with-avatars.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">Team Changelog</span>
        </div>

        @* Entries *@
        <div>
            @foreach (var entry in _entries)
            {
                var initials = GetInitials(entry.Author.Name);
                var isLast = entry == _entries[^1];
                var dotClass = GetCategoryDot(entry.Category);
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-start gap-3 px-4 py-3">
                        @* Avatar *@
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium text-muted-foreground">
                            @initials
                        </div>

                        @* Content *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-xs font-medium">@entry.Author.Name</span>
                                <span class="text-[10px] text-muted-foreground/60">
                                    @entry.Author.Role
                                </span>
                                <span class="text-muted-foreground/40">&middot;</span>
                                <span class="text-xs text-muted-foreground/60">@entry.Date</span>
                            </div>
                            <div class="mt-1 flex items-start gap-2">
                                <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", dotClass)"
                                      aria-hidden="true" />
                                <div class="min-w-0">
                                    <span class="text-sm font-medium">@entry.Title</span>
                                    <p class="mt-0.5 text-xs text-muted-foreground">@entry.Description</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Author(string Name, string Role);
    private record ChangeEntry(Author Author, string Title, string Description, string Date, string Category);

    private static string GetInitials(string name) =>
        string.Concat(name.Split(' ').Select(n => n[0]));

    private static string GetCategoryDot(string category) => category switch
    {
        "feature"     => "bg-emerald-500",
        "fix"         => "bg-red-500",
        "improvement" => "bg-blue-500",
        _             => "bg-gray-500",
    };

    private static readonly ChangeEntry[] _entries =
    [
        new(new("Sarah Chen",    "Frontend"),  "Real-time collaboration cursors",   "Added live cursor presence and selection highlighting for shared editing sessions.",          "Mar 28", "feature"),
        new(new("Marcus Rivera", "Backend"),   "Database connection pooling",        "Automatic pool management with configurable limits and idle timeout.",                        "Mar 27", "improvement"),
        new(new("Emma Wilson",   "Platform"),  "Edge function cold starts",          "Reduced cold start latency from 120ms to 45ms through bundle optimization.",                  "Mar 26", "improvement"),
        new(new("James Kim",     "Security"),  "Rate limiter IP validation",         "Fixed bypass via X-Forwarded-For spoofing by validating socket connection IP.",               "Mar 25", "fix"),
        new(new("Sarah Chen",    "Frontend"),  "Custom theme editor",                "HSL color pickers with live preview and CSS variable export.",                                "Mar 24", "feature"),
        new(new("Olivia Brown",  "QA"),        "Safari file upload fix",             "Resolved blob URL revocation timing causing blank previews on Safari 18.",                    "Mar 23", "fix"),
    ];
}
