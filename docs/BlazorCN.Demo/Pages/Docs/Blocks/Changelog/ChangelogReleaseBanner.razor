@* ============================================================
   Block: changelog-release-banner
   Title: ChangelogReleaseBanner
   Description: React release banner changelog block for Next.js with a prominent latest release section, version badge, key highlight, and compact change list built with TypeScript, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-release-banner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="flag" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Latest Release</h2>
        </div>

        <div class="border-b bg-muted/30 px-4 py-4">
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-xs">
                    @_latestRelease.Version
                </BadgeCn>
                <span class="text-xs text-muted-foreground">@_latestRelease.Date</span>
            </div>
            <p class="mt-2 text-sm text-foreground leading-relaxed">@_latestRelease.Highlight</p>
        </div>

        <div class="border-b px-4 py-2">
            <span class="text-xs font-medium text-muted-foreground">
                All changes in this release
            </span>
        </div>

        <div>
            @for (var idx = 0; idx < _latestRelease.Changes.Length; idx++)
            {
                var change = _latestRelease.Changes[idx];
                var rowClass = Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", idx < _latestRelease.Changes.Length - 1 ? "border-b" : "");
                <div class="@rowClass">
                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", _dotColors[change.Category])"></span>
                    <span class="min-w-0 flex-1 truncate text-sm">@change.Title</span>
                    <span class="shrink-0 text-xs text-muted-foreground">
                        @_categoryLabels[change.Category]
                    </span>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Change(string Title, string Category);

    private record Release(string Version, string Date, string Highlight, Change[] Changes);

    private static readonly Dictionary<string, string> _dotColors = new()
    {
        ["feature"] = "bg-emerald-500",
        ["fix"] = "bg-red-500",
        ["improvement"] = "bg-blue-500",
    };

    private static readonly Dictionary<string, string> _categoryLabels = new()
    {
        ["feature"] = "Feature",
        ["fix"] = "Fix",
        ["improvement"] = "Improvement",
    };

    private static readonly Release _latestRelease = new(
        "v3.12.0",
        "Mar 28, 2026",
        "Introducing collaborative workspaces with real-time presence, granular permissions, and cross-team project sharing.",
        [
            new("Collaborative workspace creation and management", "feature"),
            new("Real-time cursor presence for shared documents", "feature"),
            new("Granular role-based permission controls", "feature"),
            new("Fixed session expiry during long editing sessions", "fix"),
            new("Reduced initial dashboard load time by 35%", "improvement"),
            new("Fixed CSV export failing on datasets over 50k rows", "fix"),
            new("Improved webhook delivery reliability with retry backoff", "improvement"),
            new("Keyboard shortcuts for workspace switching", "feature"),
        ]
    );
}
