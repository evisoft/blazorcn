@* ============================================================
   Block: changelog-share-social
   Title: ChangelogShareSocial
   Description: React changelog block with social sharing buttons for Next.js, featuring Twitter/X share and copy link icons per entry with ghost button styling built with TypeScript, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-share-social.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="share" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Changelog</h2>
            <span class="text-xs text-muted-foreground">Share updates</span>
        </div>

        <div>
            @for (var i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                var entryId = entry.Id;
                <div class="flex items-start justify-between gap-3 border-b px-4 py-3 last:border-b-0">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="@($"size-1.5 shrink-0 rounded-full {_typeColors[entry.Type]}")"></span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-[10px]">
                                @entry.Version
                            </BadgeCn>
                            <span class="text-xs text-muted-foreground">@entry.Date</span>
                        </div>
                        <p class="mt-1 text-sm font-medium">@entry.Title</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">@entry.Description</p>
                    </div>
                    <div class="flex shrink-0 items-center gap-0.5">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                  Class="size-7 p-0 text-muted-foreground"
                                  aria-label="@($"Share {entry.Title} on X")"
                                  @onclick="@(() => HandleShareTwitter(entry))">
                            <svg viewBox="0 0 24 24" fill="currentColor" class="size-3" aria-label="X formerly Twitter">
                                <title>X</title>
                                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                            </svg>
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                  Class="size-7 p-0 text-muted-foreground"
                                  aria-label="@($"Copy link for {entry.Title}")"
                                  @onclick="@(() => HandleCopyLink(entryId))">
                            @if (_copiedId == entry.Id)
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3" />
                            }
                            else
                            {
                                <LucideIconCn Name="link" Size="12" Class="size-3" />
                            }
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ChangelogEntry(
        string Id,
        string Version,
        string Date,
        string Title,
        string Description,
        string Type
    );

    private string? _copiedId;

    private async Task HandleCopyLink(string id)
    {
        _copiedId = id;
        await Task.Delay(2000);
        _copiedId = null;
        StateHasChanged();
    }

    private static void HandleShareTwitter(ChangelogEntry entry)
    {
        // Twitter share is a browser-side navigation; no JS interop available in static port.
        // The button renders correctly; actual window.open would require JSInterop.
    }

    private static readonly Dictionary<string, string> _typeColors = new()
    {
        ["feature"]     = "bg-blue-500",
        ["fix"]         = "bg-red-500",
        ["improvement"] = "bg-amber-500",
    };

    private static readonly ChangelogEntry[] _entries =
    [
        new("v3-1-0", "3.1.0", "Mar 28, 2026",
            "Real-time collaboration cursors",
            "See teammate cursors and selections in real time across all document types.",
            "feature"),
        new("v3-0-4", "3.0.4", "Mar 25, 2026",
            "Fixed dark mode flicker on load",
            "Eliminated the white flash when loading pages with dark mode preference saved.",
            "fix"),
        new("v3-0-3", "3.0.3", "Mar 23, 2026",
            "Improved table rendering performance",
            "Virtualized rendering for tables with 10,000+ rows reducing DOM nodes by 95%.",
            "improvement"),
        new("v3-0-2", "3.0.2", "Mar 21, 2026",
            "Keyboard shortcut customization",
            "Users can now rebind all keyboard shortcuts from the settings panel.",
            "feature"),
        new("v3-0-1", "3.0.1", "Mar 19, 2026",
            "Fixed file upload timeout",
            "Resolved timeout errors when uploading files larger than 100MB on slow connections.",
            "fix"),
        new("v3-0-0", "3.0.0", "Mar 17, 2026",
            "Version 3 general availability",
            "Major release with new plugin system, improved API, and redesigned dashboard.",
            "feature"),
        new("v2-9-8", "2.9.8", "Mar 15, 2026",
            "Reduced bundle size by 18%",
            "Tree-shaking improvements and dependency audit cut the production bundle significantly.",
            "improvement"),
    ];
}
