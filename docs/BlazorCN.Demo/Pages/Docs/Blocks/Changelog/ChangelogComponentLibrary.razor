@* ============================================================
   Block: changelog-component-library
   Title: ChangelogComponentLibrary
   Description: A UI component library changelog displaying component names in monospace, version bumps, breaking vs non-breaking badges, and detailed change lists with staggered animations.
   Source: original/blocks/changelog/changelog-component-library.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="layout-grid" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Component Library</h2>
            <span class="ml-auto text-xs text-muted-foreground">@_entries.Length updates</span>
        </div>

        <div class="flex items-center gap-3 border-b px-4 py-2">
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-red-500"></span>
                <span class="text-xs text-muted-foreground">@BreakingCount breaking</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-xs text-muted-foreground">@(_entries.Length - BreakingCount) non-breaking</span>
            </div>
        </div>

        @foreach (var entry in _entries)
        {
            var isExpanded = _expandedId == entry.Id;
            var entryId = entry.Id;
            var chevronClass = Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
            <div class="border-b last:border-b-0">
                <button type="button" @onclick="@(() => Toggle(entryId))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-mono text-sm font-medium">@entry.Component</span>
                            <span class="font-mono text-xs text-muted-foreground">
                                @entry.FromVersion → @entry.ToVersion
                            </span>
                            @if (entry.IsBreaking)
                            {
                                <span class="rounded-full bg-red-500/10 px-1.5 py-0.5 text-[10px] font-medium leading-none text-red-600">
                                    Breaking
                                </span>
                            }
                            else
                            {
                                <span class="rounded-full bg-emerald-500/10 px-1.5 py-0.5 text-[10px] font-medium leading-none text-emerald-600">
                                    Compatible
                                </span>
                            }
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @entry.Changes.Length change@(entry.Changes.Length != 1 ? "s" : "") · @entry.Date
                        </p>
                    </div>
                    <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                </button>

                @if (isExpanded)
                {
                    <div class="border-t bg-muted/30 px-4 py-3">
                        <ul class="space-y-1.5">
                            @foreach (var change in entry.Changes)
                            {
                                <li class="flex items-start gap-2 text-xs text-muted-foreground">
                                    <span class="mt-1.5 size-1 shrink-0 rounded-full bg-muted-foreground/40"></span>
                                    @change
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }

    </div>
</section>

@code {
    private record LibraryChange(
        string Id,
        string Component,
        string FromVersion,
        string ToVersion,
        bool IsBreaking,
        string Date,
        string[] Changes
    );

    private static readonly LibraryChange[] _entries =
    [
        new("lc1", "Dialog", "1.4.2", "2.0.0", true, "Mar 28, 2026",
        [
            "Replaced onClose prop with onOpenChange callback",
            "Portal now renders to document.body by default",
            "Added compound component pattern: Dialog.Trigger, Dialog.Content",
            "Removed size prop — use className for custom widths",
        ]),
        new("lc2", "Select", "1.2.0", "1.3.0", false, "Mar 26, 2026",
        [
            "Added multi-select support via multiple prop",
            "New onSearchChange callback for async filtering",
            "Improved virtualization for lists over 1,000 items",
        ]),
        new("lc3", "Table", "2.1.0", "3.0.0", true, "Mar 24, 2026",
        [
            "Column definitions now use accessor functions instead of string keys",
            "Removed built-in pagination — use Pagination component",
            "Added column pinning and resizing support",
            "Row selection state moved to controlled pattern only",
        ]),
        new("lc4", "Tooltip", "1.0.3", "1.1.0", false, "Mar 22, 2026",
        [
            "Added delayDuration prop with 200ms default",
            "New arrow prop to show tooltip arrow indicator",
            "Fixed positioning when near viewport edges",
        ]),
        new("lc5", "Tabs", "1.5.0", "1.6.0", false, "Mar 20, 2026",
        [
            "Added vertical orientation support",
            "New animated indicator with layout transitions",
            "Tab content now supports lazy rendering via forceMount",
        ]),
        new("lc6", "Form", "3.2.1", "4.0.0", true, "Mar 18, 2026",
        [
            "Switched validation engine from Yup to Zod",
            "New useFormField hook replaces FormContext consumer",
            "Field error messages render inline by default",
            "Removed onSubmitError — use form.setError() instead",
        ]),
    ];

    private string? _expandedId;

    private int BreakingCount => _entries.Count(e => e.IsBreaking);

    private void Toggle(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }
}
