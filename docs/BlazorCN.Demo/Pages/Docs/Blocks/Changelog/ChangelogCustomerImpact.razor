@* ============================================================
   Block: changelog-customer-impact
   Title: ChangelogCustomerImpact
   Description: A customer impact changelog block for React and Next.js with affected user counts, severity indicators, and resolution status built with shadcn/ui and Tailwind CSS
   Source: original/blocks/changelog/changelog-customer-impact.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Customer Impact Report</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">v3.12.0</BadgeCn>
        </div>

        @* Summary stats *@
        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <p class="font-semibold text-lg tabular-nums">@_entries.Length</p>
                <p class="text-muted-foreground text-xs">Issues tracked</p>
            </div>
            <div class="border-r px-4 py-3">
                <p class="font-semibold text-lg tabular-nums">@_totalAffected</p>
                <p class="text-muted-foreground text-xs">Users affected</p>
            </div>
            <div class="px-4 py-3">
                <p class="font-semibold text-lg tabular-nums">@($"{_resolvedCount}/{_entries.Length}")</p>
                <p class="text-muted-foreground text-xs">Resolved</p>
            </div>
        </div>

        @* Entries *@
        <div>
            @foreach (var ent in _entries)
            {
                var entry = ent;
                var isExpanded = _expanded == entry.Id;
                var isLast = entry.Id == _entries[^1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => SetExpanded(entry.Id, isExpanded))">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", GetSeverityColor(entry.Severity))"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@entry.Title</span>
                                <LucideIconCn Name="@GetStatusIconName(entry.Status)" Size="14" Class="@Cn.Merge("size-3.5", GetStatusColor(entry.Status))" />
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span>@entry.Date</span>
                                <span>&middot;</span>
                                <span>@entry.AffectedUsers users</span>
                                <span>&middot;</span>
                                <span class="capitalize">@entry.Status</span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-2 px-4 pb-3 pl-9">
                                <p class="text-muted-foreground text-xs">@entry.Description</p>
                                <div class="rounded-md bg-muted/50 p-3">
                                    <span class="font-medium text-muted-foreground text-[10px] uppercase tracking-wider">Resolution</span>
                                    <p class="mt-1 text-xs leading-relaxed">@entry.Resolution</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Report generated Mar 30, 2026 · Next update in 24 hours
            </p>
        </div>

    </div>
</section>

@code {
    private record ImpactEntry(
        string Id,
        string Title,
        string Description,
        string Severity,
        string AffectedUsers,
        string Status,
        string Date,
        string Resolution);

    private static readonly ImpactEntry[] _entries =
    [
        new("e1", "Billing webhook delays",
            "Stripe webhook processing experienced 2-5 minute delays during peak hours.",
            "high", "~3,200", "resolved", "Mar 29",
            "Increased webhook worker pool from 4 to 12 instances and added priority queue for payment events."),
        new("e2", "Dashboard chart rendering",
            "Charts on the analytics dashboard failed to render for users with 100K+ data points.",
            "medium", "~480", "resolved", "Mar 28",
            "Implemented client-side data aggregation with 1,000-point downsampling before chart render."),
        new("e3", "Export CSV encoding",
            "CSV exports used UTF-16 encoding instead of UTF-8, breaking import in some tools.",
            "low", "~120", "resolved", "Mar 27",
            "Changed export encoding to UTF-8 with BOM for Excel compatibility. Added encoding selector."),
        new("e4", "SSO session timeout",
            "SAML SSO sessions expired after 30 minutes instead of the configured 8 hours.",
            "high", "~1,800", "mitigated", "Mar 26",
            "Temporary fix extends session to 2 hours. Root cause is a clock skew between IdP and service. Permanent fix in next release."),
        new("e5", "Search index lag",
            "Full-text search results were stale by up to 15 minutes after content updates.",
            "medium", "~950", "monitoring", "Mar 25",
            "Switched to near-real-time indexing with 30-second refresh interval. Monitoring for performance regression."),
    ];

    private const string _totalAffected = "~6,550";
    private static readonly int _resolvedCount = Array.FindAll(_entries, e => e.Status == "resolved").Length;

    private string? _expanded;

    private void SetExpanded(string id, bool currentlyExpanded)
    {
        _expanded = currentlyExpanded ? null : id;
    }

    private static string GetSeverityColor(string severity) => severity switch
    {
        "low" => "bg-emerald-500",
        "medium" => "bg-amber-500",
        "high" => "bg-red-500",
        _ => "bg-gray-500",
    };

    private static string GetStatusColor(string status) => status switch
    {
        "resolved" => "text-emerald-600 dark:text-emerald-400",
        "mitigated" => "text-amber-600 dark:text-amber-400",
        "monitoring" => "text-blue-600 dark:text-blue-400",
        _ => "text-muted-foreground",
    };

    private static string GetStatusIconName(string status) => status switch
    {
        "resolved" => "check-circle",
        "mitigated" => "alert-triangle",
        "monitoring" => "clock",
        _ => "circle",
    };
}
