@* ============================================================
   Block: changelog-desktop-app
   Title: ChangelogDesktopApp
   Description: A desktop application version history block with OS platform labels, build channel badges, version numbers, and detailed release notes for cross-platform software updates.
   Source: original/blocks/changelog/changelog-desktop-app.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="monitor" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Desktop App Releases</h2>
            <span class="ml-auto text-xs text-muted-foreground">@_releases.Length versions</span>
        </div>

        <div>
            @for (var i = 0; i < _releases.Length; i++)
            {
                var release = _releases[i];
                var rowClass = Cn.Merge("px-4 py-4", i < _releases.Length - 1 ? "border-b" : "");
                var channelClass = Cn.Merge("shrink-0 rounded px-1.5 py-0.5 text-xs font-medium", _channelStyles.GetValueOrDefault(release.Channel, ""));
                <div class="@rowClass">
                    <div class="flex items-center gap-2">
                        <span class="font-mono text-xs font-medium">@release.Version</span>
                        <span class="@channelClass">@release.Channel</span>
                        <span class="ml-auto shrink-0 text-xs text-muted-foreground">@release.Date</span>
                    </div>

                    <h3 class="mt-1.5 text-sm font-medium">@release.Title</h3>

                    <div class="mt-2 flex flex-wrap gap-1.5">
                        @foreach (var platform in release.Platforms)
                        {
                            <span class="rounded-md bg-muted/50 px-2 py-0.5 text-xs text-muted-foreground">
                                @platform.Os
                                <span class="ml-1 opacity-60">@platform.Size</span>
                            </span>
                        }
                    </div>

                    <ul class="mt-2.5 space-y-1">
                        @foreach (var change in release.Changes)
                        {
                            <li class="flex gap-2 text-xs text-muted-foreground">
                                <span class="mt-1.5 size-1 shrink-0 rounded-full bg-muted-foreground/40"></span>
                                <span>@change</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Platform(string Os, string Size);

    private record DesktopRelease(
        string Id,
        string Version,
        string Date,
        string Title,
        string Channel,
        Platform[] Platforms,
        string[] Changes
    );

    private static readonly Dictionary<string, string> _channelStyles = new()
    {
        ["Stable"] = "bg-emerald-500/10 text-emerald-600",
        ["Beta"]   = "bg-amber-500/10 text-amber-600",
    };

    private static readonly DesktopRelease[] _releases =
    [
        new("r1", "v4.2.0", "Mar 27, 2026", "Native Spell Check & GPU Rendering", "Stable",
            [
                new("macOS",   "89 MB"),
                new("Windows", "74 MB"),
                new("Linux",   "71 MB"),
            ],
            [
                "Native spell check integration for all text editors",
                "GPU-accelerated canvas rendering for diagram views",
                "Reduced cold start time by 40% on Windows",
            ]),
        new("r2", "v4.2.0-beta.3", "Mar 22, 2026", "Multi-Window Support Preview", "Beta",
            [
                new("macOS",   "91 MB"),
                new("Windows", "76 MB"),
            ],
            [
                "Multi-window support with independent state per window",
                "Drag tabs between windows to split workflows",
                "Fixed crash when disconnecting external monitors",
            ]),
        new("r3", "v4.1.3", "Mar 14, 2026", "Hotfix: File Sync Reliability", "Stable",
            [
                new("macOS",   "88 MB"),
                new("Windows", "73 MB"),
                new("Linux",   "70 MB"),
            ],
            [
                "Fixed file sync stalling on large repositories with over 10k files",
                "Resolved memory leak in background indexer process",
                "Updated Electron to v33.2.1 for security patches",
            ]),
        new("r4", "v4.1.0", "Mar 5, 2026", "Custom Themes & Plugin API", "Stable",
            [
                new("macOS",   "87 MB"),
                new("Windows", "72 MB"),
                new("Linux",   "69 MB"),
            ],
            [
                "Custom theme editor with live preview",
                "Plugin API v2 with sandboxed execution environment",
                "Improved keyboard shortcut customization panel",
            ]),
    ];
}
