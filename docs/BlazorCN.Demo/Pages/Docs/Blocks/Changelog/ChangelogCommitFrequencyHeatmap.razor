@* ============================================================
   Block: changelog-commit-frequency-heatmap
   Title: ChangelogCommitFrequencyHeatmap
   Description: A GitHub-style contribution heatmap showing commit frequency by day, built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-commit-frequency-heatmap.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="git-commit" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Commit Activity</h2>
            </div>
            <span class="text-xs text-muted-foreground">January 2026</span>
        </div>

        @* Stats *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-6">
                <div>
                    <p class="text-xs text-muted-foreground">Total Commits</p>
                    <p class="text-2xl font-semibold tabular-nums">@_totalCommits</p>
                </div>
                <div>
                    <p class="text-xs text-muted-foreground">Daily Average</p>
                    <p class="flex items-center gap-1 text-2xl font-semibold tabular-nums">
                        @_avgCommits
                        <LucideIconCn Name="trending-up" Size="16" Class="size-4 text-emerald-500" />
                    </p>
                </div>
            </div>
        </div>

        @* Heatmap *@
        <div class="px-4 py-4">
            <div class="space-y-2">

                @* Day labels row — empty size-3 marker for each Monday *@
                <div class="flex items-center gap-1">
                    <div class="w-8 text-xs text-muted-foreground">Mon</div>
                    <div class="flex flex-wrap gap-1">
                        @foreach (var day in _sampleData)
                        {
                            var dow = DateTime.Parse(day.Date).DayOfWeek;
                            if (dow == DayOfWeek.Monday)
                            {
                                <div class="size-3"></div>
                            }
                        }
                    </div>
                </div>

                @* Heatmap grid *@
                <div class="flex gap-1">
                    <div class="flex flex-col gap-1">
                        <div class="h-3 text-xs text-muted-foreground">Sun</div>
                        <div class="h-3"></div>
                        <div class="h-3 text-xs text-muted-foreground">Tue</div>
                        <div class="h-3"></div>
                        <div class="h-3 text-xs text-muted-foreground">Thu</div>
                        <div class="h-3"></div>
                        <div class="h-3 text-xs text-muted-foreground">Sat</div>
                    </div>
                    <div class="flex flex-wrap gap-1" style="max-width: calc(7 * 14px)">
                        @foreach (var day in _sampleData)
                        {
                            <div
                                class="@Cn.Merge("size-3 rounded-sm transition-colors hover:ring-2 hover:ring-foreground/20", GetIntensity(day.Commits))"
                                title="@($"{day.Date}: {day.Commits} commits")">
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>

        @* Legend *@
        <div class="flex items-center justify-between px-4 py-3">
            <span class="text-xs text-muted-foreground">Less</span>
            <div class="flex items-center gap-1">
                <div class="size-3 rounded-sm bg-muted/50"></div>
                <div class="size-3 rounded-sm bg-emerald-500/10"></div>
                <div class="size-3 rounded-sm bg-emerald-500/30"></div>
                <div class="size-3 rounded-sm bg-emerald-500/60"></div>
                <div class="size-3 rounded-sm bg-emerald-500"></div>
            </div>
            <span class="text-xs text-muted-foreground">More</span>
        </div>

    </div>
</section>

@code {
    private record DayData(string Date, int Commits);

    private static string GetIntensity(int commits) => commits switch
    {
        0    => "bg-muted/50",
        <= 3 => "bg-emerald-500/10",
        <= 6 => "bg-emerald-500/30",
        <= 9 => "bg-emerald-500/60",
        _    => "bg-emerald-500",
    };

    private static readonly DayData[] _sampleData =
    [
        // Week 1
        new("2026-01-01", 3),
        new("2026-01-02", 5),
        new("2026-01-03", 2),
        new("2026-01-04", 0),
        new("2026-01-05", 1),
        new("2026-01-06", 8),
        new("2026-01-07", 12),
        // Week 2
        new("2026-01-08", 4),
        new("2026-01-09", 6),
        new("2026-01-10", 3),
        new("2026-01-11", 0),
        new("2026-01-12", 2),
        new("2026-01-13", 15),
        new("2026-01-14", 9),
        // Week 3
        new("2026-01-15", 7),
        new("2026-01-16", 11),
        new("2026-01-17", 5),
        new("2026-01-18", 1),
        new("2026-01-19", 0),
        new("2026-01-20", 13),
        new("2026-01-21", 8),
        // Week 4
        new("2026-01-22", 6),
        new("2026-01-23", 9),
        new("2026-01-24", 4),
        new("2026-01-25", 2),
        new("2026-01-26", 0),
        new("2026-01-27", 10),
        new("2026-01-28", 14),
        // Week 5
        new("2026-01-29", 5),
        new("2026-01-30", 8),
        new("2026-01-31", 3),
        new("2026-02-01", 1),
        new("2026-02-02", 0),
        new("2026-02-03", 11),
        new("2026-02-04", 7),
    ];

    private static int _totalCommits => _sampleData.Sum(d => d.Commits);
    private static string _avgCommits => (_sampleData.Sum(d => d.Commits) / (double)_sampleData.Length).ToString("F1");
}
