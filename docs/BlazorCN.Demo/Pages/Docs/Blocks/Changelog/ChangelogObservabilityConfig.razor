@* ============================================================
   Block: changelog-observability-config
   Title: ChangelogObservabilityConfig
   Description: A changelog tracking observability configuration changes including logging, tracing, and metrics endpoints, built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-observability-config.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Observability Configuration</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Configuration changes for logging, tracing, and metrics
            </p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-4 gap-3">
                <div>
                    <p class="text-xs text-muted-foreground">Logging</p>
                    <p class="mt-1 font-semibold tabular-nums text-xl text-blue-500">
                        @_configChanges.Count(c => c.Type == "logging")
                    </p>
                </div>
                <div>
                    <p class="text-xs text-muted-foreground">Tracing</p>
                    <p class="mt-1 font-semibold tabular-nums text-xl text-purple-500">
                        @_configChanges.Count(c => c.Type == "tracing")
                    </p>
                </div>
                <div>
                    <p class="text-xs text-muted-foreground">Metrics</p>
                    <p class="mt-1 font-semibold tabular-nums text-xl text-emerald-500">
                        @_configChanges.Count(c => c.Type == "metrics")
                    </p>
                </div>
                <div>
                    <p class="text-xs text-muted-foreground">Instrumentation</p>
                    <p class="mt-1 font-semibold tabular-nums text-xl text-amber-500">
                        @_configChanges.Count(c => c.Type == "instrumentation")
                    </p>
                </div>
            </div>
        </div>

        <div>
            @foreach (var change in _configChanges)
            {
                var item = change;
                var isExpanded = _expandedChange == item.Id;
                var chevronClass = Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
                <div class="border-b last:border-b-0">
                    <button
                        type="button"
                        @onclick="@(() => ToggleExpanded(item.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex items-center gap-2">
                            @GetConfigIcon(item.Type)
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@item.Title</span>
                                @GetTypeBadge(item.Type)
                            </div>
                            <div class="mt-1 flex items-center gap-2 text-xs text-muted-foreground">
                                <span>@item.Timestamp</span>
                                <span class="text-muted-foreground/40">•</span>
                                <span>by @item.Author</span>
                                <span class="text-muted-foreground/40">•</span>
                                <span>@item.Changes.Length changes</span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/30 px-4 py-3">
                            <p class="mb-3 text-sm">@item.Impact</p>
                            <div class="space-y-2">
                                @foreach (var configItem in item.Changes)
                                {
                                    var ci = configItem;
                                    <div class="rounded-md bg-card p-3">
                                        <div class="mb-2 font-mono text-xs font-medium text-muted-foreground">
                                            @ci.Key
                                        </div>
                                        <div class="grid grid-cols-2 gap-2 text-xs">
                                            <div>
                                                <span class="mb-1 block text-muted-foreground">Before</span>
                                                <code class="block rounded bg-muted/50 p-2 font-mono">
                                                    @ci.Before
                                                </code>
                                            </div>
                                            <div>
                                                <span class="mb-1 block text-muted-foreground">After</span>
                                                <code class="block rounded bg-emerald-500/10 p-2 font-mono text-emerald-500">
                                                    @ci.After
                                                </code>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="mt-3 flex items-center justify-end gap-2">
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs" OnClick="@(() => CopyConfig(item))">
                                    @if (_copiedId == item.Id)
                                    {
                                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                                        <span>Copied</span>
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                                        <span>Copy Config</span>
                                    }
                                </ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <p class="text-xs text-muted-foreground">Last change: 5 hours ago</p>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    View All Config
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record ConfigChangeItem(string Key, string Before, string After);

    private record ConfigChange(
        string Id,
        string Type,
        string Title,
        string Timestamp,
        string Author,
        ConfigChangeItem[] Changes,
        string Impact
    );

    private string? _expandedChange;
    private string? _copiedId;

    private void ToggleExpanded(string id)
    {
        _expandedChange = _expandedChange == id ? null : id;
    }

    private void CopyConfig(ConfigChange change)
    {
        // In a real app, clipboard would be written via JS interop.
        // Here we just toggle the copied indicator.
        _copiedId = change.Id;
    }

    private RenderFragment GetConfigIcon(string type) => type switch
    {
        "logging"         => @<LucideIconCn Name="terminal" Size="16" Class="size-4 text-blue-500" />,
        "tracing"         => @<LucideIconCn Name="activity" Size="16" Class="size-4 text-purple-500" />,
        "metrics"         => @<LucideIconCn Name="database" Size="16" Class="size-4 text-emerald-500" />,
        "instrumentation" => @<LucideIconCn Name="radio" Size="16" Class="size-4 text-amber-500" />,
        _                 => @<LucideIconCn Name="terminal" Size="16" Class="size-4 text-muted-foreground" />,
    };

    private RenderFragment GetTypeBadge(string type)
    {
        var cls = type switch
        {
            "logging"         => "bg-blue-500/10 text-blue-500",
            "tracing"         => "bg-purple-500/10 text-purple-500",
            "metrics"         => "bg-emerald-500/10 text-emerald-500",
            "instrumentation" => "bg-amber-500/10 text-amber-500",
            _                 => "",
        };
        return @<BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("border-0", cls)">@type</BadgeCn>;
    }

    private static readonly ConfigChange[] _configChanges =
    [
        new("c1", "logging", "Increased log retention for payment service", "2026-03-30 09:15", "ops-team",
            [
                new("log_retention_days", "7", "30"),
                new("log_level", "INFO", "DEBUG"),
            ],
            "Enhanced debugging capability for transaction disputes, increased storage cost by ~$45/month"),
        new("c2", "tracing", "Enabled distributed tracing for checkout flow", "2026-03-29 14:30", "sarah.chen",
            [
                new("trace_sampling_rate", "0.01", "0.1"),
                new("trace_enabled_endpoints", "/api/*", "/api/*, /checkout/*"),
            ],
            "10x increase in trace collection for checkout funnel analysis, minimal performance overhead"),
        new("c3", "metrics", "Added custom business metrics endpoints", "2026-03-28 11:20", "mike.torres",
            [
                new("custom_metrics.revenue_tracking", "false", "true"),
                new("metrics_export_interval", "60s", "10s"),
            ],
            "Real-time revenue dashboards now available, increased metrics cardinality by 2500 series"),
        new("c4", "instrumentation", "Deployed OpenTelemetry auto-instrumentation", "2026-03-27 16:45", "alex.kumar",
            [
                new("otel_sdk_enabled", "false", "true"),
                new("auto_instrument_libraries", "[]", "[\"http\",\"database\",\"redis\"]"),
            ],
            "Automatic span creation for HTTP, DB, and cache operations across all services"),
        new("c5", "logging", "Structured logging format migration", "2026-03-26 10:00", "emma.park",
            [
                new("log_format", "text", "json"),
                new("log_fields.trace_id", "false", "true"),
                new("log_fields.user_id", "false", "true"),
            ],
            "Improved log parsing and correlation, breaking change for legacy log consumers"),
    ];
}
