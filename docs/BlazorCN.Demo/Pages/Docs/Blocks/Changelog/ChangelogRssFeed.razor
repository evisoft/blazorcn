@* ============================================================
   Block: changelog-rss-feed
   Title: ChangelogRssFeed
   Description: An RSS feed-style changelog block built with React, Next.js, shadcn/ui, and Tailwind CSS featuring subscribe toggle, category badges, and publication timestamps
   Source: original/blocks/changelog/changelog-rss-feed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="rss" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Changelog Feed</h2>
            <div class="ml-auto flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs" OnClick="CopyFeedUrl">
                    @if (_copied)
                    {
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                        @("Copied")
                    }
                    else
                    {
                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                        @("RSS")
                    }
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <InputCn Placeholder="@("you@company.com")" Class="h-7 flex-1 border-0 bg-transparent px-0 text-xs shadow-none focus-visible:ring-0" Disabled="@_subscribed" />
            <div class="flex items-center gap-2">
                <span class="text-xs text-muted-foreground">@(_subscribed ? "Subscribed" : "Subscribe")</span>
                <SwitchCn @bind-Value="_subscribed" Class="scale-75" />
            </div>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2">
            @foreach (var cat in _categories)
            {
                var category = cat;
                var count = Array.FindAll(_entries, e => e.Category == category).Length;
                <div class="flex items-center gap-1.5">
                    <span class="@Cn.Merge("rounded-md px-1.5 py-0.5 text-[10px] font-medium capitalize", GetCategoryStyle(category))">@category</span>
                    <span class="text-[10px] text-muted-foreground tabular-nums">@count</span>
                </div>
            }
            <span class="ml-auto text-[10px] text-muted-foreground tabular-nums">@_entries.Length entries</span>
        </div>

        <div>
            @for (int i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                var isLast = i == _entries.Length - 1;
                <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex items-start gap-2">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("shrink-0 rounded-md px-1.5 py-0.5 text-[10px] font-medium capitalize", GetCategoryStyle(entry.Category))">@entry.Category</span>
                                <span class="text-xs text-muted-foreground">@entry.Date</span>
                            </div>
                            <h3 class="mt-1.5 text-sm font-medium leading-snug">@entry.Title</h3>
                            <p class="mt-1 text-xs text-muted-foreground leading-relaxed line-clamp-2">@entry.Excerpt</p>
                            <div class="mt-2 flex items-center gap-2">
                                <span class="text-[10px] text-muted-foreground">@entry.ReadTime</span>
                                <span class="text-[10px] text-muted-foreground/50">&middot;</span>
                                <span class="font-mono text-[10px] text-muted-foreground">@entry.Slug</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="flex items-center justify-between border-t bg-muted/30 px-4 py-2.5">
            <span class="font-mono text-[10px] text-muted-foreground">@_feedUrl</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px]">Atom 2.0</BadgeCn>
        </div>

    </div>
</section>

@code {
    private record FeedEntry(string Id, string Title, string Excerpt, string Category, string Date, string ReadTime, string Slug);

    private bool _subscribed = false;
    private bool _copied = false;
    private const string _feedUrl = "https://acme.com/changelog/feed.xml";

    private static readonly string[] _categories = ["feature", "improvement", "fix", "breaking"];

    private static readonly FeedEntry[] _entries =
    [
        new("e1", "Real-time collaboration is now generally available",
            "After three months in beta, real-time collaboration is stable and ready for production. Multiple users can now edit documents simultaneously with cursor presence and conflict-free merging.",
            "feature", "Mar 28, 2026", "3 min read", "real-time-collaboration-ga"),
        new("e2", "Dashboard load time reduced by 62%",
            "We rewrote the dashboard data fetching layer using streaming server components and selective hydration. P95 load time dropped from 3.2s to 1.2s across all plan tiers.",
            "improvement", "Mar 25, 2026", "2 min read", "dashboard-performance"),
        new("e3", "Fixed CSV export truncating rows over 10,000",
            "Large dataset exports were silently truncating after 10,000 rows due to a buffer limit in the streaming serializer. Exports now handle datasets up to 1M rows reliably.",
            "fix", "Mar 22, 2026", "1 min read", "csv-export-fix"),
        new("e4", "API v1 authentication endpoints deprecated",
            "All /api/v1/auth/* endpoints are now deprecated and will be removed on June 1, 2026. Migrate to /api/v2/auth/* which supports OAuth 2.1 and PKCE flows.",
            "breaking", "Mar 18, 2026", "4 min read", "api-v1-deprecation"),
        new("e5", "New Webhook retry configuration options",
            "Webhook deliveries now support configurable retry policies including max attempts, backoff multiplier, and timeout thresholds. Set these per-endpoint in your dashboard.",
            "feature", "Mar 14, 2026", "2 min read", "webhook-retry-config"),
        new("e6", "Improved search relevance with hybrid scoring",
            "Search results now combine BM25 text matching with vector similarity for better relevance. Queries return more accurate results especially for technical terminology.",
            "improvement", "Mar 10, 2026", "3 min read", "hybrid-search-scoring"),
    ];

    private static string GetCategoryStyle(string category) => category switch
    {
        "feature"     => "bg-emerald-500/10 text-emerald-600",
        "improvement" => "bg-blue-500/10 text-blue-600",
        "fix"         => "bg-amber-500/10 text-amber-600",
        "breaking"    => "bg-red-500/10 text-red-600",
        _             => ""
    };

    private async Task CopyFeedUrl()
    {
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }
}
