@* ============================================================
   Block: changelog-minimal
   Title: ChangelogMinimal
   Description: React minimal changelog block for Next.js with clean list entries, version labels, and subtle date stamps built with TypeScript, Framer Motion staggered animations, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-minimal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="list" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Changelog</span>
        </div>

        @* Entries *@
        <div>
            @foreach (var entry in _entries)
            {
                var isLast = entry == _entries[_entries.Length - 1];
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-baseline gap-3 px-4 py-2.5">
                        <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">v@(entry.Version)</span>
                        <span class="shrink-0 text-muted-foreground/60 text-xs">@entry.Date</span>
                        <span class="min-w-0 text-sm">@entry.Description</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ChangelogEntry(string Version, string Date, string Description);

    private static readonly ChangelogEntry[] _entries =
    [
        new("2.4.0", "Mar 28", "Added team workspace collaboration with live cursors"),
        new("2.3.3", "Mar 26", "Fixed OAuth redirect loop on SAML identity providers"),
        new("2.3.2", "Mar 24", "Improved build pipeline speed by 40% with incremental compilation"),
        new("2.3.1", "Mar 22", "Fixed CSV export encoding for non-ASCII characters"),
        new("2.3.0", "Mar 20", "Added API key scoping with read, write, and admin permissions"),
        new("2.2.5", "Mar 18", "Fixed sidebar collapse state not persisting after refresh"),
        new("2.2.4", "Mar 16", "Improved search indexing latency from 8s to under 2s"),
        new("2.2.3", "Mar 14", "Added webhook delivery logs with retry and filter controls"),
        new("2.2.2", "Mar 12", "Fixed timezone offset for UTC-negative regions in scheduling"),
        new("2.2.1", "Mar 10", "Improved edge function cold start from 120ms to 45ms"),
    ];
}
