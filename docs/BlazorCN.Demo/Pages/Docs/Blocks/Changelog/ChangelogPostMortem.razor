@* ============================================================
   Block: changelog-post-mortem
   Title: ChangelogPostMortem
   Description: An incident post-mortem summary with timeline, root cause analysis, impact metrics, and action items built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-post-mortem.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground" />
                    <h2 class="text-sm font-medium">Incident Post-Mortem</h2>
                </div>
                <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 border-red-500/20 bg-red-500/10 text-red-500 text-xs">
                    <LucideIconCn Name="alert-triangle" Size="12" Class="size-3" />
                    High Severity
                </BadgeCn>
            </div>
            <div class="mt-2 flex items-center gap-3 text-xs text-muted-foreground">
                <span>INC-2024-0847</span>
                <span>·</span>
                <span>January 18, 2026</span>
                <span>·</span>
                <span>Duration: 22 minutes</span>
            </div>
        </div>

        @* Summary *@
        <div class="border-b px-4 py-3">
            <h3 class="mb-2 text-sm font-medium">Summary</h3>
            <p class="text-sm text-muted-foreground">
                Database connection pool exhaustion caused elevated error rates across all API
                endpoints. Approximately 12% of requests failed during peak traffic period. Issue
                resolved by increasing pool size and restarting affected services.
            </p>
        </div>

        @* Impact Metrics *@
        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                    <p class="text-xs text-muted-foreground">Users Affected</p>
                </div>
                <p class="mt-1 font-semibold tabular-nums text-2xl text-red-500">~8,400</p>
            </div>
            <div class="border-r px-4 py-3">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="alert-triangle" Size="12" Class="size-3 text-muted-foreground" />
                    <p class="text-xs text-muted-foreground">Error Rate</p>
                </div>
                <p class="mt-1 font-semibold tabular-nums text-2xl text-red-500">12.3%</p>
            </div>
            <div class="px-4 py-3">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                    <p class="text-xs text-muted-foreground">Downtime</p>
                </div>
                <p class="mt-1 font-semibold tabular-nums text-2xl">22m</p>
            </div>
        </div>

        @* Timeline *@
        <div class="border-b px-4 py-3">
            <h3 class="mb-3 text-sm font-medium">Timeline</h3>
            <div class="space-y-3">
                @for (var idx = 0; idx < _timelineEvents.Length; idx++)
                {
                    var evt = _timelineEvents[idx];
                    var isLast = idx == _timelineEvents.Length - 1;
                    <div class="flex gap-3">
                        <div class="flex flex-col items-center">
                            <div class="@Cn.Merge("flex size-6 shrink-0 items-center justify-center rounded-full", TimelineDotBg(evt.Type))">
                                @if (evt.Type == "resolution")
                                {
                                    <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-500" />
                                }
                                else
                                {
                                    <LucideIconCn Name="circle" Size="8" Class="@Cn.Merge("size-2", TimelineCircleColor(evt.Type))" />
                                }
                            </div>
                            @if (!isLast)
                            {
                                <div class="my-1 h-full w-px bg-border" />
                            }
                        </div>
                        <div class="flex-1 pb-3">
                            <p class="font-mono text-muted-foreground text-xs">@evt.Time</p>
                            <p class="mt-0.5 text-sm">@evt.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Root Cause *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center gap-2">
                <LucideIconCn Name="target" Size="16" Class="size-4 text-muted-foreground" />
                <h3 class="text-sm font-medium">Root Cause</h3>
            </div>
            <div class="space-y-2">
                <p class="text-sm text-muted-foreground">
                    Database connection pool was configured with a maximum of 20 connections. During peak
                    traffic, the number of concurrent requests exceeded this limit, causing connection
                    timeouts and cascading failures.
                </p>
                <div class="rounded-md bg-muted/50 p-3">
                    <p class="mb-1 text-xs font-medium text-muted-foreground">Configuration Issue</p>
                    <code class="block font-mono text-xs">
                        DB_POOL_MAX_CONNECTIONS=20 (should be 50+)
                    </code>
                </div>
            </div>
        </div>

        @* Action Items *@
        <div class="px-4 py-3">
            <h3 class="mb-3 text-sm font-medium">Action Items</h3>
            <div class="space-y-2">
                @foreach (var ai in _actionItems)
                {
                    var item = ai;
                    <div class="flex items-start gap-3 rounded-md bg-muted/30 px-3 py-2">
                        <div class="@Cn.Merge("mt-0.5 size-4 shrink-0 rounded-full border-2", ActionStatusClasses(item.Status))">
                            @if (item.Status == "completed")
                            {
                                <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 -translate-x-px -translate-y-px text-white" />
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm">@item.Title</span>
                                @if (item.Priority == "high")
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="border-red-500/20 bg-red-500/10 text-red-500 text-xs">
                                        High
                                    </BadgeCn>
                                }
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                                <span>@item.Owner</span>
                                <span>·</span>
                                <span class="capitalize">@item.Status.Replace("-", " ")</span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-3 flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Export Report
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Share with Team
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record TimelineEvent(string Time, string Description, string Type);
    private record ActionItem(string Id, string Title, string Owner, string Status, string Priority);

    private static readonly TimelineEvent[] _timelineEvents =
    [
        new("14:23 UTC", "Increased error rate detected in monitoring dashboard", "detection"),
        new("14:26 UTC", "Incident escalated to on-call engineer", "escalation"),
        new("14:31 UTC", "Database connection pool exhaustion identified as root cause", "mitigation"),
        new("14:38 UTC", "Connection pool size increased, services restarted", "mitigation"),
        new("14:45 UTC", "Error rates returned to normal, incident resolved", "resolution"),
    ];

    private static readonly ActionItem[] _actionItems =
    [
        new("1", "Implement connection pool monitoring alerts", "DevOps Team", "completed", "high"),
        new("2", "Review and optimize database query patterns", "Backend Team", "in-progress", "high"),
        new("3", "Add circuit breaker pattern to database clients", "Backend Team", "open", "medium"),
        new("4", "Document connection pool configuration best practices", "Platform Team", "open", "low"),
    ];

    private static string TimelineDotBg(string type) => type switch
    {
        "detection"  => "bg-amber-500/10",
        "escalation" => "bg-blue-500/10",
        "mitigation" => "bg-purple-500/10",
        "resolution" => "bg-emerald-500/10",
        _            => "",
    };

    private static string TimelineCircleColor(string type) => type switch
    {
        "detection"  => "text-amber-500",
        "escalation" => "text-blue-500",
        "mitigation" => "text-purple-500",
        _            => "",
    };

    private static string ActionStatusClasses(string status) => status switch
    {
        "completed"   => "border-emerald-500 bg-emerald-500",
        "in-progress" => "border-blue-500 bg-blue-500/20",
        "open"        => "border-muted-foreground",
        _             => "",
    };
}
