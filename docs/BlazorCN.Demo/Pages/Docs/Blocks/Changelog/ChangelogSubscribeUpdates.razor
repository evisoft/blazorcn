@* ============================================================
   Block: changelog-subscribe-updates
   Title: ChangelogSubscribeUpdates
   Description: React changelog with email subscription block for Next.js with recent changes, inline subscribe form, and success state animation built with TypeScript, shadcn/ui Input and Button, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-subscribe-updates.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">Product Updates</span>
        </div>

        @* Subscribe section *@
        <div class="border-b px-4 py-4">
            @if (_subscribed)
            {
                <div class="flex items-center gap-2">
                    <div class="flex size-5 items-center justify-center rounded-full bg-emerald-500/10">
                        <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                    </div>
                    <span class="text-sm">Subscribed. You&#39;ll get notified of new updates.</span>
                </div>
            }
            else
            {
                <div>
                    <p class="mb-3 text-sm text-muted-foreground">
                        Get notified when we ship new features and fixes.
                    </p>
                    <div class="flex gap-2">
                        <div class="relative flex-1">
                            <LucideIconCn Name="mail" Size="14" Class="-translate-y-1/2 absolute top-1/2 left-2.5 size-3.5 text-muted-foreground" />
                            <InputCn Type="email"
                                     Placeholder="@("you@example.com")"
                                     @bind-Value="_email"
                                     Class="h-8 pl-8 text-xs"
                                     aria-label="Email address" />
                        </div>
                        <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs" @onclick="HandleSubmit">
                            Subscribe
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

        @* Recent changes *@
        <div>
            @for (var idx = 0; idx < _recentChanges.Length; idx++)
            {
                var change = _recentChanges[idx];
                var rowClass = idx < _recentChanges.Length - 1 ? "border-b" : "";
                <div class="@rowClass">
                    <div class="flex items-center gap-3 px-4 py-2.5">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", DotColor(change.Category))"
                              aria-hidden="true"></span>
                        <span class="min-w-0 flex-1 text-sm">@change.Title</span>
                        <span class="shrink-0 text-xs text-muted-foreground/60">@change.Date</span>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private bool _subscribed = false;
    private string _email = "";

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_email))
        {
            _subscribed = true;
        }
    }

    private static string DotColor(string category) => category switch
    {
        "feature" => "bg-emerald-500",
        "fix" => "bg-red-500",
        "improvement" => "bg-blue-500",
        _ => ""
    };

    private record Change(string Title, string Date, string Category);

    private static readonly Change[] _recentChanges =
    [
        new("Team workspace collaboration with real-time cursors", "Mar 28", "feature"),
        new("Dashboard streaming SSR for 40% faster loads", "Mar 27", "improvement"),
        new("OAuth redirect loop on SAML identity providers", "Mar 26", "fix"),
        new("API key scoping with read, write, and admin permissions", "Mar 24", "feature"),
        new("Search indexing latency reduced from 8s to 2s", "Mar 23", "improvement"),
    ];
}
