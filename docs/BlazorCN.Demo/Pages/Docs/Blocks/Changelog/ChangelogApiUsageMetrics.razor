@* ============================================================
   Block: changelog-api-usage-metrics
   Title: ChangelogApiUsageMetrics
   Description: An API endpoint usage tracker with request counts, latency percentiles, error rates, and rate limit monitoring built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-api-usage-metrics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="activity" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">API Usage Metrics</h2>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">Last 24 hours · Updated 1 minute ago</p>
        </div>

        @* Summary Stats *@
        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="zap" Size="12" Class="size-3 text-muted-foreground" />
                    <p class="text-xs text-muted-foreground">Total Requests</p>
                </div>
                <p class="mt-1 font-semibold tabular-nums text-2xl">@TotalRequests.ToString("N0")</p>
            </div>
            <div class="border-r px-4 py-3">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="activity" Size="12" Class="size-3 text-muted-foreground" />
                    <p class="text-xs text-muted-foreground">Avg Latency</p>
                </div>
                <p class="mt-1 font-semibold tabular-nums text-2xl">@((int)Math.Round(AvgLatency))ms</p>
            </div>
            <div class="px-4 py-3">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="alert-circle" Size="12" Class="size-3 text-muted-foreground" />
                    <p class="text-xs text-muted-foreground">Avg Error Rate</p>
                </div>
                <p class="mt-1 font-semibold tabular-nums text-2xl">@(AvgErrorRate.ToString("F2"))%</p>
            </div>
        </div>

        @* Endpoints List *@
        <div>
            @foreach (var ep in _endpoints)
            {
                var endpoint = ep;
                var isExpanded = _expandedEndpoint == endpoint.Id;
                var methodBadgeClass = Cn.Merge("shrink-0 font-mono text-white text-xs border-transparent", GetMethodColor(endpoint.Method));
                var chevronClass = Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        @onclick="@(() => ToggleEndpoint(endpoint.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <BadgeCn Variant="BadgeVariant.Outline" Class="@methodBadgeClass">@endpoint.Method</BadgeCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <code class="truncate font-mono text-xs">@endpoint.Path</code>
                                @if (endpoint.ErrorRate > 1)
                                {
                                    <LucideIconCn Name="alert-circle" Size="12" Class="size-3 text-amber-500" />
                                }
                            </div>
                            <div class="mt-0.5 flex items-center gap-3 text-xs text-muted-foreground">
                                <span class="tabular-nums">@endpoint.RequestCount.ToString("N0") requests</span>
                                <span>·</span>
                                <span class="tabular-nums">@(endpoint.AvgLatency)ms avg</span>
                                <span>·</span>
                                <span class="@Cn.Merge("tabular-nums", endpoint.ErrorRate > 1 ? "text-amber-500" : "")">@(endpoint.ErrorRate)% errors</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            @if (endpoint.Trend == "up")
                            {
                                <LucideIconCn Name="arrow-up" Size="12" Class="size-3 text-emerald-500" />
                            }
                            @if (endpoint.Trend == "down")
                            {
                                <LucideIconCn Name="arrow-down" Size="12" Class="size-3 text-red-500" />
                            }
                            <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/30">
                            <div class="space-y-3 px-4 py-3">
                                <div>
                                    <p class="mb-2 text-xs font-medium text-muted-foreground">Status Code Breakdown</p>
                                    <div class="grid grid-cols-3 gap-2">
                                        <div class="rounded-md bg-emerald-500/10 p-2">
                                            <p class="text-xs text-muted-foreground">2xx Success</p>
                                            <p class="mt-0.5 font-semibold tabular-nums text-emerald-500 text-sm">@endpoint.Status2xx.ToString("N0")</p>
                                        </div>
                                        <div class="rounded-md bg-amber-500/10 p-2">
                                            <p class="text-xs text-muted-foreground">4xx Client</p>
                                            <p class="mt-0.5 font-semibold tabular-nums text-amber-500 text-sm">@endpoint.Status4xx.ToString("N0")</p>
                                        </div>
                                        <div class="rounded-md bg-red-500/10 p-2">
                                            <p class="text-xs text-muted-foreground">5xx Server</p>
                                            <p class="mt-0.5 font-semibold tabular-nums text-red-500 text-sm">@endpoint.Status5xx.ToString("N0")</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Endpoint(
        string Id,
        string Method,
        string Path,
        int RequestCount,
        int AvgLatency,
        double ErrorRate,
        string Trend,
        int Status2xx,
        int Status4xx,
        int Status5xx
    );

    private string? _expandedEndpoint;

    private void ToggleEndpoint(string id)
    {
        _expandedEndpoint = _expandedEndpoint == id ? null : id;
    }

    private static string GetMethodColor(string method) => method switch
    {
        "GET"    => "bg-blue-500",
        "POST"   => "bg-emerald-500",
        "PUT"    => "bg-amber-500",
        "DELETE" => "bg-red-500",
        "PATCH"  => "bg-purple-500",
        _        => "bg-gray-500",
    };

    private int TotalRequests => _endpoints.Sum(e => e.RequestCount);
    private double AvgLatency => _endpoints.Average(e => e.AvgLatency);
    private double AvgErrorRate => _endpoints.Average(e => e.ErrorRate);

    private static readonly Endpoint[] _endpoints =
    [
        new("get-users",     "GET",  "/api/v1/users",       45782, 142, 0.12, "down",    45727,  43, 12),
        new("post-auth",     "POST", "/api/v1/auth/login",  12453, 267, 2.34, "up",      12162, 278, 13),
        new("get-products",  "GET",  "/api/v1/products",    38219,  98, 0.05, "neutral", 38200,  18,  1),
        new("post-orders",   "POST", "/api/v1/orders",       8967, 432, 1.87, "down",     8799, 156, 12),
        new("get-analytics", "GET",  "/api/v1/analytics",   23456, 523, 0.89, "up",      23247, 198, 11),
    ];
}
