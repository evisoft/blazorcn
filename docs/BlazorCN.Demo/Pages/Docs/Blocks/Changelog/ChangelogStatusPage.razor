@* ============================================================
   Block: changelog-status-page
   Title: ChangelogStatusPage
   Description: React status page changelog block for Next.js with operational status indicator, system health dot, and recent changes list built with TypeScript, shadcn/ui Badge, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-status-page.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideIconCn Name="activity" Size="16" Class="size-4 text-muted-foreground" />
            <p class="text-sm font-medium">Status &amp; Changelog</p>
        </div>

        <div class="flex items-center gap-3 border-b px-4 py-3">
            <span class="@(_status.Operational ? "size-2 shrink-0 rounded-full bg-emerald-500 animate-pulse" : "size-2 shrink-0 rounded-full bg-amber-500 animate-pulse")"></span>
            <p class="@(_status.Operational ? "text-sm font-medium text-emerald-600 dark:text-emerald-400" : "text-sm font-medium text-amber-600 dark:text-amber-400")">
                @_status.Label
            </p>
        </div>

        <div class="border-b px-4 py-2">
            <p class="text-xs font-medium text-muted-foreground uppercase tracking-wider">
                Recent changes
            </p>
        </div>

        @foreach (var entry in _entries)
        {
            var e = entry;
            var isLast = e == _entries[_entries.Length - 1];
            var rowClass = isLast ? "flex items-start gap-3 px-4 py-3" : "flex items-start gap-3 px-4 py-3 border-b";
            <div class="@rowClass">
                <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-muted-foreground/40"></span>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <p class="text-sm font-medium">@e.Title</p>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@GetBadgeStyle(e.Category)">
                            @e.Category
                        </BadgeCn>
                    </div>
                    <p class="mt-0.5 text-xs text-muted-foreground">@e.Description</p>
                    <p class="mt-1 font-mono text-xs text-muted-foreground/60">
                        @e.Date &middot; @e.Time
                    </p>
                </div>
            </div>
        }

    </div>
</section>

@code {
    private record Entry(string Title, string Description, string Date, string Time, string Category);
    private record StatusInfo(bool Operational, string Label);

    private static readonly StatusInfo _status = new(true, "All Systems Operational");

    private static readonly Entry[] _entries =
    [
        new("API v2.4.1 deployed",          "Rolled out rate limit improvements and new /webhooks endpoint.",                                    "Mar 28", "14:32 UTC", "deploy"),
        new("Dashboard latency resolved",   "Fixed slow query on the analytics dashboard that caused 5s+ load times.",                          "Mar 27", "09:15 UTC", "fix"),
        new("Database maintenance window",  "Completed PostgreSQL vacuum and index rebuild. No downtime recorded.",                              "Mar 26", "03:00 UTC", "maintenance"),
        new("Webhook delivery delays",      "Investigated and resolved queue backlog causing 2-minute delivery delays.",                         "Mar 25", "16:48 UTC", "incident"),
        new("Auth service v3.1.0 deployed", "Added PKCE support for OAuth flows and improved token refresh reliability.",                        "Mar 24", "11:20 UTC", "deploy"),
    ];

    private static string GetBadgeStyle(string category) => category switch
    {
        "deploy"      => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-0",
        "fix"         => "bg-red-500/10 text-red-600 dark:text-red-400 border-0",
        "maintenance" => "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-0",
        "incident"    => "bg-amber-500/10 text-amber-600 dark:text-amber-400 border-0",
        _             => "",
    };
}
