@* ============================================================
   Block: changelog-notification-bell
   Title: ChangelogNotificationBell
   Description: React changelog block with notification preference toggles for Next.js, featuring email and push notification switches in the header with BellIcon built with TypeScript, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-notification-bell.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Changelog</h2>
            </div>
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="mail" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-xs text-muted-foreground">Email</span>
                    <SwitchCn @bind-Value="_emailNotif" Class="scale-75" aria-label="Toggle email notifications" />
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="smartphone" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-xs text-muted-foreground">Push</span>
                    <SwitchCn @bind-Value="_pushNotif" Class="scale-75" aria-label="Toggle push notifications" />
                </div>
            </div>
        </div>

        <div>
            @foreach (var entry in _entries)
            {
                <div class="border-b px-4 py-3 last:border-b-0">
                    <div class="flex items-center gap-2">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", _typeColors[entry.Type])"></span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-[10px]">
                            @entry.Version
                        </BadgeCn>
                        <span class="text-xs text-muted-foreground">@entry.Date</span>
                    </div>
                    <p class="mt-1 text-sm font-medium">@entry.Title</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@entry.Description</p>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private bool _emailNotif = true;
    private bool _pushNotif = false;

    private record ChangelogEntry(
        string Id,
        string Version,
        string Date,
        string Title,
        string Description,
        string Type
    );

    private static readonly Dictionary<string, string> _typeColors = new()
    {
        ["feature"] = "bg-blue-500",
        ["fix"] = "bg-red-500",
        ["improvement"] = "bg-amber-500",
    };

    private static readonly ChangelogEntry[] _entries =
    [
        new("v4-2-0", "4.2.0", "Mar 28, 2026", "Custom dashboard widgets",
            "Drag-and-drop widget builder for personalizing your dashboard layout.", "feature"),
        new("v4-1-3", "4.1.3", "Mar 26, 2026", "Fixed webhook retry logic",
            "Webhook retries now use exponential backoff instead of fixed intervals.", "fix"),
        new("v4-1-2", "4.1.2", "Mar 24, 2026", "Improved query editor autocomplete",
            "SQL autocomplete now suggests table names, columns, and common functions.", "improvement"),
        new("v4-1-1", "4.1.1", "Mar 22, 2026", "Fixed timezone offset in reports",
            "Report timestamps now correctly reflect the user's configured timezone.", "fix"),
        new("v4-1-0", "4.1.0", "Mar 20, 2026", "Audit log export",
            "Export audit logs as CSV or JSON with date range and event type filters.", "feature"),
        new("v4-0-5", "4.0.5", "Mar 18, 2026", "Reduced memory usage in workers",
            "Background workers now use 35% less memory through connection pooling.", "improvement"),
        new("v4-0-4", "4.0.4", "Mar 16, 2026", "Two-factor authentication backup codes",
            "Added one-time backup codes for account recovery when 2FA device is unavailable.", "feature"),
    ];
}
