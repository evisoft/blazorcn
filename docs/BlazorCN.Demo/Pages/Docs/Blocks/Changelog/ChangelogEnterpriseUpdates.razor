@* ============================================================
   Block: changelog-enterprise-updates
   Title: ChangelogEnterpriseUpdates
   Description: React enterprise changelog block for Next.js with SSO, SAML, audit log, and permission entries featuring enterprise badges built with TypeScript, Framer Motion staggered animations, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-enterprise-updates.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="building" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Enterprise Updates</h2>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto text-xs">Enterprise</BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs text-muted-foreground">
                Security, compliance, and administration features for enterprise plans.
            </p>
        </div>

        <div>
            @foreach (var entry in _entries)
            {
                <div class="flex gap-3 border-b px-4 py-3 last:border-b-0">
                    <div class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        <LucideIconCn Name="@entry.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@entry.Title</span>
                            <BadgeCn Variant="BadgeVariant.Outline" Class="shrink-0 px-1.5 py-0 text-[10px]">@entry.Category</BadgeCn>
                        </div>
                        <p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">
                            @entry.Description
                        </p>
                        <span class="mt-1 block text-[11px] text-muted-foreground/60">@entry.Date</span>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record EnterpriseEntry(
        string Title,
        string Description,
        string Date,
        string Category,
        string Icon
    );

    private static readonly EnterpriseEntry[] _entries =
    [
        new(
