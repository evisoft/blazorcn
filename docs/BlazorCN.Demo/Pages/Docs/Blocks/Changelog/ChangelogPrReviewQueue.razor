@* ============================================================
   Block: changelog-pr-review-queue
   Title: ChangelogPrReviewQueue
   Description: Track PR review status with reviewer assignments, approval counts, and age tracking. Built with React, Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-pr-review-queue.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Review Queue</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_filteredPRs.Length pull requests awaiting review
                    </p>
                </div>
                <LucideIconCn Name="git-pull-request" Size="16" Class="size-4 text-muted-foreground/60" />
            </div>
        </div>

        @* Filters *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between gap-3">
                <select
                    value="@_statusFilter"
                    @onchange="@(e => { _statusFilter = e.Value?.ToString() ?? "all"; })"
                    class="h-8 w-[160px] rounded-md border border-input bg-background px-2 text-xs focus:outline-none focus:ring-1 focus:ring-ring">
                    <option value="all">All PRs</option>
                    <option value="pending">Pending review</option>
                    <option value="approved">Approved</option>
                    <option value="changes-requested">Changes requested</option>
                    <option value="draft">Draft</option>
                    <option value="stale">Stale (&gt;7 days)</option>
                </select>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Auto-assign
                </ButtonCn>
            </div>
        </div>

        @* PR List *@
        <div class="divide-y">
            @foreach (var pr in _filteredPRs)
            {
                var isExpanded = _expandedId == pr.Id;
                var isStale = pr.AgeInDays >= 7;
                var prCapture = pr;

                var iconBgClass = Cn.Merge(
                    "flex size-8 shrink-0 items-center justify-center rounded-md",
                    pr.Status == "approved" ? "bg-emerald-500/10" : "",
                    pr.Status == "pending" ? "bg-blue-500/10" : "",
                    pr.Status == "changes-requested" ? "bg-amber-500/10" : "",
                    pr.Status == "draft" ? "bg-muted/50" : "");

                var iconColorClass = Cn.Merge(
                    "size-4",
                    pr.Status == "approved" ? "text-emerald-600" : "",
                    pr.Status == "pending" ? "text-blue-600" : "",
                    pr.Status == "changes-requested" ? "text-amber-600" : "",
                    pr.Status == "draft" ? "text-muted-foreground" : "");

                var chevronClass = Cn.Merge(
                    "size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200",
                    isExpanded ? "rotate-90" : "");

                <div>
                    <button
                        type="button"
                        @onclick="@(() => ToggleExpanded(prCapture.Id))"
                        class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">

                        <div class="@iconBgClass">
                            <LucideIconCn Name="git-pull-request" Size="16" Class="@iconColorClass" />
                        </div>

                        <div class="min-w-0 flex-1">
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@prCapture.Title</span>
                                        @if (isStale)
                                        {
                                            <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 border-amber-500/20 bg-amber-500/10 text-amber-600">
                                                <LucideIconCn Name="alert-circle" Size="12" Class="size-3" />
                                                Stale
                                            </BadgeCn>
                                        }
                                    </div>
                                    <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
                                        <span class="font-mono">#@prCapture.Number</span>
                                        <span>@prCapture.Author</span>
                                        <span class="flex items-center gap-1">
                                            <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                            @prCapture.Age
                                        </span>
                                        @if (prCapture.Comments > 0)
                                        {
                                            <span class="flex items-center gap-1">
                                                <LucideIconCn Name="message-square" Size="12" Class="size-3" />
                                                @prCapture.Comments
                                            </span>
                                        }
                                    </div>
                                    <div class="mt-2 flex items-center gap-3">
                                        <div class="flex items-center gap-1">
                                            @if (prCapture.Status == "approved")
                                            {
                                                <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-600" />
                                            }
                                            else if (prCapture.Status == "changes-requested")
                                            {
                                                <LucideIconCn Name="alert-circle" Size="14" Class="size-3.5 text-amber-600" />
                                            }
                                            else
                                            {
                                                <span class="size-1.5 rounded-full bg-blue-500" />
                                            }
                                            <span class="text-xs font-medium">
                                                @prCapture.Approvals.Current/@prCapture.Approvals.Required approvals
                                            </span>
                                        </div>
                                        @if (prCapture.Reviewers.Length > 0)
                                        {
                                            <div class="flex -space-x-1.5">
                                                @foreach (var reviewer in prCapture.Reviewers)
                                                {
                                                    <AvatarCn Class="size-5 border-2 border-background">
                                                        <AvatarFallbackCn Class="text-[10px]">
                                                            @reviewer.Initials
                                                        </AvatarFallbackCn>
                                                    </AvatarCn>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>

                                <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                            </div>
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/30 px-4 py-3">
                            <div class="space-y-3 pl-11">
                                <div>
                                    <p class="mb-2 text-xs font-medium text-muted-foreground">Branch</p>
                                    <p class="font-mono text-sm">@prCapture.Branch</p>
                                </div>

                                <div class="grid grid-cols-3 gap-4">
                                    <div>
                                        <p class="text-xs font-medium text-muted-foreground">Files</p>
                                        <p class="mt-1 text-sm font-medium tabular-nums">@prCapture.FilesChanged</p>
                                    </div>
                                    <div>
                                        <p class="text-xs font-medium text-muted-foreground">Additions</p>
                                        <p class="mt-1 text-sm font-medium tabular-nums text-emerald-600">
                                            +@prCapture.Additions
                                        </p>
                                    </div>
                                    <div>
                                        <p class="text-xs font-medium text-muted-foreground">Deletions</p>
                                        <p class="mt-1 text-sm font-medium tabular-nums text-red-600">
                                            -@prCapture.Deletions
                                        </p>
                                    </div>
                                </div>

                                @if (prCapture.Reviewers.Length > 0)
                                {
                                    <div>
                                        <p class="mb-2 text-xs font-medium text-muted-foreground">
                                            Reviewers
                                        </p>
                                        <div class="space-y-1.5">
                                            @foreach (var reviewer in prCapture.Reviewers)
                                            {
                                                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                                                    <div class="flex items-center gap-2">
                                                        <AvatarCn Class="size-5">
                                                            <AvatarFallbackCn Class="text-[10px]">
                                                                @reviewer.Initials
                                                            </AvatarFallbackCn>
                                                        </AvatarCn>
                                                        <span class="text-xs font-medium">@reviewer.Name</span>
                                                    </div>
                                                    @if (reviewer.Status == "approved")
                                                    {
                                                        <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-600" />
                                                    }
                                                    @if (reviewer.Status == "changes-requested")
                                                    {
                                                        <LucideIconCn Name="alert-circle" Size="14" Class="size-3.5 text-amber-600" />
                                                    }
                                                    @if (reviewer.Status == "pending")
                                                    {
                                                        <span class="size-1.5 rounded-full bg-blue-500" />
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                <div class="flex gap-2">
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                        View changes
                                    </ButtonCn>
                                    @if (prCapture.Status == "approved")
                                    {
                                        <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                                            Merge PR
                                        </ButtonCn>
                                    }
                                    @if (prCapture.Reviewers.Length == 0)
                                    {
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                                            <LucideIconCn Name="user" Size="12" Class="size-3" />
                                            Assign reviewers
                                        </ButtonCn>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ApprovalsInfo(int Current, int Required);

    private record ReviewerInfo(string Name, string Status, string Initials);

    private record PullRequestItem(
        string Id,
        int Number,
        string Title,
        string Author,
        string Branch,
        string Status,
        ApprovalsInfo Approvals,
        ReviewerInfo[] Reviewers,
        string Age,
        int AgeInDays,
        int Comments,
        int FilesChanged,
        int Additions,
        int Deletions
    );

    private string _statusFilter = "all";
    private string? _expandedId;

    private PullRequestItem[] _filteredPRs => _pullRequests.Where(pr =>
    {
        if (_statusFilter == "all") return true;
        if (_statusFilter == "stale") return pr.AgeInDays >= 7;
        return pr.Status == _statusFilter;
    }).ToArray();

    private void ToggleExpanded(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

