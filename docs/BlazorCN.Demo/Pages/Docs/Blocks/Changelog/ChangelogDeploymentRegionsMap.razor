@* ============================================================
   Block: changelog-deployment-regions-map
   Title: ChangelogDeploymentRegionsMap
   Description: A global deployment status map showing rollout progress across regions with live status indicators built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-deployment-regions-map.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="globe" Size="16" Class="size-4 text-muted-foreground" />
                    <h2 class="text-sm font-medium">Global Deployment Status</h2>
                </div>
                <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                    @DeployedCount/@_regions.Length regions
                </BadgeCn>
            </div>
        </div>

        <div class="border-b bg-muted/50 px-4 py-3">
            <div class="grid grid-cols-3 gap-4">
                <div class="flex flex-col gap-1">
                    <span class="text-xs text-muted-foreground">Deployed</span>
                    <span class="text-2xl font-semibold tabular-nums text-emerald-500">@DeployedCount</span>
                </div>
                <div class="flex flex-col gap-1">
                    <span class="text-xs text-muted-foreground">Deploying</span>
                    <span class="text-2xl font-semibold tabular-nums text-blue-500">@DeployingCount</span>
                </div>
                <div class="flex flex-col gap-1">
                    <span class="text-xs text-muted-foreground">Avg Latency</span>
                    <span class="text-2xl font-semibold tabular-nums">
                        @AvgLatency<span class="ml-1 text-sm text-muted-foreground">ms</span>
                    </span>
                </div>
            </div>
        </div>

        <div class="max-h-96 overflow-y-auto" tabindex="0" role="group" aria-label="Deployment regions">
            @foreach (var it in _regions)
            {
                var region = it;
                var isLast = region.Id == _regions[^1].Id;
                var iconName = GetStatusIconName(region.Status);
                var iconClass = Cn.Merge("size-4 shrink-0", GetStatusIconColor(region.Status), region.Status == "deploying" ? "animate-spin" : "");
                var borderClass = isLast ? "" : "border-b";
                <div class="@borderClass">
                    <div class="px-4 py-3">
                        <div class="flex items-start gap-3">
                            <LucideIconCn Name="@iconName" Size="16" Class="@iconClass" />
                            <div class="min-w-0 flex-1">
                                <div class="flex items-start justify-between gap-2">
                                    <div>
                                        <p class="text-sm font-medium">@region.Name</p>
                                        <p class="mt-0.5 font-mono text-xs text-muted-foreground">@region.Code</p>
                                    </div>
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="shrink-0 text-xs">
                                        @region.Version
                                    </BadgeCn>
                                </div>

                                @if (region.Status == "deploying")
                                {
                                    <div class="mt-3">
                                        <div class="mb-1 flex items-center justify-between text-xs">
                                            <span class="text-muted-foreground">Deployment progress</span>
                                            <span class="font-medium tabular-nums">@(region.Progress)%</span>
                                        </div>
                                        <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                                            <div class="h-full bg-blue-500" style="@($"width:{region.Progress}%")"></div>
                                        </div>
                                    </div>
                                }

                                <div class="mt-2 flex items-center gap-3 text-xs text-muted-foreground">
                                    <div class="flex items-center gap-1.5">
                                        <LucideIconCn Name="activity" Size="12" Class="size-3" />
                                        <span>@(region.Latency)ms</span>
                                    </div>
                                    <div class="flex items-center gap-1.5">
                                        <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                        <span>@region.LastDeployed</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t bg-muted/50 px-4 py-2">
            <div class="flex items-center justify-between text-xs text-muted-foreground">
                <span>Rolling deployment in progress</span>
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    <span>Live</span>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private record Region(string Id, string Name, string Code, string Status, string Version, int Progress, int Latency, string LastDeployed);

    private static readonly Region[] _regions =
    [
        new("1", "US East (N. Virginia)",    "us-east-1",      "deployed",  "v3.2.1", 100,  12, "2 hours ago"),
        new("2", "US West (Oregon)",          "us-west-2",      "deployed",  "v3.2.1", 100,  18, "2 hours ago"),
        new("3", "EU (Ireland)",              "eu-west-1",      "deploying", "v3.2.1",  67,  24, "15 minutes ago"),
        new("4", "EU (Frankfurt)",            "eu-central-1",   "deploying", "v3.2.1",  45,  28, "8 minutes ago"),
        new("5", "Asia Pacific (Tokyo)",      "ap-northeast-1", "pending",   "v3.2.0",   0,  42, "48 hours ago"),
        new("6", "Asia Pacific (Singapore)",  "ap-southeast-1", "pending",   "v3.2.0",   0,  56, "48 hours ago"),
        new("7", "Asia Pacific (Sydney)",     "ap-southeast-2", "warning",   "v3.2.0", 100, 125, "48 hours ago"),
    ];

    private int DeployedCount => _regions.Count(r => r.Status == "deployed");
    private int DeployingCount => _regions.Count(r => r.Status == "deploying");
    private int AvgLatency => (int)Math.Round(_regions.Average(r => (double)r.Latency));

    private static string GetStatusIconName(string status) => status switch
    {
        "deployed"  => "check-circle-2",
        "deploying" => "loader",
        "pending"   => "clock",
        "warning"   => "alert-triangle",
        _           => "clock",
    };

    private static string GetStatusIconColor(string status) => status switch
    {
        "deployed"  => "text-emerald-500",
        "deploying" => "text-blue-500",
        "pending"   => "text-muted-foreground",
        "warning"   => "text-amber-500",
        _           => "text-muted-foreground",
    };
}
