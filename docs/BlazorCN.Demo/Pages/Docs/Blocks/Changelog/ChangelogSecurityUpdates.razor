@* ============================================================
   Block: changelog-security-updates
   Title: ChangelogSecurityUpdates
   Description: React security updates changelog block for Next.js with severity badges, CVE-style identifiers, affected versions, and fix versions built with TypeScript, Framer Motion staggered animations, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-security-updates.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Security Updates</h2>
            <span class="ml-auto text-xs text-muted-foreground">@_entries.Length advisories</span>
        </div>

        @if (_criticalCount > 0)
        {
            <div class="flex items-center gap-2 border-b bg-red-500/5 px-4 py-2">
                <span class="size-1.5 rounded-full bg-red-500"></span>
                <span class="text-xs font-medium text-red-600 dark:text-red-400">
                    @_criticalCount critical @(_criticalCount == 1 ? "vulnerability" : "vulnerabilities") patched
                </span>
            </div>
        }

        <div>
            @foreach (var entry in _entries)
            {
                var config = GetSeverityConfig(entry.Severity);
                <div class="border-b px-4 py-3 last:border-b-0">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@($"inline-flex items-center rounded-md px-1.5 py-0.5 text-xs font-medium {config.Bg} {config.Text}")">
                                    @config.Label
                                </span>
                                <span class="font-mono text-xs text-muted-foreground">@entry.Cve</span>
                            </div>
                            <p class="mt-1.5 text-sm font-medium">@entry.Title</p>
                            <p class="mt-0.5 text-xs text-muted-foreground">@entry.Description</p>
                            <div class="mt-2 flex items-center gap-4">
                                <div class="flex items-center gap-1.5">
                                    <span class="text-xs text-muted-foreground">Affected:</span>
                                    <span class="font-mono text-xs text-muted-foreground">@entry.AffectedVersions</span>
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <span class="text-xs text-muted-foreground">Fix:</span>
                                    <span class="font-mono text-xs font-medium">@entry.FixVersion</span>
                                </div>
                            </div>
                        </div>
                        <span class="shrink-0 text-xs text-muted-foreground">@entry.Date</span>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record SecurityEntry(
        string Id,
        string Title,
        string Description,
        string Cve,
        string Severity,
        string AffectedVersions,
        string FixVersion,
        string Date
    );

    private record SeverityConfig(string Label, string Bg, string Text, string Dot);

    private static SeverityConfig GetSeverityConfig(string severity) => severity switch
    {
        "critical" => new("Critical", "bg-red-500/10", "text-red-600 dark:text-red-400", "bg-red-500"),
        "high"     => new("High",     "bg-amber-500/10", "text-amber-600 dark:text-amber-400", "bg-amber-500"),
        "medium"   => new("Medium",   "bg-blue-500/10", "text-blue-600 dark:text-blue-400", "bg-blue-500"),
        _          => new("Unknown",  "bg-gray-500/10", "text-gray-600 dark:text-gray-400", "bg-gray-500"),
    };

    private static readonly SecurityEntry[] _entries =
    [
        new("s1",
            "Remote code execution via crafted SVG upload",
            "Malicious SVG files with embedded scripts could execute arbitrary code during server-side rendering of image previews.",
            "CVE-2026-4821", "critical", "3.0.0 – 3.7.2", "3.7.3", "Mar 28"),
        new("s2",
            "SQL injection in advanced search filters",
            "Custom filter expressions were not properly parameterized, allowing SQL injection through the search API endpoint.",
            "CVE-2026-4819", "critical", "3.5.0 – 3.7.2", "3.7.3", "Mar 28"),
        new("s3",
            "Authentication bypass via malformed JWT claims",
            "JWTs with duplicate aud claims bypassed audience validation, granting access to unintended API scopes.",
            "CVE-2026-4815", "high", "2.8.0 – 3.7.1", "3.7.2", "Mar 26"),
        new("s4",
            "Privilege escalation through team role caching",
            "Cached role assignments were not invalidated when a user was demoted, retaining elevated permissions until cache expiry.",
            "CVE-2026-4810", "high", "3.2.0 – 3.6.8", "3.7.0", "Mar 24"),
        new("s5",
            "Cross-site scripting in markdown preview",
            "Inline HTML in markdown content was not sanitized in the live preview panel, enabling stored XSS attacks.",
            "CVE-2026-4807", "medium", "3.4.0 – 3.6.5", "3.6.6", "Mar 22"),
        new("s6",
            "Information disclosure via verbose error responses",
            "Unhandled exceptions returned stack traces and internal file paths in production API error responses.",
            "CVE-2026-4803", "medium", "3.0.0 – 3.6.4", "3.6.5", "Mar 20"),
    ];

    private int _criticalCount => _entries.Count(e => e.Severity == "critical");
}
