@* ============================================================
   Block: changelog-feature-adoption
   Title: ChangelogFeatureAdoption
   Description: A React feature adoption changelog block for Next.js with adoption rate tracking, usage trends, activation funnels, and retention metrics per feature release built with shadcn/ui and Tailwind CSS
   Source: original/blocks/changelog/changelog-feature-adoption.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bar-chart-3" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Feature Adoption</span>
            </div>
            <span class="text-muted-foreground text-xs">@_features.Length features tracked</span>
        </div>

        @* Summary stats *@
        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3 text-center">
                <span class="text-muted-foreground text-xs">Avg adoption</span>
                <p class="mt-0.5 font-semibold text-2xl tabular-nums">55%</p>
            </div>
            <div class="border-r px-4 py-3 text-center">
                <span class="text-muted-foreground text-xs">Total DAU</span>
                <p class="mt-0.5 font-semibold text-2xl tabular-nums">20.2K</p>
            </div>
            <div class="px-4 py-3 text-center">
                <span class="text-muted-foreground text-xs">Avg retention</span>
                <p class="mt-0.5 font-semibold text-2xl tabular-nums">74%</p>
            </div>
        </div>

        @* Feature rows *@
        <div>
            @foreach (var (feature, index) in _features.Select((f, i) => (f, i)))
            {
                var feat = feature;
                var isExpanded = _expandedId == feat.Id;
                var adoptionColor = feat.AdoptionRate >= 70
                    ? "text-emerald-600 dark:text-emerald-400"
                    : feat.AdoptionRate >= 40
                        ? "text-amber-600 dark:text-amber-400"
                        : "text-muted-foreground";
                var barColor = feat.AdoptionRate >= 70
                    ? "bg-emerald-500"
                    : feat.AdoptionRate >= 40
                        ? "bg-amber-500"
                        : "bg-muted-foreground/30";
                var barDivClass = $"h-full rounded-full {barColor}";
                var adoptionSpanClass = $"w-10 text-right font-semibold text-sm tabular-nums {adoptionColor}";
                var trendSpanClass = $"flex items-center gap-0.5 {TrendColor(feat.Trend)}";
                var chevronClass = isExpanded
                    ? "size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 rotate-90"
                    : "size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200";
                var adoptionBarStyle = $"width:{feat.AdoptionRate}%";
                <div class="border-b last:border-b-0">
                    <button type="button" @onclick="@(() => Toggle(feat.Id))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@feat.Name</span>
                                <span class="font-mono text-muted-foreground text-xs">@feat.Version</span>
                            </div>
                            <div class="mt-1.5 flex items-center gap-3">
                                <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                                    <div class="@barDivClass" style="@adoptionBarStyle"></div>
                                </div>
                                <span class="@adoptionSpanClass">
                                    @feat.AdoptionRate%
                                </span>
                            </div>
                            <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                                <span>@feat.Dau DAU</span>
                                <span class="text-muted-foreground/40">&middot;</span>
                                <span>@feat.Retention7d% retained</span>
                                <span class="text-muted-foreground/40">&middot;</span>
                                <span class="@trendSpanClass">
                                    <LucideIconCn Name="@TrendIcon(feat.Trend)" Size="12" Class="size-3" />
                                    @feat.TrendDelta
                                </span>
                                <span class="text-muted-foreground/40">&middot;</span>
                                <span>@feat.ShippedDate</span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-4">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <span class="mb-2 block font-medium text-muted-foreground text-xs">
                                        Activation funnel
                                    </span>
                                    <div class="space-y-2">
                                        @foreach (var (stage, sIndex) in feat.Funnel.Select((s, i) => (s, i)))
                                        {
                                            var lastIdx = feat.Funnel.Length - 1;
                                            var funnelBarClass = sIndex == 0
                                                ? "h-full rounded-full bg-foreground/15"
                                                : sIndex == lastIdx
                                                    ? "h-full rounded-full bg-emerald-500"
                                                    : "h-full rounded-full bg-foreground/25";
                                            var funnelBarStyle = $"width:{stage.Percent}%";
                                            <div class="flex items-center gap-3">
                                                <span class="w-20 text-xs text-muted-foreground">@stage.Name</span>
                                                <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-background">
                                                    <div class="@funnelBarClass" style="@funnelBarStyle"></div>
                                                </div>
                                                <span class="w-12 text-right font-mono text-muted-foreground text-xs tabular-nums">@stage.Percent%</span>
                                                <span class="w-14 text-right text-muted-foreground text-xs tabular-nums">@stage.Value.ToString("N0")</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Metrics from last 7 days &middot; Adoption = activated / total eligible users
            </p>
        </div>
    </div>
</section>

@code {
    private record FunnelStage(string Name, int Value, int Percent);
    private record FeatureMetric(string Id, string Name, string Version, string ShippedDate, int AdoptionRate, string Dau, int Retention7d, string Trend, string TrendDelta, FunnelStage[] Funnel);

    private static readonly FeatureMetric[] _features =
    [
        new("f1", "Real-time collaboration", "v8.4.0", "Mar 24", 42, "3,840", 68, "up", "+12%",
        [
            new("Viewed", 9200, 100),
            new("Tried", 5520, 60),
            new("Activated", 3840, 42),
            new("Retained (7d)", 2611, 28),
        ]),
        new("f2", "AI-powered search", "v8.3.0", "Mar 17", 67, "6,120", 81, "up", "+8%",
        [
            new("Viewed", 9140, 100),
            new("Tried", 7312, 80),
            new("Activated", 6120, 67),
            new("Retained (7d)", 4957, 54),
        ]),
        new("f3", "Custom dashboard widgets", "v8.3.0", "Mar 17", 23, "2,100", 54, "flat", "+1%",
        [
            new("Viewed", 9140, 100),
            new("Tried", 3656, 40),
            new("Activated", 2100, 23),
            new("Retained (7d)", 1134, 12),
        ]),
        new("f4", "Bulk CSV import", "v8.2.0", "Mar 10", 89, "8,140", 92, "up", "+3%",
        [
            new("Viewed", 9150, 100),
            new("Tried", 8692, 95),
            new("Activated", 8140, 89),
            new("Retained (7d)", 7488, 82),
        ]),
    ];

    private string? _expandedId;

    private void Toggle(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private static string TrendIcon(string trend) => trend switch
    {
        "up" => "arrow-up-right",
        "flat" => "minus",
        "down" => "trending-up",
        _ => "minus",
    };

    private static string TrendColor(string trend) => trend switch
    {
        "up" => "text-emerald-600 dark:text-emerald-400",
        "flat" => "text-muted-foreground",
        "down" => "text-red-600 dark:text-red-400",
        _ => "text-muted-foreground",
    };
}
