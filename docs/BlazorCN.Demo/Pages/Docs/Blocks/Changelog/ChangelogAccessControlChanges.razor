@* ============================================================
   Block: changelog-access-control-changes
   Title: ChangelogAccessControlChanges
   Description: A React changelog component for RBAC and permission updates built with Next.js, shadcn/ui, and Tailwind CSS showing role-based access changes with before/after states
   Source: original/blocks/changelog/changelog-access-control-changes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Access Control Changes</h2>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">
                Role-based permission updates and resource access modifications
            </p>
        </div>

        <div>
            @foreach (var ch in _changes)
            {
                var isExpanded = _expandedId == ch.Id;
                var roleClass = GetRoleClass(ch.Role);
                var actionBadgeClass = GetActionBadgeClass(ch.Action);
                var chevronClass = Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
                <div class="border-b last:border-b-0">
                    <button
                        type="button"
                        @onclick="@(() => ToggleExpanded(ch.Id))"
                        class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex min-w-0 flex-1 flex-col gap-2">
                            <div class="flex items-center gap-2">
                                <span class="@roleClass">@ch.Role</span>
                                <span class="@actionBadgeClass">@ch.Action</span>
                                <span class="text-xs text-muted-foreground">@ch.Timestamp</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="font-mono text-xs text-muted-foreground">@ch.Resource</span>
                            </div>
                            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                                <LucideIconCn Name="user" Size="12" Class="size-3" />
                                <span>@ch.ChangedBy</span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/50 px-4 py-3">
                            <p class="mb-3 text-xs text-muted-foreground">@ch.Reason</p>

                            <div class="grid gap-3 sm:grid-cols-2">
                                <div>
                                    <span class="mb-1.5 block text-xs font-medium text-muted-foreground">
                                        Before
                                    </span>
                                    <div class="flex flex-wrap gap-1.5">
                                        @if (ch.Before.Length > 0)
                                        {
                                            @foreach (var perm in ch.Before)
                                            {
                                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">@perm</BadgeCn>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-xs text-muted-foreground">No permissions</span>
                                        }
                                    </div>
                                </div>

                                <div>
                                    <span class="mb-1.5 block text-xs font-medium text-muted-foreground">
                                        After
                                    </span>
                                    <div class="flex flex-wrap gap-1.5">
                                        @foreach (var perm in ch.After)
                                        {
                                            var isNew = !ch.Before.Contains(perm);
                                            @if (isNew)
                                            {
                                                <BadgeCn Variant="BadgeVariant.Default" Class="text-xs bg-emerald-500/10 text-emerald-500">@perm</BadgeCn>
                                            }
                                            else
                                            {
                                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">@perm</BadgeCn>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record AccessChange(
        string Id,
        string Timestamp,
        string Role,
        string Resource,
        string Action,
        string[] Before,
        string[] After,
        string ChangedBy,
        string Reason
    );

    private string? _expandedId;

    private void ToggleExpanded(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private static string GetRoleClass(string role) => role switch
    {
        "Admin"     => "rounded-md px-2 py-0.5 text-xs font-medium bg-red-500/10 text-red-500",
        "Editor"    => "rounded-md px-2 py-0.5 text-xs font-medium bg-blue-500/10 text-blue-500",
        "Developer" => "rounded-md px-2 py-0.5 text-xs font-medium bg-purple-500/10 text-purple-500",
        "Viewer"    => "rounded-md px-2 py-0.5 text-xs font-medium bg-gray-500/10 text-gray-500",
        "Support"   => "rounded-md px-2 py-0.5 text-xs font-medium bg-emerald-500/10 text-emerald-500",
        "Guest"     => "rounded-md px-2 py-0.5 text-xs font-medium bg-amber-500/10 text-amber-500",
        _           => "rounded-md px-2 py-0.5 text-xs font-medium bg-gray-500/10 text-gray-500",
    };

    private static string GetActionBadgeClass(string action) => action switch
    {
        "granted"  => "rounded-md px-2 py-0.5 text-xs font-medium bg-emerald-500/10 text-emerald-500",
        "revoked"  => "rounded-md px-2 py-0.5 text-xs font-medium bg-red-500/10 text-red-500",
        "modified" => "rounded-md px-2 py-0.5 text-xs font-medium bg-blue-500/10 text-blue-500",
        _          => "rounded-md px-2 py-0.5 text-xs font-medium bg-gray-500/10 text-gray-500",
    };

    private static readonly AccessChange[] _changes =
    [
        new("1", "2 hours ago", "Editor", "workspace.documents", "modified",
            ["read", "write"],
            ["read", "write", "delete"],
            "Sarah Chen",
            "Added delete permission for document cleanup workflows"),
        new("2", "5 hours ago", "Viewer", "analytics.reports", "granted",
            [],
            ["read"],
            "Michael Torres",
            "Enable read-only access for stakeholder review"),
        new("3", "Yesterday", "Admin", "billing.settings", "revoked",
            ["read", "write", "delete"],
            ["read", "write"],
            "Emma Wilson",
            "Removed delete access to prevent accidental billing deletions"),
        new("4", "2 days ago", "Developer", "api.keys", "modified",
            ["read"],
            ["read", "create", "rotate"],
            "James Park",
            "Allow developers to manage their own API keys"),
        new("5", "3 days ago", "Support", "user.profiles", "granted",
            [],
            ["read"],
            "Sarah Chen",
            "Support team needs user profile access for troubleshooting"),
        new("6", "1 week ago", "Guest", "workspace.comments", "revoked",
            ["read", "write"],
            ["read"],
            "Michael Torres",
            "Restrict guest users to read-only comments"),
    ];
}
