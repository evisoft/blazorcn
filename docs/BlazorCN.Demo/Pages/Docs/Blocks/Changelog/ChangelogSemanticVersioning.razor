@* ============================================================
   Block: changelog-semantic-versioning
   Title: ChangelogSemanticVersioning
   Description: React semver changelog block for Next.js with color-coded MAJOR.MINOR.PATCH breakdown explaining each version segment built with TypeScript, Framer Motion stagger, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-semantic-versioning.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="tag" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Changelog</h2>
            <span class="text-xs text-muted-foreground">Semantic versioning</span>
        </div>

        <div class="divide-y">
            @foreach (var v in _versions)
            {
                <div class="px-4 py-4">
                    <div class="flex items-baseline justify-between gap-3">
                        <div class="flex items-baseline gap-0.5 font-mono">
                            <span class="text-2xl font-semibold tabular-nums text-red-600 dark:text-red-400">@v.Major</span>
                            <span class="text-muted-foreground">.</span>
                            <span class="text-2xl font-semibold tabular-nums text-blue-600 dark:text-blue-400">@v.Minor</span>
                            <span class="text-muted-foreground">.</span>
                            <span class="text-2xl font-semibold tabular-nums text-muted-foreground">@v.Patch</span>
                        </div>
                        <span class="text-xs text-muted-foreground">@v.Date</span>
                    </div>
                    <div class="mt-3 space-y-2">
                        @foreach (var change in v.Changes)
                        {
                            var style = _segmentStyles[change.Segment];
                            <div class="flex items-start gap-2.5">
                                <span class="@Cn.Merge("mt-0.5 shrink-0 rounded px-1.5 py-0.5 font-mono text-xs font-medium", style.Bg, style.Text)">
                                    @style.Label
                                </span>
                                <p class="text-xs leading-relaxed text-muted-foreground">@change.Description</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record SegmentStyle(string Bg, string Text, string Label);
    private record ChangeEntry(string Segment, string Description);
    private record VersionEntry(int Major, int Minor, int Patch, string Date, ChangeEntry[] Changes);

    private static readonly Dictionary<string, SegmentStyle> _segmentStyles = new()
    {
        ["major"] = new("bg-red-500/10", "text-red-600 dark:text-red-400", "Major"),
        ["minor"] = new("bg-blue-500/10", "text-blue-600 dark:text-blue-400", "Minor"),
        ["patch"] = new("bg-muted/50", "text-muted-foreground", "Patch"),
    };

    private static readonly VersionEntry[] _versions =
    [
        new(4, 0, 0, "Mar 28, 2026",
        [
            new("major", "Migrated from REST to GraphQL API — all v3 endpoints removed."),
            new("minor", "Added batch mutation support for bulk record operations."),
            new("patch", "Fixed cursor pagination returning duplicate nodes at page boundaries."),
        ]),
        new(3, 8, 2, "Mar 15, 2026",
        [
            new("minor", "Introduced workspace-level environment variables with inheritance."),
            new("patch", "Resolved memory leak in long-running WebSocket connections."),
            new("patch", "Corrected timezone offset calculation for Australia/Lord_Howe."),
        ]),
        new(3, 7, 0, "Feb 28, 2026",
        [
            new("minor", "Added OIDC provider support for custom identity federation."),
            new("minor", "New audit log retention policies with configurable TTL."),
            new("patch", "Fixed SVG export clipping on elements with drop-shadow filters."),
        ]),
    ];
}
