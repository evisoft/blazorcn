@* ============================================================
   Block: changelog-region-rollout
   Title: ChangelogRegionRollout
   Description: A React geographic region rollout changelog block for Next.js with region-level deployment status, rollout percentages, and latency metrics built with shadcn/ui and Tailwind CSS
   Source: original/blocks/changelog/changelog-region-rollout.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="globe" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Region Rollout</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                v5.2.0
            </BadgeCn>
        </div>

        @* Global summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="text-2xl font-semibold tabular-nums">@_globalPercent%</span>
                <span class="text-xs text-muted-foreground">global</span>
            </div>
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                <span>@_completedRegions of @_regions.Length complete</span>
                <span>&middot;</span>
                <span>1 paused</span>
                <span>&middot;</span>
                <span>@_totalInstances instances</span>
            </div>
        </div>

        @* Region rows *@
        @for (var i = 0; i < _regions.Length; i++)
        {
            var region = _regions[i];
            <div class="@Cn.Merge("px-4 py-3", i < _regions.Length - 1 ? "border-b" : "")">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="@GetStatusIconName(region.Status)" Size="16" Class="@GetStatusIconClass(region.Status)" />
                        <div class="min-w-0">
                            <span class="text-sm font-medium">@region.Name</span>
                            <span class="ml-2 font-mono text-xs text-muted-foreground">@region.Code</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 text-xs text-muted-foreground">
                        <span class="font-mono tabular-nums">@region.Latency</span>
                        <span>@region.UpdatedAt</span>
                    </div>
                </div>

                @* Progress bar *@
                <div class="mt-2 flex items-center gap-3">
                    <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                        <div class="@GetProgressBarClass(region.Status)" style="@($"width:{region.RolloutPercent}%")"></div>
                    </div>
                    <span class="w-8 text-right font-mono text-xs text-muted-foreground tabular-nums">
                        @region.RolloutPercent%
                    </span>
                </div>

                @* Instance count *@
                <div class="mt-1.5 flex items-center gap-2 text-xs text-muted-foreground">
                    <span>@region.Instances instances</span>
                    @if (region.Status == "paused")
                    {
                        <span class="text-amber-600 dark:text-amber-400">Paused: elevated error rate in region</span>
                    }
                </div>
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-xs text-muted-foreground">
                Rolling deployment · Canary 5% per region · Auto-pause on error spike
            </p>
        </div>
    </div>
</section>

@code {
    private record RegionRow(string Id, string Code, string Name, string Status, int RolloutPercent, string Latency, int Instances, string UpdatedAt);

    private static readonly RegionRow[] _regions =
    [
        new("r1", "us-east-1",      "US East (Virginia)",         "complete", 100, "12ms", 48, "18 min ago"),
        new("r2", "eu-west-1",      "EU West (Ireland)",          "complete", 100, "24ms", 32, "14 min ago"),
        new("r3", "ap-south-1",     "Asia Pacific (Mumbai)",      "rolling",   67, "48ms", 24, "2 min ago"),
        new("r4", "us-west-2",      "US West (Oregon)",           "rolling",   31, "18ms", 36, "1 min ago"),
        new("r5", "ap-northeast-1", "Asia Pacific (Tokyo)",       "paused",     5, "52ms", 20, "8 min ago"),
        new("r6", "sa-east-1",      "South America (Sao Paulo)",  "pending",    0, "86ms", 12, "2 hours ago"),
    ];

    private static readonly int _completedRegions = Array.FindAll(_regions, r => r.Status == "complete").Length;
    private static readonly int _globalPercent = (int)Math.Round(_regions.Average(r => r.RolloutPercent));
    private static readonly int _totalInstances = _regions.Sum(r => r.Instances);

    private static string GetStatusIconName(string status) => status switch
    {
        "complete" => "check-circle",
        "rolling"  => "circle-dot",
        "paused"   => "pause-circle",
        _          => "clock",
    };

    private static string GetStatusIconClass(string status) => status switch
    {
        "complete" => "size-4 text-emerald-600 dark:text-emerald-400",
        "rolling"  => "size-4 text-blue-600 dark:text-blue-400",
        "paused"   => "size-4 text-amber-600 dark:text-amber-400",
        _          => "size-4 text-muted-foreground",
    };

    private static string GetProgressBarClass(string status) => status switch
    {
        "complete" => "h-full rounded-full bg-emerald-500",
        "rolling"  => "h-full rounded-full bg-blue-500",
        "paused"   => "h-full rounded-full bg-amber-500",
        _          => "h-full rounded-full bg-muted-foreground/20",
    };
}
