@* ============================================================
   Block: changelog-service-dependency-map
   Title: ChangelogServiceDependencyMap
   Description: A changelog block visualizing service dependencies with upstream/downstream impact analysis and deployment orchestration built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-service-dependency-map.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Service Dependencies</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Upstream and downstream service relationships
                    </p>
                </div>
                <LucideIconCn Name="network" Size="16" Class="size-4 text-muted-foreground" />
            </div>
        </div>

        @* Stats *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-4 gap-4">
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="server" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Services</span>
                    </div>
                    <p class="mt-1 font-semibold tabular-nums text-2xl">@_totalServices</p>
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="network" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Dependencies</span>
                    </div>
                    <p class="mt-1 font-semibold tabular-nums text-2xl">@_totalDependencies</p>
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="alert-triangle" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Breaking</span>
                    </div>
                    <p class="mt-1 font-semibold tabular-nums text-2xl text-red-600">@_servicesWithBreaking</p>
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="arrow-down" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Avg Depth</span>
                    </div>
                    <p class="mt-1 font-semibold tabular-nums text-2xl">3.2</p>
                </div>
            </div>
        </div>

        @* Service List *@
        <div>
            @foreach (var it in _services)
            {
                var service = it;
                var isExpanded = _expandedId == service.Id;
                var upstreamDeps = service.Dependencies.Where(d => d.Type == "upstream").ToArray();
                var downstreamDeps = service.Dependencies.Where(d => d.Type == "downstream").ToArray();
                var isLast = service.Id == _services[^1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => ToggleExpanded(service.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted">
                            <LucideIconCn Name="server" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@service.Name</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 border-0 bg-muted/50 px-1.5 text-[10px]">
                                    @service.Version
                                </BadgeCn>
                                @if (service.BreakingChanges)
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 border-0 bg-red-500/10 px-1.5 text-[10px] text-red-600">
                                        Breaking
                                    </BadgeCn>
                                }
                            </div>
                            <div class="mt-0.5 flex items-center gap-3 text-xs text-muted-foreground">
                                <span>@service.Team</span>
                                <span>•</span>
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="arrow-up" Size="12" Class="size-3" />
                                    @service.UpstreamCount
                                </span>
                                <span>•</span>
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="arrow-down" Size="12" Class="size-3" />
                                    @service.DownstreamCount
                                </span>
                                <span>•</span>
                                <span>@service.LastDeploy</span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/30 px-4 py-3">
                            <div class="space-y-4">
                                @if (upstreamDeps.Length > 0)
                                {
                                    <div>
                                        <div class="flex items-center gap-1.5">
                                            <LucideIconCn Name="arrow-up" Size="12" Class="size-3 text-muted-foreground" />
                                            <span class="text-xs font-medium text-muted-foreground">
                                                Upstream Dependencies (@upstreamDeps.Length)
                                            </span>
                                        </div>
                                        <div class="mt-2 space-y-2">
                                            @foreach (var dep in upstreamDeps)
                                            {
                                                <div class="flex items-center justify-between rounded-md border bg-card px-3 py-2">
                                                    <div class="flex items-center gap-2">
                                                        <span class="@Cn.Merge("size-1.5 rounded-full", GetStatusColor(dep.Status))"></span>
                                                        <span class="font-mono text-sm">@dep.Name</span>
                                                        <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 border-0 bg-muted/50 px-1.5 text-[10px]">
                                                            @dep.Version
                                                        </BadgeCn>
                                                    </div>
                                                    <span class="@Cn.Merge("text-xs", GetStatusTextColor(dep.Status))">@dep.Status</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (downstreamDeps.Length > 0)
                                {
                                    <div>
                                        <div class="flex items-center gap-1.5">
                                            <LucideIconCn Name="arrow-down" Size="12" Class="size-3 text-muted-foreground" />
                                            <span class="text-xs font-medium text-muted-foreground">
                                                Downstream Consumers (@downstreamDeps.Length)
                                            </span>
                                        </div>
                                        <div class="mt-2 space-y-2">
                                            @foreach (var dep in downstreamDeps)
                                            {
                                                <div class="flex items-center justify-between rounded-md border bg-card px-3 py-2">
                                                    <div class="flex items-center gap-2">
                                                        <span class="@Cn.Merge("size-1.5 rounded-full", GetStatusColor(dep.Status))"></span>
                                                        <span class="font-mono text-sm">@dep.Name</span>
                                                        <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 border-0 bg-muted/50 px-1.5 text-[10px]">
                                                            @dep.Version
                                                        </BadgeCn>
                                                    </div>
                                                    <span class="@Cn.Merge("text-xs", GetStatusTextColor(dep.Status))">@dep.Status</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (service.BreakingChanges)
                                {
                                    <div class="rounded-md bg-red-500/10 p-3">
                                        <div class="flex items-start gap-2">
                                            <LucideIconCn Name="alert-triangle" Size="16" Class="mt-0.5 size-4 shrink-0 text-red-600" />
                                            <div>
                                                <span class="font-medium text-red-600 text-sm">
                                                    Breaking Changes Detected
                                                </span>
                                                <p class="mt-1 text-xs text-red-600/80">
                                                    This release contains breaking API changes. Coordinate with
                                                    downstream services before deploying.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-xs text-muted-foreground">
                    @_totalServices services • @_totalDependencies dependencies
                </span>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="h-7 gap-1.5 px-2 text-xs">
                    View Graph
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record Dependency(
        string Name,
        string Type,
        string Version,
        string Status,
        string LastDeploy
    );

    private record Service(
        string Id,
        string Name,
        string Version,
        string LastDeploy,
        int UpstreamCount,
        int DownstreamCount,
        string Team,
        bool BreakingChanges,
        Dependency[] Dependencies
    );

    private string? _expandedId;

    private void ToggleExpanded(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private static string GetStatusColor(string status) => status switch
    {
        "healthy"  => "bg-emerald-500",
        "degraded" => "bg-amber-500",
        "critical" => "bg-red-500",
        _          => "",
    };

    private static string GetStatusTextColor(string status) => status switch
    {
        "healthy"  => "text-emerald-600",
        "degraded" => "text-amber-600",
        "critical" => "text-red-600",
        _          => "",
    };

    private static readonly Service[] _services =
    [
        new("1", "api-gateway", "v2.4.0", "2 days ago", 5, 3, "Platform", false,
        [
            new("auth-service",     "upstream",   "v1.8.2", "healthy",  "1 week ago"),
            new("user-service",     "upstream",   "v2.1.0", "healthy",  "3 days ago"),
            new("payment-service",  "upstream",   "v1.5.1", "degraded", "5 hours ago"),
            new("web-frontend",     "downstream", "v3.2.1", "healthy",  "1 day ago"),
            new("mobile-app",       "downstream", "v2.0.8", "healthy",  "1 week ago"),
            new("admin-dashboard",  "downstream", "v1.4.2", "healthy",  "4 days ago"),
        ]),
        new("2", "payment-service", "v1.5.1", "5 hours ago", 2, 2, "Commerce", true,
        [
            new("stripe-connector",   "upstream",   "v0.9.0", "healthy",  "2 weeks ago"),
            new("database-service",   "upstream",   "v3.1.0", "healthy",  "1 week ago"),
            new("api-gateway",        "downstream", "v2.4.0", "healthy",  "2 days ago"),
            new("webhook-processor",  "downstream", "v1.2.3", "critical", "2 hours ago"),
        ]),
        new("3", "user-service", "v2.1.0", "3 days ago", 1, 4, "Identity", false,
        [
            new("database-service",     "upstream",   "v3.1.0", "healthy", "1 week ago"),
            new("api-gateway",          "downstream", "v2.4.0", "healthy", "2 days ago"),
            new("notification-service", "downstream", "v1.3.5", "healthy", "5 days ago"),
            new("analytics-pipeline",   "downstream", "v2.0.1", "healthy", "1 day ago"),
            new("search-indexer",       "downstream", "v1.1.8", "healthy", "6 days ago"),
        ]),
        new("4", "auth-service", "v1.8.2", "1 week ago", 1, 6, "Security", false,
        [
            new("oauth-provider", "upstream",   "v2.0.0", "healthy", "3 weeks ago"),
            new("api-gateway",    "downstream", "v2.4.0", "healthy", "2 days ago"),
        ]),
    ];

    private int _totalServices => _services.Length;
    private int _totalDependencies => _services.Sum(s => s.Dependencies.Length);
    private int _servicesWithBreaking => _services.Count(s => s.BreakingChanges);
}
