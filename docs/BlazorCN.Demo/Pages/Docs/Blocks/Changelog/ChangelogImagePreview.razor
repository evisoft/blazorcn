@* ============================================================
   Block: changelog-image-preview
   Title: ChangelogImagePreview
   Description: React image preview changelog block for Next.js with thumbnail placeholders, visual entry cards, and stagger animations built with TypeScript, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-image-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">What&apos;s New</h2>
            <span class="ml-auto font-mono text-xs text-muted-foreground">5 updates</span>
        </div>

        @for (var i = 0; i < _entries.Length; i++)
        {
            var entry = _entries[i];
            var rowClass = Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", i < _entries.Length - 1 ? "border-b" : "");
            <div class="@rowClass">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-medium">@entry.Title</span>
                        <span class="font-mono text-xs text-muted-foreground">@entry.Version</span>
                    </div>
                    <span class="text-xs text-muted-foreground">@entry.Date</span>
                </div>
                <p class="mt-1 text-xs leading-relaxed text-muted-foreground">@entry.Description</p>
                <div class="mt-2.5 flex aspect-video items-center justify-center rounded-md bg-muted/50">
                    <div class="flex flex-col items-center gap-1.5">
                        <LucideIconCn Name="image" Size="20" Class="size-5 text-muted-foreground/40" />
                        <span class="text-[10px] text-muted-foreground/60">@entry.ImageLabel</span>
                    </div>
                </div>
            </div>
        }

    </div>
</section>

@code {
    private record ChangeEntry(string Id, string Title, string Description, string Date, string Version, string ImageLabel);

    private static readonly ChangeEntry[] _entries =
    [
        new("1", "Redesigned dashboard overview",
            "New card-based layout with drag-and-drop widget arrangement, real-time metric updates, and customizable time ranges.",
            "Mar 28", "v5.0.0", "Dashboard overview screenshot"),
        new("2", "Dark mode for all components",
            "Complete dark theme support across every UI component. Automatic detection of system preference with manual toggle override.",
            "Mar 25", "v4.9.0", "Dark mode preview"),
        new("3", "New onboarding flow",
            "Step-by-step guided setup with progress tracking, team invitation prompts, and sample data generation for quick starts.",
            "Mar 22", "v4.8.0", "Onboarding wizard screenshot"),
        new("4", "Inline table editing",
            "Click any cell to edit directly in the table view. Supports text, numbers, dates, and select fields with auto-save.",
            "Mar 18", "v4.7.0", "Table editing interface"),
        new("5", "Command palette redesign",
            "Faster search with fuzzy matching, recent actions history, and keyboard-first navigation through all app features.",
            "Mar 14", "v4.6.0", "Command palette UI"),
    ];
}
