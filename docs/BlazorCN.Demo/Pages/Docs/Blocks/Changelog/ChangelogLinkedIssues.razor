@* ============================================================
   Block: changelog-linked-issues
   Title: ChangelogLinkedIssues
   Description: React changelog block for Next.js with linked issue and ticket references in monospace, clickable project IDs, and categorized entries built with TypeScript, Framer Motion staggered animations, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-linked-issues.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="tag" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Changelog</h2>
            <span class="ml-auto font-mono text-xs text-muted-foreground">
                @_releases.Sum(r => r.Entries.Length) entries
            </span>
        </div>

        @foreach (var release in _releases)
        {
            <div class="border-b last:border-b-0">
                <div class="flex items-baseline gap-3 px-4 pb-1 pt-3">
                    <span class="text-sm font-semibold tabular-nums">v@release.Version</span>
                    <span class="text-xs text-muted-foreground">@release.Date</span>
                </div>

                <div class="px-4 pb-3 pt-1">
                    @foreach (var entry in release.Entries)
                    {
                        var label = GetCategoryLabel(entry.Category);
                        <div class="flex items-start gap-2.5 py-1.5">
                            <span class="@($"mt-1.5 size-1.5 shrink-0 rounded-full {label.Dot}")"></span>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-baseline gap-2">
                                    <a href="#" class="inline-flex shrink-0 items-center gap-1 font-mono text-xs text-muted-foreground transition-colors hover:text-foreground hover:underline">
                                        #@entry.IssueId
                                        <LucideIconCn Name="external-link" Size="10" Class="size-2.5" />
                                    </a>
                                    <span class="text-xs font-medium text-muted-foreground">
                                        @label.Text
                                    </span>
                                </div>
                                <p class="mt-0.5 text-sm text-foreground">@entry.Description</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

    </div>
</section>

@code {
    private record Entry(string IssueId, string Category, string Description);
    private record Release(string Version, string Date, Entry[] Entries);
    private record CategoryLabel(string Text, string Dot);

    private static CategoryLabel GetCategoryLabel(string category) => category switch
    {
        "feat"     => new("Feature", "bg-emerald-500"),
        "fix"      => new("Fix",     "bg-red-500"),
        "perf"     => new("Perf",    "bg-blue-500"),
        "docs"     => new("Docs",    "bg-muted-foreground"),
        "breaking" => new("Breaking","bg-amber-500"),
        _          => new("",        ""),
    };

    private static readonly Release[] _releases =
    [
        new("3.2.0", "Mar 28, 2026",
        [
            new("PROJ-2847", "feat",  "Add batch operations endpoint for bulk resource updates"),
            new("PROJ-2831", "feat",  "Implement webhook retry with exponential backoff"),
            new("PROJ-2819", "fix",   "Resolve memory leak in long-running SSE connections"),
            new("PROJ-2812", "perf",  "Optimize database query plan for user search"),
            new("PROJ-2803", "docs",  "Document rate limiting headers in API reference"),
        ]),
        new("3.1.4", "Mar 22, 2026",
        [
            new("PROJ-2798", "fix",  "Fix pagination cursor encoding for special characters"),
            new("PROJ-2791", "fix",  "Correct Content-Type header for multipart uploads"),
            new("PROJ-2785", "perf", "Cache resolved permissions for team member lookups"),
        ]),
        new("3.1.0", "Mar 15, 2026",
        [
            new("PROJ-2774", "feat",     "Add support for custom OAuth2 identity providers"),
            new("PROJ-2768", "breaking", "Rename /api/v2/users endpoint to /api/v2/members"),
            new("PROJ-2761", "feat",     "Introduce workspace-level environment variables"),
            new("PROJ-2754", "fix",      "Handle concurrent file uploads exceeding 50MB limit"),
        ]),
        new("3.0.3", "Mar 8, 2026",
        [
            new("PROJ-2742", "fix",  "Prevent duplicate webhook deliveries during failover"),
            new("PROJ-2738", "perf", "Reduce cold start time for serverless functions by 200ms"),
            new("PROJ-2731", "docs", "Add migration guide from v2 to v3 with code examples"),
        ]),
    ];
}
