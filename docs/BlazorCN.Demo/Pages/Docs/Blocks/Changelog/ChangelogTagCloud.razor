@* ============================================================
   Block: changelog-tag-cloud
   Title: ChangelogTagCloud
   Description: A filterable changelog block with tag cloud navigation built with React, Next.js, shadcn/ui, and Tailwind CSS for organizing updates by category
   Source: original/blocks/changelog/changelog-tag-cloud.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="tag" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Changelog</h2>
            <span class="text-xs text-muted-foreground">@_filtered.Length entries</span>
        </div>

        @* Tag cloud filter bar *@
        <div class="flex flex-wrap gap-2 border-b px-4 py-3">
            @foreach (var tag in _tags)
            {
                var t = tag;
                <button type="button"
                        class="@Cn.Merge("inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium transition-colors", _activeTag == t ? "bg-foreground text-background" : "bg-muted/50 text-muted-foreground hover:bg-muted")"
                        @onclick="@(() => ToggleTag(t))">
                    @t
                    <span class="@Cn.Merge("tabular-nums", _activeTag == t ? "text-background/70" : "text-muted-foreground/60")">
                        @GetCount(t)
                    </span>
                </button>
            }
        </div>

        @* Entries *@
        <div>
            @foreach (var entry in _filtered)
            {
                <div class="border-b px-4 py-3 last:border-b-0">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@entry.Title</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-[10px]">@entry.Version</BadgeCn>
                            </div>
                            <p class="mt-1 text-xs text-muted-foreground leading-relaxed">@entry.Description</p>
                        </div>
                        <span class="shrink-0 text-xs text-muted-foreground">@entry.Date</span>
                    </div>
                    <div class="mt-2">
                        <span class="inline-flex rounded-full bg-muted/50 px-2 py-0.5 text-[10px] text-muted-foreground">@entry.Tag</span>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Entry(string Id, string Title, string Description, string Tag, string Date, string Version);

    private static readonly string[] _tags =
    [
        "Authentication", "Database", "UI", "API", "Performance", "Security"
    ];

    private static readonly Entry[] _allEntries =
    [
        new("e1", "OAuth 2.1 support added",
            "Full OAuth 2.1 compliance with PKCE flow for all providers including Google, GitHub, and Microsoft.",
            "Authentication", "Mar 25", "v2.8.0"),
        new("e2", "Connection pooling improvements",
            "Reduced idle connection overhead by 40% with automatic pool sizing based on query load.",
            "Database", "Mar 24", "v2.7.4"),
        new("e3", "New DateRangePicker component",
            "Calendar-based date range selection with presets for common ranges like last 7 days, 30 days, and custom.",
            "UI", "Mar 23", "v2.7.3"),
        new("e4", "Rate limiting per endpoint",
            "Configure rate limits per API route with sliding window algorithm and custom response headers.",
            "API", "Mar 22", "v2.7.2"),
        new("e5", "Bundle size reduced by 18%",
            "Tree-shaking improvements and lazy loading of chart components cut initial bundle from 245kb to 201kb.",
            "Performance", "Mar 21", "v2.7.1"),
        new("e6", "CSP header auto-generation",
            "Automatic Content Security Policy headers based on your component usage and third-party integrations.",
            "Security", "Mar 20", "v2.7.0"),
        new("e7", "Session token rotation",
            "Tokens now rotate on every request with a 5-minute grace period for concurrent requests.",
            "Authentication", "Mar 19", "v2.6.9"),
        new("e8", "Query batching support",
            "Batch multiple database queries into a single round trip, reducing latency for complex page loads.",
            "Database", "Mar 18", "v2.6.8"),
        new("e9", "Webhook signature verification",
            "HMAC-SHA256 signature verification middleware for incoming webhook payloads.",
            "Security", "Mar 17", "v2.6.7"),
        new("e10", "Image optimization pipeline",
            "Automatic WebP conversion and responsive srcset generation at build time.",
            "Performance", "Mar 16", "v2.6.6"),
    ];

    private string? _activeTag = null;

    private Entry[] _filtered => _activeTag is null
        ? _allEntries
        : _allEntries.Where(e => e.Tag == _activeTag).ToArray();

    private int GetCount(string tag) => _allEntries.Count(e => e.Tag == tag);

    private void ToggleTag(string tag)
    {
        _activeTag = _activeTag == tag ? null : tag;
    }
}
