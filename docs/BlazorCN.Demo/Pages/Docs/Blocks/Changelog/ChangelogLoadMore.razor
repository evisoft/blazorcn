@* ============================================================
   Block: changelog-load-more
   Title: ChangelogLoadMore
   Description: React changelog block with progressive loading for Next.js, featuring a Load More button that reveals additional entries in batches with staggered animations built with TypeScript, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-load-more.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="list" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Changelog</h2>
            <span class="text-xs text-muted-foreground">@_visibleCount of @_allEntries.Length</span>
        </div>

        <div>
            @foreach (var ent in _allEntries.Take(_visibleCount))
            {
                var entry = ent;
                <div class="border-b px-4 py-3">
                    <div class="flex items-center gap-2">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", _typeColors[entry.Type])"></span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-[10px]">@entry.Version</BadgeCn>
                        <span class="text-xs text-muted-foreground">@entry.Date</span>
                    </div>
                    <p class="mt-1 text-sm font-medium">@entry.Title</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@entry.Description</p>
                </div>
            }
        </div>

        @if (_visibleCount < _allEntries.Length)
        {
            <div class="px-4 py-3">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 w-full gap-1.5 text-xs" OnClick="LoadMore">
                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                    Load more (@(_allEntries.Length - _visibleCount) remaining)
                </ButtonCn>
            </div>
        }
    </div>
</section>

@code {
    private record ChangelogEntry(string Id, string Version, string Date, string Title, string Description, string Type);

    private const int BatchSize = 5;

    private static readonly Dictionary<string, string> _typeColors = new()
    {
        ["feature"] = "bg-blue-500",
        ["fix"] = "bg-red-500",
        ["improvement"] = "bg-amber-500",
    };

    private static readonly ChangelogEntry[] _allEntries =
    [
        new("v6-0-0", "6.0.0", "Mar 28, 2026", "Platform redesign with new navigation",
            "Complete UI overhaul with sidebar navigation, command palette, and updated design system.", "feature"),
        new("v5-9-2", "5.9.2", "Mar 26, 2026", "Fixed PDF export page breaks",
            "Tables and images no longer split across page boundaries in exported PDFs.", "fix"),
        new("v5-9-1", "5.9.1", "Mar 24, 2026", "Improved API response caching",
            "Added stale-while-revalidate caching strategy reducing API latency by 45%.", "improvement"),
        new("v5-9-0", "5.9.0", "Mar 22, 2026", "Workflow automation builder",
            "Visual drag-and-drop builder for creating multi-step automation workflows.", "feature"),
        new("v5-8-4", "5.8.4", "Mar 20, 2026", "Fixed email template rendering in Outlook",
            "Transactional emails now render correctly in Outlook 2016 and newer versions.", "fix"),
        new("v5-8-3", "5.8.3", "Mar 18, 2026", "Batch API operations",
            "New batch endpoint supports up to 100 operations in a single API request.", "feature"),
        new("v5-8-2", "5.8.2", "Mar 16, 2026", "Reduced Docker image size",
            "Production Docker image reduced from 1.2GB to 340MB using multi-stage builds.", "improvement"),
        new("v5-8-1", "5.8.1", "Mar 14, 2026", "Fixed CSV column ordering",
            "Exported CSV files now match the column order displayed in the table view.", "fix"),
        new("v5-8-0", "5.8.0", "Mar 12, 2026", "Granular webhook event filters",
            "Subscribe to specific event types per webhook endpoint instead of receiving all events.", "feature"),
        new("v5-7-3", "5.7.3", "Mar 10, 2026", "Improved full-text search relevance",
            "Search ranking now considers recency, field weights, and fuzzy matching.", "improvement"),
        new("v5-7-2", "5.7.2", "Mar 8, 2026", "Fixed rate limiter edge case",
            "Rate limits no longer carry over across billing period resets.", "fix"),
        new("v5-7-1", "5.7.1", "Mar 6, 2026", "Team activity dashboard",
            "New dashboard widget showing team member activity, commits, and review stats.", "feature"),
        new("v5-7-0", "5.7.0", "Mar 4, 2026", "Database connection pooling",
            "Automatic connection pooling reduces database connection overhead by 70%.", "improvement"),
        new("v5-6-5", "5.6.5", "Mar 2, 2026", "Fixed file permission inheritance",
            "Nested folders now correctly inherit parent folder permissions on creation.", "fix"),
        new("v5-6-4", "5.6.4", "Feb 28, 2026", "SSO group mapping",
            "Map identity provider groups to application roles for automatic permission assignment.", "feature"),
    ];

    private int _visibleCount = BatchSize;

    private void LoadMore()
    {
        _visibleCount = Math.Min(_visibleCount + BatchSize, _allEntries.Length);
    }
}
