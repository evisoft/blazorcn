@* ============================================================
   Block: changelog-sidebar-nav
   Title: ChangelogSidebarNav
   Description: React two-panel sidebar changelog block for Next.js with category navigation, filtered entries, and stagger animations built with TypeScript, Framer Motion, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-sidebar-nav.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="layout-panel-left" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Changelog</h2>
            <span class="ml-auto font-mono text-xs text-muted-foreground">
                @_filteredEntries.Length entries
            </span>
        </div>

        <div class="flex">

            @* Sidebar nav *@
            <div class="w-44 shrink-0 border-r">
                <div class="p-2">
                    @foreach (var cat in _categories)
                    {
                        var category = cat;
                        var count = category.Id == "all"
                            ? _entries.Length
                            : _entries.Count(e => e.Category == category.Id);
                        <button type="button"
                                class="@Cn.Merge("flex w-full items-center gap-2 rounded-md px-3 py-2 text-left text-xs transition-colors", _activeCategory == category.Id ? "bg-muted/80 font-medium" : "text-muted-foreground hover:bg-muted/50 hover:text-foreground")"
                                @onclick="@(() => SetCategory(category.Id))">
                            <span class="@Cn.Merge("size-1.5 rounded-full", category.DotColor)"></span>
                            <span class="flex-1">@category.Label</span>
                            <span class="font-mono text-[10px] text-muted-foreground">@count</span>
                        </button>
                    }
                </div>
            </div>

            @* Entry list *@
            <div class="min-w-0 flex-1">
                @if (_filteredEntries.Length == 0)
                {
                    <div class="flex items-center justify-center py-12 text-xs text-muted-foreground">
                        No entries in this category
                    </div>
                }
                else
                {
                    @for (var i = 0; i < _filteredEntries.Length; i++)
                    {
                        var entry = _filteredEntries[i];
                        var index = i;
                        var cat = _categories.FirstOrDefault(c => c.Id == entry.Category);
                        var borderClass = index < _filteredEntries.Length - 1 ? "border-b" : "";
                        <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", borderClass)">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("size-1.5 rounded-full", cat?.DotColor ?? "")"></span>
                                <span class="text-sm font-medium">@entry.Title</span>
                                <span class="ml-auto shrink-0 font-mono text-xs text-muted-foreground">@entry.Version</span>
                                <span class="shrink-0 text-xs text-muted-foreground">@entry.Date</span>
                            </div>
                            <p class="mt-0.5 pl-[18px] text-xs leading-relaxed text-muted-foreground">
                                @entry.Description
                            </p>
                        </div>
                    }
                }
            </div>

        </div>
    </div>
</section>

@code {
    private record Category(string Id, string Label, string DotColor);
    private record ChangeEntry(string Id, string Category, string Title, string Description, string Date, string Version);

    private string _activeCategory = "all";

    private static readonly Category[] _categories =
    [
        new("all", "All Changes", "bg-foreground"),
        new("feature", "Features", "bg-blue-500"),
        new("fix", "Fixes", "bg-red-500"),
        new("improvement", "Improvements", "bg-amber-500"),
        new("security", "Security", "bg-emerald-500"),
    ];

    private static readonly ChangeEntry[] _entries =
    [
        new("1", "feature", "Multi-tenant workspace isolation",
            "Each workspace now runs in an isolated environment with separate database schemas and encryption keys.",
            "Mar 28", "v6.1.0"),
        new("2", "fix", "Fixed pagination offset in search results",
            "Search results beyond page 5 were returning duplicate entries due to an off-by-one cursor calculation.",
            "Mar 28", "v6.1.0"),
        new("3", "improvement", "Reduced Docker image size by 45%",
            "Switched to multi-stage builds and Alpine base image. Production image now ships at 82MB.",
            "Mar 27", "v6.0.9"),
        new("4", "security", "CSRF token validation on all mutations",
            "All POST, PUT, and DELETE endpoints now require a valid CSRF token. Tokens rotate every 24 hours.",
            "Mar 26", "v6.0.9"),
        new("5", "feature", "GraphQL subscription support",
            "Real-time data subscriptions via WebSocket. Subscribe to entity changes, notifications, and activity feeds.",
            "Mar 25", "v6.0.8"),
        new("6", "fix", "Resolved file upload timeout on slow connections",
            "Increased upload timeout to 120s and added chunked upload fallback for files over 50MB.",
            "Mar 24", "v6.0.8"),
        new("7", "improvement", "Batch API endpoint for bulk operations",
            "New /api/batch endpoint accepts up to 50 operations per request. Reduces round trips for bulk imports.",
            "Mar 23", "v6.0.7"),
        new("8", "feature", "Custom email template builder",
            "WYSIWYG editor for transactional email templates with variable insertion and live preview.",
            "Mar 22", "v6.0.7"),
        new("9", "security", "IP allowlist for API access",
            "Restrict API access to specific IP ranges per workspace. Supports CIDR notation and IPv6.",
            "Mar 20", "v6.0.6"),
        new("10", "fix", "Fixed SSO login redirect loop",
            "Users with multiple SSO providers were stuck in a redirect loop when the primary provider was unavailable.",
            "Mar 19", "v6.0.6"),
    ];

    private ChangeEntry[] _filteredEntries =>
        _activeCategory == "all" ? _entries : _entries.Where(e => e.Category == _activeCategory).ToArray();

    private void SetCategory(string id)
    {
        _activeCategory = id;
    }
}
