@* ============================================================
   Block: changelog-breaking-changes
   Title: ChangelogBreakingChanges
   Description: A breaking changes focused changelog block built with React, Next.js, shadcn/ui, and Tailwind CSS with migration deadlines and impact level indicators
   Source: original/blocks/changelog/changelog-breaking-changes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="alert-triangle" Size="16" Class="size-4 text-amber-500" />
            <h2 class="text-sm font-medium">Breaking Changes</h2>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto text-[10px]">v3.0.0</BadgeCn>
        </div>

        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            @foreach (var level in new[] { "High", "Medium", "Low" })
            {
                var cfg = _impactConfig[level];
                var cnt = GetCount(level);
                <div class="flex items-center gap-1.5">
                    <span class="@Cn.Merge("size-1.5 rounded-full", cfg.Dot)"></span>
                    <span class="text-[10px] text-muted-foreground">@level</span>
                    <span class="text-[10px] text-muted-foreground/60 tabular-nums">@cnt</span>
                </div>
            }
            <span class="ml-auto text-[10px] text-muted-foreground">
                @_breakingChanges.Length total
            </span>
        </div>

        <div>
            @for (var i = 0; i < _breakingChanges.Length; i++)
            {
                var change = _breakingChanges[i];
                var config = _impactConfig[change.Impact];
                var isExpanded = _expandedId == change.Id;
                var changeId = change.Id;
                var rowBorder = i < _breakingChanges.Length - 1 ? "border-b" : "";
                var chevronClass = Cn.Merge("mt-1 size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
                var impactBadgeClass = Cn.Merge("rounded-full px-2 py-0.5 text-[10px] font-medium", config.Bg, config.Color);
                <div class="@rowBorder">
                    <button type="button" @onclick="@(() => Toggle(changeId))"
                            class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", config.Dot)"></span>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@change.Title</span>
                            <p class="mt-0.5 text-xs text-muted-foreground leading-relaxed">
                                @change.Description
                            </p>
                            <div class="mt-2 flex items-center gap-3">
                                <span class="@impactBadgeClass">
                                    @change.Impact Impact
                                </span>
                                <div class="flex items-center gap-1 text-[10px] text-muted-foreground">
                                    <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                    <span>Migrate by @change.Deadline</span>
                                </div>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="mx-4 mb-3 rounded-md bg-muted/50 p-3">
                                <span class="text-[10px] font-medium text-muted-foreground">
                                    Migration Guide
                                </span>
                                <p class="mt-1 text-xs leading-relaxed">@change.Migration</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="flex items-center justify-between border-t bg-amber-500/5 px-4 py-2.5">
            <span class="text-[10px] text-muted-foreground">Earliest deadline: Apr 30, 2026</span>
            <span class="text-[10px] font-medium text-amber-600">
                @GetCount("High") high-impact changes
            </span>
        </div>

    </div>
</section>

@code {
    private record ImpactConfig(string Color, string Dot, string Bg);

    private record BreakingChange(
        string Id,
        string Title,
        string Description,
        string Impact,
        string Deadline,
        string Version,
        string Migration
    );

    private static readonly Dictionary<string, ImpactConfig> _impactConfig = new()
    {
        ["High"]   = new("text-red-600",   "bg-red-500",   "bg-red-500/10"),
        ["Medium"] = new("text-amber-600", "bg-amber-500", "bg-amber-500/10"),
        ["Low"]    = new("text-blue-600",  "bg-blue-500",  "bg-blue-500/10"),
    };

    private static readonly BreakingChange[] _breakingChanges =
    [
        new(
            "bc1",
            "Authentication token format changed to JWT v2",
            "Access tokens now use a compact JWT format with ed25519 signatures. Existing RSA-signed tokens will stop working after the deadline.",
            "High",
            "Apr 30, 2026",
            "v3.0.0",
            "Replace jwt.verify(token, rsaPublicKey) with jwt.verify(token, ed25519PublicKey). Update your JWKS endpoint URL to /api/v2/.well-known/jwks.json."
        ),
        new(
            "bc2",
            "Database connection string format updated",
            "Connection strings now require the sslmode=verify-full parameter. Connections without SSL verification will be rejected.",
            "High",
            "May 15, 2026",
            "v3.0.0",
            "Append ?sslmode=verify-full to your DATABASE_URL. Download the new CA certificate from the dashboard Settings page."
        ),
        new(
            "bc3",
            "Webhook payload envelope restructured",
            "The webhook payload now wraps data in an envelope with metadata fields: event_id, timestamp, and version.",
            "Medium",
            "Jun 1, 2026",
            "v3.0.0",
            "Access your data at payload.data instead of the root object. Use payload.event_id for idempotency checks."
        ),
        new(
            "bc4",
            "Pagination default changed from offset to cursor",
            "List endpoints now return cursor-based pagination by default. Offset pagination is still available via ?pagination=offset query param.",
            "Medium",
            "Jun 15, 2026",
            "v3.0.0",
            "Replace page/per_page params with cursor/limit. Use the next_cursor field from responses for subsequent pages."
        ),
        new(
            "bc5",
            "Legacy /api/v1 endpoints will be removed",
            "All v1 API endpoints are deprecated and will return 410 Gone after the deadline. Equivalent v2 endpoints are available for all functionality.",
            "High",
            "Jul 1, 2026",
            "v3.0.0",
            "Update all API calls from /api/v1/* to /api/v2/*. Refer to the migration guide for endpoint mapping and parameter changes."
        ),
        new(
            "bc6",
            "Date fields now return ISO 8601 with timezone",
            "All date fields previously returned Unix timestamps. They now return ISO 8601 strings with UTC timezone suffix.",
            "Low",
            "Aug 1, 2026",
            "v3.0.0",
            "Replace Date(timestamp * 1000) with new Date(isoString). Both formats are returned during the transition period via the Accept-Date-Format header."
        ),
    ];

    private string? _expandedId;

    private void Toggle(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private int GetCount(string level) => _breakingChanges.Count(c => c.Impact == level);
}
