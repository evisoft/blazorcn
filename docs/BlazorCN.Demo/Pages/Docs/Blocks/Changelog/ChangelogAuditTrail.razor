@* ============================================================
   Block: changelog-audit-trail
   Title: ChangelogAuditTrail
   Description: A security-focused audit trail changelog with actor, action, resource, timestamp, and IP address tracking built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-audit-trail.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Security Audit Trail</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Last 24 hours of system activity
                    </p>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-2 text-xs">
                    Export CSV
                </ButtonCn>
            </div>
        </div>

        <div class="max-h-[700px] overflow-y-auto">
            @foreach (var ev in _auditEvents)
            {
                var isExpanded = _expandedId == ev.Id;
                var iconName = GetActionIconName(ev.Action);
                var dotColor = GetSeverityColor(ev.Severity);
                var chevronClass = Cn.Merge("size-4 shrink-0 text-muted-foreground transition-transform duration-200", isExpanded ? "rotate-180" : "");
                <div class="border-b last:border-b-0">
                    <button
                        type="button"
                        @onclick="@(() => ToggleExpanded(ev.Id))"
                        class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex shrink-0 items-center gap-2 pt-0.5">
                            <span class="@Cn.Merge("size-1.5 rounded-full", dotColor)"></span>
                            <LucideIconCn Name="@iconName" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-start gap-2">
                                <p class="text-sm">
                                    <span class="font-medium">@ev.Actor</span>
                                    @(" ")@ev.Action.ToLower()
                                </p>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto shrink-0 text-xs">
                                    @ev.ResourceType
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 font-mono text-xs text-muted-foreground">
                                @ev.Resource
                            </p>
                            <p class="mt-1 text-xs text-muted-foreground">@ev.Timestamp</p>
                        </div>
                        <LucideIconCn Name="chevron-down" Size="16" Class="@chevronClass" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/50 px-4 py-3">
                            <div class="space-y-2 text-xs">
                                <div class="flex items-center gap-2">
                                    <LucideIconCn Name="globe" Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="text-muted-foreground">IP Address:</span>
                                    <span class="font-mono">@ev.IpAddress</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <LucideIconCn Name="monitor" Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="text-muted-foreground">User Agent:</span>
                                    <span class="font-mono">@ev.UserAgent</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <LucideIconCn Name="shield" Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="text-muted-foreground">Severity:</span>
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 px-1.5 text-xs">
                                        @GetSeverityLabel(ev.Severity)
                                    </BadgeCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="border-t bg-muted/50 px-4 py-2">
            <div class="flex items-center justify-between text-xs text-muted-foreground">
                <span>@_auditEvents.Length events recorded</span>
                <div class="flex items-center gap-3">
                    @foreach (var sc in _severityLegend)
                    {
                        <div class="flex items-center gap-1.5">
                            <span class="@Cn.Merge("size-1.5 rounded-full", sc.Color)"></span>
                            <span>@sc.Label</span>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private record AuditEvent(
        string Id,
        string Actor,
        string Action,
        string Resource,
        string ResourceType,
        string Timestamp,
        string IpAddress,
        string UserAgent,
        string Severity
    );

    private record SeverityEntry(string Color, string Label);

    private string? _expandedId;

    private void ToggleExpanded(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private static string GetSeverityColor(string severity) => severity switch
    {
        "low"    => "bg-blue-500",
        "medium" => "bg-amber-500",
        "high"   => "bg-red-500",
        _        => "bg-gray-500",
    };

    private static string GetSeverityLabel(string severity) => severity switch
    {
        "low"    => "Low",
        "medium" => "Medium",
        "high"   => "High",
        _        => severity,
    };

    private static string GetActionIconName(string action) => action switch
    {
        "Updated permissions"   => "key",
        "Deleted file"          => "trash",
        "Created API key"       => "shield",
        "Modified document"     => "edit",
        "Revoked access"        => "user",
        "Viewed sensitive data" => "file-text",
        _                       => "file-text",
    };

    private static readonly SeverityEntry[] _severityLegend =
    [
        new("bg-blue-500",  "Low"),
        new("bg-amber-500", "Medium"),
        new("bg-red-500",   "High"),
    ];

    private static readonly AuditEvent[] _auditEvents =
    [
        new("1", "sarah.chen@company.com",  "Updated permissions",   "Production Database",     "Database",     "2026-03-30 14:23:15 UTC", "203.0.113.42",  "Chrome 121.0.0",  "high"),
        new("2", "mike.johnson@company.com", "Deleted file",          "config/secrets.yaml",     "File",         "2026-03-30 14:18:42 UTC", "198.51.100.15", "Firefox 122.0.0", "medium"),
        new("3", "admin@company.com",        "Created API key",       "stripe-production-key",   "API Key",      "2026-03-30 13:45:33 UTC", "192.0.2.8",     "Chrome 121.0.0",  "high"),
        new("4", "jane.doe@company.com",     "Modified document",     "Q1 Financial Report.pdf", "Document",     "2026-03-30 12:12:09 UTC", "198.51.100.23", "Safari 17.2.1",   "low"),
        new("5", "system",                   "Revoked access",        "john.smith@company.com",  "User Account", "2026-03-30 11:30:00 UTC", "10.0.0.1",      "Automated",       "high"),
        new("6", "alex.wong@company.com",    "Viewed sensitive data", "Customer PII Database",   "Database",     "2026-03-30 10:55:21 UTC", "203.0.113.89",  "Chrome 121.0.0",  "medium"),
    ];
}
