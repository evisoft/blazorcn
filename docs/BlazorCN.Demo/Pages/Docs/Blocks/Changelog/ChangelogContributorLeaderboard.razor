@* ============================================================
   Block: changelog-contributor-leaderboard
   Title: ChangelogContributorLeaderboard
   Description: A top contributors ranking board with commits, reviews, and impact scores for React and Next.js teams using shadcn/ui components and Tailwind CSS.
   Source: original/blocks/changelog/changelog-contributor-leaderboard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Top Contributors</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Ranked by impact score this month
                    </p>
                </div>
                <BadgeCn Class="h-5 gap-1 bg-emerald-500/10 text-emerald-600 text-xs">
                    <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                    30 days
                </BadgeCn>
            </div>
        </div>

        <div class="border-b bg-muted/20 px-4 py-2">
            <div class="flex items-center justify-between text-xs font-medium text-muted-foreground">
                <span>Contributor</span>
                <span>Impact Score</span>
            </div>
        </div>

        <div>
            @for (var idx = 0; idx < _contributors.Length; idx++)
            {
                var contributor = _contributors[idx];
                var isExpanded = _expandedRank == contributor.Rank;
                var itemClass = idx < _contributors.Length - 1 ? "border-b" : "";
                var chevronClass = Cn.Merge(
                    "size-4 text-muted-foreground/60 transition-transform duration-200",
                    isExpanded ? "rotate-90" : "");
                <div class="@itemClass">
                    <button
                        type="button"
                        @onclick="@(() => ToggleExpanded(contributor.Rank))"
                        class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex size-6 shrink-0 items-center justify-center">
                            @if (contributor.Badge == "gold")
                            {
                                <LucideIconCn Name="trophy" Size="16" Class="size-4 text-yellow-500" />
                            }
                            else if (contributor.Badge == "silver")
                            {
                                <LucideIconCn Name="medal" Size="16" Class="size-4 text-zinc-400" />
                            }
                            else if (contributor.Badge == "bronze")
                            {
                                <LucideIconCn Name="medal" Size="16" Class="size-4 text-orange-600" />
                            }
                            else
                            {
                                <span class="text-xs font-medium text-muted-foreground">
                                    #@contributor.Rank
                                </span>
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@contributor.Name</span>
                                        <span class="text-xs text-muted-foreground">
                                            @contributor.Username
                                        </span>
                                    </div>
                                    <div class="mt-1.5 space-y-1">
                                        <ProgressCn Value="@(contributor.ImpactScore * 100.0 / _maxScore)" Class="h-1.5" aria-label="Progress" />
                                        <div class="flex items-center gap-3 text-xs text-muted-foreground">
                                            <span class="flex items-center gap-1">
                                                <LucideIconCn Name="git-commit-horizontal" Size="12" Class="size-3" />
                                                @contributor.Commits commits
                                            </span>
                                            <span class="flex items-center gap-1">
                                                <LucideIconCn Name="git-pull-request" Size="12" Class="size-3" />
                                                @contributor.Reviews reviews
                                            </span>
                                            <span class="flex items-center gap-1">
                                                <LucideIconCn Name="star" Size="12" Class="size-3" />
                                                @contributor.Streak day streak
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="font-semibold tabular-nums text-sm">
                                        @contributor.ImpactScore.ToString("N0")
                                    </span>
                                    <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                                </div>
                            </div>
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/20 px-4 py-3">
                            <div class="grid grid-cols-2 gap-3">
                                <div class="rounded-md bg-card px-3 py-2">
                                    <div class="text-xs text-muted-foreground">Lines Added</div>
                                    <div class="mt-1 font-semibold tabular-nums text-emerald-600 text-sm">
                                        +@contributor.LinesAdded.ToString("N0")
                                    </div>
                                </div>
                                <div class="rounded-md bg-card px-3 py-2">
                                    <div class="text-xs text-muted-foreground">Lines Removed</div>
                                    <div class="mt-1 font-semibold tabular-nums text-red-600 text-sm">
                                        -@contributor.LinesRemoved.ToString("N0")
                                    </div>
                                </div>
                                <div class="rounded-md bg-card px-3 py-2">
                                    <div class="text-xs text-muted-foreground">Total Commits</div>
                                    <div class="mt-1 font-semibold tabular-nums text-sm">
                                        @contributor.Commits
                                    </div>
                                </div>
                                <div class="rounded-md bg-card px-3 py-2">
                                    <div class="text-xs text-muted-foreground">PR Reviews</div>
                                    <div class="mt-1 font-semibold tabular-nums text-sm">
                                        @contributor.Reviews
                                    </div>
                                </div>
                            </div>
                            <div class="mt-3 rounded-md bg-blue-500/10 px-3 py-2">
                                <div class="flex items-center gap-2">
                                    <LucideIconCn Name="star" Size="16" Class="size-4 text-blue-600" />
                                    <span class="text-xs text-blue-600">
                                        Current streak: @contributor.Streak consecutive days
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Contributor(
        int Rank,
        string Name,
        string Username,
        int Commits,
        int Reviews,
        int ImpactScore,
        int LinesAdded,
        int LinesRemoved,
        int Streak,
        string? Badge = null
    );

    private int? _expandedRank;

    private static readonly Contributor[] _contributors =
    [
        new(1, "Sarah Chen",       "@sarahchen",  247, 89,  9850, 12458, 6234, 42, "gold"),
        new(2, "Marcus Rodriguez", "@mrodriguez", 198, 112, 8920,  9876, 4532, 28, "silver"),
        new(3, "Yuki Tanaka",      "@ytanaka",    176, 94,  8340,  8234, 3891, 35, "bronze"),
        new(4, "Emma Wilson",      "@ewilson",    164, 78,  7650,  7456, 3124, 21),
        new(5, "Alex Kumar",       "@akumar",     152, 86,  7280,  6892, 2987, 19),
        new(6, "Olivia Martinez",  "@omartinez",  143, 71,  6940,  6234, 2654, 14),
    ];

    private static readonly double _maxScore =
        _contributors.Length > 0 ? _contributors[0].ImpactScore : 10000;

    private void ToggleExpanded(int rank)
    {
        _expandedRank = _expandedRank == rank ? null : rank;
    }
}
