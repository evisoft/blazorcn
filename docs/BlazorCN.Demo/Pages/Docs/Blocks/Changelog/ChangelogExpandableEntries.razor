@* ============================================================
   Block: changelog-expandable-entries
   Title: ChangelogExpandableEntries
   Description: React expandable entries changelog block for Next.js with click-to-reveal details, code snippets, and chevron indicators built with TypeScript, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-expandable-entries.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="code" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">Developer Changelog</span>
        </div>

        @* Entries *@
        <div>
            @foreach (var ent in _entries)
            {
                var entry = ent;
                var isExpanded = _expandedIds.Contains(entry.Id);
                var isLast = entry.Id == _entries[^1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => ToggleEntry(entry.Id))"
                            aria-expanded="@isExpanded.ToString().ToLowerInvariant()">
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@entry.Title</span>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">@entry.Summary</p>
                        </div>
                        <div class="flex shrink-0 items-center gap-2">
                            <span class="font-mono text-[10px] text-muted-foreground/60">@entry.Version</span>
                            <span class="text-xs text-muted-foreground/60">@entry.Date</span>
                        </div>
                    </button>
                    @if (isExpanded)
                    {
                        <div class="border-t px-4 py-3">
                            <div class="rounded-md bg-muted/50 p-3">
                                <p class="text-xs leading-relaxed">@entry.Details</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ChangeEntry(string Id, string Title, string Summary, string Version, string Date, string Details);

    private static readonly ChangeEntry[] _entries =
    [
        new("1", "New streaming response API", "Server-sent events for real-time data streaming", "v2.4.0", "Mar 28",
            "The new /api/stream endpoint supports server-sent events. Replace fetch() calls with EventSource for real-time updates. Set Accept: text/event-stream header. Each event includes a JSON payload with type, data, and timestamp fields. Connection auto-reconnects on network interruption."),
        new("2", "Database connection pooling", "Automatic connection pool management with configurable limits", "v2.4.0", "Mar 28",
            "Set DATABASE_POOL_SIZE environment variable to configure max connections (default: 10). The pool automatically scales down after 30 seconds of idle time. Add DATABASE_POOL_TIMEOUT_MS to set the max wait time for a connection from the pool. Monitor pool metrics via the /api/health endpoint."),
        new("3", "Breaking: Auth token format change", "JWT tokens now use EdDSA signing instead of RS256", "v2.3.0", "Mar 22",
            "Migration required before April 15. Update your token verification to accept EdDSA signatures. The new public key is available at /.well-known/jwks.json. Existing RS256 tokens remain valid for 30 days. Set AUTH_LEGACY_TOKENS=true to extend the grace period."),
        new("4", "Fixed rate limiter bypass", "Resolved a bypass via X-Forwarded-For header spoofing", "v2.2.5", "Mar 18",
            "The rate limiter now validates the client IP from the direct connection socket rather than trusting proxy headers. If you run behind a reverse proxy, set TRUSTED_PROXIES to your proxy IP range. Rate limit headers X-RateLimit-Remaining and X-RateLimit-Reset are now always present."),
        new("5", "Improved query performance", "Added composite indexes for common query patterns", "v2.2.4", "Mar 16",
            "Added composite indexes on (workspace_id, created_at) and (user_id, status) tables. Queries filtering by workspace and date range are now 5x faster. Run the included migration to add indexes: npx prisma migrate deploy. Large tables may take several minutes to index."),
    ];

    private readonly HashSet<string> _expandedIds = [];

    private void ToggleEntry(string id)
    {
        if (!_expandedIds.Add(id))
            _expandedIds.Remove(id);
    }
}
