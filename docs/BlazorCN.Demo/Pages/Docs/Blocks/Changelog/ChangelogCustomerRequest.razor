@* ============================================================
   Block: changelog-customer-request
   Title: ChangelogCustomerRequest
   Description: React customer-requested feature tracking changelog block for Next.js with vote counts, requester avatars, request status indicators, and expandable details built with shadcn/ui, Tailwind CSS, and Framer Motion animations.
   Source: original/blocks/changelog/changelog-customer-request.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="message-square" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Customer Requests</span>
                <span class="ml-auto text-muted-foreground text-xs">@_requests.Count(r => r.Status == "shipped") shipped</span>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">Features built from your feedback</p>
        </div>

        @* Summary bar *@
        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                @_requests.Count(r => r.Status == "shipped") shipped
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-amber-500"></span>
                @_requests.Count(r => r.Status == "in-progress") building
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-blue-500"></span>
                @_requests.Count(r => r.Status == "planned") planned
            </span>
            <span class="ml-auto flex items-center gap-1 text-muted-foreground text-xs">
                <LucideIconCn Name="thumbs-up" Size="12" Class="size-3" />
                <span class="tabular-nums">@_requests.Sum(r => r.Votes)</span>
                <span>votes</span>
            </span>
        </div>

        @* Entries *@
        <div>
            @foreach (var req in _requests)
            {
                var request = req;
                var config = _statusConfig[request.Status];
                var isExpanded = _expanded == request.Id;
                var dotClass = "size-2 shrink-0 rounded-full " + config.Dot;
                var statusTextClass = "font-medium " + config.Color;
                var chevronClass = "size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200" + (isExpanded ? " rotate-90" : "");
                <div class="border-b last:border-b-0">
                    <button type="button" @onclick="@(() => Toggle(request.Id))" class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@dotClass"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@request.Title</span>
                            <div class="mt-0.5 flex items-center gap-1.5 text-xs text-muted-foreground">
                                <span class="@statusTextClass">@config.Label</span>
                                <span class="text-muted-foreground/40">&middot;</span>
                                <LucideIconCn Name="thumbs-up" Size="12" Class="size-3" />
                                <span class="tabular-nums">@request.Votes</span>
                                <span class="text-muted-foreground/40">&middot;</span>
                                <span>@request.Date</span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-3 px-4 pb-4 pl-9">
                                <p class="text-sm text-muted-foreground leading-relaxed">@request.Description</p>

                                @* Requesters *@
                                <div class="flex items-center gap-2">
                                    <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                                    <div class="flex items-center -space-x-1.5">
                                        @foreach (var requester in request.Requesters)
                                        {
                                            <div class="flex size-5 items-center justify-center rounded-full border border-card bg-muted text-[8px] font-medium" title="@requester.Name">
                                                @requester.Initials
                                            </div>
                                        }
                                    </div>
                                    <span class="text-xs text-muted-foreground">
                                        @(request.TotalRequesters > request.Requesters.Length
                                            ? $"+{request.TotalRequesters - request.Requesters.Length} others"
                                            : $"{request.TotalRequesters} requesters")
                                    </span>
                                </div>

                                @* Meta *@
                                <div class="flex items-center gap-2">
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-[10px]">@request.ShippedIn</BadgeCn>
                                    <span class="text-xs text-muted-foreground/70">@request.OriginalDate</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Requester(string Name, string Initials);

    private record CustomerRequest(
        string Id,
        string Title,
        string Description,
        string Status,
        int Votes,
        Requester[] Requesters,
        int TotalRequesters,
        string ShippedIn,
        string Date,
        string OriginalDate);

    private record StatusInfo(string Label, string Color, string Dot);

    private static readonly Dictionary<string, StatusInfo> _statusConfig = new()
    {
        ["shipped"]     = new("Shipped",     "text-emerald-600 dark:text-emerald-400", "bg-emerald-500"),
        ["in-progress"] = new("In progress", "text-amber-600 dark:text-amber-400",     "bg-amber-500"),
        ["planned"]     = new("Planned",     "text-blue-600 dark:text-blue-400",       "bg-blue-500"),
    };

    private static readonly CustomerRequest[] _requests =
    [
        new("cr-1",
            "Bulk export to CSV and PDF from any table view",
            "Export filtered and sorted table data directly to CSV or PDF. Supports column selection, custom headers, and scheduled recurring exports via email.",
            "shipped", 342,
            [new("Lydia Torres", "LT"), new("Kevin Park", "KP"), new("Mia Chen", "MC")],
            89, "v4.2.0", "Mar 30, 2026", "Requested Oct 2025"),
        new("cr-2",
            "Custom fields on contact records",
            "Define unlimited custom fields with types including text, number, date, dropdown, and multi-select. Fields are searchable and available in filters and automations.",
            "shipped", 278,
            [new("James Liu", "JL"), new("Sarah Kim", "SK")],
            64, "v4.1.0", "Mar 24, 2026", "Requested Nov 2025"),
        new("cr-3",
            "Slack integration for real-time notifications",
            "Receive notifications in Slack channels when records are created, updated, or deleted. Configure per-channel rules to control notification volume.",
            "shipped", 215,
            [new("Emma Walsh", "EW"), new("David Osei", "DO"), new("Priya Patel", "PP")],
            52, "v4.0.0", "Mar 18, 2026", "Requested Sep 2025"),
        new("cr-4",
            "Two-factor authentication with passkey support",
            "Secure accounts with TOTP authenticator apps or hardware security keys. Supports passkeys for passwordless login on compatible devices.",
            "in-progress", 189,
            [new("Alex Rivera", "AR")],
            41, "v4.3.0", "In development", "Requested Dec 2025"),
        new("cr-5",
            "API rate limit increase for enterprise plans",
            "Increase API rate limits from 100 to 1,000 requests per minute for enterprise customers. Includes burst capacity up to 2,000 RPM for batch operations.",
            "planned", 156,
            [new("Nora Schmidt", "NS"), new("Tom Baker", "TB")],
            33, "v4.4.0", "Planned Q2 2026", "Requested Jan 2026"),
    ];

    private string? _expanded;

    private void Toggle(string id)
    {
        _expanded = _expanded == id ? null : id;
    }
}
