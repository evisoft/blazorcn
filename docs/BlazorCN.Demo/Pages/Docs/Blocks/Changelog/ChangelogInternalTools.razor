@* ============================================================
   Block: changelog-internal-tools
   Title: ChangelogInternalTools
   Description: Internal tools changelog with admin-only features and access controls. Built with React, Next.js, shadcn/ui, and Tailwind CSS for internal operations dashboards.
   Source: original/blocks/changelog/changelog-internal-tools.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="wrench" Size="16" Class="size-4 text-muted-foreground" />
                </div>
                <div class="min-w-0 flex-1">
                    <h2 class="text-sm font-medium">Internal Tools Changelog</h2>
                    <p class="text-xs text-muted-foreground">
                        Admin dashboards and operational utilities
                    </p>
                </div>
                <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                    @_filteredChanges.Length changes
                </BadgeCn>
            </div>
        </div>

        @* Category Filter *@
        <div class="border-b p-4">
            <span class="text-xs font-medium text-muted-foreground">Filter by Category</span>
            <div class="mt-2 flex flex-wrap gap-2">
                <ButtonCn Variant="@(_categoryFilter == null ? ButtonVariant.Default : ButtonVariant.Outline)"
                          Size="ButtonSize.Sm"
                          Class="h-7 text-xs"
                          @onclick="@(() => _categoryFilter = null)">
                    All Tools
                </ButtonCn>
                @foreach (var cat in _categories)
                {
                    var category = cat;
                    <ButtonCn Variant="@(_categoryFilter == category ? ButtonVariant.Default : ButtonVariant.Outline)"
                              Size="ButtonSize.Sm"
                              Class="h-7 gap-1.5 text-xs capitalize"
                              @onclick="@(() => _categoryFilter = category)">
                        @category
                    </ButtonCn>
                }
            </div>
        </div>

        @* Change List *@
        <div>
            @foreach (var ch in _filteredChanges)
            {
                var change = ch;
                var isExpanded = _expandedId == change.Id;
                var config = _changeTypeConfig[change.ChangeType];
                <div class="border-b last:border-0">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => _expandedId = (isExpanded ? null : change.Id))">
                        <div class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded-md", config.Bg)">
                            <LucideIconCn Name="@config.IconName" Size="14" Class="@Cn.Merge("size-3.5", config.Color)" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@change.ToolName</span>
                                <BadgeCn Variant="BadgeVariant.Outline"
                                         Class="@Cn.Merge("text-xs", config.Color, config.Bg)">
                                    @config.Label
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">@change.Description</p>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/30 px-4 py-3">
                            <div class="space-y-3">
                                <div class="flex items-center gap-2">
                                    <BadgeCn Variant="BadgeVariant.Outline"
                                             Class="@Cn.Merge("text-xs capitalize", _categoryColors[change.Category])">
                                        @change.Category
                                    </BadgeCn>
                                    <BadgeCn Variant="BadgeVariant.Outline"
                                             Class="@Cn.Merge("text-xs capitalize", _accessLevelColors[change.AccessLevel])">
                                        <LucideIconCn Name="shield" Size="10" Class="mr-1 size-2.5" />
                                        @change.AccessLevel
                                    </BadgeCn>
                                    @if (change.ActiveUsers.HasValue)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                                            <LucideIconCn Name="users" Size="10" Class="mr-1 size-2.5" />
                                            @change.ActiveUsers active
                                        </BadgeCn>
                                    }
                                </div>

                                <div class="rounded-md bg-background p-2.5">
                                    <span class="text-xs font-medium text-muted-foreground">Impact</span>
                                    <p class="mt-1 text-xs">@change.Impact</p>
                                </div>

                                <div class="flex items-center justify-between border-t pt-2 text-xs text-muted-foreground">
                                    <span>@change.Version • @change.Author</span>
                                    <span>@change.Date</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ToolChange(
        string Id,
        string ToolName,
        string Category,
        string ChangeType,
        string Description,
        string Version,
        string Date,
        string Author,
        string AccessLevel,
        string Impact,
        int? ActiveUsers);

    private record ChangeTypeInfo(string IconName, string Color, string Bg, string Label);

    private static readonly ToolChange[] _toolChanges =
    [
        new("1", "User Management Dashboard", "admin", "new_feature",
            "Added bulk user role assignment with CSV import",
            "v3.4.0", "2026-03-28", "Alex Chen", "admin",
            "Reduced role assignment time from 2 hours to 5 minutes for large batches", 8),
        new("2", "Database Query Console", "engineering", "improvement",
            "Added query execution history and favorites",
            "v2.8.0", "2026-03-27", "Sarah Park", "engineering",
            "Improved debugging workflow; engineers save ~30min/day on repetitive queries", 42),
        new("3", "Support Ticket Analyzer", "support", "new_feature",
            "AI-powered ticket categorization and priority suggestions",
            "v1.5.0", "2026-03-26", "Marcus Rivera", "support",
            "Reduced average ticket routing time by 67%", 23),
        new("4", "Feature Flag Manager", "engineering", "improvement",
            "Added rollout percentage controls and user targeting rules",
            "v4.1.0", "2026-03-25", "Emily Zhang", "engineering",
            "Enabled gradual feature rollouts with fine-grained user targeting", 35),
        new("5", "Internal Analytics Dashboard", "analytics", "fix",
            "Fixed revenue chart timezone handling for multi-region teams",
            "v2.3.1", "2026-03-24", "David Kim", "all",
            "Eliminated reporting discrepancies across EMEA and APAC offices", 67),
        new("6", "API Key Rotator", "admin", "new_feature",
            "Automated monthly API key rotation with notification workflow",
            "v1.0.0", "2026-03-23", "Rachel Martinez", "admin",
            "Improved security posture; zero manual intervention required", 5),
        new("7", "Load Test Orchestrator", "engineering", "deprecation",
            "Deprecated Locust integration in favor of k6 native support",
            "v3.0.0", "2026-03-22", "James Wilson", "engineering",
            "Migration guide published; Locust support ends 2026-06-01", 12),
    ];

    private static readonly Dictionary<string, ChangeTypeInfo> _changeTypeConfig = new()
    {
        ["new_feature"]  = new("sparkles", "text-emerald-600", "bg-emerald-500/10", "New"),
        ["improvement"]  = new("settings",  "text-blue-600",    "bg-blue-500/10",    "Improved"),
        ["fix"]          = new("wrench",    "text-amber-600",   "bg-amber-500/10",   "Fixed"),
        ["deprecation"]  = new("shield",    "text-red-600",     "bg-red-500/10",     "Deprecated"),
    };

    private static readonly Dictionary<string, string> _categoryColors = new()
    {
        ["admin"]       = "text-purple-600 bg-purple-500/10",
        ["engineering"] = "text-blue-600 bg-blue-500/10",
        ["support"]     = "text-green-600 bg-green-500/10",
        ["analytics"]   = "text-amber-600 bg-amber-500/10",
    };

    private static readonly Dictionary<string, string> _accessLevelColors = new()
    {
        ["admin"]       = "text-red-600 bg-red-500/10",
        ["engineering"] = "text-blue-600 bg-blue-500/10",
        ["support"]     = "text-green-600 bg-green-500/10",
        ["all"]         = "text-gray-600 bg-gray-500/10",
    };

    private static readonly string[] _categories = ["admin", "engineering", "support", "analytics"];

    private string? _expandedId;
    private string? _categoryFilter;

    private ToolChange[] _filteredChanges =>
        _categoryFilter == null
            ? _toolChanges
            : _toolChanges.Where(c => c.Category == _categoryFilter).ToArray();
}
