@* ============================================================
   Block: changelog-runtime-flags
   Title: ChangelogRuntimeFlags
   Description: A changelog tracking runtime feature flags and A/B experiment assignments across releases, built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-runtime-flags.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Runtime Feature Flags</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Feature flags and A/B experiment assignments
            </p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-3 gap-4">
                <div>
                    <p class="text-xs text-muted-foreground">Active Flags</p>
                    <p class="mt-1 font-semibold tabular-nums text-2xl">
                        @_flagChanges.Count(f => f.Enabled)
                    </p>
                </div>
                <div>
                    <p class="text-xs text-muted-foreground">Experiments</p>
                    <p class="mt-1 font-semibold tabular-nums text-2xl text-purple-500">
                        @_flagChanges.Count(f => f.Type == "experiment")
                    </p>
                </div>
                <div>
                    <p class="text-xs text-muted-foreground">Full Rollout</p>
                    <p class="mt-1 font-semibold tabular-nums text-2xl text-emerald-500">
                        @_flagChanges.Count(f => f.RolloutPercentage == 100)
                    </p>
                </div>
            </div>
        </div>

        <div>
            @foreach (var fc in _flagChanges)
            {
                var flag = fc;
                var isExpanded = _expandedFlag == flag.Id;
                var isLast = flag.Id == _flagChanges[^1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => SetExpanded(flag.Id, isExpanded))">
                        <div class="flex items-center gap-2">
                            @if (flag.Type == "feature_flag")
                            {
                                <LucideIconCn Name="flag" Size="16" Class="size-4 text-blue-500" />
                            }
                            else
                            {
                                <LucideIconCn Name="flask-conical" Size="16" Class="size-4 text-purple-500" />
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-mono text-sm font-medium">@flag.Name</span>
                                @if (flag.Type == "feature_flag")
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="border-0 bg-blue-500/10 text-blue-500">feature flag</BadgeCn>
                                }
                                else
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="border-0 bg-purple-500/10 text-purple-500">experiment</BadgeCn>
                                }
                                @if (flag.Enabled)
                                {
                                    <LucideIconCn Name="toggle-right" Size="16" Class="size-4 text-emerald-500" />
                                }
                                else
                                {
                                    <LucideIconCn Name="toggle-left" Size="16" Class="size-4 text-muted-foreground/40" />
                                }
                            </div>
                            <p class="mt-1 text-sm text-muted-foreground">@flag.Description</p>
                            <div class="mt-1.5 flex items-center gap-3 text-xs text-muted-foreground">
                                <span>@flag.Timestamp</span>
                                <span class="text-muted-foreground/40">•</span>
                                <span>by @flag.Author</span>
                                <span class="text-muted-foreground/40">•</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("border-0 font-mono", flag.RolloutPercentage == 100 ? "bg-emerald-500/10 text-emerald-500" : "bg-amber-500/10 text-amber-500")">
                                    @flag.RolloutPercentage% rollout
                                </BadgeCn>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/30 px-4 py-3">
                            @if (!string.IsNullOrEmpty(flag.Targeting))
                            {
                                <div class="mb-3 rounded-md bg-card p-3">
                                    <p class="mb-1 text-xs font-medium text-muted-foreground">
                                        Targeting Rules
                                    </p>
                                    <code class="block rounded bg-muted/50 p-2 font-mono text-xs">
                                        @flag.Targeting
                                    </code>
                                </div>
                            }

                            <div class="space-y-2">
                                @foreach (var ch in flag.Changes)
                                {
                                    var change = ch;
                                    <div class="rounded-md bg-card p-3">
                                        <div class="mb-2 text-xs font-medium">@change.Field</div>
                                        <div class="grid grid-cols-2 gap-2 text-xs">
                                            <div>
                                                <span class="mb-1 block text-muted-foreground">Before</span>
                                                <code class="block rounded bg-muted/50 p-2 font-mono">
                                                    @change.Before
                                                </code>
                                            </div>
                                            <div>
                                                <span class="mb-1 block text-muted-foreground">After</span>
                                                <code class="block rounded bg-emerald-500/10 p-2 font-mono text-emerald-500">
                                                    @change.After
                                                </code>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="mt-3 flex items-center justify-end gap-2">
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs" OnClick="@(() => CopyFlagConfig(flag))">
                                    @if (_copiedId == flag.Id)
                                    {
                                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                                        <span>Copied</span>
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                                        <span>Copy Config</span>
                                    }
                                </ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <p class="text-xs text-muted-foreground">Last change: 4 hours ago</p>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Manage Flags</ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record FieldChange(string Field, string Before, string After);

    private record FlagChange(
        string Id,
        string Name,
        string Type,
        bool Enabled,
        int RolloutPercentage,
        string Timestamp,
        string Author,
        string Description,
        FieldChange[] Changes,
        string? Targeting = null);

    private static readonly FlagChange[] _flagChanges =
    [
        new("f1", "new-checkout-flow", "feature_flag", true, 25, "2026-03-30 11:30", "product-team",
            "Redesigned checkout experience with one-click payment",
            [
                new("enabled", "false", "true"),
                new("rollout_percentage", "0", "25"),
            ],
            "users.plan = 'pro' AND users.region IN ['US', 'CA']"),
        new("f2", "search-algorithm-v2", "experiment", true, 50, "2026-03-29 15:20", "sarah.chen",
            "A/B test: ML-powered relevance ranking vs traditional keyword matching",
            [
                new("variant_allocation", "control: 100%", "control: 50%, treatment: 50%"),
                new("experiment_status", "draft", "running"),
            ],
            "users.search_activity > 10/week"),
        new("f3", "dark-mode-ui", "feature_flag", true, 100, "2026-03-28 09:00", "design-team",
            "Dark mode theme support across all pages",
            [
                new("rollout_percentage", "75", "100"),
                new("targeting_rules", "beta_users", "all_users"),
            ]),
        new("f4", "ai-summary-generator", "feature_flag", false, 0, "2026-03-27 16:45", "alex.kumar",
            "AI-generated content summaries for articles",
            [
                new("enabled", "true", "false"),
                new("rollout_percentage", "10", "0"),
            ],
            "DISABLED - Cost optimization until Q2"),
        new("f5", "pricing-page-variant", "experiment", true, 50, "2026-03-26 14:00", "growth-team",
            "Testing annual plan prominence vs monthly plans",
            [
                new("experiment_start", "null", "2026-03-26"),
                new("variant_allocation", "none", "annual_first: 50%, monthly_first: 50%"),
            ],
            "users.subscription_status = 'trial'"),
    ];

    private string? _expandedFlag;
    private string? _copiedId;

    private void SetExpanded(string id, bool isExpanded)
    {
        _expandedFlag = isExpanded ? null : id;
    }

    private void CopyFlagConfig(FlagChange flag)
    {
        _copiedId = flag.Id;
    }
}
