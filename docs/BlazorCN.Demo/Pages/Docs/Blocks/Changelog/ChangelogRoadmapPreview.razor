@* ============================================================
   Block: changelog-roadmap-preview
   Title: ChangelogRoadmapPreview
   Description: A roadmap preview changelog block built with React, Next.js, shadcn/ui, and Tailwind CSS featuring planned, in-progress, and shipped status columns
   Source: original/blocks/changelog/changelog-roadmap-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="map" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Product Roadmap</h2>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto text-xs">
                @(_planned.Length + _inProgress.Length + _shipped.Length) items
            </BadgeCn>
        </div>

        @* Planned section *@
        <div class="border-b">
            <div class="flex items-center gap-2 px-4 py-2.5">
                <span class="size-1.5 rounded-full bg-amber-500"></span>
                <span class="text-xs font-medium text-muted-foreground">Planned</span>
                <span class="text-xs text-muted-foreground/60">@_planned.Length</span>
            </div>
            @foreach (var it in _planned)
            {
                var item = it;
                var isExpanded = _expandedId == item.Id;
                var isLast = item.Id == _planned[^1].Id;
                <button type="button"
                        class="@Cn.Merge("flex w-full flex-col text-left transition-colors hover:bg-muted/50", !isLast ? "border-b border-dashed border-muted" : "")"
                        @onclick="@(() => ToggleItem(item.Id))">
                    <div class="flex items-center gap-3 px-4 py-2.5">
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@item.Title</span>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Outline" Class="shrink-0 text-xs font-normal">
                            @item.Category
                        </BadgeCn>
                        <LucideIconCn Name="chevron-right" Size="14" Class="@Cn.Merge("size-3.5 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </div>
                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3">
                            <p class="text-xs text-muted-foreground">@item.Description</p>
                        </div>
                    }
                </button>
            }
        </div>

        @* In Progress section *@
        <div class="border-b">
            <div class="flex items-center gap-2 px-4 py-2.5">
                <span class="size-1.5 rounded-full bg-blue-500"></span>
                <span class="text-xs font-medium text-muted-foreground">In Progress</span>
                <span class="text-xs text-muted-foreground/60">@_inProgress.Length</span>
            </div>
            @foreach (var it in _inProgress)
            {
                var item = it;
                var isExpanded = _expandedId == item.Id;
                var isLast = item.Id == _inProgress[^1].Id;
                <button type="button"
                        class="@Cn.Merge("flex w-full flex-col text-left transition-colors hover:bg-muted/50", !isLast ? "border-b border-dashed border-muted" : "")"
                        @onclick="@(() => ToggleItem(item.Id))">
                    <div class="flex items-center gap-3 px-4 py-2.5">
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@item.Title</span>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Outline" Class="shrink-0 text-xs font-normal">
                            @item.Category
                        </BadgeCn>
                        <LucideIconCn Name="chevron-right" Size="14" Class="@Cn.Merge("size-3.5 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </div>
                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3">
                            <p class="text-xs text-muted-foreground">@item.Description</p>
                        </div>
                    }
                </button>
            }
        </div>

        @* Shipped section *@
        <div>
            <div class="flex items-center gap-2 px-4 py-2.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-xs font-medium text-muted-foreground">Shipped</span>
                <span class="text-xs text-muted-foreground/60">@_shipped.Length</span>
            </div>
            @foreach (var it in _shipped)
            {
                var item = it;
                var isExpanded = _expandedId == item.Id;
                var isLast = item.Id == _shipped[^1].Id;
                <button type="button"
                        class="@Cn.Merge("flex w-full flex-col text-left transition-colors hover:bg-muted/50", !isLast ? "border-b border-dashed border-muted" : "")"
                        @onclick="@(() => ToggleItem(item.Id))">
                    <div class="flex items-center gap-3 px-4 py-2.5">
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@item.Title</span>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Outline" Class="shrink-0 text-xs font-normal">
                            @item.Category
                        </BadgeCn>
                        <LucideIconCn Name="chevron-right" Size="14" Class="@Cn.Merge("size-3.5 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </div>
                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3">
                            <p class="text-xs text-muted-foreground">@item.Description</p>
                        </div>
                    }
                </button>
            }
        </div>

    </div>
</section>

@code {
    private record RoadmapItem(string Id, string Title, string Description, string Category);

    private static readonly RoadmapItem[] _planned =
    [
        new("p1", "Custom domain support", "Allow teams to use their own domain for published docs", "Infrastructure"),
        new("p2", "Bulk CSV import", "Import thousands of records from CSV files in one step", "Data"),
        new("p3", "SAML SSO integration", "Enterprise single sign-on via SAML 2.0 providers", "Security"),
    ];

    private static readonly RoadmapItem[] _inProgress =
    [
        new("i1", "Real-time collaboration", "Multiple users editing the same document simultaneously", "Collaboration"),
        new("i2", "Webhook event subscriptions", "Subscribe to lifecycle events and trigger external workflows", "API"),
    ];

    private static readonly RoadmapItem[] _shipped =
    [
        new("s1", "Two-factor authentication", "TOTP-based 2FA for all user accounts", "Security"),
        new("s2", "Dark mode support", "System-aware dark mode across all dashboard views", "UI"),
        new("s3", "API rate limit dashboard", "Monitor and configure API rate limits per key", "API"),
        new("s4", "Markdown export", "Export any page or collection as Markdown files", "Data"),
    ];

    private string? _expandedId;

    private void ToggleItem(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }
}
