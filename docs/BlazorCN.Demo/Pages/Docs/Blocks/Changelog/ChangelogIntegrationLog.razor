@* ============================================================
   Block: changelog-integration-log
   Title: ChangelogIntegrationLog
   Description: A changelog block showing third-party integration updates with initials badges, connection status indicators, and detailed notes about each integration change.
   Source: original/blocks/changelog/changelog-integration-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="plug" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Integration Log</h2>
            <span class="ml-auto text-xs text-muted-foreground">@_integrations.Length entries</span>
        </div>

        @* Entries *@
        <div>
            @for (int i = 0; i < _integrations.Length; i++)
            {
                var item = _integrations[i];
                var isLast = i == _integrations.Length - 1;
                var isExpanded = _expanded == item.Id;
                <div>
                    <button type="button"
                            class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", isLast ? "" : "border-b")"
                            @onclick="@(() => ToggleExpanded(item.Id))">
                        <div class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-md font-mono text-xs font-medium", _badgeColors[item.ColorIndex])">
                            @item.Initials
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@item.Name</span>
                                <span class="@Cn.Merge("rounded px-1.5 py-0.5 text-xs font-medium", StatusColor(item.Status))">
                                    @item.Status
                                </span>
                            </div>
                            <p class="mt-0.5 truncate text-xs text-muted-foreground">@item.Summary</p>
                        </div>
                        <span class="shrink-0 text-xs text-muted-foreground">@item.Date</span>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>
                    @if (isExpanded)
                    {
                        <div class="@Cn.Merge("bg-muted/50 px-4 py-3", isLast ? "" : "border-b")">
                            <p class="text-xs leading-relaxed text-muted-foreground">@item.Detail</p>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Integration(string Id, string Date, string Name, string Initials, string Status, string Summary, string Detail, int ColorIndex);

    private static readonly string[] _badgeColors =
    [
        "bg-violet-500/10 text-violet-600",
        "bg-rose-500/10 text-rose-600",
        "bg-sky-500/10 text-sky-600",
        "bg-teal-500/10 text-teal-600",
        "bg-orange-500/10 text-orange-600",
        "bg-indigo-500/10 text-indigo-600",
    ];

    private static string StatusColor(string status) => status switch
    {
        "Connected" => "bg-emerald-500/10 text-emerald-600",
        "Updated" => "bg-blue-500/10 text-blue-600",
        "Deprecated" => "bg-amber-500/10 text-amber-600",
        _ => ""
    };

    private static readonly Integration[] _integrations =
    [
        new("i1", "Mar 28, 2026", "Stripe", "ST", "Updated",
            "Upgraded to Stripe API v2026-03",
            "Migrated from API version 2025-12 to 2026-03. Updated payment intent creation flow to use the new confirmation tokens. Webhook signatures now use v2 signing.",
            0),
        new("i2", "Mar 24, 2026", "Resend", "RE", "Connected",
            "New transactional email provider",
            "Connected Resend as the primary transactional email service. Configured domains, DKIM signing, and webhook forwarding for bounce/complaint handling.",
            1),
        new("i3", "Mar 20, 2026", "SendGrid", "SG", "Deprecated",
            "Legacy email provider scheduled for removal",
            "SendGrid integration marked for deprecation. All transactional emails now route through Resend. Marketing emails will migrate by April 15, 2026. API keys will be revoked May 1.",
            2),
        new("i4", "Mar 16, 2026", "Vercel", "VC", "Updated",
            "Deploy hooks updated for monorepo support",
            "Reconfigured Vercel deploy hooks to support selective builds per package. Added path-based ignore rules to reduce unnecessary deployments by 60%.",
            3),
        new("i5", "Mar 12, 2026", "PostHog", "PH", "Connected",
            "Product analytics integration live",
            "Connected PostHog for event tracking, session replay, and feature flags. Server-side capture configured for API routes. Client-side SDK loaded lazily to avoid bundle impact.",
            4),
        new("i6", "Mar 8, 2026", "Neon", "NE", "Updated",
            "Database connection pooling reconfigured",
            "Switched from Neon's default pooler to dedicated connection pooling with PgBouncer. Connection limit raised from 50 to 200. Added read replica routing for analytics queries.",
            5),
    ];

    private string? _expanded;

    private void ToggleExpanded(string id)
    {
        _expanded = _expanded == id ? null : id;
    }
}
