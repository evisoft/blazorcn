@* ============================================================
   Block: changelog-code-owners
   Title: ChangelogCodeOwners
   Description: A code ownership tracker showing file paths, team assignments, review statistics, and approval workflows built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-code-owners.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Code Ownership</h2>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">
                Team assignments and review responsibilities
            </p>
        </div>

        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                    <p class="text-xs text-muted-foreground">Teams</p>
                </div>
                <p class="mt-1 font-semibold tabular-nums text-2xl">@_owners.Length</p>
            </div>
            <div class="border-r px-4 py-3">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="git-pull-request" Size="12" Class="size-3 text-muted-foreground" />
                    <p class="text-xs text-muted-foreground">Reviews (30d)</p>
                </div>
                <p class="mt-1 font-semibold tabular-nums text-2xl">@TotalReviews</p>
            </div>
            <div class="px-4 py-3">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                    <p class="text-xs text-muted-foreground">Pending</p>
                </div>
                <p class="mt-1 font-semibold tabular-nums text-2xl text-amber-500">@TotalPending</p>
            </div>
        </div>

        <div>
            @foreach (var ow in _owners)
            {
                var owner = ow;
                var isExpanded = _expandedOwner == owner.Id;
                var chevronClass = Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
                var fallbackClass = Cn.Merge("text-white text-xs", owner.Color);
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        @onclick="@(() => ToggleOwner(owner.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarFallbackCn Class="@fallbackClass">@owner.TeamInitials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@owner.Team</span>
                                @if (owner.PendingReviews > 0)
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 border-amber-500/20 bg-amber-500/10 text-amber-500 text-xs">@owner.PendingReviews pending</BadgeCn>
                                }
                            </div>
                            <div class="mt-0.5 flex items-center gap-3 text-xs text-muted-foreground">
                                <span>@owner.Paths.Length path patterns</span>
                                <span>·</span>
                                <span class="tabular-nums">@owner.ReviewCount reviews</span>
                                <span>·</span>
                                <span class="tabular-nums">@owner.AvgResponseTime avg</span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/30">
                            <div class="space-y-3 px-4 py-3">
                                <div>
                                    <p class="mb-2 text-xs font-medium text-muted-foreground">
                                        Owned Paths
                                    </p>
                                    <div class="space-y-1.5">
                                        @foreach (var path in owner.Paths)
                                        {
                                            <div class="flex items-center gap-2 rounded-md bg-muted/50 px-2.5 py-1.5">
                                                <LucideIconCn Name="file-code" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                                                <code class="font-mono text-xs">@path</code>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="flex gap-2">
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">View Team</ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">Review History</ButtonCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record CodeOwner(
        string Id,
        string Team,
        string TeamInitials,
        string[] Paths,
        int ReviewCount,
        string AvgResponseTime,
        int PendingReviews,
        string Color
    );

    private string? _expandedOwner;

    private int TotalReviews
    {
        get { var s = 0; foreach (var o in _owners) s += o.ReviewCount; return s; }
    }

    private int TotalPending
    {
        get { var s = 0; foreach (var o in _owners) s += o.PendingReviews; return s; }
    }

    private void ToggleOwner(string id)
    {
        _expandedOwner = _expandedOwner == id ? null : id;
    }

    private static readonly CodeOwner[] _owners =
    [
        new("frontend", "Frontend Team", "FE",
            ["app/**/*.tsx", "components/**/*", "lib/hooks/**/*"],
            247, "2.3 hours", 3, "bg-blue-500"),
        new("backend", "Backend Team", "BE",
            ["app/api/**/*", "lib/db/**/*", "prisma/**/*"],
            189, "3.1 hours", 5, "bg-emerald-500"),
        new("devops", "DevOps Team", "DO",
            [".github/**/*", "docker/**/*", "terraform/**/*"],
            92, "4.7 hours", 1, "bg-amber-500"),
        new("security", "Security Team", "SC",
            ["lib/auth/**/*", "middleware/**/*", "*.config.ts"],
            156, "1.8 hours", 2, "bg-purple-500"),
    ];
}
