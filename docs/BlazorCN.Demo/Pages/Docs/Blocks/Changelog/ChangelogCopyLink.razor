@* ============================================================
   Block: changelog-copy-link
   Title: ChangelogCopyLink
   Description: React changelog block with per-entry copy link buttons for Next.js, featuring permalink copying with CheckIcon confirmation, ghost buttons, and staggered animations built with TypeScript, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-copy-link.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="link" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Changelog</h2>
            <span class="text-xs text-muted-foreground">@_entries.Length entries</span>
        </div>

        <div>
            @for (var i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                var entryId = entry.Id;
                <div class="flex items-start justify-between gap-3 border-b px-4 py-3 last:border-b-0">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="@($"size-1.5 shrink-0 rounded-full {_typeColors[entry.Type]}")"></span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-[10px]">
                                @entry.Version
                            </BadgeCn>
                            <span class="text-xs text-muted-foreground">@entry.Date</span>
                        </div>
                        <p class="mt-1 text-sm font-medium">@entry.Title</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">@entry.Description</p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                              Class="h-7 shrink-0 gap-1.5 px-2 text-xs text-muted-foreground"
                              @onclick="@(() => HandleCopy(entryId))">
                        @if (_copiedId == entry.Id)
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                            <span>Copied</span>
                        }
                        else
                        {
                            <LucideIconCn Name="link" Size="12" Class="size-3" />
                            <span>Copy link</span>
                        }
                    </ButtonCn>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ChangelogEntry(
        string Id,
        string Version,
        string Date,
        string Title,
        string Description,
        string Type
    );

    private string? _copiedId;

    private async Task HandleCopy(string id)
    {
        _copiedId = id;
        await Task.Delay(2000);
        _copiedId = null;
        StateHasChanged();
    }

    private static readonly Dictionary<string, string> _typeColors = new()
    {
        ["feature"]     = "bg-blue-500",
        ["fix"]         = "bg-red-500",
        ["improvement"] = "bg-amber-500",
    };

    private static readonly ChangelogEntry[] _entries =
    [
        new("v2-4-0", "2.4.0", "Mar 28, 2026",
            "Team workspace collaboration",
            "Added real-time cursors, presence indicators, and shared editing for team workspaces.",
            "feature"),
        new("v2-3-3", "2.3.3", "Mar 26, 2026",
            "OAuth redirect loop fix",
            "Fixed redirect loop that occurred with SAML identity providers during SSO authentication.",
            "fix"),
        new("v2-3-2", "2.3.2", "Mar 24, 2026",
            "Faster build pipeline",
            "Improved incremental compilation reducing build times by 40% on average.",
            "improvement"),
        new("v2-3-1", "2.3.1", "Mar 22, 2026",
            "CSV export encoding",
            "Fixed non-ASCII character encoding in CSV exports for international datasets.",
            "fix"),
        new("v2-3-0", "2.3.0", "Mar 20, 2026",
            "API key scoping",
            "Introduced granular API key permissions with read, write, and admin scope levels.",
            "feature"),
        new("v2-2-5", "2.2.5", "Mar 18, 2026",
            "Sidebar persistence",
            "Fixed sidebar collapse state not persisting across page refreshes.",
            "fix"),
        new("v2-2-4", "2.2.4", "Mar 16, 2026",
            "Search indexing performance",
            "Reduced search indexing latency from 8 seconds to under 2 seconds.",
            "improvement"),
        new("v2-2-3", "2.2.3", "Mar 14, 2026",
            "Webhook delivery logs",
            "Added webhook delivery history with retry controls and payload inspection.",
            "feature"),
    ];
}
