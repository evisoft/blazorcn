@* ============================================================
   Block: changelog-release-approval-flow
   Title: ChangelogReleaseApprovalFlow
   Description: Multi-step release approval workflow with approver chain and status tracking, built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-release-approval-flow.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="git-branch" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Release v4.2.0 Approval</h2>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                @_approvedCount/@_totalStages Approved
            </BadgeCn>
        </div>

        @* Progress *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Approval Progress</span>
                    <span class="text-xs font-medium tabular-nums">@((int)Math.Round((double)_approvedCount / _totalStages * 100))%</span>
                </div>
                <div class="h-2 overflow-hidden rounded-full bg-muted/50">
                    <div
                        class="h-full bg-emerald-500 transition-all duration-500"
                        style="@(FormattableString.Invariant($"width:{(double)_approvedCount / _totalStages * 100}%"))" />
                </div>
            </div>
        </div>

        @* Approval Stages *@
        <div class="divide-y">
            @foreach (var it in _approvalStages)
            {
                var stage = it;
                <div class="px-4 py-3">
                    <div class="flex items-start gap-3">
                        @* Status Icon *@
                        <div class="@Cn.Merge("mt-0.5 rounded-full p-1", GetStatusColor(stage.Status))">
                            <LucideIconCn Name="@GetStatusIconName(stage.Status)" Size="16" Class="size-4" />
                        </div>

                        @* Content *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center justify-between gap-3">
                                <div>
                                    <h3 class="text-sm font-medium">@stage.Name</h3>
                                    <p class="mt-0.5 text-xs text-muted-foreground">@stage.Role</p>
                                </div>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("shrink-0 text-xs", GetStatusColor(stage.Status))">
                                    @stage.Status
                                </BadgeCn>
                            </div>

                            @if (stage.Status == "approved" && stage.Approver != null)
                            {
                                <div class="mt-2 flex items-center gap-2 text-xs text-muted-foreground">
                                    <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-500" />
                                    <span>
                                        Approved by <span class="font-medium">@stage.Approver</span> on @stage.Timestamp
                                    </span>
                                </div>
                            }

                            @if (stage.Status == "pending")
                            {
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-2 h-7 text-xs">
                                    Request Approval
                                </ButtonCn>
                            }

                            @if (stage.Status == "blocked" && stage.Blockers != null)
                            {
                                <div class="mt-2 rounded-md bg-red-500/10 p-2">
                                    <p class="text-xs text-red-500">@stage.Blockers</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Actions *@
        <div class="flex items-center gap-2 border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                View Details
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs" Disabled="@(_approvedCount < _totalStages)">
                Deploy Release
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record ApprovalStage(
        string Name,
        string Status,
        string? Approver,
        string Role,
        string? Timestamp,
        string? Blockers
    );

    private static readonly ApprovalStage[] _approvalStages =
    [
        new("Code Review",      "approved", "Sarah Chen", "Senior Engineer",    "2026-03-28 14:23", null),
        new("QA Testing",       "approved", "James Park", "QA Lead",            "2026-03-29 09:45", null),
        new("Security Review",  "approved", "Alex Rivera","Security Engineer",  "2026-03-29 16:12", null),
        new("Product Approval", "pending",  null,         "Product Manager",    null,               null),
        new("Release Manager",  "pending",  null,         "Release Manager",    null,               null),
    ];

    private int _approvedCount => _approvalStages.Count(s => s.Status == "approved");
    private int _totalStages => _approvalStages.Length;

    private static string GetStatusColor(string status) => status switch
    {
        "approved" => "bg-emerald-500/10 text-emerald-500",
        "pending"  => "bg-amber-500/10 text-amber-500",
        "blocked"  => "bg-red-500/10 text-red-500",
        _          => "",
    };

    private static string GetStatusIconName(string status) => status switch
    {
        "approved" => "check-circle-2",
        "pending"  => "clock",
        "blocked"  => "x-circle",
        _          => "clock",
    };
}
