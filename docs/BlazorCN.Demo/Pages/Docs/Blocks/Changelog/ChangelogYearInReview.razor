@* ============================================================
   Block: changelog-year-in-review
   Title: ChangelogYearInReview
   Description: React year in review changelog block for Next.js with annual stat numbers, quarterly highlights, and categorized entries built with TypeScript, shadcn/ui Badge, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-year-in-review.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
            <div>
                <p class="text-sm font-medium">2025 Year in Review</p>
                <p class="text-xs text-muted-foreground">A look back at what we shipped</p>
            </div>
        </div>

        <div class="flex items-center gap-6 border-b px-4 py-3">
            @foreach (var stat in _stats)
            {
                <div>
                    <p class="text-2xl font-semibold tabular-nums @stat.Color">@stat.Value</p>
                    <p class="text-xs text-muted-foreground">@stat.Label</p>
                </div>
            }
        </div>

        @for (var qi = 0; qi < _quarters.Length; qi++)
        {
            var quarter = _quarters[qi];
            var quarterIndex = qi;
            <div>
                <div class="border-b px-4 py-2">
                    <p class="text-xs font-medium text-muted-foreground uppercase tracking-wider">@quarter.Label</p>
                </div>
                @for (var ei = 0; ei < quarter.Entries.Length; ei++)
                {
                    var entry = quarter.Entries[ei];
                    var entryIndex = ei;
                    var hasBottomBorder = entryIndex < quarter.Entries.Length - 1 || quarterIndex < _quarters.Length - 1;
                    <div class="flex items-start gap-3 px-4 py-3 @(hasBottomBorder ? "border-b" : "")">
                        <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-muted-foreground/40"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <p class="text-sm font-medium">@entry.Title</p>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="@_badgeStyles[entry.Category]">@entry.Category</BadgeCn>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">@entry.Description</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record Stat(string Label, int Value, string Color);
    private record Entry(string Title, string Description, string Category);
    private record Quarter(string Label, Entry[] Entries);

    private static readonly Dictionary<string, string> _badgeStyles = new()
    {
        ["feature"] = "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-0",
        ["fix"] = "bg-red-500/10 text-red-600 dark:text-red-400 border-0",
        ["improvement"] = "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-0",
    };

    private static readonly Stat[] _stats =
    [
        new("Features", 142, "text-emerald-600 dark:text-emerald-400"),
        new("Fixes", 89, "text-red-600 dark:text-red-400"),
        new("Improvements", 47, "text-blue-600 dark:text-blue-400"),
    ];

    private static readonly Quarter[] _quarters =
    [
        new("Q1 2025",
        [
            new("Real-time collaboration engine", "Launched multiplayer editing with operational transforms and live cursors.", "feature"),
            new("Search indexing overhaul", "Rebuilt full-text search with 10x faster query times using pgvector.", "improvement"),
        ]),
        new("Q2 2025",
        [
            new("Custom workflow builder", "Visual drag-and-drop automation builder with 40+ trigger types.", "feature"),
            new("Memory leak in WebSocket pool", "Resolved connection pool exhaustion under sustained high concurrency.", "fix"),
        ]),
        new("Q3 2025",
        [
            new("AI-powered code review", "Integrated LLM-based suggestions for pull request reviews.", "feature"),
            new("Dashboard load time", "Reduced initial dashboard render from 4.2s to 1.1s with RSC streaming.", "improvement"),
        ]),
        new("Q4 2025",
        [
            new("SOC 2 Type II compliance", "Achieved SOC 2 certification with automated evidence collection.", "feature"),
            new("Webhook retry reliability", "Fixed exponential backoff logic that dropped events after 3 failures.", "fix"),
        ]),
    ];
}
