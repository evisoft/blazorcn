@* ============================================================
   Block: changelog-compliance-audit
   Title: ChangelogComplianceAudit
   Description: SOC2, HIPAA, and GDPR compliance controls with evidence status tracking. Built with React, Next.js, shadcn/ui, and Tailwind CSS for security and compliance dashboards.
   Source: original/blocks/changelog/changelog-compliance-audit.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
                </div>
                <div class="min-w-0 flex-1">
                    <h2 class="text-sm font-medium">Compliance Audit Log</h2>
                    <p class="text-xs text-muted-foreground">
                        SOC2, HIPAA, GDPR, and PCI-DSS controls
                    </p>
                </div>
            </div>
        </div>

        <div class="border-b p-4">
            <span class="text-xs font-medium text-muted-foreground">Filter by Status</span>
            <div class="mt-2 flex flex-wrap gap-2">
                <ButtonCn Variant="@(_statusFilter == null ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="@(() => _statusFilter = null)">
                    All Controls
                </ButtonCn>
                @foreach (var status in _statuses)
                {
                    var s = status;
                    <ButtonCn Variant="@(_statusFilter == s ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs capitalize" OnClick="@(() => _statusFilter = s)">
                        <span class="@Cn.Merge("size-1.5 rounded-full", GetStatusDotColor(s))"></span>
                        @s
                    </ButtonCn>
                }
            </div>
        </div>

        <div>
            @foreach (var log in GetFilteredLogs())
            {
                <div class="border-b last:border-0">
                    <div class="border-b bg-muted/30 px-4 py-2">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-medium text-muted-foreground">@log.Period</span>
                            <span class="text-xs text-muted-foreground">@log.Date</span>
                        </div>
                    </div>

                    @foreach (var control in log.Controls)
                    {
                        var ctrl = control;
                        var isExpanded = _expandedId == ctrl.Id;
                        var chevronClass = Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
                        <div>
                            <button
                                type="button"
                                @onclick="@(() => ToggleExpanded(ctrl.Id))"
                                class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                                <div class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded-md", GetStatusBg(ctrl.Status))">
                                    <LucideIconCn Name="@GetStatusIconName(ctrl.Status)" Size="14" Class="@Cn.Merge("size-3.5", GetStatusColor(ctrl.Status))" />
                                </div>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@ctrl.ControlId</span>
                                        <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("text-xs", GetFrameworkClass(ctrl.Framework))">
                                            @ctrl.Framework
                                        </BadgeCn>
                                    </div>
                                    <p class="mt-0.5 text-xs text-muted-foreground">
                                        @ctrl.ControlName
                                    </p>
                                </div>
                                <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                            </button>

                            @if (isExpanded)
                            {
                                <div class="border-t bg-muted/30 px-4 py-3">
                                    <div class="space-y-3">
                                        <div class="grid gap-2">
                                            <div>
                                                <span class="text-xs font-medium text-muted-foreground">Evidence Type</span>
                                                <p class="mt-1 text-xs">@ctrl.EvidenceType</p>
                                            </div>
                                            <div>
                                                <span class="text-xs font-medium text-muted-foreground">Evidence Status</span>
                                                <p class="mt-1 text-xs">@ctrl.EvidenceStatus</p>
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrEmpty(ctrl.Findings))
                                        {
                                            <div class="rounded-md bg-background p-2.5">
                                                <div class="mb-1 flex items-center gap-1.5">
                                                    <LucideIconCn Name="file-text" Size="12" Class="size-3 text-muted-foreground" />
                                                    <span class="text-xs font-medium">Findings</span>
                                                </div>
                                                <p class="text-xs text-muted-foreground">@ctrl.Findings</p>
                                            </div>
                                        }

                                        <div class="flex items-center justify-between border-t pt-2 text-xs text-muted-foreground">
                                            <span>Audited by @ctrl.Auditor</span>
                                            <span>@ctrl.LastAudited</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ComplianceControl(
        string Id,
        string ControlId,
        string ControlName,
        string Framework,
        string Status,
        string EvidenceType,
        string EvidenceStatus,
        string LastAudited,
        string Auditor,
        string? Findings = null
    );

    private record AuditLog(
        string Id,
        string Date,
        string Period,
        ComplianceControl[] Controls
    );

    private string? _expandedId;
    private string? _statusFilter;

    private static readonly string[] _statuses = ["passing", "failing", "pending"];

    private void ToggleExpanded(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private IEnumerable<AuditLog> GetFilteredLogs()
    {
        return _auditLogs
            .Select(log => log with
            {
                Controls = _statusFilter == null
                    ? log.Controls
                    : log.Controls.Where(c => c.Status == _statusFilter).ToArray()
            })
            .Where(log => log.Controls.Length > 0);
    }

    private static string GetStatusIconName(string status) => status switch
    {
        "passing" => "check-circle-2",
        "failing" => "x-circle",
        "pending" => "clock",
        _         => "clock",
    };

    private static string GetStatusColor(string status) => status switch
    {
        "passing" => "text-emerald-500",
        "failing" => "text-red-500",
        "pending" => "text-amber-500",
        _         => "text-muted-foreground",
    };

    private static string GetStatusBg(string status) => status switch
    {
        "passing" => "bg-emerald-500/10",
        "failing" => "bg-red-500/10",
        "pending" => "bg-amber-500/10",
        _         => "bg-muted",
    };

    private static string GetStatusDotColor(string status) => status switch
    {
        "passing" => "bg-emerald-500",
        "failing" => "bg-red-500",
        "pending" => "bg-amber-500",
        _         => "bg-muted-foreground",
    };

    private static string GetFrameworkClass(string framework) => framework switch
    {
        "SOC2"    => "text-blue-600 bg-blue-500/10",
        "HIPAA"   => "text-purple-600 bg-purple-500/10",
        "GDPR"    => "text-green-600 bg-green-500/10",
        "PCI-DSS" => "text-orange-600 bg-orange-500/10",
        _         => "",
    };

    private static readonly AuditLog[] _auditLogs =
    [
        new("1", "2026-03-28", "Q1 2026",
        [
            new("1", "CC6.1",         "Logical Access Controls",             "SOC2",    "passing", "Access logs, MFA enforcement report",           "Complete",                        "2026-03-28", "Emily Zhang"),
            new("2", "164.312(a)(1)", "Access Control Technical Safeguards", "HIPAA",   "passing", "Role-based access matrix, audit logs",          "Complete",                        "2026-03-27", "Michael Brooks"),
            new("3", "Art. 32",       "Security of Processing",              "GDPR",    "failing", "Encryption certificates, penetration test",     "Pending penetration test report", "2026-03-26", "Sophie Laurent",
                "Annual penetration test scheduled for 2026-04-15. Previous test expired 2026-03-01."),
        ]),
        new("2", "2026-03-21", "Q1 2026",
        [
            new("4", "CC7.2",   "System Monitoring",           "SOC2",    "passing", "SIEM logs, alert configuration",              "Complete",                "2026-03-21", "David Kim"),
            new("5", "Req 8.2", "Multi-Factor Authentication", "PCI-DSS", "passing", "MFA enrollment report, authentication logs",  "Complete",                "2026-03-20", "Rachel Martinez"),
            new("6", "Art. 25", "Data Protection by Design",   "GDPR",    "pending", "Privacy impact assessments, design docs",     "Awaiting privacy review", "2026-03-19", "Sophie Laurent"),
        ]),
        new("3", "2026-03-14", "Q1 2026",
        [
            new("7", "CC6.6",          "Logical Access - Removal",    "SOC2",  "passing", "Offboarding checklist, access revocation logs", "Complete", "2026-03-14", "Emily Zhang"),
            new("8", "164.308(a)(5)",  "Security Awareness Training", "HIPAA", "passing", "Training completion records, quiz results",     "Complete", "2026-03-13", "Michael Brooks"),
        ]),
    ];
}
