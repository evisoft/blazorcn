@* ============================================================
   Block: changelog-feature-request-board
   Title: ChangelogFeatureRequestBoard
   Description: A feature request voting board with request status, vote counts, and priority tracking for React and Next.js applications using shadcn/ui components and Tailwind CSS.
   Source: original/blocks/changelog/changelog-feature-request-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Feature Requests</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Community-driven feature roadmap
                    </p>
                </div>
                <BadgeCn Class="h-5 gap-1 bg-blue-500/10 text-blue-600 text-xs">
                    <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                    @_featureRequests.Length requests
                </BadgeCn>
            </div>
        </div>

        <div>
            @foreach (var request in _featureRequests)
            {
                var req = request;
                var isExpanded = _expandedRequest == req.Id;
                var hasVoted = _votedRequests.Contains(req.Id);
                var voteButtonClass = Cn.Merge(
                    "flex size-8 items-center justify-center rounded-md border transition-colors",
                    hasVoted ? "border-blue-500 bg-blue-500/10 text-blue-600" : "border-border hover:bg-muted/50");
                var voteCountClass = Cn.Merge(
                    "font-semibold tabular-nums text-xs",
                    hasVoted ? "text-blue-600" : "text-muted-foreground");
                var chevronClass = Cn.Merge(
                    "size-4 text-muted-foreground/60 transition-transform duration-200",
                    isExpanded ? "rotate-90" : "");
                var statusBadgeClass = Cn.Merge("h-5 text-xs", GetStatusBadgeClass(req.Status));
                var priorityBadgeClass = Cn.Merge("h-4 text-xs", GetPriorityBadgeClass(req.Priority));
                var displayVotes = req.Votes + (hasVoted ? 1 : 0);
                var statusText = req.Status.Replace("-", " ");
                var statusIcon = req.Status switch
                {
                    "completed"   => (Name: "check-circle-2", Class: "size-4 text-emerald-500"),
                    "in-progress" => (Name: "circle-dot",     Class: "size-4 text-blue-500"),
                    "planned"     => (Name: "clock",          Class: "size-4 text-amber-500"),
                    _             => (Name: "lightbulb",      Class: "size-4 text-muted-foreground/60"),
                };
                var statusDescription = req.Status switch
                {
                    "in-progress" => "Currently being developed",
                    "planned"     => "Scheduled for upcoming release",
                    "completed"   => "Feature has been released",
                    _             => "Under team review",
                };
                <div class="border-b last:border-b-0">
                    <div class="flex items-start gap-3 px-4 py-3">
                        <div class="flex shrink-0 flex-col items-center gap-1">
                            <button
                                type="button"
                                @onclick="@(() => HandleVote(req.Id))"
                                class="@voteButtonClass">
                                <LucideIconCn Name="thumbs-up" Size="16" Class="size-4" />
                            </button>
                            <span class="@voteCountClass">
                                @displayVotes
                            </span>
                        </div>

                        <div class="min-w-0 flex-1">
                            <button
                                type="button"
                                @onclick="@(() => ToggleExpanded(req.Id))"
                                class="w-full text-left">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-2">
                                            <span class="text-sm font-medium">@req.Title</span>
                                            <BadgeCn Class="@statusBadgeClass">
                                                @statusText
                                            </BadgeCn>
                                        </div>
                                        <p class="mt-0.5 text-xs text-muted-foreground">
                                            @req.Description
                                        </p>
                                        <div class="mt-1.5 flex items-center gap-2">
                                            <BadgeCn Class="@priorityBadgeClass">
                                                @req.Priority
                                            </BadgeCn>
                                            <BadgeCn Class="h-4 bg-muted/50 text-muted-foreground text-xs">
                                                @req.Category
                                            </BadgeCn>
                                            <span class="text-xs text-muted-foreground">
                                                by @req.Author
                                            </span>
                                            <span class="text-xs text-muted-foreground">
                                                • @req.CreatedAt
                                            </span>
                                        </div>
                                    </div>
                                    <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                                </div>
                            </button>

                            @if (isExpanded)
                            {
                                <div class="mt-3 space-y-2 border-t pt-3">
                                    <div class="flex items-center gap-3">
                                        <div class="flex size-5 items-center justify-center">
                                            <LucideIconCn Name="@statusIcon.Name" Size="16" Class="@statusIcon.Class" />
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <div class="text-xs font-medium">Current Status</div>
                                            <div class="text-xs text-muted-foreground">
                                                @statusDescription
                                            </div>
                                        </div>
                                    </div>
                                    <div class="flex gap-2">
                                        <ButtonCn Variant="ButtonVariant.Outline" Class="h-6 flex-1 gap-1 text-xs">
                                            <LucideIconCn Name="message-square" Size="12" Class="size-3" />
                                            @req.Comments comments
                                        </ButtonCn>
                                        <ButtonCn Variant="ButtonVariant.Outline" Class="h-6 text-xs">
                                            Subscribe
                                        </ButtonCn>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record FeatureRequest(
        string Id,
        string Title,
        string Description,
        string Author,
        int Votes,
        int Comments,
        string Status,
        string Priority,
        string Category,
        string CreatedAt
    );

    private string? _expandedRequest;
    private readonly HashSet<string> _votedRequests = [];

    private void HandleVote(string requestId)
    {
        if (!_votedRequests.Add(requestId))
            _votedRequests.Remove(requestId);
    }

    private void ToggleExpanded(string id)
    {
        _expandedRequest = _expandedRequest == id ? null : id;
    }

    private static string GetStatusBadgeClass(string status) => status switch
    {
        "completed"    => "bg-emerald-500/10 text-emerald-600",
        "in-progress"  => "bg-blue-500/10 text-blue-600",
        "planned"      => "bg-amber-500/10 text-amber-600",
        _              => "bg-muted/50 text-muted-foreground",
    };

    private static string GetPriorityBadgeClass(string priority) => priority switch
    {
        "high"   => "bg-red-500/10 text-red-600",
        "medium" => "bg-amber-500/10 text-amber-600",
        _        => "bg-blue-500/10 text-blue-600",
    };

    private static readonly FeatureRequest[] _featureRequests =
    [
        new("req-1", "Dark mode theme selector",
            "Add ability to choose between multiple dark mode themes with different accent colors",
            "sarah_dev", 247, 18, "in-progress", "high", "UI", "2 days ago"),
        new("req-2", "Keyboard shortcuts customization",
            "Allow users to customize keyboard shortcuts for common actions",
            "alex_designer", 189, 12, "planned", "medium", "UX", "5 days ago"),
        new("req-3", "Bulk export to CSV",
            "Export multiple items at once to CSV format with customizable columns",
            "mike_pm", 156, 9, "planned", "high", "Features", "1 week ago"),
        new("req-4", "Real-time collaboration",
            "Enable multiple users to work on the same document simultaneously",
            "emma_ux", 143, 24, "under-review", "high", "Collaboration", "1 week ago"),
        new("req-5", "Advanced search filters",
            "Add date range, tags, and custom field filters to search functionality",
            "james_user", 98, 7, "completed", "medium", "Search", "2 weeks ago"),
        new("req-6", "Mobile app notifications",
            "Push notifications for important updates and mentions",
            "lisa_mobile", 87, 15, "planned", "low", "Mobile", "2 weeks ago"),
    ];
}
