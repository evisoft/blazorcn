@* ============================================================
   Block: changelog-error-rate-comparison
   Title: ChangelogErrorRateComparison
   Description: Error rate comparison before and after release with sparkline trend charts. Built with React, Next.js, shadcn/ui, and Tailwind CSS for reliability monitoring dashboards.
   Source: original/blocks/changelog/changelog-error-rate-comparison.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="activity" Size="16" Class="size-4 text-muted-foreground" />
                </div>
                <div class="min-w-0 flex-1">
                    <h2 class="text-sm font-medium">Error Rate Comparison</h2>
                    <p class="text-xs text-muted-foreground">Before/after deployment analysis</p>
                </div>
            </div>
        </div>

        @* Filter by error type *@
        <div class="border-b p-4">
            <span class="text-xs font-medium text-muted-foreground">Filter by Error Type</span>
            <div class="mt-2 flex flex-wrap gap-2">
                <ButtonCn Variant="@(_selectedType == null ? ButtonVariant.Default : ButtonVariant.Outline)"
                          Size="ButtonSize.Sm"
                          Class="h-7 text-xs"
                          OnClick="@(() => _selectedType = null)">
                    All Errors
                </ButtonCn>
                @foreach (var type in _errorTypes)
                {
                    var t = type;
                    var iconName = GetErrorIconName(t);
                    var label = GetTypeLabel(t);
                    <ButtonCn Variant="@(_selectedType == t ? ButtonVariant.Default : ButtonVariant.Outline)"
                              Size="ButtonSize.Sm"
                              Class="h-7 gap-1.5 text-xs"
                              OnClick="@(() => _selectedType = t)">
                        <LucideIconCn Name="@iconName" Size="12" Class="size-3" />
                        @label
                    </ButtonCn>
                }
            </div>
        </div>

        @* Release list *@
        <div>
            @foreach (var rel in GetFilteredReleases())
            {
                var release = rel;
                <div class="border-b last:border-0 p-4">
                    <div class="mb-3 flex items-center justify-between">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-mono text-sm font-medium">@release.Version</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                                    @release.Metrics.Length metrics
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                @release.Date &bull; @release.DeploymentTime
                            </p>
                        </div>
                    </div>

                    <div class="space-y-3">
                        @foreach (var met in release.Metrics)
                        {
                            var metric = met;
                            var isImproved = metric.Impact == "improved";
                            var metIconName = GetErrorIconName(metric.Type);
                            var trendIconName = isImproved ? "trending-down" : "trending-up";
                            var trendClass = Cn.Merge("flex items-center gap-1", isImproved ? "text-emerald-500" : "text-red-500");
                            var sparklineStrokeClass = isImproved ? "text-emerald-500" : "text-red-500";
                            var sparklinePath = GenerateSparkline(metric.Trend);
                            var changeSign = metric.Change > 0 ? "+" : "";
                            var changeFormatted = metric.Change.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
                            var beforeFormatted = FormatRate(metric.BeforeRate);
                            var afterFormatted = FormatRate(metric.AfterRate);
                            <div class="rounded-md border bg-background p-3">
                                <div class="mb-2 flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        <LucideIconCn Name="@metIconName" Size="14" Class="size-3.5 text-muted-foreground" />
                                        <span class="text-xs font-medium">@metric.Name</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <svg width="60" height="20" class="opacity-50" aria-label="Sparkline trend">
                                            <title>Sparkline trend</title>
                                            <path d="@sparklinePath"
                                                  fill="none"
                                                  stroke="currentColor"
                                                  stroke-width="1.5"
                                                  class="@sparklineStrokeClass" />
                                        </svg>
                                    </div>
                                </div>

                                <div class="flex items-center justify-between">
                                    <div class="space-y-1">
                                        <div class="text-xs text-muted-foreground">
                                            Before: @beforeFormatted@metric.Unit
                                        </div>
                                        <div class="text-xs text-muted-foreground">
                                            After: @afterFormatted@metric.Unit
                                        </div>
                                    </div>
                                    <div class="@trendClass">
                                        <LucideIconCn Name="@trendIconName" Size="16" Class="size-4" />
                                        <span class="font-mono text-sm font-semibold tabular-nums">
                                            @changeSign@changeFormatted%
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(release.Notes))
                    {
                        <div class="mt-3 rounded-md bg-muted/50 p-2.5">
                            <p class="text-xs text-muted-foreground">@release.Notes</p>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ErrorMetric(
        string Type,
        string Name,
        double BeforeRate,
        double AfterRate,
        string Unit,
        double Change,
        double[] Trend,
        string Impact
    );

    private record Release(
        string Id,
        string Version,
        string Date,
        string DeploymentTime,
        ErrorMetric[] Metrics,
        string Notes
    );

    private string? _selectedType;

    private static readonly string[] _errorTypes = ["4xx", "5xx", "exception", "timeout"];

    private static readonly Release[] _releases =
    [
        new("1", "v2.8.0", "2026-03-28", "14:23 UTC",
            [
                new("5xx", "Server Errors", 0.42, 0.18, "%", -57.1,
                    [0.45, 0.43, 0.42, 0.38, 0.25, 0.18, 0.18], "improved"),
                new("4xx", "Client Errors", 2.1, 2.3, "%", 9.5,
                    [2.0, 2.1, 2.1, 2.2, 2.3, 2.3, 2.3], "degraded"),
                new("exception", "Unhandled Exceptions", 12, 5, "/hour", -58.3,
                    [14, 13, 12, 10, 7, 5, 5], "improved"),
            ],
            "Database query optimization reduced 5xx errors; input validation tightened causing minor 4xx increase"),
        new("2", "v2.7.5", "2026-03-21", "09:15 UTC",
            [
                new("timeout", "Request Timeouts", 0.8, 0.3, "%", -62.5,
                    [0.9, 0.8, 0.8, 0.6, 0.4, 0.3, 0.3], "improved"),
                new("5xx", "Server Errors", 0.45, 0.42, "%", -6.7,
                    [0.46, 0.45, 0.45, 0.44, 0.43, 0.42, 0.42], "improved"),
            ],
            "Increased API timeout from 10s to 15s; minor improvements from cache warming"),
        new("3", "v2.7.0", "2026-03-14", "16:44 UTC",
            [
                new("4xx", "Client Errors", 2.3, 2.1, "%", -8.7,
                    [2.4, 2.3, 2.3, 2.2, 2.1, 2.1, 2.1], "improved"),
                new("exception", "Unhandled Exceptions", 18, 12, "/hour", -33.3,
                    [20, 19, 18, 16, 14, 12, 12], "improved"),
                new("5xx", "Server Errors", 0.38, 0.45, "%", 18.4,
                    [0.38, 0.38, 0.4, 0.42, 0.44, 0.45, 0.45], "degraded"),
            ],
            "Error handling improvements reduced exceptions; database migration caused temporary 5xx spike"),
    ];

    private IEnumerable<Release> GetFilteredReleases()
    {
        return _releases
            .Select(r => r with
            {
                Metrics = _selectedType == null
                    ? r.Metrics
                    : r.Metrics.Where(m => m.Type == _selectedType).ToArray()
            })
            .Where(r => r.Metrics.Length > 0);
    }

    private static string GetErrorIconName(string type) => type switch
    {
        "4xx"       => "alert-triangle",
        "5xx"       => "x-circle",
        "exception" => "zap-off",
        "timeout"   => "clock",
        _           => "activity",
    };

    private static string GetTypeLabel(string type) => type switch
    {
        "4xx"       => "4XX",
        "5xx"       => "5XX",
        "exception" => "Exception",
        "timeout"   => "Timeout",
        _           => type,
    };

    private static string FormatRate(double v) =>
        v.ToString("G", System.Globalization.CultureInfo.InvariantCulture);

    private static string GenerateSparkline(double[] data, int width = 60, int height = 20)
    {
        if (data.Length < 2) return "";
        var max = data.Max();
        var min = data.Min();
        var range = max - min;
        if (range == 0) range = 1;

        var points = data.Select((value, index) =>
        {
            var x = (index / (double)(data.Length - 1)) * width;
            var y = height - ((value - min) / range) * height;
            return $"{x:F2},{y:F2}";
        });

        return $"M {string.Join(" L ", points)}";
    }
}
