@* ============================================================
   Block: changelog-feature-sunset
   Title: ChangelogFeatureSunset
   Description: Feature deprecation timeline showing phases from announcement to removal. Built with React, Next.js, shadcn/ui, and Tailwind CSS for product roadmap dashboards.
   Source: original/blocks/changelog/changelog-feature-sunset.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="sunset" Size="16" Class="size-4 text-muted-foreground" />
                </div>
                <div class="min-w-0 flex-1">
                    <h2 class="text-sm font-medium">Feature Sunset Timeline</h2>
                    <p class="text-xs text-muted-foreground">
                        Deprecation schedule and migration paths
                    </p>
                </div>
                <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                    @_sunsetFeatures.Length features
                </BadgeCn>
            </div>
        </div>

        @* Breaking changes notice *@
        <div class="border-b bg-amber-500/5 px-4 py-3">
            <div class="flex items-start gap-2">
                <LucideIconCn Name="alert-triangle" Size="16" Class="mt-0.5 size-4 shrink-0 text-amber-600" />
                <div>
                    <p class="text-xs font-medium text-amber-900 dark:text-amber-100">
                        Breaking Changes Notice
                    </p>
                    <p class="mt-0.5 text-xs text-amber-700 dark:text-amber-200">
                        @_totalImpacted.ToString("N0") users affected by upcoming deprecations
                    </p>
                </div>
            </div>
        </div>

        @* Feature list *@
        <div>
            @foreach (var feature in _sunsetFeatures)
            {
                var feat = feature;
                var isExpanded = _expandedId == feat.Id;
                var currentPhase = feat.Timeline[feat.Timeline.Length - 1];
                var removedPhase = feat.Timeline.FirstOrDefault(t => t.Phase == "removed");
                var categoryClass = Cn.Merge("text-xs capitalize", GetCategoryColors(feat.Category));
                var phaseBadgeClass = Cn.Merge("text-xs", GetPhaseColor(currentPhase.Phase), GetPhaseBg(currentPhase.Phase));
                var chevronClass = Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
                <div class="border-b last:border-0">
                    <button
                        type="button"
                        @onclick="@(() => _expandedId = isExpanded ? null : feat.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                    >
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@feat.FeatureName</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="@categoryClass">
                                    @feat.Category
                                </BadgeCn>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="@phaseBadgeClass">
                                    @GetPhaseLabel(currentPhase.Phase)
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                @feat.ImpactedUsers.ToString("N0") users • Final removal @(removedPhase?.Date ?? "")
                            </p>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/30 px-4 py-3">
                            <div class="space-y-3">

                                <div>
                                    <span class="text-xs font-medium text-muted-foreground">
                                        Reason for Deprecation
                                    </span>
                                    <p class="mt-1 text-xs">@feat.Reason</p>
                                </div>

                                <div>
                                    <span class="text-xs font-medium text-muted-foreground">
                                        Replacement
                                    </span>
                                    <div class="mt-1 flex items-center gap-2 text-xs">
                                        <span class="line-through text-muted-foreground">
                                            @feat.FeatureName
                                        </span>
                                        <LucideIconCn Name="arrow-right" Size="12" Class="size-3 text-muted-foreground" />
                                        <span class="font-medium">@feat.Replacement</span>
                                    </div>
                                </div>

                                <div>
                                    <span class="text-xs font-medium text-muted-foreground">Timeline</span>
                                    <div class="mt-2 space-y-2">
                                        @foreach (var tp in feat.Timeline)
                                        {
                                            var dotWrapClass = Cn.Merge("mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full", GetPhaseBg(tp.Phase));
                                            var dotClass = Cn.Merge("size-1.5 rounded-full", GetPhaseDotColor(tp.Phase));
                                            <div class="flex items-start gap-3 rounded-md bg-background p-2.5">
                                                <div class="@dotWrapClass">
                                                    <span class="@dotClass" />
                                                </div>
                                                <div class="min-w-0 flex-1">
                                                    <div class="flex items-center gap-2">
                                                        <span class="text-xs font-medium">
                                                            @GetPhaseLabel(tp.Phase)
                                                        </span>
                                                        <span class="text-xs text-muted-foreground">
                                                            @tp.Date
                                                        </span>
                                                    </div>
                                                    <p class="mt-0.5 text-xs text-muted-foreground">
                                                        @tp.Description
                                                    </p>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>

                                @if (feat.MigrationGuide != null)
                                {
                                    <div class="rounded-md bg-blue-500/10 p-2.5">
                                        <div class="flex items-center gap-1.5">
                                            <LucideIconCn Name="calendar" Size="12" Class="size-3 text-blue-600" />
                                            <span class="text-xs font-medium text-blue-600">
                                                Migration Guide
                                            </span>
                                        </div>
                                        <p class="mt-1 font-mono text-xs text-blue-700 dark:text-blue-400">
                                            @feat.MigrationGuide
                                        </p>
                                    </div>
                                }

                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record TimelinePhase(
        string Phase,
        string Date,
        string Description
    );

    private record FeatureSunset(
        string Id,
        string FeatureName,
        string Category,
        TimelinePhase[] Timeline,
        string Replacement,
        int ImpactedUsers,
        string Reason,
        string? MigrationGuide = null
    );

    private string? _expandedId = null;

    private static readonly FeatureSunset[] _sunsetFeatures =
    [
        new("1", "Legacy REST API v1", "api",
            [
                new("announced",          "2025-12-01", "Sunset announcement published"),
                new("deprecated",         "2026-03-01", "API marked deprecated, warning headers added"),
                new("migration_deadline", "2026-06-01", "Final migration deadline"),
                new("removed",            "2026-07-01", "API endpoints removed"),
            ],
            "REST API v2 with GraphQL support",
            1247,
            "Performance bottlenecks and lack of filtering capabilities",
            "/docs/api/v1-to-v2-migration"),

        new("2", "Classic Dashboard UI", "ui",
            [
                new("announced",          "2026-01-15", "New dashboard UI released, classic UI sunset announced"),
                new("deprecated",         "2026-04-01", "Classic UI hidden behind feature flag"),
                new("migration_deadline", "2026-09-01", "All users must migrate to new dashboard"),
                new("removed",            "2026-10-01", "Classic UI code removed"),
            ],
            "Modern Dashboard with real-time updates",
            892,
            "Outdated design system and poor mobile experience"),

        new("3", "Zapier Integration v1", "integration",
            [
                new("announced",  "2026-02-01", "Zapier partnership ending, self-hosted alternative announced"),
                new("deprecated", "2026-05-01", "Integration disabled for new users"),
                new("removed",    "2026-08-01", "Integration fully removed"),
            ],
            "Native webhooks and n8n integration",
            234,
            "High maintenance cost for low usage feature",
            "/docs/integrations/zapier-to-webhooks"),

        new("4", "Email-based Approval Workflow", "workflow",
            [
                new("announced",  "2026-03-15", "In-app approval system launched"),
                new("deprecated", "2026-06-15", "Email approvals disabled for new workflows"),
                new("removed",    "2026-12-01", "Email approval system removed"),
            ],
            "In-app approval dashboard with Slack notifications",
            445,
            "Security concerns and poor audit trail"),
    ];

    private static readonly int _totalImpacted = 1247 + 892 + 234 + 445;

    private static string GetPhaseColor(string phase) => phase switch
    {
        "announced"          => "text-blue-600",
        "deprecated"         => "text-amber-600",
        "migration_deadline" => "text-orange-600",
        "removed"            => "text-red-600",
        _                    => "",
    };

    private static string GetPhaseBg(string phase) => phase switch
    {
        "announced"          => "bg-blue-500/10",
        "deprecated"         => "bg-amber-500/10",
        "migration_deadline" => "bg-orange-500/10",
        "removed"            => "bg-red-500/10",
        _                    => "",
    };

    private static string GetPhaseLabel(string phase) => phase switch
    {
        "announced"          => "Announced",
        "deprecated"         => "Deprecated",
        "migration_deadline" => "Deadline",
        "removed"            => "Removed",
        _                    => phase,
    };

    private static string GetPhaseDotColor(string phase) => phase switch
    {
        "announced"          => "bg-blue-600",
        "deprecated"         => "bg-amber-600",
        "migration_deadline" => "bg-orange-600",
        "removed"            => "bg-red-600",
        _                    => "",
    };

    private static string GetCategoryColors(string category) => category switch
    {
        "api"         => "text-purple-600 bg-purple-500/10",
        "ui"          => "text-blue-600 bg-blue-500/10",
        "integration" => "text-green-600 bg-green-500/10",
        "workflow"    => "text-amber-600 bg-amber-500/10",
        _             => "",
    };
}
