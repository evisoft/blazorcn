@* ============================================================
   Block: changelog-ai-risk-assessment
   Title: ChangelogAiRiskAssessment
   Description: An AI-powered risk assessment changelog analyzing changes with severity scoring and impact predictions using React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-ai-risk-assessment.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="brain" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">AI Risk Assessment</h2>
                <BadgeCn Variant="BadgeVariant.Outline" Class="ml-auto text-xs">
                    v3.2.1 → Production
                </BadgeCn>
            </div>
        </div>

        <div class="border-b bg-muted/50 px-4 py-4">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs text-muted-foreground">Overall Risk Score</p>
                    <div class="mt-1 flex items-baseline gap-2">
                        <span class="text-2xl font-semibold tabular-nums text-amber-500">
                            @_overallScore
                        </span>
                        <span class="text-sm text-muted-foreground">/ 100</span>
                    </div>
                </div>
                <div class="text-right">
                    <p class="text-xs text-muted-foreground">Recommendation</p>
                    <BadgeCn Variant="BadgeVariant.Outline" Class="mt-1 bg-amber-500/10 text-amber-500">
                        Review Required
                    </BadgeCn>
                </div>
            </div>

            <div class="mt-3">
                <div class="mb-1 flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Risk Level</span>
                </div>
                <div class="h-2 overflow-hidden rounded-full bg-muted">
                    <div class="@_progressBarClass" style="@($"width:{_overallScore}%")"></div>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-sm font-medium">Risk Factors Detected</span>
                <div class="flex items-center gap-2 text-xs">
                    <div class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        <span>@_highRisk High</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        <span>@_mediumRisk Medium</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="max-h-96 overflow-y-auto">
            @foreach (var factor in _riskFactors)
            {
                var isExpanded = _expandedId == factor.Id;
                var iconName = GetCategoryIconName(factor.Category);
                var severityDotClass = Cn.Merge("size-1.5 rounded-full", GetSeverityColor(factor.Severity));
                var badgeClass = Cn.Merge("shrink-0 text-xs", GetSeverityBadgeClass(factor.Severity));
                var chevronClass = Cn.Merge("size-4 shrink-0 text-muted-foreground transition-transform duration-200", isExpanded ? "rotate-180" : "");
                <div class="border-b last:border-b-0">
                    <button
                        type="button"
                        @onclick="@(() => ToggleExpanded(factor.Id))"
                        class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex shrink-0 items-center gap-2 pt-0.5">
                            <span class="@severityDotClass"></span>
                            <LucideIconCn Name="@iconName" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-start justify-between gap-2">
                                <div>
                                    <p class="text-sm font-medium">@factor.Category</p>
                                    <p class="mt-0.5 text-sm text-muted-foreground">@factor.Description</p>
                                </div>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="@badgeClass">
                                    @GetSeverityLabel(factor.Severity)
                                </BadgeCn>
                            </div>
                            <div class="mt-2 flex items-center gap-3 text-xs text-muted-foreground">
                                <span>@factor.Confidence% confidence</span>
                                <span>•</span>
                                <span>@factor.AffectedFiles files</span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-down" Size="16" Class="@chevronClass" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/50 px-4 py-3">
                            <div>
                                <p class="text-xs font-medium text-muted-foreground">
                                    Recommended Mitigation
                                </p>
                                <p class="mt-1 rounded-md bg-card p-3 text-sm">@factor.Mitigation</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1 gap-1.5 text-xs">
                    <LucideIconCn Name="users" Size="14" Class="size-3.5" />
                    Request review
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1 gap-1.5 text-xs">
                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5" />
                    Override and deploy
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record RiskFactor(
        string Id,
        string Category,
        string Description,
        string Severity,
        int Confidence,
        int AffectedFiles,
        string Mitigation
    );

    private string? _expandedId;
    private int _overallScore = 68;

    private int _highRisk => _riskFactors.Count(f => f.Severity == "high");
    private int _mediumRisk => _riskFactors.Count(f => f.Severity == "medium");

    private string _progressBarClass => Cn.Merge(
        "h-full",
        _overallScore >= 80 ? "bg-red-500" : _overallScore >= 50 ? "bg-amber-500" : "bg-emerald-500"
    );

    private void ToggleExpanded(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private static string GetCategoryIconName(string category) => category switch
    {
        "Database Schema"     => "database",
        "API Breaking Change" => "file-code",
        "Performance"         => "trending-up",
        "Dependencies"        => "shield-alert",
        "Test Coverage"       => "check-circle-2",
        _                     => "alert-triangle",
    };

    private static string GetSeverityColor(string severity) => severity switch
    {
        "low"    => "bg-blue-500",
        "medium" => "bg-amber-500",
        "high"   => "bg-red-500",
        _        => "bg-gray-500",
    };

    private static string GetSeverityLabel(string severity) => severity switch
    {
        "low"    => "Low",
        "medium" => "Medium",
        "high"   => "High",
        _        => severity,
    };

    private static string GetSeverityBadgeClass(string severity) => severity switch
    {
        "high"   => "bg-red-500/10 text-red-500",
        "medium" => "bg-amber-500/10 text-amber-500",
        _        => "",
    };

    private static readonly RiskFactor[] _riskFactors =
    [
        new("1", "Database Schema",     "Migration adds non-nullable column without default value", "high",   92, 3, "Add default value or make column nullable"),
        new("2", "API Breaking Change", "Removed deprecated endpoint still used by mobile apps",    "high",   88, 7, "Coordinate with mobile team before deployment"),
        new("3", "Performance",         "New query missing index on frequently accessed table",     "medium", 76, 2, "Add database index before deploying to production"),
        new("4", "Dependencies",        "Updated library has known security vulnerability",         "medium", 95, 1, "Update to patched version or add WAF rule"),
        new("5", "Test Coverage",       "Critical path missing unit tests",                         "medium", 68, 5, "Add tests for payment processing logic"),
    ];
}
