@* ============================================================
   Block: changelog-user-migration
   Title: ChangelogUserMigration
   Description: A user migration progress changelog block built with React, Next.js, shadcn/ui, and Tailwind CSS showing system-to-system migration status with progress bars, user counts, and phase tracking
   Source: original/blocks/changelog/changelog-user-migration.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">User Migration</h2>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto text-[10px]">
                @_phases.Length phases
            </BadgeCn>
        </div>

        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="font-semibold text-2xl tabular-nums text-blue-600 dark:text-blue-400">
                    @_overallPercent%
                </span>
                <span class="text-xs text-muted-foreground">overall</span>
            </div>
            <span class="text-xs text-muted-foreground/50">&middot;</span>
            <span class="text-xs text-muted-foreground tabular-nums">
                @_totalMigrated.ToString("N0") / @_totalUsers.ToString("N0") users
            </span>
            <div class="ml-auto flex items-center gap-3">
                @foreach (var s in _statusKeys)
                {
                    var sk = s;
                    var count = _phases.Count(p => p.Status == sk);
                    var dotClass = Cn.Merge("size-1.5 rounded-full", GetStatusDotClass(sk));
                    <span class="flex items-center gap-1 text-[10px] text-muted-foreground">
                        <span class="@dotClass"></span>
                        @count
                    </span>
                }
            </div>
        </div>

        <div>
            @for (int i = 0; i < _phases.Length; i++)
            {
                var phase = _phases[i];
                var isLast = i == _phases.Length - 1;
                var isExpanded = _expanded == phase.Id;
                var rowDivClass = Cn.Merge(isLast ? "" : "border-b");
                var chevronClass = Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
                var dotClass = Cn.Merge("size-1.5 shrink-0 rounded-full", GetStatusDotClass(phase.Status));
                var barClass = Cn.Merge(
                    "h-1.5 rounded-full transition-all",
                    phase.Status == "failed" ? "bg-red-400/60" : "bg-blue-400/60",
                    phase.Status == "completed" ? "bg-emerald-400/60" : "");
                <div class="@rowDivClass">
                    <button
                        type="button"
                        @onclick="@(() => Toggle(phase.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@dotClass"></span>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@phase.PhaseName</span>
                            <div class="mt-0.5 flex items-center gap-1.5">
                                <span class="text-xs text-muted-foreground">@phase.SourceSystem</span>
                                <LucideIconCn Name="arrow-right" Size="12" Class="size-3 text-muted-foreground/50" />
                                <span class="text-xs text-muted-foreground">@phase.TargetSystem</span>
                            </div>
                            <div class="mt-1.5 flex items-center gap-2">
                                <div class="h-1.5 w-24 rounded-full bg-muted">
                                    <div class="@barClass" style="@($"width:{phase.PercentComplete}%")"></div>
                                </div>
                                <span class="text-[10px] text-muted-foreground tabular-nums">@phase.PercentComplete%</span>
                                <span class="text-[10px] text-muted-foreground/50">&middot;</span>
                                <span class="text-[10px] text-muted-foreground tabular-nums">
                                    @phase.MigratedUsers.ToString("N0") / @phase.TotalUsers.ToString("N0")
                                </span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                    </button>

                    @if (isExpanded)
                    {
                        var statusIconName = GetStatusIconName(phase.Status);
                        var statusLabelClass = Cn.Merge("text-xs font-medium capitalize", GetStatusLabelClass(phase.Status));
                        var statusIconClass = Cn.Merge("size-3.5", GetStatusLabelClass(phase.Status));
                        <div class="border-t bg-muted/30 px-4 py-3 pl-9">
                            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                                <span>Started @phase.StartDate</span>
                                <span class="text-muted-foreground/50">&middot;</span>
                                <span>Est. complete @phase.EstimatedEnd</span>
                            </div>

                            <div class="mt-3 space-y-1">
                                @foreach (var step in phase.Steps)
                                {
                                    var st = step;
                                    var stepIconName = GetStatusIconName(st.Status);
                                    var stepIconClass = Cn.Merge(
                                        "size-3.5 shrink-0",
                                        st.Status == "completed" ? "text-emerald-500" : "",
                                        st.Status == "in-progress" ? "text-blue-500" : "",
                                        st.Status == "pending" ? "text-muted-foreground/40" : "",
                                        st.Status == "failed" ? "text-red-500" : "");
                                    var stepTextClass = Cn.Merge("flex-1 text-xs", st.Status == "pending" ? "text-muted-foreground/60" : "text-foreground");
                                    <div class="flex items-center gap-2 rounded-md px-2 py-1.5">
                                        <LucideIconCn Name="@stepIconName" Size="14" Class="@stepIconClass" />
                                        <span class="@stepTextClass">@st.Label</span>
                                        <span class="shrink-0 text-[10px] text-muted-foreground tabular-nums">@st.Timestamp</span>
                                    </div>
                                }
                            </div>

                            <div class="mt-2 flex items-center gap-1.5">
                                <LucideIconCn Name="@statusIconName" Size="14" Class="@statusIconClass" />
                                <span class="@statusLabelClass">@phase.Status.Replace("-", " ")</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record MigrationStep(string Label, string Status, string Timestamp);

    private record MigrationPhase(
        string Id,
        string SourceSystem,
        string TargetSystem,
        string PhaseName,
        int TotalUsers,
        int MigratedUsers,
        int PercentComplete,
        string Status,
        string StartDate,
        string EstimatedEnd,
        MigrationStep[] Steps
    );

    private string? _expanded = "p2";

    private static readonly string[] _statusKeys = ["completed", "in-progress", "pending", "failed"];

    private static readonly MigrationPhase[] _phases =
    [
        new("p1", "Auth0", "Better Auth", "Enterprise SSO users", 12400, 12400, 100, "completed", "Mar 10, 2026", "Mar 15, 2026",
        [
            new("Export user profiles from Auth0", "completed", "Mar 10, 09:00"),
            new("Transform SAML metadata to OIDC format", "completed", "Mar 11, 14:30"),
            new("Import users with password hash migration", "completed", "Mar 13, 08:15"),
            new("Verify SSO connections for all orgs", "completed", "Mar 14, 16:45"),
            new("Switch DNS for auth.acme.com", "completed", "Mar 15, 02:00"),
        ]),
        new("p2", "Auth0", "Better Auth", "Self-serve users (email/password)", 84200, 61470, 73, "in-progress", "Mar 16, 2026", "Mar 30, 2026",
        [
            new("Batch export user credentials", "completed", "Mar 16, 10:00"),
            new("Hash migration with bcrypt compatibility", "completed", "Mar 18, 22:00"),
            new("Shadow auth validation (dual-write)", "in-progress", "Mar 20, 08:00"),
            new("Redirect login flow to new system", "pending", "—"),
            new("Decommission Auth0 tenant", "pending", "—"),
        ]),
        new("p3", "Auth0", "Better Auth", "OAuth social login users", 38900, 0, 0, "pending", "Apr 1, 2026", "Apr 10, 2026",
        [
            new("Map social provider tokens", "pending", "—"),
            new("Configure Google/GitHub OAuth in Better Auth", "pending", "—"),
            new("Migrate linked social accounts", "pending", "—"),
            new("Test social login re-linking flow", "pending", "—"),
            new("Cutover social auth endpoints", "pending", "—"),
        ]),
        new("p4", "Stripe Billing v1", "Stripe Billing v2", "Subscription billing migration", 9200, 842, 9, "failed", "Mar 22, 2026", "Apr 5, 2026",
        [
            new("Export subscription metadata from v1", "completed", "Mar 22, 11:00"),
            new("Create v2 price objects for all SKUs", "completed", "Mar 23, 09:30"),
            new("Migrate active subscriptions with proration", "failed", "Mar 24, 14:22"),
            new("Verify invoice line items match", "pending", "—"),
            new("Switch webhook endpoints to v2", "pending", "—"),
        ]),
    ];

    private static readonly int _totalUsers = _phases.Sum(p => p.TotalUsers);
    private static readonly int _totalMigrated = _phases.Sum(p => p.MigratedUsers);
    private static readonly int _overallPercent = (int)Math.Round((double)_totalMigrated / _totalUsers * 100);

    private void Toggle(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private static string GetStatusDotClass(string status) => status switch
    {
        "completed"   => "bg-emerald-500",
        "in-progress" => "bg-blue-500",
        "pending"     => "bg-amber-500",
        "failed"      => "bg-red-500",
        _             => "",
    };

    private static string GetStatusLabelClass(string status) => status switch
    {
        "completed"   => "text-emerald-600",
        "in-progress" => "text-blue-600",
        "pending"     => "text-amber-600",
        "failed"      => "text-red-600",
        _             => "",
    };

    private static string GetStatusIconName(string status) => status switch
    {
        "completed"   => "check-circle-2",
        "in-progress" => "circle-dot",
        "pending"     => "clock",
        "failed"      => "x-circle",
        _             => "circle",
    };
}
