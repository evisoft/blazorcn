@* ============================================================
   Block: changelog-dark-minimal
   Title: ChangelogDarkMinimal
   Description: A dark-themed minimal changelog block with a developer-tool aesthetic featuring light text on dark backgrounds and terminal-inspired styling
   Source: original/blocks/changelog/changelog-dark-minimal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="terminal" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">Changelog</span>
            <span class="text-xs text-muted-foreground">Latest releases</span>
        </div>

        <div class="bg-zinc-950">
            @for (int i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                var idx = i;
                <button type="button"
                        class="@Cn.Merge("flex w-full flex-col text-left transition-colors hover:bg-zinc-900/60", idx < _entries.Length - 1 ? "border-b border-zinc-800" : "")"
                        @onclick="@(() => ToggleEntry(entry.Id))">
                    <div class="flex items-center gap-3 px-4 py-3">
                        <span class="shrink-0 font-mono text-xs text-zinc-500">@entry.Version</span>
                        <span class="min-w-0 flex-1 truncate text-sm font-medium text-zinc-100">@entry.Title</span>
                        <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("shrink-0 border text-[10px]", _tagColors[entry.Tag])">@entry.Tag</BadgeCn>
                        <span class="shrink-0 text-xs text-zinc-500">@entry.Date</span>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-zinc-600 transition-transform duration-200", _expandedId == entry.Id ? "rotate-90" : "")" />
                    </div>
                    @if (_expandedId == entry.Id)
                    {
                        <div class="overflow-hidden">
                            <p class="px-4 pb-3 text-xs leading-relaxed text-zinc-400">@entry.Description</p>
                        </div>
                    }
                </button>
            }
        </div>
    </div>
</section>

@code {
    private record ChangelogEntry(string Id, string Version, string Date, string Title, string Description, string Tag);

    private static readonly Dictionary<string, string> _tagColors = new()
    {
        ["feature"]     = "bg-emerald-500/20 text-emerald-400 border-emerald-500/30",
        ["fix"]         = "bg-red-500/20 text-red-400 border-red-500/30",
        ["improvement"] = "bg-blue-500/20 text-blue-400 border-blue-500/30",
    };

    private static readonly ChangelogEntry[] _entries =
    [
        new("1", "v3.4.0", "Mar 25, 2026", "WebSocket streaming support",
            "Added real-time streaming for build logs and deployment output via persistent WebSocket connections.",
            "feature"),
        new("2", "v3.3.2", "Mar 18, 2026", "Fixed CLI auth token refresh",
            "Resolved an issue where expired tokens caused silent failures during headless CI/CD deployments.",
            "fix"),
        new("3", "v3.3.1", "Mar 12, 2026", "Reduced cold start latency by 40%",
            "Optimized the function runtime initialization by lazy-loading non-critical modules and caching resolved dependencies.",
            "improvement"),
        new("4", "v3.3.0", "Mar 5, 2026", "Custom domain wildcard support",
            "You can now configure wildcard subdomains for multi-tenant applications directly from the dashboard.",
            "feature"),
        new("5", "v3.2.4", "Feb 27, 2026", "Patched memory leak in edge functions",
            "Fixed a memory leak caused by unclosed response streams in long-running edge function invocations.",
            "fix"),
    ];

    private string? _expandedId = null;

    private void ToggleEntry(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }
}
