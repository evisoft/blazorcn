@* ============================================================
   Block: changelog-uptime-history
   Title: ChangelogUptimeHistory
   Description: An uptime metrics dashboard showing percentage bars per service with 99.98% precision, incident listings with resolution times, and smooth staggered animations.
   Source: original/blocks/changelog/changelog-uptime-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="wifi" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Uptime History</h2>
            <span class="ml-auto text-xs text-muted-foreground">Last 90 days</span>
        </div>

        @* Service Availability *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Service Availability</p>
            <div class="space-y-2.5">
                @foreach (var svc in _services)
                {
                    <div class="flex items-center gap-3">
                        <span class="w-24 shrink-0 text-xs text-muted-foreground">@svc.Name</span>
                        <div class="relative h-2 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="@Cn.Merge("absolute inset-y-0 left-0 rounded-full", UptimeColor(svc.Uptime))"
                                 style="@($"width:{svc.Uptime}%")">
                            </div>
                        </div>
                        <span class="@Cn.Merge("w-16 text-right font-mono text-xs font-medium tabular-nums", UptimeTextColor(svc.Uptime))">
                            @svc.Uptime.ToString("F2")%
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Recent Incidents header *@
        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">Recent Incidents</p>
        </div>

        @* Incident rows *@
        @foreach (var inc in _incidents)
        {
            var incident = inc;
            var isExpanded = _expanded == incident.Id;
            <div>
                <button type="button"
                        class="flex w-full items-center gap-3 border-b px-4 py-3 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => ToggleExpanded(incident.Id))">
                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", ImpactColor(incident.Impact))"></span>
                    <div class="min-w-0 flex-1">
                        <p class="truncate text-sm font-medium">@incident.Title</p>
                        <div class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                            <span>@incident.Service</span>
                            <span>·</span>
                            <span>@incident.Date</span>
                            <span>·</span>
                            <span class="flex items-center gap-1">
                                <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                @incident.Duration
                            </span>
                        </div>
                    </div>
                    <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                </button>
                @if (isExpanded)
                {
                    <div class="border-b bg-muted/30 px-4 py-3">
                        <p class="mb-1 text-xs font-medium text-muted-foreground">Resolution</p>
                        <p class="text-xs text-muted-foreground">@incident.Resolution</p>
                    </div>
                }
            </div>
        }

        @* Footer *@
        <div class="px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                All incidents are reviewed in weekly postmortems
            </p>
        </div>

    </div>
</section>

@code {
    private record ServiceUptime(string Name, double Uptime, int Incidents, string Period);

    private record Incident(string Id, string Service, string Title, string Date, string Duration, string Impact, string Resolution);

    private static readonly ServiceUptime[] _services =
    [
        new("API", 99.98, 1, "Last 90 days"),
        new("Dashboard", 99.95, 2, "Last 90 days"),
        new("Authentication", 100.0, 0, "Last 90 days"),
        new("Webhooks", 99.87, 3, "Last 90 days"),
        new("CDN", 99.99, 0, "Last 90 days"),
    ];

    private static readonly Incident[] _incidents =
    [
        new("inc-1", "Webhooks", "Delayed webhook deliveries to EU endpoints", "Mar 22, 2026", "47 min", "minor",
            "Restarted message queue consumers and cleared backlog. Added circuit breaker for slow endpoints."),
        new("inc-2", "Dashboard", "Elevated error rates on dashboard API", "Mar 15, 2026", "23 min", "major",
            "Database connection pool exhausted due to long-running query. Killed query and added timeout guard."),
        new("inc-3", "API", "Intermittent 502 errors on /v2/users endpoint", "Mar 8, 2026", "12 min", "minor",
            "Upstream service deployed breaking schema change. Rolled back and coordinated migration window."),
    ];

    private string? _expanded;

    private void ToggleExpanded(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private static string UptimeColor(double uptime)
    {
        if (uptime >= 99.95) return "bg-emerald-500";
        if (uptime >= 99.5) return "bg-amber-500";
        return "bg-red-500";
    }

    private static string UptimeTextColor(double uptime)
    {
        if (uptime >= 99.95) return "text-emerald-600";
        if (uptime >= 99.5) return "text-amber-600";
        return "text-red-600";
    }

    private static string ImpactColor(string impact) => impact switch
    {
        "major" => "bg-red-500",
        "critical" => "bg-red-700",
        _ => "bg-amber-500",
    };
}
