@* ============================================================
   Block: changelog-latency-budget
   Title: ChangelogLatencyBudget
   Description: A changelog displaying latency budget tracking per service with SLO thresholds and burn rate metrics, built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-latency-budget.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Latency Budget Tracking</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Service-level SLO compliance and burn rate monitoring
            </p>
        </div>

        @* Summary stats *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-3 gap-4">
                <div>
                    <p class="text-xs text-muted-foreground">Services Monitored</p>
                    <p class="mt-1 font-semibold tabular-nums text-2xl">@_services.Length</p>
                </div>
                <div>
                    <p class="text-xs text-muted-foreground">Within SLO</p>
                    <p class="mt-1 font-semibold tabular-nums text-2xl text-emerald-500">
                        @_services.Count(s => s.Status == "healthy")
                    </p>
                </div>
                <div>
                    <p class="text-xs text-muted-foreground">Violations</p>
                    <p class="mt-1 font-semibold tabular-nums text-2xl text-red-500">
                        @_services.Count(s => s.Status == "critical")
                    </p>
                </div>
            </div>
        </div>

        @* Services list *@
        <div>
            @foreach (var svc in _services)
            {
                var service = svc;
                var isExpanded = _expandedService == service.Name;
                var iconName = service.Status == "healthy" ? "check-circle-2" : service.Status == "warning" ? "alert-triangle" : "x-circle";
                var iconClass = service.Status == "healthy" ? "size-4 text-emerald-500" : service.Status == "warning" ? "size-4 text-amber-500" : "size-4 text-red-500";
                var badgeClass = service.Status == "healthy" ? "border-0 bg-emerald-500/10 text-emerald-500" : service.Status == "warning" ? "border-0 bg-amber-500/10 text-amber-500" : "border-0 bg-red-500/10 text-red-500";
                <div class="border-b last:border-b-0">
                    <button type="button"
                            @onclick="@(() => ToggleService(service.Name))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="@iconName" Size="16" Class="@iconClass" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@service.Name</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="@badgeClass">@service.Status</BadgeCn>
                            </div>
                            <div class="mt-1 flex items-center gap-3 text-xs text-muted-foreground">
                                <span class="font-mono">p95: @(service.CurrentLatency)ms</span>
                                <span class="text-muted-foreground/40">•</span>
                                <span class="font-mono">SLO: @(service.SloThreshold)ms</span>
                                <span class="text-muted-foreground/40">•</span>
                                <span class="flex items-center gap-1">
                                    @if (service.BurnRate > 0)
                                    {
                                        <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-red-500" />
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="trending-down" Size="12" Class="size-3 text-emerald-500" />
                                    }
                                    <span class="@Cn.Merge("font-mono", service.BurnRate > 0 ? "text-red-500" : "text-emerald-500")">
                                        @(service.BurnRate > 0 ? "+" : "")@(service.BurnRate)%
                                    </span>
                                </span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>
                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/30 px-4 py-3">
                            <div class="space-y-3">
                                @foreach (var ch in service.Changes)
                                {
                                    var change = ch;
                                    <div class="rounded-md bg-card p-3">
                                        <div class="mb-2 flex items-start justify-between gap-3">
                                            <div class="min-w-0 flex-1">
                                                <div class="flex items-center gap-2">
                                                    <span class="font-mono text-xs font-medium">@change.Version</span>
                                                    <span class="text-xs text-muted-foreground">@change.Date</span>
                                                </div>
                                                <p class="mt-1 text-sm">@change.Impact</p>
                                            </div>
                                        </div>
                                        <div class="mt-2 flex items-center gap-4 text-xs text-muted-foreground">
                                            <span class="font-mono">p95: @(change.P95)ms</span>
                                            <span class="font-mono">p99: @(change.P99)ms</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <p class="text-xs text-muted-foreground">Last updated: 3 minutes ago</p>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">View Full Report</ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record LatencyChange(string Version, string Date, string Impact, int P95, int P99);
    private record ServiceMetrics(string Name, int CurrentLatency, int SloThreshold, double BurnRate, string Status, LatencyChange[] Changes);

    private static readonly ServiceMetrics[] _services =
    [
        new("API Gateway", 142, 150, -5.3, "healthy",
        [
            new("v2.4.1", "2026-03-28", "Reduced p95 latency by 18ms through connection pooling", 142, 287),
            new("v2.4.0", "2026-03-25", "Implemented request coalescing for duplicate queries", 160, 312),
        ]),
        new("User Service", 89, 100, -11.0, "healthy",
        [
            new("v1.8.2", "2026-03-29", "Optimized database query patterns, reduced N+1 queries", 89, 178),
        ]),
        new("Payment Processor", 1820, 2000, -9.0, "warning",
        [
            new("v3.1.0", "2026-03-27", "Migrated to async webhook delivery, p95 regression due to validation overhead", 1820, 3240),
            new("v3.0.9", "2026-03-24", "Added circuit breaker for third-party payment gateway", 1650, 2890),
        ]),
        new("Search Service", 234, 200, 17.0, "critical",
        [
            new("v4.2.1", "2026-03-29", "CRITICAL: Index fragmentation causing p95 spike, rollback in progress", 234, 512),
            new("v4.2.0", "2026-03-26", "Deployed new relevance algorithm with increased computation", 187, 398),
        ]),
    ];

    private string? _expandedService;

    private void ToggleService(string name)
    {
        _expandedService = _expandedService == name ? null : name;
    }
}
