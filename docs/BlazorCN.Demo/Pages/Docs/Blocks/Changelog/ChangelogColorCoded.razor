@* ============================================================
   Block: changelog-color-coded
   Title: ChangelogColorCoded
   Description: React color-coded changelog block for Next.js with category-based left border strips in emerald, red, blue, and amber built with TypeScript, Framer Motion staggered animations, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-color-coded.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="paintbrush" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Changelog</h2>
            <div class="ml-auto flex items-center gap-3">
                @foreach (var cat in _categoryDots.Keys)
                {
                    <div class="flex items-center gap-1.5">
                        <span class="@($"size-1.5 rounded-full {_categoryDots[cat]}")"></span>
                        <span class="text-[11px] text-muted-foreground">@cat</span>
                    </div>
                }
            </div>
        </div>

        <div>
            @for (var i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                var borderB = i < _entries.Length - 1 ? "border-b" : "";
                var borderColor = _categoryColors[entry.Category];
                <div class="@($"border-l-[3px] {borderColor} {borderB} px-4 py-3")">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-medium">@entry.Title</span>
                        <span class="shrink-0 font-mono text-[11px] text-muted-foreground/60">
                            @entry.Version
                        </span>
                    </div>
                    <p class="mt-0.5 text-xs text-muted-foreground leading-relaxed">
                        @entry.Description
                    </p>
                    <div class="mt-1 flex items-center gap-2">
                        <span class="@($"size-1.5 rounded-full {_categoryDots[entry.Category]}")"></span>
                        <span class="text-[11px] text-muted-foreground/60">@entry.Category</span>
                        <span class="text-[11px] text-muted-foreground/40">&middot;</span>
                        <span class="text-[11px] text-muted-foreground/60">@entry.Date</span>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ColorCodedEntry(string Title, string Description, string Date, string Version, string Category);

    private static readonly Dictionary<string, string> _categoryColors = new()
    {
        ["Feature"] = "border-l-emerald-500",
        ["Bug Fix"] = "border-l-red-500",
        ["Improvement"] = "border-l-blue-500",
        ["Deprecation"] = "border-l-amber-500",
    };

    private static readonly Dictionary<string, string> _categoryDots = new()
    {
        ["Feature"] = "bg-emerald-500",
        ["Bug Fix"] = "bg-red-500",
        ["Improvement"] = "bg-blue-500",
        ["Deprecation"] = "bg-amber-500",
    };

    private static readonly ColorCodedEntry[] _entries =
    [
        new("Branch-based preview deployments",
            "Every push to a feature branch now generates an isolated preview environment with a unique URL.",
            "Mar 28, 2026", "3.12.0", "Feature"),
        new("Fixed WebSocket reconnection on idle tabs",
            "Resolved an issue where real-time updates stopped after the browser tab was inactive for over 10 minutes.",
            "Mar 26, 2026", "3.11.2", "Bug Fix"),
        new("Faster cold start for serverless functions",
            "Reduced cold start latency by 60% through dependency tree pruning and lazy module initialization.",
            "Mar 24, 2026", "3.11.1", "Improvement"),
        new("Legacy webhook v1 endpoints deprecated",
            "Webhook v1 endpoints will be removed on June 1, 2026. Migrate to v2 endpoints for enhanced payload signing.",
            "Mar 22, 2026", "3.11.0", "Deprecation"),
        new("Inline variable editor in pipelines",
            "Edit environment variables directly within the pipeline configuration view without navigating to settings.",
            "Mar 20, 2026", "3.10.0", "Feature"),
        new("Fixed timezone offset in scheduled triggers",
            "Cron-based triggers now correctly account for DST transitions in all supported timezones.",
            "Mar 18, 2026", "3.9.4", "Bug Fix"),
        new("Improved diff rendering for large files",
            "Files over 5,000 lines now use virtualized rendering, reducing memory usage by 70% in code review.",
            "Mar 16, 2026", "3.9.3", "Improvement"),
        new("REST API v2 response format change",
            "The legacy envelope wrapper on API responses is deprecated. Direct response bodies are now the default.",
            "Mar 14, 2026", "3.9.0", "Deprecation"),
    ];
}
