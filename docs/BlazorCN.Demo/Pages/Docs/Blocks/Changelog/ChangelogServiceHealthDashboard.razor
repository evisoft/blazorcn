@* ============================================================
   Block: changelog-service-health-dashboard
   Title: ChangelogServiceHealthDashboard
   Description: A service health overview changelog block displaying uptime percentages, incident counts, and status indicators built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-service-health-dashboard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="activity" Size="16" Class="size-4 text-muted-foreground" />
                    <h2 class="text-sm font-medium">Service Health Dashboard</h2>
                </div>
                <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 text-xs">
                    <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-500" />
                    All Systems Operational
                </BadgeCn>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">Last 30 days · Updated 2 minutes ago</p>
        </div>

        @* Summary Stats *@
        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <p class="text-xs text-muted-foreground">Overall Uptime</p>
                <p class="mt-1 font-semibold tabular-nums text-2xl text-emerald-500">@(_overallUptime.ToString("F2"))%</p>
            </div>
            <div class="border-r px-4 py-3">
                <p class="text-xs text-muted-foreground">Total Incidents</p>
                <p class="mt-1 font-semibold tabular-nums text-2xl">@_totalIncidents</p>
            </div>
            <div class="px-4 py-3">
                <p class="text-xs text-muted-foreground">Critical</p>
                <p class="@Cn.Merge("mt-1 font-semibold tabular-nums text-2xl", _criticalIncidents > 0 ? "text-red-500" : "text-muted-foreground")">@_criticalIncidents</p>
            </div>
        </div>

        @* Services List *@
        <div>
            @foreach (var svc in _services)
            {
                var service = svc;
                var isExpanded = _expandedService == service.Id;
                var isLast = service.Id == _services[^1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => ToggleService(service.Id))">
                        <div class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-md",
                                service.Status == "operational" ? "bg-emerald-500/10" :
                                service.Status == "degraded" ? "bg-amber-500/10" : "bg-red-500/10")">
                            <LucideIconCn Name="@service.Icon" Size="16" Class="@Cn.Merge("size-4",
                                service.Status == "operational" ? "text-emerald-500" :
                                service.Status == "degraded" ? "text-amber-500" : "text-red-500")" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@service.Name</span>
                                <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full",
                                    service.Status == "operational" ? "bg-emerald-500" :
                                    service.Status == "degraded" ? "bg-amber-500" : "bg-red-500")"></span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-3 text-xs text-muted-foreground">
                                <span class="tabular-nums">@service.UptimePercentage% uptime</span>
                                <span>·</span>
                                <span>@service.TotalIncidents incidents</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            @if (service.CriticalIncidents > 0)
                            {
                                <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 border-red-500/20 bg-red-500/10 text-red-500 text-xs">
                                    <LucideIconCn Name="alert-circle" Size="12" Class="size-3" />
                                    @service.CriticalIncidents
                                </BadgeCn>
                            }
                            <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/30">
                            <div class="space-y-3 px-4 py-3">
                                <div class="grid grid-cols-2 gap-3">
                                    <div>
                                        <p class="text-xs text-muted-foreground">Last Incident</p>
                                        <p class="mt-0.5 text-sm">@service.LastIncident</p>
                                    </div>
                                    <div>
                                        <p class="text-xs text-muted-foreground">Critical Issues</p>
                                        <p class="mt-0.5 text-sm">@service.CriticalIncidents</p>
                                    </div>
                                </div>
                                <div class="flex gap-2">
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">View History</ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">Status Page</ButtonCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ServiceItem(
        string Id,
        string Name,
        string Status,
        double UptimePercentage,
        int TotalIncidents,
        int CriticalIncidents,
        string LastIncident,
        string Icon);

    private static readonly ServiceItem[] _services =
    [
        new("api", "API Gateway", "operational", 99.98, 2, 0, "14 days ago", "zap"),
        new("db", "Database Cluster", "operational", 99.99, 1, 0, "32 days ago", "database"),
        new("cdn", "CDN Network", "operational", 99.95, 4, 1, "7 days ago", "globe"),
        new("worker", "Background Workers", "degraded", 99.87, 8, 2, "2 hours ago", "server"),
    ];

    private double _overallUptime = _services.Average(s => s.UptimePercentage);
    private int _totalIncidents = _services.Sum(s => s.TotalIncidents);
    private int _criticalIncidents = _services.Sum(s => s.CriticalIncidents);

    private string? _expandedService;

    private void ToggleService(string id)
    {
        _expandedService = _expandedService == id ? null : id;
    }
}
