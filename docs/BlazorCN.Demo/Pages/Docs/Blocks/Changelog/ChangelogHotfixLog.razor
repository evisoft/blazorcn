@* ============================================================
   Block: changelog-hotfix-log
   Title: ChangelogHotfixLog
   Description: A changelog block displaying emergency hotfix and patch records with urgency indicators, affected versions, and detailed fix descriptions for production incidents.
   Source: original/blocks/changelog/changelog-hotfix-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="bug" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Hotfix Log</h2>
            <span class="ml-auto text-xs text-muted-foreground">@_hotfixes.Length patches</span>
        </div>

        <div>
            @foreach (var hf in _hotfixes)
            {
                var entry = hf;
                var isExpanded = _expandedId == entry.Id;
                var isLast = entry.Id == _hotfixes[^1].Id;
                var config = GetUrgencyConfig(entry.Urgency);
                var dotClass = entry.Urgency == "critical" ? "bg-red-500" : entry.Urgency == "high" ? "bg-amber-500" : "bg-blue-500";
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => ToggleEntry(entry.Id))">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", dotClass)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate text-sm font-medium">@entry.Title</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("shrink-0 text-[10px]", config.ClassName)">@config.Label</BadgeCn>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                                <span class="font-mono">@entry.Version</span>
                                <span>&middot;</span>
                                <span>@entry.Date</span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-3 px-4 pb-4">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <p class="text-xs text-muted-foreground">@entry.Description</p>
                                </div>
                                <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted-foreground">
                                    <span>
                                        Affected:
                                        @foreach (var v in entry.AffectedVersions)
                                        {
                                            <code class="mx-0.5 font-mono text-[11px]">@v</code>
                                        }
                                    </span>
                                </div>
                                <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                    <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                    <span>Resolved by @entry.ResolvedBy</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record HotfixEntry(string Id, string Title, string Description, string Version, string[] AffectedVersions, string Urgency, string Date, string ResolvedBy);

    private record UrgencyConfig(string Label, string ClassName);

    private static readonly HotfixEntry[] _hotfixes =
    [
        new("hf-1", "Authentication token refresh loop",
            "Fixed infinite token refresh cycle caused by clock skew validation rejecting valid tokens within 30s window.",
            "v3.8.1", ["v3.8.0"], "critical", "Mar 27, 2026", "Sarah Chen"),
        new("hf-2", "Payment webhook duplicate processing",
            "Added idempotency check to prevent double-charging when Stripe retries webhook delivery during high latency.",
            "v3.7.4", ["v3.7.0", "v3.7.1", "v3.7.2", "v3.7.3"], "critical", "Mar 24, 2026", "Marcus Webb"),
        new("hf-3", "Dashboard memory leak in chart rendering",
            "Disposed orphaned chart instances on unmount that accumulated during rapid tab switching.",
            "v3.7.3", ["v3.6.0", "v3.7.0"], "high", "Mar 20, 2026", "Aiko Tanaka"),
        new("hf-4", "CSV export encoding for UTF-8 characters",
            "Added BOM header to exported CSV files to fix garbled non-Latin characters in Excel on Windows.",
            "v3.7.2", ["v3.5.0", "v3.6.0", "v3.7.0"], "medium", "Mar 18, 2026", "Elena Popov"),
        new("hf-5", "Rate limiter bypass via header injection",
            "Sanitized X-Forwarded-For header parsing to prevent rate limit circumvention through spoofed IPs.",
            "v3.7.1", ["v3.0.0", "v3.7.0"], "critical", "Mar 15, 2026", "James Liu"),
    ];

    private string? _expandedId;

    private void ToggleEntry(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private static UrgencyConfig GetUrgencyConfig(string urgency) => urgency switch
    {
        "critical" => new("Critical", "bg-red-500/10 text-red-600 dark:text-red-400"),
        "high"     => new("High",     "bg-amber-500/10 text-amber-600 dark:text-amber-400"),
        _          => new("Medium",   "bg-blue-500/10 text-blue-600 dark:text-blue-400"),
    };
}
