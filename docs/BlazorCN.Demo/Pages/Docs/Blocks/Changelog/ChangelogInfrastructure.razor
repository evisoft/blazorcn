@* ============================================================
   Block: changelog-infrastructure
   Title: ChangelogInfrastructure
   Description: An infrastructure and DevOps changelog displaying region deployments, scaling events, and service updates with service name badges and staggered motion animations.
   Source: original/blocks/changelog/changelog-infrastructure.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="cloud" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Infrastructure Changes</h2>
            <span class="ml-auto text-xs text-muted-foreground">@_infraChanges.Length events</span>
        </div>

        @* Change entries *@
        @foreach (var ch in _infraChanges)
        {
            var change = ch;
            <div>
                <button type="button"
                        class="flex w-full items-center gap-3 border-b px-4 py-3 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => SetExpanded(change.Id))">
                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", GetTypeColor(change.Type))"></span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 gap-1 px-1.5 text-xs font-normal">
                                <LucideIconCn Name="@GetTypeIconName(change.Type)" Size="12" Class="size-3" />
                                @change.Service
                            </BadgeCn>
                            <span class="font-mono text-xs text-muted-foreground">@change.Region</span>
                        </div>
                        <p class="mt-0.5 truncate text-sm font-medium">@change.Description</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">@change.Timestamp · @change.Author</p>
                    </div>
                    <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", _expanded == change.Id ? "rotate-90" : "")" />
                </button>

                @if (_expanded == change.Id)
                {
                    <div class="border-b bg-muted/30 px-4 py-3">
                        <p class="mb-1.5 text-xs font-medium text-muted-foreground">Details</p>
                        <ul class="space-y-1">
                            @foreach (var detail in change.Details)
                            {
                                <li class="flex items-start gap-2 text-xs text-muted-foreground">
                                    <span class="mt-1.5 size-1 shrink-0 rounded-full bg-muted-foreground/40"></span>
                                    @detail
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }

        @* Footer *@
        <div class="px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">All changes are audited and reversible</p>
        </div>

    </div>
</section>

@code {
    private record InfraChange(string Id, string Service, string Type, string Region, string Description, string[] Details, string Timestamp, string Author);

    private static readonly InfraChange[] _infraChanges =
    [
        new("inf-1", "API Gateway", "deployment", "us-east-1",
            "Upgraded to v3.2.0 with HTTP/3 support",
            ["Enabled QUIC protocol on edge nodes", "Updated TLS certificates to Ed25519", "Connection pooling increased to 10k per node"],
            "Mar 27, 2026 · 14:32 UTC", "deploy-bot"),
        new("inf-2", "PostgreSQL", "scaling", "eu-west-1",
            "Scaled read replicas from 3 to 5 instances",
            ["Triggered by sustained 85% CPU on primary", "Added replicas in eu-west-1b and eu-west-1c", "Replication lag stabilized under 50ms"],
            "Mar 26, 2026 · 09:15 UTC", "autoscaler"),
        new("inf-3", "Redis Cluster", "migration", "ap-southeast-1",
            "Migrated from Redis 7.2 to 7.4 with zero downtime",
            ["Used rolling restart across 6-node cluster", "New JSON module enabled for document queries", "Memory optimization reduced usage by 12%"],
            "Mar 25, 2026 · 03:00 UTC", "platform-team"),
        new("inf-4", "CDN", "config", "global",
            "Updated cache rules for static assets",
            ["Extended TTL for immutable assets to 1 year", "Added stale-while-revalidate for API responses", "Purged 2.1TB of stale cache entries"],
            "Mar 24, 2026 · 18:45 UTC", "infra-ops"),
        new("inf-5", "Kubernetes", "deployment", "us-west-2",
            "Rolled out cluster upgrade to v1.31",
            ["Control plane upgraded with zero API downtime", "Node pools drained and replaced in rolling batches", "Sidecar containers GA feature now enabled"],
            "Mar 23, 2026 · 11:20 UTC", "deploy-bot"),
    ];

    private string? _expanded;

    private void SetExpanded(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private static string GetTypeColor(string type) => type switch
    {
        "deployment" => "bg-blue-500",
        "scaling"    => "bg-amber-500",
        "migration"  => "bg-purple-500",
        "config"     => "bg-emerald-500",
        _            => "",
    };

    private static string GetTypeIconName(string type) => type switch
    {
        "deployment" => "server",
        "scaling"    => "arrow-up",
        "migration"  => "globe",
        "config"     => "cloud",
        _            => "circle",
    };
}
