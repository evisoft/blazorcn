@* ============================================================
   Block: changelog-filterable
   Title: ChangelogFilterable
   Description: React filterable changelog block for Next.js with category toggle filters, animated entry transitions, and count badges built with TypeScript, shadcn/ui Button, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-filterable.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="filter" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Changelog</span>
        </div>

        @* Filter bar *@
        <div class="flex flex-wrap items-center gap-1.5 border-b px-4 py-2.5">
            @foreach (var filter in _filters)
            {
                var f = filter;
                <ButtonCn Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.Sm"
                          Class="@Cn.Merge("h-7 gap-1.5 text-xs", _activeFilter == f.Value ? "bg-muted text-foreground" : "text-muted-foreground")"
                          OnClick="@(() => _activeFilter = f.Value)">
                    @f.Label
                    <span class="font-mono text-[10px] text-muted-foreground/60 tabular-nums">
                        @GetCategoryCount(f.Value)
                    </span>
                </ButtonCn>
            }
        </div>

        @* Entries *@
        <div>
            @{
                var filtered = _activeFilter == "all"
                    ? _allEntries
                    : _allEntries.Where(e => e.Category == _activeFilter).ToArray();
            }
            @for (var i = 0; i < filtered.Length; i++)
            {
                var entry = filtered[i];
                var borderClass = i < filtered.Length - 1 ? "border-b" : "";
                <div class="@borderClass">
                    <div class="flex items-start gap-3 px-4 py-2.5">
                        <span class="@Cn.Merge("mt-1.5 size-2 shrink-0 rounded-full", _dotColors[entry.Category])"
                              aria-hidden="true"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center justify-between gap-2">
                                <span class="font-medium text-sm">@entry.Title</span>
                                <span class="shrink-0 text-muted-foreground/60 text-xs">@entry.Date</span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@entry.Description</p>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ChangeEntry(string Title, string Description, string Date, string Category);

    private string _activeFilter = "all";

    private static readonly (string Label, string Value)[] _filters =
    [
        ("All", "all"),
        ("Features", "feature"),
        ("Fixes", "fix"),
        ("Improvements", "improvement"),
    ];

    private static readonly Dictionary<string, string> _dotColors = new()
    {
        ["feature"] = "bg-emerald-500",
        ["fix"] = "bg-red-500",
        ["improvement"] = "bg-blue-500",
    };

    private static readonly ChangeEntry[] _allEntries =
    [
        new("Team workspace collaboration",
            "Shared workspaces with role-based access for viewer, editor, and admin.",
            "Mar 28", "feature"),
        new("Real-time cursor presence",
            "See who is editing what across your workspace in real time.",
            "Mar 28", "feature"),
        new("Dashboard streaming SSR",
            "Initial dashboard load improved by 40% with React streaming.",
            "Mar 27", "improvement"),
        new("OAuth redirect loop",
            "Fixed infinite redirect on SAML providers with multi-value attributes.",
            "Mar 26", "fix"),
        new("Sidebar persistence",
            "Collapse state now saves to localStorage across sessions.",
            "Mar 25", "fix"),
        new("API key scoping",
            "Generate keys with granular read, write, and admin permissions.",
            "Mar 24", "feature"),
        new("Search indexing speed",
            "Full-text indexing reduced from 8 seconds to under 2 seconds.",
            "Mar 23", "improvement"),
        new("Custom theme editor",
            "Design themes with HSL pickers and export as CSS variables.",
            "Mar 22", "feature"),
        new("Timezone calculation fix",
            "UTC offset correction for negative timezone regions.",
            "Mar 21", "fix"),
        new("Bundle size reduction",
            "Client bundle reduced 18% through tree-shaking improvements.",
            "Mar 20", "improvement"),
    ];

    private int GetCategoryCount(string cat) =>
        cat == "all" ? _allEntries.Length : _allEntries.Count(e => e.Category == cat);
}
