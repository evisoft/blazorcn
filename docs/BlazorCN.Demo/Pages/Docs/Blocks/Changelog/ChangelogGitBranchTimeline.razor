@* ============================================================
   Block: changelog-git-branch-timeline
   Title: ChangelogGitBranchTimeline
   Description: A git branch visualization with merge points, release tags, and commit history for React and Next.js projects using shadcn/ui components and Tailwind CSS.
   Source: original/blocks/changelog/changelog-git-branch-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Git Branch Timeline</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Branch activity, merges, and release tags
                    </p>
                </div>
                <BadgeCn Class="h-5 gap-1 bg-muted/50 text-muted-foreground text-xs">
                    <LucideIconCn Name="git-branch" Size="12" Class="size-3" />
                    @_events.Count(e => e.Status == "active") active
                </BadgeCn>
            </div>
        </div>

        <div class="relative">
            <div class="absolute left-8 top-0 bottom-0 w-px bg-border"></div>

            @foreach (var evt in _events)
            {
                var ev = evt;
                var isExpanded = _expandedEvent == ev.Id;
                var isLast = ev.Id == _events[^1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => ToggleEvent(ev.Id))"
                            class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="relative z-10 flex size-6 shrink-0 items-center justify-center rounded-full bg-card">
                            @if (ev.Type == "tag")
                            {
                                <LucideIconCn Name="tag" Size="16" Class="size-4 text-blue-500" />
                            }
                            else if (ev.Type == "merge")
                            {
                                <LucideIconCn Name="git-merge" Size="16" Class="size-4 text-emerald-500" />
                            }
                            else if (ev.Status == "active")
                            {
                                <LucideIconCn Name="circle" Size="16" Class="size-4 text-amber-500 fill-amber-500" />
                            }
                            else
                            {
                                <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-muted-foreground/60" />
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@ev.BranchName</span>
                                        <BadgeCn Class="@Cn.Merge("h-5 text-xs", GetEventBadgeClass(ev.Type))">
                                            @ev.Type
                                        </BadgeCn>
                                        @if (ev.Status == "active")
                                        {
                                            <BadgeCn Class="h-5 bg-amber-500/10 text-amber-600 text-xs">
                                                active
                                            </BadgeCn>
                                        }
                                    </div>
                                    <p class="mt-0.5 text-xs text-muted-foreground">@ev.Message</p>
                                    <div class="mt-1.5 flex items-center gap-3 text-xs text-muted-foreground">
                                        <span>@ev.Author</span>
                                        <span>•</span>
                                        <span class="font-mono">@ev.CommitHash</span>
                                        <span>•</span>
                                        <span>@ev.Timestamp</span>
                                    </div>
                                    @if (ev.CommitsAhead.HasValue && ev.CommitsBehind.HasValue)
                                    {
                                        <div class="mt-1.5 flex items-center gap-2">
                                            <BadgeCn Class="h-4 bg-emerald-500/10 text-emerald-600 text-xs">
                                                +@ev.CommitsAhead
                                            </BadgeCn>
                                            <BadgeCn Class="h-4 bg-red-500/10 text-red-600 text-xs">
                                                -@ev.CommitsBehind
                                            </BadgeCn>
                                        </div>
                                    }
                                </div>
                                <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                            </div>
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/20 px-4 py-3 pl-14">
                            <div class="space-y-2">
                                <div class="rounded-md bg-card px-3 py-2">
                                    <div class="flex items-center gap-2">
                                        <LucideIconCn Name="git-branch" Size="16" Class="size-4 text-muted-foreground" />
                                        <div class="min-w-0 flex-1">
                                            <div class="text-xs font-medium">Branch Details</div>
                                            <div class="mt-0.5 text-xs text-muted-foreground">
                                                @if (ev.Type == "branch")
                                                {
                                                    @($"Based on {ev.BaseBranch ?? "main"}")
                                                }
                                                else if (ev.Type == "merge")
                                                {
                                                    @($"Merged {ev.BranchName} → {ev.BaseBranch}")
                                                }
                                                else if (ev.Type == "tag")
                                                {
                                                    @($"Release tag on {ev.BranchName ?? "main"}")
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                @if (ev.Type == "branch" && ev.Status == "active")
                                {
                                    <div class="rounded-md bg-card px-3 py-2">
                                        <div class="flex items-center gap-2">
                                            <LucideIconCn Name="git-commit" Size="16" Class="size-4 text-muted-foreground" />
                                            <div class="min-w-0 flex-1">
                                                <div class="text-xs font-medium">Sync Status</div>
                                                <div class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                                                    <span>@ev.CommitsAhead commits ahead</span>
                                                    <span>•</span>
                                                    <span>@ev.CommitsBehind commits behind</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record BranchEvent(
        string Id, string Type, string BranchName, string? BaseBranch,
        string Author, string Timestamp, string CommitHash, string Message,
        int? CommitsAhead, int? CommitsBehind, string Status);

    private static readonly BranchEvent[] _events =
    [
        new("evt-1", "tag", "v2.4.0", null, "release-bot", "1 hour ago", "a7f3c9d",
            "Release version 2.4.0 with new dashboard features", null, null, "released"),
        new("evt-2", "merge", "feat/new-dashboard", "main", "sarah_dev", "2 hours ago", "b2e4f1a",
            "Merge feat/new-dashboard into main", null, null, "merged"),
        new("evt-3", "branch", "feat/dark-mode-themes", "main", "alex_designer", "3 hours ago", "c9a2d8e",
            "Add multiple dark mode theme options", 12, 3, "active"),
        new("evt-4", "merge", "fix/auth-validation", "main", "mike_dev", "5 hours ago", "d4b3e7f",
            "Merge fix/auth-validation into main", null, null, "merged"),
        new("evt-5", "branch", "feat/api-v3", "develop", "emma_backend", "6 hours ago", "e8c5f2a",
            "Initial API v3 implementation", 24, 8, "active"),
        new("evt-6", "tag", "v2.3.1", null, "release-bot", "1 day ago", "f1d9a4c",
            "Hotfix release v2.3.1", null, null, "released"),
    ];

    private string? _expandedEvent;

    private void ToggleEvent(string id)
    {
        _expandedEvent = _expandedEvent == id ? null : id;
    }

    private string GetEventBadgeClass(string type) => type switch
    {
        "tag" => "bg-blue-500/10 text-blue-600",
        "merge" => "bg-emerald-500/10 text-emerald-600",
        _ => "bg-amber-500/10 text-amber-600",
    };
}
