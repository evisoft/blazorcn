@* ============================================================
   Block: changelog-deployment-log
   Title: ChangelogDeploymentLog
   Description: A changelog block showing deployment history with environment badges for production, staging, and preview alongside commit hashes, timestamps, and status indicators.
   Source: original/blocks/changelog/changelog-deployment-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="rocket" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Deployments</span>
            </div>
            <span class="text-xs text-muted-foreground">
                @_deployments.Length deploys this week
            </span>
        </div>

        <div>
            @for (var idx = 0; idx < _deployments.Length; idx++)
            {
                var deploy = _deployments[idx];
                var rowClass = Cn.Merge("flex items-center gap-3 px-4 py-3", idx < _deployments.Length - 1 ? "border-b" : "");
                var envClass = Cn.Merge("shrink-0 rounded-md px-1.5 py-0.5 text-[10px] font-medium", _envStyles.GetValueOrDefault(deploy.Environment, ""));
                <div class="@rowClass">
                    @if (deploy.Status == "Success")
                    {
                        <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-500" />
                    }
                    else if (deploy.Status == "Failed")
                    {
                        <LucideIconCn Name="circle-x" Size="16" Class="size-4 text-red-500" />
                    }
                    else
                    {
                        <LucideIconCn Name="loader" Size="16" Class="size-4 animate-spin text-blue-500" />
                    }
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="@envClass">@deploy.Environment</span>
                            <span class="truncate text-sm font-medium">@deploy.Message</span>
                        </div>
                        <div class="mt-0.5 flex items-center gap-2">
                            <span class="font-mono text-xs text-muted-foreground">@deploy.CommitHash</span>
                            <span class="text-xs text-muted-foreground/50">&middot;</span>
                            <span class="text-xs text-muted-foreground">@deploy.Deployer</span>
                            <span class="text-xs text-muted-foreground/50">&middot;</span>
                            <span class="text-xs text-muted-foreground">@deploy.Duration</span>
                        </div>
                    </div>
                    <span class="shrink-0 text-xs text-muted-foreground">@deploy.Timestamp</span>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Deployment(
        string Id,
        string Environment,
        string CommitHash,
        string Message,
        string Deployer,
        string Timestamp,
        string Status,
        string Duration
    );

    private static readonly Dictionary<string, string> _envStyles = new()
    {
        ["Production"] = "bg-emerald-500/10 text-emerald-600",
        ["Staging"]    = "bg-amber-500/10 text-amber-600",
        ["Preview"]    = "bg-blue-500/10 text-blue-600",
    };

    private static readonly Deployment[] _deployments =
    [
        new("d1", "Production", "a3f8c2d", "feat: add real-time collaboration",   "sarah-chen", "Mar 27, 14:32", "Success",     "2m 18s"),
        new("d2", "Staging",    "b7e1f4a", "fix: websocket reconnection logic",    "marcus-r",   "Mar 27, 11:05", "Success",     "1m 44s"),
        new("d3", "Preview",    "c9d2e8b", "refactor: extract validation utils",   "priya-s",    "Mar 26, 17:22", "In Progress", "--"),
        new("d4", "Production", "d4a7b3c", "fix: csv date parsing edge case",      "marcus-r",   "Mar 26, 09:15", "Failed",      "0m 52s"),
        new("d5", "Staging",    "e5f9a1d", "feat: batch API endpoint",             "alex-kim",   "Mar 25, 16:48", "Success",     "1m 33s"),
        new("d6", "Preview",    "f2c8d6e", "chore: upgrade dependencies",          "alex-kim",   "Mar 25, 10:30", "Success",     "1m 12s"),
    ];
}
