@* ============================================================
   Block: changelog-data-migration
   Title: ChangelogDataMigration
   Description: A changelog block displaying data migration execution records with migration name, records affected, duration, and completion status using staggered animations.
   Source: original/blocks/changelog/changelog-data-migration.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="database" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Data Migrations</h2>
            <span class="ml-auto text-xs text-muted-foreground">
                @_migrations.Length migrations
            </span>
        </div>

        <div class="flex items-center gap-4 border-b px-4 py-2">
            @foreach (var s in _statuses)
            {
                var status = s;
                var count = _migrations.Count(m => m.Status == status);
                var dotClass = Cn.Merge("size-1.5 rounded-full", GetStatusDotClass(status));
                <div class="flex items-center gap-1.5">
                    <span class="@dotClass"></span>
                    <span class="text-xs text-muted-foreground">@count @status</span>
                </div>
            }
        </div>

        @foreach (var migration in _migrations)
        {
            var mig = migration;
            var isExpanded = _expanded == mig.Id;
            var rowDotClass = Cn.Merge("size-1.5 shrink-0 rounded-full", GetStatusDotClass(mig.Status));
            var chevronClass = Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
            <div class="border-b last:border-b-0">
                <button
                    type="button"
                    @onclick="@(() => Toggle(mig.Id))"
                    class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                    <span class="@rowDotClass"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-mono text-sm font-medium">@mig.Name</span>
                        <div class="mt-0.5 flex items-center gap-2">
                            <span class="text-xs text-muted-foreground">@mig.ExecutedAt</span>
                            <span class="text-xs text-muted-foreground">·</span>
                            <span class="text-xs text-muted-foreground">@mig.Version</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 text-right">
                        <div class="hidden sm:block">
                            <p class="text-xs tabular-nums text-muted-foreground">
                                @mig.RecordsAffected.ToString("N0") rows
                            </p>
                            <p class="text-xs tabular-nums text-muted-foreground">
                                @mig.Duration
                            </p>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                    </div>
                </button>

                @if (isExpanded)
                {
                    var iconName = GetStatusIconName(mig.Status);
                    var iconClass = Cn.Merge("size-3.5", mig.Status == "Running" ? "animate-spin" : "");
                    <div class="border-t bg-muted/30 px-4 py-3">
                        <p class="text-xs text-muted-foreground">@mig.Description</p>
                        <div class="mt-2 flex items-center gap-1.5">
                            <LucideIconCn Name="@iconName" Size="14" Class="@iconClass" />
                            <span class="text-xs font-medium">@mig.Status</span>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</section>

@code {
    private record Migration(
        string Id,
        string Name,
        string Description,
        int RecordsAffected,
        string Duration,
        string Status,
        string ExecutedAt,
        string Version
    );

    private string? _expanded;

    private static readonly string[] _statuses = ["Completed", "Failed", "Running"];

    private static readonly Migration[] _migrations =
    [
        new("m1", "add_user_preferences_table",   "Create user preferences table with default settings columns",                       0,       "1.2s",    "Completed", "Mar 28, 2026 · 09:14 AM", "v2.14.0"),
        new("m2", "migrate_legacy_addresses",     "Transfer address records from legacy format to normalized schema",                 284930,  "4m 38s",  "Completed", "Mar 27, 2026 · 11:02 PM", "v2.14.0"),
        new("m3", "backfill_email_verified_flag", "Set email_verified flag based on confirmation_token presence",                     19402,   "—",       "Running",   "Mar 27, 2026 · 10:45 PM", "v2.13.2"),
        new("m4", "drop_deprecated_sessions",     "Remove session records older than 90 days from deprecated auth table",            1203844, "12m 05s", "Completed", "Mar 26, 2026 · 03:30 PM", "v2.13.1"),
        new("m5", "rename_org_to_workspace",      "Rename organization columns and update foreign key references",                    4521,    "0.8s",    "Failed",    "Mar 25, 2026 · 08:17 AM", "v2.13.0"),
        new("m6", "index_search_vectors",         "Build GIN indexes on tsvector columns for full-text search",                     892104,  "8m 22s",  "Completed", "Mar 24, 2026 · 06:00 AM", "v2.12.4"),
    ];

    private void Toggle(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private static string GetStatusDotClass(string status) => status switch
    {
        "Completed" => "bg-emerald-500",
        "Failed"    => "bg-red-500",
        "Running"   => "bg-blue-500",
        _           => "",
    };

    private static string GetStatusIconName(string status) => status switch
    {
        "Completed" => "check-circle-2",
        "Failed"    => "x-circle",
        "Running"   => "loader",
        _           => "circle",
    };
}
