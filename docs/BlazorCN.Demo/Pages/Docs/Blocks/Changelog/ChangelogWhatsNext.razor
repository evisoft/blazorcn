@* ============================================================
   Block: changelog-whats-next
   Title: ChangelogWhatsNext
   Description: React upcoming features changelog block for Next.js with planned, in development, and beta status badges for future entries built with TypeScript, Framer Motion staggered animations, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-whats-next.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">What&#39;s Next</h2>
            <span class="ml-auto text-xs text-muted-foreground">@_features.Length upcoming</span>
        </div>

        @* Subheading *@
        <div class="border-b px-4 py-3">
            <p class="text-xs text-muted-foreground">
                A look at what we&#39;re building. Dates and scope may shift as we iterate.
            </p>
        </div>

        @* Feature list *@
        <div>
            @foreach (var feat in _features)
            {
                var feature = feat;
                var isExpanded = _expanded == feature.Title;
                var isLast = feature.Title == _features[^1].Title;
                var statusClass = GetStatusClass(feature.Status);
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => Toggle(feature.Title))">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@feature.Title</span>
                                <span class="@($"inline-flex shrink-0 items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium {statusClass}")">
                                    @feature.Status
                                </span>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">@feature.Description</p>
                        </div>
                        <span class="shrink-0 text-[11px] text-muted-foreground/60">
                            @feature.TargetDate
                        </span>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>
                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3">
                            <div class="rounded-md bg-muted/50 p-3">
                                <p class="text-xs text-muted-foreground leading-relaxed">
                                    @feature.Details
                                </p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record UpcomingFeature(string Title, string Description, string TargetDate, string Status, string Details);

    private static readonly UpcomingFeature[] _features =
    [
        new("Real-time collaboration cursors",
            "See teammate cursors and selections live in the editor.",
            "Q2 2026",
            "In Development",
            "Multi-user presence with color-coded cursors, name labels, and selection highlighting. Built on WebSocket with CRDT conflict resolution."),
        new("AI-powered code review",
            "Automated suggestions for code quality and security issues.",
            "Q2 2026",
            "Beta",
            "Uses LLM analysis to flag potential bugs, security vulnerabilities, and style inconsistencies. Inline suggestions with one-click apply."),
        new("Custom workflow automations",
            "Build trigger-action workflows without code.",
            "Q3 2026",
            "Planned",
            "Visual workflow builder with triggers like on push, on PR merge, and on schedule. Connect to Slack, email, Jira, and webhooks."),
        new("Advanced analytics dashboard",
            "Team productivity metrics and deployment frequency insights.",
            "Q3 2026",
            "In Development",
            "DORA metrics tracking, cycle time analysis, and contributor activity heatmaps. Exportable reports for engineering leadership."),
        new("Plugin marketplace",
            "Install community extensions to customize your workspace.",
            "Q4 2026",
            "Planned",
            "TypeScript SDK for building plugins. Marketplace with reviews, ratings, and verified publisher badges. Sandboxed execution environment."),
        new("Offline mode with sync",
            "Work without internet and sync changes when reconnected.",
            "Q4 2026",
            "Planned",
            "Local-first architecture with IndexedDB storage. Automatic conflict resolution on reconnect. Priority queue for syncing critical changes first."),
    ];

    private string? _expanded;

    private void Toggle(string title)
    {
        _expanded = _expanded == title ? null : title;
    }

    private static string GetStatusClass(string status) => status switch
    {
        "Planned" => "bg-muted text-muted-foreground",
        "In Development" => "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        "Beta" => "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        _ => ""
    };
}
