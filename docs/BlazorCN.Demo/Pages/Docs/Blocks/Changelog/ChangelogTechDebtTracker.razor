@* ============================================================
   Block: changelog-tech-debt-tracker
   Title: ChangelogTechDebtTracker
   Description: A changelog block tracking technical debt items with effort estimates, priority scoring, and resolution progress built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-tech-debt-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Technical Debt Tracker</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Quality improvements across releases
                    </p>
                </div>
                <LucideIconCn Name="wrench" Size="16" Class="size-4 text-muted-foreground" />
            </div>
        </div>

        @* Stats *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-4 gap-4">
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="triangle-alert" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Active Debt</span>
                    </div>
                    <p class="mt-1 font-semibold tabular-nums text-2xl text-amber-600">
                        @_activeDebt
                    </p>
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Resolved</span>
                    </div>
                    <p class="mt-1 font-semibold tabular-nums text-2xl text-emerald-600">
                        @_totalResolved
                    </p>
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Added</span>
                    </div>
                    <p class="mt-1 font-semibold tabular-nums text-2xl">@_totalAdded</p>
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="wrench" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Completion</span>
                    </div>
                    <p class="mt-1 font-semibold tabular-nums text-2xl">
                        @(((int)Math.Round((double)_totalResolved / _totalItems * 100)))%
                    </p>
                </div>
            </div>
        </div>

        @* Releases *@
        <div>
            @foreach (var rel in _releases)
            {
                var release = rel;
                var isExpanded = _expandedId == release.Id;
                var isLast = release.Id == _releases[^1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => ToggleRelease(release.Id))">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted">
                            <LucideIconCn Name="wrench" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@release.Version</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 border-0 bg-emerald-500/10 px-1.5 text-[10px] text-emerald-600">
                                    @release.ResolvedDebt resolved
                                </BadgeCn>
                                @if (release.AddedDebt > 0)
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 border-0 bg-amber-500/10 px-1.5 text-[10px] text-amber-600">
                                        @release.AddedDebt added
                                    </BadgeCn>
                                }
                            </div>
                            <div class="mt-0.5 flex items-center gap-3 text-xs text-muted-foreground">
                                <span class="tabular-nums">@release.Date</span>
                                <span>•</span>
                                <span>@release.TotalDebt @(release.TotalDebt == 1 ? "item" : "items")</span>
                                <span>•</span>
                                <span>@(((int)Math.Round((double)release.ResolvedDebt / release.TotalDebt * 100)))% complete</span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/30 px-4 py-3">
                            <div class="space-y-2">
                                @foreach (var it in release.DebtItems)
                                {
                                    var item = it;
                                    <div class="rounded-md border bg-card p-3">
                                        <div class="flex items-start justify-between">
                                            <div class="flex items-start gap-2">
                                                <span class="@Cn.Merge("mt-0.5 size-1.5 shrink-0 rounded-full", GetPriorityColor(item.Priority))" />
                                                <div class="min-w-0">
                                                    <div class="flex items-center gap-2">
                                                        <span class="font-medium text-sm">@item.Title</span>
                                                    </div>
                                                    <div class="mt-1 flex items-center gap-2">
                                                        <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("h-4 border-0 px-1.5 text-[10px]", GetCategoryColor(item.Category))">
                                                            @GetCategoryLabel(item.Category)
                                                        </BadgeCn>
                                                        <div class="flex items-center gap-1">
                                                            @GetStatusIcon(item.Status)
                                                            <span class="text-xs text-muted-foreground">
                                                                @GetStatusLabel(item.Status)
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div class="mt-2 grid grid-cols-2 gap-3 text-xs">
                                                        <div>
                                                            <span class="text-muted-foreground">Effort:</span>
                                                            <span class="font-medium"> @item.Effort</span>
                                                        </div>
                                                        <div>
                                                            <span class="text-muted-foreground">Impact:</span>
                                                            <span class="font-medium"> @item.Impact</span>
                                                        </div>
                                                        <div>
                                                            <span class="text-muted-foreground">Owner:</span>
                                                            <span> @item.Owner</span>
                                                        </div>
                                                        <div>
                                                            <span class="text-muted-foreground">Created:</span>
                                                            <span> @item.CreatedAt</span>
                                                        </div>
                                                    </div>
                                                    @if (item.CompletedAt is not null)
                                                    {
                                                        <div class="mt-2 rounded-md bg-emerald-500/10 px-2 py-1 text-emerald-600 text-xs">
                                                            Completed @item.CompletedAt
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-xs text-muted-foreground">
                    @_totalItems total items • @_activeDebt active • @_totalResolved resolved
                </span>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="h-7 gap-1.5 px-2 text-xs">
                    View Backlog
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record DebtItem(
        string Id,
        string Title,
        string Category,
        string Priority,
        string Status,
        string Effort,
        string Impact,
        string Owner,
        string CreatedAt,
        string? CompletedAt = null
    );

    private record Release(
        string Id,
        string Version,
        string Date,
        int TotalDebt,
        int ResolvedDebt,
        int AddedDebt,
        DebtItem[] DebtItems
    );

    private static readonly Release[] _releases =
    [
        new("1", "v2.5.0", "2026-03-30", 3, 2, 1,
        [
            new("td1", "Migrate from Jest to Vitest for faster test execution", "testing", "high", "completed", "3 days", "50% faster CI pipeline", "Sarah Chen", "2 weeks ago", "2 days ago"),
            new("td2", "Remove deprecated payment API v1 endpoints", "refactor", "medium", "completed", "2 days", "Reduce maintenance burden", "Marcus Rodriguez", "1 month ago", "3 days ago"),
            new("td3", "Add integration tests for webhook processing", "testing", "high", "in-progress", "4 days", "Prevent payment failures", "Alex Thompson", "1 week ago"),
        ]),
        new("2", "v2.4.0", "2026-03-22", 4, 1, 3,
        [
            new("td4", "Upgrade Next.js from 14 to 15 for App Router improvements", "upgrade", "medium", "completed", "5 days", "Better performance, new features", "Jamie Kim", "3 weeks ago", "1 week ago"),
            new("td5", "Extract shared authentication logic into library", "refactor", "medium", "open", "6 days", "Reduce code duplication", "Taylor Morgan", "2 weeks ago"),
            new("td6", "Add database connection pooling for better concurrency", "performance", "high", "open", "3 days", "Handle 2x traffic", "Jordan Lee", "2 weeks ago"),
            new("td7", "Fix N+1 query in user dashboard endpoint", "performance", "high", "open", "1 day", "90% faster page load", "Alex Thompson", "10 days ago"),
        ]),
        new("3", "v2.3.0", "2026-03-15", 2, 2, 0,
        [
            new("td8", "Implement rate limiting on public API endpoints", "security", "high", "completed", "4 days", "Prevent abuse, reduce costs", "Sarah Chen", "1 month ago", "2 weeks ago"),
            new("td9", "Replace custom date handling with date-fns library", "refactor", "low", "completed", "2 days", "Fewer timezone bugs", "Marcus Rodriguez", "3 weeks ago", "2 weeks ago"),
        ]),
    ];

    private string? _expandedId;

    private int _totalItems => _releases.Sum(r => r.TotalDebt);
    private int _totalResolved => _releases.Sum(r => r.ResolvedDebt);
    private int _totalAdded => _releases.Sum(r => r.AddedDebt);
    private int _activeDebt => _totalItems - _totalResolved;

    private void ToggleRelease(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private static string GetCategoryColor(string category) => category switch
    {
        "performance" => "bg-blue-500/10 text-blue-600",
        "security" => "bg-red-500/10 text-red-600",
        "testing" => "bg-emerald-500/10 text-emerald-600",
        "refactor" => "bg-purple-500/10 text-purple-600",
        "upgrade" => "bg-amber-500/10 text-amber-600",
        _ => ""
    };

    private static string GetCategoryLabel(string category) => category switch
    {
        "performance" => "Performance",
        "security" => "Security",
        "testing" => "Testing",
        "refactor" => "Refactor",
        "upgrade" => "Upgrade",
        _ => category
    };

    private static string GetPriorityColor(string priority) => priority switch
    {
        "high" => "bg-red-500",
        "medium" => "bg-amber-500",
        "low" => "bg-blue-500",
        _ => ""
    };

    private static RenderFragment GetStatusIcon(string status) => status switch
    {
        "open" => @<LucideIconCn Name="triangle-alert" Size="12" Class="size-3 text-amber-600" />,
        "in-progress" => @<LucideIconCn Name="clock" Size="12" Class="size-3 text-blue-600" />,
        "completed" => @<LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-600" />,
        _ => @<span />
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "open" => "Open",
        "in-progress" => "In Progress",
        "completed" => "Completed",
        _ => status
    };
}
