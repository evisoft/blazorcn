@* ============================================================
   Block: changelog-announcement-banner
   Title: ChangelogAnnouncementBanner
   Description: An announcement banner changelog block built with React, Next.js, shadcn/ui, and Tailwind CSS with a hero banner for the latest update and compact recent entries
   Source: original/blocks/changelog/changelog-announcement-banner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="megaphone" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">What&#39;s New</h2>
        </div>

        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sparkles" Size="14" Class="size-3.5 text-amber-500" />
                <span class="text-xs font-medium text-amber-600 dark:text-amber-400">
                    Latest Release
                </span>
                <BadgeCn Variant="BadgeVariant.Outline" Class="ml-auto font-mono text-xs font-normal">
                    v@(_featured.Version)
                </BadgeCn>
            </div>
            <h3 class="mt-2 text-base font-semibold">@_featured.Title</h3>
            <p class="mt-1 text-sm text-muted-foreground">@_featured.Description</p>

            @if (_featured.Highlights != null)
            {
                <div class="mt-3 space-y-1.5">
                    @foreach (var highlight in _featured.Highlights)
                    {
                        <div class="flex items-center gap-2">
                            <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                            <span class="text-xs text-muted-foreground">@highlight</span>
                        </div>
                    }
                </div>
            }

            <div class="mt-3 flex items-center justify-between">
                <span class="text-xs text-muted-foreground/60">@_featured.Date</span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                    Read full notes
                    <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

        <div class="px-4 py-2.5">
            <span class="text-xs font-medium text-muted-foreground">Previous Releases</span>
        </div>

        <div>
            @for (var idx = 0; idx < _recent.Length; idx++)
            {
                var entry = _recent[idx];
                var rowClass = Cn.Merge("flex items-start gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", idx < _recent.Length - 1 ? "border-b" : "");
                <div class="@rowClass">
                    <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-muted-foreground/40"></span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@entry.Title</span>
                            <BadgeCn Variant="BadgeVariant.Outline" Class="shrink-0 font-mono text-xs font-normal">
                                v@(entry.Version)
                            </BadgeCn>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">@entry.Description</p>
                    </div>
                    <span class="shrink-0 pt-0.5 text-xs text-muted-foreground/60">@entry.Date</span>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Announcement(
        string Id,
        string Version,
        string Title,
        string Description,
        string Date,
        string[]? Highlights = null
    );

    private static readonly Announcement _featured = new(
        "a1",
        "3.2.0",
        "Team Permissions Overhaul",
        "Granular role-based access controls are here. Assign workspace-level and project-level permissions, create custom roles, and manage invite links with expiration. This is our biggest security update this quarter.",
        "Mar 27, 2026",
        [
            "Custom roles with granular permission scopes",
            "Invite links with expiration and usage limits",
            "Audit log for all permission changes",
        ]
    );

    private static readonly Announcement[] _recent =
    [
        new("a2", "3.1.2", "Dashboard Performance Patch",
            "Fixed memory leak in real-time charts and reduced initial load time by 40%.",
            "Mar 18, 2026"),
        new("a3", "3.1.0", "API v2 with Cursor Pagination",
            "New REST API version with cursor-based pagination and 60% faster response times.",
            "Mar 10, 2026"),
        new("a4", "3.0.0", "Platform Redesign",
            "Completely redesigned dashboard with customizable layouts and dark mode support.",
            "Feb 28, 2026"),
        new("a5", "2.9.5", "Export & Integrations",
            "PDF export with custom branding and Slack integration for real-time notifications.",
            "Feb 14, 2026"),
    ];
}
