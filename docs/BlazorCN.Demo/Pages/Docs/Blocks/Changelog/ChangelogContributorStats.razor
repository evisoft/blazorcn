@* ============================================================
   Block: changelog-contributor-stats
   Title: ChangelogContributorStats
   Description: A changelog block displaying top contributors with avatar initials and commit count bars alongside recent entries attributed to each contributor.
   Source: original/blocks/changelog/changelog-contributor-stats.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Top Contributors</span>
            </div>
            <span class="text-xs text-muted-foreground">This release</span>
        </div>

        <div>
            @foreach (var contributor in _contributors)
            {
                <div class="flex items-center gap-3 border-b px-4 py-2.5">
                    <div class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded-full text-xs font-medium text-white", contributor.Color)">
                        @contributor.Initials
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-medium">@contributor.Name</span>
                            <span class="text-xs tabular-nums text-muted-foreground">
                                @contributor.Commits commits
                            </span>
                        </div>
                        <div class="mt-1.5 h-1.5 w-full rounded-full bg-muted">
                            <div class="@Cn.Merge("h-full rounded-full", contributor.Color)"
                                 style="@($"width:{contributor.Commits * 100.0 / MaxCommits:F2}%")">
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-b px-4 py-2">
            <span class="text-xs font-medium text-muted-foreground">Recent entries</span>
        </div>

        <div>
            @for (var i = 0; i < _recentEntries.Length; i++)
            {
                var entry = _recentEntries[i];
                var entryClass = i < _recentEntries.Length - 1 ? "flex items-center gap-3 px-4 py-2.5 border-b" : "flex items-center gap-3 px-4 py-2.5";
                <div class="@entryClass">
                    <div class="@Cn.Merge("flex size-6 shrink-0 items-center justify-center rounded-full text-[10px] font-medium text-white", entry.Color)">
                        @entry.Initials
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="text-sm font-medium">@entry.Title</span>
                    </div>
                    <span class="shrink-0 text-xs text-muted-foreground">@entry.Date</span>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Contributor(string Name, string Initials, int Commits, string Color);
    private record RecentEntry(string Title, string ContributorName, string Initials, string Color, string Date);

    private const int MaxCommits = 47;

    private static readonly Contributor[] _contributors =
    [
        new("Sarah Chen",    "SC", 47, "bg-blue-500"),
        new("Marcus Rivera", "MR", 34, "bg-emerald-500"),
        new("Priya Sharma",  "PS", 28, "bg-amber-500"),
        new("Alex Kim",      "AK", 19, "bg-violet-500"),
    ];

    private static readonly RecentEntry[] _recentEntries =
    [
        new("Refactored authentication middleware", "Sarah Chen",    "SC", "bg-blue-500",    "Mar 25"),
        new("Added batch processing for webhooks",  "Marcus Rivera", "MR", "bg-emerald-500", "Mar 24"),
        new("Fixed timezone offset in scheduler",   "Priya Sharma",  "PS", "bg-amber-500",   "Mar 23"),
        new("Improved query plan caching",          "Sarah Chen",    "SC", "bg-blue-500",    "Mar 22"),
        new("Added CSV export for audit logs",      "Alex Kim",      "AK", "bg-violet-500",  "Mar 21"),
    ];
}
