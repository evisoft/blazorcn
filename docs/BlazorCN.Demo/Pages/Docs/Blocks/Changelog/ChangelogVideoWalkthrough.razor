@* ============================================================
   Block: changelog-video-walkthrough
   Title: ChangelogVideoWalkthrough
   Description: React video embed changelog block for Next.js with thumbnail previews, play overlays, duration badges, and expandable entry details built with shadcn/ui, Tailwind CSS, and Framer Motion animations.
   Source: original/blocks/changelog/changelog-video-walkthrough.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="video" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">Video Walkthroughs</span>
            <span class="ml-auto text-xs text-muted-foreground">@_entries.Length updates</span>
        </div>

        @* Entries *@
        <div>
            @foreach (var ent in _entries)
            {
                var entry = ent;
                var isExpanded = _expanded == entry.Id;
                var isPlaying = _playing == entry.Id;
                var isLast = entry.Id == _entries[^1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => SetExpanded(entry.Id, isExpanded))">
                        @* Thumbnail *@
                        <div class="relative size-10 shrink-0 overflow-hidden rounded bg-zinc-800">
                            <div class="flex size-full items-center justify-center">
                                <span class="font-mono text-[8px] text-zinc-400">@entry.ThumbnailLabel</span>
                            </div>
                            <div class="absolute inset-0 flex items-center justify-center bg-black/30">
                                <LucideIconCn Name="play" Size="12" Class="size-3 fill-white text-white" />
                            </div>
                        </div>

                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate text-sm font-medium">@entry.Title</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-1.5 text-xs text-muted-foreground">
                                <span class="font-mono tabular-nums">v@entry.Version</span>
                                <span class="text-muted-foreground/40">&middot;</span>
                                <span>@entry.Date</span>
                                <span class="text-muted-foreground/40">&middot;</span>
                                <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                <span class="tabular-nums">@entry.Duration</span>
                            </div>
                        </div>

                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-3 px-4 pb-4">
                                @* Video player area *@
                                <div class="relative overflow-hidden rounded-md bg-zinc-900">
                                    @if (isPlaying)
                                    {
                                        <div class="relative aspect-video">
                                            <div class="flex size-full items-center justify-center">
                                                <div class="text-center">
                                                    <span class="font-mono text-sm text-zinc-400">@entry.ThumbnailLabel — v@entry.Version</span>
                                                    <p class="mt-1 text-xs text-zinc-500">Video playing</p>
                                                </div>
                                            </div>
                                            <button type="button"
                                                    class="absolute right-2 top-2 flex size-6 items-center justify-center rounded-full bg-black/50 text-white transition-colors hover:bg-black/70"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="@(() => _playing = null)"
                                                    aria-label="Close video">
                                                <LucideIconCn Name="x" Size="12" Class="size-3" />
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        var playEntry = entry;
                                        <button type="button"
                                                class="group/play relative aspect-video w-full"
                                                @onclick:stopPropagation="true"
                                                @onclick="@(() => _playing = playEntry.Id)"
                                                aria-label="@($"Play walkthrough for {playEntry.Title}")">
                                            <div class="flex size-full items-center justify-center">
                                                <span class="font-mono text-sm text-zinc-500">@playEntry.ThumbnailLabel</span>
                                            </div>
                                            <div class="absolute inset-0 flex items-center justify-center bg-black/20 transition-colors group-hover/play:bg-black/30">
                                                <div class="flex size-10 items-center justify-center rounded-full bg-white/90 transition-transform group-hover/play:scale-110">
                                                    <LucideIconCn Name="play" Size="16" Class="size-4 fill-zinc-900 text-zinc-900" />
                                                </div>
                                            </div>
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="absolute bottom-2 right-2 bg-black/60 font-mono text-[10px] text-white">
                                                @playEntry.Duration
                                            </BadgeCn>
                                        </button>
                                    }
                                </div>

                                @* Description *@
                                <p class="text-sm leading-relaxed text-muted-foreground">@entry.Description</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record VideoEntry(string Id, string Version, string Title, string Description, string Date, string Duration, string ThumbnailColor, string ThumbnailLabel);

    private static readonly VideoEntry[] _entries =
    [
        new("v-1", "4.0.0", "Redesigned dashboard with customizable widgets",
            "Drag and drop widgets to build your perfect dashboard layout. Resize, reorder, and pin widgets. Layouts save per-workspace and sync across devices.",
            "Mar 30, 2026", "2:34", "bg-zinc-800", "Dashboard v4"),
        new("v-2", "3.9.0", "Real-time multiplayer editing with presence indicators",
            "See who is editing in real time with colored cursors and name labels. Conflict resolution happens automatically with operational transforms.",
            "Mar 26, 2026", "1:48", "bg-zinc-800", "Multiplayer"),
        new("v-3", "3.8.0", "Advanced query builder with visual filters",
            "Build complex data queries without writing SQL. Chain filter conditions, group by fields, and preview results in real time before saving.",
            "Mar 22, 2026", "3:12", "bg-zinc-800", "Query Builder"),
        new("v-4", "3.7.0", "Automated workflow triggers and actions",
            "Create if-this-then-that automations with a visual workflow editor. Supports webhooks, email notifications, Slack messages, and database mutations as actions.",
            "Mar 18, 2026", "2:56", "bg-zinc-800", "Workflows"),
        new("v-5", "3.6.0", "Keyboard shortcuts and command palette",
            "Navigate anywhere with Cmd+K. Over 40 keyboard shortcuts for power users. Fully customizable key bindings saved to your profile.",
            "Mar 14, 2026", "1:22", "bg-zinc-800", "Cmd+K"),
    ];

    private string? _expanded;
    private string? _playing;

    private void SetExpanded(string id, bool isCurrentlyExpanded)
    {
        _expanded = isCurrentlyExpanded ? null : id;
        if (isCurrentlyExpanded)
            _playing = null;
    }
}
