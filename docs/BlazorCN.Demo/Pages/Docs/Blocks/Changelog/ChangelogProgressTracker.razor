@* ============================================================
   Block: changelog-progress-tracker
   Title: ChangelogProgressTracker
   Description: React changelog block with feature completion progress bars for Next.js showing upcoming features with percentage tracking built with TypeScript, shadcn/ui Progress, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-progress-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="gauge" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Feature Progress</h2>
            <span class="ml-auto text-xs text-muted-foreground">
                @_features.Count(f => f.Status == "completed") of @_features.Length shipped
            </span>
        </div>

        @* Feature rows *@
        @for (var i = 0; i < _features.Length; i++)
        {
            var feature = _features[i];
            var isLast = i == _features.Length - 1;

            <div class="@(isLast ? "" : "border-b") px-4 py-3">
                <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@feature.Title</span>
                            <span class="@Cn.Merge("text-xs font-medium", GetStatusLabel(feature.Status))">
                                @GetStatusText(feature.Status)
                            </span>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">@feature.Description</p>
                    </div>
                    <span class="shrink-0 text-sm font-medium tabular-nums">@feature.Progress%</span>
                </div>
                <div class="mt-2">
                    <ProgressCn Value="@feature.Progress" Class="h-1.5" />
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Feature(string Title, string Description, int Progress, string Status);

    private static readonly Feature[] _features =
    [
        new(
            "Real-time collaboration engine",
            "Multiplayer cursors, live presence indicators, and conflict-free replicated data types for seamless team editing.",
            100,
            "completed"
        ),
        new(
            "Granular permission system",
            "Role-based access control with custom permission sets, audit logging, and workspace-level overrides.",
            100,
            "completed"
        ),
        new(
            "Plugin marketplace",
            "Third-party integrations with sandboxed execution, version management, and a developer SDK for custom plugins.",
            78,
            "in-progress"
        ),
        new(
            "Advanced analytics dashboard",
            "Custom metric builder with cohort analysis, funnel visualization, and exportable PDF reports.",
            52,
            "in-progress"
        ),
        new(
            "Mobile offline mode",
            "Local-first data sync with background queue processing and automatic conflict resolution on reconnect.",
            31,
            "in-progress"
        ),
        new(
            "AI-powered search",
            "Semantic search across all workspace content with natural language queries and contextual ranking.",
            0,
            "planned"
        ),
    ];

    private static string GetStatusLabel(string status) => status switch
    {
        "completed"   => "text-emerald-600 dark:text-emerald-400",
        "in-progress" => "text-blue-600 dark:text-blue-400",
        _             => "text-muted-foreground",
    };

    private static string GetStatusText(string status) => status switch
    {
        "completed"   => "Completed",
        "in-progress" => "In Progress",
        _             => "Planned",
    };
}
