@* ============================================================
   Block: changelog-stacked-cards
   Title: ChangelogStackedCards
   Description: React stacked cards changelog block for Next.js with overlapping offset cards, category dot indicators, and smooth stagger animations built with TypeScript, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-stacked-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="layers" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Changelog</h2>
            <span class="ml-auto text-xs text-muted-foreground">@_entries.Length updates</span>
        </div>

        <div class="relative space-y-3 px-4 py-4">
            @foreach (var entry in _entries)
            {
                var i = Array.IndexOf(_entries, entry);
                <div class="@Cn.Merge("relative rounded-lg border bg-card px-4 py-3 shadow-sm transition-shadow hover:shadow-md", i > 0 ? "-mt-1" : "")"
                     style="@($"margin-left:{i * 4}px;z-index:{_entries.Length - i}")">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", GetDotColor(entry.Category))"></span>
                                <span class="truncate text-sm font-medium">@entry.Title</span>
                            </div>
                            <p class="mt-1 text-xs text-muted-foreground leading-relaxed">@entry.Description</p>
                        </div>
                        <span class="shrink-0 text-xs text-muted-foreground">@entry.Date</span>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Entry(string Title, string Description, string Date, string Category);

    private static string GetDotColor(string category) => category switch
    {
        "feature"     => "bg-emerald-500",
        "fix"         => "bg-red-500",
        "improvement" => "bg-blue-500",
        "breaking"    => "bg-amber-500",
        _             => "",
    };

    private static readonly Entry[] _entries =
    [
        new("Collaborative workspaces",
            "Teams can now share and co-edit workspaces with granular permission controls and real-time sync.",
            "Mar 28", "feature"),
        new("Fixed export timeout on large datasets",
            "Resolved an issue where CSV exports would fail silently when exceeding 50k rows.",
            "Mar 26", "fix"),
        new("Dashboard load time reduced by 40%",
            "Optimized initial query batching and lazy-loaded non-critical widgets for faster first paint.",
            "Mar 24", "improvement"),
        new("API v2 authentication required",
            "All API v1 token-based endpoints now require migration to OAuth 2.0 bearer tokens.",
            "Mar 22", "breaking"),
        new("Inline comment threads",
            "Add threaded comments directly on any cell or field within your project tables.",
            "Mar 20", "feature"),
        new("Webhook retry logic improved",
            "Failed webhook deliveries now retry with exponential backoff up to 5 attempts over 24 hours.",
            "Mar 18", "improvement"),
    ];
}
