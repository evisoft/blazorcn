@* ============================================================
   Block: changelog-grouped-date
   Title: ChangelogGroupedDate
   Description: React date-grouped changelog block for Next.js with daily change sections, category dots, and staggered animations built with TypeScript, shadcn/ui, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-grouped-date.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="calendar-days" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Daily Changelog</span>
        </div>

        @* Date groups *@
        <div>
            @for (int groupIndex = 0; groupIndex < _dateGroups.Length; groupIndex++)
            {
                var group = _dateGroups[groupIndex];
                var isLastGroup = groupIndex == _dateGroups.Length - 1;
                <div class="@(isLastGroup ? "" : "border-b")">

                    @* Date header *@
                    <div class="bg-muted/30 px-4 py-2">
                        <span class="font-medium text-muted-foreground text-xs">@group.Date</span>
                    </div>

                    @* Changes *@
                    @for (int changeIndex = 0; changeIndex < group.Changes.Length; changeIndex++)
                    {
                        var change = group.Changes[changeIndex];
                        var isLastChange = changeIndex == group.Changes.Length - 1;
                        <div class="@Cn.Merge("flex items-start gap-3 px-4 py-2.5", isLastChange ? "" : "border-b border-dashed")">
                            <span class="@Cn.Merge("mt-1.5 size-2 shrink-0 rounded-full", GetDotColor(change.Category))" aria-hidden="true" />
                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-sm">@change.Title</span>
                                <p class="mt-0.5 text-muted-foreground text-xs">@change.Description</p>
                            </div>
                        </div>
                    }

                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Change(string Title, string Description, string Category);

    private record DateGroup(string Date, Change[] Changes);

    private static string GetDotColor(string category) => category switch
    {
        "added"    => "bg-emerald-500",
        "fixed"    => "bg-red-500",
        "improved" => "bg-blue-500",
        _          => "bg-gray-500",
    };

    private static readonly DateGroup[] _dateGroups =
    [
        new("March 28, 2026",
        [
            new("Multi-cursor collaboration",
                "See teammate cursors and selections in real time across shared documents.",
                "added"),
            new("Keyboard shortcut conflicts",
                "Resolved duplicate bindings between the editor and command palette.",
                "fixed"),
        ]),
        new("March 27, 2026",
        [
            new("Faster image optimization",
                "WebP conversion now runs in a worker thread, reducing processing time by 60%.",
                "improved"),
            new("Broken avatar uploads on Safari",
                "Fixed a blob URL revocation timing issue causing blank avatars on Safari 18.",
                "fixed"),
            new("Audit log export",
                "Export workspace audit logs as CSV with date range filters and user filters.",
                "added"),
        ]),
        new("March 26, 2026",
        [
            new("Edge function cold starts",
                "Reduced cold start latency from 120ms to 45ms through function bundling optimizations.",
                "improved"),
            new("Drag-and-drop file organizer",
                "Rearrange project files and folders with drag-and-drop in the sidebar.",
                "added"),
        ]),
        new("March 25, 2026",
        [
            new("SSO login redirect loop",
                "Fixed an infinite redirect when SAML assertion contained multi-value attributes.",
                "fixed"),
        ]),
    ];
}
