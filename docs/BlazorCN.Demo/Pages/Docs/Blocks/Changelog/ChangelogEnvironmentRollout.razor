@* ============================================================
   Block: changelog-environment-rollout
   Title: ChangelogEnvironmentRollout
   Description: An environment rollout changelog block for React and Next.js with staged deployment progress, environment status indicators, and rollout percentage bars built with shadcn/ui and Tailwind CSS
   Source: original/blocks/changelog/changelog-environment-rollout.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="rocket" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Rollout Status</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                v3.12.0
            </BadgeCn>
        </div>

        @* Summary *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                <span>2 of 4 environments deployed</span>
                <span>&middot;</span>
                <span>Canary rollout at 62%</span>
                <span>&middot;</span>
                <span>No errors detected</span>
            </div>
        </div>

        @* Environment rows *@
        @for (var i = 0; i < _environments.Length; i++)
        {
            var env = _environments[i];
            <div class="@Cn.Merge("px-4 py-3", i < _environments.Length - 1 ? "border-b" : "")">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="@GetStatusIconName(env.Status)" Size="16" Class="@GetStatusIconClass(env.Status)" />
                        <span class="text-sm font-medium">@env.Name</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="font-mono text-xs text-muted-foreground">@env.Version</span>
                        <span class="text-xs text-muted-foreground">@env.UpdatedAt</span>
                    </div>
                </div>

                @* Progress bar *@
                <div class="mt-2 flex items-center gap-3">
                    <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                        <div class="@GetProgressBarClass(env.Status)" style="@($"width:{env.RolloutPercent}%")"></div>
                    </div>
                    <span class="w-8 text-right font-mono text-xs text-muted-foreground tabular-nums">
                        @env.RolloutPercent%
                    </span>
                </div>
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-xs text-muted-foreground">
                Auto-refreshes every 30 seconds · Last check 12s ago
            </p>
        </div>
    </div>
</section>

@code {
    private record EnvRow(string Id, string Name, string Version, string Status, int RolloutPercent, string UpdatedAt);

    private static readonly EnvRow[] _environments =
    [
        new("dev",     "Development",  "v3.12.0-rc.4", "deployed", 100, "12 min ago"),
        new("staging", "Staging",      "v3.12.0-rc.4", "deployed", 100, "8 min ago"),
        new("canary",  "Canary (5%)",  "v3.12.0",      "rolling",   62, "3 min ago"),
        new("prod",    "Production",   "v3.11.2",      "pending",    0, "2 days ago"),
    ];

    private static string GetStatusIconName(string status) => status switch
    {
        "deployed" => "check-circle",
        "rolling"  => "circle-dot",
        _          => "clock",
    };

    private static string GetStatusIconClass(string status) => status switch
    {
        "deployed" => "size-4 text-emerald-600 dark:text-emerald-400",
        "rolling"  => "size-4 text-blue-600 dark:text-blue-400",
        _          => "size-4 text-muted-foreground",
    };

    private static string GetProgressBarClass(string status) => status switch
    {
        "deployed" => "h-full rounded-full bg-emerald-500",
        "rolling"  => "h-full rounded-full bg-blue-500",
        _          => "h-full rounded-full bg-muted-foreground/20",
    };
}
