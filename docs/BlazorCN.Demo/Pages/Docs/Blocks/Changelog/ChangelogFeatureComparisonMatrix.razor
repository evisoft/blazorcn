@* ============================================================
   Block: changelog-feature-comparison-matrix
   Title: ChangelogFeatureComparisonMatrix
   Description: A comprehensive feature comparison matrix across multiple versions showing capabilities at a glance with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-feature-comparison-matrix.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Feature Comparison Matrix</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Compare capabilities across versions
            </p>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b bg-muted/50">
                        <th class="px-4 py-3 text-left font-medium">Feature</th>
                        @foreach (var version in _versions)
                        {
                            <th class="px-4 py-3 text-center font-medium">
                                <div class="flex flex-col items-center gap-1">
                                    <span>@version.Label</span>
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("h-5 px-1.5 text-xs", GetStatusBadgeClass(version.Status))">
                                        @version.Status
                                    </BadgeCn>
                                </div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in _categories)
                    {
                        var catFeatures = _features.Where(f => f.Category == category).ToArray();
                        <tr class="border-b bg-muted/30">
                            <td colspan="4" class="px-4 py-2 text-xs font-medium text-muted-foreground">
                                @category
                            </td>
                        </tr>
                        @foreach (var feature in catFeatures)
                        {
                            <tr class="border-b last:border-b-0 hover:bg-muted/50">
                                <td class="px-4 py-3 text-sm">@feature.Name</td>
                                @foreach (var ver in _versions)
                                {
                                    var status = GetVersionStatus(feature, ver.Key);
                                    <td class="px-4 py-3">
                                        <div class="flex items-center justify-center">
                                            @if (status == FeatureStatus.Available)
                                            {
                                                <LucideIconCn Name="check" Size="16" Class="size-4 text-emerald-500" />
                                            }
                                            else if (status == FeatureStatus.Partial)
                                            {
                                                <LucideIconCn Name="minus" Size="16" Class="size-4 text-amber-500" />
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="x" Size="16" Class="size-4 text-muted-foreground/40" />
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="border-t bg-muted/50 px-4 py-3">
            <div class="flex items-center gap-4 text-xs text-muted-foreground">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="info" Size="14" Class="size-3.5" />
                    <span>Legend:</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                    <span>Available</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="minus" Size="14" Class="size-3.5 text-amber-500" />
                    <span>Partial</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="x" Size="14" Class="size-3.5 text-muted-foreground/40" />
                    <span>Not available</span>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private enum FeatureStatus { Available, Partial, Unavailable }

    private record Feature(string Name, string Category, FeatureStatus V1, FeatureStatus V2, FeatureStatus V3);
    private record VersionDef(string Key, string Label, string Status);

    private static string GetStatusBadgeClass(string status) => status switch
    {
        "legacy" => "bg-muted text-muted-foreground",
        "stable" => "bg-blue-500/10 text-blue-500",
        "latest" => "bg-emerald-500/10 text-emerald-500",
        _ => ""
    };

    private static FeatureStatus GetVersionStatus(Feature feature, string key) => key switch
    {
        "v1" => feature.V1,
        "v2" => feature.V2,
        "v3" => feature.V3,
        _ => FeatureStatus.Unavailable
    };

    private static readonly VersionDef[] _versions =
    [
        new("v1", "v1.0", "legacy"),
        new("v2", "v2.0", "stable"),
        new("v3", "v3.0", "latest"),
    ];

    private static readonly Feature[] _features =
    [
        new("Email/Password Authentication", "Authentication", FeatureStatus.Available,   FeatureStatus.Available,    FeatureStatus.Available),
        new("OAuth 2.0 (Google, GitHub)",    "Authentication", FeatureStatus.Unavailable, FeatureStatus.Available,    FeatureStatus.Available),
        new("Magic Link Sign-in",            "Authentication", FeatureStatus.Unavailable, FeatureStatus.Partial,      FeatureStatus.Available),
        new("Multi-Factor Authentication",   "Authentication", FeatureStatus.Unavailable, FeatureStatus.Unavailable,  FeatureStatus.Available),
        new("REST API",          "API", FeatureStatus.Available,   FeatureStatus.Available,   FeatureStatus.Available),
        new("GraphQL API",       "API", FeatureStatus.Unavailable, FeatureStatus.Available,   FeatureStatus.Available),
        new("WebSocket Support", "API", FeatureStatus.Unavailable, FeatureStatus.Partial,     FeatureStatus.Available),
        new("Rate Limiting",     "API", FeatureStatus.Partial,     FeatureStatus.Available,   FeatureStatus.Available),
        new("Component Library",        "UI", FeatureStatus.Available,   FeatureStatus.Available,    FeatureStatus.Available),
        new("Dark Mode",                "UI", FeatureStatus.Unavailable, FeatureStatus.Available,    FeatureStatus.Available),
        new("Theming System",           "UI", FeatureStatus.Unavailable, FeatureStatus.Unavailable,  FeatureStatus.Available),
        new("Accessibility (WCAG 2.1)", "UI", FeatureStatus.Partial,     FeatureStatus.Available,    FeatureStatus.Available),
    ];

    private static readonly string[] _categories = _features
        .Select(f => f.Category)
        .Distinct()
        .ToArray();
}
