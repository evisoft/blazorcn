@* ============================================================
   Block: changelog-migration-guide
   Title: ChangelogMigrationGuide
   Description: A changelog block showing step-by-step migration instructions with numbered steps, code snippet blocks, and a migration deadline badge for version upgrades.
   Source: original/blocks/changelog/changelog-migration-guide.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="wrench" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Migration Guide</span>
                <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">@_guide.Version</BadgeCn>
            </div>
            <div class="flex items-center gap-1.5 rounded-md bg-red-500/10 px-2 py-1">
                <LucideIconCn Name="alert-triangle" Size="12" Class="size-3 text-red-600" />
                <span class="font-medium text-red-600 text-xs">Deadline: @_guide.Deadline</span>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-muted-foreground text-sm">@_guide.Summary</p>
        </div>

        <div>
            @for (var i = 0; i < _guide.Steps.Length; i++)
            {
                var step = _guide.Steps[i];
                var rowClass = i < _guide.Steps.Length - 1 ? "px-4 py-3 border-b" : "px-4 py-3";
                var stepNumClass = Cn.Merge(
                    "mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full text-xs font-medium",
                    step.Completed ? "bg-emerald-500/10 text-emerald-600" : "bg-muted text-muted-foreground"
                );
                var titleClass = Cn.Merge(
                    "font-medium text-sm",
                    step.Completed ? "text-muted-foreground line-through" : ""
                );
                <div class="@rowClass">
                    <div class="flex items-start gap-3">
                        <div class="@stepNumClass">
                            @if (step.Completed)
                            {
                                <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5" />
                            }
                            else
                            {
                                @step.Number
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="@titleClass">@step.Title</span>
                            <div class="mt-2 rounded-md bg-muted/50 p-3">
                                <pre class="overflow-x-auto whitespace-pre-wrap font-mono text-muted-foreground text-xs">@step.Code</pre>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record MigrationStep(int Number, string Title, string Code, bool Completed);

    private record MigrationGuide(string Version, string Deadline, string Summary, MigrationStep[] Steps);

    private static readonly MigrationGuide _guide = new(
        "v4.0.0",
        "April 30, 2026",
        "This release introduces a new plugin API and removes the legacy configuration format. Follow these steps to migrate your project.",
        [
            new(1, "Update your dependencies",
                "npm install @acme/core@4.0.0 @acme/plugin-api@2.0.0",
                true),
            new(2, "Replace legacy config format",
                "// Before\nmodule.exports = { plugins: [\"legacy\"] }\n\n// After\nexport default defineConfig({ plugins: [newPlugin()] })",
                true),
            new(3, "Rename deprecated hook imports",
                "// Before\nimport { useQuery } from \"@acme/core/legacy\"\n\n// After\nimport { useQuery } from \"@acme/core\"",
                false),
            new(4, "Run the automated codemod",
                "npx @acme/codemod@latest migrate-v4",
                false),
            new(5, "Verify your build passes",
                "npm run build && npm run test",
                false),
        ]
    );
}
