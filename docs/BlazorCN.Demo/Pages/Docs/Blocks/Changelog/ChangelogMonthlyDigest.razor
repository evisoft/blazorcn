@* ============================================================
   Block: changelog-monthly-digest
   Title: ChangelogMonthlyDigest
   Description: React monthly digest changelog block for Next.js with month tab selector, active month state, and categorized entries per month built with TypeScript, shadcn/ui Badge and Button, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-monthly-digest.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideIconCn Name="calendar-days" Size="16" Class="size-4 text-muted-foreground" />
            <p class="text-sm font-medium">Monthly Digest</p>
        </div>

        @* Month tab bar *@
        <div class="flex items-center gap-1 border-b px-4 py-2">
            @foreach (var month in _months)
            {
                var m = month;
                <ButtonCn Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.Sm"
                          Class="@Cn.Merge("h-7 px-3 text-xs", _activeMonth == m.Label ? "bg-muted text-foreground" : "text-muted-foreground")"
                          OnClick="@(() => _activeMonth = m.Label)">
                    @m.Label
                </ButtonCn>
            }
        </div>

        @* Entries for active month *@
        @{
            var current = _months.FirstOrDefault(m => m.Label == _activeMonth) ?? _months[0];
        }
        @for (var i = 0; i < current.Entries.Length; i++)
        {
            var entry = current.Entries[i];
            var borderClass = i < current.Entries.Length - 1 ? "border-b" : "";
            <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3", borderClass)">
                <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-muted-foreground/40"></span>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <p class="text-sm font-medium">@entry.Title</p>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@_badgeStyles[entry.Category]">
                            @entry.Category
                        </BadgeCn>
                    </div>
                    <p class="mt-0.5 text-xs text-muted-foreground">@entry.Description</p>
                </div>
            </div>
        }

    </div>
</section>

@code {
    private record Entry(string Title, string Description, string Category);
    private record Month(string Label, Entry[] Entries);

    private string _activeMonth = _months[0].Label;

    private static readonly Dictionary<string, string> _badgeStyles = new()
    {
        ["feature"]     = "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-0",
        ["fix"]         = "bg-red-500/10 text-red-600 dark:text-red-400 border-0",
        ["improvement"] = "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-0",
        ["deprecation"] = "bg-amber-500/10 text-amber-600 dark:text-amber-400 border-0",
    };

    private static readonly Month[] _months =
    [
        new("Mar 2026",
        [
            new("Team workspace roles",
                "Introduced viewer, editor, and owner roles for team workspaces.",
                "feature"),
            new("PDF export formatting",
                "Fixed page break positioning that split tables across pages.",
                "fix"),
            new("Notification batching",
                "Grouped related notifications into daily digest emails to reduce noise.",
                "improvement"),
            new("API response caching",
                "Added stale-while-revalidate caching to GET endpoints for 2x throughput.",
                "improvement"),
        ]),
        new("Feb 2026",
        [
            new("Custom domain support",
                "Users can now map custom domains to their published project pages.",
                "feature"),
            new("Onboarding wizard redesign",
                "Simplified the 7-step onboarding to 3 steps with inline validation.",
                "improvement"),
            new("OAuth token refresh loop",
                "Fixed infinite redirect when GitHub OAuth tokens expired during session.",
                "fix"),
            new("Legacy embed API",
                "The v1 embed script is deprecated. Migrate to v2 by May 2026.",
                "deprecation"),
        ]),
        new("Jan 2026",
        [
            new("AI summary generation",
                "Auto-generate executive summaries from project data using GPT-4.",
                "feature"),
            new("Bulk user import",
                "Upload CSV files to invite up to 500 team members at once.",
                "feature"),
            new("Chart rendering on Safari",
                "Resolved SVG viewBox clipping on Safari 17 for responsive charts.",
                "fix"),
        ]),
    ];
}
