@* ============================================================
   Block: changelog-database-schema
   Title: ChangelogDatabaseSchema
   Description: A changelog block showing database migration history with operation type badges, monospace table names, and detailed migration descriptions for each schema change.
   Source: original/blocks/changelog/changelog-database-schema.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="database" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Schema Migrations</h2>
            <span class="ml-auto text-xs text-muted-foreground">@_migrations.Length migrations</span>
        </div>

        <div>
            @for (int i = 0; i < _migrations.Length; i++)
            {
                var m = _migrations[i];
                var idx = i;
                <div>
                    <button type="button"
                            class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", idx < _migrations.Length - 1 ? "border-b" : "")"
                            @onclick="@(() => Toggle(m.Id))">
                        @if (m.Destructive)
                        {
                            <span class="size-1.5 shrink-0 rounded-full bg-red-500"></span>
                        }
                        else
                        {
                            <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                        }
                        <span class="@Cn.Merge("shrink-0 whitespace-nowrap rounded px-1.5 py-0.5 font-mono text-xs font-medium", _opColors.GetValueOrDefault(m.Operation, ""))">
                            @m.Operation
                        </span>
                        <div class="min-w-0 flex-1">
                            <code class="font-mono text-xs text-muted-foreground">@m.Table</code>
                            <p class="mt-0.5 text-sm font-medium">@m.Summary</p>
                        </div>
                        <span class="shrink-0 text-xs text-muted-foreground">@m.Date</span>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", _expanded == m.Id ? "rotate-90" : "")" />
                    </button>
                    @if (_expanded == m.Id)
                    {
                        <div class="overflow-hidden">
                            <div class="@Cn.Merge("bg-muted/50 px-4 py-3", idx < _migrations.Length - 1 ? "border-b" : "")">
                                <p class="mb-1 font-mono text-xs text-muted-foreground/70">@m.Version</p>
                                <p class="text-xs leading-relaxed text-muted-foreground">@m.Detail</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Migration(string Id, string Date, string Version, string Operation, string Table, string Summary, string Detail, bool Destructive);

    private static readonly Dictionary<string, string> _opColors = new()
    {
        ["CREATE TABLE"] = "bg-emerald-500/10 text-emerald-600",
        ["ALTER COLUMN"] = "bg-amber-500/10 text-amber-600",
        ["ADD INDEX"] = "bg-blue-500/10 text-blue-600",
        ["DROP TABLE"] = "bg-red-500/10 text-red-600",
        ["RENAME COLUMN"] = "bg-purple-500/10 text-purple-600",
    };

    private static readonly Migration[] _migrations =
    [
        new("m1", "Mar 28, 2026", "20260328_001", "CREATE TABLE", "webhook_subscriptions",
            "New table for webhook subscription management",
            "Creates webhook_subscriptions with columns: id (uuid), user_id (fk), callback_url (text), event_types (jsonb), retry_config (jsonb), created_at, updated_at. Includes index on user_id.",
            false),
        new("m2", "Mar 26, 2026", "20260326_002", "ALTER COLUMN", "organizations.settings",
            "Extended settings column to support SSO fields",
            "Altered settings jsonb column on organizations to include sso_enforcement (boolean) and ip_allowlist (text[]) with default values. Non-breaking change, existing rows unaffected.",
            false),
        new("m3", "Mar 23, 2026", "20260323_001", "ADD INDEX", "analytics_events",
            "Composite index for time-range queries",
            "Added btree index on (workspace_id, created_at DESC) to analytics_events. Improves dashboard query performance by ~4x for date-filtered aggregations.",
            false),
        new("m4", "Mar 20, 2026", "20260320_003", "DROP TABLE", "legacy_api_tokens",
            "Removed deprecated v1 API token storage",
            "Dropped legacy_api_tokens table after all active tokens were migrated to the new api_credentials table. Backup snapshot taken before execution.",
            true),
        new("m5", "Mar 17, 2026", "20260317_001", "RENAME COLUMN", "team_members.role",
            "Renamed role to role_type for clarity",
            "Renamed team_members.role to team_members.role_type to avoid PostgreSQL reserved word conflicts and improve ORM mapping. Updated all application queries.",
            false),
        new("m6", "Mar 14, 2026", "20260314_002", "CREATE TABLE", "billing_invoice_previews",
            "Cache table for invoice preview calculations",
            "Creates billing_invoice_previews with columns: id (uuid), subscription_id (fk), preview_data (jsonb), expires_at (timestamp). TTL-based cleanup via pg_cron job every 6 hours.",
            false),
    ];

    private string? _expanded;

    private void Toggle(string id)
    {
        _expanded = _expanded == id ? null : id;
    }
}
