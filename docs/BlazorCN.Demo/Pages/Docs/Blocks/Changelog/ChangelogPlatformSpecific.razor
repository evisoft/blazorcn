@* ============================================================
   Block: changelog-platform-specific
   Title: ChangelogPlatformSpecific
   Description: React platform specific changelog block for Next.js with tabbed filtering for Web, iOS, Android, and API platforms, showing per-platform entries built with TypeScript, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-platform-specific.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="monitor" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Changelog — By Platform</h2>
        </div>

        @* Platform tab bar *@
        <div class="flex gap-1 border-b px-3 py-2">
            @foreach (var platform in _platforms)
            {
                var p = platform;
                <button type="button"
                        class="@Cn.Merge("rounded-md px-3 py-1.5 text-xs font-medium transition-colors", _activePlatform == p ? "bg-foreground text-background" : "text-muted-foreground hover:bg-muted/50 hover:text-foreground")"
                        @onclick="@(() => _activePlatform = p)">
                    @p
                    <span class="ml-1.5 text-xs opacity-60">@_platformEntries[p].Length</span>
                </button>
            }
        </div>

        @* Entries for active platform *@
        <div>
            @{
                var entries = _platformEntries[_activePlatform];
            }
            @for (var i = 0; i < entries.Length; i++)
            {
                var entry = entries[i];
                var borderClass = i < entries.Length - 1 ? "border-b" : "";
                <div class="@Cn.Merge("px-4 py-3", borderClass)">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-xs text-muted-foreground">@_typeLabels[entry.Type]</span>
                                <span class="text-xs text-muted-foreground">·</span>
                                <span class="font-mono text-xs text-muted-foreground">v@(entry.Version)</span>
                            </div>
                            <p class="mt-1 text-sm font-medium">@entry.Title</p>
                            <p class="mt-0.5 text-xs text-muted-foreground">@entry.Description</p>
                        </div>
                        <span class="shrink-0 text-xs text-muted-foreground">@entry.Date</span>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record PlatformEntry(string Id, string Title, string Description, string Version, string Date, string Type);

    private string _activePlatform = "Web";

    private static readonly string[] _platforms = ["Web", "iOS", "Android", "API"];

    private static readonly Dictionary<string, string> _typeLabels = new()
    {
        ["feature"] = "Feature",
        ["fix"] = "Fix",
        ["improvement"] = "Improvement",
    };

    private static readonly Dictionary<string, PlatformEntry[]> _platformEntries = new()
    {
        ["Web"] =
        [
            new("w1", "Added dark mode toggle to navigation bar",
                "Users can switch between light, dark, and system themes from the top nav dropdown.",
                "4.2.0", "Mar 28", "feature"),
            new("w2", "Fixed table column resize handle on Firefox",
                "Resize handles now respond correctly to pointer events on all browsers.",
                "4.1.3", "Mar 26", "fix"),
            new("w3", "Improved initial page load with deferred hydration",
                "Non-critical components now hydrate after first paint, reducing TTI by 400ms.",
                "4.1.2", "Mar 24", "improvement"),
            new("w4", "Added inline editing for project descriptions",
                "Click any project description to edit in place with auto-save.",
                "4.1.0", "Mar 22", "feature"),
        ],
        ["iOS"] =
        [
            new("i1", "Added haptic feedback on task completion",
                "Light haptic tap when marking tasks as done for tactile confirmation.",
                "3.9.0", "Mar 28", "feature"),
            new("i2", "Fixed crash on iPad when rotating during video playback",
                "Resolved AVPlayer frame calculation error during orientation change.",
                "3.8.4", "Mar 25", "fix"),
            new("i3", "Improved push notification delivery reliability",
                "Switched to urgent priority for time-sensitive notifications with fallback.",
                "3.8.3", "Mar 23", "improvement"),
        ],
        ["Android"] =
        [
            new("a1", "Added Material You dynamic color theming",
                "App colors now adapt to the user wallpaper on Android 12+ devices.",
                "3.7.0", "Mar 28", "feature"),
            new("a2", "Fixed back gesture conflict with drawer navigation",
                "Predictive back gesture now correctly distinguishes between drawer and system back.",
                "3.6.5", "Mar 26", "fix"),
            new("a3", "Reduced APK size by 12MB with R8 optimization",
                "Enabled full R8 mode and removed unused Play Services modules.",
                "3.6.4", "Mar 24", "improvement"),
        ],
        ["API"] =
        [
            new("p1", "Added GraphQL subscriptions for real-time updates",
                "WebSocket-based subscriptions for project, task, and comment changes.",
                "2.5.0", "Mar 28", "feature"),
            new("p2", "Fixed pagination cursor encoding for special characters",
                "Base64 cursors now handle UTF-8 entity names without truncation.",
