@* ============================================================
   Block: changelog-accessibility-score
   Title: ChangelogAccessibilityScore
   Description: React accessibility score changelog block for Next.js with per-release WCAG compliance scores, severity indicators, and expandable audit details built with TypeScript, shadcn/ui Badge, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-accessibility-score.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Accessibility Changelog</span>
            <span class="text-muted-foreground text-xs">WCAG 2.1 AA</span>
        </div>

        @* Releases *@
        <div>
            @for (var rIdx = 0; rIdx < _releases.Length; rIdx++)
            {
                var release = _releases[rIdx];
                var isExpanded = _expanded == release.Version;
                var scoreDiff = release.Score - release.PreviousScore;
                var isLast = rIdx == _releases.Length - 1;

                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => Toggle(release.Version))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex items-baseline gap-2">
                            <span class="@Cn.Merge("font-semibold text-2xl tabular-nums", GetScoreColor(release.Score))">
                                @release.Score
                            </span>
                            <span class="text-muted-foreground text-xs">/100</span>
                        </div>

                        <div class="flex items-center gap-1">
                            @if (scoreDiff > 0)
                            {
                                <LucideIconCn Name="arrow-up" Size="12" Class="size-3 text-emerald-500" />
                            }
                            else if (scoreDiff < 0)
                            {
                                <LucideIconCn Name="arrow-down" Size="12" Class="size-3 text-red-500" />
                            }
                            else
                            {
                                <LucideIconCn Name="minus" Size="12" Class="size-3 text-muted-foreground" />
                            }
                            <span class="@Cn.Merge("font-mono text-xs tabular-nums", GetScoreDiffClass(scoreDiff))">
                                @FormatScoreDiff(scoreDiff)
                            </span>
                        </div>

                        <div class="min-w-0 flex-1">
                            <span class="font-mono text-muted-foreground text-xs">v@release.Version</span>
                            <span class="ml-2 text-muted-foreground/60 text-xs">@release.Date</span>
                        </div>

                        <span class="text-muted-foreground text-xs">
                            @release.ResolvedIssues/@release.TotalIssues resolved
                        </span>

                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3">
                            <div class="space-y-1">
                                @foreach (var item in release.Items)
                                {
                                    <div class="flex items-start gap-2 rounded-md bg-muted/50 px-3 py-2">
                                        <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", GetSeverityDot(item.Severity))"
                                              aria-hidden="true"></span>
                                        <div class="min-w-0 flex-1">
                                            <div class="flex items-center justify-between gap-2">
                                                <span class="font-medium text-xs">@item.Title</span>
                                                <span class="@Cn.Merge("shrink-0 text-[10px]", GetStatusClass(item.Status))">
                                                    @GetStatusLabel(item.Status)
                                                </span>
                                            </div>
                                            <span class="font-mono text-muted-foreground text-[10px]">
                                                @item.WcagCriteria
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="mt-2 flex items-center gap-3">
                                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                    <span class="size-1.5 rounded-full bg-red-500"></span>
                                    Critical
                                </span>
                                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                                    Major
                                </span>
                                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                                    Minor
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "2.8.0";

    private record AuditItem(string Id, string Title, string WcagCriteria, string Severity, string Status);
    private record Release(string Version, string Date, int Score, int PreviousScore, int TotalIssues, int ResolvedIssues, AuditItem[] Items);

    private static readonly Release[] _releases =
    [
        new("2.8.0", "Mar 30", 94, 87, 12, 10,
        [
            new("a1", "Color contrast on muted text improved", "1.4.3 Contrast (Minimum)", "critical", "resolved"),
            new("a2", "Form inputs associated with visible labels", "1.3.1 Info and Relationships", "major", "resolved"),
            new("a3", "Skip navigation link added to all pages", "2.4.1 Bypass Blocks", "minor", "resolved"),
        ]),
        new("2.7.2", "Mar 24", 87, 82, 18, 14,
        [
            new("b1", "Keyboard focus visible on all interactive elements", "2.4.7 Focus Visible", "critical", "resolved"),
            new("b2", "ARIA roles added to custom dropdown menus", "4.1.2 Name, Role, Value", "major", "resolved"),
            new("b3", "Image alt text missing on dashboard cards", "1.1.1 Non-text Content", "major", "in-progress"),
        ]),
        new("2.7.0", "Mar 18", 82, 82, 22, 15,
        [
            new("c1", "Touch targets enlarged to 44px minimum", "2.5.5 Target Size", "major", "resolved"),
            new("c2", "Animation respects prefers-reduced-motion", "2.3.3 Animation from Interactions", "minor", "resolved"),
            new("c3", "Error messages not programmatically associated", "3.3.1 Error Identification", "critical", "open"),
        ]),
    ];

    private void Toggle(string version)
    {
        _expanded = _expanded == version ? null : version;
    }

    private static string GetScoreColor(int score) =>
        score >= 90 ? "text-emerald-600 dark:text-emerald-400"
        : score >= 70 ? "text-amber-600 dark:text-amber-400"
        : "text-red-600 dark:text-red-400";

    private static string GetScoreDiffClass(int diff) =>
        diff > 0 ? "text-emerald-600 dark:text-emerald-400"
        : diff < 0 ? "text-red-600 dark:text-red-400"
        : "text-muted-foreground";

    private static string FormatScoreDiff(int diff) =>
        diff > 0 ? $"+{diff}" : diff == 0 ? "0" : $"{diff}";

    private static string GetSeverityDot(string severity) => severity switch
    {
        "critical" => "bg-red-500",
        "major"    => "bg-amber-500",
        _          => "bg-blue-500",
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "resolved"    => "Resolved",
        "open"        => "Open",
        _             => "In progress",
    };

    private static string GetStatusClass(string status) => status switch
    {
        "resolved"    => "text-emerald-600 dark:text-emerald-400",
        "open"        => "text-red-600 dark:text-red-400",
        _             => "text-amber-600 dark:text-amber-400",
    };
}
