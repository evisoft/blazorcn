@* ============================================================
   Block: changelog-data-pipeline-changes
   Title: ChangelogDataPipelineChanges
   Description: A React changelog component for data pipeline updates built with Next.js, shadcn/ui, and Tailwind CSS showing source/destination changes, transformations, and data flow modifications
   Source: original/blocks/changelog/changelog-data-pipeline-changes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="database" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Data Pipeline Changes</h2>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">
                ETL configuration updates, transformations, and data flow modifications
            </p>
        </div>

        <div>
            @foreach (var change in _changes)
            {
                var c = change;
                var isExpanded = _expandedId == c.Id;
                var typeColorClass = GetChangeTypeColorClass(c.ChangeType);
                var typeIconName = GetChangeTypeIconName(c.ChangeType);
                var typeSpanClass = Cn.Merge("inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-xs font-medium", typeColorClass);
                var chevronClass = Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
                var sourceProtocol = c.SourceAfter.Split("://")[0];
                var destProtocol = c.DestAfter.Split("://")[0];
                <div class="border-b last:border-b-0">
                    <button
                        type="button"
                        @onclick="@(() => ToggleExpanded(c.Id))"
                        class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex min-w-0 flex-1 flex-col gap-2">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@c.PipelineName</span>
                            </div>
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="@typeSpanClass">
                                    <LucideIconCn Name="@typeIconName" Size="14" Class="size-3.5" />
                                    @c.ChangeType
                                </span>
                                <span class="text-xs text-muted-foreground">@c.Timestamp</span>
                                <span class="text-xs text-muted-foreground">•</span>
                                <span class="text-xs text-muted-foreground">@c.Author</span>
                            </div>
                            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                                <span class="font-mono">@sourceProtocol</span>
                                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
                                <span class="font-mono">@destProtocol</span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/50 px-4 py-3">
                            <p class="mb-3 text-xs text-muted-foreground">@c.Description</p>

                            <div class="mb-3 grid gap-3 sm:grid-cols-2">
                                <div class="rounded-md bg-background px-3 py-2">
                                    <span class="block text-xs font-medium text-muted-foreground">Latency Impact</span>
                                    <span class="mt-0.5 block font-mono text-xs">@c.ImpactLatency</span>
                                </div>
                                <div class="rounded-md bg-background px-3 py-2">
                                    <span class="block text-xs font-medium text-muted-foreground">Throughput Impact</span>
                                    <span class="mt-0.5 block font-mono text-xs">@c.ImpactThroughput</span>
                                </div>
                            </div>

                            @if (c.SourceBefore != c.SourceAfter)
                            {
                                <div class="mb-3">
                                    <span class="mb-1.5 block text-xs font-medium text-muted-foreground">Source</span>
                                    <div class="space-y-1.5">
                                        <div class="rounded-md bg-background px-3 py-2">
                                            <span class="block text-xs text-muted-foreground">Before</span>
                                            <span class="mt-0.5 block font-mono text-xs">@c.SourceBefore</span>
                                        </div>
                                        <div class="rounded-md bg-background px-3 py-2">
                                            <span class="block text-xs text-muted-foreground">After</span>
                                            <span class="mt-0.5 block font-mono text-xs">@c.SourceAfter</span>
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (c.DestBefore != c.DestAfter)
                            {
                                <div class="mb-3">
                                    <span class="mb-1.5 block text-xs font-medium text-muted-foreground">Destination</span>
                                    <div class="space-y-1.5">
                                        <div class="rounded-md bg-background px-3 py-2">
                                            <span class="block text-xs text-muted-foreground">Before</span>
                                            <span class="mt-0.5 block font-mono text-xs">@c.DestBefore</span>
                                        </div>
                                        <div class="rounded-md bg-background px-3 py-2">
                                            <span class="block text-xs text-muted-foreground">After</span>
                                            <span class="mt-0.5 block font-mono text-xs">@c.DestAfter</span>
                                        </div>
                                    </div>
                                </div>
                            }

                            <div>
                                <span class="mb-1.5 block text-xs font-medium text-muted-foreground">Transformations</span>
                                <div class="flex flex-wrap gap-1.5">
                                    @foreach (var transform in c.TransformsAfter)
                                    {
                                        var t = transform;
                                        var isNew = System.Array.IndexOf(c.TransformsBefore, t) < 0;
                                        @if (isNew)
                                        {
                                            <BadgeCn Variant="BadgeVariant.Default" Class="font-mono text-xs bg-emerald-500/10 text-emerald-500">@t</BadgeCn>
                                        }
                                        else
                                        {
                                            <BadgeCn Variant="BadgeVariant.Outline" Class="font-mono text-xs">@t</BadgeCn>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private string? _expandedId;

    private void ToggleExpanded(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private static string GetChangeTypeColorClass(string type) => type switch
    {
        "source"         => "bg-blue-500/10 text-blue-500",
        "destination"    => "bg-purple-500/10 text-purple-500",
        "transformation" => "bg-emerald-500/10 text-emerald-500",
        "schedule"       => "bg-amber-500/10 text-amber-500",
        "config"         => "bg-gray-500/10 text-gray-500",
        _                => "",
    };

    private static string GetChangeTypeIconName(string type) => type switch
    {
        "source"         => "database",
        "destination"    => "database",
        "transformation" => "wand",
        "schedule"       => "clock",
        "config"         => "trending-up",
        _                => "database",
    };

    private record PipelineChange(
        string Id,
        string PipelineName,
        string ChangeType,
        string Timestamp,
        string Author,
        string SourceBefore,
        string SourceAfter,
        string DestBefore,
        string DestAfter,
        string[] TransformsBefore,
        string[] TransformsAfter,
        string ImpactLatency,
        string ImpactThroughput,
        string Description
    );

    private static readonly PipelineChange[] _changes =
    [
        new("1", "user-events-aggregation", "transformation", "4 hours ago", "Alex Kim",
            "kinesis://events-stream", "kinesis://events-stream",
            "s3://analytics/events/", "s3://analytics/events/",
            ["sessionize", "dedup", "enrich_geo"],
            ["sessionize", "dedup", "enrich_geo", "pii_redact", "aggregate_hourly"],
            "-12% (avg 2.3s → 2.0s)", "+45% (8.2k → 11.9k events/sec)",
            "Added PII redaction and hourly aggregation to reduce downstream processing load"),
        new("2", "product-catalog-sync", "source", "Yesterday", "Maria Santos",
            "postgres://products.prod", "postgres://products.prod-replica",
            "elasticsearch://catalog", "elasticsearch://catalog",
            ["flatten_json", "build_search_text"],
            ["flatten_json", "build_search_text"],
            "-68% (avg 890ms → 285ms)", "unchanged",
            "Migrated to read replica to reduce production database load during catalog sync"),
        new("3", "clickstream-analytics", "destination", "2 days ago", "Jordan Lee",
            "kafka://clickstream", "kafka://clickstream",
            "redshift://analytics.clicks", "snowflake://analytics.clicks",
            ["parse_ua", "sessionize", "enrich"],
            ["parse_ua", "sessionize", "enrich"],
            "-34% (avg 4.2s → 2.8s)", "+120% (3.1k → 6.8k events/sec)",
            "Migrated from Redshift to Snowflake for better concurrent query performance"),
        new("4", "inventory-reconciliation", "schedule", "3 days ago", "Taylor Chen",
            "rest://inventory-api/v1", "rest://inventory-api/v1",
            "postgres://warehouse.inventory", "postgres://warehouse.inventory",
            ["validate_skus", "calc_deltas"],
            ["validate_skus", "calc_deltas", "flag_discrepancies"],
            "unchanged", "unchanged",
            "Added discrepancy flagging and changed schedule from hourly to every 15 minutes"),
        new("5", "financial-reporting", "transformation", "1 week ago", "Sam Patel",
            "s3://raw-transactions/", "s3://raw-transactions/",
            "postgres://finance.reports", "postgres://finance.reports",
            ["parse_csv", "validate", "convert_currency"],
            ["parse_csv", "validate", "convert_currency", "apply_fx_rates", "categorize"],
            "+8% (avg 12.1s → 13.1s)", "-5% (1.2k → 1.14k records/sec)",
            "Added real-time FX rate application and automated transaction categorization"),
        new("6", "ml-feature-extraction", "config", "2 weeks ago", "Alex Kim",
            "bigquery://ml.raw_features", "bigquery://ml.raw_features",
            "gcs://ml-features/v1/", "gcs://ml-features/v2/",
            ["normalize", "encode_categorical"],
            ["normalize", "encode_categorical", "pca_reduce", "create_embeddings"],
            "+22% (avg 5.4s → 6.6s)", "unchanged",
            "Added PCA dimensionality reduction and embedding generation for improved model performance"),
    ];
}
