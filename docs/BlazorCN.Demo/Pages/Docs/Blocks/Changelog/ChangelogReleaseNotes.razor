@* ============================================================
   Block: changelog-release-notes
   Title: ChangelogReleaseNotes
   Description: React changelog release notes block for Next.js with version badges, categorized changes, and collapsible entries built with TypeScript, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-release-notes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="package" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Release Notes</span>
        </div>

        @* Releases *@
        <div>
            @foreach (var rel in _releases)
            {
                var release = rel;
                var isExpanded = _expandedVersions.Contains(release.Version);
                var isLast = release.Version == _releases[^1].Version;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => ToggleVersion(release.Version))"
                            aria-expanded="@isExpanded.ToString().ToLower()">
                        <LucideIconCn Name="chevron-right"
                                      Size="16"
                                      Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        <div class="flex min-w-0 flex-1 items-center justify-between">
                            <div class="flex items-center gap-2">
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-xs font-normal">v@release.Version</BadgeCn>
                                <span class="text-muted-foreground text-xs">@release.Entries.Length changes</span>
                            </div>
                            <span class="text-muted-foreground text-xs">@release.Date</span>
                        </div>
                    </button>
                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/20 px-4 py-2">
                            @foreach (var ent in release.Entries)
                            {
                                var entry = ent;
                                <div class="flex items-start gap-2.5 py-1.5">
                                    <span class="@Cn.Merge("mt-0.5 shrink-0 rounded px-1.5 py-0.5 font-medium text-[10px] capitalize leading-none", _categoryStyles[entry.Category])">
                                        @entry.Category
                                    </span>
                                    <span class="text-sm">@entry.Description</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ChangeEntry(string Category, string Description);
    private record Release(string Version, string Date, ChangeEntry[] Entries);

    private static readonly Dictionary<string, string> _categoryStyles = new()
    {
        ["added"]    = "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        ["fixed"]    = "bg-red-500/10 text-red-600 dark:text-red-400",
        ["improved"] = "bg-blue-500/10 text-blue-600 dark:text-blue-400",
    };

    private static readonly Release[] _releases =
    [
        new("2.4.0", "Mar 28, 2026",
        [
            new("added",    "Team workspace collaboration with real-time cursors"),
            new("added",    "Custom domain support for published sites"),
            new("improved", "Dashboard load time reduced by 40% with streaming SSR"),
            new("fixed",    "File upload failing for files larger than 25MB"),
        ]),
        new("2.3.2", "Mar 21, 2026",
        [
            new("fixed",    "OAuth callback race condition on slow connections"),
            new("fixed",    "Sidebar collapse state not persisting across sessions"),
            new("improved", "Search indexing now processes in under 2 seconds"),
        ]),
        new("2.3.0", "Mar 14, 2026",
        [
            new("added",    "API key management with scoped permissions"),
            new("added",    "Webhook delivery logs with retry controls"),
            new("improved", "Table component now supports virtualized scrolling for 10k+ rows"),
            new("fixed",    "Timezone offset calculation incorrect for UTC-negative zones"),
        ]),
        new("2.2.1", "Mar 7, 2026",
        [
            new("fixed",    "CSV export encoding issue with special characters"),
            new("improved", "Reduced bundle size by 18% through tree-shaking improvements"),
        ]),
    ];

    private readonly HashSet<string> _expandedVersions = ["2.4.0"];

    private void ToggleVersion(string version)
    {
        if (_expandedVersions.Contains(version))
            _expandedVersions.Remove(version);
        else
            _expandedVersions.Add(version);
    }
}
