@* ============================================================
   Block: changelog-customer-changelog
   Title: ChangelogCustomerChangelog
   Description: Customer-friendly changelog with accessible language and feature highlights for end users, built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-customer-changelog.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="zap" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">What's New</h2>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">@_latestVersion</BadgeCn>
        </div>

        @* Entries *@
        <div class="divide-y">
            @for (var i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                <div class="px-4 py-4">
                    @* Version and Date (only show when version changes) *@
                    @if (i == 0 || _entries[i - 1].Version != entry.Version)
                    {
                        <div class="mb-3 flex items-center justify-between">
                            <span class="text-sm font-medium">@entry.Version</span>
                            <span class="text-xs text-muted-foreground">@entry.Date</span>
                        </div>
                    }

                    @* Entry Content *@
                    <div class="flex items-start gap-3">
                        <div class="@($"mt-0.5 rounded-full p-1.5 {GetCategoryColor(entry.Category)}")">
                            @if (entry.Category == "feature")
                            {
                                <LucideIconCn Name="sparkles" Size="16" Class="size-4" />
                            }
                            else if (entry.Category == "improvement")
                            {
                                <LucideIconCn Name="trending-up" Size="16" Class="size-4" />
                            }
                            else
                            {
                                <LucideIconCn Name="bug" Size="16" Class="size-4" />
                            }
                        </div>

                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <BadgeCn Variant="BadgeVariant.Outline" Class="@($"text-xs {GetCategoryColor(entry.Category)}")">
                                    @GetCategoryLabel(entry.Category)
                                </BadgeCn>
                                <h3 class="text-sm font-medium">@entry.Title</h3>
                            </div>
                            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                                @entry.Description
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                Have feedback?
                <button type="button" class="font-medium underline underline-offset-4 hover:text-foreground">
                    Share your thoughts
                </button>
            </p>
        </div>

    </div>
</section>

@code {
    private record ChangelogEntry(string Version, string Date, string Category, string Title, string Description);

    private static readonly ChangelogEntry[] _entries =
    [
        new("v4.2.0", "March 28, 2026", "feature", "AI-Powered Search with Natural Language",
            "Find exactly what you need using natural language queries. Our new AI search understands context and intent, delivering more accurate results in seconds. Try asking 'show me last month's reports' or 'find emails from Sarah about the project'."),
        new("v4.2.0", "March 28, 2026", "feature", "Real-Time Collaboration with Live Cursors",
            "See who's editing what in real-time with live cursors and presence indicators. Collaborate seamlessly with your team without stepping on each other's toes."),
        new("v4.2.0", "March 28, 2026", "improvement", "Faster Dashboard Loading",
            "Your dashboard now loads 3x faster with our new caching system. Navigate between pages without waiting, even on slower connections."),
        new("v4.1.0", "March 15, 2026", "feature", "Custom Workflow Automation",
            "Automate repetitive tasks with our new workflow builder. Create custom triggers, actions, and conditions without writing code. Save hours every week on manual work."),
        new("v4.1.0", "March 15, 2026", "improvement", "Enhanced Mobile Experience",
            "We've redesigned the mobile app with larger touch targets, smoother animations, and improved navigation. Managing your work on the go has never been easier."),
        new("v4.1.0", "March 15, 2026", "fix", "Fixed Notification Delivery Issues",
            "Notifications now arrive instantly and reliably. We've resolved the issue where some email notifications were delayed or missing."),
    ];

    private static readonly string _latestVersion = _entries[0].Version;

    private static string GetCategoryColor(string category) => category switch
    {
        "feature" => "bg-blue-500/10 text-blue-500",
        "improvement" => "bg-emerald-500/10 text-emerald-500",
        _ => "bg-amber-500/10 text-amber-500",
    };

    private static string GetCategoryLabel(string category) => category switch
    {
        "feature" => "New",
        "improvement" => "Improved",
        _ => "Fixed",
    };
}
