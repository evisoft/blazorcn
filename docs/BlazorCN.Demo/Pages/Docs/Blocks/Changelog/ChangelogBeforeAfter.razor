@* ============================================================
   Block: changelog-before-after
   Title: ChangelogBeforeAfter
   Description: React changelog block with before and after comparison cards showing old versus new behavior for each change built with TypeScript, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-before-after.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="refresh-cw" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">What Changed</h2>
            <span class="ml-auto text-xs text-muted-foreground">
                @_entries.Length improvements
            </span>
        </div>

        @for (var i = 0; i < _entries.Length; i++)
        {
            var entry = _entries[i];
            var rowClass = Cn.Merge("px-4 py-3", i < _entries.Length - 1 ? "border-b" : "");
            <div class="@rowClass">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium">@entry.Title</span>
                    <span class="text-xs text-muted-foreground">@entry.Date</span>
                </div>

                <div class="mt-2 flex flex-col gap-2 sm:flex-row sm:items-stretch">
                    <div class="flex-1 rounded-md bg-red-500/5 p-3">
                        <span class="text-[10px] font-medium uppercase tracking-wider text-red-600 dark:text-red-400">
                            Before
                        </span>
                        <p class="mt-1 text-xs text-muted-foreground">@entry.Before</p>
                    </div>

                    <div class="flex shrink-0 items-center justify-center">
                        <LucideIconCn Name="arrow-right" Size="16" Class="size-4 rotate-90 text-muted-foreground/40 sm:rotate-0" />
                    </div>

                    <div class="flex-1 rounded-md bg-emerald-500/5 p-3">
                        <span class="text-[10px] font-medium uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
                            After
                        </span>
                        <p class="mt-1 text-xs text-muted-foreground">@entry.After</p>
                    </div>
                </div>
            </div>
        }

    </div>
</section>

@code {
    private record Entry(string Title, string Date, string Before, string After);

    private static readonly Entry[] _entries =
    [
        new(
            "Search results ranking algorithm",
            "Mar 28, 2026",
            "Results sorted by creation date only. Exact keyword matching with no typo tolerance. Queries over 3 words timed out on large datasets.",
            "Semantic ranking with BM25 scoring and typo tolerance up to edit distance 2. Sub-100ms response times for all query lengths with index-based pagination."
        ),
        new(
            "File upload handling",
            "Mar 21, 2026",
            "Single file uploads with a 10 MB limit. Entire file buffered in server memory before writing to storage. No progress feedback to the user.",
            "Multi-file drag and drop with a 500 MB limit per file. Streaming upload with chunked transfer encoding. Real-time progress bar per file."
        ),
        new(
            "Error notification system",
            "Mar 14, 2026",
            "Generic red banner with 'Something went wrong' for all error types. No error codes. Banner disappeared after 3 seconds regardless of severity.",
            "Contextual error toasts with specific error codes, suggested fixes, and retry buttons. Critical errors persist until dismissed. Errors logged to the console for debugging."
        ),
        new(
            "Team invitation flow",
            "Mar 7, 2026",
            "Email-only invitations with 24-hour expiry. No indication of pending invites. Expired links showed a generic 404 page.",
            "Invite via email or shareable link with configurable expiry from 1 hour to 30 days. Pending invite dashboard for admins. Expired links show a re-request access prompt."
        ),
        new(
            "Dashboard loading experience",
            "Feb 28, 2026",
            "Full-page spinner for 2-4 seconds while all widgets fetched data sequentially. Layout shift when content loaded. No caching between navigations.",
            "Skeleton placeholders matching exact widget dimensions. Parallel data fetching with stale-while-revalidate caching. Zero layout shift. Sub-500ms perceived load time."
        ),
    ];
}
