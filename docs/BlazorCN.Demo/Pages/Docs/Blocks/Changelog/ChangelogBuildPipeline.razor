@* ============================================================
   Block: changelog-build-pipeline
   Title: ChangelogBuildPipeline
   Description: A CI/CD build pipeline visualization with stage status, duration, and error tracking for React and Next.js projects using shadcn/ui components and Tailwind CSS.
   Source: original/blocks/changelog/changelog-build-pipeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Build Pipeline</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">CI/CD execution status and stage details</p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-7 gap-1.5 px-2 text-xs">
                    <LucideIconCn Name="play" Size="12" Class="size-3" />
                    Trigger Build
                </ButtonCn>
            </div>
        </div>

        <div>
            @foreach (var it in _pipelineRuns)
            {
                var run = it;
                var isExpanded = _expandedRun == run.Id;
                var isLast = run.Id == _pipelineRuns[^1].Id;
                var rowDivClass = isLast ? "" : "border-b";
                <div class="@rowDivClass">
                    <button
                        type="button"
                        @onclick="@(() => Toggle(run.Id))"
                        class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex size-6 shrink-0 items-center justify-center">
                            <LucideIconCn Name="@GetStatusIconName(run.Status)" Size="16" Class="@GetStatusIconClass(run.Status)" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">Run #@(run.Id.Split('-')[1])</span>
                                        <span class="@Cn.Merge("inline-flex items-center rounded-full border px-2.5 py-0.5 h-5 text-xs font-semibold", GetStatusBadge(run.Status))">@run.Status</span>
                                    </div>
                                    <div class="mt-1 flex items-center gap-3 text-xs text-muted-foreground">
                                        <span class="flex items-center gap-1">
                                            <LucideIconCn Name="git-branch" Size="12" Class="size-3" />
                                            @run.Branch
                                        </span>
                                        <span class="font-mono">@run.Commit</span>
                                        <span class="flex items-center gap-1">
                                            <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                            @run.StartTime
                                        </span>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="text-xs text-muted-foreground">@run.Duration</span>
                                    <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                                </div>
                            </div>
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/20 px-4 py-3">
                            <div class="space-y-2">
                                @foreach (var stage in run.Stages)
                                {
                                    <div class="flex items-center justify-between rounded-md bg-card px-3 py-2">
                                        <div class="flex items-center gap-2">
                                            <div class="flex size-5 items-center justify-center">
                                                <LucideIconCn Name="@GetStatusIconName(stage.Status)" Size="16" Class="@GetStatusIconClass(stage.Status)" />
                                            </div>
                                            <span class="text-xs font-medium">@stage.Name</span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            @if (stage.Error != null)
                                            {
                                                <span class="text-xs text-red-600">@stage.Error</span>
                                            }
                                            @if (stage.Duration != null)
                                            {
                                                <span class="text-xs text-muted-foreground">@stage.Duration</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="mt-3 flex gap-2">
                                <ButtonCn Variant="ButtonVariant.Outline" Class="h-6 flex-1 text-xs">View Logs</ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Outline" Class="h-6 flex-1 text-xs">Rerun Failed</ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record PipelineStage(string Name, string Status, string? Duration = null, string? Error = null);
    private record PipelineRun(string Id, string Branch, string Commit, string Trigger, string StartTime, string Duration, string Status, PipelineStage[] Stages);

    private string? _expandedRun;

    private void Toggle(string id)
    {
        _expandedRun = _expandedRun == id ? null : id;
    }

    private static string GetStatusIconName(string status) => status switch
    {
        "success" => "check-circle-2",
        "failed"  => "x-circle",
        "running" => "play",
        _         => "clock",
    };

    private static string GetStatusIconClass(string status) => status switch
    {
        "success" => "size-4 text-emerald-500",
        "failed"  => "size-4 text-red-500",
        "running" => "size-4 text-blue-500",
        _         => "size-4 text-muted-foreground/60",
    };

    private static string GetStatusBadge(string status) => status switch
    {
        "success" => "bg-emerald-500/10 text-emerald-600",
        "failed"  => "bg-red-500/10 text-red-600",
        "running" => "bg-blue-500/10 text-blue-600",
        _         => "bg-muted/50 text-muted-foreground",
    };

    private static readonly PipelineRun[] _pipelineRuns =
    [
        new("run-1547", "main", "a7f3c9d", "push", "2 min ago", "3m 42s", "success",
        [
            new("Checkout",              "success", "12s"),
            new("Install Dependencies",  "success", "1m 24s"),
            new("Lint & Type Check",     "success", "32s"),
            new("Build",                 "success", "48s"),
            new("Test",                  "success", "28s"),
            new("Deploy to Production",  "success", "18s"),
        ]),
        new("run-1546", "feat/auth-improvement", "b2e4f1a", "pull_request", "18 min ago", "2m 14s", "failed",
        [
            new("Checkout",             "success",  "11s"),
            new("Install Dependencies", "success",  "1m 18s"),
            new("Lint & Type Check",    "failed",   "45s",  "Type error in auth.ts:47"),
            new("Build",                "pending"),
            new("Test",                 "pending"),
            new("Deploy to Staging",    "pending"),
        ]),
        new("run-1545", "feat/dashboard-redesign", "c9a2d8e", "push", "1 hour ago", "4m 8s", "success",
        [
            new("Checkout",              "success", "13s"),
            new("Install Dependencies",  "success", "1m 32s"),
            new("Lint & Type Check",     "success", "38s"),
            new("Build",                 "success", "52s"),
            new("Test",                  "success", "34s"),
            new("Deploy to Staging",     "success", "19s"),
        ]),
    ];
}
