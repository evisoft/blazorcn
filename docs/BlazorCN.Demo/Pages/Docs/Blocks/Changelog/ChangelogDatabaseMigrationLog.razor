@* ============================================================
   Block: changelog-database-migration-log
   Title: ChangelogDatabaseMigrationLog
   Description: A database migration history tracker with up/down scripts and execution time for React and Next.js applications using shadcn/ui components and Tailwind CSS.
   Source: original/blocks/changelog/changelog-database-migration-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Database Migrations</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Schema change history and execution logs
                    </p>
                </div>
                <BadgeCn Class="h-5 gap-1 bg-emerald-500/10 text-emerald-600 text-xs">
                    <LucideIconCn Name="database" Size="12" Class="size-3" />
                    @_migrations.Length migrations
                </BadgeCn>
            </div>
        </div>

        <div>
            @for (int i = 0; i < _migrations.Length; i++)
            {
                var migration = _migrations[i];
                var idx = i;
                var isExpanded = _expandedMigration == migration.Id;
                <div class="@Cn.Merge(idx != _migrations.Length - 1 ? "border-b" : "")">
                    <button type="button"
                            @onclick="@(() => ToggleMigration(migration.Id))"
                            class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex size-6 shrink-0 items-center justify-center">
                            @if (migration.Status == "success")
                            {
                                <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-500" />
                            }
                            else
                            {
                                <LucideIconCn Name="clock" Size="16" Class="size-4 text-muted-foreground/60" />
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@migration.Name</span>
                                        <span class="font-mono text-muted-foreground text-xs">
                                            @migration.Version
                                        </span>
                                    </div>
                                    <p class="mt-0.5 text-xs text-muted-foreground">
                                        @migration.Description
                                    </p>
                                    <div class="mt-1.5 flex items-center gap-3 text-xs text-muted-foreground">
                                        <span class="flex items-center gap-1">
                                            <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                            @migration.ExecutedAt
                                        </span>
                                        <span class="flex items-center gap-1">
                                            <LucideIconCn Name="timer" Size="12" Class="size-3" />
                                            @migration.ExecutionTime
                                        </span>
                                        <BadgeCn Class="h-4 bg-blue-500/10 px-1.5 text-blue-600 text-xs">
                                            @migration.Environment
                                        </BadgeCn>
                                    </div>
                                </div>
                                <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                            </div>
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/20 px-4 py-3">
                            <div class="space-y-3">
                                <div class="flex items-center gap-3">
                                    <div class="flex-1 rounded-md bg-card px-3 py-2">
                                        <div class="text-xs text-muted-foreground">Tables</div>
                                        <div class="mt-1 font-semibold tabular-nums text-sm">
                                            @migration.Changes.Tables
                                        </div>
                                    </div>
                                    <div class="flex-1 rounded-md bg-card px-3 py-2">
                                        <div class="text-xs text-muted-foreground">Columns</div>
                                        <div class="mt-1 font-semibold tabular-nums text-sm">
                                            @migration.Changes.Columns
                                        </div>
                                    </div>
                                    <div class="flex-1 rounded-md bg-card px-3 py-2">
                                        <div class="text-xs text-muted-foreground">Indexes</div>
                                        <div class="mt-1 font-semibold tabular-nums text-sm">
                                            @migration.Changes.Indexes
                                        </div>
                                    </div>
                                </div>

                                <div class="space-y-2">
                                    <div class="rounded-md bg-card p-3">
                                        <div class="mb-1.5 flex items-center gap-1.5">
                                            <LucideIconCn Name="arrow-up" Size="12" Class="size-3 text-emerald-600" />
                                            <span class="text-xs font-medium text-emerald-600">Up Script</span>
                                        </div>
                                        <pre class="overflow-x-auto text-wrap break-all font-mono text-muted-foreground text-xs">@migration.UpScript</pre>
                                    </div>

                                    <div class="rounded-md bg-card p-3">
                                        <div class="mb-1.5 flex items-center gap-1.5">
                                            <LucideIconCn Name="arrow-down" Size="12" Class="size-3 text-red-600" />
                                            <span class="text-xs font-medium text-red-600">Down Script</span>
                                        </div>
                                        <pre class="overflow-x-auto text-wrap break-all font-mono text-muted-foreground text-xs">@migration.DownScript</pre>
                                    </div>
                                </div>

                                <div class="flex gap-2">
                                    <ButtonCn Variant="ButtonVariant.Outline" Class="h-6 flex-1 text-xs">
                                        View Full SQL
                                    </ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Outline" Class="h-6 gap-1 text-xs text-red-600">
                                        <LucideIconCn Name="arrow-down" Size="12" Class="size-3" />
                                        Rollback
                                    </ButtonCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record MigrationChanges(int Tables, int Columns, int Indexes);

    private record Migration(
        string Id,
        string Version,
        string Name,
        string Description,
        string ExecutedAt,
        string ExecutionTime,
        string Status,
        string Environment,
        string UpScript,
        string DownScript,
        MigrationChanges Changes
    );

    private static readonly Migration[] _migrations =
    [
        new(
            "mig-2024-03-30-001",
            "20240330_001",
            "add_user_preferences_table",
            "Create user preferences table with JSON settings column",
            "30 min ago",
            "142ms",
            "success",
            "production",
            "CREATE TABLE user_preferences (id SERIAL PRIMARY KEY, user_id INTEGER NOT NULL, settings JSONB, created_at TIMESTAMP DEFAULT NOW());",
            "DROP TABLE user_preferences;",
            new(1, 4, 1)
        ),
        new(
            "mig-2024-03-29-003",
            "20240329_003",
            "add_subscription_tier_column",
            "Add subscription tier enum to users table",
            "2 hours ago",
            "98ms",
            "success",
            "production",
            "ALTER TABLE users ADD COLUMN subscription_tier VARCHAR(20) DEFAULT 'free';",
            "ALTER TABLE users DROP COLUMN subscription_tier;",
            new(0, 1, 0)
        ),
        new(
            "mig-2024-03-29-002",
            "20240329_002",
            "create_analytics_events_table",
            "Create analytics events table for tracking user actions",
            "5 hours ago",
            "256ms",
            "success",
            "production",
            "CREATE TABLE analytics_events (id SERIAL PRIMARY KEY, event_name VARCHAR(100), user_id INTEGER, properties JSONB, created_at TIMESTAMP);",
            "DROP TABLE analytics_events;",
            new(1, 5, 2)
        ),
        new(
            "mig-2024-03-29-001",
            "20240329_001",
            "add_email_verified_at_column",
            "Add email verification timestamp to users table",
            "1 day ago",
            "76ms",
            "success",
            "production",
            "ALTER TABLE users ADD COLUMN email_verified_at TIMESTAMP;",
            "ALTER TABLE users DROP COLUMN email_verified_at;",
            new(0, 1, 0)
        ),
        new(
            "mig-2024-03-28-002",
            "20240328_002",
            "create_workspace_members_table",
            "Create workspace members junction table for team collaboration",
            "2 days ago",
            "187ms",
            "success",
            "production",
            "CREATE TABLE workspace_members (workspace_id INTEGER, user_id INTEGER, role VARCHAR(20), joined_at TIMESTAMP, PRIMARY KEY (workspace_id, user_id));",
            "DROP TABLE workspace_members;",
            new(1, 4, 1)
        ),
    ];

    private string? _expandedMigration = null;

    private void ToggleMigration(string id)
    {
        _expandedMigration = _expandedMigration == id ? null : id;
    }
}
