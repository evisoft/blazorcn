@* ============================================================
   Block: changelog-version-tabs
   Title: ChangelogVersionTabs
   Description: React version tabs changelog block for Next.js with horizontal tab navigation, version-specific change lists, and animated tab transitions built with TypeScript, Framer Motion AnimatePresence, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-version-tabs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="tag" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Version History</span>
        </div>

        @* Version tabs *@
        <div class="flex overflow-x-auto border-b">
            @for (var idx = 0; idx < _versions.Length; idx++)
            {
                var tabIndex = idx;
                var tabVersion = _versions[tabIndex];
                <button type="button"
                        class="@Cn.Merge("relative shrink-0 whitespace-nowrap px-4 py-2.5 font-mono text-xs transition-colors", _activeIndex == tabIndex ? "text-foreground" : "text-muted-foreground hover:text-foreground")"
                        @onclick="@(() => _activeIndex = tabIndex)"
                        aria-pressed="@(_activeIndex == tabIndex ? "true" : "false")">
                    @tabVersion.Label
                    @if (_activeIndex == tabIndex)
                    {
                        <div class="absolute right-0 bottom-0 left-0 h-0.5 bg-foreground"></div>
                    }
                </button>
            }
        </div>

        @* Version date *@
        <div class="bg-muted/30 px-4 py-2">
            <span class="text-muted-foreground text-xs">Released @_versions[_activeIndex].Date</span>
        </div>

        @* Changes *@
        <div>
            @for (var i = 0; i < _versions[_activeIndex].Changes.Length; i++)
            {
                var change = _versions[_activeIndex].Changes[i];
                var isLast = i == _versions[_activeIndex].Changes.Length - 1;
                <div class="@Cn.Merge("flex items-start gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <span class="@Cn.Merge("mt-1.5 size-2 shrink-0 rounded-full", _dotColors[change.Category])"
                          aria-hidden="true"></span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@change.Title</span>
                            <span class="text-muted-foreground/60 text-[10px] capitalize">@change.Category</span>
                        </div>
                        <p class="mt-0.5 text-muted-foreground text-xs">@change.Description</p>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ChangeItem(string Title, string Description, string Category);
    private record VersionEntry(string Label, string Date, ChangeItem[] Changes);

    private int _activeIndex = 0;

    private static readonly Dictionary<string, string> _dotColors = new()
    {
        ["added"] = "bg-emerald-500",
        ["fixed"] = "bg-red-500",
        ["changed"] = "bg-blue-500",
        ["deprecated"] = "bg-amber-500",
    };

    private static readonly VersionEntry[] _versions =
    [
        new("v2.4.0", "Mar 28, 2026",
        [
            new("Team workspace collaboration",
                "Shared editing with real-time cursor presence and role-based access.",
                "added"),
            new("Streaming response API",
                "Server-sent events endpoint for real-time data streaming to clients.",
                "added"),
            new("Dashboard load speed",
                "Streaming SSR reduces initial dashboard render time by 40%.",
                "changed"),
            new("Legacy export format",
                "CSV v1 export format deprecated. Use v2 format with UTF-8 BOM header.",
                "deprecated"),
        ]),
        new("v2.3.0", "Mar 14, 2026",
        [
            new("API key scoping",
                "Generate keys with granular read, write, and admin permissions.",
                "added"),
            new("Webhook delivery logs",
                "View delivery history with status codes, latency, and retry controls.",
                "added"),
            new("OAuth redirect loop",
                "Fixed infinite redirect on SAML providers with multi-value attributes.",
                "fixed"),
            new("Search indexing speed",
                "Full-text indexing reduced from 8 seconds to under 2 seconds.",
                "changed"),
        ]),
        new("v2.2.0", "Feb 28, 2026",
        [
            new("Custom theme editor",
                "Design themes with HSL color pickers and CSS variable export.",
                "added"),
            new("Edge function cold starts",
                "Reduced from 120ms to 45ms through function bundling optimization.",
                "changed"),
            new("Timezone calculation error",
                "Fixed UTC offset for negative timezone regions in scheduling.",
                "fixed"),
            new("Bundle size reduction",
                "Client bundle reduced 18% through tree-shaking improvements.",
                "changed"),
        ]),
    ];
}
