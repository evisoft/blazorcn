@* ============================================================
   Block: changelog-bundle-size
   Title: ChangelogBundleSize
   Description: React bundle size comparison changelog block for Next.js displaying gzipped sizes per release with visual bar indicators and delta percentages built with shadcn/ui Badge, Tailwind CSS, and Framer Motion.
   Source: original/blocks/changelog/changelog-bundle-size.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="package" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Bundle Size</h2>
            <span class="ml-auto text-xs text-muted-foreground">gzipped</span>
        </div>

        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-4 text-center">
                <span class="text-xs text-muted-foreground">Latest</span>
                <p class="mt-1 text-2xl font-semibold tabular-nums">@_latest.TotalSize</p>
            </div>
            <div class="border-r px-4 py-4 text-center">
                <span class="text-xs text-muted-foreground">Previous</span>
                <p class="mt-1 text-2xl font-semibold tabular-nums text-muted-foreground">@_previous.TotalSize</p>
            </div>
            <div class="px-4 py-4 text-center">
                <span class="text-xs text-muted-foreground">Smallest</span>
                <p class="mt-1 text-2xl font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">@_smallest.TotalSize</p>
            </div>
        </div>

        <div>
            @for (var i = 0; i < _releases.Length; i++)
            {
                var release = _releases[i];
                var isExpanded = _expanded == release.Id;
                var barWidth = (release.TotalSizeKb / (double)_maxSize) * 100;
                var btnClass = Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", i < _releases.Length - 1 ? "border-b" : "");
                var releaseId = release.Id;
                <div>
                    <button type="button" class="@btnClass" @onclick="@(() => Toggle(releaseId))">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@release.Version</span>
                                <span class="font-mono text-xs text-muted-foreground">@release.TotalSize</span>
                                @if (release.Delta != 0)
                                {
                                    <span class="@Cn.Merge("flex items-center gap-0.5 text-xs tabular-nums", GetDeltaColor(release.Delta))">
                                        @if (release.Delta < 0)
                                        {
                                            <LucideIconCn Name="arrow-down" Size="12" Class="size-3" />
                                        }
                                        else
                                        {
                                            <LucideIconCn Name="arrow-up" Size="12" Class="size-3" />
                                        }
                                        @Math.Abs(release.Delta)%
                                    </span>
                                }
                            </div>
                            <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted/50">
                                <div class="@Cn.Merge("h-full rounded-full", GetBarColor(release.Delta))" style="@($"width:{barWidth:F1}%")"></div>
                            </div>
                        </div>
                        <span class="shrink-0 text-xs text-muted-foreground">@release.Date</span>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>
                    @if (isExpanded)
                    {
                        var expandClass = Cn.Merge("bg-muted/50 px-4 py-3", i < _releases.Length - 1 ? "border-b" : "");
                        <div class="overflow-hidden">
                            <div class="@expandClass">
                                <span class="text-xs font-medium text-muted-foreground">Chunks</span>
                                <div class="mt-2 space-y-1.5">
                                    @foreach (var chunk in release.Chunks)
                                    {
                                        var chunkWidth = (chunk.SizeKb / release.TotalSizeKb) * 100;
                                        <div class="flex items-center gap-3">
                                            <span class="w-28 shrink-0 truncate font-mono text-xs text-muted-foreground">@chunk.Name</span>
                                            <div class="h-1 flex-1 overflow-hidden rounded-full bg-muted">
                                                <div class="h-full rounded-full bg-foreground/20" style="@($"width:{chunkWidth:F1}%")"></div>
                                            </div>
                                            <span class="w-16 shrink-0 text-right font-mono text-xs tabular-nums text-muted-foreground">@chunk.Size</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Chunk(string Name, string Size, double SizeKb);

    private record Release(string Id, string Version, string Date, string TotalSize, double TotalSizeKb, double Delta, Chunk[] Chunks);

    private const int _maxSize = 172;

    private static readonly Release[] _releases =
    [
        new("r1", "v3.8.0", "Mar 30, 2026", "142 KB", 142, -8.4,
        [
            new("framework", "44.2 KB", 44.2),
            new("vendor", "38.7 KB", 38.7),
            new("app", "31.4 KB", 31.4),
            new("ui-components", "18.1 KB", 18.1),
            new("polyfills", "9.6 KB", 9.6),
        ]),
        new("r2", "v3.7.0", "Mar 22, 2026", "155 KB", 155, -3.1,
        [
            new("framework", "45.0 KB", 45.0),
            new("vendor", "42.3 KB", 42.3),
            new("app", "35.8 KB", 35.8),
            new("ui-components", "19.4 KB", 19.4),
            new("polyfills", "12.5 KB", 12.5),
        ]),
        new("r3", "v3.6.0", "Mar 14, 2026", "160 KB", 160, 5.2,
        [
            new("framework", "44.8 KB", 44.8),
            new("vendor", "41.1 KB", 41.1),
            new("app", "39.2 KB", 39.2),
            new("ui-components", "22.6 KB", 22.6),
            new("polyfills", "12.3 KB", 12.3),
        ]),
        new("r4", "v3.5.0", "Mar 6, 2026", "152 KB", 152, -11.6,
        [
            new("framework", "44.5 KB", 44.5),
            new("vendor", "39.8 KB", 39.8),
            new("app", "33.1 KB", 33.1),
            new("ui-components", "21.9 KB", 21.9),
            new("polyfills", "12.7 KB", 12.7),
        ]),
        new("r5", "v3.4.0", "Feb 26, 2026", "172 KB", 172, 2.4,
        [
            new("framework", "46.2 KB", 46.2),
            new("vendor", "48.1 KB", 48.1),
            new("app", "40.5 KB", 40.5),
            new("ui-components", "24.3 KB", 24.3),
            new("polyfills", "12.9 KB", 12.9),
        ]),
        new("r6", "v3.3.0", "Feb 16, 2026", "168 KB", 168, 0,
        [
            new("framework", "45.8 KB", 45.8),
            new("vendor", "46.7 KB", 46.7),
            new("app", "39.2 KB", 39.2),
            new("ui-components", "23.8 KB", 23.8),
            new("polyfills", "12.5 KB", 12.5),
        ]),
    ];

    private static readonly Release _latest = _releases[0];
    private static readonly Release _previous = _releases[1];
    private static readonly Release _smallest = _releases.MinBy(r => r.TotalSizeKb)!;

    private string? _expanded = "r1";

    private void Toggle(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private static string GetDeltaColor(double delta)
    {
        if (delta < 0) return "text-emerald-600 dark:text-emerald-400";
        if (delta > 0) return "text-red-600 dark:text-red-400";
        return "text-muted-foreground";
    }

    private static string GetBarColor(double delta)
    {
        if (delta < 0) return "bg-emerald-500/20";
        if (delta > 0) return "bg-red-500/20";
        return "bg-muted";
    }
}
