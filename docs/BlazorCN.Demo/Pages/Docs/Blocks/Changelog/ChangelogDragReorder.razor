@* ============================================================
   Block: changelog-drag-reorder
   Title: ChangelogDragReorder
   Description: React drag-to-reorder changelog block for Next.js with grab handles, animated repositioning, and priority numbering built with TypeScript, shadcn/ui Button, Framer Motion Reorder, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-drag-reorder.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="list-ordered" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">Priority Queue</span>
            <span class="text-xs text-muted-foreground">Drag to reorder</span>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                      Class="ml-auto h-7 gap-1 px-2 text-xs text-muted-foreground"
                      OnClick="HandleReset">
                <LucideIconCn Name="rotate-ccw" Size="12" Class="size-3" />
                Reset
            </ButtonCn>
        </div>

        @* Reorderable list *@
        <div class="divide-y">
            @for (var i = 0; i < _items.Length; i++)
            {
                var index = i;
                var item = _items[i];
                <div class="flex cursor-grab items-center gap-3 bg-card px-4 py-3 transition-colors active:cursor-grabbing active:bg-muted/50">
                    <LucideIconCn Name="grip-vertical" Size="16" Class="size-4 shrink-0 text-muted-foreground/40" />
                    <span class="flex size-5 shrink-0 items-center justify-center rounded font-mono text-[10px] text-muted-foreground tabular-nums">
                        @(index + 1)
                    </span>
                    <span class="@Cn.Merge("size-2 shrink-0 rounded-full", _dotColors[item.Category])"
                          aria-hidden="true"></span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-sm font-medium">@item.Title</span>
                            <span class="shrink-0 text-xs text-muted-foreground/60">@item.Date</span>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">@item.Description</p>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between">
                <span class="text-xs text-muted-foreground">@_items.Length items</span>
                <div class="flex items-center gap-3">
                    <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        Features
                    </span>
                    <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        Fixes
                    </span>
                    <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                        <span class="size-1.5 rounded-full bg-blue-500"></span>
                        Improvements
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record ChangeItem(string Id, string Title, string Description, string Date, string Category);

    private static readonly Dictionary<string, string> _dotColors = new()
    {
        ["feature"] = "bg-emerald-500",
        ["fix"] = "bg-red-500",
        ["improvement"] = "bg-blue-500",
    };

    private static readonly ChangeItem[] _initialItems =
    [
        new("d1", "Role-based access control",
            "Granular permissions with viewer, editor, and admin roles per workspace.",
            "Mar 30", "feature"),
        new("d2", "OAuth redirect loop fix",
            "Resolved infinite redirect on SAML providers with multi-value attributes.",
            "Mar 28", "fix"),
        new("d3", "Streaming SSR for dashboards",
            "Initial dashboard load improved by 40% using React streaming server rendering.",
            "Mar 27", "improvement"),
        new("d4", "Webhook retry configuration",
            "Configurable retry intervals with exponential backoff for failed deliveries.",
            "Mar 25", "feature"),
        new("d5", "Search indexing latency",
            "Full-text indexing reduced from 8 seconds to under 2 seconds.",
            "Mar 23", "improvement"),
        new("d6", "CSV export encoding fix",
            "Fixed non-ASCII character encoding in exported CSV reports.",
            "Mar 21", "fix"),
        new("d7", "API key scope management",
            "Generate keys with granular read, write, and admin permission scopes.",
            "Mar 19", "feature"),
    ];

    private ChangeItem[] _items = _initialItems.ToArray();

    private void HandleReset()
    {
        _items = _initialItems.ToArray();
    }
}
