@* ============================================================
   Block: changelog-timeline
   Title: ChangelogTimeline
   Description: React vertical timeline changelog block for Next.js with dot markers, date labels, and categorized entries built with TypeScript, shadcn/ui Badge, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="history" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">Changelog</span>
        </div>

        @* Timeline *@
        <div class="relative px-4 py-3">
            @* Vertical line *@
            <div class="absolute top-6 bottom-6 left-[29px] w-px bg-border" aria-hidden="true"></div>

            <div class="space-y-0">
                @foreach (var entry in _entries)
                {
                    <div class="relative flex gap-4 pb-6 last:pb-0">

                        @* Dot *@
                        <div class="relative z-10 mt-1.5 flex shrink-0">
                            <span class="@Cn.Merge("size-2.5 rounded-full ring-2 ring-card", GetDotColor(entry.Category))"></span>
                        </div>

                        @* Content *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-xs text-muted-foreground">@entry.Date</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-[10px] font-normal capitalize", GetBadgeStyle(entry.Category))">
                                    @entry.Category
                                </BadgeCn>
                            </div>
                            <p class="mt-1 text-sm font-medium">@entry.Title</p>
                            <p class="mt-0.5 text-xs text-muted-foreground">@entry.Description</p>
                        </div>

                    </div>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private record TimelineEntry(string Date, string Title, string Description, string Category);

    private static readonly TimelineEntry[] _entries =
    [
        new("Mar 28, 2026", "AI-powered code suggestions",
            "Inline code completions powered by a fine-tuned model trained on your codebase patterns.",
            "added"),
        new("Mar 25, 2026", "Faster build pipeline",
            "Incremental builds now complete in under 3 seconds for projects with 500+ components.",
            "changed"),
        new("Mar 22, 2026", "Git sync conflict resolution",
            "Resolved an issue where concurrent branch merges could corrupt the sync state file.",
            "fixed"),
        new("Mar 18, 2026", "Custom theme editor",
            "Design and preview color themes in real time with HSL sliders and CSS variable export.",
            "added"),
        new("Mar 14, 2026", "Dashboard widget API",
            "Third-party developers can now register custom dashboard widgets via the plugin API.",
            "added"),
        new("Mar 10, 2026", "Memory leak in WebSocket handler",
            "Fixed a connection pool leak that caused memory growth on long-running sessions.",
            "fixed"),
    ];

    private static string GetDotColor(string category) => category switch
    {
        "added"   => "bg-emerald-500",
        "fixed"   => "bg-red-500",
        "changed" => "bg-blue-500",
        _         => "bg-muted-foreground"
    };

    private static string GetBadgeStyle(string category) => category switch
    {
        "added"   => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-0",
        "fixed"   => "bg-red-500/10 text-red-600 dark:text-red-400 border-0",
        "changed" => "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-0",
        _         => ""
    };
}
