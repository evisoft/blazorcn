@* ============================================================
   Block: changelog-developer-experience
   Title: ChangelogDeveloperExperience
   Description: DX metrics per release tracking build time, hot reload speed, and bundle size. Built with React, Next.js, shadcn/ui, and Tailwind CSS for engineering productivity dashboards.
   Source: original/blocks/changelog/changelog-developer-experience.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="zap" Size="16" Class="size-4 text-muted-foreground" />
                </div>
                <div class="min-w-0 flex-1">
                    <h2 class="text-sm font-medium">Developer Experience</h2>
                    <p class="text-xs text-muted-foreground">Performance metrics per release</p>
                </div>
            </div>
        </div>

        <div class="border-b p-4">
            <span class="text-xs font-medium text-muted-foreground">Filter by Metric Type</span>
            <div class="mt-2 flex flex-wrap gap-2">
                <ButtonCn Variant="@(_selectedType == null ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="@(() => _selectedType = null)">
                    All Metrics
                </ButtonCn>
                @foreach (var type in _metricTypes)
                {
                    var t = type;
                    <ButtonCn Variant="@(_selectedType == t ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="@(() => _selectedType = t)">
                        <LucideIconCn Name="@GetMetricIcon(t)" Size="12" Class="size-3" />
                        @GetMetricLabel(t)
                    </ButtonCn>
                }
            </div>
        </div>

        <div>
            @foreach (var release in _releases)
            {
                var filteredMetrics = GetFilteredMetrics(release.Metrics);
                if (filteredMetrics.Length == 0) continue;
                <div class="border-b last:border-0 p-4">
                    <div class="mb-3 flex items-center justify-between">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-mono text-sm font-medium">@release.Version</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                                    @filteredMetrics.Length metrics
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">@release.Date</p>
                        </div>
                    </div>

                    <div class="space-y-3">
                        @foreach (var metric in filteredMetrics)
                        {
                            var isImprovement = metric.Improvement > 0;
                            var trendClass = Cn.Merge("flex items-center gap-0.5 text-xs", isImprovement ? "text-emerald-500" : "text-red-500");
                            <div class="rounded-md border bg-background p-3">
                                <div class="mb-2 flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        <LucideIconCn Name="@GetMetricIcon(metric.Type)" Size="14" Class="size-3.5 text-muted-foreground" />
                                        <span class="text-xs font-medium">@metric.Name</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span class="font-mono text-sm font-semibold tabular-nums">@metric.Current@metric.Unit</span>
                                        <div class="@trendClass">
                                            @if (isImprovement)
                                            {
                                                <LucideIconCn Name="trending-down" Size="12" Class="size-3" />
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                                            }
                                            <span class="font-mono tabular-nums">@(isImprovement ? "+" : "")@metric.Improvement.ToString("F1")%</span>
                                        </div>
                                    </div>
                                </div>
                                <p class="text-xs text-muted-foreground">@metric.Description</p>
                                <div class="mt-2 flex items-center gap-2 text-xs text-muted-foreground">
                                    <span>Previous: @metric.Previous@metric.Unit</span>
                                    <span>→</span>
                                    <span>Current: @metric.Current@metric.Unit</span>
                                </div>
                            </div>
                        }
                    </div>

                    @if (release.Highlights.Length > 0)
                    {
                        <div class="mt-3 rounded-md bg-muted/50 p-3">
                            <span class="text-xs font-medium text-muted-foreground">Highlights</span>
                            <ul class="mt-1.5 space-y-1">
                                @foreach (var highlight in release.Highlights)
                                {
                                    <li class="text-xs text-muted-foreground">• @highlight</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record DXMetric(string Name, string Type, int Current, int Previous, string Unit, double Improvement, string Description);
    private record Release(string Id, string Version, string Date, DXMetric[] Metrics, string[] Highlights);

    private static readonly string[] _metricTypes = ["build", "hmr", "bundle", "test"];

    private static readonly Release[] _releases =
    [
        new("1", "v3.2.0", "2026-03-28",
        [
            new("Production Build Time", "build", 42, 58, "s", 27.6, "Switched to Turbopack for production builds"),
            new("Hot Module Reload", "hmr", 120, 180, "ms", 33.3, "Optimized Fast Refresh with selective invalidation"),
            new("Client Bundle Size", "bundle", 285, 312, "KB", 8.7, "Removed unused dependencies and tree-shaking improvements"),
            new("Test Suite Execution", "test", 18, 25, "s", 28.0, "Parallelized test runner with 4 workers"),
        ],
        [
            "Turbopack adoption reduced build time by 28%",
            "HMR improvements make local development 33% faster",
        ]),
        new("2", "v3.1.5", "2026-03-21",
        [
            new("Production Build Time", "build", 58, 61, "s", 4.9, "Incremental static regeneration cache improvements"),
            new("Client Bundle Size", "bundle", 312, 298, "KB", -4.7, "Added analytics library (+14KB)"),
        ],
        [
            "Minor build optimizations",
            "Analytics integration added",
        ]),
        new("3", "v3.1.0", "2026-03-14",
        [
            new("Production Build Time", "build", 61, 65, "s", 6.2, "Optimized image processing pipeline"),
            new("Hot Module Reload", "hmr", 180, 220, "ms", 18.2, "Reduced module graph traversal overhead"),
            new("Test Suite Execution", "test", 25, 23, "s", -8.7, "Added integration tests (+2s)"),
        ],
        [
            "HMR latency reduced by 18%",
            "Added 12 integration tests for checkout flow",
        ]),
        new("4", "v3.0.0", "2026-03-07",
        [
            new("Production Build Time", "build", 65, 89, "s", 27.0, "Migrated to Next.js 16 with improved caching"),
            new("Hot Module Reload", "hmr", 220, 280, "ms", 21.4, "Next.js 16 Fast Refresh improvements"),
            new("Client Bundle Size", "bundle", 298, 345, "KB", 13.6, "Automatic RSC splitting and code splitting"),
            new("Test Suite Execution", "test", 23, 27, "s", 14.8, "Upgraded to Vitest with native ESM support"),
        ],
        [
            "Next.js 16 migration delivered 20%+ improvements across all metrics",
            "Client bundle reduced by 47KB through RSC adoption",
        ]),
    ];

    private string? _selectedType = null;

    private DXMetric[] GetFilteredMetrics(DXMetric[] metrics) =>
        _selectedType == null ? metrics : metrics.Where(m => m.Type == _selectedType).ToArray();

    private static string GetMetricIcon(string type) => type switch
    {
        "build" => "clock",
        "hmr" => "refresh-cw",
        "bundle" => "package",
        "test" => "test-tube",
        _ => "circle",
    };

    private static string GetMetricLabel(string type) => type switch
    {
        "build" => "Build",
        "hmr" => "HMR",
        "bundle" => "Bundle",
        "test" => "Tests",
        _ => type,
    };
}
