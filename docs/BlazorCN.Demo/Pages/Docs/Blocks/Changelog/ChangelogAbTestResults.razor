@* ============================================================
   Block: changelog-ab-test-results
   Title: ChangelogAbTestResults
   Description: An A/B test results changelog block for React and Next.js with variant comparison, confidence intervals, conversion metrics, and winner indicators built with shadcn/ui and Tailwind CSS
   Source: original/blocks/changelog/changelog-ab-test-results.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="beaker" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Experiment Results</span>
            </div>
            <span class="text-muted-foreground text-xs">
                @_experiments.Length concluded this sprint
            </span>
        </div>

        @* Experiments *@
        @foreach (var (exp, expIndex) in _experiments.Select((e, i) => (e, i)))
        {
            var hasWinner = exp.Variants.Any(v => v.IsWinner) && exp.Confidence >= 95.0;
            var expDivClass = expIndex < _experiments.Length - 1 ? "border-b" : "";
            <div class="@expDivClass">
                @* Experiment header *@
                <div class="px-4 pt-3 pb-2">
                    <div class="flex items-center gap-2">
                        <span class="font-medium text-sm">@exp.Name</span>
                        @if (hasWinner)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 border-0 bg-emerald-500/10 font-normal text-[10px] text-emerald-600 dark:text-emerald-400">
                                <LucideIconCn Name="check-circle" Size="10" Class="size-2.5" />
                                Winner
                            </BadgeCn>
                        }
                        @if (!hasWinner)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">No winner</BadgeCn>
                        }
                    </div>
                    <p class="mt-0.5 text-muted-foreground text-xs">@exp.Description</p>
                    <div class="mt-1 flex items-center gap-2 text-muted-foreground text-xs">
                        <span>@exp.Duration</span>
                        <span>&middot;</span>
                        <span>@exp.Confidence% confidence</span>
                    </div>
                </div>

                @* Variants *@
                <div class="px-4 pb-3">
                    @foreach (var (variant, vIndex) in exp.Variants.Select((v, i) => (v, i)))
                    {
                        var maxRate = exp.Variants.Max(v => v.ConversionRate);
                        var barWidth = maxRate > 0 ? (variant.ConversionRate / maxRate) * 100.0 : 0.0;
                        var variantRowClass = vIndex > 0 ? "py-1.5 mt-1" : "py-1.5";
                        var rateClass = variant.IsWinner && hasWinner
                            ? "font-semibold text-sm tabular-nums text-emerald-600 dark:text-emerald-400"
                            : "font-semibold text-sm tabular-nums";
                        var barClass = variant.IsWinner && hasWinner
                            ? "h-full rounded-full bg-emerald-500"
                            : "h-full rounded-full bg-muted-foreground/30";
                        var barStyle = FormattableString.Invariant($"width:{barWidth:F1}%");
                        <div class="@variantRowClass">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <span class="text-xs">@variant.Name</span>
                                    @if (variant.IsWinner && hasWinner)
                                    {
                                        <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                                    }
                                </div>
                                <div class="flex items-center gap-3">
                                    <span class="text-muted-foreground text-xs">
                                        n=@variant.SampleSize
                                    </span>
                                    <span class="@rateClass">
                                        @variant.ConversionRate%
                                    </span>
                                </div>
                            </div>
                            <div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                                <div class="@barClass" style="@barStyle"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Statistical significance threshold: 95% &middot; Bayesian analysis
            </p>
        </div>
    </div>
</section>

@code {
    private record ExperimentVariant(string Name, string SampleSize, double ConversionRate, bool IsWinner);
    private record Experiment(string Id, string Name, string Description, double Confidence, ExperimentVariant[] Variants, string Status, string Duration);

    private static readonly Experiment[] _experiments =
    [
        new("exp1", "Checkout flow simplification", "Reduced checkout from 3 steps to 1 single-page flow.", 98.2,
            [
                new("Control (3-step)", "12,340", 3.2, false),
                new("Variant A (1-step)", "12,180", 4.8, true),
            ], "concluded", "14 days"),
        new("exp2", "Pricing page social proof", "Added customer logos and review count above pricing cards.", 94.7,
            [
                new("Control (no proof)", "8,420", 2.1, false),
                new("Variant A (logos)", "8,390", 2.6, true),
            ], "concluded", "21 days"),
        new("exp3", "Onboarding tooltip sequence", "Replaced video walkthrough with progressive tooltip hints.", 72.3,
            [
                new("Control (video)", "5,180", 41.2, false),
                new("Variant A (tooltips)", "5,210", 43.8, false),
            ], "concluded", "10 days"),
    ];
}
