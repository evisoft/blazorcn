@* ============================================================
   Block: changelog-config-changes
   Title: ChangelogConfigChanges
   Description: A configuration changes changelog block built with React, Next.js, shadcn/ui, and Tailwind CSS showing before and after values with diff-style comparison for environment settings
   Source: original/blocks/changelog/changelog-config-changes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="settings" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Configuration Changes</h2>
            <span class="ml-auto text-xs text-muted-foreground tabular-nums">
                @_filtered.Length changes
            </span>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2.5">
            <LucideIconCn Name="filter" Size="12" Class="size-3 text-muted-foreground" />
            @foreach (var env in _environments)
            {
                var envName = env;
                var isActive = _filterEnv == envName;
                var btnClass = Cn.Merge("rounded-md px-1.5 py-0.5 text-[10px] font-medium capitalize transition-colors", isActive ? GetEnvStyle(envName) : "text-muted-foreground hover:text-foreground");
                <button type="button" @onclick="@(() => ToggleFilter(envName))" class="@btnClass">
                    @envName
                </button>
            }
            <div class="ml-auto flex items-center gap-3">
                @foreach (var action in _actions)
                {
                    var actionName = action;
                    var dotClass = Cn.Merge("size-1.5 rounded-full", GetActionDotClass(actionName));
                    <div class="flex items-center gap-1">
                        <span class="@dotClass"></span>
                        <span class="text-[10px] text-muted-foreground capitalize">@actionName</span>
                    </div>
                }
            </div>
        </div>

        <div>
            @for (var i = 0; i < _filtered.Length; i++)
            {
                var change = _filtered[i];
                var isLast = i == _filtered.Length - 1;
                var isExpanded = _expanded == change.Id;
                var rowClass = isLast ? "" : "border-b";
                var dotClass = Cn.Merge("size-1.5 shrink-0 rounded-full", GetActionDotClass(change.Action));
                var envClass = Cn.Merge("shrink-0 rounded-md px-1.5 py-0.5 text-[10px] font-medium capitalize", GetEnvStyle(change.Environment));
                var chevronClass = Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
                var changeId = change.Id;
                <div class="@rowClass">
                    <button
                        type="button"
                        @onclick="@(() => ToggleExpanded(changeId))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@dotClass"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate font-mono text-sm font-medium">@change.Key</span>
                                <span class="@envClass">@change.Environment</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-1.5">
                                @if (change.PreviousValue != null)
                                {
                                    <span class="font-mono text-xs text-red-500/70 line-through">@change.PreviousValue</span>
                                }
                                @if (change.PreviousValue != null && change.NewValue != null)
                                {
                                    <LucideIconCn Name="arrow-right" Size="12" Class="size-3 text-muted-foreground/50" />
                                }
                                @if (change.NewValue != null)
                                {
                                    <span class="font-mono text-xs text-emerald-600">@change.NewValue</span>
                                }
                                @if (change.PreviousValue != null && change.NewValue == null)
                                {
                                    <span class="text-xs text-red-500/70">removed</span>
                                }
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/30 px-4 py-3 pl-9">
                            <p class="text-xs text-muted-foreground leading-relaxed">@change.Description</p>
                            <div class="mt-2 flex items-center gap-2">
                                <span class="text-[10px] text-muted-foreground">@change.Author</span>
                                <span class="text-[10px] text-muted-foreground/50">&middot;</span>
                                <span class="text-[10px] text-muted-foreground">@change.Timestamp</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto text-[10px] capitalize">@change.Action</BadgeCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ConfigChange(
        string Id,
        string Key,
        string? PreviousValue,
        string? NewValue,
        string Action,
        string Environment,
        string Author,
        string Timestamp,
        string Description
    );

    private string? _expanded = "c1";
    private string? _filterEnv;

    private ConfigChange[] _filtered => _filterEnv is not null
        ? _changes.Where(c => c.Environment == _filterEnv).ToArray()
        : _changes;

    private void ToggleExpanded(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private void ToggleFilter(string env)
    {
        _filterEnv = _filterEnv == env ? null : env;
    }

    private static string GetActionDotClass(string action) => action switch
    {
        "updated" => "bg-blue-500",
        "added"   => "bg-emerald-500",
        "removed" => "bg-red-500",
        _         => "bg-gray-500",
    };

    private static string GetEnvStyle(string env) => env switch
    {
        "production"  => "bg-red-500/10 text-red-600",
        "staging"     => "bg-amber-500/10 text-amber-600",
        "development" => "bg-blue-500/10 text-blue-600",
        _             => "bg-gray-500/10 text-gray-600",
    };

    private static readonly string[] _environments = ["production", "staging", "development"];
    private static readonly string[] _actions = ["added", "updated", "removed"];

    private static readonly ConfigChange[] _changes =
    [
        new("c1", "RATE_LIMIT_MAX_REQUESTS", "100", "250", "updated", "production", "sarah-chen", "Mar 28, 14:22",
            "Increased rate limit to handle traffic spike from partner integration launch."),
        new("c2", "FEATURE_REALTIME_COLLAB", "false", "true", "updated", "production", "marcus-r", "Mar 28, 11:05",
            "Enabled real-time collaboration feature flag for all production users."),
        new("c3", "REDIS_CLUSTER_NODES", null, "redis-1:6379,redis-2:6379,redis-3:6379", "added", "staging", "priya-s", "Mar 27, 16:40",
            "Added Redis cluster configuration for session store migration testing."),
        new("c4", "DB_POOL_SIZE", "20", "50", "updated", "staging", "alex-kim", "Mar 27, 09:18",
            "Increased database connection pool to support batch import load testing."),
        new("c5", "LEGACY_AUTH_ENDPOINT", "/api/v1/auth/login", null, "removed", "development", "marcus-r", "Mar 26, 15:33",
            "Removed deprecated v1 auth endpoint reference after migration to v2 OAuth."),
        new("c6", "CDN_CACHE_TTL_SECONDS", "3600", "86400", "updated", "production", "lina-t", "Mar 26, 10:12",
            "Extended CDN cache TTL from 1 hour to 24 hours for static asset performance."),
        new("c7", "OTEL_SAMPLING_RATE", "0.01", "0.1", "updated", "staging", "priya-s", "Mar 25, 17:45",
            "Increased OpenTelemetry sampling rate to 10% for debugging latency issues."),
        new("c8", "WEBHOOK_RETRY_MAX_ATTEMPTS", null, "5", "added", "production", "sarah-chen", "Mar 25, 08:30",
            "Added configurable retry limit for webhook delivery failures."),
    ];
}
