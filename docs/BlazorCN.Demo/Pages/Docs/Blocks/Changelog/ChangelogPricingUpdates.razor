@* ============================================================
   Block: changelog-pricing-updates
   Title: ChangelogPricingUpdates
   Description: A changelog block displaying pricing change history with strikethrough old prices, new prices, plan names, and effective dates in a clean comparison format.
   Source: original/blocks/changelog/changelog-pricing-updates.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="credit-card" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Pricing Updates</h2>
            <span class="ml-auto text-xs text-muted-foreground">@_entries.Length changes</span>
        </div>

        @* Entries *@
        <div>
            @for (var i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                var idx = i;
                var isIncrease = entry.NewPrice > entry.OldPrice;
                var isLast = idx == _entries.Length - 1;
                var isExpanded = _expanded == entry.Id;
                <div>
                    <button type="button"
                            class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")"
                            @onclick="@(() => ToggleExpanded(entry.Id))">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            @if (isIncrease)
                            {
                                <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-red-500" />
                            }
                            else
                            {
                                <LucideIconCn Name="trending-down" Size="14" Class="size-3.5 text-emerald-500" />
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@entry.Plan</span>
                                <span class="text-xs text-muted-foreground">@entry.Interval</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-1.5">
                                <span class="font-mono text-xs text-muted-foreground line-through">
                                    $@entry.OldPrice
                                </span>
                                <LucideIconCn Name="arrow-right" Size="12" Class="size-3 text-muted-foreground/60" />
                                <span class="@Cn.Merge("font-mono text-xs font-medium", isIncrease ? "text-red-600" : "text-emerald-600")">
                                    $@entry.NewPrice
                                </span>
                                <span class="@Cn.Merge("rounded px-1 py-0.5 text-xs", isIncrease ? "bg-red-500/10 text-red-600" : "bg-emerald-500/10 text-emerald-600")">
                                    @(isIncrease ? "+" : "-")@GetChangePercent(entry.OldPrice, entry.NewPrice)
                                </span>
                            </div>
                        </div>
                        <span class="shrink-0 text-xs text-muted-foreground">@entry.Date</span>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>
                    @if (isExpanded)
                    {
                        <div class="@Cn.Merge("bg-muted/50 px-4 py-3", !isLast ? "border-b" : "")">
                            <p class="text-xs leading-relaxed text-muted-foreground">@entry.Detail</p>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record PricingEntry(string Id, string Date, string Plan, string Interval, int OldPrice, int NewPrice, string Summary, string Detail);

    private static readonly PricingEntry[] _entries =
    [
        new("p1", "Mar 28, 2026", "Organization", "monthly", 149, 159,
            "Organization monthly plan adjusted for expanded features",
            "Reflects addition of unlimited audit logs, SSO enforcement, and IP allowlisting. Existing subscribers grandfathered at $149/mo until renewal after June 2026."),
        new("p2", "Mar 15, 2026", "Team", "yearly", 499, 469,
            "Team yearly plan reduced to improve annual conversion",
            "Reduced from $499 to $469/year (6% decrease). Prorated credits issued to customers who purchased in the last 30 days."),
        new("p3", "Mar 1, 2026", "Individual", "lifetime", 549, 599,
            "Individual lifetime price increased",
            "Lifetime deal adjusted from $549 to $599 to reflect the growing component library (now 2,000+ components). Previous purchasers unaffected."),
        new("p4", "Feb 18, 2026", "Team", "monthly", 89, 79,
            "Team monthly introductory pricing",
            "Reduced from $89 to $79/mo as part of the Q1 growth initiative. Includes 5 seats with collaborative workspace features."),
        new("p5", "Feb 5, 2026", "Individual", "monthly", 35, 39,
            "Individual monthly plan standardized",
            "Adjusted from $35 to $39/mo to align with market positioning. All new features including AI components and shader library included at this tier."),
        new("p6", "Jan 20, 2026", "Organization", "yearly", 999, 949,
            "Organization annual discount deepened",
            "Yearly price reduced from $999 to $949 (5% decrease) to incentivize annual commitments. Effectively $79/mo, down from $83/mo."),
    ];

    private string? _expanded;

    private void ToggleExpanded(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private static string GetChangePercent(int oldP, int newP)
    {
        var pct = (int)Math.Round(Math.Abs((double)(newP - oldP) / oldP * 100));
        return $"{pct}%";
    }
}
