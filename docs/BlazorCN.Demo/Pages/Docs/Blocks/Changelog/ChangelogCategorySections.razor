@* ============================================================
   Block: changelog-category-sections
   Title: ChangelogCategorySections
   Description: React category sections changelog block for Next.js with entries grouped under emoji section headers for features, bug fixes, and improvements built with TypeScript, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-category-sections.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="layout-list" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Release Notes</h2>
            <span class="ml-auto text-xs text-muted-foreground">
                v3.12.0 &middot; Mar 28, 2026
            </span>
        </div>

        @for (var si = 0; si < _sections.Length; si++)
        {
            var sec = _sections[si];
            var sectionClass = si < _sections.Length - 1 ? "border-b" : "";
            <div class="@sectionClass">
                <div class="px-4 pb-1 pt-3">
                    <h3 class="text-xs font-medium text-muted-foreground">@sec.Label</h3>
                </div>

                @for (var ei = 0; ei < sec.Entries.Length; ei++)
                {
                    var entry = sec.Entries[ei];
                    var entryClass = ei < sec.Entries.Length - 1 ? "px-4 py-2.5 transition-colors hover:bg-muted/50 border-b border-dashed" : "px-4 py-2.5 transition-colors hover:bg-muted/50";
                    <div class="@entryClass">
                        <span class="text-sm font-medium">@entry.Title</span>
                        <p class="mt-0.5 text-xs text-muted-foreground leading-relaxed">
                            @entry.Description
                        </p>
                    </div>
                }
            </div>
        }

    </div>
</section>

@code {
    private record Entry(string Title, string Description);

    private record Section(string Label, Entry[] Entries);

    private static readonly Section[] _sections =
    [
        new("✨ New Features",
        [
            new("Collaborative workspaces",
                "Create shared workspaces with real-time presence and cross-team project visibility."),
            new("Inline comment threads",
                "Add threaded comments directly on any table cell, document block, or dashboard widget."),
            new("Keyboard shortcut overlay",
                "Press Ctrl+/ to view all available shortcuts contextual to the current view."),
        ]),
        new("🐛 Bug Fixes",
        [
            new("Export timeout on large datasets",
                "Resolved CSV exports silently failing when datasets exceeded 50,000 rows."),
            new("Session expiry during editing",
                "Fixed sessions dropping mid-edit causing unsaved work loss for users with 2+ hour sessions."),
            new("Duplicate rows in cursor pagination",
                "Corrected overlapping results when events shared identical timestamps in paginated endpoints."),
        ]),
        new("⚡ Improvements",
        [
            new("Dashboard load time reduced 40%",
                "Optimized initial query batching and lazy-loaded non-critical widgets for faster first paint."),
            new("Webhook delivery reliability",
                "Failed webhooks now retry with exponential backoff up to 5 attempts over 24 hours."),
            new("Bulk import batch size increased",
                "Default batch size raised from 100 to 500, reducing total API calls by 80% for large imports."),
        ]),
    ];
}
