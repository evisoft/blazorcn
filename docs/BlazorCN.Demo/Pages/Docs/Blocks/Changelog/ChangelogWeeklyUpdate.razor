@* ============================================================
   Block: changelog-weekly-update
   Title: ChangelogWeeklyUpdate
   Description: React weekly update changelog block for Next.js with week header, summary sentence, and daily grouped entries built with TypeScript, shadcn/ui Badge, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-weekly-update.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideIconCn Name="clock" Size="16" Class="size-4 text-muted-foreground" />
            <div>
                <p class="text-sm font-medium">@_week.DateRange</p>
                <p class="text-xs text-muted-foreground">Weekly update</p>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-sm text-muted-foreground">@_week.Summary</p>
        </div>

        @foreach (var day in _week.Days)
        {
            var dayData = day;
            <div>
                <div class="border-b px-4 py-2">
                    <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">@dayData.Label</p>
                </div>
                @foreach (var entry in dayData.Entries)
                {
                    var entryData = entry;
                    var isLastEntry = dayData.Entries.IndexOf(entryData) < dayData.Entries.Count - 1 || _week.Days.IndexOf(dayData) < _week.Days.Count - 1;
                    var entryClass = Cn.Merge("flex items-start gap-3 px-4 py-3", isLastEntry ? "border-b" : "");
                    <div class="@entryClass">
                        <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-muted-foreground/40"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <p class="text-sm font-medium">@entryData.Title</p>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="@GetBadgeClass(entryData.Category)">@entryData.Category</BadgeCn>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">@entryData.Description</p>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</section>

@code {
    private record Entry(string Title, string Description, string Category);
    private record Day(string Label, List<Entry> Entries);
    private record Week(string DateRange, string Summary, List<Day> Days);

    private static string GetBadgeClass(string category) => category switch
    {
        "feature"     => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-0",
        "fix"         => "bg-red-500/10 text-red-600 dark:text-red-400 border-0",
        "improvement" => "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-0",
        "docs"        => "bg-violet-500/10 text-violet-600 dark:text-violet-400 border-0",
        _             => "",
    };

    private static readonly Week _week = new(
        DateRange: "Week of Mar 24",
        Summary: "Shipped workspace permissions, improved build performance, and fixed three critical bugs reported by customers.",
        Days:
        [
            new("Friday",
            [
                new("Workspace invite links",
                    "Generate shareable invite links with configurable expiry and role assignment.",
                    "feature"),
            ]),
            new("Thursday",
            [
                new("Build pipeline caching",
                    "Added layer caching to CI builds reducing average build time from 8m to 3m.",
                    "improvement"),
                new("API rate limit headers",
                    "All responses now include X-RateLimit-Remaining and X-RateLimit-Reset headers.",
                    "improvement"),
            ]),
            new("Wednesday",
            [
                new("File upload timeout",
                    "Fixed premature connection close on uploads larger than 50MB over slow networks.",
                    "fix"),
                new("Migration guide for v3",
                    "Published step-by-step migration guide covering all breaking changes in v3.0.",
                    "docs"),
            ]),
            new("Tuesday",
            [
                new("Keyboard shortcut conflicts",
                    "Resolved Cmd+K collision between search and the new command palette.",
                    "fix"),
            ]),
            new("Monday",
            [
                new("SSO configuration panel",
                    "New admin panel for configuring SAML and OIDC identity providers.",
                    "feature"),
                new("Stale session redirect",
                    "Fixed redirect loop when accessing protected routes with an expired session cookie.",
                    "fix"),
            ]),
        ]
    );
}
