@* ============================================================
   Block: changelog-hover-details
   Title: ChangelogHoverDetails
   Description: A changelog block where entries show only titles by default and smoothly reveal full descriptions on hover with animated height transitions
   Source: original/blocks/changelog/changelog-hover-details.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="mouse-pointer" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">Changelog</span>
            <span class="text-xs text-muted-foreground">Hover to reveal details</span>
        </div>

        <div>
            @foreach (var ent in _entries)
            {
                var entry = ent;
                var isHovered = _hoveredId == entry.Id;
                var isLast = entry.Id == _entries[^1].Id;
                <div class="@Cn.Merge("cursor-default px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")"
                     tabindex="0"
                     @onmouseenter="@(() => _hoveredId = entry.Id)"
                     @onmouseleave="@(() => _hoveredId = null)"
                     @onfocus="@(() => _hoveredId = entry.Id)"
                     @onblur="@(() => _hoveredId = null)">
                    <div class="flex items-center gap-3">
                        <span class="shrink-0 font-mono text-xs text-muted-foreground">@entry.Version</span>
                        <span class="min-w-0 flex-1 truncate text-sm font-medium">@entry.Title</span>
                        <span class="@Cn.Merge("shrink-0 text-[11px] font-medium capitalize", GetTagStyle(entry.Tag))">@entry.Tag</span>
                        <span class="shrink-0 text-xs text-muted-foreground">@entry.Date</span>
                    </div>
                    <div class="@Cn.Merge("overflow-hidden transition-all duration-200", isHovered ? "max-h-40 opacity-100" : "max-h-0 opacity-0")">
                        <p class="mt-2 text-xs leading-relaxed text-muted-foreground">@entry.Description</p>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ChangelogEntry(string Id, string Version, string Date, string Title, string Description, string Tag);

    private static readonly ChangelogEntry[] _entries =
    [
        new("1", "v4.2.0", "Mar 27, 2026", "Collaborative editing with conflict resolution",
            "Multiple users can now edit the same document simultaneously. Our CRDT-based engine automatically resolves conflicts without data loss, showing live cursors and selections in real time.",
            "feature"),
        new("2", "v4.1.3", "Mar 22, 2026", "Fixed file upload timeout on large assets",
            "Resolved an issue where uploads exceeding 100MB would silently fail after 30 seconds. Uploads now use chunked transfer with automatic resume on network interruption.",
            "fix"),
        new("3", "v4.1.2", "Mar 17, 2026", "Migrated authentication to OAuth 2.1",
            "All authentication flows now use OAuth 2.1 with PKCE. Legacy token-based auth is deprecated and will be removed in v5.0. Update your integrations before June 2026.",
            "breaking"),
        new("4", "v4.1.1", "Mar 12, 2026", "Added granular permission scopes for API keys",
            "API keys can now be scoped to specific resources and actions. Create read-only keys for monitoring, write keys for CI/CD, or full-access keys for admin operations.",
            "feature"),
        new("5", "v4.1.0", "Mar 7, 2026", "Fixed dashboard widget layout persistence",
            "Custom dashboard layouts are now correctly saved and restored across sessions. Previously, rearranged widgets would reset to defaults after signing out.",
            "fix"),
        new("6", "v4.0.0", "Mar 1, 2026", "Replaced REST API with GraphQL endpoint",
            "The primary API is now GraphQL-first. The REST API remains available at /api/v3 but will not receive new features. Migration guide available in the documentation.",
            "breaking"),
    ];

    private string? _hoveredId;

    private static string GetTagStyle(string tag) => tag switch
    {
        "feature" => "text-emerald-600 dark:text-emerald-400",
        "fix"     => "text-red-600 dark:text-red-400",
        "breaking" => "text-amber-600 dark:text-amber-400",
        _          => ""
    };
}
