@* ============================================================
   Block: changelog-downtime-schedule
   Title: ChangelogDowntimeSchedule
   Description: Plan and communicate maintenance windows with duration bars, affected services, and impact timelines. Built with React, Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-downtime-schedule.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Maintenance Schedule</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @FilteredWindows.Length maintenance windows
                    </p>
                </div>
                <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground/60" />
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between gap-3">
                <select @bind="_statusFilter"
                        aria-label="Filter maintenance windows by status"
                        class="h-8 w-[140px] rounded-md border border-input bg-background px-2 text-xs focus:outline-none focus:ring-1 focus:ring-ring">
                    <option value="upcoming">Upcoming</option>
                    <option value="completed">Completed</option>
                    <option value="all">All windows</option>
                </select>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Add maintenance</ButtonCn>
            </div>
        </div>

        <div class="divide-y">
            @foreach (var win in FilteredWindows)
            {
                var window = win;
                var isExpanded = _expandedId == window.Id;
                var iconBoxClass = Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-md", window.Type == "emergency" ? "bg-red-500/10" : "bg-muted/50");
                var chevronClass = Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
                var barColorClass = window.Status == "completed" ? "bg-muted-foreground/30"
                    : window.Status == "in-progress" ? "bg-blue-500"
                    : window.Type == "emergency" ? "bg-red-500"
                    : "bg-emerald-500";
                var barClass = "h-full rounded-full " + barColorClass;
                var barWidth = FormattableString.Invariant($"width:{GetDurationWidth(window.Duration)}%");
                <div>
                    <button type="button"
                            class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => ToggleExpanded(window.Id))">
                        <div class="@iconBoxClass">
                            @if (window.Type == "emergency")
                            {
                                <LucideIconCn Name="alert-triangle" Size="16" Class="size-4 text-red-500" />
                            }
                            else
                            {
                                <LucideIconCn Name="@window.AffectedServices[0].Icon" Size="16" Class="size-4 text-muted-foreground" />
                            }
                        </div>

                        <div class="min-w-0 flex-1">
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@window.Title</span>
                                        @if (window.Type == "emergency")
                                        {
                                            <BadgeCn Variant="BadgeVariant.Outline" Class="border-red-500/20 bg-red-500/10 text-red-600">Emergency</BadgeCn>
                                        }
                                        @if (window.Status == "in-progress")
                                        {
                                            <span class="flex items-center gap-1 text-xs text-muted-foreground">
                                                <span class="size-1.5 animate-pulse rounded-full bg-blue-500"></span>
                                                In progress
                                            </span>
                                        }
                                    </div>
                                    <div class="mt-1 flex items-center gap-3 text-xs text-muted-foreground">
                                        <span class="flex items-center gap-1">
                                            <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                            @window.StartTime
                                        </span>
                                        <span>@window.Duration min</span>
                                        @if (window.NotificationSent)
                                        {
                                            <span class="flex items-center gap-1">
                                                <LucideIconCn Name="bell" Size="12" Class="size-3" />
                                                Notified
                                            </span>
                                        }
                                    </div>
                                    <div class="mt-2 flex items-center gap-2">
                                        @foreach (var svc in window.AffectedServices)
                                        {
                                            var svcBadgeClass = Cn.Merge("gap-1 text-xs", svc.Impact == "full" ? "border-amber-500/20 bg-amber-500/10 text-amber-600" : "border-blue-500/20 bg-blue-500/10 text-blue-600");
                                            <BadgeCn Variant="BadgeVariant.Outline" Class="@svcBadgeClass">
                                                <LucideIconCn Name="@svc.Icon" Size="12" Class="size-3" />
                                                @svc.Name
                                            </BadgeCn>
                                        }
                                    </div>
                                    <div class="mt-2">
                                        <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted/50">
                                            <div class="@barClass" style="@barWidth"></div>
                                        </div>
                                    </div>
                                </div>

                                <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                            </div>
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/30 px-4 py-3">
                            <div class="space-y-3 pl-11">
                                <div>
                                    <p class="text-xs font-medium text-muted-foreground">Description</p>
                                    <p class="mt-1 text-sm text-foreground">@window.Description</p>
                                </div>

                                <div>
                                    <p class="text-xs font-medium text-muted-foreground">Impact details</p>
                                    <div class="mt-2 space-y-1.5">
                                        @foreach (var svc in window.AffectedServices)
                                        {
                                            <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                                                <div class="flex items-center gap-2">
                                                    <LucideIconCn Name="@svc.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
                                                    <span class="text-xs font-medium">@svc.Name</span>
                                                </div>
                                                <span class="text-xs text-muted-foreground">
                                                    @(svc.Impact == "full" ? "Full outage" : "Partial degradation")
                                                </span>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="flex gap-2">
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                                        <LucideIconCn Name="bell" Size="12" Class="size-3" />
                                        Subscribe
                                    </ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">Edit window</ButtonCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record AffectedService(string Name, string Icon, string Impact);

    private record MaintenanceWindow(
        string Id,
        string Title,
        string StartTime,
        int Duration,
        string Status,
        string Type,
        AffectedService[] AffectedServices,
        string Description,
        bool NotificationSent
    );

    private static readonly MaintenanceWindow[] _maintenanceWindows =
    [
        new("mw-1", "Database cluster migration to PostgreSQL 16", "2026-04-02 02:00 UTC", 240, "scheduled", "planned",
            [
                new("API", "server", "full"),
                new("Database", "database", "full"),
                new("Web App", "globe", "full"),
            ],
            "Upgrading primary database cluster with zero-downtime migration strategy. All write operations will be paused during the maintenance window.",
            false),
        new("mw-2", "CDN cache invalidation and edge redistribution", "2026-03-31 14:00 UTC", 60, "in-progress", "planned",
            [
                new("CDN", "globe", "partial"),
                new("Assets", "server", "partial"),
            ],
            "Redistributing static assets to new edge locations in APAC region. Minor latency increase expected during propagation.",
            true),
        new("mw-3", "Emergency security patch deployment", "2026-03-30 22:00 UTC", 45, "scheduled", "emergency",
            [
                new("Auth", "shield", "full"),
                new("API", "server", "partial"),
            ],
            "Critical security update to address CVE-2026-5678. Authentication services will be briefly unavailable during patch deployment.",
            true),
        new("mw-4", "Load balancer firmware upgrade", "2026-04-05 03:00 UTC", 120, "scheduled", "planned",
            [new("Infrastructure", "server", "partial")],
            "Rolling upgrade of load balancer fleet. Traffic will be shifted between regions with minimal user impact.",
            false),
        new("mw-5", "Backup system maintenance", "2026-03-28 01:00 UTC", 180, "completed", "planned",
            [new("Backups", "database", "full")],
            "Scheduled backup verification and retention policy enforcement. No customer-facing impact expected.",
            true),
    ];

    private string _statusFilter = "upcoming";
    private string? _expandedId;

    private MaintenanceWindow[] FilteredWindows => _maintenanceWindows
        .Where(w => _statusFilter == "upcoming"
            ? (w.Status == "scheduled" || w.Status == "in-progress")
            : _statusFilter == "completed"
                ? w.Status == "completed"
                : true)
        .ToArray();

    private void ToggleExpanded(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private static double GetDurationWidth(int duration) =>
        Math.Min((duration / 240.0) * 100, 100);
}
