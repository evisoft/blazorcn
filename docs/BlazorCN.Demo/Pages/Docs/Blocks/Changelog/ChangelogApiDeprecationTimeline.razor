@* ============================================================
   Block: changelog-api-deprecation-timeline
   Title: ChangelogApiDeprecationTimeline
   Description: An API deprecation timeline changelog block for React and Next.js with deprecation phases, migration deadlines, sunset dates, and code replacement examples built with shadcn/ui and Tailwind CSS
   Source: original/blocks/changelog/changelog-api-deprecation-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">API v1 Deprecation</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="border-0 bg-amber-500/10 font-normal text-[10px] text-amber-600 dark:text-amber-400">
                16 days to deadline
            </BadgeCn>
        </div>

        @* Timeline phases *@
        <div class="relative px-4 py-3">
            <div class="absolute top-6 bottom-6 left-[29px] w-px bg-border" aria-hidden="true"></div>
            @foreach (var phase in _phases)
            {
                var iconName = GetPhaseIconName(phase.Status);
                var iconColor = GetPhaseIconColor(phase.Status);
                var dotBg = phase.Status == "active" ? "bg-amber-500/10" : "bg-muted";
                var dotClass = Cn.Merge("flex size-5 items-center justify-center rounded-full ring-2 ring-card", dotBg);
                var iconClass = Cn.Merge("size-3", iconColor);
                var nameClass = Cn.Merge("font-medium text-sm", phase.Status == "upcoming" ? "text-muted-foreground" : "");
                <div class="relative flex gap-4 pb-4 last:pb-0">
                    <div class="relative z-10 mt-0.5 flex shrink-0">
                        <span class="@dotClass">
                            <LucideIconCn Name="@iconName" Size="12" Class="@iconClass" />
                        </span>
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="@nameClass">@phase.Name</span>
                            <span class="text-muted-foreground text-xs">@phase.Date</span>
                        </div>
                        <p class="mt-0.5 text-muted-foreground text-xs">@phase.Description</p>
                    </div>
                </div>
            }
        </div>

        @* Affected endpoints label *@
        <div class="border-t px-4 py-2">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="code" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs uppercase tracking-wider">
                    Affected Endpoints
                </span>
            </div>
        </div>

        @* Endpoint rows *@
        @for (var i = 0; i < _endpoints.Length; i++)
        {
            var ep = _endpoints[i];
            var epClass = i < _endpoints.Length - 1 ? "px-4 py-2.5 border-b" : "px-4 py-2.5";
            <div class="@epClass">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-[10px] font-normal">
                            @ep.Method
                        </BadgeCn>
                        <span class="font-mono text-xs line-through decoration-muted-foreground/50">
                            @ep.Path
                        </span>
                    </div>
                    <span class="text-muted-foreground text-xs">@ep.UsageCount</span>
                </div>
                <div class="mt-1 flex items-center gap-2">
                    <span class="text-muted-foreground text-xs">→</span>
                    <span class="font-mono text-xs text-emerald-600 dark:text-emerald-400">
                        @ep.Replacement
                    </span>
                </div>
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Migration guide available at docs.acme.com/migrate/v2
            </p>
        </div>

    </div>
</section>

@code {
    private record DeprecationPhase(
        string Id,
        string Name,
        string Date,
        string Status,
        string Description
    );

    private record DeprecatedEndpoint(
        string Method,
        string Path,
        string Replacement,
        string UsageCount
    );

    private static readonly DeprecationPhase[] _phases =
    [
        new("p1", "Deprecation announced", "Jan 15, 2026", "completed",
            "Deprecation headers added to API responses. Documentation updated."),
        new("p2", "Warning period", "Mar 1, 2026", "completed",
            "Console warnings logged for all deprecated endpoint calls."),
        new("p3", "Migration deadline", "Apr 15, 2026", "active",
            "Last day to migrate. Rate limits applied to deprecated endpoints."),
        new("p4", "Sunset", "May 1, 2026", "upcoming",
            "Deprecated endpoints return 410 Gone. No further support."),
    ];

    private static readonly DeprecatedEndpoint[] _endpoints =
    [
        new("GET",  "/api/v1/users",        "/api/v2/users",    "~2,400/day"),
        new("POST", "/api/v1/users/search",  "/api/v2/users?q=", "~890/day"),
        new("PUT",  "/api/v1/users/:id",     "/api/v2/users/:id","~340/day"),
    ];

    private static string GetPhaseIconName(string status) => status switch
    {
        "completed" => "check",
        "active"    => "alert-triangle",
        _           => "clock",
    };

    private static string GetPhaseIconColor(string status) => status switch
    {
        "completed" => "text-muted-foreground",
        "active"    => "text-amber-600 dark:text-amber-400",
        _           => "text-muted-foreground/60",
    };
}
