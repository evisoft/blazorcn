@* ============================================================
   Block: changelog-plugin-updates
   Title: ChangelogPluginUpdates
   Description: A changelog block showing plugin and extension version history with old and new version numbers, plugin names, and compatibility notes for each update.
   Source: original/blocks/changelog/changelog-plugin-updates.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="puzzle" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Plugin Updates</h2>
            <span class="ml-auto text-xs text-muted-foreground">@_plugins.Length updates</span>
        </div>

        <div>
            @foreach (var pl in _plugins)
            {
                var plugin = pl;
                var isLast = plugin.Id == _plugins[^1].Id;
                var isExpanded = _expanded == plugin.Id;
                <div>
                    <button type="button"
                            class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", isLast ? "" : "border-b")"
                            @onclick="@(() => Toggle(plugin.Id))">
                        @if (plugin.Breaking)
                        {
                            <span class="size-1.5 shrink-0 rounded-full bg-red-500"></span>
                        }
                        else if (plugin.IsMajor)
                        {
                            <span class="size-1.5 shrink-0 rounded-full bg-amber-500"></span>
                        }
                        else
                        {
                            <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                        }
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <code class="font-mono text-sm font-medium">@plugin.Name</code>
                                @if (plugin.IsMajor)
                                {
                                    <span class="rounded bg-amber-500/10 px-1 py-0.5 text-xs font-medium text-amber-600">
                                        major
                                    </span>
                                }
                            </div>
                            <div class="mt-0.5 flex items-center gap-1.5">
                                <span class="font-mono text-xs text-muted-foreground">@plugin.OldVersion</span>
                                <LucideIconCn Name="arrow-right" Size="12" Class="size-3 text-muted-foreground/60" />
                                <span class="font-mono text-xs font-medium text-foreground">@plugin.NewVersion</span>
                                <span class="text-xs text-muted-foreground">·</span>
                                <span class="text-xs text-muted-foreground">@plugin.Compatibility</span>
                            </div>
                        </div>
                        <span class="shrink-0 text-xs text-muted-foreground">@plugin.Date</span>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>
                    @if (isExpanded)
                    {
                        <div class="@Cn.Merge("bg-muted/50 px-4 py-3", isLast ? "" : "border-b")">
                            <p class="text-xs leading-relaxed text-muted-foreground">@plugin.Detail</p>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record PluginEntry(
        string Id,
        string Date,
        string Name,
        string OldVersion,
        string NewVersion,
        string Compatibility,
        string Summary,
        string Detail,
        bool IsMajor,
        bool Breaking);

    private static readonly PluginEntry[] _plugins =
    [
        new("pl1", "Mar 28, 2026", "@@shadcn/cli", "2.4.1", "3.0.0", "Node.js >= 20",
            "Major release with new component registry protocol",
            "Introduces registry v2 protocol with tree-shaking support, parallel downloads, and dependency resolution. The init command now supports --template flag for starter configs. Breaking: dropped Node 18 support.",
            true, true),
        new("pl2", "Mar 25, 2026", "fumadocs-mdx", "4.1.0", "4.2.0", "Next.js >= 15",
            "Added frontmatter validation with Zod schemas",
            "New validateFrontmatter option in fumadocs.config.ts allows defining Zod schemas for MDX frontmatter. Invalid documents now produce build-time errors with clear messages.",
            false, false),
        new("pl3", "Mar 21, 2026", "better-auth", "1.8.3", "1.9.0", "All frameworks",
            "Passkey authentication support added",
            "Added WebAuthn/passkey plugin for passwordless authentication. Supports credential creation, assertion, and device management. Requires secure context (HTTPS) in production.",
            false, false),
        new("pl4", "Mar 17, 2026", "tailwindcss", "4.0.8", "4.1.0", "PostCSS 8+",
            "New color-mix() function and container query improvements",
            "Adds native color-mix() support for dynamic color blending without JavaScript. Container queries now support named containers in utility classes. Performance improvement: 15% faster JIT compilation.",
            false, false),
        new("pl5", "Mar 13, 2026", "prisma", "6.3.0", "7.0.0", "Node.js >= 20, PostgreSQL >= 14",
            "Major release with typed SQL and edge runtime",
            "Introduces $queryRawTyped for fully type-safe raw SQL queries. Edge runtime support now GA. Breaking: deprecated findFirst in favor of findFirstOrThrow by default. Migration guide available.",
            true, true),
        new("pl6", "Mar 9, 2026", "framer-motion", "11.15.0", "11.16.0", "React >= 18",
            "Scroll-linked animations performance overhaul",
            "Rewrote scroll-linked animation engine to use native Scroll Timeline API where available. Falls back to IntersectionObserver-based polyfill. Reduces main thread usage by 40% on supported browsers.",
            false, false),
    ];

    private string? _expanded;

    private void Toggle(string id)
    {
        _expanded = _expanded == id ? null : id;
    }
}
