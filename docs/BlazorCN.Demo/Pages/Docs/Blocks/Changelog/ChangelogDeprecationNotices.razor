@* ============================================================
   Block: changelog-deprecation-notices
   Title: ChangelogDeprecationNotices
   Description: React deprecation notices changelog block for Next.js with sunset dates, replacement suggestions, countdown labels showing days remaining, and visual urgency indicators built with TypeScript, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-deprecation-notices.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="alert-octagon" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Deprecation Notices</h2>
            <span class="ml-auto text-xs text-muted-foreground">@_entries.Length active</span>
        </div>

        @if (_urgentCount > 0)
        {
            <div class="flex items-center gap-2 border-b bg-red-500/5 px-4 py-2">
                <span class="size-1.5 rounded-full bg-red-500"></span>
                <span class="text-xs font-medium text-red-600 dark:text-red-400">
                    @_urgentCount @(_urgentCount == 1 ? "deprecation" : "deprecations") within 30 days
                </span>
            </div>
        }

        <div>
            @foreach (var entry in _entries)
            {
                var urgency = GetUrgency(entry.DaysRemaining);
                var urgencyClass = $"inline-flex items-center rounded-md px-1.5 py-0.5 text-xs font-medium {urgency.Bg} {urgency.Text}";
                <div class="border-b px-4 py-3 last:border-b-0">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@urgencyClass">@urgency.Label</span>
                                <span class="text-xs text-muted-foreground">Sunset: @entry.SunsetDate</span>
                            </div>
                            <p class="mt-1.5 text-sm font-medium">@entry.Title</p>
                            <p class="mt-0.5 text-xs text-muted-foreground">@entry.Description</p>
                            <div class="mt-2 flex items-center gap-1.5">
                                <span class="font-mono text-xs text-muted-foreground">@entry.AffectedApi</span>
                                <LucideIconCn Name="arrow-right" Size="12" Class="size-3 text-muted-foreground/60" />
                                <span class="text-xs font-medium">@entry.Replacement</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record DeprecationEntry(
        string Id,
        string Title,
        string Description,
        string SunsetDate,
        int DaysRemaining,
        string Replacement,
        string AffectedApi,
        string AnnouncedDate
    );

    private record UrgencyInfo(string Label, string Bg, string Text, string Dot);

    private static readonly DeprecationEntry[] _entries =
    [
        new("d1", "REST API v1 endpoints",
            "All v1 REST endpoints will be removed. Clients must migrate to v2 which uses cursor-based pagination and consistent error formats.",
            "Apr 15, 2026", 18, "REST API v2 (/api/v2/*)", "/api/v1/*", "Jan 15, 2026"),
        new("d2", "Legacy webhook payload format",
            "The flat webhook payload structure will be replaced with a nested format including metadata, timestamps, and idempotency keys.",
            "Apr 30, 2026", 33, "Webhook v2 payload format", "Webhooks with X-Webhook-Version: 1", "Dec 1, 2025"),
        new("d3", "Basic authentication for API access",
            "Username and password authentication for API calls will be removed. All clients must use OAuth 2.0 bearer tokens or API keys.",
            "May 31, 2026", 64, "OAuth 2.0 or API key authentication", "Authorization: Basic header", "Nov 30, 2025"),
        new("d4", "XML response format",
            "The Accept: application/xml option will be removed from all endpoints. JSON is the only supported response format going forward.",
            "Jun 30, 2026", 94, "JSON response format (application/json)", "Accept: application/xml header", "Dec 30, 2025"),
        new("d5", "Legacy file upload endpoint",
            "The single-part /upload endpoint will be replaced with multipart upload supporting resumable transfers and server-side encryption.",
            "Aug 31, 2026", 156, "Multipart upload API (/api/v2/uploads)", "POST /api/v1/upload", "Feb 28, 2026"),
        new("d6", "Node.js SDK v3.x",
            "SDK v3.x will no longer receive updates or security patches. Version 4.x includes TypeScript-first APIs and tree-shaking support.",
            "Sep 30, 2026", 186, "Node.js SDK v4.x (@acme/sdk@^4.0.0)", "@acme/sdk@^3.0.0", "Mar 1, 2026"),
    ];

    private int _urgentCount => Array.FindAll(_entries, e => e.DaysRemaining <= 30).Length;

    private static UrgencyInfo GetUrgency(int days)
    {
        if (days <= 30)
            return new($"{days} days left", "bg-red-500/10", "text-red-600 dark:text-red-400", "bg-red-500");
        if (days <= 90)
            return new($"{days} days left", "bg-amber-500/10", "text-amber-600 dark:text-amber-400", "bg-amber-500");
        return new($"{days} days left", "bg-blue-500/10", "text-blue-600 dark:text-blue-400", "bg-blue-500");
    }
}
