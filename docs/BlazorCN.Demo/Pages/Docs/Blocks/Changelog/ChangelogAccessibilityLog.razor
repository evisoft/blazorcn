@* ============================================================
   Block: changelog-accessibility-log
   Title: ChangelogAccessibilityLog
   Description: React accessibility improvements changelog block for Next.js with WCAG compliance levels, affected components, and improvement descriptions built with TypeScript, Framer Motion stagger, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-accessibility-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="eye" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Accessibility Log</h2>
            <span class="text-xs text-muted-foreground">WCAG improvements</span>
        </div>
        <div class="divide-y">
            @foreach (var entry in _entries)
            {
                var levelStyle = LevelStyle(entry.WcagLevel);
                <div class="px-4 py-3 transition-colors hover:bg-muted/50">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@entry.Title</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("shrink-0 text-xs", levelStyle)">
                                    @entry.WcagLevel
                                </BadgeCn>
                            </div>
                            <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
                                @entry.Description
                            </p>
                        </div>
                        <div class="shrink-0 text-right">
                            <span class="font-mono text-xs text-muted-foreground">@entry.Criterion</span>
                            <p class="text-xs text-muted-foreground">@entry.Date</p>
                        </div>
                    </div>
                    <div class="mt-2 flex flex-wrap gap-1">
                        @foreach (var comp in entry.Components)
                        {
                            <span class="rounded bg-muted/50 px-1.5 py-0.5 font-mono text-xs text-muted-foreground">
                                @comp
                            </span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Entry(string Title, string Description, string WcagLevel, string Criterion, string[] Components, string Date);

    private static readonly Entry[] _entries =
    [
        new("Keyboard navigation for modal dialogs",
            "Focus trap implemented with correct tab order cycling. Escape key dismisses the dialog and restores focus to the trigger element.",
            "AA", "2.4.3", ["Dialog", "AlertDialog", "Sheet"], "Mar 28"),
        new("Color contrast on muted text",
            "Increased contrast ratio from 3.8:1 to 5.2:1 on all muted-foreground text across light and dark themes.",
            "AA", "1.4.3", ["Badge", "Label", "Tooltip"], "Mar 25"),
        new("Screen reader announcements for toasts",
            "Added aria-live polite region for toast notifications with role=status to announce non-critical updates.",
            "A", "4.1.3", ["Sonner", "Toast"], "Mar 22"),
        new("Reduced motion preference support",
            "All Framer Motion animations respect prefers-reduced-motion media query. Transitions disabled when user preference detected.",
            "AAA", "2.3.3", ["Carousel", "Accordion", "Collapsible"], "Mar 18"),
        new("Form error identification",
            "Inline error messages linked to inputs via aria-describedby with aria-invalid attribute set on erroneous fields.",
            "A", "3.3.1", ["Field", "Input", "Select"], "Mar 14"),
        new("Target size for interactive elements",
            "Minimum 44x44px touch target size enforced on all clickable elements including icon buttons and checkbox labels.",
            "AAA", "2.5.5", ["Button", "Checkbox", "Switch"], "Mar 10"),
    ];

    private static string LevelStyle(string wcagLevel) => wcagLevel switch
    {
        "A" => "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-0",
        "AA" => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-0",
        "AAA" => "bg-amber-500/10 text-amber-600 dark:text-amber-400 border-0",
        _ => ""
    };
}
