@* ============================================================
   Block: changelog-team-contributions
   Title: ChangelogTeamContributions
   Description: React team contributions changelog block for Next.js with changes grouped by team, member counts, and team-specific entries built with TypeScript, Framer Motion staggered animations, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-team-contributions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Changelog — Team Contributions</h2>
            <span class="ml-auto text-xs text-muted-foreground">@_totalChanges changes</span>
        </div>

        <div>
            @foreach (var team in _teams)
            {
                <div class="border-b last:border-b-0">
                    <div class="flex items-center gap-3 bg-muted/30 px-4 py-2.5">
                        <span class="text-sm font-medium">@team.Name</span>
                        <span class="text-xs text-muted-foreground">@team.MemberCount members</span>
                        <span class="ml-auto text-xs text-muted-foreground">
                            @team.Changes.Length @(team.Changes.Length == 1 ? "change" : "changes")
                        </span>
                    </div>
                    <div>
                        @foreach (var change in team.Changes)
                        {
                            <div class="flex items-start gap-3 border-t px-4 py-2.5">
                                <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground/40" />
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm">@change.Title</p>
                                    <div class="mt-0.5 flex items-center gap-2">
                                        <span class="text-xs text-muted-foreground">@change.Author</span>
                                        <span class="text-xs text-muted-foreground">·</span>
                                        <span class="text-xs text-muted-foreground">@change.Date</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Change(string Id, string Title, string Author, string Date);

    private record Team(string Name, int MemberCount, Change[] Changes);

    private static readonly Team[] _teams =
    [
        new("Frontend", 8,
        [
            new("f1", "Rebuilt settings page with tabbed layout and live preview",      "Sarah Chen",  "Mar 28"),
            new("f2", "Added keyboard navigation to data table component",              "Marcus Lee",  "Mar 27"),
            new("f3", "Fixed layout shift on dashboard chart widget resize",            "Sarah Chen",  "Mar 26"),
        ]),
        new("Backend", 6,
        [
            new("b1", "Migrated user service to event-driven architecture",             "Alex Rivera",  "Mar 28"),
            new("b2", "Added rate limiting to public API endpoints",                    "Jordan Park",  "Mar 27"),
            new("b3", "Optimized N+1 queries in project listing endpoint",              "Alex Rivera",  "Mar 25"),
        ]),
        new("Platform", 5,
        [
            new("p1", "Upgraded PostgreSQL from 15 to 16 across all clusters",         "Priya Sharma", "Mar 28"),
            new("p2", "Added automated failover for Redis sentinel nodes",              "Tom Nakamura", "Mar 26"),
        ]),
        new("DevOps", 4,
        [
            new("d1", "Reduced CI pipeline duration from 18 min to 7 min",             "Dana Kim",     "Mar 28"),
            new("d2", "Added canary deployment strategy for production releases",       "Chris Okonkwo","Mar 27"),
            new("d3", "Configured log aggregation with structured JSON output",         "Dana Kim",     "Mar 25"),
        ]),
    ];

    private static readonly int _totalChanges = _teams.Sum(t => t.Changes.Length);
}
