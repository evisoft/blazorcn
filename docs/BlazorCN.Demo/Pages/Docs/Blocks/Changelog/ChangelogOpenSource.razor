@* ============================================================
   Block: changelog-open-source
   Title: ChangelogOpenSource
   Description: React open source project changelog block for Next.js with license badges, GitHub-style stats for stars, forks, and contributors, and versioned release entries built with TypeScript, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-open-source.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header with license badge *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="code" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Project Changelog</h2>
            <span class="ml-auto rounded bg-muted/50 px-1.5 py-0.5 font-mono text-xs text-muted-foreground">
                @_projectStats.License
            </span>
        </div>

        @* GitHub-style stats *@
        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="star" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-mono text-xs text-muted-foreground">@_projectStats.Stars</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="git-fork" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-mono text-xs text-muted-foreground">@_projectStats.Forks</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-mono text-xs text-muted-foreground">@_projectStats.Contributors</span>
            </div>
        </div>

        @* Release list *@
        <div>
            @foreach (var rel in _releases)
            {
                var release = rel;
                <div class="border-b px-4 py-3 last:border-b-0">
                    <div class="flex items-center gap-2">
                        <span class="font-mono text-sm font-medium">v@release.Version</span>
                        <span class="text-xs text-muted-foreground">@release.Date</span>
                    </div>
                    <div class="mt-2 space-y-1">
                        @foreach (var change in release.Changes)
                        {
                            var typeColor = GetTypeColor(change.Type);
                            var typeLabel = GetTypeLabel(change.Type);
                            <div class="flex items-start gap-2">
                                <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", typeColor)"></span>
                                <span class="text-xs text-muted-foreground">
                                    <span class="font-medium text-foreground/70">@typeLabel:</span> @change.Text
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ProjectStats(string License, string Stars, string Forks, string Contributors);
    private record Change(string Type, string Text);
    private record Release(string Version, string Date, Change[] Changes);

    private static readonly ProjectStats _projectStats = new("MIT", "14.2k", "1.8k", "247");

    private static readonly Release[] _releases =
    [
        new("4.2.0", "Mar 28, 2026",
        [
            new("added",   "Plugin system with lifecycle hooks and typed configuration"),
            new("added",   "Tree-shaking support for ESM builds reducing bundle size by 40%"),
            new("changed", "Minimum Node.js version bumped to 20.x LTS"),
            new("fixed",   "Race condition in concurrent file watchers on Linux"),
        ]),
        new("4.1.3", "Mar 18, 2026",
        [
            new("fixed", "TypeScript declaration files missing for subpath exports"),
            new("fixed", "Memory leak in long-running watch mode processes"),
        ]),
        new("4.1.0", "Mar 8, 2026",
        [
            new("added",      "Streaming JSON parser for processing large configuration files"),
            new("changed",    "Default output directory changed from dist/ to build/"),
            new("deprecated", "Legacy callback API in favor of async/await pattern"),
            new("fixed",      "Glob patterns not matching dotfiles in nested directories"),
        ]),
        new("4.0.0", "Feb 24, 2026",
        [
            new("added",      "Complete TypeScript rewrite with full type inference"),
            new("added",      "Built-in caching layer with configurable TTL and invalidation"),
            new("changed",    "Configuration format migrated from JSON to YAML by default"),
            new("changed",    "CLI flags renamed to follow GNU conventions"),
            new("deprecated", "CommonJS entry point will be removed in v5.0"),
        ]),
    ];

    private static string GetTypeColor(string type) => type switch
    {
        "added"      => "bg-blue-500",
        "fixed"      => "bg-amber-500",
        "changed"    => "bg-purple-500",
        "deprecated" => "bg-red-500",
        _            => "bg-muted-foreground",
    };

    private static string GetTypeLabel(string type) => type switch
    {
        "added"      => "Added",
        "fixed"      => "Fixed",
        "changed"    => "Changed",
        "deprecated" => "Deprecated",
        _            => type,
    };
}
