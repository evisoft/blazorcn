@* ============================================================
   Block: changelog-ai-commit-analyzer
   Title: ChangelogAiCommitAnalyzer
   Description: A React AI commit analyzer changelog block for Next.js with impact scoring, risk assessment, categorized commit summaries, and change statistics built with shadcn/ui and Tailwind CSS
   Source: original/blocks/changelog/changelog-ai-commit-analyzer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="brain-circuit" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">AI Commit Analysis</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">
                v2.14.0
            </BadgeCn>
        </div>

        @* Summary *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex items-center gap-1.5">
                <span class="@Cn.Merge("size-1.5 rounded-full", GetRiskDot(_overallRisk))" />
                <span class="@Cn.Merge("font-medium text-xs", GetRiskText(_overallRisk))">
                    @GetRiskLabel(_overallRisk)
                </span>
            </div>
            <span class="text-muted-foreground/40">&middot;</span>
            <span class="text-muted-foreground text-xs">@_commits.Length commits analyzed</span>
            <span class="text-muted-foreground/40">&middot;</span>
            <span class="text-muted-foreground text-xs">@_totalFiles files</span>
            <span class="text-muted-foreground/40">&middot;</span>
            <span class="flex items-center gap-1 text-xs">
                <span class="text-emerald-600 dark:text-emerald-400">+@_totalAdditions</span>
                <span class="text-red-600 dark:text-red-400">-@_totalDeletions</span>
            </span>
        </div>

        @* Commits *@
        <div>
            @foreach (var commit in _commits)
            {
                var isExpanded = _expandedId == commit.Id;
                var chevronClass = Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
                var commitCapture = commit;
                <div class="border-b last:border-b-0">
                    <button
                        type="button"
                        @onclick="@(() => ToggleExpanded(commitCapture.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", GetRiskDot(commitCapture.RiskLevel))" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate font-medium text-sm">@commitCapture.Message</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                                <span class="font-mono">@commitCapture.Hash</span>
                                <span class="text-muted-foreground/40">&middot;</span>
                                <span>@commitCapture.Author</span>
                                <span class="text-muted-foreground/40">&middot;</span>
                                <span class="@Cn.Merge("font-medium", GetRiskText(commitCapture.RiskLevel))">
                                    Impact @commitCapture.ImpactScore/10
                                </span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-3 px-4 pb-4 pl-9">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                                        AI Summary
                                    </span>
                                    <p class="text-sm leading-relaxed">@commitCapture.Summary</p>
                                </div>
                                <div class="flex items-center gap-4 text-xs text-muted-foreground">
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px]">
                                        @commitCapture.Category
                                    </BadgeCn>
                                    <span class="flex items-center gap-1">
                                        <LucideIconCn Name="file" Size="12" Class="size-3" />
                                        @commitCapture.FilesChanged files
                                    </span>
                                    <span class="flex items-center gap-1 text-emerald-600 dark:text-emerald-400">
                                        <LucideIconCn Name="plus" Size="12" Class="size-3" />
                                        @commitCapture.Additions
                                    </span>
                                    <span class="flex items-center gap-1 text-red-600 dark:text-red-400">
                                        <LucideIconCn Name="minus" Size="12" Class="size-3" />
                                        @commitCapture.Deletions
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Analysis powered by LLM · Risk scores based on blast radius, complexity, and test
                coverage
            </p>
        </div>

    </div>
</section>

@code {
    private record CommitAnalysis(
        string Id,
        string Hash,
        string Message,
        string Author,
        int ImpactScore,
        string RiskLevel,
        string Category,
        int FilesChanged,
        int Additions,
        int Deletions,
        string Summary
    );

    private string? _expandedId;

    private void ToggleExpanded(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private static string GetRiskDot(string risk) => risk switch
    {
        "low"      => "bg-emerald-500",
        "medium"   => "bg-amber-500",
        "high"     => "bg-orange-500",
        "critical" => "bg-red-500",
        _          => "bg-gray-500",
    };

    private static string GetRiskLabel(string risk) => risk switch
    {
        "low"      => "Low risk",
        "medium"   => "Medium risk",
        "high"     => "High risk",
        "critical" => "Critical risk",
        _          => "Unknown risk",
    };

    private static string GetRiskText(string risk) => risk switch
    {
        "low"      => "text-emerald-600 dark:text-emerald-400",
        "medium"   => "text-amber-600 dark:text-amber-400",
        "high"     => "text-orange-600 dark:text-orange-400",
        "critical" => "text-red-600 dark:text-red-400",
        _          => "text-muted-foreground",
    };

    private const string _overallRisk = "high";

    private static readonly CommitAnalysis[] _commits =
    [
        new("c1", "a3f8c2d",
            "refactor: migrate auth middleware to edge runtime",
            "sarah-chen", 9, "critical", "Authentication", 14, 342, 289,
            "Moves the entire authentication middleware from Node.js to Edge Runtime. Affects all authenticated routes. Token validation, session handling, and RBAC checks are rewritten. Requires thorough regression testing across all protected endpoints."),
        new("c2", "b7e1f4a",
            "feat: add real-time presence indicators",
            "marcus-r", 6, "medium", "Feature", 8, 218, 12,
            "Introduces WebSocket-based presence tracking for collaborative editing. New connection manager handles reconnection with exponential backoff. Impact limited to collaboration features. No changes to existing data models."),
        new("c3", "c9d2e8b",
            "fix: resolve race condition in batch processor",
            "priya-s", 7, "high", "Bug fix", 3, 47, 31,
            "Fixes a race condition where concurrent batch jobs could process the same records twice. Adds distributed locking via Redis. Small changeset but affects data integrity in high-throughput scenarios."),
        new("c4", "d4a7b3c",
            "chore: update Tailwind CSS to v4.1",
            "alex-kim", 3, "low", "Dependencies", 6, 89, 72,
            "Bumps Tailwind CSS from v4.0 to v4.1. Automatic migration of deprecated utility classes. No breaking changes. Visual regression tests pass on all component previews."),
        new("c5", "e5f9a1d",
            "feat: add CSV export with streaming response",
            "elena-p", 4, "low", "Feature", 4, 156, 8,
            "Adds streaming CSV export for large datasets using ReadableStream. Memory-efficient approach replaces buffered export. Isolated to the export module with no side effects on existing functionality."),
    ];

    private static int _totalFiles => _commits.Sum(c => c.FilesChanged);
    private static int _totalAdditions => _commits.Sum(c => c.Additions);
    private static int _totalDeletions => _commits.Sum(c => c.Deletions);
}
