@* ============================================================
   Block: changelog-screenshot-gallery
   Title: ChangelogScreenshotGallery
   Description: React changelog block for Next.js with image placeholder grids showing visual diffs and UI screenshots alongside version notes for design-heavy release updates built with TypeScript, Framer Motion, shadcn/ui Badge, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-screenshot-gallery.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Visual Changelog</h2>
            <span class="ml-auto text-xs text-muted-foreground">@_entries.Length releases</span>
        </div>

        @foreach (var entry in _entries)
        {
            var isLast = entry == _entries[_entries.Length - 1];
            var entryClass = Cn.Merge("px-4 py-4", isLast ? "" : "border-b");
            var gridClass = entry.Screenshots.Length == 2 ? "mt-3 grid gap-2 grid-cols-2" : "mt-3 grid gap-2 grid-cols-3";
            <div class="@entryClass">
                <div class="mb-2 flex items-center gap-2">
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-mono text-xs">
                        <LucideIconCn Name="tag" Size="12" Class="size-3" />
                        @entry.Version
                    </BadgeCn>
                    <span class="text-xs text-muted-foreground">@entry.Date</span>
                </div>
                <h3 class="text-sm font-medium">@entry.Title</h3>
                <p class="mt-1 text-xs text-muted-foreground">@entry.Summary</p>
                <div class="@gridClass">
                    @foreach (var shot in entry.Screenshots)
                    {
                        <div class="space-y-1">
                            <div class="flex aspect-video items-center justify-center rounded-md bg-muted/50">
                                <LucideIconCn Name="image" Size="20" Class="size-5 text-muted-foreground/40" />
                            </div>
                            <p class="truncate text-center text-xs text-muted-foreground">@shot.Label</p>
                        </div>
                    }
                </div>
            </div>
        }

    </div>
</section>

@code {
    private record Screenshot(string Label);

    private record ChangelogEntry(string Version, string Date, string Title, string Summary, Screenshot[] Screenshots);

    private static readonly ChangelogEntry[] _entries =
    [
        new("v2.14.0", "Mar 24, 2026", "Redesigned Settings Panel",
            "Complete visual overhaul of the settings interface with improved navigation and grouped sections.",
            [
                new("Settings overview"),
                new("Account preferences"),
                new("Notification toggles"),
            ]),
        new("v2.13.0", "Mar 15, 2026", "New Dashboard Widgets",
            "Added three new widget types: activity heatmap, revenue sparkline, and team capacity gauge.",
            [
                new("Activity heatmap"),
                new("Revenue sparkline"),
            ]),
        new("v2.12.1", "Mar 8, 2026", "Table Improvements",
            "Sticky headers, column pinning, and improved row selection with keyboard navigation.",
            [
                new("Sticky header demo"),
                new("Column pinning"),
                new("Row selection"),
            ]),
    ];
}
