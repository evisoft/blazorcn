@* ============================================================
   Block: changelog-feature-flags
   Title: ChangelogFeatureFlags
   Description: A changelog block tracking feature flag toggle history with flag names, state transitions, rollout percentages, and target audience segments for controlled releases.
   Source: original/blocks/changelog/changelog-feature-flags.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="toggle-left" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Feature Flag History</h2>
            <span class="ml-auto text-xs text-muted-foreground">@_flagChanges.Length changes</span>
        </div>

        <div>
            @foreach (var fc in _flagChanges)
            {
                var entry = fc;
                var isExpanded = _expandedId == entry.Id;
                var isEnabled = entry.NewState == "enabled";
                var isLast = entry.Id == _flagChanges[^1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => SetExpanded(entry.Id, isExpanded))">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", isEnabled ? "bg-emerald-500" : "bg-red-500")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <code class="truncate font-mono text-sm font-medium">@entry.FlagName</code>
                            </div>
                            <div class="mt-0.5 flex items-center gap-1.5 text-xs text-muted-foreground">
                                <span class="@(entry.OldState == "enabled" ? "text-emerald-600 dark:text-emerald-400" : "text-red-500")">
                                    @(entry.OldState == "enabled" ? "Enabled" : "Disabled")
                                </span>
                                <LucideIconCn Name="arrow-right" Size="10" Class="size-2.5" />
                                <span class="@(isEnabled ? "text-emerald-600 dark:text-emerald-400" : "text-red-500")">
                                    @(isEnabled ? "Enabled" : "Disabled")
                                </span>
                                <span class="text-muted-foreground/40">&middot;</span>
                                <span>@entry.Date</span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-3 px-4 pb-4">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <p class="text-xs text-muted-foreground">@entry.Note</p>
                                </div>
                                <div class="space-y-2">
                                    <div class="flex items-center justify-between text-xs text-muted-foreground">
                                        <span>Rollout</span>
                                        <span class="font-mono">@entry.RolloutPercentage%</span>
                                    </div>
                                    <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                                        <div class="h-full rounded-full bg-foreground/20" style="@($"width:{entry.RolloutPercentage}%")"></div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3 text-xs text-muted-foreground">
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px]">@entry.Audience</BadgeCn>
                                    <span>by @entry.ChangedBy</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record FlagChange(string Id, string FlagName, string OldState, string NewState, int RolloutPercentage, string Audience, string ChangedBy, string Date, string Note);

    private static readonly FlagChange[] _flagChanges =
    [
        new("ff-1", "new_checkout_flow", "disabled", "enabled", 25, "Beta testers", "Sarah Chen", "Mar 27, 2026",
            "Initial rollout to beta cohort. Monitoring conversion rate delta before expanding."),
        new("ff-2", "ai_search_v2", "enabled", "disabled", 0, "All users", "Marcus Webb", "Mar 25, 2026",
            "Disabled due to elevated error rates in embedding service. Reverting to keyword search."),
        new("ff-3", "dark_mode_redesign", "enabled", "enabled", 75, "Pro subscribers", "Aiko Tanaka", "Mar 23, 2026",
            "Expanded from 50% to 75% after positive feedback. No increase in support tickets."),
        new("ff-4", "webhook_retry_v3", "disabled", "enabled", 100, "Enterprise tier", "Elena Popov", "Mar 20, 2026",
            "Full rollout to enterprise customers. Exponential backoff with jitter replaces fixed intervals."),
        new("ff-5", "csv_export_streaming", "enabled", "enabled", 50, "Internal dogfood", "James Liu", "Mar 18, 2026",
            "Increased from 10% to 50% for internal team. Memory usage reduced 60% vs buffered export."),
    ];

    private string? _expandedId;

    private void SetExpanded(string id, bool isExpanded)
    {
        _expandedId = isExpanded ? null : id;
    }
}
