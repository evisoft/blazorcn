@* ============================================================
   Block: changelog-automated-test-report
   Title: ChangelogAutomatedTestReport
   Description: Test suite results with pass/fail/skip counts and flaky test indicators for CI/CD pipelines, built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-automated-test-report.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Test Suite Results</h2>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="@($"text-xs {(_totalFailed == 0 ? "bg-emerald-500/10 text-emerald-500" : "bg-red-500/10 text-red-500")}")">
                @(_totalFailed == 0 ? "All Passed" : $"{_totalFailed} Failed")
            </BadgeCn>
        </div>

        @* Summary *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <p class="text-xs text-muted-foreground">Total Tests</p>
                    <p class="text-2xl font-semibold tabular-nums">@_totalTests</p>
                </div>
                <div>
                    <p class="text-xs text-muted-foreground">Pass Rate</p>
                    <p class="text-2xl font-semibold tabular-nums text-emerald-500">@_passRate%</p>
                </div>
            </div>

            <div class="mt-3 flex items-center gap-4 text-xs">
                <div class="flex items-center gap-1">
                    <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-500" />
                    <span class="text-muted-foreground">
                        Passed: <span class="font-medium tabular-nums">@_totalPassed</span>
                    </span>
                </div>
                @if (_totalFailed > 0)
                {
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="x-circle" Size="12" Class="size-3 text-red-500" />
                        <span class="text-muted-foreground">
                            Failed: <span class="font-medium tabular-nums">@_totalFailed</span>
                        </span>
                    </div>
                }
                @if (_totalSkipped > 0)
                {
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-muted-foreground">
                            Skipped: <span class="font-medium tabular-nums">@_totalSkipped</span>
                        </span>
                    </div>
                }
                @if (_totalFlaky > 0)
                {
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="alert-triangle" Size="12" Class="size-3 text-amber-500" />
                        <span class="text-muted-foreground">
                            Flaky: <span class="font-medium tabular-nums">@_totalFlaky</span>
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Test Suites *@
        <div class="divide-y">
            @foreach (var suite in _testSuites)
            {
                var suiteTotal = suite.Passed + suite.Failed + suite.Skipped;
                var suitePassRate = (suite.Passed + suite.Failed) > 0
                    ? ((double)suite.Passed / (suite.Passed + suite.Failed) * 100).ToString("F0")
                    : "100";
                var passedPct = suiteTotal > 0 ? (double)suite.Passed / suiteTotal * 100 : 0.0;
                var failedPct = suiteTotal > 0 ? (double)suite.Failed / suiteTotal * 100 : 0.0;
                var skippedPct = suiteTotal > 0 ? (double)suite.Skipped / suiteTotal * 100 : 0.0;
                var rateClass = suite.Failed == 0
                    ? "text-xs font-medium tabular-nums text-emerald-500"
                    : "text-xs font-medium tabular-nums text-red-500";

                <div class="px-4 py-3 transition-colors hover:bg-muted/50">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <h3 class="text-sm font-medium">@suite.Name</h3>
                                @if (suite.Flaky > 0)
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 bg-amber-500/10 text-xs text-amber-500">
                                        <LucideIconCn Name="alert-triangle" Size="12" Class="size-3" />
                                        @suite.Flaky flaky
                                    </BadgeCn>
                                }
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                @suiteTotal tests &bull; @suite.Duration
                            </p>

                            <div class="mt-2 flex items-center gap-3">
                                <div class="flex-1">
                                    <div class="flex h-2 overflow-hidden rounded-full bg-muted/50">
                                        <div class="bg-emerald-500" style="@(FormattableString.Invariant($"width:{passedPct:F1}%"))"></div>
                                        @if (suite.Failed > 0)
                                        {
                                            <div class="bg-red-500" style="@(FormattableString.Invariant($"width:{failedPct:F1}%"))"></div>
                                        }
                                        @if (suite.Skipped > 0)
                                        {
                                            <div class="bg-muted-foreground/30" style="@(FormattableString.Invariant($"width:{skippedPct:F1}%"))"></div>
                                        }
                                    </div>
                                </div>
                                <span class="@rateClass">
                                    @suitePassRate%
                                </span>
                            </div>

                            <div class="mt-2 flex items-center gap-3 text-xs text-muted-foreground">
                                <span class="flex items-center gap-1">
                                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                    @suite.Passed
                                </span>
                                @if (suite.Failed > 0)
                                {
                                    <span class="flex items-center gap-1">
                                        <span class="size-1.5 rounded-full bg-red-500"></span>
                                        @suite.Failed
                                    </span>
                                }
                                @if (suite.Skipped > 0)
                                {
                                    <span class="flex items-center gap-1">
                                        <span class="size-1.5 rounded-full bg-muted-foreground/30"></span>
                                        @suite.Skipped
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TestSuite(string Name, int Passed, int Failed, int Skipped, int Flaky, string Duration);

    private static readonly TestSuite[] _testSuites =
    [
        new("Unit Tests", 1247, 3, 12, 2, "2m 34s"),
        new("Integration Tests", 342, 1, 5, 1, "5m 12s"),
        new("E2E Tests", 89, 0, 3, 0, "8m 45s"),
        new("API Tests", 156, 2, 1, 1, "1m 58s"),
        new("Performance Tests", 24, 0, 0, 0, "12m 20s"),
    ];

    private int _totalPassed => _testSuites.Sum(s => s.Passed);
    private int _totalFailed => _testSuites.Sum(s => s.Failed);
    private int _totalSkipped => _testSuites.Sum(s => s.Skipped);
    private int _totalFlaky => _testSuites.Sum(s => s.Flaky);
    private int _totalTests => _totalPassed + _totalFailed + _totalSkipped;
    private string _passRate => (_totalPassed + _totalFailed) > 0
        ? ((double)_totalPassed / (_totalPassed + _totalFailed) * 100).ToString("F1")
        : "100.0";
}
