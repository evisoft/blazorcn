@* ============================================================
   Block: changelog-pagination
   Title: ChangelogPagination
   Description: React changelog block with pagination controls for Next.js, featuring Previous and Next buttons with page indicator and entry slicing built with TypeScript, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-pagination.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Changelog</h2>
            <span class="text-xs text-muted-foreground">@_allEntries.Length entries</span>
        </div>

        @* Entries for current page *@
        <div>
            @{
                var startIndex = (_page - 1) * ItemsPerPage;
                var visibleEntries = _allEntries.Skip(startIndex).Take(ItemsPerPage).ToArray();
            }
            @foreach (var entry in visibleEntries)
            {
                <div class="border-b px-4 py-3">
                    <div class="flex items-center gap-2">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", _typeColors[entry.Type])"></span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-[10px]">@entry.Version</BadgeCn>
                        <span class="text-xs text-muted-foreground">@entry.Date</span>
                    </div>
                    <p class="mt-1 text-sm font-medium">@entry.Title</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@entry.Description</p>
                </div>
            }
        </div>

        @* Pagination controls *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Sm"
                      Class="h-7 gap-1 px-2 text-xs"
                      OnClick="@(() => _page = Math.Max(1, _page - 1))"
                      Disabled="@(_page == 1)">
                <LucideIconCn Name="chevron-left" Size="12" Class="size-3" />
                Previous
            </ButtonCn>
            <span class="text-xs text-muted-foreground">Page @_page of @TotalPages</span>
            <ButtonCn Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Sm"
                      Class="h-7 gap-1 px-2 text-xs"
                      OnClick="@(() => _page = Math.Min(TotalPages, _page + 1))"
                      Disabled="@(_page == TotalPages)">
                Next
                <LucideIconCn Name="chevron-right" Size="12" Class="size-3" />
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private const int ItemsPerPage = 4;

    private int _page = 1;

    private int TotalPages => (int)Math.Ceiling((double)_allEntries.Length / ItemsPerPage);

    private record ChangelogEntry(string Id, string Version, string Date, string Title, string Description, string Type);

    private static readonly Dictionary<string, string> _typeColors = new()
    {
        ["feature"] = "bg-blue-500",
        ["fix"] = "bg-red-500",
        ["improvement"] = "bg-amber-500",
