@* ============================================================
   Block: changelog-canary-release
   Title: ChangelogCanaryRelease
   Description: A canary deployment progress tracker with traffic percentage controls, error rates, and rollback capabilities built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-canary-release.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="git-branch" Size="16" Class="size-4 text-muted-foreground" />
                    <h2 class="text-sm font-medium">Canary Deployment</h2>
                </div>
                <BadgeCn Variant="BadgeVariant.Outline" Class="@_statusBadgeClass">
                    @if (_isPaused)
                    {
                        <LucideIconCn Name="pause" Size="12" Class="size-3" />
                    }
                    else
                    {
                        <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                    }
                    @(_isPaused ? "Paused" : "In Progress")
                </BadgeCn>
            </div>
            <div class="mt-2 flex items-center gap-2 text-xs text-muted-foreground">
                <code class="rounded bg-muted px-1.5 py-0.5 font-mono">v2.4.0</code>
                <span>&rarr;</span>
                <code class="rounded bg-muted px-1.5 py-0.5 font-mono">v2.5.0</code>
                <span>&middot;</span>
                <span>Started 23 minutes ago</span>
            </div>
        </div>

        @* Traffic Distribution *@
        <div class="border-b px-4 py-4">
            <div class="mb-3 flex items-center justify-between">
                <label for="traffic-slider" class="text-sm font-medium">
                    Traffic Distribution
                </label>
                <div class="flex items-center gap-2 text-xs">
                    <span class="text-muted-foreground">Auto-increment:</span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2" @onclick="@(() => _isPaused = !_isPaused)">
                        @if (_isPaused)
                        {
                            <LucideIconCn Name="play" Size="12" Class="size-3" />
                            <span>Resume</span>
                        }
                        else
                        {
                            <LucideIconCn Name="pause" Size="12" Class="size-3" />
                            <span>Pause</span>
                        }
                    </ButtonCn>
                </div>
            </div>

            <div class="space-y-3">
                <input type="range" id="traffic-slider" min="0" max="100" step="5" value="@_canaryTraffic"
                       @oninput="@((e) => _canaryTraffic = int.Parse(e.Value?.ToString() ?? "15"))"
                       class="w-full" />

                <div class="grid grid-cols-2 gap-3">
                    <div class="rounded-md bg-blue-500/10 p-3">
                        <div class="flex items-center gap-2">
                            <span class="size-2 rounded-full bg-blue-500"></span>
                            <span class="text-xs text-muted-foreground">Canary</span>
                        </div>
                        <p class="mt-1 font-semibold tabular-nums text-2xl text-blue-500">
                            @_canaryTraffic%
                        </p>
                    </div>
                    <div class="rounded-md bg-muted/50 p-3">
                        <div class="flex items-center gap-2">
                            <span class="size-2 rounded-full bg-muted-foreground"></span>
                            <span class="text-xs text-muted-foreground">Stable</span>
                        </div>
                        <p class="mt-1 font-semibold tabular-nums text-2xl">@_stableTraffic%</p>
                    </div>
                </div>
            </div>
        </div>

        @* Metrics Comparison *@
        <div class="border-b px-4 py-3">
            <h3 class="mb-3 text-sm font-medium">Performance Metrics</h3>
            <div class="space-y-2">
                @foreach (var metric in _metrics)
                {
                    var canaryValClass = metric.IsBad ? "font-mono text-xs text-amber-500" : "font-mono text-xs";
                    var arrowClass = metric.IsBad ? "size-3 text-red-500" : "size-3 text-emerald-500";
                    <div class="flex items-center justify-between rounded-md bg-muted/30 px-3 py-2">
                        <span class="text-xs text-muted-foreground">@metric.Label</span>
                        <div class="flex items-center gap-4">
                            <div class="flex items-center gap-2">
                                <span class="size-1.5 rounded-full bg-blue-500"></span>
                                <span class="@canaryValClass">@metric.CanaryValue</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="size-1.5 rounded-full bg-muted-foreground"></span>
                                <span class="font-mono text-xs">@metric.StableValue</span>
                            </div>
                            @if (metric.Trend == "up")
                            {
                                <LucideIconCn Name="arrow-up" Size="12" Class="@arrowClass" />
                            }
                            @if (metric.Trend == "down")
                            {
                                <LucideIconCn Name="arrow-down" Size="12" Class="@arrowClass" />
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Warning & Actions *@
        <div class="px-4 py-3">
            <div class="mb-3 flex items-start gap-2 rounded-md bg-amber-500/10 p-3">
                <LucideIconCn Name="alert-triangle" Size="16" Class="mt-0.5 size-4 shrink-0 text-amber-500" />
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium text-amber-500">Slightly Elevated Error Rate</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Canary error rate is 33% higher than stable. Monitor closely or consider rollback.
                    </p>
                </div>
            </div>

            <div class="flex gap-2">
                @if (!_showRollbackConfirm)
                {
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" @onclick="@(() => _showRollbackConfirm = true)">
                        <LucideIconCn Name="rotate-ccw" Size="12" Class="size-3" />
                        Rollback
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="@(() => _canaryTraffic = 100)">
                        Promote to 100%
                    </ButtonCn>
                }
                else
                {
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 border-red-500/20 bg-red-500/10 text-red-500 text-xs hover:bg-red-500/20" @onclick="ConfirmRollback">
                        <LucideIconCn Name="rotate-ccw" Size="12" Class="size-3" />
                        Confirm Rollback
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="@(() => _showRollbackConfirm = false)">
                        Cancel
                    </ButtonCn>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Metric(string Label, string CanaryValue, string StableValue, string Trend, bool IsBad = false);

    private static readonly Metric[] _metrics =
    [
        new("Error Rate", "0.12%", "0.09%", "up", true),
        new("Avg Latency", "142ms", "138ms", "up", true),
        new("Success Rate", "99.88%", "99.91%", "down", true),
        new("Requests/min", "3,247", "12,653", "neutral"),
    ];

    private int _canaryTraffic = 15;
    private bool _isPaused = false;
    private bool _showRollbackConfirm = false;

    private int _stableTraffic => 100 - _canaryTraffic;

    private string _statusBadgeClass => _isPaused
        ? "gap-1 text-xs border-amber-500/20 bg-amber-500/10 text-amber-500"
        : "gap-1 text-xs border-emerald-500/20 bg-emerald-500/10 text-emerald-500";

    private void ConfirmRollback()
    {
        _canaryTraffic = 0;
        _showRollbackConfirm = false;
    }
}
