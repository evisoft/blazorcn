@* ============================================================
   Block: changelog-bookmark-saves
   Title: ChangelogBookmarkSaves
   Description: React bookmarkable changelog block for Next.js with save/unsave toggles, bookmark counts, saved entries filter, and persistent selection indicators built with shadcn/ui, Tailwind CSS, and Framer Motion animations.
   Source: original/blocks/changelog/changelog-bookmark-saves.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="list" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Changelog</span>
            <span class="ml-auto flex items-center gap-2">
                @if (_saved.Count > 0)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-[10px]">@_saved.Count saved</BadgeCn>
                }
                <ButtonCn Variant="@(_showSavedOnly ? ButtonVariant.Default : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm"
                          Class="@(Cn.Merge("h-7 gap-1 px-2 text-xs", _showSavedOnly ? "bg-foreground text-background hover:bg-foreground/90" : ""))"
                          OnClick="@(() => _showSavedOnly = !_showSavedOnly)">
                    <LucideIconCn Name="filter" Size="12" Class="size-3" />
                    @(_showSavedOnly ? "Saved" : "All")
                </ButtonCn>
            </span>
        </div>

        @* Entries *@
        <div>
            @if (!VisibleEntries.Any())
            {
                <div class="px-4 py-8 text-center">
                    <LucideIconCn Name="bookmark" Size="20" Class="mx-auto size-5 text-muted-foreground/40" />
                    <p class="mt-2 text-sm text-muted-foreground">No saved entries yet</p>
                    <p class="mt-0.5 text-xs text-muted-foreground/60">Bookmark entries to find them here</p>
                </div>
            }
            else
            {
                foreach (var entry in VisibleEntries)
                {
                    var isSaved = _saved.Contains(entry.Id);
                    var config = _typeConfig[entry.Type];
                    var entryId = entry.Id;
                    <div class="border-b last:border-b-0">
                        <div class="flex items-start gap-3 px-4 py-3">
                            <span class="@(Cn.Merge("mt-1.5 size-2 shrink-0 rounded-full", config.Dot))"></span>
                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-sm">@entry.Title</span>
                                <p class="mt-0.5 text-xs text-muted-foreground leading-relaxed">@entry.Description</p>
                                <div class="mt-1.5 flex items-center gap-1.5 text-xs text-muted-foreground">
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-[10px]">v@(entry.Version)</BadgeCn>
                                    <span class="text-muted-foreground/40">&middot;</span>
                                    <span>@config.Label</span>
                                    <span class="text-muted-foreground/40">&middot;</span>
                                    <span>@entry.Date</span>
                                </div>
                            </div>

                            @* Bookmark button *@
                            <button type="button"
                                    @onclick="@(() => ToggleBookmark(entryId))"
                                    class="@(Cn.Merge("group/bk mt-0.5 flex shrink-0 items-center gap-1 rounded-md px-1.5 py-1 text-xs transition-colors", isSaved ? "text-foreground" : "text-muted-foreground/50 hover:text-muted-foreground"))"
                                    aria-label="@(isSaved ? "Remove bookmark" : "Bookmark entry")"
                                    aria-pressed="@(isSaved ? "true" : "false")">
                                @if (isSaved)
                                {
                                    <LucideIconCn Name="bookmark-check" Size="16" Class="size-4 fill-current" />
                                }
                                else
                                {
                                    <LucideIconCn Name="bookmark" Size="16" Class="size-4 transition-transform group-hover/bk:scale-110" />
                                }
                                <span class="tabular-nums text-[10px]">@entry.SaveCount</span>
                            </button>
                        </div>
                    </div>
                }
            }
        </div>

    </div>
</section>

@code {
    private class ChangelogEntry
    {
        public string Id { get; set; } = "";
        public string Version { get; set; } = "";
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Type { get; set; } = "";
        public string Date { get; set; } = "";
        public int SaveCount { get; set; }
    }

    private record TypeConfig(string Label, string Dot);

    private readonly List<ChangelogEntry> _entries =
    [
        new() { Id = "bk-1", Version = "5.4.0", Title = "GraphQL subscriptions for real-time data", Description = "Subscribe to record changes, user presence, and notification events over WebSocket. Automatic reconnection with exponential backoff.", Type = "feature", Date = "Mar 30, 2026", SaveCount = 87 },
        new() { Id = "bk-2", Version = "5.3.2", Title = "Fixed memory leak in long-running dashboard sessions", Description = "Resolved a memory leak caused by stale event listeners on chart components. Sessions over 4 hours no longer degrade performance.", Type = "fix", Date = "Mar 27, 2026", SaveCount = 34 },
        new() { Id = "bk-3", Version = "5.3.1", Title = "50% faster table rendering with virtualized rows", Description = "Tables with over 10,000 rows now render in under 100ms using windowed virtualization. Smooth scrolling maintained at 60fps.", Type = "improvement", Date = "Mar 24, 2026", SaveCount = 62 },
        new() { Id = "bk-4", Version = "5.3.0", Title = "New row-level security policies for shared workspaces", Description = "Define which rows each team member can view, edit, or delete based on field values and role assignments. Enforced at the database layer.", Type = "feature", Date = "Mar 21, 2026", SaveCount = 45 },
        new() { Id = "bk-5", Version = "5.2.4", Title = "Deprecating legacy REST API v1 endpoints", Description = "REST API v1 will be removed on June 30, 2026. Migrate to v2 for improved pagination, filtering, and field selection. Migration guide available in docs.", Type = "deprecation", Date = "Mar 18, 2026", SaveCount = 118 },
        new() { Id = "bk-6", Version = "5.2.3", Title = "Improved search relevance with BM25 ranking", Description = "Full-text search results now ranked with BM25 algorithm. Supports phrase matching, fuzzy tolerance, and field-weight boosting for more accurate results.", Type = "improvement", Date = "Mar 15, 2026", SaveCount = 29 },
        new() { Id = "bk-7", Version = "5.2.2", Title = "Fixed SSO login redirect for custom domain workspaces", Description = "SAML SSO redirects now correctly resolve the workspace from the custom domain. Previously required users to enter their workspace slug manually.", Type = "fix", Date = "Mar 12, 2026", SaveCount = 16 },
    ];

    private readonly HashSet<string> _saved = ["bk-5"];
    private bool _showSavedOnly;

    private static readonly Dictionary<string, TypeConfig> _typeConfig = new()
    {
        ["feature"]     = new("Feature",    "bg-emerald-500"),
        ["fix"]         = new("Fix",         "bg-amber-500"),
        ["improvement"] = new("Improvement", "bg-blue-500"),
        ["deprecation"] = new("Deprecation", "bg-red-500"),
    };

    private IEnumerable<ChangelogEntry> VisibleEntries =>
        _showSavedOnly ? _entries.Where(e => _saved.Contains(e.Id)) : _entries;

    private void ToggleBookmark(string id)
    {
        var wasSaved = _saved.Contains(id);
        if (wasSaved)
            _saved.Remove(id);
        else
            _saved.Add(id);

        var entry = _entries.FirstOrDefault(e => e.Id == id);
        if (entry is not null)
            entry.SaveCount += wasSaved ? -1 : 1;
    }
}
