@* ============================================================
   Block: changelog-rollback-wizard
   Title: ChangelogRollbackWizard
   Description: A step-by-step rollback interface for reverting to previous versions with confirmation and impact assessment using React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-rollback-wizard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="history" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Rollback Wizard</h2>
                <BadgeCn Variant="BadgeVariant.Outline" Class="ml-auto text-xs">
                    Step @(_step == "select" ? "1" : _step == "review" ? "2" : "3") of 3
                </BadgeCn>
            </div>
        </div>

        @if (_step == "select")
        {
            <div>
                <div class="border-b px-4 py-3">
                    <p class="text-sm text-muted-foreground">
                        Select a previous version to rollback to
                    </p>
                </div>

                <div class="max-h-96 overflow-y-auto">
                    @foreach (var version in _versions)
                    {
                        var ver = version;
                        var isCurrent = ver.Status == "current";
                        var isSelected = _selectedVersion?.Id == ver.Id;
                        var btnClass = Cn.Merge(
                            "flex w-full items-center gap-3 border-b px-4 py-3 text-left transition-colors last:border-b-0",
                            isCurrent ? "cursor-not-allowed opacity-50" : "hover:bg-muted/50",
                            isSelected ? "bg-muted" : ""
                        );
                        var radioDotClass = Cn.Merge(
                            "size-4 shrink-0 rounded-full border-2",
                            isSelected ? "border-primary bg-primary" : "border-muted-foreground/30"
                        );
                        <button
                            type="button"
                            class="@btnClass"
                            disabled="@(isCurrent ? "disabled" : null)"
                            @onclick="@(() => SelectVersion(ver))">
                            <div class="@radioDotClass"></div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@ver.Version</span>
                                    @if (ver.Status == "current")
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 px-1.5 text-xs">
                                            Current
                                        </BadgeCn>
                                    }
                                </div>
                                <p class="mt-0.5 text-xs text-muted-foreground">
                                    Deployed @ver.DeployedAt • @ver.Changes changes
                                </p>
                            </div>
                            <div class="shrink-0 text-xs text-muted-foreground">
                                @ver.Uptime uptime
                            </div>
                        </button>
                    }
                </div>

                <div class="border-t px-4 py-3">
                    <ButtonCn Class="w-full" Disabled="@(_selectedVersion == null)" @onclick="@(() => SetStep("review"))">
                        Continue to review
                        <LucideIconCn Name="chevron-right" Size="16" Class="ml-1.5 size-4" />
                    </ButtonCn>
                </div>
            </div>
        }

        @if (_step == "review" && _selectedVersion != null)
        {
            <div>
                <div class="border-b bg-muted/50 px-4 py-3">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="alert-triangle" Size="16" Class="size-4 text-amber-500" />
                        <span class="text-sm font-medium">Impact Assessment</span>
                    </div>
                </div>

                <div class="space-y-px">
                    @foreach (var item in _impactItems)
                    {
                        var severityDotClass = Cn.Merge(
                            "size-1.5 rounded-full",
                            item.Severity == "high" ? "bg-red-500" : item.Severity == "medium" ? "bg-amber-500" : "bg-blue-500"
                        );
                        <div class="flex items-center justify-between border-b px-4 py-3 last:border-b-0">
                            <div class="flex items-center gap-2">
                                <span class="@severityDotClass"></span>
                                <span class="text-sm">@item.Label</span>
                            </div>
                            <span class="font-mono text-xs text-muted-foreground">@item.Value</span>
                        </div>
                    }
                </div>

                <div class="border-t px-4 py-3">
                    <div class="flex gap-2">
                        <ButtonCn Variant="ButtonVariant.Outline" Class="gap-1.5" @onclick="@(() => SetStep("select"))">
                            <LucideIconCn Name="arrow-left" Size="16" Class="size-4" />
                            Back
                        </ButtonCn>
                        <ButtonCn Class="flex-1" @onclick="@(() => SetStep("confirm"))">
                            Review and confirm
                            <LucideIconCn Name="chevron-right" Size="16" Class="ml-1.5 size-4" />
                        </ButtonCn>
                    </div>
                </div>
            </div>
        }

        @if (_step == "confirm" && _selectedVersion != null)
        {
            var sv = _selectedVersion;
            <div>
                <div class="border-b bg-red-500/10 px-4 py-3">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="alert-triangle" Size="16" Class="size-4 text-red-500" />
                        <span class="text-sm font-medium text-red-500">Confirm Rollback</span>
                    </div>
                </div>

                <div class="px-4 py-4">
                    <div class="space-y-4">
                        <div>
                            <p class="text-sm">
                                You are about to rollback from <span class="font-medium">v3.2.1</span> to
                                <span class="font-medium">@sv.Version</span>
                            </p>
                            <p class="mt-2 text-sm text-muted-foreground">
                                This action will affect active users and require database rollbacks. Make sure
                                you understand the impact.
                            </p>
                        </div>

                        <div>
                            <label for="confirmation" class="mb-2 block text-sm font-medium">
                                Type <span class="font-mono text-red-500">@sv.Version</span>
                                to confirm
                            </label>
                            <input
                                id="confirmation"
                                type="text"
                                value="@_confirmationText"
                                @oninput="@((e) => _confirmationText = e.Value?.ToString() ?? "")"
                                placeholder="@sv.Version"
                                class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" />
                        </div>
                    </div>
                </div>

                <div class="border-t px-4 py-3">
                    <div class="flex gap-2">
                        <ButtonCn Variant="ButtonVariant.Outline" Class="gap-1.5" @onclick="@(() => SetStep("review"))">
                            <LucideIconCn Name="arrow-left" Size="16" Class="size-4" />
                            Back
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Destructive" Class="flex-1 gap-1.5" Disabled="@(!_isConfirmed)">
                            <LucideIconCn Name="check-circle-2" Size="16" Class="size-4" />
                            Execute rollback
                        </ButtonCn>
                    </div>
                </div>
            </div>
        }

    </div>
</section>

@code {
    private record VersionItem(string Id, string Version, string DeployedAt, string Status, string Uptime, int Changes);
    private record ImpactItem(string Label, string Value, string Severity);

    private string _step = "select";
    private VersionItem? _selectedVersion;
    private string _confirmationText = "";

    private bool _isConfirmed =>
        !string.IsNullOrEmpty(_confirmationText) &&
        _selectedVersion != null &&
        _confirmationText.ToLowerInvariant() == _selectedVersion.Version.ToLowerInvariant();

    private void SetStep(string step) => _step = step;

    private void SelectVersion(VersionItem version)
    {
        if (version.Status == "current") return;
        _selectedVersion = version;
    }

    private static readonly VersionItem[] _versions =
    [
        new("1", "v3.2.1", "2026-03-30 14:00", "current", "2 hours",   8),
        new("2", "v3.2.0", "2026-03-28 10:00", "stable",  "48 hours",  15),
        new("3", "v3.1.5", "2026-03-25 16:00", "stable",  "120 hours", 5),
        new("4", "v3.1.4", "2026-03-22 12:00", "stable",  "192 hours", 12),
    ];

    private static readonly ImpactItem[] _impactItems =
    [
        new("Active sessions",      "~1,234 users",           "high"),
        new("Database migrations",  "2 rollbacks required",   "medium"),
        new("Cache invalidation",   "All caches cleared",     "low"),
        new("Estimated downtime",   "< 30 seconds",           "medium"),
    ];
}
