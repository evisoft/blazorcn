@* ============================================================
   Block: changelog-export-pdf
   Title: ChangelogExportPdf
   Description: React export-to-PDF changelog block for Next.js with document preview pane, version selector, and download action built with TypeScript, shadcn/ui Button and Badge, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-export-pdf.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Export Changelog</span>
            <span class="text-muted-foreground text-xs">PDF preview</span>
        </div>

        @* Toolbar *@
        <div class="flex flex-wrap items-center gap-2 border-b px-4 py-2.5">
            <span class="text-muted-foreground text-xs">From</span>
            <div class="relative">
                <button type="button"
                        class="flex h-7 items-center gap-1 rounded-md border bg-transparent px-2 font-mono text-xs transition-colors hover:bg-muted/50"
                        @onclick="ToggleFromDropdown">
                    v@_fromVersion
                    <LucideIconCn Name="chevron-down" Size="12" Class="size-3 text-muted-foreground" />
                </button>
                @if (_showFromDropdown)
                {
                    <div class="absolute top-full left-0 z-10 mt-1 overflow-hidden rounded-md border bg-card shadow-md">
                        @foreach (var v in _versionOptions)
                        {
                            var ver = v;
                            var fromClass = ver == _fromVersion
                                ? "block w-full px-3 py-1.5 text-left font-mono text-xs transition-colors hover:bg-muted/50 bg-muted"
                                : "block w-full px-3 py-1.5 text-left font-mono text-xs transition-colors hover:bg-muted/50";
                            <button type="button"
                                    class="@fromClass"
                                    @onclick="@(() => SelectFromVersion(ver))">
                                v@ver
                            </button>
                        }
                    </div>
                }
            </div>
            <span class="text-muted-foreground text-xs">to</span>
            <div class="relative">
                <button type="button"
                        class="flex h-7 items-center gap-1 rounded-md border bg-transparent px-2 font-mono text-xs transition-colors hover:bg-muted/50"
                        @onclick="ToggleToDropdown">
                    v@_toVersion
                    <LucideIconCn Name="chevron-down" Size="12" Class="size-3 text-muted-foreground" />
                </button>
                @if (_showToDropdown)
                {
                    <div class="absolute top-full left-0 z-10 mt-1 overflow-hidden rounded-md border bg-card shadow-md">
                        @foreach (var v in _versionOptions)
                        {
                            var ver = v;
                            var toClass = ver == _toVersion
                                ? "block w-full px-3 py-1.5 text-left font-mono text-xs transition-colors hover:bg-muted/50 bg-muted"
                                : "block w-full px-3 py-1.5 text-left font-mono text-xs transition-colors hover:bg-muted/50";
                            <button type="button"
                                    class="@toClass"
                                    @onclick="@(() => SelectToVersion(ver))">
                                v@ver
                            </button>
                        }
                    </div>
                }
            </div>

            <div class="ml-auto flex items-center gap-1.5">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                          Class="h-7 gap-1 px-2 text-xs"
                          @onclick="HandleCopy">
                    @if (_copied)
                    {
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                        <span>Copied</span>
                    }
                    else
                    {
                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                        <span>Copy</span>
                    }
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                    <LucideIconCn Name="download" Size="12" Class="size-3" />
                    Export PDF
                </ButtonCn>
            </div>
        </div>

        @* Document preview *@
        <div class="px-4 py-3">
            <div class="rounded-md border bg-background p-4">
                <div class="mb-3 text-center">
                    <p class="font-medium text-sm">Release Notes</p>
                    <p class="text-muted-foreground text-xs">
                        v@_fromVersion through v@_toVersion
                    </p>
                </div>

                @for (var rIdx = 0; rIdx < FilteredReleases.Length; rIdx++)
                {
                    var release = FilteredReleases[rIdx];
                    var releaseClass = rIdx < FilteredReleases.Length - 1 ? "mb-3 border-b pb-3" : "";
                    <div class="@releaseClass">
                        <div class="mb-1.5 flex items-center gap-2">
                            <span class="font-mono font-medium text-sm">v@release.Version</span>
                            <span class="text-muted-foreground text-xs">@release.Date</span>
                        </div>
                        <div class="space-y-1">
                            @foreach (var entry in release.Entries)
                            {
                                <div class="flex items-start gap-2">
                                    <span class="@($"mt-1.5 size-1.5 shrink-0 rounded-full {_dotColors[entry.Category]}")"
                                          aria-hidden="true"></span>
                                    <div class="flex items-baseline gap-1.5">
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="px-1 py-0 font-normal text-[10px]">
                                            @_categoryLabels[entry.Category]
                                        </BadgeCn>
                                        <span class="text-xs">@entry.Title</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @TotalEntries entries across @FilteredReleases.Length releases
            </span>
            <span class="text-muted-foreground text-xs">
                ~@EstimatedPages @(EstimatedPages == 1 ? "page" : "pages") PDF
            </span>
        </div>

    </div>
</section>

@code {
    private record ReleaseEntry(string Title, string Category);
    private record Release(string Version, string Date, ReleaseEntry[] Entries);

    private static readonly Dictionary<string, string> _categoryLabels = new()
    {
        ["feature"]     = "Added",
        ["fix"]         = "Fixed",
        ["improvement"] = "Improved",
    };

    private static readonly Dictionary<string, string> _dotColors = new()
    {
        ["feature"]     = "bg-emerald-500",
        ["fix"]         = "bg-red-500",
        ["improvement"] = "bg-blue-500",
    };

    private static readonly Release[] _releases =
    [
        new("2.8.0", "March 30, 2026",
        [
            new("Team workspace sharing with role-based access", "feature"),
            new("Real-time collaborative cursors in editor", "feature"),
            new("Dashboard streaming SSR reducing load by 40%", "improvement"),
            new("OAuth redirect loop on SAML providers", "fix"),
        ]),
        new("2.7.2", "March 24, 2026",
        [
            new("API key scoping with granular permissions", "feature"),
            new("Sidebar collapse state persisting across sessions", "fix"),
            new("Full-text search indexing reduced to under 2 seconds", "improvement"),
        ]),
        new("2.7.1", "March 18, 2026",
        [
            new("Custom theme editor with HSL color pickers", "feature"),
            new("Timezone offset calculation for UTC-negative regions", "fix"),
            new("Client bundle size reduced by 18%", "improvement"),
        ]),
        new("2.7.0", "March 12, 2026",
        [
            new("Webhook event filtering by resource and action type", "feature"),
            new("Edge function cold start reduced from 120ms to 45ms", "improvement"),
            new("CSV export encoding for non-ASCII characters", "fix"),
            new("Audit log export with date range filtering", "feature"),
        ]),
    ];

    private static readonly string[] _versionOptions = _releases.Select(r => r.Version).ToArray();

    private string _fromVersion = _releases[^1].Version;
    private string _toVersion = _releases[0].Version;
    private bool _copied;
    private bool _showFromDropdown;
    private bool _showToDropdown;

    private Release[] FilteredReleases
    {
        get
        {
            var fromIdx = Array.IndexOf(_versionOptions, _fromVersion);
            var toIdx = Array.IndexOf(_versionOptions, _toVersion);
            return _releases.Where((_, i) => i >= toIdx && i <= fromIdx).ToArray();
        }
    }

    private int TotalEntries => FilteredReleases.Sum(r => r.Entries.Length);

    private int EstimatedPages => Math.Max(1, (int)Math.Ceiling(TotalEntries / 8.0));

    private void ToggleFromDropdown()
    {
        _showFromDropdown = !_showFromDropdown;
        _showToDropdown = false;
    }

    private void ToggleToDropdown()
    {
        _showToDropdown = !_showToDropdown;
        _showFromDropdown = false;
    }

    private void SelectFromVersion(string ver)
    {
        _fromVersion = ver;
        _showFromDropdown = false;
    }

    private void SelectToVersion(string ver)
    {
        _toVersion = ver;
        _showToDropdown = false;
    }

    private async Task HandleCopy()
    {
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
        StateHasChanged();
    }
}
