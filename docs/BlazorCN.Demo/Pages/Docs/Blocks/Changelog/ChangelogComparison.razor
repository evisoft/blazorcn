@* ============================================================
   Block: changelog-comparison
   Title: ChangelogComparison
   Description: A side-by-side version comparison changelog block built with React, Next.js, shadcn/ui, and Tailwind CSS for visualizing differences between releases
   Source: original/blocks/changelog/changelog-comparison.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="arrow-left-right" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Version Comparison</h2>
            <span class="text-xs text-muted-foreground">
                @_versions[0].VersionNumber → @_versions[1].VersionNumber
            </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2">

            @* Left column *@
            <div class="border-r">
                <div class="border-b px-4 py-3">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@_versions[0].VersionNumber</BadgeCn>
                        </div>
                        <span class="text-xs text-muted-foreground">@_versions[0].Date</span>
                    </div>
                </div>
                <div>
                    @foreach (var change in _versions[0].Changes)
                    {
                        var cfg = GetTypeConfig(change.Type);
                        var dotClass = Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", cfg.Color);
                        <div class="border-b px-4 py-3 last:border-b-0">
                            <div class="flex items-start gap-2">
                                <span class="@dotClass"></span>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@change.Title</span>
                                        <span class="text-[10px] text-muted-foreground">@cfg.Label</span>
                                    </div>
                                    <p class="mt-0.5 text-xs text-muted-foreground leading-relaxed">@change.Description</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* Right column *@
            <div>
                <div class="border-b px-4 py-3">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@_versions[1].VersionNumber</BadgeCn>
                            <span class="rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-medium text-emerald-600">Latest</span>
                        </div>
                        <span class="text-xs text-muted-foreground">@_versions[1].Date</span>
                    </div>
                </div>
                <div>
                    @foreach (var change in _versions[1].Changes)
                    {
                        var cfg = GetTypeConfig(change.Type);
                        var dotClass = Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", cfg.Color);
                        <div class="border-b px-4 py-3 last:border-b-0">
                            <div class="flex items-start gap-2">
                                <span class="@dotClass"></span>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@change.Title</span>
                                        <span class="text-[10px] text-muted-foreground">@cfg.Label</span>
                                    </div>
                                    <p class="mt-0.5 text-xs text-muted-foreground leading-relaxed">@change.Description</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>

        <div class="flex items-center justify-between border-t bg-muted/30 px-4 py-2.5">
            <div class="flex items-center gap-4">
                @foreach (var type in _legendTypes)
                {
                    var cfg = GetTypeConfig(type);
                    var dotClass = Cn.Merge("size-1.5 rounded-full", cfg.Color);
                    <div class="flex items-center gap-1.5">
                        <span class="@dotClass"></span>
                        <span class="text-[10px] text-muted-foreground">@cfg.Label</span>
                    </div>
                }
            </div>
            <span class="text-[10px] text-muted-foreground">
                @_versions[1].Changes.Length changes in @_versions[1].VersionNumber
            </span>
        </div>

    </div>
</section>

@code {
    private record ChangeItem(string Id, string Title, string Description, string Type);
    private record VersionData(string VersionNumber, string Date, ChangeItem[] Changes);
    private record TypeConfig(string Color, string Label);

    private static TypeConfig GetTypeConfig(string type) => type switch
    {
        "added"   => new("bg-emerald-500", "Added"),
        "changed" => new("bg-blue-500",    "Changed"),
        "removed" => new("bg-red-500",     "Removed"),
        _         => new("bg-gray-500",    type),
    };

    private static readonly string[] _legendTypes = ["added", "changed", "removed"];

    private static readonly VersionData[] _versions =
    [
        new(
            "v2.3",
            "Feb 14, 2026",
            [
                new("a1", "Basic auth middleware",  "Session-based authentication with JWT tokens and 24-hour expiry.",          "added"),
                new("a2", "PostgreSQL adapter",     "Direct PostgreSQL queries with manual connection management.",               "added"),
                new("a3", "REST API endpoints",     "Standard REST endpoints with JSON request/response format.",                 "added"),
                new("a4", "Static CSS themes",      "Three built-in themes: light, dark, and system preference.",                "added"),
                new("a5", "Console logging",        "Basic console.log output for debugging and error tracking.",                 "added"),
                new("a6", "Manual deployments",     "CLI-based deployment script with manual environment config.",                "added"),
            ]
        ),
        new(
            "v2.4",
            "Mar 28, 2026",
            [
                new("b1", "OAuth 2.1 + RBAC",       "Full OAuth 2.1 with role-based access control and team permissions.",                    "changed"),
                new("b2", "Connection pooling",      "Automatic pool sizing with PgBouncer integration and query batching.",                   "changed"),
                new("b3", "GraphQL + REST",          "Added GraphQL layer alongside REST with automatic schema generation.",                    "added"),
                new("b4", "Dynamic theme engine",    "Runtime theme switching with CSS variables and 63 color presets.",                       "changed"),
                new("b5", "Structured logging",      "JSON-structured logs with log levels, trace IDs, and external sink support.",            "changed"),
                new("b6", "Console logging",         "Replaced by structured logging pipeline with better observability.",                     "removed"),
            ]
        ),
    ];
}
