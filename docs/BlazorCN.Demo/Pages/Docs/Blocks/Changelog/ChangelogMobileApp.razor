@* ============================================================
   Block: changelog-mobile-app
   Title: ChangelogMobileApp
   Description: A mobile app update log showing build numbers, app store versions, platform icons, and What is New descriptions with staggered entrance animations for iOS and Android releases.
   Source: original/blocks/changelog/changelog-mobile-app.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="smartphone" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Mobile App Releases</h2>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto text-xs">@_releases.Length releases</BadgeCn>
        </div>

        @foreach (var release in _releases)
        {
            var dotClass = Cn.Merge(
                "size-1.5 rounded-full",
                release.Platform == "ios" ? "bg-blue-500" :
                release.Platform == "android" ? "bg-emerald-500" :
                "bg-muted-foreground");

            var chevronClass = Cn.Merge(
                "size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200",
                _expanded == release.Build ? "rotate-90" : "");

            <div>
                <button type="button"
                        class="flex w-full items-center gap-3 border-b px-4 py-3 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => ToggleExpanded(release.Build))">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">v@(release.Version)</span>
                            <span class="font-mono text-xs text-muted-foreground">(@(release.Build))</span>
                            <span class="@dotClass"></span>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">@(PlatformLabel(release.Platform)) · @release.Date</p>
                    </div>
                    <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                </button>

                @if (_expanded == release.Build)
                {
                    <div class="border-b bg-muted/30 px-4 py-3">
                        <div class="mb-2 flex items-center gap-3 text-xs text-muted-foreground">
                            <span class="flex items-center gap-1">
                                <LucideIconCn Name="download" Size="12" Class="size-3" />
                                @release.Size
                            </span>
                            <span>Requires @release.MinOs</span>
                        </div>
                        <p class="mb-1.5 text-xs font-medium text-muted-foreground">What's New</p>
                        <ul class="space-y-1">
                            @foreach (var item in release.Highlights)
                            {
                                <li class="flex items-start gap-2 text-xs text-muted-foreground">
                                    <LucideIconCn Name="star" Size="12" Class="mt-0.5 size-3 shrink-0 text-muted-foreground/40" />
                                    @item
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }

        <div class="px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">Showing latest 5 releases</p>
        </div>

    </div>
</section>

@code {
    private string? _expanded = null;

    private record AppRelease(
        string Version,
        string Build,
        string Platform,
        string Date,
        string Size,
        string[] Highlights,
        string MinOs
    );

    private static string PlatformLabel(string platform) => platform switch
    {
        "ios"     => "iOS",
        "android" => "Android",
        _         => "iOS & Android",
    };

    private void ToggleExpanded(string build)
    {
        _expanded = _expanded == build ? null : build;
    }

    private static readonly AppRelease[] _releases =
    [
        new("5.4.0", "2641", "both", "Mar 26, 2026", "48.2 MB",
            [
                "Redesigned home feed with card-based layout",
                "Added haptic feedback for all interactions",
                "Reduced cold start time by 35%",
                "Fixed crash on iOS 19 when opening camera",
            ],
            "iOS 17+ / Android 14+"),
        new("5.3.2", "2618", "ios", "Mar 19, 2026", "47.8 MB",
            [
                "Fixed widget not updating on iOS 19",
                "Resolved iCloud sync conflicts for saved items",
                "Improved VoiceOver descriptions for charts",
            ],
            "iOS 17+"),
        new("5.3.1", "2605", "android", "Mar 14, 2026", "42.1 MB",
            [
                "Fixed notification channels on Android 15",
                "Material You dynamic color improvements",
                "Resolved back gesture conflict with drawer navigation",
            ],
            "Android 13+"),
        new("5.3.0", "2590", "both", "Mar 7, 2026", "46.5 MB",
            [
                "New offline mode with local-first sync",
                "Biometric authentication for sensitive actions",
                "Reduced memory usage by 22%",
            ],
            "iOS 17+ / Android 13+"),
        new("5.2.4", "2571", "both", "Feb 28, 2026", "45.9 MB",
            [
                "Security patch for token refresh flow",
                "Fixed deep link routing for shared content",
            ],
            "iOS 16+ / Android 13+"),
    ];
}
