@* ============================================================
   Block: changelog-stats-summary
   Title: ChangelogStatsSummary
   Description: React stats summary changelog block for Next.js with metric counters, category breakdowns, and recent entries built with TypeScript, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-stats-summary.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="bar-chart-3" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Release Summary</h2>
            <span class="ml-auto text-xs text-muted-foreground">March 2026</span>
        </div>

        @* Stats grid *@
        <div class="grid grid-cols-3 border-b">
            @for (int i = 0; i < _stats.Length; i++)
            {
                var stat = _stats[i];
                var statClass = Cn.Merge("px-4 py-4 text-center", i < _stats.Length - 1 ? "border-r" : "");
                <div class="@statClass">
                    <div class="flex items-center justify-center gap-1.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", stat.DotColor)"></span>
                        <span class="text-xs text-muted-foreground">@stat.Label</span>
                    </div>
                    <p class="mt-1 text-2xl font-semibold tabular-nums">@stat.Count</p>
                </div>
            }
        </div>

        @* Recent changes label *@
        <div class="border-b px-4 py-2.5">
            <span class="text-xs font-medium text-muted-foreground">Recent changes</span>
        </div>

        @* Entries *@
        <div>
            @for (int i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                var entryClass = Cn.Merge("flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50", i < _entries.Length - 1 ? "border-b" : "");
                var dotColor = GetCategoryDot(entry.Category);
                <div class="@entryClass">
                    <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", dotColor)"></span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@entry.Title</span>
                            <span class="shrink-0 font-mono text-xs text-muted-foreground">@entry.Version</span>
                        </div>
                        <p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">@entry.Description</p>
                    </div>
                    <span class="shrink-0 text-xs text-muted-foreground">@entry.Date</span>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Stat(string Label, int Count, string DotColor);

    private record ChangeEntry(string Id, string Category, string Title, string Description, string Date, string Version);

    private static readonly Stat[] _stats =
    [
        new("Features", 12, "bg-blue-500"),
        new("Fixes", 8, "bg-red-500"),
        new("Improvements", 5, "bg-amber-500"),
    ];

    private static readonly ChangeEntry[] _entries =
    [
        new("1", "feature", "Role-based access control for API keys",
            "Assign read, write, or admin scopes to individual API keys with granular resource-level permissions.",
            "Mar 28", "v7.3.0"),
        new("2", "fix", "Fixed calendar event duplication on DST change",
            "Recurring events no longer create duplicate entries when crossing daylight saving time boundaries.",
            "Mar 27", "v7.3.0"),
        new("3", "improvement", "Reduced cold start time for serverless functions",
            "Function initialization optimized from 1.2s to 340ms through dependency tree shaking and lazy imports.",
            "Mar 26", "v7.2.9"),
        new("4", "feature", "Custom field types for forms",
            "Create reusable field types with validation rules, default values, and conditional display logic.",
            "Mar 25", "v7.2.9"),
        new("5", "fix", "Resolved PDF export encoding for CJK characters",
            "PDF exports now correctly render Chinese, Japanese, and Korean characters with embedded font subsets.",
            "Mar 24", "v7.2.8"),
        new("6", "feature", "Audit log export to SIEM integrations",
            "Stream audit events to Splunk, Datadog, or any SIEM via configurable webhook destinations.",
            "Mar 23", "v7.2.8"),
        new("7", "improvement", "Improved autocomplete latency for search",
            "Search suggestions now return in under 50ms using a pre-built trigram index updated every 5 minutes.",
            "Mar 22", "v7.2.7"),
        new("8", "fix", "Fixed branch protection bypass via API",
            "Direct API pushes to protected branches now enforce the same merge checks as the UI workflow.",
            "Mar 20", "v7.2.7"),
    ];

    private static string GetCategoryDot(string category) => category switch
    {
        "feature"     => "bg-blue-500",
        "fix"         => "bg-red-500",
        "improvement" => "bg-amber-500",
        _             => "",
    };
}
