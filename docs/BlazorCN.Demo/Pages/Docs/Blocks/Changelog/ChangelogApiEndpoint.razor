@* ============================================================
   Block: changelog-api-endpoint
   Title: ChangelogApiEndpoint
   Description: A changelog block displaying REST API endpoint changes with color-coded method badges, monospace endpoint paths, and detailed descriptions of each modification.
   Source: original/blocks/changelog/changelog-api-endpoint.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="server" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">API Endpoint Changes</h2>
            <span class="ml-auto text-xs text-muted-foreground">@_entries.Length updates</span>
        </div>

        <div>
            @for (var i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                var index = i;
                var isExpanded = _expandedId == entry.Id;
                var isLast = index == _entries.Length - 1;
                var buttonClass = Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", !isLast ? "border-b" : "");
                var chevronClass = Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
                var methodClass = Cn.Merge("shrink-0 rounded px-1.5 py-0.5 font-mono text-xs font-medium", GetMethodClass(entry.Method));
                var detailClass = Cn.Merge("bg-muted/50 px-4 py-3", !isLast ? "border-b" : "");
                <div>
                    <button
                        type="button"
                        class="@buttonClass"
                        @onclick="@(() => ToggleExpanded(entry.Id))">
                        @if (entry.Breaking)
                        {
                            <span class="size-1.5 shrink-0 rounded-full bg-red-500"></span>
                        }
                        else
                        {
                            <span class="size-1.5 shrink-0 rounded-full bg-transparent"></span>
                        }
                        <span class="@methodClass">@entry.Method</span>
                        <div class="min-w-0 flex-1">
                            <code class="font-mono text-xs text-muted-foreground">@entry.Endpoint</code>
                            <p class="mt-0.5 text-sm font-medium">@entry.Summary</p>
                        </div>
                        <span class="shrink-0 text-xs text-muted-foreground">@entry.Date</span>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                    </button>
                    @if (isExpanded)
                    {
                        <div class="@detailClass overflow-hidden">
                            <p class="text-xs leading-relaxed text-muted-foreground">
                                @entry.Detail
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ApiEntry(
        string Id,
        string Date,
        string Method,
        string Endpoint,
        string Summary,
        string Detail,
        bool Breaking
    );

    private string? _expandedId;

    private void ToggleExpanded(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private static string GetMethodClass(string method) => method switch
    {
        "GET"    => "bg-blue-500/10 text-blue-600",
        "POST"   => "bg-emerald-500/10 text-emerald-600",
        "PUT"    => "bg-amber-500/10 text-amber-600",
        "DELETE" => "bg-red-500/10 text-red-600",
        _        => "bg-gray-500/10 text-gray-600",
    };

    private static readonly ApiEntry[] _entries =
    [
        new("e1", "Mar 28, 2026", "POST", "/v2/webhooks/subscribe",
            "Added webhook subscription endpoint",
            "Allows clients to register callback URLs for real-time event notifications. Supports filtering by event type and includes retry configuration.",
            false),
        new("e2", "Mar 25, 2026", "DELETE", "/v1/users/{id}/sessions",
            "Deprecated single-session revocation",
            "This endpoint is replaced by /v2/users/{id}/sessions which supports bulk session revocation. The v1 endpoint will be removed on June 1, 2026.",
            true),
        new("e3", "Mar 22, 2026", "PUT", "/v2/organizations/{orgId}/settings",
            "Extended settings payload schema",
            "Added sso_enforcement and ip_allowlist fields to the settings object. Existing integrations are unaffected as the new fields are optional.",
            false),
        new("e4", "Mar 18, 2026", "GET", "/v2/analytics/events",
            "New analytics query endpoint",
            "Returns aggregated event data with support for date range filtering, grouping by property, and pagination via cursor tokens.",
            false),
        new("e5", "Mar 14, 2026", "POST", "/v2/billing/invoices/preview",
            "Invoice preview before charge",
            "Generates a preview invoice for upcoming billing cycles without triggering a charge. Useful for confirming proration amounts before plan changes.",
            false),
        new("e6", "Mar 10, 2026", "PUT", "/v2/teams/{teamId}/members/{userId}/role",
            "Role update now validates seat limits",
            "Upgrading a member to admin now checks against the plan's admin seat limit. Returns 403 if the limit is reached.",
            true),
    ];
}
