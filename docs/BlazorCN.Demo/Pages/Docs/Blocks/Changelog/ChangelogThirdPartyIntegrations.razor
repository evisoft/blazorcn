@* ============================================================
   Block: changelog-third-party-integrations
   Title: ChangelogThirdPartyIntegrations
   Description: A React changelog component displaying third-party integration updates with API versions, health status, and connection monitoring built with shadcn/ui, Tailwind CSS, and Next.js
   Source: original/blocks/changelog/changelog-third-party-integrations.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="link" Size="16" Class="size-4 text-muted-foreground" />
                    <h2 class="text-sm font-medium">Integration Status</h2>
                </div>
                <div class="flex items-center gap-2 text-xs text-muted-foreground">
                    <LucideIconCn Name="activity" Size="12" Class="size-3" />
                    <span>Live monitoring</span>
                </div>
            </div>
        </div>

        @* Integration list *@
        <div class="divide-y">
            @foreach (var intg in _integrations)
            {
                var integration = intg;
                var healthColor = integration.Status switch
                {
                    "operational" => "bg-emerald-500",
                    "degraded"    => "bg-amber-500",
                    _             => "bg-red-500"
                };
                var statusBadgeClass = integration.Status switch
                {
                    "operational" => "border-emerald-500/20 bg-emerald-500/10 text-emerald-600",
                    "degraded"    => "border-amber-500/20 bg-amber-500/10 text-amber-600",
                    _             => "border-red-500/20 bg-red-500/10 text-red-600"
                };
                <div class="px-4 py-3">
                    <div class="mb-3 flex items-start justify-between">
                        <div class="flex items-start gap-3">
                            <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", healthColor)"></span>
                            <div>
                                <h3 class="text-sm font-medium">@integration.Provider</h3>
                                <div class="mt-1 flex flex-wrap items-center gap-2">
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 px-1.5 text-xs">
                                        @integration.Version
                                    </BadgeCn>
                                    <span class="flex items-center gap-1 text-xs text-muted-foreground">
                                        <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                        @integration.LastChecked
                                    </span>
                                </div>
                            </div>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("h-5 px-1.5 text-xs capitalize", statusBadgeClass)">
                            @integration.Status
                        </BadgeCn>
                    </div>

                    <div class="space-y-2">
                        @foreach (var chg in integration.Changes)
                        {
                            var change = chg;
                            var isExpanded = _expandedItems.Contains(change.Id);
                            var typeColor = change.Type switch
                            {
                                "upgrade"     => "text-emerald-600",
                                "downgrade"   => "text-amber-600",
                                "added"       => "text-blue-600",
                                "deprecated"  => "text-red-600",
                                _             => "text-muted-foreground"
                            };
                            <div>
                                <button type="button"
                                        class="flex w-full items-start gap-2 rounded-md p-2 text-left transition-colors hover:bg-muted/50"
                                        @onclick="@(() => ToggleItem(change.Id))">
                                    <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("mt-0.5 size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-2">
                                            <span class="text-xs text-muted-foreground">@change.Date</span>
                                            <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("h-4 px-1 text-xs capitalize", typeColor)">
                                                @change.Type
                                            </BadgeCn>
                                        </div>
                                        <p class="mt-0.5 text-sm">@change.Changes[0]</p>
                                    </div>
                                </button>

                                @if (isExpanded)
                                {
                                    <div class="ml-6 mt-2 space-y-2 pl-4 text-sm">
                                        @for (var i = 1; i < change.Changes.Length; i++)
                                        {
                                            var item = change.Changes[i];
                                            <div class="flex items-start gap-2 text-xs text-muted-foreground">
                                                <LucideIconCn Name="check-circle-2" Size="12" Class="mt-0.5 size-3 shrink-0" />
                                                <span>@item</span>
                                            </div>
                                        }
                                        <div class="mt-3 grid grid-cols-2 gap-3 rounded-md bg-muted/50 p-3">
                                            <div>
                                                <span class="text-xs text-muted-foreground">Uptime</span>
                                                <p class="mt-1 font-mono text-sm font-medium">@change.Uptime</p>
                                            </div>
                                            <div>
                                                <span class="text-xs text-muted-foreground">Avg Response</span>
                                                <p class="mt-1 font-mono text-sm font-medium">@change.ResponseTime</p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record IntegrationChange(
        string Id,
        string Date,
        string Type,
        string Version,
        string[] Changes,
        string Uptime,
        string ResponseTime);

    private record Integration(
        string Provider,
        string Status,
        string Version,
        string LastChecked,
        IntegrationChange[] Changes);

    private static readonly Integration[] _integrations =
    [
        new("Stripe Payment API", "operational", "2024-12-18", "2 min ago",
        [
            new("int-1", "2026-03-28", "upgrade", "2024-12-18",
                ["Updated to latest API version for enhanced security",
                 "Added support for payment method reusability",
                 "Improved webhook signature verification"],
                "99.98%", "142ms"),
            new("int-2", "2026-03-15", "maintenance", "2024-11-20",
                ["Rotated API keys for compliance",
                 "Updated webhook endpoints"],
                "99.95%", "158ms"),
        ]),
        new("SendGrid Email API", "degraded", "v3", "5 min ago",
        [
            new("int-3", "2026-03-29", "maintenance", "v3",
                ["Experiencing intermittent delays in email delivery",
                 "Average delay: 2-5 minutes",
                 "Monitoring ongoing issue"],
                "98.12%", "1240ms"),
            new("int-4", "2026-03-20", "upgrade", "v3",
                ["Enabled dedicated IP pool",
                 "Implemented DKIM signing",
                 "Added bounce tracking"],
                "99.99%", "89ms"),
        ]),
        new("OpenAI API", "operational", "v1", "1 min ago",
        [
            new("int-5", "2026-03-30", "upgrade", "v1",
                ["Migrated to GPT-4 Turbo for embeddings",
                 "Implemented exponential backoff retry logic",
                 "Added rate limit monitoring"],
                "99.92%", "780ms"),
        ]),
    ];

    private readonly HashSet<string> _expandedItems = [];

    private void ToggleItem(string id)
    {
        if (!_expandedItems.Add(id))
            _expandedItems.Remove(id);
    }
}
