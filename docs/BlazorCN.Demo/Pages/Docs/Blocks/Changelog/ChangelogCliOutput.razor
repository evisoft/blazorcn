@* ============================================================
   Block: changelog-cli-output
   Title: ChangelogCliOutput
   Description: React terminal-style CLI output changelog block for Next.js with monospace log entries, command prompts, and status indicators built with shadcn/ui, Tailwind CSS, and Framer Motion animations.
   Source: original/blocks/changelog/changelog-cli-output.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="terminal" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Changelog</span>
            <span class="text-muted-foreground text-xs">~</span>
            <span class="font-mono text-muted-foreground text-xs">acme-cli</span>
            <span class="ml-auto text-muted-foreground text-xs">@_entries.Length entries</span>
        </div>

        @* Terminal output area *@
        <div class="bg-zinc-950 p-0">
            @foreach (var it in _entries)
            {
                var entry = it;
                var config = GetStatusConfig(entry.Status);
                <div class="group border-b border-zinc-800 px-4 py-3 last:border-b-0">

                    @* Command line *@
                    <div class="flex items-center gap-2">
                        <span class="shrink-0 font-mono text-emerald-400 text-xs">$</span>
                        <code class="min-w-0 flex-1 font-mono text-zinc-200 text-xs">@entry.Command</code>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                            Class="h-5 gap-1 px-1.5 text-[10px] text-zinc-500 opacity-0 transition-opacity hover:bg-zinc-800 hover:text-zinc-300 group-hover:opacity-100"
                            @onclick="@(async () => await CopyCommandAsync(entry.Id, entry.Command))">
                            @if (_copied == entry.Id)
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3" />
                            }
                            else
                            {
                                <LucideIconCn Name="copy" Size="12" Class="size-3" />
                            }
                        </ButtonCn>
                    </div>

                    @* Output *@
                    <div class="mt-1.5 flex items-start gap-2 pl-4">
                        <span class="@Cn.Merge("size-1.5 mt-1.5 shrink-0 rounded-full", config.Dot)"></span>
                        <div class="min-w-0 flex-1">
                            <p class="font-mono text-zinc-400 text-xs leading-relaxed">@entry.Output</p>
                        </div>
                    </div>

                    @* Meta line *@
                    <div class="mt-1.5 flex items-center gap-2 pl-4">
                        <BadgeCn Variant="BadgeVariant.Secondary"
                            Class="h-4 rounded bg-zinc-800 px-1.5 font-mono text-[10px] text-zinc-400">
                            v@(entry.Version)
                        </BadgeCn>
                        <span class="@Cn.Merge("font-mono text-[10px]", config.Color)">@config.Label</span>
                        <span class="text-zinc-600 text-[10px]">@entry.Timestamp</span>
                    </div>

                </div>
            }
        </div>

    </div>
</section>

@code {
    private record CliEntry(string Id, string Version, string Status, string Command, string Output, string Timestamp);
    private record StatusConfig(string Label, string Color, string Dot);

    private string? _copied;

    private async Task CopyCommandAsync(string id, string text)
    {
        _copied = id;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = null;
    }

    private static StatusConfig GetStatusConfig(string status) => status switch
    {
        "success"  => new("added",    "text-emerald-600 dark:text-emerald-400", "bg-emerald-500"),
        "fix"      => new("fixed",    "text-amber-600 dark:text-amber-400",     "bg-amber-500"),
        "breaking" => new("breaking", "text-red-600 dark:text-red-400",         "bg-red-500"),
        "info"     => new("update",   "text-blue-600 dark:text-blue-400",       "bg-blue-500"),
        _          => new("info",     "text-muted-foreground",                  "bg-muted-foreground"),
    };

    private static readonly CliEntry[] _entries =
    [
        new("cli-1", "3.2.0",  "success",
            "acme deploy --production",
            "Deployed v3.2.0 to production. Added real-time collaboration with conflict resolution and cursor presence indicators.",
            "Mar 30, 14:22"),
        new("cli-2", "3.1.4",  "fix",
            "acme hotfix --apply ACME-4821",
            "Fixed WebSocket reconnection dropping messages after network interruption. Buffered events now replay on reconnect.",
            "Mar 28, 09:15"),
        new("cli-3", "3.1.3",  "breaking",
            "acme migrate --schema v3",
            "BREAKING: Renamed `user.teamId` to `user.workspaceId`. Run `acme migrate --schema v3` to update your database.",
            "Mar 26, 11:40"),
        new("cli-4", "3.1.2",  "success",
            "acme build --optimize",
            "Reduced bundle size by 34% with tree-shaking improvements. Removed unused polyfills for modern browsers.",
            "Mar 24, 16:08"),
        new("cli-5", "3.1.1",  "fix",
            "acme fix --target auth-module",
            "Fixed OAuth token refresh race condition causing 401 errors during concurrent API calls in multi-tab sessions.",
            "Mar 22, 08:33"),
        new("cli-6", "3.1.0",  "info",
            "acme changelog --latest",
            "Added CSV and Parquet export for analytics data. Supports streaming for datasets over 1GB without memory spikes.",
            "Mar 20, 13:50"),
    ];
}
