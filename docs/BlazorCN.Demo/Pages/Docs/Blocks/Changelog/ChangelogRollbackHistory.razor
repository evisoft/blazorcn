@* ============================================================
   Block: changelog-rollback-history
   Title: ChangelogRollbackHistory
   Description: A changelog block displaying version rollback and revert records with source and target versions, rollback reasons, and resolution status for deployment tracking.
   Source: original/blocks/changelog/changelog-rollback-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="undo-2" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Rollback History</h2>
            <span class="ml-auto text-xs text-muted-foreground">@_rollbacks.Length rollbacks</span>
        </div>

        @* Entries *@
        <div>
            @foreach (var ent in _rollbacks)
            {
                var entry = ent;
                var isExpanded = _expandedId == entry.Id;
                var config = GetStatusConfig(entry.Status);
                var isLast = entry.Id == _rollbacks[^1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => SetExpanded(entry.Id, isExpanded))">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", config.Dot)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-1.5">
                                <span class="font-mono text-sm font-medium">@entry.FromVersion</span>
                                <LucideIconCn Name="arrow-right" Size="12" Class="size-3 text-muted-foreground/60" />
                                <span class="font-mono text-sm font-medium">@entry.ToVersion</span>
                            </div>
                            <p class="mt-0.5 truncate text-xs text-muted-foreground">@entry.Reason</p>
                        </div>
                        <span class="shrink-0 text-xs text-muted-foreground">@entry.Date</span>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-3 px-4 pb-4">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <p class="text-xs text-muted-foreground">@entry.Details</p>
                                </div>
                                <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-muted-foreground">
                                    <div class="flex items-center gap-1.5">
                                        <LucideIconCn Name="user" Size="12" Class="size-3" />
                                        <span>@entry.InitiatedBy</span>
                                    </div>
                                    <span>Duration: @entry.Duration</span>
                                    <BadgeCn Variant="@(entry.Status == "failed" ? BadgeVariant.Secondary : BadgeVariant.Secondary)"
                                             Class="@Cn.Merge("text-[10px]", entry.Status == "failed" ? "bg-red-500/10 text-red-600 dark:text-red-400" : "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400")">
                                        @config.Label
                                    </BadgeCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record RollbackEntry(
        string Id,
        string FromVersion,
        string ToVersion,
        string Reason,
        string Details,
        string Status,
        string InitiatedBy,
        string Date,
        string Duration);

    private record StatusConfig(string Label, string Dot);

    private static readonly RollbackEntry[] _rollbacks =
    [
        new("rb-1", "v4.2.0", "v4.1.3",
            "Memory leak in WebSocket handler",
            "New connection pooling in v4.2.0 caused unbounded memory growth under sustained load. P95 latency exceeded 8s after 4 hours.",
            "completed", "DevOps Bot", "Mar 27, 2026", "3m 42s"),
        new("rb-2", "v4.1.2", "v4.1.1",
            "Broken OAuth callback redirect",
            "Callback URL encoding change broke Google OAuth flow for users with special characters in email addresses.",
            "completed", "Sarah Chen", "Mar 22, 2026", "1m 58s"),
        new("rb-3", "v4.1.0", "v4.0.9",
            "Database migration timeout on large tables",
            "ALTER TABLE on the events table (280M rows) exceeded the 30-minute deployment window. Migration was not backwards-compatible.",
            "completed", "Marcus Webb", "Mar 18, 2026", "5m 11s"),
        new("rb-4", "v4.0.8", "v4.0.7",
            "CSS regression in checkout flow",
            "Tailwind purge removed critical utility classes used in the payment form, making the submit button invisible on mobile.",
            "failed", "Aiko Tanaka", "Mar 14, 2026", "8m 03s"),
        new("rb-5", "v4.0.5", "v4.0.4",
            "API rate limiter misconfiguration",
            "New rate limiting rules applied globally instead of per-tenant, throttling high-volume enterprise customers at consumer-tier limits.",
            "completed", "Elena Popov", "Mar 10, 2026", "2m 27s"),
    ];

    private string? _expandedId;

    private void SetExpanded(string id, bool isCurrentlyExpanded)
    {
        _expandedId = isCurrentlyExpanded ? null : id;
    }

    private static StatusConfig GetStatusConfig(string status) => status switch
    {
        "completed" => new StatusConfig("Completed", "bg-emerald-500"),
        "in-progress" => new StatusConfig("In Progress", "bg-amber-500"),
        "failed" => new StatusConfig("Failed", "bg-red-500"),
        _ => new StatusConfig("Unknown", "bg-muted"),
    };
}
