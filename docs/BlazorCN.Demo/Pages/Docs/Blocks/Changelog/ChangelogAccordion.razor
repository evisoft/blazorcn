@* ============================================================
   Block: changelog-accordion
   Title: ChangelogAccordion
   Description: React accordion changelog block for Next.js with collapsible version sections using shadcn/ui Collapsible component built with TypeScript, Framer Motion staggered animations, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-accordion.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="chevrons-up-down" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Release History</h2>
            <span class="ml-auto text-xs text-muted-foreground">@_versions.Length versions</span>
        </div>

        <div>
            @foreach (var ver in _versions)
            {
                var version = ver;
                <div class="@(version == _versions[^1] ? "" : "border-b")">
                    <CollapsibleCn Open="@_openVersions.Contains(version.Version)" OpenChanged="@((bool val) => HandleOpenChange(version.Version, val))">
                        <CollapsibleTriggerCn Class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="font-mono text-xs">@version.Version</BadgeCn>
                                    <span class="text-sm font-medium">@version.Summary</span>
                                </div>
                                <div class="mt-0.5 flex items-center gap-2">
                                    <span class="text-[11px] text-muted-foreground/60">@version.Date</span>
                                    <span class="text-[11px] text-muted-foreground/40">&middot;</span>
                                    <span class="text-[11px] text-muted-foreground/60">@version.Changes.Length changes</span>
                                </div>
                            </div>
                            <LucideIconCn Name="chevrons-up-down" Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                        </CollapsibleTriggerCn>
                        <CollapsibleContentCn>
                            <div class="px-4 pb-3">
                                <div class="space-y-1.5">
                                    @foreach (var chg in version.Changes)
                                    {
                                        var change = chg;
                                        <div class="flex items-start gap-2 rounded-md bg-muted/30 px-3 py-2">
                                            <span class="mt-0.5 inline-flex shrink-0 items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium @(_typeStyles[change.Type])">
                                                @change.Type
                                            </span>
                                            <span class="text-xs text-muted-foreground leading-relaxed">@change.Text</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </CollapsibleContentCn>
                    </CollapsibleCn>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ChangeEntry(string Type, string Text);
    private record VersionSection(string Version, string Date, string Summary, ChangeEntry[] Changes);

    private static readonly Dictionary<string, string> _typeStyles = new()
    {
        ["Feature"] = "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        ["Fix"] = "bg-red-500/10 text-red-600 dark:text-red-400",
        ["Improvement"] = "bg-blue-500/10 text-blue-600 dark:text-blue-400",
    };

    private static readonly VersionSection[] _versions =
    [
        new("4.2.0", "Mar 28, 2026", "Real-time presence and API key scoping",
        [
            new("Feature", "Real-time presence indicators showing online team members in the workspace"),
            new("Feature", "API key scoping with granular read, write, and admin permission levels"),
            new("Fix", "Resolved intermittent 502 errors during deployment rollback operations"),
            new("Improvement", "Reduced dashboard initial load time by 35% with optimized data fetching"),
        ]),
        new("4.1.0", "Mar 14, 2026", "Custom domains and webhook retry policies",
        [
            new("Feature", "Custom domain support with automatic SSL certificate provisioning"),
            new("Feature", "Configurable webhook retry policies with exponential backoff and max attempt limits"),
            new("Fix", "Fixed file upload progress bar showing 100% before upload completion"),
            new("Fix", "Corrected timezone display in the activity log for UTC-negative offsets"),
            new("Improvement", "Migrated search indexing to a dedicated worker for consistent sub-second updates"),
        ]),
        new("4.0.0", "Feb 28, 2026", "Major release with new editor and permission model",
        [
            new("Feature", "Rebuilt code editor with multi-cursor support, bracket pair colorization, and minimap"),
            new("Feature", "Role-based access control with custom roles and permission inheritance"),
            new("Feature", "Project templates for quick workspace setup with pre-configured pipelines"),
            new("Fix", "Fixed memory leak in long-running WebSocket connections for live tailing logs"),
            new("Improvement", "Database query performance improved 2x with connection pooling and prepared statements"),
            new("Improvement", "Redesigned settings page with grouped sections and instant search"),
        ]),
        new("3.9.0", "Feb 14, 2026", "Audit log enhancements and bulk operations",
        [
            new("Feature", "Audit log export to CSV and JSON formats with date range and actor filters"),
            new("Feature", "Bulk delete and archive operations for projects and environments"),
            new("Fix", "Fixed OAuth callback URL validation rejecting valid localhost URLs during development"),
            new("Improvement", "Improved error messages with actionable suggestions and documentation links"),
        ]),
    ];

    private readonly HashSet<string> _openVersions = ["4.2.0"];

    private void HandleOpenChange(string version, bool isOpen)
    {
        if (isOpen)
            _openVersions.Add(version);
        else
            _openVersions.Remove(version);
    }
}
