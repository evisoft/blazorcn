                "  ",
                "- export const formatDate = (d: string) =>",
                "-   moment(d).format('MMM D, YYYY')",
                "+ export const formatDate = (d: string) =>",
                "+   format(parseISO(d), 'MMM d, yyyy')",
            ]
        ),
        new(
            "Update Dockerfile to multi-stage build",
            "Mar 4, 2026",
            "Dockerfile",
            [
                "- FROM node:20",
                "- COPY . .",
                "- RUN npm install",
                "- RUN npm run build",
                "+ FROM node:20-slim AS builder",
                "+ WORKDIR /app",
                "+ COPY package*.json ./",
                "+ RUN npm ci --production=false",
                "+ COPY . .",
                "+ RUN npm run build",
                "+  ",
                "+ FROM node:20-slim AS runner",
                "+ COPY --from=builder /app/.next ./.next",
                "+ COPY --from=builder /app/node_modules ./node_modules",
            ]
        ),
    ];

    private static string GetLineColor(string line)
    {
        if (line.StartsWith("+")) return "text-emerald-400";
        if (line.StartsWith("-")) return "text-red-400";
        return "text-zinc-500";
    }

    private static string GetLineBg(string line)
    {
        if (line.StartsWith("+")) return "bg-emerald-500/10";
        if (line.StartsWith("-")) return "bg-red-500/10";
        return "";
    }
}
