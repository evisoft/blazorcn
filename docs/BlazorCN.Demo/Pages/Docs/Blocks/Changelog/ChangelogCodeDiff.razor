@* ============================================================
   Block: changelog-code-diff
   Title: ChangelogCodeDiff
   Description: React changelog block with inline code diff view showing added and removed lines in a monospace dark panel built with TypeScript, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-code-diff.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="file-code" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Code Changes</h2>
            <span class="ml-auto text-xs text-muted-foreground">@_entries.Length commits</span>
        </div>

        @for (var i = 0; i < _entries.Length; i++)
        {
            var entry = _entries[i];
            var borderClass = i < _entries.Length - 1 ? "border-b" : "";
            <div class="@Cn.Merge("px-4 py-3", borderClass)">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium">@entry.Title</span>
                    <span class="text-xs text-muted-foreground">@entry.Date</span>
                </div>
                <p class="mt-1 font-mono text-xs text-muted-foreground">@entry.FilePath</p>

                <div class="mt-2 overflow-hidden rounded-md bg-zinc-950">
                    <div class="overflow-x-auto p-3">
                        @foreach (var line in entry.Lines)
                        {
                            var lineBg = GetLineBg(line);
                            var lineColor = GetLineColor(line);
                            <div class="@Cn.Merge("-mx-3 px-3", lineBg)">
                                <span class="@Cn.Merge("whitespace-pre font-mono text-xs leading-relaxed", lineColor)">@line</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

    </div>
</section>

@code {
    private record DiffEntry(string Title, string Date, string FilePath, string[] Lines);

    private static readonly DiffEntry[] _entries =
    [
        new(
