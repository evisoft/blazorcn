@* ============================================================
   Block: changelog-sprint-summary
   Title: ChangelogSprintSummary
   Description: React sprint summary changelog block for Next.js with iteration number, date range, velocity stats, and categorized entries built with TypeScript, shadcn/ui Badge, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-sprint-summary.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideIconCn Name="iteration-ccw" Size="16" Class="size-4 text-muted-foreground" />
            <div class="flex-1">
                <p class="text-sm font-medium">
                    Sprint @_sprint.Number &middot; @_sprint.DateRange
                </p>
                <p class="text-xs text-muted-foreground">Iteration summary</p>
            </div>
        </div>

        <div class="flex items-center gap-6 border-b px-4 py-3">
            <div>
                <p class="text-2xl font-semibold tabular-nums">@_sprint.PointsCompleted</p>
                <p class="text-xs text-muted-foreground">Points completed</p>
            </div>
            <div>
                <p class="text-2xl font-semibold tabular-nums">@_sprint.TasksDelivered</p>
                <p class="text-xs text-muted-foreground">Tasks delivered</p>
            </div>
            <div>
                <p class="text-2xl font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">
                    @(_sprint.CompletionRate)%
                </p>
                <p class="text-xs text-muted-foreground">Completion rate</p>
            </div>
        </div>

        @for (var i = 0; i < _sprint.Entries.Length; i++)
        {
            var entry = _sprint.Entries[i];
            var isLast = i == _sprint.Entries.Length - 1;
            var rowClass = isLast ? "flex items-start gap-3 px-4 py-3" : "flex items-start gap-3 px-4 py-3 border-b";
            var badgeClass = GetBadgeClass(entry.Category);
            <div class="@rowClass">
                <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-muted-foreground/40"></span>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <p class="text-sm font-medium">@entry.Title</p>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@badgeClass">@entry.Category</BadgeCn>
                    </div>
                    <p class="mt-0.5 text-xs text-muted-foreground">@entry.Description</p>
                </div>
            </div>
        }

    </div>
</section>

@code {
    private record Entry(string Title, string Description, string Category);

    private record Sprint(
        int Number,
        string DateRange,
        int PointsCompleted,
        int TasksDelivered,
        int CompletionRate,
        Entry[] Entries
    );

    private static string GetBadgeClass(string category) => category switch
    {
        "feature"        => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-0",
        "fix"            => "bg-red-500/10 text-red-600 dark:text-red-400 border-0",
        "improvement"    => "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-0",
        "infrastructure" => "bg-violet-500/10 text-violet-600 dark:text-violet-400 border-0",
        _                => "border-0",
    };

    private static readonly Sprint _sprint = new(
        Number: 24,
        DateRange: "Mar 18–28",
        PointsCompleted: 34,
        TasksDelivered: 18,
        CompletionRate: 92,
        Entries:
        [
            new("Workspace sharing permissions",
                "Added granular read, write, and admin permission levels for shared workspaces.",
                "feature"),
            new("Query builder performance",
                "Optimized SQL generation to reduce average query build time from 240ms to 85ms.",
                "improvement"),
            new("CSV export encoding",
                "Fixed UTF-8 BOM handling that caused garbled characters in Excel on Windows.",
                "fix"),
            new("Edge function migration",
                "Migrated authentication middleware to edge runtime for 3x faster cold starts.",
                "infrastructure"),
            new("Inline code comments",
                "Users can now leave threaded comments on specific lines in the code editor.",
                "feature"),
            new("Dashboard widget drag-drop",
                "Resolved z-index stacking issue when dragging widgets across grid columns.",
                "fix"),
        ]
    );
}
