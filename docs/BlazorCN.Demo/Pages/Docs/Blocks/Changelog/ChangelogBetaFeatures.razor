@* ============================================================
   Block: changelog-beta-features
   Title: ChangelogBetaFeatures
   Description: A changelog block showcasing beta and experimental features with color-coded status badges, opt-in descriptions, and release dates in a clean staggered list layout.
   Source: original/blocks/changelog/changelog-beta-features.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="flask-conical" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Beta &amp; Experimental Features</h2>
            <span class="ml-auto text-xs text-muted-foreground">@_features.Length features</span>
        </div>

        <div>
            @for (int i = 0; i < _features.Length; i++)
            {
                var feat = _features[i];
                var itemClass = Cn.Merge("px-4 py-3", i < _features.Length - 1 ? "border-b" : "");
                var statusClass = GetStatusClass(feat.Status);
                <div class="@itemClass">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-medium">@feat.Name</span>
                        <span class="@Cn.Merge("shrink-0 rounded px-1.5 py-0.5 text-xs font-medium", statusClass)">
                            @feat.Status
                        </span>
                        <span class="ml-auto shrink-0 text-xs text-muted-foreground">@feat.Date</span>
                    </div>
                    <p class="mt-1 text-xs leading-relaxed text-muted-foreground">@feat.Description</p>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record BetaFeature(string Id, string Name, string Description, string Status, string Date);

    private static string GetStatusClass(string status) => status switch
    {
        "Beta"         => "bg-blue-500/10 text-blue-600",
        "Experimental" => "bg-amber-500/10 text-amber-600",
        "Stable"       => "bg-emerald-500/10 text-emerald-600",
        _              => "bg-gray-500/10 text-gray-600",
    };

    private static readonly BetaFeature[] _features =
    [
        new("f1", "AI-Powered Code Review",
            "Automated code suggestions and vulnerability detection using LLM analysis on pull requests.",
            "Beta", "Mar 25, 2026"),
        new("f2", "Real-Time Collaboration Cursors",
            "See teammate cursors and selections live in the editor with presence indicators.",
            "Experimental", "Mar 20, 2026"),
        new("f3", "Branch Preview Environments",
            "Automatic preview deployments for every feature branch with shareable URLs.",
            "Stable", "Mar 14, 2026"),
        new("f4", "Natural Language Database Queries",
            "Write database queries in plain English and get SQL generated automatically.",
            "Experimental", "Mar 8, 2026"),
        new("f5", "Smart Merge Conflict Resolution",
            "AI-assisted merge conflict resolution with context-aware suggestions for each hunk.",
            "Beta", "Mar 2, 2026"),
        new("f6", "Federated Search Across Workspaces",
            "Search code, issues, and docs across all connected workspaces from a single query bar.",
            "Experimental", "Feb 24, 2026"),
    ];
}
