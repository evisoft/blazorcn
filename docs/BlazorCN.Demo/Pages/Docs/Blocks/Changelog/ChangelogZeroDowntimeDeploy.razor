            HealthChecks:
            [
                new("API Gateway",  "healthy", "45ms"),
                new("Auth Service", "healthy", "32ms"),
                new("Database",     "healthy", "18ms"),
            ],
            Phases:
            [
                new("Deploy to Green",  "completed", "14:00:00 UTC", "3m 42s",  12),
                new("Health Checks",    "completed", "14:03:42 UTC", "1m 18s",  12),
                new("Switch Traffic",   "completed", "14:05:00 UTC", "12s",     12),
                new("Monitor Green",    "completed", "14:05:12 UTC", "10m 00s", 12),
                new("Terminate Blue",   "completed", "14:15:12 UTC", "48s",      0),
            ],
            Downtime: "0s",
            Notes:
            [
                "Successful blue-green deployment with zero downtime",
                "All health checks passed on first attempt",
                "Traffic switch completed in 12 seconds",
            ]
        ),
        new(
            Id: "deploy-2",
            Version: "v2.4.5",
            ReleaseDate: "2026-03-28",
            Strategy: "rolling",
            Status: "completed",
            Environment: "production",
            TotalInstances: 12,
            HealthChecks:
            [
                new("API Gateway",  "healthy", "52ms"),
                new("Auth Service", "healthy", "38ms"),
                new("Database",     "healthy", "21ms"),
            ],
            Phases:
            [
                new("Update Wave 1", "completed", "09:00:00 UTC", "2m 15s", 3),
                new("Update Wave 2", "completed", "09:02:15 UTC", "2m 18s", 3),
                new("Update Wave 3", "completed", "09:04:33 UTC", "2m 12s", 3),
                new("Update Wave 4", "completed", "09:06:45 UTC", "2m 20s", 3),
            ],
            Downtime: "0s",
            Notes:
            [
                "Rolling deployment across 4 waves with 25% instance batches",
