@* ============================================================
   Block: changelog-zero-downtime-deploy
   Title: ChangelogZeroDowntimeDeploy
   Description: A React changelog component tracking zero-downtime deployment strategies with blue-green and rolling deployment status monitoring built with shadcn/ui, Tailwind CSS, and Next.js
   Source: original/blocks/changelog/changelog-zero-downtime-deploy.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="rocket" Size="16" Class="size-4 text-muted-foreground" />
                    <h2 class="text-sm font-medium">Deployment Log</h2>
                </div>
                <div class="flex items-center gap-2 text-xs text-muted-foreground">
                    <LucideIconCn Name="server" Size="12" Class="size-3" />
                    <span>Zero downtime</span>
                </div>
            </div>
        </div>

        <div class="divide-y">
            @foreach (var dep in _deployments)
            {
                var deployment = dep;
                var isExpanded = _expandedItems.Contains(deployment.Id);
                var strategyStyle = _strategyConfig[deployment.Strategy];
                var statusStyle = _statusConfig[deployment.Status];
                <div>
                    <button type="button"
                            @onclick="@(() => ToggleItem(deployment.Id))"
                            class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="chevron-right" Size="16"
                            Class="@Cn.Merge("mt-1 size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@deployment.Version</span>
                                <BadgeCn Variant="BadgeVariant.Outline"
                                         Class="@Cn.Merge("h-4 gap-1 px-1 text-xs capitalize", statusStyle.Bg, statusStyle.Color)">
                                    <LucideIconCn Name="@statusStyle.Icon" Size="12" Class="size-3" />
                                    @deployment.Status
                                </BadgeCn>
                            </div>

                            <div class="mt-1 flex flex-wrap items-center gap-2">
                                <span class="text-xs text-muted-foreground">@deployment.ReleaseDate</span>
                                <span class="text-xs text-muted-foreground">•</span>
                                <BadgeCn Variant="BadgeVariant.Outline"
                                         Class="@Cn.Merge("h-4 px-1 text-xs", strategyStyle.Bg, strategyStyle.Color)">
                                    @strategyStyle.Label
                                </BadgeCn>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 px-1 text-xs capitalize">
                                    @deployment.Environment
                                </BadgeCn>
                            </div>

                            <div class="mt-3 grid grid-cols-2 gap-3">
                                <div>
                                    <span class="text-xs text-muted-foreground">Instances</span>
                                    <p class="mt-1 font-mono text-sm font-medium tabular-nums">@deployment.TotalInstances</p>
                                </div>
                                <div>
                                    <div class="flex items-center gap-1 text-xs text-muted-foreground">
                                        <LucideIconCn Name="timer" Size="12" Class="size-3" />
                                        <span>Downtime</span>
                                    </div>
                                    <p class="@Cn.Merge("mt-1 font-mono text-sm font-medium tabular-nums", deployment.Downtime == "0s" ? "text-emerald-600" : "")">
                                        @deployment.Downtime
                                    </p>
                                </div>
                            </div>

                            <div class="mt-3 flex items-center gap-2">
                                @foreach (var check in deployment.HealthChecks)
                                {
                                    var hc = check;
                                    <span class="@Cn.Merge("size-1.5 rounded-full", _healthColors[hc.Status])"></span>
                                }
                                <span class="text-xs text-muted-foreground">Health checks</span>
                            </div>
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t px-4 py-3">
                            <div class="space-y-4">
                                <div>
                                    <h3 class="mb-2 flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                                        <LucideIconCn Name="activity" Size="12" Class="size-3" />
                                        Health Checks
                                    </h3>
                                    <div class="space-y-2">
                                        @foreach (var check in deployment.HealthChecks)
                                        {
                                            var hc = check;
                                            <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                                                <div class="flex items-center gap-2">
                                                    <span class="@Cn.Merge("size-1.5 rounded-full", _healthColors[hc.Status])"></span>
                                                    <span class="text-sm">@hc.Service</span>
                                                </div>
                                                <div class="flex items-center gap-3">
                                                    <BadgeCn Variant="BadgeVariant.Outline"
                                                             Class="@Cn.Merge("h-4 px-1 text-xs capitalize",
                                                                 hc.Status == "healthy" ? "text-emerald-600" :
                                                                 hc.Status == "degraded" ? "text-amber-600" :
                                                                 "text-red-600")">
                                                        @hc.Status
                                                    </BadgeCn>
                                                    <span class="font-mono text-xs text-muted-foreground">@hc.ResponseTime</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div>
                                    <h4 class="mb-2 flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                                        <LucideIconCn Name="timer" Size="12" Class="size-3" />
                                        Deployment Phases
                                    </h4>
                                    <div class="space-y-2">
                                        @foreach (var phase in deployment.Phases)
                                        {
                                            var ph = phase;
                                            <div class="flex items-start gap-2">
                                                @if (ph.Status == "completed")
                                                {
                                                    <LucideIconCn Name="check-circle-2" Size="16" Class="mt-0.5 size-4 shrink-0 text-emerald-600" />
                                                }
                                                else if (ph.Status == "failed")
                                                {
                                                    <LucideIconCn Name="alert-circle" Size="16" Class="mt-0.5 size-4 shrink-0 text-red-600" />
                                                }
                                                else
                                                {
                                                    <LucideIconCn Name="refresh-cw" Size="16" Class="mt-0.5 size-4 shrink-0 text-blue-600 animate-spin" />
                                                }
                                                <div class="min-w-0 flex-1">
                                                    <div class="flex items-center gap-2">
                                                        <span class="text-sm font-medium">@ph.Name</span>
                                                        @if (ph.Instances > 0)
                                                        {
                                                            <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 px-1 text-xs">
                                                                @ph.Instances instances
                                                            </BadgeCn>
                                                        }
                                                    </div>
                                                    <div class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                                                        <span>@ph.StartTime</span>
                                                        <span>•</span>
                                                        <span>@ph.Duration</span>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>

                                @if (deployment.Notes.Length > 0)
                                {
                                    <div>
                                        <h4 class="mb-2 text-xs font-medium text-muted-foreground">Notes</h4>
                                        <ul class="space-y-1">
                                            @foreach (var note in deployment.Notes)
                                            {
                                                var n = note;
                                                <li class="text-sm text-muted-foreground">• @n</li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private readonly HashSet<string> _expandedItems = [];

    private void ToggleItem(string id)
    {
        if (!_expandedItems.Add(id))
            _expandedItems.Remove(id);
    }

    private record HealthCheck(string Service, string Status, string ResponseTime);

    private record DeploymentPhase(string Name, string Status, string StartTime, string Duration, int Instances);

    private record Deployment(
        string Id,
        string Version,
        string ReleaseDate,
        string Strategy,
        string Status,
        string Environment,
        int TotalInstances,
        HealthCheck[] HealthChecks,
        DeploymentPhase[] Phases,
        string Downtime,
        string[] Notes
    );

    private record StrategyStyle(string Label, string Color, string Bg);

    private record StatusStyle(string Color, string Bg, string Icon);

    private static readonly Dictionary<string, StrategyStyle> _strategyConfig = new()
    {
        ["blue-green"] = new("Blue-Green", "text-blue-600",   "bg-blue-500/10 border-blue-500/20"),
        ["rolling"]    = new("Rolling",    "text-purple-600", "bg-purple-500/10 border-purple-500/20"),
        ["canary"]     = new("Canary",     "text-amber-600",  "bg-amber-500/10 border-amber-500/20"),
        ["recreate"]   = new("Recreate",   "text-red-600",    "bg-red-500/10 border-red-500/20"),
    };

    private static readonly Dictionary<string, StatusStyle> _statusConfig = new()
    {
        ["completed"]    = new("text-emerald-600", "bg-emerald-500/10 border-emerald-500/20", "check-circle-2"),
        ["in-progress"]  = new("text-blue-600",    "bg-blue-500/10 border-blue-500/20",       "refresh-cw"),
        ["rolled-back"]  = new("text-amber-600",   "bg-amber-500/10 border-amber-500/20",     "refresh-cw"),
        ["failed"]       = new("text-red-600",     "bg-red-500/10 border-red-500/20",         "alert-circle"),
    };

    private static readonly Dictionary<string, string> _healthColors = new()
    {
        ["healthy"]  = "bg-emerald-500",
        ["degraded"] = "bg-amber-500",
        ["failed"]   = "bg-red-500",
    };

    private static readonly Deployment[] _deployments =
    [
        new(
