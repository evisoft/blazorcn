@* ============================================================
   Block: changelog-stakeholder-summary
   Title: ChangelogStakeholderSummary
   Description: A non-technical stakeholder summary changelog with business impact and user benefit highlights, built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-stakeholder-summary.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Product Updates</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Latest releases with business impact and user benefits
            </p>
        </div>

        @* Stats row *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-3 gap-4">
                <div>
                    <p class="text-xs text-muted-foreground">Recent Releases</p>
                    <p class="mt-1 font-semibold tabular-nums text-2xl">@_releases.Length</p>
                </div>
                <div>
                    <p class="text-xs text-muted-foreground">Revenue Impact</p>
                    <p class="mt-1 font-semibold tabular-nums text-2xl text-emerald-500">
                        @(_releases.Count(r => r.ImpactType == "revenue"))
                    </p>
                </div>
                <div>
                    <p class="text-xs text-muted-foreground">UX Improvements</p>
                    <p class="mt-1 font-semibold tabular-nums text-2xl text-purple-500">
                        @(_releases.Count(r => r.ImpactType == "user_experience"))
                    </p>
                </div>
            </div>
        </div>

        @* Release list *@
        <div>
            @foreach (var rel in _releases)
            {
                var release = rel;
                var isExpanded = _expandedRelease == release.Id;
                var isLast = release.Id == _releases[^1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => ToggleRelease(release.Id))">
                        <div class="flex items-center gap-2">
                            @GetImpactIcon(release.ImpactType)
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@release.Title</span>
                                @GetImpactBadge(release.ImpactType)
                            </div>
                            <p class="mt-1 text-sm text-muted-foreground">@release.Summary</p>
                            <div class="mt-1.5 flex items-center gap-2 text-xs text-muted-foreground">
                                <span class="font-mono">@release.Version</span>
                                <span class="text-muted-foreground/40">•</span>
                                <span>@release.Date</span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/30 px-4 py-3">
                            <div class="space-y-3">
                                <div class="rounded-md bg-card p-3">
                                    <div class="mb-1 flex items-center gap-2">
                                        <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                                        <span class="text-xs font-medium text-muted-foreground">User Benefit</span>
                                    </div>
                                    <p class="text-sm">@release.UserBenefit</p>
                                </div>

                                <div class="rounded-md bg-card p-3">
                                    <div class="mb-1 flex items-center gap-2">
                                        <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-muted-foreground" />
                                        <span class="text-xs font-medium text-muted-foreground">Business Impact</span>
                                    </div>
                                    <p class="text-sm">@release.BusinessImpact</p>
                                </div>

                                @if (release.Metrics != null && release.Metrics.Length > 0)
                                {
                                    <div class="rounded-md bg-card p-3">
                                        <div class="mb-2 text-xs font-medium text-muted-foreground">Key Metrics</div>
                                        <div class="grid grid-cols-3 gap-3">
                                            @foreach (var met in release.Metrics)
                                            {
                                                var metric = met;
                                                <div>
                                                    <p class="text-xs text-muted-foreground">@metric.Label</p>
                                                    <div class="mt-1 flex items-center gap-1">
                                                        @if (metric.Trend != "neutral")
                                                        {
                                                            @if (metric.Trend == "up")
                                                            {
                                                                <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-emerald-500" />
                                                            }
                                                            else
                                                            {
                                                                <LucideIconCn Name="trending-up" Size="12" Class="size-3 rotate-180 text-red-500" />
                                                            }
                                                        }
                                                        <span class="@Cn.Merge("font-semibold font-mono text-lg", metric.Trend == "up" ? "text-emerald-500" : metric.Trend == "down" ? "text-red-500" : "")">@metric.Value</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                <div class="rounded-md bg-card p-3">
                                    <div class="mb-2 text-xs font-medium text-muted-foreground">What Changed</div>
                                    <ul class="space-y-1.5">
                                        @foreach (var change in release.KeyChanges)
                                        {
                                            <li class="flex items-start gap-2 text-sm">
                                                <span class="mt-1.5 size-1 shrink-0 rounded-full bg-muted-foreground/60"></span>
                                                <span>@change</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <p class="text-xs text-muted-foreground">Updated today</p>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">View Roadmap</ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record ReleaseMetric(string Label, string Value, string Trend);

    private record ReleaseUpdate(
        string Id,
        string Version,
        string Date,
        string Title,
        string Summary,
        string ImpactType,
        string UserBenefit,
        string BusinessImpact,
        ReleaseMetric[]? Metrics,
        string[] KeyChanges
    );

    private static readonly ReleaseUpdate[] _releases =
    [
        new("r1", "v3.2.0", "2026-03-30",
            "Faster Checkout Experience",
            "We've streamlined the checkout process to reduce friction and increase conversion rates.",
            "revenue",
            "Customers can complete purchases 40% faster with one-click payment options and auto-filled shipping addresses.",
            "Projected 15% increase in checkout completion rate, estimated additional $2.3M ARR from reduced cart abandonment.",
            [
                new("Checkout Time", "-40%", "down"),
                new("Conversion Rate", "+15%", "up"),
                new("Cart Abandonment", "-22%", "down"),
            ],
            [
                "One-click payment integration with saved cards",
                "Smart address auto-complete using Google Maps API",
                "Mobile-optimized payment form with Apple Pay and Google Pay",
            ]
        ),
        new("r2", "v3.1.5", "2026-03-28",
            "Enhanced Security & Compliance",
            "Critical security updates to protect customer data and maintain SOC 2 compliance.",
            "security",
            "Your data is more secure with industry-leading encryption and fraud detection systems protecting every transaction.",
            "Maintains SOC 2 Type II certification required for enterprise contracts, reduces fraud losses by estimated $180K annually.",
            [
                new("Fraud Detection", "+35%", "up"),
                new("Compliance Score", "100%", "neutral"),
            ],
            [
                "Implemented end-to-end encryption for payment data",
                "Added real-time fraud detection with machine learning",
                "Automated compliance reporting for SOC 2 audits",
            ]
        ),
        new("r3", "v3.1.0", "2026-03-25",
            "AI-Powered Search & Recommendations",
            "Intelligent search that understands what customers are looking for and suggests relevant products.",
            "user_experience",
            "Find products faster with natural language search and personalized recommendations based on your preferences.",
            "Early data shows 28% increase in average order value from improved product discovery and cross-sell recommendations.",
            [
                new("Search Accuracy", "+42%", "up"),
                new("Avg Order Value", "+28%", "up"),
                new("Time to Purchase", "-18%", "down"),
            ],
            [
                "Natural language processing for search queries",
                "Personalized product recommendations engine",
                "Similar items suggestion based on browsing history",
            ]
        ),
        new("r4", "v3.0.8", "2026-03-22",
            "50% Faster Page Load Times",
            "Major performance improvements make the entire platform feel faster and more responsive.",
            "performance",
            "Pages load twice as fast, making browsing smooth and enjoyable even on slower connections.",
            "Page speed is a Google ranking factor - faster sites see 10-15% organic traffic increase. Reduced server costs by 30%.",
            [
                new("Page Load Time", "-50%", "down"),
                new("Server Costs", "-30%", "down"),
                new("Mobile Experience", "+65%", "up"),
            ],
            [
                "Optimized image delivery with WebP format and CDN",
                "Implemented code splitting for faster initial page loads",
                "Reduced server resources through efficient caching",
            ]
        ),
    ];

    private string? _expandedRelease;

    private void ToggleRelease(string id)
    {
        _expandedRelease = _expandedRelease == id ? null : id;
    }

    private RenderFragment GetImpactIcon(string impactType) => impactType switch
    {
        "revenue"        => @<LucideIconCn Name="dollar-sign" Size="16" Class="size-4 text-emerald-500" />,
        "performance"    => @<LucideIconCn Name="zap" Size="16" Class="size-4 text-amber-500" />,
        "security"       => @<LucideIconCn Name="shield-check" Size="16" Class="size-4 text-blue-500" />,
        "user_experience"=> @<LucideIconCn Name="sparkles" Size="16" Class="size-4 text-purple-500" />,
        "compliance"     => @<LucideIconCn Name="shield-check" Size="16" Class="size-4 text-blue-500" />,
        _                => @<span></span>,
    };

    private RenderFragment GetImpactBadge(string impactType)
    {
        var (cls, label) = impactType switch
        {
            "revenue"         => ("bg-emerald-500/10 text-emerald-500", "Revenue Impact"),
            "performance"     => ("bg-amber-500/10 text-amber-500", "Performance"),
            "security"        => ("bg-blue-500/10 text-blue-500", "Security"),
            "user_experience" => ("bg-purple-500/10 text-purple-500", "User Experience"),
            "compliance"      => ("bg-blue-500/10 text-blue-500", "Compliance"),
            _                 => ("", impactType),
        };
        return @<BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("border-0", cls)">@label</BadgeCn>;
    }
}
