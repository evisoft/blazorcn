@* ============================================================
   Block: changelog-event-stream
   Title: ChangelogEventStream
   Description: A real-time event stream changelog with live status indicators, message types, and auto-scrolling functionality built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-event-stream.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="text-sm font-medium">Event Stream</h2>
                <p class="mt-0.5 text-xs text-muted-foreground">Real-time deployment activity</p>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-2 text-xs" OnClick="@(() => _isPaused = !_isPaused)">
                    @if (_isPaused)
                    {
                        <LucideIconCn Name="play" Size="12" Class="size-3" />
                        @("Resume")
                    }
                    else
                    {
                        <LucideIconCn Name="pause" Size="12" Class="size-3" />
                        @("Pause")
                    }
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-2 text-xs">
                    <LucideIconCn Name="download" Size="12" Class="size-3" />
                    Export
                </ButtonCn>
            </div>
        </div>

        <div class="h-[700px] overflow-y-auto scroll-smooth px-4 py-3">
            <div class="space-y-2">
                @foreach (var evt in _events)
                {
                    var config = _eventConfig[evt.Type];
                    var dotClass = Cn.Merge("size-1.5 shrink-0 rounded-full", config.DotColor);
                    var iconClass = Cn.Merge("size-3.5", config.TextColor);
                    <div class="flex gap-3 rounded-md p-2 hover:bg-muted/50">
                        <div class="flex shrink-0 items-start gap-2 pt-0.5">
                            <span class="@dotClass"></span>
                            <LucideIconCn Name="@config.IconName" Size="14" Class="@iconClass" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-start justify-between gap-2">
                                <p class="text-sm">@evt.Message</p>
                                <span class="shrink-0 font-mono text-xs text-muted-foreground">@evt.Timestamp</span>
                            </div>
                            @if (!string.IsNullOrEmpty(evt.Details))
                            {
                                <p class="mt-0.5 font-mono text-xs text-muted-foreground">@evt.Details</p>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-t px-4 py-2">
            <div class="flex items-center justify-between text-xs text-muted-foreground">
                <span>@_events.Length events</span>
                <div class="flex items-center gap-3">
                    <div class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span>Live</span>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private bool _isPaused = false;

    private record StreamEvent(string Id, string Type, string Message, string Timestamp, string? Details = null);

    private record EventConfig(string IconName, string DotColor, string TextColor);

    private static readonly Dictionary<string, EventConfig> _eventConfig = new()
    {
        ["info"]    = new("info",           "bg-blue-500",    "text-blue-500"),
        ["success"] = new("check-circle-2", "bg-emerald-500", "text-emerald-500"),
        ["warning"] = new("alert-triangle", "bg-amber-500",   "text-amber-500"),
        ["error"]   = new("x-circle",       "bg-red-500",     "text-red-500"),
    };

    private static readonly StreamEvent[] _events =
    [
        new("1",  "info",    "Deployment initiated for production environment", "14:32:01", "Target: us-east-1"),
        new("2",  "info",    "Building Docker image from latest commit",        "14:32:03", "Commit: a3f9c2d"),
        new("3",  "success", "Image built successfully (2.3s)",                 "14:32:05"),
        new("4",  "info",    "Pushing image to container registry",             "14:32:06"),
        new("5",  "success", "Image pushed to registry",                        "14:32:12", "Size: 142.5 MB"),
        new("6",  "info",    "Updating Kubernetes deployment",                  "14:32:14"),
        new("7",  "warning", "Pod replica count reduced temporarily",           "14:32:16", "Replicas: 3 → 2"),
        new("8",  "success", "New pods created successfully",                   "14:32:22"),
        new("9",  "success", "Health checks passing on all pods",               "14:32:28"),
        new("10", "success", "Deployment completed successfully",               "14:32:30", "Duration: 29s"),
    ];
}
