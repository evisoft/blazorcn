@* ============================================================
   Block: changelog-incident-severity
   Title: ChangelogIncidentSeverity
   Description: Track incidents grouped by severity level (P0-P4) with MTTR metrics and resolution timelines. Built with React, Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-incident-severity.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Incident Log</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_filteredIncidents.Length incidents · MTTR @_mttr min
                    </p>
                </div>
                <LucideIconCn Name="alert-circle" Size="16" Class="size-4 text-muted-foreground/60" />
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex gap-2">
                <select @bind="_severityFilter"
                    aria-label="Filter incidents by severity"
                    class="h-8 w-[120px] rounded-md border border-input bg-background px-2 text-xs focus:outline-none">
                    <option value="all">All severity</option>
                    <option value="P0">P0 - Critical</option>
                    <option value="P1">P1 - Major</option>
                    <option value="P2">P2 - Moderate</option>
                    <option value="P3">P3 - Minor</option>
                    <option value="P4">P4 - Trivial</option>
                </select>
                <select @bind="_statusFilter"
                    aria-label="Filter incidents by status"
                    class="h-8 w-[120px] rounded-md border border-input bg-background px-2 text-xs focus:outline-none">
                    <option value="all">All status</option>
                    <option value="investigating">Investigating</option>
                    <option value="identified">Identified</option>
                    <option value="monitoring">Monitoring</option>
                    <option value="resolved">Resolved</option>
                </select>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="ml-auto h-7 text-xs">
                    New incident
                </ButtonCn>
            </div>
        </div>

        <div class="divide-y">
            @foreach (var incident in _filteredIncidents)
            {
                var isExpanded = _expandedId == incident.Id;
                var config = GetSeverityConfig(incident.Severity);
                var iconContainerClass = Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-md", config.Bg);
                var iconClass = Cn.Merge("size-4", config.Color);
                var chevronClass = Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
                var badgeClass = Cn.Merge("font-mono text-xs", config.Border, config.Bg, config.Color);
                var item = incident;
                <div>
                    <button type="button"
                        @onclick="@(() => ToggleExpanded(item.Id))"
                        class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="@iconContainerClass">
                            <LucideIconCn Name="@config.IconName" Size="16" Class="@iconClass" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <BadgeCn Variant="BadgeVariant.Outline" Class="@badgeClass">@item.Severity</BadgeCn>
                                        <span class="text-sm font-medium">@item.Title</span>
                                    </div>
                                    <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
                                        <span class="flex items-center gap-1">
                                            <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                            @item.DetectedAt
                                        </span>
                                        <span class="flex items-center gap-1">
                                            <LucideIconCn Name="users" Size="12" Class="size-3" />
                                            @item.AffectedUsers.ToString("N0") users
                                        </span>
                                        <span>@item.Duration</span>
                                        @if (item.Status == "resolved")
                                        {
                                            <span class="flex items-center gap-1 text-emerald-600">
                                                <LucideIconCn Name="check-circle-2" Size="12" Class="size-3" />
                                                Resolved
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="flex items-center gap-1 capitalize">
                                                <span class="size-1.5 animate-pulse rounded-full bg-blue-500"></span>
                                                @item.Status
                                            </span>
                                        }
                                    </div>
                                    <div class="mt-2 flex items-center gap-1.5">
                                        @foreach (var service in item.Services.Take(3))
                                        {
                                            <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">@service</BadgeCn>
                                        }
                                        @if (item.Services.Length > 3)
                                        {
                                            <span class="text-xs text-muted-foreground">+@(item.Services.Length - 3) more</span>
                                        }
                                    </div>
                                </div>
                                <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                            </div>
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/30 px-4 py-3">
                            <div class="space-y-3 pl-11">
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <p class="text-xs font-medium text-muted-foreground">Detected</p>
                                        <p class="mt-1 text-sm">@item.DetectedAt</p>
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.ResolvedAt))
                                    {
                                        <div>
                                            <p class="text-xs font-medium text-muted-foreground">Resolved</p>
                                            <p class="mt-1 text-sm">@item.ResolvedAt</p>
                                        </div>
                                    }
                                    <div>
                                        <p class="text-xs font-medium text-muted-foreground">Owner</p>
                                        <p class="mt-1 text-sm">@item.Owner</p>
                                    </div>
                                    <div>
                                        <p class="text-xs font-medium text-muted-foreground">Duration</p>
                                        <p class="mt-1 text-sm font-medium tabular-nums">@item.Duration</p>
                                    </div>
                                </div>
                                <div>
                                    <p class="text-xs font-medium text-muted-foreground">Affected services</p>
                                    <div class="mt-2 flex flex-wrap gap-1.5">
                                        @foreach (var service in item.Services)
                                        {
                                            <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">@service</BadgeCn>
                                        }
                                    </div>
                                </div>
                                <div class="flex gap-2">
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">View timeline</ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">Post mortem</ButtonCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record SeverityConfig(string Label, string Color, string Bg, string Border, string IconName);

    private record Incident(
        string Id,
        string Title,
        string Severity,
        string Status,
        int AffectedUsers,
        string DetectedAt,
        string? ResolvedAt,
        string Duration,
        string Owner,
        string[] Services
    );

    private string _severityFilter = "all";
    private string _statusFilter = "all";
    private string? _expandedId;

    private Incident[] _filteredIncidents => _incidents
        .Where(i =>
            (_severityFilter == "all" || i.Severity == _severityFilter) &&
            (_statusFilter == "all" || i.Status == _statusFilter))
        .ToArray();

    private int _mttr
    {
        get
        {
            var resolved = _incidents.Where(i => i.ResolvedAt != null).ToArray();
            if (resolved.Length == 0) return 0;
            var total = resolved.Sum(i => ParseDurationLeadingMinutes(i.Duration));
            return (int)Math.Round((double)total / resolved.Length);
        }
    }

    private static int ParseDurationLeadingMinutes(string duration)
    {
        // Mirrors JS parseInt: take only the leading digits from the first space-separated token.
        // "18 min" -> 18, "3h 20min" -> 3, "45 min" -> 45, "1h 15min" -> 1
        var first = duration.Split(' ')[0];
        var digits = new string(first.TakeWhile(char.IsDigit).ToArray());
        return int.TryParse(digits, out var n) ? n : 0;
    }

    private void ToggleExpanded(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private static SeverityConfig GetSeverityConfig(string severity) => severity switch
    {
        "P0" => new("Critical",  "text-red-600",            "bg-red-500/10",    "border-red-500/20",    "x-circle"),
        "P1" => new("Major",     "text-orange-600",         "bg-orange-500/10", "border-orange-500/20", "triangle-alert"),
        "P2" => new("Moderate",  "text-amber-600",          "bg-amber-500/10",  "border-amber-500/20",  "alert-circle"),
        "P3" => new("Minor",     "text-blue-600",           "bg-blue-500/10",   "border-blue-500/20",   "info"),
        "P4" => new("Trivial",   "text-muted-foreground",   "bg-muted/50",      "border-muted",         "info"),
        _    => new("Unknown",   "text-muted-foreground",   "bg-muted/50",      "border-muted",         "info"),
    };

    private static readonly Incident[] _incidents =
    [
        new("inc-1", "Complete API service outage - upstream dependency failure",
            "P0", "resolved",       45230, "Mar 28, 14:23", "Mar 28, 14:41", "18 min",    "Platform SRE",   ["API", "Auth", "Database"]),
        new("inc-2", "Database replication lag causing stale data reads",
            "P1", "monitoring",     12400, "Mar 29, 09:15", null,            "3h 42min",  "Database Team",  ["Database", "Cache"]),
        new("inc-3", "Payment gateway timeout for enterprise accounts",
            "P2", "identified",       340, "Mar 30, 11:20", null,            "45 min",    "Payments Team",  ["Stripe", "Billing"]),
        new("inc-4", "Email notification delays in APAC region",
            "P2", "resolved",        5600, "Mar 27, 22:10", "Mar 28, 01:30", "3h 20min",  "Messaging Team", ["Email", "Queue"]),
        new("inc-5", "CDN cache invalidation not propagating to edge nodes",
            "P3", "investigating",    890, "Mar 30, 13:45", null,            "1h 15min",  "Infrastructure", ["CDN"]),
        new("inc-6", "Dashboard chart rendering issue on Safari",
            "P4", "resolved",         120, "Mar 29, 16:30", "Mar 29, 17:15", "45 min",    "Frontend Team",  ["Web App"]),
    ];
}
