@* ============================================================
   Block: changelog-split-view
   Title: ChangelogSplitView
   Description: React split view changelog block for Next.js with date sidebar, change details panel, and active state highlighting built with TypeScript, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-split-view.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="layout-panel-left" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Changelog</span>
        </div>

        @* Split layout *@
        <div class="flex flex-col md:flex-row">

            @* Date sidebar *@
            <div class="shrink-0 border-b md:w-44 md:border-r md:border-b-0">
                <div class="flex md:flex-col">
                    @for (var i = 0; i < _dateEntries.Length; i++)
                    {
                        var index = i;
                        var entry = _dateEntries[i];
                        var isSelected = _selectedIndex == index;
                        var isNotLast = index < _dateEntries.Length - 1;
                        <button type="button"
                                class="@Cn.Merge("flex-1 px-4 py-2.5 text-left text-xs transition-colors md:flex-none",
                                    isSelected ? "bg-muted/50 font-medium text-foreground" : "text-muted-foreground hover:bg-muted/30",
                                    isNotLast ? "border-r md:border-r-0 md:border-b" : "")"
                                @onclick="@(() => _selectedIndex = index)"
                                aria-current="@(isSelected ? "true" : null)">
                            <span class="block md:hidden">@entry.ShortDate</span>
                            <span class="hidden md:block">@entry.Date</span>
                            <span class="mt-0.5 block text-muted-foreground/60 text-[10px]">
                                @entry.Changes.Length changes
                            </span>
                        </button>
                    }
                </div>
            </div>

            @* Content panel *@
            <div class="min-w-0 flex-1">
                @{
                    var selected = _dateEntries[_selectedIndex];
                }
                @for (var i = 0; i < selected.Changes.Length; i++)
                {
                    var change = selected.Changes[i];
                    var isNotLast = i < selected.Changes.Length - 1;
                    <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3", isNotLast ? "border-b" : "")">
                        <span class="@Cn.Merge("mt-1.5 size-2 shrink-0 rounded-full", _dotColors[change.Category])"
                              aria-hidden="true"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@change.Title</span>
                                <span class="text-muted-foreground/60 text-[10px] capitalize">@change.Category</span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@change.Description</p>
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
</section>

@code {
    private record Change(string Title, string Description, string Category);
    private record DateEntry(string Date, string ShortDate, Change[] Changes);

    private int _selectedIndex = 0;

    private static readonly Dictionary<string, string> _dotColors = new()
    {
        ["added"] = "bg-emerald-500",
        ["fixed"] = "bg-red-500",
        ["improved"] = "bg-blue-500",
    };

    private static readonly DateEntry[] _dateEntries =
    [
        new("March 28, 2026", "Mar 28",
        [
            new("Team workspaces",
                "Create shared workspaces with role-based access for team members. Supports viewer, editor, and admin roles.",
                "added"),
            new("Real-time presence",
                "See who is online and what page they are viewing across your workspace.",
                "added"),
            new("Dashboard load time",
                "Streaming SSR now loads the dashboard 40% faster on initial page visit.",
                "improved"),
        ]),
        new("March 25, 2026", "Mar 25",
        [
            new("OAuth redirect loop",
                "Fixed an infinite redirect when SAML assertions contained multi-value role attributes.",
                "fixed"),
            new("Sidebar persistence",
                "Collapse state now saves to localStorage and restores across browser sessions.",
                "fixed"),
        ]),
        new("March 22, 2026", "Mar 22",
        [
            new("API key management",
                "Generate scoped API keys with read, write, or admin permissions from the settings panel.",
                "added"),
            new("Search indexing speed",
                "Full-text search indexing reduced from 8 seconds to under 2 seconds per document.",
                "improved"),
            new("Timezone calculations",
                "Fixed UTC offset errors for negative timezone regions in the scheduling module.",
                "fixed"),
        ]),
        new("March 18, 2026", "Mar 18",
        [
            new("Custom theme editor",
                "Design color themes with HSL sliders and export as CSS variables for your project.",
                "added"),
            new("Bundle size reduction",
                "Tree-shaking improvements reduced the client bundle by 18% across all pages.",
                "improved"),
        ]),
    ];
}
