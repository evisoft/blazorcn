@* ============================================================
   Block: changelog-load-test-results
   Title: ChangelogLoadTestResults
   Description: A changelog block displaying load test performance metrics with RPS, latency percentiles (p50/p95/p99), and error thresholds built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-load-test-results.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Load Test Results</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Performance metrics across releases
                    </p>
                </div>
                <LucideIconCn Name="activity" Size="16" Class="size-4 text-muted-foreground" />
            </div>
        </div>

        @* Summary stats *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-4 gap-4">
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="zap" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Avg RPS</span>
                    </div>
                    <p class="mt-1 font-semibold tabular-nums text-2xl">11.7K</p>
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Avg p99</span>
                    </div>
                    <p class="mt-1 font-semibold tabular-nums text-2xl">421ms</p>
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="alert-triangle" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Error Rate</span>
                    </div>
                    <p class="mt-1 font-semibold tabular-nums text-2xl">0.29%</p>
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Pass Rate</span>
                    </div>
                    <p class="mt-1 font-semibold tabular-nums text-2xl">60%</p>
                </div>
            </div>
        </div>

        @* Metric rows *@
        <div>
            @for (var idx = 0; idx < _metrics.Length; idx++)
            {
                var metric = _metrics[idx];
                var isExpanded = _expandedId == metric.Id;
                var captured = metric;
                var rowBorderClass = idx < _metrics.Length - 1 ? "border-b" : "";
                var chevronClass = Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
                var statusIconClass = Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-md", GetStatusColor(captured.Status));
                var rpsChangeClass = Cn.Merge("flex items-center gap-0.5 text-xs", captured.RpsChange > 0 ? "text-emerald-600" : "text-red-600");

                <div class="@rowBorderClass">
                    <button
                        type="button"
                        @onclick="@(() => ToggleExpanded(captured.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="@statusIconClass">
                            <LucideIconCn Name="@GetStatusIconName(captured.Status)" Size="16" Class="size-4" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@captured.Version</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 border-0 bg-muted/50 px-1.5 text-[10px]">
                                    @GetStatusBadge(captured.Status)
                                </BadgeCn>
                                @if (captured.RpsChange != 0)
                                {
                                    <div class="@rpsChangeClass">
                                        @if (captured.RpsChange > 0)
                                        {
                                            <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                                        }
                                        else
                                        {
                                            <LucideIconCn Name="trending-down" Size="12" Class="size-3" />
                                        }
                                        <span class="tabular-nums">@(Math.Abs(captured.RpsChange))%</span>
                                    </div>
                                }
                            </div>
                            <div class="mt-0.5 flex items-center gap-3 text-xs text-muted-foreground">
                                <span class="tabular-nums">@(captured.Rps.ToString("N0")) RPS</span>
                                <span>&bull;</span>
                                <span class="tabular-nums">p99: @(captured.P99)ms</span>
                                <span>&bull;</span>
                                <span class="tabular-nums">@captured.Date</span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                    </button>

                    @if (isExpanded)
                    {
                        var errorRateClass = Cn.Merge("font-medium tabular-nums text-sm", captured.ErrorRate > 1 ? "text-red-600" : captured.ErrorRate > 0.1 ? "text-amber-600" : "");
                        <div class="border-t bg-muted/30 px-4 py-3">
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <span class="text-xs font-medium text-muted-foreground">
                                        Latency Distribution
                                    </span>
                                    <div class="mt-2 space-y-2">
                                        <div class="flex items-center justify-between">
                                            <span class="text-xs text-muted-foreground">p50 (median)</span>
                                            <span class="font-medium tabular-nums text-sm">@(captured.P50)ms</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-xs text-muted-foreground">p95</span>
                                            <span class="font-medium tabular-nums text-sm">@(captured.P95)ms</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-xs text-muted-foreground">p99</span>
                                            <span class="font-medium tabular-nums text-sm">@(captured.P99)ms</span>
                                        </div>
                                    </div>
                                </div>
                                <div>
                                    <span class="text-xs font-medium text-muted-foreground">
                                        Test Details
                                    </span>
                                    <div class="mt-2 space-y-2">
                                        <div class="flex items-center justify-between">
                                            <span class="text-xs text-muted-foreground">Duration</span>
                                            <span class="font-medium tabular-nums text-sm">@captured.Duration</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-xs text-muted-foreground">Error Rate</span>
                                            <span class="@errorRateClass">@(captured.ErrorRate)%</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-xs text-muted-foreground">Requests/sec</span>
                                            <span class="font-medium tabular-nums text-sm">@(captured.Rps.ToString("N0"))</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-xs text-muted-foreground">
                    5 test runs &bull; Last updated 2 hours ago
                </span>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="h-7 gap-1.5 px-2 text-xs">
                    View Full Report
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record LoadTestMetric(
        string Id,
        string Version,
        string Date,
        int Rps,
        double RpsChange,
        int P50,
        int P95,
        int P99,
        double ErrorRate,
        string Duration,
        string Status
    );

    private string? _expandedId = null;

    private void ToggleExpanded(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private static string GetStatusColor(string status) => status switch
    {
        "passed"  => "text-emerald-600",
        "warning" => "text-amber-600",
        "failed"  => "text-red-600",
        _         => "",
    };

    private static string GetStatusIconName(string status) => status switch
    {
        "passed"  => "check-circle-2",
        "warning" => "alert-triangle",
        "failed"  => "alert-triangle",
        _         => "alert-triangle",
    };

    private static string GetStatusBadge(string status) => status switch
    {
        "passed"  => "Passed",
        "warning" => "Warning",
        "failed"  => "Failed",
        _         => status,
    };

    private static readonly LoadTestMetric[] _metrics =
    [
        new("1", "v2.4.0", "2026-03-28", 12450,  8.2, 42, 156, 312, 0.02, "10m", "passed"),
        new("2", "v2.3.1", "2026-03-25", 11520, -2.1, 45, 168, 425, 0.15, "10m", "warning"),
        new("3", "v2.3.0", "2026-03-22", 11760, 15.3, 38, 142, 278, 0.01, "10m", "passed"),
        new("4", "v2.2.5", "2026-03-18", 10200,-18.5, 62, 245, 892, 1.24, "10m", "failed"),
        new("5", "v2.2.4", "2026-03-15", 12520,  5.1, 40, 152, 298, 0.03, "10m", "passed"),
    ];
}
