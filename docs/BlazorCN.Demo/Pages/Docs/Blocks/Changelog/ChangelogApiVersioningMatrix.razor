@* ============================================================
   Block: changelog-api-versioning-matrix
   Title: ChangelogApiVersioningMatrix
   Description: API version compatibility matrix with supported/deprecated status indicators, built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-api-versioning-matrix.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="info" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">API Version Compatibility</h2>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                @_apiVersions.Count(v => v.Status == "supported") Active
            </BadgeCn>
        </div>

        @* Matrix *@
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="border-b bg-muted/50">
                        <th class="px-4 py-3 text-left text-xs font-medium text-muted-foreground">
                            Version
                        </th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-muted-foreground">
                            Status
                        </th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-muted-foreground">
                            Release Date
                        </th>
                        @foreach (var feature in _featureNames)
                        {
                            <th class="px-4 py-3 text-center text-xs font-medium text-muted-foreground">
                                @feature.Label
                            </th>
                        }
                        <th class="px-4 py-3 text-left text-xs font-medium text-muted-foreground">
                            End of Life
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var version in _apiVersions)
                    {
                        <tr class="border-b last:border-0 transition-colors hover:bg-muted/50">
                            <td class="px-4 py-3">
                                <span class="font-mono text-sm font-medium">@version.Version</span>
                            </td>
                            <td class="px-4 py-3">
                                <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("gap-1 text-xs", GetStatusColor(version.Status))">
                                    @switch (version.Status)
                                    {
                                        case "supported":
                                            <LucideIconCn Name="check-circle-2" Size="12" Class="size-3" />
                                            break;
                                        case "deprecated":
                                            <LucideIconCn Name="alert-triangle" Size="12" Class="size-3" />
                                            break;
                                        case "end-of-life":
                                            <LucideIconCn Name="x-circle" Size="12" Class="size-3" />
                                            break;
                                    }
                                    @version.Status.Replace("-", " ")
                                </BadgeCn>
                            </td>
                            <td class="px-4 py-3 text-sm text-muted-foreground">@version.ReleaseDate</td>
                            @foreach (var feature in _featureNames)
                            {
                                var supported = feature.Get(version);
                                <td class="px-4 py-3 text-center">
                                    @if (supported)
                                    {
                                        <LucideIconCn Name="check-circle-2" Size="16" Class="mx-auto size-4 text-emerald-500" />
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="x-circle" Size="16" Class="mx-auto size-4 text-muted-foreground/30" />
                                    }
                                </td>
                            }
                            <td class="px-4 py-3 text-sm text-muted-foreground">
                                @(version.EndOfLife ?? "—")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Legend *@
        <div class="flex items-center gap-4 border-t px-4 py-3">
            <span class="text-xs text-muted-foreground">Status:</span>
            <div class="flex items-center gap-1">
                <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-500" />
                <span class="text-xs text-muted-foreground">Supported</span>
            </div>
            <div class="flex items-center gap-1">
                <LucideIconCn Name="alert-triangle" Size="12" Class="size-3 text-amber-500" />
                <span class="text-xs text-muted-foreground">Deprecated</span>
            </div>
            <div class="flex items-center gap-1">
                <LucideIconCn Name="x-circle" Size="12" Class="size-3 text-red-500" />
                <span class="text-xs text-muted-foreground">End of Life</span>
            </div>
        </div>

    </div>
</section>

@code {
    private record ApiVersionFeatures(bool RestApi, bool GraphQL, bool Webhooks, bool RateLimiting);

    private record ApiVersionData(
        string Version,
        string Status,
        string ReleaseDate,
        string? EndOfLife,
        ApiVersionFeatures Features
    );

    private record FeatureDef(string Key, string Label, Func<ApiVersionData, bool> Get);

    private static string GetStatusColor(string status) => status switch
    {
        "supported"  => "bg-emerald-500/10 text-emerald-500",
        "deprecated" => "bg-amber-500/10 text-amber-500",
        "end-of-life" => "bg-red-500/10 text-red-500",
        _ => ""
    };

    private static readonly FeatureDef[] _featureNames =
    [
        new("restApi",      "REST API",      v => v.Features.RestApi),
        new("graphql",      "GraphQL",       v => v.Features.GraphQL),
        new("webhooks",     "Webhooks",      v => v.Features.Webhooks),
        new("rateLimiting", "Rate Limiting", v => v.Features.RateLimiting),
    ];

    private static readonly ApiVersionData[] _apiVersions =
    [
        new("v4.0", "supported",   "2026-03-01", null,
            new(true,  true,  true,  true)),
        new("v3.2", "supported",   "2025-11-15", "2026-11-15",
            new(true,  true,  true,  true)),
        new("v3.1", "deprecated",  "2025-06-20", "2026-06-20",
            new(true,  true,  false, true)),
        new("v3.0", "deprecated",  "2025-01-10", "2026-01-10",
            new(true,  false, false, true)),
        new("v2.5", "end-of-life", "2024-08-05", "2025-08-05",
            new(true,  false, false, false)),
    ];
}
