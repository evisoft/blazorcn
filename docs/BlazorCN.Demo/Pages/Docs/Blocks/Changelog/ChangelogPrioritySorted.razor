@* ============================================================
   Block: changelog-priority-sorted
   Title: ChangelogPrioritySorted
   Description: React priority sorted changelog block for Next.js with color-coded impact levels, left border accents for critical through low severity, and sorted entry display built with TypeScript, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-priority-sorted.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="arrow-down-wide-narrow" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Changelog — By Priority</h2>
            <span class="ml-auto text-xs text-muted-foreground">@_entries.Length entries</span>
        </div>

        <div class="flex items-center gap-4 border-b px-4 py-2">
            @foreach (var level in _priorityLevels)
            {
                var cfg = _priorityConfig[level];
                <div class="flex items-center gap-1.5">
                    <span class="@($"size-1.5 rounded-full {cfg.Dot}")"></span>
                    <span class="text-xs text-muted-foreground">@cfg.Label</span>
                </div>
            }
        </div>

        <div>
            @for (var i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                var cfg = _priorityConfig[entry.Priority];
                var lastBorder = i == _entries.Length - 1 ? "" : "border-b";
                <div class="@($"border-l-2 {cfg.Border} {lastBorder} px-4 py-3")">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@($"text-xs font-medium {cfg.Text}")">@cfg.Label</span>
                                <span class="text-xs text-muted-foreground">&middot;</span>
                                <span class="font-mono text-xs text-muted-foreground">v@entry.Version</span>
                            </div>
                            <p class="mt-1 text-sm font-medium">@entry.Title</p>
                            <p class="mt-0.5 text-xs text-muted-foreground">@entry.Description</p>
                        </div>
                        <span class="shrink-0 text-xs text-muted-foreground">@entry.Date</span>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ChangelogEntry(string Id, string Title, string Description, string Version, string Date, string Priority);

    private record PriorityConfig(string Label, string Border, string Dot, string Text);

    private static readonly string[] _priorityLevels = ["critical", "high", "medium", "low"];

    private static readonly Dictionary<string, PriorityConfig> _priorityConfig = new()
    {
        ["critical"] = new("Critical", "border-red-500", "bg-red-500", "text-red-600 dark:text-red-400"),
        ["high"]     = new("High",     "border-amber-500", "bg-amber-500", "text-amber-600 dark:text-amber-400"),
        ["medium"]   = new("Medium",   "border-blue-500", "bg-blue-500", "text-blue-600 dark:text-blue-400"),
        ["low"]      = new("Low",      "border-muted-foreground/30", "bg-muted-foreground/40", "text-muted-foreground"),
    };

    private static readonly ChangelogEntry[] _entries =
    [
        new("1", "Fixed data loss on concurrent writes to shared documents",
            "Race condition in the real-time sync engine caused silent overwrites when two users edited the same field within 50ms.",
            "3.8.1", "Mar 28", "critical"),
        new("2", "Patched authentication bypass via expired refresh tokens",
            "Expired refresh tokens were not properly invalidated, allowing continued API access after session revocation.",
            "3.8.1", "Mar 28", "critical"),
        new("3", "Resolved memory leak in WebSocket connection pool",
            "Long-running connections accumulated orphaned listeners, causing gradual memory growth over 24-hour periods.",
            "3.8.0", "Mar 26", "high"),
        new("4", "Fixed incorrect timezone handling in scheduled reports",
            "Reports scheduled in non-UTC timezones fired at wrong times during DST transitions.",
            "3.8.0", "Mar 26", "high"),
        new("5", "Added bulk export for audit log entries",
            "New CSV and JSON export options for audit logs with date range and actor filtering.",
            "3.7.4", "Mar 24", "medium"),
        new("6", "Improved dashboard load time by 35 percent",
            "Optimized initial query bundle and deferred non-critical widget data to lazy loading.",
            "3.7.4", "Mar 24", "medium"),
        new("7", "Updated tooltip positioning on narrow viewports",
            "Tooltips now flip to the opposite side when clipped by the viewport edge.",
            "3.7.3", "Mar 22", "low"),
        new("8", "Corrected typo in onboarding welcome message",
            "Fixed spelling of configuration in the setup wizard step 3 description.",
            "3.7.3", "Mar 22", "low"),
    ];
}
