@* ============================================================
   Block: changelog-inline-code
   Title: ChangelogInlineCode
   Description: React inline code changelog block for Next.js with developer-focused entries featuring monospace code styling, syntax-highlighted terms, and technical detail built with TypeScript, Framer Motion, and Tailwind CSS.
   Source: original/blocks/changelog/changelog-inline-code.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="terminal" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">API Changelog</h2>
            <span class="ml-auto font-mono text-xs text-muted-foreground">v2.8.0</span>
        </div>

        <div>
            @foreach (var entry in _entries)
            {
                var dotClass = Cn.Merge("mt-1 size-1.5 shrink-0 rounded-full", GetDotColor(entry.Category));
                <div class="px-4 py-3 transition-colors hover:bg-muted/50 border-b last:border-b-0">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@dotClass"></span>
                                <span class="text-sm font-medium leading-snug">@((MarkupString)entry.TitleHtml)</span>
                            </div>
                            <p class="mt-1 pl-3.5 text-xs text-muted-foreground leading-relaxed">@((MarkupString)entry.DescriptionHtml)</p>
                        </div>
                        <span class="shrink-0 pt-0.5 text-xs text-muted-foreground">@entry.Date</span>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Entry(string TitleHtml, string DescriptionHtml, string Date, string Category);

    private static string GetDotColor(string category) => category switch
    {
        "feature"     => "bg-emerald-500",
        "fix"         => "bg-red-500",
        "improvement" => "bg-blue-500",
        "deprecation" => "bg-amber-500",
        _             => "",
    };

    private const string C = "rounded bg-muted px-1 py-0.5 font-mono text-xs";

    private static readonly Entry[] _entries =
    [
        new(
            $"Added <code class=\"{C}\">GET /api/v2/workspaces</code> endpoint",
            $"New REST endpoint returns paginated workspace list with optional <code class=\"{C}\">include=members</code> query parameter for eager loading team data.",
            "Mar 28",
            "feature"
        ),
        new(
            $"Fixed <code class=\"{C}\">onAuthStateChange</code> memory leak",
            $"Resolved a listener accumulation issue where <code class=\"{C}\">onAuthStateChange</code> callbacks were not properly unsubscribed on component unmount, causing gradual memory growth in long-running sessions.",
            "Mar 26",
            "fix"
        ),
        new(
            $"Improved <code class=\"{C}\">batch_size</code> default for bulk imports",
            $"Default <code class=\"{C}\">batch_size</code> increased from <code class=\"{C}\">100</code> to <code class=\"{C}\">500</code> for the <code class=\"{C}\">POST /api/v2/import</code> endpoint. Reduces total request count by 80% for large datasets.",
            "Mar 24",
            "improvement"
        ),
        new(
            $"Deprecated <code class=\"{C}\">X-Api-Key</code> header authentication",
            $"Token-based auth via <code class=\"{C}\">X-Api-Key</code> header is deprecated. Migrate to <code class=\"{C}\">Authorization: Bearer</code> with OAuth 2.0 tokens before June 2026.",
            "Mar 22",
            "deprecation"
        ),
        new(
            $"Added <code class=\"{C}\">retry_policy</code> to webhook configuration",
            $"Webhook configs now accept a <code class=\"{C}\">retry_policy</code> object with <code class=\"{C}\">max_attempts</code>, <code class=\"{C}\">backoff_multiplier</code>, and <code class=\"{C}\">timeout_ms</code> fields for granular delivery control.",
            "Mar 20",
            "feature"
        ),
        new(
            $"Fixed <code class=\"{C}\">cursor</code> pagination returning duplicate rows",
            $"Resolved an edge case where <code class=\"{C}\">cursor</code>-based pagination on the <code class=\"{C}\">/api/v2/events</code> endpoint would return overlapping results when events shared identical timestamps.",
            "Mar 18",
            "fix"
        ),
    ];
}
