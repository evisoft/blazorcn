@* ============================================================
   Block: changelog-dark-light-toggle
   Title: ChangelogDarkLightToggle
   Description: React theme-aware changelog block for Next.js with inline dark/light mode toggle, adaptive color tokens, and smooth theme transitions built with shadcn/ui, Tailwind CSS, and Framer Motion animations.
   Source: original/blocks/changelog/changelog-dark-light-toggle.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="@Cn.Merge("overflow-hidden rounded-lg border transition-colors duration-200", _isDark ? "border-zinc-700 bg-zinc-900 text-zinc-100" : "bg-card")">

        @* Header with toggle *@
        <div class="@Cn.Merge("flex items-center gap-2 border-b px-4 py-3", _isDark ? "border-zinc-700" : "")">
            <LucideIconCn Name="palette" Size="16" Class="@Cn.Merge("size-4", _isDark ? "text-zinc-400" : "text-muted-foreground")" />
            <span class="font-medium text-sm">Theme Changelog</span>

            <div class="ml-auto flex items-center gap-2">
                <LucideIconCn Name="sun" Size="14" Class="@Cn.Merge("size-3.5", _isDark ? "text-zinc-500" : "text-amber-500")" />
                <SwitchCn @bind-Checked="_isDark"
                          aria-label="@(_isDark ? "Switch to light mode" : "Switch to dark mode")"
                          Class="data-[state=checked]:bg-zinc-600" />
                <LucideIconCn Name="moon" Size="14" Class="@Cn.Merge("size-3.5", _isDark ? "text-blue-400" : "text-zinc-300")" />
            </div>
        </div>

        @* Theme indicator *@
        <div class="@Cn.Merge("flex items-center gap-2 border-b px-4 py-2", _isDark ? "border-zinc-700 bg-zinc-800/50" : "bg-muted/30")">
            <span class="@Cn.Merge("size-1.5 rounded-full", _isDark ? "bg-blue-400" : "bg-amber-400")"></span>
            <span class="@Cn.Merge("font-mono text-xs", _isDark ? "text-zinc-400" : "text-muted-foreground")">
                Previewing: @(_isDark ? "dark" : "light") mode
            </span>
            <span class="@Cn.Merge("ml-auto text-xs", _isDark ? "text-zinc-500" : "text-muted-foreground/70")">
                @_entries.Length changes
            </span>
        </div>

        @* Entries *@
        <div>
            @for (var i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                var config = _typeConfig[entry.Type];
                <div class="@Cn.Merge("border-b px-4 py-3 last:border-b-0", _isDark ? "border-zinc-700" : "")">
                    <div class="flex items-start gap-3">
                        <span class="@($"mt-1.5 size-2 shrink-0 rounded-full {config.Dot}")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@entry.Title</span>
                            </div>
                            <p class="@Cn.Merge("mt-0.5 text-xs leading-relaxed", _isDark ? "text-zinc-400" : "text-muted-foreground")">
                                @entry.Description
                            </p>

                            @* Token pills *@
                            <div class="mt-2 flex flex-wrap items-center gap-1.5">
                                @foreach (var token in entry.Tokens)
                                {
                                    <span class="@Cn.Merge("rounded px-1.5 py-0.5 font-mono text-[10px]", _isDark ? "bg-zinc-800 text-zinc-400" : "bg-muted/50 text-muted-foreground")">
                                        @token
                                    </span>
                                }
                            </div>

                            @* Meta *@
                            <div class="mt-2 flex items-center gap-1.5">
                                <BadgeCn Variant="BadgeVariant.Secondary"
                                         Class="@Cn.Merge("font-mono text-[10px]", _isDark ? "bg-zinc-800 text-zinc-400" : "")">
                                    v@(entry.Version)
                                </BadgeCn>
                                <span class="@Cn.Merge("text-[10px]", _isDark ? "text-zinc-500" : "text-muted-foreground/70")">
                                    @entry.Date
                                </span>
                                <span class="@Cn.Merge("text-[10px]", _isDark ? "text-zinc-500" : "text-muted-foreground/40")">
                                    &middot;
                                </span>
                                <span class="@Cn.Merge("text-[10px]", _isDark ? "text-zinc-400" : "text-muted-foreground")">
                                    @config.Label
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ChangelogEntry(string Id, string Version, string Title, string Description, string Type, string Date, string[] Tokens);
    private record TypeConfig(string Label, string Dot);

    private bool _isDark = false;

    private static readonly Dictionary<string, TypeConfig> _typeConfig = new()
    {
        ["added"]    = new TypeConfig("Added",    "bg-emerald-500"),
        ["changed"]  = new TypeConfig("Changed",  "bg-blue-500"),
        ["fixed"]    = new TypeConfig("Fixed",    "bg-amber-500"),
        ["improved"] = new TypeConfig("Improved", "bg-violet-500"),
    };

    private static readonly ChangelogEntry[] _entries =
    [
        new("th-1", "2.8.0",
            "New semantic color tokens for status indicators",
            "Added success, warning, danger, and info color tokens that adapt to both themes. Each token includes foreground, background, and border variants.",
            "added", "Mar 30, 2026",
            ["--color-success", "--color-warning", "--color-danger"]),
        new("th-2", "2.7.2",
            "Fixed contrast ratio on muted text in dark mode",
            "Dark mode muted-foreground was 3.2:1 contrast ratio, below WCAG AA. Increased to 4.8:1 by lightening from zinc-500 to zinc-400.",
            "fixed", "Mar 27, 2026",
            ["--color-muted-foreground"]),
        new("th-3", "2.7.1",
            "Smoother transition between light and dark themes",
            "Theme transitions now use a 150ms ease-out on background and color properties. Eliminates the flash of unstyled content during theme switch.",
            "improved", "Mar 24, 2026",
            ["transition-colors", "duration-150"]),
        new("th-4", "2.7.0",
            "Redesigned card elevation system for dark mode",
            "Dark mode cards now use subtle border luminance instead of box shadows. Three elevation tiers: flat, raised, and overlay with distinct border opacity levels.",
            "changed", "Mar 21, 2026",
            ["--color-card", "--color-card-foreground", "--shadow-card"]),
        new("th-5", "2.6.0",
            "Added high contrast mode for accessibility",
            "A third theme option increases all contrast ratios to 7:1 minimum (WCAG AAA). Applies bolder borders, heavier font weights, and increased spacing.",
            "added", "Mar 18, 2026",
            ["--color-hc-foreground", "--color-hc-border"]),
        new("th-6", "2.5.3",
            "Fixed focus ring visibility on light backgrounds",
            "Focus ring color was too subtle on white card backgrounds. Now uses a 2px ring with ring-offset for clear visibility in both themes.",
            "fixed", "Mar 15, 2026",
            ["--color-ring", "ring-offset-2"]),
    ];
}
