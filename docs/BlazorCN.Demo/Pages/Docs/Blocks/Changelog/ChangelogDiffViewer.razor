@* ============================================================
   Block: changelog-diff-viewer
   Title: ChangelogDiffViewer
   Description: A before-and-after diff viewer changelog block built with React, Next.js, shadcn/ui, and Tailwind CSS showing configuration changes with strikethrough and highlight
   Source: original/blocks/changelog/changelog-diff-viewer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="arrow-left-right" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Configuration Changes</h2>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto text-xs">@_changes.Length changes</BadgeCn>
        </div>

        <div>
            @for (var i = 0; i < _changes.Length; i++)
            {
                var change = _changes[i];
                var isExpanded = _expandedId == change.Id;
                var itemClass = i < _changes.Length - 1 ? "border-b" : "";
                var dotClass = Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", GetCategoryDot(change.Category));
                var chevronClass = Cn.Merge("size-3.5 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
                var changeId = change.Id;
                <div class="@itemClass">
                    <button
                        type="button"
                        @onclick="@(() => ToggleExpanded(changeId))"
                        class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@dotClass"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@change.Field</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs font-normal">@change.Category</BadgeCn>
                            </div>
                            <div class="mt-1.5 flex items-center gap-2">
                                <span class="rounded bg-red-500/10 px-1.5 py-0.5 font-mono text-xs text-red-600 line-through dark:text-red-400">@change.OldValue</span>
                                <LucideIconCn Name="arrow-right" Size="12" Class="size-3 shrink-0 text-muted-foreground/40" />
                                <span class="rounded bg-emerald-500/10 px-1.5 py-0.5 font-mono text-xs text-emerald-600 dark:text-emerald-400">@change.NewValue</span>
                            </div>
                        </div>
                        <div class="flex shrink-0 items-center gap-2">
                            <span class="text-xs text-muted-foreground/60">@change.Date</span>
                            <LucideIconCn Name="chevron-right" Size="14" Class="@chevronClass" />
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-10">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="flex items-center gap-3">
                                    <div>
                                        <p class="text-xs font-medium text-muted-foreground">Config path</p>
                                        <p class="mt-0.5 font-mono text-xs text-muted-foreground/80">@change.Path</p>
                                    </div>
                                    <div class="ml-auto text-right">
                                        <p class="text-xs font-medium text-muted-foreground">Changed by</p>
                                        <p class="mt-0.5 text-xs text-muted-foreground/80">@change.Author</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ConfigChange(
        string Id,
        string Field,
        string Path,
        string OldValue,
        string NewValue,
        string Category,
        string Date,
        string Author
    );

    private string? _expandedId;

    private void ToggleExpanded(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private static string GetCategoryDot(string category) => category switch
    {
        "Storage"     => "bg-violet-500",
        "Auth"        => "bg-amber-500",
        "API"         => "bg-blue-500",
        "Deploy"      => "bg-emerald-500",
        "Logging"     => "bg-muted-foreground",
        "Performance" => "bg-red-500",
        _             => "bg-muted-foreground",
    };

    private static readonly ConfigChange[] _changes =
    [
        new("d1", "Max file upload size",  "storage.maxUploadSize",      "10 MB",        "50 MB",        "Storage",     "Mar 27, 2026", "Sarah Chen"),
        new("d2", "Session timeout",       "auth.sessionTimeout",         "24 hours",     "7 days",       "Auth",        "Mar 27, 2026", "Marcus Johnson"),
        new("d3", "API rate limit",        "api.rateLimit.requests",      "100 req/min",  "500 req/min",  "API",         "Mar 26, 2026", "Alex Rivera"),
        new("d4", "Default region",        "deploy.region",               "us-east-1",    "us-west-2",    "Deploy",      "Mar 25, 2026", "Priya Patel"),
        new("d5", "Log retention",         "logging.retentionDays",       "30 days",      "90 days",      "Logging",     "Mar 25, 2026", "Sarah Chen"),
        new("d6", "Webhook timeout",       "webhooks.timeout",            "5 seconds",    "30 seconds",   "API",         "Mar 24, 2026", "Marcus Johnson"),
        new("d7", "Password min length",   "auth.password.minLength",     "8 characters", "12 characters","Auth",        "Mar 24, 2026", "Alex Rivera"),
        new("d8", "Cache TTL",             "cache.defaultTTL",            "5 minutes",    "15 minutes",   "Performance", "Mar 23, 2026", "Priya Patel"),
    ];
}
