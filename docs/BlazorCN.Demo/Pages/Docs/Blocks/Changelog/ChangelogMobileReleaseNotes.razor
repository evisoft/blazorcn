@* ============================================================
   Block: changelog-mobile-release-notes
   Title: ChangelogMobileReleaseNotes
   Description: A React changelog component for mobile releases built with Next.js, shadcn/ui, and Tailwind CSS showing iOS/Android platform badges, app store status, and version-specific features
   Source: original/blocks/changelog/changelog-mobile-release-notes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="smartphone" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Mobile Release Notes</h2>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">
                iOS and Android app releases with platform-specific features
            </p>
        </div>

        @* Release list *@
        <div>
            @foreach (var rel in _releases)
            {
                var release = rel;
                var isExpanded = _expandedId == release.Id;
                var isLast = release.Id == _releases[^1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => ToggleRelease(release.Id))"
                            class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex min-w-0 flex-1 flex-col gap-2">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">v@(release.Version)</span>
                                @if (release.Features.Length > 0)
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                                        @(release.Features.Length) new feature@(release.Features.Length != 1 ? "s" : "")
                                    </BadgeCn>
                                }
                            </div>
                            <div class="flex flex-wrap items-center gap-2">
                                @foreach (var p in release.Platforms)
                                {
                                    @PlatformBadge(p)
                                }
                                <span class="text-xs text-muted-foreground">@release.ReleaseDate</span>
                            </div>
                            <div class="flex flex-wrap items-center gap-3 text-xs">
                                @if (release.IosStatus != null)
                                {
                                    <div class="flex items-center gap-1">
                                        @StoreStatusIcon(release.IosStatus)
                                        <span class="text-muted-foreground">App Store</span>
                                    </div>
                                }
                                @if (release.AndroidStatus != null)
                                {
                                    <div class="flex items-center gap-1">
                                        @StoreStatusIcon(release.AndroidStatus)
                                        <span class="text-muted-foreground">Play Store</span>
                                    </div>
                                }
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/50 px-4 py-3">
                            <p class="mb-3 text-xs text-muted-foreground">@release.Notes</p>

                            <div class="mb-3 grid gap-2 sm:grid-cols-2">
                                @if (release.IosBuild != null)
                                {
                                    <div class="rounded-md bg-background px-3 py-2">
                                        <span class="block text-xs text-muted-foreground">iOS Build</span>
                                        <span class="mt-0.5 block font-mono text-xs">@release.IosBuild</span>
                                    </div>
                                }
                                @if (release.AndroidBuild != null)
                                {
                                    <div class="rounded-md bg-background px-3 py-2">
                                        <span class="block text-xs text-muted-foreground">Android Build</span>
                                        <span class="mt-0.5 block font-mono text-xs">@release.AndroidBuild</span>
                                    </div>
                                }
                            </div>

                            @if (release.Features.Length > 0)
                            {
                                <div class="mb-3">
                                    <div class="mb-1.5 flex items-center gap-1.5">
                                        <LucideIconCn Name="sparkles" Size="14" Class="size-3.5 text-muted-foreground" />
                                        <span class="text-xs font-medium text-muted-foreground">New Features</span>
                                    </div>
                                    <div class="space-y-2">
                                        @foreach (var feature in release.Features)
                                        {
                                            <div class="rounded-md bg-background px-3 py-2">
                                                <p class="mb-1 text-xs">@feature.Title</p>
                                                <div class="flex gap-1.5">
                                                    @foreach (var fp in feature.Platforms)
                                                    {
                                                        @PlatformBadge(fp)
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            @if (release.Fixes.Length > 0)
                            {
                                <div>
                                    <div class="mb-1.5 flex items-center gap-1.5">
                                        <LucideIconCn Name="bug" Size="14" Class="size-3.5 text-muted-foreground" />
                                        <span class="text-xs font-medium text-muted-foreground">Bug Fixes</span>
                                    </div>
                                    <ul class="space-y-1.5">
                                        @foreach (var fix in release.Fixes)
                                        {
                                            <li class="flex gap-2 text-xs text-muted-foreground">
                                                <span class="text-muted-foreground/60">•</span>
                                                <span>@fix</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record MobileFeature(string Title, string[] Platforms);

    private record MobileRelease(
        string Id,
        string Version,
        string[] Platforms,
        string ReleaseDate,
        string? IosStatus,
        string? AndroidStatus,
        string? IosBuild,
        string? AndroidBuild,
        MobileFeature[] Features,
        string[] Fixes,
        string Notes);

    private static readonly MobileRelease[] _releases =
    [
        new("1", "2.8.0", ["ios", "android"], "2 days ago",
            "live", "live", "280", "2800042",
            [
                new("Dark mode support with automatic theme switching", ["ios", "android"]),
                new("Biometric authentication for quick login", ["ios", "android"]),
                new("Widget support for home screen quick actions", ["ios"]),
                new("Material You dynamic color theming", ["android"]),
            ],
            [
                "Fixed crash when rotating device during video playback",
                "Resolved memory leak in image gallery",
                "Fixed notification badge count not updating",
            ],
            "Major release adding dark mode and biometric authentication across both platforms"),

        new("2", "2.7.1", ["ios", "android"], "1 week ago",
            "live", "live", "271", "2700138",
            [],
            [
                "Fixed payment processing issue on iOS 17.4",
                "Resolved Android 14 push notification permission flow",
                "Fixed keyboard not dismissing in comment field",
                "Improved offline mode data sync reliability",
            ],
            "Hotfix release addressing critical payment and notification issues"),

        new("3", "2.7.0", ["ios", "android"], "2 weeks ago",
            "live", "live", "270", "2700089",
            [
                new("In-app messaging with real-time notifications", ["ios", "android"]),
                new("Voice message recording and playback", ["ios", "android"]),
                new("SharePlay integration for collaborative viewing", ["ios"]),
            ],
            [
                "Fixed video player controls disappearing",
                "Resolved search autocomplete lag",
                "Fixed profile photo upload quality",
            ],
            "Added in-app messaging system with voice message support"),

        new("4", "2.6.2", ["android"], "3 weeks ago",
            null, "live", null, "2620056",
            [],
            [
                "Fixed crash on Samsung devices running One UI 6",
                "Resolved notification channel configuration issue",
                "Fixed back gesture navigation conflict",
            ],
            "Android-specific fixes for Samsung device compatibility"),

        new("5", "2.6.1", ["ios"], "3 weeks ago",
            "live", null, "261", null,
            [],
            [
                "Fixed App Store rejection issue with privacy manifest",
                "Resolved Dynamic Island animation glitch",
                "Fixed VoiceOver accessibility in settings",
            ],
            "iOS-specific fixes for App Store compliance and accessibility"),

        new("6", "2.6.0", ["ios", "android"], "1 month ago",
            "live", "live", "260", "2600124",
            [
                new("Offline mode with local data caching", ["ios", "android"]),
                new("Advanced search filters and saved searches", ["ios", "android"]),
                new("Live Activities for ongoing tasks", ["ios"]),
                new("Predictive back gesture support", ["android"]),
            ],
            [
                "Fixed battery drain issue with background sync",
                "Resolved layout issues on tablet devices",
                "Fixed crash when opening deep links",
            ],
            "Major update with offline mode and improved search capabilities"),
    ];

    private string? _expandedId = null;

    private void ToggleRelease(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private RenderFragment PlatformBadge(string platform) => __builder =>
    {
        var bg = platform == "ios" ? "bg-blue-500/10" : "bg-emerald-500/10";
        var text = platform == "ios" ? "text-blue-500" : "text-emerald-500";
        var label = platform == "ios" ? "iOS" : "Android";
        <span class="@Cn.Merge("rounded-md px-2 py-0.5 text-xs font-medium", bg, text)">@label</span>
    };

    private RenderFragment StoreStatusIcon(string status) => __builder =>
    {
        var iconName = status == "live" ? "check-circle-2" : "clock";
        var color = status == "live" ? "text-emerald-500" : (status == "pending" ? "text-amber-500" : "text-blue-500");
        <LucideIconCn Name="@iconName" Size="12" Class="@Cn.Merge("size-3", color)" />
    };
}
