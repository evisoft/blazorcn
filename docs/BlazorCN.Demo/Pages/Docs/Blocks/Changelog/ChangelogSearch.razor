@* ============================================================
   Block: changelog-search
   Title: ChangelogSearch
   Description: A searchable changelog block built with React, Next.js, shadcn/ui, and Tailwind CSS with real-time filtering of versioned release entries
   Source: original/blocks/changelog/changelog-search.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="search" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Changelog</h2>
        </div>

        @* Search input *@
        <div class="border-b px-4 py-3">
            <InputCn Placeholder="Search updates, versions, features..."
                     @bind-Value="_query"
                     Class="border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
        </div>

        @* Entries *@
        <div>
            @{
                var lowerQuery = _query.ToLowerInvariant();
                var filtered = string.IsNullOrEmpty(lowerQuery)
                    ? _entries
                    : _entries.Where(e =>
                        e.Title.ToLowerInvariant().Contains(lowerQuery) ||
                        e.Version.Contains(lowerQuery) ||
                        e.Changes.Any(c => c.Text.ToLowerInvariant().Contains(lowerQuery))
                    ).ToArray();
            }
            @if (filtered.Length == 0)
            {
                <div class="px-4 py-8 text-center">
                    <p class="text-sm text-muted-foreground">No matching entries found</p>
                    <p class="mt-1 text-xs text-muted-foreground/60">Try adjusting your search terms</p>
                </div>
            }
            else
            {
                @for (var i = 0; i < filtered.Length; i++)
                {
                    var entry = filtered[i];
                    var borderClass = i < filtered.Length - 1 ? "border-b" : "";
                    <div class="@borderClass">
                        <div class="flex items-center justify-between px-4 pt-3 pb-1">
                            <span class="text-sm font-medium">@entry.Title</span>
                            <div class="flex items-center gap-2">
                                <BadgeCn Variant="BadgeVariant.Outline" Class="font-mono text-xs font-normal">
                                    v@entry.Version
                                </BadgeCn>
                                <span class="text-xs text-muted-foreground">@entry.Date</span>
                            </div>
                        </div>
                        <div class="px-4 pb-3">
                            @foreach (var change in entry.Changes)
                            {
                                <div class="flex items-start gap-2 py-1">
                                    <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", _dotClass[change.Type])"
                                          aria-hidden="true"></span>
                                    <span class="text-xs text-muted-foreground">@change.Text</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>

    </div>
</section>

@code {
    private record ChangeItem(string Type, string Text);
    private record ChangeEntry(string Id, string Version, string Date, string Title, ChangeItem[] Changes);

    private string _query = "";

    private static readonly Dictionary<string, string> _dotClass = new()
    {
        ["added"]    = "bg-emerald-500",
        ["fixed"]    = "bg-red-500",
        ["improved"] = "bg-blue-500",
    };

    private static readonly ChangeEntry[] _entries =
    [
        new("v3.2.0", "3.2.0", "Mar 24, 2026", "Team permissions overhaul",
        [
            new("added",    "Granular role-based access controls for workspaces"),
            new("added",    "Invite links with expiration and usage limits"),
            new("improved", "Permission checks now resolve in under 5ms"),
        ]),
        new("v3.1.2", "3.1.2", "Mar 18, 2026", "Dashboard performance patch",
        [
            new("fixed",    "Memory leak in real-time chart component on unmount"),
            new("fixed",    "Incorrect timezone offset for UTC+13 regions"),
            new("improved", "Reduced initial dashboard load time by 40%"),
        ]),
        new("v3.1.0", "3.1.0", "Mar 10, 2026", "API v2 and webhook events",
        [
            new("added",    "REST API v2 with cursor-based pagination"),
            new("added",    "Webhook subscriptions for create, update, and delete events"),
            new("improved", "API response times improved by 60% with edge caching"),
        ]),
        new("v3.0.0", "3.0.0", "Feb 28, 2026", "Major platform redesign",
        [
            new("added",    "Completely redesigned dashboard with customizable layouts"),
            new("added",    "Dark mode support across all views"),
            new("improved", "Navigation restructured for faster task completion"),
            new("fixed",    "Table sorting state lost on page navigation"),
        ]),
        new("v2.9.5", "2.9.5", "Feb 14, 2026", "Export and integrations update",
        [
            new("added", "PDF export for reports with custom branding"),
            new("added", "Slack integration for real-time notifications"),
            new("fixed", "CSV export missing headers for custom fields"),
        ]),
    ];
}
