@* ============================================================
   Block: changelog-release-blockers
   Title: ChangelogReleaseBlockers
   Description: A changelog block displaying critical release blockers with issue tracking, owner assignments, and resolution status built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/changelog/changelog-release-blockers.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Release Blockers</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Critical issues preventing releases
                    </p>
                </div>
                <LucideIconCn Name="alert-triangle" Size="16" Class="size-4 text-muted-foreground" />
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-4 gap-4">
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="alert-triangle" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Active</span>
                    </div>
                    <p class="mt-1 font-semibold tabular-nums text-2xl text-red-600">@_activeBlockers</p>
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">In Progress</span>
                    </div>
                    <p class="mt-1 font-semibold tabular-nums text-2xl">2</p>
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Resolved</span>
                    </div>
                    <p class="mt-1 font-semibold tabular-nums text-2xl text-emerald-600">@_totalResolved</p>
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="x-circle" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">Total</span>
                    </div>
                    <p class="mt-1 font-semibold tabular-nums text-2xl">@_totalBlockers</p>
                </div>
            </div>
        </div>

        <div>
            @foreach (var release in _releases)
            {
                var rel = release;
                var isExpanded = _expandedId == rel.Id;
                var statusColor = GetStatusColor(rel.Status);
                var chevronClass = Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");
                var badgeClass = Cn.Merge("h-4 border-0 px-1.5 text-[10px]",
                    rel.ResolvedBlockers == rel.TotalBlockers
                        ? "bg-emerald-500/10 text-emerald-600"
                        : "bg-red-500/10 text-red-600");
                <div class="border-b last:border-b-0">
                    <button type="button" @onclick="@(() => Toggle(rel.Id))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-md", statusColor)">
                            @if (rel.Status == "blocked")
                            {
                                <LucideIconCn Name="x-circle" Size="16" Class="size-4" />
                            }
                            else if (rel.Status == "at-risk")
                            {
                                <LucideIconCn Name="alert-triangle" Size="16" Class="size-4" />
                            }
                            else
                            {
                                <LucideIconCn Name="check-circle-2" Size="16" Class="size-4" />
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@rel.Version</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="@badgeClass">
                                    @rel.ResolvedBlockers/@rel.TotalBlockers resolved
                                </BadgeCn>
                            </div>
                            <div class="mt-0.5 flex items-center gap-3 text-xs text-muted-foreground">
                                <span>Target: @rel.TargetDate</span>
                                <span>•</span>
                                <span class="@Cn.Merge(statusColor, "font-medium")">
                                    @if (rel.Status == "blocked")
                                    {
                                        <text>Blocked</text>
                                    }
                                    else if (rel.Status == "at-risk")
                                    {
                                        <text>At Risk</text>
                                    }
                                    else
                                    {
                                        <text>On Track</text>
                                    }
                                </span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/30 px-4 py-3">
                            <div class="space-y-2">
                                @foreach (var blocker in rel.Blockers)
                                {
                                    var b = blocker;
                                    <div class="rounded-md border bg-card p-3">
                                        <div class="flex items-start justify-between">
                                            <div class="flex items-start gap-2">
                                                <span class="@Cn.Merge("mt-0.5 size-1.5 shrink-0 rounded-full", GetSeverityColor(b.Severity))"></span>
                                                <div class="min-w-0">
                                                    <div class="flex items-center gap-2">
                                                        <span class="font-medium text-sm">@b.Title</span>
                                                        <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 border-0 bg-muted/50 px-1.5 text-[10px]">
                                                            #@b.IssueNumber
                                                        </BadgeCn>
                                                    </div>
                                                    <p class="mt-1 text-xs text-muted-foreground">
                                                        @b.Description
                                                    </p>
                                                    <div class="mt-2 flex items-center gap-3 text-xs">
                                                        <div class="flex items-center gap-1">
                                                            @if (b.Status == "blocked")
                                                            {
                                                                <LucideIconCn Name="x-circle" Size="12" Class="size-3 text-red-600" />
                                                            }
                                                            else if (b.Status == "in-progress")
                                                            {
                                                                <LucideIconCn Name="clock" Size="12" Class="size-3 text-blue-600" />
                                                            }
                                                            else
                                                            {
                                                                <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-600" />
                                                            }
                                                            <span class="text-muted-foreground">@GetBlockerStatusLabel(b.Status)</span>
                                                        </div>
                                                        <span class="text-muted-foreground">•</span>
                                                        <span class="text-muted-foreground">@b.Owner</span>
                                                        <span class="text-muted-foreground">•</span>
                                                        <span class="text-muted-foreground">@b.CreatedAt</span>
                                                        @if (b.EstimatedResolution != null)
                                                        {
                                                            <span class="text-muted-foreground">•</span>
                                                            <span class="text-blue-600">ETA: @b.EstimatedResolution</span>
                                                        }
                                                        @if (b.ResolvedAt != null)
                                                        {
                                                            <span class="text-muted-foreground">•</span>
                                                            <span class="text-emerald-600">Resolved @b.ResolvedAt</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-xs text-muted-foreground">
                    @_releases.Length releases • @_activeBlockers active blockers
                </span>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="h-7 gap-1.5 px-2 text-xs">
                    View All Issues
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record BlockerItem(
        string Id,
        string Title,
        string Severity,
        string Status,
        string Owner,
        int IssueNumber,
        string Description,
        string CreatedAt,
        string? ResolvedAt,
        string? EstimatedResolution
    );

    private record ReleaseItem(
        string Id,
        string Version,
        string TargetDate,
        string Status,
        BlockerItem[] Blockers,
        int TotalBlockers,
        int ResolvedBlockers
    );

    private static readonly ReleaseItem[] _releases =
    [
        new(
            "1",
            "v2.5.0",
            "2026-04-01",
            "blocked",
            [
                new("b1", "Payment gateway timeout on high load", "critical", "in-progress", "Sarah Chen", 1842,
                    "Stripe webhook processing fails under 500+ RPS causing payment confirmation delays",
                    "2 days ago", null, "Tomorrow"),
                new("b2", "Database migration rollback failure", "critical", "blocked", "Marcus Rodriguez", 1839,
                    "Migration v2.5.0 cannot rollback safely due to dropped column reference in legacy code",
                    "3 days ago", null, "2 days"),
                new("b3", "Auth session expiry causing data loss", "high", "in-progress", "Alex Thompson", 1835,
                    "Users lose unsaved form data when session expires during multi-step checkout",
                    "4 days ago", null, "Tomorrow"),
            ],
            3,
            0
        ),
        new(
            "2",
            "v2.4.1",
            "2026-03-28",
            "on-track",
            [
                new("b4", "Memory leak in WebSocket connections", "high", "resolved", "Jamie Kim", 1820,
                    "Long-lived WebSocket connections accumulate event listeners causing browser crashes",
                    "1 week ago", "2 days ago", null),
                new("b5", "CDN cache poisoning vulnerability", "critical", "resolved", "Taylor Morgan", 1818,
                    "Cache key missing user context allowing cross-user data leakage in API responses",
                    "1 week ago", "3 days ago", null),
            ],
            2,
            2
        ),
        new(
            "3",
            "v2.4.0",
            "2026-03-22",
            "on-track",
            [
                new("b6", "Search indexing race condition", "medium", "resolved", "Jordan Lee", 1805,
                    "Concurrent updates to search index causing stale results for 10-15 seconds",
                    "2 weeks ago", "1 week ago", null),
            ],
            1,
            1
        ),
    ];

    private static readonly int _totalBlockers = _releases.Sum(r => r.TotalBlockers);
    private static readonly int _totalResolved = _releases.Sum(r => r.ResolvedBlockers);
    private static readonly int _activeBlockers = _totalBlockers - _totalResolved;

    private string? _expandedId;

    private void Toggle(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private static string GetStatusColor(string status) => status switch
    {
        "blocked"  => "text-red-600",
        "at-risk"  => "text-amber-600",
        "on-track" => "text-emerald-600",
        _          => ""
    };

    private static string GetSeverityColor(string severity) => severity switch
    {
        "critical" => "bg-red-500",
        "high"     => "bg-amber-500",
        "medium"   => "bg-blue-500",
        _          => ""
    };

    private static string GetBlockerStatusLabel(string status) => status switch
    {
        "blocked"     => "Blocked",
        "in-progress" => "In Progress",
        "resolved"    => "Resolved",
        _             => status
    };
}
