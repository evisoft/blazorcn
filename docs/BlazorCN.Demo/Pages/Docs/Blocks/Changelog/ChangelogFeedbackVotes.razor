@* ============================================================
   Block: changelog-feedback-votes
   Title: ChangelogFeedbackVotes
   Description: A feedback votes changelog block for React and Next.js with upvote and downvote reactions, sentiment bars, and user feedback comments built with shadcn/ui and Tailwind CSS
   Source: original/blocks/changelog/changelog-feedback-votes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="thumbs-up" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Community Feedback</span>
            </div>
            <span class="text-muted-foreground text-xs">@_entries.Length changes this week</span>
        </div>

        @* Entries *@
        @foreach (var entry in _entries)
        {
            var userVote = _votes.TryGetValue(entry.Id, out var v) ? v : null;
            var upCount = entry.Upvotes + (userVote == "up" ? 1 : 0);
            var downCount = entry.Downvotes + (userVote == "down" ? 1 : 0);
            var total = upCount + downCount;
            var positivePercent = total > 0 ? (int)Math.Round((double)upCount / total * 100) : 50;
            var isLast = entry.Id == _entries[^1].Id;
            var entryId = entry.Id;
            <div class="@(Cn.Merge("px-4 py-3", !isLast ? "border-b" : ""))">
                <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@entry.Title</span>
                            <span class="text-muted-foreground text-xs">@entry.Date</span>
                        </div>
                        <p class="mt-0.5 text-muted-foreground text-xs">@entry.Description</p>
                    </div>
                </div>

                @* Vote row *@
                <div class="mt-2.5 flex items-center gap-3">
                    <div class="flex items-center gap-1">
                        <ButtonCn Variant="ButtonVariant.Ghost"
                                  Size="ButtonSize.Sm"
                                  Class="@(Cn.Merge("h-7 gap-1 px-2 text-xs", userVote == "up" ? "bg-emerald-500/10 text-emerald-600 hover:bg-emerald-500/20 dark:text-emerald-400" : "text-muted-foreground"))"
                                  OnClick="@(() => HandleVote(entryId, "up"))">
                            <LucideIconCn Name="thumbs-up" Size="12" Class="size-3" />
                            <span class="tabular-nums">@upCount</span>
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost"
                                  Size="ButtonSize.Sm"
                                  Class="@(Cn.Merge("h-7 gap-1 px-2 text-xs", userVote == "down" ? "bg-red-500/10 text-red-600 hover:bg-red-500/20 dark:text-red-400" : "text-muted-foreground"))"
                                  OnClick="@(() => HandleVote(entryId, "down"))">
                            <LucideIconCn Name="thumbs-down" Size="12" Class="size-3" />
                            <span class="tabular-nums">@downCount</span>
                        </ButtonCn>
                    </div>

                    @* Sentiment bar *@
                    <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                        <div class="h-full rounded-full bg-emerald-500" style="@($"width:{positivePercent}%")"></div>
                    </div>
                    <span class="w-8 text-right font-mono text-muted-foreground text-xs tabular-nums">@(positivePercent)%</span>

                    @* Comment count *@
                    <button type="button"
                            class="flex items-center gap-1 text-muted-foreground text-xs transition-colors hover:text-foreground">
                        <LucideIconCn Name="message-square" Size="12" Class="size-3" />
                        <span class="tabular-nums">@entry.CommentCount</span>
                    </button>
                </div>
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">Your feedback helps shape our roadmap</p>
        </div>

    </div>
</section>

@code {
    private record ChangeEntry(string Id, string Title, string Description, int Upvotes, int Downvotes, int CommentCount, string Date);

    private static readonly ChangeEntry[] _entries =
    [
        new("c1", "New project dashboard layout", "Redesigned project overview with card-based layout and quick action shortcuts.", 142, 18, 23, "Mar 29"),
        new("c2", "Keyboard shortcuts panel", "Press ? to view all keyboard shortcuts in a modal overlay.", 98, 4, 7, "Mar 28"),
        new("c3", "Removed legacy export format", "XML export has been removed. All exports now use JSON or CSV format.", 31, 67, 45, "Mar 27"),
        new("c4", "Auto-save draft changes", "Unsaved changes are now automatically saved every 30 seconds as drafts.", 215, 8, 12, "Mar 26"),
        new("c5", "Updated rate limits for API", "Free tier rate limit changed from 1,000 to 500 requests per minute.", 12, 89, 61, "Mar 25"),
    ];

    private readonly Dictionary<string, string?> _votes = new()
    {
        ["c1"] = null,
        ["c2"] = null,
        ["c3"] = null,
        ["c4"] = null,
        ["c5"] = null,
    };

    private void HandleVote(string entryId, string direction)
    {
        var current = _votes.TryGetValue(entryId, out var existing) ? existing : null;
        _votes[entryId] = current == direction ? null : direction;
    }
}
