@* ============================================================
   Block: changelog-cost-optimization
   Title: ChangelogCostOptimization
   Description: A React changelog component for cost savings and optimization wins built with Next.js, shadcn/ui, and Tailwind CSS showing savings amounts, categories, and cumulative impact
   Source: original/blocks/changelog/changelog-cost-optimization.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="dollar-sign" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="text-sm font-medium">Cost Optimization Wins</h2>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">
                Infrastructure savings and optimization results across releases
            </p>
        </div>

        <div class="border-b bg-muted/50 px-4 py-3">
            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <span class="block text-xs text-muted-foreground">Monthly Savings</span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-semibold tabular-nums text-2xl text-emerald-500">
                            $@((_totalMonthlySavings / 1000.0).ToString("F1"))k
                        </span>
                        <span class="text-xs text-muted-foreground">/mo</span>
                    </div>
                </div>
                <div>
                    <span class="block text-xs text-muted-foreground">Annualized Impact</span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-semibold tabular-nums text-2xl text-emerald-500">
                            $@((_totalAnnualSavings / 1000).ToString())k
                        </span>
                        <span class="text-xs text-muted-foreground">/yr</span>
                    </div>
                </div>
            </div>
        </div>

        <div>
            @foreach (var optimization in _optimizations)
            {
                var opt = optimization;
                var isExpanded = _expandedId == opt.Id;
                <div class="border-b last:border-b-0">
                    <button type="button"
                            class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => _expandedId = isExpanded ? null : opt.Id)">
                        <div class="flex min-w-0 flex-1 flex-col gap-2">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@opt.Title</span>
                            </div>
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="@Cn.Merge("inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-xs font-medium", GetCategoryBadgeClasses(opt.Category))">
                                    <LucideIconCn Name="@GetCategoryIconName(opt.Category)" Size="16" Class="size-4" />
                                    @opt.Category
                                </span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                                    @opt.Version
                                </BadgeCn>
                                <span class="text-xs text-muted-foreground">@opt.Date</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <div class="flex items-baseline gap-1">
                                    <span class="font-semibold tabular-nums text-emerald-500">
                                        $@((opt.MonthlySavings / 1000.0).ToString("F1"))k
                                    </span>
                                    <span class="text-xs text-muted-foreground">/mo</span>
                                </div>
                                <span class="text-xs text-muted-foreground">•</span>
                                <div class="flex items-baseline gap-1">
                                    <span class="text-xs text-muted-foreground">
                                        $@((opt.AnnualizedSavings / 1000).ToString())k /yr
                                    </span>
                                </div>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right"
                                      Size="16"
                                      Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/50 px-4 py-3">
                            <p class="mb-3 text-xs text-muted-foreground">@opt.Details</p>
                            <div>
                                <span class="mb-2 block text-xs font-medium text-muted-foreground">
                                    Savings Breakdown
                                </span>
                                <div class="space-y-2">
                                    @foreach (var bd in opt.Breakdown)
                                    {
                                        <div class="flex items-center justify-between rounded-md bg-background px-3 py-2">
                                            <span class="text-xs">@bd.Item</span>
                                            <span class="font-medium tabular-nums text-xs text-emerald-500">
                                                $@(bd.Amount.ToString("N0"))/mo
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record BreakdownItem(string Item, int Amount);

    private record Optimization(
        string Id,
        string Title,
        string Category,
        int MonthlySavings,
        int AnnualizedSavings,
        string Date,
        string Version,
        string Details,
        BreakdownItem[] Breakdown);

    private string? _expandedId = null;

    private static readonly Optimization[] _optimizations =
    [
        new("1", "S3 Intelligent-Tiering Migration", "storage", 2840, 34080, "3 days ago", "v2.14.0",
            "Migrated 12TB of archival data to S3 Intelligent-Tiering, automatically moving infrequently accessed objects to lower-cost storage tiers",
            [
                new("S3 Standard → Infrequent Access", 1920),
                new("Archive tier savings", 720),
                new("Reduced transfer costs", 200),
            ]),
        new("2", "RDS Reserved Instance Purchase", "database", 4200, 50400, "1 week ago", "v2.13.0",
            "Converted on-demand RDS instances to 3-year reserved instances with significant upfront savings on predictable workloads",
            [
                new("Production DB reserved", 2800),
                new("Staging DB reserved", 1200),
                new("DR instance optimization", 200),
            ]),
        new("3", "CloudFront Cache Hit Ratio Optimization", "bandwidth", 1560, 18720, "2 weeks ago", "v2.12.0",
            "Improved cache policies and TTL settings, increasing cache hit ratio from 78% to 94% and reducing origin requests by 65%",
            [
                new("Reduced origin bandwidth", 980),
                new("Lower API gateway costs", 420),
                new("Compute savings", 160),
            ]),
        new("4", "Lambda Memory Right-Sizing", "compute", 890, 10680, "3 weeks ago", "v2.11.0",
            "Analyzed Lambda execution metrics and reduced over-provisioned memory allocations across 45 functions without impacting performance",
            [
                new("API functions optimized", 520),
                new("Background jobs tuned", 280),
                new("Event processors scaled", 90),
            ]),
        new("5", "DynamoDB On-Demand to Provisioned", "database", 1340, 16080, "1 month ago", "v2.10.0",
            "Migrated predictable workload tables from on-demand to provisioned capacity with auto-scaling, reducing costs by 62%",
            [
                new("Read capacity savings", 780),
                new("Write capacity savings", 460),
                new("Auto-scaling efficiency", 100),
            ]),
        new("6", "EC2 Spot Instance for Batch Jobs", "infrastructure", 3200, 38400, "6 weeks ago", "v2.9.0",
            "Converted all non-critical batch processing workloads to spot instances with 75% cost reduction and fault-tolerant retry logic",
            [
                new("Data processing jobs", 2100),
                new("Report generation", 780),
                new("ML training workloads", 320),
            ]),
    ];

    private static readonly int _totalMonthlySavings = _optimizations.Sum(o => o.MonthlySavings);
    private static readonly int _totalAnnualSavings  = _optimizations.Sum(o => o.AnnualizedSavings);

    private static string GetCategoryIconName(string category) => category switch
    {
        "compute"        => "zap",
        "storage"        => "database",
        "bandwidth"      => "cloud",
        "database"       => "server",
        "api"            => "trending-down",
        "infrastructure" => "server",
        _                => "server",
    };

    private static string GetCategoryBadgeClasses(string category) => category switch
    {
        "compute"        => "bg-blue-500/10 text-blue-500",
        "storage"        => "bg-purple-500/10 text-purple-500",
        "bandwidth"      => "bg-emerald-500/10 text-emerald-500",
        "database"       => "bg-amber-500/10 text-amber-500",
        "api"            => "bg-red-500/10 text-red-500",
        "infrastructure" => "bg-gray-500/10 text-gray-500",
        _                => "bg-gray-500/10 text-gray-500",
    };
}
