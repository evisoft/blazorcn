@* ============================================================
   Block: team-video-introductions
   Title: TeamVideoIntroductions
   Description: React team block with video thumbnails, play buttons, duration badges built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/team/team-video-introductions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Meet the team</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_members.Length video introductions
            </p>
        </div>

        <div>
            @foreach (var member in _members)
            {
                var isExpanded = _expanded == member.Name;
                var isLast = member.Name == _members[_members.Length - 1].Name;
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : member.Name)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="@Cn.Merge("relative flex size-10 shrink-0 items-center justify-center rounded-md", member.Color)">
                            <span class="text-xs font-medium text-muted-foreground">
                                @member.Initials
                            </span>
                            <div class="absolute inset-0 flex items-center justify-center">
                                <div class="flex size-5 items-center justify-center rounded-full bg-foreground/80">
                                    <LucideIconCn Name="play" Size="10" Class="ml-0.5 size-2.5 fill-background text-background" />
                                </div>
                            </div>
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@member.Name</span>
                                <span class="text-xs text-muted-foreground">@member.Role</span>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">@member.Topic</p>
                        </div>
                        <span class="shrink-0 font-mono text-xs text-muted-foreground">
                            @member.Duration
                        </span>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-17">
                            <p class="text-sm text-muted-foreground leading-relaxed">@member.Bio</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record TeamMember(string Name, string Role, string Initials, string Duration, string Topic, string Bio, string Color);

    private static readonly TeamMember[] _members =
    [
        new("Sarah Chen", "CEO & Co-founder", "SC", "1:42",
            "Why we started this company",
            "Former VP at Stripe. Shares the origin story of the company, the problem she saw firsthand, and why the team is uniquely positioned to solve it.",
            "bg-zinc-200 dark:bg-zinc-800"),
        new("Marcus Johnson", "Head of Engineering", "MJ", "2:15",
            "Our engineering culture",
            "Ex-Google Staff Engineer. Walks through how the engineering team ships fast without breaking things, and what makes the developer experience special.",
            "bg-stone-200 dark:bg-stone-800"),
        new("Elena Rodriguez", "Design Director", "ER", "1:58",
            "Design philosophy at scale",
            "Award-winning designer from Figma. Explains the design system approach, how the team balances consistency with creativity, and the craft behind every pixel.",
            "bg-neutral-200 dark:bg-neutral-800"),
        new("David Kim", "Staff Engineer", "DK", "1:33",
            "Building the platform",
            "Previously at Vercel. Dives into the technical architecture, the tools the team uses daily, and what excites him about the infrastructure challenges ahead.",
            "bg-slate-200 dark:bg-slate-800"),
        new("Aisha Patel", "VP of Product", "AP", "2:07",
            "How we decide what to build",
            "Grew HubSpot's PLG motion. Describes the product development process, how customer feedback drives the roadmap, and the metrics that matter most.",
            "bg-zinc-200 dark:bg-zinc-800"),
    ];
}
