@* ============================================================
   Block: team-member-grid
   Title: TeamMemberGrid
   Description: A team member grid block for React and Next.js displaying profile cards with names, roles, and social links built with shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-member-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="space-y-6">
        @* Header *@
        <div>
            <h2 class="text-sm font-medium">Our Team</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Meet the people building the future
            </p>
        </div>

        @* Team Grid *@
        <div class="grid gap-4 grid-cols-1 sm:grid-cols-2">
            @foreach (var member in _team)
            {
                <article class="overflow-hidden rounded-lg border bg-card p-4 transition-colors hover:bg-muted/50">
                    @* Header with name and role *@
                    <div class="mb-2">
                        <h3 class="text-sm font-medium">@member.Name</h3>
                        <p class="text-xs text-muted-foreground">@member.Role</p>
                    </div>

                    @* Bio *@
                    <p class="mb-4 text-sm leading-relaxed text-muted-foreground">@member.Bio</p>

                    @* Social Links *@
                    @if (member.Twitter != null || member.Linkedin != null || member.Github != null || member.Email != null)
                    {
                        <div class="flex items-center gap-1.5 border-t pt-3">
                            @if (member.Twitter != null)
                            {
                                <a href="@member.Twitter" target="_blank" rel="noopener noreferrer"
                                   aria-label="Twitter profile"
                                   class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground h-6 w-6">
                                    <LucideIconCn Name="twitter" Size="16" Class="size-4" />
                                </a>
                            }
                            @if (member.Linkedin != null)
                            {
                                <a href="@member.Linkedin" target="_blank" rel="noopener noreferrer"
                                   aria-label="LinkedIn profile"
                                   class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground h-6 w-6">
                                    <LucideIconCn Name="linkedin" Size="16" Class="size-4" />
                                </a>
                            }
                            @if (member.Github != null)
                            {
                                <a href="@member.Github" target="_blank" rel="noopener noreferrer"
                                   aria-label="GitHub profile"
                                   class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground h-6 w-6">
                                    <LucideIconCn Name="github" Size="16" Class="size-4" />
                                </a>
                            }
                            @if (member.Email != null)
                            {
                                <a href="@($"mailto:{member.Email}")"
                                   aria-label="Email contact"
                                   class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground h-6 w-6">
                                    <LucideIconCn Name="mail" Size="16" Class="size-4" />
                                </a>
                            }
                        </div>
                    }
                </article>
            }
        </div>
    </div>
</section>

@code {
    private record TeamMember(string Name, string Role, string Bio, string? Twitter, string? Linkedin, string? Github, string? Email);

    private static readonly TeamMember[] _team =
    [
        new("Sarah Chen", "Product Lead", "Strategic thinker focused on user experience and market fit",
            "https://twitter.com", "https://linkedin.com", null, "sarah@example.com"),
        new("Marcus Rodriguez", "Engineering Lead", "Full-stack architect passionate about scalable systems",
            null, "https://linkedin.com", "https://github.com", "marcus@example.com"),
        new("Emily Watson", "Design Lead", "Creative director obsessed with clean, minimal interfaces",
            "https://twitter.com", "https://linkedin.com", null, "emily@example.com"),
        new("Alex Kim", "Growth Lead", "Data-driven strategist building communities and partnerships",
            "https://twitter.com", "https://linkedin.com", null, "alex@example.com"),
    ];
}
