@* ============================================================
   Block: team-hiring-cta
   Title: Team Hiring CTA
   Description: Clean hiring block with team count, open roles, a brief pitch, and a list of open positions with department chips
   Dependencies: ButtonCn, LucideArrowRightCn
   Source: original/blocks/team/team-hiring-cta.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">We're hiring</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Join our team and help shape the future of developer tools</p>
        </div>

        <div class="flex items-center gap-6 border-b px-4 py-3">
            <div>
                <p class="text-2xl font-semibold tabular-nums">42</p>
                <p class="text-xs text-muted-foreground">Team members</p>
            </div>
            <div>
                <p class="text-2xl font-semibold tabular-nums text-emerald-600">5</p>
                <p class="text-xs text-muted-foreground">Open roles</p>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-sm leading-relaxed text-muted-foreground">
                We offer competitive compensation, meaningful equity, and a flexible work environment.
                Our team spans 8 countries and 12 time zones, building tools that developers rely on
                every day.
            </p>
        </div>

        <div>
            @for (var i = 0; i < _positions.Length; i++)
            {
                var position = _positions[i];
                <div class="@Cn.Merge("flex items-center justify-between gap-3 px-4 py-3", i < _positions.Length - 1 ? "border-b" : "")">
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@position.Title</p>
                        <p class="text-xs text-muted-foreground">@position.Type</p>
                    </div>
                    <span class="shrink-0 rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@position.Department</span>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" Href="#">
                View All Roles
                <LucideArrowRightCn Size="12" Class="size-3" />
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record PositionItem(string Title, string Department, string Type);
    private static readonly PositionItem[] _positions =
    [
        new("Senior Frontend Engineer", "Engineering", "Full-time, Remote"),
        new("Product Marketing Manager", "Marketing", "Full-time, Hybrid"),
        new("Developer Advocate", "DevRel", "Full-time, Remote"),
        new("Senior Product Designer", "Design", "Full-time, Remote"),
        new("Data Engineer", "Engineering", "Full-time, On-site"),
    ];
}
