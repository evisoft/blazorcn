@* ============================================================
   Block: team-animated-stack
   Title: Team Animated Stack
   Description: Vertically stacked animated team profiles with staggered slide-in entrance from left using framer-motion for React and Next.js team pages
   Long Description: Static vertically stacked team member sections
   Dependencies: None
   Source: original/blocks/team/team-animated-stack.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Leadership</p>
            <p class="mt-0.5 text-xs text-muted-foreground">The people steering the vision</p>
        </div>

        @for (var i = 0; i < _members.Length; i++)
        {
            var member = _members[i];
            <div class="@Cn.Merge("px-4 py-4", i < _members.Length - 1 ? "border-b" : "")">
                <div class="flex items-center gap-3">
                    <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @member.Initials
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@member.Name</span>
                            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                @member.Department
                            </span>
                        </div>
                        <p class="text-xs text-muted-foreground">@member.Role</p>
                    </div>
                </div>
                <p class="mt-3 pl-[52px] text-sm text-muted-foreground leading-relaxed">
                    @member.Bio
                </p>
            </div>
        }
    </div>
</section>

@code {
    private record MemberItem(string Name, string Role, string Bio, string Initials, string Department);

    private static readonly MemberItem[] _members =
    [
        new("Ingrid Solberg", "Chief Executive Officer", "Serial entrepreneur with two successful exits in developer tooling. Previously built infrastructure software used by 10,000 engineering teams. Focused on making complex workflows accessible through thoughtful product design.", "IS", "Leadership"),
        new("James Okoye", "Chief Technology Officer", "Former principal engineer at Cloudflare where he designed edge computing systems handling 45 million requests per second. Open-source contributor with deep expertise in distributed systems and database internals.", "JO", "Engineering"),
        new("Mei-Lin Wu", "VP of Engineering", "Built and scaled engineering organizations from 5 to 80 people across two startups. Known for establishing engineering cultures that ship fast without sacrificing code quality or team wellbeing.", "MW", "Engineering"),
        new("Anders Holm", "VP of Design", "Former design director at Airbnb where he redesigned host onboarding, reducing drop-off by 34 percent. Believes great design is invisible and that every pixel should serve the user's intent.", "AH", "Design"),
        new("Priya Kapoor", "VP of Product", "Joined from Linear during its hypergrowth phase. Developed the prioritization framework the team still uses today. Obsessed with reducing time-to-value for new users through ruthless simplicity.", "PK", "Product"),
        new("Felix Brennan", "Head of Growth", "Previously led growth at Spotify where he designed referral systems driving 40 percent of organic signups. Combines data analysis with creative experimentation to find scalable acquisition channels.", "FB", "Marketing"),
    ];
}
