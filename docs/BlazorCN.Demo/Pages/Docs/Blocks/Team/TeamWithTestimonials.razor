@* ============================================================
   Block: team-with-testimonials
   Title: Team With Testimonials
   Description: Team member rows with personal quotes about working at the company
   Dependencies: None
   Source: original/blocks/team/team-with-testimonials.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">In their own words</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Honest answers from the people who build it</p>
        </div>

        @for (var i = 0; i < _members.Length; i++)
        {
            var member = _members[i];
            <div class="@Cn.Merge("px-4 py-3", i < _members.Length - 1 ? "border-b" : "")">
                <div class="flex items-center gap-3">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@member.Initials</div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@member.Name</span>
                            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@member.Department</span>
                        </div>
                        <div class="text-xs text-muted-foreground">@member.Role</div>
                    </div>
                </div>
                <p class="mt-2 pl-11 text-sm text-muted-foreground italic leading-relaxed">&ldquo;@member.Quote&rdquo;</p>
            </div>
        }
    </div>
</section>

@code {
    private record MemberItem(string Name, string Role, string Initials, string Department, string Quote);
    private static readonly MemberItem[] _members =
    [
        new("Zara Mitchell", "Senior Product Designer", "ZM", "Design", "I joined because the founders understood that design is not decoration. It is how the product thinks. Two years in, that belief has only gotten stronger."),
        new("Tomas Rivera", "Staff Engineer", "TR", "Engineering", "The codebase is the cleanest I have ever worked in. When your tooling respects developers, the developers respect the tooling. It is a virtuous cycle."),
        new("Nadia Kuznetsova", "Head of Customer Success", "NK", "Customer Success", "What surprised me most is how much engineering time goes into customer-facing improvements. Feature requests here do not disappear into a backlog. They ship."),
        new("James Okonkwo", "Engineering Manager", "JO", "Engineering", "We have real autonomy here. My team owns their roadmap end to end. Leadership sets the vision and trusts us to find the best path to get there."),
        new("Hana Yoshida", "Product Manager", "HY", "Product", "Every product decision starts with what does the user actually need, not what is trending. That discipline is rare and it shows in the product."),
        new("Andre Dupont", "DevRel Engineer", "AD", "Developer Relations", "I get to code, write, and teach every single week. Most DevRel roles slowly turn into marketing. Here, I am still an engineer who happens to love explaining things."),
    ];
}
