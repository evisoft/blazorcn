@* ============================================================
   Block: team-member-work-style-preferences
   Title: TeamMemberWorkStylePreferences
   Description: A work style and preferences display block for React and Next.js showing team member preferences built with shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-member-work-style-preferences.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="space-y-4">
        <div>
            <h2 class="text-sm font-medium">Work Style Preferences</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">How team members work best</p>
        </div>

        <div class="space-y-4">
            @foreach (var member in _team)
            {
                <div class="rounded-lg border bg-card p-4">
                    <h3 class="mb-3 text-sm font-medium">@member.Name</h3>
                    <div class="space-y-2">
                        @foreach (var pref in member.Preferences)
                        {
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-medium text-muted-foreground">@pref.Category</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@pref.Value</BadgeCn>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Preference(string Category, string Value);

    private record TeamMember(string Name, Preference[] Preferences);

    private static readonly TeamMember[] _team =
    [
        new("Sarah Chen",
        [
            new("Work Location", "Hybrid (3 days office)"),
            new("Communication", "Async-first with sync meetings"),
            new("Feedback", "Direct and specific"),
            new("Focus Time", "Mornings before 11am"),
        ]),
        new("Marcus Rodriguez",
        [
            new("Work Location", "Remote-first"),
            new("Communication", "Detailed written docs"),
            new("Feedback", "Specific examples"),
            new("Focus Time", "Deep work blocks 2-5pm"),
        ]),
    ];
}
