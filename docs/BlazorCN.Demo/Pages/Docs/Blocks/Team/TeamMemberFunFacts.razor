@* ============================================================
   Block: team-member-fun-facts
   Title: TeamMemberFunFacts
   Description: A fun facts showcase block for React and Next.js displaying team member interests and hobbies built with shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-member-fun-facts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="space-y-4">

        @* Header *@
        <div>
            <h2 class="text-sm font-medium">Fun Facts</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Interesting things about our team</p>
        </div>

        @* Facts Grid *@
        <div class="grid gap-3 grid-cols-1 sm:grid-cols-2">
            @foreach (var fact in _facts)
            {
                <div class="rounded-lg border bg-card p-3 transition-colors hover:bg-muted/50">
                    <div class="flex items-start gap-3">
                        <span class="text-2xl shrink-0">@fact.Emoji</span>
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium">@fact.Name</p>
                            <p class="mt-1 text-sm text-muted-foreground">@fact.Fact</p>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record FunFactItem(string Id, string Name, string Emoji, string Fact);

    private static readonly FunFactItem[] _facts =
    [
        new("1", "Sarah Chen", "🧗", "Avid rock climber - scaled 5.11d routes"),
        new("2", "Marcus Rodriguez", "🎮", "Speedrunner - holds personal best in Elden Ring"),
        new("3", "Emily Watson", "🎨", "Watercolor artist with gallery exhibitions"),
        new("4", "Alex Kim", "🌱", "Growing 50+ plants in their apartment"),
        new("5", "Jordan Lee", "🏃", "Marathon runner - completed 8 marathons"),
    ];
}
