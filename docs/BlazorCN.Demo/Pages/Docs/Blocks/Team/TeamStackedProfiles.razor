@* ============================================================
   Block: team-stacked-profiles
   Title: Team Stacked Profiles
   Description: Vertically stacked full-width team member sections with initials, name, role, and bio
   Dependencies: None
   Source: original/blocks/team/team-stacked-profiles.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Leadership</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">The team steering the vision</p>
        </div>

        @for (var i = 0; i < _members.Length; i++)
        {
            var member = _members[i];
            <div class="@Cn.Merge("px-4 py-4", i < _members.Length - 1 ? "border-b" : "")">
                <div class="flex items-center gap-3">
                    <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@member.Initials</div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@member.Name</span>
                            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@member.Department</span>
                        </div>
                        <div class="text-xs text-muted-foreground">@member.Role</div>
                    </div>
                </div>
                <p class="mt-3 pl-[52px] text-sm text-muted-foreground leading-relaxed">@member.Bio</p>
            </div>
        }
    </div>
</section>

@code {
    private record MemberItem(string Name, string Role, string Bio, string Initials, string Department);
    private static readonly MemberItem[] _members =
    [
        new("Camila Reyes", "Chief Executive Officer", "Serial entrepreneur with two successful exits. Previously co-founded a developer tools company acquired by GitHub. Passionate about making software development accessible to everyone.", "CR", "Leadership"),
        new("Marcus Bell", "Chief Technology Officer", "Former distinguished engineer at Google Cloud. Architected systems processing petabytes of data daily. Open-source maintainer with 50K+ GitHub stars across projects.", "MB", "Engineering"),
        new("Aaliya Rahman", "Chief Product Officer", "Built product organizations at Notion and Figma. Known for identifying market opportunities that become category-defining features. Advisor to Y Combinator startups.", "AR", "Product"),
        new("Tobias Muller", "Chief Design Officer", "Former design director at Apple's Human Interface team. Believes great design is invisible. Led the redesign of three products with over 100M active users worldwide.", "TM", "Design"),
    ];
}
