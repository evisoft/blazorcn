@* ============================================================
   Block: team-office-tour
   Title: Team Office Tour
   Description: Virtual office tour showcasing team member workspaces with desk setup details, workspace type, city, and favorite tools
   Dependencies: none (pure HTML/Tailwind)
   Source: original/blocks/team/team-office-tour.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideMonitorCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">Workspaces</span>
            <span class="ml-auto text-xs text-muted-foreground">@_workspaces.Length setups</span>
        </div>

        @foreach (var workspace in _workspaces)
        {
            var isExpanded = _expanded == workspace.Name;
            <div class="border-b last:border-b-0">
                <button type="button"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => _expanded = isExpanded ? null : workspace.Name)">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @workspace.Initials
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="truncate text-sm font-medium">@workspace.Name</span>
                            <span class="shrink-0 rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                @workspace.WorkspaceType
                            </span>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">@workspace.City</p>
                    </div>
                    <LucideChevronRightCn Size="16"
                                          Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                </button>
                @if (isExpanded)
                {
                    <div class="border-t bg-muted/30 px-4 py-3">
                        <p class="text-xs font-medium text-muted-foreground">On their desk</p>
                        <div class="mt-2 flex flex-wrap gap-1.5">
                            @foreach (var item in workspace.DeskItems)
                            {
                                <span class="rounded bg-background px-2 py-1 text-xs text-foreground">
                                    @item
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record Workspace(string Name, string Initials, string WorkspaceType, string City, string[] DeskItems);

    private string? _expanded;

    private static readonly Workspace[] _workspaces =
    [
        new("Sarah Chen", "SC", "Standing desk", "San Francisco", ["Keychron Q1 keyboard", "LG 5K monitor", "Fidget cube"]),
        new("Marcus Johnson", "MJ", "Home office", "Austin", ["Dual ultrawide monitors", "Herman Miller Aeron", "Espresso machine nearby"]),
        new("Elena Rodriguez", "ER", "Coworking", "Barcelona", ["iPad for sketching", "Bose QC headphones"]),
        new("David Kim", "DK", "Standing desk", "Seoul", ["HHKB Pro keyboard", "Vertical mouse", "Monstera plant"]),
        new("Aisha Patel", "AP", "Home office", "London", ["Ring light for video calls", "Whiteboard wall", "Tea collection"]),
        new("Tomas Reyes", "TR", "Coworking", "Mexico City", ["Portable monitor", "Moleskine notebook", "AirPods Max"]),
        new("Priya Chandrasekaran", "PC", "Home office", "Bangalore", ["Curved monitor", "Succulent garden", "Mechanical numpad"]),
        new("Lena Johansson", "LJ", "Standing desk", "Stockholm", ["Thunderbolt dock", "Balance board", "Desk lamp"]),
    ];
}
