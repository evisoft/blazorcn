@* ============================================================
   Block: team-profile-drawer
   Title: Team Profile Drawer
   Description: Expandable team member rows with inline detail panels, career stats, and quotes
   Dependencies: none (pure HTML/Tailwind)
   Source: original/blocks/team/team-profile-drawer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Meet the team</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Click any member to learn more about their background.
            </p>
        </div>

        @for (var i = 0; i < _members.Length; i++)
        {
            var member = _members[i];
            var isExpanded = _expanded == member.Name;
            var isLast = i == _members.Length - 1;
            <div class="@(!isLast ? "border-b" : "")">
                <button type="button"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => _expanded = isExpanded ? null : member.Name)">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @member.Initials
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@member.Name</span>
                            <span class="hidden rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground sm:inline">
                                @member.Department
                            </span>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">@member.Role</p>
                    </div>
                    <LucideChevronRightCn Size="16"
                                          Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                </button>

                @if (isExpanded)
                {
                    <div class="border-t bg-muted/20 px-4 py-4">
                        <p class="text-sm italic text-muted-foreground">
                            &ldquo;@member.Quote&rdquo;
                        </p>

                        <p class="mt-3 text-xs leading-relaxed text-muted-foreground">@member.Bio</p>

                        <div class="mt-4 flex items-center gap-6">
                            @foreach (var stat in member.Stats)
                            {
                                <div>
                                    <p class="text-sm font-medium tabular-nums">@stat.Value</p>
                                    <p class="text-xs text-muted-foreground">@stat.Label</p>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record StatItem(string Label, string Value);
    private record TeamMember(string Name, string Role, string Department, string Bio, string Quote, string Initials, StatItem[] Stats);

    private string? _expanded;

    private static readonly TeamMember[] _members =
    [
        new("Ingrid Solberg", "Chief Executive Officer", "Leadership",
            "Founded the company after a decade running product at Stripe. Scaled Connect from beta launch to processing over $200 billion annually. CS degree from KTH Stockholm, MBA from INSEAD.",
            "The best products disappear into the workflow. You should feel the outcome, not the tool.",
            "IS", [new("Years leading", "12"), new("Companies founded", "3"), new("Capital raised", "$140M")]),
        new("Marcus Chen", "Chief Technology Officer", "Engineering",
            "Eight years at Google leading Cloud Spanner's multi-region replication team. Architected the platform from scratch, achieving 99.99% uptime across three continents.",
            "Reliability is not a feature. It is the foundation every other feature stands on.",
            "MC", [new("Years experience", "18"), new("Engineers led", "200+"), new("Platform uptime", "99.99%")]),
        new("Amara Osei", "VP of Design", "Design",
            "Led the design of FigJam at Figma from concept to millions of users. Previously redesigned Airbnb's host onboarding, reducing drop-off by 34 percent.",
            "Design is not how it looks. Design is the moment someone does not have to think.",
            "AO", [new("Years experience", "11"), new("Users impacted", "50M+"), new("Design awards", "3")]),
        new("Leo Virtanen", "Head of Engineering", "Engineering",
            "Built edge computing infrastructure at Cloudflare serving 25 million requests per second. Grew the engineering organization from 12 to 80 people.",
            "Fast teams ship fast software. Culture is architecture.",
            "LV", [new("Years experience", "14"), new("Team grown to", "80"), new("P99 latency", "<50ms")]),
        new("Sofia Reyes", "VP of Product", "Product",
            "Led product at Linear during hypergrowth, then defined the developer experience at Vercel. Built experimentation frameworks running over 200 A/B tests per quarter.",
            "Every feature request is someone telling you about a job they need done.",
            "SR", [new("Years experience", "10"), new("Products shipped", "8"), new("Peak DAUs", "2M+")]),
        new("Daniel Eriksson", "Head of Growth", "Marketing",
            "Engineered Spotify's creator marketplace growth engine. Led product-led growth at two YC startups from seed to Series B.",
            "The best growth channels are the ones your product builds for itself.",
            "DE", [new("Years experience", "9"), new("ARR growth", "12x"), new("Users acquired", "500K+")]),
    ];
}
