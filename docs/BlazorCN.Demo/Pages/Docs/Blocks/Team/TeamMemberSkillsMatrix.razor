@* ============================================================
   Block: team-member-skills-matrix
   Title: TeamMemberSkillsMatrix
   Description: A skills matrix heatmap for React and Next.js displaying team member proficiency levels across different skills built with shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-member-skills-matrix.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="space-y-4">
        @* Header *@
        <div>
            <h2 class="text-sm font-medium">Skills Matrix</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Team proficiency levels across skills
            </p>
        </div>

        @* Matrix *@
        <div class="overflow-x-auto rounded-lg border bg-card">
            <div class="inline-block min-w-full">
                @* Header Row *@
                <div class="flex border-b">
                    <div class="w-40 flex-shrink-0 border-r px-4 py-3 text-sm font-medium">
                        Team Members
                    </div>
                    @foreach (var skill in _allSkills)
                    {
                        <div class="w-32 flex-shrink-0 border-r px-3 py-3 text-center">
                            <p class="truncate text-xs font-medium">@skill</p>
                        </div>
                    }
                </div>

                @* Data Rows *@
                @for (var mi = 0; mi < _team.Length; mi++)
                {
                    var member = _team[mi];
                    var isLast = mi == _team.Length - 1;
                    <div class="@(isLast ? "flex" : "flex border-b")">
                        <div class="w-40 flex-shrink-0 border-r px-4 py-3">
                            <p class="text-sm font-medium">@member.Name</p>
                        </div>
                        @foreach (var skill in _allSkills)
                        {
                            var skillData = member.Skills.FirstOrDefault(s => s.Skill == skill);
                            var hasSKill = skillData != null;
                            var colorClass = hasSKill ? ProficiencyColor(skillData!.Proficiency) : "bg-muted/30";
                            <div class="w-32 flex-shrink-0 border-r px-3 py-3">
                                <div class="flex items-center justify-center">
                                    <div class="@Cn.Merge("size-8 rounded-lg flex items-center justify-center", colorClass)">
                                        @if (hasSKill)
                                        {
                                            <span class="text-xs font-medium text-white">@skillData!.Proficiency</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Legend *@
        <div class="rounded-lg bg-muted/30 p-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Proficiency Levels</p>
            <div class="flex flex-wrap gap-3">
                @foreach (var item in _legendItems)
                {
                    <div class="flex items-center gap-2">
                        <div class="@Cn.Merge("size-3 rounded", ProficiencyColor(item.Level))"></div>
                        <span class="text-xs text-muted-foreground">@item.Label</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record SkillLevel(string Skill, int Proficiency);

    private record TeamMemberSkills(string Name, SkillLevel[] Skills);

    private static readonly TeamMemberSkills[] _team =
    [
        new("Sarah Chen", [
            new("Product Strategy", 5),
            new("User Research", 4),
            new("Data Analysis", 4),
            new("Communication", 5),
            new("Leadership", 4),
        ]),
        new("Marcus Rodriguez", [
            new("Backend Development", 5),
            new("System Design", 4),
            new("DevOps", 3),
            new("Communication", 3),
            new("Leadership", 4),
        ]),
        new("Emily Watson", [
            new("UI Design", 5),
            new("UX Design", 4),
            new("Design Systems", 4),
            new("Communication", 4),
            new("Leadership", 3),
        ]),
    ];

    private static readonly string[] _allSkills = _team
        .SelectMany(t => t.Skills.Select(s => s.Skill))
        .Distinct()
        .ToArray();

    private record LegendItem(int Level, string Label);

    private static readonly LegendItem[] _legendItems =
    [
        new(5, "Master"),
        new(4, "Expert"),
        new(3, "Proficient"),
        new(2, "Intermediate"),
        new(1, "Beginner"),
    ];

    private static string ProficiencyColor(int level) => level switch
    {
        5 => "bg-emerald-600",
        4 => "bg-emerald-500",
        3 => "bg-amber-500",
        2 => "bg-orange-500",
        1 => "bg-red-500",
        _ => "bg-muted",
    };
}
