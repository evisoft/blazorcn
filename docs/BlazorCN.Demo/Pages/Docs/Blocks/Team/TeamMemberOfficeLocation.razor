@* ============================================================
   Block: team-member-office-location
   Title: TeamMemberOfficeLocation
   Description: An office location and desk mapping block for React and Next.js displaying team locations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-member-office-location.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="space-y-4">
        <div>
            <h2 class="text-sm font-medium">Office Locations</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Team member locations and desk assignments
            </p>
        </div>

        <div class="space-y-2">
            @foreach (var member in _team)
            {
                <div class="flex items-center justify-between rounded-lg border bg-card px-4 py-2.5 hover:bg-muted/50">
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@member.Name</p>
                        <p class="text-xs text-muted-foreground">@member.Location</p>
                    </div>
                    <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs shrink-0">
                        <LucideIconCn Name="map-pin" Size="10" Class="size-2.5 mr-1" />
                        @member.Desk
                    </BadgeCn>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TeamMember(string Name, string Location, string Desk, string Floor);

    private static readonly TeamMember[] _team =
    [
        new("Sarah Chen", "San Francisco", "SF-203", "2"),
        new("Marcus Rodriguez", "Remote", "N/A", "N/A"),
        new("Emily Watson", "San Francisco", "SF-215", "2"),
        new("Alex Kim", "New York", "NYC-105", "1"),
    ];
}
