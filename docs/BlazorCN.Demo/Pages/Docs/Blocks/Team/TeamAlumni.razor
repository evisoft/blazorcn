@* ============================================================
   Block: team-alumni
   Title: Team Alumni
   Description: Company alumni network display showing former team members with tenure dates, past roles, and current companies in clean bordered rows
   Long Description: Vertical timeline showing when each member joined
   Dependencies: LucideArrowRightCn
   Source: original/blocks/team/team-alumni.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Alumni network</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_alumni.Length former team members building at top companies
            </p>
        </div>
        @foreach (var person in _alumni)
        {
            <div class="flex items-center gap-3 border-b px-4 py-3 last:border-b-0">
                <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                    @person.Initials
                </div>
                <div class="min-w-0 flex-1">
                    <div class="flex items-baseline gap-2">
                        <span class="truncate text-sm font-medium">@person.Name</span>
                        <span class="hidden shrink-0 text-xs text-muted-foreground sm:inline">
                            @person.TenureStart&ndash;@person.TenureEnd
                        </span>
                    </div>
                    <p class="mt-0.5 truncate text-xs text-muted-foreground">
                        @person.Role
                        <span class="mx-1.5">&middot;</span>
                        <span class="sm:hidden">
                            @person.TenureStart&ndash;@person.TenureEnd
                        </span>
                        <span class="hidden sm:inline">@person.Department</span>
                    </p>
                </div>
                <div class="hidden shrink-0 items-center gap-1.5 sm:flex">
                    <LucideArrowRightCn Class="size-3 text-muted-foreground/60" Size="12" />
                    <div class="text-right">
                        <p class="text-sm font-medium">@person.NowAt</p>
                        <p class="text-xs text-muted-foreground">@person.NowRole</p>
                    </div>
                </div>
                <div class="flex shrink-0 items-center gap-1.5 sm:hidden">
                    <LucideArrowRightCn Class="size-3 text-muted-foreground/60" Size="12" />
                    <span class="text-xs font-medium">@person.NowAt</span>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record AlumniMember(string Name, string Initials, string Role, string Department, string TenureStart, string TenureEnd, string NowAt, string NowRole);

    private static readonly AlumniMember[] _alumni =
    [
        new("Cassandra Yeboah", "CY", "Head of Product", "Product", "2019", "2023", "Stripe", "VP of Product"),
        new("Marcus Bell", "MB", "Staff Engineer", "Engineering", "2018", "2022", "OpenAI", "Principal Engineer"),
        new("Aaliya Rahman", "AR", "Senior Designer", "Design", "2020", "2024", "Figma", "Design Lead"),
        new("Henrik Johansson", "HJ", "Engineering Manager", "Engineering", "2017", "2021", "Vercel", "Director of Engineering"),
        new("Fatima Al-Rashid", "FA", "Data Scientist", "Data", "2021", "2024", "Anthropic", "Senior Research Scientist"),
        new("Oscar Duarte", "OD", "VP of Marketing", "Marketing", "2019", "2023", "Linear", "CMO"),
        new("Mei-Ling Huang", "MH", "Product Manager", "Product", "2020", "2024", "Notion", "Senior PM"),
        new("James O'Sullivan", "JO", "DevOps Engineer", "Engineering", "2018", "2022", "Datadog", "Staff SRE"),
    ];
}
