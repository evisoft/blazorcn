@* ============================================================
   Block: team-grid-cards
   Title: Team Block Grid Cards
   Description: Flat row layout showing team members with initials, roles, department chips, and bios for React team sections
   Long Description: Display your team in a clean, scannable list format. Each row shows a member's initials, name, role, department, and a short bio separated by subtle dividers. The flat design eliminates card nesting in favor of border-separated rows that feel lightweight and modern. Built with Tailwind CSS and optimized for readability across breakpoints.
   Dependencies: None
   Source: original/blocks/team/team-grid-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Team</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                A diverse team of builders, designers, and strategists united by a shared mission.
            </p>
        </div>
        @for (var i = 0; i < _members.Length; i++)
        {
            var member = _members[i];
            <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3", i < _members.Length - 1 ? "border-b" : "")">
                <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                    @member.Initials
                </div>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-medium">@member.Name</span>
                        <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                            @member.Department
                        </span>
                    </div>
                    <p class="mt-0.5 text-xs text-muted-foreground">@member.Role</p>
                    <p class="mt-1 text-xs text-muted-foreground leading-relaxed">@member.Bio</p>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record MemberItem(string Name, string Role, string Bio, string Initials, string Department);

    private static readonly MemberItem[] _members =
    [
        new("Sarah Chen", "Chief Executive Officer", "Former VP at Stripe. 15 years scaling fintech startups from seed to Series D across three continents.", "SC", "Leadership"),
        new("Marcus Johnson", "Head of Engineering", "Ex-Google Staff Engineer. Architected distributed systems handling 2M requests per second at peak.", "MJ", "Engineering"),
        new("Elena Rodriguez", "Senior Product Designer", "Award-winning designer from Figma. Passionate about design systems and accessible interfaces.", "ER", "Design"),
        new("David Kim", "Staff Software Engineer", "Open source contributor and Rust enthusiast. Previously built developer tools at Vercel.", "DK", "Engineering"),
        new("Aisha Patel", "VP of Marketing", "Grew HubSpot's PLG motion from $10M to $80M ARR. Expert in product-led growth and content strategy.", "AP", "Marketing"),
        new("James O'Brien", "Engineering Manager", "Led platform teams at Shopify and Datadog. Advocates for developer experience and engineering culture.", "JO", "Engineering"),
        new("Yuki Tanaka", "Product Manager", "Previously at Linear and Notion. Focused on building delightful workflows for technical teams.", "YT", "Product"),
        new("Priya Sharma", "UX Researcher", "PhD in Human-Computer Interaction from Stanford. Translates user insights into actionable design decisions.", "PS", "Design"),
    ];
}
