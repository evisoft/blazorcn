@* ============================================================
   Block: team-side-projects
   Title: Team Side Projects
   Description: Team members' side projects and open source contributions with project names, descriptions, tech stack chips, and star and fork counts
   Dependencies: none (pure HTML/Tailwind)
   Source: original/blocks/team/team-side-projects.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Side projects &amp; open source</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                What the team builds outside of work
            </p>
        </div>

        @foreach (var project in _projects)
        {
            var isExpanded = _expandedProject == project.ProjectName;
            <div class="border-b last:border-b-0">
                <button type="button"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => _expandedProject = isExpanded ? null : project.ProjectName)">
                    <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @project.MemberInitials
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-baseline gap-2">
                            <span class="font-mono text-sm font-medium">@project.ProjectName</span>
                            <span class="hidden text-xs text-muted-foreground sm:inline">
                                by @project.MemberName
                            </span>
                        </div>
                        <p class="mt-0.5 truncate text-xs text-muted-foreground">
                            @project.Description
                        </p>
                    </div>
                    <div class="hidden shrink-0 items-center gap-3 sm:flex">
                        <span class="flex items-center gap-1 font-mono text-xs text-muted-foreground">
                            <LucideStarCn Size="12" Class="size-3" />
                            @FormatNumber(project.Stars)
                        </span>
                        <span class="flex items-center gap-1 font-mono text-xs text-muted-foreground">
                            <LucideGitForkCn Size="12" Class="size-3" />
                            @FormatNumber(project.Forks)
                        </span>
                    </div>
                    <LucideChevronRightCn Size="16"
                                          Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                </button>

                @if (isExpanded)
                {
                    <div class="border-t bg-muted/30 px-4 py-3">
                        <div class="ml-10 space-y-2">
                            <div class="flex items-center gap-3 sm:hidden">
                                <span class="flex items-center gap-1 font-mono text-xs text-muted-foreground">
                                    <LucideStarCn Size="12" Class="size-3" />
                                    @FormatNumber(project.Stars)
                                </span>
                                <span class="flex items-center gap-1 font-mono text-xs text-muted-foreground">
                                    <LucideGitForkCn Size="12" Class="size-3" />
                                    @FormatNumber(project.Forks)
                                </span>
                            </div>
                            <p class="text-xs leading-relaxed text-muted-foreground">
                                @project.ExtendedDescription
                            </p>
                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var t in project.Tech)
                                {
                                    <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                        @t
                                    </span>
                                }
                            </div>
                            <a href="@project.Url"
                               class="inline-block text-xs text-muted-foreground underline-offset-2 hover:text-foreground hover:underline">
                                View on GitHub
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record SideProject(string MemberName, string MemberInitials, string MemberRole,
        string ProjectName, string Description, string ExtendedDescription, string[] Tech, int Stars, int Forks, string Url);

    private string? _expandedProject;

    private static readonly SideProject[] _projects =
    [
        new("Kofi Asante", "KA", "Staff Engineer", "fastcache",
            "In-memory LRU cache with TTL for Node.js",
            "A high-performance LRU cache implementation for Node.js that supports TTL expiration, size-based eviction, and batch operations. Used in production at three companies to reduce Redis round-trips by 60%. Benchmarks show 2.4M ops/sec on M2 hardware.",
            ["TypeScript", "Node.js"], 2841, 187, "#"),
        new("Elena Rodriguez", "ER", "Senior Designer", "figma-token-sync",
            "Sync Figma variables to CSS and Tailwind config",
            "A Figma plugin and CLI that exports design tokens as CSS custom properties and Tailwind CSS config. Supports semantic token naming, dark mode mappings, and automatic PR creation when tokens change. Adopted by 400+ design systems teams.",
            ["TypeScript", "Figma API", "Tailwind"], 1203, 94, "#"),
        new("Aarav Sharma", "AS", "Backend Engineer", "pgqueue",
            "Postgres-backed job queue with zero dependencies",
            "A lightweight job queue built entirely on PostgreSQL advisory locks and SKIP LOCKED. No Redis, no RabbitMQ, no external dependencies. Supports delayed jobs, retries with exponential backoff, and dead letter queues. Processing 1.2M jobs/day in production.",
            ["Go", "PostgreSQL"], 4127, 312, "#"),
        new("Tomoko Nakamura", "TN", "ML Engineer", "embedrank",
            "Fast document re-ranking with sentence embeddings",
            "A Python library for document re-ranking using sentence-level embeddings and cross-encoder scoring. Optimized for low-latency RAG pipelines. Supports ONNX runtime for 3x faster inference. Integrated with LangChain and LlamaIndex.",
            ["Python", "PyTorch", "ONNX"], 892, 63, "#"),
        new("Lucia Fernandez", "LF", "Product Designer", "color-a11y",
            "WCAG contrast checker CLI with auto-fix suggestions",
            "A command-line tool that audits color palettes for WCAG 2.1 AA and AAA compliance. Reads CSS files, Tailwind configs, or design token JSON and suggests nearest compliant alternatives. Used in CI pipelines at 200+ projects to catch accessibility regressions.",
            ["Rust", "CLI"], 567, 41, "#"),
    ];

    private static string FormatNumber(int num) => num >= 1000 ? $"{num / 1000.0:F1}k" : num.ToString();
}
