@* ============================================================
   Block: team-open-source
   Title: Team Open Source Contributors
   Description: Open source contributors panel showing team members with GitHub commit counts, repository chips, and maintainer or contributor role indicators
   Dependencies: none (pure HTML/Tailwind)
   Source: original/blocks/team/team-open-source.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Open source</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_totalCommits.ToString("N0") commits across @_uniqueRepos repositories
            </p>
        </div>
        @foreach (var contributor in _contributors)
        {
            var isExpanded = _expanded == contributor.Name;
            <div class="border-b last:border-b-0">
                <button type="button"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => _expanded = isExpanded ? null : contributor.Name)">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @contributor.Initials
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@contributor.Name</span>
                            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                @contributor.Role
                            </span>
                        </div>
                        <div class="mt-1 flex items-center gap-1.5">
                            <LucideGitCommitHorizontalCn Size="12" Class="size-3 text-muted-foreground/60" />
                            <span class="text-xs font-medium tabular-nums">
                                @contributor.Commits.ToString("N0")
                            </span>
                            <span class="mx-1 text-muted-foreground/40">&middot;</span>
                            <div class="flex items-center gap-1 overflow-hidden">
                                @foreach (var repo in contributor.Repositories)
                                {
                                    <span class="shrink-0 rounded bg-muted px-1.5 py-0.5 font-mono text-xs text-muted-foreground">
                                        @repo
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                    <LucideChevronRightCn Size="16"
                                          Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                </button>
                @if (isExpanded)
                {
                    <div class="border-t bg-muted/30 px-4 py-3">
                        <p class="ml-11 text-xs leading-relaxed text-muted-foreground">
                            @contributor.Bio
                        </p>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record ContributorItem(string Name, string Initials, int Commits, string[] Repositories, string Role, string Bio);

    private string? _expanded;

    private static readonly ContributorItem[] _contributors =
    [
        new("Kofi Asante", "KA", 1842, ["next.js", "turbopack", "swr"], "maintainer",
            "Core maintainer of Turbopack's bundler pipeline. Built the incremental compilation engine that reduced rebuild times by 10x."),
        new("Lucia Fernandez", "LF", 967, ["radix-ui", "shadcn-ui"], "maintainer",
            "Designed and implemented the accessible dialog and popover primitives used by thousands of applications."),
        new("Aarav Sharma", "AS", 734, ["prisma", "drizzle-orm", "kysely"], "contributor",
            "Contributed connection pooling improvements and query plan caching to Prisma's engine layer."),
        new("Maren Lindqvist", "ML", 521, ["tailwindcss", "headlessui"], "contributor",
            "Added container query support and improved JIT compiler performance for complex utility patterns."),
        new("Tomoko Nakamura", "TN", 489, ["pytorch", "transformers", "vllm"], "contributor",
            "Optimized attention kernel implementations and contributed mixed-precision training utilities."),
        new("Elise Beaumont", "EB", 312, ["storybook", "chromatic"], "contributor",
            "Built the interaction testing framework and improved visual regression detection accuracy."),
    ];

    private static readonly int _totalCommits = _contributors.Sum(c => c.Commits);
    private static readonly int _uniqueRepos = _contributors.SelectMany(c => c.Repositories).Distinct().Count();
}
