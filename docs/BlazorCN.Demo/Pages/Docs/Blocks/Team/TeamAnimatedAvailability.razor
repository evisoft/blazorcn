@* ============================================================
   Block: team-animated-availability
   Title: Team Animated Availability
   Description: Real-time team availability board with pulsing status dots and animated status transitions
   Dependencies: None
   Source: original/blocks/team/team-animated-availability.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Team availability</p>
            <div class="mt-1 flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_members.Count(m => m.Status == "online") online
                </span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_members.Count(m => m.Status == "busy") busy
                </span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-zinc-400 dark:bg-zinc-600"></span>
                    @_members.Count(m => m.Status == "offline") offline
                </span>
            </div>
        </div>

        <div>
            @foreach (var member in _members)
            {
                <div class="flex items-center gap-3 border-b px-4 py-3 last:border-b-0">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@member.Initials</div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="truncate text-sm font-medium">@member.Name</span>
                            <span class="hidden rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground sm:inline">@member.Role</span>
                        </div>
                        <div class="mt-0.5 flex items-center gap-1.5">
                            <span class="font-mono text-xs text-muted-foreground">@member.Timezone</span>
                            <span class="text-muted-foreground/40">&middot;</span>
                            <span class="truncate text-xs text-muted-foreground">@member.Activity</span>
                        </div>
                    </div>
                    <div class="flex shrink-0 items-center gap-2">
                        <span class="hidden text-xs text-muted-foreground sm:inline">@GetStatusLabel(member.Status)</span>
                        <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs" @onclick="@(() => ToggleStatus(member.Id))"
                                  Class="relative rounded-full"
                                  aria-label="@($"Toggle status for {member.Name}")">
                            <span class="@Cn.Merge("size-2.5 rounded-full", GetStatusColor(member.Status))"></span>
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private static string GetStatusColor(string status) => status switch
    {
        "online" => "bg-emerald-500",
        "busy" => "bg-amber-500",
        "offline" => "bg-zinc-400 dark:bg-zinc-600",
        _ => "bg-zinc-400",
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "online" => "Online",
        "busy" => "Busy",
        "offline" => "Offline",
        _ => "Unknown",
    };

    private static string GetNextStatus(string status) => status switch
    {
        "online" => "busy",
        "busy" => "offline",
        "offline" => "online",
        _ => "online",
    };

    private void ToggleStatus(string id)
    {
        var member = _members.FirstOrDefault(m => m.Id == id);
        if (member != null) member.Status = GetNextStatus(member.Status);
    }

    private class MemberItem
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Initials { get; set; } = "";
        public string Role { get; set; } = "";
        public string Timezone { get; set; } = "";
        public string Offset { get; set; } = "";
        public string Activity { get; set; } = "";
        public string Status { get; set; } = "online";
    }

    private readonly List<MemberItem> _members =
    [
        new() { Id = "m1", Name = "Sarah Chen", Initials = "SC", Role = "Chief Executive Officer", Timezone = "PST", Offset = "UTC-8", Activity = "In a meeting", Status = "busy" },
        new() { Id = "m2", Name = "Marcus Johnson", Initials = "MJ", Role = "VP of Engineering", Timezone = "EST", Offset = "UTC-5", Activity = "Reviewing PRs", Status = "online" },
        new() { Id = "m3", Name = "Elena Rodriguez", Initials = "ER", Role = "Principal Designer", Timezone = "CET", Offset = "UTC+1", Activity = "Design review", Status = "online" },
        new() { Id = "m4", Name = "David Kim", Initials = "DK", Role = "Head of Product", Timezone = "KST", Offset = "UTC+9", Activity = "Away for the day", Status = "offline" },
        new() { Id = "m5", Name = "Priya Sharma", Initials = "PS", Role = "Staff Engineer", Timezone = "IST", Offset = "UTC+5:30", Activity = "Deep work", Status = "busy" },
        new() { Id = "m6", Name = "James O'Brien", Initials = "JO", Role = "Head of Growth", Timezone = "GMT", Offset = "UTC+0", Activity = "Writing docs", Status = "online" },
        new() { Id = "m7", Name = "Aisha Patel", Initials = "AP", Role = "Security Engineer", Timezone = "EST", Offset = "UTC-5", Activity = "On call", Status = "online" },
    ];
}
