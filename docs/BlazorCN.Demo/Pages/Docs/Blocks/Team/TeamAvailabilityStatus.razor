@* ============================================================
   Block: team-availability-status
   Title: TeamAvailabilityStatus
   Description: React team availability dashboard with real-time status indicators and filterable member list using shadcn/ui and Tailwind CSS.
   Source: original/blocks/team/team-availability-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Availability</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_members.Length team members · @_counts["online"] online
            </p>
        </div>

        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            @foreach (var s in _filterOptions)
            {
                var filterVal = s;
                <button
                    type="button"
                    @onclick="@(() => _filter = filterVal)"
                    class="@Cn.Merge("flex items-center gap-1.5 rounded-md px-2 py-1 text-xs transition-colors", _filter == filterVal ? "bg-muted font-medium" : "text-muted-foreground hover:text-foreground")">
                    @if (filterVal != "all")
                    {
                        <span class="@Cn.Merge("size-1.5 rounded-full", _statusDot[filterVal])"></span>
                    }
                    @if (filterVal == "all")
                    {
                        @($"All ({_members.Length})")
                    }
                    else
                    {
                        @($"{_statusLabel[filterVal]} ({_counts[filterVal]})")
                    }
                </button>
            }
        </div>

        <div>
            @{
                var filtered = _filter == "all" ? _members : System.Array.FindAll(_members, m => m.Status == _filter);
            }
            @for (var i = 0; i < filtered.Length; i++)
            {
                var member = filtered[i];
                var isLast = i == filtered.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <div class="relative shrink-0">
                        <div class="flex size-8 items-center justify-center rounded-full bg-muted text-xs font-medium">
                            @member.Initials
                        </div>
                        <span class="@Cn.Merge("absolute -bottom-0.5 -right-0.5 size-2.5 rounded-full border-2 border-card", _statusDot[member.Status])"></span>
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@member.Name</span>
                            <span class="text-xs text-muted-foreground">@member.Role</span>
                        </div>
                        <p class="mt-0.5 truncate text-xs text-muted-foreground">@member.Activity</p>
                    </div>
                    <span class="shrink-0 text-xs text-muted-foreground">@member.LastActive</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TeamMember(string Name, string Role, string Initials, string Status, string Activity, string LastActive);

    private static readonly TeamMember[] _members =
    [
        new("Sarah Chen", "Engineering Lead", "SC", "online", "Reviewing pull requests", "Now"),
        new("Marcus Johnson", "Product Designer", "MJ", "online", "In Figma", "Now"),
        new("Elena Rodriguez", "Backend Engineer", "ER", "busy", "In a meeting until 2:30 PM", "25 min ago"),
        new("David Kim", "Frontend Engineer", "DK", "online", "Writing tests", "Now"),
        new("Aisha Patel", "Product Manager", "AP", "away", "Lunch break", "18 min ago"),
        new("James O'Brien", "DevOps Engineer", "JO", "busy", "Deploying to production", "3 min ago"),
        new("Yuki Tanaka", "QA Engineer", "YT", "away", "Out for a walk", "42 min ago"),
        new("Priya Sharma", "Data Analyst", "PS", "online", "Building dashboards", "Now"),
    ];

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["online"] = "bg-emerald-500",
        ["away"]   = "bg-amber-500",
        ["busy"]   = "bg-red-500",
    };

    private static readonly Dictionary<string, string> _statusLabel = new()
    {
        ["online"] = "Online",
        ["away"]   = "Away",
        ["busy"]   = "Busy",
    };

    private static readonly string[] _filterOptions = ["all", "online", "away", "busy"];

    private string _filter = "all";

    private Dictionary<string, int> _counts => new()
    {
        ["online"] = System.Array.FindAll(_members, m => m.Status == "online").Length,
        ["away"]   = System.Array.FindAll(_members, m => m.Status == "away").Length,
        ["busy"]   = System.Array.FindAll(_members, m => m.Status == "busy").Length,
    };
}
