@* ============================================================
   Block: team-founders-story
   Title: Team Founders Story
   Description: Vertical story layout with border-b sections for co-founder bios, origin narrative, and founding values
   Dependencies: None
   Source: original/blocks/team/team-founders-story.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Our founders</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Founded January 2020 in San Francisco</p>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-sm leading-relaxed text-muted-foreground">
                It started with a whiteboard sketch in a coffee shop in the Mission District. Elena had
                just left Stripe after watching her platform team spend six months wiring together tools
                that should have worked out of the box. David had spent the past year at Vercel thinking
                about what zero-config developer infrastructure could look like at every layer of the
                stack.
            </p>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                They incorporated in January 2020, shipped the first version to 200 beta users by
                summer, and have not stopped building since. Today, over 12,000 teams rely on the
                platform every day.
            </p>
        </div>

        @for (var i = 0; i < _founders.Length; i++)
        {
            var founder = _founders[i];
            <div class="@(i < _founders.Length - 1 ? "border-b" : "")">
                <div class="px-4 py-3">
                    <div class="flex items-center gap-3">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@founder.Initials</div>
                        <div>
                            <p class="text-sm font-medium">@founder.Name</p>
                            <p class="text-xs text-muted-foreground">@founder.Role</p>
                        </div>
                    </div>
                    <p class="mt-3 text-sm leading-relaxed text-muted-foreground">@founder.Bio</p>
                    <p class="mt-2 text-xs leading-relaxed text-muted-foreground">@founder.Background</p>
                </div>
            </div>
        }

        <div class="border-t px-4 py-3">
            <p class="mb-3 text-xs font-medium text-muted-foreground">What we believe</p>
            <div class="space-y-2">
                @foreach (var value in _foundingValues)
                {
                    <div class="rounded-md bg-muted/50 p-3">
                        <p class="text-sm font-medium">@value.Title</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">@value.Description</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record FounderItem(string Name, string Role, string Initials, string Bio, string Background);
    private static readonly FounderItem[] _founders =
    [
        new("Elena Marchetti", "Co-Founder & CEO", "EM", "Elena spent eight years at Stripe leading product teams that built the billing and invoicing platform used by millions of businesses. She saw firsthand how developer tools could either accelerate or cripple engineering velocity. After watching her own team spend months integrating fragmented toolchains, she knew there had to be a better way.", "Previously VP Product at Stripe. Stanford MBA. Started coding at 14 and never stopped. Lives in San Francisco with two rescue dogs and an unreasonable collection of mechanical keyboards."),
        new("David Osei-Mensah", "Co-Founder & CTO", "DO", "David was a principal engineer at Vercel where he helped build the deployment infrastructure powering millions of websites. His obsession with developer experience became the technical philosophy underpinning everything the company builds. He believes the best infrastructure is the kind you never have to think about.", "Previously Principal Engineer at Vercel. MIT Computer Science. Open source maintainer with 15K+ GitHub stars. Based in Brooklyn. Runs marathons to debug hard problems in his head."),
    ];

    private record ValueItem(string Title, string Description);
    private static readonly ValueItem[] _foundingValues =
    [
        new("Ship daily", "Small, continuous improvements compound into transformative products over time."),
        new("Earn trust through quality", "Every release is tested, documented, and built to the standard we would want as users."),
        new("Developers are people first", "We design for humans having a long day, not idealized developers in a vacuum."),
    ];
}
