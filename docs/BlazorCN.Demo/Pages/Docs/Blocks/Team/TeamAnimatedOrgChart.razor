@* ============================================================
   Block: team-animated-org-chart
   Title: Team Animated Org Chart
   Description: Interactive animated org chart with staggered hierarchy reveals and expandable department teams using Framer Motion for React team and company pages
   Long Description: Searchable directory with layout animations
   Dependencies: LucideChevronRightCn
   Source: original/blocks/team/team-animated-org-chart.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Organization</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @(_departments.Sum(d => d.Members.Length + 1) + 1) people across @_departments.Length departments
            </p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                    SL
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium">Sarah Lin</p>
                    <p class="text-xs text-muted-foreground">Chief Executive Officer</p>
                </div>
            </div>
        </div>

        @foreach (var dept in _departments)
        {
            var isExpanded = _expanded == dept.Name;
            <div class="border-b last:border-b-0">
                <button
                    type="button"
                    @onclick="@(() => _expanded = isExpanded ? null : dept.Name)"
                    class="flex w-full items-center gap-3 py-3 pl-8 pr-4 text-left transition-colors hover:bg-muted/50">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @dept.HeadInitials
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@dept.HeadName</span>
                            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                @dept.Name
                            </span>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @dept.HeadRole &middot; @dept.Members.Length reports
                        </p>
                    </div>
                    <LucideChevronRightCn
                        Size="16"
                        Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                </button>

                @if (isExpanded)
                {
                    <div class="overflow-hidden">
                        <div class="border-t bg-muted/20">
                            @foreach (var member in dept.Members)
                            {
                                <div class="flex items-center gap-3 border-b py-2.5 pl-14 pr-4 last:border-b-0">
                                    <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                                        @member.Initials
                                    </div>
                                    <div class="min-w-0">
                                        <p class="text-sm font-medium">@member.Name</p>
                                        <p class="text-xs text-muted-foreground">@member.Role</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private string? _expanded;

    private record MemberItem(string Name, string Role, string Initials);
    private record DepartmentItem(string Name, string HeadName, string HeadRole, string HeadInitials, MemberItem[] Members);

    private static readonly DepartmentItem[] _departments =
    [
        new("Engineering", "James Nakamura", "VP of Engineering", "JN",
        [
            new("Ava Petrov", "Staff Engineer", "AP"),
            new("Daniel Cho", "Senior Engineer", "DC"),
            new("Fatima Al-Rashid", "Senior Engineer", "FA"),
            new("Leo Martinez", "Engineer", "LM"),
        ]),
        new("Design", "Mia Torres", "Head of Design", "MT",
        [
            new("Nora Eriksen", "Senior Designer", "NE"),
            new("Oscar Dubois", "Product Designer", "OD"),
            new("Zara Okonkwo", "UX Researcher", "ZO"),
        ]),
        new("Product", "Raj Patel", "VP of Product", "RP",
        [
            new("Clara Svensson", "Senior PM", "CS"),
            new("Ethan Brooks", "Product Manager", "EB"),
        ]),
        new("Operations", "Lucia Fernandez", "COO", "LF",
        [
            new("Omar Hassan", "Operations Lead", "OH"),
            new("Grace Tanaka", "People Operations", "GT"),
            new("Victor Andersen", "Finance Manager", "VA"),
        ]),
    ];
}
