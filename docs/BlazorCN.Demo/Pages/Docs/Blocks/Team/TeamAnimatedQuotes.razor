@* ============================================================
   Block: team-animated-quotes
   Title: Team Animated Quotes
   Description: Auto-cycling team quote wall with word-level stagger animation, blur-to-clear text reveals, and dot navigation for React team and culture pages
   Long Description: Expandable company values with team quotes
   Dependencies: None
   Source: original/blocks/team/team-animated-quotes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">What our team says</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Real voices from the people building this company
            </p>
        </div>

        <div class="relative min-h-[220px] px-4 py-6">
            @{ var currentQuote = _quotes[_active]; }
            <p class="text-sm leading-relaxed text-foreground">
                <span class="text-muted-foreground">&ldquo;</span>@currentQuote.Quote<span class="text-muted-foreground">&rdquo;</span>
            </p>

            <div class="mt-5 flex items-center gap-2.5">
                <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                    @currentQuote.Initials
                </div>
                <div class="min-w-0">
                    <p class="text-sm font-medium">@currentQuote.Name</p>
                    <p class="text-xs text-muted-foreground">@currentQuote.Role</p>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-center gap-0.5 border-t px-4 py-3">
            @for (var i = 0; i < _quotes.Length; i++)
            {
                var idx = i;
                <button
                    type="button"
                    @onclick="@(() => _active = idx)"
                    class="group inline-flex size-6 items-center justify-center"
                    aria-label="@($"Go to quote {idx + 1}")">
                    <span class="@Cn.Merge("block size-1.5 rounded-full transition-colors duration-200", idx == _active ? "bg-foreground" : "bg-muted-foreground/30 group-hover:bg-muted-foreground/60")"></span>
                </button>
            }
        </div>
    </div>
</section>

@code {
    private int _active;

    private record QuoteItem(string Name, string Role, string Initials, string Quote);

    private static readonly QuoteItem[] _quotes =
    [
        new("Elena Voskresenskaya", "VP of Engineering", "EV",
            "The best engineering cultures are built on trust, not process. Give people context and autonomy, and they will consistently surprise you with what they ship."),
        new("Marcus Chen", "Head of Design", "MC",
            "Design is not about making things look good. It is about removing everything that gets in the way of the user achieving their goal as fast as possible."),
        new("Priya Nair", "Staff Product Manager", "PN",
            "We stopped writing requirements documents and started writing customer stories. That single change transformed how the entire team thinks about what we build."),
        new("Tomas Herrera", "Principal Engineer", "TH",
            "I have seen teams drown in technical debt because they were afraid to refactor. We ship refactors as features because clean code is a product decision."),
        new("Aisha Bakari", "Director of People", "AB",
            "Culture is not what you put on the wall. It is what happens when no one is watching. We hire for curiosity and kindness because skills can be taught."),
    ];
}
