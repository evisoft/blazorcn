@* ============================================================
   Block: team-minimal-avatars
   Title: Team Minimal Avatars
   Description: Clean horizontal strip of initials circles with names below each for compact team sections
   Long Description: Swipeable horizontal team member carousel
   Dependencies: None
   Source: original/blocks/team/team-minimal-avatars.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <span class="text-sm font-medium">Our team</span>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_members.Length people building something extraordinary.
            </p>
        </div>

        <div class="px-4 py-4">
            <div class="flex flex-wrap items-start justify-center gap-4">
                @foreach (var member in _members)
                {
                    <div class="flex w-16 flex-col items-center gap-1.5 text-center">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                            @member.Initials
                        </div>
                        <div class="min-w-0">
                            <span class="block truncate text-xs font-medium">
                                @member.Name.Split(' ')[0]
                            </span>
                            <span class="block truncate text-xs text-muted-foreground">
                                @member.Role.Split(' ')[^1]
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record TeamMember(string Name, string Role, string Initials);

    private static readonly TeamMember[] _members =
    [
        new("Mia Thornton", "Chief Executive Officer", "MT"),
        new("Raj Kapoor", "VP of Engineering", "RK"),
        new("Nina Alexandrov", "Principal Designer", "NA"),
        new("James O'Brien", "Head of Growth", "JO"),
        new("Lena Kowalski", "Staff Engineer", "LK"),
        new("Hassan Al-Rashid", "Director of Product", "HA"),
        new("Sophie Dubois", "Security Engineer", "SD"),
        new("Andre Williams", "Developer Advocate", "AW"),
        new("Yuki Tanaka", "Data Science Lead", "YT"),
        new("Clara Moreno", "Head of People", "CM"),
        new("David Okonkwo", "Infrastructure Engineer", "DO"),
        new("Ingrid Larsson", "General Counsel", "IL"),
    ];
}
