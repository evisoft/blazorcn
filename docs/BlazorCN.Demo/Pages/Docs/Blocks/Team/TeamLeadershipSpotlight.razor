@* ============================================================
   Block: team-leadership-spotlight
   Title: Team Leadership Spotlight
   Description: Large featured section showcasing C-suite executives and founders with detailed bios
   Dependencies: None
   Source: original/blocks/team/team-leadership-spotlight.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <span class="text-sm font-medium">Leadership</span>
            <p class="mt-0.5 text-xs text-muted-foreground">Industry veterans leading the team</p>
        </div>

        @{
            var featured = _leaders[0];
            var rest = _leaders.Skip(1).ToArray();
        }

        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-sm font-medium">@featured.Initials</div>
                <div>
                    <span class="text-sm font-medium">@featured.Name</span>
                    <p class="text-xs text-muted-foreground">@featured.Role</p>
                </div>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">@featured.Bio</p>
            <div class="mt-3 flex flex-wrap gap-1.5">
                @foreach (var skill in featured.Expertise)
                {
                    <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@skill</span>
                }
            </div>
        </div>

        <div>
            @for (var i = 0; i < rest.Length; i++)
            {
                var leader = rest[i];
                <div class="@Cn.Merge("px-4 py-3", i < rest.Length - 1 ? "border-b" : "")">
                    <div class="flex items-center gap-3">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@leader.Initials</div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@leader.Name</span>
                                <span class="text-xs text-muted-foreground">@leader.Role</span>
                            </div>
                            <p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">@leader.Bio</p>
                            <div class="mt-2 flex flex-wrap gap-1.5">
                                @foreach (var skill in leader.Expertise)
                                {
                                    <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@skill</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record LeaderItem(string Name, string Role, string Bio, string Initials, string[] Expertise);
    private static readonly LeaderItem[] _leaders =
    [
        new("Sarah Chen", "Chief Executive Officer", "Sarah founded the company in 2019 after spending a decade in fintech leadership. As VP of Product at Stripe, she led the launch of Stripe Connect and grew the platform from 50,000 to over 500,000 connected accounts. She holds a CS degree from MIT and an MBA from Stanford GSB.", "SC", ["Strategy", "Fintech", "Product Vision"]),
        new("Marcus Johnson", "Chief Technology Officer", "Marcus brings 18 years of engineering leadership. As a Staff Engineer at Google, he led the distributed systems team responsible for Cloud Spanner's multi-region replication. He later joined Datadog as VP of Engineering where he scaled the organization from 40 to 200 engineers.", "MJ", ["Distributed Systems", "Platform Engineering", "Architecture"]),
        new("Elena Rodriguez", "VP of Engineering", "Elena oversees all engineering teams and technical delivery. She previously led mobile engineering at Shopify, where her team built the Shop app used by over 100 million consumers. Before Shopify, she spent five years at Netflix building the real-time personalization engine.", "ER", ["Engineering Management", "Mobile", "Team Culture"]),
        new("David Kim", "VP of Design", "David leads design strategy across product, brand, and marketing. He spent seven years at Figma where he was the design lead for FigJam. His design philosophy centers on reducing cognitive load and creating interfaces that feel invisible.", "DK", ["Design Systems", "Brand Strategy", "Interaction Design"]),
    ];
}
