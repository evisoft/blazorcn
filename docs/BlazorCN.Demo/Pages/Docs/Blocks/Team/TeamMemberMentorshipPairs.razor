@* ============================================================
   Block: team-member-mentorship-pairs
   Title: TeamMemberMentorshipPairs
   Description: A mentor-mentee relationship tracking block for React and Next.js displaying mentorship pairings and progress built with shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-member-mentorship-pairs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="space-y-4">
        <!-- Header -->
        <div>
            <h2 class="text-sm font-medium">Mentorship Pairs</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Active and completed mentorships</p>
        </div>

        <!-- Pairs -->
        @foreach (var pair in _pairs)
        {
            var isExpanded = _expanded == pair.Id;
            <div class="overflow-hidden rounded-lg border bg-card">
                <button type="button"
                        class="w-full px-4 py-3 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => _expanded = isExpanded ? null : pair.Id)">
                    <div class="flex items-center justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@pair.Mentor</span>
                                <span class="text-xs text-muted-foreground">@("→")</span>
                                <span class="text-sm font-medium">@pair.Mentee</span>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">@pair.Topic</p>
                        </div>
                        <div class="flex shrink-0 items-center gap-2">
                            <BadgeCn Variant="@(pair.Status == MentorshipStatus.Active ? BadgeVariant.Secondary : BadgeVariant.Outline)"
                                     Class="text-xs">
                                @(pair.Status == MentorshipStatus.Active ? "Active" : "Completed")
                            </BadgeCn>
                            <LucideIconCn Name="chevron-right" Size="16"
                                          Class="@Cn.Merge("size-4 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </div>
                    </div>
                </button>

                @if (isExpanded)
                {
                    <div class="border-t px-4 py-3 space-y-2">
                        <div class="flex items-center gap-2 text-xs text-muted-foreground">
                            <LucideIconCn Name="user-check" Size="12" Class="size-3" />
                            Started @pair.StartDate
                        </div>
                        <p class="text-sm text-muted-foreground">
                            @pair.Mentor is helping @pair.Mentee develop @pair.Topic.ToLower() skills.
                        </p>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private enum MentorshipStatus { Active, Completed }

    private record MentorshipPair(string Id, string Mentor, string Mentee, string Topic, string StartDate, MentorshipStatus Status);

    private string? _expanded = "1";

    private static readonly MentorshipPair[] _pairs =
    [
        new("1", "Sarah Chen", "Alex Kim", "Product Leadership", "Jan 2026", MentorshipStatus.Active),
        new("2", "Marcus Rodriguez", "Jordan Lee", "Backend Architecture", "Feb 2026", MentorshipStatus.Active),
        new("3", "Emily Watson", "Casey Park", "Design Systems", "Nov 2025", MentorshipStatus.Completed),
    ];
}
