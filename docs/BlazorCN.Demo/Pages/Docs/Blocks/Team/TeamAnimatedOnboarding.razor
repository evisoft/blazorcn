@* ============================================================
   Block: team-animated-onboarding
   Title: Team Animated Onboarding
   Description: New hire onboarding progress block with layoutId step indicator, directional content transitions, and task checklists for React team pages
   Long Description: Mentor-mentee pairing and program overview
   Dependencies: ButtonCn, LucideCheckCn, LucideChevronLeftCn, LucideChevronRightCn
   Source: original/blocks/team/team-animated-onboarding.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Onboarding progress</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    @_tasks.Values.SelectMany(t => t).Count(t => t.Completed) of @_tasks.Values.SelectMany(t => t).Count() tasks completed
                </p>
            </div>
            <span class="text-xs tabular-nums text-muted-foreground">Week 1</span>
        </div>

        <div class="flex items-center border-b px-4 py-3">
            <div class="flex flex-1 items-center gap-1">
                @for (var i = 0; i < _steps.Length; i++)
                {
                    var stepIdx = i;
                    var step = _steps[i];
                    var stepTasks = _tasks[step.Id];
                    var done = stepTasks.All(t => t.Completed);
                    var active = i == _activeStep;
                    <button
                        type="button"
                        @onclick="@(() => GoToStep(stepIdx))"
                        class="@Cn.Merge("relative flex-1 rounded-md px-2 py-1.5 text-center text-xs transition-colors", active ? "bg-muted text-foreground" : "text-muted-foreground hover:text-foreground")">
                        <span class="relative flex items-center justify-center gap-1">
                            @if (done)
                            {
                                <LucideCheckCn Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                            }
                            @step.Label
                        </span>
                    </button>
                }
            </div>
        </div>

        <div class="relative min-h-[260px]">
            @{
                var currentStep = _steps[_activeStep];
                var currentTasks = _tasks[currentStep.Id];
                var completedCount = currentTasks.Count(t => t.Completed);
            }
            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-muted-foreground">
                        @currentStep.Label tasks
                    </span>
                    <span class="text-xs tabular-nums text-muted-foreground">
                        @completedCount/@currentTasks.Length
                    </span>
                </div>
            </div>

            <div>
                @for (var i = 0; i < currentTasks.Length; i++)
                {
                    var task = currentTasks[i];
                    var isLast = i == currentTasks.Length - 1;
                    var taskStepId = currentStep.Id;
                    <label class="@Cn.Merge("flex cursor-pointer items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                        <button
                            type="button"
                            @onclick="@(() => ToggleTask(taskStepId, task.Id))"
                            class="@Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded border transition-colors", task.Completed ? "border-emerald-600 bg-emerald-600 text-white dark:border-emerald-500 dark:bg-emerald-500" : "border-border")">
                            @if (task.Completed)
                            {
                                <LucideCheckCn Size="12" Class="size-3" />
                            }
                        </button>
                        <span class="@Cn.Merge("text-xs leading-relaxed", task.Completed ? "text-muted-foreground line-through" : "")">
                            @task.Label
                        </span>
                    </label>
                }
            </div>

            @if (currentStep.Id == "meet")
            {
                <div class="border-t px-4 py-3">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">Your mentor</p>
                    <div class="flex items-center gap-3">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                            SR
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium">Sofia Reyes</p>
                            <p class="text-xs text-muted-foreground">Staff Engineer</p>
                        </div>
                    </div>
                    <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                        &ldquo;Welcome to the team! I will be your onboarding mentor for the first two weeks. Reach out anytime.&rdquo;
                    </p>
                </div>
            }
        </div>

        <div class="flex items-center justify-between border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs"
                      @onclick="GoPrev" disabled="@(_activeStep == 0)">
                <LucideChevronLeftCn Size="14" Class="size-3.5" />
                Previous
            </ButtonCn>
            <div class="flex items-center gap-1">
                @for (var i = 0; i < _steps.Length; i++)
                {
                    <div class="@Cn.Merge("size-1.5 rounded-full transition-colors", i == _activeStep ? "bg-foreground" : "bg-foreground/20")"></div>
                }
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs"
                      @onclick="GoNext" disabled="@(_activeStep == _steps.Length - 1)">
                Next
                <LucideChevronRightCn Size="14" Class="size-3.5" />
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private int _activeStep;

    private void GoToStep(int index) => _activeStep = index;
    private void GoPrev() { if (_activeStep > 0) _activeStep--; }
    private void GoNext() { if (_activeStep < _steps.Length - 1) _activeStep++; }

    private void ToggleTask(string stepId, string taskId)
    {
        var task = _tasks[stepId].First(t => t.Id == taskId);
        task.Completed = !task.Completed;
    }

    private record StepItem(string Id, string Label);
    private class TaskItem { public string Id { get; set; } = ""; public string Label { get; set; } = ""; public bool Completed { get; set; } }

    private static readonly StepItem[] _steps =
    [
        new("setup", "Setup"),
        new("meet", "Meet team"),
        new("learn", "Learn"),
        new("ship", "First ship"),
    ];

    private readonly Dictionary<string, TaskItem[]> _tasks = new()
    {
        ["setup"] = [
            new() { Id = "s1", Label = "Accept email invitation and set up SSO", Completed = true },
            new() { Id = "s2", Label = "Install development environment and tooling", Completed = true },
            new() { Id = "s3", Label = "Clone the monorepo and run the dev server", Completed = false },
            new() { Id = "s4", Label = "Join Slack channels: #engineering, #watercooler, #shipped", Completed = false },
        ],
        ["meet"] = [
            new() { Id = "m1", Label = "30-min intro with your manager Mei-Lin Wu", Completed = false },
            new() { Id = "m2", Label = "Coffee chat with mentor Sofia Reyes", Completed = false },
            new() { Id = "m3", Label = "Meet your pod: Platform Team standup at 10am", Completed = false },
            new() { Id = "m4", Label = "Lunch with the design team on Thursday", Completed = false },
        ],
        ["learn"] = [
            new() { Id = "l1", Label = "Read the architecture decision records (ADRs)", Completed = false },
            new() { Id = "l2", Label = "Complete the codebase walkthrough video series", Completed = false },
            new() { Id = "l3", Label = "Review the style guide and component library", Completed = false },
            new() { Id = "l4", Label = "Shadow a production deploy with the on-call engineer", Completed = false },
        ],
        ["ship"] = [
            new() { Id = "f1", Label = "Pick a starter issue labeled 'good first issue'", Completed = false },
            new() { Id = "f2", Label = "Open your first pull request", Completed = false },
            new() { Id = "f3", Label = "Get code review approval from two engineers", Completed = false },
            new() { Id = "f4", Label = "Merge and deploy your first change to production", Completed = false },
        ],
    };
}
