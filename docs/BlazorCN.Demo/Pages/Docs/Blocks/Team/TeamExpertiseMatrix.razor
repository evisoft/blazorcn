@* ============================================================
   Block: team-expertise-matrix
   Title: TeamExpertiseMatrix
   Description: React team competency matrix with shadcn/ui table, Next.js, and Tailwind CSS showing expertise levels with dot indicators
   Source: original/blocks/team/team-expertise-matrix.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Expertise matrix</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Skill proficiency across the team</p>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="border-b">
                        <th class="px-4 py-2.5 text-left">
                            <span class="text-xs font-medium text-muted-foreground">Member</span>
                        </th>
                        @foreach (var skill in _skillColumns)
                        {
                            <th class="px-3 py-2.5 text-center">
                                <span class="text-xs font-medium text-muted-foreground">@skill</span>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _members.Length; i++)
                    {
                        var member = _members[i];
                        var isLast = i == _members.Length - 1;
                        <tr class="@(isLast ? "" : "border-b")">
                            <td class="px-4 py-2.5">
                                <div class="flex items-center gap-2.5">
                                    <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                                        @member.Initials
                                    </div>
                                    <div class="min-w-0">
                                        <div class="text-sm font-medium">@member.Name</div>
                                        <div class="text-xs text-muted-foreground">@member.Role</div>
                                    </div>
                                </div>
                            </td>
                            @foreach (var skill in _skillColumns)
                            {
                                var level = member.Skills.TryGetValue(skill, out var lvl) ? lvl : 0;
                                <td class="px-3 py-2.5">
                                    <div class="flex justify-center">
                                        <div class="flex items-center gap-0.5">
                                            @for (var d = 0; d < 4; d++)
                                            {
                                                var dotIndex = d;
                                                <span class="@(Cn.Merge("size-1.5 rounded-full", dotIndex < level ? "bg-foreground/60" : "bg-muted"))"></span>
                                            }
                                        </div>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="border-t">
                        <td class="px-4 py-2.5">
                            <span class="text-xs font-medium text-muted-foreground">Team avg.</span>
                        </td>
                        @for (var i = 0; i < _skillColumns.Length; i++)
                        {
                            var avg = _teamAvg[i];
                            <td class="px-3 py-2.5 text-center">
                                <span class="font-mono text-xs text-muted-foreground">@avg.ToString("F1")</span>
                            </td>
                        }
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _skillColumns = ["React", "TypeScript", "Node.js", "SQL", "AWS", "Design"];

    private record TeamMember(string Name, string Role, string Initials, Dictionary<string, int> Skills);

    private static readonly TeamMember[] _members =
    [
        new("Sarah Chen",      "Engineering Lead",      "SC", new() { ["React"]=4, ["TypeScript"]=4, ["Node.js"]=3, ["SQL"]=3, ["AWS"]=2, ["Design"]=1 }),
        new("Marcus Johnson",  "Full Stack Engineer",   "MJ", new() { ["React"]=3, ["TypeScript"]=3, ["Node.js"]=4, ["SQL"]=4, ["AWS"]=3, ["Design"]=1 }),
        new("Elena Rodriguez", "Frontend Engineer",     "ER", new() { ["React"]=4, ["TypeScript"]=4, ["Node.js"]=2, ["SQL"]=1, ["AWS"]=1, ["Design"]=3 }),
        new("David Kim",       "DevOps Engineer",       "DK", new() { ["React"]=1, ["TypeScript"]=2, ["Node.js"]=3, ["SQL"]=2, ["AWS"]=4, ["Design"]=0 }),
        new("Aisha Patel",     "Product Designer",      "AP", new() { ["React"]=2, ["TypeScript"]=1, ["Node.js"]=0, ["SQL"]=0, ["AWS"]=0, ["Design"]=4 }),
        new("James O'Brien",   "Backend Engineer",      "JO", new() { ["React"]=1, ["TypeScript"]=3, ["Node.js"]=4, ["SQL"]=4, ["AWS"]=3, ["Design"]=0 }),
        new("Yuki Tanaka",     "Full Stack Engineer",   "YT", new() { ["React"]=3, ["TypeScript"]=3, ["Node.js"]=3, ["SQL"]=2, ["AWS"]=2, ["Design"]=2 }),
    ];

    private static readonly double[] _teamAvg = ComputeTeamAvg();

    private static double[] ComputeTeamAvg()
    {
        var result = new double[_skillColumns.Length];
        for (var i = 0; i < _skillColumns.Length; i++)
        {
            var skill = _skillColumns[i];
            var total = 0;
            foreach (var m in _members)
                total += m.Skills.TryGetValue(skill, out var v) ? v : 0;
            result[i] = Math.Round((double)total / _members.Length * 10) / 10;
        }
        return result;
    }
}
