@* ============================================================
   Block: team-career-paths
   Title: Team Career Paths
   Description: Career progression tracks showing IC, management, and specialist paths with levels and current team members at each rung
   Long Description: Chronological milestones with dot timeline
   Dependencies: None
   Source: original/blocks/team/team-career-paths.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Career paths</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_tracks.Length tracks &middot; @_totalMembers team members
            </p>
        </div>

        <div class="flex border-b">
            @for (var i = 0; i < _tracks.Length; i++)
            {
                var idx = i;
                var track = _tracks[i];
                <button type="button" @onclick="@(() => _activeTrack = idx)"
                        class="@Cn.Merge("flex-1 px-4 py-2.5 text-center text-xs font-medium transition-colors", _activeTrack == idx ? "border-b-2 border-foreground text-foreground" : "text-muted-foreground hover:text-foreground")">
                    @track.Name
                </button>
            }
        </div>

        <div class="px-4 py-2.5">
            <p class="text-xs text-muted-foreground">@_tracks[_activeTrack].Description</p>
        </div>

        @for (var levelIndex = 0; levelIndex < _tracks[_activeTrack].Levels.Length; levelIndex++)
        {
            var level = _tracks[_activeTrack].Levels[levelIndex];
            <div class="flex gap-3 border-t px-4 py-3">
                <div class="flex flex-col items-center pt-1">
                    <span class="@Cn.Merge("size-2 shrink-0 rounded-full", level.Members.Length > 0 ? "bg-foreground" : "bg-border")"></span>
                    @if (levelIndex < _tracks[_activeTrack].Levels.Length - 1)
                    {
                        <div class="mt-1 w-px flex-1 bg-border"></div>
                    }
                </div>

                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-medium">@level.Title</span>
                        @if (level.Members.Length > 0)
                        {
                            <span class="text-xs text-muted-foreground">@level.Members.Length</span>
                        }
                    </div>

                    @if (level.Members.Length > 0)
                    {
                        <div class="mt-2 flex flex-col gap-1.5">
                            @foreach (var member in level.Members)
                            {
                                <div class="flex items-center gap-2">
                                    <div class="flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-[9px] font-medium">
                                        @member.Initials
                                    </div>
                                    <span class="text-xs text-muted-foreground">@member.Name</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="mt-1 text-xs text-muted-foreground/60">No current members</p>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Member(string Name, string Initials);
    private record Level(string Title, Member[] Members);
    private record Track(string Name, string Description, Level[] Levels);

    private int _activeTrack;

    private static readonly int _totalMembers = _tracks
        .SelectMany(t => t.Levels)
        .SelectMany(l => l.Members)
        .Select(m => m.Name)
        .Distinct()
        .Count();

    private static readonly Track[] _tracks =
    [
        new("Individual Contributor", "Deep technical expertise",
        [
            new("Principal", []),
            new("Staff", [new("Darian Reeves", "DR"), new("Tomas Aguirre", "TA")]),
            new("Senior", [new("Lina Petrova", "LP"), new("Yuki Tanaka", "YT"), new("Aisha Farouk", "AF")]),
            new("Mid", [new("Priya Kapoor", "PK"), new("Kofi Mensah", "KM")]),
            new("Junior", [new("Sara Nilsson", "SN")]),
        ]),
        new("Management", "People and team leadership",
        [
            new("VP / Director", [new("Maren Lindqvist", "ML"), new("Elise Beaumont", "EB")]),
            new("Head of", [new("Aarav Sharma", "AS"), new("Tomoko Nakamura", "TN")]),
            new("Engineering Manager", [new("Felix Brennan", "FB")]),
            new("Tech Lead", [new("Henrik Dahl", "HD"), new("Nia Okonkwo", "NO")]),
            new("Team Lead", []),
        ]),
        new("Specialist", "Domain-specific mastery",
        [
            new("Distinguished", []),
            new("Principal Specialist", [new("Lucia Fernandez", "LF")]),
            new("Senior Specialist", [new("Anders Holm", "AH")]),
            new("Specialist", [new("Ingrid Solberg", "IS")]),
            new("Associate", []),
        ]),
    ];
}
