@* ============================================================
   Block: team-remote-global
   Title: Team Remote Global
   Description: Distributed remote team display organized by timezone region with online status indicators and city locations
   Dependencies: none (pure HTML/Tailwind)
   Source: original/blocks/team/team-remote-global.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Global team</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_totalMembers people across @_uniqueCountries countries
            </p>
        </div>
        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-xs text-muted-foreground">Online</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-muted-foreground/30"></span>
                <span class="text-xs text-muted-foreground">Offline</span>
            </div>
        </div>
        @foreach (var group in _timezoneGroups)
        {
            var isExpanded = _expandedRegions.Contains(group.Region);
            var onlineCount = group.Members.Count(m => m.IsOnline);
            <div class="border-b last:border-b-0">
                <button type="button"
                        class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => ToggleRegion(group.Region))">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@group.Region</span>
                            <span class="text-xs text-muted-foreground">@group.UtcOffset</span>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @group.Members.Length members &middot; @onlineCount online
                        </p>
                    </div>
                    <LucideChevronRightCn Size="16"
                                          Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                </button>
                @if (isExpanded)
                {
                    <div class="border-t">
                        @foreach (var member in group.Members)
                        {
                            <div class="flex items-center gap-3 border-b px-4 py-2.5 last:border-b-0">
                                <div class="relative">
                                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                                        @member.Initials
                                    </div>
                                    <span class="@Cn.Merge("absolute -right-0.5 -top-0.5 size-2 rounded-full ring-2 ring-card", member.IsOnline ? "bg-emerald-500" : "bg-muted-foreground/30")"></span>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <span class="text-sm font-medium">@member.Name</span>
                                    <p class="mt-0.5 truncate text-xs text-muted-foreground">
                                        @member.Role
                                    </p>
                                </div>
                                <span class="shrink-0 text-xs text-muted-foreground">@member.City</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record TeamMember(string Name, string Initials, string Role, string City, string Country, bool IsOnline);
    private record TimezoneGroup(string Region, string UtcOffset, TeamMember[] Members);

    private readonly HashSet<string> _expandedRegions = ["Americas", "Europe", "Asia-Pacific"];

    private void ToggleRegion(string region)
    {
        if (!_expandedRegions.Remove(region)) _expandedRegions.Add(region);
    }

    private static readonly TimezoneGroup[] _timezoneGroups =
    [
        new("Americas", "UTC-8 to UTC-3",
        [
            new("Sofia Martinez", "SM", "Engineering Manager", "San Francisco", "US", true),
            new("Jordan Ellis", "JE", "Senior Frontend Engineer", "New York", "US", true),
            new("Lucas Andrade", "LA", "Staff Backend Engineer", "Sao Paulo", "BR", false),
            new("Maya Chen", "MC", "Product Designer", "Toronto", "CA", true),
            new("Diego Herrera", "DH", "DevOps Engineer", "Mexico City", "MX", true),
        ]),
        new("Europe", "UTC+0 to UTC+3",
        [
            new("Emma Lindqvist", "EL", "VP of Design", "Stockholm", "SE", true),
            new("Tobias Muller", "TM", "Staff Engineer", "Berlin", "DE", true),
            new("Olivia Beaumont", "OB", "Product Manager", "Paris", "FR", false),
            new("Nikos Papadopoulos", "NP", "Data Engineer", "Athens", "GR", true),
        ]),
        new("Asia-Pacific", "UTC+5 to UTC+12",
        [
            new("Priya Sharma", "PS", "Head of Engineering", "Bangalore", "IN", false),
            new("Kenji Watanabe", "KW", "Senior ML Engineer", "Tokyo", "JP", false),
            new("Anh Nguyen", "AN", "Full-Stack Developer", "Ho Chi Minh City", "VN", false),
            new("Sarah Tan", "ST", "UX Researcher", "Singapore", "SG", true),
        ]),
    ];

    private static readonly int _totalMembers = _timezoneGroups.Sum(g => g.Members.Length);
    private static readonly int _uniqueCountries = _timezoneGroups.SelectMany(g => g.Members).Select(m => m.Country).Distinct().Count();
}
