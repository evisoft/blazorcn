@* ============================================================
   Block: team-office-hours
   Title: Team Office Hours
   Description: Team availability and office hours schedule showing each member's weekly time slots with day abbreviations and hours
   Dependencies: LucideClockCn, ButtonCn
   Source: original/blocks/team/team-office-hours.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium">Office hours</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@_members.Length team members &middot; @_members.Sum(m => m.Slots.Length) weekly slots</p>
                </div>
                <LucideClockCn Size="16" Class="size-4 text-muted-foreground" />
            </div>
        </div>

        <div class="flex items-center gap-1 border-b px-4 py-2">
            <ButtonCn Variant="@(_selectedDay == null ? ButtonVariant.Outline : ButtonVariant.Ghost)" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" @onclick="@(() => _selectedDay = null)">
                All
            </ButtonCn>
            @foreach (var day in _days)
            {
                var d = day;
                <ButtonCn Variant="@(_selectedDay == d ? ButtonVariant.Outline : ButtonVariant.Ghost)" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" @onclick="@(() => _selectedDay = _selectedDay == d ? null : d)">
                    @d
                </ButtonCn>
            }
        </div>

        @if (_filtered.Length == 0)
        {
            <div class="px-4 py-8 text-center text-xs text-muted-foreground">No office hours on this day</div>
        }
        else
        {
            @for (var i = 0; i < _filtered.Length; i++)
            {
                var member = _filtered[i];
                <div class="@Cn.Merge("flex flex-col gap-2 px-4 py-3 sm:flex-row sm:items-center sm:gap-4", i < _filtered.Length - 1 ? "border-b" : "")">
                    <div class="flex items-center gap-3 sm:w-48 sm:shrink-0">
                        <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@member.Initials</div>
                        <div class="min-w-0">
                            <div class="text-sm font-medium">@member.Name</div>
                            <div class="text-xs text-muted-foreground">@member.Role</div>
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-1.5 sm:ml-auto">
                        @foreach (var slot in member.Slots)
                        {
                            <span class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs text-muted-foreground">@slot.Day @slot.Hours</span>
                        }
                    </div>
                </div>
            }
        }
    </div>
</section>

@code {
    private string? _selectedDay;
    private static readonly string[] _days = ["Mon", "Tue", "Wed", "Thu", "Fri"];

    private FilteredMember[] _filtered
    {
        get
        {
            if (_selectedDay == null) return _members.Select(m => new FilteredMember(m.Name, m.Initials, m.Role, m.Slots)).ToArray();
            return _members
                .Select(m => new FilteredMember(m.Name, m.Initials, m.Role, m.Slots.Where(s => s.Day == _selectedDay).ToArray()))
                .Where(m => m.Slots.Length > 0)
                .ToArray();
        }
    }

    private record TimeSlot(string Day, string Hours);
    private record MemberItem(string Name, string Initials, string Role, TimeSlot[] Slots);
    private record FilteredMember(string Name, string Initials, string Role, TimeSlot[] Slots);

    private static readonly MemberItem[] _members =
    [
        new("Maren Lindqvist", "ML", "CEO", [new("Mon", "9:00\u201310:00"), new("Thu", "14:00\u201315:00")]),
        new("Kofi Asante", "KA", "CTO", [new("Tue", "10:00\u201311:30"), new("Fri", "15:00\u201316:00")]),
        new("Lucia Fernandez", "LF", "VP Design", [new("Mon", "14:00\u201315:00"), new("Wed", "10:00\u201311:00"), new("Fri", "10:00\u201311:00")]),
        new("Aarav Sharma", "AS", "Head of Engineering", [new("Tue", "14:00\u201315:30"), new("Thu", "10:00\u201311:00")]),
        new("Elise Beaumont", "EB", "VP Product", [new("Wed", "13:00\u201314:00"), new("Fri", "11:00\u201312:00")]),
        new("Henrik Dahl", "HD", "Staff DevOps", [new("Mon", "11:00\u201312:00"), new("Wed", "15:00\u201316:30"), new("Fri", "9:00\u201310:00")]),
    ];
}
