@* ============================================================
   Block: team-quote-wall
   Title: Team Quote Wall
   Description: Quote-first team list where each entry leads with a personal quote and small attribution
   Dependencies: None
   Source: original/blocks/team/team-quote-wall.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">In their own words</p>
            <p class="mt-0.5 text-xs text-muted-foreground">The philosophies that guide how our team thinks, builds, and ships.</p>
        </div>

        @for (var i = 0; i < _members.Length; i++)
        {
            var member = _members[i];
            <div class="@Cn.Merge("px-4 py-4", i < _members.Length - 1 ? "border-b" : "")">
                <p class="text-sm italic leading-relaxed text-foreground">&ldquo;@member.Quote&rdquo;</p>
                <div class="mt-3 flex items-center gap-2.5">
                    <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@member.Initials</div>
                    <div class="min-w-0">
                        <span class="text-sm font-medium">@member.Name</span>
                        <span class="mx-1.5 text-muted-foreground">&middot;</span>
                        <span class="text-xs text-muted-foreground">@member.Role</span>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record MemberItem(string Name, string Role, string Initials, string Quote);
    private static readonly MemberItem[] _members =
    [
        new("Cassandra Yeboah", "Head of Product", "CY", "Ship the smallest thing that teaches you the most. Everything else is inventory."),
        new("Henrik Almeida", "Staff Engineer", "HA", "The hardest part of engineering is not writing code. It is knowing which code never needs to be written. Every line you delete is a line nobody has to maintain, debug, or explain to the next person."),
        new("Fatima El-Amin", "Design Director", "FE", "Good design is invisible. Great design is unforgettable."),
        new("Oscar Lindgren", "VP of Customer Success", "OL", "Customers do not churn because of bugs. They churn because they stop believing you understand their problem. Stay close to the pain and the product roadmap writes itself."),
        new("Mina Patel", "Machine Learning Engineer", "MP", "Data without context is noise. Context without action is trivia. The real work is closing the gap between insight and impact."),
        new("Julian Rask", "Chief of Staff", "JR", "Clarity scales. Ambiguity does not."),
    ];
}
