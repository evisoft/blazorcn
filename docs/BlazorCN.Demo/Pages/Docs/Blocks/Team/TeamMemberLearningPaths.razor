@* ============================================================
   Block: team-member-learning-paths
   Title: TeamMemberLearningPaths
   Description: A learning goals and development path tracking block for React and Next.js showing skill progression built with shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-member-learning-paths.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="space-y-4">
        <div>
            <h2 class="text-sm font-medium">Learning Paths</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Professional development and skill progression
            </p>
        </div>

        <div class="space-y-4">
            @foreach (var member in _team)
            {
                <div class="rounded-lg border bg-card p-4">
                    <h3 class="mb-3 text-sm font-medium">@member.Name</h3>
                    <div class="space-y-3">
                        @foreach (var path in member.Paths)
                        {
                            <div class="space-y-1.5">
                                <div class="flex items-center justify-between">
                                    <span class="text-sm font-medium">@path.Skill</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                                        @path.Progress%
                                    </BadgeCn>
                                </div>
                                <ProgressCn Value="@path.Progress" Class="h-1.5" aria-label="Progress" />
                                <p class="text-xs text-muted-foreground">@string.Join(" → ", path.Steps)</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record LearningPath(string Skill, int Progress, string[] Steps);
    private record TeamMember(string Name, LearningPath[] Paths);

    private static readonly TeamMember[] _team =
    [
        new("Sarah Chen",
        [
            new("Executive Leadership", 60, ["Management Training", "Executive Coaching", "Board Skills"]),
            new("Data Analytics", 40, ["SQL Fundamentals", "Python for Data", "Analytics Tools"]),
        ]),
        new("Marcus Rodriguez",
        [
            new("Kubernetes", 75, ["Docker Basics", "K8s Architecture", "Production Deployments"]),
            new("Public Speaking", 30, ["Speech Writing", "Presentation Skills", "Conference Talks"]),
        ]),
    ];
}
