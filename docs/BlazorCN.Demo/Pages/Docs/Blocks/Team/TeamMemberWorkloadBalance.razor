@* ============================================================
   Block: team-member-workload-balance
   Title: TeamMemberWorkloadBalance
   Description: A workload distribution and capacity tracking block for React and Next.js showing current projects and availability built with shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-member-workload-balance.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="space-y-4">
        @* Header *@
        <div>
            <h2 class="text-sm font-medium">Workload Balance</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Current project allocations and capacity
            </p>
        </div>

        @* Workload Cards *@
        <div class="space-y-3">
            @foreach (var mem in _team)
            {
                var member = mem;
                <div class="overflow-hidden rounded-lg border bg-card p-4">
                    <div class="mb-3 flex items-center justify-between">
                        <h3 class="text-sm font-medium">@member.Name</h3>
                        <BadgeCn Variant="@(member.TotalUtilization > 100 ? BadgeVariant.Destructive : BadgeVariant.Secondary)" Class="text-xs">
                            @member.TotalUtilization%
                        </BadgeCn>
                    </div>

                    <div class="space-y-2">
                        @foreach (var proj in member.Projects)
                        {
                            var project = proj;
                            <div>
                                <div class="mb-1 flex items-center justify-between">
                                    <span class="text-xs text-muted-foreground">@project.Name</span>
                                    <span class="text-xs font-medium">@project.Utilization%</span>
                                </div>
                                <ProgressCn Value="@project.Utilization" Class="h-1.5" />
                            </div>
                        }
                    </div>

                    <div class="mt-3 border-t pt-2">
                        <ProgressCn Value="@(Math.Min(member.TotalUtilization, 100))" Class="h-2" />
                        <p class="mt-1 text-xs text-muted-foreground">
                            @(member.TotalUtilization > 100 ? "⚠️ Overallocated" : "✓ Balanced")
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Project(string Name, int Utilization);

    private record TeamMember(string Name, Project[] Projects, int TotalUtilization);

    private static readonly TeamMember[] _team =
    [
        new("Sarah Chen",
            [
                new("Dashboard v2", 40),
                new("API Integration", 35),
            ],
            75),
        new("Marcus Rodriguez",
            [
                new("Backend Refactor", 50),
                new("Performance Optimization", 45),
                new("Mentoring", 15),
            ],
            110),
        new("Emily Watson",
            [
                new("Design System", 60),
                new("User Research", 25),
            ],
            85),
    ];
}
