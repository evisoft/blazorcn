@* ============================================================
   Block: team-volunteer
   Title: Team Volunteer
   Description: Community service and volunteer work block with activity rows showing participating members, hours contributed, and impact metrics
   Dependencies: LucideChevronRightCn, LucideHeartCn
   Source: original/blocks/team/team-volunteer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium">Community involvement</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">Volunteer work and social impact</p>
                </div>
                <LucideHeartCn Size="16" Class="size-4 text-muted-foreground" />
            </div>
        </div>

        <div class="flex items-center gap-6 border-b px-4 py-3">
            <div>
                <span class="font-semibold text-2xl tabular-nums">@_activities.Sum(a => a.Hours)</span>
                <p class="text-xs text-muted-foreground">Total hours</p>
            </div>
            <div>
                <span class="font-semibold text-2xl tabular-nums">@_activities.Select(a => a.Organization).Distinct().Count()</span>
                <p class="text-xs text-muted-foreground">Organizations</p>
            </div>
            <div>
                <span class="font-semibold text-2xl tabular-nums">@_activities.Length</span>
                <p class="text-xs text-muted-foreground">Activities</p>
            </div>
        </div>

        <div>
            @for (var index = 0; index < _activities.Length; index++)
            {
                var activity = _activities[index];
                var isExpanded = _expanded == activity.Id;
                var isLast = index == _activities.Length - 1;
                <div class="@Cn.Merge(!isLast ? "border-b" : "")">
                    <button type="button" @onclick="@(() => _expanded = isExpanded ? null : activity.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@activity.Name</span>
                                <span class="hidden shrink-0 rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground sm:inline">@(activity.Hours)h</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="text-xs text-muted-foreground">@activity.Organization</span>
                                <span class="text-muted-foreground text-xs">&middot;</span>
                                <span class="font-mono text-xs text-muted-foreground">@activity.Date</span>
                            </div>
                        </div>

                        <div class="flex -space-x-1.5">
                            @foreach (var p in activity.Participants.Take(4))
                            {
                                <div class="flex size-6 items-center justify-center rounded-full border-2 border-card bg-muted text-[10px] font-medium" title="@p.Name">@p.Initials</div>
                            }
                            @if (activity.Participants.Length > 4)
                            {
                                <div class="flex size-6 items-center justify-center rounded-full border-2 border-card bg-muted text-[10px] font-medium text-muted-foreground">+@(activity.Participants.Length - 4)</div>
                            }
                        </div>

                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-4">
                            <p class="text-sm leading-relaxed text-muted-foreground">@activity.Description</p>
                            <div class="mt-2 flex flex-wrap gap-1">
                                @foreach (var p in activity.Participants)
                                {
                                    <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@p.Name</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record Participant(string Name, string Initials);
    private record ActivityItem(string Id, string Name, string Organization, string Date, int Hours, Participant[] Participants, string Description);

    private static readonly ActivityItem[] _activities =
    [
        new("1", "Beach cleanup drive", "Ocean Conservancy", "Mar 2026", 64,
            [new("Sarah Chen", "SC"), new("Marcus Johnson", "MJ"), new("Elena Rodriguez", "ER"), new("David Kim", "DK")],
            "Team of 4 spent a full Saturday cleaning 2.4 miles of coastline near Half Moon Bay. Collected over 180 lbs of debris including fishing nets and microplastics. Partnered with local high school volunteers."),
        new("2", "Code mentorship program", "Girls Who Code", "Feb 2026", 120,
            [new("Aisha Patel", "AP"), new("James O'Brien", "JO"), new("Yuki Tanaka", "YT")],
            "Ongoing 12-week mentorship pairing 3 engineers with high school students learning Python and web development. Students built their first portfolio sites by the end of the program."),
        new("3", "Food bank sorting", "SF-Marin Food Bank", "Jan 2026", 48,
            [new("Priya Sharma", "PS"), new("Marcus Johnson", "MJ"), new("Sarah Chen", "SC"), new("Elena Rodriguez", "ER"), new("Aisha Patel", "AP"), new("David Kim", "DK")],
            "All-hands volunteer day sorting and packing 12,000 lbs of food for distribution to 45 Bay Area pantries. Largest team turnout for a single volunteer event."),
        new("4", "Habitat for Humanity build", "Habitat for Humanity", "Dec 2025", 80,
            [new("James O'Brien", "JO"), new("David Kim", "DK"), new("Yuki Tanaka", "YT")],
            "Two-day home build in East Oakland. Team helped frame walls and install insulation for a 3-bedroom home for a family of five. Second annual build with Habitat."),
        new("5", "STEM workshop for kids", "Techbridge Girls", "Nov 2025", 32,
            [new("Elena Rodriguez", "ER"), new("Priya Sharma", "PS")],
            "Ran a hands-on robotics workshop for 30 middle school girls in East Palo Alto. Participants built and programmed simple line-following robots using Arduino kits."),
    ];
}
