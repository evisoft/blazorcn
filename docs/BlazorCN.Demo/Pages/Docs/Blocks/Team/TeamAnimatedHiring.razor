@* ============================================================
   Block: team-animated-hiring
   Title: Team Animated Hiring
   Description: Animated hiring block with count-up stats, staggered position rows, and hover-scaling apply buttons using framer-motion
   Long Description: Static hiring block with open positions
   Dependencies: ButtonCn, LucideArrowRightCn
   Source: original/blocks/team/team-animated-hiring.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <p class="text-sm font-medium">We're hiring</p>
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Join our team and help shape the future of developer tools
            </p>
        </div>

        <div class="flex items-center gap-6 border-b px-4 py-3">
            @foreach (var stat in _statItems)
            {
                <div>
                    <span class="@Cn.Merge("text-2xl font-semibold tabular-nums", stat.Color ?? "")">@stat.Target</span>
                    <p class="text-xs text-muted-foreground">@stat.Label</p>
                </div>
            }
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-sm leading-relaxed text-muted-foreground">
                Competitive compensation, meaningful equity, and a flexible work environment across 12 countries.
            </p>
        </div>

        @for (var i = 0; i < _positions.Length; i++)
        {
            var position = _positions[i];
            <div class="@Cn.Merge("flex items-center justify-between gap-3 px-4 py-3", i < _positions.Length - 1 ? "border-b" : "")">
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium">@position.Title</p>
                    <div class="mt-0.5 flex items-center gap-2">
                        <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                            @position.Department
                        </span>
                        <span class="text-xs text-muted-foreground">@position.Type</span>
                    </div>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                    Apply
                    <LucideArrowRightCn Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        }
    </div>
</section>

@code {
    private record StatItem(string Label, int Target, string? Color = null);

    private static readonly StatItem[] _statItems =
    [
        new("Team size", 42),
        new("Open roles", 7, "text-emerald-600 dark:text-emerald-400"),
        new("Countries", 12),
    ];

    private record PositionItem(string Id, string Title, string Department, string Type);

    private static readonly PositionItem[] _positions =
    [
        new("p1", "Senior Frontend Engineer", "Engineering", "Full-time, Remote"),
        new("p2", "Product Marketing Manager", "Marketing", "Full-time, Hybrid"),
        new("p3", "Developer Advocate", "DevRel", "Full-time, Remote"),
        new("p4", "Senior Product Designer", "Design", "Full-time, Remote"),
        new("p5", "Data Engineer", "Engineering", "Full-time, On-site"),
        new("p6", "Sales Development Rep", "Sales", "Full-time, Hybrid"),
        new("p7", "Technical Writer", "Engineering", "Contract, Remote"),
    ];
}
