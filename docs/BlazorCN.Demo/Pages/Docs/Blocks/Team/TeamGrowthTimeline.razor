@* ============================================================
   Block: team-growth-timeline
   Title: Team Growth Timeline
   Description: Vertical timeline with dot indicators and border-b rows showing company milestones and key hires
   Dependencies: None
   Source: original/blocks/team/team-growth-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Growth timeline</p>
            <p class="mt-0.5 text-xs text-muted-foreground">From two co-founders to 45 employees</p>
        </div>

        <div>
            @for (var i = 0; i < _milestones.Length; i++)
            {
                var milestone = _milestones[i];
                var isLast = i == _milestones.Length - 1;
                <div class="@Cn.Merge("flex gap-3 px-4 py-3", !isLast ? "border-b" : "")">
                    <div class="flex flex-col items-center pt-1.5">
                        <span class="size-1.5 shrink-0 rounded-full bg-foreground"></span>
                        @if (!isLast)
                        {
                            <div class="mt-1.5 w-px flex-1 bg-border"></div>
                        }
                    </div>
                    <div class="min-w-0 flex-1 pb-1">
                        <div class="flex items-center gap-2">
                            <span class="font-mono text-xs text-muted-foreground">@milestone.Date</span>
                        </div>
                        <p class="mt-0.5 text-sm font-medium">@milestone.Title</p>
                        <p class="mt-1 text-xs leading-relaxed text-muted-foreground">@milestone.Description</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record MilestoneItem(string Date, string Title, string Description);
    private static readonly MilestoneItem[] _milestones =
    [
        new("Jan 2019", "Company founded", "Ingrid Solberg and James Okoye incorporated the company after meeting at a developer conference. First line of code written in a coffee shop in the Mission District."),
        new("Mar 2020", "First engineering hire", "Mei-Lin Wu joined from Cloudflare as the first engineer. Previously built edge computing infrastructure serving 25 million requests per second."),
        new("Sep 2020", "Seed round closed", "Raised $4.2M seed round led by Sequoia Scout. Used the funding to grow the engineering team from 3 to 8 and launch the public beta."),
        new("Feb 2021", "Design leadership", "Anders Holm joined as VP of Design from Airbnb, where he redesigned host onboarding reducing drop-off by 34%. Established the design language and component system."),
        new("Jun 2021", "Product leadership", "Priya Kapoor joined as VP of Product from Linear during hypergrowth. Brought a framework for ruthless prioritization that transformed how the team ships."),
        new("Jan 2023", "Series A and growth team", "Closed $18M Series A. Felix Brennan joined as Head of Growth from Spotify. Designed the referral system that now drives 40% of organic signups."),
        new("Mar 2024", "12,000 teams milestone", "Yuki Tanaka joined as Head of Data from Mercari. Built recommendation systems powering 30% of all transactions. Team grew to 45 employees across 3 offices."),
    ];
}
