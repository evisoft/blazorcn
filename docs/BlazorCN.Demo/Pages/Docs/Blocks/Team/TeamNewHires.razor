@* ============================================================
   Block: team-new-hires
   Title: Team New Hires
   Description: Recent new hire spotlight section with initials, name, role, department chip, start date, and background snippet
   Long Description: Dense list with department chips and tight spacing
   Dependencies: None
   Source: original/blocks/team/team-new-hires.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <p class="text-sm font-medium">Welcome our newest members</p>
                <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                    Q1 2026
                </span>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                6 new hires joined this quarter across 5 departments
            </p>
        </div>
        @foreach (var hire in _newHires)
        {
            <div class="border-b px-4 py-3 last:border-b-0">
                <div class="flex items-start gap-3">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @hire.Initials
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-baseline gap-2">
                            <span class="text-sm font-medium">@hire.Name</span>
                            <span class="hidden text-xs text-muted-foreground sm:inline">
                                @hire.Role
                            </span>
                        </div>
                        <p class="truncate text-xs text-muted-foreground sm:hidden">@hire.Role</p>
                        <div class="mt-1 flex items-center gap-2">
                            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                @hire.Department
                            </span>
                            <span class="text-xs text-muted-foreground/60">@hire.StartDate</span>
                        </div>
                        <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
                            @hire.FunFact
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record NewHire(string Name, string Role, string Department, string Initials, string StartDate, string FunFact);

    private static readonly NewHire[] _newHires =
    [
        new("Camille Dubois", "Senior Frontend Engineer", "Engineering", "CD", "Mar 3, 2026", "Previously built the design system at Figma used by 4 million designers. Speaks four languages fluently and once cycled from Paris to Istanbul."),
        new("Ravi Krishnan", "Staff Data Engineer", "Data", "RK", "Mar 3, 2026", "Led the real-time analytics pipeline at Stripe processing 500 million events daily. Competitive chess player ranked in the top 2,000 nationally."),
        new("Astrid Magnusson", "Product Designer", "Design", "AM", "Feb 17, 2026", "Redesigned the onboarding flow at Linear reducing time-to-first-value by 40%. Runs an illustration newsletter with 12,000 subscribers."),
        new("Jordan Mitchell", "Developer Relations Engineer", "Marketing", "JM", "Feb 17, 2026", "Created three open-source CLI tools with a combined 45,000 GitHub stars. Former high school math teacher who transitioned into tech at 28."),
        new("Mei-Ling Zhao", "Security Engineer", "Infrastructure", "MZ", "Feb 3, 2026", "Previously led red team exercises at Cloudflare and discovered two CVEs in widely used open-source libraries. Avid birdwatcher with 340 species logged."),
        new("Tomas Herrera", "Account Executive", "Sales", "TH", "Jan 20, 2026", "Closed $4.2M in ARR in his first year at Notion selling to enterprise accounts. Coached youth soccer for six years and holds a USSF D license."),
    ];
}
