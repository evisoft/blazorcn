@* ============================================================
   Block: team-animated-counter
   Title: Team Animated Counter
   Description: Animated team statistics dashboard with counting number animations using requestAnimationFrame and staggered department breakdown rows for React team pages
   Long Description: Static team statistics with department breakdown
   Dependencies: None
   Source: original/blocks/team/team-animated-counter.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Team overview</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Key metrics and department breakdown
            </p>
        </div>

        <div class="grid grid-cols-2 gap-0 border-b sm:grid-cols-4">
            <div class="border-r">
                <div class="px-4 py-3">
                    <p class="text-xs text-muted-foreground">Headcount</p>
                    <p class="mt-0.5 text-2xl font-semibold tabular-nums">142</p>
                </div>
            </div>
            <div class="sm:border-r">
                <div class="px-4 py-3">
                    <p class="text-xs text-muted-foreground">Countries</p>
                    <p class="mt-0.5 text-2xl font-semibold tabular-nums">18</p>
                </div>
            </div>
            <div class="border-r border-t sm:border-t-0">
                <div class="px-4 py-3">
                    <p class="text-xs text-muted-foreground">Avg. tenure</p>
                    <p class="mt-0.5 text-2xl font-semibold tabular-nums">24<span class="text-sm font-normal text-muted-foreground"> mo</span></p>
                </div>
            </div>
            <div class="border-t sm:border-t-0">
                <div class="px-4 py-3">
                    <p class="text-xs text-muted-foreground">Open roles</p>
                    <p class="mt-0.5 text-2xl font-semibold tabular-nums">12</p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-2.5">
            <p class="text-xs font-medium text-muted-foreground">Department breakdown</p>
        </div>

        @for (var i = 0; i < _departments.Length; i++)
        {
            var dept = _departments[i];
            var percentage = (int)Math.Round((double)dept.Headcount / MaxHeadcount * 100);
            <div class="@Cn.Merge("px-4 py-2.5", i < _departments.Length - 1 ? "border-b" : "")">
                <div class="flex items-center justify-between">
                    <div class="flex items-baseline gap-2">
                        <span class="text-sm font-medium">@dept.Name</span>
                        <span class="font-mono text-xs text-muted-foreground">
                            @dept.Headcount
                        </span>
                    </div>
                    <span class="text-xs text-muted-foreground">@dept.Lead</span>
                </div>
                <div class="mt-1.5 h-1.5 w-full rounded-full bg-muted">
                    <div class="h-1.5 rounded-full bg-foreground/20" style="width: @(percentage)%"></div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private const int MaxHeadcount = 58;

    private record DepartmentItem(string Name, int Headcount, string Lead);

    private static readonly DepartmentItem[] _departments =
    [
        new("Engineering", 58, "Mei-Lin Wu"),
        new("Product", 22, "Priya Kapoor"),
        new("Design", 18, "Anders Holm"),
        new("Marketing", 16, "Felix Brennan"),
        new("Sales", 14, "Carlos Rivera"),
        new("Operations", 8, "Nina Johansson"),
        new("People", 6, "Amara Osei"),
    ];
}
