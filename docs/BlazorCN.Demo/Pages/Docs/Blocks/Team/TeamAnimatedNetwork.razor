@* ============================================================
   Block: team-animated-network
   Title: Team Animated Network
   Description: Team collaboration network block showing connections between members with animated highlight, scale, and opacity transitions for React about pages
   Long Description: Hierarchical tree layout showing reporting structure
   Dependencies: LucideUsersCn
   Source: original/blocks/team/team-animated-network.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Collaboration network</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    @if (_selected != null)
                    {
                        var sel = _members.First(m => m.Id == _selected);
                        @($"{sel.Name} works with {sel.Connections.Length} people")
                    }
                    else
                    {
                        <text>Click a member to see their connections</text>
                    }
                </p>
            </div>
            @if (_selected != null)
            {
                <button type="button" @onclick="@(() => _selected = null)"
                        class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                    Clear
                </button>
            }
        </div>

        @if (_selected != null)
        {
            var selMember = _members.First(m => m.Id == _selected);
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <LucideUsersCn Size="14" Class="size-3.5 text-muted-foreground" />
                <div class="flex flex-wrap items-center gap-1.5">
                    @foreach (var m in _members.Where(m => m.Id == _selected || selMember.Connections.Contains(m.Id)))
                    {
                        <span class="@Cn.Merge("rounded bg-muted px-1.5 py-0.5 text-xs", m.Id == _selected ? "font-medium text-foreground" : "text-muted-foreground")">
                            @m.Name.Split(' ')[0]
                        </span>
                    }
                </div>
            </div>
        }

        <div>
            @for (var i = 0; i < _members.Length; i++)
            {
                var member = _members[i];
                var connected = IsConnected(member.Id);
                var active = member.Id == _selected;
                var isLast = i == _members.Length - 1;
                <div class="@(isLast ? "" : "border-b")" style="@(!connected ? "opacity: 0.3" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _selected = active ? null : member.Id)"
                        class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", active ? "bg-muted/30" : "")">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                            @member.Initials
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@member.Name</span>
                                <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                    @member.Department
                                </span>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">@member.Role</p>
                        </div>
                        <span class="text-xs tabular-nums text-muted-foreground">
                            @member.Connections.Length connections
                        </span>
                    </button>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _selected;

    private bool IsConnected(string memberId)
    {
        if (_selected == null) return true;
        if (memberId == _selected) return true;
        var sel = _members.FirstOrDefault(m => m.Id == _selected);
        return sel?.Connections.Contains(memberId) ?? false;
    }

    private record MemberItem(string Id, string Name, string Role, string Initials, string Department, string[] Connections);

    private static readonly MemberItem[] _members =
