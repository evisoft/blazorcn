@* ============================================================
   Block: team-member-feedback-received
   Title: TeamMemberFeedbackReceived
   Description: A feedback and peer review summary block for React and Next.js displaying team member feedback built with shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-member-feedback-received.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="space-y-4">
        <div>
            <h2 class="text-sm font-medium">Peer Feedback</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                What colleagues say about working with you
            </p>
        </div>

        <div class="space-y-4">
            @foreach (var member in _team)
            {
                <div class="rounded-lg border bg-card p-4">
                    <h3 class="mb-3 text-sm font-medium">@member.Name</h3>
                    <div class="space-y-2">
                        @foreach (var fb in member.Feedback)
                        {
                            <div class="rounded-md bg-muted/20 p-2.5">
                                <div class="flex items-center gap-2 mb-1.5">
                                    <LucideIconCn Name="message-circle" Size="12" Class="size-3 shrink-0" />
                                    <span class="text-sm font-medium">@fb.Theme</span>
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs ml-auto">
                                        @fb.Count mentions
                                    </BadgeCn>
                                </div>
                                <p class="text-xs text-muted-foreground">@string.Join(" • ", fb.Examples)</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record FeedbackItem(string Theme, int Count, string[] Examples);
    private record TeamMember(string Name, FeedbackItem[] Feedback);

    private static readonly TeamMember[] _team =
    [
        new("Sarah Chen",
        [
            new("Strong Leadership", 5, ["Clear vision", "Empowering team", "Strategic thinking"]),
            new("Great Communicator", 4, ["Clear explanations", "Active listening", "Transparent"]),
        ]),
        new("Marcus Rodriguez",
        [
            new("Technical Excellence", 6, ["Quality code", "Problem solving", "Architecture"]),
            new("Helpful & Patient", 4, ["Mentors juniors", "Code reviews", "Always helping"]),
        ]),
    ];
}
