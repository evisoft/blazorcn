@* ============================================================
   Block: team-communication-preferences
   Title: TeamCommunicationPreferences
   Description: React team directory with contact methods and response times using Next.js, shadcn/ui Button, and Tailwind CSS for remote teams.
   Source: original/blocks/team/team-communication-preferences.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Communication preferences</p>
            <p class="mt-0.5 text-xs text-muted-foreground">How to reach each team member</p>
        </div>

        <div>
            @foreach (var member in _members)
            {
                var isExpanded = _expanded == member.Name;
                var isLast = member.Name == _members[_members.Length - 1].Name;
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : member.Name)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                            @member.Initials
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@member.Name</span>
                                <span class="text-xs text-muted-foreground">@member.Role</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2">
                                <LucideIconCn Name="@GetChannelIcon(member.Preferred)" Size="12" Class="size-3 text-muted-foreground" />
                                <span class="text-xs text-muted-foreground">@GetChannelLabel(member.Preferred)</span>
                                <span class="text-xs text-muted-foreground">·</span>
                                <span class="text-xs text-muted-foreground">@member.ResponseTime</span>
                            </div>
                        </div>
                        <span class="shrink-0 text-xs text-muted-foreground">@member.BestHours</span>
                        <LucideIconCn
                            Name="chevron-right"
                            Size="16"
                            Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-15">
                            <div class="mb-2 flex items-center gap-2">
                                @foreach (var ch in member.Channels)
                                {
                                    var channel = ch;
                                    <span class="@Cn.Merge("flex items-center gap-1 rounded px-1.5 py-0.5 text-xs", channel == member.Preferred ? "bg-foreground/10 font-medium" : "bg-muted text-muted-foreground")">
                                        <LucideIconCn Name="@GetChannelIcon(channel)" Size="12" Class="size-3" />
                                        @GetChannelLabel(channel)
                                    </span>
                                }
                            </div>
                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="text-xs font-medium text-muted-foreground">Note</span>
                                <p class="mt-1 text-sm leading-relaxed">@member.Note</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private enum Channel { Slack, Email, Video, Phone }

    private record TeamMember(
        string Name,
        string Role,
        string Initials,
        Channel Preferred,
        string ResponseTime,
        string BestHours,
        Channel[] Channels,
        string Note);

    private static readonly TeamMember[] _members =
    [
        new("Sarah Chen", "Engineering Lead", "SC", Channel.Slack, "< 15 min", "10 AM - 4 PM PT",
            [Channel.Slack, Channel.Video, Channel.Email],
            "Prefers async messages over meetings. Book 25-min slots for syncs. No meetings on Wednesdays."),
        new("Marcus Johnson", "Backend Engineer", "MJ", Channel.Slack, "< 30 min", "9 AM - 5 PM ET",
            [Channel.Slack, Channel.Email],
            "Deep work blocks 9-11 AM. Slack threads preferred over DMs. Available for pairing after 2 PM."),
        new("Elena Rodriguez", "Product Designer", "ER", Channel.Video, "< 1 hour", "10 AM - 6 PM CET",
            [Channel.Video, Channel.Slack, Channel.Email],
            "Visual discussions work best on video. Shares Loom recordings for async feedback. Figma comments for design reviews."),
        new("David Kim", "Frontend Engineer", "DK", Channel.Slack, "< 20 min", "11 AM - 7 PM PT",
            [Channel.Slack, Channel.Video],
            "Late starter. Responds fastest in Slack channels. Prefers code review comments in GitHub."),
        new("Aisha Patel", "Product Manager", "AP", Channel.Email, "< 2 hours", "8 AM - 4 PM ET",
            [Channel.Email, Channel.Slack, Channel.Video, Channel.Phone],
            "Email for decisions that need a paper trail. Slack for quick questions. Open to impromptu calls for urgent items."),
        new("James O'Brien", "DevOps Engineer", "JO", Channel.Slack, "< 10 min", "8 AM - 3 PM ET",
            [Channel.Slack, Channel.Phone],
            "Page for production incidents. Slack for everything else. Wraps up early, async-first after 3 PM."),
    ];

    private static string GetChannelIcon(Channel ch) => ch switch
    {
        Channel.Slack => "message-square",
        Channel.Email => "mail",
        Channel.Video => "video",
        Channel.Phone => "phone",
        _ => "message-square"
    };

    private static string GetChannelLabel(Channel ch) => ch switch
    {
        Channel.Slack => "Slack",
        Channel.Email => "Email",
        Channel.Video => "Video",
        Channel.Phone => "Phone",
        _ => "Slack"
    };
}
