@* ============================================================
   Block: team-member-expertise-tags
   Title: TeamMemberExpertiseTags
   Description: An expertise tagging and specialization block for React and Next.js displaying team member skill tags built with shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-member-expertise-tags.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="space-y-4">
        <div>
            <h2 class="text-sm font-medium">Expertise Tags</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Team skills and specializations</p>
        </div>

        <div class="space-y-4">
            @foreach (var member in _team)
            {
                <div class="rounded-lg border bg-card p-4">
                    <div class="mb-3">
                        <h3 class="text-sm font-medium">@member.Name</h3>
                        <p class="mt-0.5 text-xs text-muted-foreground">@member.Role</p>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var tag in member.Expertise)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@tag</BadgeCn>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TeamMemberTags(string Name, string Role, string[] Expertise);

    private static readonly TeamMemberTags[] _team =
    [
        new("Sarah Chen", "Product Lead", ["Product Strategy", "Roadmapping", "User Research", "Analytics", "Stakeholder Management"]),
        new("Marcus Rodriguez", "Engineering Lead", ["Backend", "Databases", "DevOps", "Mentoring", "Architecture"]),
        new("Emily Watson", "Design Lead", ["UI Design", "UX Research", "Design Systems", "Prototyping", "Brand"]),
    ];
}
