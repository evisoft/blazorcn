@* ============================================================
   Block: team-member-coffee-match
   Title: TeamMemberCoffeeMatch
   Description: A team connection and random pairing suggestion block for React and Next.js for fostering team bonding and collaboration built with shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-member-coffee-match.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="space-y-6">
        @* Header *@
        <div>
            <h2 class="text-sm font-medium">Coffee Match</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Find your next team connection</p>
        </div>

        @* Pairing Cards *@
        <div class="grid gap-3 grid-cols-2">
            @foreach (var person in new[] { _person1, _person2 })
            {
                <div class="overflow-hidden rounded-lg border bg-card p-3">
                    <h3 class="text-sm font-medium">@person.Name</h3>
                    <p class="mt-0.5 text-xs text-muted-foreground">@person.Role</p>
                    <div class="mt-2 inline-flex rounded-full bg-muted/50 px-2 py-1">
                        <span class="text-xs text-muted-foreground">@person.Department</span>
                    </div>
                </div>
            }
        </div>

        @* Connection Indicator *@
        <div class="flex items-center justify-center gap-2">
            <div class="h-px flex-1 bg-border"></div>
            <LucideIconCn Name="zap" Size="16" Class="size-4 text-muted-foreground" />
            <div class="h-px flex-1 bg-border"></div>
        </div>

        @* Conversation Starter *@
        <div class="overflow-hidden rounded-lg border bg-muted/30 p-4">
            <span class="text-xs font-medium text-muted-foreground">Conversation Starter</span>
            <p class="mt-2 text-sm italic text-foreground">"@_pairing.Starter"</p>
        </div>

        @* Action Buttons *@
        <div class="flex gap-2">
            <ButtonCn Class="flex-1" @onclick="GeneratePairing">
                <LucideIconCn Name="refresh-cw" Size="16" Class="size-4" />
                New Pairing
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1">
                Schedule Chat
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TeamMember(string Id, string Name, string Department, string Role);
    private record Pairing(string Id1, string Id2, string Starter);

    private static readonly TeamMember[] _teamMembers =
    [
        new("1", "Sarah Chen", "Product", "Product Lead"),
        new("2", "Marcus Rodriguez", "Engineering", "Engineering Lead"),
        new("3", "Emily Watson", "Design", "Design Lead"),
        new("4", "Alex Kim", "Growth", "Growth Lead"),
    ];

    private static readonly string[] _conversationStarters =
    [
        "What's your biggest win this quarter?",
        "What's one skill you'd like to learn?",
        "Tell me about a project you're proud of",
        "What's your ideal work environment?",
        "Share your best productivity tip",
    ];

    private static readonly Random _rng = new();

    private Pairing _pairing = default!;

    protected override void OnInitialized()
    {
        _pairing = CreatePairing();
    }

    private Pairing CreatePairing()
    {
        var shuffled = _teamMembers.OrderBy(_ => _rng.Next()).ToArray();
        var starter = _conversationStarters[_rng.Next(_conversationStarters.Length)];
        return new Pairing(shuffled[0].Id, shuffled[1].Id, starter);
    }

    private void GeneratePairing()
    {
        _pairing = CreatePairing();
    }

    private TeamMember _person1 => _teamMembers.First(m => m.Id == _pairing.Id1);
    private TeamMember _person2 => _teamMembers.First(m => m.Id == _pairing.Id2);
}
