@code {
    private static string GetStatusColor(string status) => status switch
    {
        ""online"" => ""bg-emerald-500"",
        ""busy"" => ""bg-amber-500"",
        ""offline"" => ""bg-zinc-400 dark:bg-zinc-600"",
        _ => ""bg-zinc-400"",
    };

    private static string GetStatusLabel(string status) => status switch
    {
        ""online"" => ""Online"",
        ""busy"" => ""Busy"",
        ""offline"" => ""Offline"",
        _ => ""Unknown"",
    };

    private static string GetNextStatus(string status) => status switch
    {
        ""online"" => ""busy"",
        ""busy"" => ""offline"",
        ""offline"" => ""online"",
        _ => ""online"",
    };

    private void ToggleStatus(string id)
    {
        var member = _members.FirstOrDefault(m => m.Id == id);
        if (member != null) member.Status = GetNextStatus(member.Status);
    }

