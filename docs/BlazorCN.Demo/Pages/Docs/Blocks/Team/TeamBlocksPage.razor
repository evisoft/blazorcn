                @bind:event=""oninput""
                placeholder=""Search by name, role, or department...""
                class=""h-6 w-full border-0 bg-transparent text-sm outline-none placeholder:text-muted-foreground/60"" />
            <span class=""shrink-0 text-xs tabular-nums text-muted-foreground"">
                @_filtered.Length/@_members.Length
            </span>
        </div>

        <div class=""divide-y"">
            @foreach (var member in _filtered)
            {
                <div class=""flex items-center gap-3 px-4 py-3"">
                    <div class=""flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium"">
                        @member.Initials
