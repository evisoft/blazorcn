@code {
    private const string TeamAccordionProfilesCode = @"<section class=""mx-auto w-full max-w-2xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        <div class=""border-b px-4 py-3"">
            <p class=""text-sm font-medium"">Team</p>
            <p class=""mt-0.5 text-xs text-muted-foreground"">Click a row to view full profile</p>
        </div>
        @foreach (var member in _members)
        {
            var isExpanded = _expanded == member.Name;
            <div class=""border-b last:border-b-0"">
                <button
                    type=""button""
                    @onclick=""@(() => _expanded = isExpanded ? null : member.Name)""
                    class=""flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"">
                    <div class=""flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium"">
                        @member.Initials
                    </div>
                    <div class=""min-w-0 flex-1"">
                        <span class=""text-sm font-medium"">@member.Name</span>
                        <p class=""mt-0.5 truncate text-xs text-muted-foreground"">@member.Role</p>
                    </div>
                    <LucideChevronRightCn
                        Size=""16""
                        Class=""@Cn.Merge(""shrink-0 text-muted-foreground/60 transition-transform duration-200"", isExpanded ? ""rotate-90"" : """")"" />
                </button>
                @if (isExpanded)
                {
                    <div class=""border-t bg-muted/30 px-4 py-3"">
                        <div class=""ml-11 space-y-2"">
                            <span class=""rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground"">
                                @member.Department
                            </span>
                            <p class=""text-xs italic text-muted-foreground leading-relaxed"">
                                &ldquo;@member.Quote&rdquo;
                            </p>
                            <p class=""text-xs text-muted-foreground leading-relaxed"">@member.Bio</p>
                            @if (member.Social.Length > 0)
                            {
                                <div class=""flex items-center gap-1 pt-0.5"">
                                    @for (var i = 0; i < member.Social.Length; i++)
                                    {
                                        var link = member.Social[i];
                                        var idx = i;
                                        <span class=""flex items-center gap-1"">
                                            @if (idx > 0)
                                            {
                                                <span class=""text-xs text-muted-foreground/40"">&middot;</span>
                                            }
                                            <a
                                                href=""@link.Href""
                                                class=""text-xs text-muted-foreground underline-offset-2 hover:text-foreground hover:underline"">
                                                @link.Label
                                            </a>
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

