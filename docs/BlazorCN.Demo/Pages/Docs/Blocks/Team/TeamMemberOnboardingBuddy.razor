@* ============================================================
   Block: team-member-onboarding-buddy
   Title: TeamMemberOnboardingBuddy
   Description: An onboarding buddy assignment block for React and Next.js displaying mentor pairings built with shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-member-onboarding-buddy.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="space-y-4">
        <div>
            <h2 class="text-sm font-medium">Onboarding Buddies</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">First-week buddy assignments</p>
        </div>

        <div class="space-y-2">
            @foreach (var pair in _buddies)
            {
                <div class="rounded-lg border bg-card p-3">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium">@pair.NewHire</p>
                            <p class="text-xs text-muted-foreground">Buddy: @pair.Buddy</p>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                            @pair.StartDate
                        </BadgeCn>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record BuddyPair(string NewHire, string Buddy, string StartDate, string Role);

    private static readonly BuddyPair[] _buddies =
    [
        new("Casey Park", "Emily Watson", "Apr 1", "Designer"),
        new("Jordan Lee", "Marcus Rodriguez", "Apr 8", "Engineer"),
    ];
}
