@* ============================================================
   Block: team-hackathon
   Title: Team Hackathon Projects and Winners
   Description: Internal hackathon project showcase with expandable rows, team member initials, prize placement indicators, and project descriptions
   Dependencies: none (pure HTML/Tailwind)
   Source: original/blocks/team/team-hackathon.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideTrophyCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Hackathon Q1 2026</p>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                48 hours of building, shipping, and presenting
            </p>
        </div>

        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div>
                <p class="text-2xl font-semibold tabular-nums">@_projects.Length</p>
                <p class="text-xs text-muted-foreground">projects</p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-2xl font-semibold tabular-nums">@_totalParticipants</p>
                <p class="text-xs text-muted-foreground">participants</p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-2xl font-semibold tabular-nums">48h</p>
                <p class="text-xs text-muted-foreground">duration</p>
            </div>
        </div>

        @foreach (var project in _projects)
        {
            var isExpanded = _expanded == project.Name;
            <div class="border-b last:border-b-0">
                <button type="button"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => _expanded = isExpanded ? null : project.Name)">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-baseline gap-2">
                            <span class="text-sm font-medium">@project.Name</span>
                            @if (project.Placement is not null)
                            {
                                <span class="@Cn.Merge("text-xs font-medium", GetPlacementColor(project.Placement.Value))">
                                    @GetPlacementLabel(project.Placement.Value)
                                </span>
                            }
                        </div>
                        <div class="mt-1 flex items-center gap-1.5">
                            <div class="flex -space-x-1.5">
                                @foreach (var member in project.TeamMembers)
                                {
                                    <div class="flex size-6 items-center justify-center rounded-full border-2 border-card bg-muted text-[10px] font-medium"
                                         title="@member.Name">
                                        @member.Initials
                                    </div>
                                }
                            </div>
                            <span class="ml-1 text-xs text-muted-foreground">
                                @project.TeamMembers.Length @(project.TeamMembers.Length == 1 ? "member" : "members")
                            </span>
                        </div>
                    </div>
                    <LucideChevronRightCn Size="16"
                                          Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                </button>
                @if (isExpanded)
                {
                    <div class="border-t bg-muted/30 px-4 py-3">
                        <div class="space-y-2">
                            <p class="text-xs leading-relaxed text-muted-foreground">
                                @project.Description
                            </p>
                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var tech in project.TechStack)
                                {
                                    <span class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs text-muted-foreground">
                                        @tech
                                    </span>
                                }
                            </div>
                            <div class="pt-1">
                                <p class="text-xs text-muted-foreground">
                                    <span class="font-medium text-foreground/80">Team:</span>
                                    @string.Join(", ", project.TeamMembers.Select(m => m.Name))
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record TeamMemberBrief(string Name, string Initials);
    private record HackathonProject(string Name, int? Placement, TeamMemberBrief[] TeamMembers, string Description, string[] TechStack);

    private string? _expanded;

    private static readonly HackathonProject[] _projects =
    [
        new("CodeReview Copilot", 1,
            [new("Mei-Lin Wu", "MW"), new("Leo Andersen", "LA"), new("Astrid Magnusson", "AM")],
            "An AI-powered code review assistant that analyzes pull requests for security vulnerabilities, performance regressions, and style inconsistencies. Integrates with GitHub webhooks and posts inline suggestions as review comments. Reduced average review time by 45% in a two-week pilot with the platform team.",
            ["TypeScript", "OpenAI API", "GitHub Actions", "PostgreSQL"]),
        new("Deploy Dashboard", 2,
            [new("Aarav Sharma", "AS"), new("Sofia Reyes", "SR")],
            "A real-time deployment monitoring dashboard showing build status, rollback history, and environment health across all services. Features a timeline view of deployments with one-click rollback and Slack notifications for failed builds. Now used daily by the on-call rotation.",
            ["Next.js", "WebSockets", "Redis", "Vercel"]),
        new("Onboarding Quest", 3,
            [new("Jordan Mitchell", "JM"), new("Camille Dubois", "CD"), new("Ravi Krishnan", "RK"), new("Tomas Herrera", "TH")],
            "A gamified onboarding experience for new hires that turns the first two weeks into a series of quests. Each quest teaches a different part of the codebase, tooling, or company process. Includes a leaderboard, achievement badges, and a buddy matching system. Three new hires completed onboarding 30% faster in the pilot.",
            ["React", "Prisma", "tRPC", "Tailwind CSS"]),
        new("Incident Timeline", null,
            [new("James Okoye", "JO"), new("Mei-Ling Zhao", "MZ")],
            "An automated incident timeline generator that aggregates PagerDuty alerts, Slack threads, and deployment logs into a single chronological view. Generates draft postmortem documents with root cause suggestions. Reduced postmortem writing time from 3 hours to 40 minutes.",
            ["Python", "FastAPI", "Elasticsearch", "Slack API"]),
        new("Component Playground", null,
            [new("Anders Holm", "AH"), new("Priya Kapoor", "PK"), new("Felix Brennan", "FB")],
            "A live component playground that lets designers and PMs experiment with UI components using a no-code drag-and-drop interface. Generates production-ready React code and syncs with the design system Figma file. Exported 120 component configurations in the first month of internal use.",
            ["React", "Sandpack", "Figma API", "Zustand"]),
    ];

    private static readonly int _totalParticipants = _projects.SelectMany(p => p.TeamMembers).Select(m => m.Name).Distinct().Count();

    private static string GetPlacementLabel(int placement) => placement switch
    {
        1 => "1st",
        2 => "2nd",
        3 => "3rd",
        _ => "",
    };

    private static string GetPlacementColor(int placement) => placement switch
    {
        1 => "text-amber-600 dark:text-amber-400",
        2 => "text-muted-foreground",
        3 => "text-orange-700 dark:text-orange-400",
        _ => "",
    };
}
