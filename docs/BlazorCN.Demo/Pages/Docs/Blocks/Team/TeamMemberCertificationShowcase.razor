@* ============================================================
   Block: team-member-certification-showcase
   Title: TeamMemberCertificationShowcase
   Description: A certifications and credentials display block for React and Next.js showcasing professional certifications built with shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-member-certification-showcase.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="space-y-4">
        <div>
            <h2 class="text-sm font-medium">Certifications</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Professional credentials and certifications
            </p>
        </div>

        <div class="space-y-4">
            @foreach (var member in _team)
            {
                <div class="rounded-lg border bg-card p-4">
                    <h3 class="mb-3 text-sm font-medium">@member.Name</h3>
                    <div class="space-y-2">
                        @foreach (var cert in member.Certifications)
                        {
                            <div class="flex items-start gap-2.5 rounded-md bg-muted/20 p-2.5">
                                <LucideIconCn Name="award" Size="16" Class="size-4 mt-0.5 shrink-0 text-foreground" />
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm font-medium">@cert.Name</p>
                                    <p class="text-xs text-muted-foreground">@cert.Issuer</p>
                                    <p class="text-xs text-muted-foreground mt-0.5">@cert.Date</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Certification(string Name, string Issuer, string Date);
    private record TeamMember(string Name, Certification[] Certifications);

    private static readonly TeamMember[] _team =
    [
        new("Sarah Chen",
        [
            new("Certified Scrum Product Owner", "Scrum Alliance", "Jan 2024"),
            new("Google Analytics Certification", "Google", "Mar 2023"),
        ]),
        new("Marcus Rodriguez",
        [
            new("AWS Solutions Architect", "Amazon", "Jun 2024"),
            new("Kubernetes Certified Developer", "Linux Foundation", "Sep 2023"),
        ]),
    ];
}
