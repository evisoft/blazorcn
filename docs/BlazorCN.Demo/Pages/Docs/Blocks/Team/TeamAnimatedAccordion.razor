@* ============================================================
   Block: team-animated-accordion
   Title: Team Animated Accordion
   Description: Expandable team rows with framer-motion animated height transitions, chevron rotation, staggered entrance, and smooth content reveal for a React team accordion section
   Long Description: Staggered grid entrance with hover lift effects
   Dependencies: LucideChevronRightCn
   Source: original/blocks/team/team-animated-accordion.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Team</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Click any row to learn more about the team
            </p>
        </div>

        @foreach (var member in _members)
        {
            var isExpanded = _expanded.Contains(member.Name);
            <div class="border-b last:border-b-0">
                <button
                    type="button"
                    @onclick="@(() => Toggle(member.Name))"
                    class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @member.Initials
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@member.Name</span>
                            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                @member.Department
                            </span>
                        </div>
                        <p class="mt-0.5 truncate text-xs text-muted-foreground">@member.Role</p>
                    </div>
                    <span class="shrink-0">
                        <LucideChevronRightCn
                            Size="16"
                            Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </span>
                </button>

                @if (isExpanded)
                {
                    <div class="overflow-hidden">
                        <div class="border-t bg-muted/30 px-4 py-3">
                            <div class="ml-11 space-y-3">
                                <p class="text-xs italic text-muted-foreground leading-relaxed">
                                    &ldquo;@member.Quote&rdquo;
                                </p>
                                <p class="text-xs text-muted-foreground leading-relaxed">
                                    @member.Bio
                                </p>
                                <div class="flex flex-wrap gap-1.5">
                                    @foreach (var skill in member.Skills)
                                    {
                                        <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                            @skill
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private HashSet<string> _expanded = new();

    private void Toggle(string name)
    {
        if (!_expanded.Remove(name))
        {
            _expanded.Add(name);
        }
    }

    private record MemberItem(string Name, string Role, string Department, string Bio, string Quote, string Initials, string[] Skills);

