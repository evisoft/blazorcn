@* ============================================================
   Block: team-animated-roles
   Title: Team Animated Roles
   Description: Animated open roles job listing block with staggered entrance, expandable requirements, and smooth layout reflow for React career pages
   Long Description: Team showcase with integrated hiring call-to-action
   Dependencies: ButtonCn, LucideBriefcaseCn, LucideChevronRightCn, LucideMapPinCn
   Source: original/blocks/team/team-animated-roles.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Open roles</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    @_roles.Length positions across @_roles.Select(r => r.Department).Distinct().Count() departments
                </p>
            </div>
            <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <LucideBriefcaseCn Size="14" Class="size-3.5" />
                @_roles.Length open
            </span>
        </div>

        @for (var i = 0; i < _roles.Length; i++)
        {
            var role = _roles[i];
            var isExpanded = _expanded == role.Id;
            var isLast = i == _roles.Length - 1;
            <div class="@(isLast ? "" : "border-b")">
                <button
                    type="button"
                    @onclick="@(() => _expanded = isExpanded ? null : role.Id)"
                    class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                    <div class="min-w-0 flex-1">
                        <span class="text-sm font-medium">@role.Title</span>
                        <div class="mt-1 flex flex-wrap items-center gap-1.5">
                            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                @role.Department
                            </span>
                            <span class="flex items-center gap-1 text-xs text-muted-foreground">
                                <LucideMapPinCn Size="12" Class="size-3" />
                                @role.Location
                            </span>
                            <span class="text-xs text-muted-foreground">&middot;</span>
                            <span class="text-xs text-muted-foreground">@role.Type</span>
                        </div>
                    </div>
                    <LucideChevronRightCn
                        Size="16"
                        Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                </button>

                @if (isExpanded)
                {
                    <div class="overflow-hidden">
                        <div class="px-4 pb-4">
                            <p class="text-sm leading-relaxed text-muted-foreground">
                                @role.Description
                            </p>
                            <div class="mt-3 rounded-md bg-muted/50 p-3">
                                <p class="mb-2 text-xs font-medium text-muted-foreground">Requirements</p>
                                <ul class="space-y-1.5">
                                    @foreach (var req in role.Requirements)
                                    {
                                        <li class="flex items-start gap-2 text-xs leading-relaxed">
                                            <span class="mt-1.5 size-1 shrink-0 rounded-full bg-foreground/40"></span>
                                            @req
                                        </li>
                                    }
                                </ul>
                            </div>
                            <div class="mt-3">
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                    Apply now
                                </ButtonCn>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private string? _expanded;

    private record RoleItem(string Id, string Title, string Department, string Location, string Type, string Description, string[] Requirements);

    private static readonly RoleItem[] _roles =
    [
        new("staff-eng", "Staff Engineer", "Engineering", "Remote", "Full-time",
            "Lead technical architecture decisions across our platform. You will own the design and implementation of core systems serving millions of requests daily.",
            ["8+ years of software engineering experience", "Deep expertise in TypeScript and distributed systems", "Track record of technical leadership on cross-team projects", "Experience with real-time data pipelines at scale"]),
        new("sr-designer", "Senior Product Designer", "Design", "San Francisco", "Full-time",
            "Shape the product experience for developer tools used by thousands of teams. You will work closely with engineering to ship high-craft interfaces.",
            ["5+ years of product design experience", "Strong systems thinking and component design skills", "Experience designing developer-facing tools", "Portfolio demonstrating attention to interaction detail"]),
        new("pm", "Product Manager", "Product", "New York", "Full-time",
            "Define and drive the roadmap for our core platform. You will talk to customers weekly, synthesize insights, and prioritize what moves the needle.",
            ["4+ years of product management experience", "Experience with developer tools or infrastructure products", "Strong analytical skills and data-informed decision making", "Excellent written and verbal communication"]),
        new("growth-eng", "Growth Engineer", "Marketing", "Remote", "Full-time",
            "Build and optimize the acquisition funnel. You will own signup flows, onboarding experiments, and activation metrics across web and email.",
            ["3+ years of full-stack engineering experience", "Experience with A/B testing and experimentation frameworks", "Comfort with analytics tools and conversion metrics", "Familiarity with Next.js and React"]),
        new("devrel", "Developer Advocate", "DevRel", "Remote", "Full-time",
            "Be the bridge between our product and the developer community. You will create technical content, speak at conferences, and build open-source tooling.",
            ["3+ years of software engineering or developer relations", "Strong technical writing and public speaking skills", "Active presence in developer communities", "Experience creating tutorials, videos, or open-source projects"]),
    ];
}
