@* ============================================================
   Block: team-department-tabs
   Title: Team Department Tabs
   Description: Tabbed team section that filters members by All, Engineering, Design, Product, and Marketing departments with border-b active indicator rows
   Dependencies: None
   Source: original/blocks/team/team-department-tabs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex gap-0 overflow-x-auto border-b">
            @foreach (var dept in _departments)
            {
                var d = dept;
                <button type="button" @onclick="@(() => _activeTab = d)"
                        class="@Cn.Merge("shrink-0 px-4 py-3 text-xs font-medium transition-colors", _activeTab == d ? "border-b-2 border-foreground text-foreground" : "text-muted-foreground hover:text-foreground")">
                    @d
                </button>
            }
        </div>

        <div>
            @{ var filtered = _activeTab == "All" ? _members : _members.Where(m => m.Department == _activeTab).ToArray(); }
            @for (var i = 0; i < filtered.Length; i++)
            {
                var member = filtered[i];
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", i < filtered.Length - 1 ? "border-b" : "")">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@member.Initials</div>
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@member.Name</p>
                        <p class="text-xs text-muted-foreground">@member.Role</p>
                    </div>
                    <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@member.Department</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string _activeTab = "All";
    private static readonly string[] _departments = ["All", "Engineering", "Design", "Product", "Marketing"];

    private record MemberItem(string Name, string Role, string Initials, string Department);
    private static readonly MemberItem[] _members =
    [
        new("Marcus Johnson", "Head of Engineering", "MJ", "Engineering"),
        new("David Kim", "Staff Software Engineer", "DK", "Engineering"),
        new("James O'Brien", "Senior Backend Engineer", "JO", "Engineering"),
        new("Elena Rodriguez", "Senior Product Designer", "ER", "Design"),
        new("Priya Sharma", "UX Researcher", "PS", "Design"),
        new("Carlos Mendez", "Visual Designer", "CM", "Design"),
        new("Tobias Muller", "VP of Product", "TM", "Product"),
        new("Yuki Tanaka", "Product Manager", "YT", "Product"),
        new("Aisha Patel", "VP of Marketing", "AP", "Marketing"),
        new("Olivia Washington", "Content Marketing Lead", "OW", "Marketing"),
        new("Liam Foster", "Growth Marketing Manager", "LF", "Marketing"),
    ];
}
