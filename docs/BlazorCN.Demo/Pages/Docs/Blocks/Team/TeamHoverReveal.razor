@* ============================================================
   Block: team-hover-reveal
   Title: Team Hover Reveal
   Description: Expandable team rows with chevron click-to-reveal bio and additional details for an interactive team section
   Dependencies: LucideChevronRightCn
   Source: original/blocks/team/team-hover-reveal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">The team</p>
            <p class="mt-0.5 text-xs text-muted-foreground">@_members.Length people across @_members.Select(m => m.Location).Distinct().Count() cities</p>
        </div>

        <div>
            @for (var i = 0; i < _members.Length; i++)
            {
                var member = _members[i];
                var isExpanded = _expandedId == member.Id;
                <div class="@Cn.Merge(i < _members.Length - 1 ? "border-b" : "")">
                    <button type="button" @onclick="@(() => _expandedId = isExpanded ? null : member.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@member.Initials</div>
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium">@member.Name</p>
                            <p class="text-xs text-muted-foreground">@member.Role</p>
                        </div>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3">
                            <div class="ml-11 rounded-md bg-muted/50 p-3">
                                <p class="text-sm leading-relaxed text-muted-foreground">@member.Bio</p>
                                <div class="mt-2 flex items-center gap-3 text-xs text-muted-foreground">
                                    <span>@member.Location</span>
                                    <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                                    <span>Previously at @member.PreviousCompany</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expandedId;

    private record MemberItem(string Id, string Name, string Role, string Bio, string Initials, string Location, string PreviousCompany);
    private static readonly MemberItem[] _members =
    [
        new("sc", "Sarah Chen", "Chief Executive Officer", "Former VP at Stripe. 15 years scaling fintech startups from seed to Series D. Believes great products start with great teams.", "SC", "San Francisco", "Stripe"),
        new("mj", "Marcus Johnson", "Head of Engineering", "Ex-Google Staff Engineer. Architected distributed systems handling millions of requests. Passionate about developer experience.", "MJ", "New York", "Google"),
        new("er", "Elena Rodriguez", "Senior Product Designer", "Award-winning designer from Figma. Leads the design system initiative and champions accessible, human-centered design.", "ER", "London", "Figma"),
        new("dk", "David Kim", "Staff Software Engineer", "Open source advocate and Rust enthusiast. Built developer tools at Vercel and contributes to the React ecosystem.", "DK", "Seattle", "Vercel"),
        new("ap", "Aisha Patel", "VP of Marketing", "Grew product-led growth motions at HubSpot. Expert in content strategy, demand generation, and community building.", "AP", "Austin", "HubSpot"),
        new("jo", "James O'Brien", "Engineering Manager", "Led platform teams at Shopify and Datadog. Focused on building high-performing teams and sustainable engineering culture.", "JO", "Toronto", "Shopify"),
        new("yt", "Yuki Tanaka", "Product Manager", "Previously at Linear and Notion. Obsessed with reducing friction and building workflows that developers actually enjoy.", "YT", "Tokyo", "Linear"),
        new("ps", "Priya Sharma", "UX Researcher", "PhD in HCI from Stanford. Bridges the gap between user research and product strategy with data-driven insights.", "PS", "Berlin", "Stanford"),
    ];
}
