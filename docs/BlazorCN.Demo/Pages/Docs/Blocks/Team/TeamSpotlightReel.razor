@* ============================================================
   Block: team-spotlight-reel
   Title: Team Spotlight Reel
   Description: Selectable team member spotlight with a member list and expanded profile view
   Dependencies: None
   Source: original/blocks/team/team-spotlight-reel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Meet our team</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">The people shaping our product, culture, and future</p>
        </div>

        <div class="grid md:grid-cols-5">
            <div class="border-b md:col-span-2 md:border-r md:border-b-0">
                @for (var i = 0; i < _members.Length; i++)
                {
                    var idx = i;
                    var m = _members[i];
                    <button type="button" @onclick="@(() => _active = idx)"
                            class="@Cn.Merge("flex w-full items-center gap-3 border-b px-4 py-3 text-left transition-colors last:border-b-0 hover:bg-muted/50", idx == _active ? "bg-muted/50" : "")">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@m.Initials</div>
                        <div class="min-w-0 flex-1">
                            <div class="text-sm font-medium">@m.Name</div>
                            <div class="text-xs text-muted-foreground">@m.Role</div>
                        </div>
                        @if (idx == _active)
                        {
                            <span class="size-1.5 shrink-0 rounded-full bg-foreground"></span>
                        }
                    </button>
                }
            </div>

            @{
                var member = _members[_active];
            }

            <div class="md:col-span-3">
                <div class="border-b px-4 py-3">
                    <div class="flex items-center gap-3">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-sm font-medium">@member.Initials</div>
                        <div>
                            <div class="text-sm font-medium">@member.Name</div>
                            <div class="flex items-center gap-2">
                                <span class="text-xs text-muted-foreground">@member.Role</span>
                                <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@member.Department</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="border-b px-4 py-3">
                    <p class="text-xs text-muted-foreground italic leading-relaxed">&ldquo;@member.Quote&rdquo;</p>
                </div>

                <div class="border-b px-4 py-3">
                    <p class="text-sm text-muted-foreground leading-relaxed">@member.Bio</p>
                </div>

                <div class="flex divide-x px-0 py-3">
                    @foreach (var stat in member.Stats)
                    {
                        <div class="flex-1 px-4 text-center">
                            <div class="text-2xl font-semibold tabular-nums">@stat.Value</div>
                            <div class="mt-0.5 text-xs text-muted-foreground">@stat.Label</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private int _active;

    private record StatItem(string Label, string Value);
    private record MemberItem(string Name, string Role, string Department, string Bio, string Quote, string Initials, StatItem[] Stats);

    private static readonly MemberItem[] _members =
    [
        new("Nadia Kowalczyk", "Chief Executive Officer", "Leadership", "Founded the company after a decade leading product at Stripe, scaling Connect from beta to processing over $200 billion annually. CS degree from Warsaw University of Technology, MBA from Wharton.", "The best products disappear into the workflow. You should feel the outcome, not the tool.", "NK", [new("Years experience", "15"), new("Companies founded", "3"), new("Capital raised", "$120M+")]),
        new("Rafael Amoroso", "Chief Technology Officer", "Engineering", "Eight years at Google leading Cloud Spanner's multi-region replication. Architected the platform from scratch, achieving 99.99% uptime across three continents. Frequent keynote speaker at distributed systems conferences.", "Reliability is not a feature. It is the foundation every other feature stands on.", "RA", [new("Years experience", "18"), new("Engineers led", "200+"), new("Platform uptime", "99.99%")]),
        new("Yuna Park", "VP of Design", "Design", "Led the design of FigJam at Figma from concept to millions of users. Previously redesigned Airbnb's host onboarding, reducing drop-off by 34%. Design philosophy centered on removing friction until the interface disappears.", "Design is not how it looks. Design is the moment someone does not have to think.", "YP", [new("Years experience", "12"), new("Users impacted", "50M+"), new("Design awards", "3")]),
        new("Declan Okafor", "Head of Engineering", "Engineering", "Built edge computing infrastructure at Cloudflare serving 25 million requests per second. Grew the engineering organization from 12 to 45 people while maintaining sub-50ms P99 latency across all endpoints.", "Fast teams ship fast software. Culture is architecture. Invest in both equally.", "DO", [new("Years experience", "10"), new("Team grown to", "45"), new("P99 latency", "<50ms")]),
        new("Priya Mehta", "VP of Product", "Product", "Led product at Notion during hypergrowth, then defined the modern project management experience at Linear. Built Notion's experimentation framework running over 200 A/B tests per quarter.", "Every feature request is someone telling you about a job they are trying to get done.", "PM", [new("Years experience", "11"), new("Products launched", "8"), new("Peak DAUs", "2M+")]),
        new("Theo Bergstrom", "Head of Growth", "Marketing", "Engineered Spotify's creator marketplace growth engine. Led product-led growth at two YC startups from seed to Series A. Designed the viral referral system that drives 40% of new signups organically.", "The best growth channels are the ones your product builds for itself.", "TB", [new("Years experience", "9"), new("ARR growth", "10x"), new("Users acquired", "500K+")]),
    ];
}
