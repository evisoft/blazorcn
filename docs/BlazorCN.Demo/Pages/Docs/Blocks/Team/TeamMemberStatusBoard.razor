@* ============================================================
   Block: team-member-status-board
   Title: TeamMemberStatusBoard
   Description: A team member availability and status board for React and Next.js displaying current status and timezone information built with shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-member-status-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="space-y-4">
        @* Header *@
        <div>
            <h2 class="text-sm font-medium">Team Status</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Real-time availability and activity
            </p>
        </div>

        @* Status Board *@
        <div class="space-y-2">
            @foreach (var member in _team)
            {
                var config = _statusConfig[member.Status];
                <div class="flex items-center justify-between rounded-lg border bg-card px-4 py-2.5 transition-colors hover:bg-muted/50">
                    <div class="flex items-center gap-3 min-w-0 flex-1">
                        <div
                            class="@Cn.Merge("size-2.5 rounded-full shrink-0", config.Color)"
                            aria-label="@config.Label"
                            role="status">
                        </div>
                        <div class="min-w-0">
                            <p class="text-sm font-medium truncate">@member.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @member.CurrentActivity
                            </p>
                        </div>
                    </div>

                    <div class="flex items-center gap-2 shrink-0">
                        <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs whitespace-nowrap">
                            <LucideIconCn Name="clock" Size="10" Class="size-2.5 mr-1" />
                            @member.LocalTime
                        </BadgeCn>
                    </div>
                </div>
            }
        </div>

        @* Legend *@
        <div class="rounded-lg bg-muted/30 p-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Status Legend</p>
            <div class="grid gap-2 grid-cols-2 text-xs">
                @foreach (var entry in _statusConfig)
                {
                    <div class="flex items-center gap-2">
                        <span class="@Cn.Merge("size-1.5 rounded-full", entry.Value.Color)"></span>
                        <span class="text-muted-foreground">@entry.Value.Label</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record TeamMember(string Id, string Name, string Status, string CurrentActivity, string Timezone, string LocalTime);

    private record StatusConfig(string Color, string Label);

    private static readonly TeamMember[] _team =
    [
        new("1", "Sarah Chen",       "online",  "In standup",                  "PT (UTC-7)",  "6:45 AM"),
        new("2", "Marcus Rodriguez", "focused", "Deep work - No interruptions", "ET (UTC-4)",  "9:45 AM"),
        new("3", "Emily Watson",     "online",  "Design review",               "CT (UTC-5)",  "8:45 AM"),
        new("4", "Alex Kim",         "away",    "Lunch break",                 "GMT (UTC+0)", "2:45 PM"),
        new("5", "Jordan Lee",       "offline", "Offline",                     "SGT (UTC+8)", "10:45 PM"),
    ];

    private static readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["online"]  = new("bg-emerald-500",       "Online"),
        ["away"]    = new("bg-amber-500",          "Away"),
        ["focused"] = new("bg-blue-500",           "Focused"),
        ["offline"] = new("bg-muted-foreground",   "Offline"),
    };
}
