@* ============================================================
   Block: team-member-onboarding
   Title: TeamMemberOnboarding
   Description: An onboarding progress tracking block for React and Next.js showing checklist items and milestones for new team members built with shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-member-onboarding.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Onboarding Checklist</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">New team member setup progress</p>
        </div>

        @* Progress *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">Progress</span>
                <span class="text-xs font-medium tabular-nums text-foreground">
                    @(_completedCount)/@(_items.Length)
                </span>
            </div>
            <ProgressCn Value="@((double)_progress)" Class="h-1.5" />
        </div>

        @* Items by category *@
        @foreach (var cat in _categories)
        {
            var catItems = _items.Where(i => i.Category == cat).ToArray();
            <div class="border-b last:border-b-0">
                <div class="bg-muted/20 px-4 py-2">
                    <span class="text-xs font-medium text-muted-foreground">@cat</span>
                </div>
                @for (var idx = 0; idx < catItems.Length; idx++)
                {
                    var item = catItems[idx];
                    var isLast = idx == catItems.Length - 1;
                    var itemId = item.Id;
                    <div class="@Cn.Merge("", !isLast ? "border-b" : "")">
                        <div class="flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                            <CheckboxCn
                                Checked="@item.Completed"
                                CheckedChanged="@((bool v) => ToggleItem(itemId))" />
                            <div class="min-w-0 flex-1">
                                <span class="@Cn.Merge("text-sm", item.Completed ? "line-through text-muted-foreground" : "text-foreground")">
                                    @item.Title
                                </span>
                                <p class="mt-0.5 text-xs text-muted-foreground">@item.DueDate</p>
                            </div>
                            @if (item.Completed)
                            {
                                <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                                    <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private class OnboardingItem
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string Category { get; set; } = "";
        public bool Completed { get; set; }
        public string DueDate { get; set; } = "";
    }

    private OnboardingItem[] _items =
    [
        new() { Id = "1", Title = "Complete background check",    Category = "Admin",  Completed = true,  DueDate = "Day 0" },
        new() { Id = "2", Title = "Sign employment documents",    Category = "Admin",  Completed = true,  DueDate = "Day 0" },
        new() { Id = "3", Title = "IT equipment setup",           Category = "Tech",   Completed = true,  DueDate = "Day 1" },
        new() { Id = "4", Title = "Office access and keys",       Category = "Admin",  Completed = false, DueDate = "Day 1" },
        new() { Id = "5", Title = "Team meet and greet",          Category = "Social", Completed = false, DueDate = "Day 2" },
        new() { Id = "6", Title = "System access and passwords",  Category = "Tech",   Completed = false, DueDate = "Day 1" },
    ];

    private string[] _categories => _items.Select(i => i.Category).Distinct().ToArray();
    private int _completedCount => _items.Count(i => i.Completed);
    private int _progress => (int)Math.Round((_completedCount / (double)_items.Length) * 100);

    private void ToggleItem(string id)
    {
        var item = _items.FirstOrDefault(i => i.Id == id);
        if (item != null)
            item.Completed = !item.Completed;
    }
}
