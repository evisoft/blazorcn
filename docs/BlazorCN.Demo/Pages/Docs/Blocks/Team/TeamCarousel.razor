@* ============================================================
   Block: team-carousel
   Title: Team Carousel
   Description: Paginated team member list with previous and next navigation buttons for browsing React team sections
   Dependencies: ButtonCn, LucideChevronLeftCn, LucideChevronRightCn
   Source: original/blocks/team/team-carousel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Team</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Engineers, designers, and operators building the future of developer tools.</p>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7" @onclick="@(() => _page = Math.Max(0, _page - 1))" disabled="@(_page == 0)">
                    <LucideChevronLeftCn Size="16" Class="size-4" />
                </ButtonCn>
                <span class="min-w-[3ch] text-center text-xs text-muted-foreground tabular-nums">@(_page + 1)/@_totalPages</span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7" @onclick="@(() => _page = Math.Min(_totalPages - 1, _page + 1))" disabled="@(_page == _totalPages - 1)">
                    <LucideChevronRightCn Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>
        @{ var visible = _members.Skip(_page * PageSize).Take(PageSize).ToArray(); }
        @for (var i = 0; i < visible.Length; i++)
        {
            var member = visible[i];
            <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3", i < visible.Length - 1 ? "border-b" : "")">
                <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@member.Initials</div>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-medium">@member.Name</span>
                        <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@member.Department</span>
                    </div>
                    <p class="mt-0.5 text-xs text-muted-foreground">@member.Role</p>
                    <p class="mt-1 text-xs text-muted-foreground leading-relaxed">@member.Bio</p>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private const int PageSize = 3;
    private int _page;
    private int _totalPages => (int)Math.Ceiling((double)_members.Length / PageSize);

    private record MemberItem(string Name, string Role, string Bio, string Initials, string Department);
    private static readonly MemberItem[] _members =
    [
        new("Mia Thornton", "Chief Executive Officer", "Founded the company after a decade at Stripe building payment infrastructure. Passionate about developer tools and scaling engineering culture.", "MT", "Leadership"),
        new("Raj Kapoor", "VP of Engineering", "Former tech lead at Google Brain. Architected our real-time data pipeline and mentors the entire engineering organization.", "RK", "Engineering"),
        new("Nina Alexandrov", "Principal Designer", "Built the design system at Figma before joining as our first designer. Obsessed with component architecture and accessible interfaces.", "NA", "Design"),
        new("James O'Brien", "Head of Growth", "Grew Notion's PLG motion from Series A to IPO. Brings deep expertise in product-led acquisition funnels and community building.", "JO", "Marketing"),
        new("Lena Kowalski", "Staff Engineer", "Core contributor to React Server Components at Meta. Leads our frontend platform team and runtime performance optimization efforts.", "LK", "Engineering"),
        new("Hassan Al-Rashid", "Director of Product", "Shipped enterprise features at Datadog that drove 40% ARR growth. Focuses on translating customer pain points into roadmap priorities.", "HA", "Product"),
        new("Sophie Dubois", "Senior Security Engineer", "Led SOC 2 and ISO 27001 certifications at two previous startups. Ensures our infrastructure meets the highest compliance standards.", "SD", "Engineering"),
        new("Andre Williams", "Developer Advocate", "Conference speaker and open-source maintainer with 50k+ GitHub followers. Bridges the gap between our product and the developer community.", "AW", "DevRel"),
    ];
}
