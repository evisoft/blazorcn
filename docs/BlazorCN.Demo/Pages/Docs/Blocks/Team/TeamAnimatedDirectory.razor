@* ============================================================
   Block: team-animated-directory
   Title: Team Animated Directory
   Description: Sortable team directory with smooth layout animations that reorder members by name, department, or role using framer-motion
   Long Description: Searchable and filterable team directory
   Dependencies: ButtonCn, LucideArrowUpDownCn
   Source: original/blocks/team/team-animated-directory.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideArrowUpDownCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Team directory</span>
                <span class="ml-auto text-xs text-muted-foreground">@_members.Length members</span>
            </div>
        </div>

        <div class="flex items-center gap-1.5 border-b px-4 py-2">
            <span class="mr-1 text-xs text-muted-foreground">Sort by</span>
            @foreach (var btn in _sortButtons)
            {
                var key = btn.Key;
                <ButtonCn Variant="@(_sortKey == key ? ButtonVariant.Outline : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm" Class="h-6 px-2 text-xs"
                          @onclick="@(() => _sortKey = key)">
                    @btn.Label
                </ButtonCn>
            }
        </div>

        <div>
            @{ var sorted = GetSorted(); }
            @for (var i = 0; i < sorted.Length; i++)
            {
                var member = sorted[i];
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", i < sorted.Length - 1 ? "border-b" : "")">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @member.Initials
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="truncate text-sm font-medium">@member.Name</span>
                            <span class="shrink-0 rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                @member.Department
                            </span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="truncate text-xs text-muted-foreground">@member.Role</span>
                            <span class="text-xs text-muted-foreground/60">@member.Location</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string _sortKey = "name";

    private MemberItem[] GetSorted() => _sortKey switch
    {
        "department" => _members.OrderBy(m => m.Department).ToArray(),
        "role" => _members.OrderBy(m => m.Role).ToArray(),
        _ => _members.OrderBy(m => m.Name).ToArray(),
    };

    private record SortButton(string Key, string Label);

    private static readonly SortButton[] _sortButtons =
    [
        new("name", "Name"),
        new("department", "Department"),
        new("role", "Role"),
    ];

    private record MemberItem(string Id, string Name, string Role, string Department, string Location, string Initials);

    private static readonly MemberItem[] _members =
    [
        new("m1", "Zara Ahmed", "Staff Software Engineer", "Engineering", "San Francisco, CA", "ZA"),
        new("m2", "Kenji Watanabe", "Senior Frontend Engineer", "Engineering", "Tokyo, Japan", "KW"),
        new("m3", "Camila Reyes", "Engineering Manager", "Engineering", "Buenos Aires, Argentina", "CR"),
        new("m4", "Tobias Muller", "Head of Design", "Design", "Berlin, Germany", "TM"),
        new("m5", "Yolanda Osei", "Senior Product Designer", "Design", "London, UK", "YO"),
        new("m6", "Marcus Bell", "VP of Marketing", "Marketing", "New York, NY", "MB"),
        new("m7", "Aaliya Rahman", "Content Marketing Lead", "Marketing", "Toronto, Canada", "AR"),
        new("m8", "Priya Sharma", "Head of Sales", "Sales", "Singapore", "PS"),
        new("m9", "Lucas Fernandez", "Enterprise Account Executive", "Sales", "Chicago, IL", "LF"),
        new("m10", "Devi Chandrasekaran", "UX Researcher", "Design", "Bangalore, India", "DC"),
    ];
}
