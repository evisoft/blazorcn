@* ============================================================
   Block: team-timezone-map
   Title: TeamTimezoneMap
   Description: React team timezone map showing members by UTC offset with local time, overlap window, and availability using shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-timezone-map.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Time zones</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_totalMembers members across @_timezones.Length zones · @_workingNow in working hours
            </p>
        </div>

        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <span class="text-xs font-medium text-muted-foreground">Overlap window</span>
            <div class="flex flex-1 items-center gap-0.5">
                @for (var i = 0; i < 24; i++)
                {
                    var hour = i;
                    var isOverlap = hour >= 17 && hour <= 20;
                    <div class="@Cn.Merge("h-2 flex-1 rounded-sm", isOverlap ? "bg-emerald-500/30" : "bg-muted")"></div>
                }
            </div>
            <span class="shrink-0 text-xs text-muted-foreground">4h overlap</span>
        </div>

        <div>
            @for (var idx = 0; idx < _timezones.Length; idx++)
            {
                var tz = _timezones[idx];
                var isExpanded = _expanded == tz.Label;
                var isLast = idx == _timezones.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => { var lbl = tz.Label; _expanded = _expanded == lbl ? null : lbl; })"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", tz.IsWorkingHours ? "bg-emerald-500" : "bg-muted-foreground/30")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@tz.Label</span>
                                <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                    @tz.Offset
                                </span>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                @tz.LocalTime · @tz.Members.Length @(tz.Members.Length == 1 ? "member" : "members")
                            </p>
                        </div>
                        <LucideChevronRightCn
                            Size="16"
                            Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/20">
                            @for (var mi = 0; mi < tz.Members.Length; mi++)
                            {
                                var member = tz.Members[mi];
                                var notLast = mi < tz.Members.Length - 1;
                                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 pl-9", notLast ? "border-b" : "")">
                                    <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                                        @member.Initials
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <span class="text-sm font-medium">@member.Name</span>
                                        <p class="text-xs text-muted-foreground">@member.Role</p>
                                    </div>
                                    <span class="shrink-0 text-xs text-muted-foreground">
                                        @member.City
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "Eastern";

    private record TeamMemberItem(string Name, string Role, string Initials, string City);

    private record TimezoneGroupItem(string Label, string Offset, string LocalTime, bool IsWorkingHours, TeamMemberItem[] Members);

    private static readonly TimezoneGroupItem[] _timezones =
    [
        new("Pacific", "UTC-8", "9:30 AM", true,
        [
            new("Sarah Chen", "Engineering Lead", "SC", "San Francisco"),
            new("David Kim", "Frontend Engineer", "DK", "Portland"),
        ]),
        new("Eastern", "UTC-5", "12:30 PM", true,
        [
            new("Marcus Johnson", "Backend Engineer", "MJ", "New York"),
            new("Aisha Patel", "Product Manager", "AP", "Toronto"),
            new("James O'Brien", "DevOps Engineer", "JO", "Boston"),
        ]),
        new("Central Europe", "UTC+1", "6:30 PM", false,
        [
            new("Elena Rodriguez", "Product Designer", "ER", "Barcelona"),
            new("Henrik Dahl", "Staff Engineer", "HD", "Stockholm"),
        ]),
        new("India", "UTC+5:30", "11:00 PM", false,
        [
            new("Priya Sharma", "Data Analyst", "PS", "Bangalore"),
        ]),
        new("East Asia", "UTC+9", "2:30 AM", false,
        [
            new("Yuki Tanaka", "QA Engineer", "YT", "Tokyo"),
        ]),
    ];

    private static readonly int _totalMembers = _timezones.Sum(tz => tz.Members.Length);
    private static readonly int _workingNow = _timezones.Where(tz => tz.IsWorkingHours).Sum(tz => tz.Members.Length);
}
