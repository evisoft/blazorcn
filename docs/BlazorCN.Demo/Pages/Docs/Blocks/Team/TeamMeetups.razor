@* ============================================================
   Block: team-meetups
   Title: Team Meetups
   Description: Team meetup organizers and community involvement directory with event frequency, member counts, next event dates, and topics
   Dependencies: none (pure HTML/Tailwind)
   Source: original/blocks/team/team-meetups.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideUsersCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">Communities</span>
            <span class="ml-auto text-xs text-muted-foreground">@_communities.Length groups</span>
        </div>

        @foreach (var community in _communities)
        {
            var isExpanded = _expanded == community.Name;
            <div class="border-b last:border-b-0">
                <button type="button"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => _expanded = isExpanded ? null : community.Name)">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @community.Initials
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="truncate text-sm font-medium">@community.Name</span>
                            <span class="shrink-0 rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                @community.Frequency
                            </span>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            Organized by @community.Organizer
                        </p>
                    </div>
                    <LucideChevronRightCn Size="16"
                                          Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                </button>
                @if (isExpanded)
                {
                    <div class="border-t bg-muted/30 px-4 py-3">
                        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                            <div>
                                <p class="text-xs text-muted-foreground">Members</p>
                                <p class="font-mono text-sm font-medium tabular-nums">
                                    @community.MemberCount.ToString("N0")
                                </p>
                            </div>
                            <div>
                                <p class="text-xs text-muted-foreground">Next event</p>
                                <p class="text-sm font-medium">@community.NextEvent</p>
                            </div>
                        </div>
                        <div class="mt-2.5 rounded-md bg-muted/50 p-2.5">
                            <p class="text-xs text-muted-foreground">Upcoming topic</p>
                            <p class="mt-0.5 text-sm text-foreground">@community.Topic</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record Community(string Name, string Organizer, string Initials, string Frequency, int MemberCount, string NextEvent, string Topic);

    private string? _expanded;

    private static readonly Community[] _communities =
    [
        new("React SF Meetup", "Sarah Chen", "SC", "Monthly", 1240, "Apr 3, 2026", "React Server Components in production"),
        new("TypeScript London", "Aisha Patel", "AP", "Monthly", 890, "Mar 27, 2026", "Type-safe API layers with tRPC v12"),
        new("Data Engineering Seoul", "David Kim", "DK", "Bi-weekly", 560, "Mar 22, 2026", "Real-time pipelines with Apache Flink"),
        new("Design Systems Barcelona", "Elena Rodriguez", "ER", "Monthly", 430, "Apr 10, 2026", "Tokens and theming at scale"),
        new("AI/ML Paper Reading Group", "Ravi Mehta", "RM", "Weekly", 210, "Mar 19, 2026", "Mixture of Experts efficiency gains"),
        new("Women in Engineering Austin", "Priya Sharma", "PS", "Monthly", 720, "Apr 15, 2026", "Career growth panel with staff engineers"),
        new("DevOps Stockholm", "Lena Johansson", "LJ", "Monthly", 380, "Apr 8, 2026", "Platform engineering and internal developer portals"),
    ];
}
