@* ============================================================
   Block: team-animated-bento
   Title: Team Animated Bento
   Description: Animated bento grid layout with a featured 2x2 member cell scaling in from center and smaller cells staggering around it with hover lift effects using framer-motion
   Long Description: A dynamic bento grid that reveals your team with purposeful choreography. The featured member scales in from the center while surrounding cells stagger into place around it, creating a polished cascade effect. Each cell lifts subtly on hover for interactive feedback. The gap-px bg-border pattern produces clean hairline dividers between connected cells. Built with React, TypeScript, Tailwind CSS, and framer-motion for team pages that feel as considered as the product you ship.
   Dependencies: None
   Source: original/blocks/team/team-animated-bento.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-border">
        <div class="grid gap-px md:grid-cols-3 md:grid-rows-2">
            @for (var i = 0; i < _members.Length; i++)
            {
                var member = _members[i];
                var isFeatured = i == 0;
                <div class="@Cn.Merge("bg-card px-4 py-4", isFeatured ? "md:col-span-2 md:row-span-2 md:py-6" : "")">
                    <div class="flex items-center gap-3">
                        <div class="@Cn.Merge("flex shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium", isFeatured ? "size-10" : "size-8")">
                            @member.Initials
                        </div>
                        <div class="min-w-0">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@member.Name</span>
                                <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                    @member.Department
                                </span>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">@member.Role</p>
                        </div>
                    </div>
                    <p class="@Cn.Merge("mt-3 text-xs text-muted-foreground leading-relaxed", isFeatured ? "md:text-sm" : "")">
                        @member.Bio
                    </p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record MemberItem(string Name, string Role, string Initials, string Department, string Bio);

    private static readonly MemberItem[] _members =
    [
        new("Elena Vasquez", "Co-Founder & CEO", "EV", "Leadership",
            "Former infrastructure lead at Vercel who helped scale the platform from 100k to 10M deployments per day. Elena founded the company with a vision to make developer tooling as intuitive as consumer products. She oversees product strategy, fundraising, and company culture."),
        new("Tobias Richter", "CTO", "TR", "Engineering",
            "Built distributed systems at Cloudflare for six years. Architects our entire backend infrastructure and leads the platform engineering team."),
        new("Priya Sharma", "Head of Design", "PS", "Design",
            "Previously at Figma where she led the Variables feature. Owns our design system, brand identity, and end-to-end user experience."),
        new("Marcus Chen", "VP of Sales", "MC", "Sales",
            "Closed the first 50 enterprise deals at Datadog. Runs our go-to-market engine spanning sales, partnerships, and customer success."),
        new("Amara Osei", "Staff Engineer", "AO", "Engineering",
            "Core contributor to the Rust compiler. Leads our performance-critical systems including the real-time sync engine and edge runtime."),
        new("Felix Andersen", "Director of Marketing", "FA", "Marketing",
            "Grew Linear's community from zero to 200k developers. Drives brand strategy, content marketing, and developer community programs."),
    ];
}
