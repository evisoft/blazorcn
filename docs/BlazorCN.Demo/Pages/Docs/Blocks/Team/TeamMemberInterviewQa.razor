@* ============================================================
   Block: team-member-interview-qa
   Title: TeamMemberInterviewQa
   Description: An interview-style Q&A block for React and Next.js showcasing team member insights and experiences built with shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-member-interview-qa.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="space-y-4">
        @* Header *@
        <div>
            <h2 class="text-sm font-medium">Team Interviews</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Get to know the team behind the work
            </p>
        </div>

        @* Interviews *@
        <div class="space-y-3">
            @foreach (var interview in _interviews)
            {
                var interviewId = interview.Id;
                <div class="overflow-hidden rounded-lg border bg-card">
                    <button type="button"
                            @onclick="@(() => _expanded = (_expanded == interviewId ? null : interviewId))"
                            class="w-full px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex items-center justify-between gap-3">
                            <div class="min-w-0 flex-1">
                                <h3 class="text-sm font-medium">@interview.Name</h3>
                                <p class="mt-0.5 text-xs text-muted-foreground">@interview.Role</p>
                            </div>
                            <LucideIconCn Name="chevron-right" Size="16"
                                          Class="@Cn.Merge("size-4 shrink-0 transition-transform duration-200", _expanded == interviewId ? "rotate-90" : "")" />
                        </div>
                    </button>

                    @if (_expanded == interviewId)
                    {
                        <div class="border-t px-4 py-3 space-y-3">
                            @foreach (var qa in interview.Interview)
                            {
                                <div class="space-y-1.5">
                                    <div class="flex items-start gap-2">
                                        <LucideIconCn Name="message-circle" Size="12" Class="size-3 mt-1 shrink-0 text-muted-foreground" />
                                        <p class="text-sm font-medium">@qa.Q</p>
                                    </div>
                                    <p class="ml-5 text-sm text-muted-foreground italic">@("\"")@qa.A@("\"")</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "1";

    private record QAItem(string Q, string A);
    private record InterviewItem(string Id, string Name, string Role, QAItem[] Interview);

    private static readonly InterviewItem[] _interviews =
    [
        new("1", "Sarah Chen", "Product Lead",
        [
            new("What was your first job?",
                "I started as a UX researcher at a small startup. It taught me the importance of talking to users before building."),
            new("What's your favorite thing about working here?",
                "The collaborative spirit. People actually listen to each other's ideas."),
            new("What skill do you want to develop?",
                "Public speaking. I want to be more comfortable presenting at conferences."),
        ]),
        new("2", "Marcus Rodriguez", "Engineering Lead",
        [
            new("What got you into coding?",
                "A friend showed me how to build games with Python in high school. I was hooked."),
            new("What's your coding superpower?",
                "I love seeing the big architecture picture and optimizing systems."),
            new("What's your ideal work environment?",
                "Quiet mornings for deep work, collaborative afternoons for pairing."),
        ]),
    ];
}
