@* ============================================================
   Block: team-member-reading-picks
   Title: TeamMemberReadingPicks
   Description: A team member book and article recommendations block for React and Next.js showcasing reading lists and learning resources built with shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-member-reading-picks.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="space-y-6">
        <div>
            <h2 class="text-sm font-medium">Reading Recommendations</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Books and articles recommended by the team
            </p>
        </div>

        @foreach (var grp in _grouped)
        {
            var catKey = grp.Key;
            var recs = grp.Value;
            <div class="space-y-2">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="book-open" Size="16" Class="size-4 text-muted-foreground" />
                    <h3 class="text-sm font-medium">@_categoryLabels[catKey]</h3>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@recs.Length</BadgeCn>
                </div>

                <div class="space-y-2">
                    @foreach (var rec in recs)
                    {
                        var recId = rec.Id;
                        var isExpanded = _expanded == recId;
                        <div class="overflow-hidden rounded-lg border bg-card">
                            <button
                                type="button"
                                @onclick="@(() => _expanded = (isExpanded ? null : recId))"
                                class="w-full px-4 py-3 text-left transition-colors hover:bg-muted/50">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="min-w-0 flex-1">
                                        <h4 class="text-sm font-medium">@rec.Title</h4>
                                        <p class="mt-0.5 text-xs text-muted-foreground">
                                            @rec.Author • <span class="italic">by @rec.Recommender</span>
                                        </p>
                                    </div>
                                    <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                                </div>
                            </button>

                            @if (isExpanded)
                            {
                                <div class="border-t px-4 py-3">
                                    <p class="text-sm leading-relaxed text-muted-foreground mb-3">
                                        @rec.RecommendationText
                                    </p>
                                    @if (!string.IsNullOrEmpty(rec.Link))
                                    {
                                        <a href="@rec.Link" target="_blank" rel="noopener noreferrer"
                                           class="inline-flex items-center gap-1.5 rounded-md border border-input bg-background px-3 py-1.5 text-xs font-medium shadow-sm transition-colors hover:bg-accent hover:text-accent-foreground">
                                            <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                                            Learn More
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private string? _expanded = "1";

    private record Recommendation(string Id, string Title, string Author, string Category, string RecommendationText, string? Link, string Recommender);

    private static readonly Recommendation[] _recommendations =
    [
        new("1", "Atomic Habits", "James Clear", "personal-growth",
            "Game-changing insights on building systems instead of goals. Practical examples you can apply immediately.",
            "https://atomichabits.com", "Sarah Chen"),
        new("2", "The Pragmatic Programmer", "David Thomas & Andrew Hunt", "tech",
            "Essential reading for any developer. Updated edition covers modern tools and practices.",
            "https://pragprog.com", "Marcus Rodriguez"),
        new("3", "Don't Make Me Think", "Steve Krug", "design",
            "Perfect for understanding UX principles. Clear, concise, and immediately applicable.",
            "https://sensible.com", "Emily Watson"),
        new("4", "Zero to One", "Peter Thiel", "business",
            "Thought-provoking perspective on startups and innovation. Challenge your assumptions.",
            "https://zerotoonespeaker.com", "Alex Kim"),
    ];

    private static readonly Dictionary<string, string> _categoryLabels = new()
    {
        ["tech"] = "Technology",
        ["business"] = "Business",
        ["personal-growth"] = "Personal Growth",
        ["design"] = "Design",
    };

    private static readonly Dictionary<string, Recommendation[]> _grouped = _recommendations
        .GroupBy(r => r.Category)
        .ToDictionary(g => g.Key, g => g.ToArray());
}
