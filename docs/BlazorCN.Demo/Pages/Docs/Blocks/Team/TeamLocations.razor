@* ============================================================
   Block: team-locations
   Title: Team Locations
   Description: Team members grouped by office location with text-based section headers
   Dependencies: LucideMapPinCn
   Source: original/blocks/team/team-locations.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-sm font-medium">Team by location</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">@_locations.Sum(l => l.Members.Length) people across @_locations.Length offices</p>
                </div>
                <LucideMapPinCn Size="16" Class="size-4 text-muted-foreground" />
            </div>
        </div>

        <div>
            @for (var locIndex = 0; locIndex < _locations.Length; locIndex++)
            {
                var location = _locations[locIndex];
                <div>
                    <div class="@Cn.Merge("flex items-center justify-between bg-muted/50 px-4 py-2", locIndex > 0 ? "border-t" : "")">
                        <span class="text-xs font-medium">@location.Name</span>
                        <span class="text-xs text-muted-foreground">@location.Timezone</span>
                    </div>

                    @for (var memberIndex = 0; memberIndex < location.Members.Length; memberIndex++)
                    {
                        var member = location.Members[memberIndex];
                        var showBorder = memberIndex < location.Members.Length - 1 || locIndex < _locations.Length - 1;
                        <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", showBorder ? "border-b" : "")">
                            <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@member.Initials</div>
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium">@member.Name</span>
                                <p class="text-xs text-muted-foreground">@member.Role</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record LocationMember(string Name, string Role, string Initials);
    private record OfficeLocation(string Name, string Timezone, LocationMember[] Members);

    private static readonly OfficeLocation[] _locations =
    [
        new("Stockholm, Sweden", "CET (UTC+1)",
        [
            new("Katarina Lindqvist", "Engineering Manager", "KL"),
            new("Erik Johansson", "Senior Backend Engineer", "EJ"),
        ]),
        new("San Francisco, CA", "PST (UTC-8)",
        [
            new("David Kowalski", "Head of Product", "DK"),
            new("Elise Moreau", "Frontend Engineer", "EM"),
            new("Riku Nakamura", "DevOps Lead", "RN"),
        ]),
        new("Lagos, Nigeria", "WAT (UTC+1)",
        [
            new("Nadia Okonkwo", "Product Designer", "NO"),
        ]),
        new("Buenos Aires, Argentina", "ART (UTC-3)",
        [
            new("Tomas Herrera", "Senior Backend Engineer", "TH"),
        ]),
    ];
}
