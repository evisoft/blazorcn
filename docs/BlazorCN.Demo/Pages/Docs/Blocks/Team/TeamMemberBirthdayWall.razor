@* ============================================================
   Block: team-member-birthday-wall
   Title: TeamMemberBirthdayWall
   Description: A birthday and anniversary celebration wall for React and Next.js displaying upcoming celebrations and milestones built with shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-member-birthday-wall.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="space-y-6">

        @* Header *@
        <div>
            <h2 class="text-sm font-medium">Team Celebrations</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Upcoming birthdays and work anniversaries
            </p>
        </div>

        @* Birthdays Section *@
        <div class="space-y-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="cake" Size="16" Class="size-4 text-muted-foreground" />
                <h3 class="text-sm font-medium">Birthdays (@_birthdays.Length)</h3>
            </div>
            <div class="space-y-2">
                @foreach (var celebration in _birthdays)
                {
                    <div class="flex items-center justify-between rounded-lg border bg-card px-4 py-2.5 transition-colors hover:bg-muted/50">
                        <div>
                            <p class="text-sm font-medium">@celebration.Name</p>
                            <p class="text-xs text-muted-foreground">@celebration.Date</p>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                            🎂
                        </BadgeCn>
                    </div>
                }
            </div>
        </div>

        @* Anniversaries Section *@
        <div class="space-y-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="gift" Size="16" Class="size-4 text-muted-foreground" />
                <h3 class="text-sm font-medium">Work Anniversaries (@_anniversaries.Length)</h3>
            </div>
            <div class="space-y-2">
                @foreach (var celebration in _anniversaries)
                {
                    <div class="flex items-center justify-between rounded-lg border bg-card px-4 py-2.5 transition-colors hover:bg-muted/50">
                        <div>
                            <p class="text-sm font-medium">@celebration.Name</p>
                            <p class="text-xs text-muted-foreground">
                                @celebration.Date • @celebration.YearsAtCompany year@(celebration.YearsAtCompany != 1 ? "s" : "")
                            </p>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                            ⭐ @(celebration.YearsAtCompany)y
                        </BadgeCn>
                    </div>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private record Celebration(string Id, string Name, string Type, string Date, int? YearsAtCompany = null);

    private static readonly Celebration[] _celebrations =
    [
        new("1", "Sarah Chen", "birthday", "April 8"),
        new("2", "Marcus Rodriguez", "anniversary", "April 12", 3),
        new("3", "Emily Watson", "birthday", "April 15"),
        new("4", "Alex Kim", "anniversary", "April 22", 1),
        new("5", "Jordan Lee", "birthday", "April 28"),
    ];

    private Celebration[] _birthdays = _celebrations.Where(c => c.Type == "birthday").ToArray();
    private Celebration[] _anniversaries = _celebrations.Where(c => c.Type == "anniversary").ToArray();
}
