@* ============================================================
   Block: team-animated-spotlight
   Title: Team Animated Spotlight
   Description: Two-panel team layout with framer-motion layoutId sliding indicator and AnimatePresence crossfade profile display for a React team spotlight section
   Long Description: Staggered grid entrance with hover lift effects
   Dependencies: None
   Source: original/blocks/team/team-animated-spotlight.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Team</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Select a member to view their full profile
            </p>
        </div>

        <div class="flex flex-col md:flex-row">
            <div class="w-full border-b md:w-64 md:shrink-0 md:border-b-0 md:border-r">
                @for (var i = 0; i < _members.Length; i++)
                {
                    var member = _members[i];
                    var isActive = _selected == member.Name;
                    <button
                        type="button"
                        @onclick="@(() => _selected = member.Name)"
                        class="@Cn.Merge("relative flex w-full items-center gap-2.5 px-4 py-3 text-left transition-colors", i < _members.Length - 1 ? "border-b" : "", isActive ? "bg-muted/50" : "hover:bg-muted/30")">
                        @if (isActive)
                        {
                            <span class="absolute inset-y-0 left-0 w-0.5 bg-foreground"></span>
                        }
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                            @member.Initials
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="truncate text-sm font-medium">@member.Name</p>
                            <p class="truncate text-xs text-muted-foreground">@member.Role</p>
                        </div>
                    </button>
                }
            </div>

            <div class="min-h-[320px] flex-1">
                @{ var active = _members.FirstOrDefault(m => m.Name == _selected) ?? _members[0]; }
                <div class="p-4">
                    <div class="flex items-center gap-3">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-sm font-medium">
                            @active.Initials
                        </div>
                        <div>
                            <p class="text-sm font-medium">@active.Name</p>
                            <p class="text-xs text-muted-foreground">@active.Role</p>
                        </div>
                        <span class="ml-auto rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                            @active.Department
                        </span>
                    </div>

                    <p class="mt-4 text-sm text-muted-foreground leading-relaxed">
                        @active.Bio
                    </p>

                    <div class="mt-4 flex items-center gap-4">
                        @for (var i = 0; i < active.Stats.Length; i++)
                        {
                            var stat = active.Stats[i];
                            <span class="flex items-center gap-1.5">
                                @if (i > 0)
                                {
                                    <span class="text-muted-foreground/30">&middot;</span>
                                }
                                <span class="text-xs text-muted-foreground">@stat.Label</span>
                                <span class="text-xs font-medium">@stat.Value</span>
                            </span>
                        }
                    </div>

                    <div class="mt-4 flex gap-2">
                        <a href="#" class="text-xs text-muted-foreground underline-offset-2 hover:text-foreground hover:underline">LinkedIn</a>
                        <span class="text-xs text-muted-foreground/40">&middot;</span>
                        <a href="#" class="text-xs text-muted-foreground underline-offset-2 hover:text-foreground hover:underline">Twitter</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string _selected = "Sarah Chen";

    private record StatItem(string Label, string Value);
    private record MemberItem(string Name, string Role, string Initials, string Department, string Bio, StatItem[] Stats);

    private static readonly MemberItem[] _members =
    [
        new("Sarah Chen", "Chief Executive Officer", "SC", "Leadership",
            "Founded the company in 2019 after spending a decade in fintech leadership. As VP of Product at Stripe, she led the launch of Stripe Connect and grew the platform from 50,000 to over 500,000 connected accounts. Holds a CS degree from MIT and an MBA from Stanford GSB. Passionate about building tools that make developers more productive.",
            [new("Tenure", "6 years"), new("Reports", "12"), new("Location", "San Francisco")]),
        new("Marcus Johnson", "Chief Technology Officer", "MJ", "Engineering",
            "18 years of engineering leadership across Google, Datadog, and early-stage startups. Led the distributed systems team responsible for Cloud Spanner's multi-region replication at Google. Scaled engineering from 40 to 200 engineers at Datadog. Architect of the company's core platform serving 15 million API requests daily.",
            [new("Tenure", "4 years"), new("Reports", "8"), new("Location", "New York")]),
        new("Elena Rodriguez", "VP of Engineering", "ER", "Engineering",
            "Led mobile engineering at Shopify where her team built the Shop app used by over 100 million consumers. Before Shopify, spent five years at Netflix building the real-time personalization engine. Expert in engineering management, mobile platform architecture, and cultivating high-performance team culture.",
            [new("Tenure", "3 years"), new("Reports", "24"), new("Location", "Toronto")]),
        new("David Kim", "VP of Design", "DK", "Design",
            "Seven years at Figma where he was the design lead for FigJam. His design philosophy centers on reducing cognitive load and creating interfaces that feel invisible. Led the creation of the company's design system with over 200 components used across all products. Former lecturer at Rhode Island School of Design.",
            [new("Tenure", "2 years"), new("Reports", "6"), new("Location", "Seattle")]),
        new("Priya Sharma", "Head of Data", "PS", "Engineering",
            "Built ML recommendation engines at Mercari driving 30% of all transactions. Former research scientist at RIKEN studying large-scale graph neural networks. PhD from University of Tokyo. Leads the data platform team responsible for the analytics infrastructure processing 50TB of events daily.",
            [new("Tenure", "3 years"), new("Reports", "10"), new("Location", "London")]),
        new("Tobias Muller", "VP of Product", "TM", "Product",
            "Launched three 0-to-1 products at Atlassian including Compass, the developer experience platform. Stanford HCI background with deep expertise in platform product strategy and developer ecosystem design. Previously led product at a Series B developer tools company through acquisition.",
            [new("Tenure", "2 years"), new("Reports", "5"), new("Location", "Berlin")]),
    ];
}
