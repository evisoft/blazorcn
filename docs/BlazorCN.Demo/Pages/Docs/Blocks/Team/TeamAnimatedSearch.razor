@* ============================================================
   Block: team-animated-search
   Title: Team Animated Search
   Description: Searchable team directory with Framer Motion layout animations, smooth filtering, and AnimatePresence exit transitions for React team pages
   Long Description: Dense list with department chips and tight spacing
   Dependencies: LucideSearchCn
   Source: original/blocks/team/team-animated-search.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideSearchCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
            <InputCn
                Type="text"
                @bind-Value="_query"
                Placeholder="Search by name, role, or department..."
                aria-label="Search by name, role, or department" />
            <span class="shrink-0 text-xs tabular-nums text-muted-foreground">
                @_filtered.Length/@_members.Length
            </span>
        </div>

        <div class="divide-y">
            @foreach (var member in _filtered)
            {
                <div class="flex items-center gap-3 px-4 py-3">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @member.Initials
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@member.Name</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">@member.Role</p>
                    </div>
                    <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                        @member.Department
                    </span>
                </div>
            }
            @if (_filtered.Length == 0)
            {
                <div class="px-4 py-8 text-center">
                    <p class="text-sm text-muted-foreground">
                        No team members match &ldquo;@_query&rdquo;
                    </p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string _query = "";

    private MemberItem[] _filtered => string.IsNullOrWhiteSpace(_query)
        ? _members
        : _members.Where(m =>
            m.Name.Contains(_query, StringComparison.OrdinalIgnoreCase) ||
            m.Role.Contains(_query, StringComparison.OrdinalIgnoreCase) ||
            m.Department.Contains(_query, StringComparison.OrdinalIgnoreCase)).ToArray();

    private record MemberItem(string Id, string Name, string Role, string Department, string Initials);

    private static readonly MemberItem[] _members =
    [
        new("m1", "Elena Voskresenskaya", "VP of Engineering", "Engineering", "EV"),
        new("m2", "Marcus Chen", "Head of Design", "Design", "MC"),
        new("m3", "Priya Nair", "Staff Product Manager", "Product", "PN"),
