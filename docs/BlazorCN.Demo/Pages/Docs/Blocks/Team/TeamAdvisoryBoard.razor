@* ============================================================
   Block: team-advisory-board
   Title: Team Advisory Board
   Description: Flat bordered rows for advisors with initials, title, company affiliation, and background summary
   Long Description: Present your advisory board with the gravitas they deserve
   Dependencies: None
   Source: original/blocks/team/team-advisory-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Advisory Board</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Guided by industry leaders</p>
        </div>
        @foreach (var advisor in _advisors)
        {
            <div class="border-b px-4 py-3 last:border-b-0">
                <div class="flex items-start gap-3">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @advisor.Initials
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-baseline gap-2">
                            <span class="text-sm font-medium">@advisor.Name</span>
                            <span class="text-xs text-muted-foreground">@advisor.Title</span>
                        </div>
                        <div class="mt-1">
                            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                @advisor.Company
                            </span>
                        </div>
                        <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
                            @advisor.Specialty
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Advisor(string Name, string Title, string Company, string Initials, string Specialty);

    private static readonly Advisor[] _advisors =
    [
        new("Dr. Margaret Liu", "Partner", "Sequoia Capital", "ML", "Enterprise SaaS investing with focus on developer tools. Board observer at 12 portfolio companies including three unicorns."),
        new("Rajiv Chandrasekaran", "Former CTO", "Uber", "RC", "Scaled engineering organizations from 200 to 4,000 engineers. Expert in distributed systems and platform architecture."),
        new("Yolanda Osei", "General Partner", "Andreessen Horowitz", "YO", "Led investments in open-source infrastructure. Previously founded and exited two developer tools companies."),
        new("Henrik Johansson", "Former VP Engineering", "Spotify", "HJ", "Pioneered the squad model for engineering teams. Advisor to 15+ startups on engineering culture and organizational design."),
        new("Devi Chandrasekaran", "Professor", "MIT CSAIL", "DC", "Leading researcher in human-computer interaction and programming language design. Published 80+ peer-reviewed papers."),
        new("Carlos Mendez", "Former Chief Product Officer", "Atlassian", "CM", "Grew Jira and Confluence from $100M to $1B ARR. Deep expertise in product-led growth for developer ecosystems."),
    ];
}
