@* ============================================================
   Block: team-cross-functional
   Title: Team Cross Functional
   Description: Cross-functional project squads and pods view showing team composition by function with squad mission statements, member roles, and active project counts for agile organizations
   Dependencies: LucideChevronRightCn, LucideUsersCn
   Source: original/blocks/team/team-cross-functional.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Squads</p>
            <div class="mt-1 flex items-center gap-3 text-xs text-muted-foreground">
                <span class="flex items-center gap-1">
                    <LucideUsersCn Size="12" Class="size-3" />
                    @_squads.Length squads
                </span>
                <span class="size-1 rounded-full bg-muted-foreground/30"></span>
                <span>7 active projects</span>
            </div>
        </div>

        @foreach (var squad in _squads)
        {
            var isExpanded = _expanded == squad.Name;
            <div class="border-b last:border-b-0">
                <button type="button" @onclick="@(() => _expanded = isExpanded ? null : squad.Name)" class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@squad.Name</span>
                            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@squad.Members.Length</span>
                        </div>
                        <p class="mt-0.5 truncate text-xs text-muted-foreground">@squad.Mission</p>
                    </div>
                    <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                </button>
                @if (isExpanded)
                {
                    <div class="border-t">
                        @for (var i = 0; i < squad.Members.Length; i++)
                        {
                            var member = squad.Members[i];
                            <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", i < squad.Members.Length - 1 ? "border-b" : "")">
                                <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@member.Initials</div>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-baseline gap-2">
                                        <span class="truncate text-sm font-medium">@member.Name</span>
                                        <span class="hidden truncate text-xs text-muted-foreground sm:inline">@member.Role</span>
                                    </div>
                                    <p class="truncate text-xs text-muted-foreground sm:hidden">@member.Role</p>
                                </div>
                                <span class="shrink-0 rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@member.Function</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private string? _expanded = "Growth Pod";

    private record SquadMember(string Name, string Initials, string Role, string Function);
    private record SquadItem(string Name, string Mission, SquadMember[] Members);

    private static readonly SquadItem[] _squads =
    [
