@* ============================================================
   Block: team-reading-list
   Title: Team Reading List
   Description: Team recommended reading and learning resources with book titles, recommender names, category chips, and personal recommendation notes for engineering and product culture pages
   Long Description: Rapid-fire Q&A spotlights with selectable members
   Dependencies: LucideBookOpenCn
   Source: original/blocks/team/team-reading-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideBookOpenCn Size="16" Class="text-muted-foreground" />
                <p class="text-sm font-medium">Team reading list</p>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_resources.Length recommendations from the team
            </p>
        </div>

        <div class="flex gap-0 overflow-x-auto border-b">
            @foreach (var cat in _categories)
            {
                <button
                    type="button"
                    @onclick="@(() => _activeCategory = cat)"
                    class="@Cn.Merge("shrink-0 px-4 py-2.5 text-xs font-medium transition-colors", _activeCategory == cat ? "border-b-2 border-foreground text-foreground" : "text-muted-foreground hover:text-foreground")">
                    @cat
                </button>
            }
        </div>

        @{
            var filtered = _activeCategory == "All"
                ? _resources
                : _resources.Where(r => r.Category == _activeCategory).ToArray();
        }

        @for (var i = 0; i < filtered.Length; i++)
        {
            var resource = filtered[i];
            var isLast = i == filtered.Length - 1;
            <div class="@(Cn.Merge("px-4 py-3", !isLast ? "border-b" : ""))">
                <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-baseline gap-2">
                            <span class="text-sm font-medium">@resource.Title</span>
                            <span class="hidden shrink-0 text-xs text-muted-foreground sm:inline">
                                @resource.Author
                            </span>
                        </div>
                        <p class="text-xs text-muted-foreground sm:hidden">@resource.Author</p>
                    </div>
                    <span class="shrink-0 rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                        @resource.Category
                    </span>
                </div>
                <p class="mt-1.5 text-xs text-muted-foreground leading-relaxed italic">
                    &ldquo;@resource.Note&rdquo;
                </p>
                <div class="mt-1.5 flex items-center gap-2">
                    <div class="flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-[9px] font-medium">
                        @resource.RecommenderInitials
                    </div>
                    <span class="text-xs text-muted-foreground">@resource.RecommenderName</span>
                </div>
            </div>
        }

        @if (filtered.Length == 0)
        {
            <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                No recommendations in this category yet
            </div>
        }
    </div>
</section>

@code {
    private string _activeCategory = "All";

    private static readonly string[] _categories = ["All", "Leadership", "Engineering", "Design", "Product"];

    private record ResourceItem(string Title, string Author, string RecommenderName, string RecommenderInitials, string Category, string Note);

    private static readonly ResourceItem[] _resources =
    [
        new("An Elegant Puzzle", "Will Larson", "Sana Mirza", "SM", "Leadership",
            "The most practical book on engineering management I've read. Every chapter is a playbook."),
        new("Designing Data-Intensive Applications", "Martin Kleppmann", "Kofi Asante", "KA", "Engineering",
            "Read this before designing any distributed system. It will save you months of wrong turns."),
        new("The Design of Everyday Things", "Don Norman", "Lucia Fernandez", "LF", "Design",
            "Changed how I think about affordances. I see bad door handles everywhere now."),
        new("Inspired", "Marty Cagan", "Amara Osei", "AO", "Product",
            "The difference between feature teams and empowered product teams. Required reading for PMs."),
        new("A Philosophy of Software Design", "John Ousterhout", "Jonas Berg", "JB", "Engineering",
            "Short, opinionated, and right. Complexity is the root of all software problems."),
        new("Articulating Design Decisions", "Tom Greever", "Tobias Muller", "TM", "Design",
            "Designers who can explain their work win more trust. This book teaches you how."),
        new("Team Topologies", "Matthew Skelton", "Priya Mehta", "PM", "Leadership",
            "Finally a framework for team structure that actually works. Stream-aligned teams changed our org."),
        new("Continuous Discovery Habits", "Teresa Torres", "Lina Petrova", "LP", "Product",
            "Weekly customer touchpoints aren't optional. This book makes the case and gives you the system."),
    ];
}
