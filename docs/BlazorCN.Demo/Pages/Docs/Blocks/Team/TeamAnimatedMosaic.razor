@* ============================================================
   Block: team-animated-mosaic
   Title: Team Animated Mosaic
   Description: Animated connected team grid with staggered scale-in entrance, gap-px border technique, and hover lift for React team pages using framer-motion and Tailwind CSS
   Long Description: Asymmetric bento-style layout for team showcase
   Dependencies: None
   Source: original/blocks/team/team-animated-mosaic.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Our team</p>
            <p class="mt-0.5 text-xs text-muted-foreground">9 people building the future</p>
        </div>

        <div class="grid grid-cols-3 gap-px bg-border">
            @foreach (var member in _members)
            {
                <div class="flex flex-col items-center gap-2 bg-card px-3 py-5">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @member.Initials
                    </div>
                    <div class="text-center">
                        <p class="text-sm font-medium">@member.Name</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">@member.Role</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record MemberItem(string Name, string Role, string Initials);

    private static readonly MemberItem[] _members =
    [
        new("Lena Eriksson", "CEO", "LE"),
        new("Marco Rossi", "CTO", "MR"),
        new("Aisha Kwame", "CPO", "AK"),
        new("David Chen", "Engineering Lead", "DC"),
        new("Sophia Alvarez", "Design Lead", "SA"),
        new("Tomoko Sato", "Product Manager", "TS"),
        new("Felix Braun", "Senior Engineer", "FB"),
        new("Nia Osei", "UX Researcher", "NO"),
        new("Raj Patel", "Data Scientist", "RP"),
    ];
}
