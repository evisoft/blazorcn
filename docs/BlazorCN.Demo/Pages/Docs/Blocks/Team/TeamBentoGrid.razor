@* ============================================================
   Block: team-bento-grid
   Title: Team Bento Grid
   Description: Connected bento grid layout with a featured founder cell and smaller team member cells using gap-px border pattern for React team sections
   Dependencies: None
   Source: original/blocks/team/team-bento-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-border">
        <div class="grid gap-px md:grid-cols-3 md:grid-rows-2">
            @for (var i = 0; i < _members.Length; i++)
            {
                var member = _members[i];
                var isFeatured = i == 0;
                <div class="@Cn.Merge("bg-card px-4 py-4", isFeatured ? "md:col-span-2 md:row-span-2 md:py-6" : "")">
                    <div class="flex items-center gap-3">
                        <div class="@Cn.Merge("flex shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium", isFeatured ? "size-10" : "size-8")">
                            @member.Initials
                        </div>
                        <div class="min-w-0">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@member.Name</span>
                                <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@member.Department</span>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">@member.Role</p>
                        </div>
                    </div>
                    <p class="@Cn.Merge("mt-3 text-xs text-muted-foreground leading-relaxed", isFeatured ? "md:text-sm" : "")">@member.Bio</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record MemberItem(string Name, string Role, string Bio, string Initials, string Department);
    private static readonly MemberItem[] _members =
    [
        new("Elena Vasquez", "Co-Founder & CEO", "Former infrastructure lead at Vercel who helped scale the platform from 100k to 10M deployments per day. Elena founded the company with a vision to make developer tooling as intuitive as consumer products. She oversees product strategy, fundraising, and company culture.", "EV", "Leadership"),
        new("Tobias Richter", "CTO", "Built distributed systems at Cloudflare for six years. Architects our entire backend infrastructure and leads the platform engineering team.", "TR", "Engineering"),
        new("Priya Sharma", "Head of Design", "Previously at Figma where she led the Variables feature. Owns our design system, brand identity, and end-to-end user experience.", "PS", "Design"),
        new("Marcus Chen", "VP of Sales", "Closed the first 50 enterprise deals at Datadog. Runs our go-to-market engine spanning sales, partnerships, and customer success.", "MC", "Sales"),
        new("Amara Osei", "Staff Engineer", "Core contributor to the Rust compiler. Leads our performance-critical systems including the real-time sync engine and edge runtime.", "AO", "Engineering"),
        new("Felix Andersen", "Director of Marketing", "Grew Linear's community from zero to 200k developers. Drives brand strategy, content marketing, and developer community programs.", "FA", "Marketing"),
    ];
}
