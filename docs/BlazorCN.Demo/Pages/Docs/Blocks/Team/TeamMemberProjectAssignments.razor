@* ============================================================
   Block: team-member-project-assignments
   Title: TeamMemberProjectAssignments
   Description: A project assignment tracking block for React and Next.js displaying current and past projects built with shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-member-project-assignments.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="space-y-4">
        @* Header *@
        <div>
            <h2 class="text-sm font-medium">Project Assignments</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Current and past project involvement
            </p>
        </div>

        @* Team Members *@
        <div class="space-y-4">
            @foreach (var mem in _team)
            {
                var member = mem;
                <div class="rounded-lg border bg-card p-4">
                    <h3 class="mb-3 text-sm font-medium">@member.Name</h3>
                    <div class="space-y-2">
                        @foreach (var proj in member.Projects)
                        {
                            var project = proj;
                            <div class="rounded-md bg-muted/30 p-2.5">
                                <div class="flex items-center justify-between gap-2 mb-1.5">
                                    <p class="text-sm font-medium">@project.Name</p>
                                    <BadgeCn Variant="@(project.Status == ProjectStatus.Active ? BadgeVariant.Secondary : BadgeVariant.Outline)" Class="text-xs">
                                        @project.StatusLabel
                                    </BadgeCn>
                                </div>
                                <p class="text-xs text-muted-foreground">@project.Duration</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum ProjectStatus { Active, Completed, Planned }

    private record Project(string Name, ProjectStatus Status, string[] Team, string Duration)
    {
        public string StatusLabel => Status switch
        {
            ProjectStatus.Active    => "active",
            ProjectStatus.Completed => "completed",
            ProjectStatus.Planned   => "planned",
            _                       => "unknown",
        };
    }

    private record TeamMemberProjects(string Name, Project[] Projects);

    private static readonly TeamMemberProjects[] _team =
    [
        new("Sarah Chen",
        [
            new("Dashboard Redesign",       ProjectStatus.Active,    ["Sarah", "Emily", "Marcus"], "Jan-Mar 2026"),
            new("Analytics Platform",        ProjectStatus.Completed, ["Sarah", "Marcus"],          "Oct-Dec 2025"),
        ]),
        new("Marcus Rodriguez",
        [
            new("API Optimization",          ProjectStatus.Active,    ["Marcus", "Jordan"],         "Feb-Apr 2026"),
            new("Microservices Migration",   ProjectStatus.Active,    ["Marcus", "Alex"],           "Jan-Jun 2026"),
        ]),
    ];
}
