@* ============================================================
   Block: team-anniversaries
   Title: Team Anniversaries and Milestones
   Description: Work anniversary celebration section grouped by milestone tenure with initials, name, role, exact years, and personal notes
   Dependencies: none (pure HTML/Tailwind)
   Source: original/blocks/team/team-anniversaries.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Work anniversaries</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_milestoneGroups.Sum(g => g.Members.Length) team members celebrating milestones this quarter
            </p>
        </div>

        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div>
                <p class="text-2xl font-semibold tabular-nums">5.2</p>
                <p class="text-xs text-muted-foreground">avg. years tenure</p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-2xl font-semibold tabular-nums">94%</p>
                <p class="text-xs text-muted-foreground">retention rate</p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-2xl font-semibold tabular-nums">2</p>
                <p class="text-xs text-muted-foreground">co-founders</p>
            </div>
        </div>

        @foreach (var group in _milestoneGroups)
        {
            var isExpanded = _expandedGroup == group.Label;
            <div class="border-b last:border-b-0">
                <button type="button"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => _expandedGroup = isExpanded ? null : group.Label)">
                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", group.DotColor)"></span>
                    <div class="min-w-0 flex-1">
                        <span class="text-sm font-medium">@group.Label</span>
                        <span class="ml-2 text-xs text-muted-foreground">
                            @group.Members.Length @(group.Members.Length == 1 ? "member" : "members")
                        </span>
                    </div>
                    <LucideChevronRightCn Size="16"
                                          Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                </button>
                @if (isExpanded)
                {
                    <div class="border-t bg-muted/30">
                        @foreach (var member in group.Members)
                        {
                            <div class="border-b px-4 py-3 last:border-b-0">
                                <div class="flex items-start gap-3 pl-4">
                                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                                        @member.Initials
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-baseline gap-2">
                                            <span class="text-sm font-medium">@member.Name</span>
                                            <span class="text-xs text-muted-foreground">@member.Role</span>
                                        </div>
                                        <p class="mt-0.5 font-mono text-xs text-muted-foreground">
                                            @member.Tenure
                                        </p>
                                        <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
                                            @member.Note
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record AnniversaryMember(string Name, string Role, string Initials, string Tenure, string Note);
    private record MilestoneGroup(string Label, string DotColor, AnniversaryMember[] Members);

    private string? _expandedGroup = "5 years";

    private static readonly MilestoneGroup[] _milestoneGroups =
    [
        new("5 years", "bg-amber-500",
        [
            new("Ingrid Solberg", "Co-founder & CEO", "IS", "5 years, 2 months", "Wrote the first commit and has led every major product pivot. The company exists because of her relentless clarity."),
            new("James Okoye", "Co-founder & CTO", "JO", "5 years, 2 months", "Architected the entire platform from scratch. Still reviews every critical PR and mentors three junior engineers weekly."),
        ]),
        new("3 years", "bg-emerald-500",
        [
            new("Mei-Lin Wu", "Principal Engineer", "MW", "3 years, 8 months", "Our first engineering hire. Built the real-time sync engine that handles 2 million concurrent connections daily."),
            new("Anders Holm", "VP of Design", "AH", "3 years, 1 month", "Created our design system from the ground up. His component library is used across all three product lines."),
            new("Priya Kapoor", "VP of Product", "PK", "3 years", "Shipped 14 major features in her first year. Introduced the prioritization framework the whole company now uses."),
        ]),
        new("1 year", "bg-blue-500",
        [
            new("Felix Brennan", "Head of Growth", "FB", "1 year, 4 months", "Designed the referral system driving 40% of organic signups. Previously scaled Spotify's creator growth program."),
            new("Yuki Tanaka", "Head of Data", "YT", "1 year, 2 months", "Built our recommendation engine from scratch. Her models increased feature adoption by 28% in the first quarter."),
            new("Sofia Reyes", "Senior Product Designer", "SR", "1 year, 1 month", "Led the dashboard redesign that improved task completion rates by 35%. Mentors two design interns."),
            new("Leo Andersen", "Staff Software Engineer", "LA", "1 year", "Migrated the entire API layer to GraphQL without a single minute of downtime. Advocates for developer experience on every project."),
        ]),
    ];
}
