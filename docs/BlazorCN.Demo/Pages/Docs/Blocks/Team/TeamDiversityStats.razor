@* ============================================================
   Block: team-diversity-stats
   Title: Team Diversity Stats
   Description: Team diversity and representation metrics with gender, ethnicity, and geographic breakdowns using percentage bars and year-over-year trend indicators
   Dependencies: LucideArrowUpCn, LucideArrowDownCn, LucideMinusCn
   Source: original/blocks/team/team-diversity-stats.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Diversity and representation</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Workforce composition across 214 employees as of Q1 2026</p>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs leading-relaxed text-muted-foreground">
                We believe diverse teams build better products. We publish these numbers annually to
                hold ourselves accountable and track our progress toward building a team that reflects
                the communities we serve.
            </p>
        </div>

        <div>
            @for (var catIndex = 0; catIndex < _categories.Length; catIndex++)
            {
                var category = _categories[catIndex];
                var isExpanded = _expandedCategory == category.Title;
                var isLast = catIndex == _categories.Length - 1;
                <div class="@Cn.Merge(!isLast ? "border-b" : "")">
                    <button type="button" @onclick="@(() => _expandedCategory = isExpanded ? null : category.Title)"
                            class="flex w-full items-center justify-between px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="text-sm font-medium">@category.Title</span>
                        <span class="text-xs text-muted-foreground">@(isExpanded ? "Collapse" : "Expand")</span>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4">
                            <div class="space-y-3">
                                @foreach (var item in category.Items)
                                {
                                    <div>
                                        <div class="mb-1 flex items-center justify-between">
                                            <span class="text-xs text-muted-foreground">@item.Label</span>
                                            <div class="flex items-center gap-2">
                                                <span class="font-medium text-xs tabular-nums">@(item.Percentage)%</span>
                                                @if (item.Trend > 0)
                                                {
                                                    <span class="flex items-center gap-0.5 text-emerald-600 text-xs dark:text-emerald-400">
                                                        <LucideArrowUpCn Size="12" Class="size-3" />
                                                        <span class="tabular-nums">+@item.Trend</span>
                                                    </span>
                                                }
                                                else if (item.Trend < 0)
                                                {
                                                    <span class="flex items-center gap-0.5 text-red-600 text-xs dark:text-red-400">
                                                        <LucideArrowDownCn Size="12" Class="size-3" />
                                                        <span class="tabular-nums">@item.Trend</span>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="flex items-center gap-0.5 text-muted-foreground text-xs">
                                                        <LucideMinusCn Size="12" Class="size-3" />
                                                        <span class="tabular-nums">0</span>
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                        <div class="h-1.5 w-full rounded-full bg-muted">
                                            <div class="h-1.5 rounded-full bg-foreground/70"
                                                 role="progressbar"
                                                 style="@($"width: {item.Percentage}%")"
                                                 aria-label="@($"{item.Label}: {item.Percentage}%")"
                                                 aria-valuenow="@item.Percentage"
                                                 aria-valuemin="0"
                                                 aria-valuemax="100"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="border-t bg-muted/50 px-4 py-2.5">
            <p class="text-xs text-muted-foreground">
                Year-over-year change shown in percentage points. Data self-reported and anonymized.
            </p>
        </div>
    </div>
</section>

@code {
    private string? _expandedCategory = "Gender representation";

    private record CategoryItem(string Label, int Percentage, int Trend);
    private record DiversityCategory(string Title, CategoryItem[] Items);

    private static readonly DiversityCategory[] _categories =
    [
        new("Gender representation",
        [
            new("Women", 43, 3),
            new("Men", 52, -2),
            new("Non-binary", 4, 1),
            new("Prefer not to say", 1, 0),
        ]),
        new("Ethnicity",
        [
            new("White", 38, -4),
            new("Asian", 28, 2),
            new("Hispanic or Latino", 14, 3),
            new("Black", 12, 2),
            new("Two or more races", 6, 1),
            new("Other", 2, 0),
        ]),
        new("Geographic distribution",
        [
            new("North America", 44, -3),
            new("Europe", 28, 1),
            new("Asia-Pacific", 16, 2),
            new("Latin America", 8, 1),
            new("Africa", 4, 1),
        ]),
    ];
}
