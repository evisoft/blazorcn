@* ============================================================
   Block: team-pet-wall
   Title: Team Pet Wall
   Description: Team pets showcase with pet names, types, breeds, owners, and personality descriptions in a minimal expandable list
   Dependencies: LucideChevronRightCn, LucidePawPrintCn
   Source: original/blocks/team/team-pet-wall.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium">Team pets</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@_pets.Length furry (and feathery) team members</p>
                </div>
                <LucidePawPrintCn Size="16" Class="size-4 text-muted-foreground" />
            </div>
        </div>

        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            @foreach (var typeCount in _petTypeCounts)
            {
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="font-medium tabular-nums">@typeCount.Count</span>
                    @typeCount.Type@(typeCount.Count != 1 ? "s" : "")
                </span>
            }
        </div>

        <div>
            @for (var index = 0; index < _pets.Length; index++)
            {
                var pet = _pets[index];
                var isExpanded = _expanded == pet.Id;
                var isLast = index == _pets.Length - 1;
                <div class="@Cn.Merge(!isLast ? "border-b" : "")">
                    <button type="button" @onclick="@(() => _expanded = isExpanded ? null : pet.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@pet.Name</span>
                                <span class="shrink-0 rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@pet.Type</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="text-xs text-muted-foreground">@pet.Breed</span>
                                <span class="text-muted-foreground text-xs">&middot;</span>
                                <div class="flex items-center gap-1.5">
                                    <div class="flex size-4 items-center justify-center rounded-full bg-muted text-[8px] font-medium">@pet.OwnerInitials</div>
                                    <span class="text-xs text-muted-foreground">@pet.OwnerName</span>
                                </div>
                            </div>
                        </div>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4">
                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="mb-1.5 block text-xs font-medium text-muted-foreground">Personality</span>
                                <p class="text-sm leading-relaxed">@pet.Personality</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record TypeCount(string Type, int Count);
    private static readonly TypeCount[] _petTypeCounts = _pets.GroupBy(p => p.Type).Select(g => new TypeCount(g.Key, g.Count())).ToArray();

    private record PetItem(string Id, string Name, string Type, string Breed, string OwnerName, string OwnerInitials, string Personality);
    private static readonly PetItem[] _pets =
    [
        new("1", "Biscuit", "Dog", "Golden Retriever", "Sarah Chen", "SC", "Official greeter of the San Francisco office. Sits under Sarah's standing desk during standups and has been known to bark exactly once when deploys go out. Loves belly rubs and peanut butter Kongs."),
        new("2", "Pixel", "Cat", "Russian Blue", "Mei-Lin Wu", "MW", "Walks across the keyboard during code reviews with suspicious accuracy. Has mass-reverted a PR exactly once. Prefers sleeping on the warm side of the laptop and judges your architecture decisions silently."),
        new("3", "Churro", "Dog", "Corgi", "Elena Rodriguez", "ER", "The team's unofficial mascot with his own Slack emoji. Attends all-hands via webcam and has more engagement on the company Instagram than any product launch. Extremely food motivated."),
        new("4", "Mochi", "Cat", "Scottish Fold", "Yuki Tanaka", "YT", "Calm presence during late-night debugging sessions. Has a dedicated spot on the windowsill overlooking the garden. Only gets excited about laser pointers and the sound of a can opener."),
        new("5", "Professor Feathers", "Bird", "Cockatiel", "James O'Brien", "JO", "Whistles the first four notes of the company jingle. Has learned to mimic the Slack notification sound, causing maximum confusion. Sits on James's shoulder during video calls."),
        new("6", "Noodle", "Dog", "Dachshund", "Marcus Johnson", "MJ", "Tiny but fierce. Guards the engineering corner with an iron paw. Has a sweater for every day of the week and a strong opinion about TypeScript. Sleeps exactly 18 hours a day."),
        new("7", "Luna", "Cat", "Maine Coon", "Priya Sharma", "PS", "Largest cat in the company by a significant margin. Shows up on camera during product reviews and has accidentally closed deals by being adorable. Loves cardboard boxes of any size."),
        new("8", "Ziggy", "Dog", "Border Collie", "David Kim", "DK", "Herds the other office dogs with military precision. Has an uncanny ability to sense when someone is about to take a break and materializes with a tennis ball. Extremely smart and slightly manipulative."),
    ];
}
