@* ============================================================
   Block: team-research-papers
   Title: Team Research Papers
   Description: Team publications and research papers directory with author initials, publication venue, citation counts, and expandable abstracts for React team and academic portfolio pages
   Long Description: Team reading list with progress tracking
   Dependencies: LucideChevronRightCn
   Source: original/blocks/team/team-research-papers.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideFileTextCn Size="16" Class="text-muted-foreground" />
            <span class="text-sm font-medium">Publications</span>
            <div class="ml-auto flex items-center gap-3">
                <span class="text-xs text-muted-foreground">@_papers.Length papers</span>
                <span class="text-xs text-muted-foreground">@_totalCitations citations</span>
            </div>
        </div>

        @foreach (var paper in _papers)
        {
            var isExpanded = _expanded == paper.Title;
            <div class="border-b last:border-b-0">
                <button
                    type="button"
                    @onclick="@(() => _expanded = isExpanded ? null : paper.Title)"
                    class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium leading-snug">@paper.Title</p>
                        <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1">
                            <div class="flex items-center gap-1">
                                @foreach (var author in paper.Authors)
                                {
                                    <div class="flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium"
                                         title="@author.Name">
                                        @author.Initials
                                    </div>
                                }
                            </div>
                            <span class="text-xs text-muted-foreground">@paper.Venue</span>
                            <span class="text-xs text-muted-foreground/60">@paper.Year</span>
                            <span class="font-mono text-xs text-muted-foreground">
                                @paper.Citations cited
                            </span>
                        </div>
                    </div>
                    <LucideChevronRightCn
                        Size="16"
                        Class="@Cn.Merge("shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                </button>
                @if (isExpanded)
                {
                    <div class="border-t bg-muted/30 px-4 py-3">
                        <div class="rounded-md bg-muted/50 p-3">
                            <p class="text-xs font-medium text-muted-foreground">Abstract</p>
                            <p class="mt-1.5 text-sm leading-relaxed text-foreground">
                                @paper.Abstract
                            </p>
                            <div class="mt-3 flex flex-wrap items-center gap-1.5">
                                @foreach (var author in paper.Authors)
                                {
                                    <span class="rounded bg-background px-1.5 py-0.5 text-xs text-muted-foreground">
                                        @author.Name
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private string? _expanded;

    private static int _totalCitations => _papers.Sum(p => p.Citations);

    private record AuthorItem(string Name, string Initials);

    private record PaperItem(string Title, AuthorItem[] Authors, string Venue, string Year, int Citations, string Abstract);

    private static readonly PaperItem[] _papers =
    [
        new("Efficient Transformer Architectures for Low-Latency Inference",
            [new("Sarah Chen", "SC"), new("David Kim", "DK"), new("Ravi Mehta", "RM")],
            "NeurIPS 2025", "2025", 142,
            "We present a family of transformer architectures optimized for production inference workloads. By combining structured pruning with dynamic attention sparsity, we achieve 3.2x latency reduction on standard benchmarks while maintaining 98.7% of the baseline accuracy. Our approach is compatible with existing serving frameworks and requires no changes to the training pipeline."),
        new("Scaling Retrieval-Augmented Generation to Enterprise Knowledge Bases",
            [new("Marcus Johnson", "MJ"), new("Sarah Chen", "SC")],
            "ICML 2025", "2025", 89,
            "Enterprise knowledge bases pose unique challenges for retrieval-augmented generation: heterogeneous document formats, access control requirements, and rapidly evolving content. We introduce a hierarchical retrieval strategy with permission-aware indexing that scales to 50M+ documents while maintaining sub-200ms query latency. Evaluated on three Fortune 500 deployments."),
        new("Causal Inference Methods for A/B Testing with Network Effects",
            [new("Elena Rodriguez", "ER"), new("Priya Sharma", "PS")],
            "KDD 2024", "2024", 217,
            "Standard A/B testing assumptions break down in products with strong network effects, leading to biased treatment effect estimates. We propose a cluster-based randomization framework with interference-adjusted estimators that reduces bias by 40-60% compared to naive approaches. We validate our method on three large-scale social platform experiments."),
        new("Privacy-Preserving Federated Learning for Healthcare Applications",
            [new("Aisha Patel", "AP"), new("David Kim", "DK"), new("James O'Brien", "JO")],
            "Nature Machine Intelligence", "2024", 308,
            "We demonstrate a federated learning system for medical imaging that satisfies differential privacy guarantees while achieving diagnostic accuracy comparable to centralized training. Our protocol reduces communication overhead by 8x through gradient compression and supports heterogeneous hospital infrastructure. Deployed across 12 institutions for chest radiograph classification."),
        new("Real-Time Anomaly Detection in Distributed Microservice Architectures",
            [new("Ravi Mehta", "RM"), new("Marcus Johnson", "MJ")],
            "SOSP 2024", "2024", 76,
            "Detecting anomalies in microservice architectures requires reasoning about complex dependency graphs under strict latency constraints. We introduce a graph neural network approach that processes distributed traces in real-time, identifying cascading failures 4.5 minutes earlier than threshold-based alerts on average. Evaluated on production traces from a 200-service deployment."),
    ];
}
