@* ============================================================
   Block: team-split-layout
   Title: Team Split Layout
   Description: Two-panel split team section with company description and stats on the left and compact member rows on the right
   Dependencies: None
   Source: original/blocks/team/team-split-layout.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid md:grid-cols-5">
            <div class="border-b px-4 py-4 md:col-span-2 md:border-r md:border-b-0">
                <h2 class="text-sm font-medium">Our story</h2>
                <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
                    We started in 2021 with a simple observation: the tools developers use every day
                    should be as well-designed as the products they build.
                </p>
                <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
                    Three years later, over 12,000 teams trust us to power their daily workflow. Every
                    pixel is intentional, every interaction is instant.
                </p>
                <div class="mt-4 flex items-center gap-4 border-t pt-4">
                    @foreach (var stat in _stats)
                    {
                        <div>
                            <div class="text-2xl font-semibold tabular-nums">@stat.Value</div>
                            <div class="text-xs text-muted-foreground">@stat.Label</div>
                        </div>
                    }
                </div>
            </div>

            <div class="md:col-span-3">
                <div class="border-b px-4 py-3">
                    <h3 class="text-sm font-medium">Leadership</h3>
                </div>

                @for (var i = 0; i < _members.Length; i++)
                {
                    var member = _members[i];
                    <div class="@Cn.Merge("px-4 py-3", i < _members.Length - 1 ? "border-b" : "")">
                        <div class="flex items-center gap-3">
                            <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@member.Initials</div>
                            <div class="min-w-0 flex-1">
                                <div class="text-sm font-medium">@member.Name</div>
                                <div class="text-xs text-muted-foreground">@member.Role</div>
                            </div>
                        </div>
                        <p class="mt-1.5 pl-11 text-xs text-muted-foreground leading-relaxed">@member.Bio</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Label, string Value);
    private static readonly StatItem[] _stats =
    [
        new("Team members", "48"),
        new("Countries", "12"),
        new("Years building", "5"),
    ];

    private record MemberItem(string Name, string Role, string Initials, string Bio);
    private static readonly MemberItem[] _members =
    [
        new("Priya Raghavan", "Chief Executive Officer", "PR", "Former product lead at Atlassian. Spent a decade building collaboration tools used by millions of teams worldwide."),
        new("Daniel Eriksson", "Head of Engineering", "DE", "Ex-Spotify staff engineer. Scaled music streaming infrastructure from 50M to 400M monthly active users."),
        new("Camille Dubois", "VP of Design", "CD", "Award-winning design director from Apple. Obsessed with craft, micro-interactions, and pixel-perfect details."),
        new("Marcus Thompson", "Head of Growth", "MT", "Grew Calendly's self-serve revenue from $5M to $70M ARR. Expert in product-led acquisition and activation loops."),
    ];
}
