@* ============================================================
   Block: team-photo-mosaic
   Title: Team Photo Mosaic
   Description: Connected grid of team members with initials, names, and roles using a gap-px border pattern
   Long Description: Sequential numbered team rows with department chips
   Dependencies: None
   Source: original/blocks/team/team-photo-mosaic.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Our team</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Eight people building the product every day.
            </p>
        </div>

        <div class="grid grid-cols-2 gap-px bg-border md:grid-cols-4">
            @foreach (var member in _members)
            {
                <div class="flex flex-col items-center bg-card px-3 py-5 text-center">
                    <div class="flex size-10 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @member.Initials
                    </div>
                    <p class="mt-2.5 text-sm font-medium leading-tight">@member.Name</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@member.Role</p>
                    <span class="mt-1.5 rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                        @member.Department
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TeamMember(string Name, string Role, string Initials, string Department);

    private static readonly TeamMember[] _members =
    [
        new("Mia Chang", "Chief Technology Officer", "MC", "Leadership"),
        new("Roberto Vega", "Senior Frontend Engineer", "RV", "Engineering"),
        new("Anika Desai", "Head of Product", "AD", "Product"),
        new("Elijah Brooks", "Staff Backend Engineer", "EB", "Engineering"),
        new("Sofia Nilsson", "Lead Product Designer", "SN", "Design"),
        new("Kwame Asante", "Platform Engineer", "KA", "Infrastructure"),
        new("Lena Kowalski", "UX Researcher", "LK", "Design"),
        new("Omar Hassan", "Engineering Manager", "OH", "Engineering"),
    ];
}
