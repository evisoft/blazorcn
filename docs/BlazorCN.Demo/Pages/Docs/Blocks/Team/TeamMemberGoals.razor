@* ============================================================
   Block: team-member-goals
   Title: TeamMemberGoals
   Description: A team member goals and OKR tracking block for React and Next.js showing progress towards quarterly objectives built with shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-member-goals.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="space-y-4">
        @* Header *@
        <div>
            <h2 class="text-sm font-medium">Quarterly Goals</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Track team member OKRs and progress
            </p>
        </div>

        @* Members and Goals *@
        @foreach (var mem in _members)
        {
            var member = mem;
            <div class="space-y-2">
                <div class="rounded-lg bg-muted/30 px-4 py-2">
                    <h3 class="text-sm font-medium">@member.Name</h3>
                    <p class="text-xs text-muted-foreground">@member.Quarter</p>
                </div>

                <div class="space-y-2">
                    @foreach (var gl in member.Goals)
                    {
                        var goal = gl;
                        var isExpanded = _expanded == goal.Id;
                        <div class="overflow-hidden rounded-lg border bg-card">
                            <button type="button"
                                    @onclick="@(() => ToggleExpand(goal.Id))"
                                    class="w-full px-4 py-3 text-left transition-colors hover:bg-muted/50">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="min-w-0 flex-1">
                                        <h4 class="text-sm font-medium">@goal.Title</h4>
                                        <div class="mt-2 space-y-1.5">
                                            <ProgressCn Value="@goal.Progress" Class="h-1" aria-label="Progress" />
                                            <span class="inline-flex text-xs text-muted-foreground">
                                                @goal.Progress% complete
                                            </span>
                                        </div>
                                    </div>
                                    <div class="flex shrink-0 items-center gap-2">
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                                            <span class="@Cn.Merge("mr-1.5 size-1.5 rounded-full", GetStatusColor(goal.Status))"></span>
                                            @GetStatusLabel(goal.Status)
                                        </BadgeCn>
                                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                                    </div>
                                </div>
                            </button>

                            @if (isExpanded)
                            {
                                <div class="border-t px-4 py-3">
                                    <span class="text-xs font-medium text-muted-foreground">
                                        Key Results
                                    </span>
                                    <div class="mt-2 space-y-1.5">
                                        @foreach (var kr in goal.KeyResults)
                                        {
                                            <div class="flex items-center gap-2 text-sm text-muted-foreground">
                                                <LucideIconCn Name="trending-up" Size="12" Class="size-3 shrink-0 text-emerald-600 dark:text-emerald-400" />
                                                @kr
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private enum GoalStatus { OnTrack, AtRisk, Completed }

    private record Goal(string Id, string Title, GoalStatus Status, int Progress, string[] KeyResults);

    private record TeamMemberGoal(string Id, string Name, string Quarter, Goal[] Goals);

    private string? _expanded = "g1";

    private void ToggleExpand(string goalId)
    {
        _expanded = _expanded == goalId ? null : goalId;
    }

    private static string GetStatusColor(GoalStatus status) => status switch
    {
        GoalStatus.OnTrack   => "bg-emerald-500",
        GoalStatus.AtRisk    => "bg-amber-500",
        GoalStatus.Completed => "bg-blue-500",
        _                    => "bg-muted-foreground",
    };

    private static string GetStatusLabel(GoalStatus status) => status switch
    {
        GoalStatus.OnTrack   => "On Track",
        GoalStatus.AtRisk    => "At Risk",
        GoalStatus.Completed => "Completed",
        _                    => "Unknown",
    };

    private static readonly TeamMemberGoal[] _members =
    [
        new("1", "Sarah Chen", "Q2 2026",
        [
            new("g1", "Launch new dashboard feature", GoalStatus.OnTrack, 75,
                ["Complete design specs", "Engineering review", "Beta testing"]),
            new("g2", "Improve product adoption", GoalStatus.AtRisk, 45,
                ["Conduct user research", "Create onboarding guide", "Track metrics"]),
        ]),
        new("2", "Marcus Rodriguez", "Q2 2026",
        [
            new("g3", "Refactor API architecture", GoalStatus.OnTrack, 60,
                ["Complete phase 1", "Deploy to staging", "Load test"]),
            new("g4", "Mentor junior engineers", GoalStatus.Completed, 100,
                ["1-on-1 meetings", "Code reviews", "Professional development"]),
        ]),
    ];
}
