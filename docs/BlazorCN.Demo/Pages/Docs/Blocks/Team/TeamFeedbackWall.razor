@* ============================================================
   Block: team-feedback-wall
   Title: TeamFeedbackWall
   Description: React peer recognition wall with shadcn/ui components, Next.js, and Tailwind CSS featuring categorized appreciation posts
   Source: original/blocks/team/team-feedback-wall.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Kudos wall</p>
            <p class="mt-0.5 text-xs text-muted-foreground">@(_kudos.Length) recognitions this week</p>
        </div>

        <div class="flex flex-wrap items-center gap-1.5 border-b px-4 py-2.5">
            <button type="button" @onclick="@(() => _filter = "all")"
                class="@Cn.Merge("rounded-md px-2 py-1 text-xs transition-colors", _filter == "all" ? "bg-muted font-medium" : "text-muted-foreground hover:text-foreground")">
                All
            </button>
            @foreach (var cat in _categories)
            {
                var catCapture = cat;
                <button type="button" @onclick="@(() => _filter = catCapture)"
                    class="@Cn.Merge("rounded-md px-2 py-1 text-xs transition-colors", _filter == catCapture ? "bg-muted font-medium" : "text-muted-foreground hover:text-foreground")">
                    @_categoryLabel[catCapture]
                </button>
            }
        </div>

        <div>
            @{
                var filtered = _filter == "all" ? _kudos : System.Linq.Enumerable.Where(_kudos, k => k.Category == _filter).ToArray();
            }
            @for (var i = 0; i < filtered.Length; i++)
            {
                var item = filtered[i];
                var isLiked = _liked.Contains(item.Id);
                <div class="@Cn.Merge("px-4 py-3", i < filtered.Length - 1 ? "border-b" : "")">
                    <div class="flex items-center gap-2">
                        <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@item.From.Initials</div>
                        <span class="text-xs text-muted-foreground">@item.From.Name</span>
                        <span class="text-xs text-muted-foreground">&rarr;</span>
                        <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@item.To.Initials</div>
                        <span class="text-xs font-medium">@item.To.Name</span>
                        <span class="ml-auto rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@_categoryLabel[item.Category]</span>
                    </div>
                    <p class="mt-2 text-sm leading-relaxed">@item.Message</p>
                    <div class="mt-2 flex items-center gap-3">
                        <button type="button" @onclick="@(() => ToggleLike(item.Id))"
                            class="flex items-center gap-1 text-xs text-muted-foreground transition-colors hover:text-foreground">
                            <LucideIconCn Name="heart" Size="12" Class="@Cn.Merge("size-3", isLiked ? "fill-red-500 text-red-500" : "")" />
                            <span class="tabular-nums">@(item.Reactions + (isLiked ? 1 : 0))</span>
                        </button>
                        <span class="text-xs text-muted-foreground">@item.Time</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record PersonInfo(string Name, string Initials);
    private record KudosItem(string Id, PersonInfo From, PersonInfo To, string Category, string Message, string Time, int Reactions);

    private static readonly KudosItem[] _kudos =
    [
        new("k1", new("Sarah Chen", "SC"), new("David Kim", "DK"), "above-and-beyond",
            "Stayed late to debug the critical production issue and had it resolved before users noticed. Incredible dedication.",
            "2 hours ago", 12),
        new("k2", new("Marcus Johnson", "MJ"), new("Elena Rodriguez", "ER"), "innovation",
            "The new component library architecture is brilliant. Cut our build time by 40% and the DX is night and day better.",
            "5 hours ago", 8),
        new("k3", new("Aisha Patel", "AP"), new("James O'Brien", "JO"), "mentorship",
            "Thanks for the pairing sessions on Kubernetes. I went from lost to deploying my own services in two weeks.",
            "Yesterday", 15),
        new("k4", new("David Kim", "DK"), new("Yuki Tanaka", "YT"), "teamwork",
            "Caught three edge cases in code review that would have caused data loss. Your thoroughness saves us every sprint.",
            "Yesterday", 6),
        new("k5", new("Elena Rodriguez", "ER"), new("Priya Sharma", "PS"), "culture",
            "Organized the best team offsite we have had. Everyone felt included and the workshops were genuinely useful.",
            "2 days ago", 19),
        new("k6", new("James O'Brien", "JO"), new("Sarah Chen", "SC"), "mentorship",
            "Your architecture review feedback completely changed how I think about system design. Grateful for the time you invested.",
            "3 days ago", 11),
    ];

    private static readonly string[] _categories = ["teamwork", "innovation", "mentorship", "above-and-beyond", "culture"];

    private static readonly Dictionary<string, string> _categoryLabel = new()
    {
        ["teamwork"] = "Teamwork",
        ["innovation"] = "Innovation",
        ["mentorship"] = "Mentorship",
        ["above-and-beyond"] = "Above & beyond",
        ["culture"] = "Culture",
    };

    private string _filter = "all";
    private readonly HashSet<string> _liked = new();

    private void ToggleLike(string id)
    {
        if (_liked.Contains(id))
            _liked.Remove(id);
        else
            _liked.Add(id);
    }
}
