@* ============================================================
   Block: team-project-assignments
   Title: TeamProjectAssignments
   Description: React project team groupings with progress bars using shadcn/ui, Next.js, and Tailwind CSS for resource planning.
   Source: original/blocks/team/team-project-assignments.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Project assignments</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_totalMembers members across @_projects.Length projects
            </p>
        </div>

        <div>
            @for (var i = 0; i < _projects.Length; i++)
            {
                var proj = _projects[i];
                var isExpanded = _expanded == proj.Name;
                var isLast = i == _projects.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => { var n = proj.Name; _expanded = (_expanded == n ? null : n); })"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@($"size-2 shrink-0 rounded-full {StatusDotClass(proj.Status)}")" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@proj.Name</span>
                                <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                    @StatusLabelText(proj.Status)
                                </span>
                            </div>
                            <div class="mt-1 flex items-center gap-3">
                                <div class="h-1 w-24 rounded-full bg-muted">
                                    <div
                                        class="h-1 rounded-full bg-foreground/20"
                                        style="@($"width:{proj.Progress}%")" />
                                </div>
                                <span class="font-mono text-xs text-muted-foreground">@(proj.Progress)%</span>
                                <span class="text-xs text-muted-foreground">·</span>
                                <span class="text-xs text-muted-foreground">Due @proj.Deadline</span>
                                <span class="text-xs text-muted-foreground">·</span>
                                <span class="text-xs text-muted-foreground">@(proj.Members.Length) members</span>
                            </div>
                        </div>
                        <LucideChevronRightCn
                            Size="16"
                            Class="@Cn.Merge("shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/20">
                            @for (var mi = 0; mi < proj.Members.Length; mi++)
                            {
                                var member = proj.Members[mi];
                                var notLast = mi < proj.Members.Length - 1;
                                <div class="@($"flex items-center gap-3 px-4 py-2.5 pl-9{(notLast ? " border-b" : "")}")">
                                    <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                                        @member.Initials
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <span class="text-sm font-medium">@member.Name</span>
                                        <p class="text-xs text-muted-foreground">@member.ProjectRole</p>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <div class="h-1 w-12 rounded-full bg-muted">
                                            <div
                                                class="h-1 rounded-full bg-foreground/20"
                                                style="@($"width:{member.Allocation}%")" />
                                        </div>
                                        <span class="w-8 text-right font-mono text-xs text-muted-foreground">
                                            @(member.Allocation)%
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "Dashboard Redesign";

    private static string StatusDotClass(ProjectStatus status) => status switch
    {
        ProjectStatus.Active   => "bg-emerald-500",
        ProjectStatus.Planning => "bg-blue-500",
        ProjectStatus.Review   => "bg-amber-500",
        _                      => ""
    };

    private static string StatusLabelText(ProjectStatus status) => status switch
    {
        ProjectStatus.Active   => "Active",
        ProjectStatus.Planning => "Planning",
        ProjectStatus.Review   => "In review",
        _                      => ""
    };

    private enum ProjectStatus { Active, Planning, Review }

    private record Member(string Name, string Initials, string ProjectRole, int Allocation);

    private record Project(string Name, ProjectStatus Status, string Deadline, int Progress, Member[] Members);

    private static readonly Project[] _projects =
    [
        new("Dashboard Redesign", ProjectStatus.Active, "Apr 15", 68,
        [
            new("Sarah Chen",       "SC", "Tech Lead", 80),
            new("Elena Rodriguez",  "ER", "Designer",  100),
            new("David Kim",        "DK", "Frontend",  60),
        ]),
        new("API v3 Migration", ProjectStatus.Active, "May 2", 42,
        [
            new("Marcus Johnson",   "MJ", "Tech Lead", 100),
            new("James O'Brien",    "JO", "Backend",   80),
            new("Yuki Tanaka",      "YT", "QA",        40),
        ]),
        new("Mobile App Launch", ProjectStatus.Planning, "Jun 20", 15,
        [
            new("Aisha Patel",      "AP", "PM",        60),
            new("David Kim",        "DK", "Frontend",  40),
            new("Priya Sharma",     "PS", "Research",  30),
        ]),
        new("Security Audit", ProjectStatus.Review, "Mar 30", 92,
        [
            new("James O'Brien",    "JO", "Lead",      20),
            new("Marcus Johnson",   "MJ", "Reviewer",  10),
        ]),
    ];

    // Unique member count across all projects (mirrors the TSX Set logic)
    private static readonly int _totalMembers = new System.Collections.Generic.HashSet<string>(
        System.Linq.Enumerable.SelectMany(_projects, p => System.Linq.Enumerable.Select(p.Members, m => m.Name))
    ).Count;
}
