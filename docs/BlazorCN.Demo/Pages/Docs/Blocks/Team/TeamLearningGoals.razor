@* ============================================================
   Block: team-learning-goals
   Title: TeamLearningGoals
   Description: React team learning tracker with Next.js, shadcn/ui components, Tailwind CSS progress bars for L&D dashboards.
   Source: original/blocks/team/team-learning-goals.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Learning goals</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Q1 professional development tracking
            </p>
        </div>

        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <p class="text-xs text-muted-foreground">Active goals</p>
                <p class="mt-0.5 text-2xl font-semibold tabular-nums">@_totalGoals</p>
            </div>
            <div class="border-r px-4 py-3">
                <p class="text-xs text-muted-foreground">Completed</p>
                <p class="mt-0.5 text-2xl font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">
                    @_totalCompleted
                </p>
            </div>
            <div class="px-4 py-3">
                <p class="text-xs text-muted-foreground">Avg. progress</p>
                <p class="mt-0.5 text-2xl font-semibold tabular-nums">@_avgProgress%</p>
            </div>
        </div>

        <div>
            @for (var i = 0; i < _members.Length; i++)
            {
                var member = _members[i];
                var isLast = i == _members.Length - 1;
                var isExpanded = _expanded == member.Name;
                var memberAvg = (int)Math.Round(member.Goals.Average(g => g.Progress));
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : member.Name)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                            @member.Initials
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@member.Name</span>
                                <span class="text-xs text-muted-foreground">@member.Role</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="text-xs text-muted-foreground">
                                    @member.Goals.Length goals
                                </span>
                                <span class="text-xs text-muted-foreground">·</span>
                                <span class="text-xs text-muted-foreground">
                                    @member.CompletedThisQuarter completed
                                </span>
                            </div>
                        </div>
                        <span class="shrink-0 font-mono text-xs text-muted-foreground">
                            @memberAvg%
                        </span>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/20">
                            @for (var gi = 0; gi < member.Goals.Length; gi++)
                            {
                                var goal = member.Goals[gi];
                                var notLast = gi < member.Goals.Length - 1;
                                <div class="@Cn.Merge("px-4 py-2.5 pl-15", notLast ? "border-b" : "")">
                                    <div class="flex items-start justify-between gap-2">
                                        <div class="min-w-0 flex-1">
                                            <p class="text-sm font-medium">@goal.Title</p>
                                            <div class="mt-1 flex flex-wrap items-center gap-1.5">
                                                @foreach (var tag in goal.Tags)
                                                {
                                                    <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                                        @tag
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                        <span class="shrink-0 text-xs text-muted-foreground">
                                            @goal.Target
                                        </span>
                                    </div>
                                    <div class="mt-2 flex items-center gap-2">
                                        <div class="h-1.5 flex-1 rounded-full bg-muted">
                                            <div
                                                class="h-1.5 rounded-full bg-foreground/20"
                                                style="@($"width:{goal.Progress}%")">
                                            </div>
                                        </div>
                                        <span class="w-8 shrink-0 text-right font-mono text-xs text-muted-foreground">
                                            @goal.Progress%
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "Marcus Johnson";

    private record LearningGoal(string Title, int Progress, string Target, string[] Tags);
    private record TeamMember(string Name, string Role, string Initials, int CompletedThisQuarter, LearningGoal[] Goals);

    private static readonly TeamMember[] _members =
    [
        new("Sarah Chen", "Engineering Lead", "SC", 2,
        [
            new("System design patterns for distributed systems", 75, "Apr 30", ["Architecture", "Distributed"]),
            new("Leadership coaching certification", 40, "Jun 15", ["Leadership"]),
        ]),
        new("Marcus Johnson", "Backend Engineer", "MJ", 1,
        [
            new("Rust for systems programming", 60, "May 20", ["Rust", "Systems"]),
            new("AWS Solutions Architect certification", 30, "Jul 1", ["AWS", "Cloud"]),
            new("GraphQL schema design best practices", 90, "Apr 10", ["GraphQL", "API"]),
        ]),
        new("Elena Rodriguez", "Product Designer", "ER", 3,
        [
            new("Motion design with After Effects", 45, "May 30", ["Motion", "Animation"]),
            new("Accessibility audit and remediation", 80, "Apr 15", ["A11y"]),
        ]),
        new("David Kim", "Frontend Engineer", "DK", 1,
        [
            new("WebGL and shader programming", 25, "Jun 30", ["WebGL", "3D"]),
            new("Performance optimization for React apps", 65, "Apr 25", ["React", "Perf"]),
        ]),
        new("Aisha Patel", "Product Manager", "AP", 2,
        [
            new("Data-driven product decisions with SQL", 55, "May 15", ["SQL", "Analytics"]),
            new("Jobs-to-be-done framework mastery", 85, "Apr 5", ["JTBD", "Research"]),
        ]),
    ];

    private static readonly int _totalGoals = _members.Sum(m => m.Goals.Length);
    private static readonly int _totalCompleted = _members.Sum(m => m.CompletedThisQuarter);
    private static readonly int _avgProgress = (int)Math.Round(
        _members.SelectMany(m => m.Goals).Average(g => g.Progress));
}
