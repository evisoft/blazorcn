@* ============================================================
   Block: team-with-social
   Title: Team With Social
   Description: Team member rows with name, role, bio, and text social links in a flat bordered container
   Long Description: A clean, typography-driven team section that pairs each member with their social presence as simple text links
   Dependencies: None
   Source: original/blocks/team/team-with-social.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Team</p>
            <p class="mt-0.5 text-xs text-muted-foreground">The people building the product</p>
        </div>
        @foreach (var member in _members)
        {
            var links = GetSocialLinks(member);
            <div class="border-b px-4 py-3 last:border-b-0">
                <div class="flex items-start gap-3">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @member.Initials
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-baseline gap-2">
                            <span class="text-sm font-medium">@member.Name</span>
                            <span class="text-xs text-muted-foreground">@member.Role</span>
                        </div>
                        <p class="mt-1 text-xs leading-relaxed text-muted-foreground">@member.Bio</p>
                        @if (links.Length > 0)
                        {
                            <div class="mt-1.5 flex items-center gap-1">
                                @for (var i = 0; i < links.Length; i++)
                                {
                                    var link = links[i];
                                    @if (i > 0)
                                    {
                                        <span class="text-xs text-muted-foreground/40">&middot;</span>
                                    }
                                    <a href="@link.Href"
                                       class="text-xs text-muted-foreground underline-offset-2 hover:text-foreground hover:underline">
                                        @link.Label
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record TeamMember(string Name, string Role, string Bio, string Initials, string Github, string Twitter, string Linkedin);
    private record SocialLink(string Label, string Href);

    private static SocialLink[] GetSocialLinks(TeamMember member)
    {
        var links = new List<SocialLink>();
        if (!string.IsNullOrEmpty(member.Github)) links.Add(new("GitHub", member.Github));
        if (!string.IsNullOrEmpty(member.Twitter)) links.Add(new("Twitter", member.Twitter));
        if (!string.IsNullOrEmpty(member.Linkedin)) links.Add(new("LinkedIn", member.Linkedin));
        return links.ToArray();
    }

    private static readonly TeamMember[] _members =
    [
        new("Mia Thornton", "Co-Founder & CEO", "Former infrastructure lead at Stripe. Built payment APIs serving millions of businesses before founding the company.", "MT", "#", "#", "#"),
        new("Raj Kapoor", "VP of Engineering", "Spent eight years at Google building large-scale distributed systems. Leads platform architecture and engineering culture.", "RK", "#", "#", "#"),
        new("Nina Alexandrov", "Principal Designer", "Previously led design systems at Figma. Owns the component library, brand language, and end-to-end design process.", "NA", "", "#", "#"),
        new("James O'Brien", "Head of Growth", "Scaled Notion's developer community from zero to 500k. Drives acquisition strategy, content marketing, and partnerships.", "JO", "", "#", "#"),
        new("Lena Kowalski", "Staff Engineer", "Core contributor to React Server Components at Meta. Leads frontend platform, runtime optimization, and developer tooling.", "LK", "#", "#", ""),
        new("Hassan Al-Rashid", "Director of Product", "Shipped key enterprise features at Datadog driving 40% ARR growth. Translates customer needs into product roadmap priorities.", "HA", "#", "", "#"),
    ];
}
