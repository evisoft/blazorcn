@* ============================================================
   Block: team-podcasts
   Title: Team Podcasts
   Description: Team podcast appearances and media features with episode titles, speaker names, durations, and expandable episode descriptions
   Dependencies: LucideChevronRightCn, LucideMicCn
   Source: original/blocks/team/team-podcasts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium">Podcast appearances</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@_episodes.Length episodes across @_episodes.Select(e => e.SpeakerName).Distinct().Count() speakers</p>
                </div>
                <LucideMicCn Size="16" Class="size-4 text-muted-foreground" />
            </div>
        </div>

        <div>
            @for (var index = 0; index < _episodes.Length; index++)
            {
                var episode = _episodes[index];
                var isExpanded = _expanded == episode.Id;
                var isLast = index == _episodes.Length - 1;
                <div class="@Cn.Merge(!isLast ? "border-b" : "")">
                    <button type="button" @onclick="@(() => _expanded = isExpanded ? null : episode.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@episode.SpeakerInitials</div>
                        <div class="min-w-0 flex-1">
                            <p class="truncate text-sm font-medium">@episode.Title</p>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="truncate text-xs text-muted-foreground">@episode.Podcast</span>
                                <span class="text-muted-foreground text-xs">&middot;</span>
                                <span class="shrink-0 font-mono text-xs text-muted-foreground">@episode.Date</span>
                            </div>
                        </div>
                        <span class="hidden shrink-0 rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground sm:inline">@episode.Duration</span>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-[3.25rem]">
                            <p class="text-sm leading-relaxed text-muted-foreground">@episode.Description</p>
                            <div class="mt-2 flex items-center gap-2">
                                <span class="text-xs text-muted-foreground">@episode.SpeakerName</span>
                                <span class="text-muted-foreground text-xs">&middot;</span>
                                <span class="text-xs text-muted-foreground">@episode.Duration</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record EpisodeItem(string Id, string Title, string Podcast, string SpeakerName, string SpeakerInitials, string Date, string Duration, string Description);
    private static readonly EpisodeItem[] _episodes =
    [
        new("1", "Scaling design systems from 10 to 200 engineers", "Design Systems Podcast", "Anders Holm", "AH", "Mar 2026", "42 min", "Anders shares how the team evolved their component library from a scrappy collection of shared styles to a fully documented design system serving 14 product teams. Covers token architecture, contribution workflows, and the cultural shift needed to make a system succeed."),
        new("2", "Why we bet on edge computing early", "The Changelog", "Mei-Lin Wu", "MW", "Feb 2026", "58 min", "Mei-Lin discusses the technical decision to move critical path rendering to the edge in 2021, before it was industry standard. Covers the tradeoffs of edge databases, cache invalidation strategies, and how edge-first architecture reduced p99 latency by 73%."),
        new("3", "Building product sense as an engineering leader", "Lenny's Podcast", "Priya Kapoor", "PK", "Jan 2026", "65 min", "Priya talks about bridging the gap between engineering and product thinking. She walks through her framework for helping engineers develop product intuition, including her ritual of having every engineer talk to one customer per sprint."),
        new("4", "The referral loop that drives 40% of our growth", "Growth Unhinged", "Felix Brennan", "FB", "Dec 2025", "38 min", "Felix breaks down the mechanics of the team's referral system, from the initial incentive design to the viral coefficient optimization. Includes real numbers on conversion rates at each step and the experiments that doubled referral completion rates."),
        new("5", "Remote-first culture with 4 office hubs", "Distributed Work", "Ingrid Solberg", "IS", "Nov 2025", "44 min", "Ingrid explains the hybrid model that combines optional office hubs in Stockholm, San Francisco, Lagos, and Buenos Aires with a remote-first async culture. Covers how they handle timezone challenges, all-hands meetings, and maintaining team cohesion."),
        new("6", "Recommendation systems in two-sided marketplaces", "Data Engineering Podcast", "Yuki Tanaka", "YT", "Oct 2025", "51 min", "Yuki discusses the challenges of building recommendation algorithms for marketplaces where both supply and demand sides need optimization. Covers cold start problems, feedback loop biases, and how they measure recommendation quality beyond click-through rates."),
    ];
}
