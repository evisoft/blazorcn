@* ============================================================
   Block: team-skill-tags
   Title: Team Skill Tags
   Description: Team member rows with inline skill and technology chips showing expertise coverage
   Dependencies: None
   Source: original/blocks/team/team-skill-tags.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Team expertise</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Skills and technologies across the team</p>
        </div>

        @for (var i = 0; i < _members.Length; i++)
        {
            var member = _members[i];
            <div class="@Cn.Merge("flex flex-col gap-2 px-4 py-3 sm:flex-row sm:items-center sm:gap-4", i < _members.Length - 1 ? "border-b" : "")">
                <div class="flex items-center gap-3 sm:w-56 sm:shrink-0">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@member.Initials</div>
                    <div class="min-w-0">
                        <div class="text-sm font-medium">@member.Name</div>
                        <div class="text-xs text-muted-foreground">@member.Role</div>
                    </div>
                </div>
                <div class="flex flex-wrap gap-1.5">
                    @foreach (var skill in member.Skills)
                    {
                        <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@skill</span>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record MemberItem(string Name, string Role, string Initials, string[] Skills);
    private static readonly MemberItem[] _members =
    [
        new("Darian Reeves", "Staff Frontend Engineer", "DR", ["React", "TypeScript", "Next.js", "Tailwind CSS", "Storybook"]),
        new("Lina Petrova", "Backend Engineer", "LP", ["Node.js", "PostgreSQL", "GraphQL", "Redis", "Docker"]),
        new("Tomas Aguirre", "Full Stack Engineer", "TA", ["React", "Go", "AWS", "Terraform", "Prisma", "tRPC"]),
        new("Nia Okonkwo", "Product Designer", "NO", ["Figma", "Prototyping", "Design Systems", "User Research"]),
        new("Henrik Dahl", "DevOps Engineer", "HD", ["Kubernetes", "AWS", "CI/CD", "Monitoring", "Terraform"]),
        new("Aisha Farouk", "Machine Learning Engineer", "AF", ["Python", "PyTorch", "MLOps", "SQL", "Vector Databases"]),
    ];
}
