@* ============================================================
   Block: team-workload-overview
   Title: TeamWorkloadOverview
   Description: React capacity dashboard with utilization bars, story points, task counts built with shadcn/ui Progress and Tailwind CSS
   Source: original/blocks/team/team-workload-overview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Workload</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Current sprint capacity and utilization
            </p>
        </div>

        <div class="grid grid-cols-2 border-b sm:grid-cols-4">
            <div class="border-r px-4 py-3">
                <p class="text-xs text-muted-foreground">Avg. utilization</p>
                <p class="mt-0.5 text-2xl font-semibold tabular-nums">@_avgUtilization%</p>
            </div>
            <div class="px-4 py-3 sm:border-r">
                <p class="text-xs text-muted-foreground">Total tasks</p>
                <p class="mt-0.5 text-2xl font-semibold tabular-nums">@_totalTasks</p>
            </div>
            <div class="border-r border-t px-4 py-3 sm:border-t-0">
                <p class="text-xs text-muted-foreground">Story points</p>
                <p class="mt-0.5 text-2xl font-semibold tabular-nums">@_totalPoints</p>
            </div>
            <div class="border-t px-4 py-3 sm:border-t-0">
                <p class="text-xs text-muted-foreground">Overloaded</p>
                <p class="mt-0.5 text-2xl font-semibold tabular-nums text-red-600 dark:text-red-400">
                    @_overloadedCount
                </p>
            </div>
        </div>

        <div>
            @for (var i = 0; i < _members.Length; i++)
            {
                var member = _members[i];
                var barWidth = Math.Min(member.Utilization, 100);
                <div class="@Cn.Merge("px-4 py-3", i < _members.Length - 1 ? "border-b" : "")">
                    <div class="flex items-center gap-3">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", StatusColor(member.Status))" />
                        <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                            @member.Initials
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@member.Name</span>
                                <span class="text-xs text-muted-foreground">@member.Role</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="text-xs text-muted-foreground">@member.Tasks tasks</span>
                            <span class="text-xs text-muted-foreground">·</span>
                            <span class="text-xs text-muted-foreground">@member.StoryPoints pts</span>
                            <span class="w-10 text-right font-mono text-xs font-medium tabular-nums">
                                @member.Utilization%
                            </span>
                        </div>
                    </div>
                    <div class="mt-2 ml-[3.25rem] h-1.5 rounded-full bg-muted">
                        <div class="@Cn.Merge("h-1.5 rounded-full", BarColor(member.Status))" style="@($"width: {barWidth}%")"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum CapacityStatus { Optimal, High, Overloaded, Low }

    private record TeamMember(string Name, string Role, string Initials, int Utilization, int Tasks, int StoryPoints, CapacityStatus Status);

    private static readonly TeamMember[] _members =
    [
        new("Sarah Chen", "Engineering Lead", "SC", 85, 6, 21, CapacityStatus.High),
        new("Marcus Johnson", "Backend Engineer", "MJ", 110, 9, 34, CapacityStatus.Overloaded),
        new("Elena Rodriguez", "Frontend Engineer", "ER", 72, 5, 18, CapacityStatus.Optimal),
        new("David Kim", "Full Stack Engineer", "DK", 95, 7, 26, CapacityStatus.High),
        new("Aisha Patel", "Product Designer", "AP", 60, 4, 13, CapacityStatus.Optimal),
        new("James O'Brien", "DevOps Engineer", "JO", 105, 8, 29, CapacityStatus.Overloaded),
        new("Yuki Tanaka", "QA Engineer", "YT", 40, 3, 8, CapacityStatus.Low),
        new("Priya Sharma", "Data Analyst", "PS", 78, 5, 16, CapacityStatus.Optimal),
    ];

    private static readonly int _avgUtilization = (int)Math.Round(_members.Average(m => (double)m.Utilization));
    private static readonly int _totalTasks = _members.Sum(m => m.Tasks);
    private static readonly int _totalPoints = _members.Sum(m => m.StoryPoints);
    private static readonly int _overloadedCount = _members.Count(m => m.Status == CapacityStatus.Overloaded);

    private static string StatusColor(CapacityStatus status) => status switch
    {
        CapacityStatus.Optimal => "bg-emerald-500",
        CapacityStatus.High => "bg-amber-500",
        CapacityStatus.Overloaded => "bg-red-500",
        CapacityStatus.Low => "bg-blue-500",
        _ => ""
    };

    private static string BarColor(CapacityStatus status) => status switch
    {
        CapacityStatus.Optimal => "bg-emerald-500/30",
        CapacityStatus.High => "bg-amber-500/30",
        CapacityStatus.Overloaded => "bg-red-500/30",
        CapacityStatus.Low => "bg-blue-500/30",
        _ => ""
    };
}
