@* ============================================================
   Block: team-member-code-review-expert
   Title: TeamMemberCodeReviewExpert
   Description: A code review expertise and assignment block for React and Next.js showing team expertise areas and PR review assignments built with shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-member-code-review-expert.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="space-y-4">
        @* Header *@
        <div>
            <h2 class="text-sm font-medium">Code Review Experts</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Find the right reviewer for your PR
            </p>
        </div>

        @* Reviewer Cards *@
        <div class="space-y-3">
            @foreach (var reviewer in _reviewers)
            {
                <div class="overflow-hidden rounded-lg border bg-card">
                    <div class="px-4 py-3">
                        <div class="mb-2 flex items-center justify-between">
                            <h3 class="text-sm font-medium">@reviewer.Name</h3>
                            <BadgeCn Variant="@(reviewer.Availability == "available" ? BadgeVariant.Secondary : BadgeVariant.Outline)" Class="text-xs">
                                <span class="@Cn.Merge("mr-1.5 size-1.5 rounded-full", reviewer.Availability == "available" ? "bg-emerald-500" : "bg-amber-500")"></span>
                                @(reviewer.Availability == "available" ? "Available" : "Busy")
                            </BadgeCn>
                        </div>

                        @* Expertise Tags *@
                        <div class="mb-3 flex flex-wrap gap-1.5">
                            @foreach (var exp in reviewer.Expertise)
                            {
                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs font-normal">@exp</BadgeCn>
                            }
                        </div>

                        @* Reviews This Week *@
                        <div class="mb-3 flex items-center gap-2 text-xs text-muted-foreground border-t pt-3">
                            <LucideIconCn Name="git-pull-request" Size="12" Class="size-3" />
                            <span>@reviewer.ReviewsThisWeek reviews this week</span>
                        </div>

                        @* Action Button *@
                        <ButtonCn Size="ButtonSize.Sm" Class="w-full text-xs" disabled="@(reviewer.Availability == "busy")">
                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                            Assign Review
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ReviewExpertise(string Id, string Name, string[] Expertise, int ReviewsThisWeek, string Availability);

    private static readonly ReviewExpertise[] _reviewers =
    [
        new("1", "Marcus Rodriguez", ["Backend", "Database", "API Design", "Performance"], 3, "available"),
        new("2", "Emily Watson", ["Frontend", "React", "CSS", "Accessibility"], 5, "busy"),
        new("3", "Sarah Chen", ["Product Logic", "Testing", "Architecture"], 2, "available"),
    ];
}
