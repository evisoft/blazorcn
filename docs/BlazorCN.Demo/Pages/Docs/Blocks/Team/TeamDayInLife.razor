@* ============================================================
   Block: team-day-in-life
   Title: Team Day In Life
   Description: Day in the life snapshots with selectable team members and vertical timeline of daily activities showing schedule and work routines
   Dependencies: None
   Source: original/blocks/team/team-day-in-life.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">A day in the life</p>
            <p class="mt-0.5 text-xs text-muted-foreground">See what a typical day looks like for our team</p>
        </div>

        <div class="flex gap-2 overflow-x-auto border-b px-4 py-3">
            @for (var mi = 0; mi < _members.Length; mi++)
            {
                var idx = mi;
                var m = _members[idx];
                <button type="button" @onclick="@(() => _selectedMember = idx)"
                        class="@Cn.Merge("flex shrink-0 items-center gap-2 rounded-md px-2.5 py-1.5 text-left transition-colors", _selectedMember == idx ? "bg-muted" : "hover:bg-muted/50")">
                    <div class="flex size-6 items-center justify-center rounded-full bg-muted text-[10px] font-medium">@m.Initials</div>
                    <div>
                        <p class="text-xs font-medium">@m.Name</p>
                        <p class="text-[10px] text-muted-foreground">@m.Role</p>
                    </div>
                </button>
            }
        </div>

        <div class="border-b px-4 py-2.5">
            <div class="flex flex-wrap items-center gap-3">
                @foreach (var legend in _legend)
                {
                    <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                        <span class="@Cn.Merge("size-1.5 rounded-full", legend.DotClass)"></span>
                        @legend.Label
                    </span>
                }
            </div>
        </div>

        <div>
            @{ var member = _members[_selectedMember]; }
            @for (var i = 0; i < member.Schedule.Length; i++)
            {
                var item = member.Schedule[i];
                var isLast = i == member.Schedule.Length - 1;
                <div class="@Cn.Merge("flex gap-3 px-4 py-3", !isLast ? "border-b" : "")">
                    <div class="flex flex-col items-center pt-0.5">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", GetTypeDot(item.Type))"></span>
                        @if (!isLast)
                        {
                            <div class="mt-1.5 w-px flex-1 bg-border"></div>
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="shrink-0 font-mono text-xs text-muted-foreground">@item.Time</span>
                            <span class="text-sm font-medium">@item.Activity</span>
                        </div>
                        <p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">@item.Description</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private int _selectedMember;

    private static string GetTypeDot(string type) => type switch
    {
        "meeting" => "bg-blue-500",
        "focus" => "bg-emerald-500",
        "break" => "bg-amber-500",
        "social" => "bg-purple-500",
        "admin" => "bg-foreground/40",
        _ => "bg-foreground/40",
    };

    private record LegendItem(string Label, string DotClass);
    private static readonly LegendItem[] _legend =
    [
        new("Meeting", "bg-blue-500"),
        new("Focus", "bg-emerald-500"),
        new("Break", "bg-amber-500"),
        new("Social", "bg-purple-500"),
        new("Admin", "bg-foreground/40"),
    ];

    private record ScheduleItem(string Time, string Activity, string Description, string Type);
    private record MemberItem(string Name, string Initials, string Role, ScheduleItem[] Schedule);

    private static readonly MemberItem[] _members =
    [
        new("Mei-Lin Wu", "MW", "Staff Engineer",
        [
            new("8:30 AM", "Morning review", "Check overnight alerts, review open PRs, triage any P0 issues from the on-call channel.", "admin"),
            new("9:00 AM", "Engineering standup", "15-minute async-first standup. Post written update, then jump on a 5-minute sync for blockers only.", "meeting"),
            new("9:30 AM", "Deep work: system design", "Two-hour uninterrupted block for architecture work. Currently designing the new event streaming pipeline.", "focus"),
            new("11:30 AM", "Code review session", "Review 3-4 PRs from the platform team. Focus on API contracts and performance implications.", "focus"),
            new("12:30 PM", "Lunch break", "Walk to the taqueria two blocks away. Usually with someone from the design team.", "break"),
            new("1:30 PM", "1:1 with engineering manager", "Weekly 30-minute check-in. Discuss career growth, team dynamics, and technical strategy.", "meeting"),
            new("2:00 PM", "Pairing session", "Pair programming with a junior engineer on edge caching implementation. Teaching through building.", "social"),
            new("3:30 PM", "Deep work: implementation", "Heads-down coding on the streaming pipeline. Slack notifications off, editor in zen mode.", "focus"),
            new("5:30 PM", "End of day", "Push work-in-progress branch, write a brief progress note in Linear, sign off for the day.", "admin"),
        ]),
        new("Priya Kapoor", "PK", "VP of Product",
        [
            new("8:00 AM", "Metrics review", "Check daily product metrics dashboard. Look for anomalies in activation, retention, and revenue.", "admin"),
            new("8:30 AM", "Product leadership sync", "30-minute alignment with product managers on weekly priorities and cross-team dependencies.", "meeting"),
            new("9:00 AM", "Customer interview", "45-minute call with enterprise customer about their workflow pain points. Take structured notes.", "meeting"),
            new("10:00 AM", "Strategy document writing", "Write or refine product strategy documents. Currently drafting the H2 2026 roadmap narrative.", "focus"),
            new("12:00 PM", "Team lunch", "Weekly all-product-team lunch. Rotating restaurants. No work talk allowed.", "social"),
            new("1:00 PM", "Design review", "Review new feature mocks with design and engineering leads. Focus on user flows and edge cases.", "meeting"),
            new("2:30 PM", "1:1 with PM", "Coaching session with product manager. Review their spec, discuss stakeholder management.", "meeting"),
            new("3:30 PM", "Deep work: prioritization", "Score and stack-rank feature requests. Cross-reference with customer interview insights.", "focus"),
            new("5:00 PM", "Wrap up", "Send daily digest to leadership team. Prep agenda for tomorrow's meetings.", "admin"),
        ]),
        new("Anders Holm", "AH", "VP of Design",
        [
            new("9:00 AM", "Portfolio review", "Scan Figma activity from the design team. Leave async feedback on in-progress explorations.", "admin"),
            new("9:30 AM", "Design critique", "Team critique session. One designer presents, everyone gives structured feedback. No solutioning.", "meeting"),
            new("10:30 AM", "Deep work: design system", "Work on the next wave of design tokens. Currently harmonizing spacing scale across mobile and web.", "focus"),
            new("12:00 PM", "Lunch and sketch", "Eat at desk while sketching ideas in a physical notebook. Analog thinking time.", "break"),
            new("1:00 PM", "Cross-functional review", "Present design direction to engineering leads. Discuss feasibility and implementation tradeoffs.", "meeting"),
            new("2:00 PM", "1:1 with designer", "Career development conversation. Review portfolio pieces and discuss growth areas.", "social"),
            new("2:30 PM", "Prototyping", "Build interactive prototype for the new onboarding flow. Test micro-interactions and transitions.", "focus"),
            new("4:30 PM", "Design ops", "Update component documentation, review contribution PRs to the design system library.", "admin"),
            new("5:30 PM", "End of day", "Archive completed Figma branches, move cards on the kanban board, sign off.", "admin"),
        ]),
    ];
}
