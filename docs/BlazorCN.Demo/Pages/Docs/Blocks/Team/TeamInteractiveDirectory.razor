@* ============================================================
   Block: team-interactive-directory
   Title: Team Interactive Directory
   Description: Searchable and filterable team directory with department filter tabs and text search
   Dependencies: LucideSearchCn, LucideUsersCn, ButtonCn
   Source: original/blocks/team/team-interactive-directory.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideUsersCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Team directory</span>
                <span class="ml-auto text-xs text-muted-foreground">@_filtered.Length @(_filtered.Length == 1 ? "member" : "members")</span>
            </div>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-3">
            <div class="relative flex-1">
                <LucideSearchCn Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <input type="text" placeholder="Search by name or role..." @bind="_search" @bind:event="oninput"
                       class="h-8 w-full border-0 bg-transparent pl-8 text-sm shadow-none outline-none placeholder:text-muted-foreground focus-visible:ring-0" />
            </div>
            <select @bind="_department" class="h-8 w-40 rounded-md border bg-background px-2 text-xs">
                <option value="all">All Departments</option>
                @foreach (var dept in _departments)
                {
                    <option value="@dept">@dept</option>
                }
            </select>
        </div>

        @if (_filtered.Length > 0)
        {
            <div>
                @for (var i = 0; i < _filtered.Length; i++)
                {
                    var member = _filtered[i];
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", i < _filtered.Length - 1 ? "border-b" : "")">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@member.Initials</div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate text-sm font-medium">@member.Name</span>
                                <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@member.Department</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="truncate text-xs text-muted-foreground">@member.Role</span>
                                <span class="text-xs text-muted-foreground/60">@member.Location</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="flex flex-col items-center justify-center px-4 py-12 text-center">
                <LucideUsersCn Size="20" Class="mb-2 size-5 text-muted-foreground" />
                <span class="text-sm font-medium">No members found</span>
                <span class="mt-1 text-xs text-muted-foreground">Try adjusting your search or filter.</span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-3 h-7 text-xs" @onclick="ResetFilters">
                    Reset Filters
                </ButtonCn>
            </div>
        }
    </div>
</section>

@code {
    private string _search = "";
    private string _department = "all";

    private static readonly string[] _departments = ["Engineering", "Design", "Marketing", "Sales"];

    private MemberItem[] _filtered => _members.Where(m =>
    {
        var matchesSearch = string.IsNullOrEmpty(_search) ||
            m.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            m.Role.Contains(_search, StringComparison.OrdinalIgnoreCase);
        var matchesDept = _department == "all" || m.Department == _department;
        return matchesSearch && matchesDept;
    }).ToArray();

    private void ResetFilters()
    {
        _search = "";
        _department = "all";
    }

    private record MemberItem(string Name, string Role, string Department, string Location, string Initials);
    private static readonly MemberItem[] _members =
    [
        new("Zara Ahmed", "Staff Software Engineer", "Engineering", "San Francisco, CA", "ZA"),
        new("Kenji Watanabe", "Senior Frontend Engineer", "Engineering", "Tokyo, Japan", "KW"),
        new("Camila Reyes", "Engineering Manager", "Engineering", "Buenos Aires, Argentina", "CR"),
        new("Tobias Muller", "Head of Design", "Design", "Berlin, Germany", "TM"),
        new("Yolanda Osei", "Senior Product Designer", "Design", "London, UK", "YO"),
        new("Devi Chandrasekaran", "UX Researcher", "Design", "Bangalore, India", "DC"),
        new("Marcus Bell", "VP of Marketing", "Marketing", "New York, NY", "MB"),
        new("Aaliya Rahman", "Content Marketing Lead", "Marketing", "Toronto, Canada", "AR"),
        new("Henrik Johansson", "Growth Marketing Manager", "Marketing", "Stockholm, Sweden", "HJ"),
        new("Priya Sharma", "Head of Sales", "Sales", "Singapore", "PS"),
        new("Lucas Fernandez", "Enterprise Account Executive", "Sales", "Chicago, IL", "LF"),
        new("Amara Okafor", "Solutions Engineer", "Sales", "Lagos, Nigeria", "AO"),
    ];
}
