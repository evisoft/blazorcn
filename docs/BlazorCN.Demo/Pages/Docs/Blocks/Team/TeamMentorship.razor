@* ============================================================
   Block: team-mentorship
   Title: Team Mentorship
   Description: Mentorship program display showing mentor-mentee pairs with initials, names, roles, and focus areas
   Dependencies: none (pure HTML/Tailwind)
   Source: original/blocks/team/team-mentorship.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Mentorship program</p>
            <p class="mt-0.5 text-xs text-muted-foreground">@_pairs.Length active pairs</p>
        </div>
        @foreach (var pair in _pairs)
        {
            var isExpanded = _expanded == pair.Id;
            <div class="border-b last:border-b-0">
                <button type="button"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => _expanded = isExpanded ? null : pair.Id)">
                    <div class="flex shrink-0 items-center gap-1.5">
                        <div class="flex size-8 items-center justify-center rounded-full bg-muted text-xs font-medium">
                            @pair.MentorInitials
                        </div>
                        <LucideArrowRightCn Size="12" Class="size-3 text-muted-foreground/60" />
                        <div class="flex size-8 items-center justify-center rounded-full bg-muted text-xs font-medium">
                            @pair.MenteeInitials
                        </div>
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-baseline gap-1">
                            <span class="truncate text-sm font-medium">@pair.MentorName</span>
                            <LucideArrowRightCn Size="12" Class="hidden size-3 shrink-0 text-muted-foreground/60 sm:inline-block" />
                            <span class="hidden truncate text-sm font-medium sm:inline">
                                @pair.MenteeName
                            </span>
                        </div>
                        <div class="mt-0.5 flex items-center gap-1.5">
                            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                @pair.FocusArea
                            </span>
                            <span class="hidden text-xs text-muted-foreground sm:inline">
                                since @pair.StartedAt
                            </span>
                        </div>
                    </div>
                    <LucideChevronRightCn Size="16"
                                          Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                </button>
                @if (isExpanded)
                {
                    <div class="border-t bg-muted/30 px-4 py-3">
                        <div class="ml-[4.75rem] space-y-2">
                            <div class="flex items-center gap-4 text-xs text-muted-foreground">
                                <div>
                                    <span class="font-medium text-foreground">@pair.MentorName</span>
                                    <span class="mx-1">&middot;</span>
                                    <span>@pair.MentorRole</span>
                                </div>
                            </div>
                            <div class="flex items-center gap-4 text-xs text-muted-foreground">
                                <div>
                                    <span class="font-medium text-foreground">@pair.MenteeName</span>
                                    <span class="mx-1">&middot;</span>
                                    <span>@pair.MenteeRole</span>
                                </div>
                            </div>
                            <div class="rounded-md bg-muted/50 p-3">
                                <p class="text-xs font-medium text-muted-foreground">Goals</p>
                                <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
                                    @pair.Goals
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record MentorshipPair(string Id, string MentorName, string MentorInitials, string MentorRole,
        string MenteeName, string MenteeInitials, string MenteeRole, string FocusArea, string Goals, string StartedAt);

    private string? _expanded;

    private static readonly MentorshipPair[] _pairs =
    [
        new("pair-1", "Kofi Asante", "KA", "CTO", "Jordan Ellis", "JE", "Senior Engineer",
            "System design", "Building expertise in distributed systems architecture and leading technical design reviews for cross-team initiatives.", "Jan 2026"),
        new("pair-2", "Lucia Fernandez", "LF", "VP of Design", "Anh Nguyen", "AN", "Product Designer",
            "Design leadership", "Developing skills in design strategy, stakeholder management, and leading a small design team for the platform product.", "Nov 2025"),
        new("pair-3", "Maren Lindqvist", "ML", "CEO", "Ravi Mehta", "RM", "VP of Product",
            "Executive presence", "Strengthening board communication, investor relations skills, and cross-functional leadership at the executive level.", "Sep 2025"),
        new("pair-4", "Aarav Sharma", "AS", "Head of Engineering", "Maya Chen", "MC", "Software Engineer",
            "Backend architecture", "Deep dive into event-driven architecture patterns, database optimization, and preparing for the staff engineer promotion track.", "Feb 2026"),
        new("pair-5", "Elise Beaumont", "EB", "VP of Product", "Diego Herrera", "DH", "Product Manager",
            "Career growth", "Transitioning from feature-level PM work to platform product strategy and building data-driven decision frameworks.", "Dec 2025"),
        new("pair-6", "Tomoko Nakamura", "TN", "Head of Data", "Sofia Martinez", "SM", "Data Analyst",
            "Machine learning", "Moving from analytics into applied ML, focusing on recommendation systems and production model deployment pipelines.", "Jan 2026"),
    ];
}
