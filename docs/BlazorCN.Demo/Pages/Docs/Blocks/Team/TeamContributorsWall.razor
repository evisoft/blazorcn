@* ============================================================
   Block: team-contributors-wall
   Title: Team Contributors Wall
   Description: Dense grid of contributor initials with names and contribution counts in a connected border pattern
   Long Description: Clean avatar row with names and titles
   Dependencies: None
   Source: original/blocks/team/team-contributors-wall.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Contributors</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Built by the community</p>
        </div>
        <div class="flex items-center justify-between border-b px-4 py-3">
            @for (var i = 0; i < _stats.Length; i++)
            {
                var stat = _stats[i];
                <div class="flex items-center gap-3">
                    @if (i > 0)
                    {
                        <span class="size-1 rounded-full bg-border"></span>
                    }
                    <div class="text-center">
                        <p class="text-sm font-medium tabular-nums">@stat.Value</p>
                        <p class="text-xs text-muted-foreground">@stat.Label</p>
                    </div>
                </div>
            }
        </div>
        <div class="grid grid-cols-6 gap-px bg-border sm:grid-cols-8">
            @foreach (var contributor in _contributors)
            {
                <div class="flex flex-col items-center gap-1 bg-card px-1 py-3">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @contributor.Initials
                    </div>
                    <p class="max-w-full truncate text-center text-xs text-muted-foreground">
                        @contributor.Name.Split(' ')[0]
                    </p>
                    <p class="text-center text-xs tabular-nums text-muted-foreground/60">
                        @contributor.Contributions
                    </p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Stat(string Label, string Value);
    private record Contributor(string Name, string Initials, int Contributions);

