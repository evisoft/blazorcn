        new("Marcus Johnson", "VP of Engineering", "MJ", "Engineering",
            "Former Staff Engineer at Google leading distributed systems for Cloud Spanner. Scaled engineering from 40 to 200 engineers at Datadog."),
        new("Elena Rodriguez", "Principal Designer", "ER", "Design",
            "Built the design system at Figma before joining as first designer. Seven years of experience creating interfaces that reduce cognitive load."),
        new("David Kim", "Head of Product", "DK", "Product",
            "Shipped enterprise features at Datadog that drove 40% ARR growth. Expert in translating customer pain points into roadmap priorities."),
        new("Priya Sharma", "Staff Engineer", "PS", "Engineering",
            "Core contributor to React Server Components at Meta. Leads the frontend platform team and runtime performance optimization efforts."),
        new("James O'Brien", "Head of Growth", "JO", "Marketing",
            "Grew Notion's PLG motion from Series A to IPO. Deep expertise in product-led acquisition funnels and developer community building."),
        new("Aisha Patel", "Senior Security Engineer", "AP", "Engineering",
