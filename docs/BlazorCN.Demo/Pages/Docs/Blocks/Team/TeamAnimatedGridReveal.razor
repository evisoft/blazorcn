@* ============================================================
   Block: team-animated-grid-reveal
   Title: Team Animated Grid Reveal
   Description: Animated team grid with staggered entrance, scale transitions, and hover lift effects using framer-motion for a React team section
   Long Description: A polished team grid that makes a strong first impression with purposeful motion. Eight team members stagger into view with a cascading opacity and scale animation, each cell lifting subtly on hover to invite interaction. Click any member to reveal their bio in a smooth height animation powered by framer-motion AnimatePresence. Built with React, TypeScript, Tailwind CSS, and framer-motion for production-ready team pages that feel as refined as Vercel and Linear.
   Dependencies: None
   Source: original/blocks/team/team-animated-grid-reveal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Team</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_members.Length people building the future of developer tools
            </p>
        </div>
        <div class="grid grid-cols-2">
            @for (var i = 0; i < _members.Length; i++)
            {
                var member = _members[i];
                var isExpanded = _expanded == member.Name;
                var isRightColumn = i % 2 == 1;
                var row = i / 2;
                var isLastRow = row == (int)Math.Ceiling((double)_members.Length / 2) - 1;
                <div class="@Cn.Merge(!isLastRow ? "border-b" : "", !isRightColumn ? "border-r" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : member.Name)"
                        class="w-full px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex items-center gap-2.5">
                            <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                                @member.Initials
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="truncate text-sm font-medium">@member.Name</p>
                                <p class="truncate text-xs text-muted-foreground">@member.Role</p>
                            </div>
                        </div>
                        <div class="mt-2">
                            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                @member.Department
                            </span>
                        </div>
                    </button>
                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="border-t bg-muted/30 px-4 py-3">
                                <p class="text-xs text-muted-foreground leading-relaxed">
                                    @member.Bio
                                </p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record MemberItem(string Name, string Role, string Initials, string Department, string Bio);

    private static readonly MemberItem[] _members =
    [
        new("Sarah Chen", "Chief Executive Officer", "SC", "Leadership",
