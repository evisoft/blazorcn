@* ============================================================
   Block: team-animated-skills
   Title: Team Animated Skills
   Description: Team member skill bars with percentage reveals on hover
   Long Description: Team certifications and credentials display
   Dependencies: None
   Source: original/blocks/team/team-animated-skills.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Team skills</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Core competencies across the team</p>
        </div>

        @foreach (var member in _members)
        {
            <div class="border-b px-4 py-3 last:border-b-0">
                <div class="flex items-center gap-3">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @member.Initials
                    </div>
                    <div class="min-w-0">
                        <p class="text-sm font-medium">@member.Name</p>
                        <p class="text-xs text-muted-foreground">@member.Role</p>
                    </div>
                </div>

                <div class="mt-3 space-y-2 pl-11">
                    @foreach (var skill in member.Skills)
                    {
                        <div class="group">
                            <div class="mb-1 flex items-center justify-between">
                                <span class="text-xs text-muted-foreground">@skill.Name</span>
                                <span class="text-xs tabular-nums text-muted-foreground opacity-0 transition-opacity group-hover:opacity-100">
                                    @skill.Level%
                                </span>
                            </div>
                            <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                                <div class="h-full rounded-full bg-foreground/70" style="@($"width: {skill.Level}%")"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Skill(string Name, int Level);
    private record TeamMember(string Name, string Role, string Initials, Skill[] Skills);

    private static readonly TeamMember[] _members =
    [
        new("Elena Voskresenskaya", "VP of Engineering", "EV", [new("System Design", 95), new("TypeScript", 90), new("Leadership", 92), new("Go", 78)]),
        new("Marcus Chen", "Head of Design", "MC", [new("Figma", 96), new("Design Systems", 91), new("Prototyping", 88), new("User Research", 82)]),
        new("James Nakamura", "Principal Engineer", "JN", [new("React", 94), new("TypeScript", 92), new("Node.js", 85), new("PostgreSQL", 79)]),
        new("Clara Svensson", "Product Manager", "CS", [new("Strategy", 90), new("Analytics", 86), new("SQL", 72)]),
        new("Tomas Herrera", "Senior Engineer", "TH", [new("React", 91), new("Next.js", 88), new("Tailwind CSS", 93), new("Testing", 76)]),
    ];
}
