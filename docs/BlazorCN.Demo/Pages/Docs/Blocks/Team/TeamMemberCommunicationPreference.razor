@* ============================================================
   Block: team-member-communication-preference
   Title: TeamMemberCommunicationPreference
   Description: A communication preference tracking block for React and Next.js displaying communication styles built with shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-member-communication-preference.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="space-y-4">
        <div>
            <h2 class="text-sm font-medium">Communication Preferences</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                How to reach team members effectively
            </p>
        </div>

        <div class="space-y-4">
            @foreach (var member in _team)
            {
                <div class="rounded-lg border bg-card p-4">
                    <h3 class="mb-3 text-sm font-medium">@member.Name</h3>
                    <div class="space-y-2 mb-3">
                        @foreach (var pref in member.Preferences)
                        {
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-medium text-muted-foreground">
                                    @pref.Channel
                                </span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                                    @pref.ResponseTime
                                </BadgeCn>
                            </div>
                        }
                    </div>
                    <div class="border-t pt-2">
                        <p class="text-xs text-muted-foreground">
                            ⏱️ Do not disturb: @member.DoNotDisturb
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record CommunicationPref(string Channel, string ResponseTime);

    private record TeamMember(string Name, CommunicationPref[] Preferences, string DoNotDisturb);

    private static readonly TeamMember[] _team =
    [
        new("Sarah Chen",
            [
                new("Slack (urgent)", "Within 1 hour"),
                new("Email (non-urgent)", "Within 24 hours"),
                new("Meeting invite", "Within 1 week"),
            ],
            "Before 9am and after 6pm"),
        new("Marcus Rodriguez",
            [
                new("Email (async preferred)", "Within 48 hours"),
                new("GitHub issues", "Within 24 hours"),
            ],
            "Weekends and 2-5pm focus time"),
    ];
}
