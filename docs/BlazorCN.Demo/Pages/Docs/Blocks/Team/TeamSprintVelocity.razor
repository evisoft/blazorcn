@* ============================================================
   Block: team-sprint-velocity
   Title: TeamSprintVelocity
   Description: React sprint velocity dashboard with story points, completion rates, and team contributions using shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-sprint-velocity.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium">@_currentSprint.Name</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_currentSprint.StartDate - @_currentSprint.EndDate
                    </p>
                </div>
                <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                    @_currentSprint.CompletedTasks/@_currentSprint.TotalTasks tasks
                </span>
            </div>
        </div>

        <div class="grid grid-cols-2 border-b sm:grid-cols-4">
            <div class="border-r px-4 py-3">
                <p class="text-xs text-muted-foreground">Delivered</p>
                <p class="mt-0.5 text-2xl font-semibold tabular-nums">
                    @_currentSprint.DeliveredPoints
                    <span class="text-xs font-normal text-muted-foreground">
                        /@_currentSprint.PlannedPoints
                    </span>
                </p>
            </div>
            <div class="px-4 py-3 sm:border-r">
                <p class="text-xs text-muted-foreground">Completion</p>
                <p class="mt-0.5 text-2xl font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">
                    @_currentSprint.CompletionRate%
                </p>
            </div>
            <div class="border-r border-t px-4 py-3 sm:border-t-0">
                <p class="text-xs text-muted-foreground">Carry-over</p>
                <p class="mt-0.5 text-2xl font-semibold tabular-nums text-amber-600 dark:text-amber-400">
                    @_currentSprint.CarryOver
                </p>
            </div>
            <div class="border-t px-4 py-3 sm:border-t-0">
                <p class="text-xs text-muted-foreground">Team size</p>
                <p class="mt-0.5 text-2xl font-semibold tabular-nums">@_members.Length</p>
            </div>
        </div>

        <div class="border-b px-4 py-2.5">
            <p class="text-xs font-medium text-muted-foreground">Velocity history</p>
        </div>

        <div class="flex items-end gap-1 border-b px-4 py-3">
            @foreach (var sprint in _sprintHistory)
            {
                var height = (int)Math.Round((double)sprint.Delivered / _maxDelivered * 48);
                var plannedHeight = (int)Math.Round((double)sprint.Planned / _maxDelivered * 48);
                <div class="flex flex-1 flex-col items-center gap-1">
                    <div class="flex items-end gap-0.5" style="height:48px">
                        <div class="w-3 rounded-sm bg-muted" style="@($"height:{plannedHeight}px")"></div>
                        <div class="w-3 rounded-sm bg-foreground/20" style="@($"height:{height}px")"></div>
                    </div>
                    <span class="text-xs text-muted-foreground">@sprint.Label</span>
                </div>
            }
        </div>

        <div class="border-b px-4 py-2.5">
            <p class="text-xs font-medium text-muted-foreground">Individual contributions</p>
        </div>

        <div>
            @for (var i = 0; i < _members.Length; i++)
            {
                var member = _members[i];
                var isExpanded = _expanded == member.Name;
                var isLast = i == _members.Length - 1;
                var barWidth = (int)Math.Round((double)member.PointsDelivered / _maxMemberPoints * 100);
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : member.Name)"
                        class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                        <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                            @member.Initials
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@member.Name</span>
                            <div class="mt-1 flex items-center gap-2">
                                <div class="h-1 w-20 rounded-full bg-muted">
                                    <div
                                        class="h-1 rounded-full bg-foreground/20"
                                        style="@($"width:{barWidth}%")">
                                    </div>
                                </div>
                                <span class="font-mono text-xs text-muted-foreground">
                                    @member.PointsDelivered pts
                                </span>
                            </div>
                        </div>
                        <LucideIconCn
                            Name="chevron-right"
                            Size="16"
                            Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>
                    @if (isExpanded)
                    {
                        var ptsPerTask = ((double)member.PointsDelivered / member.TasksCompleted).ToString("F1");
                        <div class="flex items-center gap-4 border-t bg-muted/20 px-4 py-2.5 pl-14">
                            <span class="text-xs text-muted-foreground">@member.Role</span>
                            <span class="text-xs text-muted-foreground">·</span>
                            <span class="text-xs text-muted-foreground">@member.TasksCompleted tasks</span>
                            <span class="text-xs text-muted-foreground">·</span>
                            <span class="text-xs text-muted-foreground">@member.PrsMerged PRs merged</span>
                            <span class="text-xs text-muted-foreground">·</span>
                            <span class="font-mono text-xs text-muted-foreground">@ptsPerTask pts/task</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private const int _maxDelivered = 60;
    private const int _maxMemberPoints = 13;

    private record SprintData(string Label, int Planned, int Delivered);

    private record TeamMember(string Name, string Initials, string Role, int PointsDelivered, int TasksCompleted, int PrsMerged);

    private record SprintInfo(
        string Name,
        string StartDate,
        string EndDate,
        int PlannedPoints,
        int DeliveredPoints,
        int CompletionRate,
        int CarryOver,
        int TotalTasks,
        int CompletedTasks);

    private static readonly SprintInfo _currentSprint = new(
        "Sprint 24",
        "Mar 11",
        "Mar 24",
        64,
        58,
        91,
        3,
        28,
        25);

    private static readonly SprintData[] _sprintHistory =
    [
        new("S19", 55, 48),
        new("S20", 60, 56),
        new("S21", 58, 58),
        new("S22", 62, 54),
        new("S23", 60, 59),
        new("S24", 64, 58),
    ];

    private static readonly TeamMember[] _members =
    [
        new("Sarah Chen",      "SC", "Engineering Lead",    13, 5, 7),
        new("Marcus Johnson",  "MJ", "Backend Engineer",    11, 6, 5),
        new("David Kim",       "DK", "Frontend Engineer",   10, 5, 6),
        new("Elena Rodriguez", "ER", "Full Stack Engineer",  9, 4, 4),
        new("James O'Brien",   "JO", "DevOps Engineer",      8, 3, 3),
        new("Yuki Tanaka",     "YT", "QA Engineer",          7, 2, 2),
    ];
}
