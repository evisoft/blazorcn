@* ============================================================
   Block: team-marquee
   Title: Team Marquee
   Description: Static horizontal row of team member initials with names and roles for a clean team showcase section
   Long Description: A clean, static team showcase that displays team members in a grid
   Dependencies: None
   Source: original/blocks/team/team-marquee.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <span class="text-sm font-medium">Our team</span>
            <p class="mt-0.5 text-xs text-muted-foreground">
                The people building, designing, and shipping the platform every day.
            </p>
        </div>

        <div class="px-4 py-4">
            <div class="grid grid-cols-4 gap-4">
                @foreach (var member in _members)
                {
                    <div class="flex flex-col items-center gap-2 text-center">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                            @member.Initials
                        </div>
                        <div class="min-w-0">
                            <span class="block truncate text-xs font-medium">@member.Name</span>
                            <span class="block truncate text-xs text-muted-foreground">
                                @member.Role
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record TeamMember(string Name, string Role, string Department, string Initials);

    private static readonly TeamMember[] _members =
    [
        new("Cassandra Reyes", "Chief Executive Officer", "Leadership", "CR"),
        new("Henrik Dahl", "Chief Technology Officer", "Engineering", "HD"),
        new("Nadia Ouellet", "VP of Product", "Product", "NO"),
        new("Tariq Benali", "Head of Engineering", "Engineering", "TB"),
        new("Signe Eriksson", "VP of Design", "Design", "SE"),
        new("Omar Hadid", "Head of Growth", "Marketing", "OH"),
        new("Livia Marchetti", "Head of Data Science", "Engineering", "LM"),
        new("Daisuke Mori", "Head of Infrastructure", "Engineering", "DM"),
    ];
}
