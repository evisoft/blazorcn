@* ============================================================
   Block: team-dark-modern
   Title: Team Dark Modern
   Description: Clean flat team member list with a highlighted lead indicator for React team sections
   Dependencies: None
   Source: original/blocks/team/team-dark-modern.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Engineering Team</p>
            <p class="mt-0.5 text-xs text-muted-foreground">A world-class team obsessed with developer experience and performance.</p>
        </div>
        @for (var i = 0; i < _members.Length; i++)
        {
            var member = _members[i];
            <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3", i < _members.Length - 1 ? "border-b" : "")">
                <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@member.Initials</div>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-medium">@member.Name</span>
                        @if (member.IsFeatured) { <span class="size-1.5 rounded-full bg-emerald-500"></span> }
                        <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@member.Department</span>
                    </div>
                    <p class="mt-0.5 text-xs text-muted-foreground">@member.Role</p>
                    <p class="mt-1 text-xs text-muted-foreground leading-relaxed">@member.Bio</p>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record MemberItem(string Name, string Role, string Bio, string Initials, string Department, bool IsFeatured);
    private static readonly MemberItem[] _members =
    [
        new("Amara Okafor", "VP of Engineering", "Former principal engineer at Cloudflare. Built edge computing infrastructure serving 25M requests per second across 200 cities.", "AO", "Engineering", true),
        new("Chen Wei", "Staff Software Engineer", "Core contributor to React Server Components. Previously architected real-time collaboration at Figma.", "CW", "Engineering", false),
        new("Isabella Santos", "Head of Product Design", "Led design systems at Linear and Vercel. Believes great tools should feel invisible to the people using them.", "IS", "Design", false),
        new("Nathan Cross", "Senior Backend Engineer", "Distributed systems specialist from Datadog. Obsessed with observability, latency budgets, and zero-downtime deploys.", "NC", "Engineering", false),
        new("Fatima Al-Zahra", "Product Manager", "Previously at Notion where she shipped the API platform. Focused on building workflows that developers actually enjoy.", "FA", "Product", false),
        new("Lucas Petrov", "DevOps Lead", "Ex-GitLab SRE. Automated infrastructure across three clouds and reduced incident response time by 80% at his last startup.", "LP", "Infrastructure", false),
    ];
}
