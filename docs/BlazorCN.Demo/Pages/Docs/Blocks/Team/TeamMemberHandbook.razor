@* ============================================================
   Block: team-member-handbook
   Title: TeamMemberHandbook
   Description: A team member handbook block for React and Next.js with quick reference guide cards showing roles, responsibilities, and key information built with shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-member-handbook.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="space-y-4">
        @* Header *@
        <div>
            <h2 class="text-sm font-medium">Team Handbook</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Quick reference guide for team roles and responsibilities
            </p>
        </div>

        @* Handbook Cards *@
        @foreach (var member in _team)
        {
            var isExpanded = _expanded == member.Id;
            <div class="overflow-hidden rounded-lg border bg-card">
                <button
                    type="button"
                    @onclick="@(() => _expanded = isExpanded ? null : member.Id)"
                    class="w-full px-4 py-3 text-left transition-colors hover:bg-muted/50">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <h3 class="text-sm font-medium">@member.Name</h3>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                @member.Role • @member.Department
                            </p>
                        </div>
                        <LucideIconCn
                            Name="chevron-right"
                            Size="16"
                            Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </div>
                </button>

                @if (isExpanded)
                {
                    <div class="border-t px-4 py-3 space-y-3">
                        @if (member.ReportsTo != null)
                        {
                            <div>
                                <span class="text-xs font-medium text-muted-foreground">
                                    Reports to
                                </span>
                                <p class="mt-1 text-sm">@member.ReportsTo</p>
                            </div>
                        }

                        <div>
                            <span class="text-xs font-medium text-muted-foreground">
                                Key Responsibilities
                            </span>
                            <div class="mt-2 space-y-1.5">
                                @foreach (var resp in member.Responsibilities)
                                {
                                    <p class="text-sm text-muted-foreground">• @resp</p>
                                }
                            </div>
                        </div>

                        <div class="flex items-center gap-2 border-t pt-3">
                            <a
                                href="@($"mailto:{member.ContactEmail}")"
                                class="flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground transition-colors">
                                <LucideIconCn Name="mail" Size="12" Class="size-3" />
                                @member.ContactEmail
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private string? _expanded = "1";

    private record TeamMember(
        string Id,
        string Name,
        string Role,
        string Department,
        string? ReportsTo,
        string[] Responsibilities,
        string ContactEmail,
        string ContactPhone
    );

    private static readonly TeamMember[] _team =
    [
        new("1", "Sarah Chen", "Product Lead", "Product", "CEO",
            ["Roadmap planning", "Feature prioritization", "Stakeholder alignment"],
            "sarah@example.com", "+1 (555) 123-4567"),
        new("2", "Marcus Rodriguez", "Engineering Lead", "Engineering", "CTO",
            ["Architecture decisions", "Code quality", "Team mentoring"],
            "marcus@example.com", "+1 (555) 234-5678"),
        new("3", "Emily Watson", "Design Lead", "Design", "CEO",
            ["Design systems", "User research", "Brand consistency"],
            "emily@example.com", "+1 (555) 345-6789"),
    ];
}
