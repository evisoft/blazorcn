            new("Yuki Tanaka", "YT", "Senior Frontend Engineer", "expert"),
            new("Priya Kapoor", "PK", "Frontend Engineer", "proficient"),
            new("Nia Okonkwo", "NO", "Product Designer", "proficient"),
        ]),
        new("Backend",
        [
            new("Tomas Aguirre", "TA", "Staff Backend Engineer", "expert"),
            new("Lina Petrova", "LP", "Senior Backend Engineer", "expert"),
            new("Kofi Asante", "KA", "Backend Engineer", "proficient"),
        ]),
        new("Infrastructure",
        [
            new("Henrik Dahl", "HD", "Staff DevOps Engineer", "expert"),
            new("Tomas Aguirre", "TA", "Staff Backend Engineer", "proficient"),
            new("Elise Beaumont", "EB", "Site Reliability Engineer", "proficient"),
        ]),
        new("Data",
        [
            new("Aisha Farouk", "AF", "Machine Learning Engineer", "expert"),
