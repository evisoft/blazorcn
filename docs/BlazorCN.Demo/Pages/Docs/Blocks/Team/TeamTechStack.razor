@* ============================================================
   Block: team-tech-stack
   Title: Team Tech Stack
   Description: Team members organized by technology expertise area with proficiency level dot indicators
   Dependencies: None
   Source: original/blocks/team/team-tech-stack.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Tech stack coverage</p>
            <p class="mt-0.5 text-xs text-muted-foreground">@_stacks.SelectMany(s => s.Members).Select(m => m.Name).Distinct().Count() engineers across @_stacks.Length domains</p>
        </div>

        <div class="border-b px-4 py-2">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-xs text-muted-foreground">Expert</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    <span class="text-xs text-muted-foreground">Proficient</span>
                </div>
            </div>
        </div>

        @for (var stackIndex = 0; stackIndex < _stacks.Length; stackIndex++)
        {
            var stack = _stacks[stackIndex];
            <div class="@Cn.Merge(stackIndex < _stacks.Length - 1 ? "border-b" : "")">
                <div class="flex items-center justify-between bg-muted/30 px-4 py-2">
                    <span class="text-xs font-medium">@stack.Name</span>
                    <span class="text-xs text-muted-foreground">@stack.Members.Length @(stack.Members.Length == 1 ? "person" : "people")</span>
                </div>
                @for (var memberIndex = 0; memberIndex < stack.Members.Length; memberIndex++)
                {
                    var member = stack.Members[memberIndex];
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", memberIndex < stack.Members.Length - 1 ? "border-b" : "")">
                        <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@member.Initials</div>
                        <div class="min-w-0 flex-1">
                            <span class="truncate text-sm font-medium">@member.Name</span>
                            <p class="truncate text-xs text-muted-foreground">@member.Role</p>
                        </div>
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", member.Level == "expert" ? "bg-emerald-500" : "bg-amber-500")"></span>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record StackMember(string Name, string Initials, string Role, string Level);
    private record TechStackItem(string Name, StackMember[] Members);

    private static readonly TechStackItem[] _stacks =
    [
        new("Frontend",
        [
