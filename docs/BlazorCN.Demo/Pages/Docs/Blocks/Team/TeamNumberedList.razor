@* ============================================================
   Block: team-numbered-list
   Title: Team Numbered List
   Description: Editorial numbered team list with sequential numbering, initials, roles, and department chips
   Dependencies: None
   Source: original/blocks/team/team-numbered-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Team roster</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Six leaders shaping every decision, commit, and conversation.</p>
        </div>

        @for (var i = 0; i < _members.Length; i++)
        {
            var member = _members[i];
            <div class="@Cn.Merge("flex items-center gap-4 px-4 py-3", i < _members.Length - 1 ? "border-b" : "")">
                <span class="w-6 shrink-0 text-center font-mono text-xs text-muted-foreground">@((i + 1).ToString("D2"))</span>
                <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@member.Initials</div>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-medium">@member.Name</span>
                        <span class="hidden rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground sm:inline">@member.Department</span>
                    </div>
                    <p class="mt-0.5 text-xs text-muted-foreground">@member.Role</p>
                </div>
                <p class="hidden max-w-[240px] truncate text-xs text-muted-foreground md:block">@member.Summary</p>
            </div>
        }
    </div>
</section>

@code {
    private record MemberItem(string Name, string Role, string Department, string Summary, string Initials);
    private static readonly MemberItem[] _members =
    [
        new("Renata Vogt", "Chief Executive Officer", "Leadership", "Former McKinsey advisor who founded a fintech processing over $2B in transactions.", "RV"),
        new("Samuel Conteh", "Chief Technology Officer", "Engineering", "Architected real-time collaboration infrastructure at Figma for millions of sessions.", "SC"),
        new("Elina Virtanen", "VP of Design", "Design", "Led Klarna's checkout redesign that lifted conversion by 22 percent.", "EV"),
        new("Rafael Dominguez", "Head of Engineering", "Engineering", "Grew Vercel's infrastructure team from 4 to 35 and led edge-first deployments.", "RD"),
        new("Amina Jallow", "VP of Product", "Product", "Launched Notion's API platform and grew it to 2 million integrations in year one.", "AJ"),
        new("Viktor Lindgren", "Head of Revenue", "Sales", "Built Webflow's enterprise sales motion from zero to $40M ARR.", "VL"),
    ];
}
