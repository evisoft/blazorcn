@* ============================================================
   Block: team-certifications
   Title: Team Certifications
   Description: Professional certifications and credentials held by team members with issuing body, validity dates, and category filtering for compliance and skills pages
   Long Description: Dense list with department chips and tight spacing
   Dependencies: LucideShieldCheckCn
   Source: original/blocks/team/team-certifications.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideShieldCheckCn Size="16" Class="text-muted-foreground" />
                <p class="text-sm font-medium">Professional certifications</p>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_certifications.Length active credentials across the team
            </p>
        </div>

        <div class="flex items-center gap-1 border-b px-4 py-2">
            @foreach (var category in _categories)
            {
                <button
                    type="button"
                    @onclick="@(() => _activeCategory = category)"
                    class="@(Cn.Merge("rounded px-2 py-1 text-xs transition-colors", _activeCategory == category ? "bg-foreground text-background" : "text-muted-foreground hover:bg-muted hover:text-foreground"))">
                    @category
                </button>
            }
        </div>

        @{
            var filtered = _activeCategory == "All"
                ? _certifications
                : _certifications.Where(c => c.Category == _activeCategory).ToArray();
        }

        @if (filtered.Length == 0)
        {
            <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                No certifications in this category
            </div>
        }

        @for (var i = 0; i < filtered.Length; i++)
        {
            var cert = filtered[i];
            var isLast = i == filtered.Length - 1;
            <div class="@(Cn.Merge("px-4 py-3", !isLast ? "border-b" : ""))">
                <div class="flex items-start gap-3">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @cert.Initials
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-baseline gap-2">
                            <span class="text-sm font-medium">@cert.Name</span>
                            <span class="hidden text-xs text-muted-foreground sm:inline">
                                @cert.Role
                            </span>
                        </div>
                        <p class="mt-0.5 text-xs font-medium text-foreground/80">@cert.CertName</p>
                        <div class="mt-1 flex flex-wrap items-center gap-2">
                            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                @cert.IssuingBody
                            </span>
                            <span class="font-mono text-xs text-muted-foreground/60">
                                Valid through @cert.ValidThrough
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private string _activeCategory = "All";

    private static readonly string[] _categories = ["All", "Cloud", "Security", "Management", "Platform"];

    private record CertItem(string Name, string Role, string Initials, string CertName, string IssuingBody, string ValidThrough, string Category);

    private static readonly CertItem[] _certifications =
    [
        new("Aarav Sharma", "Head of Engineering", "AS", "AWS Solutions Architect Professional", "Amazon Web Services", "Sep 2027", "Cloud"),
        new("Mei-Lin Wu", "Principal Engineer", "MW", "Certified Kubernetes Administrator", "Cloud Native Computing Foundation", "Jun 2027", "Cloud"),
        new("Felix Brennan", "Head of Growth", "FB", "Google Analytics 4 Certified", "Google", "Mar 2027", "Platform"),
        new("Priya Kapoor", "VP of Product", "PK", "Project Management Professional", "Project Management Institute", "Dec 2027", "Management"),
        new("Leo Andersen", "Staff Software Engineer", "LA", "Google Cloud Professional Data Engineer", "Google Cloud", "Aug 2027", "Cloud"),
        new("Sofia Reyes", "Senior Product Designer", "SR", "Certified Accessibility Professional", "IAAP", "Nov 2026", "Platform"),
        new("James Okoye", "Co-founder &amp; CTO", "JO", "Certified Information Systems Security Professional", "ISC2", "Feb 2028", "Security"),
        new("Aarav Sharma", "Head of Engineering", "AS", "Certified Scrum Master", "Scrum Alliance", "Apr 2027", "Management"),
        new("Mei-Lin Wu", "Principal Engineer", "MW", "HashiCorp Certified Terraform Associate", "HashiCorp", "Jan 2027", "Cloud"),
        new("James Okoye", "Co-founder &amp; CTO", "JO", "AWS Certified Security Specialty", "Amazon Web Services", "Oct 2027", "Security"),
    ];
}
