@* ============================================================
   Block: team-culture-values
   Title: Team Culture Values
   Description: Company culture values showcase with team member quotes illustrating each core value in expandable bordered rows
   Dependencies: none (pure HTML/Tailwind)
   Source: original/blocks/team/team-culture-values.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Our values</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                The principles that guide how we build, collaborate, and grow
            </p>
        </div>
        @foreach (var value in _values)
        {
            var isExpanded = _expanded == value.Name;
            <div class="border-b last:border-b-0">
                <button type="button"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => _expanded = isExpanded ? null : value.Name)">
                    <div class="min-w-0 flex-1">
                        <span class="text-sm font-medium">@value.Name</span>
                        <p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">
                            @value.Description
                        </p>
                    </div>
                    <LucideChevronRightCn Size="16"
                                          Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                </button>
                @if (isExpanded)
                {
                    <div class="border-t bg-muted/30 px-4 py-3">
                        <div class="rounded-md bg-muted/50 p-3">
                            <p class="text-sm italic leading-relaxed text-foreground">
                                &ldquo;@value.Quote&rdquo;
                            </p>
                            <div class="mt-3 flex items-center gap-2.5">
                                <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-background text-xs font-medium">
                                    @value.AdvocateInitials
                                </div>
                                <div class="min-w-0">
                                    <span class="text-sm font-medium">@value.AdvocateName</span>
                                    <span class="mx-1.5 text-muted-foreground">&middot;</span>
                                    <span class="text-xs text-muted-foreground">@value.AdvocateRole</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record CultureValue(string Name, string Description, string AdvocateName, string AdvocateRole, string AdvocateInitials, string Quote);

    private string? _expanded;

    private static readonly CultureValue[] _values =
    [
        new("Ship fast",
            "We bias toward action. Small, frequent releases beat big-bang launches. Every week should move the needle.",
            "Lena Johansson", "Head of Engineering", "LJ",
            "We shipped our v2 migration in six weeks because we broke it into 30 tiny deployments. Zero downtime, zero drama. Speed is a habit, not a hack."),
        new("Customer obsession",
            "Start with the customer problem and work backwards. Every feature, every fix, every decision is anchored in real user pain.",
            "Ravi Mehta", "VP of Product", "RM",
            "I still do two customer calls a week. Last month a 10-minute conversation with a power user reshaped our entire Q3 roadmap. You cannot outsource listening."),
        new("Radical transparency",
            "Default to open. Share context generously. Decisions stick when people understand the why, not just the what.",
            "Amara Osei", "Chief of Staff", "AO",
            "Our all-hands decks include the numbers we missed, not just the wins. Trust compounds when you share the full picture."),
        new("Own the outcome",
            "Titles do not define scope. If you see a problem, it is your problem. We hire people who finish what they start.",
            "Tomas Reyes", "Staff Software Engineer", "TR",
            "I noticed our onboarding drop-off was 40% at step three. It was not my team's feature, but I spent a weekend fixing it. Ownership is a mindset."),
        new("Disagree and commit",
            "Healthy debate sharpens ideas. But once a decision is made, everyone rows in the same direction. Speed requires alignment.",
            "Priya Chandrasekaran", "Design Director", "PC",
            "I argued hard against the new navigation pattern. I lost that debate, then gave it everything I had. It turned out better than my original proposal."),
    ];
}
