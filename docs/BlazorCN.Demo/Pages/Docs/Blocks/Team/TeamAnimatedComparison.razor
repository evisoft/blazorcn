@* ============================================================
   Block: team-animated-comparison
   Title: Team Animated Comparison
   Description: Before-and-after team growth comparison block with AnimatePresence toggle between founding team and current team for React about pages
   Long Description: Chronological milestones showing company growth
   Dependencies: ButtonCn
   Source: original/blocks/team/team-animated-comparison.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Team growth</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    @_team.Length @(_team.Length == 1 ? "person" : "people")
                    @(_showNow ? "and growing" : "at founding")
                </p>
            </div>
            <div class="flex items-center gap-1 rounded-md border p-0.5">
                <ButtonCn Variant="@(!_showNow ? ButtonVariant.Outline : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm" Class="h-6 px-2.5 text-xs"
                          @onclick="@(() => _showNow = false)">
                    Then
                </ButtonCn>
                <ButtonCn Variant="@(_showNow ? ButtonVariant.Outline : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm" Class="h-6 px-2.5 text-xs"
                          @onclick="@(() => _showNow = true)">
                    Now
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-3 border-b px-4 py-3">
            <span class="text-2xl font-semibold tabular-nums">@_team.Length</span>
            <span class="text-xs text-muted-foreground">
                @(_showNow ? "across 5 departments" : "working from a coffee shop")
            </span>
            @if (_showNow)
            {
                <span class="ml-auto rounded bg-emerald-500/10 px-1.5 py-0.5 text-xs text-emerald-600 dark:text-emerald-400">
                    3x growth
                </span>
            }
        </div>

        <div>
            @for (var i = 0; i < _team.Length; i++)
            {
                var member = _team[i];
                <div class="@(i < _team.Length - 1 ? "border-b" : "")">
                    <div class="flex items-center gap-3 px-4 py-3">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                            @member.Initials
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@member.Name</span>
                                @if (member.IsFounder)
                                {
                                    <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                        Founder
                                    </span>
                                }
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">@member.Role</p>
                        </div>
                        <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                            @member.Department
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private bool _showNow;
    private MemberItem[] _team => _showNow ? _nowTeam : _thenTeam;

    private record MemberItem(string Name, string Role, string Initials, string Department, bool IsFounder);

    private static readonly MemberItem[] _thenTeam =
    [
        new("Ingrid Solberg", "Co-founder & CEO", "IS", "Leadership", true),
        new("James Okoye", "Co-founder & CTO", "JO", "Engineering", true),
        new("Mei-Lin Wu", "Founding Engineer", "MW", "Engineering", true),
        new("Anders Holm", "Founding Designer", "AH", "Design", true),
    ];

    private static readonly MemberItem[] _nowTeam =
    [
        new("Ingrid Solberg", "Chief Executive Officer", "IS", "Leadership", true),
        new("James Okoye", "Chief Technology Officer", "JO", "Engineering", true),
        new("Mei-Lin Wu", "VP of Engineering", "MW", "Engineering", true),
        new("Anders Holm", "VP of Design", "AH", "Design", true),
        new("Priya Kapoor", "VP of Product", "PK", "Product", false),
        new("Felix Brennan", "Head of Growth", "FB", "Marketing", false),
        new("Yuki Tanaka", "Head of Data", "YT", "Engineering", false),
        new("Sofia Reyes", "Staff Engineer", "SR", "Engineering", false),
        new("Leo Virtanen", "Senior Designer", "LV", "Design", false),
        new("Amara Diallo", "Product Manager", "AD", "Product", false),
        new("Omar Hassan", "Security Engineer", "OH", "Engineering", false),
        new("Rachel Nguyen", "Developer Advocate", "RN", "DevRel", false),
    ];
}
