@* ============================================================
   Block: team-compact-list
   Title: Team Compact List
   Description: Dense team list with initials, name, role, and department chip in tight bordered rows
   Long Description: A space-efficient team list that puts names and roles front and center
   Dependencies: None
   Source: original/blocks/team/team-compact-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Team</p>
            <p class="mt-0.5 text-xs text-muted-foreground">8 members across 5 departments</p>
        </div>
        @foreach (var member in _members)
        {
            <div class="flex items-center gap-3 border-b px-4 py-2.5 last:border-b-0">
                <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                    @member.Initials
                </div>
                <div class="min-w-0 flex-1">
                    <div class="flex items-baseline gap-2">
                        <span class="truncate text-sm font-medium">@member.Name</span>
                        <span class="hidden truncate text-xs text-muted-foreground sm:inline">
                            @member.Role
                        </span>
                    </div>
                    <p class="truncate text-xs text-muted-foreground sm:hidden">@member.Role</p>
                </div>
                <span class="shrink-0 rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                    @member.Department
                </span>
            </div>
        }
    </div>
</section>

@code {
    private record TeamMember(string Name, string Role, string Department, string Initials);

    private static readonly TeamMember[] _members =
    [
        new("Sarah Chen", "Chief Executive Officer", "Leadership", "SC"),
        new("Marcus Johnson", "Head of Engineering", "Engineering", "MJ"),
        new("Elena Rodriguez", "Senior Product Designer", "Design", "ER"),
        new("David Kim", "Staff Software Engineer", "Engineering", "DK"),
        new("Aisha Patel", "VP of Marketing", "Marketing", "AP"),
        new("James O'Brien", "Engineering Manager", "Engineering", "JO"),
        new("Yuki Tanaka", "Product Manager", "Product", "YT"),
        new("Priya Sharma", "UX Researcher", "Design", "PS"),
    ];
}
