@* ============================================================
   Block: team-animated-locations
   Title: Team Animated Locations
   Description: Team by location with animated tab transitions where members exit left and enter right using AnimatePresence and framer-motion
   Long Description: Static team grouped by office location
   Dependencies: ButtonCn, LucideMapPinCn
   Source: original/blocks/team/team-animated-locations.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-sm font-medium">Team by location</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_locations.Sum(l => l.Members.Length) people across @_locations.Length locations
                    </p>
                </div>
                <LucideMapPinCn Size="16" Class="size-4 text-muted-foreground" />
            </div>
        </div>

        <div class="flex items-center gap-1 border-b px-4 py-2">
            @foreach (var loc in _locations)
            {
                var id = loc.Id;
                <ButtonCn Variant="@(_activeId == id ? ButtonVariant.Outline : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs"
                          @onclick="@(() => _activeId = id)">
                    @loc.Name
                    <span class="text-muted-foreground">@loc.Members.Length</span>
                </ButtonCn>
            }
        </div>

        <div class="relative min-h-[200px]">
            @{ var active = _locations.First(l => l.Id == _activeId); }
            <div class="flex items-center justify-between border-b bg-muted/50 px-4 py-2">
                <span class="text-xs font-medium">@active.Name</span>
                <span class="text-xs text-muted-foreground">@active.Timezone</span>
            </div>

            @for (var i = 0; i < active.Members.Length; i++)
            {
                var member = active.Members[i];
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", i < active.Members.Length - 1 ? "border-b" : "")">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @member.Initials
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="text-sm font-medium">@member.Name</span>
                        <p class="text-xs text-muted-foreground">@member.Role</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string _activeId = "sf";

    private record LocationMember(string Name, string Role, string Initials);
    private record OfficeLocation(string Id, string Name, string Timezone, LocationMember[] Members);

    private static readonly OfficeLocation[] _locations =
    [
        new("sf", "San Francisco", "PST (UTC-8)",
