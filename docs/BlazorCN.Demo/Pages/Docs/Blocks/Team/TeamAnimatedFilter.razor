@* ============================================================
   Block: team-animated-filter
   Title: Team Animated Filter
   Description: Filterable team section with department filter tabs and staggered row reveals
   Long Description: Staggered grid entrance with hover lift effects
   Dependencies: None
   Source: original/blocks/team/team-animated-filter.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex gap-0 overflow-x-auto border-b">
            @foreach (var dept in _departments)
            {
                var count = dept == "All"
                    ? _members.Length
                    : _members.Count(m => m.Department == dept);
                <button type="button" @onclick="@(() => _activeTab = dept)"
                        class="@Cn.Merge("relative shrink-0 px-4 py-3 text-xs font-medium transition-colors", _activeTab == dept ? "text-foreground" : "text-muted-foreground hover:text-foreground")">
                    <span class="flex items-center gap-1.5">
                        @dept
                        <span class="tabular-nums text-muted-foreground/60">@count</span>
                    </span>
                    @if (_activeTab == dept)
                    {
                        <span class="absolute inset-x-0 bottom-0 h-0.5 bg-foreground"></span>
                    }
                </button>
            }
        </div>

        <div class="border-b px-4 py-2.5">
            <p class="text-xs text-muted-foreground">
                Showing @_filtered.Length of @_members.Length members
            </p>
        </div>

        @for (var i = 0; i < _filtered.Length; i++)
        {
            var member = _filtered[i];
            <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", i < _filtered.Length - 1 ? "border-b" : "")">
                <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                    @member.Initials
                </div>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-medium">@member.Name</span>
                        <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                            @member.Department
                        </span>
                    </div>
                    <p class="mt-0.5 text-xs text-muted-foreground">@member.Role</p>
                    <p class="mt-1 text-xs leading-relaxed text-muted-foreground">@member.Bio</p>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record TeamMember(string Name, string Role, string Initials, string Department, string Bio);

    private static readonly string[] _departments = ["All", "Engineering", "Design", "Product", "Marketing"];

    private string _activeTab = "All";

    private TeamMember[] _filtered => _activeTab == "All"
        ? _members
        : _members.Where(m => m.Department == _activeTab).ToArray();

    private static readonly TeamMember[] _members =
    [
        new("Marcus Johnson", "Head of Engineering", "MJ", "Engineering", "Led backend infrastructure at Uber serving 130 million monthly riders. Core contributor to Apache Kafka."),
        new("David Kim", "Staff Software Engineer", "DK", "Engineering", "Architected the real-time data pipeline processing 2 million events per second across three regions."),
        new("Priya Sharma", "Senior Backend Engineer", "PS", "Engineering", "Built Razorpay's payment gateway scaling from 1,000 to 8 million merchants. Expert in distributed systems."),
        new("Elena Rodriguez", "Senior Product Designer", "ER", "Design", "Former principal designer at Spotify building creator tools. Taught interaction design at IED Barcelona."),
        new("Carlos Mendez", "UX Researcher", "CM", "Design", "Led research programs at Airbnb that shaped the host onboarding experience used by 4 million hosts worldwide."),
        new("Aisha Patel", "Visual Designer", "AP", "Design", "Designed the brand identity for three YC-backed startups. Specializes in design systems and component libraries."),
        new("Tobias Muller", "VP of Product", "TM", "Product", "Launched three 0-to-1 products at Atlassian including Compass. Stanford HCI background with platform strategy expertise."),
        new("Yuki Tanaka", "Product Manager", "YT", "Product", "Former PM at Shopify building the developer platform. Expert in API design and third-party ecosystem growth."),
        new("Olivia Washington", "VP of Marketing", "OW", "Marketing", "Grew Notion's PLG motion from Series A to IPO. Deep expertise in product-led acquisition and community building."),
        new("Liam Foster", "Growth Marketing Manager", "LF", "Marketing", "Built the growth engine at Vercel, scaling developer signups 10x in 18 months through content and community programs."),
    ];
}
