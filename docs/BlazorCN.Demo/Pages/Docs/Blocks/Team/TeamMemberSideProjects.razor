@* ============================================================
   Block: team-member-side-projects
   Title: TeamMemberSideProjects
   Description: A side projects and personal interests showcase block for React and Next.js displaying team passions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-member-side-projects.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="space-y-4">
        <div>
            <h2 class="text-sm font-medium">Side Projects</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Personal projects and passions</p>
        </div>

        <div class="space-y-4">
            @foreach (var member in _team)
            {
                <div class="rounded-lg border bg-card p-4">
                    <h3 class="mb-3 text-sm font-medium">@member.Name</h3>
                    <div class="space-y-2">
                        @foreach (var proj in member.Projects)
                        {
                            <div class="flex items-start gap-2.5 rounded-md bg-muted/20 p-2.5">
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <p class="text-sm font-medium">@proj.Title</p>
                                        @if (proj.Link != null)
                                        {
                                            <LucideIconCn Name="external-link" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                                        }
                                    </div>
                                    <p class="mt-0.5 text-xs text-muted-foreground">@proj.Description</p>
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="mt-1.5 text-xs">@proj.Category</BadgeCn>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Project(string Title, string Description, string Category, string? Link = null);
    private record TeamMember(string Name, Project[] Projects);

    private static readonly TeamMember[] _team =
    [
        new("Sarah Chen",
        [
            new("Product Strategy Newsletter", "Weekly insights on product management", "Writing", "https://example.com"),
            new("StartupCommunity Meetups", "Organizing local startup founder meetups", "Community"),
        ]),
        new("Marcus Rodriguez",
        [
            new("Rust CLI Tool", "Open source command-line tool for developers", "Open Source", "https://github.com"),
            new("Tech Podcast", "Podcast about backend architecture trends", "Media"),
        ]),
    ];
}
