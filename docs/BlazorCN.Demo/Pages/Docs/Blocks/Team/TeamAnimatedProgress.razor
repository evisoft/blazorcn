@* ============================================================
   Block: team-animated-progress
   Title: Team Animated Progress
   Description: Team OKR and goals progress tracker with progress bars, stat counters
   Dependencies: none (pure HTML/Tailwind)
   Source: original/blocks/team/team-animated-progress.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Team goals</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Q1 2026 &middot; @_goals.Count objectives
            </p>
        </div>

        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="text-2xl font-semibold tabular-nums">@_avgProgress</span>
                <span class="text-xs text-muted-foreground">% avg</span>
            </div>
            <div class="ml-auto flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_onTrack on track
                </span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_needsAttention attention
                </span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_atRisk at risk
                </span>
            </div>
        </div>

        <div>
            @foreach (var goal in _goals)
            {
                <div class="border-b px-4 py-3 last:border-b-0">
                    <div class="flex items-center gap-3">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                            @goal.OwnerInitials
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate text-sm font-medium">@goal.Title</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-1.5">
                                <span class="truncate text-xs text-muted-foreground">@goal.Owner</span>
                                <span class="text-muted-foreground/40">&middot;</span>
                                <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                    @goal.Department
                                </span>
                            </div>
                        </div>
                        <span class="@Cn.Merge("shrink-0 text-sm font-semibold tabular-nums", ProgressTextColor(goal.Progress))">
                            @goal.Progress%
                        </span>
                    </div>
                    <div class="ml-11 mt-2.5">
                        <div class="h-1.5 w-full rounded-full bg-muted">
                            <div class="@Cn.Merge("h-full rounded-full", ProgressColor(goal.Progress))"
                                 style="@($"width: {goal.Progress}%")"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record GoalItem(string Id, string Title, string Owner, string OwnerInitials, string Department, int Progress);

    private static readonly List<GoalItem> _goals =
    [
        new("g1", "Reduce API p99 latency below 200ms", "Marcus Johnson", "MJ", "Engineering", 87),
        new("g2", "Ship design system v3 with 40 components", "Elena Rodriguez", "ER", "Design", 72),
        new("g3", "Grow weekly active users to 50k", "James O'Brien", "JO", "Growth", 64),
        new("g4", "Achieve SOC 2 Type II certification", "Aisha Patel", "AP", "Security", 91),
        new("g5", "Close 15 enterprise accounts this quarter", "David Kim", "DK", "Sales", 40),
        new("g6", "Reduce customer churn to below 3%", "Priya Sharma", "PS", "Product", 55),
    ];

    private static readonly int _onTrack = _goals.Count(g => g.Progress >= 80);
    private static readonly int _needsAttention = _goals.Count(g => g.Progress >= 50 && g.Progress < 80);
    private static readonly int _atRisk = _goals.Count(g => g.Progress < 50);
    private static readonly int _avgProgress = (int)Math.Round(_goals.Average(g => (double)g.Progress));

    private static string ProgressColor(int value) => value >= 80 ? "bg-emerald-500" : value >= 50 ? "bg-amber-500" : "bg-red-500";

    private static string ProgressTextColor(int value) => value >= 80
        ? "text-emerald-600 dark:text-emerald-400"
        : value >= 50
            ? "text-amber-600 dark:text-amber-400"
            : "text-red-600 dark:text-red-400";
}
