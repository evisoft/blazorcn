@* ============================================================
   Block: team-speaking-events
   Title: Team Speaking Events
   Description: Conference talks and speaking engagements by team members with expandable talk descriptions speaker initials and event details for React company pages
   Long Description: Awards and individual recognition board
   Dependencies: LucideChevronRightCn
   Source: original/blocks/team/team-speaking-events.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium">Speaking &amp; events</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_talks.Length talks &middot; @_upcomingCount upcoming
                    </p>
                </div>
                <LucideMicCn Size="16" Class="text-muted-foreground" />
            </div>
        </div>

        @foreach (var talk in _talks)
        {
            var isExpanded = _expanded == talk.Id;
            <div class="border-b last:border-b-0">
                <button
                    type="button"
                    @onclick="@(() => _expanded = isExpanded ? null : talk.Id)"
                    class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                    <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @talk.SpeakerInitials
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="truncate text-sm font-medium">@talk.Title</span>
                            @if (talk.Status == "upcoming")
                            {
                                <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                            }
                        </div>
                        <div class="mt-0.5 flex items-center gap-1.5 text-xs text-muted-foreground">
                            <span class="truncate">@talk.Speaker</span>
                            <span class="text-muted-foreground/40">&middot;</span>
                            <span class="hidden truncate sm:inline">@talk.Conference</span>
                            <span class="hidden text-muted-foreground/40 sm:inline">&middot;</span>
                            <span class="shrink-0 font-mono">@talk.Date</span>
                        </div>
                    </div>
                    <LucideChevronRightCn
                        Size="16"
                        Class="@Cn.Merge("shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                </button>
                @if (isExpanded)
                {
                    <div class="border-t bg-muted/30 px-4 py-3">
                        <div class="ml-10">
                            <div class="flex items-center gap-2">
                                <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                    @talk.Conference
                                </span>
                                <span class="@Cn.Merge("rounded px-1.5 py-0.5 text-xs", talk.Status == "upcoming" ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : "bg-muted text-muted-foreground")">
                                    @(talk.Status == "upcoming" ? "Upcoming" : "Completed")
                                </span>
                            </div>
                            <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                                @talk.Description
                            </p>
                            <div class="mt-2 flex flex-wrap gap-1">
                                @foreach (var topic in talk.Topics)
                                {
                                    <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                        @topic
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private string? _expanded;

    private static int _upcomingCount => _talks.Count(t => t.Status == "upcoming");

    private record TalkItem(string Id, string Speaker, string SpeakerInitials, string Title, string Conference, string Date, string Status, string Description, string[] Topics);

    private static readonly TalkItem[] _talks =
    [
        new("t1", "Kofi Asante", "KA", "Building Event-Driven Systems at Scale", "QCon San Francisco", "Jun 2026", "upcoming",
            "A deep dive into designing event-driven architectures that handle 130 million monthly users. Covers event sourcing patterns, idempotency guarantees, and the operational playbook for running Kafka at scale with zero data loss.",
            ["Architecture", "Kafka", "Scale"]),
        new("t2", "Lucia Fernandez", "LF", "Design Systems That Actually Ship", "Config 2026", "May 2026", "upcoming",
            "Why most design systems become shelfware and the three principles that kept ours alive. Walks through the token architecture, component API decisions, and the Figma-to-code pipeline that reduced design-to-production time by 70%.",
            ["Design Systems", "Figma", "Components"]),
        new("t3", "Darian Reeves", "DR", "React Server Components in Production", "React Summit", "Apr 2026", "upcoming",
            "Lessons from migrating a 200-route Next.js application to React Server Components. Covers the performance wins, the pitfalls we hit with client boundaries, and the mental model shift required across the engineering team.",
            ["React", "RSC", "Next.js"]),
        new("t4", "Aisha Farouk", "AF", "Vector Search Beyond RAG", "MLconf NYC", "Feb 2026", "past",
            "Exploring vector database applications beyond retrieval-augmented generation. Demonstrates hybrid search architectures combining dense and sparse vectors for product recommendation, anomaly detection, and semantic deduplication at scale.",
            ["ML", "Vector DB", "Search"]),
        new("t5", "Henrik Dahl", "HD", "Zero-Downtime Migrations on Kubernetes", "KubeCon EU", "Jan 2026", "past",
            "A practical walkthrough of migrating stateful workloads between Kubernetes clusters with zero customer-facing downtime. Covers blue-green deployments with persistent volumes, DNS cutover strategies, and the rollback playbook when things go wrong.",
            ["Kubernetes", "DevOps", "Migration"]),
        new("t6", "Tomoko Nakamura", "TN", "Building Recommendation Systems for Cold Start", "RecSys 2025", "Oct 2025", "past",
            "Addressing the cold-start problem in recommendation systems using content-based bootstrapping and contextual bandits. Shows how we achieved 85% of warm-start performance for new users within their first three interactions.",
            ["RecSys", "ML", "Cold Start"]),
        new("t7", "Aarav Sharma", "AS", "From Monolith to Microservices Without the Drama", "Strange Loop", "Sep 2025", "past",
            "An honest account of our two-year migration from a Rails monolith to Go microservices. Covers the strangler fig pattern, shared database anti-patterns we fell into, and why we kept the monolith running longer than planned.",
            ["Microservices", "Go", "Migration"]),
    ];
}
