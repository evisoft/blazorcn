@* ============================================================
   Block: team-customer-facing
   Title: Team Customer Facing
   Description: Customer success and support team directory with specialization, availability status dots, response times, and language chips
   Dependencies: none (pure HTML/Tailwind)
   Source: original/blocks/team/team-customer-facing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideHeadphonesCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">Support team</span>
            <div class="ml-auto flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-xs text-muted-foreground">@_members.Count(m => m.Status == "available") available</span>
            </div>
        </div>

        @foreach (var member in _members)
        {
            var isExpanded = _expanded == member.Name;
            <div class="border-b last:border-b-0">
                <button type="button"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => _expanded = isExpanded ? null : member.Name)">
                    <div class="relative">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                            @member.Initials
                        </div>
                        <span class="@Cn.Merge("absolute -right-0.5 -top-0.5 size-2.5 rounded-full border-2 border-card", member.Status == "available" ? "bg-emerald-500" : "bg-amber-500")"></span>
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="truncate text-sm font-medium">@member.Name</span>
                            <span class="shrink-0 rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                @member.Specialization
                            </span>
                        </div>
                        <div class="mt-0.5 flex items-center gap-2">
                            <span class="font-mono text-xs text-muted-foreground">
                                @member.ResponseTime
                            </span>
                            <span class="text-xs text-muted-foreground/60">avg response</span>
                        </div>
                    </div>
                    <LucideChevronRightCn Size="16"
                                          Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                </button>
                @if (isExpanded)
                {
                    <div class="border-t bg-muted/30 px-4 py-3">
                        <p class="text-xs font-medium text-muted-foreground">Languages</p>
                        <div class="mt-1.5 flex flex-wrap gap-1.5">
                            @foreach (var lang in member.Languages)
                            {
                                <span class="rounded bg-background px-2 py-0.5 text-xs text-foreground">
                                    @lang
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record SupportMember(string Name, string Initials, string Specialization, string Status, string ResponseTime, string[] Languages);

    private string? _expanded;

    private static readonly SupportMember[] _members =
    [
        new("Camila Reyes", "CR", "Onboarding", "available", "< 2 min", ["English", "Spanish", "Portuguese"]),
        new("Henrik Johansson", "HJ", "Technical Support", "available", "< 5 min", ["English", "Swedish", "German"]),
        new("Priya Sharma", "PS", "Enterprise", "busy", "< 15 min", ["English", "Hindi", "Punjabi"]),
        new("Lucas Fernandez", "LF", "Billing", "available", "< 3 min", ["English", "Spanish"]),
        new("Yolanda Osei", "YO", "Technical Support", "available", "< 4 min", ["English", "French"]),
        new("Kenji Watanabe", "KW", "Enterprise", "busy", "< 10 min", ["English", "Japanese"]),
        new("Amara Okafor", "AO", "Onboarding", "available", "< 2 min", ["English", "Yoruba", "French"]),
        new("Tobias Muller", "TM", "Billing", "available", "< 3 min", ["English", "German", "Dutch"]),
    ];
}
