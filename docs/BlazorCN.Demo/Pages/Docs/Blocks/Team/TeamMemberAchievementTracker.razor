@* ============================================================
   Block: team-member-achievement-tracker
   Title: TeamMemberAchievementTracker
   Description: A team member achievements and badge showcase block for React and Next.js displaying accomplishments and recognition built with shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-member-achievement-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="space-y-6">
        @* Header *@
        <div>
            <h2 class="text-sm font-medium">Achievements</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Celebrating team accomplishments</p>
        </div>

        @* Members and Achievements *@
        <div class="space-y-6">
            @foreach (var mem in _members)
            {
                var member = mem;
                <div class="space-y-3">
                    <div>
                        <h3 class="text-sm font-medium">@member.Name</h3>
                        <p class="text-xs text-muted-foreground">
                            @member.Achievements.Length achievement@(member.Achievements.Length != 1 ? "s" : "")
                        </p>
                    </div>

                    @* Achievement Grid *@
                    <div class="grid gap-3 grid-cols-1 sm:grid-cols-2">
                        @foreach (var ach in member.Achievements)
                        {
                            var achievement = ach;
                            var config = GetConfig(achievement.AchievementType);
                            <div class="@Cn.Merge("rounded-lg border p-3", config.BgColor)">
                                <div class="flex items-start gap-2">
                                    <span class="@Cn.Merge("shrink-0", config.Color)">
                                        <LucideIconCn Name="@achievement.IconName" Size="20" Class="size-5" />
                                    </span>
                                    <div class="min-w-0 flex-1">
                                        <h4 class="text-sm font-medium">@achievement.Title</h4>
                                        <p class="mt-0.5 text-xs text-muted-foreground">
                                            @achievement.Description
                                        </p>
                                        <div class="mt-2">
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                                                @achievement.EarnedDate
                                            </BadgeCn>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum AchievementType { Badge, Milestone, Award, Certification }

    private record AchievementConfig(string Color, string BgColor);

    private record Achievement(string Id, string Title, string Description, AchievementType AchievementType, string EarnedDate, string IconName);

    private record TeamMemberAchievements(string Id, string Name, Achievement[] Achievements);

    private static AchievementConfig GetConfig(AchievementType type) => type switch
    {
        AchievementType.Badge         => new("text-amber-600 dark:text-amber-400",   "bg-amber-500/10"),
        AchievementType.Milestone     => new("text-emerald-600 dark:text-emerald-400", "bg-emerald-500/10"),
        AchievementType.Award         => new("text-red-600 dark:text-red-400",       "bg-red-500/10"),
        AchievementType.Certification => new("text-blue-600 dark:text-blue-400",     "bg-blue-500/10"),
        _                             => new("text-muted-foreground",                "bg-muted"),
    };

    private static readonly TeamMemberAchievements[] _members =
    [
        new("1", "Sarah Chen",
        [
            new("a1", "Launch Leader",    "Led successful product launch to 50K+ users",        AchievementType.Award,         "Mar 2026", "trophy"),
            new("a2", "Mentor Master",    "Mentored 3 junior team members successfully",         AchievementType.Badge,         "Feb 2026", "star"),
            new("a3", "Milestone: 2 Years", "2 years of continuous contributions",              AchievementType.Milestone,     "Jan 2026", "medal"),
        ]),
        new("2", "Marcus Rodriguez",
        [
            new("a4", "Performance Certified", "Completed backend optimization certification",  AchievementType.Certification, "Mar 2026", "award"),
            new("a5", "On Fire Streak",  "100 commits in a month - top contributor",            AchievementType.Badge,         "Mar 2026", "zap"),
        ]),
    ];
}
