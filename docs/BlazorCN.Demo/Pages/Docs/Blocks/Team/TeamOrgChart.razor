@* ============================================================
   Block: team-org-chart
   Title: Team Org Chart
   Description: Hierarchical indented team list showing reporting structure with CEO, departments, and team members
   Dependencies: none (pure HTML/Tailwind)
   Source: original/blocks/team/team-org-chart.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Organization</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                A flat, transparent structure designed for speed.
            </p>
        </div>

        @* CEO *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                EV
            </div>
            <div class="min-w-0 flex-1">
                <span class="text-sm font-medium">Elena Vasquez</span>
                <p class="text-xs text-muted-foreground">Chief Executive Officer</p>
            </div>
        </div>

        @* Departments *@
        @for (var deptIndex = 0; deptIndex < _departments.Length; deptIndex++)
        {
            var dept = _departments[deptIndex];
            <div>
                @* Department header *@
                <div class="border-b bg-muted/30 px-4 py-2">
                    <span class="text-xs font-medium text-muted-foreground">@dept.Name</span>
                </div>

                @* Department lead *@
                <div class="flex items-center gap-3 border-b py-3 pl-8 pr-4">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @dept.LeadInitials
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="text-sm font-medium">@dept.LeadName</span>
                        <p class="text-xs text-muted-foreground">@dept.LeadRole</p>
                    </div>
                </div>

                @* Team members *@
                @for (var memberIndex = 0; memberIndex < dept.Members.Length; memberIndex++)
                {
                    var member = dept.Members[memberIndex];
                    var isLastMember = memberIndex == dept.Members.Length - 1;
                    var isLastDept = deptIndex == _departments.Length - 1;
                    var showBorder = !(isLastMember && isLastDept);
                    <div class="@Cn.Merge("flex items-center gap-3 py-3 pl-14 pr-4", showBorder ? "border-b" : "")">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                            @member.Initials
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@member.Name</span>
                            <p class="text-xs text-muted-foreground">@member.Role</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record OrgMember(string Name, string Role, string Initials);
    private record Department(string Name, string LeadName, string LeadRole, string LeadInitials, OrgMember[] Members);

    private static readonly Department[] _departments =
    [
        new("Engineering", "Tobias Richter", "VP of Engineering", "TR",
        [
            new("Lena Kowalski", "Engineering Lead, Frontend", "LK"),
            new("Amara Osei", "Engineering Lead, Platform", "AO"),
        ]),
        new("Product & Design", "Priya Sharma", "VP of Product & Design", "PS",
        [
            new("Marcus Chen", "Product Lead, Enterprise", "MC"),
            new("Sophie Dubois", "Design Lead", "SD"),
        ]),
    ];
}
