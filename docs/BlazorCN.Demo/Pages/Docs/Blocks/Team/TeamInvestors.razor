@* ============================================================
   Block: team-investors
   Title: Team Investors and Board Members
   Description: Investor and board member profile section with initials, name, title, firm chip, role label, and investment focus
   Dependencies: none (pure HTML/Tailwind)
   Source: original/blocks/team/team-investors.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Investors &amp; Board</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Backed by leading venture firms and operators
            </p>
        </div>

        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div>
                <p class="text-2xl font-semibold tabular-nums">$26.4M</p>
                <p class="text-xs text-muted-foreground">total raised</p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-2xl font-semibold tabular-nums">3</p>
                <p class="text-xs text-muted-foreground">rounds closed</p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-2xl font-semibold tabular-nums">6</p>
                <p class="text-xs text-muted-foreground">investors</p>
            </div>
        </div>

        <div class="border-b px-4 py-2">
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Lead Investor
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    Board Member
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                    Advisor
                </span>
            </div>
        </div>

        @foreach (var investor in _investors)
        {
            <div class="border-b px-4 py-3 last:border-b-0">
                <div class="flex items-start gap-3">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @investor.Initials
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-baseline gap-2">
                            <span class="text-sm font-medium">@investor.Name</span>
                            <span class="@Cn.Merge("text-xs font-medium", GetRoleStyle(investor.Role))">
                                @investor.Role
                            </span>
                        </div>
                        <div class="mt-0.5 flex items-baseline gap-2">
                            <span class="text-xs text-muted-foreground">@investor.Title</span>
                            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                @investor.Firm
                            </span>
                        </div>
                        <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
                            @investor.Focus
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Investor(string Name, string Title, string Firm, string Initials, string Role, string Focus);

    private static readonly Investor[] _investors =
    [
        new("Katherine Zhao", "General Partner", "Sequoia Capital", "KZ", "Lead Investor",
            "Enterprise infrastructure and developer platforms. Led Series A and B rounds. Board observer since 2021."),
        new("Marcus Webb", "Managing Director", "Accel Partners", "MW", "Board Member",
            "Open-source commercialization and product-led growth. Co-led Series B with a focus on go-to-market acceleration."),
        new("Amara Okafor", "Partner", "Andreessen Horowitz", "AO", "Lead Investor",
            "API-first platforms and AI infrastructure. Led the seed round and introduced the founding team to three key enterprise customers."),
        new("Henrik Larsen", "Venture Partner", "Index Ventures", "HL", "Board Member",
            "European expansion strategy and talent acquisition. Previously CEO of a $2B developer tools company acquired by Microsoft."),
        new("Priya Mehta", "Principal", "Lightspeed Venture Partners", "PM", "Advisor",
            "Data infrastructure and analytics platforms. Connects portfolio companies for co-selling partnerships in the enterprise segment."),
        new("David Tannenbaum", "Angel Investor", "Independent", "DT", "Advisor",
            "Former CTO of GitHub. Advises on engineering culture, developer experience, and open-source community building strategy."),
    ];

    private static string GetRoleStyle(string role) => role switch
    {
        "Lead Investor" => "text-emerald-600 dark:text-emerald-400",
        "Board Member" => "text-blue-600 dark:text-blue-400",
        _ => "text-muted-foreground",
    };
}
