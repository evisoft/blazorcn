@* ============================================================
   Block: team-animated-timeline
   Title: Team Animated Timeline
   Description: Animated company hiring timeline with staggered entrance, pulsing dots, and connecting vertical line using framer-motion for React about pages
   Long Description: Static vertical timeline with company milestones
   Dependencies: None
   Source: original/blocks/team/team-animated-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Hiring timeline</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                From two co-founders to 45 employees
            </p>
        </div>

        @for (var i = 0; i < _milestones.Length; i++)
        {
            var milestone = _milestones[i];
            <div class="@Cn.Merge("flex gap-3 px-4 py-3", i < _milestones.Length - 1 ? "border-b" : "")">
                <div class="flex flex-col items-center pt-1.5">
                    <span class="size-1.5 shrink-0 rounded-full bg-foreground"></span>
                    @if (i < _milestones.Length - 1)
                    {
                        <div class="mt-1.5 w-px flex-1 bg-border"></div>
                    }
                </div>
                <div class="min-w-0 flex-1 pb-1">
                    <div class="flex items-center gap-2">
                        <span class="font-mono text-xs text-muted-foreground">@milestone.Date</span>
                        <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                            @milestone.Department
                        </span>
                    </div>
                    <p class="mt-0.5 text-sm font-medium">@milestone.Name</p>
                    <p class="text-xs text-muted-foreground">@milestone.Role</p>
                    <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
                        @milestone.Description
                    </p>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record MilestoneItem(string Date, string Name, string Role, string Department, string Description);

    private static readonly MilestoneItem[] _milestones =
    [
        new("Jan 2019", "Ingrid Solberg", "Co-founder & CEO", "Leadership",
            "Incorporated the company after meeting James at a developer conference in Copenhagen. First prototype built in two weeks."),
        new("Jan 2019", "James Okoye", "Co-founder & CTO", "Engineering",
            "Architected the core platform from day one. Previously built distributed systems at Cloudflare processing millions of requests per second."),
        new("Mar 2020", "Mei-Lin Wu", "First Engineer", "Engineering",
            "Joined from Cloudflare as the first engineering hire. Built the initial API layer and deployment pipeline that still runs today."),
        new("Feb 2021", "Anders Holm", "VP of Design", "Design",
            "Established the design system and component library. Previously redesigned host onboarding at Airbnb, reducing drop-off by 34 percent."),
        new("Jun 2021", "Priya Kapoor", "VP of Product", "Product",
            "Brought a prioritization framework from Linear that transformed how the team evaluates and ships features at speed."),
        new("Jan 2023", "Felix Brennan", "Head of Growth", "Marketing",
            "Designed the referral system that now drives 40 percent of organic signups. Previously led growth experiments at Spotify."),
        new("Mar 2024", "Yuki Tanaka", "Head of Data", "Engineering",
            "Built recommendation systems at Mercari powering 30 percent of transactions. Team reached 45 employees across 3 offices."),
    ];
}
