@* ============================================================
   Block: team-member-time-off-calendar
   Title: TeamMemberTimeOffCalendar
   Description: A time off and vacation calendar block for React and Next.js displaying team availability built with shadcn/ui and Tailwind CSS
   Source: original/blocks/team/team-member-time-off-calendar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="space-y-4">

        <div>
            <h2 class="text-sm font-medium">Team Time Off</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Upcoming absences and time off</p>
        </div>

        <div class="space-y-2">
            @foreach (var item in _timeOff)
            {
                <div class="flex items-center justify-between rounded-lg border bg-card px-4 py-2.5">
                    <div>
                        <p class="text-sm font-medium">@item.Name</p>
                        <p class="text-xs text-muted-foreground">@item.Dates</p>
                    </div>
                    <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                        @item.Reason
                    </BadgeCn>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record TimeOffEntry(string Name, string Dates, string Reason);

    private static readonly TimeOffEntry[] _timeOff =
    [
        new("Sarah Chen", "Apr 1-7", "Vacation"),
        new("Marcus Rodriguez", "Apr 15-16", "Sick day"),
        new("Emily Watson", "Apr 20-21", "Conference"),
    ];
}
