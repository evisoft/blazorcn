@* ============================================================
   Block: team-animated-contributors
   Title: Team Animated Contributors
   Description: Open source contributor grid with commit counts, contribution bars, and repository lists
   Long Description: Dense grid of contributor initials
   Dependencies: None
   Source: original/blocks/team/team-animated-contributors.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Contributors</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_contributors.Length people building in the open
            </p>
        </div>

        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium tabular-nums">
                    @_contributors.Sum(c => c.Commits).ToString("N0")
                </p>
                <p class="text-xs text-muted-foreground">Total commits</p>
            </div>
            <span class="size-1 rounded-full bg-border"></span>
            <div>
                <p class="text-sm font-medium tabular-nums">@_contributors.Length</p>
                <p class="text-xs text-muted-foreground">Contributors</p>
            </div>
        </div>

        <div class="grid grid-cols-3 gap-px bg-border sm:grid-cols-4">
            @foreach (var contributor in _contributors)
            {
                var barWidth = (double)contributor.Commits / _maxCommits * 100;
                <div class="relative flex flex-col items-center gap-1.5 bg-card px-2 py-3">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @contributor.Initials
                    </div>
                    <p class="max-w-full truncate text-xs text-muted-foreground">
                        @contributor.Name.Split(' ')[0]
                    </p>
                    <span class="text-sm font-semibold tabular-nums">@contributor.Commits</span>
                    <div class="h-1 w-full rounded-full bg-muted">
                        <div class="h-1 rounded-full bg-foreground/20" style="@($"width: {barWidth:F0}%")"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Contributor(string Name, string Initials, int Commits, string[] Repos);

    private static readonly Contributor[] _contributors =
    [
        new("Zara Ahmed", "ZA", 342, ["ui-core", "docs", "cli"]),
        new("Kenji Watanabe", "KW", 287, ["ui-core", "testing"]),
        new("Camila Reyes", "CR", 256, ["cli", "templates"]),
        new("Marcus Bell", "MB", 231, ["docs", "examples"]),
        new("Aaliya Rahman", "AR", 198, ["ui-core", "themes"]),
        new("Tobias Muller", "TM", 176, ["testing", "ci"]),
        new("Yolanda Osei", "YO", 165, ["templates", "docs"]),
        new("Devi Chandrasekaran", "DC", 154, ["ui-core"]),
        new("Henrik Johansson", "HJ", 143, ["cli", "docs"]),
        new("Priya Sharma", "PS", 132, ["themes", "ui-core"]),
        new("Lucas Fernandez", "LF", 128, ["examples"]),
        new("Amara Okafor", "AO", 119, ["docs", "cli"]),
    ];

    private static readonly int _maxCommits = _contributors.Max(c => c.Commits);
}
