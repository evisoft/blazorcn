@* ============================================================
   Block: team-flip-cards
   Title: Team Flip Cards
   Description: Expandable team member rows with chevron rotation revealing personal quotes and bios on click
   Dependencies: LucideChevronRightCn
   Source: original/blocks/team/team-flip-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Team</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Click a row to learn more about each person.</p>
        </div>
        @for (var i = 0; i < _members.Length; i++)
        {
            var idx = i;
            var member = _members[i];
            var isExpanded = _expanded.Contains(idx);
            <div class="@(i < _members.Length - 1 ? "border-b" : "")">
                <button type="button" @onclick="@(() => Toggle(idx))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@member.Initials</div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@member.Name</span>
                            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@member.Department</span>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">@member.Role</p>
                    </div>
                    <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                </button>
                @if (isExpanded)
                {
                    <div class="px-4 pb-3 pl-15">
                        <p class="text-xs italic text-muted-foreground leading-relaxed">&ldquo;@member.Quote&rdquo;</p>
                        <p class="mt-2 text-xs text-muted-foreground leading-relaxed">@member.Bio</p>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private readonly HashSet<int> _expanded = new();

    private void Toggle(int index)
    {
        if (!_expanded.Remove(index))
        {
            _expanded.Add(index);
        }
    }

    private record MemberItem(string Name, string Role, string Department, string Bio, string Quote, string Initials);
    private static readonly MemberItem[] _members =
    [
        new("Soren Lindqvist", "Chief Executive Officer", "Leadership", "Founded the company after leading product strategy at Shopify for six years. Scaled the Shopify App Store from 2,000 to 10,000 apps.", "Build for the merchant who has ten minutes, not the one who has ten hours.", "SL"),
        new("Amara Osei", "VP of Engineering", "Engineering", "Previously principal engineer at Vercel, where she designed the incremental static regeneration pipeline. Passionate about build performance.", "A fast deploy pipeline is the single best retention tool for engineering talent.", "AO"),
        new("Kai Nakamura", "Head of Design", "Design", "Led design systems at Spotify for four years, building the internal component library used by 300 designers across the organization.", "If the user notices the interface, something went wrong.", "KN"),
        new("Elena Vasquez", "Head of Product", "Product", "Ran product at Loom during its growth from 5 million to 25 million users. Expert in product-led growth and activation funnels.", "Every onboarding screen is either earning trust or burning it.", "EV"),
        new("Marcus Otieno", "Staff Engineer", "Engineering", "Eight years building real-time collaboration at Figma. Architected the conflict resolution engine powering multiplayer editing.", "Distributed systems are easy until two people press save at the same time.", "MO"),
        new("Clara Johansson", "Head of Marketing", "Marketing", "Built the content-led growth engine at Webflow that drove 60% of organic signups. Specializes in developer marketing.", "The best marketing feels like a gift, not an ask.", "CJ"),
    ];
}
