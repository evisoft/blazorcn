@* ============================================================
   Block: team-animated-tabs
   Title: Team Animated Tabs
   Description: Animated department tabs with smooth enter and exit transitions using AnimatePresence and framer-motion for React team directory pages
   Long Description: Static tabbed team section filtered by department
   Dependencies: None
   Source: original/blocks/team/team-animated-tabs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Team directory</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Browse by department</p>
        </div>

        <div class="flex gap-0 overflow-x-auto border-b">
            @foreach (var dept in _departments)
            {
                <button
                    type="button"
                    @onclick="@(() => _activeTab = dept)"
                    class="@Cn.Merge("relative shrink-0 px-4 py-3 text-xs font-medium transition-colors", _activeTab == dept ? "text-foreground" : "text-muted-foreground hover:text-foreground")">
                    @dept
                    @if (_activeTab == dept)
                    {
                        <div class="absolute inset-x-0 bottom-0 h-0.5 bg-foreground"></div>
                    }
                </button>
            }
        </div>

        <div>
            @{ var filtered = _allMembers.Where(m => m.Department == _activeTab).ToArray(); }
            @for (var i = 0; i < filtered.Length; i++)
            {
                var member = filtered[i];
                var isLast = i == filtered.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @member.Initials
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@member.Name</p>
                        <p class="text-xs text-muted-foreground">@member.Role</p>
                    </div>
                    <span class="text-xs text-muted-foreground">@member.Location</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string _activeTab = "Engineering";

    private static readonly string[] _departments = ["Engineering", "Design", "Product", "Marketing"];

    private record MemberItem(string Name, string Role, string Initials, string Department, string Location);

    private static readonly MemberItem[] _allMembers =
    [
        new("Mei-Lin Wu", "VP of Engineering", "MW", "Engineering", "San Francisco"),
        new("David Kim", "Staff Software Engineer", "DK", "Engineering", "Seattle"),
        new("James O'Brien", "Senior Backend Engineer", "JO", "Engineering", "Dublin"),
        new("Fatima Al-Rashid", "Platform Engineer", "FA", "Engineering", "London"),
