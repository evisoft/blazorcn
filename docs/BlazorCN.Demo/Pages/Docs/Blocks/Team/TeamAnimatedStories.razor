@* ============================================================
   Block: team-animated-stories
   Title: Team Animated Stories
   Description: Team member stories and testimonials carousel with word-stagger quote animation, auto-advance, and dot navigation for React about pages
   Long Description: Grid of team quotes and testimonials
   Dependencies: ButtonCn, LucideChevronLeftCn, LucideChevronRightCn
   Source: original/blocks/team/team-animated-stories.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Team stories</p>
                <p class="mt-0.5 text-xs text-muted-foreground">In their own words</p>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7" @onclick="GoPrev">
                    <LucideChevronLeftCn Size="16" />
                </ButtonCn>
                <span class="min-w-[3ch] text-center text-xs tabular-nums text-muted-foreground">
                    @(_current + 1)/@_stories.Length
                </span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7" @onclick="GoNext">
                    <LucideChevronRightCn Size="16" />
                </ButtonCn>
            </div>
        </div>

        <div class="px-4 py-6">
            <p class="text-sm leading-relaxed">
                <span class="mr-1 text-muted-foreground">&ldquo;</span>@CurrentStory.Quote<span class="ml-0.5 text-muted-foreground">&rdquo;</span>
            </p>

            <div class="mt-4 flex items-center gap-3">
                <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                    @CurrentStory.Initials
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium">@CurrentStory.Name</p>
                    <p class="text-xs text-muted-foreground">@CurrentStory.Role</p>
                </div>
                <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                    @CurrentStory.Department
                </span>
            </div>
        </div>

        <div class="flex items-center justify-center gap-1.5 border-t px-4 py-3">
            @for (var i = 0; i < _stories.Length; i++)
            {
                var idx = i;
                <button type="button" @onclick="@(() => GoTo(idx))" class="p-1">
                    <div class="@Cn.Merge("h-1.5 rounded-full", idx == _current ? "w-6 bg-foreground" : "w-1.5 bg-foreground/20")"></div>
                </button>
            }
        </div>
    </div>
</section>

@code {
    private int _current;

    private StoryItem CurrentStory => _stories[_current];

    private void GoTo(int index) => _current = index;

    private void GoPrev() => _current = (_current - 1 + _stories.Length) % _stories.Length;

    private void GoNext() => _current = (_current + 1) % _stories.Length;

    private record StoryItem(string Name, string Role, string Initials, string Department, string Quote);

    private static readonly StoryItem[] _stories =
    [
        new("Mei-Lin Wu", "VP of Engineering", "MW", "Engineering",
            "I joined as the first engineer when we were still writing code in a coffee shop. Watching this team grow from three people to a real engineering organization has been the most rewarding chapter of my career."),
        new("Anders Holm", "VP of Design", "AH", "Design",
            "What drew me here was the founders' obsession with craft. Every pixel matters. We ship fast but we never ship sloppy. The design culture here rivals anything I experienced at Airbnb."),
        new("Priya Kapoor", "VP of Product", "PK", "Product",
            "The thing that makes this place special is how we prioritize. No feature factories, no vanity metrics. We talk to customers every single week and build what actually moves the needle."),
        new("Felix Brennan", "Head of Growth", "FB", "Marketing",
            "I have never worked somewhere with this much product-market fit. Our users genuinely love what we build. My job is just making sure more developers discover us."),
        new("Sofia Reyes", "Staff Engineer", "SR", "Engineering",
            "The technical challenges here are genuinely hard problems. Distributed systems at scale, real-time collaboration, edge computing. Every sprint teaches me something new."),
    ];
}
