@* ============================================================
   Block: team-stats-overview
   Title: Team Stats Overview
   Description: Team statistics dashboard with headcount metrics, department breakdown rows with proportion indicators, and growth stats
   Dependencies: None
   Source: original/blocks/team/team-stats-overview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Team overview</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Key metrics and department breakdown</p>
        </div>

        <div class="grid grid-cols-2 gap-0 border-b sm:grid-cols-4">
            @for (var i = 0; i < _metrics.Length; i++)
            {
                var metric = _metrics[i];
                <div class="@Cn.Merge("px-4 py-3", i < _metrics.Length - 1 ? "border-r" : "")">
                    <p class="text-xs text-muted-foreground">@metric.Label</p>
                    <p class="mt-0.5 text-2xl font-semibold tabular-nums">@metric.Value</p>
                </div>
            }
        </div>

        <div class="border-b px-4 py-2.5">
            <p class="text-xs font-medium text-muted-foreground">Department breakdown</p>
        </div>

        @for (var i = 0; i < _departments.Length; i++)
        {
            var dept = _departments[i];
            var percentage = (int)Math.Round((double)dept.Headcount / MaxHeadcount * 100);
            <div class="@Cn.Merge("px-4 py-2.5", i < _departments.Length - 1 ? "border-b" : "")">
                <div class="flex items-center justify-between">
                    <div class="flex items-baseline gap-2">
                        <span class="text-sm font-medium">@dept.Name</span>
                        <span class="font-mono text-xs text-muted-foreground">@dept.Headcount</span>
                    </div>
                    <span class="text-xs text-muted-foreground">@dept.Growth</span>
                </div>
                <div class="mt-1.5 h-1.5 w-full rounded-full bg-muted">
                    <div class="h-1.5 rounded-full bg-foreground/20" style="@($"width: {percentage}%")"></div>
                </div>
            </div>
        }

        <div class="border-t px-4 py-2.5">
            <p class="text-xs font-medium text-muted-foreground">Growth</p>
        </div>

        <div class="grid grid-cols-3 border-t">
            @for (var i = 0; i < _growthStats.Length; i++)
            {
                var stat = _growthStats[i];
                <div class="@Cn.Merge("px-4 py-3", i < _growthStats.Length - 1 ? "border-r" : "")">
                    <p class="text-xs text-muted-foreground">@stat.Label</p>
                    <p class="mt-0.5 text-lg font-semibold tabular-nums">@stat.Value</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@stat.Subtext</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private const int MaxHeadcount = 58;

    private record MetricItem(string Label, string Value);
    private static readonly MetricItem[] _metrics =
    [
        new("Headcount", "142"),
        new("Countries", "18"),
        new("Avg. tenure", "2.4y"),
        new("Open roles", "12"),
    ];

    private record DepartmentItem(string Name, int Headcount, string Growth);
    private static readonly DepartmentItem[] _departments =
    [
        new("Engineering", 58, "+12 YoY"),
        new("Product", 22, "+5 YoY"),
        new("Design", 18, "+4 YoY"),
        new("Marketing", 16, "+3 YoY"),
        new("Sales", 14, "+2 YoY"),
        new("Operations", 8, "+1 YoY"),
        new("People & HR", 6, "+2 YoY"),
    ];

    private record GrowthStatItem(string Label, string Value, string Subtext);
    private static readonly GrowthStatItem[] _growthStats =
    [
        new("YoY growth", "+26%", "vs. 18% last year"),
        new("Retention", "94%", "12-month rolling"),
        new("Offer acceptance", "88%", "across all roles"),
    ];
}
