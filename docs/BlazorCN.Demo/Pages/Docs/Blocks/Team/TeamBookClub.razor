@* ============================================================
   Block: team-book-club
   Title: Team Book Club
   Description: Team book club with currently reading featured book, progress tracking, discussion date, and past reads list
   Dependencies: none (pure HTML/Tailwind)
   Source: original/blocks/team/team-book-club.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideBookOpenCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm font-medium">Book club</span>
            <span class="ml-auto text-xs text-muted-foreground">
                @_pastReads.Length books read
            </span>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">Currently reading</p>
            <p class="mt-1.5 text-sm font-medium">Thinking in Systems</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Donella H. Meadows</p>
            <div class="mt-3 flex items-center gap-3">
                <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                    <div class="h-full rounded-full bg-foreground" style="width: 64%"></div>
                </div>
                <span class="shrink-0 font-mono text-xs text-muted-foreground">64%</span>
            </div>
            <div class="mt-2.5 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">
                        PC
                    </div>
                    <span class="text-xs text-muted-foreground">
                        Picked by Priya Chandrasekaran
                    </span>
                </div>
                <span class="text-xs text-muted-foreground">
                    Discussion Mar 28, 2026
                </span>
            </div>
        </div>

        <div class="border-b px-4 py-2.5">
            <p class="text-xs font-medium text-muted-foreground">Past reads</p>
        </div>

        @foreach (var book in _pastReads)
        {
            var isExpanded = _expandedBook == book.Title;
            <div class="border-b last:border-b-0">
                <button type="button"
                        class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => _expandedBook = isExpanded ? null : book.Title)">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="truncate text-sm font-medium">@book.Title</span>
                            <span class="shrink-0 rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                @book.Category
                            </span>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">@book.Author</p>
                    </div>
                    <LucideChevronRightCn Size="16"
                                          Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                </button>
                @if (isExpanded)
                {
                    <div class="border-t bg-muted/30 px-4 py-3">
                        <div class="flex items-center gap-2">
                            <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-background text-[10px] font-medium">
                                @book.Initials
                            </div>
                            <span class="text-xs text-muted-foreground">
                                Recommended by
                                <span class="font-medium text-foreground">@book.RecommendedBy</span>
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record PastRead(string Title, string Author, string RecommendedBy, string Initials, string Category);

    private string? _expandedBook;

    private static readonly PastRead[] _pastReads =
    [
        new("The Staff Engineer's Path", "Tanya Reilly", "Marcus Johnson", "MJ", "Engineering"),
        new("Inspired", "Marty Cagan", "Yuki Tanaka", "YT", "Product"),
        new("Team Topologies", "Matthew Skelton & Manuel Pais", "Elena Rodriguez", "ER", "Organization"),
        new("Radical Candor", "Kim Scott", "Aisha Patel", "AP", "Leadership"),
        new("Designing Data-Intensive Applications", "Martin Kleppmann", "David Kim", "DK", "Engineering"),
        new("Shape Up", "Ryan Singer", "Lena Johansson", "LJ", "Product"),
    ];
}
