@* ============================================================
   Block: team-animated-mentors
   Title: Team Animated Mentors
   Description: Mentorship pairs with animated SVG connection arrows that draw themselves, staggered pair entrances, and highlighted connections on hover using framer-motion
   Long Description: Static mentorship pairs display
   Dependencies: None
   Source: original/blocks/team/team-animated-mentors.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Mentorship program</p>
            <p class="mt-0.5 text-xs text-muted-foreground">@_pairs.Length active pairs</p>
        </div>

        @for (var i = 0; i < _pairs.Length; i++)
        {
            var pair = _pairs[i];
            <div class="@Cn.Merge("px-4 py-3", i < _pairs.Length - 1 ? "border-b" : "")">
                <div class="flex items-center gap-3">
                    <div class="flex items-center gap-2">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                            @pair.MentorInitials
                        </div>
                        <svg width="40" height="16" viewBox="0 0 40 16" fill="none" class="shrink-0" aria-hidden="true">
                            <title>Connection arrow</title>
                            <path d="M2 8 L30 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="text-muted-foreground/40"></path>
                            <path d="M28 4 L34 8 L28 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none" class="text-muted-foreground/40"></path>
                        </svg>
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                            @pair.MenteeInitials
                        </div>
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-1">
                            <span class="truncate text-sm font-medium">@pair.MentorName</span>
                            <span class="text-xs text-muted-foreground/60">&rarr;</span>
                            <span class="truncate text-sm font-medium">@pair.MenteeName</span>
                        </div>
                        <div class="mt-0.5 flex items-center gap-2">
                            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                @pair.FocusArea
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record MentorPairItem(string Id, string MentorName, string MentorInitials, string MentorRole, string MenteeName, string MenteeInitials, string MenteeRole, string FocusArea);

    private static readonly MentorPairItem[] _pairs =
    [
        new("mp1", "Kofi Asante", "KA", "CTO", "Jordan Ellis", "JE", "Senior Engineer", "System design"),
        new("mp2", "Lucia Fernandez", "LF", "VP of Design", "Anh Nguyen", "AN", "Product Designer", "Design leadership"),
        new("mp3", "Maren Lindqvist", "ML", "CEO", "Ravi Mehta", "RM", "VP of Product", "Executive presence"),
        new("mp4", "Aarav Sharma", "AS", "Head of Engineering", "Maya Chen", "MC", "Software Engineer", "Backend architecture"),
        new("mp5", "Elise Beaumont", "EB", "VP of Product", "Diego Herrera", "DH", "Product Manager", "Career growth"),
        new("mp6", "Tomoko Nakamura", "TN", "Head of Data", "Sofia Martinez", "SM", "Data Analyst", "Machine learning"),
    ];
}
