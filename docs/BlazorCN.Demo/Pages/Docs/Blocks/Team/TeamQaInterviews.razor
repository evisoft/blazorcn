@* ============================================================
   Block: team-qa-interviews
   Title: Team QA Interviews
   Description: Quick Q&A interview spotlight showing rapid-fire questions and answers for each team member with selectable member list
   Dependencies: None
   Source: original/blocks/team/team-qa-interviews.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Quick Q&amp;A</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Get to know the team in their own words</p>
        </div>

        <div class="flex gap-0 overflow-x-auto border-b">
            @for (var mi = 0; mi < _members.Length; mi++)
            {
                var idx = mi;
                var m = _members[mi];
                <button type="button" @onclick="@(() => _selectedIndex = idx)"
                        class="@Cn.Merge("flex shrink-0 items-center gap-2 px-4 py-3 text-left transition-colors", _selectedIndex == idx ? "border-b-2 border-foreground" : "text-muted-foreground hover:text-foreground")">
                    <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">@m.Initials</div>
                    <span class="text-xs font-medium">@m.Name</span>
                </button>
            }
        </div>

        @{
            var selected = _members[_selectedIndex];
        }

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">@selected.Initials</div>
                <div>
                    <p class="text-sm font-medium">@selected.Name</p>
                    <p class="text-xs text-muted-foreground">@selected.Role</p>
                </div>
            </div>
        </div>

        @for (var i = 0; i < selected.Qna.Length; i++)
        {
            var pair = selected.Qna[i];
            <div class="@Cn.Merge("px-4 py-3", i < selected.Qna.Length - 1 ? "border-b" : "")">
                <p class="text-xs font-medium text-muted-foreground">@pair.Question</p>
                <p class="mt-1 text-sm leading-relaxed">@pair.Answer</p>
            </div>
        }
    </div>
</section>

@code {
    private int _selectedIndex;

    private record QAPair(string Question, string Answer);
    private record MemberItem(string Name, string Initials, string Role, QAPair[] Qna);

    private static readonly MemberItem[] _members =
    [
        new("Sana Mirza", "SM", "Engineering Manager",
        [
            new("What's your superpower?", "Turning vague requirements into shippable specs in a single meeting. My team calls it 'the translator.'"),
            new("Favorite tool right now?", "Linear. It changed how I think about project velocity and made standups actually useful."),
            new("Best advice you've received?", "Don't optimize for speed. Optimize for momentum. Speed without direction is just thrashing."),
            new("What do you do outside work?", "Trail running in the Pacific Northwest. I've done 14 ultras and counting."),
            new("One thing people get wrong about your role?", "That it's about managing people. It's really about managing context and removing friction."),
        ]),
        new("Tobias Muller", "TM", "Staff Designer",
        [
            new("What's your superpower?", "Making complex workflows feel obvious. If a user needs a tutorial, the design failed."),
            new("Favorite tool right now?", "Figma with the Variables feature. Design tokens across files changed everything for our system."),
            new("Best advice you've received?", "Ship the ugly version first. Polish is the enemy of learning."),
            new("What do you do outside work?", "Letterpress printing. There's something meditative about setting type by hand after a day of pixels."),
            new("One thing people get wrong about your role?", "That designers just make things pretty. We're problem solvers who happen to think visually."),
        ]),
        new("Amara Osei", "AO", "Product Lead",
        [
            new("What's your superpower?", "Saying no. Most product failures come from saying yes to everything. Focus is a feature."),
            new("Favorite tool right now?", "Notion databases for strategy docs. Everything lives in one connected workspace now."),
            new("Best advice you've received?", "Talk to customers every single week. Not monthly. Not quarterly. Weekly."),
            new("What do you do outside work?", "Competitive chess. I'm rated 1850 FIDE and play in local tournaments most weekends."),
            new("One thing people get wrong about your role?", "That PMs own the product. Engineers and designers own it. I own the why."),
        ]),
        new("Jonas Berg", "JB", "Senior Engineer",
        [
            new("What's your superpower?", "Debugging production issues at 2am with nothing but logs and intuition. Twelve years builds pattern recognition."),
            new("Favorite tool right now?", "Cursor with Claude. It doesn't write my code but it thinks alongside me in a way that compounds."),
            new("Best advice you've received?", "Write code that a junior engineer can understand on their first week. Cleverness is technical debt."),
            new("What do you do outside work?", "Building a cabin in northern Sweden with my partner. Hand tools only. It's our five-year project."),
            new("One thing people get wrong about your role?", "That senior means writing harder code. It means writing simpler code and making better tradeoffs."),
        ]),
    ];
}
