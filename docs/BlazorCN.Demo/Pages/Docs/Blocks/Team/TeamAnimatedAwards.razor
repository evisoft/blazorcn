@* ============================================================
   Block: team-animated-awards
   Title: Team Animated Awards
   Description: Awards recognition board with bouncing trophy icons, staggered row entrances, and expandable details using framer-motion AnimatePresence for React team pages
   Long Description: Celebrate your team's wins with an awards board that feels alive. Trophy and medal icons bounce into view with a satisfying overshoot animation while award rows cascade in with staggered timing. Click any row to expand award details with a smooth height transition powered by AnimatePresence. Each row shows the icon, title, recipient with initials, date, and category. Built with React, TypeScript, Tailwind CSS, and framer-motion for culture pages and internal dashboards.
   Dependencies: LucideChevronRightCn, LucideMedalCn, LucideTrophyCn
   Source: original/blocks/team/team-animated-awards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Awards &amp; recognition</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_awards.Length awards &middot; @_awards.Count(a => a.Type == "company") company &middot; @_awards.Count(a => a.Type == "individual") individual
            </p>
        </div>

        @foreach (var award in _awards)
        {
            var isExpanded = _expanded == award.Id;
            <div class="border-b last:border-b-0">
                <button
                    type="button"
                    @onclick="@(() => _expanded = isExpanded ? null : award.Id)"
                    class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted">
                        @if (award.Type == "company")
                        {
                            <LucideTrophyCn Size="16" Class="size-3.5 text-muted-foreground" />
                        }
                        else
                        {
                            <LucideMedalCn Size="16" Class="size-3.5 text-muted-foreground" />
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="truncate text-sm font-medium">@award.Title</span>
                        </div>
                        <div class="mt-0.5 flex items-center gap-1.5">
                            <div class="flex size-4 shrink-0 items-center justify-center rounded-full bg-muted text-[9px] font-medium">
                                @award.RecipientInitials
                            </div>
                            <span class="truncate text-xs text-muted-foreground">
                                @award.Recipient
                            </span>
                        </div>
                    </div>
                    <div class="flex shrink-0 items-center gap-2">
                        <span class="hidden rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground sm:inline">
                            @award.Category
                        </span>
                        <span class="font-mono text-xs text-muted-foreground">@award.Date</span>
                        <LucideChevronRightCn
                            Size="16"
                            Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </div>
                </button>

                @if (isExpanded)
                {
                    <div class="overflow-hidden">
                        <div class="border-t bg-muted/30 px-4 py-3">
                            <div class="ml-11">
                                <div class="flex items-center gap-2">
                                    <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                        @award.Category
                                    </span>
                                    <span class="@Cn.Merge("rounded px-1.5 py-0.5 text-xs", award.Type == "company" ? "bg-blue-500/10 text-blue-600 dark:text-blue-400" : "bg-amber-500/10 text-amber-600 dark:text-amber-400")">
                                        @(award.Type == "company" ? "Company-wide" : "Individual")
                                    </span>
                                </div>
                                <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                                    @award.Description
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private string? _expanded;

    private record AwardItem(string Id, string Title, string Recipient, string RecipientInitials, string Date, string Category, string Type, string Description);

    private static readonly AwardItem[] _awards =
    [
        new("a1", "Best Product Launch", "Entire Product Team", "PT", "Mar 2026", "Product", "company",
            "Recognized for the successful launch of the v3 platform, achieving 200% adoption targets in the first quarter with zero critical incidents."),
        new("a2", "Engineering Excellence", "Darian Reeves", "DR", "Feb 2026", "Engineering", "individual",
            "Reduced API response times by 62% through a complete rewrite of the query layer. Changes impacted 14 million daily requests."),
        new("a3", "Customer Champion", "Aisha Farouk", "AF", "Feb 2026", "Support", "individual",
            "Maintained a 98.7% satisfaction score across 1,200+ support interactions while building three self-service tools that reduced ticket volume by 35%."),
        new("a4", "Innovation Award", "ML Infrastructure Team", "ML", "Jan 2026", "Engineering", "company",
            "Designed and deployed an internal feature flag system with ML-powered rollout recommendations, adopted by all 12 engineering squads within two months."),
        new("a5", "Mentor of the Quarter", "Henrik Dahl", "HD", "Jan 2026", "Culture", "individual",
            "Mentored four junior engineers through their first production deployments. All mentees shipped independently within 60 days of joining."),
        new("a6", "Revenue Milestone", "Sales & Marketing", "SM", "Dec 2025", "Business", "company",
            "Surpassed $10M ARR milestone six months ahead of plan. Closed 48 enterprise accounts in Q4 with an average deal size of $42,000."),
    ];
}
