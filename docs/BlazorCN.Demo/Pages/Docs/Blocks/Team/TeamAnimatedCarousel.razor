@* ============================================================
   Block: team-animated-carousel
   Title: Team Animated Carousel
   Description: Horizontal team carousel with framer-motion crossfade transitions, directional sliding, and animated dot indicators for a React team section
   Long Description: Staggered grid entrance with hover lift effects
   Dependencies: ButtonCn, LucideChevronLeftCn, LucideChevronRightCn
   Source: original/blocks/team/team-animated-carousel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Team</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    @_members.Length people across @_totalPages groups
                </p>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7"
                          @onclick="@(() => GoTo(Math.Max(0, _page - 1)))" disabled="@(_page == 0)">
                    <LucideChevronLeftCn Size="16" Class="size-4" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7"
                          @onclick="@(() => GoTo(Math.Min(_totalPages - 1, _page + 1)))" disabled="@(_page == _totalPages - 1)">
                    <LucideChevronRightCn Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

        <div class="relative min-h-[200px]">
            @{ var visible = _members.Skip(_page * GroupSize).Take(GroupSize).ToArray(); }
            @for (var i = 0; i < visible.Length; i++)
            {
                var member = visible[i];
                <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3", i < visible.Length - 1 ? "border-b" : "")">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @member.Initials
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@member.Name</span>
                            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                @member.Department
                            </span>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">@member.Role</p>
                        <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                            @member.Bio
                        </p>
                    </div>
                </div>
            }
        </div>

        <div class="flex items-center justify-center gap-1.5 border-t px-4 py-3">
            @for (var i = 0; i < _totalPages; i++)
            {
                var pageIdx = i;
                <button
                    type="button"
                    @onclick="@(() => GoTo(pageIdx))"
                    class="relative flex items-center justify-center p-0.5"
                    aria-label="@($"Go to page {pageIdx + 1}")">
                    <span class="@Cn.Merge("block h-1.5 rounded-full", pageIdx == _page ? "w-4 bg-foreground" : "w-1.5 bg-muted-foreground/30")"></span>
                </button>
            }
        </div>
    </div>
</section>

@code {
    private const int GroupSize = 3;
    private int _page;
    private int _totalPages => (int)Math.Ceiling((double)_members.Length / GroupSize);

    private void GoTo(int newPage) => _page = newPage;

    private record MemberItem(string Name, string Role, string Bio, string Initials, string Department);

    private static readonly MemberItem[] _members =
    [
        new("Mia Thornton", "Chief Executive Officer", "Founded the company after a decade at Stripe building payment infrastructure. Passionate about developer tools and scaling engineering culture.", "MT", "Leadership"),
        new("Raj Kapoor", "VP of Engineering", "Former tech lead at Google Brain. Architected the real-time data pipeline and mentors the entire engineering organization.", "RK", "Engineering"),
        new("Nina Alexandrov", "Principal Designer", "Built the design system at Figma before joining as first designer. Obsessed with component architecture and accessible interfaces.", "NA", "Design"),
        new("James O'Brien", "Head of Growth", "Grew Notion's PLG motion from Series A to IPO. Deep expertise in product-led acquisition funnels and community building.", "JO", "Marketing"),
        new("Lena Kowalski", "Staff Engineer", "Core contributor to React Server Components at Meta. Leads the frontend platform team and runtime performance optimization efforts.", "LK", "Engineering"),
        new("Hassan Al-Rashid", "Director of Product", "Shipped enterprise features at Datadog that drove 40% ARR growth. Focuses on translating customer pain points into roadmap priorities.", "HA", "Product"),
        new("Sophie Dubois", "Senior Security Engineer", "Led SOC 2 and ISO 27001 certifications at two previous startups. Ensures infrastructure meets the highest compliance standards.", "SD", "Engineering"),
        new("Andre Williams", "Developer Advocate", "Conference speaker and open-source maintainer with 50k+ GitHub followers. Bridges the gap between product and the developer community.", "AW", "DevRel"),
        new("Yuki Tanaka", "Product Manager", "Former PM at Shopify building the developer platform. Expert in API design, third-party ecosystems, and developer experience metrics.", "YT", "Product"),
    ];
}
