@* ============================================================
   Block: dashboard-network-traffic
   Title: Dashboard Network Traffic
   Description: Animated React network traffic monitoring dashboard block for Next.js with inbound and outbound bandwidth counters, daily total transfer, 24-hour traffic bar chart, top IPs by traffic volume with geolocation chips, and bandwidth utilization progress bar using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Service availability tracking with 30-day charts
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-network-traffic.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Network Traffic</span>
            <span class="text-muted-foreground text-xs">Live</span>
        </div>

        @* Throughput stats *@
        <div class="flex items-center divide-x border-b">
            <div class="flex flex-1 flex-col px-4 py-3">
                <span class="text-muted-foreground text-xs">Inbound</span>
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-2xl tabular-nums">12.4</span>
                    <span class="text-muted-foreground text-xs">GB/s</span>
                </div>
            </div>
            <div class="flex flex-1 flex-col px-4 py-3">
                <span class="text-muted-foreground text-xs">Outbound</span>
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-2xl tabular-nums">8.7</span>
                    <span class="text-muted-foreground text-xs">GB/s</span>
                </div>
            </div>
            <div class="flex flex-1 flex-col px-4 py-3">
                <span class="text-muted-foreground text-xs">Total Today</span>
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-2xl tabular-nums">2.1</span>
                    <span class="text-muted-foreground text-xs">TB</span>
                </div>
            </div>
        </div>

        @* 24-hour bar chart *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">24-Hour Traffic</span>
                <span class="text-muted-foreground text-xs">Peak: 96 GB/h</span>
            </div>
            <div class="flex h-20 items-end gap-0.5">
                @for (var i = 0; i < _hourlyTraffic.Length; i++)
                {
                    var value = _hourlyTraffic[i];
                    var heightPct = (double)value / _peakTraffic * 100;
                    <div class="flex-1 rounded-t-[1px] bg-foreground/20"
                         style="@(FormattableString.Invariant($"height: {heightPct:F1}%"))"
                         title="@($"{i:D2}:00 \u2014 {value} GB")">
                    </div>
                }
            </div>
            <div class="mt-1 flex justify-between">
                <span class="font-mono text-muted-foreground text-[10px]">00:00</span>
                <span class="font-mono text-muted-foreground text-[10px]">12:00</span>
                <span class="font-mono text-muted-foreground text-[10px]">23:00</span>
            </div>
        </div>

        @* Top IPs *@
        <div class="border-b">
            <div class="px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Top IPs by Traffic</span>
            </div>
            @for (var i = 0; i < _topIps.Length; i++)
            {
                var entry = _topIps[i];
                var isLast = i == _topIps.Length - 1;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b"))">
                    <span class="min-w-0 flex-1 truncate font-mono text-xs">@entry.Ip</span>
                    <span class="inline-flex shrink-0 items-center rounded bg-muted/50 px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">
                        @entry.Location
                    </span>
                    <span class="shrink-0 font-medium text-xs tabular-nums">@entry.Traffic</span>
                </div>
            }
        </div>

        @* Bandwidth utilization *@
        <div class="px-4 py-3">
            <div class="mb-1 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Bandwidth Utilization</span>
                <span class="font-medium text-xs tabular-nums">@(_bandwidthUtilization)%</span>
            </div>
            <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="@(Cn.Merge("h-full rounded-full", _bandwidthUtilization >= 90 ? "bg-red-500" : _bandwidthUtilization >= 70 ? "bg-amber-500" : "bg-emerald-500"))"
                     style="@($"width: {_bandwidthUtilization}%")">
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private const int _peakTraffic = 96;
    private const int _bandwidthUtilization = 73;

    private record TopIpEntry(string Ip, string Location, string Traffic, int Percent);

    private static readonly int[] _hourlyTraffic =
        [42, 38, 31, 28, 25, 22, 30, 48, 72, 85, 91, 88, 94, 96, 89, 78, 82, 90, 95, 87, 76, 68, 58, 50];

    private static readonly TopIpEntry[] _topIps =
    [
        new("203.0.113.42", "US-East", "1.8 GB", 82),
        new("198.51.100.17", "EU-West", "1.2 GB", 55),
        new("192.0.2.88", "AP-South", "840 MB", 38),
        new("100.64.0.3", "US-West", "620 MB", 28),
        new("172.16.254.1", "EU-North", "410 MB", 19),
    ];
}
