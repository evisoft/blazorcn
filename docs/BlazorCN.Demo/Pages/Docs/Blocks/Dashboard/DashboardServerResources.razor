@* ============================================================
   Block: dashboard-server-resources
   Title: Dashboard Server Resources
   Description: Animated React server resource monitoring dashboard block for Next.js with four servers showing CPU, memory, and disk usage progress bars with color-coded thresholds, hostname labels, region chips, and status indicators using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: KPI metrics with trend indicators
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-server-resources.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Server Resources</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Infrastructure utilization across @_servers.Length servers
                </p>
            </div>
            <div class="flex items-center gap-4 text-xs">
                <span class="flex items-center gap-1.5 text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_onlineCount/@_servers.Length online
                </span>
                <span class="text-muted-foreground">
                    Avg CPU <span class="tabular-nums">@_totalCpu%</span>
                </span>
                <span class="text-muted-foreground">
                    Avg Mem <span class="tabular-nums">@_totalMemory%</span>
                </span>
            </div>
        </div>

        @* Server rows *@
        <div>
            @for (var i = 0; i < _servers.Length; i++)
            {
                var server = _servers[i];
                var isLast = i == _servers.Length - 1;
                <div class="@(isLast ? "" : "border-b") px-4 py-4">
                    <div class="mb-3 flex items-center gap-3">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", _statusDot[server.Status]))"></span>
                        <span class="font-mono font-medium text-sm">@server.Hostname</span>
                        <span class="rounded bg-muted/50 px-1.5 py-0.5 text-muted-foreground text-xs">
                            @server.Region
                        </span>
                        <span class="ml-auto text-muted-foreground text-xs">
                            @_statusLabel[server.Status]
                        </span>
                    </div>
                    <div class="space-y-2">
                        @{
                            var resources = new[] { ("CPU", server.Cpu), ("Memory", server.Memory), ("Disk", server.Disk) };
                        }
                        @foreach (var (label, value) in resources)
                        {
                            <div class="flex items-center gap-3">
                                <span class="w-14 text-muted-foreground text-xs">@label</span>
                                <div class="relative h-2 flex-1 overflow-hidden rounded-full bg-muted/50">
                                    <div class="@(Cn.Merge("absolute inset-y-0 left-0 rounded-full", GetBarColor(value)))"
                                         style="@($"width: {value}%")"></div>
                                </div>
                                <span class="@(Cn.Merge("w-10 text-right text-xs tabular-nums", value >= 85 ? "text-red-600 dark:text-red-400" : "text-muted-foreground"))">
                                    @value%
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Server(string Hostname, string Region, string Status, int Cpu, int Memory, int Disk);

    private static string GetBarColor(int value) =>
        value >= 85 ? "bg-red-500"
        : value >= 60 ? "bg-amber-500"
        : "bg-emerald-500";

    private static readonly int _totalCpu = (int)Math.Round(_servers.Average(s => s.Cpu));
    private static readonly int _totalMemory = (int)Math.Round(_servers.Average(s => s.Memory));
    private static readonly int _onlineCount = _servers.Count(s => s.Status == "online");

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["online"] = "bg-emerald-500",
        ["degraded"] = "bg-amber-500",
        ["offline"] = "bg-red-500",
    };

    private static readonly Dictionary<string, string> _statusLabel = new()
    {
        ["online"] = "Online",
        ["degraded"] = "Degraded",
        ["offline"] = "Offline",
    };

    private static readonly Server[] _servers =
    [
        new("prod-web-01", "us-east-1", "online", 42, 68, 54),
        new("prod-web-02", "us-east-1", "online", 78, 82, 61),
        new("prod-api-01", "eu-west-1", "degraded", 91, 87, 73),
        new("prod-db-01", "us-west-2", "online", 34, 72, 88),
    ];
}
