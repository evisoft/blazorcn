@* ============================================================
   Block: dashboard-user-growth
   Title: Dashboard User Growth
   Description: Animated React dashboard user growth block for Next.js with sparkline chart, growth dots, total users, new users, churn rate, and active rate metrics with animated entrance using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Four KPI metric cards with trend indicators
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-user-growth.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">User growth</h2>
                <div class="mt-0.5 flex items-center gap-2">
                    <span class="font-semibold text-2xl tabular-nums">2,847</span>
                    <span class="flex items-center gap-0.5 text-emerald-600 text-xs dark:text-emerald-400">
                        <LucideTrendingUpCn Size="12" Class="size-3" />
                        +13.4%
                    </span>
                </div>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-muted-foreground text-xs">
                Last 7 months
            </span>
        </div>
        <div class="border-b px-4 py-4">
            <svg viewBox="0 0 300 100" class="h-28 w-full" aria-label="User growth sparkline chart">
                <title>User growth over the last 7 months</title>
                <polyline
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="text-foreground/80"
                    points="@_polylinePoints" />
                @for (var i = 0; i < _dataPoints.Length; i++)
                {
                    var point = _dataPoints[i];
                    <circle
                        cx="@GetX(i).ToString(System.Globalization.CultureInfo.InvariantCulture)"
                        cy="@GetY(point.Value).ToString(System.Globalization.CultureInfo.InvariantCulture)"
                        r="3.5"
                        class="fill-background stroke-foreground/80"
                        stroke-width="2" />
                }
            </svg>
            <div class="mt-1 flex justify-between">
                @foreach (var point in _dataPoints)
                {
                    <span class="text-muted-foreground text-[10px]">@point.Label</span>
                }
            </div>
        </div>
        <div class="grid grid-cols-4">
            @for (var i = 0; i < _stats.Length; i++)
            {
                var stat = _stats[i];
                <div class="@(Cn.Merge("px-4 py-3", i < 3 ? "border-r" : ""))">
                    <p class="text-muted-foreground text-xs">@stat.Label</p>
                    <p class="mt-0.5 font-semibold text-sm tabular-nums">@stat.Value</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record DataPoint(string Label, int Value);
    private record Stat(string Label, string Value);

    private static readonly DataPoint[] _dataPoints =
    [
        new("Sep", 1420),
        new("Oct", 1680),
        new("Nov", 1590),
        new("Dec", 1950),
        new("Jan", 2180),
        new("Feb", 2510),
        new("Mar", 2847),
    ];

    private static readonly Stat[] _stats =
    [
        new("Total users", "2,847"),
        new("New this month", "337"),
        new("Churn rate", "2.1%"),
        new("Active rate", "84.3%"),
    ];

    private static readonly int _minValue = _dataPoints.Min(d => d.Value);
    private static readonly int _maxValue = _dataPoints.Max(d => d.Value);
    private static readonly int _valueRange = _maxValue - _minValue;

    private static double GetX(int index) => (double)index / (_dataPoints.Length - 1) * 280 + 10;
    private static double GetY(int value) => 80 - (double)(value - _minValue) / _valueRange * 60;

    private static readonly string _polylinePoints = string.Join(" ",
        _dataPoints.Select((d, i) => FormattableString.Invariant($"{GetX(i):F1},{GetY(d.Value):F1}")));
}
