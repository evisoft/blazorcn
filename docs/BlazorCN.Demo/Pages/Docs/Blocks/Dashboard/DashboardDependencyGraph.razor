@* ============================================================
   Block: dashboard-dependency-graph
   Title: Dashboard Dependency Graph
   Description: Animated React dependency health dashboard block for Next.js displaying eight package dependencies with current and latest versions, update status chips, last updated timestamps, and license information with outdated package highlighting using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Data quality scores and issue tracking
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-dependency-graph.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Dependency Health</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_packages.Count(p => p.Status != "Up to date") packages need updates
                </p>
            </div>
        </div>

        @* Header row *@
        <div class="grid grid-cols-[1fr_80px_80px_90px_100px_80px] items-center gap-2 border-b bg-muted/30 px-4 py-2">
            <span class="text-muted-foreground text-xs">Package</span>
            <span class="text-muted-foreground text-xs">Current</span>
            <span class="text-muted-foreground text-xs">Latest</span>
            <span class="text-muted-foreground text-xs">Status</span>
            <span class="text-muted-foreground text-xs">Updated</span>
            <span class="text-muted-foreground text-xs">License</span>
        </div>

        @* Package rows *@
        <div>
            @for (var i = 0; i < _packages.Length; i++)
            {
                var pkg = _packages[i];
                var isLast = i == _packages.Length - 1;
                var isOutdated = pkg.Status != "Up to date";
                <div class="@(Cn.Merge("grid grid-cols-[1fr_80px_80px_90px_100px_80px] items-center gap-2 px-4 py-3", isLast ? "" : "border-b", isOutdated ? "bg-muted/20" : ""))">
                    <span class="truncate font-mono text-sm">@pkg.Name</span>
                    <span class="font-mono text-muted-foreground text-xs">@pkg.Current</span>
                    <span class="@(Cn.Merge("font-mono text-xs", isOutdated ? "font-medium" : "text-muted-foreground"))">
                        @pkg.Latest
                    </span>
                    <span class="@(Cn.Merge("inline-flex w-fit items-center rounded-full px-2 py-0.5 text-xs", _statusStyles[pkg.Status]))">
                        @pkg.Status
                    </span>
                    <span class="text-muted-foreground text-xs">@pkg.LastUpdated</span>
                    <span class="text-muted-foreground text-xs">@pkg.License</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Package(string Name, string Current, string Latest, string Status, string LastUpdated, string License);

    private static readonly Dictionary<string, string> _statusStyles = new()
    {
        ["Up to date"] = "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        ["Minor"] = "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        ["Major"] = "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        ["Critical"] = "bg-red-500/10 text-red-600 dark:text-red-400",
    };

    private static readonly Package[] _packages =
    [
        new("react", "19.0.0", "19.0.0", "Up to date", "2 weeks ago", "MIT"),
        new("next", "15.1.0", "15.2.4", "Minor", "5 days ago", "MIT"),
        new("typescript", "5.6.3", "5.7.2", "Minor", "1 week ago", "Apache-2.0"),
        new("prisma", "5.19.0", "6.2.1", "Major", "3 months ago", "Apache-2.0"),
        new("tailwindcss", "4.0.0", "4.0.0", "Up to date", "1 month ago", "MIT"),
        new("zod", "3.22.4", "3.24.1", "Minor", "2 months ago", "MIT"),
        new("lodash", "4.17.19", "4.17.21", "Critical", "1 year ago", "MIT"),
        new("framer-motion", "11.11.0", "11.15.0", "Minor", "3 weeks ago", "MIT"),
    ];
}
