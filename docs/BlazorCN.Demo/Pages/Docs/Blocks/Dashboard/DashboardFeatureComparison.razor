@* ============================================================
   Block: dashboard-feature-comparison
   Title: Dashboard Feature Comparison
   Description: Animated React feature comparison dashboard block for Next.js with eight features across three plans showing check, cross, and partial availability indicators, highlighted current plan column, and upgrade buttons for locked features using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Plan management with usage limits
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-feature-comparison.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Feature Comparison</span>
            <span class="text-muted-foreground text-xs">
                Current plan: <span class="font-medium text-foreground">Pro</span>
            </span>
        </div>

        @* Plan headers *@
        <div class="flex items-end border-b">
            <div class="min-w-0 flex-1 px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">Features</span>
            </div>
            @foreach (var plan in _plans)
            {
                var isCurrent = plan.Key == _currentPlan;
                <div class="@(Cn.Merge("flex w-28 flex-col items-center px-2 py-3", isCurrent ? "bg-muted/50" : ""))">
                    <span class="@(Cn.Merge("text-xs", isCurrent ? "font-semibold" : "font-medium text-muted-foreground"))">
                        @plan.Name
                    </span>
                    <span class="font-semibold text-sm tabular-nums">@plan.Price</span>
                    @if (isCurrent)
                    {
                        <span class="mt-0.5 inline-flex items-center rounded-full bg-foreground/10 px-1.5 py-0.5 text-[9px] font-medium">
                            Current
                        </span>
                    }
                </div>
            }
        </div>

        @* Feature rows *@
        <div>
            @for (var i = 0; i < _features.Length; i++)
            {
                var feature = _features[i];
                var isLast = i == _features.Length - 1;
                <div class="@(Cn.Merge("flex items-center", isLast ? "" : "border-b"))">
                    <div class="min-w-0 flex-1 px-4 py-3">
                        <span class="font-medium text-sm">@feature.Name</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@feature.Description</p>
                    </div>
                    @foreach (var plan in _plans)
                    {
                        var isCurrent = plan.Key == _currentPlan;
                        var availability = GetAvailability(feature, plan.Key);
                        <div class="@(Cn.Merge("flex w-28 items-center justify-center px-2 py-3", isCurrent ? "bg-muted/50" : ""))">
                            @if (availability == "yes")
                            {
                                <LucideCheckCn Size="16" Class="size-4 text-emerald-500" />
                            }
                            else if (availability == "partial")
                            {
                                <LucideMinusCn Size="16" Class="size-4 text-amber-500" />
                            }
                            else
                            {
                                <LucideXCn Size="16" Class="size-4 text-muted-foreground/30" />
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer CTA *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">Unlock all features with Enterprise</span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Upgrade
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private const string _currentPlan = "pro";

    private record Plan(string Key, string Name, string Price);
    private record FeatureItem(string Name, string Description, string Free, string Pro, string Enterprise);

    private static string GetAvailability(FeatureItem feature, string planKey) => planKey switch
    {
        "free" => feature.Free,
        "pro" => feature.Pro,
        "enterprise" => feature.Enterprise,
        _ => "no",
    };

    private static readonly Plan[] _plans =
    [
        new("free", "Free", "$0"),
        new("pro", "Pro", "$39/mo"),
        new("enterprise", "Enterprise", "$159/mo"),
    ];

    private static readonly FeatureItem[] _features =
    [
        new("Unlimited projects", "Create and manage projects", "no", "yes", "yes"),
        new("Custom domains", "Connect your own domain", "no", "yes", "yes"),
        new("Team collaboration", "Invite team members", "partial", "yes", "yes"),
        new("API access", "REST and GraphQL APIs", "partial", "yes", "yes"),
        new("Priority support", "24/7 dedicated support", "no", "no", "yes"),
        new("SSO / SAML", "Enterprise single sign-on", "no", "no", "yes"),
        new("Audit logs", "Activity and compliance logs", "no", "yes", "yes"),
        new("Advanced analytics", "Custom dashboards and reports", "no", "partial", "yes"),
    ];
}
