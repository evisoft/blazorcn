@* ============================================================
   Block: dashboard-pricing-analytics
   Title: Dashboard Pricing Analytics
   Description: Animated React pricing analytics dashboard block for Next.js displaying conversion rates per pricing tier, ARPU trends, trial-to-paid conversion, and plan distribution with expandable tier rows showing upgrade and churn metrics using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Subscription health and MRR tracking
   Dependencies: BadgeCn
   Source: original/blocks/dashboard/dashboard-pricing-analytics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Pricing Analytics</span>
                <p class="mt-0.5 text-muted-foreground text-xs">Tier performance and conversion</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
                <LucideTrendingUpCn Size="12" Class="size-3" />
                @_arpuChange
            </BadgeCn>
        </div>

        @* Summary metrics *@
        <div class="grid grid-cols-4 border-b">
            @for (var i = 0; i < _summaryMetrics.Length; i++)
            {
                var metric = _summaryMetrics[i];
                <div class="@(Cn.Merge("px-4 py-3", i < 3 ? "border-r" : ""))">
                    <p class="text-muted-foreground text-xs">@metric.Label</p>
                    <p class="@(Cn.Merge("mt-1 font-semibold text-lg tabular-nums", metric.Color))">
                        @metric.Value
                    </p>
                </div>
            }
        </div>

        @* Tier rows *@
        <div>
            @for (var i = 0; i < _tiers.Length; i++)
            {
                var tier = _tiers[i];
                var isExpanded = _expanded == tier.Id;
                var isLast = i == _tiers.Length - 1;
                <div class="@(!isLast || isExpanded ? "border-b" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : tier.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@tier.Name</span>
                                <span class="text-muted-foreground text-xs">@tier.Price</span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @tier.Subscribers.ToString("N0") subscribers · @tier.Revenue MRR
                            </p>
                        </div>
                        <span class="@(Cn.Merge("font-semibold text-sm tabular-nums", ConversionColor(tier.Conversion)))">
                            @(tier.Conversion)%
                        </span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4">
                            <div class="grid grid-cols-3 gap-4 rounded-md bg-muted/50 p-3">
                                <div>
                                    <span class="text-muted-foreground text-xs">Monthly Churn</span>
                                    <p class="mt-0.5 font-semibold text-sm tabular-nums text-red-600 dark:text-red-400">
                                        @(tier.Churn)%
                                    </p>
                                </div>
                                <div>
                                    <span class="text-muted-foreground text-xs">Revenue Share</span>
                                    <p class="mt-0.5 font-semibold text-sm tabular-nums">
                                        @(tier.RevenueShare)%
                                    </p>
                                </div>
                                <div>
                                    <span class="text-muted-foreground text-xs">Trial Starts</span>
                                    <p class="mt-0.5 font-semibold text-sm tabular-nums">
                                        @tier.TrialStarts
                                    </p>
                                </div>
                            </div>
                            <div class="mt-3">
                                <div class="mb-1.5 flex items-center justify-between">
                                    <span class="text-muted-foreground text-xs">Plan distribution</span>
                                    <span class="font-medium text-xs tabular-nums">
                                        @(tier.RevenueShare)%
                                    </span>
                                </div>
                                <div class="h-1.5 overflow-hidden rounded-full bg-muted/50">
                                    <div class="h-full rounded-full bg-foreground/80" style="@($"width: {tier.RevenueShare}%")"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "t2";

    private record PricingTier(string Id, string Name, string Price, int Subscribers, double Conversion, double Churn, string Revenue, int RevenueShare, int TrialStarts, int Upgrades);
    private record SummaryMetric(string Label, string Value, string Color);

    private static string ConversionColor(double rate) =>
        rate >= 15 ? "text-emerald-600 dark:text-emerald-400"
        : rate >= 8 ? "text-amber-600 dark:text-amber-400"
        : "text-red-600 dark:text-red-400";

    private const string _arpuChange = "+6.3%";

    private static readonly SummaryMetric[] _summaryMetrics =
    [
        new("MRR", "$184.2K", ""),
        new("ARPU", "$42.80", ""),
        new("Trial \u2192 Paid", "14.2%", "text-emerald-600 dark:text-emerald-400"),
        new("Active Trials", "892", ""),
    ];

    private static readonly PricingTier[] _tiers =
    [
        new("t1", "Starter", "$19/mo", 1842, 18.4, 3.2, "$34.9K", 19, 620, 114),
        new("t2", "Pro", "$49/mo", 2105, 12.7, 1.8, "$103.1K", 56, 445, 56),
        new("t3", "Business", "$99/mo", 389, 8.9, 0.9, "$38.5K", 21, 128, 11),
        new("t4", "Enterprise", "$249/mo", 31, 5.2, 0.3, "$7.7K", 4, 18, 1),
    ];
}
