@* ============================================================
   Block: dashboard-carbon-footprint
   Title: Dashboard Carbon Footprint
   Description: Animated React carbon emissions tracking dashboard block for Next.js with CO2 metrics, offset progress bars, monthly emission trends, and category breakdown using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Spending analysis with category segmentation
   Dependencies: BadgeCn
   Source: original/blocks/dashboard/dashboard-carbon-footprint.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideLeafCn Size="16" Class="size-4 text-emerald-600 dark:text-emerald-400" />
                <span class="font-medium text-sm">Carbon Footprint</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                FY 2025-26
            </BadgeCn>
        </div>

        @* Summary metrics *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div>
                <p class="text-muted-foreground text-xs">Total Emissions</p>
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-2xl tabular-nums">@_totalEmissions</span>
                    <span class="text-muted-foreground text-xs">tCO2e</span>
                </div>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">Offset</p>
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-sm tabular-nums">@_totalOffset</span>
                    <span class="text-muted-foreground text-xs">tCO2e</span>
                </div>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">YoY Change</p>
                <span class="flex items-center gap-1 font-medium text-emerald-600 text-sm tabular-nums dark:text-emerald-400">
                    <LucideTrendingDownCn Size="12" Class="size-3" />
                    @_yearOverYear
                </span>
            </div>
        </div>

        @* Offset progress *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Offset Progress</span>
                <span class="font-medium text-xs tabular-nums">@_offsetPercentage%</span>
            </div>
            <div class="h-2 overflow-hidden rounded-full bg-muted/50">
                <div class="h-full rounded-full bg-emerald-500"
                     style="@(FormattableString.Invariant($"width: {_offsetPercentage}%"))">
                </div>
            </div>
            <div class="mt-1.5 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">
                    Target: @_targetReduction reduction by 2030
                </span>
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    On track
                </span>
            </div>
        </div>

        @* Monthly trend bars *@
        <div class="border-b px-4 py-3">
            <p class="mb-3 text-muted-foreground text-xs">Monthly Emissions (tCO2e)</p>
            <div class="flex h-24 items-end gap-1">
                @foreach (var month in _monthlyData)
                            {
                    var heightPercent = month.Tons / _maxTons * 100;
                    <div class="flex flex-1 flex-col items-center gap-1">
                        <div class="w-full rounded-t bg-foreground/15"
                             style="@($"height: {heightPercent:F0}%")"
                             title="@($"{month.Tons} tCO2e")">
                        </div>
                    </div>
                }
            </div>
            <div class="mt-1.5 flex justify-between">
                @foreach (var month in _monthlyData)
                            {
                    <span class="flex-1 text-center text-muted-foreground text-[10px]">
                        @month.Month
                    </span>
                }
            </div>
        </div>

        @* Categories *@
        <div>
            @for (var i = 0; i < _categories.Length; i++)
                        {
                var category = _categories[i];
                var isLast = i == _categories.Length - 1;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b"))">
                    <span class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@category.Name</span>
                    </span>
                    <div class="h-1.5 w-24 overflow-hidden rounded-full bg-muted/50">
                        <div class="h-full rounded-full bg-foreground/20"
                             style="@(FormattableString.Invariant($"width: {category.Percentage}%"))">
                        </div>
                    </div>
                    <span class="w-14 text-right font-medium text-xs tabular-nums">
                        @(category.TonsCO2)t
                    </span>
                    <span class="w-10 text-right text-muted-foreground text-xs tabular-nums">
                        @category.Percentage%
                    </span>
                    <span class="@(Cn.Merge("flex w-12 items-center justify-end gap-0.5 text-xs tabular-nums", category.Trend == "down" ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400"))">
                        @if (category.Trend == "down")
                                    {
                            <LucideTrendingDownCn Size="12" Class="size-3" />
                        }
                        else
                        {
                            <LucideTrendingUpCn Size="12" Class="size-3" />
                        }
                        @category.TrendValue
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record EmissionCategory(string Id, string Name, double TonsCO2, double Percentage, string Trend, string TrendValue);
    private record MonthlyEmission(string Month, double Tons);

    private const double _totalEmissions = 142.8;
    private const double _totalOffset = 98.4;
    private const double _offsetPercentage = 68.9;
    private const string _targetReduction = "45%";
    private const string _yearOverYear = "-12.3%";

    private double _maxTons => _monthlyData.Max(m => m.Tons);

    private readonly EmissionCategory[] _categories = new[]
    {
        new EmissionCategory("compute", "Compute", 68.2, 47.8, "down", "-15%"),
        new EmissionCategory("storage", "Storage", 32.1, 22.5, "up", "+8%"),
        new EmissionCategory("networking", "Networking", 25.6, 17.9, "down", "-6%"),
        new EmissionCategory("facilities", "Facilities", 16.9, 11.8, "down", "-22%")
    };

    private readonly MonthlyEmission[] _monthlyData = new[]
    {
        new MonthlyEmission("Jul", 18.2),
        new MonthlyEmission("Aug", 16.8),
        new MonthlyEmission("Sep", 15.4),
        new MonthlyEmission("Oct", 14.1),
        new MonthlyEmission("Nov", 13.8),
        new MonthlyEmission("Dec", 12.9),
        new MonthlyEmission("Jan", 13.2),
        new MonthlyEmission("Feb", 12.1),
        new MonthlyEmission("Mar", 11.8),
        new MonthlyEmission("Apr", 10.4),
        new MonthlyEmission("May", 12.6),
        new MonthlyEmission("Jun", 11.5)
    };
}
