@* ============================================================
   Block: dashboard-resource-allocation
   Title: Dashboard Resource Allocation
   Description: Animated React team resource planning dashboard block for Next.js displaying team member capacity, utilization percentages, availability status, project assignments, and workload distribution bars with expandable member rows using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Team capacity and workload tracking
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-resource-allocation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideUsersCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Resource Allocation</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        8 members · 78% team utilization
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    3
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    4
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-muted-foreground/30"></span>
                    1
                </span>
            </div>
        </div>

        @* Team utilization bar *@
        <div class="border-b px-4 py-3">
            <div class="mb-1.5 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Team Capacity</span>
                <span class="font-medium text-xs tabular-nums">78% utilized</span>
            </div>
            <div class="h-1.5 overflow-hidden rounded-full bg-muted/50">
                <div class="h-full rounded-full bg-foreground/80" style="width: 78%"></div>
            </div>
        </div>

        @* Member rows *@
        <div>
            @for (var i = 0; i < _members.Length; i++)
            {
                var member = _members[i];
                var isExpanded = _expanded == member.Id;
                var config = _statusConfig[member.Status];
                var isLast = i == _members.Length - 1;
                <div class="@(!isLast || isExpanded ? "border-b" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : member.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted font-medium text-[10px] text-muted-foreground">
                            @member.Initials
                        </span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@member.Name</span>
                                <span class="@(Cn.Merge("size-1.5 rounded-full", config.Dot))"></span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @member.Role · @(member.HoursAllocated)h/@(member.HoursAvailable)h
                            </p>
                        </div>
                        <span class="@(Cn.Merge("font-semibold text-sm tabular-nums", UtilizationColor(member.Utilization)))">
                            @(member.Utilization)%
                        </span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-14">
                            @if (member.Projects.Length == 0)
                            {
                                <p class="text-muted-foreground text-xs">No active assignments</p>
                            }
                            else
                            {
                                <div class="space-y-2">
                                    @foreach (var project in member.Projects)
                                    {
                                        <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                                            <div>
                                                <span class="text-sm">@project.Project</span>
                                                <p class="mt-0.5 text-muted-foreground text-xs">
                                                    @project.Role
                                                </p>
                                            </div>
                                            <span class="font-medium text-sm tabular-nums">
                                                @(project.Hours)h
                                            </span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "m1";

    private record ProjectAssignment(string Id, string Project, int Hours, string Role);
    private record TeamMember(string Id, string Name, string Initials, string Role, int Utilization, int HoursAllocated, int HoursAvailable, string Status, ProjectAssignment[] Projects);
    private record StatusConfig(string Dot, string Label);

    private static string UtilizationColor(int util) =>
        util == 0 ? "text-muted-foreground"
        : util <= 85 ? "text-emerald-600 dark:text-emerald-400"
        : util <= 95 ? "text-amber-600 dark:text-amber-400"
        : "text-red-600 dark:text-red-400";

    private static readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["available"] = new("bg-emerald-500", "Available"),
        ["at-capacity"] = new("bg-amber-500", "At capacity"),
        ["on-leave"] = new("bg-muted-foreground/30", "On leave"),
    };

    private static readonly TeamMember[] _members =
    [
        new("m1", "Elena Vasquez", "EV", "Senior Engineer", 95, 38, 40, "at-capacity",
            [new("p1", "Platform Migration", 20, "Tech Lead"), new("p2", "API Gateway v2", 12, "Developer"), new("p3", "Security Audit", 6, "Reviewer")]),
        new("m2", "Marcus Chen", "MC", "Full Stack Developer", 82, 33, 40, "available",
            [new("p4", "Customer Portal", 24, "Lead Developer"), new("p5", "Internal Tools", 9, "Developer")]),
        new("m3", "Priya Sharma", "PS", "Frontend Engineer", 100, 40, 40, "at-capacity",
            [new("p6", "Design System v3", 28, "Owner"), new("p7", "Marketing Site", 12, "Developer")]),
        new("m4", "James Wright", "JW", "Backend Engineer", 68, 27, 40, "available",
            [new("p8", "Data Pipeline", 18, "Developer"), new("p9", "Monitoring Stack", 9, "Developer")]),
        new("m5", "Sophie Anderson", "SA", "DevOps Engineer", 91, 36, 40, "at-capacity",
            [new("p10", "Infrastructure as Code", 20, "Lead"), new("p11", "CI/CD Overhaul", 16, "Developer")]),
        new("m6", "David Park", "DP", "QA Engineer", 0, 0, 40, "on-leave", []),
        new("m7", "Aisha Johnson", "AJ", "Full Stack Developer", 72, 29, 40, "available",
            [new("p12", "Customer Portal", 16, "Developer"), new("p13", "API Gateway v2", 13, "Developer")]),
        new("m8", "Liam O'Brien", "LO", "Senior Engineer", 88, 35, 40, "at-capacity",
            [new("p14", "Platform Migration", 24, "Developer"), new("p15", "Security Audit", 11, "Lead")]),
    ];
}
