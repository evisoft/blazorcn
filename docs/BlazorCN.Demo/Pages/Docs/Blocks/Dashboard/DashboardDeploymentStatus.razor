@* ============================================================
   Block: dashboard-deployment-status
   Title: Dashboard Deployment Status
   Description: Animated deployment status dashboard for React and Next.js with six recent deploys showing environment chips, commit messages, author initials, animated status dots for success and deploying states, duration, and timestamps using framer-motion, shadcn/ui, and Tailwind CSS
   Long Description: Core Web Vitals metrics dashboard
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-deployment-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Deployments</span>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_deploys.Count(d => d.Status == "success") passed
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_deploys.Count(d => d.Status == "failed") failed
                </span>
            </div>
        </div>

        @* Deploy Rows *@
        <div>
            @for (var i = 0; i < _deploys.Length; i++)
            {
                var deploy = _deploys[i];
                var config = _statusConfig[deploy.Status];
                var isLast = i == _deploys.Length - 1;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b"))">
                    @* Status dot *@
                    <div class="relative flex shrink-0 items-center justify-center">
                        <span class="@(Cn.Merge("size-2 rounded-full", config.Color))"></span>
                    </div>

                    @* Environment chip *@
                    <span class="@(Cn.Merge("inline-flex shrink-0 items-center rounded px-1.5 py-0.5 text-[10px] font-medium", _envStyle[deploy.Environment]))">
                        @deploy.Environment
                    </span>

                    @* Commit message *@
                    <span class="min-w-0 flex-1 truncate text-sm">@deploy.Commit</span>

                    @* Author initials *@
                    <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted font-medium text-[10px] text-muted-foreground">
                        @deploy.Initials
                    </span>

                    @* Duration + Time *@
                    <div class="shrink-0 text-right">
                        <span class="block font-mono text-muted-foreground text-[10px] tabular-nums">
                            @deploy.Duration
                        </span>
                        <span class="block text-muted-foreground text-[10px]">
                            @deploy.Timestamp
                        </span>
                    </div>

                    @* Rollback button for failed *@
                    @if (deploy.Status == "failed")
                    {
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 shrink-0 gap-1 px-2 text-xs">
                            <LucideRotateCcwCn Size="12" Class="size-3" />
                            Retry
                        </ButtonCn>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Deploy(string Environment, string Commit, string Initials, string Status, string Duration, string Timestamp);
    private record StatusConfig(string Color, string Label);

    private static readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["success"] = new("bg-emerald-500", "Success"),
        ["failed"] = new("bg-red-500", "Failed"),
        ["deploying"] = new("bg-amber-500", "Deploying"),
    };

    private static readonly Dictionary<string, string> _envStyle = new()
    {
        ["Production"] = "bg-foreground text-background",
        ["Staging"] = "bg-muted text-muted-foreground",
        ["Preview"] = "bg-muted/50 text-muted-foreground",
    };

    private static readonly Deploy[] _deploys =
    [
        new("Production", "fix: resolve auth token refresh race condition", "SC", "deploying", "1m 24s", "2 min ago"),
        new("Staging", "feat: add team workspace switcher component", "AR", "success", "2m 08s", "18 min ago"),
        new("Preview", "chore: upgrade dependencies and fix type errors", "JP", "success", "1m 52s", "42 min ago"),
        new("Production", "fix: correct stripe webhook signature validation", "SC", "success", "2m 31s", "1 hour ago"),
        new("Staging", "feat: implement advanced search filters with debounce", "ML", "failed", "0m 47s", "3 hours ago"),
        new("Preview", "docs: update API reference for v2 endpoints", "AR", "success", "1m 15s", "5 hours ago"),
    ];
}
