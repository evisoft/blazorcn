            new("t8", "should handle subscription upgrade", "failed", "4.2s", 2, "Stripe API returned 402: card_declined. Test payment method expired."),
            new("t9", "should calculate prorated amount", "skipped", "0s", 0),
        ]),
        new("s3", "Dashboard Components", 56, 0, 3, 2, "38s",
        [
