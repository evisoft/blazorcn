            new("t12", "should export data to CSV", "passed", "0.9s", 0),
            new("t13", "should animate chart transitions", "flaky", "2.1s", 1),
        ]),
        new("s4", "API Endpoints", 92, 3, 4, 1, "1m 52s",
        [
            new("t14", "GET /api/users should return paginated list", "passed", "0.3s", 0),
            new("t15", "POST /api/webhooks should validate payload", "passed", "0.5s", 0),
            new("t16", "DELETE /api/teams/:id should cascade members", "failed", "1.4s", 2, "Foreign key constraint violation on team_members table. CASCADE not set on relationship."),
        ]),
        new("s5", "Search & Indexing", 34, 1, 3, 0, "32s",
        [
            new("t17", "should return fuzzy match results", "passed", "0.7s", 0),
            new("t18", "should rebuild index on schema change", "failed", "8.2s", 2, "Index rebuild timed out after 8s. Expected completion within 5s for 10K documents."),
            new("t19", "should handle empty query gracefully", "skipped", "0s", 0),
        ]),
    ];
}
