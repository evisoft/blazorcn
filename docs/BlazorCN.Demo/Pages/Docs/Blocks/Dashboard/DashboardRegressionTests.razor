@* ============================================================
   Block: dashboard-regression-tests
   Title: Dashboard Regression Tests
   Description: Animated React regression test suite dashboard block for Next.js displaying pass, fail, skip counts with flaky test tracking, test duration, expandable suite rows showing individual test results and failure details using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Build and deploy pipeline dashboard
   Dependencies: BadgeCn
   Source: original/blocks/dashboard/dashboard-regression-tests.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucidePlayCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Regression Tests</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">Run #1847 · 4m 32s</p>
                </div>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="@(Cn.Merge("font-normal text-xs", _passRate >= 95 ? "text-emerald-600 dark:text-emerald-400" : "text-amber-600 dark:text-amber-400"))">
                @(_passRate)% pass rate
            </BadgeCn>
        </div>

        @* Summary counts *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="tabular-nums">284</span>
                <span class="text-muted-foreground">passed</span>
            </span>
            <span class="flex items-center gap-1.5 text-xs">
                <span class="size-1.5 rounded-full bg-red-500"></span>
                <span class="tabular-nums">7</span>
                <span class="text-muted-foreground">failed</span>
            </span>
            <span class="flex items-center gap-1.5 text-xs">
                <span class="size-1.5 rounded-full bg-muted-foreground/30"></span>
                <span class="tabular-nums">12</span>
                <span class="text-muted-foreground">skipped</span>
            </span>
            <span class="flex items-center gap-1.5 text-xs">
                <span class="size-1.5 rounded-full bg-amber-500"></span>
                <span class="tabular-nums">4</span>
                <span class="text-muted-foreground">flaky</span>
            </span>
        </div>

        @* Suite rows *@
        <div>
            @for (var i = 0; i < _suites.Length; i++)
            {
                var suite = _suites[i];
                var isExpanded = _expanded == suite.Id;
                var isLast = i == _suites.Length - 1;
                var hasFails = suite.Failed > 0;
                <div class="@(!isLast || isExpanded ? "border-b" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : suite.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", hasFails ? "bg-red-500" : suite.Flaky > 0 ? "bg-amber-500" : "bg-emerald-500"))"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@suite.Name</span>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span class="tabular-nums">@suite.Passed passed</span>
                                @if (suite.Failed > 0)
                                {
                                    <span class="tabular-nums text-red-600 dark:text-red-400">
                                        @suite.Failed failed
                                    </span>
                                }
                                @if (suite.Flaky > 0)
                                {
                                    <span class="tabular-nums text-amber-600 dark:text-amber-400">
                                        @suite.Flaky flaky
                                    </span>
                                }
                            </div>
                        </div>
                        <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                            @suite.Duration
                        </span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="space-y-1 px-4 pb-4 pl-9">
                            @foreach (var test in suite.Tests)
                            {
                                <div>
                                    <div class="flex items-center gap-2.5 rounded-md px-2 py-1.5">
                                        @switch (test.Status)
                                        {
                                            case "passed":
                                                <LucideCheckCircle2Cn Size="14" Class="size-3.5 text-emerald-500" />
                                                break;
                                            case "failed":
                                                <LucideCircleXCn Size="14" Class="size-3.5 text-red-500" />
                                                break;
                                            case "skipped":
                                                <LucideMinusCircleCn Size="14" Class="size-3.5 text-muted-foreground/50" />
                                                break;
                                            case "flaky":
                                                <LucideAlertTriangleCn Size="14" Class="size-3.5 text-amber-500" />
                                                break;
                                        }
                                        <span class="@(Cn.Merge("flex-1 text-sm", test.Status == "skipped" ? "text-muted-foreground" : ""))">
                                            @test.Name
                                        </span>
                                        <div class="flex items-center gap-2">
                                            @if (test.Retries > 0)
                                            {
                                                <span class="text-muted-foreground text-[10px] tabular-nums">
                                                    @test.Retries retries
                                                </span>
                                            }
                                            <span class="font-mono text-muted-foreground text-[10px] tabular-nums">
                                                @test.Duration
                                            </span>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(test.Error))
                                    {
                                        <div class="ml-8 mt-1 rounded-md bg-red-500/5 px-3 py-2">
                                            <p class="font-mono text-xs text-red-600 leading-relaxed dark:text-red-400">
                                                @test.Error
                                            </p>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "s1";
    private const double _passRate = 93.7;

    private record TestCase(string Id, string Name, string Status, string Duration, int Retries, string? Error = null);
    private record TestSuite(string Id, string Name, int Passed, int Failed, int Skipped, int Flaky, string Duration, TestCase[] Tests);

    private static readonly TestSuite[] _suites =
    [
        new("s1", "Authentication Flow", 18, 2, 0, 1, "42s",
        [
            new("t1", "should sign in with valid credentials", "passed", "1.2s", 0),
            new("t2", "should reject invalid password", "passed", "0.8s", 0),
            new("t3", "should handle OAuth callback redirect", "failed", "3.1s", 2, "Expected redirect to /dashboard, received /login. OAuth state mismatch after token exchange."),
            new("t4", "should refresh expired session token", "flaky", "2.4s", 1),
            new("t5", "should enforce rate limit on login attempts", "failed", "5.2s", 2, "Timeout waiting for rate limit response. Expected 429 status after 5 attempts, received 200."),
        ]),
        new("s2", "Payment Processing", 24, 1, 2, 0, "1m 08s",
        [
