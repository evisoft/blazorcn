@* ============================================================
   Block: dashboard-fraud-detection
   Title: Dashboard Fraud Detection
   Description: Animated React fraud detection dashboard block for Next.js with risk score monitoring, flagged transactions, fraud rule triggers, expandable investigation details, and severity-based indicators using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Transaction volume and payment method breakdown
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-fraud-detection.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideShieldAlertCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Fraud Detection</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-amber-500"></span>
                <span class="text-muted-foreground text-xs">8 pending review</span>
            </div>
        </div>

        @* Summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div>
                <p class="text-muted-foreground text-xs">Flagged Today</p>
                <p class="font-semibold text-2xl tabular-nums">12</p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">Blocked</p>
                <p class="font-semibold text-sm tabular-nums text-red-600 dark:text-red-400">4</p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">False Positive Rate</p>
                <p class="font-semibold text-sm tabular-nums">14.2%</p>
            </div>
        </div>

        @* Transactions *@
        <div>
            @for (var i = 0; i < _transactions.Length; i++)
            {
                var tx = _transactions[i];
                var isExpanded = _expanded == tx.Id;
                var isLast = i == _transactions.Length - 1;

                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : tx.Id)"
                        class="@(Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", tx.RiskLevel == "critical" ? "bg-red-500/5" : ""))">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", _riskDot[tx.RiskLevel]))"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@tx.Amount</span>
                                <span class="font-mono text-muted-foreground text-xs">@tx.TxId</span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @tx.Customer · @tx.Method · @tx.Country
                            </p>
                        </div>
                        <div class="text-right">
                            <span class="@(Cn.Merge("font-medium text-sm tabular-nums", _riskText[tx.RiskLevel]))">
                                @tx.RiskScore
                            </span>
                            <p class="text-muted-foreground text-xs">@tx.Timestamp</p>
                        </div>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-4 pl-9">
                                <p class="mb-3 text-muted-foreground text-sm leading-relaxed">
                                    @tx.Reason
                                </p>

                                @* Rules *@
                                <div class="mb-3 rounded-md bg-muted/50 p-3">
                                    <span class="mb-2 block font-medium text-muted-foreground text-xs">
                                        Rule triggers
                                    </span>
                                    <div class="space-y-1.5">
                                        @foreach (var rule in tx.Rules)
                                        {
                                            <div class="flex items-center gap-2">
                                                <span class="@(Cn.Merge("size-1.5 rounded-full", rule.Triggered ? "bg-red-500" : "bg-foreground/20"))"></span>
                                                <span class="@(Cn.Merge("text-xs", rule.Triggered ? "text-foreground" : "text-muted-foreground"))">
                                                    @rule.Name
                                                </span>
                                            </div>
                                        }
                                    </div>
                                </div>

                                @* Actions *@
                                <div class="flex items-center gap-2">
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                        Approve
                                    </ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs text-red-600 hover:bg-red-500/10 hover:text-red-600 dark:text-red-400">
                                        Block
                                    </ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                        Escalate
                                    </ButtonCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "1";

    private record FraudRule(string Name, bool Triggered);
    private record FlaggedTransaction(string Id, string TxId, string Amount, string Currency, int RiskScore, string RiskLevel, string Customer, string Email, string Country, string Method, string Timestamp, FraudRule[] Rules, string Reason);

    private static readonly Dictionary<string, string> _riskDot = new()
    {
        ["critical"] = "bg-red-500",
        ["high"] = "bg-red-400",
        ["medium"] = "bg-amber-500",
        ["low"] = "bg-blue-500",
    };

    private static readonly Dictionary<string, string> _riskText = new()
    {
        ["critical"] = "text-red-600 dark:text-red-400",
        ["high"] = "text-red-600 dark:text-red-400",
        ["medium"] = "text-amber-600 dark:text-amber-400",
        ["low"] = "text-blue-600 dark:text-blue-400",
    };

    private static readonly FlaggedTransaction[] _transactions =
    [
        new("1", "txn_8Kx2mQ9vBn", "$2,840.00", "USD", 94, "critical", "Unknown Card", "j***@@tempmail.org", "NG", "Visa \u2022\u2022\u2022\u2022 4829", "14:32:08",
            [new("New device + high amount", true), new("Velocity: 4 txns in 10 min", true), new("Country mismatch", true), new("Disposable email", true)],
            "First-time purchase from unrecognized device with disposable email. Four transactions attempted within 10 minutes from a high-risk country not matching card issuer region."),
        new("2", "txn_3Lm7pR1wYd", "$890.00", "USD", 78, "high", "Marcus Chen", "m.chen@@outlook.com", "US", "Mastercard \u2022\u2022\u2022\u2022 1156", "14:28:45",
            [new("Amount 3x above user average", true), new("New shipping address", true), new("Velocity: 4 txns in 10 min", false), new("Country mismatch", false)],
            "Purchase amount significantly above user's historical average of $280. Shipping to a new address not previously associated with this account."),
        new("3", "txn_5Qr9kT4xMa", "$159.00", "USD", 52, "medium", "Sarah Park", "sarah.p@@gmail.com", "KR", "Visa \u2022\u2022\u2022\u2022 7231", "14:21:12",
            [new("VPN/proxy detected", true), new("Amount 3x above user average", false), new("New shipping address", false), new("Country mismatch", false)],
            "Transaction routed through a commercial VPN exit node. Customer has a clean history but VPN usage is flagged for review per policy."),
        new("4", "txn_1Bn4wK8zPe", "$45.00", "USD", 18, "low", "James Mitchell", "jmitchell@@company.com", "US", "Amex \u2022\u2022\u2022\u2022 3002", "14:15:33",
            [new("Card testing pattern", true), new("VPN/proxy detected", false), new("Amount 3x above user average", false), new("Country mismatch", false)],
            "Small-value transaction matching card testing pattern. Customer has 2-year history with consistent purchasing behavior. Likely false positive."),
    ];
}
