@* ============================================================
   Block: dashboard-test-coverage
   Title: Dashboard Test Coverage
   Description: Animated React test coverage treemap-style block for Next.js with module-level coverage percentages, line and branch metrics, trend indicators, animated coverage bars, and expandable file-level details using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Code quality metrics and analysis
   Dependencies: BadgeCn
   Source: original/blocks/dashboard/dashboard-test-coverage.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with overall score *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Test Coverage</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_modules.Length modules \u00b7 @_passing above threshold
                </p>
            </div>
            <div class="flex items-center gap-3">
                <div class="text-right">
                    <span class="@(Cn.Merge("font-semibold text-2xl tabular-nums", GetCoverageColor(_overallCoverage)))">
                        @_overallCoverage%
                    </span>
                </div>
            </div>
        </div>

        @* Coverage metric labels *@
        <div class="flex items-center border-b bg-muted/30 px-4 py-2">
            <span class="min-w-0 flex-1 font-medium text-muted-foreground text-xs">Module</span>
            <span class="w-14 shrink-0 text-center font-medium text-muted-foreground text-xs">Lines</span>
            <span class="w-14 shrink-0 text-center font-medium text-muted-foreground text-xs">Branch</span>
            <span class="w-14 shrink-0 text-center font-medium text-muted-foreground text-xs">Func</span>
            <span class="w-10 shrink-0 text-center font-medium text-muted-foreground text-xs">Trend</span>
            <span class="w-5 shrink-0"></span>
        </div>

        @* Module rows *@
        <div>
            @for (var i = 0; i < _modules.Length; i++)
            {
                var mod = _modules[i];
                var isExpanded = _expanded == mod.Id;
                var isLast = i == _modules.Length - 1;
                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : mod.Id)"
                        class="flex w-full items-center px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="min-w-0 flex-1">
                            <span class="font-mono text-sm">@mod.Name</span>
                        </div>
                        <span class="@(Cn.Merge("w-14 shrink-0 text-center font-semibold text-sm tabular-nums", GetCoverageColor(mod.Lines)))">
                            @mod.Lines%
                        </span>
                        <span class="@(Cn.Merge("w-14 shrink-0 text-center text-sm tabular-nums", GetCoverageColor(mod.Branches)))">
                            @mod.Branches%
                        </span>
                        <span class="@(Cn.Merge("w-14 shrink-0 text-center text-sm tabular-nums", GetCoverageColor(mod.Functions)))">
                            @mod.Functions%
                        </span>
                        <div class="flex w-10 shrink-0 items-center justify-center gap-1">
                            @if (mod.Trend == "up")
                            {
                                <LucideTrendingUpCn Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                            }
                            else if (mod.Trend == "down")
                            {
                                <LucideTrendingDownCn Size="12" Class="size-3 text-red-600 dark:text-red-400" />
                            }
                            else
                            {
                                <span class="text-muted-foreground text-xs">\u2014</span>
                            }
                        </div>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="space-y-2 px-4 pb-4 pl-8">
                            @if (mod.Trend != "stable")
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                    @(mod.TrendDelta > 0 ? "+" : "")@mod.TrendDelta% since last build
                                </BadgeCn>
                            }
                            @foreach (var file in mod.Files)
                            {
                                <div class="rounded-md bg-muted/50 p-3">
                                    <div class="flex items-center justify-between">
                                        <span class="font-mono text-xs">@file.Name</span>
                                        <span class="@(Cn.Merge("font-semibold text-xs tabular-nums", GetCoverageColor(file.Lines)))">
                                            @file.Lines%
                                        </span>
                                    </div>
                                    <div class="mt-2 grid grid-cols-2 gap-3">
                                        <div>
                                            <div class="mb-1 flex items-center justify-between">
                                                <span class="text-muted-foreground text-[10px]">Lines</span>
                                                <span class="font-mono text-muted-foreground text-[10px] tabular-nums">
                                                    @file.Lines%
                                                </span>
                                            </div>
                                            <div class="h-1 overflow-hidden rounded-full bg-muted">
                                                <div class="@(Cn.Merge("h-full rounded-full", GetBarColor(file.Lines)))"
                                                     style="@(FormattableString.Invariant($"width: {file.Lines}%"))"></div>
                                            </div>
                                        </div>
                                        <div>
                                            <div class="mb-1 flex items-center justify-between">
                                                <span class="text-muted-foreground text-[10px]">Branches</span>
                                                <span class="font-mono text-muted-foreground text-[10px] tabular-nums">
                                                    @file.Branches%
                                                </span>
                                            </div>
                                            <div class="h-1 overflow-hidden rounded-full bg-muted">
                                                <div class="@(Cn.Merge("h-full rounded-full", GetBarColor(file.Branches)))"
                                                     style="@(FormattableString.Invariant($"width: {file.Branches}%"))"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record CoverageFile(string Name, double Lines, double Branches);
    private record CoverageModule(string Id, string Name, double Lines, double Branches, double Functions, string Trend, double TrendDelta, CoverageFile[] Files);

    private const double _overallCoverage = 78.4;
    private static string GetCoverageColor(double value) =>
        value >= 80 ? "text-emerald-600 dark:text-emerald-400"
        : value >= 60 ? "text-amber-600 dark:text-amber-400"
        : "text-red-600 dark:text-red-400";

    private static string GetBarColor(double value) =>
        value >= 80 ? "bg-emerald-500/50"
        : value >= 60 ? "bg-amber-500/50"
        : "bg-red-500/50";

    private static readonly CoverageModule[] _modules =
    [
        new("m1", "src/components", 92.1, 84.3, 95.0, "up", 2.3,
            [new("Button.tsx", 100, 100), new("Dialog.tsx", 94.2, 87.5), new("DataTable.tsx", 82.1, 65.4)]),
        new("m2", "src/hooks", 88.7, 79.2, 91.3, "stable", 0.1,
            [new("useAuth.ts", 95.0, 88.0), new("useDebounce.ts", 100, 100), new("useWebSocket.ts", 71.2, 49.8)]),
        new("m3", "src/lib", 81.4, 73.8, 84.6, "up", 4.1,
            [new("utils.ts", 97.3, 91.0), new("api-client.ts", 78.5, 62.3), new("validators.ts", 68.4, 68.1)]),
        new("m4", "src/api", 64.2, 51.9, 70.8, "down", -3.7,
            [new("routes/users.ts", 82.1, 71.4), new("routes/billing.ts", 58.3, 42.1), new("middleware/auth.ts", 52.2, 41.9)]),
        new("m5", "src/services", 56.3, 42.7, 61.5, "down", -1.2,
            [new("email.ts", 71.0, 55.3), new("stripe.ts", 48.9, 34.2), new("analytics.ts", 49.0, 38.6)]),
    ];
    private static readonly int _passing = _modules.Count(m => m.Lines >= 80);

}
