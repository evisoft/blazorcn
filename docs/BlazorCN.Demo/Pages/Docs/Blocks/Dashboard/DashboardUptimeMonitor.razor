@* ============================================================
   Block: dashboard-uptime-monitor
   Title: Dashboard Uptime Monitor
   Description: Animated React uptime monitoring dashboard block for Next.js with six services displaying uptime percentages, 30-day availability bar charts with color-coded status indicators, response times, and current status dots using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Database performance monitoring with query stats
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-uptime-monitor.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Uptime Monitor</span>
                <p class="mt-0.5 text-muted-foreground text-xs">Last 30 days</p>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-muted-foreground text-xs">
                    @_operationalCount/@_services.Length operational
                </span>
            </div>
        </div>

        @* Services *@
        <div>
            @for (var i = 0; i < _services.Length; i++)
            {
                var service = _services[i];
                var isLast = i == _services.Length - 1;
                <div class="@(!isLast ? "border-b" : "")">
                    <div class="px-4 py-3">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", _statusDot[service.Status]))"></span>
                                <span class="font-medium text-sm">@service.Name</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="text-muted-foreground text-xs">@service.ResponseTime</span>
                                <span class="font-semibold text-sm tabular-nums">@service.Uptime%</span>
                            </div>
                        </div>
                        <div class="mt-2 flex items-center gap-3">
                            <div class="flex flex-1 items-center gap-0.5">
                                @foreach (var day in service.Days)
                                {
                                    <div class="@(Cn.Merge("h-6 flex-1 rounded-[1px]", _dayColor[day]))"
                                         style="transform-origin: bottom"></div>
                                }
                            </div>
                            <span class="shrink-0 text-muted-foreground text-xs">
                                @_statusLabel[service.Status]
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ServiceData(string Name, string Uptime, string ResponseTime, string Status, string[] Days);

    private int _operationalCount => _services.Count(s => s.Status == "operational");

    private readonly Dictionary<string, string> _statusDot = new()
    {
        ["operational"] = "bg-emerald-500",
        ["degraded"] = "bg-amber-500",
        ["down"] = "bg-red-500"
    };

    private readonly Dictionary<string, string> _statusLabel = new()
    {
        ["operational"] = "Operational",
        ["degraded"] = "Degraded",
        ["down"] = "Down"
    };

    private readonly Dictionary<string, string> _dayColor = new()
    {
        ["up"] = "bg-emerald-500",
        ["degraded"] = "bg-amber-500",
        ["down"] = "bg-red-500"
    };

    private readonly ServiceData[] _services = new[]
    {
        new ServiceData("API Gateway", "99.98", "45ms", "operational", new[] { "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "degraded", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up" }),
        new ServiceData("Web Application", "99.95", "120ms", "operational", new[] { "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "degraded", "degraded", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up" }),
        new ServiceData("Database Cluster", "99.99", "8ms", "operational", new[] { "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up" }),
        new ServiceData("CDN Edge Network", "99.87", "12ms", "degraded", new[] { "up", "up", "up", "up", "up", "up", "up", "up", "down", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "degraded", "degraded", "degraded" }),
        new ServiceData("Authentication Service", "99.92", "65ms", "operational", new[] { "up", "up", "up", "up", "up", "down", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up" }),
        new ServiceData("Payment Processing", "99.96", "180ms", "operational", new[] { "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "degraded", "up", "up", "up", "up", "up", "up", "up", "up" })
    };
}
