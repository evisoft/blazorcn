@* ============================================================
   Block: dashboard-storage-usage
   Title: Dashboard Storage Usage
   Description: Animated React storage usage dashboard block for Next.js with five file categories showing individual sizes, a stacked horizontal bar with proportional segments, total capacity indicator, and staggered entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Hourly error bar chart with severity indicators
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-storage-usage.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Storage Usage</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Disk space allocation by category
                </p>
            </div>
            <div class="text-right">
                <p class="font-semibold text-sm tabular-nums">
                    @((int)_totalUsed) GB
                    <span class="font-normal text-muted-foreground">/ @_totalCapacity GB</span>
                </p>
                <p class="text-muted-foreground text-xs tabular-nums">@_usedPercent% used</p>
            </div>
        </div>

        @* Stacked bar *@
        <div class="px-4 py-4">
            <div class="h-6 w-full overflow-hidden rounded-full bg-muted/50">
                <div class="flex h-full" style="@($"width: {_usedPercent}%")">
                    @for (var i = 0; i < _categories.Length; i++)
                    {
                        var category = _categories[i];
                        var segmentWidth = category.SizeGb / _totalUsed * 100;
                        <div class="@(Cn.Merge("h-full", category.Color, i == 0 ? "rounded-l-full" : "", i == _categories.Length - 1 ? "rounded-r-full" : ""))"
                             style="@($"width: {segmentWidth:F1}%")"></div>
                    }
                </div>
            </div>
        </div>

        @* Category rows *@
        <div>
            @for (var i = 0; i < _categories.Length; i++)
            {
                var category = _categories[i];
                var isLast = i == _categories.Length - 1;
                var sharePercent = (category.SizeGb / _totalCapacity * 100).ToString("F1");
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b"))">
                    <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", category.DotColor))"></span>
                    <span class="min-w-0 flex-1 font-medium text-sm">@category.Name</span>
                    <span class="text-muted-foreground text-xs tabular-nums">@sharePercent%</span>
                    <span class="w-16 text-right font-medium text-sm tabular-nums">
                        @category.SizeGb GB
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record StorageCategory(string Name, double SizeGb, string Color, string DotColor);

    private const int _totalCapacity = 50;
    private static readonly double _totalUsed = _categories.Sum(c => c.SizeGb);
    private static readonly int _usedPercent = (int)Math.Round(_totalUsed / _totalCapacity * 100);

    private static readonly StorageCategory[] _categories =
    [
        new("Documents", 12.4, "bg-blue-500/60", "bg-blue-500"),
        new("Media", 8.7, "bg-purple-500/60", "bg-purple-500"),
        new("Backups", 5.2, "bg-amber-500/60", "bg-amber-500"),
        new("Logs", 2.1, "bg-emerald-500/60", "bg-emerald-500"),
        new("Other", 1.6, "bg-slate-500/60", "bg-slate-500"),
    ];
}
