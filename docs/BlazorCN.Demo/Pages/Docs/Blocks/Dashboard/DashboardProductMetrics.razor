@* ============================================================
   Block: dashboard-product-metrics
   Title: Dashboard Product Metrics
   Description: Animated React product analytics dashboard block for Next.js with DAU, WAU, MAU, stickiness ratio, session duration, and sessions per user in a responsive grid layout with trend arrows and staggered entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: KPI metrics with trend indicators
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-product-metrics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Product Metrics</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                User engagement and activity for the current period
            </p>
        </div>

        @* 3x2 metric grid *@
        <div class="grid grid-cols-3">
            @for (var i = 0; i < _metrics.Length; i++)
            {
                var metric = _metrics[i];
                var isTopRow = i < 3;
                var isRightEdge = (i + 1) % 3 == 0;

                <div class="@(Cn.Merge("px-4 py-4", isTopRow ? "border-b" : "", !isRightEdge ? "border-r" : ""))">
                    <div class="flex items-center gap-1.5">
                        <p class="font-medium text-muted-foreground text-xs">@metric.Label</p>
                    </div>
                    @if (!string.IsNullOrEmpty(metric.Sublabel))
                    {
                        <p class="mt-0.5 text-muted-foreground/60 text-xs">@metric.Sublabel</p>
                    }
                    <div class="mt-2 flex items-baseline gap-2">
                        <span class="font-semibold text-2xl tabular-nums">@metric.Value</span>
                    </div>
                    <span class="@(Cn.Merge("mt-1 flex items-center gap-0.5 text-xs", metric.Trend == "up" ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400"))">
                        @if (metric.Trend == "up")
                        {
                            <LucideTrendingUpCn Size="12" Class="size-3" />
                        }
                        else
                        {
                            <LucideTrendingDownCn Size="12" Class="size-3" />
                        }
                        @metric.Change
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record MetricData(string Label, string? Sublabel, string Value, string Change, string Trend);

    private readonly MetricData[] _metrics = new[]
    {
        new MetricData("DAU", "Daily Active Users", "12.4K", "+6.2%", "up"),
        new MetricData("WAU", "Weekly Active Users", "34.2K", "+4.8%", "up"),
        new MetricData("MAU", "Monthly Active Users", "89.7K", "+11.3%", "up"),
        new MetricData("Stickiness", "DAU / MAU", "13.8%", "-1.2%", "down"),
        new MetricData("Avg Session", "Duration", "4m 23s", "+0.8%", "up"),
        new MetricData("Sessions/User", "Daily average", "3.2", "-0.3%", "down")
    };
}
