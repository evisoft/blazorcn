@* ============================================================
   Block: dashboard-api-usage
   Title: Dashboard Api Usage
   Description: Animated API usage metrics dashboard for React and Next.js with total requests counter, rate limit utilization progress bar, top endpoints list with HTTP method chips and monospace paths, and latency percentile breakdown using framer-motion, shadcn/ui, and Tailwind CSS
   Long Description: Core Web Vitals metrics dashboard
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-api-usage.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">API Usage</span>
            <span class="text-muted-foreground text-xs">Today</span>
        </div>

        @* Requests + Rate Limit *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-muted-foreground text-xs">Total Requests</span>
                    <p class="font-semibold text-2xl tabular-nums">@_totalRequests</p>
                </div>
                <div class="text-right">
                    <span class="text-muted-foreground text-xs">Errors</span>
                    <p class="font-semibold text-sm tabular-nums text-red-600 dark:text-red-400">@_errors</p>
                </div>
            </div>

            <div class="mt-3">
                <div class="mb-1 flex items-center justify-between">
                    <span class="text-muted-foreground text-xs">Rate Limit Utilization</span>
                    <span class="font-medium text-xs tabular-nums">@(_rateLimitPercent)%</span>
                </div>
                <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                    <div class="@(Cn.Merge("h-full rounded-full", _rateLimitPercent >= 90 ? "bg-red-500" : _rateLimitPercent >= 70 ? "bg-amber-500" : "bg-emerald-500"))"
                         style="@($"width: {_rateLimitPercent}%")">
                    </div>
                </div>
            </div>
        </div>

        @* Top Endpoints *@
        <div class="border-b">
            <div class="px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Top Endpoints</span>
            </div>
            @for (var i = 0; i < _endpoints.Length; i++)
            {
                var endpoint = _endpoints[i];
                var isLast = i == _endpoints.Length - 1;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b"))">
                    <span class="@(Cn.Merge("inline-flex shrink-0 items-center rounded px-1.5 py-0.5 font-mono text-[10px] font-medium", GetMethodColor(endpoint.Method)))">
                        @endpoint.Method
                    </span>
                    <span class="min-w-0 flex-1 truncate font-mono text-muted-foreground text-xs">
                        @endpoint.Path
                    </span>
                    <span class="shrink-0 font-medium text-xs tabular-nums">@endpoint.Count</span>
                    <span class="shrink-0 text-muted-foreground text-xs tabular-nums">
                        @endpoint.AvgLatency
                    </span>
                </div>
            }
        </div>

        @* Latency Percentiles *@
        <div class="flex items-center divide-x">
            @foreach (var p in _latencyPercentiles)
            {
                <div class="flex flex-1 flex-col items-center px-4 py-3">
                    <span class="font-mono text-muted-foreground text-[10px] uppercase">@p.Label</span>
                    <span class="font-semibold text-lg tabular-nums">@p.Value</span>
                    <span class="text-muted-foreground text-[10px]">@p.Description</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record EndpointItem(string Method, string Path, string Count, string AvgLatency);
    private record PercentileItem(string Label, string Value, string Description);

    private const string _totalRequests = "284,517";
    private const string _errors = "127";
    private const int _rateLimitPercent = 67;

    private static string GetMethodColor(string method) => method switch
    {
        "GET" => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        "POST" => "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        "PUT" => "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        "DELETE" => "bg-red-500/10 text-red-600 dark:text-red-400",
        "PATCH" => "bg-purple-500/10 text-purple-600 dark:text-purple-400",
        _ => ""
    };

    private static readonly EndpointItem[] _endpoints =
    [
        new("GET", "/api/v2/users", "84,291", "42ms"),
        new("POST", "/api/v2/events", "61,803", "68ms"),
        new("GET", "/api/v2/products", "47,156", "35ms"),
        new("PUT", "/api/v2/sessions", "38,420", "91ms"),
        new("DELETE", "/api/v2/cache", "12,847", "18ms"),
    ];

    private static readonly PercentileItem[] _latencyPercentiles =
    [
        new("p50", "38ms", "Median"),
        new("p95", "142ms", "95th percentile"),
        new("p99", "891ms", "99th percentile"),
    ];
}
