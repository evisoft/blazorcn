@* ============================================================
   Block: dashboard-system-health
   Title: Dashboard System Health
   Description: Animated React dashboard system health block for Next.js with CPU, memory, disk, and network metrics, color-coded progress bars, percentage values, and status labels using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Four KPI metric cards with trend indicators
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-system-health.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <h2 class="font-medium text-sm">System health</h2>
            <span class="rounded bg-muted px-1.5 py-0.5 text-muted-foreground text-xs">Live</span>
        </div>
        <div class="grid grid-cols-2">
            @for (var i = 0; i < _metrics.Length; i++)
            {
                var metric = _metrics[i];
                var status = GetStatusColor(metric.Value);
                <div class="@(Cn.Merge("px-4 py-4", i < 2 ? "border-b" : "", i % 2 == 0 ? "border-r" : ""))">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            @switch (metric.Icon)
                            {
                                case "cpu":
                                    <LucideCpuCn Size="16" Class="size-4 text-muted-foreground" />
                                    break;
                                case "memory":
                                    <LucideMemoryStickCn Size="16" Class="size-4 text-muted-foreground" />
                                    break;
                                case "disk":
                                    <LucideHardDriveCn Size="16" Class="size-4 text-muted-foreground" />
                                    break;
                                case "network":
                                    <LucideWifiCn Size="16" Class="size-4 text-muted-foreground" />
                                    break;
                            }
                            <span class="font-medium text-sm">@metric.Label</span>
                        </div>
                        <span class="@(Cn.Merge("text-xs", status.Text))">@status.Label</span>
                    </div>
                    <div class="mt-2 flex items-center gap-3">
                        <span class="@(Cn.Merge("font-semibold text-2xl tabular-nums", status.Text))">
                            @metric.Value%
                        </span>
                    </div>
                    <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                        <div class="@(Cn.Merge("h-full rounded-full", status.Bar))"
                             style="@($"width: {metric.Value}%")"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record SystemMetric(string Label, int Value, string Icon);
    private record StatusColors(string Bar, string Text, string Label);

    private static StatusColors GetStatusColor(int value) =>
        value > 80 ? new("bg-red-500", "text-red-600 dark:text-red-400", "Critical")
        : value >= 50 ? new("bg-amber-500", "text-amber-600 dark:text-amber-400", "Warning")
        : new("bg-emerald-500", "text-emerald-600 dark:text-emerald-400", "Healthy");

    private static readonly SystemMetric[] _metrics =
    [
        new("CPU", 72, "cpu"),
        new("Memory", 58, "memory"),
        new("Disk", 34, "disk"),
        new("Network", 89, "network"),
    ];
}
