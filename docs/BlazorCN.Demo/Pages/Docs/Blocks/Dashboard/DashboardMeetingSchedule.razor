@* ============================================================
   Block: dashboard-meeting-schedule
   Title: Dashboard Meeting Schedule
   Description: Animated React meeting schedule dashboard block for Next.js with six daily meetings showing time slots, titles, attendee initials stacks, duration chips, room and virtual indicators, join buttons, and current meeting highlighting using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Sales pipeline with deal tracking
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-meeting-schedule.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Today's Schedule</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_meetings.Length meetings · @_totalHours hours
                </p>
            </div>
            <span class="rounded-full bg-muted px-2 py-0.5 text-muted-foreground text-xs">
                March 17
            </span>
        </div>

        @* Meetings *@
        <div>
            @for (var i = 0; i < _meetings.Length; i++)
            {
                var meeting = _meetings[i];
                var isLast = i == _meetings.Length - 1;
                var maxShow = 3;
                var overflow = meeting.Attendees.Length - maxShow;

                <div class="@(Cn.Merge(!isLast ? "border-b" : "", meeting.IsCurrent ? "border-l-2 border-l-primary bg-muted/30" : ""))">
                    <div class="flex items-center gap-3 px-4 py-3">
                        @* Time *@
                        <div class="w-16 shrink-0">
                            <span class="font-medium text-sm tabular-nums">@meeting.Time</span>
                            <p class="text-muted-foreground text-xs tabular-nums">@meeting.EndTime</p>
                        </div>

                        @* Details *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate font-medium text-sm">@meeting.Title</span>
                                @if (meeting.IsCurrent)
                                {
                                    <span class="shrink-0 rounded-full bg-primary/10 px-1.5 py-0.5 text-primary text-xs">
                                        Now
                                    </span>
                                }
                            </div>
                            <div class="mt-1 flex items-center gap-2">
                                @if (meeting.LocationType == "virtual")
                                {
                                    <LucideVideoCn Size="12" Class="size-3 text-muted-foreground" />
                                }
                                else
                                {
                                    <LucideMapPinCn Size="12" Class="size-3 text-muted-foreground" />
                                }
                                <span class="text-muted-foreground text-xs">@meeting.Location</span>
                                <span class="text-muted-foreground text-xs">·</span>
                                <span class="text-muted-foreground text-xs">@meeting.Duration</span>
                            </div>
                        </div>

                        @* Attendees *@
                        <div class="hidden items-center sm:flex">
                            <div class="flex -space-x-1.5">
                                @foreach (var attendee in meeting.Attendees.Take(maxShow))
                                {
                                    <span class="flex size-6 items-center justify-center rounded-full border-2 border-card bg-muted text-[10px] text-muted-foreground"
                                          title="@attendee.Name">
                                        @attendee.Initials
                                    </span>
                                }
                                @if (overflow > 0)
                                {
                                    <span class="flex size-6 items-center justify-center rounded-full border-2 border-card bg-muted text-[10px] text-muted-foreground">
                                        +@overflow
                                    </span>
                                }
                            </div>
                        </div>

                        @* Join *@
                        @if (meeting.IsCurrent)
                        {
                            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 shrink-0 text-xs">
                                Join
                            </ButtonCn>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Attendee(string Name, string Initials);
    private record MeetingData(string Id, string Time, string EndTime, string Title, Attendee[] Attendees, string Duration, string LocationType, string Location, bool IsCurrent);

    private const string _totalHours = "4.5";

    private readonly MeetingData[] _meetings = new[]
    {
        new MeetingData("m1", "9:00 AM", "9:30 AM", "Daily Standup", new[]
