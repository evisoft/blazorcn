@* ============================================================
   Block: dashboard-risk-assessment
   Title: Dashboard Risk Assessment
   Description: Animated React risk assessment block for Next.js with six categorized risks showing probability and impact chips, color-coded risk scores, owner initials, mitigation status dots, and staggered row animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Threat score and vulnerability summary
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-risk-assessment.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Risk Assessment</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Organizational risk matrix sorted by score
                </p>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_risks.Count(r => r.Score >= 15) critical
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_risks.Count(r => r.Score >= 8 && r.Score < 15) moderate
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_risks.Count(r => r.Score < 8) low
                </span>
            </div>
        </div>

        <div class="overflow-x-auto">
            <div class="min-w-[650px]">
                <div class="grid grid-cols-[1fr_80px_80px_60px_48px_100px] items-center border-b bg-muted/30 px-4 py-2">
                    <span class="font-medium text-muted-foreground text-xs">Risk</span>
                    <span class="text-center font-medium text-muted-foreground text-xs">Probability</span>
                    <span class="text-center font-medium text-muted-foreground text-xs">Impact</span>
                    <span class="text-center font-medium text-muted-foreground text-xs">Score</span>
                    <span class="text-center font-medium text-muted-foreground text-xs">Owner</span>
                    <span class="text-center font-medium text-muted-foreground text-xs">Mitigation</span>
                </div>

                <div>
                    @for (var i = 0; i < _risks.Length; i++)
                    {
                        var risk = _risks[i];
                        var isLast = i == _risks.Length - 1;
                        <div class="@(Cn.Merge("grid grid-cols-[1fr_80px_80px_60px_48px_100px] items-center px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b"))">
                            <div class="min-w-0 pr-3">
                                <span class="font-medium text-sm">@risk.Name</span>
                                <p class="mt-0.5 text-muted-foreground text-xs">@risk.Category</p>
                            </div>
                            <div class="flex justify-center">
                                <span class="@(Cn.Merge("inline-flex items-center rounded-md px-2 py-0.5 text-[11px] font-medium", _levelStyle[risk.Probability]))">
                                    @risk.Probability
                                </span>
                            </div>
                            <div class="flex justify-center">
                                <span class="@(Cn.Merge("inline-flex items-center rounded-md px-2 py-0.5 text-[11px] font-medium", _levelStyle[risk.Impact]))">
                                    @risk.Impact
                                </span>
                            </div>
                            <div class="flex justify-center">
                                <span class="@(Cn.Merge("font-semibold text-sm tabular-nums", GetScoreColor(risk.Score)))">
                                    @risk.Score
                                </span>
                            </div>
                            <div class="flex justify-center">
                                <div class="flex size-7 items-center justify-center rounded-full bg-muted text-[10px] font-medium" title="@risk.Owner">
                                    @risk.Initials
                                </div>
                            </div>
                            <div class="flex items-center justify-center gap-1.5">
                                <span class="@(Cn.Merge("size-1.5 rounded-full", _mitigationDot[risk.Mitigation]))"></span>
                                <span class="text-muted-foreground text-xs">
                                    @_mitigationLabel[risk.Mitigation]
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Risk(string Id, string Name, string Category, string Probability, string Impact, int Score, string Owner, string Initials, string Mitigation);

    private static string GetScoreColor(int score) =>
        score >= 15 ? "text-red-600 dark:text-red-400"
        : score >= 8 ? "text-amber-600 dark:text-amber-400"
        : "text-emerald-600 dark:text-emerald-400";

    private static readonly Dictionary<string, string> _levelStyle = new()
    {
        ["High"] = "bg-red-500/10 text-red-700 dark:text-red-400",
        ["Medium"] = "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        ["Low"] = "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
    };

    private static readonly Dictionary<string, string> _mitigationDot = new()
    {
        ["active"] = "bg-emerald-500",
        ["in-progress"] = "bg-amber-500",
        ["planned"] = "bg-muted-foreground/40",
    };

    private static readonly Dictionary<string, string> _mitigationLabel = new()
    {
        ["active"] = "Active",
        ["in-progress"] = "In progress",
        ["planned"] = "Planned",
    };

    private static readonly Risk[] _risks =
    [
        new("1", "Data breach via API vulnerability", "Security", "Medium", "High", 20, "Sarah Chen", "SC", "active"),
        new("2", "Key vendor contract termination", "Operations", "Low", "High", 16, "James Liu", "JL", "in-progress"),
        new("3", "Regulatory compliance deadline miss", "Compliance", "Medium", "Medium", 12, "Elena Rossi", "ER", "active"),
        new("4", "Infrastructure scaling bottleneck", "Technical", "High", "Low", 10, "Marcus Webb", "MW", "in-progress"),
        new("5", "Talent attrition in engineering team", "People", "Medium", "Medium", 9, "Priya Sharma", "PS", "planned"),
        new("6", "Currency exchange rate fluctuation", "Financial", "Low", "Low", 4, "Tom Bradley", "TB", "planned"),
    ];
}
