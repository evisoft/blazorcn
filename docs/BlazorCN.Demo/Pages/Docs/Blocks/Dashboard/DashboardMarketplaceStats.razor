@* ============================================================
   Block: dashboard-marketplace-stats
   Title: Dashboard Marketplace Stats
   Description: Animated React marketplace analytics dashboard block for Next.js with total listings count, active seller metrics, gross merchandise volume, average order value, top five sellers with initials avatars revenue ratings and items sold, and animated seller revenue bar chart using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: KPI metrics overview with trend indicators
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-marketplace-stats.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Marketplace Stats</span>
            <p class="mt-0.5 text-muted-foreground text-xs">Performance overview this month</p>
        </div>

        @* Stats row *@
        <div class="flex items-center gap-6 border-b px-4 py-3">
            <div>
                <span class="text-muted-foreground text-xs">Listings</span>
                <p class="font-semibold text-2xl tabular-nums">1,247</p>
            </div>
            <div>
                <span class="text-muted-foreground text-xs">Sellers</span>
                <p class="font-semibold text-2xl tabular-nums">342</p>
            </div>
            <div>
                <span class="text-muted-foreground text-xs">GMV</span>
                <p class="font-semibold text-2xl tabular-nums">$89K</p>
            </div>
            <div>
                <span class="text-muted-foreground text-xs">Avg order</span>
                <p class="font-semibold text-2xl tabular-nums">$64</p>
            </div>
        </div>

        @* Top sellers label *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Top sellers</span>
        </div>

        @* Seller rows *@
        <div>
            @for (var i = 0; i < _sellers.Length; i++)
            {
                var seller = _sellers[i];
                var isLast = i == _sellers.Length - 1;
                var barPct = (double)seller.Revenue / _maxRevenue * 100;
                <div class="@(Cn.Merge("px-4 py-3", isLast ? "" : "border-b"))">
                    <div class="flex items-center gap-3">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                            @seller.Initials
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-sm">@seller.Name</span>
                                    <span class="text-muted-foreground text-xs">@seller.Rating</span>
                                </div>
                                <div class="flex items-center gap-3">
                                    <span class="text-muted-foreground text-xs">
                                        @seller.ItemsSold items
                                    </span>
                                    <span class="font-mono text-sm font-medium tabular-nums">
                                        @FormatCurrency(seller.Revenue)
                                    </span>
                                </div>
                            </div>
                            <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-muted/50">
                                <div class="h-full rounded-full bg-foreground/70"
                                     style="@(FormattableString.Invariant($"width: {barPct:F1}%"))">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Seller(string Name, string Initials, int Revenue, string Rating, int ItemsSold);

    private const int _maxRevenue = 24800;

    private static string FormatCurrency(int n) => n >= 1000 ? $"${(n / 1000.0):F1}K" : $"${n}";

    private static readonly Seller[] _sellers =
    [
        new("Sarah Chen", "SC", 24800, "4.9", 342),
        new("Marcus Webb", "MW", 19200, "4.7", 287),
        new("Priya Patel", "PP", 16500, "4.8", 234),
        new("James Okafor", "JO", 12300, "4.6", 178),
        new("Elena Ruiz", "ER", 9800, "4.5", 156),
    ];
}
