@* ============================================================
   Block: dashboard-learning-progress
   Title: Dashboard Learning Progress
   Description: Animated React learning progress dashboard block for Next.js with four courses showing animated progress bars, completion percentages, modules completed counts, time spent tracking, certificate status, and header summary with total hours and active courses using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Code quality metrics with coverage and tech debt
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-learning-progress.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideBookOpenCn Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Learning Progress</span>
                </div>
                <span class="text-muted-foreground text-xs">@_courses.Length courses enrolled</span>
            </div>
            <div class="mt-3 flex items-center gap-6">
                <div class="flex items-center gap-2">
                    <LucideClockCn Size="12" Class="size-3.5 text-muted-foreground" />
                    <div>
                        <span class="font-semibold text-sm tabular-nums">@_totalHours</span>
                        <span class="ml-1 text-muted-foreground text-xs">hours total</span>
                    </div>
                </div>
                <div class="h-4 w-px bg-border"></div>
                <div class="flex items-center gap-2">
                    <LucideAwardCn Size="12" Class="size-3.5 text-muted-foreground" />
                    <div>
                        <span class="font-semibold text-sm tabular-nums">@_coursesInProgress</span>
                        <span class="ml-1 text-muted-foreground text-xs">in progress</span>
                    </div>
                </div>
            </div>
        </div>

        @* Courses *@
        <div>
            @for (var i = 0; i < _courses.Length; i++)
                        {
                var course = _courses[i];
                var isLast = i == _courses.Length - 1;
                var barColor = course.Progress == 100
                    ? "bg-emerald-500"
                    : course.Progress >= 60
                        ? "bg-blue-500"
                        : "bg-amber-500";

                <div class="@(Cn.Merge("px-4 py-3", !isLast ? "border-b" : ""))">
                    <div class="flex items-center justify-between">
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@course.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@course.Category</p>
                        </div>
                        <span class="shrink-0 font-semibold text-sm tabular-nums">
                            @(course.Progress)%
                        </span>
                    </div>

                    @* Progress Bar *@
                    <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-muted">
                        <div class="@(Cn.Merge("h-full rounded-full", barColor))"
                             style="@($"width: {course.Progress}%")">
                        </div>
                    </div>

                    @* Details *@
                    <div class="mt-2 flex items-center gap-3">
                        <span class="text-muted-foreground text-xs tabular-nums">
                            @course.ModulesCompleted/@course.ModulesTotal modules
                        </span>
                        <span class="text-muted-foreground text-xs">·</span>
                        <span class="text-muted-foreground text-xs tabular-nums">
                            @course.TimeSpent
                        </span>
                        <span class="text-muted-foreground text-xs">·</span>
                        <span class="flex items-center gap-1">
                            <span class="@(Cn.Merge("size-1.5 rounded-full", _certDot[course.CertStatus]))"></span>
                            <span class="@(Cn.Merge("text-xs", _certStyle[course.CertStatus]))">
                                @course.CertStatus
                            </span>
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Course(string Id, string Name, string Category, int Progress, int ModulesCompleted, int ModulesTotal, string TimeSpent, string CertStatus);

    private readonly string _totalHours = "81";
    private readonly int _coursesInProgress = 3;

    private readonly Dictionary<string, string> _certStyle = new()
    {
        ["Earned"] = "text-emerald-700 dark:text-emerald-400",
        ["In Progress"] = "text-amber-700 dark:text-amber-400",
        ["Not Started"] = "text-muted-foreground"
    };

    private readonly Dictionary<string, string> _certDot = new()
    {
        ["Earned"] = "bg-emerald-500",
        ["In Progress"] = "bg-amber-500",
        ["Not Started"] = "bg-muted-foreground/40"
    };

    private readonly Course[] _courses = new[]
    {
        new Course("c1", "Advanced TypeScript Patterns", "Engineering", 92, 11, 12, "18.5 hrs", "In Progress"),
        new Course("c2", "AWS Solutions Architect", "Cloud", 100, 20, 20, "42 hrs", "Earned"),
        new Course("c3", "Product Security Fundamentals", "Security", 65, 8, 12, "14 hrs", "In Progress"),
        new Course("c4", "Leadership for Tech Leads", "Management", 28, 3, 10, "6.5 hrs", "In Progress")
    };
}
