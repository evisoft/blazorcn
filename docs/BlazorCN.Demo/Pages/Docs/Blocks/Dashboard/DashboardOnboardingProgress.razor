@* ============================================================
   Block: dashboard-onboarding-progress
   Title: Dashboard Onboarding Progress
   Description: Animated user onboarding funnel dashboard for React and Next.js with five steps showing completion rate bars, drop-off percentage indicators, user counts at each stage, and animated progress visualization using framer-motion, shadcn/ui, and Tailwind CSS
   Long Description: Customer segmentation dashboard
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-onboarding-progress.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Onboarding Funnel</span>
            <div class="flex items-center gap-3">
                <span class="text-muted-foreground text-xs">
                    <span class="font-medium text-foreground tabular-nums">14,280</span> signups
                </span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs">
                    <span class="font-medium text-foreground tabular-nums">18%</span> conversion
                </span>
            </div>
        </div>

        @* Funnel Steps *@
        <div>
            @for (var i = 0; i < _steps.Length; i++)
            {
                var step = _steps[i];
                var isLast = i == _steps.Length - 1;

                @* Drop-off indicator *@
                @if (i > 0)
                {
                    var dropOff = _steps[i - 1].Rate - step.Rate;
                    <div class="flex items-center justify-center gap-1.5 border-b bg-muted/30 py-1">
                        <LucideArrowDownCn Size="12" Class="size-3 text-muted-foreground/60" />
                        <span class="text-muted-foreground text-[10px] tabular-nums">
                            -@(dropOff)% drop-off
                        </span>
                    </div>
                }

                @* Step *@
                <div class="@(Cn.Merge("px-4 py-3", isLast ? "" : "border-b"))">
                    <div class="mb-1.5 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="flex size-5 items-center justify-center rounded-full bg-muted font-mono text-[10px] text-muted-foreground">
                                @(i + 1)
                            </span>
                            <span class="font-medium text-sm">@step.Name</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="text-muted-foreground text-xs tabular-nums">
                                @step.Users users
                            </span>
                            <span class="w-10 text-right font-medium text-sm tabular-nums">
                                @(step.Rate)%
                            </span>
                        </div>
                    </div>
                    <div class="ml-7 h-1.5 overflow-hidden rounded-full bg-muted">
                        <div class="h-full rounded-full bg-foreground/70"
                             style="@($"width: {step.Rate}%")">
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record FunnelStep(string Name, int Rate, string Users);

    private static readonly FunnelStep[] _steps =
    [
        new("Account Created", 100, "14,280"),
        new("Profile Setup", 78, "11,138"),
        new("First Project", 54, "7,711"),
        new("Team Invited", 32, "4,570"),
        new("Upgraded", 18, "2,570"),
    ];
}
