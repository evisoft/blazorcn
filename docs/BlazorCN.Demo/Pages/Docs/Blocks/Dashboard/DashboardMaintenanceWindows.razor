@* ============================================================
   Block: dashboard-maintenance-windows
   Title: Dashboard Maintenance Windows
   Description: Animated React scheduled maintenance calendar dashboard for Next.js with maintenance events, affected services list, status indicators, time windows, and impact levels using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Recent deployment activity tracker
   Dependencies: BadgeCn
   Source: original/blocks/dashboard/dashboard-maintenance-windows.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideWrenchCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Maintenance Windows</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_windows.Count(w => w.Status == "in-progress") active
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    @_windows.Count(w => w.Status == "scheduled") upcoming
                </span>
            </div>
        </div>

        @* Window rows *@
        <div>
            @for (var i = 0; i < _windows.Length; i++)
            {
                var window = _windows[i];
                var isExpanded = _expanded == window.Id;
                var isLast = i == _windows.Length - 1;
                var config = _statusConfig[window.Status];
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : window.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        @* Status dot *@
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", config.Dot))"></span>

                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@window.Title</span>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <LucideCalendarCn Size="12" Class="size-3" />
                                <span>@window.Date</span>
                                <span>·</span>
                                <span class="font-mono tabular-nums">@window.TimeWindow</span>
                            </div>
                        </div>

                        <span class="@(Cn.Merge("shrink-0 text-xs", _impactConfig[window.Impact]))">
                            @window.Impact
                        </span>

                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <p class="mb-3 text-muted-foreground text-sm leading-relaxed">
                                @window.Description
                            </p>
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="mb-2 flex items-center justify-between">
                                    <span class="font-medium text-muted-foreground text-xs">
                                        Affected services
                                    </span>
                                    <span class="text-muted-foreground text-xs">@window.Assignee</span>
                                </div>
                                <div class="flex flex-wrap gap-1.5">
                                    @foreach (var service in window.Services)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                            @service
                                        </BadgeCn>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "m3";

    private record MaintenanceWindow(string Id, string Title, string Description, string Date, string TimeWindow, string Status, string Impact, string[] Services, string Assignee);
    private record StatusConfig(string Dot, string Label);

    private static readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["scheduled"] = new("bg-blue-500", "Scheduled"),
        ["in-progress"] = new("bg-amber-500", "In Progress"),
        ["completed"] = new("bg-emerald-500", "Completed"),
        ["cancelled"] = new("bg-muted-foreground", "Cancelled"),
    };

    private static readonly Dictionary<string, string> _impactConfig = new()
    {
        ["critical"] = "text-red-600 dark:text-red-400",
        ["high"] = "text-amber-600 dark:text-amber-400",
        ["medium"] = "text-blue-600 dark:text-blue-400",
        ["low"] = "text-muted-foreground",
    };

    private static readonly MaintenanceWindow[] _windows =
    [
        new("m1", "Primary database cluster upgrade",
            "Upgrading PostgreSQL from 15.4 to 16.2 with zero-downtime failover. Read replicas will be upgraded first, followed by primary promotion.",
            "Mar 19", "02:00 \u2013 04:00 UTC", "scheduled", "critical",
            ["API Gateway", "Auth Service", "Payment Processor", "User Service"], "Platform Team"),
        new("m2", "CDN certificate rotation",
            "Rotating TLS certificates across all CDN edge nodes. Traffic will be drained from each node before certificate swap.",
            "Mar 20", "06:00 \u2013 07:00 UTC", "scheduled", "medium",
            ["Static Assets", "Image CDN", "Video Streaming"], "Infrastructure Team"),
        new("m3", "Redis cluster memory rebalance",
            "Rebalancing shards across the Redis cluster to distribute memory usage evenly. Brief connection resets expected during shard migration.",
            "Mar 18", "14:00 \u2013 15:30 UTC", "in-progress", "high",
            ["Cache Layer", "Session Store", "Rate Limiter"], "Database Team"),
        new("m4", "Load balancer firmware update",
            "Applying firmware patches to hardware load balancers. Failover to secondary LB during primary update.",
            "Mar 21", "03:00 \u2013 03:30 UTC", "scheduled", "low",
            ["Load Balancer"], "Network Team"),
        new("m5", "Kubernetes node pool rotation",
            "Draining and replacing worker nodes with updated OS images. Pods will be rescheduled to new nodes with rolling replacement.",
            "Mar 17", "01:00 \u2013 05:00 UTC", "completed", "high",
            ["All Microservices", "Background Workers", "Cron Jobs"], "Platform Team"),
    ];
}
