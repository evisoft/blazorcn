@* ============================================================
   Block: dashboard-recent-invoices
   Title: Dashboard Recent Invoices
   Description: Animated React invoices dashboard block for Next.js with eight invoice rows showing invoice numbers, client names, amounts, payment status dots, due dates, and download actions with staggered entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: SaaS KPIs with MRR, ARR, and churn rate
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-recent-invoices.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Recent Invoices</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">Billing and payment status</p>
            </div>
            <div class="text-right">
                <p class="text-muted-foreground text-xs">Outstanding</p>
                <p class="font-semibold text-sm tabular-nums">
                    $@_outstanding.ToString("N2")
                </p>
            </div>
        </div>

        <div>
            @for (var i = 0; i < _invoices.Length; i++)
            {
                var invoice = _invoices[i];
                var isLast = i == _invoices.Length - 1;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b"))">
                    <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", _statusDot[invoice.Status]))"></span>
                    <span class="w-28 shrink-0 font-mono text-muted-foreground text-xs">
                        @invoice.Number
                    </span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@invoice.Client</span>
                    </div>
                    <span class="hidden shrink-0 rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground sm:inline">
                        @_statusLabel[invoice.Status]
                    </span>
                    <span class="w-20 shrink-0 text-right font-medium text-sm tabular-nums">
                        @invoice.Amount
                    </span>
                    <span class="hidden w-24 shrink-0 text-right text-muted-foreground text-xs sm:inline">
                        @invoice.Due
                    </span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                        <LucideDownloadCn Size="12" Class="size-3" />
                        <span class="hidden sm:inline">Download</span>
                    </ButtonCn>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Invoice(string Number, string Client, string Amount, string Status, string Due, double AmountValue);

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["paid"] = "bg-emerald-500",
        ["pending"] = "bg-amber-500",
        ["overdue"] = "bg-red-500",
        ["draft"] = "bg-slate-400",
    };

    private static readonly Dictionary<string, string> _statusLabel = new()
    {
        ["paid"] = "Paid",
        ["pending"] = "Pending",
        ["overdue"] = "Overdue",
        ["draft"] = "Draft",
    };

    private static readonly Invoice[] _invoices =
    [
        new("INV-2024-0891", "Acme Corporation", "$12,400.00", "paid", "Mar 1, 2026", 12400.00),
        new("INV-2024-0890", "Globex Industries", "$8,750.00", "pending", "Mar 15, 2026", 8750.00),
        new("INV-2024-0889", "Soylent Corp", "$3,200.00", "overdue", "Feb 28, 2026", 3200.00),
        new("INV-2024-0888", "Initech Systems", "$6,480.00", "paid", "Feb 15, 2026", 6480.00),
        new("INV-2024-0887", "Umbrella Labs", "$15,900.00", "pending", "Mar 20, 2026", 15900.00),
        new("INV-2024-0886", "Wonka Enterprises", "$4,100.00", "draft", "Mar 25, 2026", 4100.00),
        new("INV-2024-0885", "Stark Solutions", "$9,600.00", "paid", "Feb 10, 2026", 9600.00),
        new("INV-2024-0884", "Wayne Industries", "$22,350.00", "overdue", "Feb 20, 2026", 22350.00),
    ];
    private static readonly double _outstanding = _invoices
        .Where(inv => inv.Status is "pending" or "overdue")
        .Sum(inv => inv.AmountValue);

}
