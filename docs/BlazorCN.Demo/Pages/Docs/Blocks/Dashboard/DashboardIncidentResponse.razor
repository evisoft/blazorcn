@* ============================================================
   Block: dashboard-incident-response
   Title: Dashboard Incident Response
   Description: Animated React incident management dashboard block for Next.js with active incident count, MTTR metrics, severity-prioritized incidents showing P1 through P4 levels, affected service chips, status tracking from investigating through resolved, assigned teams, and duration timers using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Service uptime tracking with 30-day bar charts
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-incident-response.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Incident Response</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Active incidents and resolution tracking
                </p>
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_incidents.Count(inc => inc.Status != "resolved") active
                </span>
            </div>
        </div>

        @* Stats row *@
        <div class="flex items-center gap-6 border-b px-4 py-3">
            <div>
                <span class="text-muted-foreground text-xs">Active</span>
                <p class="font-semibold text-2xl tabular-nums text-red-600 dark:text-red-400">
                    @_incidents.Count(inc => inc.Status != "resolved")
                </p>
            </div>
            <div>
                <span class="text-muted-foreground text-xs">MTTR</span>
                <p class="font-semibold text-2xl tabular-nums">42m</p>
            </div>
            <div>
                <span class="text-muted-foreground text-xs">This month</span>
                <p class="font-semibold text-2xl tabular-nums">7</p>
            </div>
        </div>

        @* Incidents *@
        <div>
            @for (var i = 0; i < _incidents.Length; i++)
            {
                var incident = _incidents[i];
                var isExpanded = _expanded == incident.Id;
                var isLast = i == _incidents.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : incident.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("shrink-0 rounded px-1.5 py-0.5 font-mono text-xs font-medium", _severityColor[incident.Severity]))">
                            @incident.Severity
                        </span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@incident.Title</span>
                            <div class="mt-1 flex flex-wrap items-center gap-1.5">
                                @foreach (var service in incident.Services)
                                {
                                    <span class="rounded bg-muted/50 px-1.5 py-0.5 text-muted-foreground text-xs">
                                        @service
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="flex shrink-0 items-center gap-3">
                            <div class="flex items-center gap-1.5">
                                <span class="@(Cn.Merge("size-1.5 rounded-full", _statusDot[incident.Status]))"></span>
                                <span class="text-muted-foreground text-xs">
                                    @_statusLabel[incident.Status]
                                </span>
                            </div>
                            <span class="font-mono text-muted-foreground text-xs tabular-nums">
                                @incident.Duration
                            </span>
                            <LucideChevronRightCn Class="@(Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-14">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="mb-1.5 flex items-center justify-between">
                                    <span class="font-medium text-muted-foreground text-xs">Summary</span>
                                    <span class="text-muted-foreground text-xs">
                                        Assigned to @incident.Team
                                    </span>
                                </div>
                                <p class="text-sm leading-relaxed">@incident.Summary</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "INC-1042";

    private record Incident(string Id, string Severity, string Title, string[] Services, string Status, string Duration, string Team, string Summary);

    private static readonly Dictionary<string, string> _severityColor = new()
    {
        ["P1"] = "bg-red-500/10 text-red-600 dark:text-red-400",
        ["P2"] = "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        ["P3"] = "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        ["P4"] = "bg-zinc-500/10 text-muted-foreground",
    };

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["investigating"] = "bg-red-500",
        ["identified"] = "bg-amber-500",
        ["monitoring"] = "bg-blue-500",
        ["resolved"] = "bg-emerald-500",
    };

    private static readonly Dictionary<string, string> _statusLabel = new()
    {
        ["investigating"] = "Investigating",
        ["identified"] = "Identified",
        ["monitoring"] = "Monitoring",
        ["resolved"] = "Resolved",
    };

    private static readonly Incident[] _incidents =
    [
        new("INC-1042", "P1", "Payment gateway timeout errors", ["Payments API", "Checkout", "Billing"], "identified", "34 min", "Platform",
            "Stripe webhook processing is timing out due to a misconfigured connection pool. The pool size was reduced during last night's deploy. Rolling back the connection config now."),
        new("INC-1041", "P2", "Elevated error rate on search service", ["Search", "Product Catalog"], "investigating", "12 min", "Search Team",
            "Elasticsearch cluster node 3 is unresponsive. The remaining nodes are handling traffic but response times have tripled. Investigating the root cause on the affected node."),
        new("INC-1039", "P3", "Email delivery delays exceeding SLA", ["Notifications", "Email"], "monitoring", "2h 15 min", "Messaging",
            "SendGrid reported regional delays in the US-East region. Emails are being queued and delivered with a 5-10 minute delay. SendGrid has acknowledged the issue and is working on a fix."),
        new("INC-1037", "P4", "Dashboard chart rendering flicker on Safari", ["Dashboard UI"], "resolved", "1h 42 min", "Frontend",
            "A CSS animation conflict caused chart components to flicker on Safari 17. Fixed by replacing the transform animation with opacity-only transitions. Deployed in v2.14.3."),
    ];
}
