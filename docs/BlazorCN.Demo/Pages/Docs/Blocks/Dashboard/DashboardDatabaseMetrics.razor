@* ============================================================
   Block: dashboard-database-metrics
   Title: Dashboard Database Metrics
   Description: Animated React database performance dashboard block for Next.js with four key metrics showing queries per second, average query time, active connections with capacity bar, cache hit rate, and a slow query list with five items displaying query snippets in monospace, execution duration, and call counts using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Service availability with 30-day charts
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-database-metrics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideDatabaseCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Database Performance</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">PostgreSQL · primary cluster</p>
                </div>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-muted-foreground text-xs">Healthy</span>
            </div>
        </div>

        @* Metrics Grid *@
        <div class="grid grid-cols-2 border-b md:grid-cols-4">
            @for (var i = 0; i < _dbMetrics.Length; i++)
            {
                var metric = _dbMetrics[i];
                <div class="@(Cn.Merge("px-4 py-3", i < 2 ? "border-b md:border-b-0" : "", i % 2 == 0 ? "border-r" : "", i < 3 ? "md:border-r" : "md:border-r-0"))">
                    <span class="font-medium text-muted-foreground text-xs">@metric.Label</span>
                    <div class="mt-1 flex items-baseline gap-0.5">
                        <span class="@(Cn.Merge("font-semibold text-2xl tabular-nums", _colorMap[metric.Color]))">
                            @metric.Value
                        </span>
                        <span class="text-muted-foreground text-xs">@metric.Unit</span>
                    </div>
                </div>
            }
        </div>

        @* Connections Bar *@
        <div class="border-b px-4 py-3">
            <div class="mb-1.5 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Connection Pool</span>
                <span class="text-muted-foreground text-xs tabular-nums">142/200 active</span>
            </div>
            <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-amber-500" style="width: 71%"></div>
            </div>
        </div>

        @* Slow Queries *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Slow Queries</span>
            </div>
            @for (var i = 0; i < _slowQueries.Length; i++)
            {
                var query = _slowQueries[i];
                var isLast = i == _slowQueries.Length - 1;
                <div class="@(Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : ""))">
                    <p class="truncate font-mono text-xs text-muted-foreground">@query.Query</p>
                    <div class="mt-1.5 flex items-center gap-3">
                        <span class="font-semibold text-sm tabular-nums text-amber-600 dark:text-amber-400">
                            @query.AvgDuration
                        </span>
                        <span class="text-muted-foreground text-xs">avg duration</span>
                        <span class="text-muted-foreground text-xs">·</span>
                        <span class="text-muted-foreground text-xs tabular-nums">
                            @query.Calls calls
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record DbMetric(string Label, string Value, string Unit, string Color);
    private record SlowQuery(string Query, string AvgDuration, string Calls);

    private static readonly Dictionary<string, string> _colorMap = new()
    {
        ["emerald"] = "text-emerald-600 dark:text-emerald-400",
        ["amber"] = "text-amber-600 dark:text-amber-400",
        ["blue"] = "text-blue-600 dark:text-blue-400",
    };

    private static readonly DbMetric[] _dbMetrics =
    [
        new("Queries/sec", "2.4K", "qps", "emerald"),
        new("Avg Query Time", "12", "ms", "emerald"),
        new("Connections", "142", "/200", "amber"),
        new("Cache Hit Rate", "94.8", "%", "emerald"),
    ];

    private static readonly SlowQuery[] _slowQueries =
    [
        new("SELECT * FROM orders JOIN users ON orders.user_id = users.id WHERE created_at > ...", "847ms", "1,204"),
        new("UPDATE analytics SET page_views = page_views + 1 WHERE session_id = $1 AND ...", "523ms", "8,741"),
        new("SELECT COUNT(*) FROM events WHERE type IN ('click', 'scroll', 'hover') GROUP BY ...", "312ms", "3,290"),
        new("INSERT INTO audit_log (action, user_id, metadata, ip_address) VALUES ($1, $2, ...", "189ms", "15,672"),
        new("DELETE FROM temp_sessions WHERE expires_at < NOW() - INTERVAL '24 hours' AND ...", "156ms", "720"),
    ];
}
