@* ============================================================
   Block: dashboard-expense-tracker
   Title: Dashboard Expense Tracker
   Description: Animated React expense tracking dashboard block for Next.js with categorized expenses, approval status chips, receipt indicators, total and pending amounts, and staggered row animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: KPI metric cards with trend indicators
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-expense-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Expenses</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                @_expenses.Length items this period
            </p>
        </div>

        <div class="flex items-center gap-6 border-b px-4 py-3">
            <div>
                <p class="text-muted-foreground text-xs">Total</p>
                <span class="font-semibold text-2xl tabular-nums">@FormatCurrency(_total)</span>
            </div>
            <div>
                <p class="text-muted-foreground text-xs">Pending</p>
                <span class="font-semibold text-lg tabular-nums text-amber-600 dark:text-amber-400">
                    @FormatCurrency(_pending)
                </span>
            </div>
        </div>

        <div>
            @for (var i = 0; i < _expenses.Length; i++)
            {
                var expense = _expenses[i];
                var isLast = i == _expenses.Length - 1;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b"))">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        @switch (expense.Icon)
                        {
                            case "plane":
                                <LucidePlaneCn Size="16" Class="size-4 text-muted-foreground" />
                                break;
                            case "utensils":
                                <LucideUtensilsCn Size="16" Class="size-4 text-muted-foreground" />
                                break;
                            case "laptop":
                                <LucideLaptopCn Size="16" Class="size-4 text-muted-foreground" />
                                break;
                            case "coffee":
                                <LucideCoffeeCn Size="16" Class="size-4 text-muted-foreground" />
                                break;
                            case "wifi":
                                <LucideWifiCn Size="16" Class="size-4 text-muted-foreground" />
                                break;
                            case "shopping-bag":
                                <LucideShoppingBagCn Size="16" Class="size-4 text-muted-foreground" />
                                break;
                            case "file-text":
                                <LucideFileTextCn Size="16" Class="size-4 text-muted-foreground" />
                                break;
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@expense.Description</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@expense.Date</p>
                    </div>
                    <div class="flex items-center gap-2">
                        @if (expense.HasReceipt)
                        {
                            <LucidePaperclipCn Size="12" Class="size-3 text-muted-foreground/60" />
                        }
                        <span class="@(Cn.Merge("inline-block rounded-md px-1.5 py-0.5 text-xs", _statusStyles[expense.Status]))">
                            @_statusLabels[expense.Status]
                        </span>
                        <span class="w-16 text-right font-medium text-sm tabular-nums">
                            @FormatCurrency(expense.Amount)
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Expense(string Id, string Category, string Icon, string Description, double Amount, string Date, string Status, bool HasReceipt);

    private static string FormatCurrency(double amount) => $"${amount:F2}";

    private static readonly Dictionary<string, string> _statusStyles = new()
    {
        ["approved"] = "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        ["pending"] = "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        ["rejected"] = "bg-red-500/10 text-red-700 dark:text-red-400",
    };

    private static readonly Dictionary<string, string> _statusLabels = new()
    {
        ["approved"] = "Approved",
        ["pending"] = "Pending",
        ["rejected"] = "Rejected",
    };

    private static readonly Expense[] _expenses =
    [
        new("1", "Travel", "plane", "Flight to NYC \u2014 client meeting", 487.00, "Mar 12", "approved", true),
        new("2", "Meals", "utensils", "Team lunch \u2014 quarterly review", 156.40, "Mar 11", "approved", true),
        new("3", "Software", "laptop", "Figma annual license", 144.00, "Mar 10", "pending", true),
        new("4", "Office", "coffee", "Coffee supplies \u2014 kitchen restock", 62.50, "Mar 9", "approved", false),
        new("5", "Internet", "wifi", "Home office internet \u2014 March", 89.00, "Mar 8", "pending", true),
        new("6", "Equipment", "shopping-bag", "USB-C dock for engineering", 234.99, "Mar 7", "rejected", true),
        new("7", "Meals", "utensils", "Client dinner \u2014 Acme Corp", 198.75, "Mar 6", "approved", true),
        new("8", "Documents", "file-text", "Printing and binding \u2014 proposal", 45.00, "Mar 5", "pending", false),
    ];

    private static readonly double _total = _expenses.Sum(e => e.Amount);
    private static readonly double _pending = _expenses.Where(e => e.Status == "pending").Sum(e => e.Amount);
}
