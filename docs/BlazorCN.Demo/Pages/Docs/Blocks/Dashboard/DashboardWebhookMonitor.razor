@* ============================================================
   Block: dashboard-webhook-monitor
   Title: Dashboard Webhook Monitor
   Description: Webhook monitoring dashboard with delivery success rate, total events, failure count, average latency, and recent webhook events with endpoint URLs, response times, and status indicators
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-webhook-monitor.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Webhook Monitor</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Delivery status and event log</p>
        </div>

        <div class="grid grid-cols-4 border-b">
            @for (var i = 0; i < _summaryMetrics.Length; i++)
                        {
                var metric = _summaryMetrics[i];
                <div class="@($"px-4 py-3 {(i < _summaryMetrics.Length - 1 ? "border-r" : "")}")">
                    <p class="text-muted-foreground text-xs">@metric.Label</p>
                    <span class="@($"font-semibold text-lg tabular-nums {metric.Color}")">@metric.Value</span>
                </div>
            }
        </div>

        <div class="border-b px-4 py-2">
            <span class="font-medium text-muted-foreground text-xs">Recent Events</span>
        </div>

        <div>
            @for (var i = 0; i < _events.Length; i++)
                        {
                var evt = _events[i];
                var dotColor = evt.Status switch { "success" => "bg-emerald-500", "failed" => "bg-red-500", "timeout" => "bg-amber-500", _ => "bg-muted" };
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", i < _events.Length - 1 ? "border-b" : "")">
                    <span class="@($"size-1.5 shrink-0 rounded-full {dotColor}")"></span>
                    <span class="min-w-0 flex-1 truncate font-mono text-muted-foreground text-xs">@evt.Endpoint</span>
                    <span class="shrink-0 rounded-md bg-muted/50 px-1.5 py-0.5 font-mono text-muted-foreground text-xs tabular-nums">@evt.StatusCode</span>
                    <span class="w-16 shrink-0 text-right text-muted-foreground text-xs tabular-nums">@evt.ResponseTime</span>
                    <span class="w-16 shrink-0 text-right text-muted-foreground text-xs">@evt.Timestamp</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record MetricItem(string Label, string Value, string Color = "");
    private record EventItem(string Id, string Endpoint, string Status, string ResponseTime, string Timestamp, int StatusCode);

    private readonly MetricItem[] _summaryMetrics = [
        new("Success Rate", "99.2%"),
        new("Delivered", "12.4K"),
        new("Failed", "98", "text-red-600 dark:text-red-400"),
        new("Avg Latency", "142ms"),
    ];

    private readonly EventItem[] _events = [
        new("1", "https://api.acme.com/webhooks/orders", "success", "89ms", "2 min ago", 200),
        new("2", "https://hooks.stripe.com/events/checkout", "success", "124ms", "5 min ago", 200),
        new("3", "https://api.acme.com/webhooks/inventory", "failed", "3012ms", "8 min ago", 500),
        new("4", "https://notify.slack.com/incoming/T0x8F", "success", "201ms", "12 min ago", 200),
        new("5", "https://api.segment.io/v1/track", "success", "67ms", "18 min ago", 200),
        new("6", "https://api.acme.com/webhooks/users", "timeout", "30000ms", "24 min ago", 408),
        new("7", "https://hooks.zapier.com/catch/1847293", "success", "156ms", "31 min ago", 200),
        new("8", "https://api.hubspot.com/webhooks/v3", "success", "98ms", "45 min ago", 200),
    ];
}
