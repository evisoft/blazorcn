@* ============================================================
   Block: dashboard-content-calendar
   Title: Dashboard Content Calendar
   Description: Animated content publishing calendar dashboard for React and Next.js with a seven-day row view showing daily content items with type chips for Blog, Social, Email, and Video alongside titles and status indicators with today highlighted using framer-motion, shadcn/ui, and Tailwind CSS
   Long Description: Customer segmentation dashboard
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-content-calendar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Content Calendar</span>
            <div class="flex items-center gap-3">
                <span class="text-muted-foreground text-xs">
                    <span class="font-medium text-foreground tabular-nums">@_totalItems</span> items
                </span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs">
                    <span class="font-medium text-foreground tabular-nums">@_scheduled</span> scheduled
                </span>
            </div>
        </div>

        @* Status Legend *@
        <div class="flex items-center gap-4 border-b bg-muted/30 px-4 py-2">
            <span class="flex items-center gap-1.5 text-muted-foreground text-[10px]">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                Published
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-[10px]">
                <span class="size-1.5 rounded-full bg-amber-500"></span>
                Scheduled
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-[10px]">
                <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                Draft
            </span>
        </div>

        @* 7-Day Row *@
        <div class="grid grid-cols-7 divide-x">
            @foreach (var day in _days)
            {
                <div class="@(Cn.Merge("min-h-[140px] p-2", day.IsToday ? "bg-muted/30 ring-1 ring-inset ring-foreground/20" : ""))">
                    <div class="mb-2 text-center">
                        <span class="@(Cn.Merge("block text-[10px]", day.IsToday ? "font-medium text-foreground" : "text-muted-foreground"))">
                            @day.DayLabel
                        </span>
                        <span class="@(Cn.Merge("block font-medium text-xs tabular-nums", day.IsToday ? "text-foreground" : "text-muted-foreground"))">
                            @day.DateLabel
                        </span>
                    </div>
                    <div class="space-y-1.5">
                        @foreach (var item in day.Items)
                        {
                            <div class="rounded-md bg-muted/50 p-1.5">
                                <div class="mb-1 flex items-center gap-1">
                                    <span class="@(Cn.Merge("inline-flex rounded px-1 py-0.5 text-[8px] font-medium leading-none", GetTypeStyle(item.Type)))">
                                        @item.Type
                                    </span>
                                    <span class="@(Cn.Merge("ml-auto size-1.5 shrink-0 rounded-full", GetStatusDot(item.Status)))"></span>
                                </div>
                                <span class="line-clamp-2 text-[10px] leading-tight">@item.Title</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ContentItem(string Title, string Type, string Status);
    private record CalendarDay(string DayLabel, string DateLabel, bool IsToday, ContentItem[] Items);

    private static string GetTypeStyle(string type) => type switch
    {
        "Blog" => "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        "Social" => "bg-purple-500/10 text-purple-600 dark:text-purple-400",
        "Email" => "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        "Video" => "bg-red-500/10 text-red-600 dark:text-red-400",
        _ => ""
    };

    private static string GetStatusDot(string status) => status switch
    {
        "published" => "bg-emerald-500",
        "scheduled" => "bg-amber-500",
        "draft" => "bg-muted-foreground/40",
        _ => ""
    };

    private static readonly CalendarDay[] _days =
    [
        new("Mon", "Mar 17", false, [new("Q1 Product Recap", "Blog", "published"), new("Launch Announcement", "Social", "published")]),
        new("Tue", "Mar 18", true, [new("Feature Spotlight: Workflows", "Email", "scheduled")]),
        new("Wed", "Mar 19", false, [new("Customer Success Story", "Video", "scheduled"), new("Tips & Tricks Thread", "Social", "draft")]),
        new("Thu", "Mar 20", false, [new("API Best Practices Guide", "Blog", "draft")]),
        new("Fri", "Mar 21", false, [new("Weekly Digest", "Email", "draft"), new("Behind the Scenes", "Video", "draft")]),
        new("Sat", "Mar 22", false, [new("Community Roundup", "Social", "draft")]),
        new("Sun", "Mar 23", false, []),
    ];

    private static readonly int _totalItems = _days.Sum(d => d.Items.Length);
    private static readonly int _scheduled = _days.Sum(d => d.Items.Count(it => it.Status == "scheduled"));
}
