@* ============================================================
   Block: dashboard-profitability
   Title: Dashboard Profitability
   Description: Animated React unit economics and profitability dashboard block for Next.js displaying CAC, LTV, payback period, gross margin, LTV-to-CAC ratio, and cohort-level margin analysis with expandable rows using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Revenue by source visualization
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-profitability.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Unit Economics</span>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Profitability and cohort margin analysis
            </p>
        </div>

        @* KPI grid *@
        <div class="grid grid-cols-3 border-b">
            @for (var i = 0; i < _kpis.Length; i++)
            {
                var kpi = _kpis[i];
                <div class="@(Cn.Merge("px-4 py-3", i < 3 ? "border-b" : "", i % 3 != 2 ? "border-r" : ""))">
                    <p class="text-muted-foreground text-xs">@kpi.Label</p>
                    <div class="mt-1 flex items-baseline gap-1.5">
                        <span class="@(Cn.Merge("font-semibold text-lg tabular-nums", kpi.Color))">
                            @kpi.Value
                        </span>
                        <span class="flex items-center gap-0.5 text-muted-foreground text-[10px] tabular-nums">
                            @if (kpi.Up)
                            {
                                <LucideArrowUpRightCn Size="12" Class="size-3 text-emerald-500" />
                            }
                            else
                            {
                                <LucideArrowDownRightCn Size="12" Class="size-3 text-emerald-500" />
                            }
                            @kpi.Trend
                        </span>
                    </div>
                </div>
            }
        </div>

        @* Cohort section header *@
        <div class="border-b px-4 py-2">
            <span class="font-medium text-muted-foreground text-xs">Cohort Margins</span>
        </div>

        @* Cohort rows *@
        <div>
            @for (var i = 0; i < _cohorts.Length; i++)
            {
                var cohort = _cohorts[i];
                var isExpanded = _expanded == cohort.Id;
                var isLast = i == _cohorts.Length - 1;
                <div class="@(!isLast || isExpanded ? "border-b" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : cohort.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@cohort.Month</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @cohort.Customers customers · @cohort.Revenue revenue
                            </p>
                        </div>
                        <span class="@(Cn.Merge("font-semibold text-sm tabular-nums", MarginColor(cohort.Margin)))">
                            @(cohort.Margin)%
                        </span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4">
                            <div class="grid grid-cols-3 gap-4 rounded-md bg-muted/50 p-3">
                                <div>
                                    <span class="text-muted-foreground text-xs">Revenue</span>
                                    <p class="mt-0.5 font-semibold text-sm tabular-nums">
                                        @cohort.Revenue
                                    </p>
                                </div>
                                <div>
                                    <span class="text-muted-foreground text-xs">Costs</span>
                                    <p class="mt-0.5 font-semibold text-sm tabular-nums text-red-600 dark:text-red-400">
                                        @cohort.Costs
                                    </p>
                                </div>
                                <div>
                                    <span class="text-muted-foreground text-xs">Retained</span>
                                    <p class="mt-0.5 font-semibold text-sm tabular-nums">
                                        @cohort.Retained/@cohort.Customers
                                    </p>
                                </div>
                            </div>
                            <div class="mt-3">
                                <div class="mb-1.5 flex items-center justify-between">
                                    <span class="text-muted-foreground text-xs">Gross margin</span>
                                    <span class="font-medium text-xs tabular-nums">
                                        @(cohort.Margin)%
                                    </span>
                                </div>
                                <div class="h-1.5 overflow-hidden rounded-full bg-muted/50">
                                    <div class="@(Cn.Merge("h-full rounded-full", cohort.Margin >= 78 ? "bg-emerald-500" : cohort.Margin >= 72 ? "bg-amber-500" : "bg-red-500"))"
                                         style="@($"width: {cohort.Margin}%")"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "c1";

    private record KpiMetric(string Label, string Value, string Trend, bool Up, string Color);
    private record Cohort(string Id, string Month, string Revenue, string Costs, double Margin, int Customers, int Retained);

    private static string MarginColor(double margin) =>
        margin >= 78 ? "text-emerald-600 dark:text-emerald-400"
        : margin >= 72 ? "text-amber-600 dark:text-amber-400"
        : "text-red-600 dark:text-red-400";

    private static readonly KpiMetric[] _kpis =
    [
        new("CAC", "$142", "-8.2%", false, "text-emerald-600 dark:text-emerald-400"),
        new("LTV", "$1,840", "+12.1%", true, "text-emerald-600 dark:text-emerald-400"),
        new("Payback Period", "3.4mo", "-0.6mo", false, "text-emerald-600 dark:text-emerald-400"),
        new("Gross Margin", "78.2%", "+1.4%", true, ""),
        new("NRR", "112%", "+3.2%", true, "text-emerald-600 dark:text-emerald-400"),
        new("LTV:CAC", "12.9x", "+2.1x", true, "text-emerald-600 dark:text-emerald-400"),
    ];

    private static readonly Cohort[] _cohorts =
    [
        new("c1", "Mar 2026", "$48.2K", "$9.6K", 80.1, 245, 238),
        new("c2", "Feb 2026", "$52.8K", "$11.1K", 79.0, 268, 251),
        new("c3", "Jan 2026", "$44.6K", "$10.2K", 77.1, 221, 198),
        new("c4", "Dec 2025", "$39.1K", "$9.4K", 76.0, 198, 171),
        new("c5", "Nov 2025", "$41.7K", "$10.8K", 74.1, 210, 176),
    ];
}
