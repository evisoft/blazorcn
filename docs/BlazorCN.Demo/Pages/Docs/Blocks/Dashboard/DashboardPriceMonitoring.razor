@* ============================================================
   Block: dashboard-price-monitoring
   Title: Dashboard Price Monitoring
   Description: Animated React competitor price monitoring dashboard block for Next.js with eight products showing your price versus competitor prices, price difference percentages, price change direction arrows, alert indicators for undercut pricing, and staggered row entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Revenue allocation by product and channel
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-price-monitoring.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideTagCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Price Monitoring</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @_products.Length products tracked
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                @if (_undercutCount > 0)
                {
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        @_undercutCount undercut
                    </span>
                }
                <span class="text-muted-foreground text-xs tabular-nums">
                    Avg @(_avgDiff > 0 ? "+" : "")@_avgDiff.ToString("F1")%
                </span>
            </div>
        </div>

        @* Products *@
        <div>
            @for (var i = 0; i < _products.Length; i++)
            {
                var product = _products[i];
                var isExpanded = _expanded == product.Id;
                var isLast = i == _products.Length - 1;

                <div class="@(!isLast ? "border-b" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : product.Id)"
                        class="w-full px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex items-center gap-3">
                            <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", product.IsUndercut ? "bg-red-500" : "bg-emerald-500"))"></span>
                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-sm">@product.Name</span>
                                <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                    <span class="font-mono">@product.Sku</span>
                                    <span>&middot;</span>
                                    <span>@product.Category</span>
                                </div>
                            </div>
                            <div class="flex shrink-0 items-center gap-4">
                                <div class="text-right">
                                    <span class="font-medium text-sm tabular-nums">
                                        @FormatPrice(product.YourPrice)
                                    </span>
                                    <p class="mt-0.5 text-muted-foreground text-xs">Your price</p>
                                </div>
                                <div class="text-right">
                                    <span class="font-medium text-sm tabular-nums">
                                        @FormatPrice(product.CompetitorPrice)
                                    </span>
                                    <p class="mt-0.5 text-muted-foreground text-xs">
                                        @product.CompetitorName
                                    </p>
                                </div>
                                <div class="flex w-14 items-center justify-end gap-1">
                                    @if (product.Trend == "up")
                                    {
                                        <LucideArrowUpCn Size="12" Class="size-3 text-red-500" />
                                    }
                                    else if (product.Trend == "down")
                                    {
                                        <LucideArrowDownCn Size="12" Class="size-3 text-amber-500" />
                                    }
                                    else
                                    {
                                        <LucideMinusCn Size="12" Class="size-3 text-muted-foreground" />
                                    }
                                    <span class="@(Cn.Merge("font-medium text-xs tabular-nums", product.IsUndercut ? "text-red-600 dark:text-red-400" : "text-emerald-600 dark:text-emerald-400"))">
                                        @(product.DiffPercent > 0 ? "+" : "")@product.DiffPercent%
                                    </span>
                                </div>
                            </div>
                            <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-3 pl-9">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <div class="grid grid-cols-3 gap-x-4 gap-y-2 text-xs">
                                        <div>
                                            <span class="text-muted-foreground">Difference</span>
                                            <p class="mt-0.5 font-medium tabular-nums">
                                                @FormatPrice(Math.Abs(product.YourPrice - product.CompetitorPrice))
                                            </p>
                                        </div>
                                        <div>
                                            <span class="text-muted-foreground">Last checked</span>
                                            <p class="mt-0.5 font-medium">@product.LastChecked</p>
                                        </div>
                                        <div>
                                            <span class="text-muted-foreground">Source</span>
                                            <p class="mt-0.5 truncate font-mono">@product.CompetitorUrl</p>
                                        </div>
                                    </div>
                                    @if (product.IsUndercut)
                                    {
                                        <p class="mt-2 text-red-600 text-xs dark:text-red-400">
                                            Competitor is undercutting your price by @Math.Abs(product.DiffPercent).ToString("F1")%
                                        </p>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record ProductData(string Id, string Name, string Sku, double YourPrice, double CompetitorPrice, string CompetitorName, double DiffPercent, string Trend, bool IsUndercut, string LastChecked, string Category, string CompetitorUrl);

    private int _undercutCount => _products.Count(p => p.IsUndercut);
    private double _avgDiff => _products.Average(p => p.DiffPercent);

    private static string FormatPrice(double price) => $"${price:F2}";

    private readonly ProductData[] _products = new[]
    {
        new ProductData("1", "Wireless Noise-Canceling Headphones", "WH-1000XM5", 349.99, 319.99, "TechMart", -8.6, "down", true, "15 min ago", "Audio", "techmart.com/wh1000xm5"),
        new ProductData("2", "Mechanical Keyboard RGB", "KB-MX-PRO", 159.99, 169.99, "GearHub", 6.3, "up", false, "22 min ago", "Peripherals", "gearhub.io/kb-mx-pro"),
        new ProductData("3", "4K Webcam Pro", "WC-4K-PRO", 199.99, 189.99, "StreamShop", -5.0, "stable", false, "8 min ago", "Video", "streamshop.com/4k-webcam"),
        new ProductData("4", "USB-C Docking Station", "DS-USBC-12", 249.99, 219.99, "DockDirect", -12.0, "down", true, "5 min ago", "Accessories", "dockdirect.com/usbc-12"),
        new ProductData("5", "Ergonomic Office Chair", "CH-ERGO-V3", 899.0, 949.0, "OfficePro", 5.6, "up", false, "30 min ago", "Furniture", "officepro.com/ergo-v3"),
        new ProductData("6", "32\" Curved Monitor", "MN-32-CURVED", 449.99, 429.99, "DisplayMax", -4.4, "stable", false, "12 min ago", "Displays", "displaymax.com/32-curved"),
        new ProductData("7", "Standing Desk Electric", "DK-STAND-E", 699.0, 599.0, "DeskWorks", -14.3, "down", true, "18 min ago", "Furniture", "deskworks.com/standing-e"),
        new ProductData("8", "Portable SSD 2TB", "SSD-P-2TB", 129.99, 134.99, "StorePlus", 3.8, "up", false, "9 min ago", "Storage", "storeplus.com/ssd-2tb")
    };
}
