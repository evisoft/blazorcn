@* ============================================================
   Block: dashboard-support-tickets
   Title: Dashboard Support Tickets
   Description: Animated React support tickets dashboard block for Next.js with eight expandable helpdesk tickets showing priority indicators, status chips, assignee initials, and collapsible details using AnimatePresence with shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Hourly error bar chart with severity indicators
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-support-tickets.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Support Tickets</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">Recent helpdesk requests</p>
            </div>
            <div class="flex items-center gap-2">
                <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                    @_openCount open
                </span>
            </div>
        </div>

        <div>
            @for (var i = 0; i < _tickets.Length; i++)
            {
                var ticket = _tickets[i];
                var isExpanded = _expanded == ticket.Id;
                var isLast = i == _tickets.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : ticket.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", _priorityDot[ticket.Priority]))"></span>
                        <span class="w-16 shrink-0 font-mono text-muted-foreground text-xs">
                            @ticket.Id
                        </span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@ticket.Subject</span>
                        </div>
                        <span class="hidden shrink-0 rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground sm:inline">
                            @_statusLabel[ticket.Status]
                        </span>
                        <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                            @ticket.Assignee
                        </div>
                        <span class="hidden w-16 shrink-0 text-right text-muted-foreground text-xs sm:inline">
                            @ticket.Created
                        </span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-[4.5rem]">
                            <p class="text-muted-foreground text-sm leading-relaxed">
                                @ticket.Description
                            </p>
                            <div class="mt-3 flex items-center gap-2">
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                    Assign
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                    Reply
                                </ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record Ticket(string Id, string Subject, string Priority, string Status, string Assignee, string Created, string Description);

    private static readonly Dictionary<string, string> _priorityDot = new()
    {
        ["critical"] = "bg-red-500",
        ["high"] = "bg-amber-500",
        ["medium"] = "bg-blue-500",
        ["low"] = "bg-slate-400",
    };

    private static readonly Dictionary<string, string> _statusLabel = new()
    {
        ["open"] = "Open",
        ["in-progress"] = "In Progress",
        ["resolved"] = "Resolved",
    };

    private static readonly Ticket[] _tickets =
    [
        new("TK-4821", "Payment processing fails for EU customers", "critical", "open", "MK", "12 min ago",
            "Stripe webhook returns 402 for cards issued in Germany and France. Affects approximately 15% of EU transactions since the latest deployment."),
        new("TK-4819", "Dashboard loading timeout on large datasets", "critical", "in-progress", "JR", "34 min ago",
            "Users with 10K+ records experience 30-second load times. The analytics query needs pagination or cursor-based fetching."),
        new("TK-4817", "SSO login redirect loop with Okta", "high", "open", "AL", "1 hr ago",
            "SAML assertion validation fails intermittently causing infinite redirect between IdP and SP. Affects three enterprise accounts."),
        new("TK-4815", "CSV export missing custom field columns", "high", "in-progress", "PS", "2 hr ago",
            "Exported CSV files do not include columns added via custom fields API. The serializer skips fields with type enum or multi-select."),
        new("TK-4812", "Email notifications delayed by 15 minutes", "medium", "open", "MK", "3 hr ago",
            "Transactional emails via SendGrid are queued but not delivered promptly. The batch job interval needs to be reduced from 15 to 1 minute."),
        new("TK-4810", "Mobile app crashes on image upload", "medium", "in-progress", "TR", "4 hr ago",
            "iOS app crashes when uploading images larger than 8 MB. The multipart upload handler does not enforce a size check before processing."),
        new("TK-4807", "Typo in onboarding welcome email template", "low", "open", "AL", "5 hr ago",
            "The welcome email says 'Thank you for singing up' instead of 'signing up'. Template is in the email-templates repository."),
        new("TK-4805", "Update API documentation for v3 endpoints", "low", "resolved", "PS", "6 hr ago",
            "The /api/v3/users endpoint documentation still references v2 request body schema. OpenAPI spec needs regeneration from the latest controller annotations."),
    ];
    private static readonly int _openCount = _tickets.Count(t => t.Status == "open" || t.Status == "in-progress");

}
