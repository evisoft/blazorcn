@* ============================================================
   Block: dashboard-git-activity
   Title: Dashboard Git Activity
   Description: Animated React git activity dashboard block for Next.js with commit history, pull request stats, code review metrics, contribution heatmap-style grid, and staggered entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Team member activity feed with avatars
   Dependencies: BadgeCn
   Source: original/blocks/dashboard/dashboard-git-activity.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Git Activity</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Last 28 days
            </BadgeCn>
        </div>

        @* Summary stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-center gap-1.5">
                <LucideGitCommitHorizontalCn Size="12" Class="size-3.5 text-muted-foreground" />
                <div>
                    <p class="font-semibold text-2xl tabular-nums">@_totalCommits</p>
                    <p class="text-muted-foreground text-xs">commits</p>
                </div>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div class="flex items-center gap-1.5">
                <LucideGitPullRequestCn Size="12" Class="size-3.5 text-muted-foreground" />
                <div>
                    <p class="font-semibold text-sm tabular-nums">@_openPRs open</p>
                    <p class="text-muted-foreground text-xs">pull requests</p>
                </div>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">Avg merge</p>
                <p class="font-semibold text-sm tabular-nums">@_avgMergeTime</p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">Avg review</p>
                <p class="font-semibold text-sm tabular-nums">@_avgReviewTime</p>
            </div>
        </div>

        @* Heatmap *@
        <div class="border-b px-4 py-3">
            <p class="mb-2.5 text-muted-foreground text-xs">Contribution activity</p>
            <div class="flex gap-2">
                <div class="flex flex-col gap-1 pt-0.5">
                    @foreach (var day in _dayLabels)
                    {
                        <span class="flex h-4 items-center text-muted-foreground text-[10px]">
                            @day
                        </span>
                    }
                </div>
                <div class="flex flex-1 gap-1">
                    @foreach (var week in _heatmapData)
                    {
                        <div class="flex flex-1 flex-col gap-1">
                            @foreach (var level in week)
                            {
                                <div class="@(Cn.Merge("h-4 rounded-sm", _activityColor[level]))"></div>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="mt-2 flex items-center justify-end gap-1.5">
                <span class="text-muted-foreground text-[10px]">Less</span>
                @for (var lvl = 0; lvl <= 3; lvl++)
                {
                    <span class="@(Cn.Merge("size-3 rounded-sm", _activityColor[lvl]))"></span>
                }
                <span class="text-muted-foreground text-[10px]">More</span>
            </div>
        </div>

        @* Contributors *@
        <div>
            @for (var i = 0; i < _contributors.Length; i++)
            {
                var contrib = _contributors[i];
                var isLast = i == _contributors.Length - 1;

                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b"))">
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@contrib.Name</span>
                        <p class="text-muted-foreground text-xs">@contrib.Handle</p>
                    </div>
                    <span class="flex items-center gap-1 text-muted-foreground text-xs tabular-nums">
                        <LucideGitCommitHorizontalCn Size="12" Class="size-3" />
                        @contrib.Commits
                    </span>
                    <span class="flex items-center gap-1 text-muted-foreground text-xs tabular-nums">
                        <LucideGitPullRequestCn Size="12" Class="size-3" />
                        @contrib.PrsMerged/@contrib.PrsOpened
                    </span>
                    <span class="flex items-center gap-1 text-muted-foreground text-xs tabular-nums">
                        <LucideMessageSquareCn Size="12" Class="size-3" />
                        @contrib.Reviews
                    </span>
                    <span class="w-16 text-right text-emerald-600 text-xs tabular-nums dark:text-emerald-400">
                        @contrib.LinesAdded
                    </span>
                    <span class="w-16 text-right text-red-600 text-xs tabular-nums dark:text-red-400">
                        @contrib.LinesDeleted
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ContributorData(string Id, string Name, string Handle, int Commits, int PrsOpened, int PrsMerged, int Reviews, string LinesAdded, string LinesDeleted);

    private const int _totalCommits = 247;
    private const int _openPRs = 14;
    private const string _avgMergeTime = "6.2h";
    private const string _avgReviewTime = "2.8h";

    private readonly string[] _dayLabels = { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };

    private readonly Dictionary<int, string> _activityColor = new()
    {
        [0] = "bg-foreground/5",
        [1] = "bg-foreground/15",
        [2] = "bg-foreground/30",
        [3] = "bg-foreground/50"
    };

    private readonly int[][] _heatmapData = new[]
    {
        new[] { 2, 3, 2, 1, 3, 0, 0 },
        new[] { 1, 2, 3, 2, 2, 1, 0 },
        new[] { 3, 3, 2, 3, 1, 0, 1 },
        new[] { 2, 3, 3, 2, 3, 1, 0 }
    };

    private readonly ContributorData[] _contributors = new[]
    {
        new ContributorData("1", "Alex Rivera", "@@arivera", 62, 8, 7, 24, "+4,210", "-1,890"),
        new ContributorData("2", "Priya Sharma", "@@psharma", 48, 6, 5, 31, "+2,840", "-3,120"),
        new ContributorData("3", "Jordan Lee", "@@jlee", 51, 9, 8, 15, "+5,670", "-980"),
        new ContributorData("4", "Sam Okafor", "@@sokafor", 44, 5, 4, 28, "+1,920", "-2,450"),
        new ContributorData("5", "Mia Zhang", "@@mzhang", 42, 7, 6, 19, "+3,540", "-1,210")
    };
}
