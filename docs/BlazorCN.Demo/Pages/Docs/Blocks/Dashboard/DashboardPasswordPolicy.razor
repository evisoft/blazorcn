@* ============================================================
   Block: dashboard-password-policy
   Title: Dashboard Password Policy
   Description: Animated React password policy compliance dashboard block for Next.js with per-group strength audits, policy rule checklist with pass fail indicators, compliance percentages with animated bars, and expandable group details using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Threat detection and vulnerability summary
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-password-policy.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Password Policy</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Organization-wide compliance audit
                </p>
            </div>
            <div class="flex items-center gap-2">
                <span class="@(Cn.Merge("size-1.5 rounded-full", _overallCompliance >= 80 ? "bg-emerald-500" : _overallCompliance >= 60 ? "bg-amber-500" : "bg-red-500"))"></span>
                <span class="font-semibold text-sm tabular-nums">@_overallCompliance%</span>
                <span class="text-muted-foreground text-xs">compliant</span>
            </div>
        </div>

        @* Policy Rules *@
        <div class="border-b px-4 py-3">
            <span class="text-muted-foreground text-xs font-medium">Policy Rules</span>
            <div class="mt-2 space-y-1.5">
                @foreach (var rule in _policyRules)
                {
                    var pct = (int)Math.Round((double)rule.Passing / rule.Total * 100);
                    var allPass = rule.Passing == rule.Total;
                    <div class="flex items-center gap-2">
                        @if (allPass)
                        {
                            <LucideCheckCn Size="14" Class="size-3.5 shrink-0 text-emerald-500" />
                        }
                        else
                        {
                            <LucideShieldAlertCn Size="14" Class="size-3.5 shrink-0 text-amber-500" />
                        }
                        <span class="min-w-0 flex-1 text-xs">@rule.Label</span>
                        <span class="shrink-0 font-mono text-muted-foreground text-[10px] tabular-nums">
                            @rule.Passing/@rule.Total
                        </span>
                        <div class="h-1 w-12 shrink-0 overflow-hidden rounded-full bg-muted">
                            <div class="@(Cn.Merge("h-full rounded-full", allPass ? "bg-emerald-500" : "bg-amber-500"))"
                                 style="@($"width: {pct}%")">
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* User Groups *@
        <div>
            @for (var i = 0; i < _userGroups.Length; i++)
            {
                var group = _userGroups[i];
                var isExpanded = _expanded == group.Id;
                var isLast = i == _userGroups.Length - 1;
                var pct = (int)Math.Round((double)group.Compliant / group.TotalUsers * 100);

                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : group.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", pct >= 90 ? "bg-emerald-500" : pct >= 70 ? "bg-amber-500" : "bg-red-500"))"></span>
                        <span class="font-medium text-sm">@group.Name</span>
                        <span class="min-w-0 flex-1"></span>
                        <span class="shrink-0 text-muted-foreground text-xs tabular-nums">
                            @group.Compliant/@group.TotalUsers users
                        </span>
                        <div class="h-1.5 w-16 shrink-0 overflow-hidden rounded-full bg-muted">
                            <div class="@(Cn.Merge("h-full rounded-full", pct >= 90 ? "bg-emerald-500" : pct >= 70 ? "bg-amber-500" : "bg-red-500"))"
                                 style="@($"width: {pct}%")">
                            </div>
                        </div>
                        <span class="@(Cn.Merge("shrink-0 font-mono text-xs tabular-nums", pct >= 90 ? "text-emerald-600 dark:text-emerald-400" : pct >= 70 ? "text-amber-600 dark:text-amber-400" : "text-red-600 dark:text-red-400"))">
                            @pct%
                        </span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-3 pl-8">
                                @if (group.Issues.Length > 0)
                                {
                                    <div class="space-y-1">
                                        @foreach (var issue in group.Issues)
                                        {
                                            <div class="flex items-center gap-2">
                                                <LucideXCn Size="12" Class="size-3 shrink-0 text-red-500/60" />
                                                <span class="text-muted-foreground text-xs">@issue</span>
                                            </div>
                                        }
                                        <div class="mt-2">
                                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                                Send Reminder
                                            </ButtonCn>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="flex items-center gap-2">
                                        <LucideCheckCn Size="12" Class="size-3 shrink-0 text-emerald-500" />
                                        <span class="text-muted-foreground text-xs">
                                            All users fully compliant
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record PolicyRule(string Id, string Label, string Description, int Passing, int Total);
    private record UserGroup(string Id, string Name, int TotalUsers, int Compliant, int AvgStrength, string LastAudit, string[] Issues);

    private int _overallCompliance => (int)Math.Round((double)_userGroups.Sum(g => g.Compliant) / _userGroups.Sum(g => g.TotalUsers) * 100);

    private readonly PolicyRule[] _policyRules = new[]
    {
        new PolicyRule("r1", "Minimum 12 characters", "All passwords must be at least 12 characters long", 342, 378),
        new PolicyRule("r2", "Uppercase required", "At least one uppercase letter required", 361, 378),
        new PolicyRule("r3", "Special character required", "At least one special character (!@@#$%^&*)", 298, 378),
        new PolicyRule("r4", "Max 90-day age", "Passwords must be rotated within 90 days", 315, 378),
        new PolicyRule("r5", "No reuse (last 5)", "Cannot reuse any of the last 5 passwords", 370, 378),
        new PolicyRule("r6", "MFA enrolled", "Multi-factor authentication must be enabled", 289, 378)
    };

    private readonly UserGroup[] _userGroups = new[]
    {
        new UserGroup("g1", "Engineering", 124, 118, 92, "2 days ago", new[] { "6 users need password rotation", "3 users missing MFA" }),
        new UserGroup("g2", "Sales", 86, 64, 71, "2 days ago", new[] { "14 users below minimum length", "8 users missing special chars" }),
        new UserGroup("g3", "Marketing", 52, 41, 78, "2 days ago", new[] { "7 users need password rotation", "4 users missing MFA" }),
        new UserGroup("g4", "Executive", 18, 18, 96, "2 days ago", Array.Empty<string>()),
        new UserGroup("g5", "Support", 64, 48, 68, "2 days ago", new[] { "11 users below minimum length", "5 users need rotation" }),
        new UserGroup("g6", "Contractors", 34, 22, 58, "2 days ago", new[] { "8 users missing MFA", "4 users password reuse detected" })
    };
}
