@* ============================================================
   Block: dashboard-release-tracker
   Title: Dashboard Release Tracker
   Description: Animated React release management dashboard block for Next.js with version numbers, release titles, date strings, status chips, feature and bug fix counts, author initials, and progress bars for planned releases using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: KPI metric cards with trend indicators
   Dependencies: ProgressCn
   Source: original/blocks/dashboard/dashboard-release-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Releases</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_releases.Length versions tracked
                </p>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_releases.Count(r => r.Status == "released") shipped
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    @_releases.Count(r => r.Status is "beta" or "rc") in progress
                </span>
            </div>
        </div>

        <div>
            @for (var i = 0; i < _releases.Length; i++)
            {
                var release = _releases[i];
                var isLast = i == _releases.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="shrink-0 font-mono text-muted-foreground text-xs">
                                    @release.Version
                                </span>
                                <span class="truncate font-medium text-sm">@release.Title</span>
                                <span class="@(Cn.Merge("shrink-0 rounded-md px-1.5 py-0.5 text-xs", _statusStyles[release.Status]))">
                                    @_statusLabel[release.Status]
                                </span>
                            </div>
                            <div class="mt-1.5 flex items-center gap-3">
                                <span class="text-muted-foreground text-xs">@release.Date</span>
                                @if (release.Features > 0)
                                {
                                    <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                        <LucideBoxCn Size="12" Class="size-3" />
                                        <span class="tabular-nums">@release.Features</span> features
                                    </span>
                                }
                                @if (release.Fixes > 0)
                                {
                                    <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                        <LucideBugCn Size="12" Class="size-3" />
                                        <span class="tabular-nums">@release.Fixes</span> fixes
                                    </span>
                                }
                            </div>
                        </div>
                        <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-muted-foreground text-xs">
                            @release.Author
                        </span>
                    </div>

                    @if (release.Progress.HasValue)
                    {
                        <div class="flex items-center gap-3 border-t px-4 py-2">
                            <span class="shrink-0 text-muted-foreground text-xs">Progress</span>
                            <div class="flex-1">
                                <ProgressCn Value="@release.Progress.Value" Class="h-1.5" aria-label="Progress" />
                            </div>
                            <span class="shrink-0 text-muted-foreground text-xs tabular-nums">
                                @(release.Progress)%
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Release(string Id, string Version, string Title, string Date, string Status, int Features, int Fixes, string Author, int? Progress = null);

    private static readonly Dictionary<string, string> _statusStyles = new()
    {
        ["released"] = "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        ["beta"] = "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        ["rc"] = "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        ["planned"] = "bg-zinc-500/10 text-zinc-700 dark:text-zinc-400",
    };

    private static readonly Dictionary<string, string> _statusLabel = new()
    {
        ["released"] = "Released",
        ["beta"] = "Beta",
        ["rc"] = "RC",
        ["planned"] = "Planned",
    };

    private static readonly Release[] _releases =
    [
        new("1", "v3.2.0", "Dashboard Redesign", "Mar 14, 2026", "released", 12, 8, "SC"),
        new("2", "v3.3.0", "API Rate Limiting", "Mar 17, 2026", "beta", 6, 3, "JW"),
        new("3", "v3.3.1", "Hotfix: Auth Token Refresh", "Mar 18, 2026", "rc", 0, 4, "DP"),
        new("4", "v3.4.0", "Team Workspaces", "Apr 2, 2026", "planned", 18, 0, "AT", 34),
        new("5", "v4.0.0", "Next.js 16 Migration", "Apr 28, 2026", "planned", 24, 12, "MJ", 12),
    ];
}
