@* ============================================================
   Block: dashboard-code-quality
   Title: Dashboard Code Quality
   Description: Animated React code quality dashboard block for Next.js with six metrics showing coverage percentage, tech debt days, code smells count, duplication rate, bugs, and vulnerabilities in a responsive grid with color-coded scores and animated coverage bar using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Service availability with 30-day charts
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-code-quality.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Code Quality</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    main branch · last scan 2 hours ago
                </p>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-muted-foreground text-xs">Passing</span>
            </div>
        </div>

        @* Coverage Bar *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Test Coverage</span>
                <span class="font-semibold text-sm tabular-nums text-emerald-600 dark:text-emerald-400">
                    @(_coverageValue)%
                </span>
            </div>
            <div class="h-2 overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-emerald-500"
                     style="@($"width: {_coverageValue}%")">
                </div>
            </div>
            <div class="mt-1.5 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">1,247 of 1,433 lines covered</span>
                <span class="text-muted-foreground text-xs">Target: 85%</span>
            </div>
        </div>

        @* Metrics Grid *@
        <div class="grid grid-cols-2 md:grid-cols-3">
            @for (var i = 0; i < _metrics.Length; i++)
            {
                var metric = _metrics[i];
                var isNotLastRow = i < _metrics.Length - 2;
                var isOdd = i % 2 == 0;
                var isLastRowMd = i >= _metrics.Length - 3;
                <div class="@(Cn.Merge("px-4 py-3", isNotLastRow ? "border-b" : "", isOdd ? "border-r" : "", i % 3 != 2 ? "md:border-r" : "md:border-r-0", !isLastRowMd ? "md:border-b" : "md:border-b-0"))">
                    <div class="flex items-center gap-1.5">
                        <span class="@(Cn.Merge("size-1.5 rounded-full", GetColorBg(metric.Color)))"></span>
                        <span class="font-medium text-muted-foreground text-xs">@metric.Label</span>
                    </div>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="@(Cn.Merge("font-semibold text-2xl tabular-nums", GetColorText(metric.Color)))">
                            @metric.Value
                        </span>
                        <span class="text-muted-foreground text-xs">@metric.Unit</span>
                    </div>
                    <p class="mt-0.5 text-muted-foreground text-xs">@metric.Description</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record QualityMetric(string Label, string Value, string Unit, string Color, string Description);

    private const int _coverageValue = 87;

    private static string GetColorBg(string color) => color switch
    {
        "emerald" => "bg-emerald-500",
        "amber" => "bg-amber-500",
        "red" => "bg-red-500",
        _ => ""
    };

    private static string GetColorText(string color) => color switch
    {
        "emerald" => "text-emerald-600 dark:text-emerald-400",
        "amber" => "text-amber-600 dark:text-amber-400",
        "red" => "text-red-600 dark:text-red-400",
        _ => ""
    };

    private static readonly QualityMetric[] _metrics =
    [
        new("Coverage", "87", "%", "emerald", "Unit + integration tests"),
        new("Tech Debt", "12", "days", "amber", "Estimated remediation time"),
        new("Code Smells", "23", "issues", "amber", "Maintainability issues"),
        new("Duplications", "2.1", "%", "emerald", "Duplicated lines of code"),
        new("Bugs", "4", "issues", "red", "Reliability issues found"),
        new("Vulnerabilities", "1", "issue", "amber", "Security vulnerabilities"),
    ];
}
