@* ============================================================
   Block: dashboard-performance-scores
   Title: Dashboard Performance Scores
   Description: Animated Core Web Vitals performance scores dashboard for React and Next.js with six metrics in a 3x2 grid showing score numbers with colored ring borders, rating labels, and animated entrance in a two-column layout using framer-motion, shadcn/ui, and Tailwind CSS
   Long Description: Revenue by source visualization
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-performance-scores.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Performance Scores</span>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_metrics.Count(m => m.Rating == "good") passed
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_metrics.Count(m => m.Rating != "good") needs work
                </span>
            </div>
        </div>

        @* 3x2 Grid *@
        <div class="grid grid-cols-3 divide-x">
            @for (var i = 0; i < _metrics.Length; i++)
            {
                var metric = _metrics[i];
                var config = _ratingConfig[metric.Rating];
                <div class="@(Cn.Merge("flex flex-col items-center px-4 py-5", i < 3 ? "border-b" : ""))">
                    @* Score Ring *@
                    <div class="@(Cn.Merge("mb-2 flex size-16 items-center justify-center rounded-full border-2", config.RingColor))">
                        <span class="@(Cn.Merge("font-semibold text-xl tabular-nums", config.TextColor))">
                            @metric.Value@if (!string.IsNullOrEmpty(metric.Unit)){<span class="font-normal text-xs">@metric.Unit</span>}
                        </span>
                    </div>

                    @* Metric Name *@
                    <span class="font-mono font-medium text-sm">@metric.Name</span>

                    @* Rating Label *@
                    <span class="@(Cn.Merge("mt-0.5 text-xs", config.TextColor))">@config.Label</span>

                    @* Description *@
                    <span class="mt-1 text-center text-muted-foreground text-[10px]">
                        @metric.Description
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record PerfMetric(string Name, string Value, string Unit, string Rating, string Description);
    private record RatingConfig(string Label, string RingColor, string TextColor);

    private static readonly Dictionary<string, RatingConfig> _ratingConfig = new()
    {
        ["good"] = new("Good", "border-emerald-500", "text-emerald-600 dark:text-emerald-400"),
        ["needs-work"] = new("Needs Work", "border-amber-500", "text-amber-600 dark:text-amber-400"),
        ["poor"] = new("Poor", "border-red-500", "text-red-600 dark:text-red-400"),
    };

    private static readonly PerfMetric[] _metrics =
    [
        new("LCP", "2.1", "s", "good", "Largest Contentful Paint"),
        new("FID", "45", "ms", "good", "First Input Delay"),
        new("CLS", "0.08", "", "needs-work", "Cumulative Layout Shift"),
        new("TTFB", "180", "ms", "needs-work", "Time to First Byte"),
        new("FCP", "1.2", "s", "good", "First Contentful Paint"),
        new("INP", "120", "ms", "needs-work", "Interaction to Next Paint"),
    ];
}
