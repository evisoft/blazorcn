@* ============================================================
   Block: dashboard-redis-metrics
   Title: Dashboard Redis Metrics
   Description: Animated React Redis monitoring dashboard block for Next.js displaying cache hit and miss ratios, memory usage, eviction counts, connected clients, key expiry distribution, and command breakdown with animated progress bars using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Cache hit rate and key distribution
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-redis-metrics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideServerCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Redis Metrics</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">redis-primary · v7.2.4</p>
                </div>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-muted-foreground text-xs">14.2K ops/s</span>
            </div>
        </div>

        @* Key metrics grid *@
        <div class="grid grid-cols-2 border-b md:grid-cols-4">
            @for (var i = 0; i < _keyMetrics.Length; i++)
            {
                var metric = _keyMetrics[i];
                <div class="@(Cn.Merge("px-4 py-3", i < 2 ? "border-b md:border-b-0" : "", i % 2 == 0 ? "border-r" : "", i < 3 ? "md:border-r" : "md:border-r-0"))">
                    <p class="text-muted-foreground text-xs">@metric.Label</p>
                    <div class="mt-1 flex items-baseline gap-0.5">
                        <span class="@(Cn.Merge("font-semibold text-lg tabular-nums", metric.Color))">
                            @metric.Value
                        </span>
                        @if (!string.IsNullOrEmpty(metric.Sub))
                        {
                            <span class="text-muted-foreground text-xs">@metric.Sub</span>
                        }
                    </div>
                </div>
            }
        </div>

        @* Memory bar *@
        <div class="border-b px-4 py-3">
            <div class="mb-1.5 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Memory Usage</span>
                <span class="text-muted-foreground text-xs tabular-nums">
                    3.2 GB / 8 GB
                </span>
            </div>
            <div class="h-2 overflow-hidden rounded-full bg-muted/50">
                <div class="h-full rounded-full bg-foreground/80" style="width: 40%"></div>
            </div>
            <div class="mt-2 flex items-center gap-4">
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    Fragmentation: <span class="font-medium tabular-nums">1.12</span>
                </span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    Keys: <span class="font-medium tabular-nums">1.42M</span>
                </span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    Expiring: <span class="font-medium tabular-nums">892K</span>
                </span>
            </div>
        </div>

        @* Command breakdown *@
        <div class="px-4 py-3">
            <p class="mb-3 font-medium text-muted-foreground text-xs">Command Distribution</p>
            <div class="space-y-3">
                @foreach (var cmd in _commands)
                {
                    var barWidth = (double)cmd.Percent / _maxPercent * 100;
                    <div>
                        <div class="mb-1 flex items-center justify-between">
                            <span class="font-mono text-xs">@cmd.Name</span>
                            <div class="flex items-center gap-3">
                                <span class="font-medium text-xs tabular-nums">@cmd.Calls</span>
                                <span class="w-8 text-right text-muted-foreground text-xs tabular-nums">
                                    @(cmd.Percent)%
                                </span>
                            </div>
                        </div>
                        <div class="h-1.5 overflow-hidden rounded-full bg-muted/50">
                            <div class="h-full rounded-full bg-foreground/20" style="@(FormattableString.Invariant($"width: {barWidth:F1}%"))"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record KeyMetric(string Label, string Value, string Color, string? Sub = null);
    private record RedisCommand(string Name, string Calls, int Percent);

    private const int _maxPercent = 59;

    private static readonly KeyMetric[] _keyMetrics =
    [
        new("Hit Rate", "96.2%", "text-emerald-600 dark:text-emerald-400"),
        new("Miss Rate", "3.8%", "text-red-600 dark:text-red-400"),
        new("Evictions", "847", "", "2.1/min"),
        new("Clients", "128", "", "/256"),
    ];

    private static readonly RedisCommand[] _commands =
    [
        new("GET", "8.4K/s", 59),
        new("SET", "2.8K/s", 20),
        new("HGET", "1.4K/s", 10),
        new("DEL", "0.7K/s", 5),
        new("EXPIRE", "0.5K/s", 3),
        new("Other", "0.4K/s", 3),
    ];
}
