@* ============================================================
   Block: dashboard-employee-directory
   Title: Dashboard Employee Directory
   Description: Animated React employee directory dashboard block for Next.js with searchable grid layout, initials avatars, department chips, online status indicators, and location display using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: KPI metric cards with trend indicators
   Dependencies: InputCn
   Source: original/blocks/dashboard/dashboard-employee-directory.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Team Directory</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">@_employees.Length team members</p>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_employees.Count(e => e.Status == "online") online
                </span>
            </div>
        </div>

        <div class="flex items-center gap-2 border-b px-4 py-2">
            <LucideSearchCn Size="16" Class="size-4 text-muted-foreground" />
            <InputCn aria-label="Search by name, role, or location" Value="@_search"
                     ValueChanged="@((string v) => _search = v)"
                     Placeholder="Search by name, role, or location..."
                     Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
        </div>

        <div class="grid gap-0 sm:grid-cols-2">
            @{ var filtered = GetFiltered(); }
            @for (var i = 0; i < filtered.Length; i++)
            {
                var emp = filtered[i];
                var hasBorderB = i < filtered.Length - 2 || (filtered.Length % 2 != 0 && i < filtered.Length - 1);
                var hasBorderR = i % 2 == 0;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", hasBorderB ? "border-b" : "", hasBorderR ? "sm:border-r" : ""))">
                    <div class="relative shrink-0">
                        <div class="flex size-9 items-center justify-center rounded-full bg-muted text-muted-foreground text-xs font-medium">
                            @GetInitials(emp.Name)
                        </div>
                        <span class="@(Cn.Merge("absolute -right-0.5 bottom-0 size-2.5 rounded-full border-2 border-card", _statusDot[emp.Status]))"></span>
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="truncate font-medium text-sm">@emp.Name</span>
                        </div>
                        <p class="mt-0.5 truncate text-muted-foreground text-xs">@emp.Title</p>
                        <div class="mt-1 flex items-center gap-2">
                            <span class="inline-block rounded-md bg-muted/50 px-1.5 py-0.5 text-muted-foreground text-xs">
                                @emp.Department
                            </span>
                            <span class="text-muted-foreground text-xs">@emp.Location</span>
                        </div>
                    </div>
                </div>
            }
            @if (filtered.Length == 0)
            {
                <div class="col-span-2 px-4 py-8 text-center text-muted-foreground text-sm">
                    No team members match your search
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string _search = "";

    private record Employee(string Id, string Name, string Title, string Department, string Status, string Location);

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["online"] = "bg-emerald-500",
        ["away"] = "bg-amber-500",
        ["offline"] = "bg-zinc-400",
    };

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ');
        return string.Concat(parts.Select(p => p[0])).ToUpper();
    }

    private Employee[] GetFiltered()
    {
        if (string.IsNullOrWhiteSpace(_search)) return _employees;
        var q = _search.ToLowerInvariant();
        return _employees.Where(e =>
            e.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            e.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            e.Department.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            e.Location.Contains(q, StringComparison.OrdinalIgnoreCase)
        ).ToArray();
    }

    private static readonly Employee[] _employees =
    [
        new("1", "Sarah Chen", "Engineering Manager", "Engineering", "online", "San Francisco"),
        new("2", "Marcus Johnson", "Senior Designer", "Design", "online", "New York"),
        new("3", "Aiko Tanaka", "Product Manager", "Product", "away", "Tokyo"),
        new("4", "David Park", "Frontend Engineer", "Engineering", "online", "Seattle"),
        new("5", "Elena Rodriguez", "Data Analyst", "Analytics", "offline", "Madrid"),
        new("6", "James Wright", "DevOps Engineer", "Infrastructure", "online", "London"),
        new("7", "Priya Sharma", "UX Researcher", "Design", "away", "Bangalore"),
        new("8", "Oliver Kim", "Backend Engineer", "Engineering", "offline", "Toronto"),
    ];
}
