@* ============================================================
   Block: dashboard-feature-flags
   Title: Dashboard Feature Flags
   Description: Animated React feature flag management block for Next.js with eight flags showing monospace names, descriptions, per-environment status dots for dev staging and production, rollout percentage bars, owner initials, and staggered row animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Multi-environment deployment health
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-feature-flags.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Feature Flags</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_flags.Length flags across 3 environments
                </p>
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <span>@_flags.Count(f => f.Prod) in production</span>
            </div>
        </div>

        <div class="overflow-x-auto">
            <div class="min-w-[700px]">
                <div class="grid grid-cols-[1fr_100px_80px_48px] items-center border-b bg-muted/30 px-4 py-2">
                    <span class="font-medium text-muted-foreground text-xs">Flag</span>
                    <div class="flex items-center justify-center gap-4">
                        <span class="font-medium text-muted-foreground text-xs">Dev</span>
                        <span class="font-medium text-muted-foreground text-xs">Stg</span>
                        <span class="font-medium text-muted-foreground text-xs">Prod</span>
                    </div>
                    <span class="text-center font-medium text-muted-foreground text-xs">Rollout</span>
                    <span class="text-center font-medium text-muted-foreground text-xs">Owner</span>
                </div>

                <div>
                    @for (var i = 0; i < _flags.Length; i++)
                    {
                        var flag = _flags[i];
                        var isLast = i == _flags.Length - 1;
                        <div class="@(Cn.Merge("grid grid-cols-[1fr_100px_80px_48px] items-center px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b"))">
                            <div class="min-w-0 pr-3">
                                <span class="font-mono font-medium text-sm">@flag.Name</span>
                                <p class="mt-0.5 line-clamp-1 text-muted-foreground text-xs">
                                    @flag.Description
                                </p>
                            </div>

                            <div class="flex items-center justify-center gap-6">
                                <span class="@(Cn.Merge("size-2 rounded-full", flag.Dev ? "bg-emerald-500" : "bg-red-500/60"))"></span>
                                <span class="@(Cn.Merge("size-2 rounded-full", flag.Staging ? "bg-emerald-500" : "bg-red-500/60"))"></span>
                                <span class="@(Cn.Merge("size-2 rounded-full", flag.Prod ? "bg-emerald-500" : "bg-red-500/60"))"></span>
                            </div>

                            <div class="flex items-center gap-2 px-1">
                                <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                                    <div class="h-full rounded-full bg-foreground/20"
                                         style="@($"width: {flag.Rollout}%")">
                                    </div>
                                </div>
                                <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                                    @(flag.Rollout)%
                                </span>
                            </div>

                            <div class="flex justify-center">
                                <div class="flex size-7 items-center justify-center rounded-full bg-muted text-[10px] font-medium"
                                     title="@flag.Owner">
                                    @flag.Initials
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record FeatureFlag(string Id, string Name, string Description, bool Dev, bool Staging, bool Prod, int Rollout, string Owner, string Initials);

    private static readonly FeatureFlag[] _flags =
    [
        new("1", "new-checkout-flow", "Redesigned multi-step checkout with Apple Pay and Google Pay support", true, true, true, 100, "Sarah Chen", "SC"),
        new("2", "ai-search-v2", "Semantic search powered by embeddings with auto-complete suggestions", true, true, false, 45, "James Liu", "JL"),
        new("3", "dark-mode-auto", "Automatic dark mode based on system preference with manual override", true, true, true, 100, "Elena Rossi", "ER"),
        new("4", "team-collaboration", "Real-time document editing with presence indicators and comments", true, false, false, 0, "Marcus Webb", "MW"),
        new("5", "usage-analytics-v3", "Granular usage tracking with funnel analysis and cohort breakdowns", true, true, false, 20, "Priya Sharma", "PS"),
        new("6", "stripe-billing-v2", "Usage-based billing with prorated upgrades and invoice customization", true, true, true, 80, "Tom Bradley", "TB"),
        new("7", "webhooks-retry", "Automatic webhook retry with exponential backoff and dead letter queue", true, false, false, 0, "Nina Kowalski", "NK"),
        new("8", "export-csv-async", "Background CSV export for large datasets with email notification on completion", true, true, true, 65, "Daniel Park", "DP"),
    ];
}
