@* ============================================================
   Block: dashboard-content-performance
   Title: Dashboard Content Performance
   Description: Animated React content performance block for Next.js with eight articles showing view counts with horizontal bars, average read time, bounce rate, share count, SEO score, and staggered row animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Cohort retention with percentage grid
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-content-performance.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Content Performance</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Article engagement metrics sorted by total views
            </p>
        </div>

        <div class="overflow-x-auto">
            <div class="min-w-[700px]">
                <div class="grid grid-cols-[1fr_140px_70px_70px_60px_50px] items-center border-b bg-muted/30 px-4 py-2">
                    <span class="font-medium text-muted-foreground text-xs">Article</span>
                    <span class="font-medium text-muted-foreground text-xs">Views</span>
                    <span class="text-right font-medium text-muted-foreground text-xs">Read Time</span>
                    <span class="text-right font-medium text-muted-foreground text-xs">Bounce</span>
                    <span class="text-right font-medium text-muted-foreground text-xs">Shares</span>
                    <span class="text-right font-medium text-muted-foreground text-xs">SEO</span>
                </div>

                <div>
                    @for (var i = 0; i < _articles.Length; i++)
                    {
                        var article = _articles[i];
                        var barWidth = (double)article.Views / _maxViews * 100;
                        var isLast = i == _articles.Length - 1;
                        <div class="@(Cn.Merge("grid grid-cols-[1fr_140px_70px_70px_60px_50px] items-center px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b"))">
                            <span class="line-clamp-1 pr-3 font-medium text-sm">@article.Title</span>

                            <div class="flex items-center gap-2">
                                <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                                    <div class="h-full rounded-full bg-foreground/20"
                                         style="@($"width: {barWidth:F1}%")">
                                    </div>
                                </div>
                                <span class="shrink-0 text-muted-foreground text-xs tabular-nums">
                                    @FormatViews(article.Views)
                                </span>
                            </div>

                            <span class="text-right text-muted-foreground text-xs tabular-nums">
                                @article.ReadTime
                            </span>
                            <span class="text-right text-muted-foreground text-xs tabular-nums">
                                @article.BounceRate
                            </span>
                            <span class="text-right text-muted-foreground text-xs tabular-nums">
                                @article.Shares.ToString("N0")
                            </span>
                            <span class="@(Cn.Merge("text-right font-semibold text-xs tabular-nums", GetSeoColor(article.SeoScore)))">
                                @article.SeoScore
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Article(string Title, int Views, string ReadTime, string BounceRate, int Shares, int SeoScore);

    private static string GetSeoColor(int score)
    {
        if (score >= 85) return "text-emerald-600 dark:text-emerald-400";
        if (score >= 60) return "text-amber-600 dark:text-amber-400";
        return "text-red-600 dark:text-red-400";
    }

    private static string FormatViews(int views)
    {
        if (views >= 1000) return $"{views / 1000.0:F1}K";
        return views.ToString();
    }

    private static readonly int _maxViews = 48200;

    private static readonly Article[] _articles =
    [
        new("The Complete Guide to React Server Components in 2026", 48200, "8m 12s", "32%", 1240, 94),
        new("Building Type-Safe APIs with tRPC and Next.js", 35800, "6m 45s", "38%", 890, 88),
        new("Tailwind CSS v4: Everything You Need to Know", 29400, "5m 30s", "29%", 2100, 91),
        new("Database Migrations Without Downtime: A Practical Guide", 22100, "11m 20s", "41%", 560, 76),
        new("Optimizing Core Web Vitals for E-Commerce Sites", 18700, "7m 55s", "35%", 430, 82),
        new("Authentication Patterns for Multi-Tenant SaaS Applications", 15300, "9m 40s", "44%", 320, 71),
        new("From Monolith to Microservices: Lessons from Our Migration", 12800, "13m 05s", "48%", 280, 68),
        new("Edge Functions vs Serverless: When to Use Each", 9600, "6m 15s", "36%", 410, 85),
    ];
}
