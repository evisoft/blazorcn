@* ============================================================
   Block: dashboard-batch-processing
   Title: Dashboard Batch Processing
   Description: Animated React batch job processing dashboard block for Next.js with job status tracking, progress bars, ETA countdown, row counts, error handling, and expandable error details using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Database performance monitoring
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-batch-processing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Batch Processing</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_jobs.Length jobs · @_runningCount running
                </p>
            </div>
            <div class="flex items-center gap-3">
                @if (_totalErrors > 0)
                            {
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        @FormatNumber(_totalErrors) errors
                    </span>
                }
            </div>
        </div>

        @* Job rows *@
        <div>
            @for (var i = 0; i < _jobs.Length; i++)
                        {
                var job = _jobs[i];
                var index = i;
                var isExpanded = _expanded == job.Id;
                var config = _statusConfig[job.Status];

                <div class="@(index < _jobs.Length - 1 ? "border-b" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : job.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="relative flex shrink-0 items-center justify-center">
                            <span class="@(Cn.Merge("size-2 rounded-full", config.Dot))"></span>
                            @if (job.Status == "running")
                                        {
                                <span class="absolute size-2 rounded-full bg-blue-500"></span>
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@job.Name</span>
                            <div class="mt-1 flex items-center gap-2">
                                <div class="h-1.5 w-24 overflow-hidden rounded-full bg-muted">
                                    <div class="@(Cn.Merge("h-full rounded-full", job.Status == "failed" ? "bg-red-500" : job.Status == "paused" ? "bg-amber-500" : "bg-foreground/20"))"
                                         style="@($"width: {job.Progress}%")">
                                    </div>
                                </div>
                                <span class="text-muted-foreground text-xs tabular-nums">
                                    @job.Progress%
                                </span>
                            </div>
                        </div>
                        <div class="shrink-0 text-right">
                            <span class="block text-xs tabular-nums">
                                @FormatNumber(job.ProcessedRows) / @FormatNumber(job.TotalRows)
                            </span>
                            <span class="block text-muted-foreground text-xs">@job.Eta</span>
                        </div>
                        @if (job.FailedRows > 0)
                                    {
                            <span class="flex items-center gap-1 text-red-600 text-xs dark:text-red-400">
                                <LucideCircleAlertCn Size="12" Class="size-3" />
                                <span class="tabular-nums">@FormatNumber(job.FailedRows)</span>
                            </span>
                        }
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                                {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-4 pl-9">
                                @* Stats *@
                                <div class="mb-3 flex items-center gap-4 text-xs">
                                    <span class="text-muted-foreground">Started: @job.StartedAt</span>
                                    <span class="text-muted-foreground">·</span>
                                    <span class="flex items-center gap-1">
                                        @config.Label
                                    </span>
                                    @if (job.FailedRows > 0)
                                                {
                                        <span class="text-muted-foreground">·</span>
                                        <span class="text-red-600 dark:text-red-400">
                                            @job.FailedRows.ToString("N0") failed rows
                                        </span>
                                    }
                                </div>

                                @* Errors *@
                                @if (job.Errors.Length > 0)
                                            {
                                    <div class="space-y-2">
                                        @foreach (var error in job.Errors)
                                                    {
                                            <div class="rounded-md bg-muted/50 p-3">
                                                <div class="mb-1 flex items-center justify-between">
                                                    <span class="font-mono font-medium text-xs">
                                                        @error.Type
                                                    </span>
                                                    <span class="text-muted-foreground text-xs tabular-nums">
                                                        @error.Count rows
                                                    </span>
                                                </div>
                                                <p class="text-muted-foreground text-sm leading-relaxed">
                                                    @error.Message
                                                </p>
                                            </div>
                                        }
                                        @if (job.Status == "failed" || job.Status == "paused")
                                                    {
                                            <div class="flex gap-2">
                                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                                    Retry Failed
                                                </ButtonCn>
                                                @if (job.Status == "paused")
                                                            {
                                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                                        Resume
                                                    </ButtonCn>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="rounded-md bg-muted/50 p-3">
                                        <p class="text-muted-foreground text-sm">
                                            No errors. All processed rows completed successfully.
                                        </p>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "j1";

    private record BatchError(string Type, int Count, string Message);
    private record BatchJob(string Id, string Name, string Status, int TotalRows, int ProcessedRows, int FailedRows, int Progress, string Eta, string StartedAt, BatchError[] Errors);
    private record StatusConfig(string Dot, string Label);

    private static string FormatNumber(int n)
    {
        if (n >= 1000000) return $"{n / 1000000.0:F1}M";
        if (n >= 1000) return $"{n / 1000.0:F1}K";
        return n.ToString();
    }

    private int _runningCount => _jobs.Count(j => j.Status == "running");
    private int _totalErrors => _jobs.Sum(j => j.FailedRows);

    private readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["running"] = new("bg-blue-500", "Running"),
        ["completed"] = new("bg-emerald-500", "Completed"),
        ["failed"] = new("bg-red-500", "Failed"),
        ["paused"] = new("bg-amber-500", "Paused"),
        ["queued"] = new("bg-muted-foreground/40", "Queued")
    };

    private readonly BatchJob[] _jobs = new[]
    {
        new BatchJob("j1", "User Data Export", "running", 2450000, 1834200, 12, 74, "~18 min", "52 min ago", new[]
        {
            new BatchError("SerializationError", 8, "Failed to serialize user.preferences JSON for rows with null nested objects"),
            new BatchError("EncodingError", 4, "Invalid UTF-8 character in user.bio field at byte position 342")
        }),
        new BatchJob("j2", "Invoice Reconciliation", "running", 89400, 45600, 0, 51, "~7 min", "8 min ago", Array.Empty<BatchError>()),
        new BatchJob("j3", "Image Thumbnail Generation", "paused", 156000, 42300, 834, 27, "Paused", "2 hours ago", new[]
        {
            new BatchError("StorageError", 612, "S3 bucket write quota exceeded. Increase bucket write IOPS or wait for quota reset."),
            new BatchError("ImageFormatError", 222, "Unsupported image format HEIC detected. Only JPEG, PNG, and WebP are supported.")
        }),
        new BatchJob("j4", "Email Campaign Send", "completed", 34200, 34200, 47, 100, "Completed", "3 hours ago", new[]
        {
            new BatchError("BounceError", 47, "Hard bounce: mailbox does not exist for recipient addresses in rows 12400-12446")
        }),
        new BatchJob("j5", "Product Catalog Sync", "failed", 12800, 3200, 3200, 25, "Failed", "1 hour ago", new[]
        {
            new BatchError("ConnectionError", 3200, "Lost connection to upstream catalog API at row 3200. Connection refused: ECONNREFUSED 10.0.1.42:8443")
        }),
        new BatchJob("j6", "Analytics Aggregation", "queued", 5600000, 0, 0, 0, "Queued", "Waiting", Array.Empty<BatchError>())
    };
}
