@* ============================================================
   Block: dashboard-cost-optimization
   Title: Dashboard Cost Optimization
   Description: Animated React cost optimization dashboard block for Next.js with six cloud infrastructure recommendations showing potential savings in tabular-nums, category chips for compute storage network and database, impact and effort level indicators, apply action buttons, and total potential savings summary using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Database performance monitoring with query stats
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-cost-optimization.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Cost Optimization</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_recommendations.Length recommendations
                </p>
            </div>
            <div class="text-right">
                <span class="font-semibold text-2xl tabular-nums text-emerald-600 dark:text-emerald-400">
                    @FormatSavings(_totalSavings)
                </span>
                <p class="text-muted-foreground text-xs">potential monthly savings</p>
            </div>
        </div>

        @* Recommendations *@
        <div>
            @for (var i = 0; i < _recommendations.Length; i++)
            {
                var rec = _recommendations[i];
                var isLast = i == _recommendations.Length - 1;
                <div class="@(Cn.Merge("px-4 py-3", !isLast ? "border-b" : ""))">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@rec.Title</span>
                            <p class="mt-1 text-muted-foreground text-xs leading-relaxed">
                                @rec.Description
                            </p>
                            <div class="mt-2 flex flex-wrap items-center gap-2">
                                <span class="@(Cn.Merge("rounded-full px-2 py-0.5 text-xs", _categoryStyle[rec.Category]))">
                                    @rec.Category
                                </span>
                                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                    <span class="@(Cn.Merge("size-1.5 rounded-full", _impactDot[rec.Impact]))"></span>
                                    @rec.Impact impact
                                </span>
                                <span class="text-muted-foreground text-xs">·</span>
                                <span class="text-muted-foreground text-xs">@rec.Effort effort</span>
                            </div>
                        </div>
                        <div class="flex shrink-0 flex-col items-end gap-2">
                            <span class="font-semibold text-sm tabular-nums text-emerald-600 dark:text-emerald-400">
                                @FormatSavings(rec.Savings)/mo
                            </span>
                            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                                Apply
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Recommendation(string Id, string Title, string Description, int Savings, string Category, string Impact, string Effort);

    private static string FormatSavings(int value) => $"${value:N0}";

    private static readonly int _totalSavings = 13140;

    private static readonly Dictionary<string, string> _categoryStyle = new()
    {
        ["Compute"] = "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        ["Storage"] = "bg-purple-500/10 text-purple-700 dark:text-purple-400",
        ["Network"] = "bg-teal-500/10 text-teal-700 dark:text-teal-400",
        ["Database"] = "bg-orange-500/10 text-orange-700 dark:text-orange-400",
    };

    private static readonly Dictionary<string, string> _impactDot = new()
    {
        ["High"] = "bg-emerald-500",
        ["Medium"] = "bg-amber-500",
        ["Low"] = "bg-muted-foreground/40",
    };

    private static readonly Recommendation[] _recommendations =
    [
        new("r1", "Right-size underutilized EC2 instances", "14 instances running below 15% CPU utilization. Downgrade from m5.xlarge to m5.large.", 2840, "Compute", "High", "Low"),
        new("r2", "Delete unattached EBS volumes", "23 orphaned EBS volumes totaling 4.6 TB. No instance attachments for 60+ days.", 460, "Storage", "Low", "Low"),
        new("r3", "Enable S3 Intelligent-Tiering", "Move 12 TB of infrequently accessed data from S3 Standard to Intelligent-Tiering.", 1560, "Storage", "Medium", "Low"),
        new("r4", "Consolidate NAT Gateways", "3 redundant NAT Gateways across availability zones. Consolidate to shared architecture.", 980, "Network", "Medium", "Medium"),
        new("r5", "Switch to Aurora Serverless v2", "Two RDS instances with sporadic usage patterns. Aurora Serverless auto-scales to zero.", 3200, "Database", "High", "High"),
        new("r6", "Purchase Reserved Instance coverage", "8 on-demand instances running 24/7 for 12+ months. 1-year RI saves 40% on compute.", 4100, "Compute", "High", "Medium"),
    ];
}
