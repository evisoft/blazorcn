@* ============================================================
   Block: dashboard-search-analytics
   Title: Dashboard Search Analytics
   Description: Animated React search analytics dashboard block for Next.js with total search volume counter, no-results rate, average results per query, click-through rate metrics, top ten search terms list with volume bars and trend indicators using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Active session tracking with device breakdown
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-search-analytics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Search Analytics</span>
            <span class="text-muted-foreground text-xs">Last 7 days</span>
        </div>

        @* Metric cards *@
        <div class="grid grid-cols-2 border-b sm:grid-cols-4">
            @for (var i = 0; i < _metrics.Length; i++)
            {
                var metric = _metrics[i];
                <div class="@(Cn.Merge("px-4 py-3", i < 2 ? "border-b sm:border-b-0" : "", i % 2 == 0 || i < 3 ? "border-r" : "", i == 2 ? "border-r" : ""))">
                    <span class="text-muted-foreground text-xs">@metric.Label</span>
                    <p class="font-semibold text-2xl tabular-nums">@metric.Value</p>
                    <span class="text-muted-foreground text-[10px]">@metric.Subtext</span>
                </div>
            }
        </div>

        @* Top search terms *@
        <div>
            <div class="px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Top Search Terms</span>
            </div>
            @for (var i = 0; i < _searchTerms.Length; i++)
            {
                var item = _searchTerms[i];
                var barWidth = (int)Math.Round((double)item.Count / _maxCount * 100);
                var isLast = i == _searchTerms.Length - 1;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-2", isLast ? "" : "border-b"))">
                    <span class="w-5 shrink-0 text-right font-mono text-muted-foreground text-[10px]">
                        @(i + 1)
                    </span>
                    <span class="min-w-0 flex-1 truncate text-sm">@item.Term</span>
                    <div class="hidden w-24 items-center sm:flex">
                        <div class="h-1 rounded-full bg-foreground/15" style="@($"width: {barWidth}%")"></div>
                    </div>
                    <span class="shrink-0 font-medium text-xs tabular-nums">
                        @item.Count.ToString("N0")
                    </span>
                    <span class="@(Cn.Merge("flex shrink-0 items-center gap-0.5 text-[10px] tabular-nums", item.Trend == "up" ? "text-emerald-600 dark:text-emerald-400" : item.Trend == "down" ? "text-red-600 dark:text-red-400" : "text-muted-foreground"))">
                        @if (item.Trend == "up")
                        {
                            <LucideArrowUpRightCn Size="12" Class="size-3" />
                        }
                        @if (item.Trend == "down")
                        {
                            <LucideArrowDownRightCn Size="12" Class="size-3" />
                        }
                        @item.Change
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record SummaryMetric(string Label, string Value, string Subtext);
    private record SearchTerm(string Term, int Count, string Trend, string Change);

    private static readonly SummaryMetric[] _metrics =
    [
        new("Total Searches", "24.8K", "this week"),
        new("No-Results Rate", "8.2%", "of queries"),
        new("Avg Results", "12.4", "per query"),
        new("Click-Through", "34%", "CTR"),
    ];

    private static readonly SearchTerm[] _searchTerms =
    [
        new("dashboard template", 2840, "up", "+12%"),
        new("authentication", 2210, "up", "+8%"),
        new("pricing table", 1890, "down", "-3%"),
        new("data table sorting", 1650, "up", "+22%"),
        new("modal dialog", 1420, "flat", "0%"),
        new("file upload", 1180, "up", "+5%"),
        new("chart component", 980, "down", "-7%"),
        new("form validation", 860, "up", "+15%"),
        new("dark mode toggle", 740, "down", "-2%"),
        new("notification toast", 620, "up", "+9%"),
    ];
    private static readonly int _maxCount = _searchTerms[0].Count;

}
