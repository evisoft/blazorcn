@* ============================================================
   Block: dashboard-cost-breakdown
   Title: Dashboard Cost Breakdown
   Description: Animated React cloud cost breakdown dashboard block for Next.js showing total monthly spend with service-level cost distribution including compute storage database network and other categories with a horizontal stacked bar and month-over-month change indicators using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: API request volume and latency metrics
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-cost-breakdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Cost Breakdown</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Monthly cloud infrastructure spend</p>
        </div>

        @* Total *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-xs">Total Monthly Cost</p>
            <div class="mt-1 flex items-baseline gap-2">
                <span class="font-semibold text-2xl tabular-nums">@FormatCost(_totalCost)</span>
                <span class="text-muted-foreground text-xs">/mo</span>
                <span class="@(Cn.Merge("flex items-center gap-0.5 text-xs", _totalChange > 0 ? "text-red-600 dark:text-red-400" : "text-emerald-600 dark:text-emerald-400"))">
                    @if (_totalChange > 0)
                    {
                        <LucideTrendingUpCn Size="12" Class="size-3" />
                    }
                    else
                    {
                        <LucideTrendingDownCn Size="12" Class="size-3" />
                    }
                    @(_totalChange > 0 ? "+" : "")@(_totalChange)%
                </span>
            </div>
        </div>

        @* Stacked bar *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 font-medium text-muted-foreground text-xs">Distribution</p>
            <div class="flex h-3 w-full gap-0.5 overflow-hidden rounded-full">
                @foreach (var service in _services)
                {
                    <div class="@(Cn.Merge("h-full first:rounded-l-full last:rounded-r-full", service.Color))"
                         style="@($"width: {(double)service.Cost / _totalCost * 100:F1}%")">
                    </div>
                }
            </div>
        </div>

        @* Line items *@
        <div>
            @for (var i = 0; i < _services.Length; i++)
            {
                var service = _services[i];
                var isLast = i == _services.Length - 1;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b"))">
                    <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", service.Color))"></span>
                    <span class="flex-1 text-sm">@service.Name</span>
                    <span class="@(Cn.Merge("text-xs", service.Change > 0 ? "text-red-600 dark:text-red-400" : "text-emerald-600 dark:text-emerald-400"))">
                        @(service.Change > 0 ? "+" : "")@(service.Change)%
                    </span>
                    <span class="w-16 text-right font-medium text-sm tabular-nums">
                        @FormatCost(service.Cost)
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ServiceCost(string Name, int Cost, double Change, string Color);

    private const int _totalCost = 12400;
    private const double _totalChange = 4.2;

    private static string FormatCost(int value)
    {
        if (value >= 1000) return $"${value / 1000.0:F1}K";
        return $"${value}";
    }

    private static readonly ServiceCost[] _services =
    [
        new("Compute", 5200, 6.1, "bg-foreground/70"),
        new("Storage", 2800, -2.3, "bg-foreground/50"),
        new("Database", 2100, 8.5, "bg-foreground/35"),
        new("Network", 1400, 1.2, "bg-foreground/20"),
        new("Other", 900, -5.4, "bg-foreground/10"),
    ];
}
