@* ============================================================
   Block: dashboard-canary-deployments
   Title: Dashboard Canary Deployments
   Description: Animated React canary deployment dashboard block for Next.js with traffic split visualization, error rate comparison, latency metrics, rollout percentage slider, and promote or rollback actions using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: React Dashboard Campaign ROI Tracker Block
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-canary-deployments.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <div class="flex items-center gap-2">
                    <LucideGitBranchCn Size="12" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-sm">Canary Deployment</span>
                </div>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_deployment.Service · started @_deployment.StartedAt
                </p>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                    <LucideRotateCcwCn Size="12" Class="size-3" />
                    Rollback
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                    Promote
                    <LucideArrowRightCn Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

        @* Version comparison *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex-1">
                <span class="text-muted-foreground text-xs">Stable</span>
                <span class="ml-1.5 font-mono font-medium text-xs">@_deployment.StableVersion</span>
            </div>
            <LucideChevronRightCn Class="size-4 text-muted-foreground/40" />
            <div class="flex-1">
                <span class="text-muted-foreground text-xs">Canary</span>
                <span class="ml-1.5 font-mono font-medium text-xs text-blue-600 dark:text-blue-400">
                    @_deployment.CanaryVersion
                </span>
            </div>
            <span class="font-mono text-muted-foreground text-xs">@_deployment.CommitHash</span>
        </div>

        @* Rollout progress *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Rollout Phase</span>
                <span class="font-medium text-xs">@_deployment.CurrentPhase traffic</span>
            </div>
            <div class="flex items-center gap-1">
                @for (var i = 0; i < _phases.Length; i++)
                            {
                    var phaseIdx = i;
                    var phase = _phases[i];
                    <div class="flex-1">
                        <div class="@(Cn.Merge("h-2 rounded-sm origin-left", phaseIdx < _currentPhaseIndex ? "bg-emerald-500" : phaseIdx == _currentPhaseIndex ? "bg-blue-500" : "bg-muted"))"></div>
                        <span class="@(Cn.Merge("mt-1 block text-center text-[10px] tabular-nums", phaseIdx == _currentPhaseIndex ? "font-medium text-foreground" : "text-muted-foreground"))">
                            @phase
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Metrics comparison *@
        <div class="border-b bg-muted/30 px-4 py-2">
            <div class="grid grid-cols-[auto_1fr_80px_80px] items-center gap-3">
                <span class="w-4"></span>
                <span class="font-medium text-muted-foreground text-xs">Metric</span>
                <span class="text-center font-medium text-muted-foreground text-xs">Baseline</span>
                <span class="text-center font-medium text-muted-foreground text-xs">Canary</span>
            </div>
        </div>

        <div>
            @for (var i = 0; i < _deployment.Metrics.Length; i++)
                        {
                var metric = _deployment.Metrics[i];
                var metricIndex = i;
                <div class="@(Cn.Merge("grid grid-cols-[auto_1fr_80px_80px] items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", metricIndex < _deployment.Metrics.Length - 1 ? "border-b" : ""))">
                    <span class="@(Cn.Merge("size-1.5 rounded-full", _statusDot[metric.Status]))"></span>
                    <span class="font-medium text-sm">@metric.Label</span>
                    <span class="text-center font-mono text-muted-foreground text-xs tabular-nums">
                        @metric.Baseline
                    </span>
                    <span class="@(Cn.Merge("text-center font-mono text-xs tabular-nums", metric.Status == "warn" ? "font-medium text-amber-600 dark:text-amber-400" : metric.Status == "fail" ? "font-medium text-red-600 dark:text-red-400" : "text-foreground"))">
                        @metric.Canary
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record MetricComparison(string Label, string Baseline, string Canary, string Status);
    private record CanaryDeployment(string Service, string CanaryVersion, string StableVersion, string CurrentPhase, int PhaseProgress, string StartedAt, string CommitHash, MetricComparison[] Metrics);

    private readonly string[] _phases = new[] { "5%", "10%", "25%", "50%", "100%" };

    private readonly Dictionary<string, string> _statusDot = new()
    {
        ["pass"] = "bg-emerald-500",
        ["warn"] = "bg-amber-500",
        ["fail"] = "bg-red-500"
    };

    private int _currentPhaseIndex => Array.IndexOf(_phases, _deployment.CurrentPhase);

    private readonly CanaryDeployment _deployment = new(
        "api-gateway", "v2.14.0-rc.3", "v2.13.2", "25%", 60, "34 min ago", "e7f2a1c",
        new[]
        {
            new MetricComparison("Error Rate", "0.12%", "0.18%", "pass"),
            new MetricComparison("Latency p50", "42ms", "45ms", "pass"),
            new MetricComparison("Latency p99", "180ms", "245ms", "warn"),
            new MetricComparison("Success Rate", "99.88%", "99.82%", "pass"),
            new MetricComparison("Requests/sec", "1,847", "632", "pass"),
            new MetricComparison("CPU Usage", "34%", "41%", "warn")
        }
    );
}
