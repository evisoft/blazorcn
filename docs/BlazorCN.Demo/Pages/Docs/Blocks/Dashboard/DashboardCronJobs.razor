@* ============================================================
   Block: dashboard-cron-jobs
   Title: Dashboard Cron Jobs
   Description: Animated React scheduled job monitoring dashboard block for Next.js with six cron jobs displaying names, monospaced cron schedule expressions, last and next run timestamps, success failed and running status dots with pulse animation, execution durations, and ghost run now action buttons using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: ETL pipeline status and throughput metrics
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-cron-jobs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Cron Jobs</span>
                <p class="mt-0.5 text-muted-foreground text-xs">Scheduled task execution status</p>
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                @if (_runningCount > 0)
                            {
                    <span class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-blue-500"></span>
                        @_runningCount running
                    </span>
                }
                @if (_failedCount > 0)
                            {
                    <span class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        @_failedCount failed
                    </span>
                }
            </div>
        </div>

        @* Column headers *@
        <div class="flex items-center gap-3 border-b bg-muted/30 px-4 py-2 text-muted-foreground text-xs">
            <span class="min-w-0 flex-1">Job</span>
            <span class="hidden w-28 shrink-0 sm:block">Schedule</span>
            <span class="w-28 shrink-0 text-right">Last run</span>
            <span class="hidden w-28 shrink-0 text-right sm:block">Next run</span>
            <span class="w-20 shrink-0 text-center">Status</span>
            <span class="w-16 shrink-0 text-right">Duration</span>
            <span class="w-16 shrink-0"></span>
        </div>

        @* Jobs *@
        <div>
            @for (var i = 0; i < _jobs.Length; i++)
                        {
                var job = _jobs[i];
                var isLast = i == _jobs.Length - 1;

                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b"))">
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@job.Name</span>
                    </div>
                    <span class="hidden w-28 shrink-0 font-mono text-muted-foreground text-xs sm:block">
                        @job.Schedule
                    </span>
                    <span class="w-28 shrink-0 text-right text-muted-foreground text-xs">
                        @job.LastRun
                    </span>
                    <span class="hidden w-28 shrink-0 text-right text-muted-foreground text-xs sm:block">
                        @job.NextRun
                    </span>
                    <div class="flex w-20 shrink-0 items-center justify-center gap-1.5">
                        <span class="@(Cn.Merge("size-1.5 rounded-full", _statusDot[job.Status]))"></span>
                        <span class="text-muted-foreground text-xs">@(_statusLabel[job.Status])</span>
                    </div>
                    <span class="w-16 shrink-0 text-right font-mono text-muted-foreground text-xs tabular-nums">
                        @job.Duration
                    </span>
                    <div class="w-16 shrink-0 text-right">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                  Class="h-6 gap-1 px-2 text-xs"
                                  Disabled="@(job.Status == "running")">
                            <LucidePlayCn Size="12" Class="size-3" />
                            Run
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record CronJob(string Name, string Schedule, string LastRun, string NextRun, string Status, string Duration);

    private int _runningCount => _jobs.Count(j => j.Status == "running");
    private int _failedCount => _jobs.Count(j => j.Status == "failed");

    private readonly Dictionary<string, string> _statusDot = new()
    {
        ["success"] = "bg-emerald-500",
        ["failed"] = "bg-red-500",
        ["running"] = "bg-blue-500"
    };

    private readonly Dictionary<string, string> _statusLabel = new()
    {
        ["success"] = "Success",
        ["failed"] = "Failed",
        ["running"] = "Running"
    };

    private readonly CronJob[] _jobs = new[]
    {
        new CronJob("Database backup", "0 2 * * *", "Today, 02:00", "Tomorrow, 02:00", "success", "4m 12s"),
        new CronJob("Report generation", "0 8 * * 1", "Mon, 08:00", "Next Mon, 08:00", "success", "12m 34s"),
        new CronJob("Cache invalidation", "*/15 * * * *", "3 min ago", "In 12 min", "running", "0m 48s"),
        new CronJob("Email digest", "0 18 * * 1-5", "Yesterday, 18:00", "Today, 18:00", "success", "2m 06s"),
        new CronJob("Stale session cleanup", "0 */6 * * *", "Today, 12:00", "Today, 18:00", "failed", "1m 23s"),
        new CronJob("Search index rebuild", "30 3 * * 0", "Sun, 03:30", "Next Sun, 03:30", "success", "28m 41s")
    };
}
