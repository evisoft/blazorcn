@* ============================================================
   Block: dashboard-pr-review-time
   Title: Dashboard Pr Review Time
   Description: Animated React pull request review time metrics dashboard block for Next.js with time-to-review tracking, approval rates, reviewer workload distribution, expandable reviewer details with review history, and staggered entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Code quality metrics and lint scores
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-pr-review-time.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">PR Review Time</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Code review metrics &mdash; last 30 days
                </p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideGitPullRequestCn Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs tabular-nums">
                    @_totalPending pending reviews
                </span>
            </div>
        </div>

        @* Team KPIs *@
        <div class="flex items-center divide-x border-b">
            <div class="flex flex-1 flex-col items-center px-4 py-3">
                <span class="text-muted-foreground text-[10px]">Median Time</span>
                <span class="font-semibold text-lg tabular-nums">3h 12m</span>
            </div>
            <div class="flex flex-1 flex-col items-center px-4 py-3">
                <span class="text-muted-foreground text-[10px]">Approval Rate</span>
                <span class="font-semibold text-lg tabular-nums text-emerald-600 dark:text-emerald-400">
                    72%
                </span>
            </div>
            <div class="flex flex-1 flex-col items-center px-4 py-3">
                <span class="text-muted-foreground text-[10px]">Total Reviews</span>
                <span class="font-semibold text-lg tabular-nums">@_totalReviews</span>
            </div>
        </div>

        @* Reviewer rows *@
        <div>
            @for (var i = 0; i < _reviewers.Length; i++)
            {
                var reviewer = _reviewers[i];
                var isExpanded = _expanded == reviewer.Id;
                var isLast = i == _reviewers.Length - 1;
                var isSlow = reviewer.MedianMinutes > 360;

                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : reviewer.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">
                            @reviewer.Initials
                        </span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@reviewer.Name</span>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="text-muted-foreground text-[10px] tabular-nums">
                                    @reviewer.ReviewCount reviews
                                </span>
                                @if (reviewer.PendingReviews > 0)
                                {
                                    <span class="text-muted-foreground text-[10px]">&middot;</span>
                                    <span class="text-amber-600 dark:text-amber-400 text-[10px] tabular-nums">
                                        @reviewer.PendingReviews pending
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="shrink-0 text-right">
                            <div class="flex items-center gap-1.5">
                                <LucideClockCn Size="12" Class="@(Cn.Merge("size-3", isSlow ? "text-red-500" : "text-muted-foreground/50"))" />
                                <span class="@(Cn.Merge("font-mono text-xs tabular-nums", isSlow ? "text-red-600 dark:text-red-400" : ""))">
                                    @reviewer.MedianTime
                                </span>
                            </div>
                            <div class="mt-0.5 flex items-center justify-end gap-1">
                                <div class="h-1 w-10 overflow-hidden rounded-full bg-muted">
                                    <div class="h-full rounded-full bg-emerald-500"
                                         style="@($"width: {reviewer.ApprovalRate}%")"></div>
                                </div>
                                <span class="font-mono text-muted-foreground text-[10px] tabular-nums">
                                    @reviewer.ApprovalRate%
                                </span>
                            </div>
                        </div>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-3">
                                <span class="text-muted-foreground text-xs font-medium">
                                    Recent Reviews
                                </span>
                                <div class="mt-2 overflow-hidden rounded-md border">
                                    @for (var ri = 0; ri < reviewer.RecentReviews.Length; ri++)
                                    {
                                        var review = reviewer.RecentReviews[ri];
                                        var tConfig = _typeConfig[review.Type];
                                        var isLastReview = ri == reviewer.RecentReviews.Length - 1;
                                        <div class="@(Cn.Merge("flex items-center gap-3 px-3 py-2", !isLastReview ? "border-b" : ""))">
                                            <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", tConfig.Dot))"></span>
                                            <span class="shrink-0 font-mono text-muted-foreground text-[10px]">
                                                @review.Pr
                                            </span>
                                            <span class="min-w-0 flex-1 truncate text-xs">
                                                @review.Title
                                            </span>
                                            <span class="shrink-0 font-mono text-muted-foreground text-[10px] tabular-nums">
                                                @review.LinesChanged
                                            </span>
                                            <span class="shrink-0 font-mono text-muted-foreground text-[10px] tabular-nums">
                                                @review.Duration
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record ReviewEntry(string Pr, string Title, string Type, string Duration, string LinesChanged);
    private record ReviewerData(string Id, string Name, string Initials, int ReviewCount, string MedianTime, int MedianMinutes, int ApprovalRate, int PendingReviews, ReviewEntry[] RecentReviews);
    private record TypeConfig(string Label, string Dot);

    private int _totalPending => _reviewers.Sum(r => r.PendingReviews);
    private int _totalReviews => _reviewers.Sum(r => r.ReviewCount);

    private readonly Dictionary<string, TypeConfig> _typeConfig = new()
    {
        ["approved"] = new TypeConfig("Approved", "bg-emerald-500"),
        ["changes-requested"] = new TypeConfig("Changes Req.", "bg-amber-500"),
        ["commented"] = new TypeConfig("Commented", "bg-blue-500")
    };

    private readonly ReviewerData[] _reviewers = new[]
    {
        new ReviewerData("r1", "Sarah Chen", "SC", 47, "2h 14m", 134, 78, 2, new[]
        {
            new ReviewEntry("#1247", "Add OAuth2 PKCE flow", "approved", "1h 42m", "+284 / -31"),
            new ReviewEntry("#1245", "Fix race condition in WebSocket handler", "approved", "45m", "+18 / -12"),
            new ReviewEntry("#1241", "Migrate user service to new schema", "changes-requested", "3h 12m", "+892 / -445")
        }),
        new ReviewerData("r2", "Alex Rivera", "AR", 38, "4h 38m", 278, 65, 5, new[]
        {
            new ReviewEntry("#1246", "Implement batch email sender", "changes-requested", "6h 15m", "+412 / -89"),
            new ReviewEntry("#1243", "Add pagination to API list endpoints", "approved", "2h 30m", "+156 / -42"),
            new ReviewEntry("#1240", "Update rate limiter configuration", "commented", "1h 05m", "+24 / -8")
        }),
        new ReviewerData("r3", "Jordan Park", "JP", 52, "1h 28m", 88, 82, 1, new[]
        {
            new ReviewEntry("#1248", "Add dark mode toggle to settings", "approved", "38m", "+94 / -12"),
            new ReviewEntry("#1244", "Optimize image loading pipeline", "approved", "1h 15m", "+167 / -78"),
            new ReviewEntry("#1239", "Refactor notification service", "approved", "2h 04m", "+342 / -289")
        }),
        new ReviewerData("r4", "Morgan Lee", "ML", 29, "6h 52m", 412, 58, 7, new[]
        {
            new ReviewEntry("#1242", "Add Stripe Connect onboarding", "changes-requested", "8h 24m", "+1,204 / -312"),
            new ReviewEntry("#1238", "Fix CSV export encoding", "approved", "3h 45m", "+42 / -18"),
            new ReviewEntry("#1235", "Update deployment scripts", "commented", "12h 10m", "+86 / -54")
        }),
        new ReviewerData("r5", "Priya Sharma", "PS", 41, "3h 05m", 185, 71, 3, new[]
        {
            new ReviewEntry("#1249", "Add end-to-end encryption for messages", "changes-requested", "4h 30m", "+678 / -124"),
            new ReviewEntry("#1237", "Fix timezone display in reports", "approved", "52m", "+34 / -22"),
            new ReviewEntry("#1234", "Add team invitation flow", "approved", "2h 18m", "+245 / -67")
        })
    };
}
