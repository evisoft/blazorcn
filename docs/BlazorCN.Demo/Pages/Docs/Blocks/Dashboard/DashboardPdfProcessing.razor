@* ============================================================
   Block: dashboard-pdf-processing
   Title: Dashboard Pdf Processing
   Description: Animated React PDF document processing queue dashboard block for Next.js with OCR status tracking, extraction accuracy percentages, file size indicators, processing stage pipeline, expandable document details using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Message queue depth and throughput
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-pdf-processing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">PDF Processing</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">Document extraction queue</p>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_completeCount complete
                </span>
                @if (_processingCount > 0)
                {
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        @_processingCount processing
                    </span>
                }
            </div>
        </div>

        <div>
            @for (var i = 0; i < _documents.Length; i++)
            {
                var doc = _documents[i];
                var isExpanded = _expanded == doc.Id;
                var isLast = i == _documents.Length - 1;
                var config = _stageConfig[doc.Stage];
                var currentStageIdx = _stageIndex[doc.Stage];

                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : doc.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-2 rounded-full", config.Dot))"></span>
                        <LucideFileTextCn Size="16" Class="size-4 shrink-0 text-muted-foreground/50" />
                        <div class="min-w-0 flex-1">
                            <span class="block truncate font-mono text-xs">@doc.Filename</span>
                            <span class="mt-0.5 block text-muted-foreground text-[10px]">
                                @doc.FileSize · @doc.Pages @(doc.Pages == 1 ? "page" : "pages")
                            </span>
                        </div>
                        <div class="shrink-0 text-right">
                            <span class="@(Cn.Merge("block text-xs font-medium", config.Color))">
                                @config.Label
                            </span>
                            @if (doc.Accuracy.HasValue)
                            {
                                <span class="block font-mono text-muted-foreground text-[10px] tabular-nums">
                                    @doc.Accuracy% accuracy
                                </span>
                            }
                        </div>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-3 px-4 pb-3">
                                @* Stage pipeline *@
                                <div class="flex items-center gap-1">
                                    @for (var si = 0; si < _stages.Length; si++)
                                    {
                                        var isActive = si == currentStageIdx;
                                        var isPast = si < currentStageIdx;
                                        var isFailed = doc.Stage == "failed";
                                        <div class="flex flex-1 items-center gap-1">
                                            <div class="@(Cn.Merge("h-1.5 flex-1 rounded-full", isFailed ? "bg-red-500/20" : (isPast || isActive) ? "bg-foreground/20" : "bg-muted"))"></div>
                                            @if (si < _stages.Length - 1)
                                            {
                                                <div class="size-0.5"></div>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="flex items-center justify-between text-muted-foreground text-[10px]">
                                    <span>Duration: @doc.Duration</span>
                                    <span>Submitted @doc.SubmittedAt</span>
                                    @if (doc.FieldsExtracted > 0)
                                    {
                                        <span>@doc.FieldsExtracted fields extracted</span>
                                    }
                                </div>

                                @* Extracted fields *@
                                @if (doc.Fields.Length > 0)
                                {
                                    <div class="overflow-hidden rounded-md border">
                                        @for (var fi = 0; fi < doc.Fields.Length; fi++)
                                        {
                                            var field = doc.Fields[fi];
                                            <div class="@(Cn.Merge("flex items-center gap-3 px-3 py-2", fi < doc.Fields.Length - 1 ? "border-b" : ""))">
                                                <span class="shrink-0 text-muted-foreground text-xs">@field.Name</span>
                                                <span class="min-w-0 flex-1 truncate text-right font-mono text-xs">@field.Value</span>
                                                <span class="@(Cn.Merge("shrink-0 font-mono text-[10px] tabular-nums", field.Confidence >= 90 ? "text-emerald-600 dark:text-emerald-400" : field.Confidence >= 70 ? "text-amber-600 dark:text-amber-400" : "text-red-600 dark:text-red-400"))">
                                                    @field.Confidence%
                                                </span>
                                            </div>
                                        }
                                    </div>
                                }

                                @if (doc.Stage == "failed")
                                {
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                                        <LucideRotateCcwCn Size="12" Class="size-3" />
                                        Reprocess
                                    </ButtonCn>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record ExtractedField(string Name, string Value, double Confidence);
    private record DocumentData(string Id, string Filename, string FileSize, int Pages, string Stage, double? Accuracy, int FieldsExtracted, string Duration, string SubmittedAt, ExtractedField[] Fields);
    private record StageConfig(string Label, string Dot, string Color);

    private int _completeCount => _documents.Count(d => d.Stage == "complete");
    private int _processingCount => _documents.Count(d => d.Stage != "complete" && d.Stage != "failed");

    private readonly string[] _stages = { "upload", "ocr", "extraction", "validation", "complete" };

    private readonly Dictionary<string, int> _stageIndex = new()
    {
        ["upload"] = 0, ["ocr"] = 1, ["extraction"] = 2, ["validation"] = 3, ["complete"] = 4, ["failed"] = -1
    };

    private readonly Dictionary<string, StageConfig> _stageConfig = new()
    {
        ["upload"] = new StageConfig("Uploading", "bg-blue-500", "text-blue-600 dark:text-blue-400"),
        ["ocr"] = new StageConfig("OCR", "bg-amber-500", "text-amber-600 dark:text-amber-400"),
        ["extraction"] = new StageConfig("Extracting", "bg-amber-500", "text-amber-600 dark:text-amber-400"),
        ["validation"] = new StageConfig("Validating", "bg-blue-500", "text-blue-600 dark:text-blue-400"),
        ["complete"] = new StageConfig("Complete", "bg-emerald-500", "text-emerald-600 dark:text-emerald-400"),
        ["failed"] = new StageConfig("Failed", "bg-red-500", "text-red-600 dark:text-red-400")
    };

    private readonly DocumentData[] _documents = new[]
    {
        new DocumentData("doc1", "invoice-acme-2026-Q1.pdf", "2.4 MB", 3, "complete", 97.2, 18, "4.2s", "8 min ago", new[]
        {
            new ExtractedField("Invoice Number", "INV-2026-0847", 99.1),
            new ExtractedField("Vendor Name", "Acme Corp", 98.4),
            new ExtractedField("Total Amount", "$12,450.00", 97.8),
            new ExtractedField("Due Date", "Apr 15, 2026", 95.2)
        }),
        new DocumentData("doc2", "contract-renewal-globaltech.pdf", "8.1 MB", 12, "extraction", null, 0, "12.8s", "3 min ago", Array.Empty<ExtractedField>()),
        new DocumentData("doc3", "receipt-office-supplies-mar.pdf", "540 KB", 1, "complete", 99.4, 8, "1.8s", "22 min ago", new[]
        {
            new ExtractedField("Merchant", "Staples", 99.8),
            new ExtractedField("Total", "$284.50", 99.6),
            new ExtractedField("Date", "Mar 14, 2026", 99.1),
            new ExtractedField("Category", "Office Supplies", 98.2)
        }),
        new DocumentData("doc4", "tax-form-w9-vendor.pdf", "1.2 MB", 2, "failed", 34.1, 3, "6.4s", "45 min ago", new[]
        {
            new ExtractedField("Taxpayer Name", "Unclear", 42.0),
            new ExtractedField("EIN", "XX-XXXXXXX", 28.5),
            new ExtractedField("Address", "Partial match", 31.8)
        }),
        new DocumentData("doc5", "purchase-order-hardware.pdf", "3.7 MB", 5, "ocr", null, 0, "2.1s", "1 min ago", Array.Empty<ExtractedField>()),
        new DocumentData("doc6", "bank-statement-feb-2026.pdf", "1.8 MB", 4, "complete", 94.8, 42, "8.6s", "1 hr ago", new[]
        {
            new ExtractedField("Account Number", "****4821", 99.2),
            new ExtractedField("Statement Period", "Feb 1-28, 2026", 97.4),
            new ExtractedField("Ending Balance", "$48,291.33", 96.1),
            new ExtractedField("Transactions", "38 entries", 91.5)
        })
    };
}
