@* ============================================================
   Block: dashboard-top-products
   Title: Dashboard Top Products
   Description: Animated React dashboard top products block for Next.js with ranked product list, category chips, revenue figures, units sold, and animated horizontal performance bars using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Monthly revenue bar chart with animated bars
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-top-products.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <h2 class="font-medium text-sm">Top products</h2>
            <span class="rounded bg-muted px-1.5 py-0.5 text-muted-foreground text-xs">
                Last 30 days
            </span>
        </div>
        <div>
            @for (var i = 0; i < _products.Length; i++)
            {
                var product = _products[i];
                var barWidth = (int)Math.Round((double)product.Revenue / _maxRevenue * 100);
                var isLast = i == _products.Length - 1;
                <div class="@(Cn.Merge("px-4 py-3", isLast ? "" : "border-b"))">
                    <div class="flex items-center gap-3">
                        <span class="w-4 shrink-0 font-medium text-muted-foreground text-xs tabular-nums">
                            @product.Rank
                        </span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate font-medium text-sm">@product.Name</span>
                                <span class="shrink-0 rounded bg-muted px-1.5 py-0.5 text-muted-foreground text-xs">
                                    @product.Category
                                </span>
                            </div>
                            <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                                <div class="h-full rounded-full bg-foreground/80"
                                     style="@($"width: {barWidth}%")"></div>
                            </div>
                        </div>
                        <div class="shrink-0 text-right">
                            <p class="font-medium text-sm tabular-nums">
                                @FormatCurrency(product.Revenue)
                            </p>
                            <p class="text-muted-foreground text-xs tabular-nums">
                                @product.Units.ToString("N0") units
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Product(int Rank, string Name, string Category, int Revenue, int Units);

    private static string FormatCurrency(int value) =>
        value >= 1000 ? $"${(double)value / 1000:F1}K" : $"${value}";

    private static readonly Product[] _products =
    [
        new(1, "Wireless Pro Headphones", "Audio", 48200, 241),
        new(2, "UltraWide Monitor 34\"", "Displays", 42800, 107),
        new(3, "Mechanical Keyboard V2", "Input", 35600, 356),
        new(4, "Standing Desk Frame", "Furniture", 29400, 98),
        new(5, "USB-C Docking Station", "Accessories", 22100, 442),
        new(6, "Ergonomic Mouse", "Input", 18700, 374),
    ];
    private static readonly int _maxRevenue = _products[0].Revenue;

}
