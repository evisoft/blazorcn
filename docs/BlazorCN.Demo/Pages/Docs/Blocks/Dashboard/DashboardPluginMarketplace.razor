@* ============================================================
   Block: dashboard-plugin-marketplace
   Title: Dashboard Plugin Marketplace
   Description: Animated React plugin marketplace dashboard block for Next.js with extension listings showing install counts, star ratings, compatibility badges, version info, expandable plugin details with changelogs, and staggered entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Third-party integration health monitoring
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-plugin-marketplace.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Plugin Marketplace</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">Extensions and integrations</p>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-muted-foreground text-xs tabular-nums">
                    @_plugins.Count(p => p.Status == "installed") installed
                </span>
                @{
                    var updatesCount = _plugins.Count(p => p.Status == "update-available");
                }
                @if (updatesCount > 0)
                {
                    <span class="flex items-center gap-1.5 text-xs">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        <span class="text-amber-600 dark:text-amber-400 tabular-nums">
                            @updatesCount updates
                        </span>
                    </span>
                }
            </div>
        </div>

        <div>
            @for (var i = 0; i < _plugins.Length; i++)
            {
                var plugin = _plugins[i];
                var isExpanded = _expanded == plugin.Id;
                var isLast = i == _plugins.Length - 1;
                var compat = _compatConfig[plugin.Compatibility];
                var status = _statusConfig[plugin.Status];
                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : plugin.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted text-xs font-medium">
                            @plugin.ShortName
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@plugin.Name</span>
                                <span class="@(Cn.Merge("inline-flex shrink-0 items-center rounded px-1 py-0.5 text-[9px] font-medium", compat.Style))">
                                    @compat.Label
                                </span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="text-muted-foreground text-[10px]">@plugin.Author</span>
                                <span class="text-muted-foreground text-[10px]">·</span>
                                <span class="font-mono text-muted-foreground text-[10px]">
                                    v@(plugin.Version)
                                </span>
                                <span class="text-muted-foreground text-[10px]">·</span>
                                <span class="flex items-center gap-0.5 text-[10px]">
                                    <LucideStarCn Size="10" Class="size-2.5 fill-amber-400 text-amber-400" />
                                    <span class="tabular-nums">@plugin.Rating</span>
                                    <span class="text-muted-foreground">(@plugin.Reviews)</span>
                                </span>
                            </div>
                        </div>
                        <div class="flex shrink-0 items-center gap-2">
                            <span class="flex items-center gap-1 text-muted-foreground text-[10px]">
                                <LucideDownloadCn Size="10" Class="size-2.5" />
                                <span class="tabular-nums">@plugin.Installs</span>
                            </span>
                        </div>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="space-y-3 px-4 pb-4 pl-[3.75rem]">
                            <p class="text-muted-foreground text-sm leading-relaxed">
                                @plugin.Description
                            </p>
                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="text-muted-foreground text-[10px] font-medium">
                                    Changelog
                                </span>
                                <p class="mt-1 font-mono text-xs">@plugin.Changelog</p>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-muted-foreground text-[10px]">
                                    Size: @plugin.Size
                                </span>
                                <div class="flex items-center gap-2">
                                    @if (plugin.Status == "installed")
                                    {
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs text-red-600 dark:text-red-400 hover:text-red-700">
                                            Uninstall
                                        </ButtonCn>
                                    }
                                    @if (plugin.Compatibility != "incompatible")
                                    {
                                        <ButtonCn Variant="@(status.Variant)" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                            @status.Label
                                        </ButtonCn>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record PluginItem(string Id, string Name, string ShortName, string Author, string Version, string Installs, double Rating, int Reviews, string Compatibility, string Status, string Category, string Description, string Changelog, string Size);
    private record CompatConfig(string Label, string Style);
    private record StatusConfig(string Label, ButtonVariant Variant);

    private static readonly Dictionary<string, CompatConfig> _compatConfig = new()
    {
        ["compatible"] = new("Compatible", "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400"),
        ["untested"] = new("Untested", "bg-amber-500/10 text-amber-700 dark:text-amber-400"),
        ["incompatible"] = new("Incompatible", "bg-red-500/10 text-red-700 dark:text-red-400"),
    };

    private static readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["installed"] = new("Installed", ButtonVariant.Ghost),
        ["update-available"] = new("Update", ButtonVariant.Outline),
        ["not-installed"] = new("Install", ButtonVariant.Outline),
    };

    private static readonly PluginItem[] _plugins =
    [
