            "Advanced analytics with custom dashboards, funnel tracking, and cohort analysis. Includes 20+ pre-built report templates.",
            "v3.2.1 \u2014 Fixed timezone handling in hourly reports. Added CSV export for cohort tables.", "2.4 MB"),
        new("p2", "Auth Gateway", "AG", "SecureStack", "2.0.4", "31.5K", 4.6, 892, "compatible", "update-available", "Security",
            "Enterprise SSO with SAML 2.0, OIDC, and LDAP support. Includes MFA enforcement and session management.",
            "v2.0.4 \u2014 Added passkey support. Fixed SAML metadata refresh interval.", "1.8 MB"),
        new("p3", "Workflow Engine", "WE", "AutomateHQ", "4.1.0", "22.8K", 4.4, 567, "compatible", "not-installed", "Automation",
            "Visual workflow builder with conditional branching, parallel execution, and webhook triggers. Supports cron schedules.",
            "v4.1.0 \u2014 New visual workflow designer. Added parallel execution support for up to 10 concurrent branches.", "3.1 MB"),
        new("p4", "Email Templates", "ET", "MailCraft", "1.8.3", "56.1K", 4.9, 2104, "compatible", "installed", "Communication",
            "Drag-and-drop email template editor with 50+ responsive templates. MJML-based rendering for consistent inbox display.",
            "v1.8.3 \u2014 Added dark mode template variants. Fixed Outlook rendering for 3-column layouts.", "4.2 MB"),
        new("p5", "GraphQL Explorer", "GE", "APIForge", "2.3.0", "15.4K", 4.3, 341, "untested", "not-installed", "Developer",
            "In-app GraphQL IDE with schema introspection, query history, and variable management. Includes performance profiling.",
            "v2.3.0 \u2014 Added subscription support. Schema diff viewer for API versioning.", "1.5 MB"),
        new("p6", "PDF Generator", "PG", "DocStream", "3.0.2", "28.9K", 4.5, 728, "compatible", "update-available", "Documents",
            "Server-side PDF generation from HTML templates with table of contents, headers/footers, and digital signatures.",
            "v3.0.2 \u2014 Fixed page break handling in tables. Added watermark support.", "5.8 MB"),
        new("p7", "Realtime Sync", "RS", "LiveData Co", "1.2.0", "8.7K", 4.1, 189, "incompatible", "not-installed", "Infrastructure",
