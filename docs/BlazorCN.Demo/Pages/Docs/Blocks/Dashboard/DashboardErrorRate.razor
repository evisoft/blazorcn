@* ============================================================
   Block: dashboard-error-rate
   Title: Dashboard Error Rate
   Description: Animated React error rate monitoring dashboard block for Next.js with 24 hourly bar chart columns showing error counts, current error rate, total daily errors, most common error type, and affected endpoint using color-coded severity bars with shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Expandable helpdesk ticket list with priority dots
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-error-rate.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Error Rate</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Hourly error distribution over the past 24 hours
            </p>
        </div>

        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div>
                <p class="text-muted-foreground text-xs">Current Rate</p>
                <p class="font-semibold text-2xl tabular-nums">0.23%</p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">Errors Today</p>
                <p class="font-semibold text-sm tabular-nums">847</p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div class="min-w-0 flex-1">
                <p class="text-muted-foreground text-xs">Most Common</p>
                <p class="truncate font-mono text-xs">TimeoutError: Request exceeded 30s</p>
            </div>
        </div>

        <div class="px-4 py-4">
            <div class="flex h-32 items-end gap-px">
                @foreach (var count in _hourlyErrors)
                {
                    var heightPercent = (double)count / _maxCount * 100;
                    <div class="@(Cn.Merge("flex-1 rounded-t", GetBarColor(count)))"
                         style="@(FormattableString.Invariant($"height: {heightPercent:F1}%"))"
                         title="@($"{count} errors")">
                    </div>
                }
            </div>
            <div class="mt-2 flex justify-between">
                <span class="text-muted-foreground text-xs">24h ago</span>
                <span class="text-muted-foreground text-xs">12h ago</span>
                <span class="text-muted-foreground text-xs">Now</span>
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs">Top affected endpoint:</span>
                <span class="font-mono text-xs">/api/v3/analytics/query</span>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly int[] _hourlyErrors =
    [
        12, 8, 5, 3, 7, 15, 22, 45, 67, 82, 54, 38, 29, 35, 41, 28, 19, 24, 31, 18, 14, 9, 11, 6,
    ];

    private static readonly int _maxCount = _hourlyErrors.Max();

    private static string GetBarColor(int count)
    {
        if (count >= 60) return "bg-red-500";
        if (count >= 30) return "bg-amber-500";
        return "bg-foreground/20";
    }
}
