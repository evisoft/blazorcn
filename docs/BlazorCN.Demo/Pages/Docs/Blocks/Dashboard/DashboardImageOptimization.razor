@* ============================================================
   Block: dashboard-image-optimization
   Title: Dashboard Image Optimization
   Description: Animated React image optimization dashboard block for Next.js with format conversion statistics, bandwidth savings calculations, cache hit ratios, CDN performance metrics, and per-format breakdowns using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Storage capacity and file type breakdown
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-image-optimization.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideImageCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Image Optimization</span>
            </div>
            <span class="text-muted-foreground text-xs">Last 30 days</span>
        </div>

        @* Stats row *@
        <div class="flex items-center gap-6 border-b px-4 py-3">
            <div>
                <span class="text-muted-foreground text-xs">Images served</span>
                <p class="font-semibold text-2xl tabular-nums">2.8M</p>
            </div>
            <div>
                <span class="text-muted-foreground text-xs">Bandwidth saved</span>
                <p class="font-semibold text-2xl tabular-nums text-emerald-600 dark:text-emerald-400">18.4 TB</p>
            </div>
            <div>
                <span class="text-muted-foreground text-xs">Cache hit ratio</span>
                <p class="font-semibold text-2xl tabular-nums">94.2%</p>
            </div>
            <div>
                <span class="text-muted-foreground text-xs">Avg transform</span>
                <p class="font-semibold text-2xl tabular-nums">12ms</p>
            </div>
        </div>

        @* Column headers *@
        <div class="flex items-center gap-3 border-b bg-muted/30 px-4 py-2 text-muted-foreground text-xs">
            <span class="w-24">Conversion</span>
            <span class="min-w-0 flex-1">Savings</span>
            <span class="w-20 text-right">Count</span>
            <span class="hidden w-16 text-right sm:block">Original</span>
            <span class="hidden w-16 text-right sm:block">Optimized</span>
        </div>

        @* Conversions *@
        <div>
            @for (var i = 0; i < _conversions.Length; i++)
            {
                var conv = _conversions[i];
                var isLast = i == _conversions.Length - 1;
                var barWidth = (double)conv.SavingsPercent / _maxSavings * 100;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b"))">
                    <div class="w-24 shrink-0">
                        <span class="font-mono text-xs">
                            @conv.From
                            <span class="text-muted-foreground"> \u2192 </span>
                            @conv.To
                        </span>
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <div class="relative h-2 flex-1 overflow-hidden rounded-full bg-muted/50">
                                <div class="h-full rounded-full bg-emerald-500"
                                     style="@(FormattableString.Invariant($"width: {barWidth:F1}%"))">
                                </div>
                            </div>
                            <span class="w-10 shrink-0 text-right font-semibold text-emerald-600 text-xs tabular-nums dark:text-emerald-400">
                                @(conv.SavingsPercent)%
                            </span>
                        </div>
                    </div>
                    <span class="w-20 shrink-0 text-right font-mono text-muted-foreground text-xs tabular-nums">
                        @conv.Count.ToString("N0")
                    </span>
                    <span class="hidden w-16 shrink-0 text-right text-muted-foreground text-xs sm:block">
                        @conv.OriginalSize
                    </span>
                    <span class="hidden w-16 shrink-0 text-right text-muted-foreground text-xs sm:block">
                        @conv.OptimizedSize
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private const int _maxSavings = 63;

    private record FormatConversion(string Id, string From, string To, int Count, string OriginalSize, string OptimizedSize, int SavingsPercent);

    private static readonly FormatConversion[] _conversions =
    [
        new("f1", "PNG", "WebP", 892340, "4.2 TB", "2.7 TB", 36),
        new("f2", "JPEG", "WebP", 1124800, "6.8 TB", "5.1 TB", 25),
        new("f3", "PNG", "AVIF", 418200, "2.1 TB", "0.9 TB", 57),
        new("f4", "JPEG", "AVIF", 328400, "1.9 TB", "0.8 TB", 58),
        new("f5", "GIF", "WebP", 83380, "840 GB", "310 GB", 63),
    ];
}
