@* ============================================================
   Block: dashboard-quota-usage
   Title: Dashboard Quota Usage
   Description: Animated React quota and limits dashboard block for Next.js with six resource quotas showing API calls, storage, team members, projects, domains, and webhooks with animated progress bars, percentage indicators, and warning states at eighty percent threshold using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: KPI metrics with trend indicators
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-quota-usage.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Usage & Limits</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">Current plan quota utilization</p>
            </div>
            <div class="flex items-center gap-2">
                @if (_warningCount > 0)
                {
                    <span class="flex items-center gap-1 text-amber-600 text-xs dark:text-amber-400">
                        <LucideTriangleAlertCn Size="12" Class="size-3" />
                        @_warningCount near limit
                    </span>
                }
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Upgrade
                </ButtonCn>
            </div>
        </div>

        @* Quota rows *@
        <div>
            @for (var i = 0; i < _quotas.Length; i++)
            {
                var quota = _quotas[i];
                var percentage = (int)Math.Round(quota.Used / quota.Limit * 100);
                var isLast = i == _quotas.Length - 1;
                var isWarning = percentage >= 80;
                <div class="@(Cn.Merge("px-4 py-3", !isLast ? "border-b" : ""))">
                    <div class="mb-2 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@quota.Label</span>
                            @if (isWarning)
                            {
                                <span class="size-1.5 rounded-full bg-amber-500"></span>
                            }
                        </div>
                        <span class="text-muted-foreground text-xs tabular-nums">
                            @FormatValue(quota.Used) / @FormatValue(quota.Limit) @quota.Unit
                        </span>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="relative h-2 flex-1 overflow-hidden rounded-full bg-muted/50">
                            <div class="@(Cn.Merge("absolute inset-y-0 left-0 rounded-full", GetBarColor(percentage)))"
                                 style="@($"width: {Math.Min(percentage, 100)}%")"></div>
                        </div>
                        <span class="@(Cn.Merge("w-8 text-right text-xs tabular-nums", isWarning ? (percentage >= 95 ? "text-red-600 dark:text-red-400" : "text-amber-600 dark:text-amber-400") : "text-muted-foreground"))">
                            @(percentage)%
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record QuotaItem(string Label, double Used, double Limit, string Unit);

    private static string GetBarColor(int percentage) =>
        percentage >= 95 ? "bg-red-500"
        : percentage >= 80 ? "bg-amber-500"
        : "bg-emerald-500";

    private static string FormatValue(double value)
    {
        if (value >= 1000) return $"{value / 1000:F0}K";
        return value % 1 == 0 ? $"{value:F0}" : $"{value:F1}";
    }

    private static readonly QuotaItem[] _quotas =
    [
        new("API Calls", 284000, 500000, "requests"),
        new("Storage", 12.4, 20, "GB"),
        new("Team Members", 8, 10, "seats"),
        new("Projects", 14, 25, "projects"),
        new("Domains", 3, 5, "domains"),
        new("Webhooks", 12, 20, "endpoints"),
    ];
    private static readonly int _warningCount = _quotas.Count(q => q.Used / q.Limit * 100 >= 80);

}
