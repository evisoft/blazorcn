@* ============================================================
   Block: dashboard-conversion-funnel
   Title: Dashboard Conversion Funnel
   Description: Animated React conversion funnel dashboard block for Next.js with five narrowing funnel steps from visitors to retained users showing drop-off rates between stages and animated width transitions using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: CRM funnel with deal counts and pipeline value
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-conversion-funnel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Conversion Funnel</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    User journey from visit to retention
                </p>
            </div>
            <div class="flex items-center gap-3">
                <div class="text-right">
                    <p class="text-muted-foreground text-xs">Overall Rate</p>
                    <p class="font-semibold text-sm tabular-nums">1.8%</p>
                </div>
            </div>
        </div>

        <div class="px-4 py-4">
            <div class="space-y-2">
                @for (var i = 0; i < _steps.Length; i++)
                            {
                    var step = _steps[i];
                    var index = i;
                    var widthPercent = Math.Max((double)step.Count / _maxCount * 100, 8);
                    var nextStep = index + 1 < _steps.Length ? _steps[index + 1] : null;
                    var dropOff = nextStep != null
                        ? $"{Math.Round((1 - (double)nextStep.Count / step.Count) * 100)}%"
                        : (string?)null;

                    <div>
                        <div class="mb-1 flex items-center justify-between">
                            <span class="font-medium text-sm">@step.Label</span>
                            <div class="flex items-center gap-2">
                                <span class="font-semibold text-sm tabular-nums">@step.Formatted</span>
                                <span class="text-muted-foreground text-xs tabular-nums">
                                    @($"{(double)step.Count / _maxCount * 100:F1}%")
                                </span>
                            </div>
                        </div>
                        <div class="flex justify-center">
                            <div class="h-8 rounded bg-foreground/10"
                                 style="@(FormattableString.Invariant($"width: {widthPercent:F1}%"))">
                            </div>
                        </div>

                        @if (dropOff != null)
                                    {
                            <div class="mt-1.5 mb-1 flex items-center justify-center gap-1">
                                <LucideArrowDownCn Size="12" Class="size-3 text-muted-foreground/60" />
                                <span class="text-muted-foreground text-xs">@dropOff drop-off</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record FunnelStep(string Label, int Count, string Formatted);

    private readonly int _maxCount = 100000;

    private readonly FunnelStep[] _steps = new[]
    {
        new FunnelStep("Visitors", 100000, "100K"),
        new FunnelStep("Sign-ups", 12000, "12K"),
        new FunnelStep("Activated", 8400, "8.4K"),
        new FunnelStep("Subscribed", 2100, "2.1K"),
        new FunnelStep("Retained", 1800, "1.8K")
    };
}
