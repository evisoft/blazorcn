@* ============================================================
   Block: dashboard-product-roadmap
   Title: Dashboard Product Roadmap
   Description: Animated React product roadmap dashboard block for Next.js displaying a timeline of development phases with milestones, completion percentage, status indicators, and expandable phase details showing deliverables using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Project milestone tracking dashboard
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-product-roadmap.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Product Roadmap</span>
                <p class="mt-0.5 text-muted-foreground text-xs">2026 development timeline</p>
            </div>
            <div class="flex items-center gap-2">
                <span class="font-semibold text-sm tabular-nums text-blue-600 dark:text-blue-400">
                    40%
                </span>
                <span class="text-muted-foreground text-xs">overall</span>
            </div>
        </div>

        @* Overall progress bar *@
        <div class="border-b px-4 py-3">
            <div class="h-1.5 overflow-hidden rounded-full bg-muted/50">
                <div class="h-full rounded-full bg-blue-500" style="width: 40%"></div>
            </div>
        </div>

        @* Phase timeline *@
        <div>
            @for (var i = 0; i < _phases.Length; i++)
            {
                var phase = _phases[i];
                var isExpanded = _expanded == phase.Id;
                var config = _statusConfig[phase.Status];
                var isLast = i == _phases.Length - 1;

                <div class="@(!isLast || isExpanded ? "border-b" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : phase.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        @* Timeline dot *@
                        <div class="relative flex flex-col items-center">
                            <span class="@(Cn.Merge("size-2.5 shrink-0 rounded-full", config.Dot))"></span>
                        </div>

                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@phase.Name</span>
                                <span class="rounded bg-muted px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">
                                    @phase.Quarter
                                </span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @phase.MilestonesComplete/@phase.Milestones milestones &middot; @config.Label
                            </p>
                        </div>

                        @if (phase.Status != "planned")
                        {
                            <span class="@(Cn.Merge("font-semibold text-sm tabular-nums", config.Text))">
                                @phase.Completion%
                            </span>
                        }

                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-1 px-4 pb-4 pl-9">
                                @foreach (var item in phase.Deliverables)
                                {
                                    <div class="flex items-center gap-2.5 rounded-md px-2 py-1.5">
                                        @if (item.Done)
                                        {
                                            <LucideCircleCheckCn Size="14" Class="size-3.5 shrink-0 text-emerald-500" />
                                        }
                                        else if (phase.Status == "in-progress")
                                        {
                                            <LucideCircleDotCn Size="14" Class="size-3.5 shrink-0 text-blue-500" />
                                        }
                                        else
                                        {
                                            <LucideCircleCn Size="14" Class="size-3.5 shrink-0 text-muted-foreground/40" />
                                        }
                                        <span class="@(Cn.Merge("flex-1 text-sm", item.Done ? "text-muted-foreground line-through" : ""))">
                                            @item.Title
                                        </span>
                                        <span class="shrink-0 text-muted-foreground text-xs">
                                            @item.DueDate
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "p2";

    private record Deliverable(string Id, string Title, string DueDate, bool Done);
    private record PhaseData(string Id, string Name, string Status, string Quarter, int Completion, int Milestones, int MilestonesComplete, Deliverable[] Deliverables);
    private record StatusConfig(string Dot, string Text, string Label);

    private readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["completed"] = new StatusConfig("bg-emerald-500", "text-emerald-600 dark:text-emerald-400", "Completed"),
        ["in-progress"] = new StatusConfig("bg-blue-500", "text-blue-600 dark:text-blue-400", "In Progress"),
        ["planned"] = new StatusConfig("bg-muted-foreground/30", "text-muted-foreground", "Planned")
    };

    private readonly PhaseData[] _phases = new[]
    {
        new PhaseData("p1", "Foundation", "completed", "Q1 2026", 100, 4, 4, new[]
        {
            new Deliverable("d1", "Design system v2", "Jan 15", true),
            new Deliverable("d2", "Database migration to PlanetScale", "Jan 30", true),
            new Deliverable("d3", "Auth provider migration", "Feb 14", true),
            new Deliverable("d4", "CI/CD pipeline overhaul", "Mar 1", true)
        }),
        new PhaseData("p2", "Core Features", "in-progress", "Q2 2026", 62, 5, 3, new[]
        {
            new Deliverable("d5", "Real-time collaboration engine", "Apr 10", true),
            new Deliverable("d6", "Advanced permissions system", "Apr 28", true),
            new Deliverable("d7", "Webhook integrations framework", "May 15", true),
            new Deliverable("d8", "Custom workflow builder", "Jun 1", false),
            new Deliverable("d9", "API rate limiting and quotas", "Jun 20", false)
        }),
        new PhaseData("p3", "Growth & Scale", "planned", "Q3 2026", 0, 4, 0, new[]
        {
            new Deliverable("d10", "Multi-region deployment", "Jul 15", false),
            new Deliverable("d11", "Enterprise SSO (SAML/OIDC)", "Aug 1", false),
            new Deliverable("d12", "Audit log and compliance", "Aug 20", false),
            new Deliverable("d13", "White-label partner program", "Sep 10", false)
        }),
        new PhaseData("p4", "AI & Automation", "planned", "Q4 2026", 0, 3, 0, new[]
        {
            new Deliverable("d14", "AI-powered search and suggestions", "Oct 15", false),
            new Deliverable("d15", "Automated anomaly detection", "Nov 10", false),
            new Deliverable("d16", "Natural language query interface", "Dec 1", false)
        })
    };
}
