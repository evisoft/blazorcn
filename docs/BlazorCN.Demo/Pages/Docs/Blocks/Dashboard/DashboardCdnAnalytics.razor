@* ============================================================
   Block: dashboard-cdn-analytics
   Title: Dashboard Cdn Analytics
   Description: Animated React CDN analytics dashboard block for Next.js with edge node performance metrics, cache hit ratios, bandwidth per region, origin shield statistics, and expandable node details using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Bandwidth monitoring with IP tracking
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-cdn-analytics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideGlobeCn Size="12" Class="size-3.5 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">CDN Analytics</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @_nodes.Length edge regions · last 24h
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="@(Cn.Merge("size-1.5 rounded-full", _avgCacheHit >= 95 ? "bg-emerald-500" : "bg-amber-500"))"></span>
                <span class="text-muted-foreground text-xs">
                    @(_avgCacheHit.ToString("F1"))% avg cache hit
                </span>
            </div>
        </div>

        @* Summary stats *@
        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <span class="text-muted-foreground text-xs">Bandwidth</span>
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-2xl tabular-nums">
                        @((_totalBandwidth / 1000.0).ToString("F1"))
                    </span>
                    <span class="text-muted-foreground text-xs">TB</span>
                </div>
            </div>
            <div class="border-r px-4 py-3">
                <span class="text-muted-foreground text-xs">Requests</span>
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-2xl tabular-nums">
                        @((_totalRequests / 1000.0).ToString("F1"))
                    </span>
                    <span class="text-muted-foreground text-xs">M</span>
                </div>
            </div>
            <div class="px-4 py-3">
                <div class="flex items-center gap-1">
                    <LucideShieldCn Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-muted-foreground text-xs">Shield Hit</span>
                </div>
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-2xl tabular-nums">
                        @(_avgShieldHit.ToString("F1"))
                    </span>
                    <span class="text-muted-foreground text-xs">%</span>
                </div>
            </div>
        </div>

        @* Node rows *@
        <div>
            @for (var i = 0; i < _nodes.Length; i++)
                        {
                var node = _nodes[i];
                var index = i;
                var isExpanded = _expanded == node.Id;

                <div class="@(index < _nodes.Length - 1 ? "border-b" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : node.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", _healthDot[node.Health]))"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@node.Region</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@node.Location</p>
                        </div>
                        <div class="flex items-center gap-4">
                            <div class="text-right">
                                <span class="block font-medium text-xs tabular-nums">
                                    @node.CacheHitRatio%
                                </span>
                                <span class="block text-[10px] text-muted-foreground">cache hit</span>
                            </div>
                            <div class="text-right">
                                <span class="block font-mono text-muted-foreground text-xs tabular-nums">
                                    @(node.LatencyMs)ms
                                </span>
                                <span class="block text-[10px] text-muted-foreground">latency</span>
                            </div>
                        </div>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                                {
                        <div class="overflow-hidden">
                            <div class="grid grid-cols-2 gap-3 px-4 pb-4 pl-9 sm:grid-cols-4">
                                <div class="rounded-md bg-muted/50 p-2.5">
                                    <span class="text-muted-foreground text-xs">Bandwidth</span>
                                    <span class="block font-medium text-sm tabular-nums">
                                        @node.BandwidthGB GB
                                    </span>
                                </div>
                                <div class="rounded-md bg-muted/50 p-2.5">
                                    <span class="text-muted-foreground text-xs">Requests</span>
                                    <span class="block font-medium text-sm tabular-nums">
                                        @((node.RequestsK / 1000.0).ToString("F1"))M
                                    </span>
                                </div>
                                <div class="rounded-md bg-muted/50 p-2.5">
                                    <div class="flex items-center gap-1">
                                        <LucideServerCn Size="12" Class="size-3 text-muted-foreground" />
                                        <span class="text-muted-foreground text-xs">Origin</span>
                                    </div>
                                    <span class="block font-medium text-sm tabular-nums">
                                        @(node.OriginRequestsK)K
                                    </span>
                                </div>
                                <div class="rounded-md bg-muted/50 p-2.5">
                                    <div class="flex items-center gap-1">
                                        <LucideShieldCn Size="12" Class="size-3 text-muted-foreground" />
                                        <span class="text-muted-foreground text-xs">Shield</span>
                                    </div>
                                    <span class="block font-medium text-sm tabular-nums">
                                        @node.ShieldHitRatio%
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record CdnNode(string Id, string Region, string Location, double CacheHitRatio, int BandwidthGB, int RequestsK, int LatencyMs, string Health, double ShieldHitRatio, int OriginRequestsK);

    private readonly Dictionary<string, string> _healthDot = new()
    {
        ["healthy"] = "bg-emerald-500",
        ["degraded"] = "bg-amber-500",
        ["offline"] = "bg-red-500"
    };

    private double _totalBandwidth => _nodes.Sum(n => n.BandwidthGB);
    private double _totalRequests => _nodes.Sum(n => n.RequestsK);
    private double _avgCacheHit => _nodes.Average(n => n.CacheHitRatio);
    private double _avgShieldHit => _nodes.Average(n => n.ShieldHitRatio);

    private readonly CdnNode[] _nodes = new[]
    {
        new CdnNode("n1", "US East", "Ashburn, VA", 97.2, 2840, 14200, 8, "healthy", 94.1, 412),
        new CdnNode("n2", "EU West", "Frankfurt, DE", 95.8, 1920, 9600, 12, "healthy", 91.3, 384),
        new CdnNode("n3", "Asia Pacific", "Tokyo, JP", 93.4, 1540, 7700, 18, "healthy", 89.7, 506),
        new CdnNode("n4", "US West", "San Jose, CA", 96.1, 1680, 8400, 6, "healthy", 92.8, 348),
        new CdnNode("n5", "South America", "Sao Paulo, BR", 88.9, 620, 3100, 34, "degraded", 82.4, 344),
        new CdnNode("n6", "Australia", "Sydney, AU", 91.5, 440, 2200, 24, "healthy", 87.2, 188)
    };
}
