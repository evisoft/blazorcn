@* ============================================================
   Block: dashboard-activity-feed
   Title: Dashboard Activity Feed
   Description: Animated React dashboard activity feed block for Next.js with timeline layout, user actions, resource targets, and staggered entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Four KPI metric cards with trend indicators
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-activity-feed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Activity</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Recent actions across your workspace
            </p>
        </div>
        <div class="relative">
            <div class="absolute top-0 bottom-0 left-[2.05rem] w-px bg-border"></div>
            @for (var i = 0; i < _activities.Length; i++)
            {
                var activity = _activities[i];
                var isLast = i == _activities.Length - 1;
                <div class="@(Cn.Merge("relative flex items-start gap-3 px-4 py-3", isLast ? "" : "border-b"))">
                    <div class="relative z-10 flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @activity.Initials
                    </div>
                    <div class="min-w-0 flex-1 pt-1">
                        <p class="text-sm">
                            <span class="font-medium">@activity.User</span>
                            <span class="text-muted-foreground"> @(_actionLabels[activity.Action]) </span>
                            <span class="font-medium">@activity.Resource</span>
                        </p>
                        <p class="mt-0.5 truncate text-muted-foreground text-xs">@activity.Target</p>
                    </div>
                    <div class="flex shrink-0 items-center gap-1.5 pt-1">
                        <span class="@(Cn.Merge("size-1.5 rounded-full", _actionDots[activity.Action]))"></span>
                        <span class="text-muted-foreground text-xs">@activity.Time</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ActivityItem(string User, string Initials, string Action, string Resource, string Target, string Time);

    private static readonly Dictionary<string, string> _actionLabels = new()
    {
        ["created"] = "created",
        ["updated"] = "updated",
        ["deleted"] = "deleted",
        ["deployed"] = "deployed",
        ["commented"] = "commented on",
    };

    private static readonly Dictionary<string, string> _actionDots = new()
    {
        ["created"] = "bg-emerald-500",
        ["updated"] = "bg-blue-500",
        ["deleted"] = "bg-red-500",
        ["deployed"] = "bg-amber-500",
        ["commented"] = "bg-foreground/40",
    };

    private static readonly ActivityItem[] _activities =
    [
        new("Sarah Chen", "SC", "deployed", "Production", "v2.4.1", "2 min ago"),
        new("James Miller", "JM", "created", "Issue", "Fix header alignment on mobile", "8 min ago"),
