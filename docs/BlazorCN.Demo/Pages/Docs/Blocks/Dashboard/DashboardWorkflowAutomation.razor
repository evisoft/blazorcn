@* ============================================================
   Block: dashboard-workflow-automation
   Title: Dashboard Workflow Automation
   Description: Workflow automation dashboard showing automation workflows with trigger types, last run timestamps, success rates, run counts, and status indicators
   Dependencies: ButtonCn, LucidePlayCn
   Source: original/blocks/dashboard/dashboard-workflow-automation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Workflow Automation</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">@_workflows.Count(w => w.Status == "active") active workflows</p>
            </div>
        </div>

        @* Header row *@
        <div class="grid grid-cols-[1fr_80px_100px_80px_72px_56px_60px] items-center gap-2 border-b bg-muted/30 px-4 py-2">
            <span class="text-muted-foreground text-xs">Name</span>
            <span class="text-muted-foreground text-xs">Trigger</span>
            <span class="text-muted-foreground text-xs">Last Run</span>
            <span class="text-right text-muted-foreground text-xs">Success</span>
            <span class="text-right text-muted-foreground text-xs">Runs</span>
            <span class="text-center text-muted-foreground text-xs">Status</span>
            <span></span>
        </div>

        @* Workflow rows *@
        <div>
            @for (var i = 0; i < _workflows.Length; i++)
                        {
                var workflow = _workflows[i];
                var triggerStyle = workflow.Trigger switch {
                    "Schedule" => "bg-blue-500/10 text-blue-600 dark:text-blue-400",
                    "Event" => "bg-purple-500/10 text-purple-600 dark:text-purple-400",
                    _ => "bg-muted text-muted-foreground",
                };
                var statusDot = workflow.Status switch {
                    "active" => "bg-emerald-500",
                    "paused" => "bg-amber-500",
                    _ => "bg-muted-foreground/40",
                };
                var rateColor = workflow.SuccessRate >= 95 ? "" : workflow.SuccessRate >= 80 ? "text-amber-600 dark:text-amber-400" : "text-red-600 dark:text-red-400";
                <div class="@Cn.Merge("grid grid-cols-[1fr_80px_100px_80px_72px_56px_60px] items-center gap-2 px-4 py-3", i < _workflows.Length - 1 ? "border-b" : "")">
                    <span class="truncate font-medium text-sm">@workflow.Name</span>
                    <span class="@($"inline-flex w-fit items-center rounded-full px-2 py-0.5 text-xs {triggerStyle}")">@workflow.Trigger</span>
                    <span class="text-muted-foreground text-xs">@workflow.LastRun</span>
                    <span class="@($"text-right font-medium text-sm tabular-nums {rateColor}")">@workflow.SuccessRate%</span>
                    <span class="text-right text-muted-foreground text-sm tabular-nums">@workflow.RunCount.ToString("N0")</span>
                    <span class="flex justify-center">
                        <span class="@($"size-2 rounded-full {statusDot}")"></span>
                    </span>
                    <div class="flex justify-end">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                            <LucidePlayCn Size="12" />
                            Run
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record WorkflowItem(string Id, string Name, string Trigger, string LastRun, double SuccessRate, int RunCount, string Status);

    private readonly WorkflowItem[] _workflows = [
        new("1", "Daily Report Generation", "Schedule", "2 hours ago", 99.2, 1847, "active"),
        new("2", "New User Onboarding", "Event", "14 min ago", 97.8, 4231, "active"),
        new("3", "Invoice Processing", "Event", "38 min ago", 94.1, 892, "active"),
        new("4", "Database Backup", "Schedule", "6 hours ago", 100, 730, "active"),
        new("5", "Data Export Pipeline", "Manual", "3 days ago", 88.5, 156, "paused"),
        new("6", "Cache Invalidation", "Event", "5 min ago", 99.9, 28410, "active"),
    ];
}
