@* ============================================================
   Block: dashboard-gpu-utilization
   Title: Dashboard Gpu Utilization
   Description: Animated React GPU cluster monitoring dashboard block for Next.js with node-level GPU compute and memory utilization bars, temperature readings with thermal threshold indicators, model assignment labels, and staggered entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: CPU, memory, and disk utilization across servers
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-gpu-utilization.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">GPU Utilization</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Cluster-wide GPU compute and memory across @_nodes.Length nodes
                </p>
            </div>
            <div class="flex items-center gap-4 text-xs">
                <span class="flex items-center gap-1.5 text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_nodes.Count(n => n.Status == "active") active
                </span>
                <span class="text-muted-foreground">
                    Avg Compute <span class="tabular-nums">@_avgCompute%</span>
                </span>
                <span class="text-muted-foreground">
                    Avg Mem <span class="tabular-nums">@_avgMemory%</span>
                </span>
            </div>
        </div>

        @* Nodes *@
        <div>
            @for (var i = 0; i < _nodes.Length; i++)
            {
                var node = _nodes[i];
                var isLast = i == _nodes.Length - 1;
                <div class="@(Cn.Merge("px-4 py-4", isLast ? "" : "border-b"))">
                    <div class="mb-3 flex items-center gap-3">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", _statusDot[node.Status]))"></span>
                        <span class="font-mono font-medium text-sm">@node.Hostname</span>
                        <span class="rounded bg-muted/50 px-1.5 py-0.5 text-muted-foreground text-xs">
                            @node.GpuModel
                        </span>
                        <span class="font-mono text-muted-foreground text-xs">@node.Workload</span>
                        <div class="ml-auto flex items-center gap-1.5">
                            <LucideThermometerCn Size="12" Class="@(Cn.Merge("size-3", GetTempColor(node.Temperature)))" />
                            <span class="@(Cn.Merge("font-mono text-xs tabular-nums", GetTempColor(node.Temperature)))">
                                @(node.Temperature)°C
                            </span>
                        </div>
                    </div>
                    <div class="space-y-2">
                        @* Compute bar *@
                        <div class="flex items-center gap-3">
                            <span class="w-16 text-muted-foreground text-xs">Compute</span>
                            <div class="relative h-2 flex-1 overflow-hidden rounded-full bg-muted/50">
                                <div class="@(Cn.Merge("absolute inset-y-0 left-0 rounded-full", GetBarColor(node.Compute)))"
                                     style="@($"width: {node.Compute}%")">
                                </div>
                            </div>
                            <span class="@(Cn.Merge("w-10 text-right text-xs tabular-nums", node.Compute >= 90 ? "text-red-600 dark:text-red-400" : "text-muted-foreground"))">
                                @(node.Compute)%
                            </span>
                        </div>
                        @* Memory bar *@
                        <div class="flex items-center gap-3">
                            <span class="w-16 text-muted-foreground text-xs">Memory</span>
                            <div class="relative h-2 flex-1 overflow-hidden rounded-full bg-muted/50">
                                <div class="@(Cn.Merge("absolute inset-y-0 left-0 rounded-full", GetBarColor(node.Memory)))"
                                     style="@($"width: {node.Memory}%")">
                                </div>
                            </div>
                            <span class="w-24 text-right font-mono text-muted-foreground text-xs tabular-nums">
                                @node.MemoryUsed/@node.MemoryTotal
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record GpuNode(string Id, string Hostname, string GpuModel, int Compute, int Memory, string MemoryUsed, string MemoryTotal, int Temperature, string Workload, string Status);

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["active"] = "bg-emerald-500",
        ["idle"] = "bg-zinc-400",
        ["throttled"] = "bg-red-500",
    };

    private static string GetBarColor(int value)
    {
        if (value >= 90) return "bg-red-500";
        if (value >= 70) return "bg-amber-500";
        return "bg-emerald-500";
    }

    private static string GetTempColor(int temp)
    {
        if (temp >= 85) return "text-red-600 dark:text-red-400";
        if (temp >= 70) return "text-amber-600 dark:text-amber-400";
        return "text-muted-foreground";
    }

    private static readonly GpuNode[] _nodes =
    [
        new("n1", "gpu-node-01", "A100 80GB", 94, 87, "69.6 GB", "80 GB", 78, "llama-3-70b-finetune", "active"),
        new("n2", "gpu-node-02", "A100 80GB", 62, 54, "43.2 GB", "80 GB", 64, "embedding-batch-job", "active"),
        new("n3", "gpu-node-03", "H100 80GB", 98, 91, "72.8 GB", "80 GB", 88, "mixtral-8x7b-inference", "throttled"),
        new("n4", "gpu-node-04", "A100 40GB", 8, 12, "4.8 GB", "40 GB", 38, "idle", "idle"),
        new("n5", "gpu-node-05", "H100 80GB", 76, 68, "54.4 GB", "80 GB", 72, "stable-diffusion-xl-train", "active"),
    ];

    private static readonly int _avgCompute = (int)Math.Round(_nodes.Average(n => n.Compute));
    private static readonly int _avgMemory = (int)Math.Round(_nodes.Average(n => n.Memory));
}
