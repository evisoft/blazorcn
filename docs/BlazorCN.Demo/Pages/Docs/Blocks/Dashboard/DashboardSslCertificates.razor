@* ============================================================
   Block: dashboard-ssl-certificates
   Title: Dashboard Ssl Certificates
   Description: Animated React SSL certificate expiry tracker dashboard block for Next.js with domain names, certificate issuers, days remaining countdown, expiry urgency coloring, protocol versions, and renewal actions using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: DNS record management with propagation status
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/dashboard/dashboard-ssl-certificates.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideLockCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">SSL Certificates</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @_certificates.Length certificates tracked
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                @if (_criticalCount > 0)
                {
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        @_criticalCount critical
                    </span>
                }
                @if (_warningCount > 0)
                {
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        @_warningCount warning
                    </span>
                }
            </div>
        </div>

        @* Certificates *@
        <div>
            @for (var i = 0; i < _certificates.Length; i++)
            {
                var cert = _certificates[i];
                var isExpanded = _expanded == cert.Id;
                var isLast = i == _certificates.Length - 1;

                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : cert.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", cert.DaysRemaining <= 7 ? "bg-red-500" : cert.DaysRemaining <= 30 ? "bg-amber-500" : "bg-emerald-500"))"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-mono text-sm">@cert.Domain</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @cert.Issuer
                                <span class="mx-1.5">&middot;</span>
                                @cert.Protocol
                            </p>
                        </div>
                        <div class="shrink-0 text-right">
                            <span class="@(Cn.Merge("block font-semibold text-sm tabular-nums", GetDaysColor(cert.DaysRemaining)))">
                                @(cert.DaysRemaining)d
                            </span>
                            <span class="block text-muted-foreground text-[10px]">
                                @cert.ExpiryDate
                            </span>
                        </div>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-4 pl-9">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <div class="space-y-1.5 text-xs">
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground">Key Type</span>
                                            <span class="font-mono">@cert.KeyType</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground">Auto-Renew</span>
                                            <span class="@(cert.AutoRenew ? "text-emerald-600 dark:text-emerald-400" : "text-muted-foreground")">
                                                @(cert.AutoRenew ? "Enabled" : "Disabled")
                                            </span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground">Fingerprint</span>
                                            <div class="flex items-center gap-1">
                                                <span class="font-mono">@cert.Fingerprint</span>
                                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-5 w-5 p-0">
                                                    <LucideCopyCn Size="12" Class="size-3 text-muted-foreground" />
                                                </ButtonCn>
                                            </div>
                                        </div>
                                    </div>

                                    @* SANs *@
                                    <div class="mt-3 border-t border-border/50 pt-3">
                                        <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                                            Subject Alternative Names
                                        </span>
                                        <div class="flex flex-wrap gap-1">
                                            @foreach (var san in cert.Sans)
                                            {
                                                <span class="rounded bg-muted px-1.5 py-0.5 font-mono text-[10px]">
                                                    @san
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    @* Actions *@
                                    @if (cert.DaysRemaining <= 30)
                                    {
                                        <div class="mt-3 flex items-center gap-2">
                                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                                                <LucideRefreshCwCn Size="12" Class="size-3" />
                                                Renew Now
                                            </ButtonCn>
                                            @if (cert.DaysRemaining <= 7)
                                            {
                                                <BadgeCn Variant="BadgeVariant.Secondary" Class="@(Cn.Merge("text-[10px] font-normal", GetDaysBadge(cert.DaysRemaining)))">
                                                    Expires in @(cert.DaysRemaining)d
                                                </BadgeCn>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "c1";

    private record CertificateData(string Id, string Domain, string Issuer, string Protocol, string KeyType, string ExpiryDate, int DaysRemaining, string[] Sans, string Fingerprint, bool AutoRenew);

    private int _criticalCount => _certificates.Count(c => c.DaysRemaining <= 7);
    private int _warningCount => _certificates.Count(c => c.DaysRemaining > 7 && c.DaysRemaining <= 30);

    private static string GetDaysColor(int days) =>
        days <= 7 ? "text-red-600 dark:text-red-400" :
        days <= 30 ? "text-amber-600 dark:text-amber-400" :
        "text-muted-foreground";

    private static string GetDaysBadge(int days) =>
        days <= 7 ? "bg-red-500/10 text-red-700 dark:text-red-400" :
        days <= 30 ? "bg-amber-500/10 text-amber-700 dark:text-amber-400" :
        "";

    private readonly CertificateData[] _certificates = new[]
    {
        new CertificateData("c1", "acme.com", "DigiCert Global G2", "TLS 1.3", "ECDSA P-256", "Mar 22, 2026", 4, new[] { "acme.com", "www.acme.com" }, "A3:F8:C2:D1:E9:B4:07:5A", false),
        new CertificateData("c2", "api.acme.com", "Let's Encrypt R3", "TLS 1.3", "RSA 2048", "Apr 08, 2026", 21, new[] { "api.acme.com", "api-v2.acme.com" }, "B7:E2:F4:C8:D6:10:3B:9E", true),
        new CertificateData("c3", "*.staging.acme.com", "Let's Encrypt R3", "TLS 1.3", "ECDSA P-256", "May 14, 2026", 57, new[] { "*.staging.acme.com" }, "C5:D7:E9:F1:A3:B5:2C:4D", true),
        new CertificateData("c4", "dashboard.acme.com", "Cloudflare Inc ECC", "TLS 1.3", "ECDSA P-256", "Aug 30, 2026", 165, new[] { "dashboard.acme.com", "app.acme.com" }, "D8:E0:F2:A4:B6:C8:1D:3F", true),
        new CertificateData("c5", "mail.acme.com", "Sectigo RSA DV", "TLS 1.2", "RSA 4096", "Apr 02, 2026", 15, new[] { "mail.acme.com", "smtp.acme.com", "imap.acme.com" }, "E1:F3:A5:B7:C9:D0:2E:4G", false),
        new CertificateData("c6", "cdn.acme.com", "Amazon RSA 2048 M02", "TLS 1.3", "RSA 2048", "Nov 18, 2026", 245, new[] { "cdn.acme.com", "assets.acme.com", "static.acme.com" }, "F2:A4:B6:C8:D0:E1:3F:5H", true),
        new CertificateData("c7", "internal.acme.com", "Acme Internal CA", "TLS 1.2", "RSA 2048", "Mar 19, 2026", 1, new[] { "internal.acme.com", "vpn.acme.com", "wiki.acme.com" }, "G3:H5:I7:J9:K0:L2:4M:6N", false)
    };
}
