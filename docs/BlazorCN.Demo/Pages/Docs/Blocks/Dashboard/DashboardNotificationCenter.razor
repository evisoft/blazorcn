@* ============================================================
   Block: dashboard-notification-center
   Title: Dashboard Notification Center
   Description: Animated React notification center dashboard block for Next.js with filterable notification list showing notifications across tabs with type-based icons, message previews, time strings, and read status indicators using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Filterable notification list
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-notification-center.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideBellCn Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="font-medium text-sm">Notifications</h2>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 px-2 text-xs">
                    Mark all read
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0" aria-label="Notification settings">
                    <LucideSettingsCn Size="14" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>

        @* Filter tabs *@
        <div class="flex items-center gap-1 border-b px-4 py-2">
            @foreach (var tab in _tabs)
            {
                var isActive = _activeTab == tab.Value;
                <button
                    type="button"
                    @onclick="@(() => _activeTab = tab.Value)"
                    class="@(Cn.Merge("inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs transition-colors", isActive ? "bg-foreground text-background" : "text-muted-foreground hover:bg-muted/50"))">
                    @tab.Label
                    @if (tab.Count > 0)
                    {
                        <span class="@(Cn.Merge("tabular-nums", isActive ? "text-background/70" : "text-muted-foreground/60"))">
                            @tab.Count
                        </span>
                    }
                </button>
            }
        </div>

        @* Notification list *@
        <div>
            @{
                var filtered = _activeTab == "unread" ? _notifications.Where(n => !n.Read).ToArray() : _notifications;
            }
            @for (var i = 0; i < filtered.Length; i++)
            {
                var notification = filtered[i];
                var isLast = i == filtered.Length - 1;
                <div class="@(Cn.Merge("flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b"))">
                    @if (notification.Type == "alert")
                    {
                        <LucideCircleAlertCn Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                    }
                    else if (notification.Type == "success")
                    {
                        <LucideCircleCheckBigCn Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                    }
                    else if (notification.Type == "info")
                    {
                        <LucideInfoCn Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                    }
                    else if (notification.Type == "message")
                    {
                        <LucideMessageSquareCn Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                    }
                    else if (notification.Type == "user")
                    {
                        <LucideUserPlusCn Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                    }
                    else
                    {
                        <LucideZapCn Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                    }
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@notification.Title</span>
                            @if (!notification.Read)
                            {
                                <span class="size-1.5 shrink-0 rounded-full bg-blue-500"></span>
                            }
                        </div>
                        <p class="mt-0.5 line-clamp-1 text-muted-foreground text-xs">
                            @notification.Message
                        </p>
                    </div>
                    <span class="shrink-0 text-muted-foreground text-xs">
                        @notification.Time
                    </span>
                </div>
            }
            @if (filtered.Length == 0)
            {
                <div class="px-4 py-8 text-center text-muted-foreground text-sm">
                    No notifications to show
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string _activeTab = "all";

    private record NotificationData(string Id, string Type, string Title, string Message, string Time, bool Read);
    private record TabData(string Label, string Value, int Count);

    private int _unreadCount => _notifications.Count(n => !n.Read);

    private TabData[] _tabs => new[]
    {
        new TabData("All", "all", 0),
        new TabData("Unread", "unread", _unreadCount),
        new TabData("Archived", "archived", 0)
    };

    private readonly NotificationData[] _notifications = new[]
    {
        new NotificationData("1", "alert", "Deployment failed", "Build #847 failed on staging environment due to a dependency conflict", "3 min ago", false),
        new NotificationData("2", "success", "Invoice processed", "Invoice INV-2847 for $1,240.00 has been successfully processed and sent", "12 min ago", false),
        new NotificationData("3", "user", "New team member", "Sarah Chen accepted the invitation and joined the Engineering team", "28 min ago", false),
        new NotificationData("4", "message", "Comment on PR #392", "Alex Rivera left a review comment on your pull request for the auth module", "1 hour ago", false),
        new NotificationData("5", "system", "Scheduled maintenance", "Database maintenance window scheduled for Saturday 2:00 AM to 4:00 AM UTC", "2 hours ago", true),
        new NotificationData("6", "info", "Usage limit approaching", "API usage is at 85% of your monthly quota with 6 days remaining in the cycle", "4 hours ago", true),
        new NotificationData("7", "success", "Backup completed", "Daily database backup completed successfully with 2.4 GB compressed archive", "6 hours ago", true),
        new NotificationData("8", "alert", "High error rate detected", "Error rate exceeded 2% threshold on the payments service for the last 15 minutes", "8 hours ago", true)
    };
}
