@* ============================================================
   Block: dashboard-ml-model-performance
   Title: Dashboard Ml Model Performance
   Description: Animated React machine learning model performance dashboard for Next.js with accuracy, precision, recall, F1 score metrics, version comparison table, training status, and dataset statistics using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Data pipeline status and throughput
   Dependencies: BadgeCn
   Source: original/blocks/dashboard/dashboard-ml-model-performance.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideBrainCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Model Performance</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        sentiment-classifier · 4 versions
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideRocketCn Size="12" Class="size-3 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">v3.2.0 in prod</span>
            </div>
        </div>

        @* Column labels *@
        <div class="flex items-center gap-3 border-b px-4 py-2">
            <span class="w-5"></span>
            <span class="min-w-0 flex-1 text-muted-foreground text-[10px]">Version</span>
            <div class="flex shrink-0 items-center gap-4">
                <span class="w-12 text-right text-muted-foreground text-[10px]">Accuracy</span>
                <span class="w-12 text-right text-muted-foreground text-[10px]">Precision</span>
                <span class="w-12 text-right text-muted-foreground text-[10px]">Recall</span>
                <span class="w-10 text-right text-muted-foreground text-[10px]">F1</span>
            </div>
            <span class="w-4"></span>
        </div>

        @* Model rows *@
        <div>
            @for (var i = 0; i < _models.Length; i++)
                        {
                var model = _models[i];
                var isExpanded = _expanded == model.Id;
                var isLast = i == _models.Length - 1;
                var config = _statusConfig[model.Status];

                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = isExpanded ? null : model.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        @* Status dot *@
                        <div class="relative flex shrink-0 items-center justify-center">
                            <span class="@(Cn.Merge("size-2 rounded-full", config.Dot))"></span>
                        </div>

                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-mono font-medium text-sm">@model.Version</span>
                                @if (model.Status == "deployed")
                                            {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">
                                        production
                                    </BadgeCn>
                                }
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @model.DatasetSize · @model.Features features · @model.Timestamp
                            </p>
                        </div>

                        @* Scores *@
                        <div class="flex shrink-0 items-center gap-4">
                            <span class="@(Cn.Merge("w-12 text-right font-mono text-xs tabular-nums", GetScoreColor(model.Accuracy)))">
                                @(model.Accuracy > 0 ? $"{model.Accuracy}%" : "—")
                            </span>
                            <span class="@(Cn.Merge("w-12 text-right font-mono text-xs tabular-nums", GetScoreColor(model.Precision)))">
                                @(model.Precision > 0 ? $"{model.Precision}%" : "—")
                            </span>
                            <span class="@(Cn.Merge("w-12 text-right font-mono text-xs tabular-nums", GetScoreColor(model.Recall)))">
                                @(model.Recall > 0 ? $"{model.Recall}%" : "—")
                            </span>
                            <span class="@(Cn.Merge("w-10 text-right font-mono text-xs tabular-nums", GetScoreColor(model.F1)))">
                                @(model.F1 > 0 ? $"{model.F1:F1}" : "—")
                            </span>
                        </div>

                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded && model.ClassMetrics.Length > 0)
                                {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-4 pl-9">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <span class="mb-2 block font-medium text-muted-foreground text-xs">
                                        Per-class breakdown
                                    </span>
                                    <div class="space-y-2">
                                        @foreach (var cls in model.ClassMetrics)
                                                    {
                                            <div class="flex items-center justify-between">
                                                <span class="text-sm">@cls.ClassName</span>
                                                <div class="flex items-center gap-3">
                                                    <span class="text-muted-foreground text-xs tabular-nums">
                                                        P: @(cls.Precision)%
                                                    </span>
                                                    <span class="text-muted-foreground text-xs tabular-nums">
                                                        R: @(cls.Recall)%
                                                    </span>
                                                    <span class="text-muted-foreground text-xs tabular-nums">
                                                        F1: @cls.F1
                                                    </span>
                                                    <span class="text-muted-foreground text-xs">·</span>
                                                    <span class="text-muted-foreground text-xs tabular-nums">
                                                        @cls.Support
                                                    </span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ClassMetric(string ClassName, double Precision, double Recall, double F1, string Support);
    private record ModelVersion(string Id, string Version, string Status, double Accuracy, double Precision, double Recall, double F1, string TrainingTime, string DatasetSize, int Features, string Timestamp, ClassMetric[] ClassMetrics);
    private record StatusConfig(string Dot, string Label);

    private string? _expanded = "v1";

    private static string GetScoreColor(double score)
    {
        if (score == 0) return "text-muted-foreground";
        if (score >= 93) return "text-emerald-600 dark:text-emerald-400";
        if (score >= 88) return "text-amber-600 dark:text-amber-400";
        return "text-red-600 dark:text-red-400";
    }

    private readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["deployed"] = new("bg-emerald-500", "Deployed"),
        ["training"] = new("bg-amber-500", "Training"),
        ["ready"] = new("bg-blue-500", "Ready"),
        ["failed"] = new("bg-red-500", "Failed")
    };

    private readonly ModelVersion[] _models = new[]
    {
        new ModelVersion("v1", "v3.2.0", "deployed", 94.7, 93.2, 95.1, 94.1, "4h 23m", "2.4M samples", 128, "3 days ago", new[]
        {
            new ClassMetric("positive", 95.8, 93.4, 94.6, "1.2M"),
            new ClassMetric("negative", 90.1, 96.8, 93.3, "980K"),
            new ClassMetric("neutral", 93.7, 95.1, 94.4, "220K")
        }),
        new ModelVersion("v2", "v3.3.0-rc1", "training", 0, 0, 0, 0, "2h 10m", "2.6M samples", 142, "Running", Array.Empty<ClassMetric>()),
        new ModelVersion("v3", "v3.1.2", "ready", 93.1, 91.8, 94.2, 93.0, "3h 58m", "2.2M samples", 128, "2 weeks ago", new[]
        {
            new ClassMetric("positive", 94.2, 92.1, 93.1, "1.1M"),
            new ClassMetric("negative", 88.9, 96.3, 92.5, "900K"),
            new ClassMetric("neutral", 92.3, 94.2, 93.2, "200K")
        }),
        new ModelVersion("v4", "v3.0.0", "ready", 91.4, 90.2, 92.5, 91.3, "5h 12m", "1.8M samples", 96, "1 month ago", new[]
        {
            new ClassMetric("positive", 92.1, 90.8, 91.4, "950K"),
            new ClassMetric("negative", 87.5, 94.2, 90.7, "680K"),
            new ClassMetric("neutral", 91.0, 92.5, 91.7, "170K")
        })
    };
}
