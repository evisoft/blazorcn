@* ============================================================
   Block: dashboard-energy-consumption
   Title: Dashboard Energy Consumption
   Description: Animated React data center energy usage monitoring dashboard block for Next.js with PUE ratio, cooling efficiency, power draw per rack, monthly kWh trend bars, and renewable energy percentage using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: CO2 emissions tracking with offset progress
   Dependencies: BadgeCn
   Source: original/blocks/dashboard/dashboard-energy-consumption.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideZapCn Size="16" Class="size-4 text-amber-600 dark:text-amber-400" />
                <span class="font-medium text-sm">Energy Consumption</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                DC-East-1
            </BadgeCn>
        </div>

        @* Key metrics *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div>
                <p class="text-muted-foreground text-xs">PUE</p>
                <p class="@(Cn.Merge("font-semibold text-2xl tabular-nums", GetPueColor(_pue)))">@_pue</p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">Total Power</p>
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-sm tabular-nums">@_totalPowerKw</span>
                    <span class="text-muted-foreground text-xs">kW</span>
                </div>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">IT Load</p>
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-sm tabular-nums">@_itLoadKw</span>
                    <span class="text-muted-foreground text-xs">kW</span>
                </div>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">Cooling</p>
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-sm tabular-nums">@_coolingPowerKw</span>
                    <span class="text-muted-foreground text-xs">kW (@(_coolingPercent)%)</span>
                </div>
            </div>
        </div>

        @* Renewable energy progress *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Renewable Energy</span>
                <span class="font-medium text-xs tabular-nums">@(_renewablePercent)%</span>
            </div>
            <div class="h-2 overflow-hidden rounded-full bg-muted/50">
                <div class="h-full rounded-full bg-emerald-500"
                     style="@($"width: {_renewablePercent}%")">
                </div>
            </div>
            <div class="mt-1.5 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Target: 100% by 2028</span>
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    Carbon intensity: @_carbonIntensity kgCO2/kWh
                </span>
            </div>
        </div>

        @* Monthly trend *@
        <div class="border-b px-4 py-3">
            <p class="mb-3 text-muted-foreground text-xs">Monthly Energy (MWh)</p>
            <div class="flex h-24 items-end gap-1">
                @foreach (var month in _monthlyData)
                {
                    var heightPercent = (double)month.Kwh / _maxKwh * 100;
                    <div class="flex flex-1 flex-col items-center gap-1">
                        <div class="w-full rounded-t bg-foreground/15"
                             style="@(FormattableString.Invariant($"height: {heightPercent:F1}%"))"
                             title="@($"{month.Kwh} MWh")">
                        </div>
                    </div>
                }
            </div>
            <div class="mt-1.5 flex justify-between">
                @foreach (var month in _monthlyData)
                {
                    <span class="flex-1 text-center text-muted-foreground text-[10px]">
                        @month.Month
                    </span>
                }
            </div>
        </div>

        @* Power sources *@
        <div>
            @for (var i = 0; i < _powerSources.Length; i++)
            {
                var source = _powerSources[i];
                var isLast = i == _powerSources.Length - 1;
                var isFossil = source.Source.Contains("fossil");
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b"))">
                    <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", isFossil ? "bg-zinc-400" : "bg-emerald-500"))"></span>
                    <span class="min-w-0 flex-1 font-medium text-sm">@source.Source</span>
                    <div class="h-1.5 w-20 overflow-hidden rounded-full bg-muted/50">
                        <div class="@(Cn.Merge("h-full rounded-full", isFossil ? "bg-foreground/20" : "bg-emerald-500/40"))"
                             style="@($"width: {source.Percentage}%")">
                        </div>
                    </div>
                    <span class="w-8 text-right font-medium text-xs tabular-nums">
                        @(source.Percentage)%
                    </span>
                    <span class="w-14 text-right text-muted-foreground text-xs tabular-nums">
                        @source.Kwh
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private const double _pue = 1.18;
    private const int _totalPowerKw = 2840;
    private const int _itLoadKw = 2407;
    private const int _coolingPowerKw = 312;
    private const double _coolingPercent = 11.0;
    private const int _renewablePercent = 72;
    private const string _carbonIntensity = "0.28";

    private record MonthlyEnergy(string Month, int Kwh);
    private record PowerSource(string Source, int Percentage, string Kwh);

    private static string GetPueColor(double pue)
    {
        if (pue <= 1.2) return "text-emerald-600 dark:text-emerald-400";
        if (pue <= 1.5) return "text-amber-600 dark:text-amber-400";
        return "text-red-600 dark:text-red-400";
    }

    private static readonly MonthlyEnergy[] _monthlyData =
    [
        new("Jul", 2180),
        new("Aug", 2340),
        new("Sep", 2120),
        new("Oct", 1980),
        new("Nov", 1860),
        new("Dec", 1920),
        new("Jan", 1840),
        new("Feb", 1780),
        new("Mar", 1900),
        new("Apr", 2010),
        new("May", 2160),
        new("Jun", 2280),
    ];

    private static readonly int _maxKwh = _monthlyData.Max(m => m.Kwh);

    private static readonly PowerSource[] _powerSources =
    [
        new("Solar PPA", 38, "862K"),
        new("Wind RECs", 22, "500K"),
        new("On-site solar", 12, "272K"),
        new("Grid (fossil)", 28, "636K"),
    ];
}
