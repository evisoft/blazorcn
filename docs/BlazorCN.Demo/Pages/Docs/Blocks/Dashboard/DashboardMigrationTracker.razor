@* ============================================================
   Block: dashboard-migration-tracker
   Title: Dashboard Migration Tracker
   Description: Animated React data migration tracker dashboard block for Next.js displaying four migration jobs with source and destination labels, total and processed record counts, animated progress bars with spring physics, elapsed time, estimated time of arrival, and error counts with red highlighting using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Data quality scores and issue tracking
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-migration-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Migration Tracker</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Active data migration jobs and progress
            </p>
        </div>

        @* Jobs *@
        <div>
            @for (var i = 0; i < _jobs.Length; i++)
            {
                var job = _jobs[i];
                var isLast = i == _jobs.Length - 1;
                var progress = (double)job.ProcessedRecords / job.TotalRecords * 100;
                var isComplete = progress >= 100;
                <div class="@(Cn.Merge("px-4 py-4", isLast ? "" : "border-b"))">
                    @* Source -> Destination *@
                    <div class="mb-3 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@job.Source</span>
                            <LucideArrowRightCn Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="font-medium text-sm">@job.Destination</span>
                        </div>
                        @if (job.Errors > 0)
                        {
                            <span class="text-red-600 text-xs tabular-nums dark:text-red-400">
                                @job.Errors errors
                            </span>
                        }
                    </div>

                    @* Progress bar *@
                    <div class="mb-2 h-2 w-full overflow-hidden rounded-full bg-muted/50">
                        <div class="@(Cn.Merge("h-full rounded-full", isComplete ? "bg-emerald-500/60" : "bg-foreground/20"))"
                             style="@($"width: {progress:F1}%")">
                        </div>
                    </div>

                    @* Stats row *@
                    <div class="flex items-center gap-4 text-xs">
                        <span class="text-muted-foreground">
                            <span class="font-medium tabular-nums text-foreground">
                                @FormatCount(job.ProcessedRecords)
                            </span>
                            / <span class="tabular-nums">@FormatCount(job.TotalRecords)</span>
                            records
                        </span>
                        <span class="text-muted-foreground">@(progress.ToString("F1"))%</span>
                        <span class="ml-auto text-muted-foreground">
                            Elapsed: <span class="tabular-nums">@job.Elapsed</span>
                        </span>
                        <span class="text-muted-foreground">
                            ETA:
                            <span class="@(Cn.Merge("tabular-nums", isComplete ? "text-emerald-600 dark:text-emerald-400" : ""))">
                                @job.Eta
                            </span>
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record MigrationJob(string Source, string Destination, int TotalRecords, int ProcessedRecords, string Elapsed, string Eta, int Errors);

    private static string FormatCount(int n)
    {
        if (n >= 1000000) return $"{n / 1000000.0:F1}M";
        if (n >= 1000) return $"{n / 1000}K";
        return n.ToString();
    }

    private static readonly MigrationJob[] _jobs =
    [
        new("MySQL (legacy)", "PostgreSQL", 2450000, 1838000, "1h 42m", "34m", 0),
        new("MongoDB", "DynamoDB", 890000, 890000, "2h 15m", "Complete", 12),
        new("S3 (CSV)", "Snowflake", 5200000, 1560000, "48m", "2h 10m", 3),
        new("Oracle DB", "BigQuery", 1100000, 275000, "22m", "1h 6m", 0),
    ];
}
