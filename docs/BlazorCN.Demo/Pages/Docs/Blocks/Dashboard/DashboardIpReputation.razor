@* ============================================================
   Block: dashboard-ip-reputation
   Title: Dashboard Ip Reputation
   Description: Animated React IP reputation monitoring dashboard block for Next.js with blocklist and allowlist management, threat scores, geographic origin data, last-seen timestamps, expandable threat details, and staggered entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Security posture and vulnerability scanning
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-ip-reputation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideShieldAlertCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">IP Reputation</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Blocklist, allowlist, and threat monitoring
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_entries.Count(e => e.ListStatus == "blocked")
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_entries.Count(e => e.ListStatus == "watching")
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_entries.Count(e => e.ListStatus == "allowed")
                </span>
            </div>
        </div>

        @* Entries *@
        <div>
            @for (var i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                var isExpanded = _expanded == entry.Id;
                var isLast = i == _entries.Length - 1;
                var config = _statusConfig[entry.ListStatus];
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : entry.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", config.Dot))"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-mono font-medium text-sm">@entry.Address</span>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="text-muted-foreground text-[10px]">
                                    @entry.City, @entry.Country
                                </span>
                                <span class="text-muted-foreground text-[10px]">·</span>
                                <span class="text-muted-foreground text-[10px]">@entry.LastSeen</span>
                            </div>
                        </div>
                        <div class="flex shrink-0 items-center gap-4">
                            @if (entry.ThreatScore > 0)
                            {
                                <span class="@(Cn.Merge("font-mono text-xs font-medium tabular-nums", GetThreatColor(entry.ThreatScore)))">
                                    @entry.ThreatScore/100
                                </span>
                            }
                            <span class="text-muted-foreground text-xs">@config.Label</span>
                            <LucideChevronRightCn Class="@(Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="mb-2 flex items-center justify-between">
                                    <span class="font-medium text-muted-foreground text-xs">
                                        Threat intelligence
                                    </span>
                                    @if (entry.ListStatus == "watching")
                                    {
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs">
                                            Block IP
                                        </ButtonCn>
                                    }
                                </div>
                                <div class="mb-2 flex items-center gap-4 text-xs">
                                    <span class="text-muted-foreground">
                                        Attack vector:
                                        <span class="text-foreground"> @entry.AttackVector</span>
                                    </span>
                                    <span class="text-muted-foreground">
                                        Requests:
                                        <span class="tabular-nums text-foreground"> @entry.RequestCount.ToString("N0")</span>
                                    </span>
                                </div>
                                <p class="text-sm leading-relaxed">@entry.Detail</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "ip1";

    private record IpEntry(string Id, string Address, int ThreatScore, string ListStatus, string Country, string City, string LastSeen, int RequestCount, string AttackVector, string Detail);
    private record StatusConfig(string Dot, string Label);

    private static string GetThreatColor(int score)
    {
        if (score >= 80) return "text-red-600 dark:text-red-400";
        if (score >= 50) return "text-amber-600 dark:text-amber-400";
        if (score > 0) return "text-blue-600 dark:text-blue-400";
        return "text-muted-foreground";
    }

    private static readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["blocked"] = new("bg-red-500", "Blocked"),
        ["allowed"] = new("bg-emerald-500", "Allowed"),
        ["watching"] = new("bg-amber-500", "Watching"),
    };

    private static readonly IpEntry[] _entries =
    [
        new("ip1", "185.220.101.34", 94, "blocked", "DE", "Frankfurt", "3 min ago", 14280, "Credential stuffing",
            "Automated login attempts targeting /api/auth/login with 14,280 requests in the last hour. Using rotating user-agent strings and distributed across 3 subnets. Matches known Tor exit node."),
        new("ip2", "45.134.26.189", 87, "blocked", "RU", "Moscow", "12 min ago", 8420, "SQL injection",
            "Scanning multiple API endpoints with SQL injection payloads. Targeting /api/v2/search and /api/v2/users with UNION-based injection patterns. 8,420 malicious requests detected."),
        new("ip3", "103.152.220.44", 72, "blocked", "CN", "Shanghai", "28 min ago", 3840, "Path traversal",
            "Attempting directory traversal on static asset endpoints. Requests include ../../../etc/passwd patterns. 3,840 requests over 45 minutes from a single source IP."),
        new("ip4", "192.168.1.100", 0, "allowed", "US", "San Francisco", "1 min ago", 24100, "N/A",
            "Internal monitoring service. Allowlisted to prevent false positive blocking from health check traffic. Generates ~500 requests/min across all monitored endpoints."),
        new("ip5", "89.248.165.72", 58, "watching", "NL", "Amsterdam", "1 hour ago", 1240, "Scraping",
            "Automated scraping of product catalog pages. Rate exceeds normal usage but not definitively malicious. Monitoring for escalation before applying block rules."),
        new("ip6", "34.102.136.180", 0, "allowed", "US", "Council Bluffs", "5 min ago", 18700, "N/A",
            "Google Cloud health check service. Allowlisted to ensure load balancer health probes are not blocked."),
    ];
}
