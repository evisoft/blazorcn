@* ============================================================
   Block: dashboard-payment-methods
   Title: Dashboard Payment Methods
   Description: Animated React payment method distribution dashboard block for Next.js with card ACH and wire transfer breakdown, failure rate tracking per method, transaction volume bars, expandable details with decline reasons, and staggered entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Payment processing metrics and trends
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-payment-methods.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Payment Methods</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Distribution and failure rates — last 30 days
                </p>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="font-semibold text-sm tabular-nums">
                    @_totalTransactions.ToString("N0")
                </span>
                <span class="text-muted-foreground text-xs">transactions</span>
            </div>
        </div>

        <div>
            @for (var i = 0; i < _methods.Length; i++)
            {
                var method = _methods[i];
                var isExpanded = _expanded == method.Id;
                var isLast = i == _methods.Length - 1;

                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : method.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        @if (method.Icon == "card")
                        {
                            <LucideCreditCardCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        }
                        else if (method.Icon == "bank")
                        {
                            <LucideLandmarkCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        }
                        else if (method.Icon == "wire")
                        {
                            <LucideBanknoteCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        }
                        else
                        {
                            <LucideWalletCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        }
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@method.Name</span>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="text-muted-foreground text-xs tabular-nums">
                                    @method.Transactions.ToString("N0") txns
                                </span>
                                <span class="text-muted-foreground text-[10px]">·</span>
                                <span class="font-medium text-xs tabular-nums">@method.Volume</span>
                            </div>
                        </div>
                        <div class="shrink-0 text-right">
                            <div class="flex items-center gap-2">
                                <span class="text-emerald-600 dark:text-emerald-400 text-xs tabular-nums">
                                    @method.SuccessRate%
                                </span>
                                <span class="text-muted-foreground text-[10px]">/</span>
                                <span class="@(Cn.Merge("text-xs tabular-nums", method.FailureRate > 3 ? "text-red-600 dark:text-red-400" : "text-muted-foreground"))">
                                    @method.FailureRate% fail
                                </span>
                            </div>
                            <div class="mt-1 h-1 w-20 overflow-hidden rounded-full bg-muted">
                                <div class="h-full rounded-full bg-foreground/20"
                                     style="@($"width: {method.VolumeBar}%")">
                                </div>
                            </div>
                        </div>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-3">
                                <span class="text-muted-foreground text-xs font-medium">
                                    Decline Reasons
                                </span>
                                <div class="mt-2 overflow-hidden rounded-md border">
                                    @for (var ri = 0; ri < method.DeclineReasons.Length; ri++)
                                    {
                                        var reason = method.DeclineReasons[ri];
                                        <div class="@(Cn.Merge("flex items-center gap-3 px-3 py-2", ri < method.DeclineReasons.Length - 1 ? "border-b" : ""))">
                                            <span class="min-w-0 flex-1 text-xs">@reason.Reason</span>
                                            <span class="shrink-0 font-mono text-muted-foreground text-[10px] tabular-nums">
                                                @reason.Count
                                            </span>
                                            <div class="h-1 w-16 shrink-0 overflow-hidden rounded-full bg-muted">
                                                <div class="h-full rounded-full bg-red-500/40"
                                                     style="@(FormattableString.Invariant($"width: {reason.Percentage}%"))">
                                                </div>
                                            </div>
                                            <span class="w-8 shrink-0 text-right font-mono text-muted-foreground text-[10px] tabular-nums">
                                                @reason.Percentage%
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record DeclineReason(string Reason, int Count, double Percentage);
    private record PaymentMethodData(string Id, string Name, string Icon, int Transactions, string Volume, double SuccessRate, double FailureRate, int VolumeBar, DeclineReason[] DeclineReasons);

    private int _totalTransactions => _methods.Sum(m => m.Transactions);

    private readonly PaymentMethodData[] _methods = new[]
    {
        new PaymentMethodData("m1", "Credit / Debit Card", "card", 24891, "$1.84M", 96.2, 3.8, 100, new[]
        {
            new DeclineReason("Insufficient funds", 412, 43.5),
            new DeclineReason("Card expired", 198, 20.9),
            new DeclineReason("Incorrect CVC", 142, 15.0),
            new DeclineReason("Fraud suspected", 108, 11.4),
            new DeclineReason("Issuer declined", 87, 9.2)
        }),
        new PaymentMethodData("m2", "ACH Bank Transfer", "bank", 8432, "$920K", 98.1, 1.9, 50, new[]
        {
            new DeclineReason("Insufficient balance", 89, 55.6),
            new DeclineReason("Account closed", 34, 21.3),
            new DeclineReason("Invalid routing number", 22, 13.8),
            new DeclineReason("Authorization revoked", 15, 9.3)
        }),
        new PaymentMethodData("m3", "Wire Transfer", "wire", 1204, "$2.1M", 99.4, 0.6, 72, new[]
        {
            new DeclineReason("Compliance hold", 4, 57.1),
            new DeclineReason("Invalid SWIFT code", 2, 28.6),
            new DeclineReason("Sanctions screening", 1, 14.3)
        }),
        new PaymentMethodData("m4", "Digital Wallet", "wallet", 6218, "$412K", 97.8, 2.2, 22, new[]
        {
            new DeclineReason("Token expired", 62, 45.3),
            new DeclineReason("Account suspended", 38, 27.7),
            new DeclineReason("Region not supported", 24, 17.5),
            new DeclineReason("Limit exceeded", 13, 9.5)
        })
    };
}
