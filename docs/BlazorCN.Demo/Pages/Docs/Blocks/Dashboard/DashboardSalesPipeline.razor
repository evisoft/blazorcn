@* ============================================================
   Block: dashboard-sales-pipeline
   Title: Dashboard Sales Pipeline
   Description: Sales pipeline dashboard with four funnel stages showing lead counts, conversion rates, and total pipeline value
   Dependencies: LucideArrowRightCn
   Source: original/blocks/dashboard/dashboard-sales-pipeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Sales Pipeline</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">Active deals across all stages</p>
            </div>
            <div class="flex items-center gap-4">
                <div class="text-right">
                    <p class="text-muted-foreground text-xs">Pipeline Value</p>
                    <p class="font-semibold text-sm tabular-nums">$481K</p>
                </div>
                <div class="text-right">
                    <p class="text-muted-foreground text-xs">Win Rate</p>
                    <p class="font-semibold text-sm tabular-nums">25%</p>
                </div>
            </div>
        </div>

        <div class="px-4 py-4">
            <div class="space-y-3">
                @for (var i = 0; i < _stages.Length; i++)
                            {
                    var stage = _stages[i];
                    var widthPercent = (int)((double)stage.Count / _stages[0].Count * 100);
                    var conversionRate = i < _stages.Length - 1
                        ? $"{(int)Math.Round((double)_stages[i + 1].Count / stage.Count * 100)}%"
                        : null;
                    <div>
                        <div class="mb-1.5 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@stage.Name</span>
                                <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">@stage.Count deals</span>
                            </div>
                            <span class="font-medium text-sm tabular-nums">@stage.Value</span>
                        </div>
                        <div class="h-8 w-full rounded bg-muted/50">
                            <div class="@($"flex h-full items-center rounded {stage.Color}")" style="@($"width: {widthPercent}%")">
                                <span class="px-2 font-medium text-white text-xs">@stage.Count</span>
                            </div>
                        </div>

                        @if (conversionRate != null)
                                    {
                            <div class="mt-1.5 flex items-center gap-1.5 pl-2">
                                <LucideArrowRightCn Size="12" Class="text-muted-foreground/60" />
                                <span class="text-muted-foreground text-xs">@conversionRate conversion</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record StageItem(string Name, int Count, string Value, string Color);

    private readonly StageItem[] _stages = [
        new("Lead", 24, "$186K", "bg-blue-500"),
        new("Qualified", 18, "$142K", "bg-indigo-500"),
        new("Proposal", 9, "$89K", "bg-violet-500"),
        new("Closed", 6, "$64K", "bg-emerald-500"),
    ];
}
