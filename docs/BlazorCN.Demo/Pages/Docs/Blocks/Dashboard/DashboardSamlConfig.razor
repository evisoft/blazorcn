@* ============================================================
   Block: dashboard-saml-config
   Title: Dashboard Saml Config
   Description: Animated React SAML SSO configuration status dashboard block for Next.js displaying identity provider details, certificate expiry, attribute mappings, login URL, metadata status, and expandable provider rows with connection test results using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: User role and permission management
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-saml-config.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideShieldCheckCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">SSO Configuration</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">SAML identity providers</p>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Add Provider
            </ButtonCn>
        </div>

        @* Summary metrics *@
        <div class="grid grid-cols-3 border-b">
            @for (var i = 0; i < _summaryMetrics.Length; i++)
            {
                var metric = _summaryMetrics[i];
                <div class="@(Cn.Merge("px-4 py-3", i < 2 ? "border-r" : ""))">
                    <p class="text-muted-foreground text-xs">@metric.Label</p>
                    <p class="@(Cn.Merge("mt-1 font-semibold text-lg tabular-nums", metric.Color))">
                        @metric.Value
                    </p>
                </div>
            }
        </div>

        @* Provider rows *@
        <div>
            @for (var i = 0; i < _providers.Length; i++)
            {
                var provider = _providers[i];
                var isExpanded = _expanded == provider.Id;
                var config = _statusConfig[provider.Status];
                var isLast = i == _providers.Length - 1;

                <div class="@(!isLast || isExpanded ? "border-b" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : provider.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", config.Dot))"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@provider.Name</span>
                                <span class="rounded bg-muted px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">
                                    @provider.Protocol
                                </span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @provider.ActiveUsers users &middot; cert @provider.CertExpiry
                            </p>
                        </div>
                        <span class="@(Cn.Merge("shrink-0 font-medium text-xs", GetCertColor(provider.CertDaysLeft)))">
                            @(provider.CertDaysLeft > 0 ? $"{provider.CertDaysLeft}d left" : "Expired")
                        </span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-3 px-4 pb-4 pl-9">
                                @* URLs *@
                                <div class="space-y-2">
                                    <div>
                                        <span class="text-muted-foreground text-xs">Entity ID</span>
                                        <p class="mt-0.5 truncate font-mono text-xs">@provider.EntityId</p>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground text-xs">SSO URL</span>
                                        <div class="mt-0.5 flex items-center gap-1.5">
                                            <p class="min-w-0 truncate font-mono text-xs">
                                                @provider.SsoUrl
                                            </p>
                                            <LucideExternalLinkCn Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                                        </div>
                                    </div>
                                </div>

                                @* Attribute mappings *@
                                <div class="rounded-md bg-muted/50 p-3">
                                    <span class="mb-2 block font-medium text-muted-foreground text-xs">
                                        Attribute Mappings
                                    </span>
                                    <div class="space-y-1.5">
                                        @foreach (var attr in provider.Attributes)
                                        {
                                            <div class="flex items-center gap-2 text-xs">
                                                <span class="min-w-0 flex-1 truncate font-mono text-muted-foreground">
                                                    @attr.SamlAttribute
                                                </span>
                                                <span class="text-muted-foreground">&rarr;</span>
                                                <span class="font-mono">@attr.AppField</span>
                                                @if (attr.Required)
                                                {
                                                    <span class="shrink-0 text-[10px] text-red-500">
                                                        required
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>

                                @* Test result *@
                                <div class="flex items-start gap-2 rounded-md bg-muted/50 p-3">
                                    @if (provider.Status == "error")
                                    {
                                        <LucideCircleXCn Size="14" Class="mt-0.5 size-3.5 shrink-0 text-red-500" />
                                    }
                                    else
                                    {
                                        <LucideCircleCheckCn Size="14" Class="mt-0.5 size-3.5 shrink-0 text-emerald-500" />
                                    }
                                    <div>
                                        <span class="font-medium text-muted-foreground text-xs">
                                            Connection test
                                        </span>
                                        <p class="mt-0.5 text-sm leading-relaxed">@provider.TestResult</p>
                                    </div>
                                </div>

                                @* Last login *@
                                <div class="flex items-center gap-3 text-muted-foreground text-xs">
                                    <span>Last login: @provider.LastLogin</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "sp1";

    private record SummaryMetric(string Label, string Value, string Color);
    private record AttributeMapping(string SamlAttribute, string AppField, bool Required);
    private record SamlProvider(string Id, string Name, string EntityId, string Status, string Protocol, string SsoUrl, string MetadataUrl, string CertExpiry, int CertDaysLeft, string LastLogin, int ActiveUsers, AttributeMapping[] Attributes, string TestResult);
    private record StatusConfig(string Dot, string Label);

    private static string GetCertColor(int days) =>
        days > 30 ? "text-emerald-600 dark:text-emerald-400" :
        days > 7 ? "text-amber-600 dark:text-amber-400" :
        "text-red-600 dark:text-red-400";

    private readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["connected"] = new StatusConfig("bg-emerald-500", "Connected"),
        ["error"] = new StatusConfig("bg-red-500", "Error"),
        ["pending"] = new StatusConfig("bg-amber-500", "Pending")
    };

    private readonly SummaryMetric[] _summaryMetrics = new[]
    {
        new SummaryMetric("Providers", "3", ""),
        new SummaryMetric("SSO Users", "482", ""),
        new SummaryMetric("SSO Login Rate", "94.2%", "text-emerald-600 dark:text-emerald-400")
    };

    private readonly SamlProvider[] _providers = new[]
    {
        new SamlProvider("sp1", "Okta", "https://acme.okta.com/app/exk2c9f8h1234567890", "connected", "SAML 2.0", "https://acme.okta.com/app/acmeapp/exk2c9f8h1234567890/sso/saml", "https://acme.okta.com/app/exk2c9f8h1234567890/sso/saml/metadata", "Sep 14, 2026", 180, "4 min ago", 312, new[]
        {
            new AttributeMapping("NameID", "email", true),
            new AttributeMapping("firstName", "given_name", true),
            new AttributeMapping("lastName", "family_name", true),
            new AttributeMapping("groups", "roles", false),
            new AttributeMapping("department", "team", false)
        }, "All checks passed. Response time: 142ms."),
        new SamlProvider("sp2", "Azure AD", "https://sts.windows.net/a1b2c3d4-e5f6-7890-abcd-ef1234567890/", "connected", "SAML 2.0", "https://login.microsoftonline.com/a1b2c3d4/saml2", "https://login.microsoftonline.com/a1b2c3d4/federationmetadata/2007-06/federationmetadata.xml", "Apr 2, 2026", 15, "12 min ago", 148, new[]
        {
            new AttributeMapping("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress", "email", true),
            new AttributeMapping("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/givenname", "given_name", true),
            new AttributeMapping("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/surname", "family_name", true),
            new AttributeMapping("http://schemas.microsoft.com/ws/2008/06/identity/claims/groups", "roles", false)
        }, "All checks passed. Response time: 238ms. Certificate expires in 15 days."),
        new SamlProvider("sp3", "Google Workspace", "https://accounts.google.com/o/saml2?idpid=C04a2b3c4d", "error", "SAML 2.0", "https://accounts.google.com/o/saml2/idp?idpid=C04a2b3c4d", "https://accounts.google.com/o/saml2/metadata?idpid=C04a2b3c4d", "Expired", -12, "3 days ago", 22, new[]
        {
            new AttributeMapping("NameID", "email", true),
            new AttributeMapping("firstName", "given_name", true),
            new AttributeMapping("lastName", "family_name", true)
        }, "Certificate validation failed: x509 certificate expired 12 days ago. Users cannot authenticate until the certificate is renewed.")
    };
}
