@* ============================================================
   Block: dashboard-log-volume
   Title: Dashboard Log Volume
   Description: Animated React log ingestion volume dashboard for Next.js with source breakdown, daily totals, hourly mini bar charts, log level distribution, and retention status using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Error rate tracking with trend indicators
   Dependencies: BadgeCn
   Source: original/blocks/dashboard/dashboard-log-volume.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideFileTextCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Log Volume</span>
            </div>
            <span class="text-muted-foreground text-xs">Today</span>
        </div>

        @* Summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="font-semibold text-2xl tabular-nums">@_totalVolume</span>
                <span class="text-muted-foreground text-xs">events</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_sources.Length sources
            </BadgeCn>
            <div class="ml-auto flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    error
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    warn
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    info
                </span>
            </div>
        </div>

        @* Source rows *@
        <div>
            @for (var i = 0; i < _sources.Length; i++)
            {
                var source = _sources[i];
                var isLast = i == _sources.Length - 1;
                var maxBar = source.HourlyBars.Max();

                <div class="@(Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : ""))">
                    <div class="flex items-center gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@source.Name</span>
                                <span class="rounded bg-muted px-1 py-0.5 text-[10px] text-muted-foreground">
                                    @source.Environment
                                </span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                Retention: @source.Retention
                            </p>
                        </div>

                        @* Level distribution *@
                        <div class="flex shrink-0 items-center gap-2">
                            <span class="flex items-center gap-1 text-[10px] tabular-nums text-red-600 dark:text-red-400">
                                @source.ErrorPercent%
                            </span>
                            <span class="flex items-center gap-1 text-[10px] tabular-nums text-amber-600 dark:text-amber-400">
                                @source.WarnPercent%
                            </span>
                        </div>

                        <span class="shrink-0 font-mono text-xs tabular-nums">
                            @source.DailyVolume
                        </span>
                    </div>

                    @* Hourly mini bars *@
                    <div class="mt-2 flex items-end gap-px">
                        @foreach (var bar in source.HourlyBars)
                        {
                            var height = maxBar > 0 ? (double)bar / maxBar * 16 : 0;
                            <div class="flex-1 rounded-sm bg-muted-foreground/20"
                                 style="@($"height: {height:F1}px")">
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record LogSource(string Id, string Name, string Environment, string DailyVolume, string Retention, int ErrorPercent, int WarnPercent, int InfoPercent, int[] HourlyBars);

    private const string _totalVolume = "148.3M";

    private readonly LogSource[] _sources = new[]
    {
        new LogSource("s1", "api-gateway", "production", "52.1M", "90 days", 2, 8, 90,
