@* ============================================================
   Block: dashboard-sprint-velocity
   Title: Dashboard Sprint Velocity
   Description: Animated React agile sprint velocity dashboard block for Next.js with velocity trend data, capacity utilization, story point burndown, sprint commitment versus completion metrics, and team performance using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Project milestone and progress tracking
   Dependencies: BadgeCn
   Source: original/blocks/dashboard/dashboard-sprint-velocity.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideBarChart3Cn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Sprint Velocity</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Avg velocity: @_avgVelocity pts/sprint
                    </p>
                </div>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_current.Name
            </BadgeCn>
        </div>

        @* Current sprint summary *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-4">
                <div>
                    <span class="block font-semibold text-2xl tabular-nums">@_current.Completed</span>
                    <span class="text-muted-foreground text-xs">of @_current.Committed pts</span>
                </div>
                <div class="h-8 w-px bg-border"></div>
                <div class="flex-1">
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">@_completionRate% complete</span>
                        <span class="text-muted-foreground">@(_current.DaysRemaining)d remaining</span>
                    </div>
                    <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-muted">
                        <div class="h-full rounded-full bg-foreground/20"
                             style="@($"width: {_completionRate}%")"></div>
                    </div>
                </div>
                <div class="shrink-0 text-right">
                    @if (_actualRemaining > _idealRemaining)
                    {
                        <span class="flex items-center gap-1 text-amber-600 text-xs dark:text-amber-400">
                            <LucideTrendingDownCn Size="12" Class="size-3" />
                            Behind
                        </span>
                    }
                    else
                    {
                        <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                            <LucideTrendingUpCn Size="12" Class="size-3" />
                            On track
                        </span>
                    }
                </div>
            </div>
        </div>

        @* Velocity chart (horizontal bars) *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Velocity trend
            </span>
            <div class="space-y-2">
                @for (var i = 0; i < _sprints.Length; i++)
                {
                    var sprint = _sprints[i];
                    var barWidth = (int)Math.Round((double)sprint.Completed / _maxCommitted * 100);
                    <div class="flex items-center gap-2">
                        <span class="w-16 shrink-0 text-muted-foreground text-xs">@sprint.Name</span>
                        <div class="h-4 flex-1 overflow-hidden rounded bg-muted">
                            <div class="@(Cn.Merge("h-full rounded", sprint.IsCurrent ? "bg-blue-500/60" : sprint.Completed >= sprint.Committed ? "bg-emerald-500/60" : "bg-foreground/15"))"
                                 style="@($"width: {barWidth}%")"></div>
                        </div>
                        <span class="w-8 shrink-0 text-right font-mono text-xs tabular-nums">
                            @sprint.Completed
                        </span>
                        @if (sprint.Carryover > 0)
                        {
                            <span class="w-10 shrink-0 text-right text-muted-foreground text-[10px]">
                                +@sprint.Carryover co
                            </span>
                        }
                        else
                        {
                            <span class="w-10 shrink-0"></span>
                        }
                    </div>
                }
            </div>
        </div>

        @* Team breakdown *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Team contribution \u2014 @_current.Name
            </span>
            <div class="space-y-1.5">
                @foreach (var member in _team)
                {
                    var memberPct = (int)Math.Round((double)member.PointsCompleted / member.PointsAssigned * 100);
                    <div class="flex items-center gap-2">
                        <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">
                            @member.Initials
                        </span>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground/20"
                                 style="@($"width: {memberPct}%")"></div>
                        </div>
                        <span class="w-12 shrink-0 text-right font-mono text-muted-foreground text-xs tabular-nums">
                            @member.PointsCompleted/@member.PointsAssigned
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Sprint(string Id, string Name, int Committed, int Completed, int Carryover, int DaysTotal, int DaysRemaining, bool IsCurrent);
    private record TeamMember(string Name, string Initials, int PointsCompleted, int PointsAssigned);

    private const int _avgVelocity = 36;
    private const int _maxCommitted = 44;

    private static readonly Sprint _current = _sprints[0];
    private static readonly int _completionRate = (int)Math.Round((double)_current.Completed / _current.Committed * 100);
    private static readonly int _idealRemaining = (int)Math.Round((double)_current.Committed * _current.DaysRemaining / _current.DaysTotal);
    private static readonly int _actualRemaining = _current.Committed - _current.Completed;

    private static readonly Sprint[] _sprints =
    [
        new("s1", "Sprint 24", 42, 18, 0, 10, 4, true),
        new("s2", "Sprint 23", 38, 35, 3, 10, 0, false),
        new("s3", "Sprint 22", 40, 40, 0, 10, 0, false),
        new("s4", "Sprint 21", 36, 32, 4, 10, 0, false),
        new("s5", "Sprint 20", 44, 38, 6, 10, 0, false),
        new("s6", "Sprint 19", 34, 34, 0, 10, 0, false),
    ];

    private static readonly TeamMember[] _team =
    [
        new("Sarah Chen", "SC", 5, 10),
        new("James Liu", "JL", 4, 8),
        new("Priya Sharma", "PS", 5, 11),
        new("Tom Bradley", "TB", 3, 8),
        new("Nina Kowalski", "NK", 1, 5),
    ];
}
