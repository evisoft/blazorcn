@* ============================================================
   Block: dashboard-campaign-roi
   Title: Dashboard Campaign Roi
   Description: Animated React marketing campaign ROI dashboard block for Next.js with six campaigns showing spend, revenue, ROI percentage with color-coded indicators, leads generated, and cost per acquisition metrics using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: KPI metrics with trend indicators
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-campaign-roi.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Campaign ROI</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Marketing performance across all active campaigns
            </p>
        </div>

        @* Summary stats *@
        <div class="flex items-center gap-6 border-b px-4 py-3">
            <div>
                <p class="text-muted-foreground text-xs">Total Spend</p>
                <span class="font-semibold text-lg tabular-nums">@FormatCurrency(_totalSpend)</span>
            </div>
            <div>
                <p class="text-muted-foreground text-xs">Total Revenue</p>
                <span class="font-semibold text-lg tabular-nums">@FormatCurrency(_totalRevenue)</span>
            </div>
            <div>
                <p class="text-muted-foreground text-xs">Overall ROI</p>
                <span class="@(Cn.Merge("font-semibold text-lg tabular-nums", _overallRoi >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400"))">
                    @(_overallRoi >= 0 ? "+" : "")@_overallRoi%
                </span>
            </div>
            <div>
                <p class="text-muted-foreground text-xs">Total Leads</p>
                <span class="font-semibold text-lg tabular-nums">@_totalLeads.ToString("N0")</span>
            </div>
        </div>

        @* Table header *@
        <div class="flex items-center gap-3 border-b bg-muted/30 px-4 py-2 text-muted-foreground text-xs">
            <span class="min-w-0 flex-1">Campaign</span>
            <span class="w-20 text-right">Spend</span>
            <span class="w-20 text-right">Revenue</span>
            <span class="w-16 text-right">ROI</span>
            <span class="w-16 text-right">Leads</span>
            <span class="w-16 text-right">CPA</span>
        </div>

        @* Campaign rows *@
        <div>
            @for (var i = 0; i < _campaigns.Length; i++)
            {
                var campaign = _campaigns[i];
                var roi = GetRoi(campaign.Spend, campaign.Revenue);
                var isBest = roi == _bestRoi;
                var isLast = i == _campaigns.Length - 1;
                var isPositive = roi >= 0;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-3", !isLast ? "border-b" : "", isBest ? "border-l-2 border-l-emerald-500 bg-emerald-500/5" : ""))">
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@campaign.Name</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@campaign.Channel</p>
                    </div>
                    <span class="w-20 text-right font-medium text-sm tabular-nums">
                        @FormatCurrency(campaign.Spend)
                    </span>
                    <span class="w-20 text-right font-medium text-sm tabular-nums">
                        @FormatCurrency(campaign.Revenue)
                    </span>
                    <span class="@(Cn.Merge("flex w-16 items-center justify-end gap-0.5 text-sm tabular-nums", isPositive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400"))">
                        @if (isPositive)
                        {
                            <LucideTrendingUpCn Class="size-3" />
                        }
                        else
                        {
                            <LucideTrendingDownCn Class="size-3" />
                        }
                        @(isPositive ? "+" : "")@roi%
                    </span>
                    <span class="w-16 text-right text-sm tabular-nums">
                        @campaign.Leads.ToString("N0")
                    </span>
                    <span class="w-16 text-right font-mono text-muted-foreground text-xs tabular-nums">
                        $@campaign.Cpa.ToString("F2")
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record CampaignItem(string Name, string Channel, int Spend, int Revenue, int Leads, double Cpa);

    private static string FormatCurrency(int value)
    {
        if (value >= 1000) return $"${value / 1000.0:F1}K";
        return $"${value:N0}";
    }

    private static int GetRoi(int spend, int revenue) =>
        (int)Math.Round((double)(revenue - spend) / spend * 100);

    private static readonly CampaignItem[] _campaigns =
    [
        new("Spring Product Launch", "Google Ads", 12400, 38200, 842, 14.73),
        new("Brand Awareness Push", "Meta Ads", 8600, 6100, 324, 26.54),
        new("Developer Newsletter", "Email", 2200, 14800, 1248, 1.76),
        new("Conference Sponsorship", "Events", 18000, 42600, 536, 33.58),
        new("Retargeting Campaign", "Google Ads", 4800, 16400, 612, 7.84),
        new("Influencer Partnership", "Social", 9200, 7400, 478, 19.25),
    ];

    private static readonly int _bestRoi = _campaigns.Max(c => GetRoi(c.Spend, c.Revenue));
    private static readonly int _totalSpend = _campaigns.Sum(c => c.Spend);
    private static readonly int _totalRevenue = _campaigns.Sum(c => c.Revenue);
    private static readonly int _totalLeads = _campaigns.Sum(c => c.Leads);
    private static readonly int _overallRoi = GetRoi(_totalSpend, _totalRevenue);
}
