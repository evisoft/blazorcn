                new SubPermission("Edit settings", new Dictionary<string, bool> { ["Owner"] = true, ["Admin"] = true, ["Editor"] = true, ["Viewer"] = false, ["Guest"] = false }),
                new SubPermission("Delete projects", new Dictionary<string, bool> { ["Owner"] = true, ["Admin"] = true, ["Editor"] = false, ["Viewer"] = false, ["Guest"] = false }),
