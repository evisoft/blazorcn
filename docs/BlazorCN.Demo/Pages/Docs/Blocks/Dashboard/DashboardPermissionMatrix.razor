@* ============================================================
   Block: dashboard-permission-matrix
   Title: Dashboard Permission Matrix
   Description: Animated React role permission matrix dashboard block for Next.js with a resource-by-role grid showing read write and admin toggles, color-coded access levels, expandable resource details, role column headers with user counts, and staggered entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Role summary with expandable permission lists
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-permission-matrix.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Permission Matrix</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">Resource access levels by role</p>
            </div>
            <div class="flex items-center gap-3 text-[10px]">
                <span class="flex items-center gap-1">
                    <span class="inline-flex size-4 items-center justify-center rounded bg-emerald-500/10 text-[8px] font-medium text-emerald-600 dark:text-emerald-400">
                        A
                    </span>
                    <span class="text-muted-foreground">Admin</span>
                </span>
                <span class="flex items-center gap-1">
                    <span class="inline-flex size-4 items-center justify-center rounded bg-amber-500/10 text-[8px] font-medium text-amber-600 dark:text-amber-400">
                        W
                    </span>
                    <span class="text-muted-foreground">Write</span>
                </span>
                <span class="flex items-center gap-1">
                    <span class="inline-flex size-4 items-center justify-center rounded bg-blue-500/10 text-[8px] font-medium text-blue-600 dark:text-blue-400">
                        R
                    </span>
                    <span class="text-muted-foreground">Read</span>
                </span>
            </div>
        </div>

        <div class="overflow-x-auto">
            <div class="min-w-[600px]">
                @* Column headers *@
                <div class="grid grid-cols-[1fr_repeat(5,56px)_28px] items-center border-b bg-muted/30 px-4 py-2">
                    <div class="flex items-center gap-1.5">
                        <span class="font-medium text-muted-foreground text-xs">Resource</span>
                        <span class="text-muted-foreground text-[10px]">(@_totalUsers users)</span>
                    </div>
                    @foreach (var role in _roles)
                    {
                        <div class="text-center">
                            <span class="block font-medium text-muted-foreground text-[10px]">
                                @role.Name
                            </span>
                            <span class="block text-muted-foreground/60 text-[8px] tabular-nums">
                                @role.UserCount
                            </span>
                        </div>
                    }
                    <div></div>
                </div>

                @* Resource rows *@
                <div>
                    @for (var i = 0; i < _resources.Length; i++)
                    {
                        var resource = _resources[i];
                        var isExpanded = _expanded == resource.Id;
                        var isLast = i == _resources.Length - 1;

                        <div class="@(isLast && !isExpanded ? "" : "border-b")">
                            <button
                                type="button"
                                @onclick="@(() => _expanded = isExpanded ? null : resource.Id)"
                                class="grid w-full grid-cols-[1fr_repeat(5,56px)_28px] items-center px-4 py-3 text-left transition-colors hover:bg-muted/50">
                                <div class="min-w-0 pr-2">
                                    <span class="font-medium text-sm">@resource.Name</span>
                                    <span class="ml-2 text-muted-foreground text-[10px]">
                                        @resource.Category
                                    </span>
                                </div>
                                @foreach (var role in _roles)
                                {
                                    var level = resource.Permissions[role.Name];
                                    var config = _accessConfig[level];
                                    <div class="flex justify-center">
                                        <span class="@(Cn.Merge("inline-flex size-6 items-center justify-center rounded text-[10px] font-medium", config.Bg, config.Text))">
                                            @config.Label
                                        </span>
                                    </div>
                                }
                                <div class="flex justify-center">
                                    <LucideChevronRightCn Class="@(Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                                </div>
                            </button>

                            @if (isExpanded)
                            {
                                <div class="overflow-hidden">
                                    <div class="px-4 pb-3">
                                        <div class="overflow-hidden rounded-md border">
                                            @for (var si = 0; si < resource.SubPermissions.Length; si++)
                                            {
                                                var sub = resource.SubPermissions[si];
                                                var isLastSub = si == resource.SubPermissions.Length - 1;
                                                <div class="@(Cn.Merge("grid grid-cols-[1fr_repeat(5,56px)] items-center px-3 py-2", !isLastSub ? "border-b" : ""))">
                                                    <span class="text-xs text-muted-foreground">
                                                        @sub.Action
                                                    </span>
                                                    @foreach (var role in _roles)
                                                    {
                                                        var granted = sub.Levels.ContainsKey(role.Name) && sub.Levels[role.Name];
                                                        <div class="flex justify-center">
                                                            <span class="@(Cn.Merge("size-1.5 rounded-full", granted ? "bg-emerald-500" : "bg-muted-foreground/20"))"></span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record RoleInfo(string Name, int UserCount);
    private record AccessConfig(string Label, string Bg, string Text);
    private record SubPermission(string Action, Dictionary<string, bool> Levels);
    private record ResourceData(string Id, string Name, string Category, Dictionary<string, string> Permissions, SubPermission[] SubPermissions);

    private int _totalUsers => _roles.Sum(r => r.UserCount);

    private readonly RoleInfo[] _roles = new[]
    {
