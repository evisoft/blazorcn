                new SubPermission("Manage plans", new Dictionary<string, bool> { ["Owner"] = true, ["Admin"] = true, ["Editor"] = false, ["Viewer"] = false, ["Guest"] = false }),
                new SubPermission("Update payment", new Dictionary<string, bool> { ["Owner"] = true, ["Admin"] = false, ["Editor"] = false, ["Viewer"] = false, ["Guest"] = false })
