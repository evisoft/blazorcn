        ["write"] = new AccessConfig("W", "bg-amber-500/10", "text-amber-600 dark:text-amber-400"),
        ["admin"] = new AccessConfig("A", "bg-emerald-500/10", "text-emerald-600 dark:text-emerald-400")
    };

    private readonly ResourceData[] _resources = new[]
    {
