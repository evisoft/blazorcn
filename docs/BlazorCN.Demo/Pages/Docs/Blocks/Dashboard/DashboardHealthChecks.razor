@* ============================================================
   Block: dashboard-health-checks
   Title: Dashboard Health Checks
   Description: Animated React service health checker dashboard block for Next.js with endpoint monitoring, response time tracking, status indicators, last-checked timestamps, and expandable row details using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Service uptime tracking with 30-day history
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-health-checks.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Health Checks</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_endpoints.Length monitored endpoints
                </p>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_endpoints.Count(e => e.Status == "healthy")
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_endpoints.Count(e => e.Status == "degraded")
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_endpoints.Count(e => e.Status == "down")
                </span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                    <LucideRefreshCwCn Size="12" Class="size-3" />
                    Check all
                </ButtonCn>
            </div>
        </div>

        @* Endpoints *@
        <div>
            @for (var i = 0; i < _endpoints.Length; i++)
            {
                var endpoint = _endpoints[i];
                var isExpanded = _expanded == endpoint.Id;
                var isLast = i == _endpoints.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : endpoint.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", _statusDot[endpoint.Status]))"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@endpoint.Name</span>
                            <p class="mt-0.5 truncate font-mono text-muted-foreground text-xs">
                                @endpoint.Url
                            </p>
                        </div>
                        <div class="flex shrink-0 items-center gap-4">
                            <span class="@(Cn.Merge("font-mono text-xs tabular-nums", GetResponseColor(endpoint.ResponseTime)))">
                                @(endpoint.Status == "down" ? "timeout" : $"{endpoint.ResponseTime}ms")
                            </span>
                            <span class="text-muted-foreground text-xs">
                                @_statusLabel[endpoint.Status]
                            </span>
                            <span class="text-muted-foreground text-[10px]">
                                @endpoint.LastChecked
                            </span>
                            <LucideChevronRightCn Class="@(Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="mb-2 block font-medium text-muted-foreground text-xs">
                                    Check configuration
                                </span>
                                <div class="grid grid-cols-2 gap-x-6 gap-y-1.5">
                                    <div class="flex items-center justify-between">
                                        <span class="text-muted-foreground text-xs">Method</span>
                                        <span class="font-mono text-xs">@endpoint.Method</span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-muted-foreground text-xs">Expected</span>
                                        <span class="font-mono text-xs tabular-nums">@endpoint.ExpectedStatus</span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-muted-foreground text-xs">Timeout</span>
                                        <span class="font-mono text-xs tabular-nums">@(endpoint.Timeout)s</span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-muted-foreground text-xs">Interval</span>
                                        <span class="font-mono text-xs tabular-nums">@endpoint.Interval</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record Endpoint(string Id, string Name, string Url, string Status, int ResponseTime, string LastChecked, string Method, int ExpectedStatus, int Timeout, string Interval);

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["healthy"] = "bg-emerald-500",
        ["degraded"] = "bg-amber-500",
        ["down"] = "bg-red-500",
    };

    private static readonly Dictionary<string, string> _statusLabel = new()
    {
        ["healthy"] = "Healthy",
        ["degraded"] = "Degraded",
        ["down"] = "Down",
    };

    private static string GetResponseColor(int ms)
    {
        if (ms == 0) return "text-red-600 dark:text-red-400";
        if (ms > 500) return "text-red-600 dark:text-red-400";
        if (ms > 200) return "text-amber-600 dark:text-amber-400";
        return "text-muted-foreground";
    }

    private static readonly Endpoint[] _endpoints =
    [
        new("ep1", "Auth Service", "/api/auth/health", "healthy", 42, "12 sec ago", "GET", 200, 5, "30s"),
        new("ep2", "Payment Gateway", "/api/payments/ping", "healthy", 128, "8 sec ago", "GET", 200, 10, "15s"),
        new("ep3", "Search Index", "/api/search/status", "degraded", 487, "22 sec ago", "GET", 200, 5, "30s"),
        new("ep4", "CDN Origin", "https://origin.cdn.acme.io/health", "healthy", 18, "5 sec ago", "HEAD", 200, 3, "10s"),
        new("ep5", "Database Primary", "/api/db/health", "healthy", 6, "15 sec ago", "GET", 200, 5, "15s"),
        new("ep6", "Email Service", "/api/email/ping", "down", 0, "45 sec ago", "GET", 200, 10, "30s"),
        new("ep7", "File Storage", "https://s3.us-east-1.amazonaws.com/health", "healthy", 94, "18 sec ago", "HEAD", 200, 5, "60s"),
    ];
}
