@* ============================================================
   Block: dashboard-ci-cd-pipeline
   Title: Dashboard Ci Cd Pipeline
   Description: Animated React CI/CD pipeline visualization block for Next.js with five build stages showing status indicators, duration timers, pulse animations for running stages, and pipeline progress using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Multi-environment deployment health
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-ci-cd-pipeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">CI/CD Pipeline</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    <span class="font-mono">feat/auth-redesign</span>
                    <span class="mx-1.5">·</span>
                    <span class="font-mono">a3f8c2d</span>
                </p>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs">
                    @_passedCount/@_stages.Length stages
                </span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs">7m 19s total</span>
            </div>
        </div>

        @* Pipeline progress dots *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-1">
                @for (var i = 0; i < _stages.Length; i++)
                {
                    var stage = _stages[i];
                    <div class="flex items-center">
                        <span class="@(Cn.Merge("block size-2.5 rounded-full", GetStatusDot(stage.Status)))"></span>
                        @if (i < _stages.Length - 1)
                        {
                            <div class="@(Cn.Merge("mx-1 h-px w-6 sm:w-10", stage.Status == "passed" ? "bg-emerald-500/40" : "bg-border"))"></div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Stage rows *@
        <div>
            @for (var i = 0; i < _stages.Length; i++)
            {
                var stage = _stages[i];
                var isLast = i == _stages.Length - 1;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b"))">
                    <LucideCircleDotCn Class="@(Cn.Merge("size-4 shrink-0", GetStatusText(stage.Status)))" />
                    <div class="min-w-0 flex-1">
                        <span class="@(Cn.Merge("font-medium text-sm", stage.Status == "pending" ? "text-muted-foreground" : ""))">
                            @stage.Name
                        </span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@stage.Description</p>
                    </div>
                    @if (stage.Status == "running")
                    {
                        <span class="text-blue-600 text-xs dark:text-blue-400">Running</span>
                    }
                    <span class="@(Cn.Merge("shrink-0 font-mono text-xs tabular-nums", stage.Status == "pending" ? "text-muted-foreground/50" : "text-muted-foreground"))">
                        @stage.Duration
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record PipelineStage(string Name, string Status, string Duration, string Description);

    private static string GetStatusDot(string status) => status switch
    {
        "passed" => "bg-emerald-500",
        "failed" => "bg-red-500",
        "running" => "bg-blue-500",
        "pending" => "bg-muted-foreground/30",
        _ => ""
    };

    private static string GetStatusText(string status) => status switch
    {
        "passed" => "text-emerald-600 dark:text-emerald-400",
        "failed" => "text-red-600 dark:text-red-400",
        "running" => "text-blue-600 dark:text-blue-400",
        "pending" => "text-muted-foreground",
        _ => ""
    };

    private static readonly PipelineStage[] _stages =
    [
        new("Build", "passed", "1m 24s", "Compile and bundle application"),
        new("Test", "passed", "3m 12s", "Run unit and integration tests"),
        new("Lint", "passed", "0m 38s", "Code quality and style checks"),
        new("Deploy", "running", "2m 05s", "Deploy to staging environment"),
        new("Verify", "pending", "\u2014", "Post-deploy health checks"),
    ];

    private static readonly int _passedCount = _stages.Count(s => s.Status == "passed");
}
