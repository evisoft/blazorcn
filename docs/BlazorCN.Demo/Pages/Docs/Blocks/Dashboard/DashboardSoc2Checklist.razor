@* ============================================================
   Block: dashboard-soc2-checklist
   Title: Dashboard Soc2 Checklist
   Description: Animated React SOC2 compliance checklist dashboard block for Next.js with trust service criteria, control status tracking, evidence links, owner assignments, and progress bars using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Threat score and vulnerability summary
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-soc2-checklist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideClipboardCheckCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">SOC 2 Checklist</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @_completedControls/@_totalControls controls complete
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_completeCount/@_criteria.Length criteria
                </span>
            </div>
        </div>

        @* Progress bar *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                    <div class="h-full rounded-full bg-emerald-500"
                         style="@($"width: {(int)Math.Round((double)_completedControls / _totalControls * 100)}%")"></div>
                </div>
                <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                    @((int)Math.Round((double)_completedControls / _totalControls * 100))%
                </span>
            </div>
        </div>

        @* Criteria *@
        <div>
            @for (var i = 0; i < _criteria.Length; i++)
            {
                var criterion = _criteria[i];
                var isExpanded = _expanded == criterion.Id;
                var isLast = i == _criteria.Length - 1;
                var config = _statusConfig[criterion.Status];
                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : criterion.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", config.Dot))"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-mono text-muted-foreground text-xs">
                                    @criterion.Code
                                </span>
                                <span class="font-medium text-sm">@criterion.Name</span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @criterion.Category
                                <span class="mx-1.5">\u00b7</span>
                                @criterion.Owner
                                <span class="mx-1.5">\u00b7</span>
                                Due @criterion.DueDate
                            </p>
                        </div>
                        <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                            @criterion.ControlsComplete/@criterion.ControlsTotal
                        </span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <div class="rounded-md bg-muted/50 p-3">
                                <p class="mb-3 text-sm leading-relaxed">@criterion.Notes</p>

                                @* Progress *@
                                <div class="mb-3 flex items-center gap-3">
                                    <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                                        <div class="@(Cn.Merge("h-full rounded-full", criterion.Status == "failed" ? "bg-red-500" : "bg-emerald-500"))"
                                             style="@($"width: {(int)Math.Round((double)criterion.ControlsComplete / criterion.ControlsTotal * 100)}%")"></div>
                                    </div>
                                    <span class="shrink-0 text-muted-foreground text-xs">
                                        @config.Label
                                    </span>
                                </div>

                                @* Evidence *@
                                @if (criterion.Evidence.Length > 0)
                                {
                                    <div class="border-t border-border/50 pt-3">
                                        <span class="mb-2 block font-medium text-muted-foreground text-xs">
                                            Evidence (@criterion.Evidence.Length)
                                        </span>
                                        <div class="space-y-1">
                                            @foreach (var ev in criterion.Evidence)
                                            {
                                                <div class="flex items-center gap-2 text-xs">
                                                    <span class="flex-1 truncate">@ev.Name</span>
                                                    <span class="font-mono text-muted-foreground">
                                                        @ev.Type
                                                    </span>
                                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-5 w-5 p-0">
                                                        <LucideExternalLinkCn Size="12" Class="size-3 text-muted-foreground" />
                                                    </ButtonCn>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "c3";

    private record Evidence(string Name, string Type);
    private record Criterion(string Id, string Code, string Name, string Category, string Status, int ControlsComplete, int ControlsTotal, string Owner, string DueDate, Evidence[] Evidence, string Notes);
    private record StatusConfig(string Dot, string Label);

    private static readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["complete"] = new("bg-emerald-500", "Complete"),
        ["in_progress"] = new("bg-amber-500", "In Progress"),
        ["not_started"] = new("bg-muted-foreground/30", "Not Started"),
        ["failed"] = new("bg-red-500", "Failed"),
    };

    private static readonly Criterion[] _criteria =
    [
        new("c1", "CC1.1", "Control Environment", "Security", "complete", 8, 8, "Elena Rossi", "Mar 30, 2026",
            [new("Code of Conduct Policy", "PDF"), new("Org Chart Export", "PNG"), new("Background Check Records", "CSV")],
            "All controls verified. Annual review completed on Mar 1."),
        new("c2", "CC2.1", "Communication & Information", "Security", "complete", 6, 6, "Marcus Webb", "Mar 30, 2026",
            [new("Internal Communications Policy", "PDF"), new("Incident Notification Procedure", "PDF")],
            "Updated communication procedures approved by leadership."),
        new("c3", "CC3.1", "Risk Assessment", "Security", "in_progress", 4, 7, "Sarah Chen", "Apr 15, 2026",
            [new("Risk Register 2026", "XLSX"), new("Threat Model Diagrams", "PDF")],
            "Three controls pending: vendor risk assessment, data flow diagrams, and risk treatment plan update."),
        new("c4", "CC6.1", "Logical & Physical Access", "Security", "in_progress", 9, 12, "James Liu", "Apr 15, 2026",
            [new("IAM Policy Configuration", "JSON"), new("Access Review Log", "CSV"), new("MFA Enrollment Report", "PDF")],
            "Remaining: quarterly access review for contractors, physical access log audit, and SSH key rotation evidence."),
        new("c5", "CC7.1", "System Operations", "Security", "not_started", 0, 9, "Tom Bradley", "May 1, 2026",
            [],
            "Scheduled to begin after CC6.1 completion. Requires monitoring dashboards, incident response runbooks, and change management documentation."),
        new("c6", "A1.1", "Availability Commitments", "Availability", "in_progress", 3, 5, "Priya Sharma", "Apr 30, 2026",
            [new("SLA Agreements", "PDF"), new("Uptime Reports Q1 2026", "PDF")],
            "Need disaster recovery test results and capacity planning documentation."),
        new("c7", "CC8.1", "Change Management", "Security", "failed", 5, 8, "Daniel Park", "Mar 25, 2026",
            [new("Change Request Process", "PDF"), new("PR Review Statistics", "CSV")],
            "Failed: missing evidence for emergency change procedures, rollback documentation, and change approval matrix."),
    ];
    private static readonly int _completedControls = _criteria.Sum(c => c.ControlsComplete);

    private static readonly int _totalControls = _criteria.Sum(c => c.ControlsTotal);
    private static readonly int _completeCount = _criteria.Count(c => c.Status == "complete");
}
