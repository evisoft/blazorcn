@* ============================================================
   Block: dashboard-seo-metrics
   Title: Dashboard Seo Metrics
   Description: Animated React SEO performance dashboard block for Next.js with domain authority score, organic traffic, keyword rankings, backlinks count, and top keyword position tracking with change arrows using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: KPI metric cards with trend indicators
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-seo-metrics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">SEO Performance</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Search visibility and keyword rankings
            </p>
        </div>

        <div class="grid grid-cols-2 border-b">
            @for (var i = 0; i < _metrics.Length; i++)
            {
                var metric = _metrics[i];
                <div class="@(Cn.Merge("px-4 py-3", i < 2 ? "border-b" : "", i % 2 == 0 ? "border-r" : ""))">
                    <p class="text-muted-foreground text-xs">@metric.Label</p>
                    <span class="font-semibold text-2xl tabular-nums">@metric.Value</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">@metric.Subtext</p>
                </div>
            }
        </div>

        <div class="border-b px-4 py-2">
            <span class="font-medium text-muted-foreground text-xs">Top Keywords</span>
        </div>

        <div class="hidden border-b px-4 py-2 sm:grid sm:grid-cols-[1fr_60px_60px_60px]">
            <span class="text-muted-foreground text-xs">Keyword</span>
            <span class="text-right text-muted-foreground text-xs">Position</span>
            <span class="text-right text-muted-foreground text-xs">Change</span>
            <span class="text-right text-muted-foreground text-xs">Volume</span>
        </div>

        <div>
            @for (var i = 0; i < _keywords.Length; i++)
            {
                var kw = _keywords[i];
                var isLast = i == _keywords.Length - 1;
                <div class="@(Cn.Merge("grid items-center gap-2 px-4 py-2.5 transition-colors hover:bg-muted/50 sm:grid-cols-[1fr_60px_60px_60px]", !isLast ? "border-b" : ""))">
                    <span class="font-medium text-sm">@kw.Keyword</span>
                    <span class="text-right font-semibold text-sm tabular-nums">#@kw.Position</span>
                    <span class="flex items-center justify-end gap-0.5 text-xs">
                        @if (kw.Change > 0)
                        {
                            <span class="flex items-center gap-0.5 text-emerald-600 dark:text-emerald-400">
                                <LucideArrowUpCn Size="12" Class="size-3" />
                                @kw.Change
                            </span>
                        }
                        else if (kw.Change < 0)
                        {
                            <span class="flex items-center gap-0.5 text-red-600 dark:text-red-400">
                                <LucideArrowDownCn Size="12" Class="size-3" />
                                @Math.Abs(kw.Change)
                            </span>
                        }
                        else
                        {
                            <span class="text-muted-foreground">
                                <LucideMinusCn Size="12" Class="size-3" />
                            </span>
                        }
                    </span>
                    <span class="text-right text-muted-foreground text-xs tabular-nums">
                        @kw.Volume
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record SeoMetric(string Label, string Value, string Subtext);
    private record KeywordData(string Id, string Keyword, int Position, int Change, string Volume);

    private readonly SeoMetric[] _metrics = new[]
    {
        new SeoMetric("Domain Authority", "72", "+3 this month"),
        new SeoMetric("Organic Traffic", "48.2K", "Monthly visits"),
        new SeoMetric("Keywords Ranked", "1,847", "Top 100 positions"),
        new SeoMetric("Backlinks", "12.6K", "From 934 domains")
    };

    private readonly KeywordData[] _keywords = new[]
    {
        new KeywordData("1", "react dashboard components", 3, 2, "2.4K"),
        new KeywordData("2", "nextjs ui library", 5, -1, "4.1K"),
        new KeywordData("3", "tailwind dashboard template", 8, 4, "6.8K"),
        new KeywordData("4", "shadcn blocks", 1, 0, "1.9K"),
        new KeywordData("5", "react admin panel", 12, -3, "8.2K"),
        new KeywordData("6", "nextjs landing page", 6, 1, "3.7K")
    };
}
