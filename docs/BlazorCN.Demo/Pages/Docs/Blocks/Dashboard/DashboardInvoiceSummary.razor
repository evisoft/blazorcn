@* ============================================================
   Block: dashboard-invoice-summary
   Title: Dashboard Invoice Summary
   Description: Animated React invoice summary dashboard block for Next.js with total outstanding, overdue, and paid metrics, three status groups with counts and totals, and staggered entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: KPI metrics with trend indicators
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-invoice-summary.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Invoice Summary</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Outstanding balances and payment status
            </p>
        </div>

        @* Metrics *@
        <div class="grid grid-cols-4 border-b">
            @for (var mi = 0; mi < _metrics.Length; mi++)
            {
                var metric = _metrics[mi];
                <div class="@(Cn.Merge("px-4 py-3", mi < 3 ? "border-r" : ""))">
                    <p class="text-muted-foreground text-xs">@metric.Label</p>
                    <span class="@(Cn.Merge("font-semibold text-lg tabular-nums", metric.Color ?? ""))">
                        @metric.Value
                    </span>
                </div>
            }
        </div>

        @* Status groups *@
        <div>
            @for (var gi = 0; gi < _grouped.Length; gi++)
            {
                var group = _grouped[gi];
                var config = _statusConfig[group.Status];
                var isExpanded = _expandedGroup == group.Status;
                var isLastGroup = gi == _grouped.Length - 1;

                <div class="@(!isLastGroup || isExpanded ? "border-b" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _expandedGroup = isExpanded ? null : group.Status)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", config.Dot))"></span>
                        <span class="font-medium text-sm">@config.Label</span>
                        <span class="rounded-full bg-muted/50 px-1.5 py-0.5 text-muted-foreground text-xs tabular-nums">
                            @group.Items.Length
                        </span>
                        <span class="@(Cn.Merge("ml-auto text-sm tabular-nums", config.TextColor))">
                            @FormatAmount(group.Total)
                        </span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div>
                            @for (var ii = 0; ii < group.Items.Length; ii++)
                            {
                                var invoice = group.Items[ii];
                                var isLastInvoice = ii == group.Items.Length - 1;

                                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-2.5 pl-9", !isLastInvoice ? "border-b" : ""))">
                                    <div class="min-w-0 flex-1">
                                        <span class="text-sm">@invoice.Client</span>
                                        <p class="mt-0.5 font-mono text-muted-foreground text-xs">
                                            @invoice.InvoiceNumber
                                        </p>
                                    </div>
                                    <span class="text-muted-foreground text-xs">@invoice.DueDate</span>
                                    <span class="w-16 text-right font-medium text-sm tabular-nums">
                                        $@invoice.Amount.ToString("N0")
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expandedGroup = "overdue";

    private record InvoiceData(string Id, string Client, int Amount, string Status, string DueDate, string InvoiceNumber);
    private record StatusConfig(string Label, string Dot, string TextColor);
    private record GroupedData(string Status, InvoiceData[] Items, int Total);
    private record MetricData(string Label, string Value, string? Color = null);

    private static string FormatAmount(int value)
    {
        if (value >= 1000) return $"${value / 1000.0:F1}K";
        return $"${value:N0}";
    }

    private readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["overdue"] = new StatusConfig("Overdue", "bg-red-500", "text-red-600 dark:text-red-400"),
        ["due-soon"] = new StatusConfig("Due Soon", "bg-amber-500", "text-amber-600 dark:text-amber-400"),
        ["paid"] = new StatusConfig("Paid", "bg-emerald-500", "text-emerald-600 dark:text-emerald-400")
    };

    private readonly InvoiceData[] _invoices = new[]
    {
        new InvoiceData("1", "Acme Corp", 4200, "overdue", "Feb 28", "INV-1042"),
        new InvoiceData("2", "Globex Inc", 1800, "overdue", "Mar 2", "INV-1038"),
        new InvoiceData("3", "Stark Industries", 2200, "overdue", "Mar 5", "INV-1045"),
        new InvoiceData("4", "Wayne Enterprises", 6400, "due-soon", "Mar 20", "INV-1051"),
        new InvoiceData("5", "Umbrella Corp", 3100, "due-soon", "Mar 22", "INV-1053"),
        new InvoiceData("6", "Cyberdyne Systems", 8900, "due-soon", "Mar 24", "INV-1055"),
        new InvoiceData("7", "Initech", 5200, "due-soon", "Mar 25", "INV-1056"),
        new InvoiceData("8", "Weyland-Yutani", 12400, "paid", "Mar 8", "INV-1032"),
        new InvoiceData("9", "Soylent Corp", 7800, "paid", "Mar 5", "INV-1029"),
        new InvoiceData("10", "Massive Dynamic", 9600, "paid", "Mar 10", "INV-1035"),
        new InvoiceData("11", "Oscorp", 12200, "paid", "Mar 12", "INV-1037")
    };

    private GroupedData[] _grouped => new[] { "overdue", "due-soon", "paid" }
        .Select(status => new GroupedData(
            status,
            _invoices.Where(i => i.Status == status).ToArray(),
            _invoices.Where(i => i.Status == status).Sum(i => i.Amount)))
        .ToArray();

    private MetricData[] _metrics => new[]
    {
        new MetricData("Outstanding", FormatAmount(_invoices.Where(i => i.Status != "paid").Sum(i => i.Amount))),
        new MetricData("Overdue", FormatAmount(_invoices.Where(i => i.Status == "overdue").Sum(i => i.Amount)), "text-red-600 dark:text-red-400"),
        new MetricData("Paid This Month", FormatAmount(_invoices.Where(i => i.Status == "paid").Sum(i => i.Amount)), "text-emerald-600 dark:text-emerald-400"),
        new MetricData("Avg Payment", "18 days")
    };
}
