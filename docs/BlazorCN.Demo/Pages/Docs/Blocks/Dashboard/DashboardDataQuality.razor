@* ============================================================
   Block: dashboard-data-quality
   Title: Dashboard Data Quality
   Description: Animated React data quality dashboard block for Next.js displaying overall quality score, dimension breakdowns for completeness accuracy consistency and timeliness with progress bars, and recent data quality issues with severity indicators using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Cache metrics with hit rates and key distribution
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-data-quality.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Data Quality</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Quality scores across four dimensions
            </p>
        </div>

        @* Overall score *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-xs">Overall Score</p>
            <div class="mt-1 flex items-baseline gap-1">
                <span class="@(Cn.Merge("font-semibold text-2xl tabular-nums", _scoreColor))">
                    @_overallScore
                </span>
                <span class="text-muted-foreground text-xs">/100</span>
            </div>
        </div>

        @* Dimension bars *@
        <div class="border-b px-4 py-3">
            <p class="mb-3 font-medium text-muted-foreground text-xs">Dimensions</p>
            <div class="space-y-3">
                @foreach (var dim in _dimensions)
                {
                    <div>
                        <div class="mb-1 flex items-center justify-between">
                            <span class="text-sm">@dim.Label</span>
                            <span class="font-medium text-sm tabular-nums">@(dim.Score)%</span>
                        </div>
                        <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted/50">
                            <div class="h-full rounded-full bg-foreground/20"
                                 style="@($"width: {dim.Score}%")">
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Recent issues *@
        <div>
            <div class="border-b px-4 py-2">
                <p class="font-medium text-muted-foreground text-xs">Recent Issues</p>
            </div>
            @for (var i = 0; i < _issues.Length; i++)
            {
                var issue = _issues[i];
                var isLast = i == _issues.Length - 1;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b"))">
                    <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", issue.Severity == "critical" ? "bg-red-500" : "bg-amber-500"))"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@issue.IssueType</span>
                        <p class="mt-0.5 font-mono text-muted-foreground text-xs">@issue.Field</p>
                    </div>
                    <span class="shrink-0 text-muted-foreground text-xs tabular-nums">
                        @issue.AffectedRecords.ToString("N0") records
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Dimension(string Label, int Score);
    private record Issue(string Field, string IssueType, int AffectedRecords, string Severity);

    private const int _overallScore = 87;
    private const string _scoreColor = "text-amber-600 dark:text-amber-400";

    private static readonly Dimension[] _dimensions =
    [
        new("Completeness", 92),
        new("Accuracy", 88),
        new("Consistency", 84),
        new("Timeliness", 91),
    ];

    private static readonly Issue[] _issues =
    [
        new("customer.email", "Format violation", 234, "critical"),
        new("order.shipping_date", "Null values", 1089, "critical"),
        new("product.category_id", "Orphaned reference", 47, "warning"),
        new("invoice.currency", "Inconsistent values", 18, "warning"),
    ];
}
