@* ============================================================
   Block: dashboard-page-speed
   Title: Dashboard Page Speed
   Description: Animated React Core Web Vitals dashboard block for Next.js with LCP, FID, CLS, and INP metrics showing pass fail status, page-level breakdowns with expandable rows, animated score bars, and staggered entrance using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Lighthouse performance scores overview
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-page-speed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Page Speed</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Core Web Vitals — 75th percentile
                </p>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="@(Cn.Merge("size-1.5 rounded-full", _goodCount >= 3 ? "bg-emerald-500" : "bg-amber-500"))"></span>
                <span class="text-muted-foreground text-xs">@_goodCount/4 passing</span>
            </div>
        </div>

        <div>
            @for (var i = 0; i < _vitals.Length; i++)
            {
                var vital = _vitals[i];
                var isExpanded = _expanded == vital.Id;
                var config = _statusConfig[vital.Status];
                var isLast = i == _vitals.Length - 1;

                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : vital.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", config.Dot))"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-mono font-medium text-sm">@vital.Name</span>
                                <span class="text-muted-foreground text-xs">@vital.FullName</span>
                            </div>
                        </div>
                        <div class="flex shrink-0 items-center gap-2">
                            <span class="@(Cn.Merge("font-semibold text-lg tabular-nums", config.Color))">
                                @vital.Value
                            </span>
                            <span class="text-muted-foreground text-xs">@vital.Unit</span>
                        </div>
                        <div class="w-16 shrink-0">
                            <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                                <div class="@(Cn.Merge("h-full rounded-full", config.Dot))"
                                     style="@($"width: {vital.Percentile}%")">
                                </div>
                            </div>
                        </div>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-3">
                                <div class="mb-2 flex items-center justify-between">
                                    <span class="text-muted-foreground text-xs">Page-level breakdown</span>
                                    <span class="text-muted-foreground text-xs">Threshold: @vital.Threshold</span>
                                </div>
                                <div class="overflow-hidden rounded-md border">
                                    @for (var pi = 0; pi < vital.Pages.Length; pi++)
                                    {
                                        var pg = vital.Pages[pi];
                                        var pgConfig = _statusConfig[pg.Status];
                                        <div class="@(Cn.Merge("flex items-center gap-3 px-3 py-2", pi < vital.Pages.Length - 1 ? "border-b" : ""))">
                                            <LucideGlobeCn Size="12" Class="size-3 shrink-0 text-muted-foreground/50" />
                                            <span class="min-w-0 flex-1 truncate font-mono text-xs">@pg.Path</span>
                                            <span class="shrink-0 text-muted-foreground text-[10px] tabular-nums">
                                                @pg.Samples samples
                                            </span>
                                            <span class="@(Cn.Merge("shrink-0 font-mono text-xs font-medium tabular-nums", pgConfig.Color))">
                                                @pg.Value
                                            </span>
                                            <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", pgConfig.Dot))"></span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record PageBreakdown(string Path, string Value, string Status, string Samples);
    private record WebVital(string Id, string Name, string FullName, string Value, string Unit, string Status, string Threshold, int Percentile, PageBreakdown[] Pages);
    private record StatusConfig(string Color, string Dot, string Label);

    private int _goodCount => _vitals.Count(v => v.Status == "good");

    private readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["good"] = new StatusConfig("text-emerald-600 dark:text-emerald-400", "bg-emerald-500", "Good"),
        ["needs-improvement"] = new StatusConfig("text-amber-600 dark:text-amber-400", "bg-amber-500", "Needs Work"),
        ["poor"] = new StatusConfig("text-red-600 dark:text-red-400", "bg-red-500", "Poor")
    };

    private readonly WebVital[] _vitals = new[]
    {
        new WebVital("lcp", "LCP", "Largest Contentful Paint", "1.8", "s", "good", "< 2.5s", 72, new[]
        {
            new PageBreakdown("/", "1.2s", "good", "14,230"),
            new PageBreakdown("/pricing", "1.6s", "good", "8,412"),
            new PageBreakdown("/docs/getting-started", "2.1s", "good", "6,891"),
            new PageBreakdown("/blog/announcing-v3", "3.4s", "poor", "3,204")
        }),
        new WebVital("fid", "FID", "First Input Delay", "12", "ms", "good", "< 100ms", 94, new[]
        {
            new PageBreakdown("/", "8ms", "good", "14,230"),
            new PageBreakdown("/dashboard", "45ms", "good", "5,102"),
            new PageBreakdown("/search", "89ms", "good", "7,654"),
            new PageBreakdown("/editor", "142ms", "poor", "2,891")
        }),
        new WebVital("cls", "CLS", "Cumulative Layout Shift", "0.08", "", "good", "< 0.1", 78, new[]
        {
            new PageBreakdown("/", "0.02", "good", "14,230"),
            new PageBreakdown("/pricing", "0.05", "good", "8,412"),
            new PageBreakdown("/blog", "0.14", "needs-improvement", "9,302"),
            new PageBreakdown("/changelog", "0.28", "poor", "4,105")
        }),
        new WebVital("inp", "INP", "Interaction to Next Paint", "180", "ms", "needs-improvement", "< 200ms", 56, new[]
        {
            new PageBreakdown("/", "120ms", "good", "14,230"),
            new PageBreakdown("/dashboard", "210ms", "poor", "5,102"),
            new PageBreakdown("/settings", "185ms", "needs-improvement", "3,890"),
            new PageBreakdown("/editor", "340ms", "poor", "2,891")
        })
    };
}
