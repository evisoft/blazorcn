@* ============================================================
   Block: dashboard-goal-tracking
   Title: Dashboard Goal Tracking
   Description: Animated React OKR and goal tracking dashboard block for Next.js with four objectives showing key result progress bars with spring animations, percentage completion, status chips for on track and at risk and behind and completed states, owner initials, and due dates using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: KPI metrics with trend indicators
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-goal-tracking.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Goal Tracking</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Q1 2026 objectives and key results
                </p>
            </div>
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                <span>
                    @_completedCount/@_goals.Length completed
                </span>
                <span class="tabular-nums">@_overallProgress% overall</span>
            </div>
        </div>

        @* Goals *@
        <div>
            @for (var i = 0; i < _goals.Length; i++)
            {
                var goal = _goals[i];
                var config = _statusConfig[goal.Status];
                var isExpanded = _expanded == goal.Id;
                var isLast = i == _goals.Length - 1;

                <div class="@(!isLast ? "border-b" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : goal.Id)"
                        class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <LucideChevronRightCn Class="@(Cn.Merge("mt-0.5 size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@goal.Name</span>
                            </div>
                            <div class="mt-2 flex items-center gap-3">
                                <div class="relative h-2 flex-1 overflow-hidden rounded-full bg-muted/50">
                                    <div class="@(Cn.Merge("absolute inset-y-0 left-0 rounded-full", config.BarColor))"
                                         style="@($"width: {goal.Progress}%")">
                                    </div>
                                </div>
                                <span class="w-8 text-right text-xs tabular-nums text-muted-foreground">
                                    @goal.Progress%
                                </span>
                            </div>
                            <div class="mt-2 flex items-center gap-2">
                                <span class="@(Cn.Merge("rounded px-1.5 py-0.5 text-xs", config.ClassName))">
                                    @config.Label
                                </span>
                                <span class="flex size-5 items-center justify-center rounded-full bg-muted/50 text-muted-foreground text-xs">
                                    @goal.Initials
                                </span>
                                <span class="text-muted-foreground text-xs">Due @goal.DueDate</span>
                            </div>
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-11">
                            <p class="mb-2 font-medium text-muted-foreground text-xs">Key Results</p>
                            <div class="space-y-2">
                                @foreach (var kr in goal.KeyResults)
                                {
                                    <div class="flex items-center gap-3">
                                        <span class="min-w-0 flex-1 truncate text-xs">@kr.Title</span>
                                        <div class="relative h-1.5 w-20 overflow-hidden rounded-full bg-muted/50">
                                            <div class="@(Cn.Merge("absolute inset-y-0 left-0 rounded-full", config.BarColor))"
                                                 style="@($"width: {kr.Progress}%")">
                                            </div>
                                        </div>
                                        <span class="w-7 text-right text-muted-foreground text-xs tabular-nums">
                                            @kr.Progress%
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "1";

    private record KeyResult(string Title, int Progress);
    private record GoalData(string Id, string Name, int Progress, string Status, string Owner, string Initials, string DueDate, KeyResult[] KeyResults);
    private record StatusConfig(string Label, string ClassName, string BarColor);

    private int _completedCount => _goals.Count(g => g.Status == "completed");
    private int _overallProgress => (int)Math.Round(_goals.Average(g => g.Progress));

    private readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["on-track"] = new StatusConfig("On Track", "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400", "bg-emerald-500"),
        ["at-risk"] = new StatusConfig("At Risk", "bg-amber-500/10 text-amber-600 dark:text-amber-400", "bg-amber-500"),
        ["behind"] = new StatusConfig("Behind", "bg-red-500/10 text-red-600 dark:text-red-400", "bg-red-500"),
        ["completed"] = new StatusConfig("Completed", "bg-blue-500/10 text-blue-600 dark:text-blue-400", "bg-blue-500")
    };

    private readonly GoalData[] _goals = new[]
    {
        new GoalData("1", "Increase monthly recurring revenue to $100K", 78, "on-track", "Sarah Chen", "SC", "Mar 31", new[]
        {
            new KeyResult("Close 15 enterprise deals", 80),
            new KeyResult("Reduce churn rate to under 3%", 72),
            new KeyResult("Launch annual pricing tier", 100)
        }),
        new GoalData("2", "Ship v3.0 platform redesign", 45, "at-risk", "Alex Rivera", "AR", "Apr 15", new[]
        {
            new KeyResult("Complete new design system", 68),
            new KeyResult("Migrate all pages to new layout", 32),
            new KeyResult("Pass accessibility audit", 40)
        }),
        new GoalData("3", "Achieve 50K monthly active users", 28, "behind", "Jordan Kim", "JK", "Apr 30", new[]
        {
            new KeyResult("Launch referral program", 15),
            new KeyResult("Publish 20 SEO content pieces", 45),
            new KeyResult("Reach 5K organic signups/month", 22)
        }),
        new GoalData("4", "Improve customer satisfaction to 4.8 stars", 100, "completed", "Maya Patel", "MP", "Feb 28", new[]
        {
            new KeyResult("Reduce average response time to under 2 hours", 100),
            new KeyResult("Resolve 95% of tickets on first contact", 100),
            new KeyResult("Launch self-service knowledge base", 100)
        })
    };
}
