@* ============================================================
   Block: dashboard-data-retention
   Title: Dashboard Data Retention
   Description: Animated React data retention policy management dashboard block for Next.js with storage age tracking, automated purge schedules, compliance status indicators, and retention tier breakdown using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Disk space breakdown with stacked segments
   Dependencies: BadgeCn
   Source: original/blocks/dashboard/dashboard-data-retention.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideDatabaseCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Data Retention</span>
            </div>
            @if (_overdueCount > 0)
            {
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-red-600 text-xs dark:text-red-400">
                    @_overdueCount overdue
                </BadgeCn>
            }
        </div>

        @* Summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div>
                <p class="text-muted-foreground text-xs">Total Storage</p>
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-2xl tabular-nums">303.6</span>
                    <span class="text-muted-foreground text-xs">GB</span>
                </div>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">Policies</p>
                <p class="font-semibold text-sm tabular-nums">@_policies.Length</p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">Overdue</p>
                <p class="font-semibold text-sm tabular-nums text-red-600 dark:text-red-400">
                    @_overdueCount
                </p>
            </div>
        </div>

        @* Policies list *@
        <div>
            @for (var i = 0; i < _policies.Length; i++)
            {
                var policy = _policies[i];
                var isExpanded = _expanded == policy.Id;
                var isLast = i == _policies.Length - 1;
                var agePercent = Math.Min((double)policy.CurrentAgeDays / policy.RetentionDays * 100, 100);

                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : policy.Id)"
                        class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", GetStatusDot(policy.Status)))"></span>
                        <span class="min-w-0 flex-1 font-medium text-sm">@policy.Category</span>
                        @if (policy.Regulation != null)
                        {
                            <span class="shrink-0 rounded bg-muted/50 px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">
                                @policy.Regulation
                            </span>
                        }
                        <div class="h-1.5 w-16 shrink-0 overflow-hidden rounded-full bg-muted/50">
                            <div class="@(Cn.Merge("h-full rounded-full", GetAgeBarColor(policy.CurrentAgeDays, policy.RetentionDays)))"
                                 style="@($"width: {agePercent:F0}%")">
                            </div>
                        </div>
                        <span class="w-14 shrink-0 text-right text-muted-foreground text-xs tabular-nums">
                            @(policy.StorageGb) GB
                        </span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-2 px-4 pb-4 pt-1">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <div class="grid grid-cols-2 gap-y-2 text-xs">
                                        <div>
                                            <span class="text-muted-foreground">Retention limit</span>
                                            <p class="font-medium tabular-nums">
                                                @(policy.RetentionDays >= 365 ? $"{policy.RetentionDays / 365} years" : $"{policy.RetentionDays} days")
                                            </p>
                                        </div>
                                        <div>
                                            <span class="text-muted-foreground">Current age</span>
                                            <p class="font-medium tabular-nums">@policy.CurrentAgeDays days</p>
                                        </div>
                                        <div>
                                            <span class="text-muted-foreground">Records</span>
                                            <p class="font-medium tabular-nums">@policy.RecordCount</p>
                                        </div>
                                        <div>
                                            <span class="text-muted-foreground">Storage</span>
                                            <p class="font-medium tabular-nums">@(policy.StorageGb) GB</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3 text-xs">
                                    <LucideTrashCn Size="12" Class="size-3 text-muted-foreground" />
                                    <span class="text-muted-foreground">Next purge:</span>
                                    <span class="@(Cn.Merge("font-medium", policy.Status == "overdue" ? "text-red-600 dark:text-red-400" : ""))">
                                        @policy.NextPurge
                                    </span>
                                    <span class="text-muted-foreground">·</span>
                                    <span class="text-muted-foreground">Last: @policy.LastPurge</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "5";

    private record RetentionPolicy(string Id, string Category, int RetentionDays, int CurrentAgeDays, double StorageGb, string NextPurge, string LastPurge, string RecordCount, string Status, string? Regulation);

    private static string GetStatusDot(string status)
    {
        if (status == "compliant") return "bg-emerald-500";
        if (status == "warning") return "bg-amber-500";
        return "bg-red-500";
    }

    private static string GetAgeBarColor(int current, int max)
    {
        var ratio = (double)current / max;
        if (ratio >= 0.9) return "bg-red-500";
        if (ratio >= 0.75) return "bg-amber-500";
        return "bg-foreground/20";
    }

    private static readonly int _overdueCount = 1;

    private static readonly RetentionPolicy[] _policies =
    [
        new("1", "User sessions", 90, 84, 12.4, "Tomorrow, 2:00 AM", "Mar 10, 2:00 AM", "24.8M", "warning", "GDPR"),
        new("2", "Audit logs", 2555, 1420, 89.2, "Apr 1, 3:00 AM", "Mar 1, 3:00 AM", "142.6M", "compliant", "SOC 2"),
        new("3", "API request logs", 30, 28, 34.8, "Mar 20, 1:00 AM", "Mar 17, 1:00 AM", "890.2M", "warning", null),
        new("4", "Payment records", 2555, 980, 8.1, "N/A (archival)", "Never", "3.2M", "compliant", "PCI DSS"),
        new("5", "Deleted user data", 30, 45, 2.8, "Overdue", "Feb 28, 4:00 AM", "18.4K", "overdue", "GDPR"),
        new("6", "Analytics events", 365, 310, 156.3, "Apr 15, 2:00 AM", "Mar 15, 2:00 AM", "2.1B", "compliant", null),
    ];
}
