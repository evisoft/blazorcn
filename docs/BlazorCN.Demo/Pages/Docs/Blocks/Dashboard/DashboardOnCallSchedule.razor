@* ============================================================
   Block: dashboard-on-call-schedule
   Title: Dashboard On Call Schedule
   Description: Animated React on-call rotation schedule dashboard block for Next.js with weekly rotation calendar, escalation chains, swap request management, active shift indicator with pulse animation, and staggered row entrance using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Active incident management with severity levels
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-on-call-schedule.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">On-Call Schedule</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">Platform Engineering — Week 12</p>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="relative flex items-center justify-center">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                </span>
                <span class="text-muted-foreground text-xs">Sarah Chen on call</span>
            </div>
        </div>

        <div>
            @for (var si = 0; si < _sections.Length; si++)
                        {
                var sec = _sections[si];
                var isExpanded = _expandedSection == sec.Id;
                var isLast = si == _sections.Length - 1;

                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expandedSection = isExpanded ? null : sec.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="font-medium text-sm">@sec.Label</span>
                        <span class="min-w-0 flex-1"></span>
                        <span class="shrink-0 text-muted-foreground text-xs">@sec.Count</span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded && sec.Id == "schedule")
                                {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-3">
                                <div class="overflow-hidden rounded-md border">
                                    @for (var i = 0; i < _schedule.Length; i++)
                                                {
                                        var entry = _schedule[i];
                                        var entryIsLast = i == _schedule.Length - 1;

                                        <div class="@(Cn.Merge("flex items-center gap-3 px-3 py-2", !entryIsLast ? "border-b" : "", entry.Active ? "bg-muted/30" : ""))">
                                            <div class="w-14 shrink-0">
                                                <span class="font-medium text-xs">@entry.Day</span>
                                                <span class="ml-1 text-muted-foreground text-[10px]">
                                                    @entry.Date
                                                </span>
                                            </div>
                                            <div class="relative flex shrink-0 items-center justify-center">
                                                <span class="@(Cn.Merge("size-1.5 rounded-full", entry.Active ? "bg-emerald-500" : "bg-muted-foreground/30"))"></span>
                                            </div>
                                            <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">
                                                @entry.Initials
                                            </span>
                                            <span class="min-w-0 flex-1 truncate text-sm">
                                                @entry.Engineer
                                            </span>
                                            <span class="shrink-0 font-mono text-muted-foreground text-[10px] tabular-nums">
                                                @entry.Shift
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (isExpanded && sec.Id == "escalation")
                                {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-3">
                                <div class="overflow-hidden rounded-md border">
                                    @for (var i = 0; i < _escalation.Length; i++)
                                                {
                                        var tier = _escalation[i];
                                        var tierIsLast = i == _escalation.Length - 1;

                                        <div class="@(Cn.Merge("flex items-center gap-3 px-3 py-2", !tierIsLast ? "border-b" : ""))">
                                            <span class="flex size-5 shrink-0 items-center justify-center rounded bg-muted font-mono text-[10px] font-medium">
                                                @tier.Tier
                                            </span>
                                            <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">
                                                @tier.Initials
                                            </span>
                                            <span class="min-w-0 flex-1 text-sm">@tier.Engineer</span>
                                            <span class="shrink-0 text-muted-foreground text-xs">
                                                @tier.Delay
                                            </span>
                                            <div class="flex shrink-0 items-center gap-1 text-muted-foreground text-[10px]">
                                                <LucidePhoneCn Size="12" Class="size-3" />
                                                <span>@tier.Method</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (isExpanded && sec.Id == "swaps")
                                {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-3 space-y-2">
                                @foreach (var swap in _swapRequests)
                                            {
                                    <div class="rounded-md border p-3">
                                        <div class="flex items-center gap-2">
                                            <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">
                                                @swap.FromInitials
                                            </span>
                                            <LucideArrowRightLeftCn Size="12" Class="size-3 text-muted-foreground" />
                                            <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">
                                                @swap.ToInitials
                                            </span>
                                            <span class="min-w-0 flex-1 text-sm">
                                                @swap.From → @swap.To
                                            </span>
                                            <span class="shrink-0 text-muted-foreground text-xs">
                                                @swap.Date
                                            </span>
                                        </div>
                                        <p class="mt-1.5 text-muted-foreground text-xs">@swap.Reason</p>
                                        <div class="mt-2 flex items-center gap-2">
                                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                                Approve
                                            </ButtonCn>
                                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                                Decline
                                            </ButtonCn>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ScheduleEntry(string Id, string Day, string Date, string Engineer, string Initials, string Shift, bool Active);
    private record EscalationTier(int Tier, string Engineer, string Initials, string Delay, string Method);
    private record SwapRequest(string Id, string From, string FromInitials, string To, string ToInitials, string Date, string Reason, string Status);
    private record SectionInfo(string Id, string Label, string Count);

    private string? _expandedSection = "schedule";

    private SectionInfo[] _sections => new[]
    {
        new SectionInfo("schedule", "This Week's Rotation", $"{_schedule.Length} shifts"),
        new SectionInfo("escalation", "Escalation Chain", $"{_escalation.Length} tiers"),
        new SectionInfo("swaps", "Swap Requests", $"{_swapRequests.Count(s => s.Status == "pending")} pending")
    };

    private readonly ScheduleEntry[] _schedule = new[]
    {
        new ScheduleEntry("s1", "Mon", "Mar 17", "Sarah Chen", "SC", "08:00 – 20:00", true),
        new ScheduleEntry("s2", "Mon", "Mar 17", "Alex Rivera", "AR", "20:00 – 08:00", false),
        new ScheduleEntry("s3", "Tue", "Mar 18", "Jordan Park", "JP", "08:00 – 20:00", false),
        new ScheduleEntry("s4", "Tue", "Mar 18", "Sarah Chen", "SC", "20:00 – 08:00", false),
        new ScheduleEntry("s5", "Wed", "Mar 19", "Morgan Lee", "ML", "08:00 – 20:00", false),
        new ScheduleEntry("s6", "Wed", "Mar 19", "Jordan Park", "JP", "20:00 – 08:00", false),
        new ScheduleEntry("s7", "Thu", "Mar 20", "Alex Rivera", "AR", "08:00 – 20:00", false)
    };

    private readonly EscalationTier[] _escalation = new[]
    {
        new EscalationTier(1, "Sarah Chen", "SC", "Immediate", "Slack + SMS"),
        new EscalationTier(2, "Jordan Park", "JP", "After 5 min", "Phone call"),
        new EscalationTier(3, "Nina Kowalski", "NK", "After 15 min", "Phone + Manager")
    };

    private readonly SwapRequest[] _swapRequests = new[]
    {
        new SwapRequest("sw1", "Jordan Park", "JP", "Morgan Lee", "ML", "Wed Mar 19", "Doctor appointment", "pending"),
        new SwapRequest("sw2", "Alex Rivera", "AR", "Sarah Chen", "SC", "Thu Mar 20", "Conference travel", "pending")
    };
}
