@* ============================================================
   Block: dashboard-recent-orders
   Title: Dashboard Recent Orders
   Description: Animated React dashboard recent orders block for Next.js with expandable order rows, status indicators, customer details, and order amounts featuring AnimatePresence animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Four KPI metric cards with trend indicators
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-recent-orders.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <h2 class="font-medium text-sm">Recent orders</h2>
                <span class="rounded bg-muted px-1.5 py-0.5 text-muted-foreground text-xs">
                    @_orders.Length
                </span>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                View all
            </ButtonCn>
        </div>
        <div>
            @for (var i = 0; i < _orders.Length; i++)
            {
                var order = _orders[i];
                var isExpanded = _expanded == order.Id;
                var isLast = i == _orders.Length - 1;
                var status = _statusStyles[order.Status];
                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : order.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                            @order.Initials
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@order.Customer</span>
                            <p class="mt-0.5 font-mono text-muted-foreground text-xs">@order.Id</p>
                        </div>
                        <div class="hidden items-center gap-1.5 sm:flex">
                            <span class="@(Cn.Merge("size-1.5 rounded-full", status.Dot))"></span>
                            <span class="text-muted-foreground text-xs">@status.Label</span>
                        </div>
                        <span class="font-medium text-sm tabular-nums">@order.Amount</span>
                        <span class="hidden text-muted-foreground text-xs sm:inline">
                            @order.Date
                        </span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-[3.25rem]">
                            <div class="rounded-md bg-muted/50 p-3">
                                <p class="mb-2 font-medium text-muted-foreground text-xs">
                                    Order items
                                </p>
                                <div class="space-y-1.5">
                                    @foreach (var item in order.Items)
                                    {
                                        <div class="flex items-center justify-between text-sm">
                                            <span>
                                                @item.Name
                                                @if (item.Quantity > 1)
                                                {
                                                    <span class="ml-1 text-muted-foreground text-xs">
                                                        x@(item.Quantity)
                                                    </span>
                                                }
                                            </span>
                                            <span class="tabular-nums">@item.Price</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record OrderItem(string Name, int Quantity, string Price);
    private record Order(string Id, string Customer, string Initials, string Amount, string Status, string Date, OrderItem[] Items);
    private record StatusStyle(string Dot, string Label);

    private static readonly Dictionary<string, StatusStyle> _statusStyles = new()
    {
        ["completed"] = new("bg-emerald-500", "Completed"),
        ["processing"] = new("bg-blue-500", "Processing"),
        ["shipped"] = new("bg-amber-500", "Shipped"),
        ["refunded"] = new("bg-red-500", "Refunded"),
    };

    private static readonly Order[] _orders =
