@* ============================================================
   Block: dashboard-lead-sources
   Title: Dashboard Lead Sources
   Description: Animated lead source attribution dashboard for React and Next.js with eight sources showing lead counts in tabular-nums, conversion rates, cost per lead, and horizontal volume bars in a two-column table layout using framer-motion, shadcn/ui, and Tailwind CSS
   Long Description: Customer segmentation dashboard
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-lead-sources.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Lead Sources</span>
            <div class="flex items-center gap-3">
                <span class="text-muted-foreground text-xs">
                    <span class="font-medium text-foreground tabular-nums">
                        @_totalLeads.ToString("N0")
                    </span>
                    total leads
                </span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs">
                    <span class="font-medium text-foreground tabular-nums">@_avgConversion%</span> avg
                    conversion
                </span>
            </div>
        </div>

        @* Column headers *@
        <div class="grid grid-cols-[1fr_200px_80px_80px_72px] items-center gap-2 border-b bg-muted/30 px-4 py-2">
            <span class="text-muted-foreground text-xs">Source</span>
            <span class="text-muted-foreground text-xs">Volume</span>
            <span class="text-right text-muted-foreground text-xs">Leads</span>
            <span class="text-right text-muted-foreground text-xs">Conv.</span>
            <span class="text-right text-muted-foreground text-xs">CPL</span>
        </div>

        @* Source rows *@
        <div>
            @for (var i = 0; i < _sources.Length; i++)
            {
                var source = _sources[i];
                var isLast = i == _sources.Length - 1;
                var barPercent = (double)source.Leads / _maxLeads * 100;
                <div class="@(Cn.Merge("grid grid-cols-[1fr_200px_80px_80px_72px] items-center gap-2 px-4 py-2.5", isLast ? "" : "border-b"))">
                    <span class="font-medium text-sm">@source.Name</span>

                    @* Volume bar *@
                    <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                        <div class="h-full rounded-full bg-foreground/60"
                             style="@($"width: {barPercent:F1}%")">
                        </div>
                    </div>

                    <span class="text-right font-medium text-sm tabular-nums">
                        @source.Leads.ToString("N0")
                    </span>

                    <span class="@(Cn.Merge("text-right font-medium text-xs tabular-nums", ConversionColor(source.ConversionRate)))">
                        @(source.ConversionRate)%
                    </span>

                    <span class="text-right font-mono text-muted-foreground text-xs tabular-nums">
                        @source.CostPerLead
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record LeadSource(string Name, int Leads, double ConversionRate, string CostPerLead);

    private static string ConversionColor(double rate)
    {
        if (rate >= 7) return "text-emerald-600 dark:text-emerald-400";
        if (rate >= 5) return "text-amber-600 dark:text-amber-400";
        return "text-foreground";
    }

    private static readonly LeadSource[] _sources =
    [
        new("Organic Search", 4218, 6.2, "$0"),
        new("Paid Search", 2847, 4.8, "$42"),
        new("Social Media", 2134, 3.1, "$28"),
        new("Referral", 1892, 8.4, "$12"),
        new("Direct", 1456, 5.7, "$0"),
        new("Email", 1203, 7.1, "$8"),
        new("Partners", 847, 9.2, "$65"),
        new("Events", 412, 12.8, "$180"),
    ];
    private static readonly string _avgConversion = (_sources.Average(s => s.ConversionRate)).ToString("F1");

    private static readonly int _totalLeads = _sources.Sum(s => s.Leads);
    private static readonly int _maxLeads = _sources.Max(s => s.Leads);
}
