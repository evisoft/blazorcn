@* ============================================================
   Block: dashboard-rate-limits
   Title: Dashboard Rate Limits
   Description: Animated React rate limit monitoring dashboard block for Next.js with six API endpoints displaying monospaced paths, request limits per time window, animated usage progress bars with framer-motion width transitions, remaining request counts, reset time strings, and color-coded warning states at eighty percent and critical states at ninety-five percent usage using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: HTTP access log viewer with status codes
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-rate-limits.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Rate Limits</span>
                <p class="mt-0.5 text-muted-foreground text-xs">API endpoint quota utilization</p>
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                @if (_criticalCount > 0)
                {
                    <span class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        @_criticalCount near limit
                    </span>
                }
            </div>
        </div>

        @* Endpoints *@
        <div>
            @for (var i = 0; i < _endpoints.Length; i++)
            {
                var endpoint = _endpoints[i];
                var pct = (double)endpoint.Used / endpoint.Limit * 100;
                var isLast = i == _endpoints.Length - 1;
                <div class="@(Cn.Merge("px-4 py-3", isLast ? "" : "border-b"))">
                    <div class="flex items-center justify-between">
                        <span class="font-mono text-sm">@endpoint.Path</span>
                        <div class="flex items-center gap-3">
                            <span class="text-muted-foreground text-xs">
                                @endpoint.Limit / @endpoint.Window
                            </span>
                            <span class="text-muted-foreground text-xs">Reset @endpoint.ResetIn</span>
                        </div>
                    </div>

                    <div class="mt-2 flex items-center gap-3">
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted/50">
                            <div class="@(Cn.Merge("h-full rounded-full", BarColor(pct)))"
                                 style="@(FormattableString.Invariant($"width: {pct:F1}%"))"></div>
                        </div>
                        <span class="@(Cn.Merge("shrink-0 font-mono text-xs font-medium tabular-nums", TextColor(pct)))">
                            @endpoint.Remaining left
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record EndpointLimit(string Path, int Limit, string Window, int Used, int Remaining, string ResetIn);

    private static string BarColor(double pct) =>
        pct >= 95 ? "bg-red-500"
        : pct >= 80 ? "bg-amber-500"
        : "bg-foreground/70";

    private static string TextColor(double pct) =>
        pct >= 95 ? "text-red-600 dark:text-red-400"
        : pct >= 80 ? "text-amber-600 dark:text-amber-400"
        : "text-muted-foreground";

    private static readonly EndpointLimit[] _endpoints =
    [
        new("/api/v2/search", 100, "1 min", 97, 3, "23s"),
        new("/api/v2/users", 500, "15 min", 423, 77, "4m 30s"),
        new("/api/v2/orders", 200, "5 min", 89, 111, "2m 12s"),
        new("/api/v2/webhooks", 1000, "1 hour", 312, 688, "42m 08s"),
        new("/api/v2/auth/token", 30, "5 min", 28, 2, "1m 45s"),
        new("/api/v2/uploads", 50, "15 min", 18, 32, "12m 15s"),
    ];
    private static readonly int _criticalCount = _endpoints.Count(e => (double)e.Used / e.Limit * 100 >= 80);

}
