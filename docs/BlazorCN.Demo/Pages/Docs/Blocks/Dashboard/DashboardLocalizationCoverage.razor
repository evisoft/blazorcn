@* ============================================================
   Block: dashboard-localization-coverage
   Title: Dashboard Localization Coverage
   Description: Animated React i18n translation coverage dashboard block for Next.js with ten locale entries showing language names, country flags as emoji, total and translated string counts, missing string counts, animated coverage percentage bars, and staggered row entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Content engagement and conversion metrics
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-localization-coverage.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideGlobeCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Localization Coverage</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @_totalStrings.ToString("N0") strings across @_locales.Length locales
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <span class="tabular-nums">@_avgCoverage% avg</span>
                <span>·</span>
                <span class="tabular-nums">@_totalMissing.ToString("N0") missing</span>
            </div>
        </div>

        @* Locales *@
        <div>
            @for (var i = 0; i < _locales.Length; i++)
            {
                var locale = _locales[i];
                var isExpanded = _expanded == locale.Id;
                var isLast = i == _locales.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : locale.Id)"
                        class="w-full px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex items-center gap-3">
                            <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", MissingDot(locale.Missing)))"></span>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-sm">@locale.Language</span>
                                    <span class="font-mono text-muted-foreground text-xs">
                                        @locale.Code
                                    </span>
                                </div>
                                <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                    <span class="tabular-nums">
                                        @locale.Translated.ToString("N0") translated
                                    </span>
                                    @if (locale.Missing > 0)
                                    {
                                        <span>·</span>
                                        <span class="tabular-nums">
                                            @locale.Missing.ToString("N0") missing
                                        </span>
                                    }
                                </div>
                            </div>
                            <span class="@(Cn.Merge("shrink-0 font-medium text-sm tabular-nums", CoverageTextColor(locale.Coverage)))">
                                @(locale.Coverage)%
                            </span>
                            <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                        </div>

                        @* Coverage bar *@
                        <div class="mt-2 pl-[1.625rem]">
                            <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted/50">
                                <div class="@(Cn.Merge("h-full rounded-full", CoverageBarColor(locale.Coverage)))"
                                     style="@(FormattableString.Invariant($"width: {locale.Coverage}%"))">
                                </div>
                            </div>
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-9">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="grid grid-cols-3 gap-x-4 gap-y-2 text-xs">
                                    <div>
                                        <span class="text-muted-foreground">Last updated</span>
                                        <p class="mt-0.5 font-medium">@locale.LastUpdated</p>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground">Pending review</span>
                                        <p class="mt-0.5 font-medium tabular-nums">
                                            @locale.ReviewPending strings
                                        </p>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground">Completion</span>
                                        <p class="mt-0.5 font-medium tabular-nums">
                                            @locale.Translated.ToString("N0") / @locale.TotalStrings.ToString("N0")
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;
    private const int _totalStrings = 4832;

    private record LocaleInfo(string Id, string Code, string Language, string Flag, int TotalStrings, int Translated, int Missing, double Coverage, string LastUpdated, int ReviewPending);

    private static string CoverageBarColor(double pct)
    {
        if (pct >= 90) return "bg-emerald-500/70";
        if (pct >= 70) return "bg-amber-500/70";
        return "bg-red-500/70";
    }

    private static string CoverageTextColor(double pct)
    {
        if (pct >= 90) return "text-emerald-600 dark:text-emerald-400";
        if (pct >= 70) return "text-amber-600 dark:text-amber-400";
        return "text-red-600 dark:text-red-400";
    }

    private static string MissingDot(int missing)
    {
        if (missing == 0) return "bg-emerald-500";
        if (missing <= 200) return "bg-amber-500";
        return "bg-red-500";
    }

    private static readonly LocaleInfo[] _locales =
    [
        new("1", "en", "English", "US", _totalStrings, 4832, 0, 100, "Base language", 0),
        new("2", "de", "German", "DE", _totalStrings, 4718, 114, 97.6, "2 hours ago", 23),
        new("3", "fr", "French", "FR", _totalStrings, 4690, 142, 97.1, "5 hours ago", 18),
        new("4", "es", "Spanish", "ES", _totalStrings, 4601, 231, 95.2, "1 day ago", 42),
        new("5", "ja", "Japanese", "JP", _totalStrings, 4312, 520, 89.2, "3 days ago", 67),
        new("6", "zh", "Chinese (Simplified)", "CN", _totalStrings, 4189, 643, 86.7, "4 days ago", 89),
        new("7", "ko", "Korean", "KR", _totalStrings, 3947, 885, 81.7, "1 week ago", 54),
        new("8", "pt-BR", "Portuguese (Brazil)", "BR", _totalStrings, 3621, 1211, 74.9, "2 weeks ago", 31),
        new("9", "ar", "Arabic", "SA", _totalStrings, 2894, 1938, 59.9, "3 weeks ago", 112),
        new("10", "hi", "Hindi", "IN", _totalStrings, 1247, 3585, 25.8, "1 month ago", 203),
    ];
    private static readonly string _avgCoverage = (_locales.Average(l => l.Coverage)).ToString("F1");

    private static readonly int _totalMissing = _locales.Sum(l => l.Missing);
}
