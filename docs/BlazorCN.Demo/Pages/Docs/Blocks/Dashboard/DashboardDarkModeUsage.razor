@* ============================================================
   Block: dashboard-dark-mode-usage
   Title: Dashboard Dark Mode Usage
   Description: Animated React dark mode and light mode adoption analytics dashboard block for Next.js with preference breakdown, daily toggle patterns, device segmentation, and time-of-day heatmap using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: User session duration and page view metrics
   Dependencies: BadgeCn
   Source: original/blocks/dashboard/dashboard-dark-mode-usage.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideMoonCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Theme Preferences</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Last 30 days
            </BadgeCn>
        </div>

        @* Summary metrics *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div>
                <p class="text-muted-foreground text-xs">Total Users</p>
                <p class="font-semibold text-2xl tabular-nums">28.3K</p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">Daily Toggles</p>
                <p class="font-semibold text-sm tabular-nums">4,828</p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">Avg Toggles/User</p>
                <p class="font-semibold text-sm tabular-nums">1.4</p>
            </div>
        </div>

        @* Preference breakdown *@
        <div class="border-b px-4 py-3">
            <p class="mb-3 text-muted-foreground text-xs">Adoption by Preference</p>
            <div class="space-y-2.5">
                @foreach (var pref in _preferences)
                {
                    <div class="flex items-center gap-3">
                        <span class="flex w-16 items-center gap-1.5 text-muted-foreground">
                            @if (pref.Mode == "dark")
                            {
                                <LucideMoonCn Size="14" Class="size-3.5" />
                            }
                            else if (pref.Mode == "light")
                            {
                                <LucideSunCn Size="14" Class="size-3.5" />
                            }
                            else
                            {
                                <LucideMonitorCn Size="14" Class="size-3.5" />
                            }
                            <span class="text-xs capitalize">@pref.Mode</span>
                        </span>
                        <div class="h-2 flex-1 overflow-hidden rounded-full bg-muted/50">
                            <div class="h-full rounded-full bg-foreground/20"
                                 style="@($"width: {pref.Percentage}%")">
                            </div>
                        </div>
                        <span class="w-10 text-right font-medium text-xs tabular-nums">
                            @(pref.Percentage)%
                        </span>
                        <span class="w-14 text-right text-muted-foreground text-xs tabular-nums">
                            @((pref.Users / 1000.0).ToString("F1"))K
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Hourly toggle chart *@
        <div class="border-b px-4 py-3">
            <p class="mb-3 text-muted-foreground text-xs">Theme Toggles by Hour</p>
            <div class="flex h-20 items-end gap-px">
                @for (var i = 0; i < _hourlyToggles.Length; i++)
                {
                    var toggle = _hourlyToggles[i];
                    var heightPercent = (double)toggle.Count / _maxToggle * 100;
                    var isEvening = i >= 10;
                    <div class="@(Cn.Merge("flex-1 rounded-t", isEvening ? "bg-foreground/25" : "bg-foreground/12"))"
                         style="@($"height: {heightPercent:F1}%")"
                         title="@($"{toggle.Hour}: {toggle.Count} toggles")">
                    </div>
                }
            </div>
            <div class="mt-1.5 flex justify-between">
                <span class="text-muted-foreground text-[10px]">6 AM</span>
                <span class="text-muted-foreground text-[10px]">12 PM</span>
                <span class="text-muted-foreground text-[10px]">6 PM</span>
                <span class="text-muted-foreground text-[10px]">11 PM</span>
            </div>
        </div>

        @* Device segmentation *@
        <div>
            <div class="border-b px-4 py-2">
                <p class="text-muted-foreground text-xs">By Device</p>
            </div>
            @for (var i = 0; i < _devicePrefs.Length; i++)
            {
                var device = _devicePrefs[i];
                var isLast = i == _devicePrefs.Length - 1;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b"))">
                    @if (device.Icon == "mobile")
                    {
                        <LucideSmartphoneCn Size="14" Class="size-3.5 text-muted-foreground" />
                    }
                    else if (device.Icon == "tablet")
                    {
                        <LucideTabletCn Size="14" Class="size-3.5 text-muted-foreground" />
                    }
                    else
                    {
                        <LucideMonitorCn Size="14" Class="size-3.5 text-muted-foreground" />
                    }
                    <span class="w-14 font-medium text-sm">@device.Device</span>
                    <div class="flex h-2 flex-1 overflow-hidden rounded-full">
                        <div class="h-full bg-foreground/30" style="@($"width: {device.Dark}%")"></div>
                        <div class="h-full bg-foreground/12" style="@($"width: {device.Light}%")"></div>
                        <div class="h-full bg-foreground/5" style="@($"width: {device.System}%")"></div>
                    </div>
                    <span class="w-8 text-right text-muted-foreground text-xs tabular-nums">@(device.Dark)%</span>
                    <span class="w-8 text-right text-muted-foreground text-xs tabular-nums">@(device.Light)%</span>
                    <span class="w-8 text-right text-muted-foreground text-xs tabular-nums">@(device.System)%</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ThemePreference(string Mode, int Users, double Percentage);
    private record HourlyToggle(string Hour, int Count);
    private record DevicePreference(string Device, string Icon, int Dark, int Light, int System);

    private static readonly int _maxToggle = 740;

    private static readonly ThemePreference[] _preferences =
    [
        new("dark", 14820, 52.4),
        new("light", 9640, 34.1),
        new("system", 3810, 13.5),
    ];

    private static readonly HourlyToggle[] _hourlyToggles =
    [
        new("6a", 120), new("7a", 340), new("8a", 580), new("9a", 210),
        new("10a", 85), new("11a", 62), new("12p", 95), new("1p", 78),
        new("2p", 55), new("3p", 48), new("4p", 130), new("5p", 290),
        new("6p", 520), new("7p", 680), new("8p", 740), new("9p", 410),
        new("10p", 220), new("11p", 95),
    ];

    private static readonly DevicePreference[] _devicePrefs =
    [
        new("Desktop", "desktop", 46, 41, 13),
        new("Mobile", "mobile", 61, 24, 15),
        new("Tablet", "tablet", 48, 39, 13),
    ];
}
