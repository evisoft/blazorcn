@* ============================================================
   Block: dashboard-revenue-chart
   Title: Dashboard Revenue Chart
   Description: Animated React dashboard revenue bar chart block for Next.js with monthly revenue bars, hover tooltips, total revenue summary, and growth percentage using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Four KPI metric cards with trend indicators
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-revenue-chart.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Revenue</h2>
                <div class="mt-0.5 flex items-center gap-2">
                    <span class="font-semibold text-2xl tabular-nums">
                        @FormatCurrency(_totalRevenue)
                    </span>
                    <span class="flex items-center gap-0.5 text-emerald-600 text-xs dark:text-emerald-400">
                        <LucideTrendingUpCn Size="12" Class="size-3" />
                        +24.1%
                    </span>
                </div>
            </div>
            <span class="rounded bg-muted px-1.5 py-0.5 text-muted-foreground text-xs">
                Last 12 months
            </span>
        </div>
        <div class="px-4 py-4">
            <div class="flex h-40 items-end gap-1.5">
                @for (var i = 0; i < _monthlyData.Length; i++)
                {
                    var data = _monthlyData[i];
                    var heightPercent = (double)data.Revenue / _maxRevenue * 100;
                    var idx = i;
                    <div class="relative flex flex-1 flex-col items-center"
                         @onmouseenter="@(() => _hoveredIndex = idx)"
                         @onmouseleave="@(() => _hoveredIndex = null)">
                        @if (_hoveredIndex == idx)
                        {
                            <div class="absolute -top-7 rounded bg-foreground px-1.5 py-0.5 font-medium text-background text-xs tabular-nums">
                                @FormatCurrency(data.Revenue)
                            </div>
                        }
                        <div class="@(Cn.Merge("w-full rounded-sm transition-colors", _hoveredIndex == idx ? "bg-foreground" : "bg-foreground/80"))"
                             style="@(FormattableString.Invariant($"height: {heightPercent:F1}%"))"></div>
                    </div>
                }
            </div>
            <div class="mt-2 flex gap-1.5">
                @foreach (var data in _monthlyData)
                {
                    <div class="flex-1 text-center text-muted-foreground text-[10px]">
                        @data.Month
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private int? _hoveredIndex;

    private record MonthData(string Month, int Revenue);

    private static string FormatCurrency(int value) =>
        value >= 1000 ? $"${(value / 1000.0):F1}K" : $"${value}";

    private static readonly MonthData[] _monthlyData =
    [
        new("Jan", 18400),
        new("Feb", 22100),
        new("Mar", 19800),
        new("Apr", 27600),
        new("May", 24300),
        new("Jun", 31200),
        new("Jul", 28900),
        new("Aug", 35400),
        new("Sep", 32100),
        new("Oct", 38700),
        new("Nov", 36200),
        new("Dec", 42500),
    ];
    private static readonly int _totalRevenue = _monthlyData.Sum(d => d.Revenue);

    private static readonly int _maxRevenue = _monthlyData.Max(d => d.Revenue);
}
