@* ============================================================
   Block: dashboard-inventory-levels
   Title: Dashboard Inventory Levels
   Description: Animated React inventory management dashboard block for Next.js with product stock levels, SKU codes, reorder points, category chips, and status indicators using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: KPI metric cards with trend indicators
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-inventory-levels.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Inventory Levels</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_products.Length products tracked
                </p>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_products.Count(p => p.Status == "in-stock")
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_products.Count(p => p.Status == "low")
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_products.Count(p => p.Status == "out")
                </span>
            </div>
        </div>

        @* Column headers *@
        <div class="hidden border-b px-4 py-2 sm:grid sm:grid-cols-[1fr_100px_80px_80px_90px_90px]">
            <span class="text-muted-foreground text-xs">Product</span>
            <span class="text-muted-foreground text-xs">SKU</span>
            <span class="text-right text-muted-foreground text-xs">Stock</span>
            <span class="text-right text-muted-foreground text-xs">Reorder</span>
            <span class="text-center text-muted-foreground text-xs">Status</span>
            <span class="text-right text-muted-foreground text-xs">Category</span>
        </div>

        @* Product rows *@
        <div>
            @for (var i = 0; i < _products.Length; i++)
            {
                var product = _products[i];
                var isLast = i == _products.Length - 1;
                <div class="@(Cn.Merge("grid items-center gap-2 px-4 py-3 transition-colors hover:bg-muted/50 sm:grid-cols-[1fr_100px_80px_80px_90px_90px]", isLast ? "" : "border-b"))">
                    <span class="font-medium text-sm">@product.Name</span>
                    <span class="font-mono text-muted-foreground text-xs">@product.Sku</span>
                    <span class="@(Cn.Merge("text-right font-semibold text-sm tabular-nums", GetStockColor(product.Status)))">
                        @product.Stock
                    </span>
                    <span class="text-right text-muted-foreground text-sm tabular-nums">
                        @product.ReorderPoint
                    </span>
                    <span class="flex items-center justify-center gap-1.5 text-xs">
                        <span class="@(Cn.Merge("size-1.5 rounded-full", _statusDot[product.Status]))"></span>
                        <span class="text-muted-foreground">@_statusLabel[product.Status]</span>
                    </span>
                    <span class="text-right">
                        <span class="inline-block rounded-md bg-muted/50 px-2 py-0.5 text-muted-foreground text-xs">
                            @product.Category
                        </span>
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ProductItem(string Name, string Sku, int Stock, int ReorderPoint, string Status, string Category);

    private static string GetStockColor(string status) => status switch
    {
        "out" => "text-red-600 dark:text-red-400",
        "low" => "text-amber-600 dark:text-amber-400",
        _ => "",
    };

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["in-stock"] = "bg-emerald-500",
        ["low"] = "bg-amber-500",
        ["out"] = "bg-red-500",
    };

    private static readonly Dictionary<string, string> _statusLabel = new()
    {
        ["in-stock"] = "In Stock",
        ["low"] = "Low Stock",
        ["out"] = "Out of Stock",
    };

    private static readonly ProductItem[] _products =
    [
        new("Wireless Keyboard", "KB-2847", 142, 50, "in-stock", "Peripherals"),
        new("USB-C Hub 7-Port", "HB-1093", 23, 30, "low", "Accessories"),
        new("Ergonomic Mouse", "MS-4521", 89, 40, "in-stock", "Peripherals"),
        new("27\" 4K Monitor", "MN-7734", 0, 15, "out", "Displays"),
        new("Standing Desk Mat", "DM-3382", 67, 25, "in-stock", "Furniture"),
        new("Webcam HD 1080p", "WC-5519", 8, 20, "low", "Accessories"),
        new("Noise-Cancel Headset", "HS-6641", 204, 60, "in-stock", "Audio"),
        new("Laptop Stand Aluminum", "LS-8827", 0, 10, "out", "Furniture"),
    ];
}
