@* ============================================================
   Block: dashboard-form-analytics
   Title: Dashboard Form Analytics
   Description: Animated React form completion funnel dashboard block for Next.js with per-field drop-off rates, completion percentages, average time per field, animated funnel bars, and conversion metrics using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Five-step visitor-to-retained funnel analytics
   Dependencies: BadgeCn
   Source: original/blocks/dashboard/dashboard-form-analytics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideTextCursorInputCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Form Analytics</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Pro Upgrade Checkout
            </BadgeCn>
        </div>

        @* Summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div>
                <p class="text-muted-foreground text-xs">Completion Rate</p>
                <p class="font-semibold text-2xl tabular-nums">40.0%</p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">Starts</p>
                <p class="font-semibold text-sm tabular-nums">4,820</p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">Submissions</p>
                <p class="font-semibold text-sm tabular-nums">1,926</p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">Avg Time</p>
                <p class="font-semibold text-sm">1m 48s</p>
            </div>
        </div>

        @* Funnel fields *@
        <div>
            @for (var i = 0; i < _fields.Length; i++)
            {
                var field = _fields[i];
                var widthPercent = Math.Max((double)field.Completed / _totalStarts * 100, 6);
                var isLast = i == _fields.Length - 1;
                var nextField = isLast ? null : _fields[i + 1];
                <div>
                    <div class="@(Cn.Merge("px-4 py-2.5", isLast ? "" : "border-b", field.IsHighDropOff ? "bg-amber-500/5" : ""))">
                        <div class="flex items-center gap-3">
                            <span class="w-5 shrink-0 text-center text-muted-foreground text-xs tabular-nums">
                                @(i + 1)
                            </span>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-sm">@field.Label</span>
                                    <span class="rounded bg-muted/50 px-1 py-0.5 font-mono text-[10px] text-muted-foreground">
                                        @field.Type
                                    </span>
                                    @if (field.IsHighDropOff)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 bg-amber-500/10 px-1.5 font-normal text-[10px] text-amber-600 dark:text-amber-400">
                                            High drop-off
                                        </BadgeCn>
                                    }
                                </div>
                            </div>
                            <span class="w-12 text-right text-muted-foreground text-xs tabular-nums">
                                @field.AvgTime
                            </span>
                            <span class="@(Cn.Merge("w-12 text-right font-medium text-xs tabular-nums", field.DropOffRate > 10 ? "text-amber-600 dark:text-amber-400" : "text-muted-foreground"))">
                                -@(field.DropOffRate)%
                            </span>
                            <span class="w-14 text-right text-muted-foreground text-xs tabular-nums">
                                @field.Completed.ToString("N0")
                            </span>
                        </div>
                        <div class="mt-1.5 ml-8 flex justify-center">
                            <div class="@(Cn.Merge("h-5 rounded", field.IsHighDropOff ? "bg-amber-500/15" : "bg-foreground/10"))"
                                 style="@($"width: {widthPercent:F1}%")">
                            </div>
                        </div>
                    </div>

                    @if (!isLast && nextField != null && field.DropOffRate > 8)
                    {
                        <div class="flex items-center justify-center gap-1 border-b py-1">
                            <LucideArrowDownCn Size="12" Class="size-3 text-muted-foreground/60" />
                            <span class="text-muted-foreground text-xs tabular-nums">
                                @((field.Reached - field.Completed).ToString("N0")) users left
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private const int _totalStarts = 4820;

    private record FormField(string Id, string Label, string Type, int Reached, int Completed, double DropOffRate, string AvgTime, bool IsHighDropOff);

    private static readonly FormField[] _fields =
    [
        new("1", "Full Name", "text", 4820, 4654, 3.4, "3.2s", false),
        new("2", "Email Address", "email", 4654, 4512, 3.1, "4.8s", false),
        new("3", "Company Name", "text", 4512, 3890, 13.8, "6.1s", true),
        new("4", "Team Size", "select", 3890, 3720, 4.4, "2.8s", false),
        new("5", "Card Number", "payment", 3720, 2480, 33.3, "18.4s", true),
        new("6", "Billing Address", "address", 2480, 2180, 12.1, "14.2s", true),
        new("7", "Submit", "button", 2180, 1926, 11.7, "1.4s", false),
    ];
}
