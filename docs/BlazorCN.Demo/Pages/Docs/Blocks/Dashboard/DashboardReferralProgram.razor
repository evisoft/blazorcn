@* ============================================================
   Block: dashboard-referral-program
   Title: Dashboard Referral Program
   Description: Animated React referral program block for Next.js with total referrals, conversion rate, revenue attribution, average reward value, top referrer leaderboard with earnings, and staggered entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Transaction metrics and recent payments
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-referral-program.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Referral Program</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Program performance and top referrers
            </p>
        </div>

        <div class="grid grid-cols-2 gap-px border-b bg-border sm:grid-cols-4">
            @foreach (var metric in _metrics)
            {
                <div class="bg-card px-4 py-3">
                    <span class="text-muted-foreground text-xs">@metric.Label</span>
                    <p class="mt-1 font-semibold text-2xl tabular-nums">@metric.Value</p>
                    <span class="text-muted-foreground text-xs">@metric.Sub</span>
                </div>
            }
        </div>

        <div class="border-b px-4 py-2">
            <span class="font-medium text-muted-foreground text-xs">Top Referrers</span>
        </div>

        <div>
            @for (var i = 0; i < _referrers.Length; i++)
            {
                var referrer = _referrers[i];
                var isLast = i == _referrers.Length - 1;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b"))">
                    <span class="text-muted-foreground text-xs tabular-nums">#@(i + 1)</span>

                    <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">
                        @referrer.Initials
                    </div>

                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@referrer.Name</span>
                    </div>

                    <div class="flex items-center gap-4">
                        <div class="text-right">
                            <span class="font-semibold text-sm tabular-nums">@referrer.Referrals</span>
                            <p class="text-muted-foreground text-xs">referrals</p>
                        </div>
                        <div class="text-right">
                            <span class="font-semibold text-sm tabular-nums">@referrer.Earned</span>
                            <p class="text-muted-foreground text-xs">earned</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record SummaryMetric(string Label, string Value, string Sub);
    private record Referrer(string Id, string Name, string Initials, int Referrals, string Earned);

    private static readonly SummaryMetric[] _metrics =
    [
        new("Total Referrals", "1,247", "+18% from last month"),
        new("Conversion Rate", "24%", "298 converted"),
        new("Referral Revenue", "$48K", "lifetime attributed"),
        new("Avg Reward", "$25", "per successful referral"),
    ];

    private static readonly Referrer[] _referrers =
    [
        new("1", "Alex Thompson", "AT", 184, "$4,600"),
        new("2", "Maria Garcia", "MG", 156, "$3,900"),
        new("3", "David Kim", "DK", 132, "$3,300"),
        new("4", "Sophie Laurent", "SL", 98, "$2,450"),
        new("5", "Ryan Patel", "RP", 87, "$2,175"),
        new("6", "Emma Wilson", "EW", 74, "$1,850"),
    ];
}
