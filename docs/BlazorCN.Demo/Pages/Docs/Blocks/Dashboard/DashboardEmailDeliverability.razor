@* ============================================================
   Block: dashboard-email-deliverability
   Title: Dashboard Email Deliverability
   Description: Animated React email deliverability monitoring dashboard block for Next.js with bounce rate, spam score, inbox placement rate, domain reputation, and per-provider delivery breakdown using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Campaign performance with open and click rates
   Dependencies: BadgeCn
   Source: original/blocks/dashboard/dashboard-email-deliverability.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideMailCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Email Deliverability</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Last 7 days
            </BadgeCn>
        </div>

        @* Top metrics *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div>
                <p class="text-muted-foreground text-xs">Weekly Volume</p>
                <p class="font-semibold text-2xl tabular-nums">293K</p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">Delivered</p>
                <p class="font-semibold text-sm tabular-nums text-emerald-600 dark:text-emerald-400">
                    98.6%
                </p>
            </div>
        </div>

        @* KPI row *@
        <div class="grid grid-cols-4 border-b">
            @for (var i = 0; i < _metrics.Length; i++)
            {
                var metric = _metrics[i];
                <div class="@(Cn.Merge("px-4 py-3", i < 3 ? "border-r" : ""))">
                    <p class="text-muted-foreground text-xs">@metric.Label</p>
                    <p class="mt-0.5 font-semibold text-sm tabular-nums">@metric.Value</p>
                    <span class="@(Cn.Merge("mt-0.5 flex items-center gap-0.5 text-[10px] tabular-nums", GetTrendColor(metric.Trend, metric.Good)))">
                        @if (metric.Trend == "up")
                        {
                            <LucideTrendingUpCn Size="10" Class="size-2.5" />
                        }
                        else
                        {
                            <LucideTrendingDownCn Size="10" Class="size-2.5" />
                        }
                        @metric.TrendValue
                    </span>
                </div>
            }
        </div>

        @* Provider breakdown header *@
        <div class="flex items-center gap-3 border-b px-4 py-2">
            <span class="min-w-0 flex-1 text-muted-foreground text-xs">Provider</span>
            <span class="w-16 text-right text-muted-foreground text-xs">Inbox</span>
            <span class="w-12 text-right text-muted-foreground text-xs">Spam</span>
            <span class="w-14 text-right text-muted-foreground text-xs">Blocked</span>
            <span class="w-12 text-right text-muted-foreground text-xs">Volume</span>
        </div>

        @* Provider rows *@
        <div>
            @for (var i = 0; i < _providerStats.Length; i++)
            {
                var provider = _providerStats[i];
                var isLast = i == _providerStats.Length - 1;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b"))">
                    <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", GetInboxColor(provider.InboxRate)))"></span>
                    <span class="min-w-0 flex-1 font-medium text-sm">@provider.Provider</span>
                    <div class="flex w-16 items-center justify-end gap-1.5">
                        <div class="h-1.5 w-10 overflow-hidden rounded-full bg-muted/50">
                            <div class="h-full rounded-full bg-emerald-500/60"
                                 style="@($"width: {provider.InboxRate}%")">
                            </div>
                        </div>
                        <span class="text-right text-xs tabular-nums">@(provider.InboxRate)%</span>
                    </div>
                    <span class="w-12 text-right text-muted-foreground text-xs tabular-nums">
                        @(provider.SpamRate)%
                    </span>
                    <span class="w-14 text-right text-muted-foreground text-xs tabular-nums">
                        @(provider.BlockedRate)%
                    </span>
                    <span class="w-12 text-right text-muted-foreground text-xs tabular-nums">
                        @provider.Volume
                    </span>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-4 text-muted-foreground text-xs">
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Inbox
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    Spam
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    Blocked
                </span>
                <span class="ml-auto">Authentication: SPF, DKIM, DMARC passing</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record MetricTrend(string Label, string Value, string Trend, string TrendValue, string Good);
    private record ProviderStat(string Provider, double InboxRate, double SpamRate, double BlockedRate, string Volume);

    private static string GetTrendColor(string trend, string good)
    {
        if (trend == good) return "text-emerald-600 dark:text-emerald-400";
        return "text-red-600 dark:text-red-400";
    }

    private static string GetInboxColor(double rate)
    {
        if (rate >= 95) return "bg-emerald-500";
        if (rate >= 90) return "bg-amber-500";
        return "bg-red-500";
    }

    private static readonly MetricTrend[] _metrics =
    [
        new("Inbox Placement", "94.2%", "up", "+1.8%", "up"),
        new("Bounce Rate", "1.4%", "down", "-0.3%", "down"),
        new("Spam Rate", "0.08%", "down", "-0.02%", "down"),
        new("Reputation", "92", "up", "+3", "up"),
    ];

    private static readonly ProviderStat[] _providerStats =
    [
        new("Gmail", 96.1, 2.8, 1.1, "124K"),
        new("Outlook", 93.4, 4.2, 2.4, "89K"),
        new("Yahoo", 91.8, 5.6, 2.6, "34K"),
        new("Apple Mail", 97.2, 1.9, 0.9, "28K"),
        new("Other", 88.6, 6.8, 4.6, "18K"),
    ];
}
