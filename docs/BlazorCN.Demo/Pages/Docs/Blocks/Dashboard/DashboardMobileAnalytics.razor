@* ============================================================
   Block: dashboard-mobile-analytics
   Title: Dashboard Mobile Analytics
   Description: Animated React mobile app analytics dashboard for Next.js with session counts, crash rates, screen flow metrics, OS distribution breakdown, and app version adoption using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: User session tracking and analysis
   Dependencies: BadgeCn
   Source: original/blocks/dashboard/dashboard-mobile-analytics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideSmartphoneCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Mobile Analytics</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">Acme App · iOS &amp; Android</p>
                </div>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Today
            </BadgeCn>
        </div>

        @* KPI grid *@
        <div class="grid grid-cols-4 border-b">
            @for (var ki = 0; ki < _kpis.Length; ki++)
            {
                var kpi = _kpis[ki];
                <div class="@(Cn.Merge("px-4 py-3", ki < 3 ? "border-r" : ""))">
                    <span class="font-medium text-muted-foreground text-[10px]">@kpi.Label</span>
                    <div class="mt-1 flex items-baseline gap-0.5">
                        <span class="@(Cn.Merge("font-semibold text-lg tabular-nums", kpi.Color))">
                            @kpi.Value
                        </span>
                        @if (!string.IsNullOrEmpty(kpi.Unit))
                        {
                            <span class="text-muted-foreground text-[10px]">@kpi.Unit</span>
                        }
                    </div>
                </div>
            }
        </div>

        @* OS distribution *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">OS Distribution</span>
            </div>
            @for (var oi = 0; oi < _osBreakdown.Length; oi++)
            {
                var os = _osBreakdown[oi];
                var isLast = oi == _osBreakdown.Length - 1;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-2.5", !isLast ? "border-b" : ""))">
                    <span class="w-20 text-sm">@os.Name @os.Version</span>
                    <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                        <div class="h-full rounded-full bg-muted-foreground/30"
                             style="@($"width: {os.Percent}%")">
                        </div>
                    </div>
                    <span class="w-10 text-right font-mono text-xs tabular-nums text-muted-foreground">
                        @os.Percent%
                    </span>
                    <span class="w-10 text-right text-muted-foreground text-xs tabular-nums">
                        @os.Sessions
                    </span>
                </div>
            }
        </div>

        @* Top screen flows *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Top Screen Flows</span>
            </div>
            @for (var pi = 0; pi < _screenPaths.Length; pi++)
            {
                var path = _screenPaths[pi];
                var isLast = pi == _screenPaths.Length - 1;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", !isLast ? "border-b" : ""))">
                    <div class="flex min-w-0 flex-1 items-center gap-1">
                        @for (var si = 0; si < path.Path.Length; si++)
                        {
                            var screen = path.Path[si];
                            <span class="flex items-center gap-1">
                                <span class="font-mono text-xs">@screen</span>
                                @if (si < path.Path.Length - 1)
                                {
                                    <span class="text-muted-foreground text-[10px]">&rarr;</span>
                                }
                            </span>
                        }
                    </div>
                    <span class="shrink-0 text-muted-foreground text-xs tabular-nums">
                        @path.Sessions
                    </span>
                    <span class="w-8 shrink-0 text-right text-muted-foreground text-xs tabular-nums">
                        @path.Percent%
                    </span>
                </div>
            }
        </div>

        @* Version adoption *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Version Adoption</span>
            </div>
            @for (var vi = 0; vi < _appVersions.Length; vi++)
            {
                var ver = _appVersions[vi];
                var isLast = vi == _appVersions.Length - 1;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-2.5", !isLast ? "border-b" : ""))">
                    <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", _versionStatusDot[ver.Status]))"></span>
                    <span class="w-16 font-mono text-sm">@ver.Version</span>
                    <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                        <div class="h-full rounded-full bg-muted-foreground/30"
                             style="@($"width: {ver.Percent}%")">
                        </div>
                    </div>
                    <span class="w-10 text-right font-mono text-xs tabular-nums text-muted-foreground">
                        @ver.Percent%
                    </span>
                    <span class="w-10 text-right text-muted-foreground text-xs tabular-nums">
                        @ver.Users
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record KpiMetric(string Label, string Value, string Unit, string Color);
    private record OsBreakdown(string Id, string Name, string Version, string Sessions, int Percent);
    private record ScreenPath(string Id, string[] Path, string Sessions, int Percent);
    private record AppVersion(string Id, string Version, int Percent, string Users, string Status);

    private readonly Dictionary<string, string> _versionStatusDot = new()
    {
        ["current"] = "bg-emerald-500",
        ["previous"] = "bg-amber-500",
        ["outdated"] = "bg-red-500"
    };

    private readonly KpiMetric[] _kpis = new[]
    {
        new KpiMetric("Daily Sessions", "284K", "today", "text-foreground"),
        new KpiMetric("Crash-Free Rate", "99.72", "%", "text-emerald-600 dark:text-emerald-400"),
        new KpiMetric("Avg Duration", "6m 42s", "", "text-foreground"),
        new KpiMetric("Screens/Session", "8.3", "avg", "text-foreground")
    };

    private readonly OsBreakdown[] _osBreakdown = new[]
    {
        new OsBreakdown("os1", "iOS", "17.x", "142K", 50),
        new OsBreakdown("os2", "iOS", "16.x", "34K", 12),
        new OsBreakdown("os3", "Android", "14", "62K", 22),
        new OsBreakdown("os4", "Android", "13", "31K", 11),
        new OsBreakdown("os5", "Android", "12", "15K", 5)
    };

    private readonly ScreenPath[] _screenPaths = new[]
    {
        new ScreenPath("p1", new[] { "Home", "Search", "Product", "Cart" }, "48K", 17),
        new ScreenPath("p2", new[] { "Home", "Feed", "Profile" }, "35K", 12),
        new ScreenPath("p3", new[] { "Push", "Product", "Cart", "Checkout" }, "28K", 10),
        new ScreenPath("p4", new[] { "Home", "Categories", "Product" }, "22K", 8)
    };

    private readonly AppVersion[] _appVersions = new[]
    {
        new AppVersion("av1", "4.8.0", 62, "176K", "current"),
        new AppVersion("av2", "4.7.3", 24, "68K", "previous"),
        new AppVersion("av3", "4.6.x", 9, "25K", "outdated"),
        new AppVersion("av4", "< 4.6", 5, "14K", "outdated")
    };
}
