@* ============================================================
   Block: dashboard-task-board
   Title: Dashboard Task Board
   Description: Animated React kanban task board dashboard block for Next.js with three status columns showing task counts, priority dots, assignee initials, animated progress bars, and top tasks per column using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: KPI metric cards with trend indicators
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-task-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Task Board</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_totalTasks tasks across @_columns.Length columns
                </p>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    High
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    Med
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    Low
                </span>
            </div>
        </div>

        <div class="grid border-b sm:grid-cols-3">
            @for (var ci = 0; ci < _columns.Length; ci++)
            {
                var col = _columns[ci];
                var isLastCol = ci == _columns.Length - 1;
                var barWidth = (int)Math.Round((double)col.Count / _totalTasks * 100);
                <div class="@(Cn.Merge("px-4 py-3", !isLastCol ? "border-b sm:border-b-0 sm:border-r" : ""))">
                    <div class="flex items-center justify-between">
                        <span class="text-muted-foreground text-xs">@col.Label</span>
                        <span class="@(Cn.Merge("font-semibold text-lg tabular-nums", col.Color))">
                            @col.Count
                        </span>
                    </div>
                    <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-muted">
                        <div class="@(Cn.Merge("h-full rounded-full", col.BarColor))"
                             style="@($"width: {barWidth}%")"></div>
                    </div>
                </div>
            }
        </div>

        <div class="grid sm:grid-cols-3">
            @for (var ci = 0; ci < _columns.Length; ci++)
            {
                var col = _columns[ci];
                var isLastCol = ci == _columns.Length - 1;
                <div class="@(!isLastCol ? "border-b sm:border-b-0 sm:border-r" : "")">
                    @for (var ti = 0; ti < col.Tasks.Length; ti++)
                    {
                        var task = col.Tasks[ti];
                        var isLastTask = ti == col.Tasks.Length - 1;
                        <div class="@(Cn.Merge("flex items-center gap-2 px-4 py-2.5 transition-colors hover:bg-muted/50", !isLastTask ? "border-b" : ""))">
                            <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", _priorityDot[task.Priority]))"></span>
                            <span class="min-w-0 flex-1 truncate text-sm">@task.Title</span>
                            <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-muted-foreground text-xs">
                                @task.Assignee
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TaskData(string Id, string Title, string Priority, string Assignee);
    private record ColumnData(string Id, string Label, int Count, string Color, string BarColor, TaskData[] Tasks);

    private int _totalTasks => _columns.Sum(c => c.Count);

    private readonly Dictionary<string, string> _priorityDot = new()
    {
        ["high"] = "bg-red-500",
        ["medium"] = "bg-amber-500",
        ["low"] = "bg-blue-500"
    };

    private readonly ColumnData[] _columns = new[]
    {
        new ColumnData("todo", "To Do", 12, "text-muted-foreground", "bg-zinc-400 dark:bg-zinc-500", new[]
        {
            new TaskData("t1", "Design system audit", "high", "SC"),
            new TaskData("t2", "Update API documentation", "medium", "MJ"),
            new TaskData("t3", "Add dark mode to settings", "low", "DP")
        }),
        new ColumnData("progress", "In Progress", 8, "text-blue-600 dark:text-blue-400", "bg-blue-500", new[]
        {
            new TaskData("t4", "Migrate to Next.js 16", "high", "AT"),
            new TaskData("t5", "Build analytics dashboard", "high", "SC"),
            new TaskData("t6", "Optimize image pipeline", "medium", "JW")
        }),
        new ColumnData("done", "Done", 24, "text-emerald-600 dark:text-emerald-400", "bg-emerald-500", new[]
        {
            new TaskData("t7", "Stripe integration tests", "high", "OK"),
            new TaskData("t8", "Onboarding flow redesign", "medium", "PS"),
            new TaskData("t9", "Fix nav accessibility", "low", "ER")
        })
    };
}
