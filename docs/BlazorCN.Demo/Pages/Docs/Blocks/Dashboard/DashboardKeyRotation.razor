@* ============================================================
   Block: dashboard-key-rotation
   Title: Dashboard Key Rotation
   Description: Animated React API and encryption key rotation dashboard block for Next.js with eight keys displaying key types, masked key prefixes, creation dates, age indicators, next rotation dates, rotation status with semantic colors, and staggered row entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: SSL certificate tracking with expiry alerts
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-key-rotation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideKeyCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Key Rotation</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">@_keys.Length managed keys</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                @{
                    var overdueCount = _keys.Count(k => k.Status == "overdue");
                    var dueSoonCount = _keys.Count(k => k.Status == "due-soon");
                }
                @if (overdueCount > 0)
                {
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        @overdueCount overdue
                    </span>
                }
                @if (dueSoonCount > 0)
                {
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        @dueSoonCount due soon
                    </span>
                }
            </div>
        </div>

        @* Keys *@
        <div>
            @for (var i = 0; i < _keys.Length; i++)
            {
                var key = _keys[i];
                var isExpanded = _expanded == key.Id;
                var isLast = i == _keys.Length - 1;
                var style = _statusStyle[key.Status];
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : key.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", style.Dot))"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@key.Name</span>
                                <span class="rounded bg-muted/80 px-1.5 py-0.5 text-muted-foreground text-xs">
                                    @_typeLabel[key.Type]
                                </span>
                            </div>
                            <p class="mt-0.5 font-mono text-muted-foreground text-xs">@key.Prefix</p>
                        </div>
                        <div class="shrink-0 text-right">
                            <span class="@(Cn.Merge("font-medium text-xs", style.Text))">@style.Label</span>
                            <p class="mt-0.5 text-muted-foreground text-xs tabular-nums">
                                @key.Age old
                            </p>
                        </div>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-9">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="grid grid-cols-2 gap-x-4 gap-y-2 text-xs">
                                    <div>
                                        <span class="text-muted-foreground">Created</span>
                                        <p class="mt-0.5 font-medium tabular-nums">@key.CreatedAt</p>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground">Next rotation</span>
                                        <p class="mt-0.5 font-medium tabular-nums">@key.NextRotation</p>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground">Algorithm</span>
                                        <p class="mt-0.5 font-mono">@key.Algorithm</p>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground">Last used</span>
                                        <p class="mt-0.5">@key.LastUsed</p>
                                    </div>
                                </div>
                                @if (key.Status == "overdue")
                                {
                                    <div class="mt-3 flex items-center justify-between">
                                        <span class="text-red-600 text-xs dark:text-red-400">
                                            This key is past its rotation date
                                        </span>
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                                            <LucideRotateCwCn Size="12" Class="size-3" />
                                            Rotate now
                                        </ButtonCn>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record ManagedKey(string Id, string Name, string Type, string Prefix, string CreatedAt, string Age, string NextRotation, string Status, string Algorithm, string LastUsed);
    private record StatusStyle(string Dot, string Text, string Label);

    private static readonly Dictionary<string, StatusStyle> _statusStyle = new()
    {
        ["current"] = new("bg-emerald-500", "text-emerald-600 dark:text-emerald-400", "Current"),
        ["due-soon"] = new("bg-amber-500", "text-amber-600 dark:text-amber-400", "Due soon"),
        ["overdue"] = new("bg-red-500", "text-red-600 dark:text-red-400", "Overdue"),
    };

    private static readonly Dictionary<string, string> _typeLabel = new()
    {
        ["api"] = "API",
        ["encryption"] = "Encryption",
        ["signing"] = "Signing",
        ["webhook"] = "Webhook",
        ["oauth"] = "OAuth",
    };

    private static readonly ManagedKey[] _keys =
    [
        new("1", "Production API Key", "api", "sk_live_4eC39Hq...Mw2Z", "2026-01-15", "62 days", "2026-04-15", "current", "AES-256", "12 seconds ago"),
        new("2", "Database Encryption Key", "encryption", "enc_aes256_7Kp...X9nR", "2025-09-01", "198 days", "2026-03-01", "overdue", "AES-256-GCM", "1 second ago"),
        new("3", "JWT Signing Key", "signing", "sig_rs256_Mn2...8vTq", "2026-02-10", "36 days", "2026-05-10", "current", "RS256", "3 seconds ago"),
        new("4", "Stripe Webhook Secret", "webhook", "whsec_Bx9K3m...pR4s", "2025-12-20", "88 days", "2026-03-20", "due-soon", "HMAC-SHA256", "47 seconds ago"),
        new("5", "OAuth Client Secret", "oauth", "ocs_G7nR4v...wL2m", "2025-11-05", "133 days", "2026-02-05", "overdue", "HMAC-SHA256", "2 minutes ago"),
        new("6", "Staging API Key", "api", "sk_test_9Rv2...hN8w", "2026-03-01", "17 days", "2026-06-01", "current", "AES-256", "5 minutes ago"),
        new("7", "S3 Encryption Key", "encryption", "enc_s3_Qw7...3mPx", "2026-01-28", "49 days", "2026-04-28", "current", "AES-256-GCM", "8 seconds ago"),
        new("8", "GitHub App Signing Key", "signing", "sig_gh_Lk4...9sVn", "2025-10-15", "154 days", "2026-03-15", "overdue", "RS256", "3 hours ago"),
    ];
}
