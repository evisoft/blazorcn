@* ============================================================
   Block: dashboard-runbook-status
   Title: Dashboard Runbook Status
   Description: Animated React operational runbook status dashboard block for Next.js with nine runbooks showing last execution status, automation level badges, category labels, trigger types, average execution duration, last run timestamps, and staggered row entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Active incident tracking with severity levels
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-runbook-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideBookOpenCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Runbook Status</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @_runbooks.Length operational runbooks
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                @if (_failedCount > 0)
                {
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        @_failedCount failed
                    </span>
                }
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_automatedCount automated
                </span>
            </div>
        </div>

        @* Runbooks *@
        <div>
            @for (var i = 0; i < _runbooks.Length; i++)
            {
                var runbook = _runbooks[i];
                var isExpanded = _expanded == runbook.Id;
                var isLast = i == _runbooks.Length - 1;
                var status = _statusStyle[runbook.Status];
                var automation = _automationStyle[runbook.AutomationLevel];
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : runbook.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", status.Dot))"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@runbook.Name</span>
                                <span class="@(Cn.Merge("rounded px-1.5 py-0.5 text-xs font-medium", automation.Bg, automation.Text))">
                                    @automation.Label
                                </span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span>@runbook.Category</span>
                                <span>·</span>
                                <span>@_triggerLabel[runbook.TriggerType] trigger</span>
                                <span>·</span>
                                <span>@runbook.Steps steps</span>
                            </div>
                        </div>
                        <div class="shrink-0 text-right">
                            <span class="@(Cn.Merge("font-medium text-xs", status.Text))">@status.Label</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@runbook.LastRun</p>
                        </div>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-9">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="grid grid-cols-3 gap-x-4 gap-y-2 text-xs">
                                    <div>
                                        <span class="text-muted-foreground">Avg duration</span>
                                        <p class="mt-0.5 font-medium tabular-nums">@runbook.AvgDuration</p>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground">Total runs</span>
                                        <p class="mt-0.5 font-medium tabular-nums">@runbook.RunCount</p>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground">Owner</span>
                                        <p class="mt-0.5 font-medium">@runbook.Owner</p>
                                    </div>
                                </div>

                                @if (runbook.Status == "failed" && !string.IsNullOrEmpty(runbook.FailedStep))
                                {
                                    <div class="mt-3 space-y-1">
                                        <span class="text-red-600 text-xs dark:text-red-400">@runbook.FailedStep</span>
                                        <p class="text-muted-foreground text-xs">@runbook.FailureMessage</p>
                                    </div>
                                }

                                <div class="mt-3 flex justify-end">
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                                        <LucidePlayCn Size="12" Class="size-3" />
                                        Run now
                                    </ButtonCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record Runbook(string Id, string Name, string Category, string AutomationLevel, string TriggerType, string Status, string LastRun, string AvgDuration, int Steps, string Owner, string? FailedStep, string? FailureMessage, int RunCount);
    private record StatusStyleConfig(string Dot, string Label, string Text);
    private record AutomationStyleConfig(string Bg, string Text, string Label);

    private static readonly int _failedCount = _runbooks.Count(r => r.Status == "failed");
    private static readonly int _automatedCount = _runbooks.Count(r => r.AutomationLevel == "fully-automated");

    private static readonly Dictionary<string, StatusStyleConfig> _statusStyle = new()
    {
        ["success"] = new("bg-emerald-500", "Passed", "text-emerald-600 dark:text-emerald-400"),
        ["failed"] = new("bg-red-500", "Failed", "text-red-600 dark:text-red-400"),
        ["never-run"] = new("bg-zinc-400", "Never run", "text-muted-foreground"),
    };

    private static readonly Dictionary<string, AutomationStyleConfig> _automationStyle = new()
    {
        ["manual"] = new("bg-zinc-500/10", "text-muted-foreground", "Manual"),
        ["semi-automated"] = new("bg-blue-500/10", "text-blue-600 dark:text-blue-400", "Semi-auto"),
        ["fully-automated"] = new("bg-emerald-500/10", "text-emerald-600 dark:text-emerald-400", "Automated"),
    };

    private static readonly Dictionary<string, string> _triggerLabel = new()
    {
        ["manual"] = "Manual",
        ["alert"] = "Alert",
        ["scheduled"] = "Scheduled",
        ["incident"] = "Incident",
    };

    private static readonly Runbook[] _runbooks =
    [
        new("1", "Database Failover", "Database", "semi-automated", "alert", "success", "3 days ago", "4m 30s", 12, "Platform Team", null, null, 8),
        new("2", "SSL Certificate Renewal", "Security", "fully-automated", "scheduled", "success", "12 hours ago", "1m 45s", 6, "SRE Team", null, null, 47),
        new("3", "Incident Communication", "Incident", "semi-automated", "incident", "success", "5 days ago", "2m 10s", 8, "On-Call Lead", null, null, 23),
        new("4", "Cache Invalidation", "Infrastructure", "fully-automated", "manual", "failed", "2 hours ago", "45s", 4, "Backend Team", "Step 3: Verify CDN purge", "CDN API returned 503 \u2014 purge endpoint temporarily unavailable", 142),
        new("5", "User Data Export (GDPR)", "Compliance", "semi-automated", "manual", "success", "1 week ago", "8m 20s", 10, "Privacy Team", null, null, 19),
        new("6", "Capacity Scale-Up", "Infrastructure", "fully-automated", "alert", "success", "6 hours ago", "3m 15s", 7, "Platform Team", null, null, 89),
        new("7", "Dependency Vulnerability Patch", "Security", "manual", "alert", "failed", "2 days ago", "25m 00s", 15, "Security Team", "Step 11: Run integration tests", "3 integration tests failed after upgrading lodash to 4.17.21", 12),
        new("8", "DNS Failover to Secondary", "Network", "semi-automated", "incident", "never-run", "Never", "Est. 6m", 9, "Network Team", null, null, 0),
        new("9", "Log Rotation and Archive", "Infrastructure", "fully-automated", "scheduled", "success", "4 hours ago", "12m 40s", 5, "SRE Team", null, null, 365),
    ];
}
