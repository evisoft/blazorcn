        new EventEntry("2", "critical", "Payment webhook delivery failed after 3 retries", "stripe-webhook", "14:31:52",
            "Webhook endpoint returned 503 for event evt_1OxR2kB7sCx. Exhausted retry budget. Manual reconciliation required.",
            new Dictionary<string, string> { ["event_id"] = "evt_1OxR2kB7sCx", ["endpoint"] = "/api/stripe/webhook", ["attempts"] = "3", ["last_status"] = "503" }),
        new EventEntry("3", "warning", "Rate limit threshold at 80% for /api/v2/search", "rate-limiter", "14:31:24",
            "Client IP 203.0.113.42 approaching rate limit ceiling. Current: 320/400 requests in window. Auto-throttle engaged.",
            new Dictionary<string, string> { ["client_ip"] = "203.0.113.42", ["endpoint"] = "/api/v2/search", ["limit"] = "400/min", ["current"] = "320/min" }),
        new EventEntry("4", "info", "Auto-scaling triggered: web-pool scaled to 8 instances", "k8s-autoscaler", "14:30:15",
            "CPU utilization exceeded 75% threshold for 3 minutes. HPA scaled web-pool from 6 to 8 replicas. New pods ready in 42 seconds.",
            new Dictionary<string, string> { ["deployment"] = "web-pool", ["replicas"] = "6 → 8", ["trigger"] = "cpu > 75%", ["ready_time"] = "42s" }),
        new EventEntry("5", "info", "Certificate renewed for api.acme.com", "cert-manager", "14:28:00",
            "Let's Encrypt certificate renewed successfully. New expiry: 2026-06-15. OCSP stapling verified. No downtime.",
            new Dictionary<string, string> { ["domain"] = "api.acme.com", ["issuer"] = "Let's Encrypt R3", ["expires"] = "2026-06-15", ["type"] = "ECDSA P-256" }),
        new EventEntry("6", "warning", "Disk usage above 85% on worker-node-03", "node-monitor", "14:26:33",
            "Root filesystem at 87% utilization. Largest consumers: /var/log (12GB), /tmp/builds (8GB). Log rotation scheduled.",
            new Dictionary<string, string> { ["node"] = "worker-node-03", ["disk"] = "/dev/sda1", ["usage"] = "87%", ["available"] = "19 GB" }),
