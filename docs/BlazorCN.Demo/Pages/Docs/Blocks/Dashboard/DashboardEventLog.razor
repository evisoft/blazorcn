@* ============================================================
   Block: dashboard-event-log
   Title: Dashboard Event Log
   Description: Animated React real-time event log dashboard block for Next.js with severity filters, expandable event details, timestamps, source labels, and staggered entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: User activity timeline with avatars
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-event-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Event Log</span>
            <span class="text-muted-foreground text-xs tabular-nums">
                @_filteredEvents.Length events
            </span>
        </div>

        @* Filters *@
        <div class="flex items-center gap-2 border-b px-4 py-2.5">
            <LucideFunnelCn Size="12" Class="size-3.5 text-muted-foreground" />
            @foreach (var severity in _allSeverities)
                        {
                var sev = severity;
                <ButtonCn Variant="@(_activeFilters.Contains(sev) ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm"
                          Class="h-6 gap-1.5 px-2 text-xs"
                          OnClick="@(() => ToggleFilter(sev))">
                    <span class="@(Cn.Merge("size-1.5 rounded-full", _severityDot[sev]))"></span>
                    @_severityLabel[sev]
                </ButtonCn>
            }
        </div>

        @* Events *@
        <div>
            @for (var i = 0; i < _filteredEvents.Length; i++)
                        {
                var evt = _filteredEvents[i];
                var isExpanded = _expanded == evt.Id;
                var isLast = i == _filteredEvents.Length - 1;

                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = isExpanded ? null : evt.Id)"
                            class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", _severityDot[evt.Severity]))"></span>
                        <span class="w-14 shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                            @evt.Timestamp
                        </span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@evt.Message</span>
                        </div>
                        <span class="shrink-0 rounded bg-muted/50 px-1.5 py-0.5 text-muted-foreground text-xs">
                            @evt.Source
                        </span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                                {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-4 pl-9">
                                <p class="mb-3 text-muted-foreground text-sm leading-relaxed">
                                    @evt.Details
                                </p>
                                <div class="rounded-md bg-muted/50 p-3">
                                    <span class="mb-2 block font-medium text-muted-foreground text-xs">
                                        Metadata
                                    </span>
                                    <div class="space-y-1">
                                        @foreach (var kvp in evt.Metadata)
                                                    {
                                            <div class="flex items-center gap-2">
                                                <span class="w-28 shrink-0 font-mono text-muted-foreground text-xs">
                                                    @kvp.Key
                                                </span>
                                                <span class="font-mono text-xs">@kvp.Value</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record EventEntry(string Id, string Severity, string Message, string Source, string Timestamp, string Details, Dictionary<string, string> Metadata);

    private string? _expanded = "1";
    private HashSet<string> _activeFilters = new() { "critical", "warning", "info", "debug" };

    private readonly string[] _allSeverities = { "critical", "warning", "info", "debug" };

    private EventEntry[] _filteredEvents => _events.Where(e => _activeFilters.Contains(e.Severity)).ToArray();

    private void ToggleFilter(string severity)
    {
        if (_activeFilters.Contains(severity))
        {
            if (_activeFilters.Count > 1)
                _activeFilters.Remove(severity);
        }
        else
        {
            _activeFilters.Add(severity);
        }
    }

    private readonly Dictionary<string, string> _severityDot = new()
    {
        ["critical"] = "bg-red-500",
        ["warning"] = "bg-amber-500",
        ["info"] = "bg-blue-500",
        ["debug"] = "bg-foreground/30"
    };

    private readonly Dictionary<string, string> _severityLabel = new()
    {
        ["critical"] = "Critical",
        ["warning"] = "Warning",
        ["info"] = "Info",
        ["debug"] = "Debug"
    };

    private readonly EventEntry[] _events = new[]
    {
        new EventEntry("1", "critical", "Database connection pool exhausted", "db-primary", "14:32:08",
            "Maximum connections (100) reached. New queries are being queued. Pool drain started at 14:31:45. Oldest idle connection: 847ms.",
