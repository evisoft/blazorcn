@* ============================================================
   Block: dashboard-social-analytics
   Title: Dashboard Social Analytics
   Description: Animated React social media analytics dashboard block for Next.js with multi-platform metrics showing followers, engagement rates, post counts, and growth percentages for Twitter, LinkedIn, Instagram, and YouTube using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: KPI metric cards with trend indicators
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-social-analytics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Social Analytics</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Cross-platform performance overview
                </p>
            </div>
            <div class="text-right">
                <p class="text-muted-foreground text-xs">Total Followers</p>
                <span class="font-semibold text-sm tabular-nums">83.8K</span>
            </div>
        </div>

        <div class="hidden border-b px-4 py-2 sm:grid sm:grid-cols-[1fr_90px_90px_80px_80px]">
            <span class="text-muted-foreground text-xs">Platform</span>
            <span class="text-right text-muted-foreground text-xs">Followers</span>
            <span class="text-right text-muted-foreground text-xs">Engagement</span>
            <span class="text-right text-muted-foreground text-xs">Posts</span>
            <span class="text-right text-muted-foreground text-xs">Growth</span>
        </div>

        <div>
            @for (var i = 0; i < _platforms.Length; i++)
            {
                var platform = _platforms[i];
                var isLast = i == _platforms.Length - 1;
                <div class="@(Cn.Merge("grid items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50 sm:grid-cols-[1fr_90px_90px_80px_80px]", !isLast ? "border-b" : ""))">
                    <div class="flex items-center gap-3">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            @if (platform.Icon == "twitter")
                            {
                                <LucideTwitterCn Size="16" Class="size-4 text-muted-foreground" />
                            }
                            else if (platform.Icon == "linkedin")
                            {
                                <LucideLinkedinCn Size="16" Class="size-4 text-muted-foreground" />
                            }
                            else if (platform.Icon == "instagram")
                            {
                                <LucideInstagramCn Size="16" Class="size-4 text-muted-foreground" />
                            }
                            else
                            {
                                <LucideYoutubeCn Size="16" Class="size-4 text-muted-foreground" />
                            }
                        </div>
                        <span class="font-medium text-sm">@platform.Name</span>
                    </div>
                    <span class="text-right font-semibold text-sm tabular-nums">
                        @platform.Followers
                    </span>
                    <span class="text-right text-sm tabular-nums">@platform.Engagement</span>
                    <span class="text-right text-muted-foreground text-sm tabular-nums">
                        @platform.PostsThisMonth
                    </span>
                    <span class="@(Cn.Merge("flex items-center justify-end gap-0.5 text-xs", platform.Trend == "up" ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400"))">
                        @if (platform.Trend == "up")
                        {
                            <LucideArrowUpCn Size="12" Class="size-3" />
                        }
                        else
                        {
                            <LucideArrowDownCn Size="12" Class="size-3" />
                        }
                        @platform.Growth
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record PlatformData(string Id, string Name, string Icon, string Followers, string Engagement, int PostsThisMonth, string Growth, string Trend);

    private readonly PlatformData[] _platforms = new[]
    {
        new PlatformData("1", "Twitter", "twitter", "24.8K", "4.2%", 47, "+12.3%", "up"),
        new PlatformData("2", "LinkedIn", "linkedin", "18.3K", "6.8%", 22, "+8.7%", "up"),
        new PlatformData("3", "Instagram", "instagram", "31.5K", "5.1%", 34, "-2.4%", "down"),
        new PlatformData("4", "YouTube", "youtube", "9.2K", "8.4%", 8, "+22.1%", "up")
    };
}
