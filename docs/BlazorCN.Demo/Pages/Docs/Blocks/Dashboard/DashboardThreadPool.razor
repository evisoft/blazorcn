@* ============================================================
   Block: dashboard-thread-pool
   Title: Dashboard Thread Pool
   Description: Animated React thread pool monitoring block for Next.js with active idle and queued thread counts per service, utilization percentage bars, pool size limits, and animated staggered row entrance using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Message queue depth and processing metrics
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-thread-pool.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Thread Pool Monitor</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_pools.Length services \u00b7 @_overallUtil% overall utilization
                </p>
            </div>
            <div class="flex items-center gap-4 text-muted-foreground text-xs">
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="tabular-nums">@_totalActive</span> active
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                    <span class="tabular-nums">@_totalIdle</span> idle
                </span>
                @if (_totalQueued > 0)
                {
                    <span class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        <span class="tabular-nums">@_totalQueued</span> queued
                    </span>
                }
            </div>
        </div>

        @* Pool rows *@
        <div>
            @for (var i = 0; i < _pools.Length; i++)
            {
                var pool = _pools[i];
                var util = GetUtilization(pool);
                var isLast = i == _pools.Length - 1;
                <div class="@(Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b"))">
                    <div class="flex items-center gap-3">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", GetStatusDot(pool)))"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-mono font-medium text-sm">@pool.Service</span>
                                @if (pool.Queued > 0)
                                {
                                    <span class="text-amber-600 text-xs dark:text-amber-400">
                                        @pool.Queued queued
                                    </span>
                                }
                            </div>
                        </div>
                        <span class="@(Cn.Merge("font-semibold text-sm tabular-nums", GetUtilColor(util)))">
                            @util%
                        </span>
                    </div>

                    @* Thread breakdown *@
                    <div class="mt-2 pl-5">
                        <div class="mb-1.5 flex items-center gap-4 text-muted-foreground text-xs">
                            <span>
                                <span class="tabular-nums">@pool.Active</span> active
                            </span>
                            <span>\u00b7</span>
                            <span>
                                <span class="tabular-nums">@pool.Idle</span> idle
                            </span>
                            <span>\u00b7</span>
                            <span>
                                max <span class="tabular-nums">@pool.MaxSize</span>
                            </span>
                            <span class="ml-auto flex items-center gap-1">
                                <LucideActivityCn Size="12" Class="size-3" />
                                peak <span class="tabular-nums">@pool.PeakActive</span>
                            </span>
                        </div>

                        @* Utilization bar *@
                        <div class="flex h-2 overflow-hidden rounded-full bg-muted">
                            <div class="@(Cn.Merge("h-full", GetBarColor(util)))"
                                 style="@($"width: {(double)pool.Active / pool.MaxSize * 100:F1}%")"></div>
                            <div class="h-full bg-muted-foreground/10"
                                 style="@($"width: {(double)pool.Idle / pool.MaxSize * 100:F1}%")"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ThreadPool(string Id, string Service, int Active, int Idle, int Queued, int MaxSize, int PeakActive);

    private static int GetUtilization(ThreadPool pool) => (int)Math.Round((double)pool.Active / pool.MaxSize * 100);

    private static string GetUtilColor(int pct) =>
        pct >= 90 ? "text-red-600 dark:text-red-400"
        : pct >= 70 ? "text-amber-600 dark:text-amber-400"
        : "text-emerald-600 dark:text-emerald-400";

    private static string GetBarColor(int pct) =>
        pct >= 90 ? "bg-red-500/60"
        : pct >= 70 ? "bg-amber-500/60"
        : "bg-emerald-500/40";

    private static string GetStatusDot(ThreadPool pool)
    {
        var util = GetUtilization(pool);
        if (pool.Queued > 0 && util >= 90) return "bg-red-500";
        if (pool.Queued > 0) return "bg-amber-500";
        return "bg-emerald-500";
    }

    private static readonly ThreadPool[] _pools =
    [
        new("p1", "api-gateway", 42, 18, 0, 60, 56),
        new("p2", "auth-service", 28, 4, 7, 32, 32),
        new("p3", "payment-processor", 15, 25, 0, 40, 38),
        new("p4", "notification-worker", 48, 0, 23, 48, 48),
        new("p5", "search-indexer", 12, 36, 0, 48, 44),
        new("p6", "report-generator", 8, 8, 3, 16, 16),
    ];
    private static readonly int _totalQueued = _pools.Sum(p => p.Queued);
    private static readonly int _totalIdle = _pools.Sum(p => p.Idle);
    private static readonly int _totalActive = _pools.Sum(p => p.Active);
    private static readonly int _overallUtil = (int)Math.Round((double)_totalActive / _pools.Sum(p => p.MaxSize) * 100);

}
