@* ============================================================
   Block: dashboard-memory-allocation
   Title: Dashboard Memory Allocation
   Description: Animated React memory heap analysis dashboard for Next.js with allocation breakdown by module, garbage collection frequency, heap usage progress bars, and memory leak indicators using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: CPU, memory, and disk usage metrics
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-memory-allocation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideMemoryStickCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Memory Allocation</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">Node.js · v8 heap</p>
                </div>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="@(Cn.Merge("size-1.5 rounded-full", _heapColor))"></span>
                <span class="text-muted-foreground text-xs">
                    @(_heapPercent > 80 ? "Critical" : _heapPercent > 60 ? "Warning" : "Healthy")
                </span>
            </div>
        </div>

        @* Heap overview *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-baseline gap-1">
                    <span class="@(Cn.Merge("font-semibold text-2xl tabular-nums", _heapTextColor))">
                        @_heapUsed
                    </span>
                    <span class="text-muted-foreground text-xs">/ @_heapTotal GB used</span>
                </div>
                <span class="text-muted-foreground text-xs tabular-nums">@_heapLimit GB limit</span>
            </div>
            <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-muted">
                <div class="@(Cn.Merge("h-full rounded-full", _heapColor))"
                     style="@(FormattableString.Invariant($"width: {_heapPercent:F1}%"))">
                </div>
            </div>
        </div>

        @* GC metrics grid *@
        <div class="grid grid-cols-4 border-b">
            @for (var i = 0; i < _gcMetrics.Length; i++)
            {
                var metric = _gcMetrics[i];
                <div class="@(Cn.Merge("px-4 py-3", i < 3 ? "border-r" : ""))">
                    <span class="font-medium text-muted-foreground text-[10px]">@metric.Label</span>
                    <div class="mt-1 flex items-baseline gap-0.5">
                        <span class="font-semibold text-sm tabular-nums">@metric.Value</span>
                        <span class="text-muted-foreground text-[10px]">@metric.Unit</span>
                    </div>
                </div>
            }
        </div>

        @* Module allocation label *@
        <div class="border-b px-4 py-2">
            <span class="font-medium text-muted-foreground text-xs">Allocation by Module</span>
        </div>

        @* Module rows *@
        <div>
            @for (var i = 0; i < _modules.Length; i++)
            {
                var mod = _modules[i];
                var isLast = i == _modules.Length - 1;
                <div class="@(Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b"))">
                    <div class="flex items-center gap-3">
                        @switch (mod.Trend)
                        {
                            case "up":
                                <LucideArrowUpCn Size="12" Class="size-3 text-amber-500" />
                                break;
                            case "down":
                                <LucideArrowDownCn Size="12" Class="size-3 text-emerald-500" />
                                break;
                            default:
                                <LucideArrowRightCn Size="12" Class="size-3 text-muted-foreground" />
                                break;
                        }
                        <div class="min-w-0 flex-1">
                            <span class="font-mono text-sm">@mod.Module</span>
                        </div>
                        <span class="shrink-0 text-muted-foreground text-xs tabular-nums">
                            @mod.ObjectCount objects
                        </span>
                        <span class="shrink-0 font-medium text-xs tabular-nums">
                            @mod.AllocatedLabel
                        </span>
                        <span class="w-10 shrink-0 text-right text-muted-foreground text-xs tabular-nums">
                            @(mod.PercentOfHeap)%
                        </span>
                    </div>
                    <div class="mt-1.5 ml-6 h-1 overflow-hidden rounded-full bg-muted">
                        <div class="h-full rounded-full bg-muted-foreground/30"
                             style="@(FormattableString.Invariant($"width: {mod.PercentOfHeap}%"))">
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private const double _heapUsed = 1.82;
    private const double _heapTotal = 2.5;
    private const double _heapLimit = 4.0;
    private static readonly double _heapPercent = _heapUsed / _heapLimit * 100;

    private static readonly string _heapColor = _heapPercent > 80 ? "bg-red-500" : _heapPercent > 60 ? "bg-amber-500" : "bg-emerald-500";
    private static readonly string _heapTextColor = _heapPercent > 80
        ? "text-red-600 dark:text-red-400"
        : _heapPercent > 60
            ? "text-amber-600 dark:text-amber-400"
            : "text-emerald-600 dark:text-emerald-400";

    private record GcMetric(string Label, string Value, string Unit);
    private record ModuleAllocation(string Module, string AllocatedLabel, double PercentOfHeap, string Trend, string ObjectCount);

    private static readonly GcMetric[] _gcMetrics =
    [
        new("GC Frequency", "24", "/min"),
        new("Avg Pause", "4.2", "ms"),
        new("Max Pause", "18", "ms"),
        new("Total Reclaimed", "412", "MB"),
    ];

    private static readonly ModuleAllocation[] _modules =
    [
        new("http-request-handlers", "520 MB", 28.5, "stable", "2.4M"),
        new("database-connection-pool", "340 MB", 18.7, "up", "890K"),
        new("template-cache", "285 MB", 15.6, "stable", "1.2M"),
        new("session-store", "210 MB", 11.5, "up", "540K"),
        new("websocket-buffers", "180 MB", 9.9, "down", "320K"),
        new("json-serialization", "155 MB", 8.5, "stable", "1.8M"),
        new("other", "130 MB", 7.3, "stable", "680K"),
    ];
}
