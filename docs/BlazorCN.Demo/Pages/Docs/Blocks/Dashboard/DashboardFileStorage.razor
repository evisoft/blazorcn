@* ============================================================
   Block: dashboard-file-storage
   Title: Dashboard File Storage
   Description: Animated React file storage dashboard block for Next.js with categorized file type breakdown showing images documents videos audio and archives, individual and total quota usage bars, file count per category, and staggered entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Stacked bar showing disk space allocation
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-file-storage.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideFileCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">File Storage</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @_totalFiles.ToString("N0") files across @_categories.Length types
                    </p>
                </div>
            </div>
            <div class="text-right">
                <p class="font-semibold text-sm tabular-nums">
                    @(_totalUsed.ToString("F1")) GB
                    <span class="font-normal text-muted-foreground">/ @_quotaGb GB</span>
                </p>
                <p class="text-muted-foreground text-xs tabular-nums">@(_usedPercent)% used</p>
            </div>
        </div>

        @* Overall quota bar *@
        <div class="border-b px-4 py-3">
            <div class="h-2 w-full overflow-hidden rounded-full bg-muted/50">
                <div class="h-full rounded-full bg-foreground/20"
                     style="@($"width: {_usedPercent}%")">
                </div>
            </div>
        </div>

        @* Categories *@
        <div>
            @for (var i = 0; i < _categories.Length; i++)
            {
                var category = _categories[i];
                var pct = category.SizeGb / _quotaGb * 100;
                var isLast = i == _categories.Length - 1;
                <div class="@(Cn.Merge("px-4 py-3", isLast ? "" : "border-b"))">
                    <div class="flex items-center gap-3">
                        <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", category.DotColor))"></span>
                        @switch (category.Icon)
                        {
                            case "image":
                                <LucideImageCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                break;
                            case "file-text":
                                <LucideFileTextCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                break;
                            case "video":
                                <LucideVideoCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                break;
                            case "audio-lines":
                                <LucideAudioLinesCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                break;
                            case "archive":
                                <LucideArchiveCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                break;
                            case "code":
                                <LucideCodeCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                break;
                            case "type":
                                <LucideTypeCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                break;
                        }
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@category.Label</span>
                                <span class="text-muted-foreground text-xs tabular-nums">
                                    @category.FileCount.ToString("N0") files
                                </span>
                            </div>
                            <p class="mt-0.5 font-mono text-muted-foreground text-xs">
                                @category.Extensions
                            </p>
                        </div>
                        <span class="shrink-0 font-medium text-sm tabular-nums">
                            @category.SizeGb GB
                        </span>
                    </div>

                    <div class="mt-2 flex items-center gap-3 pl-[1.625rem]">
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted/50">
                            <div class="@(Cn.Merge("h-full rounded-full", category.BarColor))"
                                 style="@($"width: {pct:F1}%")">
                            </div>
                        </div>
                        <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                            @(pct.ToString("F1"))%
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private const int _quotaGb = 100;

    private record FileCategory(string Id, string Label, string Extensions, int FileCount, double SizeGb, string Icon, string DotColor, string BarColor);

    private static readonly FileCategory[] _categories =
    [
        new("images", "Images", ".png, .jpg, .webp, .svg", 12847, 28.4, "image", "bg-blue-500", "bg-blue-500/70"),
        new("documents", "Documents", ".pdf, .docx, .xlsx, .csv", 3219, 14.7, "file-text", "bg-emerald-500", "bg-emerald-500/70"),
        new("videos", "Videos", ".mp4, .mov, .webm", 284, 22.1, "video", "bg-purple-500", "bg-purple-500/70"),
        new("audio", "Audio", ".mp3, .wav, .ogg, .flac", 1563, 8.3, "audio-lines", "bg-amber-500", "bg-amber-500/70"),
        new("archives", "Archives", ".zip, .tar.gz, .rar", 427, 6.9, "archive", "bg-red-500", "bg-red-500/70"),
        new("code", "Code", ".ts, .tsx, .js, .py", 8941, 1.2, "code", "bg-cyan-500", "bg-cyan-500/70"),
        new("fonts", "Fonts", ".woff2, .ttf, .otf", 86, 0.4, "type", "bg-slate-500", "bg-slate-500/70"),
    ];

    private static readonly double _totalUsed = _categories.Sum(c => c.SizeGb);
    private static readonly int _totalFiles = _categories.Sum(c => c.FileCount);
    private static readonly int _usedPercent = (int)Math.Round(_totalUsed / _quotaGb * 100);
}
