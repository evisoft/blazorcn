@* ============================================================
   Block: dashboard-incident-timeline
   Title: Dashboard Incident Timeline
   Description: Animated React incident postmortem timeline dashboard block for Next.js with severity levels, incident duration tracking, owner assignments, resolution status, expandable root cause analysis, and staggered framer-motion animations using shadcn/ui and Tailwind CSS
   Long Description: Active incident tracking with severity levels
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-incident-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Incident Timeline</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Postmortem reviews and corrective actions
                </p>
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <span class="tabular-nums">@_incidents.Length incidents</span>
                <span class="text-muted-foreground">·</span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_incidents.Count(inc => inc.Resolution == "resolved") resolved
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_incidents.Count(inc => inc.Resolution == "action-items") pending
                </span>
            </div>
        </div>

        @* Incidents *@
        <div>
            @for (var i = 0; i < _incidents.Length; i++)
            {
                var incident = _incidents[i];
                var isExpanded = _expanded == incident.Id;
                var isLast = i == _incidents.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : incident.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("shrink-0 rounded px-1.5 py-0.5 font-mono text-[10px] font-medium", _severityColor[incident.Severity]))">
                            @incident.Severity
                        </span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@incident.Title</span>
                            </div>
                            <div class="mt-1 flex items-center gap-2">
                                <span class="font-mono text-muted-foreground text-[10px]">@incident.Id</span>
                                <span class="text-muted-foreground text-[10px]">·</span>
                                <span class="text-muted-foreground text-[10px]">@incident.Date</span>
                                <span class="text-muted-foreground text-[10px]">·</span>
                                <span class="font-mono text-muted-foreground text-[10px] tabular-nums">@incident.Duration</span>
                            </div>
                        </div>
                        <div class="flex shrink-0 items-center gap-3">
                            <span class="flex size-6 items-center justify-center rounded-full bg-muted font-medium text-[10px] text-muted-foreground">
                                @incident.OwnerInitials
                            </span>
                            <div class="flex items-center gap-1.5">
                                <span class="@(Cn.Merge("size-1.5 rounded-full", _resolutionDot[incident.Resolution]))"></span>
                            </div>
                            <LucideChevronRightCn Class="@(Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="space-y-3 px-4 pb-4 pl-14">
                            @* Affected systems *@
                            <div class="flex flex-wrap items-center gap-1.5">
                                @foreach (var sys in incident.Systems)
                                {
                                    <span class="rounded bg-muted/50 px-1.5 py-0.5 text-muted-foreground text-xs">
                                        @sys
                                    </span>
                                }
                                <span class="ml-2 flex items-center gap-1.5 text-xs">
                                    <span class="@(Cn.Merge("size-1.5 rounded-full", _resolutionDot[incident.Resolution]))"></span>
                                    <span class="text-muted-foreground">
                                        @_resolutionLabel[incident.Resolution]
                                    </span>
                                </span>
                            </div>

                            @* Root cause *@
                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                                    Root cause
                                </span>
                                <p class="text-sm leading-relaxed">@incident.RootCause</p>
                            </div>

                            @* Corrective actions *@
                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                                    Corrective actions
                                </span>
                                <p class="text-sm leading-relaxed">@incident.Corrective</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "PM-2024-018";

    private record IncidentItem(string Id, string Title, string Severity, string[] Systems, string Duration, string Owner, string OwnerInitials, string Date, string Resolution, string RootCause, string Corrective);

    private static readonly Dictionary<string, string> _severityColor = new()
    {
        ["SEV-1"] = "bg-red-500/10 text-red-600 dark:text-red-400",
        ["SEV-2"] = "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        ["SEV-3"] = "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        ["SEV-4"] = "bg-zinc-500/10 text-muted-foreground",
    };

    private static readonly Dictionary<string, string> _resolutionDot = new()
    {
        ["resolved"] = "bg-emerald-500",
        ["action-items"] = "bg-amber-500",
        ["open"] = "bg-red-500",
    };

    private static readonly Dictionary<string, string> _resolutionLabel = new()
    {
        ["resolved"] = "Resolved",
        ["action-items"] = "Action items pending",
        ["open"] = "Open",
    };

    private static readonly IncidentItem[] _incidents =
    [
        new("PM-2024-018", "Payment processing complete outage", "SEV-1", ["Payments API", "Checkout", "Billing"], "47 min", "Sarah Chen", "SC", "Mar 12", "resolved",
            "A misconfigured connection pool limit in the Stripe integration caused all payment threads to block after a traffic spike. The pool size was set to 10 instead of 100 during a config migration.",
            "Added connection pool size to infrastructure-as-code with automated validation. Created a load test that verifies pool exhaustion does not occur at 3x peak traffic."),
        new("PM-2024-017", "Search service returning stale results", "SEV-2", ["Search", "Product Catalog"], "2h 14 min", "Alex Rivera", "AR", "Mar 9", "resolved",
            "Elasticsearch index refresh interval was accidentally changed from 1s to 30s during an optimization experiment. This caused newly indexed products to not appear in search results for up to 30 seconds.",
            "Reverted refresh interval to 1s. Added a canary test that verifies new documents appear in search results within 2 seconds after indexing."),
        new("PM-2024-016", "CDN cache purge propagation delay", "SEV-3", ["CDN", "Static Assets"], "1h 38 min", "Jordan Park", "JP", "Mar 5", "action-items",
            "Regional cache purge requests were queuing behind a batch invalidation job that runs hourly. The purge API does not prioritize manual invalidations over scheduled ones.",
            "Implementing priority lanes for manual cache purges. Scheduled batch invalidations will use a separate queue with lower priority. Expected completion by end of sprint."),
        new("PM-2024-015", "Dashboard SSO login failures for Google accounts", "SEV-2", ["Auth Service", "Dashboard"], "28 min", "Morgan Lee", "ML", "Mar 2", "resolved",
            "Google OAuth token validation was failing because the JWKS endpoint cache expired and the refresh request timed out. The auth service had no fallback for cached JWKS keys.",
            "Added a stale-while-revalidate pattern for JWKS key caching. The auth service now serves from stale cache while refreshing keys in the background, preventing login failures during JWKS endpoint issues."),
        new("PM-2024-014", "Webhook delivery backlog exceeding SLA", "SEV-4", ["Webhooks"], "4h 20 min", "Alex Rivera", "AR", "Feb 27", "resolved",
            "A single customer endpoint was responding with 30-second timeouts, consuming all worker threads in the webhook delivery pool. No per-customer rate limiting or circuit breaking was in place.",
            "Implemented per-destination circuit breakers with a 5-second timeout. After 3 consecutive failures, deliveries to that endpoint are paused for 60 seconds before retrying."),
    ];
}
