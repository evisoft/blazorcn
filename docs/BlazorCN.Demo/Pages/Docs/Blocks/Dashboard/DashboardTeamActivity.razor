@* ============================================================
   Block: dashboard-team-activity
   Title: Dashboard Team Activity
   Description: Animated React dashboard team activity block for Next.js with team member list, task completion bars, roles, active projects, and last active timestamps using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Four KPI metric cards with trend indicators
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-team-activity.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <h2 class="font-medium text-sm">Team activity</h2>
                <span class="rounded bg-muted px-1.5 py-0.5 text-muted-foreground text-xs">
                    @_totalTasks tasks
                </span>
            </div>
            <span class="text-muted-foreground text-xs">This month</span>
        </div>
        <div>
            @for (var i = 0; i < _members.Length; i++)
            {
                var member = _members[i];
                var barWidth = (int)Math.Round((double)member.Tasks / _maxTasks * 100);
                var isLast = i == _members.Length - 1;
                <div class="@(Cn.Merge("px-4 py-3", isLast ? "" : "border-b"))">
                    <div class="flex items-center gap-3">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                            @member.Initials
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@member.Name</span>
                                <span class="text-muted-foreground text-xs">@member.Role</span>
                            </div>
                            <div class="mt-1.5 flex items-center gap-2">
                                <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                                    <div class="h-full rounded-full bg-foreground/80"
                                         style="@($"width: {barWidth}%")"></div>
                                </div>
                                <span class="w-6 shrink-0 text-right font-medium text-xs tabular-nums">
                                    @member.Tasks
                                </span>
                            </div>
                        </div>
                        <div class="hidden shrink-0 text-right sm:block">
                            <p class="text-xs">@member.Project</p>
                            <p class="mt-0.5 text-muted-foreground text-xs">@member.LastActive</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TeamMember(string Name, string Initials, string Role, int Tasks, string Project, string LastActive);

    private static readonly TeamMember[] _members =
    [
        new("Sarah Chen", "SC", "Lead Engineer", 47, "Platform v2", "Just now"),
        new("James Miller", "JM", "Frontend Dev", 38, "Dashboard Redesign", "5 min ago"),
        new("Emily Zhang", "EZ", "Designer", 42, "Design System", "12 min ago"),
        new("Michael Torres", "MT", "Backend Dev", 31, "API Gateway", "1 hr ago"),
        new("Aisha Patel", "AP", "Product Manager", 29, "Roadmap Q2", "2 hr ago"),
        new("David Kim", "DK", "DevOps", 35, "CI/CD Pipeline", "3 hr ago"),
    ];
    private static readonly int _totalTasks = _members.Sum(m => m.Tasks);

    private static readonly int _maxTasks = _members.Max(m => m.Tasks);
}
