@* ============================================================
   Block: dashboard-certificate-manager
   Title: Dashboard Certificate Manager
   Description: Animated React SSL certificate management dashboard block for Next.js with six certificates displaying monospaced domain names, issuer details, expiry dates with days remaining countdown, urgency-based color coding for expiring certificates, active and propagating status dots, and auto-renewal toggle indicators using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: DNS record management with propagation status
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-certificate-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Certificate Manager</span>
                <p class="mt-0.5 text-muted-foreground text-xs">SSL/TLS certificate inventory</p>
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                @if (_expiringCount > 0)
                {
                    <span class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        @_expiringCount expiring soon
                    </span>
                }
                <span>@_certificates.Length certificates</span>
            </div>
        </div>

        @* Column headers *@
        <div class="flex items-center gap-3 border-b bg-muted/30 px-4 py-2 text-muted-foreground text-xs">
            <span class="min-w-0 flex-1">Domain</span>
            <span class="hidden w-32 shrink-0 sm:block">Issuer</span>
            <span class="w-24 shrink-0 text-right">Expires</span>
            <span class="w-16 shrink-0 text-right">Days</span>
            <span class="w-20 shrink-0 text-center">Status</span>
            <span class="w-16 shrink-0 text-center">Renew</span>
        </div>

        @* Certificates *@
        <div>
            @for (var i = 0; i < _certificates.Length; i++)
            {
                var cert = _certificates[i];
                var isLast = i == _certificates.Length - 1;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b"))">
                    <div class="min-w-0 flex-1">
                        <span class="font-mono text-sm">@cert.Domain</span>
                    </div>
                    <span class="hidden w-32 shrink-0 truncate text-muted-foreground text-xs sm:block">
                        @cert.Issuer
                    </span>
                    <span class="w-24 shrink-0 text-right text-muted-foreground text-xs">
                        @cert.ExpiryDate
                    </span>
                    <span class="@(Cn.Merge("w-16 shrink-0 text-right font-semibold text-sm tabular-nums", GetDaysColor(cert.DaysRemaining)))">
                        @(cert.DaysRemaining)d
                    </span>
                    <div class="flex w-20 shrink-0 items-center justify-center gap-1.5">
                        <span class="@(Cn.Merge("size-1.5 rounded-full", GetStatusDot(cert.Status)))"></span>
                        <span class="text-muted-foreground text-xs">@(GetStatusLabel(cert.Status))</span>
                    </div>
                    <div class="flex w-16 shrink-0 items-center justify-center">
                        @if (cert.AutoRenew)
                        {
                            <LucideCheckCn Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                        }
                        else
                        {
                            <LucideXCn Class="size-3.5 text-muted-foreground/50" />
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record CertificateItem(string Domain, string Issuer, string ExpiryDate, int DaysRemaining, string Status, bool AutoRenew);

    private static string GetStatusDot(string status) => status switch
    {
        "active" => "bg-emerald-500",
        "propagating" => "bg-amber-500",
        "error" => "bg-red-500",
        _ => ""
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "active" => "Active",
        "propagating" => "Propagating",
        "error" => "Error",
        _ => ""
    };

    private static string GetDaysColor(int days)
    {
        if (days <= 14) return "text-red-600 dark:text-red-400";
        if (days <= 30) return "text-amber-600 dark:text-amber-400";
        return "text-muted-foreground";
    }

    private static readonly CertificateItem[] _certificates =
    [
        new("api.acme.com", "Let's Encrypt R3", "Apr 12, 2026", 25, "active", true),
        new("*.acme.com", "DigiCert SHA2", "Jun 08, 2026", 82, "active", true),
        new("dashboard.acme.com", "Let's Encrypt R3", "Mar 24, 2026", 6, "active", false),
        new("staging.acme.com", "Let's Encrypt R3", "May 19, 2026", 62, "propagating", true),
        new("mail.acme.com", "Sectigo RSA", "Mar 28, 2026", 10, "active", true),
        new("cdn.acme.com", "Cloudflare Inc", "Sep 14, 2026", 180, "active", true),
    ];

    private static readonly int _expiringCount = _certificates.Count(c => c.DaysRemaining <= 30);
}
