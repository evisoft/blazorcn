@* ============================================================
   Block: dashboard-disk-iops
   Title: Dashboard Disk Iops
   Description: Animated React disk IOPS and throughput monitoring dashboard block for Next.js with per-volume read/write metrics, latency indicators, queue depth bars, and utilization percentages using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: CPU, memory, and disk utilization
   Dependencies: BadgeCn
   Source: original/blocks/dashboard/dashboard-disk-iops.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideHardDriveCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Disk I/O</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_volumes.Length volumes
            </BadgeCn>
        </div>

        @* Summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div>
                <p class="text-muted-foreground text-xs">Read IOPS</p>
                <p class="font-semibold text-2xl tabular-nums">144.7K</p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">Write IOPS</p>
                <p class="font-semibold text-sm tabular-nums">104.6K</p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">Avg Latency</p>
                <p class="font-semibold text-sm tabular-nums">0.41ms</p>
            </div>
        </div>

        @* Volumes list *@
        <div>
            @for (var i = 0; i < _volumes.Length; i++)
            {
                var vol = _volumes[i];
                var isExpanded = _expanded == vol.Id;
                var isLast = i == _volumes.Length - 1;

                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : vol.Id)"
                        class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", GetUtilDot(vol.Utilization)))"></span>
                        <span class="min-w-0 flex-1 truncate font-mono text-xs">@vol.Name</span>
                        <span class="shrink-0 rounded bg-muted/50 px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">
                            @vol.Type
                        </span>
                        <span class="w-12 shrink-0 text-right text-muted-foreground text-xs tabular-nums">
                            @FormatIops(vol.ReadIops) R
                        </span>
                        <span class="w-12 shrink-0 text-right text-muted-foreground text-xs tabular-nums">
                            @FormatIops(vol.WriteIops) W
                        </span>
                        <span class="@(Cn.Merge("w-10 shrink-0 text-right font-medium text-xs tabular-nums", GetUtilColor(vol.Utilization)))">
                            @(vol.Utilization)%
                        </span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-3 px-4 pb-4 pt-1">
                                @* Utilization bar *@
                                <div>
                                    <div class="mb-1.5 flex items-center justify-between">
                                        <span class="text-muted-foreground text-xs">Utilization</span>
                                        <span class="@(Cn.Merge("font-medium text-xs tabular-nums", GetUtilColor(vol.Utilization)))">
                                            @(vol.Utilization)%
                                        </span>
                                    </div>
                                    <div class="h-2 overflow-hidden rounded-full bg-muted/50">
                                        <div class="@(Cn.Merge("h-full rounded-full", GetUtilBarColor(vol.Utilization)))"
                                             style="@($"width: {vol.Utilization}%")">
                                        </div>
                                    </div>
                                </div>

                                @* Metrics grid *@
                                <div class="rounded-md bg-muted/50 p-3">
                                    <div class="grid grid-cols-3 gap-y-2 text-xs">
                                        <div>
                                            <span class="text-muted-foreground">Read</span>
                                            <p class="font-medium tabular-nums">@vol.ReadMbps MB/s</p>
                                        </div>
                                        <div>
                                            <span class="text-muted-foreground">Write</span>
                                            <p class="font-medium tabular-nums">@vol.WriteMbps MB/s</p>
                                        </div>
                                        <div>
                                            <span class="text-muted-foreground">Latency</span>
                                            <p class="font-medium tabular-nums">@(vol.AvgLatencyMs)ms</p>
                                        </div>
                                        <div>
                                            <span class="text-muted-foreground">Queue Depth</span>
                                            <p class="font-medium tabular-nums">@vol.QueueDepth</p>
                                        </div>
                                        <div>
                                            <span class="text-muted-foreground">Capacity</span>
                                            <p class="font-medium tabular-nums">
                                                @(vol.CapacityGb >= 1000 ? $"{vol.CapacityGb / 1000} TB" : $"{vol.CapacityGb} GB")
                                            </p>
                                        </div>
                                        <div>
                                            <span class="text-muted-foreground">Total IOPS</span>
                                            <p class="font-medium tabular-nums">
                                                @FormatIops(vol.ReadIops + vol.WriteIops)
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "4";

    private record Volume(string Id, string Name, string Type, int ReadIops, int WriteIops, int ReadMbps, int WriteMbps, double AvgLatencyMs, int QueueDepth, int Utilization, int CapacityGb);

    private static string FormatIops(int iops)
    {
        if (iops >= 1000) return $"{iops / 1000.0:F1}K";
        return iops.ToString();
    }

    private static string GetUtilColor(int util)
    {
        if (util >= 85) return "text-red-600 dark:text-red-400";
        if (util >= 60) return "text-amber-600 dark:text-amber-400";
        return "text-emerald-600 dark:text-emerald-400";
    }

    private static string GetUtilDot(int util)
    {
        if (util >= 85) return "bg-red-500";
        if (util >= 60) return "bg-amber-500";
        return "bg-emerald-500";
    }

    private static string GetUtilBarColor(int util)
    {
        if (util >= 85) return "bg-red-500";
        if (util >= 60) return "bg-amber-500";
        return "bg-foreground/20";
    }

    private static readonly Volume[] _volumes =
    [
        new("1", "/dev/nvme0n1", "NVMe", 45200, 28400, 1840, 920, 0.12, 8, 42, 500),
        new("2", "/dev/nvme1n1", "NVMe", 68300, 52100, 2650, 1840, 0.28, 24, 78, 1000),
        new("3", "/dev/sda", "SSD", 12800, 8400, 520, 340, 0.45, 12, 64, 2000),
        new("4", "/dev/sdb", "SSD", 18200, 15600, 680, 580, 0.82, 32, 91, 500),
        new("5", "/dev/sdc", "HDD", 180, 120, 145, 98, 8.4, 4, 38, 8000),
    ];
}
