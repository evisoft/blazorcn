@* ============================================================
   Block: dashboard-feature-adoption
   Title: Dashboard Feature Adoption
   Description: Animated feature adoption rate dashboard for React and Next.js with eight features showing adoption percentage bars with animated widths, user counts, trend arrows, and sorted display using framer-motion, shadcn/ui, and Tailwind CSS
   Long Description: Customer segmentation dashboard
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-feature-adoption.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Feature Adoption</span>
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs">Avg adoption</span>
                <span class="font-medium text-sm tabular-nums">@(_avgAdoption)%</span>
            </div>
        </div>

        @* Features *@
        <div>
            @for (var i = 0; i < _features.Length; i++)
            {
                var feature = _features[i];
                var isLast = i == _features.Length - 1;
                <div class="@(Cn.Merge("px-4 py-3", isLast ? "" : "border-b"))">
                    <div class="mb-1.5 flex items-center justify-between">
                        <span class="font-medium text-sm">@feature.Name</span>
                        <div class="flex items-center gap-3">
                            <span class="text-muted-foreground text-xs tabular-nums">
                                @feature.Users users
                            </span>
                            <span class="@(Cn.Merge("flex items-center gap-0.5 text-xs tabular-nums", GetTrendColor(feature.Trend)))">
                                @if (feature.Trend == "up")
                                {
                                    <LucideArrowUpRightCn Size="12" Class="size-3" />
                                }
                                else if (feature.Trend == "down")
                                {
                                    <LucideArrowDownRightCn Size="12" Class="size-3" />
                                }
                                else
                                {
                                    <LucideMinusCn Size="12" Class="size-3" />
                                }
                                @feature.Change
                            </span>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground/70"
                                 style="@($"width: {feature.Adoption}%")">
                            </div>
                        </div>
                        <span class="w-8 shrink-0 text-right font-medium text-xs tabular-nums">
                            @(feature.Adoption)%
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Feature(string Name, int Adoption, string Users, string Trend, string Change);

    private static string GetTrendColor(string trend) => trend switch
    {
        "up" => "text-emerald-600 dark:text-emerald-400",
        "down" => "text-red-600 dark:text-red-400",
        _ => "text-muted-foreground",
    };

    private static readonly Feature[] _features =
    [
        new("Dashboard", 94, "12,840", "up", "+2.1%"),
        new("Team Collaboration", 76, "10,384", "up", "+5.4%"),
        new("API Integrations", 68, "9,291", "up", "+8.2%"),
        new("Custom Reports", 52, "7,104", "down", "-1.3%"),
        new("Automated Workflows", 41, "5,602", "up", "+12.7%"),
        new("Advanced Analytics", 33, "4,509", "flat", "0.0%"),
        new("SSO Authentication", 24, "3,278", "up", "+3.6%"),
        new("Audit Logging", 18, "2,462", "down", "-0.8%"),
    ];

    private static readonly int _avgAdoption = (int)Math.Round(_features.Average(f => f.Adoption));
}
