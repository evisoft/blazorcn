@* ============================================================
   Block: dashboard-customer-segments
   Title: Dashboard Customer Segments
   Description: Animated customer segmentation dashboard for React and Next.js with five segments showing revenue share bars, customer counts, average deal sizes, and churn rates in a two-column layout using framer-motion, shadcn/ui, and Tailwind CSS
   Long Description: Revenue by source visualization
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-customer-segments.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Customer Segments</span>
            <div class="flex items-center gap-3">
                <span class="text-muted-foreground text-xs">
                    <span class="font-medium text-foreground tabular-nums">14,097</span> total customers
                </span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs">
                    <span class="font-medium text-foreground tabular-nums">$4.2M</span> ARR
                </span>
            </div>
        </div>

        @* Column Headers *@
        <div class="grid grid-cols-[1fr_80px_80px_80px_80px] items-center gap-2 border-b bg-muted/30 px-4 py-2">
            <span class="text-muted-foreground text-xs">Segment</span>
            <span class="text-right text-muted-foreground text-xs">Customers</span>
            <span class="text-right text-muted-foreground text-xs">Revenue</span>
            <span class="text-right text-muted-foreground text-xs">Avg Deal</span>
            <span class="text-right text-muted-foreground text-xs">Churn</span>
        </div>

        @* Segments *@
        <div>
            @for (var i = 0; i < _segments.Length; i++)
            {
                var segment = _segments[i];
                var isLast = i == _segments.Length - 1;
                <div class="@(Cn.Merge("grid grid-cols-[1fr_80px_80px_80px_80px] items-center gap-2 px-4 py-3", isLast ? "" : "border-b"))">
                    @* Segment name + revenue bar *@
                    <div class="min-w-0">
                        <span class="font-medium text-sm">@segment.Name</span>
                        <div class="mt-1.5 flex items-center gap-2">
                            <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                                <div class="@(Cn.Merge("h-full rounded-full", segment.Color))"
                                     style="@($"width: {segment.RevenueShare}%")">
                                </div>
                            </div>
                            <span class="shrink-0 text-muted-foreground text-[10px] tabular-nums">
                                @(segment.RevenueShare)%
                            </span>
                        </div>
                    </div>

                    <span class="text-right font-medium text-sm tabular-nums">@segment.Customers</span>
                    <span class="text-right text-muted-foreground text-xs tabular-nums">@(segment.RevenueShare)%</span>
                    <span class="text-right font-mono text-xs tabular-nums">@segment.AvgDealSize</span>
                    <span class="@(Cn.Merge("text-right font-medium text-xs tabular-nums", ChurnColor(segment.ChurnRate)))">
                        @(segment.ChurnRate)%
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Segment(string Name, string Customers, int RevenueShare, string AvgDealSize, double ChurnRate, string Color);

    private static string ChurnColor(double rate)
    {
        if (rate < 3) return "text-emerald-600 dark:text-emerald-400";
        if (rate < 8) return "text-amber-600 dark:text-amber-400";
        return "text-red-600 dark:text-red-400";
    }

    private static readonly Segment[] _segments =
    [
        new("Enterprise", "142", 45, "$148,000", 2.1, "bg-foreground"),
        new("Mid-Market", "489", 28, "$24,500", 4.8, "bg-foreground/70"),
        new("SMB", "1,847", 16, "$3,200", 7.2, "bg-foreground/50"),
        new("Startup", "3,216", 8, "$890", 11.4, "bg-foreground/35"),
        new("Individual", "8,403", 3, "$120", 15.8, "bg-foreground/20"),
    ];
}
