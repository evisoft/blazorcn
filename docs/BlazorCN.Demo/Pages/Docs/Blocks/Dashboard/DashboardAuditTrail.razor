@* ============================================================
   Block: dashboard-audit-trail
   Title: Dashboard Audit Trail
   Description: Animated React security audit trail block for Next.js with event type chips, user details, resource paths, IP addresses, risk indicators, and staggered row animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Threat score and vulnerability summary
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-audit-trail.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Audit Trail</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Recent security events across all services
                </p>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @(_events.Count(e => e.Risk == "high")) high
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @(_events.Count(e => e.Risk == "medium")) medium
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @(_events.Count(e => e.Risk == "low")) low
                </span>
            </div>
        </div>

        <div>
            @for (var i = 0; i < _events.Length; i++)
                        {
                var evt = _events[i];
                var index = i;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", (index < _events.Length - 1 ? "border-b" : "")))">
                    <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">
                        @evt.Initials
                    </div>

                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@evt.UserName</span>
                    </div>

                    <span class="@(Cn.Merge("inline-flex shrink-0 items-center rounded-md px-2 py-0.5 text-[11px] font-medium", _actionStyles[evt.Action]))">
                        @evt.Action
                    </span>

                    <span class="hidden w-40 truncate font-mono text-muted-foreground text-xs sm:block">
                        @evt.Resource
                    </span>

                    <span class="hidden w-28 shrink-0 font-mono text-muted-foreground text-xs md:block">
                        @evt.Ip
                    </span>

                    <div class="flex w-16 shrink-0 items-center gap-1.5">
                        <span class="@(Cn.Merge("size-1.5 rounded-full", _riskDot[evt.Risk]))"></span>
                        <span class="text-muted-foreground text-xs">@_riskLabel[evt.Risk]</span>
                    </div>

                    <span class="w-16 shrink-0 text-right text-muted-foreground text-xs">
                        @evt.Timestamp
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record AuditEvent(string Id, string Action, string UserName, string Initials, string Resource, string Ip, string Risk, string Timestamp);

    private readonly Dictionary<string, string> _actionStyles = new()
    {
        ["Login"] = "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        ["Export"] = "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        ["Delete"] = "bg-red-500/10 text-red-700 dark:text-red-400",
        ["Settings"] = "bg-violet-500/10 text-violet-700 dark:text-violet-400",
        ["Permission"] = "bg-red-500/10 text-red-700 dark:text-red-400",
        ["Upload"] = "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400"
    };

    private readonly Dictionary<string, string> _riskDot = new()
    {
        ["high"] = "bg-red-500",
        ["medium"] = "bg-amber-500",
        ["low"] = "bg-emerald-500"
    };

    private readonly Dictionary<string, string> _riskLabel = new()
    {
        ["high"] = "High",
        ["medium"] = "Medium",
        ["low"] = "Low"
    };

    private readonly AuditEvent[] _events = new[]
