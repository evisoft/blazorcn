@* ============================================================
   Block: dashboard-queue-monitor
   Title: Dashboard Queue Monitor
   Description: Animated React message queue monitoring dashboard block for Next.js with four queues displaying monospaced names, pending message counts with tabular number formatting, processing rates, average wait times, consumer counts, dead letter queue indicators with red highlighting, and animated queue depth bars using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: ETL pipeline status and throughput metrics
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-queue-monitor.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Queue Monitor</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Message queue health and throughput
                </p>
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <span class="tabular-nums">@_totalPending.ToString("N0") pending</span>
                @if (_totalDeadLetters > 0)
                {
                    <span class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        @_totalDeadLetters dead letters
                    </span>
                }
            </div>
        </div>

        @* Column headers *@
        <div class="flex items-center gap-3 border-b bg-muted/30 px-4 py-2 text-muted-foreground text-xs">
            <span class="min-w-0 flex-1">Queue</span>
            <span class="w-20 shrink-0 text-right">Pending</span>
            <span class="hidden w-16 shrink-0 text-right sm:block">Rate</span>
            <span class="hidden w-16 shrink-0 text-right sm:block">Avg wait</span>
            <span class="w-20 shrink-0 text-right">Consumers</span>
            <span class="w-16 shrink-0 text-right">DLQ</span>
        </div>

        @* Queues *@
        <div>
            @for (var i = 0; i < _queues.Length; i++)
            {
                var queue = _queues[i];
                var barPct = (double)queue.Pending / _maxPending * 100;
                var isLast = i == _queues.Length - 1;
                <div class="@(Cn.Merge("px-4 py-3", isLast ? "" : "border-b"))">
                    <div class="flex items-center gap-3">
                        <div class="min-w-0 flex-1">
                            <span class="font-mono text-sm">@queue.Name</span>
                        </div>
                        <span class="w-20 shrink-0 text-right font-semibold text-sm tabular-nums">
                            @queue.Pending.ToString("N0")
                        </span>
                        <span class="hidden w-16 shrink-0 text-right font-mono text-muted-foreground text-xs tabular-nums sm:block">
                            @queue.ProcessingRate
                        </span>
                        <span class="hidden w-16 shrink-0 text-right font-mono text-muted-foreground text-xs tabular-nums sm:block">
                            @queue.AvgWaitTime
                        </span>
                        <span class="w-20 shrink-0 text-right text-muted-foreground text-xs tabular-nums">
                            @queue.Consumers active
                        </span>
                        <span class="@(Cn.Merge("w-16 shrink-0 text-right font-mono text-xs tabular-nums", queue.DeadLetters > 0 ? "font-medium text-red-600 dark:text-red-400" : "text-muted-foreground"))">
                            @queue.DeadLetters
                        </span>
                    </div>
                    <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-muted/50">
                        <div class="h-full rounded-full bg-foreground/70" style="@($"width: {barPct:F1}%")"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record QueueItem(string Name, int Pending, string ProcessingRate, string AvgWaitTime, int Consumers, int DeadLetters);

    private const int _maxPending = 12840;

    private static readonly QueueItem[] _queues =
    [
        new("orders.process", 1247, "142/s", "1.2s", 8, 3),
        new("emails.send", 4521, "89/s", "3.8s", 4, 0),
        new("analytics.events", 12840, "2.1K/s", "0.4s", 12, 0),
        new("webhooks.deliver", 382, "67/s", "2.1s", 3, 14),
    ];
    private static readonly int _totalDeadLetters = _queues.Sum(q => q.DeadLetters);

    private static readonly int _totalPending = _queues.Sum(q => q.Pending);
}
