@* ============================================================
   Block: dashboard-cpu-utilization
   Title: Dashboard Cpu Utilization
   Description: Animated React CPU utilization dashboard block for Next.js with per-service usage bars, instance counts, load averages, core allocation, and animated progress indicators using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: CPU, memory, and disk utilization
   Dependencies: BadgeCn
   Source: original/blocks/dashboard/dashboard-cpu-utilization.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideCpuCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">CPU Utilization</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="@(Cn.Merge("size-1.5 rounded-full", GetUsageDot(_avgUsage)))"></span>
                <span class="text-muted-foreground text-xs">@_totalInstances instances</span>
            </div>
        </div>

        @* Summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div>
                <p class="text-muted-foreground text-xs">Avg Usage</p>
                <p class="@(Cn.Merge("font-semibold text-2xl tabular-nums", GetUsageTextColor(_avgUsage)))">
                    @(_avgUsage)%
                </p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">Cores</p>
                <p class="font-semibold text-sm tabular-nums">
                    @_allocatedCores/@_totalCores
                </p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">Services</p>
                <p class="font-semibold text-sm tabular-nums">@_services.Length</p>
            </div>
            <div class="ml-auto flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_services.Count(s => s.Usage >= 85)
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_services.Count(s => s.Usage >= 60 && s.Usage < 85)
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_services.Count(s => s.Usage < 60)
                </span>
            </div>
        </div>

        @* Services *@
        <div>
            @for (var i = 0; i < _services.Length; i++)
            {
                var service = _services[i];
                var isLast = i == _services.Length - 1;
                <div class="@(Cn.Merge("px-4 py-2.5", isLast ? "" : "border-b"))">
                    <div class="flex items-center gap-3">
                        <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", GetUsageDot(service.Usage)))"></span>
                        <span class="min-w-0 flex-1 font-medium text-sm">@service.Name</span>
                        <span class="text-muted-foreground text-xs">@service.Instances inst</span>
                        <span class="text-muted-foreground text-xs">·</span>
                        <span class="text-muted-foreground text-xs tabular-nums">
                            @service.LoadAvg load
                        </span>
                        <span class="text-muted-foreground text-xs">·</span>
                        <span class="text-muted-foreground text-xs tabular-nums">
                            @service.AllocatedCores/@service.Cores cores
                        </span>
                        <span class="@(Cn.Merge("w-10 text-right font-medium text-xs tabular-nums", GetUsageTextColor(service.Usage)))">
                            @(service.Usage)%
                        </span>
                    </div>
                    <div class="mt-1.5 ml-[18px] h-1.5 overflow-hidden rounded-full bg-muted/50">
                        <div class="@(Cn.Merge("h-full rounded-full", GetUsageColor(service.Usage)))"
                             style="@($"width: {service.Usage}%")">
                        </div>
                    </div>
                    <div class="mt-1 ml-[18px]">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 font-normal text-[10px]">
                            @service.Trend
                        </BadgeCn>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ServiceCpu(string Name, int Usage, int Cores, int AllocatedCores, int Instances, string LoadAvg, string Trend);

    private static string GetUsageColor(int usage)
    {
        if (usage < 60) return "bg-emerald-500";
        if (usage < 85) return "bg-amber-500";
        return "bg-red-500";
    }

    private static string GetUsageTextColor(int usage)
    {
        if (usage < 60) return "text-emerald-600 dark:text-emerald-400";
        if (usage < 85) return "text-amber-600 dark:text-amber-400";
        return "text-red-600 dark:text-red-400";
    }

    private static string GetUsageDot(int usage)
    {
        if (usage < 60) return "bg-emerald-500";
        if (usage < 85) return "bg-amber-500";
        return "bg-red-500";
    }

    private static readonly int _totalCores = 88;
    private static readonly int _allocatedCores = 64;
    private static readonly int _avgUsage = 52;
    private static readonly int _totalInstances = 23;

    private static readonly ServiceCpu[] _services =
    [
        new("api-gateway", 42, 8, 4, 3, "0.68", "Stable"),
        new("auth-service", 28, 4, 2, 2, "0.34", "Stable"),
        new("order-processor", 78, 8, 6, 4, "1.12", "Increasing"),
        new("search-indexer", 91, 16, 14, 2, "1.84", "Critical"),
        new("ml-inference", 67, 32, 24, 6, "0.89", "Elevated"),
        new("notification-worker", 15, 2, 1, 2, "0.12", "Stable"),
        new("media-transcoder", 85, 16, 12, 3, "1.42", "Scaling up"),
        new("cron-scheduler", 8, 2, 1, 1, "0.06", "Stable"),
    ];
}
