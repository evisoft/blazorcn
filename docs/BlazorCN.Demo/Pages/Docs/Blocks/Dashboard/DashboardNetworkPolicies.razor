@* ============================================================
   Block: dashboard-network-policies
   Title: Dashboard Network Policies
   Description: Animated React Kubernetes network policy dashboard block for Next.js with eight policies displaying namespace labels, ingress and egress direction chips, CIDR ranges, port specifications, enforcement status indicators, and staggered row entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Pod status and resource consumption
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-network-policies.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideNetworkCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Network Policies</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @_policies.Length policies across @_namespaces.Length namespaces
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_enforcedCount enforced
                </span>
            </div>
        </div>

        @* Column headers *@
        <div class="flex items-center gap-3 border-b bg-muted/30 px-4 py-2 text-muted-foreground text-xs">
            <span class="w-16 shrink-0">Status</span>
            <span class="min-w-0 flex-1">Policy</span>
            <span class="w-20 shrink-0">Namespace</span>
            <span class="w-16 shrink-0 text-center">Direction</span>
            <span class="w-14 shrink-0 text-right">Pods</span>
            <span class="w-5 shrink-0"></span>
        </div>

        @* Policies *@
        <div>
            @for (var i = 0; i < _policies.Length; i++)
                        {
                var policy = _policies[i];
                var isExpanded = _expanded == policy.Id;
                var isLast = i == _policies.Length - 1;
                var dir = _directionStyle[policy.Direction];
                var status = _statusStyle[policy.Status];

                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = isExpanded ? null : policy.Id)"
                            class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                        <div class="flex w-16 shrink-0 items-center gap-1.5">
                            <span class="@(Cn.Merge("size-1.5 rounded-full", status.Dot))"></span>
                            <span class="text-muted-foreground text-xs">@status.Label</span>
                        </div>
                        <span class="min-w-0 flex-1 truncate font-mono font-medium text-sm">
                            @policy.Name
                        </span>
                        <span class="w-20 shrink-0 rounded bg-muted/80 px-1.5 py-0.5 text-center text-muted-foreground text-xs">
                            @policy.Namespace
                        </span>
                        <span class="@(Cn.Merge("w-16 shrink-0 rounded px-1.5 py-0.5 text-center font-medium text-xs", dir.Bg, dir.Text))">
                            @dir.Label
                        </span>
                        <span class="w-14 shrink-0 text-right font-mono text-muted-foreground text-xs tabular-nums">
                            @policy.MatchedPods
                        </span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                                {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-3 pl-[5.5rem]">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <div class="space-y-2 text-xs">
                                        <div>
                                            <span class="text-muted-foreground">Pod selector</span>
                                            <p class="mt-0.5 font-mono font-medium">@policy.PodSelector</p>
                                        </div>
                                        <div>
                                            <span class="text-muted-foreground">
                                                @(policy.Direction == "egress" ? "Destinations" : "Sources")
                                            </span>
                                            <div class="mt-1 flex flex-wrap gap-1.5">
                                                @foreach (var src in policy.Sources)
                                                            {
                                                    <span class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs">
                                                        @src
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                        <div>
                                            <span class="text-muted-foreground">Ports</span>
                                            <div class="mt-1 flex flex-wrap gap-1.5">
                                                @foreach (var port in policy.Ports)
                                                            {
                                                    <span class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs">
                                                        @port
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                        <div class="pt-1 text-muted-foreground">
                                            Last audit: @policy.LastAudit
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record NetworkPolicy(string Id, string Name, string Namespace, string Direction, string PodSelector, string[] Sources, string[] Ports, string Status, int MatchedPods, string LastAudit);
    private record DirectionStyle(string Bg, string Text, string Label);
    private record StatusStyle(string Dot, string Label);

    private string? _expanded;

    private int _enforcedCount => _policies.Count(p => p.Status == "enforced");
    private string[] _namespaces => _policies.Select(p => p.Namespace).Distinct().ToArray();

    private readonly Dictionary<string, DirectionStyle> _directionStyle = new()
    {
        ["ingress"] = new("bg-blue-500/10", "text-blue-600 dark:text-blue-400", "Ingress"),
        ["egress"] = new("bg-purple-500/10", "text-purple-600 dark:text-purple-400", "Egress"),
        ["both"] = new("bg-amber-500/10", "text-amber-600 dark:text-amber-400", "Both")
    };

    private readonly Dictionary<string, StatusStyle> _statusStyle = new()
    {
        ["enforced"] = new("bg-emerald-500", "Enforced"),
        ["audit"] = new("bg-amber-500", "Audit"),
        ["disabled"] = new("bg-zinc-400", "Disabled")
    };

    private readonly NetworkPolicy[] _policies = new[]
    {
        new NetworkPolicy("1", "allow-frontend-to-api", "production", "egress", "app=frontend",
            new[] { "10.0.1.0/24", "10.0.2.0/24" }, new[] { "TCP/443", "TCP/8080" }, "enforced", 12, "4 hours ago"),
        new NetworkPolicy("2", "deny-all-default", "production", "both", "all pods",
            new[] { "0.0.0.0/0" }, new[] { "all" }, "enforced", 84, "4 hours ago"),
        new NetworkPolicy("3", "allow-db-access", "production", "ingress", "app=postgres",
            new[] { "app=api", "app=worker" }, new[] { "TCP/5432" }, "enforced", 3, "4 hours ago"),
        new NetworkPolicy("4", "allow-monitoring", "monitoring", "ingress", "app=prometheus",
            new[] { "namespace=production", "namespace=staging" }, new[] { "TCP/9090", "TCP/9093" }, "enforced", 2, "6 hours ago"),
        new NetworkPolicy("5", "allow-dns-egress", "production", "egress", "all pods",
            new[] { "kube-system/kube-dns" }, new[] { "UDP/53", "TCP/53" }, "enforced", 84, "4 hours ago"),
        new NetworkPolicy("6", "staging-permissive", "staging", "both", "all pods",
            new[] { "10.0.0.0/8" }, new[] { "all" }, "audit", 31, "12 hours ago"),
        new NetworkPolicy("7", "block-external-redis", "production", "ingress", "app=redis",
            new[] { "10.0.3.0/24" }, new[] { "TCP/6379" }, "enforced", 6, "4 hours ago"),
        new NetworkPolicy("8", "dev-unrestricted", "development", "both", "all pods",
            new[] { "0.0.0.0/0" }, new[] { "all" }, "disabled", 0, "Never")
    };
}
