@* ============================================================
   Block: dashboard-customer-feedback
   Title: Dashboard Customer Feedback
   Description: Animated React customer feedback dashboard block for Next.js with NPS score display, CSAT rating, response count, promoter and detractor breakdown bars, and four recent feedback items with sentiment indicators and quote previews using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Sales pipeline with deal tracking
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-customer-feedback.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with NPS *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Customer Feedback</span>
                <span class="text-muted-foreground text-xs">Last 30 days</span>
            </div>
            <div class="mt-3 flex items-center gap-6">
                <div>
                    <span class="font-semibold text-2xl tabular-nums text-emerald-600 dark:text-emerald-400">
                        @_npsScore
                    </span>
                    <p class="text-muted-foreground text-xs">NPS Score</p>
                </div>
                <div class="h-8 w-px bg-border"></div>
                <div>
                    <span class="font-semibold text-sm tabular-nums">@_csatScore</span>
                    <span class="text-muted-foreground text-xs">/5</span>
                    <p class="text-muted-foreground text-xs">CSAT</p>
                </div>
                <div class="h-8 w-px bg-border"></div>
                <div>
                    <span class="font-semibold text-sm tabular-nums">@_totalResponses</span>
                    <p class="text-muted-foreground text-xs">Responses</p>
                </div>
            </div>
        </div>

        @* Breakdown Bars *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Score Breakdown</span>
            </div>
            <div class="flex h-3 overflow-hidden rounded-full">
                <div class="bg-emerald-500" style="@($"width: {_promoters}%")"></div>
                <div class="bg-amber-400" style="@($"width: {_passives}%")"></div>
                <div class="bg-red-500" style="@($"width: {_detractors}%")"></div>
            </div>
            <div class="mt-2 flex items-center gap-4">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Promoters @(_promoters)%
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-400"></span>
                    Passives @(_passives)%
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    Detractors @(_detractors)%
                </span>
            </div>
        </div>

        @* Recent Feedback *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Recent Feedback</span>
            </div>
            @for (var i = 0; i < _feedbackItems.Length; i++)
            {
                var item = _feedbackItems[i];
                var isLast = i == _feedbackItems.Length - 1;
                <div class="@(Cn.Merge("px-4 py-3", !isLast ? "border-b" : ""))">
                    <div class="flex items-start gap-2">
                        <span class="@(Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", _sentimentDot[item.Sentiment]))"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@item.Name</span>
                                <span class="text-muted-foreground text-xs">·</span>
                                <span class="text-muted-foreground text-xs">@item.TimeAgo</span>
                            </div>
                            <p class="mt-1 text-muted-foreground text-sm leading-relaxed line-clamp-2">
                                "@item.Quote"
                            </p>
                            <span class="mt-1 inline-block text-muted-foreground text-xs">
                                @item.Source
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record FeedbackItem(string Name, string Sentiment, string Quote, string Source, string TimeAgo);

    private const int _npsScore = 72;
    private const string _csatScore = "4.2";
    private const string _totalResponses = "1,847";
    private const int _promoters = 62;
    private const int _passives = 28;
    private const int _detractors = 10;

    private static readonly Dictionary<string, string> _sentimentDot = new()
    {
        ["positive"] = "bg-emerald-500",
        ["neutral"] = "bg-amber-500",
        ["negative"] = "bg-red-500",
    };

    private static readonly FeedbackItem[] _feedbackItems =
    [
        new("Rebecca Chen", "positive", "The onboarding flow was seamless. I had my team set up within minutes and the dashboard customization options are exactly what we needed.", "In-app survey", "3 hours ago"),
        new("James Morton", "negative", "Export functionality needs work. CSV exports are missing column headers and the PDF reports don't include the date range in the footer.", "Support ticket", "5 hours ago"),
        new("Priya Sharma", "positive", "Your API documentation is outstanding. Integration took half the time we budgeted. The webhook retry logic saved us from building our own.", "NPS survey", "1 day ago"),
        new("Daniel Okafor", "neutral", "Solid product overall but the mobile experience could be better. Charts are hard to read on smaller screens and some buttons are too close together.", "In-app survey", "2 days ago"),
    ];
}
