@* ============================================================
   Block: dashboard-platform-overview
   Title: Dashboard Platform Overview
   Description: Animated React platform health overview dashboard block for Next.js showing uptime percentage, active users, API latency, and error rate in a two-by-two metric grid with a system status list of six services with status dot indicators and a view status page link using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Service uptime with status indicators
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-platform-overview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Platform Health</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">System metrics and service status</p>
        </div>

        @* 2x2 metric grid *@
        <div class="grid grid-cols-2 border-b">
            @for (var i = 0; i < _metrics.Length; i++)
            {
                var metric = _metrics[i];
                <div class="@(Cn.Merge("px-4 py-4", i < 2 ? "border-b" : "", i % 2 == 0 ? "border-r" : ""))">
                    <p class="text-muted-foreground text-xs">@metric.Label</p>
                    <p class="@(Cn.Merge("mt-1 font-semibold text-2xl tabular-nums", metric.Color))">
                        @metric.Value
                    </p>
                </div>
            }
        </div>

        @* System status header *@
        <div class="border-b px-4 py-2">
            <p class="font-medium text-muted-foreground text-xs">System Status</p>
        </div>

        @* Service list *@
        <div>
            @for (var i = 0; i < _services.Length; i++)
            {
                var service = _services[i];
                var isLast = i == _services.Length - 1;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b"))">
                    <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", _statusColor[service.Status]))"></span>
                    <span class="flex-1 text-sm">@service.Name</span>
                    <span class="text-muted-foreground text-xs">@_statusLabel[service.Status]</span>
                </div>
            }
        </div>

        @* Footer link *@
        <div class="border-t px-4 py-2.5">
            <a href="#"
               class="inline-flex items-center gap-1.5 text-muted-foreground text-xs transition-colors hover:text-foreground">
                View status page
                <LucideExternalLinkCn Size="12" Class="size-3" />
            </a>
        </div>
    </div>
</section>

@code {
    private record PlatformMetric(string Label, string Value, string Color);
    private record ServiceItem(string Name, string Status);

    private static readonly Dictionary<string, string> _statusColor = new()
    {
        ["operational"] = "bg-emerald-500",
        ["degraded"] = "bg-amber-500",
        ["outage"] = "bg-red-500",
    };

    private static readonly Dictionary<string, string> _statusLabel = new()
    {
        ["operational"] = "Operational",
        ["degraded"] = "Degraded",
        ["outage"] = "Outage",
    };

    private static readonly PlatformMetric[] _metrics =
    [
        new("Uptime", "99.97%", "text-emerald-600 dark:text-emerald-400"),
        new("Active Users", "12.4K", ""),
        new("API Latency (p50)", "45ms", ""),
        new("Error Rate", "0.02%", "text-emerald-600 dark:text-emerald-400"),
    ];

    private static readonly ServiceItem[] _services =
    [
        new("API Gateway", "operational"),
        new("Authentication", "operational"),
        new("Database Cluster", "operational"),
        new("CDN / Edge Network", "operational"),
        new("Background Jobs", "degraded"),
        new("Webhook Delivery", "operational"),
    ];
}
