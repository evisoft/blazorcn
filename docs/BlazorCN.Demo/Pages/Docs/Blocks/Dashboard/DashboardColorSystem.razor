@* ============================================================
   Block: dashboard-color-system
   Title: Dashboard Color System
   Description: Animated React design system color audit dashboard block for Next.js with color token list, contrast ratio scores, WCAG compliance indicators, usage counts, swatch previews, and expandable token details using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: React Code Review Queue Dashboard Block
   Dependencies: BadgeCn, LucideCheckCn, LucideXCn, LucideChevronRightCn
   Source: original/blocks/dashboard/dashboard-color-system.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Color System Audit</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_tokens.Length tokens · @_totalUsages.ToString("N0") total usages
                </p>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_passingCount AA pass
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_failingCount AA fail
                </span>
            </div>
        </div>

        @* Token rows *@
        <div>
            @for (var i = 0; i < _tokens.Length; i++)
            {
                var token = _tokens[i];
                var isExpanded = _expanded == token.Id;
                var isLast = i == _tokens.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = isExpanded ? null : token.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="size-5 shrink-0 rounded border"
                              style="@($"background-color: {token.Hex}")"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@token.Name</span>
                            <p class="mt-0.5 font-mono text-muted-foreground text-xs">@token.Variable</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="font-mono text-muted-foreground text-xs tabular-nums">
                                @token.ContrastOnWhite.ToString("F1"):1
                            </span>
                            <span class="@(Cn.Merge("inline-flex items-center gap-0.5 rounded px-1 py-0.5 text-[10px] font-medium", token.WcagAA ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : "bg-red-500/10 text-red-600 dark:text-red-400"))">
                                @if (token.WcagAA)
                                {
                                    <LucideCheckCn Class="size-2.5" />
                                }
                                else
                                {
                                    <LucideXCn Class="size-2.5" />
                                }
                                AA
                            </span>
                            @if (token.WcagAAA)
                            {
                                <span class="inline-flex items-center gap-0.5 rounded bg-emerald-500/10 px-1 py-0.5 text-[10px] font-medium text-emerald-600 dark:text-emerald-400">
                                    <LucideCheckCn Class="size-2.5" />
                                    AAA
                                </span>
                            }
                            <span class="text-muted-foreground text-xs tabular-nums">@token.UsageCount</span>
                        </div>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-4 pl-12">
                                <div class="mb-3 grid grid-cols-3 gap-2">
                                    <div class="rounded-md bg-muted/50 p-2.5">
                                        <span class="text-muted-foreground text-xs">HEX</span>
                                        <span class="block font-mono text-xs">@token.Hex</span>
                                    </div>
                                    <div class="rounded-md bg-muted/50 p-2.5">
                                        <span class="text-muted-foreground text-xs">HSL</span>
                                        <span class="block font-mono text-xs">@token.Hsl</span>
                                    </div>
                                    <div class="rounded-md bg-muted/50 p-2.5">
                                        <span class="text-muted-foreground text-xs">On dark</span>
                                        <span class="block font-mono text-xs tabular-nums">
                                            @token.ContrastOnBlack.ToString("F1"):1
                                        </span>
                                    </div>
                                </div>
                                <div>
                                    <span class="font-medium text-muted-foreground text-xs">Used in</span>
                                    <div class="mt-1.5 flex flex-wrap gap-1.5">
                                        @foreach (var component in token.UsedIn)
                                        {
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-[10px] font-normal">
                                                @component
                                            </BadgeCn>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "c3";

    private record ColorToken(string Id, string Name, string Variable, string Hex, string Hsl,
        double ContrastOnWhite, double ContrastOnBlack, bool WcagAA, bool WcagAAA, int UsageCount, string[] UsedIn);

    private static readonly ColorToken[] _tokens =
    [
        new("c1", "Primary", "--color-primary", "#1A1A1A", "0 0% 10%", 16.75, 1.25, true, true, 342, ["Button", "Link", "Heading", "NavItem", "Badge"]),
        new("c2", "Primary Foreground", "--color-primary-foreground", "#FAFAFA", "0 0% 98%", 1.03, 20.3, true, true, 189, ["Button label", "Badge label", "Tooltip"]),
        new("c3", "Muted Foreground", "--color-muted-foreground", "#737373", "0 0% 45%", 4.48, 4.69, false, false, 528, ["Caption", "Placeholder", "Secondary text", "Timestamp", "Label"]),
        new("c4", "Destructive", "--color-destructive", "#DC2626", "0 84% 60%", 4.63, 4.53, true, false, 67, ["ErrorMessage", "DeleteButton", "Alert"]),
        new("c5", "Success", "--color-success", "#16A34A", "142 76% 36%", 3.56, 5.89, false, false, 45, ["SuccessMessage", "StatusDot", "CheckIcon"]),
        new("c6", "Warning", "--color-warning", "#D97706", "32 95% 44%", 3.36, 6.24, false, false, 38, ["WarningBanner", "StatusDot", "AlertTriangle"]),
        new("c7", "Border", "--color-border", "#E5E5E5", "0 0% 90%", 1.24, 16.92, false, false, 412, ["Card", "Input", "Separator", "Table", "Divider"]),
        new("c8", "Accent", "--color-accent", "#2563EB", "217 91% 60%", 4.56, 4.6, true, false, 124, ["Link hover", "Focus ring", "ActiveTab", "ProgressBar"]),
    ];

    private static readonly int _totalUsages = _tokens.Sum(t => t.UsageCount);
    private static readonly int _passingCount = _tokens.Count(t => t.WcagAA);
    private static readonly int _failingCount = _tokens.Count(t => !t.WcagAA);
}
