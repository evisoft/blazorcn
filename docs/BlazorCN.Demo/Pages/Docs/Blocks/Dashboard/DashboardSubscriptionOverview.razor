@* ============================================================
   Block: dashboard-subscription-overview
   Title: Dashboard Subscription Overview
   Description: Animated React subscription management dashboard block for Next.js with current plan display, price and renewal date, usage progress bars for seats, storage, and API limits, upgrade CTA button, and expandable plan comparison table using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Feature availability matrix across plans
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-subscription-overview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Subscription</span>
            <span class="inline-flex items-center rounded-full bg-emerald-500/10 px-2 py-0.5 font-medium text-[10px] text-emerald-600 dark:text-emerald-400">
                Active
            </span>
        </div>

        @* Current plan *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <div class="flex items-baseline gap-2">
                    <span class="font-semibold text-2xl tabular-nums">$39</span>
                    <span class="text-muted-foreground text-xs">/ month</span>
                </div>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Pro plan \u00b7 Renews Apr 17, 2026
                </p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Upgrade Plan
            </ButtonCn>
        </div>

        @* Usage limits *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Usage</span>
            <div class="mt-2 space-y-3">
                @foreach (var item in _usage)
                {
                    var percent = (int)Math.Round((double)item.Used / item.Limit * 100);
                    <div>
                        <div class="mb-1 flex items-center justify-between">
                            <span class="text-xs">@item.Label</span>
                            <span class="font-medium text-xs tabular-nums">
                                @FormatUsage(item.Used) / @FormatLimit(item.Limit)
                                <span class="font-normal text-muted-foreground">@item.Unit</span>
                            </span>
                        </div>
                        <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                            <div class="@(Cn.Merge("h-full rounded-full", percent >= 90 ? "bg-red-500" : percent >= 70 ? "bg-amber-500" : "bg-emerald-500"))"
                                 style="@($"width: {percent}%")"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Plan comparison toggle *@
        <div>
            <button
                type="button"
                @onclick="@(() => _showComparison = !_showComparison)"
                class="flex w-full items-center gap-2 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                <span class="flex-1 font-medium text-sm">Compare plans</span>
                <LucideChevronRightCn Class="@(Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", _showComparison ? "rotate-90" : ""))" />
            </button>

            @if (_showComparison)
            {
                <div class="border-t px-4 pb-3">
                    @* Plan headers *@
                    <div class="flex items-center border-b py-2">
                        <span class="min-w-0 flex-1 text-muted-foreground text-xs"></span>
                        <span class="w-20 text-center text-muted-foreground text-xs">Free</span>
                        <span class="w-20 text-center font-medium text-xs">Pro</span>
                        <span class="w-20 text-center text-muted-foreground text-xs">Enterprise</span>
                    </div>

                    @* Feature rows *@
                    @for (var i = 0; i < _comparisonFeatures.Length; i++)
                    {
                        var feature = _comparisonFeatures[i];
                        var isLast = i == _comparisonFeatures.Length - 1;
                        <div class="@(Cn.Merge("flex items-center py-2", isLast ? "" : "border-b"))">
                            <span class="min-w-0 flex-1 text-sm">@feature.Name</span>
                            <span class="@(Cn.Merge("flex w-20 items-center justify-center text-xs", "text-muted-foreground"))">
                                @if (feature.Free == null)
                                {
                                    <LucideXCn Size="16" Class="size-4 text-muted-foreground/30" />
                                }
                                else if (feature.Free == _checkMark)
                                {
                                    <LucideCheckCn Size="16" Class="size-4 text-emerald-500" />
                                }
                                else
                                {
                                    @feature.Free
                                }
                            </span>
                            <span class="flex w-20 items-center justify-center font-medium text-xs">
                                @if (feature.Pro == null)
                                {
                                    <LucideXCn Size="16" Class="size-4 text-muted-foreground/30" />
                                }
                                else if (feature.Pro == _checkMark)
                                {
                                    <LucideCheckCn Size="16" Class="size-4 text-emerald-500" />
                                }
                                else
                                {
                                    @feature.Pro
                                }
                            </span>
                            <span class="@(Cn.Merge("flex w-20 items-center justify-center text-xs", "text-muted-foreground"))">
                                @if (feature.Enterprise == null)
                                {
                                    <LucideXCn Size="16" Class="size-4 text-muted-foreground/30" />
                                }
                                else if (feature.Enterprise == _checkMark)
                                {
                                    <LucideCheckCn Size="16" Class="size-4 text-emerald-500" />
                                }
                                else
                                {
                                    @feature.Enterprise
                                }
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private bool _showComparison;

    private const string _checkMark = "\u2713";

    private record UsageLimit(string Label, int Used, int Limit, string Unit);
    private record ComparisonFeature(string Name, string? Free, string? Pro, string? Enterprise);

    private static string FormatUsage(int used) =>
        used >= 1000 ? $"{(double)used / 1000:F1}k" : used.ToString();

    private static string FormatLimit(int limit) =>
        limit >= 1000 ? $"{limit / 1000}k" : limit.ToString();

    private static readonly UsageLimit[] _usage =
    [
        new("Team seats", 3, 5, "seats"),
        new("Storage", 18, 25, "GB"),
        new("API calls", 42800, 50000, "calls/mo"),
    ];

    private static readonly ComparisonFeature[] _comparisonFeatures =
    [
        new("Team seats", "1", "5", "Unlimited"),
        new("Storage", "1 GB", "25 GB", "500 GB"),
        new("API calls", "1,000/mo", "50,000/mo", "Unlimited"),
        new("Custom domains", null, _checkMark, _checkMark),
        new("Priority support", null, null, _checkMark),
        new("SSO / SAML", null, null, _checkMark),
        new("Audit logs", null, _checkMark, _checkMark),
        new("Advanced analytics", null, _checkMark, _checkMark),
    ];
}
