@* ============================================================
   Block: dashboard-token-usage
   Title: Dashboard Token Usage
   Description: Animated React AI token usage dashboard block for Next.js with total tokens consumed, monthly cost tracking, per-model breakdown with horizontal usage bars for GPT-4 Claude and embeddings, daily usage mini bar chart, and budget utilization indicators using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: API endpoint usage tracking with rate limits
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-token-usage.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Token Usage</span>
                <p class="mt-0.5 text-muted-foreground text-xs">Current billing period</p>
            </div>
            <span class="text-muted-foreground text-xs">@_usagePercent% of quota</span>
        </div>

        @* Stats row *@
        <div class="flex items-center gap-6 border-b px-4 py-3">
            <div>
                <span class="text-muted-foreground text-xs">Tokens used</span>
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-2xl tabular-nums">
                        @FormatTokens(_totalTokens)
                    </span>
                    <span class="text-muted-foreground text-xs">/ @FormatTokens(_tokenLimit)</span>
                </div>
            </div>
            <div>
                <span class="text-muted-foreground text-xs">Cost</span>
                <p class="font-semibold text-2xl tabular-nums">@_totalCost</p>
            </div>
        </div>

        @* Overall usage bar *@
        <div class="border-b px-4 py-3">
            <div class="h-2 overflow-hidden rounded-full bg-muted/50">
                <div class="h-full rounded-full bg-foreground"
                     style="@($"width: {_usagePercent}%")"></div>
            </div>
        </div>

        @* Model breakdown *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Model breakdown</span>
            <div class="mt-3 space-y-3">
                @foreach (var model in _models)
                {
                    var pct = (double)model.Tokens / _totalTokens * 100;
                    <div>
                        <div class="mb-1 flex items-center justify-between">
                            <span class="text-sm">@model.Name</span>
                            <div class="flex items-center gap-2">
                                <span class="font-mono text-muted-foreground text-xs tabular-nums">
                                    @FormatTokens(model.Tokens)
                                </span>
                                <span class="text-muted-foreground text-xs">@model.Cost</span>
                            </div>
                        </div>
                        <div class="h-1.5 overflow-hidden rounded-full bg-muted/50">
                            <div class="h-full rounded-full bg-foreground/70"
                                 style="@(FormattableString.Invariant($"width: {pct:F1}%"))"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Daily usage chart *@
        <div class="px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Daily usage (K tokens)</span>
            <div class="mt-3 flex items-end gap-2">
                @for (var i = 0; i < _dailyUsage.Length; i++)
                {
                    var value = _dailyUsage[i];
                    var heightPx = (int)Math.Round((double)value / _maxDaily * 60);
                    heightPx = Math.Max(heightPx, 4);
                    <div class="flex flex-1 flex-col items-center gap-1">
                        <span class="font-mono text-muted-foreground text-xs tabular-nums">
                            @value
                        </span>
                        <div class="w-full rounded-sm bg-foreground/20"
                             style="@($"height: {heightPx}px")"></div>
                        <span class="text-muted-foreground text-xs">@_dayLabels[i]</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Model(string Name, int Tokens, int Total, string Cost);

    private const int _totalTokens = 2_400_000;
    private const int _tokenLimit = 5_000_000;
    private const string _totalCost = "$48.20";
    private static readonly int _usagePercent = (int)Math.Round((double)_totalTokens / _tokenLimit * 100);

    private static string FormatTokens(int n) =>
        n >= 1_000_000 ? $"{(double)n / 1_000_000:F1}M"
        : n >= 1_000 ? $"{n / 1_000}K"
        : n.ToString();

    private static readonly Model[] _models =
    [
        new("GPT-4", 1_200_000, 5_000_000, "$28.40"),
        new("Claude", 800_000, 5_000_000, "$14.60"),
        new("Embeddings", 400_000, 5_000_000, "$5.20"),
    ];

    private static readonly int[] _dailyUsage = [320, 410, 380, 520, 290, 450, 360];
    private static readonly string[] _dayLabels = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    private const int _maxDaily = 520;
}
