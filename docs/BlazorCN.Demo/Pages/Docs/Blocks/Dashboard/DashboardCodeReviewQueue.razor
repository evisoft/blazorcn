@* ============================================================
   Block: dashboard-code-review-queue
   Title: Dashboard Code Review Queue
   Description: Animated React code review queue dashboard block for Next.js with pull request list showing assignee avatars, review age indicators, priority labels, diff size badges, approval status, and expandable PR details using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Pull request review time analytics
   Dependencies: LucideGitPullRequestCn, LucideMessageSquareCn, LucideChevronRightCn
   Source: original/blocks/dashboard/dashboard-code-review-queue.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideGitPullRequestCn Class="size-3.5 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Review Queue</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @_reviews.Length PRs awaiting review
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_reviews.Count(r => r.AgeHours >= 48) overdue
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_reviews.Count(r => r.Priority is "critical" or "high") urgent
                </span>
            </div>
        </div>

        @* PR rows *@
        <div>
            @for (var i = 0; i < _reviews.Length; i++)
            {
                var pr = _reviews[i];
                var isExpanded = _expanded == pr.Id;
                var isLast = i == _reviews.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = isExpanded ? null : pr.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", GetPriorityDot(pr.Priority)))"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-mono text-muted-foreground text-xs">#@pr.Number</span>
                                <span class="truncate font-medium text-sm">@pr.Title</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span class="flex size-4 items-center justify-center rounded-full bg-muted text-[8px] font-medium">
                                    @pr.AuthorInitials
                                </span>
                                <span class="@GetAgeColor(pr.AgeHours)">@pr.Age</span>
                                <span>·</span>
                                <span class="@(Cn.Merge("inline-flex items-center rounded px-1 py-0.5 text-[10px] font-medium", GetSizeColor(pr.Size)))">
                                    @pr.Size
                                </span>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                <LucideMessageSquareCn Class="size-3" />
                                <span class="tabular-nums">@pr.Comments</span>
                            </span>
                            <span class="text-muted-foreground text-xs tabular-nums">
                                @pr.Approvals/@pr.ApprovalsRequired
                            </span>
                            <LucideCircleDotCn Class="@(Cn.Merge("size-3.5", GetCiColor(pr.CiStatus)))" />
                        </div>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-4 pl-9">
                                <p class="mb-3 text-muted-foreground text-sm leading-relaxed">
                                    @pr.Description
                                </p>
                                <div class="rounded-md bg-muted/50 p-3">
                                    <div class="flex items-center gap-4 text-xs">
                                        <span class="font-mono text-muted-foreground">@pr.Branch</span>
                                        <span class="text-muted-foreground">·</span>
                                        <span class="tabular-nums text-emerald-600 dark:text-emerald-400">
                                            +@pr.LinesAdded
                                        </span>
                                        <span class="tabular-nums text-red-600 dark:text-red-400">
                                            -@pr.LinesRemoved
                                        </span>
                                        <span class="text-muted-foreground">·</span>
                                        <span class="text-muted-foreground">@pr.FilesChanged files</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record PullRequestItem(string Id, int Number, string Title, string AuthorInitials, string Branch,
        string Age, int AgeHours, string Priority, string Size, int LinesAdded, int LinesRemoved,
        int FilesChanged, int Approvals, int ApprovalsRequired, int Comments, string CiStatus, string Description);

    private static string GetPriorityDot(string priority) => priority switch
    {
        "critical" => "bg-red-500",
        "high" => "bg-amber-500",
        "normal" => "bg-blue-500",
        "low" => "bg-muted-foreground/40",
        _ => ""
    };

    private static string GetSizeColor(string size) => size switch
    {
        "XS" or "S" => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        "M" => "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        "L" or "XL" => "bg-red-500/10 text-red-600 dark:text-red-400",
        _ => ""
    };

    private static string GetCiColor(string status) => status switch
    {
        "passing" => "text-emerald-600 dark:text-emerald-400",
        "failing" => "text-red-600 dark:text-red-400",
        "pending" => "text-amber-600 dark:text-amber-400",
        _ => ""
    };

    private static string GetAgeColor(int hours)
    {
        if (hours >= 48) return "text-red-600 dark:text-red-400";
        if (hours >= 24) return "text-amber-600 dark:text-amber-400";
        return "text-muted-foreground";
    }

    private static readonly PullRequestItem[] _reviews =
    [
        new("pr1", 1247, "feat: add multi-tenant workspace isolation", "SC", "feat/workspace-isolation", "2 days", 48, "critical", "XL", 1842, 234, 28, 1, 2, 14, "passing", "Implements row-level security for workspace data isolation. Adds tenant middleware and migrates existing queries to use workspace-scoped contexts."),
        new("pr2", 1251, "fix: resolve race condition in auth token refresh", "MW", "fix/token-refresh-race", "18 hours", 18, "high", "S", 45, 12, 3, 0, 1, 3, "passing", "Adds mutex lock around token refresh to prevent multiple simultaneous refresh attempts. Includes retry logic with exponential backoff."),
        new("pr3", 1253, "feat: implement webhook retry with dead letter queue", "ER", "feat/webhook-dlq", "6 hours", 6, "normal", "L", 624, 89, 12, 1, 2, 7, "passing", "Adds exponential backoff retry for failed webhook deliveries. After 5 attempts, events are moved to a dead letter queue for manual inspection."),
        new("pr4", 1255, "refactor: migrate Stripe integration to v2 SDK", "DP", "refactor/stripe-v2", "3 days", 72, "high", "L", 512, 478, 15, 0, 2, 22, "failing", "Migrates from Stripe Node SDK v14 to v16 with breaking changes. Updates all webhook handlers, checkout flow, and subscription management."),
        new("pr5", 1258, "docs: update API reference for rate limiting changes", "PS", "docs/rate-limit-api", "2 hours", 2, "low", "M", 186, 42, 8, 0, 1, 0, "passing", "Updates API reference documentation to reflect new rate limit headers and response codes. Adds examples for handling 429 responses."),
        new("pr6", 1260, "test: add integration tests for billing edge cases", "JL", "test/billing-edge-cases", "4 hours", 4, "normal", "M", 340, 0, 5, 1, 1, 2, "pending", "Adds integration tests covering prorated upgrades, mid-cycle cancellations, and invoice generation for team plan changes."),
    ];
}
