@* ============================================================
   Block: dashboard-backup-status
   Title: Dashboard Backup Status
   Description: Animated React backup management dashboard block for Next.js with last backup timestamp, next scheduled time, total storage size, retention period, six recent backups showing type chips for full and incremental, file sizes, durations, status dots, and restore buttons using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Service availability tracking with status bars
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-backup-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Backup Status</span>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-muted-foreground text-xs">Healthy</span>
            </div>
        </div>

        @* Summary stats *@
        <div class="grid grid-cols-2 border-b sm:grid-cols-4">
            <div class="border-b border-r px-4 py-3 sm:border-b-0">
                <span class="text-muted-foreground text-xs">Last Backup</span>
                <p class="mt-0.5 font-medium text-sm">Today, 03:00</p>
            </div>
            <div class="border-b px-4 py-3 sm:border-b-0 sm:border-r">
                <span class="text-muted-foreground text-xs">Next Scheduled</span>
                <p class="mt-0.5 font-medium text-sm">Today, 15:00</p>
            </div>
            <div class="border-r px-4 py-3">
                <span class="text-muted-foreground text-xs">Total Size</span>
                <p class="mt-0.5 font-semibold text-2xl tabular-nums">
                    148<span class="ml-0.5 font-normal text-muted-foreground text-xs">GB</span>
                </p>
            </div>
            <div class="px-4 py-3">
                <span class="text-muted-foreground text-xs">Retention</span>
                <p class="mt-0.5 font-medium text-sm">30 days</p>
            </div>
        </div>

        @* Recent backups *@
        <div>
            <div class="px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Recent Backups</span>
            </div>
            @for (var i = 0; i < _backups.Length; i++)
            {
                var backup = _backups[i];
                var isLast = i == _backups.Length - 1;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b"))">
                    <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", GetStatusDot(backup.Status)))"></span>
                    <span class="@(Cn.Merge("inline-flex shrink-0 items-center rounded px-1.5 py-0.5 font-medium text-[10px]", GetTypeStyle(backup.Type)))">
                        @(backup.Type == "full" ? "Full" : "Incr")
                    </span>
                    <span class="min-w-0 flex-1 text-muted-foreground text-xs">
                        @backup.Timestamp
                    </span>
                    <span class="hidden shrink-0 text-muted-foreground text-xs sm:inline">
                        @backup.Duration
                    </span>
                    <span class="shrink-0 font-medium text-xs tabular-nums">@backup.Size</span>
                    <span class="hidden shrink-0 text-muted-foreground text-xs sm:inline">
                        @(GetStatusLabel(backup.Status))
                    </span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" Disabled="@(backup.Status == "failed")">
                        Restore
                    </ButtonCn>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record BackupItem(string Type, string Size, string Duration, string Status, string Timestamp);

    private static string GetTypeStyle(string type) => type switch
    {
        "full" => "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        "incremental" => "bg-purple-500/10 text-purple-600 dark:text-purple-400",
        _ => ""
    };

    private static string GetStatusDot(string status) => status switch
    {
        "completed" => "bg-emerald-500",
        "running" => "bg-blue-500",
        "failed" => "bg-red-500",
        _ => ""
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "completed" => "Completed",
        "running" => "Running",
        "failed" => "Failed",
        _ => ""
    };

    private static readonly BackupItem[] _backups =
    [
        new("full", "24.8 GB", "18m 42s", "completed", "Today, 03:00"),
        new("incremental", "1.2 GB", "2m 15s", "completed", "Yesterday, 15:00"),
        new("incremental", "890 MB", "1m 48s", "completed", "Yesterday, 03:00"),
        new("full", "24.6 GB", "19m 08s", "completed", "Mar 15, 03:00"),
        new("incremental", "2.1 GB", "3m 22s", "failed", "Mar 14, 15:00"),
        new("incremental", "1.5 GB", "2m 31s", "completed", "Mar 14, 03:00"),
    ];
}
