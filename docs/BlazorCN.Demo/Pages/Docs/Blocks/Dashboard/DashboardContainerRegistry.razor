@* ============================================================
   Block: dashboard-container-registry
   Title: Dashboard Container Registry
   Description: Animated React container image registry dashboard block for Next.js with Docker image listing, tag versions, compressed sizes, pull counts, vulnerability badges, and expandable tag history using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Deployment pipeline with environment tracking
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/dashboard/dashboard-container-registry.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideBoxCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Container Registry</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-muted-foreground text-xs">@_images.Length images</span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs">@_totalPulls pulls</span>
            </div>
        </div>

        @* Images *@
        <div>
            @for (var i = 0; i < _images.Length; i++)
                        {
                var image = _images[i];
                var isExpanded = _expanded == image.Id;
                var isLast = i == _images.Length - 1;

                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : image.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", _vulnDot[image.VulnSeverity]))"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@image.Name</span>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="font-mono text-muted-foreground text-xs">@image.LatestTag</span>
                                <span class="text-muted-foreground text-xs">·</span>
                                <span class="text-muted-foreground text-xs">@image.Size</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="text-muted-foreground text-xs tabular-nums">@image.Pulls pulls</span>
                            <span class="@(Cn.Merge("flex items-center gap-1 text-xs", _vulnColors[image.VulnSeverity]))">
                                <LucideShieldCheckCn Size="12" Class="size-3" />
                                @(image.Vulnerabilities == 0 ? "Clean" : $"{image.Vulnerabilities} CVEs")
                            </span>
                        </div>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                                {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-3 pt-0">
                                <div class="rounded-md bg-muted/30">
                                    <div class="flex items-center gap-3 border-b border-border/50 px-3 py-1.5">
                                        <span class="w-24 text-muted-foreground text-xs">Tag</span>
                                        <span class="w-28 text-muted-foreground text-xs">Digest</span>
                                        <span class="w-14 text-muted-foreground text-xs">Arch</span>
                                        <span class="w-14 text-right text-muted-foreground text-xs">Size</span>
                                        <span class="flex-1 text-right text-muted-foreground text-xs">Pushed</span>
                                    </div>
                                    @for (var ti = 0; ti < image.Tags.Length; ti++)
                                                {
                                        var tag = image.Tags[ti];
                                        <div class="@(Cn.Merge("flex items-center gap-3 px-3 py-1.5", ti < image.Tags.Length - 1 ? "border-b border-border/50" : ""))">
                                            <span class="w-24 font-mono text-xs">@tag.Tag</span>
                                            <span class="w-28 truncate font-mono text-muted-foreground text-xs">@tag.Digest</span>
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 w-14 justify-center px-1 font-mono text-[10px]">
                                                @tag.Arch
                                            </BadgeCn>
                                            <span class="w-14 text-right text-muted-foreground text-xs tabular-nums">@tag.Size</span>
                                            <span class="flex-1 text-right text-muted-foreground text-xs">@tag.Pushed</span>
                                        </div>
                                    }
                                </div>
                                <div class="mt-2 flex justify-end gap-2">
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                        View layers
                                    </ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                        Pull command
                                    </ButtonCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

