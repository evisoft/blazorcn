@* ============================================================
   Block: dashboard-browser-compatibility
   Title: Dashboard Browser Compatibility
   Description: Animated React browser compatibility dashboard block for Next.js with feature support matrix, browser version columns, check and cross indicators, partial support badges, and overall compatibility scores using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Search engine optimization tracking
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-browser-compatibility.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Browser Compatibility</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_features.Length features across @_browsers.Length browsers
                </p>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-muted-foreground text-xs">
                    @_fullSupportCount/@_features.Length fully supported
                </span>
            </div>
        </div>

        @* Legend *@
        <div class="flex items-center gap-4 border-b px-4 py-2">
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideCheckCn Class="size-3 text-emerald-600 dark:text-emerald-400" />
                Full
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideMinusCn Class="size-3 text-amber-600 dark:text-amber-400" />
                Partial
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideXCn Class="size-3 text-red-600 dark:text-red-400" />
                None
            </span>
        </div>

        @* Table *@
        <div class="overflow-x-auto">
            <div class="min-w-[580px]">
                @* Column headers *@
                <div class="grid grid-cols-[1fr_56px_56px_56px_56px_48px] items-center border-b bg-muted/30 px-4 py-2">
                    <span class="font-medium text-muted-foreground text-xs">Feature</span>
                    @foreach (var browser in _browsers)
                    {
                        <div class="text-center">
                            <span class="block font-medium text-muted-foreground text-xs">@browser.Icon</span>
                            <span class="block text-[10px] text-muted-foreground/70">@browser.Version</span>
                        </div>
                    }
                    <span class="text-center font-medium text-muted-foreground text-xs">Score</span>
                </div>

                @* Feature rows *@
                <div>
                    @for (var i = 0; i < _features.Length; i++)
                    {
                        var feature = _features[i];
                        var score = GetScore(feature);
                        var isLast = i == _features.Length - 1;
                        <div class="@(Cn.Merge("grid grid-cols-[1fr_56px_56px_56px_56px_48px] items-center px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b"))">
                            <div class="min-w-0 pr-2">
                                <span class="font-medium text-sm">@feature.Feature</span>
                                <span class="ml-2 font-mono text-[10px] text-muted-foreground">@feature.Category</span>
                            </div>
                            @foreach (var support in new[] { feature.Chrome, feature.Firefox, feature.Safari, feature.Edge })
                            {
                                <div class="flex justify-center">
                                    <span class="@(Cn.Merge("flex size-6 items-center justify-center rounded", GetSupportBg(support)))">
                                        @if (support == "full")
                                        {
                                            <LucideCheckCn Class="@(Cn.Merge("size-3.5", GetSupportColor(support)))" />
                                        }
                                        else if (support == "partial")
                                        {
                                            <LucideMinusCn Class="@(Cn.Merge("size-3.5", GetSupportColor(support)))" />
                                        }
                                        else
                                        {
                                            <LucideXCn Class="@(Cn.Merge("size-3.5", GetSupportColor(support)))" />
                                        }
                                    </span>
                                </div>
                            }
                            <div class="text-center">
                                <span class="@(Cn.Merge("font-medium text-xs tabular-nums", score == 100 ? "text-emerald-600 dark:text-emerald-400" : score >= 75 ? "text-foreground" : score >= 50 ? "text-amber-600 dark:text-amber-400" : "text-red-600 dark:text-red-400"))">
                                    @score%
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record BrowserInfo(string Name, string Version, string Icon);
    private record FeatureSupportItem(string Feature, string Category, string Chrome, string Firefox, string Safari, string Edge);

    private static string GetSupportColor(string support) => support switch
    {
        "full" => "text-emerald-600 dark:text-emerald-400",
        "partial" => "text-amber-600 dark:text-amber-400",
        "none" => "text-red-600 dark:text-red-400",
        _ => ""
    };

    private static string GetSupportBg(string support) => support switch
    {
        "full" => "bg-emerald-500/10",
        "partial" => "bg-amber-500/10",
        "none" => "bg-red-500/10",
        _ => ""
    };

    private static int GetScore(FeatureSupportItem feature)
    {
        var vals = new[] { feature.Chrome, feature.Firefox, feature.Safari, feature.Edge };
        var score = vals.Sum(v => v == "full" ? 1.0 : v == "partial" ? 0.5 : 0.0);
        return (int)Math.Round(score / vals.Length * 100);
    }

    private static readonly BrowserInfo[] _browsers =
    [
        new("Chrome", "122+", "Ch"),
        new("Firefox", "124+", "Ff"),
        new("Safari", "17.4+", "Sa"),
        new("Edge", "122+", "Ed"),
    ];

    private static readonly FeatureSupportItem[] _features =
    [
        new("CSS Container Queries", "CSS", "full", "full", "full", "full"),
        new("View Transitions API", "API", "full", "partial", "none", "full"),
        new("CSS :has() Selector", "CSS", "full", "full", "full", "full"),
        new("Popover API", "HTML", "full", "full", "full", "full"),
        new("CSS Nesting", "CSS", "full", "full", "partial", "full"),
        new("WebGPU", "API", "full", "none", "partial", "full"),
        new("Scroll-Driven Animations", "CSS", "full", "full", "none", "full"),
        new("CSS @@layer", "CSS", "full", "full", "full", "full"),
        new("Compression Streams API", "API", "full", "full", "partial", "full"),
        new("CSS text-wrap: balance", "CSS", "full", "full", "none", "full"),
    ];

    private static readonly int _fullSupportCount = _features.Count(f =>
        f.Chrome == "full" && f.Firefox == "full" && f.Safari == "full" && f.Edge == "full");
}
