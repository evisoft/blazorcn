@* ============================================================
   Block: dashboard-revenue-breakdown
   Title: Dashboard Revenue Breakdown
   Description: Animated revenue breakdown dashboard for React and Next.js with six revenue sources showing a horizontal stacked bar visualization and detailed legend rows with percentages, amounts, and growth indicators using framer-motion, shadcn/ui, and Tailwind CSS
   Long Description: Customer segmentation dashboard
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-revenue-breakdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Revenue Breakdown</span>
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs">Total</span>
                <span class="font-semibold text-sm tabular-nums">$4.2M</span>
                <span class="text-muted-foreground text-xs">ARR</span>
            </div>
        </div>

        @* Stacked Bar *@
        <div class="border-b px-4 py-4">
            <div class="flex h-3 w-full overflow-hidden rounded-full bg-muted">
                @for (var i = 0; i < _sources.Length; i++)
                {
                    var source = _sources[i];
                    <div class="@(Cn.Merge("h-full", source.BarColor, i == 0 ? "rounded-l-full" : "", i == _sources.Length - 1 ? "rounded-r-full" : ""))"
                         style="@($"width: {source.Percentage}%")"></div>
                }
            </div>
        </div>

        @* Legend Rows *@
        <div>
            @for (var i = 0; i < _sources.Length; i++)
            {
                var source = _sources[i];
                var isLast = i == _sources.Length - 1;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b"))">
                    <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", source.BarColor))"></span>
                    <span class="min-w-0 flex-1 text-sm">@source.Name</span>
                    <span class="font-medium text-sm tabular-nums">@(source.Percentage)%</span>
                    <span class="w-16 text-right font-mono text-muted-foreground text-xs tabular-nums">
                        @source.Amount
                    </span>
                    <span class="@(Cn.Merge("w-14 text-right text-xs tabular-nums", source.IsPositive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400"))">
                        @source.Growth
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record RevenueSource(string Name, int Percentage, string Amount, string Growth, bool IsPositive, string BarColor);

    private static readonly RevenueSource[] _sources =
    [
        new("Subscriptions", 68, "$2.86M", "+14.2%", true, "bg-foreground"),
        new("Professional Services", 12, "$504K", "+8.7%", true, "bg-foreground/70"),
        new("Marketplace", 8, "$336K", "+22.1%", true, "bg-foreground/50"),
        new("Add-ons", 6, "$252K", "+5.3%", true, "bg-foreground/35"),
        new("API Usage", 4, "$168K", "-2.1%", false, "bg-foreground/25"),
        new("Other", 2, "$84K", "-8.4%", false, "bg-foreground/15"),
    ];
}
