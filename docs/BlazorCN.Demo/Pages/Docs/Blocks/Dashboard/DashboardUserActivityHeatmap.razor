@* ============================================================
   Block: dashboard-user-activity-heatmap
   Title: Dashboard User Activity Heatmap
   Description: Animated React user activity heatmap dashboard block for Next.js displaying a seven-by-twenty-four grid of days and hours with opacity-based intensity cells showing user engagement patterns with peak hour highlighting and total action counts using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: User growth sparkline with key metrics
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-user-activity-heatmap.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">User Activity</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">Weekly activity patterns by hour</p>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs">Total actions</span>
                <span class="font-semibold text-sm tabular-nums">184.2K</span>
            </div>
        </div>

        <div class="overflow-x-auto px-4 py-4">
            @* Hour labels *@
            <div class="mb-1 flex">
                <div class="w-10 shrink-0"></div>
                <div class="grid flex-1 grid-cols-24 gap-px">
                    @for (var i = 0; i < _hours.Length; i++)
                    {
                        var hour = _hours[i];
                        var showLabel = i % 3 == 0 || i == _peakHourIndex;
                        <span class="@(Cn.Merge("text-center text-[10px]", i == _peakHourIndex ? "font-medium text-foreground" : i % 3 == 0 ? "text-muted-foreground" : "text-transparent"))">
                            @(showLabel ? hour : "\u00A0")
                        </span>
                    }
                </div>
            </div>

            @* Heatmap grid *@
            <div class="space-y-px">
                @for (var di = 0; di < _days.Length; di++)
                {
                    var day = _days[di];
                    var dayRow = _heatmapData[di];
                    <div class="flex items-center">
                        <span class="w-10 shrink-0 text-muted-foreground text-xs">@day</span>
                        <div class="grid flex-1 grid-cols-24 gap-px">
                            @for (var hi = 0; hi < dayRow.Length; hi++)
                            {
                                var value = dayRow[hi];
                                var opacity = 0.05 + value * 0.65;
                                <div class="aspect-square rounded-sm"
                                     style="@(FormattableString.Invariant($"background-color: color-mix(in oklab, var(--foreground) {opacity * 100:F0}%, transparent)"))"
                                     title="@($"{day} {_hours[hi]}: {(value * 100):F0}% activity")"></div>
                            }
                        </div>
                    </div>
                }
            </div>

            @* Legend *@
            <div class="mt-3 flex items-center justify-end gap-2">
                <span class="text-muted-foreground text-[10px]">Less</span>
                <div class="flex gap-px">
                    @foreach (var opacity in _legendOpacities)
                    {
                        <div class="size-3 rounded-sm"
                             style="@(FormattableString.Invariant($"background-color: color-mix(in oklab, var(--foreground) {opacity * 100:F0}%, transparent)"))"></div>
                    }
                </div>
                <span class="text-muted-foreground text-[10px]">More</span>
            </div>
        </div>
    </div>
</section>

@code {
    private readonly string[] _days = { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
    private readonly string[] _hours = { "12a", "1a", "2a", "3a", "4a", "5a", "6a", "7a", "8a", "9a", "10a", "11a", "12p", "1p", "2p", "3p", "4p", "5p", "6p", "7p", "8p", "9p", "10p", "11p" };
