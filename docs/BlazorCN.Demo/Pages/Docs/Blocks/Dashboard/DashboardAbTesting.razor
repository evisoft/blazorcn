@* ============================================================
   Block: dashboard-ab-testing
   Title: Dashboard Ab Testing
   Description: Animated React A/B testing dashboard block for Next.js with running experiments showing variant conversion bars, sample sizes, statistical confidence percentages, and winner indicators using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: KPI metric cards with trend indicators
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-ab-testing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">A/B Tests</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_experiments.Length experiments running
                </p>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @(_experiments.Count(e => e.Winner != null)) concluded
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    @(_experiments.Count(e => e.Winner == null)) running
                </span>
            </div>
        </div>

        <div>
            @for (var i = 0; i < _experiments.Length; i++)
                        {
                var test = _experiments[i];
                var testIndex = i;
                <div class="@(testIndex < _experiments.Length - 1 ? "border-b" : "")">
                    <div class="px-4 py-3">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@test.Name</span>
                            @if (test.Winner != null)
                                        {
                                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                                    <LucideCircleCheckBigCn Size="12" Class="size-3" />
                                    Winner: @test.Winner
                                </span>
                            }
                        </div>
                        <p class="mt-0.5 text-muted-foreground text-xs">@test.Description</p>
                    </div>

                    <div class="grid grid-cols-2 gap-4 px-4 pb-3">
                        @foreach (var variant in test.Variants)
                                    {
                            var maxConversion = Math.Max(test.Variants[0].Conversion, test.Variants[1].Conversion);
                            var barWidth = (variant.Conversion / maxConversion) * 100;
                            <div>
                                <div class="flex items-center justify-between">
                                    <span class="text-muted-foreground text-xs">@variant.Name</span>
                                    <span class="@(Cn.Merge("font-semibold text-sm tabular-nums", variant.Color))">
                                        @variant.Conversion%
                                    </span>
                                </div>
                                <div class="mt-1.5 h-2 overflow-hidden rounded-full bg-muted">
                                    <div class="@(Cn.Merge("h-full rounded-full", variant.BarColor))"
                                         style="@($"width: {barWidth:F1}%")">
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="flex items-center gap-4 border-t px-4 py-2">
                        <span class="text-muted-foreground text-xs">
                            Sample: <span class="tabular-nums">@test.SampleSize</span>
                        </span>
                        <span class="text-muted-foreground text-xs">
                            Confidence:
                            <span class="@(Cn.Merge("font-medium tabular-nums", (test.Confidence >= 95 ? "text-emerald-600 dark:text-emerald-400" : test.Confidence >= 80 ? "text-amber-600 dark:text-amber-400" : "text-muted-foreground")))">
                                @test.Confidence%
                            </span>
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ExperimentVariant(string Name, double Conversion, string Color, string BarColor);
    private record Experiment(string Id, string Name, string Description, ExperimentVariant[] Variants, string SampleSize, int Confidence, string? Winner);

    private readonly Experiment[] _experiments = new[]
    {
        new Experiment("1", "Checkout Button Copy", "Testing 'Buy Now' vs 'Add to Cart' on product pages",
            new[] {
                new ExperimentVariant("A: Buy Now", 3.2, "text-blue-600 dark:text-blue-400", "bg-blue-500"),
                new ExperimentVariant("B: Add to Cart", 4.1, "text-emerald-600 dark:text-emerald-400", "bg-emerald-500")
            }, "24,847", 97, "B"),
        new Experiment("2", "Pricing Page Layout", "Horizontal cards vs vertical comparison table",
            new[] {
                new ExperimentVariant("A: Cards", 2.8, "text-blue-600 dark:text-blue-400", "bg-blue-500"),
                new ExperimentVariant("B: Table", 2.6, "text-emerald-600 dark:text-emerald-400", "bg-emerald-500")
            }, "18,392", 62, null),
        new Experiment("3", "Onboarding Flow", "3-step wizard vs single-page form",
            new[] {
                new ExperimentVariant("A: Wizard", 68.4, "text-blue-600 dark:text-blue-400", "bg-blue-500"),
                new ExperimentVariant("B: Single Page", 74.2, "text-emerald-600 dark:text-emerald-400", "bg-emerald-500")
            }, "5,291", 91, null)
    };
}
