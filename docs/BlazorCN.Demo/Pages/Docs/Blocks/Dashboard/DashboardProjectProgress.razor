@* ============================================================
   Block: dashboard-project-progress
   Title: Dashboard Project Progress
   Description: Animated React project progress dashboard block for Next.js with six projects showing progress bars with spring animations, completion percentages, status chips, team sizes, and deadline strings using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Expandable helpdesk ticket list with priority dots
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-project-progress.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Project Progress</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Active projects and completion status
            </p>
        </div>

        <div>
            @for (var i = 0; i < _projects.Length; i++)
            {
                var project = _projects[i];
                var isLast = i == _projects.Length - 1;
                <div class="@(Cn.Merge("px-4 py-3", isLast ? "" : "border-b"))">
                    <div class="mb-2 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@project.Name</span>
                            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                @_statusLabel[project.Status]
                            </span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                <LucideUsersCn Size="12" Class="size-3" />
                                @project.Team
                            </span>
                            <span class="text-muted-foreground text-xs">@project.Deadline</span>
                            <span class="w-8 text-right font-medium text-sm tabular-nums">
                                @(project.Progress)%
                            </span>
                        </div>
                    </div>
                    <div class="h-1.5 w-full rounded-full bg-muted/50">
                        <div class="@(Cn.Merge("h-full rounded-full", _statusBarColor[project.Status]))"
                             style="@($"width: {project.Progress}%")"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Project(string Name, int Progress, string Status, int Team, string Deadline);

    private static readonly Dictionary<string, string> _statusLabel = new()
    {
        ["on-track"] = "On Track",
        ["at-risk"] = "At Risk",
        ["behind"] = "Behind",
    };

    private static readonly Dictionary<string, string> _statusBarColor = new()
    {
        ["on-track"] = "bg-emerald-500",
        ["at-risk"] = "bg-amber-500",
        ["behind"] = "bg-red-500",
    };

    private static readonly Project[] _projects =
    [
        new("Platform Migration v3", 78, "on-track", 8, "Apr 15"),
        new("Mobile App Redesign", 52, "at-risk", 5, "Mar 30"),
        new("API Gateway Overhaul", 91, "on-track", 4, "Mar 22"),
        new("Customer Portal Launch", 34, "behind", 6, "Apr 1"),
        new("Analytics Dashboard v2", 67, "on-track", 3, "Apr 20"),
        new("Security Audit Remediation", 45, "at-risk", 4, "Mar 28"),
    ];
}
