@* ============================================================
   Block: dashboard-secret-scanner
   Title: Dashboard Secret Scanner
   Description: Animated React secret and credential scanner findings dashboard block for Next.js with severity levels, file locations, secret types, verification status, and remediation actions using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Threat score and vulnerability summary
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-secret-scanner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideShieldAlertCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Secret Scanner</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @_findings.Length exposed credentials detected
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_criticalCount critical
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_highCount high
                </span>
            </div>
        </div>

        @* Findings *@
        <div>
            @for (var i = 0; i < _findings.Length; i++)
            {
                var finding = _findings[i];
                var isExpanded = _expanded == finding.Id;
                var isLast = i == _findings.Length - 1;
                var config = _severityConfig[finding.Severity];
                var verify = _verifyLabel[finding.VerifyStatus];
                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : finding.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", config.Dot))"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <LucideKeyCn Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                                <span class="font-medium text-sm">@finding.SecretType</span>
                            </div>
                            <p class="mt-0.5 truncate font-mono text-muted-foreground text-xs">
                                @finding.FilePath:@finding.LineNumber
                            </p>
                        </div>
                        <span class="@(Cn.Merge("shrink-0 text-xs", verify.Style))">@verify.Text</span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <div class="mb-2 rounded-md bg-zinc-950 px-3 py-2">
                                <code class="font-mono text-sm text-zinc-200">@finding.Snippet</code>
                            </div>
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="mb-1.5 flex items-center justify-between">
                                    <span class="font-medium text-muted-foreground text-xs">
                                        Remediation
                                    </span>
                                    <span class="text-muted-foreground text-xs">
                                        @finding.DetectedAt
                                    </span>
                                </div>
                                <p class="text-sm leading-relaxed">@finding.Remediation</p>
                                @if (finding.VerifyStatus != "false_positive")
                                {
                                    <div class="mt-3 flex items-center gap-2">
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                                            <LucideRotateCcwCn Size="12" Class="size-3" />
                                            Revoke &amp; Rotate
                                        </ButtonCn>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                                            <LucideXCn Size="12" Class="size-3" />
                                            Dismiss
                                        </ButtonCn>
                                    </div>
                                }
                                @if (finding.VerifyStatus == "false_positive")
                                {
                                    <div class="mt-3 flex items-center gap-2">
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                                            <LucideAlertTriangleCn Size="12" Class="size-3" />
                                            Re-verify
                                        </ButtonCn>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "f1";

    private record Finding(string Id, string SecretType, string Severity, string FilePath, int LineNumber, string Snippet, string VerifyStatus, string DetectedAt, string Remediation);
    private record SeverityConfig(string Dot, string Label);
    private record VerifyConfig(string Text, string Style);

    private static readonly int _criticalCount = _findings.Count(f => f.Severity == "critical");
    private static readonly int _highCount = _findings.Count(f => f.Severity == "high");

    private static readonly Dictionary<string, SeverityConfig> _severityConfig = new()
    {
        ["critical"] = new("bg-red-500", "Critical"),
        ["high"] = new("bg-amber-500", "High"),
        ["medium"] = new("bg-blue-500", "Medium"),
    };

    private static readonly Dictionary<string, VerifyConfig> _verifyLabel = new()
    {
        ["verified"] = new("Verified", "text-red-600 dark:text-red-400"),
        ["unverified"] = new("Unverified", "text-muted-foreground"),
        ["false_positive"] = new("False positive", "text-muted-foreground/60"),
    };

    private static readonly Finding[] _findings =
    [
        new("f1", "AWS Access Key", "critical", "src/lib/storage.ts", 23, "AKIA3E****XMPL", "verified", "2 hours ago",
            "Rotate the AWS access key in IAM console. Update the key in your secrets manager and redeploy affected services."),
        new("f2", "Stripe Secret Key", "critical", "config/payment.ts", 8, "sk_live_51****abc", "verified", "3 hours ago",
            "Roll the Stripe secret key from the Stripe Dashboard. Update your environment variables and webhook signing secrets."),
        new("f3", "Database Connection String", "critical", ".env.production", 4, "postgres://admin:****@@db.acme.com", "verified", "5 hours ago",
            "Change the database password immediately. Update the connection string in your secrets manager. Audit recent database access logs."),
        new("f4", "GitHub Personal Access Token", "high", "scripts/deploy.sh", 15, "ghp_xxxx****xxxx", "unverified", "1 day ago",
            "Delete the token from GitHub Settings. Create a new fine-grained token with minimum required permissions."),
        new("f5", "SendGrid API Key", "high", "src/services/email.ts", 41, "SG.xxxx****xxxx", "verified", "1 day ago",
            "Revoke the API key in SendGrid settings. Generate a new key with restricted permissions for transactional email only."),
        new("f6", "JWT Signing Secret", "medium", "src/auth/config.ts", 12, "hs256-dev-****-test", "false_positive", "3 days ago",
            "This appears to be a development-only signing key. Verify it is not used in production. Add to scanner allowlist if confirmed safe."),
    ];
}
