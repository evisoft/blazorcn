@* ============================================================
   Block: dashboard-payment-analytics
   Title: Dashboard Payment Analytics
   Description: Animated React payment analytics block for Next.js with success rate, failed and refunded counts, average transaction value, recent transactions with status indicators, and entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Security event log with risk indicators
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-payment-analytics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Payment Analytics</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Transaction processing overview for the last 30 days
            </p>
        </div>

        @* Stats grid *@
        <div class="grid grid-cols-2 gap-px border-b bg-border sm:grid-cols-4">
            @foreach (var metric in _summaryMetrics)
            {
                <div class="bg-card px-4 py-3">
                    <span class="text-muted-foreground text-xs">@metric.Label</span>
                    <p class="mt-1 font-semibold text-2xl tabular-nums">@metric.Value</p>
                    <span class="text-muted-foreground text-xs">@metric.Sub</span>
                </div>
            }
        </div>

        <div class="border-b px-4 py-2">
            <span class="font-medium text-muted-foreground text-xs">Recent Transactions</span>
        </div>

        @* Transactions *@
        <div>
            @for (var i = 0; i < _transactions.Length; i++)
            {
                var tx = _transactions[i];
                var isLast = i == _transactions.Length - 1;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b"))">
                    <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", _statusDot[tx.Status]))"></span>

                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@tx.Description</span>
                    </div>

                    <span class="@(Cn.Merge("inline-flex shrink-0 items-center rounded-md px-2 py-0.5 text-[11px] font-medium", _methodStyle[tx.Method]))">
                        @tx.Method
                    </span>

                    <span class="w-20 shrink-0 text-right font-semibold text-sm tabular-nums">
                        @tx.Amount
                    </span>

                    <span class="w-16 shrink-0 text-right text-muted-foreground text-xs">
                        @tx.Timestamp
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record SummaryMetric(string Label, string Value, string Sub);
    private record Transaction(string Id, string Description, string Amount, string Status, string Method, string Timestamp);

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["completed"] = "bg-emerald-500",
        ["failed"] = "bg-red-500",
        ["refunded"] = "bg-amber-500",
        ["pending"] = "bg-blue-500",
    };

    private static readonly Dictionary<string, string> _methodStyle = new()
    {
        ["Stripe"] = "bg-violet-500/10 text-violet-700 dark:text-violet-400",
        ["PayPal"] = "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        ["Wire"] = "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
    };

    private static readonly SummaryMetric[] _summaryMetrics =
    [
        new("Success Rate", "97.2%", "4,812 processed"),
        new("Failed", "134", "2.8% of total"),
        new("Refunded", "47", "$3,920 returned"),
        new("Avg Transaction", "$84", "across all methods"),
    ];

    private static readonly Transaction[] _transactions =
    [
        new("1", "Enterprise license \u2014 Acme Corp", "$2,400.00", "completed", "Stripe", "12 min ago"),
        new("2", "Team plan upgrade \u2014 DataFlow", "$149.00", "completed", "Stripe", "34 min ago"),
        new("3", "API usage overage \u2014 NexTech", "$67.50", "failed", "PayPal", "1 hr ago"),
        new("4", "Annual subscription \u2014 CloudBase", "$1,188.00", "completed", "Wire", "2 hr ago"),
        new("5", "Refund request \u2014 StartupKit", "$39.00", "refunded", "Stripe", "3 hr ago"),
    ];
}
