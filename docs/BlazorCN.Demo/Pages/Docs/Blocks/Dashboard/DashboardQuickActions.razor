@* ============================================================
   Block: dashboard-quick-actions
   Title: Dashboard Quick Actions
   Description: Animated React dashboard quick actions block for Next.js with eight shortcut buttons in a responsive grid, Lucide icons, staggered scale entrance, and hover lift animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Four KPI metric cards with trend indicators
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-quick-actions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Quick actions</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Common shortcuts for your workflow</p>
        </div>
        <div class="grid grid-cols-2 gap-px bg-border sm:grid-cols-4">
            @foreach (var action in _actions)
            {
                <div class="bg-card">
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="flex h-auto w-full flex-col items-center gap-2 rounded-none px-4 py-5">
                        @switch (action.Icon)
                        {
                            case "plus":
                                <LucidePlusCn Size="20" Class="size-5 text-muted-foreground" />
                                break;
                            case "upload":
                                <LucideUploadCn Size="20" Class="size-5 text-muted-foreground" />
                                break;
                            case "user-plus":
                                <LucideUserPlusCn Size="20" Class="size-5 text-muted-foreground" />
                                break;
                            case "file-text":
                                <LucideFileTextCn Size="20" Class="size-5 text-muted-foreground" />
                                break;
                            case "receipt":
                                <LucideReceiptCn Size="20" Class="size-5 text-muted-foreground" />
                                break;
                            case "mail":
                                <LucideMailCn Size="20" Class="size-5 text-muted-foreground" />
                                break;
                            case "calendar":
                                <LucideCalendarCn Size="20" Class="size-5 text-muted-foreground" />
                                break;
                            case "bar-chart-3":
                                <LucideBarChart3Cn Size="20" Class="size-5 text-muted-foreground" />
                                break;
                        }
                        <span class="text-xs">@action.Label</span>
                    </ButtonCn>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record QuickAction(string Icon, string Label);

    private static readonly QuickAction[] _actions =
    [
        new("plus", "New Project"),
        new("upload", "Upload File"),
        new("user-plus", "Invite Member"),
        new("file-text", "Generate Report"),
        new("receipt", "Create Invoice"),
        new("mail", "Send Email"),
        new("calendar", "Schedule Meeting"),
        new("bar-chart-3", "View Analytics"),
    ];
}
