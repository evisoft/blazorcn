@* ============================================================
   Block: dashboard-budget-tracker
   Title: Dashboard Budget Tracker
   Description: Animated budget tracking dashboard for React and Next.js with six department categories showing dual-bar allocated versus spent visualization, remaining amounts, and over or under budget indicators using framer-motion, shadcn/ui, and Tailwind CSS
   Long Description: Revenue by source visualization
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-budget-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Budget Tracker</span>
            <span class="text-muted-foreground text-xs">Q1 2026</span>
        </div>

        @* Summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div>
                <span class="text-muted-foreground text-xs">Allocated</span>
                <p class="font-semibold text-lg tabular-nums">$1.37M</p>
            </div>
            <div>
                <span class="text-muted-foreground text-xs">Spent</span>
                <p class="font-semibold text-lg tabular-nums">$1.34M</p>
            </div>
            <div class="ml-auto text-right">
                <span class="text-muted-foreground text-xs">Utilization</span>
                <p class="@(Cn.Merge("font-semibold text-lg tabular-nums", _utilization > 100 ? "text-red-600 dark:text-red-400" : "text-foreground"))">
                    @_utilization%
                </p>
            </div>
        </div>

        @* Category Rows *@
        <div>
            @for (var i = 0; i < _categories.Length; i++)
            {
                var category = _categories[i];
                var spentPercent = Math.Min((double)category.Spent / category.Allocated * 100, 100);
                var isOver = category.Spent > category.Allocated;
                var remaining = FormatRemaining(category.Allocated, category.Spent);
                var isLast = i == _categories.Length - 1;
                <div class="@(Cn.Merge("px-4 py-3", isLast ? "" : "border-b"))">
                    <div class="mb-1.5 flex items-center justify-between">
                        <span class="font-medium text-sm">@category.Name</span>
                        <div class="flex items-center gap-3">
                            <span class="text-muted-foreground text-xs tabular-nums">
                                @category.SpentLabel / @category.AllocatedLabel
                            </span>
                            <span class="@(Cn.Merge("w-12 text-right font-medium text-xs tabular-nums", isOver ? "text-red-600 dark:text-red-400" : "text-emerald-600 dark:text-emerald-400"))">
                                @remaining
                            </span>
                        </div>
                    </div>
                    <div class="relative h-1.5 w-full overflow-hidden rounded-full bg-muted">
                        <div class="@(Cn.Merge("h-full rounded-full", isOver ? "bg-red-500" : "bg-foreground/60"))"
                             style="@($"width: {spentPercent:F1}%")">
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record BudgetCategory(string Name, int Allocated, int Spent, string AllocatedLabel, string SpentLabel);

    private static string FormatRemaining(int allocated, int spent)
    {
        var diff = allocated - spent;
        var abs = Math.Abs(diff);
        if (abs >= 1000)
            return $"{(diff < 0 ? "-" : "+")}${Math.Round(abs / 1000.0)}K";
        return $"{(diff < 0 ? "-" : "+")}${abs:N0}";
    }

    private static readonly BudgetCategory[] _categories =
    [
        new("Engineering", 420000, 385000, "$420K", "$385K"),
        new("Marketing", 180000, 196000, "$180K", "$196K"),
        new("Sales", 240000, 218000, "$240K", "$218K"),
        new("Operations", 95000, 87000, "$95K", "$87K"),
        new("HR", 120000, 114000, "$120K", "$114K"),
        new("Infrastructure", 310000, 342000, "$310K", "$342K"),
    ];

    private static readonly int _totalAllocated = _categories.Sum(c => c.Allocated);
    private static readonly int _totalSpent = _categories.Sum(c => c.Spent);
    private static readonly int _utilization = (int)Math.Round((double)_totalSpent / _totalAllocated * 100);
}
