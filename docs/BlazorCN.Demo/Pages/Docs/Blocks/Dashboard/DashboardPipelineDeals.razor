@* ============================================================
   Block: dashboard-pipeline-deals
   Title: Dashboard Pipeline Deals
   Description: Animated React deal pipeline dashboard block for Next.js with six active deals showing company names, deal values, sales stages, probability percentages, owner initials, close dates, and weighted pipeline value using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: NPS and CSAT feedback dashboard
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-pipeline-deals.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Deal Pipeline</span>
                <p class="mt-0.5 text-muted-foreground text-xs">@_deals.Length active deals</p>
            </div>
            <div class="text-right">
                <span class="font-semibold text-2xl tabular-nums">
                    @FormatCurrency(_weightedTotal)
                </span>
                <p class="text-muted-foreground text-xs">Weighted value</p>
            </div>
        </div>

        @* Column headers *@
        <div class="hidden items-center gap-4 border-b bg-muted/30 px-4 py-2 sm:flex">
            <span class="min-w-0 flex-1 text-muted-foreground text-xs">Company</span>
            <span class="w-20 text-right text-muted-foreground text-xs">Value</span>
            <span class="w-24 text-muted-foreground text-xs">Stage</span>
            <span class="w-12 text-right text-muted-foreground text-xs">Prob.</span>
            <span class="w-8 text-center text-muted-foreground text-xs">Owner</span>
            <span class="w-24 text-right text-muted-foreground text-xs">Close Date</span>
            <span class="w-4"></span>
        </div>

        @* Deals *@
        <div>
            @for (var i = 0; i < _deals.Length; i++)
            {
                var deal = _deals[i];
                var isExpanded = _expanded == deal.Id;
                var isLast = i == _deals.Length - 1;
                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : deal.Id)"
                        class="flex w-full items-center gap-4 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@deal.Company</span>
                            <div class="mt-1 flex items-center gap-2 sm:hidden">
                                <span class="@(Cn.Merge("rounded-full px-2 py-0.5 text-xs", _stageStyle[deal.Stage]))">
                                    @deal.Stage
                                </span>
                                <span class="text-muted-foreground text-xs tabular-nums">
                                    @(deal.Probability)%
                                </span>
                            </div>
                        </div>
                        <span class="w-20 text-right font-semibold text-sm tabular-nums">
                            @FormatCurrency(deal.Amount)
                        </span>
                        <span class="@(Cn.Merge("hidden w-24 rounded-full px-2 py-0.5 text-center text-xs sm:inline-block", _stageStyle[deal.Stage]))">
                            @deal.Stage
                        </span>
                        <span class="hidden w-12 text-right text-muted-foreground text-xs tabular-nums sm:inline-block">
                            @(deal.Probability)%
                        </span>
                        <span class="hidden size-7 items-center justify-center rounded-full bg-muted text-muted-foreground text-xs sm:flex">
                            @deal.Initials
                        </span>
                        <span class="hidden w-24 text-right text-muted-foreground text-xs sm:inline-block">
                            @deal.CloseDate
                        </span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="mb-2">
                                    <span class="font-medium text-muted-foreground text-xs">Notes</span>
                                    <p class="mt-1 text-sm leading-relaxed">@deal.Notes</p>
                                </div>
                                <div>
                                    <span class="font-medium text-muted-foreground text-xs">Next step</span>
                                    <p class="mt-1 text-sm leading-relaxed">@deal.NextStep</p>
                                </div>
                            </div>
                            <div class="mt-2 flex items-center gap-3 sm:hidden">
                                <span class="flex size-6 items-center justify-center rounded-full bg-muted text-muted-foreground text-xs">
                                    @deal.Initials
                                </span>
                                <span class="text-muted-foreground text-xs">@deal.Owner</span>
                                <span class="text-muted-foreground text-xs">·</span>
                                <span class="text-muted-foreground text-xs">@deal.CloseDate</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record Deal(string Id, string Company, int Amount, string Stage, int Probability, string Owner, string Initials, string CloseDate, string Notes, string NextStep);

    private static string FormatCurrency(int value) => value >= 1000 ? $"${value / 1000}K" : $"${value:N0}";

    private static readonly Dictionary<string, string> _stageStyle = new()
    {
        ["Discovery"] = "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        ["Qualification"] = "bg-purple-500/10 text-purple-700 dark:text-purple-400",
        ["Proposal"] = "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        ["Negotiation"] = "bg-orange-500/10 text-orange-700 dark:text-orange-400",
        ["Contract"] = "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        ["Onboarding"] = "bg-teal-500/10 text-teal-700 dark:text-teal-400",
    };

    private static readonly Deal[] _deals =
    [
        new("d1", "Meridian Health Systems", 120000, "Negotiation", 75, "Sarah Chen", "SC", "Apr 15, 2026",
            "Enterprise license for 500 seats. Legal review in progress. CFO approved budget.",
            "Send revised pricing with volume discount by Friday"),
        new("d2", "Atlas Financial Group", 85000, "Proposal", 50, "Marcus Webb", "MW", "May 2, 2026",
            "Compliance-focused deployment. Need SOC 2 documentation. Competing with Datadog.",
            "Schedule technical demo with their security team"),
        new("d3", "Vertex Manufacturing", 200000, "Discovery", 25, "Lisa Park", "LP", "Jun 30, 2026",
            "Multi-site rollout across 12 factories. Initial interest from VP of Operations.",
            "Complete needs assessment questionnaire"),
        new("d4", "Cascade Logistics", 65000, "Contract", 90, "Sarah Chen", "SC", "Mar 28, 2026",
            "Standard agreement. Awaiting signature from their procurement director.",
            "Follow up on contract signature status"),
        new("d5", "NovaTech Solutions", 150000, "Qualification", 30, "James Rivera", "JR", "Jul 15, 2026",
            "Series B startup scaling engineering team. Budget confirmation pending board meeting.",
            "Attend their board meeting presentation on April 5"),
        new("d6", "Pinnacle Education", 95000, "Proposal", 60, "Marcus Webb", "MW", "May 20, 2026",
            "University system with 3 campuses. Strong champion in IT department.",
            "Present case study from similar education client"),
    ];
    private static readonly int _weightedTotal = _deals.Sum(d => d.Amount * d.Probability / 100);

}
