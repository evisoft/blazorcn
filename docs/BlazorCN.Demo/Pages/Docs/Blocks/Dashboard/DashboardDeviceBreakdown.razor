@* ============================================================
   Block: dashboard-device-breakdown
   Title: Dashboard Device Breakdown
   Description: Animated React user device and browser distribution dashboard block for Next.js with platform segments, browser shares, OS versions, expandable device categories, and animated percentage bars using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Regional revenue shares with animated bars
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-device-breakdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Device Breakdown</span>
            <div class="flex items-center gap-3">
                <span class="text-muted-foreground text-xs">@_totalUsers users</span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs">@_totalSessions sessions</span>
            </div>
        </div>

        @* Stacked bar *@
        <div class="border-b px-4 py-3">
            <div class="flex h-3 overflow-hidden rounded-full">
                @for (var i = 0; i < _categories.Length; i++)
                            {
                    var cat = _categories[i];
                    var barIdx = i;
                    <div class="@(barIdx == 0 ? "bg-foreground/25" : barIdx == 1 ? "bg-foreground/15" : "bg-foreground/8")"
                         style="@(FormattableString.Invariant($"width: {cat.Percentage}%"))">
                    </div>
                }
            </div>
            <div class="mt-2 flex items-center gap-4">
                @for (var i = 0; i < _categories.Length; i++)
                            {
                    var cat = _categories[i];
                    var legendIdx = i;
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@(Cn.Merge("size-2 rounded-sm", legendIdx == 0 ? "bg-foreground/25" : legendIdx == 1 ? "bg-foreground/15" : "bg-foreground/8"))"></span>
                        @cat.Name @cat.Percentage%
                    </span>
                }
            </div>
        </div>

        @* Categories *@
        <div>
            @for (var i = 0; i < _categories.Length; i++)
                        {
                var category = _categories[i];
                var isExpanded = _expanded == category.Id;
                var isLast = i == _categories.Length - 1;

                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : category.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        @if (category.Icon == "desktop")
                                    {
                            <LucideMonitorCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        }
                        else if (category.Icon == "mobile")
                        {
                            <LucideSmartphoneCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        }
                        else
                        {
                            <LucideTabletCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        }
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@category.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @category.Users users · @category.Sessions sessions · @category.AvgDuration avg
                            </p>
                        </div>
                        <span class="font-medium text-sm tabular-nums">@category.Percentage%</span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                                {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-3 pl-11">
                                <p class="mb-2 text-muted-foreground text-xs">Browser distribution</p>
                                <div class="space-y-2">
                                    @foreach (var browser in category.Browsers)
                                                {
                                        <div class="flex items-center gap-3">
                                            <span class="w-28 shrink-0 text-sm">@browser.Name</span>
                                            <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted/50">
                                                <div class="h-full rounded-full bg-foreground/20"
                                                     style="@(FormattableString.Invariant($"width: {browser.Share}%"))">
                                                </div>
                                            </div>
                                            <span class="w-12 text-right text-muted-foreground text-xs tabular-nums">
                                                @browser.Share%
                                            </span>
                                            <span class="w-12 text-right font-mono text-muted-foreground text-xs">
                                                @browser.Version
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "desktop";

    private record BrowserShare(string Name, double Share, string Version);
    private record DeviceCategory(string Id, string Name, string Icon, string Users, double Percentage, string Sessions, string AvgDuration, BrowserShare[] Browsers);

    private const string _totalUsers = "295K";
    private const string _totalSessions = "476K";

    private readonly DeviceCategory[] _categories = new[]
    {
        new DeviceCategory("desktop", "Desktop", "desktop", "184K", 62.4, "312K", "4m 32s", new[]
        {
            new BrowserShare("Chrome", 64.2, "122.x"),
            new BrowserShare("Safari", 18.7, "17.x"),
            new BrowserShare("Firefox", 8.4, "124.x"),
            new BrowserShare("Edge", 7.1, "122.x"),
            new BrowserShare("Other", 1.6, "\u2014")
        }),
        new DeviceCategory("mobile", "Mobile", "mobile", "96K", 32.5, "142K", "2m 18s", new[]
        {
            new BrowserShare("Safari (iOS)", 52.3, "17.x"),
            new BrowserShare("Chrome (Android)", 38.1, "122.x"),
            new BrowserShare("Samsung Internet", 6.2, "24.x"),
            new BrowserShare("Other", 3.4, "\u2014")
        }),
        new DeviceCategory("tablet", "Tablet", "tablet", "15K", 5.1, "22K", "5m 47s", new[]
        {
            new BrowserShare("Safari (iPadOS)", 71.8, "17.x"),
            new BrowserShare("Chrome", 22.4, "122.x"),
            new BrowserShare("Other", 5.8, "\u2014")
        })
    };
}
