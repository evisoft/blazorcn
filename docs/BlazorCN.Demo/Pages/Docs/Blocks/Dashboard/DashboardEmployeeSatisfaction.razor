@* ============================================================
   Block: dashboard-employee-satisfaction
   Title: Dashboard Employee Satisfaction
   Description: Animated React eNPS employee satisfaction survey dashboard block for Next.js with net promoter score, department breakdown, promoter/passive/detractor distribution, and quarterly trend bars using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Team capacity and workload distribution
   Dependencies: BadgeCn
   Source: original/blocks/dashboard/dashboard-employee-satisfaction.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideUsersCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Employee Satisfaction</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Q4 2025
            </BadgeCn>
        </div>

        @* eNPS hero + summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div>
                <p class="text-muted-foreground text-xs">eNPS Score</p>
                <p class="@(Cn.Merge("font-semibold text-2xl tabular-nums", GetEnpsColor(_overallEnps)))">
                    +@_overallEnps
                </p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">Responses</p>
                <p class="font-semibold text-sm tabular-nums">@_totalResponses</p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">Response Rate</p>
                <p class="font-semibold text-sm tabular-nums">@(_responseRate)%</p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">vs Last Quarter</p>
                <p class="font-medium text-sm tabular-nums text-emerald-600 dark:text-emerald-400">
                    +@(_overallEnps - _previousEnps)
                </p>
            </div>
        </div>

        @* Quarterly trend *@
        <div class="border-b px-4 py-3">
            <p class="mb-3 text-muted-foreground text-xs">Quarterly Trend</p>
            <div class="flex h-16 items-end gap-2">
                @foreach (var q in _quarterlyTrend)
                {
                    var heightPercent = (double)q.Score / (_maxQuarterScore + 10) * 100;
                    @* h-full + flex-1 bar area: the row is items-end, so without stretching
                       the column has auto height and the bar's height:% resolves to 0. *@
                    <div class="flex h-full flex-1 flex-col items-center gap-1">
                        <span class="text-[10px] font-medium tabular-nums">@q.Score</span>
                        <div class="flex w-full flex-1 items-end">
                            <div class="w-full rounded-t bg-foreground/15"
                                 style="@(FormattableString.Invariant($"height: {heightPercent:F1}%"))">
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="mt-1.5 flex gap-2">
                @foreach (var q in _quarterlyTrend)
                {
                    <span class="flex-1 text-center text-muted-foreground text-[10px]">
                        @q.Quarter
                    </span>
                }
            </div>
        </div>

        @* Department breakdown *@
        <div>
            @for (var i = 0; i < _departments.Length; i++)
            {
                var dept = _departments[i];
                var isExpanded = _expanded == dept.Id;
                var isLast = i == _departments.Length - 1;

                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : dept.Id)"
                        class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", GetEnpsDot(dept.Enps)))"></span>
                        <span class="min-w-0 flex-1 font-medium text-sm">@dept.Name</span>
                        <span class="w-10 shrink-0 text-right text-muted-foreground text-xs tabular-nums">
                            @dept.Headcount
                        </span>
                        <span class="@(Cn.Merge("w-8 shrink-0 text-right font-semibold text-sm tabular-nums", GetEnpsColor(dept.Enps)))">
                            @dept.Enps
                        </span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-3 px-4 pb-4 pt-1">
                                @* Distribution bar *@
                                <div>
                                    <p class="mb-1.5 text-muted-foreground text-xs">
                                        Response Distribution
                                    </p>
                                    <div class="flex h-2 overflow-hidden rounded-full">
                                        <div class="h-full bg-emerald-500"
                                             style="@($"width: {dept.Promoters}%")">
                                        </div>
                                        <div class="h-full bg-foreground/15"
                                             style="@($"width: {dept.Passives}%")">
                                        </div>
                                        <div class="h-full bg-red-500"
                                             style="@($"width: {dept.Detractors}%")">
                                        </div>
                                    </div>
                                </div>

                                @* Labels *@
                                <div class="flex items-center gap-4 text-xs">
                                    <span class="flex items-center gap-1.5">
                                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                        <span class="text-muted-foreground">Promoters</span>
                                        <span class="font-medium tabular-nums">@(dept.Promoters)%</span>
                                    </span>
                                    <span class="flex items-center gap-1.5">
                                        <span class="size-1.5 rounded-full bg-foreground/15"></span>
                                        <span class="text-muted-foreground">Passives</span>
                                        <span class="font-medium tabular-nums">@(dept.Passives)%</span>
                                    </span>
                                    <span class="flex items-center gap-1.5">
                                        <span class="size-1.5 rounded-full bg-red-500"></span>
                                        <span class="text-muted-foreground">Detractors</span>
                                        <span class="font-medium tabular-nums">@(dept.Detractors)%</span>
                                    </span>
                                </div>

                                <div class="flex items-center gap-3 text-muted-foreground text-xs">
                                    <span>Response rate: @(dept.ResponseRate)%</span>
                                    <span>·</span>
                                    <span>@dept.Headcount employees</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "6";

    private const int _overallEnps = 42;
    private const int _totalResponses = 847;
    private const int _responseRate = 89;
    private const int _previousEnps = 38;

    private record QuarterData(string Quarter, int Score);
    private record Department(string Id, string Name, int Enps, int Promoters, int Passives, int Detractors, int ResponseRate, int Headcount);

    private static string GetEnpsColor(int score)
    {
        if (score >= 50) return "text-emerald-600 dark:text-emerald-400";
        if (score >= 20) return "text-foreground";
        return "text-red-600 dark:text-red-400";
    }

    private static string GetEnpsDot(int score)
    {
        if (score >= 50) return "bg-emerald-500";
        if (score >= 20) return "bg-amber-500";
        return "bg-red-500";
    }

    private static readonly QuarterData[] _quarterlyTrend =
    [
        new("Q1 '25", 28),
        new("Q2 '25", 34),
        new("Q3 '25", 38),
        new("Q4 '25", 42),
    ];

    private static readonly int _maxQuarterScore = _quarterlyTrend.Max(q => q.Score);

    private static readonly Department[] _departments =
    [
        new("1", "Engineering", 56, 62, 24, 14, 92, 186),
        new("2", "Product", 48, 58, 28, 14, 94, 42),
        new("3", "Design", 52, 60, 26, 14, 88, 28),
        new("4", "Sales", 31, 45, 32, 23, 84, 96),
        new("5", "Marketing", 38, 50, 30, 20, 90, 54),
        new("6", "Customer Support", 18, 35, 34, 31, 86, 120),
        new("7", "Finance", 44, 55, 28, 17, 91, 32),
    ];
}
