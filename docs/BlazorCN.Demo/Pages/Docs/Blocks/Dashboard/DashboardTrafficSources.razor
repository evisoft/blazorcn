@* ============================================================
   Block: dashboard-traffic-sources
   Title: Dashboard Traffic Sources
   Description: Animated React traffic source attribution block for Next.js with organic paid referral and direct channel breakdowns, session counts, conversion rates, trend indicators, and proportional distribution bar using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Funnel stage drop-off visualization
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-traffic-sources.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Traffic Sources</span>
                <p class="mt-0.5 text-muted-foreground text-xs">Last 7 days attribution</p>
            </div>
            <div class="text-right">
                <span class="font-semibold text-2xl tabular-nums">
                    @FormatNumber(_totalSessions)
                </span>
                <p class="mt-0.5 text-muted-foreground text-xs">total sessions</p>
            </div>
        </div>

        @* Distribution bar *@
        <div class="border-b px-4 py-3">
            <div class="flex h-3 overflow-hidden rounded-full bg-muted">
                @foreach (var channel in _channels)
                {
                    <div class="@(Cn.Merge("h-full opacity-60", channel.Color))"
                         style="@($"width: {channel.Share}%")"></div>
                }
            </div>
            <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1">
                @foreach (var channel in _channels)
                {
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@(Cn.Merge("size-1.5 rounded-full", channel.DotColor))"></span>
                        @channel.Name
                        <span class="tabular-nums">@channel.Share%</span>
                    </span>
                }
            </div>
        </div>

        @* Column labels *@
        <div class="flex items-center border-b bg-muted/30 px-4 py-2">
            <span class="min-w-0 flex-1 font-medium text-muted-foreground text-xs">Channel</span>
            <span class="w-16 shrink-0 text-right font-medium text-muted-foreground text-xs">Sessions</span>
            <span class="w-14 shrink-0 text-right font-medium text-muted-foreground text-xs">CVR</span>
            <span class="w-14 shrink-0 text-right font-medium text-muted-foreground text-xs">Bounce</span>
            <span class="w-16 shrink-0 text-right font-medium text-muted-foreground text-xs">Trend</span>
        </div>

        @* Channel rows *@
        <div>
            @for (var i = 0; i < _channels.Length; i++)
            {
                var channel = _channels[i];
                var isLast = i == _channels.Length - 1;
                <div class="@(Cn.Merge("flex items-center px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b"))">
                    <div class="flex min-w-0 flex-1 items-center gap-2">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", channel.DotColor))"></span>
                        <span class="font-medium text-sm">@channel.Name</span>
                    </div>
                    <span class="w-16 shrink-0 text-right font-semibold text-sm tabular-nums">
                        @FormatNumber(channel.Sessions)
                    </span>
                    <span class="w-14 shrink-0 text-right text-muted-foreground text-sm tabular-nums">
                        @channel.ConversionRate%
                    </span>
                    <span class="w-14 shrink-0 text-right text-muted-foreground text-sm tabular-nums">
                        @channel.BounceRate%
                    </span>
                    <div class="flex w-16 shrink-0 items-center justify-end">
                        @if (channel.Trend == "up")
                        {
                            <span class="flex items-center gap-0.5 text-emerald-600 text-xs dark:text-emerald-400">
                                <LucideTrendingUpCn Size="12" Class="size-3" />
                                <span class="tabular-nums">+@channel.TrendDelta%</span>
                            </span>
                        }
                        else if (channel.Trend == "down")
                        {
                            <span class="flex items-center gap-0.5 text-red-600 text-xs dark:text-red-400">
                                <LucideTrendingDownCn Size="12" Class="size-3" />
                                <span class="tabular-nums">@channel.TrendDelta%</span>
                            </span>
                        }
                        else
                        {
                            <span class="text-muted-foreground text-xs">\u2014</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TrafficChannel(string Id, string Name, int Sessions, int Share, double ConversionRate, int BounceRate, string Trend, double TrendDelta, string Color, string DotColor);

    private const int _totalSessions = 48_320;

    private static string FormatNumber(int n) =>
        n >= 1_000 ? $"{(double)n / 1_000:F1}K" : n.ToString();

    private static readonly TrafficChannel[] _channels =
    [
        new("c1", "Organic Search", 19_328, 40, 3.2, 42, "up", 8.4, "bg-emerald-500", "bg-emerald-500"),
        new("c2", "Paid Ads", 11_597, 24, 4.8, 38, "up", 12.1, "bg-blue-500", "bg-blue-500"),
        new("c3", "Referral", 7_248, 15, 2.9, 51, "down", -3.2, "bg-amber-500", "bg-amber-500"),
        new("c4", "Direct", 5_798, 12, 5.1, 35, "stable", 0.3, "bg-purple-500", "bg-purple-500"),
        new("c5", "Social", 2_899, 6, 1.8, 62, "down", -5.7, "bg-pink-500", "bg-pink-500"),
        new("c6", "Email", 1_450, 3, 6.2, 28, "up", 15.3, "bg-cyan-500", "bg-cyan-500"),
    ];
}
