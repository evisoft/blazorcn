@* ============================================================
   Block: dashboard-integration-status
   Title: Dashboard Integration Status
   Description: Animated React connected integrations status dashboard block for Next.js with eight third-party services showing connection status dots, last sync timestamps, synced data counts, and configure actions with error state highlighting using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: KPI metrics with trend indicators
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-integration-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Integrations</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Connected services and sync status
                </p>
            </div>
            <div class="flex items-center gap-3 text-xs">
                <span class="flex items-center gap-1.5 text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_integrations.Count(i => i.Status == "connected") connected
                </span>
                @{
                    var errorCount = _integrations.Count(i => i.Status == "error");
                }
                @if (errorCount > 0)
                {
                    <span class="flex items-center gap-1.5 text-red-600 dark:text-red-400">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        @errorCount error
                    </span>
                }
            </div>
        </div>

        @* Table header *@
        <div class="flex items-center gap-3 border-b bg-muted/30 px-4 py-2 text-muted-foreground text-xs">
            <span class="min-w-0 flex-1">Service</span>
            <span class="w-20">Status</span>
            <span class="w-24">Last Sync</span>
            <span class="w-28 text-right">Data Synced</span>
            <span class="w-20"></span>
        </div>

        @* Integration rows *@
        <div>
            @for (var i = 0; i < _integrations.Length; i++)
            {
                var integration = _integrations[i];
                var config = _statusConfig[integration.Status];
                var isLast = i == _integrations.Length - 1;
                var isError = integration.Status == "error";
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b", isError ? "bg-red-500/5" : ""))">
                    <div class="flex min-w-0 flex-1 items-center gap-3">
                        @switch (integration.Icon)
                        {
                            case "git-branch":
                                <LucideGitBranchCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                break;
                            case "message-square":
                                <LucideMessageSquareCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                break;
                            case "credit-card":
                                <LucideCreditCardCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                break;
                            case "database":
                                <LucideDatabaseCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                break;
                            case "mail":
                                <LucideMailCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                break;
                            case "bar-chart":
                                <LucideBarChartCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                break;
                            case "cloud":
                                <LucideCloudCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                break;
                            case "file-text":
                                <LucideFileTextCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                break;
                        }
                        <div class="min-w-0">
                            <span class="font-medium text-sm">@integration.Name</span>
                            @if (!string.IsNullOrEmpty(integration.ErrorMessage))
                            {
                                <p class="mt-0.5 text-red-600 text-xs dark:text-red-400">
                                    @integration.ErrorMessage
                                </p>
                            }
                        </div>
                    </div>
                    <div class="flex w-20 items-center gap-1.5">
                        <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", config.Dot))"></span>
                        <span class="text-muted-foreground text-xs">@config.Label</span>
                    </div>
                    <span class="w-24 text-muted-foreground text-xs">@integration.LastSync</span>
                    <span class="w-28 text-right text-xs tabular-nums">@integration.DataSynced</span>
                    <div class="w-20 text-right">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                            @(integration.Status == "disconnected" ? "Connect" : "Configure")
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record IntegrationItem(string Name, string Icon, string Status, string LastSync, string DataSynced, string? ErrorMessage = null);
    private record StatusConfig(string Label, string Dot);

    private static readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["connected"] = new("Connected", "bg-emerald-500"),
        ["error"] = new("Error", "bg-red-500"),
        ["disconnected"] = new("Disconnected", "bg-muted-foreground/40"),
    };

    private static readonly IntegrationItem[] _integrations =
    [
        new("GitHub", "git-branch", "connected", "2 min ago", "1,284 commits"),
        new("Slack", "message-square", "connected", "5 min ago", "842 messages"),
        new("Stripe", "credit-card", "connected", "12 min ago", "3,621 transactions"),
        new("PostgreSQL", "database", "connected", "1 min ago", "48 tables"),
        new("SendGrid", "mail", "error", "3 hours ago", "12,480 emails", "API key expired"),
        new("Google Analytics", "bar-chart", "connected", "30 min ago", "248K events"),
        new("AWS S3", "cloud", "disconnected", "Never", "0 files"),
        new("Notion", "file-text", "connected", "18 min ago", "156 pages"),
    ];
}
