@* ============================================================
   Block: dashboard-monthly-recap
   Title: Dashboard Monthly Recap
   Description: Animated React monthly performance recap dashboard for Next.js with key metrics summary, highlights list, notable changes with trend indicators, and month-over-month comparison using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Four KPI metric cards with trend indicators
   Dependencies: BadgeCn
   Source: original/blocks/dashboard/dashboard-monthly-recap.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideCalendarCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Monthly Recap</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">@_month</p>
                </div>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                vs January
            </BadgeCn>
        </div>

        @* Headline metrics *@
        <div class="grid grid-cols-4 border-b">
            @for (var i = 0; i < _headlines.Length; i++)
            {
                var metric = _headlines[i];
                <div class="@(Cn.Merge("px-4 py-3", i < 3 ? "border-r" : ""))">
                    <span class="font-medium text-muted-foreground text-[10px]">@metric.Label</span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-semibold text-lg tabular-nums">@metric.Value</span>
                    </div>
                    <div class="mt-1 flex items-center gap-1">
                        @if (metric.Direction == "up")
                        {
                            <LucideArrowUpRightCn Size="12" Class="size-3 text-emerald-500" />
                        }
                        else
                        {
                            <LucideArrowDownRightCn Size="12" Class="size-3 text-emerald-500" />
                        }
                        <span class="@(Cn.Merge("text-[10px] tabular-nums", metric.Id == "h3" ? "text-emerald-600 dark:text-emerald-400" : GetTrendColor(metric.Direction, null)))">
                            @metric.Change
                        </span>
                    </div>
                </div>
            }
        </div>

        @* Highlights *@
        <div class="border-b">
            <div class="flex items-center gap-1.5 border-b px-4 py-2">
                <LucideSparklesCn Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Highlights</span>
            </div>
            @for (var i = 0; i < _highlights.Length; i++)
            {
                var highlight = _highlights[i];
                var isLast = i == _highlights.Length - 1;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-2.5", !isLast ? "border-b" : ""))">
                    <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                    <span class="min-w-0 flex-1 text-sm">@highlight.Text</span>
                    <span class="shrink-0 rounded bg-muted px-1.5 py-0.5 text-[10px] text-muted-foreground">
                        @highlight.Category
                    </span>
                </div>
            }
        </div>

        @* Notable changes *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Notable Changes</span>
            </div>
            @for (var i = 0; i < _notableChanges.Length; i++)
            {
                var change = _notableChanges[i];
                var isLast = i == _notableChanges.Length - 1;
                var trendColor = GetTrendColor(change.Direction, change.Impact);
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", !isLast ? "border-b" : ""))">
                    @if (change.Impact == "positive")
                    {
                        <LucideTrendingUpCn Size="14" Class="size-3.5 shrink-0 text-emerald-500" />
                    }
                    else
                    {
                        <LucideTrendingDownCn Size="14" Class="size-3.5 shrink-0 text-red-500" />
                    }
                    <span class="min-w-0 flex-1 text-sm">@change.Metric</span>
                    <div class="flex shrink-0 items-center gap-2">
                        <span class="text-muted-foreground text-xs tabular-nums">@change.From</span>
                        <span class="text-muted-foreground text-[10px]">&rarr;</span>
                        <span class="text-xs tabular-nums">@change.To</span>
                        <span class="@(Cn.Merge("font-medium text-xs tabular-nums", trendColor))">
                            @change.Change
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private const string _month = "February 2026";

    private record HeadlineMetric(string Id, string Label, string Value, string PreviousValue, string Change, string Direction);
    private record Highlight(string Id, string Text, string Category);
    private record NotableChange(string Id, string Metric, string From, string To, string Change, string Direction, string Impact);

    private static string GetTrendColor(string direction, string? impact)
    {
        if (impact == "negative") return "text-red-600 dark:text-red-400";
        if (impact == "positive") return "text-emerald-600 dark:text-emerald-400";
        if (direction == "up") return "text-emerald-600 dark:text-emerald-400";
        if (direction == "down") return "text-red-600 dark:text-red-400";
        return "text-muted-foreground";
    }

    private readonly HeadlineMetric[] _headlines = new[]
    {
        new HeadlineMetric("h1", "Revenue", "$842K", "$781K", "+7.8%", "up"),
        new HeadlineMetric("h2", "Active Users", "48.2K", "44.6K", "+8.1%", "up"),
        new HeadlineMetric("h3", "Churn Rate", "2.1%", "2.8%", "-25%", "down"),
        new HeadlineMetric("h4", "NPS Score", "72", "68", "+5.9%", "up")
    };

    private readonly Highlight[] _highlights = new[]
    {
        new Highlight("hl1", "Crossed 50K registered users milestone", "Growth"),
        new Highlight("hl2", "Reduced P95 latency from 420ms to 180ms", "Performance"),
        new Highlight("hl3", "Launched team workspaces with 340 early adopters", "Product"),
        new Highlight("hl4", "Achieved SOC 2 Type II certification", "Compliance")
    };

    private readonly NotableChange[] _notableChanges = new[]
    {
        new NotableChange("nc1", "API request volume", "12.4M", "18.1M", "+46%", "up", "positive"),
        new NotableChange("nc2", "Support ticket volume", "842", "1,204", "+43%", "up", "negative"),
        new NotableChange("nc3", "Average session duration", "4m 12s", "6m 48s", "+62%", "up", "positive"),
        new NotableChange("nc4", "Trial-to-paid conversion", "12.4%", "15.8%", "+27%", "up", "positive"),
        new NotableChange("nc5", "Infrastructure cost", "$18.2K", "$22.6K", "+24%", "up", "negative")
    };
}
