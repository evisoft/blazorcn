@* ============================================================
   Block: dashboard-cache-performance
   Title: Dashboard Cache Performance
   Description: Animated React cache performance dashboard block for Next.js displaying hit rate, miss rate, evictions, and memory usage with cache key distribution patterns showing hit counts and TTL values using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: API request volume and latency metrics
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-cache-performance.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Cache Performance</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Redis cluster metrics and key distribution
            </p>
        </div>

        @* Metrics row *@
        <div class="grid grid-cols-4 border-b">
            @for (var i = 0; i < _metrics.Length; i++)
            {
                var metric = _metrics[i];
                <div class="@(Cn.Merge("px-4 py-3", i < 3 ? "border-r" : ""))">
                    <p class="text-muted-foreground text-xs">@metric.Label</p>
                    <p class="@(Cn.Merge("mt-1 font-semibold text-lg tabular-nums", metric.Color))">
                        @metric.Value
                    </p>
                </div>
            }
        </div>

        @* Memory bar *@
        <div class="border-b px-4 py-3">
            <div class="mb-1.5 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Memory Usage</span>
                <span class="font-medium text-xs tabular-nums">@_memoryPercent%</span>
            </div>
            <div class="h-2 w-full overflow-hidden rounded-full bg-muted/50">
                <div class="h-full rounded-full bg-foreground/80"
                     style="@($"width: {_memoryPercent}%")">
                </div>
            </div>
        </div>

        @* Cache key distribution *@
        <div class="px-4 py-3">
            <p class="mb-3 font-medium text-muted-foreground text-xs">Key Distribution</p>
            <div class="space-y-3">
                @foreach (var key in _cacheKeys)
                {
                    var barWidth = (double)key.Hits / _maxHits * 100;
                    <div>
                        <div class="mb-1 flex items-center justify-between">
                            <span class="font-mono text-xs">@key.Pattern</span>
                            <div class="flex items-center gap-3">
                                <span class="font-medium text-xs tabular-nums">@key.Hits.ToString("N0")</span>
                                <span class="w-8 text-right text-muted-foreground text-xs">@key.Ttl</span>
                            </div>
                        </div>
                        <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted/50">
                            <div class="h-full rounded-full bg-foreground/20"
                                 style="@($"width: {barWidth:F1}%")">
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record MetricItem(string Label, string Value, string Color);
    private record CacheKeyItem(string Pattern, int Hits, string Ttl);

    private const int _memoryPercent = 60;
    private const int _maxHits = 48200;

    private static readonly MetricItem[] _metrics =
    [
        new("Hit Rate", "94.8%", "text-emerald-600 dark:text-emerald-400"),
        new("Miss Rate", "5.2%", "text-red-600 dark:text-red-400"),
        new("Evictions", "1.2K", ""),
        new("Memory", "2.4/4 GB", ""),
    ];

    private static readonly CacheKeyItem[] _cacheKeys =
    [
        new("user:session:*", 48200, "30m"),
        new("api:response:*", 31500, "5m"),
        new("product:catalog:*", 22800, "1h"),
        new("search:query:*", 15400, "15m"),
        new("config:feature:*", 8900, "24h"),
    ];
}
