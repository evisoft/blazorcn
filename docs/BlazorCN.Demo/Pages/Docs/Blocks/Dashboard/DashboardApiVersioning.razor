@* ============================================================
   Block: dashboard-api-versioning
   Title: Dashboard Api Versioning
   Description: Animated React API versioning dashboard block for Next.js with version lifecycle tracking, deprecation schedules, migration progress bars, consumer counts, and expandable migration guides using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: API request metrics with endpoint breakdown
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-api-versioning.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">API Versions</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_versions.Length versions · @_totalConsumers.ToString("N0") total consumers
                </p>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @(_versions.Count(v => v.Status == "active")) active
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @(_versions.Count(v => v.Status == "deprecated")) deprecated
                </span>
            </div>
        </div>

        @* Version rows *@
        <div>
            @for (var i = 0; i < _versions.Length; i++)
                        {
                var version = _versions[i];
                var index = i;
                var isExpanded = _expanded == version.Id;
                var config = _statusConfig[version.Status];

                <div class="@(index < _versions.Length - 1 ? "border-b" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : version.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", config.Dot))"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-mono font-medium text-sm">@version.Version</span>
                                <span class="@(Cn.Merge("inline-flex items-center rounded px-1.5 py-0.5 text-[10px] font-medium", config.Badge))">
                                    @config.Label
                                </span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span>Released @version.ReleaseDate</span>
                                @if (version.DeprecationDate != null)
                                            {
                                    <span>·</span>
                                    <span>
                                        @(version.Status == "sunset" ? "Sunset" : "Sunset by")
                                        @(version.Status == "sunset" ? version.SunsetDate : version.DeprecationDate)
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                <LucideUsersCn Size="12" Class="size-3" />
                                <span class="tabular-nums">@version.Consumers</span>
                            </span>
                            <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                        </div>
                    </button>

                    @if (isExpanded)
                                {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-4 pl-9">
                                @* Migration progress *@
                                @if (version.Status != "active")
                                            {
                                    <div class="mb-3">
                                        <div class="mb-1.5 flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">
                                                Migration progress
                                            </span>
                                            <span class="font-medium text-xs tabular-nums">
                                                @version.MigrationProgress%
                                            </span>
                                        </div>
                                        <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                                            <div class="@(Cn.Merge("h-full rounded-full", version.MigrationProgress >= 90 ? "bg-emerald-500" : version.MigrationProgress >= 50 ? "bg-amber-500" : "bg-red-500"))"
                                                 style="@($"width: {version.MigrationProgress}%")">
                                            </div>
                                        </div>
                                    </div>
                                }
                                @* Key changes *@
                                <div class="mb-3">
                                    <span class="font-medium text-muted-foreground text-xs">
                                        Key changes
                                    </span>
                                    <ul class="mt-1 space-y-0.5">
                                        @foreach (var change in version.Changes)
                                                    {
                                            <li class="flex items-start gap-2 text-sm">
                                                <span class="mt-1.5 size-1 shrink-0 rounded-full bg-muted-foreground/40"></span>
                                                @change
                                            </li>
                                        }
                                    </ul>
                                </div>

                                @* Migration guide *@
                                <div class="rounded-md bg-muted/50 p-3">
                                    <div class="mb-1.5 flex items-center gap-1.5">
                                        <LucideBookOpenCn Size="12" Class="size-3 text-muted-foreground" />
                                        <span class="font-medium text-muted-foreground text-xs">
                                            Migration guide
                                        </span>
                                    </div>
                                    <p class="text-sm leading-relaxed">@version.MigrationGuide</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "v3";

    private record StatusConfig(string Dot, string Label, string Badge);
    private record ApiVersion(string Id, string Version, string Status, string ReleaseDate, string? DeprecationDate, string? SunsetDate, int Consumers, int MigrationProgress, string[] Changes, string MigrationGuide);

    private readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["active"] = new("bg-emerald-500", "Active", "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"),
        ["deprecated"] = new("bg-amber-500", "Deprecated", "bg-amber-500/10 text-amber-600 dark:text-amber-400"),
        ["sunset"] = new("bg-red-500", "Sunset", "bg-red-500/10 text-red-600 dark:text-red-400")
    };

    private int _totalConsumers => _versions.Sum(v => v.Consumers);

    private readonly ApiVersion[] _versions = new[]
    {
        new ApiVersion("v1", "v3.2", "active", "Jan 2026", null, null, 847, 100,
            new[] { "Pagination cursor support", "Batch endpoint for bulk operations", "Rate limit headers in all responses" },
            "No migration needed. This is the current stable version."),
        new ApiVersion("v2", "v3.1", "active", "Sep 2025", null, null, 1243, 100,
            new[] { "OAuth 2.1 authentication", "Webhook signature verification", "Improved error response format" },
            "Upgrade to v3.2 by replacing offset pagination with cursor-based pagination. Update bulk create calls to use the new /batch endpoint."),
        new ApiVersion("v3", "v3.0", "deprecated", "Mar 2025", "Jun 2026", null, 412, 67,
            new[] { "REST to JSON:API format migration", "New resource relationships", "Filter query parameter syntax" },
            "Update response parsing to handle JSON:API envelope format. Replace filter[field]=value query syntax with the new nested filter format. Update all relationship endpoints from /resource/:id/related to /resource/:id/relationships/related."),
        new ApiVersion("v4", "v2.8", "deprecated", "Oct 2024", "Mar 2026", null, 89, 91,
            new[] { "Legacy authentication model", "XML response support", "Synchronous webhook delivery" },
            "Replace API key authentication with OAuth 2.1 tokens. Remove XML Accept headers as only JSON is supported from v3.0. Migrate webhook consumers to async delivery with retry support."),
        new ApiVersion("v5", "v2.0", "sunset", "Feb 2023", "Jan 2025", "Jan 2026", 3, 99,
            new[] { "Original REST API", "Basic API key auth", "No rate limiting" },
            "This version has been sunset. All requests return 410 Gone. Contact the 3 remaining consumers directly to assist with migration to v3.x.")
    };
}
