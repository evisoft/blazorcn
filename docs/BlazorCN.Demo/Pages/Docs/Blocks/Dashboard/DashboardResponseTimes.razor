@* ============================================================
   Block: dashboard-response-times
   Title: Dashboard Response Times
   Description: Animated React API response time distribution dashboard block for Next.js displaying percentile breakdowns with P50, P75, P90, P95, P99 latencies, endpoint-level timing, SLA compliance, and animated latency bars using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: API request volume and latency metrics
   Dependencies: BadgeCn
   Source: original/blocks/dashboard/dashboard-response-times.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideActivityCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Response Times</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        2.8M requests · SLA target 200ms
                    </p>
                </div>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="@(Cn.Merge("font-normal text-xs", _slaCompliance >= 99 ? "text-emerald-600 dark:text-emerald-400" : _slaCompliance >= 95 ? "text-amber-600 dark:text-amber-400" : "text-red-600 dark:text-red-400"))">
                @(_slaCompliance)% SLA
            </BadgeCn>
        </div>

        @* Percentile breakdown *@
        <div class="grid grid-cols-5 border-b">
            @for (var i = 0; i < _percentiles.Length; i++)
            {
                var p = _percentiles[i];
                <div class="@(Cn.Merge("px-4 py-3", i < 4 ? "border-r" : ""))">
                    <p class="text-muted-foreground text-xs">@p.Label</p>
                    <p class="@(Cn.Merge("mt-1 font-semibold text-lg tabular-nums", LatencyColor(p.ValueMs)))">
                        @p.Value
                    </p>
                    <p class="mt-0.5 text-muted-foreground text-[10px]">@p.Sla</p>
                </div>
            }
        </div>

        @* Endpoint breakdown *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Endpoint Latency</span>
            </div>
            @for (var i = 0; i < _endpoints.Length; i++)
            {
                var ep = _endpoints[i];
                var isLast = i == _endpoints.Length - 1;
                var barPct = (double)ep.P99Ms / _maxP99 * 100;
                <div class="@(Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : ""))">
                    <div class="flex items-center gap-2">
                        <span class="@(Cn.Merge("inline-flex shrink-0 rounded px-1.5 py-0.5 font-mono text-[10px] font-medium", _methodColor[ep.Method]))">
                            @ep.Method
                        </span>
                        <span class="min-w-0 flex-1 truncate font-mono text-xs">@ep.Endpoint</span>
                        <span class="shrink-0 text-muted-foreground text-xs tabular-nums">
                            @ep.Rpm rpm
                        </span>
                    </div>
                    <div class="mt-2 flex items-center gap-3">
                        <div class="flex items-center gap-1.5">
                            <span class="text-muted-foreground text-[10px]">avg</span>
                            <span class="@(Cn.Merge("font-medium text-xs tabular-nums", LatencyColor(ep.AvgMs)))">
                                @ep.Avg
                            </span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <span class="text-muted-foreground text-[10px]">p99</span>
                            <span class="@(Cn.Merge("font-medium text-xs tabular-nums", LatencyColor(ep.P99Ms)))">
                                @ep.P99
                            </span>
                        </div>
                        <div class="ml-auto h-1.5 flex-1 overflow-hidden rounded-full bg-muted/50">
                            <div class="@(Cn.Merge("h-full rounded-full", BarColor(ep.P99Ms)))"
                                 style="@($"width: {barPct:F1}%")"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record PercentileMetric(string Label, string Value, int ValueMs, string Sla);
    private record EndpointLatency(string Id, string Endpoint, string Method, int AvgMs, string Avg, int P99Ms, string P99, string Rpm);

    private const double _slaCompliance = 98.4;
    private const int _maxP99 = 1420;

    private static string LatencyColor(int ms) =>
        ms <= 100 ? "text-emerald-600 dark:text-emerald-400"
        : ms <= 300 ? "text-amber-600 dark:text-amber-400"
        : "text-red-600 dark:text-red-400";

    private static string BarColor(int ms) =>
        ms <= 200 ? "bg-emerald-500/60"
        : ms <= 500 ? "bg-amber-500/60"
        : "bg-red-500/60";

    private static readonly Dictionary<string, string> _methodColor = new()
    {
        ["GET"] = "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        ["POST"] = "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        ["PUT"] = "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        ["DELETE"] = "bg-red-500/10 text-red-600 dark:text-red-400",
    };

    private static readonly PercentileMetric[] _percentiles =
    [
        new("P50", "12ms", 12, "< 50ms"),
        new("P75", "34ms", 34, "< 100ms"),
        new("P90", "89ms", 89, "< 150ms"),
        new("P95", "142ms", 142, "< 200ms"),
        new("P99", "387ms", 387, "< 500ms"),
    ];

    private static readonly EndpointLatency[] _endpoints =
    [
        new("e1", "/api/search", "GET", 145, "145ms", 892, "892ms", "4.2K"),
        new("e2", "/api/users/:id", "GET", 23, "23ms", 112, "112ms", "8.7K"),
        new("e3", "/api/orders", "POST", 67, "67ms", 340, "340ms", "1.1K"),
        new("e4", "/api/analytics/events", "POST", 18, "18ms", 78, "78ms", "24.5K"),
        new("e5", "/api/auth/token", "POST", 42, "42ms", 198, "198ms", "3.8K"),
        new("e6", "/api/reports/generate", "GET", 234, "234ms", 1420, "1.4s", "120"),
    ];
}
