@* ============================================================
   Block: dashboard-team-workload
   Title: Dashboard Team Workload
   Description: Animated React team workload dashboard block for Next.js displaying six team members with initials avatars, assigned task counts, story point totals, animated capacity progress bars, and utilization percentages with semantic color coding for over-capacity warning using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Activity heatmap with engagement patterns
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-team-workload.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Team Workload</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Sprint capacity and utilization by member
            </p>
        </div>

        @* Header *@
        <div class="grid grid-cols-[1fr_60px_60px_1fr_56px] items-center gap-3 border-b bg-muted/30 px-4 py-2">
            <span class="text-muted-foreground text-xs">Member</span>
            <span class="text-right text-muted-foreground text-xs">Tasks</span>
            <span class="text-right text-muted-foreground text-xs">Points</span>
            <span class="text-muted-foreground text-xs">Capacity</span>
            <span class="text-right text-muted-foreground text-xs">Util.</span>
        </div>

        @* Members *@
        <div>
            @for (var i = 0; i < _members.Length; i++)
            {
                var member = _members[i];
                var isLast = i == _members.Length - 1;
                var cappedWidth = Math.Min(member.Utilization, 100);
                <div class="@(Cn.Merge("grid grid-cols-[1fr_60px_60px_1fr_56px] items-center gap-3 px-4 py-3", isLast ? "" : "border-b"))">
                    <div class="flex items-center gap-2.5">
                        <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium">
                            @member.Initials
                        </div>
                        <span class="truncate text-sm">@member.Name</span>
                    </div>
                    <span class="text-right text-muted-foreground text-sm tabular-nums">
                        @member.AssignedTasks
                    </span>
                    <span class="text-right font-medium text-sm tabular-nums">
                        @member.StoryPoints
                    </span>
                    <div class="h-2 w-full overflow-hidden rounded-full bg-muted/50">
                        <div class="@(Cn.Merge("h-full rounded-full", BarColor(member.Utilization)))"
                             style="@($"width: {cappedWidth}%")"></div>
                    </div>
                    <span class="@(Cn.Merge("text-right font-medium text-xs tabular-nums", UtilizationColor(member.Utilization)))">
                        @member.Utilization%
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TeamMember(string Id, string Initials, string Name, int AssignedTasks, int StoryPoints, int Utilization);

    private static string UtilizationColor(int util) =>
        util > 100 ? "text-red-600 dark:text-red-400"
        : util >= 80 ? "text-amber-600 dark:text-amber-400"
        : "text-emerald-600 dark:text-emerald-400";

    private static string BarColor(int util) =>
        util > 100 ? "bg-red-500/60"
        : util >= 80 ? "bg-amber-500/60"
        : "bg-emerald-500/60";

    private static readonly TeamMember[] _members =
    [
        new("1", "SC", "Sarah Chen", 8, 21, 105),
        new("2", "AR", "Alex Rivera", 6, 18, 90),
        new("3", "MK", "Marcus Kim", 5, 13, 65),
        new("4", "EP", "Elena Petrov", 7, 19, 95),
        new("5", "JT", "James Taylor", 4, 10, 50),
        new("6", "LN", "Lina Nguyen", 9, 24, 120),
    ];
}
