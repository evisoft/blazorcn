@* ============================================================
   Block: dashboard-compliance-status
   Title: Dashboard Compliance Status
   Description: Animated React compliance status dashboard block for Next.js with six regulatory standards showing compliance states, last audit dates, next review schedules, control counts, and color-coded status indicators using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Service availability with 30-day charts
   Dependencies: LucideShieldCheckCn, LucideChevronRightCn
   Source: original/blocks/dashboard/dashboard-compliance-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideShieldCheckCn Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Compliance Status</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @_standards.Length frameworks tracked
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_compliantCount compliant
                </span>
                @if (_actionCount > 0)
                {
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        @_actionCount action needed
                    </span>
                }
            </div>
        </div>

        @* Column Headers *@
        <div class="hidden items-center gap-4 border-b bg-muted/30 px-4 py-2 md:flex">
            <span class="min-w-0 flex-1 text-muted-foreground text-xs">Standard</span>
            <span class="w-28 text-muted-foreground text-xs">Status</span>
            <span class="w-24 text-muted-foreground text-xs">Last Audit</span>
            <span class="w-24 text-muted-foreground text-xs">Next Review</span>
            <span class="w-20 text-right text-muted-foreground text-xs">Controls</span>
            <span class="w-4"></span>
        </div>

        @* Standards *@
        <div>
            @for (var i = 0; i < _standards.Length; i++)
            {
                var standard = _standards[i];
                var isExpanded = _expanded == standard.Id;
                var isLast = i == _standards.Length - 1;
                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = isExpanded ? null : standard.Id)"
                            class="flex w-full items-center gap-4 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", GetStatusDot(standard.Status)))"></span>
                                <span class="font-medium text-sm">@standard.Name</span>
                            </div>
                            <p class="mt-0.5 pl-3.5 text-muted-foreground text-xs">@standard.Description</p>
                        </div>
                        <span class="@(Cn.Merge("hidden w-28 shrink-0 rounded-full px-2 py-0.5 text-center text-xs md:inline-block", GetStatusStyle(standard.Status)))">
                            @standard.Status
                        </span>
                        <span class="hidden w-24 text-muted-foreground text-xs md:inline-block">@standard.LastAudit</span>
                        <span class="hidden w-24 text-muted-foreground text-xs md:inline-block">@standard.NextReview</span>
                        <span class="hidden w-20 text-right text-muted-foreground text-xs tabular-nums md:inline-block">
                            @standard.ControlsPassed/@standard.ControlsTotal
                        </span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4">
                            <div class="rounded-md bg-muted/50 p-3">
                                <p class="text-sm leading-relaxed">@standard.Details</p>
                                <div class="mt-3 flex items-center gap-4 md:hidden">
                                    <span class="@(Cn.Merge("rounded-full px-2 py-0.5 text-xs", GetStatusStyle(standard.Status)))">
                                        @standard.Status
                                    </span>
                                    <span class="text-muted-foreground text-xs">
                                        Controls: @standard.ControlsPassed/@standard.ControlsTotal
                                    </span>
                                </div>
                                <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-muted">
                                    <div class="@(Cn.Merge("h-full rounded-full", standard.Status == "Compliant" ? "bg-emerald-500" : standard.Status == "In Progress" ? "bg-amber-500" : "bg-red-500"))"
                                         style="@(FormattableString.Invariant($"width: {(double)standard.ControlsPassed / standard.ControlsTotal * 100:F1}%"))">
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record StandardItem(string Id, string Name, string Description, string Status, string LastAudit,
        string NextReview, int ControlsPassed, int ControlsTotal, string Details);

    private static string GetStatusStyle(string status) => status switch
    {
        "Compliant" => "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        "In Progress" => "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        "Action Required" => "bg-red-500/10 text-red-700 dark:text-red-400",
        _ => ""
    };

    private static string GetStatusDot(string status) => status switch
    {
        "Compliant" => "bg-emerald-500",
        "In Progress" => "bg-amber-500",
        "Action Required" => "bg-red-500",
        _ => ""
    };

    private static readonly StandardItem[] _standards =
    [
        new("soc2", "SOC 2 Type II", "Service Organization Control", "Compliant", "Jan 15, 2026", "Jul 15, 2026", 114, 114, "All trust service criteria satisfied. Annual audit completed with zero exceptions noted."),
        new("iso27001", "ISO 27001", "Information Security Management", "Compliant", "Nov 8, 2025", "Nov 8, 2026", 93, 93, "Certification renewed. Surveillance audit passed. Next full recertification in 2028."),
        new("gdpr", "GDPR", "EU Data Protection Regulation", "In Progress", "Feb 20, 2026", "May 20, 2026", 42, 48, "Six controls pending: cross-border data transfer updates, cookie consent v2 deployment, and DPO quarterly review."),
        new("hipaa", "HIPAA", "Health Insurance Portability", "Action Required", "Dec 1, 2025", "Apr 1, 2026", 38, 54, "16 controls need remediation: encryption at rest for PHI databases, access log retention policy, and workforce training renewal."),
        new("pcidss", "PCI DSS", "Payment Card Industry Standard", "Compliant", "Mar 5, 2026", "Sep 5, 2026", 78, 78, "Level 1 merchant compliance validated. Quarterly ASV scans passing. Penetration test completed."),
        new("ccpa", "CCPA", "California Consumer Privacy Act", "In Progress", "Jan 30, 2026", "Apr 30, 2026", 18, 22, "Four controls in progress: opt-out mechanism update, data inventory for new product line, vendor assessment, and privacy policy revision."),
    ];

    private static readonly int _compliantCount = _standards.Count(s => s.Status == "Compliant");
    private static readonly int _actionCount = _standards.Count(s => s.Status == "Action Required");
}
