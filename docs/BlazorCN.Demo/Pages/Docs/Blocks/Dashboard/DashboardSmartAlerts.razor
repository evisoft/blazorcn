@* ============================================================
   Block: dashboard-smart-alerts
   Title: Dashboard Smart Alerts
   Description: Animated React intelligent alert routing dashboard block for Next.js with severity-based alert grouping, snooze timers, acknowledge actions, escalation chains, and alert deduplication counts using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Active incident tracking with severity levels
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-smart-alerts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideBellRingCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Smart Alerts</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">@_alerts.Length active alerts</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_criticalCount critical
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_firingCount firing
                </span>
            </div>
        </div>

        @* Alerts *@
        <div>
            @for (var i = 0; i < _alerts.Length; i++)
            {
                var alert = _alerts[i];
                var isExpanded = _expanded == alert.Id;
                var isLast = i == _alerts.Length - 1;
                var sevConfig = _severityConfig[alert.Severity];
                var stConfig = _stateConfig[alert.State];

                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : alert.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="relative flex shrink-0 items-center justify-center">
                            <span class="@(Cn.Merge("size-2 rounded-full", sevConfig.Dot))"></span>
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@alert.Title</span>
                                @if (alert.DuplicateCount > 1)
                                {
                                    <span class="inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium tabular-nums">
                                        @alert.DuplicateCount
                                    </span>
                                }
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                <span class="font-mono">@alert.Source</span>
                                <span class="mx-1.5">&middot;</span>
                                @alert.FirstTriggered
                            </p>
                        </div>
                        <span class="@(Cn.Merge("shrink-0 text-xs", stConfig.Style))">@stConfig.Label</span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-2 px-4 pb-4 pl-9">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <p class="mb-3 text-sm leading-relaxed">@alert.Description</p>
                                    @if (alert.State == "firing")
                                    {
                                        <div class="flex flex-wrap items-center gap-2">
                                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                                                <LucideCheckCn Size="12" Class="size-3" />
                                                Acknowledge
                                            </ButtonCn>
                                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                                                <LucideClockCn Size="12" Class="size-3" />
                                                Snooze 30m
                                            </ButtonCn>
                                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                                                <LucideChevronUpCn Size="12" Class="size-3" />
                                                Escalate
                                            </ButtonCn>
                                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                                                <LucideBellOffCn Size="12" Class="size-3" />
                                                Mute
                                            </ButtonCn>
                                        </div>
                                    }
                                </div>

                                @* Escalation chain *@
                                <div class="rounded-md bg-muted/50 p-3">
                                    <span class="mb-2 block font-medium text-muted-foreground text-xs">
                                        Escalation chain
                                    </span>
                                    <div class="space-y-1.5">
                                        @for (var si = 0; si < alert.Escalation.Length; si++)
                                        {
                                            var step = alert.Escalation[si];
                                            <div class="flex items-center gap-2 text-xs">
                                                <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium tabular-nums">
                                                    @(si + 1)
                                                </span>
                                                <span class="flex-1">@step.Person</span>
                                                <span class="text-muted-foreground">@step.Role</span>
                                                <span class="font-mono text-muted-foreground tabular-nums">
                                                    @step.Timeout
                                                </span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "a1";

    private record EscalationStep(string Person, string Role, string Timeout);
    private record AlertData(string Id, string Title, string Source, string Severity, string State, int DuplicateCount, string FirstTriggered, string Description, EscalationStep[] Escalation);
    private record SeverityConfig(string Dot);
    private record StateConfig(string Label, string Style);

    private int _firingCount => _alerts.Count(a => a.State == "firing");
    private int _criticalCount => _alerts.Count(a => a.Severity == "critical");

    private readonly Dictionary<string, SeverityConfig> _severityConfig = new()
    {
        ["critical"] = new SeverityConfig("bg-red-500"),
        ["warning"] = new SeverityConfig("bg-amber-500"),
        ["info"] = new SeverityConfig("bg-blue-500")
    };

    private readonly Dictionary<string, StateConfig> _stateConfig = new()
    {
        ["firing"] = new StateConfig("Firing", "text-red-600 dark:text-red-400"),
        ["acknowledged"] = new StateConfig("Acked", "text-emerald-600 dark:text-emerald-400"),
        ["snoozed"] = new StateConfig("Snoozed", "text-muted-foreground")
    };

    private readonly AlertData[] _alerts = new[]
    {
        new AlertData("a1", "CPU utilization above 95%", "prod-api-3", "critical", "firing", 12, "8 min ago", "Node prod-api-3 has sustained CPU above 95% for 5 minutes. Auto-scaling triggered but new instances failing health checks.", new[]
        {
            new EscalationStep("Sarah Chen", "Primary On-Call", "5 min"),
            new EscalationStep("James Liu", "Secondary On-Call", "15 min"),
            new EscalationStep("Elena Rossi", "Engineering Manager", "30 min")
        }),
        new AlertData("a2", "Database connection pool exhausted", "postgres-primary", "critical", "acknowledged", 4, "22 min ago", "All 100 connection pool slots are in use. Queries are queuing with increasing latency. Consider increasing pool size or investigating long-running transactions.", new[]
        {
            new EscalationStep("Marcus Webb", "DBA On-Call", "5 min"),
            new EscalationStep("Sarah Chen", "Platform Lead", "15 min"),
            new EscalationStep("Elena Rossi", "Engineering Manager", "30 min")
        }),
        new AlertData("a3", "Error rate spike in checkout flow", "billing-service", "warning", "firing", 7, "12 min ago", "Checkout API error rate increased from 0.1% to 3.4% in the last 10 minutes. Correlated with Stripe API latency increase. Payment retries are succeeding.", new[]
        {
            new EscalationStep("Tom Bradley", "Payments On-Call", "10 min"),
            new EscalationStep("Priya Sharma", "Backend Lead", "20 min")
        }),
        new AlertData("a4", "SSL certificate expiring in 7 days", "api.acme.com", "warning", "snoozed", 1, "2 days ago", "The SSL certificate for api.acme.com expires on Mar 25, 2026. Auto-renewal is disabled. Manual renewal required.", new[]
        {
            new EscalationStep("Daniel Park", "Infrastructure On-Call", "1 hour")
        }),
        new AlertData("a5", "Disk usage at 82% on log volume", "log-aggregator", "info", "firing", 3, "45 min ago", "Log volume /var/log/app is at 82% capacity. At current ingestion rate, it will reach 90% in approximately 6 hours. Consider increasing log rotation frequency.", new[]
        {
            new EscalationStep("Nina Kowalski", "SRE On-Call", "30 min")
        }),
        new AlertData("a6", "Memory leak detected in worker process", "queue-worker-2", "warning", "firing", 2, "1 hour ago", "Worker process memory has grown from 512MB to 1.8GB over 3 hours without releasing. RSS trending upward at 400MB/hour. Restart recommended.", new[]
        {
            new EscalationStep("James Liu", "Backend On-Call", "15 min"),
            new EscalationStep("Priya Sharma", "Backend Lead", "30 min")
        })
    };
}
