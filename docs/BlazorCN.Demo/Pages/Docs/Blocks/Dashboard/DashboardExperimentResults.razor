@* ============================================================
   Block: dashboard-experiment-results
   Title: Dashboard Experiment Results
   Description: Animated React A/B experiment outcomes dashboard block for Next.js with statistical significance indicators, variant performance comparison, confidence intervals, lift percentages, and sample size tracking using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Five-step visitor-to-retained funnel analytics
   Dependencies: BadgeCn
   Source: original/blocks/dashboard/dashboard-experiment-results.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideFlaskConicalCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Experiment Results</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_activeCount running
            </BadgeCn>
        </div>

        @* Summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div>
                <p class="text-muted-foreground text-xs">Experiments</p>
                <p class="font-semibold text-2xl tabular-nums">@_experiments.Length</p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">Significant</p>
                <p class="font-semibold text-sm tabular-nums text-emerald-600 dark:text-emerald-400">
                    @_significantCount
                </p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">Running</p>
                <p class="font-semibold text-sm tabular-nums text-blue-600 dark:text-blue-400">
                    @_activeCount
                </p>
            </div>
        </div>

        @* Experiment list *@
        <div>
            @for (var i = 0; i < _experiments.Length; i++)
            {
                var experiment = _experiments[i];
                var isExpanded = _expanded == experiment.Id;
                var isLast = i == _experiments.Length - 1;

                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : experiment.Id)"
                        class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", GetStatusDot(experiment.Status)))"></span>
                        <span class="min-w-0 flex-1 font-medium text-sm">@experiment.Name</span>
                        @if (experiment.Status == "significant")
                        {
                            <span class="rounded bg-emerald-500/10 px-1.5 py-0.5 text-[10px] font-medium text-emerald-600 dark:text-emerald-400">
                                Significant
                            </span>
                        }
                        else if (experiment.Status == "not-significant")
                        {
                            <span class="rounded bg-muted/50 px-1.5 py-0.5 text-[10px] font-medium text-muted-foreground">
                                Not significant
                            </span>
                        }
                        else
                        {
                            <span class="rounded bg-blue-500/10 px-1.5 py-0.5 text-[10px] font-medium text-blue-600 dark:text-blue-400">
                                Running
                            </span>
                        }
                        <span class="@(Cn.Merge("w-12 shrink-0 text-right font-medium text-xs tabular-nums", GetLiftColor(experiment.Lift, experiment.Status)))">
                            @(experiment.Lift > 0 ? "+" : "")@(experiment.Lift)%
                        </span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-3 px-4 pb-4 pt-1">
                                <p class="text-muted-foreground text-xs">
                                    Primary metric: @experiment.Metric
                                </p>

                                @* Comparison bars *@
                                <div class="space-y-2">
                                    <div class="flex items-center gap-3">
                                        <span class="w-14 shrink-0 text-muted-foreground text-xs">
                                            Control
                                        </span>
                                        <div class="h-5 flex-1 overflow-hidden rounded bg-muted/30">
                                            <div class="h-full rounded bg-foreground/15"
                                                 style="@(FormattableString.Invariant($"width: {experiment.ControlRate}%"))">
                                            </div>
                                        </div>
                                        <span class="w-12 shrink-0 text-right font-medium text-xs tabular-nums">
                                            @(experiment.ControlRate)%
                                        </span>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <span class="w-14 shrink-0 text-muted-foreground text-xs">
                                            Variant
                                        </span>
                                        <div class="h-5 flex-1 overflow-hidden rounded bg-muted/30">
                                            <div class="@(Cn.Merge("h-full rounded", experiment.Lift > 0 ? "bg-emerald-500/30" : "bg-red-500/30"))"
                                                 style="@(FormattableString.Invariant($"width: {experiment.VariantRate}%"))">
                                            </div>
                                        </div>
                                        <span class="@(Cn.Merge("w-12 shrink-0 text-right font-medium text-xs tabular-nums", GetLiftColor(experiment.Lift, experiment.Status)))">
                                            @(experiment.VariantRate)%
                                        </span>
                                    </div>
                                </div>

                                @* Stats grid *@
                                <div class="rounded-md bg-muted/50 p-3">
                                    <div class="grid grid-cols-3 gap-y-2 text-xs">
                                        <div>
                                            <span class="text-muted-foreground">p-value</span>
                                            <p class="@(Cn.Merge("font-mono font-medium tabular-nums", experiment.PValue < 0.05 ? "text-emerald-600 dark:text-emerald-400" : ""))">
                                                @experiment.PValue.ToString("F3")
                                            </p>
                                        </div>
                                        <div>
                                            <span class="text-muted-foreground">Confidence</span>
                                            <p class="font-medium tabular-nums">@(experiment.Confidence)%</p>
                                        </div>
                                        <div>
                                            <span class="text-muted-foreground">Duration</span>
                                            <p class="font-medium tabular-nums">
                                                @(experiment.StartedDaysAgo)d
                                            </p>
                                        </div>
                                        <div>
                                            <span class="text-muted-foreground">Control n</span>
                                            <p class="font-medium tabular-nums">@experiment.ControlSample</p>
                                        </div>
                                        <div>
                                            <span class="text-muted-foreground">Variant n</span>
                                            <p class="font-medium tabular-nums">@experiment.VariantSample</p>
                                        </div>
                                        <div>
                                            <span class="text-muted-foreground">Target n</span>
                                            <p class="font-medium tabular-nums">@experiment.TargetSample</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "1";

    private record ExperimentData(string Id, string Name, string Metric, string Status, double ControlRate, double VariantRate, double Lift, double PValue, int Confidence, string ControlSample, string VariantSample, string TargetSample, int StartedDaysAgo);

    private int _activeCount => _experiments.Count(e => e.Status == "running");
    private int _significantCount => _experiments.Count(e => e.Status == "significant");

    private static string GetLiftColor(double lift, string status)
    {
        if (status == "running") return "text-muted-foreground";
        if (lift > 0) return "text-emerald-600 dark:text-emerald-400";
        return "text-red-600 dark:text-red-400";
    }

    private static string GetStatusDot(string status) => status switch
    {
        "significant" => "bg-emerald-500",
        "running" => "bg-blue-500",
        _ => "bg-zinc-400"
    };

    private readonly ExperimentData[] _experiments = new[]
    {
        new ExperimentData("1", "Checkout CTA color change", "Purchase conversion", "significant", 3.2, 4.1, 28.1, 0.003, 95, "24.8K", "25.1K", "20K", 14),
        new ExperimentData("2", "Simplified onboarding flow", "Activation rate", "significant", 42.8, 51.2, 19.6, 0.001, 99, "8.4K", "8.6K", "6K", 21),
        new ExperimentData("3", "Pricing page social proof", "Plan selection rate", "not-significant", 12.4, 13.1, 5.6, 0.34, 95, "5.2K", "5.1K", "18K", 7),
        new ExperimentData("4", "Search results ranking v2", "Click-through rate", "running", 28.6, 31.4, 9.8, 0.08, 95, "12.3K", "12.1K", "30K", 5),
        new ExperimentData("5", "Email subject line personalization", "Open rate", "significant", 22.1, 18.4, -16.7, 0.012, 95, "41.2K", "40.8K", "35K", 10)
    };
}
