@* ============================================================
   Block: dashboard-screenshot-tests
   Title: Dashboard Screenshot Tests
   Description: Animated React visual regression test results dashboard block for Next.js with diff percentages, baseline comparisons, pass and fail indicators, component names, and viewport labels using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Code quality metrics with coverage and tech debt
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-screenshot-tests.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideImageCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Screenshot Tests</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @_tests.Length visual regression snapshots
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_tests.Count(t => t.Status == "passed") passed
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_tests.Count(t => t.Status == "failed") failed
                </span>
            </div>
        </div>

        @* Tests *@
        <div>
            @for (var i = 0; i < _tests.Length; i++)
            {
                var test = _tests[i];
                var isExpanded = _expanded == test.Id;
                var isLast = i == _tests.Length - 1;
                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : test.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", _statusDot[test.Status]))"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@test.Component</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                <span class="font-mono">@test.Viewport</span>
                                <span class="mx-1.5">·</span>
                                <span class="font-mono">@test.Branch</span>
                            </p>
                        </div>
                        <span class="@(Cn.Merge("shrink-0 font-semibold text-sm tabular-nums", DiffColor(test.DiffPercent)))">
                            @(test.DiffPercent)%
                        </span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="flex items-center justify-between">
                                    <div class="flex flex-wrap items-center gap-3 text-xs">
                                        <span class="text-muted-foreground">
                                            Baseline: <span class="font-medium text-foreground">@test.BaselineDate</span>
                                        </span>
                                        <span class="text-muted-foreground">·</span>
                                        <span class="text-muted-foreground">
                                            <span class="font-mono tabular-nums">@test.PixelsDiff.ToString("N0")</span> pixels changed
                                        </span>
                                    </div>
                                </div>
                                @if (test.Status != "passed")
                                {
                                    <div class="mt-3 flex items-center gap-2">
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                                            <LucideEyeCn Size="12" Class="size-3" />
                                            View Diff
                                        </ButtonCn>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                                            <LucideCheckCn Size="12" Class="size-3" />
                                            Approve
                                        </ButtonCn>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs text-red-600 dark:text-red-400">
                                            <LucideXCn Size="12" Class="size-3" />
                                            Reject
                                        </ButtonCn>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "t2";

    private record ScreenshotTest(string Id, string Component, string Viewport, double DiffPercent, string Status, int PixelsDiff, string BaselineDate, string Branch);

    private static string DiffColor(double diff) =>
        diff == 0 ? "text-emerald-600 dark:text-emerald-400"
        : diff <= 0.1 ? "text-amber-600 dark:text-amber-400"
        : "text-red-600 dark:text-red-400";

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["passed"] = "bg-emerald-500",
        ["failed"] = "bg-red-500",
        ["warning"] = "bg-amber-500",
    };

    private static readonly ScreenshotTest[] _tests =
    [
        new("t1", "NavigationMenu", "1440x900", 0, "passed", 0, "Mar 14, 2026", "feat/nav-redesign"),
        new("t2", "HeroBanner", "1440x900", 2.34, "failed", 4821, "Mar 12, 2026", "feat/hero-update"),
        new("t3", "PricingTable", "768x1024", 0.08, "warning", 124, "Mar 15, 2026", "fix/pricing-alignment"),
        new("t4", "LoginForm", "375x812", 0, "passed", 0, "Mar 10, 2026", "main"),
        new("t5", "DashboardSidebar", "1440x900", 0.72, "failed", 1483, "Mar 13, 2026", "feat/sidebar-icons"),
        new("t6", "CheckoutFlow", "375x812", 5.19, "failed", 8247, "Mar 11, 2026", "feat/checkout-v2"),
        new("t7", "SettingsPanel", "1440x900", 0, "passed", 0, "Mar 16, 2026", "main"),
        new("t8", "UserAvatar", "768x1024", 0.03, "warning", 48, "Mar 15, 2026", "fix/avatar-border"),
    ];
}
