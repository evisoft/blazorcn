@* ============================================================
   Block: dashboard-access-logs
   Title: Dashboard Access Logs
   Description: Animated React access log viewer dashboard block for Next.js with ten HTTP request entries displaying timestamps, color-coded method chips for GET POST PUT DELETE, monospaced request paths, semantic status code coloring for 200 4xx 5xx responses, response times, and truncated user agent strings using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Active incident tracking with severity levels
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-access-logs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Access Logs</span>
                <p class="mt-0.5 text-muted-foreground text-xs">Recent HTTP requests</p>
            </div>
            <span class="font-mono text-muted-foreground text-xs">@_logs.Length entries</span>
        </div>

        @* Column headers *@
        <div class="flex items-center gap-3 border-b bg-muted/30 px-4 py-2 text-muted-foreground text-xs">
            <span class="w-24 shrink-0">Time</span>
            <span class="w-16 shrink-0">Method</span>
            <span class="min-w-0 flex-1">Path</span>
            <span class="w-12 shrink-0 text-right">Status</span>
            <span class="w-16 shrink-0 text-right">Duration</span>
            <span class="hidden w-40 shrink-0 truncate sm:block">User Agent</span>
        </div>

        @* Log entries *@
        <div>
            @for (var i = 0; i < _logs.Length; i++)
            {
                var log = _logs[i];
                var isLast = i == _logs.Length - 1;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b"))">
                    <span class="w-24 shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                        @log.Timestamp
                    </span>
                    <span class="@(Cn.Merge("w-16 shrink-0 rounded px-1.5 py-0.5 text-center font-mono text-xs font-medium", GetMethodColor(log.Method)))">
                        @log.Method
                    </span>
                    <span class="min-w-0 flex-1 truncate font-mono text-xs">@log.Path</span>
                    <span class="@(Cn.Merge("w-12 shrink-0 text-right font-mono text-xs font-medium tabular-nums", GetStatusColor(log.Status)))">
                        @log.Status
                    </span>
                    <span class="w-16 shrink-0 text-right font-mono text-muted-foreground text-xs tabular-nums">
                        @log.ResponseTime
                    </span>
                    <span class="hidden w-40 shrink-0 truncate text-muted-foreground text-xs sm:block">
                        @log.UserAgent
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record LogEntry(string Timestamp, string Method, string Path, int Status, string ResponseTime, string UserAgent);

    private static string GetMethodColor(string method) => method switch
    {
        "GET" => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        "POST" => "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        "PUT" => "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        "DELETE" => "bg-red-500/10 text-red-600 dark:text-red-400",
        _ => ""
    };

    private static string GetStatusColor(int status)
    {
        if (status >= 500) return "text-red-600 dark:text-red-400";
        if (status >= 400) return "text-amber-600 dark:text-amber-400";
        return "text-emerald-600 dark:text-emerald-400";
    }

    private static readonly LogEntry[] _logs =
    [
        new("14:32:08.412", "GET", "/api/v2/users/me", 200, "23ms", "Mozilla/5.0 Chrome/122"),
        new("14:32:07.891", "POST", "/api/v2/orders", 201, "142ms", "Mozilla/5.0 Firefox/124"),
        new("14:32:06.203", "GET", "/api/v2/products?category=electronics&limit=50", 200, "87ms", "PostmanRuntime/7.36"),
        new("14:32:05.774", "DELETE", "/api/v2/sessions/tok_8f3a", 204, "31ms", "Mozilla/5.0 Safari/17.3"),
        new("14:32:04.119", "POST", "/api/v2/auth/login", 401, "58ms", "Mozilla/5.0 Chrome/122"),
        new("14:32:03.556", "PUT", "/api/v2/users/usr_4b2c/preferences", 200, "112ms", "Mozilla/5.0 Edge/122"),
        new("14:32:02.081", "GET", "/api/v2/analytics/dashboard", 500, "2340ms", "Mozilla/5.0 Chrome/122"),
        new("14:32:01.420", "GET", "/api/v2/notifications?unread=true", 200, "45ms", "Dart/3.3 (flutter)"),
        new("14:31:59.832", "POST", "/api/v2/webhooks/stripe", 422, "67ms", "Stripe/1.0 (webhook)"),
        new("14:31:58.215", "GET", "/api/v2/health", 200, "4ms", "kube-probe/1.28"),
    ];
}
