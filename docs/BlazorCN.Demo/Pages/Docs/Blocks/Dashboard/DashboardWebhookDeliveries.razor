@* ============================================================
   Block: dashboard-webhook-deliveries
   Title: Dashboard Webhook Deliveries
   Description: Webhook delivery log dashboard with success rate metric, recent deliveries showing event types, endpoint URLs, color-coded HTTP status codes, response times, and timestamps
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-webhook-deliveries.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Webhook Deliveries</span>
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-muted-foreground text-xs">@SuccessCount/@_deliveries.Length successful</span>
                </div>
            </div>
        </div>

        @* Success rate *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div>
                <span class="text-muted-foreground text-xs">Success Rate</span>
                <div class="flex items-baseline gap-1">
                    <span class="@($"font-semibold text-2xl tabular-nums {SuccessRateColor}")">@SuccessRate</span>
                    <span class="text-muted-foreground text-xs">%</span>
                </div>
            </div>
            <span class="text-muted-foreground text-xs">&#183;</span>
            <span class="text-muted-foreground text-xs">Last 24 hours</span>
            <div class="ml-auto">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">View All</ButtonCn>
            </div>
        </div>

        @* Delivery table header *@
        <div class="hidden items-center gap-3 border-b bg-muted/30 px-4 py-2 sm:flex">
            <span class="w-40 text-muted-foreground text-xs">Event</span>
            <span class="min-w-0 flex-1 text-muted-foreground text-xs">Endpoint</span>
            <span class="w-14 text-right text-muted-foreground text-xs">Status</span>
            <span class="w-20 text-right text-muted-foreground text-xs">Response</span>
            <span class="w-20 text-right text-muted-foreground text-xs">Time</span>
        </div>

        @* Deliveries *@
        <div>
            @for (var i = 0; i < _deliveries.Length; i++)
                        {
                var delivery = _deliveries[i];
                var rowHighlight = delivery.StatusCode >= 400 ? "bg-red-500/5" : "";
                var statusColor = delivery.StatusCode >= 200 && delivery.StatusCode < 300
                    ? "text-emerald-600 dark:text-emerald-400"
                    : delivery.StatusCode >= 300 && delivery.StatusCode < 400
                        ? "text-amber-600 dark:text-amber-400"
                        : "text-red-600 dark:text-red-400";
                <div class="@Cn.Merge($"flex flex-col gap-1 px-4 py-2.5 sm:flex-row sm:items-center sm:gap-3 {rowHighlight}", i < _deliveries.Length - 1 ? "border-b" : "")">
                    <span class="w-40 shrink-0 truncate font-mono text-xs">@delivery.Event</span>
                    <span class="min-w-0 flex-1 truncate font-mono text-muted-foreground text-xs">@delivery.Endpoint</span>
                    <span class="@($"w-14 shrink-0 text-right font-mono text-xs font-medium tabular-nums {statusColor}")">@delivery.StatusCode</span>
                    <span class="w-20 shrink-0 text-right text-muted-foreground text-xs tabular-nums">@delivery.ResponseTime</span>
                    <span class="w-20 shrink-0 text-right text-muted-foreground text-xs">@delivery.Timestamp</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record DeliveryItem(string Id, string Event, string Endpoint, int StatusCode, string ResponseTime, string Timestamp);

    private int SuccessCount => _deliveries.Count(d => d.StatusCode >= 200 && d.StatusCode < 300);
    private string SuccessRate => ((double)SuccessCount / _deliveries.Length * 100).ToString("F1");
    private string SuccessRateColor
    {
        get
        {
            var rate = double.Parse(SuccessRate);
            return rate >= 99 ? "text-emerald-600 dark:text-emerald-400"
                : rate >= 95 ? "text-amber-600 dark:text-amber-400"
                : "text-red-600 dark:text-red-400";
        }
    }

    private readonly DeliveryItem[] _deliveries = [
        new("d1", "invoice.paid", "https://api.acme.com/webhooks/billing", 200, "142ms", "2 min ago"),
        new("d2", "user.created", "https://hooks.slack.com/services/T0/B0", 200, "89ms", "8 min ago"),
        new("d3", "subscription.updated", "https://api.acme.com/webhooks/billing", 200, "201ms", "15 min ago"),
        new("d4", "payment.failed", "https://api.partner.io/v2/notifications", 500, "4,210ms", "22 min ago"),
        new("d5", "user.deleted", "https://hooks.slack.com/services/T0/B0", 200, "76ms", "41 min ago"),
        new("d6", "invoice.created", "https://api.acme.com/webhooks/billing", 200, "118ms", "1 hour ago"),
        new("d7", "deployment.completed", "https://api.partner.io/v2/notifications", 408, "30,000ms", "2 hours ago"),
        new("d8", "user.updated", "https://hooks.slack.com/services/T0/B0", 200, "92ms", "3 hours ago"),
    ];
}
