@* ============================================================
   Block: dashboard-security-overview
   Title: Dashboard Security Overview
   Description: Animated React security dashboard block for Next.js with threat score display, vulnerability counts by severity, compliance status indicator, last scan timestamp, and five recent security alerts with severity dots and staggered animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Security event log with risk indicators
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-security-overview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Security Overview</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Threat assessment and vulnerability summary
            </p>
        </div>

        @* Threat score *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-4">
                <div class="flex items-baseline gap-1">
                    <span class="@(Cn.Merge("font-semibold text-3xl tabular-nums", GetScoreColor(_threatScore)))">
                        @_threatScore
                    </span>
                    <span class="text-muted-foreground text-xs">/100</span>
                </div>
                <div>
                    <span class="@(Cn.Merge("font-medium text-sm", GetScoreColor(_threatScore)))">
                        @GetScoreLabel(_threatScore) Risk
                    </span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Threat score based on active vulnerabilities
                    </p>
                </div>
            </div>
        </div>

        @* Vulnerability counts + compliance *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-4">
                @foreach (var vuln in _vulnerabilities)
                {
                    <div class="flex items-center gap-2">
                        <span class="@(Cn.Merge("size-1.5 rounded-full", vuln.Dot))"></span>
                        <span class="text-muted-foreground text-xs">@vuln.Label</span>
                        <span class="font-semibold text-sm tabular-nums">@vuln.Count</span>
                    </div>
                }
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <div class="flex items-center gap-1.5">
                    <LucideShieldCheckCn Size="14" Class="size-3.5 text-emerald-500" />
                    <span>Compliant</span>
                </div>
                <span>\u00b7</span>
                <span>Scanned @_lastScan</span>
            </div>
        </div>

        @* Recent alerts header *@
        <div class="border-b px-4 py-2">
            <span class="font-medium text-muted-foreground text-xs">Recent Alerts</span>
        </div>

        @* Alert rows *@
        <div>
            @for (var i = 0; i < _alerts.Length; i++)
            {
                var alert = _alerts[i];
                var isLast = i == _alerts.Length - 1;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b"))">
                    <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", _severityDot[alert.Severity]))"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@alert.Title</span>
                    </div>
                    <span class="shrink-0 text-muted-foreground text-xs">@alert.Timestamp</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private const int _threatScore = 12;
    private const string _lastScan = "15 minutes ago";

    private record VulnerabilityCount(string Label, int Count, string Dot);
    private record SecurityAlert(string Id, string Severity, string Title, string Timestamp);

    private static string GetScoreColor(int score) =>
        score >= 60 ? "text-red-600 dark:text-red-400"
        : score >= 25 ? "text-amber-600 dark:text-amber-400"
        : "text-emerald-600 dark:text-emerald-400";

    private static string GetScoreLabel(int score) =>
        score >= 60 ? "Critical"
        : score >= 25 ? "Elevated"
        : "Low";

    private static readonly Dictionary<string, string> _severityDot = new()
    {
        ["critical"] = "bg-red-500",
        ["high"] = "bg-amber-500",
        ["medium"] = "bg-yellow-500",
        ["low"] = "bg-blue-500",
    };

    private static readonly VulnerabilityCount[] _vulnerabilities =
    [
        new("Critical", 4, "bg-red-500"),
        new("High", 12, "bg-amber-500"),
        new("Medium", 28, "bg-yellow-500"),
    ];

    private static readonly SecurityAlert[] _alerts =
    [
        new("1", "critical", "SQL injection attempt detected on /api/users endpoint", "3 min ago"),
        new("2", "high", "Outdated TLS certificate on staging.acme.com", "18 min ago"),
        new("3", "high", "Brute force login attempt from 203.0.113.42", "42 min ago"),
        new("4", "medium", "CORS misconfiguration on /api/webhooks", "1 hr ago"),
        new("5", "medium", "Dependency vulnerability in lodash@@4.17.20", "2 hr ago"),
    ];
}
