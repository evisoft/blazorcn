@* ============================================================
   Block: dashboard-customer-health
   Title: Dashboard Customer Health
   Description: Animated React customer health score dashboard block for Next.js with expandable account rows showing health scores, NPS ratings, last activity timestamps, risk level indicators, ARR values, and health factor breakdowns using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: KPI metric cards with trend indicators
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-customer-health.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Customer Health</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_accounts.Length accounts monitored
                </p>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_accounts.Count(a => a.Risk == "high") at risk
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_accounts.Count(a => a.Risk == "medium") medium
                </span>
            </div>
        </div>

        <div class="hidden border-b px-4 py-2 sm:grid sm:grid-cols-[1fr_70px_50px_90px_70px_70px]">
            <span class="text-muted-foreground text-xs">Company</span>
            <span class="text-right text-muted-foreground text-xs">Health</span>
            <span class="text-right text-muted-foreground text-xs">NPS</span>
            <span class="text-right text-muted-foreground text-xs">Last Active</span>
            <span class="text-center text-muted-foreground text-xs">Risk</span>
            <span class="text-right text-muted-foreground text-xs">ARR</span>
        </div>

        <div>
            @for (var i = 0; i < _accounts.Length; i++)
            {
                var account = _accounts[i];
                var isExpanded = _expanded == account.Id;
                <div class="@(i < _accounts.Length - 1 ? "border-b" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : account.Id)"
                        class="grid w-full items-center gap-2 px-4 py-3 text-left transition-colors hover:bg-muted/50 sm:grid-cols-[1fr_70px_50px_90px_70px_70px]">
                        <div class="flex items-center gap-2">
                            <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                            <span class="font-medium text-sm">@account.Company</span>
                        </div>
                        <span class="@(Cn.Merge("text-right font-semibold text-sm tabular-nums", ScoreColor(account.HealthScore)))">
                            @account.HealthScore
                        </span>
                        <span class="text-right text-sm tabular-nums">@account.Nps</span>
                        <span class="text-right text-muted-foreground text-xs">
                            @account.LastActivity
                        </span>
                        <span class="flex items-center justify-center gap-1.5">
                            <span class="@(Cn.Merge("size-1.5 rounded-full", _riskDot[account.Risk]))"></span>
                            <span class="text-muted-foreground text-xs capitalize">@account.Risk</span>
                        </span>
                        <span class="text-right font-medium text-sm tabular-nums">@account.Arr</span>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="border-t bg-muted/20 px-4 py-3 pl-10">
                                <span class="mb-2 block font-medium text-muted-foreground text-xs">
                                    Health Factors
                                </span>
                                <div class="grid gap-2 sm:grid-cols-2">
                                    @foreach (var factor in account.Factors)
                                    {
                                        <div class="flex items-center gap-2">
                                            <span class="w-28 shrink-0 text-muted-foreground text-xs">
                                                @factor.Label
                                            </span>
                                            <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                                                <div class="@(Cn.Merge("h-full rounded-full", FactorBarColor(factor.Score)))"
                                                     style="@($"width: {factor.Score}%")">
                                                </div>
                                            </div>
                                            <span class="@(Cn.Merge("w-8 text-right text-xs tabular-nums", ScoreColor(factor.Score)))">
                                                @factor.Score
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "3";

    private record HealthFactor(string Label, int Score);
    private record Account(string Id, string Company, int HealthScore, int Nps, string LastActivity, string Risk, string Arr, HealthFactor[] Factors);

    private static readonly Dictionary<string, string> _riskDot = new()
    {
        ["low"] = "bg-emerald-500",
        ["medium"] = "bg-amber-500",
        ["high"] = "bg-red-500",
    };

    private static string ScoreColor(int score)
    {
        if (score >= 80) return "text-emerald-600 dark:text-emerald-400";
        if (score >= 50) return "text-amber-600 dark:text-amber-400";
        return "text-red-600 dark:text-red-400";
    }

    private static string FactorBarColor(int score)
    {
        if (score >= 80) return "bg-emerald-500";
        if (score >= 50) return "bg-amber-500";
        return "bg-red-500";
    }

    private static readonly Account[] _accounts =
    [
        new("1", "Acme Corporation", 92, 9, "2 hours ago", "low", "$148K", [new("Product Usage", 95), new("Support Health", 88), new("Feature Adoption", 90), new("Engagement", 94)]),
        new("2", "Globex Industries", 78, 7, "1 day ago", "low", "$96K", [new("Product Usage", 82), new("Support Health", 75), new("Feature Adoption", 70), new("Engagement", 84)]),
        new("3", "Initech Solutions", 45, 4, "5 days ago", "high", "$224K", [new("Product Usage", 38), new("Support Health", 42), new("Feature Adoption", 55), new("Engagement", 44)]),
        new("4", "Stark Dynamics", 88, 8, "4 hours ago", "low", "$312K", [new("Product Usage", 91), new("Support Health", 85), new("Feature Adoption", 88), new("Engagement", 89)]),
        new("5", "Umbrella Health", 61, 5, "3 days ago", "medium", "$67K", [new("Product Usage", 58), new("Support Health", 65), new("Feature Adoption", 52), new("Engagement", 68)]),
        new("6", "Wayne Enterprises", 95, 10, "1 hour ago", "low", "$480K", [new("Product Usage", 98), new("Support Health", 92), new("Feature Adoption", 94), new("Engagement", 96)]),
        new("7", "Cyberdyne Systems", 34, 3, "12 days ago", "high", "$189K", [new("Product Usage", 22), new("Support Health", 30), new("Feature Adoption", 45), new("Engagement", 38)]),
        new("8", "Pied Piper Inc", 72, 7, "6 hours ago", "medium", "$54K", [new("Product Usage", 78), new("Support Health", 68), new("Feature Adoption", 65), new("Engagement", 76)]),
    ];
}
