@* ============================================================
   Block: dashboard-cors-policies
   Title: Dashboard Cors Policies
   Description: Animated React CORS policy management dashboard block for Next.js with per-origin allowed methods, headers, credential flags, and max-age settings in expandable rows using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: DNS record management with type and TTL columns
   Dependencies: BadgeCn
   Source: original/blocks/dashboard/dashboard-cors-policies.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideShieldCheckCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">CORS Policies</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_activeOrigins active
            </BadgeCn>
        </div>

        @* Summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div>
                <p class="text-muted-foreground text-xs">Origins</p>
                <p class="font-semibold text-2xl tabular-nums">@_origins.Length</p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">Active</p>
                <p class="font-semibold text-sm tabular-nums text-emerald-600 dark:text-emerald-400">
                    @_activeOrigins
                </p>
            </div>
            <div class="h-8 w-px bg-border"></div>
            <div>
                <p class="text-muted-foreground text-xs">With Credentials</p>
                <p class="font-semibold text-sm tabular-nums">@_withCredentials</p>
            </div>
        </div>

        @* Origins list *@
        <div>
            @for (var i = 0; i < _origins.Length; i++)
            {
                var origin = _origins[i];
                var isExpanded = _expanded == origin.Id;
                var isLast = i == _origins.Length - 1;

                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : origin.Id)"
                        class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", origin.Status == "active" ? "bg-emerald-500" : "bg-zinc-400"))"></span>
                        <LucideGlobeCn Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                        <span class="min-w-0 flex-1 truncate font-mono text-xs">@origin.Origin</span>
                        <span class="shrink-0 text-muted-foreground text-xs">
                            @origin.Methods.Length methods
                        </span>
                        @if (origin.Credentials)
                        {
                            <span class="size-1.5 shrink-0 rounded-full bg-blue-500"></span>
                        }
                        <span class="w-12 shrink-0 text-right text-muted-foreground text-xs tabular-nums">
                            @FormatMaxAge(origin.MaxAge)
                        </span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-3 px-4 pb-4 pt-1">
                                <div>
                                    <p class="mb-1.5 text-muted-foreground text-xs">Allowed Methods</p>
                                    <div class="flex flex-wrap gap-1.5">
                                        @foreach (var method in origin.Methods)
                                        {
                                            <span class="rounded bg-muted/50 px-1.5 py-0.5 font-mono text-[10px] font-medium text-muted-foreground">
                                                @method
                                            </span>
                                        }
                                    </div>
                                </div>
                                <div>
                                    <p class="mb-1.5 text-muted-foreground text-xs">Allowed Headers</p>
                                    <div class="flex flex-wrap gap-1.5">
                                        @foreach (var header in origin.Headers)
                                        {
                                            <span class="rounded bg-muted/50 px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">
                                                @header
                                            </span>
                                        }
                                    </div>
                                </div>
                                <div class="flex items-center gap-4 text-xs">
                                    <span class="flex items-center gap-1.5">
                                        <span class="@(Cn.Merge("size-1.5 rounded-full", origin.Credentials ? "bg-blue-500" : "bg-zinc-400"))"></span>
                                        <span class="text-muted-foreground">
                                            Credentials @(origin.Credentials ? "enabled" : "disabled")
                                        </span>
                                    </span>
                                    <span class="text-muted-foreground">·</span>
                                    <span class="text-muted-foreground">
                                        Preflight cache: @FormatMaxAge(origin.MaxAge)
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "1";

    private record CorsOrigin(string Id, string Origin, string[] Methods, string[] Headers, bool Credentials, int MaxAge, string Status);

    private static string FormatMaxAge(int seconds)
    {
        if (seconds == 0) return "No cache";
        if (seconds >= 86400) return $"{seconds / 86400}d";
        if (seconds >= 3600) return $"{seconds / 3600}h";
        return $"{seconds / 60}m";
    }

    private static readonly int _activeOrigins = 5;
    private static readonly int _withCredentials = 4;

    private static readonly CorsOrigin[] _origins =
    [
        new("1", "https://app.acmecorp.com", ["GET", "POST", "PUT", "DELETE"], ["Authorization", "Content-Type", "X-Request-ID"], true, 86400, "active"),
        new("2", "https://dashboard.acmecorp.com", ["GET", "POST"], ["Authorization", "Content-Type"], true, 3600, "active"),
        new("3", "https://partner-api.example.io", ["GET"], ["X-API-Key"], false, 600, "active"),
        new("4", "https://staging.acmecorp.com", ["GET", "POST", "PUT", "DELETE", "PATCH"], ["Authorization", "Content-Type", "X-Request-ID", "X-Debug"], true, 0, "active"),
        new("5", "https://legacy.acmecorp.com", ["GET", "POST"], ["Authorization"], false, 86400, "inactive"),
        new("6", "https://mobile-bff.acmecorp.com", ["GET", "POST", "PUT"], ["Authorization", "Content-Type", "X-Device-ID"], true, 7200, "active"),
    ];
}
