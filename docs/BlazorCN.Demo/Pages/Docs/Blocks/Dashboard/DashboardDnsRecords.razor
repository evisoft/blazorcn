@* ============================================================
   Block: dashboard-dns-records
   Title: Dashboard Dns Records
   Description: Animated React DNS record management dashboard block for Next.js with eight DNS entries displaying type chips for A AAAA CNAME MX TXT records, monospaced hostnames, truncated record values with expandable full view, TTL values, active propagating and error status dots, and staggered row entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: SSL certificate tracking with expiry alerts
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-dns-records.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">DNS Records</span>
                <p class="mt-0.5 text-muted-foreground text-xs">Domain name system configuration</p>
            </div>
            <span class="text-muted-foreground text-xs">@_records.Length records</span>
        </div>

        @* Column headers *@
        <div class="flex items-center gap-3 border-b bg-muted/30 px-4 py-2 text-muted-foreground text-xs">
            <span class="w-14 shrink-0">Type</span>
            <span class="w-36 shrink-0">Name</span>
            <span class="min-w-0 flex-1">Value</span>
            <span class="w-16 shrink-0 text-right">TTL</span>
            <span class="w-24 shrink-0 text-center">Status</span>
            <span class="w-6 shrink-0"></span>
        </div>

        @* Records *@
        <div>
            @for (var i = 0; i < _records.Length; i++)
            {
                var record = _records[i];
                var isExpanded = _expanded == record.Id;
                var isLast = i == _records.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : record.Id)"
                        class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("w-14 shrink-0 rounded px-1.5 py-0.5 text-center font-mono text-xs font-medium", _typeColor[record.Type]))">
                            @record.Type
                        </span>
                        <span class="w-36 shrink-0 truncate font-mono text-xs">@record.Name</span>
                        <span class="min-w-0 flex-1 truncate font-mono text-muted-foreground text-xs">
                            @record.Value
                        </span>
                        <span class="w-16 shrink-0 text-right font-mono text-muted-foreground text-xs">
                            @record.Ttl
                        </span>
                        <div class="flex w-24 shrink-0 items-center justify-center gap-1.5">
                            <span class="@(Cn.Merge("size-1.5 rounded-full", _statusDot[record.Status]))"></span>
                            <span class="text-muted-foreground text-xs">
                                @_statusLabel[record.Status]
                            </span>
                        </div>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-[4.75rem]">
                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                                    Full value
                                </span>
                                <p class="break-all font-mono text-sm leading-relaxed">@record.Value</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record DnsRecord(string Id, string Type, string Name, string Value, string Ttl, string Status);

    private static readonly Dictionary<string, string> _typeColor = new()
    {
        ["A"] = "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        ["AAAA"] = "bg-purple-500/10 text-purple-600 dark:text-purple-400",
        ["CNAME"] = "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        ["MX"] = "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        ["TXT"] = "bg-zinc-500/10 text-muted-foreground",
    };

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["active"] = "bg-emerald-500",
        ["propagating"] = "bg-amber-500",
        ["error"] = "bg-red-500",
    };

    private static readonly Dictionary<string, string> _statusLabel = new()
    {
        ["active"] = "Active",
        ["propagating"] = "Propagating",
        ["error"] = "Error",
    };

    private static readonly DnsRecord[] _records =
    [
        new("1", "A", "acme.com", "76.76.21.21", "300s", "active"),
        new("2", "A", "api.acme.com", "76.76.21.22", "300s", "active"),
        new("3", "AAAA", "acme.com", "2606:4700:3030::6815:1521", "300s", "active"),
        new("4", "CNAME", "www.acme.com", "cname.vercel-dns.com", "3600s", "active"),
        new("5", "CNAME", "docs.acme.com", "hosting.gitbook.io", "3600s", "propagating"),
        new("6", "MX", "acme.com", "10 mx1.emailprovider.com, 20 mx2.emailprovider.com", "14400s", "active"),
        new("7", "TXT", "acme.com", "v=spf1 include:_spf.google.com include:sendgrid.net ~all", "3600s", "active"),
        new("8", "TXT", "_dmarc.acme.com", "v=DMARC1; p=quarantine; rua=mailto:dmarc@@acme.com; pct=100", "3600s", "error"),
    ];
}
