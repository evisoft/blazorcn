@* ============================================================
   Block: dashboard-notifications-panel
   Title: Dashboard Notifications Panel
   Description: Animated React dashboard notifications panel block for Next.js with notification types, read and unread states, mark all read, and hover interactions using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Timeline of user actions and events
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-notifications-panel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <h2 class="font-medium text-sm">Notifications</h2>
                @{
                    var unreadCount = _notifications.Count(n => !n.Read);
                }
                @if (unreadCount > 0)
                {
                    <span class="rounded bg-muted px-1.5 py-0.5 text-muted-foreground text-xs">
                        @unreadCount unread
                    </span>
                }
            </div>
            @if (unreadCount > 0)
            {
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="MarkAllRead">
                    Mark all read
                </ButtonCn>
            }
        </div>
        <div>
            @for (var i = 0; i < _notifications.Length; i++)
            {
                var notification = _notifications[i];
                var isLast = i == _notifications.Length - 1;
                <div class="@(Cn.Merge("flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b"))">
                    @switch (notification.Type)
                    {
                        case "info":
                            <LucideInfoCn Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                            break;
                        case "warning":
                            <LucideAlertTriangleCn Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                            break;
                        case "success":
                            <LucideCheckCircleCn Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                            break;
                        case "alert":
                            <LucideBellCn Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                            break;
                    }
                    <div class="min-w-0 flex-1">
                        <p class="font-medium text-sm">@notification.Title</p>
                        <p class="mt-0.5 line-clamp-1 text-muted-foreground text-xs">
                            @notification.Message
                        </p>
                    </div>
                    <div class="flex shrink-0 items-center gap-2 pt-0.5">
                        <span class="text-muted-foreground text-xs">@notification.Time</span>
                        @if (!notification.Read)
                        {
                            <span class="@(Cn.Merge("size-1.5 rounded-full", _typeDots[notification.Type]))"></span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record NotificationItem(string Id, string Type, string Title, string Message, string Time, bool Read);

    private NotificationItem[] _notifications = _initialNotifications.ToArray();

    private void MarkAllRead()
    {
        _notifications = _notifications.Select(n => n with { Read = true }).ToArray();
    }

    private static readonly Dictionary<string, string> _typeDots = new()
    {
        ["info"] = "bg-blue-500",
        ["warning"] = "bg-amber-500",
        ["success"] = "bg-emerald-500",
        ["alert"] = "bg-red-500",
    };

    private static readonly NotificationItem[] _initialNotifications =
    [
        new("1", "success", "Deployment successful", "Production v2.4.1 deployed to all regions without errors", "2 min ago", false),
        new("2", "warning", "High memory usage", "Server us-east-1 memory usage exceeded 85% threshold", "12 min ago", false),
        new("3", "info", "New team member", "Laura Jensen accepted the invitation and joined the workspace", "34 min ago", false),
        new("4", "alert", "Payment failed", "Invoice #4829 payment retry failed for Acme Corp subscription", "1 hr ago", false),
        new("5", "info", "Weekly report ready", "Your analytics report for March 8-14 is available to download", "2 hr ago", true),
        new("6", "success", "Backup completed", "Database backup finished successfully, 2.4 GB archived", "3 hr ago", true),
        new("7", "warning", "SSL certificate expiring", "Certificate for api.acme.com expires in 14 days", "5 hr ago", true),
        new("8", "info", "Feature flag updated", "Dark mode flag enabled for 25% of users in the beta group", "6 hr ago", true),
    ];
}
