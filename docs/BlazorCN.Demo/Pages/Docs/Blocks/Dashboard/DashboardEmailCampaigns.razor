@* ============================================================
   Block: dashboard-email-campaigns
   Title: Dashboard Email Campaigns
   Description: Animated React email campaign dashboard block for Next.js with six campaigns showing sent counts, open rates with horizontal bars, click rates, unsubscribe rates, and status chips with staggered entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Five-step visitor-to-retained funnel analytics
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-email-campaigns.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Email Campaigns</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Campaign performance and engagement metrics
            </p>
        </div>

        <div class="hidden border-b px-4 py-2 sm:flex">
            <span class="min-w-0 flex-1 text-muted-foreground text-xs">Campaign</span>
            <span class="w-16 shrink-0 text-right text-muted-foreground text-xs">Sent</span>
            <span class="w-32 shrink-0 text-right text-muted-foreground text-xs">Open Rate</span>
            <span class="w-16 shrink-0 text-right text-muted-foreground text-xs">Clicks</span>
            <span class="w-16 shrink-0 text-right text-muted-foreground text-xs">Unsub</span>
            <span class="w-20 shrink-0 text-right text-muted-foreground text-xs">Status</span>
        </div>

        <div>
            @for (var i = 0; i < _campaigns.Length; i++)
            {
                var campaign = _campaigns[i];
                var isLast = i == _campaigns.Length - 1;
                <div class="@(Cn.Merge("flex flex-col gap-2 px-4 py-3 sm:flex-row sm:items-center sm:gap-0", isLast ? "" : "border-b"))">
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@campaign.Name</span>
                    </div>
                    <span class="w-16 shrink-0 text-right font-mono text-muted-foreground text-xs tabular-nums">
                        @campaign.Sent
                    </span>
                    <div class="flex w-32 shrink-0 items-center gap-2 sm:justify-end">
                        <div class="h-1.5 w-16 rounded-full bg-muted/50">
                            <div class="h-full rounded-full bg-foreground/20"
                                 style="@(FormattableString.Invariant($"width: {campaign.OpenRate}%"))">
                            </div>
                        </div>
                        <span class="w-10 text-right text-sm tabular-nums">@(campaign.OpenRate)%</span>
                    </div>
                    <span class="w-16 shrink-0 text-right text-muted-foreground text-xs tabular-nums">
                        @(campaign.ClickRate)%
                    </span>
                    <span class="w-16 shrink-0 text-right text-muted-foreground text-xs tabular-nums">
                        @(campaign.UnsubRate)%
                    </span>
                    <div class="flex w-20 shrink-0 justify-end">
                        <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                            @_statusLabel[campaign.Status]
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Campaign(string Name, string Sent, double OpenRate, double ClickRate, double UnsubRate, string Status);

    private static readonly Dictionary<string, string> _statusLabel = new()
    {
        ["active"] = "Active",
        ["completed"] = "Completed",
        ["draft"] = "Draft",
    };

    private static readonly Campaign[] _campaigns =
    [
        new("March Product Launch", "45,200", 42.3, 8.7, 0.12, "completed"),
        new("Weekly Newsletter #127", "38,900", 35.1, 5.4, 0.08, "completed"),
        new("Spring Sale Announcement", "52,100", 48.6, 12.3, 0.15, "active"),
        new("Feature Update: API v3", "28,400", 31.2, 6.8, 0.05, "completed"),
        new("Re-engagement Campaign", "12,800", 22.7, 3.2, 0.34, "active"),
        new("Q2 Roadmap Preview", "0", 0, 0, 0, "draft"),
    ];
}
