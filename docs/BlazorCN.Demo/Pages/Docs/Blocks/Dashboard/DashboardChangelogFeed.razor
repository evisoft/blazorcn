@* ============================================================
   Block: dashboard-changelog-feed
   Title: Dashboard Changelog Feed
   Description: Animated React in-app changelog feed dashboard block for Next.js with six version entries showing version chips, type indicators for features, fixes, and improvements, date labels, truncated descriptions, and new entry dot indicators using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: KPI metrics with trend indicators
   Dependencies: ButtonCn, LucideExternalLinkCn
   Source: original/blocks/dashboard/dashboard-changelog-feed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Changelog</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">Recent updates and releases</p>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                <LucideExternalLinkCn Class="size-3" />
                View all
            </ButtonCn>
        </div>

        @* Entries *@
        <div>
            @for (var i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                var isLast = i == _entries.Length - 1;
                <div class="@(Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : ""))">
                    <div class="flex items-center gap-2">
                        <span class="rounded bg-muted/50 px-1.5 py-0.5 font-mono text-muted-foreground text-xs">
                            v@(entry.Version)
                        </span>
                        <span class="@(Cn.Merge("rounded px-1.5 py-0.5 text-xs", GetTypeStyle(entry.Type)))">
                            @(GetTypeLabel(entry.Type))
                        </span>
                        <span class="ml-auto text-muted-foreground text-xs">@entry.Date</span>
                        @if (entry.IsNew)
                        {
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        }
                    </div>
                    <h3 class="mt-2 font-medium text-sm">@entry.Title</h3>
                    <p class="mt-1 line-clamp-2 text-muted-foreground text-xs leading-relaxed">
                        @entry.Description
                    </p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ChangelogEntry(string Version, string Title, string Description, string Type, string Date, bool IsNew);

    private static string GetTypeStyle(string type) => type switch
    {
        "feature" => "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        "fix" => "bg-red-500/10 text-red-600 dark:text-red-400",
        "improvement" => "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        _ => ""
    };

    private static string GetTypeLabel(string type) => type switch
    {
        "feature" => "Feature",
        "fix" => "Fix",
        "improvement" => "Improvement",
        _ => ""
    };

    private static readonly ChangelogEntry[] _entries =
    [
        new("2.4.0", "AI-powered code suggestions", "Inline code suggestions powered by our new AI engine. Get context-aware completions as you type with support for 12 programming languages.", "feature", "Mar 15", true),
        new("2.3.2", "Fixed dashboard loading performance", "Resolved an issue where the main dashboard took 4+ seconds to load for accounts with more than 500 projects. Queries are now batched and cached.", "fix", "Mar 12", true),
        new("2.3.1", "Improved search relevance", "Search results now use a weighted scoring algorithm that prioritizes exact matches and recently modified items. Typo tolerance has been improved.", "improvement", "Mar 8", false),
        new("2.3.0", "Team workspace permissions", "Granular role-based access control for team workspaces. Assign viewer, editor, or admin roles to individual members or groups.", "feature", "Mar 3", false),
        new("2.2.4", "Fixed webhook retry logic", "Webhook deliveries now use exponential backoff with jitter instead of fixed intervals. Failed deliveries are retried up to 5 times over 24 hours.", "fix", "Feb 26", false),
        new("2.2.3", "Faster CSV exports", "CSV export for large datasets now streams data instead of buffering in memory. Exports of 100K+ rows complete in under 10 seconds.", "improvement", "Feb 21", false),
    ];
}
