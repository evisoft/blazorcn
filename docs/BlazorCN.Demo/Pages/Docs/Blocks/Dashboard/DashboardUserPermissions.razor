@* ============================================================
   Block: dashboard-user-permissions
   Title: Dashboard User Permissions
   Description: Animated React user permissions dashboard block for Next.js with role summary cards showing user counts, expandable permission matrices with check and cross indicators per role, total user count, and staggered entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Activity audit log with user tracking
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-user-permissions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">User Permissions</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Role-based access control overview
                </p>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="font-semibold text-sm tabular-nums">@_totalUsers</span>
                <span class="text-muted-foreground text-xs">total users</span>
            </div>
        </div>

        @* Role summary row *@
        <div class="flex items-center divide-x border-b">
            @foreach (var role in _roles)
            {
                <div class="flex flex-1 flex-col items-center px-4 py-3">
                    <span class="font-medium text-sm">@role.Name</span>
                    <span class="font-semibold text-lg tabular-nums">@role.Count</span>
                    <span class="text-muted-foreground text-[10px]">users</span>
                </div>
            }
        </div>

        @* Expandable roles *@
        <div>
            @for (var i = 0; i < _roles.Length; i++)
            {
                var role = _roles[i];
                var isExpanded = _expanded == role.Name;
                var isLast = i == _roles.Length - 1;
                var permCount = role.Permissions.Length;

                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : role.Name)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="font-medium text-sm">@role.Name</span>
                        <span class="text-muted-foreground text-xs">&middot;</span>
                        <span class="min-w-0 flex-1 truncate text-muted-foreground text-xs">
                            @role.Description
                        </span>
                        <span class="shrink-0 font-medium text-muted-foreground text-xs tabular-nums">
                            @permCount/@_allPermissions.Length
                        </span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-3">
                                <div class="overflow-hidden rounded-md border">
                                    @for (var pi = 0; pi < _allPermissions.Length; pi++)
                                    {
                                        var perm = _allPermissions[pi];
                                        var granted = role.Permissions.Contains(perm.Key);
                                        var isLastPerm = pi == _allPermissions.Length - 1;
                                        <div class="@(Cn.Merge("flex items-center gap-3 px-3 py-2", !isLastPerm ? "border-b" : ""))">
                                            <span class="inline-flex shrink-0 items-center rounded bg-muted/50 px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">
                                                @perm.Category
                                            </span>
                                            <span class="min-w-0 flex-1 text-sm">@perm.Label</span>
                                            @if (granted)
                                            {
                                                <LucideCheckCn Size="16" Class="size-4 shrink-0 text-emerald-500" />
                                            }
                                            else
                                            {
                                                <LucideXCn Size="16" Class="size-4 shrink-0 text-muted-foreground/30" />
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record PermissionDef(string Key, string Label, string Category);
    private record RoleData(string Name, int Count, string Description, string[] Permissions);

    private int _totalUsers => _roles.Sum(r => r.Count);

    private readonly PermissionDef[] _allPermissions = new[]
    {
        new PermissionDef("user_read", "View users", "Users"),
        new PermissionDef("user_write", "Create & edit users", "Users"),
        new PermissionDef("user_delete", "Delete users", "Users"),
        new PermissionDef("billing_read", "View billing", "Billing"),
        new PermissionDef("billing_write", "Manage billing", "Billing"),
        new PermissionDef("api_read", "View API keys", "API"),
        new PermissionDef("api_write", "Create API keys", "API"),
        new PermissionDef("api_delete", "Revoke API keys", "API"),
        new PermissionDef("audit_read", "View audit logs", "Audit"),
        new PermissionDef("settings_write", "Manage settings", "Settings")
    };

    private readonly RoleData[] _roles = new[]
    {
        new RoleData("Admin", 3, "Full access to all resources and settings", new[] { "user_read", "user_write", "user_delete", "billing_read", "billing_write", "api_read", "api_write", "api_delete", "audit_read", "settings_write" }),
        new RoleData("Editor", 12, "Can manage content and users but not billing", new[] { "user_read", "user_write", "api_read", "api_write", "audit_read" }),
        new RoleData("Viewer", 48, "Read-only access to resources and dashboards", new[] { "user_read", "billing_read", "api_read", "audit_read" }),
        new RoleData("Billing", 2, "Billing and subscription management only", new[] { "billing_read", "billing_write", "audit_read" }),
        new RoleData("Custom", 5, "Custom permission set tailored per user", new[] { "user_read", "api_read", "api_write" })
    };
}
