@* ============================================================
   Block: dashboard-shipping-tracker
   Title: Dashboard Shipping Tracker
   Description: Animated React shipping tracker dashboard block for Next.js with eight orders showing order IDs, destinations, carrier chips, delivery status indicators with animated dots, expandable tracking events, and ETA strings using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Sales pipeline with deal tracking
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-shipping-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Shipping Tracker</span>
                <p class="mt-0.5 text-muted-foreground text-xs">@_orders.Length shipments</p>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    @_inTransitCount in transit
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_deliveredCount delivered
                </span>
            </div>
        </div>

        @* Column Headers *@
        <div class="hidden items-center gap-4 border-b bg-muted/30 px-4 py-2 md:flex">
            <span class="w-20 text-muted-foreground text-xs">Order</span>
            <span class="min-w-0 flex-1 text-muted-foreground text-xs">Destination</span>
            <span class="w-14 text-muted-foreground text-xs">Carrier</span>
            <span class="w-20 text-muted-foreground text-xs">Status</span>
            <span class="w-16 text-right text-muted-foreground text-xs">ETA</span>
            <span class="w-4"></span>
        </div>

        @* Orders *@
        <div>
            @for (var i = 0; i < _orders.Length; i++)
            {
                var order = _orders[i];
                var isExpanded = _expanded == order.Id;
                var isLast = i == _orders.Length - 1;

                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : order.Id)"
                        class="flex w-full items-center gap-4 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="w-20 shrink-0 font-mono text-xs text-muted-foreground">
                            @order.OrderId
                        </span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@order.Destination</span>
                            <div class="mt-0.5 flex items-center gap-2 md:hidden">
                                <span class="@(Cn.Merge("rounded-full px-1.5 py-0.5 text-xs", _carrierStyle[order.Carrier]))">
                                    @order.Carrier
                                </span>
                                <span class="flex items-center gap-1">
                                    <span class="@(Cn.Merge("size-1.5 rounded-full", _statusDot[order.Status], order.Status == "In Transit" ? "animate-pulse" : ""))"></span>
                                    <span class="@(Cn.Merge("text-xs", _statusStyle[order.Status]))">
                                        @order.Status
                                    </span>
                                </span>
                            </div>
                        </div>
                        <span class="@(Cn.Merge("hidden w-14 rounded-full px-1.5 py-0.5 text-center text-xs md:inline-block", _carrierStyle[order.Carrier]))">
                            @order.Carrier
                        </span>
                        <span class="hidden w-20 items-center gap-1.5 md:flex">
                            <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", _statusDot[order.Status], order.Status == "In Transit" ? "animate-pulse" : ""))"></span>
                            <span class="@(Cn.Merge("text-xs", _statusStyle[order.Status]))">@order.Status</span>
                        </span>
                        <span class="w-16 text-right text-muted-foreground text-xs">@order.Eta</span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4">
                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="font-medium text-muted-foreground text-xs">
                                    Tracking Events
                                </span>
                                <div class="mt-2 space-y-2">
                                    @for (var ei = 0; ei < order.Events.Length; ei++)
                                    {
                                        var evt = order.Events[ei];
                                        var isFirstEvent = ei == 0;
                                        var isLastEvent = ei == order.Events.Length - 1;
                                        <div class="flex items-start gap-3">
                                            <div class="flex flex-col items-center">
                                                <span class="@(Cn.Merge("size-1.5 rounded-full", isFirstEvent ? _statusDot[order.Status] : "bg-muted-foreground/30"))"></span>
                                                @if (!isLastEvent)
                                                {
                                                    <span class="mt-1 h-4 w-px bg-muted-foreground/20"></span>
                                                }
                                            </div>
                                            <div class="min-w-0 flex-1">
                                                <p class="text-sm">@evt.Description</p>
                                                <p class="mt-0.5 text-muted-foreground text-xs">
                                                    @evt.Location &middot; @evt.Time
                                                </p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record TrackingEvent(string Time, string Location, string Description);
    private record OrderData(string Id, string OrderId, string Destination, string Carrier, string Status, string Eta, TrackingEvent[] Events);

    private int _inTransitCount => _orders.Count(o => o.Status == "In Transit");
    private int _deliveredCount => _orders.Count(o => o.Status == "Delivered");

    private readonly Dictionary<string, string> _statusDot = new()
    {
        ["In Transit"] = "bg-blue-500",
