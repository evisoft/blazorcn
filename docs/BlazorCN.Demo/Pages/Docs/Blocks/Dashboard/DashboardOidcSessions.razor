@* ============================================================
   Block: dashboard-oidc-sessions
   Title: Dashboard Oidc Sessions
   Description: Animated React OIDC and OAuth active session management dashboard block for Next.js with eight sessions displaying provider logos, user emails, granted scopes, token expiry countdowns, device and IP metadata, and staggered row entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: User session duration and engagement metrics
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-oidc-sessions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideFingerprintCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">OIDC Sessions</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Active identity provider sessions
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_sessions.Count(s => s.Status == "active")
                </span>
                @{
                    var expiringCount = _sessions.Count(s => s.Status == "expiring");
                    var expiredCount = _sessions.Count(s => s.Status == "expired");
                }
                @if (expiringCount > 0)
                {
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        @expiringCount
                    </span>
                }
                @if (expiredCount > 0)
                {
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        @expiredCount
                    </span>
                }
            </div>
        </div>

        @* Sessions *@
        <div>
            @for (var i = 0; i < _sessions.Length; i++)
            {
                var session = _sessions[i];
                var isExpanded = _expanded == session.Id;
                var isLast = i == _sessions.Length - 1;
                var style = _statusStyle[session.Status];
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : session.Id)"
                        class="w-full px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex items-center gap-3">
                            <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", style.Dot))"></span>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-sm">@session.Email</span>
                                    <span class="rounded bg-muted/80 px-1.5 py-0.5 text-muted-foreground text-xs">
                                        @_providerLabel[session.Provider]
                                    </span>
                                </div>
                                <div class="mt-1 flex flex-wrap gap-1">
                                    @foreach (var scope in session.Scopes)
                                    {
                                        <span class="rounded bg-muted/50 px-1.5 py-0.5 font-mono text-muted-foreground text-xs">
                                            @scope
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="shrink-0 text-right">
                                <span class="@(Cn.Merge("font-medium text-xs tabular-nums", style.Text))">
                                    @session.ExpiresIn
                                </span>
                                <p class="mt-0.5 text-muted-foreground text-xs">@session.Device</p>
                            </div>
                            <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-9">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="grid grid-cols-2 gap-x-4 gap-y-2 text-xs">
                                    <div>
                                        <span class="text-muted-foreground">IP address</span>
                                        <p class="mt-0.5 font-mono font-medium">@session.Ip</p>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground">Created</span>
                                        <p class="mt-0.5 font-medium">@session.CreatedAt</p>
                                    </div>
                                    <div class="col-span-2">
                                        <span class="text-muted-foreground">User agent</span>
                                        <p class="mt-0.5 truncate font-mono text-xs">
                                            @session.UserAgent
                                        </p>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground">Last activity</span>
                                        <p class="mt-0.5 font-medium">@session.LastActivity</p>
                                    </div>
                                </div>
                                @if (session.Status != "expired")
                                {
                                    <div class="mt-3 flex justify-end">
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs text-red-600 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300">
                                            <LucideXCn Size="12" Class="size-3" />
                                            Revoke
                                        </ButtonCn>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
