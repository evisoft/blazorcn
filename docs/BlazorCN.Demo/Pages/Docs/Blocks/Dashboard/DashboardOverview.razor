@* ============================================================
   Block: dashboard-overview
   Title: Dashboard Overview
   Description: Animated React dashboard overview block for Next.js with four KPI metric cards showing revenue, users, conversion rate, and MRR with trend indicators, percentage changes, and staggered entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Monthly revenue bar chart with animated bars
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-overview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Overview</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Key performance indicators for this period
            </p>
        </div>
        <div class="grid grid-cols-2">
            @for (var i = 0; i < _metrics.Length; i++)
            {
                var metric = _metrics[i];
                <div class="@(Cn.Merge("px-4 py-4", i < 2 ? "border-b" : "", i % 2 == 0 ? "border-r" : ""))">
                    <p class="text-muted-foreground text-xs">@metric.Label</p>
                    <div class="mt-1 flex items-baseline gap-2">
                        <span class="font-semibold text-2xl tabular-nums">@metric.Value</span>
                        <span class="@(Cn.Merge("flex items-center gap-0.5 text-xs", metric.Trend == "up" ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400"))">
                            @if (metric.Trend == "up")
                            {
                                <LucideTrendingUpCn Size="12" Class="size-3" />
                            }
                            else
                            {
                                <LucideTrendingDownCn Size="12" Class="size-3" />
                            }
                            @metric.Change
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Metric(string Label, string Value, string Change, string Trend);

    private static readonly Metric[] _metrics =
    [
        new("Revenue", "$48.2K", "+12.5%", "up"),
        new("Users", "2,847", "+8.2%", "up"),
        new("Conversion", "3.6%", "-0.4%", "down"),
        new("MRR", "$12.4K", "+18.3%", "up"),
    ];
}
