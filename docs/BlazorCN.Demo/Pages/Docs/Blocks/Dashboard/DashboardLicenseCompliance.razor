@* ============================================================
   Block: dashboard-license-compliance
   Title: Dashboard License Compliance
   Description: Animated React software license compliance dashboard for Next.js with dependency scan results, license risk levels, expandable package details, and violation alerts using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Code quality metrics with coverage and tech debt
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/dashboard/dashboard-license-compliance.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideShieldCheckCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">License Compliance</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Rescan
            </ButtonCn>
        </div>

        @* Score summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="@(Cn.Merge("font-semibold text-2xl tabular-nums", _scoreColor))">
                    @_complianceScore
                </span>
                <span class="text-muted-foreground text-xs">/100</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_dependencies.Length packages
            </BadgeCn>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">Scanned @_lastScan</span>
            <div class="ml-auto flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_dependencies.Count(d => d.Risk == "high")
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_dependencies.Count(d => d.Risk == "medium")
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_dependencies.Count(d => d.Risk == "low")
                </span>
            </div>
        </div>

        @* Dependency list *@
        <div>
            @for (var i = 0; i < _dependencies.Length; i++)
            {
                var dep = _dependencies[i];
                var isExpanded = _expanded == dep.Id;
                var isLast = i == _dependencies.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : dep.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", _riskDot[dep.Risk]))"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@dep.Name</span>
                                @if (dep.Direct)
                                {
                                    <span class="rounded bg-muted px-1 py-0.5 text-[10px] text-muted-foreground">
                                        direct
                                    </span>
                                }
                            </div>
                            <p class="mt-0.5 font-mono text-muted-foreground text-xs">
                                @dep.License · v@(dep.Version)
                            </p>
                        </div>
                        <span class="shrink-0 text-muted-foreground text-xs">
                            @_riskLabel[dep.Risk]
                        </span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="mb-1.5 flex items-center gap-1.5">
                                    <LucideFileWarningCn Size="12" Class="size-3 text-muted-foreground" />
                                    <span class="font-medium text-muted-foreground text-xs">
                                        Risk assessment
                                    </span>
                                </div>
                                <p class="text-sm leading-relaxed">@dep.Reason</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "d1";
    private const int _complianceScore = 87;
    private const string _lastScan = "14 min ago";

    private record Dependency(string Id, string Name, string Version, string License, string Risk, string Reason, bool Direct);

    private static readonly string _scoreColor = _complianceScore >= 90
        ? "text-emerald-600 dark:text-emerald-400"
        : _complianceScore >= 70
            ? "text-amber-600 dark:text-amber-400"
            : "text-red-600 dark:text-red-400";

    private static readonly Dictionary<string, string> _riskDot = new()
    {
        ["high"] = "bg-red-500",
        ["medium"] = "bg-amber-500",
        ["low"] = "bg-emerald-500",
    };

    private static readonly Dictionary<string, string> _riskLabel = new()
    {
        ["high"] = "High",
        ["medium"] = "Medium",
        ["low"] = "Low",
    };

    private static readonly Dependency[] _dependencies =
    [
        new("d1", "react-pdf-renderer", "3.4.2", "AGPL-3.0", "high",
            "Strong copyleft requires open-sourcing derivative works. Incompatible with proprietary distribution.", true),
        new("d2", "chart-engine", "2.1.0", "GPL-3.0", "high",
            "Copyleft license mandates that linked software must also be released under GPL. Review usage scope.", false),
        new("d3", "geo-ip-lookup", "1.8.5", "LGPL-2.1", "medium",
            "Weak copyleft allows dynamic linking but modifications to the library itself must be shared.", true),
        new("d4", "xml-transform", "4.0.1", "MPL-2.0", "medium",
            "File-level copyleft. Changes to MPL-licensed files must be shared, but your proprietary code is unaffected.", false),
        new("d5", "fast-csv", "5.2.0", "MIT", "low",
            "Permissive license with no copyleft obligations. Requires only copyright notice retention.", true),
        new("d6", "zod", "3.23.8", "MIT", "low",
            "Permissive license. Free for commercial use with attribution.", true),
        new("d7", "lodash-es", "4.17.21", "MIT", "low",
            "Permissive license. No restrictions on usage or redistribution beyond attribution.", false),
    ];
}
