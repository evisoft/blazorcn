@* ============================================================
   Block: dashboard-patch-status
   Title: Dashboard Patch Status
   Description: Animated React security patch status dashboard block for Next.js with server-level patching overview, CVE severity indicators, pending and applied patch counts, expandable server details with patch history, and staggered entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Threat detection and vulnerability summary
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-patch-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Patch Status</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Security patch compliance across servers
                </p>
            </div>
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-1.5">
                    <LucideShieldCheckCn Size="12" Class="size-3.5 text-muted-foreground" />
                    <span class="font-semibold text-sm tabular-nums">@(_compliancePct)%</span>
                    <span class="text-muted-foreground text-xs">compliant</span>
                </div>
            </div>
        </div>

        @* Summary stats *@
        <div class="flex items-center divide-x border-b">
            <div class="flex flex-1 flex-col items-center px-4 py-3">
                <span class="font-semibold text-lg tabular-nums text-emerald-600 dark:text-emerald-400">
                    @_fullyPatched
                </span>
                <span class="text-muted-foreground text-[10px]">fully patched</span>
            </div>
            <div class="flex flex-1 flex-col items-center px-4 py-3">
                <span class="font-semibold text-lg tabular-nums text-amber-600 dark:text-amber-400">
                    @_servers.Count(s => s.Pending > 0)
                </span>
                <span class="text-muted-foreground text-[10px]">pending patches</span>
            </div>
            <div class="flex flex-1 flex-col items-center px-4 py-3">
                <span class="font-semibold text-lg tabular-nums">@_servers.Length</span>
                <span class="text-muted-foreground text-[10px]">total servers</span>
            </div>
        </div>

        @* Server rows *@
        <div>
            @for (var i = 0; i < _servers.Length; i++)
                        {
                var server = _servers[i];
                var isExpanded = _expanded == server.Id;
                var isLast = i == _servers.Length - 1;
                var hasCritical = server.Patches.Any(p => p.State == "pending" && p.Severity == "critical");

                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = isExpanded ? null : server.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", server.Pending == 0 ? "bg-emerald-500" : hasCritical ? "bg-red-500" : "bg-amber-500"))"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-mono font-medium text-sm">@server.Hostname</span>
                            <p class="mt-0.5 text-muted-foreground text-[10px]">@server.Os</p>
                        </div>
                        <div class="shrink-0 text-right">
                            <span class="block text-xs tabular-nums">
                                <span class="text-emerald-600 dark:text-emerald-400">
                                    @server.Applied
                                </span>
                                @if (server.Pending > 0)
                                            {
                                    <span class="text-muted-foreground">
                                        @(" / ")
                                        <span class="text-amber-600 dark:text-amber-400">
                                            @server.Pending pending
                                        </span>
                                    </span>
                                }
                            </span>
                            <span class="block text-muted-foreground text-[10px]">
                                @server.LastPatched
                            </span>
                        </div>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                                {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-3">
                                <div class="overflow-hidden rounded-md border">
                                    @for (var pi = 0; pi < server.Patches.Length; pi++)
                                                {
                                        var patch = server.Patches[pi];
                                        var patchIsLast = pi == server.Patches.Length - 1;
                                        var sevConfig = _severityConfig[patch.Severity];
                                        var stConfig = _stateLabel[patch.State];

                                        <div class="@(Cn.Merge("flex items-center gap-3 px-3 py-2", !patchIsLast ? "border-b" : ""))">
                                            <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", sevConfig.Dot))"></span>
                                            <span class="shrink-0 font-mono text-[10px] text-muted-foreground">
                                                @patch.Cve
                                            </span>
                                            <span class="min-w-0 flex-1 truncate text-xs">
                                                @patch.Description
                                            </span>
                                            <span class="shrink-0 text-muted-foreground text-[10px]">
                                                @patch.PublishedDate
                                            </span>
                                            <span class="@(Cn.Merge("shrink-0 text-[10px] font-medium", stConfig.Color))">
                                                @stConfig.Text
                                            </span>
                                        </div>
                                    }
                                </div>
                                @if (server.Pending > 0)
                                            {
                                    <div class="mt-2">
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                            Apply Patches
                                        </ButtonCn>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record PatchInfo(string Cve, string Severity, string Description, string State, string PublishedDate);
    private record ServerInfo(string Id, string Hostname, string Os, int Applied, int Pending, string LastPatched, PatchInfo[] Patches);
    private record SeverityInfo(string Dot, string Label);
    private record StateInfo(string Text, string Color);

    private string? _expanded;

    private int _fullyPatched => _servers.Count(s => s.Pending == 0);
    private int _compliancePct => (int)Math.Round((double)_fullyPatched / _servers.Length * 100);

    private readonly Dictionary<string, SeverityInfo> _severityConfig = new()
    {
        ["critical"] = new("bg-red-500", "Critical"),
        ["high"] = new("bg-amber-500", "High"),
        ["medium"] = new("bg-blue-500", "Medium"),
        ["low"] = new("bg-slate-400", "Low")
    };

    private readonly Dictionary<string, StateInfo> _stateLabel = new()
    {
        ["applied"] = new("Applied", "text-emerald-600 dark:text-emerald-400"),
        ["pending"] = new("Pending", "text-amber-600 dark:text-amber-400"),
        ["failed"] = new("Failed", "text-red-600 dark:text-red-400")
    };

    private readonly ServerInfo[] _servers = new[]
    {
        new ServerInfo("srv1", "prod-api-01", "Ubuntu 22.04", 14, 0, "6 hours ago", new[]
        {
            new PatchInfo("CVE-2026-1847", "critical", "OpenSSL buffer overflow in TLS handshake", "applied", "Mar 12"),
            new PatchInfo("CVE-2026-1692", "high", "Linux kernel privilege escalation via io_uring", "applied", "Mar 10")
        }),
        new ServerInfo("srv2", "prod-api-02", "Ubuntu 22.04", 12, 2, "3 days ago", new[]
        {
            new PatchInfo("CVE-2026-1847", "critical", "OpenSSL buffer overflow in TLS handshake", "pending", "Mar 12"),
            new PatchInfo("CVE-2026-1692", "high", "Linux kernel privilege escalation via io_uring", "pending", "Mar 10"),
            new PatchInfo("CVE-2026-1544", "medium", "Nginx HTTP/2 rapid reset mitigation", "applied", "Mar 5")
        }),
        new ServerInfo("srv3", "prod-db-01", "Amazon Linux 2023", 18, 1, "1 day ago", new[]
        {
            new PatchInfo("CVE-2026-1847", "critical", "OpenSSL buffer overflow in TLS handshake", "applied", "Mar 12"),
            new PatchInfo("CVE-2026-1401", "medium", "PostgreSQL COPY FROM command injection", "pending", "Mar 8")
        }),
        new ServerInfo("srv4", "staging-web-01", "Debian 12", 9, 3, "5 days ago", new[]
        {
            new PatchInfo("CVE-2026-1847", "critical", "OpenSSL buffer overflow in TLS handshake", "pending", "Mar 12"),
            new PatchInfo("CVE-2026-1692", "high", "Linux kernel privilege escalation via io_uring", "pending", "Mar 10"),
            new PatchInfo("CVE-2026-1205", "low", "curl verbose output information leak", "pending", "Mar 3")
        }),
        new ServerInfo("srv5", "prod-worker-01", "Ubuntu 22.04", 14, 0, "8 hours ago", new[]
        {
            new PatchInfo("CVE-2026-1847", "critical", "OpenSSL buffer overflow in TLS handshake", "applied", "Mar 12")
        }),
        new ServerInfo("srv6", "prod-cache-01", "Alpine 3.19", 7, 1, "2 days ago", new[]
        {
            new PatchInfo("CVE-2026-1583", "high", "Redis AUTH command timing side-channel", "failed", "Mar 6")
        })
    };
}
