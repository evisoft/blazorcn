@* ============================================================
   Block: dashboard-user-retention
   Title: Dashboard User Retention
   Description: Animated React user retention cohort block for Next.js with six monthly cohorts displaying starting users and week-over-week retention percentages in an opacity-coded grid layout using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Article analytics with engagement metrics
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-user-retention.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">User Retention</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Cohort analysis showing retention at key intervals
            </p>
        </div>

        <div class="overflow-x-auto">
            <div class="min-w-[600px]">
                <div class="grid grid-cols-[120px_80px_repeat(5,1fr)] border-b bg-muted/30 px-4 py-2">
                    <span class="font-medium text-muted-foreground text-xs">Cohort</span>
                    <span class="font-medium text-muted-foreground text-xs">Users</span>
                    @foreach (var period in _periods)
                    {
                        <span class="text-center font-medium text-muted-foreground text-xs">@period</span>
                    }
                </div>

                <div>
                    @for (var ri = 0; ri < _cohorts.Length; ri++)
                    {
                        var cohort = _cohorts[ri];
                        var isLast = ri == _cohorts.Length - 1;
                        <div class="@(Cn.Merge("grid grid-cols-[120px_80px_repeat(5,1fr)] items-center px-4 py-2.5", !isLast ? "border-b" : ""))">
                            <span class="font-medium text-sm">@cohort.Name</span>
                            <span class="font-semibold text-sm tabular-nums">@cohort.Users.ToString("N0")</span>
                            @foreach (var value in cohort.Retention)
                            {
                                <div class="flex justify-center">
                                    @if (value > 0)
                                    {
                                        <span class="@(Cn.Merge("inline-flex min-w-[48px] items-center justify-center rounded-md px-2 py-1 font-semibold text-xs tabular-nums", GetRetentionStyle(value)))">
                                            @value%
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted-foreground/30 text-xs">&mdash;</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record CohortData(string Name, int Users, int[] Retention);

    private readonly string[] _periods = { "Week 1", "Week 2", "Week 4", "Week 8", "Week 12" };

    private static string GetRetentionStyle(int value)
    {
        if (value == 0) return "";
        if (value >= 70) return "bg-emerald-500/25 text-emerald-700 dark:text-emerald-400";
        if (value >= 50) return "bg-emerald-500/15 text-emerald-700 dark:text-emerald-400";
        if (value >= 30) return "bg-amber-500/15 text-amber-700 dark:text-amber-400";
        return "bg-red-500/10 text-red-700 dark:text-red-400";
    }

    private readonly CohortData[] _cohorts = new[]
    {
        new CohortData("Oct 2025", 1240, new[] { 88, 72, 58, 41, 34 }),
        new CohortData("Nov 2025", 1385, new[] { 91, 76, 62, 45, 38 }),
        new CohortData("Dec 2025", 980, new[] { 85, 68, 52, 37, 29 }),
        new CohortData("Jan 2026", 1520, new[] { 93, 79, 65, 48, 0 }),
        new CohortData("Feb 2026", 1680, new[] { 90, 74, 59, 0, 0 }),
        new CohortData("Mar 2026", 1410, new[] { 87, 71, 0, 0, 0 })
    };
}
