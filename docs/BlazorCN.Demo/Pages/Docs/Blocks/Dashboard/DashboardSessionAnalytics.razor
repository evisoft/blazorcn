@* ============================================================
   Block: dashboard-session-analytics
   Title: Dashboard Session Analytics
   Description: Animated React session analytics dashboard block for Next.js with active session counter, average duration, pages per session, device breakdown bars for desktop, mobile, and tablet, and a top five active pages list using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Search behavior tracking and analysis
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-session-analytics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Session Analytics</span>
            <span class="text-muted-foreground text-xs">Real-time</span>
        </div>

        @* Key metrics *@
        <div class="grid grid-cols-2 border-b sm:grid-cols-4">
            @for (var i = 0; i < _keyMetrics.Length; i++)
            {
                var metric = _keyMetrics[i];
                <div class="@(Cn.Merge("px-4 py-3", i < 2 ? "border-b sm:border-b-0" : "", i < 3 ? "border-r" : ""))">
                    <span class="text-muted-foreground text-xs">@metric.Label</span>
                    <p class="font-semibold text-2xl tabular-nums">@metric.Value</p>
                </div>
            }
        </div>

        @* Device breakdown *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Device Breakdown</span>
            <div class="mt-3 space-y-2.5">
                @foreach (var device in _devices)
                {
                    <div class="flex items-center gap-3">
                        @if (device.Icon == "desktop")
                        {
                            <LucideMonitorCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        }
                        else if (device.Icon == "mobile")
                        {
                            <LucideSmartphoneCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        }
                        else
                        {
                            <LucideTabletCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        }
                        <span class="w-16 shrink-0 text-xs">@device.Label</span>
                        <div class="flex-1">
                            <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                                <div class="h-full rounded-full bg-foreground/20"
                                     style="@($"width: {device.Percent}%")"></div>
                            </div>
                        </div>
                        <span class="w-10 shrink-0 text-right font-medium text-xs tabular-nums">
                            @device.Percent%
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Top active pages *@
        <div>
            <div class="px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Top Active Pages</span>
            </div>
            @for (var i = 0; i < _activePages.Length; i++)
            {
                var pg = _activePages[i];
                var isLast = i == _activePages.Length - 1;
                var barWidth = (int)Math.Round((double)pg.Sessions / _maxSessions * 100);
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-2.5", !isLast ? "border-b" : ""))">
                    <span class="min-w-0 flex-1 truncate font-mono text-xs">@pg.Path</span>
                    <div class="hidden w-20 items-center sm:flex">
                        <div class="h-1 rounded-full bg-foreground/15"
                             style="@($"width: {barWidth}%")"></div>
                    </div>
                    <span class="shrink-0 font-medium text-xs tabular-nums">@pg.Sessions</span>
                    <span class="shrink-0 text-muted-foreground text-xs">@pg.AvgDuration</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record KeyMetric(string Label, string Value);
    private record DeviceData(string Label, int Percent, string Icon);
    private record ActivePageData(string Path, int Sessions, string AvgDuration);

    private int _maxSessions => _activePages.Max(p => p.Sessions);

    private readonly KeyMetric[] _keyMetrics = new[]
    {
        new KeyMetric("Active Sessions", "247"),
        new KeyMetric("Avg Duration", "12m 34s"),
        new KeyMetric("Pages / Session", "4.2"),
        new KeyMetric("Top Device", "Desktop")
    };

    private readonly DeviceData[] _devices = new[]
    {
        new DeviceData("Desktop", 68, "desktop"),
        new DeviceData("Mobile", 28, "mobile"),
        new DeviceData("Tablet", 4, "tablet")
    };

    private readonly ActivePageData[] _activePages = new[]
    {
        new ActivePageData("/dashboard", 89, "8m 12s"),
        new ActivePageData("/settings/team", 42, "4m 38s"),
        new ActivePageData("/projects/analytics", 38, "14m 22s"),
        new ActivePageData("/billing", 31, "2m 55s"),
        new ActivePageData("/integrations", 27, "6m 10s")
    };
}
