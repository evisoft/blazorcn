@* ============================================================
   Block: dashboard-snapshot-backups
   Title: Dashboard Snapshot Backups
   Description: Animated React snapshot backup timeline dashboard block for Next.js with backup sizes, retention policies, restore options, automated schedule indicators, and completion status using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Database backup schedule and history
   Dependencies: ButtonCn
   Source: original/blocks/dashboard/dashboard-snapshot-backups.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideHardDriveCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Snapshot Backups</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @_backups.Length snapshots \u00b7 @_totalSize total
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_completedCount available
                </span>
            </div>
        </div>

        @* Backups *@
        <div>
            @for (var i = 0; i < _backups.Length; i++)
            {
                var backup = _backups[i];
                var isExpanded = _expanded == backup.Id;
                var isLast = i == _backups.Length - 1;
                var config = _statusConfig[backup.Status];
                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : backup.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", config.Dot))"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-mono text-sm">@backup.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @_typeLabel[backup.Type]
                                <span class="mx-1.5">\u00b7</span>
                                @backup.CreatedAt
                                <span class="mx-1.5">\u00b7</span>
                                @(backup.RetentionDays)d retention
                            </p>
                        </div>
                        <div class="shrink-0 text-right">
                            <span class="block font-mono text-xs tabular-nums">@backup.Size</span>
                            <span class="block text-muted-foreground text-[10px]">
                                @backup.Duration
                            </span>
                        </div>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="space-y-1.5 text-xs">
                                    <div class="flex items-center justify-between">
                                        <span class="text-muted-foreground">Status</span>
                                        <span class="font-medium">@config.Label</span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-muted-foreground">Location</span>
                                        <span class="flex items-center gap-1 font-mono">
                                            <LucideCloudCn Size="12" Class="size-3 text-muted-foreground" />
                                            @backup.StorageLocation
                                        </span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-muted-foreground">Checksum</span>
                                        <span class="font-mono">@backup.Checksum</span>
                                    </div>
                                </div>
                                @if (backup.Status == "completed")
                                {
                                    <div class="mt-3 flex items-center gap-2">
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                                            <LucideArchiveRestoreCn Size="12" Class="size-3" />
                                            Restore
                                        </ButtonCn>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                                            <LucideDownloadCn Size="12" Class="size-3" />
                                            Download
                                        </ButtonCn>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs text-red-600 dark:text-red-400">
                                            <LucideTrashCn Size="12" Class="size-3" />
                                            Delete
                                        </ButtonCn>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "b3";

    private record Backup(string Id, string Name, string Type, string Status, string Size, int RetentionDays, string CreatedAt, string Duration, string StorageLocation, string Checksum);
    private record StatusStyleConfig(string Dot, string Label);

    private const string _totalSize = "111.4 GB";
    private static readonly int _completedCount = _backups.Count(b => b.Status == "completed");

    private static readonly Dictionary<string, StatusStyleConfig> _statusConfig = new()
    {
        ["completed"] = new("bg-emerald-500", "Completed"),
        ["in_progress"] = new("bg-blue-500", "In progress"),
        ["failed"] = new("bg-red-500", "Failed"),
        ["expired"] = new("bg-muted-foreground/40", "Expired"),
    };

    private static readonly Dictionary<string, string> _typeLabel = new()
    {
        ["full"] = "Full",
        ["incremental"] = "Incremental",
        ["differential"] = "Differential",
    };

    private static readonly Backup[] _backups =
    [
        new("b1", "prod-db-daily", "incremental", "in_progress", "\u2014", 30, "Just now", "2m 14s", "s3://backups/prod/daily/", "Computing..."),
        new("b2", "prod-db-daily", "incremental", "completed", "2.4 GB", 30, "Yesterday", "4m 38s", "s3://backups/prod/daily/", "sha256:a3f8c2d1e9b4"),
        new("b3", "prod-db-weekly", "full", "completed", "48.7 GB", 90, "3 days ago", "22m 15s", "s3://backups/prod/weekly/", "sha256:f7e2b4c8d610"),
        new("b4", "staging-db-daily", "incremental", "completed", "840 MB", 14, "Yesterday", "1m 52s", "s3://backups/staging/daily/", "sha256:b2c4d6e8f1a3"),
        new("b5", "prod-volumes", "differential", "completed", "12.3 GB", 60, "2 days ago", "8m 44s", "s3://backups/prod/volumes/", "sha256:c5d7e9f1a3b5"),
        new("b6", "prod-db-daily", "incremental", "failed", "\u2014", 30, "4 days ago", "0m 12s", "s3://backups/prod/daily/", "\u2014"),
        new("b7", "prod-db-monthly", "full", "completed", "47.2 GB", 365, "2 weeks ago", "21m 03s", "s3://backups/prod/monthly/", "sha256:d8e0f2a4b6c8"),
    ];
}
