                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (isExpanded && queue.RecentFailures.Length == 0)
                    {
                        <div class=""px-4 pb-4"">
                            <div class=""rounded-md bg-muted/50 p-3"">
                                <span class=""text-muted-foreground text-xs"">
                                    No recent failures in this queue
