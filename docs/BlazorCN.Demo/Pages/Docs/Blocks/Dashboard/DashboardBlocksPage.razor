                <div class=""@(Cn.Merge(""px-4 py-3"", i < 3 ? ""border-r"" : """"))"">
                    <p class=""text-muted-foreground text-xs"">@metric.Label</p>
                    <div class=""mt-1 flex items-baseline gap-1.5"">
                        <span class=""font-semibold text-lg tabular-nums"">@metric.Value</span>
                        <span class=""@(Cn.Merge(""flex items-center gap-0.5 text-xs"", metric.Trend == ""up"" ? ""text-emerald-600 dark:text-emerald-400"" : ""text-red-600 dark:text-red-400""))"">
                            @if (metric.Trend == ""up"")
                            {
                                <LucideTrendingUpCn Size=""12"" Class=""size-3"" />
                            }
                            else
                            {
                                <LucideTrendingDownCn Size=""12"" Class=""size-3"" />
                            }
                            @metric.Change
                        </span>
                    </div>
                </div>
            }
        </div>

        @* Top Pages *@
        <div class=""border-b px-4 py-3"">
            <h3 class=""mb-2 font-medium text-muted-foreground text-xs"">Top Pages</h3>
            <div>
                @for (var i = 0; i < _topPages.Length; i++)
                {
                    var pg = _topPages[i];
                    var isLast = i == _topPages.Length - 1;
                    <div class=""@(Cn.Merge(""flex items-center gap-3 py-2"", !isLast ? ""border-b"" : """"))"">
                        <span class=""text-muted-foreground text-xs tabular-nums"">@(i + 1)</span>
                        <span class=""min-w-0 flex-1 truncate font-mono text-sm"">@pg.Path</span>
                        <span class=""text-muted-foreground text-xs"">@pg.AvgTime</span>
                        <span class=""w-14 text-right font-medium text-sm tabular-nums"">
                            @FormatViews(pg.Views)
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Traffic Sources *@
        <div class=""px-4 py-3"">
            <h3 class=""mb-2 font-medium text-muted-foreground text-xs"">Traffic Sources</h3>
            <div class=""space-y-2"">
                @foreach (var source in _trafficSources)
                {
                    var barWidth = (int)Math.Round((double)source.Percentage / _maxSourcePercentage * 100);
                    <div>
                        <div class=""mb-1 flex items-center justify-between"">
                            <span class=""text-sm"">@source.Name</span>
                            <span class=""text-muted-foreground text-xs tabular-nums"">
                                @source.Visitors &middot; @source.Percentage%
                            </span>
                        </div>
                        <div class=""relative h-2 overflow-hidden rounded-full bg-muted/50"">
                            <div class=""absolute inset-y-0 left-0 rounded-full bg-foreground/20""
                                 style=""@($""width: {barWidth}%"")""></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record MetricData(string Label, string Value, string Change, string Trend);
    private record TopPageData(string Path, int Views, string AvgTime);
    private record TrafficSourceData(string Name, int Percentage, string Visitors);

    private int _maxSourcePercentage => _trafficSources.Max(s => s.Percentage);

    private static string FormatViews(int views)
    {
        if (views >= 1000) return $""{views / 1000.0:F1}K"";
        return $""{views}"";
    }

    private readonly MetricData[] _metrics = new[]
    {
        new MetricData(""Page Views"", ""248K"", ""+14.2%"", ""up""),
        new MetricData(""Unique Visitors"", ""89K"", ""+8.6%"", ""up""),
        new MetricData(""Bounce Rate"", ""34.2%"", ""-2.1%"", ""up""),
        new MetricData(""Avg Session"", ""3m 12s"", ""+0.4%"", ""up"")
    };

    private readonly TopPageData[] _topPages = new[]
    {
        new TopPageData(""/"", 48200, ""1m 42s""),
        new TopPageData(""/pricing"", 22400, ""3m 18s""),
        new TopPageData(""/docs/getting-started"", 18600, ""5m 24s""),
        new TopPageData(""/blog/nextjs-15-guide"", 14200, ""4m 52s""),
        new TopPageData(""/templates"", 11800, ""2m 36s"")
    };

    private readonly TrafficSourceData[] _trafficSources = new[]
    {
        new TrafficSourceData(""Organic Search"", 42, ""37.4K""),
        new TrafficSourceData(""Direct"", 24, ""21.4K""),
        new TrafficSourceData(""Social Media"", 18, ""16.0K""),
        new TrafficSourceData(""Referral"", 11, ""9.8K""),
        new TrafficSourceData(""Email"", 5, ""4.5K"")
    };
}";

    private const string DashboardWorkflowAutomationCode = @"<section class=""mx-auto w-full max-w-4xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        <div class=""flex items-center justify-between border-b px-4 py-3"">
            <div>
                <h2 class=""font-medium text-sm"">Workflow Automation</h2>
                <p class=""mt-0.5 text-muted-foreground text-xs"">@_workflows.Count(w => w.Status == ""active"") active workflows</p>
            </div>
        </div>

        @* Header row *@
        <div class=""grid grid-cols-[1fr_80px_100px_80px_72px_56px_60px] items-center gap-2 border-b bg-muted/30 px-4 py-2"">
            <span class=""text-muted-foreground text-xs"">Name</span>
            <span class=""text-muted-foreground text-xs"">Trigger</span>
            <span class=""text-muted-foreground text-xs"">Last Run</span>
            <span class=""text-right text-muted-foreground text-xs"">Success</span>
            <span class=""text-right text-muted-foreground text-xs"">Runs</span>
            <span class=""text-center text-muted-foreground text-xs"">Status</span>
            <span></span>
        </div>

        @* Workflow rows *@
        <div>
            @for (var i = 0; i < _workflows.Length; i++)
                        {
                var workflow = _workflows[i];
                var triggerStyle = workflow.Trigger switch {
                    ""Schedule"" => ""bg-blue-500/10 text-blue-600 dark:text-blue-400"",
                    ""Event"" => ""bg-purple-500/10 text-purple-600 dark:text-purple-400"",
                    _ => ""bg-muted text-muted-foreground"",
                };
                var statusDot = workflow.Status switch {
                    ""active"" => ""bg-emerald-500"",
                    ""paused"" => ""bg-amber-500"",
                    _ => ""bg-muted-foreground/40"",
                };
                var rateColor = workflow.SuccessRate >= 95 ? """" : workflow.SuccessRate >= 80 ? ""text-amber-600 dark:text-amber-400"" : ""text-red-600 dark:text-red-400"";
                <div class=""@Cn.Merge(""grid grid-cols-[1fr_80px_100px_80px_72px_56px_60px] items-center gap-2 px-4 py-3"", i < _workflows.Length - 1 ? ""border-b"" : """")"">
                    <span class=""truncate font-medium text-sm"">@workflow.Name</span>
                    <span class=""@($""inline-flex w-fit items-center rounded-full px-2 py-0.5 text-xs {triggerStyle}"")"">@workflow.Trigger</span>
                    <span class=""text-muted-foreground text-xs"">@workflow.LastRun</span>
                    <span class=""@($""text-right font-medium text-sm tabular-nums {rateColor}"")"">@workflow.SuccessRate%</span>
                    <span class=""text-right text-muted-foreground text-sm tabular-nums"">@workflow.RunCount.ToString(""N0"")</span>
                    <span class=""flex justify-center"">
                        <span class=""@($""size-2 rounded-full {statusDot}"")""></span>
                    </span>
                    <div class=""flex justify-end"">
                        <ButtonCn Variant=""ButtonVariant.Ghost"" Size=""ButtonSize.Sm"" Class=""h-7 gap-1 px-2 text-xs"">
                            <LucidePlayCn Size=""12"" />
                            Run
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

