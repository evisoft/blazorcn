@* ============================================================
   Block: dashboard-geographic-breakdown
   Title: Dashboard Geographic Breakdown
   Description: Animated React geographic breakdown dashboard block for Next.js with eight regions showing revenue share percentages, user counts, and proportional horizontal bars with staggered entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: CRM funnel with deal counts and conversion rates
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-geographic-breakdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="font-medium text-sm">Geographic Breakdown</h2>
                <p class="mt-0.5 text-muted-foreground text-xs">Revenue distribution by region</p>
            </div>
            <div class="text-right">
                <p class="text-muted-foreground text-xs">Total Revenue</p>
                <p class="font-semibold text-sm tabular-nums">$2.84M</p>
            </div>
        </div>

        <div>
            @for (var i = 0; i < _regions.Length; i++)
            {
                var region = _regions[i];
                var barWidth = region.Share / _maxShare * 100;
                var isLast = i == _regions.Length - 1;

                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b"))">
                    <span class="w-6 shrink-0 rounded bg-muted px-1 py-0.5 text-center text-xs text-muted-foreground">
                        @region.Code
                    </span>
                    <div class="min-w-0 flex-1">
                        <div class="mb-1 flex items-center justify-between">
                            <span class="font-medium text-sm">@region.Name</span>
                            <div class="flex items-center gap-3">
                                <span class="text-muted-foreground text-xs tabular-nums">
                                    @region.Users users
                                </span>
                                <span class="w-12 text-right font-medium text-sm tabular-nums">
                                    @(region.Share)%
                                </span>
                            </div>
                        </div>
                        <div class="h-1.5 w-full rounded-full bg-muted/50">
                            <div class="h-full rounded-full bg-foreground/20"
                                 style="@(FormattableString.Invariant($"width: {barWidth:F1}%"))">
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Region(string Name, string Code, double Share, string Users);

    private static readonly Region[] _regions =
    [
        new("United States", "US", 34.2, "48,200"),
        new("United Kingdom", "GB", 14.8, "20,900"),
        new("Germany", "DE", 11.3, "15,600"),
        new("Canada", "CA", 9.7, "13,400"),
        new("France", "FR", 8.1, "11,200"),
        new("Australia", "AU", 7.4, "10,100"),
        new("Japan", "JP", 5.9, "8,300"),
        new("Brazil", "BR", 4.2, "5,800"),
    ];

    private static readonly double _maxShare = _regions[0].Share;
}
