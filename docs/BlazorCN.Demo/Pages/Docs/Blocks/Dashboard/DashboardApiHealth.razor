@* ============================================================
   Block: dashboard-api-health
   Title: Dashboard Api Health
   Description: Animated React API health check dashboard block for Next.js with eight endpoints showing monospace paths, HTTP method chips, response times in tabular-nums, status codes, uptime percentages, last checked timestamps, overall health score, and green, amber, and red row coloring using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: API request metrics with endpoint breakdown
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-api-health.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">API Health</span>
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-1.5">
                    <span class="@(Cn.Merge("size-1.5 rounded-full", _overallScore >= 99 ? "bg-emerald-500" : _overallScore >= 95 ? "bg-amber-500" : "bg-red-500"))"></span>
                    <span class="text-muted-foreground text-xs">
                        @_healthyCount/@_endpoints.Length healthy
                    </span>
                </div>
            </div>
        </div>

        @* Health score *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div>
                <span class="text-muted-foreground text-xs">Health Score</span>
                <div class="flex items-baseline gap-1">
                    <span class="@(Cn.Merge("font-semibold text-2xl tabular-nums", _overallScore >= 99 ? "text-emerald-600 dark:text-emerald-400" : _overallScore >= 95 ? "text-amber-600 dark:text-amber-400" : "text-red-600 dark:text-red-400"))">
                        @_overallScore.ToString("F2")
                    </span>
                    <span class="text-muted-foreground text-xs">% avg uptime</span>
                </div>
            </div>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">Checking every 30s</span>
        </div>

        @* Table header *@
        <div class="hidden items-center gap-3 border-b bg-muted/30 px-4 py-2 sm:flex">
            <span class="w-5 shrink-0"></span>
            <span class="w-14 shrink-0 text-muted-foreground text-xs">Method</span>
            <span class="min-w-0 flex-1 text-muted-foreground text-xs">Endpoint</span>
            <span class="w-16 text-right text-muted-foreground text-xs">Latency</span>
            <span class="w-12 text-right text-muted-foreground text-xs">Status</span>
            <span class="w-16 text-right text-muted-foreground text-xs">Uptime</span>
            <span class="w-16 text-right text-muted-foreground text-xs">Checked</span>
        </div>

        @* Endpoints *@
        <div>
            @for (var i = 0; i < _endpoints.Length; i++)
            {
                var endpoint = _endpoints[i];
                var isLast = i == _endpoints.Length - 1;
                <div class="@(Cn.Merge("flex flex-col gap-1 px-4 py-2.5 sm:flex-row sm:items-center sm:gap-3", GetRowHighlight(endpoint.Status), isLast ? "" : "border-b"))">
                    <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", GetStatusDot(endpoint.Status)))"></span>
                    <span class="@(Cn.Merge("w-14 shrink-0 inline-flex items-center rounded px-1.5 py-0.5 font-mono text-[10px] font-medium", GetMethodColor(endpoint.Method)))">
                        @endpoint.Method
                    </span>
                    <span class="min-w-0 flex-1 truncate font-mono text-xs">@endpoint.Path</span>
                    <span class="w-16 shrink-0 text-right text-muted-foreground text-xs tabular-nums">
                        @endpoint.ResponseTime
                    </span>
                    <span class="@(Cn.Merge("w-12 shrink-0 text-right font-mono text-xs font-medium tabular-nums", GetStatusCodeColor(endpoint.StatusCode)))">
                        @endpoint.StatusCode
                    </span>
                    <span class="w-16 shrink-0 text-right font-medium text-xs tabular-nums">
                        @endpoint.Uptime%
                    </span>
                    <span class="w-16 shrink-0 text-right text-muted-foreground text-xs">
                        @endpoint.LastChecked
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record EndpointItem(string Path, string Method, string ResponseTime, int StatusCode, string Uptime, string LastChecked, string Status);

    private static string GetMethodColor(string method) => method switch
    {
        "GET" => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        "POST" => "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        "PUT" => "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        "DELETE" => "bg-red-500/10 text-red-600 dark:text-red-400",
        "PATCH" => "bg-purple-500/10 text-purple-600 dark:text-purple-400",
        _ => ""
    };

    private static string GetStatusDot(string status) => status switch
    {
        "healthy" => "bg-emerald-500",
        "degraded" => "bg-amber-500",
        "down" => "bg-red-500",
        _ => ""
    };

    private static string GetRowHighlight(string status) => status switch
    {
        "degraded" => "bg-amber-500/5",
        "down" => "bg-red-500/5",
        _ => ""
    };

    private static string GetStatusCodeColor(int code)
    {
        if (code >= 200 && code < 300) return "text-emerald-600 dark:text-emerald-400";
        if (code >= 300 && code < 400) return "text-amber-600 dark:text-amber-400";
        return "text-red-600 dark:text-red-400";
    }

    private static readonly EndpointItem[] _endpoints =
    [
        new("/api/v2/auth/login", "POST", "45ms", 200, "99.99", "30s ago", "healthy"),
        new("/api/v2/users", "GET", "62ms", 200, "99.98", "30s ago", "healthy"),
        new("/api/v2/products", "GET", "38ms", 200, "99.97", "30s ago", "healthy"),
        new("/api/v2/orders", "POST", "128ms", 200, "99.92", "30s ago", "healthy"),
        new("/api/v2/payments", "POST", "342ms", 200, "99.85", "30s ago", "degraded"),
        new("/api/v2/webhooks", "PUT", "89ms", 200, "99.94", "30s ago", "healthy"),
        new("/api/v2/search", "GET", "1,240ms", 503, "97.20", "30s ago", "down"),
        new("/api/v2/analytics", "GET", "156ms", 200, "99.91", "30s ago", "healthy"),
    ];

    private static readonly int _healthyCount = _endpoints.Count(e => e.Status == "healthy");
    private static readonly double _overallScore = _endpoints.Average(e => double.Parse(e.Uptime));
}
