@* ============================================================
   Block: dashboard-rate-limiter-stats
   Title: Dashboard Rate Limiter Stats
   Description: Animated React rate limiter statistics dashboard block for Next.js with seven rate limiting tiers showing total requests, passed and throttled counts, throttle percentages, top throttled client IPs, animated usage bars, and staggered row entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: API endpoint quota utilization tracking
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-rate-limiter-stats.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideGaugeCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Rate Limiter Stats</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Throttle statistics across @_tiers.Length tiers
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <span class="tabular-nums">@FormatCount(_totalRequests) reqs</span>
                <span>·</span>
                <span class="tabular-nums">@_overallThrottleRate.ToString("F2")% throttled</span>
            </div>
        </div>

        @* Summary bar *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Overall throttle rate</span>
                <span class="font-medium tabular-nums">
                    @FormatCount(_totalThrottled) of @FormatCount(_totalRequests) throttled
                </span>
            </div>
            <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-muted/50">
                <div class="h-full rounded-full bg-red-500/50" style="@($"width: {Math.Max(_overallThrottleRate, 0.5)}%")"></div>
            </div>
        </div>

        @* Tiers *@
        <div>
            @for (var i = 0; i < _tiers.Length; i++)
            {
                var tier = _tiers[i];
                var isExpanded = _expanded == tier.Id;
                var isLast = i == _tiers.Length - 1;
                var maxThrottle = 10.0;
                var barWidth = Math.Min(tier.ThrottlePercent / maxThrottle * 100, 100);
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : tier.Id)"
                        class="w-full px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex items-center gap-3">
                            <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", tier.ThrottlePercent >= 5 ? "bg-red-500" : tier.ThrottlePercent >= 1 ? "bg-amber-500" : "bg-emerald-500"))"></span>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-sm">@tier.Name</span>
                                    <span class="text-muted-foreground text-xs">
                                        @tier.Limit.ToString("N0") / @tier.Window
                                    </span>
                                </div>
                                <div class="mt-0.5 flex items-center gap-3 text-muted-foreground text-xs">
                                    <span class="tabular-nums">
                                        @FormatCount(tier.TotalRequests) total
                                    </span>
                                    <span>·</span>
                                    <span class="tabular-nums">@FormatCount(tier.Passed) passed</span>
                                    <span>·</span>
                                    <span class="@(Cn.Merge("tabular-nums", ThrottleTextColor(tier.ThrottlePercent)))">
                                        @FormatCount(tier.Throttled) throttled
                                    </span>
                                </div>
                            </div>
                            <span class="@(Cn.Merge("shrink-0 font-medium text-sm tabular-nums", ThrottleTextColor(tier.ThrottlePercent)))">
                                @(tier.ThrottlePercent)%
                            </span>
                            <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                        </div>

                        @* Throttle bar *@
                        <div class="mt-2 pl-5">
                            <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted/50">
                                <div class="@(Cn.Merge("h-full rounded-full", ThrottleBarColor(tier.ThrottlePercent)))"
                                     style="@($"width: {barWidth:F1}%")"></div>
                            </div>
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-9">
                            <div class="rounded-md bg-muted/50 p-3">
                                <p class="mb-2 text-muted-foreground text-xs">@tier.Description</p>
                                <div class="grid grid-cols-3 gap-x-4 gap-y-2 text-xs">
                                    <div>
                                        <span class="text-muted-foreground">Burst limit</span>
                                        <p class="mt-0.5 font-medium tabular-nums">
                                            @tier.BurstLimit reqs
                                        </p>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground">Top throttled</span>
                                        <p class="mt-0.5 truncate font-mono font-medium">
                                            @tier.TopThrottledClient
                                        </p>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground">Their throttles</span>
                                        <p class="mt-0.5 font-medium tabular-nums">
                                            @tier.TopThrottledCount.ToString("N0")
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded;

    private record RateLimiterTier(string Id, string Name, string Description, string Window, int Limit, int TotalRequests, int Passed, int Throttled, double ThrottlePercent, string TopThrottledClient, int TopThrottledCount, int BurstLimit);

    private static string FormatCount(int n)
    {
        if (n >= 1_000_000) return $"{(n / 1_000_000.0):F1}M";
        if (n >= 1_000) return $"{(n / 1_000.0):F1}K";
        return n.ToString();
    }

    private static string ThrottleBarColor(double pct) =>
        pct >= 5 ? "bg-red-500/70"
        : pct >= 1 ? "bg-amber-500/70"
        : "bg-foreground/20";

    private static string ThrottleTextColor(double pct) =>
        pct >= 5 ? "text-red-600 dark:text-red-400"
        : pct >= 1 ? "text-amber-600 dark:text-amber-400"
        : "text-muted-foreground";

    private static readonly RateLimiterTier[] _tiers =
    [
        new("1", "Anonymous", "Unauthenticated requests from public clients", "1 min", 30, 184920, 172491, 12429, 6.7, "203.0.113.47", 3841, 10),
        new("2", "Free Tier", "Authenticated free plan API keys", "1 min", 100, 892104, 881293, 10811, 1.2, "key_free_8Kv2m...nR4", 2190, 20),
        new("3", "Pro Tier", "Authenticated pro plan API keys", "1 min", 1000, 2847291, 2844982, 2309, 0.08, "key_pro_Mn7x...4Lq", 847, 200),
        new("4", "Enterprise", "Enterprise accounts with custom limits", "1 min", 10000, 4129384, 4129384, 0, 0, "None", 0, 2000),
        new("5", "Webhook Delivery", "Outgoing webhook delivery attempts", "1 min", 500, 312847, 309421, 3426, 1.1, "hook_Qw9...3mR", 1204, 100),
        new("6", "Auth Endpoints", "Login, signup, and token refresh requests", "15 min", 20, 89412, 84291, 5121, 5.7, "198.51.100.93", 1847, 5),
        new("7", "File Upload", "Asset and media upload requests", "5 min", 50, 42918, 41203, 1715, 4.0, "key_pro_Rv2...8nK", 612, 10),
    ];
    private static readonly int _totalThrottled = _tiers.Sum(t => t.Throttled);
    private static readonly int _totalRequests = _tiers.Sum(t => t.TotalRequests);
    private static readonly double _overallThrottleRate = (double)_totalThrottled / _totalRequests * 100;

}
