@* ============================================================
   Block: dashboard-subscription-metrics
   Title: Dashboard Subscription Metrics
   Description: Animated React subscription metrics dashboard block for Next.js with six SaaS KPI cards showing MRR, ARR, churn rate, LTV, ARPU, and net revenue retention in a staggered 3x2 grid using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Funnel stages with conversion rates and deal values
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-subscription-metrics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Subscription Metrics</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                SaaS performance indicators for this period
            </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3">
            @for (var i = 0; i < _metrics.Length; i++)
            {
                var metric = _metrics[i];
                var isPositive = metric.InvertTrend ? metric.Trend == "down" : metric.Trend == "up";
                var isTopRow = i < 3;
                var isRightEdge = (i + 1) % 3 == 0;

                <div class="@(Cn.Merge("px-4 py-4", isTopRow ? "border-b" : "", !isRightEdge ? "border-r" : ""))">
                    <p class="text-muted-foreground text-xs">@metric.Label</p>
                    <div class="mt-1 flex items-baseline gap-2">
                        <span class="font-semibold text-2xl tabular-nums">@metric.Value</span>
                        <span class="@(Cn.Merge("flex items-center gap-0.5 text-xs", isPositive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400"))">
                            @if (metric.Trend == "up")
                            {
                                <LucideTrendingUpCn Size="12" Class="size-3" />
                            }
                            else
                            {
                                <LucideTrendingDownCn Size="12" Class="size-3" />
                            }
                            @metric.Change
                        </span>
                    </div>
                    <p class="mt-1 text-muted-foreground text-xs">@metric.Description</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record MetricData(string Label, string Value, string Change, string Trend, string Description, bool InvertTrend = false);

    private readonly MetricData[] _metrics = new[]
    {
        new MetricData("MRR", "$127K", "+9.2%", "up", "Monthly recurring revenue"),
        new MetricData("ARR", "$1.52M", "+14.8%", "up", "Annual recurring revenue"),
        new MetricData("Churn Rate", "2.1%", "-0.3%", "down", "Monthly customer churn", true),
        new MetricData("LTV", "$4,200", "+6.1%", "up", "Customer lifetime value"),
        new MetricData("ARPU", "$89", "+3.4%", "up", "Average revenue per user"),
        new MetricData("Net Revenue Retention", "112%", "+2.1%", "up", "Expansion minus churn")
    };
}
