@* ============================================================
   Block: dashboard-environment-status
   Title: Dashboard Environment Status
   Description: Animated React multi-environment status block for Next.js with four deployment environments showing version numbers, deploy timestamps, health indicators, resource usage bars, and API uptime percentages using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Build pipeline with stage visualization
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-environment-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Environment Status</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Deployment health across all environments
            </p>
        </div>

        <div>
            @for (var i = 0; i < _environments.Length; i++)
            {
                var env = _environments[i];
                var config = _statusConfig[env.Status];
                var isLast = i == _environments.Length - 1;
                <div class="@(Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b"))">
                    <div class="flex items-center gap-3">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", config.Dot))"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@env.Name</span>
                                <span class="font-mono text-muted-foreground text-xs">@env.Version</span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                Deployed @env.LastDeploy
                                <span class="mx-1.5">·</span>
                                @config.Label
                            </p>
                        </div>
                        <div class="text-right">
                            <span class="@(Cn.Merge("font-semibold text-sm tabular-nums", GetHealthColor(env.ApiHealth)))">
                                @(env.ApiHealth)%
                            </span>
                            <p class="mt-0.5 text-muted-foreground text-xs">API uptime</p>
                        </div>
                    </div>

                    <div class="mt-3 grid grid-cols-2 gap-3">
                        <div>
                            <div class="mb-1 flex items-center justify-between">
                                <span class="text-muted-foreground text-xs">CPU</span>
                                <span class="font-mono text-muted-foreground text-xs tabular-nums">
                                    @(env.Cpu)%
                                </span>
                            </div>
                            <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                                <div class="@(Cn.Merge("h-full rounded-full", GetBarColor(env.Cpu)))"
                                     style="@($"width: {env.Cpu}%")">
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="mb-1 flex items-center justify-between">
                                <span class="text-muted-foreground text-xs">Memory</span>
                                <span class="font-mono text-muted-foreground text-xs tabular-nums">
                                    @(env.Memory)%
                                </span>
                            </div>
                            <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                                <div class="@(Cn.Merge("h-full rounded-full", GetBarColor(env.Memory)))"
                                     style="@($"width: {env.Memory}%")">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record EnvInfo(string Name, string Version, string LastDeploy, string Status, int Cpu, int Memory, double ApiHealth);
    private record StatusConfig(string Dot, string Label);

    private static string GetBarColor(int value)
    {
        if (value >= 85) return "bg-red-500/60";
        if (value >= 60) return "bg-amber-500/60";
        return "bg-emerald-500/40";
    }

    private static string GetHealthColor(double value)
    {
        if (value >= 99.9) return "text-emerald-600 dark:text-emerald-400";
        if (value >= 99) return "text-amber-600 dark:text-amber-400";
        return "text-red-600 dark:text-red-400";
    }

    private static readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["healthy"] = new("bg-emerald-500", "Healthy"),
        ["degraded"] = new("bg-amber-500", "Degraded"),
        ["down"] = new("bg-red-500", "Down"),
    };

    private static readonly EnvInfo[] _environments =
    [
        new("Production", "v3.14.2", "2 hours ago", "healthy", 42, 67, 99.98),
        new("Staging", "v3.15.0-rc.1", "35 min ago", "healthy", 28, 45, 99.94),
        new("Development", "v3.15.0-dev.47", "8 min ago", "degraded", 71, 82, 97.2),
        new("Preview", "v3.15.0-pr.284", "12 min ago", "healthy", 15, 31, 99.99),
    ];
}
