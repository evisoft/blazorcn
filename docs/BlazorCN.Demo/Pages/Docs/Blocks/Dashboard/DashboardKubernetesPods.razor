@* ============================================================
   Block: dashboard-kubernetes-pods
   Title: Dashboard Kubernetes Pods
   Description: Animated React Kubernetes pod monitoring dashboard block for Next.js with namespace grouping, pod status indicators, restart counts, CPU and memory resource requests, container readiness, and expandable pod details using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Server CPU, memory, and disk utilization
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-kubernetes-pods.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Kubernetes Pods</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Pod status across @_pods.Length workloads
                </p>
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_runningCount running
                </span>
                @if (_unhealthyCount > 0)
                            {
                    <span class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        @_unhealthyCount unhealthy
                    </span>
                }
            </div>
        </div>

        @* Column headers *@
        <div class="flex items-center gap-3 border-b bg-muted/30 px-4 py-2 text-muted-foreground text-xs">
            <span class="min-w-0 flex-1">Pod</span>
            <span class="w-16 shrink-0 text-right">Status</span>
            <span class="w-14 shrink-0 text-right">Restarts</span>
            <span class="hidden w-14 shrink-0 text-right sm:block">CPU</span>
            <span class="hidden w-14 shrink-0 text-right sm:block">Memory</span>
            <span class="w-14 shrink-0 text-right">Age</span>
            <span class="w-5 shrink-0"></span>
        </div>

        @* Pods *@
        <div>
            @for (var i = 0; i < _pods.Length; i++)
                        {
                var pod = _pods[i];
                var isExpanded = _expanded == pod.Id;
                var isLast = i == _pods.Length - 1;
                var config = _statusConfig[pod.Status];
                var nsStyle = _namespaceStyle.GetValueOrDefault(pod.Namespace, "bg-muted/50 text-muted-foreground");

                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = isExpanded ? null : pod.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", config.Dot))"></span>
                                <span class="truncate font-mono text-sm">@pod.Name</span>
                            </div>
                            <div class="mt-1 ml-4">
                                <span class="@(Cn.Merge("inline-flex rounded px-1.5 py-0.5 text-[10px] font-medium", nsStyle))">
                                    @pod.Namespace
                                </span>
                            </div>
                        </div>
                        <span class="w-16 shrink-0 text-right text-muted-foreground text-xs">
                            @config.Label
                        </span>
                        <span class="@(Cn.Merge("w-14 shrink-0 text-right font-mono text-xs tabular-nums", pod.Restarts > 5 ? "font-medium text-red-600 dark:text-red-400" : pod.Restarts > 0 ? "text-amber-600 dark:text-amber-400" : "text-muted-foreground"))">
                            @pod.Restarts
                        </span>
                        <span class="hidden w-14 shrink-0 text-right font-mono text-muted-foreground text-xs tabular-nums sm:block">
                            @pod.CpuRequest
                        </span>
                        <span class="hidden w-14 shrink-0 text-right font-mono text-muted-foreground text-xs tabular-nums sm:block">
                            @pod.MemoryRequest
                        </span>
                        <span class="w-14 shrink-0 text-right text-muted-foreground text-xs">
                            @pod.Age
                        </span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                                {
                        <div class="px-4 pb-4">
                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="mb-2 block font-medium text-muted-foreground text-xs">
                                    Containers (@pod.Containers.Length)
                                </span>
                                <div class="space-y-3">
                                    @foreach (var container in pod.Containers)
                                                {
                                        <div>
                                            <div class="flex items-center gap-2">
                                                <span class="@(Cn.Merge("size-1.5 rounded-full", container.Ready ? "bg-emerald-500" : "bg-red-500"))"></span>
                                                <span class="font-mono text-sm">@container.Name</span>
                                                <span class="font-mono text-muted-foreground text-[10px]">
                                                    @container.Image
                                                </span>
                                            </div>
                                            <div class="mt-1 ml-4 flex items-center gap-4 text-xs">
                                                <span class="text-muted-foreground">
                                                    CPU limit:
                                                    <span class="font-mono tabular-nums">@container.CpuLimit</span>
                                                </span>
                                                <span class="text-muted-foreground">
                                                    Mem limit:
                                                    <span class="font-mono tabular-nums">@container.MemoryLimit</span>
                                                </span>
                                                <span class="text-muted-foreground">
                                                    @(container.Ready ? "Ready" : "Not ready")
                                                </span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(container.LastRestartReason))
                                                        {
                                                <div class="mt-1.5 ml-4 rounded bg-red-500/5 px-2 py-1.5">
                                                    <span class="font-mono text-red-600 text-xs dark:text-red-400">
                                                        @container.LastRestartReason
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ContainerInfo(string Name, string Image, bool Ready, string CpuLimit, string MemoryLimit, string LastRestartReason);
    private record PodInfo(string Id, string Name, string Namespace, string Status, int Restarts, string CpuRequest, string MemoryRequest, string Age, ContainerInfo[] Containers);
    private record StatusConfig(string Dot, string Label);

    private string? _expanded = "p4";

    private int _runningCount => _pods.Count(p => p.Status == "Running");
    private int _unhealthyCount => _pods.Count(p => p.Status == "CrashLoopBackOff" || p.Status == "Failed");

    private readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["Running"] = new("bg-emerald-500", "Running"),
        ["Pending"] = new("bg-amber-500", "Pending"),
        ["CrashLoopBackOff"] = new("bg-red-500", "CrashLoop"),
        ["Completed"] = new("bg-blue-500", "Completed"),
        ["Failed"] = new("bg-red-500", "Failed")
    };

    private readonly Dictionary<string, string> _namespaceStyle = new()
    {
        ["production"] = "bg-foreground text-background",
        ["ml-serving"] = "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        ["jobs"] = "bg-muted text-muted-foreground",
        ["monitoring"] = "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        ["cert-manager"] = "bg-muted/50 text-muted-foreground"
    };

    private readonly PodInfo[] _pods = new[]
    {
        new PodInfo("p1", "api-server-7d4f8b6c9-xk2mn", "production", "Running", 0, "500m", "512Mi", "3d 14h", new[]
        {
            new ContainerInfo("api", "acme/api-server:v2.14.3", true, "1000m", "1Gi", ""),
            new ContainerInfo("sidecar-proxy", "envoyproxy/envoy:v1.28", true, "200m", "128Mi", "")
        }),
        new PodInfo("p2", "worker-processor-5c8d7e2a1-j9plq", "production", "Running", 2, "250m", "256Mi", "1d 8h", new[]
        {
            new ContainerInfo("worker", "acme/worker:v2.14.3", true, "500m", "512Mi", "OOMKilled")
        }),
        new PodInfo("p3", "redis-cache-0", "production", "Running", 0, "100m", "1Gi", "14d 2h", new[]
        {
            new ContainerInfo("redis", "redis:7.2-alpine", true, "200m", "2Gi", "")
        }),
        new PodInfo("p4", "ml-inference-8f3a2b1c7-ht4vw", "ml-serving", "CrashLoopBackOff", 14, "2000m", "4Gi", "6h", new[]
        {
            new ContainerInfo("inference", "acme/ml-serve:v1.3.0-rc2", false, "4000m", "8Gi", "Error: model checkpoint file not found at /models/v1.3/weights.bin")
        }),
        new PodInfo("p5", "migration-job-20240312-kz8qd", "jobs", "Completed", 0, "1000m", "2Gi", "22h", new[]
        {
            new ContainerInfo("migrate", "acme/db-migrate:v2.14.3", false, "2000m", "4Gi", "")
        }),
        new PodInfo("p6", "grafana-6d5e4c3b2-mn7yp", "monitoring", "Running", 0, "200m", "256Mi", "7d 3h", new[]
        {
            new ContainerInfo("grafana", "grafana/grafana:10.3.1", true, "500m", "512Mi", "")
        }),
        new PodInfo("p7", "cert-manager-webhook-9a1b2c3d4-qr5st", "cert-manager", "Pending", 0, "50m", "64Mi", "2 min", new[]
        {
            new ContainerInfo("webhook", "quay.io/jetstack/cert-manager-webhook:v1.14.2", false, "100m", "128Mi", "")
        })
    };
}
