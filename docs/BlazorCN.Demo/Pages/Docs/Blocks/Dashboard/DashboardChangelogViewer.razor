@* ============================================================
   Block: dashboard-changelog-viewer
   Title: Dashboard Changelog Viewer
   Description: Animated React changelog dashboard block for Next.js with version tags, release type chips, author initials, unread dot indicators, expandable descriptions, and staggered entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Recent activity timeline with user actions
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-changelog-viewer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Changelog</span>
                @if (_unreadCount > 0)
                            {
                    <span class="inline-flex items-center rounded-full bg-blue-500/10 px-2 py-0.5 font-medium text-[10px] text-blue-600 dark:text-blue-400">
                        @_unreadCount new
                    </span>
                }
            </div>
            <span class="text-muted-foreground text-xs">What's new</span>
        </div>

        @* Entries *@
        <div>
            @for (var i = 0; i < _entries.Length; i++)
                        {
                var entry = _entries[i];
                var index = i;
                var isExpanded = _expanded == entry.Id;
                var isLast = index == _entries.Length - 1;

                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : entry.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex shrink-0 items-center gap-1.5">
                            @if (entry.IsNew)
                                        {
                                <span class="size-1.5 shrink-0 rounded-full bg-blue-500"></span>
                            }
                            <span class="font-mono text-muted-foreground text-xs">@entry.Version</span>
                        </div>
                        <span class="@(Cn.Merge("inline-flex shrink-0 items-center rounded px-1.5 py-0.5 font-medium text-[10px]", _typeStyles[entry.Type]))">
                            @(_typeLabels[entry.Type])
                        </span>
                        <span class="min-w-0 flex-1 truncate font-medium text-sm">@entry.Title</span>
                        <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted/50 font-medium text-[10px] text-muted-foreground">
                            @entry.Initials
                        </span>
                        <span class="hidden shrink-0 text-muted-foreground text-xs sm:inline">
                            @entry.Timestamp
                        </span>
                        <LucideChevronRightCn Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </button>

                    @if (isExpanded)
                                {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-3 pl-9">
                                <div class="flex items-center gap-2 text-muted-foreground text-xs">
                                    <span>@entry.Author</span>
                                    <span>·</span>
                                    <span>@entry.Timestamp</span>
                                </div>
                                <p class="mt-2 text-sm leading-relaxed">@entry.Description</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "1";

    private record ChangelogEntry(string Id, string Version, string Title, string Type, string Timestamp, string Author, string Initials, string Description, bool IsNew);

    private int _unreadCount => _entries.Count(e => e.IsNew);

    private readonly Dictionary<string, string> _typeStyles = new()
    {
        ["feature"] = "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        ["fix"] = "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        ["improvement"] = "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        ["breaking"] = "bg-red-500/10 text-red-600 dark:text-red-400"
    };

    private readonly Dictionary<string, string> _typeLabels = new()
    {
        ["feature"] = "Feature",
        ["fix"] = "Fix",
        ["improvement"] = "Improvement",
        ["breaking"] = "Breaking"
    };

    private readonly ChangelogEntry[] _entries = new[]
    {
        new ChangelogEntry("1", "v2.14.0", "Real-time collaboration cursors", "feature", "2 hours ago", "Sarah Chen", "SC",
            "Added live cursor presence for team collaboration. Multiple users can now see each other's cursors and selections in real time. Cursors are color-coded per user with name labels that fade after 3 seconds of inactivity.", true),
        new ChangelogEntry("2", "v2.13.2", "Fixed CSV export encoding for unicode characters", "fix", "Yesterday", "Marcus Rivera", "MR",
            "Resolved an issue where CSV exports would produce garbled text for non-ASCII characters. The export pipeline now uses UTF-8 BOM encoding, ensuring proper rendering in Excel and Google Sheets across all locales.", true),
        new ChangelogEntry("3", "v2.13.1", "Faster dashboard load with lazy data fetching", "improvement", "3 days ago", "Aisha Patel", "AP",
            "Dashboard widgets now load data independently using suspense boundaries. Initial page load is 40% faster as above-the-fold widgets render immediately while secondary panels stream in. No API changes required.", false),
        new ChangelogEntry("4", "v2.13.0", "Webhook retry policy configuration", "feature", "1 week ago", "James Olsen", "JO",
            "Webhook endpoints now support configurable retry policies. Set max retry attempts (1-10), backoff strategy (linear or exponential), and timeout thresholds per endpoint. Failed deliveries show detailed error logs in the dashboard.", false),
        new ChangelogEntry("5", "v2.12.0", "Deprecated legacy auth tokens", "breaking", "2 weeks ago", "Sarah Chen", "SC",
            "Legacy v1 authentication tokens are no longer accepted. All API consumers must migrate to OAuth 2.0 bearer tokens. A migration guide is available at docs.acme.com/auth-migration. Existing sessions remain valid for 30 days.", false)
    };
}
