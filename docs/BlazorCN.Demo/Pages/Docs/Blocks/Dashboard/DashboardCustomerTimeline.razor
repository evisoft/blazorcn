@* ============================================================
   Block: dashboard-customer-timeline
   Title: Dashboard Customer Timeline
   Description: Animated React customer journey timeline dashboard block for Next.js with eight chronological events from signup through renewal showing timeline dots with connecting lines, event descriptions, and staggered entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: KPI metrics with trend indicators
   Dependencies: None
   Source: original/blocks/dashboard/dashboard-customer-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <h2 class="font-medium text-sm">Customer Timeline</h2>
                <span class="rounded bg-muted/50 px-1.5 py-0.5 text-muted-foreground text-xs">
                    Sarah Chen
                </span>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Journey from signup through renewal · 8 events
            </p>
        </div>

        @* Timeline *@
        <div class="relative px-4 py-4">
            @* Vertical line *@
            <div class="absolute top-8 bottom-8 left-[29px] w-px bg-border"></div>

            <div class="space-y-0">
                @for (var i = 0; i < _events.Length; i++)
                            {
                    var evt = _events[i];
                    var isLast = i == _events.Length - 1;

                    <div class="@(Cn.Merge("relative flex gap-3", !isLast ? "pb-6" : ""))">
                        @* Dot *@
                        <div class="@(Cn.Merge("relative z-10 flex size-6 shrink-0 items-center justify-center rounded-full", evt.DotBg))">
                            @evt.IconFragment
                        </div>

                        @* Content *@
                        <div class="min-w-0 flex-1 pt-0.5">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@evt.Title</span>
                                <span class="text-muted-foreground text-xs">@evt.Date</span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">
                                @evt.Description
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record TimelineEvent(string Id, string Title, string Description, string Date, string DotBg, string IconColor, RenderFragment IconFragment);

    private TimelineEvent[] _events = Array.Empty<TimelineEvent>();

    protected override void OnInitialized()
    {
        _events = new[]
        {
            MakeEvent("1", "Signed Up", "Created account via Google OAuth from the pricing page", "Jan 4", "bg-blue-500/10", "text-blue-600 dark:text-blue-400"),
            MakeEvent("2", "First Login", "Completed onboarding checklist and connected GitHub", "Jan 4", "bg-blue-500/10", "text-blue-600 dark:text-blue-400"),
            MakeEvent("3", "Created Project", "Set up first project with Next.js starter template", "Jan 5", "bg-emerald-500/10", "text-emerald-600 dark:text-emerald-400"),
            MakeEvent("4", "Invited Team", "Added 3 team members with editor permissions", "Jan 8", "bg-emerald-500/10", "text-emerald-600 dark:text-emerald-400"),
            MakeEvent("5", "Upgraded to Pro", "Purchased Team plan (yearly) at $469/year", "Jan 14", "bg-emerald-500/10", "text-emerald-600 dark:text-emerald-400"),
            MakeEvent("6", "Support Ticket", "Reported issue with webhook delivery delays — resolved in 2 hours", "Feb 2", "bg-amber-500/10", "text-amber-600 dark:text-amber-400"),
            MakeEvent("7", "Feature Request", "Requested CSV export for analytics dashboard — shipped in v2.3.0", "Feb 18", "bg-amber-500/10", "text-amber-600 dark:text-amber-400"),
            MakeEvent("8", "Renewed", "Auto-renewed Team plan for another year", "Mar 14", "bg-emerald-500/10", "text-emerald-600 dark:text-emerald-400"),
        };
    }

    private static TimelineEvent MakeEvent(string id, string title, string description, string date, string dotBg, string iconColor)
    {
        RenderFragment icon = @<span class="@(Cn.Merge("size-3", iconColor))">&#x2022;</span>;
        return new TimelineEvent(id, title, description, date, dotBg, iconColor, icon);
    }
}
