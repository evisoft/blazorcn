@* ============================================================
   Block: music-vinyl-collection
   Title: MusicVinylCollection
   Description: A vinyl record collection display block for React and Next.js with cover placeholders, RPM info, condition ratings, pressing year, and CSS spin animation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-vinyl-collection.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="library" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Vinyl Collection</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Personal record library with condition grading and market values.
            </p>
        </div>

        @* Summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="disc" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-semibold text-sm tabular-nums">@_totalRecords</span>
                <span class="text-muted-foreground text-xs">records</span>
            </div>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="dollar-sign" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-semibold text-sm tabular-nums">$@_totalValue.ToString("N0")</span>
                <span class="text-muted-foreground text-xs">estimated value</span>
            </div>
        </div>

        @* Record list *@
        <div>
            @foreach (var rec in _records)
            {
                var record = rec;
                var isLast = record.Id == _records[_records.Length - 1].Id;
                <div class="@Cn.Merge("group flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">

                    @* Vinyl disc placeholder *@
                    <div class="relative flex size-10 shrink-0 items-center justify-center overflow-hidden rounded-full border bg-zinc-950">
                        <div class="@($"absolute inset-0 {record.Color} opacity-60 transition-transform duration-1000 ease-linear group-hover:animate-spin")"></div>
                        <div class="relative size-2.5 rounded-full border border-zinc-600 bg-zinc-950"></div>
                    </div>

                    @* Info *@
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="truncate font-medium text-sm">@record.Album</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-mono text-xs">
                                @record.Rpm RPM
                            </BadgeCn>
                        </div>
                        <div class="mt-0.5 flex items-center gap-2 text-xs">
                            <span class="truncate text-muted-foreground">@record.Artist</span>
                            <span class="text-muted-foreground">&middot;</span>
                            <span class="tabular-nums text-muted-foreground">@record.Year</span>
                        </div>
                    </div>

                    @* Condition and value *@
                    <div class="shrink-0 text-right">
                        <span class="@Cn.Merge("font-medium text-xs", GetConditionColor(record.Condition))">
                            @record.Condition
                        </span>
                        <p class="mt-0.5 font-semibold text-xs tabular-nums">$@record.Value</p>
                    </div>

                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Values based on Discogs median &middot; Last updated Mar 2026
            </p>
        </div>

    </div>
</section>

@code {
    private record VinylRecord(string Id, string Artist, string Album, int Year, int Rpm, string Condition, int Value, string Color);

    private static readonly VinylRecord[] _records =
    [
        new("1", "Miles Davis",    "Kind of Blue",          1959, 33, "Near Mint",      285, "bg-blue-900"),
        new("2", "Fleetwood Mac",  "Rumours",               1977, 33, "Very Good Plus", 120, "bg-zinc-800"),
        new("3", "The Beatles",    "Abbey Road",            1969, 33, "Mint",           450, "bg-emerald-900"),
        new("4", "Stevie Wonder",  "Superstition",          1972, 45, "Very Good",       65, "bg-amber-900"),
        new("5", "Radiohead",      "OK Computer",           1997, 33, "Near Mint",      175, "bg-slate-800"),
        new("6", "Nina Simone",    "I Put a Spell on You",  1965, 33, "Good",            90, "bg-purple-900"),
    ];

    private static readonly int _totalRecords = _records.Length;
    private static readonly int _totalValue = _records.Sum(r => r.Value);

    private static string GetConditionColor(string condition) => condition switch
    {
        "Mint"           => "text-emerald-600 dark:text-emerald-400",
        "Near Mint"      => "text-emerald-600 dark:text-emerald-400",
        "Very Good Plus" => "text-amber-600 dark:text-amber-400",
        "Very Good"      => "text-amber-600 dark:text-amber-400",
        _                => "text-muted-foreground",
    };
}
