@* ============================================================
   Block: music-playlist-cover
   Title: MusicPlaylistCover
   Description: A playlist cover display block for React and Next.js with 2x2 album art grid, playlist title, track count, total duration, creator name, and shuffle play button built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-playlist-cover.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Album art grid *@
        <div class="border-b">
            <div class="grid grid-cols-2">
                @foreach (var cover in _albumCovers)
                {
                    <div class="@Cn.Merge("aspect-square", cover.Color)" aria-label="@cover.Label"></div>
                }
            </div>
        </div>

        @* Playlist info *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">@_playlistTitle</span>
            <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                <span class="flex items-center gap-1">
                    <LucideIconCn Name="user" Size="12" Class="size-3" />
                    @_creatorName
                </span>
                <span class="flex items-center gap-1">
                    <LucideIconCn Name="list-music" Size="12" Class="size-3" />
                    @_trackCount tracks
                </span>
                <span class="flex items-center gap-1">
                    <LucideIconCn Name="clock" Size="12" Class="size-3" />
                    @_totalDuration
                </span>
            </div>
        </div>

        @* Actions *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 flex-1 gap-1.5 text-xs">
                <LucideIconCn Name="shuffle" Size="12" Class="size-3" />
                Shuffle Play
            </ButtonCn>
            <ButtonCn Variant="@(_liked ? ButtonVariant.Default : ButtonVariant.Outline)"
                      Size="ButtonSize.Sm"
                      Class="h-8 gap-1.5 text-xs"
                      OnClick="@(() => _liked = !_liked)">
                <LucideIconCn Name="heart" Size="12" Class="@Cn.Merge("size-3", _liked ? "fill-current" : "")" />
                @(_liked ? "Liked" : "Like")
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-8 p-0">
                <LucideIconCn Name="share" Size="12" Class="size-3" />
            </ButtonCn>
        </div>

        @* Track list preview *@
        <div>
            @for (var i = 0; i < _tracks.Length; i++)
            {
                var track = _tracks[i];
                var isLast = i == _tracks.Length - 1;
                var index = i;
                <div class="@Cn.Merge("group flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <span class="w-5 text-center font-mono text-muted-foreground text-xs tabular-nums">
                        @(index + 1)
                    </span>
                    <div class="flex size-8 shrink-0 items-center justify-center rounded bg-muted/50">
                        <LucideIconCn Name="play" Size="12" Class="size-3 text-muted-foreground opacity-0 transition-opacity group-hover:opacity-100" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="block truncate text-sm">@track.Title</span>
                        <span class="block truncate text-muted-foreground text-xs">@track.Artist</span>
                    </div>
                    <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                        @track.Duration
                    </span>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between text-muted-foreground text-xs">
                <span class="flex items-center gap-1.5">
                    <LucideIconCn Name="heart" Size="12" Class="size-3" />
                    @_likeCount.ToString("N0") likes
                </span>
                <span>Updated 3 days ago</span>
            </div>
        </div>

    </div>
</section>

@code {
    private record AlbumCover(string Id, string Color, string Label);
    private record Track(string Id, string Title, string Artist, string Duration);

    private static readonly string _playlistTitle = "Late Night Drive";
    private static readonly string _creatorName = "Sarah M.";
    private static readonly string _totalDuration = "2 hr 14 min";
    private static readonly int _trackCount = 24;
    private static readonly int _likeCount = 1842;

    private static readonly AlbumCover[] _albumCovers =
    [
        new("1", "bg-zinc-800", "Album 1"),
        new("2", "bg-zinc-600", "Album 2"),
        new("3", "bg-zinc-700", "Album 3"),
        new("4", "bg-zinc-500", "Album 4"),
    ];

    private static readonly Track[] _tracks =
    [
        new("1", "Blinding Lights", "The Weeknd", "3:20"),
        new("2", "Midnight City", "M83", "4:02"),
        new("3", "Electric Feel", "MGMT", "3:49"),
        new("4", "Nightcall", "Kavinsky", "4:16"),
        new("5", "The Less I Know the Better", "Tame Impala", "3:36"),
    ];

    private bool _liked = false;
}
