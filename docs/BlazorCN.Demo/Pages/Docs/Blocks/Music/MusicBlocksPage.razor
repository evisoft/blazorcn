        [""am-pentatonic""] = new(""A Minor Pentatonic"", ""A"", [""A"",""C"",""D"",""E"",""G""],                [""1"",""b3"",""4"",""5"",""b7""],             ""Pentatonic""),
        [""c-blues""]      = new(""C Blues"",             ""C"", [""C"",""Eb"",""F"",""Gb"",""G"",""Bb""],         [""1"",""b3"",""4"",""b5"",""5"",""b7""],        ""Blues""),
    };

    private static readonly Dictionary<string, ChordInfo[]> _chordsByKey = new()
    {
        [""C""] =
