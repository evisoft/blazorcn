    private const string MusicChordChartCode = @"<section class=""mx-auto w-full max-w-2xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">

        @* Header *@
        <div class=""flex items-center justify-between border-b px-4 py-3"">
            <div class=""flex items-center gap-2"">
                <LucideIconCn Name=""music"" Size=""16"" Class=""size-4 text-muted-foreground"" />
                <span class=""font-medium text-sm"">Chord Progression</span>
            </div>
            <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""font-normal text-xs"">
                Key of @_selectedKey
            </BadgeCn>
        </div>

        @* Key selector *@
        <div class=""border-b px-4 py-3"">
            <span class=""mb-2 block font-medium text-muted-foreground text-xs"">Key</span>
            <div class=""flex flex-wrap items-center gap-1"">
                @foreach (var k in _keys)
                {
                    var key = k;
                    <ButtonCn Variant=""ButtonVariant.Outline""
                              Size=""ButtonSize.Sm""
                              Class=""@Cn.Merge(""h-7 px-2.5 font-mono text-xs"", _selectedKey == key ? ""ring-2 ring-foreground"" : """")""
                              OnClick=""@(() => _selectedKey = key)"">
                        @key
                    </ButtonCn>
                }
            </div>
        </div>

        @* Chord diagrams *@
        <div class=""border-b px-4 py-4"">
            <div class=""grid grid-cols-4 gap-4"">
                @foreach (var ch in TransposedChords)
                {
                    var chord = ch;
                    <div class=""flex justify-center"">
                        <div class=""flex flex-col items-center"">
                            <span class=""mb-2 font-medium text-sm"">
                                @chord.Name
                                @if (!string.IsNullOrEmpty(chord.Suffix))
                                {
                                    <span class=""text-muted-foreground"">@chord.Suffix</span>
                                }
                            </span>
                            <div class=""relative"">
                                @* String indicators (open / muted) *@
                                <div class=""mb-1 flex justify-between"" style=""width:60px"">
                                    @for (int i = 0; i < chord.Frets.Length; i++)
                                    {
                                        var fret = chord.Frets[i];
                                        <span class=""w-2.5 text-center font-mono text-muted-foreground text-xs"">
                                            @(fret == -1 ? ""x"" : fret == 0 ? ""o"" : """")
                                        </span>
                                    }
                                </div>
                                @* Fretboard grid *@
                                @{
                                    var maxFret = 0;
                                    foreach (var f in chord.Frets) { if (f > maxFret) maxFret = f; }
                                    var startFret = maxFret > 4 ? maxFret - 3 : 1;
                                    const int fretCount = 4;
                                    const int stringCount = 6;
                                }
                                <div class=""relative rounded-sm border border-foreground/20"" style=""width:60px;height:80px"">
                                    @* Nut line *@
                                    @if (startFret == 1)
                                    {
                                        <div class=""absolute inset-x-0 top-0 h-0.5 bg-foreground""></div>
                                    }
                                    @* Horizontal fret lines *@
                                    @for (int fretIdx = 0; fretIdx < fretCount; fretIdx++)
                                    {
                                        var pct = ((fretIdx + 1) * 100 / fretCount);
                                        <div class=""absolute inset-x-0 border-t border-foreground/15""
                                             style=""@($""top:{pct}%"")""></div>
                                    }
                                    @* Vertical string lines *@
                                    @for (int strIdx = 0; strIdx < stringCount; strIdx++)
                                    {
                                        var lpct = strIdx == 0 ? 0 : (strIdx * 100 / (stringCount - 1));
                                        <div class=""absolute inset-y-0 border-l border-foreground/15""
                                             style=""@($""left:{lpct}%"")""></div>
                                    }
                                    @* Finger dots *@
                                    @for (int strIdx = 0; strIdx < chord.Frets.Length; strIdx++)
                                    {
                                        var fv = chord.Frets[strIdx];
                                        if (fv > 0)
                                        {
                                            var relativeFret = fv - startFret;
                                            if (relativeFret >= 0 && relativeFret < fretCount)
                                            {
                                                var dotLeft = strIdx == 0 ? 0 : (strIdx * 100 / (stringCount - 1));
                                                var dotTop = (int)Math.Round((relativeFret + 0.5) * 100.0 / fretCount);
                                                <div class=""absolute size-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-foreground""
                                                     style=""@($""left:{dotLeft}%;top:{dotTop}%"")""></div>
                                            }
                                        }
                                    }
                                    @* Starting fret number *@
                                    @if (startFret > 1)
                                    {
                                        <span class=""-left-5 absolute top-1 font-mono text-muted-foreground text-xs"">@startFret</span>
                                    }
                                </div>
                            </div>
                            @* Strum pattern *@
                            <div class=""mt-2 flex gap-0.5"">
                                @foreach (var s in chord.StrumPattern.Split(' '))
                                {
                                    var strum = s;
                                    <span class=""flex size-5 items-center justify-center font-mono text-muted-foreground text-xs"">
                                        @if (strum == ""D"")
                                        {
                                            <LucideIconCn Name=""chevron-down"" Size=""12"" Class=""size-3"" />
                                        }
                                        else
                                        {
                                            <LucideIconCn Name=""chevron-up"" Size=""12"" Class=""size-3"" />
                                        }
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Progression notation *@
        <div class=""border-b px-4 py-3"">
            <span class=""mb-2 block font-medium text-muted-foreground text-xs"">Progression</span>
            <div class=""flex items-center gap-2"">
                @{ var transposed = TransposedChords; }
                @for (int pi = 0; pi < transposed.Length; pi++)
                {
                    var pc = transposed[pi];
                    var showArrow = pi < transposed.Length - 1;
                    <span class=""flex items-center gap-2"">
                        <span class=""rounded-md bg-muted/50 px-2.5 py-1 font-mono text-sm"">
                            @pc.Name@pc.Suffix
                        </span>
                        @if (showArrow)
                        {
                            <span class=""text-muted-foreground text-xs"">&#8594;</span>
                        }
                    </span>
                }
            </div>
        </div>

        @* Transpose controls *@
        <div class=""flex items-center justify-between px-4 py-3"">
            <span class=""font-medium text-muted-foreground text-xs"">Transpose</span>
            <div class=""flex items-center gap-2"">
                <ButtonCn Variant=""ButtonVariant.Outline""
                          Size=""ButtonSize.Sm""
                          Class=""size-7 p-0""
                          OnClick=""@(() => _transpose--)""
                          aria-label=""Transpose down"">
                    <LucideIconCn Name=""minus"" Size=""12"" Class=""size-3"" />
                </ButtonCn>
                <span class=""w-12 text-center font-mono text-sm tabular-nums"">
                    @(_transpose > 0 ? $""+{_transpose}"" : _transpose.ToString())
                </span>
                <ButtonCn Variant=""ButtonVariant.Outline""
                          Size=""ButtonSize.Sm""
                          Class=""size-7 p-0""
                          OnClick=""@(() => _transpose++)""
                          aria-label=""Transpose up"">
                    <LucideIconCn Name=""plus"" Size=""12"" Class=""size-3"" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record ChordData(string Name, string Suffix, int[] Frets, int? BarFret, string StrumPattern);

    private static readonly string[] _chromaticScale = [""C"", ""C#"", ""D"", ""D#"", ""E"", ""F"", ""F#"", ""G"", ""G#"", ""A"", ""A#"", ""B""];

    private static readonly ChordData[] _baseChords =
    [
        new(""A"", ""m"", [-1, 0, 2, 2, 1, 0], null,  ""D D U D U""),
        new(""G"", """",  [3, 2, 0, 0, 0, 3],  null,  ""D D U U D U""),
        new(""C"", """",  [-1, 3, 2, 0, 1, 0], null,  ""D D U D U""),
        new(""F"", """",  [1, 1, 2, 3, 3, 1],  1,     ""D U D U D U""),
    ];

    private static readonly string[] _keys = [""C"", ""G"", ""D"", ""A"", ""E"", ""F"", ""Bb"", ""Eb""];

    private string _selectedKey = ""C"";
    private int _transpose = 0;

    private static string TransposeNote(string note, int semitones)
    {
        var idx = Array.IndexOf(_chromaticScale, note);
        if (idx == -1) return note;
        var newIdx = ((idx + semitones) % 12 + 12) % 12;
        return _chromaticScale[newIdx];
    }

    private ChordData[] TransposedChords =>
        Array.ConvertAll(_baseChords, c => c with { Name = TransposeNote(c.Name, _transpose) });
}";

