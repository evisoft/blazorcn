                        </ButtonCn>
                    }
                </div>
            </div>

            @* Chat sidebar *@
            @if (_showChat)
            {
                <div class=""flex w-72 flex-col"">
                    <div class=""border-b px-3 py-2.5"">
                        <span class=""text-xs font-medium text-muted-foreground"">Chat</span>
