                @CurrentScale.Type
            </BadgeCn>
        </div>

        @* Scale selector *@
        <div class=""flex flex-wrap items-center gap-1 border-b px-4 py-3"">
            @foreach (var sk in _scaleKeys)
            {
                var scaleKey = sk;
                <ButtonCn Variant=""ButtonVariant.Ghost""
                          Size=""ButtonSize.Sm""
                          Class=""@Cn.Merge(""h-7 text-xs"", _selectedScale == scaleKey ? ""bg-muted shadow-sm"" : ""text-muted-foreground"")""
                          OnClick=""@(() => _selectedScale = scaleKey)"">
                    @_scaleData[scaleKey].Name
                </ButtonCn>
            }
        </div>

        @* Scale notes display *@
        <div class=""border-b px-4 py-4"">
            <span class=""mb-3 block font-medium text-muted-foreground text-xs"">Scale Notes</span>
            <div class=""flex flex-wrap items-center gap-2"">
                @for (int i = 0; i < CurrentScale.Notes.Length; i++)
                {
                    var note = CurrentScale.Notes[i];
                    var interval = CurrentScale.Intervals[i];
                    var isFirst = i == 0;
                    <div class=""flex flex-col items-center gap-1"">
                        <div class=""@Cn.Merge(""flex size-10 items-center justify-center rounded-md border"", isFirst ? ""border-foreground/30 bg-foreground/5"" : ""bg-muted/50"")"">
                            <span class=""font-medium text-sm"">@note</span>
                        </div>
                        <span class=""font-mono text-muted-foreground text-xs"">@interval</span>
                    </div>
                }
            </div>
        </div>

        @* Chord construction *@
        <div class=""border-b px-4 py-4"">
            <span class=""mb-3 block font-medium text-muted-foreground text-xs"">
                Diatonic Chords in @CurrentScale.Key
            </span>
            <div class=""space-y-1"">
                @foreach (var ch in CurrentChords)
                {
                    var chord = ch;
                    <div class=""flex items-center gap-3 rounded-md px-2 py-1.5 transition-colors hover:bg-muted/50"">
                        <span class=""w-14 font-medium text-sm"">@chord.Symbol</span>
                        <span class=""flex-1 font-mono text-muted-foreground text-xs"">@chord.Notes</span>
                        <span class=""@ChordQualityClass(chord.Quality) text-xs"">@chord.Quality</span>
                    </div>
                }
            </div>
        </div>

        @* Circle of fifths simplified *@
        <div class=""px-4 py-4"">
            <span class=""mb-3 block font-medium text-muted-foreground text-xs"">
                Circle of Fifths
            </span>
            <div class=""flex flex-wrap items-center gap-1.5"">
                @foreach (var cfKey in _circleOfFifths)
                {
                    var cof = cfKey;
                    var isCurrentKey = cof == CurrentScale.Key;
                    <div class=""@Cn.Merge(""flex h-8 items-center justify-center rounded-md border px-2.5"", isCurrentKey ? ""border-foreground/30 bg-foreground/5"" : ""bg-muted/30"")"">
                        <span class=""@Cn.Merge(""font-mono text-xs"", isCurrentKey ? ""font-medium"" : ""text-muted-foreground"")"">@cof</span>
                    </div>
                }
            </div>
            <p class=""mt-3 text-muted-foreground text-xs"">
                Each step clockwise moves up a perfect fifth &middot; Adjacent keys share 6 of 7 notes
            </p>
        </div>

    </div>
</section>

@code {
    private record ScaleInfo(string Name, string Key, string[] Notes, string[] Intervals, string Type);
