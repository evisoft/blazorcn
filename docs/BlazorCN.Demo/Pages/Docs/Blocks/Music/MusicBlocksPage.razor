        [""A""] =
        [
            new(""A Minor"",      ""Am"",    ""A C E"",   ""Minor""),
            new(""B Diminished"", ""Bdim"",  ""B D F"",   ""Dim""),
            new(""C Major"",      ""C"",     ""C E G"",   ""Major""),
            new(""D Minor"",      ""Dm"",    ""D F A"",   ""Minor""),
            new(""E Minor"",      ""Em"",    ""E G B"",   ""Minor""),
            new(""F Major"",      ""F"",     ""F A C"",   ""Major""),
            new(""G Major"",      ""G"",     ""G B D"",   ""Major""),
        ],
        [""G""] =
        [
            new(""G Major"",       ""G"",     ""G B D"",   ""Major""),
            new(""A Minor"",       ""Am"",    ""A C E"",   ""Minor""),
            new(""B Minor"",       ""Bm"",    ""B D F#"",  ""Minor""),
            new(""C Major"",       ""C"",     ""C E G"",   ""Major""),
            new(""D Major"",       ""D"",     ""D F# A"",  ""Major""),
            new(""E Minor"",       ""Em"",    ""E G B"",   ""Minor""),
            new(""F# Diminished"", ""F#dim"", ""F# A C"",  ""Dim""),
        ],
    };

    private static readonly string[] _circleOfFifths = [""C"",""G"",""D"",""A"",""E"",""B"",""F#/Gb"",""Db"",""Ab"",""Eb"",""Bb"",""F""];
    private static readonly string[] _scaleKeys = [""c-major"",""a-minor"",""g-major"",""am-pentatonic"",""c-blues""];

    private string _selectedScale = ""c-major"";

    private ScaleInfo CurrentScale => _scaleData[_selectedScale];

    private ChordInfo[] CurrentChords =>
        _chordsByKey.TryGetValue(CurrentScale.Key, out var chords) ? chords : _chordsByKey[""C""];

    private static string ChordQualityClass(string quality) => quality switch
    {
        ""Major"" => ""text-emerald-600 dark:text-emerald-400"",
