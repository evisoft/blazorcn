                    <div class=""border-t px-3 py-2.5"">
                        <div class=""flex items-center gap-2"">
                            <InputCn @bind-Value=""_message""
                                     Placeholder=""Type a message...""
                                     aria-label=""Type a message""
                                     Class=""h-7 border-0 bg-transparent px-0 text-xs shadow-none focus-visible:ring-0"" />
                            <ButtonCn aria-label=""Send chat message"" Variant=""ButtonVariant.Ghost"" Size=""ButtonSize.Sm"" Class=""h-6 shrink-0 px-1.5"">
                                <LucideIconCn Name=""send"" Size=""12"" Class=""size-3"" />
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

