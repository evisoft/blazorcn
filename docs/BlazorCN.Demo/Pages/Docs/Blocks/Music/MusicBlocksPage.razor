@code {
    private record ProductColor(string Name, string Hex);

    private record Product(
        string Id,
        string Name,
        int Price,
        string[] Sizes,
        ProductColor[] Colors,
        string Category
    );

    private record CartItem(string ProductId, string Size, string Color, int Quantity);

    private static readonly Product[] _products =
    [
        new(""tshirt"", ""Tour T-Shirt"", 35,
            [""S"", ""M"", ""L"", ""XL"", ""XXL""],
            [new(""Black"", ""#171717""), new(""White"", ""#fafafa""), new(""Navy"", ""#1e3a5f"")],
            ""Apparel""),
        new(""hoodie"", ""Logo Hoodie"", 65,
            [""S"", ""M"", ""L"", ""XL""],
            [new(""Black"", ""#171717""), new(""Charcoal"", ""#404040"")],
            ""Apparel""),
        new(""poster"", ""Limited Poster"", 25,
            [""18x24"", ""24x36""],
            [new(""Matte"", ""#e5e5e5""), new(""Glossy"", ""#fafafa"")],
            ""Print""),
        new(""vinyl"", ""Deluxe Vinyl"", 40,
            [""Standard"", ""Deluxe""],
            [new(""Black"", ""#171717""), new(""Clear"", ""#d4d4d8""), new(""Red"", ""#dc2626"")],
            ""Music""),
        new(""cap"", ""Embroidered Cap"", 28,
            [""One Size""],
            [new(""Black"", ""#171717""), new(""Tan"", ""#d2b48c"")],
            ""Apparel""),
    ];

    private Dictionary<string, string> _selectedSizes = InitSelectedSizes();
    private Dictionary<string, string> _selectedColors = InitSelectedColors();
    private List<CartItem> _cart = new();
    private string? _addedFeedback = null;

    private static Dictionary<string, string> InitSelectedSizes()
    {
        var d = new Dictionary<string, string>();
        foreach (var p in _products)
            d[p.Id] = p.Sizes.Length > 0 ? p.Sizes[0] : """";
        return d;
    }

    private static Dictionary<string, string> InitSelectedColors()
    {
        var d = new Dictionary<string, string>();
        foreach (var p in _products)
            d[p.Id] = p.Colors.Length > 0 ? p.Colors[0].Name : """";
        return d;
    }

    private int _cartTotal => _cart.Aggregate(0, (sum, item) =>
    {
        var prod = System.Array.Find(_products, p => p.Id == item.ProductId);
        return sum + (prod?.Price ?? 0) * item.Quantity;
    });

    private int _cartCount => _cart.Sum(item => item.Quantity);

    private void SelectSize(string productId, string size)
    {
        _selectedSizes[productId] = size;
    }

    private void SelectColor(string productId, string colorName)
    {
        _selectedColors[productId] = colorName;
    }

    private System.Timers.Timer? _feedbackTimer;

    private void AddToCart(Product product)
    {
        var size = _selectedSizes.TryGetValue(product.Id, out var s) ? s : (product.Sizes.Length > 0 ? product.Sizes[0] : """");
        var color = _selectedColors.TryGetValue(product.Id, out var c) ? c : (product.Colors.Length > 0 ? product.Colors[0].Name : """");

        var existing = _cart.Find(item => item.ProductId == product.Id && item.Size == size && item.Color == color);
        if (existing != null)
        {
            var idx = _cart.IndexOf(existing);
            _cart[idx] = existing with { Quantity = existing.Quantity + 1 };
        }
        else
        {
            _cart.Add(new CartItem(product.Id, size, color, 1));
        }

        _addedFeedback = product.Id;

        _feedbackTimer?.Dispose();
        _feedbackTimer = new System.Timers.Timer(1500) { AutoReset = false };
        _feedbackTimer.Elapsed += (_, _) =>
        {
            _addedFeedback = null;
            InvokeAsync(StateHasChanged);
        };
        _feedbackTimer.Start();
    }
}";

