    private class Performer
    {
        public string Id { get; init; } = """";
        public string Name { get; init; } = """";
        public string Song { get; init; } = """";
        public string TimeSlot { get; init; } = """";
        public int Votes { get; set; }
        public string Status { get; init; } = """";

        public Performer(string id, string name, string song, string timeSlot, int votes, string status)
        {
            Id = id; Name = name; Song = song; TimeSlot = timeSlot; Votes = votes; Status = status;
        }
    }

    private List<Performer> _performers =
    [
        new(""p1"", ""Sarah Chen"",   ""Hallelujah — Leonard Cohen"",        ""8:00 PM"", 24, ""performing""),
        new(""p2"", ""Marcus Reid"",  ""Wonderwall — Oasis"",                 ""8:15 PM"", 18, ""waiting""),
        new(""p3"", ""Aiko Tanaka"",  ""Fly Me to the Moon — Sinatra"",       ""8:30 PM"", 12, ""waiting""),
        new(""p4"", ""Dev Patel"",    ""Original — Untitled Ballad"",         ""8:45 PM"",  9, ""waiting""),
        new(""p5"", ""Luna Reyes"",   ""Fast Car — Tracy Chapman"",           ""9:00 PM"", 15, ""waiting""),
    ];

    private string _newName = """";
    private string _newSong = """";
    private bool _showSignup = false;

    private void HandleVote(string id)
    {
        var p = _performers.Find(x => x.Id == id);
        if (p != null) p.Votes++;
    }

    private void HandleSignup()
    {
        if (string.IsNullOrWhiteSpace(_newName) || string.IsNullOrWhiteSpace(_newSong))
            return;

        var waitingList = _performers.FindAll(p => p.Status == ""waiting"");
        var nextSlotMinute = (waitingList.Count + 1) * 15;
        var hour = 9 + nextSlotMinute / 60;
        var minute = nextSlotMinute % 60;
        var timeSlot = $""{hour}:{minute:D2} PM"";

        _performers.Add(new Performer(
            $""p{_performers.Count + 1}"",
            _newName.Trim(),
            _newSong.Trim(),
            timeSlot,
            0,
            ""waiting""
        ));
        _newName = """";
        _newSong = """";
        _showSignup = false;
    }
}";

