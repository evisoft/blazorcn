                            Consistent volume level across all tracks
                        </p>
                    </div>
                    <SwitchCn Checked=""@_loudnessNorm"" CheckedChanged=""@((bool v) => { _loudnessNorm = v; })"" aria-label=""Loudness Normalization"" />
                </div>
            </div>
        </div>

        @* Crossfade *@
        <div class=""flex items-center justify-between border-b px-4 py-3"">
            <div>
                <span class=""font-medium text-sm"">Crossfade</span>
                <p class=""text-muted-foreground text-xs"">Smooth transition between tracks</p>
            </div>
            <div class=""flex items-center gap-1 rounded-md bg-muted/50 p-0.5"">
                @foreach (var opt in _crossfadeOptions)
                {
                    var option = opt;
                    <ButtonCn Variant=""ButtonVariant.Ghost""
                              Size=""ButtonSize.Sm""
                              Class=""@Cn.Merge(""h-6 px-2 text-xs"", _crossfade == option.Value ? ""bg-background shadow-sm"" : ""text-muted-foreground"")""
                              OnClick=""@(() => _crossfade = option.Value)"">
                        @option.Label
                    </ButtonCn>
                }
            </div>
        </div>

        @* Output Device *@
        <div class=""flex items-center justify-between px-4 py-3"">
            <div>
                <span class=""font-medium text-sm"">Output Device</span>
                <p class=""text-muted-foreground text-xs"">Select audio output destination</p>
            </div>
            <SelectCn Value=""@_outputDevice"" ValueChanged=""@((string? v) => SetOutputDevice(v))"">
                <SelectTriggerCn aria-label=""Output device"" Class=""h-7 w-[180px] text-xs"">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var dev in _outputDevices)
                    {
                        var device = dev;
                        <SelectItemCn Value=""@device.Value"" Class=""text-xs"">@device.Label</SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
        </div>

    </div>
</section>

