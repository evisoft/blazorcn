@code {
    private class EffectParam
    {
        public string Name { get; set; } = """";
        public int Min { get; set; }
        public int Max { get; set; }
        public int Value { get; set; }
        public string Unit { get; set; } = """";
    }

    private class AudioEffect
    {
        public string Id { get; set; } = """";
        public string Name { get; set; } = """";
        public bool Enabled { get; set; }
        public int WetDry { get; set; }
        public List<EffectParam> Params { get; set; } = new();
    }

    private List<AudioEffect> _effects =
    [
        new AudioEffect { Id = ""reverb"",     Name = ""Reverb"",     Enabled = true,  WetDry = 40,  Params = [new EffectParam { Name = ""Decay"",     Min = 0,   Max = 10,   Value = 3,   Unit = ""s""  }, new EffectParam { Name = ""Pre-Delay"", Min = 0,   Max = 100, Value = 20,  Unit = ""ms"" }] },
        new AudioEffect { Id = ""delay"",      Name = ""Delay"",      Enabled = true,  WetDry = 30,  Params = [new EffectParam { Name = ""Time"",      Min = 0,   Max = 1000, Value = 375, Unit = ""ms"" }, new EffectParam { Name = ""Feedback"",  Min = 0,   Max = 100, Value = 45,  Unit = ""%"" }]  },
        new AudioEffect { Id = ""chorus"",     Name = ""Chorus"",     Enabled = false, WetDry = 50,  Params = [new EffectParam { Name = ""Rate"",      Min = 0,   Max = 20,   Value = 4,   Unit = ""Hz"" }, new EffectParam { Name = ""Depth"",     Min = 0,   Max = 100, Value = 60,  Unit = ""%"" }]  },
        new AudioEffect { Id = ""distortion"", Name = ""Distortion"", Enabled = false, WetDry = 25,  Params = [new EffectParam { Name = ""Drive"",     Min = 0,   Max = 100,  Value = 55,  Unit = ""%"" }, new EffectParam { Name = ""Tone"",      Min = 0,   Max = 100, Value = 70,  Unit = ""%"" }]  },
        new AudioEffect { Id = ""compressor"", Name = ""Compressor"", Enabled = true,  WetDry = 100, Params = [new EffectParam { Name = ""Threshold"", Min = -60, Max = 0,    Value = -18, Unit = ""dB"" }, new EffectParam { Name = ""Ratio"",     Min = 1,   Max = 20,  Value = 4,   Unit = "":1"" }] },
    ];

    private Dictionary<string, bool> _expanded = new();

    private int ActiveCount => _effects.Count(e => e.Enabled);

    private void ToggleExpanded(string id, bool currentlyExpanded)
    {
        _expanded[id] = !currentlyExpanded;
    }

    private void ToggleEffect(string id)
    {
        var effect = _effects.FirstOrDefault(e => e.Id == id);
        if (effect is not null)
        {
            effect.Enabled = !effect.Enabled;
            // If we just disabled it, collapse it too
            if (!effect.Enabled)
                _expanded[id] = false;
        }
    }

    private void UpdateWetDry(string id, int value)
    {
        var effect = _effects.FirstOrDefault(e => e.Id == id);
        if (effect is not null)
            effect.WetDry = value;
    }

    private void UpdateParam(string id, int paramIndex, int value)
    {
        var effect = _effects.FirstOrDefault(e => e.Id == id);
        if (effect is not null && paramIndex < effect.Params.Count)
            effect.Params[paramIndex].Value = value;
    }
}";

