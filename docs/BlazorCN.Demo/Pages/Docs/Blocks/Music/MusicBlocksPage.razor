        Album: ""Hurry Up, We're Dreaming"",
        Duration: 244
    );

    private static readonly Track[] _recentlyPlayed =
    [
        new(""r1"", ""Instant Crush"", ""Daft Punk ft. Julian Casablancas"", ""Random Access Memories"", 337),
        new(""r2"", ""Dreams"", ""Fleetwood Mac"", ""Rumours"", 254),
        new(""r3"", ""Borderline"", ""Tame Impala"", ""The Slow Rush"", 237),
    ];

    private List<Track> _queue =
    [
        new(""q1"", ""Tadow"", ""Masego & FKJ"", ""Masego"", 312),
        new(""q2"", ""Redbone"", ""Childish Gambino"", ""Awaken, My Love!"", 327),
        new(""q3"", ""Electric Feel"", ""MGMT"", ""Oracular Spectacular"", 229),
        new(""q4"", ""Let It Happen"", ""Tame Impala"", ""Currents"", 468),
        new(""q5"", ""Do I Wanna Know?"", ""Arctic Monkeys"", ""AM"", 272),
    ];

    private int _totalSeconds => _queue.Sum(t => t.Duration);

    private static string FormatDuration(int seconds)
    {
        int h = seconds / 3600;
        int m = (seconds % 3600) / 60;
        int s = seconds % 60;
        if (h > 0)
            return $""{h}:{m:D2}:{s:D2}"";
        return $""{m}:{s:D2}"";
    }

    private static string FormatTotalTime(int seconds)
    {
        int h = seconds / 3600;
        int m = (seconds % 3600) / 60;
        if (h > 0)
            return $""{h} hr {m} min"";
        return $""{m} min"";
    }

    private void RemoveTrack(string id)
    {
        _queue = _queue.Where(t => t.Id != id).ToList();
    }

    private void ClearQueue()
    {
        _queue = [];
    }
}";

