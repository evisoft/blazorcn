            </div>
        </div>

        @* Transport controls *@
        <div class=""flex items-center gap-4 border-b px-4 py-3"">
            <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm"" Class=""size-8 p-0""
                      OnClick=""@(() => _playing = !_playing)""
                      aria-label=""@(_playing ? ""Stop playback"" : ""Start playback"")"">
                @if (_playing)
                {
                    <LucideIconCn Name=""pause"" Size=""14"" Class=""size-3.5"" />
                }
