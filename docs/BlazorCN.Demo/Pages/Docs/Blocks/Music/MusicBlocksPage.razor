@code {
    private record Preset(string Label, int Minutes);

    private static readonly Preset[] _presets =
    [
        new(""15 min"", 15),
        new(""30 min"", 30),
        new(""45 min"", 45),
        new(""1 hr"",   60),
    ];

    private string _timerState = ""idle"";  // ""idle"" | ""running"" | ""end-of-track""
    private int _totalSeconds = 0;
    private int _remainingSeconds = 0;
    private bool _fadeOut = true;
    private string _customMinutes = """";
    private System.Threading.Timer? _timer;

    private int DisplayMinutes => _remainingSeconds / 60;
    private int DisplaySeconds => _remainingSeconds % 60;
    private double Progress => _totalSeconds > 0 ? ((double)(_totalSeconds - _remainingSeconds) / _totalSeconds) * 100.0 : 0.0;

    private void StartTimer(int minutes)
    {
        StopInternalTimer();
        var seconds = minutes * 60;
        _totalSeconds = seconds;
        _remainingSeconds = seconds;
        _timerState = ""running"";
        _timer = new System.Threading.Timer(Tick, null, 1000, 1000);
    }

    private void Tick(object? state)
    {
        if (_remainingSeconds <= 1)
        {
            StopInternalTimer();
            _remainingSeconds = 0;
            _totalSeconds = 0;
            _timerState = ""idle"";
        }
        else
        {
            _remainingSeconds--;
        }
        InvokeAsync(StateHasChanged);
    }

    private void StopInternalTimer()
    {
        _timer?.Dispose();
        _timer = null;
    }

    private void CancelTimer()
    {
        StopInternalTimer();
        _timerState = ""idle"";
        _remainingSeconds = 0;
        _totalSeconds = 0;
        _customMinutes = """";
    }

    private void HandleEndOfTrack()
    {
        if (_timerState == ""end-of-track"")
        {
            _timerState = ""idle"";
        }
        else
        {
            CancelTimer();
            _timerState = ""end-of-track"";
        }
    }

    private void HandleCustomStart()
    {
        if (int.TryParse(_customMinutes, out int mins) && mins > 0 && mins <= 480)
        {
            StartTimer(mins);
            _customMinutes = """";
        }
    }

    public void Dispose()
    {
        StopInternalTimer();
    }
}";

