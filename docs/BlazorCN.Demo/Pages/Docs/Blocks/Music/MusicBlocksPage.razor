    private const string MusicWaveformEditorCode = @"<section class=""mx-auto w-full max-w-2xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">

        @* Header *@
        <div class=""flex items-center justify-between border-b px-4 py-3"">
            <div class=""flex items-center gap-2"">
                <LucideIconCn Name=""scissors"" Size=""16"" Class=""size-4 text-muted-foreground"" />
                <span class=""font-medium text-sm"">@_trackName</span>
            </div>
            <div class=""flex items-center gap-2"">
                <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""font-normal text-xs"">
                    WAV 48kHz
                </BadgeCn>
                <span class=""font-mono text-muted-foreground text-xs"">@FormatTime(_trackDuration)</span>
            </div>
        </div>

        @* Waveform display *@
        <div class=""border-b px-4 py-4"">
            <div class=""relative flex h-24 items-end gap-px"">

                @* Selection region highlight *@
                <div class=""pointer-events-none absolute bottom-0 top-0 bg-foreground/5""
                     style=""@($""left:{(_trimStart / (double)_totalBars) * 100}%;width:{((_trimEnd - _trimStart) / (double)_totalBars) * 100}%"")"">
                </div>

                @* Trim start marker *@
                <div class=""absolute bottom-0 top-0 z-10 w-0.5 bg-foreground""
                     style=""@($""left:{(_trimStart / (double)_totalBars) * 100}%"")"">
                    <div class=""absolute -left-1 -top-1 size-2 rounded-sm bg-foreground""></div>
                    <div class=""absolute -left-1 -bottom-1 size-2 rounded-sm bg-foreground""></div>
                </div>

                @* Trim end marker *@
                <div class=""absolute bottom-0 top-0 z-10 w-0.5 bg-foreground""
                     style=""@($""left:{(_trimEnd / (double)_totalBars) * 100}%"")"">
                    <div class=""absolute -right-1 -top-1 size-2 rounded-sm bg-foreground""></div>
                    <div class=""absolute -right-1 -bottom-1 size-2 rounded-sm bg-foreground""></div>
                </div>

                @* Playhead *@
                <div class=""absolute bottom-0 top-0 z-20 w-0.5 bg-red-500""
                     style=""@($""left:{(_playheadPosition / (double)_totalBars) * 100}%"")"">
                    <div class=""absolute -left-1 -top-1.5 size-0 border-4 border-transparent border-t-red-500""></div>
                </div>

                @* Waveform bars — presentation only. They used to be one <button> each:
                   40 tab stops named ""Waveform bar 7"", each ~5px wide, which fails
                   WCAG 2.5.8 target size and is unusable by touch and screen readers.
                   Seeking now lives on the single range input below, which covers the
                   whole waveform, so the pointer target is the full 96px-tall strip. *@
                <div class=""absolute inset-0 flex items-end gap-px""
                     role=""img""
                     aria-label=""Audio waveform"">
                @for (var i = 0; i < _waveformData.Length; i++)
                {
                    var amplitude = _waveformData[i];
                    var isInSelection = i >= _trimStart && i <= _trimEnd;
                    var isAtPlayhead = i == _playheadPosition;
                    var barClass = isAtPlayhead
                        ? ""flex-1 rounded-t-sm transition-colors bg-red-500""
                        : isInSelection
                            ? ""flex-1 rounded-t-sm transition-colors bg-foreground/60""
                            : ""flex-1 rounded-t-sm transition-colors bg-muted-foreground/20"";
                    <div class=""@barClass"" style=""@($""height:{amplitude * 100}%;min-height:2px"")""></div>
                }
                </div>

                @* Seek control: transparent, fills the waveform, keeps arrow-key support.
                   The visible playhead above reflects its value, so the native thumb is
                   hidden while the input itself stays focusable and hit-testable. *@
                <input type=""range""
                       class=""absolute inset-0 z-30 h-full w-full cursor-pointer appearance-none bg-transparent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring [&::-moz-range-thumb]:opacity-0 [&::-webkit-slider-thumb]:h-full [&::-webkit-slider-thumb]:w-1 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:opacity-0""
                       min=""@_trimStart""
                       max=""@_trimEnd""
                       step=""1""
                       value=""@_playheadPosition""
                       @oninput=""HandleSeek""
                       aria-label=""Playhead position""
                       aria-valuetext=""@FormatTime(_playheadTime)"" />
            </div>

            @* Time markers *@
            <div class=""mt-2 flex items-center justify-between"">
                <span class=""font-mono text-muted-foreground text-xs"">@FormatTime(_trimStartTime)</span>
                <span class=""font-mono text-muted-foreground text-xs"">@FormatTime(_playheadTime)</span>
                <span class=""font-mono text-muted-foreground text-xs"">@FormatTime(_trimEndTime)</span>
            </div>
        </div>

        @* Trim info *@
        <div class=""flex items-center justify-between border-b px-4 py-3"">
            <div class=""flex items-center gap-3 text-muted-foreground text-xs"">
                <span class=""flex items-center gap-1.5"">
                    <span class=""size-1.5 rounded-full bg-foreground""></span>
                    Selection: @FormatTime(_selectionDuration)
                </span>
                <span>&middot;</span>
                <span>@FormatTime(_trimStartTime) &ndash; @FormatTime(_trimEndTime)</span>
            </div>
            <div class=""flex items-center gap-1"">
                <ButtonCn Variant=""ButtonVariant.Ghost""
                          Size=""ButtonSize.Sm""
                          Class=""size-7 p-0""
                          OnClick=""@(() => { _trimStart = Math.Max(0, _trimStart - 4); })""
                          aria-label=""Move trim start earlier"">
                    <LucideIconCn Name=""skip-back"" Size=""12"" Class=""size-3"" />
                </ButtonCn>
                <ButtonCn Variant=""ButtonVariant.Ghost""
                          Size=""ButtonSize.Sm""
                          Class=""size-7 p-0""
                          OnClick=""@(() => { _trimEnd = Math.Min(_totalBars - 1, _trimEnd + 4); })""
                          aria-label=""Move trim end later"">
                    <LucideIconCn Name=""skip-forward"" Size=""12"" Class=""size-3"" />
                </ButtonCn>
            </div>
        </div>

        @* Controls toolbar *@
        <div class=""flex items-center justify-between px-4 py-3"">
            <div class=""flex items-center gap-1"">
                <ButtonCn Variant=""ButtonVariant.Outline""
                          Size=""ButtonSize.Sm""
                          Class=""size-7 p-0""
                          OnClick=""@(() => { _isPlaying = !_isPlaying; })""
                          aria-label=""@(_isPlaying ? ""Pause"" : ""Play"")"">
                    @if (_isPlaying)
                    {
                        <LucideIconCn Name=""pause"" Size=""12"" Class=""size-3"" />
                    }
                    else
                    {
                        <LucideIconCn Name=""play"" Size=""12"" Class=""size-3"" />
                    }
                </ButtonCn>
                <ButtonCn Variant=""ButtonVariant.Ghost""
                          Size=""ButtonSize.Sm""
                          Class=""size-7 p-0""
                          OnClick=""@(() => { _zoom = Math.Max(1, _zoom - 1); })""
                          aria-label=""Zoom out"">
                    <LucideIconCn Name=""zoom-out"" Size=""12"" Class=""size-3"" />
                </ButtonCn>
                <span class=""w-8 text-center font-mono text-muted-foreground text-xs"">@(_zoom)x</span>
                <ButtonCn Variant=""ButtonVariant.Ghost""
                          Size=""ButtonSize.Sm""
                          Class=""size-7 p-0""
                          OnClick=""@(() => { _zoom = Math.Min(8, _zoom + 1); })""
                          aria-label=""Zoom in"">
                    <LucideIconCn Name=""zoom-in"" Size=""12"" Class=""size-3"" />
                </ButtonCn>
            </div>
            <ButtonCn Size=""ButtonSize.Sm"" Class=""h-7 gap-1.5 text-xs"">
                <LucideIconCn Name=""download"" Size=""12"" Class=""size-3"" />
                Export Selection
            </ButtonCn>
        </div>

    </div>
</section>

