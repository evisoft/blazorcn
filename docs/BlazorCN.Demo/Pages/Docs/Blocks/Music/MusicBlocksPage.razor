@code {
    private record FormatOption(string Value, string Label, string Extension);
    private record BitrateOption(int Value, string Label);
    private record SampleRateOption(string Value, string Label);

    private static readonly FormatOption[] _inputFormats =
    [
        new(""mp3"",  ""MP3"",  "".mp3""),
        new(""wav"",  ""WAV"",  "".wav""),
        new(""flac"", ""FLAC"", "".flac""),
        new(""aac"",  ""AAC"",  "".aac""),
        new(""ogg"",  ""OGG"",  "".ogg""),
    ];

    private static readonly FormatOption[] _outputFormats =
    [
        new(""mp3"",  ""MP3"",  "".mp3""),
        new(""wav"",  ""WAV"",  "".wav""),
        new(""flac"", ""FLAC"", "".flac""),
        new(""aac"",  ""AAC"",  "".aac""),
        new(""ogg"",  ""OGG"",  "".ogg""),
    ];

    private static readonly BitrateOption[] _bitrateOptions =
    [
        new(128, ""128 kbps""),
        new(192, ""192 kbps""),
        new(256, ""256 kbps""),
        new(320, ""320 kbps""),
    ];

    private static readonly SampleRateOption[] _sampleRateOptions =
    [
        new(""44100"", ""44.1 kHz""),
        new(""48000"", ""48 kHz""),
        new(""96000"", ""96 kHz""),
    ];

    private string _inputFormat  = ""wav"";
    private string _outputFormat = ""mp3"";
    private int    _bitrate      = 256;
    private string _sampleRate   = ""44100"";
    private string _convertState = ""idle"";
    private int    _progress     = 0;

    private System.Timers.Timer? _timer;

    private string CurrentBitrateLabel =>
        _bitrateOptions.FirstOrDefault(b => b.Value == _bitrate)?.Label ?? """";

    private string CurrentSampleRateLabel =>
        _sampleRateOptions.FirstOrDefault(s => s.Value == _sampleRate)?.Label ?? """";

    private string OutputFormatLabel =>
        _outputFormats.FirstOrDefault(f => f.Value == _outputFormat)?.Label.ToUpperInvariant() ?? _outputFormat.ToUpperInvariant();

    private void HandleConvert()
    {
        _convertState = ""converting"";
        _progress = 0;
        _timer = new System.Timers.Timer(120);
        _timer.Elapsed += async (_, _) =>
        {
            _progress += 4;
            if (_progress >= 100)
            {
                _progress = 100;
                _timer?.Stop();
                _timer?.Dispose();
                _timer = null;
                _convertState = ""done"";
            }
            await InvokeAsync(StateHasChanged);
        };
        _timer.AutoReset = true;
        _timer.Start();
    }

    private void HandleReset()
    {
        _convertState = ""idle"";
        _progress = 0;
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
        _timer = null;
    }
}";

