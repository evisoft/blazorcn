            new(""lo-fi-hip-hop"", ""Lo-Fi Hip-Hop"", 74, [""Nujabes"", ""J Dilla"", ""Tomppabeats""]),
        ]),
        new(""jazz"", ""Jazz"", 54, [""Kamasi Washington"", ""Robert Glasper"", ""Snarky Puppy""],
        [
            new(""fusion"", ""Jazz Fusion"", 48, [""Snarky Puppy"", ""Hiatus Kaiyote"", ""Thundercat""]),
            new(""neo-soul"", ""Neo-Soul"", 68, [""Erykah Badu"", ""D'Angelo"", ""Anderson .Paak""]),
        ]),
    ];

    private readonly HashSet<string> _expandedIds = [""electronic""];
    private string? _playingId = null;

    private int _totalGenres =>
        _genres.Length +
        _genres.Sum(g => (g.Children?.Length ?? 0) +
            (g.Children?.Sum(c => c.Children?.Length ?? 0) ?? 0));

    private void ToggleExpand(string id)
    {
        if (_expandedIds.Contains(id))
            _expandedIds.Remove(id);
        else
            _expandedIds.Add(id);
    }

    private void TogglePlaying(string id)
    {
        _playingId = _playingId == id ? null : id;
    }

    private string PopularityColor(int popularity) =>
        popularity >= 80 ? ""bg-emerald-500"" :
        popularity >= 60 ? ""bg-amber-500"" :
        ""bg-muted-foreground/40"";

    private RenderFragment RenderGenreNode(Genre genre, int depth) => __builder =>
    {
        var isExpanded = _expandedIds.Contains(genre.Id);
        var hasChildren = genre.Children != null && genre.Children.Length > 0;
        var isPlaying = _playingId == genre.Id;
        var popularityColor = PopularityColor(genre.Popularity);
        var paddingLeft = $""{depth * 20 + 16}px"";

        <div>
            <div class=""border-b"" style=""@($""padding-left:{paddingLeft}"")"">
                @* The row used to be one big <button> wrapping the ""Play sample"" button —
                   invalid HTML, and the outer button swallowed the inner one's clicks (hence
                   the @onclick:stopPropagation workaround below). The expand action is now a
                   stretched overlay button: it covers the row for pointer users while the
                   play control stays a real sibling button above it. *@
                <div class=""relative flex w-full items-center gap-3 py-3 pr-4 transition-colors hover:bg-muted/50"">
                    @if (hasChildren)
                    {
                        <button type=""button""
                                @onclick=""@(() => ToggleExpand(genre.Id))""
                                class=""absolute inset-0 z-10 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-ring""
                                aria-expanded=""@isExpanded.ToString().ToLower()""
                                aria-label=""@($""{(isExpanded ? ""Collapse"" : ""Expand"")} {genre.Name}"")""></button>
                    }

                    @if (hasChildren)
                    {
                        <LucideIconCn Name=""chevron-right"" Size=""16"" Class=""@Cn.Merge(""size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200"", isExpanded ? ""rotate-90"" : """")"" />
                    }
                    else
                    {
                        <span class=""size-4 shrink-0""></span>
                    }

                    <div class=""min-w-0 flex-1"">
                        <div class=""flex items-center gap-2"">
                            <span class=""font-medium text-sm"">@genre.Name</span>
                            @if (genre.Popularity >= 85)
                            {
                                <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""font-normal text-xs"">
                                    <LucideIconCn Name=""trending-up"" Size=""12"" Class=""mr-1 size-3"" />
                                    Trending
                                </BadgeCn>
                            }
                        </div>
                        <div class=""mt-1 flex items-center gap-2"">
                            @* Popularity bar *@
                            <div class=""h-1 w-16 overflow-hidden rounded-full bg-muted"">
                                <div class=""@Cn.Merge(""h-full rounded-full"", popularityColor)"" style=""@($""width:{genre.Popularity}%"")""></div>
                            </div>
                            <span class=""text-muted-foreground text-xs tabular-nums"">@(genre.Popularity)%</span>
                        </div>
                    </div>

                    @* Artists *@
                    <div class=""hidden items-center gap-1 md:flex"">
                        @foreach (var artist in genre.Artists.Take(2))
                        {
                            <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""font-normal text-xs"">@artist</BadgeCn>
                        }
                        @if (genre.Artists.Length > 2)
                        {
                            <span class=""text-muted-foreground text-xs"">+@(genre.Artists.Length - 2)</span>
                        }
                    </div>

                    @* Play sample — sits above the stretched expand overlay *@
                    <div class=""relative z-20"" @onclick=""@(() => TogglePlaying(genre.Id))"">
                        <ButtonCn Variant=""ButtonVariant.Ghost"" Size=""ButtonSize.Sm"" Class=""h-7 gap-1 px-2 text-xs""
                                  aria-label=""@($""Play {genre.Name} sample"")"">
                            @if (isPlaying)
                            {
                                <LucideIconCn Name=""headphones"" Size=""12"" Class=""size-3"" />
                                @(""Playing"")
                            }
                            else
                            {
                                <LucideIconCn Name=""play"" Size=""12"" Class=""size-3"" />
                                @(""Sample"")
                            }
                        </ButtonCn>
                    </div>

                </div>
            </div>

            @* Children *@
            @if (isExpanded && hasChildren)
            {
                <div>
                    @foreach (var child in genre.Children!)
                    {
                        @RenderGenreNode(child, depth + 1)
                    }
                </div>
            }
        </div>
    };
}";

