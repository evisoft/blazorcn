@code {
    private static readonly string[] _timeSignatures = [""4/4"", ""3/4"", ""6/8""];

    private int _tempo = 120;
    private bool _isPlaying = false;
    private string _timeSignature = ""4/4"";
    private bool _accentFirst = true;
    private int _currentBeat = -1;

    private readonly List<long> _tapTimes = new();
    private System.Timers.Timer? _timer;

    private int BeatCount => _timeSignature switch
    {
        ""4/4"" => 4,
        ""3/4"" => 3,
        ""6/8"" => 6,
        _     => 4,
    };

    private void TogglePlay()
    {
        _isPlaying = !_isPlaying;
        if (_isPlaying)
            StartMetronome();
        else
            StopMetronome();
    }

    private void StartMetronome()
    {
        _timer?.Dispose();
        _currentBeat = 0;
        var ms = 60000.0 / _tempo;
        _timer = new System.Timers.Timer(ms);
        _timer.Elapsed += OnTick;
        _timer.AutoReset = true;
        _timer.Start();
    }

    private void StopMetronome()
    {
        _timer?.Dispose();
        _timer = null;
        _currentBeat = -1;
    }

    private void OnTick(object? sender, System.Timers.ElapsedEventArgs e)
    {
        var beats = BeatCount;
        _currentBeat = (_currentBeat + 1) % beats;
        InvokeAsync(StateHasChanged);
    }

    private void SetTimeSignature(string sig)
    {
        _timeSignature = sig;
        if (_isPlaying)
            StartMetronome();
    }

    private void HandleTapTempo()
    {
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        _tapTimes.Add(now);

        if (_tapTimes.Count > 5)
            _tapTimes.RemoveAt(0);

        if (_tapTimes.Count >= 2)
        {
            var intervals = new List<long>();
            for (int i = 1; i < _tapTimes.Count; i++)
                intervals.Add(_tapTimes[i] - _tapTimes[i - 1]);

            var avgInterval = intervals.Average();
            var bpm = (int)Math.Round(60000.0 / avgInterval);
            _tempo = Math.Min(300, Math.Max(20, bpm));

            if (_isPlaying)
                StartMetronome();
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _timer = null;
    }
}";

