    private static string SongRowClass(bool isLast) =>
        Cn.Merge(""flex items-center justify-between px-4 py-2.5 transition-colors hover:bg-muted/50"", isLast ? """" : ""border-b"");

    private static string FormatNumber(int n)
    {
        if (n >= 1_000_000) return $""{n / 1_000_000.0:F1}M"";
        if (n >= 1_000)     return $""{n / 1_000.0:F1}K"";
        return n.ToString();
    }

    // Chart constants: viewBox 560x180, padLeft=36, padRight=8, padTop=8, padBottom=24
    private const int _chartMinVal = 38000;
    private const int _chartMaxVal = 50000;
    private static readonly int[] _chartYTicks = [38000, 41000, 44000, 47000, 50000];

    private static double ChartX(int index)
    {
        var count = _followerData.Length;
        return 36.0 + (double)index / (count - 1) * 516.0; // 560-36-8=516
    }

    private static double ChartY(int value)
    {
        // padTop=8, chartH=148 (180-8-24)
        return 8.0 + 148.0 - (double)(value - _chartMinVal) / (_chartMaxVal - _chartMinVal) * 148.0;
    }

    private static string BuildPolyline()
    {
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < _followerData.Length; i++)
        {
            var x = ChartX(i);
            var y = ChartY(_followerData[i].Followers);
            if (i > 0) sb.Append(' ');
            sb.Append($""{x:F1},{y:F1}"");
        }
        return sb.ToString();
    }

    private static string BuildAreaPath()
    {
        var sb = new System.Text.StringBuilder();
        // start at bottom-left
        sb.Append($""M 36,156""); // padLeft, padTop+chartH = 8+148=156
        for (var i = 0; i < _followerData.Length; i++)
        {
            var x = ChartX(i);
            var y = ChartY(_followerData[i].Followers);
            sb.Append($"" L {x:F1},{y:F1}"");
        }
        // close back to bottom-right then bottom-left
        sb.Append($"" L 552,156 Z""); // padLeft+chartW=36+516=552
        return sb.ToString();
    }
}";

