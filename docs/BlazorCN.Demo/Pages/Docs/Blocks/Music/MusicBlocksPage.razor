@code {
    private record Bookmark(string Id, int Timestamp, string Label, string Title, string Notes);

    private const int TrackDuration = 210;

    private static readonly string[] _labels = [""Intro"", ""Verse"", ""Chorus"", ""Bridge"", ""Outro"", ""Note""];

    private List<Bookmark> _bookmarks =
    [
        new(""bm-1"",   0, ""Intro"",  ""Track opening"",      ""Ambient pad with reverb tail, 4 bars before drums enter""),
        new(""bm-2"",  32, ""Verse"",  ""First verse"",         ""Vocals come in, keep bass low to leave room for voice""),
        new(""bm-3"",  64, ""Chorus"", ""Main chorus"",         ""Full arrangement, push the snare level up 2dB here""),
        new(""bm-4"",  96, ""Bridge"", ""Breakdown section"",   ""Strip back to keys and vocal only, add delay throw on last word""),
        new(""bm-5"", 142, ""Chorus"", ""Final chorus"",        ""Double the vocal harmonies, ride the master fader up slightly""),
        new(""bm-6"", 178, ""Outro"",  ""Fade out"",            ""Gradual fade over 8 bars, let the reverb tail ring out naturally""),
    ];

    private string? _expanded = ""bm-3"";
    private int _currentTime = 64;
    private bool _isPlaying = false;
    private string _newLabel = ""Note"";

    private int ProgressPercent => (int)Math.Round((double)_currentTime / TrackDuration * 100);

    private static string FormatTime(int seconds)
    {
        var m = seconds / 60;
        var s = seconds % 60;
        return $""{m}:{s:D2}"";
    }

    private static string LabelColor(string label) => label switch
    {
        ""Intro""  => ""bg-blue-500"",
        ""Verse""  => ""bg-emerald-500"",
        ""Chorus"" => ""bg-amber-500"",
        ""Bridge"" => ""bg-purple-500"",
        ""Outro""  => ""bg-red-500"",
        _        => ""bg-muted-foreground"",
    };

    private void AddBookmark()
    {
        var id = $""bm-{_bookmarks.Count + 1}-{_currentTime}"";
        var newBookmark = new Bookmark(id, _currentTime, _newLabel, $""Bookmark at {FormatTime(_currentTime)}"", """");
        _bookmarks = [.. _bookmarks, newBookmark];
        _bookmarks = [.. _bookmarks.OrderBy(b => b.Timestamp)];
        _expanded = id;
    }

    private void RemoveBookmark(string id)
    {
        _bookmarks = _bookmarks.Where(b => b.Id != id).ToList();
        if (_expanded == id) _expanded = null;
    }

    private void JumpTo(int timestamp)
    {
        _currentTime = timestamp;
    }
}";

