    ];

    private string _singerName = """";
    private string _songTitle = """";
    private string _songArtist = """";
    private int _nextId = 6;

    private void HandleJoin()
    {
        if (string.IsNullOrWhiteSpace(_singerName) || string.IsNullOrWhiteSpace(_songTitle))
            return;

        var entry = new QueueEntry(
            $""q{_nextId++}"",
            _singerName.Trim(),
            _songTitle.Trim(),
            string.IsNullOrWhiteSpace(_songArtist) ? ""Unknown"" : _songArtist.Trim()
        );
        _queue.Add(entry);
        _singerName = """";
        _songTitle = """";
        _songArtist = """";
    }

    private void HandleRemove(string id)
    {
        _queue.RemoveAll(e => e.Id == id);
    }
}";

