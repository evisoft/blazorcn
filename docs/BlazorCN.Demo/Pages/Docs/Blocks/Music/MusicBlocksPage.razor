    private void ClearTrack()
    {
        _trackFileName = null;
        _trackFileSize = null;
    }

    private void ClearCoverArt()
    {
        _hasCoverArt = false;
    }

    private void HandlePublish()
    {
        _publishing = true;
        _progress   = 0;
        _timer      = new System.Timers.Timer(200);
        _timer.Elapsed += async (_, _) =>
        {
            _progress += 10;
            if (_progress >= 100)
            {
                _progress  = 100;
                _timer?.Stop();
                _timer?.Dispose();
                _timer     = null;
                _publishing = false;
                _published  = true;
            }
            await InvokeAsync(StateHasChanged);
        };
        _timer.AutoReset = true;
        _timer.Start();
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
        _timer = null;
    }
}";

