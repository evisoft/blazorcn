                        <button type=""button""
                                @onclick=""@(() => ToggleCell(inst.Id, step))""
                                class=""@Cn.Merge(""size-6 rounded-sm transition-colors"", isActive ? inst.ActiveColor : ""bg-muted/50 hover:bg-muted"", step % 4 == 0 ? ""ring-1 ring-border/30"" : """")""
                                aria-label=""@($""{inst.Name} step {step + 1}, {(isActive ? ""active"" : ""inactive"")}"")"">
