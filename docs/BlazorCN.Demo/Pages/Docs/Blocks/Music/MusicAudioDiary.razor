@* ============================================================
   Block: music-audio-diary
   Title: MusicAudioDiary
   Description: An audio diary journal block for React and Next.js with dated entries, recording length, mood tags, transcript preview, per-entry playback, and new recording button built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-audio-diary.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="book-open" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Audio Diary</span>
                </div>
                <p class="mt-1 text-muted-foreground text-xs">@_entries.Length entries this week</p>
            </div>
            <ButtonCn Size="ButtonSize.Sm"
                      Class="h-7 gap-1.5 text-xs"
                      OnClick="@(() => _recording = !_recording)">
                @if (_recording)
                {
                    <span class="size-1.5 animate-pulse rounded-full bg-red-400"></span>
                    @("Recording...")
                }
                else
                {
                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                    @("New Entry")
                }
            </ButtonCn>
        </div>

        @* Entry list *@
        <div>
            @for (int i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                var isLast = i == _entries.Length - 1;
                var isExpanded = _expanded == entry.Id;
                var isPlaying = _playing == entry.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = (_expanded == entry.Id ? null : entry.Id))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@entry.Title</span>
                                <BadgeCn Variant="BadgeVariant.Secondary"
                                         Class="@Cn.Merge("font-normal text-xs", MoodStyle(entry.Mood))">
                                    @entry.Mood
                                </BadgeCn>
                            </div>
                            <div class="mt-1 flex items-center gap-2 text-muted-foreground text-xs">
                                <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                <span>@entry.DayLabel</span>
                                <span>&middot;</span>
                                <span>@entry.Date</span>
                                <span>&middot;</span>
                                <LucideIconCn Name="mic" Size="12" Class="size-3" />
                                <span class="font-mono tabular-nums">@entry.Duration</span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right"
                                      Size="16"
                                      Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-4">
                                @* Transcript preview *@
                                <div class="rounded-md bg-muted/50 p-3">
                                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                                        Transcript preview
                                    </span>
                                    <p class="text-sm leading-relaxed">@entry.Transcript</p>
                                </div>

                                @* Play button *@
                                <div class="mt-3 flex items-center gap-2">
                                    <div @onclick:stopPropagation>
                                        <ButtonCn Variant="ButtonVariant.Outline"
                                                  Size="ButtonSize.Sm"
                                                  Class="h-7 gap-1.5 text-xs"
                                                  OnClick="@(() => _playing = (isPlaying ? null : entry.Id))">
                                            @if (isPlaying)
                                            {
                                                <LucideIconCn Name="pause" Size="12" Class="size-3" />
                                                @("Pause")
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="play" Size="12" Class="size-3" />
                                                @("Play Recording")
                                            }
                                        </ButtonCn>
                                    </div>
                                    @if (isPlaying)
                                    {
                                        <div class="flex items-center gap-1">
                                            <div class="w-0.5 rounded-full bg-foreground h-1 animate-pulse"></div>
                                            <div class="w-0.5 rounded-full bg-foreground h-3 animate-pulse" style="animation-delay:0.1s"></div>
                                            <div class="w-0.5 rounded-full bg-foreground h-1.5 animate-pulse" style="animation-delay:0.2s"></div>
                                            <div class="w-0.5 rounded-full bg-foreground h-2.5 animate-pulse" style="animation-delay:0.3s"></div>
                                            <div class="w-0.5 rounded-full bg-foreground h-1 animate-pulse" style="animation-delay:0.4s"></div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Entries auto-transcribed &middot; Tap to expand
            </p>
        </div>

    </div>
</section>

@code {
    private record DiaryEntry(string Id, string Date, string DayLabel, string Duration, string Mood, string Title, string Transcript);

    private static readonly DiaryEntry[] _entries =
    [
        new("e1", "Mar 30, 2026", "Today",     "4:32", "grateful",   "Morning gratitude",        "Woke up early to the sound of birds outside the window. Feeling grateful for the quiet start to the day. Spent a few minutes thinking about the small things that went well yesterday..."),
        new("e2", "Mar 29, 2026", "Yesterday", "6:15", "reflective", "Processing the week",      "This week was a lot. The project deadline pushed me harder than expected, but looking back I am proud of what the team delivered. Need to remember to pace myself better next sprint..."),
        new("e3", "Mar 28, 2026", "Saturday",  "3:48", "happy",      "Concert night recap",      "The show last night was incredible. The energy in the venue was electric from the first note. There is something about live music that just resets everything. Made a mental note to go to more shows..."),
        new("e4", "Mar 27, 2026", "Friday",    "5:02", "anxious",    "Pre-presentation nerves",  "Big presentation tomorrow and I can feel the tension building. Ran through the slides three times. I know the material inside and out but the stakes feel high. Trying a breathing exercise before bed..."),
        new("e5", "Mar 26, 2026", "Thursday",  "2:55", "calm",       "Evening wind-down",        "Quiet evening at home. Made tea, read for an hour, then just sat and listened to the rain. Sometimes doing nothing is the most productive thing you can do for yourself..."),
    ];

    private string? _playing;
    private string? _expanded = "e1";
    private bool _recording;

    private static string MoodStyle(string mood) => mood switch
    {
        "calm"       => "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        "happy"      => "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        "reflective" => "bg-violet-500/10 text-violet-600 dark:text-violet-400",
        "anxious"    => "bg-red-500/10 text-red-600 dark:text-red-400",
        "grateful"   => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        _            => "",
    };
}
