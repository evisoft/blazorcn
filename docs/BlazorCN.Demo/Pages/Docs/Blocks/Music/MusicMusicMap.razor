@* ============================================================
   Block: music-music-map
   Title: MusicMusicMap
   Description: A music origin map block for React and Next.js with genre-to-region associations, interactive genre pins on a world map, click-to-reveal genre history panels, and a genre selector filter built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-music-map.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="globe" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Music Origin Map</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto font-normal text-xs">
                    @(_genreOrigins.Length) genres
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Explore where the world's most influential genres were born.
            </p>
        </div>

        @* Genre filter *@
        <div class="flex items-center gap-1 overflow-x-auto border-b px-4 py-2">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                      Class="@Cn.Merge("h-6 shrink-0 px-2 text-xs", _filter == null ? "bg-muted shadow-sm" : "text-muted-foreground")"
                      @onclick="@(() => _filter = null)">
                All
            </ButtonCn>
            @foreach (var genre in _allGenres)
            {
                var g = genre;
                var origin = _genreOrigins.FirstOrDefault(o => o.Genre == g);
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                          Class="@Cn.Merge("h-6 shrink-0 gap-1.5 px-2 text-xs", _filter == g ? "bg-muted shadow-sm" : "text-muted-foreground")"
                          @onclick="@(() => _filter = (_filter == g ? null : g))">
                    <span class="@Cn.Merge("size-1.5 rounded-full", origin?.Color ?? "")"></span>
                    @g
                </ButtonCn>
            }
        </div>

        @* Map and detail grid *@
        <div class="grid md:grid-cols-2">

            @* Map area *@
            <div class="relative border-b md:border-b-0 md:border-r">
                <div class="relative aspect-[4/3] w-full overflow-hidden bg-muted/30">
                    @* Simplified world map outline using SVG *@
                    <svg viewBox="0 0 100 60"
                         class="absolute inset-0 size-full text-muted-foreground/15"
                         aria-label="World map showing genre origin locations">
                        @((MarkupString)"<title>World map</title>")
                        @* Simplified continent outlines *@
                        <path d="M15,20 Q18,15 25,18 L28,22 Q30,28 25,32 L20,30 Q14,26 15,20Z" fill="currentColor" />
                        <path d="M17,34 Q20,32 25,35 L28,42 Q30,50 25,55 L22,52 Q16,45 17,34Z" fill="currentColor" />
                        <path d="M42,15 Q48,12 58,14 L62,18 Q65,22 60,28 L55,32 Q48,35 44,30 L42,24 Q40,19 42,15Z" fill="currentColor" />
                        <path d="M44,32 Q48,30 55,34 L58,42 Q56,50 50,52 L46,48 Q42,40 44,32Z" fill="currentColor" />
                        <path d="M62,18 Q68,14 78,16 L85,22 Q88,28 82,32 L75,30 Q68,26 65,22Z" fill="currentColor" />
                        <path d="M72,38 Q76,36 82,38 L85,44 Q84,50 78,52 L74,48 Q70,44 72,38Z" fill="currentColor" />
                    </svg>

                    @* Genre pins *@
                    @foreach (var pin in _visiblePins)
                    {
                        var pinItem = pin;
                        <button type="button"
                                class="group absolute z-10 -translate-x-1/2 -translate-y-1/2"
                                style="@($"left:{pinItem.X}%;top:{pinItem.Y}%")"
                                @onclick="@(() => _selectedGenre = pinItem.Genre)"
                                aria-label="@($"{pinItem.Genre} from {pinItem.City}")">
                            <div class="@Cn.Merge("flex size-6 items-center justify-center rounded-full border-2 border-card transition-transform group-hover:scale-125", pinItem.Color, _selectedGenre == pinItem.Genre ? "scale-125 ring-2 ring-foreground/20" : "")">
                                <LucideIconCn Name="map-pin" Size="12" Class="size-3 text-white" />
                            </div>
                            <span class="pointer-events-none absolute left-1/2 top-full mt-1 -translate-x-1/2 whitespace-nowrap rounded bg-card px-1.5 py-0.5 font-medium text-xs opacity-0 shadow-sm transition-opacity group-hover:opacity-100">
                                @pinItem.City
                            </span>
                        </button>
                    }
                </div>
            </div>

            @* Detail panel *@
            <div class="flex flex-col">
                @{
                    var selected = _genreOrigins.FirstOrDefault(g => g.Genre == _selectedGenre);
                }
                @if (selected != null)
                {
                    <div class="flex flex-1 flex-col">
                        <div class="border-b px-4 py-3">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("size-2 rounded-full", selected.Color)"></span>
                                <span class="font-medium text-sm">@selected.Genre</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                    @selected.Era
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @selected.City, @selected.Region
                            </p>
                        </div>

                        <div class="border-b px-4 py-3">
                            <span class="mb-1 block font-medium text-muted-foreground text-xs">
                                Origin story
                            </span>
                            <p class="text-sm leading-relaxed">@selected.History</p>
                        </div>

                        <div class="px-4 py-3">
                            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                                Key artists
                            </span>
                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var artist in selected.KeyArtists)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                        @artist
                                    </BadgeCn>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Click a pin to explore genre history &middot; Filter by genre above
            </p>
        </div>

    </div>
</section>

@code {
    private record GenreOrigin(
        string Id,
        string Genre,
        string City,
        string Region,
        int X,
        int Y,
        string Color,
        string Era,
        string History,
        string[] KeyArtists
    );

    private static readonly GenreOrigin[] _genreOrigins =
    [
        new("jazz", "Jazz", "New Orleans", "United States", 22, 42, "bg-amber-500", "1900s",
            "Born from a fusion of African rhythms, blues, and ragtime in New Orleans. The genre spread north to Chicago and New York, evolving through swing, bebop, and cool jazz. Louis Armstrong and Duke Ellington defined its early voice.",
            ["Louis Armstrong", "Miles Davis", "John Coltrane"]),
        new("kpop", "K-Pop", "Seoul", "South Korea", 80, 38, "bg-pink-500", "1990s",
            "Emerged from Seoul's entertainment industry, blending Western pop, hip-hop, and R&B with Korean lyrics and high-production choreography. Seo Taiji and Boys launched the movement in 1992, paving the way for a global cultural export.",
            ["BTS", "BLACKPINK", "EXO"]),
        new("bossanova", "Bossa Nova", "Rio de Janeiro", "Brazil", 32, 66, "bg-emerald-500", "1950s",
            "Created in the beach neighborhoods of Rio, blending samba rhythms with jazz harmony. Tom Jobim and Joao Gilberto crafted its intimate, understated style. The Girl from Ipanema became one of the most recorded songs in history.",
            ["Tom Jobim", "Joao Gilberto", "Astrud Gilberto"]),
        new("reggae", "Reggae", "Kingston", "Jamaica", 24, 48, "bg-green-500", "1960s",
            "Evolved from ska and rocksteady in Kingston, Jamaica. Characterized by off-beat rhythms and socially conscious lyrics rooted in Rastafari culture. Bob Marley brought reggae to the world stage and became a symbol of resistance.",
            ["Bob Marley", "Peter Tosh", "Jimmy Cliff"]),
        new("techno", "Techno", "Detroit", "United States", 23, 36, "bg-blue-500", "1980s",
            "Pioneered in Detroit by the Belleville Three: Juan Atkins, Kevin Saunderson, and Derrick May. Inspired by Kraftwerk and Chicago house, techno used drum machines and synthesizers to create futuristic electronic soundscapes.",
            ["Juan Atkins", "Derrick May", "Kevin Saunderson"]),
        new("flamenco", "Flamenco", "Seville", "Spain", 46, 38, "bg-red-500", "1700s",
            "Rooted in the Andalusian Romani community, flamenco combines passionate guitar, rhythmic handclaps, and expressive vocals. Its emotional intensity and improvisational nature make it one of the most recognized art forms from Spain.",
            ["Paco de Lucia", "Camaron de la Isla", "Tomatito"]),
        new("afrobeat", "Afrobeat", "Lagos", "Nigeria", 48, 52, "bg-orange-500", "1970s",
            "Created by Fela Kuti in Lagos, fusing West African highlife and Yoruba music with jazz and funk. Known for extended compositions, polyrhythmic percussion, and politically charged lyrics that challenged authority.",
            ["Fela Kuti", "Tony Allen", "Burna Boy"]),
    ];

    private static readonly string[] _allGenres = _genreOrigins.Select(g => g.Genre).ToArray();

    private string _selectedGenre = "Jazz";
    private string? _filter = null;

    private GenreOrigin[] _visiblePins =>
        _filter != null
            ? _genreOrigins.Where(g => g.Genre == _filter).ToArray()
            : _genreOrigins;
}
