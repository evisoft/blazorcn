@* ============================================================
   Block: music-distribution-settings
   Title: MusicDistributionSettings
   Description: A music distribution settings block for React and Next.js with platform toggles for Spotify, Apple Music, Amazon, YouTube Music, Tidal, and Deezer, release date picker, pricing model selector, and territory restrictions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-distribution-settings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="settings" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Distribution Settings</span>
            </div>
            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                <span>@EnabledPlatforms platforms</span>
                <span>&middot;</span>
                <span>@EnabledTerritories regions</span>
            </div>
        </div>

        @* Platform toggles *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2 mb-3">
                <LucideIconCn Name="music" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Platforms</span>
            </div>
            <div class="space-y-2.5">
                @foreach (var plat in _platforms)
                {
                    var platform = plat;
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2.5">
                            <span class="@Cn.Merge("size-1.5 rounded-full", platform.Enabled ? "bg-emerald-500" : "bg-zinc-400")"></span>
                            <span class="font-medium text-sm">@platform.Name</span>
                            <span class="text-muted-foreground text-xs">@platform.Status</span>
                        </div>
                        <SwitchCn Checked="@platform.Enabled"
                                  CheckedChanged="@((bool v) => TogglePlatform(platform.Id))"
                                  aria-label="@($"Toggle {platform.Name}")" />
                    </div>
                }
            </div>
        </div>

        @* Release date *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Release Date</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">@_releaseDate</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Scheduled</BadgeCn>
            </div>
        </div>

        @* Pricing model *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2 mb-2.5">
                <LucideIconCn Name="tag" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Pricing Model</span>
            </div>
            <div class="flex items-center gap-1.5">
                @foreach (var opt in _pricingOptions)
                {
                    var option = opt;
                    <ButtonCn Variant="ButtonVariant.Outline"
                              Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-7 text-xs", _pricing == option.Id ? "ring-2 ring-foreground" : "")"
                              OnClick="@(() => _pricing = option.Id)">
                        @option.Label
                    </ButtonCn>
                }
            </div>
            <p class="mt-1.5 text-muted-foreground text-xs">
                @(_pricingOptions.FirstOrDefault(o => o.Id == _pricing)?.Description)
            </p>
        </div>

        @* Territory restrictions *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2 mb-2.5">
                <LucideIconCn Name="globe" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Territory Restrictions</span>
            </div>
            <div class="grid grid-cols-2 gap-2">
                @foreach (var terr in _territories)
                {
                    var territory = terr;
                    <label for="@($"music-dist-territory-{territory.Id}")"
                           class="flex cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 transition-colors hover:bg-muted/50">
                        <CheckboxCn id="@($"music-dist-territory-{territory.Id}")"
                                    Checked="@territory.Enabled"
                                    CheckedChanged="@((bool v) => ToggleTerritory(territory.Id))"
                                    aria-label="@territory.Name" />
                        <span class="text-sm">@territory.Name</span>
                    </label>
                }
            </div>
        </div>

        @* Save button *@
        <div class="px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full gap-1.5 text-xs" OnClick="HandleSave">
                @if (_saved)
                {
                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                    <span>Settings Saved</span>
                }
                else
                {
                    <LucideIconCn Name="save" Size="12" Class="size-3" />
                    <span>Save Distribution Settings</span>
                }
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Platform(string Id, string Name, bool Enabled, string Status)
    {
        public bool Enabled { get; set; } = Enabled;
    }

    private record Territory(string Id, string Name, bool Enabled)
    {
        public bool Enabled { get; set; } = Enabled;
    }

    private record PricingOption(string Id, string Label, string Description);

    private Platform[] _platforms =
    [
        new("spotify",       "Spotify",       true,  "Connected"),
        new("apple-music",   "Apple Music",   true,  "Connected"),
        new("amazon",        "Amazon Music",  true,  "Connected"),
        new("youtube-music", "YouTube Music", false, "Pending"),
        new("tidal",         "Tidal",         false, "Not connected"),
        new("deezer",        "Deezer",        true,  "Connected"),
    ];

    private Territory[] _territories =
    [
        new("na",    "North America",       true),
        new("eu",    "Europe",              true),
        new("uk",    "United Kingdom",      true),
        new("apac",  "Asia Pacific",        false),
        new("latam", "Latin America",       true),
        new("mena",  "Middle East & Africa", false),
    ];

    private static readonly PricingOption[] _pricingOptions =
    [
        new("standard", "Standard", "$0.99 per track"),
        new("premium",  "Premium",  "$1.29 per track"),
        new("free",     "Free",     "Ad-supported streaming"),
    ];

    private const string _releaseDate = "Apr 15, 2026";

    private string _pricing = "standard";
    private bool _saved = false;

    private int EnabledPlatforms   => _platforms.Count(p => p.Enabled);
    private int EnabledTerritories => _territories.Count(t => t.Enabled);

    private void TogglePlatform(string id)
    {
        foreach (var p in _platforms)
        {
            if (p.Id == id) p.Enabled = !p.Enabled;
        }
    }

    private void ToggleTerritory(string id)
    {
        foreach (var t in _territories)
        {
            if (t.Id == id) t.Enabled = !t.Enabled;
        }
    }

    private async Task HandleSave()
    {
        _saved = true;
        StateHasChanged();
        await Task.Delay(2000);
        _saved = false;
    }
}
