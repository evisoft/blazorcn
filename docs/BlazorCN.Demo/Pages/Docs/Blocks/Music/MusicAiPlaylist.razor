@* ============================================================
   Block: music-ai-playlist
   Title: MusicAiPlaylist
   Description: An AI-powered playlist generator block for React and Next.js with prompt input, mood and energy indicators per track, regenerate functionality, and save playlist action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-ai-playlist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">AI Playlist Generator</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_tracks.Length tracks
            </BadgeCn>
        </div>

        @* Prompt input *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <InputCn @bind-Value="_prompt"
                     Placeholder="Describe the mood you want..."
                     aria-label="Describe the mood you want"
                     Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                      Class="h-7 shrink-0 gap-1 px-2 text-xs"
                      OnClick="HandleGenerate">
                <LucideIconCn Name="send" Size="12" Class="size-3" />
                Generate
            </ButtonCn>
        </div>

        @* Playlist stats *@
        @if (_generated)
        {
            <div class="flex items-center gap-3 border-b px-4 py-2.5">
                <span class="text-muted-foreground text-xs">@_totalDuration total</span>
                <span class="text-muted-foreground text-xs">&middot;</span>
                <span class="text-muted-foreground text-xs">~@_avgBpm avg BPM</span>
                <div class="ml-auto flex items-center gap-1">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                              Class="h-6 gap-1 px-2 text-xs"
                              OnClick="HandleRegenerate">
                        <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                        Regenerate
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                              Class="h-6 gap-1 px-2 text-xs"
                              OnClick="HandleSave">
                        @if (_saved)
                        {
                            <LucideIconCn Name="list-music" Size="12" Class="size-3" />
                            <span>Saved</span>
                        }
                        else
                        {
                            <LucideIconCn Name="save" Size="12" Class="size-3" />
                            <span>Save</span>
                        }
                    </ButtonCn>
                </div>
            </div>
        }

        @* Track list *@
        @if (_generated)
        {
            @foreach (var (track, index) in _tracks.Select((t, i) => (t, i)))
            {
                var isLast = index == _tracks.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <span class="w-4 text-center font-mono text-muted-foreground text-xs tabular-nums">
                        @(index + 1)
                    </span>
                    <div class="min-w-0 flex-1">
                        <span class="block truncate font-medium text-sm">@track.Title</span>
                        <span class="block truncate text-muted-foreground text-xs">@track.Artist</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", MoodDot(track.Mood))"
                              title="@track.Mood"></span>
                        <span class="text-muted-foreground text-xs">@track.Mood</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="zap" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-muted-foreground text-xs">@EnergyLabel(track.Energy)</span>
                    </div>
                    <span class="font-mono text-muted-foreground text-xs tabular-nums">@track.Bpm</span>
                    <span class="w-10 text-right font-mono text-muted-foreground text-xs tabular-nums">
                        @track.Duration
                    </span>
                </div>
            }
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                AI-generated playlist &middot; Describe any mood or activity
            </p>
        </div>

    </div>
</section>

@code {
    private record Track(string Id, string Title, string Artist, string Duration, string Mood, string Energy, int Bpm);

    private static readonly Track[] _initialTracks =
    [
        new("t1", "Rainy Window",    "Lofi Dreamer",  "3:42", "chill",     "low",    72),
        new("t2", "Midnight Drizzle","Cloud Atlas",   "4:18", "dreamy",    "low",    68),
        new("t3", "Soft Landing",    "Ambient Waves", "3:55", "melancholy","medium", 85),
        new("t4", "Foggy Morning",   "Nocturn",       "5:01", "chill",     "low",    64),
        new("t5", "Paper Boats",     "Gentle Hum",    "3:28", "dreamy",    "medium", 78),
        new("t6", "Petrichor",       "Evening Tide",  "4:37", "chill",     "low",    70),
    ];

    private static readonly Track[] _regeneratedTracks =
    [
        new("r1", "Storm Glass",    "Haze Collective", "4:12", "melancholy","medium", 82),
        new("r2", "Wet Pavement",   "Dusk Radio",      "3:38", "chill",    "low",    66),
        new("r3", "Cloud Ceiling",  "Slowdive Echo",   "5:24", "dreamy",   "low",    60),
        new("r4", "Grey Canopy",    "Mist & Bloom",    "3:51", "chill",    "medium", 76),
        new("r5", "Drip Sequence",  "Gentle Hum",      "4:03", "melancholy","low",   70),
        new("r6", "Last Drop",      "Cloud Atlas",     "3:19", "dreamy",   "low",    62),
    ];

    private string _prompt = "chill vibes for a rainy day";
    private Track[] _tracks = _initialTracks;
    private bool _generated = true;
    private bool _saved = false;
    private int _cycle = 0;

    private string _totalDuration => "24:21";
    private int _avgBpm => (int)Math.Round(_tracks.Average(t => (double)t.Bpm));

    private void HandleGenerate()
    {
        _generated = true;
        _saved = false;
    }

    private void HandleRegenerate()
    {
        _cycle++;
        _tracks = (_cycle % 2 == 0) ? _initialTracks : _regeneratedTracks;
        _saved = false;
    }

    private void HandleSave()
    {
        _saved = true;
    }

    private static string MoodDot(string mood) => mood switch
    {
        "chill"      => "bg-blue-500",
        "upbeat"     => "bg-amber-500",
        "melancholy" => "bg-violet-500",
        "energetic"  => "bg-red-500",
        "dreamy"     => "bg-emerald-500",
        _            => "bg-muted-foreground",
    };

    private static string EnergyLabel(string energy) => energy switch
    {
        "low"    => "Low",
        "medium" => "Med",
        "high"   => "High",
        _        => energy,
    };
}
