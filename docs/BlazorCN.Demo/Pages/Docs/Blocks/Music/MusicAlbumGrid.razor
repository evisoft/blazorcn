@* ============================================================
   Block: music-album-grid
   Title: MusicAlbumGrid
   Description: An album collection grid block for React and Next.js with album cover placeholders, artist names, genre filter bar, sort by year/name toggle, and play button overlay built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-album-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header with filters *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Albums</span>
                <div class="flex items-center gap-1 rounded-md bg-muted/50 p-0.5">
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-6 px-2 text-xs", _sortBy == "year" ? "bg-background shadow-sm" : "text-muted-foreground")"
                              OnClick="@(() => _sortBy = "year")">
                        Year
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-6 px-2 text-xs", _sortBy == "name" ? "bg-background shadow-sm" : "text-muted-foreground")"
                              OnClick="@(() => _sortBy = "name")">
                        Name
                    </ButtonCn>
                </div>
            </div>
            <div class="mt-2 flex flex-wrap items-center gap-1.5">
                @foreach (var genre in _genres)
                {
                    var g = genre;
                    <BadgeCn Variant="@(_selectedGenre == g ? BadgeVariant.Default : BadgeVariant.Secondary)"
                             Class="cursor-pointer font-normal text-xs"
                             @onclick="@(() => _selectedGenre = g)">
                        @g
                    </BadgeCn>
                }
            </div>
        </div>

        @* Album grid *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-2 gap-3 md:grid-cols-3">
                @foreach (var album in FilteredAlbums)
                {
                    var alb = album;
                    <div class="group"
                         @onmouseenter="@(() => _hoveredAlbum = alb.Id)"
                         @onmouseleave="@(() => _hoveredAlbum = null)">
                        @* Album cover placeholder *@
                        <div class="@($"relative aspect-square overflow-hidden rounded-md {alb.Color}")">
                            <div class="flex size-full items-center justify-center">
                                <span class="font-mono text-muted-foreground/40 text-xs">@GetInitials(alb.Artist)</span>
                            </div>
                            @* Play overlay *@
                            @if (_hoveredAlbum == alb.Id)
                            {
                                <div class="absolute inset-0 flex items-center justify-center bg-black/30">
                                    <ButtonCn Size="ButtonSize.Sm"
                                              Class="size-8 rounded-full p-0"
                                              aria-label="@($"Play {alb.Title}")">
                                        <LucideIconCn Name="play" Size="14" Class="size-3.5" />
                                    </ButtonCn>
                                </div>
                            }
                        </div>
                        <p class="mt-1.5 truncate font-medium text-sm">@alb.Title</p>
                        <div class="flex items-center gap-1.5">
                            <span class="truncate text-muted-foreground text-xs">@alb.Artist</span>
                            <span class="text-muted-foreground text-xs">·</span>
                            <span class="shrink-0 text-muted-foreground text-xs tabular-nums">@alb.Year</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                @FilteredAlbums.Length @(FilteredAlbums.Length == 1 ? "album" : "albums") · Sorted by @_sortBy
            </p>
        </div>

    </div>
</section>

@code {
    private record Album(string Id, string Title, string Artist, int Year, string Genre, string Color);

    private static readonly Album[] _albums =
    [
        new("a1", "Echoes of Tomorrow", "Luna Waves",    2024, "Electronic", "bg-indigo-500/20"),
        new("a2", "Crimson Letters",     "Rosewood",      2023, "Indie",      "bg-rose-500/20"),
        new("a3", "After Hours",         "The Weeknd",    2020, "R&B",        "bg-red-500/20"),
        new("a4", "Random Access Memories", "Daft Punk", 2013, "Electronic", "bg-amber-500/20"),
        new("a5", "In Rainbows",         "Radiohead",     2007, "Rock",       "bg-emerald-500/20"),
        new("a6", "Blonde",              "Frank Ocean",   2016, "R&B",        "bg-sky-500/20"),
        new("a7", "Currents",            "Tame Impala",   2015, "Rock",       "bg-violet-500/20"),
        new("a8", "Immunity",            "Jon Hopkins",   2013, "Electronic", "bg-cyan-500/20"),
        new("a9", "Norman Rockwell",     "Lana Del Rey",  2019, "Indie",      "bg-orange-500/20"),
    ];

    private static readonly string[] _genres = ["All", "Electronic", "Rock", "R&B", "Indie"];

    private string _selectedGenre = "All";
    private string _sortBy = "year";
    private string? _hoveredAlbum;

    private Album[] FilteredAlbums
    {
        get
        {
            var list = _selectedGenre == "All"
                ? _albums
                : _albums.Where(a => a.Genre == _selectedGenre).ToArray();
            return _sortBy == "year"
                ? list.OrderByDescending(a => a.Year).ToArray()
                : list.OrderBy(a => a.Title).ToArray();
        }
    }

    private static string GetInitials(string artist)
    {
        return string.Concat(artist.Split(' ').Select(w => w.Length > 0 ? w[0].ToString() : ""));
    }
}
