@* ============================================================
   Block: music-audio-spectrum
   Title: MusicAudioSpectrum
   Description: An audio spectrum analyzer block for React and Next.js with frequency bar visualization, peak hold indicators, frequency labels, and display mode selector built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-audio-spectrum.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="activity" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Spectrum Analyzer</span>
            </div>
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono font-normal text-xs">
                    44.1kHz
                </BadgeCn>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono font-normal text-xs">
                    Stereo
                </BadgeCn>
            </div>
        </div>

        @* Level meters *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-muted-foreground text-xs">Peak</span>
                <span class="font-mono text-sm tabular-nums">@_peakDb dB</span>
            </div>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <div class="flex items-center gap-2">
                <span class="font-medium text-muted-foreground text-xs">RMS</span>
                <span class="font-mono text-sm tabular-nums">@_rmsDb dB</span>
            </div>
            <div class="ml-auto flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-muted-foreground text-xs">Active</span>
            </div>
        </div>

        @* Spectrum visualization *@
        <div class="border-b px-4 py-4"
             aria-label="Audio spectrum frequency visualization">
            <div class="relative rounded-md bg-zinc-950 p-4">

                @* Bars *@
                <div class="flex items-end justify-between gap-1" style="@($"height:{_maxHeight}px")">
                    @foreach (var band in _bands)
                    {
                        var barHeight = (band.Height / 100.0) * _maxHeight;
                        var peakPosition = (band.Peak / 100.0) * _maxHeight;
                        <div class="relative flex flex-1 flex-col items-center"
                             style="@($"height:{_maxHeight}px")">
                            @* Peak hold indicator *@
                            <div class="absolute left-0 right-0 h-0.5 bg-zinc-400"
                                 style="@($"bottom:{peakPosition}px")"></div>

                            @* Bar *@
                            <div class="@Cn.Merge("absolute bottom-0 left-0 right-0 rounded-t-sm", _mode == "fill" ? "bg-foreground/20" : _mode == "line" ? "border-t-2 border-foreground bg-transparent" : "bg-foreground")"
                                 style="@($"height:{barHeight}px")"></div>
                        </div>
                    }
                </div>

                @* Frequency labels *@
                <div class="mt-2 flex justify-between">
                    @foreach (var band in _bands)
                    {
                        <div class="flex flex-1 flex-col items-center">
                            @if (!string.IsNullOrEmpty(band.Label))
                            {
                                <span class="font-mono text-zinc-500 text-[10px]">@band.Label</span>
                            }
                        </div>
                    }
                </div>

                @* Frequency axis *@
                <div class="mt-1 flex items-center justify-between">
                    <span class="font-mono text-zinc-600 text-[10px]">20Hz</span>
                    <span class="font-mono text-zinc-600 text-[10px]">1kHz</span>
                    <span class="font-mono text-zinc-600 text-[10px]">20kHz</span>
                </div>

            </div>
        </div>

        @* Mode selector *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2 text-muted-foreground">
                <LucideIconCn Name="music" Size="14" Class="size-3.5" />
                <span class="text-xs">Display Mode</span>
            </div>
            <div class="flex items-center gap-1 rounded-md bg-muted/50 p-0.5">
                @foreach (var m in _modes)
                {
                    var modeItem = m;
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-7 gap-1.5 text-xs", _mode == modeItem.Id ? "bg-background shadow-sm" : "text-muted-foreground")"
                              OnClick="@(() => _mode = modeItem.Id)">
                        <LucideIconCn Name="@modeItem.Icon" Size="12" Class="size-3" />
                        @modeItem.Label
                    </ButtonCn>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private record FrequencyBand(string Id, string Label, string Frequency, int Height, int Peak);
    private record ModeOption(string Id, string Label, string Icon);

    private const int _maxHeight = 140;
    private const double _peakDb = -3.2;
    private const double _rmsDb = -12.8;

    private static readonly FrequencyBand[] _bands =
    [
        new("b1",  "Sub",  "20Hz",   45, 58),
        new("b2",  "",     "40Hz",   62, 70),
        new("b3",  "",     "80Hz",   78, 85),
        new("b4",  "Bass", "160Hz",  85, 92),
        new("b5",  "",     "315Hz",  72, 80),
        new("b6",  "",     "630Hz",  58, 68),
        new("b7",  "Mid",  "1kHz",   65, 75),
        new("b8",  "",     "2kHz",   70, 78),
        new("b9",  "",     "4kHz",   55, 65),
        new("b10", "High", "8kHz",   42, 55),
        new("b11", "",     "12kHz",  35, 48),
        new("b12", "",     "16kHz",  28, 40),
        new("b13", "Air",  "20kHz",  18, 30),
    ];

    private static readonly ModeOption[] _modes =
    [
        new("bars", "Bars", "bar-chart-3"),
        new("line", "Line", "activity"),
        new("fill", "Fill", "bar-chart-3"),
    ];

    private string _mode = "bars";
}
