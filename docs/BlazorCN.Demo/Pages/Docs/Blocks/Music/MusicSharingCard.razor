@* ============================================================
   Block: music-sharing-card
   Title: MusicSharingCard
   Description: A music share card generator block for React and Next.js with track display, customizable background color, social platform sharing buttons, copy link action, and QR code built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-sharing-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="share" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Share Track</span>
            </div>
        </div>

        @* Card Preview *@
        <div class="border-b px-4 py-4">
            <div class="overflow-hidden rounded-lg p-5 transition-colors duration-300"
                 style="@($"background-color:{_bgColor}")">
                <div class="flex items-center gap-4">
                    @* Album art placeholder *@
                    <div class="flex size-20 shrink-0 items-center justify-center rounded-md bg-white/10">
                        <LucideIconCn Name="music" Size="32" Class="size-8 text-white/60" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="truncate font-medium text-sm text-white">@_trackTitle</p>
                        <p class="mt-0.5 truncate text-sm text-white/70">@_trackArtist</p>
                        <p class="mt-0.5 truncate text-xs text-white/50">
                            @_trackAlbum &#183; @_trackYear
                        </p>
                        <div class="mt-2 flex items-center gap-2">
                            <div class="h-1 flex-1 overflow-hidden rounded-full bg-white/20">
                                <div class="h-full w-2/3 rounded-full bg-white/60"></div>
                            </div>
                            <span class="font-mono text-white/50 text-xs tabular-nums">@_trackDuration</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Background Color *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="palette" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Background</span>
            </div>
            <div class="relative">
                <button type="button"
                        class="flex items-center gap-2 rounded-md border px-2 py-1 transition-colors hover:bg-muted/50"
                        @onclick="@(() => _colorPickerOpen = !_colorPickerOpen)">
                    <div class="size-4 rounded border" style="@($"background-color:{_bgColor}")"></div>
                    <span class="font-mono text-xs">@_bgColor</span>
                </button>
                @if (_colorPickerOpen)
                {
                    <div class="absolute right-0 z-10 mt-1 rounded-md border bg-popover p-3 shadow-md">
                        <input type="color"
                               value="@_bgColor"
                               aria-label="Background color"
                               @oninput="@((ChangeEventArgs e) => _bgColor = e.Value?.ToString() ?? _bgColor)"
                               class="mb-2 h-8 w-full cursor-pointer rounded border" />
                        <div class="flex gap-1">
                            @foreach (var color in _presetColors)
                            {
                                var c = color;
                                <button type="button"
                                        @onclick="@(() => { _bgColor = c; _colorPickerOpen = false; })"
                                        class="size-6 rounded border transition-transform hover:scale-110"
                                        style="@($"background-color:{c}")"
                                        aria-label="@($"Set background to {c}")"></button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Share Platforms *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Share to</span>
            <div class="flex gap-2">
                @foreach (var platform in _platforms)
                {
                    var plat = platform;
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                              Class="h-8 flex-1 gap-1.5 text-xs"
                              OnClick="@(() => HandlePlatformShare(plat))">
                        <span>@plat.Icon</span>
                        @plat.Name
                        <LucideIconCn Name="external-link" Size="12" Class="size-3 text-muted-foreground/60" />
                    </ButtonCn>
                }
            </div>
        </div>

        @* Copy Link *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="link" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
            <span class="flex-1 truncate font-mono text-muted-foreground text-xs">@_shareUrl</span>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                      Class="h-6 shrink-0 gap-1 px-2 text-xs"
                      OnClick="CopyLink">
                @if (_copied)
                {
                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                    <span>Copied</span>
                }
                else
                {
                    <LucideIconCn Name="copy" Size="12" Class="size-3" />
                    <span>Copy</span>
                }
            </ButtonCn>
        </div>

        @* QR Code *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="qr-code" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">QR Code</span>
            </div>
            <div class="mt-3 flex justify-center">
                <div class="flex size-[136px] items-center justify-center rounded-md bg-muted/50">
                    <span class="text-muted-foreground text-xs">QR Preview</span>
                </div>
            </div>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                Scan to open in music app
            </p>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Share card &#183; Customize and send to friends
            </p>
        </div>

    </div>
</section>

@code {
    private record PlatformInfo(string Id, string Name, string Icon, string? UrlTemplate);

    private const string _trackTitle = "Midnight City";
    private const string _trackArtist = "M83";
    private const string _trackAlbum = "Hurry Up, We're Dreaming";
    private const string _trackYear = "2011";
    private const string _trackDuration = "4:04";
    private const string _shareUrl = "https://listen.acme.com/track/midnight-city";

    private string _bgColor = "#1a1a2e";
    private bool _copied = false;
    private bool _colorPickerOpen = false;

    private static readonly string[] _presetColors = ["#1a1a2e", "#0f3460", "#533483", "#2d4059", "#1b1b2f", "#162447"];

    private static readonly PlatformInfo[] _platforms =
    [
        new("twitter",   "Twitter",   "𝕏",  "https://twitter.com/intent/tweet"),
        new("whatsapp",  "WhatsApp",  "💬", "https://wa.me/"),
        new("instagram", "Instagram", "📷", null),
    ];

    private void CopyLink()
    {
        _copied = true;
        // In a real app: await JS.InvokeVoidAsync("navigator.clipboard.writeText", _shareUrl);
        // Reset after a short delay is not feasible without a timer here; toggled for demo
    }

    private void HandlePlatformShare(PlatformInfo platform)
    {
        if (platform.UrlTemplate == null)
        {
            CopyLink();
        }
        // In a real app: open share URL in new tab via JS
    }
}
