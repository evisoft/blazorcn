@* ============================================================
   Block: music-artist-comparison
   Title: MusicArtistComparison
   Description: An artist comparison stats block for React and Next.js with side-by-side metrics, follower counts, monthly listeners, genre tags, and a verdict indicator built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-artist-comparison.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="mic" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Artist Comparison</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">Side-by-side performance breakdown</p>
        </div>

        @* Artist headers *@
        <div class="grid grid-cols-2 border-b">
            <div class="flex items-center gap-3 border-r px-4 py-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-muted font-medium text-muted-foreground text-xs">
                    @_artistA.Avatar
                </div>
                <div>
                    <span class="font-medium text-sm">@_artistA.Name</span>
                    <div class="mt-0.5">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@_artistA.Genre</BadgeCn>
                    </div>
                </div>
            </div>
            <div class="flex items-center gap-3 px-4 py-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-muted font-medium text-muted-foreground text-xs">
                    @_artistB.Avatar
                </div>
                <div>
                    <span class="font-medium text-sm">@_artistB.Name</span>
                    <div class="mt-0.5">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@_artistB.Genre</BadgeCn>
                    </div>
                </div>
            </div>
        </div>

        @* Stats rows *@
        @for (int i = 0; i < _stats.Length; i++)
        {
            var stat = _stats[i];
            var aLeads = stat.AValue > stat.BValue;
            var bLeads = stat.BValue > stat.AValue;
            var isLast = i == _stats.Length - 1;
            <div class="@Cn.Merge("grid grid-cols-2", isLast ? "" : "border-b")">
                <div class="flex items-center justify-between border-r px-4 py-3">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="@stat.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-muted-foreground text-xs">@stat.Label</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        @if (aLeads)
                        {
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        }
                        <span class="@Cn.Merge("font-semibold text-sm tabular-nums", aLeads ? "" : "text-muted-foreground")">
                            @FormatValue(stat.AValue, stat.Format)
                        </span>
                    </div>
                </div>
                <div class="flex items-center justify-between px-4 py-3">
                    <div class="flex items-center gap-1.5">
                        @if (bLeads)
                        {
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        }
                        <span class="@Cn.Merge("font-semibold text-sm tabular-nums", bLeads ? "" : "text-muted-foreground")">
                            @FormatValue(stat.BValue, stat.Format)
                        </span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-muted-foreground text-xs">@stat.Label</span>
                        <LucideIconCn Name="@stat.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
                    </div>
                </div>
            </div>
        }

        @* Verdict *@
        <div class="border-t bg-muted/30 px-4 py-3">
            <div class="flex items-center justify-center gap-2">
                <LucideIconCn Name="trophy" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">@_verdict</span>
                <span class="text-muted-foreground text-xs">&#183;</span>
                <span class="text-muted-foreground text-xs">@_verdictSubtext</span>
            </div>
        </div>

    </div>
</section>

@code {
    private record Artist(string Name, string Genre, double Followers, double MonthlyListeners, int Albums, double Rating, string Avatar);
    private record StatRow(string Label, string Icon, double AValue, double BValue, string Format);

    private static readonly Artist _artistA = new("Luna Vega", "Indie Pop", 2840000, 8920000, 5, 4.7, "LV");
    private static readonly Artist _artistB = new("Axel Storm", "Electronic", 3120000, 7450000, 8, 4.5, "AS");

    private static readonly StatRow[] _stats =
    [
        new("Followers",         "users",       _artistA.Followers,         _artistB.Followers,         "compact"),
        new("Monthly Listeners", "trending-up", _artistA.MonthlyListeners,  _artistB.MonthlyListeners,  "compact"),
        new("Albums",            "disc-album",  _artistA.Albums,            _artistB.Albums,            "number"),
        new("Avg Rating",        "star",        _artistA.Rating,            _artistB.Rating,            "decimal"),
    ];

    private static int AWins => _stats.Count(s => s.AValue > s.BValue);
    private static int BWins => _stats.Count(s => s.BValue > s.AValue);

    private static string _verdict => AWins > BWins ? _artistA.Name : BWins > AWins ? _artistB.Name : "Tied";

    private static string _verdictSubtext =>
        _verdict == "Tied"
            ? "Both artists are evenly matched"
            : $"Leads in {Math.Max(AWins, BWins)} of {_stats.Length} categories";

    private static string FormatValue(double n, string format) => format switch
    {
        "compact" => FormatCompact(n),
        "decimal" => n.ToString("F1"),
        _ => ((int)n).ToString()
    };

    private static string FormatCompact(double n)
    {
        if (n >= 1_000_000) return $"{(n / 1_000_000):F1}M";
        if (n >= 1_000)     return $"{(n / 1_000):F0}K";
        return ((int)n).ToString();
    }
}
