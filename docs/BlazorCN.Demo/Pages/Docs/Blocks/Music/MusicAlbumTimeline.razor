@* ============================================================
   Block: music-album-timeline
   Title: MusicAlbumTimeline
   Description: An artist discography timeline block for React and Next.js with chronological album releases, album art placeholders, critical ratings, and genre evolution visualization built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-album-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="disc" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Discography</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_albums.Length albums
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Neon Waves &middot; @_albums[0].Year&ndash;@_albums[_albums.Length - 1].Year
            </p>
        </div>

        @* Genre Evolution *@
        <div class="flex items-center gap-2 overflow-x-auto border-b px-4 py-2.5">
            <span class="shrink-0 font-medium text-muted-foreground text-xs">
                Genre Evolution
            </span>
            <div class="flex items-center gap-1">
                @for (int i = 0; i < _genreEvolution.Length; i++)
                {
                    var genre = _genreEvolution[i];
                    var idx = i;
                    <div class="flex items-center gap-1">
                        @if (idx > 0)
                        {
                            <LucideIconCn Name="chevron-right" Size="12" Class="size-3 text-muted-foreground/40" />
                        }
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">
                            @genre
                        </BadgeCn>
                    </div>
                }
            </div>
        </div>

        @* Albums *@
        <div>
            @for (int i = 0; i < _albums.Length; i++)
            {
                var album = _albums[i];
                var isLast = i == _albums.Length - 1;
                var isExpanded = _expanded == album.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => { var id = album.Id; _expanded = (_expanded == id ? null : id); })"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        @* Album art placeholder *@
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="disc" Size="16" Class="size-4 text-muted-foreground/60" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@album.Title</span>
                                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                    <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                    @album.Year
                                </span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2">
                                <div class="flex items-center gap-1">
                                    <LucideIconCn Name="star" Size="12" Class="size-3 text-muted-foreground" />
                                    <span class="font-semibold text-xs tabular-nums @RatingColor(album.Rating)">
                                        @album.Rating
                                    </span>
                                </div>
                                <span class="text-muted-foreground text-xs">&middot;</span>
                                <span class="text-muted-foreground text-xs">
                                    @album.TrackCount tracks &middot; @album.Duration
                                </span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-[4.25rem]">
                            <p class="mb-3 text-muted-foreground text-sm leading-relaxed">
                                @album.Description
                            </p>
                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var genre in album.Genres)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                        @genre
                                    </BadgeCn>
                                }
                            </div>
                            <div class="mt-3">
                                <div class="mb-1 flex items-center justify-between">
                                    <span class="text-muted-foreground text-xs">@album.RatingSource</span>
                                    <span class="font-semibold text-xs tabular-nums @RatingColor(album.Rating)">
                                        @album.Rating/100
                                    </span>
                                </div>
                                <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                                    <div class="h-full rounded-full @RatingBarColor(album.Rating)" style="@($"width:{album.Rating}%")"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Album(
        string Id,
        string Title,
        int Year,
        string[] Genres,
        int Rating,
        string RatingSource,
        int TrackCount,
        string Duration,
        string Description);

    private static readonly Album[] _albums =
    [
        new("a1", "First Light", 2016,
            ["Indie Rock", "Lo-fi"],
            72, "Metacritic", 10, "38 min",
            "A raw debut that introduced hazy guitar tones and introspective lyricism. Recorded in a basement over two weekends."),
        new("a2", "Tidal Patterns", 2018,
            ["Indie Pop", "Synth Pop"],
            81, "Metacritic", 12, "44 min",
            "A polished sophomore effort that leaned into synthesizers and layered production. Featured the breakout single Glass Highway."),
        new("a3", "Neon Architectures", 2020,
            ["Synth Wave", "Electronic"],
            88, "Metacritic", 11, "42 min",
            "A bold pivot into electronic territory with pulsing basslines and cinematic textures. Critically acclaimed as a career-best."),
        new("a4", "Quiet Machines", 2022,
            ["Ambient", "Electronic", "Dream Pop"],
            84, "Metacritic", 9, "46 min",
            "An introspective downtempo record exploring silence and space. Stripped-back arrangements with subtle field recordings."),
        new("a5", "Solar Return", 2025,
            ["Art Pop", "Indie Electronic"],
            91, "Metacritic", 13, "51 min",
            "A career-spanning synthesis of every era. Orchestral arrangements meet digital production across an ambitious double concept album."),
    ];

    private static readonly string[] _genreEvolution =
        ["Indie Rock", "Indie Pop", "Synth Wave", "Ambient", "Art Pop"];

    private string? _expanded = "a3";

    private static string RatingColor(int rating) =>
        rating >= 85
            ? "text-emerald-600 dark:text-emerald-400"
            : rating >= 70
                ? "text-amber-600 dark:text-amber-400"
                : "text-red-600 dark:text-red-400";

    private static string RatingBarColor(int rating) =>
        rating >= 85 ? "bg-emerald-500" : rating >= 70 ? "bg-amber-500" : "bg-red-500";
}
