@* ============================================================
   Block: music-ear-training
   Title: MusicEarTraining
   Description: An ear training exercise block for React and Next.js with interval recognition, play button, multiple choice answers, score counter, difficulty selector, and streak display built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-ear-training.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="music" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Ear Training</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="flame" Size="14" Class="size-3.5 text-amber-500" />
                    <span class="font-medium text-xs tabular-nums">@_streak</span>
                    <span class="text-muted-foreground text-xs">streak</span>
                </div>
            </div>
        </div>

        @* Difficulty Selector *@
        <div class="flex items-center gap-1.5 border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Difficulty</span>
            <div class="ml-auto flex items-center gap-1 rounded-md bg-muted/50 p-0.5">
                @foreach (var d in _difficulties)
                {
                    var diff = d;
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-7 text-xs", _difficulty == diff ? "bg-background shadow-sm" : "text-muted-foreground")"
                              OnClick="@(() => _difficulty = diff)">
                        @diff
                    </ButtonCn>
                }
            </div>
        </div>

        @* Score Summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="font-semibold text-2xl tabular-nums">@_score</span>
                <span class="text-muted-foreground text-xs">/ @_totalAnswered correct</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @Accuracy% accuracy
            </BadgeCn>
            <span class="ml-auto text-muted-foreground text-xs">
                Best streak: <span class="font-medium tabular-nums">@_bestStreak</span>
            </span>
        </div>

        @* Play Area *@
        <div class="border-b px-4 py-6">
            <div class="flex flex-col items-center gap-4">
                <p class="text-muted-foreground text-xs">
                    Identify the interval between the two notes
                </p>
                <div class="flex items-center gap-3">
                    <span class="font-mono text-sm">@CurrentQuestion.Interval</span>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                              Class="h-8 gap-1.5 text-xs"
                              OnClick="HandlePlay">
                        <LucideIconCn Name="play" Size="12" Class="size-3" />
                        @(_hasPlayed ? "Replay" : "Play")
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Answer Options *@
        <div class="border-b px-4 py-4">
            <div class="grid grid-cols-2 gap-2">
                @foreach (var (option, i) in CurrentQuestion.Options.Select((o, idx) => (o, idx)))
                {
                    var optIndex = i;
                    var isSelected = _selected == optIndex;
                    var isCorrectAnswer = optIndex == CurrentQuestion.Correct;
                    var showResult = _selected != null;
                    var btnClass = "";
                    if (showResult && isCorrectAnswer)
                        btnClass = "border-emerald-500 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-500/10";
                    else if (showResult && isSelected && !isCorrectAnswer)
                        btnClass = "border-red-500 bg-red-500/10 text-red-600 dark:text-red-400 hover:bg-red-500/10";
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-10 text-xs", btnClass)"
                              OnClick="@(() => HandleAnswer(optIndex))"
                              Disabled="@(_selected != null)">
                        @if (showResult && isCorrectAnswer)
                        {
                            <LucideIconCn Name="check" Size="12" Class="mr-1 size-3" />
                        }
                        @if (showResult && isSelected && !isCorrectAnswer)
                        {
                            <LucideIconCn Name="x" Size="12" Class="mr-1 size-3" />
                        }
                        @option
                    </ButtonCn>
                }
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Question @(_currentIndex + 1) of @_questions.Length &middot; @_difficulty mode
            </p>
        </div>

    </div>
</section>

@code {
    private record Question(string Id, string Interval, string[] Options, int Correct);

    private static readonly Question[] _questions =
    [
        new("q1", "C4 → G4",  ["Major 3rd",  "Perfect 5th", "Perfect 4th", "Minor 6th"],  1),
        new("q2", "D4 → F#4", ["Minor 3rd",  "Perfect 4th", "Major 3rd",   "Tritone"],    2),
        new("q3", "E4 → C5",  ["Major 6th",  "Minor 7th",   "Perfect 5th", "Minor 6th"],  3),
        new("q4", "A3 → A4",  ["Perfect 5th","Major 7th",   "Octave",      "Minor 6th"],  2),
        new("q5", "F4 → Ab4", ["Minor 3rd",  "Major 2nd",   "Perfect 4th", "Minor 2nd"],  0),
    ];

    private static readonly string[] _difficulties = ["Beginner", "Intermediate", "Advanced"];

    private string _difficulty = "Beginner";
    private int _currentIndex = 0;
    private int _score = 0;
    private int _streak = 3;
    private int _bestStreak = 7;
    private int? _selected = null;
    private bool _hasPlayed = false;
    private int _totalAnswered = 12;

    private Question CurrentQuestion => _questions[_currentIndex];
    private int Accuracy => _totalAnswered > 0 ? (int)Math.Round((double)_score / _totalAnswered * 100) : 0;

    private void HandlePlay()
    {
        _hasPlayed = true;
    }

    private void HandleAnswer(int optionIndex)
    {
        if (_selected != null) return;
        _selected = optionIndex;

        var isCorrect = optionIndex == CurrentQuestion.Correct;
        if (isCorrect)
        {
            _score++;
            var newStreak = _streak + 1;
            _streak = newStreak;
            if (newStreak > _bestStreak)
                _bestStreak = newStreak;
        }
        else
        {
            _streak = 0;
        }
        _totalAnswered++;
    }
}
