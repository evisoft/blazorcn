@* ============================================================
   Block: music-podcast-subscription
   Title: MusicPodcastSubscription
   Description: A podcast subscription management block for React and Next.js with subscribed shows list, episode queue count, notification toggles, and unsubscribe actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-podcast-subscription.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="podcast" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Subscriptions</span>
            </div>
            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                <span>@_shows.Count shows</span>
                <span>&middot;</span>
                <span>@TotalQueue in queue</span>
            </div>
        </div>

        @* Show list *@
        <div>
            @foreach (var (show, index) in _shows.Select((s, i) => (s, i)))
            {
                var isLast = index == _shows.Count - 1;
                var showItem = show;
                <div class="@Cn.Merge(isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3 px-4 py-3">

                        @* Show artwork *@
                        <div class="@Cn.Merge("flex size-9 shrink-0 items-center justify-center rounded-md text-white font-semibold text-xs", show.CoverColor)">
                            @show.CoverInitial
                        </div>

                        @* Show info *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate font-medium text-sm">@show.Title</span>
                                @if (show.EpisodeQueue > 0)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">
                                        <LucideIconCn Name="list-music" Size="12" Class="mr-1 size-3" />
                                        @show.EpisodeQueue
                                    </BadgeCn>
                                }
                            </div>
                            <p class="text-muted-foreground text-xs">
                                @show.Publisher &middot; @show.Frequency
                            </p>
                        </div>

                        @* Notification toggle *@
                        <div class="flex shrink-0 items-center gap-1">
                            @if (show.Notifications)
                            {
                                <LucideIconCn Name="bell" Size="12" Class="size-3 text-muted-foreground" />
                            }
                            else
                            {
                                <LucideIconCn Name="bell-off" Size="12" Class="size-3 text-muted-foreground" />
                            }
                            <SwitchCn Checked="@show.Notifications"
                                      CheckedChanged="@(() => ToggleNotifications(showItem.Id))"
                                      Class="scale-75" />
                        </div>

                        @* Unsubscribe *@
                        <ButtonCn Variant="ButtonVariant.Ghost"
                                  Size="ButtonSize.Sm"
                                  Class="size-7 shrink-0 p-0 text-muted-foreground hover:text-red-500"
                                  OnClick="@(() => Unsubscribe(showItem.Id))"
                                  aria-label="@($"Unsubscribe from {show.Title}")">
                            <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                        </ButtonCn>

                    </div>
                </div>
            }
        </div>

        @* Empty state *@
        @if (_shows.Count == 0)
        {
            <div class="px-4 py-8 text-center">
                <LucideIconCn Name="podcast" Size="20" Class="mx-auto size-5 text-muted-foreground" />
                <p class="mt-2 text-muted-foreground text-sm">No subscriptions yet</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Browse the directory to find shows you love
                </p>
            </div>
        }

        @* Footer *@
        @if (_shows.Count > 0)
        {
            <div class="border-t px-4 py-2.5">
                <p class="text-center text-muted-foreground text-xs">
                    New episodes auto-added to queue &middot; Manage in settings
                </p>
            </div>
        }

    </div>
</section>

@code {
    private record Show(string Id, string Title, string Publisher, int EpisodeQueue, bool Notifications, string CoverColor, string CoverInitial, string Frequency);

    private List<Show> _shows =
    [
        new("s1", "The Daily",                  "The New York Times",          12, true,  "bg-zinc-800",   "TD", "Daily"),
        new("s2", "Lex Fridman Podcast",         "Lex Fridman",                  3, true,  "bg-violet-600", "LF", "Weekly"),
        new("s3", "Huberman Lab",                "Andrew Huberman",              7, false, "bg-sky-600",    "HL", "Weekly"),
        new("s4", "Acquired",                    "Ben Gilbert & David Rosenthal",1, true,  "bg-amber-600",  "AQ", "Biweekly"),
        new("s5", "Darknet Diaries",             "Jack Rhysider",                5, false, "bg-emerald-700","DD", "Biweekly"),
        new("s6", "Software Engineering Daily",  "SE Daily",                    22, true,  "bg-rose-600",   "SE", "Daily"),
    ];

    private int TotalQueue => _shows.Sum(s => s.EpisodeQueue);

    private void ToggleNotifications(string id)
    {
        var idx = _shows.FindIndex(s => s.Id == id);
        if (idx >= 0)
        {
            var s = _shows[idx];
            _shows[idx] = s with { Notifications = !s.Notifications };
        }
    }

    private void Unsubscribe(string id)
    {
        _shows.RemoveAll(s => s.Id == id);
    }
}
