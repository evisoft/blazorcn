@* ============================================================
   Block: music-podcast-directory
   Title: MusicPodcastDirectory
   Description: A podcast directory block for React and Next.js with show cards, category filters, star ratings, episode counts, subscribe buttons, and search bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-podcast-directory.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="headphones" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Podcast Directory</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Browse and subscribe to your favorite shows.
            </p>
        </div>

        @* Search *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="search" Size="14" Class="size-3.5 text-muted-foreground" />
                <InputCn @bind-Value="_search"
                         Placeholder="Search podcasts..."
                         aria-label="Search podcasts"
                         Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
            </div>
        </div>

        @* Category Filters *@
        <div class="flex flex-wrap items-center gap-1.5 border-b px-4 py-3">
            @foreach (var cat in _categories)
            {
                var catItem = cat;
                <ButtonCn Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.Sm"
                          Class="@Cn.Merge("h-7 text-xs", _activeCategory == catItem ? "bg-foreground text-background hover:bg-foreground/90 hover:text-background" : "text-muted-foreground")"
                          OnClick="@(() => _activeCategory = catItem)">
                    @catItem
                </ButtonCn>
            }
        </div>

        @* Podcast List *@
        <div>
            @{
                var filtered = _podcasts
                    .Where(p => (_activeCategory == "All" || p.Category == _activeCategory)
                             && (_search == "" || p.Title.ToLower().Contains(_search.ToLower()) || p.Host.ToLower().Contains(_search.ToLower())))
                    .ToArray();
            }
            @foreach (var (podcast, index) in filtered.Select((p, i) => (p, i)))
            {
                var isLast = index == filtered.Length - 1;
                var isSub = _subscribed.Contains(podcast.Id);
                var pod = podcast;
                <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex items-start gap-3">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="headphones" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@podcast.Title</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                    @podcast.Category
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@podcast.Host</p>
                            <p class="mt-1 line-clamp-1 text-muted-foreground text-xs">
                                @podcast.Description
                            </p>
                            <div class="mt-2 flex items-center gap-3">
                                @* Star Rating *@
                                <span class="flex items-center gap-0.5" role="img" aria-label="@($"{podcast.Rating} out of 5 stars")">
                                    @{
                                        var fullStars = (int)Math.Floor(podcast.Rating);
                                        var hasHalf = podcast.Rating - fullStars >= 0.5;
                                    }
                                    @for (int si = 0; si < 5; si++)
                                    {
                                        var starIndex = si;
                                        var starClass = starIndex < fullStars
                                            ? "size-3 fill-amber-400 text-amber-400"
                                            : (starIndex == fullStars && hasHalf
                                                ? "size-3 fill-amber-400/50 text-amber-400"
                                                : "size-3 text-muted-foreground/30");
                                        <LucideIconCn Name="star" Size="12" Class="@starClass" />
                                    }
                                    <span class="ml-1 font-medium text-xs tabular-nums">@podcast.Rating</span>
                                </span>
                                <span class="text-muted-foreground text-xs">&middot;</span>
                                <span class="text-muted-foreground text-xs tabular-nums">
                                    @podcast.Episodes episodes
                                </span>
                            </div>
                        </div>
                        <ButtonCn Variant="@(isSub ? ButtonVariant.Outline : ButtonVariant.Default)"
                                  Size="ButtonSize.Sm"
                                  Class="h-7 shrink-0 text-xs"
                                  OnClick="@(() => ToggleSubscribe(pod.Id))">
                            @(isSub ? "Subscribed" : "Subscribe")
                        </ButtonCn>
                    </div>
                </div>
            }

            @if (!_podcasts.Any(p => (_activeCategory == "All" || p.Category == _activeCategory)
                                  && (_search == "" || p.Title.ToLower().Contains(_search.ToLower()) || p.Host.ToLower().Contains(_search.ToLower()))))
            {
                <div class="px-4 py-8 text-center">
                    <p class="text-muted-foreground text-sm">
                        No podcasts found matching your search.
                    </p>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between text-muted-foreground text-xs">
                <span>
                    @{
                        var footerFiltered = _podcasts
                            .Where(p => (_activeCategory == "All" || p.Category == _activeCategory)
                                     && (_search == "" || p.Title.ToLower().Contains(_search.ToLower()) || p.Host.ToLower().Contains(_search.ToLower())))
                            .ToArray();
                    }
                    @footerFiltered.Length show@(footerFiltered.Length != 1 ? "s" : "")
                </span>
                <span>@_subscribed.Count subscribed</span>
            </div>
        </div>

    </div>
</section>

@code {
    private record Podcast(string Id, string Title, string Host, string Category, double Rating, int Episodes, string Description);

    private static readonly string[] _categories = ["All", "Tech", "Comedy", "News", "Business", "Crime"];

    private static readonly Podcast[] _podcasts =
    [
        new("p1", "Syntax FM",                 "Wes Bos & Scott Tolinski",    "Tech",     4.8, 842,  "Full stack web development tutorials covering JavaScript, React, CSS, and developer tooling."),
        new("p2", "Conan Needs a Friend",       "Conan O'Brien",               "Comedy",   4.9, 312,  "Conan sits down with celebrities, comedians, and interesting people for unscripted conversations."),
        new("p3", "The Daily",                  "Michael Barbaro",             "News",     4.6, 1580, "Twenty minutes a day covering the biggest stories in news with expert reporting and analysis."),
        new("p4", "How I Built This",           "Guy Raz",                     "Business", 4.7, 524,  "Founders and innovators share the stories behind the companies and movements they built."),
        new("p5", "Serial",                     "Sarah Koenig",                "Crime",    4.9, 48,   "Investigative journalism at its finest, telling one story over the course of a season."),
        new("p6", "Acquired",                   "Ben Gilbert & David Rosenthal","Business", 4.8, 216,  "Deep-dive episodes on the greatest technology acquisitions and companies of all time."),
        new("p7", "Darknet Diaries",            "Jack Rhysider",               "Crime",    4.9, 178,  "True stories from the dark side of the internet, covering hackers, breaches, and cybercrime."),
        new("p8", "Wait Wait... Don't Tell Me!", "Peter Sagal",                "Comedy",   4.5, 1240, "NPR's weekly news quiz show blending current events with humor and celebrity guests."),
    ];

    private string _activeCategory = "All";
    private string _search = "";
    private HashSet<string> _subscribed = ["p1", "p3"];

    private void ToggleSubscribe(string id)
    {
        if (_subscribed.Contains(id))
            _subscribed.Remove(id);
        else
            _subscribed.Add(id);
    }
}
