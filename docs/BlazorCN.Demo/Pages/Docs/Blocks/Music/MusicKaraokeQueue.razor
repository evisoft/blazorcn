@* ============================================================
   Block: music-karaoke-queue
   Title: MusicKaraokeQueue
   Description: A karaoke queue management block for React and Next.js with singer queue list, currently performing display, estimated wait times, join queue form, and position tracking built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-karaoke-queue.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="mic" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Karaoke Queue</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_queue.Count waiting
                </BadgeCn>
            </div>
        </div>

        @* Currently Performing *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Now Performing</span>
            <div class="mt-1.5 flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded-full bg-foreground">
                    <LucideIconCn Name="mic" Size="14" Class="size-3.5 text-background" />
                </div>
                <div class="min-w-0 flex-1">
                    <span class="font-medium text-sm">@_currentPerformer.Singer</span>
                    <p class="text-muted-foreground text-xs">
                        @_currentPerformer.Song
                        <span class="text-muted-foreground/60">&middot; @_currentPerformer.Artist</span>
                    </p>
                </div>
                <div class="flex items-center gap-1 text-muted-foreground text-xs">
                    <LucideIconCn Name="clock" Size="12" Class="size-3" />
                    <span class="font-mono tabular-nums">@_currentPerformer.Elapsed</span>
                    <span>/</span>
                    <span class="font-mono tabular-nums">@_currentPerformer.Duration</span>
                </div>
            </div>
        </div>

        @* Queue List *@
        <div class="border-b">
            @if (_queue.Count == 0)
            {
                <div class="px-4 py-6 text-center text-muted-foreground text-sm">
                    The queue is empty. Be the first to sign up!
                </div>
            }
            else
            {
                @for (int i = 0; i < _queue.Count; i++)
                {
                    var entry = _queue[i];
                    var index = i;
                    var waitMinutes = (index + 1) * AvgSongDuration;
                    var isLast = index == _queue.Count - 1;
                    <div class="@(isLast ? "flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50" : "flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50 border-b")">

                        @* Position number *@
                        <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted font-mono font-medium text-muted-foreground text-xs">
                            @(index + 1)
                        </span>

                        @* Singer & song info *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@entry.Singer</span>
                            </div>
                            <p class="truncate text-muted-foreground text-xs">
                                @entry.Song
                                <span class="text-muted-foreground/60">&middot; @entry.Artist</span>
                            </p>
                        </div>

                        @* Wait time *@
                        <span class="shrink-0 text-muted-foreground text-xs tabular-nums">
                            ~@(waitMinutes) min
                        </span>

                        @* Remove button *@
                        <div @onclick:stopPropagation>
                            <ButtonCn Variant="ButtonVariant.Ghost"
                                      Size="ButtonSize.Sm"
                                      Class="size-6 shrink-0 p-0 text-muted-foreground"
                                      OnClick="@(() => HandleRemove(entry.Id))"
                                      aria-label="@($"Remove {entry.Singer} from queue")">
                                <LucideIconCn Name="trash" Size="12" Class="size-3" />
                            </ButtonCn>
                        </div>
                    </div>
                }
            }
        </div>

        @* Join Queue Form *@
        <div class="border-b px-4 py-3">
            <div class="mb-2.5 flex items-center gap-2">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-xs">Join the Queue</span>
            </div>
            <div class="space-y-2">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="user" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                    <InputCn @bind-Value="_singerName"
                             Placeholder="Your name"
                             Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
                </div>
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="music" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                    <InputCn @bind-Value="_songTitle"
                             Placeholder="Song title"
                             Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
                </div>
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="mic" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                    <InputCn @bind-Value="_songArtist"
                             Placeholder="Artist (optional)"
                             Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
                </div>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs" OnClick="HandleJoin">
                    Join Queue
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Avg. @AvgSongDuration min per song &middot; Est. total wait @(_queue.Count * AvgSongDuration) min
            </p>
        </div>

    </div>
</section>

@code {
    private record QueueEntry(string Id, string Singer, string Song, string Artist);

    private record PerformerInfo(string Singer, string Song, string Artist, string Elapsed, string Duration);

    private const int AvgSongDuration = 4;

    private static readonly PerformerInfo _currentPerformer = new(
        "Mia Torres",
        "Bohemian Rhapsody",
        "Queen",
        "2:34",
        "5:55"
    );

    private List<QueueEntry> _queue =
    [
        new("q1", "Jake Chen",      "Don't Stop Believin'",   "Journey"),
        new("q2", "Priya Sharma",   "Rolling in the Deep",    "Adele"),
        new("q3", "Leo Kim",        "Mr. Brightside",         "The Killers"),
        new("q4", "Nina Williams",  "Sweet Caroline",         "Neil Diamond"),
        new("q5", "Alex Rivera",    "Livin' on a Prayer",     "Bon Jovi"),
    ];

    private string _singerName = "";
    private string _songTitle = "";
    private string _songArtist = "";
    private int _nextId = 6;

    private void HandleJoin()
    {
        if (string.IsNullOrWhiteSpace(_singerName) || string.IsNullOrWhiteSpace(_songTitle))
            return;

        var entry = new QueueEntry(
            $"q{_nextId++}",
            _singerName.Trim(),
            _songTitle.Trim(),
            string.IsNullOrWhiteSpace(_songArtist) ? "Unknown" : _songArtist.Trim()
        );
        _queue.Add(entry);
        _singerName = "";
        _songTitle = "";
        _songArtist = "";
    }

    private void HandleRemove(string id)
    {
        _queue.RemoveAll(e => e.Id == id);
    }
}
