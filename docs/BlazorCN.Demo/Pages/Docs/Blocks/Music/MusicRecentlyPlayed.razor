@* ============================================================
   Block: music-recently-played
   Title: MusicRecentlyPlayed
   Description: A recently played music tracks block for React and Next.js with album art placeholders, track and artist names, play counts, time grouping, and play-again buttons built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-recently-played.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="clock" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Recently Played</span>
            </div>
            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                <span>@_totalTracks tracks</span>
                <span>&middot;</span>
                <span>Last 7 days</span>
            </div>
        </div>

        @* Track groups *@
        @foreach (var grp in _trackGroups)
        {
            var group = grp;
            <div>
                @* Group label *@
                <div class="border-b bg-muted/30 px-4 py-2">
                    <span class="font-medium text-muted-foreground text-xs">@group.Label</span>
                </div>

                @* Tracks *@
                @for (int ti = 0; ti < group.Tracks.Length; ti++)
                {
                    var track = group.Tracks[ti];
                    bool isLastGroup = group.Label == _trackGroups[_trackGroups.Length - 1].Label;
                    bool isLastTrack = isLastGroup && ti == group.Tracks.Length - 1;
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLastTrack ? "" : "border-b")">

                        @* Album art placeholder *@
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="music" Size="16" Class="size-4 text-muted-foreground" />
                        </div>

                        @* Track info *@
                        <div class="min-w-0 flex-1">
                            <span class="block truncate font-medium text-sm">@track.Title</span>
                            <span class="block truncate text-muted-foreground text-xs">
                                @track.Artist · @track.Album
                            </span>
                        </div>

                        @* Play count *@
                        <div class="hidden items-center gap-1.5 sm:flex">
                            <LucideIconCn Name="headphones" Size="12" Class="size-3 text-muted-foreground" />
                            <span class="font-mono text-muted-foreground text-xs tabular-nums">
                                @track.PlayCount
                            </span>
                        </div>

                        @* Time ago *@
                        <span class="hidden shrink-0 text-muted-foreground text-xs sm:block">
                            @track.PlayedAgo
                        </span>

                        @* Duration *@
                        <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                            @track.DurationLabel
                        </span>

                        @* Play again *@
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                  Class="size-7 shrink-0 p-0"
                                  aria-label="@($"Play {track.Title} again")">
                            <LucideIconCn Name="play" Size="14" Class="size-3.5" />
                        </ButtonCn>
                    </div>
                }
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Showing last 7 days · Older history available in your library
            </p>
        </div>

    </div>
</section>

@code {
    private record Track(string Id, string Title, string Artist, string Album, string PlayedAgo, int PlayCount, string DurationLabel);
    private record TrackGroup(string Label, Track[] Tracks);

    private static readonly TrackGroup[] _trackGroups =
    [
        new("Today",
        [
            new("t1", "Midnight City", "M83", "Hurry Up, We're Dreaming", "12 min ago", 47, "4:03"),
            new("t2", "Bohemian Rhapsody", "Queen", "A Night at the Opera", "38 min ago", 124, "5:55"),
            new("t3", "Blinding Lights", "The Weeknd", "After Hours", "1 hr ago", 89, "3:20"),
        ]),
        new("Yesterday",
        [
            new("t4", "Starboy", "The Weeknd", "Starboy", "18 hr ago", 63, "3:50"),
            new("t5", "Take On Me", "a-ha", "Hunting High and Low", "22 hr ago", 31, "3:48"),
        ]),
        new("This Week",
        [
            new("t6", "Lose Yourself", "Eminem", "8 Mile Soundtrack", "3 days ago", 56, "5:26"),
            new("t7", "Somebody That I Used to Know", "Gotye", "Making Mirrors", "4 days ago", 18, "4:04"),
            new("t8", "Electric Feel", "MGMT", "Oracular Spectacular", "5 days ago", 42, "3:49"),
        ]),
    ];

    private static readonly int _totalTracks = _trackGroups.Length > 0
        ? _trackGroups[0].Tracks.Length + _trackGroups[1].Tracks.Length + _trackGroups[2].Tracks.Length
        : 0;
}
