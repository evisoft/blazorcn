@* ============================================================
   Block: music-library-browser
   Title: MusicLibraryBrowser
   Description: A music library browser block for React and Next.js with tabbed views for songs, albums, artists, and genres, sortable columns, search input, and library stats built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-library-browser.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header with search *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="library" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Library</span>
            <div class="relative ml-auto flex-1 max-w-[220px]">
                <LucideIconCn Name="search" Size="14" Class="absolute top-1/2 left-2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn @bind-Value="_search"
                         Placeholder="Search library..."
                         Class="h-8 border-0 bg-muted/50 pr-3 pl-7 text-xs shadow-none focus-visible:ring-0" />
            </div>
        </div>

        @* Tabs *@
        <TabsCn Value="@_activeTab" ValueChanged="@((string v) => _activeTab = v)">
            <div class="border-b px-4">
                <TabsListCn Class="h-9 w-full justify-start bg-transparent p-0">
                    <TabsTriggerCn Value="songs" Class="gap-1.5 data-[state=active]:bg-transparent data-[state=active]:shadow-none">
                        <LucideIconCn Name="music" Size="12" Class="size-3" />
                        <span class="text-xs">Songs</span>
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="albums" Class="gap-1.5 data-[state=active]:bg-transparent data-[state=active]:shadow-none">
                        <LucideIconCn Name="disc" Size="12" Class="size-3" />
                        <span class="text-xs">Albums</span>
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="artists" Class="gap-1.5 data-[state=active]:bg-transparent data-[state=active]:shadow-none">
                        <LucideIconCn Name="mic" Size="12" Class="size-3" />
                        <span class="text-xs">Artists</span>
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="genres" Class="gap-1.5 data-[state=active]:bg-transparent data-[state=active]:shadow-none">
                        <LucideIconCn Name="tag" Size="12" Class="size-3" />
                        <span class="text-xs">Genres</span>
                    </TabsTriggerCn>
                </TabsListCn>
            </div>

            @* Songs tab *@
            <TabsContentCn Value="songs" Class="m-0">
                @* Column headers *@
                <div class="flex items-center gap-3 border-b px-4 py-2">
                    <button type="button"
                            @onclick="@(() => ToggleSort("title"))"
                            class="flex flex-1 items-center gap-1 text-left font-medium text-muted-foreground text-xs">
                        Name @if (_sortKey == "title") { <LucideIconCn Name="@(_sortDir == "asc" ? "arrow-up" : "arrow-down")" Size="12" Class="size-3" /> }
                    </button>
                    <button type="button"
                            @onclick="@(() => ToggleSort("artist"))"
                            class="flex w-28 items-center gap-1 text-left font-medium text-muted-foreground text-xs">
                        Artist @if (_sortKey == "artist") { <LucideIconCn Name="@(_sortDir == "asc" ? "arrow-up" : "arrow-down")" Size="12" Class="size-3" /> }
                    </button>
                    <button type="button"
                            @onclick="@(() => ToggleSort("duration"))"
                            class="flex w-14 items-center justify-end gap-1 font-medium text-muted-foreground text-xs">
                        Time @if (_sortKey == "duration") { <LucideIconCn Name="@(_sortDir == "asc" ? "arrow-up" : "arrow-down")" Size="12" Class="size-3" /> }
                    </button>
                    <button type="button"
                            @onclick="@(() => ToggleSort("addedDate"))"
                            class="flex w-24 items-center justify-end gap-1 font-medium text-muted-foreground text-xs">
                        Added @if (_sortKey == "addedDate") { <LucideIconCn Name="@(_sortDir == "asc" ? "arrow-up" : "arrow-down")" Size="12" Class="size-3" /> }
                    </button>
                </div>

                @* Song rows *@
                <div>
                    @{
                        var filteredSongs = GetFilteredSongs();
                    }
                    @foreach (var song in filteredSongs)
                    {
                        var s = song;
                        var isLast = s.Id == filteredSongs[filteredSongs.Length - 1].Id;
                        <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                            <div class="min-w-0 flex-1">
                                <span class="block truncate text-sm">@s.Title</span>
                                <span class="block truncate text-muted-foreground text-xs sm:hidden">@s.Artist</span>
                            </div>
                            <span class="hidden w-28 truncate text-muted-foreground text-xs sm:block">@s.Artist</span>
                            <span class="w-14 text-right font-mono text-muted-foreground text-xs tabular-nums">@s.Duration</span>
                            <span class="hidden w-24 text-right text-muted-foreground text-xs sm:block">@s.AddedDate</span>
                        </div>
                    }
                    @if (filteredSongs.Length == 0)
                    {
                        <div class="px-4 py-8 text-center text-muted-foreground text-xs">
                            No songs match your search
                        </div>
                    }
                </div>
            </TabsContentCn>

            @* Albums tab *@
            <TabsContentCn Value="albums" Class="m-0">
                <div>
                    @{
                        var filteredAlbums = GetFilteredAlbums();
                    }
                    @foreach (var album in filteredAlbums)
                    {
                        var alb = album;
                        var albumSongs = _songs.Where(s => s.Album == alb).ToArray();
                        var albumArtist = albumSongs.Length > 0 ? albumSongs[0].Artist : "";
                        var isLastAlb = alb == filteredAlbums[filteredAlbums.Length - 1];
                        <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLastAlb ? "border-b" : "")">
                            <div class="flex size-9 items-center justify-center rounded-md bg-muted/50">
                                <LucideIconCn Name="disc" Size="16" Class="size-4 text-muted-foreground" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <span class="block truncate text-sm">@alb</span>
                                <span class="block truncate text-muted-foreground text-xs">@albumArtist · @albumSongs.Length songs</span>
                            </div>
                        </div>
                    }
                    @if (filteredAlbums.Length == 0)
                    {
                        <div class="px-4 py-8 text-center text-muted-foreground text-xs">
                            No albums match your search
                        </div>
                    }
                </div>
            </TabsContentCn>

            @* Artists tab *@
            <TabsContentCn Value="artists" Class="m-0">
                <div>
                    @{
                        var filteredArtists = GetFilteredArtists();
                    }
                    @foreach (var artist in filteredArtists)
                    {
                        var art = artist;
                        var artistSongs = _songs.Where(s => s.Artist == art).ToArray();
                        var albumCount = artistSongs.Select(s => s.Album).Distinct().Count();
                        var isLastArt = art == filteredArtists[filteredArtists.Length - 1];
                        <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLastArt ? "border-b" : "")">
                            <div class="flex size-9 items-center justify-center rounded-full bg-muted/50">
                                <LucideIconCn Name="mic" Size="16" Class="size-4 text-muted-foreground" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <span class="block truncate text-sm">@art</span>
                                <span class="block truncate text-muted-foreground text-xs">@artistSongs.Length songs · @albumCount @(albumCount == 1 ? "album" : "albums")</span>
                            </div>
                        </div>
                    }
                    @if (filteredArtists.Length == 0)
                    {
                        <div class="px-4 py-8 text-center text-muted-foreground text-xs">
                            No artists match your search
                        </div>
                    }
                </div>
            </TabsContentCn>

            @* Genres tab *@
            <TabsContentCn Value="genres" Class="m-0">
                <div>
                    @{
                        var filteredGenres = GetFilteredGenres();
                    }
                    @foreach (var genre in filteredGenres)
                    {
                        var gen = genre;
                        var genreSongs = _songs.Where(s => s.Genre == gen).ToArray();
                        var isLastGen = gen == filteredGenres[filteredGenres.Length - 1];
                        <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLastGen ? "border-b" : "")">
                            <div class="flex size-9 items-center justify-center rounded-md bg-muted/50">
                                <LucideIconCn Name="tag" Size="16" Class="size-4 text-muted-foreground" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <span class="block truncate text-sm">@gen</span>
                                <span class="block truncate text-muted-foreground text-xs">@genreSongs.Length songs</span>
                            </div>
                        </div>
                    }
                    @if (filteredGenres.Length == 0)
                    {
                        <div class="px-4 py-8 text-center text-muted-foreground text-xs">
                            No genres match your search
                        </div>
                    }
                </div>
            </TabsContentCn>
        </TabsCn>

        @* Footer stats *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-center gap-2 text-muted-foreground text-xs">
                <span>@_songs.Length songs</span>
                <span>&middot;</span>
                <span>@_uniqueAlbums.Length albums</span>
                <span>&middot;</span>
                <span>@_uniqueArtists.Length artists</span>
                <span>&middot;</span>
                <span>@_totalHours h @_totalMinutes m total</span>
            </div>
        </div>

    </div>
</section>

@code {
    private record Song(string Id, string Title, string Artist, string Album, string Genre, string Duration, int DurationSeconds, string AddedDate);

    private static readonly Song[] _songs =
    [
        new("s-01", "Midnight City",                  "M83",             "Hurry Up, We're Dreaming",  "Electronic",  "4:03", 243, "Mar 25, 2026"),
        new("s-02", "Retrograde",                     "James Blake",     "Overgrown",                 "Electronic",  "5:15", 315, "Mar 24, 2026"),
        new("s-03", "Motion Sickness",                "Phoebe Bridgers", "Stranger in the Alps",      "Indie",       "4:01", 241, "Mar 22, 2026"),
        new("s-04", "Dissolve",                       "Absofacto",       "Thousand Peaces",           "Indie Pop",   "3:48", 228, "Mar 20, 2026"),
        new("s-05", "Glass Cathedral",                "Novo Amor",       "Birthplace",                "Indie Folk",  "4:32", 272, "Mar 18, 2026"),
        new("s-06", "Everything In Its Right Place",  "Radiohead",       "Kid A",                     "Alternative", "4:11", 251, "Mar 15, 2026"),
        new("s-07", "Holocene",                       "Bon Iver",        "Bon Iver, Bon Iver",        "Indie Folk",  "5:36", 336, "Mar 12, 2026"),
        new("s-08", "Mykonos",                        "Fleet Foxes",     "Sun Giant",                 "Indie Folk",  "5:03", 303, "Mar 10, 2026"),
        new("s-09", "Skinny Love",                    "Bon Iver",        "For Emma, Forever Ago",     "Indie Folk",  "3:58", 238, "Mar 8, 2026"),
        new("s-10", "Tessellate",                     "Alt-J",           "An Awesome Wave",           "Alternative", "3:04", 184, "Mar 5, 2026"),
        new("s-11", "Youth",                          "Daughter",        "If You Leave",              "Indie",       "4:42", 282, "Mar 3, 2026"),
        new("s-12", "Re: Stacks",                     "Bon Iver",        "For Emma, Forever Ago",     "Indie Folk",  "6:41", 401, "Mar 1, 2026"),
    ];

    private static readonly string[] _uniqueAlbums = _songs.Select(s => s.Album).Distinct().ToArray();
    private static readonly string[] _uniqueArtists = _songs.Select(s => s.Artist).Distinct().ToArray();
    private static readonly string[] _uniqueGenres = _songs.Select(s => s.Genre).Distinct().ToArray();

    private static readonly int _totalDurationSeconds = _songs.Sum(s => s.DurationSeconds);
    private static readonly int _totalHours = _totalDurationSeconds / 3600;
    private static readonly int _totalMinutes = (_totalDurationSeconds % 3600) / 60;

    private string _search = "";
    private string _sortKey = "title";
    private string _sortDir = "asc";
    private string _activeTab = "songs";

    private void ToggleSort(string key)
    {
        if (_sortKey == key)
            _sortDir = _sortDir == "asc" ? "desc" : "asc";
        else
        {
            _sortKey = key;
            _sortDir = "asc";
        }
    }

    private Song[] GetFilteredSongs()
    {
        var q = _search.ToLowerInvariant();
        var filtered = _songs.Where(s =>
            s.Title.ToLowerInvariant().Contains(q) ||
            s.Artist.ToLowerInvariant().Contains(q) ||
            s.Album.ToLowerInvariant().Contains(q) ||
            s.Genre.ToLowerInvariant().Contains(q)).ToArray();

        return _sortKey switch
        {
            "title"     => _sortDir == "asc" ? filtered.OrderBy(s => s.Title).ToArray()           : filtered.OrderByDescending(s => s.Title).ToArray(),
            "artist"    => _sortDir == "asc" ? filtered.OrderBy(s => s.Artist).ToArray()          : filtered.OrderByDescending(s => s.Artist).ToArray(),
            "duration"  => _sortDir == "asc" ? filtered.OrderBy(s => s.DurationSeconds).ToArray() : filtered.OrderByDescending(s => s.DurationSeconds).ToArray(),
            "addedDate" => _sortDir == "asc" ? filtered.OrderBy(s => s.AddedDate).ToArray()       : filtered.OrderByDescending(s => s.AddedDate).ToArray(),
            _           => filtered,
        };
    }

    private string[] GetFilteredAlbums()
    {
        var q = _search.ToLowerInvariant();
        return _uniqueAlbums.Where(a => a.ToLowerInvariant().Contains(q)).ToArray();
    }

    private string[] GetFilteredArtists()
    {
        var q = _search.ToLowerInvariant();
        return _uniqueArtists.Where(a => a.ToLowerInvariant().Contains(q)).ToArray();
    }

    private string[] GetFilteredGenres()
    {
        var q = _search.ToLowerInvariant();
        return _uniqueGenres.Where(g => g.ToLowerInvariant().Contains(q)).ToArray();
    }
}
