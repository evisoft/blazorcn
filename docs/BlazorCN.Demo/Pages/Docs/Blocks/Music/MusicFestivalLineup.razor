@* ============================================================
   Block: music-festival-lineup
   Title: MusicFestivalLineup
   Description: A music festival lineup display block for React and Next.js with day tabs, stage sections, artist time slots, headliner highlighting, and genre badges built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-festival-lineup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="mic" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Solstice Festival 2026</span>
            </div>
            <span class="text-muted-foreground text-xs">@_saved.Count saved</span>
        </div>

        @* Day tabs *@
        <div class="flex items-center gap-1 border-b px-4 py-2">
            <div class="flex items-center gap-1 rounded-md bg-muted/50 p-0.5">
                @foreach (var dayEntry in _days.Select((d, i) => new { Day = d, Index = i }))
                {
                    var idx = dayEntry.Index;
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-7 text-xs", _activeDay == idx ? "bg-background shadow-sm" : "text-muted-foreground")"
                              OnClick="@(() => _activeDay = idx)">
                        @dayEntry.Day.Label
                    </ButtonCn>
                }
            </div>
            <span class="ml-auto text-muted-foreground text-xs">@ArtistCount artists</span>
        </div>

        @* Stages *@
        @foreach (var stageEntry in _days[_activeDay].Stages.Select((s, i) => new { Stage = s, StageIndex = i }))
        {
            var stg = stageEntry.Stage;
            var stageIdx = stageEntry.StageIndex;

            @* Stage header *@
            <div class="border-b bg-muted/30 px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs uppercase tracking-wide">@stg.Name</span>
            </div>

            @* Artists *@
            @foreach (var artistEntry in stg.Artists.Select((a, i) => new { Artist = a, ArtistIndex = i }))
            {
                var artist = artistEntry.Artist;
                var artistIdx = artistEntry.ArtistIndex;
                var isLastArtist = stageIdx == _days[_activeDay].Stages.Count - 1 && artistIdx == stg.Artists.Count - 1;
                var isSaved = _saved.Contains(artist.Id);
                var capturedId = artist.Id;

                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLastArtist ? "" : "border-b")">
                    <span class="w-16 shrink-0 font-mono text-muted-foreground text-xs">@artist.Time</span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="@Cn.Merge("truncate text-sm", artist.Headliner ? "font-semibold" : "font-medium")">@artist.Name</span>
                            @if (artist.Headliner)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">Headliner</BadgeCn>
                            }
                        </div>
                        <span class="text-muted-foreground text-xs">@artist.Genre</span>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="size-7 shrink-0 p-0"
                              OnClick="@(() => ToggleSave(capturedId))"
                              aria-label="@(isSaved ? $"Remove {artist.Name} from schedule" : $"Add {artist.Name} to schedule")">
                        <LucideIconCn Name="star" Size="14" Class="@Cn.Merge("size-3.5", isSaved ? "fill-amber-500 text-amber-500" : "text-muted-foreground")" />
                    </ButtonCn>
                </div>
            }
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Jun 20-22, 2026 &middot; Riverside Park &middot; Doors open at 3 PM
            </p>
        </div>

    </div>
</section>

@code {
    private record Artist(string Id, string Name, string Time, string Genre, bool Headliner);
    private record Stage(string Name, List<Artist> Artists);
    private record Day(string Label, List<Stage> Stages);

    private int _activeDay = 0;
    private HashSet<string> _saved = ["f1", "s1", "s5"];

    private static readonly Day[] _days =
    [
        new("Fri",
        [
            new("Main Stage",
            [
                new("f1", "Aurora Waves",   "9:30 PM", "Indie Rock", true),
                new("f2", "Neon Dusk",      "7:45 PM", "Synth Pop",  false),
                new("f3", "The Coastlines", "6:00 PM", "Surf Rock",  false),
            ]),
            new("Echo Tent",
            [
                new("f4", "Luma",           "8:15 PM", "Electronic", false),
                new("f5", "Soft Meridian",  "6:30 PM", "Ambient",    false),
            ]),
        ]),
        new("Sat",
        [
            new("Main Stage",
            [
                new("s1", "Jade Solaris",         "10:00 PM", "R&B",       true),
                new("s2", "Velvet Haze",          "8:00 PM",  "Dream Pop", false),
                new("s3", "Broken Atlas",         "6:15 PM",  "Alt Rock",  false),
                new("s4", "Glass Animal Parade",  "4:30 PM",  "Psych Pop", false),
            ]),
            new("Echo Tent",
            [
                new("s5", "Circuit Bloom", "9:00 PM", "House", false),
                new("s6", "Kaia Morrow",   "7:00 PM", "Folk",  false),
            ]),
        ]),
        new("Sun",
        [
            new("Main Stage",
            [
                new("u1", "Midnight Orchid", "9:00 PM", "Neo Soul",   true),
                new("u2", "Static River",    "7:15 PM", "Post Rock",  false),
                new("u3", "Ember & Ash",     "5:30 PM", "Indie Folk", false),
            ]),
            new("Echo Tent",
            [
                new("u4", "Prism Collective", "8:00 PM", "Jazz Fusion", false),
                new("u5", "Low Frequency",    "6:00 PM", "Techno",      false),
            ]),
        ]),
    ];

    private int ArtistCount =>
        _days[_activeDay].Stages.Sum(s => s.Artists.Count);

    private void ToggleSave(string id)
    {
        if (_saved.Contains(id))
            _saved.Remove(id);
        else
            _saved.Add(id);
    }
}
