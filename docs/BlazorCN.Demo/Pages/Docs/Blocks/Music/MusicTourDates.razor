@* ============================================================
   Block: music-tour-dates
   Title: MusicTourDates
   Description: A concert tour dates list block for React and Next.js with city, venue, date, ticket status, price range, and get tickets button built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-tour-dates.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="music" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">@_tourName</span>
            </div>
            <div class="mt-1 flex items-center gap-2 text-muted-foreground text-xs">
                <span>@_totalShows shows</span>
                <span>&middot;</span>
                <span>@_availableShows with tickets available</span>
            </div>
        </div>

        @* Tour dates list *@
        <div>
            @foreach (var show in _tourDates)
            {
                var isLast = show.Id == _tourDates[^1].Id;
                var cfg = GetStatusConfig(show.Status);
                <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="map-pin" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                                <span class="font-medium text-sm">@show.City</span>
                                <div class="flex items-center gap-1.5">
                                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", cfg.Dot)"></span>
                                    <span class="@Cn.Merge("text-xs", cfg.BadgeClass)">@cfg.Label</span>
                                </div>
                            </div>
                            <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="ticket" Size="12" Class="size-3" />
                                    @show.Venue
                                </span>
                                <span>&middot;</span>
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                    @show.Date
                                </span>
                            </div>
                        </div>
                        <div class="flex shrink-0 items-center gap-3">
                            <span class="font-mono text-muted-foreground text-xs">@show.PriceRange</span>
                            @if (show.Status == "sold-out")
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                    Sold Out
                                </BadgeCn>
                            }
                            else
                            {
                                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 text-xs">
                                    Get Tickets
                                    <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                                </ButtonCn>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Prices exclude fees &middot; Dates subject to change
            </p>
        </div>

    </div>
</section>

@code {
    private record TourDate(string Id, string City, string Venue, string Date, string Status, string PriceRange);

    private record StatusConfig(string Label, string Dot, string BadgeClass);

    private const string _tourName = "Midnight Echoes World Tour 2026";

    private static readonly TourDate[] _tourDates =
    [
        new("td-1", "New York, NY",   "Madison Square Garden", "Apr 12, 2026", "sold-out",  "$85 - $250"),
        new("td-2", "Los Angeles, CA","The Forum",             "Apr 18, 2026", "few-left",  "$75 - $220"),
        new("td-3", "Chicago, IL",    "United Center",         "Apr 24, 2026", "available", "$65 - $195"),
        new("td-4", "London, UK",     "O2 Arena",              "May 3, 2026",  "available", "$70 - $210"),
        new("td-5", "Tokyo, JP",      "Tokyo Dome",            "May 10, 2026", "available", "$80 - $240"),
        new("td-6", "Berlin, DE",     "Mercedes-Benz Arena",   "May 17, 2026", "few-left",  "$60 - $180"),
        new("td-7", "Sydney, AU",     "Qudos Bank Arena",      "May 25, 2026", "available", "$70 - $200"),
    ];

    private static readonly int _totalShows = _tourDates.Length;
    private static readonly int _availableShows = Array.FindAll(_tourDates, d => d.Status != "sold-out").Length;

    private static StatusConfig GetStatusConfig(string status) => status switch
    {
        "available" => new("Available", "bg-emerald-500", "text-emerald-700 dark:text-emerald-400"),
        "few-left"  => new("Few Left",  "bg-amber-500",   "text-amber-700 dark:text-amber-400"),
        _           => new("Sold Out",  "bg-red-500",     "text-red-700 dark:text-red-400"),
    };
}
