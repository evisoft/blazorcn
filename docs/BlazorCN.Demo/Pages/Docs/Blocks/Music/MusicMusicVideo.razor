@* ============================================================
   Block: music-music-video
   Title: MusicMusicVideo
   Description: A music video player page block for React and Next.js with video placeholder, track info, related videos sidebar, view count, like and dislike buttons, and comments section built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-music-video.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid lg:grid-cols-3">

            @* Main content *@
            <div class="lg:col-span-2">

                @* Video Placeholder *@
                <div class="border-b">
                    <div class="flex aspect-video items-center justify-center bg-muted/50">
                        <div class="flex flex-col items-center gap-2">
                            <div class="flex size-12 items-center justify-center rounded-full bg-foreground/10">
                                <LucideIconCn Name="play" Size="20" Class="size-5 text-foreground" />
                            </div>
                            <span class="text-muted-foreground text-xs">Click to play</span>
                        </div>
                    </div>
                </div>

                @* Track Info *@
                <div class="border-b px-4 py-3">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">Midnight Run (Official Music Video)</span>
                            <div class="mt-1 flex flex-wrap items-center gap-2">
                                <span class="text-muted-foreground text-xs">The Frequencies</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                    Alternative
                                </BadgeCn>
                                <span class="text-muted-foreground text-xs">&middot;</span>
                                <span class="text-muted-foreground text-xs">Released Mar 15, 2026</span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3 flex items-center gap-3">
                        <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                            <LucideIconCn Name="eye" Size="12" Class="size-3" />
                            3.2M views
                        </span>
                        <div class="ml-auto flex items-center gap-1">
                            <ButtonCn Variant="@(_liked ? ButtonVariant.Default : ButtonVariant.Outline)"
                                      Size="ButtonSize.Sm"
                                      Class="h-7 gap-1 text-xs"
                                      OnClick="HandleLike">
                                <LucideIconCn Name="thumbs-up" Size="12" Class="size-3" />
                                @FormatCount(_likeCount)
                            </ButtonCn>
                            <ButtonCn Variant="@(_disliked ? ButtonVariant.Default : ButtonVariant.Outline)"
                                      Size="ButtonSize.Sm"
                                      Class="h-7 gap-1 text-xs"
                                      OnClick="HandleDislike">
                                <LucideIconCn Name="thumbs-down" Size="12" Class="size-3" />
                                @FormatCount(_dislikeCount)
                            </ButtonCn>
                        </div>
                    </div>
                </div>

                @* Comments *@
                <div class="px-4 py-3">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="message-square" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="font-medium text-xs">@_comments.Length Comments</span>
                    </div>

                    <div class="mt-3">
                        <InputCn Placeholder="Add a comment..." Class="h-8 border-0 bg-muted/50 text-xs shadow-none focus-visible:ring-0" />
                    </div>

                    <div class="mt-3 space-y-0">
                        @foreach (var (comment, index) in _comments.Select((c, i) => (c, i)))
                        {
                            var isLast = index == _comments.Length - 1;
                            <div class="@Cn.Merge("py-3", isLast ? "" : "border-b")">
                                <div class="flex items-center gap-2">
                                    <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted/50">
                                        <span class="font-medium text-xs">@comment.Author[0]</span>
                                    </div>
                                    <span class="font-medium text-xs">@comment.Author</span>
                                    <span class="text-muted-foreground text-xs">@comment.Time</span>
                                </div>
                                <p class="mt-1 pl-8 text-sm">@comment.Text</p>
                                <div class="mt-1 pl-8">
                                    <ButtonCn Variant="ButtonVariant.Ghost"
                                              Size="ButtonSize.Sm"
                                              Class="h-6 gap-1 px-2 text-xs text-muted-foreground">
                                        <LucideIconCn Name="thumbs-up" Size="12" Class="size-3" />
                                        @comment.Likes
                                    </ButtonCn>
                                </div>
                            </div>
                        }
                    </div>
                </div>

            </div>

            @* Related Videos Sidebar *@
            <div class="border-l lg:border-t-0">
                <div class="border-b px-4 py-3">
                    <span class="font-medium text-xs text-muted-foreground">Related Videos</span>
                </div>

                @foreach (var (video, index) in _relatedVideos.Select((v, i) => (v, i)))
                {
                    var isLast = index == _relatedVideos.Length - 1;
                    <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                        <div class="flex size-16 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="play" Size="14" Class="size-3.5 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="line-clamp-2 font-medium text-xs">@video.Title</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@video.Artist</p>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span>@video.Views</span>
                                <span>&middot;</span>
                                <span>@video.Duration</span>
                            </div>
                        </div>
                    </div>
                }

            </div>

        </div>
    </div>
</section>

@code {
    private record RelatedVideo(string Id, string Title, string Artist, string Views, string Duration);
    private record Comment(string Id, string Author, string Text, string Time, int Likes);

    private static readonly RelatedVideo[] _relatedVideos =
    [
        new("rv1", "Neon Lights (Official Video)", "Midnight Drive", "2.1M views", "4:12"),
        new("rv2", "Summer Rain - Live Session", "Echo Valley", "845K views", "5:38"),
        new("rv3", "Afterglow (Lyric Video)", "Luna Park", "1.3M views", "3:47"),
        new("rv4", "City Pulse - Behind the Scenes", "The Frequencies", "412K views", "8:22"),
        new("rv5", "Glass Tower (Acoustic)", "Sierra Nova", "678K views", "4:55"),
    ];

    private static readonly Comment[] _comments =
    [
        new("c1", "Alex Rivera", "The cinematography in this video is unreal. Every frame looks like a painting.", "2 days ago", 342),
        new("c2", "Jamie Chen", "Been listening to this on repeat since release. The bridge at 2:48 gives me chills every time.", "5 days ago", 187),
        new("c3", "Morgan Ellis", "This track hits different at 2am. Masterpiece.", "1 week ago", 94),
    ];

    private bool _liked = false;
    private bool _disliked = false;
    private int _likeCount = 24800;
    private int _dislikeCount = 312;

    private void HandleLike()
    {
        if (_liked)
        {
            _liked = false;
            _likeCount--;
        }
        else
        {
            _liked = true;
            _likeCount++;
            if (_disliked)
            {
                _disliked = false;
                _dislikeCount--;
            }
        }
    }

    private void HandleDislike()
    {
        if (_disliked)
        {
            _disliked = false;
            _dislikeCount--;
        }
        else
        {
            _disliked = true;
            _dislikeCount++;
            if (_liked)
            {
                _liked = false;
                _likeCount--;
            }
        }
    }

    private static string FormatCount(int n)
    {
        if (n >= 1000)
            return $"{(n / 1000.0):F1}K";
        return n.ToString();
    }
}
