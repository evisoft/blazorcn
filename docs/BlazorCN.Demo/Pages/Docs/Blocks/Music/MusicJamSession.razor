@* ============================================================
   Block: music-jam-session
   Title: MusicJamSession
   Description: A live jam session room block for React and Next.js with participant list, instrument tags, latency indicators, room code display, and chat sidebar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-jam-session.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="headphones" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Jam Session</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    Live
                </BadgeCn>
            </div>
            <div class="flex items-center gap-2">
                <div class="flex items-center gap-1.5 rounded-md bg-muted/50 px-2 py-1">
                    <span class="font-mono text-xs text-muted-foreground">@_roomCode</span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                              Class="h-5 gap-1 px-1 text-xs"
                              OnClick="CopyCode">
                        @if (_copied)
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                        }
                        else
                        {
                            <LucideIconCn Name="copy" Size="12" Class="size-3" />
                        }
                    </ButtonCn>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                          Class="h-7 text-xs"
                          OnClick="@(() => _showChat = !_showChat)">
                    <LucideIconCn Name="message-circle" Size="14" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>

        <div class="flex">
            @* Participants panel *@
            <div class="@Cn.Merge("flex-1", _showChat ? "border-r" : "")">

                @* Participant count *@
                <div class="flex items-center justify-between border-b px-4 py-2.5">
                    <span class="text-xs font-medium text-muted-foreground">
                        @_participants.Length participants
                    </span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                        <LucideIconCn Name="user-plus" Size="12" Class="size-3" />
                        Invite
                    </ButtonCn>
                </div>

                @* Participant list *@
                <div>
                    @foreach (var participant in _participants)
                    {
                        var iconName = InstrumentIcon(participant.Instrument);
                        <div class="flex items-center gap-3 border-b px-4 py-3 transition-colors hover:bg-muted/50">
                            <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                                @participant.Avatar
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="truncate font-medium text-sm">@participant.Name</span>
                                    @if (participant.IsMuted)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                            Muted
                                        </BadgeCn>
                                    }
                                </div>
                                <div class="mt-0.5 flex items-center gap-1.5">
                                    <LucideIconCn Name="@iconName" Size="12" Class="size-3 text-muted-foreground" />
                                    <span class="text-xs text-muted-foreground">@participant.Instrument</span>
                                </div>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", LatencyDot(participant.Latency))"></span>
                                <span class="@Cn.Merge("font-mono text-xs", LatencyColor(participant.Latency))">
                                    @(participant.Latency)ms
                                </span>
                                <LucideIconCn Name="wifi" Size="12" Class="size-3 text-muted-foreground" />
                            </div>
                        </div>
                    }
                </div>

                @* Reactions bar *@
                <div class="flex items-center gap-2 border-b px-4 py-2.5">
                    <LucideIconCn Name="smile" Size="14" Class="size-3.5 text-muted-foreground" />
                    @foreach (var r in _reactions)
                    {
                        var reaction = r;
                        <button type="button"
                                class="@Cn.Merge("rounded-md px-2 py-0.5 text-sm transition-colors hover:bg-muted/50", _activeReaction == reaction ? "bg-muted" : "")"
                                @onclick="@(() => SendReaction(reaction))">
                            @ReactionEmoji(reaction)
                        </button>
                    }
                    @if (_activeReaction != null)
                    {
                        <span class="text-sm">@ReactionEmoji(_activeReaction)</span>
                    }
                </div>

                @* Join/Leave CTA *@
                <div class="px-4 py-3">
                    @if (_joined)
                    {
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                  Class="h-8 w-full text-xs"
                                  OnClick="@(() => _joined = false)">
                            Leave Session
                        </ButtonCn>
                    }
                    else
                    {
                        <ButtonCn Size="ButtonSize.Sm"
                                  Class="h-8 w-full text-xs"
                                  OnClick="@(() => _joined = true)">
                            <LucideIconCn Name="headphones" Size="12" Class="size-3" />
                            Join Session
                        </ButtonCn>
                    }
                </div>
            </div>

            @* Chat sidebar *@
            @if (_showChat)
            {
                <div class="flex w-72 flex-col">
                    <div class="border-b px-3 py-2.5">
                        <span class="text-xs font-medium text-muted-foreground">Chat</span>
                    </div>
                    <div class="flex-1 space-y-3 px-3 py-3">
                        @foreach (var msg in _chatMessages)
                        {
                            <div>
                                <div class="flex items-center gap-1.5">
                                    <span class="font-medium text-xs">@msg.Sender</span>
                                    <span class="text-xs text-muted-foreground">@msg.Time</span>
                                </div>
                                <p class="mt-0.5 text-sm text-muted-foreground">@msg.Text</p>
                            </div>
                        }
                    </div>
                    <div class="border-t px-3 py-2.5">
                        <div class="flex items-center gap-2">
                            <InputCn @bind-Value="_message"
                                     Placeholder="Type a message..."
                                     Class="h-7 border-0 bg-transparent px-0 text-xs shadow-none focus-visible:ring-0" />
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 shrink-0 px-1.5">
                                <LucideIconCn Name="send" Size="12" Class="size-3" />
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Participant(string Id, string Name, string Instrument, string Avatar, int Latency, bool IsMuted);
    private record ChatMessage(string Id, string Sender, string Text, string Time);

    private const string _roomCode = "JAM-7X2K";

    private static readonly Participant[] _participants =
    [
        new("1", "Alex Rivera", "Guitar",   "AR", 12, false),
        new("2", "Jordan Lee",  "Drums",    "JL", 28, false),
        new("3", "Sam Chen",    "Keyboard", "SC", 45, true),
        new("4", "Maya Patel",  "Vocals",   "MP", 18, false),
        new("5", "Chris Wu",    "Bass",     "CW", 62, false),
    ];

    private static readonly ChatMessage[] _chatMessages =
    [
        new("c1", "Alex",   "Ready when you are!",                  "2 min ago"),
        new("c2", "Jordan", "Let's start with the bridge section",   "1 min ago"),
        new("c3", "Maya",   "Sounds good, count us in",              "30s ago"),
    ];

    private static readonly string[] _reactions = ["fire", "clap", "heart", "star"];

    private bool _joined = false;
    private bool _copied = false;
    private bool _showChat = true;
    private string _message = "";
    private string? _activeReaction = null;

    private static string InstrumentIcon(string instrument) => instrument switch
    {
        "Guitar"   => "guitar",
        "Drums"    => "drum",
        "Keyboard" => "piano",
        "Vocals"   => "mic",
        "Bass"     => "music-2",
        _          => "music-2",
    };

    private static string LatencyColor(int ms)
    {
        if (ms <= 20) return "text-emerald-600 dark:text-emerald-400";
        if (ms <= 40) return "text-amber-600 dark:text-amber-400";
        return "text-red-600 dark:text-red-400";
    }

    private static string LatencyDot(int ms)
    {
        if (ms <= 20) return "bg-emerald-500";
        if (ms <= 40) return "bg-amber-500";
        return "bg-red-500";
    }

    private static string ReactionEmoji(string reaction) => reaction switch
    {
        "fire"  => "\U0001F525",
        "clap"  => "\U0001F44F",
        "heart" => "❤️",
        "star"  => "⭐",
        _       => "",
    };

    private async Task CopyCode()
    {
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }

    private async Task SendReaction(string type)
    {
        _activeReaction = type;
        await Task.Delay(1500);
        _activeReaction = null;
    }
}
