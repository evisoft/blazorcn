@* ============================================================
   Block: music-stem-separator
   Title: MusicStemSeparator
   Description: A stem separation tool block for React and Next.js with original track display, individual stem controls for vocals, drums, bass, and other with play, mute, and volume sliders, and download buttons built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-stem-separator.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="music" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Stem Separator</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Isolate vocals, drums, bass, and instruments from any track.
            </p>
        </div>

        @* Original Track *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="font-medium text-xs text-muted-foreground">Original Track</span>
                    <div class="mt-1 flex items-center gap-2">
                        <span class="font-medium text-sm">Midnight Run - The Frequencies</span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                            WAV
                        </BadgeCn>
                    </div>
                    <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                        <span>3:42</span>
                        <span>&middot;</span>
                        <span>44.1 kHz</span>
                        <span>&middot;</span>
                        <span>27.5 MB</span>
                    </div>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                    <LucideIconCn Name="upload" Size="12" Class="size-3" />
                    Replace
                </ButtonCn>
            </div>

            @* Progress bar *@
            <div class="mt-3">
                <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                    <div class="h-full rounded-full bg-foreground" style="width:35%"></div>
                </div>
                <div class="mt-1 flex items-center justify-between text-muted-foreground text-xs">
                    <span class="tabular-nums">1:18</span>
                    <span class="tabular-nums">3:42</span>
                </div>
            </div>
        </div>

        @* Separation Status *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            @if (_separated)
            {
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-muted-foreground text-xs">Separation complete</span>
                <span class="text-muted-foreground text-xs">&middot;</span>
                <span class="text-muted-foreground text-xs">4 stems extracted</span>
            }
            else
            {
                <span class="size-1.5 rounded-full bg-amber-500"></span>
                <span class="text-muted-foreground text-xs">Processing...</span>
            }
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="ml-auto h-6 gap-1 px-2 text-xs"
                      OnClick="@(() => _separated = !_separated)">
                @(_separated ? "Re-process" : "Cancel")
            </ButtonCn>
        </div>

        @* Stems *@
        <div>
            @foreach (var stem in _stems)
            {
                var stemItem = stem;
                var isPlaying = _playing == stemItem.Id;
                var isMuted = _muted.Contains(stemItem.Id);
                var volume = _volumes[stemItem.Id];
                var isLast = stemItem.Id == _stems[_stems.Length - 1].Id;
                <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3">
                        @* Stem indicator *@
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", stemItem.Color)"></span>

                        @* Name and metadata *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@stemItem.Name</span>
                                <span class="text-muted-foreground text-xs">@stemItem.Duration</span>
                                <span class="text-muted-foreground text-xs">&middot;</span>
                                <span class="text-muted-foreground text-xs">@stemItem.Size</span>
                            </div>

                            @* Volume slider *@
                            <div class="mt-2 flex items-center gap-2">
                                <SliderCn Value="@((double)(isMuted ? 0 : volume))"
                                          ValueChanged="@((double v) => UpdateVolume(stemItem.Id, (int)v))"
                                          Max="100"
                                          Step="1"
                                          Class="flex-1"
                                          aria-label="@($"{stemItem.Name} volume")" />
                                <span class="w-8 text-right text-muted-foreground text-xs tabular-nums">
                                    @(isMuted ? 0 : volume)%
                                </span>
                            </div>
                        </div>

                        @* Controls *@
                        <div class="flex shrink-0 items-center gap-1">
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0"
                                      OnClick="@(() => TogglePlay(stemItem.Id))"
                                      aria-label="@(isPlaying ? $"Pause {stemItem.Name}" : $"Play {stemItem.Name}")">
                                @if (isPlaying)
                                {
                                    <LucideIconCn Name="pause" Size="14" Class="size-3.5" />
                                }
                                else
                                {
                                    <LucideIconCn Name="play" Size="14" Class="size-3.5" />
                                }
                            </ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                      Class="@Cn.Merge("size-7 p-0", isMuted ? "text-muted-foreground" : "")"
                                      OnClick="@(() => ToggleMute(stemItem.Id))"
                                      aria-label="@(isMuted ? $"Unmute {stemItem.Name}" : $"Mute {stemItem.Name}")">
                                @if (isMuted)
                                {
                                    <LucideIconCn Name="volume-x" Size="14" Class="size-3.5" />
                                }
                                else
                                {
                                    <LucideIconCn Name="volume-2" Size="14" Class="size-3.5" />
                                }
                            </ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0"
                                      aria-label="@($"Download {stemItem.Name}")">
                                <LucideIconCn Name="download" Size="14" Class="size-3.5" />
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-xs">
                    4 stems &middot; AI-powered separation
                </span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                    <LucideIconCn Name="download" Size="12" Class="size-3" />
                    Download All
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record Stem(string Id, string Name, string Color, string Duration, string Size);

    private static readonly Stem[] _stems =
    [
        new("vocals", "Vocals", "bg-blue-500",    "3:42", "8.2 MB"),
        new("drums",  "Drums",  "bg-amber-500",   "3:42", "6.8 MB"),
        new("bass",   "Bass",   "bg-emerald-500", "3:42", "5.4 MB"),
        new("other",  "Other",  "bg-purple-500",  "3:42", "7.1 MB"),
    ];

    private string? _playing = null;
    private List<string> _muted = [];
    private Dictionary<string, int> _volumes = new()
    {
        ["vocals"] = 80,
        ["drums"]  = 75,
        ["bass"]   = 70,
        ["other"]  = 65,
    };
    private bool _separated = true;

    private void TogglePlay(string stemId)
    {
        _playing = _playing == stemId ? null : stemId;
    }

    private void ToggleMute(string stemId)
    {
        if (_muted.Contains(stemId))
            _muted.Remove(stemId);
        else
            _muted.Add(stemId);
    }

    private void UpdateVolume(string stemId, int value)
    {
        _volumes[stemId] = value;
    }
}
