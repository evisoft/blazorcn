@* ============================================================
   Block: music-playlist-manager
   Title: MusicPlaylistManager
   Description: A playlist manager block for React and Next.js with drag-and-drop reordering, track list with artist and duration, add/remove tracks, editable playlist title, and total duration footer built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-playlist-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Playlist header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                <LucideIconCn Name="music" Size="16" Class="size-4 text-muted-foreground" />
            </div>
            <div class="min-w-0 flex-1">
                @if (_isEditingName)
                {
                    <InputCn @bind-Value="_playlistName"
                             Class="h-7 border-0 bg-transparent px-0 font-medium text-sm shadow-none focus-visible:ring-0"
                             @onblur="@(() => _isEditingName = false)"
                             @onkeydown="HandleNameKeyDown" />
                }
                else
                {
                    <div class="flex items-center gap-1.5">
                        <span class="truncate font-medium text-sm">@_playlistName</span>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                  Class="size-6 shrink-0 p-0 text-muted-foreground/60"
                                  OnClick="@(() => _isEditingName = true)"
                                  aria-label="Edit playlist name">
                            <LucideIconCn Name="pencil" Size="12" Class="size-3" />
                        </ButtonCn>
                    </div>
                }
                <p class="text-muted-foreground text-xs">
                    @_tracks.Count tracks &middot; @FormatTotalDuration(TotalDurationSeconds)
                </p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                      Class="h-7 gap-1 text-xs"
                      OnClick="AddTrack"
                      Disabled="@(_addIndex >= _newTrackPool.Length)">
                <LucideIconCn Name="plus" Size="12" Class="size-3" />
                Add
            </ButtonCn>
        </div>

        @* Track list *@
        <div>
            @foreach (var (track, index) in _tracks.Select((t, i) => (t, i)))
            {
                var item = track;
                var idx = index;
                <div class="flex items-center gap-3 border-b px-4 py-2.5 transition-colors hover:bg-muted/50">
                    <button type="button"
                            class="shrink-0 cursor-grab touch-none text-muted-foreground/60 active:cursor-grabbing"
                            aria-label="@($"Reorder {item.Title}")">
                        <LucideIconCn Name="grip-vertical" Size="14" Class="size-3.5" />
                    </button>
                    <span class="w-5 text-right font-mono text-muted-foreground text-xs tabular-nums">
                        @(idx + 1)
                    </span>
                    <div class="min-w-0 flex-1">
                        <p class="truncate font-medium text-sm">@item.Title</p>
                        <p class="truncate text-muted-foreground text-xs">@item.Artist</p>
                    </div>
                    <span class="font-mono text-muted-foreground text-xs tabular-nums">@item.Duration</span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                              Class="size-7 shrink-0 p-0 text-muted-foreground/60 hover:text-red-500"
                              OnClick="@(() => RemoveTrack(item.Id))"
                              aria-label="@($"Remove {item.Title}")">
                        <LucideIconCn Name="trash" Size="12" Class="size-3" />
                    </ButtonCn>
                </div>
            }
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Drag to reorder &middot; @_tracks.Count tracks &middot; @FormatTotalDuration(TotalDurationSeconds) total
            </p>
        </div>

    </div>
</section>

@code {
    private record Track(string Id, string Title, string Artist, string Duration, int DurationSeconds);

    private static readonly Track[] _initialTracks =
    [
        new("t1", "Neon Skyline",     "The Midnight",  "4:12", 252),
        new("t2", "Blinding Lights",  "The Weeknd",    "3:20", 200),
        new("t3", "Starboy",          "The Weeknd",    "3:50", 230),
        new("t4", "Electric Feel",    "MGMT",          "3:49", 229),
        new("t5", "Digital Love",     "Daft Punk",     "4:58", 298),
        new("t6", "Crystalised",      "The xx",        "3:22", 202),
        new("t7", "Sunset Lover",     "Petit Biscuit", "3:30", 210),
        new("t8", "Innerbloom",       "Rufus Du Sol",  "5:12", 312),
    ];

    private static readonly Track[] _newTrackPool =
    [
        new("t9",  "Midnight City",       "M83",       "4:03", 243),
        new("t10", "Intro",               "The xx",    "2:07", 127),
        new("t11", "Something About Us",  "Daft Punk", "3:52", 232),
    ];

    private List<Track> _tracks = _initialTracks.ToList();
    private string _playlistName = "Late Night Synthwave";
    private bool _isEditingName = false;
    private int _addIndex = 0;

    private int TotalDurationSeconds => _tracks.Sum(t => t.DurationSeconds);

    private void RemoveTrack(string id)
    {
        _tracks = _tracks.Where(t => t.Id != id).ToList();
    }

    private void AddTrack()
    {
        if (_addIndex < _newTrackPool.Length)
        {
            _tracks = [.._tracks, _newTrackPool[_addIndex]];
            _addIndex++;
        }
    }

    private void HandleNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            _isEditingName = false;
    }

    private static string FormatTotalDuration(int seconds)
    {
        var hours = seconds / 3600;
        var mins = (seconds % 3600) / 60;
        if (hours > 0)
            return $"{hours} hr {mins} min";
        return $"{mins} min";
    }
}
