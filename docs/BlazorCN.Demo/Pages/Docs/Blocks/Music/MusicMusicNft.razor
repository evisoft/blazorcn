@* ============================================================
   Block: music-music-nft
   Title: MusicMusicNft
   Description: A music NFT marketplace card block for React and Next.js with track artwork, edition info, bid history, ETH pricing, and play preview built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-music-nft.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Music NFT</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    Edition @_trackNft.Edition/@_trackNft.TotalEditions
                </BadgeCn>
            </div>
        </div>

        @* Artwork + Track Info *@
        <div class="border-b px-4 py-3">
            <div class="flex gap-4">
                @* Artwork placeholder *@
                <div class="relative flex size-24 shrink-0 items-center justify-center rounded-md bg-muted/50"
                     role="img"
                     aria-label="@($"Album artwork for {_trackNft.Title}")">
                    <LucideIconCn Name="music" Size="32" Class="size-8 text-muted-foreground/40" />
                    <button type="button"
                            @onclick="@(() => _isPlaying = !_isPlaying)"
                            class="absolute inset-0 flex items-center justify-center rounded-md bg-black/0 transition-colors hover:bg-black/10"
                            aria-label="@(_isPlaying ? "Pause preview" : "Play preview")">
                        <div class="flex size-8 items-center justify-center rounded-full bg-foreground/90">
                            @if (_isPlaying)
                            {
                                <LucideIconCn Name="pause" Size="14" Class="size-3.5 text-background" />
                            }
                            else
                            {
                                <LucideIconCn Name="play" Size="14" Class="size-3.5 text-background" />
                            }
                        </div>
                    </button>
                </div>

                @* Track details *@
                <div class="min-w-0 flex-1">
                    <p class="font-medium text-sm">@_trackNft.Title</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">@_trackNft.Artist</p>
                    <p class="mt-1 font-mono text-muted-foreground text-xs">@_trackNft.Duration</p>
                    <div class="mt-2 flex items-center gap-1.5">
                        <LucideIconCn Name="user" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-muted-foreground text-xs">
                            Owned by <span class="font-medium text-foreground">@_trackNft.OwnerName</span>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        @* Price section *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="font-medium text-muted-foreground text-xs">Current Price</p>
                    <p class="mt-0.5 font-semibold text-2xl tabular-nums">
                        @_trackNft.CurrentPrice <span class="font-normal text-muted-foreground text-sm">ETH</span>
                    </p>
                </div>
                <div class="text-right">
                    <p class="font-medium text-muted-foreground text-xs">Floor Price</p>
                    <p class="mt-0.5 font-medium text-sm tabular-nums">@_trackNft.FloorPrice ETH</p>
                </div>
            </div>
        </div>

        @* Bid History Toggle *@
        <div class="border-b">
            <button type="button"
                    @onclick="@(() => _showBids = !_showBids)"
                    class="flex w-full items-center justify-between px-4 py-3 text-left transition-colors hover:bg-muted/50">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="gavel" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-sm">Bid History</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-muted-foreground text-xs">@_bidHistory.Length bids</span>
                    <svg class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", _showBids ? "rotate-90" : "")"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <title>Toggle bid history</title>
                        <path d="m9 18 6-6-6-6" />
                    </svg>
                </div>
            </button>

            @if (_showBids)
            {
                @foreach (var (bid, index) in _bidHistory.Select((b, i) => (b, i)))
                {
                    <div class="flex items-center justify-between border-t px-4 py-2.5">
                        <div class="flex items-center gap-2">
                            <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", index == 0 ? "bg-emerald-500" : "bg-muted-foreground/30")"></span>
                            <span class="font-mono text-xs">@bid.Bidder</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="font-medium text-xs tabular-nums">@bid.Amount ETH</span>
                            <span class="text-muted-foreground text-xs">@bid.TimeAgo</span>
                        </div>
                    </div>
                }
            }
        </div>

        @* Place Bid CTA *@
        <div class="border-b px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs">Place Bid</ButtonCn>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <div class="flex items-center justify-center gap-2 text-muted-foreground text-xs">
                <span>ERC-721</span>
                <span>&middot;</span>
                <span>Ethereum Mainnet</span>
                <span>&middot;</span>
                <span>Verified Collection</span>
            </div>
        </div>

    </div>
</section>

@code {
    private record TrackNft(string Title, string Artist, int Edition, int TotalEditions, string Owner,
        string OwnerName, string CurrentPrice, string FloorPrice, string Duration);

    private record Bid(string Id, string Bidder, string Amount, string TimeAgo);

    private static readonly TrackNft _trackNft = new(
        Title: "Chromatic Drift",
        Artist: "Kael Voss",
        Edition: 7,
        TotalEditions: 25,
        Owner: "0x3f...a8c2",
        OwnerName: "synthwave.eth",
        CurrentPrice: "0.42",
        FloorPrice: "0.31",
        Duration: "3:48"
    );

    private static readonly Bid[] _bidHistory =
    [
        new("1", "neonbeats.eth",  "0.42", "12 min ago"),
        new("2", "bassline.eth",   "0.38", "1 hour ago"),
        new("3", "loopmaster.eth", "0.35", "3 hours ago"),
        new("4", "vinyl_dao.eth",  "0.31", "6 hours ago"),
        new("5", "audiophile.eth", "0.28", "1 day ago"),
    ];

    private bool _isPlaying = false;
    private bool _showBids = false;
}
