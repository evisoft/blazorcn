@* ============================================================
   Block: music-venue-finder
   Title: MusicVenueFinder
   Description: A music venue finder directory block for React and Next.js with venue cards, capacity filter, genre tags, star ratings, upcoming show counts, and location display built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-venue-finder.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="map-pin" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Venue Finder</span>
            </div>
            <span class="text-xs text-muted-foreground">@_filtered.Count venues</span>
        </div>

        @* Search *@
        <div class="flex items-center gap-2 border-b px-4 py-2.5">
            <LucideIconCn Name="search" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
            <InputCn @bind-Value="_search"
                     Placeholder="Search venues or locations..."
                     aria-label="Search venues or locations"
                     Class="h-7 border-0 bg-transparent px-0 text-sm shadow-none focus-visible:ring-0" />
        </div>

        @* Capacity filters *@
        <div class="flex items-center gap-1 border-b px-4 py-2.5">
            <span class="mr-1 text-xs font-medium text-muted-foreground">Capacity</span>
            <div class="flex items-center gap-1 rounded-md bg-muted/50 p-0.5">
                @foreach (var filter in _capacityFilters)
                {
                    var f = filter;
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-6 px-2.5 text-xs", _activeFilter == f.Label ? "bg-background shadow-sm" : "text-muted-foreground")"
                              OnClick="@(() => SetFilter(f.Label))">
                        @f.Label
                    </ButtonCn>
                }
            </div>
        </div>

        @* Venue list *@
        <div>
            @{
                var filteredList = _filtered;
            }
            @foreach (var venueEntry in filteredList.Select((v, i) => new { Venue = v, Index = i }))
            {
                var venue = venueEntry.Venue;
                var idx = venueEntry.Index;
                var isLast = idx == filteredList.Count - 1;

                <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <div class="flex items-start justify-between">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@venue.Name</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@venue.CapacityTier</BadgeCn>
                            </div>
                            <div class="mt-1 flex items-center gap-1.5">
                                <LucideIconCn Name="map-pin" Size="12" Class="size-3 text-muted-foreground" />
                                <span class="text-xs text-muted-foreground">@venue.Neighborhood, @venue.Location</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-1">
                            <LucideIconCn Name="star" Size="12" Class="size-3 fill-amber-400 text-amber-400" />
                            <span class="font-semibold text-sm tabular-nums">@venue.Rating</span>
                            <span class="text-xs text-muted-foreground">(@venue.ReviewCount)</span>
                        </div>
                    </div>

                    @* Genre tags *@
                    <div class="mt-2 flex flex-wrap items-center gap-1">
                        @foreach (var genre in venue.Genres)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs px-1.5 py-0">
                                <LucideIconCn Name="music-2" Size="10" Class="mr-0.5 size-2.5" />
                                @genre
                            </BadgeCn>
                        }
                    </div>

                    @* Stats row *@
                    <div class="mt-2 flex items-center gap-3 text-xs text-muted-foreground">
                        <span class="flex items-center gap-1">
                            <LucideIconCn Name="users" Size="12" Class="size-3" />
                            @FormatCapacity(venue.Capacity) capacity
                        </span>
                        <span>&middot;</span>
                        <span class="flex items-center gap-1">
                            <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                            @venue.UpcomingShows upcoming shows
                        </span>
                    </div>
                </div>
            }

            @if (_filtered.Count == 0)
            {
                <div class="px-4 py-8 text-center">
                    <LucideIconCn Name="map-pin" Size="20" Class="mx-auto size-5 text-muted-foreground/40" />
                    <p class="mt-2 text-sm text-muted-foreground">No venues match your filters</p>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-xs text-muted-foreground">
                Showing @_filtered.Count of @_venues.Length venues
            </p>
        </div>

    </div>
</section>

@code {
    private record CapacityFilter(string Label, int Min, int Max);
    private record Venue(string Id, string Name, int Capacity, string CapacityTier, string[] Genres,
                         double Rating, int ReviewCount, int UpcomingShows, string Location, string Neighborhood);

    private string _activeFilter = "All";
    private string _search = "";

    private static readonly CapacityFilter[] _capacityFilters =
    [
        new("All",      0,    100000),
        new("Intimate", 0,    200),
        new("Club",     200,  1000),
        new("Theater",  1000, 5000),
        new("Arena",    5000, 100000),
    ];

    private static readonly Venue[] _venues =
    [
        new("v1", "The Velvet Room",   150,   "Intimate", ["Jazz", "Blues", "Soul"],               4.8,  324,  8,  "Brooklyn, NY",    "Williamsburg"),
        new("v2", "Echo Chamber",      450,   "Club",     ["Electronic", "House", "Techno"],        4.5,  567,  12, "Los Angeles, CA", "Arts District"),
        new("v3", "Paramount Theater", 2800,  "Theater",  ["Rock", "Indie", "Alternative"],         4.6, 1203,  6,  "Oakland, CA",     "Downtown"),
        new("v4", "Neon Lounge",       120,   "Intimate", ["R&B", "Neo-Soul", "Acoustic"],          4.9,  189,  5,  "Austin, TX",      "East Side"),
        new("v5", "Skyline Arena",     18000, "Arena",    ["Pop", "Hip-Hop", "Rock"],               4.3, 2841,  3,  "Chicago, IL",     "United Center"),
        new("v6", "Bassline Club",     600,   "Club",     ["Drum & Bass", "Dubstep", "Garage"],     4.4,  412,  9,  "Miami, FL",       "Wynwood"),
    ];

    private List<Venue> _filtered => _venues.Where(venue =>
    {
        var filter = _capacityFilters.FirstOrDefault(f => f.Label == _activeFilter);
        if (filter == null) return true;
        var inCapacity = venue.Capacity >= filter.Min && venue.Capacity < filter.Max;
        var matchesSearch = string.IsNullOrEmpty(_search) ||
            venue.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            venue.Location.Contains(_search, StringComparison.OrdinalIgnoreCase);
        return inCapacity && matchesSearch;
    }).ToList();

    private void SetFilter(string label)
    {
        _activeFilter = label;
    }

    private static string FormatCapacity(int n)
    {
        if (n >= 1000)
        {
            var val = n / 1000.0;
            var str = val.ToString("0.0");
            if (str.EndsWith(".0")) str = str[..^2];
            return str + "k";
        }
        return n.ToString();
    }
}
