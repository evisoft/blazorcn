@* ============================================================
   Block: music-daw-project
   Title: MusicDawProject
   Description: A simplified DAW project view block for React and Next.js with multi-track timeline, named tracks for vocals drums bass and synth, colored audio regions, animated playhead, and zoom controls built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-daw-project.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="music" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">@_projectName</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_bpm BPM
            </BadgeCn>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_tracks.Length tracks
            </BadgeCn>
        </div>

        @* Transport controls *@
        <div class="flex items-center gap-2 border-b px-4 py-2">
            <div class="flex items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-7 p-0"
                          OnClick="@(() => _playheadPosition = 0)"
                          aria-label="Skip to start">
                    <LucideIconCn Name="skip-back" Size="12" Class="size-3" />
                </ButtonCn>
                <ButtonCn Variant="@(_isPlaying ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Sm" Class="size-7 p-0"
                          OnClick="@(() => _isPlaying = !_isPlaying)"
                          aria-label="@(_isPlaying ? "Pause" : "Play")">
                    @if (_isPlaying)
                    {
                        <LucideIconCn Name="pause" Size="12" Class="size-3" />
                    }
                    else
                    {
                        <LucideIconCn Name="play" Size="12" Class="size-3" />
                    }
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-7 p-0"
                          OnClick="@(() => _playheadPosition = Math.Min(100, _playheadPosition + 10))"
                          aria-label="Skip forward">
                    <LucideIconCn Name="skip-forward" Size="12" Class="size-3" />
                </ButtonCn>
            </div>

            <span class="font-mono text-xs tabular-nums">@CurrentTimeMarker</span>

            <div class="ml-auto flex items-center gap-1">
                <span class="mr-1 text-muted-foreground text-xs">Zoom</span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-6 p-0"
                          OnClick="@(() => _zoom = Math.Max(0.5, _zoom - 0.25))"
                          aria-label="Zoom out">
                    <LucideIconCn Name="minus" Size="12" Class="size-3" />
                </ButtonCn>
                <span class="w-8 text-center font-mono text-xs tabular-nums">@_zoom.ToString("F1")x</span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-6 p-0"
                          OnClick="@(() => _zoom = Math.Min(2, _zoom + 0.25))"
                          aria-label="Zoom in">
                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

        @* Timeline header with time markers *@
        <div class="flex border-b">
            <div class="w-28 shrink-0 border-r px-3 py-1.5">
                <span class="font-medium text-muted-foreground text-xs">Track</span>
            </div>
            <div class="relative flex-1 overflow-hidden" style="@($"min-width:{_zoom * 100}%")">
                <div class="flex items-center py-1.5">
                    @for (int mi = 0; mi < _timeMarkers.Length; mi++)
                    {
                        var markerIdx = mi;
                        var marker = _timeMarkers[markerIdx];
                        <span class="shrink-0 font-mono text-muted-foreground text-xs"
                              style="@($"width:{100.0 / (_timeMarkers.Length - 1)}%;padding-left:{(markerIdx == 0 ? "8px" : "0")}")">
                            @marker
                        </span>
                    }
                </div>
            </div>
        </div>

        @* Tracks *@
        <div class="relative">
            @for (int ti = 0; ti < _tracks.Length; ti++)
            {
                var trackIdx = ti;
                var track = _tracks[trackIdx];
                var hasSolo = _tracks.Any(t => t.Solo);
                var isAudible = hasSolo ? track.Solo : !track.Muted;
                var isLast = trackIdx == _tracks.Length - 1;
                <div class="@Cn.Merge("flex", isLast ? "" : "border-b")">

                    @* Track info *@
                    <div class="flex w-28 shrink-0 items-center gap-2 border-r px-3 py-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-1.5">
                                <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", track.Color)"></span>
                                <span class="@Cn.Merge("truncate font-medium text-xs", !isAudible ? "text-muted-foreground line-through" : "")">
                                    @track.Name
                                </span>
                            </div>
                        </div>
                        <div class="flex items-center gap-0.5">
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                      Class="@Cn.Merge("size-6 p-0", track.Muted ? "text-red-500" : "text-muted-foreground")"
                                      OnClick="@(() => ToggleMute(track.Id))"
                                      aria-label="@((track.Muted ? "Unmute" : "Mute") + " " + track.Name)">
                                @if (track.Muted)
                                {
                                    <LucideIconCn Name="volume-x" Size="12" Class="size-3" />
                                }
                                else
                                {
                                    <LucideIconCn Name="volume-2" Size="12" Class="size-3" />
                                }
                            </ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                      Class="@Cn.Merge("size-6 p-0 font-mono text-[10px]", track.Solo ? "text-amber-500" : "text-muted-foreground")"
                                      OnClick="@(() => ToggleSolo(track.Id))"
                                      aria-label="@((track.Solo ? "Unsolo" : "Solo") + " " + track.Name)">
                                S
                            </ButtonCn>
                        </div>
                    </div>

                    @* Timeline with regions *@
                    <div class="relative flex-1 overflow-hidden bg-muted/20 py-1.5"
                         style="@($"min-width:{_zoom * 100}%")">
                        @foreach (var reg in track.Regions)
                        {
                            var region = reg;
                            var labelColor = track.Color.Replace("bg-", "text-").Replace("-500", "-700");
                            <div class="@Cn.Merge("absolute top-1.5 bottom-1.5 flex items-center overflow-hidden rounded px-2", track.BgColor, !isAudible ? "opacity-30" : "")"
                                 style="@($"left:{region.Start}%;width:{region.Width}%")">
                                <span class="@Cn.Merge("truncate text-[10px]", labelColor, "dark:text-current")">
                                    @region.Label
                                </span>
                                @* Waveform decoration *@
                                <div class="ml-auto flex items-center gap-px opacity-40">
                                    @for (int wi = 0; wi < 8; wi++)
                                    {
                                        var waveIdx = wi;
                                        var waveHeight = 6 + ((waveIdx * 3 + 7) % 12);
                                        <div class="@Cn.Merge("w-px rounded-full", track.Color)"
                                             style="@($"height:{waveHeight}px")"></div>
                                    }
                                </div>
                            </div>
                        }

                        @* Playhead *@
                        <div class="absolute top-0 bottom-0 z-10 w-px bg-foreground"
                             style="@($"left:{_playheadPosition}%")">
                            <div class="absolute -left-1 -top-0.5 size-2 rounded-full bg-foreground"></div>
                        </div>
                    </div>

                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between text-muted-foreground text-xs">
                <span>@_tracks.Count(t => !t.Muted) of @_tracks.Length tracks active</span>
                <span>@_tracks.Sum(t => t.Regions.Length) regions</span>
            </div>
        </div>

    </div>
</section>

@code {
    private const string _projectName = "Midnight Drive — Session 4";
    private const int _bpm = 128;

    private record RegionDef(string Id, int Start, int Width, string Label);

    private sealed class TrackDef
    {
        public string Id { get; init; } = "";
        public string Name { get; init; } = "";
        public string IconName { get; init; } = "";
        public string Color { get; init; } = "";
        public string BgColor { get; init; } = "";
        public bool Muted { get; set; }
        public bool Solo { get; set; }
        public RegionDef[] Regions { get; init; } = [];
    }

    private TrackDef[] _tracks =
    [
        new TrackDef
        {
            Id = "vocals", Name = "Vocals", IconName = "mic-2",
            Color = "bg-blue-500", BgColor = "bg-blue-500/20",
            Muted = false, Solo = false,
            Regions =
            [
                new("v1", 12, 22, "Verse 1"),
                new("v2", 38, 14, "Chorus"),
                new("v3", 58, 22, "Verse 2"),
                new("v4", 84, 14, "Chorus 2"),
            ],
        },
        new TrackDef
        {
            Id = "drums", Name = "Drums", IconName = "music",
            Color = "bg-amber-500", BgColor = "bg-amber-500/20",
            Muted = false, Solo = false,
            Regions =
            [
                new("d1", 4,  30, "Beat A"),
                new("d2", 36, 18, "Fill + Beat B"),
                new("d3", 56, 30, "Beat A"),
                new("d4", 88, 10, "Outro"),
            ],
        },
        new TrackDef
        {
            Id = "bass", Name = "Bass", IconName = "volume-2",
            Color = "bg-emerald-500", BgColor = "bg-emerald-500/20",
            Muted = false, Solo = false,
            Regions =
            [
                new("b1", 4,  48, "Bass Line A"),
                new("b2", 56, 42, "Bass Line B"),
            ],
        },
        new TrackDef
        {
            Id = "synth", Name = "Synth", IconName = "music",
            Color = "bg-purple-500", BgColor = "bg-purple-500/20",
            Muted = false, Solo = false,
            Regions =
            [
                new("s1", 0,  10, "Intro Pad"),
                new("s2", 34, 20, "Chorus Pad"),
                new("s3", 80, 18, "Chorus Pad"),
            ],
        },
    ];

    private static readonly string[] _timeMarkers =
    [
        "0:00", "0:15", "0:30", "0:45",
        "1:00", "1:15", "1:30", "1:45",
        "2:00", "2:15", "2:30",
    ];

    private bool _isPlaying = false;
    private int _playheadPosition = 25;
    private double _zoom = 1.0;

    private string CurrentTimeMarker
    {
        get
        {
            var idx = Math.Min(
                (int)Math.Floor((double)_playheadPosition / 100 * (_timeMarkers.Length - 1)),
                _timeMarkers.Length - 1);
            return _timeMarkers[idx];
        }
    }

    private void ToggleMute(string trackId)
    {
        foreach (var t in _tracks)
        {
            if (t.Id == trackId) t.Muted = !t.Muted;
        }
    }

    private void ToggleSolo(string trackId)
    {
        foreach (var t in _tracks)
        {
            if (t.Id == trackId) t.Solo = !t.Solo;
        }
    }
}
