@* ============================================================
   Block: music-concert-review
   Title: MusicConcertReview
   Description: A concert review block for React and Next.js with venue name, date, star rating, review text, set highlights, sound quality and crowd energy ratings, and helpful vote counter built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-concert-review.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header — Artist + Venue *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="font-medium text-sm">@_artistName</span>
                    <div class="mt-0.5 flex items-center gap-3 text-muted-foreground text-xs">
                        <span class="flex items-center gap-1">
                            <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                            @_venueName
                        </span>
                        <span class="flex items-center gap-1">
                            <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                            @_eventDate
                        </span>
                    </div>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Live Review</BadgeCn>
            </div>
        </div>

        @* Star rating *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex items-center gap-0.5">
                @for (int i = 0; i < _maxRating; i++)
                {
                    var idx = i;
                    <LucideIconCn Name="star" Size="16" Class="@(idx < _overallRating ? "size-4 fill-foreground text-foreground" : "size-4 text-muted-foreground/30")" />
                }
            </div>
            <span class="font-semibold text-sm tabular-nums">@(_overallRating).0</span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="text-muted-foreground text-xs">by @_reviewAuthor</span>
        </div>

        @* Review text *@
        <div class="border-b px-4 py-3">
            <p class="text-sm leading-relaxed">@_reviewText</p>
        </div>

        @* Set highlights *@
        <div class="border-b">
            <div class="px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Set Highlights</span>
            </div>
            @foreach (var (highlight, index) in _setHighlights.Select((h, i) => (h, i)))
            {
                var isLast = index == _setHighlights.Length - 1;
                <div class="@(isLast ? "flex items-start gap-3 px-4 py-2.5" : "flex items-start gap-3 px-4 py-2.5 border-b")">
                    <span class="mt-0.5 shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                        @highlight.Time
                    </span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@highlight.Title</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@highlight.Description</p>
                    </div>
                </div>
            }
        </div>

        @* Rating categories *@
        <div class="border-b px-4 py-3">
            <div class="space-y-3">
                @foreach (var cat in _ratingCategories)
                {
                    <div class="flex items-center gap-3">
                        <span class="w-28 shrink-0 text-muted-foreground text-xs">@cat.Label</span>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground" style="@($"width:{cat.Value}%")"></div>
                        </div>
                        <span class="w-8 text-right font-mono text-muted-foreground text-xs tabular-nums">@cat.Value</span>
                    </div>
                }
            </div>
        </div>

        @* Helpful vote *@
        <div class="flex items-center justify-between px-4 py-2.5">
            <span class="text-muted-foreground text-xs">Was this review helpful?</span>
            <ButtonCn Variant="@(_hasVoted ? ButtonVariant.Default : ButtonVariant.Outline)"
                      Size="ButtonSize.Sm"
                      Class="h-7 gap-1.5 text-xs"
                      OnClick="HandleVote">
                <LucideIconCn Name="thumbs-up" Size="12" Class="size-3" />
                Helpful
                <span class="tabular-nums">@_helpfulCount</span>
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record SetHighlight(string Id, string Time, string Title, string Description);
    private record RatingCategory(string Label, int Value);

    private const string _venueName = "Madison Square Garden";
    private const string _artistName = "Arctic Monkeys";
    private const string _eventDate = "Mar 15, 2026";
    private const int _overallRating = 4;
    private const int _maxRating = 5;
    private const string _reviewAuthor = "Alex T.";
    private const string _reviewText =
        "An incredible live experience from start to finish. The band opened with a thunderous rendition of Do I Wanna Know? that had the entire arena on its feet. The sound mixing was pristine — every guitar riff and drum fill came through crystal clear even in the upper sections. Highlight of the night was the extended jam during R U Mine? with a 3-minute guitar solo that brought the house down.";

    private static readonly SetHighlight[] _setHighlights =
    [
        new("1", "8:15 PM", "Do I Wanna Know?",                       "Explosive opener with synchronized lighting"),
        new("2", "9:02 PM", "R U Mine? (Extended)",                   "3-minute guitar solo, crowd sing-along"),
        new("3", "9:45 PM", "505",                                    "Acoustic intro, full band crescendo finish"),
        new("4", "10:10 PM", "I Bet You Look Good on the Dancefloor", "Encore closer, confetti cannons"),
    ];

    private static readonly RatingCategory[] _ratingCategories =
    [
        new("Sound Quality",    92),
        new("Crowd Energy",     88),
        new("Stage Production", 95),
        new("Setlist",          85),
    ];

    private int _helpfulCount = 47;
    private bool _hasVoted = false;

    private void HandleVote()
    {
        if (!_hasVoted)
        {
            _helpfulCount++;
            _hasVoted = true;
        }
    }
}
