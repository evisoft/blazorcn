@* ============================================================
   Block: music-podcast-analytics
   Title: MusicPodcastAnalytics
   Description: A podcast analytics dashboard block for React and Next.js with total downloads counter, episode performance chart, listener retention rate, top episodes list, and subscriber growth built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-podcast-analytics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bar-chart-3" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Podcast Analytics</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Last 30 days</BadgeCn>
        </div>

        @* Stats row *@
        <div class="grid grid-cols-2 border-b sm:grid-cols-4">
            <div class="border-b px-4 py-3 sm:border-b-0 sm:border-r">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="headphones" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-muted-foreground text-xs">Total Downloads</span>
                </div>
                <div class="mt-1">
                    <span class="font-semibold text-2xl tabular-nums">84,050</span>
                </div>
            </div>
            <div class="border-b px-4 py-3 sm:border-b-0 sm:border-r">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-muted-foreground text-xs">Subscribers</span>
                </div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="font-semibold text-2xl tabular-nums">18,420</span>
                    <span class="text-emerald-600 text-xs dark:text-emerald-400">+12.4%</span>
                </div>
            </div>
            <div class="px-4 py-3 sm:border-r">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-muted-foreground text-xs">Avg Retention</span>
                </div>
                <div class="mt-1">
                    <span class="font-semibold text-2xl tabular-nums">75%</span>
                </div>
            </div>
            <div class="px-4 py-3">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="bar-chart-3" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-muted-foreground text-xs">Episodes</span>
                </div>
                <div class="mt-1">
                    <span class="font-semibold text-2xl tabular-nums">10</span>
                </div>
            </div>
        </div>

        @* Chart — Downloads per Episode (inline SVG bar chart) *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Downloads per Episode</span>
            </div>
            <div class="h-[200px] w-full overflow-hidden">
                <svg class="h-full w-full" viewBox="0 0 560 200" preserveAspectRatio="none">
                    @{
                        var maxVal = 12800;
                        var barW = 36;
                        var gap = 20;
                        var chartH = 160;
                        var offsetY = 20;
                        var offsetX = 36;
                        var ySteps = new[] { 0, 4000, 8000, 12000 };
                    }
                    @* Y-axis grid lines and labels *@
                    @foreach (var step in ySteps)
                    {
                        var yPos = (float)(offsetY + chartH - (chartH * step / (double)maxVal));
                        var label = step == 0 ? "0" : $"{step / 1000}k";
                        <line x1="@offsetX" y1="@yPos.ToString(System.Globalization.CultureInfo.InvariantCulture)" x2="556" y2="@yPos.ToString(System.Globalization.CultureInfo.InvariantCulture)" stroke="currentColor" stroke-opacity="0.1" stroke-width="1" />
                        @((MarkupString)FormattableString.Invariant($"<text x=\"{offsetX - 4}\" y=\"{yPos + 4}\" text-anchor=\"end\" font-size=\"9\" fill=\"currentColor\" fill-opacity=\"0.5\">{label}</text>"))
                    }
                    @* Bars *@
                    @for (var i = 0; i < _episodeData.Length; i++)
                    {
                        var ep = _episodeData[i];
                        var barH = (float)(chartH * ep.Downloads / (double)maxVal);
                        var x = offsetX + i * (barW + gap);
                        var y = (float)(offsetY + chartH - barH);
                        <rect x="@x" y="@y.ToString(System.Globalization.CultureInfo.InvariantCulture)" width="@barW" height="@barH.ToString(System.Globalization.CultureInfo.InvariantCulture)" fill="var(--chart-1)" rx="4" ry="4" />
                        @((MarkupString)$"<text x=\"{x + barW / 2}\" y=\"{offsetY + chartH + 14}\" text-anchor=\"middle\" font-size=\"9\" fill=\"currentColor\" fill-opacity=\"0.5\">{ep.Episode}</text>")
                    }
                </svg>
            </div>
        </div>

        @* Top episodes *@
        <div>
            <div class="border-b px-4 py-2.5">
                <span class="font-medium text-muted-foreground text-xs">Top Episodes</span>
            </div>
            @for (var i = 0; i < _topEpisodes.Length; i++)
            {
                var ep = _topEpisodes[i];
                var index = i;
                var isLast = index == _topEpisodes.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <span class="w-4 text-center font-mono text-muted-foreground text-xs tabular-nums">@(index + 1)</span>
                    <div class="min-w-0 flex-1">
                        <span class="block truncate font-medium text-sm">@ep.Title</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="headphones" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="font-mono text-muted-foreground text-xs tabular-nums">@ep.Downloads.ToString("N0")</span>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="flex w-16 items-center gap-1">
                            <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                                <div class="h-full rounded-full bg-foreground" style="@($"width:{ep.Retention}%")"></div>
                            </div>
                            <span class="font-mono text-muted-foreground text-xs tabular-nums">@(ep.Retention)%</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                10 episodes &middot; 84K total downloads &middot; Updated daily
            </p>
        </div>

    </div>
</section>

@code {
    private record EpisodePoint(string Episode, int Downloads);
    private record TopEpisode(string Id, string Title, int Downloads, int Retention);

    private static readonly EpisodePoint[] _episodeData =
    [
        new("Ep 1",  4820),
        new("Ep 2",  5340),
        new("Ep 3",  7120),
        new("Ep 4",  6450),
        new("Ep 5",  8900),
        new("Ep 6",  7680),
        new("Ep 7",  9240),
        new("Ep 8",  11500),
        new("Ep 9",  10200),
        new("Ep 10", 12800),
    ];

    private static readonly TopEpisode[] _topEpisodes =
    [
        new("e1", "The Future of AI in Music Production",  12800, 78),
        new("e2", "How Streaming Changed the Industry",    11500, 72),
        new("e3", "Behind the Mix: Studio Secrets",        10200, 81),
        new("e4", "Interview: Indie Label Founders",        9240, 68),
        new("e5", "Vinyl Revival: Why Physical Media Matters", 8900, 74),
    ];
}
