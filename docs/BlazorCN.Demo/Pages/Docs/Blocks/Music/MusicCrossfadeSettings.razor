@* ============================================================
   Block: music-crossfade-settings
   Title: MusicCrossfadeSettings
   Description: A music crossfade configuration block for React and Next.js with duration slider, visual curve selector, fade overlap waveform preview, and apply action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-crossfade-settings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="audio-lines" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Crossfade</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Smoothly transition between tracks by overlapping the end and start.
            </p>
        </div>

        @* Duration Slider *@
        <div class="border-b px-4 py-4">
            <div class="mb-3 flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Duration</span>
                <span class="font-semibold text-sm tabular-nums">
                    @(_duration == 0 ? "Off" : $"{_duration}s")
                </span>
            </div>
            <SliderCn aria-label="Crossfade duration" Value="@((double)_duration)"
                      ValueChanged="@((double v) => { _duration = v; })"
                      Min="0"
                      Max="12"
                      Step="0.5"
                      Class="w-full" />
            <div class="mt-1.5 flex justify-between text-muted-foreground/60 text-xs">
                <span>Off</span>
                <span>6s</span>
                <span>12s</span>
            </div>
        </div>

        @* Curve Type Selector *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Curve Type</span>
            <div class="flex gap-2">
                @foreach (var opt in _curveOptions)
                {
                    var option = opt;
                    <button type="button"
                            class="@Cn.Merge("flex-1 rounded-md px-3 py-2 text-left transition-colors", _curveType == option.Id ? "bg-muted ring-1 ring-foreground/20" : "bg-muted/30 hover:bg-muted/50")"
                            @onclick="@(() => _curveType = option.Id)">
                        <span class="block font-medium text-xs">@option.Label</span>
                        <span class="block text-muted-foreground text-xs">@option.Description</span>
                    </button>
                }
            </div>
        </div>

        @* Waveform Preview *@
        <div class="border-b px-4 py-4">
            <span class="mb-3 block font-medium text-muted-foreground text-xs">
                Overlap Preview
            </span>
            <div class="flex justify-center">
                <svg width="280"
                     height="80"
                     viewBox="0 0 280 80"
                     class="overflow-visible">
                    <title>Crossfade overlap preview</title>
                    @* Track A background *@
                    <rect x="0" y="0" width="@TrackAEnd.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" height="60" rx="4" class="fill-muted/50" />
                    @* Track B background *@
                    <rect x="@TrackBStart.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" y="0" width="@((280.0 - TrackBStart).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))" height="60" rx="4" class="fill-muted/50" />

                    @if (_duration > 0)
                    {
                        @* Overlap region highlight *@
                        <rect x="@TrackBStart.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" y="0" width="@OverlapWidth.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" height="60" class="fill-foreground/5" />

                        @* Fade out curve (Track A) *@
                        <g transform="@($"translate({TrackBStart.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}, 0)")">
                            <path d="@FadeOutPath" fill="none" class="stroke-foreground/60" stroke-width="2" stroke-linecap="round" />
                        </g>

                        @* Fade in curve (Track B) *@
                        <g transform="@($"translate({TrackBStart.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}, 0)")">
                            <path d="@FadeInPath" fill="none" class="stroke-foreground/30" stroke-width="2" stroke-linecap="round" stroke-dasharray="4 3" />
                        </g>
                    }

                    @* Labels — use MarkupString for SVG text with attributes *@
                    @((MarkupString)$"<text x=\"{(TrackAEnd * 0.3).ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}\" y=\"74\" text-anchor=\"middle\" class=\"fill-muted-foreground text-[10px]\">Track A</text>")
                    @((MarkupString)$"<text x=\"{(TrackBStart + (280.0 - TrackBStart) * 0.7).ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}\" y=\"74\" text-anchor=\"middle\" class=\"fill-muted-foreground text-[10px]\">Track B</text>")
                </svg>
            </div>
            @if (_duration > 0)
            {
                <div class="mt-2 flex items-center justify-center gap-4 text-muted-foreground text-xs">
                    <div class="flex items-center gap-1.5">
                        <span class="inline-block h-0.5 w-4 rounded bg-foreground/60"></span>
                        <span>Fade out</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="inline-block h-0.5 w-4 rounded border border-foreground/30 border-dashed"></span>
                        <span>Fade in</span>
                    </div>
                </div>
            }
        </div>

        @* Info Note *@
        <div class="flex items-start gap-2 border-b px-4 py-3">
            <LucideIconCn Name="info" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground/60" />
            <p class="text-muted-foreground text-xs leading-relaxed">
                Equal power crossfade maintains consistent perceived loudness during transitions.
                Logarithmic curves sound more natural for acoustic music. Linear is best for electronic
                and beat-matched tracks.
            </p>
        </div>

        @* Apply Button *@
        <div class="px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full gap-1.5 text-xs" OnClick="HandleApply">
                @if (_applied)
                {
                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                    @:Applied
                }
                else
                {
                    @:Apply Settings
                }
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record CurveOption(string Id, string Label, string Description);

    private static readonly CurveOption[] _curveOptions =
    [
        new("linear",      "Linear",       "Constant rate crossfade"),
        new("equal-power", "Equal Power",  "Maintains perceived volume"),
        new("logarithmic", "Logarithmic",  "Natural sounding fade"),
    ];

    private double _duration = 6.0;
    private string _curveType = "equal-power";
    private bool _applied = false;

    private const int PreviewWidth  = 280;
    private const int PreviewHeight = 60;

    private double OverlapRatio => _duration / 12.0;
    private double OverlapWidth => PreviewWidth * OverlapRatio;
    private double TrackAEnd    => PreviewWidth * 0.5 + OverlapWidth * 0.5;
    private double TrackBStart  => PreviewWidth * 0.5 - OverlapWidth * 0.5;

    private string FadeOutPath => GenerateFadePath(_curveType, "out",  OverlapWidth, PreviewHeight);
    private string FadeInPath  => GenerateFadePath(_curveType, "in",   OverlapWidth, PreviewHeight);

    private static string GenerateFadePath(string curveType, string direction, double width, double height)
    {
        var points = new System.Text.StringBuilder();
        const int steps = 40;

        for (int i = 0; i <= steps; i++)
        {
            double t = (double)i / steps;
            double x = t * width;
            double y;

            if (curveType == "linear")
            {
                y = direction == "out" ? t * height : (1 - t) * height;
            }
            else if (curveType == "equal-power")
            {
                y = direction == "out"
                    ? Math.Sin(t * Math.PI / 2) * height
                    : Math.Cos(t * Math.PI / 2) * height;
            }
            else
            {
                double curve = direction == "out"
                    ? t * t * t
                    : 1 - (1 - t) * (1 - t) * (1 - t);
                y = direction == "out" ? curve * height : (1 - curve) * height;
            }

            string prefix = i == 0 ? "M" : "L";
            points.Append(FormattableString.Invariant($"{prefix}{x:F1},{y:F1}"));
        }

        return points.ToString();
    }

    private async Task HandleApply()
    {
        _applied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _applied = false;
    }
}
