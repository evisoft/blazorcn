@* ============================================================
   Block: music-ambient-generator
   Title: MusicAmbientGenerator
   Description: An ambient sound generator block for React and Next.js with nature sound sliders, master volume control, timer setting, mix presets, and save mix functionality built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-ambient-generator.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="trees" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Ambient Generator</span>
            </div>
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_activeSounds active
                </BadgeCn>
            </div>
        </div>

        @* Sound sliders *@
        <div class="border-b px-4 py-3">
            <div class="space-y-3">
                @foreach (var snd in _sounds)
                {
                    var sound = snd;
                    <div class="flex items-center gap-3">
                        <div class="flex w-20 items-center gap-2 text-muted-foreground">
                            <LucideIconCn Name="@sound.IconName" Size="16" Class="size-4" />
                            <span class="text-xs">@sound.Name</span>
                        </div>
                        <div class="flex-1">
                            <SliderCn aria-label="@($"{sound.Name} volume")" Value="@((double)(_volumes.TryGetValue(sound.Id, out var sv) ? sv : 0))"
                                      ValueChanged="@((double v) => UpdateVolume(sound.Id, (int)v))"
                                      Max="100"
                                      Step="1"
                                      Class="w-full" />
                        </div>
                        <span class="w-8 text-right font-mono text-muted-foreground text-xs tabular-nums">
                            @(_volumes.TryGetValue(sound.Id, out var dv) ? dv : 0)
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Master volume *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex w-20 items-center gap-2 text-muted-foreground">
                <LucideIconCn Name="volume-2" Size="16" Class="size-4" />
                <span class="font-medium text-xs">Master</span>
            </div>
            <div class="flex-1">
                <SliderCn aria-label="Master volume" Value="@((double)_masterVolume)"
                          ValueChanged="@((double v) => { _masterVolume = (int)v; })"
                          Max="100"
                          Step="1"
                          Class="w-full" />
            </div>
            <span class="w-8 text-right font-mono text-muted-foreground text-xs tabular-nums">
                @_masterVolume
            </span>
        </div>

        @* Timer *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2 text-muted-foreground">
                <LucideIconCn Name="timer" Size="16" Class="size-4" />
                <span class="font-medium text-xs">Timer</span>
            </div>
            <div class="flex items-center gap-1 rounded-md bg-muted/50 p-0.5">
                @foreach (var t in _timerOptions)
                {
                    var opt = t;
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-7 text-xs", _timer == opt ? "bg-background shadow-sm" : "text-muted-foreground")"
                              OnClick="@(() => _timer = opt)">
                        @(opt)m
                    </ButtonCn>
                }
            </div>
        </div>

        @* Presets *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Presets</span>
            <div class="flex items-center gap-1.5">
                @foreach (var prs in _presets)
                {
                    var preset = prs;
                    <ButtonCn Variant="ButtonVariant.Outline"
                              Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-7 text-xs", _activePreset == preset.Id ? "ring-2 ring-foreground" : "")"
                              OnClick="@(() => ApplyPreset(preset))">
                        @preset.Name
                    </ButtonCn>
                }
            </div>
        </div>

        @* Save mix *@
        <div class="px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full gap-1.5 text-xs" OnClick="HandleSave">
                <LucideIconCn Name="save" Size="12" Class="size-3" />
                @(_saved ? "Mix Saved" : "Save Mix")
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record SoundDef(string Id, string Name, string IconName);

    private record PresetDef(string Id, string Name, Dictionary<string, int> Volumes);

    private static readonly SoundDef[] _sounds =
    [
        new("rain",    "Rain",    "cloud-rain"),
        new("thunder", "Thunder", "zap"),
        new("wind",    "Wind",    "wind"),
        new("birds",   "Birds",   "bird"),
        new("ocean",   "Ocean",   "waves"),
        new("fire",    "Fire",    "flame"),
    ];

    private static readonly PresetDef[] _presets =
    [
        new("forest", "Forest", new() { ["rain"] = 30, ["thunder"] = 0, ["wind"] = 20, ["birds"] = 60, ["ocean"] = 0, ["fire"] = 0 }),
        new("beach",  "Beach",  new() { ["rain"] = 0,  ["thunder"] = 0, ["wind"] = 40, ["birds"] = 20, ["ocean"] = 80, ["fire"] = 0 }),
        new("storm",  "Storm",  new() { ["rain"] = 80, ["thunder"] = 60, ["wind"] = 50, ["birds"] = 0, ["ocean"] = 0, ["fire"] = 0 }),
        new("cafe",   "Cafe",   new() { ["rain"] = 40, ["thunder"] = 0, ["wind"] = 0,  ["birds"] = 10, ["ocean"] = 0, ["fire"] = 50 }),
    ];

    private static readonly int[] _timerOptions = [15, 30, 60, 90];

    private Dictionary<string, int> _volumes = _sounds.ToDictionary(s => s.Id, s => 0);
    private int _masterVolume = 75;
    private int _timer = 30;
    private string? _activePreset = null;
    private bool _saved = false;

    private int _activeSounds => _volumes.Values.Count(v => v > 0);

    private void UpdateVolume(string id, int value)
    {
        _volumes[id] = value;
        _activePreset = null;
    }

    private void ApplyPreset(PresetDef preset)
    {
        _volumes = new Dictionary<string, int>(preset.Volumes);
        _activePreset = preset.Id;
    }

    private async Task HandleSave()
    {
        _saved = true;
        await Task.Delay(2000);
        _saved = false;
    }
}
