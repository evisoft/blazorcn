@* ============================================================
   Block: music-vinyl-store
   Title: MusicVinylStore
   Description: A vinyl record store block for React and Next.js with record display cards, price tags, condition grades, genre filter tags, add-to-cart buttons, and cart summary footer built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-vinyl-store.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="disc" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Vinyl Store</span>
                </div>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="shopping-cart" Size="12" Class="size-3" />
                    @_cart.Count item@(_cart.Count != 1 ? "s" : "")
                </span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Hand-picked records in verified condition.
            </p>
        </div>

        @* Genre Filters *@
        <div class="flex flex-wrap items-center gap-1.5 border-b px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost"
                      Size="ButtonSize.Sm"
                      Class="@Cn.Merge("h-7 text-xs", _activeGenre == "All" ? "bg-foreground text-background hover:bg-foreground/90 hover:text-background" : "text-muted-foreground")"
                      OnClick="@(() => _activeGenre = "All")">
                All
            </ButtonCn>
            @foreach (var genre in _genres)
            {
                var g = genre;
                <ButtonCn Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.Sm"
                          Class="@Cn.Merge("h-7 text-xs", _activeGenre == g ? "bg-foreground text-background hover:bg-foreground/90 hover:text-background" : "text-muted-foreground")"
                          OnClick="@(() => _activeGenre = g)">
                    @g
                </ButtonCn>
            }
        </div>

        @* Records List *@
        <div>
            @{
                var filtered = _activeGenre == "All"
                    ? _records
                    : _records.Where(r => r.Genre == _activeGenre).ToArray();
            }
            @for (var i = 0; i < filtered.Length; i++)
            {
                var record = filtered[i];
                var isLast = i == filtered.Length - 1;
                var inCart = _cart.Contains(record.Id);
                <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex items-start gap-3">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="disc" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@record.Album</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                    @record.Genre
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @record.Artist &middot; @record.Year
                            </p>
                            <div class="mt-2 flex items-center gap-3">
                                <span class="@Cn.Merge("font-medium text-xs", GetConditionColor(record.Condition))"
                                      title="@GetConditionLabel(record.Condition)">
                                    @record.Condition
                                </span>
                                <span class="text-muted-foreground text-xs">&middot;</span>
                                <span class="font-semibold text-sm tabular-nums">
                                    $@record.Price.ToString("F2")
                                </span>
                            </div>
                        </div>
                        <ButtonCn Variant="@(inCart ? ButtonVariant.Outline : ButtonVariant.Default)"
                                  Size="ButtonSize.Sm"
                                  Class="h-7 shrink-0 gap-1 text-xs"
                                  OnClick="@(() => ToggleCart(record.Id))">
                            @if (inCart)
                            {
                                <LucideIconCn Name="minus" Size="12" Class="size-3" />
                                <text>Remove</text>
                            }
                            else
                            {
                                <LucideIconCn Name="plus" Size="12" Class="size-3" />
                                <text>Add</text>
                            }
                        </ButtonCn>
                    </div>
                </div>
            }

            @if (filtered.Length == 0)
            {
                <div class="px-4 py-8 text-center">
                    <p class="text-muted-foreground text-sm">No records in this genre.</p>
                </div>
            }
        </div>

        @* Cart Summary Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-xs">
                    @_cart.Count item@(_cart.Count != 1 ? "s" : "") in cart
                </span>
                <span class="font-semibold text-sm tabular-nums">$@CartTotal.ToString("F2")</span>
            </div>
        </div>

    </div>
</section>

@code {
    private record VinylRecord(string Id, string Artist, string Album, int Year, string Genre, string Condition, double Price);

    private static readonly VinylRecord[] _records =
    [
        new("r1", "Radiohead",        "OK Computer",                        1997, "Rock",       "NM",  34.99),
        new("r2", "Miles Davis",      "Kind of Blue",                       1959, "Jazz",       "VG+", 48.50),
        new("r3", "Boards of Canada", "Music Has the Right to Children",    1998, "Electronic", "M",   52.00),
        new("r4", "Marvin Gaye",      "What's Going On",                    1971, "Soul",       "VG",  28.00),
        new("r5", "MF DOOM",          "Mm.. Food",                          2004, "Hip-Hop",    "NM",  38.99),
        new("r6", "Glenn Gould",      "Goldberg Variations",                1956, "Classical",  "G",   22.00),
        new("r7", "Talking Heads",    "Remain in Light",                    1980, "Rock",       "VG+", 31.50),
        new("r8", "John Coltrane",    "A Love Supreme",                     1965, "Jazz",       "VG",  42.00),
    ];

    private static readonly string[] _genres = ["Rock", "Jazz", "Electronic", "Soul", "Hip-Hop", "Classical"];

    private string _activeGenre = "All";
    private List<string> _cart = [];

    private double CartTotal =>
        _records.Where(r => _cart.Contains(r.Id)).Sum(r => r.Price);

    private void ToggleCart(string id)
    {
        if (_cart.Contains(id))
            _cart.Remove(id);
        else
            _cart.Add(id);
    }

    private static string GetConditionLabel(string condition) => condition switch
    {
        "M"   => "Mint",
        "NM"  => "Near Mint",
        "VG+" => "Very Good Plus",
        "VG"  => "Very Good",
        "G"   => "Good",
        _     => condition,
    };

    private static string GetConditionColor(string condition) => condition switch
    {
        "M"   => "text-emerald-600 dark:text-emerald-400",
        "NM"  => "text-emerald-600 dark:text-emerald-400",
        "VG+" => "text-blue-600 dark:text-blue-400",
        "VG"  => "text-amber-600 dark:text-amber-400",
        "G"   => "text-muted-foreground",
        _     => "",
    };
}
