@* ============================================================
   Block: music-subscription-plans
   Title: MusicSubscriptionPlans
   Description: A music subscription pricing block for React and Next.js with three tiers, feature comparison, monthly/yearly toggle with NumberFlow price animation, and CTA buttons built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-subscription-plans.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="music" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Choose Your Plan</span>
                </div>
                <div class="flex items-center gap-1 rounded-md bg-muted/50 p-0.5">
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-7 text-xs", _billing == "monthly" ? "bg-background shadow-sm" : "text-muted-foreground")"
                              OnClick="@(() => _billing = "monthly")">
                        Monthly
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-7 gap-1.5 text-xs", _billing == "yearly" ? "bg-background shadow-sm" : "text-muted-foreground")"
                              OnClick="@(() => _billing = "yearly")">
                        Yearly
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px] leading-none">
                            Save @_yearlySavingsPercent%
                        </BadgeCn>
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Plans grid *@
        <div class="grid grid-cols-1 md:grid-cols-3">
            @foreach (var plan in _plans)
            {
                var p = plan;
                var idx = Array.IndexOf(_plans, p);
                <div class="@Cn.Merge("flex flex-col px-4 py-4", idx < _plans.Length - 1 ? "border-b md:border-r md:border-b-0" : "", p.Highlighted ? "bg-muted/30" : "")">

                    @* Plan header *@
                    <div class="mb-3">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@p.Name</span>
                            @if (p.Highlighted)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
                                    <LucideIconCn Name="sparkles" Size="12" Class="size-3" />
                                    Popular
                                </BadgeCn>
                            }
                        </div>
                        <p class="mt-1 text-muted-foreground text-xs">@p.Description</p>
                    </div>

                    @* Price *@
                    <div class="mb-4 flex items-baseline gap-1">
                        @if (p.MonthlyPrice == 0)
                        {
                            <span class="font-semibold text-2xl tabular-nums">Free</span>
                        }
                        else
                        {
                            <span class="font-semibold text-2xl tabular-nums">$@(_billing == "monthly" ? p.MonthlyPrice : p.YearlyPrice)</span>
                            <span class="text-muted-foreground text-xs">/@(_billing == "monthly" ? "mo" : "yr")</span>
                        }
                    </div>

                    @* Features *@
                    <div class="mb-4 flex flex-1 flex-col gap-2">
                        @foreach (var feature in p.Features)
                        {
                            <div class="flex items-center gap-2.5">
                                <span class="flex size-4 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                                    <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                                </span>
                                <span class="text-sm">@feature</span>
                            </div>
                        }
                    </div>

                    @* CTA *@
                    <ButtonCn Size="ButtonSize.Sm"
                              Variant="@(p.Highlighted ? ButtonVariant.Default : ButtonVariant.Outline)"
                              Class="h-8 w-full text-xs">
                        @p.Cta
                    </ButtonCn>

                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Cancel anytime · No commitment · 30-day free trial on paid plans
            </p>
        </div>

    </div>
</section>

@code {
    private record Plan(string Id, string Name, string Description, int MonthlyPrice, int YearlyPrice, string[] Features, string Cta, bool Highlighted);

    private static readonly Plan[] _plans =
    [
        new("free", "Free", "Ad-supported listening with shuffle play", 0, 0,
            ["Shuffle play only", "Ad-supported streaming", "Standard audio quality", "1 device at a time", "Discover Weekly playlist"],
            "Get Started", false),
        new("premium", "Premium", "Ad-free music with offline downloads", 11, 109,
            ["Ad-free listening", "Offline downloads", "High-fidelity audio", "Play on any device", "Unlimited skips", "Lyrics display"],
            "Start Free Trial", true),
        new("family", "Family", "Premium for up to 6 family members", 17, 169,
            ["Everything in Premium", "Up to 6 accounts", "Family Mix playlist", "Parental controls", "Individual recommendations", "Shared playlists"],
            "Start Family Plan", false),
    ];

    private static readonly int _yearlySavingsPercent = (int)Math.Round(
        ((_plans[1].MonthlyPrice * 12 - _plans[1].YearlyPrice) / (double)(_plans[1].MonthlyPrice * 12)) * 100);

    private string _billing = "monthly";
}
