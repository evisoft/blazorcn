@* ============================================================
   Block: music-artist-profile
   Title: MusicArtistProfile
   Description: An artist profile card block for React and Next.js with avatar placeholder, follower count animation, top tracks list with play counts, genre badges, and follow button toggle built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-artist-profile.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Artist header *@
        <div class="flex items-center gap-4 border-b px-4 py-4">
            <div class="flex size-14 shrink-0 items-center justify-center rounded-full bg-indigo-500/20">
                <span class="font-medium text-muted-foreground text-sm">LW</span>
            </div>
            <div class="min-w-0 flex-1">
                <p class="font-medium text-sm">Luna Waves</p>
                <div class="mt-1 flex flex-wrap items-center gap-1">
                    @foreach (var genre in _artist.Genres)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@genre</BadgeCn>
                    }
                </div>
            </div>
            <ButtonCn Variant="@(_isFollowing ? ButtonVariant.Outline : ButtonVariant.Default)"
                      Size="ButtonSize.Sm"
                      Class="h-7 gap-1 text-xs"
                      OnClick="@(() => _isFollowing = !_isFollowing)"
                      AriaLabel="@(_isFollowing ? "Unfollow artist" : "Follow artist")">
                @if (_isFollowing)
                {
                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                    <span>Following</span>
                }
                else
                {
                    <LucideIconCn Name="user-plus" Size="12" Class="size-3" />
                    <span>Follow</span>
                }
            </ButtonCn>
        </div>

        @* Stats row *@
        <div class="flex items-center gap-6 border-b px-4 py-3">
            <div>
                <div class="font-semibold text-sm tabular-nums">284.7K</div>
                <p class="text-muted-foreground text-xs">Followers</p>
            </div>
            <div>
                <div class="font-semibold text-sm tabular-nums">1.42M</div>
                <p class="text-muted-foreground text-xs">Monthly listeners</p>
            </div>
            <div>
                <div class="font-semibold text-sm tabular-nums">7</div>
                <p class="text-muted-foreground text-xs">Top tracks</p>
            </div>
        </div>

        @* Top tracks header *@
        <div class="flex items-center gap-2 border-b px-4 py-2.5">
            <LucideIconCn Name="music" Size="14" Class="size-3.5 text-muted-foreground" />
            <span class="font-medium text-muted-foreground text-xs">Popular tracks</span>
        </div>

        @* Track list *@
        <div>
            @for (var i = 0; i < _topTracks.Length; i++)
            {
                var track = _topTracks[i];
                var index = i;
                var isLast = index == _topTracks.Length - 1;
                var isLiked = _likedTracks.Contains(track.Id);
                var trackId = track.Id;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <span class="w-4 text-right font-mono text-muted-foreground text-xs tabular-nums">@(index + 1)</span>
                    <div class="flex size-7 shrink-0 items-center justify-center rounded bg-muted/50">
                        <LucideIconCn Name="play" Size="12" Class="size-3 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-1.5">
                            <span class="truncate font-medium text-sm">@track.Title</span>
                            @if (track.Trending)
                            {
                                <LucideIconCn Name="trending-up" Size="12" Class="size-3 shrink-0 text-emerald-500" />
                            }
                        </div>
                        <p class="text-muted-foreground text-xs">@FormatPlays(track.Plays) plays</p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="@Cn.Merge("size-7 shrink-0 p-0", isLiked ? "text-red-500" : "text-muted-foreground/60")"
                              OnClick="@(() => ToggleLike(trackId))"
                              AriaLabel="@(isLiked ? $"Unlike {track.Title}" : $"Like {track.Title}")">
                        <LucideIconCn Name="heart" Size="14" Class="@Cn.Merge("size-3.5", isLiked ? "fill-current" : "")" />
                    </ButtonCn>
                    <span class="w-10 text-right font-mono text-muted-foreground text-xs tabular-nums">@track.Duration</span>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                @FormatFollowers(_artist.Followers) followers · @FormatPlays(_artist.MonthlyListeners) monthly listeners
            </p>
        </div>

    </div>
</section>

@code {
    private record ArtistData(string Name, string[] Genres, int Followers, int MonthlyListeners, string Initials, string Color);
    private record TopTrack(string Id, string Title, int Plays, string Duration, bool Trending);

    private static readonly ArtistData _artist = new(
        "Luna Waves",
        ["Electronic", "Synthwave", "Ambient"],
        284700,
        1420000,
        "LW",
        "bg-indigo-500/20"
    );

    private static readonly TopTrack[] _topTracks =
    [
        new("t1", "Midnight Horizon",  48200000, "4:23", true),
        new("t2", "Neon Dreams",       35800000, "3:47", true),
        new("t3", "Crystal Shores",    29100000, "5:01", false),
        new("t4", "Starlight Cascade", 21700000, "4:15", false),
        new("t5", "Velvet Sunrise",    18400000, "3:58", true),
        new("t6", "Pacific Drive",     14200000, "4:32", false),
        new("t7", "Aurora",            11800000, "3:33", false),
    ];

    private bool _isFollowing = false;
    private readonly HashSet<string> _likedTracks = ["t1", "t3"];

    private void ToggleLike(string id)
    {
        if (_likedTracks.Contains(id))
            _likedTracks.Remove(id);
        else
            _likedTracks.Add(id);
    }

    private static string FormatPlays(int n)
    {
        if (n >= 1_000_000) return $"{(n / 1_000_000.0):F1}M";
        if (n >= 1_000)     return $"{(int)(n / 1000.0)}K";
        return n.ToString();
    }

    private static string FormatFollowers(int n)
    {
        if (n >= 1_000_000) return $"{(n / 1_000_000.0):F1}M";
        if (n >= 1_000)     return $"{(n / 1_000.0):F1}K";
        return n.ToString();
    }
}
