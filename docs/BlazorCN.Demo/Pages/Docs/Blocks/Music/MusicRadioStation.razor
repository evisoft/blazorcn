@* ============================================================
   Block: music-radio-station
   Title: MusicRadioStation
   Description: A live radio station UI block for React and Next.js with now-playing track, up-next queue, listener count, and frequency dial visualization built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-radio-station.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Station header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="radio" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">@_stationName</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    <span class="font-medium text-red-500 text-xs">LIVE</span>
                </div>
            </div>
            <div class="mt-1 flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@_stationGenre</BadgeCn>
                <span class="font-mono text-muted-foreground text-xs">@_stationFrequency MHz</span>
            </div>
        </div>

        @* Frequency dial visualization *@
        <div class="flex items-end justify-center gap-[3px] border-b px-4 py-4">
            @foreach (var bar in _frequencyBars)
            {
                var h = _isPlaying ? bar : (int)(bar * 0.3);
                <div class="w-1.5 rounded-full bg-foreground/20" style="@($"height:{h}px")"></div>
            }
            <div class="mx-2 flex flex-col items-center">
                <div class="size-2 rounded-full bg-red-500"></div>
                <div class="mt-1 h-6 w-px bg-red-500/50"></div>
            </div>
            @foreach (var bar in _frequencyBarsReversed)
            {
                var h = _isPlaying ? bar : (int)(bar * 0.3);
                <div class="w-1.5 rounded-full bg-foreground/20" style="@($"height:{h}px")"></div>
            }
        </div>

        @* Now playing *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                              Class="size-9 rounded-full p-0"
                              OnClick="@(() => _isPlaying = !_isPlaying)"
                              aria-label="@(_isPlaying ? "Pause stream" : "Play stream")">
                        @if (_isPlaying)
                        {
                            <LucideIconCn Name="pause" Size="16" Class="size-4" />
                        }
                        else
                        {
                            <LucideIconCn Name="play" Size="16" Class="size-4" />
                        }
                    </ButtonCn>
                    <div>
                        <p class="font-medium text-sm">@_nowPlayingTitle</p>
                        <p class="text-muted-foreground text-xs">@_nowPlayingArtist</p>
                    </div>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="headphones" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="font-mono text-muted-foreground text-xs">@_nowPlayingDuration</span>
                </div>
            </div>
        </div>

        @* Up next queue *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Up Next</span>
            </div>
            @for (var i = 0; i < _upNext.Length; i++)
            {
                var track = _upNext[i];
                var isLast = i == _upNext.Length - 1;
                var idx = i + 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                    <span class="w-4 text-center font-mono text-muted-foreground text-xs">@idx</span>
                    <div class="min-w-0 flex-1">
                        <p class="truncate text-sm">@track.Title</p>
                        <p class="truncate text-muted-foreground text-xs">@track.Artist</p>
                    </div>
                    <span class="shrink-0 font-mono text-muted-foreground text-xs">@track.Duration</span>
                </div>
            }
        </div>

        @* Footer with listener count *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-center gap-2 text-muted-foreground text-xs">
                <LucideIconCn Name="users" Size="12" Class="size-3" />
                <span class="tabular-nums">2,847</span>
                <span>listeners</span>
                <span>&middot;</span>
                <span>@_stationFrequency FM</span>
            </div>
        </div>

    </div>
</section>

@code {
    private record TrackEntry(string Id, string Title, string Artist, string Duration);

    private const string _stationName = "Midnight Signal FM";
    private const string _stationGenre = "Indie Electronic";
    private const string _stationFrequency = "98.7";

    private const string _nowPlayingTitle = "Glass Cathedral";
    private const string _nowPlayingArtist = "Novo Amor";
    private const string _nowPlayingDuration = "4:32";

    private static readonly int[] _frequencyBars = [3, 5, 8, 12, 18, 24, 18, 12, 8, 5, 3, 2, 4, 7, 11, 16, 22, 16, 11, 7, 4, 2];
    private static readonly int[] _frequencyBarsReversed = [2, 4, 7, 11, 16, 22, 16, 11, 7, 4, 2, 3, 5, 8, 12, 18, 24, 18, 12, 8, 5, 3];

    private static readonly TrackEntry[] _upNext =
    [
        new("q-1", "Dissolve", "Absofacto", "3:48"),
        new("q-2", "Motion Sickness", "Phoebe Bridgers", "4:01"),
        new("q-3", "Retrograde", "James Blake", "5:15"),
        new("q-4", "Everything In Its Right Place", "Radiohead", "4:11"),
        new("q-5", "Midnight City", "M83", "4:03"),
    ];

    private bool _isPlaying = true;
}
