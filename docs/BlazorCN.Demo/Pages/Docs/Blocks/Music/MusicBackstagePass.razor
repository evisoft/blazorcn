@* ============================================================
   Block: music-backstage-pass
   Title: MusicBackstagePass
   Description: A backstage pass and VIP ticket display block for React and Next.js with event name, holder info, access levels, QR code placeholder, and validity dates built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-backstage-pass.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="ticket" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Backstage Pass</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    <span class="@Cn.Merge("mr-1.5 inline-block size-1.5 rounded-full", _config.DotColor)"></span>
                    @_config.Label
                </BadgeCn>
            </div>
        </div>

        @* Event info *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">@_passData.EventName</p>
            <div class="mt-2 flex flex-col gap-1.5">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="map-pin" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-muted-foreground text-xs">@_passData.Venue</span>
                </div>
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="calendar" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-muted-foreground text-xs">@_passData.Date</span>
                </div>
            </div>
        </div>

        @* Holder and QR *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start justify-between gap-4">
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="user" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="font-medium text-muted-foreground text-xs">Pass Holder</span>
                    </div>
                    <p class="mt-1 font-medium text-sm">@_passData.HolderName</p>
                    <p class="mt-1 font-mono text-muted-foreground text-xs">@_passData.PassId</p>
                    <div class="mt-2 flex items-center gap-1.5">
                        <LucideIconCn Name="shield-check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                        <span class="text-muted-foreground text-xs">Verified identity</span>
                    </div>
                </div>

                @* QR Placeholder *@
                <div class="flex size-20 shrink-0 items-center justify-center rounded-md bg-muted/50"
                     role="img"
                     aria-label="QR code for pass verification">
                    <LucideIconCn Name="qr-code" Size="40" Class="size-10 text-muted-foreground/40" />
                </div>
            </div>
        </div>

        @* Access Level Selector *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-muted-foreground text-xs">Access Level</p>
            <div class="mt-2 flex items-center gap-1 rounded-md bg-muted/50 p-0.5">
                @foreach (var lvl in _accessLevels)
                {
                    var level = lvl;
                    <button type="button"
                            @onclick="@(() => SelectLevel(level))"
                            class="@Cn.Merge("h-7 flex-1 rounded-md px-2 font-medium text-xs transition-all", _selectedLevel == level ? "bg-background shadow-sm" : "text-muted-foreground hover:text-foreground")">
                        @_accessLevelConfig[level].Label
                    </button>
                }
            </div>
        </div>

        @* Perks *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="star" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Included Perks</span>
            </div>
            <div class="mt-2 flex flex-col gap-2">
                @foreach (var perk in _currentPerks)
                {
                    <div class="flex items-center gap-2.5">
                        <span class="flex size-4 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                            <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                        </span>
                        <span class="text-sm">@perk</span>
                    </div>
                }
            </div>
        </div>

        @* Validity *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <p class="font-medium text-muted-foreground text-xs">Valid From</p>
                    <p class="mt-0.5 text-sm">@_passData.ValidFrom</p>
                </div>
                <div>
                    <p class="font-medium text-muted-foreground text-xs">Valid Until</p>
                    <p class="mt-0.5 text-sm">@_passData.ValidUntil</p>
                </div>
            </div>
        </div>

        @* Gate info *@
        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <p class="font-medium text-muted-foreground text-xs">Entry Point</p>
                <p class="mt-0.5 font-medium text-sm">@_passData.Gate</p>
                <p class="mt-1 text-muted-foreground text-xs">
                    Present this pass and a valid photo ID at the gate.
                </p>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Non-transferable &middot; Single-use entry &middot; Subject to venue rules
            </p>
        </div>

    </div>
</section>

@code {
    private record PassData(
        string EventName,
        string Venue,
        string Date,
        string HolderName,
        string AccessLevel,
        string PassId,
        string ValidFrom,
        string ValidUntil,
        string Gate
    );

    private record AccessLevelInfo(string Label, string Color, string DotColor);

    private static readonly PassData _passData = new(
        EventName: "Neon Horizon World Tour",
        Venue: "Madison Square Garden, New York",
        Date: "May 18, 2026",
        HolderName: "Jordan Mitchell",
        AccessLevel: "backstage",
        PassId: "BSP-2026-00482",
        ValidFrom: "May 18, 2026 — 4:00 PM",
        ValidUntil: "May 19, 2026 — 2:00 AM",
        Gate: "Gate B — Artist Entrance"
    );

    private static readonly Dictionary<string, AccessLevelInfo> _accessLevelConfig = new()
    {
        ["backstage"]  = new("Backstage",    "text-amber-600 dark:text-amber-400",    "bg-amber-500"),
        ["vip"]        = new("VIP",          "text-blue-600 dark:text-blue-400",      "bg-blue-500"),
        ["meet-greet"] = new("Meet & Greet", "text-emerald-600 dark:text-emerald-400","bg-emerald-500"),
    };

    private static readonly Dictionary<string, string[]> _perks = new()
    {
        ["backstage"]  = ["Full backstage access", "Sound check viewing", "Artist lounge entry", "Complimentary catering", "Priority parking"],
        ["vip"]        = ["VIP viewing area", "Dedicated bar access", "Fast-track entry", "Complimentary drink"],
        ["meet-greet"] = ["Meet & Greet session", "Photo opportunity", "Signed merchandise", "VIP area access", "Early entry"],
    };

    private static readonly string[] _accessLevels = ["backstage", "vip", "meet-greet"];

    private string _selectedLevel = "backstage";

    private AccessLevelInfo _config => _accessLevelConfig[_selectedLevel];
    private string[] _currentPerks => _perks[_selectedLevel];

    private void SelectLevel(string level)
    {
        _selectedLevel = level;
    }
}
