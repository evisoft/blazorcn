@* ============================================================
   Block: music-concert-setlist
   Title: MusicConcertSetlist
   Description: A concert setlist display block for React and Next.js with numbered songs, durations, encore markers, total show time, venue header, and share button built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-concert-setlist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="music" Size="16" Class="size-4 text-muted-foreground" />
                        <span class="font-medium text-sm">@_artist</span>
                    </div>
                    <div class="mt-1 flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        <span>@_venue, @_city</span>
                        <span>&middot;</span>
                        <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                        <span>@_eventDate</span>
                    </div>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline"
                          Size="ButtonSize.Sm"
                          Class="h-7 gap-1.5 text-xs"
                          OnClick="HandleShare">
                    @if (_copied)
                    {
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                        <span>Copied</span>
                    }
                    else
                    {
                        <LucideIconCn Name="share" Size="12" Class="size-3" />
                        <span>Share Setlist</span>
                    }
                </ButtonCn>
            </div>
        </div>

        @* Stats bar *@
        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <LucideIconCn Name="clock" Size="12" Class="size-3" />
                <span class="tabular-nums">@_totalMinutes min</span>
            </div>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="text-muted-foreground text-xs">@_mainSetCount songs</span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="text-muted-foreground text-xs">@_encoreCount encore</span>
        </div>

        @* Song list *@
        <div>
            @{
                var encoreDividerShown = false;
            }
            @foreach (var entry in IndexedSongs)
            {
                var song = entry.Song;
                var index = entry.Index;
                var showEncoreDivider = song.Encore && !encoreDividerShown;
                if (showEncoreDivider) { encoreDividerShown = true; }
                var isLast = index == _songs.Length - 1;

                @if (showEncoreDivider)
                {
                    <div class="flex items-center gap-3 border-b px-4 py-2">
                        <div class="h-px flex-1 bg-border"></div>
                        <span class="font-medium text-muted-foreground text-xs uppercase tracking-wider">Encore</span>
                        <div class="h-px flex-1 bg-border"></div>
                    </div>
                }
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <span class="w-5 text-right font-mono text-muted-foreground text-xs tabular-nums">@(index + 1)</span>
                    <span class="min-w-0 flex-1 truncate font-medium text-sm">@song.Title</span>
                    <span class="font-mono text-muted-foreground text-xs tabular-nums">@FormatDuration(song.DurationSec)</span>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between text-muted-foreground text-xs">
                <span>@_songs.Length songs &middot; @_totalMinutes minutes total</span>
                <span>setlist.fm</span>
            </div>
        </div>

    </div>
</section>

@code {
    private record Song(string Id, string Title, int DurationSec, bool Encore);
    private record IndexedSong(Song Song, int Index);

    private const string _venue = "Madison Square Garden";
    private const string _city = "New York, NY";
    private const string _eventDate = "Mar 15, 2026";
    private const string _artist = "The National";

    private static readonly Song[] _songs =
    [
        new("1",  "Don't Swallow the Cap",       258, false),
        new("2",  "Bloodbuzz Ohio",               244, false),
        new("3",  "I Need My Girl",               212, false),
        new("4",  "Fake Empire",                  342, false),
        new("5",  "Terrible Love",                316, false),
        new("6",  "Graceless",                    335, false),
        new("7",  "Sea of Love",                  284, false),
        new("8",  "About Today",                  268, false),
        new("9",  "Day I Die",                    296, false),
        new("10", "Mr. November",                 278, false),
        new("11", "Slow Show",                    322, true),
        new("12", "Vanderlyle Crybaby Geeks",     288, true),
    ];

    private static readonly int _totalSeconds = ComputeTotalSeconds();
    private static readonly int _totalMinutes = _totalSeconds / 60;
    private static readonly int _mainSetCount = CountMainSet();
    private static readonly int _encoreCount = CountEncore();

    private bool _copied = false;

    private IEnumerable<IndexedSong> IndexedSongs =>
        _songs.Select((s, i) => new IndexedSong(s, i));

    private static int ComputeTotalSeconds()
    {
        var sum = 0;
        foreach (var s in _songs) sum += s.DurationSec;
        return sum;
    }

    private static int CountMainSet()
    {
        var n = 0;
        foreach (var s in _songs) { if (!s.Encore) n++; }
        return n;
    }

    private static int CountEncore()
    {
        var n = 0;
        foreach (var s in _songs) { if (s.Encore) n++; }
        return n;
    }

    private static string FormatDuration(int seconds)
    {
        var min = seconds / 60;
        var sec = seconds % 60;
        return $"{min}:{sec:D2}";
    }

    private async Task HandleShare()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
