@* ============================================================
   Block: music-concert-countdown
   Title: MusicConcertCountdown
   Description: A concert countdown timer block for React and Next.js with large countdown numbers, event details, venue info, add-to-calendar button, and ticket purchase link built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-concert-countdown.tsx
   ============================================================ *@

@implements IDisposable

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="music" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">@_event.Name</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    Upcoming
                </BadgeCn>
            </div>
            <div class="mt-1.5 flex items-center gap-2">
                <LucideIconCn Name="user" Size="12" Class="size-3 text-muted-foreground" />
                <span class="text-muted-foreground text-sm">@_event.Artist</span>
            </div>
        </div>

        @* Countdown *@
        <div class="border-b px-4 py-6">
            <div class="grid grid-cols-4 gap-3">
                <div class="text-center">
                    <div class="rounded-md bg-muted/50 px-2 py-3">
                        <span class="font-semibold text-2xl tabular-nums">@_countdown.Days</span>
                    </div>
                    <span class="mt-1.5 block text-muted-foreground text-xs">Days</span>
                </div>
                <div class="text-center">
                    <div class="rounded-md bg-muted/50 px-2 py-3">
                        <span class="font-semibold text-2xl tabular-nums">@_countdown.Hours</span>
                    </div>
                    <span class="mt-1.5 block text-muted-foreground text-xs">Hours</span>
                </div>
                <div class="text-center">
                    <div class="rounded-md bg-muted/50 px-2 py-3">
                        <span class="font-semibold text-2xl tabular-nums">@_countdown.Minutes</span>
                    </div>
                    <span class="mt-1.5 block text-muted-foreground text-xs">Minutes</span>
                </div>
                <div class="text-center">
                    <div class="rounded-md bg-muted/50 px-2 py-3">
                        <span class="font-semibold text-2xl tabular-nums">@_countdown.Seconds</span>
                    </div>
                    <span class="mt-1.5 block text-muted-foreground text-xs">Seconds</span>
                </div>
            </div>
        </div>

        @* Event details *@
        <div class="space-y-2.5 border-b px-4 py-3">
            <div class="flex items-center gap-2.5">
                <LucideIconCn Name="map-pin" Size="14" Class="size-3.5 text-muted-foreground" />
                <div>
                    <span class="text-sm">@_event.Venue</span>
                    <span class="ml-1.5 text-muted-foreground text-xs">@_event.Location</span>
                </div>
            </div>
            <div class="flex items-center gap-2.5">
                <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-muted-foreground" />
                <div class="flex items-center gap-2 text-sm">
                    <span>@_event.Date</span>
                    <span class="text-muted-foreground text-xs">&middot;</span>
                    <span>@_event.Time</span>
                </div>
            </div>
            <div class="flex items-center gap-2.5">
                <span class="size-1.5 rounded-full bg-amber-500"></span>
                <span class="text-muted-foreground text-xs">Doors open at @_event.DoorsOpen</span>
            </div>
        </div>

        @* Actions *@
        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 flex-1 gap-1.5 text-xs">
                <LucideIconCn Name="ticket" Size="12" Class="size-3" />
                Get Tickets
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 flex-1 gap-1.5 text-xs">
                <LucideIconCn Name="calendar-plus" Size="12" Class="size-3" />
                Add to Calendar
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Limited availability &middot; VIP packages from $149
            </p>
        </div>

    </div>
</section>

@code {
    private record EventDetails(
        string Name,
        string Artist,
        string Venue,
        string Location,
        string Date,
        string Time,
        string DoorsOpen
    );

    private record CountdownState(int Days, int Hours, int Minutes, int Seconds);

    private static readonly EventDetails _event = new(
        Name: "Neon Horizons Tour",
        Artist: "Luna Vega",
        Venue: "The Anthem",
        Location: "Washington, DC",
        Date: "May 17, 2026",
        Time: "8:00 PM",
        DoorsOpen: "7:00 PM"
    );

    private CountdownState _countdown = new(Days: 47, Hours: 14, Minutes: 32, Seconds: 18);

    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ =>
        {
            int days = _countdown.Days;
            int hours = _countdown.Hours;
            int minutes = _countdown.Minutes;
            int seconds = _countdown.Seconds;

            seconds -= 1;
            if (seconds < 0) { seconds = 59; minutes -= 1; }
            if (minutes < 0) { minutes = 59; hours -= 1; }
            if (hours < 0) { hours = 23; days -= 1; }
            if (days < 0) { days = 0; hours = 0; minutes = 0; seconds = 0; }

            _countdown = new CountdownState(days, hours, minutes, seconds);
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
