@* ============================================================
   Block: music-streaming-dashboard
   Title: MusicStreamingDashboard
   Description: A music streaming analytics dashboard block for React and Next.js with total streams counter, top tracks bar chart, recent activity feed, and listener geography built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-streaming-dashboard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="headphones" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Streaming Dashboard</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Last 30 days</BadgeCn>
            </div>
        </div>

        @* Stats row *@
        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">Total Streams</span>
                <div class="mt-1 flex items-baseline gap-1.5">
                    <span class="font-semibold text-2xl tabular-nums">@_totalStreams.ToString("N0")</span>
                    <span class="flex items-center gap-0.5 text-emerald-600 text-xs dark:text-emerald-400">
                        <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                        12%
                    </span>
                </div>
            </div>
            <div class="border-r px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">Monthly Listeners</span>
                <div class="mt-1">
                    <span class="font-semibold text-2xl tabular-nums">@_monthlyListeners.ToString("N0")</span>
                </div>
            </div>
            <div class="px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">Avg. Stream Time</span>
                <div class="mt-1 flex items-baseline gap-0.5">
                    <span class="font-semibold text-2xl tabular-nums">@_avgStreamTime.ToString("F1")</span>
                    <span class="text-muted-foreground text-sm">min</span>
                </div>
            </div>
        </div>

        @* Two-panel layout: Chart + Activity *@
        <div class="grid grid-cols-2 border-b">

            @* Top Tracks Chart *@
            <div class="border-r px-4 py-3">
                <div class="mb-3 flex items-center gap-2">
                    <LucideIconCn Name="music" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-xs">Top Tracks</span>
                </div>
                <div class="h-[200px] w-full">
                    @{
                        var chartW = 320;
                        var chartH = 200;
                        var rowH = 28;
                        var barMaxW = 160;
                        var labelW = 90;
                        var valueW = 36;
                        var padLeft = labelW + 4;
                        var padRight = valueW + 4;
                        var availW = chartW - padLeft - padRight;
                        var maxStreams = _topTracks.Max(t => t.Streams);
                        var padTop = 4;
                    }
                    <svg viewBox="0 0 @chartW @chartH" class="w-full h-full overflow-visible" aria-label="Top tracks bar chart">
                        @for (int i = 0; i < _topTracks.Length; i++)
                        {
                            var track = _topTracks[i];
                            var cy = padTop + i * rowH + rowH / 2;
                            var barW2 = (int)(availW * track.Streams / maxStreams);
                            var barY = cy - 6;
                            var kVal = (int)Math.Round(track.Streams / 1000.0);
                            @((MarkupString)$"<text x=\"{labelW - 2}\" y=\"{cy + 4}\" text-anchor=\"end\" font-size=\"11\" fill=\"currentColor\" fill-opacity=\"0.7\">{track.Name}</text>")
                            @((MarkupString)$"<rect x=\"{padLeft}\" y=\"{barY}\" width=\"{barW2}\" height=\"12\" rx=\"4\" ry=\"4\" fill=\"var(--chart-1, hsl(var(--primary)))\"/>")
                            @((MarkupString)$"<text x=\"{padLeft + barW2 + 4}\" y=\"{cy + 4}\" font-size=\"10\" fill=\"currentColor\" fill-opacity=\"0.5\">{kVal}K</text>")
                        }
                    </svg>
                </div>
            </div>

            @* Recent Activity *@
            <div class="px-4 py-3">
                <div class="mb-3 flex items-center gap-2">
                    <LucideIconCn Name="play" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-xs">Recent Activity</span>
                </div>
                <div class="space-y-0">
                    @foreach (var item in _recentActivity)
                    {
                        <div class="flex items-center gap-3 rounded-md px-2 py-2 transition-colors hover:bg-muted/50">
                            <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", item.Action == "play" ? "bg-emerald-500" : "bg-blue-500")"></span>
                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-sm">@item.Track</span>
                                <p class="truncate text-muted-foreground text-xs">
                                    @item.User @(item.Action == "play" ? "played" : "saved")
                                </p>
                            </div>
                            <span class="shrink-0 text-muted-foreground text-xs">@item.Time</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Listener Geography *@
        <div class="px-4 py-3">
            <div class="mb-3 flex items-center gap-2">
                <LucideIconCn Name="globe" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-xs">Listener Geography</span>
            </div>
            <div class="space-y-2.5">
                @foreach (var region in _regions)
                {
                    <div class="flex items-center gap-3">
                        <span class="w-28 shrink-0 text-sm">@region.Name</span>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground" style="@($"width:{region.Percentage}%")"></div>
                        </div>
                        <span class="w-12 shrink-0 text-right text-muted-foreground text-xs tabular-nums">@region.Listeners</span>
                    </div>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private record TrackData(string Name, int Streams);
    private record ActivityItem(string Id, string Action, string Track, string User, string Time);
    private record RegionData(string Name, int Percentage, string Listeners);

    private const int _totalStreams = 2847563;
    private const int _monthlyListeners = 184920;
    private const double _avgStreamTime = 3.2;

    private static readonly TrackData[] _topTracks =
    [
        new("Midnight Signal", 482000),
        new("Neon Pulse",      371000),
        new("Echoes of You",   298000),
        new("Glass Highway",   245000),
        new("Slow Burn",       219000),
        new("Drift Away",      187000),
    ];

    private static readonly ActivityItem[] _recentActivity =
    [
        new("1", "play", "Midnight Signal", "Sarah K.",   "2 min ago"),
        new("2", "save", "Neon Pulse",      "Marcus J.",  "8 min ago"),
        new("3", "play", "Glass Highway",   "Aiko T.",    "14 min ago"),
        new("4", "play", "Echoes of You",   "Daniel R.",  "21 min ago"),
        new("5", "save", "Slow Burn",       "Emma L.",    "35 min ago"),
    ];

    private static readonly RegionData[] _regions =
    [
        new("North America", 42, "77.7K"),
        new("Europe",        28, "51.8K"),
        new("Asia Pacific",  18, "33.3K"),
        new("Latin America",  8, "14.8K"),
        new("Rest of World",  4, "7.4K"),
    ];
}
