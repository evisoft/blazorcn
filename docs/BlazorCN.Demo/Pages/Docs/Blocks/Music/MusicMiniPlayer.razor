@* ============================================================
   Block: music-mini-player
   Title: MusicMiniPlayer
   Description: A compact music mini player bar block for React and Next.js with album art, track info, progress bar, playback controls, like toggle, and volume slider built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-mini-player.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Main player row *@
        <div class="flex items-center gap-3 px-4 py-3">

            @* Album art *@
            <div class="@Cn.Merge("flex size-10 shrink-0 items-center justify-center rounded-md text-white font-semibold text-sm", _track.CoverColor)">
                @_track.CoverInitial
            </div>

            @* Track info *@
            <div class="min-w-0 flex-1">
                <p class="truncate font-medium text-sm">@_track.Title</p>
                <p class="truncate text-muted-foreground text-xs">
                    @_track.Artist &middot; @_track.Album
                </p>
            </div>

            @* Like button *@
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 shrink-0 p-0"
                      OnClick="@(() => _isLiked = !_isLiked)"
                      aria-label="@(_isLiked ? "Unlike track" : "Like track")"
                      aria-pressed="@(_isLiked.ToString().ToLower())">
                <LucideIconCn Name="heart" Size="14" Class="@Cn.Merge("size-3.5 transition-colors", _isLiked ? "fill-red-500 text-red-500" : "text-muted-foreground")" />
            </ButtonCn>

            @* Playback controls *@
            <div class="flex shrink-0 items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0" aria-label="Previous track">
                    <LucideIconCn Name="skip-back" Size="14" Class="size-3.5 text-muted-foreground" />
                </ButtonCn>

                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-8 rounded-full p-0"
                          OnClick="@(() => _isPlaying = !_isPlaying)"
                          aria-label="@(_isPlaying ? "Pause" : "Play")">
                    @if (_isPlaying)
                    {
                        <LucideIconCn Name="pause" Size="14" Class="size-3.5" />
                    }
                    else
                    {
                        <LucideIconCn Name="play" Size="14" Class="size-3.5" />
                    }
                </ButtonCn>

                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0" aria-label="Next track">
                    <LucideIconCn Name="skip-forward" Size="14" Class="size-3.5 text-muted-foreground" />
                </ButtonCn>
            </div>

            @* Volume control - hidden on mobile *@
            <div class="hidden shrink-0 items-center gap-2 sm:flex">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0"
                          OnClick="@(() => _isMuted = !_isMuted)"
                          aria-label="@(_isMuted ? "Unmute" : "Mute")">
                    @if (_isMuted || _volume == 0)
                    {
                        <LucideIconCn Name="volume-x" Size="14" Class="size-3.5 text-muted-foreground" />
                    }
                    else
                    {
                        <LucideIconCn Name="volume-2" Size="14" Class="size-3.5 text-muted-foreground" />
                    }
                </ButtonCn>
                <SliderCn Value="@((double)(_isMuted ? 0 : _volume))"
                          ValueChanged="@((double v) => { _volume = (int)v; if (_isMuted) _isMuted = false; })"
                          Max="100"
                          Step="1"
                          Class="w-20"
                          aria-label="Volume" />
            </div>
        </div>

        @* Progress bar section *@
        <div class="px-4 pb-3">
            <div class="flex items-center gap-3">
                <span class="w-8 text-right font-mono text-muted-foreground text-xs tabular-nums">
                    @_track.Elapsed
                </span>
                <div class="h-1 flex-1 overflow-hidden rounded-full bg-muted">
                    <div class="h-full rounded-full bg-foreground" style="@($"width:{_track.Progress}%")"></div>
                </div>
                <span class="w-8 font-mono text-muted-foreground text-xs tabular-nums">
                    @_track.Duration
                </span>
            </div>
        </div>

    </div>
</section>

@code {
    private record TrackInfo(string Title, string Artist, string Album, string Duration, string Elapsed, int Progress, string CoverColor, string CoverInitial);

    private static readonly TrackInfo _track = new(
        Title: "Midnight City",
        Artist: "M83",
        Album: "Hurry Up, We're Dreaming",
        Duration: "4:03",
        Elapsed: "1:47",
        Progress: 44,
        CoverColor: "bg-indigo-600",
        CoverInitial: "M"
    );

    private bool _isPlaying = true;
    private bool _isLiked = false;
    private int _volume = 72;
    private bool _isMuted = false;
}
