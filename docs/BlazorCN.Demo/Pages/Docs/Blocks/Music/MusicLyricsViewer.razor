@* ============================================================
   Block: music-lyrics-viewer
   Title: MusicLyricsViewer
   Description: A synced lyrics viewer block for React and Next.js with highlighted current line, auto-scroll toggle, font size control, and timestamp display built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-lyrics-viewer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Track info header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="music" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Holocene</span>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Bon Iver · Bon Iver, Bon Iver
            </p>
        </div>

        @* Controls bar *@
        <div class="flex items-center justify-between border-b px-4 py-2.5">
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="font-mono text-muted-foreground text-xs">
                        @CurrentTime / 5:36
                    </span>
                </div>
            </div>
            <div class="flex items-center gap-3">
                @* Font size control *@
                <div class="flex items-center gap-1">
                    <LucideIconCn Name="a-large-small" Size="12" Class="size-3 text-muted-foreground" />
                    <div class="flex items-center gap-0.5 rounded-md bg-muted/50 p-0.5">
                        @foreach (var s in _fontSizes)
                        {
                            var size = s;
                            <ButtonCn Variant="ButtonVariant.Ghost"
                                      Size="ButtonSize.Sm"
                                      Class="@Cn.Merge("h-6 w-6 p-0 text-xs", _fontSize == size ? "bg-background shadow-sm" : "text-muted-foreground")"
                                      OnClick="@(() => _fontSize = size)">
                                @size
                            </ButtonCn>
                        }
                    </div>
                </div>
                @* Auto-scroll toggle *@
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="scroll-text" Size="12" Class="size-3 text-muted-foreground" />
                    <SwitchCn Checked="@_autoScroll"
                              CheckedChanged="@((bool v) => { _autoScroll = v; })"
                              Class="scale-75"
                              aria-label="Auto-scroll lyrics" />
                </div>
            </div>
        </div>

        @* Lyrics display *@
        <div class="h-[400px] overflow-y-auto px-4 py-4">
            <div class="space-y-1">
                @for (int i = 0; i < _lyrics.Length; i++)
                {
                    var index = i;
                    var line = _lyrics[i];
                    var isActive = index == _currentLine;
                    var isPast = index < _currentLine;
                    var isEmpty = line.Text == "";

                    if (isEmpty)
                    {
                        <div class="h-6"></div>
                    }
                    else
                    {
                        <div class="group">
                            <button type="button"
                                    @onclick="@(() => _currentLine = index)"
                                    class="@Cn.Merge("w-full rounded-md px-2 py-1.5 text-left transition-all duration-300", FontSizeClass, isActive ? "bg-muted/50 font-medium text-foreground" : isPast ? "text-muted-foreground/40" : "text-muted-foreground/70 hover:text-muted-foreground")">
                                <div class="flex items-start gap-3">
                                    <span class="mt-0.5 shrink-0 font-mono text-muted-foreground/40 text-xs opacity-0 transition-opacity group-hover:opacity-100">
                                        @line.Time
                                    </span>
                                    <span class="leading-relaxed">@line.Text</span>
                                </div>
                            </button>
                        </div>
                    }
                }
            </div>
        </div>

        @* Navigation footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <ButtonCn Variant="ButtonVariant.Ghost"
                      Size="ButtonSize.Sm"
                      Class="h-7 text-xs"
                      OnClick="@(() => _currentLine = Math.Max(0, _currentLine - 1))">
                Previous line
            </ButtonCn>
            <span class="font-mono text-muted-foreground text-xs">
                @(_currentLine + 1) / @_lyrics.Length
            </span>
            <ButtonCn Variant="ButtonVariant.Ghost"
                      Size="ButtonSize.Sm"
                      Class="h-7 text-xs"
                      OnClick="@(() => _currentLine = Math.Min(_lyrics.Length - 1, _currentLine + 1))">
                Next line
            </ButtonCn>
        </div>

    </div>
</section>

@code {
