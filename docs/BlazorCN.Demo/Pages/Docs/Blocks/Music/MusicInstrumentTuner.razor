@* ============================================================
   Block: music-instrument-tuner
   Title: MusicInstrumentTuner
   Description: An instrument tuner block for React and Next.js with needle meter display, detected note name, cents sharp/flat indicator, frequency readout, and instrument selector built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-instrument-tuner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="guitar" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Instrument Tuner</span>
            </div>
            <ButtonCn Variant="@(_isListening ? ButtonVariant.Default : ButtonVariant.Outline)"
                      Size="ButtonSize.Sm"
                      Class="h-7 gap-1.5 text-xs"
                      OnClick="@(() => _isListening = !_isListening)">
                <LucideIconCn Name="mic" Size="12" Class="size-3" />
                @(_isListening ? "Listening" : "Start")
            </ButtonCn>
        </div>

        @* Instrument selector *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-1 rounded-md bg-muted/50 p-0.5">
                @foreach (var ins in _instruments)
                {
                    var inst = ins;
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-7 flex-1 text-xs", _selectedInstrument == inst.Id ? "bg-background shadow-sm" : "text-muted-foreground")"
                              OnClick="@(() => { _selectedInstrument = inst.Id; _selectedString = null; })">
                        @inst.Name
                    </ButtonCn>
                }
            </div>
        </div>

        @* Needle meter *@
        <div class="border-b px-4 py-6">
            <div class="relative mx-auto h-32 w-full max-w-xs">

                @* Scale arc background *@
                <div class="absolute inset-x-0 bottom-0 h-px bg-border"></div>

                @* Scale markers *@
                <div class="absolute inset-x-0 bottom-0 flex items-end justify-between px-2">
                    @for (int i = 0; i < 11; i++)
                    {
                        var isCenter = i == 5;
                        <div class="flex flex-col items-center gap-1">
                            <div class="@Cn.Merge("w-px", isCenter ? "h-4 bg-foreground" : "h-2.5 bg-muted-foreground/40")"></div>
                        </div>
                    }
                </div>

                @* Scale labels *@
                <div class="absolute inset-x-0 bottom-6 flex justify-between px-1">
                    <span class="font-mono text-muted-foreground text-xs">-50</span>
                    <span class="font-mono text-muted-foreground text-xs">-25</span>
                    <span class="font-mono text-foreground text-xs">0</span>
                    <span class="font-mono text-muted-foreground text-xs">+25</span>
                    <span class="font-mono text-muted-foreground text-xs">+50</span>
                </div>

                @* Needle *@
                <div class="absolute bottom-0 left-1/2 -translate-x-1/2">
                    <div class="flex flex-col items-center"
                         style="@(FormattableString.Invariant($"transform: rotate({_needleRotation:F1}deg); transform-origin: bottom center;"))">
                        <div class="@Cn.Merge("h-16 w-0.5 rounded-full", _isInTune ? "bg-emerald-500" : "bg-foreground")"></div>
                    </div>
                    <div class="@Cn.Merge("mt-0.5 size-2 rounded-full", _isInTune ? "bg-emerald-500" : "bg-foreground")"></div>
                </div>

            </div>
        </div>

        @* Note display *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-center gap-4">
                <div class="text-center">
                    <div class="flex items-baseline justify-center gap-1">
                        <span class="@Cn.Merge("font-semibold text-4xl tabular-nums", _isInTune ? "text-emerald-600 dark:text-emerald-400" : "text-foreground")">
                            @_detectedNote
                        </span>
                        <span class="font-medium text-muted-foreground text-sm">@_detectedOctave</span>
                    </div>
                    <div class="mt-1 flex items-center justify-center gap-2">
                        <span class="@Cn.Merge("font-mono text-sm tabular-nums", _centsOffset > 0 ? "text-amber-600 dark:text-amber-400" : _centsOffset < 0 ? "text-blue-600 dark:text-blue-400" : "text-emerald-600 dark:text-emerald-400")">
                            @(_centsOffset > 0 ? $"+{_centsOffset}" : _centsOffset.ToString()) cents
                        </span>
                        <span class="text-muted-foreground text-xs">&middot;</span>
                        <span class="font-mono text-muted-foreground text-xs tabular-nums">
                            @(_detectedFrequency.ToString("F1")) Hz
                        </span>
                    </div>
                </div>
            </div>
            @if (_isInTune)
            {
                <p class="mt-2 text-center text-emerald-600 text-xs dark:text-emerald-400">
                    In tune
                </p>
            }
        </div>

        @* String selector *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Strings</span>
            <div class="flex items-center gap-2">
                @if (_currentInstrument is not null)
                {
                    @foreach (var str in _currentInstrument.Strings)
                    {
                        var s = str;
                        <ButtonCn Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Sm"
                                  Class="@Cn.Merge("h-8 flex-1 font-mono text-xs", _selectedString == s ? "ring-2 ring-foreground" : "")"
                                  OnClick="@(() => _selectedString = (_selectedString == s ? null : s))">
                            @s
                        </ButtonCn>
                    }
                }
            </div>
        </div>

        @* Reference frequency *@
        <div class="px-4 py-2.5">
            <div class="flex items-center justify-between text-muted-foreground text-xs">
                <span>Reference: A4 = @_targetFrequency Hz</span>
                <span>Chromatic mode</span>
            </div>
        </div>

    </div>
</section>

@code {
    private record InstrumentDef(string Id, string Name, string[] Strings);

    private static readonly InstrumentDef[] _instruments =
    [
        new("guitar",  "Guitar",  ["E2", "A2", "D3", "G3", "B3", "E4"]),
        new("bass",    "Bass",    ["E1", "A1", "D2", "G2"]),
        new("ukulele", "Ukulele", ["G4", "C4", "E4", "A4"]),
        new("violin",  "Violin",  ["G3", "D4", "A4", "E5"]),
    ];

    private string _selectedInstrument = "guitar";
    private string? _selectedString = null;
    private bool _isListening = true;

    // Static tuner reading values (presentational)
    private const string _detectedNote = "A";
    private const int _detectedOctave = 4;
    private const double _detectedFrequency = 441.2;
    private const int _centsOffset = 3;
    private const double _targetFrequency = 440.0;

    private double _needleRotation => (_centsOffset / 50.0) * 45.0;
    private bool _isInTune => Math.Abs(_centsOffset) <= 3;

    private InstrumentDef? _currentInstrument =>
        Array.Find(_instruments, i => i.Id == _selectedInstrument);
}
