@* ============================================================
   Block: music-open-mic
   Title: MusicOpenMic
   Description: An open mic night signup and schedule block for React and Next.js with performer registration, time slot management, current performer display, waiting list, and audience vote system built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-open-mic.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="mic" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Open Mic Night</span>
            </div>
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_performers.Count performers
                </BadgeCn>
                <ButtonCn Variant="ButtonVariant.Outline"
                          Size="ButtonSize.Sm"
                          Class="h-7 text-xs"
                          OnClick="@(() => _showSignup = !_showSignup)">
                    @(_showSignup ? "Cancel" : "Sign Up")
                </ButtonCn>
            </div>
        </div>

        @* Signup form *@
        @if (_showSignup)
        {
            <div class="border-b px-4 py-3">
                <div class="flex flex-col gap-2">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="user" Size="14" Class="size-3.5 text-muted-foreground" />
                        <InputCn @bind-Value="_newName"
                                 Placeholder="Your name"
                                 Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
                    </div>
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="music" Size="14" Class="size-3.5 text-muted-foreground" />
                        <InputCn @bind-Value="_newSong"
                                 Placeholder="Song choice (title — artist)"
                                 Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs" OnClick="HandleSignup">
                        Join the List
                    </ButtonCn>
                </div>
            </div>
        }

        @* Current performer *@
        @{
            var currentPerformer = _performers.Find(p => p.Status == "performing");
        }
        @if (currentPerformer != null)
        {
            <div class="border-b bg-muted/30 px-4 py-3">
                <div class="mb-1 flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="font-medium text-muted-foreground text-xs">Now Performing</span>
                </div>
                <div class="flex items-center justify-between">
                    <div>
                        <span class="block font-medium text-sm">@currentPerformer.Name</span>
                        <span class="block text-muted-foreground text-xs">@currentPerformer.Song</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <ButtonCn Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Sm"
                                  Class="h-7 gap-1 px-2 text-xs"
                                  OnClick="@(() => HandleVote(currentPerformer.Id))">
                            <LucideIconCn Name="thumbs-up" Size="12" Class="size-3" />
                            @currentPerformer.Votes
                        </ButtonCn>
                        <div class="flex items-center gap-0.5">
                            @for (int i = 0; i < 5; i++)
                            {
                                var filled = i < (int)Math.Round(currentPerformer.Votes / 5.0);
                                <LucideIconCn Name="star" Size="12" Class="@(filled ? "size-3 fill-amber-500 text-amber-500" : "size-3 text-muted-foreground/30")" />
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        @* Waiting list header *@
        @{
            var waitingList = _performers.FindAll(p => p.Status == "waiting");
        }
        <div class="border-b px-4 py-2.5">
            <span class="font-medium text-muted-foreground text-xs">
                Up Next &middot; @waitingList.Count waiting
            </span>
        </div>

        @* Waiting list *@
        @for (int i = 0; i < waitingList.Count; i++)
        {
            var performer = waitingList[i];
            var index = i;
            var isLast = index == waitingList.Count - 1;
            <div class="@(isLast ? "flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50" : "flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50 border-b")">
                <span class="w-4 text-center font-mono text-muted-foreground text-xs tabular-nums">
                    @(index + 1)
                </span>
                <div class="min-w-0 flex-1">
                    <span class="block truncate font-medium text-sm">@performer.Name</span>
                    <span class="block truncate text-muted-foreground text-xs">@performer.Song</span>
                </div>
                <div class="flex items-center gap-1">
                    <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="font-mono text-muted-foreground text-xs">@performer.TimeSlot</span>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.Sm"
                          Class="h-6 gap-1 px-2 text-xs"
                          OnClick="@(() => HandleVote(performer.Id))">
                    <LucideIconCn Name="thumbs-up" Size="12" Class="size-3" />
                    @performer.Votes
                </ButtonCn>
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                15 min per performer &middot; Vote for your favorites
            </p>
        </div>

    </div>
</section>

@code {
    private class Performer
    {
        public string Id { get; init; } = "";
        public string Name { get; init; } = "";
        public string Song { get; init; } = "";
        public string TimeSlot { get; init; } = "";
        public int Votes { get; set; }
        public string Status { get; init; } = "";

        public Performer(string id, string name, string song, string timeSlot, int votes, string status)
        {
            Id = id; Name = name; Song = song; TimeSlot = timeSlot; Votes = votes; Status = status;
        }
    }

    private List<Performer> _performers =
    [
        new("p1", "Sarah Chen",   "Hallelujah — Leonard Cohen",        "8:00 PM", 24, "performing"),
        new("p2", "Marcus Reid",  "Wonderwall — Oasis",                 "8:15 PM", 18, "waiting"),
        new("p3", "Aiko Tanaka",  "Fly Me to the Moon — Sinatra",       "8:30 PM", 12, "waiting"),
        new("p4", "Dev Patel",    "Original — Untitled Ballad",         "8:45 PM",  9, "waiting"),
        new("p5", "Luna Reyes",   "Fast Car — Tracy Chapman",           "9:00 PM", 15, "waiting"),
    ];

    private string _newName = "";
    private string _newSong = "";
    private bool _showSignup = false;

    private void HandleVote(string id)
    {
        var p = _performers.Find(x => x.Id == id);
        if (p != null) p.Votes++;
    }

    private void HandleSignup()
    {
        if (string.IsNullOrWhiteSpace(_newName) || string.IsNullOrWhiteSpace(_newSong))
            return;

        var waitingList = _performers.FindAll(p => p.Status == "waiting");
        var nextSlotMinute = (waitingList.Count + 1) * 15;
        var hour = 9 + nextSlotMinute / 60;
        var minute = nextSlotMinute % 60;
        var timeSlot = $"{hour}:{minute:D2} PM";

        _performers.Add(new Performer(
            $"p{_performers.Count + 1}",
            _newName.Trim(),
            _newSong.Trim(),
            timeSlot,
            0,
            "waiting"
        ));
        _newName = "";
        _newSong = "";
        _showSignup = false;
    }
}
