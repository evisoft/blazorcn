@* ============================================================
   Block: music-release-calendar
   Title: MusicReleaseCalendar
   Description: An upcoming music releases calendar block for React and Next.js with release dates, album art placeholders, artist names, genre tags, and remind-me notification toggles built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-release-calendar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Upcoming Releases</span>
            </div>
            <span class="text-muted-foreground text-xs">@_reminders.Count reminders set</span>
        </div>

        @* Month group label *@
        <div class="border-b bg-muted/30 px-4 py-2">
            <span class="font-medium text-muted-foreground text-xs uppercase tracking-wide">
                April - May 2026
            </span>
        </div>

        @* Release list *@
        @for (int i = 0; i < _releases.Length; i++)
        {
            var release = _releases[i];
            bool isLast = i == _releases.Length - 1;
            bool hasReminder = _reminders.Contains(release.Id);
            <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">

                @* Album art placeholder *@
                <div class="@Cn.Merge("flex size-10 shrink-0 items-center justify-center rounded-md", release.Color)">
                    <LucideIconCn Name="disc" Size="16" Class="size-4 text-muted-foreground" />
                </div>

                @* Release info *@
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="truncate font-medium text-sm">@release.Album</span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">@release.Type</BadgeCn>
                    </div>
                    <div class="mt-0.5 flex items-center gap-2">
                        <span class="truncate text-muted-foreground text-xs">@release.Artist</span>
                        <span class="text-muted-foreground text-xs">·</span>
                        <span class="text-muted-foreground text-xs">@release.Genre</span>
                    </div>
                </div>

                @* Date and reminder *@
                <div class="flex shrink-0 flex-col items-end gap-1">
                    <span class="font-mono text-muted-foreground text-xs">@release.ReleaseDate</span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-6 gap-1 px-2 text-xs", hasReminder ? "text-foreground" : "text-muted-foreground")"
                              @onclick="@(() => ToggleReminder(release.Id))"
                              aria-label="@(hasReminder ? $"Remove reminder for {release.Album}" : $"Set reminder for {release.Album}")">
                        @if (hasReminder)
                        {
                            <LucideIconCn Name="bell" Size="12" Class="size-3 fill-current" />
                            <span>On</span>
                        }
                        else
                        {
                            <LucideIconCn Name="bell-off" Size="12" Class="size-3" />
                            <span>Off</span>
                        }
                    </ButtonCn>
                </div>

            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                @_releases.Length upcoming releases · Updated weekly
            </p>
        </div>

    </div>
</section>

@code {
    private record Release(string Id, string Artist, string Album, string ReleaseDate, string Genre, string Type, string Color);

    private static readonly Release[] _releases =
    [
        new("r1", "Cassandra Vale", "Nocturne Boulevard", "Apr 4, 2026",  "Indie Pop", "Album",  "bg-violet-500/20"),
        new("r2", "Static River",   "Tectonic Drift",     "Apr 11, 2026", "Post Rock", "Album",  "bg-slate-500/20"),
        new("r3", "Luma",           "Helios",             "Apr 18, 2026", "Electronic","EP",     "bg-cyan-500/20"),
        new("r4", "Jade Solaris",   "Golden Hour",        "Apr 25, 2026", "R&B",       "Single", "bg-amber-500/20"),
        new("r5", "Broken Atlas",   "Fault Lines",        "May 2, 2026",  "Alt Rock",  "Album",  "bg-red-500/20"),
        new("r6", "Circuit Bloom",  "Midnight Frequency", "May 9, 2026",  "House",     "EP",     "bg-emerald-500/20"),
        new("r7", "Kaia Morrow",    "Wildflower Season",  "May 16, 2026", "Folk",      "Album",  "bg-orange-500/20"),
    ];

    private HashSet<string> _reminders = ["r1", "r3"];

    private void ToggleReminder(string id)
    {
        if (!_reminders.Remove(id))
            _reminders.Add(id);
    }
}
