@* ============================================================
   Block: music-fan-club
   Title: MusicFanClub
   Description: A music fan club membership block for React and Next.js with tier badges, member count, exclusive content list, perks checklist, and join CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-fan-club.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="heart" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Fan Club</span>
            </div>
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="users" Size="12" Class="size-3" />
                <span class="tabular-nums">@_totalMembers.ToString("N0") members</span>
            </div>
        </div>

        @* Artist info *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-muted">
                    <LucideIconCn Name="music-2" Size="20" Class="size-5 text-muted-foreground" />
                </div>
                <div>
                    <span class="font-medium text-sm">Nova Eclipse</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Join the inner circle. Get exclusive music, behind-the-scenes access, and VIP perks.
                    </p>
                </div>
            </div>
        </div>

        @* Tier selector *@
        <div class="border-b px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Select Tier</span>
            <div class="mt-2 grid grid-cols-4 gap-2">
                @foreach (var t in _tiers)
                {
                    var tier = t;
                    <button type="button"
                            @onclick="@(() => SelectTier(tier.Id))"
                            class="@Cn.Merge("inline-flex flex-col items-center gap-0.5 rounded-md border border-input bg-background px-3 py-2 text-xs font-medium ring-offset-background transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 h-auto", _selectedTier == tier.Id ? "ring-2 ring-foreground" : "")">
                        <div class="flex items-center gap-1">
                            <span class="@Cn.Merge("size-1.5 rounded-full", tier.DotColor)"></span>
                            <span class="@Cn.Merge("font-medium", tier.Color)">@tier.Name</span>
                        </div>
                        <span class="text-muted-foreground">$@tier.Price/mo</span>
                    </button>
                }
            </div>
        </div>

        @* Tier member count *@
        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <LucideIconCn Name="crown" Size="16" Class="@Cn.Merge("size-4", _activeTier.Color)" />
            <span class="text-xs text-muted-foreground">
                <span class="font-semibold tabular-nums">@_activeTier.MemberCount.ToString("N0")</span>
                @(" ")@_activeTier.Name members
            </span>
        </div>

        @* Exclusive content label *@
        <div class="border-b px-4 py-2.5">
            <span class="text-xs font-medium text-muted-foreground">Exclusive Content</span>
        </div>

        @* Exclusive content list *@
        <div class="border-b">
            @for (int i = 0; i < _exclusiveContent.Length; i++)
            {
                var item = _exclusiveContent[i];
                var isUnlocked = TierIndex(item.Tier) <= _selectedIdx;
                var isLast = i == _exclusiveContent.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    @if (isUnlocked)
                    {
                        <LucideIconCn Name="unlock" Size="14" Class="size-3.5 shrink-0 text-emerald-600 dark:text-emerald-400" />
                    }
                    else
                    {
                        <LucideIconCn Name="lock" Size="14" Class="size-3.5 shrink-0 text-muted-foreground/40" />
                    }
                    <div class="min-w-0 flex-1">
                        <span class="@Cn.Merge("text-sm", isUnlocked ? "font-medium" : "text-muted-foreground")">@item.Title</span>
                    </div>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs px-1.5 py-0">@item.Type</BadgeCn>
                    <span class="text-xs text-muted-foreground">@item.Date</span>
                </div>
            }
        </div>

        @* Perks label *@
        <div class="border-b px-4 py-2.5">
            <span class="text-xs font-medium text-muted-foreground">@_activeTier.Name Perks</span>
        </div>

        @* Perks checklist *@
        <div class="border-b px-4 py-3">
            <div class="grid gap-2">
                @foreach (var perk in GetPerks(_selectedTier))
                {
                    <div class="flex items-center gap-2.5">
                        @if (perk.Included)
                        {
                            <span class="flex size-4 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                                <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                            </span>
                        }
                        else
                        {
                            <span class="flex size-4 shrink-0 items-center justify-center rounded-full bg-muted">
                                <LucideIconCn Name="lock" Size="10" Class="size-2.5 text-muted-foreground/40" />
                            </span>
                        }
                        <span class="@Cn.Merge("text-sm", perk.Included ? "" : "text-muted-foreground")">@perk.Label</span>
                    </div>
                }
            </div>
        </div>

        @* Price and CTA *@
        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-baseline justify-between">
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-2xl tabular-nums">$@_activeTier.Price</span>
                    <span class="text-sm text-muted-foreground">/mo</span>
                </div>
                <span class="text-xs text-muted-foreground">Cancel anytime</span>
            </div>
            @if (_joined)
            {
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 w-full gap-1.5 text-xs" OnClick="@(() => _joined = false)">
                    <LucideIconCn Name="sparkles" Size="12" Class="size-3" />
                    You are a @_activeTier.Name Member
                </ButtonCn>
            }
            else
            {
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full gap-1.5 text-xs" OnClick="@(() => _joined = true)">
                    <LucideIconCn Name="star" Size="12" Class="size-3" />
                    Join @_activeTier.Name Tier
                </ButtonCn>
            }
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-xs text-muted-foreground">
                Secure payment &middot; Instant access &middot; Cancel anytime
            </p>
        </div>

    </div>
</section>

@code {
    private record Tier(string Id, string Name, int Price, string Color, string DotColor, int MemberCount);
    private record ContentItem(string Id, string Title, string Type, string Tier, string Date);
    private record Perk(string Id, string Label, bool Included);

    private static readonly Tier[] _tiers =
    [
        new("bronze",   "Bronze",   5,  "text-amber-700 dark:text-amber-500", "bg-amber-700 dark:bg-amber-500", 4280),
        new("silver",   "Silver",   15, "text-zinc-400",                      "bg-zinc-400",                    1840),
        new("gold",     "Gold",     30, "text-amber-400",                     "bg-amber-400",                   620),
        new("platinum", "Platinum", 50, "text-zinc-300 dark:text-zinc-200",   "bg-zinc-300 dark:bg-zinc-200",   185),
    ];

    private static readonly int _totalMembers = 4280 + 1840 + 620 + 185;

    private static readonly ContentItem[] _exclusiveContent =
    [
        new("ec1", "Studio Session: Recording 'Neon Dreams'",    "Video",  "bronze",   "Mar 28"),
        new("ec2", "Unreleased Demo: 'Midnight Highway'",         "Audio",  "silver",   "Mar 25"),
        new("ec3", "Handwritten Lyrics Collection",               "PDF",    "gold",     "Mar 20"),
        new("ec4", "Private Acoustic Livestream Recording",       "Video",  "silver",   "Mar 15"),
        new("ec5", "Meet & Greet VIP Pass (Next Tour)",           "Ticket", "platinum", "Mar 10"),
    ];

    private static readonly string[] _tierOrder = ["bronze", "silver", "gold", "platinum"];

    private string _selectedTier = "gold";
    private bool _joined = false;

    private Tier _activeTier => Array.Find(_tiers, t => t.Id == _selectedTier) ?? _tiers[2];
    private int _selectedIdx => TierIndex(_selectedTier);

    private static int TierIndex(string tierId)
    {
        return Array.IndexOf(_tierOrder, tierId);
    }

    private static Perk[] GetPerks(string selectedTier)
    {
        var idx = TierIndex(selectedTier);
        return
        [
            new("p1", "Access to community feed",          idx >= 0),
            new("p2", "Behind-the-scenes content",         idx >= 0),
            new("p3", "Early access to new releases",      idx >= 1),
            new("p4", "Unreleased demos and B-sides",      idx >= 1),
            new("p5", "Exclusive merch discounts (20%)",   idx >= 2),
            new("p6", "Monthly video Q&A sessions",        idx >= 2),
            new("p7", "VIP concert pre-sale access",       idx >= 3),
            new("p8", "Annual meet & greet invitation",    idx >= 3),
        ];
    }

    private void SelectTier(string tierId)
    {
        _selectedTier = tierId;
        _joined = false;
    }
}
