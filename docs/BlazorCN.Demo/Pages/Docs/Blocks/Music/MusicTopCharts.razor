@* ============================================================
   Block: music-top-charts
   Title: MusicTopCharts
   Description: A music top charts block for React and Next.js with ranked track list, artist names, weeks on chart, movement indicators, and play buttons built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-top-charts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="trending-up" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Top Charts</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                This Week
            </BadgeCn>
        </div>

        @* Column labels *@
        <div class="flex items-center gap-3 border-b bg-muted/30 px-4 py-2">
            <span class="w-6 text-center font-medium text-muted-foreground text-xs">#</span>
            <span class="size-8 shrink-0"></span>
            <span class="min-w-0 flex-1 font-medium text-muted-foreground text-xs">Track</span>
            <span class="hidden w-16 text-right font-medium text-muted-foreground text-xs sm:block">
                Streams
            </span>
            <span class="hidden w-12 text-center font-medium text-muted-foreground text-xs sm:block">
                Wks
            </span>
            <span class="w-10 text-center font-medium text-muted-foreground text-xs">Move</span>
            <span class="w-7 shrink-0"></span>
        </div>

        @* Track rows *@
        @for (int i = 0; i < _chartTracks.Length; i++)
        {
            var track = _chartTracks[i];
            bool isLast = i == _chartTracks.Length - 1;
            var cfg = GetMovementConfig(track.Movement);
            <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">

                @* Rank *@
                <span class="@Cn.Merge("w-6 text-center font-semibold text-sm tabular-nums", track.Rank <= 3 ? "text-foreground" : "text-muted-foreground")">
                    @track.Rank
                </span>

                @* Album art placeholder *@
                <div class="flex size-8 shrink-0 items-center justify-center rounded bg-muted/50">
                    <LucideIconCn Name="music" Size="14" Class="size-3.5 text-muted-foreground" />
                </div>

                @* Track info *@
                <div class="min-w-0 flex-1">
                    <span class="block truncate font-medium text-sm">@track.Title</span>
                    <span class="block truncate text-muted-foreground text-xs">@track.Artist</span>
                </div>

                @* Streams *@
                <span class="hidden w-16 text-right font-mono text-muted-foreground text-xs tabular-nums sm:block">
                    @track.Streams
                </span>

                @* Weeks on chart *@
                <span class="hidden w-12 text-center font-mono text-muted-foreground text-xs tabular-nums sm:block">
                    @track.WeeksOnChart
                </span>

                @* Movement *@
                <div class="flex w-10 items-center justify-center gap-0.5"
                     role="img"
                     aria-label="@($"{cfg.Label}{(track.PositionsChanged > 0 ? $" {track.PositionsChanged} positions" : "")}")">
                    <LucideIconCn Name="@cfg.IconName" Size="14" Class="@Cn.Merge("size-3.5", cfg.Color)" />
                    @if (track.Movement == "new")
                    {
                        <span class="font-medium text-blue-600 text-[10px] dark:text-blue-400">
                            NEW
                        </span>
                    }
                    else if (track.PositionsChanged > 0)
                    {
                        <span class="@Cn.Merge("font-mono text-xs tabular-nums", cfg.Color)">
                            @track.PositionsChanged
                        </span>
                    }
                </div>

                @* Play button *@
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                          Class="size-7 shrink-0 p-0"
                          aria-label="@($"Play {track.Title}")">
                    <LucideIconCn Name="play" Size="14" Class="size-3.5" />
                </ButtonCn>
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Updated every Monday · Based on global streaming data
            </p>
        </div>

    </div>
</section>

@code {
    private record ChartTrack(string Id, int Rank, string Title, string Artist, int WeeksOnChart, string Movement, int PositionsChanged, string Streams);
    private record MovementConfig(string IconName, string Color, string Label);

    private static readonly ChartTrack[] _chartTracks =
    [
        new("c1",  1, "Die With A Smile",     "Lady Gaga & Bruno Mars",        28, "steady", 0, "98.2M"),
        new("c2",  2, "APT.",                  "Rose & Bruno Mars",              22, "up",     1, "87.4M"),
        new("c3",  3, "Birds of a Feather",    "Billie Eilish",                 36, "down",   1, "76.1M"),
        new("c4",  4, "Timeless",              "The Weeknd & Playboi Carti",    14, "up",     2, "71.8M"),
        new("c5",  5, "Luther",                "Kendrick Lamar & SZA",          10, "new",    0, "68.3M"),
        new("c6",  6, "That's So True",        "Gracie Abrams",                 18, "down",   2, "59.7M"),
        new("c7",  7, "Sailor Song",           "Gigi Perez",                    20, "up",     3, "54.2M"),
        new("c8",  8, "Taste",                 "Sabrina Carpenter",             30, "down",   1, "51.9M"),
        new("c9",  9, "Good Luck, Babe!",      "Chappell Roan",                 42, "steady", 0, "48.6M"),
        new("c10", 10, "Espresso",             "Sabrina Carpenter",             46, "down",   1, "45.1M"),
    ];

    private static MovementConfig GetMovementConfig(string movement) => movement switch
    {
        "up"     => new("arrow-up",     "text-emerald-600 dark:text-emerald-400", "Up"),
        "down"   => new("arrow-down",   "text-red-600 dark:text-red-400",         "Down"),
        "steady" => new("minus",        "text-muted-foreground",                  "Steady"),
        "new"    => new("trending-up",  "text-blue-600 dark:text-blue-400",       "New entry"),
        _        => new("minus",        "text-muted-foreground",                  "Steady"),
    };
}
