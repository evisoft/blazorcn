@* ============================================================
   Block: music-playlist-compare
   Title: MusicPlaylistCompare
   Description: A playlist comparison block for React and Next.js with side-by-side playlist views, shared track highlighting, genre overlap percentage, and merge playlist action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-playlist-compare.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="git-merge" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Playlist Comparison</span>
            </div>
            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_sharedCount shared
                </span>
                <span>&#183;</span>
                <span>@_totalUnique unique total</span>
            </div>
        </div>

        @* Side-by-side playlists *@
        <div class="grid grid-cols-2 border-b">

            @* Playlist A *@
            <div class="border-r">
                <div class="flex items-center gap-2 border-b px-4 py-2.5">
                    <LucideIconCn Name="list-music" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-xs">Late Night Vibes</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@_playlistA.Length tracks</BadgeCn>
                </div>
                <div>
                    @for (int i = 0; i < _playlistA.Length; i++)
                    {
                        var track = _playlistA[i];
                        var isShared = _sharedIds.Contains(track.Id);
                        var isLast = i == _playlistA.Length - 1;
                        <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                            <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", isShared ? "bg-emerald-500" : "bg-muted-foreground/30")"></span>
                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-sm">@track.Title</span>
                                <p class="truncate text-muted-foreground text-xs">@track.Artist</p>
                            </div>
                            <span class="shrink-0 font-mono text-muted-foreground text-xs">@track.Duration</span>
                        </div>
                    }
                </div>
            </div>

            @* Playlist B *@
            <div>
                <div class="flex items-center gap-2 border-b px-4 py-2.5">
                    <LucideIconCn Name="list-music" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-xs">Chill Discoveries</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@_playlistB.Length tracks</BadgeCn>
                </div>
                <div>
                    @for (int i = 0; i < _playlistB.Length; i++)
                    {
                        var track = _playlistB[i];
                        var isShared = _sharedIds.Contains(track.Id);
                        var isLast = i == _playlistB.Length - 1;
                        <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                            <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", isShared ? "bg-emerald-500" : "bg-muted-foreground/30")"></span>
                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-sm">@track.Title</span>
                                <p class="truncate text-muted-foreground text-xs">@track.Artist</p>
                            </div>
                            <span class="shrink-0 font-mono text-muted-foreground text-xs">@track.Duration</span>
                        </div>
                    }
                </div>
            </div>

        </div>

        @* Genre Overlap *@
        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="music" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-xs">Genre Overlap</span>
                </div>
                <span class="font-semibold text-sm tabular-nums">@_overlapPercent% match</span>
            </div>
            <div class="space-y-2.5">
                @foreach (var genre in _genres)
                {
                    <div class="flex items-center gap-3">
                        <span class="w-24 shrink-0 text-muted-foreground text-xs">@genre.Name</span>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground" style="@($"width:{genre.OverlapPercent}%")"></div>
                        </div>
                        <span class="w-8 shrink-0 text-right text-muted-foreground text-xs tabular-nums">@genre.OverlapPercent%</span>
                    </div>
                }
            </div>
        </div>

        @* Merge Action *@
        <div class="flex items-center justify-between px-4 py-3">
            <p class="text-muted-foreground text-xs">
                Merge creates a new playlist with @_totalUnique unique tracks
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="@(() => _merged = true)" Disabled="@_merged">
                @if (_merged)
                {
                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                    <span>Merged</span>
                }
                else
                {
                    <LucideIconCn Name="sparkles" Size="12" Class="size-3" />
                    <span>Merge Playlists</span>
                }
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Track(string Id, string Title, string Artist, string Duration);
    private record GenreOverlap(string Name, int OverlapPercent);

    private static readonly Track[] _playlistA =
    [
        new("t1", "Midnight Signal",  "Neon Waves",   "3:42"),
        new("t2", "Echoes of You",    "Glass Tide",   "4:18"),
        new("t3", "Slow Burn",        "Velvet Haze",  "3:55"),
        new("t4", "Drift Away",       "Solar Flare",  "4:02"),
        new("t5", "Crystal Clear",    "Moonlit",      "3:29"),
        new("t6", "Neon Pulse",       "Neon Waves",   "3:48"),
        new("t7", "Golden Hour",      "Amber Sky",    "4:11"),
    ];

    private static readonly Track[] _playlistB =
    [
        new("t2", "Echoes of You",  "Glass Tide",    "4:18"),
        new("t8", "Fading Light",   "Dusk Patrol",   "3:36"),
        new("t5", "Crystal Clear",  "Moonlit",       "3:29"),
        new("t9", "Starfall",       "Cosmic Drift",  "4:45"),
        new("t3", "Slow Burn",      "Velvet Haze",   "3:55"),
        new("t10","Paper Moon",     "Silk Route",    "3:22"),
    ];

    private static readonly HashSet<string> _sharedIds = new(
        _playlistA.Where(a => _playlistB.Any(b => b.Id == a.Id)).Select(t => t.Id)
    );

    private static readonly GenreOverlap[] _genres =
    [
        new("Indie Pop",   78),
        new("Synth Wave",  62),
        new("Dream Pop",   45),
        new("Alternative", 31),
    ];

    private static readonly int _totalUnique =
        new HashSet<string>(_playlistA.Select(t => t.Id).Concat(_playlistB.Select(t => t.Id))).Count;

    private static readonly int _sharedCount = _sharedIds.Count;

    private static readonly int _overlapPercent = (int)Math.Round((double)_sharedIds.Count / _totalUnique * 100);

    private bool _merged = false;
}
