@* ============================================================
   Block: music-band-members
   Title: MusicBandMembers
   Description: A band member roster block for React and Next.js with avatar placeholders, instrument icons, member-since year, role labels, and bio snippets built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-band-members.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Band header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">@_bandName</span>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">
                @_bandGenre · @_bandLocation
            </p>
        </div>

        @* Band stats *@
        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <span class="text-muted-foreground text-xs">Formed @_bandFormed</span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">@_members.Length members</span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">3 albums</span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">247 shows</span>
        </div>

        @* Members *@
        @for (var i = 0; i < _members.Length; i++)
        {
            var member = _members[i];
            var isLast = i == _members.Length - 1;
            var isExpanded = _expanded == member.Id;
            var memberId = member.Id;
            <div class="@Cn.Merge(isLast ? "" : "border-b")">
                <button type="button"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => _expanded = isExpanded ? null : memberId)">
                    <AvatarCn Class="size-9 shrink-0">
                        <AvatarFallbackCn Class="@($"text-xs {member.Color}")">@member.Initials</AvatarFallbackCn>
                    </AvatarCn>

                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="truncate font-medium text-sm">@member.Name</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">Since @member.Since</BadgeCn>
                        </div>
                        <div class="mt-0.5 flex items-center gap-1.5">
                            @if (member.Instrument == "vocals")
                            {
                                <LucideIconCn Name="mic" Size="12" Class="size-3 text-muted-foreground" />
                            }
                            else if (member.Instrument == "guitar")
                            {
                                <LucideIconCn Name="guitar" Size="12" Class="size-3 text-muted-foreground" />
                            }
                            else
                            {
                                <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                            }
                            <span class="truncate text-muted-foreground text-xs">@member.Role</span>
                        </div>
                    </div>

                    <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                </button>

                @if (isExpanded)
                {
                    <div class="px-4 pb-3 pl-16">
                        <div class="rounded-md bg-muted/50 p-3">
                            <p class="text-sm leading-relaxed">@member.Bio</p>
                        </div>
                    </div>
                }
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                @_bandName · Est. @_bandFormed · @_bandLocation
            </p>
        </div>

    </div>
</section>

@code {
    private record Member(string Id, string Name, string Initials, string Role, string Instrument, int Since, string Bio, string Color);

    private const string _bandName = "The Coastlines";
    private const int _bandFormed = 2018;
    private const string _bandGenre = "Surf Rock / Indie";
    private const string _bandLocation = "San Diego, CA";

    private static readonly Member[] _members =
    [
        new("m1", "Elena Vasquez", "EV", "Lead Vocals & Rhythm Guitar", "vocals", 2018,
            "Founding member who started writing songs on a borrowed acoustic in her college dorm. Known for her warm alto voice and intricate fingerpicking patterns that define the band's signature sound.",
            "bg-violet-500/20 text-violet-700 dark:text-violet-300"),
        new("m2", "Kai Nakamura",  "KN", "Lead Guitar",                 "guitar", 2018,
            "Co-founder and primary riff architect. Spent two years studying flamenco in Seville before returning to blend Mediterranean scales with California surf tones. His pedalboard is legendary.",
            "bg-amber-500/20 text-amber-700 dark:text-amber-300"),
        new("m3", "Marcus Webb",   "MW", "Bass & Backing Vocals",        "bass",   2019,
            "Joined after a chance jam session at a house show in Ocean Beach. Brings a funk-influenced groove that anchors the rhythm section. Also handles most of the band's visual design work.",
            "bg-emerald-500/20 text-emerald-700 dark:text-emerald-300"),
        new("m4", "Sierra Chen",   "SC", "Drums & Percussion",           "drums",  2018,
            "Founding member and the band's metronome. Studied jazz percussion at Berklee before deciding she preferred beach bonfires to practice rooms. Her tom fills are instantly recognizable.",
            "bg-red-500/20 text-red-700 dark:text-red-300"),
        new("m5", "Jordan Park",   "JP", "Keys & Synth",                 "keys",   2021,
            "The newest addition who transformed the band's sound with lush analog synth pads and vintage Rhodes tones. Previously toured with two electronic acts before finding a home with The Coastlines.",
            "bg-blue-500/20 text-blue-700 dark:text-blue-300"),
    ];

    private string? _expanded = "m1";
}
