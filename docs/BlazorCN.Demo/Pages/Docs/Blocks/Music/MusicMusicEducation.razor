@* ============================================================
   Block: music-music-education
   Title: MusicMusicEducation
   Description: A music lesson catalog block for React and Next.js with course cards, difficulty levels, instrument filters, progress tracking, and enrollment buttons built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-music-education.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="book-open" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Music Lessons</span>
                </div>
                <div class="flex items-center gap-2 text-muted-foreground text-xs">
                    <span>@_enrolledCount enrolled</span>
                    <span>&middot;</span>
                    <span>@_totalLessons lessons total</span>
                </div>
            </div>
        </div>

        @* Lesson list *@
        <div>
            @foreach (var (lesson, index) in _lessons.Select((l, i) => (l, i)))
            {
                var item = lesson;
                var idx = index;
                var isEnrolled = _enrolledIds.Contains(item.Id);
                var progress = item.LessonsCount > 0
                    ? (int)Math.Round((double)item.CompletedLessons / item.LessonsCount * 100)
                    : 0;
                var isLast = idx == _lessons.Length - 1;
                var instrumentIconName = GetInstrumentIcon(item.Instrument);
                var diffClass = GetDifficultyClass(item.Difficulty);
                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-3">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <LucideIconCn Name="@instrumentIconName" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                                    <span class="font-medium text-sm">@item.Title</span>
                                </div>
                                <p class="mt-0.5 text-muted-foreground text-xs">@item.Description</p>
                                <div class="mt-2 flex flex-wrap items-center gap-2">
                                    <span class="@($"inline-flex rounded-md px-1.5 py-0.5 font-medium text-xs {diffClass}")">
                                        @item.Difficulty
                                    </span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                        @item.Instrument
                                    </BadgeCn>
                                    <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                        <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                        @item.Duration
                                    </span>
                                    <span class="text-muted-foreground text-xs">
                                        @item.LessonsCount lessons
                                    </span>
                                </div>
                            </div>
                            <div class="shrink-0 pt-1">
                                @if (isEnrolled)
                                {
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                                        Continue
                                        <LucideIconCn Name="chevron-right" Size="12" Class="size-3" />
                                    </ButtonCn>
                                }
                                else
                                {
                                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="@(() => HandleEnroll(item.Id))">
                                        Enroll
                                    </ButtonCn>
                                }
                            </div>
                        </div>

                        @* Progress bar *@
                        @if (isEnrolled && item.CompletedLessons > 0)
                        {
                            <div class="mt-2.5">
                                <div class="mb-1 flex items-center justify-between">
                                    <span class="text-muted-foreground text-xs">
                                        @item.CompletedLessons/@item.LessonsCount completed
                                    </span>
                                    <span class="font-medium text-xs tabular-nums">@progress%</span>
                                </div>
                                <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                                    <div class="h-full rounded-full bg-foreground" style="@($"width:{progress}%")"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                New courses added weekly &middot; Cancel enrollment anytime
            </p>
        </div>

    </div>
</section>

@code {
    private record Lesson(
        string Id,
        string Title,
        string Description,
        string Difficulty,
        string Instrument,
        string Duration,
        int LessonsCount,
        int CompletedLessons,
        bool Enrolled
    );

    private static readonly Lesson[] _lessons =
    [
        new("l1", "Piano Fundamentals",       "Learn scales, chords, and hand positioning from scratch.",                         "Beginner",     "Piano",  "6 weeks",  24, 18, true),
        new("l2", "Blues Guitar Techniques",  "Master bending, slides, vibrato, and 12-bar blues patterns.",                      "Intermediate", "Guitar", "8 weeks",  32,  8, true),
        new("l3", "Jazz Improvisation",       "Explore modal scales, chord substitutions, and real-time solo building.",           "Advanced",     "Piano",  "10 weeks", 40,  0, false),
        new("l4", "Vocal Warm-Ups & Range",   "Develop breath control, extend vocal range, and prevent strain.",                   "Beginner",     "Vocals", "4 weeks",  16,  0, false),
        new("l5", "Music Theory Essentials",  "Understand intervals, key signatures, time signatures, and notation.",             "Beginner",     "Theory", "5 weeks",  20, 14, true),
        new("l6", "Advanced Drum Polyrhythms","Study cross-rhythms, odd time signatures, and independence patterns.",             "Advanced",     "Drums",  "12 weeks", 48,  0, false),
    ];

    private HashSet<string> _enrolledIds = new HashSet<string>(
        new[] { "l1", "l2", "l5" }
    );

    private int _enrolledCount => _enrolledIds.Count;
    private int _totalLessons => _lessons.Sum(l => l.LessonsCount);

    private void HandleEnroll(string id)
    {
        _enrolledIds.Add(id);
    }

    private static string GetInstrumentIcon(string instrument) => instrument switch
    {
        "Piano"  => "piano",
        "Guitar" => "guitar",
        "Theory" => "book-open",
        _        => "music",
    };

    private static string GetDifficultyClass(string difficulty) => difficulty switch
    {
        "Beginner"     => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        "Intermediate" => "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        "Advanced"     => "bg-red-500/10 text-red-600 dark:text-red-400",
        _              => "",
    };
}
