@* ============================================================
   Block: music-song-credits
   Title: MusicSongCredits
   Description: A song credits display block for React and Next.js with performer, songwriter, producer, engineer, and studio information, role labels, and recording dates built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-song-credits.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Track header *@
        <div class="flex items-start justify-between border-b px-4 py-3">
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="music" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">@_track.Title</span>
                </div>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_track.Artist &middot; @_track.Album
                </p>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs" @onclick="CopyCredits">
                @if (_copied)
                {
                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                    <span>Copied</span>
                }
                else
                {
                    <LucideIconCn Name="copy" Size="12" Class="size-3" />
                    <span>Copy</span>
                }
            </ButtonCn>
        </div>

        @* Track info *@
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 border-b px-4 py-2.5">
            <span class="text-muted-foreground text-xs">@_track.Duration</span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="text-muted-foreground text-xs">@_track.Released</span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@_track.Label</BadgeCn>
            <span class="font-mono text-muted-foreground text-xs">@_track.Isrc</span>
        </div>

        @* Credit sections *@
        @foreach (var sec in _creditsSections)
        {
            var grp = sec;
            <div class="border-b">
                <div class="bg-muted/30 px-4 py-2">
                    <span class="font-medium text-muted-foreground text-xs uppercase tracking-wide">@grp.Title</span>
                </div>
                @for (int ci = 0; ci < grp.Credits.Length; ci++)
                {
                    var credit = grp.Credits[ci];
                    var isLastCredit = ci == grp.Credits.Length - 1;
                    <div class="@Cn.Merge("flex items-baseline gap-3 px-4 py-2", !isLastCredit ? "border-b border-border/50" : "")">
                        <span class="w-36 shrink-0 text-muted-foreground text-xs">@credit.Role</span>
                        <span class="min-w-0 flex-1 text-sm">@credit.Name</span>
                    </div>
                }
            </div>
        }

        @* Session info *@
        <div class="border-b">
            <div class="bg-muted/30 px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs uppercase tracking-wide">Sessions</span>
            </div>
            @for (int si = 0; si < _sessionInfo.Length; si++)
            {
                var session = _sessionInfo[si];
                var isLastSession = si == _sessionInfo.Length - 1;
                <div class="@Cn.Merge("flex items-baseline gap-3 px-4 py-2", !isLastSession ? "border-b border-border/50" : "")">
                    <span class="w-36 shrink-0 text-muted-foreground text-xs">@session.Label</span>
                    <div class="min-w-0 flex-1">
                        <span class="text-sm">@session.Value</span>
                        <span class="ml-2 text-muted-foreground text-xs">@session.Location</span>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-center gap-1.5 px-4 py-2.5">
            <LucideIconCn Name="disc" Size="12" Class="size-3 text-muted-foreground" />
            <p class="text-center text-muted-foreground text-xs">
                @(_creditsSections.Sum(s => s.Credits.Length)) credits &middot; @_track.Label &middot; @_track.Released
            </p>
        </div>

    </div>
</section>

@code {
    private bool _copied = false;

    private record CreditEntry(string Role, string Name);
    private record CreditSection(string Title, CreditEntry[] Credits);
    private record TrackInfo(string Title, string Artist, string Album, string Duration, string Released, string Label, string Isrc);
    private record SessionEntry(string Label, string Value, string Location);

    private static readonly TrackInfo _track = new(
        Title: "Amber Skyline",
        Artist: "Cassandra Vale",
        Album: "Nocturne Boulevard",
        Duration: "4:32",
        Released: "Mar 14, 2026",
        Label: "Meridian Records",
        Isrc: "USRC12600147"
    );

    private static readonly CreditSection[] _creditsSections =
    [
        new("Performance",
        [
            new("Lead Vocals", "Cassandra Vale"),
            new("Guitar", "Marcus Holt"),
            new("Bass", "Reese Nakamura"),
            new("Drums", "Jonah Whitfield"),
            new("Keys & Synths", "Priya Desmond"),
            new("Backing Vocals", "Lena Ortiz, Cassandra Vale"),
        ]),
        new("Songwriting",
        [
            new("Written by", "Cassandra Vale, Marcus Holt"),
            new("Composed by", "Cassandra Vale, Priya Desmond"),
            new("Lyrics", "Cassandra Vale"),
        ]),
        new("Production",
        [
            new("Producer", "Ellis Blackwood"),
            new("Co-Producer", "Priya Desmond"),
            new("Executive Producer", "Amara Chen"),
            new("Arrangement", "Ellis Blackwood, Marcus Holt"),
        ]),
        new("Engineering",
        [
            new("Recording Engineer", "Sam Trujillo"),
            new("Mixing Engineer", "Devon Karras"),
            new("Mastering Engineer", "Clara Reinhardt"),
            new("Assistant Engineer", "Tomoko Arai"),
        ]),
    ];

    private static readonly SessionEntry[] _sessionInfo =
    [
        new("Recorded", "Jan 8-12, 2026", "Evergreen Studios, Nashville"),
        new("Mixed", "Feb 3, 2026", "Silver Lake Audio, Los Angeles"),
        new("Mastered", "Feb 18, 2026", "Sterling Sound, New York"),
    ];

    private async Task CopyCredits()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
