@* ============================================================
   Block: music-discover-weekly
   Title: MusicDiscoverWeekly
   Description: A discover weekly playlist block for React and Next.js with curated track recommendations, match percentages, genre tags, preview play buttons, and save/skip actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-discover-weekly.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Discover Weekly</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_visibleTracks.Length tracks
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Curated for you based on your recent listening activity.
            </p>
        </div>

        @* Track List *@
        <div>
            @foreach (var (track, index) in _visibleTracks.Select((t, i) => (t, i)))
            {
                var isLast = index == _visibleTracks.Length - 1;
                var isSaved = _saved.Contains(track.Id);
                var isPlaying = _playing == track.Id;
                var item = track;
                <div class="@Cn.Merge(isLast ? "" : "border-b")">
                    <div class="px-4 py-3">
                        @* Top row: track info + match *@
                        <div class="flex items-start gap-3">
                            @* Play button *@
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                      Class="mt-0.5 size-7 shrink-0 p-0"
                                      OnClick="@(() => TogglePlaying(item.Id))">
                                @if (isPlaying)
                                {
                                    <span class="flex items-center gap-0.5">
                                        <span class="size-0.5 animate-pulse rounded-full bg-foreground"></span>
                                        <span class="size-0.5 animate-pulse rounded-full bg-foreground"></span>
                                        <span class="size-0.5 animate-pulse rounded-full bg-foreground"></span>
                                    </span>
                                }
                                else
                                {
                                    <LucideIconCn Name="play" Size="12" Class="size-3" />
                                }
                            </ButtonCn>

                            @* Track info *@
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-sm">@track.Title</span>
                                    <span class="text-muted-foreground text-xs">&middot;</span>
                                    <span class="truncate text-muted-foreground text-xs">@track.Duration</span>
                                </div>
                                <p class="text-muted-foreground text-xs">@track.Artist</p>

                                @* Genre tags *@
                                <div class="mt-1.5 flex flex-wrap items-center gap-1">
                                    @foreach (var genre in track.Genres)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@genre</BadgeCn>
                                    }
                                </div>

                                @* Recommendation reason *@
                                <p class="mt-1.5 text-muted-foreground text-xs italic">@track.Reason</p>
                            </div>

                            @* Match percentage *@
                            <span class="@Cn.Merge("shrink-0 rounded-md px-2 py-0.5 font-semibold text-xs tabular-nums", MatchColor(track.MatchPercent))">
                                @track.MatchPercent%
                            </span>
                        </div>

                        @* Action buttons *@
                        <div class="mt-2 flex items-center gap-2 pl-10">
                            <ButtonCn Variant="@(isSaved ? ButtonVariant.Default : ButtonVariant.Outline)"
                                      Size="ButtonSize.Sm"
                                      Class="h-7 gap-1 text-xs"
                                      OnClick="@(() => HandleSave(item.Id))">
                                @if (isSaved)
                                {
                                    <LucideIconCn Name="heart" Size="12" Class="size-3" />
                                    <span>Saved</span>
                                }
                                else
                                {
                                    <LucideIconCn Name="bookmark" Size="12" Class="size-3" />
                                    <span>Save</span>
                                }
                            </ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                      Class="h-7 gap-1 text-xs text-muted-foreground"
                                      OnClick="@(() => HandleSkip(item.Id))">
                                <LucideIconCn Name="skip-forward" Size="12" Class="size-3" />
                                Skip
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Updated every Monday &middot; @_saved.Count saved &middot; @_skipped.Count skipped
            </p>
        </div>

    </div>
</section>

@code {
    private record Track(string Id, string Title, string Artist, int MatchPercent, string[] Genres, string Reason, string Duration);

    private static readonly Track[] _allTracks =
    [
        new("1", "Velvet Horizon",  "Luna Sol",      96, ["Indie Pop", "Dream Pop"],  "Similar vocal style to artists you listen to frequently",         "3:42"),
        new("2", "Chrome Rivers",   "The Parallax",  91, ["Synthwave", "Electronic"], "Matches your preference for 80s-inspired synth textures",          "4:18"),
        new("3", "Paper Lanterns",  "Miko Hara",     87, ["Lo-fi", "Ambient"],        "Popular with listeners who enjoy your top artists",                "3:05"),
        new("4", "Gravity Well",    "Orbital Shift", 84, ["Alt Rock", "Post-Punk"],   "Guitar tone matches your listening patterns this month",           "5:12"),
        new("5", "Amber Glow",      "Saffron Days",  79, ["Folk", "Acoustic"],        "Genre crossover from your acoustic playlist activity",             "3:38"),
        new("6", "Static Bloom",    "NVRLND",        74, ["IDM", "Glitch"],           "Expanding your taste based on experimental tracks you saved",      "4:55"),
    ];

    private HashSet<string> _saved = [];
    private HashSet<string> _skipped = [];
    private string? _playing = null;

    private Track[] _visibleTracks => _allTracks.Where(t => !_skipped.Contains(t.Id)).ToArray();

    private void TogglePlaying(string id)
    {
        _playing = (_playing == id) ? null : id;
    }

    private void HandleSave(string id)
    {
        if (_saved.Contains(id))
            _saved.Remove(id);
        else
            _saved.Add(id);
    }

    private void HandleSkip(string id)
    {
        _skipped.Add(id);
        if (_playing == id)
            _playing = null;
    }

    private static string MatchColor(int percent)
    {
        if (percent >= 90) return "text-emerald-600 dark:text-emerald-400 bg-emerald-500/10";
        if (percent >= 80) return "text-amber-600 dark:text-amber-400 bg-amber-500/10";
        return "text-muted-foreground bg-muted/50";
    }
}
