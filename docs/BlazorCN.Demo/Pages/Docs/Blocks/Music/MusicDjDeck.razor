@* ============================================================
   Block: music-dj-deck
   Title: MusicDjDeck
   Description: A DJ deck controller block for React and Next.js with dual turntable displays, BPM and key info, crossfader slider, sync button, and playback controls built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-dj-deck.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="disc" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">DJ Deck</span>
                @if (_synced)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        Synced
                    </BadgeCn>
                }
            </div>
        </div>

        @* Dual Decks *@
        <div class="grid grid-cols-2 border-b">

            @* Deck A *@
            <div class="border-r px-4 py-4">
                @* Turntable A *@
                <div class="flex flex-col items-center gap-3">
                    <div class="flex items-center gap-2">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono font-normal text-xs">
                            DECK A
                        </BadgeCn>
                    </div>

                    @* Turntable visual A *@
                    <div class="relative flex size-36 items-center justify-center rounded-full border-2 border-muted bg-muted/30">
                        <div class="flex size-28 items-center justify-center rounded-full border border-muted-foreground/20 bg-zinc-950 dark:bg-zinc-900">
                            <div class="flex size-8 items-center justify-center rounded-full bg-muted-foreground/20">
                                <div class="size-2 rounded-full bg-muted-foreground/60"></div>
                            </div>
                            @* Groove lines *@
                            <div class="absolute inset-4 rounded-full border border-muted-foreground/10"></div>
                            <div class="absolute inset-8 rounded-full border border-muted-foreground/10"></div>
                            <div class="absolute inset-12 rounded-full border border-muted-foreground/10"></div>
                        </div>
                    </div>

                    @* Track info A *@
                    <div class="w-full text-center">
                        <span class="font-medium text-sm">@_deckA.Title</span>
                        <p class="text-muted-foreground text-xs">@_deckA.Artist</p>
                    </div>

                    @* BPM & Key A *@
                    <div class="flex items-center gap-3">
                        <div class="text-center">
                            <span class="font-semibold text-sm tabular-nums">@_deckA.Bpm</span>
                            <p class="font-medium text-muted-foreground text-xs">BPM</p>
                        </div>
                        <span class="text-muted-foreground text-xs">&middot;</span>
                        <div class="text-center">
                            <span class="font-mono font-semibold text-sm">@_deckA.Key</span>
                            <p class="font-medium text-muted-foreground text-xs">Key</p>
                        </div>
                        <span class="text-muted-foreground text-xs">&middot;</span>
                        <div class="text-center">
                            <span class="font-mono text-muted-foreground text-xs">@_deckA.Elapsed</span>
                            <span class="text-muted-foreground text-xs"> / </span>
                            <span class="font-mono text-muted-foreground text-xs">@_deckA.Duration</span>
                        </div>
                    </div>
                </div>

                @* Playback controls A *@
                <div class="mt-3 flex items-center justify-center gap-2">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0" aria-label="Previous track deck A">
                        <LucideIconCn Name="skip-back" Size="12" Class="size-3" />
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-8 p-0"
                              OnClick="@(() => _playingA = !_playingA)"
                              aria-label="@(_playingA ? "Pause deck A" : "Play deck A")">
                        @if (_playingA)
                        {
                            <LucideIconCn Name="pause" Size="14" Class="size-3.5" />
                        }
                        else
                        {
                            <LucideIconCn Name="play" Size="14" Class="size-3.5" />
                        }
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0" aria-label="Next track deck A">
                        <LucideIconCn Name="skip-forward" Size="12" Class="size-3" />
                    </ButtonCn>
                </div>
            </div>

            @* Deck B *@
            <div class="px-4 py-4">
                @* Turntable B *@
                <div class="flex flex-col items-center gap-3">
                    <div class="flex items-center gap-2">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono font-normal text-xs">
                            DECK B
                        </BadgeCn>
                    </div>

                    @* Turntable visual B *@
                    <div class="relative flex size-36 items-center justify-center rounded-full border-2 border-muted bg-muted/30">
                        <div class="flex size-28 items-center justify-center rounded-full border border-muted-foreground/20 bg-zinc-950 dark:bg-zinc-900">
                            <div class="flex size-8 items-center justify-center rounded-full bg-muted-foreground/20">
                                <div class="size-2 rounded-full bg-muted-foreground/60"></div>
                            </div>
                            @* Groove lines *@
                            <div class="absolute inset-4 rounded-full border border-muted-foreground/10"></div>
                            <div class="absolute inset-8 rounded-full border border-muted-foreground/10"></div>
                            <div class="absolute inset-12 rounded-full border border-muted-foreground/10"></div>
                        </div>
                    </div>

                    @* Track info B *@
                    <div class="w-full text-center">
                        <span class="font-medium text-sm">@_deckB.Title</span>
                        <p class="text-muted-foreground text-xs">@_deckB.Artist</p>
                    </div>

                    @* BPM & Key B *@
                    <div class="flex items-center gap-3">
                        <div class="text-center">
                            <span class="font-semibold text-sm tabular-nums">@_deckB.Bpm</span>
                            <p class="font-medium text-muted-foreground text-xs">BPM</p>
                        </div>
                        <span class="text-muted-foreground text-xs">&middot;</span>
                        <div class="text-center">
                            <span class="font-mono font-semibold text-sm">@_deckB.Key</span>
                            <p class="font-medium text-muted-foreground text-xs">Key</p>
                        </div>
                        <span class="text-muted-foreground text-xs">&middot;</span>
                        <div class="text-center">
                            <span class="font-mono text-muted-foreground text-xs">@_deckB.Elapsed</span>
                            <span class="text-muted-foreground text-xs"> / </span>
                            <span class="font-mono text-muted-foreground text-xs">@_deckB.Duration</span>
                        </div>
                    </div>
                </div>

                @* Playback controls B *@
                <div class="mt-3 flex items-center justify-center gap-2">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0" aria-label="Previous track deck B">
                        <LucideIconCn Name="skip-back" Size="12" Class="size-3" />
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-8 p-0"
                              OnClick="@(() => _playingB = !_playingB)"
                              aria-label="@(_playingB ? "Pause deck B" : "Play deck B")">
                        @if (_playingB)
                        {
                            <LucideIconCn Name="pause" Size="14" Class="size-3.5" />
                        }
                        else
                        {
                            <LucideIconCn Name="play" Size="14" Class="size-3.5" />
                        }
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0" aria-label="Next track deck B">
                        <LucideIconCn Name="skip-forward" Size="12" Class="size-3" />
                    </ButtonCn>
                </div>
            </div>

        </div>

        @* Crossfader & Controls *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="font-mono text-muted-foreground text-xs">A</span>
                <span class="font-medium text-muted-foreground text-xs">Crossfader</span>
                <span class="font-mono text-muted-foreground text-xs">B</span>
            </div>
            <SliderCn aria-label="Crossfader" Value="@((double)_crossfader)"
                      ValueChanged="@((double v) => { _crossfader = (int)v; })"
                      Min="0"
                      Max="100"
                      Step="1"
                      Class="w-full" />
        </div>

        @* Sync & Controls *@
        <div class="flex items-center justify-center gap-3 px-4 py-3">
            <ButtonCn Variant="@(_synced ? ButtonVariant.Default : ButtonVariant.Outline)"
                      Size="ButtonSize.Sm"
                      Class="h-7 gap-1.5 text-xs"
                      OnClick="@(() => _synced = !_synced)">
                <LucideIconCn Name="link" Size="12" Class="size-3" />
                Sync
            </ButtonCn>
            <span class="text-muted-foreground text-xs">
                @(_synced ? $"Matched at {_deckA.Bpm} BPM" : $"{_deckA.Bpm} / {_deckB.Bpm} BPM")
            </span>
        </div>

    </div>
</section>

@code {
    private record DeckTrack(string Title, string Artist, int Bpm, string Key, string Duration, string Elapsed);

    private static readonly DeckTrack _deckA = new("Midnight Signal", "Aurora",    128, "8A", "6:42", "2:18");
    private static readonly DeckTrack _deckB = new("Neon Pulse",      "Kai Drift", 130, "8B", "5:55", "1:04");

    private bool _playingA = true;
    private bool _playingB = false;
    private int  _crossfader = 50;
    private bool _synced = false;
}
