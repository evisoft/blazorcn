@* ============================================================
   Block: music-practice-log
   Title: MusicPracticeLog
   Description: A music practice log tracker block for React and Next.js with daily minutes, weekly goal progress bar, streak counter, skill categories, and session history built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-practice-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="music-2" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Practice Log</span>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideIconCn Name="play" Size="12" Class="size-3" />
                Log Practice
            </ButtonCn>
        </div>

        @* Today's stats *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-6">
                <div>
                    <span class="text-xs font-medium text-muted-foreground">Today</span>
                    <div class="flex items-baseline gap-1">
                        <span class="font-semibold text-2xl tabular-nums">@_todayMinutes</span>
                        <span class="text-xs text-muted-foreground">min</span>
                    </div>
                </div>
                <div class="h-8 w-px bg-border"></div>
                <div>
                    <span class="text-xs font-medium text-muted-foreground">Streak</span>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="flame" Size="16" Class="size-4 text-amber-500" />
                        <span class="font-semibold text-2xl tabular-nums">@_currentStreak</span>
                        <span class="text-xs text-muted-foreground">days</span>
                    </div>
                </div>
                <div class="h-8 w-px bg-border"></div>
                <div>
                    <span class="text-xs font-medium text-muted-foreground">Best</span>
                    <div class="flex items-baseline gap-1">
                        <span class="font-semibold text-sm tabular-nums">@_longestStreak</span>
                        <span class="text-xs text-muted-foreground">days</span>
                    </div>
                </div>
            </div>
        </div>

        @* Weekly goal progress *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="target" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs font-medium text-muted-foreground">Weekly Goal</span>
                </div>
                <span class="font-mono text-xs text-muted-foreground">@_weeklyTotal / @_weeklyGoal min</span>
            </div>
            <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-foreground" style="@($"width:{_weeklyProgress}%")"></div>
            </div>
            <div class="mt-1.5 flex items-center justify-between">
                <span class="text-xs text-muted-foreground">@_weeklyProgress% complete</span>
                <span class="text-xs text-muted-foreground">@(_weeklyGoal - _weeklyTotal) min remaining</span>
            </div>
        </div>

        @* Skills This Week label *@
        <div class="border-b px-4 py-2.5">
            <span class="text-xs font-medium text-muted-foreground">Skills This Week</span>
        </div>

        @* Skills list *@
        <div class="border-b">
            @for (int i = 0; i < _skills.Length; i++)
            {
                var skill = _skills[i];
                var percentage = (int)Math.Round((double)skill.Minutes / _totalSkillMinutes * 100);
                var isSelected = _selectedSkill == skill.Id;
                var isNotLast = i < _skills.Length - 1;
                <button type="button"
                        @onclick="@(() => { var sid = skill.Id; _selectedSkill = (_selectedSkill == sid ? null : sid); })"
                        class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50", isNotLast ? "border-b" : "", isSelected ? "bg-muted/50" : "")">
                    <span class="@($"size-2 shrink-0 rounded-full {skill.Color}")"></span>
                    <LucideIconCn Name="@skill.IconName" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="flex-1 font-medium text-sm">@skill.Name</span>
                    <span class="font-mono text-xs text-muted-foreground">@skill.Minutes min</span>
                    <div class="w-16">
                        <div class="h-1 w-full overflow-hidden rounded-full bg-muted">
                            <div class="@($"h-full rounded-full {skill.Color}")" style="@($"width:{percentage}%")"></div>
                        </div>
                    </div>
                    <span class="w-8 text-right font-mono text-xs text-muted-foreground">@(percentage)%</span>
                </button>
            }
        </div>

        @* Recent Sessions label *@
        <div class="border-b px-4 py-2.5">
            <span class="text-xs font-medium text-muted-foreground">Recent Sessions</span>
        </div>

        @* Session history *@
        <div>
            @for (int i = 0; i < _sessions.Length; i++)
            {
                var session = _sessions[i];
                var isLast = i == _sessions.Length - 1;
                var iconName = session.Instrument == "Piano" ? "piano" : "guitar";
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <div class="flex size-7 shrink-0 items-center justify-center rounded-md bg-muted">
                        <LucideIconCn Name="@iconName" Size="14" Class="size-3.5 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-1.5">
                            <span class="font-medium text-sm">@session.Instrument</span>
                            <span class="text-xs text-muted-foreground">&middot;</span>
                            <span class="text-xs text-muted-foreground">@session.Duration min</span>
                        </div>
                        <div class="mt-0.5 flex items-center gap-1">
                            @foreach (var skillTag in session.Skills)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs px-1.5 py-0">@skillTag</BadgeCn>
                            }
                        </div>
                    </div>
                    <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                        <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                        @session.Date
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-xs text-muted-foreground">
                    <LucideIconCn Name="clock" Size="12" Class="size-3" />
                    <span>@_totalSkillMinutes total minutes this week</span>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 text-xs">
                    View All
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record SkillItem(string Id, string Name, int Minutes, string IconName, string Color);
    private record SessionItem(string Id, string Date, int Duration, string Instrument, string[] Skills);

    private static readonly int _todayMinutes = 45;
    private static readonly int _weeklyGoal = 300;
    private static readonly int _weeklyTotal = 215;
    private static readonly int _currentStreak = 12;
    private static readonly int _longestStreak = 18;
    private static readonly int _weeklyProgress = (int)Math.Round((double)215 / 300 * 100);

    private static readonly SkillItem[] _skills =
    [
        new("s1", "Scales", 68, "trending-up",  "bg-blue-500"),
        new("s2", "Chords", 52, "guitar",        "bg-emerald-500"),
        new("s3", "Songs",  95, "music-2",       "bg-amber-500"),
    ];

    private static readonly int _totalSkillMinutes = 68 + 52 + 95;

    private static readonly SessionItem[] _sessions =
    [
        new("h1", "Today",     45, "Guitar", ["Chords", "Songs"]),
        new("h2", "Yesterday", 30, "Guitar", ["Scales", "Chords"]),
        new("h3", "Mar 28",    60, "Piano",  ["Scales", "Songs"]),
        new("h4", "Mar 27",    25, "Guitar", ["Songs"]),
        new("h5", "Mar 26",    55, "Piano",  ["Scales", "Chords", "Songs"]),
    ];

    private string? _selectedSkill;
}
