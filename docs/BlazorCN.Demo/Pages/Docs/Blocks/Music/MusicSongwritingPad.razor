@* ============================================================
   Block: music-songwriting-pad
   Title: MusicSongwritingPad
   Description: A songwriting workspace block for React and Next.js with verse, chorus, and bridge sections, chord suggestions, rhyme helper, syllable counter, and notes area built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-songwriting-pad.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="pen-line" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Songwriting Pad</span>
            </div>
            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                <span>@_lineCount lines</span>
                <span>&middot;</span>
                <span>@_totalSyllables syllables</span>
            </div>
        </div>

        @* Section tabs *@
        <div class="flex items-center gap-1 border-b px-4 py-2.5">
            @foreach (var sec in _sections)
            {
                var s = sec;
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                          Class="@Cn.Merge("h-7 text-xs capitalize", _activeSection == s ? "bg-muted shadow-sm" : "text-muted-foreground")"
                          OnClick="@(() => _activeSection = s)">
                    @s
                </ButtonCn>
            }
        </div>

        @* Lyrics editor *@
        <div class="border-b px-4 py-3">
            <TextareaCn Value="@_currentLyrics"
                        ValueChanged="@((string v) => SetLyrics(v))"
                        Placeholder="Start writing lyrics..."
                        Class="min-h-[120px] resize-none border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
            @* Syllable counter per line *@
            <div class="mt-2 space-y-0.5">
                @foreach (var ln in _lines)
                {
                    var line = ln;
                    <div class="flex items-center justify-between">
                        <span class="max-w-[85%] truncate text-muted-foreground text-xs">@line</span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono font-normal text-[10px]">
                            @CountLineSyllables(line) syl
                        </BadgeCn>
                    </div>
                }
            </div>
        </div>

        @* Chord suggestions *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="music-2" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Chord Suggestions</span>
            </div>
            <div class="mt-2 flex items-center gap-1.5">
                @foreach (var prog in _chordProgressions)
                {
                    var p = prog;
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-6 px-2 text-xs", _activeProgression == p.Id ? "ring-2 ring-foreground" : "")"
                              OnClick="@(() => _activeProgression = p.Id)">
                        @p.Name
                    </ButtonCn>
                }
            </div>
            @{
                var selectedProg = Array.Find(_chordProgressions, p => p.Id == _activeProgression);
            }
            @if (selectedProg != null)
            {
                <div class="mt-2 flex items-center gap-2">
                    @for (int ci = 0; ci < selectedProg.Chords.Length; ci++)
                    {
                        var chordIndex = ci;
                        var chord = selectedProg.Chords[chordIndex];
                        <div class="flex items-center gap-2">
                            <span class="rounded-md bg-muted/50 px-2.5 py-1 font-mono text-sm">@chord</span>
                            @if (chordIndex < selectedProg.Chords.Length - 1)
                            {
                                <LucideIconCn Name="chevron-right" Size="12" Class="size-3 text-muted-foreground/40" />
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* Rhyme helper *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="lightbulb" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Rhyme Helper</span>
            </div>
            <div class="mt-2 flex items-center gap-1.5">
                @foreach (var entry in _rhymes)
                {
                    var word = entry.Key;
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-6 px-2 text-xs", _activeRhyme == word ? "ring-2 ring-foreground" : "")"
                              OnClick="@(() => _activeRhyme = word)">
                        @word
                    </ButtonCn>
                }
            </div>
            <div class="mt-2 flex flex-wrap gap-1.5">
                @foreach (var rhyme in _currentRhymes)
                {
                    <span class="rounded-md bg-muted/50 px-2 py-0.5 font-mono text-xs">@rhyme</span>
                }
            </div>
        </div>

        @* Notes *@
        <div class="px-4 py-3">
            <button type="button"
                    class="flex w-full items-center gap-2 text-left transition-colors hover:bg-muted/50 rounded-md px-1 py-0.5"
                    @onclick="@(() => _notesOpen = !_notesOpen)">
                <LucideIconCn Name="sticky-note" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Notes</span>
                <LucideIconCn Name="book-open" Size="14" Class="@Cn.Merge("ml-auto size-3.5 text-muted-foreground/60 transition-transform duration-200", _notesOpen ? "rotate-90" : "")" />
            </button>
            @if (_notesOpen)
            {
                <TextareaCn Value="@_notes"
                            ValueChanged="@((string v) => _notes = v)"
                            Placeholder="Jot down ideas, references, or structure notes..."
                            Class="mt-2 min-h-[60px] resize-none border-0 bg-muted/50 text-xs shadow-none focus-visible:ring-0" />
            }
        </div>

    </div>
</section>

@code {
    private record ChordProgression(string Id, string Name, string[] Chords);

    private static readonly string[] _sections = ["verse", "chorus", "bridge"];

    private static readonly ChordProgression[] _chordProgressions =
    [
        new("pop",   "Pop",   ["C", "G", "Am", "F"]),
        new("blues", "Blues", ["E7", "A7", "B7", "E7"]),
        new("jazz",  "Jazz",  ["Cmaj7", "Dm7", "G7", "Cmaj7"]),
        new("rock",  "Rock",  ["A", "D", "E", "A"]),
    ];

    private static readonly Dictionary<string, string[]> _rhymes = new()
    {
        ["night"] = ["light", "sight", "right", "fight", "might", "bright"],
        ["heart"] = ["start", "part", "art", "chart", "smart", "apart"],
        ["day"]   = ["way", "say", "play", "stay", "ray", "away"],
        ["love"]  = ["above", "dove", "shove", "of", "thereof", "glove"],
    };

    private Dictionary<string, string> _lyrics = new()
    {
        ["verse"]  = "Walking through the city lights at night\nSearching for a feeling that feels right\nEvery shadow tells a story untold\nEvery heartbeat leaves me feeling bold",
        ["chorus"] = "We are the dreamers in the dark\nChasing every fleeting spark\nHold on tight, don't let go\nThis is all we'll ever know",
        ["bridge"] = "When the morning comes around\nWe'll be lost but finally found",
    };

    private string _activeSection = "verse";
    private string _activeProgression = "pop";
    private string _activeRhyme = "night";
    private bool _notesOpen = false;
    private string _notes = "Try a key change before the final chorus. Consider adding harmonies on the bridge.";

    private string _currentLyrics => _lyrics.TryGetValue(_activeSection, out var val) ? val : "";

    private string[] _lines => _currentLyrics
        .Split('\n')
        .Where(l => l.Trim().Length > 0)
        .ToArray();

    private int _lineCount => _lines.Length;

    private int _totalSyllables => _lines.Sum(l => CountLineSyllables(l));

    private string[] _currentRhymes =>
        _rhymes.TryGetValue(_activeRhyme, out var r) ? r : [];

    private void SetLyrics(string value)
    {
        _lyrics[_activeSection] = value;
    }

    private static int CountSyllables(string text)
    {
        var word = text.ToLower().Trim();
        if (word.Length == 0) return 0;
        var count = 0;
        var prevVowel = false;
        foreach (var ch in word)
        {
            var isVowel = "aeiouy".Contains(ch);
            if (isVowel && !prevVowel) count++;
            prevVowel = isVowel;
        }
        if (word.EndsWith('e') && count > 1) count--;
        return Math.Max(1, count);
    }

    private static int CountLineSyllables(string line)
    {
        return line.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                   .Sum(w => CountSyllables(w));
    }
}
