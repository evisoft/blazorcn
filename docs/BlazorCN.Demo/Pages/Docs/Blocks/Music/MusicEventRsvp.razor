@* ============================================================
   Block: music-event-rsvp
   Title: MusicEventRsvp
   Description: A music event RSVP block for React and Next.js with artist lineup, venue details, ticket type selector, group size picker, dynamic total price, and RSVP confirmation button built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-event-rsvp.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="ticket" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Event RSVP</span>
            </div>
            <p class="mt-1 font-medium text-sm">@_eventDetails.Name</p>
        </div>

        @* Event details *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-sm">@_eventDetails.Date</span>
                    <span class="text-muted-foreground text-xs">
                        Doors @_eventDetails.Doors &middot; Show @_eventDetails.Showtime
                    </span>
                </div>
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="map-pin" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-sm">@_eventDetails.Venue</span>
                    <span class="text-muted-foreground text-xs">@_eventDetails.City</span>
                </div>
            </div>
        </div>

        @* Artist lineup *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center gap-2">
                <LucideIconCn Name="music" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-xs">Lineup</span>
            </div>
            <div class="flex flex-wrap gap-2">
                @foreach (var artist in _lineup)
                {
                    <div class="flex items-center gap-2 rounded-md bg-muted/50 px-3 py-1.5">
                        <span class="font-medium text-sm">@artist.Name</span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                            @artist.Role
                        </BadgeCn>
                    </div>
                }
            </div>
        </div>

        @* Ticket type selector *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Ticket Type</span>
            <div class="mt-2 flex gap-2">
                @foreach (var t in _ticketTiers)
                {
                    var tier = t;
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-8 flex-1 text-xs", _selectedTier == tier.Id ? "ring-2 ring-foreground" : "")"
                              OnClick="@(() => _selectedTier = tier.Id)">
                        @tier.Name &middot; $@tier.Price
                    </ButtonCn>
                }
            </div>
            <div class="mt-2.5 space-y-1">
                @foreach (var perk in SelectedTier.Perks)
                {
                    <div class="flex items-center gap-2">
                        <span class="flex size-4 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                            <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                        </span>
                        <span class="text-muted-foreground text-xs">@perk</span>
                    </div>
                }
            </div>
        </div>

        @* Group size *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Group Size</span>
            </div>
            <div class="flex items-center gap-3">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-7 p-0"
                          OnClick="@(() => _groupSize = Math.Max(1, _groupSize - 1))"
                          aria-label="Remove guest">
                    <LucideIconCn Name="minus" Size="12" Class="size-3" />
                </ButtonCn>
                <span class="w-8 text-center font-semibold text-sm tabular-nums">@_groupSize</span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-7 p-0"
                          OnClick="@(() => _groupSize = Math.Min(10, _groupSize + 1))"
                          aria-label="Add guest">
                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

        @* Price summary *@
        <div class="border-b px-4 py-3">
            <div class="space-y-1.5">
                <div class="flex items-center justify-between text-sm">
                    <span class="text-muted-foreground">@SelectedTier.Name x @_groupSize</span>
                    <span class="tabular-nums">$@TotalPrice</span>
                </div>
                <div class="flex items-center justify-between text-sm">
                    <span class="text-muted-foreground">Service fee</span>
                    <span class="tabular-nums">$@ServiceFee</span>
                </div>
                <div class="flex items-center justify-between border-t pt-1.5">
                    <span class="font-medium text-sm">Total</span>
                    <span class="font-semibold text-lg tabular-nums">$@GrandTotal</span>
                </div>
            </div>
        </div>

        @* RSVP action *@
        <div class="px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs"
                      OnClick="@(() => _confirmed = true)"
                      Disabled="@_confirmed">
                @if (_confirmed)
                {
                    <LucideIconCn Name="check" Size="12" Class="mr-1.5 size-3" />
                    <span>RSVP Confirmed</span>
                }
                else
                {
                    <LucideIconCn Name="ticket" Size="12" Class="mr-1.5 size-3" />
                    <span>Confirm RSVP &middot; $@GrandTotal</span>
                }
            </ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                Free cancellation up to 48 hours before the event
            </p>
        </div>

    </div>
</section>

@code {
    private record EventInfo(string Name, string Artist, string Venue, string City, string Date, string Doors, string Showtime);
    private record LineupArtist(string Name, string Role);
    private record TicketTier(string Id, string Name, int Price, string[] Perks);

    private static readonly EventInfo _eventDetails = new(
        Name:     "Neon Architectures World Tour",
        Artist:   "Neon Waves",
        Venue:    "The Beacon Theatre",
        City:     "New York, NY",
        Date:     "Saturday, June 14, 2026",
        Doors:    "7:00 PM",
        Showtime: "8:30 PM"
    );

    private static readonly LineupArtist[] _lineup =
    [
        new("Neon Waves",  "Headliner"),
        new("Glass Tide",  "Support"),
        new("Velvet Haze", "Opener"),
    ];

    private static readonly TicketTier[] _ticketTiers =
    [
        new("ga",        "General",   65,  ["Standing room access", "Shared viewing area"]),
        new("vip",       "VIP",       120, ["Reserved seating", "VIP lounge access", "Complimentary drink"]),
        new("backstage", "Backstage", 250, ["Backstage meet & greet", "Front row reserved", "Exclusive merchandise", "VIP lounge access"]),
    ];

    private string _selectedTier = "vip";
    private int _groupSize = 2;
    private bool _confirmed = false;

    private TicketTier SelectedTier =>
        Array.Find(_ticketTiers, t => t.Id == _selectedTier) ?? _ticketTiers[1];

    private int TotalPrice => SelectedTier.Price * _groupSize;
    private int ServiceFee => (int)Math.Round(TotalPrice * 0.08);
    private int GrandTotal => TotalPrice + ServiceFee;
}
