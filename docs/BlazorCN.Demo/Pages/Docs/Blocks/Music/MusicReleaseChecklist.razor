@* ============================================================
   Block: music-release-checklist
   Title: MusicReleaseChecklist
   Description: A music release preparation checklist block for React and Next.js with task items for mastering audio uploading artwork writing descriptions setting release dates submitting to stores and sharing pre-save links with check and uncheck and progress summary built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-release-checklist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="clipboard-list" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Release Checklist</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">Neon Horizons — Single Release</p>
        </div>

        @* Progress summary *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="@Cn.Merge("font-semibold text-2xl tabular-nums", _allComplete ? "text-emerald-600 dark:text-emerald-400" : "text-foreground")">
                        @_completedCount
                    </span>
                    <span class="text-muted-foreground text-xs">of @_tasks.Length tasks complete</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("font-normal text-xs", _allComplete ? "text-emerald-600 dark:text-emerald-400" : "")">
                    @(_allComplete ? "Ready to release" : $"{_progressPercent}%")
                </BadgeCn>
            </div>
            <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="@Cn.Merge("h-full rounded-full", _allComplete ? "bg-emerald-500" : "bg-foreground")"
                     style="@($"width:{_progressPercent}%")">
                </div>
            </div>
            <div class="mt-2 flex items-center gap-3">
                @foreach (var cat in _categories)
                {
                    var catTasks = _tasks.Where(t => t.Category == cat.Id).ToArray();
                    var catDone = catTasks.Count(t => t.Checked);
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@($"size-1.5 rounded-full {cat.Color}")"></span>
                        @cat.Label @catDone/@catTasks.Length
                    </span>
                }
            </div>
        </div>

        @* Task list *@
        <div>
            @for (int i = 0; i < _tasks.Length; i++)
            {
                var task = _tasks[i];
                var isLast = i == _tasks.Length - 1;
                var taskId = task.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <label class="flex cursor-pointer items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <CheckboxCn Checked="@task.Checked" CheckedChanged="@((bool v) => ToggleTask(taskId))" aria-label="@task.Label" Class="mt-0.5" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@($"size-1.5 shrink-0 rounded-full {GetCategoryColor(task.Category)}")"></span>
                                <span class="@Cn.Merge("font-medium text-sm", task.Checked ? "text-muted-foreground line-through" : "")">
                                    @task.Label
                                </span>
                                @if (task.Checked)
                                {
                                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500" />
                                }
                            </div>
                            <p class="@Cn.Merge("mt-0.5 pl-3.5 text-xs leading-relaxed", task.Checked ? "text-muted-foreground/60" : "text-muted-foreground")">
                                @task.Description
                            </p>
                        </div>
                    </label>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Complete all tasks before submitting for distribution
            </p>
        </div>

    </div>
</section>

@code {
    private record TaskItem(string Id, string Label, string Description, string Category, bool Checked, string IconName);
    private record CategoryItem(string Id, string Label, string Color);

    private static readonly CategoryItem[] _categories =
    [
        new("audio",        "Audio",        "bg-blue-500"),
        new("visual",       "Visual",       "bg-purple-500"),
        new("content",      "Content",      "bg-amber-500"),
        new("distribution", "Distribution", "bg-emerald-500"),
    ];

    private TaskItem[] _tasks =
    [
        new("master-audio",    "Master audio",        "Finalize the stereo master at -14 LUFS integrated loudness. Export as 24-bit WAV at 44.1 kHz.",                                                                                   "audio",        true,  "file-audio"),
        new("upload-artwork",  "Upload artwork",      "Prepare cover art at 3000x3000px, RGB color, JPG or PNG format. No bleed, no explicit logos unless flagged.",                                                                        "visual",       true,  "image"),
        new("write-description","Write description",  "Draft release notes, credits, and songwriter splits. Include ISRC codes if already assigned.",                                                                                     "content",      false, "pen-line"),
        new("set-release-date","Set release date",    "Choose a Friday release date at least 4 weeks out. Allows time for editorial playlist consideration.",                                                                              "distribution", false, "calendar"),
        new("submit-to-stores","Submit to stores",    "Distribute to Spotify, Apple Music, Amazon Music, YouTube Music, Tidal, and Deezer via your distributor.",                                                                          "distribution", false, "store"),
        new("share-presave",   "Share pre-save link", "Generate a pre-save link and share across social media, email list, and artist website at least 2 weeks before release.",                                                           "distribution", false, "share-2"),
    ];

    private int _completedCount => _tasks.Count(t => t.Checked);
    private int _progressPercent => (int)Math.Round((double)_completedCount / _tasks.Length * 100);
    private bool _allComplete => _completedCount == _tasks.Length;

    private void ToggleTask(string taskId)
    {
        _tasks = _tasks.Select(t => t.Id == taskId ? t with { Checked = !t.Checked } : t).ToArray();
    }

    private string GetCategoryColor(string category)
    {
        return category switch
        {
            "audio"        => "bg-blue-500",
            "visual"       => "bg-purple-500",
            "content"      => "bg-amber-500",
            "distribution" => "bg-emerald-500",
            _              => "bg-muted",
        };
    }
}
