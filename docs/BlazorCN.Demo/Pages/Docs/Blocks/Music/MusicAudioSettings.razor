@* ============================================================
   Block: music-audio-settings
   Title: MusicAudioSettings
   Description: An audio settings panel block for React and Next.js with bass, mid, and treble sliders, balance control, spatial audio toggle, loudness normalization, crossfade duration, and output device selector built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-audio-settings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="settings" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Audio Settings</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="HandleReset">
                <LucideIconCn Name="rotate-ccw" Size="12" Class="size-3" />
                Reset
            </ButtonCn>
        </div>

        @* Equalizer *@
        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center gap-2">
                <LucideIconCn Name="volume-2" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Equalizer</span>
            </div>

            <div class="space-y-4">
                @* Bass *@
                <div class="flex items-center gap-3">
                    <span class="w-12 font-medium text-xs">Bass</span>
                    <SliderCn aria-label="Bass" Value="@((double)_bass)"
                              ValueChanged="@((double v) => { _bass = (int)v; })"
                              Min="0"
                              Max="100"
                              Step="1"
                              Class="flex-1" />
                    <span class="w-8 text-right font-mono text-muted-foreground text-xs tabular-nums">
                        @_bass
                    </span>
                </div>

                @* Mid *@
                <div class="flex items-center gap-3">
                    <span class="w-12 font-medium text-xs">Mid</span>
                    <SliderCn aria-label="Mid" Value="@((double)_mid)"
                              ValueChanged="@((double v) => { _mid = (int)v; })"
                              Min="0"
                              Max="100"
                              Step="1"
                              Class="flex-1" />
                    <span class="w-8 text-right font-mono text-muted-foreground text-xs tabular-nums">
                        @_mid
                    </span>
                </div>

                @* Treble *@
                <div class="flex items-center gap-3">
                    <span class="w-12 font-medium text-xs">Treble</span>
                    <SliderCn aria-label="Treble" Value="@((double)_treble)"
                              ValueChanged="@((double v) => { _treble = (int)v; })"
                              Min="0"
                              Max="100"
                              Step="1"
                              Class="flex-1" />
                    <span class="w-8 text-right font-mono text-muted-foreground text-xs tabular-nums">
                        @_treble
                    </span>
                </div>
            </div>
        </div>

        @* Balance *@
        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="speaker" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-muted-foreground text-xs">Balance</span>
                </div>
                <span class="font-mono text-muted-foreground text-xs tabular-nums">
                    @BalanceLabel
                </span>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-muted-foreground text-xs">L</span>
                <SliderCn aria-label="Balance" Value="@((double)_balance)"
                          ValueChanged="@((double v) => { _balance = (int)v; })"
                          Min="0"
                          Max="100"
                          Step="1"
                          Class="flex-1" />
                <span class="text-muted-foreground text-xs">R</span>
            </div>
        </div>

        @* Toggles *@
        <div class="border-b px-4 py-3">
            <div class="space-y-3">
                @* Spatial Audio *@
                <div class="flex items-center justify-between">
                    <div>
                        <span class="font-medium text-sm">Spatial Audio</span>
                        <p class="text-muted-foreground text-xs">
                            Immersive 3D sound experience with head tracking
                        </p>
                    </div>
                    <SwitchCn Checked="@_spatialAudio" CheckedChanged="@((bool v) => { _spatialAudio = v; })" aria-label="Spatial Audio" />
                </div>

                @* Loudness Normalization *@
                <div class="flex items-center justify-between">
                    <div>
                        <span class="font-medium text-sm">Loudness Normalization</span>
                        <p class="text-muted-foreground text-xs">
                            Consistent volume level across all tracks
                        </p>
                    </div>
                    <SwitchCn Checked="@_loudnessNorm" CheckedChanged="@((bool v) => { _loudnessNorm = v; })" aria-label="Loudness Normalization" />
                </div>
            </div>
        </div>

        @* Crossfade *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Crossfade</span>
                <p class="text-muted-foreground text-xs">Smooth transition between tracks</p>
            </div>
            <div class="flex items-center gap-1 rounded-md bg-muted/50 p-0.5">
                @foreach (var opt in _crossfadeOptions)
                {
                    var option = opt;
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-6 px-2 text-xs", _crossfade == option.Value ? "bg-background shadow-sm" : "text-muted-foreground")"
                              OnClick="@(() => _crossfade = option.Value)">
                        @option.Label
                    </ButtonCn>
                }
            </div>
        </div>

        @* Output Device *@
        <div class="flex items-center justify-between px-4 py-3">
            <div>
                <span class="font-medium text-sm">Output Device</span>
                <p class="text-muted-foreground text-xs">Select audio output destination</p>
            </div>
            <SelectCn Value="@_outputDevice" ValueChanged="@((string? v) => SetOutputDevice(v))">
                <SelectTriggerCn aria-label="Output device" Class="h-7 w-[180px] text-xs">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var dev in _outputDevices)
                    {
                        var device = dev;
                        <SelectItemCn Value="@device.Value" Class="text-xs">@device.Label</SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
        </div>

    </div>
</section>

@code {
    private record CrossfadeOption(string Value, string Label);
    private record OutputDevice(string Value, string Label);

    private static readonly CrossfadeOption[] _crossfadeOptions =
    [
        new("0",  "Off"),
        new("2",  "2s"),
        new("4",  "4s"),
        new("6",  "6s"),
        new("8",  "8s"),
        new("12", "12s"),
    ];

    private static readonly OutputDevice[] _outputDevices =
    [
        new("speakers",   "Built-in Speakers"),
        new("headphones", "AirPods Pro"),
        new("bluetooth",  "Sony WH-1000XM5"),
        new("external",   "Scarlett 2i2 USB"),
    ];

    private int _bass = 65;
    private int _mid = 50;
    private int _treble = 55;
    private int _balance = 50;
    private bool _spatialAudio = true;
    private bool _loudnessNorm = true;
    private string _crossfade = "4";
    private string _outputDevice = "headphones";

    private string BalanceLabel =>
        _balance == 50 ? "Center" : _balance < 50 ? $"L {50 - _balance}" : $"R {_balance - 50}";

    private void SetOutputDevice(string? v)
    {
        if (v is not null) _outputDevice = v;
    }

    private void HandleReset()
    {
        _bass = 50;
        _mid = 50;
        _treble = 50;
        _balance = 50;
        _spatialAudio = false;
        _loudnessNorm = true;
        _crossfade = "0";
        _outputDevice = "speakers";
    }
}
