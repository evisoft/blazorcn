@* ============================================================
   Block: music-music-theory
   Title: MusicMusicTheory
   Description: A music theory reference block for React and Next.js with scale display, interval names, chord construction, simplified circle of fifths, and key selector built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-music-theory.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header with key selector *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="music" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Music Theory</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @CurrentScale.Type
            </BadgeCn>
        </div>

        @* Scale selector *@
        <div class="flex flex-wrap items-center gap-1 border-b px-4 py-3">
            @foreach (var sk in _scaleKeys)
            {
                var scaleKey = sk;
                <ButtonCn Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.Sm"
                          Class="@Cn.Merge("h-7 text-xs", _selectedScale == scaleKey ? "bg-muted shadow-sm" : "text-muted-foreground")"
                          OnClick="@(() => _selectedScale = scaleKey)">
                    @_scaleData[scaleKey].Name
                </ButtonCn>
            }
        </div>

        @* Scale notes display *@
        <div class="border-b px-4 py-4">
            <span class="mb-3 block font-medium text-muted-foreground text-xs">Scale Notes</span>
            <div class="flex flex-wrap items-center gap-2">
                @for (int i = 0; i < CurrentScale.Notes.Length; i++)
                {
                    var note = CurrentScale.Notes[i];
                    var interval = CurrentScale.Intervals[i];
                    var isFirst = i == 0;
                    <div class="flex flex-col items-center gap-1">
                        <div class="@Cn.Merge("flex size-10 items-center justify-center rounded-md border", isFirst ? "border-foreground/30 bg-foreground/5" : "bg-muted/50")">
                            <span class="font-medium text-sm">@note</span>
                        </div>
                        <span class="font-mono text-muted-foreground text-xs">@interval</span>
                    </div>
                }
            </div>
        </div>

        @* Chord construction *@
        <div class="border-b px-4 py-4">
            <span class="mb-3 block font-medium text-muted-foreground text-xs">
                Diatonic Chords in @CurrentScale.Key
            </span>
            <div class="space-y-1">
                @foreach (var ch in CurrentChords)
                {
                    var chord = ch;
                    <div class="flex items-center gap-3 rounded-md px-2 py-1.5 transition-colors hover:bg-muted/50">
                        <span class="w-14 font-medium text-sm">@chord.Symbol</span>
                        <span class="flex-1 font-mono text-muted-foreground text-xs">@chord.Notes</span>
                        <span class="@ChordQualityClass(chord.Quality) text-xs">@chord.Quality</span>
                    </div>
                }
            </div>
        </div>

        @* Circle of fifths simplified *@
        <div class="px-4 py-4">
            <span class="mb-3 block font-medium text-muted-foreground text-xs">
                Circle of Fifths
            </span>
            <div class="flex flex-wrap items-center gap-1.5">
                @foreach (var cfKey in _circleOfFifths)
                {
                    var cof = cfKey;
                    var isCurrentKey = cof == CurrentScale.Key;
                    <div class="@Cn.Merge("flex h-8 items-center justify-center rounded-md border px-2.5", isCurrentKey ? "border-foreground/30 bg-foreground/5" : "bg-muted/30")">
                        <span class="@Cn.Merge("font-mono text-xs", isCurrentKey ? "font-medium" : "text-muted-foreground")">@cof</span>
                    </div>
                }
            </div>
            <p class="mt-3 text-muted-foreground text-xs">
                Each step clockwise moves up a perfect fifth &middot; Adjacent keys share 6 of 7 notes
            </p>
        </div>

    </div>
</section>

@code {
    private record ScaleInfo(string Name, string Key, string[] Notes, string[] Intervals, string Type);
    private record ChordInfo(string Name, string Symbol, string Notes, string Quality);

    private static readonly Dictionary<string, ScaleInfo> _scaleData = new()
    {
        ["c-major"]      = new("C Major",            "C", ["C","D","E","F","G","A","B"],        ["1","2","3","4","5","6","7"],       "Major"),
        ["a-minor"]      = new("A Natural Minor",     "A", ["A","B","C","D","E","F","G"],        ["1","2","b3","4","5","b6","b7"],    "Minor"),
        ["g-major"]      = new("G Major",             "G", ["G","A","B","C","D","E","F#"],       ["1","2","3","4","5","6","7"],       "Major"),
        ["am-pentatonic"] = new("A Minor Pentatonic", "A", ["A","C","D","E","G"],                ["1","b3","4","5","b7"],             "Pentatonic"),
        ["c-blues"]      = new("C Blues",             "C", ["C","Eb","F","Gb","G","Bb"],         ["1","b3","4","b5","5","b7"],        "Blues"),
    };

    private static readonly Dictionary<string, ChordInfo[]> _chordsByKey = new()
    {
        ["C"] =
        [
            new("C Major",      "C",     "C E G",   "Major"),
            new("D Minor",      "Dm",    "D F A",   "Minor"),
            new("E Minor",      "Em",    "E G B",   "Minor"),
            new("F Major",      "F",     "F A C",   "Major"),
            new("G Major",      "G",     "G B D",   "Major"),
            new("A Minor",      "Am",    "A C E",   "Minor"),
            new("B Diminished", "Bdim",  "B D F",   "Dim"),
        ],
        ["A"] =
        [
            new("A Minor",      "Am",    "A C E",   "Minor"),
            new("B Diminished", "Bdim",  "B D F",   "Dim"),
            new("C Major",      "C",     "C E G",   "Major"),
            new("D Minor",      "Dm",    "D F A",   "Minor"),
            new("E Minor",      "Em",    "E G B",   "Minor"),
            new("F Major",      "F",     "F A C",   "Major"),
            new("G Major",      "G",     "G B D",   "Major"),
        ],
        ["G"] =
        [
            new("G Major",       "G",     "G B D",   "Major"),
            new("A Minor",       "Am",    "A C E",   "Minor"),
            new("B Minor",       "Bm",    "B D F#",  "Minor"),
            new("C Major",       "C",     "C E G",   "Major"),
            new("D Major",       "D",     "D F# A",  "Major"),
            new("E Minor",       "Em",    "E G B",   "Minor"),
            new("F# Diminished", "F#dim", "F# A C",  "Dim"),
        ],
    };

    private static readonly string[] _circleOfFifths = ["C","G","D","A","E","B","F#/Gb","Db","Ab","Eb","Bb","F"];
    private static readonly string[] _scaleKeys = ["c-major","a-minor","g-major","am-pentatonic","c-blues"];

    private string _selectedScale = "c-major";

    private ScaleInfo CurrentScale => _scaleData[_selectedScale];

    private ChordInfo[] CurrentChords =>
        _chordsByKey.TryGetValue(CurrentScale.Key, out var chords) ? chords : _chordsByKey["C"];

    private static string ChordQualityClass(string quality) => quality switch
    {
        "Major" => "text-emerald-600 dark:text-emerald-400",
        "Minor" => "text-blue-600 dark:text-blue-400",
        _       => "text-amber-600 dark:text-amber-400",
    };
}
