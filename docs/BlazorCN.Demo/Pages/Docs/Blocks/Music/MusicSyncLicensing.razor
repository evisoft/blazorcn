@* ============================================================
   Block: music-sync-licensing
   Title: MusicSyncLicensing
   Description: A sync licensing marketplace block for React and Next.js with track listings, usage type filters, license pricing, exclusivity options, and request licensing button built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-sync-licensing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="music" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Sync Licensing</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Browse tracks available for licensing across film, TV, commercial, and game placements.
            </p>
        </div>

        @* Filters *@
        <div class="border-b px-4 py-3">
            <div class="flex flex-wrap items-center gap-1.5">
                @foreach (var filter in _usageFilters)
                {
                    var f = filter;
                    <button type="button"
                            @onclick="@(() => _activeFilter = f.Value)"
                            class="@Cn.Merge("flex h-7 items-center gap-1.5 rounded-md px-2.5 font-medium text-xs transition-all", _activeFilter == f.Value ? "bg-foreground text-background" : "bg-muted/50 text-muted-foreground hover:bg-muted hover:text-foreground")">
                        <LucideIconCn Name="@f.Icon" Size="12" Class="size-3" />
                        @f.Label
                    </button>
                }
            </div>
            <p class="mt-2 text-muted-foreground text-xs">
                @FilteredTracks.Length track@(FilteredTracks.Length != 1 ? "s" : "") available
            </p>
        </div>

        @* Track list *@
        <div>
            @{
                var filtered = FilteredTracks;
            }
            @foreach (var track in filtered)
            {
                var t = track;
                var isLast = t.Id == filtered[filtered.Length - 1].Id;
                var isExpanded = _expandedTrack == t.Id;
                <div class="@(!isLast ? "border-b" : "")">
                    <button type="button"
                            @onclick="@(() => _expandedTrack = (_expandedTrack == t.Id ? null : t.Id))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">

                        @* Play icon *@
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="play" Size="14" Class="size-3.5 text-muted-foreground" />
                        </div>

                        @* Track info *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@t.Title</span>
                                @if (t.LicenseType == "Exclusive")
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                        Exclusive
                                    </BadgeCn>
                                }
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span>@t.Artist</span>
                                <span>&middot;</span>
                                <span>@t.Genre</span>
                                <span>&middot;</span>
                                <span class="tabular-nums">@t.Duration</span>
                            </div>
                        </div>

                        @* Price *@
                        <div class="shrink-0 text-right">
                            <p class="font-semibold text-sm tabular-nums">$@t.PricePerUse.ToString("N0")</p>
                            <p class="text-muted-foreground text-xs">per use</p>
                        </div>

                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @* Expanded details *@
                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/20 px-4 py-3">
                            <div class="flex flex-wrap items-center gap-4">
                                <div>
                                    <p class="font-medium text-muted-foreground text-xs">BPM</p>
                                    <p class="mt-0.5 font-mono text-xs tabular-nums">@t.Bpm</p>
                                </div>
                                <div>
                                    <p class="font-medium text-muted-foreground text-xs">License</p>
                                    <p class="mt-0.5 text-xs">@t.LicenseType</p>
                                </div>
                                <div>
                                    <p class="font-medium text-muted-foreground text-xs">Available For</p>
                                    <div class="mt-0.5 flex items-center gap-1">
                                        @foreach (var usage in t.UsageTypes)
                                        {
                                            var u = usage;
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                                @GetUsageLabel(u)
                                            </BadgeCn>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="mt-3">
                                <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                                    Request License
                                </ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                All licenses include master and sync rights &middot; Custom quotes available for exclusives
            </p>
        </div>

    </div>
</section>

@code {
    private record UsageFilter(string Value, string Label, string Icon);
    private record Track(string Id, string Title, string Artist, string Genre, string Duration, int Bpm, string[] UsageTypes, string LicenseType, int PricePerUse);

    private static readonly UsageFilter[] _usageFilters =
    [
        new("all",        "All",        "filter"),
        new("film",       "Film",       "film"),
        new("tv",         "TV",         "tv"),
        new("commercial", "Commercial", "megaphone"),
        new("game",       "Game",       "gamepad-2"),
    ];

    private static readonly Track[] _tracks =
    [
        new("1", "Urban Ascent",   "Kael Voss",    "Electronic", "3:22", 128, ["film", "commercial"], "Non-Exclusive", 850),
        new("2", "Golden Hour",    "Luna Rae",      "Ambient",    "4:15",  90, ["film", "tv"],         "Non-Exclusive", 1200),
        new("3", "Velocity",       "The Drift",     "Rock",       "2:48", 145, ["game", "commercial"], "Exclusive",     3500),
        new("4", "Quiet Storm",    "Echo Park",     "Jazz",       "5:02",  72, ["film", "tv"],         "Non-Exclusive", 950),
        new("5", "Pixel Dreams",   "Nox Meridian",  "Synthwave",  "3:38", 118, ["game", "tv", "commercial"], "Non-Exclusive", 750),
        new("6", "Iron Cathedral", "Basalt",        "Orchestral", "6:12",  95, ["film"],               "Exclusive",     5200),
    ];

    private static readonly System.Collections.Generic.Dictionary<string, string> _usageLabels = new()
    {
        ["film"]       = "Film",
        ["tv"]         = "TV",
        ["commercial"] = "Commercial",
        ["game"]       = "Game",
    };

    private string _activeFilter = "all";
    private string? _expandedTrack = null;

    private Track[] FilteredTracks =>
        _activeFilter == "all"
            ? _tracks
            : _tracks.Where(t => t.UsageTypes.Contains(_activeFilter)).ToArray();

    private string GetUsageLabel(string usage) =>
        _usageLabels.TryGetValue(usage, out var label) ? label : usage;
}
