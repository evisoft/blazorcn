@* ============================================================
   Block: music-listen-together
   Title: MusicListenTogether
   Description: A social listening room block for React and Next.js with host display, listener avatars, now playing track, real-time emoji reactions, chat messages, and join/leave controls built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-listen-together.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="headphones" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Listen Together</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <span class="mr-1 size-1.5 rounded-full bg-emerald-500"></span>
                        Live
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">@_listeners.Length listening</span>
            </div>
        </div>

        @* Listeners *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center gap-1.5">
                <span class="font-medium text-muted-foreground text-xs">Host:</span>
                <span class="text-xs">@_host.Name</span>
            </div>
            <div class="flex items-center gap-2">
                @foreach (var listener in _listeners)
                {
                    var l = listener;
                    <div class="relative">
                        <AvatarCn Class="size-8">
                            <AvatarFallbackCn Class="@Cn.Merge(l.Color, "text-white text-xs")">
                                @l.Initials
                            </AvatarFallbackCn>
                        </AvatarCn>
                        <span class="absolute -right-0.5 -bottom-0.5 size-2.5 rounded-full border-2 border-card bg-emerald-500"></span>
                        @if (l.IsHost)
                        {
                            <span class="absolute -top-1 -right-1 flex size-3.5 items-center justify-center rounded-full bg-amber-500 text-white text-xs">
                                <LucideIconCn Name="music" Size="8" Class="size-2" />
                            </span>
                        }
                    </div>
                }
            </div>
        </div>

        @* Now playing *@
        <div class="relative border-b px-4 py-3">

            @* Floating reactions *@
            <div class="pointer-events-none absolute top-0 right-4 bottom-0 z-10 w-12">
                @foreach (var reaction in _reactions)
                {
                    <div class="absolute right-0 bottom-0 text-muted-foreground">
                        <LucideIconCn Name="@ReactionIconName(reaction.Emoji)" Size="16" Class="size-4" />
                    </div>
                }
            </div>

            <div class="flex items-center gap-3">
                <div class="flex size-12 shrink-0 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="music" Size="20" Class="size-5 text-muted-foreground" />
                </div>
                <div class="min-w-0 flex-1">
                    <span class="block truncate font-medium text-sm">@_nowPlaying.Title</span>
                    <span class="block truncate text-muted-foreground text-xs">
                        @_nowPlaying.Artist &middot; @_nowPlaying.Album
                    </span>
                    <div class="mt-1.5 flex items-center gap-2">
                        <span class="font-mono text-muted-foreground text-xs tabular-nums">
                            @_nowPlaying.Elapsed
                        </span>
                        <div class="h-1 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground" style="@($"width:{_nowPlaying.Progress}%")"></div>
                        </div>
                        <span class="font-mono text-muted-foreground text-xs tabular-nums">
                            @_nowPlaying.Total
                        </span>
                    </div>
                </div>
            </div>

            @* Reaction buttons *@
            <div class="mt-2.5 flex items-center gap-1.5">
                @foreach (var re in _reactionEmojis)
                {
                    var label = re.Label;
                    var iconName = re.IconName;
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                              Class="h-7 gap-1 px-2 text-xs"
                              OnClick="@(() => HandleReaction(label))"
                              aria-label="@($"React with {label}")">
                        <LucideIconCn Name="@iconName" Size="12" Class="size-3" />
                        @label
                    </ButtonCn>
                }
            </div>
        </div>

        @* Chat messages *@
        <div class="border-b">
            <div class="flex items-center gap-1.5 px-4 pt-3 pb-1.5">
                <LucideIconCn Name="message-circle" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Chat</span>
            </div>
            <div class="max-h-40 overflow-y-auto">
                @foreach (var msg in _messages)
                {
                    <div class="px-4 py-1.5">
                        <div class="flex items-baseline gap-1.5">
                            <span class="shrink-0 font-medium text-xs">@msg.Name</span>
                            <span class="min-w-0 text-muted-foreground text-xs">@msg.Text</span>
                            <span class="ml-auto shrink-0 text-muted-foreground/60 text-xs">
                                @msg.Timestamp
                            </span>
                        </div>
                    </div>
                }
            </div>

            @* Message input *@
            <div class="flex items-center gap-2 px-4 py-2.5">
                <InputCn @bind-Value="_messageInput"
                         Placeholder="Say something..."
                         Class="h-7 border-0 bg-transparent px-0 text-xs shadow-none focus-visible:ring-0" />
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                          Class="h-6 shrink-0 px-2"
                          OnClick="HandleSendMessage"
                          aria-label="Send message">
                    <LucideIconCn Name="send" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

        @* Join/Leave footer *@
        <div class="px-4 py-2.5">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-xs">
                    @(_joined ? "You are in the room" : "You left the room")
                </span>
                <ButtonCn Variant="@(_joined ? ButtonVariant.Outline : ButtonVariant.Default)"
                          Size="ButtonSize.Sm"
                          Class="h-7 gap-1.5 text-xs"
                          OnClick="@(() => _joined = !_joined)">
                    @if (_joined)
                    {
                        <LucideIconCn Name="log-out" Size="12" Class="size-3" />
                        <span>Leave</span>
                    }
                    else
                    {
                        <LucideIconCn Name="headphones" Size="12" Class="size-3" />
                        <span>Join</span>
                    }
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record Listener(string Id, string Name, string Initials, bool IsHost, string Color);
    private record ChatMessage(string Id, string UserId, string Name, string Text, string Timestamp);
    private record Reaction(string Id, string Emoji, string UserId);
    private record NowPlayingInfo(string Title, string Artist, string Album, string Elapsed, string Total, int Progress);
    private record ReactionEmoji(string IconName, string Label);

    private static readonly Listener _host = new("u1", "Maya Chen", "MC", true, "bg-violet-500");

    private static readonly Listener[] _listeners =
    [
        new("u1", "Maya Chen",   "MC", true,  "bg-violet-500"),
        new("u2", "Jake Torres", "JT", false, "bg-cyan-500"),
        new("u3", "Priya Sharma","PS", false, "bg-rose-500"),
        new("u4", "Leo Kim",     "LK", false, "bg-amber-500"),
        new("u5", "Nia Brooks",  "NB", false, "bg-emerald-500"),
    ];

    private static readonly NowPlayingInfo _nowPlaying = new(
        "Midnight Frequencies", "Lunar Drift", "Neon Horizons", "2:34", "4:12", 60);

    private static readonly ChatMessage[] _initialMessages =
    [
        new("m1", "u2", "Jake",  "This track is incredible",   "2 min ago"),
        new("m2", "u3", "Priya", "Love the synth on this one", "1 min ago"),
        new("m3", "u1", "Maya",  "Wait for the drop at 3:20",  "45s ago"),
        new("m4", "u4", "Leo",   "Adding this to my library",  "30s ago"),
        new("m5", "u5", "Nia",   "Can we queue Starfall next?","Just now"),
    ];

    private static readonly ReactionEmoji[] _reactionEmojis =
    [
        new("heart",      "Love"),
        new("thumbs-up",  "Like"),
        new("zap",        "Fire"),
        new("smile",      "Smile"),
    ];

    private List<ChatMessage> _messages = new(_initialMessages);
    private List<Reaction> _reactions = [];
    private string _messageInput = "";
    private bool _joined = true;
    private int _reactionCounter = 0;

    private void HandleSendMessage()
    {
        var trimmed = _messageInput.Trim();
        if (string.IsNullOrEmpty(trimmed)) return;
        var newMsg = new ChatMessage(
            $"m{_messages.Count + 1}",
            "u1",
            "You",
            trimmed,
            "Just now");
        _messages.Add(newMsg);
        _messageInput = "";
    }

    private void HandleReaction(string emoji)
    {
        var id = $"r{_reactionCounter}";
        _reactionCounter++;
        _reactions.Add(new Reaction(id, emoji, "u1"));
    }

    private static string ReactionIconName(string emoji) => emoji switch
    {
        "Love"  => "heart",
        "Like"  => "thumbs-up",
        "Fire"  => "zap",
        "Smile" => "smile",
        _       => "smile",
    };
}
