@* ============================================================
   Block: music-album-review
   Title: MusicAlbumReview
   Description: A music album review card block for React and Next.js with star ratings, track-by-track scores, reviewer info, and helpful vote buttons built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-album-review.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Album info *@
        <div class="flex items-start gap-4 border-b px-4 py-3">
            <div class="flex size-16 shrink-0 items-center justify-center rounded-md bg-muted">
                <LucideIconCn Name="disc" Size="32" Class="size-8 text-muted-foreground/60" />
            </div>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">@_album.Title</span>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    @_album.Artist &middot; @_album.Year
                </p>
                <div class="mt-1.5 flex items-center gap-2">
                    <div class="flex items-center gap-0.5">
                        @foreach (var star in RenderStars(_album.Rating))
                        {
                            <LucideIconCn Name="star" Size="14" Class="@star" />
                        }
                    </div>
                    <span class="font-semibold text-sm tabular-nums">@_album.Rating</span>
                    <span class="text-xs text-muted-foreground">(@(_album.TotalRatings) ratings)</span>
                </div>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">@_album.Genre</BadgeCn>
        </div>

        @* Review text *@
        <div class="border-b px-4 py-3">
            <p class="text-sm leading-relaxed text-muted-foreground">
                @_reviewText
            </p>
        </div>

        @* Reviewer *@
        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                @_reviewer.Avatar
            </div>
            <div class="flex items-center gap-1.5 text-xs">
                <span class="font-medium">@_reviewer.Name</span>
                <span class="text-muted-foreground">&middot;</span>
                <span class="text-muted-foreground">@_reviewer.Publication</span>
                <span class="text-muted-foreground">&middot;</span>
                <span class="text-muted-foreground">@_reviewer.Date</span>
            </div>
        </div>

        @* Track ratings header *@
        <div class="border-b px-4 py-2.5">
            <span class="text-xs font-medium text-muted-foreground">Track Ratings</span>
        </div>

        @* Track list *@
        <div>
            @foreach (var (track, index) in _tracks.Select((t, i) => (t, i)))
            {
                var isExpanded = _expandedTrack == track.Id;
                var isLast = index == _tracks.Length - 1;
                var trackItem = track;
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => ToggleTrack(trackItem.Id))"
                        class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                        <span class="w-5 text-right font-mono text-xs text-muted-foreground">@track.Number</span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-1.5">
                                <span class="truncate text-sm font-medium">@track.Title</span>
                                @if (track.Highlight)
                                {
                                    <LucideIconCn Name="star" Size="12" Class="size-3 shrink-0 fill-amber-400 text-amber-400" />
                                }
                            </div>
                        </div>
                        <span class="font-mono text-xs text-muted-foreground">@track.Duration</span>
                        <span class="@($"w-6 text-right font-semibold text-sm tabular-nums {RatingColor(track.Rating)}")">@track.Rating</span>
                        <LucideIconCn Name="chevron-right" Size="14" Class="@($"size-3.5 shrink-0 text-muted-foreground/60 transition-transform duration-200{(isExpanded ? " rotate-90" : "")}")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-12">
                            <div class="flex items-center gap-2">
                                <div class="flex items-center gap-0.5">
                                    @foreach (var star in RenderStars(track.Rating))
                                    {
                                        <LucideIconCn Name="star" Size="14" Class="@star" />
                                    }
                                </div>
                                <span class="text-xs text-muted-foreground">@track.Rating / 5.0</span>
                            </div>
                            <div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-muted">
                                <div class="h-full rounded-full bg-foreground" style="@(FormattableString.Invariant($"width:{(track.Rating / 5.0) * 100:F1}%"))"></div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Vote buttons *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">Was this review helpful?</span>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="@(_userVote == "helpful" ? ButtonVariant.Default : ButtonVariant.Outline)"
                          Size="ButtonSize.Sm"
                          Class="h-7 gap-1 text-xs"
                          OnClick="VoteHelpful">
                    <LucideIconCn Name="thumbs-up" Size="12" Class="size-3" />
                    @_votes.Helpful
                </ButtonCn>
                <ButtonCn Variant="@(_userVote == "notHelpful" ? ButtonVariant.Default : ButtonVariant.Outline)"
                          Size="ButtonSize.Sm"
                          Class="h-7 gap-1 text-xs"
                          OnClick="VoteNotHelpful">
                    <LucideIconCn Name="thumbs-down" Size="12" Class="size-3" />
                    @_votes.NotHelpful
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record AlbumInfo(string Title, string Artist, string Year, string Genre, double Rating, int TotalRatings);
    private record ReviewerInfo(string Name, string Avatar, string Date, string Publication);
    private record TrackInfo(string Id, int Number, string Title, string Duration, double Rating, bool Highlight);
    private record VoteInfo(int Helpful, int NotHelpful);

    private static readonly AlbumInfo _album = new("Midnight Frequencies", "The Resonators", "2026", "Electronic / Ambient", 4.2, 847);

    private static readonly ReviewerInfo _reviewer = new("Elena Vasquez", "EV", "Mar 24, 2026", "Frequency Magazine");

    private static readonly string _reviewText =
        "A masterclass in atmospheric production. The Resonators push boundaries on this album, weaving intricate synth layers with field recordings from abandoned concert halls. Each track unfolds like a sonic journey, rewarding patient listeners with unexpected harmonic shifts.";

    private static readonly TrackInfo[] _tracks =
    [
        new("t1", 1, "Signal Lost",       "4:32", 4.0, false),
        new("t2", 2, "Basement Echo",     "5:17", 4.5, true),
        new("t3", 3, "Phase Drift",       "3:48", 3.8, false),
        new("t4", 4, "Concrete Garden",   "6:01", 4.7, true),
        new("t5", 5, "Wire Memory",       "4:22", 3.5, false),
        new("t6", 6, "Last Transmission", "7:14", 4.8, true),
        new("t7", 7, "Static Bloom",      "4:55", 4.1, false),
        new("t8", 8, "Resonance",         "5:38", 4.3, false),
    ];

    private string? _expandedTrack;
    private VoteInfo _votes = new(142, 18);
    private string? _userVote;

    private void ToggleTrack(string id)
    {
        _expandedTrack = _expandedTrack == id ? null : id;
    }

    private void VoteHelpful() => HandleVote("helpful");
    private void VoteNotHelpful() => HandleVote("notHelpful");

    private void HandleVote(string type)
    {
        if (_userVote == type)
        {
            _userVote = null;
            if (type == "helpful")
                _votes = new(_votes.Helpful - 1, _votes.NotHelpful);
            else
                _votes = new(_votes.Helpful, _votes.NotHelpful - 1);
        }
        else
        {
            if (_userVote != null)
            {
                if (_userVote == "helpful")
                    _votes = new(_votes.Helpful - 1, _votes.NotHelpful);
                else
                    _votes = new(_votes.Helpful, _votes.NotHelpful - 1);
            }
            _userVote = type;
            if (type == "helpful")
                _votes = new(_votes.Helpful + 1, _votes.NotHelpful);
            else
                _votes = new(_votes.Helpful, _votes.NotHelpful + 1);
        }
    }

    private static string RatingColor(double rating)
    {
        if (rating >= 4.5) return "text-emerald-600 dark:text-emerald-400";
        if (rating >= 3.5) return "text-foreground";
        return "text-muted-foreground";
    }

    private static List<string> RenderStars(double rating)
    {
        var full = (int)Math.Floor(rating);
        var hasHalf = (rating - full) >= 0.3;
        var result = new List<string>();
        for (int i = 0; i < 5; i++)
        {
            if (i < full)
                result.Add("size-3.5 fill-amber-400 text-amber-400");
            else if (i == full && hasHalf)
                result.Add("size-3.5 fill-amber-400/50 text-amber-400");
            else
                result.Add("size-3.5 text-muted-foreground/30");
        }
        return result;
    }
}
