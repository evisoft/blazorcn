@* ============================================================
   Block: music-queue-manager
   Title: MusicQueueManager
   Description: A music play queue manager block for React and Next.js with current track display, drag-to-reorder queue, remove and clear actions, recently played section, and total duration built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-queue-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="list-music" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Play Queue</span>
            </div>
            @if (_queue.Count > 0)
            {
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                          Class="h-6 gap-1 px-2 text-muted-foreground text-xs hover:text-red-500"
                          OnClick="@ClearQueue">
                    <LucideIconCn Name="trash-2" Size="12" Class="size-3" />
                    Clear
                </ButtonCn>
            }
        </div>

        @* Now Playing *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs uppercase tracking-wider">
                Now Playing
            </span>
            <div class="flex items-center gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                    <LucideIconCn Name="pause" Size="16" Class="size-4 text-foreground" />
                </div>
                <div class="min-w-0 flex-1">
                    <p class="truncate font-medium text-sm">@_currentTrack.Title</p>
                    <p class="truncate text-muted-foreground text-xs">
                        @_currentTrack.Artist &middot; @_currentTrack.Album
                    </p>
                </div>
                <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                    @FormatDuration(_currentTrack.Duration)
                </span>
            </div>
            @* Progress bar (static at 38%) *@
            <div class="mt-2.5 h-1 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-foreground" style="width:38%"></div>
            </div>
        </div>

        @* Upcoming Queue *@
        <div>
            <div class="flex items-center justify-between border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs uppercase tracking-wider">
                    Up Next
                </span>
                <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="clock" Size="12" Class="size-3" />
                    <span class="tabular-nums">@FormatTotalTime(_totalSeconds)</span>
                    <span>&middot;</span>
                    <span>@_queue.Count tracks</span>
                </div>
            </div>
            @if (_queue.Count > 0)
            {
                <div class="border-b">
                    @foreach (var item in _queue)
                    {
                        var track = item;
                        var isLast = _queue.IndexOf(track) == _queue.Count - 1;
                        <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                            <button type="button"
                                    class="shrink-0 cursor-grab text-muted-foreground/40 hover:text-muted-foreground active:cursor-grabbing"
                                    aria-label="@($"Reorder {track.Title}")">
                                <LucideIconCn Name="grip-vertical" Size="14" Class="size-3.5" />
                            </button>
                            <div class="min-w-0 flex-1">
                                <p class="truncate font-medium text-sm">@track.Title</p>
                                <p class="truncate text-muted-foreground text-xs">@track.Artist</p>
                            </div>
                            <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                                @FormatDuration(track.Duration)
                            </span>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                      Class="size-6 shrink-0 p-0 text-muted-foreground/60 hover:text-red-500"
                                      OnClick="@(() => RemoveTrack(track.Id))"
                                      aria-label="@($"Remove {track.Title} from queue")">
                                <LucideIconCn Name="x" Size="12" Class="size-3" />
                            </ButtonCn>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="border-b px-4 py-8 text-center text-muted-foreground text-sm">
                    Queue is empty. Add tracks to get started.
                </div>
            }
        </div>

        @* Recently Played *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs uppercase tracking-wider">
                    Recently Played
                </span>
            </div>
            @foreach (var item in _recentlyPlayed)
            {
                var track = item;
                var isLast = Array.IndexOf(_recentlyPlayed, track) == _recentlyPlayed.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <div class="min-w-0 flex-1 pl-6">
                        <p class="truncate text-muted-foreground text-sm">@track.Title</p>
                        <p class="truncate text-muted-foreground/60 text-xs">@track.Artist</p>
                    </div>
                    <span class="shrink-0 font-mono text-muted-foreground/60 text-xs tabular-nums">
                        @FormatDuration(track.Duration)
                    </span>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Drag to reorder &middot; @(_queue.Count + 1) tracks in session
            </p>
        </div>

    </div>
</section>

@code {
    private record Track(string Id, string Title, string Artist, string Album, int Duration);

    private static readonly Track _currentTrack = new(
        Id: "now",
        Title: "Midnight City",
        Artist: "M83",
        Album: "Hurry Up, We're Dreaming",
        Duration: 244
    );

    private static readonly Track[] _recentlyPlayed =
    [
        new("r1", "Instant Crush", "Daft Punk ft. Julian Casablancas", "Random Access Memories", 337),
        new("r2", "Dreams", "Fleetwood Mac", "Rumours", 254),
        new("r3", "Borderline", "Tame Impala", "The Slow Rush", 237),
    ];

    private List<Track> _queue =
    [
        new("q1", "Tadow", "Masego & FKJ", "Masego", 312),
        new("q2", "Redbone", "Childish Gambino", "Awaken, My Love!", 327),
        new("q3", "Electric Feel", "MGMT", "Oracular Spectacular", 229),
        new("q4", "Let It Happen", "Tame Impala", "Currents", 468),
        new("q5", "Do I Wanna Know?", "Arctic Monkeys", "AM", 272),
    ];

    private int _totalSeconds => _queue.Sum(t => t.Duration);

    private static string FormatDuration(int seconds)
    {
        int h = seconds / 3600;
        int m = (seconds % 3600) / 60;
        int s = seconds % 60;
        if (h > 0)
            return $"{h}:{m:D2}:{s:D2}";
        return $"{m}:{s:D2}";
    }

    private static string FormatTotalTime(int seconds)
    {
        int h = seconds / 3600;
        int m = (seconds % 3600) / 60;
        if (h > 0)
            return $"{h} hr {m} min";
        return $"{m} min";
    }

    private void RemoveTrack(string id)
    {
        _queue = _queue.Where(t => t.Id != id).ToList();
    }

    private void ClearQueue()
    {
        _queue = [];
    }
}
