@* ============================================================
   Block: music-social-feed
   Title: MusicSocialFeed
   Description: A music social feed block for React and Next.js with listen, playlist add, like, and share activity items, track info, timestamps, and engagement counts built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-social-feed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="rss" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Music Feed</span>
            </div>
            <span class="text-muted-foreground text-xs">
                @_filteredActivities.Length activities
            </span>
        </div>

        @* Filter bar *@
        <div class="flex items-center gap-1 border-b px-4 py-2.5">
            <div class="flex items-center gap-1 rounded-md bg-muted/50 p-0.5">
                @foreach (var opt in _filterOptions)
                {
                    var option = opt;
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-7 text-xs", _filter == option.Value ? "bg-background shadow-sm" : "text-muted-foreground")"
                              @onclick="@(() => SetFilter(option.Value))">
                        @option.Label
                    </ButtonCn>
                }
            </div>
        </div>

        @* Activity list *@
        <div>
            @for (int i = 0; i < _filteredActivities.Length; i++)
            {
                var activity = _filteredActivities[i];
                var config = _activityConfig[activity.Type];
                bool isLast = i == _filteredActivities.Length - 1;
                bool isLiked = _likedItems.Contains(activity.Id);
                <div class="@Cn.Merge("", isLast ? "" : "border-b")">
                    <div class="flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50">

                        @* Avatar *@
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted/50">
                            <span class="font-medium text-muted-foreground text-xs">
                                @activity.UserInitials
                            </span>
                        </div>

                        <div class="min-w-0 flex-1">
                            @* Action line *@
                            <div class="flex items-center gap-1.5">
                                <span class="font-medium text-sm">@activity.UserName</span>
                                <span class="@($"size-1.5 shrink-0 rounded-full {config.DotColor}")"></span>
                                <span class="text-muted-foreground text-xs">@config.Label</span>
                            </div>

                            @* Track info *@
                            <div class="mt-1 flex items-center gap-2 rounded-md bg-muted/50 px-3 py-2">
                                <LucideIconCn Name="@config.IconName" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <span class="font-medium text-sm">@activity.TrackTitle</span>
                                    <p class="truncate text-muted-foreground text-xs">
                                        @activity.Artist &middot; @activity.Album
                                    </p>
                                </div>
                            </div>

                            @* Engagement row *@
                            <div class="mt-2 flex items-center gap-3">
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                          Class="@Cn.Merge("h-6 gap-1 px-2 text-xs", isLiked ? "text-red-500" : "text-muted-foreground")"
                                          @onclick="@(() => ToggleLike(activity.Id))">
                                    <LucideIconCn Name="heart" Size="12" Class="@Cn.Merge("size-3", isLiked ? "fill-current" : "")" />
                                    @(activity.Likes + (isLiked ? 1 : 0))
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                          Class="h-6 gap-1 px-2 text-muted-foreground text-xs">
                                    <LucideIconCn Name="message-circle" Size="12" Class="size-3" />
                                    @activity.Comments
                                </ButtonCn>
                                <span class="ml-auto text-muted-foreground text-xs">
                                    @activity.Timestamp
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Showing recent activity from your network
            </p>
        </div>

    </div>
</section>

@code {
    private record ActivityItem(string Id, string Type, string UserName, string UserInitials,
        string TrackTitle, string Artist, string Album, string Timestamp, int Likes, int Comments);

    private record ActivityConfig(string Label, string DotColor, string IconName);

    private static readonly ActivityItem[] _activities =
    [
        new("a1", "listened", "Sarah K.", "SK", "Midnight Signal", "Neon Waves", "Neon Architectures", "2 min ago", 12, 3),
        new("a2", "added", "Marcus J.", "MJ", "Glass Highway", "Glass Tide", "Tidal Patterns", "8 min ago", 5, 1),
        new("a3", "liked", "Aiko T.", "AT", "Slow Burn", "Velvet Haze", "Quiet Machines", "15 min ago", 24, 7),
        new("a4", "shared", "Daniel R.", "DR", "Echoes of You", "Glass Tide", "Tidal Patterns", "22 min ago", 18, 4),
        new("a5", "listened", "Emma L.", "EL", "Crystal Clear", "Moonlit", "Solar Return", "31 min ago", 9, 2),
        new("a6", "added", "Noah P.", "NP", "Neon Pulse", "Neon Waves", "Neon Architectures", "45 min ago", 7, 0),
        new("a7", "liked", "Mia W.", "MW", "Drift Away", "Solar Flare", "First Light", "1 hr ago", 31, 5),
    ];

    private static readonly Dictionary<string, ActivityConfig> _activityConfig = new()
    {
        ["listened"] = new("listened to", "bg-emerald-500", "play"),
        ["added"]    = new("added to playlist", "bg-blue-500", "list-plus"),
        ["liked"]    = new("liked", "bg-red-500", "heart"),
        ["shared"]   = new("shared", "bg-amber-500", "share-2"),
    };

    private static readonly (string Label, string Value)[] _filterOptions =
    [
        ("All", "all"),
        ("Listened", "listened"),
        ("Added", "added"),
        ("Liked", "liked"),
        ("Shared", "shared"),
    ];

    private string _filter = "all";
    private readonly HashSet<string> _likedItems = new();

    private ActivityItem[] _filteredActivities =>
        _filter == "all" ? _activities : _activities.Where(a => a.Type == _filter).ToArray();

    private void SetFilter(string value) => _filter = value;

    private void ToggleLike(string id)
    {
        if (_likedItems.Contains(id))
            _likedItems.Remove(id);
        else
            _likedItems.Add(id);
    }
}
