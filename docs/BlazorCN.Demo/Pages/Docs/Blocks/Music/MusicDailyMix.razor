@* ============================================================
   Block: music-daily-mix
   Title: MusicDailyMix
   Description: A daily mix playlist card block for React and Next.js with curated track list, mood indicator, play-all button, and freshness timestamp built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-daily-mix.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Daily Mix</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("font-normal text-xs", _moodColor)">
                    @_mood
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Curated based on your recent listening history
            </p>
        </div>

        @* Stats row *@
        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="headphones" Size="12" Class="size-3" />
                <span>@_tracks.Length tracks</span>
            </div>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="clock" Size="12" Class="size-3" />
                <span>@_totalDuration</span>
            </div>
            <span class="ml-auto flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-muted-foreground text-xs">Updated 3 hours ago</span>
            </span>
        </div>

        @* Track list *@
        <div>
            @foreach (var (track, index) in _tracks.Select((t, i) => (t, i)))
            {
                var isActive = _playing == track.Id;
                var isLast = index == _tracks.Length - 1;
                var item = track;
                var idx = index;
                <div class="@Cn.Merge("group flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => SetPlaying(isActive ? null : item.Id))"
                            class="flex size-7 shrink-0 items-center justify-center rounded-full transition-colors hover:bg-muted"
                            aria-label="@(isActive ? $"Pause {item.Title}" : $"Play {item.Title}")">
                        @if (isActive)
                        {
                            <LucideIconCn Name="pause" Size="14" Class="size-3.5" />
                        }
                        else
                        {
                            <span class="font-mono text-muted-foreground text-xs group-hover:hidden tabular-nums">
                                @(idx + 1)
                            </span>
                            <span class="hidden size-3.5 group-hover:flex items-center justify-center">
                                <LucideIconCn Name="play" Size="14" Class="size-3.5" />
                            </span>
                        }
                    </button>
                    <div class="min-w-0 flex-1">
                        <span class="@Cn.Merge("text-sm", isActive ? "font-medium" : "")">@item.Title</span>
                        <p class="truncate text-muted-foreground text-xs">@item.Artist</p>
                    </div>
                    <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                        @item.Duration
                    </span>
                </div>
            }
        </div>

        @* Play All footer *@
        <div class="border-t px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm"
                      Class="h-8 w-full gap-1.5 text-xs"
                      OnClick="@(() => SetPlaying(_tracks.Length > 0 ? _tracks[0].Id : null))">
                <LucideIconCn Name="play" Size="12" Class="size-3" />
                Play All
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Track(string Id, string Title, string Artist, string Duration);

    private static readonly Track[] _tracks =
    [
        new("t1", "Electric Sunrise",  "Nova Waves",       "3:42"),
        new("t2", "Pulse Drive",       "Midnight Circuit", "4:08"),
        new("t3", "Adrenaline Rush",   "The Voltage",      "3:17"),
        new("t4", "Neon Heartbeat",    "Synth Riders",     "3:55"),
        new("t5", "Breaking Through",  "Amplify",          "4:23"),
        new("t6", "Full Throttle",     "Bass Theory",      "3:31"),
        new("t7", "Momentum",          "Crystal Echo",     "3:48"),
        new("t8", "Daybreak Run",      "Solar Flare",      "4:12"),
    ];

    private const string _mood = "Energetic";
    private const string _moodColor = "bg-amber-500/10 text-amber-600 dark:text-amber-400";
    private const string _totalDuration = "30 min";

    private string? _playing = null;

    private void SetPlaying(string? id)
    {
        _playing = id;
    }
}
