@* ============================================================
   Block: music-playlist-folder
   Title: MusicPlaylistFolder
   Description: A playlist folder organization block for React and Next.js with draggable folders, playlist counts, rename functionality, folder creation, and drag-to-reorder built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-playlist-folder.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="folder" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Playlist Folders</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs">
                    @_folders.Count folders &middot; @TotalPlaylists playlists
                </span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="AddFolder">
                    <LucideIconCn Name="folder-plus" Size="12" Class="size-3" />
                    New
                </ButtonCn>
            </div>
        </div>

        @* Folder list *@
        <div>
            @foreach (var (folder, index) in _folders.Select((f, i) => (f, i)))
            {
                var isExpanded = _expandedId == folder.Id;
                var isRenaming = _renamingId == folder.Id;
                var isLast = index == _folders.Count - 1;
                var f = folder;
                <div class="@Cn.Merge("", isLast ? "" : "border-b")">

                    @* Folder row *@
                    <div class="flex items-center gap-2 px-4 py-3 transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="grip-vertical" Size="14" Class="size-3.5 shrink-0 cursor-grab text-muted-foreground/40" />

                        @* While renaming, the row is a plain container: an <input> inside the
                           expand <button> is invalid HTML (the parser closes the outer button
                           under Static SSR) and the button swallowed the input's clicks, which
                           is what the @onclick:stopPropagation wrapper was working around. *@
                        @if (isRenaming)
                        {
                            <div class="flex min-w-0 flex-1 items-center gap-2">
                                <LucideIconCn Name="folder" Size="16" Class="@Cn.Merge("size-4 shrink-0", f.Color)" />
                                <InputCn Class="h-6 border-0 bg-transparent px-0 font-medium text-sm shadow-none focus-visible:ring-0"
                                         Value="@_renameValue"
                                         aria-label="Folder name"
                                         ValueChanged="@((string v) => _renameValue = v)"
                                         Placeholder="" />
                                <span class="ml-auto shrink-0 text-muted-foreground text-xs tabular-nums">
                                    @f.Playlists.Length
                                </span>
                                <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                            </div>
                        }
                        else
                        {
                            <button type="button"
                                    class="flex min-w-0 flex-1 items-center gap-2 text-left"
                                    @onclick="@(() => ToggleExpand(f.Id))"
                                    aria-expanded="@isExpanded.ToString().ToLower()">
                                <LucideIconCn Name="folder" Size="16" Class="@Cn.Merge("size-4 shrink-0", f.Color)" />
                                <span class="truncate font-medium text-sm">@f.Name</span>
                                <span class="ml-auto shrink-0 text-muted-foreground text-xs tabular-nums">
                                    @f.Playlists.Length
                                </span>
                                <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                            </button>
                        }

                        <div @onclick:stopPropagation>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                      Class="size-6 shrink-0 p-0"
                                      OnClick="@(() => StartRename(f))"
                                      aria-label="@($"Rename {f.Name}")">
                                <LucideIconCn Name="pencil" Size="12" Class="size-3 text-muted-foreground" />
                            </ButtonCn>
                        </div>
                        <div @onclick:stopPropagation>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                      Class="size-6 shrink-0 p-0 text-muted-foreground hover:text-red-500"
                                      OnClick="@(() => DeleteFolder(f.Id))"
                                      aria-label="@($"Delete {f.Name}")">
                                <LucideIconCn Name="trash-2" Size="12" Class="size-3" />
                            </ButtonCn>
                        </div>
                    </div>

                    @* Expanded playlists *@
                    @if (isExpanded)
                    {
                        @if (f.Playlists.Length == 0)
                        {
                            <div class="px-4 pb-3 pl-12">
                                <p class="text-muted-foreground text-xs">No playlists in this folder yet</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var playlist in f.Playlists)
                            {
                                var pl = playlist;
                                <div class="flex items-center gap-2.5 px-4 py-2 pl-12 transition-colors hover:bg-muted/30">
                                    <LucideIconCn Name="list-music" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                                    <span class="min-w-0 flex-1 truncate text-sm">@pl.Name</span>
                                    <span class="text-muted-foreground text-xs tabular-nums">@pl.TrackCount tracks</span>
                                </div>
                            }
                        }
                    }

                </div>
            }
        </div>

        @* Empty state *@
        @if (_folders.Count == 0)
        {
            <div class="px-4 py-8 text-center">
                <LucideIconCn Name="folder" Size="20" Class="mx-auto size-5 text-muted-foreground" />
                <p class="mt-2 text-muted-foreground text-sm">No folders created</p>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-3 h-7 gap-1.5 text-xs" OnClick="AddFolder">
                    <LucideIconCn Name="folder-plus" Size="12" Class="size-3" />
                    Create your first folder
                </ButtonCn>
            </div>
        }

        @* Footer *@
        @if (_folders.Count > 0)
        {
            <div class="border-t px-4 py-2.5">
                <p class="text-center text-muted-foreground text-xs">
                    Drag to reorder &middot; Click folder to expand
                </p>
            </div>
        }

    </div>
</section>

@code {
    private record PlaylistItem(string Id, string Name, int TrackCount);
    private record FolderItem(string Id, string Name, string Color, PlaylistItem[] Playlists);

    private List<FolderItem> _folders = new List<FolderItem>
    {
        new("f1", "Workout", "text-red-500", new PlaylistItem[]
        {
            new("p1", "High Intensity", 42),
            new("p2", "Running Mix", 28),
            new("p3", "Gym Pump", 35),
        }),
        new("f2", "Chill", "text-sky-500", new PlaylistItem[]
        {
            new("p4", "Sunday Morning", 67),
            new("p5", "Lo-fi Study", 124),
            new("p6", "Rainy Day", 53),
            new("p7", "Coffee Shop", 41),
        }),
        new("f3", "Party", "text-amber-500", new PlaylistItem[]
        {
            new("p8", "Dance Floor", 89),
            new("p9", "Throwback Hits", 156),
        }),
        new("f4", "Focus", "text-emerald-500", new PlaylistItem[]
        {
            new("p10", "Deep Work", 73),
            new("p11", "Ambient Focus", 48),
            new("p12", "Classical Piano", 92),
            new("p13", "Nature Sounds", 31),
        }),
    };

    private string? _expandedId = "f2";
    private string? _renamingId = null;
    private string _renameValue = "";
    private int _folderCounter = 5;

    private int TotalPlaylists => _folders.Sum(f => f.Playlists.Length);

    private void ToggleExpand(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private void StartRename(FolderItem folder)
    {
        _renamingId = folder.Id;
        _renameValue = folder.Name;
    }

    private void ConfirmRename()
    {
        if (_renamingId != null && !string.IsNullOrWhiteSpace(_renameValue))
        {
            var trimmed = _renameValue.Trim();
            _folders = _folders.Select(f => f.Id == _renamingId
                ? new FolderItem(f.Id, trimmed, f.Color, f.Playlists)
                : f).ToList();
        }
        _renamingId = null;
        _renameValue = "";
    }

    private void DeleteFolder(string id)
    {
        _folders = _folders.Where(f => f.Id != id).ToList();
        if (_expandedId == id) _expandedId = null;
    }

    private void AddFolder()
    {
        var newId = $"f{_folderCounter}";
        _folderCounter++;
        var newFolder = new FolderItem(newId, "New Folder", "text-muted-foreground", Array.Empty<PlaylistItem>());
        _folders = _folders.Append(newFolder).ToList();
        _renamingId = newFolder.Id;
        _renameValue = "New Folder";
    }
}
