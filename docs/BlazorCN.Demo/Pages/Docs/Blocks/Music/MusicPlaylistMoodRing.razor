@* ============================================================
   Block: music-playlist-mood-ring
   Title: MusicPlaylistMoodRing
   Description: A playlist mood visualization block for React and Next.js with circular mood display, color-coded genres, tempo distribution, and mood summary built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-playlist-mood-ring.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Playlist Mood</span>
                </div>
                <span class="text-muted-foreground text-xs">@_trackCount tracks analyzed</span>
            </div>
        </div>

        @* Mood ring visualization *@
        <div class="flex flex-col items-center border-b px-4 py-6">
            <div class="relative flex items-center justify-center"
                 role="img"
                 aria-label="@($"Mood: {_moodLabel}. Energy {_energy}%, Valence {_valence}%")">
                @* Outer energy ring *@
                <div class="absolute rounded-full border-2 border-violet-500/30 bg-violet-500/5"
                     style="@($"width:{_energyRingSize};height:{_energyRingSize}")"></div>
                @* Middle valence ring *@
                <div class="absolute rounded-full border-2 border-cyan-500/40 bg-cyan-500/10"
                     style="@($"width:{_valenceRingSize};height:{_valenceRingSize}")"></div>
                @* Center core *@
                <div class="relative z-10 flex size-16 items-center justify-center rounded-full bg-foreground">
                    <LucideIconCn Name="music" Size="24" Class="size-6 text-background" />
                </div>
            </div>

            <div class="mt-4 text-center">
                <span class="font-medium text-sm">@_moodLabel</span>
                <p class="mt-1 max-w-xs text-muted-foreground text-xs">@_moodDescription</p>
            </div>
        </div>

        @* Energy / Valence / Danceability stats *@
        <div class="grid grid-cols-3 border-b">
            <div class="flex flex-col items-center border-r px-4 py-3">
                <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="zap" Size="12" Class="size-3" />
                    Energy
                </div>
                <span class="mt-1 font-semibold text-2xl tabular-nums">@_energy</span>
            </div>
            <div class="flex flex-col items-center border-r px-4 py-3">
                <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="sparkles" Size="12" Class="size-3" />
                    Valence
                </div>
                <span class="mt-1 font-semibold text-2xl tabular-nums">@_valence</span>
            </div>
            <div class="flex flex-col items-center px-4 py-3">
                <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="activity" Size="12" Class="size-3" />
                    Dance
                </div>
                <span class="mt-1 font-semibold text-2xl tabular-nums">@_danceability</span>
            </div>
        </div>

        @* Genre breakdown *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Genre Breakdown
            </span>
            <div class="mb-2 flex h-2 w-full overflow-hidden rounded-full">
                @foreach (var genre in _genres)
                {
                    <div class="@Cn.Merge(genre.Color, "h-full")" style="@($"width:{genre.Percentage}%")"></div>
                }
            </div>
            <div class="flex flex-wrap gap-x-3 gap-y-1">
                @foreach (var genre in _genres)
                {
                    <div class="flex items-center gap-1.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", genre.Color)"></span>
                        <span class="text-muted-foreground text-xs">
                            @genre.Name @(genre.Percentage)%
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Tempo distribution *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Tempo Distribution (BPM)
            </span>
            <div class="flex items-end gap-1.5">
                @foreach (var rng in _tempoRanges)
                {
                    var heightPercent = (int)Math.Round((double)rng.Count / rng.MaxCount * 100);
                    <div class="flex flex-1 flex-col items-center gap-1">
                        <span class="font-mono text-muted-foreground text-xs tabular-nums">
                            @rng.Count
                        </span>
                        <div class="w-full overflow-hidden rounded-sm bg-muted" style="height:48px">
                            <div class="w-full rounded-sm bg-foreground/20"
                                 style="@($"margin-top:{100 - heightPercent}%;height:{heightPercent}%")"></div>
                        </div>
                        <span class="text-muted-foreground text-xs">@rng.Label</span>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Mood analysis based on audio features &middot; Updated per playlist change
            </p>
        </div>

    </div>
</section>

@code {
    private record GenreSlice(string Id, string Name, int Percentage, string Color);
    private record TempoRange(string Id, string Label, int Count, int MaxCount);

    private const int _energy = 72;
    private const int _valence = 64;
    private const int _danceability = 81;
    private const int _trackCount = 47;

    private static readonly GenreSlice[] _genres =
    [
        new("g1", "Indie Rock", 28, "bg-violet-500"),
        new("g2", "Electronic", 24, "bg-cyan-500"),
        new("g3", "Pop", 20, "bg-rose-500"),
        new("g4", "R&B", 15, "bg-amber-500"),
        new("g5", "Hip Hop", 8, "bg-emerald-500"),
        new("g6", "Jazz", 5, "bg-blue-500"),
    ];

    private static readonly TempoRange[] _tempoRanges =
    [
        new("t1", "60-80", 5, 18),
        new("t2", "80-100", 8, 18),
        new("t3", "100-120", 18, 18),
        new("t4", "120-140", 12, 18),
        new("t5", "140-160", 3, 18),
        new("t6", "160+", 1, 18),
    ];

    private const string _moodLabel = "Upbeat & Energetic";
    private const string _moodDescription =
        "This playlist leans into high-energy tracks with a positive, danceable vibe. Expect driving rhythms and bright melodies.";

    private static readonly string _energyRingSize = $"{(int)Math.Round(_energy * 1.2 + 40)}px";
    private static readonly string _valenceRingSize = $"{(int)Math.Round(_valence * 0.8 + 30)}px";
}
