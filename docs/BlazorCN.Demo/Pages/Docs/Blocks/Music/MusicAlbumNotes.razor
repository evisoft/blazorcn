@* ============================================================
   Block: music-album-notes
   Title: MusicAlbumNotes
   Description: An album liner notes display block for React and Next.js with track-by-track commentary, producer credits, recording location, thanks section, and vintage paper aesthetic built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-album-notes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Album header *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="book-open" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Liner Notes</span>
            </div>
            <div class="mt-2">
                <p class="font-medium text-sm">@_album.Title</p>
                <p class="text-muted-foreground text-xs">
                    @_album.Artist &middot; @_album.Year &middot; @_album.Label
                </p>
            </div>
        </div>

        @* Track-by-track commentary *@
        <div class="border-b">
            <div class="flex items-center gap-2 bg-muted/20 px-4 py-2">
                <LucideIconCn Name="music" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Track-by-Track</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto font-normal text-xs">
                    @_album.Tracks.Length tracks
                </BadgeCn>
            </div>

            @foreach (var track in _album.Tracks)
            {
                var isExpanded = _expandedTrack == track.Id;
                var isLast = track.Id == _album.Tracks[_album.Tracks.Length - 1].Id;
                var trackItem = track;
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => SetExpanded(trackItem.Id, isExpanded))"
                        class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50"
                        aria-expanded="@isExpanded">
                        <span class="w-5 shrink-0 text-right font-mono text-muted-foreground text-xs tabular-nums">
                            @track.Number
                        </span>
                        <span class="min-w-0 flex-1 truncate text-sm">@track.Title</span>
                        <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                            @track.Duration
                        </span>
                        <LucideIconCn Name="chevron-right" Size="14" Class="@Cn.Merge("size-3.5 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="bg-muted/20 px-4 py-3 pl-12">
                            <p class="text-muted-foreground text-sm italic leading-relaxed">
                                @track.Commentary
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* Credits *@
        <div class="border-b bg-muted/20 px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Credits</span>
            </div>
            <div class="mt-2 space-y-1.5">
                <div class="flex gap-2">
                    <span class="w-20 shrink-0 text-right text-muted-foreground text-xs">Produced by</span>
                    <span class="text-xs">@string.Join(", ", _album.Credits.Producers)</span>
                </div>
                <div class="flex gap-2">
                    <span class="w-20 shrink-0 text-right text-muted-foreground text-xs">Engineered by</span>
                    <span class="text-xs">@string.Join(", ", _album.Credits.Engineers)</span>
                </div>
                <div class="flex gap-2">
                    <span class="w-20 shrink-0 text-right text-muted-foreground text-xs">Mastered by</span>
                    <span class="text-xs">@string.Join(", ", _album.Credits.Mastering)</span>
                </div>
                <div class="flex gap-2">
                    <span class="w-20 shrink-0 text-right text-muted-foreground text-xs">Artwork by</span>
                    <span class="text-xs">@_album.Credits.Artwork</span>
                </div>
            </div>
        </div>

        @* Recording location *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="map-pin" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Recorded at</span>
            </div>
            <p class="mt-1 text-sm">@_album.Studio</p>
            <p class="text-muted-foreground text-xs">@_album.Location</p>
        </div>

        @* Thanks & dedication *@
        <div class="bg-muted/20 px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="disc" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Thanks</span>
            </div>
            <p class="mt-1.5 text-muted-foreground text-xs italic leading-relaxed">
                @_album.Thanks
            </p>
            <p class="mt-3 text-center text-xs italic">@_album.Dedication</p>
        </div>

    </div>
</section>

@code {
    private string? _expandedTrack = "t3";

    private void SetExpanded(string id, bool wasExpanded)
    {
        _expandedTrack = wasExpanded ? null : id;
    }

    private record TrackItem(string Id, int Number, string Title, string Duration, string Commentary);
    private record AlbumCreditsData(string[] Producers, string[] Engineers, string[] Mastering, string Artwork);
    private record AlbumInfo(string Title, string Artist, int Year, string Label, string Studio, string Location, TrackItem[] Tracks, AlbumCreditsData Credits, string Thanks, string Dedication);

    private static readonly AlbumInfo _album = new(
        Title: "The Colour of Spring",
        Artist: "Talk Talk",
        Year: 1986,
        Label: "EMI Records",
        Studio: "Wessex Sound Studios",
        Location: "London, England",
        Tracks:
        [
            new("t1", 1, "Happiness Is Easy", "5:12",
                "The opening track sets the album's tone with choral harmonies and Mark Hollis's characteristically sparse vocal delivery. The children's choir was recorded in a single take at the insistence of producer Tim Friese-Greene."),
            new("t2", 2, "I Don't Believe in You", "5:14",
                "Built around a piano motif that Hollis wrote during a late-night session. The harmonica solo was improvised by Steve Winwood, who visited the studio unannounced and laid down the part in two passes."),
            new("t3", 3, "Life's What You Make It", "4:00",
                "The album's lead single and biggest chart success. The distinctive guitar riff was processed through multiple effects pedals and re-amped through a Leslie speaker cabinet to achieve its shimmering quality."),
            new("t4", 4, "April 5th", "3:30",
                "Named for the date the basic track was completed. Features one of the most restrained arrangements on the album, with just voice, organ, and a single bowed bass note sustaining beneath."),
            new("t5", 5, "Living in Another World", "4:48",
                "The driving rhythm section contrasts with ethereal string arrangements by David Rhodes. Multiple vocal takes were layered and selectively muted to create the effect of words emerging from silence."),
            new("t6", 6, "Give It Up", "6:28",
                "The album's emotional centrepiece. The extended coda features an orchestra of session musicians who were given minimal direction — Hollis asked them to play what they felt rather than follow written parts."),
            new("t7", 7, "Chameleon Day", "4:41",
                "Recorded largely live in the studio with minimal overdubs. The natural room ambience of Wessex Studios is particularly audible here, giving the track an intimate, documentary quality."),
            new("t8", 8, "Time It's Time", "5:50",
                "The closing track brings the album full circle with a reprise of harmonic themes from the opening. The fade-out was extended by two minutes at the mastering stage to let the final chord decay naturally."),
        ],
        Credits: new(
            Producers: ["Tim Friese-Greene", "Mark Hollis"],
            Engineers: ["Phil Brown", "James Locke"],
            Mastering: ["Ian Cooper at Metropolis Studios"],
            Artwork: "James Marsh"
        ),
        Thanks: "Special thanks to Keith Aspden, everyone at EMI, the session musicians who gave their time and talent, and the staff at Wessex Sound Studios for endless patience and tea.",
        Dedication: "For Lee and Paul"
    );
}
