@* ============================================================
   Block: music-collab-workspace
   Title: MusicCollabWorkspace
   Description: A music collaboration workspace block for React and Next.js with shared project, contributor avatars, track stems, version history, comments thread, and merge buttons built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-collab-workspace.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Project header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <LucideIconCn Name="music" Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">@_projectName</span>
                    <div class="flex items-center gap-2 text-muted-foreground text-xs">
                        <span>@_projectBpm BPM</span>
                        <span>&middot;</span>
                        <span>@_projectKey</span>
                    </div>
                </div>
            </div>
            <div class="flex items-center gap-2">
                @* Contributor avatars *@
                <div class="flex -space-x-2">
                    @foreach (var c in _contributors)
                    {
                        <AvatarCn Class="size-7 border-2 border-card">
                            <AvatarFallbackCn Class="@Cn.Merge("text-xs", c.Color)">@c.Initials</AvatarFallbackCn>
                        </AvatarCn>
                    }
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_contributors.Length collaborators
                </BadgeCn>
            </div>
        </div>

        @* Track stems *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Track Stems</span>
            </div>
            @foreach (var (stem, index) in _stems.Select((s, i) => (s, i)))
            {
                var isLast = index == _stems.Length - 1;
                var isMuted = _mutedStems.Contains(stem.Id);
                var stemItem = stem;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    @* Mute button *@
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                              Class="size-7 shrink-0 p-0"
                              OnClick="@(() => ToggleMute(stemItem.Id))"
                              aria-label="@(isMuted ? $"Unmute {stemItem.Name}" : $"Mute {stemItem.Name}")"
                              aria-pressed="@isMuted.ToString().ToLower()">
                        @if (isMuted)
                        {
                            <LucideIconCn Name="volume-x" Size="14" Class="size-3.5 text-muted-foreground" />
                        }
                        else
                        {
                            <LucideIconCn Name="volume-2" Size="14" Class="size-3.5" />
                        }
                    </ButtonCn>

                    @* Color indicator *@
                    <span class="@Cn.Merge("size-2 shrink-0 rounded-full", stemItem.Color)"></span>

                    @* Stem info *@
                    <div class="min-w-0 w-24 shrink-0">
                        <span class="block font-medium text-sm">@stemItem.Name</span>
                        <span class="text-muted-foreground text-xs">@stemItem.Contributor</span>
                    </div>

                    @* Waveform *@
                    <div class="@Cn.Merge("hidden h-6 flex-1 items-end gap-px sm:flex", isMuted ? "opacity-30" : "")">
                        @foreach (var (height, i) in stemItem.Waveform.Select((h, idx) => (h, idx)))
                        {
                            <div class="@Cn.Merge("w-1 flex-1 rounded-full", stemItem.Color)"
                                 style="@($"height:{height}px;opacity:0.6")">
                            </div>
                        }
                    </div>

                    @* Status *@
                    <div class="flex items-center gap-1.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", _statusDot.TryGetValue(stemItem.Status, out var dot) ? dot : "")"></span>
                        <span class="text-muted-foreground text-xs capitalize">@stemItem.Status</span>
                    </div>
                </div>
            }
        </div>

        @* Two-column: Versions + Comments *@
        <div class="grid border-b md:grid-cols-2">

            @* Version history *@
            <div class="border-b md:border-b-0 md:border-r">
                <div class="border-b px-4 py-2">
                    <span class="font-medium text-muted-foreground text-xs">Version History</span>
                </div>
                @foreach (var (version, index) in _versions.Select((v, i) => (v, i)))
                {
                    var isLast = index == _versions.Length - 1;
                    <div class="@Cn.Merge("px-4 py-2.5", isLast ? "" : "border-b")">
                        <div class="flex items-center gap-2">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono font-normal text-xs">
                                @version.Label
                            </BadgeCn>
                            <span class="font-medium text-sm">@version.Author</span>
                            <span class="ml-auto text-muted-foreground text-xs">@version.Timestamp</span>
                        </div>
                        <p class="mt-1 text-muted-foreground text-xs">@version.Changes</p>
                    </div>
                }
            </div>

            @* Comments *@
            <div>
                <div class="flex items-center gap-1.5 border-b px-4 py-2">
                    <LucideIconCn Name="message-square" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="font-medium text-muted-foreground text-xs">Comments</span>
                </div>
                @foreach (var (comment, index) in _comments.Select((c, i) => (c, i)))
                {
                    var isLast = index == _comments.Length - 1;
                    <div class="@Cn.Merge("px-4 py-2.5", isLast ? "" : "border-b")">
                        <div class="flex items-center gap-2">
                            <AvatarCn Class="size-5">
                                <AvatarFallbackCn Class="text-xs">@comment.Initials</AvatarFallbackCn>
                            </AvatarCn>
                            <span class="font-medium text-sm">@comment.Author</span>
                            <span class="ml-auto text-muted-foreground text-xs">@comment.Timestamp</span>
                        </div>
                        <p class="mt-1 pl-7 text-muted-foreground text-sm">@comment.Message</p>
                    </div>
                }
            </div>
        </div>

        @* Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="mic" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">
                    @_stems.Count(s => s.Status == "approved") of @_stems.Length stems approved
                </span>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="download" Size="12" Class="size-3" />
                    Export
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="git-merge" Size="12" Class="size-3" />
                    Merge Stems
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record Contributor(string Id, string Name, string Initials, string Role, string Color);
    private record Stem(string Id, string Name, string Contributor, string Status, string Color, int[] Waveform);
    private record Version(string Id, string Label, string Author, string Timestamp, string Changes);
    private record Comment(string Id, string Author, string Initials, string Message, string Timestamp);

    private const string _projectName = "Midnight Sessions EP";
    private const int _projectBpm = 124;
    private const string _projectKey = "Am";

    private static readonly Contributor[] _contributors =
    [
        new("c1", "Alex Rivera", "AR", "Producer", "bg-blue-500/10 text-blue-600"),
        new("c2", "Maya Chen",   "MC", "Vocalist",  "bg-purple-500/10 text-purple-600"),
        new("c3", "Jordan Lee",  "JL", "Mixing",    "bg-emerald-500/10 text-emerald-600"),
        new("c4", "Sam Torres",  "ST", "Bassist",   "bg-amber-500/10 text-amber-600"),
    ];

    private static readonly Stem[] _stems =
    [
        new("vocals",  "Vocals", "Maya Chen",    "approved", "bg-purple-500", [6, 10, 14, 8, 16, 20, 12, 18, 22, 14, 10, 16, 8, 12, 6, 4, 8, 14, 18, 10]),
        new("beat",    "Beat",   "Alex Rivera",  "approved", "bg-blue-500",   [8, 14, 20, 10, 18, 22, 8, 16, 20, 12, 18, 6, 14, 20, 10, 8, 16, 22, 12, 8]),
        new("bass",    "Bass",   "Sam Torres",   "editing",  "bg-amber-500",  [4, 8, 16, 22, 18, 20, 22, 18, 20, 22, 16, 12, 8, 6, 4, 2, 6, 10, 16, 20]),
        new("melody",  "Melody", "Alex Rivera",  "recorded", "bg-emerald-500",[4, 6, 8, 12, 15, 18, 20, 22, 21, 19, 16, 13, 10, 8, 6, 4, 8, 12, 16, 10]),
    ];

    private static readonly Version[] _versions =
    [
        new("v4", "v4", "Alex Rivera", "2 hours ago", "Added reverb to vocals, adjusted beat EQ"),
        new("v3", "v3", "Jordan Lee",  "Yesterday",   "First mix pass, leveled all stems"),
        new("v2", "v2", "Sam Torres",  "2 days ago",  "Re-recorded bass line, new groove"),
        new("v1", "v1", "Alex Rivera", "4 days ago",  "Initial beat and melody sketch"),
    ];

    private static readonly Comment[] _comments =
    [
        new("cm1", "Maya Chen",    "MC", "Can we bring the vocals up slightly in the chorus? They feel buried under the beat.", "1 hour ago"),
        new("cm2", "Alex Rivera",  "AR", "Good call. I'll adjust the compression and add 2dB at the chorus markers.",            "45 min ago"),
        new("cm3", "Jordan Lee",   "JL", "Bass could use a slight cut around 200Hz to make room for the vocal low-end.",         "20 min ago"),
    ];

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["approved"] = "bg-emerald-500",
        ["editing"]  = "bg-amber-500",
        ["recorded"] = "bg-blue-500",
    };

    private readonly HashSet<string> _mutedStems = new();

    private void ToggleMute(string stemId)
    {
        if (!_mutedStems.Remove(stemId))
            _mutedStems.Add(stemId);
    }
}
