@* ============================================================
   Block: music-vinyl-player
   Title: MusicVinylPlayer
   Description: A vinyl turntable player block for React and Next.js with rotating record animation, tone arm, speed selector for 33 45 and 78 RPM, track info display, and play pause stop controls built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-vinyl-player.tsx
   ============================================================ *@

<style>
    @@keyframes vinyl-spin {
        from { transform: rotate(0deg); }
        to   { transform: rotate(360deg); }
    }
    .vinyl-spinning {
        animation: vinyl-spin linear infinite;
    }
</style>

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="disc" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Vinyl Player</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="@Cn.Merge("size-1.5 rounded-full", _playState == "playing" ? "bg-emerald-500" : _playState == "paused" ? "bg-amber-500" : "bg-muted-foreground/40")"></span>
                <span class="text-muted-foreground text-xs">
                    @(_playState == "playing" ? "Playing" : _playState == "paused" ? "Paused" : "Stopped")
                </span>
            </div>
        </div>

        @* Turntable *@
        <div class="flex items-center justify-center border-b px-4 py-6">
            <div class="relative">
                @* Platter base *@
                <div class="relative flex size-48 items-center justify-center rounded-full bg-zinc-900 shadow-lg dark:bg-zinc-800">
                    @* Record *@
                    <div class="@Cn.Merge("flex size-44 items-center justify-center rounded-full bg-zinc-950 dark:bg-zinc-900", _playState == "playing" ? "vinyl-spinning" : "")"
                         style="@(_playState == "playing" ? $"animation-duration:{_animationDuration}s" : "")">
                        @* Grooves *@
                        <div class="flex size-40 items-center justify-center rounded-full border border-zinc-800 dark:border-zinc-700">
                            <div class="flex size-32 items-center justify-center rounded-full border border-zinc-800 dark:border-zinc-700">
                                <div class="flex size-24 items-center justify-center rounded-full border border-zinc-800 dark:border-zinc-700">
                                    @* Label *@
                                    <div class="flex size-16 flex-col items-center justify-center rounded-full bg-amber-900/80 dark:bg-amber-800/60">
                                        <LucideIconCn Name="music" Size="16" Class="size-4 text-amber-200" />
                                        <span class="mt-0.5 font-mono text-amber-200 text-xs leading-none">@_speed</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* Tone arm *@
                <div class="absolute -top-1 right-0 origin-top-right"
                     style="@($"transform: rotate({(_playState == "playing" || _playState == "paused" ? -28 : -5)}deg); transition: transform 0.6s ease-in-out;")">
                    <div class="flex flex-col items-end">
                        @* Arm pivot *@
                        <div class="size-3 rounded-full bg-zinc-400 dark:bg-zinc-500"></div>
                        @* Arm shaft *@
                        <div class="-mt-1.5 mr-1 h-24 w-1 rounded-full bg-zinc-400 dark:bg-zinc-500"></div>
                        @* Cartridge *@
                        <div class="mr-0.5 h-2 w-1.5 rounded-b-sm bg-zinc-500 dark:bg-zinc-400"></div>
                    </div>
                </div>
            </div>
        </div>

        @* Track info *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start justify-between">
                <div>
                    <span class="block font-medium text-sm">@_currentTrack.Title</span>
                    <span class="block text-muted-foreground text-xs">
                        @_currentTrack.Artist &middot; @_currentTrack.Album
                    </span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="font-mono text-muted-foreground text-xs">Side @_currentTrack.Side</span>
                    <span class="text-muted-foreground text-xs">&middot;</span>
                    <span class="font-mono text-muted-foreground text-xs">@_currentTrack.Year</span>
                </div>
            </div>
        </div>

        @* Transport controls *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                @if (_playState == "playing")
                {
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-8 p-0"
                              OnClick="@HandlePause"
                              aria-label="Pause playback">
                        <LucideIconCn Name="pause" Size="14" Class="size-3.5" />
                    </ButtonCn>
                }
                else
                {
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-8 p-0"
                              OnClick="@HandlePlay"
                              aria-label="Start playback">
                        <LucideIconCn Name="play" Size="14" Class="size-3.5" />
                    </ButtonCn>
                }
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-8 p-0"
                          OnClick="@HandleStop"
                          aria-label="Stop playback"
                          Disabled="@(_playState == "stopped")">
                    <LucideIconCn Name="square" Size="12" Class="size-3" />
                </ButtonCn>
            </div>

            @* Speed selector *@
            <div class="flex items-center gap-2">
                <span class="font-medium text-muted-foreground text-xs">RPM</span>
                <div class="flex items-center gap-1">
                    @foreach (var s in _rpmOptions)
                    {
                        var spd = s;
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                  Class="@Cn.Merge("h-7 px-2.5 font-mono text-xs", _speed == spd ? "ring-2 ring-foreground" : "")"
                                  OnClick="@(() => _speed = spd)">
                            @spd
                        </ButtonCn>
                    }
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Vinyl playback &middot; @_speed RPM &middot; Analog warmth
            </p>
        </div>

    </div>
</section>

@code {
    private record TrackInfo(string Title, string Artist, string Album, string Year, string Side);

    private static readonly TrackInfo _currentTrack = new(
        Title: "Blue in Green",
        Artist: "Miles Davis",
        Album: "Kind of Blue",
        Year: "1959",
        Side: "A"
    );

    private static readonly int[] _rpmOptions = [33, 45, 78];

    // playState: "stopped" | "playing" | "paused"
    private string _playState = "stopped";
    private int _speed = 33;

    private double _animationDuration => _speed switch
    {
        33 => 1.8,
        45 => 1.3,
        78 => 0.8,
        _  => 1.8,
    };

    private void HandlePlay()  => _playState = "playing";
    private void HandlePause() => _playState = "paused";
    private void HandleStop()  => _playState = "stopped";
}
