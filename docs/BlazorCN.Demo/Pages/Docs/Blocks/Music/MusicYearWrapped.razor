@* ============================================================
   Block: music-year-wrapped
   Title: MusicYearWrapped
   Description: A year in review music wrapped summary block for React and Next.js with top artist, top song, total minutes, genre breakdown, listening personality, and shareable card built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-year-wrapped.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Your @(_wrappedData.Year) Wrapped</span>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="HandleShare">
                    <LucideIconCn Name="share" Size="12" Class="size-3" />
                    Share
                </ButtonCn>
            </div>
        </div>

        @* Top artist & song *@
        <div class="grid grid-cols-2 border-b">
            <div class="border-r px-4 py-3">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="mic" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="font-medium text-muted-foreground text-xs">Top Artist</span>
                </div>
                <p class="mt-1 font-medium text-sm">@_wrappedData.TopArtist</p>
                <p class="text-muted-foreground text-xs">@(_wrappedData.TopArtistPlays.ToString("N0")) plays</p>
            </div>
            <div class="px-4 py-3">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="music" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="font-medium text-muted-foreground text-xs">Top Song</span>
                </div>
                <p class="mt-1 truncate font-medium text-sm">@_wrappedData.TopSong</p>
                <p class="text-muted-foreground text-xs">@_wrappedData.TopSongArtist</p>
            </div>
        </div>

        @* Stats row *@
        <div class="grid grid-cols-2 border-b">
            <div class="border-r px-4 py-3">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="headphones" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="font-medium text-muted-foreground text-xs">Minutes Listened</span>
                </div>
                <p class="mt-1 font-semibold text-2xl tabular-nums">@(_wrappedData.TotalMinutes.ToString("N0"))</p>
            </div>
            <div class="px-4 py-3">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="font-medium text-muted-foreground text-xs">Songs Played</span>
                </div>
                <p class="mt-1 font-semibold text-2xl tabular-nums">@(_wrappedData.TotalSongs.ToString("N0"))</p>
            </div>
        </div>

        @* Listening personality *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-muted-foreground text-xs">Listening Personality</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_wrappedData.Personality
                </BadgeCn>
            </div>
            <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">
                @_wrappedData.PersonalityDescription
            </p>
        </div>

        @* Genre breakdown *@
        <div class="px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Top Genres</span>
            <div class="mt-2 space-y-2">
                @for (var i = 0; i < _wrappedData.Genres.Length; i++)
                {
                    var genre = _wrappedData.Genres[i];
                    var barColor = _genreBarColors[i];
                    <div class="flex items-center gap-3">
                        <span class="w-16 text-right text-xs tabular-nums">@(genre.Percentage)%</span>
                        <div class="h-2 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="@Cn.Merge("h-full rounded-full", barColor)" style="@($"width:{genre.Percentage}%")"></div>
                        </div>
                        <span class="w-20 text-muted-foreground text-xs">@genre.Name</span>
                    </div>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private record GenreStat(string Name, int Percentage);

    private record WrappedData(
        int Year,
        string TopArtist,
        int TopArtistPlays,
        string TopSong,
        string TopSongArtist,
        int TotalMinutes,
        int TotalSongs,
        string Personality,
        string PersonalityDescription,
        GenreStat[] Genres
    );

    private static readonly string[] _genreBarColors =
    [
        "bg-foreground",
        "bg-foreground/70",
        "bg-foreground/50",
        "bg-foreground/35",
        "bg-foreground/20",
    ];

    private static readonly WrappedData _wrappedData = new(
        Year: 2025,
        TopArtist: "Radiohead",
        TopArtistPlays: 847,
        TopSong: "Everything In Its Right Place",
        TopSongArtist: "Radiohead",
        TotalMinutes: 47832,
        TotalSongs: 12491,
        Personality: "The Deep Diver",
        PersonalityDescription: "You explore full albums, not just singles. You listened to 94% of tracks on your top albums.",
        Genres:
        [
            new("Alternative", 38),
            new("Electronic",  24),
            new("Indie Rock",  18),
            new("Ambient",     12),
            new("Jazz",         8),
        ]
    );

    private void HandleShare()
    {
        // confetti not available in Blazor; no-op
    }
}
