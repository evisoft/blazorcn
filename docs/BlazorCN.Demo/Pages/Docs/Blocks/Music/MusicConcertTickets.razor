@* ============================================================
   Block: music-concert-tickets
   Title: MusicConcertTickets
   Description: A concert ticket purchase block for React and Next.js with event details, seat category selector, quantity picker, animated NumberFlow price display, and checkout button built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-concert-tickets.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Event Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="music" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">@_event.Artist</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    On Sale
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">@_event.Tour</p>
        </div>

        @* Venue & Date *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                <span>@_event.Venue, @_event.City</span>
            </div>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                <span>@_event.Date</span>
            </div>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="text-muted-foreground text-xs">Doors @_event.Doors</span>
        </div>

        @* Seat Category Selector *@
        <div class="border-b px-4 py-3">
            <div class="mb-2.5 flex items-center gap-2">
                <LucideIconCn Name="ticket" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-xs">Select Category</span>
            </div>
            <div class="grid grid-cols-2 gap-2">
                @foreach (var cat in _seatCategories)
                {
                    var catItem = cat;
                    <button type="button"
                            @onclick="@(() => _selectedCategory = catItem.Id)"
                            class="@Cn.Merge("rounded-md border px-3 py-2.5 text-left transition-all", _selectedCategory == catItem.Id ? "border-foreground ring-2 ring-foreground" : "hover:bg-muted/50")">
                        <div class="flex items-center justify-between">
                            <span class="font-medium text-sm">@catItem.Name</span>
                            <span class="font-semibold text-sm tabular-nums">$@catItem.Price</span>
                        </div>
                        <p class="mt-0.5 text-muted-foreground text-xs">@catItem.Description</p>
                        <p class="mt-1 text-muted-foreground text-xs">@catItem.Available remaining</p>
                    </button>
                }
            </div>
        </div>

        @* Quantity Selector *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Quantity</span>
            <div class="flex items-center gap-3">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-7 p-0"
                          OnClick="@(() => _quantity = Math.Max(1, _quantity - 1))"
                          AriaLabel="Remove ticket">
                    <LucideIconCn Name="minus" Size="12" Class="size-3" />
                </ButtonCn>
                <span class="w-8 text-center font-semibold text-sm tabular-nums">@_quantity</span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-7 p-0"
                          OnClick="@(() => _quantity = Math.Min(10, _quantity + 1))"
                          AriaLabel="Add ticket">
                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

        @* Price Breakdown *@
        <div class="border-b px-4 py-3">
            <div class="space-y-1.5">
                <div class="flex items-center justify-between text-muted-foreground text-xs">
                    <span>@SelectedCategory?.Name x @_quantity</span>
                    <span class="tabular-nums">$@Subtotal.ToString("0.##")</span>
                </div>
                <div class="flex items-center justify-between text-muted-foreground text-xs">
                    <span>Service fee</span>
                    <span class="tabular-nums">$@ServiceFee.ToString("0.##")</span>
                </div>
                <div class="border-t pt-1.5"></div>
                <div class="flex items-baseline justify-between">
                    <span class="font-medium text-sm">Total</span>
                    <span class="font-semibold text-2xl tabular-nums">$@Total.ToString("0.##")</span>
                </div>
            </div>
        </div>

        @* CTA *@
        <div class="border-b px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs">
                Buy Tickets
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                All sales final &middot; Mobile tickets only &middot; Show @_event.Showtime
            </p>
        </div>

    </div>
</section>

@code {
    private record SeatCategory(string Id, string Name, int Price, int Available, string Description);

    private record EventDetails(
        string Artist,
        string Tour,
        string Venue,
        string City,
        string Date,
        string Doors,
        string Showtime
    );

    private static readonly SeatCategory[] _seatCategories =
    [
        new("vip",      "VIP",      250, 12,  "Front row, backstage access"),
        new("premium",  "Premium",  150, 48,  "Rows 2-5, priority entry"),
        new("standard", "Standard",  85, 234, "General seating, rows 6-20"),
        new("balcony",  "Balcony",   55, 156, "Upper level, great acoustics"),
    ];

    private static readonly EventDetails _event = new(
        Artist:   "Aurora & The Northern Lights",
        Tour:     "Ethereal Horizons World Tour",
        Venue:    "The Paramount Theatre",
        City:     "Seattle, WA",
        Date:     "Sat, Jun 14, 2026",
        Doors:    "7:00 PM",
        Showtime: "8:30 PM"
    );

    private const double ServiceFeeRate = 0.12;

    private string _selectedCategory = "premium";
    private int _quantity = 2;

    private SeatCategory? SelectedCategory =>
        Array.Find(_seatCategories, c => c.Id == _selectedCategory);

    private double Subtotal => (SelectedCategory?.Price ?? 0) * _quantity;
    private double ServiceFee => Math.Round(Subtotal * ServiceFeeRate * 100) / 100;
    private double Total => Subtotal + ServiceFee;
}
