@* ============================================================
   Block: music-notification-settings
   Title: MusicNotificationSettings
   Description: A music notification preferences block for React and Next.js with toggle switches for new releases, playlist updates, concert alerts, weekly digest, friend activity, and download notifications built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-notification-settings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Notification Preferences</span>
            </div>
            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                <span>@_enabledCount of @_totalCount enabled</span>
            </div>
        </div>

        @* Notification groups *@
        @foreach (var cat in _categories)
        {
            var category = cat;
            var categoryOptions = _notificationOptions.Where(o => o.Category == category).ToArray();
            var catIndex = Array.IndexOf(_categories, category);

            @* Category label *@
            <div class="border-b bg-muted/30 px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">@category</span>
            </div>

            @* Options *@
            @foreach (var opt in categoryOptions)
            {
                var option = opt;
                var optIndex = Array.IndexOf(categoryOptions, option);
                var isLastCategory = catIndex == _categories.Length - 1;
                var isLastOption = optIndex == categoryOptions.Length - 1;
                var showBorder = !(isLastCategory && isLastOption);

                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", showBorder ? "border-b" : "")">
                    @* Icon *@
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        <LucideIconCn Name="@option.IconName" Size="16" Class="size-4 text-muted-foreground" />
                    </div>

                    @* Label and description *@
                    <div class="min-w-0 flex-1">
                        <span class="block font-medium text-sm">@option.Label</span>
                        <span class="block text-muted-foreground text-xs">@option.Description</span>
                    </div>

                    @* Toggle *@
                    <SwitchCn Checked="@_enabled[option.Id]"
                              CheckedChanged="@((bool v) => ToggleNotification(option.Id))"
                              aria-label="@($"Toggle {option.Label} notifications")" />
                </div>
            }
        }

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <p class="text-muted-foreground text-xs">Changes are saved automatically</p>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="ResetToDefaults">
                Reset to Defaults
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record NotificationOption(string Id, string Label, string Description, string IconName, string Category, bool DefaultEnabled);

    private static readonly NotificationOption[] _notificationOptions =
    [
        new("new-releases",     "New Releases",      "Get notified when artists you follow drop new music",               "disc",      "Music",  true),
        new("playlist-updates", "Playlist Updates",  "Updates to playlists you follow or collaborate on",                 "music",     "Music",  true),
        new("concert-alerts",   "Concert Alerts",    "Live events and tour dates from your favorite artists",             "calendar",  "Events", true),
        new("weekly-digest",    "Weekly Digest",     "A summary of your listening stats and new recommendations",         "mail",      "Email",  false),
        new("friend-activity",  "Friend Activity",   "See what your friends are listening to and their recent activity",  "users",     "Social", false),
        new("download-complete","Download Complete",  "Notification when offline downloads finish syncing",                "download",  "System", true),
    ];

    private static readonly string[] _categories =
        _notificationOptions.Select(o => o.Category).Distinct().ToArray();

    private Dictionary<string, bool> _enabled = _notificationOptions
        .ToDictionary(o => o.Id, o => o.DefaultEnabled);

    private int _enabledCount => _enabled.Values.Count(v => v);
    private int _totalCount => _notificationOptions.Length;

    private void ToggleNotification(string id)
    {
        if (_enabled.ContainsKey(id))
            _enabled[id] = !_enabled[id];
    }

    private void ResetToDefaults()
    {
        _enabled = _notificationOptions.ToDictionary(o => o.Id, o => o.DefaultEnabled);
    }
}
