@* ============================================================
   Block: music-concert-photo-gallery
   Title: MusicConcertPhotoGallery
   Description: A concert photo gallery block for React and Next.js with photo grid, venue overlay, photographer credit, download button, and lightbox-style selected view built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-concert-photo-gallery.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="camera" Size="16" Class="size-4 text-muted-foreground" />
                        <span class="font-medium text-sm">@_eventName</span>
                    </div>
                    <div class="mt-1 flex items-center gap-2 text-muted-foreground text-xs">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        <span>@_venue</span>
                        <span>&middot;</span>
                        <span>@_eventDate</span>
                    </div>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@_photos.Length photos</BadgeCn>
            </div>
        </div>

        @* Selected photo lightbox *@
        @if (_selected != null)
        {
            var photo = _selected;
            <div class="border-b">
                <div class="relative">
                    <div class="@($"{photo.Color} flex h-64 items-center justify-center")">
                        <LucideIconCn Name="camera" Size="48" Class="size-12 text-white/40" />
                    </div>
                    <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent px-4 py-3">
                        <p class="font-medium text-sm text-white">@photo.Caption</p>
                        <p class="mt-0.5 text-white/70 text-xs">
                            @photo.Photographer &middot; @photo.Timestamp
                        </p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                              Class="absolute top-2 right-2 size-7 p-0 text-white hover:bg-white/20"
                              @onclick="@(() => _selected = null)"
                              aria-label="Close photo">
                        <LucideIconCn Name="x" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
                <div class="flex items-center justify-between px-4 py-2.5">
                    <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <LucideIconCn Name="camera" Size="12" Class="size-3" />
                        <span>@photo.Photographer</span>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                        <LucideIconCn Name="download" Size="12" Class="size-3" />
                        Download
                    </ButtonCn>
                </div>
            </div>
        }

        @* Photo grid *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-2 gap-2 md:grid-cols-3">
                @foreach (var ph in _photos)
                {
                    var p = ph;
                    var isSelected = _selected?.Id == p.Id;
                    <button type="button"
                            class="@Cn.Merge("group relative overflow-hidden rounded-md flex aspect-square items-center justify-center transition-opacity hover:opacity-90", p.Color, isSelected ? "ring-2 ring-foreground" : "")"
                            @onclick="@(() => _selected = p)"
                            aria-label="@p.Caption">
                        <LucideIconCn Name="camera" Size="24" Class="size-6 text-white/30" />
                        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/50 to-transparent p-2 opacity-0 transition-opacity group-hover:opacity-100">
                            <p class="truncate text-white text-xs">@p.Caption</p>
                        </div>
                    </button>
                }
            </div>
        </div>

        @* Photographer credits *@
        <div class="px-4 py-2.5">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-muted-foreground text-xs">
                    <span>Photos by Alex Rivera, Jordan Lee, Sam Chen</span>
                </div>
                <span class="text-muted-foreground text-xs">All rights reserved</span>
            </div>
        </div>

    </div>
</section>

@code {
    private record Photo(string Id, string Color, string Caption, string Photographer, string Timestamp);

    private const string _venue = "Madison Square Garden";
    private const string _eventDate = "Mar 15, 2026";
    private const string _eventName = "Neon Waves World Tour";

    private static readonly Photo[] _photos =
    [
        new("p1", "bg-rose-500/80",    "Main stage lights during opener",  "Alex Rivera",  "8:12 PM"),
        new("p2", "bg-violet-500/80",  "Crowd surfing during encore",       "Alex Rivera",  "10:45 PM"),
        new("p3", "bg-amber-500/80",   "Drummer solo with pyrotechnics",    "Jordan Lee",   "9:30 PM"),
        new("p4", "bg-cyan-500/80",    "Aerial view of the venue",          "Jordan Lee",   "7:55 PM"),
        new("p5", "bg-emerald-500/80", "Backstage artist warm-up",          "Sam Chen",     "6:20 PM"),
        new("p6", "bg-pink-500/80",    "Confetti drop at finale",           "Sam Chen",     "11:02 PM"),
        new("p7", "bg-indigo-500/80",  "Sound check afternoon session",     "Alex Rivera",  "3:15 PM"),
        new("p8", "bg-orange-500/80",  "Guitar solo spotlight moment",      "Jordan Lee",   "9:58 PM"),
        new("p9", "bg-teal-500/80",    "Fan zone meet and greet",           "Sam Chen",     "5:40 PM"),
    ];

    private Photo? _selected = null;
}
