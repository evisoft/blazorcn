@* ============================================================
   Block: music-podcast-player
   Title: MusicPodcastPlayer
   Description: A podcast episode player block for React and Next.js with playback speed control, skip navigation, show notes, and episode list built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-podcast-player.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Show header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="mic" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">@_showName</span>
            </div>
            <p class="mt-1 font-medium text-foreground text-sm">@_currentEpisode.Title</p>
            <p class="mt-0.5 text-muted-foreground text-xs">
                @_currentEpisode.Date &middot; @_currentEpisode.Duration
            </p>
        </div>

        @* Progress bar *@
        <div class="border-b px-4 py-3">
            <SliderCn Value="@((double)_progress)"
                      ValueChanged="@((double v) => { _progress = (int)v; })"
                      Max="100"
                      Step="1"
                      Class="mb-2"
                      aria-label="Playback progress" />
            <div class="flex items-center justify-between">
                <span class="font-mono text-muted-foreground text-xs">@_elapsed</span>
                <span class="font-mono text-muted-foreground text-xs">@_remaining</span>
            </div>
        </div>

        @* Playback controls *@
        <div class="flex items-center justify-center gap-4 border-b px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1 px-2 text-xs text-muted-foreground" aria-label="Skip back 15 seconds">
                <LucideIconCn Name="rotate-ccw" Size="16" Class="size-4" />
                <span class="text-xs">15</span>
            </ButtonCn>

            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-10 rounded-full p-0"
                      OnClick="@(() => _isPlaying = !_isPlaying)"
                      aria-label="@(_isPlaying ? "Pause" : "Play")">
                @if (_isPlaying)
                {
                    <LucideIconCn Name="pause" Size="16" Class="size-4" />
                }
                else
                {
                    <LucideIconCn Name="play" Size="16" Class="size-4" />
                }
            </ButtonCn>

            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1 px-2 text-xs text-muted-foreground" aria-label="Skip forward 15 seconds">
                <span class="text-xs">15</span>
                <LucideIconCn Name="rotate-cw" Size="16" Class="size-4" />
            </ButtonCn>
        </div>

        @* Speed control *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Speed</span>
            <div class="flex items-center gap-1 rounded-md bg-muted/50 p-0.5">
                @foreach (var s in _speedOptions)
                {
                    var spd = s;
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-7 px-2.5 text-xs", _speed == spd ? "bg-background shadow-sm" : "text-muted-foreground")"
                              OnClick="@(() => _speed = spd)">
                        @($"{spd}x")
                    </ButtonCn>
                }
            </div>
        </div>

        @* Show notes toggle *@
        <div class="border-b">
            <button type="button"
                    @onclick="@(() => _showNotesOpen = !_showNotesOpen)"
                    class="flex w-full items-center justify-between px-4 py-3 text-left transition-colors hover:bg-muted/50">
                <span class="font-medium text-sm">Show Notes</span>
                <LucideIconCn Name="chevron-down" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground transition-transform duration-200", _showNotesOpen ? "rotate-180" : "")" />
            </button>
            @if (_showNotesOpen)
            {
                <div class="px-4 pb-3">
                    <p class="mb-2 text-muted-foreground text-sm">@_currentEpisode.Description</p>
                    <div class="space-y-1">
                        @foreach (var note in _showNotes)
                        {
                            <p class="font-mono text-muted-foreground text-xs">@note</p>
                        }
                    </div>
                </div>
            }
        </div>

        @* Episode list toggle *@
        <div>
            <button type="button"
                    @onclick="@(() => _showEpisodeList = !_showEpisodeList)"
                    class="flex w-full items-center justify-between px-4 py-3 text-left transition-colors hover:bg-muted/50">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="list-music" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">All Episodes</span>
                    <span class="text-muted-foreground text-xs">@_episodes.Length</span>
                </div>
                <LucideIconCn Name="chevron-down" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground transition-transform duration-200", _showEpisodeList ? "rotate-180" : "")" />
            </button>
            @if (_showEpisodeList)
            {
                <div>
                    @for (var i = 0; i < _episodes.Length; i++)
                    {
                        var ep = _episodes[i];
                        var isLast = i == _episodes.Length - 1;
                        var isSelected = _selectedEpisode == ep.Id;
                        <button type="button"
                                @onclick="@(() => _selectedEpisode = ep.Id)"
                                class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50", !isLast ? "border-b" : "", isSelected ? "bg-muted/30" : "")">
                            <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", isSelected ? "bg-foreground" : "bg-transparent")"></span>
                            <div class="min-w-0 flex-1">
                                <span class="@Cn.Merge("text-sm", isSelected ? "font-medium" : "text-muted-foreground")">
                                    @ep.Title
                                </span>
                                <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                    <span>@ep.Date</span>
                                    <span>&middot;</span>
                                    <span>@ep.Duration</span>
                                </div>
                            </div>
                        </button>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Episode(string Id, string Title, string Duration, string Date, string Description);

    private static readonly Episode[] _episodes =
    [
        new("ep-1", "The Architecture of Calm Software", "48:23", "Mar 28, 2026",
            "We explore why the best developer tools feel invisible. From compiler design to API ergonomics, calm software reduces cognitive load."),
        new("ep-2", "Why Your CI Pipeline Is Lying to You", "35:12", "Mar 21, 2026",
            "Green builds do not mean working software. We dig into flaky tests, brittle deploys, and the real cost of false confidence."),
        new("ep-3", "Designing APIs That Last a Decade", "52:07", "Mar 14, 2026",
            "Stripe, Twilio, and GitHub built APIs that aged gracefully. We break down the patterns that make an API timeless."),
        new("ep-4", "The Monorepo Decision Framework", "41:55", "Mar 7, 2026",
            "When monorepos help and when they hurt. A practical guide to making the call for your team size and deployment model."),
        new("ep-5", "Observability Beyond Dashboards", "38:40", "Feb 28, 2026",
            "Logs, metrics, and traces are just the beginning. We discuss structured events, correlation IDs, and debugging in production."),
    ];

    private static readonly string _showName = "The Pragmatic Engineer Podcast";
    private static readonly Episode _currentEpisode = _episodes[0];

    private static readonly string[] _showNotes =
    [
        "00:00 — Introduction and listener questions",
        "04:15 — What makes software feel calm?",
        "12:30 — Compiler UX: error messages that teach",
        "22:45 — API design and the principle of least surprise",
        "35:10 — The hidden cost of notification fatigue",
        "44:00 — Closing thoughts and next episode preview",
    ];

    private static readonly double[] _speedOptions = [0.5, 1, 1.5, 2];

    private bool _isPlaying = false;
    private double _speed = 1;
    private int _progress = 35;
    private bool _showNotesOpen = false;
    private string _selectedEpisode = _episodes[0].Id;
    private bool _showEpisodeList = false;

    private readonly string _elapsed = "16:52";
    private readonly string _remaining = "-31:31";
}
