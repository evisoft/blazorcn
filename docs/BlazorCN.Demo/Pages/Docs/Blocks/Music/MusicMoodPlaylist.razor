@* ============================================================
   Block: music-mood-playlist
   Title: MusicMoodPlaylist
   Description: A mood-based playlist generator block for React and Next.js with mood selector buttons, dynamic track lists, BPM ranges, and energy level indicators built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-mood-playlist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="headphones" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Mood Playlist</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Select a mood to generate a curated track list.
            </p>
        </div>

        @* Mood selector *@
        <div class="flex flex-wrap items-center gap-1.5 border-b px-4 py-3">
            @foreach (var key in _moodKeys)
            {
                var moodKey = key;
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                          Class="@Cn.Merge("h-7 text-xs", _activeMood == moodKey ? "ring-2 ring-foreground" : "")"
                          OnClick="@(() => _activeMood = moodKey)">
                    @_moods[moodKey].Label
                </ButtonCn>
            }
        </div>

        @* Mood info *@
        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <span class="text-muted-foreground text-xs">@CurrentMood.Description</span>
            <div class="ml-auto flex items-center gap-3">
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <LucideIconCn Name="music" Size="12" Class="size-3" />
                    <span class="tabular-nums">@CurrentMood.BpmRange BPM</span>
                </span>
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <LucideIconCn Name="zap" Size="12" Class="size-3" />
                    <span class="tabular-nums">@CurrentMood.EnergyLevel/10</span>
                </span>
            </div>
        </div>

        @* Energy bar *@
        <div class="border-b px-4 py-2.5">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="battery" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Energy</span>
                <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                    <div class="h-full rounded-full bg-foreground"
                         style="@($"width:{CurrentMood.EnergyLevel * 10}%")"></div>
                </div>
                <span class="font-mono text-muted-foreground text-xs tabular-nums">
                    @CurrentMood.EnergyLevel/10
                </span>
            </div>
        </div>

        @* Track list *@
        @foreach (var (track, index) in CurrentMood.Tracks.Select((t, i) => (t, i)))
        {
            var isLast = index == CurrentMood.Tracks.Length - 1;
            <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                <span class="w-5 text-right font-mono text-muted-foreground text-xs tabular-nums">
                    @(index + 1)
                </span>
                <div class="min-w-0 flex-1">
                    <span class="block truncate font-medium text-sm">@track.Title</span>
                    <p class="truncate text-muted-foreground text-xs">@track.Artist</p>
                </div>
                <span class="font-mono text-muted-foreground text-xs tabular-nums">
                    @FormatDuration(track.DurationSec)
                </span>
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between text-muted-foreground text-xs">
                <span>
                    @CurrentMood.Tracks.Length tracks &middot; @TotalMinutes min
                </span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @CurrentMood.BpmRange BPM
                </BadgeCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record Track(string Id, string Title, string Artist, int DurationSec);
    private record Mood(string Label, string Description, string BpmRange, int EnergyLevel, Track[] Tracks);

    private static readonly Dictionary<string, Mood> _moods = new()
    {
        ["happy"] = new Mood("Happy", "Upbeat and feel-good vibes", "110-130", 8,
        [
            new("h1", "Walking on Sunshine", "Katrina & the Waves", 239),
            new("h2", "Happy", "Pharrell Williams", 233),
            new("h3", "Here Comes the Sun", "The Beatles", 185),
            new("h4", "Good as Hell", "Lizzo", 161),
            new("h5", "Three Little Birds", "Bob Marley", 200),
            new("h6", "Lovely Day", "Bill Withers", 254),
        ]),
        ["chill"] = new Mood("Chill", "Laid-back and relaxed listening", "70-95", 3,
        [
            new("c1", "Nikes", "Frank Ocean", 314),
            new("c2", "Sunset Lover", "Petit Biscuit", 237),
            new("c3", "Pink + White", "Frank Ocean", 181),
            new("c4", "Electric Feel", "MGMT", 229),
            new("c5", "Re: Stacks", "Bon Iver", 369),
            new("c6", "Intro", "The xx", 128),
        ]),
        ["energetic"] = new Mood("Energetic", "High-energy tracks for peak performance", "130-160", 10,
        [
            new("e1", "Lose Yourself", "Eminem", 326),
            new("e2", "Can't Hold Us", "Macklemore", 258),
            new("e3", "Stronger", "Kanye West", 312),
            new("e4", "Till I Collapse", "Eminem", 297),
            new("e5", "Blinding Lights", "The Weeknd", 200),
            new("e6", "Levels", "Avicii", 193),
        ]),
        ["melancholy"] = new Mood("Melancholy", "Reflective and emotionally rich", "60-85", 2,
        [
            new("m1", "Skinny Love", "Bon Iver", 231),
            new("m2", "Mad World", "Gary Jules", 192),
            new("m3", "The Night We Met", "Lord Huron", 200),
            new("m4", "Liability", "Lorde", 172),
            new("m5", "Hurt", "Johnny Cash", 216),
            new("m6", "Motion Picture Soundtrack", "Radiohead", 195),
        ]),
        ["focus"] = new Mood("Focus", "Instrumental and ambient for deep work", "80-110", 5,
        [
            new("f1", "Experience", "Ludovico Einaudi", 308),
            new("f2", "Divenire", "Ludovico Einaudi", 413),
            new("f3", "Avril 14th", "Aphex Twin", 121),
            new("f4", "An Ending (Ascent)", "Brian Eno", 262),
            new("f5", "Comptine d'un autre ete", "Yann Tiersen", 140),
            new("f6", "Clair de Lune", "Debussy", 304),
        ]),
    };

    private static readonly string[] _moodKeys = ["happy", "chill", "energetic", "melancholy", "focus"];

    private string _activeMood = "chill";

    private Mood CurrentMood => _moods[_activeMood];

    private int TotalMinutes => (int)Math.Floor(CurrentMood.Tracks.Sum(t => t.DurationSec) / 60.0);

    private static string FormatDuration(int seconds)
    {
        var min = seconds / 60;
        var sec = seconds % 60;
        return $"{min}:{sec:D2}";
    }
}
