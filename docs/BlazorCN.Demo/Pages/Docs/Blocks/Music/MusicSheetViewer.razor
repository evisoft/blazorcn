@* ============================================================
   Block: music-sheet-viewer
   Title: MusicSheetViewer
   Description: A music sheet and score viewer block for React and Next.js with staff lines, key signature, tempo marking, time signature, instrument selector, and page navigation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-sheet-viewer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="music" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Score Viewer</span>
            </div>
            <div class="flex items-center gap-1.5">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs" aria-label="Print score">
                    <LucideIconCn Name="printer" Size="12" Class="size-3" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs" aria-label="Fullscreen">
                    <LucideIconCn Name="maximize" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

        @* Metadata bar *@
        <div class="flex flex-wrap items-center gap-2 border-b px-4 py-2">
            @* Instrument selector *@
            <div class="flex items-center gap-1 rounded-md bg-muted/50 p-0.5">
                @foreach (var inst in _instruments.Take(4))
                {
                    var instName = inst;
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-6 text-xs", _instrument == instName ? "bg-background shadow-sm" : "text-muted-foreground")"
                              OnClick="@(() => _instrument = instName)">
                        @instName
                    </ButtonCn>
                }
            </div>

            <span class="text-muted-foreground text-xs">&middot;</span>

            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono font-normal text-xs">@KeySignature</BadgeCn>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono font-normal text-xs">@TimeSignature</BadgeCn>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono font-normal text-xs">@Tempo BPM</BadgeCn>
        </div>

        @* Score area *@
        <div class="border-b px-4 py-4">

            @* Treble clef area *@
            <div class="mb-3">
                <span class="mb-1 block text-muted-foreground text-xs">Treble Clef</span>
                <div class="relative rounded-md bg-muted/30 px-4 py-3"
                     style="@($"transform:scale({_zoom / 100.0:F2});transform-origin:top left;")">
                    @* Staff lines *@
                    <div class="relative h-[50px] w-full">
                        @for (int i = 0; i < StaffLineCount; i++)
                        {
                            var topPx = i * StaffLineSpacing + 5;
                            <div class="absolute left-0 right-0 h-px bg-muted-foreground/20"
                                 style="@($"top:{topPx}px;")"></div>
                        }
                    </div>
                    @* Clef symbol *@
                    <div class="absolute top-1 left-2 font-serif text-2xl text-muted-foreground/40">
                        &#119070;
                    </div>
                    @* Notes *@
                    @foreach (var meas in _measures)
                    {
                        var measure = meas;
                        var mIndex = Array.IndexOf(_measures, measure);
                        var measureOffset = mIndex * 25;
                        @foreach (var n in measure.Notes)
                        {
                            var note = n;
                            var topNote = note.Line * StaffLineSpacing + 2;
                            var leftNote = measureOffset + note.Offset;
                            var sizeClass = note.NoteType == "whole" ? "size-3.5 rounded-full"
                                          : note.NoteType == "half"  ? "size-3 rounded-full"
                                          :                             "size-2.5 rounded-full";
                            var fillClass = note.Filled ? "bg-foreground" : "border-2 border-foreground bg-card";
                            <div class="absolute" style="@($"top:{topNote}px;left:{leftNote}%;")">
                                <div class="@($"{sizeClass} {fillClass}")"></div>
                                @if (note.NoteType != "whole")
                                {
                                    <div class="absolute -top-4 left-[9px] h-4 w-px bg-foreground"></div>
                                }
                            </div>
                        }
                    }
                    @* Measure bars *@
                    @for (int bi = 0; bi < _measures.Length; bi++)
                    {
                        var barLeft = (bi + 1) * 25;
                        <div class="absolute top-[5px] h-[40px] w-px bg-muted-foreground/20"
                             style="@($"left:{barLeft}%;")"></div>
                    }
                </div>
            </div>

            @* Bass clef area *@
            <div>
                <span class="mb-1 block text-muted-foreground text-xs">Bass Clef</span>
                <div class="relative rounded-md bg-muted/30 px-4 py-3">
                    @* Staff lines *@
                    <div class="relative h-[50px] w-full">
                        @for (int i = 0; i < StaffLineCount; i++)
                        {
                            var topPx = i * StaffLineSpacing + 5;
                            <div class="absolute left-0 right-0 h-px bg-muted-foreground/20"
                                 style="@($"top:{topPx}px;")"></div>
                        }
                    </div>
                    @* Clef symbol *@
                    <div class="absolute top-0 left-2 font-serif text-2xl text-muted-foreground/40">
                        &#119074;
                    </div>
                    @* Simplified bass notes *@
                    @foreach (var bn in _bassNotes)
                    {
                        var bassNote = bn;
                        var topBass = bassNote.Line * StaffLineSpacing + 2;
                        var fillBass = bassNote.Filled ? "bg-foreground" : "border-2 border-foreground bg-card";
                        <div class="absolute" style="@($"top:{topBass}px;left:{bassNote.Offset}%;")">
                            <div class="@($"size-2.5 rounded-full {fillBass}")"></div>
                            <div class="absolute -top-4 left-[9px] h-4 w-px bg-foreground"></div>
                        </div>
                    }
                    @* Measure bars *@
                    @for (int bi = 1; bi <= 4; bi++)
                    {
                        var bassBarLeft = bi * 25;
                        <div class="absolute top-[5px] h-[40px] w-px bg-muted-foreground/20"
                             style="@($"left:{bassBarLeft}%;")"></div>
                    }
                </div>
            </div>
        </div>

        @* Zoom controls *@
        <div class="flex items-center justify-between border-b px-4 py-2">
            <div class="flex items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0"
                          OnClick="@(() => _zoom = Math.Max(50, _zoom - 10))"
                          aria-label="Zoom out">
                    <LucideIconCn Name="zoom-out" Size="14" Class="size-3.5" />
                </ButtonCn>
                <span class="w-10 text-center text-muted-foreground text-xs tabular-nums">@_zoom%</span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0"
                          OnClick="@(() => _zoom = Math.Min(200, _zoom + 10))"
                          aria-label="Zoom in">
                    <LucideIconCn Name="zoom-in" Size="14" Class="size-3.5" />
                </ButtonCn>
            </div>

            @* Page navigation *@
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-7 p-0"
                          OnClick="@(() => _currentPage = Math.Max(1, _currentPage - 1))"
                          aria-label="Previous page">
                    <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                </ButtonCn>
                <span class="text-sm tabular-nums">
                    @_currentPage <span class="text-muted-foreground text-xs">/ @TotalPages</span>
                </span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-7 p-0"
                          OnClick="@(() => _currentPage = Math.Min(TotalPages, _currentPage + 1))"
                          aria-label="Next page">
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                @_instrument &middot; @KeySignature &middot; @TimeSignature at @Tempo BPM
            </p>
        </div>

    </div>
</section>

@code {
    private const int StaffLineCount = 5;
    private const int StaffLineSpacing = 10;
    private const string KeySignature = "C Major";
    private const string TimeSignature = "4/4";
    private const int Tempo = 120;
    private const int TotalPages = 8;

    private static readonly string[] _instruments = ["Piano", "Violin", "Cello", "Flute", "Clarinet", "Guitar", "Trumpet"];

    private record NotePosition(string Id, int Line, int Offset, string NoteType, bool Filled);
    private record MeasureDef(string Id, NotePosition[] Notes);

    private static readonly MeasureDef[] _measures =
    [
        new("m1", [
            new("n1", 2, 10, "quarter", true),
            new("n2", 3, 28, "quarter", true),
            new("n3", 1, 46, "half",    false),
            new("n4", 4, 72, "quarter", true),
        ]),
        new("m2", [
            new("n5", 0, 10, "quarter", true),
            new("n6", 2, 28, "eighth",  true),
            new("n7", 3, 40, "eighth",  true),
            new("n8", 1, 58, "half",    false),
        ]),
        new("m3", [
            new("n9", 4, 10, "whole", false),
        ]),
        new("m4", [
            new("n13", 3, 10, "quarter", true),
            new("n14", 2, 28, "quarter", true),
            new("n15", 1, 46, "quarter", true),
            new("n16", 0, 64, "quarter", true),
        ]),
    ];

    private record BassNote(string Id, int Line, int Offset, bool Filled);

    private static readonly BassNote[] _bassNotes =
    [
        new("b1", 3, 14, true),
        new("b2", 4, 38, false),
        new("b3", 2, 56, true),
        new("b4", 3, 78, true),
    ];

    private int _currentPage = 1;
    private string _instrument = "Piano";
    private int _zoom = 100;
}
