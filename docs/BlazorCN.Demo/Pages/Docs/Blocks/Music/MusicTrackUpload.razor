@* ============================================================
   Block: music-track-upload
   Title: MusicTrackUpload
   Description: A music track upload block for React and Next.js with drag-and-drop file dropzone, metadata fields for title artist album genre and year, cover art upload, and publish button with progress state built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-track-upload.tsx
   ============================================================ *@

@implements IDisposable

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="upload" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Upload Track</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Upload your audio file, add metadata, and publish to stores.
            </p>
        </div>

        @* Audio file dropzone *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Audio file</span>
            @if (_trackFileName is not null)
            {
                <div class="flex items-center gap-3 rounded-md bg-muted/50 p-3">
                    <LucideIconCn Name="music" Size="16" Class="size-4 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <p class="truncate font-medium text-sm">@_trackFileName</p>
                        <p class="text-muted-foreground text-xs">@_trackFileSize</p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 p-0" OnClick="ClearTrack">
                        <LucideIconCn Name="x" Size="12" Class="size-3" />
                    </ButtonCn>
                </div>
            }
            else
            {
                <div class="flex cursor-pointer flex-col items-center gap-2 rounded-lg border-2 border-dashed border-muted-foreground/25 p-6 transition-colors hover:border-muted-foreground/40">
                    <LucideIconCn Name="upload" Size="20" Class="size-5 text-muted-foreground" />
                    <p class="text-muted-foreground text-sm">
                        Drop audio file here or click to browse
                    </p>
                    <p class="text-muted-foreground/60 text-xs">
                        WAV, MP3, FLAC, or AIFF up to 100 MB
                    </p>
                </div>
            }
        </div>

        @* Metadata fields *@
        <div class="space-y-3 border-b px-4 py-3">
            <span class="block font-medium text-muted-foreground text-xs">Track details</span>
            <div class="space-y-2">
                <InputCn @bind-Value="_title" Placeholder="Track title" Class="h-8 text-sm" />
                <InputCn @bind-Value="_artist" Placeholder="Artist name" Class="h-8 text-sm" />
                <InputCn @bind-Value="_album" Placeholder="Album name (optional)" Class="h-8 text-sm" />
                <div class="grid grid-cols-2 gap-2">
                    <SelectCn Value="@_genre" ValueChanged="@((string v) => _genre = v)">
                        <SelectTriggerCn Class="h-8 text-sm">
                            <SelectValueCn Placeholder="Genre" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var g in _genres)
                            {
                                var genre = g;
                                <SelectItemCn Value="@genre">@genre</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                    <SelectCn Value="@_year" ValueChanged="@((string v) => _year = v)">
                        <SelectTriggerCn Class="h-8 text-sm">
                            <SelectValueCn Placeholder="Year" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var y in _years)
                            {
                                var yr = y;
                                <SelectItemCn Value="@yr">@yr</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>
        </div>

        @* Cover art *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Cover art</span>
            <div class="flex items-start gap-3">
                <div class="@Cn.Merge("flex size-20 shrink-0 cursor-pointer items-center justify-center overflow-hidden rounded-md border-2 border-dashed transition-colors", _hasCoverArt ? "border-transparent" : "border-muted-foreground/25 hover:border-muted-foreground/40")">
                    @if (_hasCoverArt)
                    {
                        <div class="size-full bg-muted flex items-center justify-center">
                            <LucideIconCn Name="image" Size="20" Class="size-5 text-muted-foreground" />
                        </div>
                    }
                    else
                    {
                        <LucideIconCn Name="image" Size="20" Class="size-5 text-muted-foreground" />
                    }
                </div>
                <div class="flex-1 pt-1">
                    <p class="text-sm">@(_hasCoverArt ? "Cover art uploaded" : "Add cover artwork")</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        PNG, JPG, or WebP. Min 3000x3000px recommended.
                    </p>
                    @if (_hasCoverArt)
                    {
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="mt-1 h-6 gap-1 px-2 text-xs" OnClick="ClearCoverArt">
                            <LucideIconCn Name="x" Size="12" Class="size-3" />
                            Remove
                        </ButtonCn>
                    }
                </div>
            </div>
        </div>

        @* Publish button *@
        <div class="border-b px-4 py-3">
            @if (_published)
            {
                <div class="flex items-center justify-center gap-2 py-1">
                    <span class="flex size-5 items-center justify-center rounded-full bg-emerald-500/10">
                        <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                    </span>
                    <span class="font-medium text-sm">Track published successfully</span>
                </div>
            }
            else
            {
                <div>
                    @if (_publishing)
                    {
                        <div class="mb-2">
                            <div class="mb-1 flex items-center justify-between">
                                <span class="text-muted-foreground text-xs">Uploading...</span>
                                <span class="font-medium text-xs tabular-nums">@_progress%</span>
                            </div>
                            <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                                <div class="h-full rounded-full bg-foreground transition-all duration-200 ease-out"
                                     style="@($"width:{_progress}%")"></div>
                            </div>
                        </div>
                    }
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs" Disabled="@_publishing" OnClick="HandlePublish">
                        @if (_publishing)
                        {
                            <LucideIconCn Name="loader-2" Size="12" Class="size-3 animate-spin" />
                            <span>Publishing...</span>
                        }
                        else
                        {
                            <span>Publish Track</span>
                        }
                    </ButtonCn>
                </div>
            }
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Audio will be processed and available within 24 hours
            </p>
        </div>

    </div>
</section>

@code {
    private static readonly string[] _genres =
    [
        "Pop", "Rock", "Hip-Hop", "R&B", "Electronic", "Jazz",
        "Classical", "Country", "Latin", "Indie", "Metal", "Folk",
    ];

    private static readonly string[] _years =
    [
        "2026", "2025", "2024", "2023", "2022", "2021", "2020",
    ];

    private string? _trackFileName = null;
    private string? _trackFileSize = null;
    private bool    _hasCoverArt   = false;
    private string  _title         = "";
    private string  _artist        = "";
    private string  _album         = "";
    private string  _genre         = "";
    private string  _year          = "";
    private bool    _publishing    = false;
    private bool    _published     = false;
    private int     _progress      = 0;

    private System.Timers.Timer? _timer;

    private void ClearTrack()
    {
        _trackFileName = null;
        _trackFileSize = null;
    }

    private void ClearCoverArt()
    {
        _hasCoverArt = false;
    }

    private void HandlePublish()
    {
        _publishing = true;
        _progress   = 0;
        _timer      = new System.Timers.Timer(200);
        _timer.Elapsed += async (_, _) =>
        {
            _progress += 10;
            if (_progress >= 100)
            {
                _progress  = 100;
                _timer?.Stop();
                _timer?.Dispose();
                _timer     = null;
                _publishing = false;
                _published  = true;
            }
            await InvokeAsync(StateHasChanged);
        };
        _timer.AutoReset = true;
        _timer.Start();
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
        _timer = null;
    }
}
