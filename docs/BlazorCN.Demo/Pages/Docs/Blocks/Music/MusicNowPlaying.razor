@* ============================================================
   Block: music-now-playing
   Title: MusicNowPlaying
   Description: A now playing music player block for React and Next.js with album art, animated progress bar, play/pause/skip controls, volume slider, and shuffle/repeat toggles built with shadcn/ui and Tailwind CSS
   Source: original/blocks/music/music-now-playing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Album art + track info *@
        <div class="flex items-center gap-4 border-b px-4 py-3">

            @* Album art placeholder with waveform *@
            <div class="@Cn.Merge("relative flex size-16 shrink-0 items-center justify-center rounded-md", _currentTrack.Color)">
                <div class="flex items-end gap-0.5">
                    @foreach (var bar in _waveformBars)
                    {
                        <div class="w-1 rounded-full bg-foreground/60" style="@($"height:{(_isPlaying ? (int)(bar * 20) : 4)}px")"></div>
                    }
                </div>
            </div>

            <div class="min-w-0 flex-1">
                <p class="truncate font-medium text-sm">@_currentTrack.Title</p>
                <p class="mt-0.5 truncate text-muted-foreground text-xs">@_currentTrack.Artist</p>
                <p class="mt-0.5 truncate text-muted-foreground text-xs">@_currentTrack.Album</p>
            </div>
        </div>

        @* Progress bar *@
        <div class="border-b px-4 py-3">
            <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-foreground" style="@($"width:{_progressPercent}%")"></div>
            </div>
            <div class="mt-1.5 flex items-center justify-between">
                <span class="font-mono text-muted-foreground text-xs">@_currentTime</span>
                <span class="font-mono text-muted-foreground text-xs">@_currentTrack.Duration</span>
            </div>
        </div>

        @* Playback controls *@
        <div class="flex items-center justify-center gap-2 border-b px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                      Class="@Cn.Merge("size-7 p-0", _shuffle ? "text-foreground" : "text-muted-foreground")"
                      OnClick="@(() => _shuffle = !_shuffle)"
                      aria-label="Toggle shuffle">
                <LucideIconCn Name="shuffle" Size="14" Class="size-3.5" />
            </ButtonCn>

            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-8 p-0" aria-label="Previous track">
                <LucideIconCn Name="skip-back" Size="16" Class="size-4" />
            </ButtonCn>

            <ButtonCn Size="ButtonSize.Sm" Class="size-9 rounded-full p-0"
                      OnClick="@(() => _isPlaying = !_isPlaying)"
                      aria-label="@(_isPlaying ? "Pause" : "Play")">
                @if (_isPlaying)
                {
                    <LucideIconCn Name="pause" Size="16" Class="size-4" />
                }
                else
                {
                    <LucideIconCn Name="play" Size="16" Class="size-4" />
                }
            </ButtonCn>

            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-8 p-0" aria-label="Next track">
                <LucideIconCn Name="skip-forward" Size="16" Class="size-4" />
            </ButtonCn>

            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                      Class="@Cn.Merge("size-7 p-0", _repeat ? "text-foreground" : "text-muted-foreground")"
                      OnClick="@(() => _repeat = !_repeat)"
                      aria-label="Toggle repeat">
                <LucideIconCn Name="repeat" Size="14" Class="size-3.5" />
            </ButtonCn>
        </div>

        @* Volume control *@
        <div class="flex items-center gap-3 px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 shrink-0 p-0 text-muted-foreground"
                      OnClick="@(() => _isMuted = !_isMuted)"
                      aria-label="@(_isMuted ? "Unmute" : "Mute")">
                @if (_isMuted)
                {
                    <LucideIconCn Name="volume-x" Size="14" Class="size-3.5" />
                }
                else
                {
                    <LucideIconCn Name="volume-2" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
            <SliderCn Value="@((double)(_isMuted ? 0 : _volume))"
                      ValueChanged="@((double v) => { _volume = (int)v; if (_isMuted) _isMuted = false; })"
                      Max="100"
                      Step="1"
                      Class="flex-1"
                      aria-label="Volume" />
            <span class="w-7 text-right font-mono text-muted-foreground text-xs tabular-nums">
                @(_isMuted ? 0 : _volume)
            </span>
        </div>

    </div>
</section>

@code {
    private record TrackInfo(string Title, string Artist, string Album, string Duration, string Color);

    private static readonly TrackInfo _currentTrack = new(
        Title: "Midnight Horizon",
        Artist: "Luna Waves",
        Album: "Echoes of Tomorrow",
        Duration: "4:23",
        Color: "bg-indigo-500/20"
    );

    private static readonly double[] _waveformBars = [0.4, 0.7, 0.5, 0.9, 0.6];

    private static readonly int _progressPercent = 42;
    private static readonly string _currentTime = "1:51";

    private bool _isPlaying = true;
    private int _volume = 72;
    private bool _isMuted = false;
    private bool _shuffle = false;
    private bool _repeat = false;
}
