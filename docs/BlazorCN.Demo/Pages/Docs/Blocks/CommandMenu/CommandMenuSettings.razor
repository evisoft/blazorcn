@* ============================================================
   Block: command-menu-settings
   Title: Command Menu Settings
   Description: A command menu with inline toggle controls for quick settings adjustments
   Dependencies: ButtonCn, CommandCn, KbdCn, SwitchCn
   Source: original/blocks/command-menu/command-menu-settings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" class="gap-2">
            <LucideSlidersHorizontalCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Quick Settings</span>
            <KbdCn>@@,</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Command Menu</DialogTitleCn>
                <DialogDescriptionCn>Search and navigate.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
        <CommandInputCn Placeholder="Search settings..." />
        <CommandListCn>
            <CommandEmptyCn>No settings found.</CommandEmptyCn>

            <CommandGroupCn Heading="Appearance">
                @foreach (var setting in _appearance)
                {
                    <CommandItemCn class="gap-3">
                        <LucidePaletteCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <div class="text-sm font-medium">@setting.Title</div>
                            <p class="text-xs text-muted-foreground">@setting.Description</p>
                        </div>
                        <SwitchCn Checked="@setting.Enabled" />
                    </CommandItemCn>
                }
            </CommandGroupCn>

            <CommandGroupCn Heading="Notifications">
                @foreach (var setting in _notifications)
                {
                    <CommandItemCn class="gap-3">
                        <LucideBellCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <div class="text-sm font-medium">@setting.Title</div>
                            <p class="text-xs text-muted-foreground">@setting.Description</p>
                        </div>
                        <SwitchCn Checked="@setting.Enabled" />
                    </CommandItemCn>
                }
            </CommandGroupCn>

            <CommandGroupCn Heading="Privacy">
                @foreach (var setting in _privacy)
                {
                    <CommandItemCn class="gap-3">
                        <LucideShieldCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <div class="text-sm font-medium">@setting.Title</div>
                            <p class="text-xs text-muted-foreground">@setting.Description</p>
                        </div>
                        <SwitchCn Checked="@setting.Enabled" />
                    </CommandItemCn>
                }
            </CommandGroupCn>
        </CommandListCn>

        <div class="border-t px-3 py-2">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <LucideSettingsCn Size="12" Class="size-3" />
                <span>Changes are saved automatically</span>
            </div>
        </div>
    </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record SettingItem(string Title, string Description, bool Enabled);

    private static readonly SettingItem[] _appearance =
    [
        new("Dark mode", "Use dark color scheme", true),
        new("Reduced motion", "Minimize animations and transitions", false),
        new("Compact mode", "Reduce spacing between elements", false),
    ];

    private static readonly SettingItem[] _notifications =
    [
        new("Email notifications", "Receive updates via email", true),
        new("Push notifications", "Browser push notifications", true),
        new("Sound alerts", "Play sound on new notifications", false),
    ];

    private static readonly SettingItem[] _privacy =
    [
        new("Analytics", "Help improve the product with usage data", true),
        new("Crash reports", "Automatically send crash reports", true),
        new("Profile visibility", "Allow others to see your profile", false),
    ];
}
