@* ============================================================
   Block: command-menu-domains
   Title: CommandMenuDomains
   Description: Domain management command menu with DNS status, SSL checks, and domain actions for React hosting dashboards
   Source: original/blocks/command-menu/command-menu-domains.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" Class="gap-2">
            <LucideGlobeCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Domains</span>
            <KbdCn>@@D</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Domains</DialogTitleCn>
                <DialogDescriptionCn>Domain management command menu with DNS status, SSL checks, and domain actions for React hosting dashboards</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search domains..." />
                <CommandListCn>
                    <CommandEmptyCn>No domains found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Domains">
                        @foreach (var dom in _domains)
                        {
                            var domain = dom;
                            var config = _statusConfig[domain.Status];
                            <CommandItemCn @onclick="() => _open = false" Class="gap-3">
                                <LucideGlobeCn Size="16" Class="size-4 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="font-mono text-sm font-medium">@domain.Name</span>
                                        @if (domain.Primary)
                                        {
                                            <span class="rounded bg-muted/50 px-1.5 py-0.5 text-xs text-muted-foreground">
                                                Primary
                                            </span>
                                        }
                                    </div>
                                </div>
                                @if (domain.Ssl)
                                {
                                    <LucideLockCn Size="14" Class="size-3.5 text-emerald-500" />
                                }
                                else
                                {
                                    <LucideShieldAlertCn Size="14" Class="size-3.5 text-amber-500" />
                                }
                                <span class="@($"size-1.5 rounded-full {config.BgColor}")"></span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn @onclick="() => _open = false" Class="gap-3">
                            <LucidePlusCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Add Domain</span>
                        </CommandItemCn>
                        <CommandItemCn @onclick="() => _open = false" Class="gap-3">
                            <LucideRefreshCwCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Check DNS Propagation</span>
                        </CommandItemCn>
                        <CommandItemCn @onclick="() => _open = false" Class="gap-3">
                            <LucideLockCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Renew SSL Certificates</span>
                        </CommandItemCn>
                        <CommandItemCn @onclick="() => _open = false" Class="gap-3">
                            <LucideLinkCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Manage Redirects</span>
                        </CommandItemCn>
                        <CommandItemCn @onclick="() => _open = false" Class="gap-3">
                            <LucideSettingsCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">DNS Settings</span>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideCheckCircle2Cn Size="12" Class="size-3" />
                        <span>@(_domains.Count(d => d.Status == "active")) active &middot; @(_domains.Count(d => d.Ssl)) SSL</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record DomainItem(string Id, string Name, string Status, bool Ssl, bool Primary);

    private record StatusConfig(string BgColor);

    private static readonly DomainItem[] _domains =
    [
        new("1", "acme.com", "active", true, true),
        new("2", "www.acme.com", "active", true, false),
        new("3", "app.acme.com", "active", true, false),
        new("4", "staging.acme.com", "active", true, false),
        new("5", "new-brand.io", "pending", false, false),
    ];

    private static readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["active"] = new StatusConfig("bg-emerald-500"),
        ["pending"] = new StatusConfig("bg-amber-500"),
        ["error"] = new StatusConfig("bg-red-500"),
    };
}
