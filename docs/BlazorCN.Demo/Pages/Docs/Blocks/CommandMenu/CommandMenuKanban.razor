@* ============================================================
   Block: command-menu-kanban
   Title: Command Menu Kanban
   Description: A kanban board command palette for moving cards, creating tasks, filtering by label, and sorting by priority with column item counts
   Long Description: A kanban-focused command menu that streamlines board management with keyboard shortcuts. Move cards between columns (Backlog, Todo, In Progress, Done), create new cards with inline input, filter by label, and sort by priority. Shows live item counts per column. Perfect for project management tools, issue trackers, and agile workflows.
   Dependencies: BadgeCn, ButtonCn, CommandCn, DialogCn, InputCn, KbdCn
   Source: original/blocks/command-menu/command-menu-kanban.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" @onclick="() => _open = true">
            <LucideSearchCn Size="16" Class="mr-2 h-4 w-4" />
            <span>Command Menu Kanban</span>
            <KbdCn class="ml-2">@@K</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Command Menu Kanban</DialogTitleCn>
                <DialogDescriptionCn>A kanban board command palette for moving cards, creating tasks, filtering by label, and sorting by priority with column item counts</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Type a command or search..." />
                <CommandListCn>
                    <CommandEmptyCn>No results found.</CommandEmptyCn>
                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn>
                            <LucideSearchCn Size="16" Class="mr-2 h-4 w-4 text-muted-foreground" />
                            <span>Search...</span>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
}
