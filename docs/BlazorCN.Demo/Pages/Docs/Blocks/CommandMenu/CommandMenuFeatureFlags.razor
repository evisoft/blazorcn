@* ============================================================
   Block: command-menu-feature-flags
   Title: CommandMenuFeatureFlags
   Description: Feature flag toggle command menu with rollout percentages and environment targeting for React feature management
   Source: original/blocks/command-menu/command-menu-feature-flags.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" Class="gap-2">
            <LucideFlagCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Feature Flags</span>
            <KbdCn>⌘F</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Command Menu</DialogTitleCn>
                <DialogDescriptionCn>Search and navigate.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search feature flags..." />
                <CommandListCn>
                    <CommandEmptyCn>No feature flags found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Feature Flags">
                        @foreach (var flag in _flags)
                        {
                            var currentFlag = flag;
                            <CommandItemCn class="gap-3">
                                <LucideFlagCn Size="16" Class="@Cn.Merge("size-4", currentFlag.Enabled ? "text-emerald-500" : "text-muted-foreground")" />
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@currentFlag.Name</div>
                                    <p class="text-xs text-muted-foreground">@currentFlag.Description</p>
                                </div>
                                <div class="flex items-center gap-3">
                                    @if (currentFlag.Enabled)
                                    {
                                        <div class="flex items-center gap-1 text-xs text-muted-foreground">
                                            <LucidePercentCn Size="12" Class="size-3" />
                                            <span class="tabular-nums">@currentFlag.Rollout%</span>
                                        </div>
                                    }
                                    <div class="flex items-center gap-1 text-xs text-muted-foreground">
                                        <LucideUsersCn Size="12" Class="size-3" />
                                        <span>@currentFlag.Targeting</span>
                                    </div>
                                    <SwitchCn Checked="@currentFlag.Enabled" CheckedChanged="@((val) => ToggleFlag(currentFlag.Id, val))" />
                                </div>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideToggleLeftCn Size="12" Class="size-3" />
                        <span>@_enabledCount of @_flags.Count flags enabled</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record FeatureFlag(string Id, string Name, string Description, bool Enabled, int Rollout, string Targeting);

    private List<FeatureFlag> _flags =
    [
        new("new-dashboard", "New Dashboard", "Redesigned analytics dashboard", true, 100, "All users"),
        new("ai-assist", "AI Assistant", "AI-powered writing suggestions", true, 50, "Pro users"),
        new("dark-mode-v2", "Dark Mode v2", "Updated dark theme colors", false, 0, "Beta testers"),
        new("real-time-collab", "Real-time Collaboration", "Live cursors and editing", true, 25, "Team plans"),
        new("export-pdf", "PDF Export", "Export reports as PDF files", false, 0, "Enterprise"),
        new("webhooks-v2", "Webhooks v2", "Webhook retry with exponential backoff", true, 75, "All users"),
        new("custom-fields", "Custom Fields", "User-defined data fields", false, 0, "Beta testers"),
    ];

    private int _enabledCount => _flags.Count(f => f.Enabled);

    private void ToggleFlag(string id, bool val)
    {
        var idx = _flags.FindIndex(f => f.Id == id);
        if (idx >= 0)
        {
            var f = _flags[idx];
            _flags[idx] = f with { Enabled = val };
        }
    }
}
