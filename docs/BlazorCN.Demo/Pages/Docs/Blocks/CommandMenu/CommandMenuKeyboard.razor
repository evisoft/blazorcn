                                <p class="text-xs text-muted-foreground">Paste from clipboard</p>
                            </div>
                            <div class="flex items-center gap-0.5">
                                <KbdCn>@@</KbdCn>
                                <KbdCn>V</KbdCn>
                            </div>
                        </CommandItemCn>
                        <CommandItemCn Class="gap-3">
                            <LucidePenToolCn Size="16" Class="size-4 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium">Duplicate line</span>
                                <p class="text-xs text-muted-foreground">Duplicate current line</p>
                            </div>
                            <div class="flex items-center gap-0.5">
                                <KbdCn>@@</KbdCn>
                                <KbdCn>&#x21E7;</KbdCn>
                                <KbdCn>D</KbdCn>
                            </div>
                        </CommandItemCn>
                    </CommandGroupCn>

                    <CommandSeparatorCn />

