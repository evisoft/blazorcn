                                <span class="text-sm font-medium">Go to line</span>
                                <p class="text-xs text-muted-foreground">Jump to line number</p>
                            </div>
                            <div class="flex items-center gap-0.5">
                                <KbdCn>@@</KbdCn>
                                <KbdCn>G</KbdCn>
                            </div>
                        </CommandItemCn>
                        <CommandItemCn Class="gap-3">
                            <LucideNavigationCn Size="16" Class="size-4 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium">Go to file</span>
                                <p class="text-xs text-muted-foreground">Quick open file</p>
                            </div>
                            <div class="flex items-center gap-0.5">
                                <KbdCn>@@</KbdCn>
                                <KbdCn>P</KbdCn>
                            </div>
                        </CommandItemCn>
                        <CommandItemCn Class="gap-3">
                            <LucideNavigationCn Size="16" Class="size-4 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium">Go to symbol</span>
                                <p class="text-xs text-muted-foreground">Navigate to symbol</p>
                            </div>
                            <div class="flex items-center gap-0.5">
                                <KbdCn>@@</KbdCn>
                                <KbdCn>&#x21E7;</KbdCn>
