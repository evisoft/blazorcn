                        <CommandItemCn Class="gap-3">
                            <LucidePenToolCn Size="16" Class="size-4 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium">Undo</span>
                                <p class="text-xs text-muted-foreground">Undo last change</p>
                            </div>
                            <div class="flex items-center gap-0.5">
                                <KbdCn>@@</KbdCn>
                                <KbdCn>Z</KbdCn>
                            </div>
                        </CommandItemCn>
                        <CommandItemCn Class="gap-3">
                            <LucidePenToolCn Size="16" Class="size-4 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium">Redo</span>
                                <p class="text-xs text-muted-foreground">Redo last change</p>
                            </div>
                            <div class="flex items-center gap-0.5">
                                <KbdCn>@@</KbdCn>
                                <KbdCn>&#x21E7;</KbdCn>
                                <KbdCn>Z</KbdCn>
                            </div>
                        </CommandItemCn>
                        <CommandItemCn Class="gap-3">
                            <LucidePenToolCn Size="16" Class="size-4 text-muted-foreground" />
