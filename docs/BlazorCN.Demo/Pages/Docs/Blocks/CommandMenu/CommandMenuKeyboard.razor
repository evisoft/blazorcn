@* ============================================================
   Block: command-menu-keyboard
   Title: CommandMenuKeyboard
   Description: Keyboard shortcut reference command menu with categorized bindings and search for React apps
   Source: original/blocks/command-menu/command-menu-keyboard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" @onclick="() => _open = true">
            <LucideKeyboardCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Keyboard Shortcuts</span>
            <KbdCn>@@/</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Keyboard Shortcuts</DialogTitleCn>
                <DialogDescriptionCn>Keyboard shortcut reference command menu with categorized bindings and search for React apps</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search shortcuts..." />
                <CommandListCn>
                    <CommandEmptyCn>No shortcuts found.</CommandEmptyCn>

                    @* General *@
                    <CommandGroupCn Heading="General">
                        <CommandItemCn Class="gap-3">
                            <LucideKeyboardCn Size="16" Class="size-4 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium">Command palette</span>
                                <p class="text-xs text-muted-foreground">Open command menu</p>
                            </div>
                            <div class="flex items-center gap-0.5">
                                <KbdCn>@@</KbdCn>
                                <KbdCn>K</KbdCn>
                            </div>
                        </CommandItemCn>
                        <CommandItemCn Class="gap-3">
                            <LucideKeyboardCn Size="16" Class="size-4 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium">Search</span>
                                <p class="text-xs text-muted-foreground">Find in document</p>
                            </div>
                            <div class="flex items-center gap-0.5">
                                <KbdCn>@@</KbdCn>
                                <KbdCn>F</KbdCn>
                            </div>
                        </CommandItemCn>
                        <CommandItemCn Class="gap-3">
                            <LucideKeyboardCn Size="16" Class="size-4 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium">Settings</span>
                                <p class="text-xs text-muted-foreground">Open preferences</p>
                            </div>
                            <div class="flex items-center gap-0.5">
                                <KbdCn>@@</KbdCn>
                                <KbdCn>,</KbdCn>
                            </div>
                        </CommandItemCn>
                        <CommandItemCn Class="gap-3">
                            <LucideKeyboardCn Size="16" Class="size-4 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium">Help</span>
                                <p class="text-xs text-muted-foreground">Show help</p>
                            </div>
                            <div class="flex items-center gap-0.5">
                                <KbdCn>@@</KbdCn>
                                <KbdCn>?</KbdCn>
                            </div>
                        </CommandItemCn>
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    @* File Operations *@
                    <CommandGroupCn Heading="File Operations">
                        <CommandItemCn Class="gap-3">
                            <LucideFileCn Size="16" Class="size-4 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium">New file</span>
                                <p class="text-xs text-muted-foreground">Create new file</p>
                            </div>
                            <div class="flex items-center gap-0.5">
                                <KbdCn>@@</KbdCn>
                                <KbdCn>N</KbdCn>
                            </div>
                        </CommandItemCn>
                        <CommandItemCn Class="gap-3">
                            <LucideFileCn Size="16" Class="size-4 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium">Open file</span>
                                <p class="text-xs text-muted-foreground">Open existing file</p>
                            </div>
                            <div class="flex items-center gap-0.5">
                                <KbdCn>@@</KbdCn>
                                <KbdCn>O</KbdCn>
                            </div>
                        </CommandItemCn>
                        <CommandItemCn Class="gap-3">
                            <LucideFileCn Size="16" Class="size-4 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium">Save</span>
                                <p class="text-xs text-muted-foreground">Save current file</p>
                            </div>
                            <div class="flex items-center gap-0.5">
                                <KbdCn>@@</KbdCn>
                                <KbdCn>S</KbdCn>
                            </div>
                        </CommandItemCn>
                        <CommandItemCn Class="gap-3">
                            <LucideFileCn Size="16" Class="size-4 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium">Save all</span>
                                <p class="text-xs text-muted-foreground">Save all open files</p>
                            </div>
                            <div class="flex items-center gap-0.5">
                                <KbdCn>@@</KbdCn>
                                <KbdCn>&#x21E7;</KbdCn>
                                <KbdCn>S</KbdCn>
                            </div>
                        </CommandItemCn>
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    @* Editing *@
