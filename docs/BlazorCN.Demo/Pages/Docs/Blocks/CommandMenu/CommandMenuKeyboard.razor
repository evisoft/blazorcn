                        <CommandItemCn Class="gap-3">
                            <LucideCodeCn Size="16" Class="size-4 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium">Toggle comment</span>
                                <p class="text-xs text-muted-foreground">Comment selection</p>
                            </div>
                            <div class="flex items-center gap-0.5">
                                <KbdCn>@@</KbdCn>
                                <KbdCn>/</KbdCn>
                            </div>
                        </CommandItemCn>
                        <CommandItemCn Class="gap-3">
                            <LucideCodeCn Size="16" Class="size-4 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium">Refactor</span>
                                <p class="text-xs text-muted-foreground">Rename symbol</p>
