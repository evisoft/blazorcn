@* ============================================================
   Block: command-menu-dashboard
   Title: CommandMenuDashboard
   Description: Dashboard widget manager command menu with add, remove, and rearrange controls for React dashboard apps
   Source: original/blocks/command-menu/command-menu-dashboard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" class="gap-2">
            <LucideGrid3X3Cn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Manage Widgets</span>
            <KbdCn>&#x2318;W</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Command Menu</DialogTitleCn>
                <DialogDescriptionCn>Manage your dashboard widgets.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search widgets..." />
                <CommandListCn>
                    <CommandEmptyCn>No widgets found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Active Widgets">
                        @foreach (var w in _widgets.Where(x => x.Enabled))
                        {
                            var widget = w;
                            <CommandItemCn Class="gap-3" @onclick="@(() => ToggleWidget(widget.Id))">
                                <LucideIconCn Name="@widget.Icon" Size="16" Class="size-4 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@widget.Name</div>
                                    <p class="text-xs text-muted-foreground">@widget.Description</p>
                                </div>
                                <LucideCheckCn Size="16" Class="size-4 text-emerald-500" />
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Available Widgets">
                        @foreach (var w in _widgets.Where(x => !x.Enabled))
                        {
                            var widget = w;
                            <CommandItemCn Class="gap-3" @onclick="@(() => ToggleWidget(widget.Id))">
                                <LucideIconCn Name="@widget.Icon" Size="16" Class="size-4 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@widget.Name</div>
                                    <p class="text-xs text-muted-foreground">@widget.Description</p>
                                </div>
                                <LucidePlusCn Size="16" Class="size-4 text-muted-foreground" />
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideGrid3X3Cn Size="12" Class="size-3" />
                        <span>@(_widgets.Count(x => x.Enabled)) of @_widgets.Count widgets active</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record WidgetItem(string Id, string Name, string Description, string Icon, bool Enabled)
    {
        public bool Enabled { get; set; } = Enabled;
    }

    private List<WidgetItem> _widgets =
    [
        new("revenue",   "Revenue Chart",   "Monthly revenue trends",         "trending-up", true),
        new("users",     "Active Users",    "Real-time user count",            "users",       true),
        new("metrics",   "Key Metrics",     "KPI summary cards",               "gauge",       true),
        new("bar-chart", "Bar Chart",       "Category comparisons",            "bar-chart-3", false),
        new("pie-chart", "Pie Chart",       "Distribution breakdown",          "pie-chart",   false),
        new("table",     "Data Table",      "Recent transactions",             "table",       true),
        new("map",       "Geo Map",         "User distribution by region",     "map",         false),
        new("activity",  "Activity Feed",   "Recent team activity",            "list",        true),
        new("uptime",    "Uptime Monitor",  "Service health status",           "clock",       false),
    ];

    private void ToggleWidget(string id)
    {
        var widget = _widgets.FirstOrDefault(w => w.Id == id);
        if (widget is not null)
        {
            widget.Enabled = !widget.Enabled;
        }
    }
}
