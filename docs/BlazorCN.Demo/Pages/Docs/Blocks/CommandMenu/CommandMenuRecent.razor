@* ============================================================
   Block: command-menu-recent
   Title: CommandMenuRecent
   Description: Recent items browser command menu with time grouping, item types, and quick actions for React apps
   Source: original/blocks/command-menu/command-menu-recent.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" @onclick="() => _open = true">
            <LucideClockCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Recent</span>
            <KbdCn>@("⌘")R</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Recent Items</DialogTitleCn>
                <DialogDescriptionCn>Recent items browser command menu with time grouping, item types, and quick actions</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search recent items..." />
                <CommandListCn>
                    <CommandEmptyCn>No recent items found.</CommandEmptyCn>

                    @foreach (var grp in _timeGroups)
                    {
                        var groupItems = _recentItems.Where(item => item.TimeGroup == grp).ToArray();
                        if (groupItems.Length == 0) continue;
                        var isFirst = grp == _timeGroups[0];
                        if (!isFirst)
                        {
                            <CommandSeparatorCn />
                        }
                        <CommandGroupCn Heading="@grp">
                            @foreach (var item in groupItems)
                            {
                                var it = item;
                                <CommandItemCn Class="gap-3" OnSelect="@(() => _open = false)">
                                    <LucideIconCn Name="@it.IconName" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                    <div class="min-w-0 flex-1">
                                        <span class="text-sm font-medium">@it.Name</span>
                                        <p class="text-xs text-muted-foreground font-mono">@it.Path</p>
                                    </div>
                                    <span class="shrink-0 text-xs text-muted-foreground">@it.Time</span>
                                </CommandItemCn>
                            }
                        </CommandGroupCn>
                    }

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn Class="gap-3">
                            <LucidePinCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Pin to quick access</span>
                            <KbdCn class="ml-auto">@("⌘")P</KbdCn>
                        </CommandItemCn>
                        <CommandItemCn Class="gap-3">
                            <LucideTrash2Cn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Clear recent items</span>
                            <KbdCn class="ml-auto">@("⌘")@("⌫")</KbdCn>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideClockCn Size="12" Class="size-3" />
                        <span>@_recentItems.Length recent items</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private static readonly string[] _timeGroups = ["Today", "Yesterday", "This Week", "Last Week"];

    private record RecentItem(string Id, string Name, string IconName, string Path, string TimeGroup, string Time);

    private static readonly RecentItem[] _recentItems =
    [
        new("1", "Q1 Revenue Report",          "table",          "/reports/q1-revenue",        "Today",     "10 min ago"),
        new("2", "Product Roadmap 2026",        "file-text",      "/docs/roadmap-2026",         "Today",     "45 min ago"),
        new("3", "Brand Guidelines",            "image",          "/design/brand-guidelines",   "Today",     "2 hours ago"),
        new("4", "Team standup notes",          "message-square", "/chats/standup",             "Today",     "3 hours ago"),
        new("5", "Sprint Planning",             "file-text",      "/docs/sprint-planning",      "Yesterday", "Yesterday at 4:30 PM"),
        new("6", "User Analytics Dashboard",    "table",          "/dashboards/user-analytics", "Yesterday", "Yesterday at 11:15 AM"),
        new("7", "Product Demo Video",          "video",          "/media/product-demo",        "Yesterday", "Yesterday at 9:00 AM"),
        new("8", "API Documentation",           "folder",         "/docs/api",                  "This Week", "Monday"),
        new("9", "Onboarding Flow Mockup",      "image",          "/design/onboarding-flow",    "This Week", "Monday"),
        new("10", "Customer Feedback Analysis", "table",          "/reports/feedback",          "Last Week", "Last Friday"),
    ];
}
