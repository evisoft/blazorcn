@* ============================================================
   Block: command-menu-git
   Title: Command Menu Git
   Description: Git actions command menu with branch switching, commit, and common git operations
   Dependencies: BadgeCn, ButtonCn, CommandCn, DialogCn, KbdCn
   Source: original/blocks/command-menu/command-menu-git.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline">
            <LucideGitBranchCn Size="16" Class="mr-2 h-4 w-4" />
            <span>main</span>
            <BadgeCn class="ml-2 text-xs" Variant="BadgeVariant.Outline">
                <LucideArrowUpCn Size="12" Class="mr-0.5 h-3 w-3" />
                2
            </BadgeCn>
            <KbdCn class="ml-2">@@G</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-md" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Git Actions</DialogTitleCn>
                <DialogDescriptionCn>Manage your git repository.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <div class="border-b p-3">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <LucideGitBranchCn Size="16" Class="h-4 w-4 text-primary" />
                            <span class="font-medium">main</span>
                            <BadgeCn class="text-xs" Variant="BadgeVariant.Outline">
                                <LucideArrowUpCn Size="12" Class="mr-0.5 h-3 w-3" />
                                2 ahead
                            </BadgeCn>
                        </div>
                        <KbdCn>@@G</KbdCn>
                    </div>
                    <div class="mt-2 flex items-center gap-3 text-xs text-muted-foreground">
                        <span>4 changed</span>
                        <span>2 staged</span>
                    </div>
                </div>

                <CommandInputCn Placeholder="Search branches or actions..." />

                <CommandListCn class="max-h-[300px]">
                    <CommandEmptyCn>No results found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn>
                            <LucideArrowDownCn Size="16" Class="mr-2 h-4 w-4" />
                            Pull from origin
                            <KbdCn class="ml-auto">@@P</KbdCn>
                        </CommandItemCn>
                        <CommandItemCn>
                            <LucideArrowUpCn Size="16" Class="mr-2 h-4 w-4" />
                            Push to origin
                            <KbdCn class="ml-auto">@@U</KbdCn>
                        </CommandItemCn>
                        <CommandItemCn>
                            <LucideRefreshCwCn Size="16" Class="mr-2 h-4 w-4" />
                            Fetch all remotes
                        </CommandItemCn>
                        <CommandItemCn>
                            <LucideSaveCn Size="16" Class="mr-2 h-4 w-4" />
                            Stash changes
                        </CommandItemCn>
                        <CommandItemCn>
                            <LucideRotateCcwCn Size="16" Class="mr-2 h-4 w-4" />
                            Discard all changes
                        </CommandItemCn>
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Branches">
                        @foreach (var branch in _branches)
                        {
                            <CommandItemCn>
                                <LucideGitBranchCn Size="16" Class="mr-2 h-4 w-4" />
                                <span class="flex-1">@branch.Name</span>
                                @if (branch.IsCurrent)
                                {
                                    <LucideCheckCn Size="16" Class="h-4 w-4 text-primary" />
                                }
                                else if (branch.Ahead > 0)
                                {
                                    <BadgeCn class="text-xs" Variant="BadgeVariant.Outline">
                                        <LucideArrowUpCn Size="12" Class="mr-0.5 h-3 w-3" />
                                        @branch.Ahead
                                    </BadgeCn>
                                }
                            </CommandItemCn>
                        }
                        <CommandItemCn>
                            <LucidePlusCn Size="16" Class="mr-2 h-4 w-4" />
                            Create new branch
                        </CommandItemCn>
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Recent Commits">
                        @foreach (var commit in _recentCommits)
                        {
                            <CommandItemCn>
                                <LucideGitCommitHorizontalCn Size="16" Class="mr-2 h-4 w-4 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <p class="truncate text-sm">@commit.Message</p>
                                    <p class="text-xs text-muted-foreground">@commit.Hash · @commit.Author · @commit.Time</p>
                                </div>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record BranchItem(string Name, bool IsCurrent, int Ahead = 0);
    private record CommitItem(string Message, string Hash, string Author, string Time);

    private static readonly BranchItem[] _branches =
    [
        new("main", true, 2),
        new("feature/auth-v2", false, 5),
        new("fix/memory-leak", false, 1),
        new("develop", false),
        new("staging", false),
    ];

    private static readonly CommitItem[] _recentCommits =
    [
        new("feat: add SSO configuration page", "a1b2c3d", "Sarah", "2h ago"),
        new("fix: resolve WebSocket reconnection", "e4f5g6h", "Marcus", "5h ago"),
        new("chore: update dependencies", "i7j8k9l", "CI Bot", "1d ago"),
        new("docs: add API migration guide", "m0n1o2p", "Elena", "2d ago"),
    ];
}
