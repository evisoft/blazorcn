@* ============================================================
   Block: command-menu-secrets
   Title: CommandMenuSecrets
   Description: Secrets and environment variable manager command menu with masked values, rotation status, and access controls for React DevOps tools
   Source: original/blocks/command-menu/command-menu-secrets.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" Class="gap-2">
            <LucideLockCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Secrets</span>
            <KbdCn>⇧⌘S</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Secrets Manager</DialogTitleCn>
                <DialogDescriptionCn>Search and manage secrets and environment variables.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search secrets..." />
                <CommandListCn>
                    <CommandEmptyCn>No secrets found.</CommandEmptyCn>

                    @for (var i = 0; i < _categories.Length; i++)
                    {
                        var cat = _categories[i];
                        var idx = i;
                        @if (idx > 0)
                        {
                            <CommandSeparatorCn />
                        }
                        <CommandGroupCn Heading="@cat">
                            @foreach (var secret in _secrets.Where(s => s.Category == cat))
                            {
                                var sec = secret;
                                <CommandItemCn class="gap-3" @onclick="@(() => ToggleReveal(sec.Id))">
                                    <LucideKeyCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-2">
                                            <span class="font-mono text-sm font-medium">@sec.Key</span>
                                            <span class="@($"size-1.5 rounded-full {DotColor(sec.RotationStatus)}")" />
                                        </div>
                                        <p class="truncate font-mono text-xs text-muted-foreground">
                                            @(_revealed.Contains(sec.Id) ? sec.MaskedValue : "••••••••••••••••")
                                        </p>
                                    </div>
                                    <div class="flex items-center gap-1">
                                        @if (_revealed.Contains(sec.Id))
                                        {
                                            <LucideEyeOffCn Size="14" Class="size-3.5 text-muted-foreground" />
                                        }
                                        else
                                        {
                                            <LucideEyeCn Size="14" Class="size-3.5 text-muted-foreground" />
                                        }
                                    </div>
                                </CommandItemCn>
                            }
                        </CommandGroupCn>
                    }

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn class="gap-3">
                            <LucidePlusCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Add new secret</span>
                            <KbdCn class="ml-auto">⌘N</KbdCn>
                        </CommandItemCn>
                        <CommandItemCn class="gap-3">
                            <LucideRefreshCwCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Rotate expiring secrets</span>
                            <KbdCn class="ml-auto">⌘R</KbdCn>
                        </CommandItemCn>
                        <CommandItemCn class="gap-3">
                            <LucideClipboardCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Copy as .env format</span>
                            <KbdCn class="ml-auto">⌘C</KbdCn>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-3 text-xs text-muted-foreground">
                        <LucideShieldCn Size="12" Class="size-3" />
                        <span>@_secrets.Length secrets</span>
                        @if (_expiringCount > 0)
                        {
                            <span>&middot;</span>
                            <span class="text-amber-500">@_expiringCount need rotation</span>
                        }
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
    private HashSet<string> _revealed = new();

    private record Secret(string Id, string Key, string MaskedValue, string Environment, string RotationStatus, string LastRotated, string Category);

    private static readonly Secret[] _secrets =
    [
        new("db-url", "DATABASE_URL", "postgres://****:****@db.acme.com:5432/prod", "Production", "current", "14 days ago", "Database"),
        new("redis-url", "REDIS_URL", "redis://****@cache.acme.com:6379", "Production", "current", "14 days ago", "Database"),
        new("stripe-key", "STRIPE_SECRET_KEY", "sk_live_****Xr4f", "Production", "expiring", "85 days ago", "API Keys"),
        new("sendgrid", "SENDGRID_API_KEY", "SG.****q2Wp", "Production", "current", "30 days ago", "API Keys"),
        new("jwt-secret", "JWT_SECRET", "****************************", "All", "expired", "120 days ago", "Auth"),
        new("oauth-secret", "GITHUB_CLIENT_SECRET", "ghs_****mN8x", "All", "current", "45 days ago", "Auth"),
        new("encryption", "ENCRYPTION_KEY", "aes-256-****", "Production", "current", "7 days ago", "Security"),
        new("signing", "WEBHOOK_SIGNING_SECRET", "whsec_****kP2q", "Production", "expiring", "80 days ago", "Security"),
    ];

    private static readonly string[] _categories = ["Database", "API Keys", "Auth", "Security"];

    private int _expiringCount => _secrets.Count(s => s.RotationStatus == "expiring" || s.RotationStatus == "expired");

    private void ToggleReveal(string id)
    {
        if (_revealed.Contains(id))
            _revealed.Remove(id);
        else
            _revealed.Add(id);
    }

    private static string DotColor(string status) => status switch
    {
        "current" => "bg-emerald-500",
        "expiring" => "bg-amber-500",
        "expired" => "bg-red-500",
        _ => "bg-muted-foreground",
    };
}
