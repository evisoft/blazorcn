@* ============================================================
   Block: command-menu-reports
   Title: CommandMenuReports
   Description: Report generator command menu with templates, format selection, and scheduling options for React analytics platforms
   Source: original/blocks/command-menu/command-menu-reports.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" @onclick="() => _open = true">
            <LucideChartBarIncreasingCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Generate Report</span>
            <KbdCn>⌘R</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Command Menu</DialogTitleCn>
                <DialogDescriptionCn>Search and navigate.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search reports..." />
                <CommandListCn>
                    <CommandEmptyCn>No reports found.</CommandEmptyCn>

                    @foreach (var cat in _categories)
                    {
                        var catName = cat;
                        var catIndex = System.Array.IndexOf(_categories, catName);
                        @if (catIndex > 0)
                        {
                            <CommandSeparatorCn />
                        }
                        <CommandGroupCn Heading="@catName">
                            @foreach (var report in _reportTemplates)
                            {
                                @if (report.Category == catName)
                                {
                                    <CommandItemCn Class="gap-3" @onclick="() => _open = false">
                                        <div class="flex size-6 shrink-0 items-center justify-center rounded-md bg-muted">
                                            @switch (report.Icon)
                                            {
                                                case "trending-up":
                                                    <LucideTrendingUpCn Size="14" Class="size-3.5 text-muted-foreground" />
                                                    break;
                                                case "bar-chart-3":
                                                    <LucideChartBarIncreasingCn Size="14" Class="size-3.5 text-muted-foreground" />
                                                    break;
                                                case "users":
                                                    <LucideUsersCn Size="14" Class="size-3.5 text-muted-foreground" />
                                                    break;
                                                case "pie-chart":
                                                    <LucideChartPieCn Size="14" Class="size-3.5 text-muted-foreground" />
                                                    break;
                                                case "clock":
                                                    <LucideClockCn Size="14" Class="size-3.5 text-muted-foreground" />
                                                    break;
                                            }
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <span class="text-sm font-medium">@report.Name</span>
                                            <p class="text-xs text-muted-foreground">@report.Description</p>
                                        </div>
                                        <span class="shrink-0 text-xs text-muted-foreground">@report.LastRun</span>
                                    </CommandItemCn>
                                }
                            }
                        </CommandGroupCn>
                    }

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Export Format">
                        @foreach (var fmt in _exportFormats)
                        {
                            <CommandItemCn Class="gap-3">
                                @switch (fmt.Icon)
                                {
                                    case "file-text":
                                        <LucideFileTextCn Size="16" Class="size-4 text-muted-foreground" />
                                        break;
                                    case "file-spreadsheet":
                                        <LucideFileSpreadsheetCn Size="16" Class="size-4 text-muted-foreground" />
                                        break;
                                    case "table":
                                        <LucideTableCn Size="16" Class="size-4 text-muted-foreground" />
                                        break;
                                }
                                <div class="min-w-0 flex-1">
                                    <span class="text-sm font-medium">@fmt.Name</span>
                                </div>
                                <span class="font-mono text-xs text-muted-foreground">@fmt.Extension</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn Class="gap-3">
                            <LucidePlayCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Run selected report</span>
                            <KbdCn class="ml-auto">⌘↵</KbdCn>
                        </CommandItemCn>
                        <CommandItemCn Class="gap-3">
                            <LucideCalendarCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Schedule report</span>
                            <KbdCn class="ml-auto">⌘S</KbdCn>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideChartBarIncreasingCn Size="12" Class="size-3" />
                        <span>@(_reportTemplates.Length) report templates</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record ReportTemplate(string Id, string Name, string Description, string Icon, string LastRun, string Category);
    private record ExportFormat(string Id, string Name, string Extension, string Icon);

    private static readonly ReportTemplate[] _reportTemplates =
    [
        new("revenue", "Revenue Summary", "Monthly revenue breakdown by product and region", "trending-up", "2 hours ago", "Financial"),
        new("expenses", "Expense Report", "Categorized expenses with variance analysis", "bar-chart-3", "1 day ago", "Financial"),
        new("user-growth", "User Growth", "New signups, churn, and retention metrics", "users", "6 hours ago", "Product"),
        new("engagement", "Engagement Metrics", "DAU, WAU, MAU with session analytics", "pie-chart", "3 hours ago", "Product"),
        new("conversion", "Conversion Funnel", "Step-by-step conversion analysis with drop-off", "trending-up", "12 hours ago", "Product"),
        new("team-perf", "Team Performance", "Tasks completed, velocity, and burndown", "users", "1 day ago", "Operations"),
        new("sla", "SLA Compliance", "Response time and resolution metrics", "clock", "4 hours ago", "Operations"),
    ];

    private static readonly ExportFormat[] _exportFormats =
    [
        new("pdf", "PDF Report", ".pdf", "file-text"),
        new("csv", "CSV Data", ".csv", "file-spreadsheet"),
        new("xlsx", "Excel Workbook", ".xlsx", "table"),
    ];

    private static readonly string[] _categories =
        _reportTemplates.Select(r => r.Category).Distinct().ToArray();
}
