@* ============================================================
   Block: command-menu-oauth
   Title: CommandMenuOauth
   Description: OAuth scope manager command menu with permission toggles, provider grouping, and scope descriptions for React auth settings
   Source: original/blocks/command-menu/command-menu-oauth.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" Class="gap-2">
            <LucideIconCn Name="key" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">OAuth Scopes</span>
            <KbdCn>⌘O</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>OAuth Scopes</DialogTitleCn>
                <DialogDescriptionCn>OAuth scope manager command menu with permission toggles, provider grouping, and scope descriptions for React auth settings</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search scopes..." />
                <CommandListCn>
                    <CommandEmptyCn>No scopes found.</CommandEmptyCn>

                    @foreach (var providerEntry in _providers)
                    {
                        var provider = providerEntry;
                        var providerIndex = System.Array.IndexOf(_providers, provider);
                        @if (providerIndex > 0)
                        {
                            <CommandSeparatorCn />
                        }
                        <CommandGroupCn Heading="@provider">
                            @foreach (var scopeEntry in _scopes)
                            {
                                @if (scopeEntry.Provider == provider)
                                {
                                    var scope = scopeEntry;
                                    var isEnabled = _enabled.Contains(scope.Id);
                                    var risk = GetRiskConfig(scope.Risk);
                                    <CommandItemCn Class="gap-3" @onclick="@(() => ToggleScope(scope.Id))">
                                        <div class="@Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded border", isEnabled ? "border-primary bg-primary" : "border-muted-foreground/30")">
                                            @if (isEnabled)
                                            {
                                                <LucideIconCn Name="check" Size="12" Class="size-3 text-primary-foreground" />
                                            }
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <div class="flex items-center gap-2">
                                                <span class="font-mono text-sm">@scope.Scope</span>
                                                <span class="@Cn.Merge("size-1.5 rounded-full", risk.DotColor)"></span>
                                            </div>
                                            <p class="text-xs text-muted-foreground">@scope.Description</p>
                                        </div>
                                        <span class="@Cn.Merge("text-xs", risk.Color)">@scope.Risk</span>
                                    </CommandItemCn>
                                }
                            }
                        </CommandGroupCn>
                    }
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideIconCn Name="shield" Size="12" Class="size-3" />
                        <span>@_enabled.Count scopes granted</span>
                        <span>&middot;</span>
                        <span>@(_scopes.Count(s => _enabled.Contains(s.Id) && s.Risk == "high")) high-risk</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
    private HashSet<string> _enabled = ["gh-read-user", "gh-user-email", "g-profile", "g-email"];

    private record OAuthScope(string Id, string Scope, string Description, string Risk, string Provider);
    private record RiskConfig(string Color, string DotColor);

    private static readonly OAuthScope[] _scopes =
    [
        new("gh-read-user", "read:user", "Read user profile data", "low", "GitHub"),
        new("gh-user-email", "user:email", "Access user email addresses", "low", "GitHub"),
        new("gh-repo", "repo", "Full control of private repositories", "high", "GitHub"),
        new("gh-read-org", "read:org", "Read organization membership", "medium", "GitHub"),
        new("gh-admin-hooks", "admin:repo_hook", "Manage repository webhooks", "high", "GitHub"),
        new("g-profile", "profile", "View basic profile information", "low", "Google"),
        new("g-email", "email", "View email address", "low", "Google"),
        new("g-calendar", "calendar.readonly", "Read calendar events", "medium", "Google"),
        new("g-drive", "drive.file", "Access files created by the app", "medium", "Google"),
        new("g-admin", "admin.directory.user", "Manage organization users", "high", "Google"),
    ];

    private static readonly string[] _providers = ["GitHub", "Google"];

    private static RiskConfig GetRiskConfig(string risk) => risk switch
    {
        "low" => new("text-emerald-600", "bg-emerald-500"),
        "medium" => new("text-amber-600", "bg-amber-500"),
        "high" => new("text-red-600", "bg-red-500"),
        _ => new("text-muted-foreground", "bg-muted"),
    };

    private void ToggleScope(string id)
    {
        if (_enabled.Contains(id))
            _enabled.Remove(id);
        else
            _enabled.Add(id);
    }
}
