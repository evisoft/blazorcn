@* ============================================================
   Block: command-menu-graph
   Title: CommandMenuGraph
   Description: Graph and chart type selector command menu with visualization options for React data visualization apps
   Source: original/blocks/command-menu/command-menu-graph.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" @onclick="() => _open = true">
            <LucideChartBarCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Chart Type</span>
            <KbdCn>⌘⇧G</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Command Menu</DialogTitleCn>
                <DialogDescriptionCn>Search and navigate.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search chart types..." />
                <CommandListCn>
                    <CommandEmptyCn>No chart types found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Basic Charts">
                        @foreach (var chart in _basicCharts)
                        {
                            var chartItem = chart;
                            <CommandItemCn Class="gap-3" OnSelect="@(() => { _selected = chartItem.Id; _open = false; })">
                                @switch (chartItem.IconName)
                                {
                                    case "line-chart":
                                        <LucideChartLineCn Size="16" Class="size-4 text-muted-foreground" />
                                        break;
                                    case "bar-chart-3":
                                        <LucideChartBarCn Size="16" Class="size-4 text-muted-foreground" />
                                        break;
                                    case "pie-chart":
                                        <LucideChartPieCn Size="16" Class="size-4 text-muted-foreground" />
                                        break;
                                    case "trending-up":
                                        <LucideTrendingUpCn Size="16" Class="size-4 text-muted-foreground" />
                                        break;
                                }
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@chartItem.Name</div>
                                    <p class="text-xs text-muted-foreground">@chartItem.Description</p>
                                </div>
                                <span class="rounded bg-muted/50 px-1.5 py-0.5 text-xs text-muted-foreground">@chartItem.BestFor</span>
                                @if (_selected == chartItem.Id)
                                {
                                    <LucideCheckCn Size="16" Class="size-4 text-emerald-500" />
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Advanced Charts">
                        @foreach (var chart in _advancedCharts)
                        {
                            var chartItem = chart;
                            <CommandItemCn Class="gap-3" OnSelect="@(() => { _selected = chartItem.Id; _open = false; })">
                                @switch (chartItem.IconName)
                                {
                                    case "scatter-chart":
                                        <LucideChartScatterCn Size="16" Class="size-4 text-muted-foreground" />
                                        break;
                                    case "circle-dot":
                                        <LucideCircleDotCn Size="16" Class="size-4 text-muted-foreground" />
                                        break;
                                    case "bar-chart-3":
                                        <LucideChartBarCn Size="16" Class="size-4 text-muted-foreground" />
                                        break;
                                    case "git-branch":
                                        <LucideGitBranchCn Size="16" Class="size-4 text-muted-foreground" />
                                        break;
                                }
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@chartItem.Name</div>
                                    <p class="text-xs text-muted-foreground">@chartItem.Description</p>
                                </div>
                                <span class="rounded bg-muted/50 px-1.5 py-0.5 text-xs text-muted-foreground">@chartItem.BestFor</span>
                                @if (_selected == chartItem.Id)
                                {
                                    <LucideCheckCn Size="16" Class="size-4 text-emerald-500" />
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideChartBarCn Size="12" Class="size-3" />
                        <span>Selected: @(_allCharts.FirstOrDefault(c => c.Id == _selected)?.Name)</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
    private string _selected = "line";

    private record ChartType(string Id, string Name, string Description, string IconName, string BestFor);

    private static readonly ChartType[] _basicCharts =
    [
        new("line", "Line Chart", "Continuous data over time", "line-chart", "Trends"),
        new("bar", "Bar Chart", "Category comparisons", "bar-chart-3", "Comparisons"),
        new("pie", "Pie Chart", "Part-to-whole ratios", "pie-chart", "Proportions"),
        new("area", "Area Chart", "Volume over time", "trending-up", "Volume"),
    ];

    private static readonly ChartType[] _advancedCharts =
    [
        new("scatter", "Scatter Plot", "Correlation between variables", "scatter-chart", "Correlation"),
        new("donut", "Donut Chart", "Proportions with center metric", "circle-dot", "KPIs"),
        new("stacked-bar", "Stacked Bar", "Multi-series comparisons", "bar-chart-3", "Breakdown"),
        new("tree", "Treemap", "Hierarchical data display", "git-branch", "Hierarchy"),
    ];

    private static readonly ChartType[] _allCharts = [.. _basicCharts, .. _advancedCharts];
}
