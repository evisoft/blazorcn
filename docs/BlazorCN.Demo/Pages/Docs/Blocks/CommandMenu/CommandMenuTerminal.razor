@* ============================================================
   Block: command-menu-terminal
   Title: Command Menu Terminal
   Description: A CLI-style command palette with terminal interface, command history, auto-complete suggestions, and output preview for developer workflows
   Long Description: A terminal-inspired command menu that brings CLI power to your UI. Features command history with $ prefix, intelligent auto-complete for common Git, npm, and Docker commands, and an output preview area. Perfect for developer tools, admin panels, and power-user interfaces that need quick command execution.
   Dependencies: BadgeCn, ButtonCn, CommandCn, DialogCn, KbdCn
   Source: original/blocks/command-menu/command-menu-terminal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" @onclick="() => _open = true">
            <LucideSearchCn Size="16" Class="mr-2 h-4 w-4" />
            <span>Command Menu Terminal</span>
            <KbdCn class="ml-2">@@K</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Command Menu Terminal</DialogTitleCn>
                <DialogDescriptionCn>A CLI-style command palette with terminal interface, command history, auto-complete suggestions, and output preview for developer workflows</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Type a command or search..." />
                <CommandListCn>
                    <CommandEmptyCn>No results found.</CommandEmptyCn>
                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn>
                            <LucideSearchCn Size="16" Class="mr-2 h-4 w-4 text-muted-foreground" />
                            <span>Search...</span>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
}
