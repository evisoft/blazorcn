@* ============================================================
   Block: command-menu-scheduler
   Title: CommandMenuScheduler
   Description: Quick schedule creator command menu with preset times, recurring options, and calendar integration for React productivity apps
   Source: original/blocks/command-menu/command-menu-scheduler.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" @onclick="() => _open = true">
            <LucideCalendarCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Schedule</span>
            <KbdCn>@@S</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Command Menu</DialogTitleCn>
                <DialogDescriptionCn>Search and schedule.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search time slots or events..." />
                <CommandListCn>
                    <CommandEmptyCn>No results found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Quick Schedule">
                        @foreach (var slot in _quickSlots)
                        {
                            var slotItem = slot;
                            <CommandItemCn Class="gap-3" OnSelect="@(() => _open = false)">
                                @switch (slotItem.IconName)
                                {
                                    case "sunrise":
                                        <LucideSunriseCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                        break;
                                    case "users":
                                        <LucideUsersCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                        break;
                                    case "clock":
                                        <LucideClockCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                        break;
                                    case "timer":
                                        <LucideTimerCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                        break;
                                    default:
                                        <LucideSunsetCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                        break;
                                }
                                <div class="min-w-0 flex-1">
                                    <span class="text-sm font-medium">@slotItem.Label</span>
                                    <p class="text-xs text-muted-foreground">@slotItem.Description</p>
                                </div>
                                <span class="shrink-0 text-xs text-muted-foreground tabular-nums">@slotItem.Time</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Upcoming Events">
                        @foreach (var evt in _upcomingEvents)
                        {
                            var evtItem = evt;
                            <CommandItemCn Class="gap-3" OnSelect="@(() => _open = false)">
                                <LucideCalendarCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <span class="text-sm font-medium">@evtItem.Title</span>
                                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                                        <span>@evtItem.Time</span>
                                        <span>&middot;</span>
                                        <span>@evtItem.Duration</span>
                                        <span>&middot;</span>
                                        <LucideUsersCn Size="12" Class="size-3" />
                                        <span>@evtItem.Attendees</span>
                                    </div>
                                </div>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Recurring">
                        @foreach (var opt in _recurringOptions)
                        {
                            var option = opt;
                            <CommandItemCn Class="gap-3">
                                <LucideRepeatCn Size="16" Class="size-4 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <span class="text-sm font-medium">@option.Label</span>
                                    <p class="text-xs text-muted-foreground">@option.Description</p>
                                </div>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn Class="gap-3">
                            <LucidePlusCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Create custom event</span>
                            <KbdCn class="ml-auto">@@N</KbdCn>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideCalendarCn Size="12" Class="size-3" />
                        <span>@_upcomingEvents.Length upcoming events</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record QuickSlot(string Id, string Label, string Time, string Description, string IconName);

    private record UpcomingEvent(string Id, string Title, string Time, string Duration, int Attendees);

    private record RecurringOption(string Id, string Label, string Description);

    private static readonly QuickSlot[] _quickSlots =
    [
        new("morning",   "Morning Block",      "9:00 AM - 10:00 AM",  "Deep focus work",       "sunrise"),
        new("standup",   "Standup Slot",       "10:00 AM - 10:15 AM", "15 min team sync",      "users"),
        new("lunch",     "Lunch Meeting",      "12:00 PM - 1:00 PM",  "Informal discussion",   "clock"),
        new("afternoon", "Afternoon Block",    "2:00 PM - 4:00 PM",   "Collaborative work",    "timer"),
        new("review",    "End of Day Review",  "4:30 PM - 5:00 PM",   "Daily wrap-up",         "sunset"),
    ];

    private static readonly UpcomingEvent[] _upcomingEvents =
    [
        new("e1", "Sprint Planning",    "Tomorrow, 10:00 AM", "1 hour",  6),
        new("e2", "Design Review",      "Tomorrow, 2:00 PM",  "45 min",  4),
        new("e3", "1:1 with Manager",   "Wed, 3:00 PM",       "30 min",  2),
        new("e4", "All Hands Meeting",  "Fri, 11:00 AM",      "1 hour",  42),
    ];

    private static readonly RecurringOption[] _recurringOptions =
    [
        new("daily",     "Daily",     "Every weekday"),
        new("weekly",    "Weekly",    "Same day each week"),
        new("biweekly",  "Bi-weekly", "Every two weeks"),
        new("monthly",   "Monthly",   "Same day each month"),
    ];
}
