            <DialogHeaderCn class=""sr-only"">
                <DialogTitleCn>Command Menu</DialogTitleCn>
                <DialogDescriptionCn>Search and navigate.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder=""Search metrics..."" />
                <CommandListCn>
                    <CommandEmptyCn>No metrics found.</CommandEmptyCn>

                    @foreach (var cat in _categories)
                    {
                        var category = cat;
                        var isFirst = category == _categories[0];
                        @if (!isFirst)
                        {
                            <CommandSeparatorCn />
                        }
                        <CommandGroupCn Heading=""@category"">
                            @foreach (var m in _metrics)
                            {
                                var metric = m;
                                @if (metric.Category == category)
                                {
                                    var trendColor = (metric.Id == ""latency-p99"" || metric.Id == ""memory"")
                                        ? (metric.Trend == ""up"" ? ""text-amber-600"" : ""text-emerald-600"")
                                        : (metric.Trend == ""up"" ? ""text-emerald-600"" : ""text-red-600"");
                                    <CommandItemCn Class=""gap-3"" OnSelect=""@(() => _open = false)"">
                                        @switch (metric.Icon)
                                        {
                                            case ""zap"":
                                                <LucideZapCn Size=""16"" Class=""size-4 text-muted-foreground"" />
                                                break;
                                            case ""users"":
                                                <LucideUsersCn Size=""16"" Class=""size-4 text-muted-foreground"" />
                                                break;
                                            case ""clock"":
                                                <LucideClockCn Size=""16"" Class=""size-4 text-muted-foreground"" />
                                                break;
                                            case ""cpu"":
                                                <LucideCpuCn Size=""16"" Class=""size-4 text-muted-foreground"" />
                                                break;
                                            case ""hard-drive"":
                                                <LucideHardDriveCn Size=""16"" Class=""size-4 text-muted-foreground"" />
                                                break;
                                            case ""activity"":
                                                <LucideActivityCn Size=""16"" Class=""size-4 text-muted-foreground"" />
                                                break;
                                            case ""wifi"":
                                                <LucideWifiCn Size=""16"" Class=""size-4 text-muted-foreground"" />
                                                break;
                                        }
                                        <div class=""min-w-0 flex-1"">
                                            <span class=""text-sm font-medium"">@metric.Name</span>
                                        </div>
                                        <div class=""flex items-center gap-3"">
                                            <span class=""text-lg font-semibold tabular-nums"">@metric.Value</span>
                                            <span class=""text-xs text-muted-foreground"">@metric.Unit</span>
                                            <div class=""@Cn.Merge(""flex items-center gap-0.5"", trendColor)"">
                                                @if (metric.Trend == ""up"")
                                                {
                                                    <LucideArrowUpRightCn Size=""14"" Class=""size-3.5"" />
                                                }
                                                else
                                                {
                                                    <LucideArrowDownRightCn Size=""14"" Class=""size-3.5"" />
                                                }
                                                <span class=""text-xs font-medium tabular-nums"">@metric.TrendValue</span>
                                            </div>
                                            @{
                                                var statusClass = metric.Status == ""healthy"" ? ""bg-emerald-500"" : metric.Status == ""warning"" ? ""bg-amber-500"" : ""bg-red-500"";
                                            }
                                            <span class=""@Cn.Merge(""size-1.5 rounded-full"", statusClass)""></span>
                                        </div>
                                    </CommandItemCn>
                                }
                            }
                        </CommandGroupCn>
                    }
                </CommandListCn>

                <div class=""border-t px-3 py-2"">
                    <div class=""flex items-center gap-2 text-xs text-muted-foreground"">
                        <LucideGaugeCn Size=""12"" Class=""size-3"" />
                        <span>@(_metrics.Length) metrics tracked</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

