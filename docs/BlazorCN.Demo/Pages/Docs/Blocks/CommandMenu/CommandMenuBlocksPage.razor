                                    </div>
                                </CommandItemCn>
                            }
                        </CommandGroupCn>
                    }

                    <CommandSeparatorCn />
                    <CommandGroupCn>
                        <CommandItemCn>
                            <LucideSettingsCn Size=""16"" Class=""mr-2 h-4 w-4"" />
                            Notification settings
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

