        </DialogHeaderCn>
        <DialogContentCn class=""gap-0 overflow-hidden p-0 sm:max-w-md"" ShowCloseButton=""false"">
            <CommandCn>
                <div class=""flex items-center justify-between border-b px-3 py-2"">
                    <div class=""flex items-center gap-2"">
                        <LucideFolderOpenCn Size=""16"" Class=""size-4 text-muted-foreground"" />
                        <span class=""text-sm font-medium"">Templates</span>
                    </div>
                    <ButtonCn Size=""ButtonSize.Sm"" Variant=""@(_showStarred ? ButtonVariant.Secondary : ButtonVariant.Ghost)"" Class=""h-7 text-xs gap-1.5"" @onclick=""() => _showStarred = !_showStarred"">
                        <LucideStarCn Size=""12"" Class=""@Cn.Merge(""size-3"", _showStarred ? ""fill-current"" : """")"" />
                        Starred
                    </ButtonCn>
                </div>

                <CommandInputCn Placeholder=""Search templates..."" />

                <CommandListCn>
                    <CommandEmptyCn>No templates found.</CommandEmptyCn>

                    @{
                        var displayTemplates = _showStarred ? _templates.Where(t => t.Starred).ToArray() : _templates;
                        var categories = _categories;
                        for (int ci = 0; ci < categories.Length; ci++)
                        {
                            var category = categories[ci];
                            var categoryTemplates = displayTemplates.Where(t => t.Category == category).ToArray();
                            if (categoryTemplates.Length == 0) continue;
                            int idx = ci;
                            <div>
                                @if (idx > 0)
                                {
                                    <CommandSeparatorCn />
                                }
                                <CommandGroupCn Heading=""@category"">
                                    @foreach (var tmpl in categoryTemplates)
                                    {
                                        var t = tmpl;
                                        <CommandItemCn Class=""gap-3"" OnSelect=""@(() => _open = false)"">
                                            <LucideIconCn Name=""@t.IconName"" Size=""16"" Class=""size-4 shrink-0 text-muted-foreground"" />
                                            <div class=""min-w-0 flex-1"">
                                                <div class=""flex items-center gap-2"">
