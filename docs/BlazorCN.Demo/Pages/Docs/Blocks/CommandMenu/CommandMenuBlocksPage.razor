@code {
    private bool _open;
    private string _selectedPreset = ""ease-in-out"";
    private string _selectedDuration = ""300"";

    private record AnimationPreset(string Id, string Name, string Easing, string Duration);
    private record DurationOption(string Id, string Label, string Description);

    private static readonly AnimationPreset[] _easingPresets =
    [
        new(""ease-in"", ""Ease In"", ""cubic-bezier(0.4, 0, 1, 1)"", ""200ms""),
        new(""ease-out"", ""Ease Out"", ""cubic-bezier(0, 0, 0.2, 1)"", ""200ms""),
        new(""ease-in-out"", ""Ease In Out"", ""cubic-bezier(0.4, 0, 0.2, 1)"", ""300ms""),
        new(""linear"", ""Linear"", ""linear"", ""200ms""),
    ];

    private static readonly AnimationPreset[] _springPresets =
    [
        new(""spring-gentle"", ""Gentle Spring"", ""cubic-bezier(0.34, 1.56, 0.64, 1)"", ""400ms""),
        new(""spring-bouncy"", ""Bouncy Spring"", ""cubic-bezier(0.68, -0.55, 0.27, 1.55)"", ""500ms""),
        new(""spring-stiff"", ""Stiff Spring"", ""cubic-bezier(0.5, 1.25, 0.75, 1)"", ""250ms""),
    ];

    private static readonly DurationOption[] _durations =
    [
        new(""100"", ""100ms"", ""Instant""),
        new(""200"", ""200ms"", ""Fast""),
        new(""300"", ""300ms"", ""Normal""),
        new(""500"", ""500ms"", ""Slow""),
        new(""700"", ""700ms"", ""Very slow""),
    ];

    private string ActivePresetName()
    {
        foreach (var p in _easingPresets)
        {
            if (p.Id == _selectedPreset) return p.Name;
        }
        foreach (var p in _springPresets)
        {
            if (p.Id == _selectedPreset) return p.Name;
        }
        return _selectedPreset;
    }
}";

