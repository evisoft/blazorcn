@code {
    private bool _open;
    private List<string> _breadcrumb = [""$""];
    private List<JsonNode> _nodes = [.. _rootNodes];

    private record JsonNode(string Id, string Key, string Path, string Type, string Value, int? ChildCount = null);

    private static readonly JsonNode[] _rootNodes =
    [
        new(""user"",     ""user"",    ""$.user"",    ""object"",  ""{...}"",      4),
        new(""settings"", ""settings"",""$.settings"",""object"",  ""{...}"",      3),
        new(""items"",    ""items"",   ""$.items"",   ""array"",   ""[3 items]"",  3),
        new(""version"",  ""version"", ""$.version"", ""string"",  ""\""2.4.1\""""),
        new(""count"",    ""count"",   ""$.count"",   ""number"",  ""42""),
        new(""active"",   ""active"",  ""$.active"",  ""boolean"", ""true""),
    ];

    private static readonly JsonNode[] _userChildren =
    [
        new(""user.id"",       ""id"",       ""$.user.id"",       ""number"",  ""1024""),
        new(""user.name"",     ""name"",     ""$.user.name"",     ""string"",  ""\""Alice Chen\""""),
        new(""user.email"",    ""email"",    ""$.user.email"",    ""string"",  ""\""alice@acme.com\""""),
        new(""user.verified"", ""verified"", ""$.user.verified"", ""boolean"", ""true""),
    ];

    private void HandleSelect(JsonNode node)
    {
        if (node.Type == ""object"" || node.Type == ""array"")
        {
            if (node.Id == ""user"")
            {
                _nodes = [.. _userChildren];
                _breadcrumb = [.. _breadcrumb, node.Key];
            }
        }
    }

    private void HandleBack()
    {
        if (_breadcrumb.Count > 1)
        {
            _breadcrumb = [""$""];
            _nodes = [.. _rootNodes];
        }
    }

    private static string GetTypeColor(string type) => type switch
    {
        ""string""  => ""text-emerald-600"",
        ""number""  => ""text-blue-600"",
        ""boolean"" => ""text-amber-600"",
        _         => ""text-muted-foreground"",
    };

    private RenderFragment GetTypeIcon(string type) => type switch
    {
        ""string""  => @<LucideIconCn Name=""text"" Size=""16"" Class=""size-4 text-emerald-600"" />,
        ""number""  => @<LucideHashCn Size=""16"" Class=""size-4 text-blue-600"" />,
        ""boolean"" => @<LucideToggleLeftCn Size=""16"" Class=""size-4 text-amber-600"" />,
        ""array""   => @<LucideBracketsCn Size=""16"" Class=""size-4 text-muted-foreground"" />,
        _         => @<LucideBracesCn Size=""16"" Class=""size-4 text-muted-foreground"" />,
    };
}";

