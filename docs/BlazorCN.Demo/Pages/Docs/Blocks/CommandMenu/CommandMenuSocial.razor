@* ============================================================
   Block: command-menu-social
   Title: Command Menu Social
   Description: A social media management command menu for composing posts and viewing scheduled content
   Dependencies: BadgeCn, ButtonCn, CommandCn, KbdCn
   Source: original/blocks/command-menu/command-menu-social.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" class="gap-2">
            <LucideShare2Cn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Social Media</span>
            <KbdCn>@@K</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Command Menu</DialogTitleCn>
                <DialogDescriptionCn>Search and navigate.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
        <CommandInputCn Placeholder="Search posts and actions..." />
        <CommandListCn>
            <CommandEmptyCn>No results found.</CommandEmptyCn>

            <CommandGroupCn Heading="Quick Actions">
                <CommandItemCn class="gap-3">
                    <LucidePenLineCn Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-sm">Compose new post</span>
                </CommandItemCn>
                <CommandItemCn class="gap-3">
                    <LucideCalendarCn Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-sm">View content calendar</span>
                </CommandItemCn>
                <CommandItemCn class="gap-3">
                    <LucideTrendingUpCn Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-sm">View analytics dashboard</span>
                </CommandItemCn>
                <CommandItemCn class="gap-3">
                    <LucideMessageCircleCn Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-sm">Reply to mentions</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" class="ml-auto">12</BadgeCn>
                </CommandItemCn>
            </CommandGroupCn>

            <CommandGroupCn Heading="@($"Scheduled Posts ({_scheduled.Length})")">
                @foreach (var post in _scheduled)
                {
                    <CommandItemCn class="gap-3">
                        <LucideClockCn Size="16" Class="size-4 text-muted-foreground" />
                        <div class="flex min-w-0 flex-1 flex-col gap-1">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("rounded px-1.5 py-0.5 text-xs font-medium", post.Platform == "twitter" ? "bg-blue-500/10 text-blue-500" : post.Platform == "linkedin" ? "bg-blue-600/10 text-blue-600" : "bg-pink-500/10 text-pink-500")">@post.PlatformLabel</span>
                                <span class="font-mono text-muted-foreground text-xs">@post.ScheduledTime</span>
                            </div>
                            <p class="truncate text-sm">@post.Content</p>
                        </div>
                    </CommandItemCn>
                }
            </CommandGroupCn>

            <CommandGroupCn Heading="@($"Drafts ({_drafts.Length})")">
                @foreach (var draft in _drafts)
                {
                    <CommandItemCn class="gap-3">
                        <LucideFileTextCn Size="16" Class="size-4 text-muted-foreground" />
                        <div class="flex min-w-0 flex-1 flex-col gap-1">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("rounded px-1.5 py-0.5 text-xs font-medium", draft.Platform == "twitter" ? "bg-blue-500/10 text-blue-500" : draft.Platform == "linkedin" ? "bg-blue-600/10 text-blue-600" : "bg-pink-500/10 text-pink-500")">@draft.PlatformLabel</span>
                                <span class="font-mono text-muted-foreground text-xs">@draft.LastEdited</span>
                            </div>
                            <p class="truncate text-sm">@draft.Content</p>
                        </div>
                    </CommandItemCn>
                }
            </CommandGroupCn>

            <CommandGroupCn Heading="Compose for Platform">
                <CommandItemCn class="gap-3">
                    <LucidePenLineCn Size="16" Class="size-4 text-muted-foreground" />
                    <LucideTwitterCn Size="16" Class="size-4 text-blue-500" />
                    <span class="text-sm">New Twitter post</span>
                </CommandItemCn>
                <CommandItemCn class="gap-3">
                    <LucidePenLineCn Size="16" Class="size-4 text-muted-foreground" />
                    <LucideLinkedinCn Size="16" Class="size-4 text-blue-600" />
                    <span class="text-sm">New LinkedIn post</span>
                </CommandItemCn>
                <CommandItemCn class="gap-3">
                    <LucidePenLineCn Size="16" Class="size-4 text-muted-foreground" />
                    <LucideInstagramCn Size="16" Class="size-4 text-pink-500" />
                    <span class="text-sm">New Instagram post</span>
                </CommandItemCn>
            </CommandGroupCn>

            <CommandGroupCn Heading="Analytics">
                <CommandItemCn class="gap-3">
                    <LucideTrendingUpCn Size="16" Class="size-4 text-muted-foreground" />
                    <LucideTwitterCn Size="16" Class="size-4 text-blue-500" />
                    <div class="flex min-w-0 flex-1 items-center justify-between gap-3">
                        <span class="text-sm">Twitter performance</span>
                        <span class="shrink-0 font-mono text-muted-foreground text-xs">+12.5% engagement</span>
                    </div>
                </CommandItemCn>
                <CommandItemCn class="gap-3">
                    <LucideTrendingUpCn Size="16" Class="size-4 text-muted-foreground" />
                    <LucideLinkedinCn Size="16" Class="size-4 text-blue-600" />
                    <div class="flex min-w-0 flex-1 items-center justify-between gap-3">
                        <span class="text-sm">LinkedIn performance</span>
                        <span class="shrink-0 font-mono text-muted-foreground text-xs">+8.3% reach</span>
                    </div>
                </CommandItemCn>
                <CommandItemCn class="gap-3">
                    <LucideTrendingUpCn Size="16" Class="size-4 text-muted-foreground" />
                    <LucideInstagramCn Size="16" Class="size-4 text-pink-500" />
                    <div class="flex min-w-0 flex-1 items-center justify-between gap-3">
                        <span class="text-sm">Instagram performance</span>
                        <span class="shrink-0 font-mono text-muted-foreground text-xs">+15.7% followers</span>
                    </div>
                </CommandItemCn>
            </CommandGroupCn>
        </CommandListCn>
    </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record PostItem(string Platform, string PlatformLabel, string Content, string ScheduledTime = "", string LastEdited = "");

    private static readonly PostItem[] _scheduled =
    [
        new("twitter", "Twitter", "Excited to announce our v3.0 release with real-time collaboration!", "Today, 2:00 PM"),
        new("linkedin", "LinkedIn", "We're hiring senior engineers! Join our growing team.", "Tomorrow, 9:00 AM"),
        new("instagram", "Instagram", "Behind the scenes of our design process for the new dashboard.", "Mar 25, 10:00 AM"),
    ];

    private static readonly PostItem[] _drafts =
    [
        new("twitter", "Twitter", "Thread: 5 lessons learned from scaling to 1M users...", LastEdited: "2h ago"),
        new("linkedin", "LinkedIn", "Case study: How we reduced API latency by 80%", LastEdited: "1d ago"),
    ];
}
