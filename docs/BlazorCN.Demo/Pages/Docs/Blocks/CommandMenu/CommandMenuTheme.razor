@* ============================================================
   Block: command-menu-theme
   Title: Command Menu Theme
   Description: Theme and appearance command menu with light/dark/system modes and accent color picker
   Dependencies: BadgeCn, ButtonCn, CommandCn, DialogCn, KbdCn
   Source: original/blocks/command-menu/command-menu-theme.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline">
            <LucidePaletteCn Size="16" Class="mr-2 h-4 w-4" />
            <span>Appearance</span>
            <KbdCn class="ml-2">@@T</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-md" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Appearance Settings</DialogTitleCn>
                <DialogDescriptionCn>Customize the look and feel.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <div class="flex items-center justify-between border-b px-3 py-2">
                    <div class="flex items-center gap-2">
                        <LucidePaletteCn Size="16" Class="h-4 w-4" />
                        <span class="font-medium">Appearance</span>
                    </div>
                    <BadgeCn class="text-xs" Variant="BadgeVariant.Outline">@_theme · @_accent</BadgeCn>
                </div>

                <CommandInputCn Placeholder="Search settings..." />

                <CommandListCn class="max-h-[400px]">
                    <CommandEmptyCn>No settings found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Theme">
                        @foreach (var mode in _themeModes)
                        {
                            <CommandItemCn @onclick="() => _theme = mode.Value">
                                @if (mode.Value == "light")
                                {
                                    <LucideSunCn Size="16" Class="mr-2 h-4 w-4" />
                                }
                                else if (mode.Value == "dark")
                                {
                                    <LucideMoonCn Size="16" Class="mr-2 h-4 w-4" />
                                }
                                else
                                {
                                    <LucideMonitorCn Size="16" Class="mr-2 h-4 w-4" />
                                }
                                <span class="flex-1">@mode.Label</span>
                                @if (_theme == mode.Value)
                                {
                                    <LucideCheckCn Size="16" Class="h-4 w-4 text-primary" />
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Accent Color">
                        @foreach (var color in _accentColors)
                        {
                            <CommandItemCn @onclick="() => _accent = color.Value">
                                <div class="mr-2 h-4 w-4 rounded-full border" style="background-color: @color.Color"></div>
                                <span class="flex-1">@color.Label</span>
                                @if (_accent == color.Value)
                                {
                                    <LucideCheckCn Size="16" Class="h-4 w-4 text-primary" />
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Font Size">
                        @foreach (var size in _fontSizes)
                        {
                            <CommandItemCn @onclick="() => _fontSize = size.Value">
                                <LucideTypeCn Size="16" Class="mr-2 h-4 w-4" />
                                <div class="flex-1">
                                    <span>@size.Label</span>
                                    <span class="ml-2 text-xs text-muted-foreground">@size.Description</span>
                                </div>
                                @if (_fontSize == size.Value)
                                {
                                    <LucideCheckCn Size="16" Class="h-4 w-4 text-primary" />
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t p-3">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">PREVIEW</p>
                    <div class="flex items-center gap-2 rounded-lg border p-3">
                        <div class="h-8 w-8 rounded-full" style="background-color: @(_accentColors.FirstOrDefault(c => c.Value == _accent)?.Color ?? "#3b82f6")"></div>
                        <div class="flex-1">
                            <p class="text-sm font-medium">Sample Text</p>
                            <p class="text-xs text-muted-foreground">@_theme theme with @_accent accent</p>
                        </div>
                        <BadgeCn>@_fontSize</BadgeCn>
                    </div>
                </div>

                <div class="flex items-center justify-between border-t px-3 py-2 text-xs text-muted-foreground">
                    <span>Changes apply instantly</span>
                    <button type="button" class="text-primary hover:underline" @onclick="ResetDefaults">Reset to defaults</button>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
    private string _theme = "system";
    private string _accent = "blue";
    private string _fontSize = "default";

    private record ThemeMode(string Value, string Label);
    private record AccentColor(string Value, string Label, string Color);
    private record FontSize(string Value, string Label, string Description);

    private static readonly ThemeMode[] _themeModes =
    [
        new("light", "Light"),
        new("dark", "Dark"),
        new("system", "System"),
    ];

    private static readonly AccentColor[] _accentColors =
    [
        new("blue", "Blue", "#3b82f6"),
        new("purple", "Purple", "#8b5cf6"),
        new("green", "Green", "#22c55e"),
        new("orange", "Orange", "#f97316"),
        new("rose", "Rose", "#f43f5e"),
    ];

    private static readonly FontSize[] _fontSizes =
    [
        new("small", "Small", "14px base"),
        new("default", "Default", "16px base"),
        new("large", "Large", "18px base"),
    ];

    private void ResetDefaults()
    {
        _theme = "system";
        _accent = "blue";
        _fontSize = "default";
    }
}
