@* ============================================================
   Block: command-menu-import
   Title: CommandMenuImport
   Description: Data import wizard command menu with source selection and format options for React data management apps
   Source: original/blocks/command-menu/command-menu-import.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" Class="gap-2">
            <LucideIconCn Name="import" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Import Data</span>
            <KbdCn>⌘⇧I</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Import Data</DialogTitleCn>
                <DialogDescriptionCn>Data import wizard command menu with source selection and format options for React data management apps</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search import options..." />
                <CommandListCn>
                    <CommandEmptyCn>No import options found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Import Source">
                        @foreach (var src in _importSources)
                        {
                            var source = src;
                            <CommandItemCn class="gap-3" @onclick="() => _open = false">
                                <LucideIconCn Name="@source.Icon" Size="16" Class="size-4 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@source.Name</div>
                                    <p class="text-xs text-muted-foreground">@source.Description</p>
                                </div>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandGroupCn Heading="File Format">
                        @foreach (var fmt in _fileFormats)
                        {
                            var format = fmt;
                            <CommandItemCn class="gap-3" @onclick="() => _open = false">
                                <LucideIconCn Name="@format.Icon" Size="16" Class="size-4 text-muted-foreground" />
                                <span class="flex-1 text-sm font-medium">@format.Name</span>
                                <span class="text-xs text-muted-foreground">@format.Description</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Recent Imports">
                        @foreach (var imp in _recentImports)
                        {
                            var item = imp;
                            <CommandItemCn class="gap-3" @onclick="() => _open = false">
                                <LucideIconCn Name="history" Size="16" Class="size-4 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <div class="font-mono text-sm">@item.Name</div>
                                    <p class="text-xs text-muted-foreground">@item.Records</p>
                                </div>
                                <span class="text-xs text-muted-foreground">@item.Time</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideIconCn Name="hard-drive" Size="12" Class="size-3" />
                        <span>Max file size: 50 MB</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record ImportSource(string Id, string Name, string Description, string Icon);
    private record FileFormat(string Id, string Name, string Description, string Icon);
    private record RecentImport(string Id, string Name, string Records, string Time);

    private static readonly ImportSource[] _importSources =
    [
        new("file", "Upload File", "CSV, JSON, or Excel file", "upload"),
        new("url", "Import from URL", "Fetch data from a remote endpoint", "globe"),
        new("database", "Database Import", "Connect to an external database", "database"),
        new("cloud", "Cloud Storage", "Import from S3, GCS, or Azure", "cloud"),
        new("clipboard", "Paste from Clipboard", "Paste tabular data directly", "table"),
    ];

    private static readonly FileFormat[] _fileFormats =
    [
        new("csv", "CSV", "Comma-separated values", "file-spreadsheet"),
        new("json", "JSON", "JavaScript Object Notation", "file-text"),
        new("xlsx", "Excel (XLSX)", "Microsoft Excel spreadsheet", "file-spreadsheet"),
        new("tsv", "TSV", "Tab-separated values", "file-text"),
    ];

    private static readonly RecentImport[] _recentImports =
    [
        new("1", "customers-q1-2026.csv", "2,847 records", "2 days ago"),
        new("2", "products-update.json", "156 records", "1 week ago"),
        new("3", "team-members.xlsx", "42 records", "2 weeks ago"),
    ];
}
