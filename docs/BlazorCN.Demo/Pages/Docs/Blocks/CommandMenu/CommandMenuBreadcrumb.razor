@* ============================================================
   Block: command-menu-breadcrumb
   Title: CommandMenuBreadcrumb
   Description: Breadcrumb-style nested navigation command menu with hierarchical path browsing for React apps
   Source: original/blocks/command-menu/command-menu-breadcrumb.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" @onclick="OpenMenu">
            <LucideIconCn Name="folder" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Browse</span>
            <KbdCn>@("⌘")G</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Browse</DialogTitleCn>
                <DialogDescriptionCn>Breadcrumb-style nested navigation command menu with hierarchical path browsing</DialogDescriptionCn>
            </DialogHeaderCn>
            <div class="flex items-center gap-1 border-b px-3 py-2">
                @if (_path.Count > 1)
                {
                    <button type="button" @onclick="HandleBack"
                            class="mr-1 rounded p-1 text-muted-foreground hover:bg-muted hover:text-foreground">
                        <LucideIconCn Name="chevron-left" Size="16" Class="size-4" />
                    </button>
                }
                @for (var i = 0; i < _path.Count; i++)
                {
                    var idx = i;
                    var entry = _path[idx];
                    var isLast = idx == _path.Count - 1;
                    <div class="flex items-center gap-1">
                        @if (idx > 0)
                        {
                            <span class="text-xs text-muted-foreground">/</span>
                        }
                        <button type="button"
                                @onclick="@(() => HandleBreadcrumbClick(idx))"
                                class="@(isLast ? "rounded px-1.5 py-0.5 text-xs font-medium text-foreground" : "rounded px-1.5 py-0.5 text-xs text-muted-foreground hover:bg-muted hover:text-foreground")">
                            @if (idx == 0)
                            {
                                <LucideIconCn Name="home" Size="12" Class="size-3" />
                            }
                            else
                            {
                                @entry.Label
                            }
                        </button>
                    </div>
                }
            </div>
            <CommandCn>
                <CommandInputCn Placeholder="@($"Search in {CurrentLevel.Label}...")" />
                <CommandListCn>
                    <CommandEmptyCn>No items found.</CommandEmptyCn>
                    <CommandGroupCn Heading="@CurrentLevel.Label">
                        @foreach (var navItem in CurrentLevel.Items)
                        {
                            var item = navItem;
                            <CommandItemCn OnSelect="@(() => HandleSelect(item))" Class="gap-3">
                                @if (item.Type == "folder")
                                {
                                    <LucideIconCn Name="folder" Size="16" Class="size-4 text-muted-foreground" />
                                }
                                else
                                {
                                    <LucideIconCn Name="file" Size="16" Class="size-4 text-muted-foreground" />
                                }
                                <span class="flex-1 text-sm font-medium">@item.Label</span>
                                @if (item.Type == "folder")
                                {
                                    <LucideIconCn Name="chevron-right" Size="16" Class="size-4 text-muted-foreground" />
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>
            </CommandCn>
            <div class="border-t px-3 py-2">
                <div class="flex items-center gap-2 text-xs text-muted-foreground">
                    <span>@CurrentLevel.Items.Count items</span>
                    <span class="ml-auto">
                        <KbdCn>←</KbdCn> back <KbdCn>→</KbdCn> open
                    </span>
                </div>
            </div>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record NavItem(string Id, string Label, string Type, List<NavItem>? Children = null);

    private record PathLevel(string Id, string Label, List<NavItem> Items);

    private static readonly List<NavItem> _navTree =
    [
        new("dashboard", "Dashboard", "folder", [
            new("overview", "Overview", "file"),
            new("analytics", "Analytics", "file"),
            new("reports", "Reports", "file"),
        ]),
        new("projects", "Projects", "folder", [
            new("website-redesign", "Website Redesign", "file"),
            new("mobile-app", "Mobile App", "file"),
            new("backend", "Backend Services", "folder", [
                new("api-gateway", "API Gateway", "file"),
                new("auth-service", "Auth Service", "file"),
                new("data-pipeline", "Data Pipeline", "file"),
            ]),
        ]),
        new("settings", "Settings", "folder", [
            new("general", "General", "file"),
            new("security", "Security", "file"),
            new("billing", "Billing", "file"),
            new("integrations", "Integrations", "file"),
        ]),
        new("help", "Help Center", "file"),
    ];

    private List<PathLevel> _path = [new("root", "Home", _navTree)];

    private PathLevel CurrentLevel => _path[_path.Count - 1];

    private void OpenMenu()
    {
        _path = [new("root", "Home", _navTree)];
        _open = true;
    }

    private void HandleSelect(NavItem item)
    {
        if (item.Type == "folder" && item.Children != null)
        {
            _path = [.._path, new(item.Id, item.Label, item.Children)];
        }
        else
        {
            _open = false;
        }
    }

    private void HandleBack()
    {
        if (_path.Count > 1)
        {
            _path = _path.Take(_path.Count - 1).ToList();
        }
    }

    private void HandleBreadcrumbClick(int index)
    {
        _path = _path.Take(index + 1).ToList();
    }
}
