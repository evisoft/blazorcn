@* ============================================================
   Block: command-menu-ci-cd
   Title: CommandMenuCiCd
   Description: CI/CD pipeline actions command menu with build triggers and deployment controls for React DevOps dashboards
   Source: original/blocks/command-menu/command-menu-ci-cd.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" Class="gap-2">
            <LucideRocketCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">CI/CD Actions</span>
            <KbdCn>⌘⇧D</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>CI/CD Actions</DialogTitleCn>
                <DialogDescriptionCn>CI/CD pipeline actions command menu with build triggers and deployment controls</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search pipelines or actions..." />
                <CommandListCn>
                    <CommandEmptyCn>No pipelines found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Pipelines">
                        @foreach (var pipeline in _pipelines)
                        {
                            var cfg = GetStatusConfig(pipeline.Status);
                            <CommandItemCn @onclick="() => _open = false" class="gap-3">
                                <LucideIconCn Name="@cfg.IconName" Size="16" Class="@($"size-4 {cfg.Color}{(pipeline.Status == "running" ? " animate-spin" : "")}")" />
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@pipeline.Name</div>
                                    <div class="flex items-center gap-1 text-xs text-muted-foreground">
                                        <LucideGitBranchCn Size="12" Class="size-3" />
                                        <span>@pipeline.Branch</span>
                                    </div>
                                </div>
                                <span class="font-mono text-xs text-muted-foreground">@pipeline.Duration</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Quick Actions">
                        @foreach (var action in _quickActions)
                        {
                            var act = action;
                            <CommandItemCn @onclick="() => _open = false" class="gap-3">
                                <LucideIconCn Name="@act.IconName" Size="16" Class="size-4 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@act.Label</div>
                                    <p class="text-xs text-muted-foreground">@act.Description</p>
                                </div>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span>1 passed</span>
                        <span class="size-1.5 rounded-full bg-blue-500"></span>
                        <span>1 running</span>
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        <span>1 failed</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record Pipeline(string Id, string Name, string Branch, string Status, string Duration);
    private record QuickAction(string Id, string IconName, string Label, string Description);
    private record StatusCfg(string IconName, string Color);

    private static readonly Pipeline[] _pipelines =
    [
        new("1", "Build & Test", "main", "success", "2m 34s"),
        new("2", "Deploy Staging", "main", "running", "1m 12s"),
        new("3", "Build & Test", "feat/auth", "failed", "4m 01s"),
        new("4", "E2E Tests", "main", "pending", "—"),
    ];

    private static readonly QuickAction[] _quickActions =
    [
        new("run-all", "play", "Run All Pipelines", "Trigger full CI/CD"),
        new("deploy-staging", "rocket", "Deploy to Staging", "Deploy main to staging"),
        new("deploy-prod", "rocket", "Deploy to Production", "Deploy main to production"),
        new("retry-failed", "refresh-cw", "Retry Failed Jobs", "Re-run failed pipelines"),
        new("cancel-all", "square", "Cancel Running Jobs", "Stop all active pipelines"),
    ];

    private static StatusCfg GetStatusConfig(string status) => status switch
    {
        "success" => new("check-circle-2", "text-emerald-500"),
        "running" => new("loader-2", "text-blue-500"),
        "failed"  => new("x-circle", "text-red-500"),
        _         => new("circle-dot", "text-muted-foreground"),
    };
}
