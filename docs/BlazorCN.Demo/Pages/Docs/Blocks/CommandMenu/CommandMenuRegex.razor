@* ============================================================
   Block: command-menu-regex
   Title: CommandMenuRegex
   Description: Regex tester and library command menu with pattern categories, descriptions, and copy-to-clipboard for React developer tools
   Source: original/blocks/command-menu/command-menu-regex.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" Class="gap-2">
            <LucideIconCn Name="regex" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Regex Library</span>
            <KbdCn>⌘/</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Regex Library</DialogTitleCn>
                <DialogDescriptionCn>Regex tester and library command menu with pattern categories, descriptions, and copy-to-clipboard</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search patterns..." />
                <CommandListCn>
                    <CommandEmptyCn>No patterns found.</CommandEmptyCn>

                    @for (int idx = 0; idx < _categories.Length; idx++)
                    {
                        var cat = _categories[idx];
                        var i = idx;
                        <div>
                            @if (i > 0)
                            {
                                <CommandSeparatorCn />
                            }
                            <CommandGroupCn Heading="@cat">
                                @foreach (var pat in _patterns.Where(p => p.Category == cat))
                                {
                                    var pattern = pat;
                                    <CommandItemCn Class="gap-3" OnSelect="@(() => HandleCopy(pattern))">
                                        <LucideIconCn Name="code" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                        <div class="min-w-0 flex-1">
                                            <span class="text-sm font-medium">@pattern.Name</span>
                                            <p class="mt-0.5 truncate font-mono text-xs text-muted-foreground">@pattern.Pattern</p>
                                            <p class="text-xs text-muted-foreground">@pattern.Description</p>
                                        </div>
                                        @if (_copiedId == pattern.Id)
                                        {
                                            <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 text-emerald-500" />
                                        }
                                        else
                                        {
                                            <LucideIconCn Name="clipboard" Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                                        }
                                    </CommandItemCn>
                                }
                            </CommandGroupCn>
                        </div>
                    }
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideIconCn Name="regex" Size="12" Class="size-3" />
                        <span>@_patterns.Length patterns</span>
                        <span>&middot;</span>
                        <span>Click to copy</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
    private string? _copiedId;
    private System.Threading.Timer? _resetTimer;

    private record RegexPattern(string Id, string Name, string Pattern, string Description, string Category);

    private static readonly RegexPattern[] _patterns =
    [
        new("email", "Email Address", @"^[\w.-]+@[\w.-]+\.[a-zA-Z]{2,}$", "Matches standard email format", "Validation"),
        new("url", "URL", @"https?:\/\/[\w.-]+(?:\.[\w.-]+)+[\w.,@?^=%&:/~+#-]*", "Matches HTTP and HTTPS URLs", "Validation"),
        new("phone", "Phone Number", @"^\+?[1-9]\d{1,14}$", "E.164 international phone format", "Validation"),
        new("ipv4", "IPv4 Address", @"^(?:(?:25[0-5]|2[0-4]\d|[01]?\d\d?)\.){3}(?:25[0-5]|2[0-4]\d|[01]?\d\d?)$", "Matches valid IPv4 addresses", "Validation"),
        new("uuid", "UUID v4", @"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "Matches UUID version 4 format", "Identifiers"),
        new("hex-color", "Hex Color", @"^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$", "Matches 3 or 6 digit hex colors", "Identifiers"),
        new("slug", "URL Slug", @"^[a-z0-9]+(?:-[a-z0-9]+)*$", "Lowercase alphanumeric with hyphens", "Identifiers"),
        new("date-iso", "ISO Date", @"^\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\d|3[01])$", "Matches YYYY-MM-DD format", "Date & Time"),
        new("time-24h", "24-Hour Time", @"^([01]\d|2[0-3]):[0-5]\d(:[0-5]\d)?$", "Matches HH:MM or HH:MM:SS", "Date & Time"),
        new("password", "Strong Password", @"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$", "Min 8 chars, upper, lower, digit, special", "Security"),
        new("jwt", "JWT Token", @"^[A-Za-z0-9-_]+\.[A-Za-z0-9-_]+\.[A-Za-z0-9-_]+$", "Matches three-part JWT format", "Security"),
    ];

    private static readonly string[] _categories = _patterns.Select(p => p.Category).Distinct().ToArray();

    private void HandleCopy(RegexPattern pattern)
    {
        _copiedId = pattern.Id;
        _resetTimer?.Dispose();
        _resetTimer = new System.Threading.Timer(_ =>
        {
            _copiedId = null;
            InvokeAsync(StateHasChanged);
        }, null, 1500, System.Threading.Timeout.Infinite);
    }

    public void Dispose()
    {
        _resetTimer?.Dispose();
    }
}
