@* ============================================================
   Block: command-menu-onboarding
   Title: CommandMenuOnboarding
   Description: Onboarding step navigator command menu with progress tracking and completion states for React app setup flows
   Source: original/blocks/command-menu/command-menu-onboarding.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" @onclick="() => _open = true">
            <LucideRocketCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Setup Guide</span>
            <KbdCn>⌘G</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogHeaderCn class="sr-only">
            <DialogTitleCn>Command Menu</DialogTitleCn>
            <DialogDescriptionCn>Use the command menu to navigate onboarding steps.</DialogDescriptionCn>
        </DialogHeaderCn>
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <CommandCn Class="**:data-[slot=command-input-wrapper]:border-b">
                <div class="border-b px-3 py-2">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <LucideRocketCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm font-medium">Getting Started</span>
                        </div>
                        <span class="text-xs text-muted-foreground tabular-nums">
                            @_progressPercent% complete
                        </span>
                    </div>
                    <div class="mt-2 h-1 w-full rounded-full bg-muted">
                        <div
                            class="h-1 rounded-full bg-primary transition-all"
                            style="@($"width:{_progressPercent}%")" />
                    </div>
                </div>
                <CommandInputCn Placeholder="Search steps..." />
                <CommandListCn>
                    <CommandEmptyCn>No steps found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Setup Steps">
                        @foreach (var it in _steps)
                        {
                            var step = it;
                            <CommandItemCn Class="gap-3" OnSelect="@(() => _open = false)">
                                @if (step.Status == "completed")
                                {
                                    <LucideCircleCheckBigCn Size="16" Class="size-4 shrink-0 text-emerald-500" />
                                }
                                else if (step.Status == "current")
                                {
                                    <LucideCircleCn Size="16" Class="size-4 shrink-0 text-blue-500" />
                                }
                                else
                                {
                                    <LucideCircleCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                }
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="@Cn.Merge("text-sm font-medium", step.Status == "completed" ? "line-through text-muted-foreground" : "")">
                                            @step.Title
                                        </span>
                                        @if (step.Optional)
                                        {
                                            <span class="text-xs text-muted-foreground">Optional</span>
                                        }
                                    </div>
                                    <p class="text-xs text-muted-foreground">@step.Description</p>
                                </div>
                                <KbdCn>@(Array.IndexOf(_steps, step) + 1)</KbdCn>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn Class="gap-3">
                            <LucideRocketCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Skip remaining optional steps</span>
                            <KbdCn class="ml-auto">⌘S</KbdCn>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideCircleCheckBigCn Size="12" Class="size-3" />
                        <span>
                            @_completedCount of @_steps.Length steps completed
                        </span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record OnboardingStep(string Id, string Title, string Description, string Status, bool Optional);

    private static readonly OnboardingStep[] _steps =
    [
        new("profile", "Complete your profile", "Add your name, avatar, and bio", "completed", false),
        new("workspace", "Create a workspace", "Set up your first workspace and invite team", "completed", false),
        new("api-key", "Generate API key", "Create an API key for programmatic access", "completed", false),
        new("invite-team", "Invite team members", "Add collaborators to your workspace", "current", false),
        new("configure", "Configure preferences", "Set timezone, language, and notifications", "upcoming", true),
        new("billing", "Set up billing", "Add payment method and select a plan", "upcoming", true),
    ];

    private int _completedCount => Array.FindAll(_steps, s => s.Status == "completed").Length;
    private int _progressPercent => (int)Math.Round((double)_completedCount / _steps.Length * 100);
}
