@* ============================================================
   Block: command-menu-bookmarks
   Title: Command Menu Bookmarks
   Description: Bookmark manager command menu with folders, tags, and quick save
   Dependencies: BadgeCn, ButtonCn, CommandCn, DialogCn, KbdCn
   Source: original/blocks/command-menu/command-menu-bookmarks.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" @onclick="() => _open = true">
            <LucideBookmarkCn Size="16" Class="mr-2 h-4 w-4" />
            <span>Bookmarks</span>
            <KbdCn class="ml-2">@@B</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogHeaderCn class="sr-only">
            <DialogTitleCn>Bookmarks</DialogTitleCn>
            <DialogDescriptionCn>Access your saved bookmarks.</DialogDescriptionCn>
        </DialogHeaderCn>
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-md" ShowCloseButton="false">
            <CommandCn>
                <div class="flex items-center justify-between border-b px-3 py-2">
                    <div class="flex items-center gap-2">
                        <LucideBookmarkCn Size="16" Class="h-4 w-4" />
                        <span class="font-medium">Bookmarks</span>
                        <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">@_bookmarks.Length</BadgeCn>
                    </div>
                    <KbdCn>@@B</KbdCn>
                </div>

                <CommandInputCn Placeholder="Search bookmarks..." />

                <CommandListCn Class="max-h-[320px]">
                    <CommandEmptyCn>No bookmarks found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Starred">
                        @foreach (var bookmark in _bookmarks.Where(b => b.Starred))
                        {
                            <CommandItemCn Class="py-2">
                                <div class="mr-2 flex h-6 w-6 items-center justify-center rounded border bg-muted">
                                    <LucideGlobeCn Size="12" Class="h-3 w-3 text-muted-foreground" />
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2">
                                        <span class="truncate">@bookmark.Title</span>
                                        <LucideStarCn Size="12" Class="h-3 w-3 fill-primary text-primary shrink-0" />
                                    </div>
                                    <p class="text-xs text-muted-foreground truncate">@bookmark.Url</p>
                                </div>
                                <LucideExternalLinkCn Size="12" Class="h-3 w-3 text-muted-foreground shrink-0" />
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandGroupCn Heading="All Bookmarks">
                        @foreach (var bookmark in _bookmarks.Where(b => !b.Starred))
                        {
                            <CommandItemCn Class="py-2">
                                <div class="mr-2 flex h-6 w-6 items-center justify-center rounded border bg-muted">
                                    <LucideGlobeCn Size="12" Class="h-3 w-3 text-muted-foreground" />
                                </div>
                                <div class="flex-1 min-w-0">
                                    <span class="truncate">@bookmark.Title</span>
                                    <p class="text-xs text-muted-foreground truncate">@bookmark.Url</p>
                                </div>
                                <LucideExternalLinkCn Size="12" Class="h-3 w-3 text-muted-foreground shrink-0" />
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn>
                        <CommandItemCn>
                            <LucidePlusCn Size="16" Class="mr-2 h-4 w-4" />
                            Add bookmark
                        </CommandItemCn>
                        <CommandItemCn>
                            <LucideFolderOpenCn Size="16" Class="mr-2 h-4 w-4" />
                            Manage folders
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record BookmarkItem(string Id, string Title, string Url, string Folder, bool Starred);

    private static readonly BookmarkItem[] _bookmarks =
    [
        new("1", "GitHub", "https://github.com", "Development", true),
        new("2", "Vercel Dashboard", "https://vercel.com/dashboard", "Development", true),
        new("3", "Figma", "https://figma.com", "Design", false),
        new("4", "Linear", "https://linear.app", "Productivity", false),
        new("5", "Notion", "https://notion.so", "Productivity", true),
        new("6", "Tailwind CSS Docs", "https://tailwindcss.com/docs", "Development", false),
    ];
}
