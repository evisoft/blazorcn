@* ============================================================
   Block: command-menu-analytics
   Title: Command Menu Analytics
   Description: Command menu for viewing analytics metrics, reports, and date ranges
   Dependencies: ButtonCn, CommandCn, KbdCn
   Source: original/blocks/command-menu/command-menu-analytics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" @onclick="() => _open = true">
            <LucideChartBarIncreasingCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Analytics</span>
            <KbdCn>@@A</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Command Menu</DialogTitleCn>
                <DialogDescriptionCn>Search and navigate.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
        <CommandInputCn Placeholder="Search metrics or reports..." />
        <CommandListCn>
            <CommandEmptyCn>No results found.</CommandEmptyCn>

            <CommandGroupCn Heading="Key Metrics">
                @foreach (var metric in _metrics)
                {
                    var trendColor = metric.Trend == "up" ? "text-emerald-600" : metric.Trend == "down" ? "text-red-600" : "text-muted-foreground";
                    <CommandItemCn Class="flex items-center gap-3">
                        <div class="flex size-6 shrink-0 items-center justify-center rounded-md bg-muted">
                            @switch (metric.Icon)
                            {
                                case "users":
                                    <LucideUsersCn Size="14" Class="size-3.5 text-muted-foreground" />
                                    break;
                                case "shopping-cart":
                                    <LucideShoppingCartCn Size="14" Class="size-3.5 text-muted-foreground" />
                                    break;
                                case "dollar-sign":
                                    <LucideDollarSignCn Size="14" Class="size-3.5 text-muted-foreground" />
                                    break;
                                case "mouse-pointer-click":
                                    <LucideMousePointerClickCn Size="14" Class="size-3.5 text-muted-foreground" />
                                    break;
                                case "percent":
                                    <LucidePercentCn Size="14" Class="size-3.5 text-muted-foreground" />
                                    break;
                                case "activity":
                                    <LucideActivityCn Size="14" Class="size-3.5 text-muted-foreground" />
                                    break;
                            }
                        </div>
                        <div class="flex min-w-0 flex-1 items-center justify-between">
                            <div class="flex min-w-0 flex-col">
                                <span class="text-sm font-medium">@metric.Label</span>
                                <span class="text-xs text-muted-foreground">Last 30 days</span>
                            </div>
                            <div class="flex shrink-0 items-center gap-3">
                                <span class="text-xl font-semibold tabular-nums">@metric.Value</span>
                                <div class="@Cn.Merge("flex items-center gap-1", trendColor)">
                                    @if (metric.Trend == "up")
                                    {
                                        <LucideArrowUpRightCn Size="14" Class="size-3.5" />
                                    }
                                    else if (metric.Trend == "down")
                                    {
                                        <LucideArrowDownRightCn Size="14" Class="size-3.5" />
                                    }
                                    <span class="text-xs font-medium">@metric.TrendValue</span>
                                </div>
                            </div>
                        </div>
                    </CommandItemCn>
                }
            </CommandGroupCn>

            <CommandSeparatorCn />

            <CommandGroupCn Heading="Reports">
                @foreach (var report in _reports)
                {
                    <CommandItemCn Class="flex items-center gap-3">
                        <div class="flex size-6 shrink-0 items-center justify-center rounded-md bg-muted">
                            @switch (report.Icon)
                            {
                                case "globe":
                                    <LucideGlobeCn Size="14" Class="size-3.5 text-muted-foreground" />
                                    break;
                                case "activity":
                                    <LucideActivityCn Size="14" Class="size-3.5 text-muted-foreground" />
                                    break;
                                case "pie-chart":
                                    <LucideChartPieCn Size="14" Class="size-3.5 text-muted-foreground" />
                                    break;
                                case "smartphone":
                                    <LucideSmartphoneCn Size="14" Class="size-3.5 text-muted-foreground" />
                                    break;
                            }
                        </div>
                        <div class="flex min-w-0 flex-1 flex-col">
                            <span class="text-sm font-medium">@report.Title</span>
                            <span class="text-xs text-muted-foreground">@report.Description</span>
                        </div>
                    </CommandItemCn>
                }
            </CommandGroupCn>

            <CommandSeparatorCn />

            <CommandGroupCn Heading="Date Range">
                @foreach (var range in _dateRanges)
                {
                    <CommandItemCn Class="flex items-center gap-3">
                        <LucideCalendarCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <div class="flex min-w-0 flex-1 items-center justify-between">
                            <div class="flex min-w-0 flex-col">
                                <span class="text-sm font-medium">@range.Label</span>
                                <span class="text-xs text-muted-foreground">@range.Description</span>
                            </div>
                            <KbdCn class="text-xs">@range.Shortcut</KbdCn>
                        </div>
                    </CommandItemCn>
                }
            </CommandGroupCn>
        </CommandListCn>
    </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record MetricItem(string Id, string Label, string Value, string Trend, string TrendValue, string Icon);
    private record ReportItem(string Id, string Title, string Description, string Icon);
    private record DateRangeItem(string Id, string Label, string Description, string Shortcut);

    private static readonly MetricItem[] _metrics =
    [
        new("visitors", "Total Visitors", "24.5K", "up", "12.3%", "users"),
        new("conversions", "Conversions", "1,847", "up", "8.7%", "shopping-cart"),
        new("revenue", "Revenue", "$89.2K", "up", "15.4%", "dollar-sign"),
        new("clicks", "Total Clicks", "156.8K", "down", "3.2%", "mouse-pointer-click"),
        new("conversion-rate", "Conversion Rate", "7.54%", "up", "1.2%", "percent"),
        new("bounce-rate", "Bounce Rate", "42.3%", "down", "5.1%", "activity"),
    ];

    private static readonly ReportItem[] _reports =
    [
        new("traffic-sources", "Traffic Sources", "Breakdown by channel and referrer", "globe"),
        new("user-behavior", "User Behavior Flow", "Path analysis and drop-off points", "activity"),
        new("conversion-funnel", "Conversion Funnel", "Step-by-step conversion analysis", "pie-chart"),
        new("device-breakdown", "Device Breakdown", "Mobile, desktop, and tablet usage", "smartphone"),
    ];

    private static readonly DateRangeItem[] _dateRanges =
    [
        new("today", "Today", "Current day metrics", "1"),
        new("7d", "Last 7 Days", "Week overview", "7"),
        new("30d", "Last 30 Days", "Monthly trends", "3"),
        new("90d", "Last 90 Days", "Quarterly analysis", "9"),
        new("custom", "Custom Range", "Select specific dates", "C"),
    ];
}
