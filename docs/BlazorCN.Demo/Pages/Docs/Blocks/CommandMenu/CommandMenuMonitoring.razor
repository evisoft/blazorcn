@* ============================================================
   Block: command-menu-monitoring
   Title: CommandMenuMonitoring
   Description: Service monitoring controls command menu with health checks, incident actions, and status toggles for React ops dashboards
   Source: original/blocks/command-menu/command-menu-monitoring.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" class="gap-2">
            <LucideHeartPulseCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Monitoring</span>
            <KbdCn>@@H</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Monitoring</DialogTitleCn>
                <DialogDescriptionCn>Service monitoring command menu with health checks and incident actions.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search services..." />
                <CommandListCn>
                    <CommandEmptyCn>No services found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Services">
                        @foreach (var svc in _services)
                        {
                            var service = svc;
                            <CommandItemCn @onclick="() => _open = false" class="gap-3">
                                @if (service.Status == ServiceStatus.Healthy)
                                {
                                    <LucideCircleCheckBigCn Size="16" Class="size-4 shrink-0 text-emerald-500" />
                                }
                                else if (service.Status == ServiceStatus.Degraded)
                                {
                                    <LucideTriangleAlertCn Size="16" Class="size-4 shrink-0 text-amber-500" />
                                }
                                else
                                {
                                    <LucideCircleXCn Size="16" Class="size-4 shrink-0 text-red-500" />
                                }
                                <div class="min-w-0 flex-1">
                                    <span class="text-sm font-medium">@service.Name</span>
                                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                                        <span>@service.Latency</span>
                                        <span>&middot;</span>
                                        <span>@service.Uptime</span>
                                        <span>&middot;</span>
                                        <span>@service.LastCheck</span>
                                    </div>
                                </div>
                                @if (service.Status == ServiceStatus.Healthy)
                                {
                                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                }
                                else if (service.Status == ServiceStatus.Degraded)
                                {
                                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                                }
                                else
                                {
                                    <span class="size-1.5 rounded-full bg-red-500"></span>
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn class="gap-3">
                            <LucideRefreshCwCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Run health checks</span>
                            <KbdCn class="ml-auto">@@R</KbdCn>
                        </CommandItemCn>
                        <CommandItemCn class="gap-3">
                            <LucideShieldAlertCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Create incident</span>
                            <KbdCn class="ml-auto">@@I</KbdCn>
                        </CommandItemCn>
                        <CommandItemCn class="gap-3">
                            <LucideBellOffCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Mute alerts (30 min)</span>
                            <KbdCn class="ml-auto">@@M</KbdCn>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-3 text-xs text-muted-foreground">
                        <LucideActivityCn Size="12" Class="size-3" />
                        <span>@_healthyCount healthy</span>
                        @if (_issueCount > 0)
                        {
                            <span>&middot;</span>
                            <span class="text-amber-500">@_issueCount issues</span>
                        }
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private enum ServiceStatus { Healthy, Degraded, Down }

    private record Service(string Id, string Name, ServiceStatus Status, string Latency, string Uptime, string LastCheck);

    private static readonly Service[] _services =
    [
        new("api",     "API Gateway",       ServiceStatus.Healthy,  "42ms",  "99.99%", "30s ago"),
        new("web",     "Web Application",   ServiceStatus.Healthy,  "120ms", "99.97%", "30s ago"),
        new("db",      "PostgreSQL Primary",ServiceStatus.Healthy,  "8ms",   "99.99%", "15s ago"),
        new("redis",   "Redis Cache",       ServiceStatus.Degraded, "245ms", "99.85%", "30s ago"),
        new("queue",   "Job Queue",         ServiceStatus.Healthy,  "15ms",  "99.98%", "1 min ago"),
        new("storage", "Object Storage",    ServiceStatus.Healthy,  "85ms",  "99.99%", "30s ago"),
        new("search",  "Search Engine",     ServiceStatus.Down,     "—",     "98.50%", "2 min ago"),
        new("mail",    "Email Service",     ServiceStatus.Healthy,  "320ms", "99.95%", "1 min ago"),
    ];

    private int _healthyCount => _services.Count(s => s.Status == ServiceStatus.Healthy);
    private int _issueCount   => _services.Count(s => s.Status != ServiceStatus.Healthy);
}
