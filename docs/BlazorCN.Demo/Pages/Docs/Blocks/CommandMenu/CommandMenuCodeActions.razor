@* ============================================================
   Block: command-menu-code-actions
   Title: CommandMenuCodeActions
   Description: Code-specific actions command menu with format, lint, refactor, and quick fix commands for React code editors
   Source: original/blocks/command-menu/command-menu-code-actions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" Class="gap-2">
            <LucideIconCn Name="code" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Code Actions</span>
            <KbdCn>&#x2318;&#x21E7;P</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Code Actions</DialogTitleCn>
                <DialogDescriptionCn>Search and run code actions for your editor.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search code actions..." />
                <CommandListCn>
                    <CommandEmptyCn>No code actions found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Format">
                        @foreach (var action in _formatActions)
                        {
                            var act = action;
                            <CommandItemCn Class="gap-3" OnSelect="@(() => _open = false)">
                                <LucideIconCn Name="@act.Icon" Size="16" Class="size-4 text-muted-foreground" />
                                <span class="flex-1 text-sm">@act.Label</span>
                                @if (act.Shortcut.Length > 0)
                                {
                                    <div class="flex gap-1">
                                        @foreach (var key in act.Shortcut)
                                        {
                                            <KbdCn>@key</KbdCn>
                                        }
                                    </div>
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Lint">
                        @foreach (var action in _lintActions)
                        {
                            var act = action;
                            <CommandItemCn Class="gap-3" OnSelect="@(() => _open = false)">
                                <LucideIconCn Name="@act.Icon" Size="16" Class="size-4 text-muted-foreground" />
                                <span class="flex-1 text-sm">@act.Label</span>
                                @if (act.Shortcut.Length > 0)
                                {
                                    <div class="flex gap-1">
                                        @foreach (var key in act.Shortcut)
                                        {
                                            <KbdCn>@key</KbdCn>
                                        }
                                    </div>
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Refactor">
                        @foreach (var action in _refactorActions)
                        {
                            var act = action;
                            <CommandItemCn Class="gap-3" OnSelect="@(() => _open = false)">
                                <LucideIconCn Name="@act.Icon" Size="16" Class="size-4 text-muted-foreground" />
                                <span class="flex-1 text-sm">@act.Label</span>
                                @if (act.Shortcut.Length > 0)
                                {
                                    <div class="flex gap-1">
                                        @foreach (var key in act.Shortcut)
                                        {
                                            <KbdCn>@key</KbdCn>
                                        }
                                    </div>
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideIconCn Name="file-code" Size="12" Class="size-3" />
                        <span>index.tsx &middot; TypeScript React</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record CodeAction(string Icon, string Label, string[] Shortcut);

    private static readonly CodeAction[] _formatActions =
    [
        new("align-left", "Format Document", ["⌘", "⇧", "F"]),
        new("indent-decrease", "Format Selection", ["⌘", "K", "F"]),
        new("wrap-text", "Toggle Word Wrap", ["⌥", "Z"]),
        new("braces", "Toggle Bracket Matching", []),
    ];

    private static readonly CodeAction[] _lintActions =
    [
        new("bug", "Run Linter", ["⌘", "⇧", "L"]),
        new("sparkles", "Fix All Auto-fixable", ["⌘", "."]),
        new("refresh-cw", "Restart Language Server", []),
    ];

    private static readonly CodeAction[] _refactorActions =
    [
        new("pen-tool", "Rename Symbol", ["F2"]),
        new("scissors", "Extract Function", ["⌘", "⇧", "R"]),
        new("code", "Extract Variable", ["⌘", "⇧", "V"]),
        new("file-code", "Move to New File", []),
        new("refresh-cw", "Convert to Arrow Function", []),
    ];
}
