@* ============================================================
   Block: command-menu-table-filter
   Title: Command Menu Table Filter
   Description: A command palette for advanced data table filtering with multi-column selection, active filter badges, and clear all functionality for complex data filtering
   Long Description: A powerful table filtering command menu that lets users filter by Status, Priority, Assignee, and Date Range with an intuitive interface. Shows active filters as dismissible badges and provides a clear all option. Perfect for data tables, admin panels, and analytics dashboards that need sophisticated filtering without cluttering the UI.
   Dependencies: BadgeCn, ButtonCn, CommandCn, DialogCn, KbdCn
   Source: original/blocks/command-menu/command-menu-table-filter.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" @onclick="() => _open = true">
            <LucideSearchCn Size="16" Class="mr-2 h-4 w-4" />
            <span>Command Menu Table Filter</span>
            <KbdCn class="ml-2">@@K</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Command Menu Table Filter</DialogTitleCn>
                <DialogDescriptionCn>A command palette for advanced data table filtering with multi-column selection, active filter badges, and clear all functionality for complex data filtering</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Type a command or search..." />
                <CommandListCn>
                    <CommandEmptyCn>No results found.</CommandEmptyCn>
                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn>
                            <LucideSearchCn Size="16" Class="mr-2 h-4 w-4 text-muted-foreground" />
                            <span>Search...</span>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
}
