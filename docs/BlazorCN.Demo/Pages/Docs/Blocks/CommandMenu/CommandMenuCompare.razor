@* ============================================================
   Block: command-menu-compare
   Title: CommandMenuCompare
   Description: Compare items side by side command menu with diff-style selection for React comparison tools
   Source: original/blocks/command-menu/command-menu-compare.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" @onclick="@(() => { _open = true; _selected = []; })">
            <LucideIconCn Name="git-compare-arrows" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Compare</span>
            <KbdCn>⌘⇧C</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Compare Documents</DialogTitleCn>
                <DialogDescriptionCn>Compare items side by side command menu with diff-style selection for React comparison tools</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search documents to compare..." />
                <CommandListCn>
                    <CommandEmptyCn>No documents found.</CommandEmptyCn>
                    <CommandGroupCn Heading="Select Two Documents">
                        @foreach (var doc in _documents)
                        {
                            var docItem = doc;
                            var isSelected = _selected.Contains(docItem.Id);
                            var selIndex = _selected.IndexOf(docItem.Id);
                            <CommandItemCn OnSelect="@(() => ToggleSelect(docItem.Id))" Class="gap-3">
                                <div class="@Cn.Merge("flex size-5 items-center justify-center rounded border", isSelected ? "border-blue-500 bg-blue-500 text-white" : "border-muted-foreground/30")">
                                    @if (isSelected)
                                    {
                                        <span class="text-xs font-medium">@(selIndex == 0 ? "A" : "B")</span>
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="square" Size="12" Class="size-3 text-transparent" />
                                    }
                                </div>
                                <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@docItem.Name</div>
                                    <p class="text-xs text-muted-foreground">
                                        @docItem.Author &middot; @docItem.Modified
                                    </p>
                                </div>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>
            </CommandCn>
            <div class="flex items-center justify-between border-t px-3 py-2">
                <div class="flex items-center gap-2 text-xs text-muted-foreground">
                    <LucideIconCn Name="copy" Size="12" Class="size-3" />
                    <span>@_selected.Count/2 selected</span>
                </div>
                <button type="button"
                        @onclick="HandleCompare"
                        disabled="@(_selected.Count != 2)"
                        class="flex items-center gap-1.5 rounded-md bg-primary px-3 py-1.5 text-xs font-medium text-primary-foreground disabled:opacity-50">
                    <LucideIconCn Name="git-compare-arrows" Size="12" Class="size-3" />
                    Compare
                </button>
            </div>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
    private List<string> _selected = [];

    private static readonly DocumentItem[] _documents =
    [
        new("1", "Q1 Report Draft",        "Mar 20, 2026", "Sarah C."),
        new("2", "Q1 Report Final",         "Mar 22, 2026", "Sarah C."),
        new("3", "API Documentation v2",    "Mar 18, 2026", "Marcus J."),
        new("4", "API Documentation v3",    "Mar 24, 2026", "Marcus J."),
        new("5", "Design Spec Alpha",       "Mar 15, 2026", "Elena R."),
        new("6", "Design Spec Beta",        "Mar 21, 2026", "Elena R."),
        new("7", "Sprint Retro Notes",      "Mar 19, 2026", "David K."),
        new("8", "Architecture Proposal",   "Mar 17, 2026", "David K."),
    ];

    private void ToggleSelect(string id)
    {
        if (_selected.Contains(id))
        {
            _selected = _selected.Where(s => s != id).ToList();
        }
        else if (_selected.Count >= 2)
        {
            _selected = [_selected[1], id];
        }
        else
        {
            _selected = [.._selected, id];
        }
    }

    private void HandleCompare()
    {
        if (_selected.Count == 2)
        {
            _open = false;
            _selected = [];
        }
    }

    private record DocumentItem(string Id, string Name, string Modified, string Author);
}
