@* ============================================================
   Block: command-menu-music
   Title: Command Menu Music
   Description: A media player command menu with playback controls, queue management, and playlist navigation for React applications
   Long Description: A music player command menu that provides complete media control without leaving your workflow.
   Dependencies: ButtonCn, CommandCn, CommandEmptyCn, CommandGroupCn, CommandInputCn, CommandItemCn, CommandListCn, DialogCn, DialogContentCn, DialogHeaderCn, DialogTitleCn, KbdCn, SliderCn, LucideClockCn, LucideDiscCn, LucideHeadphonesCn, LucideListMusicCn, LucideMusicCn, LucidePauseCn, LucidePlayCn, LucideSkipBackCn, LucideSkipForwardCn, LucideVolume2Cn
   Source: original/blocks/command-menu/command-menu-music.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" Class="gap-2">
            <LucideMusicCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Music Player</span>
            <KbdCn>⌘M</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn Open="_open" OpenChanged="v => _open = v">
        <DialogContentCn Class="max-w-2xl gap-0 p-0">
            <DialogHeaderCn Class="border-b px-4 py-3">
                <DialogTitleCn Class="sr-only">Music Player</DialogTitleCn>
                <div class="flex items-center gap-3">
                    <div class="flex size-12 shrink-0 items-center justify-center rounded-md bg-gradient-to-br from-purple-500/20 to-pink-500/20">
                        <LucideDiscCn Size="24" Class="size-6 text-purple-500" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="truncate text-sm font-medium">Tokyo Nights</div>
                        <p class="truncate text-xs text-muted-foreground">City Lights Orchestra</p>
                        <div class="mt-1 flex items-center gap-1 font-mono text-xs text-muted-foreground">
                            <span>2:31</span>
                            <span>/</span>
                            <span>4:05</span>
                        </div>
                    </div>
                </div>
            </DialogHeaderCn>

            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between gap-4">
                    <div class="flex items-center gap-2">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8" aria-label="Previous track">
                            <LucideSkipBackCn Size="16" Class="size-4" />
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="size-9"
                                  @onclick="() => _isPlaying = !_isPlaying" aria-label="Pause">
                            @if (_isPlaying)
                            {
                                <LucidePauseCn Size="16" Class="size-4" />
                            }
                            else
                            {
                                <LucidePlayCn Size="16" Class="size-4" />
                            }
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8" aria-label="Next track">
                            <LucideSkipForwardCn Size="16" Class="size-4" />
                        </ButtonCn>
                    </div>

                    <div class="flex flex-1 items-center gap-2">
                        <LucideVolume2Cn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <SliderCn Value="_volume" ValueChanged="v => _volume = v"
                                  Max="100" Step="1" Class="flex-1" />
                        <span class="w-8 text-right font-mono text-xs text-muted-foreground">
                            @((int)_volume)%
                        </span>
                    </div>
                </div>
            </div>

            <CommandCn Class="border-0">
                <CommandInputCn Placeholder="Search tracks, artists, or albums..." Class="border-0" />
                <CommandListCn Class="max-h-[320px]">
                    <CommandEmptyCn>No tracks found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Queue">
                        @for (var i = 0; i < _queueTracks.Count; i++)
                        {
                            var track = _queueTracks[i];
                            var index = i + 1;
                            <CommandItemCn Class="gap-3">
                                <div class="flex size-7 shrink-0 items-center justify-center rounded bg-muted font-mono text-xs text-muted-foreground">
                                    @index
                                </div>
                                <div class="min-w-0 flex-1">
                                    <div class="truncate text-sm font-medium">@track.Title</div>
                                    <p class="truncate text-xs text-muted-foreground">
                                        @track.Artist &#x2022; @track.Album
                                    </p>
                                </div>
                                <span class="shrink-0 font-mono text-xs text-muted-foreground">
                                    @track.Duration
                                </span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandGroupCn Heading="Playlists">
                        @foreach (var track in _playlistTracks)
                        {
                            <CommandItemCn Class="gap-3">
                                <LucideListMusicCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <div class="truncate text-sm font-medium">@track.Title</div>
                                    <p class="truncate text-xs text-muted-foreground">
                                        @track.Artist &#x2022; @track.Album
                                    </p>
                                </div>
                                <span class="shrink-0 font-mono text-xs text-muted-foreground">
                                    @track.Duration
                                </span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandGroupCn Heading="Recently Played">
                        @foreach (var track in _recentTracks)
                        {
                            <CommandItemCn Class="gap-3">
                                <LucideClockCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <div class="truncate text-sm font-medium">@track.Title</div>
                                    <p class="truncate text-xs text-muted-foreground">
                                        @track.Artist &#x2022; @track.Album
                                    </p>
                                </div>
                                <span class="shrink-0 font-mono text-xs text-muted-foreground">
                                    @track.Duration
                                </span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>
            </CommandCn>

            <div class="border-t px-4 py-2">
                <div class="flex items-center gap-2 text-xs text-muted-foreground">
                    <LucideHeadphonesCn Size="12" Class="size-3" />
                    <span>
                        @_queueTracks.Count tracks in queue &#x2022; @_playlistTracks.Count in playlist
                    </span>
                </div>
            </div>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
    private bool _isPlaying = true;
    private double _volume = 75;

    private record Track(string Title, string Artist, string Album, string Duration, string Type);

    private readonly List<Track> _allTracks =
    [
        new("Midnight Drive", "Luna Echo", "Urban Nights", "3:42", "queue"),
        new("Ocean Waves", "Coastal Dreams", "Serenity", "4:15", "queue"),
        new("Neon Lights", "Synthwave Collective", "Retro Future", "3:28", "queue"),
        new("Morning Coffee", "Jazz Ensemble", "Daily Rituals", "5:03", "playlist"),
        new("Electric Dreams", "Cyber Pulse", "Digital Horizons", "4:20", "playlist"),
        new("Rainy Day", "Ambient Collective", "Weather Moods", "6:12", "playlist"),
        new("Summer Breeze", "Acoustic Sessions", "Seasons", "3:55", "recent"),
        new("Starlight", "Celestial Sounds", "Cosmos", "4:38", "recent"),
    ];

    private List<Track> _queueTracks => _allTracks.Where(t => t.Type == "queue").ToList();
    private List<Track> _playlistTracks => _allTracks.Where(t => t.Type == "playlist").ToList();
    private List<Track> _recentTracks => _allTracks.Where(t => t.Type == "recent").ToList();
}
