@* ============================================================
   Block: command-menu-palette
   Title: Command Menu Palette
   Description: A VS Code style command palette with command prefix support and keyboard shortcut hints
   Dependencies: ButtonCn, CommandCn, KbdCn
   Source: original/blocks/command-menu/command-menu-palette.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" class="gap-2">
            <LucideTerminalCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Command Palette</span>
            <KbdCn>@@P</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Command Menu</DialogTitleCn>
                <DialogDescriptionCn>Search and navigate.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
        <CommandInputCn Placeholder="Type a command or search..." />
        <CommandListCn>
            <CommandEmptyCn>No commands found.</CommandEmptyCn>

            <CommandGroupCn Heading="Recently Used">
                @foreach (var cmd in _recentCommands)
                {
                    <CommandItemCn class="flex items-center gap-3">
                        <LucideClockCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <div class="flex min-w-0 flex-1 items-center justify-between">
                            <div class="flex min-w-0 flex-col">
                                <span class="text-sm font-medium">@cmd.Label</span>
                                @if (!string.IsNullOrEmpty(cmd.Description))
                                {
                                    <span class="text-xs text-muted-foreground">@cmd.Description</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(cmd.Shortcut))
                            {
                                <span class="shrink-0 font-mono text-xs text-muted-foreground">@cmd.Shortcut</span>
                            }
                        </div>
                    </CommandItemCn>
                }
            </CommandGroupCn>

            <CommandSeparatorCn />

            <CommandGroupCn Heading="Editor">
                @foreach (var cmd in _editorCommands)
                {
                    <CommandItemCn class="flex items-center gap-3">
                        <LucideCodeCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <div class="flex min-w-0 flex-1 items-center justify-between">
                            <span class="text-sm font-medium">@cmd.Label</span>
                            @if (!string.IsNullOrEmpty(cmd.Shortcut))
                            {
                                <span class="shrink-0 font-mono text-xs text-muted-foreground">@cmd.Shortcut</span>
                            }
                        </div>
                    </CommandItemCn>
                }
            </CommandGroupCn>

            <CommandSeparatorCn />

            <CommandGroupCn Heading="View">
                @foreach (var cmd in _viewCommands)
                {
                    <CommandItemCn class="flex items-center gap-3">
                        <LucideLayoutDashboardCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <div class="flex min-w-0 flex-1 items-center justify-between">
                            <span class="text-sm font-medium">@cmd.Label</span>
                            @if (!string.IsNullOrEmpty(cmd.Shortcut))
                            {
                                <span class="shrink-0 font-mono text-xs text-muted-foreground">@cmd.Shortcut</span>
                            }
                        </div>
                    </CommandItemCn>
                }
            </CommandGroupCn>

            <CommandSeparatorCn />

            <CommandGroupCn Heading="Go">
                @foreach (var cmd in _goCommands)
                {
                    <CommandItemCn class="flex items-center gap-3">
                        <LucideArrowRightCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <div class="flex min-w-0 flex-1 items-center justify-between">
                            <div class="flex min-w-0 flex-col">
                                <span class="text-sm font-medium">@cmd.Label</span>
                                @if (!string.IsNullOrEmpty(cmd.Description))
                                {
                                    <span class="text-xs text-muted-foreground">@cmd.Description</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(cmd.Shortcut))
                            {
                                <span class="shrink-0 font-mono text-xs text-muted-foreground">@cmd.Shortcut</span>
                            }
                        </div>
                    </CommandItemCn>
                }
            </CommandGroupCn>

            <CommandSeparatorCn />

            <CommandGroupCn Heading="Debug">
                @foreach (var cmd in _debugCommands)
                {
                    <CommandItemCn class="flex items-center gap-3">
                        <LucideBugCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <div class="flex min-w-0 flex-1 items-center justify-between">
                            <span class="text-sm font-medium">@cmd.Label</span>
                            @if (!string.IsNullOrEmpty(cmd.Shortcut))
                            {
                                <span class="shrink-0 font-mono text-xs text-muted-foreground">@cmd.Shortcut</span>
                            }
                        </div>
                    </CommandItemCn>
                }
            </CommandGroupCn>

            <CommandSeparatorCn />

            <CommandGroupCn Heading="Terminal">
                @foreach (var cmd in _terminalCommands)
                {
                    <CommandItemCn class="flex items-center gap-3">
                        <LucideTerminalCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <div class="flex min-w-0 flex-1 items-center justify-between">
                            <span class="text-sm font-medium">@cmd.Label</span>
                            @if (!string.IsNullOrEmpty(cmd.Shortcut))
                            {
                                <span class="shrink-0 font-mono text-xs text-muted-foreground">@cmd.Shortcut</span>
                            }
                        </div>
                    </CommandItemCn>
                }
            </CommandGroupCn>
        </CommandListCn>
    </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record CommandItem(string Label, string Shortcut = "", string Description = "");

    private static readonly CommandItem[] _recentCommands =
    [
        new("Format Document", "Shift+Alt+F"),
        new("Toggle Terminal", "Ctrl+`"),
        new("Go to File", "Ctrl+P", "Quick open any file"),
    ];

    private static readonly CommandItem[] _editorCommands =
    [
        new("Format Document", "Shift+Alt+F"),
        new("Toggle Word Wrap", "Alt+Z"),
        new("Toggle Minimap", ""),
        new("Change Language Mode", "Ctrl+K M"),
    ];

    private static readonly CommandItem[] _viewCommands =
    [
        new("Toggle Sidebar", "Ctrl+B"),
        new("Toggle Terminal", "Ctrl+`"),
        new("Toggle Problems", "Ctrl+Shift+M"),
        new("Zen Mode", "Ctrl+K Z"),
    ];

    private static readonly CommandItem[] _goCommands =
    [
        new("Go to File", "Ctrl+P", "Quick open any file"),
        new("Go to Symbol", "Ctrl+Shift+O", "Navigate to symbol"),
        new("Go to Line", "Ctrl+G", "Jump to line number"),
        new("Go to Definition", "F12", "Navigate to definition"),
    ];

    private static readonly CommandItem[] _debugCommands =
    [
        new("Start Debugging", "F5"),
        new("Toggle Breakpoint", "F9"),
        new("Step Over", "F10"),
        new("Step Into", "F11"),
    ];

    private static readonly CommandItem[] _terminalCommands =
    [
        new("New Terminal", "Ctrl+Shift+`"),
        new("Split Terminal", ""),
        new("Kill Terminal", ""),
        new("Clear Terminal", ""),
    ];
}
