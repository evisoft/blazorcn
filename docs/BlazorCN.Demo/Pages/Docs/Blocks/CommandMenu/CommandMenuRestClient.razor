@* ============================================================
   Block: command-menu-rest-client
   Title: CommandMenuRestClient
   Description: REST API client command menu with method badges, endpoint browsing, and request history for React developer tools
   Source: original/blocks/command-menu/command-menu-rest-client.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" @onclick="() => _open = true">
            <LucideIconCn Name="send" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">REST Client</span>
            <KbdCn>&#x2318;T</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogHeaderCn class="sr-only">
            <DialogTitleCn>REST Client</DialogTitleCn>
            <DialogDescriptionCn>Search and browse API endpoints.</DialogDescriptionCn>
        </DialogHeaderCn>
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <CommandCn>
                <CommandInputCn Placeholder="Search endpoints..." />
                <CommandListCn>
                    <CommandEmptyCn>No endpoints found.</CommandEmptyCn>

                    @foreach (var cat in _categories)
                    {
                        var category = cat;
                        var catIndex = System.Array.IndexOf(_categories, category);
                        @if (catIndex > 0)
                        {
                            <CommandSeparatorCn />
                        }
                        <CommandGroupCn Heading="@category">
                            @foreach (var ep in _endpoints.Where(e => e.Category == category))
                            {
                                var endpoint = ep;
                                var statusColor = endpoint.LastStatus.HasValue
                                    ? (GetStatusColor(endpoint.LastStatus.Value.ToString()[0].ToString()))
                                    : "";
                                <CommandItemCn Class="gap-3" OnSelect="@(() => _open = false)">
                                    <span class="@Cn.Merge("shrink-0 rounded px-1.5 py-0.5 font-mono text-xs font-medium", GetMethodColor(endpoint.Method))">
                                        @endpoint.Method
                                    </span>
                                    <div class="min-w-0 flex-1">
                                        <span class="text-sm font-medium">@endpoint.Name</span>
                                        <p class="truncate font-mono text-xs text-muted-foreground">@endpoint.Path</p>
                                    </div>
                                    @if (endpoint.LastStatus.HasValue)
                                    {
                                        <span class="@Cn.Merge("font-mono text-xs tabular-nums", statusColor)">@endpoint.LastStatus.Value</span>
                                    }
                                </CommandItemCn>
                            }
                        </CommandGroupCn>
                    }

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn Class="gap-3">
                            <LucideIconCn Name="play" Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Send request</span>
                            <KbdCn class="ml-auto">&#x2318;&#x23CE;</KbdCn>
                        </CommandItemCn>
                        <CommandItemCn Class="gap-3">
                            <LucideIconCn Name="plus" Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">New request</span>
                            <KbdCn class="ml-auto">&#x2318;N</KbdCn>
                        </CommandItemCn>
                        <CommandItemCn Class="gap-3">
                            <LucideIconCn Name="clock" Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Request history</span>
                            <KbdCn class="ml-auto">&#x2318;H</KbdCn>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideIconCn Name="globe" Size="12" Class="size-3" />
                        <span>@_endpoints.Length endpoints</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record Endpoint(string Id, string Method, string Path, string Name, string Category, int? LastStatus);

    private static readonly Endpoint[] _endpoints =
    [
        new("list-users",   "GET",    "/api/v1/users",     "List Users",    "Users",   200),
        new("create-user",  "POST",   "/api/v1/users",     "Create User",   "Users",   201),
        new("get-user",     "GET",    "/api/v1/users/:id", "Get User",      "Users",   200),
        new("update-user",  "PATCH",  "/api/v1/users/:id", "Update User",   "Users",   200),
        new("delete-user",  "DELETE", "/api/v1/users/:id", "Delete User",   "Users",   null),
        new("list-orders",  "GET",    "/api/v1/orders",    "List Orders",   "Orders",  200),
        new("create-order", "POST",   "/api/v1/orders",    "Create Order",  "Orders",  201),
        new("get-order",    "GET",    "/api/v1/orders/:id","Get Order",     "Orders",  null),
        new("health",       "GET",    "/api/health",       "Health Check",  "System",  200),
        new("metrics",      "GET",    "/api/metrics",      "Metrics",       "System",  200),
    ];

    private static readonly string[] _categories =
        _endpoints.Select(e => e.Category).Distinct().ToArray();

    private static string GetMethodColor(string method) => method switch
    {
        "GET"    => "text-emerald-600 bg-emerald-500/10",
        "POST"   => "text-blue-600 bg-blue-500/10",
        "PUT"    => "text-amber-600 bg-amber-500/10",
        "PATCH"  => "text-amber-600 bg-amber-500/10",
        "DELETE" => "text-red-600 bg-red-500/10",
        _        => "text-muted-foreground bg-muted",
    };

    private static string GetStatusColor(string firstDigit) => firstDigit switch
    {
        "2" => "text-emerald-500",
        "3" => "text-blue-500",
        "4" => "text-amber-500",
        "5" => "text-red-500",
        _   => "text-muted-foreground",
    };
}
