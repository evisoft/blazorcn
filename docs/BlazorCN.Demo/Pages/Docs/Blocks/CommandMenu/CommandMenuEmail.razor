@* ============================================================
   Block: command-menu-email
   Title: Command Menu Email
   Description: An email command palette with compose actions, folder navigation, quick actions, unread counts, and inline compose fields for efficient email management
   Long Description: A comprehensive email command menu that brings keyboard-first navigation to your email client. Features compose actions (new email, reply, forward), folder navigation with unread counts, and quick actions (mark read, archive, snooze). Includes inline compose fields for rapid email creation. Perfect for webmail clients, CRM tools, and productivity apps.
   Dependencies: BadgeCn, ButtonCn, CommandCn, DialogCn, InputCn, KbdCn, TextareaCn
   Source: original/blocks/command-menu/command-menu-email.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" @onclick="() => _open = true">
            <LucideSearchCn Size="16" Class="mr-2 h-4 w-4" />
            <span>Command Menu Email</span>
            <KbdCn class="ml-2">@@K</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Command Menu Email</DialogTitleCn>
                <DialogDescriptionCn>An email command palette with compose actions, folder navigation, quick actions, unread counts, and inline compose fields for efficient email management</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Type a command or search..." />
                <CommandListCn>
                    <CommandEmptyCn>No results found.</CommandEmptyCn>
                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn>
                            <LucideSearchCn Size="16" Class="mr-2 h-4 w-4 text-muted-foreground" />
                            <span>Search...</span>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
}
