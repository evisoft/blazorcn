@* ============================================================
   Block: command-menu-converter
   Title: CommandMenuConverter
   Description: Unit and currency converter command menu with real-time conversion display for React utility apps
   Source: original/blocks/command-menu/command-menu-converter.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" Class="gap-2">
            <LucideArrowRightLeftCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Converter</span>
            <KbdCn>⌘U</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Converter</DialogTitleCn>
                <DialogDescriptionCn>Unit and currency converter command menu with real-time conversion display for React utility apps</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search conversions..." />
                <CommandListCn>
                    <CommandEmptyCn>No conversions found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Length">
                        @foreach (var pair in _lengthConversions)
                        {
                            var item = pair;
                            <CommandItemCn class="gap-3" OnSelect="@(() => _open = false)">
                                <LucideRulerCn Size="16" Class="size-4 text-muted-foreground" />
                                <span class="text-sm">@item.From</span>
                                <LucideArrowRightLeftCn Size="12" Class="size-3 text-muted-foreground" />
                                <span class="text-sm">@item.To</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandGroupCn Heading="Weight">
                        @foreach (var pair in _weightConversions)
                        {
                            var item = pair;
                            <CommandItemCn class="gap-3" OnSelect="@(() => _open = false)">
                                <LucideScaleCn Size="16" Class="size-4 text-muted-foreground" />
                                <span class="text-sm">@item.From</span>
                                <LucideArrowRightLeftCn Size="12" Class="size-3 text-muted-foreground" />
                                <span class="text-sm">@item.To</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandGroupCn Heading="Temperature">
                        @foreach (var pair in _temperatureConversions)
                        {
                            var item = pair;
                            <CommandItemCn class="gap-3" OnSelect="@(() => _open = false)">
                                <LucideThermometerCn Size="16" Class="size-4 text-muted-foreground" />
                                <span class="text-sm">@item.From</span>
                                <LucideArrowRightLeftCn Size="12" Class="size-3 text-muted-foreground" />
                                <span class="text-sm">@item.To</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Currency">
                        @foreach (var pair in _currencyConversions)
                        {
                            var item = pair;
                            <CommandItemCn class="gap-3" OnSelect="@(() => _open = false)">
                                <LucideDollarSignCn Size="16" Class="size-4 text-muted-foreground" />
                                <span class="font-mono text-sm">@item.From</span>
                                <LucideArrowRightLeftCn Size="12" Class="size-3 text-muted-foreground" />
                                <span class="font-mono text-sm">@item.To</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandGroupCn Heading="Data &amp; Time">
                        @foreach (var pair in _dataConversions)
                        {
                            var item = pair;
                            <CommandItemCn class="gap-3" OnSelect="@(() => _open = false)">
                                @if (item.Category == "time")
                                {
                                    <LucideTimerCn Size="16" Class="size-4 text-muted-foreground" />
                                }
                                else
                                {
                                    <LucideZapCn Size="16" Class="size-4 text-muted-foreground" />
                                }
                                <span class="text-sm">@item.From</span>
                                <LucideArrowRightLeftCn Size="12" Class="size-3 text-muted-foreground" />
                                <span class="text-sm">@item.To</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideArrowRightLeftCn Size="12" Class="size-3" />
                        <span>Select a conversion pair to open calculator</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record ConversionPair(string Id, string From, string To, string Category);

    private static readonly ConversionPair[] _lengthConversions =
    [
        new("km-mi", "Kilometers", "Miles", "length"),
        new("m-ft", "Meters", "Feet", "length"),
        new("cm-in", "Centimeters", "Inches", "length"),
        new("px-rem", "Pixels", "REM", "length"),
    ];

    private static readonly ConversionPair[] _weightConversions =
    [
        new("kg-lb", "Kilograms", "Pounds", "weight"),
        new("g-oz", "Grams", "Ounces", "weight"),
    ];

    private static readonly ConversionPair[] _temperatureConversions =
    [
        new("c-f", "Celsius", "Fahrenheit", "temperature"),
        new("c-k", "Celsius", "Kelvin", "temperature"),
    ];

    private static readonly ConversionPair[] _currencyConversions =
    [
        new("usd-eur", "USD", "EUR", "currency"),
        new("usd-gbp", "USD", "GBP", "currency"),
        new("usd-jpy", "USD", "JPY", "currency"),
        new("eur-gbp", "EUR", "GBP", "currency"),
    ];

    private static readonly ConversionPair[] _dataConversions =
    [
        new("mb-gb", "Megabytes", "Gigabytes", "data"),
        new("kb-mb", "Kilobytes", "Megabytes", "data"),
        new("ms-s", "Milliseconds", "Seconds", "time"),
    ];
}
