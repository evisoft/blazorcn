@* ============================================================
   Block: command-menu-ai
   Title: AI Assistant Command Menu
   Description: AI assistant command menu with prompt suggestions and conversation starters
   Dependencies: BadgeCn, ButtonCn, CommandCn, DialogCn, KbdCn
   Source: original/blocks/command-menu/command-menu-ai.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" @onclick="() => _open = true">
            <LucideBotCn Size="16" Class="mr-2 h-4 w-4" />
            <span>Ask AI</span>
            <KbdCn class="ml-2">@@K</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogHeaderCn class="sr-only">
            <DialogTitleCn>AI Assistant</DialogTitleCn>
            <DialogDescriptionCn>Ask AI anything or select a prompt.</DialogDescriptionCn>
        </DialogHeaderCn>
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <CommandCn>
                @* Header with AI badge *@
                <div class="flex items-center gap-2 border-b px-3 py-2">
                    <BadgeCn Class="gap-1" Variant="BadgeVariant.Secondary">
                        <LucideSparklesCn Size="12" Class="h-3 w-3" />
                        AI
                    </BadgeCn>
                    <span class="text-sm text-muted-foreground">Ask anything or pick a prompt</span>
                </div>

                <CommandInputCn Placeholder="Ask AI anything..." />

                <CommandListCn Class="max-h-[350px]">
                    <CommandEmptyCn>
                        <div class="flex flex-col items-center py-6">
                            <LucideBotCn Size="40" Class="h-10 w-10 text-muted-foreground" />
                            <p class="mt-2 text-sm text-muted-foreground">
                                Type your question or select a prompt below
                            </p>
                        </div>
                    </CommandEmptyCn>

                    <CommandGroupCn Heading="Recent">
                        @foreach (var conv in _recentConversations)
                        {
                            <CommandItemCn>
                                <LucideHistoryCn Size="16" Class="mr-2 h-4 w-4" />
                                <span>@conv.Title</span>
                                <span class="ml-auto text-xs text-muted-foreground">@conv.Time</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandGroupCn Heading="Writing">
                        @foreach (var item in _writingPrompts)
                        {
                            <CommandItemCn>
                                @switch (item.Icon)
                                {
                                    case "pencil":
                                        <LucidePencilCn Size="16" Class="mr-2 h-4 w-4" />
                                        break;
                                    case "file-text":
                                        <LucideFileTextCn Size="16" Class="mr-2 h-4 w-4" />
                                        break;
                                    case "book-open":
                                        <LucideBookOpenCn Size="16" Class="mr-2 h-4 w-4" />
                                        break;
                                    case "wand":
                                        <LucideWandCn Size="16" Class="mr-2 h-4 w-4" />
                                        break;
                                }
                                <span>@item.Label</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandGroupCn Heading="Coding">
                        @foreach (var item in _codingPrompts)
                        {
                            <CommandItemCn>
                                @switch (item.Icon)
                                {
                                    case "code":
                                        <LucideCodeCn Size="16" Class="mr-2 h-4 w-4" />
                                        break;
                                    case "search":
                                        <LucideSearchCn Size="16" Class="mr-2 h-4 w-4" />
                                        break;
                                    case "lightbulb":
                                        <LucideLightbulbCn Size="16" Class="mr-2 h-4 w-4" />
                                        break;
                                    case "brain-circuit":
                                        <LucideBrainCircuitCn Size="16" Class="mr-2 h-4 w-4" />
                                        break;
                                }
                                <span>@item.Label</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandGroupCn Heading="Analysis">
                        @foreach (var item in _analysisPrompts)
                        {
                            <CommandItemCn>
                                @switch (item.Icon)
                                {
                                    case "file-text":
                                        <LucideFileTextCn Size="16" Class="mr-2 h-4 w-4" />
                                        break;
                                    case "lightbulb":
                                        <LucideLightbulbCn Size="16" Class="mr-2 h-4 w-4" />
                                        break;
                                    case "search":
                                        <LucideSearchCn Size="16" Class="mr-2 h-4 w-4" />
                                        break;
                                }
                                <span>@item.Label</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>

                @* Footer with submit *@
                <div class="flex items-center justify-between border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideMessageSquareCn Size="12" Class="h-3 w-3" />
                        <span>New conversation</span>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm">
                        <LucideSendCn Size="12" Class="mr-2 h-3 w-3" />
                        Send
                    </ButtonCn>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record ConversationItem(string Id, string Title, string Time);
    private record PromptItem(string Icon, string Label);

    private static readonly ConversationItem[] _recentConversations =
    [
        new("1", "API integration help", "2 hours ago"),
        new("2", "React component design", "Yesterday"),
        new("3", "Database optimization", "3 days ago"),
    ];

    private static readonly PromptItem[] _writingPrompts =
    [
        new("pencil", "Write an email"),
        new("file-text", "Summarize text"),
        new("book-open", "Explain concept"),
        new("wand", "Improve writing"),
    ];

    private static readonly PromptItem[] _codingPrompts =
    [
        new("code", "Write code"),
        new("search", "Debug code"),
        new("lightbulb", "Code review"),
        new("brain-circuit", "Explain code"),
    ];

    private static readonly PromptItem[] _analysisPrompts =
    [
        new("file-text", "Analyze data"),
        new("lightbulb", "Generate ideas"),
        new("search", "Research topic"),
    ];
}
