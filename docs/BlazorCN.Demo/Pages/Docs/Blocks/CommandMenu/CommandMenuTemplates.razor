@* ============================================================
   Block: command-menu-templates
   Title: CommandMenuTemplates
   Description: Template browser command menu with categories, previews, and quick-insert functionality for React content editors
   Source: original/blocks/command-menu/command-menu-templates.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" @onclick="() => _open = true">
            <LucideFolderOpenCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Templates</span>
            <KbdCn>⌘T</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogHeaderCn class="sr-only">
            <DialogTitleCn>Templates</DialogTitleCn>
            <DialogDescriptionCn>Browse and insert templates.</DialogDescriptionCn>
        </DialogHeaderCn>
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-md" ShowCloseButton="false">
            <CommandCn>
                <div class="flex items-center justify-between border-b px-3 py-2">
                    <div class="flex items-center gap-2">
                        <LucideFolderOpenCn Size="16" Class="size-4 text-muted-foreground" />
                        <span class="text-sm font-medium">Templates</span>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Variant="@(_showStarred ? ButtonVariant.Secondary : ButtonVariant.Ghost)" Class="h-7 text-xs gap-1.5" @onclick="() => _showStarred = !_showStarred">
                        <LucideStarCn Size="12" Class="@Cn.Merge("size-3", _showStarred ? "fill-current" : "")" />
                        Starred
                    </ButtonCn>
                </div>

                <CommandInputCn Placeholder="Search templates..." />

                <CommandListCn>
                    <CommandEmptyCn>No templates found.</CommandEmptyCn>

                    @{
                        var displayTemplates = _showStarred ? _templates.Where(t => t.Starred).ToArray() : _templates;
                        var categories = _categories;
                        for (int ci = 0; ci < categories.Length; ci++)
                        {
                            var category = categories[ci];
                            var categoryTemplates = displayTemplates.Where(t => t.Category == category).ToArray();
                            if (categoryTemplates.Length == 0) continue;
                            int idx = ci;
                            <div>
                                @if (idx > 0)
                                {
                                    <CommandSeparatorCn />
                                }
                                <CommandGroupCn Heading="@category">
                                    @foreach (var tmpl in categoryTemplates)
                                    {
                                        var t = tmpl;
                                        <CommandItemCn Class="gap-3" OnSelect="@(() => _open = false)">
                                            <LucideIconCn Name="@t.IconName" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                            <div class="min-w-0 flex-1">
                                                <div class="flex items-center gap-2">
                                                    <span class="text-sm font-medium">@t.Name</span>
                                                    @if (t.Starred)
                                                    {
                                                        <LucideStarCn Size="12" Class="size-3 fill-amber-400 text-amber-400" />
                                                    }
                                                </div>
                                                <p class="text-xs text-muted-foreground">@t.Description</p>
                                            </div>
                                            <span class="shrink-0 text-xs text-muted-foreground tabular-nums">@t.Uses uses</span>
                                        </CommandItemCn>
                                    }
                                </CommandGroupCn>
                            </div>
                        }
                    }

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn Class="gap-3">
                            <LucidePlusCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Create template from selection</span>
                            <KbdCn class="ml-auto">⌘⇧T</KbdCn>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideFolderOpenCn Size="12" Class="size-3" />
                        <span>@(_showStarred ? _templates.Count(t => t.Starred) : _templates.Length) templates</span>
                        @if (_showStarred)
                        {
                            <span>&middot; Showing starred only</span>
                        }
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
    private bool _showStarred;

    private record TemplateItem(string Id, string Name, string Description, string IconName, string Category, int Uses, bool Starred);

    private static readonly TemplateItem[] _templates =
    [
        new("welcome-email",    "Welcome Email",        "Onboarding email with CTA button",            "mail",            "Email",   342, true),
        new("newsletter",       "Newsletter",           "Weekly digest layout with sections",          "mail",            "Email",   128, false),
        new("password-reset",   "Password Reset",       "Secure password reset notification",          "mail",            "Email",    87, false),
        new("react-component",  "React Component",      "Functional component with TypeScript",        "code",            "Code",    215, true),
        new("api-route",        "API Route Handler",    "Next.js route handler with validation",       "code",            "Code",    176, true),
        new("prisma-model",     "Prisma Model",         "Database model with relations",               "code",            "Code",     94, false),
        new("blog-post",        "Blog Post",            "Article with hero image and metadata",        "file-text",       "Content", 156, false),
        new("changelog",        "Changelog Entry",      "Version release notes format",                "file-text",       "Content",  67, false),
        new("support-reply",    "Support Reply",        "Customer support response template",          "message-square",  "Content", 203, true),
        new("landing-hero",     "Landing Hero",         "Hero section with headline and CTA",          "layout",          "Blocks",  189, false),
        new("pricing-table",    "Pricing Table",        "3-tier pricing comparison",                   "layout",          "Blocks",  134, false),
    ];

    private static readonly string[] _categories =
        _templates.Select(t => t.Category).Distinct().ToArray();
}
