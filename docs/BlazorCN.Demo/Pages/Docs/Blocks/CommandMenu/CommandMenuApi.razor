@* ============================================================
   Block: command-menu-api
   Title: Command Menu API
   Description: API endpoint tester command menu with request builder and response preview
   Dependencies: BadgeCn, ButtonCn, CommandCn, DialogCn, KbdCn
   Source: original/blocks/command-menu/command-menu-api.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" @onclick="() => _open = true">
            <LucideZapCn Size="16" Class="mr-2 h-4 w-4" />
            <span>API Tester</span>
            <KbdCn class="ml-2">&#x21E7;@@P</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogHeaderCn class="sr-only">
            <DialogTitleCn>API Endpoint Tester</DialogTitleCn>
            <DialogDescriptionCn>Test API endpoints quickly.</DialogDescriptionCn>
        </DialogHeaderCn>
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <CommandCn>
                <div class="flex items-center justify-between border-b px-3 py-2">
                    <div class="flex items-center gap-2">
                        <LucideZapCn Size="16" Class="h-4 w-4" />
                        <span class="font-medium">API Tester</span>
                        <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">@_endpoints.Length endpoints</BadgeCn>
                    </div>
                    <KbdCn>&#x21E7;@@P</KbdCn>
                </div>

                <CommandInputCn Placeholder="Search endpoints..." />

                <CommandListCn Class="max-h-[320px]">
                    <CommandEmptyCn>No endpoints found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Recent">
                        @foreach (var item in _recentHistory)
                        {
                            var methodColor = GetMethodColor(item.Method);
                            var methodBg = GetMethodBg(item.Method);
                            <CommandItemCn Class="py-2">
                                <BadgeCn Class="@Cn.Merge(methodColor, methodBg, "border-0 font-mono text-xs mr-2")" Variant="BadgeVariant.Outline">@item.Method</BadgeCn>
                                <code class="flex-1 text-sm font-mono truncate">@item.Path</code>
                                <span class="text-xs text-muted-foreground flex items-center gap-1">
                                    <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">@item.Status</BadgeCn>
                                    @(item.Time)ms
                                </span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    @foreach (var category in _categories)
                    {
                        <CommandGroupCn Heading="@category">
                            @foreach (var endpoint in _endpoints.Where(e => e.Category == category))
                            {
                                var methodColor = GetMethodColor(endpoint.Method);
                                var methodBg = GetMethodBg(endpoint.Method);
                                <CommandItemCn Class="py-2">
                                    <BadgeCn Class="@Cn.Merge(methodColor, methodBg, "border-0 font-mono text-xs mr-2")" Variant="BadgeVariant.Outline">@endpoint.Method</BadgeCn>
                                    <div class="flex-1 min-w-0">
                                        <code class="text-sm font-mono">@endpoint.Path</code>
                                        <p class="text-xs text-muted-foreground truncate">@endpoint.Description</p>
                                    </div>
                                    <LucideArrowRightCn Size="16" Class="h-4 w-4 text-muted-foreground" />
                                </CommandItemCn>
                            }
                        </CommandGroupCn>
                    }
                </CommandListCn>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record EndpointItem(string Id, string Method, string Path, string Description, string Category);
    private record HistoryItem(string Id, string Method, string Path, int Status, int Time);

    private static string GetMethodColor(string method) => method switch
    {
        "GET" => "text-primary",
        "POST" => "text-green-600 dark:text-green-400",
        "PUT" => "text-amber-600 dark:text-amber-400",
        "DELETE" => "text-destructive",
        "PATCH" => "text-purple-600 dark:text-purple-400",
        _ => "text-primary",
    };

    private static string GetMethodBg(string method) => method switch
    {
        "GET" => "bg-primary/10",
        "POST" => "bg-green-500/10",
        "PUT" => "bg-amber-500/10",
        "DELETE" => "bg-destructive/10",
        "PATCH" => "bg-purple-500/10",
        _ => "bg-primary/10",
    };

    private static readonly string[] _categories = ["Users", "Products", "Orders", "System"];

    private static readonly EndpointItem[] _endpoints =
    [
        new("1", "GET", "/api/users", "List all users", "Users"),
        new("2", "GET", "/api/users/:id", "Get user by ID", "Users"),
        new("3", "POST", "/api/users", "Create new user", "Users"),
        new("4", "PUT", "/api/users/:id", "Update user", "Users"),
        new("5", "DELETE", "/api/users/:id", "Delete user", "Users"),
        new("6", "GET", "/api/products", "List products", "Products"),
        new("7", "GET", "/api/products/:id", "Get product", "Products"),
        new("8", "POST", "/api/orders", "Create order", "Orders"),
        new("9", "GET", "/api/orders", "List orders", "Orders"),
        new("10", "GET", "/api/health", "Health check", "System"),
    ];

    private static readonly HistoryItem[] _recentHistory =
    [
        new("h1", "GET", "/api/users", 200, 145),
        new("h2", "GET", "/api/products", 200, 89),
        new("h3", "POST", "/api/users", 201, 234),
    ];
}
