@* ============================================================
   Block: command-menu-connections
   Title: CommandMenuConnections
   Description: Database connection switcher command menu with status indicators and quick connect for React database tools
   Source: original/blocks/command-menu/command-menu-connections.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" Class="gap-2">
            <LucideDatabaseCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Connections</span>
            <KbdCn>⌘⇧O</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Connections</DialogTitleCn>
                <DialogDescriptionCn>Database connection switcher command menu with status indicators and quick connect for React database tools</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search connections..." />
                <CommandListCn>
                    <CommandEmptyCn>No connections found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Connections">
                        @foreach (var conn in _connections)
                        {
                            var connItem = conn;
                            <CommandItemCn @onclick="@(() => { _activeConnection = connItem.Id; _open = false; })" Class="gap-3">
                                <LucideServerCn Size="16" Class="size-4 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@connItem.Name</span>
                                        <span class="rounded bg-muted/50 px-1.5 py-0.5 text-xs text-muted-foreground">@connItem.Type</span>
                                    </div>
                                    <p class="font-mono text-xs text-muted-foreground">@connItem.Host</p>
                                </div>
                                @if (connItem.Status == "connected")
                                {
                                    <LucideCheckCircle2Cn Size="16" Class="size-4 text-emerald-500" />
                                }
                                else if (connItem.Status == "disconnected")
                                {
                                    <LucideCircleCn Size="16" Class="size-4 text-muted-foreground" />
                                }
                                else
                                {
                                    <LucideXCircleCn Size="16" Class="size-4 text-red-500" />
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn @onclick="@(() => _open = false)" Class="gap-3">
                            <LucidePlusCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">New Connection</span>
                            <div class="ml-auto flex gap-1">
                                <KbdCn>⌘</KbdCn>
                                <KbdCn>N</KbdCn>
                            </div>
                        </CommandItemCn>
                        <CommandItemCn @onclick="@(() => _open = false)" Class="gap-3">
                            <LucideRefreshCwCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Refresh All</span>
                        </CommandItemCn>
                        <CommandItemCn @onclick="@(() => _open = false)" Class="gap-3">
                            <LucideSettingsCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Connection Settings</span>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideDatabaseCn Size="12" Class="size-3" />
                        <span>Active: @(_connections.FirstOrDefault(c => c.Id == _activeConnection)?.Name)</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
    private string _activeConnection = "1";

    private record Connection(string Id, string Name, string Type, string Host, string Status);

    private static readonly Connection[] _connections =
    [
        new("1", "Production DB", "PostgreSQL", "db.prod.acme.com:5432", "connected"),
        new("2", "Staging DB", "PostgreSQL", "db.staging.acme.com:5432", "connected"),
        new("3", "Analytics", "ClickHouse", "analytics.acme.com:8123", "disconnected"),
        new("4", "Cache", "Redis", "redis.acme.com:6379", "connected"),
        new("5", "Legacy MySQL", "MySQL", "legacy.acme.com:3306", "error"),
    ];
}
