@* ============================================================
   Block: command-menu-tasks
   Title: Command Menu Tasks
   Description: Task manager command menu with quick add, priority flags, and due dates for React productivity apps
   Long Description: Manage tasks with this command menu component. Features quick task input, priority flags, due dates, checkboxes, and status filters. Perfect for project management tools or todo apps.
   Dependencies: BadgeCn, ButtonCn, CommandCn, DialogCn, KbdCn
   Source: original/blocks/command-menu/command-menu-tasks.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" @onclick="() => _open = true">
            <LucideSearchCn Size="16" Class="mr-2 h-4 w-4" />
            <span>Command Menu Tasks</span>
            <KbdCn class="ml-2">@@K</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Command Menu Tasks</DialogTitleCn>
                <DialogDescriptionCn>Task manager command menu with quick add, priority flags, and due dates for React productivity apps</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Type a command or search..." />
                <CommandListCn>
                    <CommandEmptyCn>No results found.</CommandEmptyCn>
                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn>
                            <LucideSearchCn Size="16" Class="mr-2 h-4 w-4 text-muted-foreground" />
                            <span>Search...</span>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
}
