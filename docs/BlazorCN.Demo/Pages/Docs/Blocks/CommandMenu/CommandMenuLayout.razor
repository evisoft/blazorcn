@* ============================================================
   Block: command-menu-layout
   Title: CommandMenuLayout
   Description: Layout preset switcher command menu with visual previews and responsive options for React page builders
   Source: original/blocks/command-menu/command-menu-layout.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" Class="gap-2">
            <LucideIconCn Name="layout" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Switch Layout</span>
            <KbdCn>⌘L</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-md" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Switch Layout</DialogTitleCn>
                <DialogDescriptionCn>Select a layout preset.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search layouts..." />

                <CommandListCn>
                    <CommandEmptyCn>No layouts found.</CommandEmptyCn>

                    @foreach (var grp in _categories)
                    {
                        var category = grp;
                        var isFirst = Array.IndexOf(_categories, category) == 0;
                        @if (!isFirst)
                        {
                            <CommandSeparatorCn />
                        }
                        <CommandGroupCn Heading="@category">
                            @foreach (var layout in _layouts)
                            {
                                @if (layout.Category == category)
                                {
                                    var item = layout;
                                    <CommandItemCn @onclick="() => HandleSelect(item.Id)" class="gap-3">
                                        <LucideIconCn Name="@item.Icon" Size="16" Class="size-4 text-muted-foreground" />
                                        <div class="min-w-0 flex-1">
                                            <span class="text-sm font-medium">@item.Name</span>
                                            <p class="text-xs text-muted-foreground">@item.Description</p>
                                        </div>
                                        @if (_activeLayout == item.Id)
                                        {
                                            <LucideIconCn Name="check" Size="16" Class="size-4 text-emerald-500" />
                                        }
                                    </CommandItemCn>
                                }
                            }
                        </CommandGroupCn>
                    }
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideIconCn Name="layout" Size="12" Class="size-3" />
                        <span>Current: @(_layouts.FirstOrDefault(l => l.Id == _activeLayout)?.Name ?? "")</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
    private string _activeLayout = "sidebar-left";

    private record LayoutPreset(string Id, string Name, string Description, string Icon, string Category);

    private static readonly LayoutPreset[] _layouts =
    [
        new("sidebar-left",       "Sidebar Left",       "Navigation sidebar on the left",         "panel-left",  "Sidebar"),
        new("sidebar-right",      "Sidebar Right",      "Panel sidebar on the right",             "panel-right", "Sidebar"),
        new("sidebar-collapsed",  "Collapsed Sidebar",  "Icon-only sidebar navigation",           "sidebar",     "Sidebar"),
        new("two-column",         "Two Column",         "Equal width two-column split",           "columns-2",   "Grid"),
        new("three-column",       "Three Column",       "Equal width three-column layout",        "grid",        "Grid"),
        new("stacked",            "Stacked",            "Full width stacked sections",            "rows",        "Grid"),
        new("dashboard-default",  "Dashboard Default",  "Sidebar with header and content area",   "layout",      "Dashboard"),
        new("dashboard-compact",  "Dashboard Compact",  "Compact sidebar with condensed spacing", "layout",      "Dashboard"),
        new("dashboard-wide",     "Dashboard Wide",     "Full-width content with top navigation", "layout",      "Dashboard"),
    ];

    private static readonly string[] _categories = _layouts.Select(l => l.Category).Distinct().ToArray();

    private void HandleSelect(string layoutId)
    {
        _activeLayout = layoutId;
        _open = false;
    }
}
