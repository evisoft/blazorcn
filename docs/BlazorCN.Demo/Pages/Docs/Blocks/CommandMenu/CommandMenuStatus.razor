@* ============================================================
   Block: command-menu-status
   Title: CommandMenuStatus
   Description: Status page manager command menu with component status, incident creation, and maintenance scheduling for React ops platforms
   Source: original/blocks/command-menu/command-menu-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" class="gap-2">
            <LucideGlobeCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Status Page</span>
            <KbdCn>⌘I</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-md" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Status Page</DialogTitleCn>
                <DialogDescriptionCn>Search and manage component statuses, incidents, and maintenance windows.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search components..." />
                <CommandListCn>
                    <CommandEmptyCn>No components found.</CommandEmptyCn>

                    @foreach (var grp in _groups)
                    {
                        var groupName = grp;
                        var groupIndex = System.Array.IndexOf(_groups, groupName);
                        @if (groupIndex > 0)
                        {
                            <CommandSeparatorCn />
                        }
                        <CommandGroupCn Heading="@groupName">
                            @foreach (var component in _components.Where(c => c.Group == groupName))
                            {
                                var cfg = _statusConfig[component.Status];
                                <CommandItemCn class="gap-3" @onclick="() => _open = false">
                                    @switch (component.Status)
                                    {
                                        case "operational":
                                            <LucideCircleCheckCn Size="16" Class="@($"size-4 shrink-0 {cfg.Color}")" />
                                            break;
                                        case "degraded":
                                            <LucideCircleMinusCn Size="16" Class="@($"size-4 shrink-0 {cfg.Color}")" />
                                            break;
                                        case "partial_outage":
                                            <LucideTriangleAlertCn Size="16" Class="@($"size-4 shrink-0 {cfg.Color}")" />
                                            break;
                                        case "major_outage":
                                            <LucideCircleXCn Size="16" Class="@($"size-4 shrink-0 {cfg.Color}")" />
                                            break;
                                        case "maintenance":
                                            <LucideWrenchCn Size="16" Class="@($"size-4 shrink-0 {cfg.Color}")" />
                                            break;
                                    }
                                    <div class="min-w-0 flex-1">
                                        <span class="text-sm font-medium">@component.Name</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span class="@($"text-xs {cfg.Color}")">@cfg.Label</span>
                                        <span class="@($"size-1.5 rounded-full {cfg.DotColor}")"></span>
                                    </div>
                                </CommandItemCn>
                            }
                        </CommandGroupCn>
                    }

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn class="gap-3">
                            <LucideCircleAlertCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Create incident</span>
                            <KbdCn class="ml-auto">⌘I</KbdCn>
                        </CommandItemCn>
                        <CommandItemCn class="gap-3">
                            <LucideCalendarCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Schedule maintenance</span>
                            <KbdCn class="ml-auto">⌘M</KbdCn>
                        </CommandItemCn>
                        <CommandItemCn class="gap-3">
                            <LucideBellCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Notify subscribers</span>
                            <KbdCn class="ml-auto">⌘N</KbdCn>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-3 text-xs text-muted-foreground">
                        <LucideGlobeCn Size="12" Class="size-3" />
                        <span>@OperationalCount operational</span>
                        @if (IssueCount > 0)
                        {
                            <span>&middot;</span>
                            <span class="text-amber-500">@IssueCount issues</span>
                        }
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private int OperationalCount => _components.Count(c => c.Status == "operational");
    private int IssueCount => _components.Count(c => c.Status != "operational" && c.Status != "maintenance");

    private record StatusComponent(string Id, string Name, string Status, string Group);

    private record StatusConfig(string Color, string DotColor, string Label);

    private static readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["operational"]    = new("text-emerald-500", "bg-emerald-500", "Operational"),
        ["degraded"]       = new("text-amber-500",   "bg-amber-500",   "Degraded"),
        ["partial_outage"] = new("text-amber-600",   "bg-amber-600",   "Partial Outage"),
        ["major_outage"]   = new("text-red-500",     "bg-red-500",     "Major Outage"),
        ["maintenance"]    = new("text-blue-500",    "bg-blue-500",    "Maintenance"),
    };

    private static readonly StatusComponent[] _components =
    [
        new("api",      "API",                "operational",   "Core Services"),
        new("web",      "Web Application",    "operational",   "Core Services"),
        new("auth",     "Authentication",     "operational",   "Core Services"),
        new("cdn",      "CDN",                "degraded",      "Infrastructure"),
        new("db",       "Database Cluster",   "operational",   "Infrastructure"),
        new("storage",  "File Storage",       "operational",   "Infrastructure"),
        new("email",    "Email Delivery",     "partial_outage","Third Party"),
        new("payments", "Payment Processing", "operational",   "Third Party"),
        new("search",   "Search Engine",      "maintenance",   "Third Party"),
    ];

    private static readonly string[] _groups =
        _components.Select(c => c.Group).Distinct().ToArray();
}
