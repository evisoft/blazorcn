@* ============================================================
   Block: command-menu-chat
   Title: CommandMenuChat
   Description: Quick chat message sender command menu with contact search and recent conversations for React messaging apps
   Source: original/blocks/command-menu/command-menu-chat.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" class="gap-2">
            <LucideMessageCircleCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Quick Chat</span>
            <KbdCn>⌘J</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Quick Chat</DialogTitleCn>
                <DialogDescriptionCn>Quick chat message sender command menu with contact search and recent conversations</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search people or channels..." />
                <CommandListCn>
                    <CommandEmptyCn>No conversations found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Recent">
                        @foreach (var chat in _recentChats)
                        {
                            var c = chat;
                            <CommandItemCn OnSelect="@(() => _open = false)" class="gap-3">
                                <div class="relative">
                                    <div class="flex size-8 items-center justify-center rounded-full bg-muted text-xs font-medium">
                                        @GetInitials(c.Name)
                                    </div>
                                    @if (c.Online)
                                    {
                                        <span class="absolute -bottom-0.5 -right-0.5 size-2.5 rounded-full border-2 border-background bg-emerald-500"></span>
                                    }
                                </div>
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@c.Name</div>
                                    <p class="truncate text-xs text-muted-foreground">@c.Message</p>
                                </div>
                                <span class="shrink-0 text-xs text-muted-foreground">@c.Time</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Channels">
                        @foreach (var channel in _channels)
                        {
                            var ch = channel;
                            <CommandItemCn OnSelect="@(() => _open = false)" class="gap-3">
                                <LucideHashCn Size="16" Class="size-4 text-muted-foreground" />
                                <span class="flex-1 text-sm font-medium">@ch.Name</span>
                                <span class="text-xs text-muted-foreground">@ch.Members members</span>
                                @if (ch.Unread > 0)
                                {
                                    <span class="flex size-5 items-center justify-center rounded-full bg-blue-500 text-xs font-medium text-white">@ch.Unread</span>
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandGroupCn Heading="Groups">
                        @foreach (var grp in _teamGroups)
                        {
                            var g = grp;
                            <CommandItemCn OnSelect="@(() => _open = false)" class="gap-3">
                                <LucideUsersCn Size="16" Class="size-4 text-muted-foreground" />
                                <span class="flex-1 text-sm font-medium">@g.Name</span>
                                <span class="text-xs text-muted-foreground">@g.Members members</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideSendCn Size="12" Class="size-3" />
                        <span>Select to open conversation</span>
                        <div class="ml-auto flex gap-1">
                            <KbdCn>↵</KbdCn>
                            <span>open</span>
                        </div>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record ChatItem(string Id, string Name, string Message, string Time, bool Online);
    private record ChannelItem(string Id, string Name, int Members, int Unread);
    private record TeamGroup(string Id, string Name, int Members);

    private static readonly ChatItem[] _recentChats =
    [
        new("1", "Sarah Chen", "Sounds good, let me check...", "2 min ago", true),
        new("2", "Marcus Johnson", "PR is ready for review", "15 min ago", true),
        new("3", "Elena Rodriguez", "Updated the design file", "1 hr ago", false),
        new("4", "David Kim", "Can we sync tomorrow?", "3 hr ago", false),
    ];

    private static readonly ChannelItem[] _channels =
    [
        new("general", "general", 24, 3),
        new("engineering", "engineering", 12, 0),
        new("design", "design", 8, 1),
        new("product", "product", 6, 0),
    ];

    private static readonly TeamGroup[] _teamGroups =
    [
        new("frontend", "Frontend Team", 5),
        new("backend", "Backend Team", 4),
        new("leadership", "Leadership", 3),
    ];

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', System.StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Select(p => p[0]));
    }
}
