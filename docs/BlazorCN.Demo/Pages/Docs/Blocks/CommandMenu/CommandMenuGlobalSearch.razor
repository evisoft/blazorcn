@* ============================================================
   Block: command-menu-global-search
   Title: CommandMenuGlobalSearch
   Description: Full-text global search command menu with categorized results and type indicators for React apps
   Source: original/blocks/command-menu/command-menu-global-search.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" class="gap-2">
            <LucideSearchCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Search Everything</span>
            <KbdCn>&#x2318;K</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Global Search</DialogTitleCn>
                <DialogDescriptionCn>Full-text global search command menu with categorized results and type indicators</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search pages, docs, people, tags..." />
                <CommandListCn>
                    <CommandEmptyCn>
                        <div class="flex flex-col items-center py-4">
                            <LucideSearchCn Size="32" Class="size-8 text-muted-foreground" />
                            <p class="mt-2 text-sm text-muted-foreground">No results found</p>
                        </div>
                    </CommandEmptyCn>

                    <CommandGroupCn Heading="Pages">
                        @foreach (var pg in _pages)
                        {
                            var itm = pg;
                            <CommandItemCn Class="gap-3" @onclick="@(() => _open = false)">
                                <LucideIconCn Name="@itm.Icon" Size="16" Class="size-4 text-muted-foreground" />
                                <span class="flex-1 text-sm font-medium">@itm.Title</span>
                                <span class="font-mono text-xs text-muted-foreground">@itm.Path</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Documentation">
                        @foreach (var dc in _documents)
                        {
                            var doc = dc;
                            <CommandItemCn Class="gap-3" @onclick="@(() => _open = false)">
                                <LucideIconCn Name="book-open" Size="16" Class="size-4 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@doc.Title</div>
                                    <p class="truncate text-xs text-muted-foreground">@doc.Match</p>
                                </div>
                                <span class="rounded bg-muted/50 px-1.5 py-0.5 text-xs text-muted-foreground">@doc.Type</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandGroupCn Heading="People">
                        @foreach (var us in _users)
                        {
                            var user = us;
                            <CommandItemCn Class="gap-3" @onclick="@(() => _open = false)">
                                <LucideUserCn Size="16" Class="size-4 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <span class="text-sm font-medium">@user.Name</span>
                                    <span class="ml-2 text-xs text-muted-foreground">@user.Email</span>
                                </div>
                                <span class="text-xs text-muted-foreground">@user.Role</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandGroupCn Heading="Tags">
                        @foreach (var tg in _tags)
                        {
                            var tag = tg;
                            <CommandItemCn Class="gap-3" @onclick="@(() => _open = false)">
                                <LucideHashCn Size="16" Class="size-4 text-muted-foreground" />
                                <span class="flex-1 text-sm font-medium">@tag.Name</span>
                                <span class="text-xs text-muted-foreground">@tag.Count items</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideSearchCn Size="12" Class="size-3" />
                        <span>Search across all content types</span>
                        <div class="ml-auto flex gap-1">
                            <KbdCn>&#x21B5;</KbdCn>
                            <span>open</span>
                        </div>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record PageItem(string Id, string Title, string Path, string Icon);
    private record DocItem(string Id, string Title, string Type, string Match);
    private record UserItem(string Id, string Name, string Email, string Role);
    private record TagItem(string Id, string Name, int Count);

    private static readonly PageItem[] _pages =
    [
        new("p1", "Dashboard",        "/dashboard",        "layout-dashboard"),
        new("p2", "Analytics Overview", "/analytics",      "layout-dashboard"),
        new("p3", "Team Settings",    "/settings/team",    "settings"),
        new("p4", "Billing & Plans",  "/settings/billing", "settings"),
    ];

    private static readonly DocItem[] _documents =
    [
        new("d1", "Getting Started Guide", "Docs", "...follow these steps to get started with your..."),
        new("d2", "API Authentication",    "Docs", "...use Bearer tokens for API authentication..."),
        new("d3", "Deployment Guide",      "Docs", "...deploy your application to production..."),
    ];

    private static readonly UserItem[] _users =
    [
        new("u1", "Sarah Chen",      "sarah@acme.com",  "Admin"),
        new("u2", "Marcus Johnson",  "marcus@acme.com", "Developer"),
        new("u3", "Elena Rodriguez", "elena@acme.com",  "Designer"),
    ];

    private static readonly TagItem[] _tags =
    [
        new("t1", "bug",              24),
        new("t2", "feature-request",  18),
        new("t3", "documentation",    12),
    ];
}
