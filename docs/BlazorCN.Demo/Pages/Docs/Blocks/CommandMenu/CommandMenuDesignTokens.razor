@* ============================================================
   Block: command-menu-design-tokens
   Title: CommandMenuDesignTokens
   Description: Design token browser command menu with color, spacing, and typography token exploration for React design systems
   Source: original/blocks/command-menu/command-menu-design-tokens.tsx
   ============================================================ *@

@inject IJSRuntime JS

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" Class="gap-2">
            <LucideIconCn Name="palette" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Design Tokens</span>
            <KbdCn class="ml-0">&#x2318;&#x21E7;T</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Design Tokens</DialogTitleCn>
                <DialogDescriptionCn>Design token browser command menu with color, spacing, and typography token exploration</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search tokens..." />
                <CommandListCn>
                    <CommandEmptyCn>No tokens found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Colors">
                        @foreach (var token in _colorTokens)
                        {
                            var tok = token;
                            <CommandItemCn @onclick="@(() => CopyToken(tok.Name, tok.Value))" Class="gap-3">
                                <LucideIconCn Name="droplet" Size="16" Class="size-4 text-muted-foreground" />
                                <span class="font-mono text-sm">@tok.Name</span>
                                <span class="flex-1 truncate font-mono text-xs text-muted-foreground">@tok.Value</span>
                                @if (_copiedToken == tok.Name)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                                }
                                else
                                {
                                    <LucideIconCn Name="copy" Size="14" Class="size-3.5 text-muted-foreground" />
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandGroupCn Heading="Spacing">
                        @foreach (var token in _spacingTokens)
                        {
                            var tok = token;
                            <CommandItemCn @onclick="@(() => CopyToken(tok.Name, tok.Value))" Class="gap-3">
                                <LucideIconCn Name="move" Size="16" Class="size-4 text-muted-foreground" />
                                <span class="font-mono text-sm">@tok.Name</span>
                                <span class="flex-1 font-mono text-xs text-muted-foreground">@tok.Value</span>
                                @if (_copiedToken == tok.Name)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                                }
                                else
                                {
                                    <LucideIconCn Name="copy" Size="14" Class="size-3.5 text-muted-foreground" />
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Typography">
                        @foreach (var token in _typographyTokens)
                        {
                            var tok = token;
                            <CommandItemCn @onclick="@(() => CopyToken(tok.Name, tok.Value))" Class="gap-3">
                                <LucideIconCn Name="type" Size="16" Class="size-4 text-muted-foreground" />
                                <span class="font-mono text-sm">@tok.Name</span>
                                <span class="flex-1 truncate font-mono text-xs text-muted-foreground">@tok.Value</span>
                                @if (_copiedToken == tok.Name)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                                }
                                else
                                {
                                    <LucideIconCn Name="copy" Size="14" Class="size-3.5 text-muted-foreground" />
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandGroupCn Heading="Shadows">
                        @foreach (var token in _shadowTokens)
                        {
                            var tok = token;
                            <CommandItemCn @onclick="@(() => CopyToken(tok.Name, tok.Value))" Class="gap-3">
                                <LucideIconCn Name="eclipse" Size="16" Class="size-4 text-muted-foreground" />
                                <span class="font-mono text-sm">@tok.Name</span>
                                <span class="flex-1 truncate font-mono text-xs text-muted-foreground">@tok.Value</span>
                                @if (_copiedToken == tok.Name)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                                }
                                else
                                {
                                    <LucideIconCn Name="copy" Size="14" Class="size-3.5 text-muted-foreground" />
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideIconCn Name="palette" Size="12" Class="size-3" />
                        <span>Click to copy token value</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
    private string? _copiedToken;

    private record Token(string Name, string Value, string? Preview = null);

    private static readonly Token[] _colorTokens =
    [
        new("--primary", "oklch(0.21 0.006 285.89)", "bg-primary"),
        new("--secondary", "oklch(0.97 0.001 286.38)", "bg-secondary"),
        new("--accent", "oklch(0.97 0.001 286.38)", "bg-accent"),
        new("--muted", "oklch(0.97 0.001 286.38)", "bg-muted"),
        new("--destructive", "oklch(0.58 0.22 27.33)", "bg-destructive"),
    ];

    private static readonly Token[] _spacingTokens =
    [
        new("--spacing-1", "0.25rem"),
        new("--spacing-2", "0.5rem"),
        new("--spacing-4", "1rem"),
        new("--spacing-8", "2rem"),
        new("--spacing-16", "4rem"),
    ];

    private static readonly Token[] _typographyTokens =
    [
        new("--font-sans", "Inter, system-ui, sans-serif"),
        new("--font-mono", "JetBrains Mono, monospace"),
        new("--text-sm", "0.875rem / 1.25rem"),
        new("--text-base", "1rem / 1.5rem"),
        new("--text-lg", "1.125rem / 1.75rem"),
    ];

    private static readonly Token[] _shadowTokens =
    [
        new("--shadow-sm", "0 1px 2px rgba(0,0,0,0.05)"),
        new("--shadow-md", "0 4px 6px rgba(0,0,0,0.1)"),
        new("--shadow-lg", "0 10px 15px rgba(0,0,0,0.1)"),
    ];

    private async Task CopyToken(string name, string value)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", $"{name}: {value}");
        _copiedToken = name;
        StateHasChanged();
        await Task.Delay(1500);
        _copiedToken = null;
    }
}
