@* ============================================================
   Block: command-menu-inventory
   Title: CommandMenuInventory
   Description: Inventory lookup command menu with stock levels, SKU search, and quick inventory actions for React e-commerce apps
   Source: original/blocks/command-menu/command-menu-inventory.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" class="gap-2">
            <LucidePackageCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Inventory</span>
            <KbdCn>⌘I</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-md" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Inventory</DialogTitleCn>
                <DialogDescriptionCn>Search products by name or SKU.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search by product name or SKU..." />
                <CommandListCn>
                    <CommandEmptyCn>No products found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Products">
                        @foreach (var prod in _products)
                        {
                            var product = prod;
                            var status = GetStockStatus(product);
                            <CommandItemCn OnSelect="() => _open = false" class="gap-3">
                                <LucideBoxCn Size="16" Class="size-4 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@product.Name</span>
                                        @if (product.Stock <= product.ReorderAt && product.Stock > 0)
                                        {
                                            <LucideAlertTriangleCn Size="12" Class="size-3 text-amber-500" />
                                        }
                                    </div>
                                    <p class="font-mono text-xs text-muted-foreground">
                                        @product.Sku &middot; @product.Warehouse
                                    </p>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="font-mono text-sm tabular-nums">@product.Stock</span>
                                    <span class="@($"size-1.5 rounded-full {status.Color}")" />
                                </div>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn OnSelect="() => _open = false" class="gap-3">
                            <LucidePlusCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Add Product</span>
                        </CommandItemCn>
                        <CommandItemCn OnSelect="() => _open = false" class="gap-3">
                            <LucideRefreshCwCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Stock Adjustment</span>
                        </CommandItemCn>
                        <CommandItemCn OnSelect="() => _open = false" class="gap-3">
                            <LucideTruckCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Create Purchase Order</span>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucidePackageCn Size="12" Class="size-3" />
                        <span>
                            @(_products.Count(p => p.Stock == 0)) out of stock &middot;
                            @(_products.Count(p => p.Stock > 0 && p.Stock <= p.ReorderAt)) low stock
                        </span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record Product(string Id, string Name, string Sku, int Stock, int ReorderAt, string Warehouse);
    private record StockStatus(string Color, string Label);

    private static readonly Product[] _products =
    [
        new("1", "Wireless Keyboard", "KB-2024-BLK", 342, 50, "NYC-01"),
        new("2", "USB-C Hub 7-port", "HB-7P-SLV", 28, 30, "NYC-01"),
        new("3", "Ergonomic Mouse", "MS-ERG-WHT", 156, 40, "LAX-02"),
        new("4", "Monitor Stand", "ST-MON-ALU", 8, 20, "LAX-02"),
        new("5", "Webcam 4K", "WC-4K-BLK", 0, 15, "NYC-01"),
        new("6", "Desk Mat XL", "DM-XL-GRY", 89, 25, "CHI-01"),
    ];

    private static StockStatus GetStockStatus(Product product)
    {
        if (product.Stock == 0) return new StockStatus("bg-red-500", "Out of stock");
        if (product.Stock <= product.ReorderAt) return new StockStatus("bg-amber-500", "Low stock");
        return new StockStatus("bg-emerald-500", "In stock");
    }
}
