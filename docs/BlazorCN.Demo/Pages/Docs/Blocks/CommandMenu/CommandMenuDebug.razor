@* ============================================================
   Block: command-menu-debug
   Title: CommandMenuDebug
   Description: Debug mode toggle command menu with development tools and diagnostic actions for React developer tools
   Source: original/blocks/command-menu/command-menu-debug.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" class="gap-2">
            <LucideBugCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Debug Tools</span>
            <KbdCn>@("⌘⇧I")</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Command Menu</DialogTitleCn>
                <DialogDescriptionCn>Search and navigate debug tools.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search debug tools..." />
                <CommandListCn>
                    <CommandEmptyCn>No debug tools found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Toggles">
                        @foreach (var tog in _toggles)
                        {
                            var toggle = tog;
                            <CommandItemCn class="gap-3">
                                @if (toggle.Id == "debug-mode")
                                {
                                    <LucideBugCn Size="16" Class="size-4 text-muted-foreground" />
                                }
                                else if (toggle.Id == "perf-overlay")
                                {
                                    <LucideGaugeCn Size="16" Class="size-4 text-muted-foreground" />
                                }
                                else if (toggle.Id == "grid-overlay")
                                {
                                    <LucideLayoutGridCn Size="16" Class="size-4 text-muted-foreground" />
                                }
                                else if (toggle.Id == "network-log")
                                {
                                    <LucideNetworkCn Size="16" Class="size-4 text-muted-foreground" />
                                }
                                else if (toggle.Id == "slow-network")
                                {
                                    <LucideWifiOffCn Size="16" Class="size-4 text-muted-foreground" />
                                }
                                else
                                {
                                    <LucideZapCn Size="16" Class="size-4 text-muted-foreground" />
                                }
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@toggle.Label</div>
                                    <p class="text-xs text-muted-foreground">@toggle.Description</p>
                                </div>
                                <SwitchCn Checked="@toggle.Enabled" CheckedChanged="@((val) => ToggleItem(toggle.Id, val))" />
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Actions">
                        @foreach (var act in _debugActions)
                        {
                            var action = act;
                            <CommandItemCn @onclick="() => _open = false" class="gap-3">
                                @if (action.Label == "Open Console")
                                {
                                    <LucideTerminalCn Size="16" Class="size-4 text-muted-foreground" />
                                }
                                else if (action.Label == "Inspect Element")
                                {
                                    <LucideEyeCn Size="16" Class="size-4 text-muted-foreground" />
                                }
                                else if (action.Label == "Hard Reload")
                                {
                                    <LucideRefreshCwCn Size="16" Class="size-4 text-muted-foreground" />
                                }
                                else
                                {
                                    <LucideTrash2Cn Size="16" Class="size-4 text-muted-foreground" />
                                }
                                <span class="flex-1 text-sm">@action.Label</span>
                                @if (action.Shortcut.Length > 0)
                                {
                                    <div class="flex gap-1">
                                        @foreach (var key in action.Shortcut)
                                        {
                                            <KbdCn>@key</KbdCn>
                                        }
                                    </div>
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideBugCn Size="12" Class="size-3" />
                        <span>@(_toggles.Count(t => t.Enabled)) debug tools active</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record DebugAction(string Label, string[] Shortcut);

    private sealed class DebugToggle
    {
        public string Id { get; init; } = "";
        public string Label { get; init; } = "";
        public string Description { get; init; } = "";
        public bool Enabled { get; set; }
    }

    private readonly List<DebugToggle> _toggles =
    [
        new() { Id = "debug-mode",   Label = "Debug Mode",              Description = "Enable verbose logging",       Enabled = false },
        new() { Id = "perf-overlay", Label = "Performance Overlay",     Description = "Show FPS and render times",    Enabled = false },
        new() { Id = "grid-overlay", Label = "Grid Overlay",            Description = "Display layout grid lines",    Enabled = false },
        new() { Id = "network-log",  Label = "Network Logger",          Description = "Log all API requests",         Enabled = false },
        new() { Id = "slow-network", Label = "Simulate Slow Network",   Description = "Throttle to 3G speed",         Enabled = false },
        new() { Id = "strict-mode",  Label = "Strict Mode",             Description = "Enable React strict mode checks", Enabled = true },
    ];

    private static readonly DebugAction[] _debugActions =
    [
        new("Open Console",      ["⌘", "⌥", "J"]),
        new("Inspect Element",   ["⌘", "⌥", "I"]),
        new("Hard Reload",       ["⌘", "⇧", "R"]),
        new("Clear All Storage", []),
    ];

    private void ToggleItem(string id, bool val)
    {
        var item = _toggles.FirstOrDefault(t => t.Id == id);
        if (item is not null)
            item.Enabled = val;
    }
}
