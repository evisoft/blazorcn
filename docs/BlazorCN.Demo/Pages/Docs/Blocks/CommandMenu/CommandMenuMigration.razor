@* ============================================================
   Block: command-menu-migration
   Title: CommandMenuMigration
   Description: Database migration actions command menu with version tracking, rollback, and status indicators for React admin tools
   Source: original/blocks/command-menu/command-menu-migration.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" Class="gap-2">
            <LucideDatabaseCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Migrations</span>
            <KbdCn>⇧⌘M</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Database Migrations</DialogTitleCn>
                <DialogDescriptionCn>Database migration actions command menu with version tracking, rollback, and status indicators</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search migrations..." />
                <CommandListCn>
                    <CommandEmptyCn>No migrations found.</CommandEmptyCn>

                    @if (_pending.Length > 0)
                    {
                        <CommandGroupCn Heading="@($"Pending ({_pending.Length})")">
                            @foreach (var mig in _pending)
                            {
                                var config = GetConfig(mig.Status);
                                <CommandItemCn Class="gap-3">
                                    <LucideIconCn Name="@config.IconName" Size="16" Class="@($"size-4 shrink-0 {config.Color}")" />
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-2">
                                            <span class="font-mono text-sm">@mig.Name</span>
                                        </div>
                                        <div class="flex items-center gap-2 text-xs text-muted-foreground">
                                            <span class="font-mono">@mig.Version</span>
                                            <span>&middot;</span>
                                            <span>@mig.Description</span>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-1">
                                        <KbdCn>
                                            <LucideArrowUpCn Size="12" Class="size-3" />
                                        </KbdCn>
                                    </div>
                                </CommandItemCn>
                            }
                        </CommandGroupCn>
                    }

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="@($"Applied ({_applied.Length})")">
                        @foreach (var mig in _applied)
                        {
                            var config = GetConfig(mig.Status);
                            <CommandItemCn Class="gap-3">
                                <LucideIconCn Name="@config.IconName" Size="16" Class="@($"size-4 shrink-0 {config.Color}")" />
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="font-mono text-sm">@mig.Name</span>
                                    </div>
                                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                                        <span class="font-mono">@mig.Version</span>
                                        <span>&middot;</span>
                                        <span>@mig.AppliedAt</span>
                                    </div>
                                </div>
                                <div class="flex items-center gap-1">
                                    <KbdCn>
                                        <LucideArrowDownCn Size="12" Class="size-3" />
                                    </KbdCn>
                                </div>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn Class="gap-3">
                            <LucidePlayCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Run all pending</span>
                            <KbdCn class="ml-auto">⌘↵</KbdCn>
                        </CommandItemCn>
                        <CommandItemCn Class="gap-3">
                            <LucideRotateCcwCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Rollback last migration</span>
                            <KbdCn class="ml-auto">⌘Z</KbdCn>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideDatabaseCn Size="12" Class="size-3" />
                        <span>@_applied.Length applied, @_pending.Length pending</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private enum MigrationStatus { Applied, Pending, Failed }

    private record Migration(string Id, string Version, string Name, MigrationStatus Status, string AppliedAt, string Description);

    private record StatusConfig(string IconName, string Color, string DotColor);

    private static StatusConfig GetConfig(MigrationStatus status) => status switch
    {
        MigrationStatus.Applied => new("check-circle", "text-emerald-500", "bg-emerald-500"),
        MigrationStatus.Pending => new("circle-dot", "text-amber-500", "bg-amber-500"),
        MigrationStatus.Failed  => new("clock", "text-red-500", "bg-red-500"),
        _ => new("circle-dot", "text-muted-foreground", "bg-muted"),
    };

    private static readonly Migration[] _migrations =
    [
        new("m1", "20260320_001", "add_user_preferences_table",  MigrationStatus.Pending, "", "Creates user_preferences with JSON settings column"),
        new("m2", "20260319_002", "add_index_orders_user_id",    MigrationStatus.Pending, "", "Adds composite index on orders(user_id, created_at)"),
        new("m3", "20260318_001", "alter_products_add_sku",      MigrationStatus.Applied, "3 hours ago",  "Adds SKU column with unique constraint to products"),
        new("m4", "20260317_001", "create_audit_log_table",      MigrationStatus.Applied, "1 day ago",    "Creates audit_log table for tracking changes"),
        new("m5", "20260316_002", "add_team_billing_columns",    MigrationStatus.Applied, "2 days ago",   "Adds billing_email and tax_id to teams"),
        new("m6", "20260316_001", "create_teams_table",          MigrationStatus.Applied, "2 days ago",   "Creates teams table with owner reference"),
        new("m7", "20260315_001", "initial_schema",              MigrationStatus.Applied, "3 days ago",   "Initial database schema with users and sessions"),
    ];

    private Migration[] _pending => [.. _migrations.Where(m => m.Status == MigrationStatus.Pending)];
    private Migration[] _applied => [.. _migrations.Where(m => m.Status == MigrationStatus.Applied)];
}
