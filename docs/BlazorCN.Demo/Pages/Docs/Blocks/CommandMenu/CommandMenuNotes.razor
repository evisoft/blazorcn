@* ============================================================
   Block: command-menu-notes
   Title: Command Menu Notes
   Description: Quick notes command menu with instant capture, recent notes, and search for React productivity apps
   Long Description: Capture notes with quick input, recent notes list, search, pinning, and timestamps. Perfect for productivity tools, note apps, or any React app with quick note features.
   Dependencies: BadgeCn, ButtonCn, CommandCn, DialogCn, KbdCn
   Source: original/blocks/command-menu/command-menu-notes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" @onclick="() => _open = true">
            <LucideSearchCn Size="16" Class="mr-2 h-4 w-4" />
            <span>Command Menu Notes</span>
            <KbdCn class="ml-2">@@K</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Command Menu Notes</DialogTitleCn>
                <DialogDescriptionCn>Quick notes command menu with instant capture, recent notes, and search for React productivity apps</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Type a command or search..." />
                <CommandListCn>
                    <CommandEmptyCn>No results found.</CommandEmptyCn>
                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn>
                            <LucideSearchCn Size="16" Class="mr-2 h-4 w-4 text-muted-foreground" />
                            <span>Search...</span>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
}
