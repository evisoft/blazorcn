@* ============================================================
   Block: command-menu-billing
   Title: CommandMenuBilling
   Description: Billing and invoice actions command menu with payment management and subscription controls for React SaaS apps
   Source: original/blocks/command-menu/command-menu-billing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" @onclick="() => _open = true">
            <LucideCreditCardCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Billing</span>
            <KbdCn>@@B</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Command Menu</DialogTitleCn>
                <DialogDescriptionCn>Search and navigate billing actions.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search billing actions..." />
                <CommandListCn>
                    <CommandEmptyCn>No billing actions found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Recent Invoices">
                        @foreach (var inv in _recentInvoices)
                        {
                            var invoice = inv;
                            <CommandItemCn Class="gap-3" OnSelect="@(() => _open = false)">
                                <LucideFileTextCn Size="16" Class="size-4 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@invoice.Id</div>
                                    <p class="text-xs text-muted-foreground">@invoice.Date</p>
                                </div>
                                <span class="text-sm font-medium tabular-nums">@invoice.Amount</span>
                                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                <LucideDownloadCn Size="14" Class="size-3.5 text-muted-foreground" />
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Actions">
                        @foreach (var act in _billingActions)
                        {
                            var action = act;
                            <CommandItemCn Class="gap-3" OnSelect="@(() => _open = false)">
                                @switch (action.Icon)
                                {
                                    case "trending-up":
                                        <LucideTrendingUpCn Size="16" Class="size-4 text-muted-foreground" />
                                        break;
                                    case "credit-card":
                                        <LucideCreditCardCn Size="16" Class="size-4 text-muted-foreground" />
                                        break;
                                    case "receipt":
                                        <LucideReceiptCn Size="16" Class="size-4 text-muted-foreground" />
                                        break;
                                    case "wallet":
                                        <LucideWalletCn Size="16" Class="size-4 text-muted-foreground" />
                                        break;
                                    case "refresh-cw":
                                        <LucideRefreshCwCn Size="16" Class="size-4 text-muted-foreground" />
                                        break;
                                }
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@action.Label</div>
                                    <p class="text-xs text-muted-foreground">@action.Description</p>
                                </div>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideSettingsCn Size="12" Class="size-3" />
                        <span>Current plan: Pro Yearly</span>
                        <span class="ml-auto">Next billing: Apr 1, 2026</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record InvoiceItem(string Id, string Amount, string Date, string Status);
    private record BillingActionItem(string Icon, string Label, string Description);

    private static readonly InvoiceItem[] _recentInvoices =
    [
        new("INV-0042", "$229.00", "Mar 1, 2026", "paid"),
        new("INV-0041", "$229.00", "Feb 1, 2026", "paid"),
        new("INV-0040", "$229.00", "Jan 1, 2026", "paid"),
        new("INV-0039", "$39.00", "Dec 1, 2025", "paid"),
    ];

    private static readonly BillingActionItem[] _billingActions =
    [
        new("trending-up", "Upgrade Plan", "Change your subscription tier"),
        new("credit-card", "Update Payment Method", "Change card or billing info"),
        new("receipt", "View All Invoices", "Full billing history"),
        new("wallet", "Add Credits", "Purchase usage credits"),
        new("refresh-cw", "Cancel Subscription", "Downgrade to free plan"),
    ];
}
