@* ============================================================
   Block: command-menu-environment
   Title: CommandMenuEnvironment
   Description: Environment switcher command menu with status indicators and deployment context for React multi-env apps
   Source: original/blocks/command-menu/command-menu-environment.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" Class="gap-2">
            <LucideIconCn Name="server" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Switch Environment</span>
            <KbdCn>&#8984;E</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-md" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Switch Environment</DialogTitleCn>
                <DialogDescriptionCn>Select a deployment environment.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search environments..." />
                <CommandListCn>
                    <CommandEmptyCn>No environments found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Environments">
                        @foreach (var env in _environments)
                        {
                            var envItem = env;
                            <CommandItemCn OnSelect="@(() => { if (!envItem.Locked) { _activeEnv = envItem.Id; _open = false; } })" Class="gap-3">
                                <LucideIconCn Name="@envItem.Icon" Size="16" Class="size-4 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@envItem.Name</span>
                                        @if (envItem.Locked)
                                        {
                                            <LucideIconCn Name="lock" Size="12" Class="size-3 text-muted-foreground" />
                                        }
                                    </div>
                                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                                        <span class="font-mono">@envItem.Url</span>
                                        <span>&middot;</span>
                                        <LucideIconCn Name="git-branch" Size="12" Class="size-3" />
                                        <span>@envItem.Branch</span>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="font-mono text-xs text-muted-foreground">@envItem.Version</span>
                                    <span class="@($"size-1.5 rounded-full {StatusColor(envItem.Status)}")" />
                                </div>
                                @if (_activeEnv == envItem.Id)
                                {
                                    <LucideIconCn Name="check" Size="16" Class="size-4 text-emerald-500" />
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideIconCn Name="rocket" Size="12" Class="size-3" />
                        <span>Active: @(_environments.FirstOrDefault(e => e.Id == _activeEnv)?.Name)</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
    private string _activeEnv = "local";

    private record EnvItem(string Id, string Name, string Url, string Branch, string Icon, string Status, string Version, bool Locked);

    private static readonly EnvItem[] _environments =
    [
        new("local",   "Local Development", "localhost:3000",   "feat/new-ui",   "monitor",    "healthy",   "dev",             false),
        new("dev",     "Development",        "dev.acme.com",    "develop",        "test-tube",  "healthy",   "v2.14.0-dev.42",  false),
        new("staging", "Staging",            "staging.acme.com","release/2.14",  "cloud",      "deploying", "v2.14.0-rc.3",    false),
        new("prod",    "Production",         "acme.com",        "main",           "server",     "healthy",   "v2.13.2",         true),
    ];

    private static string StatusColor(string status) => status switch
    {
        "healthy"   => "bg-emerald-500",
        "deploying" => "bg-blue-500",
        "degraded"  => "bg-amber-500",
        _           => "bg-muted",
    };
}
