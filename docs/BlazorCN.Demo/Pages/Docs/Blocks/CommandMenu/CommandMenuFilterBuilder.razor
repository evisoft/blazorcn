@* ============================================================
   Block: command-menu-filter-builder
   Title: CommandMenuFilterBuilder
   Description: Advanced filter builder command menu with field selection and operator-based query construction for React data apps
   Source: original/blocks/command-menu/command-menu-filter-builder.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" @onclick="() => _open = true">
            <LucideIconCn Name="filter" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Add Filter</span>
            <KbdCn>&#x2318;&#x21E7;F</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Filter Builder</DialogTitleCn>
                <DialogDescriptionCn>Advanced filter builder command menu with field selection and operator-based query construction</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search fields to filter..." />
                <CommandListCn>
                    <CommandEmptyCn>No filter fields found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Saved Filters">
                        @foreach (var filter in _savedFilters)
                        {
                            var f = filter;
                            <CommandItemCn Class="gap-3" OnSelect="@(() => _open = false)">
                                <LucideIconCn Name="filter" Size="16" Class="size-4 text-muted-foreground" />
                                <span class="flex-1 text-sm font-medium">@f.Name</span>
                                <span class="text-xs text-muted-foreground">@f.Conditions conditions</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Filter by Field">
                        @foreach (var field in _filterFields)
                        {
                            var fld = field;
                            var isActive = _activeFilters.Contains(fld.Id);
                            <CommandItemCn Class="gap-3" OnSelect="@(() => ToggleFilter(fld.Id))">
                                <LucideIconCn Name="@fld.IconName" Size="16" Class="size-4 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@fld.Name</div>
                                    <p class="text-xs text-muted-foreground">@string.Join(", ", fld.Operators)</p>
                                </div>
                                @if (isActive)
                                {
                                    <LucideIconCn Name="check" Size="16" Class="size-4 text-emerald-500" />
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideIconCn Name="filter" Size="12" Class="size-3" />
                        <span>@_activeFilters.Count filter@(_activeFilters.Count != 1 ? "s" : "") applied</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
    private List<string> _activeFilters = [];

    private void ToggleFilter(string id)
    {
        if (_activeFilters.Contains(id))
            _activeFilters.Remove(id);
        else
            _activeFilters.Add(id);
    }

    private record FilterField(string Id, string Name, string Type, string IconName, string[] Operators);

    private record SavedFilter(string Id, string Name, int Conditions);

    private static readonly FilterField[] _filterFields =
    [
        new("name",     "Name",         "text",    "text",        ["contains", "equals", "starts with", "ends with"]),
        new("email",    "Email",        "text",    "text",        ["contains", "equals", "ends with"]),
        new("status",   "Status",       "select",  "tag",         ["is", "is not", "is any of"]),
        new("created",  "Created Date", "date",    "calendar",    ["before", "after", "between", "on"]),
        new("amount",   "Amount",       "number",  "hash",        ["equals", "greater than", "less than", "between"]),
        new("assignee", "Assignee",     "select",  "user",        ["is", "is not", "is unassigned"]),
        new("priority", "Priority",     "select",  "list",        ["is", "is not", "is any of"]),
        new("active",   "Active",       "boolean", "toggle-left", ["is true", "is false"]),
    ];

    private static readonly SavedFilter[] _savedFilters =
    [
        new("active-customers", "Active Customers",  3),
        new("high-value",       "High Value Orders", 2),
        new("recent-signups",   "Recent Sign-ups",   2),
    ];
}
