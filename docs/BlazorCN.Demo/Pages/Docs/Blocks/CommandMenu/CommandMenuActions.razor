@* ============================================================
   Block: command-menu-actions
   Title: Command Menu Actions
   Description: Command menu with keyboard shortcuts display and document management actions
   Dependencies: ButtonCn, CommandCn, DialogCn, KbdCn
   Source: original/blocks/command-menu/command-menu-actions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" @onclick="() => _open = true">
            <span>Open Command Menu</span>
            <KbdCn class="ml-2">@@K</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogHeaderCn class="sr-only">
            <DialogTitleCn>Command Menu</DialogTitleCn>
            <DialogDescriptionCn>Use the command menu to navigate and perform actions.</DialogDescriptionCn>
        </DialogHeaderCn>
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <CommandCn Class="**:data-[slot=command-input-wrapper]:border-b">
                <div class="flex items-center gap-2 border-b px-3">
                    <CommandInputCn Class="h-12" Placeholder="What do you need?" />
                    <button class="shrink-0" @onclick="() => _open = false" type="button">
                        <KbdCn>Esc</KbdCn>
                    </button>
                </div>

                <CommandListCn Class="max-h-[400px]">
                    <CommandEmptyCn>No results found.</CommandEmptyCn>

                    <CommandGroupCn>
                        <CommandItemCn Class="py-2.5">
                            <LucideSettingsCn Size="16" Class="mr-2 h-4 w-4" />
                            Account Settings...
                            <div class="ml-auto flex gap-1">
                                <KbdCn>@@</KbdCn>
                                <KbdCn>,</KbdCn>
                            </div>
                        </CommandItemCn>
                        <CommandItemCn Class="py-2.5">
                            <LucideUserCn Size="16" Class="mr-2 h-4 w-4" />
                            Switch Workspace...
                        </CommandItemCn>
                        <CommandItemCn Class="py-2.5">
                            <LucideLogOutCn Size="16" Class="mr-2 h-4 w-4" />
                            Log Out
                            <div class="ml-auto flex gap-1">
                                <KbdCn>@@</KbdCn>
                                <KbdCn>Q</KbdCn>
                            </div>
                        </CommandItemCn>
                    </CommandGroupCn>

                    <CommandGroupCn Heading="Documents">
                        <CommandItemCn Class="py-2.5">
                            <LucideFileCn Size="16" Class="mr-2 h-4 w-4" />
                            Search Documents...
                            <div class="ml-auto flex gap-1">
                                <KbdCn>@@</KbdCn>
                                <KbdCn>F</KbdCn>
                            </div>
                        </CommandItemCn>
                        <CommandItemCn Class="py-2.5">
                            <LucidePlusCn Size="16" Class="mr-2 h-4 w-4" />
                            Create New Document...
                            <div class="ml-auto flex gap-1">
                                <KbdCn>@@</KbdCn>
                                <KbdCn>N</KbdCn>
                            </div>
                        </CommandItemCn>
                        <CommandItemCn Class="py-2.5">
                            <LucideFileCn Size="16" Class="mr-2 h-4 w-4" />
                            Upload Document...
                            <div class="ml-auto flex gap-1">
                                <KbdCn>@@</KbdCn>
                                <KbdCn>U</KbdCn>
                            </div>
                        </CommandItemCn>
                    </CommandGroupCn>

                    <CommandGroupCn Heading="Signing">
                        <CommandItemCn Class="py-2.5">
                            <LucideSendCn Size="16" Class="mr-2 h-4 w-4" />
                            Request Signature...
                        </CommandItemCn>
                        <CommandItemCn Class="py-2.5">
                            <LucidePencilCn Size="16" Class="mr-2 h-4 w-4" />
                            Sign a Document...
                        </CommandItemCn>
                        <CommandItemCn Class="py-2.5">
                            <LucideUsersCn Size="16" Class="mr-2 h-4 w-4" />
                            Bulk Send for Signature...
                        </CommandItemCn>
                    </CommandGroupCn>

                    <CommandGroupCn Heading="General">
                        <CommandItemCn Class="py-2.5">
                            <LucideMonitorCn Size="16" Class="mr-2 h-4 w-4" />
                            Change Theme...
                            <div class="ml-auto flex gap-1">
                                <KbdCn>@@</KbdCn>
                                <KbdCn>T</KbdCn>
                            </div>
                        </CommandItemCn>
                        <CommandItemCn Class="py-2.5">
                            <LucideCopyCn Size="16" Class="mr-2 h-4 w-4" />
                            Copy Current URL
                            <div class="ml-auto flex gap-1">
                                <KbdCn>@@</KbdCn>
                                <KbdCn>&#x21E7;</KbdCn>
                                <KbdCn>C</KbdCn>
                            </div>
                        </CommandItemCn>
                    </CommandGroupCn>

                    <CommandGroupCn Heading="Navigation">
                        <CommandItemCn Class="py-2.5">
                            <LucideArrowRightCn Size="16" Class="mr-2 h-4 w-4" />
                            <span>Go to <strong class="font-semibold">Inbox</strong></span>
                        </CommandItemCn>
                        <CommandItemCn Class="py-2.5">
                            <LucideArrowRightCn Size="16" Class="mr-2 h-4 w-4" />
                            <span>Go to <strong class="font-semibold">Drafts</strong></span>
                        </CommandItemCn>
                        <CommandItemCn Class="py-2.5">
                            <LucideArrowRightCn Size="16" Class="mr-2 h-4 w-4" />
                            <span>Go to <strong class="font-semibold">Templates</strong></span>
                        </CommandItemCn>
                        <CommandItemCn Class="py-2.5">
                            <LucideArrowRightCn Size="16" Class="mr-2 h-4 w-4" />
                            <span>Go to <strong class="font-semibold">Archive</strong></span>
                        </CommandItemCn>
                        <CommandItemCn Class="py-2.5">
                            <LucideArrowRightCn Size="16" Class="mr-2 h-4 w-4" />
                            <span>Go to <strong class="font-semibold">Settings</strong></span>
                        </CommandItemCn>
                    </CommandGroupCn>

                    <CommandGroupCn Heading="Quick Actions">
                        <CommandItemCn Class="py-2.5">
                            <LucideLinkCn Size="16" Class="mr-2 h-4 w-4" />
                            Copy Signing Link
                        </CommandItemCn>
                        <CommandItemCn Class="py-2.5">
                            <LucideDownloadCn Size="16" Class="mr-2 h-4 w-4" />
                            Download Document
                        </CommandItemCn>
                    </CommandGroupCn>

                    <CommandGroupCn Heading="Help">
                        <CommandItemCn Class="py-2.5">
                            <LucideFileSearchCn Size="16" Class="mr-2 h-4 w-4" />
                            Search Help Center...
                        </CommandItemCn>
                        <CommandItemCn Class="py-2.5">
                            <LucideMessageSquareCn Size="16" Class="mr-2 h-4 w-4" />
                            Send Feedback...
                        </CommandItemCn>
                        <CommandItemCn Class="py-2.5">
                            <LucideAtSignCn Size="16" Class="mr-2 h-4 w-4" />
                            Contact Support
                        </CommandItemCn>
                        <CommandItemCn Class="py-2.5">
                            <LucideKeyboardCn Size="16" Class="mr-2 h-4 w-4" />
                            View Keyboard Shortcuts
                            <div class="ml-auto flex gap-1">
                                <KbdCn>@@</KbdCn>
                                <KbdCn>/</KbdCn>
                            </div>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
}
