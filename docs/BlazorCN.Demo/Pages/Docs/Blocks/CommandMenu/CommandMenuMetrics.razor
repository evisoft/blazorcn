@* ============================================================
   Block: command-menu-metrics
   Title: CommandMenuMetrics
   Description: Metrics dashboard quick view command menu with real-time indicators and trend data for React dashboards
   Source: original/blocks/command-menu/command-menu-metrics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" @onclick="() => _open = true">
            <LucideGaugeCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Metrics</span>
            <KbdCn>⌘M</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Command Menu</DialogTitleCn>
                <DialogDescriptionCn>Search and navigate.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search metrics..." />
                <CommandListCn>
                    <CommandEmptyCn>No metrics found.</CommandEmptyCn>

                    @foreach (var cat in _categories)
                    {
                        var category = cat;
                        var isFirst = category == _categories[0];
                        @if (!isFirst)
                        {
                            <CommandSeparatorCn />
                        }
                        <CommandGroupCn Heading="@category">
                            @foreach (var m in _metrics)
                            {
                                var metric = m;
                                @if (metric.Category == category)
                                {
                                    var trendColor = (metric.Id == "latency-p99" || metric.Id == "memory")
                                        ? (metric.Trend == "up" ? "text-amber-600" : "text-emerald-600")
                                        : (metric.Trend == "up" ? "text-emerald-600" : "text-red-600");
                                    <CommandItemCn Class="gap-3" OnSelect="@(() => _open = false)">
                                        @switch (metric.Icon)
                                        {
                                            case "zap":
                                                <LucideZapCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "users":
                                                <LucideUsersCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "clock":
                                                <LucideClockCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "cpu":
                                                <LucideCpuCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "hard-drive":
                                                <LucideHardDriveCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "activity":
                                                <LucideActivityCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                            case "wifi":
                                                <LucideWifiCn Size="16" Class="size-4 text-muted-foreground" />
                                                break;
                                        }
                                        <div class="min-w-0 flex-1">
                                            <span class="text-sm font-medium">@metric.Name</span>
                                        </div>
                                        <div class="flex items-center gap-3">
                                            <span class="text-lg font-semibold tabular-nums">@metric.Value</span>
                                            <span class="text-xs text-muted-foreground">@metric.Unit</span>
                                            <div class="@Cn.Merge("flex items-center gap-0.5", trendColor)">
                                                @if (metric.Trend == "up")
                                                {
                                                    <LucideArrowUpRightCn Size="14" Class="size-3.5" />
                                                }
                                                else
                                                {
                                                    <LucideArrowDownRightCn Size="14" Class="size-3.5" />
                                                }
                                                <span class="text-xs font-medium tabular-nums">@metric.TrendValue</span>
                                            </div>
                                            @{
                                                var statusClass = metric.Status == "healthy" ? "bg-emerald-500" : metric.Status == "warning" ? "bg-amber-500" : "bg-red-500";
                                            }
                                            <span class="@Cn.Merge("size-1.5 rounded-full", statusClass)"></span>
                                        </div>
                                    </CommandItemCn>
                                }
                            }
                        </CommandGroupCn>
                    }
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideGaugeCn Size="12" Class="size-3" />
                        <span>@(_metrics.Length) metrics tracked</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record MetricItem(
        string Id,
        string Name,
        string Value,
        string Unit,
        string Trend,
        string TrendValue,
        string Status,
        string Icon,
        string Category);

    private static readonly MetricItem[] _metrics =
    [
        new("requests",     "Requests/sec",  "2,847", "req/s", "up",   "12%",   "healthy", "zap",        "Traffic"),
        new("active-users", "Active Users",  "1,204", "users", "up",   "8%",    "healthy", "users",      "Traffic"),
        new("latency-p99",  "P99 Latency",   "245",   "ms",    "up",   "18%",   "warning", "clock",      "Performance"),
        new("latency-p50",  "P50 Latency",   "42",    "ms",    "down", "5%",    "healthy", "clock",      "Performance"),
        new("cpu",          "CPU Usage",     "67",    "%",     "up",   "4%",    "healthy", "cpu",        "Infrastructure"),
        new("memory",       "Memory Usage",  "82",    "%",     "up",   "6%",    "warning", "hard-drive", "Infrastructure"),
        new("error-rate",   "Error Rate",    "0.12",  "%",     "down", "3%",    "healthy", "activity",   "Reliability"),
        new("uptime",       "Uptime",        "99.98", "%",     "up",   "0.01%", "healthy", "wifi",       "Reliability"),
    ];

    private static readonly string[] _categories = ["Traffic", "Performance", "Infrastructure", "Reliability"];
}
