@* ============================================================
   Block: command-menu-hooks
   Title: CommandMenuHooks
   Description: Webhook management command menu with endpoint listing, test triggers, and delivery logs for React API platforms
   Source: original/blocks/command-menu/command-menu-hooks.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" class="gap-2">
            <LucideWebhookCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Webhooks</span>
            <KbdCn>@("⌘H")</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Command Menu</DialogTitleCn>
                <DialogDescriptionCn>Search and navigate.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search webhooks..." />
                <CommandListCn>
                    <CommandEmptyCn>No webhooks found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Webhooks">
                        @foreach (var hook in _webhooks)
                        {
                            var item = hook;
                            <CommandItemCn OnSelect="@(() => _open = false)" class="gap-3">
                                <LucideLinkCn Size="16" Class="size-4 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <div class="truncate font-mono text-sm">@item.Url</div>
                                    <p class="text-xs text-muted-foreground">@string.Join(", ", item.Events)</p>
                                </div>
                                <span class="font-mono text-xs text-muted-foreground">@item.SuccessRate</span>
                                <LucideIconCn Name="@StatusIconName(item.Status)" Size="16" Class="@($"size-4 {StatusColor(item.Status)}")" />
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn OnSelect="@(() => _open = false)" class="gap-3">
                            <LucidePlusCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Create Webhook</span>
                        </CommandItemCn>
                        <CommandItemCn OnSelect="@(() => _open = false)" class="gap-3">
                            <LucideSendCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Send Test Event</span>
                        </CommandItemCn>
                        <CommandItemCn OnSelect="@(() => _open = false)" class="gap-3">
                            <LucideRefreshCwCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Retry Failed Deliveries</span>
                        </CommandItemCn>
                        <CommandItemCn OnSelect="@(() => _open = false)" class="gap-3">
                            <LucidePlayCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Resume All Paused</span>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideWebhookCn Size="12" Class="size-3" />
                        <span>
                            @(_webhooks.Count(w => w.Status == "active")) active &middot;
                            @(_webhooks.Count(w => w.Status == "failing")) failing
                        </span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record WebhookItem(string Id, string Url, string[] Events, string Status, string SuccessRate);

    private static readonly WebhookItem[] _webhooks =
    [
        new("1", "https://api.slack.com/webhooks/T0123", ["issue.created", "issue.resolved"], "active", "99.8%"),
        new("2", "https://hooks.zapier.com/abc123", ["user.signup", "user.upgraded"], "active", "100%"),
        new("3", "https://n8n.acme.com/webhook/xyz", ["payment.success", "payment.failed"], "failing", "82.3%"),
        new("4", "https://api.pagerduty.com/incidents", ["alert.triggered"], "paused", "97.1%"),
    ];

    private static string StatusIconName(string status) => status switch
    {
        "active" => "check-circle-2",
        "paused" => "pause",
        "failing" => "x-circle",
        _ => "circle"
    };

    private static string StatusColor(string status) => status switch
    {
        "active" => "text-emerald-500",
        "paused" => "text-amber-500",
        "failing" => "text-red-500",
        _ => "text-muted-foreground"
    };
}
