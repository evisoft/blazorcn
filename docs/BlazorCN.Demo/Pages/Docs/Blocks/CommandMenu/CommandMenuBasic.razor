@* ============================================================
   Block: command-menu-basic
   Title: Command Menu Basic
   Description: Basic command menu with grouped navigation items and keyboard shortcut trigger for React apps
   Long Description: Basic command menu with grouped navigation items (workspace, analytics, settings), search filtering, and keyboard shortcut activation. Perfect for dashboards, admin panels, or any app needing quick access to features.
   Dependencies: ButtonCn, CommandCn, KbdCn
   Source: original/blocks/command-menu/command-menu-basic.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" @onclick="() => _open = true">
            <LucideSearchCn Size="16" Class="mr-2 h-4 w-4" />
            <span>Command Menu Basic</span>
            <KbdCn class="ml-2">@@K</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Command Menu Basic</DialogTitleCn>
                <DialogDescriptionCn>Basic command menu with grouped navigation items and keyboard shortcut trigger for React apps</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Type a command or search..." />
                <CommandListCn>
                    <CommandEmptyCn>No results found.</CommandEmptyCn>
                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn>
                            <LucideSearchCn Size="16" Class="mr-2 h-4 w-4 text-muted-foreground" />
                            <span>Search...</span>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
}
