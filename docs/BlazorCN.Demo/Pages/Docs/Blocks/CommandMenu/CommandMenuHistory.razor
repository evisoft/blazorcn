@* ============================================================
   Block: command-menu-history
   Title: Command Menu History
   Description: A command palette for browsing action history with time-grouped entries, action type filtering, and clear history functionality for tracking user activity
   Long Description: A comprehensive history command menu that organizes recent actions by time periods (Just Now, Earlier Today, Yesterday). Each entry displays an action type icon, description, and timestamp. Features include filtering by action type and a clear history function. Ideal for activity logs, audit trails, and undo/redo systems.
   Dependencies: BadgeCn, ButtonCn, CommandCn, KbdCn, PopoverCn
   Source: original/blocks/command-menu/command-menu-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" @onclick="() => _open = true">
            <LucideSearchCn Size="16" Class="mr-2 h-4 w-4" />
            <span>Command Menu History</span>
            <KbdCn class="ml-2">@@K</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Command Menu History</DialogTitleCn>
                <DialogDescriptionCn>A command palette for browsing action history with time-grouped entries, action type filtering, and clear history functionality for tracking user activity</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Type a command or search..." />
                <CommandListCn>
                    <CommandEmptyCn>No results found.</CommandEmptyCn>
                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn>
                            <LucideSearchCn Size="16" Class="mr-2 h-4 w-4 text-muted-foreground" />
                            <span>Search...</span>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
}
