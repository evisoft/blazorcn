@* ============================================================
   Block: command-menu-preview
   Title: CommandMenuPreview
   Description: Content preview launcher command menu with environment targets, device modes, and sharing options for React CMS tools
   Source: original/blocks/command-menu/command-menu-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" Class="gap-2">
            <LucideIconCn Name="eye" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Preview</span>
            <KbdCn>&#8984;P</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Preview</DialogTitleCn>
                <DialogDescriptionCn>Content preview launcher command menu with environment targets, device modes, and sharing options.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <div class="flex items-center justify-between border-b px-3 py-2">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="eye" Size="16" Class="size-4 text-muted-foreground" />
                        <span class="text-sm font-medium">Preview</span>
                    </div>
                    <div class="flex items-center gap-1">
                        @foreach (var device in _deviceModes)
                        {
                            var dev = device;
                            <ButtonCn
                                Size="ButtonSize.Sm"
                                Variant="@(_activeDevice == dev.Id ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                                Class="h-7 px-2"
                                @onclick="@(() => _activeDevice = dev.Id)">
                                <LucideIconCn Name="@dev.Icon" Size="14" Class="size-3.5" />
                            </ButtonCn>
                        }
                    </div>
                </div>
                <CommandInputCn Placeholder="Search pages..." />
                <CommandListCn>
                    <CommandEmptyCn>No pages found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Pages">
                        @foreach (var page in _pages)
                        {
                            var pg = page;
                            var dotColor = GetDotColor(pg.Status);
                            <CommandItemCn OnSelect="@(() => _open = false)" Class="gap-3">
                                <LucideIconCn Name="external-link" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@pg.Name</span>
                                        <span class="@($"size-1.5 rounded-full {dotColor}")" />
                                    </div>
                                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                                        <span class="font-mono">@pg.Url</span>
                                        <span>&middot;</span>
                                        <span>@pg.LastEdited</span>
                                    </div>
                                </div>
                                <KbdCn>&#8629;</KbdCn>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn Class="gap-3">
                            <LucideIconCn Name="link" Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Copy preview link</span>
                            <KbdCn class="ml-auto">&#8984;C</KbdCn>
                        </CommandItemCn>
                        <CommandItemCn Class="gap-3">
                            <LucideIconCn Name="share" Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Share preview</span>
                            <KbdCn class="ml-auto">&#8984;S</KbdCn>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideIconCn Name="monitor" Size="12" Class="size-3" />
                        <span>
                            @(_deviceModes.FirstOrDefault(d => d.Id == _activeDevice)?.Name) &middot;
                            @(_deviceModes.FirstOrDefault(d => d.Id == _activeDevice)?.Width)
                        </span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
    private string _activeDevice = "desktop";

    private record PreviewTarget(string Id, string Name, string Url, string Status, string LastEdited);
    private record DeviceMode(string Id, string Name, string Icon, string Width);

    private static readonly PreviewTarget[] _pages =
    [
        new("home",       "Home Page",           "/",                    "published", "2 hours ago"),
        new("pricing",    "Pricing",             "/pricing",             "draft",     "30 min ago"),
        new("blog-launch","Product Launch Post", "/blog/product-launch", "draft",     "15 min ago"),
        new("about",      "About Us",            "/about",               "published", "1 day ago"),
        new("docs-api",   "API Documentation",   "/docs/api",            "published", "3 hours ago"),
        new("changelog",  "Changelog",           "/changelog",           "scheduled", "1 hour ago"),
    ];

    private static readonly DeviceMode[] _deviceModes =
    [
        new("desktop", "Desktop",   "monitor",    "1440px"),
        new("tablet",  "Tablet",    "tablet",     "768px"),
        new("mobile",  "Mobile",    "smartphone", "375px"),
    ];

    private static string GetDotColor(string status) => status switch
    {
        "draft"     => "bg-amber-500",
        "published" => "bg-emerald-500",
        "scheduled" => "bg-blue-500",
        _           => "bg-muted",
    };
}
