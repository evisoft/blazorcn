@* ============================================================
   Block: command-menu-accounts
   Title: CommandMenuAccounts
   Description: Account switching command menu with workspace and profile selection for multi-tenant React apps
   Source: original/blocks/command-menu/command-menu-accounts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" Class="gap-2">
            <LucideUsersCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Switch Account</span>
            <KbdCn>⌘.</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Switch Account</DialogTitleCn>
                <DialogDescriptionCn>Account switching command menu with workspace and profile selection for multi-tenant React apps</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search accounts..." />
                <CommandListCn>
                    <CommandEmptyCn>No accounts found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Accounts">
                        @foreach (var acct in _accounts)
                        {
                            var account = acct;
                            <CommandItemCn @onclick="@(() => { _activeAccount = account.Id; _open = false; })" Class="gap-3">
                                <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                                    @account.Avatar
                                </div>
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@account.Name</div>
                                    <p class="text-xs text-muted-foreground">@account.Email</p>
                                </div>
                                <span class="flex items-center gap-1 text-xs text-muted-foreground">
                                    @if (account.Role == "Owner")
                                    {
                                        <LucideShieldCn Size="12" Class="size-3" />
                                    }
                                    @account.Role
                                </span>
                                @if (_activeAccount == account.Id)
                                {
                                    <LucideCheckCn Size="16" Class="size-4 text-emerald-500" />
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn @onclick="@(() => _open = false)" Class="gap-3">
                            <LucideCirclePlusCn Size="16" Class="size-4" />
                            <span>Add Account</span>
                        </CommandItemCn>
                        <CommandItemCn @onclick="@(() => _open = false)" Class="gap-3">
                            <LucideBuildingCn Size="16" Class="size-4" />
                            <span>Create Organization</span>
                        </CommandItemCn>
                        <CommandItemCn @onclick="@(() => _open = false)" Class="gap-3">
                            <LucideSettingsCn Size="16" Class="size-4" />
                            <span>Account Settings</span>
                            <div class="ml-auto flex gap-1">
                                <KbdCn>⌘</KbdCn>
                                <KbdCn>,</KbdCn>
                            </div>
                        </CommandItemCn>
                        <CommandItemCn @onclick="@(() => _open = false)" Class="gap-3">
                            <LucideLogOutCn Size="16" Class="size-4" />
                            <span>Sign Out of All</span>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideUserCn Size="12" Class="size-3" />
                        <span>Signed in as @(_accounts.FirstOrDefault(a => a.Id == _activeAccount)?.Name)</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
    private string _activeAccount = "1";

    private record Account(string Id, string Name, string Email, string Role, string Avatar);

    private static readonly Account[] _accounts =
    [
        new("1", "Personal", "alex@gmail.com", "Owner", "A"),
        new("2", "Acme Corp", "alex@acme.com", "Admin", "AC"),
        new("3", "Startup Inc", "alex@startup.io", "Member", "SI"),
        new("4", "Freelance", "alex@freelance.dev", "Owner", "F"),
    ];
}
