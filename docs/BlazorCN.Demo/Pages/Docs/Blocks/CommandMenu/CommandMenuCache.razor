@* ============================================================
   Block: command-menu-cache
   Title: CommandMenuCache
   Description: Cache management command menu with purge actions and storage metrics for React developer tools
   Source: original/blocks/command-menu/command-menu-cache.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" Class="gap-2">
            <LucideLayersCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Cache Manager</span>
            <KbdCn>&#x2318;&#x21E7;C</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Cache Manager</DialogTitleCn>
                <DialogDescriptionCn>Cache management command menu with purge actions and storage metrics</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search cache stores or actions..." />
                <CommandListCn>
                    <CommandEmptyCn>No cache actions found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Cache Stores">
                        @foreach (var store in _cacheStores)
                        {
                            var s = store;
                            <CommandItemCn Class="gap-3" @onclick="() => _open = false">
                                @if (s.Id == "redis")
                                {
                                    <LucideDatabaseCn Size="16" Class="size-4 text-muted-foreground" />
                                }
                                else if (s.Id == "cdn")
                                {
                                    <LucideServerCn Size="16" Class="size-4 text-muted-foreground" />
                                }
                                else if (s.Id == "browser")
                                {
                                    <LucideHardDriveCn Size="16" Class="size-4 text-muted-foreground" />
                                }
                                else
                                {
                                    <LucideZapCn Size="16" Class="size-4 text-muted-foreground" />
                                }
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@s.Name</div>
                                    <p class="text-xs text-muted-foreground">@s.Keys keys &middot; @s.Size</p>
                                </div>
                                <span class="rounded bg-muted/50 px-1.5 py-0.5 font-mono text-xs text-muted-foreground">
                                    @s.Hit hit
                                </span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Purge Actions">
                        @foreach (var action in _purgeActions)
                        {
                            var act = action;
                            <CommandItemCn Class="gap-3" @onclick="() => _open = false">
                                @if (act.Id == "all")
                                {
                                    <LucideTrash2Cn Size="16" Class="size-4 text-red-500" />
                                }
                                else
                                {
                                    <LucideRefreshCwCn Size="16" Class="size-4 text-muted-foreground" />
                                }
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@act.Label</div>
                                    <p class="text-xs text-muted-foreground">@act.Description</p>
                                </div>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideLayersCn Size="12" Class="size-3" />
                        <span>Total: 21.9 GB across 4 stores</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record CacheStore(string Id, string Name, string Size, string Keys, string Hit);
    private record PurgeAction(string Id, string Label, string Description);

    private static readonly CacheStore[] _cacheStores =
    [
        new("redis", "Redis", "2.4 GB", "148K", "94.2%"),
        new("cdn", "CDN Edge", "18.7 GB", "2.1M", "98.7%"),
        new("browser", "Browser Cache", "340 MB", "12K", "87.3%"),
        new("memory", "In-Memory", "512 MB", "34K", "99.1%"),
    ];

    private static readonly PurgeAction[] _purgeActions =
    [
        new("all", "Purge All Caches", "Clear every cache layer"),
        new("stale", "Purge Stale Entries", "Remove expired keys only"),
        new("api", "Purge API Responses", "Clear cached API responses"),
        new("assets", "Purge Static Assets", "Invalidate CSS, JS, images"),
        new("html", "Purge HTML Pages", "Clear server-rendered pages"),
    ];
}
