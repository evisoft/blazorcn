@* ============================================================
   Block: command-menu-notifications
   Title: Command Menu Notifications
   Description: Notification center command menu with filters, mark as read, and grouped notifications
   Dependencies: AvatarCn, BadgeCn, ButtonCn, CommandCn, DialogCn, KbdCn
   Source: original/blocks/command-menu/command-menu-notifications.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" class="relative" Variant="ButtonVariant.Outline">
            <LucideBellCn Size="16" Class="mr-2 h-4 w-4" />
            <span>Notifications</span>
            @if (UnreadCount > 0)
            {
                <BadgeCn class="ml-2 h-5 w-5 rounded-full p-0 text-xs">@UnreadCount</BadgeCn>
            }
            <KbdCn class="ml-2">@@N</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-md" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Notifications</DialogTitleCn>
                <DialogDescriptionCn>View and manage your notifications.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <div class="flex items-center justify-between border-b px-3 py-2">
                    <div class="flex items-center gap-2">
                        <LucideBellCn Size="16" Class="h-4 w-4" />
                        <span class="font-medium">Notifications</span>
                        @if (UnreadCount > 0)
                        {
                            <BadgeCn class="text-xs" Variant="BadgeVariant.Secondary">@UnreadCount new</BadgeCn>
                        }
                    </div>
                    <ButtonCn class="h-7 text-xs" Disabled="@(UnreadCount == 0)" @onclick="MarkAllRead" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                        <LucideCheckCheckCn Size="12" Class="mr-1 h-3 w-3" />
                        Mark all read
                    </ButtonCn>
                </div>

                <div class="flex items-center gap-1 border-b px-3 py-2">
                    <ButtonCn class="h-7 text-xs" @onclick="() => _filter = null" Size="ButtonSize.Sm" Variant="@(_filter == null ? ButtonVariant.Secondary : ButtonVariant.Ghost)">All</ButtonCn>
                    <ButtonCn class="h-7 text-xs" @onclick='() => _filter = "mention"' Size="ButtonSize.Sm" Variant="@(_filter == "mention" ? ButtonVariant.Secondary : ButtonVariant.Ghost)">Mentions</ButtonCn>
                    <ButtonCn class="h-7 text-xs" @onclick='() => _filter = "comment"' Size="ButtonSize.Sm" Variant="@(_filter == "comment" ? ButtonVariant.Secondary : ButtonVariant.Ghost)">Comments</ButtonCn>
                    <ButtonCn class="h-7 text-xs" @onclick='() => _filter = "follow"' Size="ButtonSize.Sm" Variant="@(_filter == "follow" ? ButtonVariant.Secondary : ButtonVariant.Ghost)">Follows</ButtonCn>
                </div>

                <CommandListCn class="max-h-[350px]">
                    <CommandEmptyCn>No notifications.</CommandEmptyCn>

                    @{ var filtered = _filter != null ? _items.Where(n => n.Type == _filter).ToArray() : _items; }
                    @{ var unread = filtered.Where(n => !n.Read).ToArray(); }
                    @{ var read = filtered.Where(n => n.Read).ToArray(); }

                    @if (unread.Length > 0)
                    {
                        <CommandGroupCn Heading="New">
                            @foreach (var notification in unread)
                            {
                                <CommandItemCn class="py-3" @onclick="() => MarkAsRead(notification.Id)">
                                    <div class="relative mr-3">
                                        <AvatarCn class="h-9 w-9">
                                            <AvatarFallbackCn>@notification.Initials</AvatarFallbackCn>
                                        </AvatarCn>
                                        <div class="absolute -top-0.5 -right-0.5 h-2.5 w-2.5 rounded-full bg-primary"></div>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <p class="text-sm font-medium">@notification.Title</p>
                                        <p class="truncate text-xs text-muted-foreground">@notification.Message</p>
                                        <p class="mt-0.5 text-xs text-muted-foreground">@notification.Time</p>
                                    </div>
                                </CommandItemCn>
                            }
                        </CommandGroupCn>
                    }

                    @if (read.Length > 0)
                    {
                        <CommandGroupCn Heading="Earlier">
                            @foreach (var notification in read)
                            {
                                <CommandItemCn class="py-3 opacity-60">
                                    <div class="mr-3">
                                        <AvatarCn class="h-9 w-9">
                                            <AvatarFallbackCn>@notification.Initials</AvatarFallbackCn>
                                        </AvatarCn>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <p class="text-sm">@notification.Title</p>
                                        <p class="truncate text-xs text-muted-foreground">@notification.Message</p>
                                        <p class="mt-0.5 text-xs text-muted-foreground">@notification.Time</p>
                                    </div>
                                </CommandItemCn>
                            }
                        </CommandGroupCn>
                    }

                    <CommandSeparatorCn />
                    <CommandGroupCn>
                        <CommandItemCn>
                            <LucideSettingsCn Size="16" Class="mr-2 h-4 w-4" />
                            Notification settings
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
    private string? _filter;

    private int UnreadCount => _items.Count(n => !n.Read);

    private record NotificationItem(string Id, string Title, string Message, string Time, string Type, string Initials, bool Read);

    private NotificationItem[] _items =
    [
        new("n1", "Sarah mentioned you", "Can you review the latest PR for the auth module?", "2 min ago", "mention", "SC", false),
        new("n2", "New comment on PR #142", "Looks good! Just a few style nits to address.", "15 min ago", "comment", "MR", false),
        new("n3", "James followed you", "James from the backend team started following your activity.", "1h ago", "follow", "JB", false),
        new("n4", "Elena commented", "Updated the migration guide with the new API endpoints.", "3h ago", "comment", "EM", true),
        new("n5", "Team mention", "The design team mentioned you in the brand guidelines thread.", "1d ago", "mention", "DT", true),
    ];

    private void MarkAsRead(string id)
    {
        _items = _items.Select(n => n.Id == id ? n with { Read = true } : n).ToArray();
    }

    private void MarkAllRead()
    {
        _items = _items.Select(n => n with { Read = true }).ToArray();
    }
}
