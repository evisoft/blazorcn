@* ============================================================
   Block: command-menu-changelog
   Title: CommandMenuChangelog
   Description: Recent changes browser command menu with version history and release notes for React apps
   Source: original/blocks/command-menu/command-menu-changelog.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" Class="gap-2">
            <LucideHistoryCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Changelog</span>
            <KbdCn>⌘⇧L</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-md" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Changelog</DialogTitleCn>
                <DialogDescriptionCn>Browse recent changes and version history.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search changes..." />
                <CommandListCn>
                    <CommandEmptyCn>No changes found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Recent Changes">
                        @foreach (var change in _recentChanges)
                        {
                            var item = change;
                            <CommandItemCn Class="gap-3" OnSelect="@(() => _open = false)">
                                @if (item.Type == "feature")
                                {
                                    <LucidePlusCn Size="16" Class="size-4 text-emerald-500" />
                                }
                                else if (item.Type == "fix")
                                {
                                    <LucideBugCn Size="16" Class="size-4 text-blue-500" />
                                }
                                else if (item.Type == "improvement")
                                {
                                    <LucideSparklesCn Size="16" Class="size-4 text-amber-500" />
                                }
                                else
                                {
                                    <LucideTriangleAlertCn Size="16" Class="size-4 text-red-500" />
                                }
                                <div class="min-w-0 flex-1">
                                    <span class="text-sm font-medium">@item.Title</span>
                                </div>
                                <span class="font-mono text-xs text-muted-foreground">@item.Version</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandGroupCn Heading="Versions">
                        @foreach (var ver in _versions)
                        {
                            var v = ver;
                            <CommandItemCn Class="gap-3" OnSelect="@(() => _open = false)">
                                <LucideTagCn Size="16" Class="size-4 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <span class="text-sm font-medium">@v.Tag</span>
                                    <span class="ml-2 text-xs text-muted-foreground">@v.Date</span>
                                </div>
                                <span class="text-xs text-muted-foreground">@v.Count changes</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucidePackageCn Size="12" Class="size-3" />
                        <span>Latest: v2.14.0</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record ChangeEntry(string Id, string Type, string Title, string Version);
    private record VersionEntry(string Tag, string Date, int Count);

    private static readonly ChangeEntry[] _recentChanges =
    [
        new("1", "feature", "Added real-time collaboration", "v2.14.0"),
        new("2", "feature", "New command palette shortcuts", "v2.14.0"),
        new("3", "fix", "Fixed auth token refresh loop", "v2.14.0"),
        new("4", "improvement", "Faster search indexing", "v2.13.2"),
        new("5", "fix", "Resolved CSV export encoding", "v2.13.2"),
        new("6", "breaking", "Removed legacy API v1 endpoints", "v2.13.0"),
        new("7", "feature", "Webhook retry with backoff", "v2.13.0"),
        new("8", "improvement", "Reduced bundle size by 18%", "v2.13.0"),
    ];

    private static readonly VersionEntry[] _versions =
    [
        new("v2.14.0", "Mar 20, 2026", 3),
        new("v2.13.2", "Mar 12, 2026", 2),
        new("v2.13.0", "Mar 1, 2026", 3),
    ];
}
