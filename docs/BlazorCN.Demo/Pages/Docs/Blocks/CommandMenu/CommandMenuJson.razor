@* ============================================================
   Block: command-menu-json
   Title: CommandMenuJson
   Description: JSON path browser command menu with tree navigation, path copying, and value preview for React developer tools
   Source: original/blocks/command-menu/command-menu-json.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" Class="gap-2">
            <LucideBracesCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">JSON Browser</span>
            <KbdCn>⌘J</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-md" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>JSON Browser</DialogTitleCn>
                <DialogDescriptionCn>Browse JSON structure with tree navigation and path copying.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <div class="flex items-center gap-1 border-b px-3 py-2">
                    @foreach (var crumb in _breadcrumb)
                    {
                        var crumbItem = crumb;
                        var idx = _breadcrumb.IndexOf(crumbItem);
                        <div class="flex items-center gap-1">
                            @if (idx > 0)
                            {
                                <LucideChevronRightCn Size="12" Class="size-3 text-muted-foreground" />
                            }
                            <button
                                type="button"
                                @onclick="@(() => { if (idx < _breadcrumb.Count - 1) HandleBack(); })"
                                class="@(idx < _breadcrumb.Count - 1 ? "text-xs font-mono text-muted-foreground hover:text-foreground" : "text-xs font-mono text-foreground font-medium")">
                                @crumbItem
                            </button>
                        </div>
                    }
                </div>

                <CommandInputCn Placeholder="Search keys..." />

                <CommandListCn>
                    <CommandEmptyCn>No keys found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Properties">
                        @foreach (var node in _nodes)
                        {
                            var n = node;
                            <CommandItemCn Class="gap-3" OnSelect="@(() => HandleSelect(n))">
                                @GetTypeIcon(n.Type)
                                <div class="min-w-0 flex-1">
                                    <span class="font-mono text-sm">@n.Key</span>
                                </div>
                                <span class="@($"font-mono text-xs {GetTypeColor(n.Type)}")">@n.Value</span>
                                @if (n.Type == "object" || n.Type == "array")
                                {
                                    <LucideChevronRightCn Size="16" Class="size-4 text-muted-foreground" />
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn Class="gap-3">
                            <LucideClipboardCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Copy path</span>
                            <KbdCn class="ml-auto">⌘C</KbdCn>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideBracesCn Size="12" Class="size-3" />
                        <span class="font-mono">@(string.Join(".", _breadcrumb))</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
    private List<string> _breadcrumb = ["$"];
    private List<JsonNode> _nodes = [.. _rootNodes];

    private record JsonNode(string Id, string Key, string Path, string Type, string Value, int? ChildCount = null);

    private static readonly JsonNode[] _rootNodes =
    [
        new("user",     "user",    "$.user",    "object",  "{...}",      4),
        new("settings", "settings","$.settings","object",  "{...}",      3),
        new("items",    "items",   "$.items",   "array",   "[3 items]",  3),
        new("version",  "version", "$.version", "string",  "\"2.4.1\""),
        new("count",    "count",   "$.count",   "number",  "42"),
        new("active",   "active",  "$.active",  "boolean", "true"),
    ];

    private static readonly JsonNode[] _userChildren =
    [
        new("user.id",       "id",       "$.user.id",       "number",  "1024"),
        new("user.name",     "name",     "$.user.name",     "string",  "\"Alice Chen\""),
        new("user.email",    "email",    "$.user.email",    "string",  "\"alice@acme.com\""),
        new("user.verified", "verified", "$.user.verified", "boolean", "true"),
    ];

    private void HandleSelect(JsonNode node)
    {
        if (node.Type == "object" || node.Type == "array")
        {
            if (node.Id == "user")
            {
                _nodes = [.. _userChildren];
                _breadcrumb = [.. _breadcrumb, node.Key];
            }
        }
    }

    private void HandleBack()
    {
        if (_breadcrumb.Count > 1)
        {
            _breadcrumb = ["$"];
            _nodes = [.. _rootNodes];
        }
    }

    private static string GetTypeColor(string type) => type switch
    {
        "string"  => "text-emerald-600",
        "number"  => "text-blue-600",
        "boolean" => "text-amber-600",
        _         => "text-muted-foreground",
    };

    private RenderFragment GetTypeIcon(string type) => type switch
    {
        "string"  => @<LucideIconCn Name="text" Size="16" Class="size-4 text-emerald-600" />,
        "number"  => @<LucideHashCn Size="16" Class="size-4 text-blue-600" />,
        "boolean" => @<LucideToggleLeftCn Size="16" Class="size-4 text-amber-600" />,
        "array"   => @<LucideBracketsCn Size="16" Class="size-4 text-muted-foreground" />,
        _         => @<LucideBracesCn Size="16" Class="size-4 text-muted-foreground" />,
    };
}
