@* ============================================================
   Block: command-menu-integrations
   Title: Command Menu Integrations
   Description: A third-party integrations browser with connection management and real-time status indicators
   Dependencies: ButtonCn, CommandCn, KbdCn
   Source: original/blocks/command-menu/command-menu-integrations.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" class="gap-2">
            <LucidePlugCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Browse Integrations</span>
            <KbdCn>@@K</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Command Menu</DialogTitleCn>
                <DialogDescriptionCn>Search and navigate.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
        <CommandInputCn Placeholder="Search integrations..." />
        <CommandListCn>
            <CommandEmptyCn>No integrations found.</CommandEmptyCn>

            <CommandGroupCn Heading="@($"Connected ({_integrations.Count(i => i.Connected)})")">
                @foreach (var integration in _integrations.Where(i => i.Connected))
                {
                    <CommandItemCn class="gap-3">
                        <LucideCircleCheckBigCn Size="16" Class="size-4 text-emerald-500" />
                        <LucidePlugCn Size="16" Class="size-4 text-muted-foreground" />
                        <div class="flex min-w-0 flex-1 flex-col gap-0.5">
                            <span class="text-sm font-medium">@integration.Name</span>
                            <span class="truncate text-muted-foreground text-xs">@integration.Description</span>
                        </div>
                        <span class="shrink-0 text-muted-foreground text-xs">Disconnect</span>
                    </CommandItemCn>
                }
            </CommandGroupCn>

            @foreach (var category in _integrations.Where(i => !i.Connected).Select(i => i.Category).Distinct())
            {
                <CommandGroupCn Heading="@category">
                    @foreach (var integration in _integrations.Where(i => !i.Connected && i.Category == category))
                    {
                        <CommandItemCn class="gap-3">
                            <LucideCircleCn Size="16" Class="size-4 text-muted-foreground/40" />
                            <LucidePlugCn Size="16" Class="size-4 text-muted-foreground" />
                            <div class="flex min-w-0 flex-1 flex-col gap-0.5">
                                <span class="text-sm font-medium">@integration.Name</span>
                                <span class="truncate text-muted-foreground text-xs">@integration.Description</span>
                            </div>
                            <span class="shrink-0 text-muted-foreground text-xs">Connect</span>
                        </CommandItemCn>
                    }
                </CommandGroupCn>
            }
        </CommandListCn>
    </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record IntegrationItem(string Name, string Description, string Category, bool Connected);

    private static readonly IntegrationItem[] _integrations =
    [
        new("Slack", "Send notifications and alerts to channels", "Communication", true),
        new("GitHub", "Sync repos, PRs, and deployment status", "Development", true),
        new("Linear", "Two-way issue and project sync", "Project Management", true),
        new("Stripe", "Track revenue and subscription metrics", "Payments", true),
        new("Figma", "Import designs and sync tokens", "Design", false),
        new("Notion", "Embed dashboards and sync docs", "Productivity", false),
        new("Jira", "Sync tickets, sprints, and releases", "Project Management", false),
        new("Vercel", "Auto-deploy previews and production", "Hosting", false),
        new("PagerDuty", "Trigger and resolve incidents", "Monitoring", false),
        new("Datadog", "Forward logs, traces, and metrics", "Monitoring", false),
    ];
}
