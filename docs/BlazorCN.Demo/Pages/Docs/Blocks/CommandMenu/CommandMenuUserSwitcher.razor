@* ============================================================
   Block: command-menu-user-switcher
   Title: Command Menu User Switcher
   Description: User and account switcher command menu with avatars, status indicators, and quick account actions for React apps
   Long Description: Switch accounts with this command menu component. Features user avatars with online status, workspace switching, and quick account actions. Perfect for SaaS platforms or team tools with multi-account workflows.
   Dependencies: AvatarCn, BadgeCn, ButtonCn, CommandCn, DialogCn, KbdCn
   Source: original/blocks/command-menu/command-menu-user-switcher.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" @onclick="() => _open = true">
            <LucideSearchCn Size="16" Class="mr-2 h-4 w-4" />
            <span>Command Menu User Switcher</span>
            <KbdCn class="ml-2">@@K</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Command Menu User Switcher</DialogTitleCn>
                <DialogDescriptionCn>User and account switcher command menu with avatars, status indicators, and quick account actions for React apps</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Type a command or search..." />
                <CommandListCn>
                    <CommandEmptyCn>No results found.</CommandEmptyCn>
                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn>
                            <LucideSearchCn Size="16" Class="mr-2 h-4 w-4 text-muted-foreground" />
                            <span>Search...</span>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
}
