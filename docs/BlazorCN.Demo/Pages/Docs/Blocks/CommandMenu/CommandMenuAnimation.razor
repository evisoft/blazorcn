@* ============================================================
   Block: command-menu-animation
   Title: CommandMenuAnimation
   Description: Animation preset picker command menu with easing curves and duration controls for React motion design
   Source: original/blocks/command-menu/command-menu-animation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" Class="gap-2">
            <LucidePlayCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Animation Presets</span>
            <KbdCn>⌘M</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Animation Presets</DialogTitleCn>
                <DialogDescriptionCn>Search and select animation presets.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search animations..." />
                <CommandListCn>
                    <CommandEmptyCn>No presets found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Easing">
                        @foreach (var preset in _easingPresets)
                        {
                            var p = preset;
                            <CommandItemCn Class="gap-3" @onclick="() => _selectedPreset = p.Id">
                                <LucideArrowRightCn Size="16" Class="size-4 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@p.Name</div>
                                    <p class="font-mono text-xs text-muted-foreground">@p.Easing</p>
                                </div>
                                @if (_selectedPreset == p.Id)
                                {
                                    <LucideCheckCn Size="16" Class="size-4 text-emerald-500" />
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandGroupCn Heading="Spring">
                        @foreach (var preset in _springPresets)
                        {
                            var p = preset;
                            <CommandItemCn Class="gap-3" @onclick="() => _selectedPreset = p.Id">
                                <LucideSparklesCn Size="16" Class="size-4 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@p.Name</div>
                                    <p class="font-mono text-xs text-muted-foreground">@p.Easing</p>
                                </div>
                                @if (_selectedPreset == p.Id)
                                {
                                    <LucideCheckCn Size="16" Class="size-4 text-emerald-500" />
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Duration">
                        @foreach (var dur in _durations)
                        {
                            var d = dur;
                            <CommandItemCn Class="gap-3" @onclick="() => _selectedDuration = d.Id">
                                <LucideClockCn Size="16" Class="size-4 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <span class="text-sm font-medium">@d.Label</span>
                                    <span class="ml-2 text-xs text-muted-foreground">@d.Description</span>
                                </div>
                                @if (_selectedDuration == d.Id)
                                {
                                    <LucideCheckCn Size="16" Class="size-4 text-emerald-500" />
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideZapCn Size="12" Class="size-3" />
                        <span>
                            Active: @(ActivePresetName()) at @(_selectedDuration)ms
                        </span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
    private string _selectedPreset = "ease-in-out";
    private string _selectedDuration = "300";

    private record AnimationPreset(string Id, string Name, string Easing, string Duration);
    private record DurationOption(string Id, string Label, string Description);

    private static readonly AnimationPreset[] _easingPresets =
    [
        new("ease-in", "Ease In", "cubic-bezier(0.4, 0, 1, 1)", "200ms"),
        new("ease-out", "Ease Out", "cubic-bezier(0, 0, 0.2, 1)", "200ms"),
        new("ease-in-out", "Ease In Out", "cubic-bezier(0.4, 0, 0.2, 1)", "300ms"),
        new("linear", "Linear", "linear", "200ms"),
    ];

    private static readonly AnimationPreset[] _springPresets =
    [
        new("spring-gentle", "Gentle Spring", "cubic-bezier(0.34, 1.56, 0.64, 1)", "400ms"),
        new("spring-bouncy", "Bouncy Spring", "cubic-bezier(0.68, -0.55, 0.27, 1.55)", "500ms"),
        new("spring-stiff", "Stiff Spring", "cubic-bezier(0.5, 1.25, 0.75, 1)", "250ms"),
    ];

    private static readonly DurationOption[] _durations =
    [
        new("100", "100ms", "Instant"),
        new("200", "200ms", "Fast"),
        new("300", "300ms", "Normal"),
        new("500", "500ms", "Slow"),
        new("700", "700ms", "Very slow"),
    ];

    private string ActivePresetName()
    {
        foreach (var p in _easingPresets)
        {
            if (p.Id == _selectedPreset) return p.Name;
        }
        foreach (var p in _springPresets)
        {
            if (p.Id == _selectedPreset) return p.Name;
        }
        return _selectedPreset;
    }
}
