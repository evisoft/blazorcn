@* ============================================================
   Block: command-menu-icon-picker
   Title: CommandMenuIconPicker
   Description: Icon search and picker command menu with category browsing and copy-to-clipboard for React design tools
   Source: original/blocks/command-menu/command-menu-icon-picker.tsx
   ============================================================ *@

@inject IJSRuntime JS

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" Class="gap-2">
            <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Pick Icon</span>
            <KbdCn>&#x2318;I</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Icon Picker</DialogTitleCn>
                <DialogDescriptionCn>Icon search and picker command menu with category browsing and copy-to-clipboard for React design tools</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search icons..." />
                <CommandListCn>
                    <CommandEmptyCn>No icons found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Common">
                        @foreach (var item in _commonIcons)
                        {
                            var it = item;
                            <CommandItemCn @onclick="@(() => HandleCopy(it.Import))" Class="gap-3">
                                <LucideIconCn Name="@it.IconName" Size="16" Class="size-4" />
                                <span class="flex-1 text-sm">@it.Name</span>
                                <span class="font-mono text-xs text-muted-foreground">@it.Import</span>
                                @if (_copiedIcon == it.Import)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                                }
                                else
                                {
                                    <LucideIconCn Name="copy" Size="14" Class="size-3.5 text-muted-foreground" />
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Actions">
                        @foreach (var item in _actionIcons)
                        {
                            var it = item;
                            <CommandItemCn @onclick="@(() => HandleCopy(it.Import))" Class="gap-3">
                                <LucideIconCn Name="@it.IconName" Size="16" Class="size-4" />
                                <span class="flex-1 text-sm">@it.Name</span>
                                <span class="font-mono text-xs text-muted-foreground">@it.Import</span>
                                @if (_copiedIcon == it.Import)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                                }
                                else
                                {
                                    <LucideIconCn Name="copy" Size="14" Class="size-3.5 text-muted-foreground" />
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandGroupCn Heading="Content">
                        @foreach (var item in _contentIcons)
                        {
                            var it = item;
                            <CommandItemCn @onclick="@(() => HandleCopy(it.Import))" Class="gap-3">
                                <LucideIconCn Name="@it.IconName" Size="16" Class="size-4" />
                                <span class="flex-1 text-sm">@it.Name</span>
                                <span class="font-mono text-xs text-muted-foreground">@it.Import</span>
                                @if (_copiedIcon == it.Import)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                                }
                                else
                                {
                                    <LucideIconCn Name="copy" Size="14" Class="size-3.5 text-muted-foreground" />
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideIconCn Name="image" Size="12" Class="size-3" />
                        <span>Click to copy import statement</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
    private string? _copiedIcon;

    private record IconItem(string Name, string IconName, string Import);

    private static readonly IconItem[] _commonIcons =
    [
        new("Home", "home", "HomeIcon"),
        new("Search", "search", "SearchIcon"),
        new("Settings", "settings", "SettingsIcon"),
        new("User", "user", "UserIcon"),
        new("Mail", "mail", "MailIcon"),
        new("Bell", "bell", "BellIcon"),
        new("Star", "star", "StarIcon"),
        new("Heart", "heart", "HeartIcon"),
    ];

    private static readonly IconItem[] _actionIcons =
    [
        new("Check", "check", "CheckIcon"),
        new("Copy", "copy", "CopyIcon"),
        new("Arrow Right", "arrow-right", "ArrowRightIcon"),
        new("Zap", "zap", "ZapIcon"),
        new("Alert Circle", "alert-circle", "AlertCircleIcon"),
    ];

    private static readonly IconItem[] _contentIcons =
    [
        new("Image", "image", "ImageIcon"),
        new("Video", "video", "VideoIcon"),
        new("Music", "music", "MusicIcon"),
        new("Book Open", "book-open", "BookOpenIcon"),
        new("Calendar", "calendar", "CalendarIcon"),
        new("Map Pin", "map-pin", "MapPinIcon"),
        new("Shopping Cart", "shopping-cart", "ShoppingCartIcon"),
    ];

    private async Task HandleCopy(string importName)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", $"import {{ {importName} }} from \"lucide-react\"");
        _copiedIcon = importName;
        StateHasChanged();
        await Task.Delay(1500);
        _copiedIcon = null;
    }
}
