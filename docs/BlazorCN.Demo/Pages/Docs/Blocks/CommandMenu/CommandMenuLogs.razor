@* ============================================================
   Block: command-menu-logs
   Title: CommandMenuLogs
   Description: Log viewer command menu with severity filters, source grouping, and search for React monitoring tools
   Source: original/blocks/command-menu/command-menu-logs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" Class="gap-2">
            <LucideScrollTextCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">View Logs</span>
            <KbdCn>⌘L</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Log Viewer</DialogTitleCn>
                <DialogDescriptionCn>Log viewer command menu with severity filters, source grouping, and search for React monitoring tools</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <div class="flex items-center gap-1 border-b px-3 py-2 overflow-x-auto">
                    <ButtonCn
                        Size="ButtonSize.Sm"
                        Variant="@AllVariant"
                        Class="h-7 text-xs shrink-0"
                        @onclick="SetFilterAll">
                        All
                    </ButtonCn>
                    @foreach (var lvl in _levels)
                    {
                        var level = lvl;
                        var cfg = _levelConfig[level];
                        var dotClass = Cn.Merge("size-1.5 rounded-full", cfg.DotColor);
                        var iconClass = Cn.Merge("size-4 shrink-0", cfg.Color);
                        var btnVariant = _activeFilter == level ? ButtonVariant.Secondary : ButtonVariant.Ghost;
                        <ButtonCn
                            Size="ButtonSize.Sm"
                            Variant="@btnVariant"
                            Class="h-7 text-xs shrink-0 gap-1.5"
                            @onclick="@(() => _activeFilter = level)">
                            <span class="@dotClass" />
                            <span class="capitalize">@level</span>
                            <span class="tabular-nums text-muted-foreground">@_counts[level]</span>
                        </ButtonCn>
                    }
                </div>
                <CommandInputCn Placeholder="Search logs..." />
                <CommandListCn>
                    <CommandEmptyCn>No log entries found.</CommandEmptyCn>

                    <CommandGroupCn Heading="@GroupHeading">
                        @foreach (var entry in FilteredLogs)
                        {
                            var log = entry;
                            var cfg = _levelConfig[log.Level];
                            var iconClass = Cn.Merge("size-4 shrink-0", cfg.Color);
                            <CommandItemCn class="gap-3">
                                <LucideIconCn Name="@cfg.IconName" Size="16" Class="@iconClass" />
                                <div class="min-w-0 flex-1">
                                    <span class="text-sm">@log.Message</span>
                                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                                        <LucideServerCn Size="12" Class="size-3" />
                                        <span>@log.Source</span>
                                        <span>&middot;</span>
                                        <span class="font-mono tabular-nums">@log.Timestamp</span>
                                    </div>
                                </div>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn class="gap-3">
                            <LucideIconCn Name="filter" Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Advanced filters</span>
                            <KbdCn class="ml-auto">⌘F</KbdCn>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideScrollTextCn Size="12" Class="size-3" />
                        <span>@FilteredLogs.Length entries</span>
                        @if (_activeFilter != "all")
                        {
                            <span>&middot;</span>
                            <span class="capitalize">Filtered: @_activeFilter</span>
                        }
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
    private string _activeFilter = "all";

    private record LogEntry(string Id, string Level, string Message, string Source, string Timestamp);
    private record LevelConfig(string IconName, string Color, string DotColor);

    private static readonly string[] _levels = ["error", "warn", "info", "debug"];

    private static readonly Dictionary<string, LevelConfig> _levelConfig = new()
    {
        ["error"] = new("circle-alert", "text-red-500", "bg-red-500"),
        ["warn"]  = new("triangle-alert", "text-amber-500", "bg-amber-500"),
        ["info"]  = new("info", "text-blue-500", "bg-blue-500"),
        ["debug"] = new("bug", "text-muted-foreground", "bg-muted-foreground"),
    };

    private static readonly LogEntry[] _logEntries =
    [
        new("1",  "error", "Connection refused: database pool exhausted",        "api-server",   "14:32:01"),
        new("2",  "error", "Unhandled rejection in payment webhook handler",      "webhook",      "14:31:58"),
        new("3",  "warn",  "Rate limit threshold reached for IP 192.168.1.42",   "gateway",      "14:31:45"),
        new("4",  "warn",  "Deprecated API endpoint called: /v1/users/search",   "api-server",   "14:31:30"),
        new("5",  "info",  "Deployment v2.14.3 completed successfully",          "deploy",       "14:30:12"),
        new("6",  "info",  "Cache invalidation triggered for user sessions",     "cache",        "14:29:55"),
        new("7",  "debug", "Query execution time: 245ms for users.findMany",     "orm",          "14:29:40"),
        new("8",  "debug", "WebSocket connection established: client_4821",      "ws-server",    "14:29:32"),
        new("9",  "info",  "Scheduled job completed: cleanup_expired_sessions",  "cron",         "14:28:00"),
        new("10", "error", "SSL certificate renewal failed for api.acme.com",    "cert-manager", "14:27:15"),
    ];

    private Dictionary<string, int> _counts => _levels.ToDictionary(
        l => l,
        l => _logEntries.Count(e => e.Level == l)
    );

    private LogEntry[] FilteredLogs =>
        _activeFilter == "all"
            ? _logEntries
            : _logEntries.Where(e => e.Level == _activeFilter).ToArray();

    private string GroupHeading => $"Log Entries ({FilteredLogs.Length})";

    private ButtonVariant AllVariant => _activeFilter == "all" ? ButtonVariant.Secondary : ButtonVariant.Ghost;

    private void SetFilterAll() => _activeFilter = "all";
}
