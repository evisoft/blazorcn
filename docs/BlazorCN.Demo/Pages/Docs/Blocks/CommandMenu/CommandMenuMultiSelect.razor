@* ============================================================
   Block: command-menu-multi-select
   Title: CommandMenuMultiSelect
   Description: Multi-select command menu with checkboxes, selection count, and batch actions for React apps
   Source: original/blocks/command-menu/command-menu-multi-select.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" @onclick="() => _open = true" Class="gap-2">
            <LucideListChecksCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Select Labels</span>
            <KbdCn>&#x2318;L</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Select Labels</DialogTitleCn>
                <DialogDescriptionCn>Multi-select command menu with checkboxes and batch actions.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <div class="flex items-center justify-between border-b px-3 py-2">
                    <div class="flex items-center gap-2 text-sm">
                        <LucideListChecksCn Size="16" Class="size-4 text-muted-foreground" />
                        <span class="font-medium">Select labels</span>
                        <span class="text-xs text-muted-foreground tabular-nums">
                            @_selected.Count selected
                        </span>
                    </div>
                    <div class="flex items-center gap-1">
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-6 text-xs px-2" @onclick="SelectAll">All</ButtonCn>
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-6 text-xs px-2" @onclick="SelectNone">None</ButtonCn>
                    </div>
                </div>
                <CommandInputCn Placeholder="Search labels..." />
                <CommandListCn>
                    <CommandEmptyCn>No labels found.</CommandEmptyCn>

                    @foreach (var cat in _categories)
                    {
                        var category = cat;
                        var isFirst = _categories.IndexOf(category) == 0;
                        @if (!isFirst)
                        {
                            <CommandSeparatorCn />
                        }
                        <CommandGroupCn Heading="@category">
                            @foreach (var it in _items.Where(i => i.Category == category))
                            {
                                var item = it;
                                var isSelected = _selected.Contains(item.Id);
                                <CommandItemCn Class="gap-3" OnSelect="@(() => ToggleItem(item.Id))">
                                    <div class="@Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded border", isSelected ? "border-primary bg-primary" : "border-muted-foreground/30")">
                                        @if (isSelected)
                                        {
                                            <LucideCheckCn Size="12" Class="size-3 text-primary-foreground" />
                                        }
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <span class="text-sm font-medium">@item.Label</span>
                                        <p class="text-xs text-muted-foreground">@item.Description</p>
                                    </div>
                                </CommandItemCn>
                            }
                        </CommandGroupCn>
                    }

                    @if (_selected.Count > 0)
                    {
                        <CommandSeparatorCn />
                        <CommandGroupCn Heading="Batch Actions">
                            <CommandItemCn Class="gap-3">
                                <LucideUserPlusCn Size="16" Class="size-4 text-muted-foreground" />
                                <span class="text-sm">Assign to items</span>
                                <KbdCn class="ml-auto">&#x2318;&#x21B5;</KbdCn>
                            </CommandItemCn>
                            <CommandItemCn Class="gap-3">
                                <LucideTrash2Cn Size="16" Class="size-4 text-muted-foreground" />
                                <span class="text-sm">Remove selected</span>
                                <KbdCn class="ml-auto">&#x232B;</KbdCn>
                            </CommandItemCn>
                        </CommandGroupCn>
                    }
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideTagCn Size="12" Class="size-3" />
                        <span>@_selected.Count of @_items.Length labels selected</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
    private HashSet<string> _selected = ["bug-fix", "high"];

    private record SelectableItem(string Id, string Label, string Description, string Category);

    private static readonly SelectableItem[] _items =
    [
        new("bug-fix",     "Bug Fix",          "Fixes an existing issue",           "Type"),
        new("feature",     "Feature",          "New functionality",                  "Type"),
        new("improvement", "Improvement",      "Enhancement to existing feature",    "Type"),
        new("refactor",    "Refactor",         "Code restructuring",                 "Type"),
        new("high",        "High Priority",    "Urgent attention required",          "Priority"),
        new("medium",      "Medium Priority",  "Normal scheduling",                  "Priority"),
        new("low",         "Low Priority",     "When time permits",                  "Priority"),
        new("frontend",    "Frontend",         "UI and client-side",                 "Team"),
        new("backend",     "Backend",          "API and server-side",                "Team"),
        new("devops",      "DevOps",           "Infrastructure and CI/CD",           "Team"),
        new("design",      "Design",           "UI/UX design team",                  "Team"),
    ];

    private static readonly List<string> _categories = _items.Select(i => i.Category).Distinct().ToList();

    private void ToggleItem(string id)
    {
        if (!_selected.Add(id))
            _selected.Remove(id);
    }

    private void SelectAll()
    {
        _selected = [.. _items.Select(i => i.Id)];
    }

    private void SelectNone()
    {
        _selected = [];
    }
}
