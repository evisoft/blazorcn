@* ============================================================
   Block: command-menu-customer
   Title: CommandMenuCustomer
   Description: Customer lookup and actions command menu with search, details, and quick actions for React CRM apps
   Source: original/blocks/command-menu/command-menu-customer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" Class="gap-2">
            <LucideSearchCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Find Customer</span>
            <KbdCn>&#x2318;K</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Customer Lookup</DialogTitleCn>
                <DialogDescriptionCn>Customer lookup and actions command menu with search, details, and quick actions for React CRM apps</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search customers by name, email, or company..." />
                <CommandListCn>
                    <CommandEmptyCn>No customers found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Customers">
                        @foreach (var cust in _customers)
                        {
                            var customer = cust;
                            <CommandItemCn OnSelect="@(() => _open = false)" Class="gap-3">
                                <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                                    @GetInitials(customer.Name)
                                </div>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@customer.Name</span>
                                        <span class="@($"size-1.5 rounded-full {GetStatusColor(customer.Status)}")" />
                                    </div>
                                    <div class="flex items-center gap-1 text-xs text-muted-foreground">
                                        <LucideBuildingCn Size="12" Class="size-3" />
                                        <span>@customer.Company</span>
                                        <span>&middot;</span>
                                        <span>@customer.Plan</span>
                                    </div>
                                </div>
                                <span class="font-mono text-sm font-medium tabular-nums">@customer.Mrr</span>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Quick Actions">
                        <CommandItemCn OnSelect="@(() => _open = false)" Class="gap-3">
                            <LucideMailCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Send Email</span>
                        </CommandItemCn>
                        <CommandItemCn OnSelect="@(() => _open = false)" Class="gap-3">
                            <LucidePhoneCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Log Call</span>
                        </CommandItemCn>
                        <CommandItemCn OnSelect="@(() => _open = false)" Class="gap-3">
                            <LucideTagCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Add Tag</span>
                        </CommandItemCn>
                        <CommandItemCn OnSelect="@(() => _open = false)" Class="gap-3">
                            <LucideStarCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Mark as VIP</span>
                        </CommandItemCn>
                        <CommandItemCn OnSelect="@(() => _open = false)" Class="gap-3">
                            <LucidePlusCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Create New Customer</span>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideUserCn Size="12" Class="size-3" />
                        <span>5 customers</span>
                        <span class="ml-auto">
                            <span class="size-1.5 inline-block rounded-full bg-emerald-500"></span> 3 active
                            <span class="ml-2 size-1.5 inline-block rounded-full bg-amber-500"></span> 1 trial
                            <span class="ml-2 size-1.5 inline-block rounded-full bg-red-500"></span> 1 churned
                        </span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record Customer(string Id, string Name, string Email, string Company, string Plan, string Mrr, string Status);

    private static readonly Customer[] _customers =
    [
        new("1", "Olivia Martin",  "olivia@techcorp.com",  "TechCorp",  "Enterprise", "$2,400", "active"),
        new("2", "James Wilson",   "james@designhub.io",   "DesignHub", "Pro",        "$229",   "active"),
        new("3", "Sophie Lee",     "sophie@startupai.com", "StartupAI", "Pro",        "$229",   "trial"),
        new("4", "Raj Patel",      "raj@cloudnine.dev",    "CloudNine", "Team",       "$469",   "active"),
        new("5", "Maria Garcia",   "maria@finflow.co",     "FinFlow",   "Individual", "$39",    "churned"),
    ];

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', System.StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Select(p => p[0]));
    }

    private static string GetStatusColor(string status) => status switch
    {
        "active"  => "bg-emerald-500",
        "churned" => "bg-red-500",
        "trial"   => "bg-amber-500",
        _         => "bg-muted",
    };
}
