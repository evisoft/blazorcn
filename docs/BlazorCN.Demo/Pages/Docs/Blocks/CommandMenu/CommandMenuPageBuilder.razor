@* ============================================================
   Block: command-menu-page-builder
   Title: CommandMenuPageBuilder
   Description: Page template selector command menu with categorized templates, previews, and quick create for React page builders
   Source: original/blocks/command-menu/command-menu-page-builder.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" @onclick="() => _open = true">
            <LucideIconCn Name="layout-template" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">New Page</span>
            <KbdCn>@@N</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Page Builder</DialogTitleCn>
                <DialogDescriptionCn>Select a page template to get started.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search templates..." />
                <CommandListCn>
                    <CommandEmptyCn>No templates found.</CommandEmptyCn>

                    @foreach (var cat in _categories)
                    {
                        var category = cat;
                        var isFirst = category == _categories[0];
                        @if (!isFirst)
                        {
                            <CommandSeparatorCn />
                        }
                        <CommandGroupCn Heading="@category">
                            @foreach (var tpl in _templates)
                            {
                                @if (tpl.Category == category)
                                {
                                    var template = tpl;
                                    <CommandItemCn Class="gap-3" OnSelect="@(() => _open = false)">
                                        <div class="flex size-6 shrink-0 items-center justify-center rounded-md bg-muted">
                                            <LucideIconCn Name="@template.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <span class="text-sm font-medium">@template.Name</span>
                                            <p class="text-xs text-muted-foreground">@template.Description</p>
                                        </div>
                                        <span class="text-xs text-muted-foreground tabular-nums">@template.Sections sections</span>
                                    </CommandItemCn>
                                }
                            }
                        </CommandGroupCn>
                    }

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn Class="gap-3">
                            <LucideIconCn Name="plus" Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Create blank page</span>
                            <KbdCn class="ml-auto">@@B</KbdCn>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideIconCn Name="layout-template" Size="12" Class="size-3" />
                        <span>@_templates.Length templates available</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record PageTemplate(string Id, string Name, string Description, string Icon, string Category, int Sections);

    private static readonly PageTemplate[] _templates =
    [
        new("landing", "Landing Page", "Hero, features, testimonials, CTA", "layout-template", "Marketing", 6),
        new("pricing", "Pricing Page", "Plan comparison with feature grid", "shopping-bag", "Marketing", 4),
        new("about", "About Page", "Team, mission, values, timeline", "user", "Marketing", 5),
        new("blog-list", "Blog Listing", "Grid layout with filters and pagination", "newspaper", "Content", 3),
        new("blog-post", "Blog Post", "Article with sidebar and related posts", "book-open", "Content", 4),
        new("docs", "Documentation", "Sidebar navigation with content area", "file", "Content", 3),
        new("dashboard", "Dashboard", "Stats cards, charts, and data tables", "layout-template", "Application", 5),
        new("settings", "Settings Page", "Tabbed sections with form fields", "layout-template", "Application", 4),
        new("profile", "User Profile", "Avatar, bio, activity feed", "user", "Application", 3),
        new("blank", "Blank Page", "Empty page with minimal boilerplate", "file-plus", "Other", 1),
    ];

    private static readonly string[] _categories = ["Marketing", "Content", "Application", "Other"];
}
