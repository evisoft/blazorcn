@* ============================================================
   Block: command-menu-calendar
   Title: Command Menu Calendar
   Description: Command menu for creating calendar events and navigating between views
   Dependencies: ButtonCn, CommandCn, KbdCn
   Source: original/blocks/command-menu/command-menu-calendar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" @onclick="() => _open = true">
            <LucideCalendarCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Quick Calendar</span>
            <KbdCn>@@K</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Command Menu</DialogTitleCn>
                <DialogDescriptionCn>Search and navigate.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
        <CommandInputCn Placeholder="Search events or create new..." />
        <CommandListCn>
            <CommandEmptyCn>No events found.</CommandEmptyCn>

            <CommandGroupCn Heading="Upcoming Today">
                @foreach (var evt in _todayEvents)
                {
                    var dotColor = evt.Type switch { "meeting" => "bg-blue-500", "task" => "bg-amber-500", _ => "bg-emerald-500" };
                    <CommandItemCn Class="flex items-center gap-3">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", dotColor)"></span>
                        <div class="flex min-w-0 flex-1 items-center gap-3">
                            <div class="flex min-w-0 flex-1 flex-col">
                                <span class="truncate text-sm font-medium">@evt.Title</span>
                                <div class="flex items-center gap-2 text-xs text-muted-foreground">
                                    <span>@evt.Time</span>
                                    <span>&middot;</span>
                                    <span>@evt.Duration</span>
                                </div>
                            </div>
                            <div class="flex shrink-0 items-center gap-1.5">
                                @if (evt.HasVideo)
                                {
                                    <LucideVideoCn Size="14" Class="size-3.5 text-muted-foreground/60" />
                                }
                                @if (evt.HasLocation)
                                {
                                    <LucideMapPinCn Size="14" Class="size-3.5 text-muted-foreground/60" />
                                }
                                @if (evt.Attendees > 0)
                                {
                                    <div class="flex items-center gap-1">
                                        <LucideUsersCn Size="14" Class="size-3.5 text-muted-foreground/60" />
                                        <span class="text-xs text-muted-foreground">@evt.Attendees</span>
                                    </div>
                                }
                            </div>
                        </div>
                        <LucideChevronRightCn Size="16" Class="size-4 shrink-0 text-muted-foreground/40" />
                    </CommandItemCn>
                }
            </CommandGroupCn>

            <CommandSeparatorCn />

            <CommandGroupCn Heading="Tomorrow">
                @foreach (var evt in _tomorrowEvents)
                {
                    var dotColor = evt.Type switch { "meeting" => "bg-blue-500", "task" => "bg-amber-500", _ => "bg-emerald-500" };
                    <CommandItemCn Class="flex items-center gap-3">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", dotColor)"></span>
                        <div class="flex min-w-0 flex-1 items-center gap-3">
                            <div class="flex min-w-0 flex-1 flex-col">
                                <span class="truncate text-sm font-medium">@evt.Title</span>
                                <div class="flex items-center gap-2 text-xs text-muted-foreground">
                                    <span>@evt.Time</span>
                                    <span>&middot;</span>
                                    <span>@evt.Duration</span>
                                </div>
                            </div>
                            <div class="flex shrink-0 items-center gap-1.5">
                                @if (evt.HasVideo)
                                {
                                    <LucideVideoCn Size="14" Class="size-3.5 text-muted-foreground/60" />
                                }
                                @if (evt.HasLocation)
                                {
                                    <LucideMapPinCn Size="14" Class="size-3.5 text-muted-foreground/60" />
                                }
                                @if (evt.Attendees > 0)
                                {
                                    <div class="flex items-center gap-1">
                                        <LucideUsersCn Size="14" Class="size-3.5 text-muted-foreground/60" />
                                        <span class="text-xs text-muted-foreground">@evt.Attendees</span>
                                    </div>
                                }
                            </div>
                        </div>
                        <LucideChevronRightCn Size="16" Class="size-4 shrink-0 text-muted-foreground/40" />
                    </CommandItemCn>
                }
            </CommandGroupCn>

            <CommandSeparatorCn />

            <CommandGroupCn Heading="Quick Actions">
                <CommandItemCn Class="flex items-center gap-3">
                    <div class="flex size-6 shrink-0 items-center justify-center rounded-md bg-muted">
                        <LucidePlusCn Size="14" Class="size-3.5 text-muted-foreground" />
                    </div>
                    <div class="flex min-w-0 flex-1 items-center justify-between">
                        <span class="text-sm font-medium">New Event</span>
                        <KbdCn class="text-xs">N</KbdCn>
                    </div>
                </CommandItemCn>
                <CommandItemCn Class="flex items-center gap-3">
                    <div class="flex size-6 shrink-0 items-center justify-center rounded-md bg-muted">
                        <LucideVideoCn Size="14" Class="size-3.5 text-muted-foreground" />
                    </div>
                    <div class="flex min-w-0 flex-1 items-center justify-between">
                        <span class="text-sm font-medium">Schedule Meeting</span>
                        <KbdCn class="text-xs">M</KbdCn>
                    </div>
                </CommandItemCn>
                <CommandItemCn Class="flex items-center gap-3">
                    <div class="flex size-6 shrink-0 items-center justify-center rounded-md bg-muted">
                        <LucideClockCn Size="14" Class="size-3.5 text-muted-foreground" />
                    </div>
                    <div class="flex min-w-0 flex-1 items-center justify-between">
                        <span class="text-sm font-medium">Block Time</span>
                        <KbdCn class="text-xs">T</KbdCn>
                    </div>
                </CommandItemCn>
            </CommandGroupCn>

            <CommandSeparatorCn />

            <CommandGroupCn Heading="Navigate">
                <CommandItemCn Class="flex items-center gap-3">
                    <LucideCalendarCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    <div class="flex min-w-0 flex-1 items-center justify-between">
                        <span class="text-sm font-medium">Day View</span>
                        <KbdCn class="text-xs">D</KbdCn>
                    </div>
                </CommandItemCn>
                <CommandItemCn Class="flex items-center gap-3">
                    <LucideCalendarDaysCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    <div class="flex min-w-0 flex-1 items-center justify-between">
                        <span class="text-sm font-medium">Week View</span>
                        <KbdCn class="text-xs">W</KbdCn>
                    </div>
                </CommandItemCn>
                <CommandItemCn Class="flex items-center gap-3">
                    <LucideCalendarRangeCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    <div class="flex min-w-0 flex-1 items-center justify-between">
                        <span class="text-sm font-medium">Month View</span>
                        <KbdCn class="text-xs">@@M</KbdCn>
                    </div>
                </CommandItemCn>
                <CommandItemCn Class="flex items-center gap-3">
                    <LucideLayoutGridCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    <div class="flex min-w-0 flex-1 items-center justify-between">
                        <span class="text-sm font-medium">Agenda View</span>
                        <KbdCn class="text-xs">A</KbdCn>
                    </div>
                </CommandItemCn>
            </CommandGroupCn>
        </CommandListCn>
    </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record CalendarEvent(string Id, string Title, string Time, string Duration, string Type, bool HasVideo = false, bool HasLocation = false, int Attendees = 0);

    private static readonly CalendarEvent[] _todayEvents =
    [
        new("1", "Design System Review", "09:00 AM", "1h", "meeting", HasVideo: true, Attendees: 4),
        new("2", "Sprint Planning", "10:30 AM", "2h", "meeting", HasLocation: true, Attendees: 8),
        new("3", "Component Architecture Docs", "02:00 PM", "1h", "task"),
        new("4", "1:1 with Sarah", "03:30 PM", "30m", "meeting", HasVideo: true, Attendees: 2),
    ];

    private static readonly CalendarEvent[] _tomorrowEvents =
    [
        new("5", "Product Demo", "11:00 AM", "45m", "meeting", HasVideo: true, Attendees: 12),
        new("6", "Team Lunch", "12:30 PM", "1h", "personal", HasLocation: true),
        new("7", "Code Review Session", "03:00 PM", "1h", "meeting", Attendees: 3),
    ];
}
