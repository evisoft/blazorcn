@* ============================================================
   Block: command-menu-spotlight
   Title: Command Menu Spotlight
   Description: A macOS Spotlight-style universal search command menu with app launcher, file search, and web search fallback for React applications
   Long Description: A command menu inspired by macOS Spotlight that provides instant access to apps, files, and web search. Features category tabs for filtering results, recently opened items, and keyboard-driven navigation for power users.
   Dependencies: BadgeCn, ButtonCn, CommandCn, KbdCn
   Source: original/blocks/command-menu/command-menu-spotlight.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" @onclick="() => _open = true">
            <LucideSearchCn Size="16" Class="mr-2 h-4 w-4" />
            <span>Command Menu Spotlight</span>
            <KbdCn class="ml-2">@@K</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Command Menu Spotlight</DialogTitleCn>
                <DialogDescriptionCn>A macOS Spotlight-style universal search command menu with app launcher, file search, and web search fallback for React applications</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Type a command or search..." />
                <CommandListCn>
                    <CommandEmptyCn>No results found.</CommandEmptyCn>
                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn>
                            <LucideSearchCn Size="16" Class="mr-2 h-4 w-4 text-muted-foreground" />
                            <span>Search...</span>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
}
