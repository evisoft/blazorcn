@* ============================================================
   Block: command-menu-roles
   Title: CommandMenuRoles
   Description: Role assignment manager command menu with permission levels, user counts, and quick assignment for React admin panels
   Source: original/blocks/command-menu/command-menu-roles.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" @onclick="() => _open = true">
            <LucideShieldCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Manage Roles</span>
            <KbdCn>⌘R</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Manage Roles</DialogTitleCn>
                <DialogDescriptionCn>Role assignment manager command menu with permission levels, user counts, and quick assignment for React admin panels</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="@(_selectedMember != null ? "Select role to assign..." : "Search members or roles...")" />
                <CommandListCn>
                    <CommandEmptyCn>No results found.</CommandEmptyCn>

                    @if (_selectedMember == null)
                    {
                        <CommandGroupCn Heading="Team Members">
                            @foreach (var mem in _members)
                            {
                                var member = mem;
                                <CommandItemCn Class="gap-3" OnSelect="@(() => _selectedMember = member.Id)">
                                    <LucideUserCn Size="16" Class="size-4 text-muted-foreground" />
                                    <div class="min-w-0 flex-1">
                                        <span class="text-sm font-medium">@member.Name</span>
                                        <p class="text-xs text-muted-foreground">@member.Email</p>
                                    </div>
                                    <span class="@($"text-xs font-medium capitalize {GetLevelColor(member.CurrentRole)}")">
                                        @member.CurrentRole
                                    </span>
                                </CommandItemCn>
                            }
                        </CommandGroupCn>

                        <CommandSeparatorCn />

                        <CommandGroupCn Heading="Roles">
                            @foreach (var rol in _roles)
                            {
                                var role = rol;
                                <CommandItemCn Class="gap-3">
                                    @switch (role.Level)
                                    {
                                        case "owner":
                                            <LucideCrownCn Size="16" Class="@($"size-4 {GetLevelColor(role.Level)}")" />
                                            break;
                                        case "admin":
                                            <LucideShieldCheckCn Size="16" Class="@($"size-4 {GetLevelColor(role.Level)}")" />
                                            break;
                                        case "editor":
                                            <LucidePencilCn Size="16" Class="@($"size-4 {GetLevelColor(role.Level)}")" />
                                            break;
                                        default:
                                            <LucideEyeCn Size="16" Class="@($"size-4 {GetLevelColor(role.Level)}")" />
                                            break;
                                    }
                                    <div class="min-w-0 flex-1">
                                        <span class="text-sm font-medium">@role.Name</span>
                                        <p class="text-xs text-muted-foreground">@role.Description</p>
                                    </div>
                                    <div class="flex items-center gap-1 text-xs text-muted-foreground">
                                        <LucideUsersCn Size="12" Class="size-3" />
                                        <span class="tabular-nums">@role.MemberCount</span>
                                    </div>
                                </CommandItemCn>
                            }
                        </CommandGroupCn>
                    }
                    else
                    {
                        var selMember = _members.Find(m => m.Id == _selectedMember);
                        <CommandGroupCn Heading="@($"Assign role to {selMember?.Name}")">
                            @foreach (var rol in _roles)
                            {
                                var role = rol;
                                var isCurrent = selMember?.CurrentRole == role.Id;
                                <CommandItemCn Class="gap-3" OnSelect="@(() => HandleAssignRole(_selectedMember!, role.Id))">
                                    @switch (role.Level)
                                    {
                                        case "owner":
                                            <LucideCrownCn Size="16" Class="@($"size-4 {GetLevelColor(role.Level)}")" />
                                            break;
                                        case "admin":
                                            <LucideShieldCheckCn Size="16" Class="@($"size-4 {GetLevelColor(role.Level)}")" />
                                            break;
                                        case "editor":
                                            <LucidePencilCn Size="16" Class="@($"size-4 {GetLevelColor(role.Level)}")" />
                                            break;
                                        default:
                                            <LucideEyeCn Size="16" Class="@($"size-4 {GetLevelColor(role.Level)}")" />
                                            break;
                                    }
                                    <div class="min-w-0 flex-1">
                                        <span class="text-sm font-medium">@role.Name</span>
                                        <p class="text-xs text-muted-foreground">@string.Join(", ", role.Permissions)</p>
                                    </div>
                                    @if (isCurrent)
                                    {
                                        <LucideCheckCn Size="16" Class="size-4 text-emerald-500" />
                                    }
                                </CommandItemCn>
                            }
                        </CommandGroupCn>
                    }
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideShieldCn Size="12" Class="size-3" />
                        <span>@_members.Count members &middot; @_roles.Count roles</span>
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
    private string? _selectedMember;

    private record RoleItem(string Id, string Name, string Description, string[] Permissions, int MemberCount, string Level);
    private record MemberItem(string Id, string Name, string Email, string CurrentRole);

    private readonly List<RoleItem> _roles =
    [
        new("owner",  "Owner",  "Full access with billing and member management",  new[] { "All permissions" },                                           1,  "owner"),
        new("admin",  "Admin",  "Manage members, settings, and all resources",     new[] { "Manage members", "Edit settings", "Delete resources" },      3,  "admin"),
        new("editor", "Editor", "Create and edit content, manage own resources",   new[] { "Create content", "Edit content", "Upload files" },           8,  "editor"),
        new("viewer", "Viewer", "Read-only access to all resources",               new[] { "View content", "Download files", "View reports" },           14, "viewer"),
    ];

    private readonly List<MemberItem> _members =
    [
        new("u1", "Alice Chen",  "alice@acme.com", "admin"),
        new("u2", "Bob Smith",   "bob@acme.com",   "editor"),
        new("u3", "Carol Park",  "carol@acme.com", "editor"),
        new("u4", "Dan Wilson",  "dan@acme.com",   "viewer"),
        new("u5", "Eve Taylor",  "eve@acme.com",   "viewer"),
    ];

    private static string GetLevelColor(string level) => level switch
    {
        "owner"  => "text-amber-500",
        "admin"  => "text-blue-500",
        "editor" => "text-emerald-500",
        "viewer" => "text-muted-foreground",
        "custom" => "text-purple-500",
        _        => "text-muted-foreground",
    };

    private void HandleAssignRole(string memberId, string roleId)
    {
        _ = memberId;
        _ = roleId;
        _selectedMember = null;
        _open = false;
    }
}
