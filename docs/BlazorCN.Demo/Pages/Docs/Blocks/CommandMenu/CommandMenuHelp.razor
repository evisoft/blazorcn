@* ============================================================
   Block: command-menu-help
   Title: Command Menu Help
   Description: A help center command menu with article previews, video tutorials, and support contact options
   Dependencies: BadgeCn, ButtonCn, CommandCn, DialogCn, KbdCn
   Source: original/blocks/command-menu/command-menu-help.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" class="gap-2">
            <LucideCircleQuestionMarkCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Help Center</span>
            <KbdCn>@@/</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="max-w-2xl gap-0 p-0">
            <DialogHeaderCn class="px-4 pt-4">
                <DialogTitleCn>Help Center</DialogTitleCn>
                <DialogDescriptionCn>Search articles, watch tutorials, or contact support</DialogDescriptionCn>
            </DialogHeaderCn>

            <CommandCn class="border-0">
                <CommandInputCn Placeholder="Search help articles..." class="border-0" />
                <CommandListCn class="max-h-[400px]">
                    <CommandEmptyCn>No articles found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Popular Articles">
                        @foreach (var article in _popularArticles)
                        {
                            <CommandItemCn class="gap-3">
                                <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted">
                                    <LucideBookOpenCn Size="16" Class="size-4 text-muted-foreground" />
                                </div>
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@article.Title</div>
                                    <p class="mt-0.5 line-clamp-1 text-xs text-muted-foreground">@article.Description</p>
                                    <div class="mt-1 flex items-center gap-2">
                                        <div class="flex items-center gap-1 text-xs text-muted-foreground">
                                            <LucideClockCn Size="12" Class="size-3" />
                                            <span>@article.ReadTime</span>
                                        </div>
                                        <BadgeCn Variant="BadgeVariant.Secondary" class="h-4 px-1.5 text-xs">Popular</BadgeCn>
                                    </div>
                                </div>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandGroupCn Heading="Video Tutorials">
                        @foreach (var video in _videoTutorials)
                        {
                            <CommandItemCn class="gap-3">
                                <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-blue-500/10">
                                    <LucidePlayCn Size="16" Class="size-4 text-blue-500" />
                                </div>
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@video.Title</div>
                                    <p class="mt-0.5 line-clamp-1 text-xs text-muted-foreground">@video.Description</p>
                                    <div class="mt-1 flex items-center gap-1 text-xs text-muted-foreground">
                                        <LucideVideoCn Size="12" Class="size-3" />
                                        <span>@video.Duration</span>
                                    </div>
                                </div>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandGroupCn Heading="All Articles">
                        @foreach (var article in _allArticles)
                        {
                            <CommandItemCn class="gap-3">
                                <LucideFileTextCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@article.Title</div>
                                    <p class="mt-0.5 truncate text-xs text-muted-foreground">@article.Description</p>
                                    <div class="mt-1 flex items-center gap-1 text-xs text-muted-foreground">
                                        <LucideClockCn Size="12" Class="size-3" />
                                        <span>@article.ReadTime</span>
                                    </div>
                                </div>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>
            </CommandCn>

            <DialogFooterCn class="border-t px-4 py-3 sm:justify-start">
                <div class="flex w-full gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" class="flex-1 gap-2">
                        <LucideMessageSquareCn Size="14" Class="size-3.5" />
                        <span>Chat with support</span>
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" class="flex-1 gap-2">
                        <LucideFileTextCn Size="14" Class="size-3.5" />
                        <span>View docs</span>
                        <LucideExternalLinkCn Size="12" Class="size-3" />
                    </ButtonCn>
                </div>
            </DialogFooterCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;

    private record ArticleItem(string Title, string Description, string ReadTime);
    private record VideoItem(string Title, string Description, string Duration);

    private static readonly ArticleItem[] _popularArticles =
    [
        new("Getting Started Guide", "Learn how to set up your project and start building in minutes.", "5 min read"),
        new("Authentication Setup", "Configure OAuth providers, magic links, and session management.", "8 min read"),
        new("API Rate Limiting", "Understanding rate limits and how to handle them gracefully.", "4 min read"),
    ];

    private static readonly VideoItem[] _videoTutorials =
    [
        new("Platform Overview", "A 10-minute walkthrough of all major features and capabilities.", "10:24"),
        new("Building Your First App", "Step-by-step tutorial for creating a full-stack application.", "18:45"),
        new("Advanced Workflows", "Learn how to set up complex automation pipelines.", "12:30"),
    ];

    private static readonly ArticleItem[] _allArticles =
    [
        new("Database Branching", "Create isolated database branches for safe schema migrations.", "6 min read"),
        new("Webhook Configuration", "Set up webhook endpoints with retry logic and signing.", "5 min read"),
        new("Team Management", "Manage roles, permissions, and SSO for your organization.", "7 min read"),
        new("Custom Domains", "Configure custom domains with automatic SSL certificate provisioning.", "3 min read"),
    ];
}
