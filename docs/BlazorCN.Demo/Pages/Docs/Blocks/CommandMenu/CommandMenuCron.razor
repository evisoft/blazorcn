@* ============================================================
   Block: command-menu-cron
   Title: CommandMenuCron
   Description: Cron expression builder command menu with preset schedules and expression preview for React scheduling apps
   Source: original/blocks/command-menu/command-menu-cron.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn @onclick="() => _open = true" Variant="ButtonVariant.Outline" Class="gap-2">
            <LucideTimerCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Cron Builder</span>
            <KbdCn>@@⇧T</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Cron Builder</DialogTitleCn>
                <DialogDescriptionCn>Cron expression builder command menu with preset schedules and expression preview for React scheduling apps</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search schedules..." />
                <CommandListCn>
                    <CommandEmptyCn>No schedules found.</CommandEmptyCn>

                    <CommandGroupCn Heading="Minutes">
                        @foreach (var preset in _minutePresets)
                        {
                            var p = preset;
                            <CommandItemCn Class="gap-3" @onclick="() => HandleSelect(p)">
                                <LucideRepeatCn Size="16" Class="size-4 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@p.Label</div>
                                    <p class="text-xs text-muted-foreground">@p.Description</p>
                                </div>
                                <span class="font-mono text-xs text-muted-foreground">@p.Expression</span>
                                @if (_selected?.Id == p.Id)
                                {
                                    <LucideCheckCn Size="16" Class="size-4 text-emerald-500" />
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandGroupCn Heading="Hourly">
                        @foreach (var preset in _hourlyPresets)
                        {
                            var p = preset;
                            <CommandItemCn Class="gap-3" @onclick="() => HandleSelect(p)">
                                <LucideClockCn Size="16" Class="size-4 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@p.Label</div>
                                    <p class="text-xs text-muted-foreground">@p.Description</p>
                                </div>
                                <span class="font-mono text-xs text-muted-foreground">@p.Expression</span>
                                @if (_selected?.Id == p.Id)
                                {
                                    <LucideCheckCn Size="16" Class="size-4 text-emerald-500" />
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Daily & Weekly">
                        @foreach (var preset in _dailyPresets)
                        {
                            var p = preset;
                            <CommandItemCn Class="gap-3" @onclick="() => HandleSelect(p)">
                                <LucideCalendarCn Size="16" Class="size-4 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@p.Label</div>
                                    <p class="text-xs text-muted-foreground">@p.Description</p>
                                </div>
                                <span class="font-mono text-xs text-muted-foreground">@p.Expression</span>
                                @if (_selected?.Id == p.Id)
                                {
                                    <LucideCheckCn Size="16" Class="size-4 text-emerald-500" />
                                }
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                </CommandListCn>

                <div class="flex items-center justify-between border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideTimerCn Size="12" Class="size-3" />
                        <span>@(_selected != null ? _selected.Expression : "Select a schedule")</span>
                    </div>
                    @if (_selected != null)
                    {
                        <button type="button" @onclick="HandleCopy"
                            class="flex items-center gap-1 rounded px-2 py-1 text-xs text-muted-foreground hover:bg-muted hover:text-foreground">
                            @if (_copied)
                            {
                                <LucideCheckCn Size="12" Class="size-3" />
                            }
                            else
                            {
                                <LucideCopyCn Size="12" Class="size-3" />
                            }
                            @(_copied ? "Copied" : "Copy")
                        </button>
                    }
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
    private CronPreset? _selected;
    private bool _copied;

    private record CronPreset(string Id, string Label, string Expression, string Description);

    private static readonly CronPreset[] _minutePresets =
    [
        new("every-min", "Every Minute", "* * * * *", "Runs every 60 seconds"),
        new("every-5", "Every 5 Minutes", "*/5 * * * *", "Runs 12 times per hour"),
        new("every-15", "Every 15 Minutes", "*/15 * * * *", "Runs 4 times per hour"),
        new("every-30", "Every 30 Minutes", "*/30 * * * *", "Runs twice per hour"),
    ];

    private static readonly CronPreset[] _hourlyPresets =
    [
        new("every-hour", "Every Hour", "0 * * * *", "At minute 0 of every hour"),
        new("every-2h", "Every 2 Hours", "0 */2 * * *", "At minute 0, every 2 hours"),
        new("every-6h", "Every 6 Hours", "0 */6 * * *", "4 times per day"),
        new("every-12h", "Every 12 Hours", "0 0,12 * * *", "At midnight and noon"),
    ];

    private static readonly CronPreset[] _dailyPresets =
    [
        new("daily-midnight", "Daily at Midnight", "0 0 * * *", "Every day at 00:00"),
        new("daily-9am", "Daily at 9 AM", "0 9 * * *", "Every day at 09:00"),
        new("weekdays-9am", "Weekdays at 9 AM", "0 9 * * 1-5", "Mon-Fri at 09:00"),
        new("weekly-monday", "Weekly on Monday", "0 9 * * 1", "Every Monday at 09:00"),
        new("monthly-first", "Monthly on the 1st", "0 0 1 * *", "First day of each month"),
    ];

    private void HandleSelect(CronPreset preset)
    {
        _selected = preset;
    }

    private async Task HandleCopy()
    {
        if (_selected != null)
        {
            _copied = true;
            StateHasChanged();
            await Task.Delay(1500);
            _copied = false;
        }
    }
}
