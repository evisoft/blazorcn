@* ============================================================
   Block: command-menu-quick-edit
   Title: CommandMenuQuickEdit
   Description: Quick inline editor command menu with field selection, value editing, and save actions for React admin panels
   Source: original/blocks/command-menu/command-menu-quick-edit.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-center overflow-hidden rounded-lg border bg-card px-6 py-16">
        <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" @onclick="() => _open = true">
            <LucidePencilCn Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-sm">Quick Edit</span>
            <KbdCn>@@E</KbdCn>
        </ButtonCn>
    </div>

    <DialogCn @bind-Open="_open">
        <DialogContentCn class="gap-0 overflow-hidden p-0 sm:max-w-lg" ShowCloseButton="false">
            <DialogHeaderCn class="sr-only">
                <DialogTitleCn>Command Menu</DialogTitleCn>
                <DialogDescriptionCn>Search and edit fields.</DialogDescriptionCn>
            </DialogHeaderCn>
            <CommandCn>
                <CommandInputCn Placeholder="Search fields to edit..." />
                <CommandListCn>
                    <CommandEmptyCn>No fields found.</CommandEmptyCn>

                    @foreach (var cat in _categories)
                    {
                        var category = cat;
                        var catIndex = System.Array.IndexOf(_categories, category);
                        @if (catIndex > 0)
                        {
                            <CommandSeparatorCn />
                        }
                        <CommandGroupCn Heading="@category">
                            @foreach (var fld in _fields)
                            {
                                var field = fld;
                                @if (field.Category == category)
                                {
                                    var isEditing = _editingField == field.Id;
                                    <CommandItemCn Class="gap-3" OnSelect="@(() => HandleSelect(field.Id))">
                                        @switch (field.Icon)
                                        {
                                            case "user":
                                                <LucideUserCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                                break;
                                            case "mail":
                                                <LucideMailCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                                break;
                                            case "tag":
                                                <LucideTagCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                                break;
                                            case "toggle-left":
                                                <LucideToggleLeftCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                                break;
                                            case "hash":
                                                <LucideHashCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                                break;
                                            case "calendar":
                                                <LucideCalendarCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                                break;
                                            case "text":
                                                <LucideIconCn Name="text" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                                break;
                                        }
                                        <div class="min-w-0 flex-1">
                                            <span class="text-sm font-medium">@field.Label</span>
                                            <p class="text-xs text-muted-foreground">@_typeLabels[field.Type]</p>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <span class="font-mono text-xs text-muted-foreground">@field.Value</span>
                                            @if (isEditing)
                                            {
                                                <LucideCheckCn Size="14" Class="size-3.5 text-emerald-500" />
                                            }
                                            else
                                            {
                                                <LucidePencilCn Size="14" Class="size-3.5 text-muted-foreground/60" />
                                            }
                                        </div>
                                    </CommandItemCn>
                                }
                            }
                        </CommandGroupCn>
                    }

                    <CommandSeparatorCn />

                    <CommandGroupCn Heading="Actions">
                        <CommandItemCn Class="gap-3">
                            <LucideSaveCn Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">Save all changes</span>
                            <KbdCn class="ml-auto">@@S</KbdCn>
                        </CommandItemCn>
                    </CommandGroupCn>
                </CommandListCn>

                <div class="border-t px-3 py-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucidePencilCn Size="12" Class="size-3" />
                        <span>@_fields.Length editable fields</span>
                        @if (_editingField != null)
                        {
                            var editingLabel = System.Array.Find(_fields, f => f.Id == _editingField)?.Label;
                            <span>&middot;</span>
                            <span>Editing: @editingLabel</span>
                        }
                    </div>
                </div>
            </CommandCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _open;
    private string? _editingField;

    private record EditableField(string Id, string Label, string Value, string Type, string Icon, string Category);

    private static readonly EditableField[] _fields =
    [
        new("name",      "Full Name",     "Alice Chen",   "text",    "user",        "Profile"),
        new("email",     "Email",         "alice@acme.com","email",  "mail",        "Profile"),
        new("role",      "Role",          "Admin",        "select",  "tag",         "Profile"),
        new("active",    "Active",        "Yes",          "boolean", "toggle-left", "Profile"),
        new("plan",      "Plan",          "Pro",          "select",  "tag",         "Subscription"),
        new("seats",     "Seats",         "5",            "number",  "hash",        "Subscription"),
        new("renewal",   "Renewal Date",  "Apr 15, 2026", "date",    "calendar",    "Subscription"),
        new("company",   "Company",       "Acme Corp",    "text",    "text",        "Organization"),
        new("team-size", "Team Size",     "24",           "number",  "hash",        "Organization"),
    ];

    private static readonly string[] _categories = ["Profile", "Subscription", "Organization"];

    private static readonly Dictionary<string, string> _typeLabels = new()
    {
        ["text"]    = "Text",
        ["email"]   = "Email",
        ["number"]  = "Number",
        ["boolean"] = "Toggle",
        ["date"]    = "Date",
        ["select"]  = "Select",
    };

    private void HandleSelect(string fieldId)
    {
        _editingField = fieldId;
    }
}
