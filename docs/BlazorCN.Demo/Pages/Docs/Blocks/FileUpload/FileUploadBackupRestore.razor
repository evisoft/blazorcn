@* ============================================================
   Block: file-upload-backup-restore
   Title: FileUploadBackupRestore
   Description: Database and application backup upload block for React and Next.js with file validation, backup metadata, size display, restore confirmation dialog, and warning notice using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-backup-restore.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideIconCn Name="database" Size="16" Class="size-4 text-muted-foreground" />
            <div class="flex-1">
                <p class="font-medium text-sm">Restore from backup</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Upload a database backup file to restore your application
                </p>
            </div>
        </div>

        @* Upload zone or file info *@
        @if (_file == null)
        {
            <div class="border-b px-4 py-4">
                <div
                    role="button"
                    tabindex="0"
                    @onclick="HandleUpload"
                    @onkeydown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter" || e.Key == " ") await HandleUpload(); })"
                    class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-md border-2 border-dashed border-muted-foreground/20 px-6 py-10 transition-colors hover:border-muted-foreground/40 hover:bg-muted/30">
                    <LucideIconCn Name="cloud-upload" Size="32" Class="size-8 text-muted-foreground/60" />
                    <div class="text-center">
                        <span class="font-medium text-sm">Upload backup file</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            .sql, .sql.gz, .dump, or .bak up to 10 GB
                        </p>
                    </div>
                </div>
            </div>
        }
        else
        {
            var currentFile = _file;
            @* File details *@
            <div class="border-b px-4 py-3">
                <div class="flex items-start gap-3">
                    <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        <LucideIconCn Name="file-archive" Size="16" Class="size-4 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="truncate font-medium text-sm">@currentFile.Name</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-mono text-[10px]">
                                @currentFile.Format
                            </BadgeCn>
                        </div>
                        <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                            <span>@currentFile.Size</span>
                            <span>·</span>
                            <span>@currentFile.Date</span>
                        </div>
                    </div>
                    <ButtonCn
                        Variant="ButtonVariant.Ghost"
                        Size="ButtonSize.Sm"
                        Class="size-7 shrink-0 p-0 text-muted-foreground hover:text-foreground"
                        OnClick="HandleRemove">
                        <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                    </ButtonCn>
                </div>
            </div>

            @* Backup metadata *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-6">
                    <div>
                        <span class="text-muted-foreground text-xs">Tables</span>
                        <p class="font-semibold text-sm tabular-nums">@currentFile.Tables</p>
                    </div>
                    <div>
                        <span class="text-muted-foreground text-xs">Records</span>
                        <p class="font-semibold text-sm tabular-nums">@currentFile.Records</p>
                    </div>
                    <div>
                        <span class="text-muted-foreground text-xs">Format</span>
                        <p class="font-medium text-sm">@currentFile.Format</p>
                    </div>
                </div>
            </div>

            @* Validation status *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    @if (_validation == "validating")
                    {
                        <LucideIconCn Name="loader-2" Size="14" Class="size-3.5 animate-spin text-muted-foreground" />
                    }
                    @if (_validation == "valid")
                    {
                        <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                    }
                    @if (_validation == "invalid")
                    {
                        <LucideIconCn Name="alert-triangle" Size="14" Class="size-3.5 text-red-600 dark:text-red-400" />
                    }
                    <span class="@Cn.Merge("text-xs", _validation == "valid" ? "text-emerald-600 dark:text-emerald-400" : _validation == "invalid" ? "text-red-600 dark:text-red-400" : "text-muted-foreground")">
                        @_validationMessages[_validation]
                    </span>
                    @if (_validation == "valid")
                    {
                        <LucideIconCn Name="check-circle-2" Size="14" Class="ml-auto size-3.5 text-emerald-500" />
                    }
                </div>
            </div>
        }

        @* Warning notice *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-2 rounded-md bg-muted/50 p-3">
                <LucideIconCn Name="alert-triangle" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-amber-500" />
                <div>
                    <span class="font-medium text-xs">Destructive operation</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Restoring a backup will replace all existing data in your database. This action
                        cannot be undone. Make sure you have a current backup before proceeding.
                    </p>
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" Disabled="@(_file == null)">
                Verify integrity
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" Disabled="@(_file == null || _validation != "valid")" OnClick="@(() => _dialogOpen = true)">
                Restore from backup
            </ButtonCn>
            <DialogCn Open="@_dialogOpen" OpenChanged="@((bool v) => _dialogOpen = v)">
                <DialogContentCn>
                    <DialogHeaderCn>
                        <DialogTitleCn>Confirm restore</DialogTitleCn>
                        <DialogDescriptionCn>
                            This will replace all data in your production database with the contents of
                            <span class="font-medium text-foreground">@(_file?.Name)</span>. This action is
                            irreversible.
                        </DialogDescriptionCn>
                    </DialogHeaderCn>
                    <div class="rounded-md bg-red-500/10 p-3">
                        <div class="flex items-start gap-2">
                            <LucideIconCn Name="alert-triangle" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-red-500" />
                            <p class="text-sm text-red-600 dark:text-red-400">
                                All existing tables, records, and configurations will be permanently
                                overwritten. Active user sessions will be terminated.
                            </p>
                        </div>
                    </div>
                    <DialogFooterCn>
                        <ButtonCn
                            Variant="ButtonVariant.Outline"
                            Size="ButtonSize.Sm"
                            Class="h-8 text-xs"
                            OnClick="@(() => _dialogOpen = false)">
                            Cancel
                        </ButtonCn>
                        <ButtonCn
                            Variant="ButtonVariant.Destructive"
                            Size="ButtonSize.Sm"
                            Class="h-8 text-xs"
                            OnClick="HandleRestore"
                            Disabled="@_restoring">
                            @if (_restoring)
                            {
                                <LucideIconCn Name="loader-2" Size="12" Class="size-3 animate-spin" />
                                <span>Restoring...</span>
                            }
                            else
                            {
                                <span>Yes, restore database</span>
                            }
                        </ButtonCn>
                    </DialogFooterCn>
                </DialogContentCn>
            </DialogCn>
        </div>
    </div>
</section>

@code {
    private record BackupFile(string Name, string Size, string Date, string Format, int Tables, string Records);

    private static readonly Dictionary<string, string> _validationMessages = new()
    {
        ["idle"]       = "",
        ["validating"] = "Checking backup integrity...",
        ["valid"]      = "Backup file is valid and ready to restore",
        ["invalid"]    = "Backup file is corrupted or incompatible",
    };

    private BackupFile? _file = null;
    private string _validation = "idle";
    private bool _dialogOpen = false;
    private bool _restoring = false;

    private async Task HandleUpload()
    {
        _file = new BackupFile(
            "acme-prod-backup-2026-03-20.sql.gz",
            "2.4 GB",
            "Mar 20, 2026 at 14:32 UTC",
            "PostgreSQL",
            47,
            "1,284,391"
        );
        _validation = "validating";
        StateHasChanged();
        await Task.Delay(1500);
        _validation = "valid";
    }

    private async Task HandleRestore()
    {
        _restoring = true;
        StateHasChanged();
        await Task.Delay(2000);
        _restoring = false;
        _dialogOpen = false;
    }

    private void HandleRemove()
    {
        _file = null;
        _validation = "idle";
    }
}
