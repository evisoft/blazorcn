@* ============================================================
   Block: file-upload-crop-tool
   Title: FileUploadCropTool
   Description: Image upload with crop tool featuring aspect ratio presets for 1:1, 4:3, 16:9, and free crop, a crop preview placeholder, apply button, and original vs cropped size comparison using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-crop-tool.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="crop" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Image Crop</span>
            </div>
            @if (_state != "idle")
            {
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" OnClick="Reset">
                    Reset
                </ButtonCn>
            }
        </div>

        @* Upload area *@
        @if (_state == "idle")
        {
            <div class="border-b px-4 py-4">
                <div
                    role="button"
                    tabindex="0"
                    @onclick="SimulateUpload"
                    class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-md border-2 border-dashed border-muted-foreground/20 px-6 py-10 transition-colors hover:border-muted-foreground/40 hover:bg-muted/30">
                    <LucideIconCn Name="cloud-upload" Size="32" Class="size-8 text-muted-foreground/60" />
                    <span class="font-medium text-sm">Upload image to crop</span>
                    <p class="text-muted-foreground text-xs">PNG, JPG, or WebP up to 50 MB</p>
                </div>
            </div>
        }

        @* File info *@
        @if (_state != "idle")
        {
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <LucideIconCn Name="image" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                <div class="min-w-0 flex-1">
                    <span class="block truncate font-medium text-sm">@_fileName</span>
                    <span class="text-muted-foreground text-xs">@_fileSize</span>
                </div>
                <span class="font-mono tabular-nums text-muted-foreground text-xs">
                    @_originalWidth x @_originalHeight
                </span>
            </div>
        }

        @* Aspect ratio presets *@
        @if (_state != "idle")
        {
            <div class="border-b px-4 py-3">
                <span class="mb-2 block text-muted-foreground text-xs">Aspect ratio</span>
                <div class="flex gap-1.5">
                    @foreach (var ratio in _ratios)
                    {
                        var r = ratio;
                        <button
                            type="button"
                            @onclick="@(() => ApplyRatio(r.Label, r.Value))"
                            class="@Cn.Merge("rounded-md px-3 py-1 text-xs transition-colors", _activeRatio == r.Label ? "bg-foreground text-background" : "bg-muted/50 text-muted-foreground hover:bg-muted")">
                            @r.Label
                        </button>
                    }
                </div>
            </div>
        }

        @* Crop preview placeholder *@
        @if (_state != "idle")
        {
            <div class="border-b px-4 py-4">
                <div class="relative overflow-hidden rounded-md bg-muted/30">
                    @* Simulated image area *@
                    <div class="flex aspect-[3/2] items-center justify-center">
                        <div class="relative flex h-full w-full items-center justify-center bg-muted/20">
                            @* Darkened overlay for cropped-out region *@
                            <div class="absolute inset-0 bg-foreground/5"></div>

                            @* Crop selection box *@
                            <div
                                class="relative border-2 border-foreground bg-background/5"
                                style="@(FormattableString.Invariant($"width:{(_cropWidth / (double)_originalWidth * 100):F2}%;height:{(_cropHeight / (double)_originalHeight * 100):F2}%"))">
                                @* Corner handles *@
                                <div class="absolute -top-1 -left-1 size-2 bg-foreground"></div>
                                <div class="absolute -top-1 -right-1 size-2 bg-foreground"></div>
                                <div class="absolute -bottom-1 -left-1 size-2 bg-foreground"></div>
                                <div class="absolute -right-1 -bottom-1 size-2 bg-foreground"></div>

                                @* Center label *@
                                <div class="flex h-full items-center justify-center">
                                    <span class="rounded bg-foreground/80 px-2 py-0.5 font-mono text-background text-xs">
                                        @_cropWidth x @_cropHeight
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* Size comparison *@
        @if (_state != "idle")
        {
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-4">
                    <div class="flex-1">
                        <span class="mb-0.5 block text-muted-foreground text-xs">Original</span>
                        <span class="font-mono tabular-nums text-sm">
                            @_originalWidth x @_originalHeight
                        </span>
                        <span class="ml-2 text-muted-foreground text-xs">@_fileSize</span>
                    </div>
                    <div class="flex-1">
                        <span class="mb-0.5 block text-muted-foreground text-xs">Cropped</span>
                        <span class="font-mono tabular-nums text-sm">
                            @_cropWidth x @_cropHeight
                        </span>
                        <span class="ml-2 text-muted-foreground text-xs">~@EstimatedCroppedSize</span>
                    </div>
                    @if (ReductionPercent > 0)
                    {
                        <span class="tabular-nums text-emerald-600 text-xs dark:text-emerald-400">
                            -@(ReductionPercent)%
                        </span>
                    }
                </div>
            </div>
        }

        @* Actions *@
        <div class="px-4 py-3">
            @if (_state == "idle")
            {
                <span class="text-muted-foreground text-xs">
                    Upload an image to crop with aspect ratio presets
                </span>
            }
            @if (_state == "selecting")
            {
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-xs">
                        Adjust the crop area and select an aspect ratio
                    </span>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="ApplyCrop">
                        Apply crop
                    </ButtonCn>
                </div>
            }
            @if (_state == "cropped")
            {
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                        <span class="text-muted-foreground text-xs">Crop applied</span>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                        <LucideIconCn Name="download" Size="12" Class="size-3" />
                        Download cropped
                    </ButtonCn>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record RatioOption(string Label, double Value);

    private static readonly RatioOption[] _ratios =
    [
        new RatioOption("Free", 0),
        new RatioOption("1:1", 1),
        new RatioOption("4:3", 4.0 / 3.0),
        new RatioOption("3:2", 3.0 / 2.0),
        new RatioOption("16:9", 16.0 / 9.0),
    ];

    private string _state = "idle";
    private string _fileName = "";
    private string _fileSize = "";
    private int _originalWidth = 0;
    private int _originalHeight = 0;
    private string _activeRatio = "Free";
    private int _cropX = 0;
    private int _cropY = 0;
    private int _cropWidth = 0;
    private int _cropHeight = 0;

    private int OriginalPixels => _originalWidth * _originalHeight;
    private int CroppedPixels => _cropWidth * _cropHeight;
    private int ReductionPercent => OriginalPixels > 0
        ? (int)Math.Round((1.0 - CroppedPixels / (double)OriginalPixels) * 100)
        : 0;
    private string EstimatedCroppedSize => OriginalPixels > 0
        ? FormatSize((int)Math.Round(CroppedPixels / (double)OriginalPixels * 2400000))
        : "0 B";

    private static string FormatSize(int bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{(bytes / 1024.0):F1} KB";
        return $"{(bytes / (1024.0 * 1024.0)):F1} MB";
    }

    private void SimulateUpload()
    {
        _fileName = "photo.jpg";
        _fileSize = FormatSize(2400000);
        _originalWidth = 2400;
        _originalHeight = 1600;
        _activeRatio = "Free";
        _cropX = 200;
        _cropY = 100;
        _cropWidth = 2000;
        _cropHeight = 1400;
        _state = "selecting";
    }

    private void ApplyRatio(string label, double ratio)
    {
        _activeRatio = label;
        if (ratio == 0)
        {
            _cropX = 200;
            _cropY = 100;
            _cropWidth = 2000;
            _cropHeight = 1400;
        }
        else
        {
            var maxWidth = _originalWidth * 0.85;
            var maxHeight = maxWidth / ratio;
            if (maxHeight > _originalHeight * 0.85)
            {
                var h = _originalHeight * 0.85;
                var w = h * ratio;
                _cropX = (int)Math.Round((_originalWidth - w) / 2);
                _cropY = (int)Math.Round((_originalHeight - h) / 2);
                _cropWidth = (int)Math.Round(w);
                _cropHeight = (int)Math.Round(h);
            }
            else
            {
                _cropX = (int)Math.Round((_originalWidth - maxWidth) / 2);
                _cropY = (int)Math.Round((_originalHeight - maxHeight) / 2);
                _cropWidth = (int)Math.Round(maxWidth);
                _cropHeight = (int)Math.Round(maxHeight);
            }
        }
        _state = "selecting";
    }

    private void ApplyCrop()
    {
        _state = "cropped";
    }

    private void Reset()
    {
        _state = "idle";
        _fileName = "";
        _fileSize = "";
        _originalWidth = 0;
        _originalHeight = 0;
        _cropX = 0;
        _cropY = 0;
        _cropWidth = 0;
        _cropHeight = 0;
        _activeRatio = "Free";
    }
}
