@* ============================================================
   Block: file-upload-3d-model
   Title: FileUpload3dModel
   Description: A 3D model file upload block for React and Next.js supporting STL, OBJ, and GLTF formats with a model preview placeholder, file specs including vertex count, face count, file size, material count display, and render quality selector using shadcn/ui Button, Badge, and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-3d-model.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="box" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">3D Models</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_models.Length files
            </BadgeCn>
            <div class="ml-auto">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="upload" Size="12" Class="size-3" />
                    Upload
                </ButtonCn>
            </div>
        </div>

        @* Render quality selector *@
        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <span class="text-muted-foreground text-xs">Render quality</span>
            <div class="flex gap-1">
                @foreach (var opt in _qualityOptions)
                {
                    var optVal = opt.Value;
                    <button
                        type="button"
                        @onclick="@(() => _quality = optVal)"
                        class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs transition-colors", _quality == opt.Value ? "bg-foreground text-background" : "text-muted-foreground hover:bg-muted/50")">
                        @opt.Label
                    </button>
                }
            </div>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">STL, OBJ, GLTF accepted</span>
        </div>

        @* Model list *@
        <div>
            @for (int i = 0; i < _models.Length; i++)
            {
                var model = _models[i];
                var isLast = i == _models.Length - 1;
                var isExpanded = _expandedModel == model.Id;
                var modelId = model.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expandedModel = (isExpanded ? null : modelId))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        @* Model preview placeholder *@
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="box" Size="16" Class="size-4 text-muted-foreground/60" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@model.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @model.Faces faces · @model.Size
                            </p>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-mono font-normal text-xs">
                            @model.Format
                        </BadgeCn>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-[4.25rem]">
                            @* Model preview area *@
                            <div class="mb-3 flex h-40 items-center justify-center rounded-md bg-muted/30">
                                <div class="text-center">
                                    <LucideIconCn Name="box" Size="32" Class="mx-auto size-8 text-muted-foreground/40" />
                                    <p class="mt-1 text-muted-foreground text-xs">
                                        3D preview · @_quality quality
                                    </p>
                                </div>
                            </div>

                            @* Specs *@
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="grid grid-cols-2 gap-2 text-xs">
                                    <div>
                                        <span class="text-muted-foreground">Vertices</span>
                                        <p class="font-mono tabular-nums">@model.Vertices</p>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground">Faces</span>
                                        <p class="font-mono tabular-nums">@model.Faces</p>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground">Materials</span>
                                        <p class="font-mono tabular-nums">@model.Materials</p>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground">File size</span>
                                        <p class="font-mono">@model.Size</p>
                                    </div>
                                    <div class="col-span-2">
                                        <span class="text-muted-foreground">Dimensions</span>
                                        <p class="font-mono">@model.Dimensions</p>
                                    </div>
                                </div>
                                <div class="mt-3 flex gap-2">
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                                        <LucideIconCn Name="download" Size="12" Class="size-3" />
                                        Download
                                    </ButtonCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Model3D(string Id, string Name, string Format, string Size, string Vertices, string Faces, int Materials, string Dimensions);
    private record QualityOption(string Value, string Label);

    private static readonly Model3D[] _models =
    [
        new("1", "Engine Block Assembly", "GLTF", "24.3 MB", "482,916", "241,458", 6, "320 x 280 x 410 mm"),
        new("2", "Phone Case v3", "STL", "8.7 MB", "156,240", "78,120", 1, "155 x 78 x 12 mm"),
        new("3", "Architectural Facade Panel", "OBJ", "41.2 MB", "723,108", "361,554", 4, "2400 x 3600 x 150 mm"),
    ];

    private static readonly QualityOption[] _qualityOptions =
    [
        new("low", "Low"),
        new("medium", "Medium"),
        new("high", "High"),
    ];

    private string? _expandedModel = "1";
    private string _quality = "medium";
}
