@* ============================================================
   Block: file-upload-grid-view
   Title: FileUploadGridView
   Description: A React file manager grid view block with responsive file thumbnail tiles, file type icons, name truncation, selection checkboxes, context menu with rename, download, share, and delete, and grid/list view toggle using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-grid-view.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Files</span>
                <span class="ml-2 text-muted-foreground text-xs">@_files.Length items</span>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn
                    Variant="@(_view == "grid" ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                    Size="ButtonSize.Sm"
                    Class="size-7 p-0"
                    OnClick="@(() => _view = "grid")"
                    aria-label="Grid view">
                    <LucideIconCn Name="grid" Size="14" Class="size-3.5" />
                </ButtonCn>
                <ButtonCn
                    Variant="@(_view == "list" ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                    Size="ButtonSize.Sm"
                    Class="size-7 p-0"
                    OnClick="@(() => _view = "list")"
                    aria-label="List view">
                    <LucideIconCn Name="list" Size="14" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>

        @* Selection bar *@
        @if (_selected.Count > 0)
        {
            <div class="flex items-center gap-2 border-b bg-muted/50 px-4 py-2">
                <span class="font-medium text-xs">@_selected.Count selected</span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="ml-auto h-6 px-2 text-xs" OnClick="ClearSelection">
                    Clear
                </ButtonCn>
            </div>
        }

        @* Grid view *@
        @if (_view == "grid")
        {
            <div class="p-4">
                <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
                    @foreach (var fileItem in _files)
                    {
                        var file = fileItem;
                        <div class="@Cn.Merge("group relative rounded-md border p-3 transition-colors hover:bg-muted/50", _selected.Contains(file.Id) ? "border-primary bg-muted/30" : "")">
                            @* Checkbox *@
                            <div class="@Cn.Merge("absolute top-2 left-2 z-10 transition-opacity", _selected.Contains(file.Id) ? "opacity-100" : "opacity-0 group-hover:opacity-100")">
                                <CheckboxCn
                                    Checked="@_selected.Contains(file.Id)"
                                    CheckedChanged="@(() => ToggleSelect(file.Id))"
                                    aria-label="@($"Select {file.Name}")" />
                            </div>

                            @* Context menu trigger *@
                            <div class="absolute top-2 right-2 z-10 opacity-0 transition-opacity group-hover:opacity-100">
                                <DropdownMenuCn>
                                    <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-ghost cn-button-size-sm size-6 p-0" data-variant="ghost" data-size="sm" aria-label="More options">
                                            <LucideIconCn Name="more-vertical" Size="14" Class="size-3.5" />
                                        </DropdownMenuTriggerCn>
                                    <DropdownMenuContentCn Align="FloatingAlign.End" Class="w-40">
                                        <DropdownMenuItemCn Class="gap-2 text-xs">
                                            <LucideIconCn Name="pencil" Size="14" Class="size-3.5" />
                                            Rename
                                        </DropdownMenuItemCn>
                                        <DropdownMenuItemCn Class="gap-2 text-xs">
                                            <LucideIconCn Name="download" Size="14" Class="size-3.5" />
                                            Download
                                        </DropdownMenuItemCn>
                                        <DropdownMenuItemCn Class="gap-2 text-xs">
                                            <LucideIconCn Name="share" Size="14" Class="size-3.5" />
                                            Share
                                        </DropdownMenuItemCn>
                                        <DropdownMenuSeparatorCn />
                                        <DropdownMenuItemCn Variant="destructive" Class="gap-2 text-xs">
                                            <LucideIconCn Name="trash-2" Size="14" Class="size-3.5" />
                                            Delete
                                        </DropdownMenuItemCn>
                                    </DropdownMenuContentCn>
                                </DropdownMenuCn>
                            </div>

                            @* Icon *@
                            <div class="flex aspect-square items-center justify-center rounded bg-muted/50">
                                @TypeIcon(file.Type, large: true)
                            </div>

                            @* Name and meta *@
                            <div class="mt-2">
                                <p class="truncate font-medium text-xs">@file.Name</p>
                                <p class="mt-0.5 text-muted-foreground text-xs">@file.Size</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @* List view *@
        @if (_view == "list")
        {
            <div class="divide-y">
                @foreach (var fileItem in _files)
                {
                    var file = fileItem;
                    <div class="@Cn.Merge("group flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", _selected.Contains(file.Id) ? "bg-muted/30" : "")">
                        <CheckboxCn
                            Checked="@_selected.Contains(file.Id)"
                            CheckedChanged="@(() => ToggleSelect(file.Id))"
                            aria-label="@($"Select {file.Name}")" />
                        @TypeIcon(file.Type, large: false)
                        <div class="min-w-0 flex-1">
                            <span class="truncate font-medium text-sm">@file.Name</span>
                        </div>
                        <span class="hidden text-muted-foreground text-xs sm:block">@file.Modified</span>
                        <span class="text-muted-foreground text-xs tabular-nums">@file.Size</span>
                        <div class="opacity-0 transition-opacity group-hover:opacity-100">
                            <DropdownMenuCn>
                                <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-ghost cn-button-size-sm size-6 p-0" data-variant="ghost" data-size="sm" aria-label="More options">
                                        <LucideIconCn Name="more-vertical" Size="14" Class="size-3.5" />
                                    </DropdownMenuTriggerCn>
                                <DropdownMenuContentCn Align="FloatingAlign.End" Class="w-40">
                                    <DropdownMenuItemCn Class="gap-2 text-xs">
                                        <LucideIconCn Name="pencil" Size="14" Class="size-3.5" />
                                        Rename
                                    </DropdownMenuItemCn>
                                    <DropdownMenuItemCn Class="gap-2 text-xs">
                                        <LucideIconCn Name="download" Size="14" Class="size-3.5" />
                                        Download
                                    </DropdownMenuItemCn>
                                    <DropdownMenuItemCn Class="gap-2 text-xs">
                                        <LucideIconCn Name="share" Size="14" Class="size-3.5" />
                                        Share
                                    </DropdownMenuItemCn>
                                    <DropdownMenuSeparatorCn />
                                    <DropdownMenuItemCn Variant="destructive" Class="gap-2 text-xs">
                                        <LucideIconCn Name="trash-2" Size="14" Class="size-3.5" />
                                        Delete
                                    </DropdownMenuItemCn>
                                </DropdownMenuContentCn>
                            </DropdownMenuCn>
                        </div>
                    </div>
                }
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-3">
            <p class="text-muted-foreground text-xs">
                @(_files.Count(f => f.Type == "folder")) folders, @(_files.Count(f => f.Type != "folder")) files
            </p>
        </div>
    </div>
</section>

@code {
    private record FileItem(string Id, string Name, string Type, string Size, string Modified);

    private static readonly FileItem[] _files =
    [
        new("f1",  "Brand Assets",           "folder",      "148 MB",  "Mar 22, 2026"),
        new("f2",  "Product Screenshots",    "folder",      "67 MB",   "Mar 21, 2026"),
        new("f3",  "Q4 Financial Report.pdf","pdf",         "2.4 MB",  "Mar 20, 2026"),
        new("f4",  "Dashboard Mockup.png",   "image",       "4.1 MB",  "Mar 19, 2026"),
        new("f5",  "Revenue Forecast.xlsx",  "spreadsheet", "890 KB",  "Mar 18, 2026"),
        new("f6",  "Homepage Hero.png",      "image",       "3.6 MB",  "Mar 17, 2026"),
        new("f7",  "API Documentation.pdf",  "pdf",         "1.8 MB",  "Mar 16, 2026"),
        new("f8",  "Team Roster.xlsx",       "spreadsheet", "340 KB",  "Mar 15, 2026"),
        new("f9",  "Onboarding Guide.docx",  "document",    "520 KB",  "Mar 14, 2026"),
        new("f10", "Release Notes v3.2.pdf", "pdf",         "180 KB",  "Mar 13, 2026"),
        new("f11", "Icon Set Export.png",    "image",       "1.2 MB",  "Mar 12, 2026"),
        new("f12", "Expense Report.xlsx",    "spreadsheet", "445 KB",  "Mar 11, 2026"),
    ];

    private string _view = "grid";
    private HashSet<string> _selected = [];

    private void ToggleSelect(string id)
    {
        if (!_selected.Add(id))
            _selected.Remove(id);
    }

    private void ClearSelection() => _selected.Clear();

    private RenderFragment TypeIcon(string type, bool large) => type switch
    {
        "folder"      => large
                           ? @<LucideIconCn Name="folder"           Size="32" Class="size-8 text-muted-foreground" />
                           : @<LucideIconCn Name="folder"           Size="16" Class="size-4 text-muted-foreground" />,
        "pdf"         => large
                           ? @<LucideIconCn Name="file-text"        Size="32" Class="size-8 text-muted-foreground" />
                           : @<LucideIconCn Name="file-text"        Size="16" Class="size-4 text-muted-foreground" />,
        "image"       => large
                           ? @<LucideIconCn Name="image"            Size="32" Class="size-8 text-muted-foreground" />
                           : @<LucideIconCn Name="image"            Size="16" Class="size-4 text-muted-foreground" />,
        "spreadsheet" => large
                           ? @<LucideIconCn Name="file-spreadsheet" Size="32" Class="size-8 text-muted-foreground" />
                           : @<LucideIconCn Name="file-spreadsheet" Size="16" Class="size-4 text-muted-foreground" />,
        _             => large
                           ? @<LucideIconCn Name="file"             Size="32" Class="size-8 text-muted-foreground" />
                           : @<LucideIconCn Name="file"             Size="16" Class="size-4 text-muted-foreground" />,
    };
}
