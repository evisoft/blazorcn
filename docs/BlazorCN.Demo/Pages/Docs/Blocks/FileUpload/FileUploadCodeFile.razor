@* ============================================================
   Block: file-upload-code-file
   Title: FileUploadCodeFile
   Description: A source code file upload block for React and Next.js with syntax-highlighted preview in monospace font, automatic language detection badge, line count display, file encoding info, and copy-to-clipboard using shadcn/ui Button, Badge, and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-code-file.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="file-code" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Code Files</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_files.Length files
            </BadgeCn>
            <div class="ml-auto">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="upload" Size="12" Class="size-3" />
                    Upload
                </ButtonCn>
            </div>
        </div>

        @* File tabs *@
        <div class="flex border-b">
            @for (int ti = 0; ti < _files.Length; ti++)
            {
                var tabIdx = ti;
                var tabFile = _files[tabIdx];
                var isActive = _activeFile == tabIdx;
                <button
                    type="button"
                    @onclick="@(() => SelectFile(tabIdx))"
                    class="@Cn.Merge("px-4 py-2.5 font-mono text-xs transition-colors", isActive ? "border-b-2 border-foreground font-medium text-foreground" : "text-muted-foreground hover:text-foreground")">
                    @tabFile.Name
                </button>
            }
        </div>

        @* File metadata *@
        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_currentFile.Language
            </BadgeCn>
            <span class="text-muted-foreground text-xs">@_currentFile.Lines lines</span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">@_currentFile.Size</span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">@_currentFile.Encoding</span>
            <div class="ml-auto">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs" OnClick="CopyContent">
                    @if (_copied)
                    {
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                        <span>Copied</span>
                    }
                    else
                    {
                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                        <span>Copy</span>
                    }
                </ButtonCn>
            </div>
        </div>

        @* Code preview *@
        <div class="overflow-x-auto rounded-b-lg bg-zinc-950 p-3">
            <pre class="text-sm leading-relaxed"><code>@for (int li = 0; li < _contentLines.Length; li++)
            {
                var lineText = _contentLines[li];
                var lineNum = li + 1;
                <div class="flex">
                    <span class="mr-4 inline-block w-6 shrink-0 text-right text-zinc-600 tabular-nums select-none">@lineNum</span>
                    <span class="text-zinc-200">@(string.IsNullOrEmpty(lineText) ? " " : lineText)</span>
                </div>
            }</code></pre>
        </div>
    </div>
</section>

@code {
    private record CodeFile(string Name, string Language, string Encoding, string Size, int Lines, string Content);

    private static readonly CodeFile[] _files =
    [
        new(
            "middleware.ts",
            "TypeScript",
            "UTF-8",
            "1.2 KB",
            34,
            "import { NextResponse } from \"next/server\"\n" +
            "import type { NextRequest } from \"next/server\"\n" +
            "\n" +
            "const protectedRoutes = [\"/dashboard\", \"/settings\", \"/api/private\"]\n" +
            "const publicRoutes = [\"/login\", \"/signup\", \"/forgot-password\"]\n" +
            "\n" +
            "export function middleware(request: NextRequest) {\n" +
            "  const { pathname } = request.nextUrl\n" +
            "  const sessionToken = request.cookies.get(\"session\")?.value\n" +
            "\n" +
            "  const isProtected = protectedRoutes.some(r => pathname.startsWith(r))\n" +
            "  const isPublic = publicRoutes.some(r => pathname.startsWith(r))\n" +
            "\n" +
            "  if (isProtected && !sessionToken) {\n" +
            "    const loginUrl = new URL(\"/login\", request.url)\n" +
            "    loginUrl.searchParams.set(\"redirect\", pathname)\n" +
            "    return NextResponse.redirect(loginUrl)\n" +
            "  }\n" +
            "\n" +
            "  if (isPublic && sessionToken) {\n" +
            "    return NextResponse.redirect(new URL(\"/dashboard\", request.url))\n" +
            "  }\n" +
            "\n" +
            "  const response = NextResponse.next()\n" +
            "  response.headers.set(\"X-Frame-Options\", \"DENY\")\n" +
            "  response.headers.set(\"X-Content-Type-Options\", \"nosniff\")\n" +
            "  return response\n" +
            "}\n" +
            "\n" +
            "export const config = {\n" +
            "  matcher: [\"/((?!_next/static|_next/image|favicon.ico).*)\"],\n" +
            "}"
        ),
        new(
            "docker-compose.yml",
            "YAML",
            "UTF-8",
            "842 B",
            28,
            "version: \"3.9\"\n" +
            "\n" +
            "services:\n" +
            "  app:\n" +
            "    build:\n" +
            "      context: .\n" +
            "      dockerfile: Dockerfile\n" +
            "    ports:\n" +
            "      - \"3000:3000\"\n" +
            "    environment:\n" +
            "      DATABASE_URL: postgres://user:pass@db:5432/myapp\n" +
            "      REDIS_URL: redis://cache:6379\n" +
            "    depends_on:\n" +
            "      - db\n" +
            "      - cache\n" +
            "\n" +
            "  db:\n" +
            "    image: postgres:16-alpine\n" +
            "    volumes:\n" +
            "      - pgdata:/var/lib/postgresql/data\n" +
            "    environment:\n" +
            "      POSTGRES_DB: myapp\n" +
            "      POSTGRES_USER: user\n" +
            "      POSTGRES_PASSWORD: pass\n" +
            "\n" +
            "  cache:\n" +
            "    image: redis:7-alpine\n" +
            "\n" +
            "volumes:\n" +
            "  pgdata:"
        ),
    ];

    private int _activeFile = 0;
    private bool _copied = false;

    private CodeFile _currentFile => _files[_activeFile];
    private string[] _contentLines => _currentFile.Content.Split('\n');

    private void SelectFile(int index)
    {
        _activeFile = index;
        _copied = false;
    }

    private async Task CopyContent()
    {
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }
}
