@* ============================================================
   Block: file-upload-multi-step
   Title: FileUploadMultiStep
   Description: Multi-step file upload wizard block for React and Next.js with file selection, configuration options, upload progress, and confirmation steps using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-multi-step.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Progress indicator *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                @for (int i = 0; i < _steps.Length; i++)
                {
                    var stepIndex = i;
                    var stepLabel = _steps[i];
                    <div class="flex items-center gap-2">
                        <div class="@Cn.Merge("flex size-5 items-center justify-center rounded-full text-[10px] font-medium",
                            stepIndex < _currentStep ? "bg-foreground text-background" :
                            stepIndex == _currentStep ? "border border-foreground text-foreground" :
                            "border border-muted-foreground/30 text-muted-foreground/50")">
                            @if (stepIndex < _currentStep)
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3" />
                            }
                            else
                            {
                                @(stepIndex + 1)
                            }
                        </div>
                        <span class="@Cn.Merge("hidden text-xs sm:inline", stepIndex <= _currentStep ? "font-medium" : "text-muted-foreground")">
                            @stepLabel
                        </span>
                        @if (stepIndex < _steps.Length - 1)
                        {
                            <div class="@Cn.Merge("mx-2 hidden h-px w-8 sm:block", stepIndex < _currentStep ? "bg-foreground" : "bg-muted-foreground/20")" />
                        }
                    </div>
                }
            </div>
        </div>

        @* Step 1: Select files *@
        @if (_currentStep == 0)
        {
            <div class="border-b px-4 py-4">
                <div
                    role="button"
                    tabindex="0"
                    class="@Cn.Merge("flex cursor-pointer flex-col items-center justify-center gap-2 rounded-md border-2 border-dashed px-6 py-8 transition-colors",
                        _isDragging ? "border-foreground/30 bg-muted/50" : "border-muted-foreground/20 hover:border-muted-foreground/40 hover:bg-muted/30")">
                    <LucideIconCn Name="cloud-upload" Size="24" Class="size-6 text-muted-foreground/60" />
                    <div class="text-center">
                        <span class="font-medium text-sm">Drop files here</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">or click to browse</p>
                    </div>
                </div>
            </div>

            @if (_files.Count > 0)
            {
                <div class="border-b">
                    <div class="border-b px-4 py-2">
                        <span class="text-muted-foreground text-xs">
                            @_files.Count @(_files.Count == 1 ? "file" : "files") selected
                        </span>
                    </div>
                    @for (int i = 0; i < _files.Count; i++)
                    {
                        var file = _files[i];
                        var fileId = file.Id;
                        var isLast = i == _files.Count - 1;
                        <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                            <LucideIconCn Name="file" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <span class="block truncate font-medium text-sm">@file.Name</span>
                                <span class="text-muted-foreground text-xs">@file.Size</span>
                            </div>
                            <ButtonCn
                                Variant="ButtonVariant.Ghost"
                                Size="ButtonSize.Sm"
                                Class="size-6 shrink-0 p-0 text-muted-foreground hover:text-foreground"
                                OnClick="@((MouseEventArgs e) => RemoveFile(fileId))">
                                <LucideIconCn Name="x" Size="12" Class="size-3" />
                            </ButtonCn>
                        </div>
                    }
                </div>
            }

            <div class="flex items-center justify-end px-4 py-3">
                <ButtonCn
                    Size="ButtonSize.Sm"
                    Class="h-7 text-xs"
                    Disabled="@(_files.Count == 0)"
                    OnClick="@((MouseEventArgs e) => _currentStep = 1)">
                    Next
                </ButtonCn>
            </div>
        }

        @* Step 2: Configure *@
        @if (_currentStep == 1)
        {
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="settings" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-sm">Processing options</span>
                </div>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Configure how your @_files.Count @(_files.Count == 1 ? "file" : "files") will be processed
                </p>
            </div>

            <div class="border-b">
                @for (int i = 0; i < _options.Count; i++)
                {
                    var opt = _options[i];
                    var optId = opt.Id;
                    var isLast = i == _options.Count - 1;
                    <span
                        role="button"
                        tabindex="0"
                        @onclick="@(() => ToggleOption(optId))"
                        class="@Cn.Merge("flex cursor-pointer items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                        <div
                            role="checkbox"
                            aria-checked="@opt.Enabled.ToString().ToLower()"
                            tabindex="-1"
                            class="@Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded border transition-colors",
                                opt.Enabled ? "border-foreground bg-foreground" : "border-muted-foreground/30")">
                            @if (opt.Enabled)
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3 text-background" />
                            }
                        </div>
                        <div class="flex-1">
                            <span class="font-medium text-sm">@opt.Label</span>
                            <p class="text-muted-foreground text-xs">@opt.Description</p>
                        </div>
                    </span>
                }
            </div>

            <div class="flex items-center justify-between px-4 py-3">
                <ButtonCn
                    Variant="ButtonVariant.Outline"
                    Size="ButtonSize.Sm"
                    Class="h-7 text-xs"
                    OnClick="@((MouseEventArgs e) => _currentStep = 0)">
                    Back
                </ButtonCn>
                <ButtonCn
                    Size="ButtonSize.Sm"
                    Class="h-7 text-xs"
                    OnClick="@((MouseEventArgs e) => StartUpload())">
                    Start upload
                </ButtonCn>
            </div>
        }

        @* Step 3: Upload progress *@
        @if (_currentStep == 2)
        {
            <div class="px-4 py-8">
                <div class="flex flex-col items-center gap-3">
                    <LucideIconCn Name="cloud-upload" Size="32" Class="size-8 animate-pulse text-muted-foreground" />
                    <div class="text-center">
                        <span class="font-medium text-sm">Uploading files</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Processing @_files.Count @(_files.Count == 1 ? "file" : "files")...
                        </p>
                    </div>
                    <div class="mt-2 w-full max-w-xs">
                        <ProgressCn Value="@_uploadProgress" Class="h-1.5" />
                    </div>
                    <span class="font-semibold text-sm tabular-nums">@_uploadProgress%</span>
                </div>
            </div>
        }

        @* Step 4: Complete *@
        @if (_currentStep == 3)
        {
            <div class="px-4 py-8">
                <div class="flex flex-col items-center gap-3">
                    <LucideIconCn Name="check-circle-2" Size="32" Class="size-8 text-emerald-600 dark:text-emerald-400" />
                    <div class="text-center">
                        <span class="font-medium text-sm">Upload complete</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            @_files.Count @(_files.Count == 1 ? "file has" : "files have") been uploaded and processed
                        </p>
                    </div>
                </div>
            </div>

            <div class="border-t">
                @for (int i = 0; i < _files.Count; i++)
                {
                    var file = _files[i];
                    var isLast = i == _files.Count - 1;
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                        <LucideIconCn Name="image" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <span class="min-w-0 flex-1 truncate font-medium text-sm">@file.Name</span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px]">
                            @file.Size
                        </BadgeCn>
                        <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 shrink-0 text-emerald-500" />
                    </div>
                }
            </div>

            <div class="flex items-center justify-end border-t px-4 py-3">
                <ButtonCn
                    Size="ButtonSize.Sm"
                    Variant="ButtonVariant.Outline"
                    Class="h-7 text-xs"
                    OnClick="@((MouseEventArgs e) => HandleReset())">
                    Upload more files
                </ButtonCn>
            </div>
        }
    </div>
</section>

@code {
    private record SelectedFile(string Id, string Name, string Size, string Type);

    private record ConfigOption(string Id, string Label, string Description, bool Enabled)
    {
        public bool Enabled { get; set; } = Enabled;
    }

    private static readonly string[] _steps = ["Select files", "Configure", "Upload", "Complete"];

    private int _currentStep = 0;
    private List<SelectedFile> _files = [];
    private List<ConfigOption> _options = BuildDefaultOptions();
    private int _uploadProgress = 0;
    private bool _isDragging = false;

    private static List<ConfigOption> BuildDefaultOptions() =>
    [
        new("resize",   "Resize images",   "Scale to max 2048px on longest side",          true),
        new("compress", "Compress files",  "Reduce file size with lossy compression",       true),
        new("rename",   "Auto-rename",     "Use slugified filenames with timestamps",       false),
        new("strip",    "Strip metadata",  "Remove EXIF and GPS data from images",          true),
    ];

    private void RemoveFile(string id)
    {
        _files = _files.Where(f => f.Id != id).ToList();
    }

    private void ToggleOption(string id)
    {
        var opt = _options.FirstOrDefault(o => o.Id == id);
        if (opt != null) opt.Enabled = !opt.Enabled;
    }

    private async Task StartUpload()
    {
        _currentStep = 2;
        _uploadProgress = 0;
        int current = 0;
        while (current < 100)
        {
            await Task.Delay(200);
            current += 5 + current / 15;
            if (current >= 100) current = 100;
            _uploadProgress = current;
            StateHasChanged();
        }
        await Task.Delay(400);
        _currentStep = 3;
    }

    private void HandleReset()
    {
        _currentStep = 0;
        _files = [];
        _options = BuildDefaultOptions();
        _uploadProgress = 0;
    }
}
