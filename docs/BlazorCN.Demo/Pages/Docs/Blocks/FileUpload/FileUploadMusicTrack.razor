@* ============================================================
   Block: file-upload-music-track
   Title: FileUploadMusicTrack
   Description: A music track upload block for React and Next.js with audio file upload, track metadata including title, artist, album, genre selector, BPM input, key selector, cover art upload placeholder, and ISRC code field using shadcn/ui Button, Badge, Input, Select, and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-music-track.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="music" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Upload track</span>
            @if (_track != null)
            {
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono font-normal text-xs">
                    @_track.Format
                </BadgeCn>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_track.Duration
                </BadgeCn>
            }
        </div>

        @* Audio upload *@
        <div class="border-b px-4 py-3">
            @if (_track != null)
            {
                <div class="flex items-center gap-3 rounded-md bg-muted/50 p-3">
                    <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-background">
                        <LucideIconCn Name="file-audio" Size="16" Class="size-4 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="truncate font-medium text-sm">@_track.Name</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            @_track.Format &middot; @_track.Size &middot; @_track.SampleRate
                        </p>
                    </div>
                    <ButtonCn
                        Variant="ButtonVariant.Ghost"
                        Size="ButtonSize.Sm"
                        Class="size-7 shrink-0 p-0 text-muted-foreground hover:text-foreground"
                        aria-label="@($"Remove {_track.Name}")"
                        OnClick="@(() => _track = null)">
                        <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                    </ButtonCn>
                </div>
            }
            else
            {
                <div
                    @ondragover:preventDefault
                    @ondragover="@(() => _isDragOver = true)"
                    @ondragleave="@(() => _isDragOver = false)"
                    @ondrop:preventDefault
                    @ondrop="@(() => _isDragOver = false)"
                    class="@Cn.Merge("flex flex-col items-center justify-center gap-2 rounded-md border border-dashed px-4 py-8 transition-colors", _isDragOver ? "border-foreground/30 bg-muted/50" : "border-muted-foreground/25")">
                    <LucideIconCn Name="upload-cloud" Size="20" Class="size-5 text-muted-foreground/60" />
                    <div class="text-center">
                        <p class="font-medium text-sm">Drop audio file here</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            WAV, FLAC, AIFF &middot; 44.1 kHz minimum
                        </p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-1 h-7 text-xs">
                        Choose file
                    </ButtonCn>
                </div>
            }
        </div>

        @* Track metadata *@
        <div class="border-b px-4 py-3">
            <div class="grid gap-3">
                <div>
                    <p class="mb-1.5 font-medium text-muted-foreground text-xs">Track title</p>
                    <InputCn
                        aria-label="Track title"
                        @bind-Value="_title"
                        Placeholder="Enter track title..."
                        Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <p class="mb-1.5 font-medium text-muted-foreground text-xs">Artist</p>
                        <InputCn
                            aria-label="Artist"
                            @bind-Value="_artist"
                            Placeholder="Artist name..."
                            Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
                    </div>
                    <div>
                        <p class="mb-1.5 font-medium text-muted-foreground text-xs">Album</p>
                        <InputCn
                            aria-label="Album"
                            @bind-Value="_album"
                            Placeholder="Album name..."
                            Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
                    </div>
                </div>
            </div>
        </div>

        @* Genre, BPM, Key *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-3 gap-3">
                <div>
                    <p class="mb-1.5 font-medium text-muted-foreground text-xs">Genre</p>
                    <SelectCn @bind-Value="_genre">
                        <SelectTriggerCn Class="h-8 text-xs" aria-label="Genre">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var g in _genres)
                            {
                                <SelectItemCn Value="@g">@g</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div>
                    <p class="mb-1.5 font-medium text-muted-foreground text-xs">BPM</p>
                    <InputCn
                        aria-label="BPM"
                        @bind-Value="_bpm"
                        Placeholder="120"
                        Class="h-8 font-mono text-xs" />
                </div>
                <div>
                    <p class="mb-1.5 font-medium text-muted-foreground text-xs">Key</p>
                    <SelectCn @bind-Value="_musicalKey">
                        <SelectTriggerCn Class="h-8 text-xs" aria-label="Musical key">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var k in _musicalKeys)
                            {
                                <SelectItemCn Value="@k">@k</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>
        </div>

        @* Cover art + ISRC *@
        <div class="border-b px-4 py-3">
            <div class="flex gap-4">
                @* Cover art *@
                <div class="shrink-0">
                    <p class="mb-1.5 font-medium text-muted-foreground text-xs">Cover art</p>
                    @if (_hasCoverArt)
                    {
                        <div class="group relative">
                            <div class="flex size-24 items-center justify-center rounded-md border bg-muted/50">
                                <div class="flex flex-col items-center gap-1">
                                    <LucideIconCn Name="disc" Size="24" Class="size-6 text-muted-foreground/40" />
                                    <span class="text-muted-foreground text-[10px]">3000 x 3000</span>
                                </div>
                            </div>
                            <button
                                type="button"
                                @onclick="@(() => _hasCoverArt = false)"
                                aria-label="Remove cover art"
                                class="absolute -top-1.5 -right-1.5 flex size-5 items-center justify-center rounded-full border bg-card text-muted-foreground transition-colors hover:text-foreground">
                                <LucideIconCn Name="x" Size="12" Class="size-3" />
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="flex size-24 cursor-pointer items-center justify-center rounded-md border border-dashed bg-muted/30 transition-colors hover:bg-muted/50">
                            <div class="flex flex-col items-center gap-1">
                                <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/60" />
                                <span class="text-muted-foreground text-[10px]">Upload</span>
                            </div>
                        </div>
                    }
                </div>

                @* ISRC *@
                <div class="flex-1">
                    <p class="mb-1.5 font-medium text-muted-foreground text-xs">ISRC code</p>
                    <InputCn
                        aria-label="ISRC code"
                        @bind-Value="_isrc"
                        Placeholder="@("e.g. USRC17607839")"
                        Class="h-8 font-mono text-xs" />
                    <p class="mt-1.5 text-muted-foreground text-[10px]">
                        International Standard Recording Code for distribution tracking
                    </p>
                    <div class="mt-3 rounded-md bg-muted/50 p-2">
                        <div class="grid grid-cols-2 gap-x-4 gap-y-1 text-[10px]">
                            <div class="flex items-center justify-between">
                                <span class="text-muted-foreground">Country</span>
                                <span class="font-mono">US</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-muted-foreground">Registrant</span>
                                <span class="font-mono">AT2</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-muted-foreground">Year</span>
                                <span class="font-mono">19</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-muted-foreground">Designation</span>
                                <span class="font-mono">02345</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3">
            <p class="text-muted-foreground text-xs">
                Lossless audio required &middot; Min 3000 x 3000 cover art
            </p>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Save draft
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="upload" Size="12" Class="size-3" />
                    Submit track
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record TrackFile(string Name, string Size, string Format, string Duration, string SampleRate);

    private static readonly TrackFile _uploadedTrack = new(
        "midnight-drive-master.wav",
        "48.2 MB",
        "WAV",
        "3:47",
        "44.1 kHz / 24-bit");

    private static readonly string[] _genres =
    [
        "Electronic", "Pop", "Hip-Hop", "R&B", "Rock",
        "Indie", "Jazz", "Classical", "Folk", "Metal",
    ];

    private static readonly string[] _musicalKeys =
    [
        "C Major", "C Minor", "C# Major", "C# Minor",
        "D Major", "D Minor", "Eb Major", "Eb Minor",
        "E Major", "E Minor", "F Major", "F Minor",
        "F# Major", "F# Minor", "G Major", "G Minor",
        "Ab Major", "Ab Minor", "A Major", "A Minor",
        "Bb Major", "Bb Minor", "B Major", "B Minor",
    ];

    private TrackFile? _track = _uploadedTrack;
    private string _title = "Midnight Drive";
    private string _artist = "Lunar Echo";
    private string _album = "Neon Horizons";
    private string _genre = "Electronic";
    private string _bpm = "124";
    private string _musicalKey = "A Minor";
    private string _isrc = "USAT21902345";
    private bool _hasCoverArt = true;
    private bool _isDragOver = false;
}
