@* ============================================================
   Block: file-upload-comparison
   Title: FileUploadComparison
   Description: Before and after file comparison upload block for React and Next.js with side-by-side upload zones, metadata diff, and format analysis using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-comparison.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">File comparison</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Upload two files to compare metadata and properties
                </p>
            </div>
            @if (_sizeReduction is not null)
            {
                <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
                    @if (_sizeReduced)
                    {
                        <LucideIconCn Name="arrow-down" Size="12" Class="size-3 text-emerald-500" />
                    }
                    else
                    {
                        <LucideIconCn Name="arrow-up" Size="12" Class="size-3 text-red-500" />
                    }
                    @(_sizeReduced
                        ? $"{_sizeReduction}% smaller"
                        : $"{Math.Abs(double.Parse(_sizeReduction))}% larger")
                </BadgeCn>
            }
        </div>

        @* Side-by-side upload zones *@
        <div class="grid grid-cols-2 divide-x border-b">
            @* Before *@
            <div class="px-4 py-4">
                <span class="mb-2 block font-medium text-muted-foreground text-xs">Before</span>
                @if (_before is not null)
                {
                    <div class="rounded-md bg-muted/50 p-3">
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="image" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <span class="block truncate font-medium text-sm">@_before.Name</span>
                                <span class="text-muted-foreground text-xs">@_before.Size</span>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 shrink-0 px-1.5 text-muted-foreground hover:text-foreground" aria-label="@($"Remove {_before.Name}")" OnClick="ClearBefore">
                                <LucideIconCn Name="x" Size="12" Class="size-3" />
                            </ButtonCn>
                        </div>
                    </div>
                }
                else
                {
                    <div
                        role="button"
                        tabindex="0"
                        @onclick="SetBefore"
                        class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-md border-2 border-dashed border-muted-foreground/20 px-4 py-8 transition-colors hover:border-muted-foreground/40 hover:bg-muted/30">
                        <LucideIconCn Name="cloud-upload" Size="24" Class="size-6 text-muted-foreground/60" />
                        <span class="text-muted-foreground text-xs">Upload original file</span>
                    </div>
                }
            </div>

            @* After *@
            <div class="px-4 py-4">
                <span class="mb-2 block font-medium text-muted-foreground text-xs">After</span>
                @if (_after is not null)
                {
                    <div class="rounded-md bg-muted/50 p-3">
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="image" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <span class="block truncate font-medium text-sm">@_after.Name</span>
                                <span class="text-muted-foreground text-xs">@_after.Size</span>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 shrink-0 px-1.5 text-muted-foreground hover:text-foreground" aria-label="@($"Remove {_after.Name}")" OnClick="ClearAfter">
                                <LucideIconCn Name="x" Size="12" Class="size-3" />
                            </ButtonCn>
                        </div>
                    </div>
                }
                else
                {
                    <div
                        role="button"
                        tabindex="0"
                        @onclick="SetAfter"
                        class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-md border-2 border-dashed border-muted-foreground/20 px-4 py-8 transition-colors hover:border-muted-foreground/40 hover:bg-muted/30">
                        <LucideIconCn Name="cloud-upload" Size="24" Class="size-6 text-muted-foreground/60" />
                        <span class="text-muted-foreground text-xs">Upload modified file</span>
                    </div>
                }
            </div>
        </div>

        @* Metadata comparison table *@
        @if (_before is not null && _after is not null)
        {
            <div>
                <div class="border-b px-4 py-2">
                    <span class="text-muted-foreground text-xs">Metadata comparison</span>
                </div>
                @for (int i = 0; i < _metadataRows.Length; i++)
                {
                    var idx = i;
                    var row = _metadataRows[i];
                    var isDifferent = row.Before != row.After;
                    <div class="@Cn.Merge("grid grid-cols-3 items-center px-4 py-2", idx < _metadataRows.Length - 1 ? "border-b" : "", isDifferent ? "bg-muted/30" : "")">
                        <span class="font-medium text-muted-foreground text-xs">@row.Label</span>
                        <span class="@Cn.Merge("font-mono text-xs", isDifferent ? "text-foreground" : "text-muted-foreground")">
                            @row.Before
                        </span>
                        <span class="@Cn.Merge("font-mono text-xs", isDifferent ? "text-foreground" : "text-muted-foreground")">
                            @row.After
                            @if (isDifferent)
                            {
                                <span class="ml-1.5 inline-flex size-1.5 rounded-full bg-amber-500"></span>
                            }
                        </span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="px-4 py-8 text-center">
                <span class="text-muted-foreground text-xs">
                    Upload both files to see comparison
                </span>
            </div>
        }
    </div>
</section>

@code {
    private record FileInfo(
        string Name,
        string Size,
        int SizeBytes,
        string Format,
        string Dimensions,
        string ColorSpace,
        string LastModified
    );

    private record MetadataRow(string Label, string Before, string After);

    private static readonly FileInfo BeforeFile = new(
        Name: "homepage-hero.png",
        Size: "4.2 MB",
        SizeBytes: 4404019,
        Format: "PNG",
        Dimensions: "2880 x 1620",
        ColorSpace: "sRGB",
        LastModified: "Mar 12, 2026"
    );

    private static readonly FileInfo AfterFile = new(
        Name: "homepage-hero.webp",
        Size: "1.1 MB",
        SizeBytes: 1153434,
        Format: "WebP",
        Dimensions: "2880 x 1620",
        ColorSpace: "sRGB",
        LastModified: "Mar 18, 2026"
    );

    private FileInfo? _before = BeforeFile;
    private FileInfo? _after = AfterFile;

    private MetadataRow[] _metadataRows => _before is not null && _after is not null
        ? [
            new MetadataRow("Format", _before.Format, _after.Format),
            new MetadataRow("Dimensions", _before.Dimensions, _after.Dimensions),
            new MetadataRow("File size", _before.Size, _after.Size),
            new MetadataRow("Color space", _before.ColorSpace, _after.ColorSpace),
            new MetadataRow("Last modified", _before.LastModified, _after.LastModified),
          ]
        : [];

    private string? _sizeReduction => _before is not null && _after is not null
        ? ((_before.SizeBytes - _after.SizeBytes) / (double)_before.SizeBytes * 100.0).ToString("F1")
        : null;

    private bool _sizeReduced => _before is not null && _after is not null && _after.SizeBytes < _before.SizeBytes;

    private void ClearBefore() => _before = null;
    private void ClearAfter() => _after = null;
    private void SetBefore() => _before = BeforeFile;
    private void SetAfter() => _after = AfterFile;
}
