@* ============================================================
   Block: file-upload-signed-document
   Title: FileUploadSignedDocument
   Description: A React e-signature document upload block with multi-step workflow for uploading contracts, reviewing status, signing, and downloading signed copies using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-signed-document.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">E-Signature</p>
                <p class="text-muted-foreground text-xs">Contract signing workflow</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Step @(_stepIndex + 1) of @(_steps.Length)
            </BadgeCn>
        </div>

        @* Progress steps *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-1">
                @for (int i = 0; i < _steps.Length; i++)
                {
                    var idx = i;
                    var step = _steps[i];
                    var isActive = idx == _stepIndex;
                    var isDone = idx < _stepIndex;
                    <div class="flex flex-1 items-center gap-1">
                        <button
                            type="button"
                            @onclick="@(() => _currentStep = step.Key)"
                            class="@Cn.Merge("flex items-center gap-1.5 rounded-md px-2 py-1 text-xs transition-colors",
                                isActive ? "bg-muted font-medium text-foreground" :
                                isDone ? "text-muted-foreground hover:text-foreground" :
                                "text-muted-foreground/50")">
                            @if (isDone)
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                            }
                            else
                            {
                                <span class="@Cn.Merge("flex size-4 items-center justify-center rounded-full text-[10px]",
                                    isActive ? "bg-foreground text-background" : "bg-muted text-muted-foreground")">
                                    @(idx + 1)
                                </span>
                            }
                            @step.Label
                        </button>
                        @if (idx < _steps.Length - 1)
                        {
                            <LucideIconCn Name="chevron-right" Size="12" Class="size-3 shrink-0 text-muted-foreground/30" />
                        }
                    </div>
                }
            </div>
            <ProgressCn Value="@_progressPercent" Class="mt-3 h-1" />
        </div>

        @* Document info *@
        <div class="flex items-start gap-3 border-b px-4 py-3">
            <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                <LucideIconCn Name="file-text" Size="20" Class="size-5 text-muted-foreground" />
            </div>
            <div class="min-w-0 flex-1">
                <p class="truncate font-medium text-sm">@_doc.Name</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_doc.Size · @_doc.Pages pages · Uploaded @_doc.UploadedAt
                </p>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                <LucideIconCn Name="download" Size="12" Class="size-3" />
                PDF
            </ButtonCn>
        </div>

        @* Signers *@
        <div class="border-b">
            <div class="px-4 py-2">
                <p class="font-medium text-muted-foreground text-xs">Signers</p>
            </div>
            @for (int i = 0; i < _signers.Length; i++)
            {
                var signer = _signers[i];
                var isLast = i == _signers.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <span class="@Cn.Merge("size-2 shrink-0 rounded-full", StatusDotClass(signer.Status))" />
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@signer.Name</span>
                            <span class="text-muted-foreground text-xs">(@signer.Role)</span>
                        </div>
                        <p class="text-muted-foreground text-xs">
                            @(signer.Status == "signed" ? signer.SignedAt : signer.Email)
                        </p>
                    </div>
                    <span class="text-muted-foreground text-xs">@StatusLabel(signer.Status)</span>
                </div>
            }
        </div>

        @* Action area *@
        <div class="px-4 py-4">
            @if (_currentStep == "upload")
            {
                <div class="flex flex-col items-center gap-3 rounded-md border border-dashed bg-muted/30 py-8">
                    <LucideIconCn Name="upload" Size="24" Class="size-6 text-muted-foreground/60" />
                    <div class="text-center">
                        <p class="font-medium text-sm">Upload contract</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">PDF, DOCX up to 25 MB</p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                        Choose file
                    </ButtonCn>
                </div>
            }

            @if (_currentStep == "review")
            {
                <div class="space-y-3">
                    <div class="rounded-md bg-muted/50 p-3">
                        <p class="font-medium text-muted-foreground text-xs">Document preview</p>
                        <div class="mt-2 space-y-2">
                            @for (int i = 0; i < 4; i++)
                            {
                                var width = $"{85 - i * 12}%";
                                <div class="h-2 rounded bg-muted" style="@($"width:{width}")" />
                            }
                        </div>
                    </div>
                    <ButtonCn
                        Size="ButtonSize.Sm"
                        Class="h-7 w-full text-xs"
                        OnClick="@((MouseEventArgs e) => _currentStep = "sign")">
                        Continue to sign
                    </ButtonCn>
                </div>
            }

            @if (_currentStep == "sign")
            {
                <div class="space-y-3">
                    <div class="flex items-center justify-center rounded-md border border-dashed bg-muted/30 py-8">
                        <div class="flex flex-col items-center gap-2">
                            <LucideIconCn Name="pen-line" Size="20" Class="size-5 text-muted-foreground/60" />
                            <p class="text-muted-foreground text-xs">Click to draw your signature</p>
                        </div>
                    </div>
                    <div class="flex gap-2">
                        <ButtonCn
                            Variant="ButtonVariant.Outline"
                            Size="ButtonSize.Sm"
                            Class="h-7 flex-1 text-xs"
                            OnClick="@((MouseEventArgs e) => _currentStep = "review")">
                            Back
                        </ButtonCn>
                        <ButtonCn
                            Size="ButtonSize.Sm"
                            Class="h-7 flex-1 text-xs"
                            OnClick="@((MouseEventArgs e) => _currentStep = "complete")">
                            Apply signature
                        </ButtonCn>
                    </div>
                </div>
            }

            @if (_currentStep == "complete")
            {
                <div class="flex flex-col items-center gap-3 py-4">
                    <LucideIconCn Name="check-circle-2" Size="32" Class="size-8 text-emerald-500" />
                    <div class="text-center">
                        <p class="font-medium text-sm">Document signed</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            All parties have been notified
                        </p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                        <LucideIconCn Name="download" Size="12" Class="size-3" />
                        Download signed copy
                    </ButtonCn>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record StepDef(string Key, string Label);

    private record DocInfo(string Name, string Size, int Pages, string UploadedAt);

    private record Signer(string Id, string Name, string Email, string Role, string Status, string SignedAt);

    private static readonly StepDef[] _steps =
    [
        new("upload",   "Upload"),
        new("review",   "Review"),
        new("sign",     "Sign"),
        new("complete", "Complete"),
    ];

    private static readonly DocInfo _doc = new(
        "Service Agreement — Acme Corp.pdf",
        "1.2 MB",
        8,
        "Mar 22, 2026"
    );

    private static readonly Signer[] _signers =
    [
        new("1", "Sarah Chen",    "sarah@acmecorp.com", "Client", "signed", "Mar 23, 2026 at 2:14 PM"),
        new("2", "James Rivera",  "james@vendor.io",   "Vendor", "viewed", ""),
    ];

    private string _currentStep = "sign";

    private int _stepIndex => Array.FindIndex(_steps, s => s.Key == _currentStep);

    private double _progressPercent => ((_stepIndex + 1.0) / _steps.Length) * 100;

    private static string StatusDotClass(string status) => status switch
    {
        "signed"  => "bg-emerald-500",
        "viewed"  => "bg-amber-500",
        _         => "bg-muted-foreground/40",
    };

    private static string StatusLabel(string status) => status switch
    {
        "signed"  => "Signed",
        "viewed"  => "Viewed",
        _         => "Pending",
    };
}
