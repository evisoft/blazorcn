@* ============================================================
   Block: file-upload-empty-state
   Title: FileUploadEmptyState
   Description: An empty state for file managers with illustration placeholder, first-file CTA, quick action buttons for upload and import and folder creation, and getting started tips using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-empty-state.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Files</span>
            <span class="text-muted-foreground text-xs">0 items</span>
        </div>

        @* Empty state illustration and CTA *@
        <div class="flex flex-col items-center px-4 py-10">
            <div class="mb-4 flex size-16 items-center justify-center rounded-full bg-muted/50">
                <LucideIconCn Name="file" Size="28" Class="size-7 text-muted-foreground/60" />
            </div>
            <span class="font-medium text-sm">No files yet</span>
            <p class="mt-1 max-w-xs text-center text-muted-foreground text-xs">
                Upload your first file to get started. You can drag and drop files or use the button
                below.
            </p>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-4 h-8 gap-1.5 text-xs">
                <LucideIconCn Name="upload-cloud" Size="14" Class="size-3.5" />
                Upload your first file
            </ButtonCn>
        </div>

        @* Quick actions *@
        <div class="border-t px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">
                Quick actions
            </span>
            <div class="grid grid-cols-3 gap-2">
                <button
                    type="button"
                    class="flex flex-col items-center gap-1.5 rounded-md border border-transparent px-3 py-3 transition-colors hover:border-border hover:bg-muted/50">
                    <LucideIconCn Name="upload-cloud" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-xs">Upload</span>
                </button>
                <button
                    type="button"
                    class="flex flex-col items-center gap-1.5 rounded-md border border-transparent px-3 py-3 transition-colors hover:border-border hover:bg-muted/50">
                    <LucideIconCn Name="cloud" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-xs">Import from Cloud</span>
                </button>
                <button
                    type="button"
                    class="flex flex-col items-center gap-1.5 rounded-md border border-transparent px-3 py-3 transition-colors hover:border-border hover:bg-muted/50">
                    <LucideIconCn Name="folder-plus" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-xs">Create Folder</span>
                </button>
            </div>
        </div>

        @* Getting started tips *@
        <div class="border-t px-4 py-3">
            <span class="mb-2 flex items-center gap-1.5 font-medium text-muted-foreground text-xs">
                <LucideIconCn Name="lightbulb" Size="12" Class="size-3" />
                Getting started
            </span>
            <div class="space-y-1.5">
                @foreach (var tip in _tips)
                {
                    <div class="flex items-start gap-2">
                        <span class="mt-1.5 size-1 shrink-0 rounded-full bg-muted-foreground/40"></span>
                        <span class="text-muted-foreground text-xs leading-relaxed">@tip.Text</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Tip(string Id, string Text);

    private static readonly Tip[] _tips =
    [
        new("1", "Drag and drop files anywhere in the app to upload instantly"),
        new("2", "Organize files into folders to keep your workspace tidy"),
        new("3", "Share files with your team by generating a shareable link"),
    ];
}
