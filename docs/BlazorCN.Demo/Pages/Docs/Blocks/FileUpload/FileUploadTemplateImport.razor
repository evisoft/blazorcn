@* ============================================================
   Block: file-upload-template-import
   Title: FileUploadTemplateImport
   Description: Template file import block for React and Next.js with template download, upload validation, error details, re-upload support, and success count using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-template-import.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Import data</span>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Download a template, fill it in, and upload to import
            </p>
        </div>

        @* Step 1: Download template *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <span class="@Cn.Merge("flex size-5 items-center justify-center rounded-full text-xs", _step != ImportStep.Download ? "bg-muted text-muted-foreground" : "bg-foreground text-background")">
                    @if (_step != ImportStep.Download)
                    {
                        <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5" />
                    }
                    else
                    {
                        @("1")
                    }
                </span>
                <div>
                    <span class="font-medium text-sm">Download template</span>
                    <p class="text-muted-foreground text-xs">
                        CSV with required columns and example data
                    </p>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 gap-1.5 text-xs" OnClick="HandleDownloadClick">
                <LucideIconCn Name="download" Size="12" Class="size-3" />
                employee-template.csv
            </ButtonCn>
        </div>

        @* Step 2: Upload filled template *@
        <div class="@Cn.Merge("border-b px-4 py-3", _step == ImportStep.Download ? "opacity-50" : "")">
            <div class="flex items-center gap-3">
                <span class="@Cn.Merge("flex size-5 items-center justify-center rounded-full text-xs", (_step == ImportStep.Results || _step == ImportStep.Validating) ? "bg-muted text-muted-foreground" : _step == ImportStep.Upload ? "bg-foreground text-background" : "bg-muted text-muted-foreground")">
                    @if (_step == ImportStep.Results || _step == ImportStep.Validating)
                    {
                        <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5" />
                    }
                    else
                    {
                        @("2")
                    }
                </span>
                <div class="min-w-0 flex-1">
                    <span class="font-medium text-sm">Upload filled template</span>
                    @if (!string.IsNullOrEmpty(_fileName) && _step != ImportStep.Upload)
                    {
                        <p class="mt-0.5 flex items-center gap-1.5 text-muted-foreground text-xs">
                            <LucideIconCn Name="file-spreadsheet" Size="12" Class="size-3" />
                            @_fileName
                        </p>
                    }
                </div>
                @if (_step == ImportStep.Upload)
                {
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 gap-1.5 text-xs" OnClick="HandleChooseFile">
                        <LucideIconCn Name="upload" Size="12" Class="size-3" />
                        Choose file
                    </ButtonCn>
                }
            </div>
        </div>

        @* Validating state *@
        @if (_step == ImportStep.Validating)
        {
            <div class="flex items-center justify-center gap-2 px-4 py-8">
                <LucideIconCn Name="refresh-cw" Size="16" Class="size-4 animate-spin text-muted-foreground" />
                <span class="text-muted-foreground text-sm">Validating rows...</span>
            </div>
        }

        @* Step 3: Validation results *@
        @if (_step == ImportStep.Results)
        {
            @* Summary *@
            <div class="flex items-center gap-4 border-b px-4 py-3">
                <div class="flex items-center gap-3">
                    <span class="flex size-5 items-center justify-center rounded-full bg-foreground text-background text-xs">
                        3
                    </span>
                    <span class="font-medium text-sm">Validation results</span>
                </div>
                <div class="ml-auto flex items-center gap-3">
                    <span class="flex items-center gap-1.5 text-xs">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="text-muted-foreground">@_validRows valid</span>
                    </span>
                    <span class="flex items-center gap-1.5 text-xs">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        <span class="text-muted-foreground">@_sampleErrors.Length errors</span>
                    </span>
                </div>
            </div>

            @* Success count *@
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-500" />
                <div>
                    <span class="font-medium text-sm tabular-nums">
                        @_validRows of @_totalRows rows
                    </span>
                    <span class="text-muted-foreground text-sm"> ready to import</span>
                </div>
            </div>

            @* Error list *@
            @if (_sampleErrors.Length > 0)
            {
                <div>
                    <div class="border-b px-4 py-2">
                        <span class="text-muted-foreground text-xs">
                            @_sampleErrors.Length errors to fix
                        </span>
                    </div>
                    @for (int i = 0; i < _sampleErrors.Length; i++)
                    {
                        var error = _sampleErrors[i];
                        var isLast = i == _sampleErrors.Length - 1;
                        var isExpanded = _expandedError == error.Id;
                        <div class="@(isLast ? "" : "border-b")">
                            <button type="button"
                                    @onclick="@(() => ToggleError(error.Id))"
                                    class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                                <span class="size-2 shrink-0 rounded-full bg-red-500"></span>
                                <div class="min-w-0 flex-1">
                                    <span class="font-medium text-sm">Row @error.Row</span>
                                    <span class="text-muted-foreground text-sm"> @("·") </span>
                                    <span class="font-mono text-muted-foreground text-xs">
                                        @error.Field
                                    </span>
                                </div>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-mono font-normal text-xs">
                                    @error.Value
                                </BadgeCn>
                                <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                            </button>
                            @if (isExpanded)
                            {
                                <div class="px-4 pb-3 pl-9">
                                    <div class="rounded-md bg-muted/50 p-3">
                                        <p class="text-sm leading-relaxed">@error.Message</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @* Actions *@
            <div class="flex items-center gap-2 border-t px-4 py-3">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="HandleReUpload">
                    <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                    Re-upload
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    Import @_validRows rows
                </ButtonCn>
            </div>
        }
    </div>
</section>

@code {
    private enum ImportStep { Download, Upload, Validating, Results }

    private record ValidationError(string Id, int Row, string Field, string Value, string Message);

    private static readonly ValidationError[] _sampleErrors =
    [
        new("e1", 3,  "email",      "john@",           "Invalid email format. Must include a domain (e.g., john@company.com)."),
        new("e2", 7,  "phone",      "+1-555",           "Phone number is incomplete. Must be at least 10 digits including country code."),
        new("e3", 12, "department", "Mktg",             "Value does not match any valid department. Expected one of: Marketing, Engineering, Sales, Design, Operations."),
        new("e4", 15, "start_date", "13/25/2025",       "Invalid date format. Use YYYY-MM-DD (e.g., 2025-03-24)."),
        new("e5", 22, "salary",     "eighty thousand",  "Must be a numeric value without currency symbols or text (e.g., 80000)."),
    ];

    private static readonly int _totalRows = 48;
    private static readonly int _validRows = _totalRows - _sampleErrors.Length;

    private ImportStep _step = ImportStep.Download;
    private string? _expandedError = "e1";
    private string _fileName = "";

    private void HandleDownloadClick()
    {
        if (_step == ImportStep.Download)
            _step = ImportStep.Upload;
    }

    private void HandleChooseFile()
    {
        // Simulate a file being chosen
        _fileName = "employee-data.csv";
        _step = ImportStep.Validating;
        // In a real app we'd use JS interop; here we jump directly to results
        _step = ImportStep.Results;
    }

    private void HandleReUpload()
    {
        _step = ImportStep.Upload;
        _expandedError = null;
    }

    private void ToggleError(string id)
    {
        _expandedError = _expandedError == id ? null : id;
    }
}
