@* ============================================================
   Block: file-upload-folder
   Title: FileUploadFolder
   Description: A folder and directory upload component with tree structure visualization, file counts per folder, total size display, nested file lists with indentation, and folder and file icons built with React, shadcn/ui, and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-folder.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Upload folder</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Select a folder to upload its entire structure
                </p>
            </div>
            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                <span>
                    @_totalFolders folder@(_totalFolders != 1 ? "s" : "")
                </span>
                <span>·</span>
                <span>
                    @_totalFiles file@(_totalFiles != 1 ? "s" : "")
                </span>
            </div>
        </div>

        @* Drop zone *@
        <div class="border-b px-4 py-4">
            <div
                @ondragover:preventDefault="true"
                @ondragenter="@(() => _isDragOver = true)"
                @ondragleave="@(() => _isDragOver = false)"
                @ondrop="HandleDrop"
                class="@Cn.Merge("flex flex-col items-center justify-center gap-2 rounded-md border border-dashed px-4 py-6 transition-colors",
                    _isDragOver ? "border-foreground/30 bg-muted/50" : "border-muted-foreground/25")">
                <LucideIconCn Name="upload-cloud" Size="20" Class="size-5 text-muted-foreground/60" />
                <div class="text-center">
                    <p class="font-medium text-sm">Drop a folder here</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">or click to select a directory</p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-1 h-7 text-xs">
                    Choose folder
                </ButtonCn>
            </div>
        </div>

        @* Folder tree *@
        @if (_tree.Length > 0)
        {
            <div class="border-b py-1">
                @foreach (var rootFolder in _tree)
                {
                    var rf = rootFolder;
                    var rfIdx = Array.IndexOf(_tree, rf);
                    var rfFileCount = CountFilesInFolder(rf);
                    @* Root folder row *@
                    <div>
                        <button
                            type="button"
                            @onclick="@(() => ToggleFolder([rfIdx]))"
                            class="flex w-full items-center gap-2 py-1.5 text-left transition-colors hover:bg-muted/50"
                            style="@($"padding-left:{0 * 16 + 16}px;padding-right:16px")">
                            <LucideIconCn Name="chevron-right" Size="12" Class="@Cn.Merge("size-3 shrink-0 text-muted-foreground/60 transition-transform duration-200", rf.Expanded ? "rotate-90" : "")" />
                            @if (rf.Expanded)
                            {
                                <LucideIconCn Name="folder-open" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                            }
                            else
                            {
                                <LucideIconCn Name="folder" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                            }
                            <span class="flex-1 truncate font-medium text-sm">@rf.Name</span>
                            <span class="shrink-0 text-muted-foreground text-xs">
                                @rfFileCount file@(rfFileCount != 1 ? "s" : "")
                            </span>
                        </button>

                        @if (rf.Expanded)
                        {
                            @* Depth-1 sub-folders *@
                            @foreach (var d1Folder in rf.Folders)
                            {
                                var d1f = d1Folder;
                                var d1Idx = Array.IndexOf(rf.Folders, d1f);
                                var d1FileCount = CountFilesInFolder(d1f);
                                <div>
                                    <button
                                        type="button"
                                        @onclick="@(() => ToggleFolder([rfIdx, d1Idx]))"
                                        class="flex w-full items-center gap-2 py-1.5 text-left transition-colors hover:bg-muted/50"
                                        style="@($"padding-left:{1 * 16 + 16}px;padding-right:16px")">
                                        <LucideIconCn Name="chevron-right" Size="12" Class="@Cn.Merge("size-3 shrink-0 text-muted-foreground/60 transition-transform duration-200", d1f.Expanded ? "rotate-90" : "")" />
                                        @if (d1f.Expanded)
                                        {
                                            <LucideIconCn Name="folder-open" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                                        }
                                        else
                                        {
                                            <LucideIconCn Name="folder" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                                        }
                                        <span class="flex-1 truncate font-medium text-sm">@d1f.Name</span>
                                        <span class="shrink-0 text-muted-foreground text-xs">
                                            @d1FileCount file@(d1FileCount != 1 ? "s" : "")
                                        </span>
                                    </button>

                                    @if (d1f.Expanded)
                                    {
                                        @* Depth-2 sub-folders *@
                                        @foreach (var d2Folder in d1f.Folders)
                                        {
                                            var d2f = d2Folder;
                                            var d2Idx = Array.IndexOf(d1f.Folders, d2f);
                                            var d2FileCount = CountFilesInFolder(d2f);
                                            <div>
                                                <button
                                                    type="button"
                                                    @onclick="@(() => ToggleFolder([rfIdx, d1Idx, d2Idx]))"
                                                    class="flex w-full items-center gap-2 py-1.5 text-left transition-colors hover:bg-muted/50"
                                                    style="@($"padding-left:{2 * 16 + 16}px;padding-right:16px")">
                                                    <LucideIconCn Name="chevron-right" Size="12" Class="@Cn.Merge("size-3 shrink-0 text-muted-foreground/60 transition-transform duration-200", d2f.Expanded ? "rotate-90" : "")" />
                                                    @if (d2f.Expanded)
                                                    {
                                                        <LucideIconCn Name="folder-open" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                                                    }
                                                    else
                                                    {
                                                        <LucideIconCn Name="folder" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                                                    }
                                                    <span class="flex-1 truncate font-medium text-sm">@d2f.Name</span>
                                                    <span class="shrink-0 text-muted-foreground text-xs">
                                                        @d2FileCount file@(d2FileCount != 1 ? "s" : "")
                                                    </span>
                                                </button>

                                                @if (d2f.Expanded)
                                                {
                                                    @foreach (var d2File in d2f.Files)
                                                    {
                                                        <div class="flex items-center gap-2 py-1.5" style="@($"padding-left:{(2 + 1) * 16 + 16 + 12}px;padding-right:16px")">
                                                            @GetFileIcon(d2File.FileType)
                                                            <span class="flex-1 truncate text-muted-foreground text-sm">@d2File.Name</span>
                                                            <span class="shrink-0 font-mono text-muted-foreground text-xs">@d2File.Size</span>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        }

                                        @* Depth-1 files *@
                                        @foreach (var d1File in d1f.Files)
                                        {
                                            <div class="flex items-center gap-2 py-1.5" style="@($"padding-left:{(1 + 1) * 16 + 16 + 12}px;padding-right:16px")">
                                                @GetFileIcon(d1File.FileType)
                                                <span class="flex-1 truncate text-muted-foreground text-sm">@d1File.Name</span>
                                                <span class="shrink-0 font-mono text-muted-foreground text-xs">@d1File.Size</span>
                                            </div>
                                        }
                                    }
                                </div>
                            }

                            @* Root-level files *@
                            @foreach (var rfFile in rf.Files)
                            {
                                <div class="flex items-center gap-2 py-1.5" style="@($"padding-left:{(0 + 1) * 16 + 16 + 12}px;padding-right:16px")">
                                    @GetFileIcon(rfFile.FileType)
                                    <span class="flex-1 truncate text-muted-foreground text-sm">@rfFile.Name</span>
                                    <span class="shrink-0 font-mono text-muted-foreground text-xs">@rfFile.Size</span>
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        }

        @* Footer *@
        @if (_tree.Length > 0)
        {
            <div class="flex items-center justify-between px-4 py-3">
                <p class="text-muted-foreground text-xs">
                    Total: @_totalFiles files across @_totalFolders folders
                </p>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Upload folder
                </ButtonCn>
            </div>
        }

    </div>
</section>

@code {
    private enum FileType { Image, Document, Code, Other }

    private class TreeFile
    {
        public string Name { get; set; } = "";
        public string Size { get; set; } = "";
        public FileType FileType { get; set; } = FileType.Other;
    }

    private class TreeFolder
    {
        public string Name { get; set; } = "";
        public bool Expanded { get; set; }
        public TreeFile[] Files { get; set; } = [];
        public TreeFolder[] Folders { get; set; } = [];
    }

    private TreeFolder[] _tree = [];
    private bool _isDragOver = false;

    private int _totalFiles => CountFiles(_tree);
    private int _totalFolders => CountFolders(_tree);

    protected override void OnInitialized()
    {
        _tree =
        [
            new TreeFolder
            {
                Name = "src",
                Expanded = true,
                Files =
                [
                    new TreeFile { Name = "index.tsx", Size = "2.4 KB", FileType = FileType.Code },
                    new TreeFile { Name = "App.tsx",   Size = "4.1 KB", FileType = FileType.Code },
                ],
                Folders =
                [
                    new TreeFolder
                    {
                        Name = "components",
                        Expanded = true,
                        Files =
                        [
                            new TreeFile { Name = "Header.tsx",  Size = "1.8 KB", FileType = FileType.Code },
                            new TreeFile { Name = "Footer.tsx",  Size = "1.2 KB", FileType = FileType.Code },
                            new TreeFile { Name = "Sidebar.tsx", Size = "3.6 KB", FileType = FileType.Code },
                        ],
                        Folders =
                        [
                            new TreeFolder
                            {
                                Name = "ui",
                                Expanded = false,
                                Files =
                                [
                                    new TreeFile { Name = "Button.tsx", Size = "0.9 KB", FileType = FileType.Code },
                                    new TreeFile { Name = "Input.tsx",  Size = "0.7 KB", FileType = FileType.Code },
                                    new TreeFile { Name = "Dialog.tsx", Size = "2.1 KB", FileType = FileType.Code },
                                ],
                                Folders = [],
                            },
                        ],
                    },
                    new TreeFolder
                    {
                        Name = "assets",
                        Expanded = false,
                        Files =
                        [
                            new TreeFile { Name = "logo.svg",    Size = "3.2 KB",  FileType = FileType.Image },
                            new TreeFile { Name = "hero-bg.png", Size = "248 KB",  FileType = FileType.Image },
                            new TreeFile { Name = "favicon.ico", Size = "4.1 KB",  FileType = FileType.Image },
                        ],
                        Folders = [],
                    },
                ],
            },
            new TreeFolder
            {
                Name = "docs",
                Expanded = false,
                Files =
                [
                    new TreeFile { Name = "README.md",    Size = "6.8 KB",  FileType = FileType.Document },
                    new TreeFile { Name = "CHANGELOG.md", Size = "12.4 KB", FileType = FileType.Document },
                    new TreeFile { Name = "LICENSE",      Size = "1.1 KB",  FileType = FileType.Document },
                ],
                Folders = [],
            },
            new TreeFolder
            {
                Name = "public",
                Expanded = false,
                Files =
                [
                    new TreeFile { Name = "robots.txt",  Size = "0.2 KB", FileType = FileType.Other },
                    new TreeFile { Name = "sitemap.xml", Size = "1.4 KB", FileType = FileType.Other },
                ],
                Folders = [],
            },
        ];
    }

    private static int CountFiles(TreeFolder[] folders)
    {
        int count = 0;
        foreach (var folder in folders)
        {
            count += folder.Files.Length;
            count += CountFiles(folder.Folders);
        }
        return count;
    }

    private static int CountFilesInFolder(TreeFolder folder)
        => folder.Files.Length + CountFiles(folder.Folders);

    private static int CountFolders(TreeFolder[] folders)
    {
        int count = folders.Length;
        foreach (var folder in folders)
            count += CountFolders(folder.Folders);
        return count;
    }

    private RenderFragment GetFileIcon(FileType type) => type switch
    {
        FileType.Image    => @<LucideIconCn Name="image"     Size="14" Class="size-3.5 text-muted-foreground/60" />,
        FileType.Document => @<LucideIconCn Name="file-text" Size="14" Class="size-3.5 text-muted-foreground/60" />,
        _                 => @<LucideIconCn Name="file"      Size="14" Class="size-3.5 text-muted-foreground/60" />,
    };

    private void ToggleFolder(int[] path)
    {
        // Navigate to the target folder and flip its Expanded flag.
        TreeFolder[] current = _tree;
        for (int i = 0; i < path.Length - 1; i++)
            current = current[path[i]].Folders;
        var target = current[path[^1]];
        target.Expanded = !target.Expanded;
    }

    private void HandleDrop(DragEventArgs e)
    {
        _isDragOver = false;
    }
}
