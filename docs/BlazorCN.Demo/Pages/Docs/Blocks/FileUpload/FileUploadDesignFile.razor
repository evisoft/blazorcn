@* ============================================================
   Block: file-upload-design-file
   Title: FileUploadDesignFile
   Description: A design file upload block for React and Next.js supporting Figma, Sketch, and PSD files with file preview placeholder, artboard count, layer count, simulated color palette extraction with swatches, and export settings using shadcn/ui Button, Badge, Select, and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-design-file.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="file" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Design file</span>
            @if (_file != null)
            {
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_file.Format
                </BadgeCn>
            }
        </div>

        @* File upload / preview *@
        <div class="border-b px-4 py-3">
            @if (_file != null)
            {
                <div class="flex items-center gap-3 rounded-md bg-muted/50 p-3">
                    @* File preview placeholder *@
                    <div class="flex size-14 shrink-0 items-center justify-center rounded-md bg-background">
                        <div class="flex flex-col items-center gap-0.5">
                            <LucideIconCn Name="layout" Size="20" Class="size-5 text-muted-foreground/60" />
                            <span class="font-mono text-muted-foreground text-[8px]">
                                @_file.Dimensions
                            </span>
                        </div>
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="truncate font-medium text-sm">@_file.Name</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            @_file.Format &middot; @_file.Size
                        </p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 shrink-0 p-0 text-muted-foreground hover:text-foreground" OnClick="ClearFile">
                        <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                    </ButtonCn>
                </div>
            }
            else
            {
                <div
                    @ondragover:preventDefault
                    @ondragover="@(() => _isDragOver = true)"
                    @ondragleave="@(() => _isDragOver = false)"
                    @ondrop:preventDefault
                    @ondrop="@(() => _isDragOver = false)"
                    class="@Cn.Merge("flex flex-col items-center justify-center gap-2 rounded-md border border-dashed px-4 py-8 transition-colors", _isDragOver ? "border-foreground/30 bg-muted/50" : "border-muted-foreground/25")">
                    <LucideIconCn Name="upload-cloud" Size="20" Class="size-5 text-muted-foreground/60" />
                    <div class="text-center">
                        <p class="font-medium text-sm">Drop design file here</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Figma (.fig), Sketch (.sketch), Photoshop (.psd)
                        </p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-1 h-7 text-xs">
                        Choose file
                    </ButtonCn>
                </div>
            }
        </div>

        @* File stats *@
        @if (_file != null)
        {
            <div class="flex border-b">
                <div class="flex flex-1 items-center gap-2 border-r px-4 py-3">
                    <LucideIconCn Name="layout" Size="14" Class="size-3.5 text-muted-foreground" />
                    <div>
                        <p class="font-semibold text-lg tabular-nums">@_file.Artboards</p>
                        <p class="text-muted-foreground text-xs">Artboards</p>
                    </div>
                </div>
                <div class="flex flex-1 items-center gap-2 border-r px-4 py-3">
                    <LucideIconCn Name="layers" Size="14" Class="size-3.5 text-muted-foreground" />
                    <div>
                        <p class="font-semibold text-lg tabular-nums">@_file.Layers</p>
                        <p class="text-muted-foreground text-xs">Layers</p>
                    </div>
                </div>
                <div class="flex flex-1 items-center gap-2 px-4 py-3">
                    <LucideIconCn Name="palette" Size="14" Class="size-3.5 text-muted-foreground" />
                    <div>
                        <p class="font-semibold text-lg tabular-nums">@_extractedColors.Length</p>
                        <p class="text-muted-foreground text-xs">Colors</p>
                    </div>
                </div>
            </div>

            @* Color palette *@
            <div class="border-b px-4 py-3">
                <p class="mb-2 font-medium text-muted-foreground text-xs">Extracted palette</p>
                <div class="grid grid-cols-4 gap-2">
                    @foreach (var color in _extractedColors)
                    {
                        var c = color;
                        <button
                            type="button"
                            @onclick="@(() => CopyColor(c.Hex))"
                            class="group rounded-md p-2 text-left transition-colors hover:bg-muted/50">
                            <div
                                class="mb-1.5 h-8 w-full rounded-md border"
                                style="@($"background-color:{c.Hex}")" />
                            <p class="font-medium text-xs">@c.Name</p>
                            <div class="flex items-center gap-1">
                                <span class="font-mono text-muted-foreground text-[10px]">
                                    @c.Hex
                                </span>
                                @if (_copiedColor == c.Hex)
                                {
                                    <LucideIconCn Name="check" Size="10" Class="size-2.5 text-emerald-500" />
                                }
                                else
                                {
                                    <LucideIconCn Name="copy" Size="10" Class="size-2.5 text-muted-foreground/40 opacity-0 transition-opacity group-hover:opacity-100" />
                                }
                            </div>
                        </button>
                    }
                </div>
            </div>

            @* Export settings *@
            <div class="border-b px-4 py-3">
                <p class="mb-2 font-medium text-muted-foreground text-xs">Export settings</p>
                <div class="flex items-center gap-3">
                    <div class="flex-1">
                        <p class="mb-1 text-muted-foreground text-[10px]">Format</p>
                        <SelectCn @bind-Value="_exportFormat">
                            <SelectTriggerCn Class="h-8 text-xs">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="png">PNG</SelectItemCn>
                                <SelectItemCn Value="svg">SVG</SelectItemCn>
                                <SelectItemCn Value="pdf">PDF</SelectItemCn>
                                <SelectItemCn Value="webp">WebP</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                    <div class="flex-1">
                        <p class="mb-1 text-muted-foreground text-[10px]">Scale</p>
                        <SelectCn @bind-Value="_exportScale">
                            <SelectTriggerCn Class="h-8 text-xs">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="1x">1x</SelectItemCn>
                                <SelectItemCn Value="2x">2x</SelectItemCn>
                                <SelectItemCn Value="3x">3x</SelectItemCn>
                                <SelectItemCn Value="4x">4x</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                    <div class="flex items-end">
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                            <LucideIconCn Name="download" Size="12" Class="size-3" />
                            Export all
                        </ButtonCn>
                    </div>
                </div>
            </div>
        }

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3">
            <p class="text-muted-foreground text-xs">
                @(_file != null
                    ? $"{_file.Artboards} artboards ready for export"
                    : "Upload a design file to get started")
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" Disabled="@(_file == null)">
                Process file
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record DesignFile(string Name, string Size, string Format, int Artboards, int Layers, string Dimensions);
    private record ColorSwatch(string Hex, string Name, string Usage);

    private static readonly DesignFile _uploadedFile = new(
        "dashboard-redesign-v3.fig",
        "12.4 MB",
        "Figma",
        18,
        342,
        "1440 x 900"
    );

    private static readonly ColorSwatch[] _extractedColors =
    [
        new("#0A0A0A", "Foreground", "Text, icons"),
        new("#FAFAFA", "Background", "Page background"),
        new("#737373", "Muted", "Secondary text"),
        new("#2563EB", "Primary", "Buttons, links"),
        new("#DC2626", "Destructive", "Error states"),
        new("#16A34A", "Success", "Success states"),
        new("#E5E5E5", "Border", "Dividers, outlines"),
        new("#F5F5F5", "Card", "Card backgrounds"),
    ];

    private DesignFile? _file = _uploadedFile;
    private string? _copiedColor = null;
    private string _exportFormat = "png";
    private string _exportScale = "2x";
    private bool _isDragOver = false;

    private void ClearFile()
    {
        _file = null;
    }

    private async Task CopyColor(string hex)
    {
        _copiedColor = hex;
        await Task.Delay(2000);
        _copiedColor = null;
    }
}
