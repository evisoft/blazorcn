@* ============================================================
   Block: file-upload-with-progress
   Title: FileUploadWithProgress
   Description: A single file upload block with detailed progress bar, upload speed, time remaining, and file size transferred with pause and cancel controls using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-with-progress.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Upload file</span>
            @if (_status != UploadStatus.Idle)
            {
                <span class="tabular-nums text-muted-foreground text-xs">
                    @(_status == UploadStatus.Complete ? "Uploaded" : _status == UploadStatus.Paused ? "Paused" : $"{_progress}%")
                </span>
            }
        </div>

        @if (_status == UploadStatus.Idle)
        {
            @* File selection *@
            <div class="flex flex-col items-center px-4 py-10">
                <LucideIconCn Name="upload-cloud" Size="32" Class="mb-3 size-8 text-muted-foreground" />
                <span class="font-medium text-sm">Select a file to upload</span>
                <span class="mt-1 text-muted-foreground text-xs">Maximum 50 MB per file</span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-4 h-7 text-xs" @onclick="SimulateFileSelect">
                    Choose file
                </ButtonCn>
            </div>
        }
        else
        {
            @* File info *@
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted/50">
                    @if (_status == UploadStatus.Complete)
                    {
                        <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-600 dark:text-emerald-400" />
                    }
                    else
                    {
                        <LucideIconCn Name="file" Size="16" Class="size-4 text-muted-foreground" />
                    }
                </div>
                <div class="min-w-0 flex-1">
                    <span class="block truncate font-medium text-sm">@_fileName</span>
                    <span class="text-muted-foreground text-xs">@_totalSize</span>
                </div>
                @if (_status == UploadStatus.Complete)
                {
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="Reset">
                        Upload another
                    </ButtonCn>
                }
            </div>

            @* Progress section *@
            @if (_status != UploadStatus.Complete)
            {
                <div class="border-b px-4 py-3">
                    <div class="mb-2">
                        <ProgressCn Value="@_progress" Class="h-1.5" />
                    </div>
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <span class="tabular-nums text-muted-foreground text-xs">
                                @_transferred of @_totalSize
                            </span>
                            <span class="text-muted-foreground text-xs">&middot;</span>
                            <span class="tabular-nums text-muted-foreground text-xs">@_speed</span>
                        </div>
                        <span class="tabular-nums text-muted-foreground text-xs">
                            @_timeRemaining
                        </span>
                    </div>
                </div>
            }

            @* Controls *@
            @if (_status != UploadStatus.Complete)
            {
                <div class="flex items-center justify-end gap-2 px-4 py-3">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" @onclick="Cancel">
                        <LucideIconCn Name="x" Size="12" Class="size-3" />
                        Cancel
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" @onclick="TogglePause">
                        @if (_status == UploadStatus.Paused)
                        {
                            <LucideIconCn Name="play" Size="12" Class="size-3" />
                            <span>Resume</span>
                        }
                        else
                        {
                            <LucideIconCn Name="pause" Size="12" Class="size-3" />
                            <span>Pause</span>
                        }
                    </ButtonCn>
                </div>
            }
        }
    </div>
</section>

@code {
    private enum UploadStatus { Idle, Uploading, Paused, Complete }

    private UploadStatus _status = UploadStatus.Idle;
    private int _progress = 42;
    private string _fileName = "design-assets-v3.zip";
    private long _fileSize = 12_582_912; // 12 MB

    private string _speed = "2.4 MB/s";

    private string _totalSize => FormatBytes(_fileSize);
    private string _transferred => FormatBytes((long)(_fileSize * _progress / 100.0));
    private string _timeRemaining => _progress < 100 ? $"{Math.Max(1, (100 - _progress) / 8)}s left" : "Done";

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{(bytes / 1024.0):F1} KB";
        return $"{(bytes / (1024.0 * 1024.0)):F1} MB";
    }

    private void SimulateFileSelect()
    {
        _status = UploadStatus.Uploading;
        _progress = 42;
    }

    private void TogglePause()
    {
        if (_status == UploadStatus.Uploading)
        {
            _status = UploadStatus.Paused;
        }
        else if (_status == UploadStatus.Paused)
        {
            _status = UploadStatus.Uploading;
        }
    }

    private void Cancel()
    {
        _status = UploadStatus.Idle;
        _progress = 0;
    }

    private void Reset()
    {
        _status = UploadStatus.Idle;
        _progress = 0;
    }
}
