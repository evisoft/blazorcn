@* ============================================================
   Block: file-upload-social-media-post
   Title: FileUploadSocialMediaPost
   Description: A social media post upload block for React and Next.js with image and video upload area, character count for captions, platform selector for Instagram, Twitter, and LinkedIn, post preview, and schedule toggle using shadcn/ui Button, Badge, Switch, and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-social-media-post.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">New post</p>
                <p class="text-muted-foreground text-xs">Compose and publish to social platforms</p>
            </div>
            <div class="flex items-center gap-1.5">
                @foreach (var pId in _selectedPlatforms)
                {
                    var platform = _platforms.FirstOrDefault(pl => pl.Id == pId);
                    if (platform != null)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">
                            @platform.Label
                        </BadgeCn>
                    }
                }
            </div>
        </div>

        @* Platform selector *@
        <div class="flex border-b">
            @foreach (var plat in _platforms)
            {
                var isSelected = _selectedPlatforms.Contains(plat.Id);
                var pid = plat.Id;
                <button
                    type="button"
                    @onclick="@(() => TogglePlatform(pid))"
                    class="@Cn.Merge("flex flex-1 items-center justify-center gap-1.5 px-3 py-2.5 text-xs transition-colors", isSelected ? "border-b-2 border-foreground font-medium text-foreground" : "text-muted-foreground hover:text-foreground")">
                    <span class="@Cn.Merge("size-1.5 rounded-full", isSelected ? "bg-emerald-500" : "bg-muted-foreground/30")"></span>
                    @plat.Label
                </button>
            }
        </div>

        @* Media upload area *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 font-medium text-muted-foreground text-xs">Media</p>
            <div class="flex gap-2">
                @foreach (var file in _media)
                {
                    var fid = file.Id;
                    <div class="group relative">
                        <div class="flex size-20 items-center justify-center rounded-md border bg-muted/50">
                            <div class="flex flex-col items-center gap-1">
                                <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/60" />
                                <span class="font-mono text-muted-foreground text-[10px]">@file.Size</span>
                            </div>
                        </div>
                        <button
                            type="button"
                            @onclick="@(() => RemoveMedia(fid))"
                            aria-label="Remove media"
                            class="absolute -top-1.5 -right-1.5 flex size-5 items-center justify-center rounded-full border bg-card text-muted-foreground transition-colors hover:text-foreground">
                            <LucideIconCn Name="x" Size="12" Class="size-3" />
                        </button>
                    </div>
                }
                <div class="flex size-20 cursor-pointer items-center justify-center rounded-md border border-dashed bg-muted/30 transition-colors hover:bg-muted/50">
                    <div class="flex flex-col items-center gap-1">
                        <LucideIconCn Name="image-plus" Size="16" Class="size-4 text-muted-foreground/60" />
                        <span class="text-muted-foreground text-[10px]">Add</span>
                    </div>
                </div>
            </div>
        </div>

        @* Caption *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <p class="font-medium text-muted-foreground text-xs">Caption</p>
                <span class="@Cn.Merge("font-mono text-xs", _isOverLimit ? "text-red-600 dark:text-red-400" : _isNearLimit ? "text-amber-600 dark:text-amber-400" : "text-muted-foreground")">
                    @_charCount/@_activeLimit
                </span>
            </div>
            <TextareaCn
                aria-label="Caption"
                @bind-Value="_caption"
                Placeholder="Write your caption..."
                Class="min-h-[80px] resize-none border-0 bg-transparent p-0 text-sm shadow-none focus-visible:ring-0" />
        </div>

        @* Post preview *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 font-medium text-muted-foreground text-xs">Preview</p>
            <div class="rounded-md bg-muted/50 p-3">
                <div class="flex items-center gap-2">
                    <div class="size-7 rounded-full bg-muted"></div>
                    <div>
                        <p class="font-medium text-xs">Your Brand</p>
                        <p class="text-muted-foreground text-[10px]">Just now</p>
                    </div>
                </div>
                @if (_media.Count > 0)
                {
                    <div class="mt-2 flex aspect-video items-center justify-center rounded-md bg-muted">
                        <LucideIconCn Name="image" Size="24" Class="size-6 text-muted-foreground/40" />
                    </div>
                }
                <p class="mt-2 text-xs leading-relaxed">
                    @(_caption.Length > 140 ? _caption.Substring(0, 140) + "..." : _caption)
                </p>
            </div>
        </div>

        @* Schedule + Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-2 text-xs">
                    <SwitchCn @bind-Value="_isScheduled" aria-label="Schedule" />
                    <span class="text-muted-foreground">Schedule</span>
                </span>
                @if (_isScheduled)
                {
                    <span class="flex items-center gap-1 text-muted-foreground text-xs">
                        <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                        Tomorrow, 9:00 AM
                    </span>
                }
            </div>
            <ButtonCn
                Size="ButtonSize.Sm"
                Class="h-7 gap-1.5 text-xs"
                Disabled="@(_selectedPlatforms.Count == 0)">
                <LucideIconCn Name="send" Size="12" Class="size-3" />
                @(_isScheduled ? "Schedule" : "Publish")
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record PlatformItem(string Id, string Label, int CharLimit);
    private record MediaFile(string Id, string Name, string Type, string Size);

    private static readonly PlatformItem[] _platforms =
    [
        new("instagram", "Instagram", 2200),
        new("twitter", "Twitter", 280),
        new("linkedin", "LinkedIn", 3000),
    ];

    private List<string> _selectedPlatforms = ["instagram", "twitter"];

    private List<MediaFile> _media =
    [
        new("1", "product-launch-hero.jpg", "image", "2.4 MB"),
    ];

    private string _caption = "Excited to announce our latest product update. Faster performance, cleaner UI, and the features you've been asking for.";
    private bool _isScheduled = false;

    private int _activeLimit => _selectedPlatforms.Count == 0
        ? 3000
        : _selectedPlatforms
            .Select(pid => _platforms.FirstOrDefault(pl => pl.Id == pid))
            .Where(p => p != null)
            .Select(p => p!.CharLimit)
            .DefaultIfEmpty(3000)
            .Min();

    private int _charCount => _caption.Length;
    private bool _isOverLimit => _charCount > _activeLimit;
    private bool _isNearLimit => _charCount > _activeLimit * 0.9;

    private void TogglePlatform(string id)
    {
        if (_selectedPlatforms.Contains(id))
            _selectedPlatforms.Remove(id);
        else
            _selectedPlatforms.Add(id);
    }

    private void RemoveMedia(string id)
    {
        _media.RemoveAll(m => m.Id == id);
    }
}
