@* ============================================================
   Block: file-upload-trash-recovery
   Title: FileUploadTrashRecovery
   Description: Recently deleted files recovery block for React and Next.js with trash list, original location, auto-delete countdown, restore and permanent delete controls, and storage summary using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-trash-recovery.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Trash</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_trash.Count @(_trash.Count == 1 ? "file" : "files") · @FormatBytes(_totalBytes) recoverable
                </p>
            </div>
            @if (_trash.Count > 0)
            {
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs text-red-600 hover:text-red-600 dark:text-red-400 dark:hover:text-red-400" @onclick="EmptyTrash">
                    <LucideIconCn Name="trash-2" Size="12" Class="size-3" />
                    Empty trash
                </ButtonCn>
            }
        </div>

        @* Summary *@
        @if (_trash.Count > 0)
        {
            <div class="flex items-center gap-3 border-b bg-muted/30 px-4 py-2">
                <span class="text-muted-foreground text-xs">Files auto-delete after 30 days</span>
                @if (_expiringCount > 0)
                {
                    <span class="text-muted-foreground text-xs">·</span>
                    <span class="flex items-center gap-1.5 text-xs">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        <span class="text-muted-foreground">@_expiringCount expiring soon</span>
                    </span>
                }
            </div>
        }

        @* File list *@
        <div>
            @for (int i = 0; i < _trash.Count; i++)
            {
                var file = _trash[i];
                var isLast = i == _trash.Count - 1;
                var isExpiringSoon = file.DaysRemaining <= 7;
                var fileId = file.Id;
                <div class="@Cn.Merge("", isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3 px-4 py-3">
                        <LucideIconCn Name="@GetFileIcon(file.Type)" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate font-medium text-sm">@file.Name</span>
                                @if (isExpiringSoon)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-[10px] font-normal">
                                        @(file.DaysRemaining)d left
                                    </BadgeCn>
                                }
                            </div>
                            <div class="mt-0.5 flex items-center gap-1.5 text-muted-foreground text-xs">
                                <LucideIconCn Name="folder" Size="12" Class="size-3" />
                                <span class="truncate">@file.OriginalPath</span>
                                <span>·</span>
                                <span class="shrink-0">@file.DeletedDate</span>
                                <span>·</span>
                                <span class="shrink-0">@file.Size</span>
                            </div>
                        </div>
                        <div class="flex shrink-0 items-center gap-1">
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs" @onclick="@(() => RestoreFile(fileId))">
                                <LucideIconCn Name="rotate-ccw" Size="12" Class="size-3" />
                                Restore
                            </ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs text-red-600 hover:text-red-600 dark:text-red-400 dark:hover:text-red-400" @onclick="@(() => DeleteFile(fileId))">
                                <LucideIconCn Name="trash-2" Size="12" Class="size-3" />
                                Delete
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Empty state *@
        @if (_trash.Count == 0)
        {
            <div class="flex flex-col items-center gap-1 px-4 py-10">
                <LucideIconCn Name="trash-2" Size="24" Class="size-6 text-muted-foreground/40" />
                <span class="mt-1 text-muted-foreground text-xs">Trash is empty</span>
            </div>
        }
    </div>
</section>

@code {
    private record TrashedFile(
        string Id,
        string Name,
        string Size,
        long SizeBytes,
        string Type,
        string DeletedDate,
        int DaysRemaining,
        string OriginalPath,
        string DeletedBy
    );

    private List<TrashedFile> _trash =
    [
        new("1", "old-brand-assets.zip",       "24.8 MB", 26000000,  "archive",  "Mar 22", 28, "/Marketing/Brand",      "Sarah Chen"),
        new("2", "draft-proposal-v1.docx",     "1.2 MB",  1258000,   "document", "Mar 20", 26, "/Sales/Proposals",      "James Wilson"),
        new("3", "product-screenshot-old.png", "3.4 MB",  3565000,   "image",    "Mar 18", 24, "/Product/Screenshots",  "Maria Garcia"),
        new("4", "quarterly-review-notes.pdf", "892 KB",  913408,    "pdf",      "Mar 15", 21, "/Finance/Reports",      "Priya Patel"),
        new("5", "test-data-export.csv",       "156 KB",  159744,    "document", "Mar 10", 16, "/Engineering/Data",     "Alex Kim"),
        new("6", "team-offsite-photos.zip",    "48.2 MB", 50534400,  "archive",  "Mar 5",  11, "/Team/Events",          "Sarah Chen"),
        new("7", "deprecated-api-docs.md",     "34 KB",   34816,     "document", "Feb 28",  4, "/Engineering/Docs",     "James Wilson"),
    ];

    private long _totalBytes => _trash.Sum(f => f.SizeBytes);
    private int _expiringCount => _trash.Count(f => f.DaysRemaining <= 7);

    private void RestoreFile(string id) => _trash = _trash.Where(f => f.Id != id).ToList();
    private void DeleteFile(string id)  => _trash = _trash.Where(f => f.Id != id).ToList();
    private void EmptyTrash()           => _trash = [];

    private static string GetFileIcon(string type) => type switch
    {
        "image"    => "image",
        "pdf"      => "file-text",
        "document" => "file-text",
        _          => "file",
    };

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024L * 1024)           return $"{(bytes / 1024.0):F0} KB";
        if (bytes < 1024L * 1024 * 1024)   return $"{(bytes / (1024.0 * 1024)):F1} MB";
        return $"{(bytes / (1024.0 * 1024 * 1024)):F1} GB";
    }
}
