@* ============================================================
   Block: file-upload-resume-parser
   Title: FileUploadResumeParser
   Description: A resume and CV upload block for React and Next.js with automatic parsing of name, email, phone, skills tags, experience timeline, education history, confidence scores per section, and editable parsed fields using shadcn/ui Button, Badge, Input, and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-resume-parser.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Resume Parser</span>
            @if (_uploaded)
            {
                <div class="ml-auto">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs" OnClick="@(() => _editing = !_editing)">
                        <LucideIconCn Name="pencil" Size="12" Class="size-3" />
                        @(_editing ? "Done" : "Edit")
                    </ButtonCn>
                </div>
            }
        </div>

        @if (!_uploaded)
        {
            <div class="flex flex-col items-center px-4 py-10">
                <LucideIconCn Name="upload" Size="32" Class="mb-3 size-8 text-muted-foreground" />
                <span class="font-medium text-sm">Upload a resume</span>
                <span class="mt-1 text-muted-foreground text-xs">PDF or DOCX up to 10 MB</span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-4 h-7 text-xs" OnClick="@(() => _uploaded = true)">
                    Choose file
                </ButtonCn>
            </div>
        }
        else
        {
            @* File info *@
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted/50">
                    <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground/60" />
                </div>
                <div class="min-w-0 flex-1">
                    <span class="block truncate font-medium text-sm">sarah-chen-resume-2026.pdf</span>
                    <span class="text-muted-foreground text-xs">142 KB</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-mono font-normal text-xs">
                    PDF
                </BadgeCn>
            </div>

            @* Contact info *@
            <div class="border-b px-4 py-3">
                <div class="mb-2 flex items-center justify-between">
                    <span class="font-medium text-muted-foreground text-xs">Contact information</span>
                    <span class="@($"font-mono text-xs tabular-nums {ConfidenceColor(_resume.ConfidenceContact)}")">
                        @_resume.ConfidenceContact%
                    </span>
                </div>
                <div class="space-y-2">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="user" Size="14" Class="size-3.5 text-muted-foreground" />
                        @if (_editing)
                        {
                            <InputCn aria-label="Name" @bind-Value="_resume.Name" Class="h-7 text-sm" />
                        }
                        else
                        {
                            <span class="text-sm">@_resume.Name</span>
                        }
                    </div>
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="mail" Size="14" Class="size-3.5 text-muted-foreground" />
                        @if (_editing)
                        {
                            <InputCn aria-label="Email" @bind-Value="_resume.Email" Class="h-7 text-sm" />
                        }
                        else
                        {
                            <span class="text-sm">@_resume.Email</span>
                        }
                    </div>
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="phone" Size="14" Class="size-3.5 text-muted-foreground" />
                        @if (_editing)
                        {
                            <InputCn aria-label="Phone" @bind-Value="_resume.Phone" Class="h-7 text-sm" />
                        }
                        else
                        {
                            <span class="text-sm">@_resume.Phone</span>
                        }
                    </div>
                </div>
            </div>

            @* Skills *@
            <div class="border-b px-4 py-3">
                <div class="mb-2 flex items-center justify-between">
                    <span class="font-medium text-muted-foreground text-xs">Skills (@_resume.Skills.Length)</span>
                    <span class="@($"font-mono text-xs tabular-nums {ConfidenceColor(_resume.ConfidenceSkills)}")">
                        @_resume.ConfidenceSkills%
                    </span>
                </div>
                <div class="flex flex-wrap gap-1.5">
                    @foreach (var skill in _resume.Skills)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@skill</BadgeCn>
                    }
                </div>
            </div>

            @* Experience *@
            <div class="border-b">
                <button type="button"
                        @onclick="@(() => _expandedSection = (_expandedSection == "experience" ? null : "experience"))"
                        class="flex w-full items-center gap-2 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                    <LucideIconCn Name="briefcase" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-sm">Experience</span>
                    <span class="text-muted-foreground text-xs">(@_resume.Experience.Length)</span>
                    <span class="@($"ml-auto font-mono text-xs tabular-nums {ConfidenceColor(_resume.ConfidenceExperience)}")">
                        @_resume.ConfidenceExperience%
                    </span>
                    <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", _expandedSection == "experience" ? "rotate-90" : "")" />
                </button>
                @if (_expandedSection == "experience")
                {
                    <div>
                        @for (int i = 0; i < _resume.Experience.Length; i++)
                        {
                            var exp = _resume.Experience[i];
                            var isLast = i == _resume.Experience.Length - 1;
                            var isExpanded = _expandedItem == exp.Id;
                            <div class="@(isLast ? "" : "border-b")">
                                <button type="button"
                                        @onclick="@(() => _expandedItem = (isExpanded ? null : exp.Id))"
                                        class="flex w-full items-center gap-3 px-4 py-2.5 pl-8 text-left transition-colors hover:bg-muted/50">
                                    <div class="min-w-0 flex-1">
                                        <span class="text-sm">@exp.Title</span>
                                        <p class="mt-0.5 text-muted-foreground text-xs">@exp.Company · @exp.Period</p>
                                    </div>
                                    <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                                </button>
                                @if (isExpanded)
                                {
                                    <div class="px-4 pb-3 pl-8">
                                        <div class="rounded-md bg-muted/50 p-3">
                                            <p class="text-sm leading-relaxed">@exp.Description</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            @* Education *@
            <div>
                <button type="button"
                        @onclick="@(() => _expandedSection = (_expandedSection == "education" ? null : "education"))"
                        class="flex w-full items-center gap-2 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                    <LucideIconCn Name="graduation-cap" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-sm">Education</span>
                    <span class="text-muted-foreground text-xs">(@_resume.Education.Length)</span>
                    <span class="@($"ml-auto font-mono text-xs tabular-nums {ConfidenceColor(_resume.ConfidenceEducation)}")">
                        @_resume.ConfidenceEducation%
                    </span>
                    <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", _expandedSection == "education" ? "rotate-90" : "")" />
                </button>
                @if (_expandedSection == "education")
                {
                    <div>
                        @for (int i = 0; i < _resume.Education.Length; i++)
                        {
                            var edu = _resume.Education[i];
                            var isLast = i == _resume.Education.Length - 1;
                            <div class="@($"px-4 py-2.5 pl-8 {(isLast ? "" : "border-b")}")">
                                <span class="text-sm">@edu.Degree</span>
                                <p class="mt-0.5 text-muted-foreground text-xs">@edu.Institution · @edu.Year</p>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record Experience(string Id, string Title, string Company, string Period, string Description);
    private record Education(string Id, string Degree, string Institution, string Year);

    private class ResumeData
    {
        public string Name { get; set; } = "Sarah Chen";
        public string Email { get; set; } = "sarah.chen@email.com";
        public string Phone { get; set; } = "+1 (415) 555-0172";
        public string[] Skills { get; set; } =
        [
            "React", "TypeScript", "Node.js", "PostgreSQL", "AWS",
            "Docker", "GraphQL", "Tailwind CSS", "Next.js", "Python",
        ];
        public Experience[] Experience { get; set; } =
        [
            new("1", "Senior Frontend Engineer", "Stripe",  "Jan 2023 - Present",
                "Led migration of payment dashboard from Angular to React. Reduced bundle size by 40% through code splitting and lazy loading. Mentored 3 junior engineers."),
            new("2", "Frontend Engineer",         "Vercel",  "Mar 2020 - Dec 2022",
                "Built the deployment preview system UI. Implemented real-time log streaming with WebSockets. Contributed to the Next.js documentation site."),
            new("3", "Junior Developer",           "Netlify", "Jun 2018 - Feb 2020",
                "Developed build plugin configuration interface. Created automated testing pipeline for the dashboard. Fixed 200+ accessibility issues across the platform."),
        ];
        public Education[] Education { get; set; } =
        [
            new("1", "B.S. Computer Science", "UC Berkeley", "2018"),
        ];
        public int ConfidenceContact    { get; set; } = 97;
        public int ConfidenceSkills     { get; set; } = 88;
        public int ConfidenceExperience { get; set; } = 94;
        public int ConfidenceEducation  { get; set; } = 92;
    }

    private bool _uploaded = true;
    private bool _editing  = false;
    private ResumeData _resume = new();
    private string? _expandedSection = "experience";
    private string? _expandedItem    = "1";

    private static string ConfidenceColor(int score) =>
        score >= 90
            ? "text-emerald-600 dark:text-emerald-400"
            : score >= 70
                ? "text-amber-600 dark:text-amber-400"
                : "text-red-600 dark:text-red-400";
}
