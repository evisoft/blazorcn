@* ============================================================
   Block: file-upload-gallery-grid
   Title: FileUploadGalleryGrid
   Description: A React photo gallery upload block with responsive grid layout, drag-to-reorder indicators, thumbnail placeholders, cover photo selection, per-image captions, and delete overlays using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-gallery-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Photo gallery</p>
                <p class="text-muted-foreground text-xs">
                    @_images.Count photo@(_images.Count != 1 ? "s" : "") uploaded
                </p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideIconCn Name="image-plus" Size="14" Class="size-3.5" />
                Add photos
            </ButtonCn>
        </div>

        @* Grid *@
        <div class="p-4">
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
                @foreach (var img in _images)
                {
                    var image = img;
                    var isCover = _coverId == image.Id;
                    var isHovered = _hoveredId == image.Id;
                    <div
                        class="group relative"
                        @onmouseenter="@(() => _hoveredId = image.Id)"
                        @onmouseleave="@(() => _hoveredId = null)">
                        @* Thumbnail placeholder *@
                        <div class="relative aspect-square overflow-hidden rounded-md border bg-muted/50">
                            @* Drag grip indicator *@
                            <div class="absolute top-1.5 left-1.5 z-10 rounded bg-background/80 p-0.5 opacity-0 transition-opacity group-hover:opacity-100">
                                <LucideIconCn Name="grip-vertical" Size="14" Class="size-3.5 text-muted-foreground" />
                            </div>

                            @* Cover badge *@
                            @if (isCover)
                            {
                                <div class="absolute top-1.5 right-1.5 z-10 flex items-center gap-1 rounded bg-background/80 px-1.5 py-0.5">
                                    <LucideIconCn Name="star" Size="12" Class="size-3 fill-amber-500 text-amber-500" />
                                    <span class="font-medium text-[10px]">Cover</span>
                                </div>
                            }

                            @* Placeholder content *@
                            <div class="flex size-full flex-col items-center justify-center gap-1">
                                <div class="size-8 rounded bg-muted"></div>
                                <span class="font-mono text-muted-foreground text-[10px]">
                                    @image.Size
                                </span>
                            </div>

                            @* Hover overlay *@
                            @if (isHovered)
                            {
                                <div class="absolute inset-0 flex items-center justify-center gap-2 bg-background/60">
                                    @if (!isCover)
                                    {
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                            Class="h-7 gap-1 px-2 text-xs"
                                            OnClick="@(() => _coverId = image.Id)">
                                            <LucideIconCn Name="star" Size="12" Class="size-3" />
                                            Set cover
                                        </ButtonCn>
                                    }
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                        Class="h-7 px-2 text-xs text-red-600 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300"
                                        aria-label="@($"Remove {image.Name}")"
                                        OnClick="@(() => RemoveImage(image.Id))">
                                        <LucideIconCn Name="trash-2" Size="12" Class="size-3" />
                                    </ButtonCn>
                                </div>
                            }
                        </div>

                        @* Caption input *@
                        <InputCn
                            aria-label="Add caption"
                            Value="@image.Caption"
                            ValueChanged="@((string v) => UpdateCaption(image.Id, v))"
                            Placeholder="Add caption..."
                            Class="mt-1.5 h-7 border-0 bg-transparent px-1 text-xs shadow-none focus-visible:ring-0" />
                    </div>
                }

                @* Add more placeholder *@
                <div class="flex aspect-square cursor-pointer items-center justify-center rounded-md border border-dashed bg-muted/30 transition-colors hover:bg-muted/50">
                    <div class="flex flex-col items-center gap-1">
                        <LucideIconCn Name="image-plus" Size="20" Class="size-5 text-muted-foreground/60" />
                        <span class="text-muted-foreground text-[10px]">Add photo</span>
                    </div>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <p class="text-muted-foreground text-xs">
                Drag to reorder. First image is used as cover.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                Save gallery
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private class GalleryImage
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Size { get; set; } = "";
        public string Caption { get; set; } = "";
    }

    private List<GalleryImage> _images =
    [
        new GalleryImage { Id = "1", Name = "living-room-01.jpg",  Size = "2.4 MB", Caption = "Spacious living room with natural light" },
        new GalleryImage { Id = "2", Name = "kitchen-modern.jpg",  Size = "1.8 MB", Caption = "Renovated kitchen with island"           },
        new GalleryImage { Id = "3", Name = "master-bedroom.jpg",  Size = "2.1 MB", Caption = "Primary suite with en-suite bath"        },
        new GalleryImage { Id = "4", Name = "backyard-patio.jpg",  Size = "3.2 MB", Caption = "Private backyard with covered patio"     },
        new GalleryImage { Id = "5", Name = "bathroom-main.jpg",   Size = "1.5 MB", Caption = ""                                        },
        new GalleryImage { Id = "6", Name = "garage-2car.jpg",     Size = "1.9 MB", Caption = ""                                        },
    ];

    private string _coverId = "1";
    private string? _hoveredId = null;

    private void RemoveImage(string id)
    {
        _images.RemoveAll(img => img.Id == id);
        if (_coverId == id && _images.Count > 0)
        {
            _coverId = _images[0].Id;
        }
    }

    private void UpdateCaption(string id, string caption)
    {
        var image = _images.Find(img => img.Id == id);
        if (image != null)
        {
            image.Caption = caption;
        }
    }
}
