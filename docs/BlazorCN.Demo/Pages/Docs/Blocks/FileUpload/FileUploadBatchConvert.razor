@* ============================================================
   Block: file-upload-batch-convert
   Title: FileUploadBatchConvert
   Description: A batch file format conversion block for React and Next.js with multiple file upload, target format selection, individual conversion progress bars, download all as ZIP button, and a format compatibility matrix using shadcn/ui Button, Badge, Select, Progress, and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-batch-convert.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="package" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Batch convert</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_files.Length files
            </BadgeCn>
        </div>

        @* Target format + actions *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="text-muted-foreground text-xs">Target format</span>
                <div class="mt-1 flex items-center gap-2">
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono font-normal text-xs uppercase">
                        @_targetFormat
                    </BadgeCn>
                    <span class="text-muted-foreground text-xs">
                        @_completedCount/@_files.Length converted
                    </span>
                    @if (_errorCount > 0)
                    {
                        <span class="text-muted-foreground text-xs">·</span>
                        <span class="flex items-center gap-1 text-red-500 text-xs">
                            <span class="size-1.5 rounded-full bg-red-500"></span>
                            @_errorCount failed
                        </span>
                    }
                </div>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn
                    Variant="ButtonVariant.Ghost"
                    Size="ButtonSize.Sm"
                    Class="h-7 text-xs"
                    OnClick="@(() => _showMatrix = !_showMatrix)">
                    @(_showMatrix ? "Hide" : "Show") formats
                </ButtonCn>
                @if (_allDone && _completedCount > 0)
                {
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                        <LucideIconCn Name="download" Size="12" Class="size-3" />
                        Download ZIP
                    </ButtonCn>
                }
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="upload" Size="12" Class="size-3" />
                    Add files
                </ButtonCn>
            </div>
        </div>

        @* Format compatibility matrix *@
        @if (_showMatrix)
        {
            <div class="border-b px-4 py-3">
                <span class="mb-2 block font-medium text-muted-foreground text-xs">
                    Compatibility matrix
                </span>
                <div class="overflow-x-auto">
                    <table class="w-full text-xs">
                        <thead>
                            <tr>
                                <th class="px-2 py-1.5 text-left font-medium text-muted-foreground">
                                    Source
                                </th>
                                @foreach (var fmt in _allTargetFormats)
                                {
                                    <th class="px-2 py-1.5 text-center font-mono font-medium text-muted-foreground uppercase">
                                        @fmt
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fmtOpt in _formatOptions)
                            {
                                var opt = fmtOpt;
                                <tr class="border-t">
                                    <td class="px-2 py-1.5 font-mono font-medium uppercase">@opt.Label</td>
                                    @foreach (var target in _allTargetFormats)
                                    {
                                        var tgt = target;
                                        <td class="px-2 py-1.5 text-center">
                                            @if (opt.Targets.Contains(tgt))
                                            {
                                                <LucideIconCn Name="check" Size="12" Class="mx-auto size-3 text-emerald-500" />
                                            }
                                            else if (tgt == opt.Id)
                                            {
                                                <span class="text-muted-foreground">—</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted-foreground/30">·</span>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* File list *@
        <div>
            @for (int i = 0; i < _files.Length; i++)
            {
                var file = _files[i];
                var isLast = i == _files.Length - 1;
                <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3">
                        @if (file.Status == "pending")
                        {
                            <LucideIconCn Name="file" Size="14" Class="size-3.5 text-muted-foreground" />
                        }
                        else if (file.Status == "converting")
                        {
                            <LucideIconCn Name="loader-2" Size="14" Class="size-3.5 animate-spin text-blue-500" />
                        }
                        else if (file.Status == "complete")
                        {
                            <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                        }
                        else
                        {
                            <LucideIconCn Name="x" Size="14" Class="size-3.5 text-red-500" />
                        }
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate font-medium text-xs">@file.Name</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-mono font-normal text-xs uppercase">
                                    @file.SourceFormat
                                </BadgeCn>
                                <span class="text-muted-foreground text-xs">@("→")</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-mono font-normal text-xs uppercase">
                                    @_targetFormat
                                </BadgeCn>
                            </div>
                            <span class="text-muted-foreground text-xs">@file.Size</span>
                        </div>
                        @if (file.Status == "error")
                        {
                            var fileId = file.Id;
                            <ButtonCn
                                Variant="ButtonVariant.Ghost"
                                Size="ButtonSize.Sm"
                                Class="h-6 gap-1 px-2 text-xs"
                                OnClick="@(() => RetryFile(fileId))">
                                <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                                Retry
                            </ButtonCn>
                        }
                        @if (file.Status == "complete")
                        {
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                                <LucideIconCn Name="download" Size="12" Class="size-3" />
                            </ButtonCn>
                        }
                    </div>

                    @* Progress bar for converting files *@
                    @if (file.Status == "converting")
                    {
                        <div class="mt-2 flex items-center gap-2 pl-6">
                            <ProgressCn Value="@file.Progress" Class="h-1" />
                            <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                                @file.Progress%
                            </span>
                        </div>
                    }

                    @* Error message *@
                    @if (file.Status == "error" && file.Error != null)
                    {
                        <div class="mt-1.5 pl-6">
                            <span class="text-red-500 text-xs">@file.Error</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ConvertFile(string Id, string Name, string Size, string SourceFormat, string Status, int Progress, string? Error = null);
    private record FormatOption(string Id, string Label, string[] Targets);

    private static readonly FormatOption[] _formatOptions =
    [
        new("png",  "PNG",  ["jpg", "webp", "avif", "svg", "pdf"]),
        new("jpg",  "JPG",  ["png", "webp", "avif", "pdf"]),
        new("webp", "WebP", ["png", "jpg", "avif"]),
        new("svg",  "SVG",  ["png", "jpg", "webp", "pdf"]),
        new("pdf",  "PDF",  ["png", "jpg", "docx", "txt"]),
        new("docx", "DOCX", ["pdf", "txt", "md"]),
    ];

    private static readonly string[] _allTargetFormats = ["png", "jpg", "webp", "avif", "svg", "pdf", "docx", "txt", "md"];

    private static readonly ConvertFile[] _initialFiles =
    [
        new("f1", "hero-banner.png",        "2.4 MB", "png", "complete",   100),
        new("f2", "product-shot-01.png",    "1.8 MB", "png", "complete",   100),
        new("f3", "team-photo.jpg",         "3.2 MB", "jpg", "converting",  67),
        new("f4", "logo-full.svg",          "18 KB",  "svg", "converting",  34),
        new("f5", "icon-set.svg",           "42 KB",  "svg", "pending",      0),
        new("f6", "background-pattern.png", "890 KB", "png", "pending",      0),
        new("f7", "thumbnail-grid.jpg",     "1.1 MB", "jpg", "error",       45, "Unsupported color space"),
    ];

    private const string _targetFormat = "webp";

    private ConvertFile[] _files = _initialFiles;
    private bool _showMatrix = false;

    private int _completedCount => _files.Count(f => f.Status == "complete");
    private int _errorCount => _files.Count(f => f.Status == "error");
    private bool _allDone => _files.All(f => f.Status == "complete" || f.Status == "error");

    private void RetryFile(string id)
    {
        _files = _files.Select(f =>
            f.Id == id
                ? f with { Status = "pending", Progress = 0, Error = null }
                : f
        ).ToArray();
    }
}
