@* ============================================================
   Block: file-upload-product-images
   Title: FileUploadProductImages
   Description: An e-commerce product image upload block for React and Next.js with primary image slot, additional images grid, set-as-primary button, drag-to-reorder indicators, image requirements notice, and delete overlays using shadcn/ui Button, Badge, and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-product-images.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Product images</p>
                <p class="text-muted-foreground text-xs">@_images.Count of 7 images uploaded</p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideIconCn Name="upload" Size="12" Class="size-3" />
                Add image
            </ButtonCn>
        </div>

        @* Primary image *@
        @if (_primaryImage != null)
        {
            var primary = _primaryImage;
            <div class="border-b px-4 py-4">
                <div class="mb-1.5 flex items-center gap-1.5">
                    <LucideIconCn Name="star" Size="12" Class="size-3 fill-amber-500 text-amber-500" />
                    <span class="font-medium text-xs">Primary image</span>
                </div>
                <div
                    class="group relative aspect-[4/3] overflow-hidden rounded-md border bg-muted/50"
                    @onmouseenter="@(() => _hoveredId = primary.Id)"
                    @onmouseleave="@(() => _hoveredId = null)"
                >
                    <div class="flex size-full flex-col items-center justify-center gap-2">
                        <LucideIconCn Name="image" Size="32" Class="size-8 text-muted-foreground/40" />
                        <div class="text-center">
                            <p class="font-mono text-muted-foreground text-xs">@primary.Name</p>
                            <p class="mt-0.5 text-muted-foreground/60 text-[10px]">
                                @primary.Dimensions &middot; @primary.Size
                            </p>
                        </div>
                    </div>
                    @if (_hoveredId == primary.Id)
                    {
                        <div class="absolute inset-0 flex items-center justify-center bg-background/60">
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                Class="h-7 px-2 text-xs text-red-600 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300"
                                OnClick="@(() => RemoveImage(primary.Id))">
                                <LucideIconCn Name="trash-2" Size="12" Class="mr-1 size-3" />
                                Remove
                            </ButtonCn>
                        </div>
                    }
                </div>
            </div>
        }

        @* Additional images grid *@
        <div class="border-b px-4 py-4">
            <p class="mb-2 font-medium text-muted-foreground text-xs">Additional images</p>
            <div class="grid grid-cols-3 gap-2 sm:grid-cols-4">
                @foreach (var img in _additionalImages)
                {
                    var image = img;
                    var isHovered = _hoveredId == image.Id;
                    <div
                        class="group relative"
                        @onmouseenter="@(() => _hoveredId = image.Id)"
                        @onmouseleave="@(() => _hoveredId = null)"
                    >
                        <div class="relative aspect-square overflow-hidden rounded-md border bg-muted/50">
                            <div class="absolute top-1 left-1 z-10 rounded bg-background/80 p-0.5 opacity-0 transition-opacity group-hover:opacity-100">
                                <LucideIconCn Name="grip-vertical" Size="12" Class="size-3 text-muted-foreground" />
                            </div>
                            <div class="flex size-full flex-col items-center justify-center gap-1">
                                <div class="size-6 rounded bg-muted"></div>
                                <span class="font-mono text-muted-foreground text-[10px]">
                                    @image.Size
                                </span>
                            </div>
                            @if (isHovered)
                            {
                                <div class="absolute inset-0 flex items-center justify-center gap-1.5 bg-background/60">
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                        Class="h-6 gap-1 px-1.5 text-[10px]"
                                        OnClick="@(() => SetPrimary(image.Id))">
                                        <LucideIconCn Name="star" Size="12" Class="size-3" />
                                        Primary
                                    </ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                        Class="size-6 p-0 text-red-600 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300"
                                        OnClick="@(() => RemoveImage(image.Id))">
                                        <LucideIconCn Name="trash-2" Size="12" Class="size-3" />
                                    </ButtonCn>
                                </div>
                            }
                        </div>
                    </div>
                }
                @if (_images.Count < 7)
                {
                    <div class="flex aspect-square cursor-pointer items-center justify-center rounded-md border border-dashed bg-muted/30 transition-colors hover:bg-muted/50">
                        <div class="flex flex-col items-center gap-1">
                            <LucideIconCn Name="image-plus" Size="16" Class="size-4 text-muted-foreground/60" />
                            <span class="text-muted-foreground text-[10px]">Add</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Requirements notice *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="text-muted-foreground text-xs">
                <p>Min 1200 x 1200px &middot; 1:1 aspect ratio recommended &middot; JPG, PNG, WebP</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-[10px]">
                Max 10 MB
            </BadgeCn>
        </div>
    </div>
</section>

@code {
    private class ProductImage
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Size { get; set; } = "";
        public string Dimensions { get; set; } = "";
    }

    private List<ProductImage> _images =
    [
        new ProductImage { Id = "1", Name = "front-view.jpg",       Size = "1.8 MB", Dimensions = "2400 x 2400" },
        new ProductImage { Id = "2", Name = "back-view.jpg",        Size = "1.6 MB", Dimensions = "2400 x 2400" },
        new ProductImage { Id = "3", Name = "side-angle-left.jpg",  Size = "2.1 MB", Dimensions = "2400 x 2400" },
        new ProductImage { Id = "4", Name = "detail-closeup.jpg",   Size = "1.4 MB", Dimensions = "1800 x 1800" },
        new ProductImage { Id = "5", Name = "lifestyle-shot.jpg",   Size = "2.8 MB", Dimensions = "3200 x 2400" },
        new ProductImage { Id = "6", Name = "packaging.jpg",        Size = "1.2 MB", Dimensions = "2400 x 2400" },
    ];

    private string _primaryId = "1";
    private string? _hoveredId = null;

    private ProductImage? _primaryImage => _images.Find(img => img.Id == _primaryId) ?? (_images.Count > 0 ? _images[0] : null);
    private List<ProductImage> _additionalImages => _images.FindAll(img => img.Id != _primaryId);

    private void SetPrimary(string id)
    {
        _primaryId = id;
    }

    private void RemoveImage(string id)
    {
        if (_primaryId == id && _images.Count > 1)
        {
            var remaining = _images.FindAll(img => img.Id != id);
            _primaryId = remaining[0].Id;
        }
        _images.RemoveAll(img => img.Id == id);
        if (_hoveredId == id)
        {
            _hoveredId = null;
        }
    }
}
