@* ============================================================
   Block: file-upload-multi-file
   Title: FileUploadMultiFile
   Description: Multi-file upload block for React and Next.js with individual progress bars, file type icons, and status indicators using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-multi-file.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Uploads</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_completedCount of @_files.Count complete · @_totalSize
                </p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" OnClick="AddFiles">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Add files
            </ButtonCn>
        </div>

        @* File list *@
        <div>
            @for (int i = 0; i < _files.Count; i++)
            {
                var idx = i;
                var file = _files[i];
                var isLast = idx == _files.Count - 1;
                <div class="@Cn.Merge("", !isLast ? "border-b" : "")">
                    <div class="flex items-center gap-3 px-4 py-3">
                        @FileIcon(file.Type)
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate font-medium text-sm">@file.Name</span>
                                <span class="shrink-0 text-muted-foreground text-xs">@file.Size</span>
                            </div>
                            @if (file.Status == UploadStatus.Uploading)
                            {
                                <div class="mt-1.5 flex items-center gap-2">
                                    <ProgressCn Value="@file.Progress" Class="h-1" />
                                    <span class="shrink-0 text-muted-foreground text-xs tabular-nums">
                                        @file.Progress%
                                    </span>
                                </div>
                            }
                        </div>
                        <div class="flex shrink-0 items-center gap-1.5">
                            @StatusIcon(file.Status)
                            @{ var capturedId = file.Id; }
                            <button
                                type="button"
                                @onclick="@(() => RemoveFile(capturedId))"
                                class="inline-flex items-center justify-center rounded-sm p-0.5 text-muted-foreground hover:text-foreground transition-colors">
                                <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Empty state *@
        @if (_files.Count == 0)
        {
            <div class="px-4 py-8 text-center">
                <span class="text-muted-foreground text-xs">No files in queue</span>
            </div>
        }
    </div>
</section>

@code {
    private enum UploadStatus { Uploading, Complete, Error }

    private class UploadFile
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Size { get; set; } = "";
        public string Type { get; set; } = "";
        public int Progress { get; set; }
        public UploadStatus Status { get; set; }
    }

    private List<UploadFile> _files =
    [
        new UploadFile { Id = "1", Name = "quarterly-report.pdf",     Size = "2.4 MB",  Type = "application/pdf",              Progress = 100, Status = UploadStatus.Complete  },
        new UploadFile { Id = "2", Name = "team-photo.jpg",            Size = "4.1 MB",  Type = "image/jpeg",                   Progress = 100, Status = UploadStatus.Complete  },
        new UploadFile { Id = "3", Name = "product-demo.mp4",          Size = "18.7 MB", Type = "video/mp4",                    Progress = 64,  Status = UploadStatus.Uploading },
        new UploadFile { Id = "4", Name = "budget-2026.xlsx",          Size = "892 KB",  Type = "application/vnd.ms-excel",     Progress = 32,  Status = UploadStatus.Uploading },
        new UploadFile { Id = "5", Name = "architecture-diagram.png",  Size = "1.8 MB",  Type = "image/png",                    Progress = 0,   Status = UploadStatus.Error     },
    ];

    private int _completedCount => _files.Count(f => f.Status == UploadStatus.Complete);
    private string _totalSize => _files.Count > 0 ? "27.9 MB" : "0 B";

    private RenderFragment FileIcon(string type)
    {
        if (type.StartsWith("image/"))
            return @<LucideIconCn Name="image" Size="16" Class="size-4 shrink-0 text-muted-foreground" />;
        if (type.StartsWith("video/"))
            return @<LucideIconCn Name="video" Size="16" Class="size-4 shrink-0 text-muted-foreground" />;
        if (type.Contains("pdf") || type.Contains("document") || type.Contains("text"))
            return @<LucideIconCn Name="file-text" Size="16" Class="size-4 shrink-0 text-muted-foreground" />;
        return @<LucideIconCn Name="file" Size="16" Class="size-4 shrink-0 text-muted-foreground" />;
    }

    private RenderFragment StatusIcon(UploadStatus status) => status switch
    {
        UploadStatus.Complete  => @<LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-600 dark:text-emerald-400" />,
        UploadStatus.Uploading => @<LucideIconCn Name="loader-2" Size="16" Class="size-4 animate-spin text-muted-foreground" />,
        UploadStatus.Error     => @<LucideIconCn Name="triangle-alert" Size="16" Class="size-4 text-red-600 dark:text-red-400" />,
        _                      => @<LucideIconCn Name="file" Size="16" Class="size-4 text-muted-foreground" />,
    };

    private void RemoveFile(string id)
    {
        _files.RemoveAll(f => f.Id == id);
    }

    private void AddFiles()
    {
        _files.Add(new UploadFile
        {
            Id = $"new-{_files.Count + 1}",
            Name = "new-upload.pdf",
            Size = "1.0 MB",
            Type = "application/pdf",
            Progress = 0,
            Status = UploadStatus.Uploading,
        });
    }
}
