@* ============================================================
   Block: file-upload-batch-rename
   Title: FileUploadBatchRename
   Description: React batch file upload block for Next.js with editable file names, bulk rename patterns, prefix and suffix options, sequential numbering, renamed file preview, and apply rename action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-batch-rename.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Batch Rename</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Upload files and rename them in bulk
                </p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                <LucideIconCn Name="upload" Size="12" Class="size-3" />
                Upload
            </ButtonCn>
        </div>

        @* Rename pattern controls *@
        <div class="space-y-3 border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Rename pattern</span>
            <div class="flex items-center gap-2">
                <div class="flex-1">
                    <div class="mb-1 flex items-center gap-1">
                        <LucideIconCn Name="text" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-muted-foreground text-xs">Prefix</span>
                    </div>
                    <InputCn
                        aria-label="Prefix"
                        Value="@_prefix"
                        ValueChanged="@((string v) => _prefix = v)"
                        Placeholder="@("e.g. product-")"
                        Class="h-8 font-mono text-xs" />
                </div>
                <div class="flex-1">
                    <div class="mb-1 flex items-center gap-1">
                        <LucideIconCn Name="text" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-muted-foreground text-xs">Suffix</span>
                    </div>
                    <InputCn
                        aria-label="Suffix"
                        Value="@_suffix"
                        ValueChanged="@((string v) => _suffix = v)"
                        Placeholder="@("e.g. -final")"
                        Class="h-8 font-mono text-xs" />
                </div>
            </div>
            <span class="flex cursor-pointer items-center gap-2">
                <div
                    class="@Cn.Merge("flex size-4 items-center justify-center rounded border transition-colors", _useNumbering ? "border-primary bg-primary" : "border-muted-foreground/30")"
                    @onclick="@(() => _useNumbering = !_useNumbering)"
                    @onkeydown="@((KeyboardEventArgs e) => { if (e.Key == "Enter" || e.Key == " ") _useNumbering = !_useNumbering; })"
                    role="checkbox"
                    aria-label="Add sequential numbering"
                    aria-checked="@_useNumbering.ToString().ToLowerInvariant()"
                    tabindex="0">
                    @if (_useNumbering)
                    {
                        <LucideIconCn Name="check" Size="12" Class="size-3 text-primary-foreground" />
                    }
                </div>
                <LucideIconCn Name="hash" Size="12" Class="size-3 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">
                    Add sequential numbering (-001, -002, ...)
                </span>
            </span>
        </div>

        @* File count *@
        <div class="flex items-center gap-2 border-b px-4 py-2">
            <LucideIconCn Name="file" Size="12" Class="size-3 text-muted-foreground" />
            <span class="text-muted-foreground text-xs">
                <span class="tabular-nums">@_files.Count</span>
                @(_files.Count == 1 ? " file" : " files")
            </span>
            @if (_renamedCount > 0)
            {
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs">
                    <span class="tabular-nums">@_renamedCount</span> will be renamed
                </span>
            }
        </div>

        @* File list with rename preview *@
        <div>
            @for (int i = 0; i < _files.Count; i++)
            {
                var idx = i;
                var file = _files[i];
                var isLast = idx == _files.Count - 1;
                var previewName = GetPreviewName(file, idx);
                <div class="@Cn.Merge(isLast ? "" : "border-b")">
                    <div class="px-4 py-3">
                        <div class="flex items-start gap-3">
                            <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                                <LucideIconCn Name="file" Size="16" Class="size-4 text-muted-foreground" />
                            </div>
                            <div class="min-w-0 flex-1">
                                @* Editable current name *@
                                <div class="flex items-center gap-2">
                                    <InputCn
                                        aria-label="File name"
                                        Value="@file.CurrentName"
                                        ValueChanged="@((string v) => UpdateName(file.Id, v))"
                                        Class="h-7 border-0 bg-transparent px-0 font-medium text-sm shadow-none focus-visible:ring-0" />
                                    <LucideIconCn Name="pencil" Size="12" Class="size-3 shrink-0 text-muted-foreground/40" />
                                    <button
                                        type="button"
                                        @onclick="@(() => RemoveFile(file.Id))"
                                        aria-label="@($"Remove {file.CurrentName}")"
                                        class="shrink-0 text-muted-foreground transition-colors hover:text-foreground">
                                        <LucideIconCn Name="trash" Size="14" Class="size-3.5" />
                                    </button>
                                </div>
                                @* Preview of renamed file *@
                                <div class="mt-1 flex items-center gap-2">
                                    <span class="text-muted-foreground text-xs">→</span>
                                    <span class="truncate font-mono text-muted-foreground text-xs">
                                        @previewName
                                    </span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">
                                        @file.Size
                                    </BadgeCn>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <p class="text-muted-foreground text-xs">
                Preview shows the new file names. Click apply to rename.
            </p>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" OnClick="ApplyRename">
                @if (_applied)
                {
                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                    <text>Applied</text>
                }
                else
                {
                    <text>Apply rename</text>
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private class UploadedFile
    {
        public string Id { get; set; } = "";
        public string OriginalName { get; set; } = "";
        public string CurrentName { get; set; } = "";
        public string Extension { get; set; } = "";
        public string Size { get; set; } = "";
    }

    private List<UploadedFile> _files =
    [
        new UploadedFile { Id = "f1", OriginalName = "IMG_20260315_001",      CurrentName = "IMG_20260315_001",      Extension = ".jpg",  Size = "4.2 MB" },
        new UploadedFile { Id = "f2", OriginalName = "DSC_8842",              CurrentName = "DSC_8842",              Extension = ".png",  Size = "6.1 MB" },
        new UploadedFile { Id = "f3", OriginalName = "screenshot-2026-03-14", CurrentName = "screenshot-2026-03-14", Extension = ".png",  Size = "1.8 MB" },
        new UploadedFile { Id = "f4", OriginalName = "photo_final_v2_EDITED", CurrentName = "photo_final_v2_EDITED", Extension = ".jpg",  Size = "3.5 MB" },
        new UploadedFile { Id = "f5", OriginalName = "untitled-design",       CurrentName = "untitled-design",       Extension = ".webp", Size = "892 KB" },
        new UploadedFile { Id = "f6", OriginalName = "brand-asset-export",    CurrentName = "brand-asset-export",    Extension = ".svg",  Size = "24 KB"  },
    ];

    private string _prefix = "product-";
    private string _suffix = "";
    private bool _useNumbering = true;
    private bool _applied = false;

    private int _renamedCount => _files
        .Select((f, i) => GetPreviewName(f, i) != $"{f.CurrentName}{f.Extension}")
        .Count(changed => changed);

    private string GetPreviewName(UploadedFile file, int index)
    {
        var number = _useNumbering ? $"-{(index + 1).ToString().PadLeft(3, '0')}" : "";
        return $"{_prefix}{file.CurrentName}{_suffix}{number}{file.Extension}";
    }

    private void ApplyRename()
    {
        for (int i = 0; i < _files.Count; i++)
        {
            var number = _useNumbering ? $"-{(i + 1).ToString().PadLeft(3, '0')}" : "";
            _files[i].CurrentName = $"{_prefix}{_files[i].CurrentName}{_suffix}{number}";
        }
        _applied = true;
    }

    private void RemoveFile(string id)
    {
        _files.RemoveAll(f => f.Id == id);
    }

    private void UpdateName(string id, string newName)
    {
        var file = _files.FirstOrDefault(f => f.Id == id);
        if (file is not null)
            file.CurrentName = newName;
    }
}
