@* ============================================================
   Block: file-upload-pdf-viewer
   Title: FileUploadPdfViewer
   Description: PDF file upload block for React and Next.js with page thumbnails, page navigation, zoom indicator, download and print buttons, and file metadata sidebar using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-pdf-viewer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2 min-w-0">
                <LucideIconCn Name="file-text" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                <span class="truncate font-medium text-sm">@(_file != null ? _file.Name : "PDF Viewer")</span>
            </div>
            @if (_file != null)
            {
                <div class="flex items-center gap-1 shrink-0">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                        <LucideIconCn Name="download" Size="12" Class="size-3" />
                        Download
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                        <LucideIconCn Name="printer" Size="12" Class="size-3" />
                        Print
                    </ButtonCn>
                </div>
            }
        </div>

        @if (_file == null)
        {
            @* Upload area *@
            <div class="p-4">
                <label
                    for="file-upload-pdf-viewer-input"
                    class="@Cn.Merge("flex cursor-pointer flex-col items-center justify-center gap-2 rounded-md border-2 border-dashed px-6 py-12 transition-colors",
                        _isDragging
                            ? "border-foreground/30 bg-muted/50"
                            : "border-muted-foreground/20 hover:border-muted-foreground/40 hover:bg-muted/30")"
                    @ondrop="HandleDrop"
                    @ondragover:preventDefault="true"
                    @ondragenter="HandleDragEnter"
                    @ondragleave="HandleDragLeave">
                    <LucideIconCn Name="cloud-upload" Size="32" Class="size-8 text-muted-foreground/60" />
                    <span class="font-medium text-sm">Drop a PDF file here</span>
                    <p class="text-muted-foreground text-xs">or click to browse from your device</p>
                    <input id="file-upload-pdf-viewer-input" type="file" accept=".pdf" class="hidden" @onchange="HandleFileSelect" />
                </label>
            </div>
        }
        else
        {
            @* Toolbar *@
            <div class="flex items-center justify-between border-b px-4 py-2">
                <div class="flex items-center gap-1">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs" Class="text-muted-foreground" OnClick="PrevPage" Disabled="@(_currentPage <= 1)" aria-label="Previous">
                        <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                    </ButtonCn>
                    <span class="tabular-nums text-xs text-muted-foreground">
                        @_currentPage / @_file.Pages
                    </span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs" Class="text-muted-foreground" OnClick="NextPage" Disabled="@(_currentPage  >= _file.Pages)" aria-label="Next page">
                        <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                    </ButtonCn>
                </div>
                <div class="flex items-center gap-1">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs" Class="text-muted-foreground" OnClick="ZoomOut" Disabled="@(_zoom <= 50)" aria-label="Zoom out">
                        <LucideIconCn Name="minus" Size="14" Class="size-3.5" />
                    </ButtonCn>
                    <span class="w-10 text-center tabular-nums text-xs text-muted-foreground">
                        @_zoom%
                    </span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs" Class="text-muted-foreground" OnClick="ZoomIn" Disabled="@(_zoom  >= 200)" aria-label="Zoom in">
                        <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    </ButtonCn>
                </div>
            </div>

            @* Page preview *@
            <div class="flex items-center justify-center border-b bg-muted/30 px-4 py-8">
                <div class="flex h-48 w-36 flex-col items-center justify-center rounded border bg-background shadow-sm">
                    <LucideIconCn Name="file-text" Size="32" Class="size-8 text-muted-foreground/40" />
                    <span class="mt-2 text-muted-foreground text-xs">Page @_currentPage</span>
                    <div class="mt-3 flex flex-col items-center gap-1 px-4 w-full">
                        <div class="h-1 w-full rounded-full bg-muted"></div>
                        <div class="h-1 w-full rounded-full bg-muted"></div>
                        <div class="h-1 w-3/4 rounded-full bg-muted"></div>
                        <div class="mt-1 h-1 w-full rounded-full bg-muted"></div>
                        <div class="h-1 w-5/6 rounded-full bg-muted"></div>
                    </div>
                </div>
            </div>

            @* Metadata *@
            <div class="px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">File details</span>
                <div class="mt-2 grid grid-cols-2 gap-x-4 gap-y-2">
                    <div>
                        <span class="text-muted-foreground text-xs">Size</span>
                        <p class="font-medium text-sm">@_file.Size</p>
                    </div>
                    <div>
                        <span class="text-muted-foreground text-xs">Pages</span>
                        <p class="font-medium text-sm">@_file.Pages</p>
                    </div>
                    <div>
                        <span class="text-muted-foreground text-xs">Author</span>
                        <p class="font-medium text-sm">@_file.Author</p>
                    </div>
                    <div>
                        <span class="text-muted-foreground text-xs">Created</span>
                        <p class="font-medium text-sm">@_file.Created</p>
                    </div>
                    <div>
                        <span class="text-muted-foreground text-xs">Dimensions</span>
                        <p class="font-medium text-sm">@_file.Dimensions</p>
                    </div>
                    <div>
                        <span class="text-muted-foreground text-xs">Version</span>
                        <p class="flex items-center gap-1.5 font-medium text-sm">
                            @_file.Version
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                Standard
                            </BadgeCn>
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private class PdfFile
    {
        public string Name { get; set; } = "";
        public string Size { get; set; } = "";
        public int Pages { get; set; }
        public string Author { get; set; } = "";
        public string Created { get; set; } = "";
        public string Dimensions { get; set; } = "";
        public string Version { get; set; } = "";
    }

    private static readonly PdfFile _samplePdf = new PdfFile
    {
        Name = "Q4-2025-Financial-Report.pdf",
        Size = "2.4 MB",
        Pages = 24,
        Author = "Sarah Chen",
        Created = "Dec 15, 2025",
        Dimensions = "8.5 x 11 in",
        Version = "PDF 1.7",
    };

    private PdfFile? _file = null;
    private int _currentPage = 1;
    private int _zoom = 100;
    private bool _isDragging = false;

    private void HandleUpload()
    {
        _file = _samplePdf;
        _currentPage = 1;
        _zoom = 100;
    }

    private void HandleFileSelect(ChangeEventArgs e)
    {
        HandleUpload();
    }

    private void HandleDragEnter(DragEventArgs e)
    {
        _isDragging = true;
    }

    private void HandleDragLeave(DragEventArgs e)
    {
        _isDragging = false;
    }

    private void HandleDrop(DragEventArgs e)
    {
        _isDragging = false;
        HandleUpload();
    }

    private void PrevPage()
    {
        if (_currentPage > 1)
            _currentPage--;
    }

    private void NextPage()
    {
        if (_file != null && _currentPage < _file.Pages)
            _currentPage++;
    }

    private void ZoomIn()
    {
        if (_zoom < 200)
            _zoom += 25;
    }

    private void ZoomOut()
    {
        if (_zoom > 50)
            _zoom -= 25;
    }
}
