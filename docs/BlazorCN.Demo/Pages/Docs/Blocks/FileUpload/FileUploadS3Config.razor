@* ============================================================
   Block: file-upload-s3-config
   Title: FileUploadS3Config
   Description: S3 and cloud storage configuration upload panel for React and Next.js with bucket name input, region selector, masked access key fields, path prefix, and test connection button using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-s3-config.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">S3 Storage Configuration</span>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Configure your S3-compatible storage bucket for file uploads
            </p>
        </div>

        @* Bucket and Region *@
        <div class="space-y-3 border-b px-4 py-3">
            <div class="space-y-1.5">
                <span class="font-medium text-muted-foreground text-xs">Bucket name</span>
                <InputCn aria-label="Bucket name" @bind-Value="_bucket" Placeholder="my-bucket" Class="h-8 font-mono text-sm" />
            </div>
            <div class="space-y-1.5">
                <span class="font-medium text-muted-foreground text-xs">Region</span>
                <SelectCn
                          Value="@_region"
                          ValueChanged="@((string v) => { _region = v; })">
                    <SelectTriggerCn Class="h-8 text-sm" aria-label="Region">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        @foreach (var r in _regions)
                        {
                            var regionItem = r;
                            <SelectItemCn Value="@regionItem.Value">@regionItem.Label</SelectItemCn>
                        }
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        @* Credentials *@
        <div class="space-y-3 border-b px-4 py-3">
            <div class="space-y-1.5">
                <span class="font-medium text-muted-foreground text-xs">Access key ID</span>
                <InputCn aria-label="Access key ID" @bind-Value="_accessKey" Placeholder="AKIAIOSFODNN7EXAMPLE" Class="h-8 font-mono text-sm" />
            </div>
            <div class="space-y-1.5">
                <span class="font-medium text-muted-foreground text-xs">Secret access key</span>
                <div class="flex items-center gap-1.5">
                    <InputCn aria-label="Secret access key" Type="@(_showSecret ? "text" : "password")" @bind-Value="_secretKey" Placeholder="@("wJalrXUtnFEMI/K7MDENG...")" Class="h-8 font-mono text-sm" />
                    <ButtonCn aria-label="Show or hide secret access key" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 w-8 shrink-0 p-0" OnClick="ToggleSecret">
                        @if (_showSecret)
                        {
                            <LucideIconCn Name="eye-off" Size="14" Class="size-3.5 text-muted-foreground" />
                        }
                        else
                        {
                            <LucideIconCn Name="eye" Size="14" Class="size-3.5 text-muted-foreground" />
                        }
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Path prefix *@
        <div class="space-y-1.5 border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Upload path prefix</span>
            <InputCn aria-label="Upload path prefix" @bind-Value="_pathPrefix" Placeholder="uploads/" Class="h-8 font-mono text-sm" />
            <p class="text-muted-foreground text-xs">
                Files will be stored at: s3://@(_bucket)/@(_pathPrefix)
            </p>
        </div>

        @* Connection test *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                @if (_connectionStatus == ConnectionStatus.Connected)
                {
                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                    <span class="text-sm text-emerald-600 dark:text-emerald-400">Connected</span>
                }
                @if (_connectionStatus == ConnectionStatus.Failed)
                {
                    <LucideIconCn Name="x-circle" Size="14" Class="size-3.5 text-red-600 dark:text-red-400" />
                    <span class="text-red-600 text-sm dark:text-red-400">Connection failed</span>
                }
                @if (_connectionStatus == ConnectionStatus.Testing)
                {
                    <LucideIconCn Name="loader-2" Size="14" Class="size-3.5 animate-spin text-muted-foreground" />
                    <span class="text-muted-foreground text-sm">Testing connection...</span>
                }
                @if (_connectionStatus == ConnectionStatus.Idle)
                {
                    <span class="text-muted-foreground text-xs">
                        Verify your credentials before uploading
                    </span>
                }
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="TestConnection" Disabled="@(_connectionStatus == ConnectionStatus.Testing)">
                Test connection
            </ButtonCn>
        </div>

        @* Upload action *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="min-w-0 flex-1">
                @if (_selectedFile != null)
                {
                    <span class="truncate font-mono text-sm">@_selectedFile</span>
                }
                else
                {
                    <span class="text-muted-foreground text-xs">No file selected</span>
                }
            </div>
            <div class="flex shrink-0 items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="ChooseFile">
                    Choose file
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" Disabled="@(_selectedFile == null || _connectionStatus != ConnectionStatus.Connected)">
                    <LucideIconCn Name="cloud-upload" Size="14" Class="size-3.5" />
                    Upload to S3
                </ButtonCn>
            </div>
            <input id="file-upload-s3-config-input" type="file" class="hidden" @onchange="OnFileChanged" />
        </div>
    </div>
</section>

@code {
    private enum ConnectionStatus { Idle, Testing, Connected, Failed }

    private record RegionOption(string Value, string Label);

    private static readonly RegionOption[] _regions =
    [
        new("us-east-1",      "US East (N. Virginia)"),
        new("us-west-2",      "US West (Oregon)"),
        new("eu-west-1",      "EU (Ireland)"),
        new("eu-central-1",   "EU (Frankfurt)"),
        new("ap-southeast-1", "Asia Pacific (Singapore)"),
        new("ap-northeast-1", "Asia Pacific (Tokyo)"),
    ];

    private string _bucket         = "acme-prod-assets";
    private string _region         = "us-east-1";
    private string _accessKey      = "AKIAIOSFODNN7EXAMPLE";
    private string _secretKey      = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY";
    private string _pathPrefix     = "uploads/2026/";
    private bool   _showSecret     = false;
    private ConnectionStatus _connectionStatus = ConnectionStatus.Idle;
    private string? _selectedFile  = null;

    private void ToggleSecret() => _showSecret = !_showSecret;

    private async Task TestConnection()
    {
        _connectionStatus = ConnectionStatus.Testing;
        await Task.Delay(1500);
        _connectionStatus = ConnectionStatus.Connected;
    }

    private void ChooseFile()
    {
        // Triggers the hidden file input — JS interop would be needed in a real app
    }

    private void OnFileChanged(ChangeEventArgs e)
    {
        _selectedFile = "example-file.pdf";
    }
}
