@* ============================================================
   Block: file-upload-ocr-extract
   Title: FileUploadOcrExtract
   Description: Upload an image or PDF for OCR text extraction with editable output, confidence percentage, copy button, word count, and language detection badge using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-ocr-extract.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="scan-text" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">OCR Text Extraction</span>
            </div>
            @if (_state == "complete")
            {
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" OnClick="Reset">
                    Reset
                </ButtonCn>
            }
        </div>

        @* Upload area *@
        @if (_state == "idle")
        {
            <div class="border-b px-4 py-4">
                <div
                    role="button"
                    tabindex="0"
                    @onclick="TriggerUpload"
                    @onkeydown="HandleKeyDown"
                    class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-md border-2 border-dashed border-muted-foreground/20 px-6 py-10 transition-colors hover:border-muted-foreground/40 hover:bg-muted/30">
                    <LucideIconCn Name="cloud-upload" Size="32" Class="size-8 text-muted-foreground/60" />
                    <span class="font-medium text-sm">Upload image or PDF</span>
                    <p class="text-muted-foreground text-xs">PNG, JPG, TIFF, or PDF up to 20 MB</p>
                </div>
            </div>
        }

        @* Processing state *@
        @if (_state == "processing")
        {
            <div class="border-b px-4 py-6">
                <div class="flex flex-col items-center gap-2">
                    <LucideIconCn Name="loader-circle" Size="24" Class="size-6 animate-spin text-muted-foreground" />
                    <span class="font-medium text-sm">Extracting text...</span>
                    <span class="text-muted-foreground text-xs">
                        @_fileName &middot; @_fileSize
                    </span>
                </div>
            </div>
        }

        @* File info + stats when complete *@
        @if (_state == "complete")
        {
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <LucideIconCn Name="file-text" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                <div class="min-w-0 flex-1">
                    <span class="block truncate font-medium text-sm">@_fileName</span>
                    <span class="text-muted-foreground text-xs">@_fileSize</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_language
                </BadgeCn>
            </div>

            @* Stats bar *@
            <div class="flex items-center gap-4 border-b px-4 py-2.5">
                <div class="flex items-center gap-1.5">
                    <span class="text-muted-foreground text-xs">Confidence</span>
                    <span class="font-medium tabular-nums text-emerald-600 text-xs dark:text-emerald-400">
                        @_confidence%
                    </span>
                </div>
                <span class="text-muted-foreground text-xs">&middot;</span>
                <span class="text-muted-foreground text-xs">@WordCount words</span>
                <div class="ml-auto">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs" OnClick="CopyText">
                        @if (_copied)
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                            <span>Copied</span>
                        }
                        else
                        {
                            <LucideIconCn Name="copy" Size="12" Class="size-3" />
                            <span>Copy</span>
                        }
                    </ButtonCn>
                </div>
            </div>

            @* Extracted text *@
            <div class="p-4">
                <TextareaCn
                    aria-label="Extracted text"
                    @bind-Value="_extractedText"
                    Class="min-h-[280px] resize-y border-0 bg-muted/30 font-mono text-sm shadow-none focus-visible:ring-0" />
            </div>
        }

        @* Empty state *@
        @if (_state == "idle")
        {
            <div class="px-4 py-5 text-center">
                <span class="text-muted-foreground text-xs">
                    Upload an image or PDF to extract text with OCR
                </span>
            </div>
        }
    </div>
</section>

@code {
    private const string SampleText =
        "QUARTERLY BUSINESS REVIEW\n\n" +
        "Prepared for: Acme Corporation\n" +
        "Date: January 15, 2025\n" +
        "Author: Sarah Chen, VP of Operations\n\n" +
        "Executive Summary\n\n" +
        "Revenue for Q4 2024 reached $4.2M, representing a 23% increase over the prior quarter. Customer acquisition cost decreased by 12% to $142 per customer, while lifetime value increased to $2,840. Net promoter score improved from 62 to 71.\n\n" +
        "Key Metrics\n\n" +
        "Total Revenue: $4,200,000\n" +
        "Monthly Recurring Revenue: $3,100,000\n" +
        "Customer Count: 1,847 (up from 1,523)\n" +
        "Churn Rate: 2.1% (down from 3.4%)\n" +
        "Average Contract Value: $18,200\n\n" +
        "Regional Performance\n\n" +
        "North America contributed 64% of total revenue, followed by Europe at 22% and Asia-Pacific at 14%. The APAC region showed the strongest growth at 41% quarter-over-quarter, driven by expansion in Japan and Australia.\n\n" +
        "Recommendations\n\n" +
        "1. Increase investment in APAC sales team by 2 headcount\n" +
        "2. Launch enterprise tier pricing for contracts above $50K\n" +
        "3. Implement automated onboarding to reduce time-to-value\n" +
        "4. Expand partner channel program to 15 certified partners";

    private string _state = "idle";
    private string _fileName = "";
    private string _fileSize = "";
    private string _extractedText = "";
    private bool _copied = false;

    private const double _confidence = 96.4;
    private const string _language = "English";

    private int WordCount => string.IsNullOrWhiteSpace(_extractedText)
        ? 0
        : _extractedText.Trim().Split((char[])null!, StringSplitOptions.RemoveEmptyEntries).Length;

    private void TriggerUpload()
    {
        HandleFile("quarterly-business-review.pdf", "184.3 KB");
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            TriggerUpload();
        }
    }

    private void HandleFile(string name, string size)
    {
        _fileName = name;
        _fileSize = size;
        _state = "processing";
        _copied = false;
        // Presentational demo: jump straight to complete.
        _extractedText = SampleText;
        _state = "complete";
    }

    private void CopyText()
    {
        // In a presentational demo we toggle the copied state visually;
        // actual clipboard write requires JS interop which is out of scope here.
        _copied = true;
    }

    private void Reset()
    {
        _state = "idle";
        _fileName = "";
        _fileSize = "";
        _extractedText = "";
        _copied = false;
    }
}
