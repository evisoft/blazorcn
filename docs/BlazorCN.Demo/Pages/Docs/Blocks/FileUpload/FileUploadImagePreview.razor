@* ============================================================
   Block: file-upload-image-preview
   Title: FileUploadImagePreview
   Description: Image upload block for React and Next.js with thumbnail grid previews, hover remove overlay, and file count limit using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-image-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Images</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_images.Count of @MaxFiles images uploaded
                </p>
            </div>
            <span class="text-muted-foreground text-xs">JPG, PNG, WebP</span>
        </div>

        @* Image grid *@
        <div class="border-b px-4 py-4">
            <div class="grid grid-cols-4 gap-2">
                @foreach (var img in _images)
                {
                    var image = img;
                    var isHovered = _hoveredId == image.Id;
                    <div
                        class="group relative aspect-square overflow-hidden rounded-md bg-muted/50"
                        @onmouseenter="@(() => _hoveredId = image.Id)"
                        @onmouseleave="@(() => _hoveredId = null)">
                        <div class="flex size-full items-center justify-center">
                            <LucideIconCn Name="image" Size="24" Class="size-6 text-muted-foreground/40" />
                        </div>

                        @* Hover overlay *@
                        @if (isHovered)
                        {
                            <div class="absolute inset-0 flex items-center justify-center bg-black/50">
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs"
                                    Class="text-white hover:bg-white/20 hover:text-white"
                                    OnClick="@(() => RemoveImage(image.Id))">
                                    <LucideIconCn Name="x" Size="16" Class="size-4" />
                                </ButtonCn>
                            </div>
                        }

                        @* File name tooltip *@
                        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent px-1.5 pb-1 pt-4">
                            <span class="block truncate text-white text-[10px]">@image.Name</span>
                        </div>
                    </div>
                }

                @* Add more button *@
                @if (_canAddMore)
                {
                    <div
                        role="button"
                        tabindex="0"
                        class="flex aspect-square cursor-pointer flex-col items-center justify-center gap-1 rounded-md border-2 border-dashed border-muted-foreground/20 transition-colors hover:border-muted-foreground/40 hover:bg-muted/30">
                        <LucideIconCn Name="plus" Size="20" Class="size-5 text-muted-foreground/50" />
                        <span class="text-muted-foreground text-[10px]">Add</span>
                    </div>
                }
            </div>
            <input type="file" accept="image/*" multiple class="hidden" />
        </div>

        @* Footer summary *@
        <div class="flex items-center justify-between px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @if (_canAddMore)
                {
                    var remaining = MaxFiles - _images.Count;
                    @($"{remaining} more {(remaining == 1 ? "slot" : "slots")} available")
                }
                else
                {
                    @("Maximum images reached")
                }
            </span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Upload all
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private const int MaxFiles = 8;

    private class UploadedImage
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Size { get; set; } = "";
    }

    private List<UploadedImage> _images =
    [
        new UploadedImage { Id = "1", Name = "hero-banner.jpg",     Size = "2.1 MB" },
        new UploadedImage { Id = "2", Name = "product-shot.png",    Size = "1.4 MB" },
        new UploadedImage { Id = "3", Name = "team-photo.jpg",      Size = "3.8 MB" },
        new UploadedImage { Id = "4", Name = "office-interior.png", Size = "2.7 MB" },
    ];

    private string? _hoveredId = null;

    private bool _canAddMore => _images.Count < MaxFiles;

    private void RemoveImage(string id)
    {
        _images.RemoveAll(img => img.Id == id);
    }
}
