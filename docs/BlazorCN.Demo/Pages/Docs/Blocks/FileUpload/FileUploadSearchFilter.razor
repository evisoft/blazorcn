@* ============================================================
   Block: file-upload-search-filter
   Title: FileUploadSearchFilter
   Description: A React file search and filter block with text search input, type dropdown filter, date range filter, size range filter, owner filter, active filter badges with remove buttons, and results count using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-search-filter.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Search header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="search" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
            <InputCn aria-label="Search files" @bind-Value="_query"
                     Placeholder="Search files..."
                     Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
            @if (!string.IsNullOrEmpty(_query))
            {
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 shrink-0 p-0" aria-label="Clear search" @onclick="@(() => ClearFilter("query"))">
                    <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                </ButtonCn>
            }
        </div>

        @* Filter row *@
        <div class="flex flex-wrap items-center gap-2 border-b px-4 py-2.5">
            <span class="font-medium text-muted-foreground text-xs">Filters</span>

            <SelectCn Value="_filterType" ValueChanged="@((string v) => UpdateFilter("type", v))">
                <SelectTriggerCn class="h-7 w-[120px] text-xs" aria-label="Filter by type">
                    <SelectValueCn Placeholder="Type" />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value="all" class="text-xs">All types</SelectItemCn>
                    <SelectItemCn Value="pdf" class="text-xs">PDF</SelectItemCn>
                    <SelectItemCn Value="image" class="text-xs">Image</SelectItemCn>
                    <SelectItemCn Value="spreadsheet" class="text-xs">Spreadsheet</SelectItemCn>
                    <SelectItemCn Value="document" class="text-xs">Document</SelectItemCn>
                </SelectContentCn>
            </SelectCn>

            <SelectCn Value="_filterDateRange" ValueChanged="@((string v) => UpdateFilter("dateRange", v))">
                <SelectTriggerCn class="h-7 w-[120px] text-xs" aria-label="Filter by date range">
                    <SelectValueCn Placeholder="Date" />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value="all" class="text-xs">Any time</SelectItemCn>
                    <SelectItemCn Value="7d" class="text-xs">Last 7 days</SelectItemCn>
                    <SelectItemCn Value="30d" class="text-xs">Last 30 days</SelectItemCn>
                    <SelectItemCn Value="90d" class="text-xs">Last 90 days</SelectItemCn>
                </SelectContentCn>
            </SelectCn>

            <SelectCn Value="_filterSizeRange" ValueChanged="@((string v) => UpdateFilter("sizeRange", v))">
                <SelectTriggerCn class="h-7 w-[120px] text-xs" aria-label="Filter by size">
                    <SelectValueCn Placeholder="Size" />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value="all" class="text-xs">Any size</SelectItemCn>
                    <SelectItemCn Value="small" class="text-xs">Under 1 MB</SelectItemCn>
                    <SelectItemCn Value="medium" class="text-xs">1-5 MB</SelectItemCn>
                    <SelectItemCn Value="large" class="text-xs">Over 5 MB</SelectItemCn>
                </SelectContentCn>
            </SelectCn>

            <SelectCn Value="_filterOwner" ValueChanged="@((string v) => UpdateFilter("owner", v))">
                <SelectTriggerCn class="h-7 w-[120px] text-xs" aria-label="Filter by owner">
                    <SelectValueCn Placeholder="Owner" />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value="all" class="text-xs">All owners</SelectItemCn>
                    @foreach (var owner in _owners)
                    {
                        var ownerVal = owner;
                        <SelectItemCn Value="@ownerVal" class="text-xs">@ownerVal</SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Active filter badges *@
        @{ var activeFilters = GetActiveFilters(); }
        @if (activeFilters.Count > 0)
        {
            <div class="flex flex-wrap items-center gap-1.5 border-b px-4 py-2.5">
                @foreach (var filter in activeFilters)
                {
                    var filterKey = filter.Key;
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 pr-1 font-normal text-xs">
                        @filter.Label
                        <button type="button"
                                @onclick="@(() => ClearFilter(filterKey))"
                                aria-label="@($"Clear {filter.Label} filter")"
                                class="ml-0.5 rounded-full p-0.5 transition-colors hover:bg-muted">
                            <LucideIconCn Name="x" Size="10" Class="size-2.5" />
                        </button>
                    </BadgeCn>
                }
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-5 px-1.5 text-xs" @onclick="ClearAll">
                    Clear all
                </ButtonCn>
            </div>
        }

        @* Results count *@
        @{ var filtered = GetFiltered(); }
        <div class="border-b px-4 py-2">
            <span class="text-muted-foreground text-xs">
                @filtered.Count result@(filtered.Count != 1 ? "s" : "")@(activeFilters.Count > 0 ? $" matching {activeFilters.Count} filter{(activeFilters.Count != 1 ? "s" : "")}" : "")
            </span>
        </div>

        @* Results list *@
        <div>
            @for (int i = 0; i < filtered.Count; i++)
            {
                var file = filtered[i];
                var isLast = i == filtered.Count - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <LucideIconCn Name="@GetTypeIcon(file.Type)" Size="16" Class="size-4 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <span class="truncate font-medium text-sm">@file.Name</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            @file.Owner · @file.Modified
                        </p>
                    </div>
                    <span class="shrink-0 text-muted-foreground text-xs tabular-nums">@file.Size</span>
                </div>
            }

            @if (filtered.Count == 0)
            {
                <div class="flex flex-col items-center px-4 py-10">
                    <LucideIconCn Name="search" Size="32" Class="mb-2 size-8 text-muted-foreground/60" />
                    <span class="font-medium text-sm">No files found</span>
                    <span class="mt-1 text-muted-foreground text-xs">Try adjusting your search or filters</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record FileEntry(string Id, string Name, string Type, string Size, int SizeKB, string Modified, int ModifiedDays, string Owner);
    private record ActiveFilter(string Key, string Label);

    private static readonly FileEntry[] _allFiles =
    [
        new("f1",  "Q4 Financial Report.pdf",   "pdf",         "2.4 MB", 2458, "Mar 22, 2026",  4,  "Alice Chen"),
        new("f2",  "Product Screenshot.png",    "image",       "4.1 MB", 4198, "Mar 20, 2026",  6,  "Bob Martinez"),
        new("f3",  "Revenue Forecast.xlsx",     "spreadsheet", "890 KB",  890, "Mar 18, 2026",  8,  "Carol Wu"),
        new("f4",  "API Documentation.pdf",     "pdf",         "1.8 MB", 1843, "Mar 15, 2026", 11,  "David Kim"),
        new("f5",  "Dashboard Mockup.png",      "image",       "3.6 MB", 3686, "Mar 12, 2026", 14,  "Alice Chen"),
        new("f6",  "Meeting Notes.docx",        "document",    "245 KB",  245, "Mar 10, 2026", 16,  "Eve Johnson"),
        new("f7",  "Onboarding Guide.pdf",      "pdf",         "520 KB",  520, "Mar 5, 2026",  21,  "Frank Liu"),
        new("f8",  "Team Roster.xlsx",          "spreadsheet", "340 KB",  340, "Feb 28, 2026", 26,  "Carol Wu"),
        new("f9",  "Logo Pack.png",             "image",       "8.2 MB", 8397, "Feb 20, 2026", 34,  "Bob Martinez"),
        new("f10", "Release Notes v3.pdf",      "pdf",         "180 KB",  180, "Feb 15, 2026", 39,  "David Kim"),
        new("f11", "Expense Report.xlsx",       "spreadsheet", "445 KB",  445, "Feb 10, 2026", 44,  "Grace Park"),
        new("f12", "Brand Guidelines.pdf",      "pdf",         "5.6 MB", 5734, "Jan 30, 2026", 55,  "Alice Chen"),
    ];

    private static readonly string[] _owners =
    [
        "Alice Chen", "Bob Martinez", "Carol Wu", "David Kim",
        "Eve Johnson", "Frank Liu", "Grace Park",
    ];

    private string _query = "";
    private string _filterType = "all";
    private string _filterDateRange = "all";
    private string _filterSizeRange = "all";
    private string _filterOwner = "all";

    private void UpdateFilter(string key, string value)
    {
        switch (key)
        {
            case "type":      _filterType      = value; break;
            case "dateRange": _filterDateRange = value; break;
            case "sizeRange": _filterSizeRange = value; break;
            case "owner":     _filterOwner     = value; break;
        }
    }

    private void ClearFilter(string key)
    {
        switch (key)
        {
            case "query":     _query           = "";    break;
            case "type":      _filterType      = "all"; break;
            case "dateRange": _filterDateRange = "all"; break;
            case "sizeRange": _filterSizeRange = "all"; break;
            case "owner":     _filterOwner     = "all"; break;
        }
    }

    private void ClearAll()
    {
        _query           = "";
        _filterType      = "all";
        _filterDateRange = "all";
        _filterSizeRange = "all";
        _filterOwner     = "all";
    }

    private List<FileEntry> GetFiltered()
    {
        var results = new List<FileEntry>();
        foreach (var file in _allFiles)
        {
            if (!string.IsNullOrEmpty(_query) && !file.Name.ToLower().Contains(_query.ToLower()))
                continue;
            if (_filterType != "all" && file.Type != _filterType)
                continue;
            if (_filterOwner != "all" && file.Owner != _filterOwner)
                continue;
            if (_filterDateRange == "7d"  && file.ModifiedDays > 7)  continue;
            if (_filterDateRange == "30d" && file.ModifiedDays > 30) continue;
            if (_filterDateRange == "90d" && file.ModifiedDays > 90) continue;
            if (_filterSizeRange == "small"  && file.SizeKB > 1024)                          continue;
            if (_filterSizeRange == "medium" && (file.SizeKB <= 1024 || file.SizeKB > 5120)) continue;
            if (_filterSizeRange == "large"  && file.SizeKB <= 5120)                         continue;
            results.Add(file);
        }
        return results;
    }

    private List<ActiveFilter> GetActiveFilters()
    {
        var active = new List<ActiveFilter>();
        if (!string.IsNullOrEmpty(_query))
            active.Add(new ActiveFilter("query", $"\"{_query}\""));
        if (_filterType != "all")
            active.Add(new ActiveFilter("type", _filterType switch
            {
                "pdf"         => "PDF",
                "image"       => "Image",
                "spreadsheet" => "Spreadsheet",
                _             => "Document",
            }));
        if (_filterDateRange != "all")
            active.Add(new ActiveFilter("dateRange", _filterDateRange switch
            {
                "7d"  => "Last 7 days",
                "30d" => "Last 30 days",
                _     => "Last 90 days",
            }));
        if (_filterSizeRange != "all")
            active.Add(new ActiveFilter("sizeRange", _filterSizeRange switch
            {
                "small"  => "Under 1 MB",
                "medium" => "1-5 MB",
                _        => "Over 5 MB",
            }));
        if (_filterOwner != "all")
            active.Add(new ActiveFilter("owner", _filterOwner));
        return active;
    }

    private static string GetTypeIcon(string type) => type switch
    {
        "pdf"         => "file-text",
        "image"       => "image",
        "spreadsheet" => "file-spreadsheet",
        _             => "file",
    };
}
