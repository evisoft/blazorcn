@* ============================================================
   Block: file-upload-annotation
   Title: FileUploadAnnotation
   Description: Image upload with annotation tools for React and Next.js with clickable hotspot markers, numbered pins, note editor, and export button using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-annotation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Image annotations</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Click on the image to add annotation pins
                </p>
            </div>
            <ButtonCn
                Variant="ButtonVariant.Outline"
                Size="ButtonSize.Sm"
                Class="h-7 gap-1.5 text-xs"
                OnClick="ExportAnnotations">
                @if (_copied)
                {
                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                    @("Copied")
                }
                else
                {
                    <LucideIconCn Name="download" Size="12" Class="size-3" />
                    @("Export")
                }
            </ButtonCn>
        </div>

        @* Image canvas with pins *@
        <div class="border-b px-4 py-4">
            <div
                role="button"
                tabindex="0"
                @onclick="HandleCanvasClick"
                class="relative h-[320px] cursor-crosshair rounded-md bg-muted/50">
                @* Placeholder image indicator *@
                <div class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center gap-2 text-muted-foreground/40">
                    <LucideIconCn Name="image" Size="40" Class="size-10" />
                    <span class="text-xs">hero-banner-v3.png</span>
                    <span class="text-xs">1920 x 1080</span>
                </div>

                @* Annotation pins *@
                @foreach (var pin in _annotations)
                {
                    var p = pin;
                    <button
                        type="button"
                        @onclick:stopPropagation="true"
                        @onclick="@(() => SelectPin(p.Id, p.Note))"
                        class="@Cn.Merge("absolute flex size-6 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full text-xs font-medium transition-all", _selectedId == p.Id ? "bg-foreground text-background scale-110" : "bg-foreground/80 text-background hover:bg-foreground hover:scale-110")"
                        style="@($"left:{p.X.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%;top:{p.Y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%")">
                        @p.Number
                    </button>
                }
            </div>
        </div>

        @* Note editor for selected pin *@
        @if (_selectedId != null)
        {
            var selPin = _annotations.FirstOrDefault(a => a.Id == _selectedId);
            if (selPin != null)
            {
                <div class="border-b px-4 py-3">
                    <div class="flex items-center gap-2">
                        <div class="flex size-5 shrink-0 items-center justify-center rounded-full bg-foreground text-xs font-medium text-background">
                            @selPin.Number
                        </div>
                        <InputCn
                            @bind-Value="_editNote"
                            Placeholder="Add a note for this pin..."
                            Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
                        <ButtonCn
                            Variant="ButtonVariant.Outline"
                            Size="ButtonSize.Sm"
                            Class="h-7 shrink-0 text-xs"
                            OnClick="@(() => UpdateNote(_selectedId))">
                            Save
                        </ButtonCn>
                    </div>
                </div>
            }
        }

        @* Annotations list *@
        @if (_annotations.Count > 0)
        {
            <div>
                <div class="border-b px-4 py-2">
                    <span class="text-muted-foreground text-xs">
                        @_annotations.Count @(_annotations.Count == 1 ? "annotation" : "annotations")
                    </span>
                </div>
                @for (int i = 0; i < _annotations.Count; i++)
                {
                    var pin = _annotations[i];
                    var isLast = i == _annotations.Count - 1;
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                        <div class="flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                            @pin.Number
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="block truncate text-sm">
                                @if (string.IsNullOrEmpty(pin.Note))
                                {
                                    <span class="text-muted-foreground italic">No note</span>
                                }
                                else
                                {
                                    @pin.Note
                                }
                            </span>
                            <span class="font-mono text-muted-foreground text-xs">
                                (@(pin.X.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%, @(pin.Y.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%)
                            </span>
                        </div>
                        <ButtonCn
                            Variant="ButtonVariant.Ghost"
                            Size="ButtonSize.Sm"
                            Class="h-6 shrink-0 px-2 text-muted-foreground hover:text-foreground"
                            OnClick="@(() => RemoveAnnotation(pin.Id))">
                            <LucideIconCn Name="trash" Size="12" Class="size-3" />
                        </ButtonCn>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="px-4 py-6 text-center">
                <span class="text-muted-foreground text-xs">
                    Click on the image to add your first annotation
                </span>
            </div>
        }
    </div>
</section>

@code {
    private record Annotation(string Id, int Number, double X, double Y, string Note)
    {
        public string Note { get; set; } = Note;
    }

    private List<Annotation> _annotations =
    [
        new("a1", 1, 25, 18, "Logo alignment is off by 4px on retina displays"),
        new("a2", 2, 62, 42, "Replace placeholder with product screenshot"),
        new("a3", 3, 40, 75, "CTA button needs higher contrast ratio"),
    ];

    private string? _selectedId = null;
    private string _editNote = "";
    private bool _copied = false;

    private void HandleCanvasClick(MouseEventArgs e)
    {
        // Without a JS interop bounding-rect call, we can't compute exact % coords from MouseEventArgs.
        // We use ClientX/ClientY as a best-effort approximation (falls back gracefully in SSR/prerender).
        // A full implementation would use JS interop to get the element's bounding rect.
        var newId = $"a{_annotations.Count + 1}-{(int)e.ClientX}";
        var newPin = new Annotation(newId, _annotations.Count + 1, 50, 50, "");
        _annotations.Add(newPin);
        _selectedId = newPin.Id;
        _editNote = "";
    }

    private void SelectPin(string id, string note)
    {
        if (_selectedId == id)
        {
            _selectedId = null;
        }
        else
        {
            _selectedId = id;
            _editNote = note;
        }
    }

    private void UpdateNote(string id)
    {
        var pin = _annotations.FirstOrDefault(a => a.Id == id);
        if (pin != null)
        {
            pin.Note = _editNote;
        }
        _selectedId = null;
    }

    private void RemoveAnnotation(string id)
    {
        _annotations.RemoveAll(a => a.Id == id);
        // Renumber
        for (int i = 0; i < _annotations.Count; i++)
        {
            var old = _annotations[i];
            _annotations[i] = old with { Number = i + 1 };
        }
        if (_selectedId == id) _selectedId = null;
    }

    private async Task ExportAnnotations()
    {
        // clipboard.writeText is not available in server-side Blazor without JS interop;
        // we toggle the copied indicator as a visual affordance.
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }
}
