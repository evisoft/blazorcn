@* ============================================================
   Block: file-upload-spreadsheet-preview
   Title: FileUploadSpreadsheetPreview
   Description: A spreadsheet upload block for React and Next.js with tabular data preview of first rows and columns, multi-sheet tab selector, row and column counts, and automatic data type detection per column using shadcn/ui Button, Badge, and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-spreadsheet-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="file-spreadsheet" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">quarterly-report.xlsx</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                1.8 MB
            </BadgeCn>
            <div class="ml-auto">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="upload" Size="12" Class="size-3" />
                    Replace
                </ButtonCn>
            </div>
        </div>

        @* Sheet tabs *@
        <div class="flex border-b">
            @foreach (var s in _sheets)
            {
                var sheet = s;
                var isActive = _activeSheet == sheet.Id;
                <button
                    type="button"
                    @onclick="@(() => _activeSheet = sheet.Id)"
                    class="@Cn.Merge("px-4 py-2.5 text-xs transition-colors", isActive ? "border-b-2 border-foreground font-medium text-foreground" : "text-muted-foreground hover:text-foreground")">
                    @sheet.Name
                </button>
            }
        </div>

        @{
            var activeSheet = _sheets.First(s => s.Id == _activeSheet);
        }

        @* Stats *@
        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <span class="text-muted-foreground text-xs">@activeSheet.Rows.ToString("N0") rows</span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">@activeSheet.Columns.Length columns</span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">Preview: first 5 rows</span>
        </div>

        @* Column types *@
        <div class="flex flex-wrap gap-2 border-b px-4 py-2.5">
            @foreach (var col in activeSheet.Columns)
            {
                var c = col;
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <LucideIconCn Name="@GetTypeIcon(c.Type)" Size="12" Class="size-3" />
                    <span class="font-medium text-foreground">@c.Name</span>
                    <span>(@GetTypeLabel(c.Type))</span>
                </span>
            }
        </div>

        @* Data preview table *@
        <div class="overflow-x-auto">
            <table class="w-full text-xs">
                <thead>
                    <tr class="border-b bg-muted/30">
                        <th class="px-4 py-2 text-left font-medium text-muted-foreground">#</th>
                        @foreach (var col in activeSheet.Columns)
                        {
                            var c = col;
                            <th class="px-4 py-2 text-left font-medium text-muted-foreground">@c.Name</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (int rowIndex = 0; rowIndex < activeSheet.Data.Length; rowIndex++)
                    {
                        var row = activeSheet.Data[rowIndex];
                        var ri = rowIndex;
                        <tr class="@(ri < activeSheet.Data.Length - 1 ? "border-b" : "")">
                            <td class="px-4 py-2 font-mono text-muted-foreground tabular-nums">@(ri + 1)</td>
                            @for (int colIndex = 0; colIndex < row.Length; colIndex++)
                            {
                                var cell = row[colIndex];
                                var ci = colIndex;
                                <td class="@Cn.Merge("px-4 py-2", activeSheet.Columns[ci].Type == "number" ? "font-mono tabular-nums" : "")">@cell</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @((activeSheet.Rows - 5).ToString("N0")) more rows not shown
            </span>
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                Import Data
            </ButtonCn>
        </div>
    </div>
</section>

@code {
