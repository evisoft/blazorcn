@* ============================================================
   Block: file-upload-cloud-storage
   Title: FileUploadCloudStorage
   Description: A cloud storage file import component with tabs for Google Drive, Dropbox, and OneDrive, each showing a simulated file browser with folders and files, selection checkboxes, and an import button built with React, shadcn/ui, and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-cloud-storage.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="cloud" Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <p class="font-medium text-sm">Import from cloud</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Browse and select files from your cloud storage
                    </p>
                </div>
            </div>
            @if (_totalSelected > 0)
            {
                <span class="text-muted-foreground text-xs">@_totalSelected selected</span>
            }
        </div>

        @* Tabs *@
        <TabsCn Value="@_activeTab" ValueChanged="@((v) => { _activeTab = v ?? "google-drive"; })">
            <div class="border-b px-4 pt-2">
                <TabsListCn Variant="TabsListVariant.Line" Class="h-8">
                    <TabsTriggerCn Value="google-drive" Class="text-xs">
                        Google Drive
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="dropbox" Class="text-xs">
                        Dropbox
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="onedrive" Class="text-xs">
                        OneDrive
                    </TabsTriggerCn>
                </TabsListCn>
            </div>

            @* File browser *@
            @foreach (var providerKey in _providers)
            {
                var provider = providerKey;
                var files = _cloudFiles[provider];
                <TabsContentCn Value="@provider" Class="mt-0">
                    <div>
                        @for (var i = 0; i < files.Length; i++)
                        {
                            var file = files[i];
                            var isLast = i == files.Length - 1;
                            var isSelected = _selected.Contains(file.Id);
                            var fileId = file.Id;
                            <label for="@($"cloud-storage-{fileId}")"
                                   class="@Cn.Merge("flex cursor-pointer items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b", isSelected ? "bg-muted/30" : "")">
                                <CheckboxCn Id="@($"cloud-storage-{fileId}")" Checked="@isSelected" CheckedChanged="@((v) => ToggleSelection(fileId))" aria-label="@($"Select {file.Name}")" Class="size-3.5" />
                                @GetFileIconMarkup(file.FileType)
                                <div class="min-w-0 flex-1">
                                    <span class="truncate font-medium text-sm">@file.Name</span>
                                </div>
                                <div class="flex items-center gap-3 text-muted-foreground text-xs">
                                    @if (file.Size != null)
                                    {
                                        <span class="font-mono">@file.Size</span>
                                    }
                                    <span class="w-12 text-right">@file.Modified</span>
                                </div>
                            </label>
                        }
                    </div>
                </TabsContentCn>
            }
        </TabsCn>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <p class="text-muted-foreground text-xs">
                @if (_totalSelected > 0)
                {
                    @($"{_totalSelected} file{(_totalSelected != 1 ? "s" : "")} ready to import")
                }
                else
                {
                    <text>Select files to import</text>
                }
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" Disabled="@(_totalSelected == 0)">
                @if (_totalSelected > 0)
                {
                    @($"Import {_totalSelected} file{(_totalSelected != 1 ? "s" : "")}")
                }
                else
                {
                    <text>Import</text>
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record CloudFile(string Id, string Name, string FileType, string? Size, string Modified);

    private static readonly string[] _providers = ["google-drive", "dropbox", "onedrive"];

    private static readonly Dictionary<string, CloudFile[]> _cloudFiles = new()
    {
        ["google-drive"] =
        [
            new("gd-1", "Design Assets",           "folder",       null,      "Mar 18"),
            new("gd-2", "Q1 Marketing Plan.docx",  "document",     "2.4 MB",  "Mar 20"),
            new("gd-3", "Revenue Forecast.xlsx",   "spreadsheet",  "1.8 MB",  "Mar 15"),
            new("gd-4", "Product Roadmap.pptx",    "presentation", "8.2 MB",  "Mar 12"),
            new("gd-5", "Brand Guidelines.pdf",    "file",         "14.6 MB", "Feb 28"),
            new("gd-6", "Team Photos",             "folder",       null,      "Mar 10"),
            new("gd-7", "hero-banner.png",         "image",        "3.1 MB",  "Mar 22"),
        ],
        ["dropbox"] =
        [
            new("db-1", "Client Deliverables",     "folder",       null,      "Mar 21"),
            new("db-2", "Invoice-March-2026.pdf",  "file",         "0.4 MB",  "Mar 19"),
            new("db-3", "Project Specs",           "folder",       null,      "Mar 14"),
            new("db-4", "wireframe-v3.png",        "image",        "2.7 MB",  "Mar 17"),
            new("db-5", "Meeting Notes.docx",      "document",     "0.8 MB",  "Mar 22"),
            new("db-6", "Budget Tracker.xlsx",     "spreadsheet",  "1.2 MB",  "Mar 11"),
        ],
        ["onedrive"] =
        [
            new("od-1", "Shared Documents",        "folder",       null,      "Mar 23"),
            new("od-2", "Employee Handbook.docx",  "document",     "5.1 MB",  "Mar 16"),
            new("od-3", "Expense Report.xlsx",     "spreadsheet",  "0.9 MB",  "Mar 20"),
            new("od-4", "Onboarding Assets",       "folder",       null,      "Mar 8"),
            new("od-5", "Company Pitch.pptx",      "presentation", "12.3 MB", "Mar 13"),
            new("od-6", "profile-photo.jpg",       "image",        "1.4 MB",  "Mar 22"),
            new("od-7", "NDA-Template.pdf",        "file",         "0.3 MB",  "Feb 25"),
        ],
    };

    private HashSet<string> _selected = ["gd-2", "gd-7"];
    private string _activeTab = "google-drive";

    private int _totalSelected => _selected.Count;

    private void ToggleSelection(string id)
    {
        if (_selected.Contains(id))
            _selected.Remove(id);
        else
            _selected.Add(id);
    }

    private RenderFragment GetFileIconMarkup(string fileType) => fileType switch
    {
        "folder"       => @<LucideIconCn Name="folder"           Size="16" Class="size-4 text-muted-foreground" />,
        "document"     => @<LucideIconCn Name="file-text"        Size="16" Class="size-4 text-muted-foreground/60" />,
        "spreadsheet"  => @<LucideIconCn Name="file-spreadsheet" Size="16" Class="size-4 text-muted-foreground/60" />,
        "presentation" => @<LucideIconCn Name="presentation"     Size="16" Class="size-4 text-muted-foreground/60" />,
        "image"        => @<LucideIconCn Name="image"            Size="16" Class="size-4 text-muted-foreground/60" />,
        _              => @<LucideIconCn Name="file"             Size="16" Class="size-4 text-muted-foreground/60" />,
    };
}
