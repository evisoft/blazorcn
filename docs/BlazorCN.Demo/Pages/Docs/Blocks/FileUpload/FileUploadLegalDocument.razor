@* ============================================================
   Block: file-upload-legal-document
   Title: FileUploadLegalDocument
   Description: A legal document upload block for React and Next.js with document type classification selector, parties involved fields, effective date input, confidentiality level badge with public, internal, confidential, and privileged tiers, and attorney review checkbox using shadcn/ui Button, Badge, Input, Checkbox, and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-legal-document.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="scale" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Legal Document</span>
            <div class="ml-auto flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("gap-1 font-normal text-xs", ConfidentialityStyle(_confidentiality))">
                    <LucideIconCn Name="lock" Size="12" Class="size-3" />
                    @ConfidentialityLabel(_confidentiality)
                </BadgeCn>
            </div>
        </div>

        @if (!_uploaded)
        {
            <div class="flex flex-col items-center px-4 py-10">
                <LucideIconCn Name="upload" Size="32" Class="mb-3 size-8 text-muted-foreground" />
                <span class="font-medium text-sm">Upload a legal document</span>
                <span class="mt-1 text-muted-foreground text-xs">PDF or DOCX up to 25 MB</span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-4 h-7 text-xs" OnClick="@(() => _uploaded = true)">
                    Choose file
                </ButtonCn>
            </div>
        }
        else
        {
            @* File info *@
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted/50">
                    <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground/60" />
                </div>
                <div class="min-w-0 flex-1">
                    <span class="block truncate font-medium text-sm">mutual-nda-acme-nova-2026.pdf</span>
                    <span class="text-muted-foreground text-xs">186 KB</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-mono font-normal text-xs">PDF</BadgeCn>
            </div>

            @* Document type selector *@
            <div class="border-b px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">Document type</span>
                <div class="mt-2 grid grid-cols-4 gap-2">
                    @foreach (var docTypeItem in _documentTypes)
                    {
                        var typeId = docTypeItem.Id;
                        var isActive = _docType == typeId;
                        <button
                            type="button"
                            @onclick="@(() => _docType = typeId)"
                            class="@Cn.Merge("rounded-md border px-2 py-1.5 text-xs transition-colors", isActive ? "border-foreground bg-muted/50 font-medium" : "border-transparent text-muted-foreground hover:bg-muted/50")">
                            @docTypeItem.Label
                        </button>
                    }
                </div>
            </div>

            @* Parties involved *@
            <div class="border-b px-4 py-3">
                <div class="mb-2 flex items-center gap-2">
                    <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-muted-foreground text-xs">Parties involved</span>
                </div>
                <div class="space-y-2">
                    @foreach (var partyItem in _parties)
                    {
                        var party = partyItem;
                        <div class="flex items-center gap-3">
                            <div class="min-w-0 flex-1">
                                <InputCn aria-label="Party name" Value="@party.Name" ValueChanged="@((string v) => UpdatePartyName(party.Id, v))" Class="h-7 text-sm" />
                            </div>
                            <span class="shrink-0 text-muted-foreground text-xs">@party.Role</span>
                        </div>
                    }
                </div>
            </div>

            @* Effective date and confidentiality *@
            <div class="grid grid-cols-2 border-b">
                <div class="border-r px-4 py-3">
                    <span class="font-medium text-muted-foreground text-xs">Effective date</span>
                    <InputCn aria-label="Effective date" @bind-Value="_effectiveDate" Class="mt-1 h-7 font-mono text-sm" />
                </div>
                <div class="px-4 py-3">
                    <span class="font-medium text-muted-foreground text-xs">Confidentiality level</span>
                    <div class="mt-1.5 flex flex-wrap gap-1.5">
                        @foreach (var lvl in _confidentialityLevels)
                        {
                            var levelId = lvl.Id;
                            var lvlActive = _confidentiality == levelId;
                            <button
                                type="button"
                                @onclick="@(() => _confidentiality = levelId)"
                                class="@Cn.Merge("rounded-md px-2 py-0.5 text-xs transition-colors", lvlActive ? "bg-foreground text-background" : "bg-muted/50 text-muted-foreground hover:text-foreground")">
                                @lvl.Label
                            </button>
                        }
                    </div>
                </div>
            </div>

            @* Attorney review *@
            <div class="border-b px-4 py-3">
                <label class="flex items-start gap-3 cursor-pointer" for="legal-attorney-review">
                    <CheckboxCn id="legal-attorney-review" Checked="@_attorneyReview" CheckedChanged="@((bool v) => _attorneyReview = v)" aria-label="Flag for attorney review" Class="mt-0.5" />
                    <div>
                        <span class="font-medium text-sm">Flag for attorney review</span>
                        <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">
                            Route this document to legal counsel for review before execution. Estimated
                            review time is 2-3 business days.
                        </p>
                    </div>
                </label>
            </div>

            @* Attorney review notice *@
            @if (_attorneyReview)
            {
                <div class="border-b px-4 py-3">
                    <div class="flex items-start gap-2 rounded-md bg-muted/50 p-3">
                        <LucideIconCn Name="gavel" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                        <div>
                            <span class="font-medium text-xs">Attorney-client privilege</span>
                            <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">
                                This document and all communications regarding it are protected by
                                attorney-client privilege. Do not share outside the legal team until review is
                                complete.
                            </p>
                        </div>
                    </div>
                </div>
            }

            @* Actions *@
            <div class="flex items-center justify-end gap-2 px-4 py-3">
                @if (_submitted)
                {
                    <div class="flex items-center gap-1.5 text-xs">
                        <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                        <span class="text-muted-foreground">
                            Document submitted@(_attorneyReview ? " for attorney review" : "")
                        </span>
                    </div>
                }
                else
                {
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" OnClick="@(() => _submitted = true)">
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                        Submit document
                    </ButtonCn>
                }
            </div>
        }
    </div>
</section>

@code {
    private record DocTypeItem(string Id, string Label);
    private record ConfidentialityItem(string Id, string Label);
    private record Party(string Id, string Name, string Role);

    private static readonly DocTypeItem[] _documentTypes =
    [
        new("nda", "NDA"),
        new("employment", "Employment Agreement"),
        new("service", "Service Contract"),
        new("amendment", "Amendment"),
    ];

    private static readonly ConfidentialityItem[] _confidentialityLevels =
    [
        new("public", "Public"),
        new("internal", "Internal"),
        new("confidential", "Confidential"),
        new("privileged", "Privileged"),
    ];

    private bool _uploaded = true;
    private string _docType = "nda";
    private string _confidentiality = "confidential";
    private string _effectiveDate = "2026-04-01";
    private List<Party> _parties =
    [
        new("1", "Acme Corporation", "Disclosing party"),
        new("2", "Nova Ventures LLC", "Receiving party"),
    ];
    private bool _attorneyReview = false;
    private bool _submitted = false;

    private void UpdatePartyName(string id, string name)
    {
        var idx = _parties.FindIndex(p => p.Id == id);
        if (idx >= 0)
            _parties[idx] = _parties[idx] with { Name = name };
    }

    private static string ConfidentialityStyle(string level) => level switch
    {
        "confidential" => "text-amber-600 dark:text-amber-400",
        "privileged"   => "text-red-600 dark:text-red-400",
        _              => "",
    };

    private string ConfidentialityLabel(string level)
    {
        foreach (var lvl in _confidentialityLevels)
            if (lvl.Id == level) return lvl.Label;
        return level;
    }
}
