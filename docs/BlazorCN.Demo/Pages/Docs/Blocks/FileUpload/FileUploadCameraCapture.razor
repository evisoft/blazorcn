@* ============================================================
   Block: file-upload-camera-capture
   Title: FileUploadCameraCapture
   Description: A camera and photo capture upload component with take photo and upload photo toggle, camera viewfinder placeholder, captured photo preview, retake button, and quality selector built with React, shadcn/ui, and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-camera-capture.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Capture photo</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Take a photo or upload from your device
                </p>
            </div>
        </div>

        @* Mode toggle *@
        <div class="flex border-b">
            <button
                type="button"
                @onclick="@(() => SetMode("camera"))"
                class="@Cn.Merge("flex flex-1 items-center justify-center gap-2 px-4 py-2.5 text-xs font-medium transition-colors", _mode == "camera" ? "bg-muted/50 text-foreground" : "text-muted-foreground hover:text-foreground")">
                <LucideIconCn Name="camera" Size="14" Class="size-3.5" />
                Take photo
            </button>
            <button
                type="button"
                @onclick="@(() => SetMode("upload"))"
                class="@Cn.Merge("flex flex-1 items-center justify-center gap-2 border-l px-4 py-2.5 text-xs font-medium transition-colors", _mode == "upload" ? "bg-muted/50 text-foreground" : "text-muted-foreground hover:text-foreground")">
                <LucideIconCn Name="upload-cloud" Size="14" Class="size-3.5" />
                Upload photo
            </button>
        </div>

        @* Camera / Upload area *@
        <div class="border-b">
            @if (_mode == "camera")
            {
                <div class="px-4 py-4">
                    @if (!_hasPhoto)
                    {
                        @* Viewfinder placeholder *@
                        <div class="flex aspect-video items-center justify-center rounded-md bg-muted/50">
                            <div class="flex flex-col items-center gap-2">
                                <LucideIconCn Name="camera" Size="32" Class="size-8 text-muted-foreground/30" />
                                <p class="text-muted-foreground text-xs">Camera viewfinder</p>
                            </div>
                        </div>

                        @* Shutter button *@
                        <div class="mt-3 flex justify-center">
                            <button
                                type="button"
                                @onclick="TakePhoto"
                                aria-label="Take photo"
                                class="flex size-12 items-center justify-center rounded-full border-2 border-foreground/20 transition-colors hover:border-foreground/40">
                                <span class="size-9 rounded-full bg-foreground/10 transition-colors hover:bg-foreground/20"></span>
                            </button>
                        </div>
                    }
                    else
                    {
                        @* Captured photo preview *@
                        <div class="flex aspect-video items-center justify-center rounded-md bg-muted/30">
                            <div class="flex flex-col items-center gap-2">
                                <LucideIconCn Name="image" Size="32" Class="size-8 text-muted-foreground/40" />
                                <p class="text-muted-foreground text-xs">Captured photo preview</p>
                            </div>
                        </div>

                        @* Photo actions *@
                        <div class="mt-3 flex items-center justify-center gap-2">
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="Retake">
                                <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                                Retake
                            </ButtonCn>
                            <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="ConfirmPhoto">
                                <LucideIconCn Name="check" Size="12" Class="size-3" />
                                Use photo
                            </ButtonCn>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="px-4 py-4">
                    <div class="flex flex-col items-center justify-center gap-2 rounded-md border border-dashed border-muted-foreground/25 px-4 py-8">
                        <LucideIconCn Name="upload-cloud" Size="20" Class="size-5 text-muted-foreground/60" />
                        <div class="text-center">
                            <p class="font-medium text-sm">Drop a photo here</p>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                JPG, PNG, or WebP up to 10 MB
                            </p>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-1 h-7 text-xs">
                            Choose file
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

        @* Quality selector *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 font-medium text-muted-foreground text-xs">Image quality</p>
            <div class="flex gap-2">
                @foreach (var q in _qualityKeys)
                {
                    var qKey = q;
                    var setting = _qualitySettings[qKey];
                    <button
                        type="button"
                        @onclick="@(() => _quality = qKey)"
                        class="@Cn.Merge("flex flex-1 flex-col rounded-md px-3 py-2 text-left transition-colors", _quality == qKey ? "bg-muted/50 ring-1 ring-foreground/10" : "hover:bg-muted/30")">
                        <span class="font-medium text-xs">@setting.Label</span>
                        <span class="mt-0.5 text-muted-foreground text-[10px]">@setting.FileSize</span>
                    </button>
                }
            </div>
        </div>

        @* Captured photo metadata *@
        @if (_captured != null)
        {
            <div class="px-4 py-3">
                <div class="flex items-center gap-3 rounded-md bg-muted/50 p-3">
                    <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-background">
                        <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="truncate font-medium text-sm">@_captured.Name</p>
                        <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                            <span>@_captured.Dimensions</span>
                            <span>·</span>
                            <span>@_captured.Size</span>
                            <span>·</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">
                                @_qualitySettings[_captured.Quality].Label
                            </BadgeCn>
                        </div>
                    </div>
                    <ButtonCn
                        Variant="ButtonVariant.Ghost"
                        Size="ButtonSize.Sm"
                        Class="size-7 shrink-0 p-0 text-muted-foreground"
                        aria-label="Discard capture"
                        OnClick="Retake">
                        <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                    </ButtonCn>
                </div>
            </div>
        }

        @* Footer *@
        @if (_captured == null)
        {
            <div class="px-4 py-3">
                <p class="text-center text-muted-foreground text-xs">
                    @(_mode == "camera"
                        ? "Position your subject and tap the shutter button"
                        : "Select a photo from your device to upload")
                </p>
            </div>
        }
    </div>
</section>

@code {
    private string _mode = "camera";
    private string _quality = "high";
    private CapturedPhoto? _captured = null;
    private bool _hasPhoto = false;

    private static readonly string[] _qualityKeys = ["high", "medium", "low"];

    private static readonly Dictionary<string, QualitySetting> _qualitySettings = new()
    {
        ["high"]   = new QualitySetting("High",   "Original resolution, JPEG 92%", "~2.4 MB"),
        ["medium"] = new QualitySetting("Medium", "Reduced resolution, JPEG 75%",  "~800 KB"),
        ["low"]    = new QualitySetting("Low",    "Compressed, JPEG 50%",          "~320 KB"),
    };

    private void SetMode(string mode)
    {
        _mode = mode;
        Retake();
    }

    private void TakePhoto()
    {
        _captured = new CapturedPhoto(
            Id: "cap-1",
            Name: "capture-photo.jpg",
            Size: _qualitySettings[_quality].FileSize,
            Quality: _quality,
            Dimensions: "1920 x 1080"
        );
        _hasPhoto = true;
    }

    private void Retake()
    {
        _captured = null;
        _hasPhoto = false;
    }

    private void ConfirmPhoto()
    {
        // In production, this would upload the captured photo
    }

    private record CapturedPhoto(string Id, string Name, string Size, string Quality, string Dimensions);

    private record QualitySetting(string Label, string Description, string FileSize);
}
