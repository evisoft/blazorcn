@* ============================================================
   Block: file-upload-diff-viewer
   Title: FileUploadDiffViewer
   Description: A two-file upload diff comparison block for React and Next.js with side-by-side view of added and removed lines, line count diff, and change summary statistics using shadcn/ui Button, Badge, and Tailwind CSS in a max-w-4xl layout
   Source: original/blocks/file-upload/file-upload-diff-viewer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="file-diff" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Diff viewer</span>
        </div>

        @* File info *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex min-w-0 flex-1 items-center gap-2">
                <LucideIconCn Name="file" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                <span class="truncate font-mono text-xs">@OriginalFile.Name</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">
                    @OriginalFile.Lines lines
                </BadgeCn>
            </div>
            <LucideIconCn Name="arrow-right" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
            <div class="flex min-w-0 flex-1 items-center gap-2">
                <LucideIconCn Name="file" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                <span class="truncate font-mono text-xs">@ModifiedFile.Name</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">
                    @ModifiedFile.Lines lines
                </BadgeCn>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 gap-1.5 text-xs">
                <LucideIconCn Name="upload" Size="12" Class="size-3" />
                Upload files
            </ButtonCn>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="plus" Size="12" Class="size-3 text-emerald-500" />
                <span class="tabular-nums">@_stats.Added</span>
                <span class="text-muted-foreground">added</span>
            </span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="minus" Size="12" Class="size-3 text-red-500" />
                <span class="tabular-nums">@_stats.Removed</span>
                <span class="text-muted-foreground">removed</span>
            </span>
            <span class="flex items-center gap-1.5 text-xs">
                <span class="size-1.5 rounded-full bg-amber-500"></span>
                <span class="tabular-nums">@_stats.Modified</span>
                <span class="text-muted-foreground">modified</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs tabular-nums">
                @((ModifiedFile.Lines - OriginalFile.Lines >= 0) ? "+" : "")@(ModifiedFile.Lines - OriginalFile.Lines) net
            </span>
            <div class="ml-auto">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" OnClick="ToggleUnchanged">
                    @(_showUnchanged ? "Hide" : "Show") unchanged
                </ButtonCn>
            </div>
        </div>

        @* Diff content *@
        <div class="overflow-x-auto">
            <div class="min-w-[640px]">
                @* Column headers *@
                <div class="grid grid-cols-2 border-b">
                    <div class="border-r px-4 py-2">
                        <span class="font-medium text-muted-foreground text-xs">Original</span>
                    </div>
                    <div class="px-4 py-2">
                        <span class="font-medium text-muted-foreground text-xs">Modified</span>
                    </div>
                </div>

                @* Diff lines *@
                @{
                    var visibleLines = _showUnchanged
                        ? _diffLines
                        : System.Array.FindAll(_diffLines, l => l.Type != "unchanged");
                }
                @foreach (var lineEntry in visibleLines.Select((l, i) => new { Line = l, Index = i, IsLast = i == visibleLines.Length - 1 }))
                {
                    var line = lineEntry.Line;
                    var isLast = lineEntry.IsLast;
                    var leftBg = GetLeftBg(line.Type);
                    var rightBg = GetRightBg(line.Type);
                    var numColor = GetNumColor(line.Type);
                    <div class="@Cn.Merge("grid grid-cols-2", isLast ? "" : "border-b")">
                        @* Left (original) *@
                        <div class="@Cn.Merge("flex border-r font-mono text-xs", leftBg)">
                            <span class="@Cn.Merge("w-10 shrink-0 select-none px-2 py-1 text-right tabular-nums", numColor)">
                                @(line.LeftNum.HasValue ? line.LeftNum.Value.ToString() : "")
                            </span>
                            <span class="min-w-0 flex-1 whitespace-pre px-3 py-1">
                                @if (line.Type == "removed")
                                {
                                    <span class="mr-1 select-none text-red-500">-</span>
                                }
                                @if (line.Type == "modified")
                                {
                                    <span class="mr-1 select-none text-amber-500">~</span>
                                }
                                @line.LeftContent
                            </span>
                        </div>

                        @* Right (modified) *@
                        <div class="@Cn.Merge("flex font-mono text-xs", rightBg)">
                            <span class="@Cn.Merge("w-10 shrink-0 select-none px-2 py-1 text-right tabular-nums", numColor)">
                                @(line.RightNum.HasValue ? line.RightNum.Value.ToString() : "")
                            </span>
                            <span class="min-w-0 flex-1 whitespace-pre px-3 py-1">
                                @if (line.Type == "added")
                                {
                                    <span class="mr-1 select-none text-emerald-500">+</span>
                                }
                                @if (line.Type == "modified")
                                {
                                    <span class="mr-1 select-none text-amber-500">~</span>
                                }
                                @line.RightContent
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record DiffLine(
        int? LeftNum,
        int? RightNum,
        string LeftContent,
        string RightContent,
        string Type
    );

    private record FileInfo(string Name, int Lines, string Size);

    private record DiffStats(int Added, int Removed, int Modified, int Unchanged);

    private static readonly FileInfo OriginalFile = new("config.production.yml", 48, "1.8 KB");
    private static readonly FileInfo ModifiedFile = new("config.production.yml", 52, "2.1 KB");

    private static readonly DiffLine[] _diffLines =
    [
        new(1,  1,  "server:",                  "server:",                    "unchanged"),
        new(2,  2,  "  host: 0.0.0.0",          "  host: 0.0.0.0",           "unchanged"),
        new(3,  3,  "  port: 3000",              "  port: 8080",              "modified"),
        new(4,  4,  "  workers: 2",              "  workers: 4",              "modified"),
        new(5,  5,  "",                           "",                          "unchanged"),
        new(6,  6,  "database:",                 "database:",                  "unchanged"),
        new(7,  7,  "  host: localhost",         "  host: db.internal.prod",  "modified"),
        new(8,  8,  "  port: 5432",              "  port: 5432",              "unchanged"),
        new(9,  9,  "  name: app_dev",           "  name: app_production",    "modified"),
        new(10, null, "  pool_size: 5",          "",                          "removed"),
        new(null, 10, "",                         "  pool_size: 20",           "added"),
        new(null, 11, "",                         "  pool_timeout: 30000",     "added"),
        new(null, 12, "",                         "  ssl: true",               "added"),
        new(11, 13, "",                           "",                          "unchanged"),
        new(12, 14, "cache:",                     "cache:",                    "unchanged"),
        new(13, 15, "  driver: memory",           "  driver: redis",           "modified"),
        new(null, 16, "",                         "  redis_url: redis://cache.internal:6379", "added"),
        new(null, 17, "",                         "  ttl: 3600",               "added"),
        new(14, 18, "",                           "",                          "unchanged"),
        new(15, 19, "logging:",                   "logging:",                  "unchanged"),
        new(16, 20, "  level: debug",             "  level: warn",             "modified"),
        new(17, 21, "  format: text",             "  format: json",            "modified"),
        new(null, 22, "",                         "  output: stdout",          "added"),
        new(18, 23, "",                           "",                          "unchanged"),
        new(19, 24, "auth:",                      "auth:",                     "unchanged"),
        new(20, 25, "  secret: dev-secret-key",  @"  secret: ${AUTH_SECRET}", "modified"),
        new(21, 26, "  expiry: 86400",            "  expiry: 3600",            "modified"),
    ];

    private static readonly DiffStats _stats = new(
        Added:     _diffLines.Count(l => l.Type == "added"),
        Removed:   _diffLines.Count(l => l.Type == "removed"),
        Modified:  _diffLines.Count(l => l.Type == "modified"),
        Unchanged: _diffLines.Count(l => l.Type == "unchanged")
    );

    private bool _showUnchanged = true;

    private void ToggleUnchanged() => _showUnchanged = !_showUnchanged;

    private static string GetLeftBg(string type) => type switch
    {
        "removed"  => "bg-red-500/10",
        "modified" => "bg-red-500/5",
        _          => "",
    };

    private static string GetRightBg(string type) => type switch
    {
        "added"    => "bg-emerald-500/10",
        "modified" => "bg-emerald-500/5",
        _          => "",
    };

    private static string GetNumColor(string type) => type switch
    {
        "added"    => "text-emerald-600 dark:text-emerald-400",
        "removed"  => "text-red-600 dark:text-red-400",
        "modified" => "text-amber-600 dark:text-amber-400",
        _          => "text-muted-foreground",
    };
}
