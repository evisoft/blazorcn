@code {
    private record AcceptedType(string Mime, string Label, string Icon);
    private record UploadedFile(string Id, string Name, string Size, string Type, bool Valid, string? Reason = null);

    private static readonly AcceptedType[] _acceptedTypes =
    [
        new(""application/pdf"", ""PDF"", ""file-text""),
        new(""image/png"", ""PNG"", ""image""),
        new(""image/jpeg"", ""JPG"", ""image""),
    ];

    private static readonly UploadedFile[] _initialFiles =
    [
        new(""1"", ""contract-final.pdf"", ""2.4 MB"", ""application/pdf"", true),
        new(""2"", ""screenshot.png"", ""845 KB"", ""image/png"", true),
        new(""3"", ""profile-photo.jpg"", ""1.1 MB"", ""image/jpeg"", true),
        new(""4"", ""spreadsheet.xlsx"", ""340 KB"", ""application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"", false, ""XLSX files are not accepted. Upload PDF, PNG, or JPG.""),
        new(""5"", ""archive.zip"", ""12.8 MB"", ""application/zip"", false, ""ZIP files are not accepted. Upload PDF, PNG, or JPG.""),
    ];

    private List<UploadedFile> _files = new(_initialFiles);

    private UploadedFile[] _validFiles => _files.Where(f => f.Valid).ToArray();
    private UploadedFile[] _rejectedFiles => _files.Where(f => !f.Valid).ToArray();

    private string GetTypeLabel(string mime)
    {
        var found = _acceptedTypes.FirstOrDefault(t => t.Mime == mime);
        if (found is not null) return found.Label;
        var parts = mime.Split('/');
        return parts.Length > 1 ? parts[^1].ToUpperInvariant() : ""FILE"";
    }

    private void RemoveFile(string id)
    {
        _files = _files.Where(f => f.Id != id).ToList();
    }
}";

