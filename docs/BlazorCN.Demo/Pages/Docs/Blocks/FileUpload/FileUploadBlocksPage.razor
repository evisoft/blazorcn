    {
        [""idle""]       = """",
        [""validating""] = ""Checking backup integrity..."",
        [""valid""]      = ""Backup file is valid and ready to restore"",
        [""invalid""]    = ""Backup file is corrupted or incompatible"",
    };

    private BackupFile? _file = null;
    private string _validation = ""idle"";
    private bool _dialogOpen = false;
