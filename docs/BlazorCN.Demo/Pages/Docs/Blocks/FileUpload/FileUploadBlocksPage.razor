@code {
    private enum UploadStatus { Idle, Uploading, Paused, Complete }

    private UploadStatus _status = UploadStatus.Idle;
    private int _progress = 42;
    private string _fileName = ""design-assets-v3.zip"";
    private long _fileSize = 12_582_912; // 12 MB

    private string _speed = ""2.4 MB/s"";

    private string _totalSize => FormatBytes(_fileSize);
    private string _transferred => FormatBytes((long)(_fileSize * _progress / 100.0));
    private string _timeRemaining => _progress < 100 ? $""{Math.Max(1, (100 - _progress) / 8)}s left"" : ""Done"";

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $""{bytes} B"";
        if (bytes < 1024 * 1024) return $""{(bytes / 1024.0):F1} KB"";
        return $""{(bytes / (1024.0 * 1024.0)):F1} MB"";
    }

    private void SimulateFileSelect()
    {
        _status = UploadStatus.Uploading;
        _progress = 42;
    }

    private void TogglePause()
    {
        if (_status == UploadStatus.Uploading)
        {
            _status = UploadStatus.Paused;
        }
        else if (_status == UploadStatus.Paused)
        {
            _status = UploadStatus.Uploading;
        }
    }

    private void Cancel()
    {
        _status = UploadStatus.Idle;
        _progress = 0;
    }

    private void Reset()
    {
        _status = UploadStatus.Idle;
        _progress = 0;
    }
}";
}
