    private static StatusConfig GetStatusConfig(string status) => status switch
    {
        ""pending""      => new StatusConfig(""Pending"",      ""bg-muted-foreground"", ""clock""),
        ""under_review"" => new StatusConfig(""Under Review"", ""bg-blue-500"",         ""circle-dot""),
