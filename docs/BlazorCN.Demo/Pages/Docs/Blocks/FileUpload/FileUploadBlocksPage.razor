@code {
    private const int PageSize = 8;

    private record FileEntry(string Id, string Name, string Type, string Size, long SizeBytes, string Modified, string Owner);

    private static readonly FileEntry[] _files =
    [
        new(""f1"",  ""Q4 Financial Report.pdf"",  ""pdf"",         ""2.4 MB"",  2516582,   ""Mar 22, 2026"", ""Alice Chen""),
        new(""f2"",  ""Brand Assets"",             ""folder"",      ""148 MB"",  155189248, ""Mar 21, 2026"", ""Design Team""),
        new(""f3"",  ""Product Screenshot.png"",   ""image"",       ""4.1 MB"",  4298137,   ""Mar 20, 2026"", ""Bob Martinez""),
        new(""f4"",  ""Revenue Forecast.xlsx"",    ""spreadsheet"", ""890 KB"",  911360,    ""Mar 19, 2026"", ""Carol Wu""),
        new(""f5"",  ""API Documentation.pdf"",    ""pdf"",         ""1.8 MB"",  1887436,   ""Mar 18, 2026"", ""David Kim""),
        new(""f6"",  ""Team Headshots"",           ""folder"",      ""67 MB"",   70254592,  ""Mar 17, 2026"", ""HR Team""),
        new(""f7"",  ""Meeting Notes.docx"",       ""document"",    ""245 KB"",  250880,    ""Mar 16, 2026"", ""Eve Johnson""),
        new(""f8"",  ""Dashboard Mockup.png"",     ""image"",       ""3.6 MB"",  3774873,   ""Mar 15, 2026"", ""Frank Liu""),
        new(""f9"",  ""User Research Data.xlsx"",  ""spreadsheet"", ""1.2 MB"",  1258291,   ""Mar 14, 2026"", ""Grace Park""),
        new(""f10"", ""Release Notes.pdf"",        ""pdf"",         ""520 KB"",  532480,    ""Mar 13, 2026"", ""Henry Adams""),
        new(""f11"", ""Onboarding Guide.docx"",    ""document"",    ""380 KB"",  389120,    ""Mar 12, 2026"", ""Alice Chen""),
        new(""f12"", ""Exported Logs"",            ""folder"",      ""24 MB"",   25165824,  ""Mar 11, 2026"", ""DevOps Team""),
    ];

    private record ColumnDef(string Key, string Label, string ClassName = """");

    private static readonly ColumnDef[] _columns =
    [
        new(""name"",      ""Name""),
        new(""type"",      ""Type"",     ""hidden sm:table-cell""),
        new(""sizeBytes"", ""Size"",     ""hidden sm:table-cell""),
        new(""modified"",  ""Modified"", ""hidden md:table-cell""),
        new(""owner"",     ""Owner"",    ""hidden lg:table-cell""),
    ];

    private HashSet<string> _selected = [];
    private string _sortKey = ""name"";
    private string _sortDir = ""asc"";
    private int _page = 0;

    private string SortValue(FileEntry f) => _sortKey switch
    {
        ""sizeBytes"" => f.SizeBytes.ToString(""D20""),
        ""type""      => f.Type,
        ""modified""  => f.Modified,
        ""owner""     => f.Owner,
        _           => f.Name,
    };

    private FileEntry[] GetSorted()
    {
        var arr = _files.OrderBy(f => SortValue(f), StringComparer.OrdinalIgnoreCase).ToArray();
        return _sortDir == ""desc"" ? arr.Reverse().ToArray() : arr;
    }

    private FileEntry[] _paged => GetSorted().Skip(_page * PageSize).Take(PageSize).ToArray();
    private int _totalPages => (int)Math.Ceiling(_files.Length / (double)PageSize);

    private void ToggleSort(string key)
    {
        if (_sortKey == key)
            _sortDir = _sortDir == ""asc"" ? ""desc"" : ""asc"";
        else
        {
            _sortKey = key;
            _sortDir = ""asc"";
        }
        _page = 0;
    }

    private void ToggleSelect(string id)
    {
        if (!_selected.Add(id))
            _selected.Remove(id);
    }

    private void ToggleAll()
    {
        var paged = _paged;
        if (_selected.Count == paged.Length)
            _selected.Clear();
        else
            _selected = [.. paged.Select(f => f.Id)];
    }

    private void ClearSelection() => _selected.Clear();

    private void SetPage(int p)
    {
        _page = Math.Clamp(p, 0, _totalPages - 1);
    }

    private RenderFragment SortArrow(string col) => _sortKey != col
        ? (RenderFragment)(_ => { })
        : _sortDir == ""asc""
            ? @<LucideIconCn Name=""arrow-up"" Size=""12"" Class=""ml-1 inline size-3"" />
            : @<LucideIconCn Name=""arrow-down"" Size=""12"" Class=""ml-1 inline size-3"" />;

    private RenderFragment TypeIcon(string type) => type switch
    {
        ""folder""      => @<LucideIconCn Name=""folder""           Size=""16"" Class=""size-4 text-muted-foreground"" />,
        ""pdf""         => @<LucideIconCn Name=""file-text""        Size=""16"" Class=""size-4 text-muted-foreground"" />,
        ""image""       => @<LucideIconCn Name=""image""            Size=""16"" Class=""size-4 text-muted-foreground"" />,
        ""spreadsheet"" => @<LucideIconCn Name=""file-spreadsheet"" Size=""16"" Class=""size-4 text-muted-foreground"" />,
        _             => @<LucideIconCn Name=""file""             Size=""16"" Class=""size-4 text-muted-foreground"" />,
    };

    private static string TypeLabel(string type) => type switch
    {
        ""folder""      => ""Folder"",
        ""pdf""         => ""PDF"",
        ""image""       => ""Image"",
        ""spreadsheet"" => ""Spreadsheet"",
        ""document""    => ""Document"",
        _             => ""File"",
