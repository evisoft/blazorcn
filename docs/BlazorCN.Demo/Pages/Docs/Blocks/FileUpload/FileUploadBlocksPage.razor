        new(""e3"", ""hero-image.png"",        ""4.1 MB"",  ""b1c3d5e7"", ""Mar 5, 2026""),
        new(""e4"", ""user-data-export.csv"",  ""892 KB"",  ""f8a2c4d6"", ""Mar 12, 2026""),
    ];

    private IncomingFile[] _incoming =
    [
        new IncomingFile { Id = ""i1"", Name = ""quarterly-report.pdf"", Size = ""2.4 MB"", Hash = ""a3f2b8c1"", MatchType = ""both"",  MatchedFileId = ""e1"", Resolution = ""pending"" },
        new IncomingFile { Id = ""i2"", Name = ""logo-dark.svg"",        Size = ""22 KB"",  Hash = ""k9m1n3p5"", MatchType = ""name"",  MatchedFileId = ""e2"", Resolution = ""pending"" },
        new IncomingFile { Id = ""i3"", Name = ""banner-final.png"",     Size = ""4.1 MB"", Hash = ""b1c3d5e7"", MatchType = ""hash"",  MatchedFileId = ""e3"", Resolution = ""pending"" },
        new IncomingFile { Id = ""i4"", Name = ""team-photo.jpg"",       Size = ""3.8 MB"", Hash = ""x2y4z6w8"", MatchType = ""name"",  MatchedFileId = ""e4"", Resolution = ""pending"" },
    ];

    private int PendingCount => _incoming.Count(f => f.Resolution == ""pending"");
    private int ResolvedCount => _incoming.Length - PendingCount;

    private void Resolve(string id, string resolution)
    {
        var file = _incoming.FirstOrDefault(f => f.Id == id);
        if (file != null)
            file.Resolution = resolution;
    }

    private ExistingFile? GetExistingFile(string matchedId)
        => _existingFiles.FirstOrDefault(f => f.Id == matchedId);

    private static string GetMatchLabel(string matchType) => matchType switch
    {
        ""name"" => ""Same name"",
        ""hash"" => ""Same content"",
        ""both"" => ""Exact duplicate"",
        _      => matchType,
    };

    private static string GetMatchDotClass(string matchType) => matchType switch
    {
        ""name"" => ""bg-amber-500"",
        ""hash"" => ""bg-blue-500"",
        ""both"" => ""bg-red-500"",
        _      => ""bg-muted"",
    };
}";

