@code {
    private record PresetOption(string Label, int Width, int Height);

    private static readonly PresetOption[] _presets =
    [
        new PresetOption(""Thumbnail"", 150, 150),
        new PresetOption(""Medium"", 640, 480),
        new PresetOption(""Large"", 1280, 960),
        new PresetOption(""HD"", 1920, 1080),
        new PresetOption(""Social"", 1200, 630),
    ];

    private bool _uploaded = false;
    private string _fileName = """";
    private string _fileSize = """";
    private int _originalWidth = 0;
    private int _originalHeight = 0;
    private int _targetWidth = 0;
    private int _targetHeight = 0;
    private bool _lockRatio = true;
    private string? _activePreset = null;

    private int ReductionPercent => _originalWidth > 0 && _originalHeight > 0
        ? (int)Math.Round((1.0 - (_targetWidth * (double)_targetHeight) / (_originalWidth * (double)_originalHeight)) * 100)
        : 0;

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $""{bytes} B"";
        if (bytes < 1024 * 1024) return $""{(bytes / 1024.0):F1} KB"";
        return $""{(bytes / (1024.0 * 1024.0)):F1} MB"";
    }

    private void SimulateUpload()
    {
        _fileName = ""photo.jpg"";
        _fileSize = FormatSize(4800000);
        _originalWidth = 3840;
        _originalHeight = 2560;
        _targetWidth = 3840;
        _targetHeight = 2560;
        _lockRatio = true;
        _activePreset = null;
        _uploaded = true;
    }

    private void UpdateWidth(int w)
    {
        _activePreset = null;
        if (_lockRatio && _originalWidth > 0)
        {
            var ratio = _originalHeight / (double)_originalWidth;
            _targetWidth = w;
            _targetHeight = (int)Math.Round(w * ratio);
        }
        else
        {
            _targetWidth = w;
        }
    }

    private void UpdateHeight(int h)
    {
        _activePreset = null;
        if (_lockRatio && _originalHeight > 0)
        {
            var ratio = _originalWidth / (double)_originalHeight;
            _targetWidth = (int)Math.Round(h * ratio);
            _targetHeight = h;
        }
        else
        {
            _targetHeight = h;
        }
    }

    private void ApplyPreset(PresetOption preset)
    {
        _activePreset = preset.Label;
        _targetWidth = preset.Width;
        _targetHeight = preset.Height;
    }

    private void Reset()
    {
        _uploaded = false;
        _fileName = """";
        _fileSize = """";
        _originalWidth = 0;
        _originalHeight = 0;
        _targetWidth = 0;
        _targetHeight = 0;
        _lockRatio = true;
        _activePreset = null;
    }
}";

