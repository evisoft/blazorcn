@code {
    private record FileEntry(string Id, string Name, string Type, string Size);
    private record UserEntry(string Id, string Name, string Role, string Initials);

    private static readonly FileEntry[] _files =
    [
        new(""f1"", ""Q4-revenue-report.pdf"", ""document"", ""2.4 MB""),
        new(""f2"", ""employee-directory.xlsx"", ""spreadsheet"", ""890 KB""),
        new(""f3"", ""product-mockup.png"", ""image"", ""4.1 MB""),
        new(""f4"", ""api-specification.pdf"", ""document"", ""1.2 MB""),
    ];

    private static readonly UserEntry[] _users =
    [
        new(""u1"", ""Sarah Chen"", ""owner"", ""SC""),
        new(""u2"", ""Marcus Johnson"", ""editor"", ""MJ""),
        new(""u3"", ""Elena Rodriguez"", ""editor"", ""ER""),
        new(""u4"", ""David Kim"", ""viewer"", ""DK""),
    ];

    private static readonly string[] _permissionTypes = [""read"", ""write"", ""delete""];

    // permissions[fileId][userId][perm] = bool
    private Dictionary<string, Dictionary<string, Dictionary<string, bool>>> _permissions = BuildInitialPermissions();

    private string? _expandedFile = ""f1"";
    private bool _inheritEnabled = false;

    private static Dictionary<string, Dictionary<string, Dictionary<string, bool>>> BuildInitialPermissions()
    {
        var roleDefaults = new Dictionary<string, Dictionary<string, bool>>
        {
            [""owner""]  = new() { [""read""] = true,  [""write""] = true,  [""delete""] = true  },
            [""editor""] = new() { [""read""] = true,  [""write""] = true,  [""delete""] = false },
            [""viewer""] = new() { [""read""] = true,  [""write""] = false, [""delete""] = false },
        };

        var perms = new Dictionary<string, Dictionary<string, Dictionary<string, bool>>>();
        foreach (var file in _files)
        {
            perms[file.Id] = new Dictionary<string, Dictionary<string, bool>>();
            foreach (var user in _users)
            {
                perms[file.Id][user.Id] = new Dictionary<string, bool>(roleDefaults[user.Role]);
            }
        }
        return perms;
    }

    private bool GetPerm(string fileId, string userId, string perm)
    {
        return _permissions.TryGetValue(fileId, out var fp) &&
               fp.TryGetValue(userId, out var up) &&
               up.TryGetValue(perm, out var val) && val;
    }

    private void TogglePermission(string fileId, string userId, string perm)
    {
        if (_permissions.TryGetValue(fileId, out var fp) &&
            fp.TryGetValue(userId, out var up) &&
            up.ContainsKey(perm))
        {
            up[perm] = !up[perm];
        }
    }

    private int GetPermissionCount(string fileId)
    {
        if (!_permissions.TryGetValue(fileId, out var fp)) return 0;
        int count = 0;
        foreach (var up in fp.Values)
            foreach (var val in up.Values)
                if (val) count++;
        return count;
    }

    private void ToggleExpand(string fileId)
    {
        _expandedFile = _expandedFile == fileId ? null : fileId;
    }

    private static string GetRoleDot(string role) => role switch
    {
        ""owner""  => ""bg-foreground"",
        ""editor"" => ""bg-blue-500"",
        _        => ""bg-muted-foreground"",
    };
}";

