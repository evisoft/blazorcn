@code {
    private record PlatformItem(string Id, string Label, int CharLimit);
    private record MediaFile(string Id, string Name, string Type, string Size);

    private static readonly PlatformItem[] _platforms =
    [
        new(""instagram"", ""Instagram"", 2200),
        new(""twitter"", ""Twitter"", 280),
        new(""linkedin"", ""LinkedIn"", 3000),
    ];

    private List<string> _selectedPlatforms = [""instagram"", ""twitter""];

    private List<MediaFile> _media =
    [
        new(""1"", ""product-launch-hero.jpg"", ""image"", ""2.4 MB""),
    ];

    private string _caption = ""Excited to announce our latest product update. Faster performance, cleaner UI, and the features you've been asking for."";
    private bool _isScheduled = false;

    private int _activeLimit => _selectedPlatforms.Count == 0
        ? 3000
        : _selectedPlatforms
            .Select(pid => _platforms.FirstOrDefault(pl => pl.Id == pid))
            .Where(p => p != null)
            .Select(p => p!.CharLimit)
            .DefaultIfEmpty(3000)
            .Min();

    private int _charCount => _caption.Length;
    private bool _isOverLimit => _charCount > _activeLimit;
    private bool _isNearLimit => _charCount > _activeLimit * 0.9;

    private void TogglePlatform(string id)
    {
        if (_selectedPlatforms.Contains(id))
            _selectedPlatforms.Remove(id);
        else
            _selectedPlatforms.Add(id);
    }

    private void RemoveMedia(string id)
    {
        _media.RemoveAll(m => m.Id == id);
    }
}";

