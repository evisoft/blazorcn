    private static readonly string[] _permissionOptions = [""public"", ""team"", ""private""];

    private List<ManagedFile> _files =
    [
        new(""1"", ""Q1-financial-report.pdf"", ""2.4 MB"", ""pdf"", ""team"",
            [new(""James Wilson"", ""james@acme.com""), new(""Priya Patel"", ""priya@acme.com"")],
            true),
        new(""2"", ""brand-guidelines-v3.pdf"", ""8.1 MB"", ""pdf"", ""public"",
            [],
            true),
        new(""3"", ""employee-contracts.zip"", ""14.6 MB"", ""archive"", ""private"",
            [new(""Sarah Chen"", ""sarah@acme.com"")],
            false),
        new(""4"", ""product-mockups.png"", ""3.2 MB"", ""image"", ""team"",
            [new(""Maria Garcia"", ""maria@acme.com""), new(""James Wilson"", ""james@acme.com""), new(""Alex Kim"", ""alex@acme.com"")],
            false),
        new(""5"", ""meeting-notes-march.docx"", ""156 KB"", ""document"", ""team"",
            [],
            false),
    ];

    private string? _expanded = ""1"";
    private string? _copied = null;

    private static PermConfig GetPermConfig(string permission) => permission switch
    {
        ""public""  => new PermConfig(""bg-emerald-500"", ""Public""),
        ""private"" => new PermConfig(""bg-red-500"", ""Private""),
        _         => new PermConfig(""bg-blue-500"", ""Team""),
    };

    private void ToggleExpand(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private void UpdatePermission(string id, string permission)
    {
        _files = _files.Select(f => f.Id == id ? f with { Permission = permission } : f).ToList();
    }

    private void ToggleLink(string id)
    {
        _files = _files.Select(f => f.Id == id ? f with { LinkEnabled = !f.LinkEnabled } : f).ToList();
    }

    private void CopyLink(string id)
    {
        _copied = id;
        // In a real app: await JS.InvokeVoidAsync(""navigator.clipboard.writeText"", $""https://files.acme.com/share/{id}"");
        // Timer reset omitted for SSR compatibility
    }
}";

