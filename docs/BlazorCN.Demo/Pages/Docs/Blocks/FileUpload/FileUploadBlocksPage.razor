    [
        new(""f1"",  ""Q4 Financial Report.pdf"",   ""pdf"",         ""2.4 MB"", 2458, ""Mar 22, 2026"",  4,  ""Alice Chen""),
        new(""f2"",  ""Product Screenshot.png"",    ""image"",       ""4.1 MB"", 4198, ""Mar 20, 2026"",  6,  ""Bob Martinez""),
        new(""f3"",  ""Revenue Forecast.xlsx"",     ""spreadsheet"", ""890 KB"",  890, ""Mar 18, 2026"",  8,  ""Carol Wu""),
        new(""f4"",  ""API Documentation.pdf"",     ""pdf"",         ""1.8 MB"", 1843, ""Mar 15, 2026"", 11,  ""David Kim""),
        new(""f5"",  ""Dashboard Mockup.png"",      ""image"",       ""3.6 MB"", 3686, ""Mar 12, 2026"", 14,  ""Alice Chen""),
        new(""f6"",  ""Meeting Notes.docx"",        ""document"",    ""245 KB"",  245, ""Mar 10, 2026"", 16,  ""Eve Johnson""),
        new(""f7"",  ""Onboarding Guide.pdf"",      ""pdf"",         ""520 KB"",  520, ""Mar 5, 2026"",  21,  ""Frank Liu""),
        new(""f8"",  ""Team Roster.xlsx"",          ""spreadsheet"", ""340 KB"",  340, ""Feb 28, 2026"", 26,  ""Carol Wu""),
        new(""f9"",  ""Logo Pack.png"",             ""image"",       ""8.2 MB"", 8397, ""Feb 20, 2026"", 34,  ""Bob Martinez""),
        new(""f10"", ""Release Notes v3.pdf"",      ""pdf"",         ""180 KB"",  180, ""Feb 15, 2026"", 39,  ""David Kim""),
        new(""f11"", ""Expense Report.xlsx"",       ""spreadsheet"", ""445 KB"",  445, ""Feb 10, 2026"", 44,  ""Grace Park""),
        new(""f12"", ""Brand Guidelines.pdf"",      ""pdf"",         ""5.6 MB"", 5734, ""Jan 30, 2026"", 55,  ""Alice Chen""),
    ];

    private static readonly string[] _owners =
    [
        ""Alice Chen"", ""Bob Martinez"", ""Carol Wu"", ""David Kim"",
        ""Eve Johnson"", ""Frank Liu"", ""Grace Park"",
    ];

    private string _query = """";
    private string _filterType = ""all"";
    private string _filterDateRange = ""all"";
    private string _filterSizeRange = ""all"";
    private string _filterOwner = ""all"";

    private void UpdateFilter(string key, string value)
    {
        switch (key)
        {
            case ""type"":      _filterType      = value; break;
            case ""dateRange"": _filterDateRange = value; break;
            case ""sizeRange"": _filterSizeRange = value; break;
            case ""owner"":     _filterOwner     = value; break;
        }
    }

    private void ClearFilter(string key)
    {
        switch (key)
        {
            case ""query"":     _query           = """";    break;
            case ""type"":      _filterType      = ""all""; break;
            case ""dateRange"": _filterDateRange = ""all""; break;
            case ""sizeRange"": _filterSizeRange = ""all""; break;
            case ""owner"":     _filterOwner     = ""all""; break;
        }
    }

    private void ClearAll()
    {
        _query           = """";
        _filterType      = ""all"";
        _filterDateRange = ""all"";
        _filterSizeRange = ""all"";
        _filterOwner     = ""all"";
    }

    private List<FileEntry> GetFiltered()
    {
        var results = new List<FileEntry>();
        foreach (var file in _allFiles)
        {
            if (!string.IsNullOrEmpty(_query) && !file.Name.ToLower().Contains(_query.ToLower()))
                continue;
            if (_filterType != ""all"" && file.Type != _filterType)
                continue;
            if (_filterOwner != ""all"" && file.Owner != _filterOwner)
                continue;
            if (_filterDateRange == ""7d""  && file.ModifiedDays > 7)  continue;
            if (_filterDateRange == ""30d"" && file.ModifiedDays > 30) continue;
            if (_filterDateRange == ""90d"" && file.ModifiedDays > 90) continue;
            if (_filterSizeRange == ""small""  && file.SizeKB > 1024)                          continue;
            if (_filterSizeRange == ""medium"" && (file.SizeKB <= 1024 || file.SizeKB > 5120)) continue;
            if (_filterSizeRange == ""large""  && file.SizeKB <= 5120)                         continue;
            results.Add(file);
        }
        return results;
    }

    private List<ActiveFilter> GetActiveFilters()
    {
        var active = new List<ActiveFilter>();
        if (!string.IsNullOrEmpty(_query))
            active.Add(new ActiveFilter(""query"", $""\""{_query}\""""));
        if (_filterType != ""all"")
            active.Add(new ActiveFilter(""type"", _filterType switch
            {
                ""pdf""         => ""PDF"",
                ""image""       => ""Image"",
                ""spreadsheet"" => ""Spreadsheet"",
                _             => ""Document"",
            }));
        if (_filterDateRange != ""all"")
            active.Add(new ActiveFilter(""dateRange"", _filterDateRange switch
            {
                ""7d""  => ""Last 7 days"",
                ""30d"" => ""Last 30 days"",
                _     => ""Last 90 days"",
            }));
        if (_filterSizeRange != ""all"")
            active.Add(new ActiveFilter(""sizeRange"", _filterSizeRange switch
            {
                ""small""  => ""Under 1 MB"",
                ""medium"" => ""1-5 MB"",
                _        => ""Over 5 MB"",
            }));
        if (_filterOwner != ""all"")
            active.Add(new ActiveFilter(""owner"", _filterOwner));
        return active;
    }

    private static string GetTypeIcon(string type) => type switch
    {
        ""pdf""         => ""file-text"",
        ""image""       => ""image"",
        ""spreadsheet"" => ""file-spreadsheet"",
        _             => ""file"",
    };
}";

