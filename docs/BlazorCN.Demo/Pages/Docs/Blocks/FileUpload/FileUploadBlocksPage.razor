@code {
    private record JsonStats(int KeyCount, int MaxDepth, string Size, int ArrayCount);

    private string? _json = null;
    private bool _isValid = false;
    private string? _errorMsg = null;
    private JsonStats? _stats = null;
    private string _fileName = """";
    private bool _copied = false;
    private bool _isDragging = false;

    // Sample JSON content (the package.json from the TSX source)
    private static readonly string _sampleJsonRaw =
        ""{\n"" +
        ""  \""name\"": \""acme-dashboard\"",\n"" +
        ""  \""version\"": \""2.4.1\"",\n"" +
        ""  \""private\"": true,\n"" +
        ""  \""scripts\"": {\n"" +
        ""    \""dev\"": \""next dev --turbopack\"",\n"" +
        ""    \""build\"": \""next build\"",\n"" +
        ""    \""start\"": \""next start\"",\n"" +
        ""    \""lint\"": \""biome check --write .\""\n"" +
        ""  },\n"" +
        ""  \""dependencies\"": {\n"" +
        ""    \""next\"": \""15.1.0\"",\n"" +
        ""    \""react\"": \""19.0.0\"",\n"" +
        ""    \""react-dom\"": \""19.0.0\"",\n"" +
        ""    \""tailwindcss\"": \""4.0.0\"",\n"" +
        ""    \""lucide-react\"": \""0.468.0\"",\n"" +
        ""    \""prisma\"": \""6.2.0\""\n"" +
        ""  },\n"" +
        ""  \""devDependencies\"": {\n"" +
        ""    \""typescript\"": \""5.7.0\"",\n"" +
        ""    \""@types/react\"": \""19.0.0\"",\n"" +
        ""    \""@biomejs/biome\"": \""1.9.4\""\n"" +
        ""  },\n"" +
        ""  \""engines\"": {\n"" +
        ""    \""node\"": \"">=20.0.0\""\n"" +
        ""  }\n"" +
        ""}"";

    private void HandleUpload()
    {
        ProcessJson(_sampleJsonRaw, ""package.json"");
    }

    private void ProcessJson(string raw, string name)
    {
        _fileName = name;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(raw);
            var formatted = System.Text.Json.JsonSerializer.Serialize(
                doc.RootElement,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            _json = formatted;
            _isValid = true;
            _errorMsg = null;
            var (keys, maxDepth, arrays) = CountKeys(doc.RootElement, 0);
            var sizeKb = (System.Text.Encoding.UTF8.GetByteCount(formatted) / 1024.0).ToString(""F1"");
            _stats = new JsonStats(keys, maxDepth, $""{sizeKb} KB"", arrays);
        }
        catch (Exception ex)
        {
            _json = raw;
            _isValid = false;
            _errorMsg = ex.Message;
            _stats = null;
        }
    }

    private static (int Keys, int MaxDepth, int Arrays) CountKeys(System.Text.Json.JsonElement element, int depth)
    {
        if (element.ValueKind == System.Text.Json.JsonValueKind.Array)
        {
            int maxD = depth;
            int totalKeys = 0;
            int totalArrays = 1;
            foreach (var item in element.EnumerateArray())
            {
                var (k, d, a) = CountKeys(item, depth + 1);
                totalKeys += k;
                totalArrays += a;
                if (d > maxD) maxD = d;
            }
            return (totalKeys, maxD, totalArrays);
        }

        if (element.ValueKind == System.Text.Json.JsonValueKind.Object)
        {
            int maxD = depth;
            int totalKeys = 0;
            int totalArrays = 0;
            foreach (var prop in element.EnumerateObject())
            {
                totalKeys++;
                var (k, d, a) = CountKeys(prop.Value, depth + 1);
                totalKeys += k;
                totalArrays += a;
                if (d > maxD) maxD = d;
            }
            return (totalKeys, maxD, totalArrays);
        }

        return (0, depth, 0);
    }

    private async Task CopyJson()
    {
        if (_json == null) return;
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }
}";

