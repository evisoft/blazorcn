@code {
    private enum AttachmentType { Image, Pdf, Spreadsheet, Document, Other }

    private record Attachment(string Id, string Name, long Size, AttachmentType Type);

    private static readonly long _maxSize = 25L * 1024 * 1024; // 25 MB

    private List<Attachment> _attachments = new List<Attachment>
    {
        new(""1"", ""Q4-report-final.pdf"",  2400000, AttachmentType.Pdf),
        new(""2"", ""team-photo.jpg"",        3800000, AttachmentType.Image),
        new(""3"", ""budget-2025.xlsx"",       890000, AttachmentType.Spreadsheet),
        new(""4"", ""meeting-notes.docx"",     156000, AttachmentType.Document),
        new(""5"", ""logo-dark.svg"",           14200, AttachmentType.Image),
    };

    private long _totalSize => _attachments.Sum(a => a.Size);
    private double _usagePercent => Math.Min((_totalSize / (double)_maxSize) * 100.0, 100.0);
