                <span class=""font-medium text-sm"">Token-based authentication</span>
                <p class=""mt-0.5 text-muted-foreground text-xs"">
                    Pre-signed URLs contain embedded credentials scoped to a single upload. No API keys
                    are sent from the client. The URL expires after 15 minutes.
                </p>
            </div>
        </div>

        @* Step 1: Generate *@
        @if (_step == ""generate"")
        {
            <div class=""px-4 py-6 text-center"">
                <LucideIconCn Name=""key"" Size=""32"" Class=""mx-auto mb-3 size-8 text-muted-foreground/60"" />
                <span class=""block font-medium text-sm"">Generate a pre-signed URL</span>
                <p class=""mx-auto mt-1 max-w-sm text-muted-foreground text-xs"">
                    The server will create a temporary URL that allows a single file upload without
                    exposing storage credentials
                </p>
                <ButtonCn Size=""ButtonSize.Sm"" Class=""mt-4 h-7 gap-1 text-xs"" @onclick=""GenerateUrl"" Disabled=""@_generating"">
                    @if (_generating)
                    {
                        <LucideIconCn Name=""loader-2"" Size=""14"" Class=""size-3.5 animate-spin"" />
                        <span>Generating...</span>
                    }
                    else
                    {
                        <span>Generate URL</span>
                    }
                </ButtonCn>
            </div>
        }

        @* Steps 2+: URL Ready / Uploading / Complete *@
        @if (_step == ""ready"" || _step == ""uploading"" || _step == ""complete"")
        {
            @* URL display *@
            <div class=""border-b px-4 py-3"">
                <div class=""flex items-center justify-between"">
                    <span class=""font-medium text-muted-foreground text-xs"">Pre-signed URL</span>
                    <ButtonCn Variant=""ButtonVariant.Ghost"" Size=""ButtonSize.Sm"" Class=""h-6 gap-1 px-2 text-xs"" @onclick=""CopyUrl"">
                        @if (_copied)
                        {
                            <LucideIconCn Name=""check"" Size=""12"" Class=""size-3"" />
                            <span>Copied</span>
                        }
                        else
                        {
                            <LucideIconCn Name=""copy"" Size=""12"" Class=""size-3"" />
                            <span>Copy</span>
                        }
                    </ButtonCn>
                </div>
                <div class=""mt-1.5 rounded-md bg-muted/50 p-2.5"">
                    <p class=""break-all font-mono text-xs leading-relaxed"">@PresignedUrl</p>
                </div>
            </div>

            @* Expiry timer *@
            @if (_step == ""ready"")
            {
                <div class=""border-b px-4 py-3"">
                    <div class=""flex items-center justify-between"">
                        <span class=""flex items-center gap-1.5 text-muted-foreground text-xs"">
                            <LucideIconCn Name=""clock"" Size=""12"" Class=""size-3"" />
                            @(_isExpired ? ""URL expired"" : $""Expires in {FormatTime(_remainingSeconds)}"")
                        </span>
                        @if (_isExpired)
                        {
                            <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm"" Class=""h-6 gap-1 px-2 text-xs"" @onclick=""RegenerateUrl"">
                                <LucideIconCn Name=""refresh-cw"" Size=""12"" Class=""size-3"" />
                                <span>Regenerate</span>
                            </ButtonCn>
                        }
                    </div>
                    @if (!_isExpired)
                    {
                        <ProgressCn Value=""@_expiryPercent"" Class=""mt-2 h-1"" aria-label=""Progress"" />
                    }
                </div>
            }

            @* Upload area *@
            @if (_step == ""ready"")
            {
                <div class=""flex items-center justify-between px-4 py-3"">
                    <div class=""min-w-0 flex-1"">
                        @if (_selectedFile != null)
                        {
                            <div>
                                <span class=""truncate font-mono text-sm"">@_selectedFile</span>
                                @if (_selectedFileSize != null)
                                {
                                    <span class=""ml-2 text-muted-foreground text-xs"">@_selectedFileSize</span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class=""text-muted-foreground text-xs"">
                                Select a file to upload via pre-signed URL
                            </span>
                        }
                    </div>
                    <div class=""flex shrink-0 items-center gap-2"">
                        <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm"" Class=""h-7 text-xs"" @onclick=""SimulateChooseFile"">
                            Choose file
                        </ButtonCn>
                        <ButtonCn Size=""ButtonSize.Sm"" Class=""h-7 gap-1 text-xs"" Disabled=""@(_selectedFile == null || _isExpired)"" @onclick=""StartUpload"">
                            <LucideIconCn Name=""cloud-upload"" Size=""14"" Class=""size-3.5"" />
                            <span>Upload</span>
                        </ButtonCn>
                    </div>
                </div>
            }

            @* Uploading state *@
            @if (_step == ""uploading"")
            {
                <div class=""px-4 py-3"">
                    <div class=""flex items-center gap-3"">
                        <LucideIconCn Name=""loader-2"" Size=""16"" Class=""size-4 shrink-0 animate-spin text-muted-foreground"" />
                        <div class=""min-w-0 flex-1"">
                            <div class=""flex items-center justify-between"">
                                <span class=""truncate font-medium text-sm"">@_selectedFile</span>
                                <span class=""shrink-0 text-muted-foreground text-xs tabular-nums"">@_uploadProgress%</span>
                            </div>
                            <ProgressCn Value=""@_uploadProgress"" Class=""mt-1.5 h-1"" aria-label=""Progress"" />
                        </div>
                    </div>
                    <p class=""mt-2 text-muted-foreground text-xs"">
                        Uploading directly to storage via pre-signed URL...
                    </p>
                </div>
            }

            @* Complete state *@
            @if (_step == ""complete"")
            {
                <div class=""px-4 py-3"">
                    <div class=""flex items-center gap-3"">
                        <LucideIconCn Name=""check-circle-2"" Size=""16"" Class=""size-4 shrink-0 text-emerald-600 dark:text-emerald-400"" />
                        <div class=""min-w-0 flex-1"">
                            <span class=""font-medium text-sm"">Upload complete</span>
                            <p class=""mt-0.5 text-muted-foreground text-xs"">
                                File stored successfully. The pre-signed URL has been consumed.
                            </p>
                        </div>
                    </div>

                    @* File details *@
                    <div class=""mt-3 rounded-md bg-muted/50 p-3"">
                        <div class=""space-y-1.5"">
                            <div class=""flex items-center justify-between font-mono text-xs"">
                                <span class=""text-muted-foreground"">File</span>
                                <span>@_selectedFile</span>
                            </div>
                            <div class=""flex items-center justify-between font-mono text-xs"">
                                <span class=""text-muted-foreground"">Size</span>
                                <span>@_selectedFileSize</span>
                            </div>
                            <div class=""flex items-center justify-between font-mono text-xs"">
                                <span class=""text-muted-foreground"">ID</span>
                                <span>file_8a3b2c1d</span>
                            </div>
                            <div class=""flex items-center justify-between font-mono text-xs"">
                                <span class=""text-muted-foreground"">Status</span>
                                <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""font-normal text-xs"">
                                    Stored
                                </BadgeCn>
                            </div>
                        </div>
                    </div>

                    @* Upload another *@
                    <div class=""mt-3 flex justify-end"">
                        <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm"" Class=""h-7 gap-1 text-xs"" @onclick=""RegenerateUrl"">
                            <LucideIconCn Name=""refresh-cw"" Size=""12"" Class=""size-3"" />
                            <span>Upload another file</span>
                        </ButtonCn>
                    </div>
                </div>
            }
        }
    </div>
</section>

@code {
    private const string PresignedUrl =
        ""https://acme-prod-assets.s3.us-east-1.amazonaws.com/uploads/file_8a3b2c1d?X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Credential=AKIA...&X-Amz-Date=20260324T143200Z&X-Amz-Expires=900&X-Amz-Signature=a1b2c3d4..."";

    private const int ExpirySeconds = 900;

    private string _step = ""generate"";
    private int _remainingSeconds = ExpirySeconds;
    private string? _selectedFile = null;
    private string? _selectedFileSize = null;
    private int _uploadProgress = 0;
    private bool _copied = false;
    private bool _generating = false;

    private double _expiryPercent => (_remainingSeconds / (double)ExpirySeconds) * 100;
    private bool _isExpired => _remainingSeconds == 0 && _step == ""ready"";

    private void GenerateUrl()
    {
        _generating = true;
        // Simulate async: go straight to ready with a preset file selected for demo
        _generating = false;
        _step = ""ready"";
        _remainingSeconds = ExpirySeconds;
    }

    private void RegenerateUrl()
    {
        _step = ""generate"";
        _selectedFile = null;
        _selectedFileSize = null;
        _uploadProgress = 0;
        GenerateUrl();
    }

    private void SimulateChooseFile()
    {
        _selectedFile = ""quarterly-report-q1.pdf"";
        _selectedFileSize = ""1.4 MB"";
    }

    private void StartUpload()
    {
        _step = ""uploading"";
        _uploadProgress = 100;
        _step = ""complete"";
    }

    private void CopyUrl()
    {
        _copied = true;
    }

    private static string FormatTime(int seconds)
    {
        var m = seconds / 60;
        var s = seconds % 60;
        return $""{m}:{s:D2}"";
    }
}";

