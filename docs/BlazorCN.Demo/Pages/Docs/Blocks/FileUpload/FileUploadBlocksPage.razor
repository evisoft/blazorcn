@code {
    private enum UploadState { Idle, Dragging, Uploading, Complete }

    private class UploadedFile
    {
        public string Name { get; set; } = """";
        public string Size { get; set; } = """";
        public string Type { get; set; } = """";
    }

    private UploadState _state = UploadState.Idle;
    private int _progress = 0;
    private UploadedFile? _file = null;
    private int _dragCounter = 0;

    private string FormatSize(long bytes)
    {
        if (bytes < 1024) return $""{bytes} B"";
        if (bytes < 1024 * 1024) return $""{(bytes / 1024.0):F1} KB"";
        return $""{(bytes / (1024.0 * 1024.0)):F1} MB"";
    }

    private void HandleDragEnter(DragEventArgs e)
    {
        _dragCounter++;
        if (_dragCounter == 1)
            _state = UploadState.Dragging;
    }

    private void HandleDragLeave(DragEventArgs e)
    {
        _dragCounter--;
        if (_dragCounter == 0)
            _state = UploadState.Idle;
    }

    private void HandleDrop(DragEventArgs e)
    {
        _dragCounter = 0;
        _state = UploadState.Idle;
        // In Blazor, DataTransfer files aren't directly accessible from DragEventArgs in all render modes.
        // Simulate an upload with a placeholder file to demonstrate the UI states.
        SimulateUpload(""dropped-file.bin"", 2_500_000, ""application/octet-stream"");
    }

    private void HandleFileSelect(ChangeEventArgs e)
    {
        // File content isn't available from ChangeEventArgs in all render modes;
        // simulate an upload with a representative placeholder.
        SimulateUpload(""selected-file.pdf"", 1_200_000, ""application/pdf"");
    }

    private void TriggerFilePicker()
    {
        // In a real app, inject IJSRuntime and call JS to click the hidden input.
        // For demo purposes, simulate an upload directly.
        SimulateUpload(""demo-document.pdf"", 3_400_000, ""application/pdf"");
    }

    private void SimulateUpload(string name, long sizeBytes, string type)
    {
        _file = new UploadedFile
        {
            Name = name,
            Size = FormatSize(sizeBytes),
            Type = type
        };
        _state = UploadState.Uploading;
        _progress = 75; // static snapshot for SSR/demo — real progress needs a timer
    }

    private void Reset()
    {
        _state = UploadState.Idle;
        _progress = 0;
        _file = null;
        _dragCounter = 0;
    }
}";

