            </div>
        </div>

        @* File list *@
        <div>
            @for (int i = 0; i < _files.Count; i++)
            {
                var file = _files[i];
                var isLast = i == _files.Count - 1;
                var isExpanded = _expanded == file.Id;
                var cfg = GetStatusConfig(file.Status);
                <div class=""@Cn.Merge(isLast && !isExpanded ? """" : ""border-b"")"">
                    <button
