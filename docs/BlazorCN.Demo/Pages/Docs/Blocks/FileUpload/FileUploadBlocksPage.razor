    private void AddComment(string fileId)
    {
        _commentInputs.TryGetValue(fileId, out var text);
        var trimmed = text?.Trim();
        if (string.IsNullOrEmpty(trimmed)) return;

        var file = _files.FirstOrDefault(f => f.Id == fileId);
        if (file is null) return;

        file.Comments.Add(new CommentEntry(
            $""c-{file.Comments.Count + 1}"",
            ""You"",
            trimmed,
            ""Just now""
        ));
        _commentInputs[fileId] = """";
    }

    private void HandleCommentKeyDown(KeyboardEventArgs e, string fileId)
    {
        if (e.Key == ""Enter"")
            AddComment(fileId);
    }
