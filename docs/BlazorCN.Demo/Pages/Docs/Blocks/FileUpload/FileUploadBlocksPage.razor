        public bool Expanded { get; set; }
        public TreeFile[] Files { get; set; } = [];
        public TreeFolder[] Folders { get; set; } = [];
    }

    private TreeFolder[] _tree = [];
    private bool _isDragOver = false;

    private int _totalFiles => CountFiles(_tree);
    private int _totalFolders => CountFolders(_tree);

    protected override void OnInitialized()
    {
        _tree =
        [
