@code {
    private record FileVersion(string Id, int Version, string Name, string Size, long SizeBytes, string UploadedBy, string Timestamp, bool IsCurrent);
    private record SizeDiffResult(string Label, bool Positive);

    private static readonly FileVersion[] _versions =
    [
        new(""v5"", 5, ""design-system-spec.pdf"", ""4.2 MB"", 4404019, ""Sarah Chen"",    ""Today, 2:15 PM"",      true),
        new(""v4"", 4, ""design-system-spec.pdf"", ""3.8 MB"", 3984588, ""Marcus Rivera"", ""Yesterday, 11:30 AM"", false),
        new(""v3"", 3, ""design-system-spec.pdf"", ""3.1 MB"", 3250585, ""Sarah Chen"",    ""Mar 21, 4:45 PM"",     false),
        new(""v2"", 2, ""design-system-spec.pdf"", ""2.6 MB"", 2726297, ""Alex Kim"",      ""Mar 19, 9:10 AM"",     false),
        new(""v1"", 1, ""design-system-spec.pdf"", ""1.9 MB"", 1992294, ""Sarah Chen"",    ""Mar 17, 3:00 PM"",     false),
    ];

    private string? _expanded = ""v4"";

    private static SizeDiffResult FormatSizeDiff(long current, long previous)
    {
        var diff = current - previous;
        var diffKB = Math.Abs(diff) / 1024.0;
        if (diffKB < 1) return new SizeDiffResult(""No change"", false);
        var formatted = diffKB >= 1024
            ? $""{(diffKB / 1024.0).ToString(""F1"")} MB""
            : $""{(int)Math.Round(diffKB)} KB"";
        return new SizeDiffResult(
            diff > 0 ? $""+{formatted}"" : $""-{formatted}"",
            diff > 0
        );
    }
}";

