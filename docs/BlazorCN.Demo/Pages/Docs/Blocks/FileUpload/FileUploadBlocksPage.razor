@code {
    private enum ImportStep { Download, Upload, Validating, Results }

    private record ValidationError(string Id, int Row, string Field, string Value, string Message);

    private static readonly ValidationError[] _sampleErrors =
    [
        new(""e1"", 3,  ""email"",      ""john@"",           ""Invalid email format. Must include a domain (e.g., john@company.com).""),
        new(""e2"", 7,  ""phone"",      ""+1-555"",           ""Phone number is incomplete. Must be at least 10 digits including country code.""),
        new(""e3"", 12, ""department"", ""Mktg"",             ""Value does not match any valid department. Expected one of: Marketing, Engineering, Sales, Design, Operations.""),
        new(""e4"", 15, ""start_date"", ""13/25/2025"",       ""Invalid date format. Use YYYY-MM-DD (e.g., 2025-03-24).""),
        new(""e5"", 22, ""salary"",     ""eighty thousand"",  ""Must be a numeric value without currency symbols or text (e.g., 80000).""),
    ];

    private static readonly int _totalRows = 48;
    private static readonly int _validRows = _totalRows - _sampleErrors.Length;

    private ImportStep _step = ImportStep.Download;
    private string? _expandedError = ""e1"";
    private string _fileName = """";

    private void HandleDownloadClick()
    {
        if (_step == ImportStep.Download)
            _step = ImportStep.Upload;
    }

    private void HandleChooseFile()
    {
        // Simulate a file being chosen
        _fileName = ""employee-data.csv"";
        _step = ImportStep.Validating;
        // In a real app we'd use JS interop; here we jump directly to results
        _step = ImportStep.Results;
    }

    private void HandleReUpload()
    {
        _step = ImportStep.Upload;
        _expandedError = null;
    }

    private void ToggleError(string id)
    {
        _expandedError = _expandedError == id ? null : id;
    }
}";

