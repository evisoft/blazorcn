                        <div class=""flex items-center justify-between"">
                            <span class=""text-muted-foreground text-xs"">Expired action</span>
                            <span class=""font-medium text-xs"">@(_archiveEnabled ? ""Archive"" : ""Delete"")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

