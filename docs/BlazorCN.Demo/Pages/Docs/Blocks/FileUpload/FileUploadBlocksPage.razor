        public string Size { get; set; } = """";
        public string Dimensions { get; set; } = """";
    }

    private List<ProductImage> _images =
    [
        new ProductImage { Id = ""1"", Name = ""front-view.jpg"",       Size = ""1.8 MB"", Dimensions = ""2400 x 2400"" },
        new ProductImage { Id = ""2"", Name = ""back-view.jpg"",        Size = ""1.6 MB"", Dimensions = ""2400 x 2400"" },
        new ProductImage { Id = ""3"", Name = ""side-angle-left.jpg"",  Size = ""2.1 MB"", Dimensions = ""2400 x 2400"" },
        new ProductImage { Id = ""4"", Name = ""detail-closeup.jpg"",   Size = ""1.4 MB"", Dimensions = ""1800 x 1800"" },
        new ProductImage { Id = ""5"", Name = ""lifestyle-shot.jpg"",   Size = ""2.8 MB"", Dimensions = ""3200 x 2400"" },
        new ProductImage { Id = ""6"", Name = ""packaging.jpg"",        Size = ""1.2 MB"", Dimensions = ""2400 x 2400"" },
    ];

    private string _primaryId = ""1"";
    private string? _hoveredId = null;

    private ProductImage? _primaryImage => _images.Find(img => img.Id == _primaryId) ?? (_images.Count > 0 ? _images[0] : null);
    private List<ProductImage> _additionalImages => _images.FindAll(img => img.Id != _primaryId);

    private void SetPrimary(string id)
    {
        _primaryId = id;
    }

    private void RemoveImage(string id)
    {
        if (_primaryId == id && _images.Count > 1)
        {
            var remaining = _images.FindAll(img => img.Id != id);
            _primaryId = remaining[0].Id;
        }
        _images.RemoveAll(img => img.Id == id);
        if (_hoveredId == id)
        {
            _hoveredId = null;
        }
    }
}";

