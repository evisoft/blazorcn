            ""2.4 GB"",
            ""Mar 20, 2026 at 14:32 UTC"",
            ""PostgreSQL"",
            47,
            ""1,284,391""
        );
        _validation = ""validating"";
        StateHasChanged();
        await Task.Delay(1500);
        _validation = ""valid"";
    }

    private async Task HandleRestore()
    {
        _restoring = true;
        StateHasChanged();
        await Task.Delay(2000);
