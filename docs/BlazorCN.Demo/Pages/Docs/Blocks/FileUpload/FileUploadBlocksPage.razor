@code {
    private record QualityOption(string Value, string Label);

    private static readonly Dictionary<string, string[]> _formatOptions = new()
    {
        [""png""]  = [""JPG"", ""WebP"", ""SVG"", ""ICO"", ""BMP""],
        [""jpg""]  = [""PNG"", ""WebP"", ""SVG"", ""BMP""],
        [""jpeg""] = [""PNG"", ""WebP"", ""SVG"", ""BMP""],
        [""webp""] = [""PNG"", ""JPG"", ""SVG""],
        [""pdf""]  = [""DOCX"", ""TXT"", ""PNG"", ""JPG""],
        [""docx""] = [""PDF"", ""TXT"", ""HTML"", ""MD""],
        [""mp4""]  = [""GIF"", ""WebM"", ""AVI"", ""MOV""],
        [""mov""]  = [""MP4"", ""GIF"", ""WebM""],
        [""svg""]  = [""PNG"", ""JPG"", ""WebP""],
    };

    private static readonly QualityOption[] _qualityOptions =
    [
        new(""low"",    ""Low (smaller file)""),
        new(""medium"", ""Medium (balanced)""),
        new(""high"",   ""High (best quality)""),
    ];

    private string _state = ""idle"";
    private string _fileName = """";
    private string _fileSize = """";
    private string _fileExt = """";
    private string _targetFormat = """";
    private string _quality = ""high"";
    private int _progress = 0;
    private string _outputSize = """";

    private string[] _availableFormats => _formatOptions.TryGetValue(_fileExt, out var fmts) ? fmts : [];
    private string _outputName => System.Text.RegularExpressions.Regex.Replace(_fileName, @""\.[^.]+$"", $"".{_targetFormat.ToLower()}"");

    private System.Threading.Timer? _timer;

    private void SimulateUpload()
    {
        // Simulate uploading a demo PNG file
        _fileName = ""photo-landscape.png"";
        _fileSize = ""2.4 MB"";
        _fileExt = ""png"";
        _targetFormat = """";
        _quality = ""high"";
        _progress = 0;
        _outputSize = """";
        _state = ""uploaded"";
    }

    private void StartConversion()
    {
        if (string.IsNullOrEmpty(_targetFormat)) return;
        _state = ""converting"";
        _progress = 0;

        _timer?.Dispose();
        _timer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                var increment = 5 + (int)(_progress / 15.0);
                _progress += increment;
                if (_progress >= 100)
                {
                    _progress = 100;
                    _timer?.Dispose();
                    _timer = null;

                    var sizeMultiplier = _quality == ""high"" ? 0.85 : _quality == ""medium"" ? 0.6 : 0.35;
                    var estimatedKb = 1840.0 * sizeMultiplier;
                    _outputSize = estimatedKb >= 1024
                        ? $""{(estimatedKb / 1024.0):F1} MB""
                        : $""{estimatedKb:F0} KB"";
                    _state = ""complete"";
                }
                StateHasChanged();
            });
        }, null, 120, 120);
    }

    private void Reset()
    {
        _timer?.Dispose();
        _timer = null;
        _state = ""idle"";
        _fileName = """";
        _fileSize = """";
        _fileExt = """";
        _targetFormat = """";
        _quality = ""high"";
        _progress = 0;
        _outputSize = """";
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _timer = null;
    }
}
";

