    private record ArchiveEntry(string Id, string Name, string Type, string Size, int Depth, string Format = """", int Children = 0);

    private const string _archiveName = ""project-assets-v2.3.zip"";
    private const string _archiveSize = ""48.2 MB"";
    private const string _uncompressedSize = ""124.6 MB"";

    private static readonly ArchiveEntry[] _entries =
    [
        new(""e1"",  ""src"",             ""folder"", """",        0, Children: 4),
        new(""e2"",  ""index.tsx"",       ""file"",   ""4.2 KB"",  1, ""TSX""),
        new(""e3"",  ""app.tsx"",         ""file"",   ""8.1 KB"",  1, ""TSX""),
        new(""e4"",  ""utils.ts"",        ""file"",   ""2.8 KB"",  1, ""TS""),
        new(""e5"",  ""styles.css"",      ""file"",   ""12.4 KB"", 1, ""CSS""),
        new(""e6"",  ""assets"",          ""folder"", """",        0, Children: 3),
        new(""e7"",  ""logo.svg"",        ""file"",   ""6.8 KB"",  1, ""SVG""),
        new(""e8"",  ""hero-image.webp"", ""file"",   ""284 KB"",  1, ""WebP""),
        new(""e9"",  ""icon-sprite.svg"", ""file"",   ""18.2 KB"", 1, ""SVG""),
        new(""e10"", ""docs"",            ""folder"", """",        0, Children: 2),
        new(""e11"", ""README.md"",       ""file"",   ""3.4 KB"",  1, ""MD""),
        new(""e12"", ""CHANGELOG.md"",    ""file"",   ""8.9 KB"",  1, ""MD""),
        new(""e13"", ""package.json"",    ""file"",   ""1.2 KB"",  0, ""JSON""),
        new(""e14"", ""tsconfig.json"",   ""file"",   ""680 B"",   0, ""JSON""),
    ];

    private static readonly int _totalFiles   = _entries.Count(e => e.Type == ""file"");
    private static readonly int _totalFolders = _entries.Count(e => e.Type == ""folder"");

    private HashSet<string> _selected          = [];
    private HashSet<string> _collapsedFolders  = [];
    private bool _extracting    = false;
    private int  _extractProgress = 0;
    private bool _extracted     = false;

    private int _selectedCount => _selected.Count;

    private void ToggleSelect(string id)
    {
        if (_selected.Contains(id))
            _selected.Remove(id);
        else
            _selected.Add(id);
    }

    private void SelectAll()
    {
        var fileIds = _entries.Where(e => e.Type == ""file"").Select(e => e.Id).ToHashSet();
        if (_selected.Count == fileIds.Count)
            _selected = [];
        else
            _selected = fileIds;
    }

    private void ToggleFolder(string id)
    {
        if (_collapsedFolders.Contains(id))
            _collapsedFolders.Remove(id);
        else
            _collapsedFolders.Add(id);
    }

    private System.Threading.Timer? _timer;

    private void HandleExtract()
    {
        _extracting = true;
        _extractProgress = 0;
        _extracted = false;
        _timer?.Dispose();
        _timer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                _extractProgress += 8;
                if (_extractProgress >= 100)
                {
                    _extractProgress = 100;
                    _extracting = false;
                    _extracted = true;
                    _timer?.Dispose();
                    _timer = null;
                }
                StateHasChanged();
            });
        }, null, 200, 200);
    }

    private void ExtractAll()
    {
        SelectAll();
        HandleExtract();
    }

    private ArchiveEntry[] GetVisibleEntries()
    {
        var result = new System.Collections.Generic.List<ArchiveEntry>();
        bool currentFolderCollapsed = false;
        foreach (var entry in _entries)
        {
            if (entry.Type == ""folder"")
            {
                currentFolderCollapsed = _collapsedFolders.Contains(entry.Id);
                result.Add(entry);
            }
            else
            {
                if (entry.Depth > 0 && currentFolderCollapsed)
                    continue;
                result.Add(entry);
            }
        }
        return result.ToArray();
    }
}
";

