                var fileItems = currentItems.Where(i => i.Type != ""folder"").ToArray();
            }

            @* Folders section *@
            @if (folders.Length > 0)
            {
                <div class=""px-4 py-2"">
                    <span class=""font-medium text-muted-foreground text-xs"">Folders</span>
                </div>
                @for (var i = 0; i < folders.Length; i++)
                {
                    var folder = folders[i];
