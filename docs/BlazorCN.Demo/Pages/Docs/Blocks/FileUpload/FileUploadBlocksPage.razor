                    var file = fileItems[i];
                    var fileIdx = i;
                    var showBorder = fileIdx < fileItems.Length - 1;
                    <div class=""@Cn.Merge(""flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50"", showBorder ? ""border-b"" : """")"">
                        @GetTypeIcon(file.Type)
                        <div class=""min-w-0 flex-1"">
                            <span class=""truncate font-medium text-sm"">@file.Name</span>
                        </div>
