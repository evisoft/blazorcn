                        </div>
                        <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""shrink-0 font-normal text-xs"">
                            @cfg.Label
                        </BadgeCn>
                        <LucideIconCn Name=""chevron-right"" Size=""16"" Class=""@Cn.Merge(""size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200"", isExpanded ? ""rotate-90"" : """")"" />
                    </button>

                    @if (isExpanded)
                    {
                        var expandedFile = file;
                        <div class=""px-4 pb-4 pl-9"">
                            @* Reviewer & actions *@
                            <div class=""mb-3 flex items-center gap-3"">
                                <span class=""text-muted-foreground text-xs"">
                                    Reviewer: <span class=""font-medium text-foreground"">@expandedFile.Reviewer</span>
                                </span>
                                @if (expandedFile.Status == ""pending"")
                                {
                                    var pendingFileId = expandedFile.Id;
                                    <ButtonCn
                                        Variant=""ButtonVariant.Outline""
                                        Size=""ButtonSize.Sm""
                                        Class=""ml-auto h-6 gap-1 px-2 text-xs""
                                        OnClick=""@((MouseEventArgs e) => UpdateStatus(pendingFileId, ""under_review""))"">
                                        Start Review
                                    </ButtonCn>
                                }
                                @if (expandedFile.Status == ""under_review"")
                                {
                                    var reviewFileId = expandedFile.Id;
                                    <div class=""ml-auto flex items-center gap-1.5"">
                                        <ButtonCn
                                            Variant=""ButtonVariant.Outline""
                                            Size=""ButtonSize.Sm""
                                            Class=""h-6 gap-1 px-2 text-xs""
                                            OnClick=""@((MouseEventArgs e) => UpdateStatus(reviewFileId, ""rejected""))"">
                                            <LucideIconCn Name=""x-circle"" Size=""12"" Class=""size-3"" />
