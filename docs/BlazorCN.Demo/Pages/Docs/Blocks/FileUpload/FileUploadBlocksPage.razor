    {
        _activeFilter = _activeFilter == level ? null : level;
    }

    private LogEntry[] Filtered()
    {
        if (_entries == null) return [];
        return _entries.Where(entry =>
        {
            if (_activeFilter != null && entry.Severity != _activeFilter) return false;
            if (!string.IsNullOrEmpty(_search) && !entry.Message.Contains(_search, StringComparison.OrdinalIgnoreCase)) return false;
