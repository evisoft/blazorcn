@code {
    private bool _hasAvatar = false;
    private string? _fileName = null;
    private string? _fileSize = null;

    private async Task HandleFileChange(ChangeEventArgs e)
    {
        // In a static/presentational port we simulate file selection.
        // Blazor's plain onchange on <input type=""file""> gives us only the filename string.
        var raw = e.Value?.ToString();
        if (string.IsNullOrEmpty(raw)) return;

        // Extract just the filename (browsers include the fake path ""C:\fakepath\name.ext"")
        var name = System.IO.Path.GetFileName(raw);
        if (string.IsNullOrEmpty(name)) return;

        // We don't have real file size from a plain input; show a placeholder.
        _fileName = name;
        _fileSize = ""—"";
        _hasAvatar = true;
        await Task.CompletedTask;
    }

    private void RemoveAvatar()
    {
        _hasAvatar = false;
        _fileName = null;
        _fileSize = null;
    }
}";

