    private record FileInfo(
        string Name,
        string Size,
        int SizeBytes,
        string Format,
        string Dimensions,
        string ColorSpace,
        string LastModified
    );

    private record MetadataRow(string Label, string Before, string After);

    private static readonly FileInfo BeforeFile = new(
        Name: ""homepage-hero.png"",
        Size: ""4.2 MB"",
        SizeBytes: 4404019,
        Format: ""PNG"",
        Dimensions: ""2880 x 1620"",
        ColorSpace: ""sRGB"",
        LastModified: ""Mar 12, 2026""
    );

    private static readonly FileInfo AfterFile = new(
        Name: ""homepage-hero.webp"",
        Size: ""1.1 MB"",
        SizeBytes: 1153434,
        Format: ""WebP"",
        Dimensions: ""2880 x 1620"",
        ColorSpace: ""sRGB"",
        LastModified: ""Mar 18, 2026""
    );

    private FileInfo? _before = BeforeFile;
    private FileInfo? _after = AfterFile;

    private MetadataRow[] _metadataRows => _before is not null && _after is not null
        ? [
            new MetadataRow(""Format"", _before.Format, _after.Format),
            new MetadataRow(""Dimensions"", _before.Dimensions, _after.Dimensions),
            new MetadataRow(""File size"", _before.Size, _after.Size),
            new MetadataRow(""Color space"", _before.ColorSpace, _after.ColorSpace),
            new MetadataRow(""Last modified"", _before.LastModified, _after.LastModified),
          ]
        : [];

    private string? _sizeReduction => _before is not null && _after is not null
        ? ((_before.SizeBytes - _after.SizeBytes) / (double)_before.SizeBytes * 100.0).ToString(""F1"")
        : null;

    private bool _sizeReduced => _before is not null && _after is not null && _after.SizeBytes < _before.SizeBytes;

    private void ClearBefore() => _before = null;
    private void ClearAfter() => _after = null;
    private void SetBefore() => _before = BeforeFile;
    private void SetAfter() => _after = AfterFile;
}";

