    private class OrderedFile
    {
        public string Id { get; set; } = """";
        public string Name { get; set; } = """";
        public string Size { get; set; } = """";
        public string Type { get; set; } = """";
    }

    private List<OrderedFile> _files =
    [
        new OrderedFile { Id = ""f1"", Name = ""cover-photo.jpg"",               Size = ""2.1 MB"", Type = ""image/jpeg""        },
        new OrderedFile { Id = ""f2"", Name = ""chapter-01-introduction.pdf"",   Size = ""840 KB"", Type = ""application/pdf""   },
        new OrderedFile { Id = ""f3"", Name = ""chapter-02-methodology.pdf"",    Size = ""1.2 MB"", Type = ""application/pdf""   },
        new OrderedFile { Id = ""f4"", Name = ""chapter-03-results.pdf"",        Size = ""3.4 MB"", Type = ""application/pdf""   },
        new OrderedFile { Id = ""f5"", Name = ""data-appendix.xlsx"",            Size = ""560 KB"", Type = ""application/xlsx""  },
        new OrderedFile { Id = ""f6"", Name = ""references.pdf"",                Size = ""420 KB"", Type = ""application/pdf""   },
        new OrderedFile { Id = ""f7"", Name = ""back-cover.jpg"",                Size = ""1.8 MB"", Type = ""image/jpeg""        },
    ];

    private bool _saved = false;
    private int? _dragIndex = null;
    private int? _dragOverIndex = null;
    private int _dragCounter = 0;

    private void MoveUp(int index)
    {
        if (index == 0) return;
        var temp = _files[index - 1];
        _files[index - 1] = _files[index];
        _files[index] = temp;
        _saved = false;
    }

    private void MoveDown(int index)
    {
        if (index == _files.Count - 1) return;
        var temp = _files[index + 1];
        _files[index + 1] = _files[index];
        _files[index] = temp;
        _saved = false;
    }

    private void HandleDragStart(int index)
    {
        _dragIndex = index;
    }

    private void HandleDragEnter(int index)
    {
        _dragCounter++;
        _dragOverIndex = index;
    }

    private void HandleDragLeave(DragEventArgs e)
    {
        _dragCounter--;
        if (_dragCounter == 0)
        {
            _dragOverIndex = null;
        }
    }

    private void HandleDrop(int targetIndex)
    {
        _dragCounter = 0;
        if (_dragIndex == null || _dragIndex == targetIndex)
        {
            _dragIndex = null;
            _dragOverIndex = null;
            return;
        }
        var dragged = _files[_dragIndex.Value];
        _files.RemoveAt(_dragIndex.Value);
        _files.Insert(targetIndex, dragged);
        _dragIndex = null;
        _dragOverIndex = null;
        _saved = false;
    }

    private void HandleDragEnd(DragEventArgs e)
    {
        _dragIndex = null;
        _dragOverIndex = null;
        _dragCounter = 0;
    }

    private void HandleSave()
    {
        _saved = true;
    }
}";

