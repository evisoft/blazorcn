@code {
    private record Annotation(string Id, int Number, double X, double Y, string Note)
    {
        public string Note { get; set; } = Note;
    }

    private List<Annotation> _annotations =
    [
        new(""a1"", 1, 25, 18, ""Logo alignment is off by 4px on retina displays""),
        new(""a2"", 2, 62, 42, ""Replace placeholder with product screenshot""),
        new(""a3"", 3, 40, 75, ""CTA button needs higher contrast ratio""),
    ];

    private string? _selectedId = null;
    private string _editNote = """";
    private bool _copied = false;

    private void HandleCanvasClick(MouseEventArgs e)
    {
        // Without a JS interop bounding-rect call, we can't compute exact % coords from MouseEventArgs.
        // We use ClientX/ClientY as a best-effort approximation (falls back gracefully in SSR/prerender).
        // A full implementation would use JS interop to get the element's bounding rect.
        var newId = $""a{_annotations.Count + 1}-{(int)e.ClientX}"";
        var newPin = new Annotation(newId, _annotations.Count + 1, 50, 50, """");
        _annotations.Add(newPin);
        _selectedId = newPin.Id;
        _editNote = """";
    }

    private void SelectPin(string id, string note)
    {
        if (_selectedId == id)
        {
            _selectedId = null;
        }
        else
        {
            _selectedId = id;
            _editNote = note;
        }
    }

    private void UpdateNote(string id)
    {
        var pin = _annotations.FirstOrDefault(a => a.Id == id);
        if (pin != null)
        {
            pin.Note = _editNote;
        }
        _selectedId = null;
    }

    private void RemoveAnnotation(string id)
    {
        _annotations.RemoveAll(a => a.Id == id);
        // Renumber
        for (int i = 0; i < _annotations.Count; i++)
        {
            var old = _annotations[i];
            _annotations[i] = old with { Number = i + 1 };
        }
        if (_selectedId == id) _selectedId = null;
    }

    private async Task ExportAnnotations()
    {
        // clipboard.writeText is not available in server-side Blazor without JS interop;
        // we toggle the copied indicator as a visual affordance.
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }
}";

