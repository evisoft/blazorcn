                                            Size=""ButtonSize.Sm""
                                            Class=""h-6 gap-1 px-2 text-xs""
                                            OnClick=""@((MouseEventArgs e) => UpdateStatus(reviewFileId, ""approved""))"">
                                            <LucideIconCn Name=""check-circle-2"" Size=""12"" Class=""size-3"" />
                                            Approve
                                        </ButtonCn>
                                    </div>
                                }
                            </div>

                            @* Comments thread *@
                            @if (expandedFile.Comments.Count > 0)
                            {
                                <div class=""mb-3 space-y-2"">
                                    <span class=""flex items-center gap-1.5 text-muted-foreground text-xs"">
                                        <LucideIconCn Name=""message-square"" Size=""12"" Class=""size-3"" />
                                        @expandedFile.Comments.Count @(expandedFile.Comments.Count == 1 ? ""comment"" : ""comments"")
                                    </span>
