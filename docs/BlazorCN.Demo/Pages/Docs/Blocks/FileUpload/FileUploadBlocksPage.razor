@code {
    private enum FetchStatus { Idle, Fetching, Fetched, Error }

    private class FileInfo
    {
        public string Name { get; set; } = """";
        public string Size { get; set; } = """";
        public string Type { get; set; } = """";
        public string Url { get; set; } = """";
    }

    private string _url = """";
    private FetchStatus _fetchStatus = FetchStatus.Idle;
    private FileInfo? _fetchedFile = null;
    private FileInfo? _selectedFile = null;
    private bool _confirmed = false;

    private bool _isValidUrl => _url.StartsWith(""http://"") || _url.StartsWith(""https://"");

    private async Task HandleFetch()
    {
        _fetchStatus = FetchStatus.Fetching;
        _fetchedFile = null;
        StateHasChanged();

        await Task.Delay(1200);

        var parts = _url.Split('/');
        var filename = parts.Length > 0 ? parts[^1] : ""remote-file"";
        if (string.IsNullOrEmpty(filename)) filename = ""remote-file"";
        _fetchedFile = new FileInfo
        {
            Name = filename.Contains('.') ? filename : $""{filename}.pdf"",
            Size = ""3.8 MB"",
            Type = ""application/pdf"",
            Url = _url,
        };
        _fetchStatus = FetchStatus.Fetched;
    }

    private void HandleConfirm()
    {
        _confirmed = true;
    }

    private void ClearSelectedFile()
    {
        _selectedFile = null;
    }

    private void ClearFetchedFile()
    {
        _fetchStatus = FetchStatus.Idle;
        _fetchedFile = null;
        _url = """";
    }

    private void TriggerFileBrowse()
    {
        // File input click requires JS interop; no-op in this presentational port
    }

    private void Reset()
    {
        _url = """";
        _fetchStatus = FetchStatus.Idle;
        _fetchedFile = null;
        _selectedFile = null;
        _confirmed = false;
    }
}";

