@code {
    private record CompressedFile(
        string Id,
        string Name,
        long OriginalSize,
        long CompressedSize,
        string Type
    );

    private List<CompressedFile> _files =
    [
        new(""f1"", ""hero-banner.png"",       4_832_256, 1_256_448, ""image/png""),
        new(""f2"", ""product-photo-01.jpg"",  2_145_280,   687_104, ""image/jpeg""),
        new(""f3"", ""team-group-shot.jpg"",   3_567_616, 1_070_284, ""image/jpeg""),
        new(""f4"", ""background-pattern.png"",1_048_576,   314_572, ""image/png""),
        new(""f5"", ""icon-set-export.webp"",    524_288,   178_257, ""image/webp""),
    ];

    private int _quality = 75;

    private long GetAdjustedCompressedSize(CompressedFile file)
    {
        var baseRatio = (double)file.CompressedSize / file.OriginalSize;
        var qualityFactor = _quality / 75.0;
        var adjustedRatio = Math.Min(baseRatio * qualityFactor, 0.98);
        return (long)Math.Round(file.OriginalSize * adjustedRatio);
    }

    private long TotalOriginal => _files.Sum(f => f.OriginalSize);
    private long TotalCompressed => _files.Sum(f => GetAdjustedCompressedSize(f));
    private long TotalSaved => TotalOriginal - TotalCompressed;
    private int TotalRatio => TotalOriginal > 0
        ? (int)Math.Round((1.0 - (double)TotalCompressed / TotalOriginal) * 100)
        : 0;

    private void SetQuality(int v)
    {
        _quality = v;
    }

    private void RemoveFile(string id)
    {
        _files.RemoveAll(f => f.Id == id);
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $""{bytes} B"";
        if (bytes < 1024 * 1024) return $""{(bytes / 1024.0):F1} KB"";
        return $""{(bytes / (1024.0 * 1024.0)):F2} MB"";
    }
}";

