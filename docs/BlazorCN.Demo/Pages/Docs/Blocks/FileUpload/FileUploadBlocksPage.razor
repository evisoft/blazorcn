                    </button>
                }
            }

            @* Files section *@
            @if (fileItems.Length > 0)
            {
                <div class=""px-4 py-2"">
                    <span class=""font-medium text-muted-foreground text-xs"">Files</span>
                </div>
                @for (var i = 0; i < fileItems.Length; i++)
