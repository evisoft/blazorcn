        string Expiry,
        string ExpiryLabel,
        string Countdown,
        int Downloads,
        string CreatedAt
    );

    private record ExpiryOption(string Value, string Label);

    private static readonly ExpiryOption[] _expiryOptions =
    [
        new(""1h"", ""1 hour""),
        new(""24h"", ""24 hours""),
        new(""7d"", ""7 days""),
        new(""30d"", ""30 days""),
    ];

    private List<UploadedFile> _files =
    [
        new(""1"", ""contract-draft-v2.pdf"", ""3.2 MB"", ""https://share.acme.io/f/a8k2m9x"",
            ""24h"", ""24 hours"", ""18h 42m remaining"", 3, ""5 hours ago""),
        new(""2"", ""design-assets-march.zip"", ""48.7 MB"", ""https://share.acme.io/f/p3n7v1q"",
            ""7d"", ""7 days"", ""5d 11h remaining"", 12, ""Yesterday""),
    ];

    private string _expiry = ""24h"";
    private string? _copied = null;
    private bool _showUpload = true;

    private void CopyLink(string id, string link)
    {
        _copied = id;
    }

    private void RemoveFile(string id)
    {
        _files = _files.Where(f => f.Id != id).ToList();
    }

    private void HandleUpload()
    {
        var expiryOption = _expiryOptions.FirstOrDefault(o => o.Value == _expiry);
        var countdown = _expiry switch
        {
            ""1h"" => ""59m remaining"",
            ""24h"" => ""23h 59m remaining"",
            ""7d"" => ""6d 23h remaining"",
            _ => ""29d 23h remaining"",
        };
        var newFile = new UploadedFile(
            Id: $""{_files.Count + 1}"",
            Name: ""quarterly-report-q1.pdf"",
            Size: ""1.4 MB"",
            Link: ""https://share.acme.io/f/hmpstuw"",
            Expiry: _expiry,
            ExpiryLabel: expiryOption?.Label ?? _expiry,
            Countdown: countdown,
            Downloads: 0,
            CreatedAt: ""Just now""
        );
        _files = new List<UploadedFile> { newFile }.Concat(_files).ToList();
        _showUpload = false;
    }
}";

