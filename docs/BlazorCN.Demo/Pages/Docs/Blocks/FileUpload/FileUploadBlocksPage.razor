    private record MarkdownStats(int Words, int Headings, int Lines, int Characters);

    private static readonly string SampleMarkdown =
        ""# Project Overview\n"" +
        ""\n"" +
        ""A comprehensive guide to building modern web applications with **React** and **Next.js**.\n"" +
        ""\n"" +
        ""## Getting Started\n"" +
        ""\n"" +
        ""Install the dependencies and run the development server:\n"" +
        ""\n"" +
        ""```bash\n"" +
        ""npm install\n"" +
        ""npm run dev\n"" +
        ""```\n"" +
        ""\n"" +
        ""## Architecture\n"" +
        ""\n"" +
        ""The application uses the **App Router** with React Server Components for optimal performance.\n"" +
        ""\n"" +
        ""### Key Features\n"" +
        ""\n"" +
        ""- Server-side rendering with streaming\n"" +
        ""- Automatic code splitting\n"" +
        ""- Built-in image optimization\n"" +
        ""- TypeScript support out of the box\n"" +
        ""\n"" +
        ""### Directory Structure\n"" +
        ""\n"" +
        ""| Directory | Purpose |\n"" +
        ""|-----------|----------|\n"" +
        ""| `app/` | Routes and layouts |\n"" +
        ""| `components/` | Reusable UI components |\n"" +
        ""| `lib/` | Utility functions |\n"" +
        ""\n"" +
        ""## Deployment\n"" +
        ""\n"" +
        ""Deploy to Vercel with a single command:\n"" +
        ""\n"" +
        ""```bash\n"" +
        ""npx vercel\n"" +
        ""```\n"" +
        ""\n"" +
        ""> Note: Ensure all environment variables are configured before deploying to production."";

    private string? _source = null;
    private string _fileName = """";
    private string _activeTab = ""preview"";
    private bool _copied = false;
    private bool _isDragging = false;

    private MarkdownStats? _stats => _source != null ? GetStats(_source) : null;
    private string[] _preview => _source != null ? RenderPreview(_source) : [];

    private void HandleUpload()
    {
        _source = SampleMarkdown;
        _fileName = ""project-overview.md"";
    }

    private async Task CopySource()
    {
        if (_source == null) return;
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }

    private static MarkdownStats GetStats(string text)
    {
        var words = text.Split(new char[] { ' ', '\t', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries).Length;
        var lines = text.Split('\n');
        var headings = 0;
        foreach (var line in lines)
        {
            var trimmed = line.TrimStart('#');
            if (trimmed.Length < line.Length && trimmed.StartsWith("" ""))
                headings++;
        }
        return new MarkdownStats(words, headings, lines.Length, text.Length);
    }

    private static string[] RenderPreview(string markdown)
    {
        var lines = markdown.Split('\n');
        var result = new string[lines.Length];
        for (int i = 0; i < lines.Length; i++)
        {
            var line = lines[i];
            if (line.StartsWith(""### ""))
                result[i] = ""h3:"" + line[4..];
            else if (line.StartsWith(""## ""))
                result[i] = ""h2:"" + line[3..];
            else if (line.StartsWith(""# ""))
                result[i] = ""h1:"" + line[2..];
            else if (line.StartsWith(""- ""))
                result[i] = ""li:"" + line[2..];
            else if (line.StartsWith(""> ""))
                result[i] = ""bq:"" + line[2..];
            else if (line.StartsWith(""```""))
                result[i] = ""code"";
            else if (line.StartsWith(""|""))
                result[i] = ""tbl:"" + line;
            else if (line.Trim() == """")
                result[i] = ""br"";
            else
                result[i] = ""p:"" + line;
        }
        return result;
    }
}";

