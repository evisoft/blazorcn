@* ============================================================
   Block: file-upload-mobile-responsive
   Title: FileUploadMobileResponsive
   Description: A mobile-optimized file upload block with large touch-friendly upload button, camera capture shortcut, compact file chips, and fullscreen preview designed for small screens using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-mobile-responsive.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Upload files</span>
            <span class="text-muted-foreground text-xs">
                @_files.Length @(_files.Length == 1 ? "file" : "files")
            </span>
        </div>

        @* Upload area - large touch targets *@
        <div class="border-b px-4 py-4">
            <div class="grid grid-cols-2 gap-3">
                <button
                    type="button"
                    class="flex flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed border-muted-foreground/25 px-4 py-6 transition-colors hover:border-muted-foreground/40 hover:bg-muted/50 active:bg-muted/70">
                    <div class="flex size-10 items-center justify-center rounded-full bg-muted/50">
                        <LucideIconCn Name="plus" Size="20" Class="size-5 text-muted-foreground" />
                    </div>
                    <span class="font-medium text-sm">Choose file</span>
                    <span class="text-muted-foreground text-xs">Browse device</span>
                </button>
                <button
                    type="button"
                    class="flex flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed border-muted-foreground/25 px-4 py-6 transition-colors hover:border-muted-foreground/40 hover:bg-muted/50 active:bg-muted/70">
                    <div class="flex size-10 items-center justify-center rounded-full bg-muted/50">
                        <LucideIconCn Name="camera" Size="20" Class="size-5 text-muted-foreground" />
                    </div>
                    <span class="font-medium text-sm">Take photo</span>
                    <span class="text-muted-foreground text-xs">Quick capture</span>
                </button>
            </div>
            <input type="file" multiple class="hidden" />
            <input type="file" accept="image/*" capture="environment" class="hidden" />
        </div>

        @* File chips *@
        @if (_files.Length > 0)
        {
            <div class="px-4 py-3">
                <div class="flex flex-wrap gap-2">
                    @foreach (var f in _files)
                    {
                        var file = f;
                        <div class="group flex items-center gap-2 rounded-full border bg-muted/30 py-1.5 pr-1.5 pl-3 transition-colors hover:bg-muted/50">
                            <button
                                type="button"
                                @onclick="@(() => SetPreview(file))"
                                class="flex items-center gap-2">
                                @if (file.FileType == "image")
                                {
                                    <LucideIconCn Name="image" Size="14" Class="size-3.5 text-muted-foreground" />
                                }
                                else if (file.FileType == "document")
                                {
                                    <LucideIconCn Name="file-text" Size="14" Class="size-3.5 text-muted-foreground" />
                                }
                                else
                                {
                                    <LucideIconCn Name="file" Size="14" Class="size-3.5 text-muted-foreground" />
                                }
                                <span class="max-w-[120px] truncate text-xs">@file.Name</span>
                                <span class="text-muted-foreground text-xs">@file.Size</span>
                            </button>
                            <button
                                type="button"
                                @onclick="@(() => RemoveFile(file.Id))"
                                aria-label="@($"Remove {file.Name}")"
                                class="flex size-5 items-center justify-center rounded-full transition-colors hover:bg-muted">
                                <LucideIconCn Name="x" Size="12" Class="size-3 text-muted-foreground" />
                            </button>
                        </div>
                    }
                </div>
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                Tap a file to preview. Max 25 MB per file.
            </span>
        </div>
    </div>

    @* Fullscreen preview overlay *@
    @if (_preview != null)
    {
        <div class="fixed inset-0 z-50 flex flex-col bg-background/95 backdrop-blur-sm">
            <div class="flex items-center justify-between border-b px-4 py-3">
                <div class="min-w-0 flex-1">
                    <span class="block truncate font-medium text-sm">@_preview.Name</span>
                    <span class="text-muted-foreground text-xs">@_preview.Size</span>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" OnClick="ClosePreview">
                    <LucideIconCn Name="x" Size="12" Class="size-3" />
                    Close
                </ButtonCn>
            </div>
            <div class="flex flex-1 flex-col items-center justify-center gap-3 px-4">
                <div class="flex size-16 items-center justify-center rounded-lg bg-muted/50">
                    @if (_preview.FileType == "image")
                    {
                        <LucideIconCn Name="image" Size="14" Class="size-3.5 text-muted-foreground" />
                    }
                    else if (_preview.FileType == "document")
                    {
                        <LucideIconCn Name="file-text" Size="14" Class="size-3.5 text-muted-foreground" />
                    }
                    else
                    {
                        <LucideIconCn Name="file" Size="14" Class="size-3.5 text-muted-foreground" />
                    }
                </div>
                <span class="text-center font-medium text-sm">@_preview.Name</span>
                <span class="text-muted-foreground text-xs">@_preview.Size</span>
            </div>
        </div>
    }
</section>

@code {
    private UploadedFile[] _files =
    [
        new UploadedFile("1", "product-photo.jpg",          "2.4 MB",  "image"),
        new UploadedFile("2", "receipt-march.pdf",          "340 KB",  "document"),
        new UploadedFile("3", "screenshot-dashboard.png",   "1.1 MB",  "image"),
        new UploadedFile("4", "notes.txt",                  "12 KB",   "other"),
    ];

    private UploadedFile? _preview = null;

    private void RemoveFile(string id)
    {
        _files = _files.Where(f => f.Id != id).ToArray();
        if (_preview?.Id == id)
            _preview = null;
    }

    private void SetPreview(UploadedFile file)
    {
        _preview = file;
    }

    private void ClosePreview()
    {
        _preview = null;
    }

    private record UploadedFile(string Id, string Name, string Size, string FileType);
}
