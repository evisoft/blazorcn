@* ============================================================
   Block: file-upload-expiring-link
   Title: FileUploadExpiringLink
   Description: File upload block with expiring download links for React and Next.js featuring expiry duration selection, generated shareable link with copy button, countdown timer, download count, and auto-delete notice using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-expiring-link.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="link" Size="16" Class="size-4 text-muted-foreground" />
            <div class="flex-1">
                <p class="font-medium text-sm">Share with expiring link</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Upload files and generate time-limited download links
                </p>
            </div>
            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                <span>
                    @_files.Count active @(_files.Count == 1 ? "link" : "links")
                </span>
            </div>
        </div>

        @* Upload zone *@
        @if (_showUpload)
        {
            <div class="border-b px-4 py-4">
                <div class="flex items-center gap-3">
                    <div
                        role="button"
                        tabindex="0"
                        @onclick="HandleUpload"
                        @onkeydown="@((Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e) => { if (e.Key == "Enter" || e.Key == " ") HandleUpload(); })"
                        class="flex flex-1 cursor-pointer flex-col items-center justify-center gap-2 rounded-md border-2 border-dashed border-muted-foreground/20 px-4 py-6 transition-colors hover:border-muted-foreground/40 hover:bg-muted/30">
                        <LucideIconCn Name="cloud-upload" Size="20" Class="size-5 text-muted-foreground/60" />
                        <div class="text-center">
                            <span class="font-medium text-sm">Drop file here</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">or click to browse</p>
                        </div>
                    </div>
                </div>

                @* Expiry selector *@
                <div class="mt-3 flex items-center gap-3">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="timer" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-muted-foreground text-xs">Expires after</span>
                    </div>
                    <select
                        value="@_expiry"
                        @onchange="@((Microsoft.AspNetCore.Components.ChangeEventArgs e) => _expiry = e.Value?.ToString() ?? "24h")"
                        class="h-7 w-32 rounded-md border border-input bg-background px-2 text-xs focus:outline-none focus:ring-1 focus:ring-ring">
                        @foreach (var opt in _expiryOptions)
                        {
                            <option value="@opt.Value">@opt.Label</option>
                        }
                    </select>
                </div>
            </div>
        }

        @if (!_showUpload)
        {
            <div class="flex items-center justify-center border-b px-4 py-3">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" @onclick="@(() => _showUpload = true)">
                    <LucideIconCn Name="cloud-upload" Size="12" Class="size-3" />
                    Upload another file
                </ButtonCn>
            </div>
        }

        @* File list with links *@
        <div>
            @for (var i = 0; i < _files.Count; i++)
            {
                var file = _files[i];
                var isLast = i == _files.Count - 1;
                <div class="@(isLast ? "" : "border-b")">
                    @* File info row *@
                    <div class="flex items-start gap-3 px-4 py-3">
                        <LucideIconCn Name="file" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate font-medium text-sm">@file.Name</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-[10px]">
                                    @file.Size
                                </BadgeCn>
                            </div>

                            @* Link row *@
                            <div class="mt-2 flex items-center gap-2 rounded-md bg-muted/50 px-2.5 py-1.5">
                                <LucideIconCn Name="link" Size="12" Class="size-3 shrink-0 text-muted-foreground/60" />
                                <span class="min-w-0 flex-1 truncate font-mono text-muted-foreground text-xs">
                                    @file.Link
                                </span>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-5 gap-1 px-1.5 text-[10px]" @onclick="@(() => CopyLink(file.Id, file.Link))">
                                    @if (_copied == file.Id)
                                    {
                                        <LucideIconCn Name="check" Size="10" Class="size-2.5" />
                                        <span>Copied</span>
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="copy" Size="10" Class="size-2.5" />
                                        <span>Copy</span>
                                    }
                                </ButtonCn>
                            </div>

                            @* Metadata row *@
                            <div class="mt-2 flex flex-wrap items-center gap-3 text-muted-foreground text-xs">
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                    @file.Countdown
                                </span>
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="download" Size="12" Class="size-3" />
                                    @file.Downloads @(file.Downloads == 1 ? "download" : "downloads")
                                </span>
                                <span>Shared @file.CreatedAt</span>
                            </div>
                        </div>

                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="mt-0.5 size-7 shrink-0 p-0 text-muted-foreground hover:text-foreground" @onclick="@(() => RemoveFile(file.Id))">
                            <LucideIconCn Name="trash" Size="14" Class="size-3.5" />
                        </ButtonCn>
                    </div>
                </div>
            }

            @if (_files.Count == 0)
            {
                <div class="flex flex-col items-center justify-center px-4 py-8 text-center">
                    <LucideIconCn Name="link" Size="20" Class="size-5 text-muted-foreground/40" />
                    <p class="mt-2 text-muted-foreground text-xs">No shared files yet</p>
                </div>
            }
        </div>

        @* Auto-delete notice *@
        <div class="border-t px-4 py-3">
            <div class="flex items-start gap-2 rounded-md bg-muted/50 p-3">
                <LucideIconCn Name="shield-alert" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                <div>
                    <span class="font-medium text-xs">Auto-delete enabled</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Files are permanently deleted when their link expires. Download links cannot be
                        recovered after expiration. Recipients should download files before the countdown
                        ends.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record UploadedFile(
        string Id,
        string Name,
        string Size,
        string Link,
        string Expiry,
        string ExpiryLabel,
        string Countdown,
        int Downloads,
        string CreatedAt
    );

    private record ExpiryOption(string Value, string Label);

    private static readonly ExpiryOption[] _expiryOptions =
    [
        new("1h", "1 hour"),
        new("24h", "24 hours"),
        new("7d", "7 days"),
        new("30d", "30 days"),
    ];

    private List<UploadedFile> _files =
    [
        new("1", "contract-draft-v2.pdf", "3.2 MB", "https://share.acme.io/f/a8k2m9x",
            "24h", "24 hours", "18h 42m remaining", 3, "5 hours ago"),
        new("2", "design-assets-march.zip", "48.7 MB", "https://share.acme.io/f/p3n7v1q",
            "7d", "7 days", "5d 11h remaining", 12, "Yesterday"),
    ];

    private string _expiry = "24h";
    private string? _copied = null;
    private bool _showUpload = true;

    private void CopyLink(string id, string link)
    {
        _copied = id;
    }

    private void RemoveFile(string id)
    {
        _files = _files.Where(f => f.Id != id).ToList();
    }

    private void HandleUpload()
    {
        var expiryOption = _expiryOptions.FirstOrDefault(o => o.Value == _expiry);
        var countdown = _expiry switch
        {
            "1h" => "59m remaining",
            "24h" => "23h 59m remaining",
            "7d" => "6d 23h remaining",
            _ => "29d 23h remaining",
        };
        var newFile = new UploadedFile(
            Id: $"{_files.Count + 1}",
            Name: "quarterly-report-q1.pdf",
            Size: "1.4 MB",
            Link: "https://share.acme.io/f/hmpstuw",
            Expiry: _expiry,
            ExpiryLabel: expiryOption?.Label ?? _expiry,
            Countdown: countdown,
            Downloads: 0,
            CreatedAt: "Just now"
        );
        _files = new List<UploadedFile> { newFile }.Concat(_files).ToList();
        _showUpload = false;
    }
}
