@* ============================================================
   Block: file-upload-document
   Title: FileUploadDocument
   Description: Document upload block for React and Next.js with file type icons, accepted format badges, and metadata display using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-document.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Upload document</span>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Attach a document to this submission
            </p>
        </div>

        @* Accepted formats *@
        <div class="flex items-center gap-2 border-b px-4 py-2.5">
            <span class="text-muted-foreground text-xs">Accepted:</span>
            <div class="flex flex-wrap gap-1">
                @foreach (var fmt in _acceptedFormats)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">@fmt.Label</BadgeCn>
                }
            </div>
            <span class="ml-auto text-muted-foreground text-xs">Max 25 MB</span>
        </div>

        @* Upload area or document display *@
        @if (_document != null)
        {
            @* Document info *@
            <div class="border-b px-4 py-4">
                <div class="flex items-start gap-3 rounded-md bg-muted/50 p-3">
                    <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-background">
                        <LucideIconCn Name="@GetDocIconName(_document.Format)" Size="20" Class="size-5 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="block truncate font-medium text-sm">@_document.Name</span>
                        <div class="mt-1 flex items-center gap-2">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">@_document.Format</BadgeCn>
                            <span class="text-muted-foreground text-xs">@_document.Size</span>
                            <span class="text-muted-foreground text-xs">·</span>
                            <span class="text-muted-foreground text-xs">@_document.Pages</span>
                        </div>
                    </div>
                </div>
            </div>

            @* Actions *@
            <div class="flex items-center justify-between px-4 py-3">
                <div class="flex items-center gap-2">
                    <label for="doc-file-input">
                        <ButtonCn
                            Variant="ButtonVariant.Outline"
                            Size="ButtonSize.Sm"
                            Class="h-7 gap-1 text-xs pointer-events-none">
                            <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                            Replace
                        </ButtonCn>
                    </label>
                    <ButtonCn
                        Variant="ButtonVariant.Ghost"
                        Size="ButtonSize.Sm"
                        Class="h-7 gap-1 text-xs text-muted-foreground"
                        OnClick="RemoveDocument">
                        <LucideIconCn Name="trash" Size="12" Class="size-3" />
                        Remove
                    </ButtonCn>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Submit
                </ButtonCn>
            </div>
        }
        else
        {
            @* Empty upload area *@
            <div class="px-4 py-6">
                <label for="doc-file-input"
                       class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-md border-2 border-dashed border-muted-foreground/20 px-6 py-10 transition-colors hover:border-muted-foreground/40 hover:bg-muted/30">
                    <LucideIconCn Name="upload" Size="24" Class="size-6 text-muted-foreground/50" />
                    <div class="text-center">
                        <span class="font-medium text-sm">Select a document</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            PDF, DOC, DOCX, XLS, or XLSX up to 25 MB
                        </p>
                    </div>
                </label>
            </div>

            @* Footer *@
            <div class="border-t px-4 py-3">
                <span class="text-muted-foreground text-xs">No document attached</span>
            </div>
        }

        <input
            id="doc-file-input"
            type="file"
            accept=".pdf,.doc,.docx,.xls,.xlsx"
            class="hidden"
            @onchange="HandleFileChange" />
    </div>
</section>

@code {
    private record DocumentFile(string Name, string Size, string Type, string Format, string Pages);

    private static readonly (string Label, string Mime)[] _acceptedFormats =
    [
        ("PDF",  "application/pdf"),
        ("DOC",  "application/msword"),
        ("DOCX", "application/vnd.openxmlformats-officedocument.wordprocessingml.document"),
        ("XLS",  "application/vnd.ms-excel"),
        ("XLSX", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"),
    ];

    private DocumentFile? _document = new DocumentFile(
        "quarterly-report-q4-2025.pdf",
        "2.4 MB",
        "application/pdf",
        "PDF",
        "24 pages"
    );

    private static string GetDocIconName(string format) => format switch
    {
        "PDF"  => "file-text",
        "XLS"  => "file-spreadsheet",
        "XLSX" => "file-spreadsheet",
        _      => "file",
    };

    private async Task HandleFileChange(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        if (string.IsNullOrEmpty(raw)) return;

        var name = System.IO.Path.GetFileName(raw);
        if (string.IsNullOrEmpty(name)) return;

        var ext = System.IO.Path.GetExtension(name).TrimStart('.').ToUpperInvariant();
        if (string.IsNullOrEmpty(ext)) ext = "FILE";

        _document = new DocumentFile(name, "—", string.Empty, ext, "--");
        await Task.CompletedTask;
    }

    private void RemoveDocument()
    {
        _document = null;
    }
}
