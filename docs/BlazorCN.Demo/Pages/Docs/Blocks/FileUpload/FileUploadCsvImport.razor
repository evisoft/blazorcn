@* ============================================================
   Block: file-upload-csv-import
   Title: FileUploadCsvImport
   Description: A CSV and spreadsheet import upload block with parsed data preview table, column mapping, row count, and error validation using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-csv-import.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="file-spreadsheet" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Import CSV</span>
            </div>
            @if (_data != null && !_imported)
            {
                <div class="flex items-center gap-2">
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        @_data.TotalRows rows
                    </BadgeCn>
                    @if (_data.ErrorRows > 0)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                            <span class="mr-1 inline-block size-1.5 rounded-full bg-amber-500"></span>
                            @_data.ErrorRows errors
                        </BadgeCn>
                    }
                </div>
            }
            @if (_imported)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5" />
                    Imported
                </span>
            }
        </div>

        @if (_data == null)
        {
            @* Upload zone *@
            <div class="flex flex-col items-center px-4 py-10">
                <LucideIconCn Name="upload-cloud" Size="32" Class="mb-3 size-8 text-muted-foreground" />
                <span class="font-medium text-sm">Upload a CSV file</span>
                <span class="mt-1 text-muted-foreground text-xs">
                    CSV, TSV, or Excel files up to 10 MB
                </span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-4 h-7 text-xs" OnClick="HandleFileSelect">
                    Choose file
                </ButtonCn>
            </div>
        }
        else if (_imported)
        {
            @* Import complete *@
            <div class="flex flex-col items-center px-4 py-10">
                <LucideIconCn Name="check-circle-2" Size="32" Class="mb-3 size-8 text-emerald-600 dark:text-emerald-400" />
                <span class="font-medium text-sm">
                    @(_data.TotalRows - _data.ErrorRows) rows imported successfully
                </span>
                @if (_data.ErrorRows > 0)
                {
                    <span class="mt-1 text-muted-foreground text-xs">
                        @_data.ErrorRows rows skipped due to validation errors
                    </span>
                }
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-4 h-7 text-xs" OnClick="Reset">
                    Import another file
                </ButtonCn>
            </div>
        }
        else
        {
            @* Column mapping *@
            <div class="border-b px-4 py-3">
                <span class="mb-2.5 block font-medium text-muted-foreground text-xs">
                    Column mapping
                </span>
                <div class="grid grid-cols-2 gap-2">
                    @foreach (var header in _data.Headers)
                    {
                        var h = header;
                        <div class="flex items-center gap-2">
                            <span class="min-w-0 flex-1 truncate font-mono text-muted-foreground text-xs">
                                @h
                            </span>
                            <SelectCn Value="@(GetMapping(h))" ValueChanged="@((string val) => UpdateMapping(h, val))">
                                <SelectTriggerCn Class="h-7 w-[140px] text-xs" aria-label="@($"Map column {h}")">
                                    <SelectValueCn Placeholder="Map to..." />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    @foreach (var field in _targetFields)
                                    {
                                        var f = field;
                                        <SelectItemCn Value="@f" Class="text-xs">@f</SelectItemCn>
                                    }
                                </SelectContentCn>
                            </SelectCn>
                        </div>
                    }
                </div>
            </div>

            @* Data preview *@
            <div class="border-b">
                <div class="px-4 py-2.5">
                    <span class="font-medium text-muted-foreground text-xs">
                        Preview (first 5 rows)
                    </span>
                </div>
                <TableCn>
                    <TableHeaderCn>
                        <TableRowCn>
                            @foreach (var header in _data.Headers)
                            {
                                var h = header;
                                <TableHeadCn Class="h-8 px-4 text-xs">
                                    @(GetMapping(h) != "" ? GetMapping(h) : h)
                                </TableHeadCn>
                            }
                            <TableHeadCn Class="h-8 w-10 px-4 text-xs" />
                        </TableRowCn>
                    </TableHeaderCn>
                    <TableBodyCn>
                        @for (int i = 0; i < _data.Rows.Length; i++)
                        {
                            var row = _data.Rows[i];
                            var hasError = i == 4;
                            <TableRowCn>
                                @for (int j = 0; j < row.Length; j++)
                                {
                                    var cell = row[j];
                                    var colIndex = j;
                                    <TableCellCn Class="@Cn.Merge("px-4 text-xs", hasError && colIndex == 1 ? "text-red-600 dark:text-red-400" : "")">
                                        @cell
                                    </TableCellCn>
                                }
                                <TableCellCn Class="w-10 px-4">
                                    @if (hasError)
                                    {
                                        <LucideIconCn Name="alert-circle" Size="14" Class="size-3.5 text-amber-500" />
                                    }
                                </TableCellCn>
                            </TableRowCn>
                        }
                    </TableBodyCn>
                </TableCn>
            </div>

            @* Error summary *@
            @if (_data.ErrorRows > 0)
            {
                <div class="border-b px-4 py-2.5">
                    <div class="flex items-center gap-2 rounded-md bg-muted/50 px-3 py-2">
                        <LucideIconCn Name="alert-circle" Size="14" Class="size-3.5 shrink-0 text-amber-500" />
                        <span class="text-muted-foreground text-xs">
                            @_data.ErrorRows rows have validation errors (invalid email format). These rows
                            will be skipped during import.
                        </span>
                    </div>
                </div>
            }

            @* Actions *@
            <div class="flex items-center justify-between px-4 py-3">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="Reset">
                    Cancel
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="HandleImport">
                    Import @(_data.TotalRows - _data.ErrorRows) rows
                </ButtonCn>
            </div>
        }
    </div>
</section>

@code {
    private record CsvData(string[] Headers, string[][] Rows, int TotalRows, int ErrorRows);

    private static readonly string[] _targetFields = ["Full Name", "Email", "Role", "Department", "Status", "Skip"];

    private static readonly CsvData _sampleData = new CsvData(
        Headers: ["name", "email", "role", "department"],
        Rows:
        [
            ["Alice Chen",    "alice@acme.com",  "Engineer", "Product"],
            ["Bob Martinez",  "bob@acme.com",    "Designer", "Design"],
            ["Carol Wu",      "carol@acme.com",  "Manager",  "Engineering"],
            ["David Kim",     "david@acme.com",  "Analyst",  "Finance"],
            ["Eve Johnson",   "eve.j@acme",      "Engineer", "Product"],
        ],
        TotalRows: 248,
        ErrorRows: 3
    );

    private static readonly Dictionary<string, string> _defaultMapping = new()
    {
        ["name"]       = "Full Name",
        ["email"]      = "Email",
        ["role"]       = "Role",
        ["department"] = "Department",
    };

    private CsvData? _data = null;
    private Dictionary<string, string> _mapping = new(_defaultMapping);
    private bool _imported = false;

    private string GetMapping(string header)
        => _mapping.TryGetValue(header, out var val) ? val : "";

    private void HandleFileSelect()
    {
        _data = _sampleData;
        _mapping = new(_defaultMapping);
        _imported = false;
    }

    private void HandleImport()
    {
        _imported = true;
    }

    private void Reset()
    {
        _data = null;
        _imported = false;
        _mapping = new(_defaultMapping);
    }

    private void UpdateMapping(string header, string value)
    {
        _mapping[header] = value;
    }
}
