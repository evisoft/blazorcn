@* ============================================================
   Block: file-upload-restricted-types
   Title: FileUploadRestrictedTypes
   Description: React file upload block for Next.js with strict file type restrictions, accepted type icons, rejected file error messages, and per-file validation indicators using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-restricted-types.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Upload files</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_validFiles.Length accepted
            </BadgeCn>
        </div>

        @* Accepted types *@
        <div class="border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">Accepted file types</span>
            <div class="mt-2 flex items-center gap-2">
                @foreach (var type in _acceptedTypes)
                {
                    <div class="flex items-center gap-1.5 rounded-md bg-muted/50 px-2.5 py-1.5">
                        <span class="text-muted-foreground">
                            <LucideIconCn Name="@type.Icon" Size="14" Class="size-3.5" />
                        </span>
                        <span class="font-medium text-xs">@type.Label</span>
                    </div>
                }
            </div>
        </div>

        @* Drop zone *@
        <div class="border-b px-4 py-4">
            <div class="flex flex-col items-center justify-center rounded-md border border-dashed px-4 py-6">
                <LucideIconCn Name="upload" Size="20" Class="mb-2 size-5 text-muted-foreground/60" />
                <p class="font-medium text-sm">Drop files here</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Only PDF, PNG, and JPG files are accepted
                </p>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-3 h-7 text-xs">
                    Browse files
                </ButtonCn>
            </div>
        </div>

        @* Accepted files *@
        @if (_validFiles.Length > 0)
        {
            <div class="@(_rejectedFiles.Length > 0 ? "border-b" : "")">
                <div class="border-b px-4 py-2">
                    <span class="text-muted-foreground text-xs">Accepted</span>
                </div>
                @for (var i = 0; i < _validFiles.Length; i++)
                {
                    var file = _validFiles[i];
                    var idx = i;
                    var hasBorder = idx < _validFiles.Length - 1 || _rejectedFiles.Length > 0;
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", hasBorder ? "border-b" : "")">
                        <LucideIconCn Name="check-circle" Size="16" Class="size-4 shrink-0 text-emerald-500" />
                        <LucideIconCn Name="file" Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                        <div class="min-w-0 flex-1">
                            <span class="block truncate font-medium text-sm">@file.Name</span>
                            <span class="text-muted-foreground text-xs">
                                @file.Size · @GetTypeLabel(file.Type)
                            </span>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                            @GetTypeLabel(file.Type)
                        </BadgeCn>
                        <button
                            type="button"
                            @onclick="@(() => RemoveFile(file.Id))"
                            class="shrink-0 rounded p-0.5 text-muted-foreground/60 transition-colors hover:text-foreground">
                            <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                        </button>
                    </div>
                }
            </div>
        }

        @* Rejected files *@
        @if (_rejectedFiles.Length > 0)
        {
            <div>
                <div class="border-b px-4 py-2">
                    <span class="flex items-center gap-1.5 text-xs">
                        <LucideIconCn Name="alert-circle" Size="12" Class="size-3 text-red-500" />
                        <span class="text-red-600 dark:text-red-400">
                            @_rejectedFiles.Length rejected
                        </span>
                    </span>
                </div>
                @for (var i = 0; i < _rejectedFiles.Length; i++)
                {
                    var file = _rejectedFiles[i];
                    var idx = i;
                    <div class="@Cn.Merge("px-4 py-2.5", idx < _rejectedFiles.Length - 1 ? "border-b" : "")">
                        <div class="flex items-center gap-3">
                            <LucideIconCn Name="x-circle" Size="16" Class="size-4 shrink-0 text-red-500" />
                            <LucideIconCn Name="file" Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                            <div class="min-w-0 flex-1">
                                <span class="block truncate font-medium text-sm">@file.Name</span>
                                <span class="text-muted-foreground text-xs">@file.Size</span>
                            </div>
                            <button
                                type="button"
                                @onclick="@(() => RemoveFile(file.Id))"
                                class="shrink-0 rounded p-0.5 text-muted-foreground/60 transition-colors hover:text-foreground">
                                <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(file.Reason))
                        {
                            <p class="mt-1 pl-[3.25rem] text-red-600 text-xs dark:text-red-400">
                                @file.Reason
                            </p>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record AcceptedType(string Mime, string Label, string Icon);
    private record UploadedFile(string Id, string Name, string Size, string Type, bool Valid, string? Reason = null);

    private static readonly AcceptedType[] _acceptedTypes =
    [
        new("application/pdf", "PDF", "file-text"),
        new("image/png", "PNG", "image"),
        new("image/jpeg", "JPG", "image"),
    ];

    private static readonly UploadedFile[] _initialFiles =
    [
        new("1", "contract-final.pdf", "2.4 MB", "application/pdf", true),
        new("2", "screenshot.png", "845 KB", "image/png", true),
        new("3", "profile-photo.jpg", "1.1 MB", "image/jpeg", true),
        new("4", "spreadsheet.xlsx", "340 KB", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", false, "XLSX files are not accepted. Upload PDF, PNG, or JPG."),
        new("5", "archive.zip", "12.8 MB", "application/zip", false, "ZIP files are not accepted. Upload PDF, PNG, or JPG."),
    ];

    private List<UploadedFile> _files = new(_initialFiles);

    private UploadedFile[] _validFiles => _files.Where(f => f.Valid).ToArray();
    private UploadedFile[] _rejectedFiles => _files.Where(f => !f.Valid).ToArray();

    private string GetTypeLabel(string mime)
    {
        var found = _acceptedTypes.FirstOrDefault(t => t.Mime == mime);
        if (found is not null) return found.Label;
        var parts = mime.Split('/');
        return parts.Length > 1 ? parts[^1].ToUpperInvariant() : "FILE";
    }

    private void RemoveFile(string id)
    {
        _files = _files.Where(f => f.Id != id).ToList();
    }
}
