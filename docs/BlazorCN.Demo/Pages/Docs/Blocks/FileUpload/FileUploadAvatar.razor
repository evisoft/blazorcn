@* ============================================================
   Block: file-upload-avatar
   Title: FileUploadAvatar
   Description: Avatar and profile photo upload block for React and Next.js with circular preview, camera overlay, and file restrictions using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-avatar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Profile photo</span>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Update your avatar visible to other members
            </p>
        </div>

        @* Avatar area *@
        <div class="flex items-center gap-6 border-b px-4 py-6">
            @* Circular avatar — wrapped in label to trigger hidden file input *@
            <label for="avatar-file-input" class="group relative size-24 shrink-0 cursor-pointer overflow-hidden rounded-full bg-muted/50">
                <div class="flex size-full items-center justify-center">
                    @if (_hasAvatar)
                    {
                        <div class="flex size-full items-center justify-center bg-muted">
                            <span class="font-semibold text-2xl text-muted-foreground">JD</span>
                        </div>
                    }
                    else
                    {
                        <LucideIconCn Name="user" Size="40" Class="size-10 text-muted-foreground/40" />
                    }
                </div>

                @* Camera overlay *@
                <div class="absolute inset-0 flex items-center justify-center bg-black/40 opacity-0 transition-opacity group-hover:opacity-100">
                    <LucideIconCn Name="camera" Size="24" Class="size-6 text-white" />
                </div>
            </label>

            @* Info & actions *@
            <div class="flex-1">
                @if (_hasAvatar && _fileName != null)
                {
                    <div class="mb-3">
                        <span class="block font-medium text-sm">@_fileName</span>
                        <span class="text-muted-foreground text-xs">@_fileSize</span>
                    </div>
                }
                else
                {
                    <p class="mb-3 text-muted-foreground text-sm">
                        Click the avatar or use the button below to upload a photo
                    </p>
                }
                <div class="flex items-center gap-2">
                    <label for="avatar-file-input">
                        <ButtonCn
                            Variant="ButtonVariant.Outline"
                            Size="ButtonSize.Sm"
                            Class="h-7 gap-1 text-xs pointer-events-none">
                            <LucideIconCn Name="upload" Size="12" Class="size-3" />
                            @(_hasAvatar ? "Change photo" : "Upload photo")
                        </ButtonCn>
                    </label>
                    @if (_hasAvatar)
                    {
                        <ButtonCn
                            Variant="ButtonVariant.Ghost"
                            Size="ButtonSize.Sm"
                            Class="h-7 gap-1 text-xs text-muted-foreground"
                            OnClick="RemoveAvatar">
                            <LucideIconCn Name="trash" Size="12" Class="size-3" />
                            Remove
                        </ButtonCn>
                    }
                </div>
            </div>

            <input
                id="avatar-file-input"
                type="file"
                accept="image/jpeg,image/png,image/webp"
                class="hidden"
                @onchange="HandleFileChange" />
        </div>

        @* Restrictions *@
        <div class="px-4 py-3">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                    <span class="text-muted-foreground text-xs">JPG, PNG, or WebP</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                    <span class="text-muted-foreground text-xs">Max 5 MB</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                    <span class="text-muted-foreground text-xs">Square recommended</span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private bool _hasAvatar = false;
    private string? _fileName = null;
    private string? _fileSize = null;

    private async Task HandleFileChange(ChangeEventArgs e)
    {
        // In a static/presentational port we simulate file selection.
        // Blazor's plain onchange on <input type="file"> gives us only the filename string.
        var raw = e.Value?.ToString();
        if (string.IsNullOrEmpty(raw)) return;

        // Extract just the filename (browsers include the fake path "C:\fakepath\name.ext")
        var name = System.IO.Path.GetFileName(raw);
        if (string.IsNullOrEmpty(name)) return;

        // We don't have real file size from a plain input; show a placeholder.
        _fileName = name;
        _fileSize = "—";
        _hasAvatar = true;
        await Task.CompletedTask;
    }

    private void RemoveAvatar()
    {
        _hasAvatar = false;
        _fileName = null;
        _fileSize = null;
    }
}
