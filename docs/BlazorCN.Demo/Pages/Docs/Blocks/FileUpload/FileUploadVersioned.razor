@* ============================================================
   Block: file-upload-versioned
   Title: FileUploadVersioned
   Description: React file upload block for Next.js with version history timeline, size diffs between versions, restore previous version option, and upload new version button using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-versioned.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="history" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Version history</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_versions.Length versions
            </BadgeCn>
        </div>

        @* Current file info *@
        @{
            var currentVersion = _versions.FirstOrDefault(v => v.IsCurrent);
        }
        @if (currentVersion != null)
        {
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <LucideIconCn Name="file" Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                <div class="min-w-0 flex-1">
                    <span class="block truncate font-medium text-sm">@currentVersion.Name</span>
                    <span class="text-muted-foreground text-xs">
                        @currentVersion.Size · v@(currentVersion.Version) · @currentVersion.UploadedBy
                    </span>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="arrow-up-from-line" Size="12" Class="size-3" />
                    Upload new version
                </ButtonCn>
            </div>
        }

        @* Version timeline *@
        <div>
            @for (int i = 0; i < _versions.Length; i++)
            {
                var version = _versions[i];
                var idx = i;
                var isExpanded = _expanded == version.Id;
                var isLast = idx == _versions.Length - 1;
                var prevVersion = idx < _versions.Length - 1 ? _versions[idx + 1] : null;
                var sizeDiff = prevVersion != null ? FormatSizeDiff(version.SizeBytes, prevVersion.SizeBytes) : null;
                var versionId = version.Id;

                <div class="@Cn.Merge("", isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = (isExpanded ? null : versionId))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        @* Timeline dot *@
                        <div class="flex flex-col items-center self-stretch">
                            <span class="@Cn.Merge("size-2 shrink-0 rounded-full", version.IsCurrent ? "bg-foreground" : "bg-muted-foreground/40")" />
                            @if (!isLast)
                            {
                                <div class="mt-1 w-px flex-1 bg-border"></div>
                            }
                        </div>

                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">v@(version.Version)</span>
                                @if (version.IsCurrent)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                        Current
                                    </BadgeCn>
                                }
                            </div>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="text-muted-foreground text-xs">@version.Timestamp</span>
                                <span class="text-muted-foreground text-xs">·</span>
                                <span class="text-muted-foreground text-xs">@version.UploadedBy</span>
                            </div>
                        </div>

                        <div class="flex items-center gap-2">
                            <span class="text-muted-foreground text-xs tabular-nums">
                                @version.Size
                            </span>
                            @if (sizeDiff != null)
                            {
                                <span class="text-xs tabular-nums text-muted-foreground">
                                    @sizeDiff.Label
                                </span>
                            }
                            <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-9">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="flex items-center justify-between">
                                    <div class="space-y-1">
                                        <div class="flex items-center gap-2">
                                            <span class="text-muted-foreground text-xs">Size</span>
                                            <span class="font-mono text-xs">@version.Size</span>
                                            @if (sizeDiff != null)
                                            {
                                                <span class="@Cn.Merge("text-xs tabular-nums", sizeDiff.Positive ? "text-amber-600 dark:text-amber-400" : "text-emerald-600 dark:text-emerald-400")">
                                                    (@(sizeDiff.Label))
                                                </span>
                                            }
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <span class="text-muted-foreground text-xs">Uploaded by</span>
                                            <span class="text-xs">@version.UploadedBy</span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <span class="text-muted-foreground text-xs">Date</span>
                                            <span class="text-xs">@version.Timestamp</span>
                                        </div>
                                    </div>
                                    @if (!version.IsCurrent)
                                    {
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                                            <LucideIconCn Name="rotate-ccw" Size="12" Class="size-3" />
                                            Restore
                                        </ButtonCn>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Upload new version footer *@
        <div class="border-t px-4 py-3">
            <div class="flex flex-col items-center justify-center rounded-md border border-dashed px-4 py-4">
                <LucideIconCn Name="upload" Size="16" Class="mb-1.5 size-4 text-muted-foreground/60" />
                <p class="font-medium text-xs">Drop file to upload as v@(_versions.Length + 1)</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Previous versions are preserved</p>
            </div>
        </div>
    </div>
</section>

@code {
    private record FileVersion(string Id, int Version, string Name, string Size, long SizeBytes, string UploadedBy, string Timestamp, bool IsCurrent);
    private record SizeDiffResult(string Label, bool Positive);

    private static readonly FileVersion[] _versions =
    [
        new("v5", 5, "design-system-spec.pdf", "4.2 MB", 4404019, "Sarah Chen",    "Today, 2:15 PM",      true),
        new("v4", 4, "design-system-spec.pdf", "3.8 MB", 3984588, "Marcus Rivera", "Yesterday, 11:30 AM", false),
        new("v3", 3, "design-system-spec.pdf", "3.1 MB", 3250585, "Sarah Chen",    "Mar 21, 4:45 PM",     false),
        new("v2", 2, "design-system-spec.pdf", "2.6 MB", 2726297, "Alex Kim",      "Mar 19, 9:10 AM",     false),
        new("v1", 1, "design-system-spec.pdf", "1.9 MB", 1992294, "Sarah Chen",    "Mar 17, 3:00 PM",     false),
    ];

    private string? _expanded = "v4";

    private static SizeDiffResult FormatSizeDiff(long current, long previous)
    {
        var diff = current - previous;
        var diffKB = Math.Abs(diff) / 1024.0;
        if (diffKB < 1) return new SizeDiffResult("No change", false);
        var formatted = diffKB >= 1024
            ? $"{(diffKB / 1024.0).ToString("F1")} MB"
            : $"{(int)Math.Round(diffKB)} KB";
        return new SizeDiffResult(
            diff > 0 ? $"+{formatted}" : $"-{formatted}",
            diff > 0
        );
    }
}
