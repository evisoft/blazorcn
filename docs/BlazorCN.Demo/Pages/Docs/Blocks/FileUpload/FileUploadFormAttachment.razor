@* ============================================================
   Block: file-upload-form-attachment
   Title: FileUploadFormAttachment
   Description: A React file attachment block embedded within a contact form with name, email, message textarea, multiple file attachments list, and compact inline upload style using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-form-attachment.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Submit a request</p>
            <p class="text-muted-foreground text-xs">
                Fill out the form below and attach any relevant files
            </p>
        </div>

        @* Form fields *@
        <div class="space-y-4 border-b px-4 py-4">
            <div class="grid grid-cols-2 gap-3">
                <div class="space-y-1.5">
                    <LabelCn For="form-name" Class="text-xs">
                        Name
                    </LabelCn>
                    <InputCn
                        Id="form-name"
                        @bind-Value="_name"
                        Placeholder="Your name"
                        Class="h-8 text-sm" />
                </div>
                <div class="space-y-1.5">
                    <LabelCn For="form-email" Class="text-xs">
                        Email
                    </LabelCn>
                    <InputCn
                        Id="form-email"
                        Type="email"
                        @bind-Value="_email"
                        Placeholder="@("you@example.com")"
                        Class="h-8 text-sm" />
                </div>
            </div>

            <div class="space-y-1.5">
                <LabelCn For="form-message" Class="text-xs">
                    Message
                </LabelCn>
                <TextareaCn
                    Id="form-message"
                    @bind-Value="_message"
                    Placeholder="Describe your issue..."
                    Rows="4"
                    Class="resize-none text-sm" />
            </div>
        </div>

        @* Attachments *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <p class="font-medium text-muted-foreground text-xs">
                    Attachments (@_attachments.Count)
                </p>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                    <LucideIconCn Name="paperclip" Size="12" Class="size-3" />
                    Attach file
                </ButtonCn>
            </div>

            @if (_attachments.Count > 0)
            {
                <div class="mt-2 space-y-1">
                    @foreach (var att in _attachments)
                    {
                        var attachment = att;
                        <div class="flex items-center gap-2.5 rounded-md px-2 py-1.5 transition-colors hover:bg-muted/50">
                            <LucideIconCn Name="@GetFileIconName(attachment.Type)" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            <span class="min-w-0 flex-1 truncate text-sm">@attachment.Name</span>
                            <span class="shrink-0 text-muted-foreground text-xs">
                                @attachment.Size
                            </span>
                            <button
                                type="button"
                                @onclick="@(() => RemoveAttachment(attachment.Id))"
                                aria-label="@($"Remove {attachment.Name}")"
                                class="shrink-0 rounded-sm p-0.5 text-muted-foreground/60 transition-colors hover:text-foreground">
                                <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                            </button>
                        </div>
                    }
                </div>
            }

            @if (_attachments.Count == 0)
            {
                <div class="mt-2 flex items-center justify-center rounded-md border border-dashed bg-muted/30 py-4">
                    <p class="text-muted-foreground text-xs">No files attached</p>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3">
            <p class="text-muted-foreground text-xs">PDF, PNG, JPG, TXT up to 10 MB each</p>
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                Submit request
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private enum AttachmentType { Pdf, Image, Spreadsheet, Other }

    private record Attachment(string Id, string Name, string Size, AttachmentType Type);

    private List<Attachment> _attachments = new List<Attachment>
    {
        new("1", "screenshot-bug-report.png", "842 KB", AttachmentType.Image),
        new("2", "error-log-2026-03.txt", "12 KB", AttachmentType.Other),
    };

    private string _name = "Alex Morgan";
    private string _email = "alex@company.com";
    private string _message = "I'm encountering a rendering issue on the dashboard page. The chart component fails to load after the latest deployment. Attached are a screenshot and the error log.";

    private void RemoveAttachment(string id)
    {
        _attachments = _attachments.Where(a => a.Id != id).ToList();
    }

    private static string GetFileIconName(AttachmentType type) => type switch
    {
        AttachmentType.Pdf => "file-text",
        AttachmentType.Image => "image",
        AttachmentType.Spreadsheet => "file-spreadsheet",
        _ => "file",
    };
}
