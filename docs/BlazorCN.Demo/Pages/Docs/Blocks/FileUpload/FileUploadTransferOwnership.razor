@* ============================================================
   Block: file-upload-transfer-ownership
   Title: FileUploadTransferOwnership
   Description: Transfer file ownership panel for React and Next.js with file list showing current owner, new owner team dropdown, transfer reason field, bulk transfer checkbox, and confirmation with old to new owner display using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-transfer-ownership.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Transfer ownership</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Reassign files to another team member
                    </p>
                </div>
            </div>
            @if (_someSelected)
            {
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_selectedFiles.Count selected
                </BadgeCn>
            }
        </div>

        @* Current owner *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted/50">
                <span class="font-medium text-xs">@_currentOwner?.Initials</span>
            </div>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">@_currentOwner?.Name</span>
                <p class="text-muted-foreground text-xs">@_currentOwner?.Email</p>
            </div>
            <span class="text-muted-foreground text-xs">Current owner</span>
        </div>

        @* File selection *@
        <div class="border-b">
            <div class="flex items-center gap-3 px-4 py-2.5">
                <span class="flex cursor-pointer items-center">
                    <CheckboxCn Checked="@_allSelected" CheckedChanged="@((bool _) => ToggleAll())" />
                </span>
                <span class="font-medium text-muted-foreground text-xs">
                    @(_allSelected ? "Deselect all" : "Select all") (@(_ownedFiles.Length) files)
                </span>
            </div>
            @foreach (var fileEntry in _ownedFiles)
            {
                var file = fileEntry;
                var isLast = file.Id == _ownedFiles[_ownedFiles.Length - 1].Id;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <span class="flex cursor-pointer items-center">
                        <CheckboxCn Checked="@_selectedFiles.Contains(file.Id)" CheckedChanged="@((bool _) => ToggleFile(file.Id))" />
                    </span>
                    <span class="text-muted-foreground">
                        @if (file.Type == "document")
                        {
                            <LucideIconCn Name="file-text" Size="14" Class="size-3.5" />
                        }
                        else if (file.Type == "spreadsheet")
                        {
                            <LucideIconCn Name="file-spreadsheet" Size="14" Class="size-3.5" />
                        }
                        else if (file.Type == "image")
                        {
                            <LucideIconCn Name="image" Size="14" Class="size-3.5" />
                        }
                        else
                        {
                            <LucideIconCn Name="file" Size="14" Class="size-3.5" />
                        }
                    </span>
                    <div class="min-w-0 flex-1">
                        <span class="block truncate font-medium text-sm">@file.Name</span>
                    </div>
                    <span class="text-muted-foreground text-xs">@file.Size</span>
                </div>
            }
        </div>

        @* New owner selector *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Transfer to</span>
            <div class="relative">
                <button
                    type="button"
                    @onclick="@(() => _showDropdown = !_showDropdown)"
                    class="flex w-full items-center gap-3 rounded-md border px-3 py-2 text-left transition-colors hover:bg-muted/30">
                    @if (_newOwner != null)
                    {
                        <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted/50">
                            <span class="text-[10px] font-medium">@_newOwner.Initials</span>
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@_newOwner.Name</span>
                            <span class="ml-2 text-muted-foreground text-xs">@_newOwner.Email</span>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted-foreground text-sm">Select team member</span>
                    }
                    <LucideIconCn Name="chevron-down" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground transition-transform duration-200", _showDropdown ? "rotate-180" : "")" />
                </button>

                @if (_showDropdown)
                {
                    <div class="absolute top-full right-0 left-0 z-10 mt-1 overflow-hidden rounded-md border bg-card shadow-md">
                        @foreach (var memberEntry in _eligibleMembers)
                        {
                            var member = memberEntry;
                            <button
                                type="button"
                                @onclick="@(() => SelectOwner(member.Id))"
                                class="flex w-full items-center gap-3 px-3 py-2 text-left transition-colors hover:bg-muted/50">
                                <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted/50">
                                    <span class="text-[10px] font-medium">@member.Initials</span>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <span class="font-medium text-sm">@member.Name</span>
                                    <span class="ml-2 text-muted-foreground text-xs">@member.Email</span>
                                </div>
                                @if (member.Id == _newOwnerId)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5 text-foreground" />
                                }
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        @* Transfer reason *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Reason (optional)
            </span>
            <InputCn
                @bind-Value="_reason"
                Placeholder="Why are these files being transferred?"
                Class="h-8 text-sm" />
        </div>

        @* Confirmation *@
        @if (_someSelected && _newOwner != null)
        {
            <div class="px-4 py-3">
                @if (!_confirmed)
                {
                    <div class="mb-3 rounded-md bg-muted/50 p-3">
                        <div class="flex items-center justify-center gap-3">
                            <div class="text-center">
                                <div class="flex size-8 mx-auto items-center justify-center rounded-full bg-muted/50">
                                    <span class="font-medium text-xs">@_currentOwner?.Initials</span>
                                </div>
                                <span class="mt-1 block text-muted-foreground text-xs">
                                    @_currentOwner?.Name
                                </span>
                            </div>
                            <LucideIconCn Name="arrow-right" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            <div class="text-center">
                                <div class="flex size-8 mx-auto items-center justify-center rounded-full bg-muted/50">
                                    <span class="font-medium text-xs">@_newOwner.Initials</span>
                                </div>
                                <span class="mt-1 block text-muted-foreground text-xs">
                                    @_newOwner.Name
                                </span>
                            </div>
                        </div>
                        <p class="mt-2 text-center text-muted-foreground text-xs">
                            @_selectedFiles.Count @(_selectedFiles.Count == 1 ? "file" : "files") will be transferred
                        </p>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs" OnClick="@(() => _confirmed = true)">
                        Confirm transfer
                    </ButtonCn>
                }
                else
                {
                    <div class="flex items-center justify-center gap-2 rounded-md bg-emerald-500/10 px-3 py-3">
                        <LucideIconCn Name="check" Size="16" Class="size-4 text-emerald-600 dark:text-emerald-400" />
                        <span class="font-medium text-emerald-600 text-sm dark:text-emerald-400">
                            @_selectedFiles.Count @(_selectedFiles.Count == 1 ? "file" : "files") transferred to @_newOwner.Name
                        </span>
                    </div>
                }
            </div>
        }

        @* Empty state *@
        @if (!_someSelected)
        {
            <div class="px-4 py-6 text-center">
                <span class="text-muted-foreground text-xs">Select files to transfer</span>
            </div>
        }
    </div>
</section>

@code {
    private record TeamMember(string Id, string Name, string Email, string Initials);
    private record OwnedFile(string Id, string Name, string Type, string Size, string OwnerId);

    private static readonly TeamMember[] _teamMembers =
    [
        new("u1", "Sarah Chen", "sarah@acme.com", "SC"),
        new("u2", "Marcus Johnson", "marcus@acme.com", "MJ"),
        new("u3", "Elena Rodriguez", "elena@acme.com", "ER"),
        new("u4", "David Kim", "david@acme.com", "DK"),
        new("u5", "Priya Patel", "priya@acme.com", "PP"),
    ];

    private static readonly OwnedFile[] _ownedFiles =
    [
        new("f1", "Q4-revenue-report.pdf", "document", "2.4 MB", "u1"),
        new("f2", "employee-directory.xlsx", "spreadsheet", "890 KB", "u1"),
        new("f3", "product-mockup.png", "image", "4.1 MB", "u1"),
        new("f4", "api-specification.pdf", "document", "1.2 MB", "u1"),
        new("f5", "architecture-diagram.png", "image", "3.6 MB", "u1"),
    ];

    private HashSet<string> _selectedFiles = ["f1", "f2"];
    private string _newOwnerId = "u3";
    private string _reason = "Team restructuring — reassigning to new project lead";
    private bool _showDropdown = false;
    private bool _confirmed = false;

    private TeamMember? _currentOwner => System.Array.Find(_teamMembers, m => m.Id == "u1");
    private TeamMember? _newOwner => System.Array.Find(_teamMembers, m => m.Id == _newOwnerId);
    private TeamMember[] _eligibleMembers => System.Array.FindAll(_teamMembers, m => m.Id != "u1");

    private bool _allSelected => _selectedFiles.Count == _ownedFiles.Length;
    private bool _someSelected => _selectedFiles.Count > 0;

    private void ToggleFile(string id)
    {
        if (_selectedFiles.Contains(id))
            _selectedFiles.Remove(id);
        else
            _selectedFiles.Add(id);
        _confirmed = false;
    }

    private void ToggleAll()
    {
        if (_allSelected)
            _selectedFiles.Clear();
        else
        {
            _selectedFiles.Clear();
            foreach (var f in _ownedFiles)
                _selectedFiles.Add(f.Id);
        }
        _confirmed = false;
    }

    private void SelectOwner(string memberId)
    {
        _newOwnerId = memberId;
        _showDropdown = false;
        _confirmed = false;
    }
}
