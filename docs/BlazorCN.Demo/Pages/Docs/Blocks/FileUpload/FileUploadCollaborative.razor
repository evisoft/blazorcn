@* ============================================================
   Block: file-upload-collaborative
   Title: FileUploadCollaborative
   Description: Collaborative team file upload block for React and Next.js with avatar attribution, file comments, shared folder structure, and team member list using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-collaborative.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card sm:flex">
        @* Main content *@
        <div class="min-w-0 flex-1">
            @* Header *@
            <div class="flex items-center gap-2 border-b px-4 py-3">
                <LucideIconCn Name="folder" Size="16" Class="size-4 text-muted-foreground" />
                <div class="flex-1">
                    <p class="font-medium text-sm">Q1 Campaign Assets</p>
                    <p class="text-muted-foreground text-xs">
                        @_sharedFiles.Length files · Shared with @_teamMembers.Length members
                    </p>
                </div>
            </div>

            @* Upload zone *@
            <div class="border-b px-4 py-3">
                <div class="flex cursor-pointer items-center justify-center gap-2 rounded-md border border-dashed border-muted-foreground/20 px-4 py-4 transition-colors hover:border-muted-foreground/40 hover:bg-muted/30">
                    <LucideIconCn Name="cloud-upload" Size="16" Class="size-4 text-muted-foreground/60" />
                    <span class="text-muted-foreground text-xs">
                        Drop files here or click to upload
                    </span>
                </div>
            </div>

            @* File list *@
            <div>
                @for (int i = 0; i < _sharedFiles.Length; i++)
                {
                    var file = _sharedFiles[i];
                    var isLast = i == _sharedFiles.Length - 1;
                    var isExpanded = _expanded == file.Id;
                    var iconName = GetFileIconName(file.Type);
                    var fileCapture = file;
                    <div class="@Cn.Merge("", isLast ? "" : "border-b")">
                        <button
                            type="button"
                            @onclick="@(() => ToggleExpand(fileCapture.Id))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                            <LucideIconCn Name="@iconName" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-sm">@file.Name</span>
                                <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                    <span class="flex items-center gap-1">
                                        <AvatarCn Class="size-3.5">
                                            <AvatarFallbackCn Class="text-[6px]">@file.UploadedByInitials</AvatarFallbackCn>
                                        </AvatarCn>
                                        @file.UploadedBy
                                    </span>
                                    <span>·</span>
                                    <span>@file.UploadedAt</span>
                                    <span>·</span>
                                    <span>@file.Size</span>
                                    @if (file.Comments.Length > 0)
                                    {
                                        <span>·</span>
                                        <span class="flex items-center gap-1">
                                            <LucideIconCn Name="message-square" Size="12" Class="size-3" />
                                            @file.Comments.Length
                                        </span>
                                    }
                                </div>
                            </div>
                            <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </button>

                        @if (isExpanded)
                        {
                            <div class="px-4 pb-3 pl-11">
                                @* Comments *@
                                @if (file.Comments.Length > 0)
                                {
                                    <div class="space-y-2">
                                        @foreach (var comment in file.Comments)
                                        {
                                            <div class="flex gap-2">
                                                <AvatarCn Class="mt-0.5 size-5 shrink-0">
                                                    <AvatarFallbackCn Class="text-[7px]">@comment.AuthorInitials</AvatarFallbackCn>
                                                </AvatarCn>
                                                <div class="min-w-0 flex-1">
                                                    <div class="flex items-center gap-2">
                                                        <span class="font-medium text-xs">@comment.Author</span>
                                                        <span class="text-muted-foreground text-xs">@comment.Time</span>
                                                    </div>
                                                    <p class="text-muted-foreground text-xs">@comment.Text</p>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                @* Add comment *@
                                <div class="mt-2 flex items-center gap-2">
                                    <InputCn
                                        @bind-Value="_commentText"
                                        Placeholder="Add a comment..."
                                        Class="h-7 border-0 bg-muted/50 px-2 text-xs shadow-none focus-visible:ring-0" />
                                    <ButtonCn
                                        Variant="ButtonVariant.Ghost"
                                        Size="ButtonSize.Sm"
                                        Class="h-7 shrink-0 px-2 text-xs"
                                        Disabled="@(string.IsNullOrWhiteSpace(_commentText))">
                                        Post
                                    </ButtonCn>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Team sidebar *@
        <div class="w-full border-t sm:w-52 sm:border-t-0 sm:border-l">
            <div class="flex items-center gap-2 border-b px-4 py-3">
                <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-xs">Team members</span>
            </div>
            <div>
                @for (int i = 0; i < _teamMembers.Length; i++)
                {
                    var member = _teamMembers[i];
                    var notLast = i < _teamMembers.Length - 1;
                    <div class="@Cn.Merge("flex items-center gap-2 px-4 py-2.5", notLast ? "border-b" : "")">
                        <div class="relative">
                            <AvatarCn>
                                <AvatarFallbackCn Class="text-[9px]">@member.Initials</AvatarFallbackCn>
                            </AvatarCn>
                            @if (member.IsOnline)
                            {
                                <span class="absolute right-0 bottom-0 size-1.5 rounded-full bg-emerald-500 ring-1 ring-card"></span>
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="block truncate text-xs font-medium">@member.Name</span>
                            <span class="text-muted-foreground text-[10px]">@member.Role</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record TeamMember(string Id, string Name, string Initials, string Role, bool IsOnline);
    private record FileComment(string Id, string Author, string AuthorInitials, string Text, string Time);
    private record SharedFile(string Id, string Name, string Size, string Type, string UploadedBy, string UploadedByInitials, string UploadedAt, FileComment[] Comments);

    private static readonly TeamMember[] _teamMembers =
    [
        new("1", "Sarah Chen",    "SC", "Admin",  true),
        new("2", "Marcus Rivera", "MR", "Editor", true),
        new("3", "Aisha Patel",   "AP", "Editor", false),
        new("4", "James Okafor",  "JO", "Viewer", false),
    ];

    private static readonly SharedFile[] _sharedFiles =
    [
        new("1", "brand-guidelines-v3.pdf",         "4.2 MB", "document",    "Sarah Chen",    "SC", "2 hours ago",
            [
                new("c1", "Marcus Rivera", "MR", "Updated the color palette section on page 12", "1 hour ago"),
                new("c2", "Aisha Patel",   "AP", "Looks good. Approved for distribution.",       "45 min ago"),
            ]),
        new("2", "hero-banner-final.png",            "2.8 MB", "image",       "Marcus Rivera", "MR", "5 hours ago",
            [
                new("c3", "Sarah Chen",    "SC", "Can we get a version without the tagline?",    "3 hours ago"),
            ]),
        new("3", "q1-metrics-report.xlsx",           "890 KB", "spreadsheet", "Aisha Patel",   "AP", "Yesterday",
            []),
        new("4", "onboarding-flow-wireframes.pdf",   "6.1 MB", "document",    "Sarah Chen",    "SC", "2 days ago",
            [
                new("c4", "James Okafor",  "JO", "Step 3 feels redundant. Can we combine it with step 2?", "Yesterday"),
            ]),
    ];

    private string? _expanded = "1";
    private string _commentText = "";

    private void ToggleExpand(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private static string GetFileIconName(string type) => type switch
    {
        "image"       => "image",
        "document"    => "file-text",
        "spreadsheet" => "file",
        _             => "file",
    };
}
