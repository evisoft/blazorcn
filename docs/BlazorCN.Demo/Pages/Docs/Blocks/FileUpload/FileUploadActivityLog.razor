@* ============================================================
   Block: file-upload-activity-log
   Title: FileUploadActivityLog
   Description: File upload activity and audit log block for React and Next.js with filterable action types, timestamped entries, user attribution, and pagination using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-activity-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Activity log</span>
            <p class="mt-0.5 text-muted-foreground text-xs">
                @_filtered.Length @(_filtered.Length == 1 ? "entry" : "entries")
            </p>
        </div>

        @* Filters *@
        <div class="flex flex-wrap items-center gap-1.5 border-b px-4 py-2.5">
            @foreach (var f in _filterOptions)
            {
                var fVal = f;
                <ButtonCn
                    Variant="@(_filter == fVal ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                    Size="ButtonSize.Sm"
                    Class="h-7 text-xs capitalize"
                    OnClick="@(() => HandleFilterChange(fVal))">
                    @fVal
                </ButtonCn>
            }
        </div>

        @* Table header *@
        <div class="grid grid-cols-[1fr_auto_auto] items-center gap-4 border-b bg-muted/30 px-4 py-2">
            <span class="text-muted-foreground text-xs font-medium">File</span>
            <span class="w-20 text-right text-muted-foreground text-xs font-medium">Size</span>
            <span class="w-28 text-right text-muted-foreground text-xs font-medium">Time</span>
        </div>

        @* Entries *@
        <div>
            @for (int i = 0; i < _visible.Length; i++)
            {
                var entry = _visible[i];
                var isLast = i == _visible.Length - 1;
                var cfg = GetActionConfig(entry.Action);
                <div class="@Cn.Merge("grid grid-cols-[1fr_auto_auto] items-center gap-4 px-4 py-2.5", isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3 min-w-0">
                        <LucideIconCn Name="@cfg.IconName" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate font-medium text-sm">@entry.FileName</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-[10px] font-normal">
                                    @cfg.Label
                                </BadgeCn>
                            </div>
                            <span class="text-muted-foreground text-xs">@entry.User</span>
                        </div>
                    </div>
                    <span class="w-20 text-right text-muted-foreground text-xs tabular-nums">
                        @entry.FileSize
                    </span>
                    <span class="w-28 text-right text-muted-foreground text-xs">
                        @entry.Timestamp
                    </span>
                </div>
            }
        </div>

        @* Empty state *@
        @if (_visible.Length == 0)
        {
            <div class="px-4 py-8 text-center">
                <span class="text-muted-foreground text-xs">No activity found</span>
            </div>
        }

        @* Pagination *@
        @if (_totalPages > 1)
        {
            <div class="flex items-center justify-between border-t px-4 py-2.5">
                <span class="text-muted-foreground text-xs tabular-nums">
                    Page @(_page + 1) of @_totalPages
                </span>
                <div class="flex items-center gap-1">
                    <ButtonCn
                        Variant="ButtonVariant.Ghost"
                        Size="ButtonSize.Sm"
                        Class="h-7 gap-1 px-2 text-xs"
                        Disabled="@(_page == 0)"
                        OnClick="@(() => _page = _page - 1)">
                        <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                        Previous
                    </ButtonCn>
                    <ButtonCn
                        Variant="ButtonVariant.Ghost"
                        Size="ButtonSize.Sm"
                        Class="h-7 gap-1 px-2 text-xs"
                        Disabled="@(_page >= _totalPages - 1)"
                        OnClick="@(() => _page = _page + 1)">
                        Next
                        <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                    </ButtonCn>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record ActivityEntry(string Id, string Timestamp, string User, string Action, string FileName, string FileSize);
    private record ActionConfig(string IconName, string Label);

    private static readonly ActivityEntry[] _entries =
    [
        new("1",  "Mar 24, 10:42 AM", "Sarah Chen",   "uploaded",   "Q1-financial-report.pdf",      "2.4 MB"),
        new("2",  "Mar 24, 10:38 AM", "James Wilson", "downloaded", "brand-guidelines-v3.pdf",      "8.1 MB"),
        new("3",  "Mar 24, 10:15 AM", "Sarah Chen",   "renamed",    "meeting-notes-final.docx",     "156 KB"),
        new("4",  "Mar 24, 9:52 AM",  "Priya Patel",  "deleted",    "old-logo-draft.png",           "1.2 MB"),
        new("5",  "Mar 24, 9:30 AM",  "James Wilson", "uploaded",   "product-roadmap-2026.xlsx",    "892 KB"),
        new("6",  "Mar 23, 5:14 PM",  "Maria Garcia", "downloaded", "api-documentation.pdf",        "3.6 MB"),
        new("7",  "Mar 23, 4:48 PM",  "Priya Patel",  "uploaded",   "user-research-findings.pptx",  "5.3 MB"),
        new("8",  "Mar 23, 3:22 PM",  "Sarah Chen",   "renamed",    "contract-amendment-v2.pdf",    "420 KB"),
        new("9",  "Mar 23, 2:10 PM",  "Maria Garcia", "deleted",    "temp-export-data.csv",         "78 KB"),
        new("10", "Mar 23, 1:05 PM",  "James Wilson", "uploaded",   "onboarding-checklist.pdf",     "310 KB"),
        new("11", "Mar 23, 11:30 AM", "Priya Patel",  "downloaded", "design-system-tokens.json",    "24 KB"),
        new("12", "Mar 22, 4:55 PM",  "Sarah Chen",   "uploaded",   "sprint-retrospective.md",      "12 KB"),
    ];

    private static readonly string[] _filterOptions = ["all", "uploaded", "downloaded", "renamed", "deleted"];

    private const int PageSize = 5;

    private string _filter = "all";
    private int _page = 0;

    private ActivityEntry[] _filtered => _filter == "all" ? _entries : _entries.Where(e => e.Action == _filter).ToArray();
    private int _totalPages => (int)Math.Ceiling(_filtered.Length / (double)PageSize);
    private ActivityEntry[] _visible => _filtered.Skip(_page * PageSize).Take(PageSize).ToArray();

    private static ActionConfig GetActionConfig(string action) => action switch
    {
        "uploaded"   => new("upload",        "Uploaded"),
        "deleted"    => new("trash-2",       "Deleted"),
        "renamed"    => new("pencil",        "Renamed"),
        "downloaded" => new("download",      "Downloaded"),
        _            => new("file",          action),
    };

    private void HandleFilterChange(string f)
    {
        _filter = f;
        _page = 0;
    }
}
