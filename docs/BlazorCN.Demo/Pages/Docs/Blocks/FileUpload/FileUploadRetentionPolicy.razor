@* ============================================================
   Block: file-upload-retention-policy
   Title: FileUploadRetentionPolicy
   Description: File retention policy settings for React and Next.js with auto-delete duration selector, per-file-type retention rules, grace period configuration, archive instead of delete toggle, and policy summary using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-retention-policy.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Retention policy</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Auto-delete rules for uploaded files
                    </p>
                </div>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_fileTypeRules.Length type rules
            </BadgeCn>
        </div>

        @* Default retention *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">
                    Default retention period
                </span>
            </div>
            <p class="mt-1 mb-3 text-muted-foreground text-xs">
                Files without a type-specific rule are kept for this duration
            </p>
            <div class="flex flex-wrap items-center gap-1">
                @foreach (var dur in _durationKeys)
                {
                    var d = dur;
                    <button type="button"
                            @onclick="@(() => _defaultDuration = d)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs transition-colors", _defaultDuration == d ? "bg-foreground text-background" : "text-muted-foreground hover:bg-muted/50")">
                        @GetDurationLabel(d)
                    </button>
                }
            </div>
        </div>

        @* Per-type rules *@
        <div class="border-b">
            <div class="px-4 py-2.5">
                <span class="font-medium text-muted-foreground text-xs">
                    Per-type retention rules
                </span>
            </div>
            @for (int i = 0; i < _fileTypeRules.Length; i++)
            {
                var rule = _fileTypeRules[i];
                var isExpanded = _expandedRule == rule.Id;
                var isLast = i == _fileTypeRules.Length - 1;
                <div class="@Cn.Merge("", isLast && !isExpanded ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expandedRule = (_expandedRule == rule.Id ? null : rule.Id))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="text-muted-foreground">
                            <LucideIconCn Name="@rule.IconName" Size="14" Class="size-3.5" />
                        </span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@rule.Label</span>
                            <p class="mt-0.5 font-mono text-muted-foreground text-xs">
                                @rule.Extensions
                            </p>
                        </div>
                        <span class="text-muted-foreground text-xs">
                            @GetDurationLabel(_typeDurations.ContainsKey(rule.Id) ? _typeDurations[rule.Id] : rule.DefaultDuration)
                        </span>
                        <LucideIconCn Name="chevron-right" Size="16"
                                      Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-11">
                            <div class="flex flex-wrap items-center gap-1">
                                @foreach (var dur in _durationKeys)
                                {
                                    var d = dur;
                                    var ruleId = rule.Id;
                                    <button type="button"
                                            @onclick="@(() => SetTypeDuration(ruleId, d))"
                                            class="@Cn.Merge("rounded-md px-2 py-1 text-xs transition-colors", (_typeDurations.ContainsKey(ruleId) ? _typeDurations[ruleId] : "") == d ? "bg-foreground text-background" : "text-muted-foreground hover:bg-muted/50")">
                                        @GetDurationLabel(d)
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Grace period *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="trash-2" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">
                    Grace period before deletion
                </span>
            </div>
            <p class="mt-1 mb-3 text-muted-foreground text-xs">
                Files are marked for deletion but remain accessible during grace period
            </p>
            <div class="flex items-center gap-1">
                @foreach (var gp in _graceKeys)
                {
                    var g = gp;
                    <button type="button"
                            @onclick="@(() => _gracePeriod = g)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs transition-colors", _gracePeriod == g ? "bg-foreground text-background" : "text-muted-foreground hover:bg-muted/50")">
                        @GetGraceLabel(g)
                    </button>
                }
            </div>
        </div>

        @* Archive toggle *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="archive" Size="14" Class="size-3.5 text-muted-foreground" />
                    <div>
                        <span class="font-medium text-sm">Archive instead of delete</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Move expired files to cold storage instead of permanent deletion
                        </p>
                    </div>
                </div>
                <SwitchCn Checked="@_archiveEnabled" CheckedChanged="@(() => _archiveEnabled = !_archiveEnabled)" aria-label="Archive instead of delete" />
            </div>
        </div>

        @* Policy summary *@
        <div class="px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Policy summary</span>
            <div class="mt-2.5 space-y-2">
                <div class="rounded-md bg-muted/50 p-3">
                    <div class="space-y-1.5 text-sm">
                        <div class="flex items-center justify-between">
                            <span class="text-muted-foreground text-xs">Default retention</span>
                            <span class="font-medium text-xs">@GetDurationLabel(_defaultDuration)</span>
                        </div>
                        @foreach (var rule in _fileTypeRules)
                        {
                            var typeKey = rule.Id;
                            var typeDur = _typeDurations.ContainsKey(typeKey) ? _typeDurations[typeKey] : rule.DefaultDuration;
                            <div class="flex items-center justify-between">
                                <span class="text-muted-foreground text-xs">@rule.Label</span>
                                <span class="@Cn.Merge("text-xs", typeDur != _defaultDuration ? "font-medium" : "text-muted-foreground")">
                                    @GetDurationLabel(typeDur)
                                </span>
                            </div>
                        }
                        <div class="my-1.5 border-t"></div>
                        <div class="flex items-center justify-between">
                            <span class="text-muted-foreground text-xs">Grace period</span>
                            <span class="font-medium text-xs">@GetGraceLabel(_gracePeriod)</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-muted-foreground text-xs">Expired action</span>
                            <span class="font-medium text-xs">@(_archiveEnabled ? "Archive" : "Delete")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record FileTypeRule(string Id, string Label, string IconName, string Extensions, string DefaultDuration);

    private static readonly FileTypeRule[] _fileTypeRules =
    [
        new("images",       "Images",       "image",           "PNG, JPG, SVG, WebP", "90d"),
        new("documents",    "Documents",    "file-text",       "PDF, DOC, TXT, MD",   "1y"),
        new("videos",       "Videos",       "video",           "MP4, MOV, WebM, AVI", "180d"),
        new("spreadsheets", "Spreadsheets", "file-spreadsheet","CSV, XLS, XLSX",      "1y"),
        new("archives",     "Archives",     "file",            "ZIP, TAR, GZ, RAR",   "90d"),
    ];

    private static readonly string[] _durationKeys = ["30d", "90d", "180d", "1y", "2y", "forever"];
    private static readonly string[] _graceKeys    = ["none", "7d", "14d", "30d"];

    private string _defaultDuration = "90d";
    private Dictionary<string, string> _typeDurations = new()
    {
        ["images"]       = "90d",
        ["documents"]    = "1y",
        ["videos"]       = "180d",
        ["spreadsheets"] = "1y",
        ["archives"]     = "90d",
    };
    private string _gracePeriod   = "14d";
    private bool   _archiveEnabled = true;
    private string? _expandedRule  = "documents";

    private static string GetDurationLabel(string key) => key switch
    {
        "30d"     => "30 days",
        "90d"     => "90 days",
        "180d"    => "180 days",
        "1y"      => "1 year",
        "2y"      => "2 years",
        "forever" => "Forever",
        _         => key,
    };

    private static string GetGraceLabel(string key) => key switch
    {
        "none" => "None",
        "7d"   => "7 days",
        "14d"  => "14 days",
        "30d"  => "30 days",
        _      => key,
    };

    private void SetTypeDuration(string id, string duration)
    {
        _typeDurations[id] = duration;
    }
}
