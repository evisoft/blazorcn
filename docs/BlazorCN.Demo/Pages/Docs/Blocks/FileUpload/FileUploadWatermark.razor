@* ============================================================
   Block: file-upload-watermark
   Title: FileUploadWatermark
   Description: React image upload block for Next.js with watermark text overlay, position selector, opacity slider, live preview, and download with watermark built with shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-watermark.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Watermark</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Upload an image and apply a text watermark
                </p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                <LucideIconCn Name="upload" Size="12" Class="size-3" />
                Upload
            </ButtonCn>
        </div>

        @* Image preview with watermark *@
        @if (_hasImage)
        {
            <div class="border-b">
                <div
                    class="relative flex aspect-video w-full bg-muted/30 p-4"
                    style="@($"align-items:{_posCSS.AlignItems};justify-content:{_posCSS.JustifyContent}")">
                    @* Simulated image background *@
                    <div class="absolute inset-0 flex items-center justify-center">
                        <div class="flex flex-col items-center gap-2 text-muted-foreground/30">
                            <LucideIconCn Name="image" Size="64" Class="size-16" />
                            <span class="font-medium text-xs">@_sampleImage.Name</span>
                        </div>
                    </div>

                    @* Watermark overlay *@
                    @if (!string.IsNullOrEmpty(_watermarkText))
                    {
                        <span
                            class="pointer-events-none relative select-none font-bold text-foreground text-lg tracking-wider"
                            style="@($"opacity:{_opacity / 100.0:F2}")">
                            @_watermarkText
                        </span>
                    }
                </div>

                @* Image info bar *@
                <div class="flex items-center gap-3 border-t px-4 py-2">
                    <span class="truncate font-medium text-xs">@_sampleImage.Name</span>
                    <span class="text-muted-foreground text-xs">@_sampleImage.Size</span>
                    <span class="text-muted-foreground text-xs">·</span>
                    <span class="font-mono text-muted-foreground text-xs">@_sampleImage.Dimensions</span>
                </div>
            </div>
        }
        else
        {
            <div class="flex items-center justify-center border-b py-16">
                <div class="flex flex-col items-center gap-2 text-muted-foreground">
                    <LucideIconCn Name="image" Size="32" Class="size-8" />
                    <span class="text-xs">Upload an image to get started</span>
                </div>
            </div>
        }

        @* Watermark text *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Watermark text</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_watermarkText.Length chars
                </BadgeCn>
            </div>
            <InputCn @bind-Value="_watermarkText" Placeholder="Enter watermark text..." Class="h-8 text-sm" />
        </div>

        @* Position selector *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Position</span>
            <div class="inline-grid grid-cols-3 gap-1 rounded-md bg-muted/50 p-1">
                @foreach (var row in _positionGrid)
                {
                    @foreach (var pos in row)
                    {
                        var capturedPos = pos;
                        <button
                            type="button"
                            @onclick="@(() => SetPosition(capturedPos))"
                            class="@Cn.Merge("flex size-8 items-center justify-center rounded text-xs transition-colors", _position == capturedPos ? "bg-background font-medium text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")">
                            @_positionLabels[capturedPos]
                        </button>
                    }
                }
            </div>
            <span class="ml-3 inline-block align-middle text-muted-foreground text-xs">
                @_position.Replace("-", " ")
            </span>
        </div>

        @* Opacity slider *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Opacity</span>
                <span class="font-mono text-muted-foreground text-xs tabular-nums">@_opacity%</span>
            </div>
            <SliderCn @bind-Value="_opacity" Min="5" Max="100" Step="5" />
            <div class="mt-1.5 flex justify-between text-muted-foreground text-xs">
                <span>Subtle</span>
                <span>Opaque</span>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3">
            <p class="text-muted-foreground text-xs">
                Watermark is applied on download. Original file is not modified.
            </p>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                <LucideIconCn Name="download" Size="12" Class="size-3" />
                Download
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record UploadedImage(string Name, string Size, string Dimensions);
    private record PositionCSS(string AlignItems, string JustifyContent);

    private static readonly UploadedImage _sampleImage = new("product-hero-shot.jpg", "3.2 MB", "2400 x 1600");

    private static readonly Dictionary<string, string> _positionLabels = new()
    {
        ["top-left"] = "TL",
        ["top-center"] = "TC",
        ["top-right"] = "TR",
        ["center-left"] = "CL",
        ["center"] = "C",
        ["center-right"] = "CR",
        ["bottom-left"] = "BL",
        ["bottom-center"] = "BC",
        ["bottom-right"] = "BR",
    };

    private static readonly string[][] _positionGrid =
    [
        ["top-left", "top-center", "top-right"],
        ["center-left", "center", "center-right"],
        ["bottom-left", "bottom-center", "bottom-right"],
    ];

    private static readonly Dictionary<string, PositionCSS> _positionToCSS = new()
    {
        ["top-left"]      = new("flex-start", "flex-start"),
        ["top-center"]    = new("flex-start", "center"),
        ["top-right"]     = new("flex-start", "flex-end"),
        ["center-left"]   = new("center", "flex-start"),
        ["center"]        = new("center", "center"),
        ["center-right"]  = new("center", "flex-end"),
        ["bottom-left"]   = new("flex-end", "flex-start"),
        ["bottom-center"] = new("flex-end", "center"),
        ["bottom-right"]  = new("flex-end", "flex-end"),
    };

    private bool _hasImage = true;
    private string _watermarkText = "PREVIEW ONLY";
    private string _position = "bottom-right";
    private double _opacity = 40;

    private PositionCSS _posCSS => _positionToCSS[_position];

    private void SetPosition(string pos)
    {
        _position = pos;
    }
}
