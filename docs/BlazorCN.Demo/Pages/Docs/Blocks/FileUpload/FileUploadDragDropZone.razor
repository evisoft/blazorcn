@* ============================================================
   Block: file-upload-drag-drop-zone
   Title: FileUploadDragDropZone
   Description: A large drag-and-drop file upload zone with animated visual feedback for default, drag-over, uploading, and complete states using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-drag-drop-zone.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Upload file</span>
            @if (_state == UploadState.Uploading)
            {
                <span class="tabular-nums text-muted-foreground text-xs">@_progress%</span>
            }
            @if (_state == UploadState.Complete)
            {
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5" />
                    Complete
                </span>
            }
        </div>

        @* Drop zone *@
        <div
            class="p-4"
            @ondrop="HandleDrop"
            @ondragenter="HandleDragEnter"
            @ondragleave="HandleDragLeave"
            @ondragover:preventDefault="true">
            <div class="@Cn.Merge("flex flex-col items-center justify-center rounded-md border-2 border-dashed px-6 py-12 transition-all duration-200",
                _state == UploadState.Dragging  ? "border-foreground bg-muted/50" :
                _state == UploadState.Uploading ? "border-muted-foreground/30 bg-muted/30" :
                _state == UploadState.Complete  ? "border-emerald-500/40 bg-emerald-500/5" :
                                                  "border-muted-foreground/25 hover:border-muted-foreground/40")">
                @if (_state == UploadState.Complete)
                {
                    <LucideIconCn Name="check-circle-2" Size="40" Class="mb-3 size-10 text-emerald-600 dark:text-emerald-400" />
                    <span class="font-medium text-sm">@_file?.Name</span>
                    <span class="mt-1 text-muted-foreground text-xs">
                        @_file?.Size &middot; @_file?.Type
                    </span>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-4 h-7 text-xs" OnClick="Reset">
                        Upload another
                    </ButtonCn>
                }
                else if (_state == UploadState.Uploading)
                {
                    <LucideIconCn Name="upload-cloud" Size="40" Class="mb-3 size-10 animate-pulse text-muted-foreground" />
                    <span class="font-medium text-sm">@_file?.Name</span>
                    <span class="mt-1 text-muted-foreground text-xs">
                        Uploading &middot; @_file?.Size
                    </span>
                    <div class="mt-4 w-full max-w-xs">
                        <ProgressCn Value="@_progress" Class="h-1.5" />
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="mt-3 h-7 gap-1 text-muted-foreground text-xs" OnClick="Reset">
                        <LucideIconCn Name="x" Size="12" Class="size-3" />
                        Cancel
                    </ButtonCn>
                }
                else
                {
                    <LucideIconCn Name="upload-cloud" Size="40" Class="@Cn.Merge("mb-3 size-10 text-muted-foreground transition-transform duration-200", _state == UploadState.Dragging ? "scale-110 text-foreground" : "")" />
                    <span class="font-medium text-sm">
                        @(_state == UploadState.Dragging ? "Drop file here" : "Drag and drop your file")
                    </span>
                    <span class="mt-1 text-muted-foreground text-xs">
                        or click to browse from your computer
                    </span>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-4 h-7 text-xs" OnClick="TriggerFilePicker">
                        Browse files
                    </ButtonCn>
                    <InputCn type="file" id="dz-file-input" class="hidden" @onchange="HandleFileSelect" />
                }
            </div>
        </div>

        @* Footer hint *@
        <div class="border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                Maximum file size: 50 MB. Supported formats: PNG, JPG, PDF, ZIP.
            </span>
        </div>
    </div>
</section>

@code {
    private enum UploadState { Idle, Dragging, Uploading, Complete }

    private class UploadedFile
    {
        public string Name { get; set; } = "";
        public string Size { get; set; } = "";
        public string Type { get; set; } = "";
    }

    private UploadState _state = UploadState.Idle;
    private int _progress = 0;
    private UploadedFile? _file = null;
    private int _dragCounter = 0;

    private string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{(bytes / 1024.0):F1} KB";
        return $"{(bytes / (1024.0 * 1024.0)):F1} MB";
    }

    private void HandleDragEnter(DragEventArgs e)
    {
        _dragCounter++;
        if (_dragCounter == 1)
            _state = UploadState.Dragging;
    }

    private void HandleDragLeave(DragEventArgs e)
    {
        _dragCounter--;
        if (_dragCounter == 0)
            _state = UploadState.Idle;
    }

    private void HandleDrop(DragEventArgs e)
    {
        _dragCounter = 0;
        _state = UploadState.Idle;
        // In Blazor, DataTransfer files aren't directly accessible from DragEventArgs in all render modes.
        // Simulate an upload with a placeholder file to demonstrate the UI states.
        SimulateUpload("dropped-file.bin", 2_500_000, "application/octet-stream");
    }

    private void HandleFileSelect(ChangeEventArgs e)
    {
        // File content isn't available from ChangeEventArgs in all render modes;
        // simulate an upload with a representative placeholder.
        SimulateUpload("selected-file.pdf", 1_200_000, "application/pdf");
    }

    private void TriggerFilePicker()
    {
        // In a real app, inject IJSRuntime and call JS to click the hidden input.
        // For demo purposes, simulate an upload directly.
        SimulateUpload("demo-document.pdf", 3_400_000, "application/pdf");
    }

    private void SimulateUpload(string name, long sizeBytes, string type)
    {
        _file = new UploadedFile
        {
            Name = name,
            Size = FormatSize(sizeBytes),
            Type = type
        };
        _state = UploadState.Uploading;
        _progress = 75; // static snapshot for SSR/demo — real progress needs a timer
    }

    private void Reset()
    {
        _state = UploadState.Idle;
        _progress = 0;
        _file = null;
        _dragCounter = 0;
    }
}
