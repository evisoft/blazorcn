@* ============================================================
   Block: file-upload-font-preview
   Title: FileUploadFontPreview
   Description: Font file upload block for React and Next.js with sample text preview, font metadata display, character set info, and glyph count using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-font-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2 min-w-0">
                <LucideIconCn Name="type" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                <span class="truncate font-medium text-sm">
                    @(_font != null ? _font.FamilyName : "Font Preview")
                </span>
                @if (_font != null)
                {
                    <span class="text-muted-foreground text-xs">·</span>
                    <span class="text-muted-foreground text-xs">@_font.Weight</span>
                }
            </div>
            @if (_font != null)
            {
                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">
                    @_font.Format
                </BadgeCn>
            }
        </div>

        @if (_font == null)
        {
            @* Upload area *@
            <div class="p-4">
                <div
                    role="button"
                    tabindex="0"
                    @ondragover:preventDefault
                    @ondragover="@(() => _isDragging = true)"
                    @ondragleave:preventDefault
                    @ondragleave="@(() => _isDragging = false)"
                    @ondrop:preventDefault
                    @ondrop="HandleDrop"
                    @onclick="HandleUpload"
                    @onkeydown="HandleDropZoneKeyDown"
                    class="@Cn.Merge("flex cursor-pointer flex-col items-center justify-center gap-2 rounded-md border-2 border-dashed px-6 py-12 transition-colors", _isDragging ? "border-foreground/30 bg-muted/50" : "border-muted-foreground/20 hover:border-muted-foreground/40 hover:bg-muted/30")">
                    <LucideIconCn Name="cloud-upload" Size="32" Class="size-8 text-muted-foreground/60" />
                    <span class="font-medium text-sm">Drop a font file here</span>
                    <p class="text-muted-foreground text-xs">
                        Supports TTF, OTF, WOFF, and WOFF2 files
                    </p>
                </div>
            </div>
        }
        else
        {
            @* Font preview at different sizes *@
            <div class="border-b px-4 py-4">
                <div class="mb-3 flex items-center justify-between">
                    <span class="font-medium text-muted-foreground text-xs">Preview</span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" OnClick="TogglePreviewText">
                        Toggle sample
                    </ButtonCn>
                </div>
                <div class="space-y-3">
                    @foreach (var size in _sampleSizes)
                    {
                        <div>
                            <span class="text-muted-foreground text-xs tabular-nums">@(size)px</span>
                            <p class="mt-0.5 leading-snug" style="@($"font-size:{size}px")">
                                @_previewText
                            </p>
                        </div>
                    }
                </div>
            </div>

            @* Font metadata *@
            <div class="border-b px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">Metadata</span>
                <div class="mt-2 grid grid-cols-2 gap-x-4 gap-y-2">
                    <div>
                        <span class="text-muted-foreground text-xs">Family</span>
                        <p class="font-medium text-sm">@_font.FamilyName</p>
                    </div>
                    <div>
                        <span class="text-muted-foreground text-xs">Weight</span>
                        <p class="font-medium text-sm">@_font.Weight</p>
                    </div>
                    <div>
                        <span class="text-muted-foreground text-xs">Style</span>
                        <p class="font-medium text-sm">@_font.Style</p>
                    </div>
                    <div>
                        <span class="text-muted-foreground text-xs">Version</span>
                        <p class="font-medium text-sm">@_font.Version</p>
                    </div>
                    <div>
                        <span class="text-muted-foreground text-xs">Designer</span>
                        <p class="font-medium text-sm">@_font.Designer</p>
                    </div>
                    <div>
                        <span class="text-muted-foreground text-xs">File size</span>
                        <p class="font-medium text-sm">@_font.FileSize</p>
                    </div>
                </div>
            </div>

            @* Glyph count *@
            <div class="flex items-center gap-4 border-b px-4 py-3">
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-2xl tabular-nums">
                        @_font.GlyphCount.ToString("N0")
                    </span>
                    <span class="text-muted-foreground text-xs">glyphs</span>
                </div>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs">@_font.License</span>
            </div>

            @* Character sets *@
            <div class="px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">
                    Character set coverage
                </span>
                <div class="mt-2 space-y-1.5">
                    @foreach (var cs in _font.CharSets)
                    {
                        <div class="flex items-center justify-between">
                            <span class="text-sm">@cs.Name</span>
                            <span class="font-mono text-xs text-muted-foreground tabular-nums">
                                @cs.Coverage
                            </span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record CharSet(string Name, string Coverage);

    private record FontMeta(
        string FileName,
        string FamilyName,
        string Weight,
        string Style,
        string Format,
        string Version,
        string Designer,
        string License,
        int GlyphCount,
        string FileSize,
        CharSet[] CharSets);

    private static readonly FontMeta _sampleFont = new(
        FileName: "Inter-SemiBold.woff2",
        FamilyName: "Inter",
        Weight: "600 (SemiBold)",
        Style: "Normal",
        Format: "WOFF2",
        Version: "4.0",
        Designer: "Rasmus Andersson",
        License: "SIL Open Font License 1.1",
        GlyphCount: 2548,
        FileSize: "98.4 KB",
        CharSets:
        [
            new("Basic Latin", "100%"),
            new("Latin Extended-A", "100%"),
            new("Latin Extended-B", "72%"),
            new("Cyrillic", "100%"),
            new("Greek", "95%"),
            new("Vietnamese", "100%"),
        ]);

    private static readonly int[] _sampleSizes = [14, 20, 32, 48];

    private FontMeta? _font = null;
    private string _previewText = "The quick brown fox jumps over the lazy dog";
    private bool _isDragging = false;

    private void HandleUpload()
    {
        _font = _sampleFont;
    }

    private void HandleDrop()
    {
        _isDragging = false;
        _font = _sampleFont;
    }

    private void HandleDropZoneKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            HandleUpload();
        }
    }

    private void TogglePreviewText()
    {
        _previewText = _previewText == "The quick brown fox jumps over the lazy dog"
            ? "ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz 0123456789"
            : "The quick brown fox jumps over the lazy dog";
    }
}
