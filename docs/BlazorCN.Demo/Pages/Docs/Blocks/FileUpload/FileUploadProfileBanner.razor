@* ============================================================
   Block: file-upload-profile-banner
   Title: FileUploadProfileBanner
   Description: A React profile banner and cover image upload block with 16:9 aspect ratio preview, camera icon overlay, position/crop indicator, and upload/remove controls using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-profile-banner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Cover image</p>
                <p class="text-muted-foreground text-xs">Recommended size: 1500 x 500 px</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                16:9
            </BadgeCn>
        </div>

        @* Banner preview area *@
        <div class="border-b px-4 py-4">
            <div class="group relative overflow-hidden rounded-md border"
                 @ondragover="HandleDragOver"
                 @ondragover:preventDefault="true"
                 @ondragleave="HandleDragLeave"
                 @ondrop="HandleDrop"
                 @ondrop:preventDefault="true">
                @* 16:9 aspect ratio container *@
                <div class="aspect-video w-full">
                    @if (_hasBanner)
                    {
                        <div class="relative flex size-full items-center justify-center bg-muted/50">
                            @* Placeholder pattern for current banner *@
                            <div class="absolute inset-0">
                                <div class="size-full bg-gradient-to-b from-muted/80 to-muted/20"></div>
                            </div>

                            @* Camera overlay on hover *@
                            <div class="relative z-10 flex flex-col items-center gap-2 rounded-md bg-background/70 px-4 py-3 opacity-0 transition-opacity group-hover:opacity-100">
                                <LucideIconCn Name="camera" Size="20" Class="size-5 text-muted-foreground" />
                                <span class="text-muted-foreground text-xs">Change cover image</span>
                            </div>

                            @* Position indicator *@
                            <div class="absolute right-2 bottom-2 z-10 flex items-center gap-1 rounded bg-background/70 px-1.5 py-0.5 opacity-0 transition-opacity group-hover:opacity-100">
                                <LucideIconCn Name="move-vertical" Size="12" Class="size-3 text-muted-foreground" />
                                <span class="text-muted-foreground text-[10px]">Drag to reposition</span>
                            </div>

                            @* Current banner file info *@
                            <div class="absolute bottom-2 left-2 z-10 flex items-center gap-1.5 rounded bg-background/70 px-1.5 py-0.5">
                                <span class="font-mono text-muted-foreground text-[10px]">banner-cover.jpg</span>
                                <span class="text-muted-foreground text-[10px]">·</span>
                                <span class="font-mono text-muted-foreground text-[10px]">1.4 MB</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="@Cn.Merge("flex size-full flex-col items-center justify-center gap-2 transition-colors", _isDragging ? "bg-muted/60" : "bg-muted/30")">
                            <LucideIconCn Name="upload" Size="24" Class="size-6 text-muted-foreground/50" />
                            <div class="text-center">
                                <p class="font-medium text-sm">Upload cover image</p>
                                <p class="mt-0.5 text-muted-foreground text-xs">Drag and drop or click to browse</p>
                            </div>
                            <p class="text-muted-foreground/60 text-[10px]">JPG, PNG, WebP up to 5 MB</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Crop info *@
        @if (_hasBanner)
        {
            <div class="flex items-center gap-4 border-b px-4 py-2.5">
                <div class="flex items-center gap-2">
                    <span class="text-muted-foreground text-xs">Position</span>
                    <span class="font-mono text-xs">center 40%</span>
                </div>
                <span class="text-muted-foreground/40 text-xs">·</span>
                <div class="flex items-center gap-2">
                    <span class="text-muted-foreground text-xs">Dimensions</span>
                    <span class="font-mono text-xs">1920 x 640</span>
                </div>
                <span class="text-muted-foreground/40 text-xs">·</span>
                <div class="flex items-center gap-2">
                    <span class="text-muted-foreground text-xs">Format</span>
                    <span class="font-mono text-xs">JPEG</span>
                </div>
            </div>
        }

        @* Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <p class="text-muted-foreground text-xs">
                @(_hasBanner ? "Hover over the image to reposition" : "No cover image set")
            </p>
            <div class="flex items-center gap-2">
                @if (_hasBanner)
                {
                    <ButtonCn
                        Variant="ButtonVariant.Ghost"
                        Size="ButtonSize.Sm"
                        Class="h-7 gap-1 px-2 text-xs text-red-600 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300"
                        OnClick="RemoveBanner">
                        <LucideIconCn Name="trash-2" Size="12" Class="size-3" />
                        Remove
                    </ButtonCn>
                }
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="upload" Size="12" Class="size-3" />
                    @(_hasBanner ? "Replace" : "Upload")
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private bool _hasBanner = true;
    private bool _isDragging = false;

    private void HandleDragOver(DragEventArgs e)
    {
        _isDragging = true;
    }

    private void HandleDragLeave(DragEventArgs e)
    {
        _isDragging = false;
    }

    private void HandleDrop(DragEventArgs e)
    {
        _isDragging = false;
        _hasBanner = true;
    }

    private void RemoveBanner()
    {
        _hasBanner = false;
    }
}
