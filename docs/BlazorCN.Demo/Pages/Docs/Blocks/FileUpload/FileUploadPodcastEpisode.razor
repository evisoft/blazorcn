@* ============================================================
   Block: file-upload-podcast-episode
   Title: FileUploadPodcastEpisode
   Description: A podcast episode upload block for React and Next.js with audio file upload, episode title input, description textarea, show notes, episode number, season selector, explicit content toggle, and publish date using shadcn/ui Button, Badge, Input, Switch, Select, and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-podcast-episode.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="mic" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">New episode</span>
            @if (_file != null)
            {
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_file.Duration
                </BadgeCn>
            }
        </div>

        @* Audio upload *@
        <div class="border-b px-4 py-3">
            @if (_file != null)
            {
                <div class="flex items-center gap-3 rounded-md bg-muted/50 p-3">
                    <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-background">
                        <LucideIconCn Name="file-audio" Size="16" Class="size-4 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="truncate font-medium text-sm">@_file.Name</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            @_file.Format &middot; @_file.Size &middot; @_file.Duration
                        </p>
                    </div>
                    <ButtonCn
                        Variant="ButtonVariant.Ghost"
                        Size="ButtonSize.Sm"
                        Class="size-7 shrink-0 p-0 text-muted-foreground hover:text-foreground"
                        OnClick="@(() => _file = null)">
                        <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                    </ButtonCn>
                </div>
            }
            else
            {
                <div
                    @ondragover:preventDefault
                    @ondragover="@(() => _isDragOver = true)"
                    @ondragleave="@(() => _isDragOver = false)"
                    @ondrop:preventDefault
                    @ondrop="@(() => _isDragOver = false)"
                    class="@Cn.Merge("flex flex-col items-center justify-center gap-2 rounded-md border border-dashed px-4 py-8 transition-colors", _isDragOver ? "border-foreground/30 bg-muted/50" : "border-muted-foreground/25")">
                    <LucideIconCn Name="upload-cloud" Size="20" Class="size-5 text-muted-foreground/60" />
                    <div class="text-center">
                        <p class="font-medium text-sm">Drop audio file here</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">MP3, WAV, M4A up to 500 MB</p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-1 h-7 text-xs">
                        Choose file
                    </ButtonCn>
                </div>
            }
        </div>

        @* Episode title *@
        <div class="border-b px-4 py-3">
            <p class="mb-1.5 font-medium text-muted-foreground text-xs">Episode title</p>
            <InputCn
                @bind-Value="_title"
                Placeholder="Enter episode title..."
                Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
        </div>

        @* Description *@
        <div class="border-b px-4 py-3">
            <p class="mb-1.5 font-medium text-muted-foreground text-xs">Description</p>
            <TextareaCn
                @bind-Value="_description"
                Placeholder="Episode description..."
                Class="min-h-[60px] resize-none border-0 bg-transparent p-0 text-sm shadow-none focus-visible:ring-0" />
        </div>

        @* Show notes *@
        <div class="border-b px-4 py-3">
            <p class="mb-1.5 font-medium text-muted-foreground text-xs">Show notes</p>
            <TextareaCn
                @bind-Value="_showNotes"
                Placeholder="Timestamps, links, resources..."
                Class="min-h-[80px] resize-none border-0 bg-transparent p-0 font-mono text-xs shadow-none focus-visible:ring-0" />
        </div>

        @* Season, Episode, Explicit *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-3 gap-3">
                <div>
                    <p class="mb-1.5 font-medium text-muted-foreground text-xs">Season</p>
                    <SelectCn @bind-Value="_season">
                        <SelectTriggerCn Class="h-8 text-xs">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="1">Season 1</SelectItemCn>
                            <SelectItemCn Value="2">Season 2</SelectItemCn>
                            <SelectItemCn Value="3">Season 3</SelectItemCn>
                            <SelectItemCn Value="4">Season 4</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div>
                    <p class="mb-1.5 font-medium text-muted-foreground text-xs">Episode</p>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="hash" Size="12" Class="size-3 text-muted-foreground" />
                        <InputCn
                            @bind-Value="_episodeNumber"
                            Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
                    </div>
                </div>
                <div>
                    <p class="mb-1.5 font-medium text-muted-foreground text-xs">Explicit</p>
                    <div class="flex h-8 items-center">
                        <span class="flex items-center gap-2 text-xs">
                            <SwitchCn @bind-Value="_isExplicit" />
                            <span class="text-muted-foreground">@(_isExplicit ? "Yes" : "No")</span>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        @* Publish date + Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                Publish: March 28, 2026
            </span>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Save draft
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Publish episode
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record AudioFile(string Name, string Size, string Format, string Duration);

    private static readonly AudioFile _uploaded = new(
        "episode-recording-final.mp3",
        "78.4 MB",
        "MP3",
        "54:32");

    private AudioFile? _file = _uploaded;
    private string _title = "Building Design Systems at Scale";
    private string _description = "We sit down with the lead designer at a fast-growing startup to discuss how they built and maintained a design system across 12 product teams. Topics include token architecture, component governance, and getting buy-in from engineering leadership.";
    private string _showNotes = "00:00 Introduction\n03:15 What is a design system?\n12:40 Token architecture deep dive\n28:00 Component governance model\n41:30 Engineering buy-in strategies\n50:15 Rapid fire questions";
    private string _season = "3";
    private string _episodeNumber = "17";
    private bool _isExplicit = false;
    private bool _isDragOver = false;
}
