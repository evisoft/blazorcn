@* ============================================================
   Block: file-upload-dropzone
   Title: FileUploadDropzone
   Description: Drag-and-drop file upload dropzone block for React and Next.js with file list, remove buttons, and size display using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-dropzone.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Upload files</span>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Drag and drop files or click to browse
            </p>
        </div>

        @* Dropzone *@
        <div class="border-b px-4 py-4">
            <div
                role="button"
                tabindex="0"
                @ondrop="HandleDrop"
                @ondragover="HandleDragOver"
                @ondragleave="HandleDragLeave"
                @ondragover:preventDefault="true"
                @onclick="TriggerFileBrowse"
                class="@Cn.Merge("flex cursor-pointer flex-col items-center justify-center gap-2 rounded-md border-2 border-dashed px-6 py-10 transition-colors", _isDragging ? "border-foreground/30 bg-muted/50" : "border-muted-foreground/20 hover:border-muted-foreground/40 hover:bg-muted/30")"
            >
                <LucideIconCn Name="cloud-upload" Size="32" Class="size-8 text-muted-foreground/60" />
                <div class="text-center">
                    <span class="font-medium text-sm">Drop files here</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        or click to browse from your device
                    </p>
                </div>
                <input type="file" multiple class="hidden" />
            </div>
        </div>

        @* File list *@
        @if (_files.Count > 0)
        {
            <div>
                <div class="border-b px-4 py-2">
                    <span class="text-muted-foreground text-xs">
                        @_files.Count @(_files.Count == 1 ? "file" : "files") selected
                    </span>
                </div>
                @for (int i = 0; i < _files.Count; i++)
                {
                    var idx = i;
                    var file = _files[i];
                    var isLast = idx == _files.Count - 1;
                    var capturedId = file.Id;
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                        <LucideIconCn Name="file" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <span class="block truncate font-medium text-sm">@file.Name</span>
                            <span class="text-muted-foreground text-xs">@file.Size</span>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs"
                            Class="shrink-0 text-muted-foreground hover:text-foreground"
                            OnClick="@(() => RemoveFile(capturedId))">
                            <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                        </ButtonCn>
                    </div>
                }
            </div>
        }

        @* Empty state *@
        @if (_files.Count == 0)
        {
            <div class="px-4 py-6 text-center">
                <span class="text-muted-foreground text-xs">No files uploaded yet</span>
            </div>
        }
    </div>
</section>

@code {
    private class UploadedFile
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Size { get; set; } = "";
        public string Type { get; set; } = "";
    }

    private List<UploadedFile> _files = [];
    private bool _isDragging = false;
    private int _dragCounter = 0;

    private void RemoveFile(string id)
    {
        _files.RemoveAll(f => f.Id == id);
    }

    private void HandleDragOver(DragEventArgs e)
    {
        _isDragging = true;
    }

    private void HandleDragLeave(DragEventArgs e)
    {
        _isDragging = false;
    }

    private void HandleDrop(DragEventArgs e)
    {
        _isDragging = false;
        // File reading from DragEventArgs requires JS interop; no-op in this presentational port
    }

    private void TriggerFileBrowse()
    {
        // File input click requires JS interop; no-op in this presentational port
    }
}
