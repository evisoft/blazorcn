@* ============================================================
   Block: file-upload-email-attachment
   Title: FileUploadEmailAttachment
   Description: An email attachment upload block for React and Next.js with paperclip icon, inline attachment chips showing file icon, name, and size, remove button on each chip, total attachment size counter, and 25 MB limit indicator using shadcn/ui Button, Badge, and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-email-attachment.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="paperclip" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Attachments</span>
            @if (_attachments.Count > 0)
            {
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_attachments.Count files
                </BadgeCn>
            }
            <div class="ml-auto">
                <ButtonCn
                    Variant="ButtonVariant.Outline"
                    Size="ButtonSize.Sm"
                    Class="h-7 gap-1.5 text-xs"
                    Disabled="@_isAtLimit">
                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                    Attach
                </ButtonCn>
            </div>
        </div>

        @* Attachment chips *@
        @if (_attachments.Count > 0)
        {
            <div class="border-b px-4 py-3">
                <div class="flex flex-wrap gap-2">
                    @foreach (var att in _attachments)
                    {
                        var attachment = att;
                        <div class="flex items-center gap-1.5 rounded-md bg-muted/50 py-1 pl-2 pr-1">
                            <LucideIconCn Name="@GetFileIconName(attachment.Type)" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                            <span class="max-w-[160px] truncate text-xs">@attachment.Name</span>
                            <span class="shrink-0 text-muted-foreground text-xs">@FormatSize(attachment.Size)</span>
                            <button
                                type="button"
                                @onclick="@(() => RemoveAttachment(attachment.Id))"
                                aria-label="@($"Remove {attachment.Name}")"
                                class="ml-0.5 flex size-5 shrink-0 items-center justify-center rounded text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
                                <LucideIconCn Name="x" Size="12" Class="size-3" />
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="border-b px-4 py-8 text-center">
                <LucideIconCn Name="paperclip" Size="20" Class="mx-auto size-5 text-muted-foreground/40" />
                <p class="mt-1.5 text-muted-foreground text-xs">
                    No attachments. Click Attach to add files.
                </p>
            </div>
        }

        @* Size indicator *@
        <div class="px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-xs">
                    Total: @FormatSize(_totalSize) of @FormatSize(_maxSize)
                </span>
                <span class="@(_isAtLimit ? "text-red-600 dark:text-red-400" : _isNearLimit ? "text-amber-600 dark:text-amber-400" : "text-muted-foreground") text-xs">
                    @(_isAtLimit ? "Limit reached" : $"{FormatSize(_maxSize - _totalSize)} remaining")
                </span>
            </div>
            <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-muted">
                <div
                    class="@("h-full rounded-full transition-all " + (_isAtLimit ? "bg-red-500" : _isNearLimit ? "bg-amber-500" : "bg-foreground/20"))"
                    style="@(FormattableString.Invariant($"width:{_usagePercent}%"))">
                </div>
            </div>
            <p class="mt-1.5 text-muted-foreground text-xs">
                Max 25 MB per email. Individual files up to 10 MB each.
            </p>
        </div>
    </div>
</section>

@code {
    private enum AttachmentType { Image, Pdf, Spreadsheet, Document, Other }

    private record Attachment(string Id, string Name, long Size, AttachmentType Type);

    private static readonly long _maxSize = 25L * 1024 * 1024; // 25 MB

    private List<Attachment> _attachments = new List<Attachment>
    {
        new("1", "Q4-report-final.pdf",  2400000, AttachmentType.Pdf),
        new("2", "team-photo.jpg",        3800000, AttachmentType.Image),
        new("3", "budget-2025.xlsx",       890000, AttachmentType.Spreadsheet),
        new("4", "meeting-notes.docx",     156000, AttachmentType.Document),
        new("5", "logo-dark.svg",           14200, AttachmentType.Image),
    };

    private long _totalSize => _attachments.Sum(a => a.Size);
    private double _usagePercent => Math.Min((_totalSize / (double)_maxSize) * 100.0, 100.0);
    private bool _isNearLimit => _usagePercent > 80;
    private bool _isAtLimit => _usagePercent >= 100;

    private void RemoveAttachment(string id)
    {
        _attachments = _attachments.Where(a => a.Id != id).ToList();
    }

    private static string GetFileIconName(AttachmentType type) => type switch
    {
        AttachmentType.Image => "file-image",
        AttachmentType.Pdf => "file-text",
        AttachmentType.Spreadsheet => "file-spreadsheet",
        AttachmentType.Document => "file-text",
        _ => "file",
    };

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{(bytes / 1024.0):F1} KB";
        return $"{(bytes / (1024.0 * 1024.0)):F1} MB";
    }
}
