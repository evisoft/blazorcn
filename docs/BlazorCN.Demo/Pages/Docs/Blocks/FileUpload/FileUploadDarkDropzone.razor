@* ============================================================
   Block: file-upload-dark-dropzone
   Title: FileUploadDarkDropzone
   Description: A styled dark theme dropzone with dark background upload area, glowing border effect on drag, file list with dark cards, and modern contrast aesthetic using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-dark-dropzone.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Upload files</span>
            <span class="text-muted-foreground text-xs">
                @_files.Count @(_files.Count == 1 ? "file" : "files")
            </span>
        </div>

        @* Dark dropzone *@
        <div class="p-4">
            <div
                @ondrop="HandleDrop"
                @ondragenter="HandleDragEnter"
                @ondragleave="HandleDragLeave"
                @ondragover:preventDefault="true"
                class="@Cn.Merge("flex flex-col items-center justify-center rounded-lg bg-zinc-950 px-6 py-12 transition-all duration-200", _isDragging ? "ring-2 ring-zinc-400 ring-offset-2 ring-offset-card" : "ring-1 ring-zinc-800")"
            >
                <LucideIconCn Name="upload-cloud" Size="40"
                    Class="@Cn.Merge("mb-3 size-10 transition-transform duration-200", _isDragging ? "scale-110 text-zinc-300" : "text-zinc-500")" />
                <span class="font-medium text-sm text-zinc-200">
                    @(_isDragging ? "Drop files here" : "Drag files into this area")
                </span>
                <span class="mt-1 text-xs text-zinc-500">or click to browse from your device</span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                    Class="mt-4 h-7 border-zinc-700 bg-zinc-900 text-xs text-zinc-300 hover:bg-zinc-800 hover:text-zinc-200"
                    OnClick="TriggerFileBrowse">
                    Browse files
                </ButtonCn>
                <input type="file" multiple class="hidden" />
            </div>
        </div>

        @* File list with dark rows *@
        @if (_files.Count > 0)
        {
            <div class="border-t">
                @for (int i = 0; i < _files.Count; i++)
                {
                    var idx = i;
                    var file = _files[i];
                    var isLast = idx == _files.Count - 1;
                    var capturedId = file.Id;
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                        <div class="flex size-8 items-center justify-center rounded-md bg-zinc-950">
                            @TypeIcon(file.FileType)
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="block truncate font-medium text-sm">@file.Name</span>
                            <span class="text-muted-foreground text-xs">@file.Size</span>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                            Class="h-6 gap-1 px-2 text-muted-foreground text-xs hover:text-foreground"
                            aria-label="@($"Remove {file.Name}")"
                            OnClick="@(() => RemoveFile(capturedId))">
                            <LucideIconCn Name="trash" Size="12" Class="size-3" />
                        </ButtonCn>
                    </div>
                }
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                Supported: PNG, JPG, PDF, CSV, ZIP. Max 50 MB per file.
            </span>
        </div>
    </div>
</section>

@code {
    private enum UploadFileType { Image, Document, Other }

    private class UploadedFile
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Size { get; set; } = "";
        public UploadFileType FileType { get; set; }
    }

    private List<UploadedFile> _files =
    [
        new UploadedFile { Id = "1", Name = "hero-banner.png",        Size = "3.2 MB", FileType = UploadFileType.Image    },
        new UploadedFile { Id = "2", Name = "api-documentation.pdf",  Size = "1.7 MB", FileType = UploadFileType.Document },
        new UploadedFile { Id = "3", Name = "user-data-export.csv",   Size = "420 KB", FileType = UploadFileType.Other    },
    ];

    private bool _isDragging = false;
    private int _dragCounter = 0;

    private RenderFragment TypeIcon(UploadFileType fileType) => fileType switch
    {
        UploadFileType.Image    => @<LucideIconCn Name="image" Size="14" Class="size-3.5 text-zinc-400" />,
        UploadFileType.Document => @<LucideIconCn Name="file-text" Size="14" Class="size-3.5 text-zinc-400" />,
        _                       => @<LucideIconCn Name="file" Size="14" Class="size-3.5 text-zinc-400" />,
    };

    private void RemoveFile(string id)
    {
        _files.RemoveAll(f => f.Id == id);
    }

    private void HandleDrop(DragEventArgs e)
    {
        _dragCounter = 0;
        _isDragging = false;
    }

    private void HandleDragEnter(DragEventArgs e)
    {
        _dragCounter += 1;
        if (_dragCounter == 1) _isDragging = true;
    }

    private void HandleDragLeave(DragEventArgs e)
    {
        _dragCounter -= 1;
        if (_dragCounter == 0) _isDragging = false;
    }

    private void TriggerFileBrowse()
    {
        // File input click would require JS interop; no-op in this presentational port
    }
}
