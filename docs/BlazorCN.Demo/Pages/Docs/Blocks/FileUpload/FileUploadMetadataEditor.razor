@* ============================================================
   Block: file-upload-metadata-editor
   Title: FileUploadMetadataEditor
   Description: File upload with metadata editing block for React and Next.js with EXIF field display, editable title, description, author, keywords, copyright, and strip metadata option using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-metadata-editor.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Metadata editor</span>
                <p class="mt-0.5 text-muted-foreground text-xs">View and edit file metadata</p>
            </div>
            <div class="flex items-center gap-1.5">
                <ButtonCn
                    Variant="ButtonVariant.Ghost"
                    Size="ButtonSize.Sm"
                    Class="h-7 gap-1 text-xs"
                    OnClick="StripMetadata"
                    Disabled="@_stripped">
                    <LucideIconCn Name="shield" Size="12" Class="size-3" />
                    Strip metadata
                </ButtonCn>
                <ButtonCn
                    Variant="ButtonVariant.Outline"
                    Size="ButtonSize.Sm"
                    Class="h-7 gap-1 text-xs"
                    OnClick="HandleSave">
                    @if (_saved)
                    {
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                        <span>Saved</span>
                    }
                    else
                    {
                        <span>Save</span>
                    }
                </ButtonCn>
            </div>
        </div>

        @* File info *@
        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <LucideIconCn Name="file-image" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
            <div class="min-w-0 flex-1">
                <span class="truncate font-medium text-sm">mountain-sunrise-panorama.jpg</span>
            </div>
            <span class="text-muted-foreground text-xs">14.2 MB</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                JPEG
            </BadgeCn>
        </div>

        @* Stripped notice *@
        @if (_stripped)
        {
            <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-2">
                <LucideIconCn Name="shield" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">
                    Editable metadata fields have been cleared
                </span>
            </div>
        }

        @* Metadata fields *@
        <div>
            @for (int i = 0; i < _metadata.Count; i++)
            {
                var field = _metadata[i];
                var isLast = i == _metadata.Count - 1;
                var isEditing = _editingKey == field.Key;
                <div class="@Cn.Merge("flex items-start gap-4 px-4 py-2.5", isLast ? "" : "border-b")">
                    <span class="w-24 shrink-0 pt-0.5 text-muted-foreground text-xs font-medium">
                        @field.Label
                    </span>
                    <div class="min-w-0 flex-1">
                        @if (isEditing)
                        {
                            <div class="flex items-center gap-1.5">
                                <InputCn
                                    @bind-Value="_editValue"
                                    Class="h-7 text-xs"
                                    autofocus="autofocus"
                                    @onkeydown="@((KeyboardEventArgs e) => HandleKeyDown(e, field.Key))" />
                                <ButtonCn
                                    Variant="ButtonVariant.Ghost"
                                    Size="ButtonSize.IconXs"
                                    Class="shrink-0"
                                    OnClick="@(() => SaveEdit(field.Key))">
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                </ButtonCn>
                                <ButtonCn
                                    Variant="ButtonVariant.Ghost"
                                    Size="ButtonSize.IconXs"
                                    Class="shrink-0"
                                    OnClick="CancelEdit">
                                    <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                                </ButtonCn>
                            </div>
                        }
                        else
                        {
                            <div class="flex items-start gap-2">
                                <span class="@Cn.Merge("text-sm", string.IsNullOrEmpty(field.Value) ? "text-muted-foreground italic" : "")">
                                    @(string.IsNullOrEmpty(field.Value) ? "Empty" : field.Value)
                                </span>
                                @if (field.Editable)
                                {
                                    var capturedField = field;
                                    <ButtonCn
                                        Variant="ButtonVariant.Ghost"
                                        Size="ButtonSize.IconXs"
                                        Class="mt-0.5 shrink-0 text-muted-foreground hover:text-foreground"
                                        OnClick="@(() => StartEdit(capturedField))">
                                        <LucideIconCn Name="pencil" Size="12" Class="size-3" />
                                    </ButtonCn>
                                }
                            </div>
                        }
                    </div>
                    @if (!field.Editable)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-[10px] font-normal">
                            Read-only
                        </BadgeCn>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record MetadataField(string Key, string Label, string Value, bool Editable)
    {
        public string Value { get; set; } = Value;
    }

    private List<MetadataField> _metadata =
    [
        new("title",       "Title",       "Mountain Sunrise Panorama",                                                   true),
        new("description", "Description", "Panoramic view of sunrise over the Rocky Mountains taken from Trail Ridge Road", true),
        new("author",      "Author",      "Sarah Chen",                                                                  true),
        new("keywords",    "Keywords",    "landscape, mountains, sunrise, panorama, nature",                              true),
        new("copyright",   "Copyright",   "2026 Sarah Chen. All rights reserved.",                                        true),
        new("camera",      "Camera",      "Canon EOS R5",                                                                false),
        new("lens",        "Lens",        "RF 24-70mm f/2.8L IS USM",                                                   false),
        new("exposure",    "Exposure",    "1/250s f/8 ISO 200",                                                          false),
        new("dimensions",  "Dimensions",  "8192 x 5464 px",                                                              false),
        new("colorSpace",  "Color space", "sRGB",                                                                        false),
    ];

    private string? _editingKey = null;
    private string _editValue = "";
    private bool _stripped = false;
    private bool _saved = false;

    private void StartEdit(MetadataField field)
    {
        _editingKey = field.Key;
        _editValue = field.Value;
    }

    private void CancelEdit()
    {
        _editingKey = null;
        _editValue = "";
    }

    private void SaveEdit(string key)
    {
        var field = _metadata.FirstOrDefault(f => f.Key == key);
        if (field != null)
        {
            field.Value = _editValue;
        }
        _editingKey = null;
        _editValue = "";
    }

    private void StripMetadata()
    {
        foreach (var f in _metadata)
        {
            if (f.Editable) f.Value = "";
        }
        _stripped = true;
    }

    private async Task HandleSave()
    {
        _saved = true;
        StateHasChanged();
        await Task.Delay(2000);
        _saved = false;
    }

    private void HandleKeyDown(KeyboardEventArgs e, string key)
    {
        if (e.Key == "Enter") SaveEdit(key);
        else if (e.Key == "Escape") CancelEdit();
    }
}
