@* ============================================================
   Block: file-upload-video
   Title: FileUploadVideo
   Description: A video file upload component with thumbnail preview, duration display, file size, format badge, max duration notice, and processing status indicator built with React, shadcn/ui, and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-video.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Upload videos</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    MP4, MOV, AVI up to 500 MB. Max duration @_maxDuration.
                </p>
            </div>
            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                <span>@_totalSize</span>
                <span>·</span>
                <span>@_completeCount processed</span>
            </div>
        </div>

        @* Drop zone *@
        <div class="border-b px-4 py-4">
            <div
                @ondragover:preventDefault
                @ondragover="@(() => _isDragOver = true)"
                @ondragleave="@(() => _isDragOver = false)"
                @ondrop:preventDefault
                @ondrop="@(() => _isDragOver = false)"
                class="@Cn.Merge("flex flex-col items-center justify-center gap-2 rounded-md border border-dashed px-4 py-8 transition-colors", _isDragOver ? "border-foreground/30 bg-muted/50" : "border-muted-foreground/25")">
                <LucideIconCn Name="upload-cloud" Size="20" Class="size-5 text-muted-foreground/60" />
                <div class="text-center">
                    <p class="font-medium text-sm">Drop video files here</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        or click to browse from your device
                    </p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-1 h-7 text-xs">
                    Choose files
                </ButtonCn>
            </div>
        </div>

        @* File list *@
        <div>
            @for (int i = 0; i < _files.Count; i++)
            {
                var file = _files[i];
                var isLast = i == _files.Count - 1;
                var fileId = file.Id;

                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    @* Thumbnail placeholder *@
                    <div class="flex size-12 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        @if (file.Status == "complete")
                        {
                            <LucideIconCn Name="play" Size="16" Class="size-4 text-muted-foreground" />
                        }
                        else
                        {
                            <LucideIconCn Name="film" Size="16" Class="size-4 text-muted-foreground/60" />
                        }
                    </div>

                    @* File info *@
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="truncate font-medium text-sm">@file.Name</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-mono text-[10px]">
                                @file.Format
                            </BadgeCn>
                        </div>
                        <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                            <span>@file.Duration</span>
                            <span>·</span>
                            <span>@file.Size</span>
                            <span>·</span>
                            <span class="flex items-center gap-1.5">
                                @if (file.Status == "processing")
                                {
                                    <LucideIconCn Name="loader-2" Size="12" Class="size-3 animate-spin" />
                                }
                                else
                                {
                                    <span class="@Cn.Merge("size-1.5 rounded-full", StatusDot(file.Status))"></span>
                                }
                                <span class="@StatusClass(file.Status)">@StatusLabel(file.Status)</span>
                            </span>
                        </div>
                    </div>

                    @* Actions *@
                    <div class="flex items-center gap-1">
                        @if (file.Status == "complete")
                        {
                            <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-500" />
                        }
                        <ButtonCn aria-label="@($"Remove {file.Name}")"
                            Variant="ButtonVariant.Ghost"
                            Size="ButtonSize.Sm"
                            Class="size-7 p-0 text-muted-foreground hover:text-foreground"
                            OnClick="@(() => RemoveFile(fileId))">
                            @if (file.Status == "queued")
                            {
                                <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                            }
                            else
                            {
                                <LucideIconCn Name="trash" Size="14" Class="size-3.5" />
                            }
                        </ButtonCn>
                    </div>
                </div>
            }

            @if (_files.Count == 0)
            {
                <div class="flex flex-col items-center justify-center px-4 py-8 text-center">
                    <LucideIconCn Name="film" Size="20" Class="size-5 text-muted-foreground/40" />
                    <p class="mt-2 text-muted-foreground text-xs">No videos uploaded yet</p>
                </div>
            }
        </div>

        @* Footer *@
        @if (_files.Count > 0)
        {
            <div class="flex items-center justify-between border-t px-4 py-3">
                <p class="text-muted-foreground text-xs">
                    Videos exceeding @_maxDuration will be rejected
                </p>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Upload all
                </ButtonCn>
            </div>
        }
    </div>
</section>

@code {
    private record VideoFile(string Id, string Name, string Size, string Format, string Duration, string Status);

    private static readonly VideoFile[] _seed =
    [
        new("1", "product-demo-final.mp4",   "142.3 MB", "MP4", "3:24", "complete"),
        new("2", "onboarding-tutorial.mov",  "287.6 MB", "MOV", "7:51", "processing"),
        new("3", "testimonial-clip.avi",     "56.8 MB",  "AVI", "1:12", "queued"),
    ];

    private const string _maxDuration = "10 min";

    private List<VideoFile> _files = [.. _seed];
    private bool _isDragOver = false;

    private string _totalSize => _files.Count > 0
        ? $"{_files.Count} video{(_files.Count != 1 ? "s" : "")}"
        : "No videos";

    private int _completeCount => _files.Count(f => f.Status == "complete");

    private void RemoveFile(string id)
    {
        _files = _files.Where(f => f.Id != id).ToList();
    }

    private static string StatusLabel(string status) => status switch
    {
        "queued"     => "Queued",
        "processing" => "Processing",
        "complete"   => "Complete",
        "error"      => "Failed",
        _            => status,
    };

    private static string StatusClass(string status) => status switch
    {
        "queued"     => "text-muted-foreground",
        "processing" => "text-amber-600 dark:text-amber-400",
        "complete"   => "text-emerald-600 dark:text-emerald-400",
        "error"      => "text-red-600 dark:text-red-400",
        _            => "",
    };

    private static string StatusDot(string status) => status switch
    {
        "queued"     => "bg-muted-foreground",
        "processing" => "bg-amber-500",
        "complete"   => "bg-emerald-500",
        "error"      => "bg-red-500",
        _            => "",
    };
}
