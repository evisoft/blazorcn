@* ============================================================
   Block: file-upload-bulk
   Title: FileUploadBulk
   Description: A bulk file upload block with batch progress tracking, individual file status indicators, overall progress bar, and Upload All and Cancel All controls using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-bulk.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Bulk upload</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_totalCount files
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_completedCount
                </span>
                @if (_errorCount > 0)
                {
                    <span class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        @_errorCount
                    </span>
                }
            </div>
        </div>

        @* Overall progress *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Overall progress</span>
                <span class="tabular-nums text-muted-foreground text-xs">@_overallProgress%</span>
            </div>
            <ProgressCn Value="@_overallProgress" Class="h-1.5" aria-label="Progress" />
            <div class="mt-2 text-muted-foreground text-xs">
                @_completedCount of @_totalCount files uploaded@(_errorCount > 0 ? $" · {_errorCount} failed" : "")
            </div>
        </div>

        @* File list *@
        <div>
            @for (int i = 0; i < _files.Count; i++)
            {
                var idx = i;
                var file = _files[i];
                var isLast = idx == _files.Count - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", !isLast ? "border-b" : "")">
                    @StatusIcon(file.Status)
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="@Cn.Merge("truncate text-sm", file.Status == FileStatus.Error ? "text-red-600 dark:text-red-400" : "font-medium")">
                                @file.Name
                            </span>
                            <span class="shrink-0 text-muted-foreground text-xs">@file.Size</span>
                        </div>
                        @if (file.Status == FileStatus.Uploading)
                        {
                            <div class="mt-1.5">
                                <ProgressCn Value="@file.Progress" Class="h-1" aria-label="Progress" />
                            </div>
                        }
                        @if (file.Status == FileStatus.Error && file.Error is not null)
                        {
                            <span class="mt-0.5 block text-muted-foreground text-xs">@file.Error</span>
                        }
                    </div>
                    @if (file.Status == FileStatus.Uploading)
                    {
                        <span class="shrink-0 tabular-nums text-muted-foreground text-xs">
                            @file.Progress%
                        </span>
                    }
                    @if (file.Status == FileStatus.Pending || file.Status == FileStatus.Error)
                    {
                        var capturedId = file.Id;
                        <button
                            type="button"
                            @onclick="@(() => RemoveFile(capturedId))"
                            aria-label="@($"Remove {file.Name}")"
                            class="shrink-0 text-muted-foreground/60 transition-colors hover:text-foreground">
                            <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                        </button>
                    }
                </div>
            }
        </div>

        @* Actions *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="AddFiles">
                <LucideIconCn Name="upload-cloud" Size="14" Class="mr-1 size-3.5" />
                Add files
            </ButtonCn>
            <div class="flex items-center gap-2">
                @if (_isUploading)
                {
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="HandleCancelAll">
                        Cancel all
                    </ButtonCn>
                }
                else
                {
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="HandleUploadAll">
                        Upload all
                    </ButtonCn>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private enum FileStatus { Pending, Uploading, Complete, Error }

    private class BatchFile
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Size { get; set; } = "";
        public FileStatus Status { get; set; }
        public int Progress { get; set; }
        public string? Error { get; set; }
    }

    private List<BatchFile> _files =
    [
        new BatchFile { Id = "f1", Name = "quarterly-report.pdf",  Size = "2.4 MB",  Status = FileStatus.Complete,  Progress = 100 },
        new BatchFile { Id = "f2", Name = "team-photo.jpg",         Size = "4.1 MB",  Status = FileStatus.Complete,  Progress = 100 },
        new BatchFile { Id = "f3", Name = "design-assets.zip",      Size = "18.7 MB", Status = FileStatus.Uploading, Progress = 64  },
        new BatchFile { Id = "f4", Name = "meeting-notes.docx",     Size = "156 KB",  Status = FileStatus.Pending,   Progress = 0   },
        new BatchFile { Id = "f5", Name = "budget-2026.xlsx",       Size = "890 KB",  Status = FileStatus.Pending,   Progress = 0   },
        new BatchFile { Id = "f6", Name = "corrupted-file.dat",     Size = "3.2 MB",  Status = FileStatus.Error,     Progress = 34, Error = "Upload failed: connection timeout" },
    ];

    private bool _isUploading = true;

    private int _completedCount => _files.Count(f => f.Status == FileStatus.Complete);
    private int _errorCount => _files.Count(f => f.Status == FileStatus.Error);
    private int _totalCount => _files.Count;
    private int _overallProgress => _totalCount > 0
        ? (int)Math.Round(_files.Sum(f => (double)f.Progress) / _totalCount)
        : 0;

    private RenderFragment StatusIcon(FileStatus status) => status switch
    {
        FileStatus.Complete  => @<LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-600 dark:text-emerald-400" />,
        FileStatus.Uploading => @<LucideIconCn Name="loader" Size="16" Class="size-4 animate-spin text-muted-foreground" />,
        FileStatus.Error     => @<LucideIconCn Name="alert-circle" Size="16" Class="size-4 text-red-500" />,
        _                    => @<LucideIconCn Name="file" Size="16" Class="size-4 text-muted-foreground" />,
    };

    private void HandleUploadAll()
    {
        _isUploading = true;
        foreach (var f in _files)
        {
            if (f.Status == FileStatus.Pending || f.Status == FileStatus.Error)
            {
                f.Status = FileStatus.Uploading;
                f.Progress = 0;
                f.Error = null;
            }
        }
    }

    private void HandleCancelAll()
    {
        _isUploading = false;
        foreach (var f in _files)
        {
            if (f.Status == FileStatus.Uploading || f.Status == FileStatus.Pending)
            {
                f.Status = FileStatus.Pending;
                f.Progress = 0;
            }
        }
    }

    private void RemoveFile(string id)
    {
        _files.RemoveAll(f => f.Id == id);
    }

    private void AddFiles()
    {
        _files.Add(new BatchFile
        {
            Id = $"f{_files.Count + 1}",
            Name = "new-document.pdf",
            Size = "1.8 MB",
            Status = FileStatus.Pending,
            Progress = 0,
        });
    }
}
