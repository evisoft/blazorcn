@* ============================================================
   Block: file-upload-resize-image
   Title: FileUploadResizeImage
   Description: Image resize upload block for React and Next.js with dimension inputs, aspect ratio lock, preset sizes, and download button using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-resize-image.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Image Resize</span>
            </div>
            @if (_uploaded)
            {
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" OnClick="Reset">
                    Reset
                </ButtonCn>
            }
        </div>

        @* Upload area *@
        @if (!_uploaded)
        {
            <div class="border-b px-4 py-4">
                <div
                    role="button"
                    tabindex="0"
                    @onclick="SimulateUpload"
                    class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-md border-2 border-dashed border-muted-foreground/20 px-6 py-10 transition-colors hover:border-muted-foreground/40 hover:bg-muted/30">
                    <LucideIconCn Name="cloud-upload" Size="32" Class="size-8 text-muted-foreground/60" />
                    <span class="font-medium text-sm">Upload image to resize</span>
                    <p class="text-muted-foreground text-xs">PNG, JPG, WebP, or GIF up to 50 MB</p>
                </div>
            </div>
        }

        @* File info + original dimensions *@
        @if (_uploaded)
        {
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <LucideIconCn Name="image" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                <div class="min-w-0 flex-1">
                    <span class="block truncate font-medium text-sm">@_fileName</span>
                    <span class="text-muted-foreground text-xs">@_fileSize</span>
                </div>
                <span class="font-mono tabular-nums text-muted-foreground text-xs">
                    @_originalWidth x @_originalHeight
                </span>
            </div>
        }

        @* Dimension inputs *@
        @if (_uploaded)
        {
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-3">
                    <div class="flex-1">
                        <span class="mb-1.5 block text-muted-foreground text-xs">Width</span>
                        <InputCn
                            Type="number"
                            Value="@_targetWidth.ToString()"
                            ValueChanged="@((string v) => UpdateWidth(int.TryParse(v, out var n) ? n : 0))"
                            Class="h-8 font-mono tabular-nums text-sm" />
                    </div>

                    <div class="flex flex-col items-center gap-1 pt-5">
                        @if (_lockRatio)
                        {
                            <LucideIconCn Name="link" Size="14" Class="size-3.5 text-muted-foreground" />
                        }
                        else
                        {
                            <LucideIconCn Name="unlink" Size="14" Class="size-3.5 text-muted-foreground" />
                        }
                        <SwitchCn Checked="@_lockRatio" CheckedChanged="@((bool v) => _lockRatio = v)" Class="scale-75" />
                    </div>

                    <div class="flex-1">
                        <span class="mb-1.5 block text-muted-foreground text-xs">Height</span>
                        <InputCn
                            Type="number"
                            Value="@_targetHeight.ToString()"
                            ValueChanged="@((string v) => UpdateHeight(int.TryParse(v, out var n) ? n : 0))"
                            Class="h-8 font-mono tabular-nums text-sm" />
                    </div>
                </div>

                <div class="mt-2 flex items-center justify-between">
                    <span class="text-muted-foreground text-xs">
                        @(_lockRatio ? "Aspect ratio locked" : "Free resize")
                    </span>
                    @if (ReductionPercent > 0)
                    {
                        <span class="tabular-nums text-muted-foreground text-xs">
                            @(ReductionPercent)% smaller
                        </span>
                    }
                    @if (ReductionPercent < 0)
                    {
                        <span class="tabular-nums text-muted-foreground text-xs">
                            @(Math.Abs(ReductionPercent))% larger
                        </span>
                    }
                </div>
            </div>
        }

        @* Presets *@
        @if (_uploaded)
        {
            <div class="border-b px-4 py-3">
                <span class="mb-2 block text-muted-foreground text-xs">Presets</span>
                <div class="flex flex-wrap gap-1.5">
                    @foreach (var preset in _presets)
                    {
                        var p = preset;
                        <button
                            type="button"
                            @onclick="@(() => ApplyPreset(p))"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs transition-colors", _activePreset == p.Label ? "bg-foreground text-background" : "bg-muted/50 text-muted-foreground hover:bg-muted")">
                            @p.Label
                            <span class="ml-1 font-mono tabular-nums opacity-60">@(p.Width)x@(p.Height)</span>
                        </button>
                    }
                </div>
            </div>
        }

        @* Download section *@
        <div class="px-4 py-3">
            @if (!_uploaded)
            {
                <span class="text-muted-foreground text-xs">
                    Upload an image to resize with custom dimensions or presets
                </span>
            }
            @if (_uploaded)
            {
                <div class="flex items-center justify-between">
                    <span class="font-mono tabular-nums text-muted-foreground text-xs">
                        @_targetWidth x @_targetHeight px
                    </span>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                        <LucideIconCn Name="download" Size="12" Class="size-3" />
                        Download resized
                    </ButtonCn>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record PresetOption(string Label, int Width, int Height);

    private static readonly PresetOption[] _presets =
    [
        new PresetOption("Thumbnail", 150, 150),
        new PresetOption("Medium", 640, 480),
        new PresetOption("Large", 1280, 960),
        new PresetOption("HD", 1920, 1080),
        new PresetOption("Social", 1200, 630),
    ];

    private bool _uploaded = false;
    private string _fileName = "";
    private string _fileSize = "";
    private int _originalWidth = 0;
    private int _originalHeight = 0;
    private int _targetWidth = 0;
    private int _targetHeight = 0;
    private bool _lockRatio = true;
    private string? _activePreset = null;

    private int ReductionPercent => _originalWidth > 0 && _originalHeight > 0
        ? (int)Math.Round((1.0 - (_targetWidth * (double)_targetHeight) / (_originalWidth * (double)_originalHeight)) * 100)
        : 0;

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{(bytes / 1024.0):F1} KB";
        return $"{(bytes / (1024.0 * 1024.0)):F1} MB";
    }

    private void SimulateUpload()
    {
        _fileName = "photo.jpg";
        _fileSize = FormatSize(4800000);
        _originalWidth = 3840;
        _originalHeight = 2560;
        _targetWidth = 3840;
        _targetHeight = 2560;
        _lockRatio = true;
        _activePreset = null;
        _uploaded = true;
    }

    private void UpdateWidth(int w)
    {
        _activePreset = null;
        if (_lockRatio && _originalWidth > 0)
        {
            var ratio = _originalHeight / (double)_originalWidth;
            _targetWidth = w;
            _targetHeight = (int)Math.Round(w * ratio);
        }
        else
        {
            _targetWidth = w;
        }
    }

    private void UpdateHeight(int h)
    {
        _activePreset = null;
        if (_lockRatio && _originalHeight > 0)
        {
            var ratio = _originalWidth / (double)_originalHeight;
            _targetWidth = (int)Math.Round(h * ratio);
            _targetHeight = h;
        }
        else
        {
            _targetHeight = h;
        }
    }

    private void ApplyPreset(PresetOption preset)
    {
        _activePreset = preset.Label;
        _targetWidth = preset.Width;
        _targetHeight = preset.Height;
    }

    private void Reset()
    {
        _uploaded = false;
        _fileName = "";
        _fileSize = "";
        _originalWidth = 0;
        _originalHeight = 0;
        _targetWidth = 0;
        _targetHeight = 0;
        _lockRatio = true;
        _activePreset = null;
    }
}
