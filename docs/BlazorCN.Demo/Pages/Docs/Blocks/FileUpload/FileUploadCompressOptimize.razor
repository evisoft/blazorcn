@* ============================================================
   Block: file-upload-compress-optimize
   Title: FileUploadCompressOptimize
   Description: React file upload block for Next.js with auto-compression, original vs compressed size comparison, compression ratio percentage, quality slider, and savings summary built with shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-compress-optimize.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="font-medium text-sm">Compress &amp; Optimize</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Upload images for automatic compression
                </p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                <LucideIconCn Name="upload" Size="12" Class="size-3" />
                Upload
            </ButtonCn>
        </div>

        @* Quality slider *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Quality</span>
                <span class="font-mono text-muted-foreground text-xs tabular-nums">@_quality%</span>
            </div>
            <SliderCn Value="@((double)_quality)" Min="10" Max="100" Step="5" ValueChanged="@((double v) => SetQuality((int)v))" />
            <div class="mt-1.5 flex justify-between text-muted-foreground text-xs">
                <span>Smaller file</span>
                <span>Higher quality</span>
            </div>
        </div>

        @* Savings summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="arrow-down" Size="12" Class="size-3 text-emerald-500" />
                <span class="font-semibold text-emerald-600 text-sm tabular-nums dark:text-emerald-400">
                    @TotalRatio%
                </span>
                <span class="text-muted-foreground text-xs">saved</span>
            </div>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">
                @FormatSize(TotalOriginal) → @FormatSize(TotalCompressed)
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">@FormatSize(TotalSaved) freed</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto font-normal text-xs tabular-nums">
                @_files.Count files
            </BadgeCn>
        </div>

        @* File list *@
        <div>
            @for (int i = 0; i < _files.Count; i++)
            {
                var idx = i;
                var file = _files[i];
                var isLast = idx == _files.Count - 1;
                var adjustedSize = GetAdjustedCompressedSize(file);
                var ratio = (int)Math.Round((1.0 - (double)adjustedSize / file.OriginalSize) * 100);
                var compressionProgress = (int)Math.Round((double)adjustedSize / file.OriginalSize * 100);
                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-3">
                        <div class="flex items-center gap-3">
                            <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                                @if (file.Type.StartsWith("image/"))
                                {
                                    <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground" />
                                }
                                else
                                {
                                    <LucideIconCn Name="file" Size="16" Class="size-4 text-muted-foreground" />
                                }
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center justify-between">
                                    <span class="truncate font-medium text-sm">@file.Name</span>
                                    <div class="flex items-center gap-2">
                                        <span class="font-mono text-emerald-600 text-xs tabular-nums dark:text-emerald-400">
                                            -@ratio%
                                        </span>
                                        @{ var capturedId = file.Id; }
                                        <button
                                            type="button"
                                            @onclick="@(() => RemoveFile(capturedId))"
                                            class="text-muted-foreground transition-colors hover:text-foreground">
                                            <LucideIconCn Name="trash" Size="14" Class="size-3.5" />
                                        </button>
                                    </div>
                                </div>
                                <div class="mt-1 flex items-center gap-2">
                                    <span class="text-muted-foreground text-xs line-through tabular-nums">
                                        @FormatSize(file.OriginalSize)
                                    </span>
                                    <span class="text-foreground text-xs tabular-nums">
                                        @FormatSize(adjustedSize)
                                    </span>
                                </div>
                                <div class="mt-2">
                                    <ProgressCn Value="@compressionProgress" Class="h-1" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <p class="text-muted-foreground text-xs">
                    Compression applied at @_quality% quality. Adjust the slider to balance size and
                    fidelity.
                </p>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Download all
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record CompressedFile(
        string Id,
        string Name,
        long OriginalSize,
        long CompressedSize,
        string Type
    );

    private List<CompressedFile> _files =
    [
        new("f1", "hero-banner.png",       4_832_256, 1_256_448, "image/png"),
        new("f2", "product-photo-01.jpg",  2_145_280,   687_104, "image/jpeg"),
        new("f3", "team-group-shot.jpg",   3_567_616, 1_070_284, "image/jpeg"),
        new("f4", "background-pattern.png",1_048_576,   314_572, "image/png"),
        new("f5", "icon-set-export.webp",    524_288,   178_257, "image/webp"),
    ];

    private int _quality = 75;

    private long GetAdjustedCompressedSize(CompressedFile file)
    {
        var baseRatio = (double)file.CompressedSize / file.OriginalSize;
        var qualityFactor = _quality / 75.0;
        var adjustedRatio = Math.Min(baseRatio * qualityFactor, 0.98);
        return (long)Math.Round(file.OriginalSize * adjustedRatio);
    }

    private long TotalOriginal => _files.Sum(f => f.OriginalSize);
    private long TotalCompressed => _files.Sum(f => GetAdjustedCompressedSize(f));
    private long TotalSaved => TotalOriginal - TotalCompressed;
    private int TotalRatio => TotalOriginal > 0
        ? (int)Math.Round((1.0 - (double)TotalCompressed / TotalOriginal) * 100)
        : 0;

    private void SetQuality(int v)
    {
        _quality = v;
    }

    private void RemoveFile(string id)
    {
        _files.RemoveAll(f => f.Id == id);
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{(bytes / 1024.0):F1} KB";
        return $"{(bytes / (1024.0 * 1024.0)):F2} MB";
    }
}
