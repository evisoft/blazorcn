@* ============================================================
   Block: file-upload-id-verification
   Title: FileUploadIdVerification
   Description: An ID document upload block for React and Next.js with front and back image upload, quality checklist for photo clarity, text readability, and expiry validation, verification status tracking with pending, verified, and rejected states, and security notice using shadcn/ui Button, Badge, and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-id-verification.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">ID Verification</span>
            <div class="ml-auto">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    <span class="@Cn.Merge("mr-1", _statusConfig[_status].Color)">&bull;</span>
                    @_statusConfig[_status].Label
                </BadgeCn>
            </div>
        </div>

        @* Document type *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Document type</span>
            <p class="mt-0.5 text-sm">Government-issued photo ID</p>
        </div>

        @* Upload areas *@
        <div class="grid grid-cols-2 border-b">
            @* Front *@
            <div class="border-r px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">@_frontSide.Label</span>
                @if (_frontSide.Uploaded)
                {
                    <div class="mt-2 flex items-center gap-2">
                        <div class="flex size-10 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/60" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="truncate text-xs">@_frontSide.FileName</p>
                            <p class="text-muted-foreground text-xs">@_frontSide.FileSize</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="mt-2 flex flex-col items-center rounded-md border border-dashed p-4">
                        <LucideIconCn Name="upload" Size="16" Class="mb-1 size-4 text-muted-foreground" />
                        <span class="text-muted-foreground text-xs">Upload front</span>
                    </div>
                }
            </div>

            @* Back *@
            <div class="px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">@_backSide.Label</span>
                @if (_backSide.Uploaded)
                {
                    <div class="mt-2 flex items-center gap-2">
                        <div class="flex size-10 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/60" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="truncate text-xs">@_backSide.FileName</p>
                            <p class="text-muted-foreground text-xs">@_backSide.FileSize</p>
                        </div>
                    </div>
                }
                else
                {
                    <button
                        type="button"
                        @onclick="HandleUploadBack"
                        class="mt-2 flex w-full flex-col items-center rounded-md border border-dashed p-4 transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="upload" Size="16" Class="mb-1 size-4 text-muted-foreground" />
                        <span class="text-muted-foreground text-xs">Upload back</span>
                    </button>
                }
            </div>
        </div>

        @* Quality checklist *@
        <div class="border-b">
            <div class="flex items-center justify-between px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Quality checks</span>
                <span class="font-mono text-muted-foreground text-xs tabular-nums">
                    @_checks.Count(c => c.Status == "pass")/@_checks.Length passed
                </span>
            </div>
            @for (int i = 0; i < _checks.Length; i++)
            {
                var chk = _checks[i];
                var isLast = i == _checks.Length - 1;
                <div class="@Cn.Merge("flex items-start gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <div class="mt-0.5 shrink-0">
                        @if (chk.Status == "pass")
                        {
                            <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-600 dark:text-emerald-400" />
                        }
                        else if (chk.Status == "fail")
                        {
                            <LucideIconCn Name="x-circle" Size="16" Class="size-4 text-red-600 dark:text-red-400" />
                        }
                        else
                        {
                            <LucideIconCn Name="circle" Size="16" Class="size-4 text-muted-foreground/40" />
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="text-sm">@chk.Label</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@chk.Description</p>
                    </div>
                </div>
            }
        </div>

        @* Security notice *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-2 rounded-md bg-muted/50 p-3">
                <LucideIconCn Name="lock" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                <div>
                    <span class="font-medium text-xs">Secure processing</span>
                    <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">
                        Your documents are encrypted in transit and at rest. Images are processed in an
                        isolated environment and automatically deleted within 24 hours of verification.
                    </p>
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            @if (_status == "pending")
            {
                <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="alert-triangle" Size="14" Class="size-3.5" />
                    Both sides required for verification
                </div>
                <ButtonCn
                    Variant="ButtonVariant.Outline"
                    Size="ButtonSize.Sm"
                    Class="h-7 gap-1 text-xs"
                    OnClick="HandleVerify"
                    Disabled="@(!_frontSide.Uploaded || !_backSide.Uploaded)">
                    <LucideIconCn Name="shield" Size="12" Class="size-3" />
                    Verify identity
                </ButtonCn>
            }
            @if (_status == "verified")
            {
                <div class="flex items-center gap-1.5 text-xs">
                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                    <span class="text-muted-foreground">Identity verified successfully</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record IdSide(string Label, bool Uploaded, string FileName, string FileSize);
    private record QualityCheck(string Id, string Label, string Description, string Status);
    private record StatusCfg(string Label, string Color);

    private IdSide _frontSide = new("Front of ID", true, "id-front-scan.jpg", "1.8 MB");
    private IdSide _backSide = new("Back of ID", false, "", "");
    private string _status = "pending";

    private QualityCheck[] _checks =
    [
        new("1", "Photo clarity",          "Image is sharp with no blur or glare detected",             "pass"),
        new("2", "Text readability",       "All text fields are legible and machine-readable",           "pass"),
        new("3", "Not expired",            "Document expiration date is after the current date",         "pass"),
        new("4", "Document authenticity",  "Security features and hologram patterns detected",           "pending"),
    ];

    private static readonly Dictionary<string, StatusCfg> _statusConfig = new()
    {
        ["pending"]  = new StatusCfg("Pending review", "text-amber-600 dark:text-amber-400"),
        ["verified"] = new StatusCfg("Verified",       "text-emerald-600 dark:text-emerald-400"),
        ["rejected"] = new StatusCfg("Rejected",       "text-red-600 dark:text-red-400"),
    };

    private void HandleUploadBack()
    {
        _backSide = new IdSide("Back of ID", true, "id-back-scan.jpg", "1.6 MB");
    }

    private void HandleVerify()
    {
        _checks = [.. _checks.Select(c => c.Id == "4" ? c with { Status = "pass" } : c)];
        _status = "verified";
    }
}
