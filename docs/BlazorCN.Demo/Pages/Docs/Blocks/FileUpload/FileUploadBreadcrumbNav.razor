@* ============================================================
   Block: file-upload-breadcrumb-nav
   Title: FileUploadBreadcrumbNav
   Description: A React file browser block with breadcrumb path navigation, folder drill-down, back button, upload to current folder, create new folder, and folder contents list using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-breadcrumb-nav.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with actions *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">File browser</span>
            <div class="flex items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs"
                    @onclick="@(() => { _creatingFolder = true; _newFolderName = ""; })">
                    <LucideIconCn Name="folder-plus" Size="14" Class="size-3.5" />
                    New folder
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                    <LucideIconCn Name="upload" Size="14" Class="size-3.5" />
                    Upload
                </ButtonCn>
            </div>
        </div>

        @* Breadcrumb navigation *@
        <div class="flex items-center gap-1 overflow-x-auto border-b px-4 py-2.5">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 shrink-0 p-0"
                @onclick="NavigateBack"
                Disabled="@(_pathStack.Count <= 1)">
                <LucideIconCn Name="arrow-left" Size="14" Class="size-3.5" />
            </ButtonCn>
            <div class="flex items-center gap-0.5">
                @for (var i = 0; i < _breadcrumbs.Count; i++)
                {
                    var idx = i;
                    var crumb = _breadcrumbs[idx];
                    var isLast = idx == _breadcrumbs.Count - 1;
                    <div class="flex items-center gap-0.5">
                        @if (idx > 0)
                        {
                            <LucideIconCn Name="chevron-right" Size="12" Class="size-3 shrink-0 text-muted-foreground/60" />
                        }
                        <button
                            type="button"
                            @onclick="@(() => NavigateToBreadcrumb(idx))"
                            class="@Cn.Merge("shrink-0 rounded px-1.5 py-0.5 text-xs transition-colors hover:bg-muted/50", isLast ? "font-medium text-foreground" : "text-muted-foreground")">
                            @crumb
                        </button>
                    </div>
                }
            </div>
        </div>

        @* New folder input *@
        @if (_creatingFolder)
        {
            <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-2.5">
                <LucideIconCn Name="folder" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                <InputCn
                    @bind-Value="_newFolderName"
                    Placeholder="Folder name"
                    Class="h-7 flex-1 border-0 bg-transparent px-0 text-sm shadow-none focus-visible:ring-0"
                    @onkeydown="@HandleFolderInputKeyDown"
                    autofocus="autofocus" />
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs"
                    @onclick="HandleCreateFolder">
                    Create
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 p-0"
                    @onclick="@(() => _creatingFolder = false)">
                    <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                </ButtonCn>
            </div>
        }

        @* Folder contents *@
        <div>
            @{
                var currentItems = _folderData.TryGetValue(_currentPath, out var ci) ? ci : System.Array.Empty<FolderItem>();
                var folders = currentItems.Where(i => i.Type == "folder").ToArray();
                var fileItems = currentItems.Where(i => i.Type != "folder").ToArray();
            }

            @* Folders section *@
            @if (folders.Length > 0)
            {
                <div class="px-4 py-2">
                    <span class="font-medium text-muted-foreground text-xs">Folders</span>
                </div>
                @for (var i = 0; i < folders.Length; i++)
                {
                    var folder = folders[i];
                    var folderIdx = i;
                    var showBorder = folderIdx < folders.Length - 1 || fileItems.Length > 0;
                    <button
                        type="button"
                        @onclick="@(() => NavigateToFolder(folder.Name))"
                        class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50", showBorder ? "border-b" : "")">
                        @GetTypeIcon(folder.Type)
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@folder.Name</span>
                        </div>
                        <span class="text-muted-foreground text-xs">@folder.Size</span>
                        <LucideIconCn Name="chevron-right" Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                    </button>
                }
            }

            @* Files section *@
            @if (fileItems.Length > 0)
            {
                <div class="px-4 py-2">
                    <span class="font-medium text-muted-foreground text-xs">Files</span>
                </div>
                @for (var i = 0; i < fileItems.Length; i++)
                {
                    var file = fileItems[i];
                    var fileIdx = i;
                    var showBorder = fileIdx < fileItems.Length - 1;
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", showBorder ? "border-b" : "")">
                        @GetTypeIcon(file.Type)
                        <div class="min-w-0 flex-1">
                            <span class="truncate font-medium text-sm">@file.Name</span>
                        </div>
                        <span class="text-muted-foreground text-xs tabular-nums">@file.Size</span>
                    </div>
                }
            }

            @* Empty state *@
            @if (!_folderData.ContainsKey(_currentPath) || _folderData[_currentPath].Length == 0)
            {
                <div class="flex flex-col items-center px-4 py-10">
                    <LucideIconCn Name="folder" Size="32" Class="mb-2 size-8 text-muted-foreground/60" />
                    <span class="font-medium text-sm">This folder is empty</span>
                    <span class="mt-1 text-muted-foreground text-xs">Upload files or create a new folder</span>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            @{
                var footerItems = _folderData.TryGetValue(_currentPath, out var fi) ? fi : System.Array.Empty<FolderItem>();
                var fCount = footerItems.Count(i => i.Type == "folder");
                var fFileCount = footerItems.Count(i => i.Type != "folder");
            }
            <span class="text-muted-foreground text-xs">
                @fCount folder@(fCount != 1 ? "s" : ""), @fFileCount file@(fFileCount != 1 ? "s" : "")
            </span>
        </div>
    </div>
</section>

@code {
    private record FolderItem(string Id, string Name, string Type, string Size);

    private static readonly Dictionary<string, FolderItem[]> _folderData = new()
    {
        ["/"] =
        [
            new("d1",  "Documents",           "folder",      "24 files"),
            new("d2",  "Design Assets",       "folder",      "156 files"),
            new("d3",  "Reports",             "folder",      "8 files"),
            new("d4",  "README.pdf",          "pdf",         "120 KB"),
            new("d5",  "Project Overview.docx", "document",  "340 KB"),
        ],
        ["/Documents"] =
        [
            new("d10", "Contracts",               "folder",      "12 files"),
            new("d11", "Templates",               "folder",      "6 files"),
            new("d12", "Meeting Notes Q4.docx",   "document",    "180 KB"),
            new("d13", "Employee Handbook.pdf",   "pdf",         "2.4 MB"),
            new("d14", "Travel Policy.pdf",       "pdf",         "890 KB"),
            new("d15", "Budget Tracker.xlsx",     "spreadsheet", "1.1 MB"),
        ],
        ["/Documents/Contracts"] =
        [
            new("d20", "Vendor Agreement.pdf",        "pdf",      "520 KB"),
            new("d21", "NDA Template.pdf",            "pdf",      "180 KB"),
            new("d22", "Service Level Agreement.pdf", "pdf",      "340 KB"),
            new("d23", "Consulting Contract.docx",    "document", "290 KB"),
        ],
        ["/Documents/Templates"] =
        [
            new("d30", "Invoice Template.xlsx",  "spreadsheet", "45 KB"),
            new("d31", "Proposal Template.docx", "document",    "120 KB"),
            new("d32", "Status Report.docx",     "document",    "80 KB"),
        ],
        ["/Design Assets"] =
        [
            new("d40", "Logos",                   "folder", "18 files"),
            new("d41", "Hero Banner.png",         "image",  "4.2 MB"),
            new("d42", "Product Screenshot.png",  "image",  "3.1 MB"),
            new("d43", "Icon Set.png",            "image",  "890 KB"),
            new("d44", "Brand Guidelines.pdf",    "pdf",    "5.6 MB"),
        ],
        ["/Reports"] =
        [
            new("d50", "Q1 Revenue.xlsx",     "spreadsheet", "1.2 MB"),
            new("d51", "Q2 Revenue.xlsx",     "spreadsheet", "980 KB"),
            new("d52", "Annual Summary.pdf",  "pdf",         "3.4 MB"),
            new("d53", "KPI Dashboard.xlsx",  "spreadsheet", "2.1 MB"),
        ],
    };

    private List<string> _pathStack = ["/"];
    private bool _creatingFolder = false;
    private string _newFolderName = "";

    private string _currentPath => _pathStack[_pathStack.Count - 1];

    private List<string> _breadcrumbs => _pathStack.Select(p =>
    {
        if (p == "/") return "Home";
        var parts = p.Split('/');
        return parts[parts.Length - 1];
    }).ToList();

    private void NavigateToFolder(string folderName)
    {
        var newPath = _currentPath == "/" ? $"/{folderName}" : $"{_currentPath}/{folderName}";
        _pathStack = [.._pathStack, newPath];
        _creatingFolder = false;
    }

    private void NavigateBack()
    {
        if (_pathStack.Count > 1)
        {
            _pathStack = _pathStack.Take(_pathStack.Count - 1).ToList();
            _creatingFolder = false;
        }
    }

    private void NavigateToBreadcrumb(int index)
    {
        _pathStack = _pathStack.Take(index + 1).ToList();
        _creatingFolder = false;
    }

    private void HandleCreateFolder()
    {
        if (!string.IsNullOrWhiteSpace(_newFolderName))
        {
            _newFolderName = "";
            _creatingFolder = false;
        }
    }

    private void HandleFolderInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") HandleCreateFolder();
        if (e.Key == "Escape") _creatingFolder = false;
    }

    private RenderFragment GetTypeIcon(string type) => type switch
    {
        "folder"      => @<LucideIconCn Name="folder"           Size="16" Class="size-4 text-muted-foreground" />,
        "pdf"         => @<LucideIconCn Name="file-text"        Size="16" Class="size-4 text-muted-foreground" />,
        "image"       => @<LucideIconCn Name="image"            Size="16" Class="size-4 text-muted-foreground" />,
        "spreadsheet" => @<LucideIconCn Name="file-spreadsheet" Size="16" Class="size-4 text-muted-foreground" />,
        _             => @<LucideIconCn Name="file"             Size="16" Class="size-4 text-muted-foreground" />,
    };
}
