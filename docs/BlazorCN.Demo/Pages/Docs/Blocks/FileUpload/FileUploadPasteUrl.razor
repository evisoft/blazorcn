@* ============================================================
   Block: file-upload-paste-url
   Title: FileUploadPasteUrl
   Description: A file upload block with tab interface for uploading files or fetching from a URL with file preview, name, size, and type display using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-paste-url.tsx
   ============================================================ *@

@if (_confirmed)
{
    var file = _fetchedFile ?? _selectedFile;
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="flex items-center justify-between border-b px-4 py-3">
                <span class="font-medium text-sm">Upload file</span>
                <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5" />
                    Uploaded
                </span>
            </div>
            <div class="flex flex-col items-center px-4 py-10">
                <LucideIconCn Name="check-circle-2" Size="32" Class="mb-3 size-8 text-emerald-600 dark:text-emerald-400" />
                <span class="font-medium text-sm">@(file?.Name)</span>
                <span class="mt-1 text-muted-foreground text-xs">
                    @(file?.Size) &middot; @(file?.Type)
                </span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-4 h-7 text-xs" OnClick="Reset">
                    Upload another
                </ButtonCn>
            </div>
        </div>
    </section>
}
else
{
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header *@
            <div class="border-b px-4 py-3">
                <span class="font-medium text-sm">Upload file</span>
            </div>

            @* Tabs *@
            <div class="px-4 pt-3">
                <TabsCn DefaultValue="upload">
                    <TabsListCn Class="mb-3 w-full">
                        <TabsTriggerCn Value="upload" Class="flex-1 gap-1.5 text-xs">
                            <LucideIconCn Name="upload-cloud" Size="14" Class="size-3.5" />
                            Upload file
                        </TabsTriggerCn>
                        <TabsTriggerCn Value="url" Class="flex-1 gap-1.5 text-xs">
                            <LucideIconCn Name="link" Size="14" Class="size-3.5" />
                            From URL
                        </TabsTriggerCn>
                    </TabsListCn>

                    @* Upload tab *@
                    <TabsContentCn Value="upload">
                        <div class="pb-4">
                            @if (_selectedFile != null)
                            {
                                <div class="rounded-md border p-3">
                                    <div class="flex items-center gap-3">
                                        <div class="flex size-8 items-center justify-center rounded-md bg-muted/50">
                                            <LucideIconCn Name="file" Size="16" Class="size-4 text-muted-foreground" />
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <span class="block truncate font-medium text-sm">@_selectedFile.Name</span>
                                            <span class="text-muted-foreground text-xs">
                                                @_selectedFile.Size &middot; @_selectedFile.Type
                                            </span>
                                        </div>
                                    </div>
                                    <div class="mt-3 flex items-center justify-end gap-2">
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="ClearSelectedFile">
                                            Remove
                                        </ButtonCn>
                                        <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="HandleConfirm">
                                            Upload
                                        </ButtonCn>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="flex flex-col items-center rounded-md border-2 border-dashed border-muted-foreground/25 px-6 py-8">
                                    <LucideIconCn Name="upload-cloud" Size="32" Class="mb-2 size-8 text-muted-foreground" />
                                    <span class="font-medium text-sm">Drag and drop or browse</span>
                                    <span class="mt-1 text-muted-foreground text-xs">
                                        PNG, JPG, PDF, ZIP up to 50 MB
                                    </span>
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-3 h-7 text-xs" OnClick="TriggerFileBrowse">
                                        Browse files
                                    </ButtonCn>
                                    <input type="file" class="hidden" />
                                </div>
                            }
                        </div>
                    </TabsContentCn>

                    @* URL tab *@
                    <TabsContentCn Value="url">
                        <div class="pb-4">
                            <div class="flex items-center gap-2">
                                <div class="relative flex-1">
                                    <LucideIconCn Name="globe" Size="14" Class="absolute top-1/2 left-2.5 size-3.5 -translate-y-1/2 text-muted-foreground" />
                                    <InputCn @bind-Value="_url" Placeholder="@("https://example.com/file.pdf")" Class="h-8 pl-8 text-xs" />
                                </div>
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 shrink-0 text-xs"
                                    Disabled="@(!_isValidUrl || _fetchStatus == FetchStatus.Fetching)"
                                    OnClick="HandleFetch">
                                    @if (_fetchStatus == FetchStatus.Fetching)
                                    {
                                        <LucideIconCn Name="loader" Size="12" Class="mr-1 size-3 animate-spin" />
                                        <span>Fetching</span>
                                    }
                                    else
                                    {
                                        <span>Fetch</span>
                                    }
                                </ButtonCn>
                            </div>

                            @if (_fetchStatus == FetchStatus.Fetched && _fetchedFile != null)
                            {
                                <div class="mt-3 rounded-md border p-3">
                                    <div class="flex items-center gap-3">
                                        <div class="flex size-8 items-center justify-center rounded-md bg-muted/50">
                                            <LucideIconCn Name="file" Size="16" Class="size-4 text-muted-foreground" />
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <span class="block truncate font-medium text-sm">@_fetchedFile.Name</span>
                                            <span class="text-muted-foreground text-xs">
                                                @_fetchedFile.Size &middot; @_fetchedFile.Type
                                            </span>
                                        </div>
                                    </div>
                                    <div class="mt-1.5 truncate font-mono text-muted-foreground text-xs">
                                        @_fetchedFile.Url
                                    </div>
                                    <div class="mt-3 flex items-center justify-end gap-2">
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="ClearFetchedFile">
                                            Clear
                                        </ButtonCn>
                                        <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="HandleConfirm">
                                            Upload
                                        </ButtonCn>
                                    </div>
                                </div>
                            }

                            @if (_fetchStatus == FetchStatus.Error)
                            {
                                <div class="mt-3 rounded-md bg-muted/50 px-3 py-2">
                                    <span class="text-muted-foreground text-xs">
                                        Could not fetch file from this URL. Check the link and try again.
                                    </span>
                                </div>
                            }
                        </div>
                    </TabsContentCn>
                </TabsCn>
            </div>

            @* Footer *@
            <div class="border-t px-4 py-2.5">
                <span class="text-muted-foreground text-xs">
                    Files are stored securely and encrypted at rest.
                </span>
            </div>
        </div>
    </section>
}

@code {
    private enum FetchStatus { Idle, Fetching, Fetched, Error }

    private class FileInfo
    {
        public string Name { get; set; } = "";
        public string Size { get; set; } = "";
        public string Type { get; set; } = "";
        public string Url { get; set; } = "";
    }

    private string _url = "";
    private FetchStatus _fetchStatus = FetchStatus.Idle;
    private FileInfo? _fetchedFile = null;
    private FileInfo? _selectedFile = null;
    private bool _confirmed = false;

    private bool _isValidUrl => _url.StartsWith("http://") || _url.StartsWith("https://");

    private async Task HandleFetch()
    {
        _fetchStatus = FetchStatus.Fetching;
        _fetchedFile = null;
        StateHasChanged();

        await Task.Delay(1200);

        var parts = _url.Split('/');
        var filename = parts.Length > 0 ? parts[^1] : "remote-file";
        if (string.IsNullOrEmpty(filename)) filename = "remote-file";
        _fetchedFile = new FileInfo
        {
            Name = filename.Contains('.') ? filename : $"{filename}.pdf",
            Size = "3.8 MB",
            Type = "application/pdf",
            Url = _url,
        };
        _fetchStatus = FetchStatus.Fetched;
    }

    private void HandleConfirm()
    {
        _confirmed = true;
    }

    private void ClearSelectedFile()
    {
        _selectedFile = null;
    }

    private void ClearFetchedFile()
    {
        _fetchStatus = FetchStatus.Idle;
        _fetchedFile = null;
        _url = "";
    }

    private void TriggerFileBrowse()
    {
        // File input click requires JS interop; no-op in this presentational port
    }

    private void Reset()
    {
        _url = "";
        _fetchStatus = FetchStatus.Idle;
        _fetchedFile = null;
        _selectedFile = null;
        _confirmed = false;
    }
}
