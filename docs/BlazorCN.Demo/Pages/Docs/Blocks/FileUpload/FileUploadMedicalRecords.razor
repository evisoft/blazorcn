@* ============================================================
   Block: file-upload-medical-records
   Title: FileUploadMedicalRecords
   Description: A HIPAA-compliant medical records upload block for React and Next.js with encrypted upload badge, patient information fields, record type selector for lab results, imaging, and prescriptions, date of service picker, compliance notice, and audit trail log using shadcn/ui Button, Badge, Input, and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-medical-records.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Medical Records</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto gap-1 font-normal text-xs">
                <LucideIconCn Name="lock" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                Encrypted
            </BadgeCn>
        </div>

        @if (!_uploaded)
        {
            <div class="flex flex-col items-center px-4 py-10">
                <LucideIconCn Name="upload" Size="32" Class="mb-3 size-8 text-muted-foreground" />
                <span class="font-medium text-sm">Upload medical record</span>
                <span class="mt-1 text-muted-foreground text-xs">PDF, DICOM, or image up to 50 MB</span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-4 h-7 text-xs" OnClick="@(() => _uploaded = true)">
                    Choose file
                </ButtonCn>
            </div>
        }
        else
        {
            @* File info *@
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted/50">
                    <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground/60" />
                </div>
                <div class="min-w-0 flex-1">
                    <span class="block truncate font-medium text-sm">lab-results-rodriguez-031226.pdf</span>
                    <span class="text-muted-foreground text-xs">892 KB</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-mono font-normal text-xs">
                    PDF
                </BadgeCn>
            </div>

            @* Record type selector *@
            <div class="border-b px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">Record type</span>
                <div class="mt-2 grid grid-cols-4 gap-2">
                    @foreach (var rt in _recordTypes)
                    {
                        var recType = rt;
                        var isActive = _selectedType == recType.Id;
                        <button type="button"
                                @onclick="@(() => _selectedType = recType.Id)"
                                class="@Cn.Merge("flex flex-col items-center gap-1 rounded-md border p-2 text-xs transition-colors", isActive ? "border-foreground bg-muted/50 font-medium" : "border-transparent text-muted-foreground hover:bg-muted/50")">
                            <LucideIconCn Name="@recType.IconName" Size="16" Class="size-4" />
                            @recType.Label
                        </button>
                    }
                </div>
            </div>

            @* Patient information *@
            <div class="border-b px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">Patient information</span>
                <div class="mt-2 grid grid-cols-2 gap-3">
                    <div>
                        <span class="text-muted-foreground text-xs">Full name</span>
                        <InputCn aria-label="Full name" @bind-Value="_patientName" Class="mt-0.5 h-7 text-sm" />
                    </div>
                    <div>
                        <span class="text-muted-foreground text-xs">Date of birth</span>
                        <InputCn aria-label="Date of birth" @bind-Value="_patientDob" Class="mt-0.5 h-7 font-mono text-sm" />
                    </div>
                    <div>
                        <span class="text-muted-foreground text-xs">Medical record number</span>
                        <InputCn aria-label="Medical record number" @bind-Value="_mrn" Class="mt-0.5 h-7 font-mono text-sm" />
                    </div>
                    <div>
                        <span class="text-muted-foreground text-xs">Date of service</span>
                        <InputCn aria-label="Date of service" @bind-Value="_serviceDate" Class="mt-0.5 h-7 font-mono text-sm" />
                    </div>
                </div>
            </div>

            @* Compliance notice *@
            <div class="border-b px-4 py-3">
                <div class="flex items-start gap-2 rounded-md bg-muted/50 p-3">
                    <LucideIconCn Name="shield-check" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                    <div>
                        <span class="font-medium text-xs">HIPAA compliance</span>
                        <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">
                            This record is encrypted with AES-256 at rest and TLS 1.3 in transit. Access is
                            restricted to authorized personnel only. All views and downloads are logged in
                            the audit trail below.
                        </p>
                    </div>
                </div>
            </div>

            @* Audit trail *@
            <div>
                <button type="button"
                        @onclick="@(() => _showAudit = !_showAudit)"
                        class="flex w-full items-center gap-2 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                    <span class="font-medium text-sm">Audit trail</span>
                    <span class="text-muted-foreground text-xs">(@(_auditLog.Length) events)</span>
                </button>
                @if (_showAudit)
                {
                    <div>
                        @for (int i = 0; i < _auditLog.Length; i++)
                        {
                            var entry = _auditLog[i];
                            var isLast = i == _auditLog.Length - 1;
                            <div class="@(isLast ? "px-4 py-2.5" : "border-b px-4 py-2.5")">
                                <div class="flex items-center justify-between">
                                    <span class="text-sm">@entry.Action</span>
                                    <span class="font-mono text-muted-foreground text-xs">@entry.Timestamp</span>
                                </div>
                                <p class="mt-0.5 text-muted-foreground text-xs">@entry.Actor</p>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record RecordType(string Id, string Label, string IconName);
    private record AuditEntry(string Id, string Action, string Actor, string Timestamp);

    private static readonly RecordType[] _recordTypes =
    [
        new("lab",          "Lab Results",    "test-tube"),
        new("imaging",      "Imaging",        "scan"),
        new("prescription", "Prescription",   "pill"),
        new("clinical",     "Clinical Notes", "clipboard-list"),
    ];

    private static readonly AuditEntry[] _auditLog =
    [
        new("1", "File uploaded",          "Dr. Maria Santos",     "Mar 15, 2026 at 9:42 AM"),
        new("2", "Record type assigned",   "Dr. Maria Santos",     "Mar 15, 2026 at 9:43 AM"),
        new("3", "Patient linked",         "System (auto-match)",  "Mar 15, 2026 at 9:43 AM"),
        new("4", "Record reviewed",        "Nurse James Park",     "Mar 15, 2026 at 10:15 AM"),
    ];

    private bool _uploaded = true;
    private string _selectedType = "lab";
    private string _patientName = "Emily Rodriguez";
    private string _patientDob = "1988-06-14";
    private string _mrn = "MRN-00284719";
    private string _serviceDate = "2026-03-12";
    private bool _showAudit = false;
}
