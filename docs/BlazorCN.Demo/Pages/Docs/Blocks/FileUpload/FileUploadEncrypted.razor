@* ============================================================
   Block: file-upload-encrypted
   Title: FileUploadEncrypted
   Description: React secure file upload block for Next.js with end-to-end encryption, lock icons, encryption badge, encrypting and uploading progress states, and checksum verification using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-encrypted.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="lock" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Secure upload</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
                <LucideIconCn Name="shield-check" Size="12" Class="size-3" />
                End-to-end encrypted
            </BadgeCn>
        </div>

        @* Encryption notice *@
        <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-2.5">
            <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
            <span class="text-muted-foreground text-xs">
                Files are encrypted client-side before upload. Only you and your recipients can decrypt
                them.
            </span>
        </div>

        @* Stats *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @_completedCount of @_files.Length encrypted and uploaded
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">AES-256-GCM</span>
        </div>

        @* Drop zone *@
        <div class="border-b px-4 py-4">
            <div class="flex flex-col items-center justify-center rounded-md border border-dashed px-4 py-6">
                <div class="relative mb-2">
                    <LucideIconCn Name="upload" Size="20" Class="size-5 text-muted-foreground/60" />
                    <LucideIconCn Name="lock" Size="12" Class="absolute -right-1.5 -bottom-1 size-3 text-muted-foreground" />
                </div>
                <p class="font-medium text-sm">Drop files to encrypt and upload</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Files are encrypted before leaving your device
                </p>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-3 h-7 text-xs">
                    Browse files
                </ButtonCn>
            </div>
        </div>

        @* File list *@
        <div>
            @for (int i = 0; i < _files.Length; i++)
            {
                var idx = i;
                var file = _files[i];
                var isLast = idx == _files.Length - 1;
                var config = _statusConfig[file.Status];
                var activeProgress = file.Status == FileStatus.Encrypting ? file.EncryptProgress : file.UploadProgress;

                <div class="@Cn.Merge("", isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3 px-4 py-3">
                        @if (file.Status == FileStatus.Complete)
                        {
                            <LucideIconCn Name="check-circle" Size="16" Class="size-4 shrink-0 text-emerald-500" />
                        }
                        else
                        {
                            <div class="relative shrink-0">
                                <LucideIconCn Name="file" Size="16" Class="size-4 text-muted-foreground/60" />
                                <LucideIconCn Name="lock" Size="10" Class="absolute -right-1 -bottom-0.5 size-2.5 text-muted-foreground" />
                            </div>
                        }
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate font-medium text-sm">@file.Name</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="text-muted-foreground text-xs">@file.Size</span>
                                <span class="text-muted-foreground text-xs">·</span>
                                <span class="@($"text-xs {config.Color}")">@config.Label</span>
                            </div>
                        </div>
                        @if (file.Status != FileStatus.Complete)
                        {
                            <span class="shrink-0 tabular-nums text-muted-foreground text-xs">
                                @(activeProgress)%
                            </span>
                        }
                    </div>

                    @* Progress bar for in-progress files *@
                    @if (file.Status != FileStatus.Complete)
                    {
                        <div class="px-4 pb-3">
                            <div class="space-y-1.5">
                                @if (file.Status == FileStatus.Encrypting)
                                {
                                    <div>
                                        <div class="mb-1 flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Encrypting</span>
                                            <span class="tabular-nums text-muted-foreground text-xs">
                                                @(file.EncryptProgress)%
                                            </span>
                                        </div>
                                        <div class="h-1 w-full overflow-hidden rounded-full bg-primary/20">
                                            <div class="h-full rounded-full bg-amber-500 transition-all" style="@($"width:{file.EncryptProgress}%")"></div>
                                        </div>
                                    </div>
                                }
                                @if (file.Status == FileStatus.Uploading)
                                {
                                    <div>
                                        <div class="mb-1 flex items-center justify-between">
                                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                <LucideIconCn Name="check-circle" Size="12" Class="size-3 text-emerald-500" />
                                                Encrypted
                                            </span>
                                        </div>
                                    </div>
                                    <div>
                                        <div class="mb-1 flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Uploading</span>
                                            <span class="tabular-nums text-muted-foreground text-xs">
                                                @(file.UploadProgress)%
                                            </span>
                                        </div>
                                        <ProgressCn Value="@file.UploadProgress" Class="h-1" aria-label="Progress" />
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @* Checksum for completed files *@
                    @if (file.Status == FileStatus.Complete && file.Checksum != null)
                    {
                        <div class="px-4 pb-3">
                            <div class="flex items-center gap-2 rounded-md bg-muted/50 px-3 py-2">
                                <LucideIconCn Name="shield-check" Size="12" Class="size-3 shrink-0 text-emerald-500" />
                                <span class="text-muted-foreground text-xs">SHA-256</span>
                                <span class="font-mono text-xs">@file.Checksum</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private enum FileStatus { Encrypting, Uploading, Complete }

    private record StatusConfig(string Label, string Color);

    private class SecureFile
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Size { get; set; } = "";
        public FileStatus Status { get; set; }
        public int EncryptProgress { get; set; }
        public int UploadProgress { get; set; }
        public string? Checksum { get; set; }
    }

    private static readonly SecureFile[] _files =
    [
        new SecureFile { Id = "1", Name = "medical-records-2024.pdf",    Size = "3.2 MB", Status = FileStatus.Complete,   EncryptProgress = 100, UploadProgress = 100, Checksum = "a7f3c8d1e9b2" },
        new SecureFile { Id = "2", Name = "tax-return-final.pdf",        Size = "1.8 MB", Status = FileStatus.Complete,   EncryptProgress = 100, UploadProgress = 100, Checksum = "b4e6f2a9c1d8" },
        new SecureFile { Id = "3", Name = "contract-nda-signed.pdf",     Size = "945 KB", Status = FileStatus.Uploading,  EncryptProgress = 100, UploadProgress = 67  },
        new SecureFile { Id = "4", Name = "financial-statement-q4.xlsx", Size = "2.1 MB", Status = FileStatus.Encrypting, EncryptProgress = 34,  UploadProgress = 0   },
    ];

    private static readonly Dictionary<FileStatus, StatusConfig> _statusConfig = new()
    {
        [FileStatus.Encrypting] = new StatusConfig("Encrypting...", "text-amber-600 dark:text-amber-400"),
        [FileStatus.Uploading]  = new StatusConfig("Uploading...",  "text-blue-600 dark:text-blue-400"),
        [FileStatus.Complete]   = new StatusConfig("Complete",      "text-emerald-600 dark:text-emerald-400"),
    };

    private int _completedCount => _files.Count(f => f.Status == FileStatus.Complete);
}
