@* ============================================================
   Block: file-upload-ai-analyze
   Title: FileUploadAiAnalyze
   Description: Upload a document or image for AI-powered content analysis with tag detection, text extraction, object recognition, and confidence scores using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-ai-analyze.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="brain-circuit" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">AI Content Analysis</span>
            </div>
            @if (_state == "complete")
            {
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" OnClick="Reset">
                    Reset
                </ButtonCn>
            }
        </div>

        @* Upload area *@
        @if (_state == "idle")
        {
            <div class="border-b px-4 py-4">
                <div
                    role="button"
                    tabindex="0"
                    @onclick="TriggerUpload"
                    @onkeydown="HandleKeyDown"
                    class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-md border-2 border-dashed border-muted-foreground/20 px-6 py-10 transition-colors hover:border-muted-foreground/40 hover:bg-muted/30">
                    <LucideIconCn Name="cloud-upload" Size="32" Class="size-8 text-muted-foreground/60" />
                    <span class="font-medium text-sm">Upload file to analyze</span>
                    <p class="text-muted-foreground text-xs">PNG, JPG, WebP, or PDF up to 25 MB</p>
                </div>
            </div>
        }

        @* Processing state *@
        @if (_state == "uploading" || _state == "analyzing")
        {
            <div class="border-b px-4 py-6">
                <div class="flex flex-col items-center gap-2">
                    <LucideIconCn Name="sparkles" Size="24" Class="size-6 animate-pulse text-muted-foreground" />
                    <span class="font-medium text-sm">
                        @(_state == "uploading" ? "Uploading file..." : "Analyzing content...")
                    </span>
                    <span class="text-muted-foreground text-xs">
                        @_fileName · @_fileSize
                    </span>
                </div>
            </div>
        }

        @* File info when complete *@
        @if (_state == "complete")
        {
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <LucideIconCn Name="file-text" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                <div class="min-w-0 flex-1">
                    <span class="block truncate font-medium text-sm">@_fileName</span>
                    <span class="text-muted-foreground text-xs">@_fileSize</span>
                </div>
                <div class="flex items-center gap-3">
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <LucideIconCn Name="tag" Size="12" Class="size-3" />
                        @_detections.Count(d => d.Category == "tag")
                    </span>
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <LucideIconCn Name="file-text" Size="12" Class="size-3" />
                        @_detections.Count(d => d.Category == "text")
                    </span>
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <LucideIconCn Name="image" Size="12" Class="size-3" />
                        @_detections.Count(d => d.Category == "object")
                    </span>
                </div>
            </div>
        }

        @* Detection results *@
        @if (_state == "complete" && _detections.Length > 0)
        {
            <div>
                @for (int i = 0; i < _detections.Length; i++)
                {
                    var detection = _detections[i];
                    var isLast = i == _detections.Length - 1;
                    var isExpanded = _expanded == detection.Id;
                    var detId = detection.Id;
                    var iconName = detection.Category == "tag" ? "tag" : detection.Category == "text" ? "file-text" : "image";
                    var categoryLbl = detection.Category == "tag" ? "Tag" : detection.Category == "text" ? "Text" : "Object";
                    var confColor = ConfidenceColor(detection.Confidence);
                    <div class="@(isLast ? "" : "border-b")">
                        <button
                            type="button"
                            @onclick="@(() => _expanded = (isExpanded ? null : detId))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                            <LucideIconCn Name="@iconName" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-sm">@detection.Label</span>
                                <div class="mt-0.5 flex items-center gap-2">
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                        @categoryLbl
                                    </BadgeCn>
                                    <span class="@($"font-medium tabular-nums text-xs {confColor}")">
                                        @detection.Confidence%
                                    </span>
                                </div>
                            </div>
                            <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </button>

                        @if (isExpanded)
                        {
                            <div class="px-4 pb-4 pl-11">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <p class="text-sm leading-relaxed">@detection.Detail</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @* Empty state *@
        @if (_state == "idle")
        {
            <div class="px-4 py-5 text-center">
                <span class="text-muted-foreground text-xs">
                    Upload a file to see AI-detected content, tags, and objects
                </span>
            </div>
        }
    </div>
</section>

@code {
    private record Detection(string Id, string Category, string Label, int Confidence, string Detail);

    private static readonly Detection[] _sampleDetections =
    [
        new("d1", "object", "Bar Chart", 97,
            "Detected a horizontal bar chart with 6 data series. Axis labels suggest quarterly revenue comparison across product lines."),
        new("d2", "object", "Data Table", 94,
            "A 5-column table with headers: Region, Q1, Q2, Q3, Q4. Contains 8 rows of numeric financial data."),
        new("d3", "text", "Title Extraction", 99,
            "Primary heading reads \"2025 Annual Revenue Report\". Subtitle: \"Fiscal Year Performance by Region\"."),
        new("d4", "text", "Body Text", 91,
            "Extracted 342 words from 4 paragraphs. Language: English. Key topics: revenue growth, regional performance, forecast."),
        new("d5", "tag", "Financial Report", 96,
            "Document classified as a financial report based on content structure, terminology, and data visualization patterns."),
        new("d6", "tag", "Data Visualization", 88,
            "Contains multiple chart elements and structured data presentations. Suitable for automated data extraction."),
        new("d7", "tag", "Corporate Document", 82,
            "Formatting, branding elements, and document structure match corporate report templates."),
    ];

    private string _state = "idle";
    private string _fileName = "";
    private string _fileSize = "";
    private string? _expanded = "d3";
    private Detection[] _detections = [];

    private void TriggerUpload()
    {
        // In a demo/presentational port the actual file input is not wired;
        // simulate the full flow with the sample data.
        SimulateAnalysis("annual-revenue-report.pdf", "2.4 MB");
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            TriggerUpload();
        }
    }

    private void SimulateAnalysis(string name, string size)
    {
        _fileName = name;
        _fileSize = size;
        _state = "uploading";
        _detections = [];
        _expanded = null;
        // In a presentational demo we jump straight to complete.
        _state = "complete";
        _detections = _sampleDetections;
        _expanded = "d3";
    }

    private void Reset()
    {
        _state = "idle";
        _fileName = "";
        _fileSize = "";
        _detections = [];
        _expanded = null;
    }

    private static string ConfidenceColor(int value)
    {
        if (value >= 90) return "text-emerald-600 dark:text-emerald-400";
        if (value >= 70) return "text-amber-600 dark:text-amber-400";
        return "text-red-600 dark:text-red-400";
    }
}
