@* ============================================================
   Block: file-upload-data-room
   Title: FileUploadDataRoom
   Description: A secure data room upload block for React and Next.js with due diligence section categories for financial, legal, and technical documents, per-section upload, access log, NDA acknowledgment, and watermark notice using shadcn/ui Button, Badge, Checkbox, and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-data-room.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="lock" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Data Room</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_totalDocs documents
                </BadgeCn>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="@(() => _showLog = !_showLog)">
                <LucideIconCn Name="eye" Size="12" Class="size-3" />
                Access log
            </ButtonCn>
        </div>

        @* Watermark notice *@
        <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-2">
            <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
            <span class="text-muted-foreground text-xs">
                All downloaded documents are watermarked with viewer email and timestamp
            </span>
        </div>

        @* NDA acknowledgment *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <span class="flex items-center gap-2">
                <CheckboxCn Checked="@_ndaAccepted" CheckedChanged="@((bool v) => _ndaAccepted = v)" />
                <span class="text-sm">I acknowledge the NDA and confidentiality terms</span>
            </span>
        </div>

        @* Access log (conditional) *@
        @if (_showLog)
        {
            <div class="border-b">
                <div class="border-b px-4 py-2">
                    <span class="font-medium text-muted-foreground text-xs">Recent access</span>
                </div>
                @foreach (var evtEntry in _accessLog)
                {
                    var evt = evtEntry;
                    var evtIndex = System.Array.IndexOf(_accessLog, evt);
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2", evtIndex < _accessLog.Length - 1 ? "border-b" : "")">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", evt.Action == "Downloaded" ? "bg-blue-500" : "bg-muted-foreground")"></span>
                        <div class="min-w-0 flex-1">
                            <span class="text-xs">
                                <span class="font-medium">@evt.User</span>
                                <span class="text-muted-foreground"> @evt.Action.ToLower() </span>
                                <span class="font-mono text-muted-foreground">@evt.File</span>
                            </span>
                        </div>
                        <span class="shrink-0 text-muted-foreground text-xs">@evt.Time</span>
                    </div>
                }
            </div>
        }

        @* Sections *@
        <div>
            @foreach (var secEntry in _sections)
            {
                var sec = secEntry;
                var secIndex = System.Array.IndexOf(_sections, sec);
                var isExpanded = _expandedSection == sec.Id;
                var isLastSection = secIndex == _sections.Length - 1;
                <div class="@(isLastSection && !isExpanded ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => ToggleSection(sec.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="@sec.Icon" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@sec.Label</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@sec.Description</p>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs tabular-nums">
                            @sec.Documents.Length
                        </BadgeCn>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div>
                            @* Upload to section *@
                            <div class="flex items-center justify-between border-b border-t bg-muted/20 px-4 py-2 pl-11">
                                <span class="text-muted-foreground text-xs">
                                    Upload to @sec.Label
                                </span>
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 gap-1.5 text-xs" Disabled="@(!_ndaAccepted)">
                                    <LucideIconCn Name="upload" Size="12" Class="size-3" />
                                    Upload
                                </ButtonCn>
                            </div>

                            @* Document list *@
                            @foreach (var docEntry in sec.Documents)
                            {
                                var doc = docEntry;
                                var docIndex = System.Array.IndexOf(sec.Documents, doc);
                                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 pl-11 transition-colors hover:bg-muted/50", docIndex < sec.Documents.Length - 1 ? "border-b" : "")">
                                    <LucideIconCn Name="file-text" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                                    <div class="min-w-0 flex-1">
                                        <span class="block truncate font-medium text-xs">@doc.Name</span>
                                        <span class="text-muted-foreground text-xs">
                                            @doc.Size · @doc.UploadedBy · @doc.UploadedAt
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record DataRoomDocument(string Id, string Name, string Size, string UploadedBy, string UploadedAt);
    private record DataRoomSection(string Id, string Label, string Icon, string Description, DataRoomDocument[] Documents);
    private record AccessEvent(string Id, string User, string Action, string File, string Time);

    private static readonly DataRoomSection[] _sections =
    [
        new("financial", "Financial", "briefcase", "Revenue models, audited statements, projections",
        [
            new("d1", "Q4-2025-audited-financials.pdf", "2.8 MB", "Sarah Chen", "3 days ago"),
            new("d2", "revenue-model-2026.xlsx", "1.4 MB", "Sarah Chen", "3 days ago"),
            new("d3", "cap-table-current.pdf", "420 KB", "James Park", "5 days ago"),
        ]),
        new("legal", "Legal", "scale", "Contracts, IP filings, corporate structure",
        [
            new("d4", "certificate-of-incorporation.pdf", "180 KB", "James Park", "1 week ago"),
            new("d5", "material-contracts-summary.pdf", "3.2 MB", "James Park", "1 week ago"),
        ]),
        new("technical", "Technical", "cpu", "Architecture docs, security audits, SOC 2",
        [
            new("d6", "system-architecture-overview.pdf", "5.1 MB", "Alex Rivera", "2 days ago"),
            new("d7", "soc2-type-ii-report.pdf", "8.4 MB", "Alex Rivera", "4 days ago"),
            new("d8", "penetration-test-results.pdf", "1.9 MB", "Alex Rivera", "4 days ago"),
            new("d9", "infrastructure-cost-breakdown.xlsx", "640 KB", "Alex Rivera", "6 days ago"),
        ]),
    ];

    private static readonly AccessEvent[] _accessLog =
    [
        new("a1", "Maria Gonzalez", "Viewed", "Q4-2025-audited-financials.pdf", "12 min ago"),
        new("a2", "David Kim", "Downloaded", "soc2-type-ii-report.pdf", "1 hour ago"),
        new("a3", "Maria Gonzalez", "Viewed", "cap-table-current.pdf", "2 hours ago"),
        new("a4", "Rachel Wood", "Downloaded", "material-contracts-summary.pdf", "5 hours ago"),
        new("a5", "David Kim", "Viewed", "system-architecture-overview.pdf", "Yesterday"),
    ];

    private static readonly int _totalDocs = _sections.Sum(s => s.Documents.Length);

    private string? _expandedSection = "financial";
    private bool _ndaAccepted = false;
    private bool _showLog = false;

    private void ToggleSection(string sectionId)
    {
        _expandedSection = _expandedSection == sectionId ? null : sectionId;
    }
}
