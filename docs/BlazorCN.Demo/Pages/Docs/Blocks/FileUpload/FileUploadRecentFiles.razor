@* ============================================================
   Block: file-upload-recent-files
   Title: FileUploadRecentFiles
   Description: A React recent files widget block showing the last 10 uploaded files with recency indicators, quick action buttons for preview, download, and share, a view all link, and compact list format using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-recent-files.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Recent uploads</span>
                <p class="mt-0.5 text-muted-foreground text-xs">Last @_recentFiles.Length files</p>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                View all
                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
            </ButtonCn>
        </div>

        @* File list *@
        <div>
            @for (int i = 0; i < _recentFiles.Length; i++)
            {
                var file = _recentFiles[i];
                var isLast = i == _recentFiles.Length - 1;
                <div class="@Cn.Merge("group flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    @* Type icon *@
                    <LucideIconCn Name="@GetTypeIcon(file.Type)" Size="16" Class="size-4 text-muted-foreground" />

                    @* File info *@
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="truncate font-medium text-sm">@file.Name</span>
                        </div>
                        <div class="mt-0.5 flex items-center gap-1.5">
                            <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", GetRecencyDot(file.Recency))"></span>
                            <span class="text-muted-foreground text-xs">@file.Recency</span>
                            <span class="text-muted-foreground text-xs">·</span>
                            <span class="text-muted-foreground text-xs">@file.Uploader</span>
                            <span class="text-muted-foreground text-xs">·</span>
                            <span class="text-muted-foreground text-xs tabular-nums">@file.Size</span>
                        </div>
                    </div>

                    @* Quick actions *@
                    <div class="flex items-center gap-0.5 opacity-0 transition-opacity group-hover:opacity-100">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 p-0" aria-label="@($"Preview {file.Name}")">
                            <LucideIconCn Name="eye" Size="14" Class="size-3.5" />
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 p-0" aria-label="@($"Download {file.Name}")">
                            <LucideIconCn Name="download" Size="14" Class="size-3.5" />
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 p-0" aria-label="@($"Share {file.Name}")">
                            <LucideIconCn Name="share" Size="14" Class="size-3.5" />
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <p class="text-muted-foreground text-xs">
                Showing most recent uploads. Older files available in the full file manager.
            </p>
        </div>
    </div>
</section>

@code {
    private record RecentFile(string Id, string Name, string Type, string Size, string Recency, string Uploader);

    private static readonly RecentFile[] _recentFiles =
    [
        new("r1",  "Q4 Revenue Report.pdf",       "pdf",         "2.4 MB", "Just now",   "Alice Chen"),
        new("r2",  "Product Hero Banner.png",      "image",       "4.1 MB", "2 min ago",  "Bob Martinez"),
        new("r3",  "Sprint Retrospective.docx",    "document",    "180 KB", "5 min ago",  "Carol Wu"),
        new("r4",  "Budget Tracker.xlsx",          "spreadsheet", "890 KB", "12 min ago", "David Kim"),
        new("r5",  "Brand Guidelines v2.pdf",      "pdf",         "5.6 MB", "28 min ago", "Eve Johnson"),
        new("r6",  "Dashboard Screenshot.png",     "image",       "3.2 MB", "1 hour ago", "Frank Liu"),
        new("r7",  "Customer Research.pdf",        "pdf",         "1.4 MB", "1 hour ago", "Grace Park"),
        new("r8",  "KPI Summary.xlsx",             "spreadsheet", "640 KB", "2 hours ago","Henry Adams"),
        new("r9",  "Onboarding Checklist.docx",    "document",    "95 KB",  "3 hours ago","Alice Chen"),
        new("r10", "Release Notes v3.2.pdf",       "pdf",         "320 KB", "5 hours ago","David Kim"),
    ];

    private static string GetTypeIcon(string type) => type switch
    {
        "pdf"         => "file-text",
        "image"       => "image",
        "spreadsheet" => "file-spreadsheet",
        _             => "file",
    };

    private static string GetRecencyDot(string recency)
    {
        if (recency == "Just now" || recency.Contains("min")) return "bg-emerald-500";
        if (recency.Contains("1 hour")) return "bg-blue-500";
        return "bg-muted-foreground";
    }
}
