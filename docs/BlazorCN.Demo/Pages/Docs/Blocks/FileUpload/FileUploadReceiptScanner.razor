@* ============================================================
   Block: file-upload-receipt-scanner
   Title: FileUploadReceiptScanner
   Description: A React receipt and document scanner upload block with OCR data extraction simulation, editable vendor/date/amount/category fields, and save functionality using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-receipt-scanner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="scan-line" Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <p class="font-medium text-sm">Receipt scanner</p>
                    <p class="text-muted-foreground text-xs">Upload a receipt to extract data</p>
                </div>
            </div>
            @if (_status == "extracted")
            {
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    <span class="@_confidenceColor mr-1 font-semibold tabular-nums">@_confidence%</span>
                    confidence
                </BadgeCn>
            }
        </div>

        @* Upload / Receipt preview area *@
        <div class="border-b px-4 py-4">
            @if (_status == "idle")
            {
                <div class="flex flex-col items-center gap-3 rounded-md border border-dashed bg-muted/30 py-8">
                    <LucideIconCn Name="receipt" Size="24" Class="size-6 text-muted-foreground/50" />
                    <div class="text-center">
                        <p class="font-medium text-sm">Upload receipt</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">JPG, PNG, or PDF up to 10 MB</p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="@(() => _status = "scanning")">
                        <LucideIconCn Name="upload" Size="12" Class="size-3" />
                        Choose file
                    </ButtonCn>
                </div>
            }
            else if (_status == "scanning")
            {
                <div class="flex flex-col items-center gap-3 rounded-md bg-muted/30 py-8">
                    <div class="relative">
                        <LucideIconCn Name="receipt" Size="24" Class="size-6 text-muted-foreground/50" />
                        <span class="absolute -top-1 -right-1 size-2 animate-pulse rounded-full bg-amber-500"></span>
                    </div>
                    <div class="text-center">
                        <p class="font-medium text-sm">Scanning receipt...</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Extracting text and data</p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="@(() => _status = "extracted")">
                        Skip (use demo data)
                    </ButtonCn>
                </div>
            }
            else
            {
                <div class="flex gap-4">
                    @* Receipt thumbnail placeholder *@
                    <div class="flex w-24 shrink-0 flex-col items-center justify-center rounded-md border bg-muted/30 py-6">
                        <LucideIconCn Name="receipt" Size="20" Class="size-5 text-muted-foreground/40" />
                        <span class="mt-1 font-mono text-muted-foreground text-[10px]">receipt.jpg</span>
                        <span class="font-mono text-muted-foreground/60 text-[10px]">2.1 MB</span>
                    </div>

                    @* OCR extracted lines simulation *@
                    <div class="flex-1 space-y-1.5">
                        <p class="font-medium text-muted-foreground text-xs">Extracted text</p>
                        <div class="space-y-1 rounded-md bg-muted/50 p-2.5">
                            <p class="font-mono text-xs">BLUE BOTTLE COFFEE</p>
                            <p class="font-mono text-muted-foreground text-[10px]">345 Spear St, San Francisco CA</p>
                            <p class="font-mono text-muted-foreground text-[10px]">03/19/2026 11:42 AM</p>
                            <div class="my-1 border-b border-dashed"></div>
                            <p class="font-mono text-[10px]">
                                <span class="text-muted-foreground">1x Drip Coffee</span>
                                <span class="float-right">$5.50</span>
                            </p>
                            <p class="font-mono text-[10px]">
                                <span class="text-muted-foreground">1x Avocado Toast</span>
                                <span class="float-right">$11.43</span>
                            </p>
                            <div class="my-1 border-b border-dashed"></div>
                            <p class="font-mono text-[10px]">
                                <span class="text-muted-foreground">Subtotal</span>
                                <span class="float-right">$16.93</span>
                            </p>
                            <p class="font-mono text-[10px]">
                                <span class="text-muted-foreground">Tax</span>
                                <span class="float-right">$1.52</span>
                            </p>
                            <p class="font-mono text-xs">
                                <span>Total</span>
                                <span class="float-right font-medium">$18.45</span>
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Extracted fields *@
        @if (_status == "extracted" || _status == "saved")
        {
            <div class="border-b">
                <div class="px-4 py-2">
                    <p class="font-medium text-muted-foreground text-xs">Extracted data</p>
                </div>

                @* Vendor *@
                <div class="flex items-center gap-3 border-b px-4 py-2.5">
                    <span class="w-24 shrink-0 text-muted-foreground text-xs">Vendor</span>
                    @if (_editingField == "vendor")
                    {
                        <InputCn @bind-Value="_vendor" Class="h-7 flex-1 text-sm" />
                    }
                    else
                    {
                        <div class="flex flex-1 items-center justify-between">
                            <span class="font-medium text-sm">@_vendor</span>
                            <button type="button" @onclick="@(() => _editingField = "vendor")"
                                    class="rounded p-0.5 text-muted-foreground/50 transition-colors hover:text-foreground">
                                <LucideIconCn Name="pencil" Size="12" Class="size-3" />
                            </button>
                        </div>
                    }
                </div>

                @* Date *@
                <div class="flex items-center gap-3 border-b px-4 py-2.5">
                    <span class="w-24 shrink-0 text-muted-foreground text-xs">Date</span>
                    @if (_editingField == "date")
                    {
                        <InputCn @bind-Value="_date" Class="h-7 flex-1 text-sm" />
                    }
                    else
                    {
                        <div class="flex flex-1 items-center justify-between">
                            <span class="text-sm">@_date</span>
                            <button type="button" @onclick="@(() => _editingField = "date")"
                                    class="rounded p-0.5 text-muted-foreground/50 transition-colors hover:text-foreground">
                                <LucideIconCn Name="pencil" Size="12" Class="size-3" />
                            </button>
                        </div>
                    }
                </div>

                @* Amount *@
                <div class="flex items-center gap-3 border-b px-4 py-2.5">
                    <span class="w-24 shrink-0 text-muted-foreground text-xs">Total</span>
                    <div class="flex flex-1 items-center gap-3">
                        <span class="font-semibold text-sm tabular-nums">@_amount</span>
                        <span class="text-muted-foreground/40 text-xs">·</span>
                        <span class="text-muted-foreground text-xs">Subtotal @_subtotal</span>
                        <span class="text-muted-foreground/40 text-xs">·</span>
                        <span class="text-muted-foreground text-xs">Tax @_tax</span>
                    </div>
                </div>

                @* Payment method *@
                <div class="flex items-center gap-3 border-b px-4 py-2.5">
                    <span class="w-24 shrink-0 text-muted-foreground text-xs">Payment</span>
                    <span class="font-mono text-sm">@_paymentMethod</span>
                </div>

                @* Category *@
                <div class="flex items-center gap-3 px-4 py-2.5">
                    <span class="w-24 shrink-0 text-muted-foreground text-xs">Category</span>
                    <SelectCn @bind-Value="_category">
                        <SelectTriggerCn Class="h-7 w-auto gap-1 border-0 bg-transparent px-1 text-sm shadow-none focus:ring-0">
                            <SelectValueCn Placeholder="Select category" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var cat in _categories)
                            {
                                var catItem = cat;
                                <SelectItemCn Value="@catItem.Value">@catItem.Label</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>
        }

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3">
            @if (_status == "saved")
            {
                <div class="flex items-center gap-1.5 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                    Receipt saved
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="@ResetToIdle">
                    Scan another
                </ButtonCn>
            }
            else if (_status == "extracted")
            {
                <p class="text-muted-foreground text-xs">Click any field to edit</p>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="@(() => _status = "saved")">
                    Save receipt
                </ButtonCn>
            }
            else
            {
                <p class="text-muted-foreground text-xs">
                    @(_status == "idle" ? "Supports JPG, PNG, and PDF receipts" : "Processing your receipt...")
                </p>
            }
        </div>
    </div>
</section>

@code {
    private record CategoryOption(string Value, string Label);

    private static readonly CategoryOption[] _categories =
    [
        new("meals",     "Meals & Dining"),
        new("travel",    "Travel"),
        new("office",    "Office Supplies"),
        new("software",  "Software"),
        new("transport", "Transportation"),
        new("other",     "Other"),
    ];

    private string _status        = "extracted";
    private string? _editingField = null;

    private string _vendor        = "Blue Bottle Coffee";
    private string _date          = "Mar 19, 2026";
    private string _amount        = "$18.45";
    private string _tax           = "$1.52";
    private string _subtotal      = "$16.93";
    private string _category      = "meals";
    private string _paymentMethod = "Visa ****4242";
    private int    _confidence    = 94;

    private string _confidenceColor =>
        _confidence >= 90
            ? "text-emerald-600 dark:text-emerald-400"
            : _confidence >= 70
                ? "text-amber-600 dark:text-amber-400"
                : "text-red-600 dark:text-red-400";

    private void ResetToIdle()
    {
        _status        = "idle";
        _editingField  = null;
        _vendor        = "Blue Bottle Coffee";
        _date          = "Mar 19, 2026";
        _amount        = "$18.45";
        _tax           = "$1.52";
        _subtotal      = "$16.93";
        _category      = "meals";
        _paymentMethod = "Visa ****4242";
        _confidence    = 94;
    }
}
