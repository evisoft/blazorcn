@* ============================================================
   Block: file-upload-success-state
   Title: FileUploadSuccessState
   Description: An upload success confirmation block with green checkmark, file details, shareable link with copy button, next action buttons, and upload stats for time, size, and speed using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-success-state.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Upload complete</span>
            <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5" />
                Success
            </span>
        </div>

        @* Success confirmation *@
        <div class="flex flex-col items-center border-b px-4 py-8">
            <div class="mb-3 flex size-12 items-center justify-center rounded-full bg-emerald-500/10">
                <LucideIconCn Name="check-circle-2" Size="24" Class="size-6 text-emerald-600 dark:text-emerald-400" />
            </div>
            <span class="font-medium text-sm">File uploaded successfully</span>
            <span class="mt-1 text-muted-foreground text-xs">
                Your file is ready to view and share
            </span>
        </div>

        @* File details *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-8 items-center justify-center rounded-md bg-muted/50">
                <LucideIconCn Name="file" Size="16" Class="size-4 text-muted-foreground" />
            </div>
            <div class="min-w-0 flex-1">
                <span class="block truncate font-medium text-sm">@_uploadedFile.Name</span>
                <span class="text-muted-foreground text-xs">
                    @_uploadedFile.Size &middot; @_uploadedFile.Type &middot; @_uploadedFile.UploadedAt
                </span>
            </div>
        </div>

        @* Shareable link *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Shareable link
            </span>
            <div class="flex items-center gap-2 rounded-md bg-muted/50 p-2">
                <span class="min-w-0 flex-1 truncate font-mono text-xs">@_shareableLink</span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 shrink-0 gap-1 px-2 text-xs" @onclick="CopyLink">
                    @if (_copied)
                    {
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                        <span>Copied</span>
                    }
                    else
                    {
                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                        <span>Copy</span>
                    }
                </ButtonCn>
            </div>
        </div>

        @* Upload stats *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-4">
                <div>
                    <span class="block text-muted-foreground text-xs">Duration</span>
                    <span class="font-medium tabular-nums text-sm">@_uploadStats.Duration</span>
                </div>
                <span class="text-muted-foreground text-xs">&middot;</span>
                <div>
                    <span class="block text-muted-foreground text-xs">Size</span>
                    <span class="font-medium tabular-nums text-sm">@_uploadStats.Size</span>
                </div>
                <span class="text-muted-foreground text-xs">&middot;</span>
                <div>
                    <span class="block text-muted-foreground text-xs">Speed</span>
                    <span class="font-medium tabular-nums text-sm">@_uploadStats.Speed</span>
                </div>
            </div>
        </div>

        @* Next actions *@
        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                View file
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                <LucideIconCn Name="upload-cloud" Size="12" Class="size-3" />
                Upload more
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                <LucideIconCn Name="share" Size="12" Class="size-3" />
                Share
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record UploadedFile(string Name, string Size, string Type, string UploadedAt);
    private record UploadStats(string Duration, string Size, string Speed);

    private static readonly UploadedFile _uploadedFile = new(
        "brand-guidelines-v2.pdf",
        "8.4 MB",
        "application/pdf",
        "Just now"
    );

    private static readonly string _shareableLink = "https://files.acme.co/d/a1b2c3d4e5f6";

    private static readonly UploadStats _uploadStats = new("3.2s", "8.4 MB", "2.6 MB/s");

    private bool _copied = false;

    private void CopyLink()
    {
        _copied = true;
    }
}
