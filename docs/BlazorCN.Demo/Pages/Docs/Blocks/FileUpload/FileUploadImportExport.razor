@* ============================================================
   Block: file-upload-import-export
   Title: FileUploadImportExport
   Description: Import and export data panel block for React and Next.js with format selection, column mapping preview, record count, merge versus replace option, and download button using shadcn/ui and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-import-export.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with tabs *@
        <div class="flex items-center border-b">
            <button
                type="button"
                @onclick="@(() => _activeTab = "export")"
                class="@Cn.Merge("flex items-center gap-2 px-4 py-3 text-sm transition-colors", _activeTab == "export" ? "border-b-2 border-foreground font-medium" : "text-muted-foreground hover:text-foreground")">
                <LucideIconCn Name="arrow-down-to-line" Size="14" Class="size-3.5" />
                Export
            </button>
            <button
                type="button"
                @onclick="@(() => _activeTab = "import")"
                class="@Cn.Merge("flex items-center gap-2 px-4 py-3 text-sm transition-colors", _activeTab == "import" ? "border-b-2 border-foreground font-medium" : "text-muted-foreground hover:text-foreground")">
                <LucideIconCn Name="arrow-up-from-line" Size="14" Class="size-3.5" />
                Import
            </button>
        </div>

        @if (_activeTab == "export")
        {
            @* Export format selection *@
            <div class="border-b px-4 py-3">
                <span class="text-muted-foreground text-xs">Format</span>
                <div class="mt-2">
                    <SelectCn T="string" Value="@_exportFormat" ValueChanged="@((string v) => _exportFormat = v)">
                        <SelectTriggerCn Class="h-8 w-full text-sm">
                            <SelectValueCn Placeholder="" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="csv">CSV (.csv)</SelectItemCn>
                            <SelectItemCn Value="json">JSON (.json)</SelectItemCn>
                            <SelectItemCn Value="xlsx">Excel (.xlsx)</SelectItemCn>
                            <SelectItemCn Value="tsv">TSV (.tsv)</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            @* Export summary *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-6">
                    <div>
                        <span class="text-muted-foreground text-xs">Records</span>
                        <p class="font-semibold text-sm tabular-nums">12,847</p>
                    </div>
                    <div>
                        <span class="text-muted-foreground text-xs">Columns</span>
                        <p class="font-semibold text-sm tabular-nums">18</p>
                    </div>
                    <div>
                        <span class="text-muted-foreground text-xs">Est. size</span>
                        <p class="font-semibold text-sm tabular-nums">4.2 MB</p>
                    </div>
                </div>
            </div>

            @* Download button *@
            <div class="flex items-center justify-between px-4 py-3">
                <span class="text-muted-foreground text-xs">
                    All records will be exported with current filters applied
                </span>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                    <LucideIconCn Name="arrow-down-to-line" Size="12" Class="size-3" />
                    Download
                </ButtonCn>
            </div>
        }
        else
        {
            @if (!_imported)
            {
                @* Upload zone *@
                <div class="border-b px-4 py-4">
                    <div
                        role="button"
                        tabindex="0"
                        @onclick="HandleImport"
                        class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-md border-2 border-dashed border-muted-foreground/20 px-6 py-8 transition-colors hover:border-muted-foreground/40 hover:bg-muted/30">
                        <LucideIconCn Name="cloud-upload" Size="24" Class="size-6 text-muted-foreground/60" />
                        <div class="text-center">
                            <span class="font-medium text-sm">Upload data file</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                CSV, JSON, or Excel up to 50 MB
                            </p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                @* Imported file info *@
                <div class="border-b px-4 py-3">
                    <div class="flex items-center gap-3">
                        <LucideIconCn Name="file-spreadsheet" Size="16" Class="size-4 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate font-medium text-sm">
                                    contacts-export-march.csv
                                </span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-mono text-[10px]">
                                    CSV
                                </BadgeCn>
                            </div>
                            <span class="text-muted-foreground text-xs">
                                3,241 records · 6 columns · 1.8 MB
                            </span>
                        </div>
                        <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 shrink-0 text-emerald-500" />
                    </div>
                </div>

                @* Column mapping *@
                <div class="border-b">
                    <div class="border-b px-4 py-2">
                        <span class="text-muted-foreground text-xs">Column mapping</span>
                    </div>
                    @foreach (var col in _columnMappings)
                    {
                        var item = col;
                        var isLast = item.Source == _columnMappings[_columnMappings.Length - 1].Source;
                        <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2", !isLast ? "border-b" : "")">
                            <span class="min-w-0 flex-1 truncate font-mono text-muted-foreground text-xs">
                                @item.Source
                            </span>
                            <LucideIconCn Name="arrow-right-left" Size="12" Class="size-3 shrink-0 text-muted-foreground/40" />
                            <span class="min-w-0 flex-1 truncate font-mono text-xs">
                                @item.Target
                            </span>
                            @if (item.Matched)
                            {
                                <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                            }
                            else
                            {
                                <span class="size-1.5 shrink-0 rounded-full bg-amber-500"></span>
                            }
                        </div>
                    }
                </div>

                @* Import mode *@
                <div class="border-b px-4 py-3">
                    <span class="mb-2 block text-muted-foreground text-xs">Import mode</span>
                    <div class="flex flex-col gap-2">
                        <label class="flex cursor-pointer items-center gap-2">
                            <input type="radio" name="import-mode" value="merge"
                                   checked="@(_importMode == "merge")"
                                   @onchange="@(() => _importMode = "merge")" />
                            <div>
                                <span class="font-medium text-sm">Merge</span>
                                <p class="text-muted-foreground text-xs">
                                    Add new records and update existing matches
                                </p>
                            </div>
                        </label>
                        <label class="flex cursor-pointer items-center gap-2">
                            <input type="radio" name="import-mode" value="replace"
                                   checked="@(_importMode == "replace")"
                                   @onchange="@(() => _importMode = "replace")" />
                            <div>
                                <span class="font-medium text-sm">Replace</span>
                                <p class="text-muted-foreground text-xs">
                                    Delete all existing records and import fresh
                                </p>
                            </div>
                        </label>
                    </div>
                </div>

                @* Import action *@
                <div class="flex items-center justify-between px-4 py-3">
                    <span class="text-muted-foreground text-xs">
                        @(_importMode == "merge"
                            ? "Existing records will be updated by email match"
                            : "All current data will be replaced")
                    </span>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                        Import 3,241 records
                    </ButtonCn>
                </div>
            }
        }
    </div>
</section>

@code {
    private record ColumnMapping(string Source, string Target, bool Matched);

    private static readonly ColumnMapping[] _columnMappings =
    [
        new("full_name",   "name",         true),
        new("email_address", "email",      true),
        new("company",     "organization", true),
        new("phone",       "phone",        true),
        new("signup_date", "created_at",   true),
        new("plan_type",   "subscription", false),
    ];

    private string _activeTab = "export";
    private string _exportFormat = "csv";
    private string _importMode = "merge";
    private bool _imported = false;

    private void HandleImport()
    {
        _imported = true;
    }
}
