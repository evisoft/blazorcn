@* ============================================================
   Block: file-upload-brand-assets
   Title: FileUploadBrandAssets
   Description: A brand asset management upload block for React and Next.js with category-based organization for logos, icons, banners, and social media assets, per-category grid views, metadata display with dimensions and format, and download original option using shadcn/ui Button, Badge, and Tailwind CSS
   Source: original/blocks/file-upload/file-upload-brand-assets.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Brand Assets</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_assets.Length files
            </BadgeCn>
        </div>

        @* Category tabs *@
        <div class="flex border-b">
            @foreach (var catEntry in _categories)
            {
                var cat = catEntry;
                var count = _assets.Count(a => a.Category == cat.Id);
                var isActive = _activeCategory == cat.Id;
                <button
                    type="button"
                    @onclick="@(() => SetActiveCategory(cat.Id))"
                    class="@Cn.Merge("flex flex-1 items-center justify-center gap-1.5 px-3 py-2.5 text-xs transition-colors", isActive ? "border-b-2 border-foreground font-medium text-foreground" : "text-muted-foreground hover:text-foreground")">
                    <LucideIconCn Name="@cat.IconName" Size="14" Class="size-3.5" />
                    @cat.Label
                    <span class="text-muted-foreground">@("(")@count@(")")</span>
                </button>
            }
        </div>

        @* Upload area *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="font-medium text-sm">Upload to @_activeCat?.Label</span>
                    <p class="text-muted-foreground text-xs">SVG, PNG, WebP up to 10 MB</p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="upload" Size="12" Class="size-3" />
                    Upload
                </ButtonCn>
            </div>
        </div>

        @* Asset grid *@
        <div>
            @{
                var filteredAssets = _assets.Where(a => a.Category == _activeCategory).ToArray();
            }
            @for (var i = 0; i < filteredAssets.Length; i++)
            {
                var asset = filteredAssets[i];
                var isLast = i == filteredAssets.Length - 1;
                var isExpanded = _expandedAsset == asset.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => ToggleExpand(asset.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        @* Thumbnail placeholder *@
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/60" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@asset.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @asset.Dimensions · @asset.Size
                            </p>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-mono font-normal text-xs">
                            @asset.Format
                        </BadgeCn>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-[4.25rem]">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="grid grid-cols-2 gap-2 text-xs">
                                    <div>
                                        <span class="text-muted-foreground">Dimensions</span>
                                        <p class="font-mono">@asset.Dimensions px</p>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground">Format</span>
                                        <p class="font-mono">@asset.Format</p>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground">File size</span>
                                        <p class="font-mono">@asset.Size</p>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground">Category</span>
                                        <p class="capitalize">@asset.Category</p>
                                    </div>
                                </div>
                                <div class="mt-3 flex gap-2">
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                                        <LucideIconCn Name="download" Size="12" Class="size-3" />
                                        Download Original
                                    </ButtonCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record BrandAsset(string Id, string Name, string Category, string Dimensions, string Format, string Size);
    private record Category(string Id, string Label, string IconName);

    private static readonly Category[] _categories =
    [
        new("logo",   "Logo",   "square"),
        new("icon",   "Icon",   "layout-grid"),
        new("banner", "Banner", "flag"),
        new("social", "Social", "share"),
    ];

    private static readonly BrandAsset[] _assets =
    [
        new("1",  "Logo Primary Dark",    "logo",   "2400 x 600",  "SVG",  "14 KB"),
        new("2",  "Logo Primary Light",   "logo",   "2400 x 600",  "SVG",  "14 KB"),
        new("3",  "Logo Stacked",         "logo",   "1200 x 1200", "PNG",  "48 KB"),
        new("4",  "Favicon 32",           "icon",   "32 x 32",     "PNG",  "2 KB"),
        new("5",  "App Icon iOS",         "icon",   "1024 x 1024", "PNG",  "86 KB"),
        new("6",  "App Icon Android",     "icon",   "512 x 512",   "PNG",  "42 KB"),
        new("7",  "Hero Banner Desktop",  "banner", "1920 x 600",  "WebP", "124 KB"),
        new("8",  "Hero Banner Mobile",   "banner", "750 x 480",   "WebP", "68 KB"),
        new("9",  "Email Header",         "banner", "600 x 200",   "PNG",  "32 KB"),
        new("10", "Twitter Profile",      "social", "400 x 400",   "PNG",  "28 KB"),
        new("11", "OG Image",             "social", "1200 x 630",  "PNG",  "96 KB"),
        new("12", "LinkedIn Cover",       "social", "1584 x 396",  "PNG",  "72 KB"),
    ];

    private string _activeCategory = "logo";
    private string? _expandedAsset = null;

    private Category? _activeCat => System.Array.Find(_categories, c => c.Id == _activeCategory);

    private void SetActiveCategory(string categoryId)
    {
        _activeCategory = categoryId;
        _expandedAsset = null;
    }

    private void ToggleExpand(string assetId)
    {
        _expandedAsset = _expandedAsset == assetId ? null : assetId;
    }
}
