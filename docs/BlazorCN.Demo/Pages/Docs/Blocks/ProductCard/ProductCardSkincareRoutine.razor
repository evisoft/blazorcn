@* ========================================
   Block: product-card-skincare-routine
   Title: Product Card Skincare Routine
   Description: Skincare routine card with AM/PM products, application order, and skin type match for beauty apps
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, LucideCheckCn, LucideClockCn, LucideDropletsCn, LucideMoonCn, LucideShoppingBagCn, LucideSparklesCn, LucideSunCn, TabsCn, TabsContentCn, TabsListCn, TabsTriggerCn
   Source: original/blocks/product-card/product-card-skincare-routine.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[340px] max-w-full">
        <CardCn Class="overflow-hidden">
            <CardContentCn Class="p-4">
                <div class="flex items-start justify-between">
                    <div>
                        <div class="flex items-center gap-2">
                            <LucideDropletsCn Class="h-5 w-5 text-primary" Size="20" />
                            <h3 class="font-semibold">@_product.Name</h3>
                        </div>
                        <div class="mt-2 flex flex-wrap gap-1">
                            @foreach (var type in _product.SkinTypes)
                            {
                                <BadgeCn Class="text-xs" Variant="BadgeVariant.Outline">@type</BadgeCn>
                            }
                        </div>
                    </div>
                    <BadgeCn Class="shrink-0">Save $@_product.Savings</BadgeCn>
                </div>

                <div class="mt-3 flex flex-wrap gap-1">
                    @foreach (var concern in _product.Concerns)
                    {
                        <span class="flex items-center gap-1 text-xs text-muted-foreground">
                            <LucideSparklesCn Class="h-3 w-3" Size="12" />
                            @concern
                        </span>
                    }
                </div>

                <TabsCn Class="mt-4" @bind-Value="_activeTab">
                    <TabsListCn Class="grid w-full grid-cols-2">
                        <TabsTriggerCn Class="gap-1.5" Value="am">
                            <LucideSunCn Class="h-4 w-4" Size="16" />
                            Morning
                        </TabsTriggerCn>
                        <TabsTriggerCn Class="gap-1.5" Value="pm">
                            <LucideMoonCn Class="h-4 w-4" Size="16" />
                            Evening
                        </TabsTriggerCn>
                    </TabsListCn>

                    <TabsContentCn Class="mt-3" Value="am">
                        <div class="flex items-center gap-1 text-xs text-muted-foreground">
                            <LucideClockCn Class="h-3 w-3" Size="12" />
                            <span>Total time: @_product.TotalTime.Am</span>
                        </div>
                    </TabsContentCn>

                    <TabsContentCn Class="mt-3" Value="pm">
                        <div class="flex items-center gap-1 text-xs text-muted-foreground">
                            <LucideClockCn Class="h-3 w-3" Size="12" />
                            <span>Total time: @_product.TotalTime.Pm</span>
                        </div>
                    </TabsContentCn>
                </TabsCn>

                <div class="mt-3 space-y-2">
                    @foreach (var step in _currentRoutine)
                    {
                        <div class="flex items-center gap-3 rounded-lg border p-2">
                            <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs font-semibold text-primary">@step.Order</div>
                            <div class="flex-1 min-w-0">
                                <p class="text-xs text-muted-foreground">@step.Name</p>
                                <p class="text-sm font-medium truncate">@step.Product</p>
                            </div>
                            <div class="text-right shrink-0">
                                <p class="text-sm font-semibold tabular-nums">$@step.Price</p>
                                <p class="text-xs text-muted-foreground">@step.Duration</p>
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-4 rounded-lg border p-3">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs text-muted-foreground">Complete routine</p>
                            <div class="flex items-baseline gap-2">
                                <p class="text-xl font-bold tabular-nums">$@_product.TotalPrice</p>
                                <p class="text-sm text-muted-foreground line-through tabular-nums">$@(_product.TotalPrice + _product.Savings)</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-1 text-xs text-primary">
                            <LucideCheckCn Class="h-3 w-3" Size="12" />
                            <span>AM + PM included</span>
                        </div>
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <ButtonCn Class="w-full">
                    <LucideShoppingBagCn Class="mr-2 h-4 w-4" Size="16" />
                    Shop Full Routine
                </ButtonCn>
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">Customize Routine</ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private string _activeTab = "am";

    private List<RoutineStep> _currentRoutine => _activeTab == "am" ? _product.Routine.Am : _product.Routine.Pm;

    private record RoutineStep(int Order, string Name, string Product, int Price, string Duration);
    private record Routine(List<RoutineStep> Am, List<RoutineStep> Pm);
    private record TotalTime(string Am, string Pm);
    private record ProductData(string Name, string[] SkinTypes, string[] Concerns, TotalTime TotalTime, Routine Routine, int TotalPrice, int Savings);

    private static readonly ProductData _product = new(
        "Hydration Hero Routine",
        new[] { "Dry", "Normal", "Combination" },
        new[] { "Dehydration", "Fine lines", "Dullness" },
        new("5 min", "8 min"),
        new(
            new()
            {
                new(1, "Cleanser", "Gentle Foam Wash", 28, "1 min"),
                new(2, "Toner", "Hydrating Essence", 34, "30 sec"),
                new(3, "Serum", "Hyaluronic Acid 2%", 42, "1 min"),
                new(4, "Moisturizer", "Daily Hydra Cream", 48, "1 min"),
                new(5, "SPF", "Invisible Shield SPF 50", 36, "1 min"),
            },
            new()
            {
                new(1, "Cleanser", "Oil Cleanser", 32, "2 min"),
                new(2, "Cleanser", "Gentle Foam Wash", 28, "1 min"),
                new(3, "Toner", "Hydrating Essence", 34, "30 sec"),
                new(4, "Serum", "Retinol 0.5%", 56, "1 min"),
                new(5, "Eye Cream", "Peptide Eye Complex", 52, "30 sec"),
                new(6, "Moisturizer", "Night Repair Cream", 58, "1 min"),
            }
        ),
        448, 67
    );
}
