@* ========================================
   Block: product-card-podcast
   Title: Product Card Podcast
   Description: Podcast episode card with play controls, duration, and show notes for podcast apps
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, BadgeCn, ButtonCn, CardCn, CardContentCn, LucideBookmarkCn, LucideClockCn, LucideDownloadCn, LucideHeadphonesCn, LucidePauseCn, LucidePlayCn, LucideShare2Cn, ProgressCn
   Source: original/blocks/product-card/product-card-podcast.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[400px] max-w-full">
        <CardCn Class="overflow-hidden">
            <CardContentCn Class="p-4">
                <div class="flex gap-4">
                    <div class="relative h-24 w-24 shrink-0">
                        <img alt="@_product.Title" class="h-full w-full rounded-lg object-cover" height="400" src="@_product.Image" width="400" />
                        <button type="button" class="absolute inset-0 flex items-center justify-center rounded-lg bg-black/40 transition-opacity hover:bg-black/50" @onclick="@(() => _isPlaying = !_isPlaying)">
                            @if (_isPlaying)
                            {
                                <LucidePauseCn Class="h-8 w-8 fill-white text-white" Size="32" />
                            }
                            else
                            {
                                <LucidePlayCn Class="h-8 w-8 fill-white text-white" Size="32" />
                            }
                        </button>
                    </div>

                    <div class="flex-1 min-w-0">
                        <div class="flex items-start justify-between gap-2">
                            <div>
                                <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">Ep. @_product.EpisodeNumber</BadgeCn>
                                <p class="mt-1 text-xs text-muted-foreground">@_product.ShowName</p>
                            </div>
                            <ButtonCn Class="h-8 w-8 shrink-0" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost">
                                <LucideBookmarkCn Class="h-4 w-4" Size="16" />
                            </ButtonCn>
                        </div>

                        <h3 class="mt-1 font-semibold leading-tight line-clamp-2">@_product.Title</h3>

                        <div class="mt-2 flex items-center gap-3 text-xs text-muted-foreground">
                            <div class="flex items-center gap-1">
                                <LucideClockCn Class="h-3 w-3" Size="12" />
                                <span>@_product.Duration</span>
                            </div>
                            <span>@_product.PublishDate</span>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <ProgressCn Class="h-1" Value="@_progressPercent" />
                    <div class="mt-1 flex items-center justify-between text-xs text-muted-foreground">
                        <span>@(Math.Floor((double)_product.PlayedSeconds / 60)):@((_product.PlayedSeconds % 60).ToString("D2"))</span>
                        <span>@_remainingMinutes min left</span>
                    </div>
                </div>

                @if (_product.Guest is not null)
                {
                    <div class="mt-4 flex items-center gap-3 rounded-lg border p-3">
                        <AvatarCn Class="h-10 w-10">
                            <AvatarImageCn Src="@_product.Guest.Avatar" />
                            <AvatarFallbackCn>@_product.Guest.Name[0]</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium">Featuring @_product.Guest.Name</p>
                            <p class="text-xs text-muted-foreground truncate">@_product.Guest.Title</p>
                        </div>
                    </div>
                }

                <p class="mt-3 text-sm text-muted-foreground line-clamp-2">@_product.Description</p>

                <div class="mt-4 flex gap-2">
                    <ButtonCn Class="flex-1" @onclick="@(() => _isPlaying = !_isPlaying)">
                        @if (_isPlaying)
                        {
                            <LucidePauseCn Class="mr-2 h-4 w-4" Size="16" />
                            <span>Pause</span>
                        }
                        else
                        {
                            <LucideHeadphonesCn Class="mr-2 h-4 w-4" Size="16" />
                            <span>@(_product.PlayedSeconds > 0 ? "Continue" : "Play")</span>
                        }
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Outline">
                        <LucideDownloadCn Class="h-4 w-4" Size="16" />
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Outline">
                        <LucideShare2Cn Class="h-4 w-4" Size="16" />
                    </ButtonCn>
                </div>
            </CardContentCn>
        </CardCn>
    </div>
</section>

@code {
    private bool _isPlaying;

    private double _progressPercent => (double)_product.PlayedSeconds / _product.DurationSeconds * 100;
    private int _remainingMinutes => (int)Math.Ceiling((_product.DurationSeconds - _product.PlayedSeconds) / 60.0);

    private record GuestInfo(string Name, string Avatar, string Title);
    private record Product(string Title, string ShowName, int EpisodeNumber, string Image, string Duration, int DurationSeconds, string PublishDate, string Description, GuestInfo? Guest, int PlayedSeconds);

    private static readonly Product _product = new(
        "The Future of AI in Creative Industries", "Tech Horizons", 147,
        "https://images.unsplash.com/photo-1478737270239-2f02b77fc618?w=400&q=80",
        "58:24", 3504, "Dec 4, 2025",
        "We explore how artificial intelligence is transforming creative work, from design to music production, with insights from industry leaders.",
        new("Dr. Sarah Chen", "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&q=80", "AI Research Lead, Creative Labs"),
        1240
    );
}
